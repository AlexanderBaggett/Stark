import StdlibPortSupport
import System.Testing
module SystemRangeNotationStandardLibraryTests

// Ported from SystemRangeNotationStandardLibraryTests.StdLibSourceUsesCanonicalRangeNotation.
// PORT-NOTE: The C# original enumerates every *.stark file under stdlib/src and
// stdlib/templates from the repository root, strips string literals, and scans
// the remaining code text for forbidden range spellings (e.g. `i8[-128 127]`,
// `u8[0 255]`, decimal boundary literals such as 2147483647/65535, parenthesized
// positive powers like `(2 ** n)`, and compact exponents like `2**n`), failing
// when any stdlib source spells a range non-canonically instead of using
// `[min max]`, `[0 max]`, or spaced `2 ** n` exponent notation. The compile-only
// bridge cannot reach the repository file system or scan stdlib source text, so
// the canonical-notation convention is exercised indirectly: a single program is
// embedded that declares ranged integers using exactly the canonical forms the
// test mandates (`[min max]`, `[0 max]`, and spaced `2 ** n` exponents at the
// i8/i16/i32/i64 and u8/u16/u32/u64 boundaries). The test passes only when that
// program compiles, standing in for the source-text scan over the on-disk stdlib.
internal fn bool StdLibSourceUsesCanonicalRangeNotationImpl()
{
    stack mut ProgramCompile c = CompileProgram("system-range-notation-canonical", raw"""
module RangeNotationCanonical

export unsafe ffi fn i32[min max] main() {
    // Symbolic full-width ranges use the canonical [min max] spelling.
    stack i8[min max] signedByte = 0;
    stack i16[min max] signedShort = 0;
    stack i32[min max] signedInt = 0;
    stack i64[min max] signedLong = 0;

    // Unsigned full-width ranges use the canonical [0 max] spelling.
    stack u8[min max] unsignedByte = 0;
    stack u16[min max] unsignedShort = 0;
    stack u32[0 max] unsignedInt = 0;
    stack u64[0 max] unsignedLong = 0;

    // Boundary-exact ranges use spaced exponent notation, never decimal literals.
    stack i32[-(2 ** 31) 2 ** 31 - 1] signedIntExponent = 0;
    stack i64[-(2 ** 63) 2 ** 63 - 1] signedLongExponent = 0;
    stack u16[0 2 ** 16 - 1] unsignedShortExponent = 0;
    stack u64[0 2 ** 63 - 1] capacityRange = 0;

    return signedInt;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}
