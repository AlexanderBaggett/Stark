import StdlibPortSupport
import System.Testing
import System.Threading
module SystemThreadingStandardLibraryTests

// Ported from SystemThreadingStandardLibraryTests.PackagedStdLibThreadingEntrySchedulerAndThreadLifecycleWorkWithoutSource.
//
// PORT-NOTE: the C# test packages System.Threading into libSystem.Threading.a via
// the CLI (--emit-lib), then compiles the embedded App against the package
// directory (no source tree, --emit-exe), and runs the produced non-Windows
// executable asserting exit code 0 with empty stdout/stderr. The compile-only host
// bridge cannot package the stdlib, link an executable, or run it, so this reduces
// to compiling the embedded program verbatim through the host stdlib and asserting
// it succeeds, the strongest signal the bridge can reproduce.
internal fn bool PackagedStdLibThreadingEntrySchedulerAndThreadLifecycleWorkWithoutSourceImpl()
{
    stack mut ProgramCompile c = CompileProgram("packaged-threading-entry-scheduler-lifecycle", raw"""
import System.Threading
module App

fn i32[min max] Worker()
{
    return 7;
}

struct WorkerPayload
{
    i32[min max] ExitCode;
}

fn i32[min max] PayloadWorker(WorkerPayload payload)
{
    return payload.ExitCode;
}

fn bool JoinResultIs(System.Threading.ThreadJoinResult result, i32[min max] expected)
{
    switch (result)
    {
        case System.Threading.ThreadJoinResult.Ok(var value):
            return value == expected;
        case System.Threading.ThreadJoinResult.Err(var error):
            return false;
    }
}

fn bool StatusOk(System.Threading.ThreadStatus status)
{
    switch (status)
    {
        case System.Threading.ThreadStatus.Ok:
            return true;
        case System.Threading.ThreadStatus.Err(var error):
            return false;
    }
}

export fn i32[min max] main()
{
    stack ThreadEntry entry = Worker;
    Thread.Yield();
    Thread.SleepMilliseconds(0);
    if (entry() != 7)
    {
        return 1;
    }

    stack ThreadEntry lambdaEntry = () => 11;
    if (lambdaEntry() != 11)
    {
        return 7;
    }

    stack mut Thread worker = new(Worker);
    if (!worker.IsJoinable())
    {
        return 2;
    }

    stack ThreadJoinResult joined = worker.Join();
    if (!JoinResultIs(joined, 7))
    {
        return 3;
    }

    if (worker.IsJoinable())
    {
        return 4;
    }

    stack mut Thread detached = new(Worker);
    stack ThreadStatus detachedStatus = detached.Detach();
    if (!StatusOk(detachedStatus))
    {
        return 5;
    }

    if (detached.IsJoinable())
    {
        return 6;
    }

    stack mut Thread lambdaWorker = new(() => 13);
    stack ThreadJoinResult lambdaJoined = lambdaWorker.Join();
    if (!JoinResultIs(lambdaJoined, 13))
    {
        return 8;
    }

    stack WorkerPayload payload = new WorkerPayload()
    {
        ExitCode = 17
    };
    stack mut Thread payloadWorker = Thread.Start<WorkerPayload>(PayloadWorker, payload);
    if (!payloadWorker.IsJoinable())
    {
        return 9;
    }

    stack ThreadJoinResult payloadJoined = payloadWorker.Join();
    if (!JoinResultIs(payloadJoined, 17))
    {
        return 10;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemThreadingStandardLibraryTests.StdLibSourceThreadingSurfaceSupportsThreadEntryAndSchedulerCalls.
//
// PORT-NOTE: the C# test compiles the embedded program against the on-disk stdlib
// source tree with StopAfterPassId "type-check", then inspects the TypeCheckModel
// artifact to assert the function-pointer promotions (three Worker promotions plus
// a ThreadPayloadThunk to fnptr<unsafe fn i32(rawmutptr<i8>)>), the two lambdas
// promoted to fnptr<fn i32()>, and the indirect-call function-pointer types. The
// compile-only host bridge cannot stop after a named pass nor surface the
// TypeCheckModel, so this port compiles the embedded program verbatim through the
// host stdlib and asserts the compile succeeds, the strongest signal the bridge
// can reproduce.
internal fn bool StdLibSourceThreadingSurfaceSupportsThreadEntryAndSchedulerCallsImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-threading-thread-entry-scheduler-calls", raw"""
import System.Threading
module Demo

fn i32[min max] Worker()
{
    return 7;
}

fn i32[min max] Run()
{
    stack System.Threading.ThreadEntry entry = Worker;
    stack System.Threading.ThreadEntry lambdaEntry = () => 11;
    System.Threading.Thread.Yield();
    System.Threading.Thread.SleepMilliseconds(0);
    stack mut System.Threading.Thread worker = new(Worker);
    if (!worker.IsJoinable())
    {
        return 1;
    }

    worker.Join();
    stack mut System.Threading.Thread detached = new(Worker);
    detached.Detach();
    stack mut System.Threading.Thread lambdaWorker = new(() => 13);
    lambdaWorker.Join();
    return entry() + lambdaEntry();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemThreadingStandardLibraryTests.StdLibSourceThreadingSurfaceSupportsSynchronizedGuardedState.
//
// PORT-NOTE: the C# test compiles the embedded program against the on-disk stdlib
// source tree with StopAfterPassId "type-check", then inspects the TypeCheckModel
// named-type keys to assert System.Threading.Synchronized<...> and
// System.Threading.Locked<...> were instantiated. The compile-only host bridge
// cannot stop after a named pass nor surface the TypeCheckModel named types, so
// this port compiles the embedded program verbatim through the host stdlib and
// asserts the compile succeeds, the strongest signal the bridge can reproduce.
internal fn bool StdLibSourceThreadingSurfaceSupportsSynchronizedGuardedStateImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-threading-synchronized-guarded-state", raw"""
import System.Threading
module Demo

struct Counter
{
    i32[min max] Value;
}

fn i32[min max] Run()
{
    stack mut System.Threading.Synchronized<Counter> guarded =
        new System.Threading.Synchronized<Counter>(new Counter()
        {
            Value = 1
        });

    stack mut System.Threading.Locked<Counter> guard = guarded.Lock();
    guard.Value().Value += 4;
    return guard.Value().Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

