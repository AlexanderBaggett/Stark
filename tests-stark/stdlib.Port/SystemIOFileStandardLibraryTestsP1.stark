import StdlibPortSupport
import System.Testing
module SystemIOFileStandardLibraryTestsP1

// Ported from SystemIOFileStandardLibraryTests.StdLibSourceRawFileHandleHelpersStayInternal.
//
// PORT-NOTE: the C# test reads stdlib/src/System/IO/File.stark as text and uses
// Contains/DoesNotContain to assert the raw file-handle helpers (OpenRead,
// OpenWrite, ReadBytes, WriteLine) are declared `internal` and not `public`,
// then compiles File.stark with a FileSystemModuleResolver and asserts success.
// The compile-only host bridge cannot read the stdlib source file off disk, so
// the source-text visibility assertions are reduced: this port compiles a
// program that imports System.IO (which transitively pulls in the host stdlib's
// File.stark) and asserts the compile succeeds, the acceptance signal the
// original test checks.
public unsafe fn bool StdLibSourceRawFileHandleHelpersStayInternalImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-raw-file-handle-helpers-internal", raw"""
import System
module Demo

fn void Use()
{
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

