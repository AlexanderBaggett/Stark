// Ported from SystemIOFileStandardLibraryTests.StdLibSourceAtomicWholeFileHelpersUseExclusiveCreateSyncAndMove.
//
// PORT-NOTE: the C# test reads stdlib/src/System/IO/File.stark plus the three
// platform sources (Linux.stark, MacOS.stark, Windows.stark) as text and uses
// Contains to assert the atomic whole-file helpers (WriteAllBytesAtomic,
// WriteAllTextAtomic) open with FileMode.CreateNew, SyncAll, Move, and Delete,
// and that each platform exposes an exclusive-create open path
// (OpenFileCreateNewResult / FileOpenResult) plus an fsync/FlushFileBuffers sync
// primitive. It then compiles File.stark and asserts success. The compile-only
// host bridge cannot read the stdlib source files off disk, so the source-text
// shape assertions across File.stark and the platform sources are reduced: this
// port compiles a program that imports System.IO (pulling in the host stdlib's
// File.stark and the active platform source) and asserts the compile succeeds.
public unsafe fn bool StdLibSourceAtomicWholeFileHelpersUseExclusiveCreateSyncAndMoveImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-atomic-whole-file-exclusive-create-sync-move", raw"""
import System
module Demo

fn void Use()
{
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemIOFileStandardLibraryTests.StdLibSourceOwnedFileHandlesSupportAsciiAndUnicodeWriteOverloads.
public unsafe fn bool StdLibSourceOwnedFileHandlesSupportAsciiAndUnicodeWriteOverloadsImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-owned-file-ascii-unicode-write-overloads", raw"""
import System
module Demo
fn bool StatusOk(System.IO.IOStatus status)
{
    switch (status)
    {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var error):
            return false;
    }
}

fn bool BoolOrFalse(System.IO.IOResult<bool> result)
{
    switch (result)
    {
        case System.IO.IOResult<bool>.Ok(var value):
            return value;
        case System.IO.IOResult<bool>.Err(var error):
            return false;
    }
}

fn System.IO.File.File OpenOrEmpty(System.IO.IOResult<System.IO.File.File> result)
{
    switch (result)
    {
        case System.IO.IOResult<System.IO.File.File>.Ok(var value):
            return value;
        case System.IO.IOResult<System.IO.File.File>.Err(var error):
            return new();
    }
}
unsafe fn void Use()
{
    stack mut System.IO.File.File file = OpenOrEmpty(System.IO.File.Open("demo.txt", System.IO.File.FileMode.Write));
    file.WriteText("ascii");
    file.WriteText((unicode)"ascii");
    file.WriteLine("line");
    file.WriteLine((unicode)"line");
    file.Flush();
    file.SyncAll();
    file.Close();
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemIOFileStandardLibraryTests.StdLibSourceFileSeekSurfaceCompiles.
public unsafe fn bool StdLibSourceFileSeekSurfaceCompilesImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-file-seek-surface-compiles", raw"""
import System
module Demo
fn bool StatusOk(System.IO.IOStatus status)
{
    switch (status)
    {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var error):
            return false;
    }
}

fn bool BoolOrFalse(System.IO.IOResult<bool> result)
{
    switch (result)
    {
        case System.IO.IOResult<bool>.Ok(var value):
            return value;
        case System.IO.IOResult<bool>.Err(var error):
            return false;
    }
}

fn System.IO.File.File OpenOrEmpty(System.IO.IOResult<System.IO.File.File> result)
{
    switch (result)
    {
        case System.IO.IOResult<System.IO.File.File>.Ok(var value):
            return value;
        case System.IO.IOResult<System.IO.File.File>.Err(var error):
            return new();
    }
}
unsafe fn void Use()
{
    stack mut System.IO.File.File file = OpenOrEmpty(System.IO.File.Open("demo.txt", System.IO.File.FileMode.ReadWrite));
    file.Seek(0, System.IO.File.SeekOrigin.Begin);
    file.Seek(1, System.IO.File.SeekOrigin.Current);
    file.Seek(-1, System.IO.File.SeekOrigin.End);
    file.Close();
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemIOFileStandardLibraryTests.PackagedStdLibFileMoveDeleteAndExistsRoundTrip.
//
// PORT-NOTE: the C# test packages the stdlib, builds the embedded program with
// the CLI (--emit-exe -I <package>), runs the produced binary, and asserts exit
// code 0 with empty stdout/stderr plus that the before.txt/after.txt files no
// longer exist on disk after the Move/Delete round-trip. The compile-only host
// bridge cannot package the stdlib, link or execute the produced binary, or
// observe file-system effects, so this reduces to compiling the embedded program
// against the host stdlib and asserting it succeeds.
public unsafe fn bool PackagedStdLibFileMoveDeleteAndExistsRoundTripImpl()
{
    stack mut ProgramCompile c = CompileProgram("packaged-file-move-delete-exists-roundtrip", raw"""
import System
module App
fn bool StatusOk(System.IO.IOStatus status)
{
    switch (status)
    {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var error):
            return false;
    }
}

fn bool BoolOrFalse(System.IO.IOResult<bool> result)
{
    switch (result)
    {
        case System.IO.IOResult<bool>.Ok(var value):
            return value;
        case System.IO.IOResult<bool>.Err(var error):
            return false;
    }
}

fn System.IO.File.File OpenOrEmpty(System.IO.IOResult<System.IO.File.File> result)
{
    switch (result)
    {
        case System.IO.IOResult<System.IO.File.File>.Ok(var value):
            return value;
        case System.IO.IOResult<System.IO.File.File>.Err(var error):
            return new();
    }
}
export fn i32[min max] main()
{
    stack mut System.IO.File.File file = OpenOrEmpty(System.IO.File.Open("before.txt", System.IO.File.FileMode.Write));
    if (!file.IsOpen())
    {
        return 1;
    }

    if (!StatusOk(file.WriteLine("Move me")))
    {
        return 2;
    }

    if (!StatusOk(file.Close()))
    {
        return 2;
    }

    if (!BoolOrFalse(System.IO.File.Exists("before.txt")))
    {
        return 3;
    }

    if (!StatusOk(System.IO.File.Move("before.txt", "after.txt")))
    {
        return 4;
    }

    if (BoolOrFalse(System.IO.File.Exists("before.txt")))
    {
        return 5;
    }

    if (!BoolOrFalse(System.IO.File.Exists("after.txt")))
    {
        return 6;
    }

    if (!StatusOk(System.IO.File.Delete("after.txt")))
    {
        return 7;
    }

    if (BoolOrFalse(System.IO.File.Exists("after.txt")))
    {
        return 8;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemIOFileStandardLibraryTests.PackagedStdLibUnicodeConsoleAndRawFileWritesWorkWithoutSource.
//
// PORT-NOTE: the C# test packages the stdlib, builds the embedded program with
// the CLI (--emit-exe -I <package>), runs the produced binary, and asserts exit
// code 0 with the console printing "Console α\n" on stdout, an empty
// stderr, and the on-disk unicode.txt holding "File α\n". The compile-only
// host bridge cannot package the stdlib, link or execute the produced binary, or
// capture runtime stdout/file contents, so this reduces to compiling the
// embedded program against the host stdlib and asserting it succeeds.
public unsafe fn bool PackagedStdLibUnicodeConsoleAndRawFileWritesWorkWithoutSourceImpl()
{
    stack mut ProgramCompile c = CompileProgram("packaged-unicode-console-raw-file-writes", raw"""
import System
import System.Text
module App
fn bool StatusOk(System.IO.IOStatus status)
{
    switch (status)
    {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var error):
            return false;
    }
}

fn bool BoolOrFalse(System.IO.IOResult<bool> result)
{
    switch (result)
    {
        case System.IO.IOResult<bool>.Ok(var value):
            return value;
        case System.IO.IOResult<bool>.Err(var error):
            return false;
    }
}

fn System.IO.File.File OpenOrEmpty(System.IO.IOResult<System.IO.File.File> result)
{
    switch (result)
    {
        case System.IO.IOResult<System.IO.File.File>.Ok(var value):
            return value;
        case System.IO.IOResult<System.IO.File.File>.Err(var error):
            return new();
    }
}
export fn i32[min max] main()
{
    stack mut System.IO.File.File file = OpenOrEmpty(System.IO.File.Open("unicode.txt", System.IO.File.FileMode.Write, System.Text.Encoding.UTF8));
    if (!file.IsOpen())
    {
        return 1;
    }

    if (!StatusOk(file.WriteLine((unicode)"File \u03B1")))
    {
        return 2;
    }

    if (!StatusOk(file.Close()))
    {
        return 2;
    }

    switch (System.Console.WriteLine((unicode)"Console \u03B1"))
    {
        case System.IO.IOStatus.Ok:
            return 0;
        case System.IO.IOStatus.Err(var error):
            return 3;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}
