import StdlibPortSupport
import System.Testing
module SystemPromotedNetTcpStandardLibraryTestsP1

// Ported from SystemPromotedNetTcpStandardLibraryTests.StdLibSourcePromotedNetTcpSurfaceCompiles.
public unsafe fn bool StdLibSourcePromotedNetTcpSurfaceCompilesImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-promoted-net-tcp-surface-compiles", raw"""
import System.Net
import System.Net.Tcp
import System.Runtime.Buffer
import System.Net
module Demo

fn bool StatusOk(System.Net.NetStatus status)
{
    switch (status)
    {
        case System.Net.NetStatus.Ok:
            return true;
        case System.Net.NetStatus.Err(var error):
            return false;
    }
}

fn bool CountFailed(System.Net.NetResult<u64[0 2 ** 63 - 1]> result)
{
    switch (result)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var value):
            return false;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
            return true;
    }
}

fn bool ClientFailed(System.Net.NetResult<System.Net.Tcp.TcpClient> result)
{
    switch (result)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Ok(var value):
            return false;
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Err(var error):
            return true;
    }
}

fn i32[min max] RunClosedSurface()
{
    stack mut System.Net.Tcp.TcpClient client = new();
    stack mut i8[min max][4] rawBuffer =
    {
        1, 2, 3, 4
    };
    stack mut i8[min max][2] rawFirst =
    {
        1, 2
    };
    stack mut i8[min max][2] rawSecond =
    {
        3, 4
    };
    stack mut System.Runtime.Buffer.FixedByteBuffer512 fixedBuffer = new();
    stack mut System.Runtime.Buffer.DynamicByteBuffer dynamicBuffer = new();

    if (client.IsOpen())
    {
        return 1;
    }

    if (!CountFailed(client.Read(rawBuffer)))
    {
        return 2;
    }

    if (!CountFailed(client.Read(fixedBuffer)))
    {
        return 3;
    }

    if (!CountFailed(client.Read(dynamicBuffer, 4)))
    {
        return 4;
    }

    if (!CountFailed(client.Write(rawBuffer)))
    {
        return 5;
    }

    if (!CountFailed(client.ReadVectored(rawFirst, rawSecond)))
    {
        return 6;
    }

    if (!CountFailed(client.WriteVectored(rawFirst, rawSecond)))
    {
        return 7;
    }

    if (!CountFailed(client.Write(fixedBuffer)))
    {
        return 8;
    }

    if (StatusOk(client.WaitReadable(0)) || StatusOk(client.WaitWritable(0)))
    {
        return 9;
    }

    if (StatusOk(client.Shutdown(System.Net.Tcp.TcpShutdown.Both)))
    {
        return 10;
    }

    if (!StatusOk(client.Close()))
    {
        return 11;
    }

    stack mut System.Net.Tcp.TcpListener listener = new();
    if (listener.IsOpen())
    {
        return 12;
    }

    if (!ClientFailed(listener.Accept()))
    {
        return 13;
    }

    if (StatusOk(listener.WaitReadable(0)))
    {
        return 14;
    }

    if (!StatusOk(listener.Close()))
    {
        return 15;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);

    return Contains(llvm, "System_Net_Tcp")
        && Contains(llvm, "System_Runtime_Buffer_FixedByteBuffer512_WriteFill")
        && Contains(llvm, "System_Runtime_Platform_ReadSocket")
        && Contains(llvm, "System_Runtime_Platform_WriteSocket")
        && Contains(llvm, "System_Runtime_Platform_ReadSocketVector2")
        && Contains(llvm, "System_Runtime_Platform_WriteSocketVector2")
        && Contains(llvm, "System_Runtime_Platform_WaitReadable")
        && Contains(llvm, "System_Runtime_Platform_WaitWritable")
        && DoesNotContain(llvm, "System_Experimental_Net_Tcp");
}

// Ported from SystemPromotedNetTcpStandardLibraryTests.StdLibSourcePromotedNetTcpBufferReadsUseBulkPaths.
//
// PORT-NOTE: the C# test reads the on-disk stdlib source
// stdlib/src/System/Net/Tcp.stark and compiles that module file directly with
// EmitLlvmIr (resolving against stdlib/src), then scans per-function LLVM bodies
// for the TcpClient_Read fixed/dynamic buffer bulk paths. The compile-only host
// bridge cannot read the repository source tree nor compile a bare stdlib module
// in isolation, so this port compiles a program that imports System.Net.Tcp and
// System.Runtime.Buffer and exercises TcpClient.Read over the 512/4096/8192
// fixed buffers and the dynamic buffer, forcing the host stdlib to emit the
// TcpClient_Read__* definitions into the program module, then applies the same
// per-body Contains/DoesNotContain checks via LlvmDefinitionBody (the Stark
// mirror of the C# ExtractLlvmFunctionBody helper).
//
// PORT-NOTE: the two final assertions read the on-disk stdlib source
// stdlib/src/System/Runtime/Platform.stark for the
// `rawmutptr<i8[min max]>[capacity] buffer` and `rawptr<i8[min max]>[length] buffer`
// parameter spellings. The compile-only host bridge has no access to the
// repository source text, so those source-text checks cannot be reproduced and
// are dropped here; the compiled-program bulk-path body checks above are the
// strongest signal the bridge can reproduce.
public unsafe fn bool StdLibSourcePromotedNetTcpBufferReadsUseBulkPathsImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-promoted-net-tcp-buffer-reads-bulk-paths", raw"""
import System.Net
import System.Net.Tcp
import System.Runtime.Buffer
module Demo

fn bool CountFailed(System.Net.NetResult<u64[0 2 ** 63 - 1]> result)
{
    switch (result)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var value):
            return false;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
            return true;
    }
}

fn i32[min max] RunBulkReads()
{
    stack mut System.Net.Tcp.TcpClient client = new();
    stack mut System.Runtime.Buffer.FixedByteBuffer512 fixed512 = new();
    stack mut System.Runtime.Buffer.FixedByteBuffer4096 fixed4096 = new();
    stack mut System.Runtime.Buffer.FixedByteBuffer8192 fixed8192 = new();
    stack mut System.Runtime.Buffer.DynamicByteBuffer dynamicBuffer = new();

    if (!CountFailed(client.Read(fixed512)))
    {
        return 1;
    }

    if (!CountFailed(client.Read(fixed4096)))
    {
        return 2;
    }

    if (!CountFailed(client.Read(fixed8192)))
    {
        return 3;
    }

    if (!CountFailed(client.Read(dynamicBuffer, 4)))
    {
        return 4;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);

    stack ascii fixed512Read = LlvmDefinitionBody(llvm, "@TcpClient_Read__mutborrowTcpClient_mutborrowSystem_Runtime_Buffer_FixedByteBuffer512_(");
    stack ascii fixed4096Read = LlvmDefinitionBody(llvm, "@TcpClient_Read__mutborrowTcpClient_mutborrowSystem_Runtime_Buffer_FixedByteBuffer4096_(");
    stack ascii fixed8192Read = LlvmDefinitionBody(llvm, "@TcpClient_Read__mutborrowTcpClient_mutborrowSystem_Runtime_Buffer_FixedByteBuffer8192_(");
    stack ascii dynamicRead = LlvmDefinitionBody(llvm, "@TcpClient_Read__mutborrowTcpClient_mutborrowSystem_Runtime_Buffer_DynamicByteBuffer_");

    if (!Contains(fixed512Read, "ptr noundef nonnull noalias nocapture dereferenceable(528) align 8 %arg_destination"))
    {
        return false;
    }

    if (!Contains(fixed512Read, "LinuxSyscall3HandleBuffer")
        && !Contains(fixed4096Read, "LinuxSyscall3HandleBuffer")
        && !Contains(fixed8192Read, "LinuxSyscall3HandleBuffer"))
    {
        return false;
    }

    if (!Contains(llvm, "System_Runtime_Platform_ReadSocketVector2")
        || !Contains(llvm, "System_Runtime_Platform_WriteSocketVector2"))
    {
        return false;
    }

    if (!Contains(fixed512Read, "FixedByteBuffer512_WriteSlice__mutborrowFixedByteBuffer512_")
        || !Contains(fixed512Read, "FixedByteBuffer512_AdvanceWrite"))
    {
        return false;
    }

    if (!Contains(fixed4096Read, "FixedByteBuffer4096_WriteSlice__mutborrowFixedByteBuffer4096_")
        || !Contains(fixed4096Read, "FixedByteBuffer4096_AdvanceWrite"))
    {
        return false;
    }

    if (!Contains(fixed8192Read, "FixedByteBuffer8192_WriteSlice__mutborrowFixedByteBuffer8192_")
        || !Contains(fixed8192Read, "FixedByteBuffer8192_AdvanceWrite"))
    {
        return false;
    }

    if (Contains(fixed512Read, "FixedByteBuffer512_WriteByte")
        || Contains(fixed4096Read, "FixedByteBuffer4096_WriteByte")
        || Contains(fixed8192Read, "FixedByteBuffer8192_WriteByte"))
    {
        return false;
    }

    if (Contains(fixed512Read, "alloca [512 x i8]")
        || Contains(fixed4096Read, "alloca [4096 x i8]")
        || Contains(fixed8192Read, "alloca [8192 x i8]"))
    {
        return false;
    }

    if (!Contains(dynamicRead, "LinuxSyscall3HandleBuffer")
        || !Contains(dynamicRead, "DynamicByteBuffer_WriteSlice"))
    {
        return false;
    }

    if (Contains(dynamicRead, "DynamicByteBuffer_WriteByte"))
    {
        return false;
    }

    return true;
}
