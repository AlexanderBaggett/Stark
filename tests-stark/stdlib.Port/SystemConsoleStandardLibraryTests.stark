import StdlibPortSupport
import System
import System.Testing
import System.Text
module SystemConsoleStandardLibraryTests

// Ported from SystemConsoleStandardLibraryTests.StdLibSourceConsoleSupportsAsciiAndUnicodeOverloads.
internal fn bool StdLibSourceConsoleSupportsAsciiAndUnicodeOverloadsImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-console-ascii-unicode-overloads", raw"""
        import System
        import System.Text
        module Demo

        fn void Use()
        {
            System.Console.Write("ascii");
            System.Console.Write((unicode)"ascii");
            System.Console.WriteLine("line");
            System.Console.WriteLine((unicode)"line");
            System.Console.WriteError("error");
            System.Console.WriteError((unicode)"error");
            System.Console.WriteErrorLine("error-line");
            System.Console.WriteErrorLine((unicode)"error-line");
            return;
        }
        """);
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemConsoleStandardLibraryTests.StdLibSourceConsoleSupportsUnicodeInputSurface.
internal fn bool StdLibSourceConsoleSupportsUnicodeInputSurfaceImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-console-unicode-input-surface", raw"""
        import System
        module Demo

        fn void Use()
        {
            stack mut System.Text.OwnedUnicode line = new System.Text.OwnedUnicode();
            stack mut System.Text.OwnedAscii asciiLine = new System.Text.OwnedAscii();
            stack mut System.Text.OwnedUnicode unicodeLine = new System.Text.OwnedUnicode();
            stack mut System.Text.OwnedUnicode unit = new System.Text.OwnedUnicode();

            switch (System.Console.ReadLine())
            {
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(var lineError):
                    return;
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Ok(var lineValue):
                    line = lineValue;
            }

            switch (System.Console.ReadAsciiLine())
            {
                case System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(var asciiError):
                    return;
                case System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(var asciiValue):
                    asciiLine = asciiValue;
            }

            switch (System.Console.ReadUnicodeLine())
            {
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(var unicodeError):
                    return;
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Ok(var unicodeValue):
                    unicodeLine = unicodeValue;
            }

            switch (System.Console.Read())
            {
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(var unitError):
                    return;
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Ok(var unitValue):
                    unit = unitValue;
            }

            System.Console.WriteLine(line.View());
            System.Console.WriteLine(asciiLine.View());
            System.Console.WriteLine(unicodeLine.View());
            System.Console.WriteLine(unit.View());
            return;
        }
        """);
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemConsoleStandardLibraryTests.StdLibSourceUnicodeConsoleInputWorksAtRuntime.
internal fn bool StdLibSourceUnicodeConsoleInputWorksAtRuntimeImpl()
{
    // PORT-NOTE: original builds an executable via the CLI (--emit-exe) and runs it,
    // feeding "hello\nbytes\nα" over UTF-8 stdin and asserting exit code 0 with empty
    // stdout/stderr. The compile-only host bridge cannot link, run, or pipe stdin into
    // the produced binary, so this reduces to compiling the embedded program and
    // asserting it succeeds.
    stack mut ProgramCompile c = CompileProgram("stdlib-console-unicode-input-runtime", raw"""
        import System
        module App

        export unsafe fn i32[min max] main()
        {
            stack mut System.Text.OwnedUnicode line = new();
            switch (System.Console.ReadLine())
            {
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(var lineError):
                    return 10;
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Ok(var lineValue):
                    line = lineValue;
            }

            stack mut System.Text.OwnedAscii asciiLine = new();
            switch (System.Console.ReadAsciiLine())
            {
                case System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(var asciiError):
                    return 11;
                case System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(var asciiValue):
                    asciiLine = asciiValue;
            }

            stack mut System.Text.OwnedUnicode unit = new();
            switch (System.Console.Read())
            {
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(var unitError):
                    return 12;
                case System.Memory.MemoryResult<System.Text.OwnedUnicode>.Ok(var unitValue):
                    unit = unitValue;
            }

            if (line.Length() != 5)
            {
                return 1;
            }

            if (asciiLine.Length() != 5)
            {
                return 2;
            }

            if (unit.Length() != 1)
            {
                return 3;
            }

            stack i32[min max][] lineSlice = line.AsSlice();
            if (lineSlice[0] != 104)
            {
                return 4;
            }

            if (lineSlice[1] != 101)
            {
                return 5;
            }

            stack i8[min max][] asciiSlice = asciiLine.AsSlice();
            if (asciiSlice[0] != 98)
            {
                return 6;
            }

            if (asciiSlice[1] != 121)
            {
                return 7;
            }

            stack i32[min max][] unitSlice = unit.AsSlice();
            if (unitSlice[0] != 945)
            {
                return 8;
            }

            return 0;
        }
        """);
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemConsoleStandardLibraryTests.PackagedStdLibConsoleReturnsIoStatusWithoutSource.
internal fn bool PackagedStdLibConsoleReturnsIoStatusWithoutSourceImpl()
{
    // PORT-NOTE: original compiles against the packaged stdlib image (no source on the
    // include path), emits an executable via the CLI, runs it, and asserts process exit
    // code 0 with stdout "Console Status\n" and stderr "stderr works\n". The compile-only
    // host bridge cannot select a packaged image, link, or run the binary, so this reduces
    // to compiling the embedded program and asserting it succeeds.
    stack mut ProgramCompile c = CompileProgram("packaged-console-iostatus-without-source", raw"""
        import System
        module App

        fn bool IsOk(System.IO.IOStatus status)
        {
            switch (status)
            {
                case System.IO.IOStatus.Ok:
                    return true;
                case System.IO.IOStatus.Err(var error):
                    return false;
            }
        }

        export fn i32[min max] main()
        {
            if (!IsOk(System.Console.Write("Console")))
            {
                return 1;
            }

            if (!IsOk(System.Console.WriteLine(" Status")))
            {
                return 2;
            }

            if (!IsOk(System.Console.WriteErrorLine("stderr works")))
            {
                return 3;
            }

            return 0;
        }
        """);
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

