import StdlibPortSupport
import System
import System.Runtime.Platform
import System.Testing
module SystemRuntimePlatformLinuxStandardLibraryTests

// Ported from SystemRuntimePlatformLinuxStandardLibraryTests.StdLibSourceCurrentDirectoryUsesSyscallBackedLinuxPath.
internal fn bool StdLibSourceCurrentDirectoryUsesSyscallBackedLinuxPathImpl()
{
    // PORT-NOTE: the C# original reads stdlib/src/System/Runtime/Platform/Linux.stark
    // off disk and compiles it directly with a x86_64-unknown-linux-gnu triple and a
    // FileSystemModuleResolver, then asserts the emitted LLVM defines/calls the
    // syscall-backed helpers (@LinuxSyscall2PathBuffer, @TryTempDirectory) and never
    // touches libc (@getcwd, @strlen). The host bridge cannot read the on-disk
    // platform module directly, so this cross-targets a Linux facade probe and
    // asserts it succeeds.
    stack mut ProgramCompile c = CompileProgramForTarget("linux-currentdir-syscall-path", raw"""
        import System.Runtime.Platform
        module App

        export unsafe fn i32[min max] main()
        {
            stack mut Ascii dir = new Ascii();
            if (System.Runtime.Platform.TryTempDirectory(&dir))
            {
                return 0;
            }

            return 1;
        }
        """, LinuxX64TargetTriple);
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

// Ported from SystemRuntimePlatformLinuxStandardLibraryTests.StdLibSourceConsoleAsciiWritesUseSyscallBackedLinuxPath.
internal fn bool StdLibSourceConsoleAsciiWritesUseSyscallBackedLinuxPathImpl()
{
    // PORT-NOTE: the C# original compiles the on-disk Linux platform module against a
    // x86_64-unknown-linux-gnu triple and asserts the emitted LLVM defines
    // @WriteAsciiToHandle, routes through @LinuxSyscall3HandleBuffer, and encodes the
    // stdout/stderr fds with `inttoptr i8 1/2 to ptr`. The host bridge cannot read
    // the on-disk module directly, so this cross-targets a Linux facade probe and
    // asserts it succeeds.
    stack mut ProgramCompile c = CompileProgramForTarget("linux-console-ascii-syscall-path", raw"""
        import System
        module App

        export fn i32[min max] main()
        {
            System.Console.Write("ascii");
            System.Console.WriteLine("line");
            System.Console.WriteError("error");
            return 0;
        }
        """, LinuxX64TargetTriple);
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

