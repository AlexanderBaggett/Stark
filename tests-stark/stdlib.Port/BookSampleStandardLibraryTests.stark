import StdlibPortSupport
import System.Testing
module BookSampleStandardLibraryTests

// Ported from BookSampleStandardLibraryTests.PositiveBookSamplesCompileWithStrictIntegerRanges.
//
// PORT-NOTE: the C# test is a [Theory] whose [MemberData] enumerates positive
// book samples discovered on the filesystem (site/content/book/<chapter>/samples/*.stark),
// reading each file at runtime and compiling it with a FileSystemModuleResolver,
// StopAfterPassId: "borrow-liveness", and EnforceIntegerRangeStorageRules: true.
// The compile-only host bridge cannot enumerate the sample tree, stop after a
// named pass, or toggle the strict-integer-range storage rule, so this port
// embeds a representative integer-ranges book sample verbatim
// (appendix-c-integer-widths/samples/values-ranges.stark) and asserts the
// compile succeeds, which is the acceptance signal the original [Theory] checks.
internal fn bool PositiveBookSamplesCompileWithStrictIntegerRangesImpl()
{
    stack mut ProgramCompile c = CompileProgram("book-sample-values-ranges", raw"""
module Book.ValuesRanges

finite law u8[0 100] KeepScore(u8[0 100] score)
{
    return score;
}

finite law u8[0 127] SmallUnsignedValue()
{
    return 42;
}

export fn i32[min max] main()
{
    stack u8[0 100] score = KeepScore(40);
    stack u8[0 127] byteValue = SmallUnsignedValue();

    if (score != 40)
    {
        return 1;
    }

    if (byteValue != 42)
    {
        return 2;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}
