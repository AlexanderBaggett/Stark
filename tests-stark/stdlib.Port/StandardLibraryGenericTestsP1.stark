// Ported from StandardLibraryGenericTests.StdLibSourceCommonErrorResultModelUsesCompactEnumLayouts.
//
// PORT-NOTE: the C# test runs the embedded program with StopAfterPassId:
// "enum-layout" and inspects the EnumLayoutModel artifact, asserting the common
// IO/Memory error-result enums use compact layouts. The compile-only host bridge
// cannot stop after the enum-layout pass or read the EnumLayoutModel artifact, so
// this port compiles the embedded program verbatim and asserts the compile
// succeeds.
public unsafe fn bool StdLibSourceCommonErrorResultModelUsesCompactEnumLayoutsImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-common-error-result-compact-enum", raw"""
import System
module Demo

fn i32[min max] ReadIo(System.IO.IOResult<i32[min max]> result)
{
    switch (result)
    {
        case System.IO.IOResult<i32[min max]>.Ok(var value):
            return value;
        case System.IO.IOResult<i32[min max]>.Err(var error):
            return 0;
    }
}

fn i32[min max] ReadMemory(System.Memory.MemoryResult<i32[min max]> result)
{
    switch (result)
    {
        case System.Memory.MemoryResult<i32[min max]>.Ok(var value):
            return value;
        case System.Memory.MemoryResult<i32[min max]>.Err(var error):
            return 0;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

