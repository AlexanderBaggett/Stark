import StdlibPortSupport
import System.Testing
module StandardLibraryGenericTestsP1

// Ported from StandardLibraryGenericTests.StdLibSourceGraphIncludesMilestone7ModuleLayout.
//
// PORT-NOTE: the C# test compiles stdlib/src/System.stark with a
// FileSystemModuleResolver and inspects the ModuleGraph artifact, asserting that
// the milestone-7 module layout is loaded (System and its System.* submodules)
// while System.IO.Stdout / System.IO.Stderr are absent. The compile-only host
// bridge cannot read the ModuleGraph artifact or enumerate loaded modules, so
// this port compiles a program that imports System (which transitively pulls in
// the milestone-7 module layout from the host stdlib) and asserts the compile
// succeeds, the acceptance signal the original test checks.
public unsafe fn bool StdLibSourceGraphIncludesMilestone7ModuleLayoutImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-source-graph-milestone7", raw"""
import System
module Demo

fn void Use()
{
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

