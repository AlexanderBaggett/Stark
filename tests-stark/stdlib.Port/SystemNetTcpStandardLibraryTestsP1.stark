// Ported from SystemNetTcpStandardLibraryTests.StdLibSourceNetTcpCloseRoutesOpenHandlesThroughPlatformSocketClose.
//
// PORT-NOTE: the C# test reads the on-disk stdlib source
// stdlib/src/System/Net/Tcp.stark, compiles it directly with EmitLlvmIr pinned to
// the x86_64-unknown-linux-gnu target, then scans the module IR and the per-body
// LLVM of TcpClient.Close / TcpListener.Close to confirm both route an open handle
// through the Linux close syscall (LinuxCloseSyscallNumber + LinuxSyscall1Handle)
// and convert the platform result via StatusFromPlatformResult /
// NetworkErrorFromPlatformResult. The compile-only host bridge cannot read the
// repository source tree nor override the LLVM target triple, so this port embeds
// a driver that imports System.Net.Tcp and exercises the full Connect / Listen /
// Accept / Read / Write / Shutdown / Close lifecycle so the host stdlib emits the
// TcpClient_* / TcpListener_* definitions and pulls in the Linux platform module,
// then keeps the original module-wide IR substring assertions and applies the
// per-body close checks via LlvmDefinitionBody (the Stark mirror of
// ExtractDefinedFunctionText). The Linux-specific symbol checks are target-
// dependent in the original and assume a Linux host backend.
public unsafe fn bool StdLibSourceNetTcpCloseRoutesOpenHandlesThroughPlatformSocketCloseImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-net-tcp-close-routes-platform-close", raw"""
import System.Net.Tcp
module Demo

fn bool StatusOk(System.Net.NetStatus status)
{
    switch (status)
    {
        case System.Net.NetStatus.Ok:
            return true;
        case System.Net.NetStatus.Err(var error):
            return false;
    }
}

fn i32[min max] Run()
{
    stack System.Net.IPv4Endpoint endpoint = new System.Net.IPv4Endpoint()
    {
        Address = new System.Net.IPv4Address()
        {
            A = 127,
            B = 0,
            C = 0,
            D = 1
        },
        Port = 80
    };
    stack System.Net.NetResult<System.Net.Tcp.TcpClient> connected =
        System.Net.Tcp.TcpClient.Connect(endpoint);
    switch (connected)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Ok(var connectedClient):
            if (!connectedClient.IsOpen())
            {
                return 7;
            }
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Err(var error):
    }

    stack System.Net.NetResult<System.Net.Tcp.TcpListener> listening =
        System.Net.Tcp.TcpListener.Listen(endpoint);
    switch (listening)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpListener>.Ok(var listeningSocket):
            if (!listeningSocket.IsOpen())
            {
                return 9;
            }
        case System.Net.NetResult<System.Net.Tcp.TcpListener>.Err(var error):
    }

    stack mut System.Net.Tcp.TcpClient client = new();
    stack mut i8[min max][4] buffer =
    {
        1, 2, 3, 4
    };
    stack System.Net.NetResult<u64[0 2 ** 63 - 1]> readResult = client.Read(buffer);
    switch (readResult)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var count):
            return 10;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
    }

    stack System.Net.NetResult<u64[0 2 ** 63 - 1]> writeResult = client.Write(buffer);
    switch (writeResult)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var count):
            return 11;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
    }

    if (StatusOk(client.Shutdown(System.Net.Tcp.TcpShutdown.Both)))
    {
        return 8;
    }

    if (!StatusOk(client.Close()))
    {
        return 2;
    }

    stack mut System.Net.Tcp.TcpListener listener = new();
    stack System.Net.NetResult<System.Net.Tcp.TcpClient> accepted = listener.Accept();
    switch (accepted)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Ok(var acceptedClient):
            return 13;
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Err(var error):
    }

    if (!StatusOk(listener.Close()))
    {
        return 4;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    if (!Contains(llvm, "@TcpClient_Read__")
        || !Contains(llvm, "@TcpClient_Write__")
        || !Contains(llvm, "define fastcc noundef %System_Net_NetStatus @TcpClient_Shutdown(")
        || !Contains(llvm, "define fastcc noundef %System_Net_NetStatus @TcpClient_Close(")
        || !Contains(llvm, "define fastcc noundef %System_Net_NetStatus @TcpListener_Close(")
        || !Contains(llvm, "@TcpClient_Connect(")
        || !Contains(llvm, "@TcpListener_Listen(")
        || !Contains(llvm, "@TcpListener_Accept(")
        || !Contains(llvm, "call fastcc ptr @__stark_inline_clone_System_Runtime_Platform_Linux_ConnectTcpIPv4(")
        || !Contains(llvm, "call fastcc ptr @__stark_inline_clone_System_Runtime_Platform_Linux_ListenTcpIPv4(")
        || !Contains(llvm, "call fastcc ptr @__stark_inline_clone_System_Runtime_Platform_Linux_AcceptSocket(")
        || !Contains(llvm, "@System_Runtime_Platform_Linux_LinuxReadSyscallNumber")
        || !Contains(llvm, "@System_Runtime_Platform_Linux_LinuxWriteSyscallNumber")
        || !Contains(llvm, "call i64 @LinuxSyscall3HandleBuffer(")
        || !Contains(llvm, "GetMutableByteSliceParts")
        || !Contains(llvm, "GetByteSliceParts")
        || !Contains(llvm, "@System_Runtime_Platform_Linux_LinuxShutdownSyscallNumber")
        || !Contains(llvm, "@System_Runtime_Platform_Linux_LinuxCloseSyscallNumber")
        || !Contains(llvm, "define fastcc noundef %System_Net_NetStatus @StatusFromPlatformResult(")
        || !Contains(llvm, "@ByteCountFromPlatformResult(")
        || !Contains(llvm, "call fastcc %System_Net_NetworkError @NetworkErrorFromPlatformResult("))
    {
        return false;
    }

    stack ascii clientCloseBody = LlvmDefinitionBody(llvm, "TcpClient_Close");
    stack ascii listenerCloseBody = LlvmDefinitionBody(llvm, "TcpListener_Close");
    if (!CloseBodyRoutesOpenHandleThroughPlatformClose(clientCloseBody)
        || !CloseBodyRoutesOpenHandleThroughPlatformClose(listenerCloseBody))
    {
        return false;
    }

    return true;
}

// Mirror of the C# AssertCloseBodyRoutesOpenHandleThroughPlatformClose helper:
// the close body must reference the Linux close syscall number and call
// LinuxSyscall1Handle, and it must convert the platform result either directly
// through StatusFromPlatformResult or via the inlined NetworkErrorFromPlatformResult
// branch (icmp slt i32 + insertvalue %System_Net_NetStatus).
unsafe fn bool CloseBodyRoutesOpenHandleThroughPlatformClose(ascii body)
{
    if (!Contains(body, "@System_Runtime_Platform_Linux_LinuxCloseSyscallNumber")
        || !Contains(body, "call i64 @LinuxSyscall1Handle("))
    {
        return false;
    }

    if (Contains(body, "call fastcc %System_Net_NetStatus @StatusFromPlatformResult("))
    {
        return true;
    }

    return Contains(body, "icmp slt i32")
        && Contains(body, "call fastcc %System_Net_NetworkError @NetworkErrorFromPlatformResult(")
        && Contains(body, "insertvalue %System_Net_NetStatus");
}

// Ported from SystemNetTcpStandardLibraryTests.StdLibSourceLinuxSocketCloseUsesCloseSyscallPath.
//
// PORT-NOTE: the C# test reads the on-disk stdlib source
// stdlib/src/System/Runtime/Platform/Linux.stark, compiles it directly with
// EmitLlvmIr pinned to x86_64-unknown-linux-gnu, then inspects the IR for the
// close-syscall lowering of CloseSocket (which routes through CloseFile and
// LinuxSyscall1Handle and never emits the Winsock closesocket import). The
// compile-only host bridge cannot read the repository source tree nor override
// the LLVM target triple, so this port embeds a driver that exercises the public
// TCP close path so the host compiler pulls in the Linux platform module, then
// keeps the original IR substring assertions verbatim. The Linux-specific symbol
// checks are target-dependent in the original and assume a Linux host backend.
public unsafe fn bool StdLibSourceLinuxSocketCloseUsesCloseSyscallPathImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-linux-socket-close-syscall", raw"""
import System.Net.Tcp
module Demo

fn bool StatusOk(System.Net.NetStatus status)
{
    switch (status)
    {
        case System.Net.NetStatus.Ok:
            return true;
        case System.Net.NetStatus.Err(var error):
            return false;
    }
}

export unsafe fn i32[min max] main()
{
    stack mut System.Net.Tcp.TcpClient client = new();
    if (!StatusOk(client.Close()))
    {
        return 1;
    }

    stack mut System.Net.Tcp.TcpListener listener = new();
    if (!StatusOk(listener.Close()))
    {
        return 2;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    if (!Contains(llvm, "define fastcc noundef i32 @CloseSocket("))
    {
        return false;
    }

    if (!Contains(llvm, "call fastcc i32 @CloseFile("))
    {
        return false;
    }

    if (!Contains(llvm, "call i64 @LinuxSyscall1Handle("))
    {
        return false;
    }

    if (!DoesNotContain(llvm, "@closesocket("))
    {
        return false;
    }

    return true;
}

// Ported from SystemNetTcpStandardLibraryTests.StdLibSourceLinuxTcpConnectUsesSocketAndConnectSyscallPath.
//
// PORT-NOTE: the C# test reads the on-disk stdlib source
// stdlib/src/System/Runtime/Platform/Linux.stark, compiles it directly with
// EmitLlvmIr pinned to x86_64-unknown-linux-gnu, then inspects the IR and the
// ConnectTcpIPv4 body for the socket+connect syscall path (LinuxSyscall3Integers
// to create the socket, WriteTcpIPv4Sockaddr + LinuxSyscall3HandleBuffer to
// connect, and the folded LinuxCloseSyscallNumber 3 cleanup that does not fall
// back to CloseFile). The compile-only host bridge cannot read the repository
// source tree nor override the LLVM target triple, so this port embeds a driver
// that exercises the public TCP connect path so the host compiler pulls in the
// Linux platform module, then keeps the original IR substring assertions verbatim
// and applies the body checks via LlvmDefinitionBody. The Linux-specific symbol
// checks are target-dependent in the original and assume a Linux host backend.
public unsafe fn bool StdLibSourceLinuxTcpConnectUsesSocketAndConnectSyscallPathImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-linux-tcp-connect-syscall", raw"""
import System.Net.Tcp
module Demo

fn i32[min max] Run()
{
    stack System.Net.IPv4Endpoint endpoint = new System.Net.IPv4Endpoint()
    {
        Address = new System.Net.IPv4Address()
        {
            A = 127,
            B = 0,
            C = 0,
            D = 1
        },
        Port = 80
    };
    stack System.Net.NetResult<System.Net.Tcp.TcpClient> connected =
        System.Net.Tcp.TcpClient.Connect(endpoint);
    switch (connected)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Ok(var connectedClient):
            if (!connectedClient.IsOpen())
            {
                return 1;
            }
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Err(var error):
            return 2;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    if (!Contains(llvm, "define fastcc noundef ptr @ConnectTcpIPv4(")
        || !Contains(llvm, "call i64 @LinuxSyscall3Integers(")
        || !Contains(llvm, "call i64 @LinuxSyscall3HandleBuffer(")
        || !Contains(llvm, "call fastcc void @WriteTcpIPv4Sockaddr("))
    {
        return false;
    }

    stack ascii connectBody = LlvmDefinitionBody(llvm, "ConnectTcpIPv4");
    // LinuxCloseSyscallNumber (3) is a comptime constant that folds into the call site.
    if (!Contains(connectBody, "call i64 @LinuxSyscall1Handle(i64 3, "))
    {
        return false;
    }

    if (!DoesNotContain(connectBody, "call fastcc i32 @CloseFile("))
    {
        return false;
    }

    return true;
}

