// Ported from SystemNetTcpStandardLibraryTests.StdLibSourceLinuxTcpReadWriteUseReadAndWriteSyscallPaths.
//
// PORT-NOTE: the C# test reads the on-disk stdlib source
// stdlib/src/System/Runtime/Platform/Linux.stark, compiles it directly with
// EmitLlvmIr pinned to x86_64-unknown-linux-gnu, then inspects the IR and the
// ReadSocketVector2 / WriteSocketVector2 bodies for the read/write/readv/writev
// syscall paths and the %LinuxIovec scatter-gather layout. The compile-only host
// bridge cannot read the repository source tree nor override the LLVM target
// triple, so this port embeds a driver that exercises the public TCP read / write
// / vectored-read / vectored-write paths so the host compiler pulls in the Linux
// platform module, then keeps the original assertions. The four `Assert.Matches`
// regexes -- `define fastcc noundef(?: range(...))? i64 @{Read,Write}Socket{,Vector2}(`
// -- are expressed with AnyLineContainsBoth("define fastcc noundef", "i64 @...("),
// the closest faithful line-level expression of the optional `range(...)` regex.
// The Linux-specific symbol checks are target-dependent and assume a Linux host
// backend.
public unsafe fn bool StdLibSourceLinuxTcpReadWriteUseReadAndWriteSyscallPathsImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-linux-tcp-readwrite-syscall", raw"""
import System.Net.Tcp
module Demo

fn i32[min max] Run()
{
    stack mut System.Net.Tcp.TcpClient client = new();
    stack mut i8[min max][4] buffer =
    {
        1, 2, 3, 4
    };
    stack mut i8[min max][4] second =
    {
        5, 6, 7, 8
    };
    stack System.Net.NetResult<u64[0 2 ** 63 - 1]> readResult = client.Read(buffer);
    switch (readResult)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var count):
            return 1;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
    }

    stack System.Net.NetResult<u64[0 2 ** 63 - 1]> writeResult = client.Write(buffer);
    switch (writeResult)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var count):
            return 2;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
    }

    stack System.Net.NetResult<u64[0 2 ** 63 - 1]> readVectored = client.ReadVectored(buffer, second);
    switch (readVectored)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var count):
            return 3;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
    }

    stack System.Net.NetResult<u64[0 2 ** 63 - 1]> writeVectored = client.WriteVectored(buffer, second);
    switch (writeVectored)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var count):
            return 4;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    if (!AnyLineContainsBoth(llvm, "define fastcc noundef", "i64 @ReadSocket(")
        || !AnyLineContainsBoth(llvm, "define fastcc noundef", "i64 @WriteSocket(")
        || !AnyLineContainsBoth(llvm, "define fastcc noundef", "i64 @ReadSocketVector2(")
        || !AnyLineContainsBoth(llvm, "define fastcc noundef", "i64 @WriteSocketVector2("))
    {
        return false;
    }

    if (!Contains(llvm, "%LinuxIovec = type { ptr, i64 }")
        || !Contains(llvm, "call i64 @LinuxSyscall3HandleBuffer(")
        || !Contains(llvm, "@LinuxReadSyscallNumber")
        || !Contains(llvm, "@LinuxWriteSyscallNumber")
        || !Contains(llvm, "@LinuxReadvSyscallNumber")
        || !Contains(llvm, "@LinuxWritevSyscallNumber"))
    {
        return false;
    }

    stack ascii readVectorBody = LlvmDefinitionBody(llvm, "ReadSocketVector2");
    stack ascii writeVectorBody = LlvmDefinitionBody(llvm, "WriteSocketVector2");
    // LinuxReadvSyscallNumber (19) / LinuxWritevSyscallNumber (20) are comptime
    // constants that fold into the syscall wrapper call sites.
    if (!Contains(readVectorBody, "[2 x %LinuxIovec]")
        || !Contains(readVectorBody, "call i64 @LinuxSyscall3HandleBuffer(i64 19, ")
        || !Contains(readVectorBody, "i64 2"))
    {
        return false;
    }

    if (!Contains(writeVectorBody, "[2 x %LinuxIovec]")
        || !Contains(writeVectorBody, "call i64 @LinuxSyscall3HandleBuffer(i64 20, ")
        || !Contains(writeVectorBody, "i64 2"))
    {
        return false;
    }

    if (!DoesNotContain(llvm, "@recv(")
        || !DoesNotContain(llvm, "@send(")
        || !DoesNotContain(llvm, "@readv(")
        || !DoesNotContain(llvm, "@writev("))
    {
        return false;
    }

    return true;
}

// Ported from SystemNetTcpStandardLibraryTests.StdLibSourceLinuxTcpListenUsesSocketBindAndListenSyscallPath.
//
// PORT-NOTE: the C# test reads the on-disk stdlib source
// stdlib/src/System/Runtime/Platform/Linux.stark, compiles it directly with
// EmitLlvmIr pinned to x86_64-unknown-linux-gnu, then inspects the IR and the
// ListenTcpIPv4 body for the socket+bind+listen syscall path (LinuxSyscall3Integers
// for the socket, LinuxSyscall3HandleBuffer for bind, LinuxSyscall2HandleInteger
// for listen, with the folded LinuxCloseSyscallNumber 3 cleanup that does not fall
// back to CloseFile, and never the Winsock bind/listen imports). The compile-only
// host bridge cannot read the repository source tree nor override the LLVM target
// triple, so this port embeds a driver that exercises the public TCP listen path
// so the host compiler pulls in the Linux platform module, then keeps the original
// IR substring assertions verbatim and applies the body checks via
// LlvmDefinitionBody. The Linux-specific symbol checks are target-dependent and
// assume a Linux host backend.
public unsafe fn bool StdLibSourceLinuxTcpListenUsesSocketBindAndListenSyscallPathImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-linux-tcp-listen-syscall", raw"""
import System.Net.Tcp
module Demo

fn i32[min max] Run()
{
    stack System.Net.IPv4Endpoint endpoint = new System.Net.IPv4Endpoint()
    {
        Address = new System.Net.IPv4Address()
        {
            A = 127,
            B = 0,
            C = 0,
            D = 1
        },
        Port = 80
    };
    stack System.Net.NetResult<System.Net.Tcp.TcpListener> listening =
        System.Net.Tcp.TcpListener.Listen(endpoint);
    switch (listening)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpListener>.Ok(var listeningSocket):
            if (!listeningSocket.IsOpen())
            {
                return 1;
            }
        case System.Net.NetResult<System.Net.Tcp.TcpListener>.Err(var error):
            return 2;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    if (!Contains(llvm, "define fastcc noundef ptr @ListenTcpIPv4(")
        || !Contains(llvm, "call i64 @LinuxSyscall3Integers(")
        || !Contains(llvm, "call i64 @LinuxSyscall3HandleBuffer(")
        || !Contains(llvm, "call i64 @LinuxSyscall2HandleInteger(")
        || !Contains(llvm, "@LinuxBindSyscallNumber")
        || !Contains(llvm, "@LinuxListenSyscallNumber"))
    {
        return false;
    }

    stack ascii listenBody = LlvmDefinitionBody(llvm, "ListenTcpIPv4");
    // LinuxCloseSyscallNumber (3) is a comptime constant that folds into the call site.
    if (!Contains(listenBody, "call i64 @LinuxSyscall1Handle(i64 3, "))
    {
        return false;
    }

    if (!DoesNotContain(listenBody, "call fastcc i32 @CloseFile("))
    {
        return false;
    }

    if (!DoesNotContain(llvm, "@bind(")
        || !DoesNotContain(llvm, "@listen("))
    {
        return false;
    }

    return true;
}

// Ported from SystemNetTcpStandardLibraryTests.StdLibSourceLinuxTcpAcceptUsesAccept4SyscallPath.
//
// PORT-NOTE: the C# test reads the on-disk stdlib source
// stdlib/src/System/Runtime/Platform/Linux.stark, compiles it directly with
// EmitLlvmIr pinned to x86_64-unknown-linux-gnu, then inspects the IR and the
// AcceptSocket body for the accept4 syscall path (LinuxSyscall4HandlePointersInteger
// + LinuxAccept4SyscallNumber + LinuxSocketCloseOnExecFlag, with no close-syscall
// cleanup in the body and never the libc accept/accept4 imports). The compile-only
// host bridge cannot read the repository source tree nor override the LLVM target
// triple, so this port embeds a driver that exercises the public TCP accept path
// so the host compiler pulls in the Linux platform module, then keeps the original
// IR substring assertions verbatim and applies the body checks via
// LlvmDefinitionBody. The Linux-specific symbol checks are target-dependent and
// assume a Linux host backend.
public unsafe fn bool StdLibSourceLinuxTcpAcceptUsesAccept4SyscallPathImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-linux-tcp-accept-syscall", raw"""
import System.Net.Tcp
module Demo

fn i32[min max] Run()
{
    stack mut System.Net.Tcp.TcpListener listener = new();
    stack System.Net.NetResult<System.Net.Tcp.TcpClient> accepted = listener.Accept();
    switch (accepted)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Ok(var acceptedClient):
            return 1;
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Err(var error):
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    if (!Contains(llvm, "define fastcc noundef ptr @AcceptSocket(")
        || !Contains(llvm, "call i64 @LinuxSyscall4HandlePointersInteger(")
        || !Contains(llvm, "@LinuxAccept4SyscallNumber")
        || !Contains(llvm, "@LinuxSocketCloseOnExecFlag"))
    {
        return false;
    }

    stack ascii acceptBody = LlvmDefinitionBody(llvm, "AcceptSocket");
    if (!DoesNotContain(acceptBody, "@LinuxCloseSyscallNumber")
        || !DoesNotContain(acceptBody, "call i64 @LinuxSyscall1Handle("))
    {
        return false;
    }

    if (!DoesNotContain(llvm, "@accept(")
        || !DoesNotContain(llvm, "@accept4("))
    {
        return false;
    }

    return true;
}

// Ported from SystemNetTcpStandardLibraryTests.StdLibSourceWindowsTcpUsesWinsockPath.
//
// PORT-NOTE: the C# test reads the on-disk stdlib source
// stdlib/src/System/Runtime/Platform/Windows.stark, compiles it directly with
// EmitLlvmIr pinned to the x86_64-pc-windows-msvc target, then asserts the full
// Winsock lowering: WSAStartup / WSAGetLastError / InitOnceExecuteOnce / WSASocketW
// / connect / bind / listen / accept / recv / send / WSARecv / WSASend / shutdown /
// closesocket declarations and call sites, the %WinSocketBuffer / %WinInitOnce
// layouts, the @WinSockInitOnce global, the Connect/Listen/Accept/Read/Write/
// Shutdown/Close definitions, and that NO @LinuxSyscall* symbol appears. The
// compile-only host bridge cannot read the repository source tree and -- crucially
// -- cannot override the LLVM target triple to x86_64-pc-windows-msvc, so it
// cannot reproduce the Windows-specific Winsock IR (the host backend would emit the
// Linux syscall path instead, directly contradicting the @LinuxSyscall* exclusion).
// This port therefore compiles a driver that imports System.Net.Tcp and exercises
// the full Connect / Listen / Accept / Read / Write / Shutdown / Close lifecycle
// through the host stdlib and asserts the compile succeeds, the strongest signal
// the bridge can reproduce for the Windows backend; the Winsock-symbol IR
// assertions are dropped because they require the msvc target triple.
public unsafe fn bool StdLibSourceWindowsTcpUsesWinsockPathImpl()
{
    stack mut ProgramCompile c = CompileProgram("stdlib-windows-tcp-winsock", raw"""
import System.Net.Tcp
module Demo

fn bool StatusOk(System.Net.NetStatus status)
{
    switch (status)
    {
        case System.Net.NetStatus.Ok:
            return true;
        case System.Net.NetStatus.Err(var error):
            return false;
    }
}

fn i32[min max] Run()
{
    stack System.Net.IPv4Endpoint endpoint = new System.Net.IPv4Endpoint()
    {
        Address = new System.Net.IPv4Address()
        {
            A = 127,
            B = 0,
            C = 0,
            D = 1
        },
        Port = 80
    };
    stack System.Net.NetResult<System.Net.Tcp.TcpClient> connected =
        System.Net.Tcp.TcpClient.Connect(endpoint);
    switch (connected)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Ok(var connectedClient):
            if (!connectedClient.IsOpen())
            {
                return 7;
            }
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Err(var error):
    }

    stack System.Net.NetResult<System.Net.Tcp.TcpListener> listening =
        System.Net.Tcp.TcpListener.Listen(endpoint);
    switch (listening)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpListener>.Ok(var listeningSocket):
            if (!listeningSocket.IsOpen())
            {
                return 9;
            }
        case System.Net.NetResult<System.Net.Tcp.TcpListener>.Err(var error):
    }

    stack mut System.Net.Tcp.TcpClient client = new();
    stack mut i8[min max][4] buffer =
    {
        1, 2, 3, 4
    };
    stack System.Net.NetResult<u64[0 2 ** 63 - 1]> readResult = client.Read(buffer);
    switch (readResult)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var count):
            return 10;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
    }

    stack System.Net.NetResult<u64[0 2 ** 63 - 1]> writeResult = client.Write(buffer);
    switch (writeResult)
    {
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var count):
            return 11;
        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var error):
    }

    if (StatusOk(client.Shutdown(System.Net.Tcp.TcpShutdown.Both)))
    {
        return 8;
    }

    if (!StatusOk(client.Close()))
    {
        return 2;
    }

    stack mut System.Net.Tcp.TcpListener listener = new();
    stack System.Net.NetResult<System.Net.Tcp.TcpClient> accepted = listener.Accept();
    switch (accepted)
    {
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Ok(var acceptedClient):
            return 13;
        case System.Net.NetResult<System.Net.Tcp.TcpClient>.Err(var error):
    }

    if (!StatusOk(listener.Close()))
    {
        return 4;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}
