// Ported from SystemRuntimePlatformWindowsStandardLibraryTests.StagedWindowsStdLibBuildRoutesPlatformCallsThroughWindowsModule.
internal fn bool StagedWindowsStdLibBuildRoutesPlatformCallsThroughWindowsModuleImpl()
{
    // PORT-NOTE: the C# original stages a Windows-only stdlib source tree in a temp
    // directory, compiles staged System.stark with EmitLlvmIr against an
    // x86_64-pc-windows-msvc target, and inspects the module graph: System.Runtime.Platform
    // and System.Runtime.Platform.Windows must be loaded while the Linux and MacOS backends
    // are not, and the emitted IR must reference @GetStdHandle/@CreateFileW but no
    // LinuxSyscall. The compile-only host bridge cannot stage a source tree, select a
    // Windows target, or inspect the module graph, so this reduces to compiling a program
    // that imports System.Process (which routes through the platform dispatch module) and
    // asserting it succeeds.
    stack mut ProgramCompile c = CompileProgram("windows-staged-build-routes-through-windows-module", raw"""
import System
import System.Process
module Demo

export unsafe fn i32[min max] main()
{
    switch (System.Process.ArgumentCount())
    {
        case System.Process.ProcessResult<u64[0 2 ** 63 - 1]>.Err(var error):
            return 1;
        case System.Process.ProcessResult<u64[0 2 ** 63 - 1]>.Ok(var count):
            if (count == 0)
            {
                return 2;
            }
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

