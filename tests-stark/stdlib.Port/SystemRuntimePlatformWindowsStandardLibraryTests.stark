// Ported from SystemRuntimePlatformWindowsStandardLibraryTests.StdLibSourceWindowsConsoleAndFileOperationsUseWin32Apis.
internal fn bool StdLibSourceWindowsConsoleAndFileOperationsUseWin32ApisImpl()
{
    // PORT-NOTE: the C# original reads stdlib/src/System/Runtime/Platform/Windows.stark
    // off disk and compiles it with EmitLlvmIr against an x86_64-pc-windows-msvc target,
    // then uses Contains/DoesNotContain to assert the emitted IR declares and calls the
    // Win32 console + file imports (GetStdHandle/CreateFileW/DeleteFileW/MoveFileExW/
    // GetFileAttributesW/GetCurrentDirectoryW/GetConsoleMode/WriteFile/ReadFile), defines
    // the wrappers (WriteStdoutAscii/OpenFileRead/DeleteFile/FileExists), and never
    // references libc fopen/fclose/fread/fwrite or the Linux syscall path. The
    // compile-only host bridge cannot read the platform source off disk and cannot select
    // a Windows target, so this reduces to compiling a program that imports System.Console
    // and System.IO.File (transitively pulling in the host stdlib platform backend) and
    // asserting it succeeds.
    stack mut ProgramCompile c = CompileProgram("windows-console-and-file-uses-win32", raw"""
import System
import System.Console
import System.IO
module Demo

fn bool IsOk(System.IO.IOStatus status)
{
    switch (status)
    {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var error):
            return false;
    }
}

export fn i32[min max] main()
{
    if (!IsOk(System.Console.WriteLine("console and file")))
    {
        return 1;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return true;
}

