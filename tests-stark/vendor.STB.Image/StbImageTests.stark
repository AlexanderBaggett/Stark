import System.Testing
import Vendor.STB.Image
module StbImageTests

fn bool SamePixels(borrow u8[0 max][] left, borrow u8[0 max][] right, u64[0 2 ** 63 - 1] count)
{
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (left[index] != right[index])
        {
            return false;
        }
    }

    return true;
}

fn bool ExpectedPixels(borrow u8[0 max][] pixels)
{
    return pixels.Length == 6
        && pixels[0] == 100
        && pixels[1] == 110
        && pixels[2] == 120
        && pixels[3] == 40
        && pixels[4] == 50
        && pixels[5] == 60;
}

[Fact]
fn bool LoadEmbeddedPpmExposesExpectedMetadataAndPixels()
{
    stack mut u8[0 max][17] encoded =
    {
        80, 54, 10, 50, 32, 49, 10, 50,
        53, 53, 10, 100, 110, 120, 40, 50,
        60
    };
    stack u8[0 max][] encodedBytes = encoded;

    switch (LoadFromMemory(encodedBytes, ImageChannels.Rgb))
    {
        case ImageResult.Err(var error):
            return false;
        case ImageResult.Ok(var image):
            return image.Width() == 2
                && image.Height() == 1
                && image.Channels() == 3
                && image.PixelByteLength() == 6
                && ExpectedPixels(image.Pixels());
    }
}

[Fact]
fn bool ResizeLinearIntoUsesCallerOwnedDestination()
{
    stack mut u8[0 max][17] encoded =
    {
        80, 54, 10, 50, 32, 49, 10, 50,
        53, 53, 10, 100, 110, 120, 40, 50,
        60
    };
    stack u8[0 max][] encodedBytes = encoded;
    stack mut u8[0 max][6] output = { 0 };
    stack mut u8[0 max][] outputBytes = output;

    switch (LoadFromMemory(encodedBytes, ImageChannels.Rgb))
    {
        case ImageResult.Err(var error):
            return false;
        case ImageResult.Ok(var image):
            switch (ResizeLinearInto(image, outputBytes, 2, 1))
            {
                case StbImageStatus.Err(var resizeError):
                    return false;
                case StbImageStatus.Ok:
                    return SamePixels(image.Pixels(), outputBytes, 6);
            }
    }
}

[Fact]
fn bool EmptyInputIsRejectedBeforeNativeDecode()
{
    stack mut u8[0 max][1] storage = { 0 };
    unsafe
    {
        stack u8[0 max][] empty = slice(&storage[0], 0);
        switch (LoadFromMemory(empty, ImageChannels.Rgb))
        {
            case ImageResult.Ok(var image):
                return false;
            case ImageResult.Err(var error):
                return error == StbImageError.InvalidArgument;
        }
    }
}
