import System.C
import System.Testing
import Vendor.SQLite
module SQLiteTests

fn bool TextResultEquals(SQLiteTextResult result, ascii expected)
{
    switch (result)
    {
        case SQLiteTextResult.Err(var error):
            return false;
        case SQLiteTextResult.Ok(var text):
            return text.View() == expected;
    }
}

fn bool TextResultIsNonEmpty(SQLiteTextResult result)
{
    switch (result)
    {
        case SQLiteTextResult.Err(var error):
            return false;
        case SQLiteTextResult.Ok(var text):
            return !text.IsEmpty();
    }
}

fn bool TextResultIsNullValue(SQLiteTextResult result)
{
    switch (result)
    {
        case SQLiteTextResult.Err(var error):
            return error == SQLiteError.NullValue;
        case SQLiteTextResult.Ok(var text):
            return false;
    }
}

fn bool TextResultIsNullHandle(SQLiteTextResult result)
{
    switch (result)
    {
        case SQLiteTextResult.Err(var error):
            return error == SQLiteError.NullHandle;
        case SQLiteTextResult.Ok(var text):
            return false;
    }
}

fn bool TextResultIsTooLarge(SQLiteTextResult result)
{
    switch (result)
    {
        case SQLiteTextResult.Err(var error):
            return error == SQLiteError.TooLarge;
        case SQLiteTextResult.Ok(var text):
            return false;
    }
}

fn bool TextResultIsSQLiteStatus(SQLiteTextResult result, SQLiteStatus status)
{
    switch (result)
    {
        case SQLiteTextResult.Err(var error):
            return error == SQLiteError.SQLite(status);
        case SQLiteTextResult.Ok(var text):
            return false;
    }
}

