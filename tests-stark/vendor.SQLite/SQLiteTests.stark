fn bool ColumnMetadataLooksLikeId(SQLiteColumnMetadataResult result)
{
    switch (result)
    {
        case SQLiteColumnMetadataResult.Err(var error):
            return false;
        case SQLiteColumnMetadataResult.Ok(var metadataValue):
            stack mut SQLiteColumnMetadata metadata = metadataValue;
            return metadata.DataType.View() == "INTEGER"
                && metadata.Collation.View() == "BINARY"
                && !metadata.NotNull
                && metadata.PrimaryKey
                && metadata.AutoIncrement;
    }
}

fn bool BufferEquals(borrow u8[0 max][] left, borrow u8[0 max][] right)
{
    if (left.Length != right.Length)
    {
        return false;
    }

    stack mut u64[0 max] index = 0;
    while willexit (index < left.Length)
    {
        if (left[index] != right[index])
        {
            return false;
        }

        index += 1;
    }

    return true;
}

fn bool QueryIntEquals(mut borrow Database database, ascii sql, i32[min max] expected)
{
    switch (Prepare(database, sql))
    {
        case SQLiteStatementResult.Err(var error):
            return false;
        case SQLiteStatementResult.Ok(var statementValue):
            stack mut Statement statement = statementValue;
            switch (Step(statement))
            {
                case SQLiteStepResult.Row:
                    if (ColumnInt(statement, 0) != expected)
                    {
                        return false;
                    }
                default:
                    return false;
            }

            return Finalize(statement) == SQLiteStatusResult.Ok;
    }
}

fn bool LifecycleShutdownApisTypecheck()
{
    if (false)
    {
        unsafe
        {
            ThreadCleanupDeprecated();
            return GlobalRecoverDeprecated() == SQLiteStatusResult.Ok
                && Shutdown() == SQLiteStatusResult.Ok
                && ShutdownOs() == SQLiteStatusResult.Ok;
        }
    }

    return true;
}

fn bool Win32DirectoryApisUnavailableOrPresent()
{
    if (Win32DirectoryNativeAvailable()
        || Win32DirectoryUtf8Available()
        || Win32DirectoryUtf16Available())
    {
        return true;
    }

    return StatusResultIsSQLiteStatus(ClearWin32DirectoryNative(SQLITE_WIN32_DATA_DIRECTORY_TYPE), SQLiteStatus.NotFound)
        && StatusResultIsSQLiteStatus(ClearWin32DirectoryUtf8(SQLITE_WIN32_TEMP_DIRECTORY_TYPE), SQLiteStatus.NotFound)
        && StatusResultIsSQLiteStatus(ClearWin32DirectoryUtf16(SQLITE_WIN32_DATA_DIRECTORY_TYPE), SQLiteStatus.NotFound)
        && StatusResultIsSQLiteStatus(SetWin32DirectoryUtf8(SQLITE_WIN32_DATA_DIRECTORY_TYPE, "."), SQLiteStatus.NotFound)
        && StatusResultIsSQLiteStatus(SetWin32DirectoryUtf16Ascii(SQLITE_WIN32_TEMP_DIRECTORY_TYPE, "."), SQLiteStatus.NotFound)
        && StatusResultIsSQLiteStatus(SetWin32DirectoryUtf16Unicode(SQLITE_WIN32_TEMP_DIRECTORY_TYPE, (unicode)"."), SQLiteStatus.NotFound);
}

fn bool SQLiteDirectoryGlobalsWork()
{
    unsafe
    {
        stack SQLiteTextResult originalTemp = TempDirectory(512);
        stack SQLiteTextResult originalData = DataDirectory(512);
        if (!TextResultIsNullValue(originalTemp) || !TextResultIsNullValue(originalData))
        {
            return true;
        }

        if (SetTempDirectory(".") != SQLiteStatusResult.Ok
            || !TextResultEquals(TempDirectory(512), ".")
            || ClearTempDirectory() != SQLiteStatusResult.Ok
            || !TextResultIsNullValue(TempDirectory(512)))
        {
            return false;
        }

        if (SetDataDirectory(".") != SQLiteStatusResult.Ok
            || !TextResultEquals(DataDirectory(512), ".")
            || ClearDataDirectory() != SQLiteStatusResult.Ok
            || !TextResultIsNullValue(DataDirectory(512)))
        {
            return false;
        }
    }

    return true;
}

static mut i32[min max] SQLiteAutoExtensionCalls = 0;

[Fact]
fn bool ExtendedResultConstantsMatchSQLiteHeader()
{
    if (SQLITE_ERROR_MISSING_COLLSEQ != 257
        || SQLITE_ERROR_KEY != 1281
        || SQLITE_IOERR_READ != 266
        || SQLITE_IOERR_CODEC != 9226
        || SQLITE_LOCKED_SHAREDCACHE != 262
        || SQLITE_BUSY_TIMEOUT != 773
        || SQLITE_CANTOPEN_SYMLINK != 1550
        || SQLITE_CORRUPT_INDEX != 779
        || SQLITE_READONLY_DIRECTORY != 1544
        || SQLITE_CONSTRAINT_DATATYPE != 3091
        || SQLITE_NOTICE_RBU != 795
        || SQLITE_WARNING_AUTOINDEX != 284
        || SQLITE_AUTH_USER != 279
        || SQLITE_OK_SYMLINK != 512)
    {
        return false;
    }

    return StatusFromCode(SQLITE_IOERR_READ) == SQLiteStatus.IoError
        && StatusFromCode(SQLITE_CONSTRAINT_CHECK) == SQLiteStatus.Constraint
        && StatusFromCode(SQLITE_BUSY_SNAPSHOT) == SQLiteStatus.Busy
        && Code(StatusFromCode(SQLITE_READONLY_CANTLOCK)) == SQLITE_READONLY;
}

[Fact]
fn bool AuthorizerTraceAccessAndLockConstantsMatchSQLiteHeader()
{
    return SQLITE_ACCESS_EXISTS == 0
        && SQLITE_ACCESS_READWRITE == 1
        && SQLITE_ACCESS_READ == 2
        && SQLITE_LOCK_NONE == 0
        && SQLITE_LOCK_EXCLUSIVE == 4
        && SQLITE_DENY == 1
        && SQLITE_IGNORE == 2
        && SQLITE_CREATE_INDEX == 1
        && SQLITE_DELETE == 9
        && SQLITE_READ == 20
        && SQLITE_RECURSIVE == 33
        && SQLITE_ROLLBACK == 1
        && SQLITE_FAIL == 3
        && SQLITE_REPLACE == 5
        && SQLITE_TRACE_STMT == 1
        && SQLITE_TRACE_CLOSE == 8;
}

[Fact]
fn bool ConfigAndDatabaseConfigConstantsMatchSQLiteHeader()
{
    return SQLITE_CONFIG_SINGLETHREAD == 1
        && SQLITE_CONFIG_GETMUTEX == 11
        && SQLITE_CONFIG_LOOKASIDE == 13
        && SQLITE_CONFIG_COVERING_INDEX_SCAN == 20
        && SQLITE_CONFIG_ROWID_IN_VIEW == 30
        && SQLITE_DBCONFIG_MAINDBNAME == 1000
        && SQLITE_DBCONFIG_ENABLE_FKEY == 1002
        && SQLITE_DBCONFIG_DEFENSIVE == 1010
        && SQLITE_DBCONFIG_ENABLE_ATTACH_CREATE == 1020
        && SQLITE_DBCONFIG_FP_DIGITS == 1023
        && SQLITE_DBCONFIG_MAX == 1023;
}

[Fact]
fn bool LowLevelMethodCarriersHaveExpectedSQLiteLayout()
{
    stack u64[0 max] pointerSize = comptime sizeof(rawmutptr<System.C.c_void>);
    stack u64[0 max] routineSize = comptime sizeof(SQLiteExtensionApiRoutine);
    stack mut u64[0 max] vfsPointerOffset = 12;
    if (pointerSize == 8)
    {
        vfsPointerOffset = 16;
    }

    return comptime System.Compiler.StructLayoutIsC<SQLiteMemoryMethods>()
        && comptime System.Compiler.StructLayoutIsC<SQLiteMutexMethods>()
        && comptime System.Compiler.StructLayoutIsC<SQLiteIoMethods>()
        && comptime System.Compiler.StructLayoutIsC<SQLite3VfsNative>()
        && comptime System.Compiler.StructLayoutIsC<SQLitePcachePage>()
        && comptime System.Compiler.StructLayoutIsC<SQLitePcacheMethods2>()
        && comptime System.Compiler.StructLayoutIsC<SQLite3ApiRoutinesNative>()
        && comptime System.Compiler.FieldCount<SQLite3ApiRoutinesNative>() == 277
        && comptime System.Compiler.FieldName<SQLite3ApiRoutinesNative, 0>() == "AggregateContext"
        && comptime System.Compiler.FieldName<SQLite3ApiRoutinesNative, 276>() == "CArrayBindV2"
        && comptime System.Compiler.FieldOffset<SQLiteMemoryMethods, 7>() == pointerSize * 7
        && comptime System.Compiler.FieldOffset<SQLiteMutexMethods, 8>() == pointerSize * 8
        && comptime System.Compiler.FieldOffset<SQLiteIoMethods, 1>() == pointerSize
        && comptime System.Compiler.FieldOffset<SQLiteIoMethods, 18>() == pointerSize * 18
        && comptime System.Compiler.FieldOffset<SQLite3VfsNative, 3>() == vfsPointerOffset
        && comptime System.Compiler.FieldOffset<SQLite3VfsNative, 21>() == vfsPointerOffset + pointerSize * 18
        && comptime System.Compiler.FieldOffset<SQLitePcachePage, 1>() == pointerSize
        && comptime System.Compiler.FieldOffset<SQLitePcacheMethods2, 1>() == pointerSize
        && comptime System.Compiler.FieldOffset<SQLite3ApiRoutinesNative, 276>() == routineSize * 276
        && sizeof(SQLiteMemoryMethods) == pointerSize * 8
        && sizeof(SQLiteMutexMethods) == pointerSize * 9
        && sizeof(SQLiteIoMethods) == pointerSize * 19
        && sizeof(SQLite3VfsNative) == vfsPointerOffset + pointerSize * 19
        && sizeof(SQLitePcachePage) == pointerSize * 2
        && sizeof(SQLitePcacheMethods2) == pointerSize * 13
        && sizeof(SQLite3ApiRoutinesNative) == routineSize * 277;
}

[Fact]
fn bool SQLiteLoadableExtensionEntrypointHasExpectedAbiShape()
{
    return comptime System.Compiler.FunctionPointerIsUnsafe<SQLiteLoadExtensionEntry>()
        && comptime System.Compiler.FunctionPointerHasFfiAbi<SQLiteLoadExtensionEntry>()
        && comptime System.Compiler.FunctionPointerAbiIsC<SQLiteLoadExtensionEntry>()
        && comptime System.Compiler.FunctionPointerReturnTypeIs<SQLiteLoadExtensionEntry, System.C.c_int>()
        && comptime System.Compiler.FunctionPointerParameterCount<SQLiteLoadExtensionEntry>() == 3
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteLoadExtensionEntry, SQLiteExtensionDatabase, 0>()
        && comptime System.Compiler.FunctionPointerParameterTypeIsRawPointer<SQLiteLoadExtensionEntry, 1>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteLoadExtensionEntry, SQLiteExtensionApi, 2>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteAutoExtensionCallback, SQLiteExtensionApi, 2>();
}

[Fact]
fn bool PublicOwnerViewAndResultTypesHaveExpectedShape()
{
    return comptime System.Compiler.FieldCount<Database>() == 5
        && comptime System.Compiler.FieldTypeIsRawPointer<Database, 0>()
        && comptime System.Compiler.FieldTypeIsNamed<Database, 1>()
        && comptime System.Compiler.FieldTypeIsDynamic<Database, 2>()
        && comptime System.Compiler.FieldCount<Statement>() == 1
        && comptime System.Compiler.FieldTypeIsRawPointer<Statement, 0>()
        && comptime System.Compiler.FieldCount<Blob>() == 1
        && comptime System.Compiler.FieldTypeIsRawPointer<Blob, 0>()
        && comptime System.Compiler.FieldCount<Backup>() == 1
        && comptime System.Compiler.FieldTypeIsRawPointer<Backup, 0>()
        && comptime System.Compiler.FieldCount<SQLiteOwnedBytes>() == 2
        && comptime System.Compiler.FieldTypeIsRawPointer<SQLiteOwnedBytes, 0>()
        && comptime System.Compiler.FieldTypeIsInteger<SQLiteOwnedBytes, 1>()
        && comptime System.Compiler.FieldCount<SQLiteByteView>() == 2
        && comptime System.Compiler.FieldTypeIsRawPointer<SQLiteByteView, 0>()
        && comptime System.Compiler.FieldTypeIsInteger<SQLiteByteView, 1>()
        && comptime System.Compiler.FieldCount<SQLitePointerType>() == 1
        && comptime System.Compiler.FieldTypeIsNamed<SQLitePointerType, 0>()
        && comptime System.Compiler.FieldCount<SQLiteClientDataKey>() == 1
        && comptime System.Compiler.FieldTypeIsNamed<SQLiteClientDataKey, 0>()
        && comptime System.Compiler.EnumVariantCount<SQLiteStatusResult>() == 2
        && comptime System.Compiler.EnumVariantIsOk<SQLiteStatusResult, 0>()
        && comptime System.Compiler.EnumVariantIsErr<SQLiteStatusResult, 1>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteStatusResult, SQLiteError, 1, 0>()
        && comptime System.Compiler.EnumVariantCount<SQLiteDatabaseResult>() == 2
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteDatabaseResult, Database, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteDatabaseResult, SQLiteError, 1, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteStatementResult, Statement, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteBlobResult, Blob, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteBackupResult, Backup, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteBytesResult, SQLiteOwnedBytes, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteByteViewResult, SQLiteByteView, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteTextResult, System.Text.OwnedAscii, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteUtf16Result, System.Text.OwnedUtf16, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteBoolResult, bool, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteIntResult, i32[min max], 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteI64Result, i64[min max], 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteDoubleResult, f64, 0, 0>()
        && comptime System.Compiler.EnumVariantPayloadTypeIs<SQLiteWalCheckpointResult, SQLiteWalCheckpointSnapshot, 0, 0>();
}

[Fact]
fn bool PublicCallbackAliasesHaveExpectedAbiShape()
{
    return comptime System.Compiler.FunctionPointerIsUnsafe<SQLiteScalarCallback>()
        && comptime System.Compiler.FunctionPointerHasFfiAbi<SQLiteScalarCallback>()
        && comptime System.Compiler.FunctionPointerAbiIsC<SQLiteScalarCallback>()
        && comptime System.Compiler.FunctionPointerParameterCount<SQLiteScalarCallback>() == 3
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteScalarCallback, SQLiteFunctionContext, 0>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteScalarCallback, i32[min max], 1>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteScalarCallback, SQLiteFunctionArguments, 2>()
        && comptime System.Compiler.FunctionPointerParameterCount<SQLiteCollationCompareCallback>() == 5
        && comptime System.Compiler.FunctionPointerReturnTypeIs<SQLiteCollationCompareCallback, System.C.c_int>()
        && comptime System.Compiler.FunctionPointerParameterTypeIsRawPointer<SQLiteCollationCompareCallback, 0>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteCollationCompareCallback, System.C.c_int, 1>()
        && comptime System.Compiler.FunctionPointerParameterTypeIsRawPointer<SQLiteCollationCompareCallback, 2>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteCollationCompareCallback, System.C.c_int, 3>()
        && comptime System.Compiler.FunctionPointerParameterTypeIsRawPointer<SQLiteCollationCompareCallback, 4>()
        && comptime System.Compiler.FunctionPointerParameterCount<SQLiteBusyCallback>() == 2
        && comptime System.Compiler.FunctionPointerReturnTypeIs<SQLiteBusyCallback, System.C.c_int>()
        && comptime System.Compiler.FunctionPointerParameterTypeIsRawPointer<SQLiteBusyCallback, 0>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteBusyCallback, System.C.c_int, 1>()
        && comptime System.Compiler.FunctionPointerParameterCount<SQLiteTraceV2Callback>() == 4
        && comptime System.Compiler.FunctionPointerReturnTypeIs<SQLiteTraceV2Callback, System.C.c_int>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteTraceV2Callback, System.C.c_uint, 0>()
        && comptime System.Compiler.FunctionPointerParameterTypeIsRawPointer<SQLiteTraceV2Callback, 1>()
        && comptime System.Compiler.FunctionPointerParameterTypeIsRawPointer<SQLiteTraceV2Callback, 2>()
        && comptime System.Compiler.FunctionPointerParameterTypeIsRawPointer<SQLiteTraceV2Callback, 3>()
        && comptime System.Compiler.FunctionPointerParameterCount<SQLiteSqlLogCallback>() == 4
        && comptime System.Compiler.FunctionPointerParameterTypeIsRawPointer<SQLiteSqlLogCallback, 0>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteSqlLogCallback, SQLiteDatabaseCallback, 1>()
        && comptime System.Compiler.FunctionPointerParameterTypeIs<SQLiteSqlLogCallback, rawptr<System.C.c_char>, 2>()
