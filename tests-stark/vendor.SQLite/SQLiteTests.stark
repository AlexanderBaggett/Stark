[Fact]
fn bool SQLiteVirtualTableApisWork()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            if (UnregisterVirtualTableModule(database, "stark_missing_vtab_module") != SQLiteStatusResult.Ok
                || DropAllVirtualTableModules(database) != SQLiteStatusResult.Ok)
            {
                return false;
            }

            unsafe
            {
                if (!VirtualTableModuleResultIsNullValue(VirtualTableModuleFromRaw(null))
                    || !StatusResultIsNullHandle(DeclareVirtualTableForCallback(null, "CREATE TABLE x(value);"))
                    || !StatusResultIsNullHandle(ConfigureVirtualTableConstraintSupport(null, true))
                    || !StatusResultIsNullHandle(ConfigureVirtualTableDirectOnly(null))
                    || !StatusResultIsNullHandle(ConfigureVirtualTableInnocuous(null))
                    || !StatusResultIsNullHandle(ConfigureVirtualTableUsesAllSchemas(null))
                    || !BoolResultIsNullValue(VirtualTableNoChange(null))
                    || !TextResultIsNullValue(VirtualTableConstraintCollation(null, 0, 64))
                    || !BoolResultIsNullValue(VirtualTableInCanProcessAllAtOnce(null, 0))
                    || !BoolResultIsNullValue(SetVirtualTableInAllAtOnce(null, 0, true))
                    || !ValueResultIsNullValue(VirtualTableRightHandSideValue(null, 0))
                    || !ValueStepResultIsNullValue(VirtualTableInFirst(null))
                    || !ValueStepResultIsNullValue(VirtualTableInNext(null)))
                {
                    return false;
                }

                switch (VirtualTableDistinctMode(null))
                {
                    case SQLiteIntResult.Err(var error):
                        if (error != SQLiteError.NullValue)
                        {
                            return false;
                        }
                    case SQLiteIntResult.Ok(var value):
                        return false;
                }

                switch (VirtualTableConflictPolicy(null))
                {
                    case SQLiteIntResult.Err(var error):
                        if (error != SQLiteError.NullHandle)
                        {
                            return false;
                        }
                    case SQLiteIntResult.Ok(var value):
                        return false;
                }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool SQLiteFormattedAndCompatibilityApisWork()
{
    if (!TextResultEquals(FormatSqlTextLiteral("O'Malley", 64), "'O''Malley'")
        || !TextResultEquals(FormatSqlTextLiteralFixed("O'Malley", 64), "'O''Malley'")
        || !TextResultIsTooLarge(FormatSqlTextLiteralFixed("abcdef", 4)))
    {
        return false;
    }

    unsafe
    {
        stack mut SQLiteHookCounters counters = new();
        if (SetConfigLog<SQLiteHookCounters>(counters, SQLiteLogHook) != SQLiteStatusResult.Ok)
        {
            return false;
        }

        if (LogMessage(SQLiteStatus.Warning, "stark sqlite log") != SQLiteStatusResult.Ok)
        {
            ClearConfigLog();
            return false;
        }

        if (ClearConfigLog() != SQLiteStatusResult.Ok)
        {
            return false;
        }

        if (counters.Log != 1 || counters.LogCode != SQLITE_WARNING)
        {
            return false;
        }

        if (ClearMemoryAlarmDeprecated() != SQLiteStatusResult.Ok)
        {
            return false;
        }

        if (TestControlByteOrder() == 0 || TestControlIsInitialized() < 0)
        {
            return false;
        }

        if (!IntResultAtLeast(PageCacheHeaderSize(), 0))
        {
            return false;
        }

        if (false)
        {
            return ConfigureSingleThreadMode() == SQLiteStatusResult.Ok
                && ConfigureMultiThreadMode() == SQLiteStatusResult.Ok
                && ConfigureSerializedMode() == SQLiteStatusResult.Ok;
        }
    }

    return true;
}

[Fact]
fn bool SQLiteStringBuilderApisWork()
{
    switch (CreateStringBuilder())
    {
        case SQLiteStringBuilderResult.Err(var error):
            return false;
        case SQLiteStringBuilderResult.Ok(var builderValue):
            stack mut SQLiteStringBuilder builder = builderValue;
            if (!builder.IsOpen())
            {
                return false;
            }

            if (StringBuilderAppend(builder, "alpha") != SQLiteStatusResult.Ok
                || StringBuilderAppendRepeatedAsciiByte(builder, 3, 33) != SQLiteStatusResult.Ok
                || !IntResultEquals(StringBuilderByteLength(builder), 8)
                || !TextResultEquals(StringBuilderValue(builder, 64), "alpha!!!"))
            {
                return false;
            }

            if (StringBuilderTruncate(builder, 5) != SQLiteStatusResult.Ok
                || !TextResultEquals(StringBuilderValue(builder, 64), "alpha")
                || StringBuilderReset(builder) != SQLiteStatusResult.Ok
                || !IntResultEquals(StringBuilderByteLength(builder), 0))
            {
                return false;
            }

            if (StringBuilderAppendSqlTextLiteral(builder, "O'Malley") != SQLiteStatusResult.Ok
                || !TextResultEquals(StringBuilderValue(builder, 64), "'O''Malley'")
                || StringBuilderReset(builder) != SQLiteStatusResult.Ok)
            {
                return false;
            }

            if (StringBuilderAppendPrefix(builder, "abcdef", 3) != SQLiteStatusResult.Ok
                || StringBuilderAppendPrefix(builder, "abcdef", 7) == SQLiteStatusResult.Ok
                || !TextResultEquals(StringBuilderValue(builder, 64), "abc")
                || !TextResultIsTooLarge(FinishStringBuilder(builder, 2)))
            {
                return false;
            }

            if (!builder.IsOpen())
            {
                return false;
            }

            if (!TextResultEquals(FinishStringBuilder(builder, 64), "abc")
                || builder.IsOpen()
                || StringBuilderStatus(builder) == SQLiteStatusResult.Ok)
            {
                return false;
            }
    }

    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            switch (CreateStringBuilderForDatabase(database))
            {
                case SQLiteStringBuilderResult.Err(var builderError):
                    return false;
                case SQLiteStringBuilderResult.Ok(var databaseBuilderValue):
                    stack mut SQLiteStringBuilder databaseBuilder = databaseBuilderValue;
                    if (StringBuilderAppend(databaseBuilder, "db") != SQLiteStatusResult.Ok
                        || !TextResultEquals(FinishStringBuilder(databaseBuilder, 64), "db"))
                    {
                        return false;
                    }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool SQLiteAllocatorOwnedBytesWork()
{
    switch (AllocateBytes(4))
    {
        case SQLiteBytesResult.Err(var error):
            return false;
        case SQLiteBytesResult.Ok(var bufferValue):
            stack mut SQLiteOwnedBytes buffer = bufferValue;
            if (buffer.Length() != 4 || AllocatedByteSize(buffer) < 4)
            {
                return false;
            }

            if (ResizeBytes(buffer, 8) != SQLiteStatusResult.Ok
                || buffer.Length() != 8
                || AllocatedByteSize(buffer) < 8)
            {
                return false;
            }

            if (ResizeBytes64(buffer, 2) != SQLiteStatusResult.Ok
                || buffer.Length() != 2
                || AllocatedByteSize(buffer) < 2)
            {
                return false;
            }

            if (ResizeBytes(buffer, 0) != SQLiteStatusResult.Ok
                || !buffer.IsEmpty()
                || AllocatedByteSize(buffer) != 0)
            {
                return false;
            }
    }

    switch (AllocateBytes64(3))
    {
        case SQLiteBytesResult.Err(var error):
            return false;
        case SQLiteBytesResult.Ok(var wideValue):
            stack mut SQLiteOwnedBytes wide = wideValue;
            if (wide.Length() != 3 || AllocatedByteSize(wide) < 3)
            {
                return false;
            }

            wide.Close();
    }

    switch (AllocateBytes(0))
    {
        case SQLiteBytesResult.Err(var error):
            return false;
        case SQLiteBytesResult.Ok(var emptyValue):
            stack mut SQLiteOwnedBytes empty = emptyValue;
            if (!empty.IsEmpty() || AllocatedByteSize(empty) != 0)
            {
                return false;
            }

            if (ResizeBytes(empty, 5) != SQLiteStatusResult.Ok
                || empty.Length() != 5
                || AllocatedByteSize(empty) < 5)
            {
                return false;
            }

            empty.Close();
    }

    return true;
}

[Fact]
fn bool DatabaseIntrospectionAndCountersWork()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            if (SetErrorMessage(database, SQLiteStatus.Constraint, "stark wrapper error") != SQLiteStatusResult.Ok
                || LastErrorCode(database) != SQLiteStatus.Constraint
                || LastExtendedErrorCode(database) != SQLITE_CONSTRAINT
                || !TextResultEquals(ErrorMessage(database, 128), "stark wrapper error")
                || SetDefaultErrorMessage(database, SQLiteStatus.Ok) != SQLiteStatusResult.Ok
                || SetExtendedResultCodes(database, true) != SQLiteStatusResult.Ok
                || SetBusyTimeout(database, 1) != SQLiteStatusResult.Ok
                || LastErrorCode(database) != SQLiteStatus.Ok
                || LastExtendedErrorCode(database) != SQLITE_OK
                || ErrorOffset(database) != -1
                || !Utf16ResultLengthEquals(ErrorMessage16(database, 128), 12)
                || !IsAutocommit(database)
                || !TextResultEquals(DatabaseName(database, 0, 32), "main")
                || !IntResultEquals(DatabaseReadonly(database, "main"), 0)
                || !IntResultEquals(TransactionState(database, "main"), SQLITE_TXN_NONE)
                || !IntResultAtLeast(CurrentLimit(database, SQLITE_LIMIT_VARIABLE_NUMBER), 1)
                || !SnapshotCurrentAtLeast(GlobalStatus(SQLITE_STATUS_MEMORY_USED, false), 0))
            {
                return false;
            }

            if (Execute(database, "CREATE TABLE counters(id INTEGER PRIMARY KEY);") != SQLiteStatusResult.Ok)
            {
                return false;
            }

            if (!SnapshotCurrentAtLeast(DatabaseStatus(database, SQLITE_DBSTATUS_SCHEMA_USED, false), 0))
            {
                return false;
            }

            if (!SnapshotCurrentAtLeast(DatabaseStatus32(database, SQLITE_DBSTATUS_SCHEMA_USED, false), 0))
            {
                return false;
            }

            if (Execute(database, "INSERT INTO counters(id) VALUES(11);") != SQLiteStatusResult.Ok)
            {
                return false;
            }

            if (Changes32(database) != 1
                || Changes(database) != 1
                || TotalChanges32(database) < 1
                || TotalChanges(database) < 1
                || LastInsertRowId(database) != 11)
            {
                return false;
            }

            if (SetLastInsertRowId(database, 77) != SQLiteStatusResult.Ok || LastInsertRowId(database) != 77)
            {
                return false;
            }

            switch (Prepare(database, "SELECT id FROM counters;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    if (!HasOpenStatements(database) || !IntResultAtLeast(OpenStatementCount(database), 1))
                    {
                        return false;
                    }

                    if (Finalize(statement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            Interrupt(database);
            return CacheFlush(database) == SQLiteStatusResult.Ok
                && ReleaseMemory(database) == SQLiteStatusResult.Ok
                && Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool BackupSerializeDeserializeAndWalWork()
{
    if (SQLITE_CHECKPOINT_NOOP != -1
        || SQLITE_CHECKPOINT_PASSIVE != 0
        || SQLITE_CHECKPOINT_FULL != 1
        || SQLITE_CHECKPOINT_RESTART != 2
        || SQLITE_CHECKPOINT_TRUNCATE != 3
        || SQLITE_SERIALIZE_NOCOPY != 1
        || SQLITE_DESERIALIZE_FREEONCLOSE != 1
        || SQLITE_DESERIALIZE_RESIZEABLE != 2
        || SQLITE_DESERIALIZE_READONLY != 4)
    {
        return false;
    }

    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var sourceValue):
            stack mut Database source = sourceValue;
            if (Execute(source, "CREATE TABLE saved(id INTEGER PRIMARY KEY, value INTEGER NOT NULL);") != SQLiteStatusResult.Ok
                || Execute(source, "INSERT INTO saved(id, value) VALUES(1, 77);") != SQLiteStatusResult.Ok)
            {
                return false;
            }

            switch (OpenInMemory())
            {
                case SQLiteDatabaseResult.Err(var error):
                    return false;
                case SQLiteDatabaseResult.Ok(var destinationValue):
                    stack mut Database destination = destinationValue;
                    switch (OpenBackup(destination, "main", source, "main"))
                    {
                        case SQLiteBackupResult.Err(var error):
                            return false;
                        case SQLiteBackupResult.Ok(var backupValue):
                            stack mut Backup backup = backupValue;
                            if (!BackupStepDone(StepBackup(backup, -1))
                                || !IntResultAtLeast(BackupPageCount(backup), 0)
                                || !IntResultAtLeast(BackupRemaining(backup), 0)
                                || FinishBackup(backup) != SQLiteStatusResult.Ok)
                            {
                                return false;
                            }
                    }

                    if (!QueryIntEquals(destination, "SELECT value FROM saved WHERE id = 1;", 77))
                    {
                        return false;
                    }

                    if (WalAutoCheckpoint(destination, 64) != SQLiteStatusResult.Ok
                        || WalCheckpoint(destination, "main") != SQLiteStatusResult.Ok
                        || !WalCheckpointSucceeded(WalCheckpointWithMode(destination, "main", SQLITE_CHECKPOINT_NOOP)))
                    {
                        return false;
                    }

                    switch (SerializeDatabase(destination, "main"))
                    {
                        case SQLiteBytesResult.Err(var error):
                            return false;
                        case SQLiteBytesResult.Ok(var serializedValue):
                            stack mut SQLiteOwnedBytes serialized = serializedValue;
                            if (serialized.Length() == 0)
                            {
                                return false;
                            }

                            switch (OpenInMemory())
                            {
                                case SQLiteDatabaseResult.Err(var error):
                                    return false;
                                case SQLiteDatabaseResult.Ok(var restoredValue):
                                    stack mut Database restored = restoredValue;
                                    if (DeserializeDatabaseFromSerialized(restored, "main", serialized) != SQLiteStatusResult.Ok)
                                    {
                                        return false;
                                    }

                                    if (!QueryIntEquals(restored, "SELECT value FROM saved WHERE id = 1;", 77))
                                    {
                                        return false;
                                    }

                                    if (Close(restored) != SQLiteStatusResult.Ok)
                                    {
                                        return false;
                                    }
                            }

                            serialized.Close();
                    }

                    return Close(destination) == SQLiteStatusResult.Ok
                        && Close(source) == SQLiteStatusResult.Ok;
            }
    }
}

[Fact]
fn bool SQLiteSnapshotApisWork()
{
    stack mut SQLiteSnapshot emptyLeft = new();
    stack mut SQLiteSnapshot emptyRight = new();
    if (!IntResultIsNullHandle(CompareSnapshots(emptyLeft, emptyRight)))
    {
        return false;
    }

    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            if (OpenSnapshot(database, "main", emptyLeft) != SQLiteStatusResult.Err(SQLiteError.NullHandle))
            {
                return false;
            }

            if (!SnapshotAvailable())
            {
                if (!SnapshotResultIsSQLiteStatus(GetSnapshot(database, "main"), SQLiteStatus.NotFound)
                    || !StatusResultIsSQLiteStatus(RecoverSnapshots(database, "main"), SQLiteStatus.NotFound))
                {
                    return false;
                }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool SQLiteCArrayBindApisWork()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            stack i32[min max][3] intValuesStorage = { 1, 2, 3 };
            stack i64[min max][3] longValuesStorage = { 10, 20, 30 };
            stack f64[3] doubleValuesStorage = { 1.5, 2.5, 3.0 };
            stack ascii[4] textValuesStorage = { "alpha", "beta", "alpha", "delta" };
            stack u8[0 max][2] firstBlobStorage = { 1, 2 };
            stack u8[0 max][3] secondBlobStorage = { 3, 4, 5 };
            stack i32[min max][] intValues = intValuesStorage;
            stack i64[min max][] longValues = longValuesStorage;
            stack f64[] doubleValues = doubleValuesStorage;
            stack ascii[] textValues = textValuesStorage;
            stack u8[0 max][] firstBlob = firstBlobStorage;
            stack u8[0 max][] secondBlob = secondBlobStorage;
            stack SQLiteCArrayBlob[3] blobValuesStorage =
            {
                new SQLiteCArrayBlob() { Bytes = firstBlob },
                new SQLiteCArrayBlob(),
                new SQLiteCArrayBlob() { Bytes = secondBlob }
            };
            stack SQLiteCArrayBlob[] blobValues = blobValuesStorage;

            if (!CArrayBindAvailable())
            {
                switch (Prepare(database, "SELECT ?;"))
                {
                    case SQLiteStatementResult.Err(var error):
                        return false;
                    case SQLiteStatementResult.Ok(var statementValue):
                        stack mut Statement statement = statementValue;
                        if (!StatusResultIsSQLiteStatus(BindCArrayInt32(statement, 1, intValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayInt64(statement, 1, longValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayDouble(statement, 1, doubleValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayText(statement, 1, textValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayBlob(statement, 1, blobValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayInt32V2(statement, 1, intValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayInt64V2(statement, 1, longValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayDoubleV2(statement, 1, doubleValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayTextV2(statement, 1, textValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayBlobV2(statement, 1, blobValues), SQLiteStatus.NotFound))
                        {
                            return false;
                        }

                        return Finalize(statement) == SQLiteStatusResult.Ok
                            && Close(database) == SQLiteStatusResult.Ok;
                }
            }

            switch (Prepare(database, "SELECT sum(value) FROM carray(?);"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var intStatementValue):
                    stack mut Statement intStatement = intStatementValue;
                    if (BindCArrayInt32(intStatement, 1, intValues) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    switch (Step(intStatement))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt(intStatement, 0) != 6)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(intStatement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (Prepare(database, "SELECT sum(value) FROM carray(?);"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var longStatementValue):
                    stack mut Statement longStatement = longStatementValue;
                    if (BindCArrayInt64(longStatement, 1, longValues) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    switch (Step(longStatement))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt64(longStatement, 0) != 60)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(longStatement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (Prepare(database, "SELECT sum(value) FROM carray(?);"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var doubleStatementValue):
                    stack mut Statement doubleStatement = doubleStatementValue;
                    if (BindCArrayDouble(doubleStatement, 1, doubleValues) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    switch (Step(doubleStatement))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnDouble(doubleStatement, 0) != 7.0)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(doubleStatement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (Prepare(database, "SELECT count(*) FROM carray(?) WHERE value='alpha';"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var textStatementValue):
                    stack mut Statement textStatement = textStatementValue;
                    if (BindCArrayText(textStatement, 1, textValues) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    switch (Step(textStatement))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt(textStatement, 0) != 2)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(textStatement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (Prepare(database, "SELECT sum(length(value)) FROM carray(?);"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var blobStatementValue):
                    stack mut Statement blobStatement = blobStatementValue;
                    if (BindCArrayBlob(blobStatement, 1, blobValues) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    switch (Step(blobStatement))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt(blobStatement, 0) != 5)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(blobStatement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            if (CArrayBindV2Available())
            {
                switch (Prepare(database, "SELECT sum(value) FROM carray(?);"))
                {
                    case SQLiteStatementResult.Err(var error):
                        return false;
                    case SQLiteStatementResult.Ok(var v2StatementValue):
                        stack mut Statement v2Statement = v2StatementValue;
                        if (BindCArrayInt32V2(v2Statement, 1, intValues) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }

                        switch (Step(v2Statement))
                        {
                            case SQLiteStepResult.Row:
                                if (ColumnInt(v2Statement, 0) != 6)
                                {
                                    return false;
                                }
                            default:
                                return false;
                        }

                        if (Finalize(v2Statement) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }
                }

                switch (Prepare(database, "SELECT sum(length(value)) FROM carray(?);"))
                {
                    case SQLiteStatementResult.Err(var error):
                        return false;
                    case SQLiteStatementResult.Ok(var v2BlobStatementValue):
                        stack mut Statement v2BlobStatement = v2BlobStatementValue;
                        if (BindCArrayBlobV2(v2BlobStatement, 1, blobValues) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }

                        switch (Step(v2BlobStatement))
                        {
                            case SQLiteStepResult.Row:
                                if (ColumnInt(v2BlobStatement, 0) != 5)
                                {
                                    return false;
                                }
                            default:
                                return false;
                        }

                        if (Finalize(v2BlobStatement) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }
                }

                switch (Prepare(database, "SELECT count(*) FROM carray(?) WHERE value='delta';"))
                {
                    case SQLiteStatementResult.Err(var error):
                        return false;
                    case SQLiteStatementResult.Ok(var v2TextStatementValue):
                        stack mut Statement v2TextStatement = v2TextStatementValue;
                        if (BindCArrayTextV2(v2TextStatement, 1, textValues) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }

                        switch (Step(v2TextStatement))
                        {
                            case SQLiteStepResult.Row:
                                if (ColumnInt(v2TextStatement, 0) != 1)
                                {
                                    return false;
                                }
                            default:
                                return false;
                        }

                        if (Finalize(v2TextStatement) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }
                }
            }
            else
            {
                switch (Prepare(database, "SELECT ?;"))
                {
                    case SQLiteStatementResult.Err(var error):
                        return false;
                    case SQLiteStatementResult.Ok(var v2UnavailableStatementValue):
                        stack mut Statement v2UnavailableStatement = v2UnavailableStatementValue;
                        if (!StatusResultIsSQLiteStatus(BindCArrayInt32V2(v2UnavailableStatement, 1, intValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayTextV2(v2UnavailableStatement, 1, textValues), SQLiteStatus.NotFound)
                            || !StatusResultIsSQLiteStatus(BindCArrayBlobV2(v2UnavailableStatement, 1, blobValues), SQLiteStatus.NotFound))
                        {
                            return false;
                        }

                        if (Finalize(v2UnavailableStatement) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }
                }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool BlobBindingAndIncrementalIoWork()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            if (Execute(database, "CREATE TABLE blobs(id INTEGER PRIMARY KEY, data BLOB NOT NULL);") != SQLiteStatusResult.Ok)
            {
                return false;
            }

            switch (Prepare(database, "INSERT INTO blobs(id, data) VALUES(:id, :data);"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var insertValue):
                    stack mut Statement insert = insertValue;
                    stack mut u8[0 max][4] payload = { 1, 2, 3, 4 };
                    stack u8[0 max][] payloadBytes = payload;
                    if (BindInt(insert, 1, 1) != SQLiteStatusResult.Ok
                        || BindBytes(insert, 2, payloadBytes) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    switch (Step(insert))
                    {
                        case SQLiteStepResult.Done:
                            break;
                        default:
                            return false;
                    }

                    if (Reset(insert) != SQLiteStatusResult.Ok || ClearBindings(insert) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    if (BindInt(insert, 1, 2) != SQLiteStatusResult.Ok
                        || BindZeroBlob(insert, 2, 4) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    switch (Step(insert))
                    {
                        case SQLiteStepResult.Done:
                            break;
                        default:
                            return false;
                    }

                    if (Finalize(insert) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (Prepare(database, "SELECT data FROM blobs WHERE id = :id;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var queryValue):
                    stack mut Statement query = queryValue;
                    if (BindInt(query, 1, 1) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    switch (Step(query))
                    {
                        case SQLiteStepResult.Row:
                            stack mut u8[0 max][4] copied = { 0, 0, 0, 0 };
                            stack mut u8[0 max][] copiedBytes = copied;
                            stack mut u8[0 max][4] viewCopy = { 0, 0, 0, 0 };
                            stack mut u8[0 max][] viewCopyBytes = viewCopy;
                            stack mut u8[0 max][4] ownedCopy = { 0, 0, 0, 0 };
                            stack mut u8[0 max][] ownedCopyBytes = ownedCopy;
                            stack u8[0 max][4] expected = { 1, 2, 3, 4 };
                            stack u8[0 max][] expectedBytes = expected;
                            if (ColumnType(query, 0) != SQLiteColumnType.Blob
                                || !IntResultEquals(ColumnBlobLength(query, 0), 4)
                                || !IntResultEquals(ColumnBlobCopy(query, 0, copiedBytes), 4)
                                || !BufferEquals(copiedBytes, expectedBytes))
                            {
                                return false;
                            }

                            unsafe
                            {
                                switch (ColumnBlobView(query, 0))
                                {
                                    case SQLiteByteViewResult.Err(var error):
                                        return false;
                                    case SQLiteByteViewResult.Ok(var view):
                                        if (view.Length() != 4
                                            || !ByteViewResultEquals(SQLiteByteViewResult.Ok(view), expectedBytes)
                                            || view.CopyTo(viewCopyBytes) != SQLiteStatusResult.Ok
                                            || !BufferEquals(viewCopyBytes, expectedBytes))
                                        {
                                            return false;
                                    }
                                }
                            }

                            switch (ColumnBlobBytes(query, 0))
                            {
                                case SQLiteBytesResult.Err(var error):
                                    return false;
                                case SQLiteBytesResult.Ok(var blobBytesValue):
                                    stack mut SQLiteOwnedBytes blobBytes = blobBytesValue;
                                    if (blobBytes.Length() != 4
                                        || blobBytes.CopyTo(ownedCopyBytes) != SQLiteStatusResult.Ok
                                        || !BufferEquals(ownedCopyBytes, expectedBytes))
                                    {
                                        return false;
                                    }
                            }
                        default:
                            return false;
                    }

                    if (Finalize(query) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (OpenBlobReadWrite(database, "main", "blobs", "data", 2))
            {
                case SQLiteBlobResult.Err(var error):
                    return false;
                case SQLiteBlobResult.Ok(var blobValue):
                    stack mut Blob blob = blobValue;
                    stack mut u8[0 max][4] initial = { 0, 0, 0, 0 };
                    stack mut u8[0 max][] initialBytes = initial;
                    stack u8[0 max][4] empty = { 0, 0, 0, 0 };
                    stack u8[0 max][] emptyBytes = empty;
                    stack u8[0 max][2] patch = { 9, 8 };
                    stack u8[0 max][] patchBytes = patch;
                    stack u8[0 max][4] patched = { 0, 9, 8, 0 };
                    stack u8[0 max][] patchedBytes = patched;
                    if (!IntResultEquals(BlobByteLength(blob), 4)
                        || !IntResultEquals(ReadBlob(blob, initialBytes, 0), 4)
                        || !BufferEquals(initialBytes, emptyBytes))
                    {
                        return false;
                    }

                    if (!IntResultEquals(WriteBlob(blob, patchBytes, 1), 2)
                        || ReopenBlob(blob, 2) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    if (!IntResultEquals(ReadBlob(blob, initialBytes, 0), 4)
                        || !BufferEquals(initialBytes, patchedBytes))
                    {
                        return false;
                    }

                    if (CloseBlob(blob) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool PrepareMetadataReportsNamesAndSql()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            switch (Prepare(database, "SELECT :left + :right;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    if (BindParameterCount(statement) != 2
                        || BindParameterIndex(statement, ":left") != 1
                        || BindParameterIndex(statement, ":right") != 2
                        || !IsStatementReadOnly(statement)
                        || IsStatementBusy(statement))
                    {
                        return false;
                    }

                    if (!TextResultEquals(BindParameterName(statement, 2, 32), ":right"))
                    {
                        return false;
                    }

                    if (!TextResultEquals(StatementSql(statement, 64), "SELECT :left + :right;"))
                    {
                        return false;
                    }

                    if (NormalizedSqlAvailable())
                    {
                        if (!TextResultIsNonEmpty(NormalizedSql(statement, 128)))
                        {
                            return false;
                        }
                    }
                    else if (!TextResultIsSQLiteStatus(NormalizedSql(statement, 128), SQLiteStatus.NotFound))
                    {
                        return false;
                    }

                    return Finalize(statement) == SQLiteStatusResult.Ok
                        && Close(database) == SQLiteStatusResult.Ok;
            }
    }
}

[Fact]
fn bool StatementStateAndCountersUpdateDuringExecution()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            if (Execute(database, "CREATE TABLE values_table(id INTEGER PRIMARY KEY, value INTEGER NOT NULL);") != SQLiteStatusResult.Ok)
            {
                return false;
            }

            if (Execute(database, "INSERT INTO values_table(id, value) VALUES(7, 35);") != SQLiteStatusResult.Ok)
            {
                return false;
            }

            switch (PrepareWithFlags(database, "SELECT value FROM values_table WHERE id = :id;", SQLITE_PREPARE_PERSISTENT | SQLITE_PREPARE_NO_VTAB))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    if (DataCount(statement) != 0 || StatementExplainMode(statement) != 0)
                    {
                        return false;
                    }

                    if (BindInt(statement, 1, 7) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    if (!TextResultIsNonEmpty(ExpandedSql(statement, 128)))
                    {
                        return false;
                    }

                    switch (Step(statement))
                    {
                        case SQLiteStepResult.Row:
                            if (DataCount(statement) != 1
                                || !IsStatementBusy(statement)
                                || ColumnInt(statement, 0) != 35)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    switch (Step(statement))
                    {
                        case SQLiteStepResult.Done:
                            if (DataCount(statement) != 0
                                || StatementStatus(statement, SQLITE_STMTSTATUS_VM_STEP, false) <= 0)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (StatementScanStatusAvailable())
                    {
                        if (!I64ResultAtLeast(StatementScanLoopCount(statement, 0), 0)
                            || !I64ResultAtLeast(StatementScanVisitCount(statement, 0), 0)
                            || !I64ResultAtLeast(StatementScanCycleCount(statement, 0), 0)
                            || !DoubleResultAtLeast(StatementScanEstimatedRows(statement, 0), 0.0)
                            || !IntResultAtLeast(StatementScanSelectId(statement, 0), 0)
                            || !TextResultIsNonEmpty(StatementScanExplain(statement, 0, 256))
                            || ResetStatementScanStatus(statement) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }

                        if (StatementScanStatusV2Available()
                            && !I64ResultAtLeast(StatementScanStatusI64(statement, 0, SQLITE_SCANSTAT_NLOOP, SQLITE_SCANSTAT_COMPLEX), 0))
                        {
                            return false;
                        }
                    }
                    else if (!StatusResultIsSQLiteStatus(ResetStatementScanStatus(statement), SQLiteStatus.NotFound)
                        || !I64ResultIsSQLiteStatus(StatementScanLoopCount(statement, 0), SQLiteStatus.NotFound)
                        || !I64ResultIsSQLiteStatus(StatementScanVisitCount(statement, 0), SQLiteStatus.NotFound)
                        || !I64ResultIsSQLiteStatus(StatementScanCycleCount(statement, 0), SQLiteStatus.NotFound)
                        || !DoubleResultIsSQLiteStatus(StatementScanEstimatedRows(statement, 0), SQLiteStatus.NotFound)
                        || !IntResultIsSQLiteStatus(StatementScanSelectId(statement, 0), SQLiteStatus.NotFound)
                        || !TextResultIsSQLiteStatus(StatementScanExplain(statement, 0, 256), SQLiteStatus.NotFound))
                    {
                        return false;
                    }

                    return Finalize(statement) == SQLiteStatusResult.Ok
                        && Close(database) == SQLiteStatusResult.Ok;
            }
    }
}

[Fact]
fn bool ExplainModeCanBeChangedBeforeExecution()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            switch (Prepare(database, "SELECT 1;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    if (StatementExplainMode(statement) != 0)
                    {
                        return false;
                    }

                    if (SetStatementExplainMode(statement, SQLiteStatementExplainMode.ExplainQueryPlan) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    if (StatementExplainMode(statement) != 2)
                    {
                        return false;
                    }

                    return Finalize(statement) == SQLiteStatusResult.Ok
                        && Close(database) == SQLiteStatusResult.Ok;
            }
    }
}
