unsafe ffi(c) fn void PreupdateHook(
    rawmutptr<i8[min max]> data,
    SQLiteDatabaseCallback database,
    System.C.c_int operation,
    rawptr<System.C.c_char> databaseName,
    rawptr<System.C.c_char> tableName,
    i64[min max] oldRowId,
    i64[min max] newRowId)
{
    if (data == null)
    {
        return;
    }

    unsafe
    {
        stack rawmutptr<SQLiteHookCounters> counters = (rawmutptr<SQLiteHookCounters>)data;
        (*counters).Preupdate += 1;
        switch (PreupdateColumnCount(database))
        {
            case SQLiteIntResult.Err(var error):
                (*counters).PreupdateColumns = -1;
            case SQLiteIntResult.Ok(var value):
                (*counters).PreupdateColumns = value;
        }

        switch (PreupdateDepth(database))
        {
            case SQLiteIntResult.Err(var error):
                (*counters).PreupdateDepth = -1;
            case SQLiteIntResult.Ok(var value):
                (*counters).PreupdateDepth = value;
        }

        switch (PreupdateBlobWriteColumn(database))
        {
            case SQLiteIntResult.Err(var error):
                (*counters).PreupdateBlobWriteColumn = -2;
            case SQLiteIntResult.Ok(var value):
                (*counters).PreupdateBlobWriteColumn = value;
        }

        if (operation == SQLITE_INSERT)
        {
            switch (PreupdateNewValue(database, 0))
            {
                case SQLitePreupdateValueResult.Err(var error):
                    (*counters).PreupdateInsertedId = -1;
                case SQLitePreupdateValueResult.Ok(var value):
                    (*counters).PreupdateInsertedId = ValueInt64(value);
            }
        }

        if (operation == SQLITE_UPDATE)
        {
            switch (PreupdateOldValue(database, 1))
            {
                case SQLitePreupdateValueResult.Err(var error):
                    (*counters).PreupdateUpdatedOldValue = -1;
                case SQLitePreupdateValueResult.Ok(var oldValue):
                    (*counters).PreupdateUpdatedOldValue = ValueInt64(oldValue);
            }

            switch (PreupdateNewValue(database, 1))
            {
                case SQLitePreupdateValueResult.Err(var error):
                    (*counters).PreupdateUpdatedNewValue = -1;
                case SQLitePreupdateValueResult.Ok(var newValue):
                    (*counters).PreupdateUpdatedNewValue = ValueInt64(newValue);
            }
        }
    }

    return;
}

fn bool BackupStepDone(SQLiteBackupStepResult result)
{
    switch (result)
    {
        case SQLiteBackupStepResult.Done:
            return true;
        default:
            return false;
    }
}

fn bool WalCheckpointSucceeded(SQLiteWalCheckpointResult result)
{
    switch (result)
    {
        case SQLiteWalCheckpointResult.Err(var error):
            return false;
        case SQLiteWalCheckpointResult.Ok(var snapshot):
            return snapshot.LogFrameCount >= -1 && snapshot.CheckpointedFrameCount >= -1;
    }
}

[Fact]
fn bool PointerBindingAndPointerResultsWork()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            switch (CreatePointerType("stark.sqlite.pointer"))
            {
                case SQLitePointerTypeResult.Err(var error):
                    return false;
                case SQLitePointerTypeResult.Ok(var typeValue):
                    stack mut SQLitePointerType typeName = typeValue;
                    stack mut i32[min max] bindDestructorMarker = 11;
                    stack mut i32[min max] resultDestructorMarker = 12;
                    stack mut i32[min max] auxDataDestructorMarker = 13;
                    stack mut SQLitePointerDestructorState destructorState = new()
                    {
                        TypeName = null,
                        Marker = null
                    };
                    unsafe
                    {
                        destructorState.TypeName = (rawmutptr<SQLitePointerType>)&typeName;
                        destructorState.Marker = (rawmutptr<i32[min max]>)&resultDestructorMarker;
                        stack SQLiteScalarCallback isPointer = IsPointerCallback;
                        stack SQLiteScalarCallback returnPointer = ReturnPointerCallback;
                        stack SQLiteScalarCallback returnPointerWithDestructor = ReturnPointerWithDestructorCallback;
                        stack SQLiteScalarCallback auxDataWithDestructor = AuxDataWithDestructorCallback;
                        stack rawmutptr<System.C.c_void> userData = (rawmutptr<System.C.c_void>)&typeName;
                        stack rawmutptr<System.C.c_void> destructorUserData = (rawmutptr<System.C.c_void>)&destructorState;
                        stack rawmutptr<System.C.c_void> auxDataUserData = (rawmutptr<System.C.c_void>)&auxDataDestructorMarker;
                        if (RegisterScalarFunctionWithUserData(database, "stark_is_pointer", 1, SQLITE_UTF8 | SQLITE_DETERMINISTIC, userData, isPointer) != SQLiteStatusResult.Ok
                            || RegisterScalarFunctionWithUserData(database, "stark_return_pointer", 0, SQLITE_UTF8 | SQLITE_DETERMINISTIC, userData, returnPointer) != SQLiteStatusResult.Ok
                            || RegisterScalarFunctionWithUserData(database, "stark_return_pointer_destruct", 0, SQLITE_UTF8 | SQLITE_DETERMINISTIC, destructorUserData, returnPointerWithDestructor) != SQLiteStatusResult.Ok
                            || RegisterScalarFunctionWithUserData(database, "stark_aux_destruct", 1, SQLITE_UTF8 | SQLITE_DETERMINISTIC, auxDataUserData, auxDataWithDestructor) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }
                    }

                    switch (Prepare(database, "SELECT stark_is_pointer(?1), stark_is_pointer(stark_return_pointer()), stark_is_pointer(?2), stark_is_pointer(stark_return_pointer_destruct()), stark_aux_destruct(1);"))
                    {
                        case SQLiteStatementResult.Err(var error):
                            return false;
                        case SQLiteStatementResult.Ok(var statementValue):
                            stack mut Statement statement = statementValue;
                            unsafe
                            {
                                stack SQLitePointerDestructor destroy = MarkPointerDestroyed;
                                if (BindPointerNoDestructor(statement, 1, (rawmutptr<System.C.c_void>)&typeName, typeName) != SQLiteStatusResult.Ok
                                    || BindPointer<i32[min max]>(statement, 2, bindDestructorMarker, typeName, destroy) != SQLiteStatusResult.Ok)
                                {
                                    return false;
                                }
                            }

                            switch (Step(statement))
                            {
                                case SQLiteStepResult.Row:
                                    if (ColumnInt(statement, 0) != 1
                                        || ColumnInt(statement, 1) != 1
                                        || ColumnInt(statement, 2) != 1
                                        || ColumnInt(statement, 3) != 1
                                        || ColumnInt(statement, 4) != 1)
                                    {
                                        return false;
                                    }
                                default:
                                    return false;
                            }

                            if (ClearBindings(statement) != SQLiteStatusResult.Ok || bindDestructorMarker != 941)
                            {
                                return false;
                            }

                            if (Finalize(statement) != SQLiteStatusResult.Ok)
                            {
                                return false;
                            }

                            if (resultDestructorMarker != 941 || auxDataDestructorMarker != 941)
                            {
                                return false;
                            }
                    }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool ScalarFunctionCallbacksAndValueResultsWork()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            unsafe
            {
                stack SQLiteScalarCallback addOne = AddOneCallback;
                stack SQLiteScalarCallback echo = EchoTextCallback;
                stack SQLiteScalarCallback isBound = IsBoundCallback;
                stack SQLiteScalarCallback blobLength = BlobLengthCallback;
                stack SQLiteScalarCallback textViewLengths = TextByteViewLengthsCallback;
                stack SQLiteScalarCallback bytes = BytesCallback;
                stack SQLiteScalarCallback zeroBlob = ZeroBlobCallback;
                if (RegisterScalarFunction(database, "stark_add_one", 1, SQLITE_UTF8 | SQLITE_DETERMINISTIC, addOne) != SQLiteStatusResult.Ok
                    || RegisterScalarFunction(database, "stark_echo", 1, SQLITE_UTF8 | SQLITE_DETERMINISTIC, echo) != SQLiteStatusResult.Ok
                    || RegisterScalarFunction(database, "stark_is_bound", 1, SQLITE_UTF8 | SQLITE_DETERMINISTIC, isBound) != SQLiteStatusResult.Ok
                    || RegisterScalarFunction(database, "stark_blob_len", 1, SQLITE_UTF8 | SQLITE_DETERMINISTIC, blobLength) != SQLiteStatusResult.Ok
                    || RegisterScalarFunction(database, "stark_text_view_lengths", 1, SQLITE_UTF8 | SQLITE_DETERMINISTIC, textViewLengths) != SQLiteStatusResult.Ok
                    || RegisterScalarFunction(database, "stark_bytes", 0, SQLITE_UTF8 | SQLITE_DETERMINISTIC, bytes) != SQLiteStatusResult.Ok
                    || RegisterScalarFunction(database, "stark_zero_blob", 0, SQLITE_UTF8 | SQLITE_DETERMINISTIC, zeroBlob) != SQLiteStatusResult.Ok)
                {
                    return false;
                }
            }

            if (!QueryIntEquals(database, "SELECT stark_add_one(41);", 42)
                || !QueryIntEquals(database, "SELECT length(stark_bytes());", 3)
                || !QueryIntEquals(database, "SELECT length(stark_zero_blob());", 4)
                || !QueryIntEquals(database, "SELECT stark_text_view_lengths('hello');", 50))
            {
                return false;
            }

            switch (Prepare(database, "SELECT stark_echo('hello');"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var echoValue):
                    stack mut Statement echo = echoValue;
                    switch (Step(echo))
                    {
                        case SQLiteStepResult.Row:
                            stack u8[0 max][5] expectedText = { 104, 101, 108, 108, 111 };
                            stack u8[0 max][] expectedTextBytes = expectedText;
                            unsafe
                            {
                                if (!TextResultEquals(ColumnText(echo, 0), "hello")
                                    || !ByteViewResultEquals(ColumnTextBytesView(echo, 0), expectedTextBytes)
                                    || ByteViewLengthOrNegative(ColumnText16BytesView(echo, 0)) != 10
                                    || BytesResultLengthOrNegative(ColumnText16Bytes(echo, 0)) != 10)
                                {
                                    return false;
                                }
                            }

                            switch (ColumnTextBytes(echo, 0))
                            {
                                case SQLiteBytesResult.Err(var error):
                                    return false;
                                case SQLiteBytesResult.Ok(var textBytesValue):
                                    stack mut SQLiteOwnedBytes textBytes = textBytesValue;
                                    stack mut u8[0 max][5] copiedText = { 0, 0, 0, 0, 0 };
                                    stack mut u8[0 max][] copiedTextBytes = copiedText;
                                    if (textBytes.CopyTo(copiedTextBytes) != SQLiteStatusResult.Ok
                                        || !BufferEquals(copiedTextBytes, expectedTextBytes))
                                    {
                                        return false;
                                    }
                            }
                        default:
                            return false;
                    }

                    if (Finalize(echo) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (Prepare(database, "SELECT stark_is_bound(?1), stark_blob_len(?2);"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var boundValue):
                    stack mut Statement bound = boundValue;
                    stack u8[0 max][3] payload = { 1, 2, 3 };
                    stack u8[0 max][] payloadBytes = payload;
                    if (BindInt(bound, 1, 11) != SQLiteStatusResult.Ok
                        || BindBytes(bound, 2, payloadBytes) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }

                    switch (Step(bound))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt(bound, 0) != 1 || ColumnInt(bound, 1) != 3)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(bound) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool AggregateAndWindowFunctionCallbacksWork()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            if (Execute(database, "CREATE TABLE agg_values(value INTEGER NOT NULL);") != SQLiteStatusResult.Ok
                || Execute(database, "INSERT INTO agg_values(value) VALUES(1),(2),(3);") != SQLiteStatusResult.Ok)
            {
                return false;
            }

            stack mut SQLiteHookCounters counters = new();
            unsafe
            {
                stack SQLiteAggregateStepCallback sumStep = SumAggregateStep;
                stack SQLiteAggregateFinalCallback sumFinal = SumAggregateFinal;
                stack SQLiteAggregateStepCallback countStep = CountAggregateStep;
                stack SQLiteAggregateFinalCallback countFinal = CountAggregateFinal;
                stack SQLiteAggregateStepCallback windowStep = WindowSumStep;
                stack SQLiteAggregateFinalCallback windowFinal = WindowSumFinal;
                stack SQLiteWindowValueCallback windowValue = WindowSumValue;
                stack SQLiteWindowInverseCallback windowInverse = WindowSumInverse;
                stack SQLiteClientDataDestructor aggregateDestroy = MarkAggregateDestroyed;
                stack SQLiteClientDataDestructor windowDestroy = MarkWindowDestroyed;
                if (RegisterAggregateFunctionWithUserData<SQLiteHookCounters>(
                        database,
                        "stark_sum",
                        1,
                        SQLITE_UTF8 | SQLITE_DETERMINISTIC,
                        counters,
                        sumStep,
                        sumFinal,
                        aggregateDestroy) != SQLiteStatusResult.Ok
                    || RegisterAggregateFunction(
                        database,
                        "stark_count_steps",
                        1,
                        SQLITE_UTF8 | SQLITE_DETERMINISTIC,
                        countStep,
                        countFinal) != SQLiteStatusResult.Ok
                    || RegisterWindowFunctionWithUserData<SQLiteHookCounters>(
                        database,
                        "stark_window_sum",
                        1,
                        SQLITE_UTF8 | SQLITE_DETERMINISTIC,
                        counters,
                        windowStep,
                        windowFinal,
                        windowValue,
                        windowInverse,
                        windowDestroy) != SQLiteStatusResult.Ok)
                {
                    return false;
                }
            }

            if (!QueryIntEquals(database, "SELECT stark_sum(value) FROM agg_values;", 6)
                || !QueryIntEquals(database, "SELECT stark_count_steps(value) FROM agg_values;", 3))
            {
                return false;
            }

            switch (Prepare(database, "SELECT stark_window_sum(value) OVER (ORDER BY value ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) FROM agg_values ORDER BY value;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    switch (Step(statement))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt(statement, 0) != 1)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    switch (Step(statement))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt(statement, 0) != 3)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    switch (Step(statement))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt(statement, 0) != 5)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    switch (Step(statement))
                    {
                        case SQLiteStepResult.Done:
                            break;
                        default:
                            return false;
                    }

                    if (Finalize(statement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            if (Close(database) != SQLiteStatusResult.Ok)
            {
                return false;
            }

            return counters.AggregateDestroyed == 1 && counters.WindowDestroyed == 1;
    }
}

[Fact]
fn bool CollationAndAutoExtensionCallbacksWork()
{
    unsafe
    {
        ResetAutoExtensions();
        SQLiteAutoExtensionCalls = 0;
        stack SQLiteAutoExtensionCallback autoExtension = AutoExtensionHook;
        if (RegisterAutoExtension(autoExtension) != SQLiteStatusResult.Ok)
        {
            return false;
        }

        switch (OpenInMemory())
        {
            case SQLiteDatabaseResult.Err(var error):
                ResetAutoExtensions();
                return false;
            case SQLiteDatabaseResult.Ok(var autoDatabaseValue):
                stack mut Database autoDatabase = autoDatabaseValue;
                if (Close(autoDatabase) != SQLiteStatusResult.Ok)
                {
                    ResetAutoExtensions();
                    return false;
                }
        }

        if (SQLiteAutoExtensionCalls != 1 || !CancelAutoExtension(autoExtension))
        {
            ResetAutoExtensions();
            return false;
        }

        switch (OpenInMemory())
        {
            case SQLiteDatabaseResult.Err(var error):
                ResetAutoExtensions();
                return false;
            case SQLiteDatabaseResult.Ok(var afterCancelValue):
                stack mut Database afterCancel = afterCancelValue;
                if (Close(afterCancel) != SQLiteStatusResult.Ok)
                {
                    ResetAutoExtensions();
                    return false;
                }
        }

        if (SQLiteAutoExtensionCalls != 1)
        {
            ResetAutoExtensions();
            return false;
        }

        ResetAutoExtensions();
    }

    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            if (Execute(database, "CREATE TABLE collate_values(value TEXT NOT NULL);") != SQLiteStatusResult.Ok
                || Execute(database, "INSERT INTO collate_values(value) VALUES('a'),('b'),('c');") != SQLiteStatusResult.Ok)
            {
                return false;
            }

            stack mut SQLiteHookCounters counters = new();
            unsafe
            {
                stack SQLiteCollationCompareCallback compare = ReverseCollationCompare;
                stack SQLiteClientDataDestructor destroy = MarkCollationDestroyed;
                if (RegisterCollationWithUserData<SQLiteHookCounters>(
                        database,
                        "STARK_REVERSE",
                        SQLITE_UTF8,
                        counters,
                        compare,
                        destroy) != SQLiteStatusResult.Ok
                    || RegisterCollationUtf16Ascii(
                        database,
                        "STARK_REVERSE16",
                        SQLITE_UTF16,
                        compare) != SQLiteStatusResult.Ok)
                {
                    return false;
                }
            }

            switch (Prepare(database, "SELECT value FROM collate_values ORDER BY value COLLATE STARK_REVERSE LIMIT 1;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    switch (Step(statement))
                    {
                        case SQLiteStepResult.Row:
                            if (!TextResultEquals(ColumnText(statement, 0), "c"))
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(statement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (Prepare(database, "SELECT value FROM collate_values ORDER BY value COLLATE STARK_REVERSE16 LIMIT 1;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    switch (Step(statement))
                    {
                        case SQLiteStepResult.Row:
                            if (!TextResultEquals(ColumnText(statement, 0), "c"))
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(statement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            if (counters.CollationCompared <= 0)
            {
                return false;
            }

            unsafe
            {
                if (ClearCollation(database, "STARK_REVERSE", SQLITE_UTF8) != SQLiteStatusResult.Ok
                    || counters.CollationDestroyed != 1
                    || ClearCollationUtf16Ascii(database, "STARK_REVERSE16", SQLITE_UTF16) != SQLiteStatusResult.Ok)
                {
                    return false;
                }

                stack SQLiteCollationNeededCallback needed = CollationNeededHook;
                if (SetCollationNeededWithUserData<SQLiteHookCounters>(database, counters, needed) != SQLiteStatusResult.Ok)
                {
                    return false;
                }
            }

            switch (Prepare(database, "SELECT 'a' = 'a' COLLATE STARK_MISSING;"))
            {
                case SQLiteStatementResult.Err(var error):
                    break;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    Finalize(statement);
                    return false;
            }

            unsafe
            {
                if (counters.CollationNeeded <= 0
                    || counters.CollationNeededTextRepresentation == 0
                    || ClearCollationNeeded(database) != SQLiteStatusResult.Ok)
                {
                    return false;
                }

                stack SQLiteCollationNeeded16Callback needed16 = CollationNeeded16Hook;
                if (SetCollationNeededUtf16WithUserData<SQLiteHookCounters>(database, counters, needed16) != SQLiteStatusResult.Ok)
                {
                    return false;
                }
            }

            switch (Prepare(database, "SELECT 'a' = 'a' COLLATE STARK_MISSING16;"))
            {
                case SQLiteStatementResult.Err(var error):
                    break;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    Finalize(statement);
                    return false;
            }

            unsafe
            {
                if (counters.CollationNeeded16 <= 0
                    || ClearCollationNeededUtf16(database) != SQLiteStatusResult.Ok)
                {
                    return false;
                }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool DatabaseHookCallbacksWork()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            if (Execute(database, "CREATE TABLE hooks(id INTEGER PRIMARY KEY, value INTEGER NOT NULL);") != SQLiteStatusResult.Ok)
            {
                return false;
            }

            stack mut SQLiteHookCounters counters = new();
            unsafe
            {
                stack SQLiteBusyCallback busy = BusyHook;
                stack SQLiteAuthorizerCallback authorizer = AuthorizerHook;
                stack SQLiteTraceCallback traceDeprecated = TraceDeprecatedHook;
                stack SQLiteProfileCallback profileDeprecated = ProfileDeprecatedHook;
                stack SQLiteTraceV2Callback trace = TraceV2Hook;
                stack SQLiteProgressCallback progress = ProgressHook;
                stack SQLiteCommitCallback commit = CommitHook;
                stack SQLiteRollbackCallback rollback = RollbackHook;
                stack SQLiteAutovacuumPagesCallback autovacuum = AutovacuumPagesHook;
                stack SQLiteClientDataDestructor autovacuumDestroy = MarkAutovacuumDestroyed;
                stack SQLiteUpdateCallback update = UpdateHook;
                stack SQLiteWalCallback wal = WalHook;
                stack SQLiteUnlockNotifyCallback unlock = UnlockNotifyHook;
                stack SQLitePreupdateCallback preupdate = PreupdateHook;
                stack u32[1 max] traceMask = (u32[1 max])(SQLITE_TRACE_STMT | SQLITE_TRACE_ROW | SQLITE_TRACE_PROFILE);
                if (SetBusyHandler<SQLiteHookCounters>(database, busy, counters) != SQLiteStatusResult.Ok
                    || SetAuthorizer<SQLiteHookCounters>(database, authorizer, counters) != SQLiteStatusResult.Ok
                    || SetTraceDeprecated<SQLiteHookCounters>(database, traceDeprecated, counters) != SQLiteStatusResult.Ok
                    || ClearTraceDeprecated(database) != SQLiteStatusResult.Ok
                    || SetProfileDeprecated<SQLiteHookCounters>(database, profileDeprecated, counters) != SQLiteStatusResult.Ok
                    || ClearProfileDeprecated(database) != SQLiteStatusResult.Ok
                    || SetTraceHandler<SQLiteHookCounters>(database, traceMask, trace, counters) != SQLiteStatusResult.Ok
                    || SetProgressHandler<SQLiteHookCounters>(database, 1, progress, counters) != SQLiteStatusResult.Ok
                    || SetCommitHook<SQLiteHookCounters>(database, commit, counters) != SQLiteStatusResult.Ok
                    || SetRollbackHook<SQLiteHookCounters>(database, rollback, counters) != SQLiteStatusResult.Ok
                    || SetAutovacuumPages<SQLiteHookCounters>(database, autovacuum, counters, autovacuumDestroy) != SQLiteStatusResult.Ok
                    || SetUpdateHook<SQLiteHookCounters>(database, update, counters) != SQLiteStatusResult.Ok
                    || SetWalHook<SQLiteHookCounters>(database, wal, counters) != SQLiteStatusResult.Ok
                    || SetUnlockNotify<SQLiteHookCounters>(database, unlock, counters) != SQLiteStatusResult.Ok
                    || SetPreupdateHook<SQLiteHookCounters>(database, preupdate, counters) != SQLiteStatusResult.Ok)
                {
                    return false;
                }
            }

            if (Execute(database, "INSERT INTO hooks(id, value) VALUES(1, 10);") != SQLiteStatusResult.Ok
                || Execute(database, "UPDATE hooks SET value = 20 WHERE id = 1;") != SQLiteStatusResult.Ok
                || Execute(database, "BEGIN; INSERT INTO hooks(id, value) VALUES(2, 30); ROLLBACK;") != SQLiteStatusResult.Ok
                || !QueryIntEquals(database, "SELECT value FROM hooks WHERE id = 1;", 20))
            {
                return false;
            }

            if (counters.Authorizer <= 0
                || counters.Trace <= 0
                || counters.Progress <= 0
                || counters.Commit <= 0
                || counters.Rollback <= 0
                || counters.Update < 2
                || counters.Preupdate < 2
                || counters.PreupdateColumns != 2
                || counters.PreupdateDepth != 0
                || counters.PreupdateBlobWriteColumn != -1
                || counters.PreupdateInsertedId <= 0
                || counters.PreupdateUpdatedOldValue != 10
                || counters.PreupdateUpdatedNewValue != 20)
            {
                return false;
            }

            unsafe
            {
                if (ClearBusyHandler(database) != SQLiteStatusResult.Ok
                    || ClearAuthorizer(database) != SQLiteStatusResult.Ok
                    || ClearTraceHandler(database) != SQLiteStatusResult.Ok
                    || ClearProgressHandler(database) != SQLiteStatusResult.Ok
                    || ClearCommitHook(database) != SQLiteStatusResult.Ok
                    || ClearRollbackHook(database) != SQLiteStatusResult.Ok
                    || ClearAutovacuumPagesNoDestructor(database) != SQLiteStatusResult.Ok
                    || counters.AutovacuumDestroyed != 1
                    || ClearUpdateHook(database) != SQLiteStatusResult.Ok
                    || ClearWalHook(database) != SQLiteStatusResult.Ok
                    || ClearUnlockNotify(database) != SQLiteStatusResult.Ok
                    || ClearPreupdateHook(database) != SQLiteStatusResult.Ok)
                {
                    return false;
                }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool NoCallbackUtilityAndMetadataApisWork()
{
    SetSoftHeapLimitDeprecated(0);

    if (Initialize() != SQLiteStatusResult.Ok
        || InitializeOs() != SQLiteStatusResult.Ok
        || !LifecycleShutdownApisTypecheck()
        || !Win32DirectoryApisUnavailableOrPresent()
        || !SQLiteDirectoryGlobalsWork()
        || !TextResultEquals(LibraryVersionConstant(32), SQLITE_VERSION)
        || !TextResultIsNonEmpty(SourceId(256))
        || !TextResultIsNonEmpty(CompileOptionName(0, 128))
        || !BoolResultEquals(CompileOptionUsed("THREADSAFE"), true)
        || KeywordCount() <= 0
        || !TextResultIsNonEmpty(KeywordName(0, 64))
        || !BoolResultEquals(IsKeyword("SELECT"), true)
        || !BoolResultEquals(IsKeyword("not_a_keyword"), false)
        || !BoolResultEquals(IsCompleteSql("SELECT 1;"), true)
        || !BoolResultEquals(IsCompleteSql("SELECT"), false)
        || !BoolResultEquals(IsCompleteSqlUtf16Ascii("SELECT 1;"), true)
        || !BoolResultEquals(IsCompleteSqlUtf16Unicode((unicode)"SELECT 1;"), true)
        || !IntResultEquals(StringCompareInsensitive("Alpha", "alpha"), 0)
        || !IntResultEquals(StringCompareInsensitivePrefix("Alphabet", "alpha", 5), 0)
        || !BoolResultEquals(GlobMatches("Al*", "Alpha"), true)
        || !BoolResultEquals(LikeMatches("Al%", "Alpha", 0), true)
        || MemoryUsed() < 0
        || MemoryHighWater(false) < 0
        || !IntResultAtLeast(ReleaseGlobalMemory(0), 0)
        || SoftHeapLimit(-1) < 0
        || HardHeapLimit(-1) < 0
        || !SnapshotCurrentAtLeast(GlobalStatus32(SQLITE_STATUS_MEMORY_USED, false), 0))
    {
        return false;
    }

    stack mut u8[0 max][8] randomBytes = { 0, 0, 0, 0, 0, 0, 0, 0 };
    stack mut u8[0 max][] randomView = randomBytes;
    if (Randomness(randomView) != SQLiteStatusResult.Ok || SleepMilliseconds(0) < 0)
    {
        return false;
    }

    switch (OpenDefault(":memory:"))
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var defaultValue):
            stack mut Database defaultDatabase = defaultValue;
            if (CloseStrict(defaultDatabase) != SQLiteStatusResult.Ok)
            {
                return false;
            }
    }

    switch (OpenUtf16Ascii(":memory:"))
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var utf16Value):
            stack mut Database utf16Database = utf16Value;
            if (Close(utf16Database) != SQLiteStatusResult.Ok)
            {
                return false;
            }
    }

    switch (Open("file:stark_sqlite_no_callback?mode=memory&cache=shared&flag=1&size=42", SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE | SQLITE_OPEN_URI))
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            unsafe
            {
                if (SetLoadExtensionEnabled(database, false) != SQLiteStatusResult.Ok
                    || !StatusResultIsSQLiteStatus(ConfigureLookaside(database, 10, 1), SQLiteStatus.Range)
                    || ConfigureOwnedLookaside(database, 64, 4) != SQLiteStatusResult.Ok
                    || DisableLookaside(database) != SQLiteStatusResult.Ok
                    || ConfigureLookaside(database, 64, 4) != SQLiteStatusResult.Ok
                    || DisableLookaside(database) != SQLiteStatusResult.Ok
                    || SetMainDatabaseName(database, "primary") != SQLiteStatusResult.Ok
                    || !TextResultEquals(DatabaseName(database, 0, 32), "primary")
                    || SetMainDatabaseName(database, "main") != SQLiteStatusResult.Ok
                    || !TextResultEquals(DatabaseName(database, 0, 32), "main")
                    || !IntResultAtLeast(CurrentFloatingPointDigits(database), 3)
                    || !IntResultEquals(SetFloatingPointDigits(database, 17), 17))
                {
                    return false;
                }

                if (!BoolResultEquals(SetDatabaseConfigFlag(database, SQLITE_DBCONFIG_ENABLE_FKEY, 1), true)
                    || !BoolResultEquals(SetLoadExtensionApiOnly(database, true), true)
                    || LoadExtension(database, "stark_sqlite_missing_extension_for_test") == SQLiteStatusResult.Ok
                    || !BoolResultEquals(SetLoadExtensionApiOnly(database, false), false)
                    || OverloadFunction(database, "stark_overload_placeholder", 1) != SQLiteStatusResult.Ok)
                {
                    return false;
                }

                switch (CreateClientDataKey("stark.sqlite.clientdata"))
                {
                    case SQLiteClientDataKeyResult.Err(var error):
                        return false;
                    case SQLiteClientDataKeyResult.Ok(var keyValue):
                        stack mut SQLiteClientDataKey key = keyValue;
                        stack mut i32[min max] marker = 441;
                        stack rawmutptr<System.C.c_void> markerPointer = (rawmutptr<System.C.c_void>)&marker;
                        if (SetClientDataNoDestructor(database, key, markerPointer) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }

                        switch (ClientData(database, key))
                        {
                            case SQLiteMutablePointerResult.Err(var error):
                                return false;
                            case SQLiteMutablePointerResult.Ok(var pointer):
                                if (pointer == null)
                                {
                                    return false;
                                }

                                stack rawptr<i32[min max]> recoveredPointer = (rawptr<i32[min max]>)pointer;
                                if (*recoveredPointer != 441)
                                {
                                    return false;
                                }
                        }

                        stack mut i32[min max] destructorMarker = 101;
                        stack rawptr<i32[min max]> destructorMarkerView = (rawptr<i32[min max]>)&destructorMarker;
                        stack SQLiteClientDataDestructor destroy = MarkClientDataDestroyed;
                        if (SetClientData<i32[min max]>(database, key, destructorMarker, destroy) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }

                        if (destructorMarker != 101)
                        {
                            return false;
                        }

                        switch (ClientData(database, key))
                        {
                            case SQLiteMutablePointerResult.Err(var error):
                                return false;
                            case SQLiteMutablePointerResult.Ok(var pointer):
                                if (pointer == null)
                                {
                                    return false;
                                }

                                stack rawptr<i32[min max]> storedPointer = (rawptr<i32[min max]>)pointer;
                                if (*storedPointer != 101)
                                {
                                    return false;
                                }
                        }

                        if (ClearClientDataNoDestructor(database, key) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }

                        if (*destructorMarkerView != 917)
                        {
                            return false;
                        }

                        if (ClearClientDataNoDestructor(database, key) != SQLiteStatusResult.Ok)
                        {
                            return false;
                        }

                        switch (ClientData(database, key))
                        {
                            case SQLiteMutablePointerResult.Err(var error):
                                return false;
                            case SQLiteMutablePointerResult.Ok(var pointer):
                                if (pointer != null)
                                {
                                    return false;
                                }
                        }
                }
            }

            if (DisableLoadExtensions(database) != SQLiteStatusResult.Ok
                || SetLockTimeout(database, 0, 0) != SQLiteStatusResult.Ok
                || SetLockTimeout(database, 1, SQLITE_SETLK_BLOCK_ON_CONNECT) != SQLiteStatusResult.Ok
                || SetLockTimeout(database, 0, 2) == SQLiteStatusResult.Ok
                || !BoolResultEquals(DatabaseUriBoolean(database, "main", "missing", true), true)
                || !I64ResultEquals(DatabaseUriInt64(database, "main", "missing", 42), 42)
                || !IntResultAtLeast(FileControlDataVersion(database, "main"), 0)
                || !IntResultAtLeast(SystemErrno(database), 0))
            {
                return false;
            }

            if (Execute(database, "CREATE TABLE meta(id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, note TEXT);") != SQLiteStatusResult.Ok
                || Execute(database, "INSERT INTO meta(name, note) VALUES('alpha', 'first');") != SQLiteStatusResult.Ok
                || !ColumnMetadataLooksLikeId(TableColumnMetadata(database, "main", "meta", "id", 64)))
            {
                return false;
            }

            switch (CreateFilename("main.db", "main.db-journal", "main.db-wal"))
            {
                case SQLiteFilenameResult.Err(var error):
                    return false;
                case SQLiteFilenameResult.Ok(var filenameValue):
                    stack mut SQLiteFilename filename = filenameValue;
                    if (!filename.IsOpen()
                        || !TextResultEquals(FilenameDatabase(filename, 64), "main.db")
                        || !TextResultEquals(FilenameJournal(filename, 64), "main.db-journal")
                        || !TextResultEquals(FilenameWal(filename, 64), "main.db-wal"))
                    {
                        return false;
                    }

                    filename.Close();
            }

            switch (GetTable(database, "SELECT name, note, NULL AS missing FROM meta WHERE id = 1;"))
            {
                case SQLiteTableResult.Err(var error):
                    return false;
                case SQLiteTableResult.Ok(var tableValue):
                    stack mut SQLiteTable table = tableValue;
                    if (table.RowCount() != 1
                        || table.ColumnCount() != 3
                        || !TextResultEquals(TableColumnName(table, 0, 64), "name")
                        || !TextResultEquals(TableColumnName(table, 1, 64), "note")
                        || !TextResultEquals(TableColumnName(table, 2, 64), "missing")
                        || !TextResultEquals(TableCell(table, 0, 0, 64), "alpha")
                        || !TextResultEquals(TableCell(table, 0, 1, 64), "first")
                        || !BoolResultEquals(TableCellIsNull(table, 0, 2), true)
                        || !TextResultIsNullValue(TableCell(table, 0, 2, 64)))
                    {
                        return false;
                    }

                    table.Close();
            }

            switch (PrepareLegacy(database, "SELECT name FROM meta WHERE id = 1;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var legacyValue):
                    stack mut Statement legacy = legacyValue;
                    if (!StatementHasDatabase(legacy) || StatementExpired(legacy))
                    {
                        return false;
                    }

                    switch (Step(legacy))
                    {
                        case SQLiteStepResult.Row:
                            if (!TextResultEquals(ColumnName(legacy, 0, 64), "name")
                                || !Utf16ResultLengthEquals(ColumnName16(legacy, 0, 64), 4)
                                || !TextResultEquals(ColumnDeclType(legacy, 0, 64), "TEXT")
                                || !Utf16ResultLengthEquals(ColumnDeclType16(legacy, 0, 64), 4)
                                || !TextResultEquals(ColumnDatabaseName(legacy, 0, 64), "main")
                                || !Utf16ResultLengthEquals(ColumnDatabaseName16(legacy, 0, 64), 4)
                                || !TextResultEquals(ColumnTableName(legacy, 0, 64), "meta")
                                || !Utf16ResultLengthEquals(ColumnTableName16(legacy, 0, 64), 4)
                                || !TextResultEquals(ColumnOriginName(legacy, 0, 64), "name")
                                || !Utf16ResultLengthEquals(ColumnOriginName16(legacy, 0, 64), 4)
                                || !Utf16ResultLengthEquals(ColumnText16(legacy, 0), 5)
                                || !IntResultEquals(ColumnBytes16(legacy, 0), 10))
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(legacy) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (Prepare(database, "SELECT ?1, ?2;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var sourceValue):
                    stack mut Statement source = sourceValue;
                    switch (Prepare(database, "INSERT INTO meta(name, note) VALUES(?1, ?2);"))
                    {
                        case SQLiteStatementResult.Err(var insertError):
                            return false;
                        case SQLiteStatementResult.Ok(var destinationValue):
                            stack mut Statement destination = destinationValue;
                            if (BindText64(source, 1, "beta") != SQLiteStatusResult.Ok
                                || BindText16Ascii(source, 2, "utf16") != SQLiteStatusResult.Ok
                                || TransferBindings(source, destination) != SQLiteStatusResult.Ok)
                            {
                                return false;
                            }

                            switch (Step(destination))
                            {
                                case SQLiteStepResult.Done:
                                    break;
                                default:
                                    return false;
                            }

                            if (Finalize(destination) != SQLiteStatusResult.Ok)
                            {
                                return false;
                            }
                    }

                    if (Finalize(source) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (PrepareUtf16LegacyAscii(database, "SELECT 1;"))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var statementValue):
                    stack mut Statement statement = statementValue;
                    switch (Step(statement))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt(statement, 0) != 1)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(statement) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            switch (PrepareUtf16AsciiWithFlags(database, "SELECT COUNT(*) FROM meta;", SQLITE_PREPARE_PERSISTENT))
            {
                case SQLiteStatementResult.Err(var error):
                    return false;
                case SQLiteStatementResult.Ok(var countValue):
                    stack mut Statement count = countValue;
                    switch (Step(count))
                    {
                        case SQLiteStepResult.Row:
                            if (ColumnInt(count, 0) != 2)
                            {
                                return false;
                            }
                        default:
                            return false;
                    }

                    if (Finalize(count) != SQLiteStatusResult.Ok)
                    {
                        return false;
                    }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

[Fact]
fn bool SQLiteMutexApisWork()
{
    if (!MutexResultIsRangeError(AllocateMutex(SQLITE_MUTEX_STATIC_MAIN)))
    {
        return false;
    }

    switch (AllocateMutex(SQLITE_MUTEX_RECURSIVE))
    {
        case SQLiteMutexResult.Err(var error):
            return Threadsafe() == 0;
        case SQLiteMutexResult.Ok(var mutexValue):
            stack mut SQLiteMutex mutex = mutexValue;
            if (!mutex.IsOpen())
            {
                return false;
            }

            if (EnterMutex(mutex) != SQLiteStatusResult.Ok
                || !BoolResultEquals(TryEnterMutex(mutex), true)
                || (MutexHeldAvailable() && !BoolResultEquals(IsMutexHeld(mutex), true))
                || (!MutexHeldAvailable() && !BoolResultIsSQLiteStatus(IsMutexHeld(mutex), SQLiteStatus.NotFound))
                || (MutexNotHeldAvailable() && !BoolResultEquals(IsMutexNotHeld(mutex), false))
                || (!MutexNotHeldAvailable() && !BoolResultIsSQLiteStatus(IsMutexNotHeld(mutex), SQLiteStatus.NotFound))
                || LeaveMutex(mutex) != SQLiteStatusResult.Ok
                || LeaveMutex(mutex) != SQLiteStatusResult.Ok
                || (MutexHeldAvailable() && !BoolResultEquals(IsMutexHeld(mutex), false))
                || (MutexNotHeldAvailable() && !BoolResultEquals(IsMutexNotHeld(mutex), true)))
            {
                return false;
            }

            mutex.Close();
            if (mutex.IsOpen() || EnterMutex(mutex) == SQLiteStatusResult.Ok)
            {
                return false;
            }
    }

    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            switch (DatabaseMutex(database))
            {
                case SQLiteMutexViewResult.Err(var mutexError):
                    return Threadsafe() == 0 && Close(database) == SQLiteStatusResult.Ok;
                case SQLiteMutexViewResult.Ok(var viewValue):
                    stack mut SQLiteMutexView mutexView = viewValue;
                    if (!mutexView.IsOpen()
                        || EnterMutexView(mutexView) != SQLiteStatusResult.Ok
                        || (MutexHeldAvailable() && !BoolResultEquals(IsMutexViewHeld(mutexView), true))
                        || (!MutexHeldAvailable() && !BoolResultIsSQLiteStatus(IsMutexViewHeld(mutexView), SQLiteStatus.NotFound))
                        || (MutexNotHeldAvailable() && !BoolResultEquals(IsMutexViewNotHeld(mutexView), false))
                        || (!MutexNotHeldAvailable() && !BoolResultIsSQLiteStatus(IsMutexViewNotHeld(mutexView), SQLiteStatus.NotFound))
                        || LeaveMutexView(mutexView) != SQLiteStatusResult.Ok
                        || (MutexHeldAvailable() && !BoolResultEquals(IsMutexViewHeld(mutexView), false))
                        || (MutexNotHeldAvailable() && !BoolResultEquals(IsMutexViewNotHeld(mutexView), true)))
                    {
                        return false;
                    }
            }

            return Close(database) == SQLiteStatusResult.Ok;
    }
}

