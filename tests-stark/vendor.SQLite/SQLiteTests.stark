[Fact]
fn bool TypedFileControlWrappersRejectClosedDatabase()
{
    switch (OpenInMemory())
    {
        case SQLiteDatabaseResult.Err(var error):
            return false;
        case SQLiteDatabaseResult.Ok(var databaseValue):
            stack mut Database database = databaseValue;
            if (Close(database) != SQLiteStatusResult.Ok)
            {
                return false;
            }

            if (!IntResultIsNullHandle(FileControlLockState(database, "main"))
                || !IntResultIsNullHandle(FileControlDataVersion(database, "main"))
                || !I64ResultIsNullHandle(FileControlCurrentSizeLimit(database, "main"))
                || !I64ResultIsNullHandle(FileControlSetSizeLimit(database, "main", 1024))
                || !BoolResultIsNullHandle(FileControlPersistentWal(database, "main"))
                || !BoolResultIsNullHandle(FileControlSetPersistentWal(database, "main", true))
                || !BoolResultIsNullHandle(FileControlPowerSafeOverwrite(database, "main"))
                || !BoolResultIsNullHandle(FileControlSetPowerSafeOverwrite(database, "main", true))
                || !TextResultIsNullHandle(FileControlVfsName(database, "main", 256))
                || !TextResultIsNullHandle(FileControlTempFilename(database, "main", 256))
                || !I64ResultIsNullHandle(FileControlCurrentMmapSize(database, "main"))
                || !I64ResultIsNullHandle(FileControlSetMmapSize(database, "main", 4096))
                || !BoolResultIsNullHandle(FileControlHasMoved(database, "main"))
                || !IntResultIsNullHandle(FileControlSetLockTimeout(database, "main", 1))
                || !BoolResultIsNullHandle(FileControlExternalReader(database, "main"))
                || !StatusResultIsNullHandle(FileControlSetSizeHint(database, "main", 4096))
                || !StatusResultIsNullHandle(FileControlSetChunkSize(database, "main", 4096))
                || !StatusResultIsNullHandle(FileControlResetCache(database, "main")))
            {
                return false;
            }

            unsafe
            {
                if (!FileObjectResultIsNullHandle(FileControlFileObject(database, "main"))
                    || !FileObjectResultIsNullHandle(FileControlJournalObject(database, "main"))
                    || !VfsResultIsNullHandle(FileControlVfs(database, "main"))
                    || !StatusResultIsNullHandle(FileControlBeginAtomicWrite(database, "main"))
                    || !StatusResultIsNullHandle(FileControlCommitAtomicWrite(database, "main"))
                    || !StatusResultIsNullHandle(FileControlRollbackAtomicWrite(database, "main")))
                {
                    return false;
                }
            }

            return true;
    }
}

