unsafe ffi(c) fn void AddOneCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack rawmutptr<SQLite3ValueNative> value = FunctionArgument(values, argumentCount, 0);
        if (value == null)
        {
            ResultError(nativeContext, "missing argument");
            return;
        }

        if (ValueType(value) == SQLiteColumnType.Null)
        {
            ResultNull(nativeContext);
            return;
        }

        ResultInt64(nativeContext, ValueInt64(value) + 1);
        return;
    }
}

unsafe ffi(c) fn void EchoTextCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack rawmutptr<SQLite3ValueNative> value = FunctionArgument(values, argumentCount, 0);
        if (value == null)
        {
            ResultError(nativeContext, "missing text");
            return;
        }

        switch (ValueText(value))
        {
            case SQLiteTextResult.Err(var error):
                ResultError(nativeContext, "text expected");
                return;
            case SQLiteTextResult.Ok(var text):
                ResultText(nativeContext, text.View());
                return;
        }
    }
}

unsafe ffi(c) fn void IsBoundCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack rawmutptr<SQLite3ValueNative> value = FunctionArgument(values, argumentCount, 0);
        if (value == null)
        {
            ResultInt(nativeContext, 0);
            return;
        }

        switch (ValueFromBind(value))
        {
            case SQLiteBoolResult.Err(var error):
                ResultInt(nativeContext, 0);
                return;
            case SQLiteBoolResult.Ok(var isBound):
                if (isBound)
                {
                    ResultInt(nativeContext, 1);
                    return;
                }

                ResultInt(nativeContext, 0);
                return;
        }
    }
}

unsafe ffi(c) fn void BlobLengthCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack rawmutptr<SQLite3ValueNative> value = FunctionArgument(values, argumentCount, 0);
        if (value == null)
        {
            ResultError(nativeContext, "missing blob");
            return;
        }

        switch (ValueBlobView(value))
        {
            case SQLiteByteViewResult.Err(var error):
                ResultError(nativeContext, "blob expected");
                return;
            case SQLiteByteViewResult.Ok(var view):
                ResultInt(nativeContext, (i32[min max])view.Length());
                return;
        }
    }
}

unsafe ffi(c) fn void TextByteViewLengthsCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack rawmutptr<SQLite3ValueNative> value = FunctionArgument(values, argumentCount, 0);
        if (value == null)
        {
            ResultError(nativeContext, "missing text");
            return;
        }

        stack i32[min max] utf8Length = ByteViewLengthOrNegative(ValueTextBytesView(value));
        stack i32[min max] utf16Length = ByteViewLengthOrNegative(ValueText16BytesView(value));
        stack i32[min max] utf16LeLength = ByteViewLengthOrNegative(ValueText16LeBytesView(value));
        stack i32[min max] utf16BeLength = ByteViewLengthOrNegative(ValueText16BeBytesView(value));
        stack i32[min max] ownedUtf8Length = BytesResultLengthOrNegative(ValueTextBytes(value));
        stack i32[min max] ownedUtf16Length = BytesResultLengthOrNegative(ValueText16Bytes(value));
        if (utf8Length < 0
            || utf16Length < 0
            || utf16LeLength < 0
            || utf16BeLength < 0
            || ownedUtf8Length < 0
            || ownedUtf16Length < 0)
        {
            ResultError(nativeContext, "text expected");
            return;
        }

        ResultInt(
            nativeContext,
            utf8Length
                + utf16Length
                + utf16LeLength
                + utf16BeLength
                + ownedUtf8Length
                + ownedUtf16Length);
        return;
    }
}

unsafe ffi(c) fn void BytesCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack u8[0 max][3] bytes = { 5, 6, 7 };
        stack u8[0 max][] view = bytes;
        ResultBytes(nativeContext, view);
        return;
    }
}

unsafe ffi(c) fn void ZeroBlobCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        ResultZeroBlob64(nativeContext, 4);
        return;
    }
}

unsafe ffi(c) fn void IsPointerCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack rawmutptr<SQLitePointerType> typeName = (rawmutptr<SQLitePointerType>)FunctionUserData(nativeContext);
        stack rawmutptr<SQLite3ValueNative> value = FunctionArgument(values, argumentCount, 0);
        if (typeName == null || value == null)
        {
            ResultInt(nativeContext, 0);
            return;
        }

        switch (ValuePointerWithType(value, *typeName))
        {
            case SQLitePointerResult.Err(var error):
                ResultInt(nativeContext, 0);
                return;
            case SQLitePointerResult.Ok(var pointer):
                if (pointer == null)
                {
                    ResultInt(nativeContext, 0);
                    return;
                }

                ResultInt(nativeContext, 1);
                return;
        }
    }
}

unsafe ffi(c) fn void ReturnPointerCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack rawmutptr<SQLitePointerType> typeName = (rawmutptr<SQLitePointerType>)FunctionUserData(nativeContext);
        if (typeName == null)
        {
            ResultNull(nativeContext);
            return;
        }

        ResultPointer(nativeContext, (rawmutptr<System.C.c_void>)typeName, *typeName);
        return;
    }
}

struct SQLitePointerDestructorState
{
    rawmutptr<SQLitePointerType> TypeName;
    rawmutptr<i32[min max]> Marker;
}

unsafe ffi(c) fn void MarkPointerDestroyed(rawmutptr<i8[min max]> data)
{
    if (data == null)
    {
        return;
    }

    unsafe
    {
        stack rawmutptr<i32[min max]> marker = (rawmutptr<i32[min max]>)data;
        *marker = 941;
    }

    return;
}

unsafe ffi(c) fn void ReturnPointerWithDestructorCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack rawmutptr<SQLitePointerDestructorState> state =
            (rawmutptr<SQLitePointerDestructorState>)FunctionUserData(nativeContext);
        if (state == null || (*state).TypeName == null || (*state).Marker == null)
        {
            ResultNull(nativeContext);
            return;
        }

        stack SQLitePointerDestructor destroy = MarkPointerDestroyed;
        ResultPointerWithDestructor(
            nativeContext,
            (rawmutptr<System.C.c_void>)(*state).Marker,
            *(*state).TypeName,
            destroy);
        return;
    }
}

unsafe ffi(c) fn void AuxDataWithDestructorCallback(
    rawmutptr<i8[min max]> context,
    i32[min max] argumentCount,
    rawmutptr<i8[min max]> values)
{
    unsafe
    {
        stack rawmutptr<SQLite3ContextNative> nativeContext = FunctionContext(context);
        stack rawmutptr<i32[min max]> marker = (rawmutptr<i32[min max]>)FunctionUserData(nativeContext);
        if (marker == null)
        {
            ResultInt(nativeContext, 0);
            return;
        }

        stack rawmutptr<System.C.c_void> existing = FunctionAuxData(nativeContext, 0);
        if (existing != null)
        {
            ResultInt(nativeContext, 2);
            return;
        }

        stack SQLitePointerDestructor destroy = MarkPointerDestroyed;
        SetFunctionAuxDataWithDestructor(nativeContext, 0, (rawmutptr<System.C.c_void>)marker, destroy);
        ResultInt(nativeContext, 1);
        return;
    }
}

