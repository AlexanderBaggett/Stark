unsafe ffi(c) fn System.C.c_int ReverseCollationCompare(
    rawmutptr<i8[min max]> data,
    System.C.c_int leftByteCount,
    rawptr<System.C.c_void> leftText,
    System.C.c_int rightByteCount,
    rawptr<System.C.c_void> rightText)
{
    if (data != null)
    {
        unsafe
        {
            stack rawmutptr<SQLiteHookCounters> counters = (rawmutptr<SQLiteHookCounters>)data;
            (*counters).CollationCompared += 1;
        }
    }

    if (leftText == null || rightText == null)
    {
        return 0;
    }

    if (leftByteCount <= 0 && rightByteCount <= 0)
    {
        return 0;
    }

    if (leftByteCount <= 0)
    {
        return 1;
    }

    if (rightByteCount <= 0)
    {
        return -1;
    }

    unsafe
    {
        stack rawptr<u8[0 max]> leftBytes = (rawptr<u8[0 max]>)leftText;
        stack rawptr<u8[0 max]> rightBytes = (rawptr<u8[0 max]>)rightText;
        stack mut i32[min max] index = 0;
        while willexit (index < leftByteCount && index < rightByteCount)
        {
            stack u8[0 max] leftByte = *(&leftBytes[index]);
            stack u8[0 max] rightByte = *(&rightBytes[index]);
            if (leftByte < rightByte)
            {
                return 1;
            }

            if (leftByte > rightByte)
            {
                return -1;
            }

            index += 1;
        }
    }

    if (leftByteCount < rightByteCount)
    {
        return 1;
    }

    if (leftByteCount > rightByteCount)
    {
        return -1;
    }

    return 0;
}

