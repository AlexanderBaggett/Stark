struct SQLiteHookCounters
{
    i32[min max] Busy;
    i32[min max] Authorizer;
    i32[min max] Trace;
    i32[min max] Progress;
    i32[min max] Commit;
    i32[min max] Rollback;
    i32[min max] Update;
    i32[min max] Wal;
    i32[min max] Preupdate;
    i32[min max] PreupdateColumns;
    i32[min max] PreupdateDepth;
    i32[min max] PreupdateBlobWriteColumn;
    i64[min max] PreupdateInsertedId;
    i64[min max] PreupdateUpdatedOldValue;
    i64[min max] PreupdateUpdatedNewValue;
    i32[min max] AutovacuumDestroyed;
    i32[min max] CollationCompared;
    i32[min max] CollationDestroyed;
    i32[min max] CollationNeeded;
    i32[min max] CollationNeeded16;
    i32[min max] CollationNeededTextRepresentation;
    i32[min max] AggregateDestroyed;
    i32[min max] WindowDestroyed;
    i32[min max] Log;
    i32[min max] LogCode;
}

