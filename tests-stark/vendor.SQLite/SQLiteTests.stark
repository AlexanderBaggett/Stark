unsafe fn bool ByteViewResultEquals(SQLiteByteViewResult result, borrow u8[0 max][] expected)
{
    switch (result)
    {
        case SQLiteByteViewResult.Err(var error):
            return false;
        case SQLiteByteViewResult.Ok(var view):
            if (view.Length() != expected.Length)
            {
                return false;
            }

            if (expected.Length == 0)
            {
                return view.IsEmpty();
            }

            unsafe
            {
                stack rawptr<u8[0 max]> data = view.Data();
                if (data == null)
                {
                    return false;
                }

                stack mut u64[0 max] index = 0;
                while willexit (index < expected.Length)
                {
                    if (*(&data[index]) != expected[index])
                    {
                        return false;
                    }

                    index += 1;
                }
            }

            return true;
    }
}

unsafe fn i32[min max] ByteViewLengthOrNegative(SQLiteByteViewResult result)
{
    switch (result)
    {
        case SQLiteByteViewResult.Err(var error):
            return -1;
        case SQLiteByteViewResult.Ok(var view):
            return (i32[min max])view.Length();
    }
}

