import Vendor.Vulkan
module VulkanTests

[Fact]
fn bool MakeApiVersionPacksFields()
{
    stack ApiVersion version = new ApiVersion()
    {
        Raw = MakeApiVersion(0, 1, 4, 350)
    };

    return version.Variant() == 0
        && version.Major() == 1
        && version.Minor() == 4
        && version.Patch() == 350;
}

[Fact]
fn bool LoaderReportsInstanceVersion()
{
    switch (EnumerateInstanceVersion())
    {
        case VulkanVersionResult.Err(var error):
            return false;
        case VulkanVersionResult.Ok(var version):
            return version.Major() >= 1;
    }
}

[Fact]
fn bool LoaderReportsInstanceExtensionCount()
{
    switch (InstanceExtensionCount())
    {
        case VulkanCountResult.Err(var error):
            return false;
        case VulkanCountResult.Ok(var count):
            return true;
    }
}

[Fact]
fn bool LoaderFindsEnumerateInstanceVersionProc()
{
    switch (GlobalProcAvailable("vkEnumerateInstanceVersion"))
    {
        case VulkanBoolResult.Err(var error):
            return false;
        case VulkanBoolResult.Ok(var available):
            return available;
    }
}

[Fact]
fn bool GlobalDispatchReportsInstanceVersion()
{
    switch (LoadGlobalDispatch())
    {
        case VulkanGlobalDispatchResult.Err(var error):
            return false;
        case VulkanGlobalDispatchResult.Ok(var dispatch):
            switch (EnumerateInstanceVersion(dispatch))
            {
                case VulkanVersionResult.Err(var versionError):
                    return false;
                case VulkanVersionResult.Ok(var version):
                    return version.Major() >= 1;
            }
    }
}

[Fact]
fn bool GlobalDispatchReportsInstanceExtensionCount()
{
    switch (LoadGlobalDispatch())
    {
        case VulkanGlobalDispatchResult.Err(var error):
            return false;
        case VulkanGlobalDispatchResult.Ok(var dispatch):
            switch (InstanceExtensionCount(dispatch))
            {
                case VulkanCountResult.Err(var countError):
                    return false;
                case VulkanCountResult.Ok(var count):
                    return true;
            }
    }
}
