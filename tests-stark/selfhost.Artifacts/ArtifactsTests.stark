}

[Fact]
fn bool ExpressionSyntaxArtifactRendererShowsExpressionTree()
{
    stack ascii source = "value + 1 * other";
    switch (ParseExpressionSyntax(source))
    {
        case ParseResult<ExpressionSyntax>.Err(var parseError):
            return System.Testing.Fail("parse");
        case ParseResult<ExpressionSyntax>.Ok(var syntax):
            stack mut System.Text.OwnedAscii rendered = new();
            if (!MemoryStatusOk(AppendExpressionSyntaxArtifact(rendered, source, syntax)))
            {
                return System.Testing.Fail("render");
            }

            stack ascii text = rendered.View();
            return System.Text.Contains(text, "syntax expression\n")
                && System.Text.Contains(text, "  succeeded: true\n")
                && System.Text.Contains(text, "  root: ")
                && System.Text.Contains(text, "identifier token=0 text=value")
                && System.Text.Contains(text, "int-literal token=2 text=1")
                && System.Text.Contains(text, "binary token=1 text=+")
                && System.Text.Contains(text, "binary token=3 text=*")
                && System.Text.Contains(text, "  diagnostics: 0\n");
    }
}

[Fact]
fn bool TypedSemanticArtifactRenderersShowSymbolFacts()
{
    stack ascii source = raw"""
    module Demo
    public struct Box { i32[0 max] Count; }
    export fn i32[min max] main() { return 0; }
    static mut i32[0 max] Counter = 0;
    """;

    stack mut TokenStream stream = new();
    stack mut CompilationUnitHeader header = new();
    stack mut DeclarationList declarations = new();
    if (!BuildParsedCompilation(source, stream, header, declarations))
    {
        return System.Testing.Fail("parse");
    }

    stack mut TypedModuleSymbolTable moduleSymbols = new();
    switch (BuildTypedModuleSymbols(source, stream, header, declarations, ModuleOrigin.Source, 0))
    {
        case BindResult<TypedModuleSymbolTable>.Err(var moduleError):
            return System.Testing.Fail("module-symbols");
        case BindResult<TypedModuleSymbolTable>.Ok(var value):
            moduleSymbols = value;
    }

    stack mut TypedDeclarationSymbolTable declarationSymbols = new();
    switch (BuildTypedDeclarationSymbols(source, stream, declarations, moduleSymbols))
    {
        case BindResult<TypedDeclarationSymbolTable>.Err(var declarationError):
            return System.Testing.Fail("declaration-symbols");
        case BindResult<TypedDeclarationSymbolTable>.Ok(var value):
            declarationSymbols = value;
    }

    stack mut System.Text.OwnedAscii rendered = new();
    if (!MemoryStatusOk(AppendTypedModuleSymbolArtifact(rendered, source, stream, moduleSymbols)))
    {
        return System.Testing.Fail("render-module");
    }

    if (!MemoryStatusOk(AppendTypedDeclarationSymbolArtifact(rendered, source, stream, declarationSymbols)))
    {
        return System.Testing.Fail("render-declarations");
    }

    stack ascii text = rendered.View();
    return System.Text.Contains(text, "semantic typed-module-symbols\n")
        && System.Text.Contains(text, "  symbols: 3\n")
        && System.Text.Contains(text, "struct name=Box visibility=public")
        && System.Text.Contains(text, "function name=main visibility=export")
        && System.Text.Contains(text, "semantic typed-declaration-symbols\n")
        && System.Text.Contains(text, "  functions: 1\n")
        && System.Text.Contains(text, "  exports: 1\n")
        && System.Text.Contains(text, "value static name=Counter")
        && System.Text.Contains(text, "storage=static")
        && System.Text.Contains(text, "mutable=true");
}

[Fact]
fn bool TypedArtifactRenderersShowBackendTypeFacts()
{
    stack ascii source = raw"""
    module Demo
    unsafe fn i32[0 max] Fill(
        out rawmutptr<i8[min max]>[length] buffer,
        u64[1 16] length,
        borrow bool flag)
        where dead_on_return(buffer)
    {
        return 0;
    }

    const i32[0 max] Limit = 8;

    struct Box
    {
        i32[0 max] Count;
        ascii Name;
    }

    enum Packet
    {
        Data(u8[0 max]),
        Empty
    }
    """;

    stack mut TokenStream stream = new();
    stack mut CompilationUnitHeader header = new();
    stack mut DeclarationList declarations = new();
    if (!BuildParsedCompilation(source, stream, header, declarations))
    {
        return System.Testing.Fail("parse");
    }

    stack mut TypedFunctionSignatureTable signatures = new();
    switch (BuildTypedFunctionSignatures(source, stream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return System.Testing.Fail("signatures");
        case ParseResult<TypedFunctionSignatureTable>.Ok(var value):
            signatures = value;
    }

    stack mut TypedGlobalDeclarationTable globals = new();
    switch (BuildTypedGlobalDeclarations(source, stream, declarations))
    {
        case ParseResult<TypedGlobalDeclarationTable>.Err(var globalError):
            return System.Testing.Fail("globals");
        case ParseResult<TypedGlobalDeclarationTable>.Ok(var value):
            globals = value;
    }

    stack mut TypedFieldDeclarationTable fields = new();
    switch (BuildTypedStructRecordFields(source, stream, declarations))
    {
        case ParseResult<TypedFieldDeclarationTable>.Err(var fieldError):
            return System.Testing.Fail("fields");
        case ParseResult<TypedFieldDeclarationTable>.Ok(var value):
            fields = value;
    }

    stack mut TypedEnumPayloadTable payloads = new();
    switch (BuildTypedEnumPayloads(source, stream, declarations))
    {
        case ParseResult<TypedEnumPayloadTable>.Err(var payloadError):
            return System.Testing.Fail("payloads");
        case ParseResult<TypedEnumPayloadTable>.Ok(var value):
            payloads = value;
    }

    stack mut TypedEnumLayoutTable layouts = new();
    switch (BuildTypedEnumLayouts(source, stream, declarations))
    {
        case ParseResult<TypedEnumLayoutTable>.Err(var layoutError):
            return System.Testing.Fail("layouts");
        case ParseResult<TypedEnumLayoutTable>.Ok(var value):
            layouts = value;
    }

    stack mut System.Text.OwnedAscii rendered = new();
    if (!MemoryStatusOk(AppendTypedFunctionSignatureArtifact(rendered, source, stream, signatures)))
    {
        return System.Testing.Fail("render-signatures");
    }

    if (!MemoryStatusOk(AppendTypedGlobalDeclarationArtifact(rendered, source, stream, globals)))
    {
        return System.Testing.Fail("render-globals");
    }

    if (!MemoryStatusOk(AppendTypedFieldDeclarationArtifact(rendered, source, stream, fields)))
    {
        return System.Testing.Fail("render-fields");
    }

    if (!MemoryStatusOk(AppendTypedEnumPayloadArtifact(rendered, source, stream, payloads)))
    {
        return System.Testing.Fail("render-payloads");
    }

    if (!MemoryStatusOk(AppendTypedEnumLayoutArtifact(rendered, source, stream, layouts)))
    {
        return System.Testing.Fail("render-layouts");
    }

    stack ascii text = rendered.View();
    return System.Text.Contains(text, "type function-signatures\n")
        && System.Text.Contains(text, "  signatures: 1\n")
        && System.Text.Contains(text, "type=raw-pointer")
        && System.Text.Contains(text, "counted=true")
        && System.Text.Contains(text, "dead-on-return=true")
        && System.Text.Contains(text, "type global-declarations\n")
        && System.Text.Contains(text, "const storage=const name=Limit")
        && System.Text.Contains(text, "type field-declarations\n")
        && System.Text.Contains(text, "owner=Box")
        && System.Text.Contains(text, "name=Count")
        && System.Text.Contains(text, "type enum-payloads\n")
        && System.Text.Contains(text, "variant=Data")
        && System.Text.Contains(text, "payload-kind=positional")
        && System.Text.Contains(text, "type enum-layouts\n")
        && System.Text.Contains(text, "concrete=true");
}

[Fact]
fn bool MirAndSsaArtifactRenderersShowBackendRowsAndFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack MirValueId param = MirParam(instructions, 0);
    stack MirValueId one = MirConstIntTyped(instructions, MirType.I32, 1);
    stack MirValueId sum = MirAddTyped(instructions, MirType.I32, param, one);
    stack MirValueId ret = MirReturn(instructions, sum);

    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId entry = MirReturnBlock(blocks, sum);

    stack mut IrTable<MirFunction> functions = new();
    stack MirFuncId fnId = MirDefineFunction(functions, entry, entry, 1, param, 4);

    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts sumFacts = new();
    sumFacts.SetAlignment(4);
    sumFacts.MarkNoAlias();
    sumFacts.SetIntegerRange(1, 65);
    if (!RecordGeneratedValueFactsForMirValue(facts, sum, sumFacts))
    {
        return System.Testing.Fail("facts");
    }

    stack mut System.Text.OwnedAscii rendered = new();
    if (!MemoryStatusOk(AppendMirArtifact(rendered, instructions, blocks, functions)))
    {
        return System.Testing.Fail("render-mir");
    }

    if (!MemoryStatusOk(AppendSsaValueFactsArtifact(rendered, facts)))
    {
        return System.Testing.Fail("render-facts");
    }

    stack ascii text = rendered.View();
    return System.Text.Contains(text, "mir instructions\n")
        && System.Text.Contains(text, "  instructions: 4\n")
        && System.Text.Contains(text, "1: param type=i64 a=0 b=0 c=0 d=0 imm=0")
        && System.Text.Contains(text, "2: const-int type=i32 a=0 b=0 c=0 d=0 imm=1")
        && System.Text.Contains(text, "3: add type=i32 a=1 b=2 c=0 d=0 imm=0")
        && System.Text.Contains(text, "4: return type=i64 a=3 b=0 c=0 d=0 imm=0")
        && System.Text.Contains(text, "mir blocks\n")
        && System.Text.Contains(text, "1: return slot0=3 slot1=0 slot2=0")
        && System.Text.Contains(text, "mir functions\n")
        && System.Text.Contains(text, "1: entry=1 blocks=1+1 instructions=1+4")
        && System.Text.Contains(text, "ssa value-facts\n")
        && System.Text.Contains(text, "3: align-present=true align=4")
        && System.Text.Contains(text, "noalias=true")
        && System.Text.Contains(text, "range-present=true range=1..65");
}

[Fact]
fn bool LlvmAndPackageArtifactRenderersDelegateToCanonicalEmitters()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack MirValueId one = MirConstInt(instructions, 1);
    stack MirValueId ret = MirReturn(instructions, one);

    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId entry = MirReturnBlock(blocks, one);

    stack mut IrTable<MirFunction> functions = new();
    stack MirFuncId fnId = MirDefineFunction(functions, entry, entry, 1, one, 2);

    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] globalId = MirDefineGlobal(globals, 7);

    stack mut IrTable<u8[0 max]> packageImage = new();
    SerializePackageImage(instructions, blocks, functions, globals, packageImage);

    stack mut System.Text.OwnedAscii rendered = new();
    if (!MemoryStatusOk(AppendLlvmModuleArtifact(rendered, instructions, blocks, functions, globals)))
    {
        return System.Testing.Fail("render-llvm");
    }

    if (!MemoryStatusOk(AppendPackageImageArtifact(rendered, packageImage)))
    {
        return System.Testing.Fail("render-package");
    }

    stack ascii text = rendered.View();
    return System.Text.Contains(text, "llvm module\n")
        && System.Text.Contains(text, "@g1 = global i64 7\n")
        && System.Text.Contains(text, "define i64 @f1()")
        && System.Text.Contains(text, "ret i64 %v1")
        && System.Text.Contains(text, "package image\n")
        && System.Text.Contains(text, "2 instructions, 1 blocks, 1 functions, 1 globals");
}
