[Fact]
fn bool RepeatUnicodeCharRejectsInvalidScalar()
{
    stack mut OwnedUnicode result = new();
    stack System.Memory.MemoryStatus s = RepeatUnicodeChar(result, 1114112, (u64[0 2 ** 63 - 1])3);
    return IsErr(s);
