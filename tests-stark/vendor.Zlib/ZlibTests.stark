import System.Testing
import Vendor.Zlib
module ZlibTests

fn bool SamePrefix(
    borrow i8[min max][] left,
    borrow i8[min max][] right,
    u64[0 2 ** 63 - 1] count)
{
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (left[index] != right[index])
        {
            return false;
        }
    }

    return true;
}

[Fact]
fn bool BlockRoundTripRestoresOriginalBytes()
{
    stack mut i8[min max][24] source =
    {
        1, 2, 3, 4, 1, 2, 3, 4,
        5, 6, 7, 8, 5, 6, 7, 8,
        9, 9, 9, 9, 10, 10, 10, 10
    };
    stack mut i8[min max][96] compressed = { 0 };
    stack mut i8[min max][24] restored = { 0 };
    stack i8[min max][] sourceBytes = source;
    stack mut i8[min max][] compressedBuffer = compressed;
    stack mut i8[min max][] restoredBuffer = restored;

    stack mut u32[0 max] compressedLength = 0;
    switch (CompressBlock(sourceBytes, compressedBuffer, CompressionLevel.Level(6)))
    {
        case ZlibBlockResult.Err(var error):
            return false;
        case ZlibBlockResult.Ok(var written):
            compressedLength = written;
    }

    switch (DecompressBlockPrefix(compressedBuffer, compressedLength, restoredBuffer))
    {
        case ZlibBlockResult.Err(var error):
            return false;
        case ZlibBlockResult.Ok(var restoredLength):
            return (u64[0 2 ** 63 - 1])restoredLength == sourceBytes.Length
                && SamePrefix(sourceBytes, restoredBuffer, sourceBytes.Length);
    }
}

[Fact]
fn bool StreamingRoundTripRestoresOriginalBytes()
{
    stack mut i8[min max][24] source =
    {
        42, 42, 42, 42, 21, 21, 21, 21,
        11, 12, 13, 14, 11, 12, 13, 14,
        1, 3, 5, 7, 9, 11, 13, 15
    };
    stack mut i8[min max][96] compressed = { 0 };
    stack mut i8[min max][24] restored = { 0 };
    stack i8[min max][] sourceBytes = source;
    stack mut i8[min max][] compressedBuffer = compressed;
    stack mut i8[min max][] restoredBuffer = restored;

    stack mut DeflateStream encoder = new();
    switch (StartDeflate(CompressionLevel.BestSpeed))
    {
        case DeflateStreamResult.Err(var error):
            return false;
        case DeflateStreamResult.Ok(var stream):
            encoder = stream;
    }

    stack mut u32[0 max] compressedLength = 0;
    switch (DeflateChunk(encoder, sourceBytes, (u32[0 max])sourceBytes.Length, compressedBuffer, ZlibFlush.Finish))
    {
        case ZlibStreamStepResult.Err(var error):
            CloseDeflate(encoder);
            return false;
        case ZlibStreamStepResult.Ok(var step):
            if (!step.Finished || (u64[0 2 ** 63 - 1])step.Consumed != sourceBytes.Length)
            {
                CloseDeflate(encoder);
                return false;
            }

            compressedLength = step.Produced;
    }

    if (CloseDeflate(encoder) != ZlibStatusResult.Ok)
    {
        return false;
    }

    stack mut InflateStream decoder = new();
    switch (StartInflate())
    {
        case InflateStreamResult.Err(var error):
            return false;
        case InflateStreamResult.Ok(var stream):
            decoder = stream;
    }

    switch (InflateChunk(decoder, compressedBuffer, compressedLength, restoredBuffer, ZlibFlush.Finish))
    {
        case ZlibStreamStepResult.Err(var error):
            CloseInflate(decoder);
            return false;
        case ZlibStreamStepResult.Ok(var step):
            if (!step.Finished
                || step.Consumed != compressedLength
                || (u64[0 2 ** 63 - 1])step.Produced != sourceBytes.Length)
            {
                CloseInflate(decoder);
                return false;
            }
    }

    if (CloseInflate(decoder) != ZlibStatusResult.Ok)
    {
        return false;
    }

    return SamePrefix(sourceBytes, restoredBuffer, sourceBytes.Length);
}

[Fact]
fn bool MaxCompressedSizeRejectsOversizedInput()
{
    switch (MaxCompressedSize((u64[0 2 ** 63 - 1])ZlibMaxOneShotInputSize + 1))
    {
        case ZlibBlockResult.Ok(var value):
            return false;
        case ZlibBlockResult.Err(var error):
            return error == ZlibError.SourceTooLarge;
    }
}
