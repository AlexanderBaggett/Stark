}

[Fact]
fn bool ResolvedVariantPayloadTypesBindCleanly()
{
    // Payload types across all three forms resolve (`Bar` declared); the built-in
    // payloads and bare variant are not checked — no diagnostics.
    stack ascii source = "struct Bar { }\nenum E { A(Bar, i32), B { f: Bar }, C from Bar, None }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool GenericEnumPayloadParameterIsNotUnresolved()
{
    // A payload type naming the enum's own generic parameter (`T`) is not an
    // unresolved type; only the genuinely undeclared `Missing` is flagged.
    stack ascii source = "enum Opt<T> { Some(T), Wrapped(Missing), None }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.UnresolvedType) == 1
                && diags.Count() == 1;
    }
}

[Fact]
fn bool GenericUseSiteFactsCaptureNestedTypeAndComptimeArguments()
{
    stack ascii source = "struct Box<T> { }\nstruct Pair<T, comptime u8[1 8] N> { }\nfn Pair<Box<i32[min max]>, comptime N> make<T, comptime u8[1 8] N>(Box<T> input, Pair<T, comptime N> other) where T: Box<i32[min max]> { stack Pair<T, comptime N> local; }\n";
    stack mut TokenStream stream = new();
    stack mut GenericUseSiteTable facts = new();
    if (!BuildGenericFacts(source, stream, facts))
    {
        return false;
    }

    stack ascii firstOwner = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])facts.OwnerTokenAt(0));
    stack ascii secondOwner = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])facts.OwnerTokenAt(1));
    return facts.Count() == 6
        && facts.TotalTypeArgumentCount() == 6
        && facts.TotalComptimeValueArgumentCount() == 3
        && facts.ArgumentCountAt(0) == 2
        && facts.TypeArgumentCountAt(0) == 1
        && facts.ComptimeValueArgumentCountAt(0) == 1
        && facts.ArgumentKindAt(0, 0) == GenericUseSiteArgumentKind.Type
        && facts.ArgumentKindAt(0, 1) == GenericUseSiteArgumentKind.ComptimeValue
        && System.Text.Equals(firstOwner, "Pair")
        && System.Text.Equals(secondOwner, "Box");
}

[Fact]
fn bool GenericUseSiteFactsClassifySignedIntegerValueArgument()
{
    stack ascii source = "struct Fixed<comptime i32[min max] N> { }\nfn Fixed<-1> f() { }\n";
    stack mut TokenStream stream = new();
    stack mut GenericUseSiteTable facts = new();
    if (!BuildGenericFacts(source, stream, facts))
    {
        return false;
    }

    stack u32[0 max] valueStart = facts.ArgumentStartTokenAt(0, 0);
    return facts.Count() == 1
        && facts.ArgumentCountAt(0) == 1
        && facts.TypeArgumentCountAt(0) == 0
        && facts.ComptimeValueArgumentCountAt(0) == 1
        && facts.ArgumentKindAt(0, 0) == GenericUseSiteArgumentKind.ComptimeValue
        && stream.KindAt((u64[0 2 ** 63 - 1])valueStart) == TokenKind.Minus;
}

[Fact]
fn bool GenericUseSiteFactsCaptureTraitBaseArguments()
{
    stack ascii source = "trait Tagged<T, comptime u8[1 8] N> { }\nstruct Widget : Tagged<i32[min max], 4> { }\n";
    stack mut TokenStream stream = new();
    stack mut GenericUseSiteTable facts = new();
    if (!BuildGenericFacts(source, stream, facts))
    {
        return false;
    }

    stack ascii owner = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])facts.OwnerTokenAt(0));
    return facts.Count() == 1
        && System.Text.Equals(owner, "Tagged")
        && facts.ArgumentCountAt(0) == 2
        && facts.TypeArgumentCountAt(0) == 1
        && facts.ComptimeValueArgumentCountAt(0) == 1
        && facts.ArgumentKindAt(0, 0) == GenericUseSiteArgumentKind.Type
        && facts.ArgumentKindAt(0, 1) == GenericUseSiteArgumentKind.ComptimeValue;
}

[Fact]
fn bool TypedGenericInstantiationPlansResolveDeclarationTargetsAndOpenArguments()
{
    stack ascii source = "struct Box<T> { }\nstruct Pair<T, comptime u8[1 8] N> { }\nfn Pair<Box<i32[min max]>, comptime N> make<T, comptime u8[1 8] N>(Box<T> input) { stack Pair<T, comptime N> local; }\n";
    stack mut TokenStream stream = new();
    stack mut TypedGenericInstantiationPlanTable plans = new();
    if (!BuildTypedGenericInstantiationPlansForSource(source, stream, plans))
    {
        return false;
    }

    stack u32[0 max] pairSlot = TypedGenericInstantiationPlanIndexByTargetShape(plans, source, stream, "Pair", 1, 1, true);
    stack u32[0 max] boxConcreteSlot = TypedGenericInstantiationPlanIndexByTargetShape(plans, source, stream, "Box", 1, 0, false);
    stack u32[0 max] boxOpenSlot = TypedGenericInstantiationPlanIndexByTargetShape(plans, source, stream, "Box", 1, 0, true);
    if (pairSlot == 0 || boxConcreteSlot == 0 || boxOpenSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] pairIndex = (u64[0 2 ** 63 - 1])(pairSlot - 1);
    stack u64[0 2 ** 63 - 1] boxConcreteIndex = (u64[0 2 ** 63 - 1])(boxConcreteSlot - 1);
    stack u64[0 2 ** 63 - 1] boxOpenIndex = (u64[0 2 ** 63 - 1])(boxOpenSlot - 1);
    return plans.Count() == 4
        && plans.TargetKindAt(pairIndex) == TypedGenericInstantiationTargetKind.Declaration
        && plans.TargetDeclarationSymbolIndexPlusOneAt(pairIndex) != 0
        && plans.ExpectedTypeParameterCountAt(pairIndex) == 1
        && plans.ExpectedComptimeParameterCountAt(pairIndex) == 1
        && plans.ArityMatchesAt(pairIndex)
        && plans.ContainsOpenGenericArgumentsAt(pairIndex)
        && !plans.DirectlyMaterializableAt(pairIndex)
        && plans.ArgumentKindAt(pairIndex, 1) == GenericUseSiteArgumentKind.ComptimeValue
        && plans.ArgumentGenericParameterSymbolIndexPlusOneAt(pairIndex, 1) != 0
        && plans.ArgumentHasNestedGenericAt(pairIndex, 0)
        && plans.DirectlyMaterializableAt(boxConcreteIndex)
        && !plans.ContainsOpenGenericArgumentsAt(boxConcreteIndex)
        && plans.ArgumentIsOpenGenericAt(boxOpenIndex, 0)
        && !plans.DirectlyMaterializableAt(boxOpenIndex);
}

[Fact]
fn bool TypedGenericInstantiationPlansDetectTargetArityMismatches()
{
    stack ascii source = "struct Pair<T, U> { }\nfn Pair<i32[min max]> make() { }\n";
    stack mut TokenStream stream = new();
    stack mut TypedGenericInstantiationPlanTable plans = new();
    if (!BuildTypedGenericInstantiationPlansForSource(source, stream, plans))
    {
        return false;
    }

    stack u32[0 max] pairSlot = TypedGenericInstantiationPlanIndexByTargetShape(plans, source, stream, "Pair", 1, 0, false);
    if (pairSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] pairIndex = (u64[0 2 ** 63 - 1])(pairSlot - 1);
    return plans.Count() == 1
        && plans.TargetResolvedAt(pairIndex)
        && plans.TargetIsGenericAt(pairIndex)
        && !plans.ArityMatchesAt(pairIndex)
        && !plans.DirectlyMaterializableAt(pairIndex)
        && !plans.HasUnresolvedArgumentsAt(pairIndex)
        && plans.ExpectedTypeParameterCountAt(pairIndex) == 2
        && plans.ExpectedComptimeParameterCountAt(pairIndex) == 0;
}

[Fact]
fn bool TypedGenericInstantiationPlansCaptureTraitBaseTargets()
{
    stack ascii source = "trait Tagged<T, comptime u8[1 8] N> { }\nstruct Widget : Tagged<i32[min max], 4> { }\n";
    stack mut TokenStream stream = new();
    stack mut TypedGenericInstantiationPlanTable plans = new();
    if (!BuildTypedGenericInstantiationPlansForSource(source, stream, plans))
    {
        return false;
    }

    stack u32[0 max] taggedSlot = TypedGenericInstantiationPlanIndexByTargetShape(plans, source, stream, "Tagged", 1, 1, false);
    if (taggedSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] taggedIndex = (u64[0 2 ** 63 - 1])(taggedSlot - 1);
    return plans.Count() == 1
        && plans.TargetKindAt(taggedIndex) == TypedGenericInstantiationTargetKind.Declaration
        && plans.TargetDeclarationSymbolIndexPlusOneAt(taggedIndex) != 0
        && plans.ExpectedTypeParameterCountAt(taggedIndex) == 1
        && plans.ExpectedComptimeParameterCountAt(taggedIndex) == 1
        && plans.ArityMatchesAt(taggedIndex)
        && plans.DirectlyMaterializableAt(taggedIndex)
        && !plans.ContainsOpenGenericArgumentsAt(taggedIndex);
}

[Fact]
fn bool TypedFunctionEffectSummariesCaptureDeclarationBackendFacts()
{
    stack ascii source = "fn void Plain() { }\nexport fn void Exported() { }\nfinite law void Law(ascii text) { }\ntail finite law inline hot fn i32[min max] TailHot(i32[min max] value) { return value; }\nstrictfp noinline finite law f32 Precise(f32 value) { return value; }\nunsafe ffi(c) varargs fn i32[min max] Native(rawptr<i8[min max]> data);\n[Backend(Opaque)]\ninline fn void Opaque() { }\nasm fn void Fence();\nstruct Box { finite law i32[min max] Method(borrow Box self) { return 1; } }\n";
    stack mut TokenStream stream = new();
    stack mut TypedFunctionEffectSummaryTable summaries = new();
    if (!BuildTypedFunctionEffectSummariesForSource(source, stream, summaries))
    {
        return false;
    }

    stack u32[0 max] plainSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Plain");
    stack u32[0 max] exportedSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Exported");
    stack u32[0 max] lawSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Law");
    stack u32[0 max] tailHotSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "TailHot");
    stack u32[0 max] preciseSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Precise");
    stack u32[0 max] nativeSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Native");
    stack u32[0 max] opaqueSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Opaque");
    stack u32[0 max] fenceSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Fence");
    stack u32[0 max] methodSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Method");
    if (plainSlot == 0 || exportedSlot == 0 || lawSlot == 0 || tailHotSlot == 0 || preciseSlot == 0
        || nativeSlot == 0 || opaqueSlot == 0 || fenceSlot == 0 || methodSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] plain = (u64[0 2 ** 63 - 1])(plainSlot - 1);
    stack u64[0 2 ** 63 - 1] exported = (u64[0 2 ** 63 - 1])(exportedSlot - 1);
    stack u64[0 2 ** 63 - 1] lawIndex = (u64[0 2 ** 63 - 1])(lawSlot - 1);
    stack u64[0 2 ** 63 - 1] tailHot = (u64[0 2 ** 63 - 1])(tailHotSlot - 1);
    stack u64[0 2 ** 63 - 1] precise = (u64[0 2 ** 63 - 1])(preciseSlot - 1);
    stack u64[0 2 ** 63 - 1] native = (u64[0 2 ** 63 - 1])(nativeSlot - 1);
    stack u64[0 2 ** 63 - 1] opaque = (u64[0 2 ** 63 - 1])(opaqueSlot - 1);
    stack u64[0 2 ** 63 - 1] fence = (u64[0 2 ** 63 - 1])(fenceSlot - 1);
    stack u64[0 2 ** 63 - 1] method = (u64[0 2 ** 63 - 1])(methodSlot - 1);
    return summaries.Count() == 9
        && summaries.OwnerKindAt(plain) == TypedFunctionEffectOwnerKind.Declaration
        && summaries.HasBodyAt(plain)
        && summaries.NoUnwindAt(plain)
        && summaries.UseFastCallingConventionAt(plain)
        && summaries.InlinePreferenceAt(plain) == TypedFunctionInlinePreference.InlineHint
        && !summaries.UseFastCallingConventionAt(exported)
        && summaries.FunctionKindAt(lawIndex) == TypedDeclarationFunctionKind.FiniteLaw
        && summaries.IsPureAt(lawIndex)
        && summaries.NoSyncAt(lawIndex)
        && summaries.NoFreeAt(lawIndex)
        && summaries.WillReturnAt(lawIndex)
        && summaries.MustProgressAt(lawIndex)
        && summaries.ReadsArgumentMemoryAt(lawIndex)
        && summaries.IsTailCallableAt(tailHot)
        && summaries.IsHotAt(tailHot)
        && summaries.InlinePreferenceAt(tailHot) == TypedFunctionInlinePreference.Inline
        && summaries.IsStrictFpAt(precise)
        && summaries.InlinePreferenceAt(precise) == TypedFunctionInlinePreference.NoInline
        && summaries.IsFfiAt(native)
        && summaries.IsVarargsAt(native)
        && !summaries.HasBodyAt(native)
        && !summaries.UseFastCallingConventionAt(native)
        && summaries.BackendOptimizationModeAt(opaque) == TypedFunctionBackendOptimizationMode.Opaque
        && summaries.InlinePreferenceAt(opaque) == TypedFunctionInlinePreference.NoInline
        && summaries.IsAsmAt(fence)
        && summaries.IsFfiAt(fence)
        && !summaries.WillReturnAt(fence)
        && !summaries.MustProgressAt(fence)
        && summaries.OwnerKindAt(method) == TypedFunctionEffectOwnerKind.MemberMethod
        && summaries.IsPureAt(method)
        && summaries.ReadsArgumentMemoryAt(method);
}

[Fact]
fn bool TypedFunctionEffectSummariesCaptureNoRecurseFacts()
{
    stack ascii source = "fn i32 Leaf(i32 value) { return value; }\nfn i32 Caller(i32 value) { return Leaf(value); }\nfn i32 SelfRecursive(i32 value) { return SelfRecursive(value); }\nfn i32 MutualA(i32 value) { return MutualB(value); }\nfn i32 MutualB(i32 value) { return MutualA(value); }\nfn i32 CallsCallback(fnptr<fn i32(i32)> cb, i32 value) { return cb(value); }\n";
    stack mut TokenStream stream = new();
    stack mut TypedFunctionEffectSummaryTable summaries = new();
    if (!BuildTypedFunctionEffectSummariesForSource(source, stream, summaries))
    {
        return false;
    }

    stack u32[0 max] leafSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Leaf");
    stack u32[0 max] callerSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Caller");
    stack u32[0 max] selfSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "SelfRecursive");
    stack u32[0 max] mutualASlot = TypedFunctionEffectIndexByName(summaries, source, stream, "MutualA");
    stack u32[0 max] mutualBSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "MutualB");
    stack u32[0 max] callbackSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "CallsCallback");
    if (leafSlot == 0 || callerSlot == 0 || selfSlot == 0 || mutualASlot == 0 || mutualBSlot == 0 || callbackSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] leaf = (u64[0 2 ** 63 - 1])(leafSlot - 1);
    stack u64[0 2 ** 63 - 1] caller = (u64[0 2 ** 63 - 1])(callerSlot - 1);
    stack u64[0 2 ** 63 - 1] selfRecursive = (u64[0 2 ** 63 - 1])(selfSlot - 1);
    stack u64[0 2 ** 63 - 1] mutualA = (u64[0 2 ** 63 - 1])(mutualASlot - 1);
    stack u64[0 2 ** 63 - 1] mutualB = (u64[0 2 ** 63 - 1])(mutualBSlot - 1);
    stack u64[0 2 ** 63 - 1] callback = (u64[0 2 ** 63 - 1])(callbackSlot - 1);
    return summaries.NoRecurseAt(leaf)
        && summaries.NoRecurseAt(caller)
        && !summaries.NoRecurseAt(selfRecursive)
        && !summaries.NoRecurseAt(mutualA)
        && !summaries.NoRecurseAt(mutualB)
        && !summaries.NoRecurseAt(callback);
}

[Fact]
fn bool TypedFunctionEffectSummariesCaptureBodyShape()
{
    stack ascii source = "struct Widget { }\nfn void Callee() { }\nfn void Work(i32[min max] input) { stack i32[min max] value = input; value = value + 1; if (value > 0) { value = value + 2; } while (value < 10) { value = value + 1; } Callee(); new Widget(); return; }\n";
    stack mut TokenStream stream = new();
    stack mut TypedFunctionEffectSummaryTable summaries = new();
    if (!BuildTypedFunctionEffectSummariesForSource(source, stream, summaries))
    {
        return false;
    }

    stack u32[0 max] workSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "Work");
    if (workSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] work = (u64[0 2 ** 63 - 1])(workSlot - 1);
    return summaries.HasBodyAt(work)
        && summaries.BodyOpenTokenAt(work) != 0
        && summaries.StatementCountAt(work) >= 7
        && summaries.TopLevelStatementCountAt(work) == 7
        && summaries.LocalDeclarationCountAt(work) == 1
        && summaries.AssignmentExpressionCountAt(work) >= 3
        && summaries.CallExpressionCountAt(work) == 1
        && summaries.NewExpressionCountAt(work) == 1
        && summaries.ReturnCountAt(work) == 1
        && summaries.LoopCountAt(work) == 1
        && summaries.BranchCountAt(work) == 1
        && summaries.BodyContainsAssignmentAt(work)
        && summaries.BodyContainsCallAt(work)
        && summaries.BodyContainsNewAt(work)
        && summaries.BodyContainsLoopAt(work)
        && summaries.BodyContainsBranchAt(work)
        && summaries.BodyContainsReturnAt(work);
}

[Fact]
fn bool TypedFunctionEffectSummariesCaptureOtherMemoryFacts()
{
    stack ascii source = "static i32[min max] Counter = 0;\nconst Limit = 7;\nstruct Box { }\nfn i32[min max] ReadCounter() { return Counter; }\nfn i32[min max] ReadConst() { return Limit; }\nfn void WriteCounter() { Counter = 1; return; }\nfn i32[min max] LocalOnly(i32[min max] value) { stack mut i32[min max] local = value; local = local + 1; return local; }\nfn void HeapLocal() { heap Box box = new Box(); return; }\nfn dynamic i32[min max] MakeDynamic() { return new(4); }\nfn bool ReserveDynamic(mut borrow dynamic i32[min max] values) { return values.TryReserve(4); }\nfn void ArenaDynamic() { stack dynamic i32[min max] values = new(arena, 4); return; }\n";
    stack mut TokenStream stream = new();
    stack mut TypedFunctionEffectSummaryTable summaries = new();
    if (!BuildTypedFunctionEffectSummariesForSource(source, stream, summaries))
    {
        return false;
    }

    stack u32[0 max] readSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "ReadCounter");
    stack u32[0 max] constSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "ReadConst");
    stack u32[0 max] writeSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "WriteCounter");
    stack u32[0 max] localSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "LocalOnly");
    stack u32[0 max] heapSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "HeapLocal");
    stack u32[0 max] makeSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "MakeDynamic");
    stack u32[0 max] reserveSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "ReserveDynamic");
    stack u32[0 max] arenaSlot = TypedFunctionEffectIndexByName(summaries, source, stream, "ArenaDynamic");
    if (readSlot == 0 || constSlot == 0 || writeSlot == 0 || localSlot == 0
        || heapSlot == 0 || makeSlot == 0 || reserveSlot == 0 || arenaSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] readIndex = (u64[0 2 ** 63 - 1])(readSlot - 1);
    stack u64[0 2 ** 63 - 1] constIndex = (u64[0 2 ** 63 - 1])(constSlot - 1);
    stack u64[0 2 ** 63 - 1] writeIndex = (u64[0 2 ** 63 - 1])(writeSlot - 1);
    stack u64[0 2 ** 63 - 1] localIndex = (u64[0 2 ** 63 - 1])(localSlot - 1);
    stack u64[0 2 ** 63 - 1] heapIndex = (u64[0 2 ** 63 - 1])(heapSlot - 1);
    stack u64[0 2 ** 63 - 1] makeIndex = (u64[0 2 ** 63 - 1])(makeSlot - 1);
    stack u64[0 2 ** 63 - 1] reserveIndex = (u64[0 2 ** 63 - 1])(reserveSlot - 1);
    stack u64[0 2 ** 63 - 1] arenaIndex = (u64[0 2 ** 63 - 1])(arenaSlot - 1);
    return summaries.ReadsOtherMemoryAt(readIndex)
        && !summaries.WritesOtherMemoryAt(readIndex)
        && !summaries.ReadsOtherMemoryAt(constIndex)
        && !summaries.WritesOtherMemoryAt(constIndex)
        && !summaries.ReadsOtherMemoryAt(writeIndex)
        && summaries.WritesOtherMemoryAt(writeIndex)
        && !summaries.ReadsOtherMemoryAt(localIndex)
        && !summaries.WritesOtherMemoryAt(localIndex)
        && summaries.ReadsOtherMemoryAt(heapIndex)
        && summaries.WritesOtherMemoryAt(heapIndex)
        && summaries.ReadsOtherMemoryAt(makeIndex)
        && summaries.WritesOtherMemoryAt(makeIndex)
        && summaries.ReadsOtherMemoryAt(reserveIndex)
        && summaries.WritesOtherMemoryAt(reserveIndex)
        && summaries.ReadsOtherMemoryAt(arenaIndex)
        && summaries.WritesOtherMemoryAt(arenaIndex);
}

[Fact]
fn bool FlagsBreakOutsideLoop()
{
    // A `break;` at function-body top level has no enclosing loop/switch.
    stack ascii source = "fn void f() { break; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.BreakOutsideLoop) == 1
                && diags.Count() == 1;
    }
}

[Fact]
fn bool FlagsContinueOutsideLoop()
{
    // A `continue;` at function-body top level has no enclosing loop.
    stack ascii source = "fn void f() { continue; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.ContinueOutsideLoop) == 1
                && diags.Count() == 1;
    }
}

[Fact]
fn bool AcceptsBreakInsideLoop()
{
    // `break` inside a `while` loop is well-formed.
    stack ascii source = "fn void f(bool c) { while (c) { break; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool ContinueInSwitchWithoutLoopIsFlagged()
{
    // `break` is allowed in a `switch`, but `continue` requires a LOOP — a switch
    // alone does not satisfy it. So `continue` in a non-loop switch is flagged,
    // while a `break` in the same switch is not.
    stack ascii source = "fn void f(i32 e) { switch (e) { case A: continue; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.ContinueOutsideLoop) == 1
                && diags.CountOf(BindDiagnosticCode.BreakOutsideLoop) == 0;
    }
}
