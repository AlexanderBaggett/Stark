        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool ForBodyLocalsAreNotDropped()
{
    // The for-header's `;` separators must not truncate the statement: the
    // for-init `i` is bound in the loop scope and the for body's two `x` locals
    // are recorded (three locals total) and the redefinition flagged.
    stack ascii source = "fn void f(u32 n) { for (stack mut u32 i = 0; i < n; i += 1) { stack u32 x = 0; stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 3
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool ForInitLocalResolvesInConditionAndBody()
{
    // The for-init `i` is bound in the loop scope, so the condition `i < n`
    // (boolean) and the body reference `i` both resolve — and `n` resolves to
    // the parameter. A clean loop produces no diagnostics.
    stack ascii source = "fn void f(u32 n) { for (stack mut u32 i = 0; i < n; i += 1) { i; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool FlagsNonBooleanForCondition()
{
    // A `for` whose middle clause is the bare `u32` parameter `n` is a non-boolean
    // condition — flagged like an `if`/`while` — while `i` and `n` still resolve.
    stack ascii source = "fn void f(u32 n) { for (stack mut u32 i = 0; n; i += 1) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.NonBooleanCondition) == 1
                && diags.Count() == 1;
    }
}

