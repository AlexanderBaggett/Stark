[Fact]
fn bool FlagsNonBooleanLogicalOperand()
{
    // `flag && n`: `flag` is bool (ok) but `n` is i32 — a non-boolean operand of
    // a logical operator. The `&&` result is still bool, so the condition itself
    // is fine: exactly one NonBooleanOperand and no NonBooleanCondition.
    stack ascii source = "fn void f(bool flag, i32 n) { if (flag && n) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.NonBooleanOperand) == 1
                && diags.CountOf(BindDiagnosticCode.NonBooleanCondition) == 0
                && diags.Count() == 1;
    }
}

