// TEMP PROBE helper: true iff ResolveReferences marks some `zzz` ref as Local.
fn bool BindResultResolvesZzzAsLocal(borrow FunctionScope scope, borrow DeclarationTable table, ascii source, borrow TokenStream stream, borrow StatementList body)
{
    switch (ResolveReferences(scope, table, source, stream, body))
    {
        case BindResult<ReferenceTable>.Err(var refError):
            return false;
        case BindResult<ReferenceTable>.Ok(var refs):
            return RefHasKind(refs, source, stream, "zzz", ReferenceKind.Local)
                && !RefHasKind(refs, source, stream, "zzz", ReferenceKind.Unbound);
    }
}

// Out-of-scope local: `zzz` is declared only inside the if-block (depth 1) and
// referenced at body depth 0, where its block has closed. Lexical resolution
// leaves the trailing `zzz` unbound (1 unresolved) and never binds it to the
// dead inner local.
[Fact]
fn bool ProbeOutOfScopeLocal()
{
    stack ascii source = "fn void f(i32 a) { if (a) { stack u32 zzz = 0; } zzz; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            // Correct lexical scoping: trailing `zzz` is unbound (1
                            // unresolved) and is NOT resolved to the dead inner local.
                            return CountUnresolvedReferences(scope, table, source, stream, body) == 1
                                && !BindResultResolvesZzzAsLocal(scope, table, source, stream, body);
                    }
            }
    }
}

// ADVERSARIAL VERIFICATION (temporary). Finding's EXACT input: two `x` locals
// Both `x` locals are directly under one `case A:` section (one section scope per
// grammar `switchSection: switchLabel+ statement*`), so the parser records 2
// locals and the same-block rule flags the redefinition.
[Fact]
fn bool SwitchSectionLocalRedefinitionIsFlagged()
{
    stack ascii source = "fn void f() { switch (e) { case A: stack u32 x = 0; stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

// The else-arm body is sub-parsed (not dropped), so both `x` locals in it are
// recorded and the same-block redefinition is flagged.
