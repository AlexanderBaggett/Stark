[Fact]
fn bool ResolvesSignatureTypes()
{
    // Return type `Foo` and parameter type `Bar` are both declared; `i32` is
    // built-in (head 0, skipped). No unresolved signature types.
    stack ascii source = "struct Foo { }\nstruct Bar { }\nfn Foo make(Bar a, i32 b) { }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            return CountUnresolvedSignatureTypes(signature, table, source, stream) == 0;
    }
}

[Fact]
fn bool FlagsUnresolvedLocalType()
{
    // The local `x` has the undeclared user type `Missing` — one UnresolvedType.
    // The built-in local `n` (u32) is not checked.
    stack ascii source = "fn void f() { stack Missing x; stack u32 n = 0; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.UnresolvedType) == 1
                && diags.Count() == 1;
    }
}

