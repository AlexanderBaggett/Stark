[Fact]
fn bool ValidAsmDeclarationBindsCleanly()
{
    stack mut BindDiagnosticList diags = new();
    if (!BindSource("unsafe ffi asm(x86_64) fn i64 Syscall2(i64 number, rawptr<i8[min max]> path) in(\"rax\") number, in(\"rdi\") path, out(\"rax\") return, clobber(\"rcx\", \"r11\") { \"syscall\" }\n", diags))
    {
        return false;
    }

    return diags.Count() == 0;
}

[Fact]
fn bool AsmDiagnosticsRejectUnknownArchitectureAndRegister()
{
    stack mut BindDiagnosticList diags = new();
    if (!BindSource("unsafe ffi asm(z80) fn i64 Bad(i64 number) in(\"notareg\") number, out(\"rax\") return { \"nop\" }\nunsafe ffi asm(x86_64) fn i64 AlsoBad(i64 number) in(\"notareg\") number, out(\"rax\") return { \"nop\" }\n", diags))
    {
        return false;
    }

    return diags.CountOf(BindDiagnosticCode.AsmUnknownArchitecture) == 1
        && diags.CountOf(BindDiagnosticCode.AsmInvalidRegister) == 1;
}

[Fact]
fn bool AsmDiagnosticsRequireValidOperandBindings()
{
    stack mut BindDiagnosticList diags = new();
    if (!BindSource("unsafe ffi asm(x86_64) fn i64 Bad(i64 number) in(\"rax\") missing { \"nop\" }\nunsafe ffi asm(x86_64) fn void VoidReturn(i64 number) in(\"rax\") number, out(\"rax\") return { \"nop\" }\n", diags))
    {
        return false;
    }

    return diags.CountOf(BindDiagnosticCode.AsmInvalidOperandBinding) == 3;
}

[Fact]
fn bool AsmDiagnosticsRejectDuplicateAndOverlappingClobbers()
{
    stack mut BindDiagnosticList diags = new();
    if (!BindSource("unsafe ffi asm(x86_64) fn i64 Bad(i64 number) in(\"rax\") number, out(\"rax\") return, clobber(\"rax\", \"rcx\", \"RCX\") { \"nop\" }\n", diags))
    {
        return false;
    }

    return diags.CountOf(BindDiagnosticCode.AsmInvalidClobber) == 2;
}

// Finds the keyword token of the sole function declaration in an already-lexed
// stream. False when the stream is not a single function.
fn bool FirstFunctionKeyword(borrow TokenStream stream, out u32[0 max] fnKeyword)
{
    fnKeyword = 0;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    return true;
                }
            }

            return false;
    }
}

[Fact]
fn bool BuildsFunctionScopeWithParamsAndLocals()
{
    stack ascii source = "fn void f(i32 a, i32 b) { stack u32 x = 0; stack u32 y = 1; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            // Two params + two locals, all resolvable; an unknown
                            // name does not resolve; no parameter clash or shadow.
                            return scope.Count() == 4
                                && LookupSymbol(scope, source, stream, "a") != 0
                                && LookupSymbol(scope, source, stream, "b") != 0
                                && LookupSymbol(scope, source, stream, "x") != 0
                                && LookupSymbol(scope, source, stream, "y") != 0
                                && LookupSymbol(scope, source, stream, "missing") == 0
                                && !HasDuplicateParameter(scope, source, stream)
                                && !LocalShadowsParameter(scope, source, stream);
                    }
            }
    }
}

[Fact]
fn bool DetectsDuplicateParameter()
{
    stack ascii source = "fn void f(i32 a, i32 a) { }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            // Both parameters are named `a` — a redefinition.
                            return scope.Count() == 2
                                && HasDuplicateParameter(scope, source, stream);
                    }
            }
    }
}

[Fact]
fn bool DetectsLocalShadowingParameter()
{
    stack ascii source = "fn void f(i32 count) { stack u32 count = 0; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            // The local `count` shadows the parameter `count`, and
                            // a name lookup resolves to the local (last declared).
                            return LocalShadowsParameter(scope, source, stream)
                                && !HasDuplicateParameter(scope, source, stream)
                                && LookupSymbol(scope, source, stream, "count") == 2
                                && scope.KindAt(1) == SymbolKind.Local;
                    }
            }
    }
}

[Fact]
fn bool DistinctDeclarationsHaveNoDuplicate()
{
    stack ascii source = "struct A { }\nstruct B { }\nfn void c() { }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var bindError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
