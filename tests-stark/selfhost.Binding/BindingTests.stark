            stack ascii actualSymbol = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.NameTokenAt(index));
            if (System.Text.Equals(actualOwner, ownerName) && System.Text.Equals(actualSymbol, symbolName))
