        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.UnresolvedReference) == 1
                && diags.Count() == 1;
    }
}

[Fact]
fn bool SwitchSubjectReferenceIsResolved()
{
    // The switch subject expression is parsed and resolved, so an undefined subject
