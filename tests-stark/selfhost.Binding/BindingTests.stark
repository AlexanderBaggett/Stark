[Fact]
fn bool ModuleResolverReportsDuplicateSourceAndAmbiguousImport()
{
    stack ascii mainSource = "import App.Core\nmodule App.Main\n";
    stack ascii coreSourceA = "module App.Core\nstruct A { }\n";
    stack ascii coreSourceB = "module App.Core\nstruct B { }\n";
    stack mut TokenStream mainStream = new();
    stack mut CompilationUnitHeader mainHeader = new();
    if (!ParseHeaderForBinding(mainSource, mainStream, mainHeader))
    {
        return false;
    }

    stack mut TokenStream coreStreamA = new();
    stack mut CompilationUnitHeader coreHeaderA = new();
    if (!ParseHeaderForBinding(coreSourceA, coreStreamA, coreHeaderA))
    {
        return false;
    }

    stack mut TokenStream coreStreamB = new();
    stack mut CompilationUnitHeader coreHeaderB = new();
    if (!ParseHeaderForBinding(coreSourceB, coreStreamB, coreHeaderB))
    {
        return false;
    }

    stack mut ModuleResolver resolver = new();
    stack mut BindDiagnosticList diags = new();
    if (!MemoryOk(AddSourceModule(resolver, mainSource, mainStream, mainHeader, 1, diags))
        || !MemoryOk(AddSourceModule(resolver, coreSourceA, coreStreamA, coreHeaderA, 2, diags))
        || !MemoryOk(AddSourceModule(resolver, coreSourceB, coreStreamB, coreHeaderB, 3, diags)))
    {
        return false;
    }

    stack mut ImportResolutionTable imports = new();
    if (!MemoryOk(ResolveImports(resolver, mainSource, mainStream, mainHeader, imports, diags)))
    {
        return false;
    }

    return imports.Count() == 1
        && imports.KindAt(0) == ImportResolutionKind.Ambiguous
        && diags.CountOf(BindDiagnosticCode.DuplicateModule) == 1
        && diags.CountOf(BindDiagnosticCode.AmbiguousImport) == 1
        && diags.Count() == 2;
}

[Fact]
fn bool ValidAsmDeclarationBindsCleanly()
{
    stack mut BindDiagnosticList diags = new();
    if (!BindSource("unsafe ffi asm(x86_64) fn i64 Syscall2(i64 number, rawptr<i8[min max]> path) in(\"rax\") number, in(\"rdi\") path, out(\"rax\") return, clobber(\"rcx\", \"r11\") { \"syscall\" }\n", diags))
    {
        return false;
    }

    return diags.Count() == 0;
}

[Fact]
fn bool AsmDiagnosticsRejectUnknownArchitectureAndRegister()
{
    stack mut BindDiagnosticList diags = new();
    if (!BindSource("unsafe ffi asm(z80) fn i64 Bad(i64 number) in(\"notareg\") number, out(\"rax\") return { \"nop\" }\nunsafe ffi asm(x86_64) fn i64 AlsoBad(i64 number) in(\"notareg\") number, out(\"rax\") return { \"nop\" }\n", diags))
    {
        return false;
    }

    return diags.CountOf(BindDiagnosticCode.AsmUnknownArchitecture) == 1
        && diags.CountOf(BindDiagnosticCode.AsmInvalidRegister) == 1;
}

[Fact]
fn bool AsmDiagnosticsRequireValidOperandBindings()
{
    stack mut BindDiagnosticList diags = new();
    if (!BindSource("unsafe ffi asm(x86_64) fn i64 Bad(i64 number) in(\"rax\") missing { \"nop\" }\nunsafe ffi asm(x86_64) fn void VoidReturn(i64 number) in(\"rax\") number, out(\"rax\") return { \"nop\" }\n", diags))
    {
        return false;
    }

    return diags.CountOf(BindDiagnosticCode.AsmInvalidOperandBinding) == 3;
}

[Fact]
fn bool AsmDiagnosticsRejectDuplicateAndOverlappingClobbers()
{
    stack mut BindDiagnosticList diags = new();
    if (!BindSource("unsafe ffi asm(x86_64) fn i64 Bad(i64 number) in(\"rax\") number, out(\"rax\") return, clobber(\"rax\", \"rcx\", \"RCX\") { \"nop\" }\n", diags))
    {
        return false;
    }

