        case ParseResult<DeclarationList>.Ok(var parsedDecls):
            decls = parsedDecls;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, parsedStream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var builtTable):
            table = builtTable;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordByNameForBinding(source, parsedStream, decls, functionName, fnKeyword))
    {
        return false;
    }

    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(parsedStream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(parsedStream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    stack mut FunctionScope scope = new();
    switch (BuildFunctionScope(signature, body))
    {
        case BindResult<FunctionScope>.Err(var scopeError):
            return false;
        case BindResult<FunctionScope>.Ok(var builtScope):
            scope = builtScope;
    }

    stack mut ReferenceTable refs = new();
    switch (ResolveReferences(scope, table, source, parsedStream, body))
    {
        case BindResult<ReferenceTable>.Err(var refError):
            return false;
        case BindResult<ReferenceTable>.Ok(var builtRefs):
            refs = builtRefs;
    }

    switch (BuildReceiverCandidateSets(table, source, parsedStream, refs, scope, body))
    {
        case BindResult<ReceiverCandidateSetTable>.Err(var receiverError):
