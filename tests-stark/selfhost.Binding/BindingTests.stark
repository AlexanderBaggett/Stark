fn u32[0 max] TypedGenericParameterSymbolIndexByOwnerAndName(
    borrow TypedGenericParameterSymbolTable symbols,
    ascii source,
    borrow TokenStream stream,
    ascii ownerName,
    ascii symbolName,
    TypedGenericParameterKind symbolKind)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = symbols.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0 && symbols.KindAt(index) == symbolKind)
        {
            stack ascii actualOwner = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.OwnerNameTokenAt(index));
            stack ascii actualSymbol = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.NameTokenAt(index));
            if (System.Text.Equals(actualOwner, ownerName) && System.Text.Equals(actualSymbol, symbolName))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

fn u32[0 max] TypedTraitConformanceIndexByOwnerSubjectAndTrait(
    borrow TypedTraitConformanceTable table,
    ascii source,
    borrow TokenStream stream,
    ascii ownerName,
    ascii subjectName,
    ascii traitName,
    TypedTraitConformanceKind kind)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0 && table.KindAt(index) == kind)
        {
            stack ascii actualOwner = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.OwnerNameTokenAt(index));
            stack ascii actualSubject = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.SubjectNameTokenAt(index));
            stack ascii actualTrait = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.TraitNameTokenAt(index));
            if (System.Text.Equals(actualOwner, ownerName)
                && System.Text.Equals(actualSubject, subjectName)
                && System.Text.Equals(actualTrait, traitName))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

fn u32[0 max] TypedGenericInstantiationPlanIndexByTargetShape(
    borrow TypedGenericInstantiationPlanTable plans,
    ascii source,
    borrow TokenStream stream,
    ascii targetName,
    u32[0 max] typeArgumentCount,
    u32[0 max] comptimeArgumentCount,
    bool containsOpenGenericArguments)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = plans.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && plans.TypeArgumentCountAt(index) == typeArgumentCount
            && plans.ComptimeArgumentCountAt(index) == comptimeArgumentCount
            && plans.ContainsOpenGenericArgumentsAt(index) == containsOpenGenericArguments)
        {
            stack ascii actualTarget = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])plans.TargetNameTokenAt(index));
            if (System.Text.Equals(actualTarget, targetName))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

[Fact]
fn bool BuildsAndLooksUpDeclarations()
{
    stack ascii source = "struct Widget { }\nfn i32 compute() { }\nconst Limit = 5;\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var bindError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    // All three named declarations are recorded and resolvable by name; an
    // unknown name resolves to nothing, and no name collides.
    return table.Count() == 3
        && LookupDeclaration(table, source, stream, "Widget") != 0
        && LookupDeclaration(table, source, stream, "compute") != 0
        && LookupDeclaration(table, source, stream, "Limit") != 0
        && LookupDeclaration(table, source, stream, "Missing") == 0
        && !HasDuplicateDeclaration(table, source, stream);
}

[Fact]
fn bool DetectsDuplicateDeclaration()
{
    stack ascii source = "struct Foo { }\nstruct Foo { }\nfn void Foo() { }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var bindError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    // Three declarations all named `Foo` — a redefinition the binder flags.
    return table.Count() == 3
        && HasDuplicateDeclaration(table, source, stream)
        && LookupDeclaration(table, source, stream, "Foo") != 0;
}

