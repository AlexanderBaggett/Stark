    }

    return table.Count() == 3
        && !HasDuplicateDeclaration(table, source, stream);
}

[Fact]
fn bool ResolvesBodyReferences()
{
    // `a` (parameter) and `b` (local) both resolve, so the body has no unbound
    // references.
    stack ascii source = "fn void f(i32 a) { stack u32 b = 0; a + b; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem fnDecl = decls.ItemAt(0);
    if (fnDecl.Kind != DeclarationKind.Function)
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnDecl.KeywordToken))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnDecl.KeywordToken))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            return CountUnresolvedReferences(scope, table, source, stream, body) == 0;
                    }
            }
    }
}

[Fact]
fn bool FlagsUnboundReference()
{
    // `a` resolves (parameter) but `zzz` is bound nowhere — exactly one unbound
    // reference.
    stack ascii source = "fn void f(i32 a) { a + zzz; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem fnDecl = decls.ItemAt(0);
    if (fnDecl.Kind != DeclarationKind.Function)
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnDecl.KeywordToken))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnDecl.KeywordToken))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            return CountUnresolvedReferences(scope, table, source, stream, body) == 1;
                    }
            }
    }
}

// Finds the keyword token of the first function declaration in an already-lexed
// stream that may contain several declarations. False when there is none.
fn bool FunctionKeywordIn(borrow TokenStream stream, out u32[0 max] fnKeyword)
{
    fnKeyword = 0;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            stack mut bool found = false;
            stack u64[0 2 ** 63 - 1] count = decls.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
            {
                stack DeclItem item = decls.ItemAt(index);
                if (!found && item.Kind == DeclarationKind.Function)
                {
                    fnKeyword = item.KeywordToken;
                    found = true;
                }
            }

            return found;
    }
}

// Counts the `Local` statements in a parsed function body's flat statement list.
fn u64[0 2 ** 63 - 1] CountLocals(borrow StatementList body)
{
    stack mut u64[0 2 ** 63 - 1] locals = 0;
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] i = 0; i < count; i += 1)
    {
        stack StatementItem si = body.ItemAt(i);
        if (si.Kind == StatementKind.Local)
        {
            locals = (u64[0 2 ** 63 - 1])(locals + 1);
        }
    }

    return locals;
}

// True when some reference named `expectedName` resolved to `expectedKind`.
fn bool RefHasKind(borrow ReferenceTable refs, ascii source, borrow TokenStream stream, ascii expectedName, ReferenceKind expectedKind)
{
    stack mut bool matched = false;
    stack u64[0 2 ** 63 - 1] count = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (!matched)
        {
            stack ascii refName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])refs.NameTokenAt(index));
            if (System.Text.Equals(refName, expectedName) && refs.KindAt(index) == expectedKind)
            {
                matched = true;
            }
        }
    }

    return matched;
}

[Fact]
fn bool ResolvesReferencesByKind()
{
    // `a`→parameter, `b`→local, `G`→top-level declaration, `zzz`→unbound.
    stack ascii source = "const G = 5;\nfn void f(i32 a) { stack u32 b = 0; a + b + G + zzz; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            switch (ResolveReferences(scope, table, source, stream, body))
                            {
                                case BindResult<ReferenceTable>.Err(var refError):
                                    return false;
                                case BindResult<ReferenceTable>.Ok(var refs):
                                    return refs.Count() == 4
                                        && refs.UnboundCount() == 1
                                        && RefHasKind(refs, source, stream, "a", ReferenceKind.Parameter)
                                        && RefHasKind(refs, source, stream, "b", ReferenceKind.Local)
                                        && RefHasKind(refs, source, stream, "G", ReferenceKind.Declaration)
                                        && RefHasKind(refs, source, stream, "zzz", ReferenceKind.Unbound);
                            }
                    }
            }
    }
}

[Fact]
fn bool ResolvesShadowedReferenceToInnermostLocal()
{
    // `count` is both a parameter and a local; references resolve to the local
    // (the innermost binding, scope index 2), never the parameter.
    stack ascii source = "fn void f(i32 count) { stack u32 count = 0; count + count; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            switch (ResolveReferences(scope, table, source, stream, body))
                            {
                                case BindResult<ReferenceTable>.Err(var refError):
                                    return false;
                                case BindResult<ReferenceTable>.Ok(var refs):
                                    return refs.Count() == 2
                                        && refs.UnboundCount() == 0
                                        && refs.KindAt(0) == ReferenceKind.Local
                                        && refs.TargetAt(0) == 2
                                        && refs.KindAt(1) == ReferenceKind.Local
                                        && !RefHasKind(refs, source, stream, "count", ReferenceKind.Parameter);
                            }
                    }
            }
    }
}

[Fact]
fn bool ProbeSiblingBlockShadowTarget()
{
    // PROBE: `x` is referenced inside the FIRST if-block, where the only `x` in
    // scope is the first block's local (scope index 1). A second sibling block
    // declares another `x` (scope index 2) that is NOT in scope at the reference.
    // Correct (host/lexical) resolution: the reference's first (and only) result
    // is the FIRST-block local, target == 1. This probe records what the binder
    // actually computes for that reference's TargetAt.
    stack ascii source = "fn void f() { if (a) { stack u32 x = 0; x; } if (b) { stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            switch (ResolveReferences(scope, table, source, stream, body))
                            {
                                case BindResult<ReferenceTable>.Err(var refError):
                                    return false;
                                case BindResult<ReferenceTable>.Ok(var refs):
                                    // Find the `x` reference and report its target.
                                    // Two `x` locals exist in scope (indices 1,2).
                                    // Host says the in-block reference must resolve
                                    // to target 1. We assert that here: this FACT
                                    // FAILS if the binder picks 2 (the bug).
                                    stack mut u32[0 max] xTarget = 0;
                                    stack u64[0 2 ** 63 - 1] rcount = refs.Count();
                                    for willexit (stack mut u64[0 2 ** 63 - 1] i = 0; i < rcount; i += 1)
                                    {
                                        stack ascii rn = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])refs.NameTokenAt(i));
                                        if (System.Text.Equals(rn, "x"))
                                        {
                                            xTarget = refs.TargetAt(i);
                                        }
                                    }

                                    // Correct lexical resolution: the in-block `x`
                                    // reference binds to the FIRST block's local
                                    // (target 1); the sibling block's local (index 2)
                                    // is out of scope and never leaks in.
                                    return scope.Count() == 2
                                        && refs.Count() == 3
                                        && xTarget == 1;
                            }
                    }
            }
    }
}

[Fact]
fn bool DetectsSameBlockLocalRedefinition()
{
    // Two locals named `x` in the same block — a redefinition.
    stack ascii source = "fn void f() { stack u32 x = 0; stack u32 x = 1; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return HasDuplicateLocalInBlock(source, stream, body);
    }
}

