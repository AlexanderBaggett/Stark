[Fact]
fn bool DetectsSameBlockLocalRedefinitionInElseArm()
{
    // Both `x` locals are in the single `else` block (one scope per Stark.g4
    // `ifStatement` else branch), so the same-block rule flags the redefinition.
    stack ascii source = "fn void f() { if (c) { } else { stack u32 x = 0; stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool SameNameLocalsInThenAndElseArmsAreSeparate()
{
    // `x` in the then-arm and `x` in the else-arm are in DIFFERENT scopes, so this
    // is shadowing-style separation, not a redefinition.
    stack ascii source = "fn void f() { if (a) { stack u32 x = 0; } else { stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && !HasDuplicateLocalInBlock(source, stream, body);
    }
}

