    stack u32[0 max] bufferDrawableSlot = TypedTraitConformanceIndexByOwnerSubjectAndTrait(
        conformances,
        source,
        stream,
        "Buffer",
        "T",
        "Drawable",
        TypedTraitConformanceKind.GenericConstraint);
    stack u32[0 max] bufferHashableSlot = TypedTraitConformanceIndexByOwnerSubjectAndTrait(
        conformances,
        source,
        stream,
        "Buffer",
        "T",
        "Hashable",
        TypedTraitConformanceKind.GenericConstraint);
    stack u32[0 max] pickDrawableSlot = TypedTraitConformanceIndexByOwnerSubjectAndTrait(
        conformances,
        source,
        stream,
        "Pick",
        "T",
        "Drawable",
        TypedTraitConformanceKind.GenericConstraint);
    stack u32[0 max] mapMapperSlot = TypedTraitConformanceIndexByOwnerSubjectAndTrait(
        conformances,
        source,
        stream,
        "Map",
        "U",
        "Mapper",
        TypedTraitConformanceKind.GenericConstraint);
    if (bufferDrawableSlot == 0 || bufferHashableSlot == 0 || pickDrawableSlot == 0 || mapMapperSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] bufferDrawableIndex = (u64[0 2 ** 63 - 1])(bufferDrawableSlot - 1);
    stack u64[0 2 ** 63 - 1] bufferHashableIndex = (u64[0 2 ** 63 - 1])(bufferHashableSlot - 1);
    stack u64[0 2 ** 63 - 1] pickDrawableIndex = (u64[0 2 ** 63 - 1])(pickDrawableSlot - 1);
    stack u64[0 2 ** 63 - 1] mapMapperIndex = (u64[0 2 ** 63 - 1])(mapMapperSlot - 1);

    return conformances.Count() == 4
        && conformances.DeclarationBaseCount() == 0
        && conformances.GenericConstraintCount() == 4
        && conformances.SubjectIsGenericParameterAt(bufferDrawableIndex)
        && conformances.SubjectGenericParameterSymbolIndexPlusOneAt(bufferDrawableIndex) != 0
        && conformances.TraitResolvedAt(bufferDrawableIndex)
        && conformances.HasGenericTraitConstraint(
            conformances.SubjectGenericParameterSymbolIndexPlusOneAt(bufferDrawableIndex),
            conformances.TraitDeclarationSymbolIndexPlusOneAt(bufferDrawableIndex))
        && conformances.SubjectIsGenericParameterAt(bufferHashableIndex)
        && conformances.TraitResolvedAt(bufferHashableIndex)
        && conformances.SubjectGenericParameterSymbolIndexPlusOneAt(pickDrawableIndex) != 0
        && conformances.OwnerMemberSymbolIndexPlusOneAt(mapMapperIndex) != 0
        && conformances.SubjectGenericParameterSymbolIndexPlusOneAt(mapMapperIndex) != 0
        && conformances.TraitHasGenericArgumentsAt(mapMapperIndex)
        && conformances.TraitTypeArgumentCountAt(mapMapperIndex) == 1
        && conformances.TraitComptimeArgumentCountAt(mapMapperIndex) == 0
        && conformances.TraitStartTokenAt(mapMapperIndex) < conformances.TraitEndTokenAt(mapMapperIndex);
}

[Fact]
fn bool ModuleResolverAddsNamedSourceModule()
{
    stack ascii source = "module App.Main\n";
    stack mut TokenStream stream = new();
    stack mut CompilationUnitHeader header = new();
    if (!ParseHeaderForBinding(source, stream, header))
    {
        return Fail("module resolver parse header");
    }

    if (header.Count() != 1)
    {
        return Fail("module resolver header count");
    }

    stack HeaderItem item = header.ItemAt(0);
    if (item.Kind != SyntaxKind.ModuleDeclaration)
    {
        return Fail("module resolver header kind");
    }

    stack mut ModuleResolver resolver = new();
    stack mut BindDiagnosticList diags = new();
    if (!MemoryOk(AddSourceModule(resolver, source, stream, header, 42, diags)))
    {
        return Fail("module resolver add source memory");
    }

    if (diags.Count() != 0)
    {
        if (diags.CountOf(BindDiagnosticCode.MissingModuleDeclaration) != 0)
        {
            return Fail("module resolver add source missing module");
        }

        if (diags.CountOf(BindDiagnosticCode.DuplicateModule) != 0)
        {
            return Fail("module resolver add source duplicate module");
        }

        return Fail("module resolver add source diagnostics");
    }

    if (resolver.Count() != 1)
    {
        return Fail("module resolver add source count");
    }

    if (resolver.OriginAt(0) != ModuleOrigin.Source)
    {
        return Fail("module resolver add source origin");
    }

    if (resolver.OriginIndexAt(0) != 42)
    {
        return Fail("module resolver add source index");
    }

    if (!resolver.NameEqualsAt(0, "App.Main"))
    {
        return Fail("module resolver add source name");
    }

    return true;
}

[Fact]
fn bool ModuleResolverResolvesSourceAndPackageImports()
{
    stack ascii mainSource = "import App.Core\nimport Vendor.Raylib\nmodule App.Main\nfn void main() { }\n";
    stack ascii coreSource = "module App.Core\nstruct CoreType { }\n";
    stack mut TokenStream mainStream = new();
    stack mut CompilationUnitHeader mainHeader = new();
    if (!ParseHeaderForBinding(mainSource, mainStream, mainHeader))
    {
        return false;
    }

    stack mut TokenStream coreStream = new();
    stack mut CompilationUnitHeader coreHeader = new();
    if (!ParseHeaderForBinding(coreSource, coreStream, coreHeader))
    {
        return false;
    }

    stack mut ModuleResolver resolver = new();
    stack mut BindDiagnosticList diags = new();
    if (!MemoryOk(AddSourceModule(resolver, mainSource, mainStream, mainHeader, 1, diags))
        || !MemoryOk(AddSourceModule(resolver, coreSource, coreStream, coreHeader, 2, diags))
        || !MemoryOk(AddPackageModule(resolver, "Vendor.Raylib", 8, diags)))
    {
        return false;
    }

    stack mut ImportResolutionTable imports = new();
    if (!MemoryOk(ResolveImports(resolver, mainSource, mainStream, mainHeader, imports, diags)))
    {
        return false;
    }

    return diags.Count() == 0
        && imports.Count() == 2
        && imports.KindAt(0) == ImportResolutionKind.Source
        && imports.TargetIndexAt(0) == 2
        && imports.KindAt(1) == ImportResolutionKind.Package
        && imports.TargetIndexAt(1) == 8;
}

[Fact]
fn bool ModuleResolverPrefersSourceModuleOverPackageModule()
{
    stack ascii mainSource = "import App.Core\nmodule App.Main\n";
    stack ascii coreSource = "module App.Core\n";
    stack mut TokenStream mainStream = new();
    stack mut CompilationUnitHeader mainHeader = new();
    if (!ParseHeaderForBinding(mainSource, mainStream, mainHeader))
    {
        return false;
    }

    stack mut TokenStream coreStream = new();
    stack mut CompilationUnitHeader coreHeader = new();
    if (!ParseHeaderForBinding(coreSource, coreStream, coreHeader))
    {
        return false;
    }

    stack mut ModuleResolver resolver = new();
    stack mut BindDiagnosticList diags = new();
    if (!MemoryOk(AddPackageModule(resolver, "App.Core", 77, diags))
        || !MemoryOk(AddSourceModule(resolver, coreSource, coreStream, coreHeader, 2, diags))
        || !MemoryOk(AddSourceModule(resolver, mainSource, mainStream, mainHeader, 1, diags)))
    {
        return false;
    }

    stack mut ImportResolutionTable imports = new();
    if (!MemoryOk(ResolveImports(resolver, mainSource, mainStream, mainHeader, imports, diags)))
    {
        return false;
    }

    return diags.Count() == 0
        && imports.Count() == 1
        && imports.KindAt(0) == ImportResolutionKind.Source
        && imports.TargetIndexAt(0) == 2;
}

