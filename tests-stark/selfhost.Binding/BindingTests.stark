[Fact]
fn bool CopyabilityFactsClassifyStructuralTypes()
{
    stack ascii source = "module Demo\nenum Kind { Alpha, Beta, }\nenum Token { End, Integer(i32[min max]), }\nstruct Span { Kind Tag; u64[0 max] Start; }\nstruct Owner { dynamic i32[min max] Items; }\nstruct View { Owner[] Items; }\nstruct Board { i32[min max][4] Cells; }\nstruct BadArray { Owner[2] Owners; }\nstruct Callback { fnptr<fn i32[min max](i32[min max])> Fn; }\nstruct WithDtor { i32[min max] Value; mut drop { } }\nrecord Header(Kind Tag, Owner[] Items) { }\nstruct Box<T> { T Value; }\nalias Count = u64[0 max];\nalias OwnerAlias = Owner;\n";
    stack mut TokenStream stream = new();
    stack mut CopyabilityFactTable facts = new();
    if (!BuildCopyabilityFactsForSource(source, stream, facts))
    {
        return false;
    }

    return CopyabilityFactEquals(source, stream, facts, "Kind", true)
        && CopyabilityFactEquals(source, stream, facts, "Token", true)
        && CopyabilityFactEquals(source, stream, facts, "Span", true)
        && CopyabilityFactEquals(source, stream, facts, "Owner", false)
        && CopyabilityFactEquals(source, stream, facts, "View", true)
        && CopyabilityFactEquals(source, stream, facts, "Board", true)
        && CopyabilityFactEquals(source, stream, facts, "BadArray", false)
        && CopyabilityFactEquals(source, stream, facts, "Callback", true)
        && CopyabilityFactEquals(source, stream, facts, "WithDtor", false)
        && CopyabilityFactEquals(source, stream, facts, "Header", true)
        && CopyabilityFactEquals(source, stream, facts, "Box", false)
        && CopyabilityFactEquals(source, stream, facts, "Count", true)
        && CopyabilityFactEquals(source, stream, facts, "OwnerAlias", false);
}

