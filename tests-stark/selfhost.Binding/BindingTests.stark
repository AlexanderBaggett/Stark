[Fact]
fn bool BreakInsideForEachIsAccepted()
{
    // A for-each is a loop, so `break`/`continue` in its body are in an enclosing
    // loop — no BreakOutsideLoop/ContinueOutsideLoop.
    stack ascii source = "fn void f(u32 items) { for willexit (u32 x in items) { break; continue; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.BreakOutsideLoop) == 0
                && diags.CountOf(BindDiagnosticCode.ContinueOutsideLoop) == 0;
    }
}

[Fact]
fn bool BreakInsideCStyleForIsAccepted()
{
    // The C-style `for` is a loop, and the parsed iterator clause (emitted one
    // level deeper) must not displace the `For` as the body's enclosing loop — so
    // `break`/`continue` in the body are accepted.
    stack ascii source = "fn void f(u32 n) { for willexit (stack mut u32 i = 0; i < n; i += 1) { break; continue; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.BreakOutsideLoop) == 0
                && diags.CountOf(BindDiagnosticCode.ContinueOutsideLoop) == 0
                && diags.Count() == 0;
    }
}

[Fact]
fn bool ForEachCollectionDoesNotSeeLoopElement()
