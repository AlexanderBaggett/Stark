[Fact]
fn bool TypedModuleSymbolsCaptureModuleAndVisibilityFacts()
{
    stack ascii source = raw"""
    import Vendor.Raylib
    module App.Main
    struct PrivateType { }
    internal struct InternalType { }
    public fn void PublicFn() { }
    export fn void ExportedFn() { }
    const Limit = 5;
    """;

    stack mut TokenStream stream = new();
    stack mut TypedModuleSymbolTable symbols = new();
    if (!BuildTypedModuleSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] privateSlot = TypedModuleSymbolIndexByName(symbols, source, stream, "PrivateType");
    stack u32[0 max] internalSlot = TypedModuleSymbolIndexByName(symbols, source, stream, "InternalType");
    stack u32[0 max] publicSlot = TypedModuleSymbolIndexByName(symbols, source, stream, "PublicFn");
    stack u32[0 max] exportSlot = TypedModuleSymbolIndexByName(symbols, source, stream, "ExportedFn");
    stack u32[0 max] constSlot = TypedModuleSymbolIndexByName(symbols, source, stream, "Limit");

    return symbols.Count() == 5
        && symbols.HasModuleName()
        && symbols.ModuleNameEquals("App.Main")
        && symbols.ModuleOriginKind() == ModuleOrigin.Source
        && symbols.ModuleOriginIndex() == 9
        && privateSlot != 0
        && internalSlot != 0
        && publicSlot != 0
        && exportSlot != 0
        && constSlot != 0
        && symbols.KindAt((u64[0 2 ** 63 - 1])(privateSlot - 1)) == DeclarationKind.Struct
        && symbols.KindAt((u64[0 2 ** 63 - 1])(publicSlot - 1)) == DeclarationKind.Function
        && symbols.KindAt((u64[0 2 ** 63 - 1])(constSlot - 1)) == DeclarationKind.Const
        && symbols.VisibilityAt((u64[0 2 ** 63 - 1])(privateSlot - 1)) == TypedModuleSymbolVisibility.ModulePrivate
        && symbols.VisibilityAt((u64[0 2 ** 63 - 1])(internalSlot - 1)) == TypedModuleSymbolVisibility.Internal
        && symbols.VisibilityAt((u64[0 2 ** 63 - 1])(publicSlot - 1)) == TypedModuleSymbolVisibility.Public
        && symbols.VisibilityAt((u64[0 2 ** 63 - 1])(exportSlot - 1)) == TypedModuleSymbolVisibility.Export
        && symbols.VisibilityAt((u64[0 2 ** 63 - 1])(constSlot - 1)) == TypedModuleSymbolVisibility.ModulePrivate;
}

[Fact]
fn bool TypedModuleSymbolsPreserveQualifiedNames()
{
    stack ascii source = "module Tools.Math\npublic fn void Add() { }\ninternal struct Accumulator { }\n";
    stack mut TokenStream stream = new();
    stack mut TypedModuleSymbolTable symbols = new();
    if (!BuildTypedModuleSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] addSlot = TypedModuleSymbolIndexByName(symbols, source, stream, "Add");
    stack u32[0 max] accumulatorSlot = TypedModuleSymbolIndexByName(symbols, source, stream, "Accumulator");

    return symbols.Count() == 2
        && addSlot != 0
        && accumulatorSlot != 0
        && symbols.QualifiedNameEqualsAt((u64[0 2 ** 63 - 1])(addSlot - 1), "Tools.Math.Add")
        && symbols.QualifiedNameEqualsAt((u64[0 2 ** 63 - 1])(accumulatorSlot - 1), "Tools.Math.Accumulator");
}

[Fact]
fn bool TypedDeclarationSymbolsCaptureFunctionBackendFacts()
{
    stack ascii source = raw"""
    module App.Native
    [LinkName("native_symbol")]
    export unsafe ffi(c) varargs fn i32[min max] Native(rawptr<i8[min max]> data);
    tail finite law inline hot fn i32[min max] Fast(i32[min max] value) { return value; }
    unsafe ffi asm(x86_64) fn i64[min max] Syscall(i64[min max] number) in("rax") number, out("rax") return, clobber("rcx") { "syscall" }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedDeclarationSymbolTable symbols = new();
    if (!BuildTypedDeclarationSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] nativeSlot = TypedDeclarationSymbolIndexByName(symbols, source, stream, "Native");
    stack u32[0 max] fastSlot = TypedDeclarationSymbolIndexByName(symbols, source, stream, "Fast");
    stack u32[0 max] syscallSlot = TypedDeclarationSymbolIndexByName(symbols, source, stream, "Syscall");
    if (nativeSlot == 0 || fastSlot == 0 || syscallSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] nativeIndex = (u64[0 2 ** 63 - 1])(nativeSlot - 1);
    stack u64[0 2 ** 63 - 1] fastIndex = (u64[0 2 ** 63 - 1])(fastSlot - 1);
    stack u64[0 2 ** 63 - 1] syscallIndex = (u64[0 2 ** 63 - 1])(syscallSlot - 1);

    return symbols.Count() == 3
        && symbols.FunctionCount() == 3
        && symbols.ExportCount() == 1
        && symbols.FfiCount() == 2
        && symbols.ClassAt(nativeIndex) == TypedDeclarationSymbolClass.Function
        && symbols.VisibilityAt(nativeIndex) == TypedModuleSymbolVisibility.Export
        && symbols.FunctionKindAt(nativeIndex) == TypedDeclarationFunctionKind.Fn
        && symbols.ParamCountAt(nativeIndex) == 1
        && symbols.IsExternalAt(nativeIndex)
        && symbols.IsUnsafeAt(nativeIndex)
        && symbols.IsFfiAt(nativeIndex)
        && symbols.IsVarargsAt(nativeIndex)
        && symbols.IsCAbiAt(nativeIndex)
        && symbols.HasLinkNameAt(nativeIndex)
        && symbols.LinkNameValueTokenAt(nativeIndex) != 0
        && System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.AbiNameTokenAt(nativeIndex)), "c")
        && symbols.FunctionKindAt(fastIndex) == TypedDeclarationFunctionKind.FiniteLaw
        && symbols.IsTailCallableAt(fastIndex)
        && symbols.IsInlineAt(fastIndex)
        && symbols.IsHotAt(fastIndex)
        && !symbols.IsExternalAt(fastIndex)
        && stream.KindAt((u64[0 2 ** 63 - 1])symbols.TypePrimaryTokenAt(fastIndex)) == TokenKind.IntegerType
        && symbols.IsAsmAt(syscallIndex)
        && symbols.IsFfiAt(syscallIndex)
        && !symbols.IsCAbiAt(syscallIndex)
        && symbols.AsmInputCountAt(syscallIndex) == 1
        && symbols.AsmOutputCountAt(syscallIndex) == 1
        && symbols.AsmClobberCountAt(syscallIndex) == 1
        && System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.AsmArchitectureTokenAt(syscallIndex)), "x86_64");
}

[Fact]
fn bool TypedDeclarationSymbolsCaptureValueAndAliasTypeAnchors()
{
    stack ascii source = raw"""
    module App.Config
    struct Widget { }
    const i32[min max] Limit = 7;
    static mut Widget Global;
    heap Widget HeapGlobal;
    arena Widget ArenaGlobal;
    alias TextAlias = System.Text.OwnedAscii;
    """;

    stack mut TokenStream stream = new();
    stack mut TypedDeclarationSymbolTable symbols = new();
    if (!BuildTypedDeclarationSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] widgetSlot = TypedDeclarationSymbolIndexByName(symbols, source, stream, "Widget");
    stack u32[0 max] limitSlot = TypedDeclarationSymbolIndexByName(symbols, source, stream, "Limit");
    stack u32[0 max] globalSlot = TypedDeclarationSymbolIndexByName(symbols, source, stream, "Global");
    stack u32[0 max] heapSlot = TypedDeclarationSymbolIndexByName(symbols, source, stream, "HeapGlobal");
    stack u32[0 max] arenaSlot = TypedDeclarationSymbolIndexByName(symbols, source, stream, "ArenaGlobal");
    stack u32[0 max] aliasSlot = TypedDeclarationSymbolIndexByName(symbols, source, stream, "TextAlias");
    if (widgetSlot == 0 || limitSlot == 0 || globalSlot == 0 || heapSlot == 0 || arenaSlot == 0 || aliasSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] widgetIndex = (u64[0 2 ** 63 - 1])(widgetSlot - 1);
    stack u64[0 2 ** 63 - 1] limitIndex = (u64[0 2 ** 63 - 1])(limitSlot - 1);
    stack u64[0 2 ** 63 - 1] globalIndex = (u64[0 2 ** 63 - 1])(globalSlot - 1);
    stack u64[0 2 ** 63 - 1] heapIndex = (u64[0 2 ** 63 - 1])(heapSlot - 1);
    stack u64[0 2 ** 63 - 1] arenaIndex = (u64[0 2 ** 63 - 1])(arenaSlot - 1);
    stack u64[0 2 ** 63 - 1] aliasIndex = (u64[0 2 ** 63 - 1])(aliasSlot - 1);

    return symbols.Count() == 6
        && symbols.ClassAt(widgetIndex) == TypedDeclarationSymbolClass.Type
        && symbols.TypePrimaryTokenAt(widgetIndex) == symbols.NameTokenAt(widgetIndex)
        && symbols.ClassAt(limitIndex) == TypedDeclarationSymbolClass.Value
        && symbols.StorageKindAt(limitIndex) == TypedDeclarationStorageKind.Const
        && stream.KindAt((u64[0 2 ** 63 - 1])symbols.TypePrimaryTokenAt(limitIndex)) == TokenKind.IntegerType
        && symbols.TypeHeadTokenAt(limitIndex) == 0
        && symbols.StorageKindAt(globalIndex) == TypedDeclarationStorageKind.Static
        && symbols.IsMutableStorageAt(globalIndex)
        && System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.TypeHeadTokenAt(globalIndex)), "Widget")
        && symbols.StorageKindAt(heapIndex) == TypedDeclarationStorageKind.Heap
        && symbols.StorageKindAt(arenaIndex) == TypedDeclarationStorageKind.Arena
        && symbols.ClassAt(aliasIndex) == TypedDeclarationSymbolClass.Alias
        && System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.TypeHeadTokenAt(aliasIndex)), "OwnedAscii")
        && symbols.TypeStartTokenAt(aliasIndex) < symbols.TypeEndTokenAt(aliasIndex);
}

[Fact]
fn bool TypedMemberSymbolsCaptureFieldsRecordFieldsAndMethodFacts()
{
    stack ascii source = raw"""
    module App.Model
    public struct Counter
    {
        [FieldOffset(0)] public i32[min max] Value;
        internal static fn Counter Create() { return new Counter(); }
        tail finite law inline hot fn i32[min max] Read(borrow Counter self) { return self.Value; }
    }

    record Pair(i32[min max] Left, Counter Right)
    """;

    stack mut TokenStream stream = new();
    stack mut TypedMemberSymbolTable symbols = new();
    if (!BuildTypedMemberSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] valueSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "Counter", "Value", TypedMemberSymbolKind.Field);
    stack u32[0 max] createSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "Counter", "Create", TypedMemberSymbolKind.Method);
    stack u32[0 max] readSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "Counter", "Read", TypedMemberSymbolKind.Method);
    stack u32[0 max] leftSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "Pair", "Left", TypedMemberSymbolKind.Field);
    stack u32[0 max] rightSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "Pair", "Right", TypedMemberSymbolKind.Field);
    if (valueSlot == 0 || createSlot == 0 || readSlot == 0 || leftSlot == 0 || rightSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] valueIndex = (u64[0 2 ** 63 - 1])(valueSlot - 1);
    stack u64[0 2 ** 63 - 1] createIndex = (u64[0 2 ** 63 - 1])(createSlot - 1);
    stack u64[0 2 ** 63 - 1] readIndex = (u64[0 2 ** 63 - 1])(readSlot - 1);
    stack u64[0 2 ** 63 - 1] leftIndex = (u64[0 2 ** 63 - 1])(leftSlot - 1);
    stack u64[0 2 ** 63 - 1] rightIndex = (u64[0 2 ** 63 - 1])(rightSlot - 1);

    return symbols.Count() == 5
        && symbols.FieldCount() == 3
        && symbols.MethodCount() == 2
        && symbols.OwnerDeclarationKindAt(valueIndex) == DeclarationKind.Struct
        && symbols.OwnerDeclarationKindAt(leftIndex) == DeclarationKind.Record
        && symbols.VisibilityAt(valueIndex) == TypedModuleSymbolVisibility.Public
        && symbols.HasFieldOffsetAt(valueIndex)
        && stream.KindAt((u64[0 2 ** 63 - 1])symbols.TypePrimaryTokenAt(valueIndex)) == TokenKind.IntegerType
        && symbols.VisibilityAt(createIndex) == TypedModuleSymbolVisibility.Internal
        && symbols.IsStaticAt(createIndex)
        && System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.TypeHeadTokenAt(createIndex)), "Counter")
        && symbols.FunctionKindAt(readIndex) == TypedDeclarationFunctionKind.FiniteLaw
        && symbols.IsTailCallableAt(readIndex)
        && symbols.IsInlineAt(readIndex)
        && symbols.IsHotAt(readIndex)
        && symbols.ParamCountAt(readIndex) == 1
        && stream.KindAt((u64[0 2 ** 63 - 1])symbols.TypePrimaryTokenAt(leftIndex)) == TokenKind.IntegerType
        && System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.TypeHeadTokenAt(rightIndex)), "Counter");
}

[Fact]
fn bool TypedMemberSymbolsCaptureEnumVariantsAndAssociatedAliases()
{
    stack ascii source = raw"""
    module App.Contracts
    public trait Reader
    {
        alias Item;
        public finite law Self.Item Read(borrow Self self);
    }

    struct IOError { }

    struct Counter : Reader
    {
        alias Item = i32[min max];
    }

    enum LoadResult
    {
        [Ok] Done(i32[min max]),
        [Err] Failed from IOError,
        Move { X: i32[min max], Y: i32[min max] },
        End,
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedMemberSymbolTable symbols = new();
    if (!BuildTypedMemberSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] requiredAliasSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "Reader", "Item", TypedMemberSymbolKind.AssociatedAlias);
    stack u32[0 max] readSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "Reader", "Read", TypedMemberSymbolKind.Method);
    stack u32[0 max] concreteAliasSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "Counter", "Item", TypedMemberSymbolKind.AssociatedAlias);
    stack u32[0 max] doneSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "LoadResult", "Done", TypedMemberSymbolKind.EnumVariant);
    stack u32[0 max] failedSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "LoadResult", "Failed", TypedMemberSymbolKind.EnumVariant);
    stack u32[0 max] moveSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "LoadResult", "Move", TypedMemberSymbolKind.EnumVariant);
    stack u32[0 max] endSlot = TypedMemberSymbolIndexByOwnerAndName(symbols, source, stream, "LoadResult", "End", TypedMemberSymbolKind.EnumVariant);
    if (requiredAliasSlot == 0 || readSlot == 0 || concreteAliasSlot == 0 || doneSlot == 0 || failedSlot == 0 || moveSlot == 0 || endSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] requiredAliasIndex = (u64[0 2 ** 63 - 1])(requiredAliasSlot - 1);
    stack u64[0 2 ** 63 - 1] readIndex = (u64[0 2 ** 63 - 1])(readSlot - 1);
    stack u64[0 2 ** 63 - 1] concreteAliasIndex = (u64[0 2 ** 63 - 1])(concreteAliasSlot - 1);
    stack u64[0 2 ** 63 - 1] doneIndex = (u64[0 2 ** 63 - 1])(doneSlot - 1);
    stack u64[0 2 ** 63 - 1] failedIndex = (u64[0 2 ** 63 - 1])(failedSlot - 1);
    stack u64[0 2 ** 63 - 1] moveIndex = (u64[0 2 ** 63 - 1])(moveSlot - 1);
    stack u64[0 2 ** 63 - 1] endIndex = (u64[0 2 ** 63 - 1])(endSlot - 1);

    return symbols.Count() == 7
        && symbols.AssociatedAliasCount() == 2
        && symbols.MethodCount() == 1
        && symbols.EnumVariantCount() == 4
        && symbols.TypeStartTokenAt(requiredAliasIndex) == 0
        && symbols.VisibilityAt(readIndex) == TypedModuleSymbolVisibility.Public
        && symbols.FunctionKindAt(readIndex) == TypedDeclarationFunctionKind.FiniteLaw
        && symbols.ParamCountAt(readIndex) == 1
        && stream.KindAt((u64[0 2 ** 63 - 1])symbols.TypePrimaryTokenAt(concreteAliasIndex)) == TokenKind.IntegerType
        && symbols.IsOkRoleAt(doneIndex)
        && symbols.PayloadCountAt(doneIndex) == 1
        && symbols.IsErrRoleAt(failedIndex)
        && symbols.IsErrorFunnelAt(failedIndex)
        && symbols.PayloadCountAt(failedIndex) == 1
        && symbols.PayloadCountAt(moveIndex) == 2
        && symbols.PayloadCountAt(endIndex) == 0;
}

[Fact]
fn bool TypedLocalSymbolsCaptureTopLevelParametersLocalsAndPatternBindings()
{
    stack ascii source = raw"""
    module App.Locals
    struct Widget { }

    unsafe finite fn bool Write(
        out u32[0 max] value,
        rawmutptr<i8[min max]> buffer,
        fnptr<tail fn bool(out u32[0 max]) where dead_on_return(arg0)> callback)
        where dead_on_return(buffer)
    {
        stack mut i32[min max] total = 0;
        arena Widget item = new Widget();
        for willexit (stack u32[0 max] index = 0; index < 4; index += 1)
        {
            stack i32[min max] inner = total;
        }

        switch (total)
        {
            case var found:
                return true;
            default:
                return false;
        }
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedLocalSymbolTable symbols = new();
    if (!BuildTypedLocalSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] valueSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Write", "value", TypedLocalSymbolKind.Parameter);
    stack u32[0 max] bufferSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Write", "buffer", TypedLocalSymbolKind.Parameter);
    stack u32[0 max] callbackSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Write", "callback", TypedLocalSymbolKind.Parameter);
    stack u32[0 max] totalSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Write", "total", TypedLocalSymbolKind.Local);
    stack u32[0 max] itemSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Write", "item", TypedLocalSymbolKind.Local);
    stack u32[0 max] indexSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Write", "index", TypedLocalSymbolKind.Local);
    stack u32[0 max] innerSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Write", "inner", TypedLocalSymbolKind.Local);
    stack u32[0 max] foundSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Write", "found", TypedLocalSymbolKind.PatternBinding);
    if (valueSlot == 0 || bufferSlot == 0 || callbackSlot == 0 || totalSlot == 0
        || itemSlot == 0 || indexSlot == 0 || innerSlot == 0 || foundSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] valueIndex = (u64[0 2 ** 63 - 1])(valueSlot - 1);
    stack u64[0 2 ** 63 - 1] bufferIndex = (u64[0 2 ** 63 - 1])(bufferSlot - 1);
    stack u64[0 2 ** 63 - 1] callbackIndex = (u64[0 2 ** 63 - 1])(callbackSlot - 1);
    stack u64[0 2 ** 63 - 1] totalIndex = (u64[0 2 ** 63 - 1])(totalSlot - 1);
    stack u64[0 2 ** 63 - 1] itemIndex = (u64[0 2 ** 63 - 1])(itemSlot - 1);
    stack u64[0 2 ** 63 - 1] indexIndex = (u64[0 2 ** 63 - 1])(indexSlot - 1);
    stack u64[0 2 ** 63 - 1] innerIndex = (u64[0 2 ** 63 - 1])(innerSlot - 1);
    stack u64[0 2 ** 63 - 1] foundIndex = (u64[0 2 ** 63 - 1])(foundSlot - 1);

    return symbols.Count() == 8
        && symbols.ParameterCount() == 3
        && symbols.LocalCount() == 4
        && symbols.PatternBindingCount() == 1
        && symbols.OwnerKindAt(valueIndex) == TypedLocalOwnerKind.DeclarationFunction
        && symbols.OwnerDeclarationSymbolIndexPlusOneAt(valueIndex) != 0
        && symbols.OwnerMemberSymbolIndexPlusOneAt(valueIndex) == 0
        && symbols.IsOutAt(valueIndex)
        && symbols.IsMemoryBackedAt(valueIndex)
        && symbols.ParamOrdinalAt(valueIndex) == 0
        && symbols.IsRawPointerAt(bufferIndex)
        && symbols.IsRawMutablePointerAt(bufferIndex)
        && symbols.IsDeadOnReturnAt(bufferIndex)
        && symbols.IsTailCallableTypeAt(callbackIndex)
        && symbols.HasCallableTypeDeadOnReturnAt(callbackIndex)
        && symbols.StorageKindAt(totalIndex) == TypedDeclarationStorageKind.Stack
        && symbols.IsMutableAt(totalIndex)
        && stream.KindAt((u64[0 2 ** 63 - 1])symbols.TypePrimaryTokenAt(totalIndex)) == TokenKind.IntegerType
        && symbols.StorageKindAt(itemIndex) == TypedDeclarationStorageKind.Arena
        && System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.TypeHeadTokenAt(itemIndex)), "Widget")
        && symbols.StorageKindAt(indexIndex) == TypedDeclarationStorageKind.Stack
        && symbols.StatementIndexPlusOneAt(indexIndex) != 0
        && symbols.ScopeIdAt(innerIndex) != symbols.ScopeIdAt(totalIndex)
        && symbols.TypeStartTokenAt(foundIndex) == 0
        && symbols.StorageKindAt(foundIndex) == TypedDeclarationStorageKind.None;
}

[Fact]
fn bool TypedLocalSymbolsCaptureMemberMethodOwnersAndParameterFacts()
{
    stack ascii source = raw"""
    module App.MethodLocals
    struct Counter
    {
        i32[min max] Value;

        tail finite law fn i32[min max] Read(borrow Counter self, init i32[min max][] output)
            where dead_on_return(output)
        {
            stack mut i32[min max] current = self.Value;
            return current;
        }
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedLocalSymbolTable symbols = new();
    if (!BuildTypedLocalSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] selfSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Read", "self", TypedLocalSymbolKind.Parameter);
    stack u32[0 max] outputSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Read", "output", TypedLocalSymbolKind.Parameter);
    stack u32[0 max] currentSlot = TypedLocalSymbolIndexByOwnerAndName(symbols, source, stream, "Read", "current", TypedLocalSymbolKind.Local);
    if (selfSlot == 0 || outputSlot == 0 || currentSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] selfIndex = (u64[0 2 ** 63 - 1])(selfSlot - 1);
    stack u64[0 2 ** 63 - 1] outputIndex = (u64[0 2 ** 63 - 1])(outputSlot - 1);
    stack u64[0 2 ** 63 - 1] currentIndex = (u64[0 2 ** 63 - 1])(currentSlot - 1);

    return symbols.Count() == 3
        && symbols.ParameterCount() == 2
        && symbols.LocalCount() == 1
        && symbols.OwnerKindAt(selfIndex) == TypedLocalOwnerKind.MemberMethod
        && symbols.OwnerDeclarationSymbolIndexPlusOneAt(selfIndex) != 0
        && symbols.OwnerMemberSymbolIndexPlusOneAt(selfIndex) != 0
        && symbols.IsBorrowAt(selfIndex)
        && System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.TypeHeadTokenAt(selfIndex)), "Counter")
        && symbols.IsInitAt(outputIndex)
        && symbols.IsMemoryBackedAt(outputIndex)
        && symbols.IsDeadOnReturnAt(outputIndex)
        && symbols.ParamOrdinalAt(outputIndex) == 1
        && symbols.StorageKindAt(currentIndex) == TypedDeclarationStorageKind.Stack
        && symbols.IsMutableAt(currentIndex)
        && symbols.StatementIndexPlusOneAt(currentIndex) != 0;
}

[Fact]
fn bool TypedGenericParameterSymbolsCaptureDeclarationGenerics()
{
    stack ascii source = raw"""
    module App.Generics
    trait Drawable { }
    trait Hashable { }

    struct Buffer<T, comptime u8[1 8] N> where T: Drawable, Hashable
    {
        T Value;
    }

    enum Result<T, E>
    {
        Ok(T),
        Err(E),
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedGenericParameterSymbolTable symbols = new();
    if (!BuildTypedGenericSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] bufferTSlot = TypedGenericParameterSymbolIndexByOwnerAndName(symbols, source, stream, "Buffer", "T", TypedGenericParameterKind.Type);
    stack u32[0 max] bufferNSlot = TypedGenericParameterSymbolIndexByOwnerAndName(symbols, source, stream, "Buffer", "N", TypedGenericParameterKind.ComptimeValue);
    stack u32[0 max] resultTSlot = TypedGenericParameterSymbolIndexByOwnerAndName(symbols, source, stream, "Result", "T", TypedGenericParameterKind.Type);
    stack u32[0 max] resultESlot = TypedGenericParameterSymbolIndexByOwnerAndName(symbols, source, stream, "Result", "E", TypedGenericParameterKind.Type);
    if (bufferTSlot == 0 || bufferNSlot == 0 || resultTSlot == 0 || resultESlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] bufferTIndex = (u64[0 2 ** 63 - 1])(bufferTSlot - 1);
    stack u64[0 2 ** 63 - 1] bufferNIndex = (u64[0 2 ** 63 - 1])(bufferNSlot - 1);
    stack u64[0 2 ** 63 - 1] resultEIndex = (u64[0 2 ** 63 - 1])(resultESlot - 1);

    return symbols.Count() == 4
        && symbols.TypeParameterCount() == 3
        && symbols.ComptimeValueParameterCount() == 1
        && symbols.OwnerKindAt(bufferTIndex) == TypedGenericOwnerKind.Declaration
        && symbols.OwnerDeclarationSymbolIndexPlusOneAt(bufferTIndex) != 0
        && symbols.OwnerMemberSymbolIndexPlusOneAt(bufferTIndex) == 0
        && symbols.ParamOrdinalAt(bufferTIndex) == 0
        && symbols.TypeOrdinalAt(bufferTIndex) == 0
        && symbols.ConstraintCountAt(bufferTIndex) == 2
        && symbols.HasConstraintsAt(bufferTIndex)
        && symbols.ParamOrdinalAt(bufferNIndex) == 1
        && symbols.ComptimeOrdinalAt(bufferNIndex) == 0
        && symbols.IsComptimeValueAt(bufferNIndex)
        && symbols.IsIntegerTypeAt(bufferNIndex)
        && symbols.HasRangeBoundsAt(bufferNIndex)
        && symbols.RangeStartTokenAt(bufferNIndex) != 0
        && symbols.RangeEndTokenAt(bufferNIndex) != 0
        && stream.KindAt((u64[0 2 ** 63 - 1])symbols.TypePrimaryTokenAt(bufferNIndex)) == TokenKind.IntegerType
        && symbols.ParamOrdinalAt(resultEIndex) == 1
        && symbols.TypeOrdinalAt(resultEIndex) == 1;
}

[Fact]
fn bool TypedGenericParameterSymbolsCaptureFunctionAndMethodGenerics()
{
    stack ascii source = raw"""
    module App.GenericMethods
    trait Drawable { }

    struct Mapper<T>
    {
        fn U Map<U, comptime u8[1 4] Count>(borrow Mapper<T> self, U value)
        {
            return value;
        }
    }

    fn T Pick<T, comptime u8[1 8] N>(T value) where T: Drawable
    {
        return value;
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedGenericParameterSymbolTable symbols = new();
    if (!BuildTypedGenericSymbolsForSource(source, stream, symbols))
    {
        return false;
    }

    stack u32[0 max] mapperTSlot = TypedGenericParameterSymbolIndexByOwnerAndName(symbols, source, stream, "Mapper", "T", TypedGenericParameterKind.Type);
    stack u32[0 max] mapUSlot = TypedGenericParameterSymbolIndexByOwnerAndName(symbols, source, stream, "Map", "U", TypedGenericParameterKind.Type);
    stack u32[0 max] mapCountSlot = TypedGenericParameterSymbolIndexByOwnerAndName(symbols, source, stream, "Map", "Count", TypedGenericParameterKind.ComptimeValue);
    stack u32[0 max] pickTSlot = TypedGenericParameterSymbolIndexByOwnerAndName(symbols, source, stream, "Pick", "T", TypedGenericParameterKind.Type);
    stack u32[0 max] pickNSlot = TypedGenericParameterSymbolIndexByOwnerAndName(symbols, source, stream, "Pick", "N", TypedGenericParameterKind.ComptimeValue);
    if (mapperTSlot == 0 || mapUSlot == 0 || mapCountSlot == 0 || pickTSlot == 0 || pickNSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] mapperTIndex = (u64[0 2 ** 63 - 1])(mapperTSlot - 1);
    stack u64[0 2 ** 63 - 1] mapUIndex = (u64[0 2 ** 63 - 1])(mapUSlot - 1);
    stack u64[0 2 ** 63 - 1] mapCountIndex = (u64[0 2 ** 63 - 1])(mapCountSlot - 1);
    stack u64[0 2 ** 63 - 1] pickTIndex = (u64[0 2 ** 63 - 1])(pickTSlot - 1);
    stack u64[0 2 ** 63 - 1] pickNIndex = (u64[0 2 ** 63 - 1])(pickNSlot - 1);

    return symbols.Count() == 5
        && symbols.TypeParameterCount() == 3
        && symbols.ComptimeValueParameterCount() == 2
        && symbols.OwnerKindAt(mapperTIndex) == TypedGenericOwnerKind.Declaration
        && symbols.OwnerKindAt(mapUIndex) == TypedGenericOwnerKind.MemberMethod
        && symbols.OwnerDeclarationSymbolIndexPlusOneAt(mapUIndex) != 0
        && symbols.OwnerMemberSymbolIndexPlusOneAt(mapUIndex) != 0
        && symbols.ParamOrdinalAt(mapUIndex) == 0
        && symbols.TypeOrdinalAt(mapUIndex) == 0
        && symbols.ParamOrdinalAt(mapCountIndex) == 1
        && symbols.ComptimeOrdinalAt(mapCountIndex) == 0
        && symbols.IsComptimeValueAt(mapCountIndex)
        && symbols.HasRangeBoundsAt(mapCountIndex)
        && symbols.ConstraintCountAt(pickTIndex) == 1
        && symbols.HasConstraintsAt(pickTIndex)
        && symbols.IsComptimeValueAt(pickNIndex)
        && symbols.IsIntegerTypeAt(pickNIndex)
        && symbols.HasRangeBoundsAt(pickNIndex);
}

[Fact]
fn bool TypedTraitConformancesCaptureDirectDeclarationBases()
{
    stack ascii source = raw"""
    module App.TraitBases
    trait Drawable { }
    trait Hashable { }
    trait Tagged<T, comptime u8[1 8] N> { }

    struct Widget : Drawable, Tagged<i32[min max], 4>
    {
        i32[min max] Width;
    }

    struct Key : Hashable
    {
        u32[0 max] Value;
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedTraitConformanceTable conformances = new();
    if (!BuildTypedTraitConformanceTableForSource(source, stream, conformances))
    {
        return false;
    }

    stack u32[0 max] widgetDrawableSlot = TypedTraitConformanceIndexByOwnerSubjectAndTrait(
        conformances,
        source,
        stream,
        "Widget",
        "Widget",
        "Drawable",
        TypedTraitConformanceKind.DeclarationBase);
    stack u32[0 max] widgetTaggedSlot = TypedTraitConformanceIndexByOwnerSubjectAndTrait(
        conformances,
        source,
        stream,
        "Widget",
        "Widget",
        "Tagged",
        TypedTraitConformanceKind.DeclarationBase);
    stack u32[0 max] keyHashableSlot = TypedTraitConformanceIndexByOwnerSubjectAndTrait(
        conformances,
        source,
        stream,
        "Key",
        "Key",
        "Hashable",
        TypedTraitConformanceKind.DeclarationBase);
    if (widgetDrawableSlot == 0 || widgetTaggedSlot == 0 || keyHashableSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] widgetDrawableIndex = (u64[0 2 ** 63 - 1])(widgetDrawableSlot - 1);
    stack u64[0 2 ** 63 - 1] widgetTaggedIndex = (u64[0 2 ** 63 - 1])(widgetTaggedSlot - 1);
    stack u64[0 2 ** 63 - 1] keyHashableIndex = (u64[0 2 ** 63 - 1])(keyHashableSlot - 1);

    return conformances.Count() == 3
        && conformances.DeclarationBaseCount() == 3
        && conformances.GenericConstraintCount() == 0
        && conformances.SubjectDeclarationSymbolIndexPlusOneAt(widgetDrawableIndex) != 0
        && conformances.TraitDeclarationSymbolIndexPlusOneAt(widgetDrawableIndex) != 0
        && conformances.TraitResolvedAt(widgetDrawableIndex)
        && conformances.HasDeclarationTraitConformance(
            conformances.SubjectDeclarationSymbolIndexPlusOneAt(widgetDrawableIndex),
            conformances.TraitDeclarationSymbolIndexPlusOneAt(widgetDrawableIndex))
        && conformances.TraitHasGenericArgumentsAt(widgetTaggedIndex)
        && conformances.TraitGenericOpenTokenAt(widgetTaggedIndex) != 0
        && conformances.TraitGenericCloseTokenAt(widgetTaggedIndex) > conformances.TraitGenericOpenTokenAt(widgetTaggedIndex)
        && conformances.TraitTypeArgumentCountAt(widgetTaggedIndex) == 1
        && conformances.TraitComptimeArgumentCountAt(widgetTaggedIndex) == 1
        && conformances.SubjectDeclarationSymbolIndexPlusOneAt(keyHashableIndex) != 0
        && conformances.TraitResolvedAt(keyHashableIndex);
}

[Fact]
fn bool TypedTraitConformancesCaptureGenericWhereBounds()
{
    stack ascii source = raw"""
    module App.TraitBounds
    trait Drawable { }
    trait Hashable { }
    trait Mapper<T> { }

    struct Buffer<T> where T: Drawable, Hashable
    {
        T Value;
    }

    fn T Pick<T>(T value) where T: Drawable
    {
        return value;
    }

    struct Runner
    {
        fn U Map<U>(U value) where U: Mapper<i32[min max]>
        {
            return value;
        }
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedTraitConformanceTable conformances = new();
    if (!BuildTypedTraitConformanceTableForSource(source, stream, conformances))
