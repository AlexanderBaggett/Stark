import Compiler.Binding
import Compiler.Parsing
import Compiler.Lexing
import Compiler.Ir
import System.Testing
import System.Text
[Collection("binding")]
module BindingTests

fn bool LexOk(LexResult<TokenStream> result, out TokenStream stream)
{
    switch (result)
    {
        case LexResult<TokenStream>.Err(var error):
            stream = new();
            return false;
        case LexResult<TokenStream>.Ok(var value):
            stream = value;
            return true;
    }
}

fn bool BindSource(ascii source, out BindDiagnosticList diags)
{
    diags = new();
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var value):
            diags = value;
            return true;
    }
}

fn bool BuildGenericFacts(ascii source, out TokenStream stream, out GenericUseSiteTable facts)
{
    stream = new();
    facts = new();
    stack mut TokenStream parsedStream = new();
    if (!LexOk(LexText(source), parsedStream))
    {
        return false;
    }

    switch (BuildGenericUseSiteSyntaxFacts(parsedStream))
    {
        case BindResult<GenericUseSiteTable>.Err(var error):
            return false;
        case BindResult<GenericUseSiteTable>.Ok(var value):
            stream = parsedStream;
            facts = value;
            return true;
    }
}

fn bool FunctionKeywordByNameForBinding(ascii source, borrow TokenStream stream, borrow DeclarationList decls, ascii name, out u32[0 max] fnKeyword)
{
    fnKeyword = 0;
    stack mut bool found = false;
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (!found && item.Kind == DeclarationKind.Function)
        {
            stack ascii itemName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])item.NameToken);
            if (System.Text.Equals(itemName, name))
            {
                fnKeyword = item.KeywordToken;
                found = true;
            }
        }
    }

    return found;
}

fn bool BuildCallableFactsForFunction(ascii source, ascii functionName, out TokenStream stream, out CallableCandidateSetTable facts)
{
    stream = new();
    facts = new();
    stack mut TokenStream parsedStream = new();
    if (!LexOk(LexText(source), parsedStream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(parsedStream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDecls):
            decls = parsedDecls;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, parsedStream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var builtTable):
            table = builtTable;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordByNameForBinding(source, parsedStream, decls, functionName, fnKeyword))
    {
        return false;
    }

    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(parsedStream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(parsedStream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    stack mut FunctionScope scope = new();
    switch (BuildFunctionScope(signature, body))
    {
        case BindResult<FunctionScope>.Err(var scopeError):
            return false;
        case BindResult<FunctionScope>.Ok(var builtScope):
            scope = builtScope;
    }

    stack mut ReferenceTable refs = new();
    switch (ResolveReferences(scope, table, source, parsedStream, body))
    {
        case BindResult<ReferenceTable>.Err(var refError):
            return false;
        case BindResult<ReferenceTable>.Ok(var builtRefs):
            refs = builtRefs;
    }

    switch (BuildCallableCandidateSets(table, source, parsedStream, refs, scope, body))
    {
        case BindResult<CallableCandidateSetTable>.Err(var callableError):
            return false;
        case BindResult<CallableCandidateSetTable>.Ok(var builtFacts):
            stream = parsedStream;
            facts = builtFacts;
            return true;
    }
}

fn u32[0 max] CallableSetIndexByName(borrow CallableCandidateSetTable facts, ascii source, borrow TokenStream stream, ascii name)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0)
        {
            stack ascii actual = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])facts.NameTokenAt(index));
            if (System.Text.Equals(actual, name))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

fn bool BuildReceiverFactsForFunction(ascii source, ascii functionName, out TokenStream stream, out ReceiverCandidateSetTable facts)
{
    stream = new();
    facts = new();
