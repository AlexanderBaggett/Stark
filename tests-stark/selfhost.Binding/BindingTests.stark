fn bool BooleanChainedMemberConditionIsAccepted()
{
    // `o.inner.flag` chains to a `bool` field, so the condition is accepted.
    stack ascii source = "struct Inner { bool flag; }\nstruct Outer { Inner inner; }\nfn void f(Outer o) { if (o.inner.flag) { } }\n";
    stack mut TokenStream stream = new();
