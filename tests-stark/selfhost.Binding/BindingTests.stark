[Fact]
fn bool DirectRecursiveReturnCallReferencesFunctionDeclaration()
{
    stack ascii source = "fn i32 recur(i32 x) { return recur(x); }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            switch (ResolveReferences(scope, table, source, stream, body))
                            {
                                case BindResult<ReferenceTable>.Err(var refError):
                                    return false;
                                case BindResult<ReferenceTable>.Ok(var refs):
                                    stack u32[0 max] root = body.ExprRootAt(0);
                                    stack u32[0 max] callee = body.ExprLeftAt(root);
                                    stack mut bool declarationTargetMatches = false;
                                    stack u64[0 2 ** 63 - 1] refCount = refs.Count();
                                    for willexit (stack mut u64[0 2 ** 63 - 1] refIndex = 0; refIndex < refCount; refIndex += 1)
                                    {
                                        if (!declarationTargetMatches)
                                        {
                                            stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])refs.NameTokenAt(refIndex));
                                            if (System.Text.Equals(name, "recur")
                                                && refs.KindAt(refIndex) == ReferenceKind.Declaration
                                                && refs.TargetAt(refIndex) == 1)
                                            {
                                                declarationTargetMatches = true;
                                            }
                                        }
                                    }

                                    return body.Count() == 1
                                        && body.ExprNodeCount() == 3
                                        && table.Count() == 1
                                        && table.KindAt(0) == DeclarationKind.Function
                                        && !signature.FiniteKind()
                                        && root != 0
                                        && body.ExprKindAt(root) == ExprKind.Call
                                        && body.ExprCallArgCountAt(root) == 1
                                        && callee != 0
                                        && body.ExprKindAt(callee) == ExprKind.Identifier
                                        && declarationTargetMatches;
                            }
                    }
            }
    }
}

[Fact]
fn bool CallableCandidateSetsCaptureDirectFunctionAndCallbackCalls()
{
    stack ascii source = "fn i32[min max] id(i32[min max] x) { return x; }\nfn void caller(fnptr<fn i32[min max](i32[min max])> cb, i32[min max] v) { id(v); cb(v); missing(v); }\n";
    stack mut TokenStream stream = new();
    stack mut CallableCandidateSetTable facts = new();
    if (!BuildCallableFactsForFunction(source, "caller", stream, facts))
    {
        return false;
    }

    stack u32[0 max] idSite = CallableSetIndexByName(facts, source, stream, "id");
    stack u32[0 max] cbSite = CallableSetIndexByName(facts, source, stream, "cb");
    stack u32[0 max] missingSite = CallableSetIndexByName(facts, source, stream, "missing");
    if (idSite == 0 || cbSite == 0 || missingSite == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] idSlot = (u64[0 2 ** 63 - 1])(idSite - 1);
    stack u64[0 2 ** 63 - 1] cbSlot = (u64[0 2 ** 63 - 1])(cbSite - 1);
    stack u64[0 2 ** 63 - 1] missingSlot = (u64[0 2 ** 63 - 1])(missingSite - 1);
    return facts.Count() == 3
        && facts.TotalCandidateCount() == 2
        && facts.ArgumentCountAt(idSlot) == 1
        && facts.CandidateCountAt(idSlot) == 1
        && facts.DeclarationCandidateCountAt(idSlot) == 1
        && facts.CandidateKindAt(idSlot, 0) == CallableCandidateKind.Declaration
        && facts.CandidateTargetAt(idSlot, 0) == 1
        && facts.ArgumentCountAt(cbSlot) == 1
        && facts.CandidateCountAt(cbSlot) == 1
        && facts.ScopeSymbolCandidateCountAt(cbSlot) == 1
        && facts.CandidateKindAt(cbSlot, 0) == CallableCandidateKind.ScopeSymbol
        && facts.CandidateTargetAt(cbSlot, 0) == 1
        && facts.ArgumentCountAt(missingSlot) == 1
        && facts.CandidateCountAt(missingSlot) == 0;
}

[Fact]
fn bool CallableCandidateSetsKeepSameNameFunctionDeclarations()
{
    stack ascii source = "fn void overload(i32[min max] x) { }\nfn void overload(bool x) { }\nfn void caller() { overload(1); }\n";
    stack mut TokenStream stream = new();
    stack mut CallableCandidateSetTable facts = new();
    if (!BuildCallableFactsForFunction(source, "caller", stream, facts))
    {
        return false;
    }

    stack u32[0 max] overloadSite = CallableSetIndexByName(facts, source, stream, "overload");
    if (overloadSite == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(overloadSite - 1);
    return facts.Count() == 1
        && facts.TotalCandidateCount() == 2
        && facts.CandidateCountAt(slot) == 2
        && facts.DeclarationCandidateCountAt(slot) == 2
        && facts.CandidateKindAt(slot, 0) == CallableCandidateKind.Declaration
        && facts.CandidateKindAt(slot, 1) == CallableCandidateKind.Declaration
        && facts.CandidateTargetAt(slot, 0) == 1
        && facts.CandidateTargetAt(slot, 1) == 2;
}

[Fact]
fn bool ReceiverCandidateSetsCaptureFieldAndInstanceMethodMembers()
{
    stack ascii source = "struct Counter { i32[min max] Value; fn i32[min max] Get(borrow Counter self) { return self.Value; } }\nfn void caller(Counter c) { c.Value; c.Get(); c.Missing(); }\n";
    stack mut TokenStream stream = new();
    stack mut ReceiverCandidateSetTable facts = new();
    if (!BuildReceiverFactsForFunction(source, "caller", stream, facts))
    {
        return false;
    }

    stack u32[0 max] valueSite = ReceiverSetIndexByName(facts, source, stream, "Value");
    stack u32[0 max] getSite = ReceiverSetIndexByName(facts, source, stream, "Get");
    stack u32[0 max] missingSite = ReceiverSetIndexByName(facts, source, stream, "Missing");
    if (valueSite == 0 || getSite == 0 || missingSite == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] valueSlot = (u64[0 2 ** 63 - 1])(valueSite - 1);
    stack u64[0 2 ** 63 - 1] getSlot = (u64[0 2 ** 63 - 1])(getSite - 1);
    stack u64[0 2 ** 63 - 1] missingSlot = (u64[0 2 ** 63 - 1])(missingSite - 1);
    return facts.Count() == 3
        && facts.TotalCandidateCount() == 2
        && facts.SiteKindAt(valueSlot) == ReceiverCandidateSiteKind.Value
        && facts.CallNodeAt(valueSlot) == 0
        && facts.ArgumentCountAt(valueSlot) == 0
        && facts.CandidateCountAt(valueSlot) == 1
        && facts.FieldCandidateCountAt(valueSlot) == 1
        && facts.CandidateKindAt(valueSlot, 0) == ReceiverCandidateKind.Field
        && facts.SiteKindAt(getSlot) == ReceiverCandidateSiteKind.Value
        && facts.CallNodeAt(getSlot) != 0
        && facts.ArgumentCountAt(getSlot) == 0
        && facts.CandidateCountAt(getSlot) == 1
        && facts.InstanceMethodCandidateCountAt(getSlot) == 1
        && facts.CandidateKindAt(getSlot, 0) == ReceiverCandidateKind.InstanceMethod
        && facts.SiteKindAt(missingSlot) == ReceiverCandidateSiteKind.Value
        && facts.CandidateCountAt(missingSlot) == 0;
}

[Fact]
fn bool ReceiverCandidateSetsCaptureStaticMethodMembers()
{
    stack ascii source = "struct Counter { static fn Counter Create() { return new Counter(); } fn i32[min max] Get(borrow Counter self) { return 0; } }\nfn void caller() { Counter.Create(); Counter.Get(); }\n";
    stack mut TokenStream stream = new();
    stack mut ReceiverCandidateSetTable facts = new();
    if (!BuildReceiverFactsForFunction(source, "caller", stream, facts))
    {
        return false;
    }

    stack u32[0 max] createSite = ReceiverSetIndexByName(facts, source, stream, "Create");
    stack u32[0 max] getSite = ReceiverSetIndexByName(facts, source, stream, "Get");
    if (createSite == 0 || getSite == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] createSlot = (u64[0 2 ** 63 - 1])(createSite - 1);
    stack u64[0 2 ** 63 - 1] getSlot = (u64[0 2 ** 63 - 1])(getSite - 1);
    return facts.Count() == 2
        && facts.TotalCandidateCount() == 1
        && facts.SiteKindAt(createSlot) == ReceiverCandidateSiteKind.Static
        && facts.CallNodeAt(createSlot) != 0
        && facts.ArgumentCountAt(createSlot) == 0
        && facts.CandidateCountAt(createSlot) == 1
        && facts.StaticMethodCandidateCountAt(createSlot) == 1
        && facts.CandidateKindAt(createSlot, 0) == ReceiverCandidateKind.StaticMethod
        && facts.SiteKindAt(getSlot) == ReceiverCandidateSiteKind.Static
        && facts.CandidateCountAt(getSlot) == 0;
}

