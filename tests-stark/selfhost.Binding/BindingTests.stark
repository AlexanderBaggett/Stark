        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool ForBodyLocalsAreNotDropped()
{
    // The for-header's `;` separators must not truncate the statement: the
    // for-init `i` is bound in the loop scope and the for body's two `x` locals
    // are recorded (three locals total) and the redefinition flagged.
    stack ascii source = "fn void f(u32 n) { for (stack mut u32 i = 0; i < n; i += 1) { stack u32 x = 0; stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
