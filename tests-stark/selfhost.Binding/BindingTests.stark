    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return !HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool ResolvesSignatureTypes()
{
    // Return type `Foo` and parameter type `Bar` are both declared; `i32` is
    // built-in (head 0, skipped). No unresolved signature types.
    stack ascii source = "struct Foo { }\nstruct Bar { }\nfn Foo make(Bar a, i32 b) { }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            return CountUnresolvedSignatureTypes(signature, table, source, stream) == 0;
    }
}

[Fact]
fn bool FlagsUnresolvedSignatureTypes()
{
    // Neither `Bar` (return) nor `Foo` (parameter) is declared — two unresolved
    // signature types.
    stack ascii source = "fn Bar g(Foo x) { }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            return CountUnresolvedSignatureTypes(signature, table, source, stream) == 2;
    }
}

// TEMP PROBE helper: true iff ResolveReferences marks some `zzz` ref as Local.
fn bool BindResultResolvesZzzAsLocal(borrow FunctionScope scope, borrow DeclarationTable table, ascii source, borrow TokenStream stream, borrow StatementList body)
{
    switch (ResolveReferences(scope, table, source, stream, body))
    {
        case BindResult<ReferenceTable>.Err(var refError):
            return false;
        case BindResult<ReferenceTable>.Ok(var refs):
            return RefHasKind(refs, source, stream, "zzz", ReferenceKind.Local)
                && !RefHasKind(refs, source, stream, "zzz", ReferenceKind.Unbound);
    }
}

// Out-of-scope local: `zzz` is declared only inside the if-block (depth 1) and
// referenced at body depth 0, where its block has closed. Lexical resolution
// leaves the trailing `zzz` unbound (1 unresolved) and never binds it to the
// dead inner local.
[Fact]
fn bool ProbeOutOfScopeLocal()
{
    stack ascii source = "fn void f(i32 a) { if (a) { stack u32 zzz = 0; } zzz; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return false;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return false;
                        case BindResult<FunctionScope>.Ok(var scope):
                            // Correct lexical scoping: trailing `zzz` is unbound (1
                            // unresolved) and is NOT resolved to the dead inner local.
                            return CountUnresolvedReferences(scope, table, source, stream, body) == 1
                                && !BindResultResolvesZzzAsLocal(scope, table, source, stream, body);
                    }
            }
    }
}

// ADVERSARIAL VERIFICATION (temporary). Finding's EXACT input: two `x` locals
// Both `x` locals are directly under one `case A:` section (one section scope per
// grammar `switchSection: switchLabel+ statement*`), so the parser records 2
// locals and the same-block rule flags the redefinition.
[Fact]
fn bool SwitchSectionLocalRedefinitionIsFlagged()
{
    stack ascii source = "fn void f() { switch (e) { case A: stack u32 x = 0; stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

// The else-arm body is sub-parsed (not dropped), so both `x` locals in it are
// recorded and the same-block redefinition is flagged.
[Fact]
fn bool ElseArmLocalRedefinitionIsFlagged()
{
    stack ascii source = "fn void f() { if (c) { } else { stack u32 x = 0; stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool ResolvesDottedAndRangedSignatureTypes()
{
    // `System.Foo` resolves on its rightmost segment `Foo` (declared); the
    // ranged-int parameter `i32[0 max] n` is a built-in (head 0, skipped). No
    // unresolved signature types.
    stack ascii source = "struct Foo { }\nfn System.Foo g(i32[0 max] n) { }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FunctionKeywordIn(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            return CountUnresolvedSignatureTypes(signature, table, source, stream) == 0;
    }
}

[Fact]
fn bool BareBlockLocalRedefinitionIsFlagged()
{
    // A bare `{ ... }` block is its own scope; both `x` locals in it are recorded
    // and the same-block redefinition is flagged.
    stack ascii source = "fn void f() { { stack u32 x = 0; stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool HeaderBraceDoesNotDeriveBody()
{
    // A brace inside the `while` condition (an object initializer) must not be
    // mistaken for the body: the real body's two `a` locals are recorded and the
    // redefinition flagged.
    stack ascii source = "fn void f(u32 p) { while (p == new Point { x: 1 }) { stack u32 a = 0; stack u32 a = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool ForBodyLocalsAreNotDropped()
{
    // The for-header's `;` separators must not truncate the statement: the for
    // body's two `x` locals are recorded and the redefinition flagged.
    stack ascii source = "fn void f(u32 n) { for (stack mut u32 i = 0; i < n; i += 1) { stack u32 x = 0; stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool BindsCleanUnitWithNoDiagnostics()
{
    // Foo resolves as a parameter type; `a` and `x` resolve; no redefinitions.
    stack ascii source = "struct Foo { }\nfn void f(Foo a) { stack u32 x = 0; a; x; }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool BindCompilationUnitCollectsEveryDiagnosticKind()
{
    // Duplicate `Foo` declaration; function `g` with a duplicate parameter `a`, a
    // duplicate local `x`, an undeclared return type `Bar`, and an unbound
    // reference `zzz` — one diagnostic of each kind.
    stack ascii source = "struct Foo { }\nstruct Foo { }\nfn Bar g(i32 a, i32 a) { stack u32 x = 0; stack u32 x = 1; zzz; }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.DuplicateDeclaration) == 1
                && diags.CountOf(BindDiagnosticCode.DuplicateParameter) == 1
                && diags.CountOf(BindDiagnosticCode.DuplicateLocalInBlock) == 1
                && diags.CountOf(BindDiagnosticCode.UnresolvedType) == 1
                && diags.CountOf(BindDiagnosticCode.UnresolvedReference) == 1
                && diags.Count() == 5;
    }
}

[Fact]
fn bool FlagsNonBooleanIdentifierCondition()
{
    // `if (n)` where `n` is an i32 is a non-boolean condition (flagged via the
    // parameter's declared type); `if (b)` (bool) and `if (n < n)` (comparison)
    // are boolean — so exactly one NonBooleanCondition diagnostic.
    stack ascii source = "fn void f(i32 n, bool b) { if (n) { } if (b) { } if (n < n) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.NonBooleanCondition) == 1
                && diags.Count() == 1;
    }
}

[Fact]
fn bool LocalTypedConditionIsFlagged()
{
    // A local `stack u32 count = 0;` gives `count` an integer type, so
    // `while (count)` is a non-boolean condition.
    stack ascii source = "fn void f() { stack u32 count = 0; while (count) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.NonBooleanCondition) == 1;
    }
}

[Fact]
fn bool FlagsNonBooleanLogicalOperand()
{
    // `flag && n`: `flag` is bool (ok) but `n` is i32 — a non-boolean operand of
    // a logical operator. The `&&` result is still bool, so the condition itself
    // is fine: exactly one NonBooleanOperand and no NonBooleanCondition.
    stack ascii source = "fn void f(bool flag, i32 n) { if (flag && n) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.NonBooleanOperand) == 1
                && diags.CountOf(BindDiagnosticCode.NonBooleanCondition) == 0
                && diags.Count() == 1;
    }
}

[Fact]
fn bool BooleanLogicalOperandsAreAccepted()
{
    // Both operands of `&&` are bool — no diagnostics.
    stack ascii source = "fn void f(bool a, bool b) { if (a && b) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}
