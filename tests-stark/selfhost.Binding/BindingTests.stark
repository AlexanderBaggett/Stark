[Fact]
fn bool ForEachIndexAndElementBothResolve()
{
    // The indexed for-each binds both the index `i` and the element `x`; both
    // resolve in the body, as does the traversal `items` — no diagnostics.
    stack ascii source = "fn void f(u32 items) { for willexit (stack u32 i, u32 x in items) { i; x; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool BreakInsideForEachIsAccepted()
{
    // A for-each is a loop, so `break`/`continue` in its body are in an enclosing
    // loop — no BreakOutsideLoop/ContinueOutsideLoop.
    stack ascii source = "fn void f(u32 items) { for willexit (u32 x in items) { break; continue; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.BreakOutsideLoop) == 0
                && diags.CountOf(BindDiagnosticCode.ContinueOutsideLoop) == 0;
    }
}

[Fact]
fn bool BreakInsideCStyleForIsAccepted()
{
    // The C-style `for` is a loop, and the parsed iterator clause (emitted one
    // level deeper) must not displace the `For` as the body's enclosing loop — so
    // `break`/`continue` in the body are accepted.
    stack ascii source = "fn void f(u32 n) { for willexit (stack mut u32 i = 0; i < n; i += 1) { break; continue; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.BreakOutsideLoop) == 0
                && diags.CountOf(BindDiagnosticCode.ContinueOutsideLoop) == 0
                && diags.Count() == 0;
    }
}

[Fact]
fn bool ForEachCollectionDoesNotSeeLoopElement()
{
    // The traversal collection is evaluated in the enclosing scope BEFORE the loop
    // element is bound, so a collection that names the element (`in x`) with no
    // outer `x` is an unresolved reference — not a self-binding.
    stack ascii source = "fn void f() { for willexit (u32 x in x) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.UnresolvedReference) == 1;
    }
}

[Fact]
fn bool ForExpressionListInitReferencesAreResolved()
{
    // A C-style `for` with an expression-list initializer (`i = bad`, not a
    // declaration) has its initializer parsed, so the unbound name `bad` is flagged.
    stack ascii source = "fn void f(u32 n) { stack mut u32 i = 0; for willexit (i = bad; i < n; ) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.UnresolvedReference) == 1
                && diags.Count() == 1;
    }
}

[Fact]
fn bool ForIteratorClauseReferencesAreResolved()
{
    // The iterator clause is parsed, so an unbound name used only there (`bogus`)
