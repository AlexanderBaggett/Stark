fn u32[0 max] TypedMemberSymbolIndexByOwnerAndName(
    borrow TypedMemberSymbolTable symbols,
    ascii source,
    borrow TokenStream stream,
    ascii ownerName,
    ascii memberName,
    TypedMemberSymbolKind memberKind)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = symbols.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0 && symbols.KindAt(index) == memberKind)
        {
            stack ascii actualOwner = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.OwnerNameTokenAt(index));
            stack ascii actualMember = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])symbols.NameTokenAt(index));
            if (System.Text.Equals(actualOwner, ownerName) && System.Text.Equals(actualMember, memberName))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

