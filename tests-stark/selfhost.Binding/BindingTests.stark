fn bool MemoryOk(System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return false;
        case System.Memory.MemoryStatus.Ok:
            return true;
    }
}

fn bool ParseHeaderForBinding(ascii source, out TokenStream stream, out CompilationUnitHeader header)
{
    stream = new();
    header = new();
    stack mut TokenStream parsedStream = new();
    if (!LexOk(LexText(source), parsedStream))
    {
        return false;
    }

    switch (ParseHeader(parsedStream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var error):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var value):
            stream = parsedStream;
            header = value;
            return true;
    }
}

fn u32[0 max] DeclarationStartFromHeader(borrow CompilationUnitHeader header)
{
    stack u64[0 2 ** 63 - 1] count = header.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack HeaderItem item = header.ItemAt(index);
        if (item.Kind == SyntaxKind.ModuleDeclaration)
        {
            return (u32[0 max])(item.NameStart + item.NameTokenCount);
        }
    }

    return 0;
}

fn bool BuildTypedModuleSymbolsForSource(ascii source, out TokenStream stream, out TypedModuleSymbolTable symbols)
{
    stream = new();
    symbols = new();
    stack mut TokenStream parsedStream = new();
    stack mut CompilationUnitHeader header = new();
    if (!ParseHeaderForBinding(source, parsedStream, header))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(parsedStream, DeclarationStartFromHeader(header)))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDecls):
            decls = parsedDecls;
    }

    switch (BuildTypedModuleSymbols(source, parsedStream, header, decls, ModuleOrigin.Source, 9))
    {
        case BindResult<TypedModuleSymbolTable>.Err(var symbolError):
            return false;
        case BindResult<TypedModuleSymbolTable>.Ok(var built):
            stream = parsedStream;
            symbols = built;
            return true;
    }
}

fn bool BuildTypedDeclarationSymbolsForSource(ascii source, out TokenStream stream, out TypedDeclarationSymbolTable declarations)
{
    stream = new();
    declarations = new();
    stack mut TokenStream parsedStream = new();
    stack mut CompilationUnitHeader header = new();
    if (!ParseHeaderForBinding(source, parsedStream, header))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(parsedStream, DeclarationStartFromHeader(header)))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDecls):
            decls = parsedDecls;
    }

    stack mut TypedModuleSymbolTable moduleSymbols = new();
    switch (BuildTypedModuleSymbols(source, parsedStream, header, decls, ModuleOrigin.Source, 9))
    {
        case BindResult<TypedModuleSymbolTable>.Err(var symbolError):
            return false;
        case BindResult<TypedModuleSymbolTable>.Ok(var builtSymbols):
            moduleSymbols = builtSymbols;
    }

    switch (BuildTypedDeclarationSymbols(source, parsedStream, decls, moduleSymbols))
    {
        case BindResult<TypedDeclarationSymbolTable>.Err(var declSymbolError):
            return false;
        case BindResult<TypedDeclarationSymbolTable>.Ok(var builtDeclarations):
            stream = parsedStream;
            declarations = builtDeclarations;
            return true;
    }
}

fn bool BuildCopyabilityFactsForSource(ascii source, out TokenStream stream, out CopyabilityFactTable facts)
{
    stream = new();
    facts = new();
    stack mut TokenStream parsedStream = new();
    stack mut CompilationUnitHeader header = new();
    if (!ParseHeaderForBinding(source, parsedStream, header))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(parsedStream, DeclarationStartFromHeader(header)))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDecls):
            decls = parsedDecls;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, parsedStream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return false;
        case BindResult<DeclarationTable>.Ok(var builtTable):
            table = builtTable;
    }

    switch (BuildCopyabilityFacts(decls, table, source, parsedStream))
    {
        case BindResult<CopyabilityFactTable>.Err(var factError):
            return false;
        case BindResult<CopyabilityFactTable>.Ok(var builtFacts):
            stream = parsedStream;
            facts = builtFacts;
            return true;
    }
}

fn bool CopyabilityFactByName(ascii source, borrow TokenStream stream, borrow CopyabilityFactTable facts, ascii name, out bool copyable)
{
    copyable = false;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack ascii tokenText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])facts.NameTokenAt(index));
        if (System.Text.Equals(tokenText, name))
        {
            copyable = facts.IsCopyableAt(index);
            return true;
        }
    }

    return false;
}

fn bool CopyabilityFactEquals(ascii source, borrow TokenStream stream, borrow CopyabilityFactTable facts, ascii name, bool expected)
{
    stack mut bool copyable = false;
    return CopyabilityFactByName(source, stream, facts, name, copyable) && copyable == expected;
}

