[Fact]
fn bool FlagsBecomeOutsideTailFunction()
{
    stack ascii source = "tail fn i32 done(i32 x) { return x; }\nfn i32 bad(i32 x) { become done(x); }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.BecomeOutsideTailFunction) == 1
                && diags.Count() == 1;
    }
}

