    }
}

[Fact]
fn bool OuterConditionUsesParameterTypeNotInnerShadow()
{
    // The final `if (flag)` resolves to the bool PARAMETER (the inner i32 `flag`
    // is in a closed block, out of scope), so it is a boolean condition — no
    // diagnostic. (A flat last-name-match would wrongly type it i32 and flag it.)
    stack ascii source = "fn void f(bool flag) { if (true) { stack i32 flag = 0; } if (flag) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.NonBooleanCondition) == 0;
    }
}

[Fact]
fn bool OuterConditionUsesParameterTypeNotLaterShadow()
{
    // `if (n)` resolves to the i32 PARAMETER (the bool `n` is declared later in a
    // separate block, out of scope here), so it is a non-boolean condition and is
    // flagged. (A flat last-name-match would wrongly type it bool and miss it.)
    stack ascii source = "fn void f(i32 n) { if (n) { } { stack bool n = true; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.NonBooleanCondition) == 1;
    }
}

[Fact]
fn bool ShiftConditionIsNonBoolean()
{
    // `1 << 2` is a shift (integer result), not a comparison, so `while (1 << 2)`
    // is a non-boolean condition.
    stack ascii source = "fn void f() { while (1 << 2) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.NonBooleanCondition) == 1;
    }
}

[Fact]
fn bool DetectsSameBlockLocalRedefinitionInElseArm()
{
    // Both `x` locals are in the single `else` block (one scope per Stark.g4
    // `ifStatement` else branch), so the same-block rule flags the redefinition.
    stack ascii source = "fn void f() { if (c) { } else { stack u32 x = 0; stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && HasDuplicateLocalInBlock(source, stream, body);
    }
}

[Fact]
fn bool SameNameLocalsInThenAndElseArmsAreSeparate()
{
    // `x` in the then-arm and `x` in the else-arm are in DIFFERENT scopes, so this
    // is shadowing-style separation, not a redefinition.
    stack ascii source = "fn void f() { if (a) { stack u32 x = 0; } else { stack u32 x = 1; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return CountLocals(body) == 2
                && !HasDuplicateLocalInBlock(source, stream, body);
    }
}

