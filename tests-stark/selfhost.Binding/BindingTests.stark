            return diags.CountOf(BindDiagnosticCode.UnresolvedReference) == 1
                && diags.Count() == 1;
    }
}

[Fact]
fn bool CaseVarBindingResolvesInSectionBody()
{
    // A `var x` pattern binding is in scope for the section body, so `x;` resolves;
    // the subject `v` resolves to the parameter. No diagnostics.
    stack ascii source = "fn void f(i32 v) { switch (v) { case Thing(var x): x; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool WhenGuardSeesPatternBindingAndFlagsUnbound()
{
    // The `when` guard resolves in the section scope: the pattern binding `x` is
    // visible there, while an undefined name (`bad`) in the guard is flagged.
    stack ascii source = "fn void f(i32 v) { switch (v) { case Thing(var x) when x > bad: x; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.UnresolvedReference) == 1
                && diags.Count() == 1;
    }
}

[Fact]
fn bool CaseVarBindingIsNotVisibleInOtherSection()
{
    // Each section has its own scope, so a `var x` bound in one section is not
    // visible in another — the sibling section's `x;` is an unresolved reference.
    stack ascii source = "fn void f(i32 v) { switch (v) { case A(var x): x; case B: x; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.UnresolvedReference) == 1;
    }
}

[Fact]
fn bool WhenGuardWithRelationalOperatorResolves()
{
    // A `when` guard's `<` is a relational operator, not an angle bracket — the
    // label colon is still found, the guard `a < b` is parsed, and `a`/`b` resolve.
    stack ascii source = "fn void f(i32 a, i32 b) { switch (a) { case 0 when a < b: a; default: b; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool WhenGuardWithTernaryResolves()
{
    // A `when` guard may be a ternary; its `:` is a branch separator, not the label
    // colon. The guard parses and `a`/`b`/`c` resolve; the section body is intact.
    stack ascii source = "fn void f(bool c, i32 a, i32 b) { switch (a) { case 0 when c ? a > b : a < b: a; default: b; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool OrAlternativesSharingVarNameAreNotDuplicate()
{
    // A `var` bound across `or` alternatives is last-write-wins in the host, not a
    // redefinition — so `case A(var x) or B(var x): x;` is not a DuplicateLocalInBlock
    // and `x` resolves.
    stack ascii source = "fn void f(i32 v) { switch (v) { case A(var x) or B(var x): x; } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.DuplicateLocalInBlock) == 0
                && diags.Count() == 0;
    }
}

[Fact]
fn bool BindsCleanUnitWithNoDiagnostics()
{
    // Foo resolves as a parameter type; `a` and `x` resolve; no redefinitions.
    stack ascii source = "struct Foo { }\nfn void f(Foo a) { stack u32 x = 0; a; x; }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool BindCompilationUnitCollectsEveryDiagnosticKind()
{
    // Duplicate `Foo` declaration; function `g` with a duplicate parameter `a`, a
    // duplicate local `x`, an undeclared return type `Bar`, and an unbound
    // reference `zzz` — one diagnostic of each kind.
    stack ascii source = "struct Foo { }\nstruct Foo { }\nfn Bar g(i32 a, i32 a) { stack u32 x = 0; stack u32 x = 1; zzz; }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.DuplicateDeclaration) == 1
                && diags.CountOf(BindDiagnosticCode.DuplicateParameter) == 1
                && diags.CountOf(BindDiagnosticCode.DuplicateLocalInBlock) == 1
                && diags.CountOf(BindDiagnosticCode.UnresolvedType) == 1
                && diags.CountOf(BindDiagnosticCode.UnresolvedReference) == 1
                && diags.Count() == 5;
    }
}

[Fact]
fn bool FlagsNonBooleanIdentifierCondition()
{
    // `if (n)` where `n` is an i32 is a non-boolean condition (flagged via the
    // parameter's declared type); `if (b)` (bool) and `if (n < n)` (comparison)
    // are boolean — so exactly one NonBooleanCondition diagnostic.
    stack ascii source = "fn void f(i32 n, bool b) { if (n) { } if (b) { } if (n < n) { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.CountOf(BindDiagnosticCode.NonBooleanCondition) == 1
                && diags.Count() == 1;
    }
}

[Fact]
fn bool LocalTypedConditionIsFlagged()
{
    // A local `stack u32 count = 0;` gives `count` an integer type, so
