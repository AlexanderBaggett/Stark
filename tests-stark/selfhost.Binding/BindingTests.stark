[Fact]
fn bool AcceptsWellFormedBecome()
{
    stack ascii source = "tail finite law fn i32 id(i32 x) { return x; }\ntail finite law fn i32 bounce(i32 x) { become id(x); }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (BindCompilationUnit(source, stream))
    {
        case BindResult<BindDiagnosticList>.Err(var error):
            return false;
        case BindResult<BindDiagnosticList>.Ok(var diags):
            return diags.Count() == 0;
    }
}

[Fact]
fn bool DirectRuntimeRecursionBindsWithoutErrors()
{
