[Fact]
fn bool FunctionKindFlagsLawCallingPlainReceiverMethod()
{
    stack mut BindDiagnosticList diags = new();
    if (!BindSource("struct Box { fn void Touch(borrow Box self) { } }\nlaw fn void Caller(Box box) { box.Touch(); }\n", diags))
    {
        return false;
    }

