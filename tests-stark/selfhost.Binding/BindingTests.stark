fn u32[0 max] TypedFunctionEffectIndexByName(borrow TypedFunctionEffectSummaryTable summaries, ascii source, borrow TokenStream stream, ascii name)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = summaries.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0)
        {
            stack ascii actual = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])summaries.NameTokenAt(index));
            if (System.Text.Equals(actual, name))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

