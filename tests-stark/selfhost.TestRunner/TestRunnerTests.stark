import Compiler.TestDriver
import Compiler.TestRunner
import System.Memory
import System.Text
import System.Testing
module SelfhostTestRunnerTests

// Regression facts for the stage1 generated-runner emission
// (docs/Internals/TestProgressProtocol.md §5.1). The plan
// below mirrors tests/fixtures/test-progress/conformance exactly; the emitted
// main block was byte-diffed against stage0's generated runner when this
// landed, and these needles pin every protocol-bearing line so drift in
// either stage breaks the suite.

fn MemoryStatus PushPlainEntry(mut borrow TestRunnerPlan plan, ascii name, ascii call)
{
    stack mut TestRunnerEntryPlan entry = new();
    try entry.SetNames(name, call);
    try plan.PushEntry(entry);
    return MemoryStatus.Ok;
}

fn MemoryStatus PushSkippedEntry(mut borrow TestRunnerPlan plan, ascii name, ascii reason)
{
    stack mut TestRunnerEntryPlan entry = new();
    try entry.SetNames(name, "");
    try entry.SetSkipReason(reason);
    try plan.PushEntry(entry);
    return MemoryStatus.Ok;
}

fn MemoryStatus PushMemberDataEntry(
    mut borrow TestRunnerPlan plan,
    ascii name,
    ascii call,
    ascii localName,
    u32[0 max] rowIndex)
{
    stack mut TestRunnerEntryPlan entry = new();
    try entry.SetNames(name, call);
    try entry.SetMemberDataRow(localName, "CaseRow", "AddCases", rowIndex);
    try plan.PushEntry(entry);
    return MemoryStatus.Ok;
}

fn MemoryStatus PushCollectionEntry(
    mut borrow TestRunnerPlan plan,
    ascii name,
    ascii call,
    u32[0 max] collectionIndex)
{
    stack mut TestRunnerEntryPlan entry = new();
    try entry.SetNames(name, call);
    if (!entry.AddCollectionIndex(collectionIndex, true))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    try plan.PushEntry(entry);
    return MemoryStatus.Ok;
}

fn MemoryStatus EmitConformancePlan(mut borrow OwnedAscii sink)
{
    stack mut TestRunnerPlan plan = new();
    try plan.AddCollectionName("Alpha");
    try plan.AddCollectionName("Beta");

    try PushPlainEntry(plan, "FirstPasses", "FirstPasses()");
    try PushPlainEntry(plan, "SecondFailsByDesign", "SecondFailsByDesign()");
    try PushSkippedEntry(plan, "SkippedOffPlatform", "target does not match [Platform]");
    try PushMemberDataEntry(
        plan,
        "Adds[AddCases:0]",
        "Adds(__stark_member_data_3.Left, __stark_member_data_3.Right, __stark_member_data_3.Expected)",
        "__stark_member_data_3",
        0);
    try PushMemberDataEntry(
        plan,
        "Adds[AddCases:1]",
        "Adds(__stark_member_data_4.Left, __stark_member_data_4.Right, __stark_member_data_4.Expected)",
        "__stark_member_data_4",
        1);
    try PushMemberDataEntry(
        plan,
        "Adds[AddCases:2]",
        "Adds(__stark_member_data_5.Left, __stark_member_data_5.Right, __stark_member_data_5.Expected)",
        "__stark_member_data_5",
        2);
    try PushCollectionEntry(plan, "AlphaOne", "AlphaOne()", 0);
    try PushCollectionEntry(plan, "AlphaTwo", "AlphaTwo()", 0);
    try PushCollectionEntry(plan, "BetaOne", "BetaOne()", 1);
    try PushPlainEntry(plan, "TenthPasses", "TenthPasses()");

    try AppendGeneratedRunnerMain(plan, sink);
    return MemoryStatus.Ok;
}

fn MemoryStatus EmitCollectionFreePlan(mut borrow OwnedAscii sink)
{
    stack mut TestRunnerPlan plan = new();
    try PushPlainEntry(plan, "OnlyFact", "OnlyFact()");
    try PushPlainEntry(plan, "OtherFact", "OtherFact()");
    try AppendGeneratedRunnerMain(plan, sink);
    return MemoryStatus.Ok;
}

[Fact]
fn bool CollectionPlanEmitsProtocolShape()
{
    stack mut OwnedAscii sink = new();
    switch (EmitConformancePlan(sink))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
    }

    stack ascii text = sink.View();
    return System.Testing.Contains(text, "Generated by stark test from")
        && System.Testing.Contains(text, "export fn i32[min max] main()\n{\n    stack mut u8[0 1] failed = 0;\n    stack mut bool progress = false;\n")
        && System.Testing.Contains(text, "    stack mut bool select_0 = false;\n    stack mut bool select_1 = false;\n")
        && System.Testing.Contains(text, "        if (System.Testing.CollectionArgumentEquals(argumentIndex, \"--list-collections\"))\n        {\n            listOnly = true;\n            continue;\n        }\n")
        && System.Testing.Contains(text, "        if (System.Testing.CollectionArgumentEquals(argumentIndex, \"--progress\"))\n        {\n            progress = true;\n            continue;\n        }\n")
        && System.Testing.Contains(text, "        if (System.Testing.CollectionArgumentEquals(argumentIndex, \"Alpha\"))\n        {\n            anyFilter = true;\n            select_0 = true;\n            continue;\n        }\n")
        && System.Testing.Contains(text, "        System.Testing.ReportUnknownCollection();\n        System.Testing.ReportKnownCollection(\"Alpha\");\n        System.Testing.ReportKnownCollection(\"Beta\");\n        return System.Testing.ExitCode(1);\n")
        && System.Testing.Contains(text, "    if (listOnly)\n    {\n        System.Testing.ReportKnownCollection(\"Alpha\");\n        System.Testing.ReportKnownCollection(\"Beta\");\n        return System.Testing.ExitCode(0);\n    }\n")
        && System.Testing.Contains(text, "    if (!anyFilter)\n    {\n    anyExecuted = true;\n    System.Testing.BeginFact(progress, \"FirstPasses\");\n    if (System.Testing.RunFactCounted(progress, 1, 10, \"FirstPasses\", FirstPasses()) != 0)\n    {\n        failed = 1;\n    }\n    }\n")
        && System.Testing.Contains(text, "RunFactCounted(progress, 2, 10, \"SecondFailsByDesign\", SecondFailsByDesign())")
        && System.Testing.Contains(text, "    System.Testing.SkipFact(\"SkippedOffPlatform\", \"target does not match [Platform]\");\n    }\n")
        && System.Testing.Contains(text, "    stack CaseRow __stark_member_data_3 = AddCases(0);\n    System.Testing.BeginFact(progress, \"Adds[AddCases:0]\");\n")
        && System.Testing.Contains(text, "RunFactCounted(progress, 6, 10, \"Adds[AddCases:2]\", Adds(__stark_member_data_5.Left, __stark_member_data_5.Right, __stark_member_data_5.Expected)) != 0")
        && System.Testing.Contains(text, "    if (!anyFilter || select_0)\n    {\n    anyExecuted = true;\n    // Test collection: Alpha\n    System.Testing.BeginFact(progress, \"AlphaOne\");\n")
        && System.Testing.Contains(text, "    if (!anyFilter || select_1)\n    {\n    anyExecuted = true;\n    // Test collection: Beta\n    System.Testing.BeginFact(progress, \"BetaOne\");\n")
        && System.Testing.Contains(text, "RunFactCounted(progress, 10, 10, \"TenthPasses\", TenthPasses()) != 0")
        && System.Testing.Contains(text, "    if (anyFilter && !anyExecuted)\n    {\n        System.Testing.ReportNoFactsSelected();\n        return System.Testing.ExitCode(1);\n    }\n")
        && System.Testing.Contains(text, "    return System.Testing.ExitCode(failed);\n}\n");
}

[Fact]
fn bool CollectionFreePlanParsesProgressFromStandaloneLoop()
{
    stack mut OwnedAscii sink = new();
    switch (EmitCollectionFreePlan(sink))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
    }

    stack ascii text = sink.View();
    return System.Testing.Contains(text, "    stack u64[0 2 ** 63 - 1] progressArgumentCount = System.Testing.CollectionArgumentCount();\n    for willexit (stack mut u64[0 2 ** 63 - 1] progressArgumentIndex = 1; progressArgumentIndex < progressArgumentCount; progressArgumentIndex += 1)\n    {\n        if (System.Testing.CollectionArgumentEquals(progressArgumentIndex, \"--progress\"))\n        {\n            progress = true;\n        }\n    }\n")
        && System.Testing.Contains(text, "    System.Testing.BeginFact(progress, \"OnlyFact\");\n    if (System.Testing.RunFactCounted(progress, 1, 2, \"OnlyFact\", OnlyFact()) != 0)\n    {\n        failed = 1;\n    }\n")
        && System.Testing.Contains(text, "RunFactCounted(progress, 2, 2, \"OtherFact\", OtherFact()) != 0")
        && !System.Testing.Contains(text, "anyFilter")
        && !System.Testing.Contains(text, "select_0");
}

[Fact]
fn bool SkippedEntriesStillConsumeOrdinals()
{
    stack mut OwnedAscii sink = new();
    switch (EmitConformancePlan(sink))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
    }

    // Ordinal 3 belongs to the skipped entry, so no counted call uses it and
    // the next counted call is (4/10): stable entry identity per §3.3.
    stack ascii text = sink.View();
    return !System.Testing.Contains(text, "RunFactCounted(progress, 3, 10,")
        && System.Testing.Contains(text, "RunFactCounted(progress, 4, 10, \"Adds[AddCases:0]\"");
}

[Fact]
[SkipPlatform(windows)]
fn bool DriverStreamsSpawnedRunnerWithPrefixes()
{
    // /bin/echo stands in for a generated runner: with progress enabled the
    // driver appends `--progress` to the argv (echo prints it back) and
    // stamps every forwarded line with a `[N.Ns] ` monotonic prefix
    // (docs/Internals/TestProgressProtocol.md §3.4). Full transcript parity against
    // the conformance-fixture goldens is exercised by the stage0 harness
    // (TestProgressProtocolTests) and was probe-verified for this component
    // when it landed.
    stack mut TestRunTranscript transcript = new();
    unsafe
    {
        if (!RunTestRunner("/bin/echo", true, 0, transcript))
        {
            return false;
        }
    }

    return transcript.ExitCode() == 0
        && !transcript.TimedOut()
        && System.Testing.Contains(transcript.StdoutView(), "s] --progress\n")
        && System.Testing.Contains(transcript.StdoutView(), "[0.");
}
