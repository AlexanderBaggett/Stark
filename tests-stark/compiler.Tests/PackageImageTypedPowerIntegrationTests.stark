import CompilerTestSupport
import System.Testing
module PackageImageTypedPowerIntegrationTests

// Ported from PackageImageTypedPowerIntegrationTests.ManifestBackedTypedPowerBodiesCompileAndRunWithoutSyntheticSource.
internal fn bool ManifestBackedTypedPowerBodiesCompileAndRunWithoutSyntheticSourceImpl()
{
    {
        // PORT-NOTE: The original drives the `--emit-lib -o` CLI path to build a
        // Facade static library, asserts "Emitted static library:" stdout, the
        // .a/.lib and .starkpkg files exist, loads the package-image manifest and
        // verifies the generic template `Facade.Observe` has a TypedBody but no
        // BodyText, rewrites the manifest to drop the source surface (typed-only),
        // deletes the Facade source, then `--emit-exe` links a Demo program that
        // imports the manifest-backed Facade without source, asserting
        // "Emitted executable:" stdout, the output exists, and the linked program
        // exits with code 81 (3 ** 4). The compile helpers cannot express CLI
        // process output, file-system effects, package-image manifest bytes,
        // typed-body-only generic templates, or the runtime exit code, so this is
        // reduced to compiling the Demo root (which imports Facade and calls the
        // generic `Facade.Observe`) together with the Facade library module through
        // the LLVM pipeline and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "pkg-image-typed-power-manifest-backed",
            raw"""
import Facade
module Demo

export fn i32[min max] main()
{
    stack i32[min max] tag = 0;
    return Facade.Observe(3, 4, tag);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn i32[min max] Observe<T>(i32[min max] value, i32[min max] exponent, T tag)
{
    return value ** exponent;
}
""");
        return Succeeds(compiled);
    }
}
