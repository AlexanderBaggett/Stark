import CompilerTestSupport
import System.Testing
module StructLayoutInteropRuntimeTests

// Ported slice of tests/compiler.IntegrationTests/StructLayoutInteropRuntimeTests.cs.
// The original is a native-fixture interop test: it emits an executable that links
// against a C fixture asserting struct sizes/alignments/offsets/field values, runs
// it, and asserts a process exit code of 0. The Stark compile helpers cannot emit
// an executable, link a native source, or observe a runtime exit code, so the Impl
// reduces to driving the embedded Stark program through the closest compile helper
// and asserting Succeeds. See the per-method `// PORT-NOTE:` comment.

// Ported from StructLayoutInteropRuntimeTests.CStructLayoutAttributesMatchNativeCFixturesAtRuntime.
internal fn bool CStructLayoutAttributesMatchNativeCFixturesAtRuntimeImpl()
{
    // PORT-NOTE: original compiles the embedded program with --emit-exe plus a C
    // LayoutFixture.c via --native-source, asserts CLI exit 0 and "Emitted
    // executable:" stdout, runs the executable, and asserts the process exit code
    // is 0 (the C fixture returns non-zero on any size/align/offset/field
    // mismatch). The compile helpers cannot link the native fixture nor observe
    // the runtime exit code; reduced to a full-pipeline compile of the embedded
    // Stark program returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "struct-layout-interop-c-attributes-runtime",
        raw"""
module Demo

[StructLayout(C)]
struct NormalRecord
{
    u8[0 max] Tag;
    u32[0 max] Length;
    u16[0 max] Code;
}

[StructLayout(C), Pack(1), Align(4)]
struct PackedRecord
{
    u8[0 max] Tag;
    u32[0 max] Length;
    u16[0 max] Code;
}

[StructLayout(Explicit), Align(4)]
struct WordParts
{
    [FieldOffset(0)] u32[0 max] Whole;
    [FieldOffset(0)] u16[0 max] Low;
    [FieldOffset(2)] u16[0 max] High;
}

unsafe ffi(c) fn i32[min max] stark_check_layout(
    NormalRecord normal,
    PackedRecord packed,
    WordParts word);

export unsafe fn i32[min max] main()
{
    stack NormalRecord normal = new NormalRecord()
    {
        Tag = 17,
        Length = 287454020,
        Code = 21862
    };
    stack PackedRecord packed = new PackedRecord()
    {
        Tag = 34,
        Length = 1432778632,
        Code = 30600
    };
    stack WordParts word = new WordParts()
    {
        Whole = 305419896
    };

    return stark_check_layout(normal, packed, word);
}
""");
    return Succeeds(compiled);
}
