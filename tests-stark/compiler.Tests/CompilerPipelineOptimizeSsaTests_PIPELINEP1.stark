import CompilerTestSupport
import System.Testing

module CompilerPipelineOptimizeSsaTests_PIPELINEP1

// Ported from CompilerPipelineOptimizeSsaTests.AliasAwareMemoryOptimizationRunsBeforeAbiLowering.
public unsafe fn bool AliasAwareMemoryOptimizationRunsBeforeAbiLoweringImpl()
{
    unsafe
    {
        // PORT-NOTE: the original asserts pass-execution ordering on the pipeline's executed pass
        // ids (memory-opt-ssa runs, and its index precedes both lower-abi and emit-llvm). Pass
        // ordering / execution indices are not expressible via the compile helpers, so this reduces
        // to "the embedded program compiles all the way through LLVM emission" (the original stops
        // after emit-llvm), the closest observable success signal.
        stack mut LlvmCompile compiled = CompileLlvm(
            "alias-aware-memory-optimization-runs-before-abi-lowering",
            raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] value)
{
    stack mut i32[min max] local = value;
    local = local + 1;
    return local;
}
""");
        return Succeeds(compiled);
    }
}
