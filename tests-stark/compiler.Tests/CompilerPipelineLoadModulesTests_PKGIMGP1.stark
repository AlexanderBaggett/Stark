    // and module-graph/syntax-model inspection are not expressible with the Stark helpers;
    // the only genuine Stark source in the test is the Demo consumer program, so this is
    // reduced to compiling that consumer through the full pipeline and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "load-modules-document-resolver-non-reexport-imports",
        raw"""
import Facade
module Demo

fn void Run()
{
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineLoadModulesTests.ManifestBackedModulesPreserveOptimizationReadyGenericTemplateFacts.
public unsafe fn bool ManifestBackedModulesPreserveOptimizationReadyGenericTemplateFactsImpl()
{
    // PORT-NOTE: The C# test builds a package image from the Facade library, strips the
    // manifest down to typed interface + compiler facts + generic templates + compiler
    // sections + an empty source surface, writes the manifest JSON, deletes the source,
    // then re-imports Facade into a consumer (StopAfterPassId "load-modules") and inspects
    // PackageImageFacts.FunctionTemplates for the optimization-ready generic templates:
    // Facade.Wrap (typed body, 2 top-level statements, positive estimated cost,
    // ObjectCreationCount 1, a single "var" local of type T, one Box object creation with
    // null constructor and a single "Value"/index-0/T initializer member), Facade.Read
    // (single-return field-access wrapper over field "Value"/index 0/type T), and
    // Facade.Forward (single-return direct-call forwarder calling Facade.Read with a
    // direct call whose signature returns T and takes a "box" parameter of a Facade.Box
    // type). Package-image construction, manifest round-tripping, filesystem effects,
    // module re-import, and optimization-summary/template-fact inspection are not
    // expressible with the Stark helpers, so this is reduced to compiling the published
    // Facade library program (the source of those optimization facts) through the
    // type-check stage and asserting it succeeds (the precondition for any published
    // optimization-ready template fact).
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "load-modules-manifest-template-optimization-facts-library",
        raw"""
module Facade

public struct Box<T>
{
    T Value;
}

public fn Box<T> Wrap<T>(T value)
{
    stack T copy = value;
    return new Box<T>()
    {
        Value = copy
    };
}

public fn T Read<T>(borrow Box<T> box)
{
    return box.Value;
}

public fn T Forward<T>(borrow Box<T> box)
{
    return Read(box);
}
""");
    return Succeeds(compiled);
}
