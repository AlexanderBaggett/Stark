// Ported from CompilerPipelineFullIntegrationTests.PublicReExportsMakeTransitiveModulesVisibleToTheRootModule.
public unsafe fn bool PublicReExportsMakeTransitiveModulesVisibleToTheRootModuleImpl()
{
    unsafe
    {
        // PORT-NOTE: the original wires TWO modules through an
        // InMemoryModuleResolver -- a Facade that `export import Math` re-exports
        // and the Math module itself -- and asserts result.Succeeded plus the
        // ModuleGraph (HasModule("Math") and an Imports edge from Facade
        // requesting Math that IsExported && IsResolved). The compile helpers
        // can stage only a single imported module file, and the ModuleGraph
        // export-edge probe is not expressible, so this reduces to compiling the
        // root Demo program against its re-exporting Facade module; the
        // transitive Math dependency that Facade re-exports cannot be staged
        // here. The kept signal is "the embedded program plus its imported
        // Facade module type-check" (result.Succeeded).
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "typechkp1-public-reexports-transitive-visibility",
            raw"""
import Facade
module Demo

unsafe fn i32[min max] Run()
{
    return Math.Add(3, 4);
}
""",
            "",
            "Facade.stark",
            raw"""
export import Math
module Facade

public fn i32[min max] Double(i32[min max] value)
{
    return Math.Add(value, value);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.LiteralTypingAndBodyCheckingProduceTypedArtifacts.
public unsafe fn bool LiteralTypingAndBodyCheckingProduceTypedArtifactsImpl()
{
    unsafe
    {
        // PORT-NOTE: the original asserts result.Succeeded, then probes the
        // TypeCheckModel (NamedTypes contains "Widget"; Globals contains
        // "Answer" with Type.DisplayName "u8[42 42]"; Functions["Run"].ReturnType
        // DisplayName "i32"; a Literals entry with LiteralText "null" and
        // Kind == Null). Typed-artifact display names and the literal table are
        // not expressible via the compile helpers, so this reduces to "the
        // embedded program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-literal-typing-body-checking",
            raw"""
module Types

struct Widget
{
    i32[min max] Value;
}

public const Answer = 42;
internal static rawptr<i8[min max]> Buffer = null;

unsafe fn i32[min max] Run()
{
    stack Widget widget = new Widget()
    {
        Value = 1
    };
    stack i32[min max] value = widget.Value + 2;
    return value;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.EnumDeclarationsFlowIntoSyntaxAndTypeModels.
public unsafe fn bool EnumDeclarationsFlowIntoSyntaxAndTypeModelsImpl()
{
    unsafe
    {
        // PORT-NOTE: the original asserts result.Succeeded, then probes the
        // SyntaxModel (Enum "Result" and Enum "Token" declarations) and the
        // TypeCheckModel (NamedTypes "Result" with Kind == Enum, 2 variants,
        // first variant "Ok" carrying a single "T" field; NamedTypes "Token"
        // with Kind == Enum, 3 variants -- unit "End", positional "Integer(i32)",
        // and named-field "Move { X, Y }"). Syntax/type model variant and field
        // probes are not expressible via the compile helpers, so this reduces to
        // "the embedded program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-enum-syntax-type",
            raw"""
module Enums

public enum Result<T, E>
{
    Ok(T),
    Err(E),
}

enum Token
{
    End,
    Integer(i32[min max]),
    Move
    {
        X: i32[min max], Y: i32[min max]
    },
}

fn void Run()
{
    return;
}
""");
        return Succeeds(compiled);
    }
}
