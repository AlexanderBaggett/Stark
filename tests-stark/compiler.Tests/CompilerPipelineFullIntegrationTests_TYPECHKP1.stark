import CompilerTestSupport
import System.Testing

module CompilerPipelineFullIntegrationTests_TYPECHKP1

// Ported slice of tests/compiler.PipelineTests/CompilerPipelineFullIntegrationTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold. PORT-NOTE comments flag assertions the helpers
// cannot express (artifact dictionaries, syntax/type/semantic/effect model
// probes, ModuleGraph export edges, multi-module in-memory resolution) that
// were reduced to the nearest signal.

// Ported from CompilerPipelineFullIntegrationTests.ImportedFunctionsFromLoadedModulesParticipateInTypingAndEffects.
public unsafe fn bool ImportedFunctionsFromLoadedModulesParticipateInTypingAndEffectsImpl()
{
    unsafe
    {
        // PORT-NOTE: the original wires the Math module through an
        // InMemoryModuleResolver and, beyond result.Succeeded, probes the
        // TypeCheckModel (Functions contains "Math.Add") and the
        // FunctionEffectModel ("Math.Add".WillReturn && IsPure). Artifact
        // dictionaries and the effect model are not expressible via the compile
        // helpers, so this reduces to "the embedded program plus its imported
        // Math module type-check successfully" (the result.Succeeded signal).
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "typechkp1-imported-functions-typing-effects",
            raw"""
import Math
module Demo

unsafe fn i32[min max] Run()
{
    return Math.Add(3, 4);
}
""",
            "",
            "Math.stark",
            raw"""
module Math

public finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.DoctrineDeclarationsFlowIntoSyntaxTypeAndSemanticModels.
public unsafe fn bool DoctrineDeclarationsFlowIntoSyntaxTypeAndSemanticModelsImpl()
{
    unsafe
    {
        // PORT-NOTE: the original asserts result.Succeeded, then probes the
        // SyntaxModel (Doctrine "Numbers" and Function "Numbers.Add"
        // declarations), the TypeCheckModel (NamedTypes "Numbers" with
        // Kind == Doctrine, Functions contains "Numbers.Add"), and the
        // SemanticValidationModel (Run.CalledFunctions contains "Numbers.Add").
        // Syntax/type/semantic model probes are not expressible via the compile
        // helpers, so this reduces to "the embedded program type-checks
        // successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-doctrine-syntax-type-semantic",
            raw"""
module Laws

public doctrine Numbers
{
    finite law i32[min max] Add(i32[min max] left, i32[min max] right)
    {
        return left + right;
    }
}

unsafe fn i32[min max] Run()
{
    return Numbers.Add(1, 2);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.TraitDeclarationsFlowIntoSyntaxTypeAndEffectModels.
public unsafe fn bool TraitDeclarationsFlowIntoSyntaxTypeAndEffectModelsImpl()
{
    unsafe
    {
        // PORT-NOTE: the original asserts result.Succeeded, then probes the
        // SyntaxModel (Trait "Comparable" and Function "Comparable.Compare"
        // declarations), the TypeCheckModel (NamedTypes "Comparable" with
        // Kind == Trait, Functions contains "Comparable.Compare"), and the
        // FunctionEffectModel ("Comparable.Compare".IsPure &&
        // !WillReturn). Syntax/type/effect model probes are not expressible via
        // the compile helpers, so this reduces to "the embedded program
        // type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-trait-syntax-type-effect",
            raw"""
module Contracts

public trait Comparable
{
    law i32[min max] Compare(i32[min max] other);
}

unsafe fn i32[min max] Run()
{
    return 0;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.ImportedDoctrineMembersFromLoadedModulesParticipateInTypingAndEffects.
public unsafe fn bool ImportedDoctrineMembersFromLoadedModulesParticipateInTypingAndEffectsImpl()
{
    unsafe
    {
        // PORT-NOTE: the original wires the Math module through an
        // InMemoryModuleResolver and, beyond result.Succeeded, probes the
        // TypeCheckModel (NamedTypes contains "Math.Numbers", Functions contains
        // "Math.Numbers.Add") and the FunctionEffectModel
        // ("Math.Numbers.Add".WillReturn && IsPure). Artifact dictionaries and
        // the effect model are not expressible via the compile helpers, so this
        // reduces to "the embedded program plus its imported Math module
        // type-check successfully".
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "typechkp1-imported-doctrine-members-typing-effects",
            raw"""
import Math
module Demo

unsafe fn i32[min max] Run()
