import CompilerTestSupport
import System.Testing

module PackageImageTryPropagationIntegrationTests_PKGIMGP1

// Ported from PackageImageTryPropagationIntegrationTests.PackageImageRoleAnnotatedEnumsPropagateWithTryAtRuntime.
public unsafe fn bool PackageImageRoleAnnotatedEnumsPropagateWithTryAtRuntimeImpl()
{
    unsafe
    {
        // PORT-NOTE: The original emits the `Outcomes` package via `--emit-lib`,
        // strips/loads its package-image manifest, deletes the package source,
        // then compiles the consumer against the package image alone, runs the
        // produced executable, and asserts the process exit code is 66. The
        // compile helpers cannot express `--emit-lib` package publication,
        // manifest round-tripping, executable emission, or process exit codes,
        // so this is reduced to compiling the consumer `Demo` module against the
        // `Outcomes` dependency module through the LLVM pipeline and asserting it
        // succeeds (the cross-family `try` propagation through the package
        // boundary still type-checks and lowers).
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "pkg-image-try-role-annotated-enums-runtime",
            raw"""
import Outcomes
module Demo

fn Outcomes.AppResult<i32[min max]> Load(i32[min max] x)
{
    // Cross-family propagation through the package boundary: the operand is the
    // imported FetchOutcome (fails with FetchError), the enclosing return type is
    // the imported AppResult (fails with AppError), connected by AppError's
    // `Fetch from FetchError` funnel.
    stack i32[min max] n = try Outcomes.Fetch(x);
    return Outcomes.AppResult<i32[min max]>.Ok(n + 50);
}

export fn i32[min max] main()
{
    stack mut i32[min max] okPart = 0;
    switch (Load(10))
    {
        case Outcomes.AppResult<i32[min max]>.Ok(var v): okPart = v;
        case Outcomes.AppResult<i32[min max]>.Err(var e): okPart = 0;
    }

    stack mut i32[min max] errPart = 0;
    switch (Load(-1))
    {
        case Outcomes.AppResult<i32[min max]>.Ok(var v): errPart = 0;
        case Outcomes.AppResult<i32[min max]>.Err(var e):
            switch (e)
            {
                case Outcomes.AppError.Fetch(var inner): errPart = 5;
                case Outcomes.AppError.Invalid: errPart = 1;
            }
    }

    return okPart + errPart;
}
""",
            "",
            "Outcomes.stark",
            raw"""
module Outcomes

public enum FetchError
{
    Timeout,
    Refused,
}

public enum AppError
{
    Fetch from FetchError,
    Invalid,
}

public enum FetchOutcome<T>
{
    [Ok] Got(T),
    [Err] Failed(FetchError),
}

public enum AppResult<T>
{
    [Ok] Ok(T),
    [Err] Err(AppError),
}

public fn FetchOutcome<i32[min max]> Fetch(i32[min max] x)
{
    if (x < 0)
    {
        return FetchOutcome<i32[min max]>.Failed(FetchError.Timeout);
    }

    return FetchOutcome<i32[min max]>.Got(x + 1);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from PackageImageTryPropagationIntegrationTests.PackageImageTypedOnlyManifestCarriesPropagationRolesAndFunnels.
public unsafe fn bool PackageImageTypedOnlyManifestCarriesPropagationRolesAndFunnelsImpl()
{
    unsafe
    {
        // PORT-NOTE: The original is the same scenario as the runtime test, but
        // it strips the package image down to its structured typed sections
        // (typed interface + compiler facts + generic templates, no source-surface
        // types or legacy flat sections) before the consumer compiles, then runs
        // the executable and asserts exit code 66. The compile helpers cannot
        // express manifest stripping, typed-only section round-tripping,
        // executable emission, or process exit codes, so this is reduced to
        // compiling the same consumer `Demo` module against the `Outcomes`
        // dependency module through the LLVM pipeline and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "pkg-image-try-typed-only-manifest-roles-funnels",
            raw"""
import Outcomes
module Demo

fn Outcomes.AppResult<i32[min max]> Load(i32[min max] x)
{
    // Cross-family propagation through the package boundary: the operand is the
    // imported FetchOutcome (fails with FetchError), the enclosing return type is
    // the imported AppResult (fails with AppError), connected by AppError's
    // `Fetch from FetchError` funnel.
    stack i32[min max] n = try Outcomes.Fetch(x);
    return Outcomes.AppResult<i32[min max]>.Ok(n + 50);
}

export fn i32[min max] main()
{
    stack mut i32[min max] okPart = 0;
    switch (Load(10))
    {
        case Outcomes.AppResult<i32[min max]>.Ok(var v): okPart = v;
        case Outcomes.AppResult<i32[min max]>.Err(var e): okPart = 0;
    }

    stack mut i32[min max] errPart = 0;
    switch (Load(-1))
    {
        case Outcomes.AppResult<i32[min max]>.Ok(var v): errPart = 0;
        case Outcomes.AppResult<i32[min max]>.Err(var e):
            switch (e)
            {
                case Outcomes.AppError.Fetch(var inner): errPart = 5;
                case Outcomes.AppError.Invalid: errPart = 1;
            }
    }

    return okPart + errPart;
}
""",
            "",
            "Outcomes.stark",
            raw"""
module Outcomes

public enum FetchError
{
    Timeout,
    Refused,
}

public enum AppError
{
    Fetch from FetchError,
    Invalid,
}

public enum FetchOutcome<T>
{
    [Ok] Got(T),
    [Err] Failed(FetchError),
}

public enum AppResult<T>
{
    [Ok] Ok(T),
    [Err] Err(AppError),
}

public fn FetchOutcome<i32[min max]> Fetch(i32[min max] x)
{
    if (x < 0)
    {
        return FetchOutcome<i32[min max]>.Failed(FetchError.Timeout);
    }

    return FetchOutcome<i32[min max]>.Got(x + 1);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from PackageImageTryPropagationIntegrationTests.PackageImageExportedGenericTemplateWithTrySpecializesDownstream.
public unsafe fn bool PackageImageExportedGenericTemplateWithTrySpecializesDownstreamImpl()
{
    unsafe
    {
        // PORT-NOTE: The original emits the `Loader` package (whose exported
        // generic `ValidateTwice<T>` body contains two `try` expressions), loads
        // its package image, compiles the consumer against the image so it
        // specializes `ValidateTwice<i32[min max]>` from republished propagation
        // facts without re-type-checking the template body, runs the executable,
        // and asserts exit code 42. The compile helpers cannot express `--emit-lib`
        // publication, manifest round-tripping, executable emission, or process
        // exit codes, so this is reduced to compiling the consumer `Demo` module
        // against the `Loader` dependency module through the LLVM pipeline and
        // asserting it succeeds.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "pkg-image-try-exported-generic-template-specializes",
            raw"""
import Loader
module Demo

export fn i32[min max] main()
{
    stack i32[min max] value = 40;

    stack mut i32[min max] okPart = 0;
    switch (Loader.ValidateTwice(value, true, true))
    {
        case Loader.LoadResult<i32[min max]>.Loaded(var v): okPart = v;
        case Loader.LoadResult<i32[min max]>.Failed(var e): okPart = 0;
    }

    stack mut i32[min max] errPart = 0;
    switch (Loader.ValidateTwice(value, true, false))
    {
        case Loader.LoadResult<i32[min max]>.Loaded(var v): errPart = 0;
        case Loader.LoadResult<i32[min max]>.Failed(var e): errPart = 2;
    }

    return okPart + errPart;
}
""",
            "",
            "Loader.stark",
            raw"""
module Loader

public enum LoadError
{
    Empty,
    TooBig,
}

public enum LoadResult<T>
{
    [Ok] Loaded(T),
    [Err] Failed(LoadError),
}

public fn LoadResult<T> Validate<T>(T value, bool ok)
{
    if (!ok)
    {
        return LoadResult<T>.Failed(LoadError.Empty);
    }

    return LoadResult<T>.Loaded(value);
}

public fn LoadResult<T> ValidateTwice<T>(T value, bool first, bool second)
{
    stack T a = try Validate(value, first);
    stack T b = try Validate(a, second);
    return LoadResult<T>.Loaded(b);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from PackageImageTryPropagationIntegrationTests.PackageImagePublishesTryPropagationFactsForExportedTemplates.
public unsafe fn bool PackageImagePublishesTryPropagationFactsForExportedTemplatesImpl()
{
    unsafe
    {
        // PORT-NOTE: The original emits the `Loader` package via `--emit-lib`,
        // asserts the CLI exit code is 0 and the `.starkpkg` manifest exists,
        // loads the manifest, and inspects the published structured facts: that
        // the `LoadResult` variants keep their "ok"/"err" roles in the typed
        // interface, that the exported template `Loader.ValidateOnce` republishes
        // a single try-propagation fact (ordinal 0, operand ok/err variant names
        // "Loaded"/"Failed", enclosing err variant name "Failed"), and that
        // `Loader.Validate` (no `try` in its body) publishes no try facts. The
        // compile helpers cannot express `--emit-lib` publication, package-image
        // manifest loading, or inspection of typed-interface/generic-template
        // fact tables, so this is reduced to compiling the `Loader` module (as a
        // dependency) with a minimal consumer that exercises both exported
        // templates through the LLVM pipeline and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "pkg-image-try-publishes-propagation-facts",
            raw"""
import Loader
module Demo

export fn i32[min max] main()
{
    stack mut i32[min max] result = 0;
    switch (Loader.ValidateOnce(7, true))
    {
        case Loader.LoadResult<i32[min max]>.Loaded(var v): result = v;
        case Loader.LoadResult<i32[min max]>.Failed(var e): result = 0;
    }

    switch (Loader.Validate(3, true))
    {
        case Loader.LoadResult<i32[min max]>.Loaded(var v): result = result + v;
        case Loader.LoadResult<i32[min max]>.Failed(var e): result = result + 0;
    }

    return result;
}
""",
            "",
            "Loader.stark",
            raw"""
module Loader

public enum LoadError { Empty }

public enum LoadResult<T>
{
    [Ok] Loaded(T),
    [Err] Failed(LoadError),
}

public fn LoadResult<T> Validate<T>(T value, bool ok)
{
    if (!ok)
    {
        return LoadResult<T>.Failed(LoadError.Empty);
    }

    return LoadResult<T>.Loaded(value);
}

public fn LoadResult<T> ValidateOnce<T>(T value, bool ok)
{
    stack T checked = try Validate(value, ok);
    return LoadResult<T>.Loaded(checked);
}
""");
        return Succeeds(compiled);
    }
}
