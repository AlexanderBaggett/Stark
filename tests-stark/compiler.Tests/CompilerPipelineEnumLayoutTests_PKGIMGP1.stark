import CompilerTestSupport
import System.Testing
module CompilerPipelineEnumLayoutTests_PKGIMGP1

// Ported from CompilerPipelineEnumLayoutTests.ManifestBackedModulesPreservePublishedLayoutFactsFromCompilerFactSections.
public unsafe fn bool ManifestBackedModulesPreservePublishedLayoutFactsFromCompilerFactSectionsImpl()
{
    // PORT-NOTE: The C# test builds a package image from the Facade library, strips
    // its untyped sections down to the typed interface + compiler facts, writes the
    // manifest JSON, deletes the source, then re-imports Facade into a consumer and
    // inspects PackageImageFacts.ConcreteLayouts / EnumLayouts and the EnumLayoutModel
    // (Padded size/align 8/4, Token DirectTag with $tag/$Move_X/$Move_Y). The Stark
    // helpers cannot model package-image construction, manifest round-tripping,
    // filesystem effects, or layout-fact inspection, so this is reduced to compiling
    // the published Facade library program through the enum-layout stage and asserting
    // it succeeds (the precondition for any published layout fact).
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "enum-layout-manifest-facts-library",
        raw"""
module Facade

public struct Padded
{
    i8[min max] Small;
    i32[min max] Value;
}

public enum Token
{
    End,
    Move
    {
        X: i32[min max], Y: i32[min max]
    },
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineEnumLayoutTests.PackageImagesPreserveGenericResultAndStatusEnumLayouts.
public unsafe fn bool PackageImagesPreserveGenericResultAndStatusEnumLayoutsImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, asserts
    // the compiler-fact EnumLayouts for CommonError/CommonStatus/CommonResult (tag bit
    // widths, range bounds, ordered field names), writes the manifest, then re-imports
    // Facade into a consumer that monomorphizes CommonResult<i32[min max]> and checks
    // the concrete enum layout. Package-image bytes, manifest JSON, filesystem effects,
    // and layout-fact inspection are not expressible with the Stark helpers, so this is
    // reduced to compiling the published Facade library program through the enum-layout
    // stage and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "enum-layout-generic-result-status-library",
        raw"""
module Facade

public enum CommonError
{
    NotFound,
    PermissionDenied,
    Unknown(i32[min max]),
}

public enum CommonStatus
{
    Ok,
    Err(CommonError),
}

public enum CommonResult<T>
{
    Ok(T),
    Err(CommonError),
}
""");
    return Succeeds(compiled);
}
