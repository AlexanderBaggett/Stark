import CompilerTestSupport
import System.Testing
module OwnershipFieldReadAfterMoveRegressionTests

// Ported slice of tests/compiler.Tests/OwnershipFieldReadAfterMoveRegressionTests.cs.
//
// Field-read-after-move regressions: dynamic storage header reads
// (`moved.Field.Length` / `.Capacity`) used to bypass the moved-root check.
// Each C# test embeds a Stark program and routes it through the type-check
// pipeline. The rejection tests' AssertMoveError helper asserts both
// `!Succeeded` and a STK4200 diagnostic, which FailsWithDiagnostic captures.
// The constructor-flow test asserts success.

// Ported from OwnershipFieldReadAfterMoveRegressionTests.DynamicLengthReadOnDefinitelyMovedRootErrors.
internal fn bool DynamicLengthReadOnDefinitelyMovedRootErrorsImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-dynamic-length-read-on-definitely-moved-root",
            raw"""
module Demo

struct Payload
{
    dynamic i64[min max] Items;
    i64[min max] Count;

    Payload()
    {
        self.Items = new();
        self.Count = 0;
    }
}

fn bool Consume(Payload payload)
{
    return true;
}

fn i64[min max] Build()
{
    stack mut Payload payload = new();
    stack bool sink = Consume(payload);
    return payload.Items.Length;
}
""");
        return FailsWithDiagnostic(compiled, "STK4200");
    }
}

