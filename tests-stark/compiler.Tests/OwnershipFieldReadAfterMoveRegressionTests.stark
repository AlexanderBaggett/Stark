// Ported from OwnershipFieldReadAfterMoveRegressionTests.DynamicLengthReadOnMaybeMovedRootErrors.
internal fn bool DynamicLengthReadOnMaybeMovedRootErrorsImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-dynamic-length-read-on-maybe-moved-root",
            raw"""
module Demo

struct Payload
{
    dynamic i64[min max] Items;
    i64[min max] Count;

    Payload()
    {
        self.Items = new();
        self.Count = 0;
    }
}

fn bool Consume(Payload payload)
{
    return true;
}

fn i64[min max] Build(bool flag)
{
    stack mut Payload payload = new();
    if (flag)
    {
        stack bool sink = Consume(payload);
    }

    return payload.Items.Length;
}
""");
        return FailsWithDiagnostic(compiled, "STK4200");
    }
}

// Ported from OwnershipFieldReadAfterMoveRegressionTests.DynamicMemberCallOnMovedReceiverErrors.
internal fn bool DynamicMemberCallOnMovedReceiverErrorsImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-dynamic-member-call-on-moved-receiver",
            raw"""
module Demo

struct Payload
{
    dynamic i64[min max] Items;
    i64[min max] Count;

    Payload()
    {
        self.Items = new();
        self.Count = 0;
    }
}

fn bool Consume(Payload payload)
{
    return true;
}

fn i64[min max] Build()
{
    stack mut Payload payload = new();
    stack bool sink = Consume(payload);
    if (!payload.Items.TryReserve(1))
    {
        return 0;
    }

    return 1;
}
""");
        return FailsWithDiagnostic(compiled, "STK4200");
    }
}

