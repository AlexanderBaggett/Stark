// Ported from OwnershipFieldReadAfterMoveRegressionTests.ConstructorReadsAssignedDynamicFieldHeaderLegally.
internal fn bool ConstructorReadsAssignedDynamicFieldHeaderLegallyImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-constructor-reads-assigned-dynamic-field-header-legally",
            raw"""
module Demo

struct Payload
{
    dynamic i64[min max] Items;
    i64[min max] Count;

    Payload()
    {
        self.Items = new();
        self.Count = self.Items.Length;
    }
}

fn i64[min max] Build()
{
    stack Payload payload = new();
    return payload.Count;
}
""");
        return Succeeds(compiled);
    }
}
