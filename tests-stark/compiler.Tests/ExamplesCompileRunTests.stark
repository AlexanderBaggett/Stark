import CompilerTestSupport
import System
import System.Console
import System.Testing
import System.Text
module ExamplesCompileRunTests

// Ported slice of tests/compiler.IntegrationTests/ExamplesCompileRunTests.cs.
// The C# tests load each program from disk (examples/*.stark), build a native
// executable through the CLI, run it, and assert on the process exit code,
// stdout, stderr, and file-system side effects (and, for the stdlib-package
// cases, on a freshly built System library / package image). None of those
// native-toolchain, process-execution, or file-system effects are expressible
// through the host test protocol, so every Impl embeds the example program
// verbatim and reduces to "the program compiles through the full pipeline"
// (the closest observable signal). Each reduction is flagged with `// PORT-NOTE:`.

// Ported from ExamplesCompileRunTests.HelloExampleCompilesAndRunsWithStdlibPackage.
// PORT-NOTE: original builds a System stdlib package, links hello against it,
// runs it, and asserts exit 0 with stdout "Hello, World!\n". Stdlib-package
// build, native link, process run, and stdout capture are not expressible here;
// reduced to full-pipeline compile success of the embedded program.
internal fn bool HelloExampleCompilesAndRunsWithStdlibPackageImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "examples-hello",
        raw"""
import System.Console
module Hello

export fn i32[min max] main() {
    WriteLine("Hello, World!");
    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from ExamplesCompileRunTests.MultiModuleExampleCompilesAndRuns.
// PORT-NOTE: original compiles examples/multi-module/App.stark (which imports the
// sibling Math module resolved from disk) into an executable and asserts exit 7.
// Native run and exit-code capture are not expressible, and the sibling Math
// module is not embedded; reduced to full-pipeline compile of the App entry point.
internal fn bool MultiModuleExampleCompilesAndRunsImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "examples-multi-module",
        raw"""
import Math
module App

export fn i32[min max] main() {
    return Math.Add(3, 4);
}
""");
    return Succeeds(compiled);
}

// Ported from ExamplesCompileRunTests.BasicSyntaxExampleCompilesAndRuns.
// PORT-NOTE: original runs the executable and asserts exit 0 / empty stdout/stderr;
// reduced to full-pipeline compile success.
internal fn bool BasicSyntaxExampleCompilesAndRunsImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "examples-basic-syntax",
        raw"""
module BasicSyntax

const ExpectedAnswer = 42;

finite law i32[min max] Add(
    i32[min max] left,
    i32[min max] right)
{
    return left + right;
}

finite law i32[min max] SumPrefix(u8[0 10] count) {
    stack mut u8[0 10] index = 0;
    stack mut i32[min max] total = 0;

    while willexit (index < count) {
        total += (i32[min max])index;
        index += 1;
    }

    return total;
}

finite law bool IsExpectedAnswer(i32[min max] value) {
    switch (value) {
        case 42:
            return true;
        default:
            return false;
    }
}

export fn i32[min max] main() {
    stack i32[min max] answer = Add(20, 22);
    if (answer != ExpectedAnswer || !IsExpectedAnswer(answer)) {
        return 1;
    }

    if (SumPrefix(4) != 6) {
        return 2;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from ExamplesCompileRunTests.TypeSystemExampleCompilesAndRuns.
// PORT-NOTE: original runs the executable and asserts exit 0 / empty stdout/stderr;
// reduced to full-pipeline compile success.
internal fn bool TypeSystemExampleCompilesAndRunsImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "examples-type-system",
        raw"""
module TypeSystem

alias Score = u8[0 100];

struct Reading {
    Score Value;
    bool Trusted;
}

record WeightedScore(Score Value, u8[1 10] Weight) { }

enum Assessment {
    Missing,
    Fail(Score),
    Pass(Score),
}

finite law Assessment Classify(Reading reading) {
    if (!reading.Trusted) {
        return Assessment.Missing;
    }

    if (reading.Value >= 60) {
        return Assessment.Pass(reading.Value);
    }

    return Assessment.Fail(reading.Value);
}

finite law bool Passed(Assessment assessment) {
    return assessment == Assessment.Pass(72);
}

export fn i32[min max] main() {
    stack Reading reading = new Reading() {
        Value = 72,
        Trusted = true
    };
    stack WeightedScore weighted = new WeightedScore(reading.Value, 2);
    stack Assessment assessment = Classify(reading);

    if (!Passed(assessment)) {
        return 1;
    }

    if (weighted.Value * weighted.Weight != 144) {
        return 2;
    }

    if (Assessment.Missing == Assessment.Fail(72)) {
        return 3;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from ExamplesCompileRunTests.ModulesExampleCompilesAndRuns.
// PORT-NOTE: original compiles examples/modules/App.stark (imports sibling Geometry
// and Units modules resolved from disk) and asserts exit 0. Native run and the
// sibling modules are not embedded; reduced to full-pipeline compile of the entry point.
internal fn bool ModulesExampleCompilesAndRunsImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "examples-modules",
        raw"""
import Geometry
import Units
module App

export fn i32[min max] main() {
    stack Geometry.Rectangle areaRectangle = new Geometry.Rectangle() {
        Width = Units.Six(),
        Height = Units.Seven()
    };

    if (Geometry.Area(areaRectangle) != 42) {
        return 1;
    }

    stack Geometry.Rectangle scaledRectangle = new Geometry.Rectangle() {
        Width = Units.Six(),
        Height = Units.Seven()
    };

    if (Geometry.ScaleArea(scaledRectangle, 2) != 84) {
        return 2;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from ExamplesCompileRunTests.BorrowingExamplesCompileAndRun.
// PORT-NOTE: original iterates four example programs (Borrowing, OwnershipMoves,
// BorrowKinds, OutParameters), compiles each to a native executable, and asserts
// exit 0 / empty stdout/stderr for each. Native run is not expressible; reduced to
// full-pipeline compile success of all four embedded programs (true iff all pass).
internal fn bool BorrowingExamplesCompileAndRunImpl()
{
    stack mut LlvmCompile borrowing = CompileFull(
        "examples-borrowing-borrowing",
        raw"""
module Borrowing

struct Counter {
    i32[min max] Value;

    finite void Add(mut borrow Counter self, i32[min max] amount) {
        self.Value += amount;
        return;
    }

    finite law i32[min max] Current(borrow Counter self) {
        return self.Value;
    }

    finite law i32[min max] ReadTwice(borrow Counter self) {
        return self.Current() + self.Current();
    }

    finite retborrow mut i32[min max] Slot(mut borrow Counter self) {
        return self.Value;
    }
}

export fn i32[min max] main() {
    stack mut Counter counter = new Counter() {
        Value = 2
    };

    counter.Add(3);

    if (counter.Current() != 5) {
        return 1;
    }

    if (counter.ReadTwice() != 10) {
        return 2;
    }

    counter.Slot() = 8;

    if (counter.Current() != 8) {
        return 3;
    }

    return 0;
}
""");

    stack mut LlvmCompile ownershipMoves = CompileFull(
        "examples-borrowing-ownership-moves",
        raw"""
module Borrowing.OwnershipMoves

struct Box {
    i32[min max] Value;
}

fn void Consume(Box value) {
    return;
}

finite law i32[min max] ScalarsCopy() {
    stack i32[min max] left = 10;
    stack i32[min max] right = left;
    return left + right;
}

fn i32[min max] MoveThenReinitialize() {
    stack mut Box box = new Box() {
        Value = 1
    };

    Consume(box);

    box = new Box() {
        Value = 2
    };

    return box.Value;
}

export fn i32[min max] main() {
    if (ScalarsCopy() != 20) {
        return 1;
    }

    if (MoveThenReinitialize() != 2) {
        return 2;
    }

    return 0;
}
""");

    stack mut LlvmCompile borrowKinds = CompileFull(
        "examples-borrowing-borrow-kinds",
        raw"""
module Borrowing.BorrowKinds

struct Counter {
    i32[min max] Value;

    finite law i32[min max] Current(borrow Counter self) {
        return self.Value;
    }

    finite void Add(mut borrow Counter self, i32[min max] amount) {
        self.Value += amount;
        return;
    }

    finite retborrow mut i32[min max] Slot(mut borrow Counter self) {
        return self.Value;
    }
}

export fn i32[min max] main() {
    stack mut Counter counter = new Counter() {
        Value = 4
    };

    counter.Add(5);

    if (counter.Current() != 9) {
        return 1;
    }

    counter.Slot() = 12;

    if (counter.Current() != 12) {
        return 2;
    }

    return 0;
}
""");

    stack mut LlvmCompile outParameters = CompileFull(
        "examples-borrowing-out-parameters",
        raw"""
module Borrowing.OutParameters

fn bool TryDivide(i32[min max] numerator, i32[min max] denominator, out i32[min max] result) {
    if (denominator == 0) {
        result = 0;
        return false;
    }

    result = numerator / denominator;
    return true;
}

export fn i32[min max] main() {
    stack mut i32[min max] result = 0;

    if (!TryDivide(21, 3, result)) {
        return 1;
    }

    if (result != 7) {
        return 2;
    }

    if (TryDivide(21, 0, result)) {
        return 3;
    }

    if (result != 0) {
        return 4;
    }

    return 0;
}
""");

    return Succeeds(borrowing)
        && Succeeds(ownershipMoves)
        && Succeeds(borrowKinds)
        && Succeeds(outParameters);
}

