import CompilerTestSupport
import System.Testing
module PackageImageTypedObjectInitializerLocalDeclarationIntegrationTests

// Ported from PackageImageTypedObjectInitializerLocalDeclarationIntegrationTests.ManifestBackedTypedObjectInitializerLocalDeclarationsCompileAndRunWithoutSyntheticSource.
internal fn bool ManifestBackedTypedObjectInitializerLocalDeclarationsCompileAndRunWithoutSyntheticSourceImpl()
{
    {
        // Covers manifest-backed object initializer local bodies from package image through runtime execution.
        return CompileAndRunTypedOnlyPackage(
            "manifest-backed-typed-object-initializer-local-declarations",
            raw"""
import Facade
module Demo

export fn i32[min max] main()
{
    return Facade.Observe(7, 0);
}
""",
            "Facade",
            raw"""
module Facade

public record Pair(i32[min max] First, i32[min max] Second)
{
}

public fn i32[min max] Observe<T>(i32[min max] value, T tag)
{
    stack Pair pair =
    {
        First = value, Second = value + 1
    };
    return pair.First + pair.Second;
}
""",
            "Facade.Observe",
            "",
            15);
    }
}
