// Ported slice of tests/compiler.PipelineTests/CompilerPipelineFullIntegrationTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold. PORT-NOTE comments flag assertions the helpers
// cannot express (artifact dictionaries, syntax/type/semantic/effect model
// probes, ModuleGraph export edges, multi-module in-memory resolution) that
// were reduced to the nearest signal.

// Ported from CompilerPipelineFullIntegrationTests.ImportedFunctionsFromLoadedModulesParticipateInTypingAndEffects.
internal fn bool ImportedFunctionsFromLoadedModulesParticipateInTypingAndEffectsImpl()
{
    {
        // PORT-NOTE: the original wires the Math module through an
        // InMemoryModuleResolver and, beyond result.Succeeded, probes the
        // TypeCheckModel (Functions contains "Math.Add") and the
        // FunctionEffectModel ("Math.Add".WillReturn && IsPure). Artifact
        // dictionaries and the effect model are not expressible via the compile
        // helpers, so this reduces to "the embedded program plus its imported
        // Math module type-check successfully" (the result.Succeeded signal).
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "typechkp1-imported-functions-typing-effects",
            raw"""
import Math
module Demo

unsafe fn i32[min max] Run()
{
    return Math.Add(3, 4);
}
""",
            "",
            "Math.stark",
            raw"""
module Math

public finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}
""");
        return Succeeds(compiled);
    }
}

