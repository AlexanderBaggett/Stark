}

// Ported from CompilerPipelineFullIntegrationTests.AsmDeclarationsSelectTheMatchingTargetAndPreserveSyntaxMetadata.
internal fn bool AsmDeclarationsSelectTheMatchingTargetAndPreserveSyntaxMetadataImpl()
{
    {
        // PORT-NOTE: the original supplies the System.Syscall module via an InMemoryModuleResolver and,
        // beyond asserting result.Succeeded, inspects the loaded module's SyntaxModel to confirm that the
        // x86_64 asm target was selected (Architecture/ArchitectureText "x86_64", TemplateText "syscall",
        // the rax/rdi/rsi/rdx inputs, the rax->return output binding the return value, and the rcx/r11
        // clobbers) and that the FunctionEffectModel marks System.Syscall.Syscall3 as IsFfi. Loaded-module
        // SyntaxModel access, asm metadata, and the FunctionEffectModel are not expressible via the compile
        // helpers, so this reduces to "the embedded program plus its imported System.Syscall module
        // type-check successfully" (the result.Succeeded signal).
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "asm-decls-select-matching-target-preserve-syntax-metadata",
            raw"""
import System.Syscall
module Demo

unsafe fn i32[min max] Run()
{
    return 0;
}
""",
            "/virtual/System",
            "Syscall.stark",
            raw"""
module System.Syscall

public unsafe ffi asm(x86_64) fn i64[min max] Syscall3(i64[min max] number, i64[min max] arg1, i64[min max] arg2, i64[min max] arg3)
    in("rax") number,
    in("rdi") arg1,
    in("rsi") arg2,
    in("rdx") arg3,
    out("rax") return,
    clobber("rcx", "r11")
{
    "syscall"
}

public unsafe ffi asm(aarch64) fn i64[min max] Syscall3(i64[min max] number, i64[min max] arg1, i64[min max] arg2, i64[min max] arg3)
    in("x8") number,
    in("x0") arg1,
    in("x1") arg2,
    in("x2") arg3,
    out("x0") return,
    clobber("x8")
{
    "svc #0"
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.MinimalModuleRunsThroughTheFullPipeline.
internal fn bool MinimalModuleRunsThroughTheFullPipelineImpl()
{
    {
        // PORT-NOTE: the original asserts the full pipeline succeeded, then probes a long list of
        // intermediate artifacts (SyntaxModel with ModuleName "Demo", SemanticValidation,
        // SpecializationPlan, SpecializationCodegenStrategy, OwnershipValidation,
        // LoweringContractValidation, AbiModel, SsaIr, OptimizedSsaIr), that exactly 43 passes
        // Executed, and that a verbose "pass-completed" pipeline log was emitted for stage
        // "emit-llvm". Per-artifact presence, pass-execution counts, and pipeline lifecycle logs
        // are not expressible via the compile helpers, so this reduces to "the embedded program
        // compiles through the full pipeline and the emitted LLVM IR carries the Demo module id"
        // (the closest observable signals: full-pipeline success plus the ModuleID LLVM artifact
        // substring the original checks via llvmModule.Text).
        stack mut LlvmCompile compiled = CompileLlvm(
            "minimal-module-runs-through-the-full-pipeline",
            raw"""
module Demo
""");
        return Succeeds(compiled)
            && System.Testing.Contains(Llvm(compiled), "ModuleID = 'Demo'");
    }
}

