// Ported from CompilerPipelineFullIntegrationTests.ManifestBackedTypeAliasesRoundTripWithoutSourceFiles.
internal fn bool ManifestBackedTypeAliasesRoundTripWithoutSourceFilesImpl()
{
    {
        // PORT-NOTE: The original publishes the Facade library to a package image, asserts the published
        // type aliases (BufferView/ExportedPair/PublicPair with their visibilities and target types, while
        // the internal HiddenPair is dropped), writes the manifest, deletes the source, then re-imports
        // Facade into a Demo consumer and asserts the round-tripped alias declarations and TypeCheckModel
        // keys. Package-image construction, manifest round-tripping, filesystem effects, and the import
        // resolver are not expressible with the compile helpers, so this reduces to type-checking the
        // embedded Facade library (the publishable surface) and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "manifest-type-aliases-round-trip",
            raw"""
module Facade

public struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

alias HiddenPair = Pair;
public alias PublicPair = HiddenPair;
export alias ExportedPair = HiddenPair;
public alias BufferView<T> = T[];

public finite law i32[min max] Left(PublicPair value, BufferView<i32[min max]> view)
{
    return value.Left + view[0];
}
""");
        return Succeeds(compiled);
    }
}

