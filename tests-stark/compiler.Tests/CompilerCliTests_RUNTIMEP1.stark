public unsafe fn bool EmitObjectModeWritesObjectFileImpl()
{
    // PORT-NOTE: original asserts --emit-obj exit 0, "Emitted object file:"
    // stdout, and a non-empty object file on disk. Reduced to a full-pipeline
    // compile of the embedded program returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "cli-emit-obj-writes-object",
        raw"""
module Demo

fn i32[min max] Run()
{
    return 7;
}
""");
    return Succeeds(compiled);
}

