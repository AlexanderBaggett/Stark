public unsafe fn bool CompileOnlyAliasWritesObjectFileImpl()
{
    // PORT-NOTE: original asserts the --compile-only alias behaves like
    // --emit-obj: exit 0, "Emitted object file:" stdout, and a non-empty object
    // file on disk. Reduced to a full-pipeline compile of the embedded program
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
