// Ported from TypeCheckingTests.ClosureTypesResolveInFunctionSignatures.
internal fn bool ClosureTypesResolveInFunctionSignaturesImpl()
{
    {
        // PORT-NOTE: original probes TypeCheckModel parameter/return closure facts
        // (inline storage, borrow kind, mut/once call capability, function kind,
        // overlap group ["arg0","arg1"], bounded raw-pointer count expr "arg1",
        // heap return storage). Closure artifact probes are not expressible, so
        // this reduces to result.Succeeded.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-closure-types-in-signatures",
            raw"""
module Demo

struct Ui
{
    i32[min max] Frame;
}

struct Packet
{
    i32[min max] Code;
}

fn void RegisterInline(inline closure<fn void(borrow mut Ui)> body);
fn void RegisterBorrow(borrow closure<fn void(borrow mut Ui)> body);
fn void RegisterMut(mut borrow closure<mut fn void(i32[min max])> sink);
fn void RegisterOnce(inline closure<once finite Packet()> producer);
fn void RegisterOverlap(borrow closure<fn void(borrow mut Ui, borrow mut Ui) where overlap(arg0, arg1)> body);
unsafe fn void RegisterBounded(borrow closure<finite void(rawptr<i32[min max]>[arg1], u8[1 10])> body);
fn heap closure<fn i32[min max](i32[min max])> Factory(heap closure<fn i32[min max](i32[min max])> seed);
""");
        return Succeeds(compiled);
    }
}

