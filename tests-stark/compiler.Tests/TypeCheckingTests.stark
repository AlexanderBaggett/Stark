        "diagp1-rawptr-signature-requires-unsafe",
        raw"""
module Demo

fn void Touch(rawptr<i32[min max]> pointer);
""");

    return FailsWithDiagnosticMessage(compiled, "STK3024", "uses raw pointer types and must be declared 'unsafe'");
}

// Ported from TypeCheckingTests.RawPointerLocalOperationsRequireUnsafeContext.
internal fn bool RawPointerLocalOperationsRequireUnsafeContextImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-rawptr-local-ops-require-unsafe",
        raw"""
module Demo

fn void Run()
{
    stack mut i32[min max] value = 1;
    stack rawmutptr<i32[min max]> pointer = &value;
    *pointer = 2;
    return;
}
""");

    return FailsWithDiagnostic(compiled, "STK3024")
        && AnyDiagnosticMessageContains(compiled, "local raw pointer declarations")
        && AnyDiagnosticMessageContains(compiled, "Raw pointer address-of operator")
        && AnyDiagnosticMessageContains(compiled, "Raw pointer dereference operator");
}

