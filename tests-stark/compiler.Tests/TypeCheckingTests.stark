// Ported from TypeCheckingTests.TextLiteralsHaveConstProvenanceForConstParameters.
internal fn bool TextLiteralsHaveConstProvenanceForConstParametersImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-text-literals-const-provenance",
            raw"""
module Demo

fn bool AcceptAscii(const ascii value)
{
    return true;
}

fn bool AcceptUnicode(const unicode value)
{
    return true;
}

fn bool Run()
{
    return AcceptAscii("alpha")
        && AcceptAscii("al" + "pha")
        && AcceptAscii((ascii)"alpha")
        && AcceptUnicode((unicode)"alpha");
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.ImportedSourceConstantAliasesResolveInDeclaringModuleScope.
internal fn bool ImportedSourceConstantAliasesResolveInDeclaringModuleScopeImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "typechkp3-imported-source-const-aliases-module-scope",
            raw"""
import Lib.Native
module Demo

fn i32[min max] Run()
{
    return Alias + Next;
}
""",
            "Lib",
            "Native.stark",
            raw"""
module Lib.Native

public const Base = 15;
public const Alias = Base;
public const Next = Alias + 1;
""");
        return Succeeds(compiled);
    }
}
