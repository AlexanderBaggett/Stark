// Ported from TypeCheckingTests.LambdasTypeCheckAsExplicitClosureTargets.
internal fn bool LambdasTypeCheckAsExplicitClosureTargetsImpl()
{
    {
        // PORT-NOTE: original probes TypeCheckModel (empty Lambdas, 3
        // ClosureLambdas covering Inline/Borrow/Heap, capture "offset" mode
        // "copy"). Closure-lambda/capture artifact probes are not expressible, so
        // this reduces to result.Succeeded.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-lambdas-closure-targets",
            raw"""
module Demo

fn i32[min max] ApplyBorrow(borrow closure<fn i32[min max](i32[min max])> op)
{
    return 0;
}

fn void ApplyInline(inline closure<fn void(i32[min max])> op)
{
    return;
}

fn heap closure<fn i32[min max](i32[min max])> MakeHeap(i32[min max] offset)
{
    return heap capture(copy offset) (i32[min max] value) => value + offset;
}

fn i32[min max] Run()
{
    stack i32[min max] offset = 1;
    ApplyInline((i32[min max] value) =>
    {
        return;
    });
    return ApplyBorrow(capture(copy offset) (i32[min max] value) => value + offset);
}
""");
        return Succeeds(compiled);
    }
}

