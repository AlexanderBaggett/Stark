// Ported from TypeCheckingTests.RawAndMultilineTextLiteralsTypeCheckAsTextLiterals.
internal fn bool RawAndMultilineTextLiteralsTypeCheckAsTextLiteralsImpl()
{
    {
        // PORT-NOTE: the C# raw string for this program used a 5-quote delimiter so
        // the embedded program could contain its own triple-quoted multiline
        // literal. The Stark "...\"\"\" literal cannot itself nest a \"\"\" token,"; body is preserved as written below;
        // the embedded program is otherwise verbatim.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-raw-and-multiline-text-literals",
            "module Demo\n\nfinite law ascii RawPath()\n{\n    return raw\"c:\\compiler\\stage1\";\n}\n\nfinite law ascii Multiline()\n{\n    return raw\"\"\"\n    alpha\n    beta\n    \"\"\";\n}\n\nfinite law ascii Interpolated()\n{\n    return $raw\"Score: {100}\\n\";\n}\n\nfinite law unicode Wide()\n{\n    return (unicode)raw\"\\u03B1\";\n}");
        return Succeeds(compiled);
    }
}

// Ported slice of tests/compiler.Tests/TypeCheckingTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold. These are all positive type-check tests; the
// originals additionally probe the TypeCheckModel artifact (NamedTypes,
// Functions, Variants, OrderedFields, TypeTriggers, GenericParams, etc.) which
// the compile helpers cannot express, so those probes reduce to the
// result.Succeeded signal. PORT-NOTE comments flag each reduction.

