    static finite law bool Equals(borrow Symbol left, borrow Symbol right)
        where overlap(left, right)
    {
        return left.Id == right.Id;
    }
}

fn void Use(Dictionary<Symbol, i32[0 max]> symbols)
{
    return;
}
""",
        "System",
        "Collections.stark",
        raw"""
module System.Collections

public struct Dictionary<K, V>
{
    K Key;
    V Value;
}
""");
    return FailsWithDiagnostic(compiled, "STK3023")
        && AnyDiagnosticMessageContains(compiled, "Incompatible Hash contract method")
        && AnyDiagnosticMessageContains(compiled, "must return 'u64[0 max]'")
        && AnyDiagnosticMessageContains(compiled, "u64[0 max] Hash");
}

