// Ported from TypeCheckingTests.GenericEnumAliasesCanQualifyVariants.
internal fn bool GenericEnumAliasesCanQualifyVariantsImpl()
{
    {
        // PORT-NOTE: the original also asserts NamedTypes contains
        // "ResultCore<i32,bool>", proving alias-qualified variants instantiate
        // the underlying enum. The NamedTypes table is not expressible via the
        // compile helpers, so this reduces to "the embedded program type-checks
        // successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-generic-enum-alias-qualifies-variants",
            raw"""
module Demo

enum ResultCore<T, E>
{
    Ok(T),
    Err(E),
}

alias Result<T, E> = ResultCore<T, E>;

finite law i32[min max] Run()
{
    stack Result<i32[min max], bool> result = Result<i32[min max], bool>.Ok(7);
    switch (result)
    {
        case Result<i32[min max], bool>.Ok(var value):
            return value;
        case Result<i32[min max], bool>.Err(var failed):
            if (failed)
            {
                return -1;
            }

            return -2;
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.GenericEnumVariantFieldTypeIsSubstituted.
internal fn bool GenericEnumVariantFieldTypeIsSubstitutedImpl()
{
    {
        // PORT-NOTE: the original also probes NamedTypes["Result<i32,bool>"],
        // asserting the Ok variant's first field is Integer and the Err variant's
        // first field is Bool. The NamedTypes/variant tables are not expressible
        // via the compile helpers, so this reduces to "the embedded program
        // type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-generic-enum-variant-field-substituted",
            raw"""
module Demo

enum Result<T, E>
{
    Ok(T),
    Err(E),
}

finite law i32[min max] Unwrap(Result<i32[min max], bool> res)
{
    switch (res)
    {
        case Result<i32[min max], bool>.Ok(var value):
            return value;
        case Result<i32[min max], bool>.Err(var err):
            if (err)
            {
                return -1;
            }
            return -1;
    }
}
""");
        return Succeeds(compiled);
    }
}

