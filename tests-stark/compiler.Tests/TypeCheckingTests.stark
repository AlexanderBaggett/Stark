// Ported from TypeCheckingTests.UnsafeFunctionItemsDoNotPromoteToOrdinaryFunctionPointers.
internal fn bool UnsafeFunctionItemsDoNotPromoteToOrdinaryFunctionPointersImpl()
{
    // PORT-NOTE: the C# fact also asserts TypeCheckModel.AddressTakenFunctions
    // is empty for each compile; that model probe is not expressible via the
    // compile helpers and is dropped. The STK3024 promotion-rejection
    // diagnostics are checked for both the outside- and inside-unsafe programs.
    stack mut LlvmCompile outsideUnsafe = CompileTypeCheck(
        "diagp1-unsafe-fn-no-ordinary-promote-outside",
        raw"""
module Demo

unsafe fn i32[min max] Touch()
{
    return 1;
}

fn void Run()
{
    stack fnptr<fn i32[min max]()> callback = Touch;
    return;
}
""");

    stack mut LlvmCompile insideUnsafe = CompileTypeCheck(
        "diagp1-unsafe-fn-no-ordinary-promote-inside",
        raw"""
module Demo

unsafe fn i32[min max] Touch()
{
    return 1;
}

fn void Run()
{
    unsafe
    {
        stack fnptr<fn i32[min max]()> callback = Touch;
    }

    return;
}
""");

    return FailsWithDiagnosticMessage(outsideUnsafe, "STK3024", "cannot be promoted to ordinary function pointer")
        && FailsWithDiagnosticMessage(insideUnsafe, "STK3024", "cannot be promoted to ordinary function pointer");
}

// Ported from TypeCheckingTests.UnsafeFunctionItemsPromoteToUnsafeFunctionPointersAndCallsRequireUnsafeContext.
internal fn bool UnsafeFunctionItemsPromoteToUnsafeFunctionPointersAndCallsRequireUnsafeContextImpl()
{
    // PORT-NOTE: the `promotion` program's TypeCheckModel probes (the promotion
    // targets an unsafe function pointer; a single address-taken function) are
    // not expressible via the compile helpers, so that case reduces to "the
    // program type-checks successfully".
    stack mut LlvmCompile promotion = CompileTypeCheck(
        "diagp1-unsafe-fn-promote-unsafe-ptr",
        raw"""
module Demo

unsafe fn i32[min max] Touch()
{
    return 1;
}

fn void Register()
{
    stack fnptr<unsafe fn i32[min max]()> callback = Touch;
    return;
}
""");

    stack mut LlvmCompile outsideUnsafeCall = CompileTypeCheck(
        "diagp1-unsafe-fnptr-call-outside-unsafe",
        raw"""
module Demo

unsafe fn i32[min max] Touch()
{
    return 1;
}

fn i32[min max] Run()
{
    stack fnptr<unsafe fn i32[min max]()> callback = Touch;
    return callback();
}
""");

    stack mut LlvmCompile insideUnsafeCall = CompileTypeCheck(
        "diagp1-unsafe-fnptr-call-inside-unsafe",
        raw"""
module Demo

unsafe fn i32[min max] Touch()
{
    return 1;
}

unsafe fn i32[min max] Run()
{
    stack fnptr<unsafe fn i32[min max]()> callback = Touch;
    return callback();
}
""");

    return Succeeds(promotion)
        && FailsWithDiagnosticMessage(outsideUnsafeCall, "STK3024", "Unsafe function pointer")
        && Succeeds(insideUnsafeCall);
}

// Ported from TypeCheckingTests.FfiFunctionBodiesPromoteToNativeCallbackFunctionPointers.
internal fn bool FfiFunctionBodiesPromoteToNativeCallbackFunctionPointersImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-ffi-body-promotes-native-callback",
        raw"""
module Demo

alias AudioCallback = fnptr<unsafe ffi(c) fn void(rawmutptr<i8[min max]>, u32[0 max])>;

unsafe ffi(c) fn void FillAudio(rawmutptr<i8[min max]> bufferData, u32[0 max] frames)
{
    return;
}

unsafe ffi(c) fn void Register(AudioCallback callback);

fn void Store(AudioCallback callback)
{
    return;
}

unsafe fn void Run()
{
    Register(FillAudio);
    Store(FillAudio);
    return;
}
""");

    stack mut LlvmCompile missingUnsafe = CompileTypeCheck(
        "diagp1-ffi-body-native-callback-missing-unsafe-carrier",
        raw"""
module Demo

alias BadCallback = fnptr<ffi(c) fn void(rawmutptr<i8[min max]>, u32[0 max])>;

fn void Register(BadCallback callback)
{
    return;
}
""");

    return Succeeds(compiled)
        && FailsWithDiagnosticMessage(missingUnsafe, "STK3024", "uses raw pointer types and must be declared 'unsafe'");
}

// Ported slice of tests/compiler.Tests/TypeCheckingTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold. PORT-NOTE comments flag assertions the helpers
// cannot express (TypeCheckModel artifact inspection, AddressTakenFunctions
// emptiness, multi-module in-memory resolution, monomorphization-plan stop
// pass, EnforceIntegerRangeStorageRules option) that were reduced to the
// nearest signal.

// Ported from TypeCheckingTests.UnsafeFunctionItemsDoNotPromoteInReturnOrArgumentTargetPositions.
internal fn bool UnsafeFunctionItemsDoNotPromoteInReturnOrArgumentTargetPositionsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-unsafe-fn-no-promote",
        raw"""
module Demo

unsafe fn i32[min max] Touch()
{
    return 1;
}

fn fnptr<fn i32[min max]()> Factory()
{
    return Touch;
}

fn void Register(fnptr<fn i32[min max]()> callback)
{
    return;
}

fn void Run()
{
    Register(Touch);
    return;
}
""");
    // PORT-NOTE: original also asserts the TypeCheckModel artifact exists with
    // empty AddressTakenFunctions; reduced to requiring the failure plus at
    // least two STK3024 diagnostics carrying the promotion message.
    return !Succeeds(compiled)
        && AnyDiagnosticMessageContains(compiled, "cannot be promoted to ordinary function pointer")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3024", "cannot be promoted to ordinary function pointer") >= 2;
}

// Ported from TypeCheckingTests.StrictIntegerRangesRejectExplicitScalarConstWrongWidthOrSign.
internal fn bool StrictIntegerRangesRejectExplicitScalarConstWrongWidthOrSignImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-strict-int-explicit-const",
        raw"""
module Demo

const i32 PositiveSigned = 80;
const u32 PositiveWide = 80;
const i32 NegativeWide = -1;
const u8 CorrectUnsigned = 255;
const i8 CorrectSigned = -1;
""");
    // PORT-NOTE: original sets EnforceIntegerRangeStorageRules: true (no helper
    // option) and also asserts no diagnostics mention CorrectUnsigned/CorrectSigned;
    // reduced to requiring the three STK3014 width/sign diagnostics.
    return CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "PositiveSigned") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "PositiveWide") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "NegativeWide") > 0;
}

// Ported from TypeCheckingTests.ScalarConstDeclarationsReportFriendlyNumericTypeDiagnostics.
internal fn bool ScalarConstDeclarationsReportFriendlyNumericTypeDiagnosticsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-scalar-const-friendly-diags",
        raw"""
module Demo

const i32[min max] Ranged = 80;
const i8 TooSmall = 200;
const f32 TooPrecise = 0.1;
""");
    return !Succeeds(compiled)
        && AnyDiagnosticMessageContains(compiled, "already has one exact value")
        && AnyDiagnosticMessageContains(compiled, "does not need an integer range")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "TooSmall") > 0
        && AnyDiagnosticMessageContains(compiled, "does not fit in i8")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "TooPrecise") > 0
        && AnyDiagnosticMessageContains(compiled, "without changing it");
}

