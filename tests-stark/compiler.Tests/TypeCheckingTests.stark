// Ported from TypeCheckingTests.LambdaCaptureModeFactsArePreservedInTypeCheckModel.
internal fn bool LambdaCaptureModeFactsArePreservedInTypeCheckModelImpl()
{
    {
        // PORT-NOTE: original asserts the compile fails with the
        // function-pointer-capture diagnostic AND probes TypeCheckModel (5
        // LambdaCaptures: copy/read/move/addr(unsafe)/shared(unsafe), all sharing
        // one lambda location). Capture artifact probes are not expressible; the
        // capturing-lambda-into-fnptr path is not lowered yet, so this reduces to
        // "the embedded program does not type-check" via !Succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-lambda-capture-mode-facts",
            raw"""
module Demo

fn void Run(
    i32[min max] copyValue,
    i32[min max] readValue,
    i32[min max] moveValue,
    i32[min max] addrValue,
    i32[min max] sharedValue)
    {
        unsafe
    {
        stack fnptr<fn i32[min max]()> callback =
            capture(copy copyValue, read readValue, move moveValue, unsafe addr addrValue, unsafe shared sharedValue) () => copyValue + readValue;
    }

    return;
}
""");
        return !Succeeds(compiled);
    }
}

