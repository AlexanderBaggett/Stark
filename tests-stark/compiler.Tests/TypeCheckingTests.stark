{
    return 0;
}
""");
    // PORT-NOTE: original sets EnforceIntegerRangeStorageRules: true (no helper
    // option); reduced to requiring the two STK3014 width diagnostics.
    return FailsWithDiagnostic(compiled, "STK3014")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u48[100 10000000000]") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i16[-200 0]") > 0;
}

