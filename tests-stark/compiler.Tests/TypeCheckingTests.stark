            raw"""
module Demo

fn i32[min max] Parse(i32[min max] value)
{
    return value;
}

fn T Parse<T>(T value)
{
    return value;
}

fn i32[min max] Run()
{
    stack i32[min max] value = 42;
    return Parse(value);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.TypeAliasesResolveToTheirUnderlyingTypes.
internal fn bool TypeAliasesResolveToTheirUnderlyingTypesImpl()
{
    {
        // PORT-NOTE: the original also probes TypeAliases (contains "Byte") and
        // Functions["Inc"] (return type and single parameter both resolving to
        // "i8"). The alias/function display-name tables are not expressible via
        // the compile helpers, so this reduces to "the embedded program
        // type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-type-alias-resolves-underlying",
            raw"""
module Demo

alias Byte = i8[min max];

fn Byte Inc(Byte value)
{
    return value + 1;
}
""");
        return Succeeds(compiled);
    }
}

