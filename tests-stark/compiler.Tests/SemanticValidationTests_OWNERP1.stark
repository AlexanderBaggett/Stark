import CompilerTestSupport
import System.Testing
module SemanticValidationTests_OWNERP1

// Ported from SemanticValidationTests.RetborrowsCanBeUsedLocallyAndReturned.
public unsafe fn bool RetborrowsCanBeUsedLocallyAndReturnedImpl()
{
    unsafe
    {
        // PORT-NOTE: the C# original asserts result.Succeeded and then reads the
        // SemanticValidationModel artifact, checking validation.Functions["Echo"].
        // EffectsValid and .BorrowingValid. The Stark host test protocol cannot
        // read the per-function EffectsValid/BorrowingValid flags off the
        // SemanticValidation artifact, so this is reduced to routing the same
        // program through CompileTypeCheck (which reaches semantic validation)
        // and asserting overall success — the per-function flags are true iff the
        // semantic-validation pass succeeds for this program.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-retborrows-local-and-returned",
            raw"""
module Demo

fn void Inspect(borrow i32[min max] value)
{
    return;
}

fn retborrow i32[min max] Echo(retborrow i32[min max] value)
{
    Inspect(value);
    return value;
}
""");
        return Succeeds(compiled);
    }
}
