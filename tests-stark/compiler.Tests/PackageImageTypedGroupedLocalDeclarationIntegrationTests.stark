import CompilerTestSupport
import System.Testing
module PackageImageTypedGroupedLocalDeclarationIntegrationTests

// Ported from PackageImageTypedGroupedLocalDeclarationIntegrationTests.ManifestBackedTypedGroupedLocalDeclarationsCompileAndRunWithoutSyntheticSource.
internal fn bool ManifestBackedTypedGroupedLocalDeclarationsCompileAndRunWithoutSyntheticSourceImpl()
{
    {
        // PORT-NOTE: The original builds `Facade` (a generic `SumTo<T>` using typed
        // grouped local declarations) into a static library via the `--emit-lib -o`
        // CLI path, asserts the CLI stdout ("Emitted static library:"), empty stderr,
        // exit code 0, and the on-disk library/.starkpkg manifest existing. It then
        // loads the package-image manifest, asserts the `Facade` module's generic
        // template `Facade.SumTo` has a null BodyText but a non-null TypedBody, rewrites
        // the manifest to a typed-only (synthetic-source-free) form, deletes
        // `Facade.stark`, and compiles a `Demo` module that imports `Facade` via the
        // `--emit-exe -o -I` CLI path. It finally runs the produced executable and
        // asserts empty stdout/stderr and exit code 10 (SumTo(5, 0) == 0+1+2+3+4).
        // The compile helpers cannot express CLI process output, file-system effects,
        // package-image manifest contents / typed-body probing, source deletion,
        // manifest-backed (sourceless) resolution, or runtime stdout/exit-code, so
        // this is reduced to compiling the same `Demo` root program with the verbatim
        // `Facade` module available as a sibling source module through the LLVM
        // pipeline and asserting it succeeds (the closest observable signal that
        // `Facade.SumTo` resolves and instantiates).
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "manifest-backed-typed-grouped-local-declarations-no-synthetic-source",
            raw"""
import Facade
module Demo

export fn i32[min max] main()
{
    return Facade.SumTo(5, 0);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn i32[min max] SumTo<T>(i32[min max] limit, T tag)
{
    stack mut i32[min max] total = 0, stop = limit;
    for willexit (stack mut i32[min max] index = 0, max = stop; index < max; index += 1)
    {
        total += index;
    }

    return total;
}
""");
        return Succeeds(compiled);
    }
}
