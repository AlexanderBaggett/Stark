// Ported from CompilerCliTests.EmitExecutableModeBuildsImportedAggregateDependencies.
internal fn bool EmitExecutableModeBuildsImportedAggregateDependenciesImpl()
{
    // PORT-NOTE: original writes a Geometry.stark dependency and an App.stark
    // root that imports it, then asserts CLI exit 0, "Emitted executable:"
    // stdout, the output exists, and the linked program exits with code 7. The
    // single-module CompileFull helper cannot supply the sibling Geometry module
    // nor observe the exit code; reduced to compiling the Geometry dependency
    // program through the full pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "cli-import-aggregate-geometry",
        raw"""
module Geometry

public struct Box
{
    i32[min max] Value;
}

public fn Box Make()
{
    return new Box()
    {
        Value = 7
    };
}

public fn i32[min max] Read(Box box)
{
    return box.Value;
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerCliTests.EmitExecutableModeLinksManifestBackedLibrariesWithoutSource.
internal fn bool EmitExecutableModeLinksManifestBackedLibrariesWithoutSourceImpl()
{
    // PORT-NOTE: original builds a Facade library (re-exporting Math) with
    // --emit-lib, deletes the sources, then links an App that imports the
    // manifest-backed library without source, asserting CLI exit 0, bitcode
    // temps, "Emitted executable:" stdout, and a runtime exit code. The compile
    // helpers cannot model manifest-backed linking or exit codes; reduced to
    // compiling the Facade library program (which re-exports Math) through the
    // full pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "cli-manifest-backed-facade",
        raw"""
export import Math
module Facade

public finite law i32[min max] Double(i32[min max] value)
{
    return Math.Add(value, value);
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerCliTests.EmitExecutableModeLinksManifestBackedOverloadedLibrariesWithoutSource.
internal fn bool EmitExecutableModeLinksManifestBackedOverloadedLibrariesWithoutSourceImpl()
{
    // PORT-NOTE: original builds a Facade library re-exporting Text and Math
    // (with overloaded Math.Open) via --emit-lib, deletes the sources, then
    // links an App against the manifest-backed library without source, asserting
    // CLI exit 0, "Emitted executable:" stdout, and a runtime exit code of 15.
    // The compile helpers cannot model manifest-backed linking or exit codes;
    // reduced to compiling the Facade library program (re-exporting Text and
    // Math, exercising the overload resolution) through the full pipeline and
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "cli-manifest-overloaded-facade",
        raw"""
export import Text
export import Math
module Facade

public finite law i32[min max] Run()
{
    return Math.Open("demo.txt", Math.FileMode.Write)
        + Math.Open("demo.txt", Math.FileMode.Write, Text.Encoding.UTF8);
}
""");
    return Succeeds(compiled);
}
