        // "Starting pass 'parse'. [info pipeline stage=parse" and
        // "Completed pass 'ownership-validate'. [info pipeline stage=ownership-validate".
        // CLI process output / stderr log streams are not expressible via the compile helpers, so
        // this reduces to "the embedded program type-checks successfully" (the --check success signal).
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "cli-explicit-info-level-prints-pipeline-lifecycle",
            raw"""
module Demo

fn i32[min max] Run()
{
    return 7;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerCliTests.EmitLibraryModeBuildsStaticLibraryAndManifest.
internal fn bool EmitLibraryModeBuildsStaticLibraryAndManifestImpl()
{
    {
        // PORT-NOTE: The original drives the `--emit-lib -o` CLI path and asserts
        // CLI stdout ("Emitted static library:", "Emitted package image:"), empty
        // stderr, exit code 0, the on-disk static library (.a/.lib) existing and
        // being non-empty, the .starkpkg manifest existing, and the loaded package
        // manifest's RootModule/Modules/SourceSurface re-exports and functions.
        // The compile helpers cannot express CLI process output, file-system
        // effects, or package-image manifest contents, so this is reduced to
        // compiling the same two-module program (root `Facade` plus dependency
        // `Math`) through the LLVM pipeline and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "cli-emit-lib-static-library-manifest",
            raw"""
export import Math
module Facade

public finite law i32[min max] Double(i32[min max] value)
{
    return Math.Add(value, value);
}
""",
            "",
            "Math.stark",
            raw"""
module Math

public finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}
""");
        return Succeeds(compiled);
    }
}

// Ported slice of tests/compiler.IntegrationTests/CompilerCliTests.cs. These are
// CLI integration tests whose original assertions cover runtime exit codes,
// emitted-file existence, package-image bytes, and CLI stdout text. The Stark
// compile helpers cannot observe those effects, so each Impl reduces to driving
// the embedded program(s) through the closest compile helper and asserting the
// nearest available success signal. See per-method `// PORT-NOTE:` comments.

// Ported from CompilerCliTests.DefaultModeInfersExecutableFromExportedMain.
internal fn bool DefaultModeInfersExecutableFromExportedMainImpl()
{
    // PORT-NOTE: original asserts CLI exit 0, "Emitted executable:" stdout, the
    // output file exists, and the linked program exits with code 7. Reduced to a
    // full-pipeline compile of the embedded program returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "cli-default-exe-from-main",
        raw"""
module App

export fn i32[min max] main()
{
    return 7;
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerCliTests.DefaultModeInfersLibraryWhenRootHasNoExportedMain.
internal fn bool DefaultModeInfersLibraryWhenRootHasNoExportedMainImpl()
{
    // PORT-NOTE: original asserts CLI exit 0, "Emitted static library:" and
    // "Emitted package image:" stdout, and that both the .a/.lib and .starkpkg
    // files exist. Reduced to a full-pipeline compile of the embedded program
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "cli-default-lib-no-main",
        raw"""
module Facade

public finite law i32[min max] Double(i32[min max] value)
{
    return value + value;
}
""");
    return Succeeds(compiled);
}

