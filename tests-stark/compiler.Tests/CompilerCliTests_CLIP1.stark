fn bool Run()
{
    return 1;
}
""");
    return !Succeeds(compiled);
}

// Ported from CompilerCliTests.TextDiagnosticsExpandTabsBeforeRenderingCarets.
// PORT-NOTE: the original feeds a tab-indented program and asserts the rendered
// carets line up after tab expansion (CLI text-rendering only). The embedded
// program is preserved verbatim with its tab indentation; here we verify it fails
// type-check.
public unsafe fn bool TextDiagnosticsExpandTabsBeforeRenderingCaretsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "cli-text-diagnostics-expand-tabs",
        raw"""module Demo

fn bool Run() {
	return 1;
}
""");
    return !Succeeds(compiled);
}

// Ported from CompilerCliTests.TextDiagnosticsRenderMultilineSpansAcrossSourceLines.
public unsafe fn bool TextDiagnosticsRenderMultilineSpansAcrossSourceLinesImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "cli-text-diagnostics-multiline-spans",
        raw"""
module Demo

fn ascii Run(ascii text, i32[min max] first, i32[min max] second, i32[min max] third)
{
    return text[
        first,
        second,
        third
    ];
}
""");
    return FailsWithDiagnostic(compiled, "STK3008");
}

// Ported from CompilerCliTests.TextDiagnosticsGroupCrossCodeNotesUnderTheirPrimaryDiagnostic.
public unsafe fn bool TextDiagnosticsGroupCrossCodeNotesUnderTheirPrimaryDiagnosticImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "cli-text-diagnostics-group-cross-code-notes",
        raw"""
module Demo

fn i32[min max] Run(bool value)
{
    switch (value)
    {
        case true:
            return 1;
        case false:
            return 0;
        default:
            return 2;
    }
}
""");
    return FailsWithDiagnostic(compiled, "STK3019");
}

