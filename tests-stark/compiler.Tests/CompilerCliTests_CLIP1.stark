// Ported from CompilerCliTests.SuccessfulChecksPrintWarningsAndTextSummary.
// PORT-NOTE: the original also asserts the printed text summary line; that is
// CLI-only. Here we verify the check succeeds and still surfaces the STK4010 warning.
public unsafe fn bool SuccessfulChecksPrintWarningsAndTextSummaryImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "cli-successful-checks-print-warnings",
        raw"""
module Demo

struct Buffer
{
    i32[min max] Value;

    mut drop
    {
        ;
    }
}
""");
    return Succeeds(compiled) && HasDiagnostic(compiled, "STK4010");
}

// Ported from CompilerCliTests.TextDiagnosticsRenderSourceSnippetsForInfoNotesToo.
// PORT-NOTE: the original asserts on rendered snippet lines and the info-note text;
// the snippet rendering is CLI-only. Here we verify the move error is reported.
public unsafe fn bool TextDiagnosticsRenderSourceSnippetsForInfoNotesTooImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "cli-text-diagnostics-info-note-snippets",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 1
    };
    Consume(box);
    return box.Value;
}
""");
    return !Succeeds(compiled) && AnyDiagnosticMessageContains(compiled, "Move error");
}

// Ported from CompilerCliTests.TextDiagnosticsDoNotRepeatTheSameOwnershipMoveError.
public unsafe fn bool TextDiagnosticsDoNotRepeatTheSameOwnershipMoveErrorImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "cli-text-diagnostics-no-repeat-move-error",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 1
    };
    Consume(box);
    return box.Value;
}
""");
    return CountDiagnosticsWithCodeAndMessage(
        compiled,
        "STK4200",
        "Move error: value 'box' was moved and must be reinitialized before it can be read.") == 1;
}

// Ported from CompilerCliTests.EmitMirModeReportsTypeErrorsInsteadOfLoweringWarningsForVoidCallsUsedAsValues.
public unsafe fn bool EmitMirModeReportsTypeErrorsInsteadOfLoweringWarningsForVoidCallsUsedAsValuesImpl()
{
    stack mut LlvmCompile compiled = CompileMir(
        "cli-emit-mir-type-error-over-lowering-warning",
        raw"""
module Demo

fn void A()
{
    return;
}

fn bool Run(bool flag)
{
    return (flag ? A() : A()) == (flag ? A() : A());
}
""");
    return FailsWithDiagnosticMessage(compiled, "STK3002", "Operator '==' cannot compare 'void' and 'void'.");
}

// Ported from CompilerCliTests.EmitLlvmModeFailsWithTypeDiagnosticForVoidCallsUsedAsValues.
public unsafe fn bool EmitLlvmModeFailsWithTypeDiagnosticForVoidCallsUsedAsValuesImpl()
{
    stack mut LlvmCompile compiled = CompileLlvm(
        "cli-emit-llvm-type-diagnostic-void-calls",
        raw"""
module Demo

fn void A()
{
    return;
}

fn bool Run(bool flag)
{
    return (flag ? A() : A()) == (flag ? A() : A());
}
""");
    return FailsWithDiagnosticMessage(compiled, "STK3002", "Operator '==' cannot compare 'void' and 'void'.");
}

// Ported from CompilerCliTests.CheckModeResolvesSourceImportsFromConfiguredSearchPath.
// PORT-NOTE: the original writes a sibling `Math.stark` and resolves it via `-I`
// search path. Multi-file `-I` resolution is not expressible through the allowed
// helper set, so the imported `Math` module is inlined ahead of `App` and the
// combined program is type-checked.
public unsafe fn bool CheckModeResolvesSourceImportsFromConfiguredSearchPathImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "cli-check-resolves-imports-from-search-path",
        raw"""
module Math

public finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

module App

fn i32[min max] Run()
{
    return Math.Add(3, 4);
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerCliTests.CheckModeCanUseStarkPathAndCanDisableIt.
// PORT-NOTE: the original resolves `EnvSupport` through the STARK_PATH environment
// variable and then asserts `--no-stark-path` makes resolution fail. Environment
// and CLI toggling are not expressible here, so the imported `EnvSupport` module is
// inlined ahead of `App` and the combined program is type-checked (the enabled,
// successful path).
public unsafe fn bool CheckModeCanUseStarkPathAndCanDisableItImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "cli-check-stark-path-enabled",
        raw"""
module EnvSupport

public finite law i32[min max] Value()
{
    return 9;
}

module App

fn i32[min max] Run()
{
    return EnvSupport.Value();
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerCliTests.EmitExecutableModeReportsFriendlyMissingNativeLibraryDiagnostic.
// PORT-NOTE: the original drives a stub linker to assert a friendly STK7204
// native-link diagnostic for a missing `--native-library`. Native linking and
// linker stubs are CLI/toolchain-only; here we verify the embedded program itself
// type-checks (the source compiles up to the native link step).
public unsafe fn bool EmitExecutableModeReportsFriendlyMissingNativeLibraryDiagnosticImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "cli-emit-exe-missing-native-library",
        raw"""
module App

export fn i32[min max] main()
{
    return 0;
}
""");
    return Succeeds(compiled);
}
