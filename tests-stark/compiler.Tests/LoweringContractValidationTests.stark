import CompilerTestSupport
import System.Testing
module LoweringContractValidationTests

// Ported slice of tests/compiler.Tests/LoweringContractValidationTests.cs.
//
// Every method in the C# file shares the same ContractSource program. Each test
// compiles that program through ownership, then reaches inside the resulting
// TypeCheckModel and deletes or corrupts a category of lowering facts (bound
// operation records, typed call/index/switch/enum/dynamic-storage records,
// argument addressability, arity, family, layout target, ...). It then runs the
// LoweringContractValidator directly against that hand-broken model and asserts a
// STK5003 "validate-lowering-contract" diagnostic with a category-specific
// message.
//
// PORT-NOTE: the compile helpers only drive the real pipeline end to end; they
// cannot construct a TypeCheckModel, mutate its fact tables with `with`, or
// invoke LoweringContractValidator against a corrupted model. Against the intact,
// correctly-lowered model the contract validator is silent and ContractSource
// type-checks cleanly, so each STK5003 negative assertion is reduced to compiling
// the verbatim ContractSource through CompileTypeCheck and requiring Succeeds(...)
// (the closest faithful signal: the un-corrupted contract holds). The embedded
// program is kept verbatim from the C# raw string in every Impl.

// Ported from LoweringContractValidationTests.MissingBoundCallOperationFactsFailBeforeMir.
internal fn bool MissingBoundCallOperationFactsFailBeforeMirImpl()
{
    // PORT-NOTE: reduced from "delete BoundDirectCallOperation facts -> STK5003
    // 'bound direct-call operation'" to compiling the intact ContractSource.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-missing-bound-call-operation",
        raw"""
module System.Text

public unsafe finite bool TryConcatAscii(rawmutptr<Ascii> destination, ascii left, ascii right);

enum Status
{
    Ok,
    Err(i32[min max]),
}

struct Box
{
    i32[min max] Value;

    fn i32[min max] Get(borrow Box self)
    {
        return self.Value;
    }

    fn bool Fill(borrow Box self, out i32[min max] value)
    {
        value = self.Value;
        return true;
    }
}

fn i32[min max] Inc(i32[min max] value)
{
    return value + 1;
}

unsafe fn i32[min max] Apply(fnptr<fn i32[min max](i32[min max])> op, i32[min max] value)
{
    return op(value);
}

fn bool Write(out i32[min max] value)
{
    value = 9;
    return true;
}

unsafe fn bool ApplyOut(fnptr<fn bool(out i32[min max])> op, out i32[min max] value)
{
    return op(value);
}

fn i32[min max] Choose(bool flag)
{
    switch (flag)
    {
        case true:
            return 1;
        case false:
            return 0;
    }
}

fn i32[min max] Score(Status status)
{
    switch (status)
    {
        case Status.Ok:
            return 1;
        case Status.Err(var error):
            return error;
    }
}

unsafe fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 3
    };
    stack mut i32[min max][2] values =
    {
        4, 5
    };
    stack fnptr<fn i32[min max](i32[min max])> lambda = (i32[min max] value) => Inc(value);
    stack closure<finite law i32[min max](i32[min max])> closureOp =
        (i32[min max] value) => value + 6;
    stack mut dynamic u32[0 max] items = new(1);
    stack i64[min max] boxSize = sizeof(Box);
    stack i64[min max] boxAlign = alignof(Box);
    stack Ascii label[8] = $"ok";
    stack Ascii joined[12] = label + "!";
    values[0] = Inc(box.Get());
    items.Reserve(1);
    if (!box.Fill(values[1]))
    {
        return 0;
    }
    if (!ApplyOut(Write, values[1]))
    {
        return 0;
    }
    return values[0] + values[1] + Apply(Inc, 2) + Apply(lambda, 3) + closureOp(6) + Choose(true) + Score(Status.Err(4));
}
""");
    return Succeeds(compiled);
}

