import CompilerTestSupport
import System.Testing
module CompilerPipelineSyntaxModelTests

// Ported slice of tests/compiler.PipelineTests/CompilerPipelineSyntaxModelTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold. The C# facts stop after the "syntax-model" pass;
// the compile helpers stop after type-check, which still surfaces the
// syntax-model diagnostics asserted here. Theory rows are inlined as separate
// compiles and combined so the Impl returns true only when every row holds.

// Ported from CompilerPipelineSyntaxModelTests.UnsupportedModuleAttributesReportSyntaxModelDiagnostics.
internal fn bool UnsupportedModuleAttributesReportSyntaxModelDiagnosticsImpl()
{
    // Theory row 1: unknown module attribute reports STK2110.
    stack mut LlvmCompile case1 = CompileTypeCheck(
        "diagp1-unsupported-module-attr-other",
        raw"""
[Other]
module Demo
""");

    // Theory row 2: Backend(Transparent) on a module reports STK2112.
    stack mut LlvmCompile case2 = CompileTypeCheck(
        "diagp1-unsupported-module-attr-transparent",
        raw"""
[Backend(Transparent)]
module Demo
""");

    // Theory row 3: duplicate Backend(Opaque) on a module reports STK2111.
    stack mut LlvmCompile case3 = CompileTypeCheck(
        "diagp1-unsupported-module-attr-duplicate-opaque",
        raw"""
[Backend(Opaque)]
[Backend(Opaque)]
module Demo
""");

    return FailsWithDiagnostic(case1, "STK2110")
        && FailsWithDiagnostic(case2, "STK2112")
        && FailsWithDiagnostic(case3, "STK2111");
}

// Ported from CompilerPipelineSyntaxModelTests.BackendOpaqueCallableAttributesRejectConflictingModifiers.
internal fn bool BackendOpaqueCallableAttributesRejectConflictingModifiersImpl()
{
    // Theory rows: Backend(Opaque) combined with each conflicting callable
    // modifier reports STK2113. The C# interpolates {{declaration}} into
    // "module Demo\n\n{{declaration}}"; each row is reproduced verbatim here.
    stack mut LlvmCompile case1 = CompileTypeCheck(
        "diagp1-opaque-conflict-inline",
        raw"""
module Demo

[Backend(Opaque)]
inline fn void Run() { ; }
""");

    stack mut LlvmCompile case2 = CompileTypeCheck(
        "diagp1-opaque-conflict-inlinehint",
        raw"""
module Demo

[Backend(Opaque)]
inlinehint fn void Run() { ; }
""");

    stack mut LlvmCompile case3 = CompileTypeCheck(
        "diagp1-opaque-conflict-noinline",
        raw"""
module Demo

[Backend(Opaque)]
noinline fn void Run() { ; }
""");

    stack mut LlvmCompile case4 = CompileTypeCheck(
        "diagp1-opaque-conflict-hot",
        raw"""
module Demo

[Backend(Opaque)]
hot fn void Run() { ; }
""");

    stack mut LlvmCompile case5 = CompileTypeCheck(
        "diagp1-opaque-conflict-cold",
        raw"""
module Demo

[Backend(Opaque)]
cold fn void Run() { ; }
""");

    stack mut LlvmCompile case6 = CompileTypeCheck(
        "diagp1-opaque-conflict-ffi",
        raw"""
module Demo

[Backend(Opaque)]
ffi fn void Run();
""");

    return FailsWithDiagnostic(case1, "STK2113")
        && FailsWithDiagnostic(case2, "STK2113")
        && FailsWithDiagnostic(case3, "STK2113")
        && FailsWithDiagnostic(case4, "STK2113")
        && FailsWithDiagnostic(case5, "STK2113")
        && FailsWithDiagnostic(case6, "STK2113");
}

// Ported from CompilerPipelineSyntaxModelTests.BackendOpaqueCallableAttributesRejectDuplicates.
internal fn bool BackendOpaqueCallableAttributesRejectDuplicatesImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-opaque-callable-duplicate",
        raw"""
module Demo

[Backend(Opaque)]
[Backend(Opaque)]
fn void Run()
{
    ;
}
""");
    return FailsWithDiagnostic(compiled, "STK2111");
}

// Ported from TypeCheckingTests.InvalidLinkNameAttributesReportTargetedDiagnostic.
internal fn bool InvalidLinkNameAttributesReportTargetedDiagnosticsImpl()
{
    stack mut LlvmCompile nonFfi = CompileTypeCheck(
        "diagp1-link-name-non-ffi-function",
        raw"""
module Demo

[LinkName("native_run")]
fn void Run()
{
    return;
}
""");

    stack mut LlvmCompile nonString = CompileTypeCheck(
        "diagp1-link-name-non-string-argument",
        raw"""
module Demo

[LinkName(native_run)]
unsafe ffi(c) fn void Run();
""");

    return FailsWithDiagnosticMessage(nonFfi, "STK2114", "only valid on imported FFI function declarations")
        && FailsWithDiagnosticMessage(nonString, "STK2114", "requires exactly one compile-time string literal argument");
}

// Ported from CompilerPipelineSyntaxModelTests.BackendOpaqueTypeAndContractAttributesReportDiagnostics.
internal fn bool BackendOpaqueTypeAndContractAttributesReportDiagnosticsImpl()
{
    // Theory rows: each {{declaration}} is interpolated into
    // "module Demo\n\n{{declaration}}" by the C# fact; reproduced verbatim here.

    // Row 1: duplicate Backend(Opaque) on a struct reports STK2111.
    stack mut LlvmCompile case1 = CompileTypeCheck(
        "diagp1-opaque-type-duplicate-struct",
        raw"""
module Demo

[Backend(Opaque)]
[Backend(Opaque)]
struct Box
{
}
""");

    // Row 2: duplicate Backend(Opaque) on a record reports STK2111.
    stack mut LlvmCompile case2 = CompileTypeCheck(
        "diagp1-opaque-type-duplicate-record",
        raw"""
module Demo

[Backend(Opaque)]
[Backend(Opaque)]
record Cursor(i32[min max] Position)
{
}
""");

    // Row 3: duplicate Backend(Opaque) on a doctrine reports STK2111.
    stack mut LlvmCompile case3 = CompileTypeCheck(
        "diagp1-opaque-type-duplicate-doctrine",
        raw"""
module Demo

[Backend(Opaque)]
[Backend(Opaque)]
doctrine Numbers
{
    finite law bool Equals(i32[min max] left, i32[min max] right);
}
""");

    // Row 4: Backend(Opaque) on a struct field reports STK2110.
    stack mut LlvmCompile case4 = CompileTypeCheck(
        "diagp1-opaque-type-field-struct",
        raw"""
module Demo

struct Box
{
    [Backend(Opaque)]
    i32[min max] Value;
}
""");

    return FailsWithDiagnostic(case1, "STK2111")
        && FailsWithDiagnostic(case2, "STK2111")
        && FailsWithDiagnostic(case3, "STK2111")
        && FailsWithDiagnostic(case4, "STK2110");
}

// Ported from CompilerPipelineSyntaxModelTests.MalformedThreadSafetyLawSurfaceReportsSyntaxModelDiagnostics.
internal fn bool MalformedThreadSafetyLawSurfaceReportsSyntaxModelDiagnosticsImpl()
{
    // Theory rows: each {{declaration}} is interpolated into
    // "module Demo\n\n{{declaration}}" by the C# fact; reproduced verbatim here.
    // Every row asserts STK3050.

    // Row 1: unknown grant law name "Serializable" on a struct.
    stack mut LlvmCompile case1 = CompileTypeCheck(
        "diagp1-malformed-law-grant-serializable",
        raw"""
module Demo

[Grant(Serializable)]
struct Box
{
}
""");

    // Row 2: Deny with a condition on a struct field.
    stack mut LlvmCompile case2 = CompileTypeCheck(
        "diagp1-malformed-law-deny-condition-field",
        raw"""
module Demo

struct Box<T>
{
    [Deny(Shareable) where Transferable(T)]
    T Payload;
}
""");

    // Row 3: unknown thread-safety predicate "Send" in a function where-clause.
    stack mut LlvmCompile case3 = CompileTypeCheck(
        "diagp1-malformed-law-send-where",
        raw"""
module Demo

fn void Run<T>() where Send(T)
{
    ;
}
""");

    return FailsWithDiagnostic(case1, "STK3050")
        && FailsWithDiagnostic(case2, "STK3050")
        && FailsWithDiagnostic(case3, "STK3050");
}

// Ported slice of tests/compiler.PipelineTests/CompilerPipelineSyntaxModelTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold. PORT-NOTE comments flag assertions the helpers
// cannot express (SyntaxModel introspection: ModuleName/BackendOptimizationMode,
// declaration attributes, thread-safety laws, destructors, type aliases, and
// generic type parameters) that were reduced to the nearest signal.

// Ported from CompilerPipelineSyntaxModelTests.BackendOpaqueModuleAttributeFlowsIntoSyntaxModel.
internal fn bool BackendOpaqueModuleAttributeFlowsIntoSyntaxModelImpl()
{
    {
        // PORT-NOTE: the original stops after the "syntax-model" pass and, beyond
        // result.Succeeded, probes the SyntaxModel (ModuleName "Demo",
        // BackendOptimizationMode Opaque, a single ModuleAttribute named "Backend"
        // with arguments ["Opaque"]) and asserts CompilerCli.ShouldEnableRootModuleLto
        // is false. SyntaxModel access and the LTO/CLI signal are not expressible via
        // the compile helpers, so this reduces to "the embedded program type-checks
        // successfully" (the result.Succeeded signal).
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "syntax-model-backend-opaque-module-attribute",
            raw"""
[Backend(Opaque)]
module Demo
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSyntaxModelTests.TestingCallableAttributesFlowIntoSyntaxModelAsMetadata.
internal fn bool TestingCallableAttributesFlowIntoSyntaxModelAsMetadataImpl()
{
    {
        // PORT-NOTE: the original stops after the "syntax-model" pass and, beyond
        // result.Succeeded, probes the SyntaxModel declarations to confirm
        // "AdditionWorks" carries a single attribute named "Fact" and "AdditionTheory"
        // carries a single attribute named "Theory". Declaration-attribute access is
        // not expressible via the compile helpers, so this reduces to "the embedded
        // program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "syntax-model-testing-callable-attributes-metadata",
            raw"""
module Demo

[Fact]
fn bool AdditionWorks()
{
    return true;
}

[Theory]
fn bool AdditionTheory()
{
    return true;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSyntaxModelTests.BackendOpaqueAttributesFlowIntoCallableAndTypeSyntaxModels.
internal fn bool BackendOpaqueAttributesFlowIntoCallableAndTypeSyntaxModelsImpl()
{
    {
        // PORT-NOTE: the original stops after the "syntax-model" pass and, beyond
        // result.Succeeded, probes the SyntaxModel declarations to confirm the
        // BackendOptimizationMode is Opaque on the Run function, the Box struct and its
        // Box.Read method, the Cursor record and its Cursor.Read method, and the
        // Numbers doctrine and its Numbers.Equals law (each including the nested
        // Function!.BackendOptimizationMode). SyntaxModel declaration and
        // backend-mode access is not expressible via the compile helpers, so this
        // reduces to "the embedded program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "syntax-model-backend-opaque-callable-and-type",
            raw"""
module Demo

[Backend(Opaque)]
fn void Run()
{
    ;
}

[Backend(Opaque)]
struct Box
{
    i32[min max] Value;

    fn i32[min max] Read()
    {
        return self.Value;
    }
}

[Backend(Opaque)]
record Cursor(i32[min max] Position)
{
    fn i32[min max] Read()
    {
        return self.Position;
    }
}

[Backend(Opaque)]
doctrine Numbers<T>
{
    finite law bool Equals(borrow T left, borrow T right);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSyntaxModelTests.ThreadSafetyLawPredicatesAndAttributesFlowIntoSyntaxModel.
internal fn bool ThreadSafetyLawPredicatesAndAttributesFlowIntoSyntaxModelImpl()
{
    {
        // PORT-NOTE: the original stops after the "syntax-model" pass and, beyond
        // result.Succeeded, probes the SyntaxModel thread-safety laws: the Box struct
        // carries a single Grant law on "Transferable" with a null Condition, the
        // LocalOnly enum carries a single Deny law on "Transferable", the Move function
        // carries laws ["Transferable", "Shareable"] each with TypeText "T", and the
        // Holder.Relay function carries a single Transferable law with TypeText "T".
        // Thread-safety-law model access is not expressible via the compile helpers,
        // so this reduces to "the embedded program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "syntax-model-thread-safety-law-predicates-attributes",
            raw"""
module Demo

[Grant(Transferable)]
struct Box<T>
{
    [Grant(Shareable) where Transferable(T)]
    T Payload;
}

[Deny(Transferable)]
enum LocalOnly
{
    None
}

fn T Move<T>(T value) where Transferable(T), Shareable(T)
{
    return value;
}

struct Holder
{
    fn T Relay<T>(T value) where Transferable(T)
    {
        return value;
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSyntaxModelTests.StructAndRecordDestructorsFlowIntoSyntaxModel.
internal fn bool StructAndRecordDestructorsFlowIntoSyntaxModelImpl()
{
    {
        // PORT-NOTE: the original stops after the "syntax-model" pass and, beyond
        // result.Succeeded, probes the SyntaxModel declarations to confirm the Buffer
        // struct has a non-null, non-mutable Destructor and the Cursor record has a
        // non-null, mutable Destructor. Destructor-model access is not expressible via
        // the compile helpers, so this reduces to "the embedded program type-checks
        // successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "syntax-model-struct-and-record-destructors",
            raw"""
module Demo

struct Buffer
{
    i32[min max] Value;

    drop
    {
        ;
    }
}

record Cursor(i32[min max] Position)
{
    mut drop
    {
        self.Position = 0;
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSyntaxModelTests.TypeAliasDeclarationsFlowIntoSyntaxModel.
internal fn bool TypeAliasDeclarationsFlowIntoSyntaxModelImpl()
{
    {
        // PORT-NOTE: the original stops after the "syntax-model" pass and, beyond
        // result.Succeeded, probes the SyntaxModel TypeAlias declarations: "Byte" is
        // Public with AliasedType "i8[minmax]" and no generic parameters, while
        // "BufferView" is Module-visible with AliasedType "borrowT[]" and generic
        // parameters ["T"]. TypeAlias-model access is not expressible via the compile
        // helpers, so this reduces to "the embedded program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "syntax-model-type-alias-declarations",
            raw"""
module Demo

public alias Byte = i8[min max];
alias BufferView<T> = borrow T[];
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSyntaxModelTests.GenericFunctionDeclarationsCarryTypeParametersIntoSyntaxModel.
internal fn bool GenericFunctionDeclarationsCarryTypeParametersIntoSyntaxModelImpl()
{
    {
        // PORT-NOTE: the original stops after the "syntax-model" pass and, beyond
        // result.Succeeded, probes the SyntaxModel declarations to confirm that
        // Identity, Box.Echo, Reader.Read, and Projector.Project each carry a
        // non-null Function that IsGeneric with GenericParams ["T"]. Function
        // generic-parameter model access is not expressible via the compile helpers,
        // so this reduces to "the embedded program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "syntax-model-generic-function-type-parameters",
            raw"""
module Demo

public fn T Identity<T>(T value)
{
    return value;
}

struct Box
{
    fn T Echo<T>(T value)
    {
        return value;
    }
}

trait Reader
{
    law T Read<T>(T value);
}

doctrine Projector
{
    law T Project<T>(T value);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSyntaxModelTests.BackendOpaqueCallableAttributeForcesNoInlineEffect.
internal fn bool BackendOpaqueCallableAttributeForcesNoInlineEffectImpl()
{
    // PORT-NOTE: The C# test runs the pipeline to "refine-function-effects", fetches the
    // FunctionEffectModel artifact, and asserts Read.BackendOptimizationMode == Opaque and
    // Read.InlinePreference == NoInline. The Stark helpers cannot stop at that pass or
    // inspect the FunctionEffectModel, so this is reduced to compiling the same program
    // through type-check and asserting it succeeds (the precondition for the effect facts).
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "backend-opaque-callable-no-inline",
        raw"""
module Demo

[Backend(Opaque)]
finite law i32[min max] Read()
{
    return 1;
}
""");
    return Succeeds(compiled);
}
