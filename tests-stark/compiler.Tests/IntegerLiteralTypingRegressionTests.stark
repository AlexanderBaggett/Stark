import CompilerTestSupport
import System.Testing
module IntegerLiteralTypingRegressionTests

// Ported from IntegerLiteralTypingRegressionTests.NonFittingLiteralStillRequiresExplicitCast.
internal fn bool NonFittingLiteralStillRequiresExplicitCastImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-non-fitting-literal-still-requires-explicit-cast",
        raw"""
module Demo

fn void Run(u8[0 max] small)
{
    stack u8[0 max] a = small + 1000;
}
""");
    return FailsWithDiagnosticMessage(compiled, "STK3002", "narrowing conversion is required");
}

// Ported from IntegerLiteralTypingRegressionTests.NegativeLiteralIntoUnsignedOperandStillRequiresExplicitCast.
internal fn bool NegativeLiteralIntoUnsignedOperandStillRequiresExplicitCastImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-negative-literal-into-unsigned-operand-still-requires-explicit-cast",
        raw"""
module Demo

fn void Run(u64[0 2 ** 63 - 1] position)
{
    stack u64[0 2 ** 63 - 1] a = position + -1;
}
""");
    return FailsWithDiagnosticMessage(compiled, "STK3002", "narrowing conversion is required");
}

// Ported slice of tests/compiler.Tests/IntegerLiteralTypingRegressionTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through CompileTypeCheck and returns true when the original xUnit
// assertions would hold. AssertNoNarrowingCastRequired asserts both that the
// compilation succeeds AND that no STK3002 (narrowing-conversion) diagnostic is
// present, so each Impl mirrors that as Succeeds(c) and not HasDiagnostic(STK3002).

// Ported from IntegerLiteralTypingRegressionTests.AdditiveLiteralAdoptsRangedUnsignedOperandType.
internal fn bool AdditiveLiteralAdoptsRangedUnsignedOperandTypeImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-additive-literal-adopts-ranged-unsigned",
            raw"""
module Demo

fn void Run(u64[0 2 ** 63 - 1] position, u64[0 2 ** 63 - 1] length)
{
    stack u64[0 2 ** 63 - 1] a = position + 1;
    stack u64[0 2 ** 63 - 1] b = length - 1;
    stack u64[0 2 ** 63 - 1] c = 1 + position;
}
""");

        // Original asserts: result.Succeeded and no STK3002 narrowing diagnostic.
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK3002");
    }
}

// Ported from IntegerLiteralTypingRegressionTests.MultiplicativeLiteralAdoptsRangedUnsignedOperandType.
internal fn bool MultiplicativeLiteralAdoptsRangedUnsignedOperandTypeImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-multiplicative-literal-adopts-ranged-unsigned",
            raw"""
module Demo

fn void Run(u64[0 2 ** 63 - 1] position)
{
    stack u64[0 2 ** 63 - 1] a = position * 2;
    stack u64[0 2 ** 63 - 1] b = position % 8;
}
""");

        // Original asserts: result.Succeeded and no STK3002 narrowing diagnostic.
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK3002");
    }
}

// Ported from IntegerLiteralTypingRegressionTests.BitwiseLiteralAdoptsRangedUnsignedOperandType.
internal fn bool BitwiseLiteralAdoptsRangedUnsignedOperandTypeImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-bitwise-literal-adopts-ranged-unsigned",
            raw"""
module Demo

fn void Run(u64[0 2 ** 63 - 1] flags)
{
    stack u64[0 2 ** 63 - 1] a = flags | 1;
    stack u64[0 2 ** 63 - 1] b = flags & 255;
}
""");

        // Original asserts: result.Succeeded and no STK3002 narrowing diagnostic.
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK3002");
    }
}

// Ported from IntegerLiteralTypingRegressionTests.LiteralAdoptsSignedRangedOperandType.
internal fn bool LiteralAdoptsSignedRangedOperandTypeImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-literal-adopts-signed-ranged",
            raw"""
module Demo

fn void Run(i8[-100 100] count)
{
    stack i8[-100 100] a = count + 1;
    stack i8[-100 100] b = count - 1;
}
""");

        // Original asserts: result.Succeeded and no STK3002 narrowing diagnostic.
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK3002");
    }
}

// Ported from IntegerLiteralTypingRegressionTests.LiteralAdoptionStripsQualifiersFromTheAnchorOperand.
internal fn bool LiteralAdoptionStripsQualifiersFromTheAnchorOperandImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-literal-adoption-strips-qualifiers",
            raw"""
module Demo

fn void Grow(out u64[0 2 ** 63 - 1] capacity)
{
    capacity = 8;
    capacity = (u64[0 2 ** 63 - 1])(capacity * 2);
}
""");

        // Original asserts: result.Succeeded and no STK3002 narrowing diagnostic.
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK3002");
    }
}
