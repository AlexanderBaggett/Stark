import CompilerTestSupport
import System.Testing

module LoweringContractValidationTests_PIPELINEP1

// Ported from LoweringContractValidationTests.ValidateLoweringContractRunsBeforeHirAndAcceptsTypedOperationFacts.
public unsafe fn bool ValidateLoweringContractRunsBeforeHirAndAcceptsTypedOperationFactsImpl()
{
    unsafe
    {
        // PORT-NOTE: the original compiles ContractSource through the "validate-lowering-contract"
        // pass and then probes artifacts the compile helpers cannot reach: it reads the
        // LoweringContractValidationModel (asserting ModuleName == "System.Text" and the
        // CheckedFunctionCount/CheckedCallCount/CheckedIndexAccessCount/CheckedObjectCreationCount/
        // CheckedLambdaCount/CheckedTypeLayoutExpressionCount/CheckedDynamicStorageOperationCount/
        // CheckedSwitchCount thresholds), reads the TypeCheckModel and asserts its BoundOperations
        // include each BoundOperationKind (DirectCall, MemberCall, FunctionPointerCall, ClosureCall,
        // IndexAccess, ObjectCreation, EnumCall, DynamicStorageOperation, TextInterpolation,
        // TextBuild, LayoutQuery, SwitchDispatch), and inspects the pass-execution log to confirm
        // "validate-lowering-contract" executed while "lower-hir" did not. The harness cannot read
        // these validation/type-check artifact models or the per-pass execution records, so this
        // reduces to "ContractSource type-checks (running through the lowering-contract validation
        // that precedes lower-hir)" via the stop-after-type-check helper. The embedded program is
        // kept verbatim from the C# raw string literal.
        stack mut LlvmCompile contract = CompileTypeCheck(
            "validate-lowering-contract",
            raw"""
module System.Text

public unsafe finite bool TryConcatAscii(rawmutptr<Ascii> destination, ascii left, ascii right);

enum Status
{
    Ok,
    Err(i32[min max]),
}

struct Box
{
    i32[min max] Value;

    fn i32[min max] Get(borrow Box self)
    {
        return self.Value;
    }

    fn bool Fill(borrow Box self, out i32[min max] value)
    {
        value = self.Value;
        return true;
    }
}

fn i32[min max] Inc(i32[min max] value)
{
    return value + 1;
}

unsafe fn i32[min max] Apply(fnptr<fn i32[min max](i32[min max])> op, i32[min max] value)
{
    return op(value);
}

fn bool Write(out i32[min max] value)
{
    value = 9;
    return true;
}

unsafe fn bool ApplyOut(fnptr<fn bool(out i32[min max])> op, out i32[min max] value)
{
    return op(value);
}

fn i32[min max] Choose(bool flag)
{
    switch (flag)
    {
        case true:
            return 1;
        case false:
            return 0;
    }
}

fn i32[min max] Score(Status status)
{
    switch (status)
    {
        case Status.Ok:
            return 1;
        case Status.Err(var error):
            return error;
    }
}

unsafe fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 3
    };
    stack mut i32[min max][2] values =
    {
        4, 5
    };
    stack fnptr<fn i32[min max](i32[min max])> lambda = (i32[min max] value) => Inc(value);
    stack closure<finite law i32[min max](i32[min max])> closureOp =
        (i32[min max] value) => value + 6;
    stack mut dynamic u32[0 max] items = new(1);
    stack i64[min max] boxSize = sizeof(Box);
    stack i64[min max] boxAlign = alignof(Box);
    stack Ascii label[8] = $"ok";
    stack Ascii joined[12] = label + "!";
    values[0] = Inc(box.Get());
    items.Reserve(1);
    if (!box.Fill(values[1]))
    {
        return 0;
    }
    if (!ApplyOut(Write, values[1]))
    {
        return 0;
    }
    return values[0] + values[1] + Apply(Inc, 2) + Apply(lambda, 3) + closureOp(6) + Choose(true) + Score(Status.Err(4));
}
""");
        return Succeeds(contract);
    }
}
