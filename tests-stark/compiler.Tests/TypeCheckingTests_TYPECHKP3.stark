// Ported from TypeCheckingTests.NumericOverloadResolutionPrefersExactAndNarrowSafeMatches.
public unsafe fn bool NumericOverloadResolutionPrefersExactAndNarrowSafeMatchesImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-numeric-overload-prefers-exact-narrow-safe",
            raw"""
module Demo

fn bool PickFloat(f64 value)
{
    return true;
}

fn i32[min max] PickFloat(f32 value)
{
    return 1;
}

fn bool PickInteger(u32[0 max] value)
{
    return true;
}

fn i32[min max] PickInteger(i48[min max] value)
{
    return 2;
}

fn i32[min max] PickInteger(i64[min max] value)
{
    return 3;
}

fn i32[min max] PickInteger(f64 value)
{
    return 4;
}

fn bool RunFloat()
{
    stack f64 value = 3.5;
    return PickFloat(value);
}

fn bool RunInteger()
{
    stack u32[0 max] value = (u32[0 max])42;
    return PickInteger(value);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.MethodOverloadGroupsRegisterDistinctFunctionsAndResolveCalls.
public unsafe fn bool MethodOverloadGroupsRegisterDistinctFunctionsAndResolveCallsImpl()
{
    unsafe
    {
        // PORT-NOTE: the original also probes Overloads["Counter.Scale"]
        // (count 2) and counts Functions keys starting with "Counter.Scale#("
        // (2). The overload/function-key tables are not expressible via the
        // compile helpers, so this reduces to "the embedded program type-checks
        // successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-method-overload-groups-resolve",
            raw"""
module Demo

struct Counter
{
    i32[min max] Value;

    fn i32[min max] Scale(borrow Counter self, i32[min max] factor)
    {
        return self.Value * factor;
    }

    fn i32[min max] Scale(borrow Counter self, bool doubleIt)
    {
        if (doubleIt)
        {
            return self.Value * 2;
        }

        return self.Value;
    }
}

fn i32[min max] Run()
{
    stack Counter counter = new Counter()
    {
        Value = 3
    };
    return counter.Scale(4);
}

fn i32[min max] RunBool()
{
    stack Counter counter = new Counter()
    {
        Value = 3
    };
    return counter.Scale(true);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.TargetTypedObjectCreationResolvesFromDestinationType.
public unsafe fn bool TargetTypedObjectCreationResolvesFromDestinationTypeImpl()
{
    unsafe
    {
        // PORT-NOTE: the original also probes ObjectCreations (5 entries, all
        // CreatedType "Box", all with a resolved Constructor, exactly one with a
        // single member initializer). The ObjectCreations table is not
        // expressible via the compile helpers, so this reduces to "the embedded
        // program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-target-typed-object-creation-destination",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    Box()
    {
        self.Value = 0;
    }

    Box(i32[min max] value)
    {
        self.Value = value;
    }
}

fn Box Make(i32[min max] value)
{
    return new(value);
}

fn i32[min max] Run(i32[min max] value)
{
    stack Box empty = new();
    stack Box initialized = new()
    {
        Value = value
    };
    stack mut Box assigned = new(value);
    assigned = new(value);
    return assigned.Value + empty.Value + initialized.Value;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.TargetTypedObjectCreationResolvesAllocatorTakingConstructorOverload.
public unsafe fn bool TargetTypedObjectCreationResolvesAllocatorTakingConstructorOverloadImpl()
{
    unsafe
    {
        // PORT-NOTE: the original also probes the List ObjectCreations'
        // constructors, asserting one has 0 parameters and one has a single
        // "Allocator" parameter. The ObjectCreations/constructor table is not
        // expressible via the compile helpers, so this reduces to "the embedded
        // program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-target-typed-object-creation-allocator-overload",
            raw"""
module Demo

struct Allocator
{
    i32[0 255] Tag;
}

struct List
{
    i32[0 max] Capacity;

    List()
    {
        self.Capacity = 0;
    }

    List(Allocator allocator)
    {
        self.Capacity = allocator.Tag;
    }
}

fn List MakeDefault()
{
    return new();
}

fn List MakeCustom(Allocator allocator)
{
    return new(allocator);
}
""");
        return Succeeds(compiled);
    }
}

