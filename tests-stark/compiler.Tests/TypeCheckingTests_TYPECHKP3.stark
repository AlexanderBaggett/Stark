import CompilerTestSupport
import System.Testing

module TypeCheckingTests_TYPECHKP3

// Ported slice of tests/compiler.Tests/TypeCheckingTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through CompileTypeCheck and returns true when the original xUnit
// assertions would hold. Every method in this slice is a positive
// should-type-check fact whose primary assertion is result.Succeeded; the
// remaining assertions probe the TypeCheckModel (InstantiationTriggers,
// TypeTriggers, TypeAliases, NamedTypes/variants, Overloads, ObjectCreations,
// closure/return display names). Those artifact-dictionary probes are not
// expressible via the compile helpers, so the PORT-NOTE comments flag what was
// reduced to the nearest signal (Succeeds).

// Ported from TypeCheckingTests.GenericFunctionCallsRecordConcreteInstantiationTriggers.
public unsafe fn bool GenericFunctionCallsRecordConcreteInstantiationTriggersImpl()
{
    unsafe
    {
        // PORT-NOTE: the original also probes a single InstantiationTriggers
        // entry ("Identity" with ["i32"] type arguments and an i32-substituted
        // generic-instantiation signature). The TypeCheckModel trigger table is
        // not expressible via the compile helpers, so this reduces to "the
        // embedded program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-generic-function-call-triggers",
            raw"""
module Demo

fn T Identity<T>(T value)
{
    return value;
}

fn i32[min max] Run()
{
    stack i32[min max] value = 42;
    return Identity(value);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.GenericMethodCallsRecordConcreteInstantiationTriggers.
public unsafe fn bool GenericMethodCallsRecordConcreteInstantiationTriggersImpl()
{
    unsafe
    {
        // PORT-NOTE: the original also probes a single InstantiationTriggers
        // entry ("Box.Echo" with ["i32"] type arguments and a generic
        // instantiation whose parameters are "borrow Box" and "i32"). The
        // trigger table is not expressible via the compile helpers, so this
        // reduces to "the embedded program type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-generic-method-call-triggers",
            raw"""
module Demo

struct Box
{
    fn T Echo<T>(borrow Box self, T value)
    {
        return value;
    }
}

fn i32[min max] Run()
{
    stack Box box = new Box();
    stack i32[min max] value = 42;
    return box.Echo(value);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.GenericMethodsOnGenericTypesRecordConcreteInstantiationTriggers.
public unsafe fn bool GenericMethodsOnGenericTypesRecordConcreteInstantiationTriggersImpl()
{
    unsafe
    {
        // PORT-NOTE: the original also probes a single InstantiationTriggers
        // entry ("Box.Echo" with ["i32"] type arguments and parameters
        // "borrow Box<i32>" and "i32"). The trigger table is not expressible via
        // the compile helpers, so this reduces to "the embedded program
        // type-checks successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-generic-method-on-generic-type-triggers",
            raw"""
module Demo

struct Box<T>
{
    T Value;

    fn T Echo(borrow Box<T> self, T value)
    {
        return value;
    }
}

fn i32[min max] Run()
{
    stack Box<i32[min max]> box = new Box<i32[min max]>()
    {
        Value = 1
    };
    stack i32[min max] value = 42;
    return box.Echo(value);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.GenericNestedMemberOutCallsInferStorageType.
public unsafe fn bool GenericNestedMemberOutCallsInferStorageTypeImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-generic-nested-member-out-call",
            raw"""
module Demo

struct Cell<T>
{
    T Value;

    fn bool TryTake(mut borrow Cell<T> self, out T value)
    {
        value = self.Value;
        return true;
    }
}

struct Owner<T>
{
    Cell<T> Inner;

    fn bool TryTake(mut borrow Owner<T> self, out T value)
    {
        return self.Inner.TryTake(value);
    }
}

fn bool Run(mut borrow Owner<i32[0 max]> owner, out i32[0 max] value)
{
    return owner.TryTake(value);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.RepeatedGenericFunctionCallsReuseOneCachedInstantiationTrigger.
public unsafe fn bool RepeatedGenericFunctionCallsReuseOneCachedInstantiationTriggerImpl()
{
    unsafe
    {
        // PORT-NOTE: the original also probes a single InstantiationTriggers
        // entry ("Identity" with ["i32"] type arguments), proving the two calls
        // share one cached trigger. The trigger table is not expressible via the
        // compile helpers, so this reduces to "the embedded program type-checks
        // successfully".
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp3-repeated-generic-function-call-cache",
            raw"""
module Demo

fn T Identity<T>(T value)
{
    return value;
}

fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    return Identity(left) + Identity(right);
}
""");
        return Succeeds(compiled);
    }
}

