import CompilerTestSupport
import System.Testing

module PackageImageTypedAssignmentExpressionIntegrationTests_PKGIMGP1

// Ported from PackageImageTypedAssignmentExpressionIntegrationTests.ManifestBackedTypedAssignmentExpressionsCompileAndRunWithoutSyntheticSource.
public unsafe fn bool ManifestBackedTypedAssignmentExpressionsCompileAndRunWithoutSyntheticSourceImpl()
{
    unsafe
    {
        // PORT-NOTE: The original emits a `Facade` static library via `--emit-lib`,
        // asserts CLI stdout ("Emitted static library:"), empty stderr, exit 0, and
        // the on-disk library plus `.starkpkg` manifest existing. It then loads the
        // package manifest, asserts the `Facade.Observe` generic template has a null
        // BodyText but a non-null TypedBody, rewrites the manifest to drop all source
        // surface (typed-interface/compiler-sections only), deletes the Facade source,
        // and links a `Demo` executable against the manifest-backed library without
        // source -- asserting CLI exit 0, "Emitted executable:" stdout, empty stderr,
        // the output existing, and the linked program running with empty stdout/stderr
        // and exit code 8. The compile helpers cannot express CLI output, package-image
        // manifest contents, typed-body-without-source linking, file-system effects, or
        // runtime exit codes, so this is reduced to compiling the same two-module
        // program (root `Demo` importing dependency `Facade`, which exercises the typed
        // assignment expression `current += value`) through the full LLVM pipeline and
        // asserting it succeeds.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "pkgimg-typed-assignment-expression-manifest-backed",
            raw"""
import Facade
module Demo

export fn i32[min max] main()
{
    stack i32[min max] tag = 0;
    return Facade.Observe(7, tag);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn i32[min max] Observe<T>(i32[min max] value, T tag)
{
    stack mut i32[min max] current = 1;
    return current += value;
}
""");
        return Succeeds(compiled);
    }
}
