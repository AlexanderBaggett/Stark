import System.FileSystem
import System.IO
import System.IO.File
import System.Json
import System.Memory
import System.Process
import System.Testing
import System.Testing.HostCompiler
import System.Text
module CompilerTestSupport

// Shared harness for the ported feature tests: compiles source against the
// current C# host compiler through the host test protocol and exposes the
// outcome for LLVM/diagnostic assertions. Stark-side port of
// tests/compiler.Tests shared Compile/AssertDiagnostic helpers.

const HostTimeoutMilliseconds = 180000;

// One host compile attempt. `Ok` means the transport and protocol succeeded;
// facts check `Outcome.CompileSucceeded()` separately where failure is the
// expectation.
public struct LlvmCompile
{
    HostCompileOutcome Outcome;
    bool Ok;

    LlvmCompile()
    {
        self.Outcome = new();
        self.Ok = false;
    }
}

// Compiles the source through the full pipeline with the LLVM artifact
// requested. `Ok` additionally requires the compile itself to succeed.
public fn LlvmCompile CompileLlvm(ascii id, ascii source)
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(id, source, "", "llvm");
        if (compiled.Ok && !compiled.Outcome.CompileSucceeded())
        {
            compiled.Ok = false;
        }

        return compiled;
    }
}

// Compiles the source through the full pipeline without artifacts. `Ok`
// covers transport/protocol only, so failing compiles can be asserted with
// FailsWithDiagnostic.
public fn LlvmCompile CompileFull(ascii id, ascii source)
{
    unsafe
    {
        return RunHostCompile(id, source, "", "");
    }
}

// Compiles the source stopping after MIR lowering with the MIR text artifact
// requested. `Ok` additionally requires the compile itself to succeed.
public fn LlvmCompile CompileMir(ascii id, ascii source)
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(id, source, "lower-mir", "mir");
        if (compiled.Ok && !compiled.Outcome.CompileSucceeded())
        {
            compiled.Ok = false;
        }

        return compiled;
    }
}

// Compiles the source stopping after type checking, for facts that assert
// diagnostics. `Ok` covers transport/protocol only.
public fn LlvmCompile CompileTypeCheck(ascii id, ascii source)
{
    unsafe
    {
        return RunHostCompile(id, source, "type-check", "");
    }
}

// CompileTypeCheck with a compile-time loop iteration cap, for facts that
// assert the comptime interpreter's iteration limit diagnostics.
public fn LlvmCompile CompileTypeCheckWithLoopLimit(
    ascii id,
    ascii source,
    u32[0 2 ** 31 - 1] maximumComptimeLoopIterations)
{
    unsafe
    {
        return RunHostCompileIn(id, source, "type-check", "", "", maximumComptimeLoopIterations);
    }
}

// True when the transport succeeded and the compile reported success. For
// type-check probes this is the positive-polarity assertion.
public fn bool Succeeds(mut borrow LlvmCompile compiled)
{
    unsafe
    {
        return compiled.Ok && compiled.Outcome.CompileSucceeded();
    }
}

// Compiles `source` stopping after type checking while `moduleSource` is
// resolvable from a temporary search directory. `moduleDirectory` is empty for
// root-level modules ("Worker" -> Worker.stark) or a single subdirectory name
// for dotted modules ("System.Threading" -> System + Threading.stark). Stark-side port of
// the C# facts built on InMemoryModuleResolver.
public fn LlvmCompile CompileTypeCheckWithModule(
    ascii id,
    ascii source,
    ascii moduleDirectory,
    ascii moduleFileName,
    ascii moduleSource)
{
    unsafe
    {
        return RunWithModule(id, source, "type-check", "", moduleDirectory, moduleFileName, moduleSource);
    }
}

// Full-pipeline variant of CompileTypeCheckWithModule. `Ok` covers
// transport/protocol only, so failing compiles can be asserted with
// FailsWithDiagnostic.
public fn LlvmCompile CompileFullWithModule(
    ascii id,
    ascii source,
    ascii moduleDirectory,
    ascii moduleFileName,
    ascii moduleSource)
{
    unsafe
    {
        return RunWithModule(id, source, "", "", moduleDirectory, moduleFileName, moduleSource);
    }
}

// Full-pipeline variant of CompileTypeCheckWithModule with the LLVM artifact
// requested. `Ok` additionally requires the compile itself to succeed.
public fn LlvmCompile CompileLlvmWithModule(
    ascii id,
    ascii source,
    ascii moduleDirectory,
    ascii moduleFileName,
    ascii moduleSource)
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunWithModule(id, source, "", "llvm", moduleDirectory, moduleFileName, moduleSource);
        if (compiled.Ok && !compiled.Outcome.CompileSucceeded())
        {
            compiled.Ok = false;
        }

        return compiled;
    }
}

internal fn LlvmCompile RunWithModule(
    ascii id,
    ascii source,
    ascii stopAfterPassId,
    ascii artifactName,
    ascii moduleDirectory,
    ascii moduleFileName,
    ascii moduleSource)
{
    unsafe
    {
        stack mut OwnedAscii root = new();
        stack mut bool ready = false;
        // System.Testing also exports CreateTempDirectory/CreateDirectory, so these
        // two stay qualified to pick the FileSystem ones.
        switch (System.FileSystem.CreateTempDirectory("stark-feature-modules-"))
        {
            case IOResult<OwnedAscii>.Err(var rootError):
                ready = false;
            case IOResult<OwnedAscii>.Ok(var created):
                root = created;
                ready = true;
        }

        stack mut OwnedAscii filePath = new();
        if (ready)
        {
            ready = MemoryOk(filePath.AppendAscii(root.View()));
        }

        if (ready && AsciiLength(moduleDirectory) > 0)
        {
            ready = MemoryOk(filePath.AppendByte(47))
                && MemoryOk(filePath.AppendAscii(moduleDirectory));
            if (ready)
            {
                ready = IOOk(System.FileSystem.CreateDirectory(filePath.View()));
            }
        }

        if (ready)
        {
            ready = MemoryOk(filePath.AppendByte(47))
                && MemoryOk(filePath.AppendAscii(moduleFileName));
        }

        if (ready)
        {
            ready = IOOk(WriteAllText(filePath.View(), moduleSource));
        }

        stack mut LlvmCompile compiled = new();
        if (ready)
        {
            compiled = RunHostCompileIn(id, source, stopAfterPassId, artifactName, root.View(), 0);
        }

        stack bool cleaned = IOOk(DeleteTreeIfExists(root.View()));
        return compiled;
    }
}

internal finite law bool MemoryOk(MemoryStatus status)
{
    switch (status)
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

internal finite law bool IOOk(IOStatus status)
{
    switch (status)
    {
        case IOStatus.Ok:
            return true;
        case IOStatus.Err(var error):
            return false;
    }
}

// Returns the LLVM artifact text of a successful compile, or empty text.
public fn ascii Llvm(mut borrow LlvmCompile compiled)
{
    unsafe
    {
        return compiled.Outcome.ArtifactText("llvm");
    }
}

// Returns the MIR artifact text of a successful CompileMir, or empty text.
public fn ascii Mir(mut borrow LlvmCompile compiled)
{
    unsafe
    {
        return compiled.Outcome.ArtifactText("mir");
    }
}

// Counts diagnostics that carry the code and whose message contains the
// fragment.
public fn u64[0 2 ** 63 - 1] CountDiagnosticsWithCodeAndMessage(
    mut borrow LlvmCompile compiled,
    ascii code,
    ascii messageFragment)
{
    unsafe
    {
        stack mut u64[0 2 ** 63 - 1] matches = 0;
        stack u64[0 2 ** 63 - 1] count = compiled.Outcome.DiagnosticCount();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (Equals(compiled.Outcome.DiagnosticCodeAt(index), code)
                && System.Testing.Contains(compiled.Outcome.DiagnosticMessageAt(index), messageFragment))
            {
                matches += 1;
            }
        }

        return matches;
    }
}

public fn bool AnyDiagnosticMessageContains(mut borrow LlvmCompile compiled, ascii fragment)
{
    unsafe
    {
        stack u64[0 2 ** 63 - 1] count = compiled.Outcome.DiagnosticCount();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (System.Testing.Contains(compiled.Outcome.DiagnosticMessageAt(index), fragment))
            {
                return true;
            }
        }

        return false;
    }
}

// True when any diagnostic carries the code, regardless of compile outcome.
public fn bool HasDiagnostic(mut borrow LlvmCompile compiled, ascii code)
{
    unsafe
    {
        return compiled.Outcome.HasDiagnosticCode(code);
    }
}

// True when the compile failed and reported the diagnostic code.
public fn bool FailsWithDiagnostic(mut borrow LlvmCompile compiled, ascii code)
{
    unsafe
    {
        if (!compiled.Ok || compiled.Outcome.CompileSucceeded())
        {
            return false;
        }

        return compiled.Outcome.HasDiagnosticCode(code);
    }
}

// True when the compile failed and reported the diagnostic code with a message
// containing the fragment.
public fn bool FailsWithDiagnosticMessage(mut borrow LlvmCompile compiled, ascii code, ascii messageFragment)
{
    unsafe
    {
        if (!FailsWithDiagnostic(compiled, code))
        {
            return false;
        }

        return AnyDiagnosticMessageContains(compiled, messageFragment);
    }
}

internal fn LlvmCompile RunHostCompile(ascii id, ascii source, ascii stopAfterPassId, ascii artifactName)
{
    unsafe
    {
        return RunHostCompileIn(id, source, stopAfterPassId, artifactName, "", 0);
    }
}

internal fn LlvmCompile RunHostCompileIn(
    ascii id,
    ascii source,
    ascii stopAfterPassId,
    ascii artifactName,
    ascii searchDirectory,
    u32[0 2 ** 31 - 1] maximumComptimeLoopIterations)
{
    unsafe
    {
        stack mut OwnedAscii compilerPath = new();
        stack mut bool havePath = false;
        switch (CompilerPathFromEnvironment())
        {
            case HostResult<OwnedAscii>.Err(var pathError):
                havePath = false;
            case HostResult<OwnedAscii>.Ok(var path):
                compilerPath = path;
                havePath = true;
        }

        stack mut HostCompileOutcome outcome = new();
        stack mut bool transportOk = false;
        if (havePath)
        {
            switch (CompileOnceArtifactIn(
                compilerPath.View(),
                id,
                source,
                stopAfterPassId,
                artifactName,
                searchDirectory,
                maximumComptimeLoopIterations,
                HostTimeoutMilliseconds))
            {
                case HostResult<HostCompileOutcome>.Err(var error):
                    transportOk = false;
                case HostResult<HostCompileOutcome>.Ok(var captured):
                    outcome = captured;
                    transportOk = true;
            }
        }

        stack mut bool ok = false;
        if (transportOk)
        {
            ok = !outcome.HadProtocolError();
        }

        stack mut LlvmCompile compiled = new();
        compiled.Ok = ok;
        compiled.Outcome = outcome;
        return compiled;
    }
}
