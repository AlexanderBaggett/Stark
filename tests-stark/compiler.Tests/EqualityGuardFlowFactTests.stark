import CompilerTestSupport
import System.Testing
module EqualityGuardFlowFactTests

// Ported slice of tests/compiler.Tests/EqualityGuardFlowFactTests.cs.
//
// Each C# test embeds a Stark program built from a shared Prelude (the `Demo`
// module with a `Table` struct holding a `dynamic i32[min max] Items` field)
// plus a per-test function. The prelude is inlined verbatim ahead of each
// per-test function. The C# `Compile` helper runs the default pipeline with
// EmitLlvmIr:true; the assertions are all semantic equality-guard / slot-proof
// checks, so each program is routed through CompileTypeCheck.
//
// Positive tests assert AssertSucceeds -> Succeeds(c). The negative tests assert
// AssertSlotProofError(result, slot), which requires a STK4205 diagnostic whose
// message contains BOTH "without a proof that the slot is initialized" AND the
// slot fragment; that conjunction is reproduced with FailsWithDiagnosticMessage
// on the slot fragment plus an AnyDiagnosticMessageContains on the phrase.

// Ported from EqualityGuardFlowFactTests.InequalityEarlyReturnGuardProvesConstantIndexOnSurvivingPath.
internal fn bool InequalityEarlyReturnGuardProvesConstantIndexOnSurvivingPathImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-eqguard-inequality-early-return-proves-const-index",
            raw"""
module Demo

struct Table
{
    dynamic i32[min max] Items;
}

finite law i32[min max] First(borrow Table self)
{
    if (self.Items.Length != 1)
    {
        return -1;
    }

    return self.Items[0];
}
""");
        return Succeeds(compiled);
    }
}

// Ported from EqualityGuardFlowFactTests.EqualityTrueBranchProvesConstantIndices.
internal fn bool EqualityTrueBranchProvesConstantIndicesImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-eqguard-equality-true-branch-proves-const-indices",
            raw"""
module Demo

struct Table
{
    dynamic i32[min max] Items;
}

finite law i32[min max] Second(borrow Table self)
{
    if (self.Items.Length == 2)
    {
        return self.Items[1];
    }

    return -1;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from EqualityGuardFlowFactTests.NonEmptyInequalityProvesIndexZero.
internal fn bool NonEmptyInequalityProvesIndexZeroImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-eqguard-nonempty-inequality-proves-index-zero",
            raw"""
module Demo

struct Table
{
    dynamic i32[min max] Items;
}

finite law i32[min max] FirstNonEmpty(borrow Table self)
{
    if (self.Items.Length != 0)
    {
        return self.Items[0];
    }

    return -1;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from EqualityGuardFlowFactTests.EqualityGuardDoesNotProveOutOfBoundsIndex.
internal fn bool EqualityGuardDoesNotProveOutOfBoundsIndexImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-eqguard-does-not-prove-out-of-bounds-index",
            raw"""
module Demo

struct Table
{
    dynamic i32[min max] Items;
}

finite law i32[min max] PastEnd(borrow Table self)
{
    if (self.Items.Length != 1)
    {
        return -1;
    }

    return self.Items[1];
}
""");
        // AssertSlotProofError(result, "self.Items[1]"): STK4205 whose message
        // contains both the proof phrase and the slot fragment.
        return FailsWithDiagnosticMessage(compiled, "STK4205", "self.Items[1]")
            && AnyDiagnosticMessageContains(compiled, "without a proof that the slot is initialized");
    }
}

// Ported from EqualityGuardFlowFactTests.EqualityFactDiesOnMutatingUse.
internal fn bool EqualityFactDiesOnMutatingUseImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-eqguard-fact-dies-on-mutating-use",
            raw"""
module Demo

struct Table
{
    dynamic i32[min max] Items;
}

fn void Clear(mut borrow dynamic i32[min max] items)
{
}

fn i32[min max] AfterMutation(mut borrow Table self)
{
    if (self.Items.Length != 1)
    {
        return -1;
    }

    Clear(self.Items);
    return self.Items[0];
}
""");
        // AssertSlotProofError(result, "self.Items[0]"): STK4205 whose message
        // contains both the proof phrase and the slot fragment.
        return FailsWithDiagnosticMessage(compiled, "STK4205", "self.Items[0]")
            && AnyDiagnosticMessageContains(compiled, "without a proof that the slot is initialized");
    }
}
