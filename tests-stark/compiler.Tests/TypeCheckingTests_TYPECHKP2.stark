// Ported from TypeCheckingTests.NestedAggregateWholeValueSwitchCapturesTypeCheck.
public unsafe fn bool NestedAggregateWholeValueSwitchCapturesTypeCheckImpl()
{
    unsafe
    {
        // PORT-NOTE: original also probes the TypeCheckModel artifact is present;
