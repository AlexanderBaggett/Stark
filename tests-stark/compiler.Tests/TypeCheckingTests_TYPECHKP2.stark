// Ported from TypeCheckingTests.FrozenReachableViewsTypeCheckAsReadonlyAliases.
public unsafe fn bool FrozenReachableViewsTypeCheckAsReadonlyAliasesImpl()
{
    unsafe
    {
        // PORT-NOTE: original also probes the TypeCheckModel artifact is present;
        // reduced to the result.Succeeded signal.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp2-frozen-reachable-views-readonly-aliases",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

struct PtrBox
{
    rawmutptr<i32[min max]> Ptr;
}

unsafe finite law void Run(frozen Box box, frozen PtrBox ptrBox)
{
    stack rawptr<frozen i32[min max]> valuePtr = &box.Value;
    stack rawptr<frozen i32[min max]> readonlyPtr = ptrBox.Ptr;
    stack bool valuesEqual = *valuePtr == *readonlyPtr;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.ConstParameterProvenanceTypeChecksAsReadonlyAliases.
public unsafe fn bool ConstParameterProvenanceTypeChecksAsReadonlyAliasesImpl()
{
    unsafe
    {
        // PORT-NOTE: original also probes the TypeCheckModel artifact is present;
        // reduced to the result.Succeeded signal.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp2-const-parameter-provenance-readonly-aliases",
            raw"""
module Demo

struct PtrBox
{
    rawmutptr<i32[min max]> Ptr;
}

unsafe fn void Inspect(const PtrBox box, const rawmutptr<i32[min max]> ptr)
{
    stack rawptr<frozen i32[min max]> fieldPtr = box.Ptr;
    stack rawptr<frozen i32[min max]> directPtr = ptr;
    stack i32[min max] value = *ptr;
    stack bool valuesEqual = *fieldPtr == *directPtr;
    return;
}
""");
        return Succeeds(compiled);
    }
}

