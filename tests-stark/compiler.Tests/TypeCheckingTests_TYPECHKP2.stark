// Ported from TypeCheckingTests.AggregateSwitchPatternsTypeCheckOnScalarFields.
public unsafe fn bool AggregateSwitchPatternsTypeCheckOnScalarFieldsImpl()
{
    unsafe
    {
        // PORT-NOTE: original also probes the TypeCheckModel artifact is present;
        // reduced to the result.Succeeded signal.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp2-aggregate-switch-patterns-scalar-fields",
            raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

finite law i32[min max] Run(Pair value)
{
    switch (value)
    {
        case Pair(1, var right):
            return right;
        case Pair(_, _):
            return 0;
    }
}
""");
        return Succeeds(compiled);
    }
}

