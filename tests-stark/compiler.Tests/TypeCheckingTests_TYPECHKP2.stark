// Ported from TypeCheckingTests.EnumWholeValueSwitchCapturesTypeCheck.
public unsafe fn bool EnumWholeValueSwitchCapturesTypeCheckImpl()
{
    unsafe
    {
        // PORT-NOTE: original also probes the TypeCheckModel artifact is present;
        // reduced to the result.Succeeded signal.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp2-enum-whole-value-switch-captures",
            raw"""
module Demo

enum Token
{
    Empty,
    Pair(i32[min max], i32[min max]),
}

finite law i32[min max] Run(Token value)
{
    switch (value)
    {
        case Token.Pair capture:
            switch (capture)
            {
                case Token.Pair(var left, var right):
                    return left + right;
                default:
                    return 0;
            }
        default:
            return -1;
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.GuardedSwitchLabelsDoNotContributeToReachabilityCoverage.
public unsafe fn bool GuardedSwitchLabelsDoNotContributeToReachabilityCoverageImpl()
{
    unsafe
    {
        // PORT-NOTE: original also probes the TypeCheckModel artifact is present;
        // reduced to the result.Succeeded signal plus the explicit
        // DoesNotContain(STK3019) reachability check.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp2-guarded-switch-labels-no-reachability-coverage",
            raw"""
module Demo

finite law i32[min max] Run(bool value, bool allow)
{
    switch (value)
    {
        case true when allow:
            return 1;
        case true:
            return 2;
        default:
            return 0;
    }
}
""");
        return Succeeds(compiled) and not HasDiagnostic(compiled, "STK3019");
    }
}

