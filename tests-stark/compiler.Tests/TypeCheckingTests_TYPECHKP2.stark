        // to the result.Succeeded signal.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp2-nested-generic-types-monomorphize-triggers",
            raw"""
module Demo

record Pair<A, B>(A First, B Second)
{
}

unsafe fn i32[min max] Read(rawptr<Pair<i32[min max], bool>> ptr)
{
    if ((*ptr).Second)
    {
        return (*ptr).First;
    }

    return 0;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.GenericFunctionBodiesCanUseTheirTypeParametersInLocalTypes.
public unsafe fn bool GenericFunctionBodiesCanUseTheirTypeParametersInLocalTypesImpl()
{
    unsafe
    {
        // PORT-NOTE: original additionally probes the TypeCheckModel artifact
        // (Functions contains "Identity" with IsGeneric, GenericParams ["T"],
        // ReturnType/parameter DisplayName "T"); not expressible via the compile
        // helpers, so reduced to the result.Succeeded signal.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp2-generic-function-bodies-type-parameters-local-types",
            raw"""
module Demo

fn T Identity<T>(T value)
{
    stack T copy = value;
    return copy;
}
""");
        return Succeeds(compiled);
    }
}

