// Ported from TypeCheckingTests.EnumSwitchPatternsTypeCheckOnCasePayloadCaptures.
public unsafe fn bool EnumSwitchPatternsTypeCheckOnCasePayloadCapturesImpl()
{
    unsafe
    {
        // PORT-NOTE: original also probes the TypeCheckModel artifact is present;
        // reduced to the result.Succeeded signal.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp2-enum-switch-patterns-case-payload-captures",
            raw"""
module Demo

enum Token
{
    End,
    Integer(i32[min max]),
    Move
    {
        X: i32[min max], Y: i32[min max]
    },
}

finite law i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.End:
            return 0;
        case Token.Integer(var value):
            return value;
        case Token.Move
        {
            X: var x, Y: var y
        }:
            return x + y;
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.GenericEnumInstantiationTypeChecks.
public unsafe fn bool GenericEnumInstantiationTypeChecksImpl()
{
    unsafe
    {
        // PORT-NOTE: original additionally probes the TypeCheckModel artifact
        // (NamedTypes contains "Option" and "Option<i32>", the monomorphized
        // Kind == Enum with 2 Variants, template IsGeneric); not expressible via
        // the compile helpers, so reduced to the result.Succeeded signal.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp2-generic-enum-instantiation",
            raw"""
module Demo

enum Option<T>
{
    None,
    Some(T),
}

finite law bool HasValue(Option<i32[min max]> opt)
{
    switch (opt)
    {
        case Option<i32[min max]>.None:
            return false;
        case Option<i32[min max]>.Some(var value):
            return value > 0;
    }
}
""");
        return Succeeds(compiled);
    }
}

