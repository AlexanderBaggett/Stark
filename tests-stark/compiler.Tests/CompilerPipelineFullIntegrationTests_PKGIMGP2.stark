    }
}

// Ported from CompilerPipelineFullIntegrationTests.ManifestBackedTypeAliasesRoundTripWithoutSourceFiles.
public unsafe fn bool ManifestBackedTypeAliasesRoundTripWithoutSourceFilesImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes the Facade library to a package image, asserts the published
        // type aliases (BufferView/ExportedPair/PublicPair with their visibilities and target types, while
        // the internal HiddenPair is dropped), writes the manifest, deletes the source, then re-imports
        // Facade into a Demo consumer and asserts the round-tripped alias declarations and TypeCheckModel
        // keys. Package-image construction, manifest round-tripping, filesystem effects, and the import
        // resolver are not expressible with the compile helpers, so this reduces to type-checking the
        // embedded Facade library (the publishable surface) and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "manifest-type-aliases-round-trip",
            raw"""
module Facade

public struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

alias HiddenPair = Pair;
public alias PublicPair = HiddenPair;
export alias ExportedPair = HiddenPair;
public alias BufferView<T> = T[];

public finite law i32[min max] Left(PublicPair value, BufferView<i32[min max]> view)
{
    return value.Left + view[0];
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.ManifestBackedTypeAliasesResolveFromPackageImageFactsWhenBridgeAliasSourceIsCorrupted.
public unsafe fn bool ManifestBackedTypeAliasesResolveFromPackageImageFactsWhenBridgeAliasSourceIsCorruptedImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes the Facade library, builds an imported module document, then
        // corrupts the bridge alias source ("public alias PublicPair = Pair;" -> "... = Missing;") and
        // re-parses it, and proves a Demo consumer still resolves Facade.PublicPair to Facade.Pair from the
        // package-image facts rather than the corrupted parse tree. Package-image construction, document
        // corruption/re-parsing, and the DocumentOnly resolver consumer are not expressible with the
        // compile helpers, so this reduces to type-checking the embedded (uncorrupted) Facade library and
        // asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "manifest-type-aliases-resolve-from-facts-corrupted-bridge",
            raw"""
module Facade

public struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

public alias PublicPair = Pair;
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.ManifestBackedAliasDoctrineAndTraitImportsResolveFromPackageImageFactsWhenImportedParseTreeIsEmpty.
public unsafe fn bool ManifestBackedAliasDoctrineAndTraitImportsResolveFromPackageImageFactsWhenImportedParseTreeIsEmptyImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes the Facade library (struct + alias + doctrine + trait), builds
        // an imported document, replaces its parse tree with an empty "module Facade", and proves a Demo
        // consumer still resolves Facade.PublicPair, the Numbers doctrine, and the Comparable trait from
        // package-image facts. Package-image construction, parse-tree replacement, and the DocumentOnly
        // resolver consumer are not expressible with the compile helpers, so this reduces to type-checking
        // the embedded (full) Facade library and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "manifest-alias-doctrine-trait-resolve-from-facts-empty-parse",
            raw"""
module Facade

public struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

public alias PublicPair = Pair;

public doctrine Numbers
{
    finite law i32[min max] Double(i32[min max] value)
    {
        return value + value;
    }
}

public trait Comparable
{
    law i32[min max] Compare(i32[min max] other);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.ManifestBackedInternalTypeAliasesRemainHiddenFromConsumers.
public unsafe fn bool ManifestBackedInternalTypeAliasesRemainHiddenFromConsumersImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes the Facade library (an `internal alias Hidden = i32[min max]`
        // plus a public `Id` law), asserts the package image omits the internal alias, deletes the source,
        // then compiles a Demo consumer that names `Facade.Hidden` and asserts it FAILS with STK3004 because
        // the internal alias is hidden across the package boundary. Package-image construction, filesystem
        // effects, and the cross-module import resolver are not expressible with the compile helpers (the
        // consumer cannot resolve `import Facade` standalone), so this reduces to type-checking the embedded
        // Facade library (the publishable surface, which omits the internal alias) and asserting it succeeds;
        // the cross-package STK3004 hidden-alias diagnostic cannot be reproduced here.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "manifest-internal-type-aliases-remain-hidden",
            raw"""
module Facade

internal alias Hidden = i32[min max];

public finite law i32[min max] Id(i32[min max] value)
{
    return value;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.ManifestBackedTypeDestructorsRoundTripWithoutSourceFiles.
public unsafe fn bool ManifestBackedTypeDestructorsRoundTripWithoutSourceFilesImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes the Facade library (a Counter struct with a `mut drop`
        // destructor), asserts the published destructor is mutable and its body text contains
        // "self.Value = 0;", writes the manifest, deletes the source, then re-imports Facade into a Demo
        // consumer and asserts the round-tripped Counter destructor is mutable. Package-image construction,
        // manifest round-tripping, filesystem effects, and the import resolver are not expressible with the
        // compile helpers, so this reduces to type-checking the embedded Facade library (the publishable
        // surface) and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "manifest-type-destructors-round-trip",
            raw"""
module Facade

public struct Counter
{
    i32[min max] Value;

    mut drop
    {
        self.Value = 0;
    }
}
""");
        return Succeeds(compiled);
    }
}
