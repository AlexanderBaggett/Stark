// Ported from CompilerPipelineFullIntegrationTests.PackageManifestPublishesRawPointerDereferenceTypedTemplateBodies.
public unsafe fn bool PackageManifestPublishesRawPointerDereferenceTypedTemplateBodiesImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes a package image and inspects Facade.Observe's typed body
        // (a local-variable initialized by a unary "*" deref, then a return whose assignment target is a
        // unary "*" deref) plus manifest JSON ("unary", no "BodyText"). Package-image and typed-body facts
        // are not expressible with the compile helpers, so this reduces to type-checking the embedded
        // library and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "pkgimg-raw-pointer-dereference-template-bodies",
            raw"""
module Facade

public unsafe fn i32[min max] Observe<T>(rawmutptr<i32[min max]> ptr, i32[min max] value, T tag)
{
    stack mut i32[min max] copy = *ptr;
    return *ptr += copy + value;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.PackageManifestPublishesProjectedRawPointerDereferenceTypedTemplateBodies.
public unsafe fn bool PackageManifestPublishesProjectedRawPointerDereferenceTypedTemplateBodiesImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes a package image and inspects Facade.Observe's typed body
        // (a compound "+=" assignment whose field-access target roots on a unary "*" deref, then a return
        // whose "=" assignment target is an index-access projecting through field-access, unary "*", and a
        // direct-call) plus manifest JSON ("field-access"/"index-access", no "BodyText"). Package-image and
        // typed-body facts are not expressible with the compile helpers, so this reduces to type-checking
        // the embedded library and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "pkgimg-projected-raw-pointer-dereference-template-bodies",
            raw"""
module Facade

public record Buffer(i32[min max] First, i32[min max][4] Values)
{
}

public unsafe fn rawmutptr<Buffer> Pick<T>(rawmutptr<Buffer> ptr, T tag)
{
    return ptr;
}

public unsafe fn i32[min max] Observe<T>(rawmutptr<Buffer> ptr, i32[min max] slot, i32[min max] value, T tag)
{
    (*ptr).First += value;
    return (*Pick(ptr, tag)).Values[slot] = (*ptr).First + value;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.PackageManifestPublishesAddressOfTypedTemplateBodies.
public unsafe fn bool PackageManifestPublishesAddressOfTypedTemplateBodiesImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes a package image and inspects Facade.Observe's six-statement
        // typed body (the three pointer initializers each unary "&" over field-access, index-access, and
        // a unary "*" deref) plus manifest JSON (no "BodyText", contains the escaped ampersand "&").
        // Package-image and typed-body facts are not expressible with the compile helpers, so this reduces
        // to type-checking the embedded library and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "pkgimg-address-of-template-bodies",
            raw"""
module Facade

public record Buffer(i32[min max] First, i32[min max][4] Values)
{
}

public unsafe fn i32[min max] Observe<T>(i32[min max] value, T tag)
{
    stack mut i32[min max][4] data =
    {
        1, 2, 3, 4
    };
    stack mut Buffer buffer =
    {
        First = value, Values = data
    };
    stack rawmutptr<i32[min max]> firstPtr = &buffer.First;
    stack rawmutptr<i32[min max]> slotPtr = &buffer.Values[2];
    stack rawmutptr<i32[min max]> aliasPtr = &*slotPtr;
    return *aliasPtr = *firstPtr + value;
}
""");
        return Succeeds(compiled);
    }
}

