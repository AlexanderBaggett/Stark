            "pkgimg-template-enum-constructor-facts",
            raw"""
module Facade

public enum Boxed<T>
{
    Value
    {
        Data: T, Tag: i8[min max]
    },
}

public fn Boxed<T> Wrap<T>(T value)
{
    return Boxed<T>.Value
    {
        Data: value, Tag: 1
    };
}
""");
        return Succeeds(compiled);
    }
}

