import CompilerTestSupport
import System.Testing

module CompilerPipelineFullIntegrationTests_PKGIMGP2

// Ported from CompilerPipelineFullIntegrationTests.PackageManifestPublishesEmptyBlockAndOpenEndedLoopTypedTemplateBodies.
public unsafe fn bool PackageManifestPublishesEmptyBlockAndOpenEndedLoopTypedTemplateBodiesImpl()
{
    unsafe
    {
        // PORT-NOTE: The original builds a package image from the Facade library, then probes the
        // published generic-template typed bodies (empty NoOp body, KeepValue empty+return, NestedScope
        // block with an empty inner statement, CountTo open-ended for loop, EmptySwitch's two empty cases)
        // and the manifest JSON (no "BodyText", contains "empty"/"block"). Package-image construction,
        // typed-body inspection, and manifest JSON are not expressible with the compile helpers, so this
        // reduces to type-checking the embedded library and asserting it succeeds (the precondition for
        // any published template body).
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "pkgimg-empty-block-open-ended-loop-template-bodies",
            raw"""
module Facade

public fn void NoOp<T>(T tag)
{
}

public fn i32[min max] KeepValue<T>(i32[min max] value, T tag)
{
    ;
    return value;
}

public fn i32[min max] NestedScope<T>(i32[min max] value, T tag)
{
    {
        ;
    }

    return value;
}

public fn i32[min max] CountTo<T>(i32[min max] count, T tag)
{
    stack mut i32[min max] index = 0;
    for willexit (;;)
    {
        if (index == count)
        {
            break;
        }

        index = index + 1;
    }

    return index;
}

public fn i32[min max] EmptySwitch<T>(i32[min max] value, T tag)
{
    switch (value)
    {
        case 0:
        default:
    }

    return value;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.PackageManifestPublishesNestedInitializerObjectCreationTypedTemplateBodies.
public unsafe fn bool PackageManifestPublishesNestedInitializerObjectCreationTypedTemplateBodiesImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes a package image and inspects Facade.Wrap's typed body return
        // (object-creation with two arguments: a nested object-initializer for Item with member "Value"
        // and an array-initializer for Values) plus manifest JSON ("object-initializer"/"array-initializer",
        // no "BodyText"). Package-image and typed-body facts are not expressible with the compile helpers,
        // so this reduces to type-checking the embedded library and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "pkgimg-nested-initializer-object-creation-template-bodies",
            raw"""
module Facade

public struct Inner<T>
{
    T Value;
}

public struct Outer<T>
{
    Inner<T> Item;
    i32[min max][2] Values;
}

public fn Outer<T> Wrap<T>(T value, T tag)
{
    return new Outer<T>()
    {
        Item =
        {
            Value = value
        },
        Values =
        {
            7, 9
        }
    };
}
""");
        return Succeeds(compiled);
    }
}

