// Ported from CompilerPipelineFullIntegrationTests.PackageManifestIncludesTypedGenericTemplateEnumConstructorFacts.
public unsafe fn bool PackageManifestIncludesTypedGenericTemplateEnumConstructorFactsImpl()
{
    unsafe
    {
        // PORT-NOTE: The original publishes a package image and inspects Facade.Wrap's single EnumConstructor
        // fact (named enum "Facade.Boxed<T>", variant "Value", two members: Data at index 0 named type "T",
