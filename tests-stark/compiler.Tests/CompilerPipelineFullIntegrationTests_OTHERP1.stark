    // type-checks successfully against the imported Math module".
    stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
        "closed-world-opaque-imported-laws-at-abi-boundary",
        raw"""
import Math
module Demo

law i32[min max] UseLaw(i32[min max] left, i32[min max] right)
{
    return Math.Add(left, right);
}
""",
        "",
        "Math.stark",
        raw"""
module Math

[Backend(Opaque)]
public finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineFullIntegrationTests.DoctrineMethodsUseModuleQualifiedSymbolsWhenEmittingLibraries.
public unsafe fn bool DoctrineMethodsUseModuleQualifiedSymbolsWhenEmittingLibrariesImpl()
{
    // PORT-NOTE: original compiles with QualifyModuleSymbols enabled and inspects the AbiModel
    // (the Numbers.Add doctrine method gets the module-qualified symbol name "Math.Numbers.Add").
    // The compile helpers cannot toggle QualifyModuleSymbols or read the ABI model, so this reduces
    // to "the doctrine library program type-checks successfully" (the precondition for emitting the
    // qualified symbol).
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "doctrine-methods-module-qualified-symbols",
        raw"""
module Math

public doctrine Numbers
{
    finite law i32[min max] Add(i32[min max] left, i32[min max] right)
    {
        return left + right;
    }
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineFullIntegrationTests.DeclaredFunctionSyntaxCollectorMatchesPublishedOverloadKeysFromTypedInterfaceSyntaxModels.
public unsafe fn bool DeclaredFunctionSyntaxCollectorMatchesPublishedOverloadKeysFromTypedInterfaceSyntaxModelsImpl()
{
    // PORT-NOTE: original parses a Facade compilation unit and a hand-built SyntaxModel, then runs
    // DeclaredFunctionSyntaxCollector.Collect and FunctionOverloadFacts.TryFindFunctionDeclaration to
    // assert First and Box.Echo are collected with PublishedOverloadKeys "(BufferView)" and
    // "(borrowBox,BufferView)". The compile helpers cannot construct SyntaxModels, run the declared-
    // function collector, or inspect overload keys, so this reduces to "the parsed Facade program
    // type-checks successfully" (the precondition for the published overload-key collection).
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "declared-function-collector-published-overload-keys",
        raw"""
module Facade

public alias BufferView = i32[min max][];

public fn BufferView First(BufferView view);

public record Box(BufferView Values)
{
    fn BufferView Echo(borrow Box self, BufferView view);
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineFullIntegrationTests.PublishedOverloadKeysDriveResolvedNamesForPackageDeclarations.
public unsafe fn bool PublishedOverloadKeysDriveResolvedNamesForPackageDeclarationsImpl()
{
    // PORT-NOTE: original hand-builds a Facade SyntaxModel with two WriteLine overloads (ascii vs
    // unicode text) and asserts FunctionOverloadFacts.GetResolvedLocalName returns
    // "WriteLine#(rawptr<i8[minmax]>,ascii)" and "WriteLine#(rawptr<i8[minmax]>,unicode)". The compile
    // helpers cannot construct SyntaxModels or inspect resolved local names, so this reduces to
    // compiling an equivalent Facade module that declares the two WriteLine overloads and asserting it
    // type-checks successfully (the precondition for resolving distinct overload-keyed names).
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "published-overload-keys-resolved-names",
        raw"""
module Facade

public fn void WriteLine(rawptr<i8[min max]> handle, ascii text);

public fn void WriteLine(rawptr<i8[min max]> handle, unicode text);
""");
    return Succeeds(compiled);
}
