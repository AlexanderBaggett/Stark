import CompilerTestSupport
import System.Testing
module CompilerPipelineFunctionEffectsTests_PKGIMGP1

// Ported from CompilerPipelineFunctionEffectsTests.ManifestBackedModulesPreserveImportedFunctionEffectsFromCompilerFactSections.
public unsafe fn bool ManifestBackedModulesPreserveImportedFunctionEffectsFromCompilerFactSectionsImpl()
{
    // PORT-NOTE: The C# test builds a package image from the Facade library, strips its
    // untyped sections down to the typed interface + compiler facts, writes the manifest
    // JSON, deletes the source, then re-imports Facade into a consumer (StopAfterPassId
    // "function-effects") and inspects the FunctionEffectModel: Facade.Precise is
    // strictfp/hot/not-cold/pure/NoInline/fast-call and Facade.Sink is ffi/cold/no-unwind/
    // not-fast-call. Package-image construction, manifest round-tripping, filesystem
    // effects, module re-import, and function-effect-fact inspection are not expressible
    // with the Stark helpers, so this is reduced to compiling the published Facade library
    // program (the source of those effect facts) through the type-check stage and asserting
    // it succeeds (the precondition for any published function-effect fact).
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "function-effects-manifest-facts-library",
        raw"""
module Facade

public strictfp hot noinline finite law f32 Precise(f32 value);
export cold unsafe ffi fn void Sink(rawptr<i8[min max]> value);
""");
    return Succeeds(compiled);
}
