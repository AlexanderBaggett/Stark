import CompilerTestSupport
import System.Testing

module CompilerPipelineLowerMirTests_PKGIMGP3

// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesUsePublishedEnumWholeCaptureSwitchPatternFactsWithoutBridgeBodyText.
public unsafe fn bool ManifestBackedGenericBodiesUsePublishedEnumWholeCaptureSwitchPatternFactsWithoutBridgeBodyTextImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, strips the
    // untyped sections (leaving the typed interface, compiler facts, and generic templates),
    // confirms the ReadEnumWhole template has no BodyText but a TypedBody, writes the manifest
    // JSON, deletes the source, then re-imports Facade into a Demo consumer compiled through
    // "lower-mir" and inspects the specialized __stark_mono_fn_Demo__Facade_ReadEnumWhole__i32
    // function (SupportsDirectCodeGeneration, a "capture"/"match" local, and a switch_agg_match
    // block writing "capture"). Package-image construction, manifest JSON round-tripping,
    // filesystem effects, the module resolver, and per-function MIR structural inspection are
    // not expressible with the Stark helpers, so this is reduced to compiling the published
    // Facade library program (the source of the published enum-whole-capture switch facts)
    // through the MIR-lowering stage and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileMir(
        "lower-mir-manifest-enum-whole-capture-switch-facts-library",
        raw"""
module Facade

public enum Wrapped<T>
{
    None,
    Pair(i32[min max], i32[min max]),
}

public fn i32[min max] ReadEnumWhole<T>(Wrapped<T> wrapped, T tag)
{
    switch (wrapped)
    {
        case Wrapped<T>.Pair capture:
            return 5;
        default:
            return -2;
    }
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesUsePublishedLiteralAndGuardedSwitchFactsWhenBridgeSourceIsCorrupted.
public unsafe fn bool ManifestBackedGenericBodiesUsePublishedLiteralAndGuardedSwitchFactsWhenBridgeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library, then corrupts the ClassifySwitch
    // generic template's BodyText (replacing the literal/guarded switch with a divergent one),
    // strips the untyped sections, writes the manifest JSON, deletes the source, and re-imports
    // Facade into a Demo consumer compiled through "lower-mir". It then asserts the typed facts
    // (not the corrupted bridge text) drive specialization: a "current"/"match" local plus at
    // least two Equal and one GreaterThan binary rvalues in the specialized
    // __stark_mono_fn_Demo__Facade_ClassifySwitch__i32 MIR. Package-image construction, template
    // corruption, manifest round-tripping, filesystem effects, and per-rvalue MIR inspection are
    // not expressible with the Stark helpers, so this is reduced to compiling the published
    // Facade library program (the source of the published literal/guarded switch facts) through
    // the MIR-lowering stage and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileMir(
        "lower-mir-manifest-literal-guard-switch-facts-library",
        raw"""
module Facade

public fn i32[min max] ClassifySwitch<T>(i32[min max] value, T tag)
{
    switch (value)
    {
        case 0:
        case 1:
            return 10;
        case var current when current > 5:
            return current;
        default:
            return -1;
    }
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesFoldComptimeStructuralFactsInMir.
public unsafe fn bool ManifestBackedGenericBodiesFoldComptimeStructuralFactsInMirImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library, corrupts the Width generic template's
    // BodyText to "{ return 99; }" (confirming the TypedBody survives), strips the untyped
    // sections, writes the manifest JSON, deletes the source, then re-imports Facade into a Demo
    // consumer compiled through "lower-mir". It asserts the published comptime structural facts
    // win: the specialized __stark_mono_fn_Demo__Facade_Width__i32 has no direct calls and folds
    // System.Compiler.TypeIntegerBitWidth<i32> to the constant 32 in its return. Package-image
    // construction, template corruption, manifest round-tripping, filesystem effects, and
    // constant-fold MIR inspection are not expressible with the Stark helpers, so this is reduced
    // to compiling the published Facade library program (the source of the comptime structural
    // facts) through the MIR-lowering stage and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileMir(
        "lower-mir-manifest-comptime-structural-facts-library",
        raw"""
module Facade

public fn u64[0 max] Width<T>(T value)
{
    return comptime System.Compiler.TypeIntegerBitWidth<T>();
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesUsePublishedObjectInitializerMembersWhenBridgeSourceIsCorrupted.
public unsafe fn bool ManifestBackedGenericBodiesUsePublishedObjectInitializerMembersWhenBridgeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library, corrupts the MakePair generic
    // template's BodyText (object initializer with Missing/Wrong members), strips the untyped
    // sections, writes the manifest JSON, deletes the source, then re-imports Facade into a Demo
    // consumer compiled through "lower-mir". It asserts the published object-initializer member
    // facts win: the specialized __stark_mono_fn_Demo__Facade_MakePair__i32 emits InsertField
    // rvalues for {Value, index 0} and {Count, index 1}. Package-image construction, template
    // corruption, manifest round-tripping, filesystem effects, and per-rvalue MIR inspection are
    // not expressible with the Stark helpers, so this is reduced to compiling the published
    // Facade library program (the source of the object-initializer member facts) through the
    // MIR-lowering stage and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileMir(
        "lower-mir-manifest-object-initializer-facts-library",
        raw"""
module Facade

public struct Pair<T>
{
    T Value;
    i32[min max] Count;
}

public fn Pair<T> MakePair<T>(T value)
{
    return new Pair<T>()
    {
        Value = value, Count = 1
    };
}
""");
    return Succeeds(compiled);
}

