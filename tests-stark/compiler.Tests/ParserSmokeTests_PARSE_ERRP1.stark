import CompilerTestSupport
import System.Testing

module ParserSmokeTests_PARSE_ERRP1

// Ported from ParserSmokeTests.InvalidProgramsDoNotParse.
public unsafe fn bool InvalidProgramsDoNotParseImpl()
{
    unsafe
    {
        // PORT-NOTE: original is a [Theory] over InvalidPrograms member data that calls
        // StarkSyntax.ParseCompilationUnit on each row and asserts result.Succeeded is false
        // and result.SyntaxErrorCount > 0. The compile helpers expose no standalone
        // ParseCompilationUnit / SyntaxErrorCount surface, so each row is run through the full
        // pipeline (which begins with parsing) and the parse-error signal reduces to
        // "the embedded program fails to compile" (!Succeeds). The Impl inlines every row and
        // returns true only when all of them fail.

        // Row: imports must come before module declaration
        stack mut LlvmCompile importsAfterModule = CompileFull(
            "invalid-imports-after-module",
            raw"""
module Demo
import Core
""");

        // Row: finite law keyword order is fixed
        stack mut LlvmCompile lawKeywordOrder = CompileFull(
            "invalid-law-keyword-order",
            raw"""
module Demo

law finite i32[min max] Add(i32[min max] left, i32[min max] right);
""");

        // Row: while loops require an explicit loop behavior
        stack mut LlvmCompile whileWithoutBehavior = CompileFull(
            "invalid-while-without-behavior",
            raw"""
module Demo

fn void Run()
{
    while (true)
    {
    }
}
""");

        // Row: compilation units require a module declaration
        stack mut LlvmCompile missingModule = CompileFull(
            "invalid-missing-module",
            raw"""
public fn void Run();
""");

        // Row: local variables require an explicit storage class
        stack mut LlvmCompile localWithoutStorageClass = CompileFull(
            "invalid-local-without-storage-class",
            raw"""
module Demo

fn void Run()
{
    i32[min max] value = 0;
}
""");

        // Row: doctorine spelling is no longer accepted
        stack mut LlvmCompile doctorineSpelling = CompileFull(
            "invalid-doctorine-spelling",
            raw"""
module Demo

public doctorine Numbers<T>
{
    law T Clamp(T value);
}
""");

        // Row: constructor base initializer is not part of Stark
        stack mut LlvmCompile baseInitializer = CompileFull(
            "invalid-base-initializer",
            raw"""
module Demo

struct Widget
{
    i32[min max] Value;
    Widget(i32[min max] value) : base(value)
    {
        return;
    }
}
""");

        // Row: prefix fixed array syntax is no longer accepted
        stack mut LlvmCompile prefixFixedArray = CompileFull(
            "invalid-prefix-fixed-array",
            raw"""
module Demo

fn void Run()
{
    stack [i32[min max]; 3] values =
    {
        1, 2, 3
    };
}
""");

        // Every invalid program must fail to parse (and therefore fail to compile);
        // the Impl is true only when all eight rows fail.
        return !Succeeds(importsAfterModule)
            && !Succeeds(lawKeywordOrder)
            && !Succeeds(whileWithoutBehavior)
            && !Succeeds(missingModule)
            && !Succeeds(localWithoutStorageClass)
            && !Succeeds(doctorineSpelling)
            && !Succeeds(baseInitializer)
            && !Succeeds(prefixFixedArray);
    }
}
