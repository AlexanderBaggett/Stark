}

// Ported from FunctionSemanticsTests.TransitiveCallEffectsFlowIntoSemanticSummaries.
internal fn bool TransitiveCallEffectsFlowIntoSemanticSummariesImpl()
{
    {
        // PORT-NOTE: reduced. C# asserts Outer.MemoryEffects.WritesArgumentMemory,
        // its single `box` parameter Writes==true, and the single recorded call to
        // "Touch" with its single argument mapping box->box and Writes==true
        // (transitive call effect). Helpers cannot read memory effects or the call
        // table, so reduced to Succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-fnsem-transitive-call-effects",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn void Touch(borrow mut Box box)
{
    box.Value = 1;
    return;
}

unsafe fn void Outer(borrow mut Box box)
{
    Touch(box);
    return;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from FunctionSemanticsTests.SemanticValidationSummariesDistinguishArgumentAndOtherMemory.
internal fn bool SemanticValidationSummariesDistinguishArgumentAndOtherMemoryImpl()
{
    {
        // PORT-NOTE: reduced. C# asserts ReadGlobal.MemoryEffects ReadsOtherMemory==
        // true, WritesOtherMemory==false, ReadsArgumentMemory==false; and TouchArg
        // .MemoryEffects WritesArgumentMemory==true, ReadsOtherMemory==false,
        // WritesOtherMemory==false (argument vs other-memory distinction). Helpers
        // cannot read memory-effect flags, so reduced to Succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-fnsem-distinguish-arg-other-memory",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

static mut i32[min max] Counter = 0;

unsafe fn i32[min max] ReadGlobal()
{
    return Counter;
}

unsafe fn void TouchArg(borrow mut Box box)
{
    box.Value = 1;
    return;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from FunctionSemanticsTests.SystemMemoryAllocatorDeclarationSummariesIncludeAllocatorState.
internal fn bool SystemMemoryAllocatorDeclarationSummariesIncludeAllocatorStateImpl()
{
    {
        // PORT-NOTE: reduced. C# asserts that the extern declarations Allocate,
        // Reallocate and Free each have MemoryEffects with ReadsOtherMemory==true and
        // WritesOtherMemory==true (allocator state). Helpers cannot read memory
        // effects, so reduced to Succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-fnsem-allocator-state",
            raw"""
module System.Memory

public struct Allocator
{
    u8[0 127] Kind;
}

internal struct Allocation
{
    rawmutptr<i8[min max]> Pointer;
    u64[0 2 ** 63 - 1] ByteLength;
    u64[1 2 ** 63 - 1] Alignment;
    Allocator Allocator;
}

internal unsafe fn Allocation Allocate(Allocator allocator, u64[0 2 ** 63 - 1] byteLength, u64[1 2 ** 63 - 1] alignment);
internal unsafe fn Allocation Reallocate(Allocation allocation, u64[0 2 ** 63 - 1] byteLength, u64[1 2 ** 63 - 1] alignment);
internal unsafe fn void Free(Allocation allocation);
""");
        return Succeeds(compiled);
    }
}

// Ported from FunctionSemanticsTests.DynamicStorageOperationsOnBorrowedParametersWriteArgumentMemory.
internal fn bool DynamicStorageOperationsOnBorrowedParametersWriteArgumentMemoryImpl()
{
    {
        // PORT-NOTE: reduced. C# asserts that Reserve and Append each have
        // MemoryEffects with ReadsArgumentMemory==true and WritesArgumentMemory==
        // true, and that each single `values` parameter has Reads==true and
        // Writes==true (dynamic storage ops on a borrowed parameter write argument
        // memory). Helpers cannot read memory effects or parameter facts, so reduced
        // to Succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-fnsem-dynamic-storage-writes-arg",
            raw"""
module Demo

unsafe fn bool Reserve(mut borrow dynamic u32[0 2 ** 31 - 1] values)
{
    return values.TryReserve(8);
}

unsafe fn bool Append(mut borrow dynamic u32[0 2 ** 31 - 1] values)
{
    if (!values.TryReserve(1))
    {
        return false;
    }

    init values[values.Length] = 1;
    return true;
}
""");
        return Succeeds(compiled);
    }
}

// Ported slice of tests/compiler.Tests/FunctionSemanticsTests.cs.
// The Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
