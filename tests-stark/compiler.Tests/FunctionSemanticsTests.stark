internal fn bool ConstParameterQualifierFlowsIntoSemanticReadonlyFactsImpl()
{
    {
        // PORT-NOTE: reduced. C# asserts the single `ptr` parameter has
        // GuaranteedReadOnly==true (from the `const` qualifier). Helpers cannot read
