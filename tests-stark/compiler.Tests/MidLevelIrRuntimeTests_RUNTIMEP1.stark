import CompilerTestSupport
import System.Testing
module MidLevelIrRuntimeTests_RUNTIMEP1

// Ported slice of tests/compiler.IntegrationTests/MidLevelIrRuntimeTests.cs.
// Every original test calls CompileAndRunExitCodeAsync: it writes the embedded
// program to App.stark, runs the CLI with --emit-exe, asserts the CLI exit is 0
// with "Emitted executable:" stdout and empty stderr, then launches the linked
// executable and asserts a specific process exit code (with empty stdout/stderr).
// The Stark compile helpers cannot link, run, or observe a runtime exit code, so
// each Impl reduces to driving the embedded program through the full pipeline and
// returning Succeeds. The embedded programs are copied verbatim from the C# raw
// strings. See per-method `// PORT-NOTE:` comments for the exact reductions.

// Ported from MidLevelIrRuntimeTests.NonAsciiTextLiteralsPreferAsciiOverloadsAtRuntime.
public unsafe fn bool NonAsciiTextLiteralsPreferAsciiOverloadsAtRuntimeImpl()
{
    // PORT-NOTE: original asserts the linked program exits with code 1 (the ascii
    // overload is picked). Reduced to a full-pipeline compile returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-nonascii-prefers-ascii-overload",
        raw"""
module Demo

fn i32[min max] Pick(ascii text)
{
    return 1;
}

fn i32[min max] Pick(unicode text)
{
    return 2;
}

export fn i32[min max] main()
{
    return Pick("café");
}
""");
    return Succeeds(compiled);
}

