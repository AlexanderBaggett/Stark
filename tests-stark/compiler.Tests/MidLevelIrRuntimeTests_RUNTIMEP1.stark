}

// Ported from MidLevelIrRuntimeTests.FixedCapacityTextConcatenationCopiesIntoStackStorageAtRuntime.
public unsafe fn bool FixedCapacityTextConcatenationCopiesIntoStackStorageAtRuntimeImpl()
{
    // PORT-NOTE: original asserts the linked program exits with code 0 (concat
    // copies into fixed stack storage for both ascii and unicode). Reduced to a
    // full-pipeline compile returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-fixed-capacity-concat-stack",
        raw"""
module System.Text

public finite law ascii AsciiView(Ascii source);
public finite law i64[min max] AsciiLength(ascii source);
public finite law unicode UnicodeView(Unicode source);
public finite law i64[min max] UnicodeLength(unicode source);
public unsafe fn bool TryConcatAscii(rawmutptr<Ascii> destination, ascii left, ascii right);
public unsafe fn bool TryConcatUnicode(rawmutptr<Unicode> destination, unicode left, unicode right);

export unsafe fn i32[min max] main()
{
    stack mut i8[min max][2] leftStorage =
    {
        65, 0
    };
    stack mut Ascii left = new Ascii()
    {
        Data = &leftStorage[0],
        Length = 1,
        Capacity = 2
    };
    stack mut i8[min max][2] rightStorage =
    {
        66, 0
    };
    stack mut Ascii right = new Ascii()
    {
        Data = &rightStorage[0],
        Length = 1,
        Capacity = 2
    };
    stack Ascii combined[4] = left + right;

    stack mut i32[min max][2] wideLeftStorage =
    {
        65, 0
    };
    stack mut Unicode wideLeft = new Unicode()
    {
        Data = &wideLeftStorage[0],
        Length = 1,
        Capacity = 2
    };
    stack mut i32[min max][2] wideRightStorage =
    {
        66, 0
    };
    stack mut Unicode wideRight = new Unicode()
    {
        Data = &wideRightStorage[0],
        Length = 1,
        Capacity = 2
    };
    stack Unicode wideCombined[4] = wideLeft + wideRight;

    if (AsciiLength(AsciiView(combined)) == 2 && UnicodeLength(UnicodeView(wideCombined)) == 2)
    {
        return 0;
    }

    return 1;
}
""");
    return Succeeds(compiled);
}

// Ported from MidLevelIrRuntimeTests.TextConcatenationRejectsNegativeDestinationCapacityAtRuntime.
public unsafe fn bool TextConcatenationRejectsNegativeDestinationCapacityAtRuntimeImpl()
{
    // PORT-NOTE: original asserts the linked program exits with code 0 (both
    // negative-capacity concats are rejected at runtime). Reduced to a
    // full-pipeline compile returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-concat-rejects-negative-capacity",
        raw"""
module System.Text

public unsafe fn bool TryConcatAscii(rawmutptr<Ascii> destination, ascii left, ascii right);
public unsafe fn bool TryConcatUnicode(rawmutptr<Unicode> destination, unicode left, unicode right);

unsafe fn bool RejectsAsciiNegativeCapacity()
{
    stack mut i8[min max][4] storage =
    {
        0, 0, 0, 0
    };
    stack mut Ascii destination = new Ascii()
    {
        Data = &storage[0],
        Length = 0,
        Capacity = -1
    };

    return !TryConcatAscii(&destination, "A", "B");
}

unsafe fn bool RejectsUnicodeNegativeCapacity()
{
    stack mut i32[min max][4] storage =
    {
        0, 0, 0, 0
    };
    stack mut Unicode destination = new Unicode()
    {
        Data = &storage[0],
        Length = 0,
        Capacity = -1
    };

    return !TryConcatUnicode(&destination, (unicode)"A", (unicode)"B");
}

export unsafe fn i32[min max] main()
{
    if (RejectsAsciiNegativeCapacity() && RejectsUnicodeNegativeCapacity())
    {
        return 0;
    }

    return 1;
}
""");
    return Succeeds(compiled);
}

// Ported from MidLevelIrRuntimeTests.FixedCapacityInterpolatedTextFormatsIntoStackStorageAtRuntime.
public unsafe fn bool FixedCapacityInterpolatedTextFormatsIntoStackStorageAtRuntimeImpl()
{
    // PORT-NOTE: original asserts the linked program exits with code 0
    // (interpolated ascii text formats into fixed stack storage, length 9).
    // Reduced to a full-pipeline compile returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-fixed-capacity-interpolated-ascii",
        raw"""
module System.Text

public finite law ascii AsciiView(Ascii source);
public finite law i64[min max] AsciiLength(ascii source);
public unsafe fn bool TryConcatAscii(rawmutptr<Ascii> destination, ascii left, ascii right);

public unsafe fn bool TryFormatI32Ascii(rawmutptr<Ascii> destination, i32[min max] value)
{
    if (value == 42)
    {
        return TryConcatAscii(destination, "", "42");
    }

    return false;
}

export unsafe fn i32[min max] main()
{
    stack i32[min max] score = 42;
    stack Ascii label[32] = $"Score: {score}";
    if (AsciiLength(AsciiView(label)) == 9)
    {
        return 0;
    }

    return 1;
}
""");
    return Succeeds(compiled);
}

