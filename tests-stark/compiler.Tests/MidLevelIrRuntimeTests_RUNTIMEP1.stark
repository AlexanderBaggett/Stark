// Ported from MidLevelIrRuntimeTests.SwitchPatternCaptureDropsMovedEnumPayloadAtRuntime.
public unsafe fn bool SwitchPatternCaptureDropsMovedEnumPayloadAtRuntimeImpl()
{
    // PORT-NOTE: original gates on a detectable native toolchain, then asserts the
    // linked program exits with code 3 (the captured enum payload is moved out and
    // dropped after the switch block). Reduced to a full-pipeline compile
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-switch-capture-drops-moved-payload",
        raw"""
module Demo

static mut i32[min max] Counter = 0;

fn void Bump(i32[min max] value)
{
    Counter = Counter + value;
    return;
}

struct Resource
{
    i32[min max] Value;

    drop
    {
        Bump(self.Value);
    }
}

enum Result<T>
{
    Missing,
    Removed(T),
}

fn Result<Resource> Make()
{
    return Result<Resource>.Removed(new Resource()
    {
        Value = 3
    });
}

export fn i32[min max] main()
{
    {
        stack Result<Resource> result = Make();
        switch (result)
        {
            case Result<Resource>.Missing:
                return 1;
            case Result<Resource>.Removed(var removed):
                if (Counter != 0 || removed.Value != 3)
                {
                    return 2;
                }
        }
    }

    return Counter;
}
""");
    return Succeeds(compiled);
}

// Ported from MidLevelIrRuntimeTests.MutableBorrowReceiverCallsObserveSharedStateAtRuntime.
public unsafe fn bool MutableBorrowReceiverCallsObserveSharedStateAtRuntimeImpl()
{
    // PORT-NOTE: original gates on a detectable native toolchain, then asserts the
    // linked program exits with code 7 (mutable borrow receiver calls observe and
    // mutate shared state). Reduced to a full-pipeline compile returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-mutable-borrow-receiver-shared-state",
        raw"""
module Demo

struct Counter
{
    i32[min max] Value;

    fn void Reset(borrow mut Counter self)
    {
        self.Value = 0;
        return;
    }

    fn void ResetThenAdd(borrow mut Counter self, i32[min max] value)
    {
        self.Reset();
        self.Value += value;
        return;
    }

    fn i32[min max] Current(borrow Counter self)
    {
        return self.Value;
    }
}

export fn i32[min max] main()
{
    stack mut Counter counter = new Counter()
    {
        Value = 9
    };
    counter.ResetThenAdd(7);
    return counter.Current();
}
""");
    return Succeeds(compiled);
}

// Ported from MidLevelIrRuntimeTests.NestedMutableBorrowReceiverCallsMutateStoredFieldAtRuntime.
public unsafe fn bool NestedMutableBorrowReceiverCallsMutateStoredFieldAtRuntimeImpl()
{
    // PORT-NOTE: original gates on a detectable native toolchain, then asserts the
    // linked program exits with code 2 (nested mutable borrow receiver calls
    // mutate a stored field across two bumps). Reduced to a full-pipeline compile
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-nested-mutable-borrow-receiver-field",
        raw"""
module Demo

struct Counter
{
    u32[0 max] Value;

    fn void Increment(mut borrow Counter self)
    {
        self.Value += 1;
    }
}

struct Holder
{
    Counter Inner;

    fn void Bump(mut borrow Holder self)
    {
        self.Inner.Increment();
    }

    finite law u32[0 max] Get(borrow Holder self)
    {
        return self.Inner.Value;
    }
}

export fn i32[min max] main()
{
    stack mut Holder holder = new Holder()
    {
        Inner = new Counter()
        {
            Value = 0
        }
    };

    holder.Bump();
    holder.Bump();
    return (i32[min max])holder.Get();
}
""");
    return Succeeds(compiled);
}

// Ported from MidLevelIrRuntimeTests.StoreBorrowFieldsMutateOriginalOwnerAtRuntime.
public unsafe fn bool StoreBorrowFieldsMutateOriginalOwnerAtRuntimeImpl()
{
    // PORT-NOTE: original gates on a detectable native toolchain, then asserts the
    // linked program exits with code 0 (a storeborrow field mutates the original
    // owner: 41 + 1 == 42). Reduced to a full-pipeline compile returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-storeborrow-fields-mutate-owner",
        raw"""
module Demo

struct Counter
{
    i32[min max] Value;

    fn Holder Hold(storeborrow mut Counter self)
    {
        return new Holder(self);
    }
}

struct Holder
{
    storeborrow mut Counter Owner;

    Holder(storeborrow mut Counter owner)
    {
        self.Owner = owner;
    }

    fn void Bump(mut borrow Holder self)
    {
        self.Owner.Value += 1;
    }
}

export fn i32[min max] main()
{
    stack mut Counter counter = new Counter()
    {
        Value = 41
    };
    stack mut Holder holder = counter.Hold();
    holder.Bump();
    return counter.Value == 42 ? 0 : 1;
}
""");
    return Succeeds(compiled);
}

