// Ported from MidLevelIrRuntimeTests.SwitchExpressionCallOnEnumIsEvaluatedOnceAtRuntime.
public unsafe fn bool SwitchExpressionCallOnEnumIsEvaluatedOnceAtRuntimeImpl()
{
    // PORT-NOTE: original gates on a detectable native toolchain, then asserts the
    // linked program exits with code 1 (the enum-producing call in the switch
    // scrutinee is evaluated exactly once). Reduced to a full-pipeline compile
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-switch-call-on-enum-evaluated-once",
        raw"""
module Demo

