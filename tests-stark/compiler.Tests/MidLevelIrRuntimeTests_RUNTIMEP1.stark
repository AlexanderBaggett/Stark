// Ported from MidLevelIrRuntimeTests.RecordEqualityAndInequalityCompareScalarFieldsAtRuntime.
public unsafe fn bool RecordEqualityAndInequalityCompareScalarFieldsAtRuntimeImpl()
{
    // PORT-NOTE: original gates on a detectable native toolchain, then asserts the
    // linked program exits with code 7 (record ==/!= compare scalar fields).
    // Reduced to a full-pipeline compile returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-record-equality-scalar-fields",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn bool Same(Pair left, Pair right)
{
    return left == right;
}

fn bool Different(Pair left, Pair right)
{
    return left != right;
}

export unsafe fn i32[min max] main()
{
    stack Pair sameLeft = new Pair(1, 2);
    stack Pair sameRight = new Pair(1, 2);
    stack Pair differentLeft = new Pair(1, 2);
    stack Pair differentRight = new Pair(2, 1);

    if (Same(sameLeft, sameRight) && Different(differentLeft, differentRight))
    {
        return 7;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from MidLevelIrRuntimeTests.RecordOrderedComparisonsAreLexicographicAtRuntime.
public unsafe fn bool RecordOrderedComparisonsAreLexicographicAtRuntimeImpl()
{
    // PORT-NOTE: original gates on a detectable native toolchain, then asserts the
    // linked program exits with code 7 (record </<=/>/>= are lexicographic over
    // fields). Reduced to a full-pipeline compile returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "mir-record-ordered-lexicographic",
        raw"""
module Demo

record Many(i32[min max] A, i32[min max] B, i32[min max] C, i32[min max] D, i32[min max] E)
{
}

fn bool Less(Many left, Many right)
{
    return left < right;
}

fn bool LessOrEqual(Many left, Many right)
{
    return left <= right;
}

fn bool Greater(Many left, Many right)
{
    return left > right;
}

fn bool GreaterOrEqual(Many left, Many right)
{
    return left >= right;
}

export unsafe fn i32[min max] main()
{
    stack Many lessLeft = new Many(1, 2, 3, 4, 5);
    stack Many lessRight = new Many(1, 2, 3, 4, 6);
    stack Many lessOrEqualLeft = new Many(1, 2, 3, 4, 5);
    stack Many lessOrEqualRight = new Many(1, 2, 3, 4, 5);
    stack Many greaterLeft = new Many(1, 2, 3, 4, 6);
    stack Many greaterRight = new Many(1, 2, 3, 4, 5);
    stack Many greaterOrEqualLeft = new Many(1, 2, 3, 4, 5);
    stack Many greaterOrEqualRight = new Many(1, 2, 3, 4, 5);
    stack Many topLeft = new Many(2, 0, 0, 0, 0);
    stack Many topRight = new Many(1, 9, 9, 9, 9);

    if (Less(lessLeft, lessRight)
        && LessOrEqual(lessOrEqualLeft, lessOrEqualRight)
        && Greater(greaterLeft, greaterRight)
        && GreaterOrEqual(greaterOrEqualLeft, greaterOrEqualRight)
        && GreaterOrEqual(topLeft, topRight))
        {
            return 7;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}

