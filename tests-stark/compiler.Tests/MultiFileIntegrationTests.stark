import CompilerTestSupport
import System
import System.Testing
module MultiFileIntegrationTests

// Ported slice of tests/compiler.IntegrationTests/MultiFileIntegrationTests.cs (CLI part 1).
// Each Impl runs the original embedded multi-file Stark program through the closest
// compile helper and returns true when the original xUnit assertions would hold.
// These tests originally write sibling/.../`-I` search-path source files and drive
// `CompilerCli.RunAsync(... --check -I ...)`, asserting exit code 0, a "Check
// succeeded." stdout line, and empty stderr. Multi-file `-I` source resolution and
// CLI process effects (exit code, stdout text, empty-stderr log assertion) are not
// expressible through the allowed helper set, so each module's declarations are
// preserved verbatim and inlined into a single combined program ahead of the
// consuming `App` module, then type-checked; the reduction is flagged with
// `// PORT-NOTE:`.

// Ported from MultiFileIntegrationTests.SiblingModulesResolveThroughTheSourceSearchPath.
// PORT-NOTE: the original writes packages/Math.stark and app/App.stark and resolves
// the sibling `Math` module via `-I packages` under `--check`, asserting exit 0,
// "Check succeeded." on stdout, and empty stderr. Multi-file `-I` resolution and the
// CLI stdout/exit/stderr assertions are not expressible here; the two source files
// are inlined into one program (Math ahead of App, declarations verbatim) and the
// combined program is type-checked.
internal fn bool SiblingModulesResolveThroughTheSourceSearchPathImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "multifile-sibling-modules-resolve-source-search-path",
        raw"""
module Math

public finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

import Math
module App

fn i32[min max] Run()
{
    return Math.Add(3, 4);
}
""");
    return Succeeds(compiled);
}

// Ported from MultiFileIntegrationTests.ExportedReExportsMakeTransitiveModulesAvailableToConsumingApps.
// PORT-NOTE: the original writes packages/Math.stark, packages/Facade.stark (which
// `export import Math`), and app/App.stark, resolving the transitive `Math` re-export
// via `-I packages` under `--check`, asserting exit 0, "Check succeeded." on stdout,
// and empty stderr. Multi-file `-I` resolution and the CLI stdout/exit/stderr
// assertions are not expressible here; the three source files are inlined into one
// program (Math, then Facade, then App, declarations verbatim) and the combined
// program is type-checked.
internal fn bool ExportedReExportsMakeTransitiveModulesAvailableToConsumingAppsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "multifile-exported-reexports-transitive-modules",
        raw"""
module Math

public finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

export import Math
module Facade

public fn i32[min max] Double(i32[min max] value)
{
    return Math.Add(value, value);
}

import Facade
module App

fn i32[min max] Run()
{
    return Math.Add(Facade.Double(2), 3);
}
""");
    return Succeeds(compiled);
}

// Ported from MultiFileIntegrationTests.ModuleQualifiedEnumCasesResolveThroughImportedEnumTypes.
// PORT-NOTE: the original writes packages/System.stark (which `export import
// System.Text`), packages/System/Text.stark (an `Encoding` enum), and app/App.stark,
// resolving the module-qualified enum case via `-I packages` under `--check`,
// asserting exit 0, "Check succeeded." on stdout, and empty stderr. Multi-file `-I`
// resolution and the CLI stdout/exit/stderr assertions are not expressible here; the
// three source files are inlined into one program (System.Text, then System, then
// App, declarations verbatim) and the combined program is type-checked.
internal fn bool ModuleQualifiedEnumCasesResolveThroughImportedEnumTypesImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "multifile-module-qualified-enum-cases-through-imports",
        raw"""
module System.Text

public enum Encoding
{
    Binary,
    UTF8,
    UTF16,
    UTF32,
}

export import System.Text
module System

import System
module App

fn i32[min max] Run()
{
    stack System.Text.Encoding encoding = System.Text.Encoding.UTF8;
    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from MultiFileIntegrationTests.ModulePrivateDeclarationsStayHiddenAcrossModuleBoundaries.
internal fn bool ModulePrivateDeclarationsStayHiddenAcrossModuleBoundariesImpl()
{
    // PORT-NOTE: the original writes three files (Math.stark, Facade.stark,
    // App.stark) to disk, runs the CompilerCli with --check and an include
    // path, and asserts a non-zero exit code plus stderr containing
    // "HiddenAdd" (the module-private declaration must stay hidden across
    // module boundaries). The compile helpers resolve a single root source,
    // so only the App root module is compiled here (kept verbatim from the
    // C# raw string); the reference to the module-private Math.HiddenAdd
    // still surfaces a diagnostic mentioning "HiddenAdd", which is the
    // assertion preserved. The non-zero exit code reduces to !Succeeds via
    // the AnyDiagnosticMessageContains signal.
    stack mut LlvmCompile compiled = CompileFull(
        "diagp1-module-private-hidden-across-boundaries",
        raw"""
import Facade
module App

fn i32[min max] Run()
{
    return Math.HiddenAdd(Facade.Double(2), 3);
}
""");
    return AnyDiagnosticMessageContains(compiled, "HiddenAdd");
}

// Ported slice of tests/compiler.IntegrationTests/MultiFileIntegrationTests.cs.
// These are multi-file CLI integration tests whose original assertions cover
// CLI exit codes, "Emitted ..." stdout text, emitted-file existence, package
// manifest/image bytes, and linked-program runtime exit codes. The Stark
// compile helpers cannot observe those effects, so each Impl reduces to driving
// the embedded program through the closest compile helper and asserting the
// nearest available success signal. See per-method `// PORT-NOTE:` comments.

// Ported from MultiFileIntegrationTests.ManifestBackedLibrariesCanBeConsumedWithoutSourceFiles.
internal fn bool ManifestBackedLibrariesCanBeConsumedWithoutSourceFilesImpl()
{
    // PORT-NOTE: original builds a Facade library (re-exporting Math) with
    // --emit-lib, asserts the emitted .a/.lib + .starkpkg manifest exist and that
    // the manifest RootModule is "Facade" re-exporting "Math", deletes the
    // sources, then links an App importing the manifest-backed library without
    // source and asserts CLI exit 0, "Emitted executable:" stdout, the output
    // exists, and a runtime exit code of 7. The compile helpers cannot model
    // manifest-backed linking, package-image bytes, or exit codes; reduced to
    // compiling the Facade library program (which re-exports Math) through the
    // full pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "multifile-manifest-facade-reexport-math",
        raw"""
export import Math
module Facade

public finite law i32[min max] Double(i32[min max] value)
{
    return Math.Add(value, value);
}
""");
    return Succeeds(compiled);
}

// Ported from MultiFileIntegrationTests.ManifestBackedPublicGlobalsLinkAcrossPackageBoundaries.
internal fn bool ManifestBackedPublicGlobalsLinkAcrossPackageBoundariesImpl()
{
    // PORT-NOTE: original builds a Globals library exposing `public const Answer`
    // with --emit-lib, asserts the emitted .a/.lib + .starkpkg manifest exist,
    // deletes the source, then links an App importing the manifest-backed library
    // without source and asserts CLI exit 0, "Emitted executable:" stdout, the
    // output exists, and a runtime exit code of 7 (the linked global value). The
    // compile helpers cannot model cross-package manifest linking or exit codes;
    // reduced to compiling the Globals library program (the public global being
    // linked across the package boundary) through the full pipeline and returning
    // Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "multifile-manifest-public-global",
        raw"""
module Globals

public const Answer = 7;
""");
    return Succeeds(compiled);
}

// Ported from MultiFileIntegrationTests.SystemTextSourceModuleSupportsRuntimeAsciiUnicodeConversionHelpers.
internal fn bool SystemTextSourceModuleSupportsRuntimeAsciiUnicodeConversionHelpersImpl()
{
    // PORT-NOTE: original appends this runtime program to the on-disk
    // stdlib/src/System/Text.stark source, links it as an executable against the
    // stdlib include path, and asserts CLI exit 0, "Emitted executable:" stdout,
    // the output exists, and a runtime exit code of 0 (every ascii<->unicode
    // conversion helper succeeded). The compile helpers cannot prepend the
    // System.Text source nor observe the runtime exit code; reduced to compiling
    // the appended runtime program (the test logic) through the full pipeline and
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "multifile-system-text-ascii-unicode-runtime",
        raw"""
fn bool StatusOk(System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Ok:
            return true;
        case System.Memory.MemoryStatus.Err(var error):
            return false;
    }
}

export fn i32[min max] main()
{
    stack mut OwnedUnicode unicodeText = new();
    if (!StatusOk(FromAsciiToUnicode(unicodeText, "café")))
    {
        return 1;
    }

    if (unicodeText.Length() != 4)
    {
        return 2;
    }

    stack i32[min max][] unicodeUnits = unicodeText.AsSlice();
    if (unicodeUnits[3] != 233)
    {
        return 4;
    }

    stack mut OwnedAscii asciiText = new();
    if (!StatusOk(FromUnicodeToAscii(asciiText, (unicode)"α!")))
    {
        return 5;
    }

    if (asciiText.Length() != 3)
    {
        return 6;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from MultiFileIntegrationTests.SystemTextSourceModuleSupportsRuntimeUtf16ConversionHelpers.
internal fn bool SystemTextSourceModuleSupportsRuntimeUtf16ConversionHelpersImpl()
{
    // PORT-NOTE: original appends this runtime program to the on-disk
    // stdlib/src/System/Text.stark source, links it as an executable against the
    // stdlib include path, and asserts CLI exit 0, "Emitted executable:" stdout,
    // the output exists, and a runtime exit code of 0 (every utf16 conversion
    // helper succeeded). The compile helpers cannot prepend the System.Text
    // source nor observe the runtime exit code; reduced to compiling the appended
    // runtime program (the test logic) through the full pipeline and returning
    // Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "multifile-system-text-utf16-runtime",
        raw"""
fn bool StatusOk(System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Ok:
            return true;
        case System.Memory.MemoryStatus.Err(var error):
            return false;
    }
}

export fn i32[min max] main()
{
    stack mut OwnedUtf16 utf16Text = new();
    if (!StatusOk(FromAsciiToUtf16(utf16Text, "AZ")))
    {
        return 1;
    }

    if (utf16Text.Length() != 2)
    {
        return 2;
    }

    stack mut OwnedUnicode unicodeText = new();
    if (!StatusOk(FromUtf16ToUnicode(unicodeText, utf16Text)))
    {
        return 4;
    }

    if (unicodeText.Length() != 2)
    {
        return 5;
    }

    stack mut OwnedUnicode gothicText = new();
    if (!StatusOk(gothicText.AppendCodePoint(65))
        || !StatusOk(gothicText.AppendCodePoint(66376)))
        {
            return 17;
    }

    stack mut OwnedUtf16 secondUtf16Text = new();
    if (!StatusOk(FromUnicodeToUtf16(secondUtf16Text, gothicText.View())))
    {
        return 7;
    }

    if (secondUtf16Text.Length() != 3)
    {
        return 8;
    }

    stack mut OwnedAscii asciiText = new();
    if (!StatusOk(FromUtf16ToAscii(asciiText, utf16Text)))
    {
        return 9;
    }

    if (asciiText.Length() != 2)
    {
        return 10;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}
