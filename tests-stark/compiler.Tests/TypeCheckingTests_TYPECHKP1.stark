// Ported from TypeCheckingTests.LambdasTypeCheckAsExplicitClosureTargets.
public unsafe fn bool LambdasTypeCheckAsExplicitClosureTargetsImpl()
{
    unsafe
    {
        // PORT-NOTE: original probes TypeCheckModel (empty Lambdas, 3
        // ClosureLambdas covering Inline/Borrow/Heap, capture "offset" mode
        // "copy"). Closure-lambda/capture artifact probes are not expressible, so
        // this reduces to result.Succeeded.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-lambdas-closure-targets",
            raw"""
module Demo

fn i32[min max] ApplyBorrow(borrow closure<fn i32[min max](i32[min max])> op)
{
    return 0;
}

fn void ApplyInline(inline closure<fn void(i32[min max])> op)
{
    return;
}

fn heap closure<fn i32[min max](i32[min max])> MakeHeap(i32[min max] offset)
{
    return heap capture(copy offset) (i32[min max] value) => value + offset;
}

fn i32[min max] Run()
{
    stack i32[min max] offset = 1;
    ApplyInline((i32[min max] value) =>
    {
        return;
    });
    return ApplyBorrow(capture(copy offset) (i32[min max] value) => value + offset);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.FunctionItemsPromoteToExplicitClosureTargets.
public unsafe fn bool FunctionItemsPromoteToExplicitClosureTargetsImpl()
{
    unsafe
    {
        // PORT-NOTE: original probes TypeCheckModel (3 ClosureFunctionPromotions
        // all "AddOne" covering Borrow/Inline/Heap closure types). Artifact probes
        // are not expressible, so this reduces to result.Succeeded.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-fnitems-promote-closure-targets",
            raw"""
module Demo

fn i32[min max] AddOne(i32[min max] value)
{
    return value + 1;
}

fn i32[min max] ApplyBorrow(borrow closure<fn i32[min max](i32[min max])> op, i32[min max] value)
{
    return op(value);
}

inline fn i32[min max] ApplyInline(inline closure<fn i32[min max](i32[min max])> op, i32[min max] value)
{
    return op(value);
}

fn heap closure<fn i32[min max](i32[min max])> Make()
{
    return AddOne;
}

fn i32[min max] Run()
{
    stack heap closure<fn i32[min max](i32[min max])> op = Make();
    return ApplyBorrow(AddOne, 20) + ApplyInline(AddOne, 20) + op(0);
}
""");
        return Succeeds(compiled);
    }
}

