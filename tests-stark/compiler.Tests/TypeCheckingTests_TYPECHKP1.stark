// Ported from TypeCheckingTests.SystemCPrimitiveAliasesResolveForTargetDataModel.
public unsafe fn bool SystemCPrimitiveAliasesResolveForTargetDataModelImpl()
{
    unsafe
    {
        // PORT-NOTE: [Theory] over four targets (linux-x86_64, windows-msvc,
        // i686-linux, aarch64-linux) checking per-target c_long/c_size_t/
        // c_ptrdiff_t widths, c_char signedness, and CSourceAliasName facts. The
        // Stark helpers cannot select a TargetInfo nor probe the TypeCheckModel
        // function/parameter types, so all rows collapse to a single
        // default-target type-check of the embedded program (result.Succeeded).
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-systemc-primitive-aliases",
            raw"""
module Demo

unsafe ffi(c) fn System.C.c_int Read(
    System.C.c_long value,
    System.C.c_ulong flags,
    System.C.c_size_t bytes,
    System.C.c_ptrdiff_t delta,
    rawptr<System.C.c_char> text);
""");
        return Succeeds(compiled);
    }
}

