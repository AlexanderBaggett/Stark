// Ported from TypeCheckingTests.ExplicitArithmeticOperatorsTypeCheckWithoutPlaceholderDiagnostics.
public unsafe fn bool ExplicitArithmeticOperatorsTypeCheckWithoutPlaceholderDiagnosticsImpl()
{
    unsafe
    {
        // PORT-NOTE: original asserts result.Succeeded and the absence of any
        // STK3008 placeholder diagnostic; success of the type-check implies the
        // STK3008-free condition, so this reduces to result.Succeeded.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-explicit-arithmetic-operators",
            raw"""
module Demo

finite law i32[min max] Run(i32[min max] left, i32[min max] right)
{
    stack mut i32[min max] value = left;
    value +%= right;
    stack i32[min max] product = left *| right;
    return -%value +% product +| 3;
}
""");
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK3008");
    }
}

// Ported from TypeCheckingTests.StrictFpModifierTypeChecksNowThatLoweringExists.
public unsafe fn bool StrictFpModifierTypeChecksNowThatLoweringExistsImpl()
{
    unsafe
    {
        // PORT-NOTE: original uses the full Compile (no StopAfterPassId) and
        // asserts result.Succeeded and no STK3008; the closest helper compiles the
        // full pipeline and success implies the STK3008-free condition.
        stack mut LlvmCompile compiled = CompileFull(
            "typechkp1-strictfp-modifier",
            raw"""
module Demo

strictfp finite law f32 Run(f32 left, f32 right)
{
    return left + right;
}
""");
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK3008");
    }
}

