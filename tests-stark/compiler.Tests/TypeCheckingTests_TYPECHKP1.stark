// Ported from TypeCheckingTests.DictionaryAllowsExplicitStaticHashEqualsKeyContract.
public unsafe fn bool DictionaryAllowsExplicitStaticHashEqualsKeyContractImpl()
{
    unsafe
    {
        // PORT-NOTE: original wires System.Collections through an
        // InMemoryModuleResolver, asserts result.Succeeded and no STK3023.
        // Translated through CompileTypeCheckWithModule (System subdirectory +
        // Collections.stark); success implies STK3023-free, so this reduces to
        // result.Succeeded.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "typechkp1-dictionary-static-hash-equals",
            raw"""
import System.Collections
module Demo

struct Symbol
{
    u32[0 max] Id;

    static finite law u64[0 max] Hash(borrow Symbol value)
    {
        return (u64[0 max])value.Id;
    }

    static finite law bool Equals(borrow Symbol left, borrow Symbol right)
        where overlap(left, right)
    {
        return left.Id == right.Id;
    }
}

fn void Use(Dictionary<Symbol, i32[0 max]> symbols)
{
    return;
}
""",
            "System",
            "Collections.stark",
            raw"""
module System.Collections

public struct Dictionary<K, V>
{
    K Key;
    V Value;
}
""");
        return Succeeds(compiled);
    }
}

