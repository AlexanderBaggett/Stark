import CompilerTestSupport
import System.Testing

module TypeCheckingTests_TYPECHKP1

// Ported slice of tests/compiler.Tests/TypeCheckingTests.cs.
// Each Impl keeps the embedded Stark program verbatim from the C# raw string and
// runs it through the closest compile helper, returning true when the original
// xUnit assertions would hold. PORT-NOTE comments flag assertions the Stark
// helpers cannot express (TypeCheckModel artifact probes: FunctionPointerPromotions,
// AddressTakenFunctions, IndirectCalls, ClosureLambdas, LambdaCaptures, NamedTypes
// layout facts, Globals types, integer-range endpoints, per-target data models)
// that were reduced to the nearest succeed/diagnostic signal.

// Ported from TypeCheckingTests.IntegerExponentiationTypeChecks.
public unsafe fn bool IntegerExponentiationTypeChecksImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-integer-exponentiation",
            raw"""
module Demo

finite law i32[min max] Run()
{
    return 2 ** 3;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.FunctionItemsPromoteToExplicitFunctionPointersAndIndirectCallsTypeCheck.
public unsafe fn bool FunctionItemsPromoteToExplicitFunctionPointersAndIndirectCallsTypeCheckImpl()
{
    unsafe
    {
        // PORT-NOTE: original also probes TypeCheckModel
        // (FunctionPointerPromotions single "Add" with FunctionPointer target,
        // AddressTakenFunctions single "Add" with kind Fn, IndirectCalls single
        // with FunctionPointer kind). Artifact dictionaries are not expressible,
        // so this reduces to the result.Succeeded signal.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-fnptr-promote-indirect-call",
            raw"""
module Demo

fn i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

fn i32[min max] Run()
{
    stack fnptr<fn i32[min max](i32[min max], i32[min max])> op = Add;
    return op(40, 2);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.ExplicitFfiFunctionPointerAbiPromotesMatchingForeignFunctionItems.
public unsafe fn bool ExplicitFfiFunctionPointerAbiPromotesMatchingForeignFunctionItemsImpl()
