// Ported from TypeCheckingTests.FunctionPointerOverlapContractsAllowAliasingIndirectCalls.
public unsafe fn bool FunctionPointerOverlapContractsAllowAliasingIndirectCallsImpl()
{
    unsafe
    {
        // PORT-NOTE: original probes TypeCheckModel (single promotion "Touch",
        // single IndirectCall whose fnptr overlap group is ["arg0", "arg1"]).
        // Artifact probes are not expressible, so this reduces to result.Succeeded.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-fnptr-overlap-aliasing",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn void Touch(borrow mut Box left, borrow mut Box right) where overlap(left, right)
{
    return;
}

fn void Run(borrow mut Box box)
{
    stack fnptr<fn void(borrow mut Box, borrow mut Box) where overlap(arg0, arg1)> op = Touch;
    op(box, box);
    return;
}
""");
        return Succeeds(compiled);
    }
}

