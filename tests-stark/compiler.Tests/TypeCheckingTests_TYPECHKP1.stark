// Ported from TypeCheckingTests.ImportedModulePublicMembersResolveByFinalName.
public unsafe fn bool ImportedModulePublicMembersResolveByFinalNameImpl()
{
    unsafe
    {
        // PORT-NOTE: original wires Lib.Foundation through an
        // InMemoryModuleResolver and asserts result.Succeeded. Translated through
        // CompileTypeCheckWithModule (Lib subdirectory + Foundation.stark).
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "typechkp1-imported-public-members-final-name",
            raw"""
import Lib.Foundation
module Demo

fn u32[0 2147483647] Use()
{
    stack Box box = new()
    {
        Value = Identity(Answer)
    };
    stack Status status = Status.Ok;
    switch (status)
    {
        case Status.Ok:
            return box.Value;
        case Status.Err:
            return Worker.Value();
    }
}
""",
            "Lib",
            "Foundation.stark",
            raw"""
module Lib.Foundation

public const Answer = 41;

public struct Box
{
    u32[0 2147483647] Value;
}

public enum Status
{
    Ok,
    Err
}

public struct Worker
{
    static finite law u32[0 2147483647] Value()
    {
        return 7;
    }
}

public fn u32[0 2147483647] Identity(u32[0 2147483647] value)
{
    return value;
}
""");
        return Succeeds(compiled);
    }
}

