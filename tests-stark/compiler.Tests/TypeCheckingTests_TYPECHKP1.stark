            "typechkp1-fp-arithmetic-chains-mixed",
            raw"""
module Demo

strictfp finite law f64 Run(f32 left, i32[min max] middle, f64 right, f32 divisor)
{
    return left + middle * right / divisor - 1.0;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.ExplicitConversionsPointerOperatorsAndSliceViewsTypeCheck.
public unsafe fn bool ExplicitConversionsPointerOperatorsAndSliceViewsTypeCheckImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-explicit-conversions-pointers-slices",
            raw"""
module Demo

unsafe finite law i32[min max] Run(i64[min max] bits, ascii text)
{
    stack mut i32[min max] value = 7;
    stack rawmutptr<i32[min max]> ptr = &value;
    stack rawptr<i32[min max]> readonlyPtr = (rawptr<i32[min max]>)ptr;
    *ptr = (i32[min max])bits;
    stack i64[min max] address = (i64[min max])ptr;
    stack rawmutptr<i32[min max]> roundTrip = (rawmutptr<i32[min max]>)address;
    stack i32[min max][2] values =
    {
        1, 2
    };
    stack i32[min max][] view = (i32[min max][])values;
    return *roundTrip + view[0];
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.TextEscapeLiteralsPreferUtf8BackedAsciiUnlessExplicitlyConverted.
public unsafe fn bool TextEscapeLiteralsPreferUtf8BackedAsciiUnlessExplicitlyConvertedImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-text-escape-literals-ascii",
            raw"""
module Demo

finite law ascii AsciiString()
{
    return "\0\b\t\n\f\r\\\"\'";
}

finite law ascii AsciiChar()
{
    return '\x41';
}

finite law unicode UnicodeString()
{
    return (unicode)"\xC9";
}

finite law unicode UnicodeChar()
{
    return (unicode)'α';
}
""");
        return Succeeds(compiled);
    }
}

// Ported from TypeCheckingTests.RawAndMultilineTextLiteralsTypeCheckAsTextLiterals.
public unsafe fn bool RawAndMultilineTextLiteralsTypeCheckAsTextLiteralsImpl()
{
    unsafe
    {
        // PORT-NOTE: the C# raw string for this program used a 5-quote delimiter so
        // the embedded program could contain its own triple-quoted multiline
        // literal. The Stark raw"""...""" literal cannot itself nest a """ token,
        // so the inner multiline raw"""..."""; body is preserved as written below;
        // the embedded program is otherwise verbatim.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-raw-and-multiline-text-literals",
            raw"""
module Demo

finite law ascii RawPath()
{
    return raw"c:\compiler\stage1";
}

finite law ascii Multiline()
{
    return raw"""
    alpha
    beta
    """;
}

finite law ascii Interpolated()
{
    return $raw"Score: {100}\n";
}

finite law unicode Wide()
{
    return (unicode)raw"α";
}
""");
        return Succeeds(compiled);
    }
}
