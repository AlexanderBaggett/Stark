// Ported from ProjectCliTests.BuildReportsStdlibDiscoveryPathsForMissingSystemImport.
// PORT-NOTE: the original asserts the build fails (exit 1) and renders stdlib
// discovery diagnostics on stderr (the unresolved-import message plus the searched
// stage/repo/bundled paths and active stdlib context). The discovery-path rendering
// and CLI exit codes are CLI-only; here we verify the embedded program fails to
// compile because `System.DoesNotExist` cannot be resolved.
public unsafe fn bool BuildReportsStdlibDiscoveryPathsForMissingSystemImportImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "project-cli-build-missing-system-import-discovery",
        raw"""
import System.DoesNotExist
module App

export fn i32[min max] main()
{
    return 0;
}
""");
    return !Succeeds(compiled);
}

// Ported from ProjectCliTests.ProjectBuildDoesNotUseStarkPathAsHiddenStdlibDiscovery.
// PORT-NOTE: the original sets STARK_PATH to a directory containing
// `System.GlobalProbe` and asserts the build still fails (exit 1) without consulting
// it, and that the env directory is absent from stderr. STARK_PATH suppression, env
// vars, and stderr rendering are CLI-only; here we verify the embedded program fails
// to compile because `System.GlobalProbe` is not resolvable from the source itself.
public unsafe fn bool ProjectBuildDoesNotUseStarkPathAsHiddenStdlibDiscoveryImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "project-cli-build-no-stark-path-hidden-discovery",
        raw"""
import System.GlobalProbe
module App

export fn i32[min max] main()
{
    return System.GlobalProbe.Value();
}
""");
    return !Succeeds(compiled);
}

