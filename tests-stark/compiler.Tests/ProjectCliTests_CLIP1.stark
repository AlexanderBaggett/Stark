{
    stack mut LlvmCompile compiled = CompileFull(
        "project-cli-test-rejects-filter-no-facts",
        raw"""
module Tests

export fn i32[min max] main()
{
    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from ProjectCliTests.TestRejectsExplicitMainWhenFactRunnerIsGenerated.
// PORT-NOTE: the original runs `test` against a root that declares both a [Fact] and
// an explicit `main`, and asserts the CLI rejects it (exit 1, "Remove the explicit
// 'main' function from the test root." on stderr) because the fact runner generates
// its own main. Fact-runner generation and that rejection are CLI-only; the embedded
// test root is itself a well-formed program, so here we verify it compiles.
public unsafe fn bool TestRejectsExplicitMainWhenFactRunnerIsGeneratedImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "project-cli-test-rejects-explicit-main-with-fact-runner",
        raw"""
module Tests

[Fact]
fn bool AddsNumbers()
{
    return 2 + 2 == 4;
}

export fn i32[min max] main()
{
    return 0;
}
""");
    return Succeeds(compiled);
}
