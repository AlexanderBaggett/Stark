// PORT-NOTE: the original drops a repo `stdlib/src/System.RepoSourceProbe` source
// tree on disk and asserts the build discovers it (exit 0, emitted executable).
// Repo stdlib source-tree discovery and the build CLI are not expressible here, so
// the imported `System.RepoSourceProbe` module is inlined ahead of `App` and the
// combined program is compiled.
public unsafe fn bool BuildUsesRepoStdlibSourceTreeDiscoveryImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "project-cli-build-repo-stdlib-source-tree",
        raw"""
module System.RepoSourceProbe

public finite law i32[min max] Value()
{
    return 0;
}

import System.RepoSourceProbe
module App

export fn i32[min max] main()
{
    return System.RepoSourceProbe.Value();
}
""");
    return Succeeds(compiled);
}

