public unsafe fn bool BuildRejectsUnavailableCompilerStageImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "project-cli-build-rejects-unavailable-stage",
        raw"""
module App

export fn i32[min max] main()
{
    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from ProjectCliTests.BuildBuildsSolutionDefaultTargetAndPathDependencies.
// PORT-NOTE: the original builds a two-member solution (a `math` library plus an
// `app` executable with a path dependency on it) and asserts both the static library
// and executable are emitted, plus package-image artifacts on disk. Solution driving,
// path dependencies, and file-system artifacts are not expressible here, so the
// `Math` library module is inlined ahead of `App` and the combined program is
// compiled.
public unsafe fn bool BuildBuildsSolutionDefaultTargetAndPathDependenciesImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "project-cli-build-solution-default-target-and-path-deps",
        raw"""
module Math

public finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

import Math
module App

export fn i32[min max] main()
{
    return Math.Add(3, 4);
}
""");
    return Succeeds(compiled);
}

