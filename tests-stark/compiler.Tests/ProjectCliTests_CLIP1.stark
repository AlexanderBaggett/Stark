        raw"""
module System.InstalledProbe

public finite law i32[min max] Value()
{
    return 0;
}

import System.InstalledProbe
module App

export fn i32[min max] main()
{
    return System.InstalledProbe.Value();
}
""");
    return Succeeds(compiled);
