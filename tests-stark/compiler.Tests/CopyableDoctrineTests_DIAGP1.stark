import CompilerTestSupport
import System.Testing

module CopyableDoctrineTests_DIAGP1

// Ported slice of tests/compiler.Tests/CopyableDoctrineTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold.

// Ported from CopyableDoctrineTests.WhereCopyableBoundAcceptsCopyableAndRejectsOwningOrDestructorTypes.
public unsafe fn bool WhereCopyableBoundAcceptsCopyableAndRejectsOwningOrDestructorTypesImpl()
{
    stack mut LlvmCompile accepted = CompileLlvm(
        "diagp1-where-copyable-bound-accepted",
        raw"""
module Demo

enum Kind
{
    Alpha,
    Beta,
}

fn bool Duplicate<T>(T value)
    where Copyable(T)
{
    stack T first = value;
    stack T second = value;
    return true;
}

fn bool Forwarded<T>(T value)
    where Copyable(T)
{
    return Duplicate(value);
}

export fn i32[min max] main()
{
    stack Kind kind = Kind.Alpha;
    if (!Forwarded(kind))
    {
        return 1;
    }

    return 0;
}
""");

    stack mut LlvmCompile rejected = CompileFull(
        "diagp1-where-copyable-bound-rejected",
        raw"""
module Demo

struct Owning
{
    dynamic i64[min max] Items;
}

fn bool Duplicate<T>(T value)
    where Copyable(T)
{
    return true;
}

fn bool MissingForward<T>(T value)
{
    return Duplicate(value);
}

export fn i32[min max] main()
{
    stack mut Owning owning = new();
    if (!Duplicate(owning))
    {
        return 1;
    }

    return 0;
}
""");

    // The accepted program must compile (copyable bound satisfied through the
    // forwarding chain); the rejected program must fail with two distinct
    // STK3049 diagnostics: one for the Owning argument's responsible field
    // chain, one for the generic forwarder missing `where Copyable(T)`.
    return Succeeds(accepted)
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3049", "requires where Copyable(Owning)") > 0
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3049", "Responsible field chain: Owning.Items") > 0
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3049", "MissingForward") > 0
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3049", "must declare `where Copyable(T)`") > 0;
}

// Ported from CopyableDoctrineTests.CopyableAssertionAttributeChecksStructurallyAtTheDefinition.
public unsafe fn bool CopyableAssertionAttributeChecksStructurallyAtTheDefinitionImpl()
{
    stack mut LlvmCompile accepted = CompileTypeCheck(
        "diagp1-copyable-attribute-accepted",
        raw"""
module Demo

[Copyable]
enum Kind
{
    Alpha,
    Beta,
}

[Copyable]
struct Span
{
    Kind Tag;
    u64[0 2 ** 63 - 1] Start;
}

export fn i32[min max] main()
{
    return 0;
}
""");

    stack mut LlvmCompile rejected = CompileTypeCheck(
        "diagp1-copyable-attribute-rejected",
        raw"""
module Demo

[Copyable]
struct Bad
{
    dynamic i64[min max] Items;
}

[Copyable]
struct BadDtor
{
    i32[min max] Value;

    drop
    {
    }
}

export fn i32[min max] main()
{
    return 0;
}
""");

    // The accepted program asserts [Copyable] on structurally-copyable types and
    // must type-check; the rejected program must fail with two STK3051
    // diagnostics: one for the owning-field chain, one for the destructor.
    return Succeeds(accepted)
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3051", "Responsible field chain: Bad.Items") > 0
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3051", "has a destructor") > 0;
}

// Ported from CopyableDoctrineTests.FixedArrayOfMoveOnlyElementsStaysMoveOnly.
public unsafe fn bool FixedArrayOfMoveOnlyElementsStaysMoveOnlyImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-fixed-array-move-only-elements",
        raw"""
module Demo

struct Owner
{
    dynamic i32[min max] Items;
}

[Copyable]
struct Bad
{
    Owner[2] Owners;
}

export fn i32[min max] main()
{
    return 0;
}
""");
    // A fixed array of a non-copyable element type is itself move-only, so the
    // [Copyable] assertion on the wrapping struct fails with the field chain.
    return FailsWithDiagnosticMessage(compiled, "STK3051", "Owners");
}
