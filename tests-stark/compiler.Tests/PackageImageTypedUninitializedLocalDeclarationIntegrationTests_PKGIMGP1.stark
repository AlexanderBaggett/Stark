import CompilerTestSupport
import System.Testing

module PackageImageTypedUninitializedLocalDeclarationIntegrationTests_PKGIMGP1

// Ported from PackageImageTypedUninitializedLocalDeclarationIntegrationTests.ManifestBackedTypedUninitializedLocalDeclarationsCompileAndRunWithoutSyntheticSource.
public unsafe fn bool ManifestBackedTypedUninitializedLocalDeclarationsCompileAndRunWithoutSyntheticSourceImpl()
{
    unsafe
    {
        // PORT-NOTE: The original first builds the `Facade` module (whose generic
        // `Observe` uses a typed uninitialized local declaration) into a static
        // library via the `--emit-lib -o` CLI path (asserting exit code 0,
        // "Emitted static library:" on stdout, empty stderr, the on-disk library
        // and `.starkpkg` manifest existing), loads the manifest and rewrites it
        // into a typed-only (source-surface-stripped) form with the generic
        // template carrying a TypedBody but no BodyText, deletes `Facade.stark`,
        // then compiles a `Demo` module that `import Facade` against that manifest
        // via `--emit-exe -o` (asserting exit code 0, "Emitted executable:" on
        // stdout, empty stderr, the executable existing), runs the produced binary,
        // and asserts empty stdout/stderr and exit code 15 (Observe(7, 0) ->
        // current=7, next=8, 7+8). The compile helpers cannot express the CLI
        // emit-lib/emit-exe builds, manifest rewriting / typed-only (sourceless)
        // resolution, source-file deletion, runtime stdout/stderr, or process exit
        // code, so this is reduced to compiling the same `Demo` root program with
        // the `Facade` module available as a sibling source module through the LLVM
        // pipeline and asserting it succeeds (the closest observable signal that the
        // typed uninitialized local declaration in `Facade.Observe` compiles and
        // resolves from `Demo`).
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "manifest-backed-typed-uninitialized-local-declarations-without-synthetic-source",
            raw"""
import Facade
module Demo

export fn i32[min max] main()
{
    return Facade.Observe(7, 0);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn i32[min max] Observe<T>(i32[min max] value, T tag)
{
    stack mut i32[min max] current, next = value + 1;
    current = value;
    return current + next;
}
""");
        return Succeeds(compiled);
    }
}
