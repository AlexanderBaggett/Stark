import CompilerTestSupport
import System.Testing
module PackageImageCallableValueTests_PKGIMGP1

// PORT-NOTE (applies to every Impl in this file): Each C# test builds a Facade
// library, publishes it to a package image (PackageImageBuilder), inspects the
// resulting manifest's typed-interface / generic-template structural facts (the
// "functionpointer"/"closure"/"rawpointer" Kind, FunctionAbi, FunctionKind,
// overlap/same parameter groups, raw-pointer element-count expressions, closure
// storage/borrow/capability facts, unsafe/abi function facts, type-alias targets,
// structural-fact type arguments, etc.), and several of them round-trip the
// manifest JSON, delete the Facade source, and re-import Facade into a Demo
// consumer through a FileSystemModuleResolver to lower/type-check the consumer and
// assert address-taken / function-pointer-promotion facts. The Stark test helpers
// cannot model package-image construction, manifest inspection or JSON round-trip,
// PackageImageLoader source-text reconstruction, module resolvers, LlvmTargetInfo
// target selection, filesystem effects, or typed-fact node inspection, so each
// port is reduced to compiling the published Facade library program through the
// closest pipeline stage (CompileTypeCheck for typed-interface/structural-fact
// tests, CompileMir for tests whose consumer lowers to MIR) and asserting it
// succeeds, which is the precondition for any of the published facts to exist.

// Ported from PackageImageCallableValueTests.PackageImagePreservesFunctionPointerTypesAndUnsafeFunctionFacts.
public unsafe fn bool PackageImagePreservesFunctionPointerTypesAndUnsafeFunctionFactsImpl()
{
    // PORT-NOTE: reduced to type-checking the published Facade library (see file header).
    // The C# test also targets x86_64-pc-windows-msvc so the platform(...) ABI selects
    // win64 and asserts manifest fnptr/overlap/same/bounded/unsafe/abi facts plus a
    // PackageImageLoader source-text round-trip; target selection, manifest inspection,
    // and source reconstruction are not expressible with the helpers.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "pkgimg-callable-fnptr-unsafe-facts",
        raw"""
module Facade

public struct Token
{
    i32[min max] Value;
}

public fn void Register(fnptr<fn void()> callback);
public fn void RegisterC(fnptr<ffi(c) fn void()> callback);
public fn void RegisterWin64(fnptr<ffi(win64) fn void()> callback);
public fn void RegisterPlatform(fnptr<unsafe ffi(platform(windows.x64: win64, linux.x64: sysv, default: c)) fn void()> callback);
public fn void RegisterOverlap(fnptr<fn void(borrow mut Token, borrow mut Token) where overlap(arg0, arg1)> callback);
public fn void RegisterSame(fnptr<fn void(borrow mut Token, borrow mut Token) where same(arg0, arg1)> callback);
public fn void RegisterFinite(fnptr<finite u32[0 2 ** 31 - 1]()> callback);
public fn void RegisterLaw(fnptr<law bool()> callback);
public fn void RegisterFiniteLaw(fnptr<finite law u32[0 2 ** 31 - 1]()> callback);
public unsafe fn void RegisterBounded(fnptr<fn void(rawptr<i32[min max]>[arg1], u8[1 10])> callback);
public unsafe fn void Dangerous();
public unsafe ffi(win64) fn void NativeWin64();
""");
    return Succeeds(compiled);
}

// Ported from PackageImageCallableValueTests.PackageImagePreservesDynTraitVtablePointerTypes.
public unsafe fn bool PackageImagePreservesDynTraitVtablePointerTypesImpl()
{
    // PORT-NOTE: reduced to type-checking the published Facade library (see file header).
    // The C# test asserts the manifest records Use's parameter as a rawpointer with named
    // element type "Speaker.Vtable", then re-imports Facade into a Demo consumer through a
    // FileSystemModuleResolver and asserts the consumer's TypeCheckModel Probe signature
    // displays "rawptr<Facade.Speaker.Vtable>"; manifest inspection, the manifest round-trip,
    // and the module resolver are not expressible with the helpers.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "pkgimg-callable-dyn-vtable-ptr",
        raw"""
module Facade

public dyn trait Speaker
{
    finite law i32[min max] Speak(borrow Self self);
}

public unsafe finite law i32[min max] Use(rawptr<Speaker.Vtable> table)
{
    return 1;
}
""");
    return Succeeds(compiled);
}

// Ported from PackageImageCallableValueTests.PackageImagePreservesTargetSelectedPlatformAbiInTypedTemplateStructuralFacts.
public unsafe fn bool PackageImagePreservesTargetSelectedPlatformAbiInTypedTemplateStructuralFactsImpl()
{
    // PORT-NOTE: reduced to type-checking the published Facade library (see file header).
    // The C# test targets x86_64-pc-windows-msvc and asserts the published generic-template
    // body's structural-fact return expression carries a functionpointer type argument with
    // FunctionAbi "win64" and FunctionIsUnsafe true; target selection and structural-fact
    // node inspection are not expressible with the helpers.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "pkgimg-callable-platform-abi-template-fact",
        raw"""
module Facade

public finite law bool PlatformCallbackUsesWin64<T>()
{
    return comptime System.Compiler.FunctionPointerAbiIsWin64<fnptr<unsafe ffi(platform(windows.x64: win64, linux.x64: sysv, default: c)) fn void()>>();
}
""");
    return Succeeds(compiled);
}

// Ported from PackageImageCallableValueTests.PackageImagePreservesTargetSelectedPlatformAbiInTypedConstructorParameters.
public unsafe fn bool PackageImagePreservesTargetSelectedPlatformAbiInTypedConstructorParametersImpl()
{
    // PORT-NOTE: reduced to type-checking the published Facade library (see file header).
    // The C# test targets x86_64-pc-windows-msvc and asserts the manifest records Handler's
    // constructor parameter as a functionpointer with FunctionAbi "win64" and FunctionIsUnsafe
    // true; target selection and manifest inspection are not expressible with the helpers.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "pkgimg-callable-platform-abi-constructor",
        raw"""
module Facade

public struct Handler
{
    Handler(fnptr<unsafe ffi(platform(windows.x64: win64, linux.x64: sysv, default: c)) fn void()> callback)
    {
    }
}
""");
    return Succeeds(compiled);
}

// Ported from PackageImageCallableValueTests.PackageImagePreservesClosureTypes.
public unsafe fn bool PackageImagePreservesClosureTypesImpl()
{
    // PORT-NOTE: reduced to type-checking the published Facade library (see file header).
    // The C# test asserts the manifest records each closure parameter's Kind/ClosureStorageKind/
    // BorrowKind/ClosureCallCapability/IsMutableView/overlap-group/raw-pointer-element-count facts
    // and the Factory heap-closure return type, then round-trips a PackageImageLoader source text;
    // manifest inspection and source reconstruction are not expressible with the helpers.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "pkgimg-callable-closure-facts",
        raw"""
module Facade

public struct Token
{
    i32[min max] Value;
}

public fn void RegisterInline(inline closure<fn void(borrow mut Token)> callback);
public fn void RegisterBorrow(borrow closure<fn void(borrow mut Token)> callback);
public fn void RegisterMut(mut borrow closure<mut fn void(i32[min max])> callback);
public fn void RegisterOverlap(borrow closure<fn void(borrow mut Token, borrow mut Token) where overlap(arg0, arg1)> callback);
public unsafe fn void RegisterBounded(borrow closure<finite void(rawptr<i32[min max]>[arg1], u8[1 10])> callback);
public fn heap closure<fn i32[min max](i32[min max])> Factory(heap closure<fn i32[min max](i32[min max])> callback);
""");
    return Succeeds(compiled);
}

// Ported from PackageImageCallableValueTests.PackageImageBackedExplicitConstructorWithAliasCallableParameterLowersWithoutSource.
public unsafe fn bool PackageImageBackedExplicitConstructorWithAliasCallableParameterLowersWithoutSourceImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    // The C# test publishes Facade, deletes its source, then re-imports it into a Demo consumer
    // through a FileSystemModuleResolver and lowers the consumer (which constructs Facade.Box
    // with a function item bound to the Factory fnptr alias) to MIR; the manifest round-trip,
    // module resolver, and fallback-log assertions are not expressible with the helpers.
    stack mut LlvmCompile compiled = CompileMir(
        "pkgimg-callable-alias-ctor-lower",
        raw"""
module Facade

public alias Factory = fnptr<fn i32[min max]()>;

public struct Box
{
    internal i32[min max] Value;

    Box(Factory factory)
    {
        self.Value = factory();
    }
}
""");
    return Succeeds(compiled);
}

// Ported from PackageImageCallableValueTests.PackageImageBackedCallableAliasPreservesFiniteLawFunctionPointerKind.
public unsafe fn bool PackageImageBackedCallableAliasPreservesFiniteLawFunctionPointerKindImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    // The C# test asserts the manifest records the StrictFactory alias target as a
    // functionpointer with FunctionKind "finite law", then re-imports Facade into a Demo
    // consumer through a FileSystemModuleResolver and lowers it to MIR; manifest inspection,
    // the manifest round-trip, and the module resolver are not expressible with the helpers.
    stack mut LlvmCompile compiled = CompileMir(
        "pkgimg-callable-alias-finite-law-kind",
        raw"""
module Facade

public alias StrictFactory = fnptr<finite law u32[0 2 ** 31 - 1]()>;

public struct Box
{
    internal u32[0 2 ** 31 - 1] Value;

    Box(StrictFactory factory)
    {
        self.Value = factory();
    }
}
""");
    return Succeeds(compiled);
}

// Ported from PackageImageCallableValueTests.PackageImageBackedQualifiedFunctionItemsPromoteToOrdinaryFunctionPointers.
public unsafe fn bool PackageImageBackedQualifiedFunctionItemsPromoteToOrdinaryFunctionPointersImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    // The C# test publishes Facade, deletes its source, then re-imports it into a Demo consumer
    // (which takes the address of Facade.Make into an ordinary fnptr) and lowers to MIR,
    // asserting a single address-taken function "Facade.Make" in both the TypeCheckModel and the
    // MIR; the manifest round-trip, module resolver, and address-taken inspection are not
    // expressible with the helpers, so only the published library is lowered.
    stack mut LlvmCompile compiled = CompileMir(
        "pkgimg-callable-qualified-fn-promote",
        raw"""
module Facade

public fn i32[min max] Make();
""");
    return Succeeds(compiled);
}

// Ported from PackageImageCallableValueTests.PackageImageBackedFunctionItemsPromoteFromEachDeclaredFunctionKind.
public unsafe fn bool PackageImageBackedFunctionItemsPromoteFromEachDeclaredFunctionKindImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    // The C# test publishes Facade, deletes its source, then re-imports it into a Demo consumer
    // that promotes Plain/FiniteOnly/LawOnly/Strict to fnptrs of each declared kind and lowers
    // to MIR, asserting four function-pointer promotions / address-taken facts (one per kind) in
    // both the TypeCheckModel and the MIR; the manifest round-trip, module resolver, and
    // address-taken inspection are not expressible with the helpers, so only the published
    // library is lowered.
    stack mut LlvmCompile compiled = CompileMir(
        "pkgimg-callable-each-kind-promote",
        raw"""
module Facade

public fn i32[min max] Plain();
public finite i32[min max] FiniteOnly();
public law i32[min max] LawOnly();
public finite law i32[min max] Strict();
""");
    return Succeeds(compiled);
}

// Ported from PackageImageCallableValueTests.PackageImageBackedOverloadedFunctionItemsPreserveDistinctAddressTakenFacts.
public unsafe fn bool PackageImageBackedOverloadedFunctionItemsPreserveDistinctAddressTakenFactsImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    // The C# test publishes Facade with two Pick overloads, deletes its source, then re-imports
    // it into a Demo consumer that promotes each overload to a distinct fnptr and lowers to MIR,
    // asserting two function-pointer promotions / two distinct address-taken functions (both with
    // display source name "Facade.Pick") in the TypeCheckModel and two in the MIR; the manifest
    // round-trip, module resolver, and address-taken inspection are not expressible with the
    // helpers, so only the published library is lowered.
    stack mut LlvmCompile compiled = CompileMir(
        "pkgimg-callable-overloaded-distinct-address-taken",
        raw"""
module Facade

public fn i32[min max] Pick();
public fn i32[min max] Pick(i32[min max] value);
""");
    return Succeeds(compiled);
}
