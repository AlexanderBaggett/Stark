import CompilerTestSupport
import System.Testing

module FunctionSemanticsTests_PARSE_OKP1

// Ported slice of tests/compiler.Tests/FunctionSemanticsTests.cs.
// The Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold. PORT-NOTE comments flag assertions the helpers
// cannot express (SyntaxModel declaration-visibility introspection) that were
// reduced to the nearest signal.

// Ported from FunctionSemanticsTests.MemberFunctionVisibilityInheritsNarrowsAndAvoidsAccidentalExport.
public unsafe fn bool MemberFunctionVisibilityInheritsNarrowsAndAvoidsAccidentalExportImpl()
{
    unsafe
    {
        // PORT-NOTE: beyond result.Succeeded, the original probes the SyntaxModel
        // declarations to confirm member-function visibility inheritance/narrowing:
        // "Api.SourceVisible" is Public, "Api.RuntimeOnly" is Internal, and
        // "Api.AbiVisible" is Export. SyntaxModel declaration-visibility access is not
        // expressible via the compile helpers, so this reduces to "the embedded
        // program type-checks successfully" (the result.Succeeded signal).
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "function-semantics-member-visibility-inherits-narrows-avoids-export",
            raw"""
module Demo

export struct Api
{
    unsafe fn void SourceVisible()
    {
        return;
    }

    internal unsafe fn void RuntimeOnly()
    {
        return;
    }

    export unsafe fn void AbiVisible()
    {
        return;
    }
}
""");
        return Succeeds(compiled);
    }
}
