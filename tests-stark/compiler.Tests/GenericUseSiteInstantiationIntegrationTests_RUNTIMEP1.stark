import CompilerTestSupport
import System.Testing
module GenericUseSiteInstantiationIntegrationTests_RUNTIMEP1

// Ported slice of
// tests/compiler.IntegrationTests/GenericUseSiteInstantiationIntegrationTests.cs.
// The original is a CLI/manifest/runtime integration test: it builds a Facade
// library with --emit-lib, rewrites the emitted manifest to a typed-only form
// that omits compiler facts, then links a Demo executable against the
// manifest-backed library without source and runs it. The Stark compile helpers
// cannot model --emit-lib, manifest rewriting, manifest-backed linking, or
// process exit codes, so the Impl reduces to driving the available source
// program through the closest compile helper. See the per-method `// PORT-NOTE:`.

// Ported from GenericUseSiteInstantiationIntegrationTests.ManifestBackedTypedInterfaceModifiersWithoutCompilerFactsStillSpecializeAndRun.
public unsafe fn bool ManifestBackedTypedInterfaceModifiersWithoutCompilerFactsStillSpecializeAndRunImpl()
{
    // PORT-NOTE: original emits Facade as a static library (--emit-lib), strips
    // compiler facts from the generated manifest (BuildTypedOnlyFacadeManifest /
    // omitCompilerFacts: true), then builds and runs a Demo that imports the
    // manifest-backed library, asserting CLI exit 0, "Emitted static library:" /
    // "Emitted executable:" stdout, file existence, empty process output, and a
    // runtime exit code of 7. None of the manifest-rewrite, manifest-backed
    // linking, or runtime behavior is observable through the compile helpers, and
    // the single-module helper cannot supply the manifest-only Facade dependency
    // to Demo. Reduced to a full-pipeline compile of the Facade library program
    // (the generic carrying the cold/noinline interface modifiers that must still
    // specialize) returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "guse-manifest-typed-iface-modifiers-runtime",
        raw"""
module Facade

public cold noinline fn T Choose<T>(T left, T right, bool takeRight)
{
    stack mut T current = left;
    if (takeRight)
    {
        current = right;
    }

    return current;
}
""");
    return Succeeds(compiled);
}
