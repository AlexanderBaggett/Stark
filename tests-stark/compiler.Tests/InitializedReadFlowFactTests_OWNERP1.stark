import CompilerTestSupport
import System.Testing
module InitializedReadFlowFactTests_OWNERP1

// Ported slice of tests/compiler.Tests/InitializedReadFlowFactTests.cs.
//
// Each C# test embeds a Stark program built from a shared TablePrelude (the
// `Demo` module with a `Kind` enum, an `Item` struct, and a `Table` struct
// holding a `dynamic Item Items` field) plus a per-test function. The prelude is
// inlined verbatim ahead of each per-test function. The C# `Compile` helper runs
// the default pipeline with EmitLlvmIr:true; the assertions are all semantic
// branch-dominance / slot-proof checks, so each program is routed through
// CompileTypeCheck.
//
// The positive test asserts result.Succeeded -> Succeeds(c). The negative tests
// assert AssertSlotProofError(result, slot), which requires a STK4205 diagnostic
// whose message contains BOTH "without a proof that the slot is initialized" AND
// the slot fragment; that conjunction is reproduced with FailsWithDiagnosticMessage
// on the slot fragment plus an AnyDiagnosticMessageContains on the phrase. The
// NonStrict test asserts exactly two such STK4205 diagnostics, reproduced with
// CountDiagnosticsWithCodeAndMessage == 2.

// Ported from InitializedReadFlowFactTests.GuardThenReadProvesDirectAndProjectedReadsInFreeFunctions.
public unsafe fn bool GuardThenReadProvesDirectAndProjectedReadsInFreeFunctionsImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-initread-guard-then-read-proves-direct-and-projected",
            raw"""
module Demo

enum Kind
{
    Alpha,
    Beta,
}

struct Item
{
    Kind Tag;
    u64[0 2 ** 63 - 1] Start;
}

struct Table
{
    dynamic Item Items;
}

finite law bool TagAtIs(borrow Table self, u64[0 2 ** 63 - 1] index, Kind expected)
{
    if (index >= self.Items.Length)
    {
        return false;
    }

    return self.Items[index].Tag == expected;
}

finite law Item ItemAt(borrow Table self, u64[0 2 ** 63 - 1] index)
{
    if (index >= self.Items.Length)
    {
        return new();
    }

    return self.Items[index];
}

finite law u64[0 2 ** 63 - 1] StartInsideThen(borrow Table self, u64[0 2 ** 63 - 1] index)
{
    if (index < self.Items.Length)
    {
        return self.Items[index].Start;
    }

    return 0;
}

finite law bool BothBelow(borrow Table self, u64[0 2 ** 63 - 1] left, u64[0 2 ** 63 - 1] right)
{
    if (left < self.Items.Length && right < self.Items.Length)
    {
        return self.Items[left].Tag == self.Items[right].Tag;
    }

    return false;
}

finite law u64[0 2 ** 63 - 1] CountViaWhile(borrow Table self)
{
    stack mut u64[0 2 ** 63 - 1] index = 0;
    stack mut u64[0 2 ** 63 - 1] count = 0;
    while willexit (index < self.Items.Length)
    {
        if (self.Items[index].Tag == Kind.Alpha)
        {
            count = (u64[0 2 ** 63 - 1])(count + 1);
        }

        index = (u64[0 2 ** 63 - 1])(index + 1);
    }

    return count;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from InitializedReadFlowFactTests.UnguardedFieldProjectionsThroughDynamicSlotsAreNowChecked.
public unsafe fn bool UnguardedFieldProjectionsThroughDynamicSlotsAreNowCheckedImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-initread-unguarded-field-projection-checked",
            raw"""
module Demo

enum Kind
{
    Alpha,
    Beta,
}

struct Item
{
    Kind Tag;
    u64[0 2 ** 63 - 1] Start;
}

struct Table
{
    dynamic Item Items;
}

finite law bool UnguardedField(borrow Table self, u64[0 2 ** 63 - 1] index)
{
    return self.Items[index].Tag == Kind.Alpha;
}
""");
        // AssertSlotProofError(result, "self.Items"): STK4205 whose message
        // contains both the proof phrase and the slot fragment.
        return FailsWithDiagnosticMessage(compiled, "STK4205", "self.Items")
            && AnyDiagnosticMessageContains(compiled, "without a proof that the slot is initialized");
    }
}

// Ported from InitializedReadFlowFactTests.WritingToTheIndexInvalidatesTheFact.
public unsafe fn bool WritingToTheIndexInvalidatesTheFactImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-initread-writing-index-invalidates-fact",
            raw"""
module Demo

enum Kind
{
    Alpha,
    Beta,
}

struct Item
{
    Kind Tag;
    u64[0 2 ** 63 - 1] Start;
}

struct Table
{
    dynamic Item Items;
}

finite law bool IncrementAfterGuard(borrow Table self, u64[0 2 ** 63 - 1] index)
{
    stack mut u64[0 2 ** 63 - 1] probe = index;
    if (probe >= self.Items.Length)
    {
        return false;
    }

    probe += 1;
    return self.Items[probe].Tag == Kind.Alpha;
}
""");
        // AssertSlotProofError(result, "self.Items"): STK4205 whose message
        // contains both the proof phrase and the slot fragment.
        return FailsWithDiagnosticMessage(compiled, "STK4205", "self.Items")
            && AnyDiagnosticMessageContains(compiled, "without a proof that the slot is initialized");
    }
}

// Ported from InitializedReadFlowFactTests.NonStrictComparisonsAndNonTerminatingGuardsProveNothing.
public unsafe fn bool NonStrictComparisonsAndNonTerminatingGuardsProveNothingImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-initread-nonstrict-and-nonterminating-guards-prove-nothing",
            raw"""
module Demo

enum Kind
{
    Alpha,
    Beta,
}

struct Item
{
    Kind Tag;
    u64[0 2 ** 63 - 1] Start;
}

struct Table
{
    dynamic Item Items;
}

finite law bool NonStrict(borrow Table self, u64[0 2 ** 63 - 1] index)
{
    if (index <= self.Items.Length)
    {
        return self.Items[index].Tag == Kind.Alpha;
    }

    return false;
}

finite law bool GuardWithoutReturn(borrow Table self, u64[0 2 ** 63 - 1] index)
{
    if (index >= self.Items.Length)
    {
        stack u64[0 2 ** 63 - 1] ignored = 0;
    }

    return self.Items[index].Tag == Kind.Alpha;
}
""");
        // Assert.Equal(2, count of STK4205 diagnostics whose message contains
        // "without a proof that the slot is initialized").
        return !Succeeds(compiled)
            && CountDiagnosticsWithCodeAndMessage(
                compiled,
                "STK4205",
                "without a proof that the slot is initialized") == 2;
    }
}

// Ported from InitializedReadFlowFactTests.MutBorrowingTheStorageOwnerInvalidatesTheFact.
public unsafe fn bool MutBorrowingTheStorageOwnerInvalidatesTheFactImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-initread-mut-borrowing-storage-owner-invalidates-fact",
            raw"""
module Demo

enum Kind
{
    Alpha,
    Beta,
}

struct Item
{
    Kind Tag;
    u64[0 2 ** 63 - 1] Start;
}

struct Table
{
    dynamic Item Items;
}

fn void Touch(mut borrow Table table)
{
    return;
}

fn bool ReadAfterMutCall(mut borrow Table self, u64[0 2 ** 63 - 1] index)
{
    if (index >= self.Items.Length)
    {
        return false;
    }

    Touch(self);
    return self.Items[index].Tag == Kind.Alpha;
}
""");
        // AssertSlotProofError(result, "self.Items"): STK4205 whose message
        // contains both the proof phrase and the slot fragment.
        return FailsWithDiagnosticMessage(compiled, "STK4205", "self.Items")
            && AnyDiagnosticMessageContains(compiled, "without a proof that the slot is initialized");
    }
}
