import CompilerTestSupport
import System.Testing
module CopyableDoctrineTests

// Ported slice of tests/compiler.Tests/CopyableDoctrineTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold.

// Ported from CopyableDoctrineTests.WhereCopyableBoundAcceptsCopyableAndRejectsOwningOrDestructorTypes.
internal fn bool WhereCopyableBoundAcceptsCopyableAndRejectsOwningOrDestructorTypesImpl()
{
    stack mut LlvmCompile accepted = CompileLlvm(
        "diagp1-where-copyable-bound-accepted",
        raw"""
module Demo

enum Kind
{
    Alpha,
    Beta,
}

fn bool Duplicate<T>(T value)
    where Copyable(T)
{
    stack T first = value;
    stack T second = value;
    return true;
}

fn bool Forwarded<T>(T value)
    where Copyable(T)
{
    return Duplicate(value);
}

export fn i32[min max] main()
{
    stack Kind kind = Kind.Alpha;
    if (!Forwarded(kind))
    {
        return 1;
    }

    return 0;
}
""");

    stack mut LlvmCompile rejected = CompileFull(
        "diagp1-where-copyable-bound-rejected",
        raw"""
module Demo

struct Owning
{
    dynamic i64[min max] Items;
}

fn bool Duplicate<T>(T value)
    where Copyable(T)
{
    return true;
}

fn bool MissingForward<T>(T value)
{
    return Duplicate(value);
}

export fn i32[min max] main()
{
    stack mut Owning owning = new();
    if (!Duplicate(owning))
    {
        return 1;
    }

    return 0;
}
""");

    // The accepted program must compile (copyable bound satisfied through the
    // forwarding chain); the rejected program must fail with two distinct
    // STK3049 diagnostics: one for the Owning argument's responsible field
    // chain, one for the generic forwarder missing `where Copyable(T)`.
    return Succeeds(accepted)
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3049", "requires where Copyable(Owning)") > 0
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3049", "Responsible field chain: Owning.Items") > 0
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3049", "MissingForward") > 0
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3049", "must declare `where Copyable(T)`") > 0;
}

// Ported from CopyableDoctrineTests.CopyableAssertionAttributeChecksStructurallyAtTheDefinition.
internal fn bool CopyableAssertionAttributeChecksStructurallyAtTheDefinitionImpl()
{
    stack mut LlvmCompile accepted = CompileTypeCheck(
        "diagp1-copyable-attribute-accepted",
        raw"""
module Demo

[Copyable]
enum Kind
{
    Alpha,
    Beta,
}

[Copyable]
struct Span
{
    Kind Tag;
    u64[0 2 ** 63 - 1] Start;
}

export fn i32[min max] main()
{
    return 0;
}
""");

    stack mut LlvmCompile rejected = CompileTypeCheck(
        "diagp1-copyable-attribute-rejected",
        raw"""
module Demo

[Copyable]
struct Bad
{
    dynamic i64[min max] Items;
}

[Copyable]
struct BadDtor
{
    i32[min max] Value;

    drop
    {
    }
}

export fn i32[min max] main()
{
    return 0;
}
""");

    // The accepted program asserts [Copyable] on structurally-copyable types and
    // must type-check; the rejected program must fail with two STK3051
    // diagnostics: one for the owning-field chain, one for the destructor.
    return Succeeds(accepted)
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3051", "Responsible field chain: Bad.Items") > 0
        && CountDiagnosticsWithCodeAndMessage(rejected, "STK3051", "has a destructor") > 0;
}

// Ported from CopyableDoctrineTests.FixedArrayOfMoveOnlyElementsStaysMoveOnly.
internal fn bool FixedArrayOfMoveOnlyElementsStaysMoveOnlyImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-fixed-array-move-only-elements",
        raw"""
module Demo

struct Owner
{
    dynamic i32[min max] Items;
}

[Copyable]
struct Bad
{
    Owner[2] Owners;
}

export fn i32[min max] main()
{
    return 0;
}
""");
    // A fixed array of a non-copyable element type is itself move-only, so the
    // [Copyable] assertion on the wrapping struct fails with the field chain.
    return FailsWithDiagnosticMessage(compiled, "STK3051", "Owners");
}

// Ported from CopyableDoctrineTests.TagEnumAndStructOfTagEnumCopyOutOfPlacesAndKeepTheSourceUsable.
internal fn bool TagEnumAndStructOfTagEnumCopyOutOfPlacesAndKeepTheSourceUsableImpl()
{
    {
        // PORT-NOTE: the original runs the full pipeline with EmitLlvmIr: true and
        // only asserts result.Succeeded (no LLVM substring is read), so this uses
        // CompileLlvm and reduces to Succeeds(...).
        stack mut LlvmCompile compiled = CompileLlvm(
            "ownerp1-tag-enum-struct-copy-out-of-places",
            raw"""
module Demo

enum Kind
{
    Alpha,
    Beta,
    Gamma,
}

struct Item
{
    Kind Tag;
    u64[0 2 ** 63 - 1] Start;
}

struct Table
{
    dynamic Item Items;

    finite law Kind KindAt(borrow Table self, u64[0 2 ** 63 - 1] index)
    {
        if (index >= self.Items.Length)
        {
            return Kind.Alpha;
        }

        return self.Items[index].Tag;
    }
}

fn bool Append(mut borrow Table table, Kind kind, u64[0 2 ** 63 - 1] start)
{
    if (!table.Items.TryReserve(1))
    {
        return false;
    }

    stack mut Item item = new();
    item.Tag = kind;
    item.Start = start;
    init table.Items[table.Items.Length] = item;
    return true;
}

export fn i32[min max] main()
{
    stack Kind a = Kind.Beta;
    stack Kind b = a;
    if (a != Kind.Beta)
    {
        return 1;
    }

    stack mut Item item = new();
    item.Tag = Kind.Gamma;
    stack Item copy = item;
    if (item.Tag != Kind.Gamma)
    {
        return 2;
    }

    stack mut Table table = new();
    if (!Append(table, Kind.Beta, 3))
    {
        return 3;
    }

    if (table.KindAt(0) != Kind.Beta)
    {
        return 4;
    }

    if (b != Kind.Beta || copy.Tag != Kind.Gamma)
    {
        return 5;
    }

    return 0;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CopyableDoctrineTests.EnumsWithOwningPayloadsStayMoveOnlyAtIndexedPlaces.
internal fn bool EnumsWithOwningPayloadsStayMoveOnlyAtIndexedPlacesImpl()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "ownerp1-enums-owning-payloads-move-only-indexed",
            raw"""
module Demo

struct Payload
{
    dynamic i64[min max] Items;
}

enum Owning
{
    Empty,
    Holding(Payload),
}

struct Row
{
    Owning State;
}

struct Rows
{
    dynamic Row Entries;

    fn bool StateAtIsEmpty(borrow Rows self, u64[0 2 ** 63 - 1] index)
    {
        if (index >= self.Entries.Length)
        {
            return true;
        }

        stack Owning copied = self.Entries[index].State;
        switch (copied)
        {
            case Owning.Empty:
                return true;
            case Owning.Holding(var payload):
                return false;
        }
    }
}

export fn i32[min max] main()
{
    return 0;
}
""");
        return FailsWithDiagnosticMessage(
            compiled,
            "STK4203",
            "Cannot move a non-tail dynamic storage slot of type 'Owning'");
    }
}

// Ported from CopyableDoctrineTests.ComptimeEvaluationCopiesCopyableValuesConsistently.
internal fn bool ComptimeEvaluationCopiesCopyableValuesConsistentlyImpl()
{
    {
        // PORT-NOTE: the original runs the full pipeline with EmitLlvmIr: true and
        // only asserts result.Succeeded (no LLVM substring is read), so this uses
        // CompileLlvm and reduces to Succeeds(...).
        stack mut LlvmCompile compiled = CompileLlvm(
            "ownerp1-comptime-copies-copyable-values-consistently",
            raw"""
module Demo

enum Kind
{
    Alpha,
    Beta,
}

struct Pair
{
    Kind First;
    Kind Second;
}

const Pair Both = new Pair()
{
    First = Kind.Alpha,
    Second = Kind.Beta
};

finite law bool ComptimeCopies()
{
    // Repeated reads of const-aggregate projections: each read
    // is a copy and the source stays readable (const globals
    // keep frozen provenance, so values compare in place).
    return Both.First == Kind.Alpha
        && Both.First == Kind.Alpha
        && Both.Second == Kind.Beta
        && Both.Second != Kind.Alpha;
}

export fn i32[min max] main()
{
    if (!ComptimeCopies())
    {
        return 1;
    }

    return 0;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CopyableDoctrineTests.StructsWithDestructorsStayMoveOnly.
internal fn bool StructsWithDestructorsStayMoveOnlyImpl()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "ownerp1-structs-with-destructors-move-only",
            raw"""
module Demo

struct WithDtor
{
    i64[min max] Value;

    drop
    {
    }
}

export fn i32[min max] main()
{
    stack WithDtor a = new();
    stack WithDtor b = a;
    if (a.Value != 0)
    {
        return 1;
    }

    return 0;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "moved");
    }
}

// Ported from CopyableDoctrineTests.FixedArrayOfCopyableElementsIsCopyable.
internal fn bool FixedArrayOfCopyableElementsIsCopyableImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-fixed-array-of-copyable-elements-is-copyable",
            raw"""
module Demo

[Copyable]
struct Board
{
    i32[min max][4] Cells;
}

finite law i32[min max] Sum(Board board)
{
    stack Board copy = board;
    return board.Cells[0] + copy.Cells[0];
}

export fn i32[min max] main()
{
    return 0;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CopyableDoctrineTests.SliceAndFunctionPointerFieldsAreCopyable.
internal fn bool SliceAndFunctionPointerFieldsAreCopyableImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-slice-and-function-pointer-fields-copyable",
            raw"""
module Demo

[Copyable]
struct View
{
    i32[min max][] Data;
}

[Copyable]
struct Callback
{
    fnptr<fn i32[min max](i32[min max])> Fn;
}

finite law bool ReuseView(View view)
{
    stack View copy = view;
    return view.Data.Length == copy.Data.Length;
}

export fn i32[min max] main()
{
    return 0;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CopyableDoctrineTests.DestructorFlagRoundTripsThroughPackageImageFacts.
internal fn bool DestructorFlagRoundTripsThroughPackageImageFactsImpl()
{
    // PORT-NOTE: The C# test compiles the Facade library through the "lower-abi" pass,
    // builds a package image, resolves it as a ResolvedPackageModule, then loads it via
    // PackageImageLoader.TryBuildLoadedPackageImageFacts and inspects per-type facts:
    // Facade.Handle.HasDestructor is true, Facade.Plain.HasDestructor is false, and the
    // same NamedTypes feed CopyabilityFacts so the destructor-bearing Handle is not
    // copyable while Plain is. Package-image construction, manifest round-tripping, the
    // loader fact tables, and copyability resolution over loaded symbols are not
    // expressible with the Stark helpers, so this is reduced to compiling the published
    // Facade library program through the ABI-lowering (MIR) stage and asserting it
    // succeeds (the precondition for any published destructor/copyability fact).
    stack mut LlvmCompile compiled = CompileMir(
        "pkgimg-destructor-flag-round-trips-library",
        raw"""
module Facade

public struct Handle
{
    i32[min max] Descriptor;

    drop
    {
    }
}

public struct Plain
{
    i32[min max] Value;
}

public fn Handle MakeHandle()
{
    return new Handle()
    {
        Descriptor = 1
    };
}
""");
    return Succeeds(compiled);
}
