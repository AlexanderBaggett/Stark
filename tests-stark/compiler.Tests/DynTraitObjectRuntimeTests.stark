import CompilerTestSupport
import System.Testing
module DynTraitObjectRuntimeTests

// Ported slice of tests/compiler.IntegrationTests/DynTraitObjectRuntimeTests.cs.
// The C# originals compile each embedded program to a native executable via the
// CLI (--emit-exe), run it, and assert on the process exit code. The Stark
// compile helpers cannot link, run, or observe an exit code, so each Impl drives
// the embedded program through the closest full-pipeline compile helper and
// returns the nearest available success signal. See per-method `// PORT-NOTE:`.

// Ported from DynTraitObjectRuntimeTests.BorrowDynTraitObjectDispatchesPolymorphicallyAtRuntime.
internal fn bool BorrowDynTraitObjectDispatchesPolymorphicallyAtRuntimeImpl()
{
    // PORT-NOTE: original compiles to an executable, runs it, and asserts the
    // process exit code is 31 (4*4 + 3*5, dispatched through `borrow dyn Shape`
    // vtables). The compile helpers cannot run the linked program, so this is
    // reduced to a full-pipeline compile of the embedded program returning
    // Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "dyntrait-borrow-runtime-dispatch",
        raw"""
module Demo

dyn trait Shape
{
    finite law i32[min max] Area(borrow Self self);
}

struct Square : Shape
{
    i32[min max] Side;

    finite law i32[min max] Area(borrow Square self)
    {
        return self.Side * self.Side;
    }
}

struct Box : Shape
{
    i32[min max] Width;
    i32[min max] Height;

    finite law i32[min max] Area(borrow Box self)
    {
        return self.Width * self.Height;
    }
}

finite law i32[min max] AreaOf(borrow dyn Shape shape)
{
    return shape.Area();
}

export fn i32[min max] main()
{
    stack Square square = new Square() { Side = 4 };
    stack Box box = new Box() { Width = 3, Height = 5 };
    stack borrow dyn Shape first = square;
    stack borrow dyn Shape second = box;
    return AreaOf(first) + AreaOf(second);
}
""");
    return Succeeds(compiled);
}

// Ported from DynTraitObjectRuntimeTests.OwnedHeapDynTraitObjectAllocatesDispatchesAndDrops.
internal fn bool OwnedHeapDynTraitObjectAllocatesDispatchesAndDropsImpl()
{
    // PORT-NOTE: original compiles to an executable, runs it, and asserts the
    // process exit code is 9 (4 + 5, where each `heap dyn Speaker` boxes a value,
    // dispatches via the vtable, and drops the box through the vtable Drop slot at
    // scope exit). The compile helpers cannot run the linked program or observe
    // heap allocation/drop effects, so this is reduced to a full-pipeline compile
    // of the embedded program returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "dyntrait-owned-heap-dispatch-drop",
        raw"""
module Demo

dyn trait Speaker
{
    finite law i32[min max] Speak(borrow Self self);
}

struct Dog : Speaker
{
    i32[min max] Volume;

    finite law i32[min max] Speak(borrow Dog self)
    {
        return self.Volume;
    }
}

struct Cat : Speaker
{
    i32[min max] Pitch;

    finite law i32[min max] Speak(borrow Cat self)
    {
        return self.Pitch;
    }
}

export fn i32[min max] main()
{
    stack heap dyn Speaker first = new Dog() { Volume = 4 };
    stack heap dyn Speaker second = new Cat() { Pitch = 5 };
    return first.Speak() + second.Speak();
}
""");
    return Succeeds(compiled);
}
