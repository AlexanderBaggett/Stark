import CompilerTestSupport
import System.Testing
module ProjectCliTests

// Ported slice of tests/compiler.IntegrationTests/ProjectCliTests.cs (CLI part 1).
// These are CLI integration tests that drive `CompilerCli.RunAsync` and assert on
// process exit codes, stdout ("Emitted executable:", etc.), stderr text, and
// file-system artifacts on disk. None of those CLI/process/file-system effects are
// expressible through the host test protocol. Each Impl preserves the embedded
// Stark program verbatim and runs it through the closest compile helper, returning
// the nearest signal (compile success for build-succeeds tests, compile failure for
// import-resolution-failure tests). Every reduction is flagged with `// PORT-NOTE:`.

// Ported from ProjectCliTests.BuildBuildsCurrentProjectFromManifest.
// PORT-NOTE: the original builds the project from Stark.toml and asserts exit 0,
// "Emitted executable:" on stdout, empty stderr, and the on-disk artifact. Manifest
// driving, the build CLI, and file-system artifacts are not expressible here; we
// verify the embedded App.stark program itself compiles.
internal fn bool BuildBuildsCurrentProjectFromManifestImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "project-cli-build-current-project-from-manifest",
        raw"""
module App

export fn i32[min max] main()
{
    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from ProjectCliTests.BuildUsesStageLocalStdlibSearchDirectory.
// PORT-NOTE: the original drops a stage-local `System.StageProbe` stdlib module on
// disk and asserts the build resolves it (exit 0, emitted executable). Stage-local
// stdlib discovery and the build CLI are not expressible here, so the imported
// `System.StageProbe` module is inlined ahead of `App` and the combined program is
// compiled.
internal fn bool BuildUsesStageLocalStdlibSearchDirectoryImpl()
{
    stack mut LlvmCompile compiled = CompileFull(
        "project-cli-build-stage-local-stdlib",
        raw"""
module System.StageProbe

public finite law i32[min max] Value()
{
    return 0;
}

import System.StageProbe
module App

export fn i32[min max] main()
{
    return System.StageProbe.Value();
}
""");
    return Succeeds(compiled);
}

