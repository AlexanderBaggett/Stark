// Ported from ProjectCliTests.TestRunsSolutionDefaultTestTargetAndPathDependencies.
internal fn bool TestRunsSolutionDefaultTestTargetAndPathDependenciesImpl()
{
    // PORT-NOTE: original writes a test solution (math library + math-tests importing
    // Math) and asserts `stark test` builds the path dependency, runs the solution
    // default test target, emits the static library / executable / package image, and
    // reports "Passed test project 'math-tests'.". The single-module helper cannot
    // supply the sibling Math module, drive the solution test target, or observe CLI
    // stdout / emitted files; reduced to compiling the math-tests root program through
    // the full pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "project-test-solution-default-test-target",
        raw"""
import Math
module MathTests

export fn i32[min max] main()
{
    if (Math.Add(3, 4) == 7)
    {
        return 0;
    }

    return 1;
}
""");
    return Succeeds(compiled);
}
