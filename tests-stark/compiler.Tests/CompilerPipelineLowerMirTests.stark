{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    // The C# test replaces the imported parse tree with an empty "module Facade";
    // the helpers cannot model that, so only the valid published library is lowered.
    stack mut LlvmCompile compiled = CompileMir(
        "lowermir-typed-body-empty-parse-tree",
        raw"""
module Facade

public record Box(i32[min max] Dummy)
{
    fn T Echo<T>(borrow Box self, T value)
    {
        return value;
    }
}

public fn T Relay<T>(Box box, T value)
{
    return box.Echo(value);
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineLowerMirTests.ManifestBackedTypedGroupedLocalDeclarationTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecialization.
internal fn bool ManifestBackedTypedGroupedLocalDeclarationTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecializationImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    stack mut LlvmCompile compiled = CompileMir(
        "lowermir-typed-grouped-local-body-bridge",
        raw"""
module Facade

public fn i32[min max] SumTo<T>(i32[min max] limit, T tag)
{
    stack mut i32[min max] total = 0, stop = limit;
    for willexit (stack mut i32[min max] index = 0, max = stop; index < max; index += 1)
    {
        total += index;
    }

    return total;
}
""");
    return Succeeds(compiled);
}

