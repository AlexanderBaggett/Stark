    // (Forward delegating to Math.Identity), publishes it to a package image, strips the untyped
    // sections to the typed interface + compiler facts + generic templates, and inspects the
    // round-tripped Forward template (a "direct-call" return whose direct call resolves to
    // Math.Identity for resolved/source/template names). It then rebuilds the package source text
    // and asserts it preserves "import Math" and the Forward signature but drops the body, writes
    // the manifest, deletes both sources, and re-imports Facade into a Demo consumer compiled
    // through "lower-mir"; it checks the LoadedModuleSet carries both Facade and Math (with a
    // non-re-export Math import on Facade) and that the consumer MIR contains
    // __stark_mono_fn_Demo__Math_Identity__i32 plus a Forward specialization that calls it.
    // Package-image construction, manifest round-tripping, package-source reconstruction,
    // multi-file resolution, loaded-module-set inspection, and per-call MIR inspection are not
    // expressible with the Stark helpers, so this is reduced to compiling the Facade library
    // program (which transitively imports Math) through the MIR-lowering stage and asserting it
    // succeeds. The Math dependency is inlined ahead of Facade so the single embedded source is
    // self-contained.
    stack mut LlvmCompile compiled = CompileMir(
        "lower-mir-manifest-transitive-import-surface-library",
        raw"""
module Math

public fn T Identity<T>(T value)
{
    return value;
}

module Facade

public fn T Forward<T>(T value)
{
    return Math.Identity(value);
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineLowerMirTests.ManifestBackedConcreteGenericAliasesMaterializeObjectInitializersAndGroupedConditionalsInMir.
internal fn bool ManifestBackedConcreteGenericAliasesMaterializeObjectInitializersAndGroupedConditionalsInMirImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library (a Box<T> struct plus an
    // IntBox = Box<i32[min max]> concrete generic alias), writes the full manifest JSON, deletes
    // the source, then re-imports Facade into a Demo consumer compiled through "lower-mir". It
    // asserts the alias materializes: Make and Choose support direct code generation, Make emits
    // an InsertField rvalue for {Value, index 0}, Choose emits exactly two such InsertField
    // rvalues, and Choose contains a Branch terminator (from the grouped ternary). Package-image
    // construction, manifest round-tripping, filesystem effects, the module resolver, and
    // per-rvalue/terminator MIR inspection are not expressible with the Stark helpers, so this is
    // reduced to compiling the consumer program (which exercises the IntBox alias via object
    // initializers and a grouped conditional) through the MIR-lowering stage and asserting it
    // succeeds. The Facade library (Box<T> + IntBox alias) is inlined ahead of the Demo consumer
    // so the single embedded source is self-contained.
    stack mut LlvmCompile compiled = CompileMir(
        "lower-mir-manifest-concrete-generic-alias-object-init-conditional",
        raw"""
module Facade

public struct Box<T>
{
    T Value;
}

public alias IntBox = Box<i32[min max]>;

module Demo

fn Facade.IntBox Make(i32[min max] value)
{
    stack Facade.IntBox box =
    {
        Value = value
    };
    return box;
}

fn Facade.IntBox Choose(bool takeLeft)
{
    stack Facade.IntBox left =
    {
        Value = 1
    };
    stack Facade.IntBox right =
    {
        Value = 2
    };
    return (takeLeft ? left : right);
}
""");
    return Succeeds(compiled);
}
