// Ported from CompilerPipelineLowerMirTests.ManifestBackedTypedNestedInitializerObjectCreationTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecialization.
internal fn bool ManifestBackedTypedNestedInitializerObjectCreationTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecializationImpl()
{
    // PORT-NOTE: The C# test publishes Facade, corrupts the Facade.Wrap template BodyText, and
    // asserts the monomorphized MIR reconstructs the nested initializer (InsertField "Item" /
    // "Values" and InsertIndex rvalues) purely from the typed body without bridge body text.
    // Package-image corruption, structured-document round-tripping, and MIR rvalue probing are
    // not expressible with the helpers, so this is reduced to compiling the published Facade
    // library program and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "lower-mir-typed-nested-initializer-object-creation-library",
        raw"""
module Facade

public struct Inner<T>
{
    T Value;
}

public struct Outer<T>
{
    Inner<T> Item;
    i32[min max][2] Values;
}

public fn Outer<T> Wrap<T>(T value, T tag)
{
    return new Outer<T>()
    {
        Item =
        {
            Value = value
        },
