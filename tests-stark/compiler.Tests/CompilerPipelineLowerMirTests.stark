// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesPreferTypedEnumCallTemplateBodiesWhenBridgeSourceIsCorrupted.
internal fn bool ManifestBackedGenericBodiesPreferTypedEnumCallTemplateBodiesWhenBridgeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes Facade, corrupts the Facade.Wrap template BodyText (so
    // the bridge returns Option<T>.None), and asserts the monomorphized MIR still constructs
    // Option<T>.Some(value) from the typed enum-constructor call body. Package-image corruption
    // and MIR rvalue probing are not expressible with the helpers, so this is reduced to
    // compiling the published Facade library program and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "lower-mir-typed-enum-call-library",
        raw"""
module Facade

public enum Option<T>
{
    None,
    Some(T),
}

public fn Option<T> Wrap<T>(T value)
{
    return Option<T>.Some(value);
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesPreferTypedTryPropagationTemplateBodiesWhenBridgeSourceIsCorrupted.
internal fn bool ManifestBackedGenericBodiesPreferTypedTryPropagationTemplateBodiesWhenBridgeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes Facade (the Facade.Pass generic with a `try` over a
    // Result<T, ParseError>), confirms the template body is published typed-only (BodyText is
    // null), and asserts the monomorphized MIR lowers the try-propagation control flow.
    // Package-image construction and typed-body / MIR probing are not expressible with the
    // helpers, so this is reduced to compiling the published Facade library program and
    // asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "lower-mir-typed-try-propagation-library",
        raw"""
module Facade

public enum ParseError
{
    Bad,
}

public enum Result<T, E>
{
    [Ok] Ok(T),
    [Err] Err(E),
}

public fn Result<T, ParseError> Pass<T>(T value, bool ok)
{
    if (ok)
    {
        stack T payload = try Result<T, ParseError>.Ok(value);
        return Result<T, ParseError>.Ok(payload);
    }

    return Result<T, ParseError>.Err(ParseError.Bad);
}
""");
    return Succeeds(compiled);
}

