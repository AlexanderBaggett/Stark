// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesPreferTypedConditionalCallStatementTemplateBodiesWhenBridgeSourceIsCorrupted.
internal fn bool ManifestBackedGenericBodiesPreferTypedConditionalCallStatementTemplateBodiesWhenBridgeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes Facade, corrupts the Facade.SelectReset template
    // BodyText to an empty body, and asserts the monomorphized MIR still contains a Branch
    // terminator plus exactly two direct-call statements to Facade.ResetValue (the
    // `chooseLeft ? ResetValue(left, 7) : ResetValue(right, 9)` conditional statement from the
    // typed body). Package-image corruption and MIR statement/terminator counting are not
    // expressible with the helpers, so this is reduced to compiling the published Facade
    // library program and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "lower-mir-typed-conditional-call-statement-library",
        raw"""
module Facade

public record ResetBox(i32[min max] Value)
{
}

public fn void ResetValue(borrow mut ResetBox box, i32[min max] next)
{
    box.Value = next;
}

public fn void SelectReset<T>(bool chooseLeft, borrow mut ResetBox left, borrow mut ResetBox right, T tag)
{
    chooseLeft ? ResetValue(left, 7) : ResetValue(right, 9);
}
""");
    return Succeeds(compiled);
}

