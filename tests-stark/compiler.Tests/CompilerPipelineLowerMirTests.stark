import CompilerTestSupport
import System.Testing
module CompilerPipelineLowerMirTests

// PORT-NOTE (applies to every Impl in this file): Each C# test builds a Facade
// library, publishes it to a package image (PackageImageBuilder), strips the
// untyped surface down to typed-interface + compiler-fact + generic-template
// sections, round-trips the manifest JSON, deletes the Facade source, then
// re-imports Facade into a Demo consumer through a FileSystem/DocumentOnly module
// resolver and lowers to MIR (StopAfterPassId "lower-mir"). The assertions then
// inspect the monomorphized MIR functions (HasBody, SupportsDirectCodeGeneration,
// Locals, Blocks/Statements/Terminators, ownership facts, etc.). The Stark test
// helpers cannot model package-image construction, manifest round-tripping,
// bridge-body-text corruption, module resolvers, filesystem effects, or MIR-node
// inspection, so each port is reduced to compiling the published Facade library
// program through the MIR-lowering stage (CompileMir) and asserting it succeeds,
// which is the precondition for any published typed template body to lower.

// Ported from CompilerPipelineLowerMirTests.ManifestBackedTypedTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecialization.
internal fn bool ManifestBackedTypedTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecializationImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    stack mut LlvmCompile compiled = CompileMir(
        "lowermir-typed-template-body-bridge",
        raw"""
module Facade

public fn T Identity<T>(T value)
{
    stack T copy = value;
    return copy;
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineLowerMirTests.ManifestBackedTypedTemplateBodiesLowerFromPackageImageFactsWhenImportedDeclarationSyntaxIsCorrupted.
internal fn bool ManifestBackedTypedTemplateBodiesLowerFromPackageImageFactsWhenImportedDeclarationSyntaxIsCorruptedImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    // The C# test corrupts the imported declaration syntax in the parse tree; the
    // helpers cannot model that, so only the valid published library is lowered.
    stack mut LlvmCompile compiled = CompileMir(
        "lowermir-typed-body-corrupted-declaration",
        raw"""
module Facade

public record Box(i32[min max] Dummy)
{
    fn T Echo<T>(borrow Box self, T value)
    {
        return value;
    }
}

public fn T Relay<T>(Box box, T value)
{
    return box.Echo(value);
}
""");
    return Succeeds(compiled);
}

