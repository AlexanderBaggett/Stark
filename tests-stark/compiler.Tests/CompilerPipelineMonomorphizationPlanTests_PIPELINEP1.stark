// Ported from CompilerPipelineMonomorphizationPlanTests.RootSimpleLocalUpdateWrapperGenericInstantiationsUseOptimizationSummaryForPlanning.
public unsafe fn bool RootSimpleLocalUpdateWrapperGenericInstantiationsUseOptimizationSummaryForPlanningImpl()
{
    unsafe
    {
        // PORT-NOTE: the original stops after "monomorphization-plan" and reads the plan's "Bump"
        // function, asserting CodeSizeHeuristic InlineSmallBody and EstimatedBodyCost > 2 (the
        // simple-local-update wrapper's optimization summary drives planning). The compile helpers
        // cannot stop after that pass nor read those per-function plan facts, so this reduces to "the
        // embedded program type-checks cleanly", program kept verbatim from the C# raw string.
