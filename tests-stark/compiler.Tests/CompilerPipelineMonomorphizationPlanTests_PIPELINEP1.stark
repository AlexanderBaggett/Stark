module Demo

fn i32[min max] ChooseSwitch<T>(i32[min max] selector, i32[min max] left, i32[min max] middle, i32[min max] right, T tag)
{
    switch (selector)
    {
        case 0:
            return left;
        case 1:
            return middle;
        default:
            return right;
    }
}

