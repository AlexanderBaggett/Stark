// Ported from CompilerPipelineMonomorphizationPlanTests.RootTerminalIfSelectionWrapperGenericInstantiationsUseOptimizationSummaryForPlanning.
public unsafe fn bool RootTerminalIfSelectionWrapperGenericInstantiationsUseOptimizationSummaryForPlanningImpl()
{
    unsafe
    {
        // PORT-NOTE: the original stops after "monomorphization-plan" and reads the plan's "ChooseBranch"
        // function, asserting CodeSizeHeuristic InlineSmallBody and EstimatedBodyCost > 2 (the
        // terminal if-selection wrapper's optimization summary drives planning). The compile helpers
        // cannot stop after that pass nor read those per-function plan facts, so this reduces to "the
        // embedded program type-checks cleanly", program kept verbatim from the C# raw string.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "monoplan-root-terminal-if-selection-wrapper-optimization-summary",
            raw"""
module Demo

fn i32[min max] ChooseBranch<T>(bool takeLeft, bool takeMiddle, i32[min max] left, i32[min max] middle, i32[min max] right, T tag)
{
    if (takeLeft)
    {
        return left;
    }
    else if (takeMiddle)
    {
        return middle;
    }
    else
    {
        return right;
    }
}

fn i32[min max] Run(bool takeLeft, bool takeMiddle, i32[min max] left, i32[min max] middle, i32[min max] right)
{
    return ChooseBranch(takeLeft, takeMiddle, left, middle, right, right);
}
""");
        return Succeeds(compiled);
    }
}

