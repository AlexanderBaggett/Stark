import CompilerTestSupport
import System.Testing

module CompilerPipelineFullIntegrationTests_PARSE_ERRP1

// Ported from CompilerPipelineFullIntegrationTests.ParseErrorsPreventLaterPassesFromRunning.
public unsafe fn bool ParseErrorsPreventLaterPassesFromRunningImpl()
{
    unsafe
    {
        // PORT-NOTE: original asserts result.Succeeded is false, a STK1000 diagnostic is present,
        // the SyntaxModel artifact was never produced, only the first pass Executed while every
        // later pass was Skipped, and a "pass-skipped" warning log was emitted for stage
        // "syntax-model". Pass execution status, artifact presence, and pipeline lifecycle logs
        // are not expressible via the compile helpers, so this reduces to "the embedded program
        // fails the full pipeline with the STK1000 parse diagnostic" (the parse-error signal).
        stack mut LlvmCompile compiled = CompileFull(
            "parse-errors-prevent-later-passes-from-running",
            raw"""
public fn void Run();
""");
        return FailsWithDiagnostic(compiled, "STK1000");
    }
}
