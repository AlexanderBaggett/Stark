}

// Ported from CompilerPipelineLowerMirTests.ManifestBackedTypedAddressOfTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecialization.
public unsafe fn bool ManifestBackedTypedAddressOfTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecializationImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    stack mut LlvmCompile compiled = CompileMir(
        "lowermir-typed-address-of-body-bridge",
        raw"""
module Facade

public record Buffer(i32[min max] First, i32[min max][4] Values)
{
}

public unsafe fn i32[min max] Observe<T>(i32[min max] value, T tag)
{
    stack mut i32[min max][4] data =
    {
        1, 2, 3, 4
    };
    stack mut Buffer buffer =
    {
        First = value, Values = data
    };
    stack rawmutptr<i32[min max]> firstPtr = &buffer.First;
    stack rawmutptr<i32[min max]> slotPtr = &buffer.Values[2];
    stack rawmutptr<i32[min max]> aliasPtr = &*slotPtr;
    return *aliasPtr = *firstPtr + value;
}
""");
    return Succeeds(compiled);
}

