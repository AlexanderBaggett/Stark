// Ported from CompilerPipelineLowerMirTests.ManifestBackedTypedLoopControlTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecialization.
public unsafe fn bool ManifestBackedTypedLoopControlTemplateBodiesDoNotRequireBridgeBodyTextForImportedGenericSpecializationImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    stack mut LlvmCompile compiled = CompileMir(
        "lowermir-typed-loop-control-body-bridge",
        raw"""
module Facade

public fn i32[min max] SumForControl<T>(i32[min max] count, i32[min max] stopAt, T tag)
{
    stack mut i32[min max] sum = 0;
    for willexit (stack mut i32[min max] index = 0; index < count; index = index + 1)
    {
        if (index < 2)
        {
            continue;
        }
        if (index == stopAt)
        {
            break;
        }
        sum = sum + index;
    }
    return sum;
}
""");
    return Succeeds(compiled);
}

