// Ported from CompilerPipelineLowerMirTests.ManifestBackedTypedPatternConditionTemplateBodiesPublishAndImportForGenericSpecialization.
public unsafe fn bool ManifestBackedTypedPatternConditionTemplateBodiesPublishAndImportForGenericSpecializationImpl()
{
    // PORT-NOTE: reduced to lowering the published Facade library (see file header).
    stack mut LlvmCompile compiled = CompileMir(
        "lowermir-typed-pattern-condition-body-bridge",
        raw"""
module Facade

public enum Step<T>
{
    More(i32[min max]),
    Done
}

public fn i32[min max] Classify<T>(Step<T> step, T tag)
{
    if (step is Step<T>.More(var first))
    {
        return first;
    }

    while willexit (step is Step<T>.More(var value))
    {
        return value;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}

