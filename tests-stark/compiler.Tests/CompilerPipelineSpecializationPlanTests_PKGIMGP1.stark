import CompilerTestSupport
import System.Testing

module CompilerPipelineSpecializationPlanTests_PKGIMGP1

// Ported from CompilerPipelineSpecializationPlanTests.ManifestBackedImportedLawGenericsPreferCallerCloneWhenTemplateSemanticsSurviveWithoutFunctionSemantics.
public unsafe fn bool ManifestBackedImportedLawGenericsPreferCallerCloneWhenTemplateSemanticsSurviveWithoutFunctionSemanticsImpl()
{
    unsafe
    {
        // PORT-NOTE: The C# test builds the `Math.Numbers.AddTag` doctrine-law-generic
        // library into a package image via PackageImageBuilder.Create, rewrites the manifest
        // to strip FunctionSemantics (so only the typed interface + template semantics
        // survive), asserts the Math module's EffectiveCompilerFacts.FunctionSemantics is now
        // empty, writes the .starkpkg.json manifest, deletes the Math source, then re-imports
        // `Math` into a `Demo` consumer (StopAfterPassId "specialization-plan") and probes the
        // imported PackageImageFacts (Math.Numbers.AddTag template semantics with empty
        // CalledFunctions) and the SpecializationPlan (single function with SelectionOrder
        // [LawCallerSpecializedClone, OwnedConcreteBody, DirectAbiBoundaryFallback] and
        // CodeGenerationMode CallerSpecializedClone). Package-image construction, manifest
        // FunctionSemantics stripping/round-tripping, source deletion, and
        // PackageImageFacts/SpecializationPlan probing are not expressible with the Stark
        // helpers, so this is reduced to compiling the `Demo` consumer with the `Math`
        // library available as a sibling source module through type-check and asserting it
        // succeeds (the precondition for the imported law generic to be planned at all).
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "spec-plan-manifest-law-generic-template-semantics",
            raw"""
import Math
module Demo

law i32[min max] Run(i32[min max] left, i32[min max] right)
{
    return Math.Numbers.AddTag(left, right, left);
}
""",
            "",
            "Math.stark",
            raw"""
module Math

public doctrine Numbers
{
    law i32[min max] AddTag<T>(i32[min max] left, i32[min max] right, T tag)
    {
        return left + right;
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSpecializationPlanTests.ManifestBackedImportedPlainFnGenericsThatStrengthenToLawPreferCallerCloneWhenTemplateSemanticsSurviveWithoutFunctionSemantics.
public unsafe fn bool ManifestBackedImportedPlainFnGenericsThatStrengthenToLawPreferCallerCloneWhenTemplateSemanticsSurviveWithoutFunctionSemanticsImpl()
{
    unsafe
    {
        // PORT-NOTE: The C# test builds the `Math.AddTag` plain-fn-generic library into a
        // package image, rewrites the manifest to strip FunctionSemantics, writes the
        // .starkpkg.json manifest, deletes the Math source, then re-imports `Math` into a
        // `Demo` consumer (StopAfterPassId "specialization-plan") and probes the imported
        // PackageImageFacts (Math.AddTag template semantics DeclaredKind == Fn,
        // EffectiveKind == FiniteLaw -- the plain fn strengthens to a law), the
        // SpecializationPlan (single function with SelectionOrder [LawCallerSpecializedClone,
        // OwnedConcreteBody, DirectAbiBoundaryFallback] and CodeGenerationMode
        // CallerSpecializedClone), and the FunctionEffects artifact (Math.AddTag Kind
        // FiniteLaw, IsPure/NoSync/NoFree/WillReturn/MustProgress all true). Package-image
        // construction, manifest FunctionSemantics stripping/round-tripping, source deletion,
        // and PackageImageFacts/SpecializationPlan/FunctionEffects probing are not expressible
        // with the Stark helpers, so this is reduced to compiling the `Demo` consumer with the
        // `Math` library available as a sibling source module through type-check and asserting
        // it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "spec-plan-manifest-plain-fn-strengthen-to-law",
            raw"""
import Math
module Demo

law i32[min max] Run(i32[min max] left, i32[min max] right)
{
    return Math.AddTag(left, right, left);
}
""",
            "",
            "Math.stark",
            raw"""
module Math

public fn i32[min max] AddTag<T>(i32[min max] left, i32[min max] right, T tag)
{
    return left + right;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSpecializationPlanTests.ManifestBackedRecursiveImportedLawGenericsDoNotPreferCallerCloneWhenTemplateSemanticsSurviveWithoutFunctionSemantics.
public unsafe fn bool ManifestBackedRecursiveImportedLawGenericsDoNotPreferCallerCloneWhenTemplateSemanticsSurviveWithoutFunctionSemanticsImpl()
{
    unsafe
    {
        // PORT-NOTE: The C# test builds the recursive `Math.Numbers.CountDown` doctrine-law
        // generic library into a package image, rewrites the manifest to strip
        // FunctionSemantics, writes the .starkpkg.json manifest, deletes the Math source, then
        // re-imports `Math` into a `Demo` consumer (StopAfterPassId "specialization-plan") and
        // probes the imported PackageImageFacts (Math.Numbers.CountDown template semantics
        // CalledFunctions contains "Math.Numbers.CountDown" -- it is self-recursive) and the
        // SpecializationPlan (single function whose SelectionOrder does NOT contain
        // LawCallerSpecializedClone and whose CodeGenerationMode is SingleOwnerConcreteBody --
        // recursion blocks the caller-specialized clone). Package-image construction, manifest
        // FunctionSemantics stripping/round-tripping, source deletion, and
        // PackageImageFacts/SpecializationPlan probing are not expressible with the Stark
        // helpers, so this is reduced to compiling the `Demo` consumer with the recursive
        // `Math` library available as a sibling source module through type-check and asserting
        // it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "spec-plan-manifest-recursive-law-generic",
            raw"""
import Math
module Demo

law i32[min max] Run(i32[min max] value)
{
    return Math.Numbers.CountDown(value, value);
}
""",
            "",
            "Math.stark",
            raw"""
module Math

public doctrine Numbers
{
    law i32[min max] CountDown<T>(i32[min max] value, T tag)
    {
        if (value == 0)
        {
            return 0;
        }

        return Numbers.CountDown(value - 1, tag);
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSpecializationPlanTests.DeclarationOnlyImportedGenericInstantiationsFallBackToAbiOnlySpecializationPlan.
public unsafe fn bool DeclarationOnlyImportedGenericInstantiationsFallBackToAbiOnlySpecializationPlanImpl()
{
    unsafe
    {
        // PORT-NOTE: The C# test builds the declaration-only `Facade.Identity<T>` library
        // (a body-less manifest signature) into a package image, writes the .starkpkg.json
        // manifest, then re-imports `Facade` into a `Demo` consumer (StopAfterPassId
        // "specialization-plan") and probes the SpecializationPlan (single function with
        // SelectionOrder [DirectAbiBoundaryFallback] only and CodeGenerationMode
        // AbiBoundaryOnly -- with no published body the plan can only cross the ABI boundary).
        // Package-image construction, manifest round-tripping, and SpecializationPlan probing
        // are not expressible with the Stark helpers, so this is reduced to compiling the
        // `Demo` consumer with the declaration-only `Facade` library available as a sibling
        // source module through type-check and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "spec-plan-manifest-declaration-only-abi-fallback",
            raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return Facade.Identity(value);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn T Identity<T>(T value);
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSpecializationPlanTests.ManifestBackedImportedGenericsWithoutPublishedAbiFactsPreferOwnedBodyOnlyInSpecializationPlan.
public unsafe fn bool ManifestBackedImportedGenericsWithoutPublishedAbiFactsPreferOwnedBodyOnlyInSpecializationPlanImpl()
{
    unsafe
    {
        // PORT-NOTE: The C# test builds the `Facade.Identity<T>` library (with a body) into a
        // package image, asserts the Facade module's CompilerFacts.AbiFunctions is non-null,
        // rewrites the manifest to strip AbiFunctions (empty), writes the .starkpkg.json
        // manifest, then re-imports `Facade` into a `Demo` consumer (StopAfterPassId
        // "specialization-plan") and probes the SpecializationPlan (single function with
        // SelectionOrder [LawCallerSpecializedClone, OwnedConcreteBody] -- no
        // DirectAbiBoundaryFallback because the ABI facts were stripped -- and
        // CodeGenerationMode CallerSpecializedClone). Package-image construction, manifest
        // AbiFunctions stripping/round-tripping, and SpecializationPlan probing are not
        // expressible with the Stark helpers, so this is reduced to compiling the `Demo`
        // consumer with the `Facade` library available as a sibling source module through
        // type-check and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "spec-plan-manifest-no-abi-facts-owned-body",
            raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return Facade.Identity(value);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn T Identity<T>(T value)
{
    return value;
}
""");
        return Succeeds(compiled);
    }
}
