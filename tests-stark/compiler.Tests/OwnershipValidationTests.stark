internal fn bool ArenaBorrowsCannotBePassedToRetainingParametersImpl()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-arena-retaining-param",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn void Retain(storeborrow Box box);

fn void Bad()
{
    arena Box box = new Box()
    {
        Value = 1
    };
    Retain(box);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4202", "callee may retain")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4202", "arena storage for 'box' is here") >= 1;
    }
}

internal fn bool ArenaPointersCannotBeStoredInHeapStorageImpl()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-arena-heap-storage",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

struct Holder
{
    rawptr<Box> Ptr;
}

unsafe fn void Bad()
{
    heap mut Holder holder = new Holder()
    {
        Ptr = null
    };
    arena Box box = new Box()
    {
        Value = 1
    };
    holder.Ptr = &box;
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4202", "heap storage 'holder'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4202", "arena storage for 'box' is here") >= 1;
    }
}

internal fn bool ArenaPointersCannotBeStoredInStaticStorageImpl()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-arena-static-storage",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

static mut rawptr<Box> Saved = null;

unsafe fn void Bad()
{
    arena Box box = new Box()
    {
        Value = 1
    };
    Saved = &box;
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4202", "global or static storage 'Saved'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4202", "arena storage for 'box' is here") >= 1;
    }
}

internal fn bool ArenaBorrowsCanBePassedToNonRetainingBorrowParametersImpl()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-arena-nonretaining-param",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

finite law i32[min max] Read(borrow Box box)
{
    return box.Value;
}

fn i32[min max] Run()
{
    arena Box box = new Box()
    {
        Value = 2
    };
    return Read(box);
}
""");
        return Succeeds(compiled);
    }
}

internal fn bool ArenaReadCapturesCannotBeRetainedInHeapClosuresImpl()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-arena-heap-read-capture",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn heap closure<fn i32[min max]()> Bad()
{
    arena Box box = new Box()
    {
        Value = 1
    };
    return heap capture(read box) () => box.Value;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Heap closure capture mode 'read'");
    }
}
