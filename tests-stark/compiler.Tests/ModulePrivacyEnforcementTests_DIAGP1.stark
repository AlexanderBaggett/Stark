import CompilerTestSupport
import System.Testing

module ModulePrivacyEnforcementTests_DIAGP1

// Ported from ModulePrivacyEnforcementTests.SiblingCallingModulePrivateFunctionIsRejected.
public unsafe fn bool SiblingCallingModulePrivateFunctionIsRejectedImpl()
{
    // PORT-NOTE: The C# RunApp writes the LibrarySource to Demo/Lib.stark and the
    // app source as the root program, wiring them with a FileSystemModuleResolver.
    // CompileTypeCheckWithModule mirrors that exactly (root source + one sibling
    // module file under the "Demo" subdirectory as "Lib.stark"). The C# asserts
    // result.Succeeded == false plus an STK3015 diagnostic whose message contains
    // both "Demo.Lib.Secret" and "not visible from module 'Demo.App'"; that is
    // expressed by FailsWithDiagnosticMessage on the code and the two fragments.
    stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
        "diagp1-sibling-calling-module-private-function-rejected",
        raw"""
import Demo.Lib
module Demo.App
export fn i32[min max] main()
{
    return Demo.Lib.Secret();
}
""",
        "Demo",
        "Lib.stark",
        raw"""
module Demo.Lib

public fn i32[min max] Shared()
{
    return 1;
}

internal fn i32[min max] PackageHelper()
{
    return 2;
}

fn i32[min max] Secret()
{
    return 3;
}

// Same-module access to a module-private member must still compile.
public fn i32[min max] UseOwnSecret()
{
    return Secret();
}

public const SharedNumber = 7;

const SecretNumber = 99;

struct HiddenType
{
    i32[min max] value;
}

public struct OpenType
{
    i32[min max] value;
}
""");
    return FailsWithDiagnosticMessage(compiled, "STK3015", "Demo.Lib.Secret")
        && AnyDiagnosticMessageContains(compiled, "not visible from module 'Demo.App'");
}

// Ported from ModulePrivacyEnforcementTests.SiblingCallingPublicFunctionSucceeds.
public unsafe fn bool SiblingCallingPublicFunctionSucceedsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
        "diagp1-sibling-calling-public-function-succeeds",
        raw"""
import Demo.Lib
module Demo.App
export fn i32[min max] main()
{
    return Demo.Lib.Shared();
}
""",
        "Demo",
        "Lib.stark",
        raw"""
module Demo.Lib

public fn i32[min max] Shared()
{
    return 1;
}

internal fn i32[min max] PackageHelper()
{
    return 2;
}

fn i32[min max] Secret()
{
    return 3;
}

// Same-module access to a module-private member must still compile.
public fn i32[min max] UseOwnSecret()
{
    return Secret();
}

public const SharedNumber = 7;

const SecretNumber = 99;

struct HiddenType
{
    i32[min max] value;
}

public struct OpenType
{
    i32[min max] value;
}
""");
    return Succeeds(compiled);
}

