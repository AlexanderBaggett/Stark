import CompilerTestSupport
import System.Testing

module DiagnosticRegressionTests_DIAGP1

// Ported from DiagnosticRegressionTests.WhereDoctrinePredicateExplainsDoctrineMisuse.
public unsafe fn bool WhereDoctrinePredicateExplainsDoctrineMisuseImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-where-doctrine-predicate-explains-misuse",
        raw"""
module Demo

fn void F<T>(T value) where DictionaryKey(T)
{
    return;
}
""");
    // PORT-NOTE: original asserts result.Succeeded == false plus a single
    // STK3050 diagnostic whose message contains all four fragments; reduced to
    // requiring each fragment to be present on a STK3050 diagnostic.
    return CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "'DictionaryKey' is a doctrine, not a `where` law predicate") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "DictionaryKey.Equals(a, b)") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "Supported `where` laws are Transferable and Shareable") > 0;
}

// Ported from DiagnosticRegressionTests.WhereUnknownLawPredicateKeepsOriginalMessage.
public unsafe fn bool WhereUnknownLawPredicateKeepsOriginalMessageImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-where-unknown-law-predicate-keeps-message",
        raw"""
module Demo

fn void F<T>(T value) where Bogus(T)
{
    return;
}
""");
    // PORT-NOTE: original asserts result.Succeeded == false plus a single
    // STK3050 diagnostic whose message contains both fragments; reduced to
    // requiring each fragment to be present on a STK3050 diagnostic.
    return CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "Unknown thread-safety law predicate 'Bogus'") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "Supported laws are Transferable and Shareable") > 0;
}
