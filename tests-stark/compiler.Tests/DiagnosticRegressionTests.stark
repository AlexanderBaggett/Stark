import CompilerTestSupport
import System.Testing
module DiagnosticRegressionTests

// Ported from DiagnosticRegressionTests.WhereDoctrinePredicateExplainsDoctrineMisuse.
internal fn bool WhereDoctrinePredicateExplainsDoctrineMisuseImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-where-doctrine-predicate-explains-misuse",
        raw"""
module Demo

fn void F<T>(T value) where DictionaryKey(T)
{
    return;
}
""");
    // PORT-NOTE: original asserts result.Succeeded == false plus a single
    // STK3050 diagnostic whose message contains all four fragments; reduced to
    // requiring each fragment to be present on a STK3050 diagnostic.
    return CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "'DictionaryKey' is a doctrine, not a `where` law predicate") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "DictionaryKey.Equals(a, b)") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "Supported `where` laws are Transferable and Shareable") > 0;
}

// Ported from DiagnosticRegressionTests.WhereUnknownLawPredicateKeepsOriginalMessage.
internal fn bool WhereUnknownLawPredicateKeepsOriginalMessageImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-where-unknown-law-predicate-keeps-message",
        raw"""
module Demo

fn void F<T>(T value) where Bogus(T)
{
    return;
}
""");
    // PORT-NOTE: original asserts result.Succeeded == false plus a single
    // STK3050 diagnostic whose message contains both fragments; reduced to
    // requiring each fragment to be present on a STK3050 diagnostic.
    return CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "Unknown thread-safety law predicate 'Bogus'") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3050", "Supported laws are Transferable and Shareable") > 0;
}

// Ported slice of tests/compiler.Tests/DiagnosticRegressionTests.cs.
//
// Both originals embed a Stark source string, Compile() it, assert the compile
// failed, and assert on the STK3002 "borrowed parameter argument must be an
// addressable storage location" diagnostic. These are ownership/borrow semantic
// checks, so each program is routed through CompileTypeCheck.

// Ported from DiagnosticRegressionTests.BorrowedGenericParameterLiteralArgumentHintsByValueCopyableFix.
internal fn bool BorrowedGenericParameterLiteralArgumentHintsByValueCopyableFixImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-borrowed-generic-literal-copyable-hint",
            raw"""
module Demo

fn void F<T>(borrow T x)
{
    return;
}

fn void Run()
{
    F(1);
    return;
}
""");
        // Original asserts STK3002 with three message fragments. The host helper
        // checks one fragment per call, so AND the three together. The third
        // fragment is the by-value Copyable(T) fix hint.
        return FailsWithDiagnosticMessage(compiled, "STK3002", "must be an addressable storage location")
            && AnyDiagnosticMessageContains(compiled, "borrows from it")
            && AnyDiagnosticMessageContains(compiled, "declaring it by value as `T` under `where Copyable(T)` lets callers pass a literal");
    }
}

// Ported from DiagnosticRegressionTests.BorrowedConcreteParameterLiteralArgumentDoesNotHintGenericFix.
internal fn bool BorrowedConcreteParameterLiteralArgumentDoesNotHintGenericFixImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-borrowed-concrete-literal-no-generic-hint",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn void F(borrow Box x)
{
    return;
}

fn void Run()
{
    F(new Box()
    {
        Value = 1
    });
    return;
}
""");
        // Original asserts STK3002 fires with the addressable/borrow message, but
        // that NO STK3002 diagnostic contains the generic `where Copyable(T)` hint
        // (a concrete `Box` parameter cannot offer the by-value generic fix). The
        // DoesNotContain assertion is expressed as a zero count of STK3002
        // diagnostics whose message mentions the generic Copyable(T) hint.
        return FailsWithDiagnosticMessage(compiled, "STK3002", "must be an addressable storage location")
            && AnyDiagnosticMessageContains(compiled, "borrows from it")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "where Copyable(T)") == 0;
    }
}

// Ported slice of tests/compiler.Tests/DiagnosticRegressionTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold.

// Ported from DiagnosticRegressionTests.CallingAFieldThatShadowsASameNamedMethodNamesTheShadow.
internal fn bool CallingAFieldThatShadowsASameNamedMethodNamesTheShadowImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-field-shadows-same-named-method",
            raw"""
module Demo

struct Extents
{
    bool HasExtension;

    unsafe finite law bool HasExtension(borrow Extents self)
    {
        return true;
    }
}

unsafe fn bool Run(Extents value)
{
    return value.HasExtension();
}
""");

        // Original asserts: !Succeeded and STK3008 whose message contains the
        // fragments "is not callable", "shadows", and "HasExtension".
        return FailsWithDiagnostic(compiled, "STK3008")
            && AnyDiagnosticMessageContains(compiled, "is not callable")
            && AnyDiagnosticMessageContains(compiled, "shadows")
            && AnyDiagnosticMessageContains(compiled, "HasExtension");
    }
}
