import CompilerTestSupport
import System.Testing

module DiagnosticRegressionTests_TYPECHKP1

// Ported slice of tests/compiler.Tests/DiagnosticRegressionTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold.

// Ported from DiagnosticRegressionTests.CallingAFieldThatShadowsASameNamedMethodNamesTheShadow.
public unsafe fn bool CallingAFieldThatShadowsASameNamedMethodNamesTheShadowImpl()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typechkp1-field-shadows-same-named-method",
            raw"""
module Demo

struct Extents
{
    bool HasExtension;

    unsafe finite law bool HasExtension(borrow Extents self)
    {
        return true;
    }
}

unsafe fn bool Run(Extents value)
{
    return value.HasExtension();
}
""")

        // Original asserts: !Succeeded and STK3008 whose message contains the
        // fragments "is not callable", "shadows", and "HasExtension".
        return FailsWithDiagnostic(compiled, "STK3008")
            and AnyDiagnosticMessageContains(compiled, "is not callable")
            and AnyDiagnosticMessageContains(compiled, "shadows")
            and AnyDiagnosticMessageContains(compiled, "HasExtension")
    }
}
