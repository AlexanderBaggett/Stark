// Ported from TypeCheckingTests.TargetTypedObjectCreationRequiresNamedDestinationType.
public unsafe fn bool TargetTypedObjectCreationRequiresNamedDestinationTypeImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-target-typed-new-named-dest",
        raw"""
module Demo

fn void MissingTarget()
{
    new();
}

fn void NonNamedTarget()
{
    stack i32[min max] value = new();
}
""");
    return FailsWithDiagnostic(compiled, "STK3002")
        && AnyDiagnosticMessageContains(compiled, "requires an expected named target type")
        && AnyDiagnosticMessageContains(compiled, "requires a named target type")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "i32") > 0;
