// Ported from TypeCheckingTests.DynamicStorageReserveRequiresMutableOwnerAndNonNegativeAdditionalCapacity.
public unsafe fn bool DynamicStorageReserveRequiresMutableOwnerAndNonNegativeAdditionalCapacityImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-dynamic-reserve-mutable-nonneg",
        raw"""
module Demo

fn void ImmutableOwner()
{
    stack dynamic i32[0 max] values = new(4);
    values.Reserve(8);
}

fn void NegativeAdditionalCapacity()
{
    stack mut dynamic i32[0 max] values = new(4);
    values.Reserve(-1);
}
""");
    return !Succeeds(compiled)
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3007", "Cannot assign to immutable local 'values'") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "must be provably non-negative") > 0;
}

// Ported from TypeCheckingTests.DynamicStorageMoveLastRequiresMutableOwnerAndNoArguments.
public unsafe fn bool DynamicStorageMoveLastRequiresMutableOwnerAndNoArgumentsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-dynamic-movelast-mutable-noargs",
        raw"""
module Demo

fn void ImmutableOwner()
{
    stack dynamic i32[0 max] values = new(1);
    values.MoveLast();
}

fn void ExtraArgument()
{
    stack mut dynamic i32[0 max] values = new(1);
    values.MoveLast(1);
}
""");
    return !Succeeds(compiled)
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3007", "Cannot assign to immutable local 'values'") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3009", "MoveLast expects no arguments") > 0;
}

// Ported from TypeCheckingTests.DynamicStorageMoveAtRequiresMutableOwnerOneIntegerArgument.
public unsafe fn bool DynamicStorageMoveAtRequiresMutableOwnerOneIntegerArgumentImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-dynamic-moveat-mutable-one-int",
        raw"""
module Demo

fn void ImmutableOwner()
{
    stack dynamic i32[0 max] values = new(1);
    values.MoveAt(0);
}

fn void MissingArgument()
{
    stack mut dynamic i32[0 max] values = new(1);
    values.MoveAt();
}

fn void ExtraArgument()
{
    stack mut dynamic i32[0 max] values = new(1);
    values.MoveAt(0, 1);
}

fn void NonIntegerIndex(bool flag)
{
    stack mut dynamic i32[0 max] values = new(1);
    values.MoveAt(flag);
}

fn void NegativeIndex()
{
    stack mut dynamic i32[0 max] values = new(1);
    values.MoveAt(-1);
}
""");
    return !Succeeds(compiled)
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3007", "Cannot assign to immutable local 'values'") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3009", "MoveAt expects one index argument but received 0") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3009", "MoveAt expects one index argument but received 2") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "MoveAt index must be an integer") > 0
        && AnyDiagnosticMessageContains(compiled, "bool")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "MoveAt index must be provably non-negative") > 0;
}

// Ported from TypeCheckingTests.DynamicStorageReserveOperationsRequireMutableOwnerAndOneIntegerArgument.
public unsafe fn bool DynamicStorageReserveOperationsRequireMutableOwnerAndOneIntegerArgumentImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-dynamic-reserve-ops-mutable-one-int",
        raw"""
module Demo

fn void ReserveImmutableOwner()
{
    stack dynamic i32[0 max] values = new(1);
    values.Reserve(1);
}

fn void ReserveMissingArgument()
{
    stack mut dynamic i32[0 max] values = new(1);
    values.Reserve();
}

fn void TryReserveExtraArgument()
{
    stack mut dynamic i32[0 max] values = new(1);
    values.TryReserve(1, 2);
}

fn void TryReserveCapacityNonInteger(bool flag)
{
    stack mut dynamic i32[0 max] values = new(1);
    values.TryReserveCapacity(flag);
}
""");
    return !Succeeds(compiled)
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3007", "Cannot assign to immutable local 'values'") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3009", "Reserve expects one additional-capacity argument but received 0") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3009", "TryReserve expects one additional-capacity argument but received 2") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "TryReserveCapacity target capacity must be an integer") > 0
        && AnyDiagnosticMessageContains(compiled, "bool");
}

