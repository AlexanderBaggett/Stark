import CompilerTestSupport
import System.Testing

module TypeCheckingTests_DIAGP2

// Ported slice of tests/compiler.Tests/TypeCheckingTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold. PORT-NOTE comments flag assertions the helpers
// cannot express (TypeCheckModel artifact inspection, AddressTakenFunctions
// emptiness, multi-module in-memory resolution, monomorphization-plan stop
// pass, EnforceIntegerRangeStorageRules option) that were reduced to the
// nearest signal.

// Ported from TypeCheckingTests.UnsafeFunctionItemsDoNotPromoteInReturnOrArgumentTargetPositions.
public unsafe fn bool UnsafeFunctionItemsDoNotPromoteInReturnOrArgumentTargetPositionsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-unsafe-fn-no-promote",
        raw"""
module Demo

unsafe fn i32[min max] Touch()
{
    return 1;
}

fn fnptr<fn i32[min max]()> Factory()
{
    return Touch;
}

fn void Register(fnptr<fn i32[min max]()> callback)
{
    return;
}

fn void Run()
{
    Register(Touch);
    return;
}
""");
    // PORT-NOTE: original also asserts the TypeCheckModel artifact exists with
    // empty AddressTakenFunctions; reduced to requiring the failure plus at
    // least two STK3024 diagnostics carrying the promotion message.
    return !Succeeds(compiled)
        && AnyDiagnosticMessageContains(compiled, "cannot be promoted to ordinary function pointer")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3024", "cannot be promoted to ordinary function pointer") >= 2;
}

// Ported from TypeCheckingTests.StrictIntegerRangesRejectExplicitScalarConstWrongWidthOrSign.
public unsafe fn bool StrictIntegerRangesRejectExplicitScalarConstWrongWidthOrSignImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-strict-int-explicit-const",
        raw"""
module Demo

const i32 PositiveSigned = 80;
const u32 PositiveWide = 80;
const i32 NegativeWide = -1;
const u8 CorrectUnsigned = 255;
const i8 CorrectSigned = -1;
""");
    // PORT-NOTE: original sets EnforceIntegerRangeStorageRules: true (no helper
    // option) and also asserts no diagnostics mention CorrectUnsigned/CorrectSigned;
    // reduced to requiring the three STK3014 width/sign diagnostics.
    return CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "PositiveSigned") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "PositiveWide") > 0
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "NegativeWide") > 0;
}

// Ported from TypeCheckingTests.ScalarConstDeclarationsReportFriendlyNumericTypeDiagnostics.
public unsafe fn bool ScalarConstDeclarationsReportFriendlyNumericTypeDiagnosticsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-scalar-const-friendly-diags",
        raw"""
module Demo

const i32[min max] Ranged = 80;
const i8 TooSmall = 200;
const f32 TooPrecise = 0.1;
""");
    return !Succeeds(compiled)
        && AnyDiagnosticMessageContains(compiled, "already has one exact value")
        && AnyDiagnosticMessageContains(compiled, "does not need an integer range")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "TooSmall") > 0
        && AnyDiagnosticMessageContains(compiled, "does not fit in i8")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "TooPrecise") > 0
        && AnyDiagnosticMessageContains(compiled, "without changing it");
}

// Ported from TypeCheckingTests.HugeCompileTimeIntegerConstCannotBecomeRuntimeStorage.
public unsafe fn bool HugeCompileTimeIntegerConstCannotBecomeRuntimeStorageImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-huge-comptime-const-storage",
        raw"""
module Demo

const Huge = 2 ** 1024;
""");
    return FailsWithDiagnostic(compiled, "STK3013")
        && AnyDiagnosticMessageContains(compiled, "Type 'integer' is compile-time-only")
        && AnyDiagnosticMessageContains(compiled, "a global constant type");
}

// Ported from TypeCheckingTests.HugeCompileTimeIntegerConversionReportsConcreteTargetOverflow.
public unsafe fn bool HugeCompileTimeIntegerConversionReportsConcreteTargetOverflowImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp2-huge-comptime-conversion-overflow",
        raw"""
module Demo

unsafe finite law i1024[min max] Run()
{
    return (i1024[min max])(2 ** 1024);
}
""");
    return FailsWithDiagnostic(compiled, "STK3002")
        && AnyDiagnosticMessageContains(compiled, "Compile-time integer value")
        && AnyDiagnosticMessageContains(compiled, "does not fit in 'i1024'");
}

// Ported from TypeCheckingTests.DictionaryRejectsUnprovenKeyTypes.
public unsafe fn bool DictionaryRejectsUnprovenKeyTypesImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
        "diagp2-dict-rejects-unproven-key",
        raw"""
import System.Collections
module Demo

struct Box
{
    i32[0 max] Value;
}

fn void Use(Dictionary<Box, i32[0 max]> boxes)
{
    return;
}
""",
        "System",
        "Collections.stark",
        raw"""
module System.Collections

public struct Dictionary<K, V>
{
    K Key;
    V Value;
}
""");
    return FailsWithDiagnostic(compiled, "STK3023")
        && AnyDiagnosticMessageContains(compiled, "Dictionary<Box, V> collection use")
        && AnyDiagnosticMessageContains(compiled, "Dictionary key type 'Box'")
        && AnyDiagnosticMessageContains(compiled, "System.Collections.DictionaryKey<Box>");
}

