}

fn void Use(HashSet<Box> symbols)
{
    return;
}
""",
        "System",
        "Collections.stark",
        raw"""
module System.Collections

public struct HashSet<T>
{
    T Key;
}
""");
    return FailsWithDiagnostic(compiled, "STK3023")
