// Ported from TypeCheckingTests.InitSliceElementsAreWriteOnlyUntilInitialized.
public unsafe fn bool InitSliceElementsAreWriteOnlyUntilInitializedImpl()
{
    stack mut LlvmCompile good = CompileTypeCheck(
        "diagp2-init-slice-write-only-good",
        raw"""
module Demo

fn void Fill(init i32[0 max][] destination, i32[0 max] value)
{
    init destination[0] = value;
}
""");

    stack mut LlvmCompile bad = CompileTypeCheck(
        "diagp2-init-slice-write-only-bad",
        raw"""
module Demo

fn i32[0 max] Read(init i32[0 max][] destination)
{
    return destination[0];
}
""");

    return Succeeds(good)
        && FailsWithDiagnostic(bad, "STK3002")
        && AnyDiagnosticMessageContains(bad, "found 'init i32");
}
