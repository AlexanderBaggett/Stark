}

// Ported from TypeCheckingTests.DictionaryRejectsStaticHashEqualsContractWithoutOverlap.
public unsafe fn bool DictionaryRejectsStaticHashEqualsContractWithoutOverlapImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
        "diagp2-dict-contract-without-overlap",
        raw"""
import System.Collections
module Demo

struct Symbol
{
    u32[0 max] Id;

    static finite law u64[0 max] Hash(borrow Symbol value)
    {
        return (u64[0 max])value.Id;
    }

    static finite law bool Equals(borrow Symbol left, borrow Symbol right)
    {
        return left.Id == right.Id;
    }
}

fn void Use(Dictionary<Symbol, i32[0 max]> symbols)
{
    return;
}
""",
        "System",
        "Collections.stark",
        raw"""
module System.Collections

public struct Dictionary<K, V>
{
    K Key;
    V Value;
}
""");
    return FailsWithDiagnostic(compiled, "STK3023")
        && AnyDiagnosticMessageContains(compiled, "Incompatible Equals contract method")
        && AnyDiagnosticMessageContains(compiled, "where overlap(left, right)");
}

// Ported from TypeCheckingTests.DictionaryRejectsStaticHashEqualsContractWithWrongHashReturn.
public unsafe fn bool DictionaryRejectsStaticHashEqualsContractWithWrongHashReturnImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
        "diagp2-dict-contract-wrong-hash-return",
        raw"""
import System.Collections
module Demo

struct Symbol
{
    u32[0 max] Id;

    static finite law i64[min max] Hash(borrow Symbol value)
    {
        return (i64[min max])value.Id;
    }

    static finite law bool Equals(borrow Symbol left, borrow Symbol right)
        where overlap(left, right)
    {
        return left.Id == right.Id;
    }
}

fn void Use(Dictionary<Symbol, i32[0 max]> symbols)
{
    return;
}
""",
        "System",
        "Collections.stark",
        raw"""
module System.Collections

public struct Dictionary<K, V>
{
    K Key;
    V Value;
}
""");
    return FailsWithDiagnostic(compiled, "STK3023")
        && AnyDiagnosticMessageContains(compiled, "Incompatible Hash contract method")
        && AnyDiagnosticMessageContains(compiled, "must return 'u64[0 max]'")
        && AnyDiagnosticMessageContains(compiled, "u64[0 max] Hash");
}

