import CompilerTestSupport
import System.Testing

module CompilerCliTests_PIPELINEP1

// Ported from CompilerCliTests.VerboseLogVerbosityRequiresExplicitInfoLogLevelForPipelineLifecycleEvents.
public unsafe fn bool VerboseLogVerbosityRequiresExplicitInfoLogLevelForPipelineLifecycleEventsImpl()
{
    unsafe
    {
        // PORT-NOTE: original drives CompilerCli.RunAsync with --check --log-verbosity verbose
        // --log-kind pipeline and asserts exitCode==0, stdout contains "Check succeeded.", and
        // empty stderr (verbose without explicit info level emits no pipeline lifecycle events).
        // CLI process output / stdout / stderr are not expressible via the compile helpers, so this
        // reduces to "the embedded program type-checks successfully" (the --check success signal).
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "cli-verbose-verbosity-requires-explicit-info-level",
            raw"""
module Demo

fn i32[min max] Run()
{
    return 7;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerCliTests.ExplicitInfoLogLevelPrintsPipelineLifecycleEvents.
public unsafe fn bool ExplicitInfoLogLevelPrintsPipelineLifecycleEventsImpl()
{
    unsafe
    {
        // PORT-NOTE: original drives CompilerCli.RunAsync with --check --log-level info
        // --log-verbosity verbose --log-kind pipeline and asserts exitCode==0, stdout contains
        // "Check succeeded.", and stderr contains the pipeline lifecycle lines
        // "Starting pass 'parse'. [info pipeline stage=parse" and
        // "Completed pass 'ownership-validate'. [info pipeline stage=ownership-validate".
        // CLI process output / stderr log streams are not expressible via the compile helpers, so
        // this reduces to "the embedded program type-checks successfully" (the --check success signal).
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "cli-explicit-info-level-prints-pipeline-lifecycle",
            raw"""
module Demo

fn i32[min max] Run()
{
    return 7;
}
""");
        return Succeeds(compiled);
    }
}
