// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesPreferTypedVoidReturnTemplateBodiesWhenBridgeSourceIsCorrupted.
public unsafe fn bool ManifestBackedGenericBodiesPreferTypedVoidReturnTemplateBodiesWhenBridgeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes Facade, corrupts the Facade.GuardedReset template
    // BodyText, and asserts the monomorphized MIR still contains the guard-`return` plus the
    // Facade.ResetValue direct-call statement from the typed early-return body. Package-image
    // corruption and MIR statement probing are not expressible with the helpers, so this is
    // reduced to compiling the published Facade library program and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "lower-mir-typed-void-return-library",
        raw"""
module Facade

public record ResetBox(i32[min max] Value)
{
}

public fn void ResetValue(borrow mut ResetBox box)
{
    box.Value = 0;
}

public fn void GuardedReset<T>(bool shouldStop, borrow mut ResetBox box, T tag)
{
    if (shouldStop)
    {
        return;
    }
    ResetValue(box);
    return;
}
""");
    return Succeeds(compiled);
}

