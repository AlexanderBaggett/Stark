// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesUsePublishedAggregatePatternFactsWhenBridgeSourceIsCorrupted.
public unsafe fn bool ManifestBackedGenericBodiesUsePublishedAggregatePatternFactsWhenBridgeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes Facade, corrupts the Facade.ReadCount template BodyText
    // to a switch over a bogus `Missing(_, var count)` pattern, and asserts the monomorphized
    // MIR still uses the published aggregate-pattern facts for the real Counter(_, var count)
    // positional record pattern. Package-image corruption and MIR fact probing are not
    // expressible with the helpers, so this is reduced to compiling the published Facade
    // library program and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "lower-mir-published-aggregate-pattern-facts-library",
        raw"""
module Facade

public record Counter(i32[min max] Value, i32[min max] Count)
{
}

public fn i32[min max] ReadCount<T>(Counter counter, T tag)
{
    switch (counter)
    {
        case Counter(_, var count):
            return count;
    }
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesUsePublishedNestedAndLiteralSwitchPatternFactsWhenBridgeSourceIsCorrupted.
public unsafe fn bool ManifestBackedGenericBodiesUsePublishedNestedAndLiteralSwitchPatternFactsWhenBridgeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes Facade, corrupts the Facade.ReadNestedCount template
    // BodyText to a switch over a bogus Wrapped<T>.Missing { Data: Counter(0, ...), Marker: 99 }
    // pattern, and asserts the monomorphized MIR still uses the published nested-and-literal
    // switch-pattern facts for the real Wrapped<T>.Value { Data: Counter(7, var count),
    // Marker: 1 } pattern with the default arm. Package-image corruption and MIR fact probing
    // are not expressible with the helpers, so this is reduced to compiling the published
    // Facade library program and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "lower-mir-published-nested-literal-switch-pattern-facts-library",
        raw"""
module Facade

public record Counter(i32[min max] Value, i32[min max] Count)
{
}

public enum Wrapped<T>
{
    Value
    {
        Data: Counter, Marker: i32[min max]
    },
}

public fn i32[min max] ReadNestedCount<T>(Wrapped<T> wrapped, T tag)
{
    switch (wrapped)
    {
        case Wrapped<T>.Value
        {
            Data: Counter(7, var count), Marker: 1
        }:
            return count;
        default:
            return -1;
    }
}
""");
    return Succeeds(compiled);
}
