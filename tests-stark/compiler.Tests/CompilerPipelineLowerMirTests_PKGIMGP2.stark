// Ported from CompilerPipelineLowerMirTests.ManifestBackedGenericBodiesPreferTypedTryPropagationTemplateBodiesWhenBridgeSourceIsCorrupted.
public unsafe fn bool ManifestBackedGenericBodiesPreferTypedTryPropagationTemplateBodiesWhenBridgeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes Facade (the Facade.Pass generic with a `try` over a
    // Result<T, ParseError>), confirms the template body is published typed-only (BodyText is
    // null), and asserts the monomorphized MIR lowers the try-propagation control flow.
    // Package-image construction and typed-body / MIR probing are not expressible with the
    // helpers, so this is reduced to compiling the published Facade library program and
    // asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "lower-mir-typed-try-propagation-library",
        raw"""
module Facade

public enum ParseError
{
    Bad,
}

public enum Result<T, E>
{
    [Ok] Ok(T),
    [Err] Err(E),
}

public fn Result<T, ParseError> Pass<T>(T value, bool ok)
{
    if (ok)
    {
        stack T payload = try Result<T, ParseError>.Ok(value);
        return Result<T, ParseError>.Ok(payload);
    }

    return Result<T, ParseError>.Err(ParseError.Bad);
}
""");
    return Succeeds(compiled);
}

