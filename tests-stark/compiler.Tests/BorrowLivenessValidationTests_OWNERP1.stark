import CompilerTestSupport
import System.Testing
module BorrowLivenessValidationTests_OWNERP1

// Ported slice of tests/compiler.Tests/BorrowLivenessValidationTests.cs.
//
// PORT-NOTE: the C# originals do NOT embed a Stark source string. They build a
// MidLevelIrModule by hand (StorageLive/Assign/Evaluate/Call statements) and run
// NonLexicalBorrowLifetimeValidator directly, asserting on the STK4201
// "borrow-liveness" diagnostic and on FunctionOwnershipSummary.OwnershipValid.
// The Stark host test protocol cannot inject a pre-built MIR module or read the
// per-function OwnershipValid flag, so each scenario is reconstructed as the
// equivalent Stark program (a move-only `Box`, a `borrow` alias of it, and a
// `Consume(box)` move) and routed through CompileTypeCheck, which reaches the
// same non-lexical borrow-liveness pass. The OwnershipValid assertion is folded
// into the STK4201 presence/absence check (OwnershipValid == false iff the
// borrow-liveness error fires).

// Ported from BorrowLivenessValidationTests.MoveConflictIsReportedWhenBorrowRemainsLive.
public unsafe fn bool MoveConflictIsReportedWhenBorrowRemainsLiveImpl()
{
    unsafe
    {
        // PORT-NOTE: C# MIR -> equivalent Stark. `alias = box` aliases the box,
        // the alias is still used after `Consume(box)`, so the move conflicts
        // with the live borrow. Original asserts STK4201 message
        // "cannot move 'box' into call 'Consume'" and OwnershipValid == false.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-move-conflict-live-borrow",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

unsafe fn void Consume(Box value)
{
    return;
}

unsafe fn i32[min max] Run(bool choose)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    stack borrow Box alias = box;
    Consume(box);
    alias.Value;
    return 0;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4201", "cannot move 'box' into call 'Consume'");
    }
}

// Ported from BorrowLivenessValidationTests.MoveAfterLastUseIsAllowed.
public unsafe fn bool MoveAfterLastUseIsAllowedImpl()
{
    unsafe
    {
        // PORT-NOTE: C# MIR -> equivalent Stark. The alias's last use precedes
        // the move into `Consume(box)`, so the borrow is dead at the move and no
        // conflict is reported. Original asserts no STK4201 and
        // OwnershipValid == true.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-move-after-last-use",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

unsafe fn void Consume(Box value)
{
    return;
}

unsafe fn i32[min max] Run(bool choose)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    stack borrow Box alias = box;
    alias.Value;
    Consume(box);
    return 0;
}
""");
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK4201");
    }
}

// Ported from BorrowLivenessValidationTests.OverwriteConflictIsReportedWhenBorrowRemainsLive.
public unsafe fn bool OverwriteConflictIsReportedWhenBorrowRemainsLiveImpl()
{
    unsafe
    {
        // PORT-NOTE: C# MIR -> equivalent Stark. `box` is overwritten with a
        // fresh value while `alias` (a borrow of the old box) is still used
        // afterward. Original asserts STK4201 message "cannot overwrite 'box'"
        // and OwnershipValid == false.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-overwrite-conflict-live-borrow",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

unsafe fn i32[min max] Run(bool choose)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    stack borrow Box alias = box;
    box = new Box()
    {
        Value = 0
    };
    alias.Value;
    return 0;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4201", "cannot overwrite 'box'");
    }
}

// Ported from BorrowLivenessValidationTests.BranchLastUseAllowsMoveAtMerge.
public unsafe fn bool BranchLastUseAllowsMoveAtMergeImpl()
{
    unsafe
    {
        // PORT-NOTE: C# BuildBranchModule(useAliasAfterMerge: false). Both branch
        // arms alias `box` and use the alias before merging; the merge block then
        // moves `box` into `Consume`. Because the alias's last use is in each arm
        // (not after the merge), the borrow is dead at the move and no conflict is
        // reported. Original asserts no STK4201 and OwnershipValid == true.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-branch-last-use-allows-move",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

unsafe fn void Consume(Box value)
{
    return;
}

unsafe fn i32[min max] Run(bool choose)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    stack mut borrow Box alias = box;
    if (choose)
    {
        alias = box;
        alias.Value;
    }
    else
    {
        alias = box;
        alias.Value;
    }

    Consume(box);
    return 0;
}
""");
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK4201");
    }
}

// Ported from BorrowLivenessValidationTests.BranchLiveBorrowBlocksMoveAtMerge.
public unsafe fn bool BranchLiveBorrowBlocksMoveAtMergeImpl()
{
    unsafe
    {
        // PORT-NOTE: C# BuildBranchModule(useAliasAfterMerge: true). Same branch
        // shape as above, but the merge block uses `alias` again after the
        // `Consume(box)` move, so the borrow is still live at the move and the
        // conflict fires. Original asserts STK4201 message
        // "cannot move 'box' into call 'Consume'" and OwnershipValid == false.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-branch-live-borrow-blocks-move",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

unsafe fn void Consume(Box value)
{
    return;
}

unsafe fn i32[min max] Run(bool choose)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    stack mut borrow Box alias = box;
    if (choose)
    {
        alias = box;
        alias.Value;
    }
    else
    {
        alias = box;
        alias.Value;
    }

    Consume(box);
    alias.Value;
    return 0;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4201", "cannot move 'box' into call 'Consume'");
    }
}
