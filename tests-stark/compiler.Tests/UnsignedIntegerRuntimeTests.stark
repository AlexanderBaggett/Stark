import CompilerTestSupport
import System.Testing
module UnsignedIntegerRuntimeTests

// Ported from UnsignedIntegerRuntimeTests.UnsignedSmallMediumAndWideIntegerOperationsRunCorrectly.
internal fn bool UnsignedSmallMediumAndWideIntegerOperationsRunCorrectlyImpl()
{
    // PORT-NOTE: original writes the program to a temp file, drives the CLI
    // (--emit-exe), asserts CLI exit 0, "Emitted executable:" stdout, empty
    // stderr, the emitted executable exists, then runs it and asserts empty
    // stdout/stderr and runtime exit code 0. The Stark compile helpers cannot
    // observe CLI stdout, emitted-file existence, or native runtime exit codes;
    // reduced to driving the embedded program through the full pipeline and
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "unsigned-small-medium-wide-runs",
        raw"""
module Demo

const u96 WideHigh = 2 ** 95;
const u96 WideLow = 2 ** 94;

fn i32[min max] Small()
{
    stack u8[0 max] maxValue = (u8[0 max])(2 ** 8 - 1);
    stack u8[0 max] divisor = 2;
    stack u8[0 max] threshold = 200;
    if (maxValue > threshold && maxValue / divisor == (u8[0 max])(2 ** 7 - 1) && maxValue >> 4 == 15)
    {
        return 0;
    }

    return 1;
}

fn i32[min max] Medium()
{
    stack u32[0 max] maxValue = (u32[0 max])(2 ** 32 - 1);
    stack u32[0 max] high = 4000000000;
    stack u32[0 max] divisor = (u32[0 max])(2 ** 16);
    if (maxValue > high && maxValue / divisor == (u32[0 max])(2 ** 16 - 1))
    {
        return 0;
    }

    return 2;
}

fn i32[min max] Wide()
{
    stack u96[0 max] high = WideHigh;
    stack u96[0 max] low = WideLow;
    if (high > low)
    {
        return 0;
    }

    return 3;
}

export unsafe fn i32[min max] main()
{
    stack i32[min max] small = Small();
    if (small != 0)
    {
        return small;
    }

    stack i32[min max] medium = Medium();
    if (medium != 0)
    {
        return medium;
    }

    return Wide();
}
""");
    return Succeeds(compiled);
}
