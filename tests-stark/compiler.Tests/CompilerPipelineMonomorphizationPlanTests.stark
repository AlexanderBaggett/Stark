// Ported from CompilerPipelineMonomorphizationPlanTests.ManifestBackedNestedGenericTypePlanningUsesPublishedDeferredTypeTriggers.
internal fn bool ManifestBackedNestedGenericTypePlanningUsesPublishedDeferredTypeTriggersImpl()
{
    {
        // PORT-NOTE: The C# test builds the `Facade.Pair`/`Facade.Forward` library into a
        // package image, rewrites the published Facade.Forward generic template's BodyText to
        // "{ return 0; }", strips the manifest to typed interface + compiler facts + rewritten
        // generic templates, writes the manifest, deletes the source, then re-imports `Facade`
        // into a `Demo` consumer (StopAfterPassId "monomorphization-plan") and probes the
        // MonomorphizationPlan: a single function "__stark_mono_fn_Demo__Facade_Forward__i32"
        // and a single type (template Facade.Pair, instantiated "Facade.Pair<i32,bool>", symbol
        // "__stark_mono_ty_Demo__Facade_Pair__i32__bool") -- the published deferred type
        // trigger for Pair<T,bool> survives the body rewrite. Package-image construction,
        // generic-template BodyText rewriting, manifest round-tripping, source deletion, and
        // MonomorphizationPlan probing are not expressible with the Stark helpers, so this is
        // reduced to compiling the `Demo` consumer with the (unrewritten) `Facade` library
        // available as a sibling source module through type-check and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "mono-plan-manifest-deferred-type-triggers",
            raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] value, bool flag)
{
    return Facade.Forward(value, flag);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public record Pair<A, B>(A First, B Second)
{
}

public fn i32[min max] Forward<T>(T value, bool flag)
{
    stack Pair<T, bool> pair = new Pair<T, bool>(value, flag);
    return pair.Second ? 1 : 0;
}
""");
        return Succeeds(compiled);
    }
}
