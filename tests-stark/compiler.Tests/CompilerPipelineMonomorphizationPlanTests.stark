// Ported from CompilerPipelineMonomorphizationPlanTests.RootObjectConstructionWrapperGenericInstantiationsUseOptimizationSummaryForPlanning.
internal fn bool RootObjectConstructionWrapperGenericInstantiationsUseOptimizationSummaryForPlanningImpl()
{
    {
        // PORT-NOTE: the original stops after "monomorphization-plan" and reads the plan's "Wrap"
        // function, asserting CodeSizeHeuristic InlineSmallBody and a non-null EstimatedBodyCost (the
        // object-construction wrapper's optimization summary drives planning). The compile helpers
        // cannot stop after that pass nor read those per-function plan facts, so this reduces to "the
        // embedded program type-checks cleanly", program kept verbatim from the C# raw string.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "monoplan-root-object-construction-wrapper-optimization-summary",
            raw"""
module Demo

struct Inner<T>
{
    T Value;
}

struct Outer<T>
{
    Inner<T> Item;
    i32[min max] Count;
}

fn Outer<T> Wrap<T>(T value, i32[min max] count, T tag)
{
    return new Outer<T>()
    {
        Item =
        {
            Value = value
        },
        Count = count
    };
}

fn Outer<i32[min max]> Run(i32[min max] value, i32[min max] count)
{
    return Wrap(value, count, value);
}
""");
        return Succeeds(compiled);
    }
}

