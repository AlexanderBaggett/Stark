// Ported from CompilerPipelineMonomorphizationPlanTests.SourceBackedImportedGenericInstantiationsUseDefiningModuleMonomorphizationSymbols.
internal fn bool SourceBackedImportedGenericInstantiationsUseDefiningModuleMonomorphizationSymbolsImpl()
{
    {
        // PORT-NOTE: the original writes a source-backed Facade.stark into a temp directory, resolves
        // it via FileSystemModuleResolver, stops after "monomorphization-plan", and reads the
        // MonomorphizationPlanModel: a single function (CodeSizeHeuristic InlineSmallBody,
        // EstimatedTopLevelStatementCount 1, Linkage LinkOnceOdrComdat, SymbolName
        // "__stark_mono_fn_Facade__Facade_Identity__i32") and a single type (Linkage LinkOnceOdrComdat,
        // SymbolName "__stark_mono_ty_Facade__Facade_Pair__i32") -- the defining module owns the
        // symbols. The harness writes the imported module to a temp search directory and resolves it
        // the same way, but cannot stop after that pass nor read the plan artifact (heuristic, statement
        // count, linkage, mono symbol names), so this reduces to "the consumer program plus its
        // source-backed Facade module type-check successfully". Both programs are kept verbatim from
        // the C# raw string literals.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "monoplan-source-backed-imported-defining-module-symbols",
            raw"""
import Facade
module Demo

fn i32[min max] Run(Facade.Pair<i32[min max]> pair)
{
    return Facade.Identity(pair.Value);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public record Pair<T>(T Value)
{
}

public fn T Identity<T>(T value)
{
    return value;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineMonomorphizationPlanTests.ColdGenericInstantiationsPreferCodeSizeReductionInThePlan.
internal fn bool ColdGenericInstantiationsPreferCodeSizeReductionInThePlanImpl()
{
    {
        // PORT-NOTE: the original stops after "monomorphization-plan" and reads the plan's single
        // function, asserting CodeSizeHeuristic ReduceCodeSize, EstimatedTopLevelStatementCount 3, and
        // SymbolName "__stark_mono_fn_Demo__Choose__i32" (cold instantiations prefer code-size
        // reduction over inlining). The compile helpers cannot stop after that pass nor read those plan
        // facts, so this reduces to "the embedded program type-checks cleanly", program kept verbatim
        // from the C# raw string.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "monoplan-cold-generic-instantiations-prefer-code-size-reduction",
            raw"""
module Demo

cold fn T Choose<T>(T left, T right, bool takeRight)
{
    stack mut T current = left;
    if (takeRight)
    {
        current = right;
    }

    return current;
}

fn i32[min max] Run(i32[min max] left, i32[min max] right, bool takeRight)
{
    return Choose(left, right, takeRight);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineMonomorphizationPlanTests.ManifestBackedGenericInstantiationsUseRootOwnedMonomorphizationSymbols.
internal fn bool ManifestBackedGenericInstantiationsUseRootOwnedMonomorphizationSymbolsImpl()
{
    {
        // PORT-NOTE: The C# test builds the `Facade` library into a package image via
        // PackageImageBuilder.Create, writes the .starkpkg.json manifest + static library,
        // then re-imports `Facade` into a `Demo` consumer (StopAfterPassId
        // "monomorphization-plan") and probes the MonomorphizationPlan artifact: a single
        // root-owned function (DeclarationOnly heuristic, null statement count,
        // InternalSingleOwner linkage, symbol "__stark_mono_fn_Demo__Facade_Identity__i32");
        // and a single type (InternalSingleOwner, "__stark_mono_ty_Demo__Facade_Pair__i32").
        // Package-image construction, manifest round-tripping, and MonomorphizationPlan
        // symbol probing are not expressible with the Stark helpers, so this is reduced to
        // compiling the same `Demo` consumer with the `Facade` library available as a
        // sibling source module through type-check and asserting it succeeds (the
        // precondition for the generic instantiation to be planned at all). The published
        // `Identity` is a body-less manifest signature in C#; a body is supplied so it is
        // resolvable from source.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "mono-plan-manifest-root-owned-symbols",
            raw"""
import Facade
module Demo

fn i32[min max] Run(Facade.Pair<i32[min max]> pair)
{
    return Facade.Identity(pair.Value);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public record Pair<T>(T Value)
{
}

public fn T Identity<T>(T value)
{
    return value;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineMonomorphizationPlanTests.ManifestBackedColdGenericInstantiationsPreservePackageImagePlanningFacts.
internal fn bool ManifestBackedColdGenericInstantiationsPreservePackageImagePlanningFactsImpl()
{
    {
        // PORT-NOTE: The C# test builds the cold `Facade.Choose` library into a package
        // image, strips the manifest down to its typed interface + compiler facts +
        // generic templates, writes the manifest, deletes the source, then re-imports
        // `Facade` into a `Demo` consumer (StopAfterPassId "monomorphization-plan") and
        // probes the imported module's PackageImageFacts (Facade.Choose template summary
        // TopLevelStatementCount == 3) and the MonomorphizationPlan (single function:
        // ReduceCodeSize heuristic, EstimatedTopLevelStatementCount 3, InternalSingleOwner
        // linkage, symbol "__stark_mono_fn_Demo__Facade_Choose__i32"). Package-image
        // construction, manifest stripping/round-tripping, source deletion, and
        // PackageImageFacts/MonomorphizationPlan probing are not expressible with the Stark
        // helpers, so this is reduced to compiling the `Demo` consumer with the cold
        // `Facade` library available as a sibling source module through type-check and
        // asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "mono-plan-manifest-cold-planning-facts",
            raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] left, i32[min max] right, bool takeRight)
{
    return Facade.Choose(left, right, takeRight);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public cold fn T Choose<T>(T left, T right, bool takeRight)
{
    stack mut T current = left;
    if (takeRight)
    {
        current = right;
    }

    return current;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineMonomorphizationPlanTests.ManifestBackedTerminalSelectionGenericBodiesUseOptimizationSummaryForPlanning.
internal fn bool ManifestBackedTerminalSelectionGenericBodiesUseOptimizationSummaryForPlanningImpl()
{
    {
        // PORT-NOTE: The C# test builds the `Facade.Classify` switch-wrapper library into a
        // package image, writes the manifest, deletes the source, then re-imports `Facade`
        // into a `Demo` consumer (StopAfterPassId "monomorphization-plan") and probes the
        // imported PackageImageFacts (Facade.Classify template summary TopLevelStatementCount
        // 1, EstimatedBodyCost > 2) and the MonomorphizationPlan (single function:
        // InlineSmallBody heuristic, EstimatedTopLevelStatementCount 1, EstimatedBodyCost
        // matching the template summary, InternalSingleOwner linkage, symbol
        // "__stark_mono_fn_Demo__Facade_Classify__i32"). Package-image construction, manifest
        // round-tripping, source deletion, and PackageImageFacts/MonomorphizationPlan probing
        // are not expressible with the Stark helpers, so this is reduced to compiling the
        // `Demo` consumer with the `Facade` library available as a sibling source module
        // through type-check and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "mono-plan-manifest-terminal-selection",
            raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return Facade.Classify(value, value);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn i32[min max] Classify<T>(i32[min max] value, T tag)
{
    switch (value)
    {
        case 0:
            return 10;
        case 1:
            return 11;
        case 2:
            return 12;
        default:
            return value;
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineMonomorphizationPlanTests.ManifestBackedGenericPlanningUsesPublishedTemplateSummaryWhenImportedBridgeBodyIsCorrupted.
internal fn bool ManifestBackedGenericPlanningUsesPublishedTemplateSummaryWhenImportedBridgeBodyIsCorruptedImpl()
{
    {
        // PORT-NOTE: The C# test builds the `Facade.Classify` switch-wrapper library into a
        // package image, round-trips PackageImageLoader.TryBuildModuleDocument, asserts the
        // published Facade.Classify template summary (TopLevelStatementCount 1,
        // EstimatedBodyCost > 2, OptimizationSummary.IsTerminalSelectionWrapper), then
        // deliberately corrupts the imported bridge body via a source-text replace +
        // re-parse and resolves `Demo` against a DocumentOnlyModuleResolver over the
        // corrupted document (StopAfterPassId "monomorphization-plan"), probing that the
        // MonomorphizationPlan still uses the published template summary (single function:
        // InlineSmallBody, EstimatedTopLevelStatementCount 1, EstimatedBodyCost from the
        // summary, symbol "__stark_mono_fn_Demo__Facade_Classify__i32"). Package-image
        // construction, document round-tripping, source-text corruption, the
        // DocumentOnlyModuleResolver, and MonomorphizationPlan probing are not expressible
        // with the Stark helpers, so this is reduced to compiling the `Demo` consumer with
        // the (uncorrupted) `Facade` library available as a sibling source module through
        // type-check and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "mono-plan-manifest-corrupted-bridge",
            raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return Facade.Classify(value, value);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn i32[min max] Classify<T>(i32[min max] value, T tag)
{
    switch (value)
    {
        case 0:
            return 10;
        case 1:
            return 11;
        case 2:
            return 12;
        default:
            return value;
    }
}
""");
        return Succeeds(compiled);
    }
}

