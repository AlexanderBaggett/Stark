import CompilerTestSupport
import System.Testing

module TypeCheckingTests_DIAGP1

// Ported slice of tests/compiler.Tests/TypeCheckingTests.cs.
// Each Impl runs the embedded Stark program (kept verbatim from the C# raw
// string) through the closest compile helper and returns true when the original
// xUnit assertions would hold. The C# facts stop after the "type-check" pass;
// CompileTypeCheck mirrors that. TypeCheckModel probes (promotions,
// address-taken functions, capture facts) are not expressible via the compile
// helpers, so PORT-NOTE comments flag where assertions were reduced to the
// nearest diagnostic / Succeeds signal. Methods that compile several programs
// are reproduced as several compiles combined with `&&`.

// Ported from TypeCheckingTests.CompileTimeStructuralFactsCannotPromoteToRuntimeCallableValues.
public unsafe fn bool CompileTimeStructuralFactsCannotPromoteToRuntimeCallableValuesImpl()
{
    stack mut LlvmCompile pointerResult = CompileTypeCheck(
        "diagp1-comptime-fact-no-runtime-pointer",
        raw"""
module Demo

finite law void Run()
{
    stack fnptr<finite law bool()> fact = System.Compiler.IsInteger<i32[min max]>;
    return;
}
""");

    stack mut LlvmCompile closureResult = CompileTypeCheck(
        "diagp1-comptime-fact-no-runtime-closure",
        raw"""
module Demo

finite law void Run()
{
    stack closure<finite law bool()> fact = System.Compiler.IsInteger<i32[min max]>;
    return;
}
""");

    return FailsWithDiagnosticMessage(pointerResult, "STK3054", "may only be used inside a `comptime` expression or block")
        && FailsWithDiagnosticMessage(closureResult, "STK3054", "may only be used inside a `comptime` expression or block");
}

// Ported from TypeCheckingTests.FunctionPointerAbiIsPartOfTypeIdentity.
public unsafe fn bool FunctionPointerAbiIsPartOfTypeIdentityImpl()
{
    // PORT-NOTE: the C# fact compiles with TargetInfo "x86_64-pc-windows-msvc";
    // the compile helpers do not thread a target triple, so the embedded
    // program runs against the default target. The asserted diagnostic
    // (mismatched fnptr ABIs) is target-independent. Two message fragments are
    // asserted in C#; reduced here to STK3002 plus the dominant fragment.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-fnptr-abi-type-identity",
        raw"""
module Demo

unsafe ffi(c) fn i32[min max] CRead();
unsafe ffi(win64) fn i32[min max] WinRead();

unsafe fn void Run()
{
    stack mut fnptr<unsafe ffi(c) fn i32[min max]()> cReader = CRead;
    stack fnptr<unsafe ffi(win64) fn i32[min max]()> winReader = WinRead;
    cReader = winReader;
    return;
}
""");

    return FailsWithDiagnostic(compiled, "STK3002")
        && AnyDiagnosticMessageContains(compiled, "fnptr<unsafe ffi(c) fn")
        && AnyDiagnosticMessageContains(compiled, "fnptr<unsafe ffi(win64) fn");
}

// Ported from TypeCheckingTests.SystemCCVoidIsValidOnlyBehindRawPointers.
public unsafe fn bool SystemCCVoidIsValidOnlyBehindRawPointersImpl()
{
    // PORT-NOTE: the C# fact additionally probes the TypeCheckModel via
    // AssertRawPointerToCVoid on each function's parameter/return types. Those
    // raw-pointer-to-c_void shape facts are not expressible through the compile
    // helpers, so the positive case reduces to "the program type-checks".
    stack mut LlvmCompile good = CompileTypeCheck(
        "diagp1-cvoid-behind-rawptr-good",
        raw"""
module Demo

unsafe ffi(c) fn rawmutptr<System.C.c_void> Allocate(System.C.c_size_t bytes);
unsafe ffi(c) fn void Free(rawmutptr<System.C.c_void> ptr);

unsafe fn rawptr<System.C.c_void> Identity(rawptr<System.C.c_void> ptr)
{
    return ptr;
}
""");

    stack mut LlvmCompile bad = CompileTypeCheck(
        "diagp1-cvoid-behind-rawptr-bad",
        raw"""
module Demo

unsafe ffi(c) fn System.C.c_void BadReturn();

struct BadField
{
    System.C.c_void Value;
}

unsafe fn void BadLocal()
{
    stack System.C.c_void value;
    return;
}
""");

    return Succeeds(good)
        && FailsWithDiagnostic(bad, "STK3050")
        && AnyDiagnosticMessageContains(bad, "System.C.c_void")
        && AnyDiagnosticMessageContains(bad, "rawptr<System.C.c_void>");
}

// Ported from TypeCheckingTests.StructLayoutDiagnosticsRejectInvalidLayoutShapes.
public unsafe fn bool StructLayoutDiagnosticsRejectInvalidLayoutShapesImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-struct-layout-invalid-shapes",
        raw"""
module Demo

[StructLayout(C), Pack(3)]
struct BadPack
{
    u32[0 max] Value;
}

[StructLayout(C)]
struct BadField
{
    ascii Text;
}

[StructLayout(Explicit)]
struct MissingOffset
{
    u32[0 max] Value;
}
""");

    return FailsWithDiagnosticMessage(compiled, "STK3048", "[Pack(N)] requires a positive power-of-two integer literal")
        && FailsWithDiagnosticMessage(compiled, "STK3049", "not FFI-layout safe")
        && FailsWithDiagnosticMessage(compiled, "STK3048", "Every field in [StructLayout(Explicit)]");
}

// Ported from TypeCheckingTests.SafeBorrowsRejectMisalignedPackedFields.
public unsafe fn bool SafeBorrowsRejectMisalignedPackedFieldsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-safe-borrow-misaligned-packed",
        raw"""
module Demo

[StructLayout(C), Pack(1)]
struct Packet
{
    u8[0 max] Tag;
    u32[0 max] Value;
}

fn void Touch(borrow u32[0 max] value)
{
    return;
}

fn void Run(borrow Packet packet)
{
    Touch(packet.Value);
    return;
}
""");

    return FailsWithDiagnosticMessage(compiled, "STK3049", "cannot form a safe borrow to member 'Value'");
}

// Ported from TypeCheckingTests.FunctionPointerOverlapTargetRejectsDefaultDisjointFunctionItems.
public unsafe fn bool FunctionPointerOverlapTargetRejectsDefaultDisjointFunctionItemsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-fnptr-overlap-rejects-disjoint",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn void Touch(borrow mut Box left, borrow mut Box right)
{
    return;
}

fn void Run()
{
    stack fnptr<fn void(borrow mut Box, borrow mut Box) where overlap(arg0, arg1)> op = Touch;
    return;
}
""");

    return FailsWithDiagnostic(compiled, "STK3002")
        && AnyDiagnosticMessageContains(compiled, "cannot be promoted")
        && AnyDiagnosticMessageContains(compiled, "where overlap(arg0, arg1)");
}

// Ported from TypeCheckingTests.LawClosureTypesRejectMutableOrOnceCapabilities.
public unsafe fn bool LawClosureTypesRejectMutableOrOnceCapabilitiesImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-law-closure-rejects-mut-once",
        raw"""
module Demo

fn void RegisterMutableLaw(inline closure<mut law void()> body);
fn void RegisterOnceLaw(heap closure<once finite law void()> body);
""");

    // C# asserts exactly two STK3014 diagnostics with the same message fragment.
    return !Succeeds(compiled)
        && CountDiagnosticsWithCodeAndMessage(
            compiled,
            "STK3014",
            "Law and finite law closure signatures cannot use 'mut' or 'once'") == 2;
}

// Ported from TypeCheckingTests.FunctionItemPromotionRejectsUnsatisfiedFunctionKindObligations.
public unsafe fn bool FunctionItemPromotionRejectsUnsatisfiedFunctionKindObligationsImpl()
{
    // PORT-NOTE: the C# fact also asserts TypeCheckModel.AddressTakenFunctions
    // is empty; that model probe is not expressible via the compile helpers and
    // is dropped. The four STK3002 promotion-rejection diagnostics are checked.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-fn-promotion-unsatisfied-kinds",
        raw"""
module Demo

fn i32[min max] Plain()
{
    return 1;
}

finite i32[min max] FiniteOnly()
{
    return 2;
}

law i32[min max] LawOnly()
{
    return 3;
}

fn void Run()
{
    stack fnptr<finite i32[min max]()> needsFinite = Plain;
    stack fnptr<law i32[min max]()> needsLaw = Plain;
    stack fnptr<finite law i32[min max]()> needsBothFromFinite = FiniteOnly;
    stack fnptr<finite law i32[min max]()> needsBothFromLaw = LawOnly;
    return;
}
""");

    return FailsWithDiagnostic(compiled, "STK3002")
        && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "Function item 'Plain' cannot be promoted") >= 2
        && AnyDiagnosticMessageContains(compiled, "Function item 'FiniteOnly' cannot be promoted")
        && AnyDiagnosticMessageContains(compiled, "Function item 'LawOnly' cannot be promoted")
        && AnyDiagnosticMessageContains(compiled, "finite law");
}

// Ported from TypeCheckingTests.FunctionPointerPromotionRejectsAbiMismatchedFunctionItems.
public unsafe fn bool FunctionPointerPromotionRejectsAbiMismatchedFunctionItemsImpl()
{
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "diagp1-fnptr-promotion-abi-mismatch",
