// Ported from ProjectCliTests.TestGeneratesFactRunnerFromMetadataAndAppliesFilter.
public unsafe fn bool TestGeneratesFactRunnerFromMetadataAndAppliesFilterImpl()
{
    // PORT-NOTE: original runs `stark test --filter=Adds`, asserts a fact runner is
    // generated from [Fact] metadata, that the generated runner imports System.Testing
    // and emits RunFact("AddsNumbers", ...) but not RunFact("FailsByDesign", ...) per
    // the filter. The compile helpers cannot generate or read the fact-runner file,
    // apply the --filter, or observe CLI stdout; reduced to compiling the embedded
    // [Fact]-annotated test root program through the full pipeline and returning
    // Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "project-test-generates-fact-runner-filter",
        raw"""
module GeneratedTests

[Fact]
fn bool AddsNumbers()
{
    return 2 + 2 == 4;
}

[Fact]
fn bool FailsByDesign()
{
    return false;
}
""");
    return Succeeds(compiled);
}

// Ported from ProjectCliTests.TestGeneratedFactRunnerAppliesPlatformGatesFromTargetTriple.
public unsafe fn bool TestGeneratedFactRunnerAppliesPlatformGatesFromTargetTripleImpl()
{
    // PORT-NOTE: original substitutes the host's platform selector into a
    // [Platform]/[SkipPlatform]-annotated GeneratedTests.stark, runs `stark test`,
    // and asserts the generated runner RunFacts the matching-platform facts/groups
    // and SkipFacts the non-matching ones. The C# selectors are interpolated from
    // the detected target triple; this port pins them concretely (current = macos,
    // other = linux). The compile helpers cannot generate the runner or evaluate the
    // platform gates; reduced to compiling the embedded program through the full
    // pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "project-test-fact-runner-platform-gates",
        raw"""
module GeneratedTests

[Fact]
[Platform(macos)]
fn bool RunsHere()
{
    return true;
}

[Fact]
[Platform(linux)]
fn bool SkipsElsewhere()
{
    return false;
}

[Fact]
[SkipPlatform(macos)]
fn bool SkipsCurrent()
{
    return false;
}

[Platform(macos)]
struct CurrentPlatformGroup
{
    [Fact]
    static fn bool GroupRunsHere()
    {
        return true;
    }
}

[Platform(linux)]
struct OtherPlatformGroup
{
    [Fact]
    static fn bool GroupSkipsElsewhere()
    {
        return false;
    }
}
""");
    return Succeeds(compiled);
}

// Ported from ProjectCliTests.TestGeneratedFactRunnerAppliesSerialCollections.
public unsafe fn bool TestGeneratedFactRunnerAppliesSerialCollectionsImpl()
{
    // PORT-NOTE: original runs `stark test` over a [Collection]/[Serial]-annotated
    // GeneratedTests.stark and uses AssertInOrder to check the generated runner emits
    // the collection-grouped RunFacts in the expected serial order with "// Test
    // collection: ..." markers. The compile helpers cannot generate the runner or
    // observe ordering; reduced to compiling the embedded program through the full
    // pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "project-test-fact-runner-serial-collections",
        raw"""
module GeneratedTests

[Fact]
fn bool Before()
{
    return true;
}

[Fact]
[Collection(Toolchain)]
fn bool ToolchainA()
{
    return true;
}

[Fact]
fn bool Between()
{
    return true;
}

[Fact]
[Collection("Toolchain")]
fn bool ToolchainB()
{
    return true;
}

[Serial]
struct SerialGroup
{
    [Fact]
    static fn bool First()
    {
        return true;
    }

    [Fact]
    static fn bool Second()
    {
        return true;
    }
}
""");
    return Succeeds(compiled);
}

// Ported from ProjectCliTests.TestGeneratedFactRunnerExpandsInlineDataTheories.
public unsafe fn bool TestGeneratedFactRunnerExpandsInlineDataTheoriesImpl()
{
    // PORT-NOTE: original runs `stark test` over a [Theory]/[InlineData]-annotated
    // GeneratedTests.stark and asserts the generated runner expands each inline-data
    // row into a RunFact call (e.g. RunFact("Adds(1, 2, 3)", Adds(1, 2, 3))) with a
    // "// Test collection: TextCases" marker. The [Theory]/[InlineData] here are Stark
    // attributes inside the embedded program, not xUnit attributes on this method; the
    // compile helpers cannot generate the runner or expand the rows. Reduced to
    // compiling the embedded program through the full pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "project-test-fact-runner-inline-data-theories",
        raw"""
module GeneratedTests

[Theory]
[InlineData(1, 2, 3)]
[InlineData(-2, 5, 3)]
fn bool Adds(i32[min max] left, i32[min max] right, i32[min max] expected)
{
    return left + right == expected;
}

[Collection(TextCases)]
[Theory]
[InlineData("stark", true)]
fn bool TextCase(ascii name, bool expected)
{
    return expected;
}
""");
    return Succeeds(compiled);
}

// Ported from ProjectCliTests.TestGeneratedFactRunnerExpandsMemberDataTheories.
public unsafe fn bool TestGeneratedFactRunnerExpandsMemberDataTheoriesImpl()
{
    // PORT-NOTE: original runs `stark test` over a [Theory]/[MemberData]-annotated
    // GeneratedTests.stark and asserts the generated runner materializes each member
    // -data row (stack AddRow __stark_member_data_N = AddRows(N);) and emits a RunFact
    // per row. The compile helpers cannot generate the runner or expand the member
    // -data source; reduced to compiling the embedded program (record + finite-law data
    // source + theory) through the full pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "project-test-fact-runner-member-data-theories",
        raw"""
module GeneratedTests

record AddRow(i32[min max] Left, i32[min max] Right, i32[min max] Expected) { }

finite law AddRow AddRows(u64[0 2 ** 63 - 1] index)
{
    switch (index)
    {
        case 0:
            return new AddRow(1, 2, 3);
        default:
            return new AddRow(-2, 5, 3);
    }
}

[Theory]
[MemberData(AddRows, AddRow, 2, Left, Right, Expected)]
fn bool Adds(i32[min max] left, i32[min max] right, i32[min max] expected)
{
    return left + right == expected;
}
""");
    return Succeeds(compiled);
}

