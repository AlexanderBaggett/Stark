import CompilerTestSupport
import System.Testing
module ProjectCliTests_RUNTIMEP1

// Ported slice of tests/compiler.IntegrationTests/ProjectCliTests.cs. These are
// project/solution CLI integration tests ([Collection("SerialToolchain")]) whose
// original assertions cover CLI exit codes, "Emitted ... :"/"Running ... "/
// "Passed/Failed test project" stdout/stderr text, emitted-file existence,
// package-image bytes, generated fact-runner file contents, and stdlib package
// discovery preference. The Stark compile helpers cannot observe any of those
// runtime / file-system / CLI effects, so each Impl reduces to driving the
// embedded test program (the root .stark the CLI would compile) through the
// closest compile helper and asserting the nearest available success signal.
// See per-method `// PORT-NOTE:` comments for what each one reduced.

// Ported from ProjectCliTests.RunPrefersRepoStdlibDistPackageBeforeRepoSource.
public unsafe fn bool RunPrefersRepoStdlibDistPackageBeforeRepoSourceImpl()
{
    // PORT-NOTE: original builds a repo stdlib dist package (System.RepoDistProbe
    // -> Value() = 0) plus a competing repo source copy (Value() = 7), then asserts
    // `stark run` exits 0 and prefers the dist package over the source tree. The
    // compile helpers cannot model stdlib package-vs-source discovery preference,
    // CLI exit, or "Emitted executable:" stdout; reduced to compiling the embedded
    // probe-library program (the dist package source) through the full pipeline and
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "project-run-prefers-repo-stdlib-dist",
        raw"""
module System.RepoDistProbe

public finite law i32[min max] Value()
{
    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from ProjectCliTests.RunUsesSolutionDefaultRunTarget.
public unsafe fn bool RunUsesSolutionDefaultRunTargetImpl()
{
    // PORT-NOTE: original writes a solution (math library + app executable importing
    // Math) and asserts `stark run` picks the solution default run target, links the
    // path dependency, emits the static library and executable, and exits with code
    // 7 (Math.Add(3, 4)). The single-module helper cannot supply the sibling Math
    // module, drive the solution run target, or observe exit codes / "Emitted ..."
    // stdout; reduced to compiling the app root program through the full pipeline and
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "project-run-solution-default-run-target",
        raw"""
import Math
module App

export fn i32[min max] main()
{
    return Math.Add(3, 4);
}
""");
    return Succeeds(compiled);
}

