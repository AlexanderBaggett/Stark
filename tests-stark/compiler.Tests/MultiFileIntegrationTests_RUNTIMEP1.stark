import CompilerTestSupport
import System.Testing
module MultiFileIntegrationTests_RUNTIMEP1

// Ported slice of tests/compiler.IntegrationTests/MultiFileIntegrationTests.cs.
// These are multi-file CLI integration tests whose original assertions cover
// CLI exit codes, "Emitted ..." stdout text, emitted-file existence, package
// manifest/image bytes, and linked-program runtime exit codes. The Stark
// compile helpers cannot observe those effects, so each Impl reduces to driving
// the embedded program through the closest compile helper and asserting the
// nearest available success signal. See per-method `// PORT-NOTE:` comments.

// Ported from MultiFileIntegrationTests.ManifestBackedLibrariesCanBeConsumedWithoutSourceFiles.
public unsafe fn bool ManifestBackedLibrariesCanBeConsumedWithoutSourceFilesImpl()
{
    // PORT-NOTE: original builds a Facade library (re-exporting Math) with
    // --emit-lib, asserts the emitted .a/.lib + .starkpkg manifest exist and that
    // the manifest RootModule is "Facade" re-exporting "Math", deletes the
    // sources, then links an App importing the manifest-backed library without
    // source and asserts CLI exit 0, "Emitted executable:" stdout, the output
    // exists, and a runtime exit code of 7. The compile helpers cannot model
    // manifest-backed linking, package-image bytes, or exit codes; reduced to
    // compiling the Facade library program (which re-exports Math) through the
    // full pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "multifile-manifest-facade-reexport-math",
        raw"""
export import Math
module Facade

public finite law i32[min max] Double(i32[min max] value)
{
    return Math.Add(value, value);
}
""");
    return Succeeds(compiled);
}

// Ported from MultiFileIntegrationTests.ManifestBackedPublicGlobalsLinkAcrossPackageBoundaries.
public unsafe fn bool ManifestBackedPublicGlobalsLinkAcrossPackageBoundariesImpl()
{
    // PORT-NOTE: original builds a Globals library exposing `public const Answer`
    // with --emit-lib, asserts the emitted .a/.lib + .starkpkg manifest exist,
    // deletes the source, then links an App importing the manifest-backed library
    // without source and asserts CLI exit 0, "Emitted executable:" stdout, the
    // output exists, and a runtime exit code of 7 (the linked global value). The
    // compile helpers cannot model cross-package manifest linking or exit codes;
    // reduced to compiling the Globals library program (the public global being
    // linked across the package boundary) through the full pipeline and returning
    // Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "multifile-manifest-public-global",
        raw"""
module Globals

public const Answer = 7;
""");
    return Succeeds(compiled);
}

// Ported from MultiFileIntegrationTests.SystemTextSourceModuleSupportsRuntimeAsciiUnicodeConversionHelpers.
public unsafe fn bool SystemTextSourceModuleSupportsRuntimeAsciiUnicodeConversionHelpersImpl()
{
    // PORT-NOTE: original appends this runtime program to the on-disk
    // stdlib/src/System/Text.stark source, links it as an executable against the
    // stdlib include path, and asserts CLI exit 0, "Emitted executable:" stdout,
    // the output exists, and a runtime exit code of 0 (every ascii<->unicode
    // conversion helper succeeded). The compile helpers cannot prepend the
    // System.Text source nor observe the runtime exit code; reduced to compiling
    // the appended runtime program (the test logic) through the full pipeline and
    // returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "multifile-system-text-ascii-unicode-runtime",
        raw"""
fn bool StatusOk(System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Ok:
            return true;
        case System.Memory.MemoryStatus.Err(var error):
            return false;
    }
}

export fn i32[min max] main()
{
    stack mut OwnedUnicode unicodeText = new();
    if (!StatusOk(FromAsciiToUnicode(unicodeText, "café")))
    {
        return 1;
    }

    if (unicodeText.Length() != 4)
    {
        return 2;
    }

    stack i32[min max][] unicodeUnits = unicodeText.AsSlice();
    if (unicodeUnits[3] != 233)
    {
        return 4;
    }

    stack mut OwnedAscii asciiText = new();
    if (!StatusOk(FromUnicodeToAscii(asciiText, (unicode)"α!")))
    {
        return 5;
    }

    if (asciiText.Length() != 3)
    {
        return 6;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from MultiFileIntegrationTests.SystemTextSourceModuleSupportsRuntimeUtf16ConversionHelpers.
public unsafe fn bool SystemTextSourceModuleSupportsRuntimeUtf16ConversionHelpersImpl()
{
    // PORT-NOTE: original appends this runtime program to the on-disk
    // stdlib/src/System/Text.stark source, links it as an executable against the
    // stdlib include path, and asserts CLI exit 0, "Emitted executable:" stdout,
    // the output exists, and a runtime exit code of 0 (every utf16 conversion
    // helper succeeded). The compile helpers cannot prepend the System.Text
    // source nor observe the runtime exit code; reduced to compiling the appended
    // runtime program (the test logic) through the full pipeline and returning
    // Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "multifile-system-text-utf16-runtime",
        raw"""
fn bool StatusOk(System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Ok:
            return true;
        case System.Memory.MemoryStatus.Err(var error):
            return false;
    }
}

export fn i32[min max] main()
{
    stack mut OwnedUtf16 utf16Text = new();
    if (!StatusOk(FromAsciiToUtf16(utf16Text, "AZ")))
    {
        return 1;
    }

    if (utf16Text.Length() != 2)
    {
        return 2;
    }

    stack mut OwnedUnicode unicodeText = new();
    if (!StatusOk(FromUtf16ToUnicode(unicodeText, utf16Text)))
    {
        return 4;
    }

    if (unicodeText.Length() != 2)
    {
        return 5;
    }

    stack mut OwnedUnicode gothicText = new();
    if (!StatusOk(gothicText.AppendCodePoint(65))
        || !StatusOk(gothicText.AppendCodePoint(66376)))
        {
            return 17;
    }

    stack mut OwnedUtf16 secondUtf16Text = new();
    if (!StatusOk(FromUnicodeToUtf16(secondUtf16Text, gothicText.View())))
    {
        return 7;
    }

    if (secondUtf16Text.Length() != 3)
    {
        return 8;
    }

    stack mut OwnedAscii asciiText = new();
    if (!StatusOk(FromUtf16ToAscii(asciiText, utf16Text)))
    {
        return 9;
    }

    if (asciiText.Length() != 2)
    {
        return 10;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}
