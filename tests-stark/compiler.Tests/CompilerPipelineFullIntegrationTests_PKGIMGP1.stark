// Ported from CompilerPipelineFullIntegrationTests.ManifestBackedTraitAndDoctrineOptimizationRulesStayAbiBounded.
public unsafe fn bool ManifestBackedTraitAndDoctrineOptimizationRulesStayAbiBoundedImpl()
{
    unsafe
    {
        // PORT-NOTE: the C# test publishes a Facade library with a doctrine and a trait,
        // writes the manifest, deletes the source, re-imports Facade into the Demo consumer
        // and inspects the ClosedWorldOptimizationModel (AbiBoundary seals, no runtime
        // dispatch, DirectAbiBoundary/CompileTimeOnlyContract call-lowering strategies,
        // SharedCode/MonomorphizationDeferred codegen, devirtualization flags). Manifest
        // round-tripping, filesystem effects and closed-world-model inspection are not
        // expressible via the helpers, so this resolves Facade through the filesystem module
        // resolver and asserts the Demo consumer (which calls Facade.Numbers.Add) type-checks.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "manifest-backed-trait-and-doctrine-optimization-rules-stay-abi-bounded",
            raw"""
import Facade
module Demo

unsafe fn i32[min max] Run()
{
    return Facade.Numbers.Add(1, 2);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public doctrine Numbers
{
    finite law i32[min max] Add(i32[min max] left, i32[min max] right)
    {
        return left + right;
    }
}

public trait Comparable
{
    law i32[min max] Compare(i32[min max] other);
}
""");
        return Succeeds(compiled);
    }
}

