// Ported from CompilerPipelineFullIntegrationTests.PackageManifestIncludesStructuredSemanticBorrowFacts.
public unsafe fn bool PackageManifestIncludesStructuredSemanticBorrowFactsImpl()
{
    unsafe
    {
        // PORT-NOTE: the C# test compiles the Facade library and inspects the package
        // manifest's CompilerFacts FunctionSemantics borrow facts (Echo: captures argument
        // memory, value parameter guaranteed read-only with 4 dereferenceable/alignment bytes
        // and "return" capture; Reset: writes argument memory, no capture, parameter writes
        // with "none" capture). Package-image construction and semantic-borrow-fact inspection
        // are not expressible via the helpers, so this reduces to compiling the published
        // Facade library program and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "package-manifest-includes-structured-semantic-borrow-facts",
            raw"""
module Facade

public struct Box
{
    i32[min max] Value;
}

public fn retborrow Box Echo(retborrow Box value)
{
    return value;
}

public fn void Reset(borrow mut Box value)
{
    value.Value = 0;
    return;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.PackageManifestIncludesStructuredSemanticCallFacts.
public unsafe fn bool PackageManifestIncludesStructuredSemanticCallFactsImpl()
{
    unsafe
    {
        // PORT-NOTE: the C# test compiles the Facade library and inspects the package
        // manifest's CompilerFacts FunctionSemantics call facts (Outer calls Facade.Touch; the
        // call writes argument memory, reads no other memory, and its single argument binds
        // caller/callee parameter "box" with writes and "none" capture). Package-image
        // construction and semantic-call-fact inspection are not expressible via the helpers,
        // so this reduces to compiling the published Facade library program and asserting it
        // succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "package-manifest-includes-structured-semantic-call-facts",
            raw"""
module Facade

public struct Box
{
    i32[min max] Value;
}

public fn void Touch(borrow mut Box box)
{
    box.Value = 1;
    return;
}

public fn void Outer(borrow mut Box box)
{
    Touch(box);
    return;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.PackageManifestPublishesOnlyApiVisibleGenericTemplateBodies.
public unsafe fn bool PackageManifestPublishesOnlyApiVisibleGenericTemplateBodiesImpl()
{
    unsafe
    {
        // PORT-NOTE: the C# test compiles the Facade library and asserts the package manifest
        // publishes generic-template bodies only for API-visible generics (PublicIdentity,
        // PublicBox.Echo) while omitting file-local and internal generics and concrete
        // functions from both the TypedInterface HasGenericTemplateBody flags and the
        // GenericTemplates section. Package-image construction and template-publication-rule
        // inspection are not expressible via the helpers, so this reduces to compiling the
        // published Facade library program and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "package-manifest-publishes-only-api-visible-generic-template-bodies",
            raw"""
module Facade

fn T LocalIdentity<T>(T value)
{
    return value;
}

internal fn T InternalIdentity<T>(T value)
{
    return value;
}

public fn T PublicIdentity<T>(T value)
{
    return value;
}

public fn i32[min max] ConcreteIdentity(i32[min max] value)
{
    return value;
}

struct LocalBox<T>
{
    T Value;

    fn T Echo(borrow LocalBox<T> self, T fallback)
    {
        return self.Value;
    }
}

internal struct InternalBox<T>
{
    T Value;

    fn T Echo(borrow InternalBox<T> self, T fallback)
    {
        return self.Value;
    }
}

public struct PublicBox<T>
{
    T Value;

    fn T Echo(borrow PublicBox<T> self, T fallback)
    {
        return self.Value;
    }
}
""");
        return Succeeds(compiled);
    }
}

