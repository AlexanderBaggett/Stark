// Ported from CompilerPipelineFullIntegrationTests.StructuredPackageImageDocumentsKeepTypedLoopControlGenericDeclarationsWhenBodyTextIsCorrupted.
public unsafe fn bool StructuredPackageImageDocumentsKeepTypedLoopControlGenericDeclarationsWhenBodyTextIsCorruptedImpl()
{
    unsafe
    {
        // PORT-NOTE: the C# test publishes the Facade loop-control generic library, replaces
        // every generic-template BodyText with "{ return this is not valid Stark; }", rebuilds
        // a structured module document from the typed sections only, and asserts the
        // reconstructed source text keeps the typed SumWhileControl/SumForControl declarations
        // (declaration-only, no while/for/continue/break body text and no corrupted text).
        // Package-image construction, body-text corruption and structured-document
        // reconstruction are not expressible via the helpers, so this reduces to compiling the
        // published Facade library program and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "structured-package-image-documents-keep-typed-loop-control-generic-declarations",
            raw"""
module Facade

public fn i32[min max] SumWhileControl<T>(i32[min max] count, i32[min max] stopAt, T tag)
{
    stack mut i32[min max] sum = 0;
    stack mut i32[min max] index = 0;
    while willexit (index < count)
    {
        index = index + 1;
        if (index < 2)
        {
            continue;
        }
        if (index == stopAt)
        {
            break;
        }
        sum = sum + index;
    }
    return sum;
}

public fn i32[min max] SumForControl<T>(i32[min max] count, i32[min max] stopAt, T tag)
{
    stack mut i32[min max] sum = 0;
    for willexit (stack mut i32[min max] index = 0; index < count; index = index + 1)
    {
        if (index < 2)
        {
            continue;
        }
        if (index == stopAt)
        {
            break;
        }
        sum = sum + index;
    }
    return sum;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.ManifestBackedModulesCanBeReconstructedFromStructuredTypedInterfaceSections.
public unsafe fn bool ManifestBackedModulesCanBeReconstructedFromStructuredTypedInterfaceSectionsImpl()
{
    unsafe
    {
        // PORT-NOTE: the C# test publishes the Facade library, strips it to its typed
        // interface only, rebuilds the bridge module source (asserting it carries the
        // BufferView alias and Identity declaration), writes the typed-only manifest, deletes
        // the source, then re-imports Facade into the Demo consumer and inspects the loaded
        // module's SyntaxModel (Pair record, BufferView alias, generic Identity). Package-image
        // construction, typed-only manifest round-tripping, filesystem effects and loaded-
        // module SyntaxModel inspection are not expressible via the helpers, so this resolves
        // Facade through the filesystem module resolver and asserts the Demo consumer
        // type-checks.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "manifest-backed-modules-can-be-reconstructed-from-structured-typed-interface-sections",
            raw"""
import Facade
module Demo

fn void Run()
{
    return;
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public record Pair<T>(T Value)
{
}
public alias BufferView<T> = Pair<T>[];
public fn T Identity<T>(T value);
""");
        return Succeeds(compiled);
    }
}

