// Ported from CompilerPipelineFullIntegrationTests.PackageManifestPublishesGroupedLocalDeclarationTypedTemplateBodies.
public unsafe fn bool PackageManifestPublishesGroupedLocalDeclarationTypedTemplateBodiesImpl()
{
    unsafe
    {
        // PORT-NOTE: the C# test compiles the Facade library and inspects the package
        // manifest's GenericTemplates typed bodies for grouped local declarations (SumPair: one
        // local per grouped name first/second plus return; SumTo: total/stop locals plus a for
        // loop whose initializer carries index/max plus return) and asserts the JSON omits
        // "BodyText" but includes "TypedBody". Package-image construction, typed-body statement
        // inspection and manifest JSON are not expressible via the helpers, so this reduces to
        // compiling the published Facade library program and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "package-manifest-publishes-grouped-local-declaration-typed-template-bodies",
            raw"""
module Facade

public fn i32[min max] SumPair<T>(i32[min max] value, T tag)
{
    stack i32[min max] first = value, second = value + 1;
    return first + second;
}

public fn i32[min max] SumTo<T>(i32[min max] limit, T tag)
{
    stack mut i32[min max] total = 0, stop = limit;
    for willexit (stack mut i32[min max] index = 0, max = stop; index < max; index += 1)
    {
        total += index;
    }

    return total;
}
""");
        return Succeeds(compiled);
    }
}

