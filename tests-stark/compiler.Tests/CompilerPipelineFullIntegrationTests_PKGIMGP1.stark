            "package-manifest-includes-structured-typed-interface-sections",
            raw"""
module Facade

public record Pair<T>(T Value)
{
}
public alias BufferView<T> = Pair<T>[];
public fn Pair<i32[min max]> First(BufferView<i32[min max]> view);
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineFullIntegrationTests.PackageManifestIncludesExplicitSourceSurfaceSections.
public unsafe fn bool PackageManifestIncludesExplicitSourceSurfaceSectionsImpl()
{
    unsafe
    {
