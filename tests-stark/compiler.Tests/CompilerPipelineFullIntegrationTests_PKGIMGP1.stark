        // source text (replacing the Double signature with "Missing" types), re-parses it, and
        // asserts the Demo consumer still resolves Facade.Numbers.Double from the package-image
        // facts (TypeCheckModel return type "i32"). Package-image fact tables, source-text
        // corruption and DocumentOnlyModuleResolver are not expressible via the helpers, so
        // this resolves the (uncorrupted) Facade through the filesystem module resolver and
        // asserts the Demo consumer type-checks.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "manifest-backed-doctrine-methods-resolve-from-package-image-facts",
            raw"""
import Facade
module Demo

unsafe fn i32[min max] Run()
{
    return Facade.Numbers.Double(3);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public doctrine Numbers
{
    finite law i32[min max] Double(i32[min max] value)
    {
        return value + value;
    }
}
""");
        return Succeeds(compiled);
    }
}

