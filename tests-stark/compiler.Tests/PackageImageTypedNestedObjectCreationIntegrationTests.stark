import CompilerTestSupport
import System.Testing
module PackageImageTypedNestedObjectCreationIntegrationTests

// Ported from PackageImageTypedNestedObjectCreationIntegrationTests.ManifestBackedTypedNestedObjectCreationBodiesCompileAndRunWithoutSyntheticSource.
internal fn bool ManifestBackedTypedNestedObjectCreationBodiesCompileAndRunWithoutSyntheticSourceImpl()
{
    {
        // PORT-NOTE: The original first builds the `Facade` library (carrying a
        // generic typed nested-object-creation body for `Wrap`) with
        // `--emit-lib -o`, asserting CLI exit 0, "Emitted static library:"
        // stdout, empty stderr, and the on-disk static library plus
        // `libFacade.starkpkg` manifest existing. It then loads the manifest,
        // asserts the `Facade.Wrap` template carries a typed body with no source
        // body text, strips the source-surface/legacy sections to a typed-only
        // manifest, deletes the Facade source, and links a manifest-backed
        // `Demo` executable with `--emit-exe -I <dir>`, asserting CLI exit 0,
        // "Emitted executable:" stdout, empty stderr, the output existing, and
        // that the linked program runs with empty stdout/stderr and exit code
        // 49 (4 * 10 + 9). The compile helpers cannot express CLI process
        // output, file-system effects, package-image manifest contents, typed
        // template inspection, or runtime exit codes, so this is reduced to
        // compiling the same two-module program (root `Demo` importing the
        // dependency `Facade`) through the LLVM pipeline and asserting it
        // succeeds.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "package-image-typed-nested-object-creation-manifest-backed",
            raw"""
import Facade
module Demo

export fn i32[min max] main()
{
    stack i32[min max] value = 4;
    stack Facade.Outer<i32[min max]> wrapped = Facade.Wrap(value, value);
    return wrapped.Item.Value * 10 + wrapped.Values[1];
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public struct Inner<T>
{
    T Value;
}

public struct Outer<T>
{
    Inner<T> Item;
    i32[min max][2] Values;
}

public fn Outer<T> Wrap<T>(T value, T tag)
{
    return new Outer<T>()
    {
        Item =
        {
            Value = value
        },
        Values =
        {
            7, 9
        }
    };
}
""");
        return Succeeds(compiled);
    }
}
