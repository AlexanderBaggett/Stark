// Ported from PackageImageArchitectureTests.PackageImagePreservesSystemCTypedInterfaceSurface.
internal fn bool PackageImagePreservesSystemCTypedInterfaceSurfaceImpl()
{
    {
        // PORT-NOTE: The C# test publishes a `Facade` library of System.C aliases (Fd/CountValue/
        // VoidPtr/NamePtr/CharBuffer/NativeCallback), a `Native` struct, a `NativeToken` enum and
        // ffi(c) Allocate/Free/Count functions for an x86_64-linux target, builds a package image,
        // probes the typed-interface SourceAliasName/bit-width/element-type facts, round-trips the
        // System.C source, deletes the Facade source, then runs the `Demo` consumer (EmitLlvmIr) whose
        // `Run` returns 42 when every C-source-alias predicate holds and asserts its LLVM body folds
        // to `ret i32 42` with no residual `call`. Package-image construction, C-alias fact probing,
        // target-triple selection, sourceless resolution and LLVM-text inspection are not expressible
        // via the compile helpers, so this resolves `Facade` as a sibling source module and asserts
        // the `Demo` consumer (carrying the full comptime System.C-alias fact body) type-checks.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "package-image-preserves-system-c-typed-interface-surface",
            raw"""
import Facade
module Demo

finite law i32[min max] Run()
{
    if (comptime System.Compiler.TypeHasCSourceAlias<Facade.Fd>()
        && comptime (System.Compiler.TypeCSourceAliasName<Facade.Fd>() == "System.C.c_int")
        && comptime System.Compiler.TypeHasCSourceAlias<Facade.CountValue>()
        && comptime (System.Compiler.TypeCSourceAliasName<Facade.CountValue>() == "System.C.c_long")
        && comptime System.Compiler.TypeHasCSourceAlias<System.C.c_char>()
        && comptime (System.Compiler.TypeCSourceAliasName<System.C.c_char>() == "System.C.c_char")
        && comptime System.Compiler.RawPointerElementTypeHasCSourceAlias<Facade.NamePtr>()
        && comptime (System.Compiler.RawPointerElementTypeCSourceAliasName<Facade.NamePtr>() == "System.C.c_char")
        && comptime System.Compiler.TypeElementTypeHasCSourceAlias<Facade.CharBuffer>()
        && comptime (System.Compiler.TypeElementTypeCSourceAliasName<Facade.CharBuffer>() == "System.C.c_char")
        && comptime System.Compiler.FunctionPointerReturnTypeHasCSourceAlias<Facade.NativeCallback>()
        && comptime (System.Compiler.FunctionPointerReturnTypeCSourceAliasName<Facade.NativeCallback>() == "System.C.c_int")
        && comptime System.Compiler.FunctionPointerParameterTypeHasCSourceAlias<Facade.NativeCallback, 1>()
        && comptime (System.Compiler.FunctionPointerParameterTypeCSourceAliasName<Facade.NativeCallback, 1>() == "System.C.c_long")
        && comptime System.Compiler.FieldTypeHasCSourceAlias<Facade.Native, 0>()
        && comptime (System.Compiler.FieldTypeCSourceAliasName<Facade.Native, 0>() == "System.C.c_int")
        && comptime System.Compiler.EnumVariantPayloadTypeHasCSourceAlias<Facade.NativeToken, 0, 0>()
        && comptime (System.Compiler.EnumVariantPayloadTypeCSourceAliasName<Facade.NativeToken, 0, 0>() == "System.C.c_long")
        && comptime System.Compiler.MethodReturnTypeHasCSourceAlias<Facade.Native, 0>()
        && comptime (System.Compiler.MethodReturnTypeCSourceAliasName<Facade.Native, 0>() == "System.C.c_long")
        && comptime System.Compiler.MethodParameterTypeHasCSourceAlias<Facade.Native, 0, 1>()
        && comptime (System.Compiler.MethodParameterTypeCSourceAliasName<Facade.Native, 0, 1>() == "System.C.c_long")
        && comptime !System.Compiler.TypeHasCSourceAlias<i32[min max]>()
        && comptime (System.Compiler.TypeCSourceAliasName<i32[min max]>() == "")
        && comptime (System.Compiler.TypeModuleName<Facade.Native>() == "Facade")
        && comptime (System.Compiler.TypeModuleName<Facade.NativeToken>() == "Facade")
        && comptime (System.Compiler.TypeModuleName<i32[min max]>() == ""))
    {
        return 42;
    }

    return 0;
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public alias Fd = System.C.c_int;
public alias CountValue = System.C.c_long;
public alias VoidPtr = rawmutptr<System.C.c_void>;
public alias NamePtr = rawptr<System.C.c_char>;
public alias CharBuffer = System.C.c_char[4];
public alias NativeCallback = fnptr<ffi(c) finite law System.C.c_int(NamePtr, System.C.c_long)>;

public struct Native
{
    System.C.c_int Code;

    finite law System.C.c_long Echo(borrow Native self, System.C.c_long value)
    {
        return value;
    }
}

public enum NativeToken
{
    Count(System.C.c_long)
}

public unsafe ffi(c) fn rawmutptr<System.C.c_void> Allocate(System.C.c_size_t bytes);
public unsafe ffi(c) fn void Free(rawmutptr<System.C.c_void> ptr);
public unsafe ffi(c) fn System.C.c_long Count(System.C.c_int fd);
""");
        return Succeeds(compiled);
    }
}

// Ported from PackageImageArchitectureTests.PackageImagePreservesArenaObjectCreationStorageSelectorInGenericTemplateFacts.
internal fn bool PackageImagePreservesArenaObjectCreationStorageSelectorInGenericTemplateFactsImpl()
{
    {
        // PORT-NOTE: The C# test publishes `Facade.Count<T>` to a package image and asserts the
        // generic template facts preserve the arena object-creation storage selector plus the
        // `new(arena,1)` expression text, then deletes the source and compiles a consumer from the
        // package image. The Stark host-test harness cannot build or inspect package manifests, so
        // this mirror resolves `Facade` as a sibling source module and asserts the same arena-backed
        // generic body remains accepted when instantiated by the consumer.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "package-image-preserves-arena-object-creation-storage-selector-generic-template-facts",
            raw"""
import Facade
module Demo

fn u64[0 max] Run()
{
    stack Facade.Box box = new Facade.Box()
    {
        Value = 7
    };
    return Facade.Count(box);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public struct Box
{
    public i32[min max] Value;
}

public fn u64[0 max] Count<T>(T item)
{
    stack mut dynamic T values = new(arena, 1);
    init values[0] = item;
    return values.Length;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from PackageImageArchitectureTests.PackageImageBackedRetainingBorrowSurfaceRejectsArenaBackedArguments.
internal fn bool PackageImageBackedRetainingBorrowSurfaceRejectsArenaBackedArgumentsImpl()
{
    {
        // PORT-NOTE: The C# test verifies the package-image function-semantics summary for
        // `storeborrow` parameters survives source removal and rejects an arena-backed argument in
        // the consumer. The Stark host-test harness cannot publish package images, so this mirror
        // resolves the same callable surface as a sibling source module and asserts the arena escape
        // diagnostic through the full host pipeline.
        stack mut LlvmCompile compiled = CompileFullWithModule(
            "package-image-backed-retaining-borrow-surface-rejects-arena-backed-arguments",
            raw"""
import Facade
module Demo

fn void Bad()
{
    arena Facade.Box box = new Facade.Box()
    {
        Value = 1
    };
    Facade.Observe(box);
    Facade.Retain(box);
    return;
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public struct Box
{
    public i32[min max] Value;
}

public fn void Observe(borrow Box box)
{
    return;
}

public fn void Retain(storeborrow Box box)
{
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4202", "callee may retain")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4202", "arena storage for 'box' is here") >= 1;
    }
}
