// Ported from PackageImageArchitectureTests.PackageImageGenericTemplatesPublishAllBoundOperationFamilies.
internal fn bool PackageImageGenericTemplatesPublishAllBoundOperationFamiliesImpl()
{
    {
        // PORT-NOTE: The C# test publishes a `System.Text` library whose generic `Run<T>` exercises
        // every bound-operation family (direct/member/function-pointer/closure calls, index access,
        // object creation, enum construction/call/value, dynamic-storage ops, text interpolation/
        // build, layout query, switch dispatch, dyn-trait-from-parts), builds a package image,
        // asserts the published BoundOperations cover all required kinds plus the loaded-facts
        // bound-operation interfaces, corrupts the Run template BodyText, round-trips a body-less
        // surface, deletes the Facade source, then runs the `Demo` consumer through `emit-llvm` and
        // asserts the LLVM contains `__stark_mono_fn_System_Text__System_Text_Run__` and not
        // "this is not valid Stark". Package-image construction, bound-operation/fact probing,
        // manifest corruption and sourceless resolution are not expressible via the compile helpers,
        // so this resolves `System.Text` as a sibling source module (System/Text.stark), compiles
        // the `Demo` consumer to LLVM, and asserts the LLVM contains the monomorphized symbol.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "package-image-generic-templates-publish-all-bound-operation-families",
            raw"""
import System.Text
module Demo

fn i32[min max] LocalInc(i32[min max] value)
{
    return value + 1;
}

unsafe fn i32[min max] Execute()
{
    stack fnptr<fn i32[min max](i32[min max])> pointerOp = LocalInc;
    stack closure<fn i32[min max](i32[min max])> closureOp =
        (i32[min max] value) => value + 6;
    return Run(7, pointerOp, closureOp);
}
""",
            "System",
            "Text.stark",
            raw"""
module System.Text

public finite law ascii AsciiView(Ascii source);
public unsafe finite bool TryConcatAscii(rawmutptr<Ascii> destination, ascii left, ascii right);

public dyn trait Speaker
{
    finite law i32[min max] Speak(borrow Self self);
}

enum Status
{
    Ok,
    Err(i32[min max]),
    Named
    {
        Code: i32[min max]
    },
}

struct Box
{
    i32[min max] Value;

    fn i32[min max] Get(borrow Box self)
    {
        return self.Value;
    }

    fn bool Fill(borrow Box self, out i32[min max] value)
    {
        value = self.Value;
        return true;
    }
}

public struct Dog : Speaker
{
    public i32[min max] Volume;

    public finite law i32[min max] Speak(borrow Dog self)
    {
        return self.Volume;
    }
}

fn i32[min max] Inc(i32[min max] value)
{
    return value + 1;
}

unsafe fn i32[min max] Apply(fnptr<fn i32[min max](i32[min max])> op, i32[min max] value)
{
    return op(value);
}

fn bool Write(out i32[min max] value)
{
    value = 9;
    return true;
}

unsafe fn bool ApplyOut(fnptr<fn bool(out i32[min max])> op, out i32[min max] value)
{
    return op(value);
}

fn i32[min max] Choose(bool flag)
{
    switch (flag)
    {
        case true:
            return 1;
        case false:
            return 0;
    }
}

fn i32[min max] Score(Status status)
{
    switch (status)
    {
        case Status.Ok:
            return 1;
        case Status.Err(var error):
            return error;
        case Status.Named
        {
            Code: var code
        }:
            return code;
    }
}

public unsafe fn T Run<T>(
    T input,
    fnptr<fn i32[min max](i32[min max])> pointerOp,
    closure<fn i32[min max](i32[min max])> closureOp)
    {
        stack Dog dog = new Dog()
    {
        Volume = 8
    };
    stack borrow dyn Speaker natural = dog;
    stack rawmutptr<i8[min max]> dynContext = natural.Context;
    stack rawptr<Speaker.Vtable> dynTable = natural.Vtable;
    stack borrow dyn Speaker dynView = dynview<Speaker>(dynContext, dynTable);
    stack mut Box box = new Box()
    {
        Value = 3
    };
    stack mut i32[min max][2] values =
    {
        4, 5
    };
    stack mut dynamic u32[0 max] items = new(1);
    stack Ascii label[4 + 4] = $"ok";
    stack Ascii joined[12] = label + "!";
    stack i64[min max] boxSize = sizeof(Box);
    stack i64[min max] boxAlign = alignof(Box);
    stack mut i64[min max] marker = 0;
    switch (true)
    {
        case true:
            marker = boxSize;
        case false:
            marker = boxAlign;
    }
    stack Status ok = Status.Ok;
    stack Status named = Status.Named
    {
        Code: 5
    };
    values[0] = Inc(box.Get());
    items.Reserve(1);
    if (!box.Fill(values[1]))
    {
        return input;
    }
    if (!ApplyOut(Write, values[1]))
    {
        return input;
    }
    if (Score(named) == 0)
    {
        return input;
    }
    true ? pointerOp(1) : closureOp(2);
    stack i32[min max] total = values[0] + values[1] + Apply(Inc, 2) + pointerOp(3) + closureOp(6) + Choose(true) + Score(Status.Ok) + Score(Status.Err(4)) + dynView.Speak();
    return input;
}
""");
        return Succeeds(compiled)
            && System.Testing.Contains(Llvm(compiled), "__stark_mono_fn_System_Text__System_Text_Run__");
    }
}

// Ported from PackageImageArchitectureTests.PackageImageGenericTemplatesPreservePropertyAndListSwitchPatterns.
internal fn bool PackageImageGenericTemplatesPreservePropertyAndListSwitchPatternsImpl()
{
    {
        // PORT-NOTE: The C# test publishes a `Facade` library whose generic `Run<T>` switches on a
        // `Boxed` property pattern and a list pattern, builds a package image, probes the loaded
        // AggregatePatterns/typed-body switch cases for the list-pattern facts, corrupts the Run
        // template BodyText, deletes the Facade source, then runs the `Demo` consumer through
        // `lower-abi` and asserts it succeeds with no fallback logs. Package-image construction,
        // aggregate-pattern fact probing, manifest corruption and sourceless resolution are not
        // expressible via the compile helpers, so this resolves `Facade` as a sibling source module
        // and compiles the `Demo` consumer through type-check (the closest expressible stage),
        // asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "package-image-generic-templates-preserve-property-and-list-switch-patterns",
            raw"""
import Facade
module Demo

unsafe fn i32[min max] Run()
{
    stack Facade.Boxed box = new Facade.Boxed()
    {
        Value = 3,
        Enabled = true
    };
    stack i32[min max][2] values =
    {
        1, 2
    };
    return Facade.Run(7, box, values);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public struct Boxed
{
    i32[min max] Value;
    bool Enabled;
}

public finite law T Run<T>(T input, Boxed box, i32[min max][2] values)
{
    stack mut i32[min max] marker = 0;
    switch (box)
    {
        case Boxed { Enabled: true, Value: var found }:
            marker = found;
        case Boxed { Value: _, Enabled: _ }:
            marker = 1;
    }

    switch (values)
    {
        case [1, var right]:
            marker += right;
        case [_, _]:
            marker += 0;
    }

    return input;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from PackageImageArchitectureTests.PackageImageConsumerLowersImportedGenericTypedBodyAfterSourceAndBodyTextAreRemoved.
