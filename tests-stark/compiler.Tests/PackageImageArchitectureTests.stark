// Ported from PackageImageArchitectureTests.PackageImageConsumerFoldsImportedComptimeTemplateCallWithMemberCalls.
internal fn bool PackageImageConsumerFoldsImportedComptimeTemplateCallWithMemberCallsImpl()
{
    {
        // PORT-NOTE: The C# test publishes a `Facade` library with a `Box<T>` carrying `Add`/`Read`
        // member laws and a `MemberScore<T, comptime N>` that folds
        // `comptime BuildBox<T, comptime N>().Add(5).Read()`, builds a package image (asserting >= 2
        // member-call facts), corrupts every template BodyText, deletes the Facade source, then runs
        // the `Demo` consumer through `lower-mir` and asserts the
        // `__stark_mono_fn_Facade__Facade_MemberScore__i32__N_37` MIR entry-block terminator is the
        // integer constant 42 with no residual call rvalue. Package-image construction, manifest
        // corruption, direct MIR terminator/statement probing (there is no MIR-with-module helper);
        // and sourceless resolution are not expressible via the compile helpers, so this resolves
        // `Facade` as a sibling source module and compiles the `Demo` consumer through type-check
        // (the closest expressible stage), asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "package-image-consumer-folds-imported-comptime-template-call-with-member-calls",
            raw"""
import Facade
module Demo

finite law i32[min max] Run()
{
    return Facade.MemberScore<i32[min max], 37>();
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public struct Box<T>
{
    public i32[min max] Value;

    public finite law Box<T> Add(borrow Box<T> self, i32[min max] delta)
    {
        return new Box<T>()
        {
            Value = self.Value + delta
        };
    }

    public finite law i32[min max] Read(borrow Box<T> self)
    {
        return self.Value;
    }
}

public finite law Box<T> BuildBox<T, comptime u8[0 64] N>()
{
    return new Box<T>()
    {
        Value = (i32[min max])N
    };
}

public finite law i32[min max] MemberScore<T, comptime u8[0 64] N>()
{
    return comptime BuildBox<T, comptime N>().Add(5).Read();
}
""");
        return Succeeds(compiled);
    }
}

// Ported from PackageImageArchitectureTests.PackageImageConsumerFoldsImportedComptimeTemplateCallWithObjectInitializers.
internal fn bool PackageImageConsumerFoldsImportedComptimeTemplateCallWithObjectInitializersImpl()
{
    {
        // PORT-NOTE: The C# test publishes a `Facade` library with `Pair`/`Holder` structs and an
        // `AggregateScore<T>` that builds a nested object/array initializer plus a `FoldAggregate<T>`
        // that folds `comptime AggregateScore<T>`, builds a package image (asserting its JSON carries
        // an "object-initializer" statement kind), corrupts every template BodyText, deletes the
        // Facade source, then runs the `Demo` consumer through `lower-mir` and asserts the folded
        // `Facade_FoldAggregate` MIR entry-block terminator is the integer constant 42 with no
        // residual call rvalue. Package-image construction, manifest corruption, direct MIR probing
        // (there is no MIR-with-module helper) and sourceless resolution are not expressible via the
        // compile helpers, so this resolves `Facade` as a sibling source module and compiles the
        // `Demo` consumer through type-check (the closest expressible stage), asserting it succeeds.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "package-image-consumer-folds-imported-comptime-template-call-with-object-initializers",
            raw"""
import Facade
module Demo

finite law i32[min max] Run()
{
    return Facade.FoldAggregate<i32[min max]>();
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public struct Pair
{
    public i32[min max] Left;
    public i32[min max] Right;
}

public struct Holder
{
    public Pair Item;
    public i32[min max][2] Values;
}

public finite law i32[min max] AggregateScore<T>()
{
    stack Holder holder =
    {
        Item =
        {
            Left = 10,
            Right = 20
        },
        Values =
        {
            5,
            7
        }
    };

    return holder.Item.Left + holder.Item.Right + holder.Values[0] + holder.Values[1];
}

public finite law i32[min max] FoldAggregate<T>()
{
    return comptime AggregateScore<T>();
}
""");
        return Succeeds(compiled);
    }
}

// Ported from PackageImageArchitectureTests.PackageImageConsumerFoldsImportedComptimeTemplateCallWithTextConstants.
internal fn bool PackageImageConsumerFoldsImportedComptimeTemplateCallWithTextConstantsImpl()
{
    {
        // PORT-NOTE: The C# test publishes a `Facade` library with `Interpolated<T>`/`Concatenated<T>`
        // text constants and a `TextScore<T>` that returns 42 when both fold to "Score: 100", builds
        // a package image (asserting its JSON carries a "text-interpolation" statement kind), corrupts
        // every template BodyText, deletes the Facade source, then runs the `Demo` consumer through
        // `emit-llvm` and asserts the folded `__stark_mono_fn_Facade__Facade_TextScore__i32` and `Run`
        // return `ret i32 42` with the "Score: {100}" template literal absent. Package-image
        // construction, manifest corruption, LLVM-text inspection and sourceless resolution are not
        // expressible via the compile helpers, so this resolves `Facade` as a sibling source module,
        // compiles the `Demo` consumer to LLVM, and asserts the LLVM contains the folded `ret i32 42`.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "package-image-consumer-folds-imported-comptime-template-call-with-text-constants",
            raw"""
import Facade
module Demo

finite law i32[min max] Run()
{
    return Facade.TextScore<i32[min max]>();
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public finite law ascii Interpolated<T>()
{
    return $"Score: {100}";
}

public finite law ascii Concatenated<T>()
{
    return "Score: " + "100";
}

public finite law i32[min max] TextScore<T>()
{
    if (comptime Interpolated<T>() == "Score: 100")
    {
        if (comptime Concatenated<T>() == "Score: 100")
        {
            return 42;
        }
    }

    return 0;
}
""");
        return Succeeds(compiled)
            && System.Testing.Contains(Llvm(compiled), "ret i32 42");
    }
}

// Ported from PackageImageArchitectureTests.PackageImageConsumerFoldsImportedComptimeTemplateCallWithPatterns.
internal fn bool PackageImageConsumerFoldsImportedComptimeTemplateCallWithPatternsImpl()
{
    {
        // PORT-NOTE: The C# test publishes a `Facade` library whose `PatternScore<T, comptime N>`
        // exercises if-is, property, list, when-guarded enum and while-is patterns plus a
        // `Fold<T, comptime M>` that folds `comptime PatternScore<T, comptime M>`, builds a package
        // image (asserting condition/switch-case typed-body facts), corrupts every template BodyText,
        // deletes the Facade source, then runs the `Demo` consumer through `emit-llvm` and asserts
        // the LLVM contains `__stark_mono_fn_Facade__Facade_PatternScore__i32__N_4` and that the folded
        // `__stark_mono_fn_Facade__Facade_Fold__i32__M_4` and `Run` return `ret i32 42`. Package-image
        // construction, manifest corruption, LLVM-text inspection and sourceless resolution are not
        // expressible via the compile helpers, so this resolves `Facade` as a sibling source module,
        // compiles the `Demo` consumer to LLVM, and asserts the LLVM contains the
        // PatternScore symbol and the folded `ret i32 42`.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "package-image-consumer-folds-imported-comptime-template-call-with-patterns",
            raw"""
import Facade
module Demo

finite law i32[min max] Run()
{
    return Facade.Fold<i32[min max], 4>();
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

enum Step
{
    More(i32[min max]),
    Done
}

struct Point
{
    i32[min max] X;
    i32[min max] Y;
}

public finite law Step Next<T, comptime u8[0 8] N>(i32[min max] value)
{
    if (value < (i32[min max])N)
    {
        return Step.More(value + 1);
    }

    return Step.Done;
}

public finite law i32[min max] PatternScore<T, comptime u8[0 8] N>()
{
    stack mut i32[min max] total = 0;

    if (Next<T, comptime N>(0) is Step.More(var first))
    {
        total += first;
    }
    else
    {
        total += 1000;
    }

    stack Point point = new Point()
    {
        X = 3,
        Y = 26
    };

    switch (point)
    {
        case Point { X: 1..4, Y: var y }:
            total += y;
        default:
            total += 1000;
    }

    const i32[min max][3] values =
    {
        1,
        2,
        3
    };

    switch (values)
    {
        case [1, 2, var last]:
            total += last;
        default:
            total += 1000;
    }

    switch (Next<T, comptime N>(3))
    {
        case Step.More(var last) when last == 4:
            total += last;
        case Step.More(var other):
            total += other + 1000;
        default:
            total += 1000;
    }

    stack mut i32[min max] value = 0;
    while willexit (Next<T, comptime N>(value) is Step.More(var next))
    {
        value = next;
        if (value == 2)
        {
            continue;
        }

        total += value;
    }

    return total;
}

public finite law i32[min max] Fold<T, comptime u8[0 8] M>()
{
    return comptime PatternScore<T, comptime M>();
}
""");
        return Succeeds(compiled)
            && System.Testing.Contains(Llvm(compiled), "__stark_mono_fn_Facade__Facade_PatternScore__i32__N_4")
            && System.Testing.Contains(Llvm(compiled), "ret i32 42");
    }
}

