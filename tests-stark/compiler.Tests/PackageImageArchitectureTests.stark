// Ported from PackageImageArchitectureTests.PackageImageConsumerLowersImportedComptimeGenericTemplateTypedBody.
internal fn bool PackageImageConsumerLowersImportedComptimeGenericTemplateTypedBodyImpl()
{
    {
        // PORT-NOTE: The C# test publishes a `Facade` library with `Pick<comptime N>` and a
        // `Forward<comptime N>` that calls `Pick<comptime N>`, builds a package image, corrupts the
        // Forward template BodyText, deletes the Facade source, runs the `Demo` consumer through
        // `lower-hir` to probe the `Facade_Pick`/`N_5` specialization's comptime value, then through
        // `emit-llvm` and asserts the LLVM contains `__stark_mono_fn_Facade__Facade_Forward__N_5` and
        // that `__stark_mono_fn_Facade__Facade_Pick__N_5` folds to `ret i8 5`. Package-image
        // construction, manifest corruption, HIR specialization probing and sourceless resolution are
        // not expressible via the compile helpers, so this resolves `Facade` as a sibling source
        // module, compiles the `Demo` consumer to LLVM, and asserts the LLVM contains the
        // monomorphized Forward symbol and the folded `ret i8 5` Pick body.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "package-image-consumer-lowers-imported-comptime-generic-template-typed-body",
            raw"""
import Facade
module Demo

finite law u8[0 max] Run()
{
    return Facade.Forward<5>();
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public finite law u8[0 max] Pick<comptime u8[1 8] N>()
{
    return N;
}

public finite law u8[0 max] Forward<comptime u8[1 8] N>()
{
    return Pick<comptime N>();
}
""");
        return Succeeds(compiled)
            && System.Testing.Contains(Llvm(compiled), "__stark_mono_fn_Facade__Facade_Forward__N_5")
            && System.Testing.Contains(Llvm(compiled), "ret i8 5");
    }
}

