// Ported from PackageImageArchitectureTests.PackageImagePreservesDynTraitStructuralFactsAcrossTypedInterfaceSourceBridgeAndFacts.
internal fn bool PackageImagePreservesDynTraitStructuralFactsAcrossTypedInterfaceSourceBridgeAndFactsImpl()
{
    {
        // PORT-NOTE: The C# test publishes a `Facade` library of dyn-trait declarations, view/heap
        // aliases, dyn-trait fields/payloads/associated-types/method signatures and nested
        // generic/fnptr/closure/array/rawptr aliases, builds a package image through `lower-abi`,
        // round-trips each dyn-trait source line, probes the loaded TypeAliases/NamedTypes
        // DynTrait facts, deletes the Facade source, then runs the `Demo` consumer (EmitLlvmIr) whose
        // MetadataScore returns 7 when every dyn-trait predicate holds and asserts its `Run` LLVM
        // body folds to `ret i64 7` with no residual `call`. Manifest round-tripping, dyn-trait fact
        // probing, sourceless resolution and LLVM-text inspection are not expressible via the
        // compile helpers, so this resolves `Facade` as a sibling source module and asserts the
        // `Demo` consumer (carrying the full comptime dyn-trait-fact body) type-checks.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "package-image-preserves-dyn-trait-structural-facts-typed-interface-source-bridge-facts",
            raw"""
import Facade
module Demo

finite law i64[min max] MetadataScore()
{
    if (comptime !System.Compiler.IsDynTrait<Facade.SpeakerView>()) { return 101; }
    if (comptime !System.Compiler.DynTraitIsView<Facade.SpeakerView>()) { return 102; }
    if (comptime !System.Compiler.DynTraitIsHeap<Facade.SpeakerOwner>()) { return 103; }
    if (comptime !System.Compiler.DynTraitTargetTypeIs<Facade.SpeakerView, Facade.Speaker>()) { return 104; }
    if (comptime !System.Compiler.DynTraitTargetTypeIs<Facade.ListenerView, Facade.Listener>()) { return 105; }
