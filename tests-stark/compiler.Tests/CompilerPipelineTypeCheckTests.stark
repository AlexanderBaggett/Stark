import CompilerTestSupport
import System.Testing
module CompilerPipelineTypeCheckTests

// Ported from CompilerPipelineTypeCheckTests.ManifestBackedGenericEnumsRecordTypeInstantiationTriggersWithoutSourceFiles.
internal fn bool ManifestBackedGenericEnumsRecordTypeInstantiationTriggersWithoutSourceFilesImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, writes the
    // manifest JSON, then re-imports Facade (no source files) into the consumer and asserts
    // the TypeCheckModel.TypeTriggers contains "Facade.IOResult<i32>". Package-image build,
    // manifest round-tripping, FileSystemModuleResolver, and TypeTriggers inspection are not
    // expressible with the Stark helpers, so this is reduced to compiling the consumer program
    // (which instantiates Facade.IOResult<i32[min max]>) through type-check and asserting it
    // succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "typecheck-manifest-generic-enum-trigger-consumer",
        raw"""
import Facade
module Demo

finite law i32[min max] Unwrap(Facade.IOResult<i32[min max]> result)
{
    switch (result)
    {
        case Facade.IOResult<i32[min max]>.Ok(var value):
            return value;
        case Facade.IOResult<i32[min max]>.Err(var code):
            return code;
    }
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineTypeCheckTests.ManifestBackedGenericFunctionsRecordInstantiationTriggersWithoutSourceFiles.
internal fn bool ManifestBackedGenericFunctionsRecordInstantiationTriggersWithoutSourceFilesImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, writes the
    // manifest JSON, then re-imports Facade (no source files) into the consumer and asserts a
    // single TypeCheckModel.InstantiationTriggers entry for "Facade.Identity" with type
    // arguments ["i32"] and return type "i32". Package-image build, manifest round-tripping,
    // FileSystemModuleResolver, and InstantiationTriggers inspection are not expressible with
    // the Stark helpers, so this is reduced to compiling the consumer program (which
    // instantiates the generic Facade.Identity) through type-check and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "typecheck-manifest-generic-function-trigger-consumer",
        raw"""
import Facade
module Demo

unsafe fn i32[min max] Run()
{
    stack i32[min max] value = 4;
    return Facade.Identity(value);
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineTypeCheckTests.ManifestBackedStaticMemberFunctionsPreserveStaticAndFunctionKindContracts.
internal fn bool ManifestBackedStaticMemberFunctionsPreserveStaticAndFunctionKindContractsImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, asserts the
    // manifest's typed interface records Allocator.Default as IsStatic with Kind "finitelaw",
    // writes the manifest, then re-imports Facade into the consumer and asserts
    // TypeCheckModel.Functions["Facade.Allocator.Default"].IsStatic. Package-image build,
    // manifest inspection, FileSystemModuleResolver, and Functions-table inspection are not
    // expressible with the Stark helpers, so this is reduced to compiling the consumer program
    // (which calls the static Facade.Allocator.Default()) through type-check and asserting it
    // succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "typecheck-manifest-static-member-consumer",
        raw"""
import Facade
module Demo

fn Facade.Allocator Run()
{
    return Facade.Allocator.Default();
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineTypeCheckTests.ManifestBackedMemberFunctionsPreserveVisibility.
internal fn bool ManifestBackedMemberFunctionsPreserveVisibilityImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, asserts the
    // typed-interface and source-surface visibilities of Box.Visible ("public") and Box.Hidden
    // ("internal"), writes the manifest, then re-imports Facade into a consumer that calls the
    // internal box.Hidden() and asserts the imported Facade module's Box.Hidden declaration is
    // StarkVisibility.Internal. The C# consumer succeeds at type-check (visibility is recorded,
    // not yet enforced here), so this is reduced to compiling the consumer program through
    // type-check and asserting it succeeds; package-image build, manifest inspection,
    // FileSystemModuleResolver, and LoadedModules visibility inspection are not expressible
    // with the Stark helpers.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "typecheck-manifest-method-visibility-consumer",
        raw"""
import Facade
module Demo

fn i32[min max] Run()
{
    stack Facade.Box box = new Facade.Box()
    {
        Value = 1
    };
    return box.Hidden();
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineTypeCheckTests.ManifestBackedGlobalsResolveFromPackageImageFactsWhenBridgeGlobalSourceIsCorrupted.
internal fn bool ManifestBackedGlobalsResolveFromPackageImageFactsWhenBridgeGlobalSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, builds an imported
    // module document, asserts PackageImageFacts.Globals contains Facade.Answer / Facade.Counter,
    // then deliberately corrupts the bridge source text (replacing the global type with Missing);
    // and re-imports through a DocumentOnlyModuleResolver to prove globals resolve from
    // package-image facts rather than the corrupted source. It finally asserts
    // TypeCheckModel.Globals["Facade.Answer"] is const "u8[42 42]" and Facade.Counter is mutable
    // "i32". Package-image build, document corruption, DocumentOnlyModuleResolver, and Globals-table
    // inspection are not expressible with the Stark helpers, so this is reduced to compiling the
    // consumer program (which reads Facade.Answer) through type-check and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "typecheck-manifest-global-facts-consumer",
        raw"""
import Facade
module Demo

unsafe fn i32[min max] Run()
{
    return Facade.Answer;
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineTypeCheckTests.ManifestBackedNamedTypeShapeResolvesFromPackageImageFactsWhenBridgeTypeSourceIsCorrupted.
internal fn bool ManifestBackedNamedTypeShapeResolvesFromPackageImageFactsWhenBridgeTypeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, builds an imported
    // module document, asserts PackageImageFacts.NamedTypes["Facade.Box"] has field Value of type
    // "i32", then corrupts the bridge source text (replacing the field with "Missing Wrong;") and
    // re-imports through a DocumentOnlyModuleResolver to prove the named-type shape resolves from
    // package-image facts. It finally asserts TypeCheckModel.NamedTypes["Facade.Box"] still has
    // field Value of type "i32". Package-image build, document corruption,
    // DocumentOnlyModuleResolver, and NamedTypes-table inspection are not expressible with the
    // Stark helpers, so this is reduced to compiling the consumer program (which reads box.Value);
    // through type-check and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "typecheck-manifest-type-facts-consumer",
        raw"""
import Facade
module Demo

unsafe fn i32[min max] Run()
{
    stack Facade.Box box = new Facade.Box()
    {
        Value = 3
    };
    return box.Value;
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineTypeCheckTests.ManifestBackedRecordPrimaryConstructorsResolveFromPackageImageFactsWhenBridgeTypeSourceIsCorrupted.
internal fn bool ManifestBackedRecordPrimaryConstructorsResolveFromPackageImageFactsWhenBridgeTypeSourceIsCorruptedImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, builds an imported
    // module document, asserts PackageImageFacts.Constructors["Facade.Counter"] holds a single
    // primary-shape constructor with one "i32" parameter, then corrupts the bridge source text
    // (record Counter(Missing Value)) and re-imports through a DocumentOnlyModuleResolver to prove
    // the primary constructor resolves from package-image facts. It finally asserts the consumer's
    // single ObjectCreation binds a primary-shape constructor with one "i32" parameter.
    // Package-image build, document corruption, DocumentOnlyModuleResolver, and ObjectCreations
    // inspection are not expressible with the Stark helpers, so this is reduced to compiling the
    // consumer program (which constructs Facade.Counter via its primary constructor) through
    // type-check and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "typecheck-manifest-record-primary-ctor-consumer",
        raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] value)
{
    stack Facade.Counter counter = new Facade.Counter(value);
    return counter.Value;
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineTypeCheckTests.ManifestBackedExplicitStructConstructorsResolveFromPackageImageFactsWithoutBridgeDeclarations.
internal fn bool ManifestBackedExplicitStructConstructorsResolveFromPackageImageFactsWithoutBridgeDeclarationsImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, asserts
    // PackageImageFacts.Constructors["Facade.Box"] holds a single explicit (non-primary);
    // constructor with one "i32" parameter and that the bridge source omits the explicit
    // declaration, writes the manifest, deletes the Facade source, then re-imports Facade into a
    // consumer that constructs Facade.Box(value) and asserts the single ObjectCreation binds the
    // explicit (non-primary) constructor with one "i32" parameter. Package-image build, manifest
    // inspection, source deletion, FileSystemModuleResolver, and ObjectCreations inspection are
    // not expressible with the Stark helpers, so this is reduced to compiling the consumer program
    // through type-check and asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "typecheck-manifest-explicit-struct-ctor-consumer",
        raw"""
import Facade
module Demo

fn void Run(i32[min max] value)
{
    stack Facade.Box box = new Facade.Box(value);
}
""");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineTypeCheckTests.ManifestBackedExplicitRecordConstructorsResolveFromPackageImageFactsWithoutBridgeDeclarations.
internal fn bool ManifestBackedExplicitRecordConstructorsResolveFromPackageImageFactsWithoutBridgeDeclarationsImpl()
{
    // PORT-NOTE: The C# test publishes the Facade library to a package image, asserts
    // PackageImageFacts.Constructors["Facade.Counter"] holds a primary-shape constructor (one
    // "i32" parameter) and an explicit constructor (two "i32" parameters) and that the bridge
    // source omits the explicit declaration, writes the manifest, deletes the Facade source, then
    // re-imports Facade into a consumer that constructs Facade.Counter(value, 7) and asserts the
    // single ObjectCreation binds the explicit (non-primary) constructor with two "i32"
    // parameters. Package-image build, manifest inspection, source deletion,
    // FileSystemModuleResolver, and ObjectCreations inspection are not expressible with the Stark
    // helpers, so this is reduced to compiling the consumer program through type-check and
    // asserting it succeeds.
    stack mut LlvmCompile compiled = CompileTypeCheck(
        "typecheck-manifest-explicit-record-ctor-consumer",
        raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] value)
{
    stack Facade.Counter counter = new Facade.Counter(value, 7);
    return counter.Value;
}
""");
    return Succeeds(compiled);
}
