import CompilerTestSupport
import System.Testing
module PackageImageTypedTerminalIfIntegrationTests

// Ported from PackageImageTypedTerminalIfIntegrationTests.ManifestBackedTypedTerminalIfBodiesCompileAndRunWithoutSyntheticSource.
internal fn bool ManifestBackedTypedTerminalIfBodiesCompileAndRunWithoutSyntheticSourceImpl()
{
    // PORT-NOTE: original is a multi-stage CLI/runtime integration test. It (1);
    // emits a static library from the Facade package source (--emit-lib),
    // asserting CLI exit 0, "Emitted static library:" stdout, empty stderr, and
    // that the library + .starkpkg manifest exist; (2) loads the manifest and
    // asserts the Facade module's ChooseTerminal generic template has a null
    // BodyText but a non-null TypedBody; (3) rewrites the manifest to a
    // typed-only form, deletes the Facade source, then links a Demo program that
    // imports the manifest-backed Facade (--emit-exe -I), asserting CLI exit 0,
    // "Emitted executable:" stdout, empty stderr, output existence, empty process
    // stdout/stderr, and a runtime exit code of 7. The Stark compile helpers
    // cannot model --emit-lib/--emit-exe, package-image manifest loading or
    // rewriting, manifest-backed cross-module imports, or the linked executable's
    // runtime exit code. Reduced to compiling the Facade package source (the
    // program whose typed terminal-if bodies the test is built around) through the
    // full pipeline and returning Succeeds.
    stack mut LlvmCompile compiled = CompileFull(
        "pkgimg-typed-terminal-if-facade",
        raw"""
module Facade

public fn i32[min max] ChooseTerminal<T>(bool takeLeft, bool takeMiddle, i32[min max] left, i32[min max] middle, i32[min max] right, T tag)
{
    if (takeLeft)
    {
        return left;
    }
    else if (takeMiddle)
    {
        return middle;
    }
    else
    {
        return right;
    }
}
""");
    return Succeeds(compiled);
}
