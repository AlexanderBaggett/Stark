import CompilerTestSupport
import System.Testing

module CompilerCliTests_PKGIMGP1

// Ported from CompilerCliTests.EmitLibraryModeBuildsStaticLibraryAndManifest.
public unsafe fn bool EmitLibraryModeBuildsStaticLibraryAndManifestImpl()
{
    unsafe
    {
        // PORT-NOTE: The original drives the `--emit-lib -o` CLI path and asserts
        // CLI stdout ("Emitted static library:", "Emitted package image:"), empty
        // stderr, exit code 0, the on-disk static library (.a/.lib) existing and
        // being non-empty, the .starkpkg manifest existing, and the loaded package
        // manifest's RootModule/Modules/SourceSurface re-exports and functions.
        // The compile helpers cannot express CLI process output, file-system
        // effects, or package-image manifest contents, so this is reduced to
        // compiling the same two-module program (root `Facade` plus dependency
        // `Math`) through the LLVM pipeline and asserting it succeeds.
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "cli-emit-lib-static-library-manifest",
            raw"""
export import Math
module Facade

public finite law i32[min max] Double(i32[min max] value)
{
    return Math.Add(value, value);
}
""",
            "",
            "Math.stark",
            raw"""
module Math

public finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}
""");
        return Succeeds(compiled);
    }
}
