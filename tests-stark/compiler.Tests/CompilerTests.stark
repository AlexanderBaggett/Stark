[Fact]
[Collection("traits")]
fn bool DoctrinesCannotBeUsedAsRuntimeValueTypes()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-doctrine-runtime-value",
            raw"""
module Demo

public doctrine Numbers
{
    law i32[min max] Zero();
}

struct Holder
{
    Numbers Laws;
}

static Numbers Current;

fn Numbers Echo(Numbers value)
{
    return value;
}

fn void Run()
{
    stack Numbers local = new Numbers();
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3013", "field 'Laws' in type 'Holder'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3013", "a global variable type") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3013", "parameter 'value'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3013", "the return type of function 'Echo'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3013", "a local variable type") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3013", "Cannot create an instance of compile-time-only doctrine 'Numbers'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3013", "no runtime dispatch values for traits or doctrines") >= 1;
    }
}

