[Fact]
[Collection("patterns")]
fn bool TryOnEnumWithoutRolesIsRejected()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "patdiag-try-enum-without-roles",
            raw"""
module Demo

enum LowErr { Disk }
enum HighErr { Low from LowErr, Other }

// Role-annotated propagatable enums with deliberately non-conventional names:
// recognition must work purely from the [Ok]/[Err] roles.
enum FetchOutcome<T>
{
    [Ok] Got(T),
    [Err] Failed(LowErr),
}

enum LoadOutcome<T>
{
    [Ok] Loaded(T),
    [Err] Broke(HighErr),
}

enum Lookup<T>
{
    [Ok] Hit(T),
    [Err] Miss,
}

fn FetchOutcome<i32[min max]> Fetch(i32[min max] x)
{
    return FetchOutcome<i32[min max]>.Got(x + 1);
}

fn Lookup<i32[min max]> Find(i32[min max] x)
{
    return Lookup<i32[min max]>.Hit(x);
}
enum Plain<T> { Ok(T), Err(LowErr) }

fn Plain<i32[min max]> Get() { return Plain<i32[min max]>.Ok(1); }

fn Plain<i32[min max]> BadOperand()
{
    stack i32[min max] n = try Get();
    return Plain<i32[min max]>.Ok(n);
}
""");
        return FailsWithDiagnostic(compiled, "STK3039");
    }
}

[Fact]
fn bool TryMixingPayloadAndUnitFailuresIsRejected()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "patdiag-try-mixed-unit-payload",
            raw"""
module Demo

enum LowErr { Disk }
enum HighErr { Low from LowErr, Other }

// Role-annotated propagatable enums with deliberately non-conventional names:
// recognition must work purely from the [Ok]/[Err] roles.
enum FetchOutcome<T>
{
    [Ok] Got(T),
    [Err] Failed(LowErr),
}

enum LoadOutcome<T>
{
    [Ok] Loaded(T),
    [Err] Broke(HighErr),
}

enum Lookup<T>
{
    [Ok] Hit(T),
    [Err] Miss,
}

fn FetchOutcome<i32[min max]> Fetch(i32[min max] x)
{
    return FetchOutcome<i32[min max]>.Got(x + 1);
}

fn Lookup<i32[min max]> Find(i32[min max] x)
{
    return Lookup<i32[min max]>.Hit(x);
}
fn LoadOutcome<i32[min max]> Mixed(i32[min max] x)
{
    stack i32[min max] n = try Find(x);
    return LoadOutcome<i32[min max]>.Loaded(n);
}
""");
        return FailsWithDiagnostic(compiled, "STK3038");
    }
}

