module Demo

unsafe fn void Run(rawptr<i32[min max]> pointer)
{
    unsafe
    {
        stack i32[min max][] view = slice(pointer);
    }
}
""");
        stack mut LlvmCompile indexNonInteger = CompileFull(
            "typtyping-fallback-index-non-integer",
            raw"""
module Demo

fn i32[min max] Run(bool flag)
{
    stack i32[min max][2] values =
    {
        1, 2
    };
    return values[flag];
}
""");
        stack mut LlvmCompile emptyIndexArity = CompileFull(
            "typtyping-fallback-empty-index",
            raw"""
module Demo

fn i32[min max] Run()
{
    stack i32[min max][2] values =
    {
        1, 2
    };
    values[];
    return 0;
}
""");
        stack mut LlvmCompile dynamicIndexArity = CompileFull(
            "typtyping-fallback-dynamic-index",
            raw"""
module Demo

fn i32[min max] Run()
{
    stack mut dynamic i32[min max] values = new();
    return values[0, 1, 2];
}
""");
        stack mut LlvmCompile textIndexArity = CompileFull(
            "typtyping-fallback-text-index",
            raw"""
module Demo

fn ascii Run(ascii text)
{
    return text[1, 2, 3];
}
""");
        stack mut LlvmCompile reserveShape = CompileFull(
            "typtyping-fallback-reserve-shape",
            raw"""
module Demo

fn void Run()
{
    stack mut dynamic i32[min max] values = new();
    values.Reserve(true);
}
""");
        stack mut LlvmCompile moveAtArity = CompileFull(
            "typtyping-fallback-moveat-arity",
            raw"""
module Demo

fn void Run()
{
    stack mut dynamic i32[min max] values = new();
    values.MoveAt();
}
""");
        stack mut LlvmCompile moveLastReceiver = CompileFull(
            "typtyping-fallback-movelast-receiver",
            raw"""
module Demo

fn dynamic i32[min max] Make()
{
    return new();
}

fn void Run()
{
    Make().MoveLast();
}
""");
        stack mut LlvmCompile capacityType = CompileFull(
            "typtyping-fallback-capacity-type",
            raw"""
module Demo

fn void Run()
{
    stack mut dynamic i32[min max] values = new(true);
}
""");
        stack mut LlvmCompile creationObjectInit = CompileFull(
            "typtyping-fallback-new-object-init",
            raw"""
module Demo

fn void Run()
{
    stack mut dynamic i32[min max] values = new()
    {
        Length = 1
    };
}
""");
        stack mut LlvmCompile textBufferInit = CompileFull(
            "typtyping-fallback-text-buffer-init",
            raw"""
module Demo

fn void Run(Ascii left)
{
    stack Ascii text[16] =
    {
        left
    };
}
""");
        stack mut LlvmCompile fnAsValue = CompileFull(
            "typtyping-fallback-fn-as-value",
            raw"""
module Demo

fn i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

fn void Run()
{
    Add;
}
""");
        stack mut LlvmCompile lambdaTarget = CompileFull(
            "typtyping-fallback-lambda-target",
            raw"""
module Demo

fn void Run()
{
    (i32[min max] value) => value + 1;
}
""");
        stack mut LlvmCompile lambdaCapture = CompileFull(
            "typtyping-fallback-lambda-capture",
            raw"""
module Demo

fn i32[min max] Apply(fnptr<fn i32[min max](i32[min max])> op)
{
    return op(41);
}

fn i32[min max] Run()
{
    stack i32[min max] offset = 1;
    return Apply(capture(copy offset) (i32[min max] value) => value + offset);
}
""");
        stack mut LlvmCompile interpStorage = CompileFull(
            "typtyping-fallback-interp-storage",
            raw"""
module Demo

fn ascii Run(i32[min max] score)
{
    return $"Score: {score}";
}
""");
        stack mut LlvmCompile switchDomain = CompileFull(
            "typtyping-fallback-switch-domain",
            raw"""
module Demo

fn void Run()
{
    stack fnptr<fn void()> values = null;
    switch (values)
    {
        default:
            return;
    }
}
""");
        stack mut LlvmCompile sizeofTrait = CompileFull(
            "typtyping-fallback-sizeof-trait",
            raw"""
module Demo

trait Marker
{
}

fn i64[0 max] Run()
{
    return sizeof(Marker);
}
""");
        stack mut LlvmCompile ffiTextReturn = CompileFull(
            "typtyping-fallback-ffi-text-return",
            raw"""
module Demo

unsafe ffi fn ascii CurrentName();
""");
        stack mut LlvmCompile unknownSymbol = CompileFull(
            "typtyping-fallback-unknown-symbol",
            raw"""
module Demo

fn i32[min max] Run()
{
    return Missing;
}
""");
        return FailsWithDiagnosticMessage(ctorReturn, "STK3002", "Constructor bodies cannot return a value")
            && FailsWithDiagnosticMessage(callArity, "STK3009", "Function 'Add'")
            && CountDiagnosticsWithCodeAndMessage(callArity, "STK3009", "expects 2 arguments") >= 1
            && CountDiagnosticsWithCodeAndMessage(callArity, "STK3009", "received 1") >= 1
            && FailsWithDiagnosticMessage(memberArity, "STK3009", "Function 'Box.Add'")
            && CountDiagnosticsWithCodeAndMessage(memberArity, "STK3009", "expects 1 arguments") >= 1
            && CountDiagnosticsWithCodeAndMessage(memberArity, "STK3009", "received 0") >= 1
            && FailsWithDiagnosticMessage(voidDirect, "STK3002", "Return statement expects 'i32'")
            && CountDiagnosticsWithCodeAndMessage(voidDirect, "STK3002", "found 'void'") >= 1
            && FailsWithDiagnosticMessage(voidMember, "STK3002", "Return statement expects 'i32'")
            && CountDiagnosticsWithCodeAndMessage(voidMember, "STK3002", "found 'void'") >= 1
            && FailsWithDiagnosticMessage(voidIndirect, "STK3002", "Return statement expects 'i32'")
            && CountDiagnosticsWithCodeAndMessage(voidIndirect, "STK3002", "found 'void'") >= 1
            && FailsWithDiagnosticMessage(memberBinding, "STK3021", "No overload of 'Box.Add' matches argument types (bool)")
            && FailsWithDiagnosticMessage(rawSliceArity, "STK3009", "Raw slice construction expects 2 arguments")
            && CountDiagnosticsWithCodeAndMessage(rawSliceArity, "STK3009", "received 1") >= 1
            && FailsWithDiagnosticMessage(indexNonInteger, "STK3002", "Index access")
            && CountDiagnosticsWithCodeAndMessage(indexNonInteger, "STK3002", "expects an integer index") >= 1
            && CountDiagnosticsWithCodeAndMessage(indexNonInteger, "STK3002", "bool") >= 1
            && FailsWithDiagnosticMessage(emptyIndexArity, "STK3002", "Index access requires at least one index expression")
            && FailsWithDiagnosticMessage(dynamicIndexArity, "STK3008", "Dynamic storage indexing supports either one integer index or two integer expressions")
            && FailsWithDiagnosticMessage(textIndexArity, "STK3008", "Text indexing currently supports exactly one integer index or two integer expressions")
            && FailsWithDiagnosticMessage(reserveShape, "STK3002", "Dynamic storage Reserve")
            && CountDiagnosticsWithCodeAndMessage(reserveShape, "STK3002", "additional capacity") >= 1
            && CountDiagnosticsWithCodeAndMessage(reserveShape, "STK3002", "must be an integer") >= 1
            && CountDiagnosticsWithCodeAndMessage(reserveShape, "STK3002", "bool") >= 1
            && FailsWithDiagnosticMessage(moveAtArity, "STK3009", "Dynamic storage MoveAt")
            && CountDiagnosticsWithCodeAndMessage(moveAtArity, "STK3009", "expects one index argument") >= 1
            && CountDiagnosticsWithCodeAndMessage(moveAtArity, "STK3009", "received 0") >= 1
            && FailsWithDiagnosticMessage(moveLastReceiver, "STK3007", "Dynamic storage MoveLast")
            && CountDiagnosticsWithCodeAndMessage(moveLastReceiver, "STK3007", "requires a mutable addressable dynamic owner") >= 1
            && FailsWithDiagnosticMessage(capacityType, "STK3002", "Dynamic storage capacity")
            && CountDiagnosticsWithCodeAndMessage(capacityType, "STK3002", "must be an integer") >= 1
            && CountDiagnosticsWithCodeAndMessage(capacityType, "STK3002", "bool") >= 1
            && FailsWithDiagnosticMessage(creationObjectInit, "STK3008", "Dynamic storage creation")
            && CountDiagnosticsWithCodeAndMessage(creationObjectInit, "STK3008", "does not support object initializers") >= 1
            && CountDiagnosticsWithCodeAndMessage(creationObjectInit, "STK3008", "new(capacity)") >= 1
            && FailsWithDiagnosticMessage(textBufferInit, "STK3002", "Fixed text buffer 'text'")
            && CountDiagnosticsWithCodeAndMessage(textBufferInit, "STK3002", "needs a text-building initializer") >= 1
            && FailsWithDiagnosticMessage(fnAsValue, "STK3012", "Function 'Add' must be called before its value can be used")
            && FailsWithDiagnosticMessage(lambdaTarget, "STK3008", "Lambda expressions require an explicit function-pointer or closure target type")
            && FailsWithDiagnosticMessage(lambdaCapture, "STK3008", "lambda converted to 'fnptr<...>' cannot capture local state")
            && CountDiagnosticsWithCodeAndMessage(lambdaCapture, "STK3008", "function pointers do not carry closure storage") >= 1
            && FailsWithDiagnosticMessage(interpStorage, "STK3002", "Interpolated text with runtime value 'score' needs caller-owned storage")
            && CountDiagnosticsWithCodeAndMessage(interpStorage, "STK3002", "fixed-capacity buffer") >= 1
            && FailsWithDiagnosticMessage(switchDomain, "STK3008", "Switch expression type 'fnptr<fn void()>'")
            && CountDiagnosticsWithCodeAndMessage(switchDomain, "STK3008", "not a valid switch domain") >= 1
            && FailsWithDiagnosticMessage(sizeofTrait, "STK3008", "sizeof requires a concrete runtime layout")
            && CountDiagnosticsWithCodeAndMessage(sizeofTrait, "STK3008", "Marker") >= 1
            && FailsWithDiagnosticMessage(ffiTextReturn, "STK3008", "FFI function 'CurrentName'")
            && CountDiagnosticsWithCodeAndMessage(ffiTextReturn, "STK3008", "cannot return text view type 'ascii'") >= 1
            && CountDiagnosticsWithCodeAndMessage(ffiTextReturn, "STK3008", "raw pointer plus explicit length/status") >= 1
            && FailsWithDiagnosticMessage(unknownSymbol, "STK3003", "Unknown symbol 'Missing'");
    }
}

// ---------------------------------------------------------------------------
// SemanticValidationTests
// ---------------------------------------------------------------------------

[Fact]
[Collection("ffi", "types")]
fn bool StrictIntegerRangesRejectNonCanonicalStorageOutsideFfiBoundaries()
{
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-strict-ranges-noncanonical",
            raw"""
module Demo

alias SmallAlias = i32[0 255];

struct Box
{
    i32[0 255] Value;
    i32[0 127][4] Fixed;
}

struct Holder<T>
{
    T Value;
}

fn i64[0 max] Run(i32[1 10] parameter, Holder<i32[0 63]> holder)
{
    stack dynamic i32[0 7] values = new();
    stack i32[0 128] local = parameter;
    stack i32[0 9] converted = (i32[0 9])local;
    return local;
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK3014", "i32[0 255]")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i32[0 127]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8[0 127]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i64[0 9223372036854775807]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u64[0 9223372036854775807]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i32[1 10]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8[1 10]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i32[0 63]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8[0 63]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i32[0 7]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8[0 7]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i32[0 128]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8[0 128]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i32[0 9]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8[0 9]") >= 1;
    }
}

[Fact]
[Collection("ffi", "types")]
fn bool StrictIntegerRangesAllowFfiAbiSignatureStorage()
{
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-strict-ranges-ffi-abi",
            raw"""
module Demo

public unsafe ffi fn i32[0 255] Read(i32[0 255] value);
""",
            "semantic-validate",
            "");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("ffi", "types")]
fn bool StrictIntegerRangesAllowPlatformAnnotatedAbiSignatureStorage()
{
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-strict-ranges-platform-abi",
            raw"""
module Demo

[Platform]
unsafe fn i32[0 255] ReadPlatformStatus(i32[0 255] status)
{
    return status;
}
""",
            "semantic-validate",
            "");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("types")]
fn bool StrictIntegerRangesAllowPlatformAnnotatedAggregateFieldStorage()
{
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-strict-ranges-platform-field",
            raw"""
module Demo

[Platform]
struct HostStatus
{
    i32[0 255] Code;
}

fn i32[min max] Read(HostStatus status)
{
    return (i32[min max])status.Code;
}
""",
            "semantic-validate",
            "");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("types")]
fn bool StrictIntegerRangesStillRejectNonCanonicalLocalsInsidePlatformAnnotatedFunctions()
{
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-strict-ranges-platform-locals",
            raw"""
module Demo

[Platform]
unsafe fn i32[min max] Run()
{
    stack i32[0 255] status = 0;
    return status;
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK3014", "i32[0 255]")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8") >= 1;
    }
}

[Fact]
[Collection("types")]
fn bool StrictIntegerRangesRejectUnnecessarilyWideUnsignedAndSignedRanges()
{
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-strict-ranges-wide",
            raw"""
module Demo

fn u32[0 255] Run(u16[0 15] tag)
{
    stack i32[-1 1] delta = -1;
    return tag;
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK3014", "u32[0 255]")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u16[0 15]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8[0 15]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i32[-1 1]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i8[-1 1]") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool BorrowReturnTypesAreRejected()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "semval-borrow-return-rejected",
