[Fact]
[Collection("traits")]
fn bool GenericConstraintAcceptsConformingTypeArgument()
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-constraint-conforming",
            raw"""
module Demo

trait Drawable
{
    finite law i32[min max] Width(borrow Self self);
}

struct Widget : Drawable
{
    i32[min max] W;

    finite law i32[min max] Width(borrow Widget self)
    {
        return self.W;
    }
}

finite law i32[min max] Use<T>(borrow T value) where T: Drawable
{
    return 0;
}

export fn i32[min max] main()
{
    stack Widget w = new Widget() { W = 5 };
    return Use(w);
}
""",
            "instantiation-ownership",
            "");
        return compiled.Ok && !HasDiagnostic(compiled, "STK3034");
    }
}

[Fact]
[Collection("traits", "diagnostics")]
fn bool GenericConstraintRejectsNonConformingTypeArgument()
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-constraint-non-conforming",
            raw"""
module Demo

trait Drawable
{
    finite law i32[min max] Width(borrow Self self);
}

struct Plain
{
    i32[min max] V;
}

finite law i32[min max] Use<T>(borrow T value) where T: Drawable
{
    return 0;
}

export fn i32[min max] main()
{
    stack Plain p = new Plain() { V = 1 };
    return Use(p);
}
""",
            "instantiation-ownership",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK3034", "Plain")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3034", "Drawable") >= 1;
    }
}

[Fact]
[Collection("traits")]
fn bool BaseListDoesNotRequireDefaultTraitMethods()
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-trait-default-method",
            raw"""
module Demo

trait Greeter
{
    finite law i32[min max] Base(borrow Self self);

    finite law i32[min max] Doubled(borrow Self self)
    {
        return self.Base() * 2;
    }
}

struct Widget : Greeter
{
    i32[min max] V;

    finite law i32[min max] Base(borrow Widget self)
    {
        return self.V;
    }
}
""",
            "semantic-validate",
            "");
        return Succeeds(compiled) && !HasDiagnostic(compiled, "STK3032");
    }
}

