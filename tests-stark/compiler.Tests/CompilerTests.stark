// ---------------------------------------------------------------------------
// IfWhilePatternDiagnosticsTests
// ---------------------------------------------------------------------------

[Fact]
[Collection("patterns")]
fn bool IfPatternBindsCaptureIntoThenBranch()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "patdiag-if-pattern-binds-capture",
            raw"""
module Demo

enum Option<T> { Some(T), None }
enum Result<T, E> { Ok(T), Err(E) }
enum Other { A, B }

fn Option<i32[min max]> lookup(i32[min max] x) { return Option<i32[min max]>.Some(x); }
fn i32[min max] UseIf(i32[min max] n)
{
    if (lookup(n) is Option<i32[min max]>.Some(var value))
    {
        return value;
    }
    return 0;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("patterns")]
fn bool WhilePatternBindsCaptureIntoLoopBody()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "patdiag-while-pattern-binds-capture",
            raw"""
module Demo

enum Option<T> { Some(T), None }
enum Result<T, E> { Ok(T), Err(E) }
enum Other { A, B }

fn Option<i32[min max]> lookup(i32[min max] x) { return Option<i32[min max]>.Some(x); }
fn i32[min max] UseWhile(i32[min max] n)
{
    stack mut i32[min max] total = 0;
    while willexit (lookup(n) is Option<i32[min max]>.Some(var value))
    {
        total = total + value;
        return total;
    }
    return total;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("patterns")]
fn bool IfPatternCaptureIsNotVisibleInElseBranch()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "patdiag-if-capture-not-in-else",
            raw"""
module Demo

enum Option<T> { Some(T), None }
enum Result<T, E> { Ok(T), Err(E) }
enum Other { A, B }

fn Option<i32[min max]> lookup(i32[min max] x) { return Option<i32[min max]>.Some(x); }
fn i32[min max] LeakCapture(i32[min max] n)
{
    if (lookup(n) is Option<i32[min max]>.Some(var value))
    {
        return value;
    }
    else
    {
        return value;
    }
}
""");
        return compiled.Ok && !Succeeds(compiled);
    }
}

[Fact]
[Collection("patterns")]
fn bool IfPatternWithMismatchedEnumTypeIsRejected()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "patdiag-if-pattern-enum-mismatch",
            raw"""
module Demo

enum Option<T> { Some(T), None }
enum Result<T, E> { Ok(T), Err(E) }
enum Other { A, B }

fn Option<i32[min max]> lookup(i32[min max] x) { return Option<i32[min max]>.Some(x); }
fn i32[min max] Mismatch(i32[min max] n)
{
    if (lookup(n) is Result<i32[min max], Other>.Ok(var value))
    {
        return value;
    }
    return 0;
}
""");
        return compiled.Ok && !Succeeds(compiled);
    }
}

