[Fact]
[Collection("ownership", "lowering", "diagnostics")]
fn bool RuntimeDisjointConditionsCompileWithoutLoweringDiagnostic()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-runtime-disjoint-borrow",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn void Run(borrow Box left, borrow Box right)
{
    if disjoint(left, right)
    {
        return;
    }

    return;
}
""");
        return Succeeds(compiled)
            && !HasDiagnostic(compiled, "STK3026");
    }
}

[Fact]
[Collection("ownership", "lowering")]
fn bool RuntimeDisjointScalarOperandsFailBeforeMirLowering()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-runtime-disjoint-scalar",
            raw"""
module Demo

unsafe fn bool Run(i32[min max] left, i32[min max] right)
{
    if disjoint(left, right)
    {
        return true;
    }

    return false;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3025", "Runtime disjoint checks")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3025", "memory-backed operands") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3025", "i32") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool DisjointParameterCallsRejectObviousOverlappingArguments()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-disjoint-overlap-args",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    return;
}

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    Touch(ptr, ptr);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "violates disjoint parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "right") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "ptr") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool DefaultNonOverlapParametersRejectObviousOverlappingArguments()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-default-nonoverlap-args",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    return;
}

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    Touch(ptr, ptr);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "violates disjoint parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "default non-overlap") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "right") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "ptr") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool OverlapContractAllowsIntentionalOverlappingArguments()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-overlap-contract-allows",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
    where overlap(left, right)
    {
        *left = *right;
    return;
}

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    Touch(ptr, ptr);
    return;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("diagnostics")]
fn bool SameContractRejectsDistinctRegions()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-same-distinct-regions",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
    where same(left, right)
    {
        return;
}

unsafe fn void Run()
{
    stack mut i32[min max] left = 1;
    stack mut i32[min max] right = 2;
    Touch(&left, &right);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "same-memory parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "right") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "same memory region") >= 1;
    }
}

[Fact]
fn bool SameContractAcceptsSameRegion()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-same-accepts-same-region",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
    where same(left, right)
    {
        return;
}

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    Touch(ptr, ptr);
    return;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("ownership", "ffi", "diagnostics")]
fn bool DefaultNonOverlapRejectsImmutableRawPointerLocalAliases()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-immutable-ptr-local-alias",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    return;
}

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    stack rawmutptr<i32[min max]> mirror = ptr;
    Touch(ptr, mirror);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "violates disjoint parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "right") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "ptr") >= 1;
    }
}

