[Fact]
fn bool MovingOwnedLocalMakesLaterUseInvalid()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-moved-local-use-invalid",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

finite law void Consume(Box value)
{
    return;
}

finite law i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 1
    };
    Consume(box);
    return box.Value;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "Move error")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "was moved and must be reinitialized") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "was moved here") >= 1;
    }
}

[Fact]
fn bool DeadOnReturnCallMakesLocalStorageUnavailable()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-dead-on-return-local-use-invalid",
            raw"""
module Demo

fn bool WriteAndConsume(out u32[0 max] value) where dead_on_return(value)
{
    value = 7;
    return true;
}

fn u32[0 max] Run()
{
    stack mut u32[0 max] value = 1;
    if (!WriteAndConsume(value))
    {
        return 0;
    }

    return value;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "Move error")
            && AnyDiagnosticMessageContains(compiled, "value 'value'")
            && AnyDiagnosticMessageContains(compiled, "was moved");
    }
}

