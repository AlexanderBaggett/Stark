[Fact]
[Collection("patterns", "types")]
fn bool RangePatternRequiresIntegerTarget()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-range-pattern-int-target",
            raw"""
module Demo

fn i32[min max] Run(bool flag)
{
    switch (flag)
    {
        case 0..1:
            return 1;
        default:
            return 0;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Range pattern '0..1' requires an integer target")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "bool") >= 1;
    }
}

[Fact]
[Collection("patterns", "lowering", "diagnostics")]
fn bool RangePatternRejectsLowerBoundGreaterThanUpperBound()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-range-pattern-bound-order",
            raw"""
module Demo

fn i32[min max] Run(u8[0 10] value)
{
    switch (value)
    {
        case 10..0:
            return 1;
        default:
            return 0;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Range pattern '10..0' has lower bound 10 greater than upper bound 0");
    }
}

[Fact]
[Collection("ownership", "patterns", "types", "diagnostics")]
fn bool RangePatternRejectsNonOverlappingIntegerDomain()
{
