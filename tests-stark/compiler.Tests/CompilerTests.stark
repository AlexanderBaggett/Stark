[Fact]
[Collection("patterns")]
fn bool SwitchOrPatternsRejectInconsistentSharedCaptures()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-or-captures",
            raw"""
module Demo

enum Token
{
    Number(i32[min max]),
    Flag(bool),
    End,
}

fn i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.Number(var value) | Token.End:
            return 1;
        case Token.Flag(_):
            return 0;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Switch labels that share a body must bind the same capture names with the same types")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "Earlier label binds 'value: i32'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "this label binds no captures") >= 1;
    }
}

