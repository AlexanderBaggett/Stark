fn bool BranchMergeRequiresReinitializationOnEveryPath()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-branch-merge-requires-reinit",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 1
    };

    if (true)
    {
        Consume(box);
    }
    else
    {
        box = new Box()
        {
            Value = 2
        };
