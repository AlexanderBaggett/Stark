[Fact]
fn bool ConstSliceGlobalsRejectNonMaterializableExpressionInitializers()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "semval-const-slice-init",
            raw"""
module Demo

fn i32[min max][] Source();

