[Fact]
fn bool ConstParameterCallsRequireConstProvenance()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-const-call-provenance",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn void Inspect(const Box box)
{
    return;
}

fn void Run(Box box)
{
    Inspect(box);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3031", "must have const provenance")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3031", "box") >= 1;
    }
}

