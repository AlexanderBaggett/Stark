    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-generic-doctrine-flow",
            raw"""
module Demo

struct Box<T>
{
    T Value;

    drop
    {
    }
}

doctrine Sink<T>
{
    finite law void Consume(Box<T> value)
    {
        return;
    }
}

finite law i32[min max] Run()
{
    stack Box<i32[min max]> box = new Box<i32[min max]>()
    {
