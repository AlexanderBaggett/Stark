const i32[min max][3] Values =
{
    1, 2, 3
};

fn void Run()
{
    stack rawmutptr<i32[min max]> ptr = (rawmutptr<i32[min max]>)(&Values[0]);
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3002", "rawptr<frozen i32>")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "rawmutptr<i32>") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "strengthen pointer mutability") >= 1;
    }
}

