[Fact]
[Collection("ownership", "ffi")]
fn bool DefaultNonOverlapAcceptsMutableRawPointerInitializersFromDistinctRoots()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-mut-ptr-init-distinct-roots",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    *left = *right;
    return;
}

unsafe fn void Run()
{
    stack mut i32[min max] leftValue = 1;
    stack mut i32[min max] rightValue = 2;
    stack mut rawmutptr<i32[min max]> left = &leftValue;
    stack mut rawmutptr<i32[min max]> right = &rightValue;
    Touch(left, right);
    return;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("ownership", "ffi")]
fn bool SameContractAcceptsMutableRawPointerInitializerAlias()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-same-mut-ptr-init-alias",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
    where same(left, right)
    {
        return;
}

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    stack mut rawmutptr<i32[min max]> mirror = ptr;
    Touch(ptr, mirror);
    return;
}
""");
