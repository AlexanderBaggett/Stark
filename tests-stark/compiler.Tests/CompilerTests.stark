[Fact]
[Collection("types")]
fn bool StrictIntegerRangesStillRejectNonCanonicalLocalsInsidePlatformAnnotatedFunctions()
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-strict-ranges-platform-locals",
            raw"""
module Demo

[Platform]
unsafe fn i32[min max] Run()
{
    stack i32[0 255] status = 0;
    return status;
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK3014", "i32[0 255]")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8") >= 1;
    }
}

[Fact]
[Collection("types")]
fn bool StrictIntegerRangesRejectUnnecessarilyWideUnsignedAndSignedRanges()
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-strict-ranges-wide",
            raw"""
module Demo

fn u32[0 255] Run(u16[0 15] tag)
{
    stack i32[-1 1] delta = -1;
    return tag;
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK3014", "u32[0 255]")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u16[0 15]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "u8[0 15]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i32[-1 1]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3014", "i8[-1 1]") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool BorrowReturnTypesAreRejected()
{
