[Fact]
[Collection("ownership")]
fn bool TypeAliasCyclesAreRejected()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-alias-cycle",
            raw"""
module Demo

alias A = B;
alias B = A;

fn void Use(A value)
{
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3023", "participates in a cycle");
    }
}

[Fact]
[Collection("patterns", "ffi")]
fn bool FfiFunctionsRejectAggregateTypesThatTransitivelyDependOnEnums()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-ffi-aggregate-enum-abi",
            raw"""
module Demo

enum Token
{
    End,
}

struct State
{
    Token Current;
}

unsafe ffi fn void Use(State value);
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Type 'State'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "depends on enum 'Token'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "cannot cross FFI/export boundaries") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "parameter 'value'") >= 1;
    }
}

[Fact]
[Collection("patterns")]
fn bool GlobalTypesRejectAggregateTypesThatTransitivelyDependOnEnums()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-global-aggregate-enum",
            raw"""
module Demo

enum Token
{
    End,
}

struct Inner
{
    Token Value;
}

struct Outer
{
    Inner Current;
}

static Outer Shared = new Outer()
{
    Current = new Inner()
    {
        Value = Token.End
    }
};
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Type 'Outer'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "depends on enum 'Token'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "enum-dependent runtime layout is not valid in a global variable type") >= 1;
    }
}

[Fact]
[Collection("ownership", "patterns")]
fn bool AggregateSwitchPatternsRejectMoveOnlyFieldCaptures()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-move-only-capture",
            raw"""
module Demo

struct Box
{
    Ascii Text;
}

fn i32[min max] Run(Box value)
{
    switch (value)
    {
        case Box(var text):
            return 1;
        default:
            return 0;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Field 'Text'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "cannot currently be captured") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "scalar and text-view field types") >= 1;
    }
}

[Fact]
[Collection("patterns")]
fn bool FixedArrayListSwitchPatternsRejectWrongLength()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-list-length",
            raw"""
module Demo

fn i32[min max] Run(i32[min max][2] values)
{
    switch (values)
    {
        case [1]:
            return 1;
        default:
            return 0;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "expects exactly 2 element subpatterns")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "found 1") >= 1;
    }
}

[Fact]
[Collection("patterns")]
fn bool SwitchOrPatternsRejectInconsistentSharedCaptures()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-or-captures",
            raw"""
module Demo

enum Token
{
    Number(i32[min max]),
    Flag(bool),
    End,
}

fn i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.Number(var value) | Token.End:
            return 1;
        case Token.Flag(_):
            return 0;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Switch labels that share a body must bind the same capture names with the same types")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "Earlier label binds 'value: i32'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "this label binds no captures") >= 1;
    }
}

[Fact]
[Collection("patterns")]
fn bool SwitchPatternsRejectDuplicateCapturesInOneAlternative()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-duplicate-capture",
            raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(Pair pair)
{
    switch (pair)
    {
        case Pair(var value, var value):
            return value;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Switch pattern capture 'value' is bound more than once in the same pattern");
    }
}

[Fact]
[Collection("patterns", "diagnostics")]
fn bool ExhaustiveBoolSwitchRejectsLaterDefaultLabel()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-bool-late-default",
            raw"""
module Demo

fn i32[min max] Run(bool value)
{
    switch (value)
    {
        case true:
            return 1;
        case false:
            return 0;
        default:
            return 2;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'default' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "already exhaustive") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'false'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "Switch coverage becomes exhaustive here for 'bool'.") >= 1;
    }
}

[Fact]
[Collection("patterns", "diagnostics")]
fn bool AggregateWildcardPatternRejectsLaterSpecificArm()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-wildcard-late-arm",
            raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(Pair value)
{
    switch (value)
    {
        case Pair(_, _):
            return 0;
        case Pair(1, 2):
            return 1;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'Pair(1,2)' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "already exhaustive") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'Pair(_,_)'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "Switch coverage becomes exhaustive here for 'Pair'.") >= 1;
    }
}

[Fact]
[Collection("patterns", "diagnostics")]
fn bool BroaderAggregatePatternRejectsLaterSpecificArm()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-broader-late-arm",
            raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(Pair value)
{
    switch (value)
    {
        case Pair(1, _):
            return 0;
        case Pair(1, 2):
            return 1;
        default:
            return 2;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'Pair(1,2)' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'Pair(1,_)' already covers it") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "already covers the later label 'Pair(1,2)'") >= 1;
    }
}

[Fact]
[Collection("patterns", "diagnostics")]
fn bool NestedAggregatePatternRejectsLaterSpecificArm()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-nested-late-arm",
            raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}
record Outer(Pair Values, i32[min max] Tail)
{
}

fn i32[min max] Run(Outer value)
{
    switch (value)
    {
        case Outer(Pair(1, _), _):
            return 0;
        case Outer(Pair(1, 2), 3):
            return 1;
        default:
            return 2;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'Outer(Pair(1,2),3)' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'Outer(Pair(1,_),_)' already covers it") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "already covers the later label 'Outer(Pair(1,2),3)'") >= 1;
    }
}

[Fact]
[Collection("patterns")]
fn bool ExhaustiveEnumCasePatternsRejectLaterDefaultLabel()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-enum-late-default",
            raw"""
module Demo

enum Token
{
    End,
    Integer(i32[min max]),
    Move
    {
        X: i32[min max], Y: i32[min max]
    },
}

fn i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.End:
            return 0;
        case Token.Integer(_):
            return 1;
        case Token.Move
        {
            X: _, Y: _
        }:
            return 2;
        default:
            return 3;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'default' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "already exhaustive") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'Token.Move{X:_,Y:_}'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "Switch coverage becomes exhaustive here for 'Token'.") >= 1;
    }
}

[Fact]
[Collection("patterns", "diagnostics")]
fn bool BroaderEnumTuplePatternRejectsLaterSpecificArm()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-enum-tuple-late-arm",
            raw"""
module Demo

enum Token
{
    End,
    Integer(i32[min max]),
}

fn i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.Integer(_):
            return 0;
        case Token.Integer(1):
            return 1;
        default:
            return 2;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'Token.Integer(1)' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'Token.Integer(_)' already covers it") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "already covers the later label 'Token.Integer(1)'") >= 1;
    }
}

[Fact]
fn bool ArrayInitializerMismatchesUseExpectedActualWording()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-array-init-mismatch",
            raw"""
module Demo

fn void Run()
{
    stack i32[min max][2] values =
    {
        1, false
    };
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3002", "Array initializer element expects 'i32'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "found 'bool'") >= 1;
    }
}

[Fact]
fn bool SliceVariablesCannotUseArrayInitializerSyntax()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-slice-var-array-init",
            raw"""
module Demo

fn void Run()
{
    stack i32[min max][] view =
    {
        1, 2, 3
    };
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3002", "fixed-size array target")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "i32[]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "Form a slice explicitly from backing storage instead") >= 1;
    }
}

