            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3021", "Box.Add(borrow Box, i32)") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3021", "Box.Add(borrow Box, ascii)") >= 1;
    }
}

