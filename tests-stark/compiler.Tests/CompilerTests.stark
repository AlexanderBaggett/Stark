module Demo

fn borrow i32[min max] Echo(borrow i32[min max] value)
{
    return value;
}
""");
        return FailsWithDiagnostic(compiled, "STK4000");
    }
}

[Fact]
[Collection("ownership")]
fn bool GlobalNonEscapingBorrowsAreRejected()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "semval-global-borrow-rejected",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn storeborrow Box Source();
static borrow Box Current = Source();
""");
        return FailsWithDiagnostic(compiled, "STK3002");
    }
}

[Fact]
[Collection("ownership")]
fn bool AggregateFieldsRejectNonEscapingBorrowClasses()
{
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-field-borrow-classes",
            raw"""
module Demo

struct BorrowField
{
    borrow i32[min max] Value;
}

struct RetBorrowField
{
    retborrow i32[min max] Value;
}

struct BorrowClosureField
{
    borrow closure<fn i32[min max]()> Callback;
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK4005", "Field declarations may not store 'borrow i32'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4005", "Field declarations may not store 'retborrow i32'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4005", "borrow closure") >= 1;
    }
}

