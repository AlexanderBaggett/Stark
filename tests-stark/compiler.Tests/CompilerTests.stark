[Fact]
[Collection("ownership", "diagnostics")]
fn bool WholeAggregateUseAfterFieldMoveReportsPartialMove()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-whole-use-after-field-move",
            raw"""
module Demo

struct Payload
{
    ascii Text;

    drop
    {
    }
}

struct Pair
{
    Payload Left;
    Payload Right;
}

fn void Consume(Pair value)
{
    return;
}

fn i32[min max] Run()
{
    stack mut Pair pair = new Pair()
    {
        Left = new Payload()
        {
            Text = "a"
        },
        Right = new Payload()
        {
            Text = "b"
        }
    };
    stack Payload left = pair.Left;
    Consume(pair);
    return 0;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "Move error")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "value 'pair' is partially moved") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "Left (moved)") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "Field 'Left' of 'pair' was moved here.") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool ReinitializingMovedFieldRestoresWholeAggregateAvailability()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-reinit-field-restores-whole",
            raw"""
module Demo

struct Payload
{
    ascii Text;
}

struct Pair
{
    Payload Left;
    Payload Right;
}

fn void Consume(Pair value)
{
    return;
}

fn i32[min max] Run()
{
    stack mut Pair pair = new Pair()
    {
        Left = new Payload()
        {
            Text = "a"
        },
        Right = new Payload()
        {
            Text = "b"
        }
    };
    stack Payload left = pair.Left;
    pair.Left = new Payload()
    {
        Text = "c"
    };
    Consume(pair);
    return 0;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("ownership")]
fn bool BranchMergesPartialFieldMoveStateAcrossPaths()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-branch-merges-partial-move",
            raw"""
module Demo

struct Payload
{
    ascii Text;

    drop
    {
    }
}

struct Pair
{
    Payload Left;
    Payload Right;
}

fn i32[min max] Run(bool choose)
{
    stack mut Pair pair = new Pair()
    {
        Left = new Payload()
        {
            Text = "a"
        },
        Right = new Payload()
        {
            Text = "b"
        }
    };

    if (choose)
    {
        stack Payload left = pair.Left;
    }

    stack Payload current = pair.Left;
    return 0;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "Control-flow error")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "field 'Left' of 'pair' is not available on every path") >= 1;
    }
}

