module Demo

enum Token
{
    End,
    Integer(i32[min max]),
}

struct Inner
{
    Token Value;
}

struct Outer
{
    Inner Current;
}

export fn Outer Use(Outer value);
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Type 'Outer'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "depends on enum 'Token'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "cannot cross FFI/export boundaries") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "parameter 'value'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "return type of function 'Use'") >= 1;
    }
}

