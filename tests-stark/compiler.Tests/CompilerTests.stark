            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "right") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "values") >= 1;
    }
}

[Fact]
fn bool IndependentScalarOnlyLoopContractsCompile()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-independent-scalar-loops",
            raw"""
module Demo

unsafe fn u8[0 10] WhileRun()
{
    stack mut u8[0 10] value = 0;
    while willexit independent (value < 4)
    {
        const bool shouldStep = true;
        stack mut u8[0 10] next = value;
        if (shouldStep)
        {
            next += 1;
        }

        value = next;
    }

    return value;
}

unsafe fn u8[0 10] ForRun()
{
    stack mut u8[0 10] value = 0;
    for willexit independent (stack mut u8[0 10] index = 0; index < 4; index += 1)
    {
        register u8[0 10] copy = index;
        value += copy;
    }

    return value;
}
""");
        return Succeeds(compiled);
    }
}

