module Demo

struct Payload
{
    ascii Text;
}

struct Pair
{
    Payload Left;
    Payload Right;
}

fn i32[min max] Run(bool choose)
{
    stack mut Pair pair = new Pair()
    {
        Left = new Payload()
        {
            Text = "a"
        },
        Right = new Payload()
        {
