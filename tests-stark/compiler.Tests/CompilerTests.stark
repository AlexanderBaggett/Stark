[Collection("compiler")]
module CompilerTests

// Ported slice of tests/compiler.Tests, running against the current C# host
// compiler through the host test protocol. Requires STARK_HOST_COMPILER to
// point at the host compiler executable. The original C# tests remain in
// tests/compiler.Tests as the oracle until cutover.

// ---------------------------------------------------------------------------
// ParserSmokeTests
// ---------------------------------------------------------------------------

// Ported from ParserSmokeTests.ValidProgramsParse ("minimal module").
[Fact]
fn bool MinimalModuleParsesAndCompiles()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "parser-smoke-minimal-module",
            raw"""
module Demo

export fn i32[min max] main()
{
    return 0;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from ParserSmokeTests.InvalidProgramsDoNotParse: a malformed function
// header must produce parse-stage errors, never a successful compile.
[Fact]
[Collection("diagnostics")]
fn bool MalformedFunctionHeaderReportsParseErrors()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "parser-smoke-malformed-header",
            raw"""
module Demo

fn i32[min max] Broken(
""");
        return FailsWithDiagnostic(compiled, "STK1000");
    }
}

// ---------------------------------------------------------------------------
// DiagnosticRegressionTests
// ---------------------------------------------------------------------------

[Fact]
[Collection("diagnostics")]
fn bool MalformedSyntaxProducesAStableParseDiagnostic()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-malformed-syntax",
            raw"""
module Demo

unsafe fn void Run()
{
    stack i32[min max] value = 1
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK1000", "missing ';'");
    }
}

[Fact]
[Collection("diagnostics")]
fn bool InvalidEscapeSequencesProduceStableParseDiagnostics()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-invalid-escape",
            raw"""
module Demo

unsafe fn ascii Run()
{
    return "\q";
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK1000", "Invalid escape sequence '\\q' in string literal.");
    }
}

[Fact]
[Collection("types")]
fn bool CharacterLiteralsRequireExactlyOneDecodedCharacter()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-char-literal-one-char",
            raw"""
module Demo

unsafe fn ascii Run()
{
    return 'ab';
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK1000", "Character literals must decode to exactly one character.");
    }
}

[Fact]
[Collection("diagnostics")]
fn bool SelfImportsProduceAStableFrontEndDiagnostic()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-self-import",
            raw"""
import Demo
module Demo

unsafe fn void Run()
{
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK2001", "cannot import itself");
    }
}

[Fact]
[Collection("diagnostics")]
fn bool MissingMembersProduceTypeDiagnostics()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-missing-member",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 1
    };
    return box.Missing;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3005", "does not contain a field named 'Missing'");
    }
}

[Fact]
fn bool LawsRejectOutParameters()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-law-out-param",
            raw"""
module Demo

unsafe law i32[min max] Read(out i32[min max] value)
{
    return 0;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4101", "cannot declare 'out' or 'init' parameters");
    }
}

[Fact]
[Collection("ownership")]
fn bool StaticOwnedValuesCannotBeMovedOut()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-static-move-out",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

static Box Current = new Box()
{
    Value = 1
};

unsafe fn Box Take()
{
    return Current;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4204", "Cannot move out of global or static storage 'Current'");
    }
}

[Fact]
[Collection("diagnostics")]
fn bool ImmutableGlobalsRejectRebindingWithSpecificDiagnostic()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-immutable-global-rebind",
            raw"""
module Demo

static i32[min max] Answer = 42;

unsafe fn void Run()
{
    Answer = 7;
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3007", "Cannot rebind immutable global 'Answer'.");
    }
}

[Fact]
[Collection("diagnostics")]
fn bool ConstGlobalsRejectMutationWithSpecificDiagnostic()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-const-global-mutation",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

const Box Current = new Box()
{
    Value = 1
};

unsafe fn void Run()
{
    Current.Value = 2;
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3007", "Cannot mutate member 'Value' of constant global 'Current'.");
    }
}

[Fact]
[Collection("ownership")]
fn bool ConstGlobalsExplainWhyReachableStateIsNotFrozen()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-const-global-frozen-graph",
            raw"""
module Demo

struct Holder
{
    rawptr<i8[min max]> Ptr;
}

const Holder Current = new Holder()
{
    Ptr = null
};
""");
        return FailsWithDiagnosticMessage(compiled, "STK4007", "fully frozen object graph")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4007", "Current.Ptr") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4007", "raw pointer type") >= 1;
    }
}

[Fact]
[Collection("lowering")]
fn bool ConstGlobalsExplainWhenInitializersCannotLowerAsStaticData()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-const-global-static-data",
            raw"""
module Demo

fn i32[min max] Source();

const i32 Answer = Source();
""");
        return FailsWithDiagnosticMessage(compiled, "STK4008", "frozen initializer")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4008", "materialized as static data") >= 1;
    }
}

[Fact]
[Collection("patterns")]
fn bool NamedAggregateWholeValueTypedCaptureMarksFollowingDefaultUnreachable()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-capture-default-unreach",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Run(Box box)
{
    switch (box)
    {
        case Box capture:
            return 1;
        default:
            return 0;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'default' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "already exhaustive") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "Switch coverage becomes exhaustive here for 'Box'.") >= 1;
    }
}

[Fact]
[Collection("patterns", "diagnostics")]
fn bool CapturePatternsMixedWithOtherLabelsProduceAnExplicitDiagnostic()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-capture-mixed-labels",
            raw"""
    module Demo

    unsafe fn i32[min max] Run(i32[min max] value)
    {
        switch (value)
        {
            case var capture:
            case 1:
                return 1;
            default:
                return 0;
        }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Switch labels that share a body must bind the same capture names with the same types")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "Earlier label binds 'capture: i32'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "this label binds no captures") >= 1;
    }
}

[Fact]
[Collection("patterns")]
fn bool UnreachableSwitchLabelsPointBackToTheCoveringArm()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-unreachable-switch-label",
            raw"""
module Demo

unsafe fn i32[min max] Run(bool value)
{
    switch (value)
    {
        case true:
            return 1;
        case false:
            return 0;
        default:
            return 2;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'default' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "already exhaustive") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "earlier unguarded label 'false'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "Switch coverage becomes exhaustive here for 'bool'.") >= 1;
    }
}

[Fact]
[Collection("patterns", "diagnostics")]
fn bool BreakOutsideLoopOrSwitchProducesAStableSemanticDiagnostic()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-break-outside-loop",
            raw"""
module Demo

unsafe fn void Run()
{
    break;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4113", "'break' requires an enclosing loop or switch.");
    }
}

[Fact]
[Collection("diagnostics")]
fn bool ContinueOutsideLoopProducesAStableSemanticDiagnostic()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-continue-outside-loop",
            raw"""
module Demo

unsafe fn void Run()
{
    continue;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4114", "'continue' requires an enclosing loop.");
