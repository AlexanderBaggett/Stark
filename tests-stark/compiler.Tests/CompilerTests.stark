""");
        return FailsWithDiagnosticMessage(compiled, "STK4202", "cannot store a temporary borrow")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4202", "stored field 'Callback'") >= 1;
    }
}

[Fact]
[Collection("ownership", "patterns", "traits")]
fn bool MoveCapturesConsumeSourceBindingAtClosureCreation()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-move-capture-consumes",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 7
    };
    stack heap closure<fn i32[min max]()> callback = heap capture(move box) () => box.Value;
    return box.Value;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "Value 'box'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "moved") >= 1;
    }
}

[Fact]
[Collection("patterns", "traits")]
fn bool OutAndInitClosureCapturesMustBeAssignedOnEveryReturnPath()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-out-init-capture-paths",
            raw"""
module Demo

inline fn void RunOut(inline closure<mut fn void(bool)> body)
{
    body(true);
    return;
}

inline fn void RunInit(inline closure<mut fn void(bool)> body)
{
    body(true);
    return;
}

fn void BadOut(bool choose)
{
    stack mut i32[min max] value = 0;
    RunOut(capture(out value) (bool flag) =>
    {
        if (flag)
        {
            value = 1;
            return;
        }

        return;
    });
    return;
}

fn void BadInit(bool choose)
{
    stack mut i32[min max] value = 0;
    RunInit(capture(init value) (bool flag) =>
    {
        if (flag)
        {
            value = 1;
            return;
        }

        return;
    });
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4205", "closure capture 'value' with mode 'out'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4205", "every successful return path") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4205", "closure capture 'value' with mode 'init'") >= 1;
    }
}

[Fact]
[Collection("traits")]
fn bool OnceClosureCallsConsumeTheClosureValue()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-once-closure-consumes",
            raw"""
module Demo

inline fn i32[min max] RunInlineTwice(inline closure<once fn i32[min max]()> producer)
{
    stack i32[min max] first = producer();
    return producer();
}

fn i32[min max] RunHeapTwice(heap closure<once fn i32[min max]()> producer)
{
    stack i32[min max] first = producer();
    return producer();
}

fn i32[min max] RunBorrowTwice(borrow closure<once fn i32[min max]()> producer)
{
    stack i32[min max] first = producer();
    return producer();
}

fn i32[min max] UseInline()
{
    return RunInlineTwice(() => 1);
}

fn i32[min max] UseHeap()
{
    stack heap closure<once fn i32[min max]()> producer = heap () => 1;
    return RunHeapTwice(producer);
}

fn i32[min max] UseBorrow()
{
    return RunBorrowTwice(() => 1);
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "Value 'producer'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "Value 'producer'") >= 3
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "moved") >= 3;
    }
}

