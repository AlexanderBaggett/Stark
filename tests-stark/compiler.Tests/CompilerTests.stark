[Fact]
[Collection("diagnostics")]
fn bool RawSliceConstructionRejectsHiddenPointerRoots()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-raw-slice-hidden-roots",
            raw"""
module Demo

unsafe fn rawptr<i32[min max]> Identity(rawptr<i32[min max]> pointer)
{
    return pointer;
}

unsafe fn void Run(rawptr<i32[min max]> pointer, u8[0 10] count)
{
    unsafe
    {
        stack i32[min max][] view = slice(Identity(pointer), count);
    }

    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3029", "Raw slice construction")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3029", "compiler-visible raw pointer root") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3029", "hidden-root") >= 1;
    }
}

