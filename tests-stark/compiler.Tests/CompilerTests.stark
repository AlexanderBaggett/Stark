module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
    where same(left, right)
    {
        return;
}

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    stack mut rawmutptr<i32[min max]> mirror = ptr;
    Touch(ptr, mirror);
    return;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("ownership", "ffi", "types", "diagnostics")]
fn bool DefaultNonOverlapRejectsSimpleRawPointerCastAliases()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-ptr-cast-alias",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    return;
}

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    stack rawmutptr<i32[min max]> mirror = (rawmutptr<i32[min max]>)ptr;
    Touch(ptr, mirror);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "violates disjoint parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "right") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "ptr") >= 1;
    }
}

[Fact]
[Collection("ownership", "ffi", "types", "diagnostics")]
fn bool DefaultNonOverlapRejectsIntegerLaunderedRawPointerAliasesWithoutProof()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-int-laundered-ptr-alias",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    return;
}

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    stack u64[min max] bits = (u64[min max])ptr;
    stack rawmutptr<i32[min max]> mirror = (rawmutptr<i32[min max]>)bits;
    Touch(ptr, mirror);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "violates disjoint parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "right") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "ptr or mirror") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool DefaultNonOverlapInvalidatesMutablePointerAliasAfterBranchAssignment()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-branch-assign-alias",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    return;
}

unsafe fn void Run(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right, bool flag)
{
    stack mut rawmutptr<i32[min max]> mirror = null;
    mirror = left;
    if (flag)
    {
        mirror = right;
    }

    Touch(left, mirror);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "violates disjoint parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "right") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left or mirror") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool BranchLocalPointerAliasInvalidationDoesNotPolluteSiblingBranch()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-sibling-branch-alias",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    return;
}

unsafe fn void Run(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right, bool flag)
{
    stack mut rawmutptr<i32[min max]> mirror = null;
    mirror = left;
    if (flag)
    {
        mirror = right;
    }
    else
    {
        Touch(mirror, right);
    }

    return;
}
""");
        return Succeeds(compiled);
    }
}

