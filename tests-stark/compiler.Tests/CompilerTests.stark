            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'Pair(_,_)'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "Switch coverage becomes exhaustive here for 'Pair'.") >= 1;
