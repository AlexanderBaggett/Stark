            return 1;
        default:
            return 0;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Range pattern '10..20' cannot match 'u8[0 3]'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "[0, 3]") >= 1;
    }
}

