[Fact]
[Collection("patterns")]
fn bool GlobalTypesRejectAggregateTypesThatTransitivelyDependOnEnums()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-global-aggregate-enum",
            raw"""
module Demo

enum Token
{
    End,
}

struct Inner
{
    Token Value;
}

struct Outer
{
    Inner Current;
}

static Outer Shared = new Outer()
{
    Current = new Inner()
    {
        Value = Token.End
    }
};
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Type 'Outer'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "depends on enum 'Token'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "enum-dependent runtime layout is not valid in a global variable type") >= 1;
    }
}

