[Fact]
[Collection("ownership", "traits")]
fn bool DoctrineCallsParticipateInOwnershipFlow()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-doctrine-calls-flow",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

doctrine Sink
{
    finite law void Consume(Box value)
    {
        return;
    }
}

finite law i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 1
    };
    Sink.Consume(box);
    return box.Value;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "Move error")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "was moved and must be reinitialized") >= 1;
    }
}

