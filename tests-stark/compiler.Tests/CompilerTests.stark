[Fact]
fn bool ObjectCreationRequiresExplicitFunctionPointerFields()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-object-init-fnptr-fields",
            raw"""
module Demo

fn i32[min max] Worker()
{
    return 1;
}

struct Callback
{
    i32[min max] Value;
    fnptr<fn i32[min max]()> Entry;
}

fn void Run()
{
    stack Callback missing = new Callback();
    stack Callback partial = new Callback()
    {
        Value = 2
    };
    stack Callback ok = new Callback()
    {
        Value = 3, Entry = Worker
    };
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3009", "Field 'Entry'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3009", "must be explicitly initialized") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3009", "function pointers cannot be null") >= 1;
    }
}

