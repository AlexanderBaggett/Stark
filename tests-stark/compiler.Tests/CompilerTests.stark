// PORT-NOTE FfiAbiModifiersRejectUnsupportedTargetsDuringCompilation: compiles with CompilerOptions TargetInfo (LlvmTargetInfo x86_64-unknown-linux-gnu) and asserts STK2111-or-STK3046; the host compile protocol has no target-triple override.

// PORT-NOTE AsmFunctionsRejectUnsupportedParameterAndReturnTypes: compiles with CompilerOptions TargetInfo (LlvmTargetInfo x86_64-unknown-linux-gnu); the host compile protocol has no target-triple override.

// PORT-NOTE AsmFunctionsAcceptFloatingPointParametersAndReturns: asserts success under CompilerOptions TargetInfo (LlvmTargetInfo x86_64-unknown-linux-gnu); the host compile protocol has no target-triple override.

// PORT-NOTE AsmFunctionsAcceptAArch64FloatingPointRegisters: asserts success under CompilerOptions TargetInfo (LlvmTargetInfo aarch64-unknown-linux-gnu); the host compile protocol has no target-triple override.

// PORT-NOTE AsmFunctionsRejectRegisterClassesThatDoNotMatchValueKinds: compiles with CompilerOptions TargetInfo (LlvmTargetInfo x86_64-unknown-linux-gnu); the host compile protocol has no target-triple override.

[Fact]
[Collection("patterns")]
fn bool ExportedFunctionsRejectAggregateTypesThatTransitivelyDependOnEnums()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-export-aggregate-enum-abi",
            raw"""
module Demo

enum Token
{
    End,
    Integer(i32[min max]),
}

struct Inner
{
    Token Value;
}

struct Outer
{
    Inner Current;
}

export fn Outer Use(Outer value);
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Type 'Outer'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "depends on enum 'Token'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "cannot cross FFI/export boundaries") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "parameter 'value'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3008", "return type of function 'Use'") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool TypeAliasesShareTheUnderlyingOverloadIdentity()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-alias-overload-identity",
            raw"""
module Demo

alias Score = i32[min max];

fn i32[min max] Parse(i32[min max] value)
{
    return value;
}

fn i32[min max] Parse(Score value)
{
    return value;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3006", "Function 'Parse' declares overload 'Parse(i32)' more than once");
    }
}

[Fact]
[Collection("ownership")]
fn bool TypeAliasCyclesAreRejected()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "typtyping-alias-cycle",
