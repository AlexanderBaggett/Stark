unsafe fn void Run()
{
    unsafe
    {
        stack i32[min max][] view = slice((rawptr<i32[min max]>)null, 1);
    }

    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3029", "Raw slice construction")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3029", "null") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3029", "provably positive") >= 1;
    }
}

