[Fact]
[Collection("lowering")]
fn bool VoidCallsUsedAsValuesFailBeforeMirLowering()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-void-call-as-value",
            raw"""
module Demo

fn void Touch()
{
    return;
}

struct Box
{
    i32[min max] Value;

    fn void Clear(borrow Box self)
    {
        return;
    }
}

fn i32[min max] Direct()
{
    return Touch();
}

fn i32[min max] Member()
{
    stack Box box = new Box()
    {
        Value = 1
    };
    return box.Clear();
}

fn i32[min max] Indirect()
{
    stack fnptr<fn void()> callback = Touch;
    return callback();
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3002", "Return statement expects 'i32'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "Return statement expects 'i32'") == 3
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "found 'void'") >= 3;
    }
}

