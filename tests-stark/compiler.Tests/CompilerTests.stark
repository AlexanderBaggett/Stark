fn void Run()
{
    register i32[min max][2] values =
    {
        1, 2
    };
    stack i32[min max][] view = values;
    return;
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK4016", "Register local 'values' cannot be used where stable storage is required")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4016", "slice view") >= 1;
    }
}

[Fact]
[Collection("lowering")]
fn bool ArenaLocalStorageIsRejectedUntilArenaLoweringExists()
{
