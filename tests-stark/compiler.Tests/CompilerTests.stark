[Fact]
fn bool PlainBooleanIfAndWhileStillRequireBool()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "patdiag-plain-if-requires-bool",
            raw"""
module Demo

enum Option<T> { Some(T), None }
enum Result<T, E> { Ok(T), Err(E) }
enum Other { A, B }

fn Option<i32[min max]> lookup(i32[min max] x) { return Option<i32[min max]>.Some(x); }
fn i32[min max] BadBoolean(i32[min max] n)
{
    if (n)
    {
        return 1;
    }
    return 0;
}
""");
        return compiled.Ok && !Succeeds(compiled);
    }
}

[Fact]
fn bool PlainBooleanIfAndWhileAcceptBoolConditions()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "patdiag-plain-bool-conditions",
            raw"""
module Demo

enum Option<T> { Some(T), None }
enum Result<T, E> { Ok(T), Err(E) }
enum Other { A, B }

fn Option<i32[min max]> lookup(i32[min max] x) { return Option<i32[min max]>.Some(x); }
fn i32[min max] GoodBoolean(i32[min max] n)
{
    stack mut i32[min max] total = 0;
    if (n > 0)
    {
        total = total + 1;
    }
    while willexit (total < 0)
    {
        total = total + 1;
    }
    return total;
}
""");
        return Succeeds(compiled);
    }
}

