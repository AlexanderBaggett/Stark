[Fact]
[Collection("patterns", "diagnostics")]
fn bool NestedAggregatePatternRejectsLaterSpecificArm()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-nested-late-arm",
            raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}
record Outer(Pair Values, i32[min max] Tail)
{
}

fn i32[min max] Run(Outer value)
{
    switch (value)
    {
        case Outer(Pair(1, _), _):
            return 0;
        case Outer(Pair(1, 2), 3):
            return 1;
        default:
            return 2;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'Outer(Pair(1,2),3)' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'Outer(Pair(1,_),_)' already covers it") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "already covers the later label 'Outer(Pair(1,2),3)'") >= 1;
    }
}

[Fact]
[Collection("patterns")]
fn bool ExhaustiveEnumCasePatternsRejectLaterDefaultLabel()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-enum-late-default",
            raw"""
module Demo

enum Token
{
    End,
    Integer(i32[min max]),
    Move
    {
        X: i32[min max], Y: i32[min max]
    },
}

fn i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.End:
            return 0;
        case Token.Integer(_):
            return 1;
        case Token.Move
        {
            X: _, Y: _
        }:
            return 2;
        default:
            return 3;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'default' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "already exhaustive") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'Token.Move{X:_,Y:_}'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "Switch coverage becomes exhaustive here for 'Token'.") >= 1;
    }
}

