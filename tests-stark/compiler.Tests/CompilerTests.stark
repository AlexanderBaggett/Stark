module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

finite i32[min max] Run()
{
    heap Box box = new Box()
    {
        Value = 1
    };
    return 1;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
fn bool MovingOwnedLocalMakesLaterUseInvalid()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-moved-local-use-invalid",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

finite law void Consume(Box value)
{
    return;
}

finite law i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 1
    };
    Consume(box);
    return box.Value;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "Move error")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "was moved and must be reinitialized") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "was moved here") >= 1;
    }
}

