    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-branch-reinit-keeps-available",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 1
    };

    if (true)
    {
        Consume(box);
        box = new Box()
        {
            Value = 2
        };
    }

    return box.Value;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
fn bool LoopReinitializationKeepsOwnedLocalAvailable()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-loop-reinit-keeps-available",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    stack mut i32[min max] count = 0;

    while willexit (count < 1)
    {
        Consume(box);
        box = new Box()
        {
            Value = 2
        };
        count = count + 1;
    }

    return box.Value;
}
""");
        return Succeeds(compiled);
    }
}

