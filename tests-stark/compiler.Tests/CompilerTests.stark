[Fact]
[Collection("ownership")]
fn bool MovedOwnedLocalCanBeReinitializedBeforeLaterRead()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-moved-local-reinit-before-read",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    Consume(box);
    box = new Box()
    {
        Value = 2
    };
    return box.Value;
}
""");
        return Succeeds(compiled);
    }
}

