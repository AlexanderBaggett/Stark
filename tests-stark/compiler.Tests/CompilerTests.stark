    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-frozen-projection-provenance",
            raw"""
module Demo

struct Inner
{
    i32[min max] Value;
}

struct Outer
{
    Inner Child;
}

fn void Inspect(const Inner inner)
{
    return;
}

fn void Run(frozen Outer outer)
{
    Inspect(outer.Child);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3031", "must have const provenance");
    }
}

