// PORT-NOTE FfiAbiModifiersRejectUnsupportedTargetsDuringCompilation: compiles with CompilerOptions TargetInfo (LlvmTargetInfo x86_64-unknown-linux-gnu) and asserts STK2111-or-STK3046; the host compile protocol has no target-triple override.

// PORT-NOTE AsmFunctionsRejectUnsupportedParameterAndReturnTypes: compiles with CompilerOptions TargetInfo (LlvmTargetInfo x86_64-unknown-linux-gnu); the host compile protocol has no target-triple override.

// PORT-NOTE AsmFunctionsAcceptFloatingPointParametersAndReturns: asserts success under CompilerOptions TargetInfo (LlvmTargetInfo x86_64-unknown-linux-gnu); the host compile protocol has no target-triple override.

// PORT-NOTE AsmFunctionsAcceptAArch64FloatingPointRegisters: asserts success under CompilerOptions TargetInfo (LlvmTargetInfo aarch64-unknown-linux-gnu); the host compile protocol has no target-triple override.

// PORT-NOTE AsmFunctionsRejectRegisterClassesThatDoNotMatchValueKinds: compiles with CompilerOptions TargetInfo (LlvmTargetInfo x86_64-unknown-linux-gnu); the host compile protocol has no target-triple override.

[Fact]
[Collection("patterns")]
