    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-move-capture-consumes",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 7
    };
    stack heap closure<fn i32[min max]()> callback = heap capture(move box) () => box.Value;
    return box.Value;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK4200", "Value 'box'")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4200", "moved") >= 1;
    }
