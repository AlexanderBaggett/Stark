{
    static mut i32[min max] value = 1;
    value = value + 1;
    return value;
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK4017", "Function-local 'static' storage")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4017", "not a valid local storage class") >= 1;
    }
}

