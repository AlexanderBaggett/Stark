        }
    };

    if (choose)
    {
        stack Payload left = pair.Left;
        pair.Left = new Payload()
        {
            Text = "c"
        };
    }

    stack Payload current = pair.Left;
    return 0;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
fn bool BranchesMergeDefiniteAggregateFieldInitialization()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "own-branches-merge-field-init",
            raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

fn i32[min max] Run(bool choose)
{
    stack mut Pair pair;

    if (choose)
    {
        pair.Left = 1;
    }
    else
    {
        pair.Left = 2;
    }

    pair.Right = 3;
    return pair.Left + pair.Right;
}
""");
        return Succeeds(compiled);
    }
}

