{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-independent-bounded-ptr",
            raw"""
module Demo

unsafe fn void Copy(
    rawptr<i32[min max]>[count] input,
    rawmutptr<i32[min max]>[count] output,
    u8[0 10] count)
    where disjoint(input[0, count], output[0, count])
    {
        for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        *(&output[index]) = *(&input[index]);
    }

    return;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("ownership")]
fn bool OverlapCapableSubregionDisjointCallsAllowSameRootWhenRangesAreProvenDisjoint()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-subregion-disjoint-ok",
            raw"""
module Demo

unsafe fn void Window(
    rawptr<i32[min max]>[8] source,
    rawmutptr<i32[min max]>[8] destination)
    where overlap(source, destination)
    where disjoint(source[4, 4], destination[0, 4])
    {
        return;
}

unsafe fn void Run(rawmutptr<i32[min max]>[8] buffer)
{
    Window(buffer, buffer);
    return;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("ownership")]
fn bool OverlapCapableSubregionDisjointCallsRejectSameRootWhenRangesOverlap()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-subregion-disjoint-overlap",
            raw"""
module Demo

unsafe fn void Window(
    rawptr<i32[min max]>[8] source,
    rawmutptr<i32[min max]>[8] destination)
    where overlap(source, destination)
    where disjoint(source[2, 4], destination[0, 4])
    {
        return;
}

unsafe fn void Run(rawmutptr<i32[min max]>[8] buffer)
{
    Window(buffer, buffer);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "disjoint subregion parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "source[2, 4]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "destination[0, 4]") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "may overlap") >= 1;
    }
}

