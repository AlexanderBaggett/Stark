module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(Pair pair)
{
    switch (pair)
    {
        case Pair(var value, var value):
            return value;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3008", "Switch pattern capture 'value' is bound more than once in the same pattern");
    }
}

[Fact]
[Collection("patterns", "diagnostics")]
fn bool ExhaustiveBoolSwitchRejectsLaterDefaultLabel()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-switch-bool-late-default",
            raw"""
module Demo

fn i32[min max] Run(bool value)
{
    switch (value)
    {
        case true:
            return 1;
        case false:
            return 0;
        default:
            return 2;
    }
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3019", "Switch label 'default' is unreachable")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "already exhaustive") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3019", "'false'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3020", "Switch coverage becomes exhaustive here for 'bool'.") >= 1;
    }
}

