[Fact]
[Collection("ownership")]
fn bool DisjointParameterCallsAllowDistinctProjectionArguments()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-distinct-projection-args",
            raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    return;
}

unsafe fn void Run(borrow mut Pair pair)
{
    Touch(&pair.Left, &pair.Right);
    return;
}
""");
        return Succeeds(compiled);
    }
}

[Fact]
[Collection("ownership")]
fn bool DisjointParameterCallsRejectUnprovenIndexedArguments()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-unproven-indexed-args",
            raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    return;
}

unsafe fn void Run(u8[0 2] leftIndex, u8[0 2] rightIndex)
{
    stack mut i32[min max][3] values =
    {
        1, 2, 3
    };
    Touch(&values[leftIndex], &values[rightIndex]);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "violates disjoint parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "left") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "right") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "values") >= 1;
    }
}

