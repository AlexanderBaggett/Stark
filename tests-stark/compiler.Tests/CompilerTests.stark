[Fact]
[Collection("ownership", "ffi", "diagnostics")]
fn bool DefaultNonOverlapRejectsIndirectFunctionPointerRawPointerAliases()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-fnptr-indirect-alias",
            raw"""
module Demo

unsafe fn void Run(
    fnptr<fn void(rawmutptr<i32[min max]>, rawmutptr<i32[min max]>)> op,
    rawmutptr<i32[min max]> ptr)
    {
        op(ptr, ptr);
    return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3030", "violates disjoint parameter contract")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "default non-overlap") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "arg0") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "arg1") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3030", "ptr") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool FunctionPointerWhereDisjointIsRejectedAsRedundant()
{
    {
        stack mut LlvmCompile compiled = CompileFull(
            "diagreg-fnptr-where-disjoint",
            raw"""
module Demo

unsafe fn void Run(
    fnptr<fn void(rawmutptr<i32[min max]>, rawmutptr<i32[min max]>) where disjoint(arg0, arg1)> op)
    {
        return;
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3029", "Function pointer")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3029", "where disjoint") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3029", "redundant") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3029", "where overlap") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3029", "where same") >= 1;
    }
}

