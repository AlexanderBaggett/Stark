[Fact]
fn bool TopLevelRegisterStorageIsRejected()
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-top-level-register",
            raw"""
module Demo

register i32[min max] Value = 1;
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK4015", "Top-level global variables must use 'static' storage")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4015", "'register'") >= 1;
    }
}

[Fact]
fn bool RegisterLocalsCannotBeAddressed()
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-register-addressed",
            raw"""
module Demo

unsafe fn void Run()
{
    register mut i32[min max] value = 1;
    stack rawmutptr<i32[min max]> pointer = &value;
    return;
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK4016", "Register local 'value' cannot be addressed")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4016", "Use 'stack' storage") >= 1;
    }
}

[Fact]
[Collection("ownership")]
fn bool RegisterLocalsCannotBePassedToBorrowParameters()
{
    unsafe
    {
        stack mut LlvmCompile compiled = RunHostCompile(
            "semval-register-borrow-param",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn i32[min max] Read(borrow Box box)
{
    return box.Value;
}

fn i32[min max] Run()
{
    register Box box = new Box()
    {
        Value = 1
    };
    return Read(box);
}
""",
            "semantic-validate",
            "");
        return FailsWithDiagnosticMessage(compiled, "STK4016", "Register local 'box' cannot be used where stable storage is required")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK4016", "borrow") >= 1;
    }
}

[Fact]
fn bool RegisterFixedArraysCannotFormSliceViews()
{
