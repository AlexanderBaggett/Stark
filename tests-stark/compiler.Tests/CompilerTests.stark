[Fact]
[Collection("ffi")]
fn bool ImmutableLocalReadonlyPointerCannotBeUpgradedToMutableRawPointer()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileFull(
            "typtyping-immutable-ptr-upgrade",
            raw"""
module Demo

fn void Run()
{
    stack i32[min max] value = 1;
    stack rawmutptr<i32[min max]> ptr = (rawmutptr<i32[min max]>)(&value);
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3002", "rawptr<i32>")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "rawmutptr<i32>") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "strengthen pointer mutability") >= 1;
    }
}

