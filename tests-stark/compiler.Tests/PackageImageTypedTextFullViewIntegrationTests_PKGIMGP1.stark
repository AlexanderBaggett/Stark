import CompilerTestSupport
import System.Testing

module PackageImageTypedTextFullViewIntegrationTests_PKGIMGP1

// Ported from PackageImageTypedTextFullViewIntegrationTests.ManifestBackedTypedFullViewTextBodiesCompileAndRunWithoutSyntheticSource.
public unsafe fn bool ManifestBackedTypedFullViewTextBodiesCompileAndRunWithoutSyntheticSourceImpl()
{
    unsafe
    {
        // PORT-NOTE: The original first builds `Facade` (a generic `WholeAscii<T>`
        // function) into a static library via the `--emit-lib -o` CLI path (asserting
        // exit code 0, "Emitted static library:" on stdout, empty stderr, and that the
        // library + `libFacade.starkpkg` manifest exist). It then loads the manifest,
        // locates the `Facade.WholeAscii` effective generic template, rewrites the
        // manifest so the module keeps only its EffectiveTypedInterface /
        // EffectiveCompilerFacts and a GenericTemplates section whose `WholeAscii`
        // BodyText is deliberately corrupted to invalid Stark
        // ("{ return this is not valid Stark; }"), writes that JSON back, and DELETES
        // `Facade.stark`. Finally it compiles a `Demo` module that `import Facade` and
        // calls `Facade.WholeAscii("hello", 0)` via `--emit-exe -o app -I <tempdir>`,
        // asserts exit code 0, "Emitted executable:" on stdout, empty stderr, the
        // executable exists, runs it, and asserts empty stdout/stderr and exit code 0.
        // The whole point is that the typed full-view text bodies (the effective
        // templates) drive instantiation without falling back to the corrupted
        // synthetic source. The compile helpers cannot express the CLI emit-lib build,
        // manifest rewrite / synthetic-source corruption, source-file deletion,
        // executable emission, or running the produced binary, so this is reduced to
        // compiling the same `Demo` root program with the `Facade` module available as
        // a sibling source module through the full LLVM pipeline and asserting it
        // succeeds (the closest observable signal that `Facade.WholeAscii` resolves and
        // instantiates correctly for `Demo`'s `main`).
        stack mut LlvmCompile compiled = CompileLlvmWithModule(
            "manifest-backed-typed-full-view-text-bodies-compile-and-run-without-synthetic-source",
            raw"""
import Facade
module Demo

export fn i32[min max] main()
{
    stack ascii text = Facade.WholeAscii("hello", 0);
    if (text != "hello")
    {
        return 1;
    }
    if (text[1] != 'e')
    {
        return 2;
    }
    return 0;
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn ascii WholeAscii<T>(ascii text, T tag)
{
    return text[];
}
""");
        return Succeeds(compiled);
    }
}
