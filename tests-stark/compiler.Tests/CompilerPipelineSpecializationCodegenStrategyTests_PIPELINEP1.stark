import CompilerTestSupport
import System.Testing

module CompilerPipelineSpecializationCodegenStrategyTests_PIPELINEP1

// Ported from CompilerPipelineSpecializationCodegenStrategyTests.RootGenericInstantiationsChooseOwnedBodyCodegenStrategy.
public unsafe fn bool RootGenericInstantiationsChooseOwnedBodyCodegenStrategyImpl()
{
    unsafe
    {
        // PORT-NOTE: the original stops after the "specialization-codegen-strategy" pass and reads the
        // SpecializationCodegenStrategyModel: a single function with SymbolName
        // "__stark_mono_fn_Demo__Identity__i32", Linkage InternalSingleOwner, StrategyKind
        // EmitOwnedConcreteBody, and SupportsAbiFallback false (a root generic instantiation owns its
        // concrete body). The compile helpers cannot stop after that pass nor read the strategy model
        // (symbol name, linkage, strategy kind, abi-fallback flag), so this reduces to "the embedded
        // program type-checks cleanly", program kept verbatim from the C# raw string.
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "speccodegen-root-generic-instantiations-choose-owned-body",
            raw"""
module Demo

fn T Identity<T>(T value)
{
    return value;
}

fn i32[min max] Run(i32[min max] value)
{
    return Identity(value);
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSpecializationCodegenStrategyTests.SourceBackedImportedLawGenericsChooseLawCloneAwareCodegenStrategy.
public unsafe fn bool SourceBackedImportedLawGenericsChooseLawCloneAwareCodegenStrategyImpl()
{
    unsafe
    {
        // PORT-NOTE: the original writes a source-backed Math.stark (a public doctrine with a finite law
        // generic) into a temp directory, resolves it via FileSystemModuleResolver, stops after the
        // "specialization-codegen-strategy" pass, and reads the SpecializationCodegenStrategyModel: a
        // single function with SymbolName "__stark_mono_fn_Math__Math_Numbers_Identity__i32", Linkage
        // LinkOnceOdrComdat, StrategyKind EmitOwnedConcreteBodyAndPreferLawCallerClone, and
        // SupportsAbiFallback true (a source-backed imported law generic is law-clone aware). The harness
        // writes the imported module to a temp search directory and resolves it the same way, but cannot
        // stop after that pass nor read the strategy model (symbol name, linkage, strategy kind,
        // abi-fallback flag), so this reduces to "the consumer program plus its source-backed Math module
        // type-check successfully". Both programs are kept verbatim from the C# raw string literals.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "speccodegen-source-backed-imported-law-generics-clone-aware",
            raw"""
import Math
module Demo

finite law i32[min max] Run(i32[min max] value)
{
    return Math.Numbers.Identity(value);
}
""",
            "",
            "Math.stark",
            raw"""
module Math

public doctrine Numbers
{
    finite law T Identity<T>(T value)
    {
        return value;
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSpecializationCodegenStrategyTests.ColdImportedLawGenericsUseAbiFallbackOnlyCodegenStrategy.
public unsafe fn bool ColdImportedLawGenericsUseAbiFallbackOnlyCodegenStrategyImpl()
{
    unsafe
    {
        // PORT-NOTE: the original writes a source-backed Math.stark (a public doctrine with a cold finite
        // law generic) into a temp directory, resolves it via FileSystemModuleResolver, stops after the
        // "specialization-codegen-strategy" pass, and reads the SpecializationCodegenStrategyModel: a
        // single function with StrategyKind AbiFallbackOnly and SupportsAbiFallback true (a cold imported
        // law generic uses the ABI fallback only). The harness writes the imported module to a temp
        // search directory and resolves it the same way, but cannot stop after that pass nor read the
        // strategy model (strategy kind, abi-fallback flag), so this reduces to "the consumer program
        // plus its source-backed Math module type-check successfully". Both programs are kept verbatim
        // from the C# raw string literals.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "speccodegen-cold-imported-law-generics-abi-fallback-only",
            raw"""
import Math
module Demo

finite law i32[min max] Run(i32[min max] value)
{
    return Math.Numbers.Identity(value);
}
""",
            "",
            "Math.stark",
            raw"""
module Math

public doctrine Numbers
{
    cold finite law T Identity<T>(T value)
    {
        return value;
    }
}
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSpecializationCodegenStrategyTests.DeclarationOnlyImportedGenericInstantiationsChooseAbiFallbackOnlyCodegenStrategy.
public unsafe fn bool DeclarationOnlyImportedGenericInstantiationsChooseAbiFallbackOnlyCodegenStrategyImpl()
{
    unsafe
    {
        // PORT-NOTE: the original compiles a declaration-only Facade.stark library, builds a package
        // image manifest (PackageImageBuilder.Create) plus a .a/.lib artifact, writes the manifest JSON,
        // then resolves the manifest-backed Facade module via FileSystemModuleResolver from the consumer,
        // stops after the "specialization-codegen-strategy" pass, and reads the
        // SpecializationCodegenStrategyModel: a single function with SymbolName
        // "__stark_mono_fn_Demo__Facade_Identity__i32", Linkage InternalSingleOwner, StrategyKind
        // AbiFallbackOnly, and SupportsAbiFallback true (a declaration-only imported generic uses the ABI
        // fallback only). The compile helpers cannot build/strip a package-image manifest, stop after
        // that pass, nor read the strategy model (symbol name, linkage, strategy kind, abi-fallback
        // flag); the closest observable here is resolving the declaration-only Facade as a source module
        // and type-checking the consumer, so this reduces to "the consumer program plus its
        // declaration-only Facade module type-check successfully". Both programs are kept verbatim from
        // the C# raw string literals.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "speccodegen-declaration-only-imported-generic-abi-fallback-only",
            raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return Facade.Identity(value);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn T Identity<T>(T value);
""");
        return Succeeds(compiled);
    }
}

// Ported from CompilerPipelineSpecializationCodegenStrategyTests.ManifestBackedImportedGenericsWithoutPublishedAbiFactsDoNotClaimAbiFallbackInCodegenStrategy.
public unsafe fn bool ManifestBackedImportedGenericsWithoutPublishedAbiFactsDoNotClaimAbiFallbackInCodegenStrategyImpl()
{
    unsafe
    {
        // PORT-NOTE: the original compiles a Facade.stark library with a real body, builds a package
        // image manifest (PackageImageBuilder.Create), asserts the Facade module's CompilerFacts.AbiFunctions
        // is non-null, then rewrites the manifest with AbiFunctions stripped to empty, writes the
        // ABI-stripped manifest JSON, resolves the manifest-backed Facade module via
        // FileSystemModuleResolver from the consumer, stops after the "specialization-codegen-strategy"
        // pass, and reads the SpecializationCodegenStrategyModel: a single function with StrategyKind
        // EmitOwnedConcreteBodyAndPreferLawCallerClone and SupportsAbiFallback false (without published
        // ABI facts the strategy must not claim an ABI fallback and instead owns the concrete body). The
        // compile helpers cannot build a package-image manifest, strip its ABI facts, stop after that
        // pass, nor read the strategy model (strategy kind, abi-fallback flag); the closest observable
        // here is resolving the Facade source module and type-checking the consumer, so this reduces to
        // "the consumer program plus its source-backed Facade module type-check successfully". Both
        // programs are kept verbatim from the C# raw string literals.
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "speccodegen-manifest-backed-imported-generic-without-abi-facts-no-abi-fallback",
            raw"""
import Facade
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return Facade.Identity(value);
}
""",
            "",
            "Facade.stark",
            raw"""
module Facade

public fn T Identity<T>(T value)
{
    return value;
}
""");
        return Succeeds(compiled);
    }
}
