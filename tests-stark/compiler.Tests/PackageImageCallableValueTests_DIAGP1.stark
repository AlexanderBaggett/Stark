import CompilerTestSupport
import System.Testing

module PackageImageCallableValueTests_DIAGP1

// PORT-NOTE (applies to every Impl in this file): Each C# test compiles a Facade
// library, builds it into a package image via PackageImageBuilder.Create, writes
// the .starkpkg.json manifest + static library, deletes the Facade source, then
// re-imports Facade (through a FileSystemModuleResolver, no source files) into a
// Demo consumer and asserts the diagnostics the consumer raises against the
// imported declarations. Package-image construction, manifest round-tripping,
// source deletion, and TypeCheckModel/Lambdas inspection are not expressible with
// the Stark helpers, so each port is reduced to compiling the same Demo consumer
// with the Facade library available as a sibling source module
// (CompileTypeCheckWithModule, StopAfterPassId "type-check") and asserting the
// same diagnostic signal. The verbatim consumer/library Stark programs from the
// C# raw strings are preserved.

// Ported from PackageImageCallableValueTests.PackageImageBackedLawFunctionPointerParametersValidateLambdaBodies.
public unsafe fn bool PackageImageBackedLawFunctionPointerParametersValidateLambdaBodiesImpl()
{
    // PORT-NOTE: C# asserts the consumer fails with STK4106 whose message mentions
    // "Run.__lambda_" and "may only call other laws", and that the single lambda's
    // function-pointer kind is Law. The lambda-name fragment and Lambdas inspection
    // are not expressible; reduced to the STK4106 "may only call other laws" signal.
    stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
        "pkgimg-law-fnptr-lambda-validate",
        raw"""
import Facade
module Demo

static i32[min max] Counter = 1;

fn i32[min max] Impure()
{
    return Counter;
}

fn void Run()
{
    Facade.Register(() => Impure());
    return;
}
""",
        "",
        "Facade.stark",
        raw"""
module Facade

public fn void Register(fnptr<law i32[min max]()> callback);
""");
    return FailsWithDiagnosticMessage(compiled, "STK4106", "may only call other laws");
}

// Ported from PackageImageCallableValueTests.PackageImageBackedFunctionItemsPreserveFunctionKindObligationRejections.
public unsafe fn bool PackageImageBackedFunctionItemsPreserveFunctionKindObligationRejectionsImpl()
{
    // PORT-NOTE: C# asserts four separate STK3002 "Function item ... cannot be
    // promoted" diagnostics (Facade.Plain to finite / to law, Facade.FiniteOnly to
    // finite law, Facade.LawOnly to finite law) and that AddressTakenFunctions is
    // empty. The empty-AddressTakenFunctions check is not expressible; reduced to
    // the STK3002 rejection signal.
    stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
        "pkgimg-fn-item-kind-obligation-rejection",
        raw"""
import Facade
module Demo

fn void Run()
{
    stack fnptr<finite i32[min max]()> needsFinite = Facade.Plain;
    stack fnptr<law i32[min max]()> needsLaw = Facade.Plain;
    stack fnptr<finite law i32[min max]()> needsBothFromFinite = Facade.FiniteOnly;
    stack fnptr<finite law i32[min max]()> needsBothFromLaw = Facade.LawOnly;
    return;
}
""",
        "",
        "Facade.stark",
        raw"""
module Facade

public fn i32[min max] Plain();
public finite i32[min max] FiniteOnly();
public law i32[min max] LawOnly();
""");
    return FailsWithDiagnosticMessage(compiled, "STK3002", "cannot be promoted");
}

// Ported from PackageImageCallableValueTests.PackageImageBackedUnsafeFunctionItemsDoNotPromoteToOrdinaryFunctionPointers.
public unsafe fn bool PackageImageBackedUnsafeFunctionItemsDoNotPromoteToOrdinaryFunctionPointersImpl()
{
    // PORT-NOTE: C# asserts the consumer fails with STK3024 whose message mentions
    // "cannot be promoted to ordinary function pointer".
    stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
        "pkgimg-unsafe-fn-item-no-ordinary-promotion",
        raw"""
import Facade
module Demo

fn void Run()
{
    stack fnptr<fn i32[min max]()> callback = Facade.Touch;
    return;
}
""",
        "",
        "Facade.stark",
        raw"""
module Facade

public unsafe fn i32[min max] Touch();
""");
    return FailsWithDiagnosticMessage(compiled, "STK3024", "cannot be promoted to ordinary function pointer");
}

// Ported from PackageImageCallableValueTests.PackageImageBackedUnsafeFunctionCallsRequireUnsafeContext.
public unsafe fn bool PackageImageBackedUnsafeFunctionCallsRequireUnsafeContextImpl()
{
    // PORT-NOTE: C# runs two consumer compiles against the same published Facade
    // library: a "Bad" consumer that calls Facade.Touch() outside an unsafe context
    // (asserts STK3024 "Unsafe function 'Facade.Touch' requires an unsafe context")
    // and a "Good" consumer that wraps the call in an unsafe block (asserts it
    // succeeds). Both are ported and combined.
    stack mut LlvmCompile bad = CompileTypeCheckWithModule(
        "pkgimg-unsafe-call-requires-context-bad",
        raw"""
import Facade
module Demo

fn void Run()
{
    Facade.Touch();
    return;
}
""",
        "",
        "Facade.stark",
        raw"""
module Facade

public unsafe fn void Touch();
""");

    stack mut LlvmCompile good = CompileTypeCheckWithModule(
        "pkgimg-unsafe-call-requires-context-good",
        raw"""
import Facade
module Demo

fn void Run()
{
    unsafe
    {
        Facade.Touch();
    }

    return;
}
""",
        "",
        "Facade.stark",
        raw"""
module Facade

public unsafe fn void Touch();
""");

    return FailsWithDiagnosticMessage(bad, "STK3024", "requires an unsafe context")
        && Succeeds(good);
}
