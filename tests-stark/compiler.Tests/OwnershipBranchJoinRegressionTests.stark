import CompilerTestSupport
import System.Testing
module OwnershipBranchJoinRegressionTests

// Ported slice of tests/compiler.Tests/OwnershipBranchJoinRegressionTests.cs.
//
// Each C# test concatenates the shared `MoveOnlyPrelude` (module Demo with a
// move-only `Box`, a `Holder`, and `fn void Consume(Box value)`) with a
// per-test `fn ... Build(...)` and runs it through the ownership/branch-join
// validation pass via Compile(...). The prelude is inlined verbatim into each
// embedded raw string here. All scenarios are ownership/branch-join checks, so
// each is routed through CompileTypeCheck. AssertSucceeded -> Succeeds(...);
// AssertMoveOrInitializationError -> !Succeeds(...) plus STK4200/STK4205
// presence; the explicit STK4200 assert -> FailsWithDiagnostic(..., "STK4200").

// Ported from OwnershipBranchJoinRegressionTests.EarlyReturnMoveInThenBranchDoesNotPoisonTheFallThroughJoin.
internal fn bool EarlyReturnMoveInThenBranchDoesNotPoisonTheFallThroughJoinImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-early-return-then-no-poison",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

struct Holder
{
    bool Flag;
    Box Data;

    Holder()
    {
        self.Flag = false;
        self.Data = new Box()
        {
            Value = 0
        };
    }
}

fn void Consume(Box value)
{
    return;
}

fn Holder Build(bool flag)
{
    stack mut Holder holder = new();
    if (flag)
    {
        return holder;
    }

    return holder;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from OwnershipBranchJoinRegressionTests.EarlyReturnMoveThenFieldReassignmentAndAggregateReturnValidates.
internal fn bool EarlyReturnMoveThenFieldReassignmentAndAggregateReturnValidatesImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-early-return-field-reassign-aggregate",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

struct Holder
{
    bool Flag;
    Box Data;

    Holder()
    {
        self.Flag = false;
        self.Data = new Box()
        {
            Value = 0
        };
    }
}

fn void Consume(Box value)
{
    return;
}

fn Holder Build(bool flag)
{
    stack mut Holder holder = new();
    if (flag)
    {
        return holder;
    }

    holder.Data = new Box()
    {
        Value = 7
    };
    return holder;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from OwnershipBranchJoinRegressionTests.SwitchArmEarlyReturnMoveDoesNotPoisonTheFallThroughJoin.
internal fn bool SwitchArmEarlyReturnMoveDoesNotPoisonTheFallThroughJoinImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-switch-arm-early-return-no-poison",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

struct Holder
{
    bool Flag;
    Box Data;

    Holder()
    {
        self.Flag = false;
        self.Data = new Box()
        {
            Value = 0
        };
    }
}

fn void Consume(Box value)
{
    return;
}

fn Holder Build(i64[min max] mode)
{
    stack mut Holder holder = new();
    switch (mode)
    {
        case 0:
        {
            return holder;
        }
        case _:
        {
        }
    }

    holder.Data = new Box()
    {
        Value = 7
    };
    return holder;
}
""");
        return Succeeds(compiled);
    }
}

// Ported from OwnershipBranchJoinRegressionTests.ConditionalMoveWithoutReturnStillErrorsOnLaterUse.
internal fn bool ConditionalMoveWithoutReturnStillErrorsOnLaterUseImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-conditional-move-no-return-errors",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

struct Holder
{
    bool Flag;
    Box Data;

    Holder()
    {
        self.Flag = false;
        self.Data = new Box()
        {
            Value = 0
        };
    }
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Build(bool flag)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    if (flag)
    {
        Consume(box);
    }

    stack Box other = box;
    return other.Value;
}
""");
        // AssertMoveOrInitializationError: compile fails with STK4200 or STK4205.
        return !Succeeds(compiled)
            && (HasDiagnostic(compiled, "STK4200") || HasDiagnostic(compiled, "STK4205"));
    }
}

// Ported from OwnershipBranchJoinRegressionTests.MoveBeforeBreakStaysVisibleAfterTheLoop.
internal fn bool MoveBeforeBreakStaysVisibleAfterTheLoopImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-move-before-break-visible-after-loop",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

struct Holder
{
    bool Flag;
    Box Data;

    Holder()
    {
        self.Flag = false;
        self.Data = new Box()
        {
            Value = 0
        };
    }
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Build(bool flag)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    stack mut i64[min max] index = 0;
    while willexit (index < 3)
    {
        if (flag)
        {
            Consume(box);
            break;
        }

        index = index + 1;
    }

    stack Box other = box;
    return other.Value;
}
""");
        // AssertMoveOrInitializationError: compile fails with STK4200 or STK4205.
        return !Succeeds(compiled)
            && (HasDiagnostic(compiled, "STK4200") || HasDiagnostic(compiled, "STK4205"));
    }
}

// Ported from OwnershipBranchJoinRegressionTests.ElseBranchMoveSurvivesWhenThenBranchReturns.
internal fn bool ElseBranchMoveSurvivesWhenThenBranchReturnsImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-else-branch-move-survives-then-return",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

struct Holder
{
    bool Flag;
    Box Data;

    Holder()
    {
        self.Flag = false;
        self.Data = new Box()
        {
            Value = 0
        };
    }
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Build(bool flag)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    if (flag)
    {
        return 7;
    }
    else
    {
        Consume(box);
    }

    stack Box other = box;
    return other.Value;
}
""");
        // The surviving path moved the value unconditionally, so the join
        // reports the precise definite-move error STK4200, not a maybe-move.
        return FailsWithDiagnostic(compiled, "STK4200");
    }
}

// Ported from OwnershipBranchJoinRegressionTests.SwitchFallThroughArmMoveStillErrors.
internal fn bool SwitchFallThroughArmMoveStillErrorsImpl()
{
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "ownerp1-switch-fallthrough-arm-move-errors",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;

    drop
    {
    }
}

struct Holder
{
    bool Flag;
    Box Data;

    Holder()
    {
        self.Flag = false;
        self.Data = new Box()
        {
            Value = 0
        };
    }
}

fn void Consume(Box value)
{
    return;
}

fn i32[min max] Build(i64[min max] mode)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    switch (mode)
    {
        case 0:
        {
            Consume(box);
        }
        case _:
        {
        }
    }

    stack Box other = box;
    return other.Value;
}
""");
        // AssertMoveOrInitializationError: compile fails with STK4200 or STK4205.
        return !Succeeds(compiled)
            && (HasDiagnostic(compiled, "STK4200") || HasDiagnostic(compiled, "STK4205"));
    }
}
