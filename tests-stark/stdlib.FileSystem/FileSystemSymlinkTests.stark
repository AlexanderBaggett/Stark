import System.Testing
import System.FileSystem
import System.IO
import System.IO.File
import System.Text
[Collection("filesystem")]
module FileSystemSymlinkTests

// Stark-native tests for System.FileSystem symlink policy (S10) and richer IO
// error mapping (S09/S10). Verified on macOS; the same public API is wired
// through the Linux backend via the shared platform dispatch layer.

finite law bool IsNotFound(System.IO.IOError error)
{
    return error == System.IO.IOError.NotFound;
}

finite law bool IsSymlinkKind(System.FileSystem.FileSystemEntryKind kind)
{
    return kind == System.FileSystem.FileSystemEntryKind.Symlink;
}

finite law bool IsNotADirectory(System.IO.IOError error)
{
    return error == System.IO.IOError.NotADirectory;
}

enum SymlinkFixture
{
    Ready
    {
        TargetPath: System.Text.OwnedAscii, LinkPath: System.Text.OwnedAscii
    },
    Failed,
}

// Creates a symlink at <tmp>/link pointing at the absolute path of
// <tmp>/target.txt (an existing file) and returns both absolute paths.
fn SymlinkFixture CreateSymlinkFixture(mut borrow System.Testing.TempDirectory fixture)
{
    switch (fixture.WriteText("target.txt", "payload"))
    {
        case System.IO.IOStatus.Err(var writeError):
            return SymlinkFixture.Failed;
        case System.IO.IOStatus.Ok:
    }

    stack mut System.Text.OwnedAscii targetPath = new();
    switch (fixture.PathFor("target.txt"))
    {
        case System.IO.IOResult<System.Text.OwnedAscii>.Err(var pathError):
            return SymlinkFixture.Failed;
        case System.IO.IOResult<System.Text.OwnedAscii>.Ok(var value):
            targetPath = value;
    }

    stack mut System.Text.OwnedAscii linkPath = new();
    switch (fixture.PathFor("link"))
    {
        case System.IO.IOResult<System.Text.OwnedAscii>.Err(var pathError):
            return SymlinkFixture.Failed;
        case System.IO.IOResult<System.Text.OwnedAscii>.Ok(var value):
            linkPath = value;
    }

    switch (System.FileSystem.CreateSymlink(targetPath.View(), linkPath.View()))
    {
        case System.IO.IOStatus.Err(var linkError):
            return SymlinkFixture.Failed;
        case System.IO.IOStatus.Ok:
            return SymlinkFixture.Ready
            {
                TargetPath: targetPath, LinkPath: linkPath
            };
    }
}

// CreateSymlink then ReadSymlink round-trips the stored target verbatim.
[Fact]
fn bool ReadSymlinkRoundTripsTarget()
{
    stack mut System.Testing.TempDirectory fixture = new();
    switch (System.Testing.CreateTempDirectory("stark-fs-symlink"))
    {
        case System.IO.IOResult<System.Testing.TempDirectory>.Err(var error):
            return false;
        case System.IO.IOResult<System.Testing.TempDirectory>.Ok(var value):
            fixture = value;
    }

    stack mut System.Text.OwnedAscii targetPath = new();
    stack mut System.Text.OwnedAscii linkPath = new();
    switch (CreateSymlinkFixture(fixture))
    {
        case SymlinkFixture.Failed:
            return false;
        case SymlinkFixture.Ready
        {
            TargetPath: var target, LinkPath: var link
        }:
            targetPath = target;
            linkPath = link;
    }

    switch (System.FileSystem.ReadSymlink(linkPath.View()))
    {
        case System.IO.IOResult<System.Text.OwnedAscii>.Err(var error):
            return false;
        case System.IO.IOResult<System.Text.OwnedAscii>.Ok(var stored):
            stack mut System.Text.OwnedAscii readBack = stored;
            return System.Testing.Equal(targetPath.View(), readBack.View());
    }
}

// LinkMetadata (lstat) reports the link itself as a symlink, while Metadata
// (stat) follows the link and reports the target file.
[Fact]
fn bool LinkMetadataDetectsSymlinkWhileMetadataFollows()
{
    stack mut System.Testing.TempDirectory fixture = new();
    switch (System.Testing.CreateTempDirectory("stark-fs-symlink"))
    {
        case System.IO.IOResult<System.Testing.TempDirectory>.Err(var error):
            return false;
        case System.IO.IOResult<System.Testing.TempDirectory>.Ok(var value):
            fixture = value;
    }

    stack mut System.Text.OwnedAscii targetPath = new();
    stack mut System.Text.OwnedAscii linkPath = new();
    switch (CreateSymlinkFixture(fixture))
    {
        case SymlinkFixture.Failed:
            return false;
        case SymlinkFixture.Ready
        {
            TargetPath: var target, LinkPath: var link
        }:
            targetPath = target;
            linkPath = link;
    }

    stack mut bool linkIsSymlink = false;
    switch (System.FileSystem.LinkMetadata(linkPath.View()))
    {
        case System.IO.IOResult<System.FileSystem.FileMetadata>.Err(var error):
            return false;
        case System.IO.IOResult<System.FileSystem.FileMetadata>.Ok(var metadata):
            linkIsSymlink = IsSymlinkKind(metadata.Kind);
    }

    stack mut bool followedIsFile = false;
    switch (System.FileSystem.Metadata(linkPath.View()))
    {
        case System.IO.IOResult<System.FileSystem.FileMetadata>.Err(var error):
            return false;
        case System.IO.IOResult<System.FileSystem.FileMetadata>.Ok(var metadata):
            followedIsFile = metadata.Kind == System.FileSystem.FileSystemEntryKind.File;
    }

    return linkIsSymlink && followedIsFile;
}

// IsSymlink is true for a link and false for an ordinary file.
[Fact]
fn bool IsSymlinkDistinguishesLinkFromFile()
{
    stack mut System.Testing.TempDirectory fixture = new();
    switch (System.Testing.CreateTempDirectory("stark-fs-symlink"))
    {
        case System.IO.IOResult<System.Testing.TempDirectory>.Err(var error):
            return false;
        case System.IO.IOResult<System.Testing.TempDirectory>.Ok(var value):
            fixture = value;
    }

    stack mut System.Text.OwnedAscii targetPath = new();
    stack mut System.Text.OwnedAscii linkPath = new();
    switch (CreateSymlinkFixture(fixture))
    {
        case SymlinkFixture.Failed:
            return false;
        case SymlinkFixture.Ready
        {
            TargetPath: var target, LinkPath: var link
        }:
            targetPath = target;
            linkPath = link;
    }

    stack mut bool linkResult = false;
    switch (System.FileSystem.IsSymlink(linkPath.View()))
    {
        case System.IO.IOResult<bool>.Err(var error):
            return false;
        case System.IO.IOResult<bool>.Ok(var value):
            linkResult = value;
    }

    stack mut bool fileResult = true;
    switch (System.FileSystem.IsSymlink(targetPath.View()))
    {
        case System.IO.IOResult<bool>.Err(var error):
            return false;
        case System.IO.IOResult<bool>.Ok(var value):
            fileResult = value;
    }

    return linkResult && !fileResult;
}

// Error mapping: metadata on a missing path maps errno ENOENT to NotFound,
// rather than collapsing into a generic Unknown failure.
[Fact]
fn bool MetadataOnMissingPathMapsToNotFound()
{
    stack mut System.Testing.TempDirectory fixture = new();
    switch (System.Testing.CreateTempDirectory("stark-fs-symlink"))
    {
        case System.IO.IOResult<System.Testing.TempDirectory>.Err(var error):
            return false;
        case System.IO.IOResult<System.Testing.TempDirectory>.Ok(var value):
            fixture = value;
    }

    stack mut System.Text.OwnedAscii missingPath = new();
    switch (fixture.PathFor("does-not-exist.txt"))
    {
        case System.IO.IOResult<System.Text.OwnedAscii>.Err(var pathError):
            return false;
        case System.IO.IOResult<System.Text.OwnedAscii>.Ok(var value):
            missingPath = value;
    }

    switch (System.FileSystem.Metadata(missingPath.View()))
    {
        case System.IO.IOResult<System.FileSystem.FileMetadata>.Err(var error):
            return IsNotFound(error);
        case System.IO.IOResult<System.FileSystem.FileMetadata>.Ok(var metadata):
            return false;
    }
}

