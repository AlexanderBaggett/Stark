[Fact]
fn bool MirLoweringLowersValueReturnToMirReturnBlockAndPreservesFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> functions = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(39), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral literal = HighLevelIrIntegerLiteralOf(SymbolIdOf(20), MirType.I32, 64);
    stack mut MirValueId value = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(literal, builder, symbols, instructions, valueFacts, value)))
    {
        return System.Testing.Fail("lower-literal");
    }

    stack HighLevelIrReturn ret = HighLevelIrReturnOf(MirType.I32, value);
    stack mut MirBlockId returnBlock = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrReturn(ret, builder, blocks, instructions, valueFacts, returnBlock)))
    {
        return System.Testing.Fail("lower-return");
    }

    stack mut MirFuncId function = new();
    if (!MirBuilderStatusOk(FinishMirFunctionBuilder(builder, functions, function)))
    {
        return System.Testing.Fail("finish");
    }

    stack ValueFacts facts = ValueFactsForMirValue(valueFacts, value);
    return HighLevelIrReturnType(ret) == MirType.I32
        && HighLevelIrReturnValue(ret).Equals(value)
        && instructions.Count() == 1
        && valueFacts.Count() == 1
        && blocks.Count() == 1
        && MirFunctionBuilderInstructionCount(builder) == 1
        && MirFunctionBuilderBlockCount(builder) == 1
        && MirFunctionBuilderOwnsValue(builder, value)
        && MirFunctionBuilderOwnsBlock(builder, returnBlock)
        && MirBlockTerminator(blocks, returnBlock) == MirTermKind.Return
        && MirBlockReturnValue(blocks, returnBlock).Equals(value)
        && function.Index() == 1
        && MirFunctionEntry(functions, function).Equals(returnBlock)
        && MirFunctionBlockCount(functions, function) == 1
        && MirFunctionInstrCount(functions, function) == 1
        && ValueFactsIntegerRangeIs(facts, 64, 65);
}

