    stack HighLevelIrBinaryOp sdivOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(44), HighLevelIrBinaryOpKind.SDiv, MirType.I32, left, right);
    stack HighLevelIrBinaryOp udivOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(45), HighLevelIrBinaryOpKind.UDiv, MirType.I32, left, right);
    stack HighLevelIrBinaryOp sremOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(46), HighLevelIrBinaryOpKind.SRem, MirType.I32, left, right);
    stack HighLevelIrBinaryOp andOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(47), HighLevelIrBinaryOpKind.And, MirType.I32, left, right);
    stack HighLevelIrBinaryOp orOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(48), HighLevelIrBinaryOpKind.Or, MirType.I32, left, right);
    stack HighLevelIrBinaryOp xorOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(49), HighLevelIrBinaryOpKind.Xor, MirType.I32, left, right);
    stack HighLevelIrBinaryOp shlOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(50), HighLevelIrBinaryOpKind.Shl, MirType.I32, left, right);
    stack HighLevelIrBinaryOp ashrOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(51), HighLevelIrBinaryOpKind.AShr, MirType.I32, left, right);

    stack mut MirValueId sdiv = new();
    stack mut MirValueId udiv = new();
    stack mut MirValueId srem = new();
    stack mut MirValueId andValue = new();
    stack mut MirValueId orValue = new();
    stack mut MirValueId xorValue = new();
    stack mut MirValueId shl = new();
    stack mut MirValueId ashr = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(sdivOp, builder, symbols, instructions, valueFacts, sdiv)))
    {
        return System.Testing.Fail("lower-sdiv");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(udivOp, builder, symbols, instructions, valueFacts, udiv)))
    {
        return System.Testing.Fail("lower-udiv");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(sremOp, builder, symbols, instructions, valueFacts, srem)))
    {
        return System.Testing.Fail("lower-srem");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(andOp, builder, symbols, instructions, valueFacts, andValue)))
    {
        return System.Testing.Fail("lower-and");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(orOp, builder, symbols, instructions, valueFacts, orValue)))
    {
        return System.Testing.Fail("lower-or");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(xorOp, builder, symbols, instructions, valueFacts, xorValue)))
    {
        return System.Testing.Fail("lower-xor");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(shlOp, builder, symbols, instructions, valueFacts, shl)))
    {
        return System.Testing.Fail("lower-shl");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(ashrOp, builder, symbols, instructions, valueFacts, ashr)))
    {
        return System.Testing.Fail("lower-ashr");
    }

    return instructions.Count() == 10
        && valueFacts.Count() == 10
        && MirFunctionBuilderInstructionCount(builder) == 10
        && MirOpcodeOf(instructions, sdiv) == MirOp.SDiv
        && MirOpcodeOf(instructions, udiv) == MirOp.UDiv
        && MirOpcodeOf(instructions, srem) == MirOp.SRem
        && MirOpcodeOf(instructions, andValue) == MirOp.And
        && MirOpcodeOf(instructions, orValue) == MirOp.Or
        && MirOpcodeOf(instructions, xorValue) == MirOp.Xor
        && MirOpcodeOf(instructions, shl) == MirOp.Shl
        && MirOpcodeOf(instructions, ashr) == MirOp.AShr
        && MirValueType(instructions, shl.Index()) == MirType.I32
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, sdiv), 3, 4)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, udiv), 3, 4)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, srem), 2, 3)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, andValue), 4, 5)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, orValue), 22, 23)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, xorValue), 18, 19)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, shl), 1280, 1281)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, ashr), 0, 1)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(50)), 1280, 1281)
        && System.Text.Equals(HighLevelIrBinaryOpKindName(HighLevelIrBinaryOpKind.AShr), "ashr");
}

[Fact]
fn bool MirLoweringLowersExplicitWrappingAndSaturatingArithmeticWithFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(430), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack i64[min max] i32Min = (i64[min max])(-(2 ** 31));
    stack i64[min max] i32Max = 2147483647;
    stack i64[min max] i32MaxUpper = (i64[min max])(2 ** 31);

    stack HighLevelIrLiteral maxLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(431), MirType.I32, i32Max);
    stack HighLevelIrLiteral oneLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(432), MirType.I32, 1);
    stack HighLevelIrLiteral minLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(433), MirType.I32, i32Min);
    stack HighLevelIrLiteral bigLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(434), MirType.I32, 1073741824);
    stack HighLevelIrLiteral fourLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(435), MirType.I32, 4);
    stack mut MirValueId maxValue = new();
    stack mut MirValueId oneValue = new();
    stack mut MirValueId minValue = new();
    stack mut MirValueId bigValue = new();
    stack mut MirValueId fourValue = new();

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(maxLiteral, builder, symbols, instructions, valueFacts, maxValue)))
    {
        return System.Testing.Fail("lower-max");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(oneLiteral, builder, symbols, instructions, valueFacts, oneValue)))
    {
        return System.Testing.Fail("lower-one");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(minLiteral, builder, symbols, instructions, valueFacts, minValue)))
    {
        return System.Testing.Fail("lower-min");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(bigLiteral, builder, symbols, instructions, valueFacts, bigValue)))
    {
        return System.Testing.Fail("lower-big");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(fourLiteral, builder, symbols, instructions, valueFacts, fourValue)))
    {
        return System.Testing.Fail("lower-four");
    }

    stack mut MirValueId wrapAdd = new();
    stack mut MirValueId wrapSub = new();
    stack mut MirValueId wrapMul = new();
    stack mut MirValueId satAdd = new();
    stack mut MirValueId satSub = new();
    stack mut MirValueId satMul = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(
        HighLevelIrBinaryOpOf(SymbolIdOf(436), HighLevelIrBinaryOpKind.WrappingAdd, MirType.I32, maxValue, oneValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        wrapAdd)))
    {
        return System.Testing.Fail("lower-wrap-add");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(
        HighLevelIrBinaryOpOf(SymbolIdOf(437), HighLevelIrBinaryOpKind.WrappingSub, MirType.I32, minValue, oneValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        wrapSub)))
    {
        return System.Testing.Fail("lower-wrap-sub");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(
        HighLevelIrBinaryOpOf(SymbolIdOf(438), HighLevelIrBinaryOpKind.WrappingMul, MirType.I32, bigValue, fourValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        wrapMul)))
    {
        return System.Testing.Fail("lower-wrap-mul");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(
        HighLevelIrBinaryOpOf(SymbolIdOf(439), HighLevelIrBinaryOpKind.SaturatingAdd, MirType.I32, maxValue, oneValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        satAdd)))
    {
        return System.Testing.Fail("lower-sat-add");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(
        HighLevelIrBinaryOpOf(SymbolIdOf(440), HighLevelIrBinaryOpKind.SaturatingSub, MirType.I32, minValue, oneValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        satSub)))
    {
        return System.Testing.Fail("lower-sat-sub");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(
        HighLevelIrBinaryOpOf(SymbolIdOf(441), HighLevelIrBinaryOpKind.SaturatingMul, MirType.I32, bigValue, fourValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        satMul)))
    {
        return System.Testing.Fail("lower-sat-mul");
    }

    return instructions.Count() == 11
        && valueFacts.Count() == 11
        && MirFunctionBuilderInstructionCount(builder) == 11
        && MirOpcodeOf(instructions, wrapAdd) == MirOp.WrappingAdd
        && MirOpcodeOf(instructions, wrapSub) == MirOp.WrappingSub
        && MirOpcodeOf(instructions, wrapMul) == MirOp.WrappingMul
        && MirOpcodeOf(instructions, satAdd) == MirOp.SaturatingAdd
        && MirOpcodeOf(instructions, satSub) == MirOp.SaturatingSub
        && MirOpcodeOf(instructions, satMul) == MirOp.SaturatingMul
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, wrapAdd), i32Min, i32Min + 1)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, wrapSub), i32Max, i32MaxUpper)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, wrapMul), 0, 1)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, satAdd), i32Max, i32MaxUpper)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, satSub), i32Min, i32Min + 1)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, satMul), i32Max, i32MaxUpper)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(436)), i32Min, i32Min + 1)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(441)), i32Max, i32MaxUpper)
        && System.Text.Equals(HighLevelIrBinaryOpKindName(HighLevelIrBinaryOpKind.WrappingAdd), "wrapping-add")
        && System.Text.Equals(HighLevelIrBinaryOpKindName(HighLevelIrBinaryOpKind.SaturatingMul), "saturating-mul");
}

[Fact]
fn bool MirLoweringRejectsExactInvalidExtendedIntegerFactsWithoutEmission()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(52), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral leftLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(53), MirType.I32, 7);
    stack HighLevelIrLiteral zeroLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(54), MirType.I32, 0);
    stack mut MirValueId left = new();
    stack mut MirValueId zero = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(leftLiteral, builder, symbols, instructions, valueFacts, left)))
    {
        return System.Testing.Fail("lower-left");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(zeroLiteral, builder, symbols, instructions, valueFacts, zero)))
    {
        return System.Testing.Fail("lower-zero");
    }

    stack HighLevelIrBinaryOp op =
        HighLevelIrBinaryOpOf(SymbolIdOf(55), HighLevelIrBinaryOpKind.SDiv, MirType.I32, left, zero);
    stack mut MirValueId result = new();
    stack MirBuilderStatus status =
        LowerHighLevelIrBinaryOp(op, builder, symbols, instructions, valueFacts, result);

    return MirBuilderStatusErrIs(status, MirBuilderError.InvalidBuilderState)
        && !result.IsValid()
        && instructions.Count() == 2
        && valueFacts.Count() == 2
        && MirFunctionBuilderInstructionCount(builder) == 2
        && symbols.KindAt(SymbolIdOf(55)) == MirLoweringSymbolKind.Unknown;
}

[Fact]
fn bool MirLoweringRejectsBinaryOperandFactsOutsideTypeWithoutEmission()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(484), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack MirValueId scalarLeft = MirConstIntTyped(instructions, MirType.I32, 8);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, scalarLeft)))
    {
        return System.Testing.Fail("record-scalar");
    }

    stack mut ValueFacts scalarLeftFacts = new();
    scalarLeftFacts.MarkKnownNull();
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, scalarLeft, scalarLeftFacts))
    {
        return System.Testing.Fail("facts-scalar");
    }

    stack MirValueId right = MirConstIntTyped(instructions, MirType.I32, 1);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, right)))
    {
        return System.Testing.Fail("record-right");
    }

    stack mut ValueFacts rightFacts = new();
    rightFacts.SetIntegerRange(1, 2);
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, right, rightFacts))
    {
        return System.Testing.Fail("facts-right");
    }

    stack mut MirValueId scalarResult = new();
    stack MirBuilderStatus scalarStatus =
        LowerHighLevelIrBinaryOp(
            HighLevelIrBinaryOpOf(SymbolIdOf(485), HighLevelIrBinaryOpKind.Add, MirType.I32, scalarLeft, right),
            builder,
            symbols,
            instructions,
            valueFacts,
            scalarResult);

    stack MirValueId wideLeft = MirConstIntTyped(instructions, MirType.I32, 9);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, wideLeft)))
    {
        return System.Testing.Fail("record-wide");
    }

    stack mut ValueFacts wideLeftFacts = new();
    wideLeftFacts.SetIntegerRange(2147483648, 2147483649);
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, wideLeft, wideLeftFacts))
    {
        return System.Testing.Fail("facts-wide");
    }

    stack mut MirValueId wideResult = new();
    stack MirBuilderStatus wideStatus =
        LowerHighLevelIrBinaryOp(
            HighLevelIrBinaryOpOf(SymbolIdOf(486), HighLevelIrBinaryOpKind.Add, MirType.I32, wideLeft, right),
            builder,
            symbols,
            instructions,
            valueFacts,
            wideResult);

    return MirBuilderStatusErrIs(scalarStatus, MirBuilderError.TypeMismatch)
        && MirBuilderStatusErrIs(wideStatus, MirBuilderError.TypeMismatch)
        && !scalarResult.IsValid()
        && !wideResult.IsValid()
        && instructions.Count() == 3
        && valueFacts.Count() == 3
        && MirFunctionBuilderInstructionCount(builder) == 3
        && symbols.KindAt(SymbolIdOf(485)) == MirLoweringSymbolKind.Unknown
        && symbols.KindAt(SymbolIdOf(486)) == MirLoweringSymbolKind.Unknown;
}

[Fact]
fn bool MirLoweringLowersTypedDirectCallWithResultFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(56), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral leftLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(57), MirType.I32, 11);
    stack HighLevelIrLiteral rightLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(58), MirType.I32, 31);
    stack mut MirValueId left = new();
    stack mut MirValueId right = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(leftLiteral, builder, symbols, instructions, valueFacts, left)))
    {
        return System.Testing.Fail("lower-left");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(rightLiteral, builder, symbols, instructions, valueFacts, right)))
    {
        return System.Testing.Fail("lower-right");
    }

    stack mut ValueFacts resultFacts = new();
    resultFacts.SetIntegerRange(42, 43);
    resultFacts.SetAlignment(4);
    resultFacts.SetCallingAbi(AbiKind.CAbi);
    resultFacts.MarkNoAlias();
    resultFacts.MarkVolatile();
    stack HighLevelIrCall call =
        HighLevelIrCallOf(SymbolIdOf(59), MirFuncIdOf(7), MirType.I32, 2, left, right, MirValueIdOf(0), MirValueIdOf(0), resultFacts);
    stack mut MirValueId result = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCall(call, builder, symbols, instructions, valueFacts, result)))
    {
        return System.Testing.Fail("lower-call");
    }

    stack ValueFacts tableFacts = ValueFactsForMirValue(valueFacts, result);
    stack ValueFacts symbolFacts = symbols.FactsAt(SymbolIdOf(59));
    return instructions.Count() == 3
        && valueFacts.Count() == 3
        && MirFunctionBuilderInstructionCount(builder) == 3
        && HighLevelIrCallSymbol(call).Equals(SymbolIdOf(59))
        && HighLevelIrCallCallee(call).Equals(MirFuncIdOf(7))
        && HighLevelIrCallType(call) == MirType.I32
        && HighLevelIrCallArgumentCount(call) == 2
        && HighLevelIrCallArgumentAt(call, 0).Equals(left)
        && HighLevelIrCallArgumentAt(call, 1).Equals(right)
        && HighLevelIrCallFacts(call).IntegerRangeLower() == 42
        && MirOpcodeOf(instructions, result) == MirOp.Call
        && MirCalleeOf(instructions, result).Equals(MirFuncIdOf(7))
        && MirOperandAOf(instructions, result).Equals(left)
        && MirOperandBOf(instructions, result).Equals(right)
        && MirValueType(instructions, result.Index()) == MirType.I32
        && ValueFactsIntegerRangeIs(tableFacts, 42, 43)
        && tableFacts.HasAlignment()
        && tableFacts.AlignmentBytes() == 4
        && tableFacts.HasCallingAbi()
        && tableFacts.CallingAbi() == AbiKind.CAbi
        && tableFacts.HasNoAlias()
        && tableFacts.Volatile()
        && ValueFactsIntegerRangeIs(symbolFacts, 42, 43)
        && symbolFacts.HasAlignment()
        && symbolFacts.AlignmentBytes() == 4
        && symbolFacts.HasCallingAbi()
        && symbolFacts.CallingAbi() == AbiKind.CAbi
        && symbolFacts.HasNoAlias()
        && symbolFacts.Volatile();
}

[Fact]
fn bool MirLoweringLowersPointerDirectCallWithNullabilityFact()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(62), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack mut ValueFacts resultFacts = new();
    resultFacts.SetAlignment(8);
    resultFacts.MarkNoAlias();
    resultFacts.MarkKnownNonNull();
    stack HighLevelIrCall call =
        HighLevelIrCallOf(SymbolIdOf(63), MirFuncIdOf(9), MirType.Ptr, 0, MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), resultFacts);
    stack mut MirValueId result = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCall(call, builder, symbols, instructions, valueFacts, result)))
    {
        return System.Testing.Fail("lower-call");
    }

    stack ValueFacts tableFacts = ValueFactsForMirValue(valueFacts, result);
    stack ValueFacts symbolFacts = symbols.FactsAt(SymbolIdOf(63));
    return instructions.Count() == 1
        && valueFacts.Count() == 1
        && MirFunctionBuilderInstructionCount(builder) == 1
        && MirOpcodeOf(instructions, result) == MirOp.Call
        && MirCalleeOf(instructions, result).Equals(MirFuncIdOf(9))
        && MirValueType(instructions, result.Index()) == MirType.Ptr
        && tableFacts.HasAlignment()
        && tableFacts.AlignmentBytes() == 8
        && tableFacts.HasNoAlias()
        && ValueFactsKnownNonNull(tableFacts)
        && symbolFacts.HasAlignment()
        && symbolFacts.AlignmentBytes() == 8
        && symbolFacts.HasNoAlias()
        && ValueFactsKnownNonNull(symbolFacts);
}

