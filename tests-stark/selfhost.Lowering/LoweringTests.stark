[Fact]
fn bool MirLoweringBindsLocalAliasWithoutEmissionAndPreservesFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(37), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral literal = HighLevelIrIntegerLiteralOf(SymbolIdOf(16), MirType.I32, 77);
    stack mut MirValueId initializer = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(literal, builder, symbols, instructions, valueFacts, initializer)))
    {
        return System.Testing.Fail("lower-initializer");
    }

    stack HighLevelIrLocalAlias local = HighLevelIrLocalAliasOf(SymbolIdOf(17), MirType.I32, initializer);
    if (!MirBuilderStatusOk(LowerHighLevelIrLocalAlias(local, builder, symbols, instructions, valueFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    stack mut MirValueId found = new();
    return instructions.Count() == 1
        && valueFacts.Count() == 1
        && MirFunctionBuilderInstructionCount(builder) == 1
        && symbols.KindAt(SymbolIdOf(17)) == MirLoweringSymbolKind.Local
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(17), found)
        && found.Equals(initializer)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(17)), 77, 78);
}

