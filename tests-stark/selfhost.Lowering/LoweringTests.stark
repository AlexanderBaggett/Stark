[Fact]
fn bool MirLoweringRejectsLocalAliasFactsOutsideTypeWithoutBinding()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(39), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack MirValueId scalarValue = MirConstIntTyped(instructions, MirType.I32, 4);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, scalarValue)))
    {
        return System.Testing.Fail("record-scalar");
    }

    stack mut ValueFacts scalarFacts = new();
    scalarFacts.MarkKnownNull();
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, scalarValue, scalarFacts))
    {
        return System.Testing.Fail("facts-scalar");
    }

    stack MirBuilderStatus scalarStatus = LowerHighLevelIrLocalAlias(
        HighLevelIrLocalAliasOf(SymbolIdOf(20), MirType.I32, scalarValue),
        builder,
        symbols,
        instructions,
        valueFacts);

    stack MirValueId pointerValue = MirConstNullPtr(instructions);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, pointerValue)))
    {
        return System.Testing.Fail("record-pointer");
    }

    stack mut ValueFacts pointerFacts = new();
    pointerFacts.SetIntegerRange(0, 1);
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, pointerValue, pointerFacts))
    {
        return System.Testing.Fail("facts-pointer");
    }

    stack MirBuilderStatus pointerStatus = LowerHighLevelIrLocalAlias(
        HighLevelIrLocalAliasOf(SymbolIdOf(21), MirType.Ptr, pointerValue),
        builder,
        symbols,
        instructions,
        valueFacts);

    return MirBuilderStatusErrIs(scalarStatus, MirBuilderError.TypeMismatch)
        && MirBuilderStatusErrIs(pointerStatus, MirBuilderError.TypeMismatch)
        && instructions.Count() == 2
        && valueFacts.Count() == 2
        && MirFunctionBuilderInstructionCount(builder) == 2
        && symbols.KindAt(SymbolIdOf(20)) == MirLoweringSymbolKind.Unknown
        && symbols.KindAt(SymbolIdOf(21)) == MirLoweringSymbolKind.Unknown;
}

[Fact]
fn bool MirLoweringLowersGlobalLoadStoreWithFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(480), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack mut ValueFacts globalFacts = new();
    globalFacts.SetIntegerRange(-3, 4);
    if (!MirBuilderStatusOk(BindMirLoweringGlobalSymbol(symbols, SymbolIdOf(481), 2, globalFacts)))
    {
        return System.Testing.Fail("bind-global");
    }

    stack HighLevelIrGlobalReference load =
        HighLevelIrGlobalReferenceOf(SymbolIdOf(482), SymbolIdOf(481), MirType.I64);
    stack mut MirValueId loadedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrGlobalReference(load, builder, symbols, instructions, valueFacts, loadedValue)))
    {
        return System.Testing.Fail("load-global");
    }

    stack HighLevelIrLiteral storedLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(483), MirType.I64, 2);
    stack mut MirValueId storedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(storedLiteral, builder, symbols, instructions, valueFacts, storedValue)))
    {
        return System.Testing.Fail("lower-stored");
    }

    stack HighLevelIrGlobalStore store =
        HighLevelIrGlobalStoreOf(SymbolIdOf(481), MirType.I64, storedValue);
    stack mut MirValueId storeInstruction = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrGlobalStore(store, builder, symbols, instructions, valueFacts, storeInstruction)))
    {
        return System.Testing.Fail("store-global");
    }

    stack mut MirValueId foundLoad = new();
    stack mut u32[0 max] foundGlobal = 0;
    stack ValueFacts loadFacts = ValueFactsForMirValue(valueFacts, loadedValue);
    stack ValueFacts storeFacts = ValueFactsForMirValue(valueFacts, storeInstruction);
    return instructions.Count() == 3
        && valueFacts.Count() == 3
        && MirFunctionBuilderInstructionCount(builder) == 3
        && HighLevelIrGlobalReferenceSymbol(load).Equals(SymbolIdOf(482))
        && HighLevelIrGlobalReferenceGlobalSymbol(load).Equals(SymbolIdOf(481))
        && HighLevelIrGlobalReferenceType(load) == MirType.I64
        && HighLevelIrGlobalStoreGlobalSymbol(store).Equals(SymbolIdOf(481))
        && HighLevelIrGlobalStoreType(store) == MirType.I64
        && HighLevelIrGlobalStoreValue(store).Equals(storedValue)
        && MirOpcodeOf(instructions, loadedValue) == MirOp.LoadGlobal
        && MirLoadedGlobalOf(instructions, loadedValue) == 2
        && MirOpcodeOf(instructions, storeInstruction) == MirOp.StoreGlobal
        && MirStoredGlobalOf(instructions, storeInstruction) == 2
        && MirOperandAOf(instructions, storeInstruction).Equals(storedValue)
        && TryFindMirLoweringGlobalSymbol(symbols, SymbolIdOf(481), foundGlobal)
        && foundGlobal == 2
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(482), foundLoad)
        && foundLoad.Equals(loadedValue)
        && symbols.KindAt(SymbolIdOf(481)) == MirLoweringSymbolKind.Global
        && symbols.KindAt(SymbolIdOf(482)) == MirLoweringSymbolKind.Temporary
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(481)), -3, 4)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(482)), -3, 4)
        && ValueFactsIntegerRangeIs(loadFacts, -3, 4)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, storedValue), 2, 3)
        && !storeFacts.HasIntegerRange();
}

[Fact]
fn bool MirLoweringLowersTypedGlobalLoadStoreWithFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(484), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack mut ValueFacts globalFacts = new();
    globalFacts.SetIntegerRange(20, 31);
    if (!MirBuilderStatusOk(BindMirLoweringTypedGlobalSymbol(symbols, SymbolIdOf(485), 4, MirType.I32, globalFacts)))
    {
        return System.Testing.Fail("bind-global");
    }

    stack HighLevelIrGlobalReference load =
        HighLevelIrGlobalReferenceOf(SymbolIdOf(486), SymbolIdOf(485), MirType.I32);
    stack mut MirValueId loadedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrGlobalReference(load, builder, symbols, instructions, valueFacts, loadedValue)))
    {
        return System.Testing.Fail("load-global");
    }

    stack HighLevelIrLiteral storedLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(487), MirType.I32, 25);
    stack mut MirValueId storedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(storedLiteral, builder, symbols, instructions, valueFacts, storedValue)))
    {
        return System.Testing.Fail("lower-stored");
    }

    stack HighLevelIrGlobalStore store =
        HighLevelIrGlobalStoreOf(SymbolIdOf(485), MirType.I32, storedValue);
    stack mut MirValueId storeInstruction = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrGlobalStore(store, builder, symbols, instructions, valueFacts, storeInstruction)))
    {
        return System.Testing.Fail("store-global");
    }

    stack mut u32[0 max] foundGlobal = 0;
    stack mut MirType foundType = MirType.I64;
    return instructions.Count() == 3
        && valueFacts.Count() == 3
        && MirFunctionBuilderInstructionCount(builder) == 3
        && MirOpcodeOf(instructions, loadedValue) == MirOp.LoadGlobal
        && MirValueType(instructions, loadedValue.Index()) == MirType.I32
        && MirLoadedGlobalOf(instructions, loadedValue) == 4
        && MirOpcodeOf(instructions, storeInstruction) == MirOp.StoreGlobal
        && MirValueType(instructions, storeInstruction.Index()) == MirType.I32
        && MirStoredGlobalOf(instructions, storeInstruction) == 4
        && TryFindMirLoweringTypedGlobalSymbol(symbols, SymbolIdOf(485), foundGlobal, foundType)
        && foundGlobal == 4
        && foundType == MirType.I32
        && symbols.TypeAt(SymbolIdOf(485)) == MirType.I32
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(485)), 20, 31)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, loadedValue), 20, 31)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, storedValue), 25, 26);
}

[Fact]
fn bool MirLoweringChecksGlobalStoreBackendFactSubset()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(520), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack mut ValueFacts globalFacts = new();
    globalFacts.SetAlignment(8);
    globalFacts.SetCallingAbi(AbiKind.CAbi);
    globalFacts.MarkNoAlias();
    globalFacts.MarkVolatile();
    globalFacts.MarkKnownNonNull();
    if (!MirBuilderStatusOk(BindMirLoweringTypedGlobalSymbol(symbols, SymbolIdOf(521), 6, MirType.Ptr, globalFacts)))
    {
        return System.Testing.Fail("bind-global");
    }

    stack mut ValueFacts strongFacts = new();
    strongFacts.SetAlignment(16);
    strongFacts.SetCallingAbi(AbiKind.CAbi);
    strongFacts.MarkNoAlias();
    strongFacts.MarkVolatile();
    strongFacts.MarkKnownNonNull();
    stack HighLevelIrCall strongCall =
        HighLevelIrCallOf(SymbolIdOf(522), MirFuncIdOf(14), MirType.Ptr, 0, MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), strongFacts);
    stack mut MirValueId strongValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCall(strongCall, builder, symbols, instructions, valueFacts, strongValue)))
    {
        return System.Testing.Fail("strong-call");
    }

    stack HighLevelIrGlobalStore strongStore =
        HighLevelIrGlobalStoreOf(SymbolIdOf(521), MirType.Ptr, strongValue);
    stack mut MirValueId strongStoreValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrGlobalStore(strongStore, builder, symbols, instructions, valueFacts, strongStoreValue)))
    {
        return System.Testing.Fail("strong-store");
    }

    stack mut ValueFacts weakFacts = new();
    weakFacts.SetAlignment(4);
    weakFacts.SetCallingAbi(AbiKind.CAbi);
    weakFacts.MarkNoAlias();
    weakFacts.MarkVolatile();
    weakFacts.MarkKnownNonNull();
    stack HighLevelIrCall weakCall =
        HighLevelIrCallOf(SymbolIdOf(523), MirFuncIdOf(15), MirType.Ptr, 0, MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), weakFacts);
    stack mut MirValueId weakValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCall(weakCall, builder, symbols, instructions, valueFacts, weakValue)))
    {
        return System.Testing.Fail("weak-call");
    }

    stack mut ValueFacts abiMismatchFacts = new();
    abiMismatchFacts.SetAlignment(16);
    abiMismatchFacts.SetCallingAbi(AbiKind.PlatformAbi);
    abiMismatchFacts.MarkNoAlias();
    abiMismatchFacts.MarkVolatile();
    abiMismatchFacts.MarkKnownNonNull();
    stack HighLevelIrCall abiMismatchCall =
        HighLevelIrCallOf(SymbolIdOf(524), MirFuncIdOf(16), MirType.Ptr, 0, MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), abiMismatchFacts);
    stack mut MirValueId abiMismatchValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCall(abiMismatchCall, builder, symbols, instructions, valueFacts, abiMismatchValue)))
    {
        return System.Testing.Fail("abi-mismatch-call");
    }

    stack mut ValueFacts missingNoAliasFacts = new();
    missingNoAliasFacts.SetAlignment(16);
    missingNoAliasFacts.SetCallingAbi(AbiKind.CAbi);
    missingNoAliasFacts.MarkVolatile();
    missingNoAliasFacts.MarkKnownNonNull();
    stack HighLevelIrCall missingNoAliasCall =
        HighLevelIrCallOf(SymbolIdOf(525), MirFuncIdOf(17), MirType.Ptr, 0, MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), missingNoAliasFacts);
    stack mut MirValueId missingNoAliasValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCall(missingNoAliasCall, builder, symbols, instructions, valueFacts, missingNoAliasValue)))
    {
        return System.Testing.Fail("missing-noalias-call");
    }

    stack mut ValueFacts missingVolatileFacts = new();
    missingVolatileFacts.SetAlignment(16);
    missingVolatileFacts.SetCallingAbi(AbiKind.CAbi);
    missingVolatileFacts.MarkNoAlias();
    missingVolatileFacts.MarkKnownNonNull();
    stack HighLevelIrCall missingVolatileCall =
        HighLevelIrCallOf(SymbolIdOf(526), MirFuncIdOf(18), MirType.Ptr, 0, MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), missingVolatileFacts);
    stack mut MirValueId missingVolatileValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCall(missingVolatileCall, builder, symbols, instructions, valueFacts, missingVolatileValue)))
    {
        return System.Testing.Fail("missing-volatile-call");
    }

    stack HighLevelIrLiteral nullLiteral = HighLevelIrNullPointerLiteralOf(SymbolIdOf(527));
    stack mut MirValueId nullValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(nullLiteral, builder, symbols, instructions, valueFacts, nullValue)))
    {
        return System.Testing.Fail("null-literal");
    }

    stack mut MirValueId rejectedWeakStore = new();
    stack MirBuilderStatus weakStoreStatus = LowerHighLevelIrGlobalStore(
        HighLevelIrGlobalStoreOf(SymbolIdOf(521), MirType.Ptr, weakValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedWeakStore);

    stack mut MirValueId rejectedAbiMismatchStore = new();
    stack MirBuilderStatus abiMismatchStoreStatus = LowerHighLevelIrGlobalStore(
        HighLevelIrGlobalStoreOf(SymbolIdOf(521), MirType.Ptr, abiMismatchValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedAbiMismatchStore);

    stack mut MirValueId rejectedMissingNoAliasStore = new();
    stack MirBuilderStatus missingNoAliasStoreStatus = LowerHighLevelIrGlobalStore(
        HighLevelIrGlobalStoreOf(SymbolIdOf(521), MirType.Ptr, missingNoAliasValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedMissingNoAliasStore);

    stack mut MirValueId rejectedMissingVolatileStore = new();
    stack MirBuilderStatus missingVolatileStoreStatus = LowerHighLevelIrGlobalStore(
        HighLevelIrGlobalStoreOf(SymbolIdOf(521), MirType.Ptr, missingVolatileValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedMissingVolatileStore);

    stack mut MirValueId rejectedNullStore = new();
    stack MirBuilderStatus nullStoreStatus = LowerHighLevelIrGlobalStore(
        HighLevelIrGlobalStoreOf(SymbolIdOf(521), MirType.Ptr, nullValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedNullStore);

    stack ValueFacts strongValueFacts = ValueFactsForMirValue(valueFacts, strongValue);
    return instructions.Count() == 7
        && valueFacts.Count() == 7
        && MirFunctionBuilderInstructionCount(builder) == 7
        && MirOpcodeOf(instructions, strongStoreValue) == MirOp.StoreGlobal
        && MirStoredGlobalOf(instructions, strongStoreValue) == 6
        && MirOperandAOf(instructions, strongStoreValue).Equals(strongValue)
        && strongValueFacts.HasAlignment()
        && strongValueFacts.AlignmentBytes() == 16
        && strongValueFacts.HasCallingAbi()
        && strongValueFacts.CallingAbi() == AbiKind.CAbi
        && strongValueFacts.HasNoAlias()
        && strongValueFacts.Volatile()
        && ValueFactsKnownNonNull(strongValueFacts)
        && MirBuilderStatusErrIs(weakStoreStatus, MirBuilderError.InvalidBuilderState)
        && MirBuilderStatusErrIs(abiMismatchStoreStatus, MirBuilderError.InvalidBuilderState)
        && MirBuilderStatusErrIs(missingNoAliasStoreStatus, MirBuilderError.InvalidBuilderState)
        && MirBuilderStatusErrIs(missingVolatileStoreStatus, MirBuilderError.InvalidBuilderState)
        && MirBuilderStatusErrIs(nullStoreStatus, MirBuilderError.InvalidBuilderState)
        && !rejectedWeakStore.IsValid()
        && !rejectedAbiMismatchStore.IsValid()
        && !rejectedMissingNoAliasStore.IsValid()
        && !rejectedMissingVolatileStore.IsValid()
        && !rejectedNullStore.IsValid();
}

[Fact]
fn bool MirLoweringLowersModuleGlobalDeclarationsAndInitializersWithFacts()
{
    stack mut HighLevelIrModule hirModule = HighLevelIrModuleOf(500);
    stack mut ValueFacts counterFacts = new();
    counterFacts.SetIntegerRange(7, 8);
    stack mut ValueFacts pointerFacts = new();
    pointerFacts.MarkKnownNull();

    stack HighLevelIrGlobalDeclaration counter =
        HighLevelIrGlobalDeclarationOf(SymbolIdOf(501), MirType.I32, 7, counterFacts);
    stack HighLevelIrGlobalDeclaration pointer =
        HighLevelIrGlobalDeclarationOf(SymbolIdOf(502), MirType.Ptr, 0, pointerFacts);
    if (!MemoryStatusOk(AppendHighLevelIrGlobalDeclaration(hirModule, counter)))
    {
        return System.Testing.Fail("append-counter");
    }

    if (!MemoryStatusOk(AppendHighLevelIrGlobalDeclaration(hirModule, pointer)))
    {
        return System.Testing.Fail("append-pointer");
    }

    stack mut MirLoweringSymbolMap symbols = new();
    stack mut IrTable<MirGlobal> globals = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrModuleGlobals(hirModule, symbols, globals, globalFacts)))
    {
        return System.Testing.Fail("lower-globals");
    }

    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(503), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrGlobalReference load =
        HighLevelIrGlobalReferenceOf(SymbolIdOf(504), SymbolIdOf(501), MirType.I32);
    stack mut MirValueId loadedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrGlobalReference(load, builder, symbols, instructions, valueFacts, loadedValue)))
    {
        return System.Testing.Fail("load");
    }

    stack HighLevelIrGlobalDeclaration missing = hirModule.GlobalAt(2);
    stack mut u32[0 max] foundCounter = 0;
    stack mut u32[0 max] foundPointer = 0;
    stack mut MirType counterType = MirType.I64;
    stack mut MirType pointerType = MirType.I64;
    return hirModule.GlobalCount() == 2
        && HighLevelIrGlobalDeclarationSymbol(counter).Equals(SymbolIdOf(501))
        && HighLevelIrGlobalDeclarationType(counter) == MirType.I32
        && HighLevelIrGlobalDeclarationInitialValue(counter) == 7
        && ValueFactsIntegerRangeIs(HighLevelIrGlobalDeclarationFacts(counter), 7, 8)
        && HighLevelIrGlobalDeclarationSymbol(pointer).Equals(SymbolIdOf(502))
        && HighLevelIrGlobalDeclarationType(pointer) == MirType.Ptr
        && HighLevelIrGlobalDeclarationInitialValue(pointer) == 0
        && ValueFactsKnownNull(HighLevelIrGlobalDeclarationFacts(pointer))
        && !HighLevelIrGlobalDeclarationSymbol(missing).IsValid()
        && globals.Count() == 2
        && globalFacts.Count() == 2
        && MirGlobalType(globals, 1) == MirType.I32
        && MirGlobalInitialValue(globals, 1) == 7
        && MirGlobalType(globals, 2) == MirType.Ptr
        && MirGlobalInitialValue(globals, 2) == 0
        && ValueFactsIntegerRangeIs(ValueFactsAtIndex(globalFacts, 1), 7, 8)
        && ValueFactsKnownNull(ValueFactsAtIndex(globalFacts, 2))
        && TryFindMirLoweringTypedGlobalSymbol(symbols, SymbolIdOf(501), foundCounter, counterType)
        && TryFindMirLoweringTypedGlobalSymbol(symbols, SymbolIdOf(502), foundPointer, pointerType)
        && foundCounter == 1
        && foundPointer == 2
        && counterType == MirType.I32
        && pointerType == MirType.Ptr
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(501)), 7, 8)
        && ValueFactsKnownNull(symbols.FactsAt(SymbolIdOf(502)))
        && MirOpcodeOf(instructions, loadedValue) == MirOp.LoadGlobal
        && MirValueType(instructions, loadedValue.Index()) == MirType.I32
        && MirLoadedGlobalOf(instructions, loadedValue) == 1
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, loadedValue), 7, 8);
}

