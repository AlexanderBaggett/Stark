[Fact]
fn bool MirLoweringRejectsInvalidGlobalAccessWithoutEmission()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(490), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack mut ValueFacts globalFacts = new();
    globalFacts.SetIntegerRange(0, 10);
    if (!MirBuilderStatusOk(BindMirLoweringGlobalSymbol(symbols, SymbolIdOf(491), 3, globalFacts)))
    {
        return System.Testing.Fail("bind-global");
    }

    stack HighLevelIrLiteral localLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(492), MirType.I64, 5);
    stack HighLevelIrLiteral wideLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(493), MirType.I64, 12);
    stack HighLevelIrLiteral narrowLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(494), MirType.I32, 5);
    stack mut MirValueId localValue = new();
    stack mut MirValueId wideValue = new();
    stack mut MirValueId narrowValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(localLiteral, builder, symbols, instructions, valueFacts, localValue)))
    {
        return System.Testing.Fail("lower-local");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(wideLiteral, builder, symbols, instructions, valueFacts, wideValue)))
    {
        return System.Testing.Fail("lower-wide");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(narrowLiteral, builder, symbols, instructions, valueFacts, narrowValue)))
    {
        return System.Testing.Fail("lower-narrow");
    }

    stack HighLevelIrLocalAlias local = HighLevelIrLocalAliasOf(SymbolIdOf(495), MirType.I64, localValue);
    if (!MirBuilderStatusOk(LowerHighLevelIrLocalAlias(local, builder, symbols, instructions, valueFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    stack mut MirValueId rejectedMissingLoad = new();
    stack MirBuilderStatus missingLoadStatus = LowerHighLevelIrGlobalReference(
        HighLevelIrGlobalReferenceOf(SymbolIdOf(496), SymbolIdOf(497), MirType.I64),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedMissingLoad);

    stack mut MirValueId rejectedLocalLoad = new();
    stack MirBuilderStatus localLoadStatus = LowerHighLevelIrGlobalReference(
        HighLevelIrGlobalReferenceOf(SymbolIdOf(498), SymbolIdOf(495), MirType.I64),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedLocalLoad);

    stack mut MirValueId rejectedTypedLoad = new();
    stack MirBuilderStatus typedLoadStatus = LowerHighLevelIrGlobalReference(
        HighLevelIrGlobalReferenceOf(SymbolIdOf(499), SymbolIdOf(491), MirType.I32),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedTypedLoad);

    stack mut MirValueId rejectedRangeStore = new();
    stack MirBuilderStatus rangeStoreStatus = LowerHighLevelIrGlobalStore(
        HighLevelIrGlobalStoreOf(SymbolIdOf(491), MirType.I64, wideValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedRangeStore);

    stack mut MirValueId rejectedTypeStore = new();
    stack MirBuilderStatus typeStoreStatus = LowerHighLevelIrGlobalStore(
        HighLevelIrGlobalStoreOf(SymbolIdOf(491), MirType.I64, narrowValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedTypeStore);

    return MirBuilderStatusErrIs(missingLoadStatus, MirBuilderError.InvalidSymbol)
        && MirBuilderStatusErrIs(localLoadStatus, MirBuilderError.InvalidSymbol)
        && MirBuilderStatusErrIs(typedLoadStatus, MirBuilderError.TypeMismatch)
        && MirBuilderStatusErrIs(rangeStoreStatus, MirBuilderError.InvalidBuilderState)
        && MirBuilderStatusErrIs(typeStoreStatus, MirBuilderError.TypeMismatch)
        && !rejectedMissingLoad.IsValid()
        && !rejectedLocalLoad.IsValid()
        && !rejectedTypedLoad.IsValid()
        && !rejectedRangeStore.IsValid()
        && !rejectedTypeStore.IsValid()
        && instructions.Count() == 3
        && valueFacts.Count() == 3
        && MirFunctionBuilderInstructionCount(builder) == 3
        && symbols.KindAt(SymbolIdOf(491)) == MirLoweringSymbolKind.Global
        && symbols.KindAt(SymbolIdOf(496)) == MirLoweringSymbolKind.Unknown
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(491)), 0, 10);
}

[Fact]
fn bool MirLoweringLowersLocalAssignmentByRebindingSymbolAndFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(401), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral firstLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(402), MirType.I32, 10);
    stack mut MirValueId firstValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(firstLiteral, builder, symbols, instructions, valueFacts, firstValue)))
    {
        return System.Testing.Fail("lower-first");
    }

    stack HighLevelIrLocalAlias local = HighLevelIrLocalAliasOf(SymbolIdOf(403), MirType.I32, firstValue);
    if (!MirBuilderStatusOk(LowerHighLevelIrLocalAlias(local, builder, symbols, instructions, valueFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    stack HighLevelIrLiteral secondLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(404), MirType.I32, 25);
    stack mut MirValueId secondValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(secondLiteral, builder, symbols, instructions, valueFacts, secondValue)))
    {
        return System.Testing.Fail("lower-second");
    }

    stack HighLevelIrAssignment assignment = HighLevelIrAssignmentOf(SymbolIdOf(403), MirType.I32, secondValue);
    stack mut MirValueId assignedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrAssignment(assignment, builder, symbols, instructions, valueFacts, assignedValue)))
    {
        return System.Testing.Fail("assign");
    }

    stack mut MirValueId found = new();
    stack ValueFacts localFacts = symbols.FactsAt(SymbolIdOf(403));
    return instructions.Count() == 2
        && valueFacts.Count() == 2
        && MirFunctionBuilderInstructionCount(builder) == 2
        && HighLevelIrAssignmentTargetSymbol(assignment).Equals(SymbolIdOf(403))
        && HighLevelIrAssignmentType(assignment) == MirType.I32
        && HighLevelIrAssignmentValue(assignment).Equals(secondValue)
        && assignedValue.Equals(secondValue)
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(403), found)
        && found.Equals(secondValue)
        && ValueFactsIntegerRangeIs(localFacts, 25, 26)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, firstValue), 10, 11)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, secondValue), 25, 26);
}

[Fact]
fn bool MirLoweringUsesLocalAssignmentResultInEnclosingValueContext()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> functions = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(410), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral firstLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(411), MirType.I32, 3);
    stack mut MirValueId firstValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(firstLiteral, builder, symbols, instructions, valueFacts, firstValue)))
    {
        return System.Testing.Fail("lower-first");
    }

    stack HighLevelIrLocalAlias local = HighLevelIrLocalAliasOf(SymbolIdOf(412), MirType.I32, firstValue);
    if (!MirBuilderStatusOk(LowerHighLevelIrLocalAlias(local, builder, symbols, instructions, valueFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    stack HighLevelIrLiteral secondLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(413), MirType.I32, 4);
    stack mut MirValueId secondValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(secondLiteral, builder, symbols, instructions, valueFacts, secondValue)))
    {
        return System.Testing.Fail("lower-second");
    }

    stack HighLevelIrAssignment assignment = HighLevelIrAssignmentOf(SymbolIdOf(412), MirType.I32, secondValue);
    stack mut MirValueId assignedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrAssignment(assignment, builder, symbols, instructions, valueFacts, assignedValue)))
    {
        return System.Testing.Fail("assign");
    }

    stack HighLevelIrLiteral extraLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(414), MirType.I32, 5);
    stack mut MirValueId extraValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(extraLiteral, builder, symbols, instructions, valueFacts, extraValue)))
    {
        return System.Testing.Fail("lower-extra");
    }

    stack HighLevelIrBinaryOp addOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(415), HighLevelIrBinaryOpKind.Add, MirType.I32, assignedValue, extraValue);
    stack mut MirValueId sum = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(addOp, builder, symbols, instructions, valueFacts, sum)))
    {
        return System.Testing.Fail("lower-add");
    }

    stack HighLevelIrReturn ret = HighLevelIrReturnOf(MirType.I32, sum);
    stack mut MirBlockId returnBlock = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrReturn(ret, builder, blocks, instructions, valueFacts, returnBlock)))
    {
        return System.Testing.Fail("lower-return");
    }

    stack mut MirFuncId function = new();
    if (!MirBuilderStatusOk(FinishMirFunctionBuilder(builder, functions, function)))
    {
        return System.Testing.Fail("finish");
    }

    stack mut MirValueId foundLocal = new();
    return assignedValue.Equals(secondValue)
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(412), foundLocal)
        && foundLocal.Equals(secondValue)
        && instructions.Count() == 4
        && valueFacts.Count() == 4
        && blocks.Count() == 1
        && MirFunctionBuilderInstructionCount(builder) == 4
        && MirFunctionBuilderBlockCount(builder) == 1
        && MirOpcodeOf(instructions, sum) == MirOp.Add
        && MirValueType(instructions, sum.Index()) == MirType.I32
        && MirBlockTerminator(blocks, returnBlock) == MirTermKind.Return
        && MirBlockReturnValue(blocks, returnBlock).Equals(sum)
        && function.Index() == 1
        && MirFunctionEntry(functions, function).Equals(returnBlock)
        && MirFunctionBlockCount(functions, function) == 1
        && MirFunctionInstrCount(functions, function) == 4
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(412)), 4, 5)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(415)), 9, 10)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, sum), 9, 10);
}

[Fact]
fn bool MirLoweringRejectsInvalidLocalAssignmentWithoutRebinding()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(405), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrParameter parameter =
        HighLevelIrParameterOf(SymbolIdOf(406), 0, MirType.I32, new ValueFacts());
    stack mut MirValueId parameterValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrParameter(parameter, builder, symbols, instructions, valueFacts, parameterValue)))
    {
        return System.Testing.Fail("lower-parameter");
    }

    stack HighLevelIrLiteral localLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(407), MirType.I32, 5);
    stack mut MirValueId localValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(localLiteral, builder, symbols, instructions, valueFacts, localValue)))
    {
        return System.Testing.Fail("lower-local-value");
    }

    stack HighLevelIrLocalAlias local = HighLevelIrLocalAliasOf(SymbolIdOf(408), MirType.I32, localValue);
    if (!MirBuilderStatusOk(LowerHighLevelIrLocalAlias(local, builder, symbols, instructions, valueFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    stack HighLevelIrLiteral wideLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(409), MirType.I64, 9);
    stack mut MirValueId wideValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(wideLiteral, builder, symbols, instructions, valueFacts, wideValue)))
    {
        return System.Testing.Fail("lower-wide");
    }

    stack mut MirValueId rejectedParamAssignment = new();
    stack MirBuilderStatus parameterStatus = LowerHighLevelIrAssignment(
        HighLevelIrAssignmentOf(SymbolIdOf(406), MirType.I32, localValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedParamAssignment);

    stack mut MirValueId rejectedTypeAssignment = new();
    stack MirBuilderStatus typeStatus = LowerHighLevelIrAssignment(
        HighLevelIrAssignmentOf(SymbolIdOf(408), MirType.I32, wideValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedTypeAssignment);

    stack mut MirValueId foundLocal = new();
    return MirBuilderStatusErrIs(parameterStatus, MirBuilderError.InvalidSymbol)
        && MirBuilderStatusErrIs(typeStatus, MirBuilderError.TypeMismatch)
        && !rejectedParamAssignment.IsValid()
        && !rejectedTypeAssignment.IsValid()
        && instructions.Count() == 3
        && valueFacts.Count() == 3
        && MirFunctionBuilderInstructionCount(builder) == 3
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(408), foundLocal)
        && foundLocal.Equals(localValue)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(408)), 5, 6)
        && symbols.KindAt(SymbolIdOf(406)) == MirLoweringSymbolKind.Parameter;
}

[Fact]
fn bool MirLoweringRejectsAssignmentFactsOutsideTypeWithoutRebinding()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(416), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral localLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(417), MirType.I32, 5);
    stack mut MirValueId localValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(localLiteral, builder, symbols, instructions, valueFacts, localValue)))
    {
        return System.Testing.Fail("lower-local");
    }

    stack HighLevelIrLocalAlias local = HighLevelIrLocalAliasOf(SymbolIdOf(418), MirType.I32, localValue);
    if (!MirBuilderStatusOk(LowerHighLevelIrLocalAlias(local, builder, symbols, instructions, valueFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    stack MirValueId badValue = MirConstIntTyped(instructions, MirType.I32, 6);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, badValue)))
    {
        return System.Testing.Fail("record-bad");
    }

    stack mut ValueFacts badFacts = new();
    badFacts.MarkKnownNonNull();
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, badValue, badFacts))
    {
        return System.Testing.Fail("facts-bad");
    }

    stack mut MirValueId rejectedAssignment = new();
    stack MirBuilderStatus status = LowerHighLevelIrAssignment(
        HighLevelIrAssignmentOf(SymbolIdOf(418), MirType.I32, badValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedAssignment);

    stack mut MirValueId foundLocal = new();
    return MirBuilderStatusErrIs(status, MirBuilderError.TypeMismatch)
        && !rejectedAssignment.IsValid()
        && instructions.Count() == 2
        && valueFacts.Count() == 2
        && MirFunctionBuilderInstructionCount(builder) == 2
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(418), foundLocal)
        && foundLocal.Equals(localValue)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(418)), 5, 6);
}

[Fact]
fn bool MirLoweringLowersCompoundAssignmentsWithCheckedWrappingAndSaturatingFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(450), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack i64[min max] i32Min = (i64[min max])(-(2 ** 31));
    stack i64[min max] i32Max = 2147483647;
    stack i64[min max] i32MaxUpper = (i64[min max])(2 ** 31);

    stack HighLevelIrLiteral initialLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(451), MirType.I32, 10);
    stack mut MirValueId initialValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(initialLiteral, builder, symbols, instructions, valueFacts, initialValue)))
    {
        return System.Testing.Fail("lower-initial");
    }

    stack HighLevelIrLocalAlias local = HighLevelIrLocalAliasOf(SymbolIdOf(452), MirType.I32, initialValue);
    if (!MirBuilderStatusOk(LowerHighLevelIrLocalAlias(local, builder, symbols, instructions, valueFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    stack HighLevelIrLiteral fiveLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(453), MirType.I32, 5);
    stack mut MirValueId fiveValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(fiveLiteral, builder, symbols, instructions, valueFacts, fiveValue)))
    {
        return System.Testing.Fail("lower-five");
    }

    stack HighLevelIrCompoundAssignment checked =
        HighLevelIrCompoundAssignmentOf(SymbolIdOf(452), HighLevelIrBinaryOpKind.Add, MirType.I32, fiveValue);
    stack mut MirValueId checkedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCompoundAssignment(checked, builder, symbols, instructions, valueFacts, checkedValue)))
    {
        return System.Testing.Fail("compound-add");
    }

    stack HighLevelIrLiteral maxLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(454), MirType.I32, i32Max);
    stack HighLevelIrLiteral oneLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(455), MirType.I32, 1);
    stack mut MirValueId maxValue = new();
    stack mut MirValueId oneValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(maxLiteral, builder, symbols, instructions, valueFacts, maxValue)))
    {
        return System.Testing.Fail("lower-max");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(oneLiteral, builder, symbols, instructions, valueFacts, oneValue)))
    {
        return System.Testing.Fail("lower-one");
    }

    stack mut MirValueId assignedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrAssignment(
        HighLevelIrAssignmentOf(SymbolIdOf(452), MirType.I32, maxValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        assignedValue)))
    {
        return System.Testing.Fail("assign-max");
    }

    stack HighLevelIrCompoundAssignment wrapping =
        HighLevelIrCompoundAssignmentOf(SymbolIdOf(452), HighLevelIrBinaryOpKind.WrappingAdd, MirType.I32, oneValue);
    stack mut MirValueId wrappedValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCompoundAssignment(wrapping, builder, symbols, instructions, valueFacts, wrappedValue)))
    {
        return System.Testing.Fail("compound-wrap");
    }

    stack HighLevelIrLiteral minLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(456), MirType.I32, i32Min);
    stack mut MirValueId minValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(minLiteral, builder, symbols, instructions, valueFacts, minValue)))
    {
        return System.Testing.Fail("lower-min");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrAssignment(
        HighLevelIrAssignmentOf(SymbolIdOf(452), MirType.I32, minValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        assignedValue)))
    {
        return System.Testing.Fail("assign-min");
    }

    stack HighLevelIrCompoundAssignment saturatingSub =
        HighLevelIrCompoundAssignmentOf(SymbolIdOf(452), HighLevelIrBinaryOpKind.SaturatingSub, MirType.I32, oneValue);
    stack mut MirValueId satSubValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCompoundAssignment(saturatingSub, builder, symbols, instructions, valueFacts, satSubValue)))
    {
        return System.Testing.Fail("compound-sat-sub");
    }

    stack HighLevelIrLiteral bigLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(457), MirType.I32, 1073741824);
    stack HighLevelIrLiteral fourLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(458), MirType.I32, 4);
    stack mut MirValueId bigValue = new();
    stack mut MirValueId fourValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(bigLiteral, builder, symbols, instructions, valueFacts, bigValue)))
    {
        return System.Testing.Fail("lower-big");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(fourLiteral, builder, symbols, instructions, valueFacts, fourValue)))
    {
        return System.Testing.Fail("lower-four");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrAssignment(
        HighLevelIrAssignmentOf(SymbolIdOf(452), MirType.I32, bigValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        assignedValue)))
    {
        return System.Testing.Fail("assign-big");
    }

    stack HighLevelIrCompoundAssignment saturatingMul =
        HighLevelIrCompoundAssignmentOf(SymbolIdOf(452), HighLevelIrBinaryOpKind.SaturatingMul, MirType.I32, fourValue);
    stack mut MirValueId satMulValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrCompoundAssignment(saturatingMul, builder, symbols, instructions, valueFacts, satMulValue)))
    {
        return System.Testing.Fail("compound-sat-mul");
    }

    stack mut MirValueId foundLocal = new();
    return instructions.Count() == 11
        && valueFacts.Count() == 11
        && MirFunctionBuilderInstructionCount(builder) == 11
        && HighLevelIrCompoundAssignmentTargetSymbol(checked).Equals(SymbolIdOf(452))
        && HighLevelIrCompoundAssignmentKind(checked) == HighLevelIrBinaryOpKind.Add
        && HighLevelIrCompoundAssignmentType(checked) == MirType.I32
        && HighLevelIrCompoundAssignmentRight(checked).Equals(fiveValue)
        && MirOpcodeOf(instructions, checkedValue) == MirOp.Add
        && MirOpcodeOf(instructions, wrappedValue) == MirOp.WrappingAdd
        && MirOpcodeOf(instructions, satSubValue) == MirOp.SaturatingSub
        && MirOpcodeOf(instructions, satMulValue) == MirOp.SaturatingMul
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(452), foundLocal)
        && foundLocal.Equals(satMulValue)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, checkedValue), 15, 16)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, wrappedValue), i32Min, i32Min + 1)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, satSubValue), i32Min, i32Min + 1)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, satMulValue), i32Max, i32MaxUpper)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(452)), i32Max, i32MaxUpper);
}

[Fact]
fn bool MirLoweringRejectsInvalidCompoundAssignmentWithoutRebinding()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(470), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrParameter parameter =
        HighLevelIrParameterOf(SymbolIdOf(471), 0, MirType.I32, new ValueFacts());
    stack mut MirValueId parameterValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrParameter(parameter, builder, symbols, instructions, valueFacts, parameterValue)))
    {
        return System.Testing.Fail("lower-parameter");
    }

    stack HighLevelIrLiteral localLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(472), MirType.I32, 12);
    stack mut MirValueId localValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(localLiteral, builder, symbols, instructions, valueFacts, localValue)))
    {
        return System.Testing.Fail("lower-local");
    }

    stack HighLevelIrLocalAlias local = HighLevelIrLocalAliasOf(SymbolIdOf(473), MirType.I32, localValue);
    if (!MirBuilderStatusOk(LowerHighLevelIrLocalAlias(local, builder, symbols, instructions, valueFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    stack HighLevelIrLiteral wideLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(474), MirType.I64, 2);
    stack HighLevelIrLiteral zeroLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(475), MirType.I32, 0);
    stack mut MirValueId wideValue = new();
    stack mut MirValueId zeroValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(wideLiteral, builder, symbols, instructions, valueFacts, wideValue)))
    {
        return System.Testing.Fail("lower-wide");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(zeroLiteral, builder, symbols, instructions, valueFacts, zeroValue)))
    {
        return System.Testing.Fail("lower-zero");
    }

    stack mut MirValueId rejectedParameter = new();
    stack MirBuilderStatus parameterStatus = LowerHighLevelIrCompoundAssignment(
        HighLevelIrCompoundAssignmentOf(SymbolIdOf(471), HighLevelIrBinaryOpKind.Add, MirType.I32, zeroValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedParameter);

    stack mut MirValueId rejectedType = new();
    stack MirBuilderStatus typeStatus = LowerHighLevelIrCompoundAssignment(
        HighLevelIrCompoundAssignmentOf(SymbolIdOf(473), HighLevelIrBinaryOpKind.Add, MirType.I32, wideValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedType);

    stack mut MirValueId rejectedZero = new();
    stack MirBuilderStatus zeroStatus = LowerHighLevelIrCompoundAssignment(
        HighLevelIrCompoundAssignmentOf(SymbolIdOf(473), HighLevelIrBinaryOpKind.SDiv, MirType.I32, zeroValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedZero);

    stack mut MirValueId foundLocal = new();
    return MirBuilderStatusErrIs(parameterStatus, MirBuilderError.InvalidSymbol)
        && MirBuilderStatusErrIs(typeStatus, MirBuilderError.TypeMismatch)
        && MirBuilderStatusErrIs(zeroStatus, MirBuilderError.InvalidBuilderState)
        && !rejectedParameter.IsValid()
        && !rejectedType.IsValid()
        && !rejectedZero.IsValid()
        && instructions.Count() == 4
        && valueFacts.Count() == 4
        && MirFunctionBuilderInstructionCount(builder) == 4
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(473), foundLocal)
        && foundLocal.Equals(localValue)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(473)), 12, 13)
        && symbols.KindAt(SymbolIdOf(471)) == MirLoweringSymbolKind.Parameter;
}

[Fact]
fn bool MirLoweringRejectsCompoundAssignmentOperandFactsOutsideTypeWithoutRebinding()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(480), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral initialLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(481), MirType.I32, 12);
    stack mut MirValueId localValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(initialLiteral, builder, symbols, instructions, valueFacts, localValue)))
    {
        return System.Testing.Fail("lower-local");
    }

    stack HighLevelIrLocalAlias local = HighLevelIrLocalAliasOf(SymbolIdOf(482), MirType.I32, localValue);
    if (!MirBuilderStatusOk(LowerHighLevelIrLocalAlias(local, builder, symbols, instructions, valueFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    stack MirValueId badRightValue = MirConstIntTyped(instructions, MirType.I32, 1);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, badRightValue)))
    {
        return System.Testing.Fail("record-bad-right");
    }

    stack mut ValueFacts badRightFacts = new();
    badRightFacts.MarkKnownNull();
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, badRightValue, badRightFacts))
    {
        return System.Testing.Fail("facts-bad-right");
    }

    stack mut MirValueId rejectedRight = new();
    stack MirBuilderStatus rightStatus = LowerHighLevelIrCompoundAssignment(
        HighLevelIrCompoundAssignmentOf(SymbolIdOf(482), HighLevelIrBinaryOpKind.Add, MirType.I32, badRightValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedRight);

    stack mut MirValueId afterRight = new();
    stack bool rightKeptLocal =
        TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(482), afterRight)
        && afterRight.Equals(localValue);

    stack MirValueId badLeftValue = MirConstIntTyped(instructions, MirType.I32, 4);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, badLeftValue)))
    {
        return System.Testing.Fail("record-bad-left");
    }

    stack mut ValueFacts badLeftFacts = new();
    badLeftFacts.SetIntegerRange(2147483648, 2147483649);
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, badLeftValue, badLeftFacts))
    {
        return System.Testing.Fail("facts-bad-left");
    }

    if (!MirBuilderStatusOk(RebindMirLoweringLocalValueSymbol(symbols, SymbolIdOf(482), badLeftValue, badLeftFacts)))
    {
        return System.Testing.Fail("rebind-bad-left");
    }

    stack HighLevelIrLiteral validRightLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(483), MirType.I32, 2);
    stack mut MirValueId validRightValue = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(validRightLiteral, builder, symbols, instructions, valueFacts, validRightValue)))
    {
        return System.Testing.Fail("lower-valid-right");
    }

    stack mut MirValueId rejectedLeft = new();
    stack MirBuilderStatus leftStatus = LowerHighLevelIrCompoundAssignment(
        HighLevelIrCompoundAssignmentOf(SymbolIdOf(482), HighLevelIrBinaryOpKind.Add, MirType.I32, validRightValue),
        builder,
        symbols,
        instructions,
        valueFacts,
        rejectedLeft);

    stack mut MirValueId foundLocal = new();
    return MirBuilderStatusErrIs(rightStatus, MirBuilderError.TypeMismatch)
        && MirBuilderStatusErrIs(leftStatus, MirBuilderError.TypeMismatch)
        && !rejectedRight.IsValid()
        && !rejectedLeft.IsValid()
        && rightKeptLocal
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(482), foundLocal)
        && foundLocal.Equals(badLeftValue)
        && instructions.Count() == 4
        && valueFacts.Count() == 4
        && MirFunctionBuilderInstructionCount(builder) == 4;
}

[Fact]
fn bool MirLoweringLowersTypedIntegerArithmeticAndComparisonWithFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(39), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral leftLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(20), MirType.I32, 4);
    stack HighLevelIrLiteral rightLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(21), MirType.I32, 6);
    stack mut MirValueId left = new();
    stack mut MirValueId right = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(leftLiteral, builder, symbols, instructions, valueFacts, left)))
    {
        return System.Testing.Fail("lower-left");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(rightLiteral, builder, symbols, instructions, valueFacts, right)))
    {
        return System.Testing.Fail("lower-right");
    }

    stack HighLevelIrBinaryOp addOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(22), HighLevelIrBinaryOpKind.Add, MirType.I32, left, right);
    stack HighLevelIrBinaryOp subOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(23), HighLevelIrBinaryOpKind.Sub, MirType.I32, left, right);
    stack HighLevelIrBinaryOp mulOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(24), HighLevelIrBinaryOpKind.Mul, MirType.I32, left, right);
    stack HighLevelIrBinaryOp cmpOp =
        HighLevelIrBinaryOpOf(SymbolIdOf(25), HighLevelIrBinaryOpKind.CmpLt, MirType.I1, left, right);
    stack mut MirValueId sum = new();
    stack mut MirValueId diff = new();
    stack mut MirValueId product = new();
    stack mut MirValueId cmp = new();

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(addOp, builder, symbols, instructions, valueFacts, sum)))
    {
        return System.Testing.Fail("lower-add");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(subOp, builder, symbols, instructions, valueFacts, diff)))
    {
        return System.Testing.Fail("lower-sub");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(mulOp, builder, symbols, instructions, valueFacts, product)))
    {
        return System.Testing.Fail("lower-mul");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrBinaryOp(cmpOp, builder, symbols, instructions, valueFacts, cmp)))
    {
        return System.Testing.Fail("lower-cmp");
    }

    return instructions.Count() == 6
        && valueFacts.Count() == 6
        && MirFunctionBuilderInstructionCount(builder) == 6
        && HighLevelIrBinaryOpSymbol(addOp).Equals(SymbolIdOf(22))
        && HighLevelIrBinaryOpKindAt(addOp) == HighLevelIrBinaryOpKind.Add
        && HighLevelIrBinaryOpType(addOp) == MirType.I32
        && HighLevelIrBinaryOpLeft(addOp).Equals(left)
        && HighLevelIrBinaryOpRight(addOp).Equals(right)
        && MirOpcodeOf(instructions, sum) == MirOp.Add
        && MirOpcodeOf(instructions, diff) == MirOp.Sub
        && MirOpcodeOf(instructions, product) == MirOp.Mul
        && MirOpcodeOf(instructions, cmp) == MirOp.CmpLt
        && MirValueType(instructions, sum.Index()) == MirType.I32
        && MirValueType(instructions, diff.Index()) == MirType.I32
        && MirValueType(instructions, product.Index()) == MirType.I32
        && MirValueType(instructions, cmp.Index()) == MirType.I1
        && symbols.KindAt(SymbolIdOf(22)) == MirLoweringSymbolKind.Temporary
        && symbols.KindAt(SymbolIdOf(25)) == MirLoweringSymbolKind.Temporary
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, sum), 10, 11)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, diff), -2, -1)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, product), 24, 25)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, cmp), 0, 2)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(22)), 10, 11)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(25)), 0, 2)
        && System.Text.Equals(HighLevelIrBinaryOpKindName(HighLevelIrBinaryOpKind.CmpLt), "cmp-lt");
}

[Fact]
fn bool MirLoweringLowersTypedIntegerExtendedOpsWithFacts()
{
