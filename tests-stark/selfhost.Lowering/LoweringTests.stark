[Fact]
fn bool MirLoweringRejectsCallArgumentFactsOutsideTypeWithoutEmission()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(460), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack MirValueId scalarArgument = MirConstIntTyped(instructions, MirType.I32, 8);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, scalarArgument)))
    {
        return System.Testing.Fail("record-scalar");
    }

    stack mut ValueFacts scalarArgumentFacts = new();
    scalarArgumentFacts.MarkKnownNull();
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, scalarArgument, scalarArgumentFacts))
    {
        return System.Testing.Fail("facts-scalar");
    }

    stack mut ValueFacts scalarResultFacts = new();
    scalarResultFacts.SetIntegerRange(0, 1);
    stack mut MirValueId scalarResult = new();
    stack MirBuilderStatus scalarStatus =
        LowerHighLevelIrCall(
            HighLevelIrCallOf(
                SymbolIdOf(461),
                MirFuncIdOf(21),
                MirType.I32,
                1,
                scalarArgument,
                MirValueIdOf(0),
                MirValueIdOf(0),
                MirValueIdOf(0),
                scalarResultFacts),
            builder,
            symbols,
            instructions,
            valueFacts,
            scalarResult);

    stack MirValueId pointerArgument = MirConstNullPtr(instructions);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, pointerArgument)))
    {
        return System.Testing.Fail("record-pointer");
    }

    stack mut ValueFacts pointerArgumentFacts = new();
    pointerArgumentFacts.SetIntegerRange(0, 1);
    if (!RecordGeneratedValueFactsForMirValue(valueFacts, pointerArgument, pointerArgumentFacts))
    {
        return System.Testing.Fail("facts-pointer");
    }

    stack mut ValueFacts pointerResultFacts = new();
    stack mut MirValueId pointerResult = new();
    stack MirBuilderStatus pointerStatus =
        LowerHighLevelIrCall(
            HighLevelIrCallOf(
                SymbolIdOf(462),
                MirFuncIdOf(22),
                MirType.Ptr,
                1,
                pointerArgument,
                MirValueIdOf(0),
                MirValueIdOf(0),
                MirValueIdOf(0),
                pointerResultFacts),
            builder,
            symbols,
            instructions,
            valueFacts,
            pointerResult);

    return MirBuilderStatusErrIs(scalarStatus, MirBuilderError.TypeMismatch)
        && MirBuilderStatusErrIs(pointerStatus, MirBuilderError.TypeMismatch)
        && !scalarResult.IsValid()
        && !pointerResult.IsValid()
        && instructions.Count() == 2
        && valueFacts.Count() == 2
        && MirFunctionBuilderInstructionCount(builder) == 2
        && symbols.KindAt(SymbolIdOf(461)) == MirLoweringSymbolKind.Unknown
        && symbols.KindAt(SymbolIdOf(462)) == MirLoweringSymbolKind.Unknown;
}

[Fact]
fn bool MirLoweringLowersBecomeToTailCallBlockWithFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> functions = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(64), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral argumentLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(65), MirType.I64, 13);
    stack mut MirValueId argument = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(argumentLiteral, builder, symbols, instructions, valueFacts, argument)))
    {
        return System.Testing.Fail("lower-argument");
    }

    stack mut ValueFacts resultFacts = new();
    resultFacts.SetIntegerRange(0, 100);
    stack HighLevelIrBecome tail =
        HighLevelIrBecomeOf(MirFuncIdOf(12), MirType.I64, 1, argument, MirValueIdOf(0), MirValueIdOf(0), MirValueIdOf(0), resultFacts);
    stack mut MirValueId tailCall = new();
    stack mut MirBlockId tailBlock = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrBecome(tail, builder, instructions, valueFacts, blocks, tailCall, tailBlock)))
    {
        return System.Testing.Fail("lower-become");
    }

    stack mut MirFuncId function = new();
    if (!MirBuilderStatusOk(FinishMirFunctionBuilder(builder, functions, function)))
    {
        return System.Testing.Fail("finish");
    }

    stack ValueFacts tailFacts = ValueFactsForMirValue(valueFacts, tailCall);
    return HighLevelIrBecomeCallee(tail).Equals(MirFuncIdOf(12))
        && HighLevelIrBecomeType(tail) == MirType.I64
        && HighLevelIrBecomeArgumentCount(tail) == 1
        && HighLevelIrBecomeArgumentAt(tail, 0).Equals(argument)
        && HighLevelIrBecomeArgumentAt(tail, 1).Equals(MirValueIdOf(0))
        && ValueFactsIntegerRangeIs(HighLevelIrBecomeFacts(tail), 0, 100)
        && instructions.Count() == 2
        && valueFacts.Count() == 2
        && blocks.Count() == 1
        && MirFunctionBuilderInstructionCount(builder) == 2
        && MirFunctionBuilderBlockCount(builder) == 1
        && MirFunctionBuilderOwnsValue(builder, tailCall)
        && MirFunctionBuilderOwnsBlock(builder, tailBlock)
        && MirOpcodeOf(instructions, tailCall) == MirOp.TailCall
        && MirValueType(instructions, tailCall.Index()) == MirType.I64
        && MirCalleeOf(instructions, tailCall).Equals(MirFuncIdOf(12))
        && MirOperandAOf(instructions, tailCall).Equals(argument)
        && MirBlockTerminator(blocks, tailBlock) == MirTermKind.TailCall
        && MirBlockTailCallValue(blocks, tailBlock).Equals(tailCall)
        && function.Index() == 1
        && MirFunctionEntry(functions, function).Equals(tailBlock)
        && MirFunctionInstrCount(functions, function) == 2
        && MirFunctionBlockCount(functions, function) == 1
        && ValueFactsIntegerRangeIs(tailFacts, 0, 100);
}

