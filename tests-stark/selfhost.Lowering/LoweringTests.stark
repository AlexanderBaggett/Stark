[Fact]
fn bool MirLoweringLowersDenseParametersWithFactsAndSymbolBinding()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(35), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack mut ValueFacts firstFacts = new();
    firstFacts.SetIntegerRange(-8, 9);
    stack mut ValueFacts secondFacts = new();
    secondFacts.SetIntegerRange(10, 11);

    stack HighLevelIrParameter first = HighLevelIrParameterOf(SymbolIdOf(12), 0, MirType.I64, firstFacts);
    stack HighLevelIrParameter second = HighLevelIrParameterOf(SymbolIdOf(13), 1, MirType.I64, secondFacts);
    stack mut MirValueId firstValue = new();
    stack mut MirValueId secondValue = new();

    if (!MirBuilderStatusOk(LowerHighLevelIrParameter(first, builder, symbols, instructions, valueFacts, firstValue)))
    {
        return System.Testing.Fail("lower-first");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrParameter(second, builder, symbols, instructions, valueFacts, secondValue)))
    {
        return System.Testing.Fail("lower-second");
    }

    stack mut MirValueId foundFirst = new();
    stack mut MirValueId foundSecond = new();
    stack ValueFacts firstTableFacts = ValueFactsForMirValue(valueFacts, firstValue);
    stack ValueFacts secondSymbolFacts = symbols.FactsAt(SymbolIdOf(13));

    return instructions.Count() == 2
        && valueFacts.Count() == 2
        && MirFunctionBuilderInstructionCount(builder) == 2
        && MirFunctionBuilderOwnsValue(builder, firstValue)
        && MirFunctionBuilderOwnsValue(builder, secondValue)
        && MirOpcodeOf(instructions, firstValue) == MirOp.Param
        && MirOpcodeOf(instructions, secondValue) == MirOp.Param
        && MirParamIndexOf(instructions, firstValue) == 0
        && MirParamIndexOf(instructions, secondValue) == 1
        && symbols.KindAt(SymbolIdOf(12)) == MirLoweringSymbolKind.Parameter
        && symbols.KindAt(SymbolIdOf(13)) == MirLoweringSymbolKind.Parameter
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(12), foundFirst)
        && foundFirst.Equals(firstValue)
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(13), foundSecond)
        && foundSecond.Equals(secondValue)
        && ValueFactsIntegerRangeIs(firstTableFacts, -8, 9)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(12)), -8, 9)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, secondValue), 10, 11)
        && ValueFactsIntegerRangeIs(secondSymbolFacts, 10, 11);
}

[Fact]
fn bool MirLoweringLowersTypedNonI64ParametersWithFacts()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(36), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack mut ValueFacts intFacts = new();
    intFacts.SetIntegerRange(-128, 128);
    stack mut ValueFacts boolFacts = new();
    boolFacts.SetIntegerRange(0, 2);
    stack mut ValueFacts ptrFacts = new();
    ptrFacts.SetAlignment(8);
    ptrFacts.MarkNoAlias();

    stack HighLevelIrParameter intParam =
        HighLevelIrParameterOf(SymbolIdOf(14), 0, MirType.I32, intFacts);
    stack HighLevelIrParameter boolParam =
        HighLevelIrParameterOf(SymbolIdOf(15), 1, MirType.I1, boolFacts);
    stack HighLevelIrParameter ptrParam =
        HighLevelIrParameterOf(SymbolIdOf(16), 2, MirType.Ptr, ptrFacts);
    stack mut MirValueId intValue = new();
    stack mut MirValueId boolValue = new();
    stack mut MirValueId ptrValue = new();

    if (!MirBuilderStatusOk(LowerHighLevelIrParameter(intParam, builder, symbols, instructions, valueFacts, intValue)))
    {
        return System.Testing.Fail("lower-int");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrParameter(boolParam, builder, symbols, instructions, valueFacts, boolValue)))
    {
        return System.Testing.Fail("lower-bool");
    }

    if (!MirBuilderStatusOk(LowerHighLevelIrParameter(ptrParam, builder, symbols, instructions, valueFacts, ptrValue)))
    {
        return System.Testing.Fail("lower-ptr");
    }

    stack ValueFacts intTableFacts = ValueFactsForMirValue(valueFacts, intValue);
    stack ValueFacts boolSymbolFacts = symbols.FactsAt(SymbolIdOf(15));
    stack ValueFacts ptrTableFacts = ValueFactsForMirValue(valueFacts, ptrValue);
    stack ValueFacts ptrSymbolFacts = symbols.FactsAt(SymbolIdOf(16));

    return instructions.Count() == 3
        && valueFacts.Count() == 3
        && MirFunctionBuilderInstructionCount(builder) == 3
        && MirValueType(instructions, intValue.Index()) == MirType.I32
        && MirValueType(instructions, boolValue.Index()) == MirType.I1
        && MirValueType(instructions, ptrValue.Index()) == MirType.Ptr
        && MirParamTypeOf(instructions, 0) == MirType.I32
        && MirParamTypeOf(instructions, 1) == MirType.I1
        && MirParamTypeOf(instructions, 2) == MirType.Ptr
        && MirParamIndexOf(instructions, intValue) == 0
        && MirParamIndexOf(instructions, boolValue) == 1
        && MirParamIndexOf(instructions, ptrValue) == 2
        && symbols.KindAt(SymbolIdOf(14)) == MirLoweringSymbolKind.Parameter
        && symbols.KindAt(SymbolIdOf(15)) == MirLoweringSymbolKind.Parameter
        && symbols.KindAt(SymbolIdOf(16)) == MirLoweringSymbolKind.Parameter
        && ValueFactsIntegerRangeIs(intTableFacts, -128, 128)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(14)), -128, 128)
        && ValueFactsIntegerRangeIs(ValueFactsForMirValue(valueFacts, boolValue), 0, 2)
        && ValueFactsIntegerRangeIs(boolSymbolFacts, 0, 2)
        && ptrTableFacts.HasAlignment()
        && ptrTableFacts.AlignmentBytes() == 8
        && ptrTableFacts.HasNoAlias()
        && ptrSymbolFacts.HasAlignment()
        && ptrSymbolFacts.AlignmentBytes() == 8
        && ptrSymbolFacts.HasNoAlias();
}

[Fact]
fn bool MirLoweringRejectsParameterFactsOutsideTypeWithoutEmission()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(38), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack mut ValueFacts scalarNullabilityFacts = new();
    scalarNullabilityFacts.MarkKnownNull();
    stack HighLevelIrParameter scalarParameter =
        HighLevelIrParameterOf(SymbolIdOf(18), 0, MirType.I32, scalarNullabilityFacts);
    stack mut MirValueId scalarValue = new();
    stack MirBuilderStatus scalarStatus =
        LowerHighLevelIrParameter(scalarParameter, builder, symbols, instructions, valueFacts, scalarValue);

    if (!MirBuilderStatusErrIs(scalarStatus, MirBuilderError.TypeMismatch)
        || scalarValue.IsValid()
        || instructions.Count() != 0
        || valueFacts.Count() != 0
        || MirFunctionBuilderInstructionCount(builder) != 0
        || symbols.SlotCount() != 0)
    {
        return System.Testing.Fail("scalar-nullability");
    }

    stack mut ValueFacts pointerRangeFacts = new();
    pointerRangeFacts.SetIntegerRange(0, 1);
    stack HighLevelIrParameter pointerParameter =
        HighLevelIrParameterOf(SymbolIdOf(19), 0, MirType.Ptr, pointerRangeFacts);
    stack mut MirValueId pointerValue = new();
    stack MirBuilderStatus pointerStatus =
        LowerHighLevelIrParameter(pointerParameter, builder, symbols, instructions, valueFacts, pointerValue);

    return MirBuilderStatusErrIs(pointerStatus, MirBuilderError.TypeMismatch)
        && !pointerValue.IsValid()
        && instructions.Count() == 0
        && valueFacts.Count() == 0
        && MirFunctionBuilderInstructionCount(builder) == 0
        && symbols.SlotCount() == 0
        && System.Text.Equals(MirBuilderErrorName(MirBuilderError.TypeMismatch), "type-mismatch");
}

