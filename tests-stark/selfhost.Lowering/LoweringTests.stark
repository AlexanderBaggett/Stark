    stack HighLevelIrLiteral rightLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(43), MirType.I32, 6);
    stack mut MirValueId left = new();
    stack mut MirValueId right = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(leftLiteral, builder, symbols, instructions, valueFacts, left)))
