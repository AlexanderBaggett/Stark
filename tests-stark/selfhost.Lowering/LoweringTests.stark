[Fact]
fn bool HirBoundaryModelsTheHostHighLevelIrPass()
{
    stack HirMirLoweringBoundary boundary = SelfHostHirMirLoweringBoundary();
    stack HirBackendFactSet facts = boundary.RequiredBackendFacts();
    return boundary.Kind() == HirMirBoundaryKind.HighLevelIrToMidLevelIr
        && System.Text.Equals(HirMirBoundaryKindName(boundary.Kind()), "high-level-ir-to-mid-level-ir")
        && boundary.InputArtifact() == CompilerArtifactKind.HighLevelIr
        && boundary.OutputArtifact() == CompilerArtifactKind.MidLevelIr
        && HirBackendFactsCoverMirLowering(facts);
}

[Fact]
fn bool HighLevelIrModuleStoresFunctionRowsAndBackendFactRequirements()
{
    stack mut HighLevelIrModule hirModule = HighLevelIrModuleOf(10);
    stack HirBackendFactSet fullFacts = RequiredMirLoweringBackendFacts();
    stack HirBackendFactSet partialFacts = HirBackendFactSetOf(true, false, true, true, true, true, true, true);

    if (!MemoryStatusOk(AppendHighLevelIrFunction(
        hirModule,
        HighLevelIrFunctionOf(
            20,
            1,
            2,
            true,
            HirFunctionBodyLoweringKind.StarkCfg,
            false,
            false,
            false,
            fullFacts))))
    {
        return System.Testing.Fail("append-body");
    }

    if (!MemoryStatusOk(AppendHighLevelIrFunction(
        hirModule,
        HighLevelIrFunctionOf(
            21,
            3,
            4,
            false,
            HirFunctionBodyLoweringKind.DeclarationOnly,
            true,
            true,
            true,
            partialFacts))))
    {
        return System.Testing.Fail("append-template");
    }

    if (!MemoryStatusOk(AppendHighLevelIrAddressTakenFunction(hirModule, 20)))
    {
        return System.Testing.Fail("append-address-taken");
    }

    stack HighLevelIrFunction body = hirModule.FunctionAt(0);
    stack HighLevelIrFunction templated = hirModule.FunctionAt(1);
    stack HighLevelIrFunction missing = hirModule.FunctionAt(2);
    return hirModule.ModuleNameSymbol() == 10
        && hirModule.FunctionCount() == 2
        && hirModule.AddressTakenFunctionCount() == 1
        && hirModule.AddressTakenFunctionSymbolAt(0) == 20
        && hirModule.AddressTakenFunctionSymbolAt(1) == 0
        && body.NameSymbol() == 20
        && body.SignatureIndexPlusOne() == 1
        && body.EffectIndexPlusOne() == 2
        && body.HasBody()
        && body.BodyLoweringKind() == HirFunctionBodyLoweringKind.StarkCfg
        && body.HasAllMirLoweringFacts()
        && System.Text.Equals(HirFunctionBodyLoweringKindName(body.BodyLoweringKind()), "StarkCfg")
        && templated.NameSymbol() == 21
        && templated.BodyLoweringKind() == HirFunctionBodyLoweringKind.DeclarationOnly
        && templated.HasBodyTemplate()
        && templated.HasGenericTypeSubstitution()
        && templated.HasGenericValueSubstitution()
        && !templated.HasAllMirLoweringFacts()
        && missing.BodyLoweringKind() == HirFunctionBodyLoweringKind.Unknown;
}

[Fact]
fn bool MirFunctionBuilderTracksOwnedRangesAndDefinesFunction()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> functions = new();
    stack mut MirFunctionBuilderState builder = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(11), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack MirValueId value = MirConstInt(instructions, 42);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, value)))
    {
        return System.Testing.Fail("record-value");
    }

    stack mut MirBlockId entry = new();
    if (!MirBuilderStatusOk(AppendMirBuilderReturnBlock(builder, blocks, value, entry)))
    {
        return System.Testing.Fail("return-block");
    }

    stack mut MirFuncId function = new();
    if (!MirBuilderStatusOk(FinishMirFunctionBuilder(builder, functions, function)))
    {
        return System.Testing.Fail("finish");
    }

    return MirFunctionBuilderInstructionCount(builder) == 1
        && MirFunctionBuilderBlockCount(builder) == 1
        && MirFunctionBuilderOwnsValue(builder, value)
        && MirFunctionBuilderOwnsBlock(builder, entry)
        && function.Index() == 1
        && MirFunctionEntry(functions, function).Equals(entry)
        && MirFunctionBlockCount(functions, function) == 1
        && MirFunctionInstrCount(functions, function) == 1
        && MirFunctionOwnsBlock(functions, function, entry)
        && MirFunctionOwnsValue(functions, function, value)
        && MirBlockTerminator(blocks, entry) == MirTermKind.Return
        && MirBlockReturnValue(blocks, entry).Equals(value);
}

[Fact]
fn bool MirBuilderRejectsClosedAndOutOfRangeBlockCreation()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> functions = new();
    stack mut MirFunctionBuilderState builder = new();
    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(12), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack MirValueId value = MirConstInt(instructions, 1);
    if (!MirBuilderStatusOk(RecordMirFunctionBuilderValue(builder, value)))
    {
        return System.Testing.Fail("record");
    }

    stack mut MirBlockId invalidBranch = new();
    stack MirBuilderStatus invalidBranchStatus = AppendMirBuilderBranchBlock(
        builder,
        blocks,
        MirBlockIdOf(99),
        invalidBranch);

    stack mut MirBlockId entry = new();
    if (!MirBuilderStatusOk(AppendMirBuilderReturnBlock(builder, blocks, value, entry)))
    {
        return System.Testing.Fail("return");
    }

    stack mut MirFuncId function = new();
    if (!MirBuilderStatusOk(FinishMirFunctionBuilder(builder, functions, function)))
    {
        return System.Testing.Fail("finish");
    }

    stack mut MirBlockId closedBlock = new();
    stack MirBuilderStatus closedStatus = AppendMirBuilderReturnBlock(builder, blocks, value, closedBlock);
    return !MirBuilderStatusOk(invalidBranchStatus)
        && MirBuilderStatusErrIs(invalidBranchStatus, MirBuilderError.InvalidHandle)
        && !MirBuilderStatusOk(closedStatus)
        && MirBuilderStatusErrIs(closedStatus, MirBuilderError.BuilderClosed)
        && System.Text.Equals(MirBuilderErrorName(MirBuilderError.BuilderClosed), "builder-closed");
}

[Fact]
fn bool MirLoweringPassShellMatchesHostPipelineContract()
{
    stack MirLoweringPassShell shell = DefaultMirLoweringPassShell();
    stack HirBackendFactSet facts = shell.RequiredBackendFacts();
    return shell.Pass() == CompilerPassId.LowerMir
        && shell.Phase() == CompilerPhase.Lowering
        && shell.ExecutionMode() == PassExecutionMode.SkipOnErrors
        && shell.InputArtifact() == CompilerArtifactKind.HighLevelIr
        && shell.OutputArtifact() == CompilerArtifactKind.MidLevelIr
        && CompilerPassDependencyCount(shell.Pass()) == MirLoweringRequiredArtifactCount()
        && CompilerPassOutputArtifactAt(shell.Pass(), 0) == shell.OutputArtifact()
        && HirBackendFactsCoverMirLowering(facts);
}

[Fact]
fn bool MirLoweringRequiredArtifactsMatchPipelineDependencies()
{
    stack mut u8[0 max] index = 0;
    while willexit (index < MirLoweringRequiredArtifactCount())
    {
        stack CompilerPassId dependency = CompilerPassDependencyAt(CompilerPassId.LowerMir, index);
        stack CompilerArtifactKind pipelineKind = CompilerPassOutputArtifactAt(dependency, 0);
        if (MirLoweringRequiredArtifactAt(index) != pipelineKind)
        {
            return false;
        }

        index += 1;
    }

    return MirLoweringRequiresArtifact(CompilerArtifactKind.LoadedModules)
        && MirLoweringRequiresArtifact(CompilerArtifactKind.HighLevelIr)
        && MirLoweringRequiresArtifact(CompilerArtifactKind.OwnershipValidation)
        && !MirLoweringRequiresArtifact(CompilerArtifactKind.LlvmIrModule)
        && MirLoweringRequiredArtifactAt(6) == CompilerArtifactKind.Unknown;
}

[Fact]
fn bool MirLoweringInputValidationReportsMissingAndSatisfiedArtifacts()
{
    stack mut ArtifactInventory inventory = new();
    switch (MarkArtifactPresent(inventory, CompilerArtifactKind.LoadedModules))
    {
        case ArtifactStatus.Err(var markLoadedError):
            return System.Testing.Fail("mark-loaded");
        case ArtifactStatus.Ok:
    }

    switch (ValidateMirLoweringInputs(inventory))
    {
        case ArtifactResult<ArtifactDependencyReport>.Err(var missingError):
            return System.Testing.Fail("validate-missing");
        case ArtifactResult<ArtifactDependencyReport>.Ok(var missingReport):
            if (ArtifactDependenciesSatisfied(missingReport)
                || ArtifactDependencyMissingCount(missingReport) != 5
                || !ArtifactDependencyReportContains(missingReport, CompilerArtifactKind.HighLevelIr)
                || ArtifactDependencyReportContains(missingReport, CompilerArtifactKind.LoadedModules))
            {
                return System.Testing.Fail("missing-report");
            }
    }

    if (!MarkRequiredMirArtifacts(inventory))
    {
        return System.Testing.Fail("mark-required");
    }

    stack MirLoweringPassShell shell = DefaultMirLoweringPassShell();
    switch (ValidateMirLoweringPassInputs(shell, inventory))
    {
        case ArtifactResult<ArtifactDependencyReport>.Err(var fullError):
            return System.Testing.Fail("validate-full");
        case ArtifactResult<ArtifactDependencyReport>.Ok(var fullReport):
            return ArtifactDependenciesSatisfied(fullReport)
                && ArtifactDependencyMissingCount(fullReport) == 0;
    }
}
