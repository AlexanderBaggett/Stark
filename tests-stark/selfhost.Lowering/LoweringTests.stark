    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral literal = HighLevelIrBoolLiteralOf(SymbolIdOf(9), false);
    stack mut MirValueId value = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(literal, builder, symbols, instructions, valueFacts, value)))
    {
        return System.Testing.Fail("lower");
    }

    stack ValueFacts facts = ValueFactsForMirValue(valueFacts, value);
    return value.Index() == 1
        && MirOpcodeOf(instructions, value) == MirOp.ConstInt
        && MirImmediateOf(instructions, value) == 0
        && MirValueType(instructions, value.Index()) == MirType.I1
        && ValueFactsIntegerRangeIs(facts, 0, 1)
        && ValueFactsIntegerRangeIs(symbols.FactsAt(SymbolIdOf(9)), 0, 1);
}

[Fact]
fn bool MirLoweringRejectsUnsupportedLiteralWithoutEmission()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(33), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral literal =
        HighLevelIrUnsupportedLiteralOf(SymbolIdOf(10), HighLevelIrLiteralKind.Text, MirType.Ptr);
    stack mut MirValueId value = new();
    stack MirBuilderStatus status = LowerHighLevelIrLiteral(
        literal,
        builder,
        symbols,
        instructions,
        valueFacts,
        value);

    return MirBuilderStatusErrIs(status, MirBuilderError.UnsupportedLiteral)
        && !value.IsValid()
        && instructions.Count() == 0
        && valueFacts.Count() == 0
        && symbols.SlotCount() == 0
        && System.Text.Equals(MirBuilderErrorName(MirBuilderError.UnsupportedLiteral), "unsupported-literal");
}

