import Compiler.Artifacts
import Compiler.Ir
import Compiler.Lowering
import Compiler.Mir
import Compiler.Pipeline
import System.Text
import System.Testing
[Collection("lowering")]
module LoweringTests

fn bool MemoryStatusOk(System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return false;
        case System.Memory.MemoryStatus.Ok:
            return true;
    }
}

fn bool ArtifactStatusOk(ArtifactStatus status)
{
    switch (status)
    {
        case ArtifactStatus.Err(var error):
            return false;
        case ArtifactStatus.Ok:
            return true;
    }
}

fn bool MirBuilderStatusOk(MirBuilderStatus status)
{
    switch (status)
    {
        case MirBuilderStatus.Err(var error):
            return false;
        case MirBuilderStatus.Ok:
            return true;
    }
}

fn bool MirBuilderStatusErrIs(MirBuilderStatus status, MirBuilderError expected)
{
    switch (status)
    {
        case MirBuilderStatus.Err(var error):
            return error == expected;
        case MirBuilderStatus.Ok:
            return false;
    }
}

fn bool ValueFactsIntegerRangeIs(ValueFacts facts, i64[min max] lower, i64[min max] upperExclusive)
{
    return facts.HasIntegerRange()
        && facts.IntegerRangeLower() == lower
        && facts.IntegerRangeUpperExclusive() == upperExclusive;
}

fn bool ValueFactsKnownNull(ValueFacts facts)
{
    return facts.HasNullability()
        && facts.KnownNull()
        && !facts.KnownNonNull();
}

fn bool ValueFactsKnownNonNull(ValueFacts facts)
{
    return facts.HasNullability()
        && !facts.KnownNull()
        && facts.KnownNonNull();
}

fn bool MarkRequiredMirArtifacts(mut borrow ArtifactInventory inventory)
{
    stack mut u8[0 max] index = 0;
    while willexit (index < MirLoweringRequiredArtifactCount())
    {
        if (!ArtifactStatusOk(MarkArtifactPresent(inventory, MirLoweringRequiredArtifactAt(index))))
        {
            return false;
        }

        index += 1;
    }

    return true;
}

[Fact]
fn bool MirLoweringSymbolMapUsesDenseSymbolSlotsAndCarriesFacts()
{
    stack mut MirLoweringSymbolMap symbols = new();
    stack mut ValueFacts localFacts = new();
    localFacts.SetIntegerRange(7, 8);
    localFacts.MarkNoAlias();

    if (!MirBuilderStatusOk(BindMirLoweringValueSymbol(
        symbols,
        SymbolIdOf(3),
        MirLoweringSymbolKind.Local,
        MirValueIdOf(5),
        localFacts)))
    {
        return System.Testing.Fail("bind-local");
    }

    if (!MirBuilderStatusOk(BindMirLoweringBlockSymbol(symbols, SymbolIdOf(5), MirBlockIdOf(2))))
    {
        return System.Testing.Fail("bind-block");
    }

    if (!MirBuilderStatusOk(BindMirLoweringFunctionSymbol(symbols, SymbolIdOf(7), MirFuncIdOf(4))))
    {
        return System.Testing.Fail("bind-function");
    }

    stack mut MirValueId foundValue = new();
    stack mut MirBlockId foundBlock = new();
    stack mut MirFuncId foundFunction = new();
    stack ValueFacts readFacts = symbols.FactsAt(SymbolIdOf(3));
    stack MirBuilderStatus duplicate = BindMirLoweringValueSymbol(
        symbols,
        SymbolIdOf(3),
        MirLoweringSymbolKind.Temporary,
        MirValueIdOf(9),
        new ValueFacts());

    return symbols.SlotCount() == 7
        && symbols.KindAt(SymbolIdOf(1)) == MirLoweringSymbolKind.Unknown
        && symbols.KindAt(SymbolIdOf(3)) == MirLoweringSymbolKind.Local
        && symbols.KindAt(SymbolIdOf(5)) == MirLoweringSymbolKind.Block
        && symbols.KindAt(SymbolIdOf(7)) == MirLoweringSymbolKind.Function
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(3), foundValue)
        && foundValue.Index() == 5
        && TryFindMirLoweringBlockSymbol(symbols, SymbolIdOf(5), foundBlock)
        && foundBlock.Index() == 2
        && TryFindMirLoweringFunctionSymbol(symbols, SymbolIdOf(7), foundFunction)
        && foundFunction.Index() == 4
        && readFacts.HasIntegerRange()
        && readFacts.IntegerRangeLower() == 7
        && readFacts.IntegerRangeUpperExclusive() == 8
        && readFacts.HasNoAlias()
        && !MirBuilderStatusOk(duplicate)
        && MirBuilderStatusErrIs(duplicate, MirBuilderError.DuplicateSymbol)
        && System.Text.Equals(MirLoweringSymbolKindName(symbols.KindAt(SymbolIdOf(3))), "local");
}

[Fact]
fn bool HighLevelIrLiteralRowsBuildExactIntegerAndBoolFacts()
{
    stack HighLevelIrLiteral integerLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(4), MirType.I64, 99);
    stack HighLevelIrLiteral boolLiteral = HighLevelIrBoolLiteralOf(SymbolIdOf(5), true);
    stack HighLevelIrLiteral maxLiteral = HighLevelIrIntegerLiteralOf(SymbolIdOf(6), MirType.I64, 9223372036854775807);
    stack HighLevelIrLiteral nullLiteral = HighLevelIrNullPointerLiteralOf(SymbolIdOf(7));
    stack ValueFacts integerFacts = integerLiteral.Facts();
    stack ValueFacts boolFacts = boolLiteral.Facts();
    stack ValueFacts maxFacts = maxLiteral.Facts();
    stack ValueFacts nullFacts = nullLiteral.Facts();

    return integerLiteral.Kind() == HighLevelIrLiteralKind.Integer
        && integerLiteral.Type() == MirType.I64
        && integerLiteral.IntegerValue() == 99
        && ValueFactsIntegerRangeIs(integerFacts, 99, 100)
        && boolLiteral.Kind() == HighLevelIrLiteralKind.Bool
        && boolLiteral.Type() == MirType.I1
        && boolLiteral.IntegerValue() == 1
        && ValueFactsIntegerRangeIs(boolFacts, 1, 2)
        && nullLiteral.Kind() == HighLevelIrLiteralKind.Null
        && nullLiteral.Type() == MirType.Ptr
        && nullLiteral.IntegerValue() == 0
        && ValueFactsKnownNull(nullFacts)
        && ValueFactsIntegerRangeIs(maxFacts, 9223372036854775807, (i64[min max])(-(2 ** 63)))
        && System.Text.Equals(HighLevelIrLiteralKindName(HighLevelIrLiteralKind.Integer), "integer")
        && System.Text.Equals(HighLevelIrLiteralKindName(HighLevelIrLiteralKind.Bool), "bool")
        && System.Text.Equals(HighLevelIrLiteralKindName(HighLevelIrLiteralKind.Null), "null")
        && System.Text.Equals(HighLevelIrLiteralKindName(HighLevelIrLiteralKind.Text), "text");
}

[Fact]
fn bool MirLoweringLowersIntegerLiteralWithExactFactsAndSymbolBinding()
{
    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut MirFunctionBuilderState builder = new();
    stack mut MirLoweringSymbolMap symbols = new();

    if (!MirBuilderStatusOk(BeginMirFunctionBuilder(SymbolIdOf(31), instructions, blocks, builder)))
    {
        return System.Testing.Fail("begin");
    }

    stack HighLevelIrLiteral literal = HighLevelIrIntegerLiteralOf(SymbolIdOf(8), MirType.I32, 123);
    stack mut MirValueId value = new();
    if (!MirBuilderStatusOk(LowerHighLevelIrLiteral(literal, builder, symbols, instructions, valueFacts, value)))
    {
        return System.Testing.Fail("lower");
    }

    stack mut MirValueId found = new();
    stack ValueFacts tableFacts = ValueFactsForMirValue(valueFacts, value);
    stack ValueFacts symbolFacts = symbols.FactsAt(SymbolIdOf(8));
    stack MirBuilderStatus duplicate = LowerHighLevelIrLiteral(literal, builder, symbols, instructions, valueFacts, found);

    return value.Index() == 1
        && instructions.Count() == 1
        && MirFunctionBuilderInstructionCount(builder) == 1
        && MirFunctionBuilderOwnsValue(builder, value)
        && MirOpcodeOf(instructions, value) == MirOp.ConstInt
        && MirImmediateOf(instructions, value) == 123
        && MirValueType(instructions, value.Index()) == MirType.I32
        && symbols.KindAt(SymbolIdOf(8)) == MirLoweringSymbolKind.Temporary
        && TryFindMirLoweringValueSymbol(symbols, SymbolIdOf(8), found)
        && found.Equals(value)
        && ValueFactsIntegerRangeIs(tableFacts, 123, 124)
        && ValueFactsIntegerRangeIs(symbolFacts, 123, 124)
        && !MirBuilderStatusOk(duplicate)
        && MirBuilderStatusErrIs(duplicate, MirBuilderError.DuplicateSymbol)
        && instructions.Count() == 1;
}

