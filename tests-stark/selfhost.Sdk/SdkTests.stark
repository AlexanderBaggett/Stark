import Compiler.Sdk
import System.FileSystem
import System.IO
import System.IO.Path
import System.Memory
import System.Testing
import System.Text
[Collection("sdk")]
module SdkTests

fn bool InitializeTarget(
    mut borrow SdkTargetDescriptor target,
    ascii cpu,
    ascii abi,
    u32[0 max] pointerBits,
    ascii minimum)
    where overlap_all(target)
{
    return InitializeSdkTargetDescriptor(
        target,
        "macos-arm64",
        "arm64-apple-macosx11.0.0",
        "e-m:o-i64:64-i128:128-n32:64-S128",
        "arm64",
        "macos",
        abi,
        pointerBits,
        SdkTargetEndianness.Little,
        cpu,
        "pic",
        "small",
        "lp64",
        minimum) == MemoryStatus.Ok;
}

fn bool InitializeCompatibilityTarget(
    mut borrow SdkTargetDescriptor target,
    ascii triple,
    ascii dataLayout,
    ascii architecture,
    ascii operatingSystem,
    ascii abi,
    ascii cDataModel,
    ascii minimum)
    where overlap_all(target)
{
    return InitializeSdkTargetDescriptor(
        target,
        "compatibility-test",
        triple,
        dataLayout,
        architecture,
        operatingSystem,
        abi,
        64,
        SdkTargetEndianness.Little,
        "generic",
        "pic",
        "small",
        cDataModel,
        minimum) == MemoryStatus.Ok;
}

fn bool SdkManifestParseFailsWith(ascii source, SdkDiagnosticCode expected)
{
    unsafe
    {
        switch (ParseSdkManifestText(source, "sdk.json"))
        {
            case SdkManifestLoadResult.Ok(var manifest):
                return false;
            case SdkManifestLoadResult.Err(var value):
                stack mut SdkDiagnosticList diagnostics = value;
                return diagnostics.Count() == 1 && diagnostics.CodeAt(0) == expected;
        }
    }
}

fn bool SdkDiagnosticsContain(borrow SdkDiagnosticList diagnostics, SdkDiagnosticCode expected)
{
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < diagnostics.Count(); index += 1)
    {
        if (diagnostics.CodeAt(index) == expected)
        {
            return true;
        }
    }

    return false;
}

fn bool TrySdkFixturePath(
    mut borrow System.Testing.TempDirectory fixture,
    ascii relativePath,
    mut borrow OwnedAscii destination)
    where overlap_all(fixture)
{
    switch (fixture.PathFor(relativePath))
    {
        case System.IO.IOResult<OwnedAscii>.Err(var error):
            return false;
        case System.IO.IOResult<OwnedAscii>.Ok(var path):
            stack mut OwnedAscii ownedPath = path;
            destination.Clear();
            return destination.AppendAscii(ownedPath.View()) == MemoryStatus.Ok;
    }
}

