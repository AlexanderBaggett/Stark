                    && System.Text.Equals(manifest.PackageAt(vendorIndex).Native().LinkArgumentAt(2), "-ObjC");
        }
    }
}

[Fact]
fn bool SdkSelectedLinkPlanRejectsMissingDependenciesAndCycles()
{
    unsafe
    {
        stack ascii source = SdkInvalidSelectedLinkPlanManifestText();
        stack ascii path = "sdk.json";
        switch (ParseSdkManifestText(source, path))
        {
            case SdkManifestLoadResult.Err(var loadDiagnostics):
                return false;
            case SdkManifestLoadResult.Ok(var value):
                stack mut SdkManifest manifest = value;
                stack mut SdkPackageIndex index = new();
                stack mut SdkDiagnosticList indexDiagnostics = new();
                if (BuildSdkPackageIndex(index, manifest, indexDiagnostics) != MemoryStatus.Ok
                    || !SdkDiagnosticsContain(indexDiagnostics, SdkDiagnosticCode.DependencyMissing)
                    || !SdkDiagnosticsContain(indexDiagnostics, SdkDiagnosticCode.DependencyCycle))
                {
                    return false;
                }

                stack mut SdkPackageLinkPlan plan = new();
                stack ascii[1] cycleStorage = { "Cycle.A" };
                stack ascii[] cycleImport = cycleStorage;
                stack mut SdkDiagnosticList cycleDiagnostics = new();
                if (BuildSelectedSdkPackageLinkPlan(
                    plan,
                    manifest,
                    index,
                    cycleImport,
                    cycleDiagnostics) != MemoryStatus.Ok
                    || plan.PackageCount() != 0
                    || !SdkDiagnosticsContain(cycleDiagnostics, SdkDiagnosticCode.DependencyCycle))
                {
                    return false;
                }

                stack ascii[1] missingStorage = { "Broken.Module" };
                stack ascii[] missingImport = missingStorage;
                stack mut SdkDiagnosticList missingDiagnostics = new();
                return BuildSelectedSdkPackageLinkPlan(
                    plan,
                    manifest,
                    index,
                    missingImport,
                    missingDiagnostics) == MemoryStatus.Ok
                    && plan.PackageCount() == 0
                    && SdkDiagnosticsContain(
                        missingDiagnostics,
                        SdkDiagnosticCode.DependencyMissing);
        }
    }
}
