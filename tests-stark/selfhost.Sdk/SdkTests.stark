[Fact]
fn bool SdkSelectedLinkPlanSkipsUnusedPayloadsAndOrdersDependents()
{
    unsafe
    {
        stack ascii source = SdkSelectedLinkPlanManifestText();
        stack ascii path = "sdk.json";
        switch (ParseSdkManifestText(source, path))
        {
            case SdkManifestLoadResult.Err(var loadDiagnostics):
                return false;
            case SdkManifestLoadResult.Ok(var value):
                stack mut SdkManifest manifest = value;
                stack mut SdkPackageIndex index = new();
                stack mut SdkDiagnosticList indexDiagnostics = new();
                if (BuildSdkPackageIndex(index, manifest, indexDiagnostics) != MemoryStatus.Ok
                    || indexDiagnostics.Count() != 0)
                {
                    return false;
                }

                stack ascii[2] importedStorage = { "App", "Vendor.Raylib" };
                stack ascii[] imported = importedStorage;
                stack mut SdkPackageLinkPlan plan = new();
                stack mut SdkDiagnosticList planDiagnostics = new();
                if (BuildSelectedSdkPackageLinkPlan(
                    plan,
                    manifest,
                    index,
                    imported,
                    planDiagnostics) != MemoryStatus.Ok
                    || planDiagnostics.Count() != 0
                    || plan.PackageCount() != 2
                    || plan.PackageIndexAt(0) != 2
                    || plan.PackageIndexAt(1) != 0
                    || !System.Text.Equals(manifest.PackageAt(plan.PackageIndexAt(0)).Id(), "Vendor.Raylib")
                    || !System.Text.Equals(manifest.PackageAt(plan.PackageIndexAt(1)).Id(), "System"))
                {
                    return false;
                }

                stack mut SdkDiagnosticList payloadDiagnostics = new();
                stack mut bool found = false;
                for willexit (stack mut u64[0 2 ** 63 - 1] selected = 0;
                    selected < plan.PackageCount();
                    selected += 1)
                {
                    if (ValidateSdkPackagePayloadAt(
                        "../..",
                        manifest,
                        plan.PackageIndexAt(selected),
                        payloadDiagnostics,
                        found) != MemoryStatus.Ok
                        || !found)
                    {
                        return false;
                    }
                }
                if (payloadDiagnostics.Count() != 0)
                {
                    return false;
                }

                stack ascii[2] exactMissStorage = { "Vendor", "vendor.raylib" };
                stack ascii[] exactMisses = exactMissStorage;
                stack mut SdkDiagnosticList exactMissDiagnostics = new();
                return BuildSelectedSdkPackageLinkPlan(
                    plan,
                    manifest,
                    index,
                    exactMisses,
                    exactMissDiagnostics) == MemoryStatus.Ok
                    && exactMissDiagnostics.Count() == 0
                    && plan.PackageCount() == 0;
        }
    }
}

