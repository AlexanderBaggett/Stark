[Fact]
[Collection("llvm-bindings")]
fn bool LlvmDiagnosticErrorsUsePropagatableResultShape()
{
    stack mut System.Text.OwnedAscii diagnostic = new();
    stack LlvmResult<LlvmTarget> result =
        LlvmResult<LlvmTarget>.Err(LlvmError.Diagnostic(diagnostic));
    switch (result)
    {
        case LlvmResult<LlvmTarget>.Ok(var target):
            return false;
        case LlvmResult<LlvmTarget>.Err(var error):
            switch (error)
            {
                case LlvmError.Diagnostic(var text):
                    return true;
                case LlvmError.NullHandle:
                    return false;
                case LlvmError.CString(var cStringError):
                    return false;
                case LlvmError.VersionMismatch:
                    return false;
                case LlvmError.Memory(var memoryError):
                    return false;
                case LlvmError.OperationFailed:
                    return false;
            }
    }
}

