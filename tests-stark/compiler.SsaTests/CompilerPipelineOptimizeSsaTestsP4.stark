// Ported from CompilerPipelineOptimizeSsaTests.ConstStdlibHelperSpecializationRetargetsLiteralTextAppendsToConstDisjointVariants.
public unsafe fn bool ConstStdlibHelperSpecializationRetargetsLiteralTextAppendsToConstDisjointVariantsImpl()
{
    // PORT-NOTE: original asserts AppendAsciiRun/AppendUnicodeRun retarget to the
    // const-disjoint append helpers; reduced to a text signal that both
    // *ConstAscii/Unicode disjoint names appear.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-const-stdlib-retarget-literal-text-appends",
        raw"""
module System.Text

public struct OwnedAscii
{
}
public struct OwnedUnicode
{
}

public fn bool AppendAscii(mut borrow OwnedAscii destination, ascii source);
public fn bool AppendConstAsciiDisjoint(mut borrow OwnedAscii destination, const ascii source);

public fn bool AppendUnicode(mut borrow OwnedUnicode destination, unicode source);
public fn bool AppendConstUnicodeDisjoint(mut borrow OwnedUnicode destination, const unicode source);

fn bool AppendAsciiRun(mut borrow OwnedAscii destination)
{
    return AppendAscii(destination, "alpha");
}

fn bool AppendUnicodeRun(mut borrow OwnedUnicode destination)
{
    return AppendUnicode(destination, (unicode)"beta");
}
""",
        "specialize-const-stdlib-helpers-ssa");
    return Succeeds(compiled)
        && SsaContains(compiled, "AppendConstAsciiDisjoint")
        && SsaContains(compiled, "AppendConstUnicodeDisjoint");
}

// Ported from CompilerPipelineOptimizeSsaTests.ConstStdlibHelperSpecializationRetargetsConstTextHelpers.
public unsafe fn bool ConstStdlibHelperSpecializationRetargetsConstTextHelpersImpl()
{
    // PORT-NOTE: original asserts four retargets (append + factory helpers) to
    // their const variants; reduced to a text signal that all four const helper
    // names appear after specialize-const-stdlib-helpers-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-const-stdlib-retarget-const-text-helpers",
        raw"""
module System.Text

public struct OwnedAscii
{
}
public struct OwnedUnicode
{
}

public fn bool AppendAscii(mut borrow OwnedAscii destination, ascii source);
public fn bool AppendConstAsciiDisjoint(mut borrow OwnedAscii destination, const ascii source);

public fn bool AppendUnicode(mut borrow OwnedUnicode destination, unicode source);
public fn bool AppendConstUnicodeDisjoint(mut borrow OwnedUnicode destination, const unicode source);

public fn bool FromAscii(out OwnedAscii destination, ascii source);
public fn bool FromConstAscii(out OwnedAscii destination, const ascii source);

public fn bool FromAsciiToUnicode(out OwnedUnicode destination, ascii source);
public fn bool FromConstAsciiToUnicode(out OwnedUnicode destination, const ascii source);

fn bool AppendAsciiRun(mut borrow OwnedAscii destination, const ascii source)
{
    return AppendAscii(destination, source);
}

fn bool AppendUnicodeRun(mut borrow OwnedUnicode destination, const unicode source)
{
    return AppendUnicode(destination, source);
}

fn bool FromAsciiRun(out OwnedAscii destination, const ascii source)
{
    return FromAscii(destination, source);
}

fn bool FromAsciiToUnicodeRun(out OwnedUnicode destination, const ascii source)
{
    return FromAsciiToUnicode(destination, source);
}
""",
        "specialize-const-stdlib-helpers-ssa");
    return Succeeds(compiled)
        && SsaContains(compiled, "AppendConstAsciiDisjoint")
        && SsaContains(compiled, "AppendConstUnicodeDisjoint")
        && SsaContains(compiled, "FromConstAscii")
        && SsaContains(compiled, "FromConstAsciiToUnicode");
}

// Ported from CompilerPipelineOptimizeSsaTests.ConstStdlibHelperSpecializationRetargetsLiteralTextMemberAppends.
public unsafe fn bool ConstStdlibHelperSpecializationRetargetsLiteralTextMemberAppendsImpl()
{
    // PORT-NOTE: original asserts the member call retargets to
    // OwnedAscii.AppendConstAsciiDisjoint; reduced to a text signal that the
    // const-disjoint member helper name appears.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-const-stdlib-retarget-literal-text-member-appends",
        raw"""
module System.Text

public struct OwnedAscii
{
    noinline fn bool AppendAscii(mut borrow OwnedAscii self, ascii source)
    {
        return false;
    }

    noinline fn bool AppendConstAsciiDisjoint(mut borrow OwnedAscii self, const ascii source)
    {
        return true;
    }
}

fn bool Run(mut borrow OwnedAscii destination)
{
    return destination.AppendAscii("alpha");
}
""",
        "specialize-const-stdlib-helpers-ssa");
    return Succeeds(compiled) && SsaContains(compiled, "AppendConstAsciiDisjoint");
}

