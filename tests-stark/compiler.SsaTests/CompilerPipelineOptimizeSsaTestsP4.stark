import SsaTestSupport
import System.Testing
module CompilerPipelineOptimizeSsaTestsP4

// Ported slice (part 4) of the source-driven CompilerPipelineOptimizeSsaTests.cs
// optimization tests, running against the current C# host compiler through the
// host test protocol. Each Impl compiles the embedded Stark program (kept
// verbatim from the C# raw string) through the closest compile helper and
// returns a bool that is true when the original xUnit assertions would hold.
//
// PORT-NOTE (suite-wide): the original C# tests inspect the structured
// SsaIrModule object model (block instructions, RValue subtypes, switch cases,
// phi incomings, value-fact lattices, pass-execution order, etc.). The host
// source-in / rendered-artifact-text-out bridge cannot reconstruct those typed
// inputs, so each ported assertion is reduced to the nearest text/Succeeds
// signal over the rendered `ssa` artifact captured after the named stop pass.
// Per-method PORT-NOTE comments name what was reduced where it is not obvious.
// The C# tests remain the oracle until cutover.

// Ported from CompilerPipelineOptimizeSsaTests.ConstStdlibHelperSpecializationKeepsRuntimePathInputsOnStdlibPath.
public unsafe fn bool ConstStdlibHelperSpecializationKeepsRuntimePathInputsOnStdlibPathImpl()
{
    // PORT-NOTE: original asserts the surviving SsaCallRValues still target the
    // runtime GetFacts/Extension stdlib helpers; reduced to a successful compile
    // through specialize-const-stdlib-helpers-ssa that still mentions both names.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-const-stdlib-keeps-runtime-path-inputs",
        raw"""
module System.IO.Path

public struct PathFacts
{
    internal ascii Path;
    internal i64[min max] Length;
    internal i64[min max] End;
    internal i64[min max] SegmentStart;
    internal i64[min max] ExtensionStart;
    internal i64[min max] DirectoryLength;
    internal bool HasExtension;
}

public finite law PathFacts GetFacts(ascii path);
public finite law ascii Extension(ascii path);

fn PathFacts FactsRun(ascii path)
{
    return GetFacts(path);
}

fn ascii ExtensionRun(ascii path)
{
    return Extension(path);
}
""",
        "specialize-const-stdlib-helpers-ssa");
    return Succeeds(compiled)
        && SsaContains(compiled, "GetFacts")
        && SsaContains(compiled, "Extension");
}

// Ported from CompilerPipelineOptimizeSsaTests.ConstStdlibHelperSpecializationRetargetsLiteralPathWritesToConstVariants.
public unsafe fn bool ConstStdlibHelperSpecializationRetargetsLiteralPathWritesToConstVariantsImpl()
{
    // PORT-NOTE: original asserts JoinRun retargets to TryJoinConst and
    // NormalizeRun to TryNormalizeSeparatorsConst (single SsaCallRValue each);
    // reduced to a text signal that both *Const helper names appear after
    // specialize-const-stdlib-helpers-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-const-stdlib-retarget-literal-path-writes",
        raw"""
module System.IO.Path

public struct OwnedAscii
{
}

public fn bool TryJoin(mut borrow OwnedAscii destination, ascii left, ascii right);
public fn bool TryJoinConst(mut borrow OwnedAscii destination, const ascii left, const ascii right);

public fn bool TryNormalizeSeparators(mut borrow OwnedAscii destination, ascii path);
public fn bool TryNormalizeSeparatorsConst(mut borrow OwnedAscii destination, const ascii path);

fn bool JoinRun(mut borrow OwnedAscii destination)
{
    return TryJoin(destination, "alpha", "beta.txt");
}

fn bool NormalizeRun(mut borrow OwnedAscii destination)
{
    return TryNormalizeSeparators(destination, "alpha//beta.txt");
}
""",
        "specialize-const-stdlib-helpers-ssa");
    return Succeeds(compiled)
        && SsaContains(compiled, "TryJoinConst")
        && SsaContains(compiled, "TryNormalizeSeparatorsConst");
}

// Ported from CompilerPipelineOptimizeSsaTests.ConstStdlibHelperSpecializationRetargetsConstPathWritesToConstVariants.
public unsafe fn bool ConstStdlibHelperSpecializationRetargetsConstPathWritesToConstVariantsImpl()
{
    // PORT-NOTE: original asserts the const-typed argument calls retarget to the
    // *Const variants; reduced to a text signal that both *Const names appear.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-const-stdlib-retarget-const-path-writes",
        raw"""
module System.IO.Path

public struct OwnedAscii
{
}

public fn bool TryJoin(mut borrow OwnedAscii destination, ascii left, ascii right);
public fn bool TryJoinConst(mut borrow OwnedAscii destination, const ascii left, const ascii right);

public fn bool TryNormalizeSeparators(mut borrow OwnedAscii destination, ascii path);
public fn bool TryNormalizeSeparatorsConst(mut borrow OwnedAscii destination, const ascii path);

fn bool JoinRun(mut borrow OwnedAscii destination, const ascii left, const ascii right)
{
    return TryJoin(destination, left, right);
}

fn bool NormalizeRun(mut borrow OwnedAscii destination, const ascii path)
{
    return TryNormalizeSeparators(destination, path);
}
""",
        "specialize-const-stdlib-helpers-ssa");
    return Succeeds(compiled)
        && SsaContains(compiled, "TryJoinConst")
        && SsaContains(compiled, "TryNormalizeSeparatorsConst");
}

