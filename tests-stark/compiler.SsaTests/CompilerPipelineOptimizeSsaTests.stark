// Ported from CompilerPipelineOptimizeSsaTests.InlineSsaOptimizesThroughSourceBuiltDependencyBoundary.
internal fn bool InlineSsaOptimizesThroughSourceBuiltDependencyBoundaryImpl()
{
    // PORT-NOTE: original writes a Math.stark dependency to a temp directory,
    // imports it via a FileSystemModuleResolver, and asserts the imported
    // Math.AddOne call is inlined to a constant 42 return. The SSA host bridge
    // now stages the sibling source dependency directly, so this checks the same
    // optimized-SSA signal as the C# oracle: Run folds to 42 and no AddOne call
    // survives in Run.
    stack mut SsaCompile compiled = CompileSsaAfterOptimizedWithModule(
        "optssa-p2-inline-source-built-dependency",
        raw"""
import Math
module Demo

unsafe fn i32[min max] Run()
{
    return Math.AddOne(41);
}
""",
        "inline-ssa",
        "Math.stark",
        raw"""
module Math

public inline finite law i32[min max] AddOne(i32[min max] value)
{
    return value + 1;
}
""");
    return OptimizedSsaFunctionContains(compiled, "Run", "return 42")
        && OptimizedSsaFunctionLacks(compiled, "Run", "AddOne");
}

