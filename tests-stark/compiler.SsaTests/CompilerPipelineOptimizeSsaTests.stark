        "arithmetic-fold-ssa-folds-wrapping-subtract-runs-with-wrapping-multiply",
        raw"""
module Demo

fn i8[min max] Run(i8[min max] x, i8[min max] y)
{
    return x +% x -% y -% y;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts a WrappingMultiply with coefficient 2 and a
    // surviving WrappingSubtract are present. Reduced to post-fold `optimized-ssa` text: a
    // wrapping-multiply-by-2 (`*% 2`) and a wrapping subtract (`-%`) are present.
    return OptimizedSsaContains(c, "*% 2") && OptimizedSsaContains(c, "-%");
}

