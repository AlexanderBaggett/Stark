// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaFoldsWrappingAddRunsWithWrappingMultiply.
internal fn bool ArithmeticFoldSsaFoldsWrappingAddRunsWithWrappingMultiplyImpl()
{
    stack mut SsaCompile c = CompileSsaAfterOptimized(
        "arithmetic-fold-ssa-folds-wrapping-add-runs-with-wrapping-multiply",
        raw"""
module Demo

fn i8[min max] Run(i8[min max] value)
{
    return value +% value +% value;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts Run holds a single WrappingMultiply with
    // coefficient 3. Reduced to post-fold `optimized-ssa` text: a wrapping-multiply-by-3
    // (`*% 3`) is present.
    return OptimizedSsaContains(c, "*% 3");
}

// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaFoldsWrappingSubtractRunsWithWrappingMultiply.
internal fn bool ArithmeticFoldSsaFoldsWrappingSubtractRunsWithWrappingMultiplyImpl()
{
