// Ported from CompilerPipelineOptimizeSsaTests.ConstantTextFormatSpecializationNormalizesOutOfRangeNarrowedIntegerConstants.
internal fn bool ConstantTextFormatSpecializationNormalizesOutOfRangeNarrowedIntegerConstantsImpl()
{
    // PORT-NOTE: original asserts the out-of-range narrowed constant (i8)300 = 44
    // normalizes so TryFormatI16Ascii is rewritten (no call survives, stores of
    // ascii digit bytes for "44"); reduced to a text signal that the call name is
    // gone after the pass.
    stack mut SsaCompile compiled = CompileSsaAfterOptimized(
        "optssa-p4-format-const-normalizes-out-of-range",
        raw"""
module System.Text

public unsafe finite bool TryFormatI16Ascii(rawmutptr<Ascii> destination, i16[min max] value);

public unsafe fn bool Run()
{
    stack mut i8[min max][8] storage;
    stack mut Ascii text = new Ascii()
    {
        Data = &storage[0],
        Length = 0,
        Capacity = 8
    };

    return TryFormatI16Ascii(&text, (i16[min max])((i8[min max])300));
}
""",
        "specialize-constant-text-formatting-ssa");
    return OptimizedSsaFunctionLacks(compiled, "Run", "TryFormatI16Ascii")
        && OptimizedSsaFunctionContains(compiled, "Run", "store 2 ->")
        && OptimizedSsaOccurrences(compiled, "store 52 ->") >= 2;
}

// Ported from CompilerPipelineOptimizeSsaTests.FactDrivenSwitchPruningRemovesCasesOutsideKnownInputRange.
internal fn bool FactDrivenSwitchPruningRemovesCasesOutsideKnownInputRangeImpl()
{
    // PORT-NOTE: original asserts the unreachable case-10/case-11 switch arms are
    // pruned (input range [0 2]); the host bridge cannot inspect typed switch
    // cases, so this is reduced to a successful compile through prune-branches of
    // the verbatim program.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-switch-prune-out-of-range-cases",
        raw"""
module Demo

fn i32[min max] Run(u8[0 2] value)
{
    stack i32[min max] widened = (i32[min max])value;
    switch (widened)
    {
        case 0:
            return 10;
        case 1:
            return 11;
        case 2:
            return 12;
        case 10:
            return 20;
        case 11:
            return 21;
        default:
            return 99;
    }
}
""",
        "prune-branches");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.FactDrivenSwitchPruningRewritesSingleReachableCaseToBranch.
internal fn bool FactDrivenSwitchPruningRewritesSingleReachableCaseToBranchImpl()
{
    // PORT-NOTE: original asserts the switch (one reachable case, input [10 12])
    // is rewritten to a branch with an equality test (no surviving switch
    // terminator); reduced to a successful compile through prune-branches of the
    // verbatim program.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-switch-prune-single-reachable-case",
        raw"""
module Demo

fn i32[min max] Run(u8[10 12] value)
{
    stack i32[min max] widened = (i32[min max])value;
    switch (widened)
    {
        case 10:
            return 10;
        case 40:
            return 40;
        case 41:
            return 41;
        default:
            return 99;
    }
}
""",
        "prune-branches");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.FactDrivenBranchPruningKeepsReusedForLoopVariableRangesScoped.
internal fn bool FactDrivenBranchPruningKeepsReusedForLoopVariableRangesScopedImpl()
{
    // PORT-NOTE: original asserts the second loop keeps a `< 100000` branch (the
    // reused induction variable `i` ranges stay scoped per loop) and a block
    // returns constant 0; reduced to a successful compile through prune-branches
    // of the verbatim program.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-prune-reused-for-loop-ranges-scoped",
        raw"""
module Demo

unsafe fn i32[min max] Run()
{
    stack mut u24[0 200000] total = 0;
    for willexit (stack mut u8[0 2] i = 0; i < 2; i += 1)
    {
        total += 1;
    }

    for willexit (stack mut u24[0 100000] i = 0; i < 100000; i += 1)
    {
        total += 1;
    }

    if (total == 100002)
    {
        return 0;
    }

    return 1;
}
""",
        "prune-branches");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.AliasAwareMemoryOptimizationRemovesDeadForwardedStackScalarStores.
internal fn bool AliasAwareMemoryOptimizationRemovesDeadForwardedStackScalarStoresImpl()
{
    // PORT-NOTE: original asserts memory-opt-ssa removes the dead store/load of
    // `local` (no SsaStoreLocal/SsaLoadLocal for `local`); reduced to a
    // successful compile through memory-opt-ssa of the verbatim program.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-alias-removes-dead-forwarded-scalar-stores",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] value)
{
    stack mut i32[min max] local = value;
    local = local + 1;
    return local;
}
""",
        "memory-opt-ssa");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.AliasAwareMemoryOptimizationKeepsAddressTakenStackScalarStoresConservative.
internal fn bool AliasAwareMemoryOptimizationKeepsAddressTakenStackScalarStoresConservativeImpl()
{
    // PORT-NOTE: original asserts the address-taken `local` keeps both stores and
    // its address-of (conservative); reduced to a successful compile through
    // memory-opt-ssa of the verbatim program.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-alias-keeps-address-taken-scalar-stores",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] value)
{
    stack mut i32[min max] local = value;
    stack rawptr<i32[min max]> ptr = &local;
    local = value + 1;
    return *ptr;
}
""",
        "memory-opt-ssa");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.AliasAwareMemoryOptimizationForwardsStackFieldLoadsFromSource.
internal fn bool AliasAwareMemoryOptimizationForwardsStackFieldLoadsFromSourceImpl()
{
    // PORT-NOTE: original asserts the `pair.Left` load is forwarded from its
    // source store so no SsaLoadIndirect for "pair.Left" survives and the return
    // is the value reference "arg_value"; reduced to a text signal that the
    // forwarded arg_value reference appears after memory-opt-ssa.
    stack mut SsaCompile compiled = CompileSsaAfterOptimized(
        "optssa-p4-alias-forwards-stack-field-loads",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    return pair.Left;
}
""",
        "memory-opt-ssa");
    return Succeeds(compiled) && OptimizedSsaContains(compiled, "arg_value");
}

// Ported from CompilerPipelineOptimizeSsaTests.AliasAwareMemoryOptimizationForwardsNestedStackFieldLoadsFromSource.
internal fn bool AliasAwareMemoryOptimizationForwardsNestedStackFieldLoadsFromSourceImpl()
{
    // PORT-NOTE: original asserts the nested `outer.Left.Value` load is forwarded
    // from its source store so no SsaLoadIndirect for "outer.Left.Value" survives
    // and the return is "arg_value"; reduced to a text signal that the forwarded
    // arg_value reference appears after memory-opt-ssa.
    stack mut SsaCompile compiled = CompileSsaAfterOptimized(
        "optssa-p4-alias-forwards-nested-stack-field-loads",
        raw"""
module Demo

record Inner(i32[min max] Value, i32[min max] Salt)
{
}
record Outer(Inner Left, Inner Right)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Outer outer = new Outer(new Inner(0, 1), new Inner(2, 3));
    outer.Left.Value = value;
    return outer.Left.Value;
}
""",
        "memory-opt-ssa");
    return Succeeds(compiled) && OptimizedSsaContains(compiled, "arg_value");
}

// Ported from CompilerPipelineOptimizeSsaTests.AliasAwareMemoryOptimizationPreservesStackFieldFactsAcrossPureScalarCallsFromSource.
internal fn bool AliasAwareMemoryOptimizationPreservesStackFieldFactsAcrossPureScalarCallsFromSourceImpl()
{
    // PORT-NOTE: original asserts the pure scalar `Touch` call survives while the
    // `pair.Left` load is still forwarded (no SsaLoadIndirect for "pair.Left");
    // reduced to a text signal that the Touch call name survives after
    // memory-opt-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p4-alias-preserves-field-facts-across-pure-call",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

noinline finite law i32[min max] Touch(i32[min max] value)
{
    return value + 1;
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    stack i32[min max] ignored = Touch(value);
    return pair.Left + ignored;
}
""",
        "memory-opt-ssa");
    return Succeeds(compiled) && SsaContains(compiled, "Touch");
}

// Ported slice (part 5) of the source-driven CompilerPipelineOptimizeSsaTests.cs
// optimization tests, running against the current C# host compiler through the
// host test protocol. Each Impl compiles the embedded Stark program (kept
// verbatim from the C# raw string) through the closest compile helper and
// returns a bool.
//
// PORT-NOTE (suite-wide): the original C# tests inspect the structured
// SsaIrModule object model (block instructions, RValue subtypes such as
// SsaLoadIndirectRValue / SsaLoadGlobalRValue / SsaCallRValue, and the
// SsaStoreIndirectInstruction list). The host source-in / rendered-artifact-text
// -out bridge cannot reconstruct those typed inputs, so each ported assertion is
// reduced to the nearest text/Succeeds signal over the rendered `ssa`
// (post-named-pass, via CompileSsaAfter) artifact. Per-method PORT-NOTE comments
// name what was reduced. The C# tests remain the oracle until cutover.

// Ported from CompilerPipelineOptimizeSsaTests.AliasAwareMemoryOptimizationForwardsStackFieldFactsAcrossSinglePredecessorBlocksFromSource.
internal fn bool AliasAwareMemoryOptimizationForwardsStackFieldFactsAcrossSinglePredecessorBlocksFromSourceImpl()
{
    // PORT-NOTE: original stops after memory-opt-ssa and asserts that no
    // SsaLoadIndirectRValue with text "pair.Left" survives in Run (the field
    // facts are forwarded across the single-predecessor block). Reduced to a text
    // signal that the "pair.Left" indirect load is gone after memory-opt-ssa.
    stack mut SsaCompile compiled = CompileSsaAfterOptimized(
        "optssa-p5-forward-stack-field-single-pred",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(bool flag, i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    if (flag)
    {
        return pair.Left;
    }

    return pair.Left + 1;
}
""",
        "memory-opt-ssa");
    return Succeeds(compiled) && OptimizedSsaLacks(compiled, "pair.Left");
}

// Ported from CompilerPipelineOptimizeSsaTests.AliasAwareMemoryOptimizationForwardsFixedArrayElementFactsFromSource.
internal fn bool AliasAwareMemoryOptimizationForwardsFixedArrayElementFactsFromSourceImpl()
{
    // PORT-NOTE: original stops after memory-opt-ssa and asserts that no
    // SsaLoadIndirectRValue with text "items[0]" survives in Run (the fixed-array
    // element fact is forwarded). Reduced to a text signal that the "items[0]"
    // indirect load is gone after memory-opt-ssa.
    stack mut SsaCompile compiled = CompileSsaAfterOptimized(
        "optssa-p5-forward-fixed-array-element",
        raw"""
module Demo

fn u8[0 200] Run(u8[0 100] value)
{
    stack mut u8[0 200][4] items =
    {
        0, 0, 0, 0
    };
    items[0] = value;
    items[1] = 7;
    return items[0];
}
""",
        "memory-opt-ssa");
    return Succeeds(compiled) && OptimizedSsaLacks(compiled, "items[0]");
}

// Ported from CompilerPipelineOptimizeSsaTests.ScalarReplacementRemovesDeadStackFieldStoresFromSource.
internal fn bool ScalarReplacementRemovesDeadStackFieldStoresFromSourceImpl()
{
    // PORT-NOTE: original stops after sroa-ssa and asserts the surviving
    // SsaStoreIndirectInstruction list in Run is empty (scalar replacement of
    // aggregates removes the dead store to pair.Left). The text bridge cannot
    // enumerate the typed store-indirect instruction list, so this is reduced to
    // a successful compile through sroa-ssa plus a text signal that the dead
    // "pair.Left" store target no longer appears.
    stack mut SsaCompile compiled = CompileSsaAfterOptimized(
        "optssa-p5-sroa-remove-dead-stack-field-store",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    return value + 1;
}
""",
        "sroa-ssa");
    return OptimizedSsaFunctionLacks(compiled, "Run", "pair.Left");
}

// Ported from CompilerPipelineOptimizeSsaTests.AliasAwareMemoryOptimizationUsesFunctionEffectsForPureCallGlobalFacts.
internal fn bool AliasAwareMemoryOptimizationUsesFunctionEffectsForPureCallGlobalFactsImpl()
{
    // PORT-NOTE: original stops after memory-opt-ssa and asserts (a) no
    // SsaLoadGlobalRValue for "Counter" survives, because the pure (finite law)
    // Touch call carries no global-write effect so the reload of Counter is
    // forwarded, and (b) a surviving SsaCallRValue to "Touch". The text bridge
    // cannot distinguish a global *load* of Counter from the surviving
    // "Counter = value" store, so the no-load assertion is not separable in
    // rendered text; the faithful, expressible signal is that the Touch call
    // survives after memory-opt-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p5-pure-call-global-facts",
        raw"""
module Demo

static mut i32[min max] Counter = 0;

noinline finite law i32[min max] Touch(i32[min max] value)
{
    return value + 1;
}

fn i32[min max] Run(i32[min max] value)
{
    Counter = value;
    stack i32[min max] first = Counter;
    stack i32[min max] ignored = Touch(first);
    return Counter;
}
""",
        "memory-opt-ssa");
    return Succeeds(compiled) && SsaContains(compiled, "Touch");
}
