// Ported from CompilerPipelineOptimizeSsaTests.CleanupSsaForwardsAggregateFieldThroughMatchingBranchPhi.
internal fn bool CleanupSsaForwardsAggregateFieldThroughMatchingBranchPhiImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "cleanup-ssa-forwards-aggregate-field-through-matching-branch-phi",
        raw"""
module Demo

struct Pair
{
    i32[min max] Value;
    i32[min max] Tag;
}

fn i32[min max] Run(bool flag, i32[min max] value)
{
    stack Pair pair = flag
        ? new Pair()
        {
            Value = value, Tag = 1
        }
        : new Pair()
        {
            Value = value, Tag = 2
        };
    return pair.Value;
}
""");
    // PORT-NOTE: The C# test stops after cleanup-ssa and asserts Run holds no
    // SsaExtractFieldRValue whose FieldName is "Value" (the field read was forwarded
    // through the matching branch phi). The extract-field object model is not
    // reachable through the artifact-text bridge, so this is reduced to optimized
    // SSA text: no `extract-field` / `.Value` read survives.
    if (!Succeeds(c))
    {
        return false;
    }

    return OptimizedSsaLacks(c, "extract-field") && OptimizedSsaLacks(c, ".Value");
}

// Ported from CompilerPipelineOptimizeSsaTests.OptimizeSsaRemovesStaticRangeModuloAndDivisionIdentities.
internal fn bool OptimizeSsaRemovesStaticRangeModuloAndDivisionIdentitiesImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "optimize-ssa-removes-static-range-modulo-and-division-identities",
        raw"""
module Demo

fn i32[min max] Run(u8[0 7] slot)
{
    stack u8[0 max] modulo = slot % (u8[0 max])8;
    stack u8[0 max] divided = slot / (u8[0 max])8;
    return modulo + divided;
}
""");
    // PORT-NOTE: The C# test stops after optimize-ssa and asserts Run holds no
    // SsaBinaryRValue with operator Divide or Modulo (the static-range slot makes
    // both identities, slot % 8 == slot and slot / 8 == 0). The binary object model
    // is not reachable through the artifact-text bridge, so this is reduced to
    // optimized-SSA text: neither a divide (`/ 8`) nor a modulo (`% 8`) survives.
    if (!Succeeds(c))
    {
        return false;
    }

    return OptimizedSsaLacks(c, "/ 8") && OptimizedSsaLacks(c, "% 8");
}

// Ported from CompilerPipelineOptimizeSsaTests.CleanupSsaRemovesSameOperandDivisionAndModuloWhenSourceRangeExcludesZero.
internal fn bool CleanupSsaRemovesSameOperandDivisionAndModuloWhenSourceRangeExcludesZeroImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "cleanup-ssa-removes-same-operand-division-and-modulo-when-source-range-excludes-zero",
        raw"""
module Demo

fn i32[min max] Run(u8[1 100] value)
{
    stack u8[0 max] divided = value / value;
    stack u8[0 max] modulo = value % value;
    return divided + modulo;
}
""");
    // PORT-NOTE: The C# test stops after cleanup-ssa and asserts Run holds no
    // SsaBinaryRValue with operator Divide or Modulo (value / value == 1 and
    // value % value == 0 once the [1 100] range proves value is non-zero). The
    // binary object model is not reachable through the artifact-text bridge, so
    // this is reduced to optimized-SSA text: neither a same-operand divide
    // (`value / value`) nor modulo (`value % value`) survives.
    if (!Succeeds(c))
    {
        return false;
    }

    return OptimizedSsaLacks(c, "value / value") && OptimizedSsaLacks(c, "value % value");
}

// Ported slice (part 2) of the source-driven CompilerPipelineOptimizeSsaTests.cs
// optimization tests, running against the current C# host compiler through the
// host test protocol. Each Impl compiles the embedded Stark program (kept
// verbatim from the C# raw string) through the closest compile helper and
// returns a bool.
//
// PORT-NOTE (suite-wide): the original C# tests inspect the structured
// SsaIrModule object model (block instructions, RValue subtypes, ownership
// summaries, address-taken sets, pass-execution order, etc.). The host
// source-in / rendered-artifact-text-out bridge cannot reconstruct those typed
// inputs, so each ported assertion is reduced to the nearest text/Succeeds
// signal over the rendered `ssa` (post-named-pass) or `optimized-ssa` artifact.
// Per-method PORT-NOTE comments name what was reduced where it is not obvious.
// The C# tests remain the oracle until cutover.

// Ported from CompilerPipelineOptimizeSsaTests.CleanupSsaRemovesSameOperandIntegerComparisons.
internal fn bool CleanupSsaRemovesSameOperandIntegerComparisonsImpl()
{
    // PORT-NOTE: original asserts no SsaBinaryRValue comparison operators survive
    // after cleanup-ssa; reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfterOptimized(
        "optssa-p2-cleanup-same-operand-cmp",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    stack i32[min max] equal = value == value ? 1 : 100;
    stack i32[min max] notEqual = value != value ? 100 : 1;
    stack i32[min max] less = value < value ? 100 : 1;
    stack i32[min max] lessOrEqual = value <= value ? 1 : 100;
    stack i32[min max] greater = value > value ? 100 : 1;
    stack i32[min max] greaterOrEqual = value >= value ? 1 : 100;
    return equal + notEqual + less + lessOrEqual + greater + greaterOrEqual;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.ShapeBranchesSimplifiesBooleanReturnDiamondToCondition.
internal fn bool ShapeBranchesSimplifiesBooleanReturnDiamondToConditionImpl()
{
    // PORT-NOTE: original asserts the return value is the SsaValueReference
    // "arg_flag" with no surviving SsaSelectRValue after shape-branches; reduced
    // to a text signal over the rendered ssa text after shape-branches.
    stack mut SsaCompile compiled = CompileSsaAfterOptimized(
        "optssa-p2-shape-bool-return-diamond",
        raw"""
module Demo

fn bool Run(bool flag)
{
    if (flag)
    {
        return true;
    }

    return false;
}
""",
        "shape-branches");
    return SsaContains(compiled, "arg_flag");
}

// Ported from CompilerPipelineOptimizeSsaTests.InlineSsaInlinesSmallDirectCallsAndRerunsConstantPropagation.
internal fn bool InlineSsaInlinesSmallDirectCallsAndRerunsConstantPropagationImpl()
{
    // PORT-NOTE: original asserts no call to AddOne survives and the block folds
    // to a constant 42 return; reduced to a text signal that the AddOne call is
    // gone after inline-ssa.
    stack mut SsaCompile compiled = CompileSsaAfterOptimized(
        "optssa-p2-inline-small-direct-const-prop",
        raw"""
module Demo

public inline finite law i32[min max] AddOne(i32[min max] value)
{
    return value + 1;
}

unsafe fn i32[min max] Run()
{
    return AddOne(41);
}
""",
        "inline-ssa");
    return Succeeds(compiled) && OptimizedSsaFunctionLacks(compiled, "Run", "AddOne");
}

// Ported from CompilerPipelineOptimizeSsaTests.AggregateConstructionSsaStoresFullConstructorsDirectlyIntoNonEscapedLocalFields.
internal fn bool AggregateConstructionSsaStoresFullConstructorsDirectlyIntoNonEscapedLocalFieldsImpl()
{
    // PORT-NOTE: original runs three compiles (memory-opt-ssa, then
    // aggregate-construction-ssa, then full) and inspects SsaStoreLocal /
    // SsaStoreIndirect instructions; reduced to a successful compile through
    // aggregate-construction-ssa plus the full pipeline.
    stack mut SsaCompile after = CompileSsaAfter(
        "optssa-p2-agg-construct-nonescaped",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

fn i32[min max] Run()
{
    heap mut Pair value = new Pair()
    {
        Left = 1, Right = 2
    };
    return value.Left;
}
""",
        "aggregate-construction-ssa");
    stack mut SsaCompile full = CompileOptimizedSsa(
        "optssa-p2-agg-construct-nonescaped-full",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

fn i32[min max] Run()
{
    heap mut Pair value = new Pair()
    {
        Left = 1, Right = 2
    };
    return value.Left;
}
""");
    return Succeeds(after) && Succeeds(full);
}

// Ported from CompilerPipelineOptimizeSsaTests.AggregateConstructionSsaKeepsWholeStoreForRawEscapedLocal.
internal fn bool AggregateConstructionSsaKeepsWholeStoreForRawEscapedLocalImpl()
{
    // PORT-NOTE: original asserts an SsaStoreLocal of "value" of type Pair
    // survives because the local escapes via raw pointer; reduced to a text
    // signal that the "value" local is still present after
    // aggregate-construction-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-agg-construct-raw-escaped",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

unsafe ffi fn void Observe(rawptr<Pair> pointer);

unsafe fn i32[min max] Run()
{
    heap mut Pair value = new Pair()
    {
        Left = 1, Right = 2
    };
    stack rawptr<Pair> pointer = &value;
    Observe(pointer);
    return value.Left;
}
""",
        "aggregate-construction-ssa");
    return Succeeds(compiled) && SsaContains(compiled, "value");
}

// Ported from CompilerPipelineOptimizeSsaTests.OwnershipTrafficSsaElidesDeadAggregateMoveTrafficForNonEscapedRoots.
internal fn bool OwnershipTrafficSsaElidesDeadAggregateMoveTrafficForNonEscapedRootsImpl()
{
    // PORT-NOTE: original runs memory-opt-ssa then ownership-traffic-ssa and
    // inspects SsaCopyMemory(Move) and SsaStoreLocal(undef) on "source"; reduced
    // to a successful compile through ownership-traffic-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-ownership-elide-dead-move",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

fn void Run()
{
    heap mut Pair source = new Pair()
    {
        Left = 1, Right = 2
    };
    heap mut Pair destination = new Pair()
    {
