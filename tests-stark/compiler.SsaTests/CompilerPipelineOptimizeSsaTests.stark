internal fn bool ConstantTextFormatSpecializationRewritesLargeIntegerUnicodeFormatCallsBeforeAbiLoweringImpl()
{
    // PORT-NOTE: original asserts TryFormatU1024Unicode is rewritten into an
    // inline memcpy from unicode text data (fixed length 309, 32-bit elements)
    // with no surviving call; reduced to a text signal that the call name is gone
