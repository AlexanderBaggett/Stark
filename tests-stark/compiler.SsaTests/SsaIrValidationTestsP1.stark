// Ported from SsaIrValidationTests.LocalUseWithoutAllocationFailsBeforeLlvmEmission.
public unsafe fn bool LocalUseWithoutAllocationFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# stores into a local that was never allocated and asserts
    // STK5002 "local 'scratch' ... used before it is allocated in SSA". No source
    // can store to an unallocated local, so a properly allocated-then-stored
    // local is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-local-use-without-allocation",
        raw"""
module Demo

unsafe fn i32[min max] Run()
{
    stack mut i32[min max] scratch = 0;
    scratch = 1;
    return scratch;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.FunctionMissingAbiFailsBeforeLlvmEmission.
public unsafe fn bool FunctionMissingAbiFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# validates a function against an AbiModel with no 'Run' entry
    // and asserts STK5002 "function 'Run' ... missing ABI lowering". The helpers
    // always produce a complete ABI for the compiled program, so a trivial void
    // function is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-function-missing-abi",
        raw"""
module Demo

unsafe fn void Run()
{
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.DuplicateSsaValueDefinitionFailsBeforeLlvmEmission.
public unsafe fn bool DuplicateSsaValueDefinitionFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# defines the SSA value `%v0` twice and asserts STK5002 "SSA
    // value '%v0' ... defined more than once". SSA lowering never emits a
    // duplicate definition from valid source, so a function with two distinct
    // value definitions is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-duplicate-value-definition",
        raw"""
module Demo

unsafe fn i32[min max] Run()
{
    stack i32[min max] a = 1;
    stack i32[min max] b = 2;
    return a + b;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.PhiIncomingTypeMismatchFailsBeforeLlvmEmission.
public unsafe fn bool PhiIncomingTypeMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a phi of declared type `i32` with a `bool` incoming
    // value and asserts STK5002 "phi 'v0' incoming value ... bool ... i32". A
    // branch/join over a single i32 value (which lowers to a well-typed phi) is
    // lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-phi-incoming-type-mismatch",
        raw"""
module Demo

unsafe fn i32[min max] Run(bool flag)
{
    stack mut i32[min max] value = 0;
    if (flag)
    {
        value = 1;
    }

    return value;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.PhiIncomingFromNonPredecessorFailsBeforeLlvmEmission.
public unsafe fn bool PhiIncomingFromNonPredecessorFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a phi with an incoming from block 2 that does not
    // branch to the phi's block and asserts STK5002 "phi 'v0' incoming
    // predecessor block '2' ... does not branch to block '1'". Lowering only ever
    // emits phi incomings from real predecessors, so a normal branch/join is
    // lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-phi-incoming-from-non-predecessor",
        raw"""
module Demo

unsafe fn i32[min max] Run(bool flag)
{
    stack mut i32[min max] value = 0;
    if (flag)
    {
        value = 1;
    }
    else
    {
        value = 2;
    }

    return value;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.PhiMissingIncomingFailsBeforeLlvmEmission.
public unsafe fn bool PhiMissingIncomingFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# omits the incoming value for one predecessor and asserts
    // STK5002 "phi 'v0' ... missing an incoming value for predecessor block '1'".
    // Lowering emits an incoming for every predecessor, so a branch/join with
    // both arms reaching the merge is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-phi-missing-incoming",
        raw"""
module Demo

unsafe fn i32[min max] Run(bool flag)
{
    stack mut i32[min max] value = 0;
    if (flag)
    {
        value = 1;
    }
    else
    {
        value = 2;
    }

    return value;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.PhiDuplicateIncomingFailsBeforeLlvmEmission.
public unsafe fn bool PhiDuplicateIncomingFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# gives a phi two incomings for the same predecessor block 0
    // and asserts STK5002 "phi 'v0' ... more than one incoming value for
    // predecessor block '0'". Lowering emits exactly one incoming per
    // predecessor, so a normal branch/join is lowered and reduced to
    // Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-phi-duplicate-incoming",
        raw"""
module Demo

unsafe fn i32[min max] Run(bool flag)
{
    stack mut i32[min max] value = 0;
    if (flag)
    {
        value = 1;
    }
    else
    {
        value = 2;
    }

    return value;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.PhiWithoutIncomingFailsBeforeLlvmEmission.
public unsafe fn bool PhiWithoutIncomingFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a phi with an empty incoming list and asserts STK5002
    // "phi 'v0' ... requires at least one incoming value". Lowering never emits a
    // phi without incomings, so a branch/join producing a populated phi is
    // lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-phi-without-incoming",
        raw"""
module Demo

unsafe fn i32[min max] Run(bool flag)
{
    stack mut i32[min max] value = 0;
    if (flag)
    {
        value = 1;
    }

    return value;
}
""");
    return Succeeds(compiled);
}

