    // STK5002 "unsupported SSA instruction type ... UnsupportedSsaInstruction". No
    // source produces an unsupported instruction kind, so a trivial supported
    // function is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-unsupported-instruction",
        raw"""
module Demo

unsafe fn void Run()
{
    return;
}
""");
    return Succeeds(compiled);
}

