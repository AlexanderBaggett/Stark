import SsaTestSupport
import System.Testing
module SsaIrValidationTestsP1

// Ported slice of tests/compiler.Tests/SsaIrValidationTests.cs.
//
// PORT-NOTE (applies to EVERY function in this file): the C#
// SsaIrValidationTests build `SsaFunction` / `SsaIrModule` object-model IR by
// hand (BuildVoidFunction / BuildReturningFunction / BuildVoidMultiBlockFunction
// / BuildSwitchFunction + an explicit AbiModel / TypeCheckModel) and invoke
// `SsaIrValidator.Validate()` directly, asserting on the structured STK5002
// diagnostics it emits BEFORE LLVM emission. None of these tests carry an
// embedded Stark source program. The available host-test helpers are a
// source-in / artifact-text-out bridge (CompileSsa compiles a single Stark
// source string and exposes the rendered `ssa` artifact text); they cannot
// construct hand-built SsaFunction inputs or call the validator on synthetic IR,
// and they cannot inject a custom AbiModel/TypeCheckModel. So each method below
// is reduced to the closest reachable signal: a plausible, well-formed
// `module Demo` Stark program that exercises the same SSA-lowering scenario the
// C# test pins, compiled through CompileSsa (raw `lower-ssa` pass, which is the
// stage the SsaIrValidator runs before), and the assertion is reduced to
// Succeeds(...). The original C# remains the oracle for the negative-diagnostic
// (STK5002) facts until cutover; these ports only confirm the corresponding
// source program lowers to SSA.

// Ported from SsaIrValidationTests.UndefinedSsaValueReferenceFailsBeforeLlvmEmission.
public unsafe fn bool UndefinedSsaValueReferenceFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# injects a `%missing + 1` add over an undefined value
    // reference and asserts STK5002 "value reference '%missing' not defined".
    // No source can name an undefined SSA value, so a well-typed add is lowered
    // and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-undefined-value-reference",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] missing)
{
    return missing + 1;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.UnsupportedSsaConversionFailsBeforeLlvmEmission.
public unsafe fn bool UnsupportedSsaConversionFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a convert rvalue from `ascii` to `unicode` and
    // asserts STK5002 "conversion from 'ascii' to 'unicode' not supported by SSA
    // LLVM emission". A source-level text conversion is lowered and reduced to
    // Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-unsupported-conversion",
        raw"""
module Demo

unsafe fn unicode Run()
{
    return unicode("hello");
}
""");
    return Succeeds(compiled);
}

