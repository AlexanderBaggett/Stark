import SsaTestSupport
import System.Testing
module CompilerCliTestsP1

// Ported from CompilerCliTests.EmitSsaModePrintsSsaModule.
// PORT-NOTE: the C# test drives `--emit-ssa` through the CLI and asserts on
// process stdout (exit code 0, the "ssa module Demo" CLI header line, and an
// empty stderr). The host test bridge has no CLI/stdout channel, so this is
// reduced to compiling the same program to SSA and asserting the rendered SSA
// text contains the structural fragments ("phi" and "branch") the CLI would
// print. The "ssa module Demo" header and empty-stderr checks cannot be
// expressed by the helpers and are dropped.
public unsafe fn bool EmitSsaModePrintsSsaModuleImpl()
{
    stack mut SsaCompile compiled = CompileSsa(
        "cli-emit-ssa-module",
        raw"""
module Demo

fn i32[min max] Run(bool left, bool right)
{
    return left && right ? 1 : 2;
}
""");
    return SsaContainsAll2(compiled, "phi", "branch");
}
