// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaRenderShowsFoldedLinearAndProductShapes.
public unsafe fn bool ArithmeticFoldSsaRenderShowsFoldedLinearAndProductShapesImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-render-shows-linear-and-product-shapes",
        raw"""
module Demo

fn i32[min max] Scale(i32[min max] value)
{
    return value + value + value;
}

fn i32[min max] Power(i32[min max] value)
{
    return value * value * value;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test renders the SsaIrModule and asserts the rendered text
    // contains "* 3" (folded linear shape) and "** 3" (folded product shape). The
    // ported `ssa` artifact text is the same rendered shape, so this maps directly.
    return SsaContains(c, "* 3") && SsaContains(c, "** 3");
}

// Ported from CompilerPipelineOptimizeSsaTests.CleanupSsaForwardsAggregateFieldThroughMatchingBranchPhi.
public unsafe fn bool CleanupSsaForwardsAggregateFieldThroughMatchingBranchPhiImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "cleanup-ssa-forwards-aggregate-field-through-matching-branch-phi",
        raw"""
module Demo

struct Pair
{
    i32[min max] Value;
    i32[min max] Tag;
}

fn i32[min max] Run(bool flag, i32[min max] value)
{
    stack Pair pair = flag
        ? new Pair()
        {
            Value = value, Tag = 1
        }
        : new Pair()
        {
            Value = value, Tag = 2
        };
    return pair.Value;
}
""");
    // PORT-NOTE: The C# test stops after cleanup-ssa and asserts Run holds no
    // SsaExtractFieldRValue whose FieldName is "Value" (the field read was forwarded
    // through the matching branch phi). The extract-field object model is not
    // reachable through the artifact-text bridge, so this is reduced to optimized
    // SSA text: no `extract-field` / `.Value` read survives.
    if (!Succeeds(c))
    {
        return false;
    }

    return OptimizedSsaLacks(c, "extract-field") && OptimizedSsaLacks(c, ".Value");
}

// Ported from CompilerPipelineOptimizeSsaTests.OptimizeSsaRemovesStaticRangeModuloAndDivisionIdentities.
public unsafe fn bool OptimizeSsaRemovesStaticRangeModuloAndDivisionIdentitiesImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "optimize-ssa-removes-static-range-modulo-and-division-identities",
        raw"""
module Demo

fn i32[min max] Run(u8[0 7] slot)
{
    stack u8[0 max] modulo = slot % (u8[0 max])8;
    stack u8[0 max] divided = slot / (u8[0 max])8;
    return modulo + divided;
}
""");
    // PORT-NOTE: The C# test stops after optimize-ssa and asserts Run holds no
    // SsaBinaryRValue with operator Divide or Modulo (the static-range slot makes
    // both identities, slot % 8 == slot and slot / 8 == 0). The binary object model
    // is not reachable through the artifact-text bridge, so this is reduced to
    // optimized-SSA text: neither a divide (`/ 8`) nor a modulo (`% 8`) survives.
    if (!Succeeds(c))
    {
        return false;
    }

    return OptimizedSsaLacks(c, "/ 8") && OptimizedSsaLacks(c, "% 8");
}

// Ported from CompilerPipelineOptimizeSsaTests.CleanupSsaRemovesSameOperandDivisionAndModuloWhenSourceRangeExcludesZero.
public unsafe fn bool CleanupSsaRemovesSameOperandDivisionAndModuloWhenSourceRangeExcludesZeroImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "cleanup-ssa-removes-same-operand-division-and-modulo-when-source-range-excludes-zero",
        raw"""
module Demo

fn i32[min max] Run(u8[1 100] value)
{
    stack u8[0 max] divided = value / value;
    stack u8[0 max] modulo = value % value;
    return divided + modulo;
}
""");
    // PORT-NOTE: The C# test stops after cleanup-ssa and asserts Run holds no
    // SsaBinaryRValue with operator Divide or Modulo (value / value == 1 and
    // value % value == 0 once the [1 100] range proves value is non-zero). The
    // binary object model is not reachable through the artifact-text bridge, so
    // this is reduced to optimized-SSA text: neither a same-operand divide
    // (`value / value`) nor modulo (`value % value`) survives.
    if (!Succeeds(c))
    {
        return false;
    }

    return OptimizedSsaLacks(c, "value / value") && OptimizedSsaLacks(c, "value % value");
}
