// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaFoldsWrappingSubtractRunsWithWrappingMultiply.
public unsafe fn bool ArithmeticFoldSsaFoldsWrappingSubtractRunsWithWrappingMultiplyImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-folds-wrapping-subtract-runs-with-wrapping-multiply",
        raw"""
module Demo

fn i8[min max] Run(i8[min max] x, i8[min max] y)
{
    return x +% x -% y -% y;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts a WrappingMultiply with coefficient 2 and a
    // surviving WrappingSubtract are present. Reduced to post-fold `ssa` text: a
    // wrapping-multiply-by-2 (`*% 2`) and a wrapping subtract (`-%`) are present.
    return SsaContains(c, "*% 2") && SsaContains(c, "-%");
}

// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaDoesNotRewriteSaturatingAddChains.
public unsafe fn bool ArithmeticFoldSsaDoesNotRewriteSaturatingAddChainsImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-does-not-rewrite-saturating-add-chains",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return value +| value +| value;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts the SaturatingAdd chain survives and no
    // Multiply is produced (saturating arithmetic is not linear). Reduced to
    // post-fold `ssa` text: a saturating add (`+|`) is present and no Multiply-by-3
    // (`* 3`) appears.
    return SsaContainsButNot(c, "+|", "* 3");
}

