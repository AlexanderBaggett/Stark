// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaDoesNotCombineUnsafeConstantCoefficientTerms.
public unsafe fn bool ArithmeticFoldSsaDoesNotCombineUnsafeConstantCoefficientTermsImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-does-not-combine-unsafe-constant-coefficients",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] x)
{
    return (x * 2) + (x * 3) - x;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts Run holds no Multiply with combined coefficient
    // 4 (unbounded i32 makes the reassociation overflow-unsafe). Reduced to
    // post-fold `ssa` text: no Multiply-by-4 (`* 4`) appears.
    if (!Succeeds(c))
    {
        return false;
    }

    return OptimizedSsaLacks(c, "* 4");
}

// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaRecognizesSafeLeftShiftCoefficients.
public unsafe fn bool ArithmeticFoldSsaRecognizesSafeLeftShiftCoefficientsImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-recognizes-safe-left-shift-coefficients",
        raw"""
module Demo

fn u16[min max] Run(u16[0 1000] x)
{
    return (x << 1) + x + x;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts the `(x << 1)` is treated as a coefficient-2
    // term and folds with the two unit terms into a single Multiply with
    // coefficient 4. Reduced to post-fold `ssa` text: a Multiply-by-4 (`* 4`) is
    // present.
    return SsaContains(c, "* 4");
}

