module Demo

fn i16[min max] Run(i16[-1000 1000] x)
{
    return (x * 2) + (x * 3) - x;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts Run holds a single Multiply with combined
