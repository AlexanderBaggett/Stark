    return SsaContains(c, "* 6");
}

// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaPreservesTrailingConstantsAfterRepeatedAddRun.
public unsafe fn bool ArithmeticFoldSsaPreservesTrailingConstantsAfterRepeatedAddRunImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-preserves-trailing-constant",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return value + value + value + 5;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts Run holds a Multiply with coefficient 3 and an
    // Add with right operand constant 5. Reduced to post-fold `ssa` text: the
    // folded Multiply-by-3 (`* 3`) and the preserved trailing add (`+ 5`) are both
    // present.
    return SsaContains(c, "* 3") && SsaContains(c, "+ 5");
}

// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaFoldsMultipleContiguousRepeatedTerms.
public unsafe fn bool ArithmeticFoldSsaFoldsMultipleContiguousRepeatedTermsImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-multiple-contiguous-repeated-terms",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] x, i32[min max] y)
{
    return x + x + y + y + y + 4;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts the sorted Multiply coefficients are exactly
    // [2, 3]. Reduced to post-fold `ssa` text: both a Multiply-by-2 (`* 2`) and a
    // Multiply-by-3 (`* 3`) are present.
    return SsaContains(c, "* 2") && SsaContains(c, "* 3");
}

