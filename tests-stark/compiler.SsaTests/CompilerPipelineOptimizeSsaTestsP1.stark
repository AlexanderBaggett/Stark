import SsaTestSupport
import System.Testing
module CompilerPipelineOptimizeSsaTestsP1

// Ported slice of tests/compiler.PipelineTests/CompilerPipelineOptimizeSsaTests.cs.
// The C# oracle asserts on the pipeline's SsaIrModule / OptimizedSsaIr object
// model (AddressTakenFunctions sets, SsaBinaryRValue operators and coefficients,
// phi incomings, store/extract instructions, executed-pass ordering). The
// source-in / artifact-text-out host bridge used by these ported facts can only
// observe the rendered `ssa` / `optimized-ssa` artifact text, so structural
// object-model facts are reduced to the strongest equivalent text fragments and
// flagged with `// PORT-NOTE:`. Rendered SSA prints each value instruction as
// `<result> = <rvalue-text>`, with binary operators in symbol form
// (`+`, `-`, `*`, `**`, `+%`, `-%`, `*%`, `**%`, `<<`, `&`, `/`, `%`, `+|`, `-|`,
// `*|`) and integer constants printed bare, so e.g. a Multiply-by-3 renders as
// `... * 3` and an Exponent-of-3 as `... ** 3`.

// Ported from CompilerPipelineOptimizeSsaTests.CallableAddressTakenFactsArePrunedAfterDirectCallDevirtualization.
public unsafe fn bool CallableAddressTakenFactsArePrunedAfterDirectCallDevirtualizationImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "optimize-ssa-callable-address-taken-pruned",
        raw"""
module Demo

noinline finite law i32[min max] Target()
{
    return 1;
}

unsafe fn i32[min max] Run()
{
    stack fnptr<fn i32[min max]()> op = Target;
    return op();
}
""");
    // PORT-NOTE: The C# test asserts the staged AddressTakenFunctions sets across
    // type-model/HIR/MIR/SSA still name "Target" while the optimized-SSA and LLVM
    // sets are empty, that Run holds a single direct SsaCallRValue to "Target" with
    // no SsaIndirectCallRValue, and that devirt-ssa executes before inline-ssa.
    // None of those object-model / pass-ordering facts are reachable through the
    // artifact-text bridge, so the devirtualization signal is reduced to optimized
    // SSA text: a direct call to Target is present and no indirect `call.indirect`
    // survives.
    return OptimizedSsaContainsButNot(c, "Target(", "call.indirect");
}

// Ported from CompilerPipelineOptimizeSsaTests.NonCapturingLambdaAddressTakenFactsArePrunedAfterDirectCallDevirtualization.
public unsafe fn bool NonCapturingLambdaAddressTakenFactsArePrunedAfterDirectCallDevirtualizationImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "optimize-ssa-noncapturing-lambda-address-taken-pruned",
        raw"""
module Demo

unsafe fn i32[min max] Run()
{
    stack fnptr<fn i32[min max](i32[min max])> increment =
        (i32[min max] value) => value + 1;
    return increment(41);
}
""");
    // PORT-NOTE: The C# test asserts the lambda's address-taken fact survives
    // through HIR/MIR/SSA and is pruned in optimized-SSA/LLVM, that Run holds no
    // direct or indirect call to the lambda, and that the folded result is the
    // constant 42. The address-taken set and call object model are unreachable
    // through the artifact-text bridge, so this is reduced to optimized-SSA text:
    // the folded `return 42` is present and no `call.indirect` survives.
    return OptimizedSsaContainsButNot(c, "return 42", "call.indirect");
}

// Ported from CompilerPipelineOptimizeSsaTests.InlineSsaPreservesSuccessorPhiIncomingFromSplitContinuationBlocks.
public unsafe fn bool InlineSsaPreservesSuccessorPhiIncomingFromSplitContinuationBlocksImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "inline-ssa-successor-phi-split-continuation",
        raw"""
module Demo

enum Status
{
    Ok,
    Err
}

inline fn bool IsOk(Status status)
{
    switch (status)
    {
        case Status.Ok: return true;
        case Status.Err: return false;
    }
}

noinline fn Status Op(u8[0 3] value)
{
    if (value == 3)
    {
        return Status.Err;
    }

    return Status.Ok;
}

unsafe fn i32[min max] Run(u8[0 3] value)
{
    if (!IsOk(Op(0)) || !IsOk(Op(1)) || !IsOk(Op(2)) || !IsOk(Op(value)))
    {
        return 3;
    }

    return 0;
}
""",
        "inline-ssa");
    // PORT-NOTE: The C# test stops after inline-ssa and asserts on the OptimizedSsaIr
    // object model: a `return 0` terminator survives, a single join phi whose
    // variable name contains "_or" exists, and one of that phi's incomings refers to
    // a value defined by a `LogicalNot` unary in a predecessor block whose label
    // contains "continue". The phi/incoming/predecessor-label structure is not
    // reachable through the artifact-text bridge, so this is reduced to a
    // post-inline `ssa`-text snapshot: the `_or` short-circuit join phi is still
    // present, a `continue` continuation block label survives, and the `return 0`
    // path is preserved.
    return SsaContainsAll3(c, "_or", "continue", "return 0");
}

// Ported from CompilerPipelineOptimizeSsaTests.OptimizeSsaPreservesMaterializedGenericCallSymbols.
public unsafe fn bool OptimizeSsaPreservesMaterializedGenericCallSymbolsImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "optimize-ssa-materialized-generic-call-symbol",
        raw"""
module Demo

fn T Identity<T>(T value)
{
    return value;
}

fn i32[min max] Run(i32[min max] value)
{
    return Identity(value);
}
""");
    // PORT-NOTE: The C# test stops after devirt-ssa and asserts Run holds a single
    // SsaCallRValue whose FunctionName is the materialized monomorphization symbol
    // "__stark_mono_fn_Demo__Identity__i32". The call object model is not reachable
    // through the artifact-text bridge, so this is reduced to optimized-SSA text:
    // the materialized monomorphization symbol is present.
    return OptimizedSsaContains(c, "__stark_mono_fn_Demo__Identity__i32");
}

// Ported from CompilerPipelineOptimizeSsaTests.OptimizeSsaDevirtualizesIdenticalFunctionPointerPhiTargets.
public unsafe fn bool OptimizeSsaDevirtualizesIdenticalFunctionPointerPhiTargetsImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "optimize-ssa-devirtualizes-identical-fnptr-phi",
        raw"""
module Demo

noinline finite law i32[min max] Target(i32[min max] value)
{
    return value + 1;
}

fn i32[min max] Run(bool flag, i32[min max] value)
{
    stack mut fnptr<fn i32[min max](i32[min max])> op = Target;
    if (flag)
    {
        op = Target;
    }
    else
    {
        op = Target;
    }

    return op(value);
}
""");
    // PORT-NOTE: The C# test stops after devirt-ssa and asserts Run holds a single
    // direct SsaCallRValue to "Target", AddressTakenFunctions is empty, and no
    // SsaIndirectCallRValue survives. The call object model and address-taken set
    // are not reachable through the artifact-text bridge, so this is reduced to
    // optimized-SSA text: a direct call to Target is present and no `call.indirect`
    // survives.
    return OptimizedSsaContainsButNot(c, "Target(", "call.indirect");
}

// Ported from CompilerPipelineOptimizeSsaTests.OptimizeSsaKeepsMixedFunctionPointerPhiTargetsIndirect.
public unsafe fn bool OptimizeSsaKeepsMixedFunctionPointerPhiTargetsIndirectImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "optimize-ssa-keeps-mixed-fnptr-phi-indirect",
        raw"""
module Demo

finite law i32[min max] Target(i32[min max] value)
{
    return value + 1;
}

finite law i32[min max] Other(i32[min max] value)
{
    return value - 1;
}

fn i32[min max] Run(bool flag, i32[min max] value)
{
    stack mut fnptr<fn i32[min max](i32[min max])> op = Target;
    if (flag)
    {
        op = Target;
    }
    else
    {
        op = Other;
    }

    return op(value);
}
""");
    // PORT-NOTE: The C# test stops after optimize-ssa and asserts AddressTakenFunctions
    // is exactly {Other, Target}, Run holds a single SsaIndirectCallRValue whose
    // target is a phi result, and no direct SsaCallRValue to "Target"/"Other"
    // survives. The address-taken set, indirect-call target, and phi membership are
    // not reachable through the artifact-text bridge, so this is reduced to
    // optimized-SSA text: an indirect call survives and both address-taken targets
    // are still referenced.
    if (!OptimizedSsaContains(c, "call.indirect"))
    {
        return false;
    }

    return OptimizedSsaContains(c, "Target") && OptimizedSsaContains(c, "Other");
}

// Ported from CompilerPipelineOptimizeSsaTests.CleanupSsaRemovesSourceLevelIntegerAlgebraicIdentities.
public unsafe fn bool CleanupSsaRemovesSourceLevelIntegerAlgebraicIdentitiesImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "cleanup-ssa-removes-source-level-integer-identities",
        raw"""
module Demo

fn i64[min max] Run(i64[min max] value)
{
    stack i64[min max] add = value + 0;
    stack i64[min max] multiply = add * 1;
    stack i64[min max] masked = multiply & -1;
    stack i64[min max] shifted = masked << 0;
    stack i64[min max] divided = shifted / 1;
    stack i64[min max] rightShifted = divided >> 0;
    return rightShifted ^ 0;
}
""");
    // PORT-NOTE: The C# test stops after cleanup-ssa and asserts Run holds no
    // SsaBinaryRValue with operator Add/Multiply/BitwiseAnd/ShiftLeft/Divide/
    // ShiftRight/BitwiseXor (every algebraic-identity binary was removed). The
    // binary object model is not reachable through the artifact-text bridge, so
    // this is reduced to optimized-SSA text: with all identities removed the body
    // forwards the parameter, so each operand-by-constant identity literal
    // (`* 1`, `& -1`, `<< 0`, `/ 1`, `>> 0`, `^ 0`, `+ 0`) is absent.
    if (!Succeeds(c))
    {
        return false;
    }

    return OptimizedSsaLacks(c, "* 1")
        && OptimizedSsaLacks(c, "& -1")
        && OptimizedSsaLacks(c, "<< 0")
        && OptimizedSsaLacks(c, "/ 1")
        && OptimizedSsaLacks(c, ">> 0")
        && OptimizedSsaLacks(c, "^ 0")
        && OptimizedSsaLacks(c, "+ 0");
}

// Ported from CompilerPipelineOptimizeSsaTests.CleanupSsaRemovesIntegerAlgebraicAbsorbingAndSameOperandIdentities.
public unsafe fn bool CleanupSsaRemovesIntegerAlgebraicAbsorbingAndSameOperandIdentitiesImpl()
{
    stack mut SsaCompile c = CompileOptimizedSsa(
        "cleanup-ssa-removes-absorbing-and-same-operand-identities",
        raw"""
module Demo

fn i64[min max] Run(i64[min max] value)
{
    stack i64[min max] sameAnd = value & value;
    stack i64[min max] sameOr = sameAnd | sameAnd;
    stack i64[min max] zeroXor = sameOr ^ sameOr;
    stack i64[min max] zeroAnd = value & 0;
    stack i64[min max] zeroMultiply = value * 0;
    stack i64[min max] zeroSubtract = value - value;
    stack i64[min max] zeroModulo = value % 1;
    stack i64[min max] allOnes = value | -1;
    return zeroXor + zeroAnd + zeroMultiply + zeroSubtract + zeroModulo + (allOnes & 1);
}
""");
    // PORT-NOTE: The C# test stops after cleanup-ssa and asserts Run holds no
    // SsaBinaryRValue with operator Subtract/Modulo/Multiply/BitwiseAnd/BitwiseOr/
    // BitwiseXor, and that the single block's terminator folds to the constant 1.
    // The binary object model and terminator constant are not reachable as objects
    // through the artifact-text bridge, so this is reduced to optimized-SSA text:
    // the body folds to `return 1` with no surviving absorbing/same-operand binary
    // literals.
    if (!Succeeds(c))
    {
        return false;
    }

    return OptimizedSsaContains(c, "return 1")
        && OptimizedSsaLacks(c, "* 0")
        && OptimizedSsaLacks(c, "& 0")
        && OptimizedSsaLacks(c, "% 1")
        && OptimizedSsaLacks(c, "| -1");
}

// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaFoldsRepeatedUnknownAddsToMultiply.
public unsafe fn bool ArithmeticFoldSsaFoldsRepeatedUnknownAddsToMultiplyImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-repeated-unknown-adds-to-multiply",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return value + value + value;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test (CompileRunAfterArithmeticFold) asserts Run holds a
    // Multiply SsaBinaryRValue with right operand constant 3 and no Add binary. The
    // binary object model is not reachable, so this is reduced to post-fold `ssa`
    // text: a Multiply-by-3 (`* 3`) is present and no ordinary add (`+ value`)
    // survives.
    return SsaContains(c, "* 3") && OptimizedSsaLacks(c, "+ value");
}

