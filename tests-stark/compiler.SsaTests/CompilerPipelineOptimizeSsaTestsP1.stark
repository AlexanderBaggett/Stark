    // (`-|`) is present and no Multiply-by-2 (`* 2`) appears.
    return SsaContainsButNot(c, "-|", "* 2");
}

// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaFoldsRepeatedMultiplicationRunToExponent.
public unsafe fn bool ArithmeticFoldSsaFoldsRepeatedMultiplicationRunToExponentImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-folds-repeated-multiplication-run-to-exponent",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return value * value * value * value;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts Run holds a single Exponent with exponent 4 and
    // no Multiply binary. Reduced to post-fold `ssa` text: an exponent-of-4
    // (`** 4`) is present and no ordinary multiply (`* value`) survives.
    return SsaContains(c, "** 4") && OptimizedSsaLacks(c, "* value");
}

// Ported from CompilerPipelineOptimizeSsaTests.ArithmeticFoldSsaGroupsIndependentRepeatedProductFactors.
public unsafe fn bool ArithmeticFoldSsaGroupsIndependentRepeatedProductFactorsImpl()
{
    stack mut SsaCompile c = CompileSsaAfter(
        "arithmetic-fold-ssa-groups-independent-repeated-product-factors",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] x, i32[min max] y)
{
    return x * x * y * y * y;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts the sorted Exponent exponents are exactly
    // [2, 3] and that a Multiply combining the two grouped factors survives.
    // Reduced to post-fold `ssa` text: an exponent-of-2 (`** 2`), an exponent-of-3
    // (`** 3`), and a multiply (`*`) are present.
    return SsaContains(c, "** 2") && SsaContains(c, "** 3") && SsaContains(c, " * ");
}

