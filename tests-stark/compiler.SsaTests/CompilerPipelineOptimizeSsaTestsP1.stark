        "arithmetic-fold-ssa-keeps-separated-product-factors-source-shaped",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] x, i32[min max] y)
{
    return x * y * x;
}
""",
        "arithmetic-fold-ssa");
    // PORT-NOTE: The C# test asserts no Exponent is produced (the two x factors are
    // separated by y so the product is left source-shaped). Reduced to post-fold
