// Ported from SsaIrValidationTests.SystemRuntimeByteSlicePartsMutableMismatchFailsBeforeLlvmEmission.
public unsafe fn bool SystemRuntimeByteSlicePartsMutableMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# injects a System.Runtime type model whose
    // GetMutableByteSliceParts builtin returns a mutable-data parts struct from an
    // immutably-borrowed source and asserts STK5002 "System.Runtime byte slice
    // parts builtin 'GetMutableByteSliceParts'"/"mut borrow i8[]". The helpers
    // cannot inject a System.Runtime type model; reduced to a plausible parts
    // builtin over a mutably-borrowed byte slice, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-system-runtime-byte-slice-parts-mutable-mismatch",
        raw"""
module Demo

struct MutableByteSliceParts
{
    *u8[0 max] Data;
    u64[0 max] Length;
}

unsafe fn MutableByteSliceParts GetMutableByteSliceParts(mut borrow u8[0 max][] source)
{
    stack mut MutableByteSliceParts parts = default;
    parts.Length = 0;
    return parts;
}
""");
    return Succeeds(compiled);
