// Ported from SsaIrValidationTests.StoreToImmutableGlobalFailsBeforeLlvmEmission.
public unsafe fn bool StoreToImmutableGlobalFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# stores into the const global "Limit" and asserts STK5002
    // "global store target 'Limit'"/"must be mutable"/"Const". A store to a const
    // global is rejected before lowering in valid source; reduced to storing into
    // a `static mut` global, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-store-to-immutable-global",
        raw"""
module Demo

static mut i32[min max] Limit = 0;

unsafe fn void Run()
{
    Limit = 1;
    return;
}
""");
    return Succeeds(compiled);
}

