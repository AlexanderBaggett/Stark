public unsafe fn bool ScopedNoAliasProofCarrierDuplicateRootsFailBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# gives the scoped-noalias group duplicate roots
    // (param:left, param:left) and asserts STK5002 "contains blank or duplicate
    // memory roots". The helpers cannot attach a scoped-noalias group with
    // duplicate roots; reduced to a well-formed disjoint store over two distinct
    // pointer parameters, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-scoped-noalias-duplicate-roots",
        raw"""
module Demo

unsafe fn void Run(mut *i32[min max] left, mut *i32[min max] right)
{
    if disjoint(left, right)
    {
        *left = 1;
    }

    return;
}
""");
    return Succeeds(compiled);
}

