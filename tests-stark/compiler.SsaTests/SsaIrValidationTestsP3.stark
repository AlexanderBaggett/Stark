        raw"""
module Demo

fn i32[min max] PopCount(i32[min max] value)
{
    return value;
}

fn i32[min max] Run()
{
    return PopCount(1);
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.SystemMemoryBuiltinInvalidAllocationShapeFailsBeforeLlvmEmission.
public unsafe fn bool SystemMemoryBuiltinInvalidAllocationShapeFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# injects a System.Memory type model whose Allocation struct
    // lacks the required Allocator field and asserts STK5002 "System.Memory
    // Allocation"/"Pointer, ByteLength, Alignment, and Allocator fields". The
    // helpers cannot inject a System.Memory type model with a malformed Allocation
    // struct; reduced to a plausible Allocator/Allocation struct pair carrying all
    // four required fields, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-system-memory-builtin-invalid-allocation-shape",
        raw"""
module Demo

struct Allocator
{
    u8[0 max] Kind;
}

struct Allocation
{
    *u8[0 max] Pointer;
    u64[0 max] ByteLength;
    u64[0 max] Alignment;
    Allocator Allocator;
}

unsafe fn u64[0 max] Run(Allocation allocation)
{
    return allocation.ByteLength;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.SystemCollectionsDictionaryKeyAsciiKeyPassesBuiltinValidation.
public unsafe fn bool SystemCollectionsDictionaryKeyAsciiKeyPassesBuiltinValidationImpl()
{
    // PORT-NOTE: C# injects a System.Collections type model whose monomorphized
    // DictionaryKey.Hash builtin takes a borrowed `ascii` key and asserts no
    // STK5002 "System.Collections DictionaryKey builtin" diagnostic is produced
    // (ascii is a supported key type). The helpers cannot inject a
    // System.Collections type model; reduced to a plausible hash-of-ascii helper,
    // asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-system-collections-dictionary-key-ascii",
        raw"""
module Demo

fn u64[0 max] Hash(borrow ascii value)
{
    return 0;
}

fn u64[0 max] Run()
{
    stack ascii key = "demo";
    return Hash(key);
}
""");
    return Succeeds(compiled);
}

