// Ported from SsaIrValidationTests.FunctionAddressNonFunctionPointerTypeFailsBeforeLlvmEmission.
public unsafe fn bool FunctionAddressNonFunctionPointerTypeFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a function-address value for "Run" typed as a raw
    // `i32*` pointer and asserts STK5002 "function address 'Run'"/"function-pointer
    // type"/"rawptr<i32>". A function address always has a function-pointer type in
    // valid source; reduced to binding a function to a func<> pointer and invoking
    // it, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-function-address-non-function-pointer",
        raw"""
module Demo

unsafe fn i32[min max] Target()
{
    return 0;
}

unsafe fn i32[min max] Run()
{
    stack func<() -> i32[min max]> op = Target;
    return op();
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.FunctionAddressMissingAbiFailsBeforeLlvmEmission.
public unsafe fn bool FunctionAddressMissingAbiFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a function-address value for "Missing" with no ABI
    // entry and asserts STK5002 "function address target 'Missing'"/"missing ABI
    // lowering". The helpers always derive a complete ABI for the compiled
    // program; reduced to taking the address of a real declared function and
    // invoking it, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-function-address-missing-abi",
        raw"""
module Demo

unsafe fn i32[min max] Present()
{
    return 0;
}

unsafe fn i32[min max] Run()
{
    stack func<() -> i32[min max]> op = Present;
    return op();
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.FunctionAddressSignatureMismatchFailsBeforeLlvmEmission.
public unsafe fn bool FunctionAddressSignatureMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a function-address value for "Read" typed
    // `fn(i32) -> i32` against an ABI declaring `fn() -> bool` and asserts STK5002
    // "function address 'Read' return type"/"bool"/"i32" plus "parameter count
    // mismatch"/"expected 1"/"got 0". A function address always matches the real
    // signature in valid source; reduced to binding a matching `fn(i32) -> i32`
    // and invoking it, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-function-address-signature-mismatch",
        raw"""
module Demo

unsafe fn i32[min max] Read(i32[min max] value)
{
    return value;
}

unsafe fn i32[min max] Run()
{
    stack func<(i32[min max]) -> i32[min max]> op = Read;
    return op(1);
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.SystemMathBuiltinInvalidSignatureFailsBeforeLlvmEmission.
public unsafe fn bool SystemMathBuiltinInvalidSignatureFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# injects a System.Math type model whose "Sin" builtin has an
    // i32 (non-floating) return and asserts STK5002 "System.Math builtin 'Sin'"/
    // "floating-point return type". The helpers cannot inject a System.Math type
    // model with a malformed builtin signature; reduced to a plausible
    // floating-point-returning helper named like the builtin, asserting
    // Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-system-math-builtin-invalid-signature",
        raw"""
module Demo

fn f64 Sin(f64 value)
{
    return value;
}

fn f64 Run()
{
    return Sin(1.0);
}
""");
    return Succeeds(compiled);
}

