// Ported from SsaIrValidationTests.ValidSystemBuiltinSignaturesPassSsaValidation.
public unsafe fn bool ValidSystemBuiltinSignaturesPassSsaValidationImpl()
{
    // PORT-NOTE: C# asserts Empty(diagnostics) for a System.BitOperations type
    // model whose "RotateLeft" builtin has a valid u64 signature. The helpers
    // cannot inject a System.BitOperations type model; reduced to a plausible u64
    // RotateLeft helper, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-valid-system-builtin-signatures",
        raw"""
module Demo

fn u64[0 max] RotateLeft(u64[0 max] value, u64[0 max] amount)
{
    return value;
}

fn u64[0 max] Run()
{
    return RotateLeft(1, 1);
}
""");
    return Succeeds(compiled);
}
