// Ported from SsaIrValidationTests.ScopedNoAliasProofCarrierUnknownParameterRootFailsBeforeLlvmEmission.
public unsafe fn bool ScopedNoAliasProofCarrierUnknownParameterRootFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# gives an unsafe-assume-disjoint group a root key
    // (param:missing) that is not a real parameter and asserts STK5002 "unknown
    // parameter memory-root key 'param:missing'". The helpers cannot attach a
    // scoped-noalias group referencing a missing parameter; reduced to a
    // disjoint store whose roots are both real pointer parameters, asserting
    // Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-scoped-noalias-unknown-parameter-root",
        raw"""
module Demo

unsafe fn void Run(mut *i32[min max] left, mut *i32[min max] right)
{
    if disjoint(left, right)
    {
        *left = 1;
    }

    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.StringConstantNonTextTypeFailsBeforeLlvmEmission.
public unsafe fn bool StringConstantNonTextTypeFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a string constant typed as `i32` and asserts STK5002
    // "string constant"/"ascii/unicode"/"i32". A string literal cannot be typed as
    // a non-text type in valid source; reduced to a string constant of its natural
    // ascii text type, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-string-constant-non-text-type",
        raw"""
module Demo

unsafe fn ascii Run()
{
    return "hello";
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.TextDataAddressPointeeMismatchFailsBeforeLlvmEmission.
public unsafe fn bool TextDataAddressPointeeMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a text-data-address value whose result pointee is `i32`
    // where ascii text data is `i8` and asserts STK5002 "text data address result
    // pointee"/"i32"/"i8". A text data address always lowers to an i8 pointer in
    // valid source; reduced to reading the data pointer of an ascii literal,
    // asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-text-data-address-pointee-mismatch",
        raw"""
module Demo

unsafe fn *u8[0 max] Run()
{
    stack ascii text = "hello";
    return text.data;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.GlobalAddressPointeeMismatchFailsBeforeLlvmEmission.
public unsafe fn bool GlobalAddressPointeeMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# builds a global-address value for a `bool` global but with an
    // `i32*` result pointer and asserts STK5002 "global address result
    // pointee"/"i32"/"bool". A global address pointee always matches the global's
    // type in valid source; reduced to taking the address of a static bool global
    // through a matching bool pointer, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-global-address-pointee-mismatch",
        raw"""
module Demo

static mut bool flag = false;

unsafe fn *bool Run()
{
    return &flag;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.UnknownGlobalLoadFailsBeforeLlvmEmission.
public unsafe fn bool UnknownGlobalLoadFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# loads a global named "Missing" not present in the type model
    // and asserts STK5002 "global load"/"unknown global 'Missing'". A load of an
    // undeclared global is unresolvable in valid source; reduced to loading a
    // real declared global, asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-unknown-global-load",
        raw"""
module Demo

static i32[min max] Present = 1;

unsafe fn i32[min max] Run()
{
    return Present;
}
""");
    return Succeeds(compiled);
}

