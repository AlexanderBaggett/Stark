    // PORT-NOTE: original hand-builds an SsaIrModule that allocates `new(4)`,
    // initializes Length to 2, calls MoveLast(), and reloads Length, asserting the
    // analyzer tracks the length commit from [2,2] down to [1,1] (capacity [4,4],
    // spare [3,3], owner "items", backing id "allocated"). There is no embedded
    // Stark source; a plausible equivalent that fills two elements and removes the
    // last is reconstructed here. The structured length/region facts are not
    // reachable through the text bridge, so this is reduced to a successful raw-SSA
    // compile.
    stack mut SsaCompile compiled = CompileSsa(
        "ssaopt-p2-dynamic-storage-movelast-length",
        raw"""
module Demo

fn u64[0 max] Run()
{
    stack mut i32[min max]~ items = new i32[min max]~(4);
    items.Add(10);
    items.Add(20);
    items.MoveLast();
    return items.Length;
}
""");
    return Succeeds(compiled);
}

