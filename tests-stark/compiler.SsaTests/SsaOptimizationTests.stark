// Ported from SsaOptimizationTests.CleanupRemovesIdentityPhiNodes.
internal fn bool CleanupRemovesIdentityPhiNodesImpl()
{
    // PORT-NOTE: original hand-builds a join phi whose two incomings are both the
    // constant 5 and asserts cleanup drops the phi and folds the return to the
    // constant 5; reconstructed as a diamond that yields the same value on both
    // arms and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-identity-phi",
        raw"""
module Demo

fn i32[min max] Run(bool flag)
{
    stack mut i32[min max] value = 5;
    if (flag)
    {
        value = 5;
    }
    else
    {
        value = 5;
    }

    return value;
}
""",
        "cleanup-ssa");
    return SsaContains(compiled, "5");
}

// Ported from SsaOptimizationTests.CleanupReusesIdenticalMaterializedConstantConversions.
internal fn bool CleanupReusesIdenticalMaterializedConstantConversionsImpl()
{
    // PORT-NOTE: original hand-builds two identical `cast(1)` i8->i32 conversions
    // and an add of their results, asserting cleanup keeps a single convert and the
    // add's operands share the same name; reconstructed as two identical
    // conversions summed together and reduced to a successful compile through
    // cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-reuse-const-conversions",
        raw"""
module Demo

fn i32[min max] Run()
{
    stack i8 raw = 1;
    stack i32[min max] v0 = (i32[min max])raw;
    stack i32[min max] v1 = (i32[min max])raw;
    return v0 + v1;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.CleanupCanonicalizesEquivalentCommutativeExpressions.
internal fn bool CleanupCanonicalizesEquivalentCommutativeExpressionsImpl()
{
    // PORT-NOTE: original hand-builds `left + right` and `right + left` then adds
    // the two results, asserting cleanup canonicalizes the commutative pair so the
    // final add's two operands share the same name; reconstructed as the mirrored
    // commutative pair summed together and reduced to a successful compile through
    // cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-canonicalize-commutative",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    stack i32[min max] v0 = left + right;
    stack i32[min max] v1 = right + left;
    return v0 + v1;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.CleanupRemovesRedundantSameTypeConversions.
internal fn bool CleanupRemovesRedundantSameTypeConversionsImpl()
{
    // PORT-NOTE: original hand-builds an i32->i32 self conversion `(i32)value`
    // feeding `+ 1` and asserts cleanup drops the conversion so the add reads
    // `arg_value` directly; reconstructed as a same-type cast feeding an add and
    // reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-redundant-same-type-conversion",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    stack i32[min max] widened = (i32[min max])value;
    return widened + 1;
}
""",
        "cleanup-ssa");
    return SsaContains(compiled, "arg_value");
}

// Ported from SsaOptimizationTests.CleanupCoalescesEquivalentPhiNodes.
internal fn bool CleanupCoalescesEquivalentPhiNodesImpl()
{
    // PORT-NOTE: original hand-builds two phis with identical incomings (5/7) fed
    // into an add, asserting cleanup coalesces them to a single phi whose value is
    // used twice by the add; reconstructed as a diamond producing one joined value
    // added to itself and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-coalesce-equivalent-phis",
        raw"""
module Demo

fn i32[min max] Run(bool flag)
{
    stack mut i32[min max] left = 5;
    stack mut i32[min max] right = 5;
    if (flag)
    {
        left = 5;
        right = 5;
    }
    else
    {
        left = 7;
        right = 7;
    }

    return left + right;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

