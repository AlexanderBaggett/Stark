    // into left.Value (an exact field copy reading the sibling), then stores 7
    // into right.Other, and asserts the pending sibling store survives the copy
    // (a single surviving SsaStoreIndirectInstruction targeting right_other_address
    // with constant 7, plus the surviving SsaCopyMemoryInstruction); the text
    // bridge cannot enumerate the typed store/copy lists, so this is reduced to a
    // successful optimized compile of the verbatim exact-field-copy program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-keep-pending-sibling-field-stores-across-exact-copy",
        raw"""
module Demo

record Box(i32[min max] Value, i32[min max] Other)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Box left = new Box(0, 0);
    stack mut Box right = new Box(0, 0);
    right.Other = value;
    left.Value = right.Value;
    right.Other = 7;
    return 0;
}
""");
    return Succeeds(compiled);
}

