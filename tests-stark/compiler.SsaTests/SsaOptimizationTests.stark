// Ported slice (part 4) of SsaOptimizationTests.cs, the SsaScalarReplacementOptimizer
// "aggregate copy_memory" facts, running against the current C# host compiler
// through the host test protocol.
//
// PORT-NOTE (suite-wide): the four original C# tests do NOT compile an embedded
// Stark source string. They hand-build an SsaIrModule object model directly
// (SsaAllocateLocalInstruction "left"/"right", SsaAddressOfLocalRValue,
// SsaCopyMemoryInstruction(right_addr <- left_addr, aggregateType "Pair"), with a
// later SsaFieldAddressRValue/SsaLoadIndirectRValue, an SsaCallRValue escape, or
// SsaMemoryTransferKind.Move), run SsaScalarReplacementOptimizer().Optimize(...),
// then assert on the count of surviving SsaCopyMemoryInstruction in the single
// block (Assert.Empty for the dead removable copy, Assert.Single for the kept
// copies). The host source-in / rendered-artifact-text-out bridge cannot
// reconstruct that typed object model nor enumerate the surviving
// SsaCopyMemoryInstruction list, so each test is reduced to the closest Stark
// program that lowers to the same shape (an aggregate copy `right = left` between
// two stack `Pair` locals plus the distinguishing element) compiled through
// CompileOptimizedSsa, with the surviving-copy assertion reduced to the nearest
// text/Succeeds signal over the rendered optimized-ssa artifact. Per-method
// PORT-NOTE comments name what was reduced. The C# tests remain the oracle until
// cutover.

// Ported from SsaOptimizationTests.ScalarReplacementRemovesDeadAggregateCopiesToStackLocals.
internal fn bool ScalarReplacementRemovesDeadAggregateCopiesToStackLocalsImpl()
{
    // PORT-NOTE: original hand-builds two stack `Pair` locals, copies left into
    // right (copy_memory) with no later read of either, runs the scalar
    // replacement optimizer and asserts Assert.Empty over the surviving
    // SsaCopyMemoryInstruction list (the dead aggregate copy is removed). Reduced
    // to the closest Stark source (a dead `right = left` aggregate copy whose
    // result is never observed) compiled through the optimizer, with the
    // "no copy survives" assertion reduced to a text signal that no aggregate
    // copy_memory remains in the optimized SSA.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "ssaopt-p4-remove-dead-aggregate-copy",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run()
{
    stack mut Pair left = new Pair(0, 0);
    stack mut Pair right = new Pair(0, 0);
    right = left;
    return 0;
}
""");
    return Succeeds(compiled) && OptimizedSsaLacks(compiled, "copy_memory");
}

// Ported from SsaOptimizationTests.ScalarReplacementKeepsAggregateCopiesObservedByLaterFieldLoad.
internal fn bool ScalarReplacementKeepsAggregateCopiesObservedByLaterFieldLoadImpl()
{
    // PORT-NOTE: original hand-builds the same two stack `Pair` locals and
    // copy_memory(right <- left), then a field-address of right.Left and an
    // indirect load of it, runs the optimizer and asserts Assert.Single over the
    // surviving SsaCopyMemoryInstruction list (the copy is kept because a later
    // field load of `right.Left` observes the copied value). Reduced to the
    // closest Stark source (`right = left` followed by returning `right.Left`)
    // compiled through the optimizer; the "exactly one copy survives" assertion is
    // reduced to a successful compile plus a text signal that an aggregate
    // copy_memory remains in the optimized SSA.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "ssaopt-p4-keep-aggregate-copy-observed-field-load",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run()
{
    stack mut Pair left = new Pair(0, 0);
    stack mut Pair right = new Pair(0, 0);
    right = left;
    return right.Left;
}
""");
    return Succeeds(compiled) && OptimizedSsaContains(compiled, "copy_memory");
}

// Ported from SsaOptimizationTests.ScalarReplacementKeepsAggregateCopiesAfterDestinationAddressEscapes.
internal fn bool ScalarReplacementKeepsAggregateCopiesAfterDestinationAddressEscapesImpl()
{
    // PORT-NOTE: original hand-builds the same two stack `Pair` locals, first
    // calls Escape(&right) (SsaCallRValue passing right_addr) so the destination
    // address escapes, then copy_memory(right <- left), runs the optimizer and
    // asserts Assert.Single over the surviving SsaCopyMemoryInstruction list (the
    // copy is kept conservatively because the destination address escaped).
    // Reduced to the closest Stark source (pass &right to an escaping call before
    // `right = left`) compiled through the optimizer; the "exactly one copy
    // survives" assertion is reduced to a successful compile plus a text signal
    // that an aggregate copy_memory remains in the optimized SSA.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "ssaopt-p4-keep-aggregate-copy-dest-escapes",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

unsafe ffi fn i32[min max] Escape(rawptr<Pair> pointer);

unsafe fn i32[min max] Run()
{
    stack mut Pair left = new Pair(0, 0);
    stack mut Pair right = new Pair(0, 0);
    stack i32[min max] ignored = Escape(&right);
    right = left;
    return 0;
}
""");
    return Succeeds(compiled) && OptimizedSsaContains(compiled, "copy_memory");
}

// Ported from SsaOptimizationTests.ScalarReplacementKeepsDeadAggregateMoveCopiesConservative.
internal fn bool ScalarReplacementKeepsDeadAggregateMoveCopiesConservativeImpl()
{
    // PORT-NOTE: original hand-builds the same two stack `Pair` locals and a
    // copy_memory(right <- left) tagged SsaMemoryTransferKind.Move with no later
    // read, runs the optimizer and asserts Assert.Single over the surviving
    // SsaCopyMemoryInstruction list (a dead *move* copy is kept conservatively
    // because the move may invalidate the source, unlike the dead plain copy that
    // is removed). The host text bridge cannot tag the lowered copy as a move nor
    // enumerate the surviving copy list, so this is reduced to the closest Stark
    // source (a move of `left` into `right`, `left` never read again) compiled
    // through the optimizer; the "exactly one copy survives" assertion is reduced
    // to a successful compile plus a text signal that an aggregate copy_memory
    // remains in the optimized SSA.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "ssaopt-p4-keep-dead-aggregate-move-copy-conservative",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn void Consume(Pair value)
{
    return;
}

fn i32[min max] Run()
{
    stack mut Pair left = new Pair(0, 0);
    stack mut Pair right = new Pair(0, 0);
    right = left;
    Consume(right);
    return 0;
}
""");
    return Succeeds(compiled) && OptimizedSsaContains(compiled, "copy_memory");
}
