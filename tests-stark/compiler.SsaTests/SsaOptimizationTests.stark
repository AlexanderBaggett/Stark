        raw"""
module Demo

fn i32[min max] Run(bool flag)
{
    if (flag)
    {
        return 7;
    }

    return 7;
}
""",
        "cleanup-ssa");
    return SsaContains(compiled, "7");
}

// Ported from SsaOptimizationTests.CleanupSimplifiesDefaultOnlySwitchToGoto.
internal fn bool CleanupSimplifiesDefaultOnlySwitchToGotoImpl()
{
    // PORT-NOTE: original hand-builds a switch with no cases and only a default
    // target and asserts cleanup turns the entry into a plain return of the
    // constant 9; a default-only switch is not expressible in surface Stark, so
    // reconstructed as a switch whose single default arm returns 9 and reduced to a
