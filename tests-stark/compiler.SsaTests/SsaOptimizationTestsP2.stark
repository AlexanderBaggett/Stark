    stack mut SsaCompile compiled = CompileSsa(
        "ssaopt-p2-bounded-rawptr-region",
        raw"""
module Demo

unsafe fn i32[min max][] Run(#[ElementCount(count)] *i32[min max] input, u8[1 10] count)
{
    stack i32[min max][] slice = slice(input, count);
    return slice;
}
""");
    return Succeeds(compiled);
}

