// Ported from SsaOptimizationTests.ValueFactsDemoteDynamicStorageAfterEscapedDataPointerCall.
public unsafe fn bool ValueFactsDemoteDynamicStorageAfterEscapedDataPointerCallImpl()
{
    // PORT-NOTE: original hand-builds an SsaIrModule (via
    // CreateDynamicStorageDataPointerEscapeModule) that extracts items.Data and
    // passes it to an opaque ObserveRaw call, asserting the analyzer demotes the
    // storage capacity/initialized-prefix facts to Unknown after the escaping call
    // while keeping the reloaded capacity range Known-but-not-[4,4]. There is no
    // embedded Stark source; a plausible equivalent that leaks the data pointer to
    // an opaque call is reconstructed here. The structured demotion facts are not
    // reachable through the text bridge, so this is reduced to a successful raw-SSA
    // compile.
    stack mut SsaCompile compiled = CompileSsa(
        "ssaopt-p2-demote-after-escaped-data-pointer",
        raw"""
module Demo

unsafe fn void ObserveRaw(*mut i32[min max] data)
{
    return;
}

unsafe fn u64[0 max] Run()
{
    stack mut i32[min max]~ items = new i32[min max]~(4);
    ObserveRaw(&items.Data[0]);
    stack u64[0 max] after_capacity = items.Capacity;
    items.Reserve(4);
    return items.Capacity;
}
""");
    return Succeeds(compiled);
}

