// Ported from SsaOptimizationTests.ValueFactsPreserveOnlyIdenticalTextLiteralPayloadsThroughPhi.
public unsafe fn bool ValueFactsPreserveOnlyIdenticalTextLiteralPayloadsThroughPhiImpl()
{
    // PORT-NOTE: original hand-builds an SsaIrModule with two join phis: one whose
    // incomings are both "same" (payload Known, length [4,4]) and one whose
    // incomings are "left"/"right" (payload Unknown, length [4,5]). It asserts the
    // analyzer keeps the payload only when both inputs are identical and joins the
    // length range otherwise. There is no embedded Stark source; a plausible
    // equivalent that selects each phi on a flag is reconstructed here. The
    // structured TextLiteralPayload/LengthRange facts are not reachable through the
    // text bridge, so this is reduced to a successful raw-SSA compile.
    stack mut SsaCompile compiled = CompileSsa(
        "ssaopt-p2-preserve-identical-text-phi",
        raw"""
module Demo

fn ascii Run(bool choose)
{
    stack mut ascii same_phi = "same";
    stack mut ascii mixed_phi = "left";
    if (choose)
    {
        same_phi = "same";
        mixed_phi = "left";
    }
    else
    {
        same_phi = "same";
        mixed_phi = "right";
    }

    return same_phi;
}
""");
    return Succeeds(compiled);
}

