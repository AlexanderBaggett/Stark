// Ported from SsaOptimizationTests.ValueFactsTrackDynamicStorageZeroInitializerAsNoBackingAllocation.
public unsafe fn bool ValueFactsTrackDynamicStorageZeroInitializerAsNoBackingAllocationImpl()
{
    // PORT-NOTE: original hand-builds an SsaIrModule whose dynamic storage value is
    // a zero initializer, asserting the analyzer reports length/capacity/spare all
