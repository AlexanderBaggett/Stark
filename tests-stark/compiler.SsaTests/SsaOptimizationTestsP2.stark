// Ported from SsaOptimizationTests.ValueFactsTrackDynamicStorageAllocationFieldsAndDataPointer.
public unsafe fn bool ValueFactsTrackDynamicStorageAllocationFieldsAndDataPointerImpl()
{
    // PORT-NOTE: original hand-builds an SsaIrModule that allocates dynamic storage
    // `new(4)` and extracts its Length/Capacity/Data fields, asserting the
    // analyzer's dynamic-storage region facts (length [0,0], capacity [4,4], spare
    // [4,4], RuntimeAllocation backing with id "storage", RuntimeDefault allocator,
    // element alignment 4) plus a NonNull/aligned Data pointer. There is no
    // embedded Stark source; a plausible equivalent over a dynamic collection is
    // reconstructed here. The structured dynamic-storage region/integer facts are
    // not reachable through the text bridge, so this is reduced to a successful
    // raw-SSA compile.
    stack mut SsaCompile compiled = CompileSsa(
        "ssaopt-p2-dynamic-storage-alloc-fields",
        raw"""
module Demo

fn u64[0 max] Run()
{
    stack i32[min max]~ storage = new i32[min max]~(4);
    stack u64[0 max] length = storage.Length;
    stack u64[0 max] capacity = storage.Capacity;
    return capacity;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.ValueFactsTrackDynamicStorageTryReserveSuccessAndFailureEdges.
public unsafe fn bool ValueFactsTrackDynamicStorageTryReserveSuccessAndFailureEdgesImpl()
{
    // PORT-NOTE: original hand-builds an SsaIrModule that allocates `new(4)`, calls
    // TryReserve(8), and branches on the boolean result, asserting the analyzer
    // splits the capacity fact across the success edge (capacity [8, i63max], owner
    // "items", no backing id) and the failure edge (capacity [4,4], backing id
    // "allocated"). There is no embedded Stark source; a plausible equivalent that
    // branches on a TryReserve result is reconstructed here. The edge-split
    // dynamic-storage facts are not reachable through the text bridge, so this is
    // reduced to a successful raw-SSA compile.
    stack mut SsaCompile compiled = CompileSsa(
        "ssaopt-p2-dynamic-storage-tryreserve-edges",
        raw"""
module Demo

fn u64[0 max] Run()
{
    stack mut i32[min max]~ items = new i32[min max]~(4);
    if (items.TryReserve(8))
    {
        return items.Capacity;
    }

    return items.Capacity;
}
""");
    return Succeeds(compiled);
}

