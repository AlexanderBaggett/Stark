    // an i32-returning function is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-function-abi-return-mismatch",
        raw"""
module Demo

unsafe fn i32[min max] Run()
{
    return 0;
}
""");
    return Succeeds(compiled);
}

