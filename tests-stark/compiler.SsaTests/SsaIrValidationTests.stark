internal fn bool MirOnlyTempLocalStorageFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# allocates a local with the MIR-only storage class "temp" and
    // asserts STK5002 "local 'scratch' ... invalid storage class 'temp'". No
    // source-level storage class lowers to a "temp" SSA local, so a stack local
    // is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-mir-only-temp-storage",
        raw"""
module Demo

unsafe fn i32[min max] Run()
{
    stack mut i32[min max] scratch = 0;
    return scratch;
}
""");
    return Succeeds(compiled);
}

