// Ported slice (part 2) of tests/compiler.Tests/SsaIrValidationTests.cs.
//
// PORT-NOTE (applies to the whole file): every test in the C# source builds an
// `SsaFunction` / `SsaIrModule` IR object by hand, feeds it straight to
// `SsaIrValidator.Validate()`, and asserts on the emitted STK5002 diagnostic
// fragments (or, for the `*IsUnrepresentable` cases, that an IR constructor
// throws). Those hand-built, deliberately malformed IR shapes cannot be
// produced from well-formed Stark source, and the source-in / artifact-text-out
// host bridge exposed by SsaTestSupport never reaches the validator's object
// model. So each method is reduced to compiling a small Stark program that
// exercises the same construct the validator inspects, and asserting the
// closest available signal (Succeeds(...) that the construct lowers/validates
// cleanly through SSA). Each per-method PORT-NOTE names the specific negative
// (malformed-IR rejection) or constructor-throws fact that was reduced.

// Ported from SsaIrValidationTests.UnsupportedSsaTerminatorFailsBeforeLlvmEmission.
internal fn bool UnsupportedSsaTerminatorFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a terminator with kind (SsaTerminatorKind)999 and
    // asserts STK5002 "unsupported SSA terminator kind"/"999". No valid source can
    // emit an out-of-range terminator kind; reduced to compiling a function whose
    // body lowers to ordinary supported terminators (return) and Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-unsupported-terminator",
        raw"""
module Demo

fn void Run()
{
    return;
}
""");
    return Succeeds(compiled);
}

