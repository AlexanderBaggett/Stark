// Ported from SsaIrValidationTests.AddressOfParameterMissingAbiUserParameterFailsBeforeLlvmEmission.
internal fn bool AddressOfParameterMissingAbiUserParameterFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# takes the address of a parameter against an ABI with no
    // matching user parameter and asserts STK5002 "address-of parameter 'value'
    // ... missing ABI user-parameter lowering". The helpers derive the ABI from
    // the program, so a function that takes the address of its own parameter is
