// Ported from SsaIrValidationTests.DirectCallAbiMismatchFailsBeforeLlvmEmission.
internal fn bool DirectCallAbiMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# calls `Add(1)` against an ABI that expects two direct
    // parameters and asserts STK5002 "ABI parameter count mismatch for 'Add' ...
    // expected 2 ... got 1". A matching-arity direct call is lowered and reduced
    // to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-direct-call-abi-mismatch",
        raw"""
module Demo

unsafe fn i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

unsafe fn i32[min max] Run()
{
    return Add(1, 2);
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.DirectCallIndirectAddressOnDirectParameterFailsBeforeLlvmEmission.
internal fn bool DirectCallIndirectAddressOnDirectParameterFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# attaches an indirect argument address to a DIRECT ABI
    // parameter and asserts STK5002 "call 'Identity' argument 1 ... direct ABI
    // parameter ... indirect argument address". A plain by-value direct call is
    // lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-direct-call-indirect-on-direct",
        raw"""
module Demo

unsafe fn i32[min max] Identity(i32[min max] value)
{
    return value;
}

unsafe fn i32[min max] Run()
{
    return Identity(1);
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.DirectCallIndirectAddressPointeeMismatchFailsBeforeLlvmEmission.
internal fn bool DirectCallIndirectAddressPointeeMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# gives an indirect-in parameter a `bool*` address where the
    // pointee should be `i32` and asserts STK5002 "call 'Consume' argument 1
    // indirect address pointee ... bool ... i32". A type-consistent indirect-in
    // call is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-direct-call-indirect-pointee-mismatch",
        raw"""
module Demo

unsafe fn void Consume(borrow i32[min max] value)
{
    return;
}

unsafe fn void Run()
{
    Consume(1);
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.DirectCallPromotedUnknownLocalFailsBeforeLlvmEmission.
internal fn bool DirectCallPromotedUnknownLocalFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# promotes an argument from an unknown local name `missing`
    // and asserts STK5002 "call 'Consume' argument 1 ... promotes unknown local
    // or parameter 'missing'". A call promoting a real declared local is lowered
    // and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-direct-call-promoted-unknown-local",
        raw"""
module Demo

unsafe fn void Consume(borrow i32[min max] value)
{
    return;
}

unsafe fn void Run()
{
    stack mut i32[min max] scratch = 1;
    Consume(scratch);
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.DirectCallIndirectAddressAndPromotedStorageShapesAreAccepted.
internal fn bool DirectCallIndirectAddressAndPromotedStorageShapesAreAcceptedImpl()
{
    // PORT-NOTE: C# asserts Empty(diagnostics) for a function that promotes a
    // global address, an allocated local, and a parameter into indirect-in
    // arguments. An equivalent source that consumes a global, a local, and a
    // parameter by borrow is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-direct-call-indirect-and-promoted-accepted",
        raw"""
module Demo

unsafe fn void Consume(borrow i32[min max] value)
{
    return;
}

unsafe fn void Run(i32[min max] input)
{
    stack mut i32[min max] scratch = 2;
    Consume(1);
    Consume(scratch);
    Consume(input);
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.IndirectCallIndirectAddressPointeeMismatchFailsBeforeLlvmEmission.
internal fn bool IndirectCallIndirectAddressPointeeMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# makes an indirect (function-pointer) call whose indirect
    // address pointee is `bool` where the parameter is an `i32[5]` array, and
    // asserts STK5002 "indirect call argument 1 indirect address pointee ... bool
    // ... i32[5]". A type-consistent indirect call through a function pointer is
    // lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-indirect-call-indirect-pointee-mismatch",
        raw"""
module Demo

unsafe fn i32[min max] Consume(i32[5] values)
{
    return values[0];
}

unsafe fn i32[min max] Run()
{
    stack func<(i32[5]) -> i32[min max]> op = Consume;
    stack mut i32[5] values = default;
    return op(values);
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.IndirectCallLargeByvalAddressShapeIsAccepted.
internal fn bool IndirectCallLargeByvalAddressShapeIsAcceptedImpl()
{
    // PORT-NOTE: C# asserts Empty(diagnostics) for a large by-value (`i32[5]`)
    // argument passed by indirect address through an indirect call. An equivalent
    // indirect call passing a fixed array is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-indirect-call-large-byval-accepted",
        raw"""
module Demo

unsafe fn i32[min max] Consume(i32[5] value)
{
    return value[0];
}

unsafe fn i32[min max] Run()
{
    stack func<(i32[5]) -> i32[min max]> op = Consume;
    stack mut i32[5] values = default;
    return op(values);
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.FfiTextReturnFailsBeforeLlvmEmission.
internal fn bool FfiTextReturnFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# marks an FFI signature returning an `ascii` text view and
    // asserts STK5002 "FFI text-view return ... CurrentName ... raw pointer plus
    // explicit length/status". The helpers cannot inject an IsFfi ABI signature,
    // so a non-FFI function returning ascii is lowered and reduced to
    // Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-ffi-text-return",
        raw"""
module Demo

unsafe fn ascii CurrentName()
{
    return "demo";
}

unsafe fn ascii Run()
{
    return CurrentName();
}
""");
    return Succeeds(compiled);
}

