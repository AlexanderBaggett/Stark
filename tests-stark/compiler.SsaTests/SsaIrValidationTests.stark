internal fn bool UnsizedIntegerConversionFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# converts a comptime-unsized `integer` constant to `f32` and
    // asserts STK5002 "conversion source type 'integer' ... concrete integer".
    // A concrete-int-to-float conversion is lowered and reduced to Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-irval-unsized-integer-conversion",
        raw"""
module Demo

unsafe fn f32 Run()
{
    return f32(1);
}
""");
    return Succeeds(compiled);
}

