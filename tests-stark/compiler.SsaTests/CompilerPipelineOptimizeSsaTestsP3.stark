// Ported from CompilerPipelineOptimizeSsaTests.FactDrivenBranchPruningUsesKnownBitsForMaskedComparisons.
public unsafe fn bool FactDrivenBranchPruningUsesKnownBitsForMaskedComparisonsImpl()
{
    // PORT-NOTE: original asserts the branch is pruned (no surviving Branch
    // terminator) and the single block folds to a constant 1 return; reduced to a
    // successful compile through prune-branches.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-branchprune-knownbits-masked-cmp",
        raw"""
module Demo

fn i32[min max] Run(u8[0 7] value)
{
    stack u8[0 max] masked = (u8[0 max])(value & 8);
    if (masked == 0)
    {
        return 1;
    }

    return 2;
}
""",
        "prune-branches");
    return Succeeds(compiled);
}

