// Ported from CompilerPipelineOptimizeSsaTests.ValueFactsPropagateBitwiseAndShiftRanges.
public unsafe fn bool ValueFactsPropagateBitwiseAndShiftRangesImpl()
{
    // PORT-NOTE: original inspects the SsaValueFactModel for Known [0 7], [0 60] and
    // [0 63] integer ranges from the bitwise/shift instructions; reduced to a
    // successful compile through value-facts.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-valuefacts-bitwise-shift-ranges",
        raw"""
module Demo

fn u8[0 max] Combine(u8[0 15] value, u8[0 2] amount)
{
    stack u8[0 max] masked = (u8[0 max])(value & 7);
    stack u8[0 max] shifted = (u8[0 max])(value << 2);
    stack u8[0 max] restored = (u8[0 max])(shifted >> amount);
    return (u8[0 max])(masked | restored);
}
""",
        "value-facts");
    return Succeeds(compiled);
}

