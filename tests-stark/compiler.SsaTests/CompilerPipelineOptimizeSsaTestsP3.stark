import SsaTestSupport
import System.Testing
module CompilerPipelineOptimizeSsaTestsP3

// Ported slice (part 3) of the source-driven CompilerPipelineOptimizeSsaTests.cs
// optimization / value-fact tests, running against the current C# host compiler
// through the host test protocol. Each Impl compiles the embedded Stark program
// (kept verbatim from the C# raw string) through the closest compile helper and
// returns a bool.
//
// PORT-NOTE (suite-wide): the original C# tests inspect the structured
// SsaIrModule / SsaValueFactModel object model (block instructions, RValue
// subtypes, per-value integer-range / known-bits / nullability / length facts,
// block entry/exit fact tables, pass logs, etc.). The host source-in /
// rendered-artifact-text-out bridge cannot reconstruct those typed inputs, so
// each ported assertion is reduced to the nearest text/Succeeds signal over the
// rendered `ssa` (post-named-pass) artifact. Per-method PORT-NOTE comments name
// what was reduced where it is not obvious. The C# tests remain the oracle until
// cutover.

// Ported from CompilerPipelineOptimizeSsaTests.InlineSsaInlinesSmallPublicLawDirectCallsWithoutExplicitInline.
public unsafe fn bool InlineSsaInlinesSmallPublicLawDirectCallsWithoutExplicitInlineImpl()
{
    // PORT-NOTE: original asserts no AddOne call survives and the block folds to a
    // constant 42 return; reduced to a text signal that the AddOne call is gone
    // after inline-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-inline-small-public-law-direct",
        raw"""
module Demo

public finite law i32[min max] AddOne(i32[min max] value)
{
    return value + 1;
}

unsafe fn i32[min max] Run()
{
    return AddOne(41);
}
""",
        "inline-ssa");
    return Succeeds(compiled) && !SsaContains(compiled, "AddOne");
}

// Ported from CompilerPipelineOptimizeSsaTests.InlineSsaInlinesDirectCallForwarderChains.
public unsafe fn bool InlineSsaInlinesDirectCallForwarderChainsImpl()
{
    // PORT-NOTE: original asserts neither Forward nor AddOne survives and the block
    // folds to a constant 42 return; reduced to a text signal that both calls are
    // gone after inline-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-inline-direct-forwarder-chains",
        raw"""
module Demo

inline finite law i32[min max] AddOne(i32[min max] value)
{
    return value + 1;
}

inline finite law i32[min max] Forward(i32[min max] value)
{
    return AddOne(value);
}

unsafe fn i32[min max] Run()
{
    return Forward(41);
}
""",
        "inline-ssa");
    return Succeeds(compiled) && !SsaContains(compiled, "Forward") && !SsaContains(compiled, "AddOne");
}

// Ported from CompilerPipelineOptimizeSsaTests.InlineSsaKeepsExplicitNoInlineDirectCalls.
public unsafe fn bool InlineSsaKeepsExplicitNoInlineDirectCallsImpl()
{
    // PORT-NOTE: original asserts a single surviving call to AddOne (explicit
    // noinline kept); reduced to a text signal that the AddOne call is still
    // present after inline-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-inline-keeps-noinline-direct",
        raw"""
module Demo

noinline finite law i32[min max] AddOne(i32[min max] value)
{
    return value + 1;
}

fn i32[min max] Run(i32[min max] value)
{
    return AddOne(value);
}
""",
        "inline-ssa");
    return Succeeds(compiled) && SsaContains(compiled, "AddOne");
}

// Ported from CompilerPipelineOptimizeSsaTests.ConstGraphCallCseReusesRepeatedFiniteLawReadsFromConstGraphs.
public unsafe fn bool ConstGraphCallCseReusesRepeatedFiniteLawReadsFromConstGraphsImpl()
{
    // PORT-NOTE: original asserts exactly one surviving Read call (the repeated
    // const-graph finite-law read is CSE'd to one); reduced to a successful compile
    // through cse-const-graph-calls-ssa plus a text signal that Read is present.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-constgraph-cse-reuses-finite-law",
        raw"""
module Demo

noinline unsafe finite law i32[min max] Read(const rawmutptr<i32[min max]> ptr)
{
    return *ptr;
}

unsafe fn i32[min max] Run(const rawmutptr<i32[min max]> ptr)
{
    stack i32[min max] first = Read(ptr);
    stack i32[min max] second = Read(ptr);
    return first + second;
}
""",
        "cse-const-graph-calls-ssa");
    return Succeeds(compiled) && SsaContains(compiled, "Read");
}

// Ported from CompilerPipelineOptimizeSsaTests.ConstGraphCallCseKeepsRepeatedReadonlyPointerLocalReadsWithoutPermanentConst.
public unsafe fn bool ConstGraphCallCseKeepsRepeatedReadonlyPointerLocalReadsWithoutPermanentConstImpl()
{
    // PORT-NOTE: original asserts two surviving Read calls (a readonly pointer local
    // without permanent-const provenance is not CSE'd); reduced to a successful
    // compile through cse-const-graph-calls-ssa plus a text signal that Read is
    // present.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-constgraph-cse-keeps-readonly-ptr-local",
        raw"""
module Demo

noinline unsafe finite law i32[min max] Read(rawptr<i32[min max]> ptr)
{
    return *ptr;
}

unsafe fn i32[min max] Run(rawmutptr<i32[min max]> ptr)
{
    stack rawptr<i32[min max]> readonlyPtr = (rawptr<i32[min max]>)ptr;
    stack i32[min max] first = Read(readonlyPtr);
    stack i32[min max] second = Read(readonlyPtr);
    return first + second;
}
""",
        "cse-const-graph-calls-ssa");
    return Succeeds(compiled) && SsaContains(compiled, "Read");
}

