// Ported from CompilerPipelineOptimizeSsaTests.ValueFactsJoinSliceLengthRangesAtPhis.
public unsafe fn bool ValueFactsJoinSliceLengthRangesAtPhisImpl()
{
    // PORT-NOTE: original inspects the SsaValueFactModel for a slice fact with a
    // joined [3 5] length range at the phi; reduced to a successful compile through
    // value-facts.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-valuefacts-join-slice-length-ranges-phi",
        raw"""
module Demo

fn i32[min max] Read(bool flag, u8[0 1] index)
{
    stack i32[min max][3] left =
    {
        1, 2, 3
    };
    stack i32[min max][5] right =
    {
        4, 5, 6, 7, 8
    };
    stack mut i32[min max][] view = left;
    if (flag)
    {
        view = right;
    }

    return view[index];
}
""",
        "value-facts");
    return Succeeds(compiled);
}

