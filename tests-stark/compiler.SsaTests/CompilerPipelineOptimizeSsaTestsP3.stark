// Ported from CompilerPipelineOptimizeSsaTests.ValueFactsCaptureIntegerRangesAndProvenComparisons.
public unsafe fn bool ValueFactsCaptureIntegerRangesAndProvenComparisonsImpl()
{
    // PORT-NOTE: original inspects the SsaValueFactModel for a Known [0 10] integer
    // range on arg_value and a proven-true comparison fact. The host bridge cannot
    // reconstruct the typed SsaValueFactModel, so this is reduced to a successful
    // compile through value-facts.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-valuefacts-int-ranges-proven-cmp",
        raw"""
module Demo

fn bool Run(u8[0 10] value)
{
    return value < 20;
}
""",
        "value-facts");
    return Succeeds(compiled);
}

