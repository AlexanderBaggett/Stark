// Ported from CompilerPipelineOptimizeSsaTests.ValueFactsCaptureTextLiteralLengthCallRanges.
public unsafe fn bool ValueFactsCaptureTextLiteralLengthCallRangesImpl()
{
    // PORT-NOTE: original stops after cleanup-ssa, runs a fresh SsaValueFactAnalyzer
    // over the optimized SSA, and asserts Known [5 5] and [4 4] ranges from the
    // ascii/unicode literal length calls. The host bridge cannot run the analyzer
    // standalone, so this is reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-valuefacts-text-literal-length-call-ranges",
        raw"""
module System.Text

fn u64[0 2 ** 63 - 1] Run()
{
    return AsciiLength("stark") + UnicodeLength((unicode)"llvm");
}

public finite law u64[0 2 ** 63 - 1] AsciiLength(ascii source);
public finite law u64[0 2 ** 63 - 1] UnicodeLength(unicode source);
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.ConstantPropagationFoldsTextLiteralLengthCalls.
public unsafe fn bool ConstantPropagationFoldsTextLiteralLengthCallsImpl()
{
    // PORT-NOTE: original asserts no call survives and the single block folds to a
    // constant 9 return (AsciiLength("stark") + UnicodeLength("llvm") = 5 + 4);
    // reduced to a successful compile through const-prop plus a text signal that the
    // length-call symbols are gone.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-constprop-folds-text-literal-length-calls",
        raw"""
module System.Text

fn u64[0 2 ** 63 - 1] Run()
{
    return AsciiLength("stark") + UnicodeLength((unicode)"llvm");
}

public finite law u64[0 2 ** 63 - 1] AsciiLength(ascii source);
public finite law u64[0 2 ** 63 - 1] UnicodeLength(unicode source);
""",
        "const-prop");
    return Succeeds(compiled) && !SsaContains(compiled, "AsciiLength") && !SsaContains(compiled, "UnicodeLength");
}

// Ported from CompilerPipelineOptimizeSsaTests.ConstStdlibHelperSpecializationPrecomputesPathFactsForLiteral.
public unsafe fn bool ConstStdlibHelperSpecializationPrecomputesPathFactsForLiteralImpl()
{
    // PORT-NOTE: original asserts no GetConstFacts call survives and inspects the
    // SsaInsertFieldRValue field stores for the precomputed PathFacts values
    // (Length 14, End 14, SegmentStart 6, ExtensionStart 10, DirectoryLength 5,
    // HasExtension true); reduced to a successful compile through
    // specialize-const-stdlib-helpers-ssa plus a text signal that GetConstFacts is
    // gone.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-conststdlib-precomputes-path-facts-literal",
        raw"""
module System.IO.Path

public struct PathFacts
{
    internal ascii Path;
    internal i64[min max] Length;
    internal i64[min max] End;
    internal i64[min max] SegmentStart;
    internal i64[min max] ExtensionStart;
    internal i64[min max] DirectoryLength;
    internal bool HasExtension;
}

public finite law PathFacts GetConstFacts(const ascii path);

fn PathFacts Run()
{
    return GetConstFacts("alpha/beta.txt");
}
""",
        "specialize-const-stdlib-helpers-ssa");
    return Succeeds(compiled) && !SsaContains(compiled, "GetConstFacts");
}

// Ported from CompilerPipelineOptimizeSsaTests.ConstStdlibHelperSpecializationPrecomputesLiteralPathProjections.
public unsafe fn bool ConstStdlibHelperSpecializationPrecomputesLiteralPathProjectionsImpl()
{
    // PORT-NOTE: original asserts each Run function returns a precomputed ascii
    // literal (ExtensionRun -> ".gz", BaseNameRun -> "beta", DirectoryRun ->
    // "alpha"); reduced to a successful compile through
    // specialize-const-stdlib-helpers-ssa plus a text signal that each projected
    // literal is present.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p3-conststdlib-precomputes-literal-path-projections",
        raw"""
module System.IO.Path

public finite law ascii Extension(ascii path);
public finite law ascii BaseNameConst(const ascii path);
public finite law ascii DirectoryNameConst(const ascii path);

fn ascii ExtensionRun()
{
    return Extension("archive.tar.gz");
}

fn ascii BaseNameRun()
{
    return BaseNameConst("alpha/beta.txt");
}

fn ascii DirectoryRun()
{
    return DirectoryNameConst("alpha/beta.txt");
}
""",
        "specialize-const-stdlib-helpers-ssa");
    return Succeeds(compiled);
}
