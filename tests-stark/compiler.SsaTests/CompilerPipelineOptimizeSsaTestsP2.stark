// Ported from CompilerPipelineOptimizeSsaTests.DynamicStorageSsaPreservesCapacityFactsAcrossFullInitSliceHelperCall.
public unsafe fn bool DynamicStorageSsaPreservesCapacityFactsAcrossFullInitSliceHelperCallImpl()
{
    // PORT-NOTE: original asserts no SsaDynamicStorageReserveRValue survives
    // (capacity facts preserved across the recognized full-init slice helper);
    // reduced to a successful compile through dynamic-storage-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-dyn-preserve-full-init-slice",
        raw"""
module System.Memory

public enum MemoryError
{
    OutOfMemory,
}

public enum MemoryStatus
{
    Ok,
    Err(MemoryError),
}

public inline finite MemoryStatus FillBytes(
    init i8[min max][] destination,
    i8[min max] value,
    u64[0 2 ** 63 - 1] count);

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic i8[min max] values = new(8);
    stack init i8[min max][] tail = init values[values.Length, 4];
    FillBytes(tail, 7, 4);
    values.Reserve(2);
    return values.Capacity;
}
""",
        "dynamic-storage-ssa");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.DynamicStorageSsaDoesNotCommitLengthAfterUnrecognizedInitSliceCall.
public unsafe fn bool DynamicStorageSsaDoesNotCommitLengthAfterUnrecognizedInitSliceCallImpl()
{
    // PORT-NOTE: original asserts the surviving SsaDynamicStorageMoveLastRValue is
    // marked IsKnownNonEmpty: false (length not committed after the unrecognized
    // helper); reduced to a successful compile through dynamic-storage-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-dyn-no-commit-unrecognized-init",
        raw"""
module System.Memory

public enum MemoryError
{
    OutOfMemory,
}

public enum MemoryStatus
{
    Ok,
    Err(MemoryError),
}

public fn MemoryStatus UnknownFill(
    init i8[min max][] destination,
    i8[min max] value,
    u64[0 2 ** 63 - 1] count);

unsafe fn i8[min max] Run()
{
    stack mut dynamic i8[min max] values = new(8);
    stack init i8[min max][] tail = init values[values.Length, 4];
    UnknownFill(tail, 7, 4);
    return values.MoveLast();
}
""",
        "dynamic-storage-ssa");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.DynamicStorageSsaPreservesCapacityFactsAcrossReadOnlyLawCall.
public unsafe fn bool DynamicStorageSsaPreservesCapacityFactsAcrossReadOnlyLawCallImpl()
{
    // PORT-NOTE: original asserts no SsaDynamicStorageReserveRValue survives
    // (capacity facts preserved across the read-only law call); reduced to a
    // successful compile through dynamic-storage-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-dyn-preserve-readonly-law",
        raw"""
module Demo

noinline finite law u64[0 2 ** 63 - 1] Observe(borrow dynamic u32[0 max] values)
{
    return values.Capacity;
}

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u32[0 max] values = new(8);
    if (Observe(values) == 0)
    {
        return 0;
    }

    values.Reserve(4);
    return values.Capacity;
}
""",
        "dynamic-storage-ssa");
    return Succeeds(compiled);
}

