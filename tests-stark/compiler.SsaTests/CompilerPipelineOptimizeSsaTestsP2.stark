// Ported from CompilerPipelineOptimizeSsaTests.DynamicStorageSsaKeepsReserveAfterOpaqueDynamicOwnerCall.
public unsafe fn bool DynamicStorageSsaKeepsReserveAfterOpaqueDynamicOwnerCallImpl()
{
    // PORT-NOTE: original asserts an SsaDynamicStorageReserveRValue survives
    // because the opaque Observe call invalidates capacity facts; reduced to a
    // successful compile through dynamic-storage-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-dyn-keep-reserve-opaque-call",
        raw"""
module Demo

unsafe ffi fn void Observe(mut borrow dynamic u32[0 2 ** 31 - 1] values);

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u32[0 2 ** 31 - 1] values = new(8);
