import SsaTestSupport
import System.Testing
module CompilerPipelineOptimizeSsaTestsP2

// Ported slice (part 2) of the source-driven CompilerPipelineOptimizeSsaTests.cs
// optimization tests, running against the current C# host compiler through the
// host test protocol. Each Impl compiles the embedded Stark program (kept
// verbatim from the C# raw string) through the closest compile helper and
// returns a bool.
//
// PORT-NOTE (suite-wide): the original C# tests inspect the structured
// SsaIrModule object model (block instructions, RValue subtypes, ownership
// summaries, address-taken sets, pass-execution order, etc.). The host
// source-in / rendered-artifact-text-out bridge cannot reconstruct those typed
// inputs, so each ported assertion is reduced to the nearest text/Succeeds
// signal over the rendered `ssa` (post-named-pass) or `optimized-ssa` artifact.
// Per-method PORT-NOTE comments name what was reduced where it is not obvious.
// The C# tests remain the oracle until cutover.

// Ported from CompilerPipelineOptimizeSsaTests.CleanupSsaRemovesSameOperandIntegerComparisons.
public unsafe fn bool CleanupSsaRemovesSameOperandIntegerComparisonsImpl()
{
    // PORT-NOTE: original asserts no SsaBinaryRValue comparison operators survive
    // after cleanup-ssa; reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-cleanup-same-operand-cmp",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    stack i32[min max] equal = value == value ? 1 : 100;
    stack i32[min max] notEqual = value != value ? 100 : 1;
    stack i32[min max] less = value < value ? 100 : 1;
    stack i32[min max] lessOrEqual = value <= value ? 1 : 100;
    stack i32[min max] greater = value > value ? 100 : 1;
    stack i32[min max] greaterOrEqual = value >= value ? 1 : 100;
    return equal + notEqual + less + lessOrEqual + greater + greaterOrEqual;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.ShapeBranchesSimplifiesBooleanReturnDiamondToCondition.
public unsafe fn bool ShapeBranchesSimplifiesBooleanReturnDiamondToConditionImpl()
{
    // PORT-NOTE: original asserts the return value is the SsaValueReference
    // "arg_flag" with no surviving SsaSelectRValue after shape-branches; reduced
    // to a text signal over the rendered ssa text after shape-branches.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-shape-bool-return-diamond",
        raw"""
module Demo

fn bool Run(bool flag)
{
    if (flag)
    {
        return true;
    }

    return false;
}
""",
        "shape-branches");
    return SsaContains(compiled, "arg_flag");
}

// Ported from CompilerPipelineOptimizeSsaTests.InlineSsaInlinesSmallDirectCallsAndRerunsConstantPropagation.
public unsafe fn bool InlineSsaInlinesSmallDirectCallsAndRerunsConstantPropagationImpl()
{
    // PORT-NOTE: original asserts no call to AddOne survives and the block folds
    // to a constant 42 return; reduced to a text signal that the AddOne call is
    // gone after inline-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-inline-small-direct-const-prop",
        raw"""
module Demo

inline finite law i32[min max] AddOne(i32[min max] value)
{
    return value + 1;
}

unsafe fn i32[min max] Run()
{
    return AddOne(41);
}
""",
        "inline-ssa");
    return Succeeds(compiled) && !SsaContains(compiled, "AddOne");
}

// Ported from CompilerPipelineOptimizeSsaTests.AggregateConstructionSsaStoresFullConstructorsDirectlyIntoNonEscapedLocalFields.
public unsafe fn bool AggregateConstructionSsaStoresFullConstructorsDirectlyIntoNonEscapedLocalFieldsImpl()
{
    // PORT-NOTE: original runs three compiles (memory-opt-ssa, then
    // aggregate-construction-ssa, then full) and inspects SsaStoreLocal /
    // SsaStoreIndirect instructions; reduced to a successful compile through
    // aggregate-construction-ssa plus the full pipeline.
    stack mut SsaCompile after = CompileSsaAfter(
        "optssa-p2-agg-construct-nonescaped",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

fn i32[min max] Run()
{
    heap mut Pair value = new Pair()
    {
        Left = 1, Right = 2
    };
    return value.Left;
}
""",
        "aggregate-construction-ssa");
    stack mut SsaCompile full = CompileOptimizedSsa(
        "optssa-p2-agg-construct-nonescaped-full",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

fn i32[min max] Run()
{
    heap mut Pair value = new Pair()
    {
        Left = 1, Right = 2
    };
    return value.Left;
}
""");
    return Succeeds(after) && Succeeds(full);
}

// Ported from CompilerPipelineOptimizeSsaTests.AggregateConstructionSsaKeepsWholeStoreForRawEscapedLocal.
public unsafe fn bool AggregateConstructionSsaKeepsWholeStoreForRawEscapedLocalImpl()
{
    // PORT-NOTE: original asserts an SsaStoreLocal of "value" of type Pair
    // survives because the local escapes via raw pointer; reduced to a text
    // signal that the "value" local is still present after
    // aggregate-construction-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-agg-construct-raw-escaped",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

unsafe ffi fn void Observe(rawptr<Pair> pointer);

unsafe fn i32[min max] Run()
{
    heap mut Pair value = new Pair()
    {
        Left = 1, Right = 2
    };
    stack rawptr<Pair> pointer = &value;
    Observe(pointer);
    return value.Left;
}
""",
        "aggregate-construction-ssa");
    return Succeeds(compiled) && SsaContains(compiled, "value");
}

// Ported from CompilerPipelineOptimizeSsaTests.OwnershipTrafficSsaElidesDeadAggregateMoveTrafficForNonEscapedRoots.
public unsafe fn bool OwnershipTrafficSsaElidesDeadAggregateMoveTrafficForNonEscapedRootsImpl()
{
    // PORT-NOTE: original runs memory-opt-ssa then ownership-traffic-ssa and
    // inspects SsaCopyMemory(Move) and SsaStoreLocal(undef) on "source"; reduced
    // to a successful compile through ownership-traffic-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-ownership-elide-dead-move",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

fn void Run()
{
    heap mut Pair source = new Pair()
    {
        Left = 1, Right = 2
    };
    heap mut Pair destination = new Pair()
    {
        Left = 3, Right = 4
    };
    destination = source;
    return;
}
""",
        "ownership-traffic-ssa");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.OwnershipTrafficSsaKeepsMoveInvalidationForRawEscapedRoots.
public unsafe fn bool OwnershipTrafficSsaKeepsMoveInvalidationForRawEscapedRootsImpl()
{
    // PORT-NOTE: original asserts an SsaStoreLocal(undef) of "source" survives
    // (move invalidation kept) because the root escapes via raw pointer; reduced
    // to a successful compile through ownership-traffic-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-ownership-keep-move-raw-escaped",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

unsafe ffi fn void Observe(rawptr<Pair> pointer);

fn void Consume(Pair value)
{
    return;
}

unsafe fn void Run()
{
    heap mut Pair source = new Pair()
    {
        Left = 1, Right = 2
    };
    stack rawptr<Pair> pointer = &source;
    Consume(source);
    Observe(pointer);
    return;
}
""",
        "ownership-traffic-ssa");
    return Succeeds(compiled) && SsaContains(compiled, "source");
}

// Ported from CompilerPipelineOptimizeSsaTests.InlineSsaPreservesOwnershipSummariesOnRewrittenFunctions.
public unsafe fn bool InlineSsaPreservesOwnershipSummariesOnRewrittenFunctionsImpl()
{
    // PORT-NOTE: original asserts no AddOne call survives and the rewritten Run
    // function retains its ownership summary (AddressTaken/Move/Reinitialize
    // events and a raw-pointer-escaped "box" root); reduced to a text signal that
    // the AddOne call is gone after inline-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-inline-preserves-ownership",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

inline finite law i32[min max] AddOne(i32[min max] value)
{
    return value + 1;
}

fn void Consume(Box value)
{
    return;
}

unsafe fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = AddOne(0)
    };
    stack rawptr<Box> pointer = &box;
    Consume(box);
    box = new Box()
    {
        Value = AddOne(1)
    };
    return box.Value;
}
""",
        "inline-ssa");
    return Succeeds(compiled) && !SsaContains(compiled, "AddOne");
}

// Ported from CompilerPipelineOptimizeSsaTests.DynamicStorageSsaElidesReserveWhenCapacityFactsProveNoop.
public unsafe fn bool DynamicStorageSsaElidesReserveWhenCapacityFactsProveNoopImpl()
{
    // PORT-NOTE: original asserts no SsaDynamicStorageReserveRValue survives;
    // reduced to a successful compile through dynamic-storage-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "optssa-p2-dyn-elide-reserve-noop",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u32[0 2 ** 31 - 1] values = new(8);
    values.Reserve(4);
    return values.Capacity;
}
""",
        "dynamic-storage-ssa");
    return Succeeds(compiled);
}

// Ported from CompilerPipelineOptimizeSsaTests.DynamicStorageSsaFoldsTryReserveWhenCapacityFactsProveSuccess.
public unsafe fn bool DynamicStorageSsaFoldsTryReserveWhenCapacityFactsProveSuccessImpl()
{
