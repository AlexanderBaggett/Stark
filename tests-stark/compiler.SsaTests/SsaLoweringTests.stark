}

// Ported from SsaLoweringTests.RuntimeDisjointTrueBranchCarriesScopedNoAliasFactsIntoSsaMemoryOperations.
internal fn bool RuntimeDisjointTrueBranchCarriesScopedNoAliasFactsIntoSsaMemoryOperationsImpl()
{
    // PORT-NOTE: original asserts the `if disjoint(...)` true branch attaches a
    // single shared ScopedNoAliasGroup (RuntimeDisjointCondition proof carrier,
    // root keys param:left / param:right) to its store-indirect and load-indirect,
    // while the false path carries no groups. The text renderer
    // (ArtifactTextRenderer.cs) does NOT emit scoped-noalias groups or alias proof
    // carriers, so this metadata fact is inexpressible; reduced to a successful
    // raw-SSA compile of the runtime-disjoint program.
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-p1-runtime-disjoint-noalias-facts",
        raw"""
module Demo

unsafe fn i32[min max] Run(
    rawmutptr<i32[min max]> left,
    rawmutptr<i32[min max]> right)
    {
        if disjoint(left, right)
    {
        *left = 7;
        return *right;
    }

    *left = 1;
    return *right;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaLoweringTests.UnsafeAssumeDisjointCarriesUnsafeProofCarrierKindIntoSsaMemoryOperations.
internal fn bool UnsafeAssumeDisjointCarriesUnsafeProofCarrierKindIntoSsaMemoryOperationsImpl()
{
    // PORT-NOTE: original asserts an `assume disjoint(...)` block attaches a single
    // shared ScopedNoAliasGroup (UnsafeAssumeDisjoint proof carrier, root keys
    // param:left / param:right) to its store-indirect and load-indirect. The text
    // renderer does NOT emit scoped-noalias groups or alias proof carriers, so this
    // metadata fact is inexpressible; reduced to a successful raw-SSA compile of
    // the assume-disjoint program.
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-p1-unsafe-assume-disjoint-proof-carrier",
        raw"""
module Demo

unsafe fn i32[min max] Run(
    rawmutptr<i32[min max]> left,
    rawmutptr<i32[min max]> right)
    where overlap(left, right)
    {
        assume disjoint(left, right)
    {
        *left = 7;
        return *right;
    }

    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaLoweringTests.IndependentForLoopsPreserveLoopContractsInSsa.
internal fn bool IndependentForLoopsPreserveLoopContractsInSsaImpl()
{
    // PORT-NOTE: original asserts some block terminator carries LoopContracts
    // including "independent" with LoopBehavior "willexit". The text renderer does
    // NOT emit terminator loop contracts or loop behavior, so this metadata fact is
    // inexpressible; reduced to a successful raw-SSA compile of the
    // for-willexit-independent program.
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-p1-independent-for-loop-contracts",
        raw"""
module Demo

unsafe fn u8[0 10] Run()
{
    stack mut u8[0 10] sum = 0;
    for willexit independent (stack mut u8[0 10] index = 0; index < 4; index += 1)
    {
        sum += index;
    }

    return sum;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaLoweringTests.WillexitWhileLoopsPreserveLoopBehaviorOnBackedgesInSsa.
internal fn bool WillexitWhileLoopsPreserveLoopBehaviorOnBackedgesInSsaImpl()
{
    // PORT-NOTE: original asserts at least two terminators carry LoopBehavior
    // "willexit" (the cond backedge and the continue backedge) and that none of
    // them carry LoopContracts. The text renderer does NOT emit terminator loop
    // behavior or loop contracts, so this metadata fact is inexpressible; reduced
    // to a successful raw-SSA compile of the while-willexit-with-continue program.
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-p1-willexit-while-loop-backedges",
        raw"""
module Demo

unsafe fn u8[0 10] Run(u8[0 10] limit)
{
    stack mut u8[0 10] value = 0;
    while willexit (value < limit)
    {
        value += 1;
        if (value == 2)
        {
            continue;
        }
    }

    return value;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaLoweringTests.IndependentSliceLoopsCarryAccessGroupsInSsa.
internal fn bool IndependentSliceLoopsCarryAccessGroupsInSsaImpl()
{
    // PORT-NOTE: original asserts an independent slice loop attaches LoopAccessGroups
    // to a load-indirect value instruction and to a block terminator. The text
    // renderer does NOT emit loop access groups, so this metadata fact is
    // inexpressible; reduced to a successful raw-SSA compile of the
    // independent-slice-loop program.
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-p1-independent-slice-loop-access-groups",
        raw"""
module Demo

unsafe fn void Add(
    borrow i32[min max][] left,
    borrow i32[min max][] right,
    borrow mut i32[min max][] output,
    u8[0 10] count)
    {
        for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        output[index] = left[index] + right[index];
    }

    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaLoweringTests.InitAndOutAssignmentsCarryInitializationWriteKindInSsa.
internal fn bool InitAndOutAssignmentsCarryInitializationWriteKindInSsaImpl()
{
    // PORT-NOTE: original asserts both Fill (init slice element) and Write (out
    // parameter) emit an SsaStoreIndirectInstruction with WriteKind Initialization
    // over an integer value. The text renderer distinguishes initialization stores
    // with the `init-store` mnemonic; reduced to: an `init-store` is present in the
    // rendered text (covering the init/out initialization-write-kind stores).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-p1-init-and-out-initialization-write-kind",
        raw"""
module Demo

unsafe fn void Fill(init u32[0 max][] destination)
{
    init destination[0] = 7;
    return;
}

fn void Write(out u32[0 max] value)
{
    value = 9;
    return;
}
""");
    return SsaContains(compiled, "init-store");
}

// Ported from SsaLoweringTests.OrdinaryMutableSliceAssignmentKeepsReplacementWriteKindInSsa.
internal fn bool OrdinaryMutableSliceAssignmentKeepsReplacementWriteKindInSsaImpl()
{
    // PORT-NOTE: original asserts an ordinary mutable-slice assignment emits an
    // SsaStoreIndirectInstruction with WriteKind Replacement (not Initialization)
    // over an integer value. The text renderer renders replacement stores with the
    // plain `store` mnemonic (initialization stores use `init-store`); reduced to:
    // a plain `store` is present and no `init-store` initialization-write-kind
    // store survives.
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-p1-ordinary-mutable-slice-replacement-write-kind",
        raw"""
module Demo

unsafe fn void Replace(borrow mut u32[0 max][] destination)
{
    destination[0] = 7;
    return;
}
""");
    return SsaContainsButNot(compiled, "store", "init-store");
}
