// Ported from SsaOptimizationTests.CleanupDropsSwitchCasesThatAlreadyMatchDefaultTarget.
public unsafe fn bool CleanupDropsSwitchCasesThatAlreadyMatchDefaultTargetImpl()
{
    // PORT-NOTE: original hand-builds a bool switch where the `false` case already
    // shares the default target and asserts cleanup drops the redundant case and
    // returns a select result; reconstructed as a bool switch whose false case and
    // default both yield 2 and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-drop-cases-matching-default",
        raw"""
module Demo

fn i32[min max] Run(bool flag)
{
    switch (flag)
    {
        case true:
            return 1;
        case false:
            return 2;
        default:
            return 2;
    }
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.OptimizedSsaSimplifiesSingleCaseSwitchBeforeLlvmEmission.
public unsafe fn bool OptimizedSsaSimplifiesSingleCaseSwitchBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: original asserts the optimized SSA folds a one-case switch into a
    // compare + select returned by the entry, and that the LLVM contains
    // `icmp eq i32 %arg_value, 1` and `select i1` with no `br i1`/`switch i32`;
    // the LLVM artifact is not reachable through this bridge, so reduced to a
