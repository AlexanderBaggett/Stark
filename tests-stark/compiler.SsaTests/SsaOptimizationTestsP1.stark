    // to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-modulo-by-one",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return value % 1;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.CleanupRemovesSameOperandDivisionAndModuloWhenRangeExcludesZero.
public unsafe fn bool CleanupRemovesSameOperandDivisionAndModuloWhenRangeExcludesZeroImpl()
{
    // PORT-NOTE: original hand-builds `value / value` and `value % value` over a
    // [1 100] non-zero range and asserts no Divide/Modulo SsaBinaryRValue survives
    // cleanup; reconstructed with a range that excludes zero and reduced to a
    // successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-same-operand-div-mod-nonzero",
        raw"""
module Demo

fn i32[min max] Run(i32[1 100] value)
{
    stack i32[min max] quotient = value / value;
    stack i32[min max] remainder = value % value;
    return quotient + remainder;
}
""",
        "cleanup-ssa");
    return SsaContainsButNot(compiled, "Run", " / value");
}

// Ported from SsaOptimizationTests.CleanupRemovesSameOperandIntegerComparisons.
public unsafe fn bool CleanupRemovesSameOperandIntegerComparisonsImpl()
{
    // PORT-NOTE: original hand-builds the six self comparisons (==, !=, <, <=, >,
    // >=) over `arg_value` and asserts no comparison SsaBinaryRValue survives and
    // the return folds to the bool constant true; reconstructed as the six self
    // comparisons and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-same-operand-comparisons",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    stack i32[min max] equal = value == value ? 1 : 100;
    stack i32[min max] notEqual = value != value ? 100 : 1;
    stack i32[min max] less = value < value ? 100 : 1;
    stack i32[min max] lessOrEqual = value <= value ? 1 : 100;
    stack i32[min max] greater = value > value ? 100 : 1;
    stack i32[min max] greaterOrEqual = value >= value ? 1 : 100;
    return equal + notEqual + less + lessOrEqual + greater + greaterOrEqual;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.CleanupRemovesModuloAndDivisionWhenStaticRangeIsBelowPositiveDivisor.
public unsafe fn bool CleanupRemovesModuloAndDivisionWhenStaticRangeIsBelowPositiveDivisorImpl()
{
    // PORT-NOTE: original hand-builds `slot % 8` and `slot / 8` where `slot` has
    // static range [0 7] below the divisor and asserts no Divide/Modulo
    // SsaBinaryRValue survives cleanup; reconstructed with a [0 7] range against a
    // divisor of 8 and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-range-below-divisor",
        raw"""
module Demo

fn i32[min max] Run(i32[0 7] slot)
{
    stack i32[min max] remainder = slot % 8;
    stack i32[min max] quotient = slot / 8;
    return remainder + quotient;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.CleanupForwardsAggregateFieldThroughPhiWhenIncomingFieldsMatch.
public unsafe fn bool CleanupForwardsAggregateFieldThroughPhiWhenIncomingFieldsMatchImpl()
{
    // PORT-NOTE: original hand-builds two insert-field aggregates whose `Value`
    // field is `arg_value` on both incoming edges of a phi, then an extract-field
    // through the phi, and asserts the extract is forwarded away and the return is
    // `arg_value`; reconstructed as a diamond that writes the same field value on
    // both arms and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-forward-field-through-phi-match",
        raw"""
module Demo

struct Pair
{
    i32[min max] Value;
    i32[min max] Count;
}

fn i32[min max] Run(bool flag, i32[min max] value)
{
    stack mut Pair pair = new Pair() { Value = value, Count = 1 };
    if (flag)
    {
        pair = new Pair() { Value = value, Count = 1 };
    }
    else
    {
        pair = new Pair() { Value = value, Count = 2 };
    }

    return pair.Value;
}
""",
        "cleanup-ssa");
    return SsaContains(compiled, "arg_value");
}

// Ported from SsaOptimizationTests.CleanupKeepsAggregateFieldExtractThroughPhiWhenIncomingFieldsDiffer.
public unsafe fn bool CleanupKeepsAggregateFieldExtractThroughPhiWhenIncomingFieldsDifferImpl()
{
    // PORT-NOTE: original hand-builds two insert-field aggregates whose `Value`
    // field differs (1 vs 2) across a phi and asserts the extract-field through the
    // phi is kept; reconstructed as a diamond that writes a different field value
    // on each arm and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-keep-field-through-phi-differ",
        raw"""
module Demo

struct Pair
{
    i32[min max] Value;
}

fn i32[min max] Run(bool flag)
{
    stack mut Pair pair = new Pair() { Value = 1 };
    if (flag)
    {
        pair = new Pair() { Value = 1 };
    }
    else
    {
        pair = new Pair() { Value = 2 };
    }

    return pair.Value;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.CleanupForwardsAggregateIndexThroughPhiWhenIncomingElementsMatch.
public unsafe fn bool CleanupForwardsAggregateIndexThroughPhiWhenIncomingElementsMatchImpl()
{
    // PORT-NOTE: original hand-builds two insert-index fixed arrays whose element 0
    // is `arg_value` on both phi edges, then an extract-index through the phi, and
    // asserts the extract is forwarded away and the return is `arg_value`;
    // reconstructed with a fixed array written identically on both diamond arms and
    // reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-forward-index-through-phi-match",
        raw"""
module Demo

fn i32[min max] Run(bool flag, i32[min max] value)
{
    stack mut [2]i32[min max] values = new [2]i32[min max]();
    if (flag)
    {
        values[0] = value;
    }
    else
    {
        values[0] = value;
    }

    return values[0];
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.CleanupForwardsAggregateFieldThroughSelectWhenSelectedFieldsMatch.
public unsafe fn bool CleanupForwardsAggregateFieldThroughSelectWhenSelectedFieldsMatchImpl()
{
    // PORT-NOTE: original hand-builds two insert-field aggregates whose `Value`
    // field is `arg_value` on both, a select between them, then an extract-field on
    // the selected aggregate, and asserts cleanup empties the block and returns
    // `arg_value`; reconstructed as a select that picks between two aggregates with
    // the same field value and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-forward-field-through-select-match",
        raw"""
module Demo

struct Pair
{
    i32[min max] Value;
}

fn i32[min max] Run(bool flag, i32[min max] value)
{
    stack Pair left = new Pair() { Value = value };
    stack Pair right = new Pair() { Value = value };
    stack Pair selected = flag ? left : right;
    return selected.Value;
}
""",
        "cleanup-ssa");
    return SsaContains(compiled, "arg_value");
}

