module Demo

fn i32[min max] Run(i32[min max] value)
{
    switch (value)
    {
        case 1:
            return 10;
        default:
            return 20;
    }
}
""");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.DevirtualizerTurnsKnownDynTraitCallIntoDirectCallBeforeInlining.
public unsafe fn bool DevirtualizerTurnsKnownDynTraitCallIntoDirectCallBeforeInliningImpl()
{
    // PORT-NOTE: original stops after `devirt-ssa` and asserts the `Run` function
    // gained a direct `Dog.Speak` SsaCallRValue and lost every SsaIndirectCallRValue
    // / SsaIndirectCallInstruction; reduced to a post-`devirt-ssa` snapshot that
    // mentions the devirtualized `Dog.Speak` callee in the rendered ssa text.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-devirt-known-dyn-call",
        raw"""
module Demo

dyn trait Speaker
{
    finite law i32[min max] Speak(borrow Self self);
}

struct Dog : Speaker
{
    i32[min max] Volume;

    finite law i32[min max] Speak(borrow Dog self)
    {
        return self.Volume;
    }
}

fn i32[min max] Run()
{
    stack Dog d = new Dog() { Volume = 7 };
    stack borrow dyn Speaker s = d;
    return s.Speak();
}
""",
        "devirt-ssa");
    return SsaContains(compiled, "Dog.Speak");
}

