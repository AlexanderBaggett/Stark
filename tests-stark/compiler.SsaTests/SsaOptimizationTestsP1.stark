module Demo

fn i32[min max] Run(i32[min max] value)
{
    switch (value)
    {
        case 9:
            return 90;
        case 1:
            return 10;
        case 5:
            return 50;
        default:
            return 0;
    }
}
""");
    return Succeeds(compiled);
}

