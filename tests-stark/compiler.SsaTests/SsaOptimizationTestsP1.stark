// Ported from SsaOptimizationTests.CleanupCanonicalizesEarlyReturnDiamonds.
public unsafe fn bool CleanupCanonicalizesEarlyReturnDiamondsImpl()
{
    // PORT-NOTE: original hand-builds a then/else diamond whose join phi picks 1 vs
    // 2 and asserts cleanup collapses it to a single block returning a select with
    // WhenTrue=1 and WhenFalse=2; reconstructed as a flag diamond yielding 1 or 2
    // and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-early-return-diamond",
        raw"""
module Demo

fn i32[min max] Run(bool flag)
{
    stack mut i32[min max] value = 1;
    if (flag)
    {
        value = 1;
    }
    else
    {
        value = 2;
    }

    return value;
}
""",
        "cleanup-ssa");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.OptimizedSsaCanonicalizesReturnPhiJoinsBeforeLlvmEmission.
public unsafe fn bool OptimizedSsaCanonicalizesReturnPhiJoinsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: original asserts the optimized SSA has exactly 3 blocks with no
    // phis, both `bb1_if_then` and `bb2_if_else` end in Return, and the LLVM emits
    // `br i1` with no ` phi `; the block-count / phi-free / LLVM facts are not
    // reachable through this bridge, so reduced to a successful optimized-ssa
    // compile.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "ssaopt-p1-opt-return-phi-join",
        raw"""
module Demo

fn i32[min max] Run(bool flag, i32[min max] value)
{
    stack mut i32[min max] result = value;
    if (flag)
    {
        result = result + 1;
    }
    else
    {
        result = result + 2;
    }

    return result;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.CleanupRemovesLoopInvariantSelfReferentialPhiNodes.
public unsafe fn bool CleanupRemovesLoopInvariantSelfReferentialPhiNodesImpl()
{
    // PORT-NOTE: original hand-builds a loop header with a self-referential phi
    // `v0_phi = phi(arg_limit, v0_phi)` (loop-invariant) plus an induction phi and
    // asserts cleanup drops the invariant phi from the header and rewrites the exit
    // return to `arg_limit`; reconstructed as a counted loop whose bound is never
    // reassigned and reduced to a successful compile through cleanup-ssa.
    stack mut SsaCompile compiled = CompileSsaAfter(
        "ssaopt-p1-loop-invariant-self-phi",
        raw"""
module Demo

fn i32[min max] Run(bool flag, i32[min max] limit)
{
    stack mut i32[min max] index = 0;
    while (index < limit)
    {
        index = index + 1;
    }

    return limit;
}
""",
        "cleanup-ssa");
    return SsaContains(compiled, "arg_limit");
}
