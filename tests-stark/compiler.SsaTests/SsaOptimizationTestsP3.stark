public unsafe fn bool ScalarReplacementKeepsStackFieldStoresAcrossUnknownCallsImpl()
{
    // PORT-NOTE: original stores arg_value into pair.Left then makes an unknown
    // (effectful) Demo.Touch call that could observe the field, and asserts the
