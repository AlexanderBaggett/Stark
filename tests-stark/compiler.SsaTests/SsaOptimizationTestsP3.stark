// Ported from SsaOptimizationTests.ScalarReplacementKeepsStackFieldStoresAfterAggregateAddressEscapes.
public unsafe fn bool ScalarReplacementKeepsStackFieldStoresAfterAggregateAddressEscapesImpl()
{
    // PORT-NOTE: original passes &pair (the whole aggregate) to a Demo.Escape call
    // before storing arg_value into pair.Left, so the aggregate address has
    // escaped and the field store must be kept (a single surviving
    // SsaStoreIndirectInstruction); the text bridge cannot enumerate the typed
    // store list, so this is reduced to a successful optimized compile of the
    // verbatim aggregate-escape program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-sroa-keeps-stack-field-stores-after-aggregate-escapes",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

noinline fn i32[min max] Escape(rawptr<Pair> value)
{
    return 0;
}

unsafe fn i32[min max] Run(i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    stack i32[min max] ignored = Escape(&pair);
    pair.Left = value;
    return 0;
}
""");
    return Succeeds(compiled);
}

