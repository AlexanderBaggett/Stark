module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

unsafe fn i32[min max] Run(i32[min max] value, rawptr<i32[min max]> ptr)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    stack i32[min max] unknown = *ptr;
    return unknown;
}
""");
    return Succeeds(compiled);
}

