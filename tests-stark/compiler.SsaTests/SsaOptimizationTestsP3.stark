// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationKeepsStackFieldLoadsAtJoinBlocks.
public unsafe fn bool AliasAwareMemoryOptimizationKeepsStackFieldLoadsAtJoinBlocksImpl()
{
    // PORT-NOTE: original stores divergent constants into pair.Left on the two
    // branch arms and asserts the load at the join block is kept (a surviving
    // SsaLoadIndirectRValue, since the field value differs per predecessor);
    // reduced to a successful optimized compile of the verbatim join-block
    // program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-keep-stack-field-loads-at-join",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(bool flag)
{
    stack mut Pair pair = new Pair(0, 1);
    if (flag)
    {
        pair.Left = 1;
    }
    else
    {
        pair.Left = 2;
    }

    return pair.Left;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationRemovesOverwrittenStackScalarStoresWithinBlock.
public unsafe fn bool AliasAwareMemoryOptimizationRemovesOverwrittenStackScalarStoresWithinBlockImpl()
{
    // PORT-NOTE: original stores arg_value then 7 into a stack scalar local, then
    // asserts both the dead store and the load of `local` are removed (no
    // SsaStoreLocal/SsaLoadLocal for local) and the return forwards to constant 7;
    // the text bridge cannot enumerate the typed local-store list, so this is
    // reduced to a successful optimized compile of the verbatim overwritten-scalar
    // program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-remove-overwritten-stack-scalar-stores",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    stack mut i32[min max] local = value;
    local = 7;
    return local;
}
""");
    return Succeeds(compiled);
}

