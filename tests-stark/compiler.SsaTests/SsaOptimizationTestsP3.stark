public unsafe fn bool ScalarReplacementKeepsStackFieldStoresAcrossUnknownIndirectLoadsImpl()
{
    // PORT-NOTE: original stores arg_value into pair.Left then reads through an
    // unknown `ptr` parameter (a may-alias load that could observe the field),
