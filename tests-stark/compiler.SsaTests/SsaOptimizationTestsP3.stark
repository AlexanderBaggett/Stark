import SsaTestSupport
import System.Testing
module SsaOptimizationTestsP3

// Ported slice (part 3) of SsaOptimizationTests.cs — the alias-aware memory
// optimizer and scalar-replacement optimizer cases. The C# originals build a
// hand-typed SsaIrModule object model (SsaBasicBlock/SsaValueInstruction/
// SsaStoreIndirectInstruction/SsaLoadIndirectRValue/SsaCopyMemoryInstruction,
// configured function effects, etc.) and run the optimizer directly on that
// in-memory module, then inspect the surviving typed instructions and the
// terminator value.
//
// PORT-NOTE (suite-wide): the host source-in / rendered-artifact-text-out
// bridge cannot reconstruct the typed SsaIrModule input nor enumerate typed
// instruction lists, so each test reconstructs an equivalent, plausible Stark
// program that lowers to the same alias/scalar-replacement scenario, compiles
// it through CompileOptimizedSsa (the full pipeline, which runs the alias-aware
// memory optimizer and scalar replacement), and reduces the object-model
// assertion to the nearest text/Succeeds signal over the rendered
// `optimized-ssa` artifact. Per-method PORT-NOTE comments name what was reduced
// where it is not obvious. The C# tests remain the oracle until cutover.

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationForwardsNestedStackFieldLoadsWithinBlock.
public unsafe fn bool AliasAwareMemoryOptimizationForwardsNestedStackFieldLoadsWithinBlockImpl()
{
    // PORT-NOTE: original asserts the nested outer.Inner.Value load is forwarded
    // from its store (no surviving SsaLoadIndirectRValue) and the return is the
    // value reference "arg_value"; reduced to a text signal that the forwarded
    // arg_value reference survives after optimization.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-forward-nested-stack-field-loads",
        raw"""
module Demo

record Inner(i32[min max] Value, i32[min max] Salt)
{
}
record Outer(Inner Inner, Inner Other)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Outer outer = new Outer(new Inner(0, 1), new Inner(2, 3));
    outer.Inner.Value = value;
    return outer.Inner.Value;
}
""");
    return Succeeds(compiled) && OptimizedSsaContains(compiled, "arg_value");
}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationKeepsSiblingNestedStackFieldPathsSeparate.
public unsafe fn bool AliasAwareMemoryOptimizationKeepsSiblingNestedStackFieldPathsSeparateImpl()
{
    // PORT-NOTE: original stores 1 into outer.Left.Value and arg_value into the
    // disjoint sibling outer.Right.Value, then asserts the outer.Left.Value load
    // is forwarded to the constant 1 (no surviving SsaLoadIndirectRValue, return
    // is the integer constant 1); reduced to a successful optimized compile of
    // the verbatim sibling-path program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-keep-sibling-nested-stack-field-paths-separate",
        raw"""
module Demo

record Inner(i32[min max] Value, i32[min max] Salt)
{
}
record Outer(Inner Left, Inner Right)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Outer outer = new Outer(new Inner(0, 1), new Inner(2, 3));
    outer.Left.Value = 1;
    outer.Right.Value = value;
    return outer.Left.Value;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationRemovesOverwrittenStackFieldStoresWithinBlock.
public unsafe fn bool AliasAwareMemoryOptimizationRemovesOverwrittenStackFieldStoresWithinBlockImpl()
{
    // PORT-NOTE: original stores 1 then arg_value into the same pair.Left, then
    // asserts the dead first store is removed (a single surviving store of
    // arg_value) and the load forwards to arg_value; reduced to a text signal
    // that the forwarded arg_value reference survives after optimization.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-remove-overwritten-stack-field-stores",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = 1;
    pair.Left = value;
    return pair.Left;
}
""");
    return Succeeds(compiled) && OptimizedSsaContains(compiled, "arg_value");
}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationKeepsStackFieldStoresAcrossUnknownIndirectStores.
public unsafe fn bool AliasAwareMemoryOptimizationKeepsStackFieldStoresAcrossUnknownIndirectStoresImpl()
{
    // PORT-NOTE: original stores arg_value into pair.Left, then 9 into an unknown
    // `other` pointer (a may-alias barrier), then 11 into pair.Left, and asserts
    // all three stores survive (two of them targeting left_addr) with the load
    // forwarding to constant 11; the text bridge cannot enumerate the typed store
    // list, so this is reduced to a successful optimized compile of the verbatim
    // unknown-indirect-store program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-keep-stack-field-stores-across-unknown-indirect",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

unsafe fn i32[min max] Run(i32[min max] value, rawptr<i32[min max]> other)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    *other = 9;
    pair.Left = 11;
    return pair.Left;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationForwardsStackFieldLoadsAcrossPureScalarCalls.
public unsafe fn bool AliasAwareMemoryOptimizationForwardsStackFieldLoadsAcrossPureScalarCallsImpl()
{
    // PORT-NOTE: original configures Touch as a pure scalar call and asserts the
    // call survives while the pair.Left load is forwarded across it (no surviving
    // SsaLoadIndirectRValue, return is arg_value); reduced to a text signal that
    // the Touch call name survives after optimization.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-forward-stack-field-loads-across-pure-call",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

noinline finite law i32[min max] Touch(i32[min max] value)
{
    return value + 1;
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    stack i32[min max] ignored = Touch(value);
    return pair.Left;
}
""");
    return Succeeds(compiled) && OptimizedSsaContains(compiled, "Touch");
}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationKeepsStackFieldLoadsAcrossImpureCalls.
public unsafe fn bool AliasAwareMemoryOptimizationKeepsStackFieldLoadsAcrossImpureCallsImpl()
{
    // PORT-NOTE: original leaves Touch with default (impure) effects so it acts
    // as a memory barrier, and asserts the pair.Left load is kept across it (a
    // surviving SsaLoadIndirectRValue, return is the loaded value "v0"); reduced
    // to a successful optimized compile of the verbatim impure-call program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-keep-stack-field-loads-across-impure-call",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

noinline fn i32[min max] Touch()
{
    return 0;
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    stack i32[min max] ignored = Touch();
    return pair.Left;
}
""");
    return Succeeds(compiled);
}

