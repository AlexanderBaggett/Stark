}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationRemovesOverwrittenGlobalScalarStoresAcrossPureArgumentMemoryReadsWithScalarArguments.
public unsafe fn bool AliasAwareMemoryOptimizationRemovesOverwrittenGlobalScalarStoresAcrossPureArgumentMemoryReadsWithScalarArgumentsImpl()
{
    // PORT-NOTE: original passes only the scalar arg_value (not &Demo.Value) to a
    // pure-read-of-argument Demo.Read call, so the read cannot observe the global,
    // and asserts the dead first store of arg_value into Demo.Value is removed (a
    // single surviving SsaStoreGlobalInstruction with constant value 7); the text
    // bridge cannot enumerate the typed global-store list, so this is reduced to a
    // text signal that the pure Read call survives after optimization.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-remove-overwritten-global-stores-across-pure-arg-read-scalar",
        raw"""
module Demo

static mut i32[min max] Value = 0;

noinline finite law i32[min max] Read(i32[min max] value)
{
    return value + 1;
}

fn i32[min max] Run(i32[min max] value)
{
    Value = value;
    stack i32[min max] ignored = Read(value);
    Value = 7;
    return 0;
}
""");
    return Succeeds(compiled) && OptimizedSsaContains(compiled, "Read");
}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationKeepsPendingStackFieldStoresAcrossReadonlyReadsOfOtherLocals.
public unsafe fn bool AliasAwareMemoryOptimizationKeepsPendingStackFieldStoresAcrossReadonlyReadsOfOtherLocalsImpl()
{
    // PORT-NOTE: original stores arg_value into left.Value, then makes a
    // pure-read-of-argument Demo.Read call passing &right.Value (a disjoint
    // local), then stores 7 into left.Value, and asserts the pending store
    // survives the readonly read of the other local (a single surviving
    // SsaStoreIndirectInstruction with constant value 7); the text bridge cannot
    // enumerate the typed store list, so this is reduced to a successful
    // optimized compile of the verbatim other-local-read program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-keep-pending-stack-field-stores-across-readonly-other-local",
        raw"""
module Demo

record Box(i32[min max] Value, i32[min max] Other)
{
}

noinline finite law i32[min max] Read(rawptr<i32[min max]> value)
{
    return *value;
}

unsafe fn i32[min max] Run(i32[min max] value)
{
    stack mut Box left = new Box(0, 0);
    left.Value = value;
    stack mut Box right = new Box(0, 0);
    stack i32[min max] ignored = Read(&right.Value);
    left.Value = 7;
    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationKeepsPendingSiblingFieldStoresAcrossReadonlyFieldReads.
public unsafe fn bool AliasAwareMemoryOptimizationKeepsPendingSiblingFieldStoresAcrossReadonlyFieldReadsImpl()
{
    // PORT-NOTE: original stores arg_value into right.Other, makes a
    // pure-read-of-argument Demo.Read call passing the sibling &right.Value, then
    // stores 7 into right.Other, and asserts the pending sibling store survives
    // the readonly read of the disjoint field (a single surviving
    // SsaStoreIndirectInstruction targeting right_other_address with constant 7);
    // the text bridge cannot enumerate the typed store list, so this is reduced
    // to a successful optimized compile of the verbatim sibling-field-read
    // program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-keep-pending-sibling-field-stores-across-readonly-field-read",
        raw"""
module Demo

record Box(i32[min max] Value, i32[min max] Other)
{
}

noinline finite law i32[min max] Read(rawptr<i32[min max]> value)
{
    return *value;
}

unsafe fn i32[min max] Run(i32[min max] value)
{
    stack mut Box right = new Box(0, 0);
    right.Other = value;
    stack i32[min max] ignored = Read(&right.Value);
    right.Other = 7;
    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationKeepsPendingSiblingFieldStoresAcrossExactFieldCopies.
public unsafe fn bool AliasAwareMemoryOptimizationKeepsPendingSiblingFieldStoresAcrossExactFieldCopiesImpl()
{
    // PORT-NOTE: original stores arg_value into right.Other, copies right.Value
    // into left.Value (an exact field copy reading the sibling), then stores 7
    // into right.Other, and asserts the pending sibling store survives the copy
    // (a single surviving SsaStoreIndirectInstruction targeting right_other_address
    // with constant 7, plus the surviving SsaCopyMemoryInstruction); the text
    // bridge cannot enumerate the typed store/copy lists, so this is reduced to a
    // successful optimized compile of the verbatim exact-field-copy program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-keep-pending-sibling-field-stores-across-exact-copy",
        raw"""
module Demo

record Box(i32[min max] Value, i32[min max] Other)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Box left = new Box(0, 0);
    stack mut Box right = new Box(0, 0);
    right.Other = value;
    left.Value = right.Value;
    right.Other = 7;
    return 0;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaOptimizationTests.ScalarReplacementRemovesDeadStackFieldStores.
public unsafe fn bool ScalarReplacementRemovesDeadStackFieldStoresImpl()
{
    // PORT-NOTE: original runs the scalar replacement optimizer and asserts the
    // store to the never-read pair.Left field is removed (empty surviving
    // SsaStoreIndirectInstruction list); the text bridge cannot enumerate the
    // typed store list, so this is reduced to a successful optimized compile plus
    // a text signal that the dead "pair.Left" store target no longer appears.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-sroa-removes-dead-stack-field-stores",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    return 0;
}
""");
    return Succeeds(compiled) && OptimizedSsaLacks(compiled, "pair.Left");
}

// Ported from SsaOptimizationTests.ScalarReplacementKeepsStackFieldStoresObservedByLaterLoad.
public unsafe fn bool ScalarReplacementKeepsStackFieldStoresObservedByLaterLoadImpl()
{
    // PORT-NOTE: original runs scalar replacement on a store to pair.Left that is
    // observed by a later load of the same field and asserts the store survives
    // (a single surviving SsaStoreIndirectInstruction); the text bridge cannot
    // enumerate the typed store list, so this is reduced to a successful optimized
    // compile of the verbatim observed-store program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-sroa-keeps-stack-field-stores-observed-by-load",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run(i32[min max] value)
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = value;
    stack i32[min max] loaded = pair.Left;
    return loaded;
}
""");
    return Succeeds(compiled);
}

