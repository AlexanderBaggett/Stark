// Ported from SsaOptimizationTests.AliasAwareMemoryOptimizationKeepsStackFieldStoresAcrossReadonlyLocalMemoryCalls.
public unsafe fn bool AliasAwareMemoryOptimizationKeepsStackFieldStoresAcrossReadonlyLocalMemoryCallsImpl()
{
    // PORT-NOTE: original passes &pair.Left to a pure-read-of-argument Touch call
    // so the store to pair.Left is observable; it asserts both stores (1 and 11)
    // survive and the load forwards to constant 11. The text bridge cannot
    // enumerate the typed store list, so this is reduced to a successful
    // optimized compile of the verbatim readonly-local-memory program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-keep-stack-field-stores-across-readonly-local-memory",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

noinline finite law i32[min max] Touch(rawptr<i32[min max]> value)
{
    return *value;
}

unsafe fn i32[min max] Run()
{
    stack mut Pair pair = new Pair(0, 1);
    pair.Left = 1;
    stack i32[min max] ignored = Touch(&pair.Left);
    pair.Left = 11;
    return pair.Left;
}
""");
    return Succeeds(compiled);
}

