// Ported from SsaOptimizationTests.ScalarReplacementKeepsExactScalarFieldCopiesObservedByLaterLoad.
public unsafe fn bool ScalarReplacementKeepsExactScalarFieldCopiesObservedByLaterLoadImpl()
{
    // PORT-NOTE: original copies left.Left into right.Left and then loads
    // right.Left, so the copy is observed and must be kept (a single surviving
    // SsaCopyMemoryInstruction); the text bridge cannot enumerate the typed copy
    // list, so this is reduced to a successful optimized compile of the verbatim
    // observed-copy program.
    stack mut SsaCompile compiled = CompileOptimizedSsa(
        "optssa-p3-sroa-keeps-exact-scalar-field-copies-observed-by-load",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

fn i32[min max] Run()
{
    stack mut Pair left = new Pair(0, 1);
    stack mut Pair right = new Pair(0, 1);
    right.Left = left.Left;
    stack i32[min max] loaded = right.Left;
    return loaded;
}
""");
    return Succeeds(compiled);
}
