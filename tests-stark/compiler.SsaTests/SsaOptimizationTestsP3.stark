module Demo

static i32[min max] Value = 0;

noinline fn i32[min max] Touch()
{
    return 0;
}

fn i32[min max] Run()
{
    stack i32[min max] v0 = Value;
    stack i32[min max] ignored = Touch();
    stack i32[min max] v1 = Value;
    return v1;
}
""");
    return Succeeds(compiled);
}

