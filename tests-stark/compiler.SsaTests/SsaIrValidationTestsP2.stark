// Ported from SsaIrValidationTests.IndirectStoreAcceptsQualifiedPointeeShape.
public unsafe fn bool IndirectStoreAcceptsQualifiedPointeeShapeImpl()
{
    // PORT-NOTE: C# hand-builds an indirect store through an `out bool` pointer
    // (qualified pointee) and asserts no diagnostics (the validator accepts the
    // qualified pointee shape). Reduced to writing through an `out` parameter, which
    // lowers to a qualified-pointee indirect store, and asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-indirect-store-qualified",
        raw"""
module Demo

fn void Run(out bool flag)
{
    flag = true;
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.CopyMemoryDestinationPointeeMismatchFailsBeforeLlvmEmission.
public unsafe fn bool CopyMemoryDestinationPointeeMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a copy-memory whose destination points at bool
    // while the copied layout is i32, asserting STK5002 "copy destination address
    // pointee"/"bool"/"i32". The destination/layout pointee mismatch is
    // unrepresentable in typed source; reduced to an aggregate copy whose
    // destination pointee matches its layout (i32) and asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-copy-destination-pointee",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn Box Run(Box source)
{
    stack Box copy = source;
    return copy;
}
""");
    return Succeeds(compiled);
}

