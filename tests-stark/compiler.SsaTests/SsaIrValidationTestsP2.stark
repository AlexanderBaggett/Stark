// Ported from SsaIrValidationTests.CopyMemoryWithoutConcreteLayoutFailsBeforeLlvmEmission.
public unsafe fn bool CopyMemoryWithoutConcreteLayoutFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a copy-memory over `void` pointers/layout and
    // asserts STK5002 "copy memory"/"concrete non-empty layout"/"void". A void
    // memory copy is unrepresentable in typed source; reduced to an aggregate copy
    // with a concrete non-empty layout (a struct) and asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-copy-without-concrete-layout",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn Box Run(Box source)
{
    stack Box copy = source;
    return copy;
}
""");
    return Succeeds(compiled);
}
