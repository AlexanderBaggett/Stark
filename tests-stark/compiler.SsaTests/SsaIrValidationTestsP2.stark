        "ssa-val-fixedarray-ordered-compare",
        raw"""
module Demo

fn bool Run(i32[min max][2] left, i32[min max][2] right)
{
    return left < right;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.NamedOrderedComparisonUnsupportedFieldFailsBeforeHelperEmission.
public unsafe fn bool NamedOrderedComparisonUnsupportedFieldFailsBeforeHelperEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a GreaterThan over a named struct with a slice
    // field and asserts STK5002 "comparison operator 'GreaterThan'"/"named
    // aggregate operand"/"not supported by ordered comparison helper lowering".
    // Reduced to an ordered comparison over a named struct whose fields are all
    // orderable scalars (helper-supported), asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-named-ordered-compare",
        raw"""
module Demo

struct Comparable
{
    i32[min max] Count;
}

fn bool Run(Comparable left, Comparable right)
{
    return left > right;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.ExtractFieldResultMismatchFailsBeforeLlvmEmission.
public unsafe fn bool ExtractFieldResultMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a field extraction of Pair.Flag (a bool field at
    // index 1) declared with an i32 result and asserts STK5002 "field extraction
    // 'Flag' result"/"bool"/"i32". A field read whose result type disagrees with
    // the field type is unrepresentable in typed source; reduced to a real field
    // read whose result matches the field type and asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-extract-field-result",
        raw"""
module Demo

struct Pair
{
    i32[min max] Value;
    bool Flag;
}

fn bool Run(Pair pair)
{
    return pair.Flag;
}
""");
    return Succeeds(compiled);
}

