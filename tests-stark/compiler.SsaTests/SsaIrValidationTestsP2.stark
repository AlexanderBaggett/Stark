}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.ExtractIndexOutOfRangeIsUnrepresentable.
public unsafe fn bool ExtractIndexOutOfRangeIsUnrepresentableImpl()
{
    // PORT-NOTE: C# asserts the SsaExtractIndexRValue constructor THROWS
    // ArgumentOutOfRangeException when a constant index 2 is given for a length-2
    // fixed array (i.e. the out-of-range index is unrepresentable as an IR object).
    // No constructor invariant is reachable from the host bridge; reduced to
    // indexing a length-2 fixed array within range and asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-extract-index-range",
        raw"""
module Demo

fn i32[min max] Run(i32[min max][2] values)
{
    return values[1];
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.InsertIndexValueMismatchIsUnrepresentable.
public unsafe fn bool InsertIndexValueMismatchIsUnrepresentableImpl()
{
    // PORT-NOTE: C# asserts the SsaInsertIndexRValue constructor THROWS
    // ArgumentException when inserting a bool into an i32[2] (value type disagrees
    // with the element type, so the insert is unrepresentable as an IR object).
    // Reduced to a type-consistent element insert/assignment and asserting
    // Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-insert-index-value",
        raw"""
module Demo

unsafe fn void Run(mut i32[min max][2] values)
{
    values[1] = 7;
    return;
}
""");
    return Succeeds(compiled);
}

