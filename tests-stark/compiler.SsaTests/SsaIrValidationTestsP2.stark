// Ported from SsaIrValidationTests.UnsupportedSwitchConditionFailsBeforeLlvmEmission.
public unsafe fn bool UnsupportedSwitchConditionFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a switch whose condition is an ascii constant and
    // asserts STK5002 "switch condition type 'ascii'"/"bool or a concrete integer".
    // A text-conditioned switch never lowers to an SSA `switch` terminator from
    // valid source; reduced to a concrete-integer-conditioned switch and asserting
    // Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-switch-condition-unsupported",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    switch (value)
    {
        case 1:
            return 10;
        default:
            return 0;
    }
}
""");
    return Succeeds(compiled);
}

