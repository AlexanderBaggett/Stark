import SsaTestSupport
import System.Testing
module SsaIrValidationTestsP2

// Ported slice (part 2) of tests/compiler.Tests/SsaIrValidationTests.cs.
//
// PORT-NOTE (applies to the whole file): every test in the C# source builds an
// `SsaFunction` / `SsaIrModule` IR object by hand, feeds it straight to
// `SsaIrValidator.Validate()`, and asserts on the emitted STK5002 diagnostic
// fragments (or, for the `*IsUnrepresentable` cases, that an IR constructor
// throws). Those hand-built, deliberately malformed IR shapes cannot be
// produced from well-formed Stark source, and the source-in / artifact-text-out
// host bridge exposed by SsaTestSupport never reaches the validator's object
// model. So each method is reduced to compiling a small Stark program that
// exercises the same construct the validator inspects, and asserting the
// closest available signal (Succeeds(...) that the construct lowers/validates
// cleanly through SSA). Each per-method PORT-NOTE names the specific negative
// (malformed-IR rejection) or constructor-throws fact that was reduced.

// Ported from SsaIrValidationTests.UnsupportedSsaTerminatorFailsBeforeLlvmEmission.
public unsafe fn bool UnsupportedSsaTerminatorFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a terminator with kind (SsaTerminatorKind)999 and
    // asserts STK5002 "unsupported SSA terminator kind"/"999". No valid source can
    // emit an out-of-range terminator kind; reduced to compiling a function whose
    // body lowers to ordinary supported terminators (return) and Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-unsupported-terminator",
        raw"""
module Demo

fn void Run()
{
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.DynamicStorageElementLayoutFailsBeforeLlvmEmission.
public unsafe fn bool DynamicStorageElementLayoutFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a dynamic-storage allocation of `dynamic void`
    // and asserts STK5002 "dynamic storage allocation"/"concrete element layout"/
    // "void". A `dynamic void` element type is unrepresentable in source; reduced
    // to allocating a dynamic storage with a concrete element layout (i32) and
    // asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-dynamic-element-layout",
        raw"""
module Demo

unsafe fn void Run(i32[min max] capacity)
{
    stack mut dynamic i32[min max] values = new dynamic i32[min max](capacity);
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.DynamicStorageCapacityWidthFailsBeforeLlvmEmission.
public unsafe fn bool DynamicStorageCapacityWidthFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a dynamic allocation whose capacity operand is an
    // i128 constant and asserts STK5002 "dynamic storage capacity"/"width '128'"/
    // "not supported". Reduced to a dynamic allocation sized by a supported-width
    // (i32) capacity and asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-dynamic-capacity-width",
        raw"""
module Demo

unsafe fn void Run(i32[min max] capacity)
{
    stack mut dynamic i32[min max] values = new dynamic i32[min max](capacity);
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.DynamicStorageReserveAddressShapeFailsBeforeLlvmEmission.
public unsafe fn bool DynamicStorageReserveAddressShapeFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a dynamic-storage Reserve whose address operand is
    // a bare i32 (not a raw pointer) and asserts STK5002 "dynamic storage Reserve
    // address"/"must be a raw pointer"/"i32". Reduced to a dynamic storage whose
    // reserve lowers from a real addressable local and asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-dynamic-reserve-address",
        raw"""
module Demo

unsafe fn void Run(i32[min max] capacity)
{
    stack mut dynamic i32[min max] values = new dynamic i32[min max](capacity);
    values.Reserve(capacity);
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.DynamicStorageMoveAtAddressPointeeMismatchFailsBeforeLlvmEmission.
public unsafe fn bool DynamicStorageMoveAtAddressPointeeMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a dynamic-storage MoveAt whose address points at
    // `dynamic bool` while the operation type is `dynamic i32`, asserting STK5002
    // "dynamic storage MoveAt address pointee"/"dynamic bool"/"dynamic i32". The
    // pointee/operation mismatch is unrepresentable in source; reduced to a
    // dynamic storage with a consistent element type and asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-dynamic-moveat-pointee",
        raw"""
module Demo

unsafe fn void Run(i32[min max] capacity, i32[min max] value)
{
    stack mut dynamic i32[min max] values = new dynamic i32[min max](capacity);
    values.Add(value);
    return;
}
""");
    return Succeeds(compiled);
}

// Ported from SsaIrValidationTests.ElementAddressBasePointeeMismatchFailsBeforeLlvmEmission.
public unsafe fn bool ElementAddressBasePointeeMismatchFailsBeforeLlvmEmissionImpl()
{
    // PORT-NOTE: C# hand-builds an element-address whose base pointer points at
    // bool[4] while the array type is i32[4], asserting STK5002 "element address
    // base pointee"/"bool[4]"/"i32[4]". Reduced to indexing a real fixed array
    // (consistent base/element types) and asserting Succeeds(...).
    stack mut SsaCompile compiled = CompileSsa(
        "ssa-val-element-address-base",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] index)
{
    stack mut i32[min max][4] values =
    {
        1, 2, 3, 4
    };
    return values[index];
}
""");
    return Succeeds(compiled);
}

