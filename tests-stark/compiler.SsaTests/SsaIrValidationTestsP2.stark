// Ported from SsaIrValidationTests.FixedArrayOrderedComparisonUnsupportedElementFailsBeforeHelperEmission.
public unsafe fn bool FixedArrayOrderedComparisonUnsupportedElementFailsBeforeHelperEmissionImpl()
{
    // PORT-NOTE: C# hand-builds a LessThan over a fixed array of slices and asserts
