import CompilerMirTestSupport
import System.Testing
module CompilerPipelineLowerMirTests

// Ported from CompilerPipelineLowerMirTests.ExplicitConstructorBodiesLowerIntoObjectCreation.
// PORT-NOTE: the C# original inspects the typed MIR object graph (counts
// MidLevelIrInsertFieldRValue with FieldName "Value" >= 2, and two
// MidLevelIrObjectConstructionOperand with ExplicitConstructor kind / non-empty
// ConstructorBodyKey). The text helpers cannot reach the object graph, so we
// assert over the rendered MIR text: the program lowers cleanly, the `Run`
// function is direct-codegen, and both the "Value" field inserts and the
// explicit-constructor object constructions appear.
internal fn bool ExplicitConstructorBodiesLowerIntoObjectCreationImpl()
{
    stack mut MirCompile c = CompileMir(
        "lowermir-p1-explicit-ctor-object-creation",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;

    Box()
    {
        self.Value = 41;
    }

    Box(i32[min max] value)
    {
        self.Value = value + 1;
    }
}

fn i32[min max] Run(i32[min max] value)
{
    stack Box defaultBox = new();
    stack Box constructedBox = new(value);
    return defaultBox.Value + constructedBox.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "direct-codegen: true")
        && MirOccurrences(c, "Value") >= 2
        && MirOccurrences(c, "ExplicitConstructor") >= 2;
}

// Ported from CompilerPipelineLowerMirTests.LowerMirSubstitutesConcreteTypesInsideMaterializedGenericBodies.
// PORT-NOTE: the C# original reaches into the materialized function object
// (HasBody, SupportsDirectCodeGeneration, ReturnType/Parameter DisplayName "i32",
// and a local "copy" of type "i32"). Over the rendered MIR text we assert the
// monomorphized symbol is present, is direct-codegen, and carries the concrete
// i32 substitution for the `copy` local.
internal fn bool LowerMirSubstitutesConcreteTypesInsideMaterializedGenericBodiesImpl()
{
    stack mut MirCompile c = CompileMir(
        "lowermir-p1-substitute-concrete-generic-body",
        raw"""
module Demo

fn T Identity<T>(T value)
{
    stack T copy = value;
    return copy;
}

fn i32[min max] Run(i32[min max] value)
{
    return Identity(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return MirContainsAll3(c, "__stark_mono_fn_Demo__Identity__i32", "direct-codegen: true", "copy")
        && MirContains(c, "i32");
}

// Ported from CompilerPipelineLowerMirTests.LowerMirRewritesGenericCallsToMaterializedSpecializationSymbols.
// PORT-NOTE: the C# original walks the `Run` function's statements and asserts
// the single MidLevelIrCallRValue targets FunctionName
// "__stark_mono_fn_Demo__Identity__i32". Over the rendered MIR text we assert the
// program lowers cleanly and the materialized specialization symbol appears as a
// call target.
internal fn bool LowerMirRewritesGenericCallsToMaterializedSpecializationSymbolsImpl()
{
    stack mut MirCompile c = CompileMir(
        "lowermir-p1-rewrite-generic-call-specialization",
        raw"""
module Demo

fn T Identity<T>(T value)
{
    return value;
}

fn i32[min max] Run(i32[min max] value)
{
    return Identity(value);
}
""");
    return MirContains(c, "__stark_mono_fn_Demo__Identity__i32");
}
