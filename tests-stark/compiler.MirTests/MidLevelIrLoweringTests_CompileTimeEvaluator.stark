import CompilerMirTestSupport
import System.Testing
module MidLevelIrLoweringTests_CompileTimeEvaluator

// Ported from MidLevelIrLoweringTests.CompileTimeEvaluator.PureConstantArithmeticReturnsFoldedMirConstant.
// PORT-NOTE: the C# test inspects the object model (single function/block, empty
// statements, terminator value is a MidLevelIrIntegerConstantOperand == 9). Over
// the rendered MIR text plus compact return-value facts we assert the folded
// return value 9 is present and no binary arithmetic operation survived.
internal fn bool PureConstantArithmeticReturnsFoldedMirConstantImpl()
{
    stack mut MirCompile c = CompileMir(
        "cte-pure-constant-arith",
        raw"""
        module Demo

        unsafe fn i32[min max] Run()
        {
            return (1 + 2) * 3;
        }
        """);

    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "value: int 9 i32")
        && MirDoesNotContain(c, "_bin");
}

// Ported from MidLevelIrLoweringTests.CompileTimeEvaluator.ConstantIntegerExponentComparisonOperandFoldsBeforeMirWidthSelection.
// PORT-NOTE: the C# test asserts no MidLevelIrBinaryRValue with Exponent survives,
// that exactly one GreaterThan comparison exists, and that its right operand is the
// folded constant 2 ** 61 - 1 with a 64-bit type. Over the rendered MIR text we
// assert the greater-than binary op is present, no exponent op (`_pow`) survived,
// and the folded right operand 2305843009213693951 has the expected 64-bit type.
internal fn bool ConstantIntegerExponentComparisonOperandFoldsBeforeMirWidthSelectionImpl()
{
    stack mut MirCompile c = CompileMir(
        "cte-exponent-cmp-fold",
        raw"""
        module Demo

        unsafe fn bool Run(u64[0 2 ** 63 - 1] count)
        {
            if (count > 2 ** 61 - 1)
            {
                return true;
            }

            return false;
        }
        """);

    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "rvalue: binary GreaterThan bool")
        && MirDoesNotContain(c, "_pow")
        && MirContains(c, "right:int 2305843009213693951 i64");
}

// Ported from MidLevelIrLoweringTests.CompileTimeEvaluator.ConstantLawCallsFoldToMirConstants.
// PORT-NOTE: the C# test inspects the object model for the "Run" function (single
// block, empty statements, terminator value is a folded integer constant == 7).
// Over the rendered MIR text plus compact return-value facts we assert the
// folded return value 7 is present in Run and no direct call survived.
internal fn bool ConstantLawCallsFoldToMirConstantsImpl()
{
    stack mut MirCompile c = CompileMir(
        "cte-constant-law-fold",
        raw"""
        module Demo

        unsafe finite law i32[min max] Adjust(i32[min max] value)
        {
            stack mut i32[min max] current = value;
            if (current < 10)
            {
                current = current + 3;
            }

            return current;
        }

        unsafe fn i32[min max] Run()
        {
            return Adjust(4);
        }
        """);

    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "value: int 7 i32")
        && MirDoesNotContain(c, "= Adjust(4)");
}

// Ported from MidLevelIrLoweringTests.CompileTimeEvaluator.BackendOpaqueLawCallsDoNotFoldToMirConstants.
// PORT-NOTE: the C# test asserts the "Run" block contains a direct call statement
// to `Adjust` (IsDirectCallStatement). A [Backend(Opaque)] law is not folded by the
// compile-time evaluator. Over the rendered MIR text we assert the direct call to
// `Adjust(4)` survives in Run and that the folded constant 7 does NOT appear.
internal fn bool BackendOpaqueLawCallsDoNotFoldToMirConstantsImpl()
{
    stack mut MirCompile c = CompileMir(
        "cte-opaque-law-no-fold",
        raw"""
        module Demo

        [Backend(Opaque)]
        unsafe finite law i32[min max] Adjust(i32[min max] value)
        {
            return value + 3;
        }

        unsafe fn i32[min max] Run()
        {
            return Adjust(4);
        }
        """);

    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "Adjust(4)")
        && MirDoesNotContain(c, "return 7");
}

// Ported from MidLevelIrLoweringTests.CompileTimeEvaluator.FixedArrayArithmeticIndexStillLowersToAggregateIndexOperations.
// PORT-NOTE: the C# test asserts the single block contains a MidLevelIrInsertIndexRValue,
// a MidLevelIrExtractIndexRValue with ElementIndex == 2 (the folded constant index
// 1 + 1), and NO MidLevelIrBinaryRValue. Over the rendered MIR text we assert the
// aggregate insert/extract index operations render, the folded element index 2 is
// used by the extract-index rvalue, and no binary arithmetic op survived.
internal fn bool FixedArrayArithmeticIndexStillLowersToAggregateIndexOperationsImpl()
{
    stack mut MirCompile c = CompileMir(
        "cte-fixed-array-fold-index",
        raw"""
        module Demo

        unsafe fn i32[min max] Run()
        {
            stack i32[min max][3] values =
            {
                1, 2, 3
            };
            return values[1 + 1];
        }
        """);

    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "_insertindex")
        && MirContains(c, "rvalue: extract-index FixedArrayElement 2 i32")
        && MirDoesNotContain(c, "_bin");
}
