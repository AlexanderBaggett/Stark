import CompilerMirTestSupport
import System.Testing
module MidLevelIrDynamicFixedArrayIndexingTests

// Ported from MidLevelIrDynamicFixedArrayIndexingTests.DynamicIndexingOnFixedArrayTemporaryLowersWithoutUnsupportedFallback.
// PORT-NOTE: the C# test inspects the MidLevelIrModule object model: it asserts
// the single function reports SupportsDirectCodeGeneration and that its block
// statements include MidLevelIrAddressOfLocalRValue, MidLevelIrElementAddressRValue,
// and MidLevelIrLoadIndirectRValue, and that no "unsupported-lowering" log
// (category "lowering", stage "lower-mir", operation "LowerIndexAccess") was
// emitted. The MIR-text helpers here cannot reach the structured log stream or
// the typed rvalue object model, so those checks are reduced to the rendered MIR
// text: direct code generation ("direct-codegen: true", which also stands in for
// the no-unsupported-fallback assertion), the fixed-array addressable temporary
// ("_indexbase: temp i32[3] addr"), the address-of ("_addr = &") and the indirect
// load ("_load = ").
internal fn bool DynamicIndexingOnFixedArrayTemporaryLowersWithoutUnsupportedFallbackImpl()
{
    stack mut MirCompile c = CompileMir(
        "mir-dyn-fixed-array-index-temp",
        raw"""
        module Demo

        unsafe fn i32[min max] Run(i32[min max] index)
        {
            return (new i32[min max][3])[index];
        }
        """);

    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "_indexbase: temp i32[3] addr")
        && MirContains(c, "_addr = &")
        && MirContains(c, "_load = ");
}
