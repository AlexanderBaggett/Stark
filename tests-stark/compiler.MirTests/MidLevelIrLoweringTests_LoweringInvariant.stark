import CompilerMirTestSupport
import System.Testing
module MidLevelIrLoweringTests_LoweringInvariant

// Ported from MidLevelIrLoweringTests.LoweringInvariant.AcceptedBoundOperationsDoNotProduceNullMirArtifacts.
// PORT-NOTE: the C# original stops after "lower-mir", then asserts result.Succeeded,
// no fallback logs (FallbackLogAssertions.AssertNoFallbackLogs), no null lowering
// artifacts (AssertMirHasNoNullLoweringArtifacts), and that every function with a
// body reports SupportsDirectCodeGeneration. The MIR text helpers cannot inspect the
// fallback log or the function object model, so those three structural assertions are
// reduced to their nearest text signals: a clean compile (Succeeds), at least one
// "direct-codegen: true" body, and the absence of any "direct-codegen: false" body
// (a fallback/non-direct lowering would render that marker).
internal fn bool AcceptedBoundOperationsDoNotProduceNullMirArtifactsImpl()
{
    stack mut MirCompile c = CompileMir(
        "mir-invariant-accepted-bound-operations",
        raw"""
module System.Text

public finite law ascii AsciiView(Ascii source);
public unsafe finite bool TryConcatAscii(rawmutptr<Ascii> destination, ascii left, ascii right);

enum Status
{
    Ok,
    Err(i32[min max]),
}

struct Box
{
    i32[min max] Value;

    fn i32[min max] Get(borrow Box self)
    {
        return self.Value;
    }
}

fn i32[min max] Inc(i32[min max] value)
{
    return value + 1;
}

unsafe fn i32[min max] Apply(fnptr<fn i32[min max](i32[min max])> op, i32[min max] value)
{
    return op(value);
}

fn i32[min max] Score(Status status)
{
    switch (status)
    {
        case Status.Ok:
            return 1;
        case Status.Err(var error):
            return error;
    }
}

unsafe fn i32[min max] Run(bool flag)
{
    stack mut Box box = new Box()
    {
        Value = 3
    };
    stack mut i32[min max][2] values =
    {
        4, 5
    };
    stack fnptr<fn i32[min max](i32[min max])> lambda = (i32[min max] value) => Inc(value);
    stack closure<finite law i32[min max](i32[min max])> closureOp =
        (i32[min max] value) => value + 6;
    stack mut dynamic u32[0 max] items = new(1);
    stack i64[min max] boxSize = sizeof(Box);
    stack Ascii label[8] = $"ok";
    stack Ascii joined[12] = label + "!";
    values[0] = Inc(box.Get());
    items.Reserve(1);
    if (flag)
    {
        return values[0] + Apply(Inc, 2) + Apply(lambda, 3) + closureOp(6) + Score(Status.Err(4));
    }

    return values[1] + Score(Status.Ok);
}
""");
    return Succeeds(c)
        && MirContains(c, "direct-codegen: true")
        && MirDoesNotContain(c, "direct-codegen: false");
}
