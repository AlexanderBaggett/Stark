""");

    return Succeeds(small)
        && MirContainsAll2(small, "$tag", "$Unknown_0")
        && Succeeds(medium)
        && MirContains(medium, "$tag");
}

// Ported from CompilerPipelineEnumLayoutTests.EnumPayloadLayoutsUseTargetSoundAlignmentForNonStandardAndWideIntegers.
public unsafe fn bool EnumPayloadLayoutsUseTargetSoundAlignmentForNonStandardAndWideIntegersImpl()
{
    // PORT-NOTE: the C# original asserts the ConcreteTypeLayout (size, alignment)
    // of each payload via ConcreteTypeLayoutHelper: I24 -> (3, 4), I48 -> (6, 8),
    // I96 -> (12, 16), I192 -> (24, 16), and the whole WidePayload enum ->
    // size 64 / alignment 16. The MIR-text harness exposes neither byte sizes nor
    // alignments, so those facts are reduced to: the program compiles and the
    // ordered enum field names ($tag plus each $I*_0 payload slot) appear in the
    // lowered text.
    stack mut MirCompile c = CompileMir(
        "enum-layout-wide-payload-alignment",
        raw"""
module Facade

public enum WidePayload
{
    Empty,
    I24(i24[min max]),
    I48(i48[min max]),
    I96(i96[min max]),
    I192(i192[min max]),
}
""");

    return Succeeds(c)
        && MirContainsAll4(c, "$tag", "$I24_0", "$I48_0", "$I96_0")
        && MirContains(c, "$I192_0");
}
