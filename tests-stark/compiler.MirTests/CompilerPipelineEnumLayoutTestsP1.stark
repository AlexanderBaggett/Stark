import CompilerMirTestSupport
import System.Testing
module CompilerPipelineEnumLayoutTestsP1

// Ported slice of tests/compiler.PipelineTests/CompilerPipelineEnumLayoutTests.cs.
// The C# originals run the full compiler pipeline stopping after the
// "enum-layout" pass and assert over the EnumLayoutModel / ConcreteTypeLayout
// object graph (tag bit widths, max tag values, ordered field names, and
// concrete payload size/alignment in bytes). The Stark MIR test harness only
// exposes the rendered `mir` artifact text, so these ports compile the same
// embedded programs to MIR and assert over the field names that surface in the
// lowered text ($tag, $Unknown_0, $I24_0, ...), guarding with Succeeds.
// PORT-NOTE on each body names the numeric object-model facts that could not be
// expressed through the available MIR-text helpers.

// Ported from CompilerPipelineEnumLayoutTests.EnumLayoutsUseSmallestSoundTagWidths.
public unsafe fn bool EnumLayoutsUseSmallestSoundTagWidthsImpl()
{
    // PORT-NOTE: the C# original asserts the EnumLayoutModel tag types directly:
    // MemoryError -> compact tag bitWidth 8 / maxTagValue 3, IOError -> bitWidth 8 /
    // maxTagValue 6, BigStatus (257 variants) -> bitWidth 16 / maxTagValue 256.
    // The MIR-text harness cannot read tag bit widths or range bounds, so the
    // smallest-sound-tag-width facts are reduced to: the programs compile and the
    // expected $tag / payload field names ($Unknown_0) appear in the lowered text.
    stack mut MirCompile small = CompileMir(
        "enum-layout-smallest-tag-small",
        raw"""
module Facade

public enum MemoryError
{
    OutOfMemory,
    InvalidLayout,
    UnsupportedAlignment,
    TooLarge,
}

public enum IOError
{
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidPath,
    BrokenPipe,
    DiskFull,
    Unknown(i32[min max]),
}
""");

    stack mut MirCompile medium = CompileMir(
        "enum-layout-smallest-tag-medium",
        raw"""
module Facade

public enum BigStatus
{
    Case0,
    Case1,
    Case2,
    Case3,
    Case4,
    Case5,
    Case6,
    Case7,
    Case8,
    Case9,
    Case10,
    Case11,
    Case12,
    Case13,
    Case14,
    Case15,
