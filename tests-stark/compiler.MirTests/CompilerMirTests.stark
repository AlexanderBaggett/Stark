[Collection("compiler-mir")]
module CompilerMirTests

// Ported slice of tests/compiler.Tests/MidLevelIrLowering and
// tests/compiler.Tests/MidLevelIrDynamicFixedArrayIndexingTests, running
// against the current C# host compiler through the host test protocol. Each
// fact compiles a small program stopping after the "lower-mir" pass and asserts
// over the rendered `mir` artifact text. Requires STARK_HOST_COMPILER to point
// at the host compiler executable. The runner collects [Fact]s from this root
// file only; the bodies live in CompilerMirTestSupport.
//
// Object-model-only C# tests (those that build MidLevelIr/Ssa objects directly
// or assert over the typed object graph rather than source->text) are NOT
// ported; see the agent report for the skip list.

