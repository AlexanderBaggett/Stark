import CompilerMirTestSupport
import System.Testing
module CompilerCliTests

// Ported from CompilerCliTests.EmitMirModePrintsMirModule.
internal fn bool EmitMirModePrintsMirModuleImpl()
{
    stack mut MirCompile c = CompileMir(
        "cli-emit-mir-prints",
        raw"""
module Demo

fn i32[min max] Run(bool flag)
{
    return flag ? 1 : 2;
}
""");
    // PORT-NOTE: original asserted exitCode == 0, empty stderr, and CLI stdout
    // text; reduced to the rendered MIR artifact text fragments via MirContainsAll3.
    return MirContainsAll3(c, "mir module Demo", "fn i32 Run(bool flag)", "blocks:");
}

// Ported from CompilerCliTests.EmitMirModeSupportsOutputPath.
internal fn bool EmitMirModeSupportsOutputPathImpl()
{
    stack mut MirCompile c = CompileMir(
        "cli-emit-mir-output-path",
        raw"""
module Demo

fn i32[min max] Run()
{
    return 7;
}
""");
    // PORT-NOTE: original asserted exitCode == 0, empty stdout/stderr, and that
    // the MIR was written to the `-o` output file containing "mir module Demo";
    // file-system effects and the CLI process are not expressible through the
    // compile helpers, so this is reduced to compiling the same program and
    // checking the rendered MIR artifact contains "mir module Demo".
    return MirContains(c, "mir module Demo");
}
