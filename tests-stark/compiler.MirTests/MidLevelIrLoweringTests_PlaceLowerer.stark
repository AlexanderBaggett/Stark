module Demo

unsafe fn ascii PickAscii(ascii text, i32[min max] index)
{
    return text[index];
}

unsafe fn unicode PickUnicode(unicode text, i32[min max] index)
{
    return text[index];
}
""");
    return MirContainsAll2(c, "direct-codegen: true", "text[index");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.DynamicFixedArrayIndexMutationUsesAddressBasedMemoryAccess.
internal fn bool DynamicFixedArrayIndexMutationUsesAddressBasedMemoryAccessImpl()
{
    // PORT-NOTE: the AddressOfLocalRValue, ElementAddressRValue, StoreIndirect, and
    // LoadIndirectRValue subtype checks are reduced to: direct codegen, the addressable
    // "values" local, the address-of-local "&values", a store-indirect, and an indirect
    // load (":load").
    stack mut MirCompile c = CompileMir(
        "place-dynamic-fixed-array-index-mutation",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] index)
{
    stack mut i32[min max][3] values =
    {
        1, 2, 3
    };
    values[index] = 9;
    return values[index];
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "values: stack")
        && MirContains(c, "&values")
        && MirContains(c, "store-indirect")
        && MirContains(c, ":load");
}

