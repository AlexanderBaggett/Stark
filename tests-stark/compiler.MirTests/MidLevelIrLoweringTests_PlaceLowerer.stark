// Ported from MidLevelIrLoweringTests.PlaceLowerer.NestedLvalueChainsWithDynamicIndexCompoundAssignmentsUseAddressBasedMemoryAccess.
internal fn bool NestedLvalueChainsWithDynamicIndexCompoundAssignmentsUseAddressBasedMemoryAccessImpl()
{
    // PORT-NOTE: the FieldAddressRValue, ElementAddressRValue, BinaryRValue{Add}, and
    // StoreIndirect checks are reduced to: direct codegen, the addressable "holder"
    // local, address temps for &holder/.Cells/[index]/.Value, the compound-add
    // text, and a store-indirect.
    stack mut MirCompile c = CompileMir(
        "place-nested-lvalue-dynamic-index-compound",
        raw"""
module Demo

struct Cell
{
    i32[min max] Value;
}

struct Holder
{
    Cell[2] Cells;
}

unsafe fn i32[min max] Run(i32[min max] index)
{
    stack mut Holder holder = new Holder()
    {
        Cells =
        {
            new Cell()
            {
                Value = 1
            },
            new Cell()
            {
                Value = 2
            }
        }
    };
    holder.Cells[index].Value += 4;
    return holder.Cells[index].Value;
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "holder: stack Holder mut addr")
        && MirContainsAll3(c, "rawmutptr<Cell[2]>", "rawmutptr<Cell>", "rawmutptr<i32>")
        && MirContains(c, "= &holder")
        && MirContainsAll3(c, ".Cells", "[index]", ".Value")
        && MirContains(c, "_compound = holder.Cells[index].Value += 4")
        && MirContains(c, "store-indirect");
}

