// Ported from MidLevelIrLoweringTests.PlaceLowerer.LargeFixedArrayConstantIndexReadsAndWritesUseAddressBasedMemoryAccess.
internal fn bool LargeFixedArrayConstantIndexReadsAndWritesUseAddressBasedMemoryAccessImpl()
{
    // PORT-NOTE: the AddressOfLocalRValue{values}, ElementAddressRValue{ConstantIndex:7},
    // StoreIndirect, and LoadIndirectRValue subtype checks (plus the DoesNotContain
    // InsertIndexRValue for "values[7] = 42") are reduced to: direct codegen, the
    // addressable local, address temps for &values/[7], a store-indirect, and an
    // indirect load.
    stack mut MirCompile c = CompileMir(
        "place-large-fixed-array-const-index",
        raw"""
module Demo

unsafe fn i8[min max] Run()
{
    stack mut i8[min max][256] values;
    values[7] = 42;
    return values[7];
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "values: stack i8[256] mut addr")
        && MirContainsAll2(c, "rawmutptr<i8[256]>", "rawmutptr<i8>")
        && MirContains(c, "= &values")
        && MirContains(c, "[7]")
        && MirContains(c, "store-indirect")
        && MirContains(c, ":load");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.LargeAggregateFieldAndConstantIndexReadsAndWritesUseAddressBasedMemoryAccess.
internal fn bool LargeAggregateFieldAndConstantIndexReadsAndWritesUseAddressBasedMemoryAccessImpl()
{
    // PORT-NOTE: the AddressOfLocalRValue{big}, FieldAddressRValue{Data},
    // ElementAddressRValue{ConstantIndex:7}, StoreIndirect, and LoadIndirectRValue
    // checks (plus DoesNotContain InsertFieldRValue) are reduced to: direct codegen,
    // the addressable local, address temps for &big/.Data/[7], a store-indirect,
    // and an indirect load.
    stack mut MirCompile c = CompileMir(
        "place-large-aggregate-field-const-index",
        raw"""
module Demo

struct Big
{
    i8[min max][256] Data;
    i32[min max] Count;
}

unsafe fn i8[min max] Run()
{
    stack mut Big big = new Big()
    {
        Data =
        {
            0
        },
        Count = 0
    };
    big.Data[7] = 42;
    return big.Data[7];
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "big: stack Big mut addr")
        && MirContainsAll2(c, "rawmutptr<i8[256]>", "rawmutptr<i8>")
        && MirContains(c, "= &big")
        && MirContains(c, ".Data")
        && MirContains(c, "[7]")
        && MirContains(c, "store-indirect")
        && MirContains(c, ":load");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.LocalFixedArrayCanLowerToSliceAndDynamicSliceRead.
internal fn bool LocalFixedArrayCanLowerToSliceAndDynamicSliceReadImpl()
{
    // PORT-NOTE: the MakeSliceFromLocalRValue, SliceElementAddressRValue, and
    // LoadIndirectRValue subtype checks are reduced to: direct codegen, the
    // addressable "values" and "view" locals, the slice creation from values, the
    // indexed slice address, and an indirect load.
    stack mut MirCompile c = CompileMir(
        "place-local-fixed-array-slice-read",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] index)
{
    stack i32[min max][3] values =
    {
        4, 7, 9
    };
    stack i32[min max][] view = values;
    return view[index];
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "values: stack i32[3] addr")
        && MirContains(c, "view: stack i32[] addr")
        && MirContains(c, "values:slice")
        && MirContains(c, "view[index]")
        && MirContains(c, "view:load");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.InitSliceElementAssignmentCarriesInitializationWriteKindInMir.
internal fn bool InitSliceElementAssignmentCarriesInitializationWriteKindInMirImpl()
{
    // PORT-NOTE: the C# asserts a StoreIndirect statement with
    // WriteKind==Initialization carrying source text "init destination[0] = 7".
    // The renderer emits Initialization stores as "init-store-indirect <value> -> <addr>"
    // (the source text is not retained on the store statement), so this is matched as
    // the rendered "init-store-indirect 7" fragment.
    stack mut MirCompile c = CompileMir(
        "place-init-slice-element-assign",
        raw"""
module Demo

unsafe fn void Fill(init u32[0 max][] destination)
{
    init destination[0] = 7;
    return;
}
""");
    return MirContains(c, "init-store-indirect 7");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.OutParameterAssignmentCarriesInitializationWriteKindInMir.
internal fn bool OutParameterAssignmentCarriesInitializationWriteKindInMirImpl()
{
    // PORT-NOTE: the C# asserts a StoreIndirect with WriteKind==Initialization carrying
    // "value = 7". The renderer drops the source text on indirect stores, so this is
    // matched as the rendered "init-store-indirect 7" fragment (Initialization write of 7).
    stack mut MirCompile c = CompileMir(
        "place-out-parameter-assign",
        raw"""
module Demo

fn void Write(out u32[0 max] value)
{
    value = 7;
    return;
}
""");
    return MirContains(c, "init-store-indirect 7");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.TextSlicesLowerToViewProducingMir.
internal fn bool TextSlicesLowerToViewProducingMirImpl()
{
    // PORT-NOTE: the TextSliceRValue subtype check (Ascii type, 64-bit Start/Length)
    // is reduced to: direct codegen plus the rendered text-slice operand "text[start"
    // (the slice over the ascii parameter with start/length operands).
    stack mut MirCompile c = CompileMir(
        "place-text-slice-view",
        raw"""
module Demo

unsafe fn ascii Run(ascii text, i32[min max] start, i32[min max] length)
{
    return text[start, length];
}
""");
    return MirContainsAll2(c, "direct-codegen: true", "text[start");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.EmptyTextSlicesLowerToIdentityTextOperands.
internal fn bool EmptyTextSlicesLowerToIdentityTextOperandsImpl()
{
    // PORT-NOTE: the C# asserts both functions return the bare text parameter operand
    // (MidLevelIrParameterOperand terminator) and emit no TextSliceRValue. Over the
    // rendered text this is reduced to: both functions present and direct codegen,
    // with identity `return text[]` source text and no slice temp emitted.
    stack mut MirCompile c = CompileMir(
        "place-empty-text-slices-identity",
        raw"""
module Demo

unsafe fn ascii SliceAscii(ascii text)
{
    return text[];
}

unsafe fn unicode SliceUnicode(unicode text)
{
    return text[];
}
""");
    return Succeeds(c)
        && MirContains(c, "direct-codegen: true")
        && MirOccurrences(c, "return text[]") == 2
        && MirDoesNotContain(c, "_slice");
}

