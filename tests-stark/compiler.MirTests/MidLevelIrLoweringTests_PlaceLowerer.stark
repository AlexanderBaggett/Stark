import CompilerMirTestSupport
import System.Testing
module MidLevelIrLoweringTests_PlaceLowerer

// Stark-side port of tests/compiler.Tests/MidLevelIrLowering/MidLevelIrLoweringTests.PlaceLowerer.cs.
// The C# oracle inspects the MIR object model (RValue subclasses, statement
// kinds, local flags). The Stark helpers only expose the rendered MIR artifact
// text, so the object-model predicates are matched against the equivalent
// rendered fragments:
//   * SupportsDirectCodeGeneration  -> "direct-codegen: true"
//   * IsAddressable local           -> "<name>: ... addr" line
//   * HasConstProvenance local      -> "const-provenance" local flag
//   * StoreIndirect (mutation)      -> "store-indirect"
//   * StoreIndirect (Initialization)-> "init-store-indirect"
//   * LoadIndirect temporary        -> ":load" suffix on an address temp
//   * AddressOf{Local,Param}/Field/ElementAddress -> "&<root>" / "&<root>[..]"
//   * GlobalAddressOperand          -> "&<GlobalName>"
//   * source statement.Text         -> the original assignment text verbatim
// PORT-NOTEs call out where a structural predicate (specific RValue subtype,
// pointer access-kind, terminator operand type) could not be expressed and was
// reduced to the closest available text signal.

// Ported from MidLevelIrLoweringTests.PlaceLowerer.FieldAssignmentLowersToAggregateUpdate.
internal fn bool FieldAssignmentLowersToAggregateUpdateImpl()
{
    // PORT-NOTE: the "at least two MidLevelIrInsertFieldRValue" object-model check
    // is reduced to: direct codegen plus the source field-assignment text, which is
    // carried verbatim on the insert-field temporary.
    stack mut MirCompile c = CompileMir(
        "place-field-assignment",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    box.Value = 2;
    return box.Value;
}
""");
    return MirContainsAll2(c, "direct-codegen: true", "box.Value = 2");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.FieldCompoundAssignmentLowersToAggregateReadModifyWrite.
internal fn bool FieldCompoundAssignmentLowersToAggregateReadModifyWriteImpl()
{
    // PORT-NOTE: the MidLevelIrBinaryRValue{Add} and >=2 InsertFieldRValue checks are
    // reduced to: direct codegen, the compound-add temp, and the set-field temp.
    stack mut MirCompile c = CompileMir(
        "place-field-compound-assignment",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    box.Value += 2;
    return box.Value;
}
""");
    return MirContainsAll3(c, "direct-codegen: true", "_compound = box.Value += 2", "_setfield = box.Value += 2");
}

