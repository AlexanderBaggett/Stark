    stack mut MirCompile c = CompileMir(
        "place-slice-mutation",
        raw"""
module Demo

unsafe fn i32[min max] Run(mut i32[min max][] view, i32[min max] index)
{
    view[index] = 9;
    return view[index];
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "store-indirect")
        && MirContains(c, ":load");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.MixedCallMemberAndIndexPostfixChainsLowerToMir.
internal fn bool MixedCallMemberAndIndexPostfixChainsLowerToMirImpl()
{
    // PORT-NOTE: the direct-call(Make), ExtractFieldRValue{Cells}, ExtractIndexRValue
    // {ElementIndex:1}, and ExtractFieldRValue{Value} checks are reduced to: direct
    // codegen, the rendered call "Make()", and the postfix chain text ".Cells[1]" and
    // ".Value".
    stack mut MirCompile c = CompileMir(
        "place-mixed-call-member-index-chain",
        raw"""
module Demo

struct Cell
{
    i32[min max] Value;
}

struct Holder
{
    Cell[2] Cells;
}

unsafe fn Holder Make()
{
    return new Holder()
    {
        Cells =
        {
            new Cell()
            {
                Value = 3
            },
            new Cell()
            {
                Value = 5
            }
        }
    };
}

unsafe fn i32[min max] Run()
{
    return Make().Cells[1].Value;
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "Make()")
        && MirContains(c, ".Cells[1]")
        && MirContains(c, ".Value");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.ExplicitPointerOperatorsAndConversionsLowerToMir.
internal fn bool ExplicitPointerOperatorsAndConversionsLowerToMirImpl()
{
    // PORT-NOTE: the AddressOfLocalRValue, two ConvertRValue subtype checks
    // (rawptr->rawptr and integer->integer), StoreIndirect, and LoadIndirectRValue
    // checks are reduced to: direct codegen, the addressable "value" local, the
    // address-of-local "&value", the rawptr cast, a store-indirect, and a raw load.
    stack mut MirCompile c = CompileMir(
        "place-explicit-pointer-operators-conversions",
        raw"""
module Demo

unsafe fn i32[min max] Run(i64[min max] bits)
{
    stack mut i32[min max] value = 1;
    stack rawmutptr<i32[min max]> ptr = &value;
    stack rawptr<i32[min max]> readonlyPtr = (rawptr<i32[min max]>)ptr;
    *ptr = (i32[min max])bits;
    return *readonlyPtr;
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "value: stack i32 mut addr")
        && MirContainsAll2(c, "ptr: stack rawmutptr<i32>", "readonlyPtr: stack rawptr<i32>")
        && MirContains(c, "&value")
        && MirContains(c, "ptr:rawptr<i32>")
        && MirContains(c, "store-indirect")
        && MirContains(c, "_load = *readonlyPtr");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.FieldAndGlobalAddressExpressionsLowerToMirAddresses.
internal fn bool FieldAndGlobalAddressExpressionsLowerToMirAddressesImpl()
{
    // PORT-NOTE: the FieldAddressRValue, StoreIndirect, and LoadIndirectRValue-through
    // -GlobalAddressOperand{Counter} checks are reduced to: direct codegen, the
    // addressable "box" local, address temps for &box/.Value, a store-indirect, and
    // the global address operand through *(&Counter).
    stack mut MirCompile c = CompileMir(
        "place-field-global-address-expressions",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

static mut i32[min max] Counter = 0;

unsafe fn i32[min max] Run(i32[min max] input)
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    *(&(box.Value)) = input;
    Counter = *(&(box.Value));
    return *(&Counter);
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "box: stack Box mut addr")
        && MirContainsAll2(c, "rawmutptr<Box>", "rawmutptr<i32>")
        && MirContains(c, "= &box")
        && MirContains(c, ".Value")
        && MirContains(c, "store-indirect")
        && MirContains(c, "*(&Counter)");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.IndexedFieldAddressBehindRawPointerLowersToParameterBackedMirAddresses.
internal fn bool IndexedFieldAddressBehindRawPointerLowersToParameterBackedMirAddressesImpl()
{
    // PORT-NOTE: the FieldAddressRValue, ElementAddressRValue, StoreIndirect, and
    // LoadIndirectRValue subtype checks are reduced to: direct codegen, the
    // buffer.Storage/[index] address chain, a store-indirect, and a raw-pointer
    // load from that address.
    stack mut MirCompile c = CompileMir(
        "place-indexed-field-behind-rawptr",
        raw"""
module Demo

struct Buffer
{
    i8[min max][16] Storage;
    i64[min max] WritePos;
}

unsafe fn i32[min max] Touch(rawmutptr<Buffer> buffer, i64[min max] index, i8[min max] value)
{
    *(&(*buffer).Storage[index]) = value;
    return (i32[min max])*(&(*buffer).Storage[index]);
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContainsAll2(c, "rawmutptr<i8[16]>", "rawmutptr<i8>")
        && MirContains(c, "buffer.Storage")
        && MirContains(c, "[index]")
        && MirContains(c, "store-indirect")
        && MirContains(c, "_load = *(&(*buffer).Storage[index])");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.ImmutableGlobalAddressesLowerToReadonlyMirAddresses.
internal fn bool ImmutableGlobalAddressesLowerToReadonlyMirAddressesImpl()
{
    // PORT-NOTE: the C# asserts CounterPtr returns a non-mutable GlobalAddressOperand
    // and FieldPtr emits a non-mutable FieldAddressRValue (no rawptr->rawptr convert).
    // The pointer-mutability flags are not text-expressible, so this is reduced to:
    // both functions compile with direct codegen, CounterPtr returns the global address
    // "&Counter", and FieldPtr forms the field address "&Current.Value".
    stack mut MirCompile c = CompileMir(
        "place-immutable-global-addresses",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

static i32[min max] Counter = 0;
static Box Current = new Box()
{
    Value = 5
};

unsafe fn rawptr<i32[min max]> CounterPtr()
{
    return &Counter;
}

unsafe fn rawptr<i32[min max]> FieldPtr()
{
    return &(Current.Value);
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "return &Counter")
        && MirContains(c, "&Current.Value");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.ConstGlobalAddressesLowerToFrozenMirAddresses.
internal fn bool ConstGlobalAddressesLowerToFrozenMirAddressesImpl()
{
    // PORT-NOTE: the C# asserts the returned addresses are non-mutable rawpointers whose
    // ElementType.AccessKind == Frozen (BoxPtr returns a GlobalAddressOperand, FieldPtr
    // a LocalOperand). The frozen/mutability pointer metadata is not text-expressible,
    // so this is reduced to: both functions compile with direct codegen, BoxPtr returns
    // the global address "&Current", and FieldPtr forms the field address "&Current.Value".
    stack mut MirCompile c = CompileMir(
        "place-const-global-addresses-frozen",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

const Box Current = new Box()
{
    Value = 5
};

unsafe fn rawptr<frozen Box> BoxPtr()
{
    return &Current;
}

unsafe fn rawptr<frozen i32[min max]> FieldPtr()
{
    return &(Current.Value);
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "return &Current")
        && MirContains(c, "&Current.Value");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.ConstParameterAddressesLowerToFrozenMirAddresses.
internal fn bool ConstParameterAddressesLowerToFrozenMirAddressesImpl()
{
    // PORT-NOTE: the C# asserts an AddressOfParameterRValue with frozen PointeeType /
    // non-mutable rawptr and a FieldAddressRValue with frozen ElementType, and a
    // non-mutable LocalOperand return. The frozen/mutability pointer metadata is not
    // text-expressible, so this is reduced to: direct codegen, frozen pointer temps,
    // the address-of-parameter "&box", and the field address ".Value".
    stack mut MirCompile c = CompileMir(
        "place-const-parameter-addresses-frozen",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn rawptr<frozen i32[min max]> FieldPtr(const Box box)
{
    return &(box.Value);
}
""");
    return MirContains(c, "direct-codegen: true")
        && MirContainsAll2(c, "rawptr<frozen Box>", "rawptr<frozen i32>")
        && MirContains(c, "const-provenance")
        && MirContains(c, "= &box")
        && MirContains(c, ".Value")
        && MirContains(c, "return &(box.Value)");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.ConstProvenanceLocalsAreMarkedInMir.
internal fn bool ConstProvenanceLocalsAreMarkedInMirImpl()
{
    // PORT-NOTE: the C# asserts the "local" local has HasConstProvenance == true. The
    // renderer surfaces this as the "const-provenance" flag on the local's declaration
    // line, so this is matched as the rendered "local: stack ... const-provenance".
    stack mut MirCompile c = CompileMir(
        "place-const-provenance-locals",
        raw"""
module Demo

unsafe fn rawptr<frozen i32[min max]> Forward(const rawmutptr<i32[min max]> ptr)
{
    stack rawptr<frozen i32[min max]> local = ptr;
    return local;
}
""");
    return Succeeds(c)
        && MirContains(c, "const-provenance");
}

// Ported from MidLevelIrLoweringTests.PlaceLowerer.FrozenSliceAddressesLowerToReadonlyMirAddresses.
internal fn bool FrozenSliceAddressesLowerToReadonlyMirAddressesImpl()
{
    // PORT-NOTE: the C# asserts a SliceElementAddressRValue with a non-mutable pointer
    // type and a non-mutable LocalOperand return. The pointer-mutability flag is not
    // text-expressible, so this is reduced to: direct codegen plus the rendered slice
    // element address read "view[0]".
    stack mut MirCompile c = CompileMir(
        "place-frozen-slice-addresses-readonly",
        raw"""
module Demo

unsafe fn rawptr<frozen i32[min max]> FirstPtr(frozen i32[min max][] view)
{
    return &(view[0]);
}
""");
    return MirContainsAll2(c, "direct-codegen: true", "view[0]");
}
