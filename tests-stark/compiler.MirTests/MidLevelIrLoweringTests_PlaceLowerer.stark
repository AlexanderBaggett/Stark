    stack mut MirCompile c = CompileMir(
        "place-fixed-array-init-const-index",
        raw"""
module Demo

unsafe fn i32[min max] Run()
{
    stack i32[min max][3] values =
    {
        1, 2, 3
    };
    return values[1];
}
""");
    return MirContainsAll2(c, "direct-codegen: true", "values[1]");
}

