import CompilerMirTestSupport
import System.Testing
module MidLevelIrLoweringTests_SwitchPatternLowerer

// Ported from MidLevelIrLoweringTests.SwitchPatternLowerer.LiteralSwitchLowersToMirSwitchTerminator.
// PORT-NOTE: the C# original inspects the typed MIR object graph (a single
// function, SupportsDirectCodeGeneration, a block with a Switch terminator, and
// blocks labeled switch_case_0 / switch_case_1). Over the rendered MIR text we
// assert the program lowers directly and that the switch terminator and the two
// case-block labels appear.
internal fn bool LiteralSwitchLowersToMirSwitchTerminatorImpl()
{
    stack mut MirCompile c = CompileMir(
        "switchlower-p1-literal-switch-terminator",
        raw"""
module Demo

unsafe finite law i32[min max] Run(i32[min max] value)
{
    switch (value)
    {
        case 1:
            return 10;
        case 2:
            return 20;
        default:
            return 30;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "switch")
        && MirContainsAll2(c, "switch_case_0", "switch_case_1");
}

// Ported from MidLevelIrLoweringTests.SwitchPatternLowerer.SwitchSectionsCanAssignAndBreakToSharedExit.
// PORT-NOTE: the C# original walks the typed MIR (a single switch_exit block,
// exactly three switch_case_ blocks, each ending in a Goto to the shared exit).
// Over the rendered MIR text we assert direct codegen, the shared switch_exit
// label, the three case labels, and that the cases branch to the exit via goto.
internal fn bool SwitchSectionsCanAssignAndBreakToSharedExitImpl()
{
    stack mut MirCompile c = CompileMir(
        "switchlower-p1-sections-shared-exit",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] value)
{
    stack mut i32[min max] result = 0;
    switch (value)
    {
        case 1:
            result = 10;
            break;
        case 2:
            result = 20;
            break;
        default:
            result = 30;
            break;
    }

    return result;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "bb4_switch_exit")
        && MirContainsAll3(c, "switch_case_0", "switch_case_1", "switch_case_2")
        && MirOccurrences(c, "goto bb4") == 3;
}

// Ported from MidLevelIrLoweringTests.SwitchPatternLowerer.GuardedSwitchLowersToBranchBasedCfg.
// PORT-NOTE: the C# original asserts the function is direct-codegen, that NO
// block has a Switch terminator, and that at least two blocks end in a Branch.
// Over the rendered MIR text we assert direct codegen, the absence of a switch
// terminator, and at least two branch terminators.
internal fn bool GuardedSwitchLowersToBranchBasedCfgImpl()
{
    stack mut MirCompile c = CompileMir(
        "switchlower-p1-guarded-branch-cfg",
        raw"""
module Demo

unsafe finite law i32[min max] Run(i32[min max] value, bool allow)
{
    switch (value)
    {
        case 1 when allow:
            return 10;
        default:
            return 20;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "direct-codegen: true")
        && MirLacksSwitchTerminator(c)
        && MirOccurrences(c, "branch ") >= 2;
}

