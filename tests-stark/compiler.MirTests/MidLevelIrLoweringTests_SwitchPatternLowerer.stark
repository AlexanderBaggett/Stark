// Ported from MidLevelIrLoweringTests.SwitchPatternLowerer.EnumSwitchPatternsCanMatchAndCaptureTextLeaves.
// PORT-NOTE: the C# original asserts direct codegen, a local "word", ExtractField
// rvalues for the enum tag/Text payload fields, a switch_enum_match block, and a
// textcmp_byte_0 block. The rendered MIR exposes source-facing payload paths.
internal fn bool EnumSwitchPatternsCanMatchAndCaptureTextLeavesImpl()
{
    stack mut MirCompile c = CompileMir(
        "switchlower-p1-enum-text-leaves",
        raw"""
module Demo

enum Token
{
    Empty,
    Text
    {
        Tag: ascii, Word: unicode
    },
}

unsafe fn i32[min max] Run(Token value)
{
    switch (value)
    {
        case Token.Text
        {
            Tag: "ab", Word: var word
        }:
            return word == (unicode)"cat" ? 7 : 3;
        case Token.Empty:
            return 0;
        default:
            return -1;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "direct-codegen: true")
        && MirContains(c, "word")
        && MirContainsAll3(c, "$tag", "value.Tag", "value.Word")
        && MirContainsAll2(c, "switch_enum_match", "textcmp_byte_0");
}
