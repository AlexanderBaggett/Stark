// Ported from MidLevelIrLoweringTests.SwitchPatternLowerer.EnumSwitchPatternsLowerToTagTestsAndActivePayloadExtractions.
// PORT-NOTE: the C# original asserts direct codegen, ExtractField rvalues for the
// enum tag and active payload fields, and a switch_enum_match block. The rendered
// MIR exposes source-facing payload paths, so assert those paths plus the tag.
internal fn bool EnumSwitchPatternsLowerToTagTestsAndActivePayloadExtractionsImpl()
{
    stack mut MirCompile c = CompileMir(
        "switchlower-p1-enum-tag-tests-payload-extractions",
        raw"""
module Demo

enum Token
{
    End,
    Integer(i32[min max]),
    Move
    {
        X: i32[min max], Y: i32[min max]
    },
}

unsafe fn i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.End:
            return 0;
        case Token.Integer(var value):
            return value;
        case Token.Move
        {
            X: var x, Y: var y
        }:
            return x + y;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return MirContains(c, "direct-codegen: true")
        && MirContainsAll4(c, "$tag", "token.0", "token.X", "token.Y")
        && MirContains(c, "switch_enum_match");
}

// Ported from MidLevelIrLoweringTests.SwitchPatternLowerer.EnumSwitchExpressionCallIsLoweredOnceInMir.
// PORT-NOTE: the C# original asserts that the Run function materializes the
// switched-on Next() call exactly once (one direct-call statement to "Next"). Over
// the rendered MIR text we assert the program lowers and the "= Next()" call temp
// appears exactly once.
internal fn bool EnumSwitchExpressionCallIsLoweredOnceInMirImpl()
{
    stack mut MirCompile c = CompileMir(
        "switchlower-p1-enum-switch-expression-call-once",
        raw"""
module Demo

enum Status
{
    Ok,
    Err(i32[min max]),
}

unsafe fn Status Next()
{
    return Status.Ok;
}

unsafe fn i32[min max] Run()
{
    switch (Next())
    {
        case Status.Ok:
            return 1;
        case Status.Err(var error):
            return error;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    return MirOccurrences(c, "= Next()") == 1;
}

