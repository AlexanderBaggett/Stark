import Compiler.Parsing
import Compiler.Lexing
import System.Testing
import System.Text
[Collection("parsing")]
module ParsingTests

fn bool LexOk(LexResult<TokenStream> result, out TokenStream stream)
{
    switch (result)
    {
        case LexResult<TokenStream>.Err(var error):
            stream = new();
            return false;
        case LexResult<TokenStream>.Ok(var value):
            stream = value;
            return true;
    }
}

// Parses the header of `source`, binding it; reports false on lex/parse failure.
fn bool ParseHeaderOk(ascii source, out CompilationUnitHeader header)
{
    header = new();
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var error):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var value):
            header = value;
            return true;
    }
}

[Fact]
fn bool ParsesImportsAndModule()
{
    stack mut CompilationUnitHeader header = new();
    if (!ParseHeaderOk("import System.Memory\nimport System.Text\nmodule Foo.Bar\n", header))
    {
        return false;
    }

    if (header.Count() != 3)
    {
        return false;
    }

    stack HeaderItem first = header.ItemAt(0);
    stack HeaderItem second = header.ItemAt(1);
    stack HeaderItem third = header.ItemAt(2);
    return first.Kind == SyntaxKind.ImportDeclaration
        && first.NameSegments == 2
        && second.Kind == SyntaxKind.ImportDeclaration
        && second.NameSegments == 2
        && third.Kind == SyntaxKind.ModuleDeclaration
        && third.NameSegments == 2;
}

[Fact]
fn bool ModuleNameTokenTextIsRecoverable()
{
    stack ascii source = "import System.Memory\nmodule Foo.Bar\n";
    stack mut CompilationUnitHeader header = new();
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var error):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var value):
            header = value;
    }

    if (header.Count() != 2)
    {
        return false;
    }

    // The module item's dotted name starts with the identifier `Foo`.
    stack HeaderItem moduleItem = header.ItemAt(1);
    stack ascii firstSegment = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])moduleItem.NameStart);
    return moduleItem.Kind == SyntaxKind.ModuleDeclaration
        && System.Text.Equals(firstSegment, "Foo");
}

[Fact]
fn bool HeaderWithoutModuleParses()
{
    stack mut CompilationUnitHeader header = new();
    if (!ParseHeaderOk("import A\nimport B.C\n", header))
    {
        return false;
    }

    if (header.Count() != 2)
    {
        return false;
    }

    stack HeaderItem first = header.ItemAt(0);
    stack HeaderItem second = header.ItemAt(1);
    return first.Kind == SyntaxKind.ImportDeclaration
        && first.NameSegments == 1
        && second.Kind == SyntaxKind.ImportDeclaration
        && second.NameSegments == 2;
}

[Fact]
fn bool EmptySourceHasEmptyHeader()
{
    stack mut CompilationUnitHeader header = new();
    if (!ParseHeaderOk("", header))
    {
        return false;
    }

    return header.Count() == 0 && header.NextToken == 0;
}

[Fact]
fn bool HeaderStopsAtFirstDeclaration()
{
    stack mut CompilationUnitHeader header = new();
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("import A\npublic struct S { }"), stream))
    {
        return false;
    }

    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var error):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var value):
            header = value;
    }

    // One import parsed; the header ends at the `public` keyword that opens the
    // declaration list.
    return header.Count() == 1
        && stream.KindAt(header.NextToken) == TokenKind.Public;
}

[Fact]
fn bool MalformedImportIsError()
{
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("import 123"), stream))
    {
        return false;
    }

    // `import` must be followed by an identifier; a literal is a parse error.
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var error):
            return true;
        case ParseResult<CompilationUnitHeader>.Ok(var value):
            return false;
    }
}

// Lexes `source`, parses its header, then parses and binds the top-level
// declaration list. Reports false on any lex/parse failure.
fn bool ParseDeclsOk(ascii source, out DeclarationList decls)
{
    decls = new();
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
            return true;
    }
}

[Fact]
fn bool ParsesTopLevelDeclarations()
{
    stack mut DeclarationList decls = new();
    if (!ParseDeclsOk("public struct S { }\nfn void f() { }\nconst C = 5;\n", decls))
    {
        return false;
    }

    if (decls.Count() != 3)
    {
        return false;
    }

    stack DeclItem first = decls.ItemAt(0);
    stack DeclItem second = decls.ItemAt(1);
    stack DeclItem third = decls.ItemAt(2);
    return first.Kind == DeclarationKind.Struct
        && second.Kind == DeclarationKind.Function
        && third.Kind == DeclarationKind.Const;
}

[Fact]
fn bool DeclarationSpanCoversModifiersAndBody()
{
    stack mut DeclarationList decls = new();
    if (!ParseDeclsOk("public struct S { }\n", decls))
    {
        return false;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    // Tokens: public(0) struct(1) S(2) {(3) }(4). The outline spans the leading
    // modifier through the closing brace, with the keyword token in between.
    stack DeclItem only = decls.ItemAt(0);
    return only.Kind == DeclarationKind.Struct
        && only.StartToken == 0
        && only.KeywordToken == 1
        && only.EndToken == 4;
}

[Fact]
fn bool DeclarationBodySkipsNestedBraces()
{
    stack mut DeclarationList decls = new();
    if (!ParseDeclsOk("fn g() { if (true) { } else { } }\nenum E { A, B }\n", decls))
    {
        return false;
    }

    // Brace counting keeps the whole function (with its nested blocks) as one
    // declaration, followed by the enum.
    if (decls.Count() != 2)
    {
        return false;
    }

    stack DeclItem func = decls.ItemAt(0);
    stack DeclItem en = decls.ItemAt(1);
    return func.Kind == DeclarationKind.Function
        && en.Kind == DeclarationKind.Enum;
}

[Fact]
fn bool SemicolonTerminatedDeclarationsParse()
{
    stack mut DeclarationList decls = new();
    if (!ParseDeclsOk("const A = 1;\nstatic B = 2;\ntrait T { }\n", decls))
    {
        return false;
    }

    if (decls.Count() != 3)
    {
        return false;
    }

    stack DeclItem c = decls.ItemAt(0);
    stack DeclItem s = decls.ItemAt(1);
    stack DeclItem t = decls.ItemAt(2);
    return c.Kind == DeclarationKind.Const
        && s.Kind == DeclarationKind.Static
        && t.Kind == DeclarationKind.Trait;
}

[Fact]
fn bool DeclarationNamesAreExtracted()
{
    stack ascii source = "public struct Widget { }\nfn i32 compute() { }\nconst Limit = 5;\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    if (decls.Count() != 3)
    {
        return false;
    }

    // The struct/const names follow their keyword; the function name precedes
    // its parameter `(` (after the return type).
    stack DeclItem structDecl = decls.ItemAt(0);
    stack DeclItem fnDecl = decls.ItemAt(1);
    stack DeclItem constDecl = decls.ItemAt(2);
    stack ascii structName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])structDecl.NameToken);
    stack ascii fnName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fnDecl.NameToken);
    stack ascii constName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])constDecl.NameToken);
    return System.Text.Equals(structName, "Widget")
        && System.Text.Equals(fnName, "compute")
        && System.Text.Equals(constName, "Limit");
}

[Fact]
fn bool ParsesEnumVariants()
{
    stack ascii source = "enum E { A, B(i32), C { x: i32 }, D from Foo }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    stack mut u32[0 max] enumKeyword = 0;
    stack mut bool foundEnum = false;
    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Enum)
                {
                    enumKeyword = only.KeywordToken;
                    foundEnum = true;
                }
            }
    }

    if (!foundEnum)
    {
        return false;
    }

    // Four variants — bare, tuple-payload, struct-payload, and `from` — each
    // contribute exactly one name; payload braces/parens do not.
    switch (ParseEnumVariants(stream, enumKeyword))
    {
        case ParseResult<VariantList>.Err(var variantError):
            return false;
        case ParseResult<VariantList>.Ok(var variants):
            if (variants.Count() != 4)
            {
                return false;
            }

            stack ascii firstName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])variants.NameTokenAt(0));
            stack ascii lastName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])variants.NameTokenAt(3));
            return System.Text.Equals(firstName, "A")
                && System.Text.Equals(lastName, "D");
    }
}

[Fact]
fn bool EnumPayloadTypeHeadsAreExtracted()
{
    // Payload type heads are captured across the three payload forms: tuple
    // `A(Bar)` -> Bar, named-field `B { f: Baz }` -> Baz, `C from Qux` -> Qux. A
    // bare variant (`None`) and built-in payloads contribute no user-type head.
    stack ascii source = "enum E { A(Bar), B { f: Baz }, C from Qux, None }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    stack mut u32[0 max] enumKeyword = 0;
    stack mut bool foundEnum = false;
    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Enum)
                {
                    enumKeyword = only.KeywordToken;
                    foundEnum = true;
                }
            }
    }

    if (!foundEnum)
    {
        return false;
    }

    switch (ParseEnumPayloadHeads(stream, enumKeyword))
    {
        case ParseResult<TypeHeadList>.Err(var headsError):
            return false;
        case ParseResult<TypeHeadList>.Ok(var heads):
            if (heads.Count() != 3)
            {
                return false;
            }

            stack ascii h0 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])heads.HeadAt(0));
            stack ascii h1 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])heads.HeadAt(1));
            stack ascii h2 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])heads.HeadAt(2));
            return System.Text.Equals(h0, "Bar")
                && System.Text.Equals(h1, "Baz")
                && System.Text.Equals(h2, "Qux");
    }
}

[Fact]
fn bool ParsesStructFieldsSkippingMembers()
{
    stack ascii source = "struct P { u32[0 max] X; u32[0 max] Y; P() { } fn void f() { } }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    stack mut u32[0 max] structKeyword = 0;
    stack mut bool foundStruct = false;
    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Struct)
                {
                    structKeyword = only.KeywordToken;
                    foundStruct = true;
                }
            }
    }

    if (!foundStruct)
    {
        return false;
    }

    // Two data fields (X, Y); the constructor and method members are skipped,
    // and the braces inside them do not confuse the field walk.
    switch (ParseStructFields(stream, structKeyword))
    {
        case ParseResult<FieldList>.Err(var fieldError):
            return false;
        case ParseResult<FieldList>.Ok(var fields):
            if (fields.Count() != 2)
            {
                return false;
            }

            stack ascii firstField = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(0));
            stack ascii secondField = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(1));
            return System.Text.Equals(firstField, "X")
                && System.Text.Equals(secondField, "Y");
    }
}

[Fact]
fn bool StructFieldTypeHeadsAreExtracted()
{
    // The user-type head of each field is captured (rightmost depth-0 identifier of
    // the type): `Bar` for `Bar a`, `List` for `List<u32> c`; a built-in field type
    // (`i32 b`) and a ranged built-in (`u32[0 max] d`) have head 0.
    stack ascii source = "struct S { Bar a; i32 b; List<u32> c; u32[0 max] d; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    stack mut u32[0 max] structKeyword = 0;
    stack mut bool foundStruct = false;
    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Struct)
                {
                    structKeyword = only.KeywordToken;
                    foundStruct = true;
                }
            }
    }

    if (!foundStruct)
    {
        return false;
    }

    switch (ParseStructFields(stream, structKeyword))
    {
        case ParseResult<FieldList>.Err(var fieldError):
            return false;
        case ParseResult<FieldList>.Ok(var fields):
            if (fields.Count() != 4)
            {
                return false;
            }

            stack ascii head0 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.TypeHeadAt(0));
            stack ascii head2 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.TypeHeadAt(2));
            return fields.TypeHeadAt(0) != 0
                && System.Text.Equals(head0, "Bar")
                && fields.TypeHeadAt(1) == 0
                && fields.TypeHeadAt(2) != 0
                && System.Text.Equals(head2, "List")
                && fields.TypeHeadAt(3) == 0;
    }
}

[Fact]
fn bool MultiDeclaratorFieldsShareType()
{
    // `Bar x, y;` declares two fields x and y, both of type `Bar` — the comma-
    // separated declarators are split and share the one type head.
    stack ascii source = "struct S { Bar x, y; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    stack mut u32[0 max] structKeyword = 0;
    stack mut bool foundStruct = false;
    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Struct)
                {
                    structKeyword = only.KeywordToken;
                    foundStruct = true;
                }
            }
    }

    if (!foundStruct)
    {
        return false;
    }

    switch (ParseStructFields(stream, structKeyword))
    {
        case ParseResult<FieldList>.Err(var fieldError):
            return false;
        case ParseResult<FieldList>.Ok(var fields):
            if (fields.Count() != 2)
            {
                return false;
            }

            stack ascii n0 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(0));
            stack ascii n1 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(1));
            stack ascii h0 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.TypeHeadAt(0));
            stack ascii h1 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.TypeHeadAt(1));
            return System.Text.Equals(n0, "x")
                && System.Text.Equals(n1, "y")
                && System.Text.Equals(h0, "Bar")
                && System.Text.Equals(h1, "Bar");
    }
}

[Fact]
fn bool FieldStorageCapacityIsSkipped()
{
    // `Bar x[N];` is a field `x` of type `Bar` with storage capacity `[N]` — the
    // capacity tokens are bracket-nested, so the name is `x` (not `N`), head `Bar`.
    stack ascii source = "struct S { Bar x[N]; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    stack mut u32[0 max] structKeyword = 0;
    stack mut bool foundStruct = false;
    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Struct)
                {
                    structKeyword = only.KeywordToken;
                    foundStruct = true;
                }
            }
    }

    if (!foundStruct)
    {
        return false;
    }

    switch (ParseStructFields(stream, structKeyword))
    {
        case ParseResult<FieldList>.Err(var fieldError):
            return false;
        case ParseResult<FieldList>.Ok(var fields):
            if (fields.Count() != 1)
            {
                return false;
            }

            stack ascii nm = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(0));
            stack ascii hd = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.TypeHeadAt(0));
            return System.Text.Equals(nm, "x") && System.Text.Equals(hd, "Bar");
    }
}

[Fact]
fn bool ParsesFunctionSignature()
{
    stack ascii source = "fn void compute(i32 a, borrow Foo b, out u32 c) { }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    // Name is the identifier before `(`; three parameters, each named by its
    // last identifier, with `borrow`/`out`/type tokens ignored.
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            if (signature.ParamCount() != 3)
            {
                return false;
            }

            stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.Name());
            stack ascii p0 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.ParamNameAt(0));
            stack ascii p2 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.ParamNameAt(2));
            return System.Text.Equals(name, "compute")
                && System.Text.Equals(p0, "a")
                && System.Text.Equals(p2, "c");
    }
}

[Fact]
fn bool ParsesFunctionBodyStatements()
{
    stack ascii source = "fn void f() { stack u32 x = 1; if (x) { return; } else { } while (x) { } return; }";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    // Pre-order with depths: the local, the `if` (whose then-body `return` nests
    // at depth 1), the `while`, and the trailing `return` — five statements. The
    // then/else arms are distinct scopes (no boundary statement is materialized).
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var statements):
            if (statements.Count() != 5)
            {
                return false;
            }

            stack StatementItem s0 = statements.ItemAt(0);
            stack StatementItem s1 = statements.ItemAt(1);
            stack StatementItem s2 = statements.ItemAt(2);
            stack StatementItem s3 = statements.ItemAt(3);
            stack StatementItem s4 = statements.ItemAt(4);
            return s0.Kind == StatementKind.Local
                && statements.DepthAt(0) == 0
                && s1.Kind == StatementKind.If
                && statements.DepthAt(1) == 0
                && s2.Kind == StatementKind.Return
                && statements.DepthAt(2) == 1
                && s3.Kind == StatementKind.While
                && statements.DepthAt(3) == 0
                && s4.Kind == StatementKind.Return
                && statements.DepthAt(4) == 0;
    }
}

[Fact]
fn bool StatementsWireToExpressionTrees()
{
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f() { x = a + b; return g(c); }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    // Statement 0 (`x = a + b;`) parses to an Assign expression; statement 1
    // (`return g(c);`) parses its returned value to a Call expression.
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var statements):
            if (statements.Count() != 2)
            {
                return false;
            }

            stack u32[0 max] assignRoot = statements.ExprRootAt(0);
            stack u32[0 max] returnRoot = statements.ExprRootAt(1);
            return statements.ExprKindAt(assignRoot) == ExprKind.Assign
                && statements.ExprKindAt(returnRoot) == ExprKind.Call;
    }
}

[Fact]
fn bool IfAndWhileConditionsWireToExpressions()
{
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f() { if (a == b) { } while (i < n) { } }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    // The `if` and `while` conditions parse to comparison (Binary) expressions.
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var statements):
            if (statements.Count() != 2)
            {
                return false;
            }

            stack StatementItem ifStatement = statements.ItemAt(0);
            stack StatementItem whileStatement = statements.ItemAt(1);
            stack u32[0 max] ifCondition = statements.ExprRootAt(0);
            stack u32[0 max] whileCondition = statements.ExprRootAt(1);
            return ifStatement.Kind == StatementKind.If
                && whileStatement.Kind == StatementKind.While
                && statements.ExprKindAt(ifCondition) == ExprKind.Binary
                && statements.ExprKindAt(whileCondition) == ExprKind.Binary;
    }
}

[Fact]
fn bool LocalDeclarationInitializersWireToExpressions()
{
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f() { stack u32 x = a + b; stack bool y = g(c); }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    // Both locals are `Local` statements whose initializer (after `=`) parses to
    // the expected expression: `a + b` (Binary) and `g(c)` (Call).
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var statements):
            if (statements.Count() != 2)
            {
                return false;
            }

            stack StatementItem first = statements.ItemAt(0);
            stack StatementItem second = statements.ItemAt(1);
            stack u32[0 max] firstInit = statements.ExprRootAt(0);
            stack u32[0 max] secondInit = statements.ExprRootAt(1);
            return first.Kind == StatementKind.Local
                && second.Kind == StatementKind.Local
                && statements.ExprKindAt(firstInit) == ExprKind.Binary
                && statements.ExprKindAt(secondInit) == ExprKind.Call;
    }
}

[Fact]
fn bool NestedBlocksParseAsSubStatements()
{
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f() { if (c) { return; x = 1; } y = 2; }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    // Pre-order with depths: if(0), return(1), x=1(1), y=2(0). The `if` body's
    // statements nest one level deeper than the `if` and the trailing `y = 2`.
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var statements):
            if (statements.Count() != 4)
            {
                return false;
            }

            stack StatementItem s0 = statements.ItemAt(0);
            stack StatementItem s1 = statements.ItemAt(1);
            stack StatementItem s2 = statements.ItemAt(2);
            stack StatementItem s3 = statements.ItemAt(3);
            return s0.Kind == StatementKind.If
                && statements.DepthAt(0) == 0
                && s1.Kind == StatementKind.Return
                && statements.DepthAt(1) == 1
                && s2.Kind == StatementKind.Expression
                && statements.DepthAt(2) == 1
                && s3.Kind == StatementKind.Expression
                && statements.DepthAt(3) == 0;
    }
}

[Fact]
fn bool ParsesExpressionPrecedence()
{
    stack ascii source = "1 + 2 * 3";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    // `*` binds tighter than `+`, so the root is `+` with `2 * 3` as its right
    // child.
    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    if (tree.NodeKindAt(root) != ExprKind.Binary)
    {
        return false;
    }

    stack u32[0 max] right = tree.RightAt(root);
    stack ascii rootOp = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tree.TokenAt(root));
    stack ascii rightOp = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tree.TokenAt(right));
    return System.Text.Equals(rootOp, "+")
        && tree.NodeKindAt(tree.LeftAt(root)) == ExprKind.IntLiteral
        && tree.NodeKindAt(right) == ExprKind.Binary
        && System.Text.Equals(rightOp, "*");
}

[Fact]
fn bool ParenthesesOverridePrecedence()
{
    stack ascii source = "(1 + 2) * 3";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    // Parentheses group `1 + 2`, so the root is `*` with `+` as its left child.
    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    if (tree.NodeKindAt(root) != ExprKind.Binary)
    {
        return false;
    }

    stack u32[0 max] left = tree.LeftAt(root);
    stack ascii rootOp = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tree.TokenAt(root));
    stack ascii leftOp = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tree.TokenAt(left));
    return System.Text.Equals(rootOp, "*")
        && tree.NodeKindAt(left) == ExprKind.Binary
        && System.Text.Equals(leftOp, "+")
        && tree.NodeKindAt(tree.RightAt(root)) == ExprKind.IntLiteral;
}

[Fact]
fn bool ParsesMemberAccessChain()
{
    stack ascii source = "a.b.c";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    // `a.b.c` associates left: Member(Member(a, b), c).
    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    if (tree.NodeKindAt(root) != ExprKind.Member)
    {
        return false;
    }

    stack u32[0 max] inner = tree.LeftAt(root);
    stack ascii outerName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tree.TokenAt(root));
    stack ascii innerName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tree.TokenAt(inner));
    return System.Text.Equals(outerName, "c")
        && tree.NodeKindAt(inner) == ExprKind.Member
        && System.Text.Equals(innerName, "b")
        && tree.NodeKindAt(tree.LeftAt(inner)) == ExprKind.Identifier;
}

[Fact]
fn bool ParsesCallAndIndexPostfix()
{
    stack mut TokenStream callStream = new();
    if (!LexOk(LexText("f(x) + 1"), callStream))
    {
        return false;
    }

    // `f(x)` is a call bound tighter than `+`, so the `+` root's left is a Call.
    stack mut ExprTree callTree = ParseExpression(callStream, 0);
    stack u32[0 max] callRoot = callTree.RootNode();
    if (callTree.NodeKindAt(callRoot) != ExprKind.Binary
        || callTree.NodeKindAt(callTree.LeftAt(callRoot)) != ExprKind.Call)
    {
        return false;
    }

    stack mut TokenStream indexStream = new();
    if (!LexOk(LexText("v[i]"), indexStream))
    {
        return false;
    }

    // `v[i]` is an Index over the receiver `v` with index expression `i`.
    stack mut ExprTree indexTree = ParseExpression(indexStream, 0);
    stack u32[0 max] indexRoot = indexTree.RootNode();
    return indexTree.NodeKindAt(indexRoot) == ExprKind.Index
        && indexTree.NodeKindAt(indexTree.LeftAt(indexRoot)) == ExprKind.Identifier
        && indexTree.NodeKindAt(indexTree.RightAt(indexRoot)) == ExprKind.Identifier;
}

[Fact]
fn bool ParsesCallArguments()
{
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("f(a, b + 1, g(c))"), stream))
    {
        return false;
    }

    // Three top-level arguments: `a`, `b + 1`, and the nested call `g(c)`.
    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    if (tree.NodeKindAt(root) != ExprKind.Call || tree.CallArgCount(root) != 3)
    {
        return false;
    }

    stack u32[0 max] arg0 = tree.CallArgAt(root, 0);
    stack u32[0 max] arg1 = tree.CallArgAt(root, 1);
    stack u32[0 max] arg2 = tree.CallArgAt(root, 2);
    return tree.NodeKindAt(arg0) == ExprKind.Identifier
        && tree.NodeKindAt(arg1) == ExprKind.Binary
        && tree.NodeKindAt(arg2) == ExprKind.Call
        && tree.CallArgCount(arg2) == 1;
}

[Fact]
fn bool ParsesEmptyCallArguments()
{
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("done()"), stream))
    {
        return false;
    }

    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    return tree.NodeKindAt(root) == ExprKind.Call
        && tree.CallArgCount(root) == 0
        && tree.NodeKindAt(tree.LeftAt(root)) == ExprKind.Identifier;
}

[Fact]
fn bool ParsesNewExpressionArguments()
{
    stack ascii arenaSource = "new(arena, 4 + count)";
    stack mut TokenStream arenaStream = new();
    if (!LexOk(LexText(arenaSource), arenaStream))
    {
        return false;
    }

    stack mut ExprTree arenaTree = ParseExpression(arenaStream, 0);
    stack u32[0 max] arenaRoot = arenaTree.RootNode();
    if (arenaTree.NodeKindAt(arenaRoot) != ExprKind.New
        || arenaTree.CallArgCount(arenaRoot) != 2
        || arenaTree.LeftAt(arenaRoot) != 0)
    {
        return false;
    }

    stack u32[0 max] selector = arenaTree.CallArgAt(arenaRoot, 0);
    stack u32[0 max] capacity = arenaTree.CallArgAt(arenaRoot, 1);
    stack ascii selectorText = Compiler.Lexing.TokenTextOf(arenaSource, arenaStream, (u64[0 2 ** 63 - 1])arenaTree.TokenAt(selector));
    if (arenaTree.NodeKindAt(selector) != ExprKind.StorageSelector
        || !System.Text.Equals(selectorText, "arena")
        || arenaTree.NodeKindAt(capacity) != ExprKind.Binary)
    {
        return false;
    }

    stack ascii typedSource = "new Box(1)";
    stack mut TokenStream typedStream = new();
    if (!LexOk(LexText(typedSource), typedStream))
    {
        return false;
    }

    stack mut ExprTree typedTree = ParseExpression(typedStream, 0);
    stack u32[0 max] typedRoot = typedTree.RootNode();
    stack u32[0 max] typeHead = typedTree.LeftAt(typedRoot);
    stack u32[0 max] arg = typedTree.CallArgAt(typedRoot, 0);
    stack ascii typeName = Compiler.Lexing.TokenTextOf(typedSource, typedStream, (u64[0 2 ** 63 - 1])typedTree.TokenAt(typeHead));
    return typedTree.NodeKindAt(typedRoot) == ExprKind.New
        && typedTree.NodeKindAt(typeHead) == ExprKind.Identifier
        && System.Text.Equals(typeName, "Box")
        && typedTree.CallArgCount(typedRoot) == 1
        && typedTree.NodeKindAt(arg) == ExprKind.IntLiteral;
}

[Fact]
fn bool ParsesAssignmentExpression()
{
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("x = a + b"), stream))
    {
        return false;
    }

    // `x = a + b` is Assign(x, +(a, b)): the value side is parsed as a full
    // expression and binds below the assignment.
    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    return tree.NodeKindAt(root) == ExprKind.Assign
        && tree.NodeKindAt(tree.LeftAt(root)) == ExprKind.Identifier
        && tree.NodeKindAt(tree.RightAt(root)) == ExprKind.Binary;
}

[Fact]
fn bool AssignmentIsRightAssociative()
{
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("a = b = c"), stream))
    {
        return false;
    }

    // Right-associative: Assign(a, Assign(b, c)).
    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    stack u32[0 max] rhs = tree.RightAt(root);
    return tree.NodeKindAt(root) == ExprKind.Assign
        && tree.NodeKindAt(tree.LeftAt(root)) == ExprKind.Identifier
        && tree.NodeKindAt(rhs) == ExprKind.Assign
        && tree.NodeKindAt(tree.LeftAt(rhs)) == ExprKind.Identifier
        && tree.NodeKindAt(tree.RightAt(rhs)) == ExprKind.Identifier;
}

// Parses the header and declaration list of an already-lexed token stream,
// returning the declarations. False on header/declaration parse failure.
fn bool ParseDeclsFromStream(borrow TokenStream stream, out DeclarationList decls)
{
    decls = new();
    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
            return true;
    }
}

[Fact]
fn bool GenericFunctionNameIsNotTypeParameter()
{
    // `fn void myFunc<T>() { }` — the name is `myFunc`, not the type parameter
    // `T` (which sits inside the `<...>` at depth > 0).
    stack ascii source = "fn void myFunc<T>() { }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem fnDecl = decls.ItemAt(0);
    stack ascii fnName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fnDecl.NameToken);
    return fnDecl.Kind == DeclarationKind.Function
        && System.Text.Equals(fnName, "myFunc");
}

[Fact]
fn bool GenericReturnTypeFunctionNameIsExtracted()
{
    // A generic return type (`List<u32>`) must not be mistaken for the name; the
    // name `process` follows it, just before the parameter `(`.
    stack ascii source = "fn List<u32> process(i32 x) { }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem fnDecl = decls.ItemAt(0);
    stack ascii fnName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fnDecl.NameToken);
    return fnDecl.Kind == DeclarationKind.Function
        && System.Text.Equals(fnName, "process");
}

[Fact]
fn bool FunctionSignatureNameSkipsTypeParameters()
{
    // The signature parser's own name detection skips type parameters too.
    stack ascii source = "fn void make<T>(T value) { }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem only = decls.ItemAt(0);
    if (only.Kind != DeclarationKind.Function)
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, only.KeywordToken))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.Name());
            return System.Text.Equals(name, "make");
    }
}

[Fact]
fn bool TailFunctionModifierIsParsedContextually()
{
    stack ascii source = "tail finite law fn void step(i32 value) { return; }\nfn void other() { stack u32 tail = 0; }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 2)
    {
        return false;
    }

    stack DeclItem tailDecl = decls.ItemAt(0);
    stack DeclItem ordinaryDecl = decls.ItemAt(1);
    if (tailDecl.Kind != DeclarationKind.Function
        || !tailDecl.IsTailCallable
        || ordinaryDecl.Kind != DeclarationKind.Function
        || ordinaryDecl.IsTailCallable)
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, tailDecl.KeywordToken))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            if (!signature.TailCallable())
            {
                return false;
            }
    }

    switch (ParseFunctionBody(stream, ordinaryDecl.KeywordToken))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            if (body.Count() != 1 || body.ItemAt(0).Kind != StatementKind.Local)
            {
                return false;
            }

            stack ascii localName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])body.ItemAt(0).NameToken);
            return System.Text.Equals(localName, "tail")
                && stream.KindAt((u64[0 2 ** 63 - 1])body.ItemAt(0).NameToken) == TokenKind.Identifier;
    }
}

[Fact]
fn bool AsmSpecifierDoesNotHideFunctionDeclaration()
{
    stack ascii source = "public unsafe ffi asm(x86_64) fn i64 Syscall2(i64 number, rawptr<i8[min max]> path) in(\"rax\") number, in(\"rdi\") path, out(\"rax\") return, clobber(\"rcx\", \"r11\", \"memory\") { \"syscall\" }\nfn i64 after() { return 0; }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 2)
    {
        return false;
    }

    stack DeclItem asmDecl = decls.ItemAt(0);
    stack DeclItem normalDecl = decls.ItemAt(1);
    stack ascii asmName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])asmDecl.NameToken);
    stack ascii normalName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])normalDecl.NameToken);
    return asmDecl.Kind == DeclarationKind.Function
        && normalDecl.Kind == DeclarationKind.Function
        && System.Text.Equals(asmName, "Syscall2")
        && System.Text.Equals(normalName, "after");
}

[Fact]
fn bool FunctionSignaturePreservesAsmMetadata()
{
    stack ascii source = "public unsafe ffi asm(x86_64) fn i64 Syscall2(i64 number, rawptr<i8[min max]> path) in(\"rax\") number, in(\"rdi\") path, out(\"rax\") return, clobber(\"rcx\", \"r11\", \"memory\") { \"syscall\" }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem only = decls.ItemAt(0);
    if (only.Kind != DeclarationKind.Function)
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, only.KeywordToken))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            stack ascii arch = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmArchitectureToken());
            stack ascii template = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmTemplateToken());
            stack ascii input0Register = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmInputRegisterAt(0));
            stack ascii input0Value = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmInputValueAt(0));
            stack ascii input1Register = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmInputRegisterAt(1));
            stack ascii input1Value = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmInputValueAt(1));
            stack ascii output0Register = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmOutputRegisterAt(0));
            stack ascii output0Value = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmOutputValueAt(0));
            stack ascii clobber0 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmClobberRegisterAt(0));
            stack ascii clobber1 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmClobberRegisterAt(1));
            stack ascii clobber2 = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.AsmClobberRegisterAt(2));
            return signature.HasAsm()
                && signature.AsmToken() != 0
                && System.Text.Equals(arch, "x86_64")
                && signature.ParamCount() == 2
                && signature.AsmInputCount() == 2
                && signature.AsmOutputCount() == 1
                && signature.AsmClobberCount() == 3
                && System.Text.Equals(input0Register, "\"rax\"")
                && System.Text.Equals(input0Value, "number")
                && System.Text.Equals(input1Register, "\"rdi\"")
                && System.Text.Equals(input1Value, "path")
                && System.Text.Equals(output0Register, "\"rax\"")
                && System.Text.Equals(output0Value, "return")
                && signature.AsmOutputBindsReturnAt(0)
                && System.Text.Equals(clobber0, "\"rcx\"")
                && System.Text.Equals(clobber1, "\"r11\"")
                && System.Text.Equals(clobber2, "\"memory\"")
                && signature.AsmInputRegisterAt(2) == 0
                && signature.AsmOutputValueAt(1) == 0
                && !signature.AsmOutputBindsReturnAt(1)
                && signature.AsmClobberRegisterAt(3) == 0
                && System.Text.Equals(template, "\"syscall\"");
    }
}

[Fact]
fn bool TailCallableSignatureFlagsAreParsed()
{
    stack ascii source = "fn fnptr<tail fn i32()> make(fnptr<tail finite i32(i32)> next, borrow closure<tail law i32(i32)> handler) { return next; }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem only = decls.ItemAt(0);
    if (only.Kind != DeclarationKind.Function)
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, only.KeywordToken))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            return !signature.TailCallable()
                && signature.ReturnTypeTailCallable()
                && signature.ParamCount() == 2
                && signature.ParamTypeTailCallable(0)
                && signature.ParamTypeTailCallable(1)
                && stream.KindAt((u64[0 2 ** 63 - 1])signature.ReturnTypeTokenAt()) == TokenKind.Fnptr
                && stream.KindAt((u64[0 2 ** 63 - 1])signature.ParamTypeTokenAt(0)) == TokenKind.Fnptr
                && stream.KindAt((u64[0 2 ** 63 - 1])signature.ParamTypeTokenAt(1)) == TokenKind.Closure;
    }
}

[Fact]
fn bool DeadOnReturnFunctionContractsAreParsed()
{
