    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            stack ascii returnType = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.ReturnType());
            stack ascii param0Type = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.ParamTypeAt(0));
            return System.Text.Equals(returnType, "Foo")
                && System.Text.Equals(param0Type, "List");
    }
}

[Fact]
fn bool LocalDeclarationNamesAreExtracted()
{
    // Each `Local` statement records its declared name token (last identifier
    // before `=`/`;`), skipping the storage class and a generic type.
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f() { stack u32 counter = 0; heap List<u32> items = new(); }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var statements):
            if (statements.Count() != 2)
            {
                return false;
            }

            stack StatementItem first = statements.ItemAt(0);
            stack StatementItem second = statements.ItemAt(1);
            stack ascii firstName = Compiler.Lexing.TokenTextOf("fn void f() { stack u32 counter = 0; heap List<u32> items = new(); }", stream, (u64[0 2 ** 63 - 1])first.NameToken);
            stack ascii secondName = Compiler.Lexing.TokenTextOf("fn void f() { stack u32 counter = 0; heap List<u32> items = new(); }", stream, (u64[0 2 ** 63 - 1])second.NameToken);
            return first.Kind == StatementKind.Local
                && System.Text.Equals(firstName, "counter")
                && second.Kind == StatementKind.Local
                && System.Text.Equals(secondName, "items");
    }
}

[Fact]
fn bool BracelessElseIfChainIsOneStatement()
{
    // A fully brace-less `if/else-if/else` chain is one statement: each arm's
    // terminating `;` is followed by `else`, so the chain keeps going. After it,
    // `d = 4;` is the only other top-level statement.
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f() { if (x) a = 1; else if (z) b = 2; else c = 3; d = 4; }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var statements):
            if (statements.Count() != 2)
            {
                return false;
            }

            stack StatementItem ifStatement = statements.ItemAt(0);
            stack StatementItem tailStatement = statements.ItemAt(1);
            return ifStatement.Kind == StatementKind.If
                && tailStatement.Kind == StatementKind.Expression;
    }
}

[Fact]
fn bool EnumGenericFromPayloadIsNotMisSplit()
{
    // The comma inside `HashMap<u32, u64>` sits at angle-bracket depth > 0 and so
    // does not start a new variant: exactly two variants, `Ok` and `Err`.
    stack ascii source = "enum E { Ok from HashMap<u32, u64>, Err from u32 }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem only = decls.ItemAt(0);
    if (only.Kind != DeclarationKind.Enum)
    {
        return false;
    }

    switch (ParseEnumVariants(stream, only.KeywordToken))
    {
        case ParseResult<VariantList>.Err(var variantError):
            return false;
        case ParseResult<VariantList>.Ok(var variants):
            if (variants.Count() != 2)
            {
                return false;
            }

            stack ascii firstName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])variants.NameTokenAt(0));
            stack ascii secondName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])variants.NameTokenAt(1));
            return System.Text.Equals(firstName, "Ok")
                && System.Text.Equals(secondName, "Err");
    }
}

[Fact]
fn bool WrappingOperatorsHaveArithmeticPrecedence()
{
    // `a +% b * c` — wrapping add is additive-level, so `*` (multiplicative)
    // binds tighter: root `+%` with `b * c` on the right.
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("a +% b * c"), stream))
    {
        return false;
    }

    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    stack u32[0 max] right = tree.RightAt(root);
    stack ascii rootOp = Compiler.Lexing.TokenTextOf("a +% b * c", stream, (u64[0 2 ** 63 - 1])tree.TokenAt(root));
    stack ascii rightOp = Compiler.Lexing.TokenTextOf("a +% b * c", stream, (u64[0 2 ** 63 - 1])tree.TokenAt(right));
    return tree.NodeKindAt(root) == ExprKind.Binary
        && System.Text.Equals(rootOp, "+%")
        && tree.NodeKindAt(right) == ExprKind.Binary
        && System.Text.Equals(rightOp, "*");
}

[Fact]
fn bool PowerOperatorIsRightAssociative()
{
    // `2 ** 3 ** 4` groups as `2 ** (3 ** 4)`: the root `**`'s right child is `**`.
    stack mut TokenStream powStream = new();
    if (!LexOk(LexText("2 ** 3 ** 4"), powStream))
    {
        return false;
    }

    stack mut ExprTree powTree = ParseExpression(powStream, 0);
    stack u32[0 max] powRoot = powTree.RootNode();
    stack u32[0 max] powRight = powTree.RightAt(powRoot);
    stack ascii powRootOp = Compiler.Lexing.TokenTextOf("2 ** 3 ** 4", powStream, (u64[0 2 ** 63 - 1])powTree.TokenAt(powRoot));
    if (powTree.NodeKindAt(powRoot) != ExprKind.Binary
        || !System.Text.Equals(powRootOp, "**")
        || powTree.NodeKindAt(powRight) != ExprKind.Binary)
    {
        return false;
    }

    // `2 ** 3 + 1` — power binds tighter than additive: root `+`, left `**`.
    stack mut TokenStream mixStream = new();
    if (!LexOk(LexText("2 ** 3 + 1"), mixStream))
    {
        return false;
    }

    stack mut ExprTree mixTree = ParseExpression(mixStream, 0);
    stack u32[0 max] mixRoot = mixTree.RootNode();
    stack ascii mixRootOp = Compiler.Lexing.TokenTextOf("2 ** 3 + 1", mixStream, (u64[0 2 ** 63 - 1])mixTree.TokenAt(mixRoot));
    stack ascii mixLeftOp = Compiler.Lexing.TokenTextOf("2 ** 3 + 1", mixStream, (u64[0 2 ** 63 - 1])mixTree.TokenAt(mixTree.LeftAt(mixRoot)));
    return System.Text.Equals(mixRootOp, "+")
        && mixTree.NodeKindAt(mixTree.LeftAt(mixRoot)) == ExprKind.Binary
        && System.Text.Equals(mixLeftOp, "**");
}

[Fact]
fn bool TernaryConditionalParses()
{
    // `a ? b : c` — a Conditional with condition/then/else as its three children.
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("a ? b : c"), stream))
    {
        return false;
    }

    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    if (tree.NodeKindAt(root) != ExprKind.Conditional
        || tree.NodeKindAt(tree.LeftAt(root)) != ExprKind.Identifier
        || tree.NodeKindAt(tree.RightAt(root)) != ExprKind.Identifier
        || tree.NodeKindAt(tree.AuxAt(root)) != ExprKind.Identifier)
    {
        return false;
    }

    // `a ? b : c ? d : e` nests to the right: the else-branch is itself a
    // Conditional.
    stack mut TokenStream chainStream = new();
    if (!LexOk(LexText("a ? b : c ? d : e"), chainStream))
    {
        return false;
    }

    stack mut ExprTree chainTree = ParseExpression(chainStream, 0);
    stack u32[0 max] chainRoot = chainTree.RootNode();
    return chainTree.NodeKindAt(chainRoot) == ExprKind.Conditional
        && chainTree.NodeKindAt(chainTree.AuxAt(chainRoot)) == ExprKind.Conditional;
}

[Fact]
fn bool ShiftOperatorConsumesBothTokens()
{
    // `a << b` is a single shift operator: root Binary with `a`/`b` as the two
    // identifier operands (not a mis-parsed nested relational `<`).
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("a << b"), stream))
    {
        return false;
    }

    stack mut ExprTree tree = ParseExpression(stream, 0);
    stack u32[0 max] root = tree.RootNode();
    if (tree.NodeKindAt(root) != ExprKind.Binary
        || tree.NodeKindAt(tree.LeftAt(root)) != ExprKind.Identifier
        || tree.NodeKindAt(tree.RightAt(root)) != ExprKind.Identifier)
    {
        return false;
    }

    // `1 + 2 << 3` — additive binds tighter than shift: root shift, left `+`.
    stack mut TokenStream mixStream = new();
    if (!LexOk(LexText("1 + 2 << 3"), mixStream))
    {
        return false;
    }

    stack mut ExprTree mixTree = ParseExpression(mixStream, 0);
    stack u32[0 max] mixRoot = mixTree.RootNode();
    stack ascii mixLeftOp = Compiler.Lexing.TokenTextOf("1 + 2 << 3", mixStream, (u64[0 2 ** 63 - 1])mixTree.TokenAt(mixTree.LeftAt(mixRoot)));
    return mixTree.NodeKindAt(mixRoot) == ExprKind.Binary
        && mixTree.NodeKindAt(mixTree.LeftAt(mixRoot)) == ExprKind.Binary
        && System.Text.Equals(mixLeftOp, "+");
}

[Fact]
fn bool ScopeIdsReflectBlockNesting()
{
    // `a` and `d` are in the function-body scope; `b` is in the nested if-body
    // scope. So a and d share a scope id, and b's differs.
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f() { stack u32 a = 0; if (c) { stack u32 b = 1; } stack u32 d = 2; }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            // Statements: a@0, if@1, b@2 (if body), d@3.
            return body.Count() == 4
                && body.ScopeIdAt(0) == body.ScopeIdAt(3)
                && body.ScopeIdAt(2) != body.ScopeIdAt(0)
                && body.ScopeIdAt(1) == body.ScopeIdAt(0);
    }
}

[Fact]
fn bool ForStatementParsesInitConditionAndBodyScopes()
{
    // `for (stack mut u32 i = 0; i < n; i += 1) { stack u32 x = 0; }` parses to:
    // the init local `i`@0 and the `For`@1 sharing the loop scope (the `For`
    // carrying the condition as its expression), and the body local `x`@2 in a
    // child scope whose parent is the loop scope.
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f(u32 n) { for (stack mut u32 i = 0; i < n; i += 1) { stack u32 x = 0; } }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            // Statements: init i@0, For@1, iter (i += 1)@2, body x@3. The init and
            // For and iter share the loop scope; the body is a child scope.
            return body.Count() == 4
                && body.ItemAt(0).Kind == StatementKind.Local
                && body.ItemAt(1).Kind == StatementKind.For
                && body.ItemAt(2).Kind == StatementKind.Expression
                && body.ItemAt(3).Kind == StatementKind.Local
                && body.ScopeIdAt(0) == body.ScopeIdAt(1)
                && body.ScopeIdAt(2) == body.ScopeIdAt(1)
                && body.ExprRootAt(1) != 0
                && body.ScopeIdAt(3) != body.ScopeIdAt(1)
                && body.ScopeParentAt(body.ScopeIdAt(3)) == body.ScopeIdAt(1);
    }
}

[Fact]
fn bool ForEachStatementParsesElementAndTraversalScopes()
{
    // `for willexit (u32 x in items) { x; }` parses to the element local `x`@0 and
    // the `ForEach`@1 sharing the loop scope (the `ForEach` carrying the traversal
    // `items` as its expression), with the body in a child scope of the loop scope.
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f(u32 items) { for willexit (u32 x in items) { x; } }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            // Statements: element x@0 (loop scope), ForEach@1 (enclosing scope —
            // the collection is evaluated before the bindings exist), body x;@2
            // (a child of the loop scope). So the element's loop scope is a child
            // of the ForEach's scope, and the body scope is a child of the loop scope.
            return body.Count() == 3
                && body.ItemAt(0).Kind == StatementKind.Local
                && body.ItemAt(1).Kind == StatementKind.ForEach
                && body.ItemAt(2).Kind == StatementKind.Expression
                && body.ExprRootAt(1) != 0
                && body.ScopeIdAt(0) != body.ScopeIdAt(1)
                && body.ScopeParentAt(body.ScopeIdAt(0)) == body.ScopeIdAt(1)
                && body.ScopeParentAt(body.ScopeIdAt(2)) == body.ScopeIdAt(0);
    }
}

[Fact]
fn bool SwitchSubjectAndCaseVarBindingParse()
{
    // `switch (v) { case Thing(var x): }` parses to the `Switch`@0 carrying the
    // subject expression, the `Case` label@1, and the pattern's `var x` binding as
    // a `Local`@2 in the section scope (a child of the switch body's scope).
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f(i32 v) { switch (v) { case Thing(var x): } }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            // Statements: Switch@0 (subject `v`), Case@1, var-binding `x`@2.
            return body.Count() == 3
                && body.ItemAt(0).Kind == StatementKind.Switch
                && body.ExprRootAt(0) != 0
                && body.ItemAt(1).Kind == StatementKind.Case
                && body.ItemAt(2).Kind == StatementKind.PatternBinding
                && body.ScopeIdAt(2) != body.ScopeIdAt(0);
    }
}
