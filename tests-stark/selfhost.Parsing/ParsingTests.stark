[Fact]
fn bool BecomeStatementParsesTerminatingCallExpression()
{
    stack ascii source = "tail fn i32 run(fnptr<tail fn i32(i32)> next, i32 value) { become next(value); }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem only = decls.ItemAt(0);
    if (only.Kind != DeclarationKind.Function || !only.IsTailCallable)
    {
        return false;
    }

    switch (ParseFunctionBody(stream, only.KeywordToken))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            if (body.Count() != 1)
            {
                return false;
            }

            stack StatementItem statement = body.ItemAt(0);
            stack u32[0 max] root = body.ExprRootAt(0);
            return statement.Kind == StatementKind.Become
                && stream.KindAt((u64[0 2 ** 63 - 1])statement.StartToken) == TokenKind.Become
                && root != 0
                && body.ExprKindAt(root) == ExprKind.Call;
    }
}

[Fact]
fn bool StorageClassGlobalIsParsedNotDropped()
{
    // A `heap`-led global must be classified (not `Unknown`), otherwise the
    // declaration loop would break and drop it AND every following declaration.
    stack ascii source = "heap i32 counter = 0;\nfn void after() { }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 2)
    {
        return false;
    }

    stack DeclItem globalDecl = decls.ItemAt(0);
    stack DeclItem fnDecl = decls.ItemAt(1);
    stack ascii globalName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])globalDecl.NameToken);
    stack ascii fnName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fnDecl.NameToken);
    return globalDecl.Kind == DeclarationKind.GlobalVariable
        && System.Text.Equals(globalName, "counter")
        && fnDecl.Kind == DeclarationKind.Function
        && System.Text.Equals(fnName, "after");
}

[Fact]
fn bool GenericGlobalNameIsExtracted()
{
    // The global's type may itself be generic; the name `items` follows it.
    stack ascii source = "heap List<u32> items = new();\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut DeclarationList decls = new();
    if (!ParseDeclsFromStream(stream, decls))
    {
        return false;
    }

    if (decls.Count() != 1)
    {
        return false;
    }

    stack DeclItem globalDecl = decls.ItemAt(0);
    stack ascii globalName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])globalDecl.NameToken);
    return globalDecl.Kind == DeclarationKind.GlobalVariable
        && System.Text.Equals(globalName, "items");
}

[Fact]
fn bool DynStatementIsNotClassifiedLocal()
{
    // `dyn` is not a storage class, so a `dyn`-led statement is an expression
    // statement, not a local declaration (the `stack` local before it is Local).
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f() { stack u32 a = 1; dyn b; }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var statements):
            if (statements.Count() != 2)
            {
                return false;
            }

            stack StatementItem localStatement = statements.ItemAt(0);
            stack StatementItem dynStatement = statements.ItemAt(1);
            return localStatement.Kind == StatementKind.Local
                && dynStatement.Kind == StatementKind.Expression;
    }
}

[Fact]
fn bool SignatureTypeHeadsAreExtracted()
{
    // The return type `Foo` and parameter type `Bar` are user-type heads; the
    // built-in parameter type `i32` has no head (0).
    stack ascii source = "fn Foo make(Bar a, i32 b) { }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            stack ascii returnType = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.ReturnType());
            stack ascii param0Type = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])signature.ParamTypeAt(0));
            return System.Text.Equals(returnType, "Foo")
                && System.Text.Equals(param0Type, "Bar")
                && signature.ParamTypeAt(1) == 0;
    }
}

[Fact]
fn bool RangedIntParamTypeHasNoUserHead()
{
    // A ranged-int parameter type `i32[0 max] b` has no user-type head: `max`
    // (and `min`) sit inside `[...]` at depth > 0 and must not be captured.
    stack ascii source = "fn void f(i32[0 max] b, i8[min max] c) { }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    stack mut bool foundFn = false;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    foundFn = true;
                }
            }
    }

    if (!foundFn)
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            return signature.ParamCount() == 2
                && signature.ParamTypeAt(0) == 0
                && signature.ParamTypeAt(1) == 0;
    }
}

