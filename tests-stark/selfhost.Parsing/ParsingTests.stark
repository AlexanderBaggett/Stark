    // resolve on their rightmost segment, so the captured head is the last
    // segment (`Foo` / `List`), not the namespace root.
    stack ascii source = "fn System.Foo g(System.Collections.List<u32> items) { }\n";
    stack mut TokenStream stream = new();
    if (!LexOk(LexText(source), stream))
    {
