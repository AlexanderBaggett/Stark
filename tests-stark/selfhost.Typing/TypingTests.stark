fn u32[0 max] TypedLocalDeclarationIndexByFunctionAndName(
    borrow TypedLocalDeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    ascii functionName,
    ascii localName)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0)
        {
            stack ascii actualFunction = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.FunctionNameTokenAt(index));
            stack ascii actualLocal = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(index));
            if (System.Text.Equals(actualFunction, functionName) && System.Text.Equals(actualLocal, localName))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

fn u32[0 max] TypedIdentifierNthByName(
    borrow TypedIdentifierExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    ascii name,
    u32[0 max] ordinal)
{
    stack mut u32[0 max] seen = 0;
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0)
        {
            stack ascii actual = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(index));
            if (System.Text.Equals(actual, name))
            {
                if (seen == ordinal)
                {
                    found = (u32[0 max])(index + 1);
                }

                seen = (u32[0 max])(seen + 1);
            }
        }
    }

    return found;
}

fn u32[0 max] TypedCallNthByName(
    borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    ascii name,
    u32[0 max] ordinal)
{
