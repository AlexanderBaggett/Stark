[Fact]
fn bool TypedEnumLayoutsResolveNamedAggregatePayloadLayouts()
{
    stack ascii source = raw"""
    struct Point
    {
        u8[0 max] X;
        u32[0 max] Y;
    }

    record Header(u16[0 max] Kind, bool Ready)
    {
    }

    struct Envelope
    {
        Point Location;
        u16[0 max] Count;
    }

    enum Packet
    {
        Empty,
        PointPayload(Point),
        HeaderPayload(Header),
        Wrapped(Envelope)
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedEnumLayoutTable table = new();
    if (!BuildTypedEnumLayoutTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] pointPayloadSlot = TypedEnumLayoutPayloadIndexByVariantAndOrdinal(table, source, stream, "PointPayload", 0);
    stack u32[0 max] headerPayloadSlot = TypedEnumLayoutPayloadIndexByVariantAndOrdinal(table, source, stream, "HeaderPayload", 0);
    stack u32[0 max] wrappedPayloadSlot = TypedEnumLayoutPayloadIndexByVariantAndOrdinal(table, source, stream, "Wrapped", 0);
    if (pointPayloadSlot == 0 || headerPayloadSlot == 0 || wrappedPayloadSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] pointPayload = (u64[0 2 ** 63 - 1])(pointPayloadSlot - 1);
    stack u64[0 2 ** 63 - 1] headerPayload = (u64[0 2 ** 63 - 1])(headerPayloadSlot - 1);
    stack u64[0 2 ** 63 - 1] wrappedPayload = (u64[0 2 ** 63 - 1])(wrappedPayloadSlot - 1);

    return table.Count() == 7
        && table.TypeKindAt(pointPayload) == TypedSignatureTypeKind.Named
        && table.OffsetBytesAt(pointPayload) == 4
        && table.SizeBytesAt(pointPayload) == 8
        && table.AlignmentBytesAt(pointPayload) == 4
        && table.HasConcreteLayoutAt(pointPayload)
        && table.TypeKindAt(headerPayload) == TypedSignatureTypeKind.Named
        && table.OffsetBytesAt(headerPayload) == 12
        && table.SizeBytesAt(headerPayload) == 4
        && table.AlignmentBytesAt(headerPayload) == 2
        && table.HasConcreteLayoutAt(headerPayload)
        && table.TypeKindAt(wrappedPayload) == TypedSignatureTypeKind.Named
        && table.OffsetBytesAt(wrappedPayload) == 16
        && table.SizeBytesAt(wrappedPayload) == 12
        && table.AlignmentBytesAt(wrappedPayload) == 4
        && table.HasConcreteLayoutAt(wrappedPayload);
}

