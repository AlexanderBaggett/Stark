    stack u32[0 max] doneDataSlot = TypedEnumPayloadIndexByVariantAndOrdinal(table, source, stream, "Done", 1);
    stack u32[0 max] xSlot = TypedEnumPayloadIndexByPayloadName(table, source, stream, "X");
    stack u32[0 max] ySlot = TypedEnumPayloadIndexByPayloadName(table, source, stream, "Y");
    stack u32[0 max] ioSlot = TypedEnumPayloadIndexByVariantAndOrdinal(table, source, stream, "Io", 0);
    if (doneValueSlot == 0 || doneDataSlot == 0 || xSlot == 0 || ySlot == 0 || ioSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] doneValue = (u64[0 2 ** 63 - 1])(doneValueSlot - 1);
    stack u64[0 2 ** 63 - 1] doneData = (u64[0 2 ** 63 - 1])(doneDataSlot - 1);
    stack u64[0 2 ** 63 - 1] x = (u64[0 2 ** 63 - 1])(xSlot - 1);
    stack u64[0 2 ** 63 - 1] y = (u64[0 2 ** 63 - 1])(ySlot - 1);
    stack u64[0 2 ** 63 - 1] io = (u64[0 2 ** 63 - 1])(ioSlot - 1);

    return table.Count() == 5
        && table.PayloadKindAt(doneValue) == TypedEnumPayloadKind.Positional
        && table.VariantRoleAt(doneValue) == TypedEnumVariantRole.Ok
        && table.VariantOrdinalAt(doneValue) == 0
        && table.PayloadOrdinalAt(doneValue) == 0
        && table.TypeKindAt(doneValue) == TypedSignatureTypeKind.FixedArray
        && table.TypeHeadIsGenericParameterAt(doneValue)
        && table.HasElementCountExpressionAt(doneValue)
        && table.ElementCountStartTokenAt(doneValue) != 0
        && table.PayloadKindAt(doneData) == TypedEnumPayloadKind.Positional
        && table.VariantRoleAt(doneData) == TypedEnumVariantRole.Ok
        && table.PayloadOrdinalAt(doneData) == 1
        && table.TypeKindAt(doneData) == TypedSignatureTypeKind.RawPointer
        && table.IsRawMutablePointerAt(doneData)
        && table.HasElementCountExpressionAt(doneData)
        && table.PayloadKindAt(x) == TypedEnumPayloadKind.Named
        && table.VariantOrdinalAt(x) == 1
        && table.PayloadNameTokenAt(x) != 0
        && table.TypeKindAt(x) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(x) == 32
        && table.IsIntegerSignedAt(x)
        && table.HasIntegerRangeAt(x)
        && table.RangeStartsAtMinAt(x)
        && table.RangeEndsAtMaxAt(x)
        && table.PayloadKindAt(y) == TypedEnumPayloadKind.Named
        && table.TypeKindAt(y) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(y) == 32
        && table.IsIntegerUnsignedAt(y)
        && table.HasIntegerRangeAt(y)
        && table.RangeEndsAtMaxAt(y)
        && table.PayloadKindAt(io) == TypedEnumPayloadKind.From
        && table.VariantRoleAt(io) == TypedEnumVariantRole.Err
        && table.VariantOrdinalAt(io) == 2
        && table.IsErrorFunnelAt(io)
        && table.TypeKindAt(io) == TypedSignatureTypeKind.Named;
}

