    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0 && table.CalleeNameTokenAt(index) != 0)
        {
            stack ascii actual = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.CalleeNameTokenAt(index));
            if (System.Text.Equals(actual, name))
            {
                if (seen == ordinal)
                {
                    found = (u32[0 max])(index + 1);
                }

                seen = (u32[0 max])(seen + 1);
            }
        }
    }

    return found;
}

