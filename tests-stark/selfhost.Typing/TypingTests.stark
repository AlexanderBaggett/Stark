    stack u32[0 max] pairedPayloadSlot = TypedEnumLayoutPayloadIndexByVariantAndOrdinal(table, source, stream, "Paired", 0);
    stack u32[0 max] bufferedPayloadSlot = TypedEnumLayoutPayloadIndexByVariantAndOrdinal(table, source, stream, "Buffered", 0);
    stack u32[0 max] wrappedPayloadSlot = TypedEnumLayoutPayloadIndexByVariantAndOrdinal(table, source, stream, "WrappedPayload", 0);
    if (boxedPayloadSlot == 0 || pairedPayloadSlot == 0 || bufferedPayloadSlot == 0 || wrappedPayloadSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] boxedPayload = (u64[0 2 ** 63 - 1])(boxedPayloadSlot - 1);
    stack u64[0 2 ** 63 - 1] pairedPayload = (u64[0 2 ** 63 - 1])(pairedPayloadSlot - 1);
    stack u64[0 2 ** 63 - 1] bufferedPayload = (u64[0 2 ** 63 - 1])(bufferedPayloadSlot - 1);
    stack u64[0 2 ** 63 - 1] wrappedPayload = (u64[0 2 ** 63 - 1])(wrappedPayloadSlot - 1);

    return table.Count() == 9
        && table.TypeKindAt(boxedPayload) == TypedSignatureTypeKind.Named
        && table.OffsetBytesAt(boxedPayload) == 4
        && table.SizeBytesAt(boxedPayload) == 4
        && table.AlignmentBytesAt(boxedPayload) == 4
        && table.HasConcreteLayoutAt(boxedPayload)
        && table.TypeKindAt(pairedPayload) == TypedSignatureTypeKind.Named
        && table.OffsetBytesAt(pairedPayload) == 8
        && table.SizeBytesAt(pairedPayload) == 8
        && table.AlignmentBytesAt(pairedPayload) == 4
        && table.HasConcreteLayoutAt(pairedPayload)
        && table.TypeKindAt(bufferedPayload) == TypedSignatureTypeKind.Named
        && table.OffsetBytesAt(bufferedPayload) == 16
        && table.SizeBytesAt(bufferedPayload) == 8
        && table.AlignmentBytesAt(bufferedPayload) == 2
        && table.HasConcreteLayoutAt(bufferedPayload)
        && table.TypeKindAt(wrappedPayload) == TypedSignatureTypeKind.Named
        && table.OffsetBytesAt(wrappedPayload) == 24
        && table.SizeBytesAt(wrappedPayload) == 4
        && table.AlignmentBytesAt(wrappedPayload) == 2
        && table.HasConcreteLayoutAt(wrappedPayload);
}

[Fact]
fn bool TypedEnumLayoutsPreserveControlledAggregatePayloadLayouts()
{
    stack ascii source = raw"""
    [StructLayout(C), Pack(1)]
    struct Tight
    {
        u8[0 max] Tag;
        u32[0 max] Length;
    }

    [StructLayout(C), Pack(1), Align(4)]
    struct PackedAligned
    {
        u8[0 max] Tag;
        u32[0 max] Length;
    }

    [StructLayout(Explicit), Align(4)]
    struct WordParts
    {
        [FieldOffset(0)] u32[0 max] Whole;
        [FieldOffset(0)] u16[0 max] Low;
        [FieldOffset(2)] u16[0 max] High;
    }

    enum Packet
    {
        Empty,
        TightPayload(Tight),
        WordPayload(WordParts),
        AlignedPayload(PackedAligned)
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedEnumLayoutTable table = new();
    if (!BuildTypedEnumLayoutTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] tightPayloadSlot = TypedEnumLayoutPayloadIndexByVariantAndOrdinal(table, source, stream, "TightPayload", 0);
    stack u32[0 max] wordPayloadSlot = TypedEnumLayoutPayloadIndexByVariantAndOrdinal(table, source, stream, "WordPayload", 0);
    stack u32[0 max] alignedPayloadSlot = TypedEnumLayoutPayloadIndexByVariantAndOrdinal(table, source, stream, "AlignedPayload", 0);
    if (tightPayloadSlot == 0 || wordPayloadSlot == 0 || alignedPayloadSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] tightPayload = (u64[0 2 ** 63 - 1])(tightPayloadSlot - 1);
    stack u64[0 2 ** 63 - 1] wordPayload = (u64[0 2 ** 63 - 1])(wordPayloadSlot - 1);
    stack u64[0 2 ** 63 - 1] alignedPayload = (u64[0 2 ** 63 - 1])(alignedPayloadSlot - 1);

    return table.Count() == 7
        && table.OffsetBytesAt(tightPayload) == 1
        && table.SizeBytesAt(tightPayload) == 5
        && table.AlignmentBytesAt(tightPayload) == 1
        && table.HasConcreteLayoutAt(tightPayload)
        && !table.IsMisalignedAt(tightPayload)
        && table.OffsetBytesAt(wordPayload) == 8
        && table.SizeBytesAt(wordPayload) == 4
        && table.AlignmentBytesAt(wordPayload) == 4
        && table.HasConcreteLayoutAt(wordPayload)
        && !table.IsMisalignedAt(wordPayload)
        && table.OffsetBytesAt(alignedPayload) == 12
        && table.SizeBytesAt(alignedPayload) == 8
        && table.AlignmentBytesAt(alignedPayload) == 4
        && table.HasConcreteLayoutAt(alignedPayload)
        && !table.IsMisalignedAt(alignedPayload);
}

[Fact]
fn bool TypedEnumLayoutQueriesExposeCtfeFoldConstants()
{
    stack ascii source = raw"""
    enum Packet<T>
    {
        Empty,
        Data(u8[0 max]),
        Other(u32[0 max]),
        Generic(T)
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedEnumLayoutTable table = new();
    if (!BuildTypedEnumLayoutTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] dataVariantSlot = TypedEnumLayoutVariantIndexByName(table, source, stream, "Data");
    if (dataVariantSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] dataVariant = (u64[0 2 ** 63 - 1])(dataVariantSlot - 1);
    stack u32[0 max] packetOwner = table.OwnerDeclarationIndexAt(dataVariant);

    stack mut u64[0 max] tagOffset = 0;
    stack mut u64[0 max] tagSize = 0;
    stack mut u64[0 max] tagAlign = 0;
    stack mut bool tagMisaligned = true;
    if (!table.TryGetEnumTagLayout(packetOwner, tagOffset, tagSize, tagAlign, tagMisaligned))
    {
        return false;
    }

    stack mut u64[0 max] emptyTag = 99;
    stack mut u64[0 max] dataTag = 99;
    stack mut u64[0 max] otherTag = 99;
    stack mut u64[0 max] genericTag = 99;
    if (!table.TryGetEnumVariantTag(packetOwner, 0, emptyTag)
        || !table.TryGetEnumVariantTag(packetOwner, 1, dataTag)
        || !table.TryGetEnumVariantTag(packetOwner, 2, otherTag)
        || !table.TryGetEnumVariantTag(packetOwner, 3, genericTag))
    {
        return false;
    }

    stack mut u64[0 max] emptyPayloadCount = 99;
    stack mut u64[0 max] dataPayloadCount = 99;
    stack mut u64[0 max] genericPayloadCount = 99;
    if (!table.TryGetEnumVariantPayloadCount(packetOwner, 0, emptyPayloadCount)
        || !table.TryGetEnumVariantPayloadCount(packetOwner, 1, dataPayloadCount)
        || !table.TryGetEnumVariantPayloadCount(packetOwner, 3, genericPayloadCount))
    {
        return false;
    }

    stack mut u64[0 max] dataOffset = 0;
    stack mut u64[0 max] dataSize = 0;
    stack mut u64[0 max] dataAlign = 0;
    stack mut bool dataMisaligned = true;
    stack mut u64[0 max] otherOffset = 0;
    stack mut u64[0 max] otherSize = 0;
    stack mut u64[0 max] otherAlign = 0;
    stack mut bool otherMisaligned = true;
    if (!table.TryGetEnumVariantPayloadLayout(packetOwner, 1, 0, dataOffset, dataSize, dataAlign, dataMisaligned)
        || !table.TryGetEnumVariantPayloadLayout(packetOwner, 2, 0, otherOffset, otherSize, otherAlign, otherMisaligned))
    {
        return false;
    }

    stack mut u64[0 max] missing = 0;
    stack mut u64[0 max] missingSize = 0;
    stack mut u64[0 max] missingAlign = 0;
    stack mut bool missingMisaligned = false;

    return tagOffset == 0
        && tagSize == 1
        && tagAlign == 1
        && !tagMisaligned
        && emptyTag == 0
        && dataTag == 1
        && otherTag == 2
        && genericTag == 3
        && emptyPayloadCount == 0
        && dataPayloadCount == 1
        && genericPayloadCount == 1
        && dataOffset == 1
        && dataSize == 1
        && dataAlign == 1
        && !dataMisaligned
        && otherOffset == 4
        && otherSize == 4
        && otherAlign == 4
        && !otherMisaligned
        && !table.TryGetEnumVariantTag(packetOwner, 4, missing)
        && !table.TryGetEnumVariantPayloadLayout(packetOwner, 0, 0, missing, missingSize, missingAlign, missingMisaligned)
        && !table.TryGetEnumVariantPayloadLayout(packetOwner, 3, 0, missing, missingSize, missingAlign, missingMisaligned);
}

[Fact]
fn bool TypedEnumLayoutSystemCompilerQueriesFoldToTypedConstants()
{
    stack ascii source = raw"""
    enum Packet
    {
        Empty,
        Data(u8[0 max]),
        Other(u32[0 max])
    }

    fn u64[0 max] TagOffset()
    {
        return comptime System.Compiler.EnumTagOffset<Packet>();
    }

    fn u64[0 max] TagSize()
    {
        return comptime System.Compiler.EnumTagSize<Packet>();
    }

    fn u64[0 max] TagAlign()
    {
        return comptime System.Compiler.EnumTagAlign<Packet>();
    }

    fn bool TagMisaligned()
    {
        return comptime System.Compiler.EnumTagIsMisaligned<Packet>();
    }

    fn u64[0 max] OtherTag()
    {
        return comptime System.Compiler.EnumVariantTag<Packet, +2>();
    }

    fn u64[0 max] EmptyPayloadCount()
    {
        return comptime System.Compiler.EnumVariantPayloadCount<Packet, 0>();
    }

    fn u64[0 max] OtherPayloadOffset()
    {
        return comptime System.Compiler.EnumVariantPayloadOffset<Packet, 2, 0>();
    }

    fn u64[0 max] OtherPayloadSize()
    {
        return comptime System.Compiler.EnumVariantPayloadSize<Packet, 2, 0>();
    }

    fn u64[0 max] OtherPayloadAlign()
    {
        return comptime System.Compiler.EnumVariantPayloadAlign<Packet, 2, 0>();
    }

    fn bool OtherPayloadMisaligned()
    {
        return comptime System.Compiler.EnumVariantPayloadIsMisaligned<Packet, 2, 0>();
    }
    """;

    stack mut TokenStream stream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedEnumLayoutTable table = new();
    if (!BuildTypedEnumLayoutFoldInputsForSource(source, stream, declarations, table))
    {
        return false;
    }

    return EnumLayoutQueryFoldsU64(declarations, table, source, stream, FirstTokenText(source, stream, "EnumTagOffset"), 0)
        && EnumLayoutQueryFoldsU64(declarations, table, source, stream, FirstTokenText(source, stream, "EnumTagSize"), 1)
        && EnumLayoutQueryFoldsU64(declarations, table, source, stream, FirstTokenText(source, stream, "EnumTagAlign"), 1)
        && EnumLayoutQueryFoldsBool(declarations, table, source, stream, FirstTokenText(source, stream, "EnumTagIsMisaligned"), false)
        && EnumLayoutQueryFoldsU64(declarations, table, source, stream, FirstTokenText(source, stream, "EnumVariantTag"), 2)
        && EnumLayoutQueryFoldsU64(declarations, table, source, stream, FirstTokenText(source, stream, "EnumVariantPayloadCount"), 0)
        && EnumLayoutQueryFoldsU64(declarations, table, source, stream, FirstTokenText(source, stream, "EnumVariantPayloadOffset"), 4)
        && EnumLayoutQueryFoldsU64(declarations, table, source, stream, FirstTokenText(source, stream, "EnumVariantPayloadSize"), 4)
        && EnumLayoutQueryFoldsU64(declarations, table, source, stream, FirstTokenText(source, stream, "EnumVariantPayloadAlign"), 4)
        && EnumLayoutQueryFoldsBool(declarations, table, source, stream, FirstTokenText(source, stream, "EnumVariantPayloadIsMisaligned"), false);
}

[Fact]
fn bool TypedLocalDeclarationsCaptureStorageTypeAndInitializerFacts()
{
    stack ascii source = raw"""
    fn void Work<T, comptime u8[1 8] N>(borrow T[N] input)
    {
        stack mut u32[0 max] count = 0;
        arena T[N] values = input;
        register rawmutptr<i8[min max]>[N] data = null;
        heap dynamic T items = new();
        const Limit = 4;
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedLocalDeclarationTable table = new();
    if (!BuildTypedLocalDeclarationTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] countSlot = TypedLocalDeclarationIndexByFunctionAndName(table, source, stream, "Work", "count");
    stack u32[0 max] valuesSlot = TypedLocalDeclarationIndexByFunctionAndName(table, source, stream, "Work", "values");
    stack u32[0 max] dataSlot = TypedLocalDeclarationIndexByFunctionAndName(table, source, stream, "Work", "data");
    stack u32[0 max] itemsSlot = TypedLocalDeclarationIndexByFunctionAndName(table, source, stream, "Work", "items");
    stack u32[0 max] limitSlot = TypedLocalDeclarationIndexByFunctionAndName(table, source, stream, "Work", "Limit");
    if (countSlot == 0 || valuesSlot == 0 || dataSlot == 0 || itemsSlot == 0 || limitSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = (u64[0 2 ** 63 - 1])(countSlot - 1);
    stack u64[0 2 ** 63 - 1] values = (u64[0 2 ** 63 - 1])(valuesSlot - 1);
    stack u64[0 2 ** 63 - 1] data = (u64[0 2 ** 63 - 1])(dataSlot - 1);
    stack u64[0 2 ** 63 - 1] items = (u64[0 2 ** 63 - 1])(itemsSlot - 1);
    stack u64[0 2 ** 63 - 1] limit = (u64[0 2 ** 63 - 1])(limitSlot - 1);

    return table.Count() == 5
        && table.OwnerKindAt(count) == TypedLocalDeclarationOwnerKind.TopLevelFunction
        && table.StorageKindAt(count) == TypedGlobalStorageKind.Stack
        && table.IsMutableAt(count)
        && table.TypeKindAt(count) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(count) == 32
        && table.IsIntegerUnsignedAt(count)
        && table.HasIntegerRangeAt(count)
        && table.RangeEndsAtMaxAt(count)
        && table.HasInitializerAt(count)
        && table.InitializerExprRootAt(count) != 0
        && table.StorageKindAt(values) == TypedGlobalStorageKind.Arena
        && table.TypeKindAt(values) == TypedSignatureTypeKind.FixedArray
        && table.TypeHeadIsGenericParameterAt(values)
        && table.HasElementCountExpressionAt(values)
        && table.StorageKindAt(data) == TypedGlobalStorageKind.Register
        && table.TypeKindAt(data) == TypedSignatureTypeKind.RawPointer
        && table.IsRawMutablePointerAt(data)
        && table.HasElementCountExpressionAt(data)
        && table.StorageKindAt(items) == TypedGlobalStorageKind.Heap
        && table.TypeKindAt(items) == TypedSignatureTypeKind.Dynamic
        && table.TypeHeadIsGenericParameterAt(items)
        && table.StorageKindAt(limit) == TypedGlobalStorageKind.Const
        && !table.HasExplicitTypeAt(limit)
        && table.TypeKindAt(limit) == TypedSignatureTypeKind.Unknown
        && table.HasInitializerAt(limit);
}

[Fact]
fn bool TypedLocalDeclarationsCaptureMemberLoopAndCallableFacts()
{
    stack ascii source = raw"""
    struct Runner<T>
    {
        fn void Run<T2, comptime u8[1 8] N>(borrow T2[N] input)
        {
            stack fnptr<tail fn bool(out u32[0 max]) where dead_on_return(arg0)> callback = Pick;
            for willexit (stack u32[0 max] i = 0; i < N; i += 1)
            {
                stack borrow T2 item = input[i];
            }
            for willexit (borrow T2 value in input)
            {
                value;
            }
        }
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedLocalDeclarationTable table = new();
    if (!BuildTypedLocalDeclarationTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] callbackSlot = TypedLocalDeclarationIndexByFunctionAndName(table, source, stream, "Run", "callback");
    stack u32[0 max] iSlot = TypedLocalDeclarationIndexByFunctionAndName(table, source, stream, "Run", "i");
    stack u32[0 max] itemSlot = TypedLocalDeclarationIndexByFunctionAndName(table, source, stream, "Run", "item");
    stack u32[0 max] valueSlot = TypedLocalDeclarationIndexByFunctionAndName(table, source, stream, "Run", "value");
    if (callbackSlot == 0 || iSlot == 0 || itemSlot == 0 || valueSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] callback = (u64[0 2 ** 63 - 1])(callbackSlot - 1);
    stack u64[0 2 ** 63 - 1] i = (u64[0 2 ** 63 - 1])(iSlot - 1);
    stack u64[0 2 ** 63 - 1] item = (u64[0 2 ** 63 - 1])(itemSlot - 1);
    stack u64[0 2 ** 63 - 1] value = (u64[0 2 ** 63 - 1])(valueSlot - 1);

    return table.Count() == 4
        && table.OwnerKindAt(callback) == TypedLocalDeclarationOwnerKind.MemberMethod
        && table.OwnerNameTokenAt(callback) != 0
        && table.StorageKindAt(callback) == TypedGlobalStorageKind.Stack
        && table.TypeKindAt(callback) == TypedSignatureTypeKind.FunctionPointer
        && table.IsTailCallableAt(callback)
        && table.IsDeadOnReturnAt(callback)
        && table.HasInitializerAt(callback)
        && table.StorageKindAt(i) == TypedGlobalStorageKind.Stack
        && table.TypeKindAt(i) == TypedSignatureTypeKind.Integer
        && table.IsIntegerUnsignedAt(i)
        && table.HasInitializerAt(i)
        && table.StorageKindAt(item) == TypedGlobalStorageKind.Stack
        && table.TypeKindAt(item) == TypedSignatureTypeKind.GenericParameter
        && table.IsBorrowAt(item)
        && table.TypeHeadIsGenericParameterAt(item)
        && table.DepthAt(item) > 0
        && table.StorageKindAt(value) == TypedGlobalStorageKind.Unknown
        && table.TypeKindAt(value) == TypedSignatureTypeKind.GenericParameter
        && table.IsBorrowAt(value)
        && table.TypeHeadIsGenericParameterAt(value)
        && !table.HasInitializerAt(value);
}

[Fact]
fn bool TypedStorageSelectorsCaptureDeclarationFacts()
{
    stack ascii source = raw"""
    const Limit = 8;
    static mut u32[0 max] Counter = 0;
    arena Node Root = new();
    struct Node { }
    fn void Work(dynamic Node items)
    {
        stack mut u32[0 max] count = 0;
        arena Node root = new();
        register u32[0 max] temp = 1;
        heap dynamic Node owned = new();
        const LocalLimit = 4;
        for willexit (borrow Node value in items)
        {
            value;
        }
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedStorageSelectorTable table = new();
    if (!BuildTypedStorageSelectorTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] rootSlot = TypedStorageSelectorIndexBySubject(table, source, stream, TypedStorageSelectorContext.GlobalDeclaration, "Root");
    stack u32[0 max] counterSlot = TypedStorageSelectorIndexBySubject(table, source, stream, TypedStorageSelectorContext.GlobalDeclaration, "Counter");
    stack u32[0 max] countSlot = TypedStorageSelectorIndexBySubject(table, source, stream, TypedStorageSelectorContext.LocalDeclaration, "count");
    stack u32[0 max] tempSlot = TypedStorageSelectorIndexBySubject(table, source, stream, TypedStorageSelectorContext.LocalDeclaration, "temp");
    stack u32[0 max] ownedSlot = TypedStorageSelectorIndexBySubject(table, source, stream, TypedStorageSelectorContext.LocalDeclaration, "owned");
    stack u32[0 max] localLimitSlot = TypedStorageSelectorIndexBySubject(table, source, stream, TypedStorageSelectorContext.LocalDeclaration, "LocalLimit");
    if (rootSlot == 0 || counterSlot == 0 || countSlot == 0 || tempSlot == 0 || ownedSlot == 0 || localLimitSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] root = (u64[0 2 ** 63 - 1])(rootSlot - 1);
    stack u64[0 2 ** 63 - 1] counter = (u64[0 2 ** 63 - 1])(counterSlot - 1);
    stack u64[0 2 ** 63 - 1] count = (u64[0 2 ** 63 - 1])(countSlot - 1);
    stack u64[0 2 ** 63 - 1] temp = (u64[0 2 ** 63 - 1])(tempSlot - 1);
    stack u64[0 2 ** 63 - 1] owned = (u64[0 2 ** 63 - 1])(ownedSlot - 1);
    stack u64[0 2 ** 63 - 1] localLimit = (u64[0 2 ** 63 - 1])(localLimitSlot - 1);

    return table.Count() == 8
        && TypedStorageSelectorCountByContext(table, TypedStorageSelectorContext.GlobalDeclaration) == 3
        && TypedStorageSelectorCountByContext(table, TypedStorageSelectorContext.LocalDeclaration) == 5
        && TypedStorageSelectorCountByContext(table, TypedStorageSelectorContext.NewExpression) == 0
        && table.StorageKindAt(root) == TypedGlobalStorageKind.Arena
        && table.UsesArenaFrameAt(root)
        && table.HasGlobalLifetimeAt(root)
        && table.StorageKindAt(counter) == TypedGlobalStorageKind.Static
        && table.HasGlobalLifetimeAt(counter)
        && table.StorageKindAt(count) == TypedGlobalStorageKind.Stack
        && table.StatementIndexPlusOneAt(count) != 0
        && table.HasStableAddressAt(count)
        && table.StorageKindAt(temp) == TypedGlobalStorageKind.Register
        && table.RequestsRegisterStorageAt(temp)
        && !table.HasStableAddressAt(temp)
        && table.StorageKindAt(owned) == TypedGlobalStorageKind.Heap
        && table.UsesHeapAllocatorAt(owned)
        && table.StorageKindAt(localLimit) == TypedGlobalStorageKind.Const
        && table.IsConstSelectorAt(localLimit);
}

[Fact]
fn bool TypedStorageSelectorsCaptureArenaNewFacts()
{
    stack ascii source = raw"""
    struct Node { }
    fn void Build(u32[0 max] count)
    {
        stack mut dynamic Node tokens = new(arena, count + 4, 16);
        stack mut dynamic Node more = new(arena, 32);
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedStorageSelectorTable table = new();
    if (!BuildTypedStorageSelectorTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] firstNewSlot = TypedStorageSelectorNthByContext(table, TypedStorageSelectorContext.NewExpression, 0);
    stack u32[0 max] secondNewSlot = TypedStorageSelectorNthByContext(table, TypedStorageSelectorContext.NewExpression, 1);
    stack u32[0 max] tokensSlot = TypedStorageSelectorIndexBySubject(table, source, stream, TypedStorageSelectorContext.LocalDeclaration, "tokens");
    if (firstNewSlot == 0 || secondNewSlot == 0 || tokensSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] firstNew = (u64[0 2 ** 63 - 1])(firstNewSlot - 1);
    stack u64[0 2 ** 63 - 1] secondNew = (u64[0 2 ** 63 - 1])(secondNewSlot - 1);
    stack u64[0 2 ** 63 - 1] tokens = (u64[0 2 ** 63 - 1])(tokensSlot - 1);
    stack ascii firstSelector = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.SelectorTokenAt(firstNew));
    stack ascii secondSelector = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.SelectorTokenAt(secondNew));

    return table.Count() == 4
        && TypedStorageSelectorCountByContext(table, TypedStorageSelectorContext.LocalDeclaration) == 2
        && TypedStorageSelectorCountByContext(table, TypedStorageSelectorContext.NewExpression) == 2
        && table.StorageKindAt(tokens) == TypedGlobalStorageKind.Stack
        && table.StorageKindAt(firstNew) == TypedGlobalStorageKind.Arena
        && table.IsNewExpressionAt(firstNew)
        && table.UsesArenaFrameAt(firstNew)
        && table.ExprNodeAt(firstNew) != 0
        && table.NewArgumentCountAt(firstNew) == 3
        && table.HasCapacityExpressionAt(firstNew)
        && table.HasAlignmentExpressionAt(firstNew)
        && System.Text.Equals(firstSelector, "arena")
        && table.StorageKindAt(secondNew) == TypedGlobalStorageKind.Arena
        && table.NewArgumentCountAt(secondNew) == 2
        && table.HasCapacityExpressionAt(secondNew)
        && !table.HasAlignmentExpressionAt(secondNew)
        && System.Text.Equals(secondSelector, "arena");
}

[Fact]
fn bool TypedLiteralExpressionsCaptureScalarFacts()
{
    stack ascii source = raw"""
    const Limit = 255;
    fn void Demo()
    {
        127;
        128;
        1.5;
        1.5f;
        true;
        false;
        null;
        "hi";
        '\n';
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedLiteralExpressionTable table = new();
    if (!BuildTypedLiteralExpressionTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] limitSlot = TypedLiteralIndexByTextAndKind(table, source, stream, TypedLiteralKind.Integer, "255");
    stack u32[0 max] smallSlot = TypedLiteralIndexByTextAndKind(table, source, stream, TypedLiteralKind.Integer, "127");
    stack u32[0 max] widerSlot = TypedLiteralIndexByTextAndKind(table, source, stream, TypedLiteralKind.Integer, "128");
    stack u32[0 max] float64Slot = TypedLiteralIndexByTextAndKind(table, source, stream, TypedLiteralKind.Float, "1.5");
    stack u32[0 max] float32Slot = TypedLiteralIndexByTextAndKind(table, source, stream, TypedLiteralKind.Float, "1.5f");
    stack u32[0 max] trueSlot = TypedLiteralIndexByTextAndKind(table, source, stream, TypedLiteralKind.Bool, "true");
    stack u32[0 max] falseSlot = TypedLiteralIndexByTextAndKind(table, source, stream, TypedLiteralKind.Bool, "false");
    stack u32[0 max] nullSlot = TypedLiteralIndexByTextAndKind(table, source, stream, TypedLiteralKind.Null, "null");
    if (limitSlot == 0
        || smallSlot == 0
        || widerSlot == 0
        || float64Slot == 0
        || float32Slot == 0
        || trueSlot == 0
        || falseSlot == 0
        || nullSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] limit = (u64[0 2 ** 63 - 1])(limitSlot - 1);
    stack u64[0 2 ** 63 - 1] small = (u64[0 2 ** 63 - 1])(smallSlot - 1);
    stack u64[0 2 ** 63 - 1] wider = (u64[0 2 ** 63 - 1])(widerSlot - 1);
    stack u64[0 2 ** 63 - 1] float64 = (u64[0 2 ** 63 - 1])(float64Slot - 1);
    stack u64[0 2 ** 63 - 1] float32 = (u64[0 2 ** 63 - 1])(float32Slot - 1);
    stack u64[0 2 ** 63 - 1] trueLiteral = (u64[0 2 ** 63 - 1])(trueSlot - 1);
    stack u64[0 2 ** 63 - 1] falseLiteral = (u64[0 2 ** 63 - 1])(falseSlot - 1);
    stack u64[0 2 ** 63 - 1] nullLiteral = (u64[0 2 ** 63 - 1])(nullSlot - 1);

    return table.Count() == 10
        && table.ContextAt(limit) == TypedLiteralContext.GlobalInitializer
        && table.OwnerNameTokenAt(limit) != 0
        && table.StatementIndexPlusOneAt(limit) == 0
        && table.ContextAt(small) == TypedLiteralContext.FunctionBody
        && table.FunctionNameTokenAt(small) != 0
        && table.StatementIndexPlusOneAt(small) != 0
        && table.TypeKindAt(limit) == TypedSignatureTypeKind.Integer
        && table.TypeKindAt(small) == TypedSignatureTypeKind.Integer
        && table.TypeKindAt(wider) == TypedSignatureTypeKind.Integer
        && table.ParsedOkAt(limit)
        && table.ParsedOkAt(small)
        && table.ParsedOkAt(wider)
        && table.IntegerMagnitudeAt(limit) == (u1024[0 max])255
        && table.IntegerMagnitudeAt(small) == (u1024[0 max])127
        && table.IntegerMagnitudeAt(wider) == (u1024[0 max])128
        && table.BitWidthAt(small) == 8
        && table.BitWidthAt(wider) == 16
        && table.BitWidthAt(limit) == 16
        && table.IsIntegerSignedAt(limit)
        && table.HasIntegerRangeAt(limit)
        && !table.IsCompileTimeIntegerAt(limit)
        && table.TypeKindAt(float64) == TypedSignatureTypeKind.Float
        && table.TypeKindAt(float32) == TypedSignatureTypeKind.Float
        && table.BitWidthAt(float64) == 64
        && table.BitWidthAt(float32) == 32
        && table.ParsedOkAt(float64)
        && table.ParsedOkAt(float32)
        && table.FloatValueAt(float64) == 1.5
        && table.FloatValueAt(float32) == 1.5
        && table.TypeKindAt(trueLiteral) == TypedSignatureTypeKind.Bool
        && table.BoolValueAt(trueLiteral) == 1
        && table.BoolValueAt(falseLiteral) == 0
        && table.LiteralKindAt(nullLiteral) == TypedLiteralKind.Null
        && table.TypeKindAt(nullLiteral) == TypedSignatureTypeKind.Unknown
        && table.ParsedOkAt(nullLiteral);
}

[Fact]
fn bool TypedLiteralExpressionsCaptureTextFacts()
{
    stack ascii source = raw"""
    fn void Demo()
    {
        "hi";
        '\n';
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedLiteralExpressionTable table = new();
    if (!BuildTypedLiteralExpressionTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] stringSlot = TypedLiteralNthTextKind(table, TypedTextLiteralKind.String, 0);
    stack u32[0 max] characterSlot = TypedLiteralNthTextKind(table, TypedTextLiteralKind.Character, 0);
    if (stringSlot == 0 || characterSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] stringLiteral = (u64[0 2 ** 63 - 1])(stringSlot - 1);
    stack u64[0 2 ** 63 - 1] characterLiteral = (u64[0 2 ** 63 - 1])(characterSlot - 1);

    return table.Count() == 2
        && table.IsTextLiteralAt(stringLiteral)
        && table.IsTextLiteralAt(characterLiteral)
        && table.TypeKindAt(stringLiteral) == TypedSignatureTypeKind.Text
        && table.TypeKindAt(characterLiteral) == TypedSignatureTypeKind.Text
        && table.TextLiteralKindAt(stringLiteral) == TypedTextLiteralKind.String
        && table.TextLiteralKindAt(characterLiteral) == TypedTextLiteralKind.Character
        && table.ParsedOkAt(stringLiteral)
        && table.ParsedOkAt(characterLiteral)
        && table.UsesUtf8TextStorageAt(stringLiteral)
        && table.UsesUtf8TextStorageAt(characterLiteral)
        && table.TextByteLengthAt(stringLiteral) == 2
        && table.TextCodePointLengthAt(stringLiteral) == 2
        && table.TextByteLengthAt(characterLiteral) == 1
        && table.TextCodePointLengthAt(characterLiteral) == 1
        && table.CharacterCodePointAt(characterLiteral) == 10;
}

[Fact]
fn bool TypedIdentifierExpressionsResolveValueAndDeclarationTargets()
{
    stack ascii source = raw"""
    const i32[min max] GlobalCount = 3;
    const i32[min max] Mirror = GlobalCount;
    static mut bool Flag = false;
    struct Box { }
    fn i32[min max] Sum(i32[min max] value)
    {
        stack i32[min max] local = value;
        local;
        value;
        GlobalCount;
        Flag;
        Sum;
        Box;
        Missing;
        return value;
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedIdentifierExpressionTable table = new();
    if (!BuildTypedIdentifierExpressionTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] mirrorGlobalSlot = TypedIdentifierNthByName(table, source, stream, "GlobalCount", 0);
    stack u32[0 max] bodyGlobalSlot = TypedIdentifierNthByName(table, source, stream, "GlobalCount", 1);
    stack u32[0 max] firstValueSlot = TypedIdentifierNthByName(table, source, stream, "value", 0);
    stack u32[0 max] localSlot = TypedIdentifierNthByName(table, source, stream, "local", 0);
    stack u32[0 max] flagSlot = TypedIdentifierNthByName(table, source, stream, "Flag", 0);
    stack u32[0 max] sumSlot = TypedIdentifierNthByName(table, source, stream, "Sum", 0);
    stack u32[0 max] boxSlot = TypedIdentifierNthByName(table, source, stream, "Box", 0);
    stack u32[0 max] missingSlot = TypedIdentifierNthByName(table, source, stream, "Missing", 0);
    if (mirrorGlobalSlot == 0
        || bodyGlobalSlot == 0
        || firstValueSlot == 0
        || localSlot == 0
        || flagSlot == 0
        || sumSlot == 0
        || boxSlot == 0
        || missingSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] mirrorGlobal = (u64[0 2 ** 63 - 1])(mirrorGlobalSlot - 1);
    stack u64[0 2 ** 63 - 1] bodyGlobal = (u64[0 2 ** 63 - 1])(bodyGlobalSlot - 1);
    stack u64[0 2 ** 63 - 1] firstValue = (u64[0 2 ** 63 - 1])(firstValueSlot - 1);
    stack u64[0 2 ** 63 - 1] local = (u64[0 2 ** 63 - 1])(localSlot - 1);
    stack u64[0 2 ** 63 - 1] flag = (u64[0 2 ** 63 - 1])(flagSlot - 1);
    stack u64[0 2 ** 63 - 1] sum = (u64[0 2 ** 63 - 1])(sumSlot - 1);
    stack u64[0 2 ** 63 - 1] box = (u64[0 2 ** 63 - 1])(boxSlot - 1);
    stack u64[0 2 ** 63 - 1] missing = (u64[0 2 ** 63 - 1])(missingSlot - 1);

    return table.Count() == 10
        && table.ContextAt(mirrorGlobal) == TypedIdentifierContext.GlobalInitializer
        && table.IsGlobalAt(mirrorGlobal)
        && table.StorageKindAt(mirrorGlobal) == TypedGlobalStorageKind.Const
        && table.BindingKindAt(mirrorGlobal) == TypedGlobalBindingKind.Const
        && table.TypeKindAt(mirrorGlobal) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(mirrorGlobal) == 32
        && table.IsIntegerSignedAt(mirrorGlobal)
        && table.HasIntegerRangeAt(mirrorGlobal)
        && table.ContextAt(firstValue) == TypedIdentifierContext.FunctionBody
        && table.IsParameterAt(firstValue)
        && table.TargetParameterOrdinalPlusOneAt(firstValue) == 1
        && table.TypeKindAt(firstValue) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(firstValue) == 32
        && table.IsIntegerSignedAt(firstValue)
        && table.HasIntegerRangeAt(firstValue)
        && table.IsLocalAt(local)
        && table.StorageKindAt(local) == TypedGlobalStorageKind.Stack
        && table.BindingKindAt(local) == TypedGlobalBindingKind.Immutable
        && table.TypeKindAt(local) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(local) == 32
        && table.IsGlobalAt(bodyGlobal)
        && table.StorageKindAt(bodyGlobal) == TypedGlobalStorageKind.Const
        && table.IsGlobalAt(flag)
        && table.StorageKindAt(flag) == TypedGlobalStorageKind.Static
        && table.BindingKindAt(flag) == TypedGlobalBindingKind.Mutable
        && table.TypeKindAt(flag) == TypedSignatureTypeKind.Bool
        && table.IsFunctionAt(sum)
        && table.DeclarationKindAt(sum) == DeclarationKind.Function
        && table.TargetSymbolIndexPlusOneAt(sum) != 0
        && table.IsTypeDeclarationAt(box)
        && table.DeclarationKindAt(box) == DeclarationKind.Struct
        && table.TypeKindAt(box) == TypedSignatureTypeKind.Named
        && !table.IsResolvedAt(missing);
}

[Fact]
fn bool TypedIdentifierExpressionsRespectLexicalShadowing()
{
    stack ascii source = raw"""
    fn void Shadow(i32[min max] value)
    {
        value;
        if (true)
        {
            stack bool value = true;
            value;
        }
        value;
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedIdentifierExpressionTable table = new();
    if (!BuildTypedIdentifierExpressionTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] firstValueSlot = TypedIdentifierNthByName(table, source, stream, "value", 0);
    stack u32[0 max] innerValueSlot = TypedIdentifierNthByName(table, source, stream, "value", 1);
    stack u32[0 max] lastValueSlot = TypedIdentifierNthByName(table, source, stream, "value", 2);
    if (firstValueSlot == 0 || innerValueSlot == 0 || lastValueSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] firstValue = (u64[0 2 ** 63 - 1])(firstValueSlot - 1);
    stack u64[0 2 ** 63 - 1] innerValue = (u64[0 2 ** 63 - 1])(innerValueSlot - 1);
    stack u64[0 2 ** 63 - 1] lastValue = (u64[0 2 ** 63 - 1])(lastValueSlot - 1);

    return table.Count() == 3
        && table.IsParameterAt(firstValue)
        && table.TypeKindAt(firstValue) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(firstValue) == 32
        && table.IsLocalAt(innerValue)
        && table.StorageKindAt(innerValue) == TypedGlobalStorageKind.Stack
        && table.BindingKindAt(innerValue) == TypedGlobalBindingKind.Immutable
        && table.TypeKindAt(innerValue) == TypedSignatureTypeKind.Bool
        && table.TargetStatementIndexPlusOneAt(innerValue) != 0
        && table.IsParameterAt(lastValue)
        && table.TypeKindAt(lastValue) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(lastValue) == 32;
}

[Fact]
fn bool TypedCallExpressionsCaptureDirectFunctionFacts()
{
    stack ascii source = raw"""
    fn i32[min max] Add(i32[min max] left, i32[min max] right)
    {
        return left;
    }

    const i32[min max] Seed = Add(1, 2);

    fn void Demo()
    {
        Add(3, 4);
        Missing(5);
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedCallExpressionTable table = new();
    if (!BuildTypedCallExpressionTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] globalAddSlot = TypedCallNthByName(table, source, stream, "Add", 0);
    stack u32[0 max] bodyAddSlot = TypedCallNthByName(table, source, stream, "Add", 1);
    stack u32[0 max] missingSlot = TypedCallNthByName(table, source, stream, "Missing", 0);
    if (globalAddSlot == 0 || bodyAddSlot == 0 || missingSlot == 0)
    {
        return false;
    }

    stack u32[0 max] globalFirstArgSlot = TypedCallArgumentByCallAndOrdinal(table, globalAddSlot, 0);
    stack u32[0 max] globalSecondArgSlot = TypedCallArgumentByCallAndOrdinal(table, globalAddSlot, 1);
    if (globalFirstArgSlot == 0 || globalSecondArgSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] globalAdd = (u64[0 2 ** 63 - 1])(globalAddSlot - 1);
    stack u64[0 2 ** 63 - 1] bodyAdd = (u64[0 2 ** 63 - 1])(bodyAddSlot - 1);
    stack u64[0 2 ** 63 - 1] missing = (u64[0 2 ** 63 - 1])(missingSlot - 1);
    stack u64[0 2 ** 63 - 1] globalFirstArg = (u64[0 2 ** 63 - 1])(globalFirstArgSlot - 1);
    stack u64[0 2 ** 63 - 1] globalSecondArg = (u64[0 2 ** 63 - 1])(globalSecondArgSlot - 1);

    return table.Count() == 3
        && table.ArgumentCount() == 5
        && table.ContextAt(globalAdd) == TypedCallContext.GlobalInitializer
        && table.TargetKindAt(globalAdd) == TypedCallTargetKind.DirectFunction
        && table.IsResolvedAt(globalAdd)
        && table.IsDirectAt(globalAdd)
        && table.ArityMatchesAt(globalAdd)
        && table.SignatureIndexPlusOneAt(globalAdd) != 0
        && table.ArgumentCountAt(globalAdd) == 2
        && table.ParameterCountAt(globalAdd) == 2
        && table.ReturnTypeKindAt(globalAdd) == TypedSignatureTypeKind.Integer
        && table.ReturnBitWidthAt(globalAdd) == 32
        && table.ReturnIsIntegerSignedAt(globalAdd)
        && table.ReturnHasIntegerRangeAt(globalAdd)
        && table.ArgumentExpectedTypeKindAt(globalFirstArg) == TypedSignatureTypeKind.Integer
        && table.ArgumentExpectedBitWidthAt(globalFirstArg) == 32
        && table.ArgumentExpectedIsIntegerSignedAt(globalFirstArg)
        && table.ArgumentExpectedHasIntegerRangeAt(globalFirstArg)
        && table.ArgumentExpectedTypeKindAt(globalSecondArg) == TypedSignatureTypeKind.Integer
        && table.ArgumentExpectedBitWidthAt(globalSecondArg) == 32
        && table.ContextAt(bodyAdd) == TypedCallContext.FunctionBody
        && table.TargetKindAt(bodyAdd) == TypedCallTargetKind.DirectFunction
        && table.ArityMatchesAt(bodyAdd)
        && table.TargetKindAt(missing) == TypedCallTargetKind.Unknown
        && !table.IsResolvedAt(missing)
        && table.ArgumentCountAt(missing) == 1
        && table.ParameterCountAt(missing) == 0
        && table.ReturnTypeKindAt(missing) == TypedSignatureTypeKind.Unknown;
}

[Fact]
fn bool TypedCallExpressionsResolveDirectFunctionOverloads()
{
    stack ascii source = raw"""
    fn i32[min max] Pick(i32[min max] value)
    {
        return value;
    }

    fn bool Pick(bool value)
    {
        return value;
    }

    const i32[min max] Seed = Pick(1);

    fn void Demo(i32[min max] typed, bool flag)
    {
        Pick(true);
        Pick(typed);
        Pick(flag);
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedCallExpressionTable table = new();
    if (!BuildTypedCallExpressionTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] intLiteralSlot = TypedCallNthByName(table, source, stream, "Pick", 0);
    stack u32[0 max] boolLiteralSlot = TypedCallNthByName(table, source, stream, "Pick", 1);
    stack u32[0 max] intParamSlot = TypedCallNthByName(table, source, stream, "Pick", 2);
    stack u32[0 max] boolParamSlot = TypedCallNthByName(table, source, stream, "Pick", 3);
    if (intLiteralSlot == 0 || boolLiteralSlot == 0 || intParamSlot == 0 || boolParamSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] intLiteral = (u64[0 2 ** 63 - 1])(intLiteralSlot - 1);
    stack u64[0 2 ** 63 - 1] boolLiteral = (u64[0 2 ** 63 - 1])(boolLiteralSlot - 1);
    stack u64[0 2 ** 63 - 1] intParam = (u64[0 2 ** 63 - 1])(intParamSlot - 1);
    stack u64[0 2 ** 63 - 1] boolParam = (u64[0 2 ** 63 - 1])(boolParamSlot - 1);

    return table.Count() == 4
        && table.OverloadCandidateCountAt(intLiteral) == 2
        && table.OverloadViableCandidateCountAt(intLiteral) == 1
        && table.OverloadBestCandidateCountAt(intLiteral) == 1
        && table.OverloadResolvedAt(intLiteral)
        && table.IsResolvedAt(intLiteral)
        && table.ArityMatchesAt(intLiteral)
        && table.ReturnTypeKindAt(intLiteral) == TypedSignatureTypeKind.Integer
        && table.ReturnBitWidthAt(intLiteral) == 32
        && table.OverloadCandidateCountAt(boolLiteral) == 2
        && table.OverloadViableCandidateCountAt(boolLiteral) == 1
        && table.OverloadBestCandidateCountAt(boolLiteral) == 1
        && table.OverloadResolvedAt(boolLiteral)
        && table.ReturnTypeKindAt(boolLiteral) == TypedSignatureTypeKind.Bool
        && table.OverloadResolvedAt(intParam)
        && table.ReturnTypeKindAt(intParam) == TypedSignatureTypeKind.Integer
        && table.ReturnBitWidthAt(intParam) == 32
        && table.OverloadResolvedAt(boolParam)
        && table.ReturnTypeKindAt(boolParam) == TypedSignatureTypeKind.Bool;
}

[Fact]
fn bool TypedCallExpressionsReportAmbiguousAndNoMatchOverloads()
{
    stack ascii source = raw"""
    fn i32[min max] Same(i32[min max] value)
    {
        return value;
    }

    fn i64[min max] Same(i32[min max] value)
    {
        return value;
    }

    fn i32[min max] NeedInt(i32[min max] value)
    {
        return value;
    }

    fn void Demo(i32[min max] value, bool flag)
    {
        Same(value);
        NeedInt(flag);
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedCallExpressionTable table = new();
    if (!BuildTypedCallExpressionTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] sameSlot = TypedCallNthByName(table, source, stream, "Same", 0);
    stack u32[0 max] needIntSlot = TypedCallNthByName(table, source, stream, "NeedInt", 0);
    if (sameSlot == 0 || needIntSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] sameCall = (u64[0 2 ** 63 - 1])(sameSlot - 1);
    stack u64[0 2 ** 63 - 1] needInt = (u64[0 2 ** 63 - 1])(needIntSlot - 1);

    return table.TargetKindAt(sameCall) == TypedCallTargetKind.DirectFunction
        && table.IsDirectAt(sameCall)
        && !table.IsResolvedAt(sameCall)
        && table.OverloadAmbiguousAt(sameCall)
        && table.OverloadCandidateCountAt(sameCall) == 2
        && table.OverloadViableCandidateCountAt(sameCall) == 2
        && table.OverloadBestCandidateCountAt(sameCall) == 2
        && table.SignatureIndexPlusOneAt(sameCall) == 0
        && table.ReturnTypeKindAt(sameCall) == TypedSignatureTypeKind.Unknown
        && table.TargetKindAt(needInt) == TypedCallTargetKind.DirectFunction
        && table.IsDirectAt(needInt)
        && !table.IsResolvedAt(needInt)
        && table.OverloadNoMatchAt(needInt)
        && table.OverloadCandidateCountAt(needInt) == 1
        && table.OverloadViableCandidateCountAt(needInt) == 0
        && table.OverloadBestCandidateCountAt(needInt) == 0
        && table.SignatureIndexPlusOneAt(needInt) == 0
        && table.ReturnTypeKindAt(needInt) == TypedSignatureTypeKind.Unknown;
}

[Fact]
fn bool TypedCallExpressionsResolveMethodCalls()
{
    stack ascii source = raw"""
    struct Counter
    {
        u32[0 max] Count;

        fn i32[min max] Next(i32[min max] delta)
        {
            return delta;
        }

        fn u64[0 max] Read(borrow Counter self)
        {
            return self.Count;
        }

        static fn Counter Create(bool flag)
        {
            return new Counter();
        }
    }

    fn void Demo(Counter counter, bool flag)
    {
        counter.Next(1);
        counter.Read();
        Counter.Create(flag);
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedCallExpressionTable table = new();
    if (!BuildTypedCallExpressionTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] nextSlot = TypedCallNthByName(table, source, stream, "Next", 0);
    stack u32[0 max] readSlot = TypedCallNthByName(table, source, stream, "Read", 0);
    stack u32[0 max] createSlot = TypedCallNthByName(table, source, stream, "Create", 0);
    if (nextSlot == 0 || readSlot == 0 || createSlot == 0)
    {
        return false;
    }

    stack u32[0 max] nextArgSlot = TypedCallArgumentByCallAndOrdinal(table, nextSlot, 0);
    stack u32[0 max] createArgSlot = TypedCallArgumentByCallAndOrdinal(table, createSlot, 0);
    if (nextArgSlot == 0 || createArgSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] next = (u64[0 2 ** 63 - 1])(nextSlot - 1);
    stack u64[0 2 ** 63 - 1] read = (u64[0 2 ** 63 - 1])(readSlot - 1);
    stack u64[0 2 ** 63 - 1] create = (u64[0 2 ** 63 - 1])(createSlot - 1);
    stack u64[0 2 ** 63 - 1] nextArg = (u64[0 2 ** 63 - 1])(nextArgSlot - 1);
    stack u64[0 2 ** 63 - 1] createArg = (u64[0 2 ** 63 - 1])(createArgSlot - 1);
    stack ascii createReturnHead = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.ReturnTypeHeadTokenAt(create));

    return table.Count() == 3
        && table.ArgumentCount() == 2
        && table.TargetKindAt(next) == TypedCallTargetKind.InstanceMethod
        && table.IsResolvedAt(next)
        && table.IsDirectAt(next)
        && table.OverloadResolvedAt(next)
        && table.OverloadCandidateCountAt(next) == 1
        && table.OverloadViableCandidateCountAt(next) == 1
        && table.OverloadBestCandidateCountAt(next) == 1
        && table.SignatureIndexPlusOneAt(next) != 0
        && table.TargetSymbolIndexPlusOneAt(next) == table.SignatureIndexPlusOneAt(next)
        && table.ArityMatchesAt(next)
        && table.ArgumentCountAt(next) == 1
        && table.ParameterCountAt(next) == 1
        && table.ReturnTypeKindAt(next) == TypedSignatureTypeKind.Integer
        && table.ReturnBitWidthAt(next) == 32
        && table.ArgumentExpectedTypeKindAt(nextArg) == TypedSignatureTypeKind.Integer
        && table.ArgumentExpectedBitWidthAt(nextArg) == 32
        && table.ArgumentExpectedIsIntegerSignedAt(nextArg)
        && table.TargetKindAt(read) == TypedCallTargetKind.InstanceMethod
        && table.IsResolvedAt(read)
        && table.IsDirectAt(read)
        && table.OverloadResolvedAt(read)
        && table.ArityMatchesAt(read)
        && table.ArgumentCountAt(read) == 0
        && table.ParameterCountAt(read) == 1
        && table.ReturnTypeKindAt(read) == TypedSignatureTypeKind.Integer
        && table.ReturnBitWidthAt(read) == 64
        && table.ReturnHasIntegerRangeAt(read)
        && table.TargetKindAt(create) == TypedCallTargetKind.StaticMethod
        && table.IsResolvedAt(create)
        && table.IsDirectAt(create)
        && table.OverloadResolvedAt(create)
        && table.ArityMatchesAt(create)
        && table.ArgumentCountAt(create) == 1
        && table.ParameterCountAt(create) == 1
        && table.ReturnTypeKindAt(create) == TypedSignatureTypeKind.Named
        && System.Text.Equals(createReturnHead, "Counter")
        && table.ArgumentExpectedTypeKindAt(createArg) == TypedSignatureTypeKind.Bool;
}

[Fact]
