[Fact]
fn bool ClassifiesParameterTypes()
{
    // Each parameter's type-primary token maps to its value type: i32 -> Int,
    // f64 -> Float, bool -> Bool, ascii -> Text, and a user type Foo -> Unknown.
    stack mut TokenStream stream = new();
    if (!LexOk(LexText("fn void f(i32 a, f64 b, bool c, ascii d, Foo e) { }"), stream))
    {
        return false;
    }

    stack mut u32[0 max] fnKeyword = 0;
    if (!FirstFunctionKeyword(stream, fnKeyword))
    {
        return false;
    }

    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var signature):
            if (signature.ParamCount() != 5)
            {
                return false;
            }

            return MapTypeToken(stream, signature.ParamTypeTokenAt(0)) == ExprType.Int
                && MapTypeToken(stream, signature.ParamTypeTokenAt(1)) == ExprType.Float
                && MapTypeToken(stream, signature.ParamTypeTokenAt(2)) == ExprType.Bool
                && MapTypeToken(stream, signature.ParamTypeTokenAt(3)) == ExprType.Text
                && MapTypeToken(stream, signature.ParamTypeTokenAt(4)) == ExprType.Unknown;
    }
}

[Fact]
fn bool TypedFunctionSignaturesCaptureScalarRangeAndPointerFacts()
{
    stack ascii source = raw"""
    unsafe fn i32[0 max] Fill(
        out rawmutptr<i8[min max]>[length] buffer,
        u64[1 16] length,
        borrow bool flag)
        where dead_on_return(buffer)
    {
        return 0;
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedFunctionSignatureTable table = new();
    if (!BuildTypedSignatureTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] fillSlot = TypedSignatureIndexByName(table, source, stream, "Fill");
    if (fillSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] fillIndex = (u64[0 2 ** 63 - 1])(fillSlot - 1);
    stack u32[0 max] returnSlot = table.ReturnTypeSlotIndexPlusOneAt(fillIndex);
    stack u32[0 max] bufferSlot = table.ParameterTypeSlotIndexPlusOneAt(fillIndex, 0);
    stack u32[0 max] lengthSlot = table.ParameterTypeSlotIndexPlusOneAt(fillIndex, 1);
    stack u32[0 max] flagSlot = table.ParameterTypeSlotIndexPlusOneAt(fillIndex, 2);
    if (returnSlot == 0 || bufferSlot == 0 || lengthSlot == 0 || flagSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] returnIndex = (u64[0 2 ** 63 - 1])(returnSlot - 1);
    stack u64[0 2 ** 63 - 1] bufferIndex = (u64[0 2 ** 63 - 1])(bufferSlot - 1);
    stack u64[0 2 ** 63 - 1] lengthIndex = (u64[0 2 ** 63 - 1])(lengthSlot - 1);
    stack u64[0 2 ** 63 - 1] flagIndex = (u64[0 2 ** 63 - 1])(flagSlot - 1);

    return table.Count() == 1
        && table.TypeSlotCount() == 4
        && table.ParamCountAt(fillIndex) == 3
        && table.TypeKindAt(returnIndex) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(returnIndex) == 32
        && table.IsIntegerSignedAt(returnIndex)
        && table.HasIntegerRangeAt(returnIndex)
        && table.RangeStartTokenAt(returnIndex) != 0
        && table.TypeKindAt(bufferIndex) == TypedSignatureTypeKind.RawPointer
        && table.IsOutAt(bufferIndex)
        && table.IsRawMutablePointerAt(bufferIndex)
        && table.HasElementCountExpressionAt(bufferIndex)
        && table.ElementCountStartTokenAt(bufferIndex) != 0
        && table.IsDeadOnReturnAt(bufferIndex)
        && table.TypeKindAt(lengthIndex) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(lengthIndex) == 64
        && table.IsIntegerUnsignedAt(lengthIndex)
        && table.HasIntegerRangeAt(lengthIndex)
        && table.TypeKindAt(flagIndex) == TypedSignatureTypeKind.Bool
        && table.IsBorrowAt(flagIndex);
}

[Fact]
fn bool TypedFunctionSignaturesCaptureGenericCallableAndMemberFacts()
{
    stack ascii source = raw"""
    struct Mapper<T>
    {
        tail finite law fn fnptr<tail fn bool(out u32[0 max]) where dead_on_return(arg0)> Make<U, comptime u8[1 8] N>(
            borrow T[N] values,
            dynamic U items);
    }

    fn T Pick<T, comptime u8[1 8] N>(T value)
    {
        return value;
    }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedFunctionSignatureTable table = new();
    if (!BuildTypedSignatureTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] makeSlot = TypedSignatureIndexByName(table, source, stream, "Make");
    stack u32[0 max] pickSlot = TypedSignatureIndexByName(table, source, stream, "Pick");
    if (makeSlot == 0 || pickSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] makeIndex = (u64[0 2 ** 63 - 1])(makeSlot - 1);
    stack u64[0 2 ** 63 - 1] pickIndex = (u64[0 2 ** 63 - 1])(pickSlot - 1);
    stack u64[0 2 ** 63 - 1] makeReturn = (u64[0 2 ** 63 - 1])(table.ReturnTypeSlotIndexPlusOneAt(makeIndex) - 1);
    stack u64[0 2 ** 63 - 1] makeValues = (u64[0 2 ** 63 - 1])(table.ParameterTypeSlotIndexPlusOneAt(makeIndex, 0) - 1);
    stack u64[0 2 ** 63 - 1] makeItems = (u64[0 2 ** 63 - 1])(table.ParameterTypeSlotIndexPlusOneAt(makeIndex, 1) - 1);
    stack u64[0 2 ** 63 - 1] pickReturn = (u64[0 2 ** 63 - 1])(table.ReturnTypeSlotIndexPlusOneAt(pickIndex) - 1);
    stack u64[0 2 ** 63 - 1] pickValue = (u64[0 2 ** 63 - 1])(table.ParameterTypeSlotIndexPlusOneAt(pickIndex, 0) - 1);

    return table.Count() == 2
        && table.TypeSlotCount() == 5
        && table.OwnerKindAt(makeIndex) == TypedSignatureOwnerKind.MemberMethod
        && table.GenericParamCountAt(makeIndex) == 1
        && table.ComptimeGenericParamCountAt(makeIndex) == 1
        && table.TypeKindAt(makeReturn) == TypedSignatureTypeKind.FunctionPointer
        && table.IsTailCallableAt(makeReturn)
        && table.IsDeadOnReturnAt(makeReturn)
        && table.TypeKindAt(makeValues) == TypedSignatureTypeKind.FixedArray
        && table.IsBorrowAt(makeValues)
        && table.HasElementCountExpressionAt(makeValues)
        && table.TypeHeadIsGenericParameterAt(makeValues)
        && table.TypeKindAt(makeItems) == TypedSignatureTypeKind.Dynamic
        && table.TypeHeadIsGenericParameterAt(makeItems)
        && table.OwnerKindAt(pickIndex) == TypedSignatureOwnerKind.TopLevelFunction
        && table.GenericParamCountAt(pickIndex) == 1
        && table.ComptimeGenericParamCountAt(pickIndex) == 1
        && table.TypeKindAt(pickReturn) == TypedSignatureTypeKind.GenericParameter
        && table.TypeHeadIsGenericParameterAt(pickReturn)
        && table.TypeKindAt(pickValue) == TypedSignatureTypeKind.GenericParameter
        && table.TypeHeadIsGenericParameterAt(pickValue);
}

[Fact]
fn bool TypedGlobalDeclarationsCaptureStorageBindingAndBackendFacts()
{
    stack ascii source = raw"""
    const Limit = 5;
    const u8 Count = 80;
    static mut rawmutptr<i8[min max]>[Count] Buffer = null;
    heap dyn Speaker Boxed = null;
    arena Widget Temp = new Widget();
    register u64[0 max] Ticks = 0;
    fn void skip() { }
    """;

    stack mut TokenStream stream = new();
    stack mut TypedGlobalDeclarationTable table = new();
    if (!BuildTypedGlobalTableForSource(source, stream, table))
    {
        return false;
    }

    stack u32[0 max] limitSlot = TypedGlobalIndexByName(table, source, stream, "Limit");
    stack u32[0 max] countSlot = TypedGlobalIndexByName(table, source, stream, "Count");
    stack u32[0 max] bufferSlot = TypedGlobalIndexByName(table, source, stream, "Buffer");
    stack u32[0 max] boxedSlot = TypedGlobalIndexByName(table, source, stream, "Boxed");
    stack u32[0 max] tempSlot = TypedGlobalIndexByName(table, source, stream, "Temp");
    stack u32[0 max] ticksSlot = TypedGlobalIndexByName(table, source, stream, "Ticks");
    if (limitSlot == 0 || countSlot == 0 || bufferSlot == 0 || boxedSlot == 0 || tempSlot == 0 || ticksSlot == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] limit = (u64[0 2 ** 63 - 1])(limitSlot - 1);
    stack u64[0 2 ** 63 - 1] count = (u64[0 2 ** 63 - 1])(countSlot - 1);
    stack u64[0 2 ** 63 - 1] buffer = (u64[0 2 ** 63 - 1])(bufferSlot - 1);
    stack u64[0 2 ** 63 - 1] boxed = (u64[0 2 ** 63 - 1])(boxedSlot - 1);
    stack u64[0 2 ** 63 - 1] temp = (u64[0 2 ** 63 - 1])(tempSlot - 1);
    stack u64[0 2 ** 63 - 1] ticks = (u64[0 2 ** 63 - 1])(ticksSlot - 1);

    return table.Count() == 6
        && table.IsConstAt(limit)
        && table.StorageKindAt(limit) == TypedGlobalStorageKind.Const
        && !table.HasExplicitTypeAt(limit)
        && table.HasInitializerAt(limit)
        && table.IsConstAt(count)
        && table.HasExplicitTypeAt(count)
        && table.TypeKindAt(count) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(count) == 8
        && table.IsIntegerUnsignedAt(count)
        && table.StorageKindAt(buffer) == TypedGlobalStorageKind.Static
        && table.IsMutableAt(buffer)
        && table.TypeKindAt(buffer) == TypedSignatureTypeKind.RawPointer
        && table.IsRawMutablePointerAt(buffer)
        && table.HasElementCountExpressionAt(buffer)
        && table.ElementCountStartTokenAt(buffer) != 0
        && table.StorageKindAt(boxed) == TypedGlobalStorageKind.Heap
        && table.TypeKindAt(boxed) == TypedSignatureTypeKind.Dynamic
        && table.StorageKindAt(temp) == TypedGlobalStorageKind.Arena
        && table.TypeKindAt(temp) == TypedSignatureTypeKind.Named
        && table.StorageKindAt(ticks) == TypedGlobalStorageKind.Register
        && table.IsImmutableAt(ticks)
        && table.TypeKindAt(ticks) == TypedSignatureTypeKind.Integer
        && table.BitWidthAt(ticks) == 64
        && table.IsIntegerUnsignedAt(ticks)
        && table.HasIntegerRangeAt(ticks)
        && table.RangeEndsAtMaxAt(ticks);
}

