import Compiler.Typing
import Compiler.Parsing
import Compiler.Lexing
import System.Testing
import System.Text
[Collection("typing")]
module TypingTests

fn bool LexOk(LexResult<TokenStream> result, out TokenStream stream)
{
    switch (result)
    {
        case LexResult<TokenStream>.Err(var error):
            stream = new();
            return false;
        case LexResult<TokenStream>.Ok(var value):
            stream = value;
            return true;
    }
}

// Finds the keyword token of the sole function declaration in an already-lexed
// stream. False when the stream is not a single function.
fn bool FirstFunctionKeyword(borrow TokenStream stream, out u32[0 max] fnKeyword)
{
    fnKeyword = 0;
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var decls):
            if (decls.Count() == 1)
            {
                stack DeclItem only = decls.ItemAt(0);
                if (only.Kind == DeclarationKind.Function)
                {
                    fnKeyword = only.KeywordToken;
                    return true;
                }
            }

            return false;
    }
}

fn bool BuildTypedSignatureTableForSource(ascii source, out TokenStream stream, out TypedFunctionSignatureTable table)
{
    stream = new();
    table = new();
    stack mut TokenStream parsedStream = new();
    if (!LexOk(LexText(source), parsedStream))
    {
        return false;
    }

    stack mut DeclarationList declarations = new();
    switch (ParseDeclarations(parsedStream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDeclarations):
            declarations = parsedDeclarations;
    }

    switch (BuildTypedFunctionSignatures(source, parsedStream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return false;
        case ParseResult<TypedFunctionSignatureTable>.Ok(var builtTable):
            stream = parsedStream;
            table = builtTable;
            return true;
    }
}

fn u32[0 max] TypedSignatureIndexByName(borrow TypedFunctionSignatureTable table, ascii source, borrow TokenStream stream, ascii name)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0)
        {
            stack ascii actual = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(index));
            if (System.Text.Equals(actual, name))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

