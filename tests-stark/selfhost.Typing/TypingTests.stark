fn u32[0 max] FirstTokenText(ascii source, borrow TokenStream stream, ascii text)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0)
        {
            stack ascii actual = Compiler.Lexing.TokenTextOf(source, stream, index);
            if (System.Text.Equals(actual, text))
            {
                found = (u32[0 max])index;
            }
        }
    }

    return found;
}

fn bool EnumLayoutQueryFoldsU64(
    borrow DeclarationList declarations,
    borrow TypedEnumLayoutTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] queryNameToken,
    u64[0 max] expected)
{
    stack mut TypedLayoutQueryConstant constant = new();
    return TryFoldEnumLayoutComptimeQueryCall(declarations, table, source, stream, queryNameToken, constant)
        && constant.IsU64()
        && constant.U64Value() == expected;
}

fn bool EnumLayoutQueryFoldsBool(
    borrow DeclarationList declarations,
    borrow TypedEnumLayoutTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] queryNameToken,
    bool expected)
{
    stack mut TypedLayoutQueryConstant constant = new();
    return TryFoldEnumLayoutComptimeQueryCall(declarations, table, source, stream, queryNameToken, constant)
        && constant.IsBool()
        && constant.BoolValue() == expected;
}

