fn u32[0 max] TypedCallArgumentByCallAndOrdinal(
    borrow TypedCallExpressionTable table,
    u32[0 max] callIndexPlusOne,
    u32[0 max] ordinal)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.ArgumentCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && table.ArgumentCallIndexPlusOneAt(index) == callIndexPlusOne
            && table.ArgumentOrdinalAt(index) == ordinal)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

