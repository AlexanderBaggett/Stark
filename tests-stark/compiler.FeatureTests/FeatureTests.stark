[Fact]
[Collection("ffi", "traits", "lowering")]
fn bool OpenGenericFunctionTemplatesDoNotEmitRuntimeAbiDeclarations()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "generic-open-template-abi",
            raw"""
module Demo

finite law T Identity<T>(T value)
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    if (acc > -4000000000000000000)
    {
        return value;
    }

    return value;
}

finite law i32[min max] Run(i32[min max] value)
{
    return Identity(value);
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "define internal dso_local fastcc noundef i32 @__stark_mono_fn_Demo__Identity__i32(")
            && Contains(llvm, "call fastcc i32 @__stark_mono_fn_Demo__Identity__i32(")
            && DoesNotContain(llvm, "declare fastcc noundef ptr @Identity(")
            && DoesNotContain(llvm, "define fastcc noundef ptr @Identity(");
    }
}

