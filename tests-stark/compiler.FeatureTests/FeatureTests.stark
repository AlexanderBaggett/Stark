{
    i32[min max] W;
}

finite law bool Run()
{
    return comptime System.Compiler.ImplementedTraitTypeIsTrait<Widget, 1>();
}
""");
        if (!FailsWithDiagnosticMessage(indexResult, "STK3054", "implemented-trait index '1' is out of range"))
        {
            return false;
        }

        stack mut LlvmCompile typeArgumentIndexResult = CompileTypeCheck(
            "comptime-d-impl-trait-type-arg-index",
            raw"""
module Demo

trait Tagged<T, comptime u8[1 8] N>
{
}

struct Widget : Tagged<i32[min max], 4>
{
    i32[min max] W;
}

finite law bool Run()
{
    return comptime System.Compiler.ImplementedTraitTypeArgumentTypeIsInteger<Widget, 0, 1>();
}
""");
        if (!FailsWithDiagnosticMessage(typeArgumentIndexResult, "STK3054", "implemented-trait type argument index '1' is out of range"))
        {
            return false;
        }

        stack mut LlvmCompile comptimeArgumentIndexResult = CompileTypeCheck(
            "comptime-d-impl-trait-ct-arg-index",
            raw"""
module Demo

trait Tagged<T, comptime u8[1 8] N>
{
}

struct Widget : Tagged<i32[min max], 4>
{
    i32[min max] W;
}

finite law bool Run()
{
    return comptime System.Compiler.ImplementedTraitTypeComptimeArgumentTypeIsInteger<Widget, 0, 1>();
}
""");
        if (!FailsWithDiagnosticMessage(comptimeArgumentIndexResult, "STK3054", "implemented-trait comptime argument index '1' is out of range"))
        {
            return false;
        }

        stack mut LlvmCompile traitArgumentResult = CompileTypeCheck(
            "comptime-d-impl-trait-trait-arg",
