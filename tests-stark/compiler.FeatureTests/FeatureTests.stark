// BoundOperations/MIR object assertions re-expressed over the MIR text: both
// dynview forms lower, and the components keep their representation types.
[Fact]
[Collection("traits")]
fn bool UnsafeDynTraitFromPartsCanRoundTripContextAndVtable()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileMir(
            "traits-dynview-roundtrip",
            raw"""
module Demo

dyn trait Speaker
{
    finite law i32[min max] Speak(borrow Self self);
}

struct Dog : Speaker
{
    i32[min max] Volume;

    finite law i32[min max] Speak(borrow Dog self)
    {
        return self.Volume;
    }
}

unsafe finite law i32[min max] RoundTrip()
{
    stack Dog d = new Dog() { Volume = 9 };
    stack borrow dyn Speaker natural = d;
    stack rawmutptr<i8[min max]> context = natural.Context;
    stack rawptr<Speaker.Vtable> table = natural.Vtable;
    stack borrow dyn Speaker explicitView = dynview<Speaker>(context, table);
    stack borrow dyn Speaker inferredView = dynview(context, table);
    return explicitView.Speak() + inferredView.Speak();
}

export fn i32[min max] main()
{
    unsafe
    {
        return RoundTrip();
    }
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii mir = Mir(compiled);
        return Contains(mir, "rawptr<Speaker.Vtable>")
            && Contains(mir, "rawmutptr<i8>")
            && Contains(mir, "natural.vtable")
            && Contains(mir, "natural.context")
            && Contains(mir, "dyn<Speaker>")
            && Contains(mir, "= dynview<Speaker>(context,table)")
            && Contains(mir, "= dynview(context,table)");
    }
}

[Fact]
[Collection("traits", "diagnostics")]
fn bool UnsafeDynTraitFromPartsRejectsSafeUseAndWrongVtable()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "traits-dynview-rejects",
            raw"""
module Demo

dyn trait Speaker
{
    finite law i32[min max] Speak(borrow Self self);
}

dyn trait Reader
{
    finite law i32[min max] Read(borrow Self self);
}

finite law i32[min max] SafeConstruction(rawmutptr<i8[min max]> context, rawptr<Speaker.Vtable> table)
{
    stack borrow dyn Speaker value = dynview<Speaker>(context, table);
    return 1;
}

finite law i32[min max] SafeDecompose(borrow dyn Speaker value)
{
    stack rawmutptr<i8[min max]> context = value.Context;
    return 1;
}

unsafe finite law i32[min max] WrongTable(rawmutptr<i8[min max]> context, rawptr<Reader.Vtable> table)
{
    stack borrow dyn Speaker value = dynview<Speaker>(context, table);
    return 1;
}
""");
        return FailsWithDiagnostic(compiled, "STK3024")
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3024", "dynview(context, vtable)") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3024", "representation member '.Context'") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "rawptr<Speaker.Vtable>") >= 1
            && CountDiagnosticsWithCodeAndMessage(compiled, "STK3002", "rawptr<Reader.Vtable>") >= 1;
    }
}

// BoundOperations assertion re-expressed as MIR lowering success of dynbox
// plus the owned dyn type appearing in the MIR text.
[Fact]
[Collection("traits")]
fn bool UnsafeDynBoxFromPartsConstructsOwnedDynTraitObject()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileMir(
            "traits-dynbox",
            raw"""
module Demo

dyn trait Speaker
{
    finite law i32[min max] Speak(borrow Self self);
}

unsafe finite law heap dyn Speaker Adopt(rawmutptr<i8[min max]> context, rawptr<Speaker.Vtable> table)
{
    return dynbox<Speaker>(context, table);
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii mir = Mir(compiled);
        return Contains(mir, "heap dyn Speaker");
    }
}

[Fact]
[Collection("traits")]
fn bool TraitAssociatedTypeRequirementSubstitutesIntoConcreteImplementation()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "traits-associated-type",
            raw"""
module Demo

trait Reader
{
    alias Item;

    finite law Self.Item Read(borrow Self self);
}

struct Counter : Reader
{
    alias Item = i32[min max];

    i32[min max] Value;

    finite law i32[min max] Read(borrow Counter self)
    {
        return self.Value;
    }
}

finite law T.Item ReadGeneric<T>(borrow T value) where T: Reader
{
    return value.Read();
}

export fn i32[min max] main()
{
    stack Counter c = new Counter() { Value = 41 };
    return ReadGeneric(c) + 1;
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "call fastcc i32 @Counter_Read(")
            && Contains(llvm, "__stark_mono_fn_Demo__ReadGeneric__Counter")
            && DoesNotContain(llvm, "vtable")
            && DoesNotContain(llvm, "Vtable")
            && DoesNotContain(llvm, "fnptr");
    }
}

