            "comptime-c-generic-param-oob-generic",
            raw"""
module Demo

struct Box<T>
{
    T Value;
}

finite law ascii Run()
{
    return comptime System.Compiler.TypeGenericParameterName<Box<i32[min max]>, 1>();
}
""");

        stack mut LlvmCompile comptimeResult = CompileTypeCheck(
            "comptime-c-generic-param-oob-comptime",
            raw"""
module Demo

struct Buffer<T, comptime u8[1 8] N>
{
    T[N] Items;
}

finite law bool Run()
{
    return comptime System.Compiler.TypeComptimeGenericParameterTypeIsInteger<Buffer<i32[min max], 4>, 1>();
}
""");

        stack mut LlvmCompile methodComptimeResult = CompileTypeCheck(
            "comptime-c-generic-param-oob-method",
            raw"""
module Demo

struct Tool
{
    finite law T Pick<T, comptime u8[1 8] N>(T value)
    {
        return value;
    }
}

finite law bool Run()
{
    return comptime System.Compiler.MethodComptimeGenericParameterTypeIsInteger<Tool, 0, 1>();
}
""");

        stack mut LlvmCompile typeArgumentResult = CompileTypeCheck(
            "comptime-c-generic-param-oob-type-arg",
            raw"""
module Demo

struct Box<T>
{
    T Value;
}

finite law bool Run()
{
    return comptime System.Compiler.TypeArgumentTypeIsInteger<Box<i32[min max]>, 1>();
}
""");

        stack mut LlvmCompile typeArgumentMetadataResult = CompileTypeCheck(
            "comptime-c-generic-param-oob-arg-meta",
            raw"""
module Demo

struct Box<T>
{
    T Value;
}

finite law ascii Run()
{
    return comptime System.Compiler.TypeArgumentTypeDisplayName<Box<i32[min max]>, 1>();
}
""");
        return FailsWithDiagnosticMessage(genericResult, "STK3054", "generic parameter index '1' is out of range")
            && FailsWithDiagnosticMessage(comptimeResult, "STK3054", "comptime generic parameter index '1' is out of range")
            && FailsWithDiagnosticMessage(methodComptimeResult, "STK3054", "comptime generic parameter index '1' is out of range")
            && FailsWithDiagnosticMessage(typeArgumentResult, "STK3054", "type argument index '1' is out of range")
            && FailsWithDiagnosticMessage(typeArgumentMetadataResult, "STK3054", "type argument index '1' is out of range");
    }
}

