[Fact]
fn bool ComptimeTypeLayoutFactsFoldToConstants()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "comptime-b-type-layout-fold",
            raw"""
module Demo

[StructLayout(C), Pack(1), Align(4)]
struct Packet
{
    u8[0 max] Tag;
    u32[0 max] Length;
}

struct Marker
{
}

finite law u64[0 max] TypeSizeOf<T>()
{
    return comptime System.Compiler.TypeSize<T>();
}

finite law u64[0 max] Run()
{
    return comptime System.Compiler.TypeSize<Packet>()
        + comptime System.Compiler.TypeAlign<Packet>()
        + comptime TypeSizeOf<Packet>();
}

finite law bool PacketIsZeroSized()
{
    return comptime System.Compiler.TypeIsZeroSized<Packet>();
}

finite law bool MarkerIsZeroSized()
{
    return comptime System.Compiler.TypeIsZeroSized<Marker>();
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        stack ascii packetBody = LlvmDefinitionBody(llvm, "PacketIsZeroSized");
        stack ascii markerBody = LlvmDefinitionBody(llvm, "MarkerIsZeroSized");
        return Contains(runBody, "ret i64 20")
            && DoesNotContain(runBody, "call")
            && Contains(packetBody, "ret i1 false")
            && DoesNotContain(packetBody, "call")
            && Contains(markerBody, "ret i1 true")
            && DoesNotContain(markerBody, "call");
    }
}

