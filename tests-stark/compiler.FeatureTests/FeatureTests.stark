module Demo

trait Drawable
{
}

struct Widget : Drawable
{
    i32[min max] W;
}

finite law bool Run()
{
    return comptime System.Compiler.ImplementedTraitTypeIs<Widget, Widget, 0>();
}
""");
        return FailsWithDiagnosticMessage(traitArgumentResult, "STK3054", "requires a trait type as its second argument");
    }
}

