}

[Fact]
fn bool ImportedSourceFunctionLawPredicatesAreEnforcedAtCallSites()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "law-predicates-imported",
            raw"""
import Worker
module Demo

struct RawHolder
{
    rawptr<i32[min max]> Pointer;
}

fn void Run()
{
    stack RawHolder raw = new()
    {
        Pointer = null
    };
    Worker.RequireTransfer(raw);
}
""",
            "",
            "Worker.stark",
            raw"""
module Worker

public fn void RequireTransfer<T>(T value) where Transferable(T)
{
}
""");
        return FailsWithDiagnostic(compiled, "STK3049")
            && AnyDiagnosticMessageContains(compiled, "Worker.RequireTransfer")
            && AnyDiagnosticMessageContains(compiled, "Transferable(RawHolder)")
            && AnyDiagnosticMessageContains(compiled, "Responsible field chain: RawHolder.Pointer");
    }
}

[Fact]
[Collection("diagnostics")]
fn bool ThreadEntryReachabilityRejectsPlainMutableStatics()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "thread-reachability-rejects",
            raw"""
import System.Threading
module Demo

static mut i32[min max] Counter = 0;

fn i32[min max] Bump()
{
    Counter += 1;
    return Counter;
}

fn i32[min max] Worker()
{
    return Bump();
}

fn void Run()
{
    stack System.Threading.ThreadEntry entry = Worker;
    return;
}
""",
            "System",
            "Threading.stark",
            raw"""
module System.Threading

public alias ThreadEntry = fnptr<fn i32[min max]()>;
""");
        return FailsWithDiagnostic(compiled, "STK3049")
            && AnyDiagnosticMessageContains(compiled, "Thread-reachable function 'Bump'")
            && AnyDiagnosticMessageContains(compiled, "mutable global 'Counter'")
            && AnyDiagnosticMessageContains(compiled, "System.Threading.Atomic*")
            && AnyDiagnosticMessageContains(compiled, "System.Threading.Synchronized<T>");
    }
}

[Fact]
fn bool ThreadEntryReachabilityAllowsAtomicMutableStatics()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheckWithModule(
            "thread-reachability-allows",
            raw"""
import System.Threading
module Demo

static mut System.Threading.AtomicI64 Counter = new System.Threading.AtomicI64()
{
    Value = 0
};

fn void Touch(borrow System.Threading.AtomicI64 value)
{
    return;
}

fn i32[min max] Worker()
{
    Touch(Counter);
    return 0;
}

fn void Run()
{
    stack System.Threading.ThreadEntry entry = Worker;
    return;
}
""",
            "System",
            "Threading.stark",
            raw"""
module System.Threading

public alias ThreadEntry = fnptr<fn i32[min max]()>;

public struct AtomicI64
{
    i64[min max] Value;
}
""");
        return Succeeds(compiled);
    }
}

// ---------------------------------------------------------------------------
// GenericsFeatureTests
//
// Facts that inspected TypeCheckModel triggers/NamedTypes are re-expressed
// either through monomorphized LLVM symbols (when the pipeline can run) or as
// type-check success of the same source (when only the model was probed).
// ---------------------------------------------------------------------------

[Fact]
[Collection("traits")]
fn bool ComptimeGenericValueParameterCanBindFixedArrayLength()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "comptime-binds-length",
            raw"""
module Demo

finite law u8[0 max] Probe<T, comptime u8[1 4] N>(borrow T[N] values)
{
    return 1;
}

finite law u8[0 max] Run()
{
    stack i32[min max][3] values = { 10, 20, 30 };
    return Probe(values);
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "__stark_mono_fn_Demo__Probe__i32__N_3");
    }
}

[Fact]
[Collection("traits", "diagnostics")]
fn bool ComptimeGenericValueParameterRejectsOutOfRangeLength()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "comptime-rejects-length",
            raw"""
module Demo

finite law u8[0 max] Probe<T, comptime u8[1 2] N>(borrow T[N] values)
{
    return 1;
}

finite law u8[0 max] Run()
{
    stack i32[min max][3] values = { 10, 20, 30 };
    return Probe(values);
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3021", "No overload of 'Probe' matches");
    }
}

[Fact]
[Collection("traits")]
fn bool ExplicitComptimeGenericFunctionArgumentMaterializesAsConstant()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "comptime-explicit-constant",
            raw"""
module Demo

finite law u8[0 max] Length<T, comptime u8[1 4] N>(borrow T[N] values)
{
    return N;
}

finite law u8[0 max] Run()
{
    stack i32[min max][3] values = { 10, 20, 30 };
    return Length<i32[min max], 3>(values);
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii specializationBody = LlvmDefinitionBody(llvm, "__stark_mono_fn_Demo__Length__i32__N_3");
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        return Contains(specializationBody, "ret i8 3")
            && Contains(runBody, "call fastcc i8 @__stark_mono_fn_Demo__Length__i32__N_3(");
    }
}

