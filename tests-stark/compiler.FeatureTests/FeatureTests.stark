            raw"""
module Demo

[StructLayout(C), Pack(1)]
struct Packet
{
    u8[0 max] Tag;
    u32[0 max] Length;
}

finite law u64[0 max] FieldOffsetAt<T, comptime u64[0 max] I>()
{
