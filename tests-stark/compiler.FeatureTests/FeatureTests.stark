[Fact]
fn bool MethodLawPredicatesAreEnforcedAtCallSites()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileTypeCheck(
            "law-predicates-methods",
            raw"""
module Demo

struct LocalOnly
{
    [Deny(Shareable)]
    i32[min max] Value;
}

struct Gate
{
    fn void Broadcast(LocalOnly value) where Shareable(LocalOnly)
    {
    }
}

fn void Run()
{
    stack Gate gate = new();
    stack LocalOnly local = new()
    {
        Value = 1
    };
    gate.Broadcast(local);
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3049", "requires where Shareable(LocalOnly)")
            && AnyDiagnosticMessageContains(compiled, "Responsible field chain: LocalOnly.Value")
            && AnyDiagnosticMessageContains(compiled, "explicitly denies Shareable");
