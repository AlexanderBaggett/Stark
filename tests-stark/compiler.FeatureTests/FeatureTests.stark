[Fact]
[Collection("traits")]
fn bool LargeByValueGenericSpecializationsPreserveObservableMemoryFacts()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "generic-large-byval",
            raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

inline finite law i64[min max] Read<T>(T value)
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    return acc;
}

finite law i64[min max] Run(Big value)
{
    return Read(value);
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii runHeader = LlvmDefinitionHeader(llvm, "Run");
        stack ascii specializationHeader = LlvmDefinitionHeader(llvm, "__stark_mono_fn_Demo__Read__Big");
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        return Contains(runHeader, "memory(argmem: read)")
            && DoesNotContain(runHeader, "memory(readwrite")
            && Contains(specializationHeader, "memory(argmem: read)")
            && DoesNotContain(specializationHeader, "memory(readwrite")
            && Contains(runBody, "call fastcc i64 @__stark_mono_fn_Demo__Read__Big(ptr nonnull byval(%Big) noalias readonly captures(none) dereferenceable(32) align 8 %arg_value)")
            && DoesNotContain(runBody, "%abi_callarg_value");
    }
}

// ---------------------------------------------------------------------------
// TraitsAndDoctrinesFeatureTests
//
// Facts that inspected TypeCheckModel/MIR object graphs are re-expressed over
// the rendered MIR text artifact; case-insensitive absence checks are
// approximated with the realistic casings.
