[Fact]
fn bool ExplicitOpsTableDispatchStaysVisibleAndIndirect()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "traits-ops-table",
            raw"""
module Demo

struct ModuleResolverOps
{
    fnptr<unsafe finite law i32[min max](rawptr<i8[min max]>, ascii)> Resolve;
    fnptr<unsafe finite law void(rawptr<i8[min max]>)> Reset;
}

struct ModuleResolverHandle
{
    rawptr<i8[min max]> Context;
    ModuleResolverOps Ops;
}

unsafe finite law i32[min max] ResolveFile(rawptr<i8[min max]> context, ascii moduleName)
{
    return 40;
}

unsafe finite law i32[min max] ResolveMemory(rawptr<i8[min max]> context, ascii moduleName)
{
    return 2;
}

unsafe finite law void ResetMemory(rawptr<i8[min max]> context)
{
    return;
}

finite law i32[min max] Dispatch(borrow ModuleResolverHandle resolver, ascii moduleName)
{
    unsafe
    {
        resolver.Ops.Reset(resolver.Context);
        return resolver.Ops.Resolve(resolver.Context, moduleName);
    }
}

finite law i32[min max] Run()
{
    stack ModuleResolverOps ops = new ModuleResolverOps()
    {
        Resolve = ResolveMemory,
        Reset = ResetMemory
    };
    stack ModuleResolverHandle resolver = new ModuleResolverHandle()
    {
        Context = null,
        Ops = ops
    };
    return Dispatch(resolver, "core");
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii dispatchHeader = LlvmDefinitionHeader(llvm, "Dispatch");
        stack ascii dispatchBody = LlvmDefinitionBody(llvm, "Dispatch");
        return Contains(dispatchHeader, "nounwind willreturn mustprogress nosync nofree memory(read)")
            && DoesNotContain(dispatchHeader, "memory(readwrite")
            && Contains(dispatchBody, "call fastcc i32 %")
            && Contains(dispatchBody, "call fastcc void %")
            && Contains(dispatchBody, "nounwind willreturn mustprogress nosync nofree memory(read)")
            && Contains(dispatchBody, "load ptr")
            && DoesNotContain(dispatchBody, "call fastcc i32 @ResolveFile")
            && DoesNotContain(dispatchBody, "call fastcc i32 @ResolveMemory")
            && DoesNotContain(dispatchBody, "call fastcc void @ResetMemory")
            && Contains(llvm, "@ResolveMemory")
            && DoesNotContain(llvm, "__stark_vtable");
    }
}

[Fact]
[Collection("ownership", "traits")]
fn bool DoctrineLawCallsStayDirectAndPreserveBorrowFacts()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "traits-doctrine-direct",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

doctrine Inspect
{
    law i32[min max] Read(borrow Box box)
    {
        stack i32[min max] a = box.Value + (box.Value / 3);
        stack i32[min max] b = a - (a / 5);
        stack i32[min max] c = b + (b / 7);
        stack i32[min max] d = c - (c / 11);
        stack i32[min max] e = d + (d / 13);
        stack i32[min max] f = e - (e / 17);
        stack i32[min max] g = f + (f / 19);
        stack i32[min max] h = g - (g / 23);
        stack i32[min max] i = h + (h / 29);
        stack i32[min max] j = i - (i / 31);
        stack i32[min max] k = j + (j / 37);
        stack i32[min max] l = k - (k / 41);
        stack i32[min max] m = l + (l / 43);
        return m;
    }
}

law i32[min max] Run(borrow Box box)
{
    return Inspect.Read(box);
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii inspectHeader = LlvmDefinitionHeader(llvm, "Inspect_Read");
        stack ascii runHeader = LlvmDefinitionHeader(llvm, "Run");
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        return Contains(inspectHeader, "ptr noundef nonnull noalias readonly captures(none) dereferenceable(4) align 4 %arg_box")
            && Contains(inspectHeader, "nounwind willreturn mustprogress nosync nofree memory(argmem: read)")
            && Contains(inspectHeader, "alwaysinline")
            && DoesNotContain(inspectHeader, "memory(readwrite")
            && Contains(runHeader, "ptr noundef nonnull noalias readonly captures(none) dereferenceable(4) align 4 %arg_box")
            && Contains(runHeader, "nounwind willreturn mustprogress nosync nofree memory(argmem: read)")
            && Contains(runHeader, "alwaysinline")
            && DoesNotContain(runHeader, "memory(readwrite")
            && Contains(runBody, "call fastcc i32 @Inspect_Read(ptr nonnull noalias readonly captures(none) dereferenceable(4) align 4")
            && DoesNotContain(llvm, "vtable")
            && DoesNotContain(llvm, "Vtable")
            && DoesNotContain(llvm, "fnptr")
            && DoesNotContain(llvm, "dispatch")
            && DoesNotContain(llvm, "Dispatch");
    }
}

