[Fact]
fn bool ComptimeBlockCanUseWillexitWhileBreakContinueAndCompoundAssignment()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "comptime-d-block-while-break-continue",
            raw"""
module Demo

finite law i32[min max] Run()
{
    return comptime
    {
        stack mut i32[min max] value = 0;
        stack mut i32[min max] index = 0;
        while willexit (index < 8)
        {
            index += 1;
            if (index == 3)
            {
                continue;
            }

            value += index;
            if (value > 10)
            {
                break;
            }
        }

        return value;
    };
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        return Contains(runBody, "ret i32 12")
            && DoesNotContain(runBody, " br ");
    }
}

[Fact]
fn bool ComptimeBlockCanExecuteLabeledBreakAndContinue()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "comptime-d-block-labeled-break",
            raw"""
module Demo

finite law i32[min max] Run()
{
    return comptime
    {
        stack mut i32[min max] total = 0;
        stack mut i32[min max] outer = 0;
        outerLoop: while willexit (outer < 4)
        {
            outer += 1;
            stack mut i32[min max] inner = 0;
            while willexit (inner < 4)
            {
                inner += 1;
                if (inner == 1)
                {
                    continue;
                }

                gate: switch (inner)
                {
                    default:
                        if (inner == 2)
                        {
                            break gate;
                        }

                        total += 0;
                }

                if (outer == 2)
                {
                    if (inner == 2)
                    {
                        continue outerLoop;
                    }
                }

                if (outer == 4)
                {
                    break outerLoop;
                }

                total += outer * 10 + inner;
            }
        }

        return total;
    };
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        return Contains(runBody, "ret i32 138")
            && DoesNotContain(runBody, " br ")
            && DoesNotContain(runBody, "call fastcc");
    }
}

