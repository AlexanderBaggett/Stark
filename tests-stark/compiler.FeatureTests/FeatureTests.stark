            "law-predicates-field-chain",
            raw"""
module Demo

struct RawHolder
{
    rawptr<i32[min max]> Pointer;
}

fn void RequireTransfer<T>(T value) where Transferable(T)
{
}

fn void Run()
{
    stack RawHolder raw = new()
    {
        Pointer = null
    };
    RequireTransfer(raw);
}
""");
        return FailsWithDiagnosticMessage(compiled, "STK3049", "requires where Transferable(RawHolder)")
            && AnyDiagnosticMessageContains(compiled, "Responsible field chain: RawHolder.Pointer")
            && AnyDiagnosticMessageContains(compiled, "raw pointer");
