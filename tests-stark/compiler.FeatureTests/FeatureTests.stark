import FeatureTestSupport
import System.Testing
[Collection("features")]
module CompilerFeatureTests

// Ported slice of tests/compiler.FeatureTests, running against the current C#
// host compiler through the host test protocol. Requires STARK_HOST_COMPILER
// to point at the host compiler executable. The original C# tests remain in
// tests/compiler.FeatureTests as the oracle until cutover.

// ---------------------------------------------------------------------------
// BorrowingFeatureTests
// ---------------------------------------------------------------------------

[Fact]
[Collection("ownership", "ffi")]
fn bool BorrowParametersPreserveReadonlyPointerAbiThroughTheWholePipeline()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "borrow-readonly-abi",
            raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

fn i32[min max] Read(borrow Box box)
{
    return box.Value;
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        return Contains(
            Llvm(compiled),
            "define fastcc noundef i32 @Read(ptr noundef nonnull noalias readonly captures(none) dereferenceable(4) align 4 %arg_box)");
    }
}

// ---------------------------------------------------------------------------
// FloatingPointFeatureTests
// ---------------------------------------------------------------------------

[Fact]
[Collection("types")]
fn bool ConstantFloatExpressionsFoldThroughTheWholePipeline()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "float-constant-fold",
            raw"""
module Demo

fn f32 Run()
{
    return 2.0 ** 3.0;
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        // 2.0 ** 3.0 folds to 8.0; f32 8.0 emits as a bit-exact hex float.
        return Contains(llvm, "define fastcc noundef float @Run()")
            && Contains(llvm, "ret float 0x4020000000000000")
            && DoesNotContain(llvm, "@llvm.pow.f32");
    }
}

// ---------------------------------------------------------------------------
// FunctionClassesFeatureTests
// ---------------------------------------------------------------------------

[Fact]
[Collection("lowering")]
fn bool FunctionClassesFlowThroughTheWholePipelineAndPreserveTheirLlvmShapes()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "function-classes-shapes",
            raw"""
module Demo

fn i32[min max] Plain(i32[min max] left, i32[min max] right)
{
    return left + right;
}

law i32[min max] Pure()
{
    return Plain(1, 2);
}

finite i32[min max] Bounded()
{
    return 4;
}

finite law i32[min max] Run()
{
    return Pure() + Bounded();
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(
                llvm,
                "define fastcc noundef i32 @Plain(i32 noundef %arg_left, i32 noundef %arg_right) nounwind willreturn mustprogress nosync nofree memory(none) alwaysinline")
            && Contains(llvm, "define fastcc noundef i32 @Pure()")
            && Contains(llvm, "define fastcc noundef i32 @Bounded()")
            && Contains(llvm, "define fastcc noundef i32 @Run()");
    }
}

