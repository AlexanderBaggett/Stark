}

[Fact]
[Collection("patterns")]
fn bool ComptimeBlockCanExecutePatternWhileConditions()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "comptime-a-pattern-while-conditions",
            raw"""
module Demo

enum Step
{
    More(i32[min max]),
    Done
}

finite law Step Next(i32[min max] value)
{
    if (value < 4)
    {
        return Step.More(value + 1);
    }

    return Step.Done;
}

finite law i32[min max] Run()
{
    return comptime
    {
        stack mut i32[min max] value = 0;
        stack mut i32[min max] sum = 0;
        while willexit (Next(value) is Step.More(var next))
        {
            value = next;
            if (value == 3)
            {
                continue;
            }

            sum += value;
            if (sum > 4)
            {
                break;
            }
        }

        return sum;
    };
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        return Contains(runBody, "ret i32 7")
            && DoesNotContain(runBody, " br ");
    }
}

