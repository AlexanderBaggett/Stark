// ---------------------------------------------------------------------------
// ComptimeFeatureTests (part A: facts 1-36)
// ---------------------------------------------------------------------------

[Fact]
[Collection("lowering")]
fn bool ComptimeExpressionEvaluatesFiniteLawCallAndLowersToImmediate()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "comptime-a-finite-law-call-immediate",
            raw"""
module Demo

finite law i32[min max] Build(i32[min max] seed)
{
    stack mut i32[min max] value = seed;
    value = value + 1;
    if (value == 21)
    {
        return value * 2;
    }

    return 0;
}

finite law i32[min max] Run()
{
    return comptime Build(20);
}
""");
        if (!compiled.Ok)
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        return Contains(runBody, "ret i32 42")
            && DoesNotContain(runBody, "call fastcc i32 @Build");
    }
}

