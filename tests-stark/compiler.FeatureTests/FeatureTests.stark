module System.Threading

struct AtomicI64
{
    rawptr<i32[min max]> Backing;
}

struct Holder
{
    AtomicI64 Value;
}

fn void RequireBoth<T>(T value) where Transferable(T), Shareable(T)
{
}

fn void Run()
{
    stack AtomicI64 atomic = new()
    {
        Backing = null
    };
    RequireBoth(atomic);
    stack Holder holder = new()
    {
        Value = new AtomicI64()
        {
            Backing = null
        }
    };
    RequireBoth(holder);
}
""");
        return Succeeds(compiled);
    }
}

