            raw"""
module Demo

finite law i32[min max] Run()
{
    return comptime
    {
        stack mut i32[min max] value = 0;
        while willexit (true)
        {
            value += 1;
        }

        return value;
    };
}
""",
            8);
        return FailsWithDiagnosticMessage(compiled, "STK3053", "stopped after 8 iteration(s) of a `while willexit` loop");
    }
}

