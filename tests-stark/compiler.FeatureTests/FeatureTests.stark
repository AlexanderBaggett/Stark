            && Contains(runHeader, "alwaysinline")
            && DoesNotContain(runHeader, "memory(readwrite")
            && Contains(runBody, "call fastcc i32 @__stark_mono_fn_Demo__Inspect_Read__i32(ptr nonnull noalias readonly captures(none) dereferenceable(4) align 4")
            && DoesNotContain(llvm, "declare fastcc noundef ptr @Inspect_Read(")
            && DoesNotContain(llvm, "define fastcc noundef ptr @Inspect_Read(")
            && DoesNotContain(llvm, "define fastcc noundef i32 @Inspect_Read(")
            && DoesNotContain(llvm, "vtable")
            && DoesNotContain(llvm, "Vtable")
