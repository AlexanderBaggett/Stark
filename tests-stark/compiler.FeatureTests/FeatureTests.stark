}
""");

        stack mut LlvmCompile returnArgumentIndexResult = CompileTypeCheck(
            "comptime-c-nested-arg-reject-return",
            raw"""
module Demo

alias Callback = fnptr<fn i32[min max]()>;

finite law bool Run()
{
    return comptime System.Compiler.FunctionPointerReturnTypeArgumentTypeIsInteger<Callback, 0>();
}
""");

        stack mut LlvmCompile closureParameterArgumentIndexResult = CompileTypeCheck(
            "comptime-c-nested-arg-reject-closure",
            raw"""
