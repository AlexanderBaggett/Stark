import Compiler.Ir
import Compiler.Mir
import System.Memory
import System.Text
module ImportedTemplateLocalConstantTests

public fn bool ImportedTemplateLocalConstantsFoldDirectlyWithExactLlvmFacts()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "GenericTemplates": {
                  "Functions": [
                    {
                      "QualifiedResolvedName": "Demo.LocalConstants#0",
                      "QualifiedName": "Demo.LocalConstants",
                      "OverloadKey": "()",
                      "TopLevelStatementCount": 4,
                      "LocalDeclarations": [
                        {
                          "Kind": "const",
                          "Line": 1,
                          "Column": 1,
                          "Type": {
                            "Kind": "integer",
                            "BitWidth": 16,
                            "RangeMin": "0",
                            "RangeMax": "1000"
                          }
                        },
                        {
                          "Kind": "const",
                          "Line": 2,
                          "Column": 1,
                          "Type": {
                            "Kind": "integer",
                            "BitWidth": 16,
                            "RangeMin": "0",
                            "RangeMax": "1000"
                          }
                        },
                        {
                          "Kind": "const",
                          "Line": 3,
                          "Column": 1,
                          "Type": {
                            "Kind": "integer",
                            "BitWidth": 16,
                            "RangeMin": "0",
                            "RangeMax": "1000"
                          }
                        }
                      ],
                      "TypedBody": {
                        "Statements": [
                          {
                            "Kind": "local-variable",
                            "Name": "base",
                            "StorageClass": "local",
                            "IsMutable": false,
                            "IsConstant": true,
                            "ConstProvenance": "immutable-binding",
                            "Type": {
                              "Kind": "integer",
                              "BitWidth": 16,
                              "RangeMin": "0",
                              "RangeMax": "1000"
                            },
                            "Expression": {
                              "Kind": "literal",
                              "LiteralText": "40",
                              "Type": {
                                "Kind": "integer",
                                "BitWidth": 16,
                                "RangeMin": "0",
                                "RangeMax": "1000"
                              }
                            }
                          },
                          {
                            "Kind": "local-variable",
                            "Name": "doubled",
                            "StorageClass": "local",
                            "IsMutable": false,
                            "IsConstant": true,
                            "ConstProvenance": "immutable-binding",
                            "Type": {
                              "Kind": "integer",
                              "BitWidth": 16,
                              "RangeMin": "0",
                              "RangeMax": "1000"
                            },
                            "Expression": {
                              "Kind": "binary",
                              "Name": "*",
                              "Type": {
                                "Kind": "integer",
                                "BitWidth": 16,
                                "RangeMin": "0",
                                "RangeMax": "1000"
                              },
                              "Arguments": [
                                { "Kind": "name", "Name": "base" },
                                {
                                  "Kind": "literal",
                                  "LiteralText": "2",
                                  "Type": {
                                    "Kind": "integer",
                                    "BitWidth": 16,
                                    "RangeMin": "0",
                                    "RangeMax": "1000"
                                  }
                                }
                              ]
                            }
                          },
                          {
                            "Kind": "local-variable",
                            "Name": "answer",
                            "StorageClass": "local",
                            "IsMutable": false,
                            "IsConstant": true,
                            "ConstProvenance": "immutable-binding",
                            "Type": {
                              "Kind": "integer",
                              "BitWidth": 16,
                              "RangeMin": "0",
                              "RangeMax": "1000"
                            },
                            "Expression": {
                              "Kind": "binary",
                              "Name": "+",
                              "Type": {
                                "Kind": "integer",
                                "BitWidth": 16,
                                "RangeMin": "0",
                                "RangeMax": "1000"
                              },
                              "Arguments": [
                                { "Kind": "name", "Name": "doubled" },
                                {
                                  "Kind": "literal",
                                  "LiteralText": "2",
                                  "Type": {
                                    "Kind": "integer",
                                    "BitWidth": 16,
                                    "RangeMin": "0",
                                    "RangeMax": "1000"
                                  }
                                }
                              ]
                            }
                          },
                          {
                            "Kind": "return",
                            "Expression": { "Kind": "name", "Name": "answer" }
                          }
                        ]
                      }
                    },
                    {
                      "QualifiedResolvedName": "Demo.UnresolvedLocal#0",
                      "QualifiedName": "Demo.UnresolvedLocal",
                      "OverloadKey": "()",
                      "TopLevelStatementCount": 1,
                      "TypedBody": {
                        "Statements": [
                          {
                            "Kind": "return",
                            "Expression": { "Kind": "name", "Name": "missing" }
                          }
                        ]
                      }
                    },
                    {
                      "QualifiedResolvedName": "Demo.DuplicateLocal#0",
                      "QualifiedName": "Demo.DuplicateLocal",
                      "OverloadKey": "()",
                      "TopLevelStatementCount": 3,
                      "LocalDeclarations": [
                        {
                          "Kind": "const",
                          "Line": 1,
                          "Column": 1,
                          "Type": { "Kind": "integer", "BitWidth": 16 }
                        },
                        {
                          "Kind": "const",
                          "Line": 2,
                          "Column": 1,
                          "Type": { "Kind": "integer", "BitWidth": 16 }
                        }
                      ],
                      "TypedBody": {
                        "Statements": [
                          {
                            "Kind": "local-variable",
                            "Name": "same",
                            "StorageClass": "local",
                            "IsConstant": true,
                            "ConstProvenance": "immutable-binding",
                            "Type": { "Kind": "integer", "BitWidth": 16 },
                            "Expression": {
                              "Kind": "literal",
                              "LiteralText": "1",
                              "Type": { "Kind": "integer", "BitWidth": 16 }
                            }
                          },
                          {
                            "Kind": "local-variable",
                            "Name": "same",
                            "StorageClass": "local",
                            "IsConstant": true,
                            "ConstProvenance": "immutable-binding",
                            "Type": { "Kind": "integer", "BitWidth": 16 },
                            "Expression": {
                              "Kind": "literal",
                              "LiteralText": "2",
                              "Type": { "Kind": "integer", "BitWidth": 16 }
                            }
                          },
                          {
                            "Kind": "return",
                            "Expression": { "Kind": "name", "Name": "same" }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageGenericTemplateFactGraph graph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageGenericTemplateFactJsonGraph(
                manifestJson,
                0,
                graph))
        {
            return false;
        }
    }

    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> functions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts expectedReturnFacts = new();
    expectedReturnFacts.SetIntegerRange(0, 1001);
    stack mut MirFuncId function = MirFuncIdOf(0);
    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            1,
            MirType.I16,
            false,
            expectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            function) != ImportedTemplateMirLoweringStatus.Ok)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] instructionCount = instructions.Count();
    stack u64[0 2 ** 63 - 1] blockCount = blocks.Count();
    stack u64[0 2 ** 63 - 1] functionCount = functions.Count();
    stack mut u32[0 max] invalidTemplateRow = 2;
    while willexit (invalidTemplateRow <= 3)
    {
        stack mut MirFuncId invalidFunction = MirFuncIdOf(0);
        if (LowerImportedTemplateScalarReturnToMir(
                graph,
                invalidTemplateRow,
                MirType.I16,
                false,
                expectedReturnFacts,
                instructions,
                blocks,
                functions,
                valueFacts,
                functionReturnFacts,
                invalidFunction) != ImportedTemplateMirLoweringStatus.UnsupportedBody
            || invalidFunction.IsValid()
            || instructions.Count() != instructionCount
            || blocks.Count() != blockCount
            || functions.Count() != functionCount
            || valueFacts.Count() != instructionCount
            || functionReturnFacts.Count() != functionCount)
        {
            return false;
        }

        invalidTemplateRow = invalidTemplateRow + 1;
    }

    stack MirInstruction literal = instructions.Get(1);
    stack ValueFacts literalFacts = ValueFactsForMirValue(valueFacts, MirValueIdOf(1));
    stack ValueFacts returnFacts = ValueFactsAtIndex(
        functionReturnFacts,
        function.Index());
    stack MirFunction lowered = functions.Get(function.Index());
    stack mut IrTable<ValueFacts> noParameterFacts = new();
    stack mut IrTable<ValueFacts> noGlobalFacts = new();
    stack mut OwnedAscii llvm = new();
    if (EmitLlvmDefinitionWithRangeFacts(
            instructions,
            blocks,
            "imported_local_constants",
            returnFacts,
            noParameterFacts,
            valueFacts,
            noGlobalFacts,
            functionReturnFacts,
            0,
            lowered.EntryIndex(),
            lowered.FirstInstrIndex(),
            lowered.OwnedInstrCount(),
            llvm) != MemoryStatus.Ok)
    {
        return false;
    }

    return function.Index() == 1
        && instructionCount == 1
        && blockCount == 1
        && functionCount == 1
        && literal.Opcode() == MirOp.ConstInt
        && literal.ResultType() == MirType.I16
        && literal.Immediate() == 82
        && literalFacts.HasIntegerRange()
        && literalFacts.IntegerRangeLower() == 82
        && literalFacts.IntegerRangeUpperExclusive() == 83
        && returnFacts.HasIntegerRange()
        && returnFacts.IntegerRangeLower() == 82
        && returnFacts.IntegerRangeUpperExclusive() == 83
        && System.Text.OwnedAsciiEqualsAscii(
            llvm,
            "define range(i16 82, 83) i16 @imported_local_constants() {\nb1:\n  %v1 = add i16 0, 82\n  ret i16 %v1\n}\n");
}

