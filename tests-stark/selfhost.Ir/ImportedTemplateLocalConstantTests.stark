                      "QualifiedName": "Demo.MismatchedAssignmentTarget",
                      "OverloadKey": "()",
                      "TopLevelStatementCount": 4,
                      "LocalDeclarations": [
                        {
                          "Kind": "var",
                          "Line": 1,
                          "Column": 1,
                          "Type": { "Kind": "integer", "BitWidth": 8 }
                        },
                        {
                          "Kind": "var",
                          "Line": 2,
                          "Column": 1,
                          "Type": { "Kind": "integer", "BitWidth": 8 }
                        }
                      ],
                      "TypedBody": {
                        "Statements": [
                          {
                            "Kind": "local-variable",
                            "Name": "left",
                            "StorageClass": "register",
                            "IsMutable": true,
                            "Type": { "Kind": "integer", "BitWidth": 8 },
                            "Expression": {
                              "Kind": "literal",
                              "LiteralText": "1",
                              "Type": { "Kind": "integer", "BitWidth": 8 }
                            }
                          },
                          {
                            "Kind": "local-variable",
                            "Name": "right",
                            "StorageClass": "register",
                            "IsMutable": true,
                            "Type": { "Kind": "integer", "BitWidth": 8 },
                            "Expression": {
                              "Kind": "literal",
                              "LiteralText": "2",
                              "Type": { "Kind": "integer", "BitWidth": 8 }
                            }
                          },
                          {
                            "Kind": "assignment",
                            "Name": "left",
                            "AssignmentOperator": "=",
                            "TargetExpression": { "Kind": "name", "Name": "right" },
