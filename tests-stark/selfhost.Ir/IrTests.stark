[Fact]
fn bool StackAllocGeneratesPointerFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 32, 16);
    stack mut IrTable<ValueFacts> valueFacts = new();
    if (!RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, alloc))
    {
        return false;
    }

    stack ValueFacts facts = ValueFactsForMirValue(valueFacts, alloc);
    return MirOpcodeOf(instrs, alloc) == MirOp.StackAlloc
        && MirValueType(instrs, alloc.Index()) == MirType.Ptr
        && facts.KnownNonNull()
        && facts.HasNoAlias()
        && facts.HasAlignment()
        && facts.AlignmentBytes() == 16;
}

[Fact]
fn bool HeapAllocGeneratesPointerFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirHeapAlloc(instrs, 32, 16);
    stack mut IrTable<ValueFacts> valueFacts = new();
    if (!RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, alloc))
    {
        return false;
    }

    stack ValueFacts facts = ValueFactsForMirValue(valueFacts, alloc);
    return MirOpcodeOf(instrs, alloc) == MirOp.HeapAlloc
        && MirValueType(instrs, alloc.Index()) == MirType.Ptr
        && facts.KnownNonNull()
        && facts.HasNoAlias()
        && facts.HasAlignment()
        && facts.AlignmentBytes() == 16;
}

[Fact]
fn bool EmitsLlvmStackAlloc()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 24, 8);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmInstruction(instrs, sink, alloc.Index()))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "  %v1 = alloca [24 x i8], align 8\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmHeapAlloc()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirHeapAlloc(instrs, 24, 8);
    stack MirValueId zero = MirConstInt(instrs, 0);
    stack MirValueId ret = MirReturn(instrs, zero);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunction(instrs, "heapalloc", 1, 3, sink))
    {
        case MemoryStatus.Ok:
            return MirOpcodeOf(instrs, alloc) == MirOp.HeapAlloc
                && MirOpcodeOf(instrs, ret) == MirOp.Return
                && System.Text.Contains(sink.View(), "declare noalias nonnull noundef ptr @__stark_heap_alloc(i64 noundef %size, i64 noundef allocalign %alignment) allocsize(0) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_heap_alloc\" nounwind")
                && System.Text.Contains(sink.View(), "%v1 = call noalias nonnull noundef align 8 dereferenceable(24) ptr @__stark_heap_alloc(i64 noundef 24, i64 noundef 8)")
                && ClangVerifiesLlvmText(sink);
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool PtrOffsetGeneratesPointerFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 32, 16);
    stack MirValueId field = MirPtrOffset(instrs, alloc, 8, 8);
    stack mut IrTable<ValueFacts> valueFacts = new();
    if (!RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, alloc)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, field))
    {
        return false;
    }

    stack ValueFacts facts = ValueFactsForMirValue(valueFacts, field);
    return MirOpcodeOf(instrs, field) == MirOp.PtrOffset
        && MirOperandAOf(instrs, field).Equals(alloc)
        && MirImmediateOf(instrs, field) == 8
        && MirOperandBImmediateOf(instrs, field) == 8
        && MirValueType(instrs, field.Index()) == MirType.Ptr
        && facts.KnownNonNull()
        && facts.HasNoAlias()
        && facts.HasAlignment()
        && facts.AlignmentBytes() == 8;
}

[Fact]
fn bool PtrIndexOffsetGeneratesPointerFactsAndCarriesLayout()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 64, 16);
    stack MirValueId index = MirConstIntTyped(instrs, MirType.I64, 2);
    stack MirValueId element = MirPtrIndexOffset(instrs, alloc, index, 4, 8, 4);
    stack mut IrTable<ValueFacts> valueFacts = new();
    if (!RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, alloc)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, index)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, element))
    {
        return false;
    }

    stack ValueFacts facts = ValueFactsForMirValue(valueFacts, element);
    return MirOpcodeOf(instrs, element) == MirOp.PtrIndexOffset
        && MirOperandAOf(instrs, element).Equals(alloc)
        && MirOperandBOf(instrs, element).Equals(index)
        && MirOperandCImmediateOf(instrs, element) == 4
        && MirOperandDImmediateOf(instrs, element) == 4
        && MirImmediateOf(instrs, element) == 8
        && MirValueType(instrs, element.Index()) == MirType.Ptr
        && facts.KnownNonNull()
        && facts.HasNoAlias()
        && facts.HasAlignment()
        && facts.AlignmentBytes() == 4;
}

[Fact]
fn bool ResolvedStoragePlaceAddressHelperBuildsDirectAndIndexedAddresses()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 64, 16);
    stack MirValueId index = MirConstIntTyped(instrs, MirType.I64, 3);
    stack MirValueId direct = LowerResolvedStoragePlaceAddress(instrs, alloc, MirValueIdOf(0), 0, 8, 0, 8, true);
    stack MirValueId indexed = LowerResolvedStoragePlaceAddress(instrs, alloc, index, 2, 12, 4, 4, true);
    stack MirValueId unbounded = LowerResolvedStoragePlaceAddress(instrs, alloc, index, 2, 20, 2, 2, false);

    return MirOpcodeOf(instrs, direct) == MirOp.PtrOffset
        && MirOperandAOf(instrs, direct).Equals(alloc)
        && MirImmediateOf(instrs, direct) == 8
        && MirOperandBImmediateOf(instrs, direct) == 8
        && MirOpcodeOf(instrs, indexed) == MirOp.PtrIndexOffset
        && MirOperandAOf(instrs, indexed).Equals(alloc)
        && MirOperandBOf(instrs, indexed).Equals(index)
        && MirOperandCImmediateOf(instrs, indexed) == 4
        && MirOperandDImmediateOf(instrs, indexed) == 4
        && MirImmediateOf(instrs, indexed) == 12
        && MirOpcodeOf(instrs, unbounded) == MirOp.PtrIndexOffsetUnbounded
        && MirOperandAOf(instrs, unbounded).Equals(alloc)
        && MirOperandBOf(instrs, unbounded).Equals(index)
        && MirOperandCImmediateOf(instrs, unbounded) == 2
        && MirOperandDImmediateOf(instrs, unbounded) == 2
        && MirImmediateOf(instrs, unbounded) == 20;
}

[Fact]
fn bool PointerLoadStoreRecordOperandsAndTypes()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 16, 8);
    stack MirValueId field = MirPtrOffset(instrs, alloc, 4, 4);
    stack MirValueId value = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId store = MirStorePtrAlignedTyped(instrs, MirType.I32, field, value, 4);
    stack MirValueId load = MirLoadPtrAlignedTyped(instrs, MirType.I32, field, 4);
    return MirOpcodeOf(instrs, store) == MirOp.StorePtr
        && MirOperandAOf(instrs, store).Equals(field)
        && MirOperandBOf(instrs, store).Equals(value)
        && MirOperandCImmediateOf(instrs, store) == 4
        && MirValueType(instrs, store.Index()) == MirType.I32
        && MirOpcodeOf(instrs, load) == MirOp.LoadPtr
        && MirOperandAOf(instrs, load).Equals(field)
        && MirOperandBImmediateOf(instrs, load) == 4
        && MirValueType(instrs, load.Index()) == MirType.I32;
}

[Fact]
fn bool EnumConstructionInstructionsCarryPayloadLayoutFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(7), 2);
    stack MirValueId payload = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId inserted = MirEnumPayloadInsert(instrs, TypeIdOf(7), 2, 0, tagged, payload);
    return MirOpcodeOf(instrs, tagged) == MirOp.EnumVariantTag
        && MirValueType(instrs, tagged.Index()) == MirType.EnumValue
        && MirOperandAImmediateOf(instrs, tagged) == 7
        && MirOperandBImmediateOf(instrs, tagged) == 2
        && MirOpcodeOf(instrs, inserted) == MirOp.EnumPayloadInsert
        && MirValueType(instrs, inserted.Index()) == MirType.EnumValue
        && MirOperandAOf(instrs, inserted).Equals(tagged)
        && MirOperandBOf(instrs, inserted).Equals(payload)
        && MirOperandCImmediateOf(instrs, inserted) == 7
        && MirOperandDImmediateOf(instrs, inserted) == 2
        && MirImmediateOf(instrs, inserted) == 0;
}

[Fact]
fn bool EnumExtractionInstructionsCarryOwnerAndTypeFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(7), 2);
    stack MirValueId payload = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId inserted = MirEnumPayloadInsert(instrs, TypeIdOf(7), 2, 0, tagged, payload);
    stack MirValueId tagRead = MirEnumTagRead(instrs, TypeIdOf(7), inserted, MirType.I8);
    stack MirValueId extracted = MirEnumPayloadExtract(instrs, TypeIdOf(7), 2, 0, inserted, MirType.I32);
    return MirOpcodeOf(instrs, tagRead) == MirOp.EnumTagRead
        && MirValueType(instrs, tagRead.Index()) == MirType.I8
        && MirOperandAOf(instrs, tagRead).Equals(inserted)
        && MirOperandBImmediateOf(instrs, tagRead) == 7
        && MirOpcodeOf(instrs, extracted) == MirOp.EnumPayloadExtract
        && MirValueType(instrs, extracted.Index()) == MirType.I32
        && MirOperandAOf(instrs, extracted).Equals(inserted)
        && MirOperandBImmediateOf(instrs, extracted) == 7
        && MirOperandCImmediateOf(instrs, extracted) == 2
        && MirOperandDImmediateOf(instrs, extracted) == 0;
}

[Fact]
fn bool BuildMirValueRangeFactsForEnumExtractionInstructions()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(7), 1);
    stack MirValueId payload = MirConstIntTyped(instrs, MirType.I16, 42);
    stack MirValueId inserted = MirEnumPayloadInsert(instrs, TypeIdOf(7), 1, 0, tagged, payload);
    stack MirValueId tagRead = MirEnumTagRead(instrs, TypeIdOf(7), inserted, MirType.I1);
    stack MirValueId extracted = MirEnumPayloadExtract(instrs, TypeIdOf(7), 1, 0, inserted, MirType.I16);
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts tagFacts = ValueFactsForMirValue(valueFacts, tagRead);
    stack ValueFacts payloadFacts = ValueFactsForMirValue(valueFacts, extracted);
    return tagFacts.HasIntegerRange()
        && tagFacts.IntegerRangeLower() == 1
        && tagFacts.IntegerRangeUpperExclusive() == 2
        && payloadFacts.HasIntegerRange()
        && payloadFacts.IntegerRangeLower() == 42
        && payloadFacts.IntegerRangeUpperExclusive() == 43;
}

[Fact]
fn bool EnumPointerMemoryInstructionsCarryOwnerFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 8, 8);
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(7), 2);
    stack MirValueId payload = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId inserted = MirEnumPayloadInsert(instrs, TypeIdOf(7), 2, 0, tagged, payload);
    stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(7), alloc, inserted, 8);
    stack MirValueId load = MirLoadEnumPtrAligned(instrs, TypeIdOf(7), alloc, 8);
    return MirOpcodeOf(instrs, store) == MirOp.StoreEnumPtr
        && MirValueType(instrs, store.Index()) == MirType.EnumValue
        && MirOperandAOf(instrs, store).Equals(alloc)
        && MirOperandBOf(instrs, store).Equals(inserted)
        && MirOperandCImmediateOf(instrs, store) == 7
        && MirOperandDImmediateOf(instrs, store) == 8
        && MirOpcodeOf(instrs, load) == MirOp.LoadEnumPtr
        && MirValueType(instrs, load.Index()) == MirType.EnumValue
        && MirOperandAOf(instrs, load).Equals(alloc)
        && MirOperandBImmediateOf(instrs, load) == 7
        && MirOperandCImmediateOf(instrs, load) == 8;
}

