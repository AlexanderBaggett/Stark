        "module Test\nfn i64[min max] Classify(i64[min max] x) { var y = 0; switch (x) { case 0: { var a = 4; var b = a * 2; y = b; } case 1: { var c = 10; y = c + 1; } case 2: { var f = 12; var g = f + 3; y = g; } default: { var d = 20; var e = d + 2; y = e; } } return y + 1 }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId returned = MirBlockReturnValue(blocks, MirBlockIdOf(8));
    stack MirValueId finalPhi = MirOperandAOf(instrs, returned);
    stack MirValueId case0Assigned = MirOperandAOf(instrs, finalPhi);
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 10
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 10
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 23
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.CondBranch
