                  "AbiFunctions": [
                    {
                      "QualifiedResolvedName": "Demo.CPrintf",
                      "SymbolName": "printf",
                      "SourceReturnType": {
                        "Kind": "Integer",
                        "BitWidth": 32,
                        "RangeMin": "min",
                        "RangeMax": "max",
                        "IsUnsigned": false
                      },
                      "LlvmReturnType": {
                        "Kind": "Integer",
                        "BitWidth": 32
                      },
                      "Parameters": [
                        {
                          "SourceName": "format",
                          "LlvmName": "format",
                          "SourceType": { "Kind": "RawPointer" },
                          "LlvmType": { "Kind": "RawPointer" },
                          "Kind": "direct",
                          "RawPointerElementCountExpression": "length"
                        },
                        {
                          "SourceName": "pair",
                          "LlvmName": "pair",
                          "SourceType": { "Kind": "Named", "Name": "Demo.Pair" },
                          "LlvmType": {
                            "Kind": "Integer",
                            "BitWidth": 64
                          },
                          "Kind": "direct",
                          "LlvmParameterTypes": [
                            {
                              "Kind": "Integer",
                              "BitWidth": 32
                            },
                            {
                              "Kind": "Integer",
                              "BitWidth": 32
                            }
                          ]
                        },
                        {
                          "SourceName": "ret",
                          "LlvmName": "ret",
                          "SourceType": { "Kind": "RawPointer" },
                          "LlvmType": { "Kind": "RawPointer" },
                          "Kind": "sret"
                        }
                      ],
                      "IsFfi": true,
                      "SourceName": "CPrintf",
                      "UsesFastCallingConvention": true,
                      "IsVarargs": true,
                      "FfiAbi": "c",
                      "UsesTailCallingConvention": false,
                      "LinkName": "printf"
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerFacts": {
                "FunctionEffects": [],
                "AbiFunctions": [
                  {
                    "QualifiedResolvedName": "Demo.Bad",
                    "SymbolName": "bad",
                    "SourceReturnType": { "Kind": "Void" },
                    "LlvmReturnType": { "Kind": "Void" },
                    "Parameters": [
                      {
                        "SourceName": "value",
                        "LlvmName": "value",
                        "SourceType": { "Kind": "Integer", "BitWidth": 32 },
                        "LlvmType": { "Kind": "Integer", "BitWidth": 32 },
                        "Kind": "not-a-kind"
                      }
                    ],
                    "IsFfi": false
                  }
                ]
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageAbiFactGraph graph = new();
    stack mut LogicalPackageAbiFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageAbiFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageAbiFactJsonGraph(malformedJson, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageAbiFunctionRow functionRow = graph.AbiFunctionRowAt(1);
    stack LogicalPackageAbiParameterRow formatParameter = graph.ParameterRowAt(1);
    stack LogicalPackageAbiParameterRow pairParameter = graph.ParameterRowAt(2);
    stack LogicalPackageAbiParameterRow returnBufferParameter = graph.ParameterRowAt(3);
    stack LogicalPackageAbiParameterLlvmTypeRow carrier0 = graph.LlvmParameterTypeRowAt(1);
    stack LogicalPackageAbiParameterLlvmTypeRow carrier1 = graph.LlvmParameterTypeRowAt(2);
    stack LogicalPackageAbiFactTextRow nameText =
        graph.TextRowAt(functionRow.QualifiedResolvedNameTextRow());
    stack LogicalPackageAbiFactTextRow symbolText =
        graph.TextRowAt(functionRow.SymbolNameTextRow());
    stack LogicalPackageAbiFactTextRow ffiAbiText =
        graph.TextRowAt(functionRow.FfiAbiTextRow());
    stack LogicalPackageAbiFactTextRow rawCountText =
        graph.TextRowAt(formatParameter.RawPointerElementCountExpressionTextRow());
    stack LogicalPackageTypeReferenceSummary sourceReturnSummary =
        graph.TypeReferenceAt(functionRow.SourceReturnTypeReferenceRow()).Summary();
    stack LogicalPackageTypeReferenceSummary pairSourceSummary =
        graph.TypeReferenceAt(pairParameter.SourceTypeReferenceRow()).Summary();
    stack LogicalPackageTypeReferenceSummary carrier0Summary =
        graph.TypeReferenceAt(carrier0.TypeReferenceRow()).Summary();
    stack mut OwnedAscii qualifiedName = new();
    stack mut OwnedAscii symbolName = new();
    stack mut OwnedAscii ffiAbi = new();
    stack mut OwnedAscii rawCount = new();
    return graph.AbiFunctionRowCount() == 1
        && graph.ParameterRowCount() == 3
        && graph.LlvmParameterTypeRowCount() == 2
        && graph.TypeReferenceCount() == 10
        && graph.TextRowCount() == 12
        && graph.TextByteCount() > 0
        && functionRow.ModuleOrdinal() == 0
        && functionRow.AbiFunctionOrdinal() == 0
        && functionRow.FirstParameterRow() == 1
        && functionRow.ParameterRowCount() == 3
        && functionRow.IsFfi()
        && functionRow.UsesFastCallingConvention()
        && functionRow.IsVarargs()
        && !functionRow.UsesTailCallingConvention()
        && functionRow.HasSourceName()
        && functionRow.HasFfiAbi()
        && functionRow.HasLinkName()
        && formatParameter.AbiFunctionRow() == 1
        && formatParameter.ParameterOrdinal() == 0
        && formatParameter.Kind() == LogicalPackageAbiParameterKind.Direct
        && formatParameter.HasRawPointerElementCountExpression()
        && formatParameter.LlvmParameterTypeRowCount() == 0
        && pairParameter.AbiFunctionRow() == 1
        && pairParameter.ParameterOrdinal() == 1
        && pairParameter.Kind() == LogicalPackageAbiParameterKind.Direct
        && !pairParameter.HasRawPointerElementCountExpression()
        && pairParameter.FirstLlvmParameterTypeRow() == 1
        && pairParameter.LlvmParameterTypeRowCount() == 2
        && returnBufferParameter.Kind() == LogicalPackageAbiParameterKind.SRet
        && carrier0.AbiParameterRow() == 2
        && carrier0.TypeOrdinal() == 0
        && carrier1.AbiParameterRow() == 2
        && carrier1.TypeOrdinal() == 1
        && nameText.TextKind() == LogicalPackageAbiFactTextKind.QualifiedResolvedName
        && symbolText.TextKind() == LogicalPackageAbiFactTextKind.SymbolName
        && ffiAbiText.TextKind() == LogicalPackageAbiFactTextKind.FfiAbi
        && rawCountText.TextKind() == LogicalPackageAbiFactTextKind.ParameterRawPointerElementCountExpression
        && sourceReturnSummary.Source() == LogicalPackageTypedTypeReferenceSource.AbiFunctionSourceReturn
        && sourceReturnSummary.HasBitWidth()
        && sourceReturnSummary.BitWidth() == 32
        && pairSourceSummary.Source() == LogicalPackageTypedTypeReferenceSource.AbiParameterSourceType
        && pairSourceSummary.HasName()
        && carrier0Summary.Source() == LogicalPackageTypedTypeReferenceSource.AbiParameterLlvmCarrierType
        && carrier0Summary.PayloadOrdinal() == 0
        && AppendLogicalPackageAbiFactText(graph, nameText, qualifiedName) == MemoryStatus.Ok
        && AppendLogicalPackageAbiFactText(graph, symbolText, symbolName) == MemoryStatus.Ok
        && AppendLogicalPackageAbiFactText(graph, ffiAbiText, ffiAbi) == MemoryStatus.Ok
        && AppendLogicalPackageAbiFactText(graph, rawCountText, rawCount) == MemoryStatus.Ok
        && OwnedAsciiEqualsAscii(qualifiedName, "Demo.CPrintf")
        && OwnedAsciiEqualsAscii(symbolName, "printf")
        && OwnedAsciiEqualsAscii(ffiAbi, "c")
        && OwnedAsciiEqualsAscii(rawCount, "length");
}

[Fact]
fn bool LogicalPackageImageMaterializesLayoutFactRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "CompilerFacts": {
                  "FunctionEffects": [],
                  "ConcreteLayouts": [
                    {
                      "QualifiedTypeName": "Demo.Pair",
                      "SizeBytes": 16,
                      "AlignmentBytes": 8,
                      "Fields": [
                        {
                          "Name": "A",
                          "OffsetBytes": 0,
                          "SizeBytes": 4,
                          "NaturalAlignmentBytes": 4,
                          "EffectiveAlignmentBytes": 4,
                          "IsMisaligned": false
                        },
                        {
                          "Name": "B",
                          "OffsetBytes": 8,
                          "SizeBytes": 8,
                          "NaturalAlignmentBytes": 8,
                          "EffectiveAlignmentBytes": 8,
                          "IsMisaligned": false
                        }
                      ]
                    }
                  ],
                  "EnumLayouts": [
                    {
                      "QualifiedTypeName": "Demo.Packet",
                      "Kind": "directtag",
                      "TagField": {
                        "Name": "$tag",
                        "Type": {
                          "Kind": "Integer",
                          "BitWidth": 8,
                          "RangeMin": "0",
                          "RangeMax": "1",
                          "IsUnsigned": false
                        }
                      },
                      "OrderedFields": [
                        {
                          "Name": "$tag",
                          "Type": {
                            "Kind": "Integer",
                            "BitWidth": 8,
                            "RangeMin": "0",
                            "RangeMax": "1",
                            "IsUnsigned": false
                          }
                        },
                        {
                          "Name": "$Data_0",
                          "Type": {
                            "Kind": "Named",
                            "Name": "Demo.Pair"
                          }
                        }
                      ],
                      "Variants": [
                        {
                          "Name": "Empty",
                          "TagValue": 0,
                          "UsesNamedFields": false,
                          "Fields": []
                        },
                        {
                          "Name": "Data",
                          "TagValue": 1,
                          "UsesNamedFields": false,
                          "Fields": [
                            {
                              "SourcePosition": 0,
                              "SourceFieldName": null,
                              "StorageFieldName": "$Data_0",
                              "StorageFieldIndex": 1,
                              "Type": {
                                "Kind": "Named",
                                "Name": "Demo.Pair"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerFacts": {
                "EnumLayouts": [
                  {
                    "QualifiedTypeName": "Demo.Bad",
                    "Kind": "unknown",
                    "TagField": {
                      "Name": "$tag",
                      "Type": { "Kind": "Integer", "BitWidth": 8 }
                    },
                    "OrderedFields": [],
                    "Variants": []
                  }
                ]
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageLayoutFactGraph graph = new();
    stack mut LogicalPackageLayoutFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageLayoutFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageLayoutFactJsonGraph(malformedJson, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageConcreteTypeLayoutRow pairLayout = graph.ConcreteLayoutRowAt(1);
    stack LogicalPackageConcreteFieldLayoutRow fieldA = graph.ConcreteFieldRowAt(1);
    stack LogicalPackageConcreteFieldLayoutRow fieldB = graph.ConcreteFieldRowAt(2);
    stack LogicalPackageEnumLayoutRow packetLayout = graph.EnumLayoutRowAt(1);
    stack LogicalPackageEnumOrderedFieldLayoutRow tagOrderedField = graph.EnumOrderedFieldRowAt(1);
    stack LogicalPackageEnumOrderedFieldLayoutRow payloadOrderedField = graph.EnumOrderedFieldRowAt(2);
    stack LogicalPackageEnumVariantLayoutRow emptyVariant = graph.EnumVariantRowAt(1);
    stack LogicalPackageEnumVariantLayoutRow dataVariant = graph.EnumVariantRowAt(2);
    stack LogicalPackageEnumVariantFieldLayoutRow dataPayload = graph.EnumVariantFieldRowAt(1);
    stack LogicalPackageLayoutFactTextRow pairNameText =
        graph.TextRowAt(pairLayout.QualifiedTypeNameTextRow());
    stack LogicalPackageLayoutFactTextRow fieldBNameText = graph.TextRowAt(fieldB.NameTextRow());
    stack LogicalPackageLayoutFactTextRow layoutKindText = graph.TextRowAt(packetLayout.KindTextRow());
    stack LogicalPackageLayoutFactTextRow dataVariantNameText =
        graph.TextRowAt(dataVariant.NameTextRow());
    stack LogicalPackageLayoutFactTextRow dataStorageNameText =
        graph.TextRowAt(dataPayload.StorageFieldNameTextRow());
    stack LogicalPackageTypeReferenceSummary tagSummary =
        graph.TypeReferenceAt(packetLayout.TagFieldTypeReferenceRow()).Summary();
    stack LogicalPackageTypeReferenceSummary orderedPayloadSummary =
        graph.TypeReferenceAt(payloadOrderedField.TypeReferenceRow()).Summary();
    stack LogicalPackageTypeReferenceSummary dataPayloadSummary =
        graph.TypeReferenceAt(dataPayload.TypeReferenceRow()).Summary();
    stack mut OwnedAscii pairName = new();
    stack mut OwnedAscii fieldBName = new();
    stack mut OwnedAscii layoutKind = new();
    stack mut OwnedAscii dataVariantName = new();
    stack mut OwnedAscii dataStorageName = new();
    return graph.ConcreteLayoutRowCount() == 1
        && graph.ConcreteFieldRowCount() == 2
        && graph.EnumLayoutRowCount() == 1
        && graph.EnumOrderedFieldRowCount() == 2
        && graph.EnumVariantRowCount() == 2
        && graph.EnumVariantFieldRowCount() == 1
        && graph.TypeReferenceCount() == 4
        && graph.TextRowCount() == 11
        && graph.TextByteCount() > 0
        && pairLayout.ModuleOrdinal() == 0
        && pairLayout.LayoutOrdinal() == 0
        && pairLayout.SizeBytes() == 16
        && pairLayout.AlignmentBytes() == 8
        && pairLayout.FirstFieldRow() == 1
        && pairLayout.FieldRowCount() == 2
        && fieldA.ConcreteLayoutRow() == 1
        && fieldA.FieldOrdinal() == 0
        && fieldA.OffsetBytes() == 0
        && fieldA.SizeBytes() == 4
        && fieldA.NaturalAlignmentBytes() == 4
        && fieldA.EffectiveAlignmentBytes() == 4
        && !fieldA.IsMisaligned()
        && fieldB.ConcreteLayoutRow() == 1
        && fieldB.FieldOrdinal() == 1
        && fieldB.OffsetBytes() == 8
        && fieldB.SizeBytes() == 8
        && packetLayout.ModuleOrdinal() == 0
        && packetLayout.LayoutOrdinal() == 0
        && packetLayout.Kind() == LogicalPackageEnumLayoutKind.DirectTag
        && packetLayout.FirstOrderedFieldRow() == 1
        && packetLayout.OrderedFieldRowCount() == 2
        && packetLayout.FirstVariantRow() == 1
        && packetLayout.VariantRowCount() == 2
        && tagOrderedField.EnumLayoutRow() == 1
        && tagOrderedField.FieldOrdinal() == 0
        && payloadOrderedField.EnumLayoutRow() == 1
        && payloadOrderedField.FieldOrdinal() == 1
        && emptyVariant.EnumLayoutRow() == 1
        && emptyVariant.VariantOrdinal() == 0
        && emptyVariant.TagValue() == 0
        && emptyVariant.FieldRowCount() == 0
        && dataVariant.EnumLayoutRow() == 1
        && dataVariant.VariantOrdinal() == 1
        && dataVariant.TagValue() == 1
        && dataVariant.FirstFieldRow() == 1
        && dataVariant.FieldRowCount() == 1
        && dataPayload.EnumVariantRow() == 2
        && dataPayload.FieldOrdinal() == 0
        && dataPayload.SourcePosition() == 0
        && !dataPayload.HasSourceFieldName()
        && dataPayload.SourceFieldNameTextRow() == 0
        && dataPayload.StorageFieldIndex() == 1
        && pairNameText.TextKind() == LogicalPackageLayoutFactTextKind.QualifiedTypeName
        && fieldBNameText.TextKind() == LogicalPackageLayoutFactTextKind.ConcreteFieldName
        && layoutKindText.TextKind() == LogicalPackageLayoutFactTextKind.EnumLayoutKind
        && dataVariantNameText.TextKind() == LogicalPackageLayoutFactTextKind.EnumVariantName
        && dataStorageNameText.TextKind() == LogicalPackageLayoutFactTextKind.EnumVariantStorageFieldName
        && tagSummary.Source() == LogicalPackageTypedTypeReferenceSource.LayoutEnumTagFieldType
        && tagSummary.HasBitWidth()
        && tagSummary.BitWidth() == 8
        && orderedPayloadSummary.Source() == LogicalPackageTypedTypeReferenceSource.LayoutEnumOrderedFieldType
        && orderedPayloadSummary.PayloadOrdinal() == 1
        && orderedPayloadSummary.HasName()
        && dataPayloadSummary.Source() == LogicalPackageTypedTypeReferenceSource.LayoutEnumVariantFieldType
        && dataPayloadSummary.VariantOrdinal() == 1
        && dataPayloadSummary.PayloadOrdinal() == 0
        && dataPayloadSummary.HasName()
        && AppendLogicalPackageLayoutFactText(graph, pairNameText, pairName) == MemoryStatus.Ok
        && AppendLogicalPackageLayoutFactText(graph, fieldBNameText, fieldBName) == MemoryStatus.Ok
        && AppendLogicalPackageLayoutFactText(graph, layoutKindText, layoutKind) == MemoryStatus.Ok
        && AppendLogicalPackageLayoutFactText(graph, dataVariantNameText, dataVariantName)
            == MemoryStatus.Ok
        && AppendLogicalPackageLayoutFactText(graph, dataStorageNameText, dataStorageName)
            == MemoryStatus.Ok
        && OwnedAsciiEqualsAscii(pairName, "Demo.Pair")
        && OwnedAsciiEqualsAscii(fieldBName, "B")
        && OwnedAsciiEqualsAscii(layoutKind, "directtag")
        && OwnedAsciiEqualsAscii(dataVariantName, "Data")
        && OwnedAsciiEqualsAscii(dataStorageName, "$Data_0");
}

[Fact]
fn bool LogicalPackageImageMaterializesNativeMetadataFactRows()
{
    stack ascii manifestJson = raw"""
        {
          "RootModule": "Demo",
          "LibraryFileName": "libDemo.a",
          "NativeDependencies": {
            "Sources": [ "shim.c" ],
            "IncludeDirectories": [ "include" ],
            "LibraryDirectories": [ "lib" ],
            "Libraries": [ "raylib", "m" ],
            "LinkArguments": [ "-framework", "Cocoa" ],
            "PkgConfigPackages": [ "raylib" ]
          },
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "CompilerFacts": {
                  "FunctionEffects": [],
                  "Linkage": {
                    "ObjectFileName": "Demo.o",
                    "DefinedSymbols": [ "Demo.main", "Demo.helper" ],
                    "ReferencedSymbols": [ "puts" ]
                  }
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "CompilerFacts": {
                  "FunctionEffects": [],
                  "Linkage": {
                    "ObjectFileName": "Demo.o",
                    "ReferencedSymbols": [ "puts" ]
                  }
                }
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageNativeMetadataFactGraph graph = new();
    stack mut LogicalPackageNativeMetadataFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageNativeMetadataFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageNativeMetadataFactJsonGraph(malformedJson, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageNativeDependencyRow sourceDependency = graph.NativeDependencyRowAt(1);
    stack LogicalPackageNativeDependencyRow libraryDependency = graph.NativeDependencyRowAt(4);
    stack LogicalPackageNativeDependencyRow frameworkDependency = graph.NativeDependencyRowAt(6);
    stack LogicalPackageNativeDependencyRow pkgConfigDependency = graph.NativeDependencyRowAt(8);
    stack LogicalPackageLinkageRow linkage = graph.LinkageRowAt(1);
    stack LogicalPackageLinkageSymbolRow definedMain = graph.DefinedSymbolRowAt(1);
    stack LogicalPackageLinkageSymbolRow definedHelper = graph.DefinedSymbolRowAt(2);
    stack LogicalPackageLinkageSymbolRow referencedPuts = graph.ReferencedSymbolRowAt(1);
    stack LogicalPackageNativeMetadataFactTextRow sourceText =
        graph.TextRowAt(sourceDependency.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow libraryText =
        graph.TextRowAt(libraryDependency.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow frameworkText =
        graph.TextRowAt(frameworkDependency.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow pkgConfigText =
        graph.TextRowAt(pkgConfigDependency.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow objectFileText =
        graph.TextRowAt(linkage.ObjectFileNameTextRow());
    stack LogicalPackageNativeMetadataFactTextRow helperText =
        graph.TextRowAt(definedHelper.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow putsText =
        graph.TextRowAt(referencedPuts.TextRow());
    stack mut OwnedAscii sourceName = new();
    stack mut OwnedAscii libraryName = new();
    stack mut OwnedAscii frameworkToken = new();
    stack mut OwnedAscii pkgConfigName = new();
    stack mut OwnedAscii objectFileName = new();
    stack mut OwnedAscii helperSymbol = new();
    stack mut OwnedAscii putsSymbol = new();
    return graph.NativeDependencyRowCount() == 8
        && graph.LinkageRowCount() == 1
        && graph.DefinedSymbolRowCount() == 2
        && graph.ReferencedSymbolRowCount() == 1
        && graph.TextRowCount() == 12
        && graph.TextByteCount() > 0
        && sourceDependency.Kind() == LogicalPackageNativeDependencyKind.Source
        && sourceDependency.DependencyOrdinal() == 0
        && libraryDependency.Kind() == LogicalPackageNativeDependencyKind.Library
        && libraryDependency.DependencyOrdinal() == 0
        && frameworkDependency.Kind() == LogicalPackageNativeDependencyKind.LinkArgument
        && frameworkDependency.DependencyOrdinal() == 0
        && pkgConfigDependency.Kind() == LogicalPackageNativeDependencyKind.PkgConfigPackage
        && pkgConfigDependency.DependencyOrdinal() == 0
        && linkage.ModuleOrdinal() == 0
        && linkage.FirstDefinedSymbolRow() == 1
        && linkage.DefinedSymbolRowCount() == 2
        && linkage.FirstReferencedSymbolRow() == 1
        && linkage.ReferencedSymbolRowCount() == 1
        && definedMain.LinkageRow() == 1
        && definedMain.SymbolOrdinal() == 0
        && definedHelper.LinkageRow() == 1
        && definedHelper.SymbolOrdinal() == 1
        && referencedPuts.LinkageRow() == 1
        && referencedPuts.SymbolOrdinal() == 0
        && sourceText.TextKind() == LogicalPackageNativeMetadataFactTextKind.NativeSource
        && libraryText.TextKind() == LogicalPackageNativeMetadataFactTextKind.NativeLibrary
        && frameworkText.TextKind() == LogicalPackageNativeMetadataFactTextKind.NativeLinkArgument
        && pkgConfigText.TextKind() == LogicalPackageNativeMetadataFactTextKind.NativePkgConfigPackage
        && objectFileText.TextKind() == LogicalPackageNativeMetadataFactTextKind.LinkageObjectFileName
        && helperText.TextKind() == LogicalPackageNativeMetadataFactTextKind.LinkageDefinedSymbol
        && putsText.TextKind() == LogicalPackageNativeMetadataFactTextKind.LinkageReferencedSymbol
        && AppendLogicalPackageNativeMetadataFactText(graph, sourceText, sourceName) == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(graph, libraryText, libraryName) == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(graph, frameworkText, frameworkToken) == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(graph, pkgConfigText, pkgConfigName) == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(graph, objectFileText, objectFileName) == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(graph, helperText, helperSymbol) == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(graph, putsText, putsSymbol) == MemoryStatus.Ok
        && OwnedAsciiEqualsAscii(sourceName, "shim.c")
        && OwnedAsciiEqualsAscii(libraryName, "raylib")
        && OwnedAsciiEqualsAscii(frameworkToken, "-framework")
        && OwnedAsciiEqualsAscii(pkgConfigName, "raylib")
        && OwnedAsciiEqualsAscii(objectFileName, "Demo.o")
        && OwnedAsciiEqualsAscii(helperSymbol, "Demo.helper")
        && OwnedAsciiEqualsAscii(putsSymbol, "puts");
}

[Fact]
fn bool LogicalPackageImageMaterializesFunctionSemanticMemoryEffectRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "CompilerFacts": {
                  "FunctionSemantics": [
                    {
                      "QualifiedResolvedName": "Demo.Work",
                      "DeclaredKind": "fn",
                      "EffectiveKind": "finite",
                      "CalledFunctions": [ "Demo.Callee", "Demo.Helper" ],
                      "MemoryEffects": {
                        "ReadsArgumentMemory": true,
                        "WritesArgumentMemory": false,
                        "CapturesArgumentMemory": true,
                        "ReadsOtherMemory": true,
                        "WritesOtherMemory": false,
                        "InitializesArgumentMemory": true,
                        "HasPointeeDeadOnReturnArgument": true
                      },
                      "Parameters": [
                        {
                          "Name": "buffer",
                          "Type": "borrow mut u8[0 max][]",
                          "IsMemoryBacked": true,
                          "GuaranteedNonNull": true,
                          "GuaranteedReadOnly": false,
                          "GuaranteedWriteOnly": false,
                          "GuaranteedNoAlias": true,
                          "DereferenceableBytes": 16,
                          "AlignmentBytes": 8,
                          "Reads": true,
                          "Writes": true,
                          "CaptureKind": "borrow",
                          "InitializationRanges": [
                            { "StartByte": 0, "EndByte": 8 },
                            { "StartByte": 8, "EndByte": 16 }
                          ],
                          "PointeeDeadOnReturn": true
                        },
                        {
                          "Name": "count",
                          "Type": "i32[0 max]",
                          "IsMemoryBacked": false,
                          "GuaranteedNonNull": false,
                          "GuaranteedReadOnly": false,
                          "GuaranteedWriteOnly": false,
                          "GuaranteedNoAlias": false,
                          "Reads": false,
                          "Writes": false,
                          "CaptureKind": "none"
                        }
                      ],
                      "Calls": [
                        {
                          "CalleeName": "Demo.Callee",
                          "MemoryEffects": {
                            "ReadsArgumentMemory": true,
                            "WritesArgumentMemory": true,
                            "CapturesArgumentMemory": false,
                            "ReadsOtherMemory": false,
                            "WritesOtherMemory": false
                          },
                          "Arguments": [
                            {
                              "ArgumentIndex": 0,
                              "CallerParameterName": "buffer",
                              "CalleeParameterName": "input",
                              "Reads": true,
                              "Writes": false,
                              "CaptureKind": "borrow"
                            },
                            {
                              "ArgumentIndex": 1,
                              "CalleeParameterName": "count",
                              "Reads": false,
                              "Writes": false,
                              "CaptureKind": "none"
                            }
                          ]
                        }
                      ],
                      "HasOpaqueCall": false
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerFacts": {
                "FunctionSemantics": [
                  {
                    "QualifiedResolvedName": "Demo.Bad",
                    "DeclaredKind": "fn",
                    "EffectiveKind": "fn",
                    "CalledFunctions": [],
                    "MemoryEffects": {
                      "ReadsArgumentMemory": false,
                      "WritesArgumentMemory": false,
                      "CapturesArgumentMemory": false,
                      "ReadsOtherMemory": false
                    }
                  }
                ]
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageFunctionSemanticFactGraph graph = new();
    stack mut LogicalPackageFunctionSemanticFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageFunctionSemanticFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageFunctionSemanticFactJsonGraph(malformedJson, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageFunctionSemanticRow semantic = graph.FunctionSemanticRowAt(1);
    stack LogicalPackageFunctionMemoryEffectFacts semanticEffects = semantic.MemoryEffects();
    stack LogicalPackageFunctionSemanticCalledFunctionRow calledHelper = graph.CalledFunctionRowAt(2);
    stack LogicalPackageFunctionSemanticParameterRow buffer = graph.ParameterRowAt(1);
    stack LogicalPackageFunctionSemanticParameterRow count = graph.ParameterRowAt(2);
    stack LogicalPackageFunctionSemanticInitializationRangeRow firstRange =
        graph.InitializationRangeRowAt(1);
    stack LogicalPackageFunctionSemanticInitializationRangeRow secondRange =
        graph.InitializationRangeRowAt(2);
    stack LogicalPackageFunctionSemanticCallRow call = graph.CallRowAt(1);
    stack LogicalPackageFunctionMemoryEffectFacts callEffects = call.MemoryEffects();
    stack LogicalPackageFunctionSemanticCallArgumentRow bufferArgument = graph.CallArgumentRowAt(1);
    stack LogicalPackageFunctionSemanticCallArgumentRow countArgument = graph.CallArgumentRowAt(2);
    stack LogicalPackageFunctionSemanticFactTextRow functionNameText =
        graph.TextRowAt(semantic.QualifiedResolvedNameTextRow());
    stack LogicalPackageFunctionSemanticFactTextRow calledHelperText =
        graph.TextRowAt(calledHelper.NameTextRow());
    stack LogicalPackageFunctionSemanticFactTextRow bufferTypeText =
        graph.TextRowAt(buffer.TypeTextRow());
    stack LogicalPackageFunctionSemanticFactTextRow callCalleeText =
        graph.TextRowAt(call.CalleeNameTextRow());
    stack LogicalPackageFunctionSemanticFactTextRow bufferArgumentCallerText =
        graph.TextRowAt(bufferArgument.CallerParameterNameTextRow());
    stack LogicalPackageFunctionSemanticFactTextRow countArgumentCalleeText =
        graph.TextRowAt(countArgument.CalleeParameterNameTextRow());
    stack mut OwnedAscii functionName = new();
    stack mut OwnedAscii calledHelperName = new();
    stack mut OwnedAscii bufferType = new();
    stack mut OwnedAscii callCalleeName = new();
    stack mut OwnedAscii bufferArgumentCallerName = new();
    stack mut OwnedAscii countArgumentCalleeName = new();
    return graph.FunctionSemanticRowCount() == 1
        && graph.CalledFunctionRowCount() == 2
        && graph.ParameterRowCount() == 2
        && graph.InitializationRangeRowCount() == 2
        && graph.CallRowCount() == 1
        && graph.CallArgumentRowCount() == 2
        && graph.TextRowCount() == 17
        && graph.TextByteCount() > 0
        && semantic.ModuleOrdinal() == 0
        && semantic.FunctionSemanticOrdinal() == 0
        && semantic.FirstCalledFunctionRow() == 1
        && semantic.CalledFunctionRowCount() == 2
        && semantic.FirstParameterRow() == 1
        && semantic.ParameterRowCount() == 2
        && semantic.FirstCallRow() == 1
        && semantic.CallRowCount() == 1
        && semantic.HasMemoryEffects()
        && semantic.HasExplicitHasOpaqueCall()
        && !semantic.HasOpaqueCall()
        && semanticEffects.ReadsArgumentMemory()
        && !semanticEffects.WritesArgumentMemory()
        && semanticEffects.CapturesArgumentMemory()
        && semanticEffects.ReadsOtherMemory()
        && !semanticEffects.WritesOtherMemory()
        && semanticEffects.InitializesArgumentMemory()
        && semanticEffects.HasPointeeDeadOnReturnArgument()
        && calledHelper.FunctionSemanticRow() == 1
        && calledHelper.CalledFunctionOrdinal() == 1
        && buffer.FunctionSemanticRow() == 1
        && buffer.ParameterOrdinal() == 0
        && buffer.IsMemoryBacked()
        && buffer.GuaranteedNonNull()
        && !buffer.GuaranteedReadOnly()
        && !buffer.GuaranteedWriteOnly()
        && buffer.GuaranteedNoAlias()
        && buffer.HasDereferenceableBytes()
        && buffer.DereferenceableBytes() == 16
        && buffer.HasAlignmentBytes()
        && buffer.AlignmentBytes() == 8
        && buffer.Reads()
        && buffer.Writes()
        && buffer.PointeeDeadOnReturn()
        && buffer.FirstInitializationRangeRow() == 1
        && buffer.InitializationRangeRowCount() == 2
        && count.ParameterOrdinal() == 1
        && !count.IsMemoryBacked()
        && !count.HasDereferenceableBytes()
        && count.DereferenceableBytes() == 0
        && !count.HasAlignmentBytes()
        && count.AlignmentBytes() == 0
        && !count.Reads()
        && !count.Writes()
        && !count.PointeeDeadOnReturn()
        && firstRange.ParameterRow() == 1
        && firstRange.RangeOrdinal() == 0
        && firstRange.StartByte() == 0
        && firstRange.EndByte() == 8
        && secondRange.RangeOrdinal() == 1
        && secondRange.StartByte() == 8
        && secondRange.EndByte() == 16
        && call.FunctionSemanticRow() == 1
        && call.CallOrdinal() == 0
        && call.FirstArgumentRow() == 1
        && call.ArgumentRowCount() == 2
        && callEffects.ReadsArgumentMemory()
        && callEffects.WritesArgumentMemory()
        && !callEffects.CapturesArgumentMemory()
        && !callEffects.ReadsOtherMemory()
        && !callEffects.WritesOtherMemory()
        && !callEffects.InitializesArgumentMemory()
        && !callEffects.HasPointeeDeadOnReturnArgument()
        && bufferArgument.CallRow() == 1
        && bufferArgument.CallArgumentOrdinal() == 0
        && bufferArgument.ArgumentIndex() == 0
        && bufferArgument.HasCallerParameterName()
        && bufferArgument.HasCalleeParameterName()
        && bufferArgument.Reads()
        && !bufferArgument.Writes()
        && countArgument.CallArgumentOrdinal() == 1
        && countArgument.ArgumentIndex() == 1
        && !countArgument.HasCallerParameterName()
        && countArgument.CallerParameterNameTextRow() == 0
        && countArgument.HasCalleeParameterName()
        && !countArgument.Reads()
        && !countArgument.Writes()
        && functionNameText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.QualifiedResolvedName
        && calledHelperText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.CalledFunctionName
        && bufferTypeText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.ParameterType
        && callCalleeText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.CallCalleeName
        && bufferArgumentCallerText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.CallArgumentCallerParameterName
        && countArgumentCalleeText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.CallArgumentCalleeParameterName
        && AppendLogicalPackageFunctionSemanticFactText(graph, functionNameText, functionName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionSemanticFactText(graph, calledHelperText, calledHelperName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionSemanticFactText(graph, bufferTypeText, bufferType)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionSemanticFactText(graph, callCalleeText, callCalleeName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionSemanticFactText(
            graph,
            bufferArgumentCallerText,
            bufferArgumentCallerName) == MemoryStatus.Ok
        && AppendLogicalPackageFunctionSemanticFactText(
            graph,
            countArgumentCalleeText,
            countArgumentCalleeName) == MemoryStatus.Ok
        && OwnedAsciiEqualsAscii(functionName, "Demo.Work")
        && OwnedAsciiEqualsAscii(calledHelperName, "Demo.Helper")
        && OwnedAsciiEqualsAscii(bufferType, "borrow mut u8[0 max][]")
        && OwnedAsciiEqualsAscii(callCalleeName, "Demo.Callee")
        && OwnedAsciiEqualsAscii(bufferArgumentCallerName, "buffer")
        && OwnedAsciiEqualsAscii(countArgumentCalleeName, "count");
}

[Fact]
fn bool LogicalPackageImageMaterializesFunctionOwnershipFactRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "CompilerFacts": {
                  "FunctionSemantics": [
                    {
                      "QualifiedResolvedName": "Demo.NoOwnership",
                      "DeclaredKind": "fn",
                      "EffectiveKind": "fn",
                      "CalledFunctions": []
                    },
                    {
                      "QualifiedResolvedName": "Demo.Work",
                      "DeclaredKind": "fn",
                      "EffectiveKind": "finite",
                      "CalledFunctions": [],
                      "Ownership": {
                        "OwnershipValid": true,
                        "ImplicitDrops": [ "localValue" ],
                        "Moves": [ "payload" ],
                        "Events": [
                          {
                            "Kind": "move",
                            "Place": {
                              "RootName": "payload",
                              "Type": {
                                "Kind": "integer",
                                "Name": "i32",
                                "BitWidth": 32,
                                "RangeMin": "0",
                                "RangeMax": "max",
                                "IsUnsigned": false
                              },
                              "ProjectionPath": [ "Field" ],
                              "HasIndexProjection": true
                            },
                            "Location": {
                              "FilePath": "Demo.stark",
                              "Line": 12,
                              "Column": 5
                            }
                          },
                          {
                            "Kind": "implicit-drop",
                            "Place": {
                              "RootName": "localValue",
                              "Type": {
                                "Kind": "named",
                                "Name": "Demo.Box"
                              }
                            }
                          }
                        ],
                        "Roots": [
                          {
                            "Name": "payload",
                            "Type": {
                              "Kind": "integer",
                              "Name": "i32",
                              "BitWidth": 32,
                              "RangeMin": "0",
                              "RangeMax": "max",
                              "IsUnsigned": false
                            },
                            "RootKind": "parameter",
                            "IsMutable": false,
                            "IsConstant": false,
                            "IsAddressTaken": true,
                            "HasRawPointerEscape": false,
                            "HasMove": true,
                            "HasPartialMove": false,
                            "HasImplicitDrop": false,
                            "HasAssignmentDrop": false,
                            "HasReinitialization": false,
                            "RequiresDrop": true,
                            "FinalAvailability": "moved"
                          },
                          {
                            "Name": "localValue",
                            "Type": {
                              "Kind": "named",
                              "Name": "Demo.Box"
                            },
                            "RootKind": "local",
                            "IsMutable": true,
                            "IsConstant": false,
                            "IsAddressTaken": false,
                            "HasRawPointerEscape": false,
                            "HasMove": false,
                            "HasPartialMove": false,
                            "HasImplicitDrop": true,
                            "HasAssignmentDrop": true,
                            "HasReinitialization": true,
                            "RequiresDrop": true,
                            "FinalAvailability": "initialized"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerFacts": {
                "FunctionSemantics": [
                  {
                    "QualifiedResolvedName": "Demo.Bad",
                    "DeclaredKind": "fn",
                    "EffectiveKind": "fn",
                    "CalledFunctions": [],
                    "Ownership": {
                      "OwnershipValid": true,
                      "ImplicitDrops": []
                    }
                  }
                ]
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageFunctionOwnershipFactGraph graph = new();
    stack mut LogicalPackageFunctionOwnershipFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageFunctionOwnershipFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageFunctionOwnershipFactJsonGraph(malformedJson, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageFunctionOwnershipRow ownership = graph.FunctionOwnershipRowAt(1);
    stack LogicalPackageFunctionOwnershipNameRow implicitDrop = graph.ImplicitDropRowAt(1);
    stack LogicalPackageFunctionOwnershipNameRow move = graph.MoveRowAt(1);
    stack LogicalPackageFunctionOwnershipEventRow moveEvent = graph.EventRowAt(1);
    stack LogicalPackageFunctionOwnershipEventRow dropEvent = graph.EventRowAt(2);
    stack LogicalPackageFunctionOwnershipProjectionRow projection = graph.ProjectionRowAt(1);
    stack LogicalPackageFunctionOwnershipRootRow payloadRoot = graph.RootRowAt(1);
    stack LogicalPackageFunctionOwnershipRootRow localRoot = graph.RootRowAt(2);
    stack LogicalPackageTypeReferenceRow moveEventType =
        graph.TypeReferenceGraph().TypeReferenceAt(moveEvent.PlaceTypeReferenceRow());
    stack LogicalPackageTypeReferenceRow localRootType =
        graph.TypeReferenceGraph().TypeReferenceAt(localRoot.TypeReferenceRow());
    stack LogicalPackageFunctionOwnershipFactTextRow functionNameText =
        graph.TextRowAt(ownership.QualifiedResolvedNameTextRow());
    stack LogicalPackageFunctionOwnershipFactTextRow moveEventKindText =
        graph.TextRowAt(moveEvent.KindTextRow());
    stack LogicalPackageFunctionOwnershipFactTextRow projectionText =
        graph.TextRowAt(projection.ProjectionTextRow());
    stack LogicalPackageFunctionOwnershipFactTextRow localAvailabilityText =
        graph.TextRowAt(localRoot.FinalAvailabilityTextRow());
    stack mut OwnedAscii functionName = new();
    stack mut OwnedAscii moveEventKind = new();
    stack mut OwnedAscii projectionName = new();
    stack mut OwnedAscii localAvailability = new();
    stack mut OwnedAscii moveEventTypeKind = new();
    stack mut OwnedAscii localRootTypeName = new();
    return graph.FunctionOwnershipRowCount() == 1
        && graph.ImplicitDropRowCount() == 1
        && graph.MoveRowCount() == 1
        && graph.EventRowCount() == 2
        && graph.ProjectionRowCount() == 1
        && graph.RootRowCount() == 2
        && graph.TextRowCount() == 15
        && graph.TextByteCount() > 0
        && graph.TypeReferenceCount() == 4
        && ownership.ModuleOrdinal() == 0
        && ownership.FunctionSemanticOrdinal() == 1
        && ownership.OwnershipValid()
        && ownership.FirstImplicitDropRow() == 1
        && ownership.ImplicitDropRowCount() == 1
        && ownership.FirstMoveRow() == 1
        && ownership.MoveRowCount() == 1
        && ownership.FirstEventRow() == 1
        && ownership.EventRowCount() == 2
        && ownership.FirstRootRow() == 1
        && ownership.RootRowCount() == 2
        && implicitDrop.FunctionOwnershipRow() == 1
        && implicitDrop.NameOrdinal() == 0
        && move.FunctionOwnershipRow() == 1
        && move.NameOrdinal() == 0
        && moveEvent.EventOrdinal() == 0
        && moveEvent.HasIndexProjection()
        && moveEvent.HasLocation()
        && moveEvent.HasLocationFilePath()
        && moveEvent.LocationLine() == 12
        && moveEvent.LocationColumn() == 5
        && moveEvent.FirstProjectionRow() == 1
        && moveEvent.ProjectionRowCount() == 1
        && dropEvent.EventOrdinal() == 1
        && !dropEvent.HasIndexProjection()
        && !dropEvent.HasLocation()
        && dropEvent.LocationFilePathTextRow() == 0
        && projection.EventRow() == 1
        && projection.ProjectionOrdinal() == 0
        && payloadRoot.RootOrdinal() == 0
        && !payloadRoot.IsMutable()
        && payloadRoot.IsAddressTaken()
        && payloadRoot.HasMove()
        && !payloadRoot.HasPartialMove()
        && !payloadRoot.HasImplicitDrop()
        && payloadRoot.RequiresDrop()
        && localRoot.RootOrdinal() == 1
        && localRoot.IsMutable()
        && localRoot.HasImplicitDrop()
        && localRoot.HasAssignmentDrop()
        && localRoot.HasReinitialization()
        && moveEventType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.FunctionOwnershipEventPlaceType
        && moveEventType.Summary().PayloadOrdinal() == 0
        && moveEventType.Summary().HasBitWidth()
        && localRootType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.FunctionOwnershipRootType
        && localRootType.Summary().PayloadOrdinal() == 1
        && localRootType.Summary().HasName()
        && functionNameText.TextKind()
            == LogicalPackageFunctionOwnershipFactTextKind.QualifiedResolvedName
        && moveEventKindText.TextKind() == LogicalPackageFunctionOwnershipFactTextKind.EventKind
        && projectionText.TextKind()
            == LogicalPackageFunctionOwnershipFactTextKind.EventProjectionPath
        && localAvailabilityText.TextKind()
            == LogicalPackageFunctionOwnershipFactTextKind.RootFinalAvailability
        && AppendLogicalPackageFunctionOwnershipFactText(graph, functionNameText, functionName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionOwnershipFactText(graph, moveEventKindText, moveEventKind)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionOwnershipFactText(graph, projectionText, projectionName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionOwnershipFactText(
            graph,
            localAvailabilityText,
            localAvailability) == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            moveEvent.PlaceTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Kind,
            0,
            moveEventTypeKind)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            localRoot.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            localRootTypeName)
        && OwnedAsciiEqualsAscii(functionName, "Demo.Work")
        && OwnedAsciiEqualsAscii(moveEventKind, "move")
        && OwnedAsciiEqualsAscii(projectionName, "Field")
        && OwnedAsciiEqualsAscii(localAvailability, "initialized")
        && OwnedAsciiEqualsAscii(moveEventTypeKind, "integer")
        && OwnedAsciiEqualsAscii(localRootTypeName, "Demo.Box");
}

[Fact]
fn bool LogicalPackageImageMaterializesTypedTypeFactGraphRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
