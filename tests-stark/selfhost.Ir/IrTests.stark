        && MirFunctionInstrCount(funcs, MirFuncIdOf(2)) > 0;
}

[Fact]
fn bool BinaryRoundTripsInstructionStream()
{
    // A MIR instruction stream survives a binary serialize -> deserialize round-trip:
    // opcode, result type, operands, and (negative) immediate are all preserved.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, -42);
    stack MirValueId b = MirConstIntTyped(instrs, MirType.I32, 7);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirValueId c = MirCmpLt(instrs, a, b);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 4, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirValueId opA = MirOperandAOf(back, MirValueIdOf(3));
    stack MirValueId opB = MirOperandBOf(back, MirValueIdOf(3));
    return back.Count() == 4
        && MirOpcodeOf(back, MirValueIdOf(1)) == MirOp.ConstInt
        && MirImmediateOf(back, MirValueIdOf(1)) == -42
        && MirValueType(back, 1) == MirType.I64
        && MirValueType(back, 2) == MirType.I32
        && MirOpcodeOf(back, MirValueIdOf(3)) == MirOp.Add
        && opA.Equals(MirValueIdOf(1))
        && opB.Equals(MirValueIdOf(2))
        && MirOpcodeOf(back, MirValueIdOf(4)) == MirOp.CmpLt
        && MirValueType(back, 4) == MirType.I1;
}

[Fact]
fn bool MirExplicitWrappingAndSaturatingArithmeticRoundTripsFactsAndTypedLlvm()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack i64[min max] i32Min = (i64[min max])(-(2 ** 31));
    stack i64[min max] i32Max = 2147483647;
    stack i64[min max] i32MaxUpper = (i64[min max])(2 ** 31);
    stack MirValueId maxValue = MirConstIntTyped(instrs, MirType.I32, i32Max);
    stack MirValueId oneValue = MirConstIntTyped(instrs, MirType.I32, 1);
    stack MirValueId wrapped = MirWrappingAddTyped(instrs, MirType.I32, maxValue, oneValue);
    stack MirValueId saturated = MirSaturatingAddTyped(instrs, MirType.I32, maxValue, oneValue);
    stack MirValueId unusedRet = MirReturn(instrs, saturated);

    stack mut IrTable<ValueFacts> valueFacts = new();
    if (!RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, maxValue)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, oneValue)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, wrapped)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, saturated))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 4, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);

    stack mut OwnedAscii llvm = new();
    switch (EmitLlvmTypedFunction(instrs, "wrapsat", 1, 5, llvm))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
    }

    stack ValueFacts wrappedFacts = ValueFactsForMirValue(valueFacts, wrapped);
    stack ValueFacts saturatedFacts = ValueFactsForMirValue(valueFacts, saturated);
    return back.Count() == 4
        && MirOpcodeOf(back, MirValueIdOf(3)) == MirOp.WrappingAdd
        && MirOpcodeOf(back, MirValueIdOf(4)) == MirOp.SaturatingAdd
        && MirValueType(back, 3) == MirType.I32
        && MirValueType(back, 4) == MirType.I32
        && wrappedFacts.HasIntegerRange()
        && wrappedFacts.IntegerRangeLower() == i32Min
        && wrappedFacts.IntegerRangeUpperExclusive() == i32Min + 1
        && saturatedFacts.HasIntegerRange()
        && saturatedFacts.IntegerRangeLower() == i32Max
        && saturatedFacts.IntegerRangeUpperExclusive() == i32MaxUpper
        && System.Text.Contains(llvm.View(), "%v3 = add i32 %v1, %v2")
        && System.Text.Contains(llvm.View(), "%v4.wide = add i64 %v4.wleft, %v4.wright")
        && System.Text.Contains(llvm.View(), "%v4.clamp = select")
        && System.Text.Contains(llvm.View(), "%v4 = trunc i64 %v4.clamp to i32")
        && !System.Text.Contains(llvm.View(), "nuw")
        && !System.Text.Contains(llvm.View(), "nsw");
}

[Fact]
fn bool MirCompactWrappingAndSaturatingArithmeticRoundTripsFactsAndTypedLlvm()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId i8Min = MirConstIntTyped(instrs, MirType.I8, -128);
    stack MirValueId i8One = MirConstIntTyped(instrs, MirType.I8, 1);
    stack MirValueId i8Wrapped = MirWrappingSubTyped(instrs, MirType.I8, i8Min, i8One);
    stack MirValueId i16Min = MirConstIntTyped(instrs, MirType.I16, -32768);
    stack MirValueId i16One = MirConstIntTyped(instrs, MirType.I16, 1);
    stack MirValueId i16Saturated = MirSaturatingSubTyped(instrs, MirType.I16, i16Min, i16One);
    stack MirValueId unusedRet = MirReturn(instrs, i16Saturated);

    stack mut IrTable<ValueFacts> valueFacts = new();
    if (!RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i8Min)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i8One)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i8Wrapped)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i16Min)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i16One)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i16Saturated))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 7, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);

    stack mut OwnedAscii llvm = new();
    switch (EmitLlvmTypedFunction(instrs, "compact_wrapsat", 1, 7, llvm))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
    }

    stack ValueFacts i8WrappedFacts = ValueFactsForMirValue(valueFacts, i8Wrapped);
    stack ValueFacts i16SaturatedFacts = ValueFactsForMirValue(valueFacts, i16Saturated);
    return back.Count() == 7
        && MirOpcodeOf(back, MirValueIdOf(3)) == MirOp.WrappingSub
        && MirOpcodeOf(back, MirValueIdOf(6)) == MirOp.SaturatingSub
        && MirValueType(back, 1) == MirType.I8
        && MirValueType(back, 3) == MirType.I8
        && MirValueType(back, 4) == MirType.I16
        && MirValueType(back, 6) == MirType.I16
        && i8WrappedFacts.HasIntegerRange()
        && i8WrappedFacts.IntegerRangeLower() == 127
        && i8WrappedFacts.IntegerRangeUpperExclusive() == 128
        && i16SaturatedFacts.HasIntegerRange()
        && i16SaturatedFacts.IntegerRangeLower() == -32768
        && i16SaturatedFacts.IntegerRangeUpperExclusive() == -32767
        && System.Text.Contains(llvm.View(), "%v3 = sub i8 %v1, %v2")
        && System.Text.Contains(llvm.View(), "%v6.wide = sub i32 %v6.wleft, %v6.wright")
        && System.Text.Contains(llvm.View(), "%v6 = trunc i32 %v6.clamp to i16")
        && !System.Text.Contains(llvm.View(), "nuw")
        && !System.Text.Contains(llvm.View(), "nsw");
}

[Fact]
fn bool EmitsMirTextForArithmetic()
{
    // The MIR disassembler dumps the instruction stream in MIR syntax (vN operands).
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirValueId d = MirSDiv(instrs, a, b);
    stack MirValueId r = MirReturn(instrs, s);
    stack mut OwnedAscii sink = new();
    switch (EmitMirInstructions(instrs, 1, 5, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "v1 = const 2\nv2 = const 3\nv3 = add v1, v2\nv4 = sdiv v1, v2\nret v3\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsMirTextForControlAndMemory()
{
    // Params, globals, comparisons, stores, and calls each dump in MIR syntax.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId p = MirParam(instrs, 0);
    stack MirValueId g = MirLoadGlobal(instrs, 2);
    stack MirValueId c = MirCmpLt(instrs, p, g);
    stack MirValueId st = MirStoreGlobal(instrs, 1, g);
    stack MirValueId cl = MirCall1(instrs, MirFuncIdOf(4), p);
    stack mut OwnedAscii sink = new();
    switch (EmitMirInstructions(instrs, 1, 5, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "v1 = param 0\nv2 = load g2\nv3 = slt v1, v2\nstore g1, v2\nv5 = call f4(v1)\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsMirTextForPhi()
{
    // A phi dumps both incoming value@block edges.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 10);
    stack MirValueId b = MirConstInt(instrs, 20);
    stack MirValueId phi = MirPhi2(instrs, a, MirBlockIdOf(2), b, MirBlockIdOf(3));
    stack mut OwnedAscii sink = new();
    switch (EmitMirInstructions(instrs, 1, 3, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "v1 = const 10\nv2 = const 20\nv3 = phi v1@b2, v2@b3\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirTypedValuesRecordResultType()
{
    // A typed value records its result type; untyped values default to i64.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstIntTyped(instrs, MirType.I32, 5);
    stack MirValueId b = MirConstInt(instrs, 9);
    stack MirValueId sum = MirAddTyped(instrs, MirType.I32, a, b);
    return MirValueType(instrs, a.Index()) == MirType.I32
        && MirValueType(instrs, b.Index()) == MirType.I64
        && MirValueType(instrs, sum.Index()) == MirType.I32
        && MirValueType(instrs, 99) == MirType.I64;
}

[Fact]
fn bool EmitsLlvmTypedI32Function()
{
    // A function over i32 values emits `i32` throughout — signature, body, and return.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstIntTyped(instrs, MirType.I32, 2);
    stack MirValueId b = MirConstIntTyped(instrs, MirType.I32, 3);
    stack MirValueId sum = MirAddTyped(instrs, MirType.I32, a, b);
    stack MirValueId unusedRet = MirReturn(instrs, sum);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunction(instrs, "addi32", 1, 4, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i32 @addi32() {\nentry:\n  %v1 = add i32 0, 2\n  %v2 = add i32 0, 3\n  %v3 = add i32 %v1, %v2\n  ret i32 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

