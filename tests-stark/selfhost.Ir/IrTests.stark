[Fact]
fn bool CompileFunctionAddressOfObjectFieldFeedsRawPointerCall()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("struct Box { i64[min max] value; bool flag; } unsafe fn i64[min max] use(rawptr<i64[min max]> p) { return 7 } unsafe fn i64[min max] main() { heap Box box = new Box(); box.value = 4; return use(&box.value) }", sink);
    return ok
        && System.Text.Contains(sink.View(), "call noalias nonnull noundef align 8 dereferenceable(16) ptr @__stark_heap_alloc")
        && System.Text.Contains(sink.View(), "getelementptr inbounds i8, ptr %v1, i64 0")
        && System.Text.Contains(sink.View(), "store i64 4")
        && System.Text.Contains(sink.View(), "call i64 @f1(ptr")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileFunctionAddressOfSliceElementFeedsRawPointerCall()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("unsafe fn i64[min max] use(rawptr<i64[min max]> p) { return 7 } unsafe fn i64[min max] main(i64[0 2] index) { stack mut i64[min max][3] values = { 4, 7, 9 }; stack mut i64[min max][] view = values; return use(&view[index]) }", sink);
    return ok
        && System.Text.Contains(sink.View(), "%v1 = alloca [24 x i8], align 8")
        && System.Text.Contains(sink.View(), ".scale = mul i64 %p0, 8")
        && System.Text.Contains(sink.View(), "getelementptr inbounds i8, ptr %v1, i64 %v")
        && System.Text.Contains(sink.View(), "call i64 @f1(ptr")
        && ClangVerifiesLlvmText(sink);
}

