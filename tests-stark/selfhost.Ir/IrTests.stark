    stack mut OwnedAscii sink = new();
    switch (EmitLlvmGlobals(globals, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmModuleWithGlobals()
{
    // A complete module emits its globals first, then its function definitions.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g = MirDefineGlobal(globals, 42);
    stack MirValueId a = MirConstInt(instrs, 1);
    stack MirValueId b = MirConstInt(instrs, 2);
    stack MirValueId sum = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, sum);
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmModuleWithGlobals(instrs, blocks, funcs, globals, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "@g1 = global i64 42\ndefine i64 @f1() {\nb1:\n  %v1 = add i64 0, 1\n  %v2 = add i64 0, 2\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmDiamondBranchWithPhi()
{
    // A real branching function `max(x, y)`: entry compares and conditionally branches
    // to two empty blocks that both jump to a merge block, where a phi selects the
    // value from whichever predecessor ran. Multi-block emission + cond-branch + phi.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId x = MirParam(instrs, 0);
    stack MirValueId y = MirParam(instrs, 1);
    stack MirValueId cmp = MirCmpLt(instrs, x, y);
    stack MirValueId phi = MirPhi2(instrs, y, MirBlockIdOf(2), x, MirBlockIdOf(3));
    stack MirBlockId entry = MirCondBlock(blocks, cmp, MirBlockIdOf(2), MirBlockIdOf(3));
    stack MirBlockId thenB = MirBranchBlock(blocks, MirBlockIdOf(4));
    stack MirBlockId elseB = MirBranchBlock(blocks, MirBlockIdOf(4));
    stack MirBlockId mergeB = MirReturnBlock(blocks, phi);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDiamond(instrs, blocks, "main", 2, entry.Index(), 1, 3, thenB.Index(), 1, 0, elseB.Index(), 1, 0, mergeB.Index(), 4, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v3 = icmp slt i64 %p0, %p1\n  br i1 %v3, label %b2, label %b3\nb2:\n  br label %b4\nb3:\n  br label %b4\nb4:\n  %v4 = phi i64 [ %p1, %b2 ], [ %p0, %b3 ]\n  ret i64 %v4\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmNestedIfElseChain()
{
    // An else-if chain `if x < 1 -> 10 else if x < 2 -> 20 else -> 30` lowers to two
    // composed diamonds: the outer if's else arm is itself a diamond whose merge feeds
    // the outer merge. Seven blocks, two 2-incoming phis (no N-way phi needed), emitted
    // through the general EmitLlvmBlocks block-sequence emitter.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId x = MirParam(instrs, 0);
    // entry(b1): cond1 = x < 1
    stack MirValueId one = MirConstInt(instrs, 1);
    stack MirValueId cond1 = MirCmpLt(instrs, x, one);
    // then1(b2): value 10
    stack MirValueId v10 = MirConstInt(instrs, 10);
    // inner-entry(b3): cond2 = x < 2
    stack MirValueId two = MirConstInt(instrs, 2);
    stack MirValueId cond2 = MirCmpLt(instrs, x, two);
    // then2(b4): value 20 ; else2(b5): value 30
    stack MirValueId v20 = MirConstInt(instrs, 20);
    stack MirValueId v30 = MirConstInt(instrs, 30);
    // inner-merge(b6): phi [20, b4], [30, b5]
    stack MirValueId innerPhi = MirPhi2(instrs, v20, MirBlockIdOf(4), v30, MirBlockIdOf(5));
    // outer-merge(b7): phi [10, b2], [inner, b6]
    stack MirValueId outerPhi = MirPhi2(instrs, v10, MirBlockIdOf(2), innerPhi, MirBlockIdOf(6));
    // Blocks in order: entry(b1), then1(b2), inner-entry(b3), then2(b4), else2(b5),
    // inner-merge(b6), outer-merge(b7).
    stack MirBlockId entry = MirCondBlock(blocks, cond1, MirBlockIdOf(2), MirBlockIdOf(3));
    stack MirBlockId then1 = MirBranchBlock(blocks, MirBlockIdOf(7));
    stack MirBlockId innerEntry = MirCondBlock(blocks, cond2, MirBlockIdOf(4), MirBlockIdOf(5));
    stack MirBlockId then2 = MirBranchBlock(blocks, MirBlockIdOf(6));
    stack MirBlockId else2 = MirBranchBlock(blocks, MirBlockIdOf(6));
    stack MirBlockId innerMerge = MirBranchBlock(blocks, MirBlockIdOf(7));
    stack MirBlockId outerMerge = MirReturnBlock(blocks, outerPhi);

    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, 3));
    stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(then1.Index(), 4, 1));
    stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(innerEntry.Index(), 5, 2));
    stack u32[0 max] r4 = ranges.Add(MakeBlockEmit(then2.Index(), 7, 1));
    stack u32[0 max] r5 = ranges.Add(MakeBlockEmit(else2.Index(), 8, 1));
    stack u32[0 max] r6 = ranges.Add(MakeBlockEmit(innerMerge.Index(), 9, 1));
    stack u32[0 max] r7 = ranges.Add(MakeBlockEmit(outerMerge.Index(), 10, 1));

    stack mut OwnedAscii sink = new();
    switch (EmitLlvmBlocks(instrs, blocks, "classify", 1, ranges, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @classify(i64 %p0) {\nb1:\n  %v2 = add i64 0, 1\n  %v3 = icmp slt i64 %p0, %v2\n  br i1 %v3, label %b2, label %b3\nb2:\n  %v4 = add i64 0, 10\n  br label %b7\nb3:\n  %v5 = add i64 0, 2\n  %v6 = icmp slt i64 %p0, %v5\n  br i1 %v6, label %b4, label %b5\nb4:\n  %v7 = add i64 0, 20\n  br label %b6\nb5:\n  %v8 = add i64 0, 30\n  br label %b6\nb6:\n  %v9 = phi i64 [ %v7, %b4 ], [ %v8, %b5 ]\n  br label %b7\nb7:\n  %v10 = phi i64 [ %v4, %b2 ], [ %v9, %b6 ]\n  ret i64 %v10\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool LowersCountingLoopSourceToLlvm()
{
    // Source -> loop CFG: `var i = 0; while i < 10 { i = i + 1 } return i` lexes and
    // lowers to the four-block loop — preheader constants, an induction phi counting
    // 0->10, the `slt` guard, the body increment with a back-edge, and the exit return.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerCountingLoopToLlvm("var i = 0; while i < 10 { i = i + 1 } return i", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 0\n  %v2 = add i64 0, 10\n  %v3 = add i64 0, 1\n  br label %b2\nb2:\n  %v4 = phi i64 [ %v1, %b1 ], [ %v6, %b3 ]\n  %v5 = icmp slt i64 %v4, %v2\n  br i1 %v5, label %b3, label %b4\nb3:\n  %v6 = add i64 %v4, %v3\n  br label %b2\nb4:\n  ret i64 %v4\n}\n");
}

[Fact]
fn bool EmitsLlvmCountingLoopWithBackEdge()
{
    // A real loop: `i` is an induction phi (0 from the preheader, i+1 from the body);
    // while i < n the body increments and branches back to the header; at exit the
    // function returns i (= n). Four blocks with a back-edge header<-body.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId n = MirParam(instrs, 0);
    stack MirValueId zero = MirConstInt(instrs, 0);
    // i = phi [ zero, entry(b1) ], [ inext(%v6), body(b3) ]  (inext is forward-referenced)
    stack MirValueId iVar = MirPhi2(instrs, zero, MirBlockIdOf(1), MirValueIdOf(6), MirBlockIdOf(3));
    stack MirValueId cond = MirCmpLt(instrs, iVar, n);
    stack MirValueId one = MirConstInt(instrs, 1);
    stack MirValueId iNext = MirAdd(instrs, iVar, one);
    // Blocks in order: entry(b1), header(b2), body(b3), exit(b4).
    stack MirBlockId entry = MirBranchBlock(blocks, MirBlockIdOf(2));
    stack MirBlockId header = MirCondBlock(blocks, cond, MirBlockIdOf(3), MirBlockIdOf(4));
    stack MirBlockId body = MirBranchBlock(blocks, MirBlockIdOf(2));
    stack MirBlockId exit = MirReturnBlock(blocks, iVar);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDiamond(instrs, blocks, "main", 1, entry.Index(), 1, 2, header.Index(), 3, 2, body.Index(), 5, 2, exit.Index(), 7, 0, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @main(i64 %p0) {\nb1:\n  %v2 = add i64 0, 0\n  br label %b2\nb2:\n  %v3 = phi i64 [ %v2, %b1 ], [ %v6, %b3 ]\n  %v4 = icmp slt i64 %v3, %p0\n  br i1 %v4, label %b3, label %b4\nb3:\n  %v5 = add i64 0, 1\n  %v6 = add i64 %v3, %v5\n  br label %b2\nb4:\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmEmptyModule()
{
    // A module with no functions emits no text.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmModule(instrs, blocks, funcs, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmModuleWithTwoFunctions()
{
    // A module emits one `define i64 @fN()` per function, in id order, each a
    // single-block definition over its entry block and instruction range.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    // Function 1: %v1=2, %v2=3, %v3=add; block b1 returns %v3.
    stack MirValueId a1 = MirConstInt(instrs, 2);
    stack MirValueId a2 = MirConstInt(instrs, 3);
    stack MirValueId sum = MirAdd(instrs, a1, a2);
    stack MirBlockId blkA = MirReturnBlock(blocks, sum);
    stack MirFuncId funcA = MirDefineFunction(funcs, blkA, blkA, 1, a1, 3);
    // Function 2: %v4=5, %v5=6, %v6=mul; block b2 returns %v6.
    stack MirValueId c1 = MirConstInt(instrs, 5);
    stack MirValueId c2 = MirConstInt(instrs, 6);
    stack MirValueId prod = MirMul(instrs, c1, c2);
    stack MirBlockId blkB = MirReturnBlock(blocks, prod);
    stack MirFuncId funcB = MirDefineFunction(funcs, blkB, blkB, 1, c1, 3);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmModule(instrs, blocks, funcs, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @f1() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\ndefine i64 @f2() {\nb2:\n  %v4 = add i64 0, 5\n  %v5 = add i64 0, 6\n  %v6 = mul i64 %v4, %v5\n  ret i64 %v6\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

// === AST front-end facts (reconstructed after an IrTests.stark revert; the implementations
// in selfhost/Compiler/Mir.stark were intact) ===

[Fact]
fn bool WhileLoopRejectsUnsupportedShapes()
{
    stack mut OwnedAscii s = new();
    return !CompileWhileLoopToLlvm("var i = 0; while i < n { i = i + 1 } return i", s)
        && !CompileWhileLoopToLlvm("var i = n; while i < 5 { i = i + 1 } return i", s)
        && !CompileWhileLoopToLlvm("var i = 0; while i < 5 { j = 5 i = i + 1 } return i", s)
        && !CompileWhileLoopToLlvm("var i = 0; while i < 5 { i = i + 1 j = 5 } return i", s)
        && CompileWhileLoopToLlvm("var i = 0; while i < 5 { i = i + 1 } return i", s);
}

[Fact]
fn bool AstCallLoweringEmitsCallWithArgument()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] arg = MakeIntLit(nodes, 5);
    stack u32[0 max] call = MakeCall(nodes, 1, 1, arg, 0, 0, 0);
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId value = LowerExprNode(nodes, call, instrs);
    stack mut OwnedAscii disasm = new();
    stack MemoryStatus status = EmitMirInstructions(instrs, 1, (u32[0 max])instrs.Count(), disasm);
    return LlvmTextEquals(disasm, "v1 = const 5\nv2 = call f1(v1)\n");
}

[Fact]
fn bool CompilesModuleWithCallFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn double(x) { return x + x } fn main() { return double(5) }", sink);
    stack mut OwnedAscii ghost = new();
    return ok
        && LlvmTextEquals(sink, "define i64 @f1(i64 %p0) {\nb1:\n  %v3 = add i64 %p0, %p0\n  ret i64 %v3\n}\ndefine i64 @f2() {\nb1:\n  %v1 = add i64 0, 5\n  %v2 = call i64 @f1(i64 %v1)\n  ret i64 %v2\n}\n")
        && !CompileModuleFromAst("fn main() { return ghost() }", ghost);
}

[Fact]
fn bool CompilesTailBecomeFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("tail fn done(x) { return x } tail fn bounce(x) { become done(x) } fn main() { return bounce(5) }", sink);
    stack mut OwnedAscii nonTailFunction = new();
    stack mut OwnedAscii nonTailTarget = new();
    stack mut OwnedAscii mismatchedAbi = new();
    return ok
        && LlvmTextEquals(sink, "define tailcc i64 @f1(i64 %p0) {\nb1:\n  ret i64 %p0\n}\ndefine tailcc i64 @f2(i64 %p0) {\nb1:\n  %v2 = musttail call tailcc i64 @f1(i64 %p0)\n  ret i64 %v2\n}\ndefine i64 @f3() {\nb1:\n  %v1 = add i64 0, 5\n  %v2 = call tailcc i64 @f2(i64 %v1)\n  ret i64 %v2\n}\n")
        && !CompileModuleFromAst("tail fn done(x) { return x } fn bad(x) { become done(x) }", nonTailFunction)
        && !CompileModuleFromAst("fn plain(x) { return x } tail fn bad(x) { become plain(x) }", nonTailTarget)
        && !CompileModuleFromAst("tail fn one(x) { return x } tail fn two(x, y) { become one(x) }", mismatchedAbi);
}

[Fact]
fn bool CompilesZeroArgumentTailBecomeFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("tail fn done() { return 7 } tail fn bounce() { become done() } fn main() { return bounce() }", sink);
    return ok
        && LlvmTextEquals(sink, "define tailcc i64 @f1() {\nb1:\n  %v1 = add i64 0, 7\n  ret i64 %v1\n}\ndefine tailcc i64 @f2() {\nb1:\n  %v1 = musttail call tailcc i64 @f1()\n  ret i64 %v1\n}\ndefine i64 @f3() {\nb1:\n  %v1 = call tailcc i64 @f2()\n  ret i64 %v1\n}\n")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompilesThreeAndFourArgumentTailBecomeFromAst()
{
    stack mut OwnedAscii three = new();
    stack bool threeOk = CompileModuleFromAstChecked("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }", three);
    stack mut OwnedAscii four = new();
    stack bool fourOk = CompileModuleFromAstChecked("tail fn add4(a, b, c, d) { return a + b + c + d } tail fn bounce4(a, b, c, d) { become add4(a, b, c, d) } fn main() { return bounce4(1, 2, 3, 4) }", four);
    return threeOk
        && System.Text.Contains(three.View(), "musttail call tailcc i64 @f1(i64 %p0, i64 %p1, i64 %p2)\n  ret i64")
        && System.Text.Contains(three.View(), "call tailcc i64 @f2(i64 %v1, i64 %v2, i64 %v3)")
        && ClangVerifiesLlvmText(three)
        && fourOk
        && System.Text.Contains(four.View(), "musttail call tailcc i64 @f1(i64 %p0, i64 %p1, i64 %p2, i64 %p3)\n  ret i64")
        && System.Text.Contains(four.View(), "call tailcc i64 @f2(i64 %v1, i64 %v2, i64 %v3, i64 %v4)")
        && ClangVerifiesLlvmText(four);
}

[Fact]
fn bool RejectsBecomeToUnsupportedBooleanRoot()
{
    stack mut OwnedAscii sink = new();
    return !CompileModuleFromAst("tail fn bad(a, b) { become a < b }", sink);
}

[Fact]
fn bool CompilesTailRecursiveBranchFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("tail fn count(n, acc) { if n == 0 return acc else become count(n - 1, acc + 1) } fn main() { return count(3, 0) }", sink);
    return ok
        && LlvmTextEquals(sink, "define tailcc i64 @f1(i64 %p0, i64 %p1) {\nb1:\n  %v2 = add i64 0, 0\n  %v3 = icmp eq i64 %p0, %v2\n  br i1 %v3, label %b2, label %b3\nb2:\n  ret i64 %p1\nb3:\n  %v6 = add i64 0, 1\n  %v7 = sub i64 %p0, %v6\n  %v9 = add i64 0, 1\n  %v10 = add i64 %p1, %v9\n  %v11 = musttail call tailcc i64 @f1(i64 %v7, i64 %v10)\n  ret i64 %v11\n}\ndefine i64 @f2() {\nb1:\n  %v1 = add i64 0, 3\n  %v2 = add i64 0, 0\n  %v3 = call tailcc i64 @f1(i64 %v1, i64 %v2)\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool CompileFunctionArenaLocalLowersFrameAndAllocatorFacts()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm("struct Box { i32 value; bool flag; } fn i64 main() { arena Box box = new Box(); return 7 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "declare noalias nonnull noundef ptr @__stark_arena_alloc(ptr captures(none) %frame, i64 noundef %size, i64 noundef allocalign %alignment) allocsize(1) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_arena_alloc\" nounwind")
        && System.Text.Contains(sink.View(), "%__stark_arena_frame = alloca { ptr, ptr, ptr }, align 8")
        && System.Text.Contains(sink.View(), "call noalias nonnull noundef align 4 dereferenceable(8) ptr @__stark_arena_alloc(ptr nonnull %__stark_arena_frame, i64 noundef 8, i64 noundef 4)")
        && System.Text.Contains(sink.View(), "call void @__stark_arena_leave(ptr nonnull %__stark_arena_frame)\n  ret i64 %v3")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_alloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_realloc")
        && !System.Text.Contains(sink.View(), "@__stark_heap_alloc")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileFunctionArenaSelectorNewLowersConstantCapacityAllocation()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm("finite fn i64 main() { stack dynamic i8 bytes = new(arena, 32, 16); return 5 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "= alloca { ptr, i64, i64 }, align 8")
        && System.Text.Contains(sink.View(), "call noalias nonnull noundef align 16 dereferenceable(32) ptr @__stark_arena_alloc(ptr nonnull %__stark_arena_frame, i64 noundef 32, i64 noundef 16)")
        && System.Text.Contains(sink.View(), "store { ptr, i64, i64 }")
        && System.Text.Contains(sink.View(), "allocsize(1)")
        && System.Text.Contains(sink.View(), "allocalign %alignment")
        && System.Text.Contains(sink.View(), "willreturn mustprogress norecurse")
        && !System.Text.Contains(sink.View(), "@__stark_dynamic_alloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_realloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_free")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileFunctionArenaDynamicReserveEmitsGrowCopyHelper()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm("finite fn i64 main() { stack mut dynamic u64 values = new(arena, 1); values.Reserve(8); return 5 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define internal void @__stark_arena_dynamic_reserve")
        && System.Text.Contains(sink.View(), "call void @__stark_arena_dynamic_reserve(ptr nonnull %__stark_arena_frame")
        && System.Text.Contains(sink.View(), "i64 noundef 8, i64 noundef 8, i64 noundef 8")
        && System.Text.Contains(sink.View(), "call void @llvm.memcpy.p0.p0.i64")
        && System.Text.Contains(sink.View(), "call noalias nonnull noundef ptr @__stark_arena_alloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_realloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_try_realloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_free")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileFunctionArenaDynamicTryReserveEmitsFallibleGrowCopyHelper()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm("finite fn i64 main() { stack mut dynamic u64 values = new(arena, 1); values.TryReserve(8); return 5 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define internal i1 @__stark_arena_dynamic_try_reserve")
        && System.Text.Contains(sink.View(), " = call i1 @__stark_arena_dynamic_try_reserve(ptr nonnull %__stark_arena_frame")
        && System.Text.Contains(sink.View(), "call noalias noundef ptr @__stark_arena_try_alloc")
        && System.Text.Contains(sink.View(), "call void @llvm.memcpy.p0.p0.i64")
        && System.Text.Contains(sink.View(), "ret i1 false")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_realloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_try_realloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_free")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileFunctionArenaDynamicTryReserveCapacityEmitsExactGrowCopyHelper()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm("finite fn i64 main() { stack mut dynamic u64 values = new(arena, 1); values.TryReserveCapacity(16); return 5 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define internal i1 @__stark_arena_dynamic_try_reserve_capacity")
        && System.Text.Contains(sink.View(), " = call i1 @__stark_arena_dynamic_try_reserve_capacity(ptr nonnull %__stark_arena_frame")
        && System.Text.Contains(sink.View(), "i64 noundef 16, i64 noundef 8, i64 noundef 8")
        && System.Text.Contains(sink.View(), "call noalias noundef ptr @__stark_arena_try_alloc")
        && System.Text.Contains(sink.View(), "call void @llvm.memcpy.p0.p0.i64")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_realloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_try_realloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_free")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileModuleWithMultipleArenaFunctionsEmitsValidSinglePreamble()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("struct Box { i64 value; } fn first() { arena Box box = new Box(); return 1 } fn second() { arena Box other = new Box(); return 2 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "declare noalias nonnull noundef ptr @__stark_arena_alloc")
        && System.Text.Contains(sink.View(), "define i64 @f1()")
        && System.Text.Contains(sink.View(), "define i64 @f2()")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool RejectsArenaAllocationInSelfHostedLawLowering()
{
    stack mut OwnedAscii sink = new();
    return !CompileFunctionWithLocalsToLlvm("law fn i64 main() { arena i64 slot = new(); return 1 }", sink);
}

[Fact]
fn bool BinaryRoundTripsArenaAllocInstruction()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId enter = MirArenaFrameEnter(instrs);
    stack MirValueId alloc = MirArenaAlloc(instrs, 64, 8);
    stack MirValueId leave = MirArenaFrameLeave(instrs);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 3, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction allocBack = back.Get(2);
    return back.Count() == 3
        && MirOpcodeOf(back, MirValueIdOf(1)) == MirOp.ArenaFrameEnter
        && MirOpcodeOf(back, MirValueIdOf(2)) == MirOp.ArenaAlloc
        && MirValueType(back, 2) == MirType.Ptr
        && allocBack.Immediate() == 64
        && allocBack.OperandAIndex() == 8
        && MirOpcodeOf(back, MirValueIdOf(3)) == MirOp.ArenaFrameLeave;
}

[Fact]
fn bool BinaryRoundTripsArenaDynamicInstructions()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId owner = MirArenaDynamicStorageInit(instrs, 4, 8, 16);
    stack MirValueId reserve = MirArenaDynamicStorageReserve(instrs, owner, 3, 8, 16);
    stack MirValueId tryReserve = MirArenaDynamicStorageTryReserve(instrs, owner, 5, 8, 16);
    stack MirValueId tryReserveCapacity = MirArenaDynamicStorageTryReserveCapacity(instrs, owner, 9, 8, 16);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 4, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction initBack = back.Get(1);
    stack MirInstruction reserveBack = back.Get(2);
    stack MirInstruction tryReserveBack = back.Get(3);
    stack MirInstruction tryReserveCapacityBack = back.Get(4);
    return back.Count() == 4
        && initBack.Opcode() == MirOp.ArenaDynamicStorageInit
        && initBack.Immediate() == 4
        && initBack.OperandAIndex() == 8
        && initBack.OperandBIndex() == 16
        && initBack.ResultType() == MirType.Ptr
        && reserveBack.Opcode() == MirOp.ArenaDynamicStorageReserve
        && reserveBack.OperandAIndex() == owner.Index()
        && reserveBack.Immediate() == 3
        && tryReserveBack.Opcode() == MirOp.ArenaDynamicStorageTryReserve
        && tryReserveBack.ResultType() == MirType.I1
        && tryReserveCapacityBack.Opcode() == MirOp.ArenaDynamicStorageTryReserveCapacity
        && tryReserveCapacityBack.Immediate() == 9
        && tryReserveCapacityBack.ResultType() == MirType.I1;
}

[Fact]
fn bool CompilesTwoArgumentCallFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn add(a, b) { return a + b } fn main() { return add(3, 4) }", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @f1(i64 %p0, i64 %p1) {\nb1:\n  %v3 = add i64 %p0, %p1\n  ret i64 %v3\n}\ndefine i64 @f2() {\nb1:\n  %v1 = add i64 0, 3\n  %v2 = add i64 0, 4\n  %v3 = call i64 @f1(i64 %v1, i64 %v2)\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool CompilesThreeAndFourArgumentCallsFromAst()
{
    stack mut OwnedAscii three = new();
    stack bool threeOk = CompileModuleFromAst("fn add3(a, b, c) { return a + b + c } fn main() { return add3(1, 2, 3) }", three);
    stack mut OwnedAscii four = new();
    stack bool fourOk = CompileModuleFromAst("fn add4(a, b, c, d) { return a + b + c + d } fn main() { return add4(1, 2, 3, 4) }", four);
    stack mut OwnedAscii five = new();
    return threeOk && ClangVerifiesLlvmText(three)
        && fourOk && ClangVerifiesLlvmText(four)
        && !CompileModuleFromAst("fn f5(a, b, c, d, e) { return a } fn main() { return f5(1, 2, 3, 4, 5) }", five);
}

[Fact]
fn bool BinaryRoundTripsFourArgumentCall()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a0 = MirConstInt(instrs, 10);
    stack MirValueId a1 = MirConstInt(instrs, 20);
    stack MirValueId a2 = MirConstInt(instrs, 30);
    stack MirValueId a3 = MirConstInt(instrs, 40);
    stack MirValueId call = MirCall4(instrs, MirFuncIdOf(2), a0, a1, a2, a3);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 5, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction callBack = back.Get(5);
    return back.Count() == 5
        && MirOpcodeOf(back, MirValueIdOf(5)) == MirOp.Call
        && MirImmediateOf(back, MirValueIdOf(5)) == 2
        && callBack.OperandAIndex() == 1
        && callBack.OperandBIndex() == 2
        && callBack.OperandCIndex() == 3
        && callBack.OperandDIndex() == 4;
}

[Fact]
fn bool BinaryRoundTripsFourArgumentTailCall()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a0 = MirConstInt(instrs, 10);
    stack MirValueId a1 = MirConstInt(instrs, 20);
    stack MirValueId a2 = MirConstInt(instrs, 30);
    stack MirValueId a3 = MirConstInt(instrs, 40);
    stack MirValueId call = MirTailCall4(instrs, MirFuncIdOf(2), a0, a1, a2, a3);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 5, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction callBack = back.Get(5);
    return back.Count() == 5
        && MirOpcodeOf(back, MirValueIdOf(5)) == MirOp.TailCall
        && MirImmediateOf(back, MirValueIdOf(5)) == 2
        && callBack.OperandAIndex() == 1
        && callBack.OperandBIndex() == 2
        && callBack.OperandCIndex() == 3
        && callBack.OperandDIndex() == 4;
}

[Fact]
fn bool ModuleCallsAreArityAndTypeChecked()
{
    stack mut OwnedAscii s = new();
    return !CompileModuleFromAst("fn f(x) { return x } fn main() { return f(1 < 2) }", s)
        && !CompileModuleFromAst("fn k(a, b) { return a } fn main() { return k(1, 2 < 3) }", s)
        && !CompileModuleFromAst("fn g() { return 1 } fn main() { return g(5) }", s)
        && !CompileModuleFromAst("fn h(x) { return x } fn main() { return h() }", s)
        && !CompileModuleFromAst("fn p(a, b, c, d, e) { return a } fn main() { return p(1, 2, 3, 4, 5) }", s)
        && CompileModuleFromAst("fn f(x) { return x + 1 } fn main() { return f(7) }", s)
        && CompileModuleFromAst("fn k(x) { return x } fn main() { return k(k(2)) }", s);
}

[Fact]
fn bool CompilesModuleFromAstThroughCheckedPipeline()
{
    stack mut OwnedAscii checked = new();
    stack bool checkedOk = CompileModuleFromAstChecked("fn double(x) { return x + x } fn main() { return double(5) }", checked);
    stack mut OwnedAscii direct = new();
    stack bool directOk = CompileModuleFromAst("fn double(x) { return x + x } fn main() { return double(5) }", direct);
    stack mut OwnedAscii dup = new();
    stack mut OwnedAscii dupChecked = new();
    return checkedOk && directOk && OwnedAscii.Equals(checked, direct)
        && CompileModuleFromAst("fn f() { return 1 } fn f() { return 2 } fn main() { return 1 }", dup)
        && !CompileModuleFromAstChecked("fn f() { return 1 } fn f() { return 2 } fn main() { return 1 }", dupChecked);
}

[Fact]
fn bool CompilesModuleFunctionWithLocals()
{
    stack mut OwnedAscii s = new();
    return CompileModuleFromAst("fn f(x) { var y = x + 1; return y + x } fn main() { return f(3) }", s)
        && !CompileModuleFromAst("fn f(a) { var a = 1; return a } fn main() { return f(2) }", s)
        && !CompileModuleFromAst("fn f(x) { var y = z; return y } fn main() { return f(2) }", s);
}

[Fact]
fn bool ModuleFunctionBoundariesAndLocalTypesChecked()
{
    stack mut OwnedAscii s = new();
    return !CompileModuleFromAst("fn a() { } fn b() { return 1 }", s)
        && !CompileModuleFromAst("fn a(p) { } fn b(p) { return p }", s)
        && !CompileModuleFromAst("fn id(x) { return x } fn f(a, b) { var c = a < b; return id(c) }", s)
        && CompileModuleFromAst("fn id(x) { return x } fn f(a, b) { var c = a + b; return id(c) }", s)
        && CompileModuleFromAst("fn a() { return 1 } fn b() { return 2 }", s);
}

[Fact]
fn bool CompilesRecursiveFunctionFromAst()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn fact(n) { if n < 1 return 1 else return n * fact(n - 1) } fn main() { return fact(5) }", s);
    return ok && ClangVerifiesLlvmText(s);
}

[Fact]
fn bool CompilesUnaryMinusFromAst()
{
    stack mut OwnedAscii negText = new();
    stack bool negOk = CompileFunctionToLlvm("fn neg(x) { return -x }", negText);
    stack mut OwnedAscii precText = new();
    stack bool precOk = CompileFunctionToLlvm("fn f(x, y) { return -x * y }", precText);
    return negOk
        && LlvmTextEquals(negText, "define i64 @main(i64 %p0) {\nb1:\n  %v1 = add i64 0, 0\n  %v3 = sub i64 %v1, %p0\n  ret i64 %v3\n}\n")
        && ClangVerifiesLlvmText(negText)
        && precOk && ClangVerifiesLlvmText(precText);
}

[Fact]
fn bool CompilesBooleanValuedIfExpression()
{
    stack mut OwnedAscii boolIf = new();
    stack bool boolOk = CompileIfExpressionToLlvm("if x < y x < 1 else y < 1", boolIf);
    stack mut OwnedAscii mixed = new();
    return boolOk && ClangVerifiesLlvmText(boolIf)
        && !CompileIfExpressionToLlvm("if x < y x + 1 else y < 1", mixed);
}

[Fact]
fn bool AstControlFlowCompilesToObjectViaClang()
{
    stack mut OwnedAscii ifText = new();
    stack bool ifOk = CompileIfExpressionToLlvm("if a < b a + 1 else b - 1", ifText);
    stack mut OwnedAscii whileText = new();
    stack bool whileOk = CompileWhileLoopToLlvm("var i = 0; while i < 5 { i = i + 1 } return i", whileText);
    stack mut OwnedAscii localsText = new();
    stack bool localsOk = CompileFunctionWithLocalsToLlvm("fn g(a) { var x = a + 1; var y = x * 2; return y + a }", localsText);
    return ifOk && ClangVerifiesLlvmText(ifText)
        && whileOk && ClangVerifiesLlvmText(whileText)
        && localsOk && ClangVerifiesLlvmText(localsText);
}

[Fact]
fn bool AstModuleCompilesToObjectViaClang()
{
    return CompileModuleSourceProducesObject("fn add(a, b) { return a + b } fn lt(a, b) { return a < b } fn main() { var s = add(3, 4); return s + lt(1, 2) }");
}

[Fact]
fn bool MirFunctionWellFormednessIsVerified()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId good = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack MirFunction goodFn = funcs.Get(good.Index());
    stack bool goodOk = MirFunctionWellFormed(instrs, blocks, goodFn);
    stack MirFuncId badEntry = MirDefineFunction(funcs, MirBlockIdOf(99), blk, 1, a, 3);
    stack MirFunction badEntryFn = funcs.Get(badEntry.Index());
    stack bool badEntryRejected = !MirFunctionWellFormed(instrs, blocks, badEntryFn);
    stack mut MirBlock emptyBlock = new();
    stack u32[0 max] ub = blocks.Add(emptyBlock);
    stack MirFuncId badBlock = MirDefineFunction(funcs, MirBlockIdOf(ub), MirBlockIdOf(ub), 1, a, 3);
    stack MirFunction badBlockFn = funcs.Get(badBlock.Index());
    stack bool badBlockRejected = !MirFunctionWellFormed(instrs, blocks, badBlockFn);
    return goodOk && badEntryRejected && badBlockRejected;
}

[Fact]
fn bool VerifiedModuleEmissionGatesMalformedFunctions()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack MirValueId a = MirConstInt(instrs, 7);
    stack MirBlockId blk = MirReturnBlock(blocks, a);
    stack MirFuncId good = MirDefineFunction(funcs, blk, blk, 1, a, 1);
    stack mut OwnedAscii okSink = new();
    stack bool okEmit = EmitLlvmModuleVerified(instrs, blocks, funcs, okSink);
    stack mut MirBlock emptyBlock = new();
    stack u32[0 max] ub = blocks.Add(emptyBlock);
    stack MirFuncId bad = MirDefineFunction(funcs, MirBlockIdOf(ub), MirBlockIdOf(ub), 1, a, 1);
    stack mut OwnedAscii badSink = new();
    stack bool badRejected = !EmitLlvmModuleVerified(instrs, blocks, funcs, badSink);
    return okEmit && badRejected;
}
