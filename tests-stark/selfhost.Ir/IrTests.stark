            && helper.UsesCompilerSectionsTypedInterface()
            && TryReadLogicalPackageManifestModuleJsonSummary(manifestJson, 1, root)
            && root.ModuleOrdinal() == 1
            && root.ReExportCount() == 0
            && root.FunctionCount() == 0
            && root.TypeCount() == 0
            && root.GlobalCount() == 0
            && root.TypeAliasCount() == 0
            && root.ImportCount() == 0
            && !root.HasTypedInterface()
            && !root.HasCompilerFacts()
            && !root.HasGenericTemplates()
            && !root.HasSourceSurface()
            && !root.HasCompilerSections()
            && !TryReadLogicalPackageManifestModuleJsonSummary(manifestJson, 2, rejected)
            && !TryReadLogicalPackageManifestModuleJsonSummary(missingRequiredArrayJson, 0, rejected)
            && !TryReadLogicalPackageManifestModuleJsonSummary(malformedTypedInterfaceJson, 0, rejected);
    }
}

