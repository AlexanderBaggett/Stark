[Fact]
fn bool PackageTablesPreserveCountingWhileLoop()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Count() { var i = 0; while i < 5 { i = i + 1; } return i }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId returned = MirBlockReturnValue(blocks, MirBlockIdOf(4));
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 4
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 4
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 6
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(4)) == MirTermKind.Return
        && MirBlockBranchTarget(blocks, MirBlockIdOf(1)) == MirBlockIdOf(2)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(3)) == MirBlockIdOf(2)
        && MirOpcodeOf(instrs, returned) == MirOp.Phi
        && MirPhiIncomingBlock0(instrs, returned) == MirBlockIdOf(1)
        && MirPhiIncomingBlock1(instrs, returned) == MirBlockIdOf(3);
}

[Fact]
fn bool PackageTablesPreserveAccumulatorWhileLoop()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Sum() { var i = 0; var s = 0; while i < 5 { s = s + i; i = i + 1; } return s }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId counterPhi = MirValueIdOf(5);
    stack MirValueId accumulatorPhi = MirValueIdOf(6);
    stack MirValueId returned = MirBlockReturnValue(blocks, MirBlockIdOf(4));
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 4
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 4
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 9
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(4)) == MirTermKind.Return
        && MirBlockBranchTarget(blocks, MirBlockIdOf(1)) == MirBlockIdOf(2)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(3)) == MirBlockIdOf(2)
        && MirOpcodeOf(instrs, counterPhi) == MirOp.Phi
        && MirOpcodeOf(instrs, accumulatorPhi) == MirOp.Phi
        && MirPhiIncomingBlock0(instrs, counterPhi) == MirBlockIdOf(1)
        && MirPhiIncomingBlock1(instrs, counterPhi) == MirBlockIdOf(3)
        && MirPhiIncomingBlock0(instrs, accumulatorPhi) == MirBlockIdOf(1)
        && MirPhiIncomingBlock1(instrs, accumulatorPhi) == MirBlockIdOf(3)
        && returned.Equals(accumulatorPhi)
        && MirOpcodeOf(instrs, MirValueIdOf(8)) == MirOp.Add
        && MirOperandAOf(instrs, MirValueIdOf(8)).Equals(accumulatorPhi)
        && MirOperandBOf(instrs, MirValueIdOf(8)).Equals(counterPhi)
        && MirOpcodeOf(instrs, MirValueIdOf(9)) == MirOp.Add
        && MirOperandAOf(instrs, MirValueIdOf(9)).Equals(counterPhi);
}

[Fact]
fn bool PackageTablesPreserveCountingForLoop()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Count() { var i = 0; for willexit (; i < 5; i += 1) { } return i }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId returned = MirBlockReturnValue(blocks, MirBlockIdOf(4));
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 4
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 4
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 6
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(4)) == MirTermKind.Return
        && MirBlockBranchTarget(blocks, MirBlockIdOf(1)) == MirBlockIdOf(2)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(3)) == MirBlockIdOf(2)
        && !MirBlockHasIndependentLoopBackedge(blocks, MirBlockIdOf(3))
        && MirOpcodeOf(instrs, returned) == MirOp.Phi
        && MirPhiIncomingBlock0(instrs, returned) == MirBlockIdOf(1)
        && MirPhiIncomingBlock1(instrs, returned) == MirBlockIdOf(3)
        && MirOpcodeOf(instrs, MirValueIdOf(6)) == MirOp.Add
        && MirOperandAOf(instrs, MirValueIdOf(6)).Equals(returned);
}

