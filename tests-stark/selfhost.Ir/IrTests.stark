    stack mut OwnedAscii structCaptureLastSink = new();
    return !CompileModuleFromAstChecked("fn i64[min max] classify(i32[min max][3] values) { switch (values) { case var captured: return 10; case [1, _, 3]: return 20; default: return 30; } } fn i64[min max] main() { stack i32[min max][3] values = { 1, 9, 3 }; return classify(values) }", listCaptureFirstSink)
        && !CompileModuleFromAstChecked("fn i64[min max] classify(i32[min max][3] values) { switch (values) { case [1, _, 3]: return 10; case var captured: return 20; default: return 30; } } fn i64[min max] main() { stack i32[min max][3] values = { 1, 9, 3 }; return classify(values) }", listCaptureLastSink)
        && !CompileModuleFromAstChecked("struct Box { i64[0 20] value; bool flag; } fn i64[min max] classify(Box box) { var score = 0; switch (box) { case var captured when true: score = 10; case Box(7, true): score = 20; default: score = 30; } return score }", structCaptureTrueSink)
        && !CompileModuleFromAstChecked("struct Box { i64[0 20] value; bool flag; } fn i64[min max] classify(Box box) { var score = 0; switch (box) { case Box(7, true): score = 10; case var captured: score = 20; default: score = 30; } return score }", structCaptureLastSink);
}

[Fact]
fn bool RejectsNestedAggregateAndListPatternOverlapFromAst()
{
    stack mut OwnedAscii nestedAggregateSink = new();
    stack mut OwnedAscii nestedListSink = new();
    stack mut OwnedAscii guardedNestedAggregateSink = new();
    return !CompileModuleFromAstChecked("struct Inner { i8[0 9] x; i8[0 9] y; } struct Box { Inner inner; bool flag; } fn i64[min max] classify(Box box) { switch (box) { case Box { inner: Inner { x: 1..4, y: _ }, flag: true }: return 10; case Box { inner: Inner { x: 3..5, y: _ }, flag: true }: return 20; default: return 30; } }", nestedAggregateSink)
        && !CompileModuleFromAstChecked("struct Box { i8[0 9][3] values; bool flag; } fn i64[min max] classify(Box box) { stack mut i64[min max] score = 0; switch (box) { case Box { values: [1..4, _, _], flag: true }: score = 10; case Box { values: [3..5, _, _], flag: true }: score = 20; default: score = 30; } return score; }", nestedListSink)
        && CompileModuleFromAstChecked("struct Inner { i8[0 9] x; i8[0 9] y; } struct Box { Inner inner; bool flag; } fn i64[min max] classify(Box box, bool gate) { switch (box) { case Box { inner: Inner { x: 1..4, y: _ }, flag: true } when gate: return 10; case Box { inner: Inner { x: 3..5, y: _ }, flag: true }: return 20; default: return 30; } }", guardedNestedAggregateSink);
}

