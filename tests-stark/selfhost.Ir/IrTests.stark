[Fact]
fn bool AsmSignatureMetadataSurvivesParserBridge()
{
    stack mut AsmMetadataTable table = new();
    stack mut AsmFunctionId asmId = new();
    stack bool ok = CollectFirstAsmFunctionMetadata(
        "module Test\ninternal unsafe ffi asm(x86_64) fn i64[min max] Syscall2(i64[min max] number, rawptr<i8[min max]> path) in(\"rax\") number, in(\"rdi\") path, out(\"rax\") return, clobber(\"rcx\", \"r11\") { \"syscall\" }",
        MirFuncIdOf(7),
        table,
        asmId);
    if (!ok)
    {
        return false;
    }

    stack AsmFunctionMetadata function = table.FunctionAt(asmId);
    stack MirFuncId mirFunction = function.Function();
    stack AsmInputOperand in0 = table.InputAt(function.FirstInput());
    stack AsmInputOperand in1 = table.InputAt(function.FirstInput() + 1);
    stack AsmOutputOperand out0 = table.OutputAt(function.FirstOutput());
    stack AsmTextRange clobber0 = table.ClobberAt(function.FirstClobber());
    stack AsmTextRange clobber1 = table.ClobberAt(function.FirstClobber() + 1);
    return asmId.Index() == 1
        && table.FunctionCount() == 1
        && table.InputCount() == 2
        && table.OutputCount() == 1
        && table.ClobberCount() == 2
        && mirFunction.Equals(MirFuncIdOf(7))
        && function.Architecture() == StarkAsmArchitecture.X86_64
        && function.InputCount() == 2
        && function.OutputCount() == 1
        && function.ClobberCount() == 2
        && table.TextRangeEquals(function.Template(), "syscall")
        && table.TextRangeEquals(in0.Register(), "rax")
        && table.TextRangeEquals(in0.Value(), "number")
        && table.TextRangeEquals(in1.Register(), "rdi")
        && table.TextRangeEquals(in1.Value(), "path")
        && out0.BindsReturn()
        && table.TextRangeEquals(out0.Register(), "rax")
        && table.TextRangeEquals(out0.Value(), "return")
        && table.TextRangeEquals(clobber0, "rcx")
        && table.TextRangeEquals(clobber1, "r11");
}

[Fact]
fn bool AsmMetadataBinaryRoundTrips()
{
    stack mut AsmMetadataTable table = new();
    stack mut AsmFunctionId asmId = new();
    if (!CollectFirstAsmFunctionMetadata(
        "module Test\ninternal unsafe ffi asm(aarch64) fn i64[min max] Syscall0(i64[min max] number) in(\"x8\") number, out(\"x0\") return { \"svc #0\" }",
        MirFuncIdOf(3),
        table,
        asmId))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> buf = new();
    SerializeAsmMetadata(table, buf);
    stack mut AsmMetadataTable restored = new();
    if (!DeserializeAsmMetadata(buf, restored))
    {
        return false;
    }

    stack AsmFunctionMetadata function = restored.FunctionAt(AsmFunctionIdOf(1));
    stack MirFuncId mirFunction = function.Function();
    stack AsmInputOperand input = restored.InputAt(function.FirstInput());
    stack AsmOutputOperand output = restored.OutputAt(function.FirstOutput());
    return restored.FunctionCount() == 1
        && restored.InputCount() == 1
        && restored.OutputCount() == 1
        && restored.ClobberCount() == 0
        && mirFunction.Equals(MirFuncIdOf(3))
        && function.Architecture() == StarkAsmArchitecture.AArch64
        && restored.TextRangeEquals(function.Template(), "svc #0")
        && restored.TextRangeEquals(input.Register(), "x8")
        && restored.TextRangeEquals(input.Value(), "number")
        && output.BindsReturn()
        && restored.TextRangeEquals(output.Register(), "x0")
        && restored.TextRangeEquals(output.Value(), "return");
}

[Fact]
fn bool PackageImageWithAsmRoundTripsMetadata()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId value = MirConstInt(instrs, 0);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId block = MirReturnBlock(blocks, value);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId functionId = MirDefineFunction(funcs, block, block, 1, value, 1);
    stack mut IrTable<MirGlobal> globals = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack mut AsmFunctionId asmId = new();
    if (!CollectFirstAsmFunctionMetadata(
        "module Test\ninternal unsafe ffi asm(riscv64) fn i64[min max] Ecall(i64[min max] number) in(\"a7\") number, out(\"a0\") return { \"ecall\" }",
        functionId,
        asmMetadata,
        asmId))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> buf = new();
    SerializePackageImageWithAsm(instrs, blocks, funcs, globals, asmMetadata, buf);
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack mut AsmMetadataTable restoredAsm = new();
    if (!DeserializePackageImageWithAsm(buf, bi, bb, bf, bg, restoredAsm))
    {
        return false;
    }

    stack mut OwnedAscii inspect = new();
    stack mut OwnedAscii inspectJson = new();
    switch (InspectPackageImage(buf, inspect))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
    }

    switch (InspectPackageImageJson(buf, inspectJson))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    stack AsmFunctionMetadata function = restoredAsm.FunctionAt(AsmFunctionIdOf(1));
    stack MirFuncId restoredFunction = function.Function();
    stack AsmInputOperand input = restoredAsm.InputAt(function.FirstInput());
    stack AsmOutputOperand output = restoredAsm.OutputAt(function.FirstOutput());
    return bi.Count() == 1
        && bb.Count() == 1
        && bf.Count() == 1
        && bg.Count() == 0
        && restoredAsm.FunctionCount() == 1
        && restoredFunction.Equals(functionId)
        && function.Architecture() == StarkAsmArchitecture.RiscV64
        && restoredAsm.TextRangeEquals(function.Template(), "ecall")
        && restoredAsm.TextRangeEquals(input.Register(), "a7")
        && restoredAsm.TextRangeEquals(output.Register(), "a0")
        && LlvmTextEquals(inspect, "package: 1 instructions, 1 blocks, 1 functions, 0 globals, 1 asm functions\n")
        && LlvmTextEquals(inspectJson, "{\"format\":\"MIR2\",\"instructions\":1,\"blocks\":1,\"functions\":1,\"globals\":0,\"asmFunctions\":1}\n");
}

[Fact]
fn bool SectionedPackageImageWithAsmRoundTripsMetadata()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId value = MirConstInt(instrs, 0);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId block = MirReturnBlock(blocks, value);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId functionId = MirDefineFunction(funcs, block, block, 1, value, 1);
    stack mut IrTable<MirGlobal> globals = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack mut AsmFunctionId asmId = new();
    if (!CollectFirstAsmFunctionMetadata(
        "module Test\ninternal unsafe ffi asm(x86_64) fn i64[min max] Syscall0() out(\"rax\") return, clobber(\"rcx\", \"r11\") { \"syscall\" }",
        functionId,
        asmMetadata,
        asmId))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> image = new();
    SerializeSectionedPackageImageWithAsm(instrs, blocks, funcs, globals, asmMetadata, image);

    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack mut AsmMetadataTable restoredAsm = new();
    if (!DeserializePackageImageWithAsm(image, bi, bb, bf, bg, restoredAsm))
    {
        return false;
    }

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    stack AsmFunctionMetadata function = restoredAsm.FunctionAt(AsmFunctionIdOf(1));
    stack MirFuncId restoredFunction = function.Function();
    stack AsmOutputOperand output = restoredAsm.OutputAt(function.FirstOutput());
    stack AsmTextRange clobber0 = restoredAsm.ClobberAt(function.FirstClobber());
    stack AsmTextRange clobber1 = restoredAsm.ClobberAt(function.FirstClobber() + 1);
    return PackageImageIsValid(image)
        && ReadU32(image, 13) == 5
        && bi.Count() == 1
        && bb.Count() == 1
        && bf.Count() == 1
        && bg.Count() == 0
        && restoredAsm.FunctionCount() == 1
        && restoredFunction.Equals(functionId)
        && function.Architecture() == StarkAsmArchitecture.X86_64
        && restoredAsm.TextRangeEquals(function.Template(), "syscall")
        && output.BindsReturn()
        && restoredAsm.TextRangeEquals(output.Register(), "rax")
        && restoredAsm.TextRangeEquals(clobber0, "rcx")
        && restoredAsm.TextRangeEquals(clobber1, "r11")
        && LlvmTextEquals(text, "package: STARKPKG, 1 instructions, 1 blocks, 1 functions, 0 globals, 1 asm functions\n")
        && LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"MIR2\",\"instructions\":1,\"blocks\":1,\"functions\":1,\"globals\":0,\"asmFunctions\":1}\n");
}

