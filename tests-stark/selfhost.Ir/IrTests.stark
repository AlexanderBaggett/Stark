        || enumMemberStart != 1
        || enumMemberCount != 3
        || enumNodes.Count() != 3
        || enumMembers.Count() != 3)
    {
        return false;
    }

    stack SourceSwitchPatternDecisionMember enumScalarMember = enumMembers.Get(1);
    stack SourceSwitchPatternDecisionMember enumCaptureMember = enumMembers.Get(2);
    stack SourceSwitchPatternDecisionMember enumNestedMember = enumMembers.Get(3);
    stack SourceSwitchPatternDecisionNode enumScalarNode = enumNodes.Get(enumScalarMember.NodeRow);
    stack SourceSwitchPatternDecisionNode enumCaptureNode = enumNodes.Get(enumCaptureMember.NodeRow);
    stack SourceSwitchPatternDecisionNode enumNestedNode = enumNodes.Get(enumNestedMember.NodeRow);

    return listScalarMember.Ordinal == 0
        && listScalarNode.Kind == SourceSwitchPatternDecisionKindScalarInterval()
        && listScalarNode.MinValue == 10
        && listScalarNode.MaxValue == 20
        && listCaptureMember.Ordinal == 1
        && listCaptureNode.Kind == SourceSwitchPatternDecisionKindCapture()
        && listCaptureNode.CaptureNameToken == 901
        && listNestedMember.Ordinal == 2
        && listNestedNode.Kind == SourceSwitchPatternDecisionKindAggregate()
        && listNestedNode.AggregateDescriptorRow == nestedAggregateDescriptorRow
        && enumScalarMember.Ordinal == 0
        && enumScalarNode.Kind == SourceSwitchPatternDecisionKindScalarInterval()
        && enumScalarNode.MinValue == -3
        && enumScalarNode.MaxValue == 3
        && enumCaptureMember.Ordinal == 1
        && enumCaptureNode.Kind == SourceSwitchPatternDecisionKindCapture()
        && enumCaptureNode.CaptureNameToken == 951
        && enumNestedMember.Ordinal == 2
        && enumNestedNode.Kind == SourceSwitchPatternDecisionKindList()
        && enumNestedNode.ListDescriptorRow == nestedListDescriptorRow;
}

[Fact]
fn bool SourceSwitchPatternDescriptorRowsMirrorCasePatternSpans()
{
    stack mut IrTable<u32[0 max]> starts = new();
    stack mut IrTable<u32[0 max]> counts = new();
    stack u32[0 max] firstStartRow = starts.Add(7);
    stack u32[0 max] firstCountRow = counts.Add(2);
    stack u32[0 max] secondStartRow = starts.Add(11);
    stack u32[0 max] secondCountRow = counts.Add(3);
    if (firstStartRow != firstCountRow || secondStartRow != secondCountRow)
    {
        return false;
    }

    stack mut ParamAbiFacts fixedArrayFacts = new();
    fixedArrayFacts.IsFixedArray = true;
    fixedArrayFacts.FixedArrayLength = 4;
    fixedArrayFacts.FixedArrayFieldTypeCode = SourceResolvedFieldTypeCodeI32();
    stack mut IrTable<SourceSwitchListPatternDescriptor> listDescriptors = new();
    stack mut IrTable<u32[0 max]> listRows = new();
    if (!TryBuildSourceSwitchListPatternCaseDescriptors(fixedArrayFacts, starts, counts, listDescriptors, listRows)
        || listRows.Count() != 2
        || listDescriptors.Count() != 2)
    {
        return false;
    }

    stack SourceSwitchListPatternDescriptor firstList = listDescriptors.Get(listRows.Get(1));
    stack SourceSwitchListPatternDescriptor secondList = listDescriptors.Get(listRows.Get(2));

    stack mut IrTable<SourceSwitchAggregatePatternDescriptor> aggregateDescriptors = new();
    stack mut IrTable<u32[0 max]> aggregateRows = new();
    if (!TryBuildSourceSwitchAggregatePatternCaseDescriptors(88, 3, starts, counts, aggregateDescriptors, aggregateRows)
        || aggregateRows.Count() != 2
        || aggregateDescriptors.Count() != 2
        || TryBuildSourceSwitchAggregatePatternCaseDescriptors(0, 0, starts, counts, aggregateDescriptors, aggregateRows))
    {
        return false;
    }

    stack SourceSwitchAggregatePatternDescriptor firstAggregate = aggregateDescriptors.Get(aggregateRows.Get(1));
    stack SourceSwitchAggregatePatternDescriptor secondAggregate = aggregateDescriptors.Get(aggregateRows.Get(2));

    return firstList.ElementTypeCode == SourceResolvedFieldTypeCodeI32()
        && firstList.FixedLength == 4
        && firstList.ElementPatternStart == 7
        && firstList.ElementPatternCount == 2
        && secondList.ElementPatternStart == 11
        && secondList.ElementPatternCount == 3
        && firstAggregate.OwnerTypeToken == 88
        && firstAggregate.EnumVariantOrdinalPlusOne == 3
        && firstAggregate.FieldPatternStart == 7
        && firstAggregate.FieldPatternCount == 2
        && secondAggregate.OwnerTypeToken == 88
        && secondAggregate.EnumVariantOrdinalPlusOne == 3
        && secondAggregate.FieldPatternStart == 11
        && secondAggregate.FieldPatternCount == 3;
}

[Fact]
fn bool SourceSwitchEnumAggregatePatternDescriptorRowsPreserveVariantFacts()
{
    stack mut TokenStream stream = new();
    stack mut TypedEnumLayoutTable layouts = new();
    if (!BuildTypedEnumLayoutsForSource("enum Packet { Empty, Other(i64[min max]), Move { X: i32[min max] } }", stream, layouts))
    {
        return false;
    }

    stack mut u64[0 max] emptyTag = 0;
    stack mut u64[0 max] otherTag = 0;
    if (!layouts.TryGetEnumVariantTag(0, 0, emptyTag)
        || !layouts.TryGetEnumVariantTag(0, 1, otherTag))
    {
        return false;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    moduleFacts.EnumLayouts = layouts;

    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<u32[0 max]> starts = new();
    stack mut IrTable<u32[0 max]> counts = new();
    stack mut IrTable<u32[0 max]> variantOrdinals = new();
    if (caseValues.Add((i64[min max])otherTag) == 0
        || starts.Add(1) == 0
        || counts.Add(1) == 0
        || variantOrdinals.Add(1) == 0
        || caseValues.Add((i64[min max])emptyTag) == 0
        || starts.Add(2) == 0
        || counts.Add(0) == 0)
    {
        return false;
    }

    stack mut IrTable<SourceSwitchAggregatePatternDescriptor> descriptors = new();
    stack mut IrTable<u32[0 max]> descriptorRows = new();
    if (!TryBuildSourceSwitchEnumAggregatePatternCaseDescriptors(
            moduleFacts,
            0,
            caseValues,
            starts,
            counts,
            variantOrdinals,
            descriptors,
            descriptorRows)
        || descriptors.Count() != 2
        || descriptorRows.Count() != 2)
    {
        return false;
    }

    stack SourceSwitchAggregatePatternDescriptor otherDescriptor = descriptors.Get(descriptorRows.Get(1));
    stack SourceSwitchAggregatePatternDescriptor emptyDescriptor = descriptors.Get(descriptorRows.Get(2));

    stack mut IrTable<u32[0 max]> mismatchedVariantOrdinals = new();
    if (mismatchedVariantOrdinals.Add(0) == 0
        || TryBuildSourceSwitchEnumAggregatePatternCaseDescriptors(
            moduleFacts,
            0,
            caseValues,
            starts,
            counts,
            mismatchedVariantOrdinals,
            descriptors,
            descriptorRows))
    {
        return false;
    }

    return otherDescriptor.OwnerTypeToken == 1
        && SourceSwitchAggregatePatternHasEnumVariant(otherDescriptor)
        && SourceSwitchAggregatePatternEnumVariantOrdinal(otherDescriptor) == 1
        && otherDescriptor.FieldPatternStart == 1
        && otherDescriptor.FieldPatternCount == 1
        && emptyDescriptor.OwnerTypeToken == 1
        && SourceSwitchAggregatePatternHasEnumVariant(emptyDescriptor)
        && SourceSwitchAggregatePatternEnumVariantOrdinal(emptyDescriptor) == 0
        && emptyDescriptor.FieldPatternStart == 2
        && emptyDescriptor.FieldPatternCount == 0;
}

[Fact]
fn bool SourceSwitchPatternDescriptorDisjointChecksUseShapeIdentity()
{
    stack mut IrTable<u32[0 max]> elementPatternIndices = new();
    stack mut IrTable<u32[0 max]> elementPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> elementPatternKinds = new();
