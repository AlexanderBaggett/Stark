        && extractBack.OperandAIndex() == inserted.Index()
        && extractBack.OperandBIndex() == 7
        && extractBack.OperandCIndex() == 2
        && extractBack.OperandDIndex() == 0;
}

[Fact]
fn bool BinaryRoundTripsEnumPointerMemoryInstructions()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 8, 8);
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(7), 2);
    stack MirValueId payload = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId inserted = MirEnumPayloadInsert(instrs, TypeIdOf(7), 2, 0, tagged, payload);
    stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(7), alloc, inserted, 8);
    stack MirValueId load = MirLoadEnumPtrAligned(instrs, TypeIdOf(7), alloc, 8);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 6, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction storeBack = back.Get(5);
    stack MirInstruction loadBack = back.Get(6);
    return back.Count() == 6
        && store.Index() == 5
        && load.Index() == 6
        && storeBack.Opcode() == MirOp.StoreEnumPtr
        && storeBack.ResultType() == MirType.EnumValue
        && storeBack.OperandAIndex() == alloc.Index()
        && storeBack.OperandBIndex() == inserted.Index()
        && storeBack.OperandCIndex() == 7
        && storeBack.OperandDIndex() == 8
        && loadBack.Opcode() == MirOp.LoadEnumPtr
        && loadBack.ResultType() == MirType.EnumValue
        && loadBack.OperandAIndex() == alloc.Index()
        && loadBack.OperandBIndex() == 7
        && loadBack.OperandCIndex() == 8;
}

[Fact]
fn bool BinaryRoundTripsDynamicPointerOffsetInstruction()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 64, 16);
    stack MirValueId index = MirParam(instrs, 0);
    stack MirValueId element = MirPtrIndexOffset(instrs, alloc, index, 4, 8, 4);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 3, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction elementBack = back.Get(3);
    return back.Count() == 3
        && element.Index() == 3
        && elementBack.Opcode() == MirOp.PtrIndexOffset
        && elementBack.ResultType() == MirType.Ptr
        && elementBack.OperandAIndex() == alloc.Index()
        && elementBack.OperandBIndex() == index.Index()
        && elementBack.OperandCIndex() == 4
        && elementBack.OperandDIndex() == 4
        && elementBack.Immediate() == 8;
}

[Fact]
fn bool BinaryRoundTripsArenaAllocInstruction()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId enter = MirArenaFrameEnter(instrs);
    stack MirValueId alloc = MirArenaAlloc(instrs, 64, 8);
    stack MirValueId leave = MirArenaFrameLeave(instrs);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 3, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction allocBack = back.Get(2);
    return back.Count() == 3
        && MirOpcodeOf(back, MirValueIdOf(1)) == MirOp.ArenaFrameEnter
        && MirOpcodeOf(back, MirValueIdOf(2)) == MirOp.ArenaAlloc
        && MirValueType(back, 2) == MirType.Ptr
        && allocBack.Immediate() == 64
        && allocBack.OperandAIndex() == 8
        && MirOpcodeOf(back, MirValueIdOf(3)) == MirOp.ArenaFrameLeave;
}

[Fact]
fn bool BinaryRoundTripsArenaDynamicInstructions()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId owner = MirArenaDynamicStorageInit(instrs, 4, 8, 16);
    stack MirValueId reserve = MirArenaDynamicStorageReserve(instrs, owner, 3, 8, 16);
    stack MirValueId tryReserve = MirArenaDynamicStorageTryReserve(instrs, owner, 5, 8, 16);
    stack MirValueId tryReserveCapacity = MirArenaDynamicStorageTryReserveCapacity(instrs, owner, 9, 8, 16);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 4, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction initBack = back.Get(1);
    stack MirInstruction reserveBack = back.Get(2);
    stack MirInstruction tryReserveBack = back.Get(3);
    stack MirInstruction tryReserveCapacityBack = back.Get(4);
    return back.Count() == 4
        && initBack.Opcode() == MirOp.ArenaDynamicStorageInit
        && initBack.Immediate() == 4
        && initBack.OperandAIndex() == 8
        && initBack.OperandBIndex() == 16
        && initBack.ResultType() == MirType.Ptr
        && reserveBack.Opcode() == MirOp.ArenaDynamicStorageReserve
        && reserveBack.OperandAIndex() == owner.Index()
        && reserveBack.Immediate() == 3
        && tryReserveBack.Opcode() == MirOp.ArenaDynamicStorageTryReserve
        && tryReserveBack.ResultType() == MirType.I1
        && tryReserveCapacityBack.Opcode() == MirOp.ArenaDynamicStorageTryReserveCapacity
        && tryReserveCapacityBack.Immediate() == 9
        && tryReserveCapacityBack.ResultType() == MirType.I1;
}

[Fact]
fn bool CompilesTwoArgumentCallFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn add(a, b) { return a + b } fn main() { return add(3, 4) }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1(i64 %p0, i64 %p1) {\nb1:\n  %v3 = add i64 %p0, %p1\n  ret i64 %v3\n}\ndefine internal dso_local i64 @f2() {\nb1:\n  %v1 = add i64 0, 3\n  %v2 = add i64 0, 4\n  %v3 = call i64 @f1(i64 range(i64 3, 4) %v1, i64 range(i64 4, 5) %v2)\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool CompilesThreeAndFourArgumentCallsFromAst()
{
    stack mut OwnedAscii three = new();
    stack bool threeOk = CompileModuleFromAst("fn add3(a, b, c) { return a + b + c } fn main() { return add3(1, 2, 3) }", three);
    stack mut OwnedAscii four = new();
    stack bool fourOk = CompileModuleFromAst("fn add4(a, b, c, d) { return a + b + c + d } fn main() { return add4(1, 2, 3, 4) }", four);
    stack mut OwnedAscii five = new();
    stack bool fiveOk = CompileModuleFromAst("fn add5(a, b, c, d, e) { return a + b + c + d + e } fn main() { return add5(1, 2, 3, 4, 5) }", five);
    return threeOk && ClangVerifiesLlvmText(three)
        && fourOk && ClangVerifiesLlvmText(four)
        && fiveOk
        && System.Text.Contains(five.View(), "call i64 @f1(i64 range(i64 1, 2) %v1, i64 range(i64 2, 3) %v2, i64 range(i64 3, 4) %v3, i64 range(i64 4, 5) %v4, i64 range(i64 5, 6) %v5)")
        && ClangVerifiesLlvmText(five);
}

[Fact]
fn bool BinaryRoundTripsWideArgumentCall()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a0 = MirConstInt(instrs, 10);
    stack MirValueId a1 = MirConstInt(instrs, 20);
    stack MirValueId a2 = MirConstInt(instrs, 30);
    stack MirValueId a3 = MirConstInt(instrs, 40);
    stack MirValueId a4 = MirConstInt(instrs, 50);
    stack mut IrTable<u32[0 max]> args = new();
    stack u32[0 max] added0 = args.Add(a0.Index());
    stack u32[0 max] added1 = args.Add(a1.Index());
    stack u32[0 max] added2 = args.Add(a2.Index());
    stack u32[0 max] added3 = args.Add(a3.Index());
    stack u32[0 max] added4 = args.Add(a4.Index());
    stack MirValueId call = MirCallFromArgumentValueIndexes(instrs, MirFuncIdOf(2), args);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, (u32[0 max])instrs.Count(), buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction callBack = back.Get(call.Index());
    stack mut OwnedAscii disasm = new();
    EmitMirInstructions(back, 1, (u32[0 max])back.Count(), disasm);
    return added0 == 1
        && added1 == 2
        && added2 == 3
        && added3 == 4
        && added4 == 5
        && MirOpcodeOf(back, call) == MirOp.CallWide
        && MirImmediateOf(back, call) == 2
        && MirCallArgumentValueIndexAt(back, callBack, 0) == 1
        && MirCallArgumentValueIndexAt(back, callBack, 4) == 5
        && System.Text.Contains(disasm.View(), "call f2(v1, v2, v3, v4, v5)");
}

[Fact]
fn bool BinaryRoundTripsFourArgumentCall()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a0 = MirConstInt(instrs, 10);
    stack MirValueId a1 = MirConstInt(instrs, 20);
    stack MirValueId a2 = MirConstInt(instrs, 30);
    stack MirValueId a3 = MirConstInt(instrs, 40);
    stack MirValueId call = MirCall4(instrs, MirFuncIdOf(2), a0, a1, a2, a3);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 5, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction callBack = back.Get(5);
    return back.Count() == 5
        && MirOpcodeOf(back, MirValueIdOf(5)) == MirOp.Call
        && MirImmediateOf(back, MirValueIdOf(5)) == 2
        && callBack.OperandAIndex() == 1
        && callBack.OperandBIndex() == 2
        && callBack.OperandCIndex() == 3
        && callBack.OperandDIndex() == 4;
}

[Fact]
fn bool BinaryRoundTripsFourArgumentTailCall()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a0 = MirConstInt(instrs, 10);
    stack MirValueId a1 = MirConstInt(instrs, 20);
    stack MirValueId a2 = MirConstInt(instrs, 30);
    stack MirValueId a3 = MirConstInt(instrs, 40);
    stack MirValueId call = MirTailCall4Typed(instrs, MirType.I32, MirFuncIdOf(2), a0, a1, a2, a3);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 5, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction callBack = back.Get(5);
    return back.Count() == 5
        && MirOpcodeOf(back, MirValueIdOf(5)) == MirOp.TailCall
        && MirValueType(back, 5) == MirType.I32
        && MirImmediateOf(back, MirValueIdOf(5)) == 2
        && callBack.OperandAIndex() == 1
        && callBack.OperandBIndex() == 2
        && callBack.OperandCIndex() == 3
        && callBack.OperandDIndex() == 4;
}

[Fact]
fn bool ModuleCallsAreArityAndTypeChecked()
{
    stack mut OwnedAscii s = new();
    return !CompileModuleFromAst("fn f(x) { return x } fn main() { return f(1 < 2) }", s)
        && !CompileModuleFromAst("fn k(a, b) { return a } fn main() { return k(1, 2 < 3) }", s)
        && !CompileModuleFromAst("fn g() { return 1 } fn main() { return g(5) }", s)
        && !CompileModuleFromAst("fn h(x) { return x } fn main() { return h() }", s)
        && !CompileModuleFromAst("fn p(a, b, c, d, e) { return a } fn main() { return p(1, 2, 3, 4, 5) }", s)
        && CompileModuleFromAst("fn f(x) { return x + 1 } fn main() { return f(7) }", s)
        && CompileModuleFromAst("fn k(x) { return x } fn main() { return k(k(2)) }", s);
}

[Fact]
fn bool CompilesModuleFromAstThroughCheckedPipeline()
{
    stack mut OwnedAscii checked = new();
    stack bool checkedOk = CompileModuleFromAstChecked("fn double(x) { return x + x } fn main() { return double(5) }", checked);
    stack mut OwnedAscii direct = new();
    stack bool directOk = CompileModuleFromAst("fn double(x) { return x + x } fn main() { return double(5) }", direct);
    stack mut OwnedAscii dup = new();
    stack mut OwnedAscii dupChecked = new();
    return checkedOk && directOk && OwnedAscii.Equals(checked, direct)
        && CompileModuleFromAst("fn f() { return 1 } fn f() { return 2 } fn main() { return 1 }", dup)
        && !CompileModuleFromAstChecked("fn f() { return 1 } fn f() { return 2 } fn main() { return 1 }", dupChecked);
}

[Fact]
fn bool CompilesModuleFunctionWithLocals()
{
    stack mut OwnedAscii s = new();
    return CompileModuleFromAst("fn f(x) { var y = x + 1; return y + x } fn main() { return f(3) }", s)
        && !CompileModuleFromAst("fn f(a) { var a = 1; return a } fn main() { return f(2) }", s)
        && !CompileModuleFromAst("fn f(x) { var y = z; return y } fn main() { return f(2) }", s);
}

[Fact]
fn bool ModuleFunctionBoundariesAndLocalTypesChecked()
{
    stack mut OwnedAscii s = new();
    return !CompileModuleFromAst("fn a() { } fn b() { return 1 }", s)
        && !CompileModuleFromAst("fn a(p) { } fn b(p) { return p }", s)
        && !CompileModuleFromAst("fn id(x) { return x } fn f(a, b) { var c = a < b; return id(c) }", s)
        && CompileModuleFromAst("fn id(x) { return x } fn f(a, b) { var c = a + b; return id(c) }", s)
        && CompileModuleFromAst("fn a() { return 1 } fn b() { return 2 }", s);
}

[Fact]
fn bool CompilesRecursiveFunctionFromAst()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn fact(n) { if n < 1 return 1 else return n * fact(n - 1) } fn main() { return fact(5) }", s);
    return ok && ClangVerifiesLlvmText(s);
}

[Fact]
fn bool CheckedRecursiveFunctionFromAstPreservesRecursionEffects()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAstChecked("fn fact(n) { if n < 1 return 1 else return n * fact(n - 1) } fn main() { return fact(5) }", s);
    stack ascii factHeader = System.Testing.LlvmDefinitionHeader(s.View(), "f1");
    return ok
        && System.Testing.Contains(factHeader, "define internal dso_local i64 @f1")
        && System.Testing.DoesNotContain(factHeader, "norecurse")
        && System.Text.Contains(s.View(), "call i64 @f1")
        && ClangVerifiesLlvmText(s);
}

[Fact]
fn bool CheckedMutualRecursiveFunctionsFromAstPreserveRecursionEffects()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAstChecked("fn even(n) { if n == 0 return 1 else return odd(n - 1) } fn odd(n) { if n == 0 return 0 else return even(n - 1) } fn main() { return even(4) }", s);
    stack ascii evenHeader = System.Testing.LlvmDefinitionHeader(s.View(), "f1");
    stack ascii oddHeader = System.Testing.LlvmDefinitionHeader(s.View(), "f2");
    return ok
        && System.Testing.DoesNotContain(evenHeader, "norecurse")
        && System.Testing.DoesNotContain(oddHeader, "norecurse")
        && System.Text.Contains(s.View(), "call i64 @f2")
        && System.Text.Contains(s.View(), "call i64 @f1")
        && ClangVerifiesLlvmText(s);
}

[Fact]
fn bool CheckedFiniteRecursiveFunctionFromAstIsRejected()
{
    stack mut OwnedAscii s = new();
    return !CompileModuleFromAstChecked("finite fn fact(n) { if n < 1 return 1 else return n * fact(n - 1) } fn main() { return fact(5) }", s);
}

[Fact]
fn bool CheckedMutualFiniteRecursiveFunctionsFromAstAreRejected()
{
    stack mut OwnedAscii s = new();
    return !CompileModuleFromAstChecked("finite fn even(n) { if n == 0 return 1 else return odd(n - 1) } finite fn odd(n) { if n == 0 return 0 else return even(n - 1) } fn main() { return even(4) }", s);
}

[Fact]
fn bool CheckedTailFiniteSelfRecursiveFunctionFromAstIsRejected()
{
    stack mut OwnedAscii s = new();
    return !CompileModuleFromAstChecked("tail finite fn count(n, acc) { if n == 0 return acc else become count(n - 1, acc + 1) } fn main() { return count(3, 0) }", s);
}

[Fact]
fn bool CompilesLocalPrefixedTerminalIfFromAst()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn pick(x) { var y = x + 1; if y < 10 return y else return x } fn main() { return pick(3) }", s);
    return ok
        && System.Text.Contains(s.View(), "define internal dso_local i64 @f1(i64 %p0)")
        && System.Text.Contains(s.View(), "br i1")
        && System.Text.Contains(s.View(), "label %b2, label %b3")
        && System.Text.Contains(s.View(), "ret i64 %p0")
        && System.Text.Contains(s.View(), "define internal dso_local i64 @f2()")
        && ClangVerifiesLlvmText(s);
}

