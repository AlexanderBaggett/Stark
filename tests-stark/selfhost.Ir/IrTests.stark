[Fact]
fn bool CompileFunctionDeadOnReturnRequiresExplicitPointerContract()
{
    stack mut OwnedAscii destroy = new();
    stack bool destroyOk = CompileFunctionToLlvm("fn i64 destroy(out i32 value) where dead_on_return(value) { return 1 }", destroy);
    stack mut OwnedAscii normalOut = new();
    stack bool normalOk = CompileFunctionToLlvm("fn i64 write(out i32 value) { return 1 }", normalOut);
    stack mut OwnedAscii scalar = new();
    stack mut OwnedAscii missing = new();
    return destroyOk
        && normalOk
        && LlvmTextEquals(destroy, "define i64 @main(ptr captures(none) writeonly writable initializes((0, 4)) dead_on_return %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n")
        && !System.Text.Contains(normalOut.View(), "dead_on_return")
        && !CompileFunctionToLlvm("fn i64 bad(i64 value) where dead_on_return(value) { return 1 }", scalar)
        && !CompileFunctionToLlvm("fn i64 bad(out i32 value) where dead_on_return(missing) { return 1 }", missing);
}

