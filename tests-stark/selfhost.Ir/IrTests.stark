[Fact]
fn bool RejectsStackObjectFieldInitializerUnknownAndForwardNames()
{
    stack mut OwnedAscii missing = new();
    stack mut OwnedAscii forward = new();
    stack mut OwnedAscii selfRead = new();
    return !CompileFunctionWithLocalsToLlvm("struct Box { i32 value; } fn i64 main() { stack Box box = new Box() { missing = 1 }; return 0 }", missing)
        && !CompileFunctionWithLocalsToLlvm("struct Box { i32 value; } fn i64 main() { stack Box box = new Box() { value = later }; var later = 1; return 0 }", forward)
        && !CompileFunctionWithLocalsToLlvm("struct Box { i64 value; } fn i64 main() { stack Box box = new Box() { value = box.value }; return 0 }", selfRead);
}

