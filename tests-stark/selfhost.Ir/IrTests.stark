    stack AsmInputOperand input = asmMetadata.InputAt(asmFunction.FirstInput());
    stack AsmOutputOperand output = asmMetadata.OutputAt(asmFunction.FirstOutput());
    return funcs.Count() == 2
        && globals.Count() == 0
        && asmMetadata.FunctionCount() == 1
        && asmMirFunction.Equals(MirFuncIdOf(1))
        && asmFunction.Architecture() == StarkAsmArchitecture.AArch64
        && asmMetadata.TextRangeEquals(asmFunction.Template(), "svc #0")
        && asmMetadata.TextRangeEquals(input.Register(), "x8")
        && asmMetadata.TextRangeEquals(output.Register(), "x0")
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 0
