                  ],
                  "TypeAliases": [
                    {
                      "TargetType": { "Kind": "integer" },
                      "GenericParameters": [ "AliasT" ]
                    }
                  ],
                  "Imports": [ {} ]
                },
                "CompilerFacts": {
                  "FunctionEffects": [
                    {
                      "QualifiedResolvedName": "Helper.Work",
                      "Kind": "finite",
                      "ReadsArgumentMemory": true,
                      "IsPure": false,
                      "NoSync": true,
                      "NoFree": true,
                      "NoUnwind": true,
                      "WillReturn": true,
                      "MustProgress": true,
                      "UseFastCallingConvention": true,
                      "IsFfi": false,
                      "IsHot": true,
                      "IsCold": false,
                      "InlinePreference": "inline",
                      "IsStrictFp": false
                    }
                  ],
                  "AbiFunctions": [],
                  "ConcreteLayouts": [],
                  "EnumLayouts": [],
                  "FunctionSemantics": [
                    {
                      "QualifiedResolvedName": "Helper.Work",
                      "DeclaredKind": "fn",
                      "EffectiveKind": "finite",
                      "CalledFunctions": [],
                      "Ownership": {
                        "OwnershipValid": true,
                        "ImplicitDrops": [],
                        "Moves": [],
                        "Events": [],
                        "Roots": []
                      }
                    }
                  ]
                },
                "GenericTemplates": {
                  "Functions": [
                    {
                      "QualifiedResolvedName": "Helper.Template#0",
                      "QualifiedName": "Helper.Template",
                      "OverloadKey": "()"
                    }
                  ]
                }
              }
            },
            { "ModuleName": "Demo", "ReExports": [], "Functions": [], "Types": [], "Globals": [] }
          ],
          "NativeDependencies": { "Libraries": [ "m" ] },
          "Target": {
            "Triple": "x86_64-unknown-linux-stark",
            "DataLayout": "e-p:64:64",
            "Cpu": "generic",
            "Features": [ "+sse2", "+popcnt" ],
            "RelocationModel": "static",
            "CodeModel": "small",
            "CDataModel": {
              "Kind": "linux",
              "CharIsSigned": false,
              "PointerBitWidth": 64,
              "LongBitWidth": 64,
              "SizeTBitWidth": 64,
              "PtrDiffTBitWidth": 64
            },
            "AggregateLayout": {
              "PointerSizeBytes": 8,
              "PointerAlignmentBytes": 8
            }
          },
          "BuildProfile": { "Name": "release" }
        }
        """;

    stack ascii mismatchedManifestJson = raw"""
        {
          "RootModule": "Demo",
          "LibraryFileName": "libDemo.a",
          "Modules": [
            { "ModuleName": "Demo", "ReExports": [], "Functions": [], "Types": [], "Globals": [] }
          ],
          "Target": {
            "Triple": "x86_64-unknown-linux-stark",
            "DataLayout": "e-p:64:64",
            "Cpu": "generic",
            "Features": [ "+popcnt", "+sse2" ],
            "RelocationModel": "static",
            "CodeModel": "small",
            "CDataModel": {
              "Kind": "linux",
              "CharIsSigned": false,
              "PointerBitWidth": 64,
              "LongBitWidth": 64,
              "SizeTBitWidth": 64,
              "PtrDiffTBitWidth": 64
            },
            "AggregateLayout": {
              "PointerSizeBytes": 8,
              "PointerAlignmentBytes": 8
            }
          },
          "BuildProfile": { "Name": "release" }
        }
        """;

    stack mut LogicalPackageManifestModel model = new();
    stack mut LogicalPackageManifestModel rejected = new();
    unsafe
    {
        if (!TryReadLogicalPackageManifestJsonModel(manifestJson, image, facts, model)
            || TryReadLogicalPackageManifestJsonModel(mismatchedManifestJson, image, facts, rejected))
        {
            return false;
        }

        stack LogicalPackageManifestSummary manifest = model.ManifestSummary();
        stack LogicalPackageManifestModuleSummary helper = model.ModuleSummaryAtOrdinal(0);
        stack LogicalPackageManifestModuleSummary root = model.ModuleSummaryAtOrdinal(1);
        stack LogicalPackageFunctionEffectRow helperEffect = model.ModuleFunctionEffectRowAt(0, 1);
        stack LogicalPackageFunctionTemplateRow helperTemplate =
            model.ModuleGenericTemplateFunctionTemplateRowAt(0, 1);
        // An explicit SourceSurface owns this family even when its arrays are
        // absent, so the legacy module arrays must not leak into the bridge graph.
        return manifest.ModuleCount() == 2
            && manifest.RootModuleOrdinal() == 1
            && manifest.HasNativeDependencies()
            && manifest.HasBuildProfile()
            && manifest.HasTarget()
            && manifest.HasCDataModel()
            && manifest.HasAggregateLayout()
            && model.ModuleCount() == 2
            && model.ModuleRowCount() == 2
            && model.ModuleGraphRowCount() == 2
            && model.RootModuleOrdinal() == 1
            && model.ContainsModuleOrdinal(0)
            && model.ContainsModuleOrdinal(1)
            && !model.ContainsModuleOrdinal(2)
            && helper.ModuleOrdinal() == 0
            && helper.ReExportCount() == 1
            && helper.FunctionCount() == 1
            && helper.TypeCount() == 2
            && helper.GlobalCount() == 1
            && helper.TypeAliasCount() == 1
            && helper.ImportCount() == 1
            && helper.HasTypedInterface()
            && helper.TypedInterfaceFunctionCount() == 2
            && helper.TypedInterfaceTypeCount() == 1
            && helper.TypedInterfaceGlobalCount() == 1
            && helper.TypedInterfaceTypeAliasCount() == 1
            && helper.TypedInterfaceImportCount() == 1
            && helper.HasCompilerFacts()
            && helper.HasGenericTemplates()
            && helper.HasSourceSurface()
            && helper.HasCompilerSections()
            && helper.UsesCompilerSectionsTypedInterface()
            && root.ModuleOrdinal() == 1
            && root.ReExportCount() == 0
            && root.FunctionCount() == 0
            && root.TypeCount() == 0
            && root.GlobalCount() == 0
            && root.TypeAliasCount() == 0
            && root.ImportCount() == 0
            && !root.HasTypedInterface()
            && !root.HasCompilerFacts()
            && !root.HasGenericTemplates()
            && !root.HasSourceSurface()
            && !root.HasCompilerSections()
            && model.ModuleGraphOrdinal(0) == 0
            && model.ModuleHasTypedTypeAliasFacts(0)
            && model.ModuleHasTypedCallableFacts(0)
            && model.ModuleHasTypedGlobalFacts(0)
            && model.ModuleHasTypedTypeFacts(0)
            && model.ModuleHasFunctionEffectFacts(0)
            && model.ModuleHasGenericTemplateFacts(0)
            && model.ModuleHasAbiFacts(0)
            && model.ModuleHasLayoutFacts(0)
            && model.ModuleHasNativeMetadataFacts(0)
            && model.ModuleHasFunctionSemanticFacts(0)
            && model.ModuleHasFunctionOwnershipFacts(0)
            && model.ModuleHasSourceSurfaceBridgeFacts(0)
            && model.ModuleTypedTypeAliasRowCount(0) == 1
            && model.ModuleTypedTypeAliasTypeReferenceCount(0) == 1
            && model.ModuleTypedCallableGenericParameterRowCount(0) == 3
            && model.ModuleTypedCallableImportRowCount(0) == 2
            && model.ModuleTypedGlobalRowCount(0) == 1
            && model.ModuleTypedGlobalTypeReferenceCount(0) == 1
            && model.ModuleTypedTypeRowCount(0) == 1
            && model.ModuleTypedTypeEnumVariantRowCount(0) == 0
            && model.ModuleSourceSurfaceImportRowCount(0) == 0
            && model.ModuleSourceSurfaceTypeAliasRowCount(0) == 0
            && model.ModuleSourceSurfaceTypeAliasGenericParameterRowCount(0) == 0
            && model.ModuleSourceSurfaceTypeRowCount(0) == 0
            && model.ModuleSourceSurfaceTypeFieldRowCount(0) == 0
            && model.ModuleSourceSurfaceTypePrimaryConstructorParameterRowCount(0) == 0
            && model.ModuleSourceSurfaceTypeEnumVariantRowCount(0) == 0
            && model.ModuleSourceSurfaceTypeEnumVariantPayloadRowCount(0) == 0
            && model.ModuleSourceSurfaceGlobalRowCount(0) == 0
            && model.ModuleSourceSurfaceFunctionRowCount(0) == 0
            && model.ModuleSourceSurfaceFunctionParameterRowCount(0) == 0
            && model.ModuleFunctionEffectRowCount(0) == 1
            && model.ModuleGenericTemplateFunctionTemplateRowCount(0) == 1
            && model.ModuleAbiFunctionRowCount(0) == 0
            && model.ModuleLayoutConcreteLayoutRowCount(0) == 0
            && model.ModuleLayoutEnumLayoutRowCount(0) == 0
            && model.ModuleNativeDependencyRowCount(0) == 1
            && model.ModuleNativeLinkageRowCount(0) == 0
            && model.ModuleFunctionSemanticRowCount(0) == 1
            && model.ModuleFunctionOwnershipRowCount(0) == 1
            && helperEffect.ModuleOrdinal() == 0
            && helperEffect.FunctionEffectOrdinal() == 0
            && helperEffect.ReadsArgumentMemory()
            && helperEffect.NoSync()
            && helperEffect.NoFree()
            && helperEffect.NoUnwind()
            && helperEffect.WillReturn()
            && helperEffect.MustProgress()
            && helperEffect.UsesFastCallingConvention()
            && helperEffect.IsHot()
            && !helperEffect.IsCold()
            && helperTemplate.ModuleOrdinal() == 0
            && helperTemplate.TemplateOrdinal() == 0
            && model.ModuleGraphOrdinal(1) == 1
            && !model.ModuleHasTypedTypeAliasFacts(1)
            && !model.ModuleHasTypedCallableFacts(1)
            && !model.ModuleHasTypedGlobalFacts(1)
            && !model.ModuleHasTypedTypeFacts(1)
            && !model.ModuleHasFunctionEffectFacts(1)
            && !model.ModuleHasGenericTemplateFacts(1)
            && !model.ModuleHasAbiFacts(1)
            && !model.ModuleHasLayoutFacts(1)
            && !model.ModuleHasNativeMetadataFacts(1)
            && !model.ModuleHasFunctionSemanticFacts(1)
            && !model.ModuleHasFunctionOwnershipFacts(1)
            && !model.ModuleHasSourceSurfaceBridgeFacts(1)
            && model.ModuleTypedTypeAliasRowCount(1) == 0
            && model.ModuleTypedTypeAliasTypeReferenceCount(1) == 0
            && model.ModuleTypedCallableGenericParameterRowCount(1) == 0
            && model.ModuleTypedCallableImportRowCount(1) == 0
            && model.ModuleTypedGlobalRowCount(1) == 0
            && model.ModuleTypedGlobalTypeReferenceCount(1) == 0
            && model.ModuleTypedTypeRowCount(1) == 0
            && model.ModuleTypedTypeEnumVariantRowCount(1) == 0
            && model.ModuleSourceSurfaceImportRowCount(1) == 0
            && model.ModuleSourceSurfaceTypeAliasRowCount(1) == 0
            && model.ModuleSourceSurfaceTypeAliasGenericParameterRowCount(1) == 0
            && model.ModuleSourceSurfaceTypeRowCount(1) == 0
            && model.ModuleSourceSurfaceTypeFieldRowCount(1) == 0
            && model.ModuleSourceSurfaceTypePrimaryConstructorParameterRowCount(1) == 0
            && model.ModuleSourceSurfaceTypeEnumVariantRowCount(1) == 0
            && model.ModuleSourceSurfaceTypeEnumVariantPayloadRowCount(1) == 0
            && model.ModuleSourceSurfaceGlobalRowCount(1) == 0
            && model.ModuleSourceSurfaceFunctionRowCount(1) == 0
            && model.ModuleSourceSurfaceFunctionParameterRowCount(1) == 0
            && model.ModuleFunctionEffectRowCount(1) == 0
            && model.ModuleGenericTemplateFunctionTemplateRowCount(1) == 0
            && model.ModuleAbiFunctionRowCount(1) == 0
            && model.ModuleLayoutConcreteLayoutRowCount(1) == 0
