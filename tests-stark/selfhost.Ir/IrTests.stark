[Fact]
fn bool LocalPrefixedTerminalIfPreservesDeclaredI8ReturnType()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn i8[min max] pick(i64[min max] x) { var y = x + 1; if y < 10 return 7 else return 11 } fn main() { return 0 }", s);
    return ok
        && System.Text.Contains(s.View(), "define internal dso_local i8 @f1(i64 %p0)")
        && System.Text.Contains(s.View(), "add i8 0, 7")
        && System.Text.Contains(s.View(), "add i8 0, 11")
        && System.Text.Contains(s.View(), "ret i8")
        && !System.Text.Contains(s.View(), "add i64 0, 7")
        && !System.Text.Contains(s.View(), "add i64 0, 11")
        && ClangVerifiesLlvmText(s);
}

[Fact]
fn bool PackageTablesPreserveLocalPrefixedTerminalIf()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Pick(i64[min max] x) { var y = x + 1; if y < 10 return y else return x }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 3
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 3
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 4
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.Return
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.Return;
}

