[Collection("ir")]
module IrTests

[Fact]
fn bool TypedHandleRoundTripsIndex()
{
    // A handle wraps its 1-based index and reads it back; a non-zero index is valid.
    stack TypeId id = TypeIdOf(5);
    return id.Index() == 5 && id.IsValid();
}

[Fact]
fn bool DefaultHandleIsInvalidZero()
{
    // A default-constructed handle is the invalid sentinel (index 0), as is `Of(0)`.
    stack mut TypeId fresh = new();
    return fresh.Index() == 0
        && !fresh.IsValid()
        && !TypeIdOf(0).IsValid();
}

[Fact]
fn bool SsaValueFactTransferAndImportsPreserveEveryBackendFactFamily()
{
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts generated = new();
    generated.SetAlignment(16);
    generated.SetCallingAbi(AbiKind.CAbi);
    generated.MarkNoAlias();
    generated.MarkVolatile();
    generated.SetIntegerRange(4, 29);
    generated.MarkKnownNonNull();
    generated.SetTextConstant(7, 11, 13, 9, 2);

    stack mut IrTable<ValueFacts> importedFacts = new();
    if (importedFacts.Add(generated) == 0
        || !RecordGeneratedValueFactsForSsaValue(facts, SsaValueIdOf(2), generated)
        || !PreserveValueFactsForSsaValue(facts, SsaValueIdOf(3), SsaValueIdOf(2))
        || !RecomputeValueFactsForSsaValue(facts, SsaValueIdOf(4))
        || !ImportParameterValueFactsForSsaValue(facts, SsaValueIdOf(5), importedFacts, 0)
        || !ImportGlobalValueFactsForSsaValue(facts, SsaValueIdOf(6), importedFacts, 1)
        || !ImportFunctionReturnValueFactsForSsaValue(
            facts,
            SsaValueIdOf(7),
            importedFacts,
            MirFuncIdOf(1))
        || !RecordEmptyValueFactsForSsaValue(facts, SsaValueIdOf(8))
        || RecordGeneratedValueFactsForSsaValue(facts, SsaValueIdOf(3), generated))
    {
        return false;
    }

    stack ValueFacts preserved = ValueFactsForSsaValue(facts, SsaValueIdOf(3));
    stack ValueFacts recomputed = ValueFactsForSsaValue(facts, SsaValueIdOf(4));
    return facts.Count() == 8
        && !ValueFactsForSsaValue(facts, SsaValueIdOf(1)).HasAlignment()
        && preserved.HasAlignment()
        && preserved.AlignmentBytes() == 16
        && preserved.HasCallingAbi()
        && preserved.CallingAbi() == AbiKind.CAbi
        && preserved.HasNoAlias()
        && preserved.Volatile()
        && preserved.HasIntegerRange()
        && preserved.IntegerRangeLower() == 4
        && preserved.IntegerRangeUpperExclusive() == 29
        && preserved.KnownNonNull()
        && preserved.HasTextConstant()
        && preserved.TextConstantRowIndex() == 7
        && preserved.TextConstantPayloadStart() == 11
        && preserved.TextConstantPayloadByteLength() == 13
        && preserved.TextConstantCodePointLength() == 9
        && preserved.TextConstantStorageEncodingCode() == 2
        && !recomputed.HasAlignment()
        && !recomputed.HasCallingAbi()
        && !recomputed.HasNoAlias()
        && !recomputed.Volatile()
        && !recomputed.HasIntegerRange()
        && !recomputed.HasNullability()
        && !recomputed.HasTextConstant()
        && ValueFactsForSsaValue(facts, SsaValueIdOf(5)).HasTextConstant()
        && ValueFactsForSsaValue(facts, SsaValueIdOf(6)).HasNoAlias()
        && ValueFactsForSsaValue(facts, SsaValueIdOf(7)).HasCallingAbi()
        && !ValueFactsForSsaValue(facts, SsaValueIdOf(8)).HasAlignment();
}

[Fact]
fn bool HandleEqualityComparesIndex()
{
    // Equality is by index; distinct indices are unequal.
    return MirValueIdOf(3).Equals(MirValueIdOf(3))
        && !MirValueIdOf(3).Equals(MirValueIdOf(4));
}

[Fact]
fn bool DistinctHandleKindsAreSeparateTypes()
{
    // The id kinds are distinct value types over the same index space — a SymbolId
    // and a TypeId built from the same index are independent values (the compiler
    // rejects passing one where the other is expected; here we just confirm both
    // round-trip their index).
    stack SymbolId sym = SymbolIdOf(7);
    stack TypeId ty = TypeIdOf(7);
    return sym.Index() == 7 && ty.Index() == 7;
}

[Fact]
fn bool IrTableAddsRowsWithOneBasedIndices()
{
    // The first row gets index 1 (0 stays the invalid sentinel), the second index 2,
    // and `Count` tracks the row total.
    stack mut IrTable<MirValueId> table = new();
    stack u32[0 max] first = table.Add(MirValueIdOf(100));
    stack u32[0 max] second = table.Add(MirValueIdOf(200));
    return first == 1 && second == 2 && table.Count() == 2;
}

[Fact]
fn bool IrTableGetReadsBackTheStoredRow()
{
    // A row read back at its index equals what was added.
    stack mut IrTable<MirValueId> table = new();
    stack u32[0 max] idx = table.Add(MirValueIdOf(42));
    stack MirValueId row = table.Get(idx);
    return table.Contains(idx) && row.Index() == 42;
}

[Fact]
fn bool IrTableContainsRejectsZeroAndOutOfRange()
{
    // Index 0 (invalid) and indices past the end are not contained.
    stack mut IrTable<TypeId> table = new();
    stack u32[0 max] idx = table.Add(TypeIdOf(1));
    return !table.Contains(0)
        && table.Contains(1)
        && !table.Contains(2);
}

[Fact]
fn bool TypedSwitchAggregateAndListPatternRowsPreserveDescriptorFacts()
{
    stack mut TypedSwitchAggregatePatternTable aggregates = new();
    stack mut u32[0 max] aggregateRow = 0;
    if (aggregates.Append(10, 20, 30, 31, 29, 32, 4, 41, 5, 2, aggregateRow) != System.Memory.MemoryStatus.Ok)
    {
        return false;
    }

    stack mut TypedSwitchListPatternTable lists = new();
    stack mut u32[0 max] listRow = 0;
    if (lists.Append(50, 60, 70, 71, 69, 72, 80, 81, 79, 82, true, 3, 7, 3, listRow) != System.Memory.MemoryStatus.Ok)
    {
        return false;
    }

    return aggregateRow == 1
        && aggregates.Count() == 1
        && aggregates.ContainsRow(aggregateRow)
        && !aggregates.ContainsRow(0)
        && aggregates.PatternStartTokenAt(0) == 10
        && aggregates.PatternEndTokenAt(0) == 20
        && aggregates.OwnerTypeHeadTokenAt(0) == 30
        && aggregates.OwnerTypePrimaryTokenAt(0) == 31
        && aggregates.OwnerTypeStartTokenAt(0) == 29
        && aggregates.OwnerTypeEndTokenAt(0) == 32
        && aggregates.HasEnumVariantAt(0)
        && aggregates.EnumVariantOrdinalAt(0) == 3
        && aggregates.WholeCaptureNameTokenAt(0) == 41
        && aggregates.MemberPatternStartAt(0) == 5
        && aggregates.MemberPatternCountAt(0) == 2
        && listRow == 1
        && lists.Count() == 1
        && lists.ContainsRow(listRow)
        && !lists.ContainsRow(2)
        && lists.PatternStartTokenAt(0) == 50
        && lists.PatternEndTokenAt(0) == 60
        && lists.ListTypeHeadTokenAt(0) == 70
        && lists.ListTypePrimaryTokenAt(0) == 71
        && lists.ListTypeStartTokenAt(0) == 69
        && lists.ListTypeEndTokenAt(0) == 72
        && lists.ElementTypeHeadTokenAt(0) == 80
        && lists.ElementTypePrimaryTokenAt(0) == 81
        && lists.ElementTypeStartTokenAt(0) == 79
        && lists.ElementTypeEndTokenAt(0) == 82
        && lists.HasFixedLengthAt(0)
        && lists.FixedLengthAt(0) == 3
        && lists.ElementPatternStartAt(0) == 7
        && lists.ElementPatternCountAt(0) == 3;
}

[Fact]
fn bool TypedSwitchPatternMemberRowsPreserveScalarCaptureAndNestedFacts()
{
    stack mut TypedSwitchPatternMemberTable members = new();
    stack mut u32[0 max] literalRow = 0;
    stack mut u32[0 max] rangeRow = 0;
    stack mut u32[0 max] captureRow = 0;
    stack mut u32[0 max] nestedAggregateRow = 0;
    stack mut u32[0 max] nestedListRow = 0;
    if (members.Append(0, TypedSwitchPatternKind.Literal, 100, 101, 200, 201, 199, 202, 301, 0, 0, 0, 0, 0, literalRow) != System.Memory.MemoryStatus.Ok
        || members.Append(1, TypedSwitchPatternKind.Range, 110, 111, 210, 211, 209, 212, 0, 401, 402, 0, 0, 0, rangeRow) != System.Memory.MemoryStatus.Ok
        || members.Append(2, TypedSwitchPatternKind.Capture, 120, 121, 220, 221, 219, 222, 0, 0, 0, 501, 0, 0, captureRow) != System.Memory.MemoryStatus.Ok
        || members.Append(3, TypedSwitchPatternKind.Aggregate, 130, 131, 230, 231, 229, 232, 0, 0, 0, 0, 7, 0, nestedAggregateRow) != System.Memory.MemoryStatus.Ok
        || members.Append(4, TypedSwitchPatternKind.List, 140, 141, 240, 241, 239, 242, 0, 0, 0, 0, 0, 9, nestedListRow) != System.Memory.MemoryStatus.Ok)
    {
        return false;
    }

    return literalRow == 1
        && rangeRow == 2
        && captureRow == 3
        && nestedAggregateRow == 4
        && nestedListRow == 5
        && members.Count() == 5
        && members.ContainsRow(5)
        && !members.ContainsRow(6)
        && TypedSwitchPatternKindIsKnown(members.KindAt(0))
        && TypedSwitchPatternKindIsNestedShape(members.KindAt(3))
        && TypedSwitchPatternKindIsNestedShape(members.KindAt(4))
        && members.MemberOrdinalAt(0) == 0
        && members.KindAt(0) == TypedSwitchPatternKind.Literal
        && members.PatternStartTokenAt(0) == 100
        && members.PatternEndTokenAt(0) == 101
        && members.TypeHeadTokenAt(0) == 200
        && members.TypePrimaryTokenAt(0) == 201
        && members.TypeStartTokenAt(0) == 199
        && members.TypeEndTokenAt(0) == 202
        && members.LiteralTokenAt(0) == 301
        && members.MemberOrdinalAt(1) == 1
        && members.KindAt(1) == TypedSwitchPatternKind.Range
        && members.RangeStartTokenAt(1) == 401
        && members.RangeEndTokenAt(1) == 402
        && members.MemberOrdinalAt(2) == 2
        && members.KindAt(2) == TypedSwitchPatternKind.Capture
        && members.CaptureNameTokenAt(2) == 501
        && members.MemberOrdinalAt(3) == 3
        && members.KindAt(3) == TypedSwitchPatternKind.Aggregate
        && members.NestedAggregatePatternRowAt(3) == 7
        && members.MemberOrdinalAt(4) == 4
        && members.KindAt(4) == TypedSwitchPatternKind.List
        && members.NestedListPatternRowAt(4) == 9;
}

[Fact]
fn bool TypedSwitchAggregatePatternRowsBuildForTopLevelSwitchLabels()
{
    stack ascii source = raw"""
    struct Box
    {
        i32[min max] Value;
        bool Flag;
    }

    enum Packet
    {
        Empty,
        Pair(i32[min max], bool),
    }

    fn i32[min max] Classify(Box box, Packet packet)
    {
        switch (box)
        {
            case Box { Value: 7, Flag: true }:
                return 10;
            case Box(8, false):
                return 20;
            default:
                return 30;
        }

        switch (packet)
        {
            case Packet.Pair(1, true):
                return 40;
            default:
                return 50;
        }
    }
    """;

    stack mut TokenStream stream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            stream = lexed;
    }

    stack mut DeclarationList declarations = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDeclarations):
            declarations = parsedDeclarations;
    }

    stack mut TypedSwitchAggregatePatternTable rows = new();
    switch (BuildTypedSwitchAggregatePatterns(source, stream, declarations))
    {
        case ParseResult<TypedSwitchAggregatePatternTable>.Err(var patternError):
            return false;
        case ParseResult<TypedSwitchAggregatePatternTable>.Ok(var builtRows):
            rows = builtRows;
    }

    if (rows.Count() != 3)
    {
        return false;
    }

    stack ascii firstOwner = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])rows.OwnerTypeHeadTokenAt(0));
    stack ascii firstPattern = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])rows.PatternStartTokenAt(0));
    stack ascii secondOwner = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])rows.OwnerTypeHeadTokenAt(1));
    stack ascii secondPattern = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])rows.PatternStartTokenAt(1));
    stack ascii thirdOwner = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])rows.OwnerTypeHeadTokenAt(2));
    stack ascii thirdPattern = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])rows.PatternStartTokenAt(2));

    return System.Text.Equals(firstOwner, "Box")
        && System.Text.Equals(firstPattern, "Box")
        && System.Text.Equals(secondOwner, "Box")
        && System.Text.Equals(secondPattern, "Box")
        && System.Text.Equals(thirdOwner, "Packet")
        && System.Text.Equals(thirdPattern, "Packet")
        && rows.OwnerTypePrimaryTokenAt(0) == rows.OwnerTypeHeadTokenAt(0)
        && rows.OwnerTypeStartTokenAt(0) != 0
        && rows.OwnerTypeEndTokenAt(0) > rows.OwnerTypeStartTokenAt(0)
        && rows.MemberPatternStartAt(0) == 1
        && rows.MemberPatternCountAt(0) == 2
        && !rows.HasEnumVariantAt(0)
        && !rows.HasEnumVariantAt(1)
        && rows.MemberPatternStartAt(1) == 3
        && rows.MemberPatternCountAt(1) == 2
        && rows.HasEnumVariantAt(2)
        && rows.EnumVariantOrdinalAt(2) == 1
        && rows.MemberPatternStartAt(2) == 5
        && rows.MemberPatternCountAt(2) == 2;
}

[Fact]
fn bool TypedSwitchPatternTablesBuildNestedAggregateMemberRows()
{
    stack ascii source = raw"""
    struct Point
    {
        i32[min max] X;
        i32[min max] Y;
    }

    struct Box
    {
        Point Position;
        i32[min max] Label;
    }

    fn i32[min max] Classify(Box box)
    {
        switch (box)
        {
            case Box { Position: Point { X: 1, Y: 2 }, Label: var label }:
                return label;
            case Box(Point(3, 4), 9):
                return 9;
            default:
                return 0;
        }
    }
    """;

    stack mut TokenStream stream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            stream = lexed;
    }

    stack mut DeclarationList declarations = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDeclarations):
            declarations = parsedDeclarations;
    }

    stack mut TypedSwitchPatternTables tables = new();
    switch (BuildTypedSwitchPatternTables(source, stream, declarations))
    {
        case ParseResult<TypedSwitchPatternTables>.Err(var patternError):
            return false;
        case ParseResult<TypedSwitchPatternTables>.Ok(var builtTables):
            tables = builtTables;
    }

    if (tables.AggregatePatterns.Count() != 4 || tables.Members.Count() != 8)
    {
        return false;
    }

    stack ascii firstMemberType = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tables.Members.TypeHeadTokenAt(0));
    stack ascii captureName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tables.Members.CaptureNameTokenAt(1));

    return tables.AggregatePatterns.MemberPatternStartAt(0) == 1
        && tables.AggregatePatterns.MemberPatternCountAt(0) == 2
        && tables.AggregatePatterns.MemberPatternStartAt(1) == 3
        && tables.AggregatePatterns.MemberPatternCountAt(1) == 2
        && tables.AggregatePatterns.MemberPatternStartAt(2) == 5
        && tables.AggregatePatterns.MemberPatternCountAt(2) == 2
        && tables.AggregatePatterns.MemberPatternStartAt(3) == 7
        && tables.AggregatePatterns.MemberPatternCountAt(3) == 2
        && tables.Members.MemberOrdinalAt(0) == 0
        && tables.Members.KindAt(0) == TypedSwitchPatternKind.Aggregate
        && tables.Members.NestedAggregatePatternRowAt(0) == 2
        && System.Text.Equals(firstMemberType, "Point")
        && tables.Members.MemberOrdinalAt(1) == 1
        && tables.Members.KindAt(1) == TypedSwitchPatternKind.Capture
        && System.Text.Equals(captureName, "label")
        && tables.Members.MemberOrdinalAt(2) == 0
        && tables.Members.KindAt(2) == TypedSwitchPatternKind.Literal
        && tables.Members.MemberOrdinalAt(3) == 1
        && tables.Members.KindAt(3) == TypedSwitchPatternKind.Literal
        && tables.Members.MemberOrdinalAt(4) == 0
        && tables.Members.KindAt(4) == TypedSwitchPatternKind.Aggregate
        && tables.Members.NestedAggregatePatternRowAt(4) == 4
        && tables.Members.MemberOrdinalAt(5) == 1
        && tables.Members.KindAt(5) == TypedSwitchPatternKind.Literal
        && tables.Members.MemberOrdinalAt(6) == 0
        && tables.Members.KindAt(6) == TypedSwitchPatternKind.Literal
        && tables.Members.MemberOrdinalAt(7) == 1
        && tables.Members.KindAt(7) == TypedSwitchPatternKind.Literal;
}

[Fact]
fn bool TypedSwitchPatternTablesBuildNestedListElementRows()
{
    stack ascii source = raw"""
    struct Box
    {
        i32[min max][2] Values;
    }

    fn i32[min max] Classify(Box box)
    {
        switch (box)
        {
            case Box { Values: [1, var second] }:
                return second;
            case Box([3, 4]):
                return 4;
            default:
                return 0;
        }
    }
    """;

    stack mut TokenStream stream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            stream = lexed;
    }

    stack mut DeclarationList declarations = new();
    switch (ParseDeclarations(stream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDeclarations):
            declarations = parsedDeclarations;
    }

    stack mut TypedSwitchPatternTables tables = new();
    switch (BuildTypedSwitchPatternTables(source, stream, declarations))
    {
        case ParseResult<TypedSwitchPatternTables>.Err(var patternError):
            return false;
        case ParseResult<TypedSwitchPatternTables>.Ok(var builtTables):
            tables = builtTables;
    }

    if (tables.AggregatePatterns.Count() != 2
        || tables.ListPatterns.Count() != 2
        || tables.Members.Count() != 6)
    {
        return false;
    }

    stack ascii firstElementType = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tables.Members.TypeHeadTokenAt(2));
    stack ascii captureName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])tables.Members.CaptureNameTokenAt(3));

    return tables.AggregatePatterns.MemberPatternStartAt(0) == 1
        && tables.AggregatePatterns.MemberPatternCountAt(0) == 1
        && tables.AggregatePatterns.MemberPatternStartAt(1) == 2
        && tables.AggregatePatterns.MemberPatternCountAt(1) == 1
        && tables.Members.MemberOrdinalAt(0) == 0
        && tables.Members.KindAt(0) == TypedSwitchPatternKind.List
        && tables.Members.NestedListPatternRowAt(0) == 1
        && tables.Members.MemberOrdinalAt(1) == 0
        && tables.Members.KindAt(1) == TypedSwitchPatternKind.List
        && tables.Members.NestedListPatternRowAt(1) == 2
        && tables.ListPatterns.ElementPatternStartAt(0) == 3
        && tables.ListPatterns.ElementPatternCountAt(0) == 2
        && tables.ListPatterns.HasFixedLengthAt(0)
        && tables.ListPatterns.FixedLengthAt(0) == 2
        && tables.ListPatterns.ElementPatternStartAt(1) == 5
        && tables.ListPatterns.ElementPatternCountAt(1) == 2
        && tables.ListPatterns.HasFixedLengthAt(1)
        && tables.ListPatterns.FixedLengthAt(1) == 2
        && System.Text.Equals(firstElementType, "i32")
        && tables.Members.MemberOrdinalAt(2) == 0
        && tables.Members.KindAt(2) == TypedSwitchPatternKind.Literal
        && tables.Members.MemberOrdinalAt(3) == 1
        && tables.Members.KindAt(3) == TypedSwitchPatternKind.Capture
        && System.Text.Equals(captureName, "second")
        && tables.Members.MemberOrdinalAt(4) == 0
        && tables.Members.KindAt(4) == TypedSwitchPatternKind.Literal
        && tables.Members.MemberOrdinalAt(5) == 1
        && tables.Members.KindAt(5) == TypedSwitchPatternKind.Literal;
}

[Fact]
fn bool SourceModuleLoweringFactsCarryTypedNestedSwitchPatternRows()
{
    stack ascii source = raw"""
    module PatternProbe

    struct Point
    {
        i32[min max] X;
        i32[min max] Y;
    }

    struct Box
    {
        Point Position;
        i32[min max][2] Values;
    }

    fn i32[min max] Classify(Box box)
    {
        switch (box)
        {
            case Box { Position: Point { X: 1, Y: 2 }, Values: [3, 4] }:
                return 1;
            default:
                return 0;
        }
    }
    """;

    stack mut OwnedAscii sourceText = new();
    if (sourceText.AppendAscii(source) != MemoryStatus.Ok)
    {
        return false;
    }

    stack mut TokenStream stream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            stream = lexed;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    if (!BuildSourceModuleLoweringFacts(sourceText.View(), stream, sourceBytes, moduleFacts))
    {
        return false;
    }

    stack u32[0 max] topAggregateStart = moduleFacts.SwitchPatterns.AggregatePatterns.PatternStartTokenAt(0);
    stack u32[0 max] nestedAggregateStart = moduleFacts.SwitchPatterns.AggregatePatterns.PatternStartTokenAt(1);
    stack u32[0 max] nestedListStart = moduleFacts.SwitchPatterns.ListPatterns.PatternStartTokenAt(0);

    return moduleFacts.SwitchPatterns.AggregatePatterns.Count() == 2
        && moduleFacts.SwitchPatterns.ListPatterns.Count() == 1
        && moduleFacts.SwitchPatterns.Members.Count() == 6
        && SourceSwitchAggregatePatternRowForStartToken(moduleFacts, topAggregateStart) == 1
        && SourceSwitchAggregatePatternRowForStartToken(moduleFacts, nestedAggregateStart) == 2
        && SourceSwitchListPatternRowForStartToken(moduleFacts, nestedListStart) == 1
        && moduleFacts.SwitchPatterns.AggregatePatterns.MemberPatternStartAt(0) == 1
        && moduleFacts.SwitchPatterns.AggregatePatterns.MemberPatternCountAt(0) == 2
        && moduleFacts.SwitchPatterns.Members.MemberOrdinalAt(0) == 0
        && moduleFacts.SwitchPatterns.Members.KindAt(0) == TypedSwitchPatternKind.Aggregate
        && moduleFacts.SwitchPatterns.Members.NestedAggregatePatternRowAt(0) == 2
        && moduleFacts.SwitchPatterns.Members.MemberOrdinalAt(1) == 1
        && moduleFacts.SwitchPatterns.Members.KindAt(1) == TypedSwitchPatternKind.List
        && moduleFacts.SwitchPatterns.Members.NestedListPatternRowAt(1) == 1
        && moduleFacts.SwitchPatterns.AggregatePatterns.MemberPatternStartAt(1) == 3
        && moduleFacts.SwitchPatterns.AggregatePatterns.MemberPatternCountAt(1) == 2
        && moduleFacts.SwitchPatterns.ListPatterns.ElementPatternStartAt(0) == 5
        && moduleFacts.SwitchPatterns.ListPatterns.ElementPatternCountAt(0) == 2;
}

[Fact]
fn bool SourceSwitchImportedTypedNestedRowsBuildDecisionDescriptors()
{
    stack ascii source = raw"""
    module PatternProbe

    struct Point
    {
        i32[min max] X;
        i32[min max] Y;
    }

    struct Box
    {
        Point Position;
        i32[min max][2] Values;
    }

    fn i32[min max] Classify(Box box)
    {
        switch (box)
        {
            case Box { Position: Point { X: 1, Y: 2 }, Values: [3, 4] }:
                return 1;
            default:
                return 0;
        }
    }
    """;

    stack mut OwnedAscii sourceText = new();
    if (sourceText.AppendAscii(source) != MemoryStatus.Ok)
    {
        return false;
    }

    stack mut TokenStream stream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            stream = lexed;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    if (!BuildSourceModuleLoweringFacts(sourceText.View(), stream, sourceBytes, moduleFacts))
    {
        return false;
    }

    stack SourceSwitchAggregatePatternDescriptor descriptor =
        MakeSourceSwitchAggregatePatternDescriptor(
            moduleFacts.SwitchPatterns.AggregatePatterns.OwnerTypeHeadTokenAt(0),
            0,
            0,
            0);
    stack mut IrTable<u32[0 max]> emptyNestedFieldIndices = new();
    stack mut IrTable<u32[0 max]> emptyNestedKinds = new();
    stack mut IrTable<u32[0 max]> emptyNestedAggregateDescriptorRows = new();
    stack mut IrTable<u32[0 max]> emptyNestedListDescriptorRows = new();
    stack mut IrTable<SourceSwitchAggregatePatternDescriptor> aggregateDescriptors = new();
    stack mut IrTable<SourceSwitchListPatternDescriptor> listDescriptors = new();
    stack mut IrTable<SourceSwitchPatternDecisionNode> nodes = new();
    stack mut IrTable<SourceSwitchPatternDecisionMember> members = new();
    stack mut u32[0 max] memberStart = 0;
    stack mut u32[0 max] memberCount = 0;
    if (!TryTranslateSourceSwitchNestedStructFieldRowsToPatternDecisionMembers(
            stream,
            sourceBytes,
            moduleFacts,
            descriptor,
            moduleFacts.SwitchPatterns.AggregatePatterns.MemberPatternStartAt(0),
            moduleFacts.SwitchPatterns.AggregatePatterns.MemberPatternCountAt(0),
            emptyNestedFieldIndices,
            emptyNestedKinds,
            emptyNestedAggregateDescriptorRows,
            emptyNestedListDescriptorRows,
            aggregateDescriptors,
            listDescriptors,
            nodes,
            members,
            memberStart,
            memberCount)
        || memberStart != 1
        || memberCount != 2
        || aggregateDescriptors.Count() != 1
        || listDescriptors.Count() != 1
        || nodes.Count() != 2
        || members.Count() != 2)
    {
        return false;
    }

    stack SourceSwitchPatternDecisionMember aggregateMember = members.Get(1);
    stack SourceSwitchPatternDecisionMember listMember = members.Get(2);
    stack SourceSwitchPatternDecisionNode aggregateNode = nodes.Get(aggregateMember.NodeRow);
    stack SourceSwitchPatternDecisionNode listNode = nodes.Get(listMember.NodeRow);
    stack SourceSwitchAggregatePatternDescriptor nestedAggregate = aggregateDescriptors.Get(aggregateNode.AggregateDescriptorRow);
    stack SourceSwitchListPatternDescriptor nestedList = listDescriptors.Get(listNode.ListDescriptorRow);

    return aggregateMember.Ordinal == 0
        && aggregateNode.Kind == SourceSwitchPatternDecisionKindAggregate()
        && SourceSwitchPatternDecisionNodeUsesAggregateDescriptor(aggregateNode)
        && nestedAggregate.OwnerTypeToken == moduleFacts.SwitchPatterns.AggregatePatterns.OwnerTypeHeadTokenAt(1)
        && nestedAggregate.FieldPatternCount == 0
        && listMember.Ordinal == 1
        && listNode.Kind == SourceSwitchPatternDecisionKindList()
        && SourceSwitchPatternDecisionNodeUsesListDescriptor(listNode)
        && nestedList.ElementTypeCode == SourceResolvedFieldTypeCodeI32()
        && nestedList.FixedLength == 2
        && nestedList.ElementPatternCount == 0;
}

[Fact]
fn bool ValueFactsDefaultToAbsent()
{
    // A fresh fact record has no attached facts.
    stack ValueFacts vf = new();
    return !vf.HasAlignment()
        && vf.AlignmentBytes() == 0
        && !vf.HasCallingAbi()
        && !vf.HasNoAlias()
        && !vf.Volatile()
        && !vf.HasIntegerRange()
        && !vf.HasNullability()
        && !vf.HasTextConstant();
}

[Fact]
fn bool ValueFactsSetAndQuery()
{
    // Setting facts makes them present and queryable.
    stack mut ValueFacts vf = new();
    vf.SetAlignment(8);
    vf.SetCallingAbi(AbiKind.CAbi);
    vf.MarkNoAlias();
    vf.SetIntegerRange(2, 9);
    vf.MarkKnownNull();
    vf.SetTextConstant(7, 11, 5, 4, MirTextConstantStorageEncodingCode(MirTextConstantStorageEncoding.Utf8Bytes));
    return vf.HasAlignment()
        && vf.AlignmentBytes() == 8
        && vf.HasCallingAbi()
        && vf.HasNoAlias()
        && vf.HasIntegerRange()
        && vf.IntegerRangeLower() == 2
        && vf.IntegerRangeUpperExclusive() == 9
        && vf.HasNullability()
        && vf.KnownNull()
        && !vf.KnownNonNull()
        && vf.HasTextConstant()
        && vf.TextConstantRowIndex() == 7
        && vf.TextConstantPayloadStart() == 11
        && vf.TextConstantPayloadByteLength() == 5
        && vf.TextConstantCodePointLength() == 4
        && vf.TextConstantStorageEncodingCode() == MirTextConstantStorageEncodingCode(MirTextConstantStorageEncoding.Utf8Bytes)
        && !vf.Volatile();
}

[Fact]
fn bool ValueFactsInheritCarriesPresentFactsOnly()
{
    // `InheritFrom` copies the source's present facts and leaves the destination's
    // own facts untouched where the source is absent.
    stack mut ValueFacts src = new();
    src.SetAlignment(16);
    src.MarkNoAlias();
    src.SetIntegerRange(0, 11);
    src.MarkKnownNonNull();
    src.SetTextConstant(3, 5, 8, 6, MirTextConstantStorageEncodingCode(MirTextConstantStorageEncoding.AsciiBytes));

    stack mut ValueFacts dst = new();
    dst.MarkVolatile();
    dst.MarkKnownNull();
    dst.InheritFrom(src);

    return dst.HasAlignment()
        && dst.AlignmentBytes() == 16
        && dst.HasNoAlias()
        && dst.HasIntegerRange()
        && dst.IntegerRangeLower() == 0
        && dst.IntegerRangeUpperExclusive() == 11
        && dst.HasNullability()
        && !dst.KnownNull()
        && dst.KnownNonNull()
        && dst.HasTextConstant()
        && dst.TextConstantRowIndex() == 3
        && dst.TextConstantPayloadStart() == 5
        && dst.TextConstantPayloadByteLength() == 8
        && dst.TextConstantCodePointLength() == 6
        && dst.TextConstantStorageEncodingCode() == MirTextConstantStorageEncodingCode(MirTextConstantStorageEncoding.AsciiBytes)
        && dst.Volatile()
        && !dst.HasCallingAbi();
}

[Fact]
fn bool ValueFactsInheritFromEmptyLeavesDestination()
{
    // Inheriting from a source with no facts changes nothing on the destination.
    stack ValueFacts empty = new();
    stack mut ValueFacts dst = new();
    dst.SetAlignment(4);
    dst.InheritFrom(empty);
    return dst.HasAlignment() && dst.AlignmentBytes() == 4;
}

[Fact]
fn bool ValueFactsStoreInIrTableByHandle()
{
    // Fact records attach to values through an `IrTable<ValueFacts>` keyed by the
    // value handle's index — the "one record per value" layout of doc 24 §4.
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts vf = new();
    vf.SetAlignment(32);
    stack u32[0 max] idx = facts.Add(vf);
    stack ValueFacts read = facts.Get(idx);
    return facts.Contains(idx) && read.AlignmentBytes() == 32;
}

[Fact]
fn bool ValueFactTransferRecordsGeneratedFactsAtMirHandle()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId value = MirConstInt(instrs, 42);
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts generated = new();
    generated.SetAlignment(8);
    generated.SetIntegerRange(42, 43);

    if (!RecordGeneratedValueFactsForMirValue(facts, value, generated))
    {
        return false;
    }

    stack ValueFacts read = ValueFactsForMirValue(facts, value);
    return facts.Count() == 1
        && read.HasAlignment()
        && read.AlignmentBytes() == 8
        && read.HasIntegerRange()
        && read.IntegerRangeLower() == 42
        && read.IntegerRangeUpperExclusive() == 43;
}

[Fact]
fn bool ValueFactTransferFillsSkippedHandlesWithEmptyFacts()
{
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts generated = new();
    generated.MarkNoAlias();
    generated.MarkKnownNull();

    if (!RecordGeneratedValueFactsForMirValue(facts, MirValueIdOf(3), generated))
    {
        return false;
    }

    stack ValueFacts first = ValueFactsForMirValue(facts, MirValueIdOf(1));
    stack ValueFacts second = ValueFactsForMirValue(facts, MirValueIdOf(2));
    stack ValueFacts third = ValueFactsForMirValue(facts, MirValueIdOf(3));
    return facts.Count() == 3
        && !first.HasNoAlias()
        && !first.HasNullability()
        && !second.HasNoAlias()
        && !second.HasNullability()
        && third.HasNoAlias()
        && third.KnownNull();
}

[Fact]
fn bool ValueFactTransferPreservesFactsForEquivalentValues()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId source = MirConstInt(instrs, 1);
    stack MirValueId zext = MirZExt(instrs, source);
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts sourceFacts = new();
    sourceFacts.SetIntegerRange(0, 2);
    sourceFacts.MarkVolatile();

    if (!RecordGeneratedValueFactsForMirValue(facts, source, sourceFacts))
    {
        return false;
    }

    if (!PreserveValueFactsForMirValue(facts, zext, source))
    {
        return false;
    }

    stack ValueFacts read = ValueFactsForMirValue(facts, zext);
    return facts.Count() == 2
        && read.HasIntegerRange()
        && read.IntegerRangeLower() == 0
        && read.IntegerRangeUpperExclusive() == 2
        && read.Volatile();
}

[Fact]
fn bool ValueFactTransferImportsParameterGlobalAndReturnFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId param = MirParam(instrs, 0);
    stack MirValueId call = MirCall(instrs, MirFuncIdOf(2));
    stack MirValueId load = MirLoadGlobal(instrs, 1);

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut ValueFacts p0Facts = new();
    p0Facts.SetIntegerRange(1, 6);
    stack u32[0 max] addedParam = paramFacts.Add(p0Facts);

    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts emptyReturn = new();
    stack u32[0 max] addedFirstReturn = functionReturnFacts.Add(emptyReturn);
    stack mut ValueFacts f2Facts = new();
    f2Facts.SetIntegerRange(10, 20);
    stack u32[0 max] addedSecondReturn = functionReturnFacts.Add(f2Facts);

    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut ValueFacts g1Facts = new();
    g1Facts.SetIntegerRange(-3, 4);
    stack u32[0 max] addedGlobal = globalFacts.Add(g1Facts);

    stack mut IrTable<ValueFacts> valueFacts = new();
    if (!ImportParameterValueFactsForMirValue(valueFacts, param, paramFacts, 0))
    {
        return false;
    }

    if (!ImportFunctionReturnValueFactsForMirValue(valueFacts, call, functionReturnFacts, MirFuncIdOf(2)))
    {
        return false;
    }

    if (!ImportGlobalValueFactsForMirValue(valueFacts, load, globalFacts, 1))
    {
        return false;
    }

    stack ValueFacts paramRead = ValueFactsForMirValue(valueFacts, param);
    stack ValueFacts callRead = ValueFactsForMirValue(valueFacts, call);
    stack ValueFacts loadRead = ValueFactsForMirValue(valueFacts, load);
    return addedParam == 1
        && addedFirstReturn == 1
        && addedSecondReturn == 2
        && addedGlobal == 1
        && valueFacts.Count() == 3
        && paramRead.IntegerRangeLower() == 1
        && paramRead.IntegerRangeUpperExclusive() == 6
        && callRead.IntegerRangeLower() == 10
        && callRead.IntegerRangeUpperExclusive() == 20
        && loadRead.IntegerRangeLower() == -3
        && loadRead.IntegerRangeUpperExclusive() == 4;
}

[Fact]
fn bool BuildMirValueRangeFactsImportsTypedCallReturnFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId call = MirCallTyped(instrs, MirType.I32, MirFuncIdOf(2));

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts emptyReturn = new();
    stack u32[0 max] addedFirstReturn = functionReturnFacts.Add(emptyReturn);
    stack mut ValueFacts f2Facts = new();
    f2Facts.SetIntegerRange(12, 13);
    f2Facts.SetAlignment(4);
    f2Facts.SetCallingAbi(AbiKind.CAbi);
    f2Facts.MarkNoAlias();
    f2Facts.MarkVolatile();
    stack u32[0 max] addedSecondReturn = functionReturnFacts.Add(f2Facts);
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts callFacts = ValueFactsForMirValue(valueFacts, call);
    return addedFirstReturn == 1
        && addedSecondReturn == 2
        && valueFacts.Count() == 1
        && MirValueType(instrs, call.Index()) == MirType.I32
        && callFacts.HasIntegerRange()
        && callFacts.IntegerRangeLower() == 12
        && callFacts.IntegerRangeUpperExclusive() == 13
        && callFacts.HasAlignment()
        && callFacts.AlignmentBytes() == 4
        && callFacts.HasCallingAbi()
        && callFacts.CallingAbi() == AbiKind.CAbi
        && callFacts.HasNoAlias()
        && callFacts.Volatile();
}

[Fact]
fn bool BuildMirValueRangeFactsImportsFixedArrayElementDeclaredRange()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId element = MirFixedArrayParamElement(instrs, 0, 1, 3, MirType.I32);

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut ValueFacts elementRangeFacts = new();
    elementRangeFacts.SetIntegerRange(4, 10);
    stack u32[0 max] addedParam = paramFacts.Add(elementRangeFacts);

    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts elementFacts = ValueFactsForMirValue(valueFacts, element);
    return addedParam == 1
        && valueFacts.Count() == 1
        && elementFacts.HasIntegerRange()
        && elementFacts.IntegerRangeLower() == 4
        && elementFacts.IntegerRangeUpperExclusive() == 10;
}

[Fact]
fn bool BuildMirValueRangeFactsImportsStructParamFieldDeclaredRange()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack u32[0 max] shape = StructValueShapeTypeCode(MirType.I64)
        + StructValueShapeTypeCode(MirType.I1) * StructValueShapeMultiplierForIndex(1);
    stack MirValueId rangedField = MirStructParamFieldWithDeclaredRange(instrs, 0, 0, 2, shape, MirType.I64, 5, 9);
    stack MirValueId flagField = MirStructParamField(instrs, 0, 1, 2, shape, MirType.I1);

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts rangedFacts = ValueFactsForMirValue(valueFacts, rangedField);
    stack ValueFacts flagFacts = ValueFactsForMirValue(valueFacts, flagField);
    return rangedFacts.HasIntegerRange()
        && rangedFacts.IntegerRangeLower() == 5
        && rangedFacts.IntegerRangeUpperExclusive() == 9
        && flagFacts.HasIntegerRange()
        && flagFacts.IntegerRangeLower() == 0
        && flagFacts.IntegerRangeUpperExclusive() == 2;
}

[Fact]
fn bool BuildMirValueRangeFactsImportsPointerCallReturnBackendFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId call = MirCallTyped(instrs, MirType.Ptr, MirFuncIdOf(1));

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts returnFacts = new();
    returnFacts.SetAlignment(8);
    returnFacts.MarkNoAlias();
    returnFacts.MarkKnownNonNull();
    stack u32[0 max] addedReturn = functionReturnFacts.Add(returnFacts);
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts callFacts = ValueFactsForMirValue(valueFacts, call);
    return addedReturn == 1
        && valueFacts.Count() == 1
        && MirValueType(instrs, call.Index()) == MirType.Ptr
        && callFacts.HasAlignment()
        && callFacts.AlignmentBytes() == 8
        && callFacts.HasNoAlias()
        && callFacts.HasNullability()
        && !callFacts.KnownNull()
        && callFacts.KnownNonNull();
