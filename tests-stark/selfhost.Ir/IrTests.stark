[Fact]
fn bool CompileFunctionLawAndFiniteKindsLowerSeparately()
{
    stack mut OwnedAscii lawSink = new();
    stack bool lawOk = CompileFunctionToLlvm("law fn i64 read(i64 x) { return x }", lawSink);
    stack mut OwnedAscii finiteSink = new();
    stack bool finiteOk = CompileFunctionToLlvm("finite fn i64 one() { return 1 }", finiteSink);
    return lawOk
        && finiteOk
        && LlvmTextEquals(lawSink, "define i64 @main(i64 %p0) memory(none) nosync nofree norecurse {\nb1:\n  ret i64 %p0\n}\n")
        && LlvmTextEquals(finiteSink, "define i64 @main() willreturn mustprogress norecurse {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool CompileFunctionPointerBorrowsLowerGranularCaptureAttributes()
{
    stack mut OwnedAscii borrowed = new();
    stack bool borrowOk = CompileFunctionToLlvm("fn i64 read(borrow i32 value) { return 1 }", borrowed);
    stack mut OwnedAscii returned = new();
    stack bool retOk = CompileFunctionToLlvm("fn i64 echo(retborrow i32 value) { return 1 }", returned);
    stack mut OwnedAscii stored = new();
    stack bool storeOk = CompileFunctionToLlvm("fn i64 hold(storeborrow i32 value) { return 1 }", stored);
    return borrowOk
        && retOk
        && storeOk
        && LlvmTextEquals(borrowed, "define i64 @main(ptr captures(none) readonly %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n")
        && LlvmTextEquals(returned, "define i64 @main(ptr captures(ret: address, read_provenance) readonly %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n")
        && LlvmTextEquals(stored, "define i64 @main(ptr captures(address, read_provenance) readonly %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n");
}

