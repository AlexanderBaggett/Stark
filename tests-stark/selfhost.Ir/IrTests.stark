[Fact]
fn bool SourceSwitchStructFlatOverlapPreflightDefersNestedLabels()
{
    stack mut IrTable<u32[0 max]> nestedCounts = new();
    if (!SourceSwitchStructPatternCanUseFlatOverlapPreflight(nestedCounts, 0)
        || SourceSwitchStructPatternCanUseFlatOverlapPreflight(nestedCounts, 1)
        || nestedCounts.Add(0) == 0
        || nestedCounts.Add(2) == 0)
    {
        return false;
    }

    return !SourceSwitchStructPatternCanUseFlatOverlapPreflight(nestedCounts, 0)
        && !SourceSwitchStructPatternCanUseFlatOverlapPreflight(nestedCounts, 3);
}

[Fact]
fn bool SourceSwitchPatternDescriptorPreflightRejectsMalformedRows()
{
    stack mut IrTable<u32[0 max]> elementPatternIndices = new();
    stack mut IrTable<u32[0 max]> elementPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> elementPatternKinds = new();
    stack mut IrTable<i64[min max]> elementPatternMinValues = new();
    stack mut IrTable<i64[min max]> elementPatternMaxValues = new();
    stack u32[0 max] elementRow = elementPatternIndices.Add(1);
    stack u32[0 max] elementTypeRow = elementPatternTypeCodes.Add(SourceResolvedFieldTypeCodeI32());
    stack u32[0 max] elementKindRow = elementPatternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval());
    stack u32[0 max] elementMinRow = elementPatternMinValues.Add(0);
    stack u32[0 max] elementMaxRow = elementPatternMaxValues.Add(7);
    if (elementRow != elementTypeRow
        || elementRow != elementKindRow
        || elementRow != elementMinRow
        || elementRow != elementMaxRow)
    {
        return false;
    }

    stack mut IrTable<SourceSwitchListPatternDescriptor> listDescriptors = new();
    stack mut IrTable<u32[0 max]> validListRows = new();
    stack mut IrTable<u32[0 max]> invalidListRows = new();
    stack u32[0 max] validListDescriptor =
        listDescriptors.Add(MakeSourceSwitchListPatternDescriptor(SourceResolvedFieldTypeCodeI32(), 3, elementRow, 1));
    stack u32[0 max] invalidListDescriptor =
        listDescriptors.Add(MakeSourceSwitchListPatternDescriptor(SourceResolvedFieldTypeCodeI32(), 1, elementRow, 1));
    if (validListRows.Add(validListDescriptor) == 0
        || invalidListRows.Add(invalidListDescriptor) == 0)
    {
        return false;
    }

    stack bool validList = SourceSwitchListPatternDescriptorRowsAreValid(
        listDescriptors,
        validListRows,
        elementPatternIndices,
        elementPatternTypeCodes,
        elementPatternKinds,
        elementPatternMinValues,
        elementPatternMaxValues);
    stack bool invalidList = SourceSwitchListPatternDescriptorRowsAreValid(
        listDescriptors,
        invalidListRows,
        elementPatternIndices,
        elementPatternTypeCodes,
        elementPatternKinds,
        elementPatternMinValues,
        elementPatternMaxValues);

    stack mut IrTable<u32[0 max]> fieldPatternIndices = new();
    stack mut IrTable<u32[0 max]> fieldPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> fieldPatternMemberFactRows = new();
    stack mut IrTable<u32[0 max]> fieldPatternKinds = new();
    stack mut IrTable<i64[min max]> fieldPatternMinValues = new();
    stack mut IrTable<i64[min max]> fieldPatternMaxValues = new();
    stack u32[0 max] fieldRow = fieldPatternIndices.Add(1);
    stack u32[0 max] fieldTypeRow = fieldPatternTypeCodes.Add(SourceResolvedFieldTypeCodeI32());
    stack u32[0 max] fieldMemberRow = fieldPatternMemberFactRows.Add(0);
    stack u32[0 max] fieldKindRow = fieldPatternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval());
    stack u32[0 max] fieldMinRow = fieldPatternMinValues.Add(0);
    stack u32[0 max] fieldMaxRow = fieldPatternMaxValues.Add(7);
    stack u32[0 max] staleFieldRow = fieldPatternIndices.Add(1);
    stack u32[0 max] staleFieldTypeRow = fieldPatternTypeCodes.Add(SourceResolvedFieldTypeCodeI64());
    stack u32[0 max] staleFieldMemberRow = fieldPatternMemberFactRows.Add(0);
    stack u32[0 max] staleFieldKindRow = fieldPatternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval());
    stack u32[0 max] staleFieldMinRow = fieldPatternMinValues.Add(0);
    stack u32[0 max] staleFieldMaxRow = fieldPatternMaxValues.Add(7);
    if (fieldRow != fieldTypeRow
        || fieldRow != fieldMemberRow
        || fieldRow != fieldKindRow
        || fieldRow != fieldMinRow
        || fieldRow != fieldMaxRow
        || staleFieldRow != staleFieldTypeRow
        || staleFieldRow != staleFieldMemberRow
        || staleFieldRow != staleFieldKindRow
        || staleFieldRow != staleFieldMinRow
        || staleFieldRow != staleFieldMaxRow)
    {
        return false;
    }

    stack mut ParamAbiFacts structValueFacts = new();
    structValueFacts.IsStructValue = true;
    structValueFacts.StructValueFieldCount = 2;
    structValueFacts.StructValueShapeCode =
        StructValueShapeTypeCode(MirType.I1)
            + StructValueShapeTypeCode(MirType.I32) * StructValueShapeMultiplierForIndex(1);
    stack mut IrTable<SourceSwitchAggregatePatternDescriptor> aggregateDescriptors = new();
    stack mut IrTable<u32[0 max]> validAggregateRows = new();
    stack mut IrTable<u32[0 max]> invalidAggregateRows = new();
    stack u32[0 max] validAggregateDescriptor =
        aggregateDescriptors.Add(MakeSourceSwitchAggregatePatternDescriptor(88, 0, fieldRow, 1));
    stack u32[0 max] invalidAggregateDescriptor =
        aggregateDescriptors.Add(MakeSourceSwitchAggregatePatternDescriptor(88, 0, staleFieldRow, 1));
    if (validAggregateRows.Add(validAggregateDescriptor) == 0
        || invalidAggregateRows.Add(invalidAggregateDescriptor) == 0)
    {
        return false;
    }

    stack bool validAggregate = SourceSwitchStructValuePatternDescriptorRowsAreValid(
        88,
        structValueFacts,
        aggregateDescriptors,
        validAggregateRows,
        fieldPatternIndices,
        fieldPatternTypeCodes,
        fieldPatternMemberFactRows,
        fieldPatternKinds,
        fieldPatternMinValues,
        fieldPatternMaxValues);
    stack bool invalidAggregate = SourceSwitchStructValuePatternDescriptorRowsAreValid(
        88,
        structValueFacts,
        aggregateDescriptors,
        invalidAggregateRows,
        fieldPatternIndices,
        fieldPatternTypeCodes,
        fieldPatternMemberFactRows,
        fieldPatternKinds,
        fieldPatternMinValues,
        fieldPatternMaxValues);

    stack mut TokenStream stream = new();
    stack mut TypedEnumLayoutTable layouts = new();
    if (!BuildTypedEnumLayoutsForSource("enum Packet { Empty, Other(i64[min max]) }", stream, layouts))
    {
        return false;
    }

    stack mut u64[0 max] otherTag = 0;
    if (!layouts.TryGetEnumVariantTag(0, 1, otherTag))
    {
        return false;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    moduleFacts.EnumLayouts = layouts;
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<u32[0 max]> casePatternStarts = new();
    stack mut IrTable<u32[0 max]> casePatternCounts = new();
    stack mut IrTable<u32[0 max]> payloadPatternVariantOrdinals = new();
    stack mut IrTable<u32[0 max]> payloadPatternOrdinals = new();
    stack mut IrTable<u32[0 max]> stalePayloadPatternOrdinals = new();
    stack mut IrTable<u32[0 max]> payloadPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> payloadPatternKinds = new();
    stack mut IrTable<i64[min max]> payloadPatternMinValues = new();
    stack mut IrTable<i64[min max]> payloadPatternMaxValues = new();
    if (caseValues.Add((i64[min max])otherTag) == 0
        || casePatternStarts.Add(1) == 0
        || casePatternCounts.Add(1) == 0
        || payloadPatternVariantOrdinals.Add(1) == 0
        || payloadPatternOrdinals.Add(0) == 0
        || stalePayloadPatternOrdinals.Add(9) == 0
        || payloadPatternTypeCodes.Add(SourceResolvedFieldTypeCodeI64()) == 0
        || payloadPatternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval()) == 0
        || payloadPatternMinValues.Add(0) == 0
        || payloadPatternMaxValues.Add(7) == 0)
    {
        return false;
    }

    stack mut IrTable<SourceSwitchAggregatePatternDescriptor> enumDescriptors = new();
    stack mut IrTable<u32[0 max]> enumDescriptorRows = new();
    if (!TryBuildSourceSwitchEnumAggregatePatternCaseDescriptors(
            moduleFacts,
            0,
            caseValues,
            casePatternStarts,
            casePatternCounts,
            payloadPatternVariantOrdinals,
            enumDescriptors,
            enumDescriptorRows))
    {
        return false;
    }

    stack bool validEnum = SourceSwitchEnumPayloadPatternDescriptorRowsAreValid(
        moduleFacts,
        0,
        caseValues,
        enumDescriptors,
        enumDescriptorRows,
        payloadPatternVariantOrdinals,
        payloadPatternOrdinals,
        payloadPatternTypeCodes,
        payloadPatternKinds,
        payloadPatternMinValues,
        payloadPatternMaxValues);
    stack bool invalidEnum = SourceSwitchEnumPayloadPatternDescriptorRowsAreValid(
        moduleFacts,
        0,
        caseValues,
        enumDescriptors,
        enumDescriptorRows,
        payloadPatternVariantOrdinals,
        stalePayloadPatternOrdinals,
        payloadPatternTypeCodes,
        payloadPatternKinds,
        payloadPatternMinValues,
        payloadPatternMaxValues);

    return validList
        && !invalidList
        && validAggregate
        && !invalidAggregate
        && validEnum
        && !invalidEnum;
}

[Fact]
fn bool SourceTryExpressionNodesKeepOperandSeparate()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] operand = MakeIntLit(nodes, 7);
    stack u32[0 max] tryNode = MakeTry(nodes, operand);
    stack mut u32[0 max] readOperand = 0;
    return TryGetSourceTryOperandNode(nodes, tryNode, readOperand)
        && readOperand == operand
        && TypeOfNode(nodes, tryNode) == ExprType.ErrorType;
}

[Fact]
fn bool SourceTryExpressionParserDoesNotEraseTry()
{
    return InferSourceExpressionType("try 1") == ExprType.ErrorType;
}

[Fact]
fn bool SourceTryExpressionGenericLoweringRequiresTryPath()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] operand = MakeIntLit(nodes, 7);
    stack u32[0 max] tryNode = MakeTry(nodes, operand);
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId lowered = LowerExprNode(nodes, tryNode, instrs);
    return lowered.Index() == 0 && instrs.Count() == 0;
}

fn bool BuildTypedEnumLayoutsForSource(ascii source, out TokenStream stream, out TypedEnumLayoutTable layouts)
{
    stream = new();
    layouts = new();

    stack mut TokenStream parsedStream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            parsedStream = lexed;
    }

    stack mut DeclarationList declarations = new();
    switch (ParseDeclarations(parsedStream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDeclarations):
            declarations = parsedDeclarations;
    }

    switch (BuildTypedEnumLayouts(source, parsedStream, declarations))
    {
        case ParseResult<TypedEnumLayoutTable>.Err(var layoutError):
            return false;
        case ParseResult<TypedEnumLayoutTable>.Ok(var builtLayouts):
            layouts = builtLayouts;
            stream = parsedStream;
            return true;
    }
}

fn bool BuildTypedEnumTryInputsForSource(
    ascii source,
    out TokenStream stream,
    out DeclarationList declarations,
    out TypedEnumPayloadTable payloads,
    out TypedEnumLayoutTable layouts)
{
    stream = new();
    declarations = new();
    payloads = new();
    layouts = new();

    stack mut TokenStream parsedStream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            parsedStream = lexed;
    }

    stack mut DeclarationList parsedDeclarations = new();
    switch (ParseDeclarations(parsedStream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsed):
            parsedDeclarations = parsed;
    }

    stack mut TypedEnumPayloadTable builtPayloads = new();
    switch (BuildTypedEnumPayloads(source, parsedStream, parsedDeclarations))
    {
        case ParseResult<TypedEnumPayloadTable>.Err(var payloadError):
            return false;
        case ParseResult<TypedEnumPayloadTable>.Ok(var parsedPayloads):
            builtPayloads = parsedPayloads;
    }

    switch (BuildTypedEnumLayouts(source, parsedStream, parsedDeclarations))
    {
        case ParseResult<TypedEnumLayoutTable>.Err(var layoutError):
            return false;
        case ParseResult<TypedEnumLayoutTable>.Ok(var builtLayouts):
            stream = parsedStream;
            declarations = parsedDeclarations;
            payloads = builtPayloads;
            layouts = builtLayouts;
            return true;
    }
}

[Fact]
fn bool SourceTryRoleFactsResolveOkErrEnumLayouts()
{
    stack ascii source = raw"""
    enum Outcome
    {
        [Ok] Value(i32[0 max]),
        [Err] Failure(u8[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedEnumPayloadTable payloads = new();
    stack mut TypedEnumLayoutTable layouts = new();
    stack mut OwnedAscii sourceText = new();
    if (sourceText.AppendAscii(source) != MemoryStatus.Ok
        || !BuildTypedEnumTryInputsForSource(source, stream, declarations, payloads, layouts))
    {
        return false;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    moduleFacts.Declarations = declarations;
    moduleFacts.EnumPayloads = payloads;
    moduleFacts.EnumLayouts = layouts;

    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    stack mut SourceTryPropagationRoleFacts facts = new();
    return TryResolveSourceTryPropagationRoleFacts(stream, sourceBytes, moduleFacts, 0, facts)
        && facts.IsValid()
        && facts.OkVariantOrdinal() == 0
        && facts.OkVariantTag() == 0
        && facts.OkPayloadCount() == 1
        && facts.OkPayloadTypeCode() == SourceResolvedFieldTypeCodeI32()
        && facts.ErrVariantOrdinal() == 1
        && facts.ErrVariantTag() == 1
        && facts.ErrPayloadCount() == 1
        && facts.ErrPayloadTypeCode() == SourceResolvedFieldTypeCodeI8();
}

