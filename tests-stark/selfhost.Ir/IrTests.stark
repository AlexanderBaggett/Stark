[Fact]
fn bool RejectsInvalidFixedArraySliceDescriptorsAndIndexes()
{
    stack mut OwnedAscii wideIndex = new();
    stack mut OwnedAscii scalarSource = new();
    stack mut OwnedAscii wrongElementType = new();
    stack mut OwnedAscii localWideIndex = new();
    stack mut OwnedAscii localWrongElementType = new();
    stack mut OwnedAscii tooManyInitializers = new();
    stack mut OwnedAscii readonlyWrite = new();
    stack mut OwnedAscii sliceWriteWideIndex = new();
    stack mut OwnedAscii sliceWriteWrongElementType = new();
    return !CompileFunctionWithLocalsToLlvm("struct Inner { i32[min max][3] values; } struct Box { Inner inner; } fn i32[min max] main(i64[0 3] index) { stack Box box = new Box(); stack i32[min max][] view = box.inner.values; return view[index] }", wideIndex)
        && !CompileFunctionWithLocalsToLlvm("struct Box { i32[min max] value; } fn i32[min max] main(i64[0 0] index) { stack Box box = new Box(); stack i32[min max][] view = box.value; return view[index] }", scalarSource)
        && !CompileFunctionWithLocalsToLlvm("struct Inner { i32[min max][3] values; } struct Box { Inner inner; } fn i64 main(i64[0 2] index) { stack Box box = new Box(); stack i64[min max][] view = box.inner.values; return view[index] }", wrongElementType)
        && !CompileFunctionWithLocalsToLlvm("fn i32[min max] main(i64[0 3] index) { stack i32[min max][3] values = { 1, 2, 3 }; stack i32[min max][] view = values; return view[index] }", localWideIndex)
        && !CompileFunctionWithLocalsToLlvm("fn i64 main(i64[0 2] index) { stack i32[min max][3] values = { 1, 2, 3 }; stack i64[min max][] view = values; return view[index] }", localWrongElementType)
        && !CompileFunctionWithLocalsToLlvm("fn i32[min max] main(i64[0 2] index) { stack i32[min max][2] values = { 1, 2, 3 }; stack i32[min max][] view = values; return view[index] }", tooManyInitializers)
        && !CompileFunctionWithLocalsToLlvm("fn i32[min max] main(i64[0 2] index) { stack i32[min max][3] values = { 1, 2, 3 }; stack i32[min max][] view = values; view[index] = 4; return view[index] }", readonlyWrite)
        && !CompileFunctionWithLocalsToLlvm("fn i32[min max] main(i64[0 3] index) { stack mut i32[min max][3] values = { 1, 2, 3 }; stack mut i32[min max][] view = values; view[index] = 4; return view[0] }", sliceWriteWideIndex)
        && !CompileFunctionWithLocalsToLlvm("fn i32[min max] main(i64[0 2] index) { stack mut i32[min max][3] values = { 1, 2, 3 }; stack mut i32[min max][] view = values; view[index] = true; return view[index] }", sliceWriteWrongElementType);
}

[Fact]
fn bool RejectsNestedFixedArrayElementInvalidTargetsAndValues()
{
    stack mut OwnedAscii outOfRangeRead = new();
    stack mut OwnedAscii wideWrite = new();
    stack mut OwnedAscii scalarIndex = new();
    stack mut OwnedAscii wrongType = new();
    stack mut OwnedAscii forward = new();
    return !CompileFunctionWithLocalsToLlvm("struct Inner { i32[min max][2] values; } struct Box { Inner inner; } fn i32[min max] main() { stack Box box = new Box(); return box.inner.values[2] }", outOfRangeRead)
        && !CompileFunctionWithLocalsToLlvm("struct Inner { i32[min max][3] values; } struct Box { Inner inner; } fn i32[min max] main(i64[0 3] index) { stack Box box = new Box(); box.inner.values[index] = 1; return 0 }", wideWrite)
        && !CompileFunctionWithLocalsToLlvm("struct Inner { i32[min max] value; } struct Box { Inner inner; } fn i32[min max] main() { stack Box box = new Box(); return box.inner.value[0] }", scalarIndex)
        && !CompileFunctionWithLocalsToLlvm("struct Inner { bool[2] flags; } struct Box { Inner inner; } fn i32[min max] main() { stack Box box = new Box(); box.inner.flags[1] = 1; return 0 }", wrongType)
        && !CompileFunctionWithLocalsToLlvm("struct Inner { i32[min max][2] values; } struct Box { Inner inner; } fn i32[min max] main() { stack Box box = new Box(); box.inner.values[1] = later; var later = 1; return 0 }", forward);
}

