[Fact]
fn bool CompileModuleFfiCallingConventionsReachLlvmText()
{
    stack mut OwnedAscii win64 = new();
    stack mut OwnedAscii sysv = new();
    stack bool win64Ok = CompileModuleFromAst("unsafe ffi(win64) fn abi(x) { return x } fn main(x) { return abi(x) }", win64);
    stack bool sysvOk = CompileModuleFromAst("unsafe ffi(sysv) fn abi(x) { return x } fn main(x) { return abi(x) }", sysv);
    return win64Ok
        && sysvOk
        && System.Text.Contains(win64.View(), "define internal dso_local win64cc i64 @f1(i64 %p0)")
        && System.Text.Contains(win64.View(), "%v2 = call win64cc i64 @f1(i64 %p0)")
        && System.Text.Contains(sysv.View(), "define internal dso_local x86_64_sysvcc i64 @f1(i64 %p0)")
        && System.Text.Contains(sysv.View(), "%v2 = call x86_64_sysvcc i64 @f1(i64 %p0)");
}

[Fact]
fn bool CompileModuleSourceVisibilityControlsLlvmLinkage()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn hidden(x) { return x } internal fn helper(x) { return hidden(x) } public fn api(x) { return helper(x) } export fn entry(x) { return api(x) }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define internal dso_local i64 @f1(i64 %p0)")
        && System.Text.Contains(sink.View(), "define internal dso_local i64 @f2(i64 %p0)")
        && System.Text.Contains(sink.View(), "define i64 @f3(i64 %p0)")
        && System.Text.Contains(sink.View(), "define i64 @f4(i64 %p0)")
        && !System.Text.Contains(sink.View(), "define internal dso_local i64 @f3")
        && !System.Text.Contains(sink.View(), "define internal dso_local i64 @f4")
        && ClangVerifiesLlvmText(sink);
}

