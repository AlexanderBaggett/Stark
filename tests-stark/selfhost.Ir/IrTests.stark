[Fact]
fn bool SourceTextLiteralRowsCanBeFoundByLiteralToken()
{
    stack ascii source = "fn ascii Text()\n{\n    return \"hi\";\n    return 'z';\n}\n";
    stack mut TokenStream stream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedLiteralExpressionTable literals = new();
    if (!BuildTypedLiteralInputsForSource(source, stream, declarations, literals))
    {
        return false;
    }

    stack mut u32[0 max] stringRow = 0;
    stack mut u32[0 max] characterRow = 0;
    if (!TryFindTextLiteralRows(literals, stringRow, characterRow))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] stringIndex = (u64[0 2 ** 63 - 1])(stringRow - 1);
    stack u64[0 2 ** 63 - 1] characterIndex = (u64[0 2 ** 63 - 1])(characterRow - 1);
    stack u32[0 max] foundString = FindTypedLiteralExpressionRowByToken(
        literals,
        literals.ContextAt(stringIndex),
        literals.OwnerDeclarationIndexAt(stringIndex),
        literals.OwnerNameTokenAt(stringIndex),
        literals.FunctionNameTokenAt(stringIndex),
        literals.StatementIndexPlusOneAt(stringIndex),
        literals.LiteralTokenAt(stringIndex));
    stack u32[0 max] foundCharacter = FindTypedLiteralExpressionRowByToken(
        literals,
        literals.ContextAt(characterIndex),
        literals.OwnerDeclarationIndexAt(characterIndex),
        literals.OwnerNameTokenAt(characterIndex),
        literals.FunctionNameTokenAt(characterIndex),
        literals.StatementIndexPlusOneAt(characterIndex),
        literals.LiteralTokenAt(characterIndex));

    return foundString == stringRow
        && foundCharacter == characterRow
        && foundString != foundCharacter;
}

[Fact]
fn bool SourceTextLiteralNodesCarryTypedLiteralRows()
{
    stack ascii source = "fn ascii Text()\n{\n    return \"hi\";\n    return 'z';\n}\n";
    stack mut TokenStream stream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedLiteralExpressionTable literals = new();
    if (!BuildTypedLiteralInputsForSource(source, stream, declarations, literals))
    {
        return false;
    }

    stack mut u32[0 max] stringRow = 0;
    stack mut u32[0 max] characterRow = 0;
    if (!TryFindTextLiteralRows(literals, stringRow, characterRow))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] stringIndex = (u64[0 2 ** 63 - 1])(stringRow - 1);
    stack u64[0 2 ** 63 - 1] characterIndex = (u64[0 2 ** 63 - 1])(characterRow - 1);
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] stringNode = MakeStringLit(nodes, literals.LiteralTokenAt(stringIndex), 0);
    stack u32[0 max] characterNode = MakeCharacterLit(nodes, literals.LiteralTokenAt(characterIndex), characterRow);
    return !SourceTextLiteralNodeHasTypedLiteralRow(nodes, stringNode)
        && TrySetSourceTextLiteralNodeTypedLiteralRow(nodes, stringNode, stringRow)
        && SourceTextLiteralNodeHasTypedLiteralRow(nodes, stringNode)
        && SourceTextLiteralNodeTypedLiteralRowIndexPlusOne(nodes, stringNode) == stringRow
        && SourceTextLiteralNodeLiteralToken(nodes, stringNode) == literals.LiteralTokenAt(stringIndex)
        && SourceTextLiteralNodeHasTypedLiteralRow(nodes, characterNode)
        && SourceTextLiteralNodeTypedLiteralRowIndexPlusOne(nodes, characterNode) == characterRow
        && SourceTextLiteralNodeLiteralToken(nodes, characterNode) == literals.LiteralTokenAt(characterIndex)
        && TypeOfNode(nodes, stringNode) == ExprType.ErrorType
        && TypeOfNode(nodes, characterNode) == ExprType.ErrorType;
}

[Fact]
fn bool SourceTextLiteralParserDoesNotTreatTextAsInteger()
{
    return InferSourceExpressionType("\"hi\"") == ExprType.ErrorType
        && InferSourceExpressionType("'z'") == ExprType.ErrorType;
}

[Fact]
fn bool SourceModuleTextLiteralConstantFactsDecodePayloads()
{
    stack ascii source = "fn ascii Text()\n{\n    return \"hi\";\n    return \"\\u03B1\";\n    return 'z';\n}\n";
    stack mut TokenStream stream = new();
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    if (!BuildTextLiteralModuleFactsForSource(source, stream, moduleFacts))
    {
        return false;
    }

    stack u32[0 max] asciiRow = SourceTextConstantRowForTypedLiteralRow(moduleFacts, 1);
    stack u32[0 max] unicodeRow = SourceTextConstantRowForTypedLiteralRow(moduleFacts, 2);
    stack u32[0 max] characterRow = SourceTextConstantRowForTypedLiteralRow(moduleFacts, 3);
    return SourceModuleTextLiteralConstantRowsAreAligned(moduleFacts)
        && moduleFacts.LiteralExpressions.Count() == 3
        && moduleFacts.TextConstants.Count() == 3
        && moduleFacts.TextPayloadBytes.Count() == 5
        && asciiRow == 1
        && unicodeRow == 2
        && characterRow == 3
        && MirTextConstantPayloadStart(moduleFacts.TextConstants, asciiRow) == 1
        && MirTextConstantPayloadByteLength(moduleFacts.TextConstants, asciiRow) == 2
        && MirTextConstantPayloadCodePointLength(moduleFacts.TextConstants, asciiRow) == 2
        && MirTextConstantEncoding(moduleFacts.TextConstants, asciiRow) == MirTextConstantStorageEncoding.AsciiBytes
        && MirTextConstantPayloadStart(moduleFacts.TextConstants, unicodeRow) == 3
        && MirTextConstantPayloadByteLength(moduleFacts.TextConstants, unicodeRow) == 2
        && MirTextConstantPayloadCodePointLength(moduleFacts.TextConstants, unicodeRow) == 1
        && MirTextConstantEncoding(moduleFacts.TextConstants, unicodeRow) == MirTextConstantStorageEncoding.Utf8Bytes
        && MirTextConstantPayloadStart(moduleFacts.TextConstants, characterRow) == 5
        && MirTextConstantPayloadByteLength(moduleFacts.TextConstants, characterRow) == 1
        && MirTextConstantPayloadCodePointLength(moduleFacts.TextConstants, characterRow) == 1
        && MirTextConstantEncoding(moduleFacts.TextConstants, characterRow) == MirTextConstantStorageEncoding.AsciiBytes
        && moduleFacts.TextPayloadBytes.Get(1) == 104
        && moduleFacts.TextPayloadBytes.Get(2) == 105
        && moduleFacts.TextPayloadBytes.Get(3) == 206
        && moduleFacts.TextPayloadBytes.Get(4) == 177
        && moduleFacts.TextPayloadBytes.Get(5) == 122;
}

[Fact]
fn bool SourceTextLiteralNodeLoweringEmitsMirDescriptor()
{
    stack ascii source = "fn ascii Text()\n{\n    return \"hi\";\n}\n";
    stack mut TokenStream stream = new();
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    if (!BuildTextLiteralModuleFactsForSource(source, stream, moduleFacts))
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] literalToken = moduleFacts.LiteralExpressions.LiteralTokenAt(0);
    stack u32[0 max] stringNode = MakeStringLit(nodes, literalToken, 0);
    if (!LinkSourceTextLiteralRowsFromModuleFacts(nodes, moduleFacts))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId value = LowerExprNodeWithModuleFacts(nodes, stringNode, instrs, moduleFacts);
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts facts = ValueFactsForMirValue(valueFacts, value);
    return SourceTextLiteralNodeTypedLiteralRowIndexPlusOne(nodes, stringNode) == 1
        && SourceTypedLiteralRowForToken(moduleFacts, literalToken) == 1
        && value.Index() == 1
        && MirOpcodeOf(instrs, value) == MirOp.TextConstantValue
        && MirValueType(instrs, value.Index()) == MirType.Ptr
        && MirTextConstantValueRowIndexOf(instrs, value) == 1
        && MirTextConstantValuePayloadStartOf(instrs, value) == 1
        && MirTextConstantValuePayloadByteLengthOf(instrs, value) == 2
        && MirTextConstantValueCodePointLengthOf(instrs, value) == 2
        && MirTextConstantValueStorageEncodingOf(instrs, value) == MirTextConstantStorageEncoding.AsciiBytes
        && facts.HasTextConstant()
        && facts.TextConstantRowIndex() == 1
        && facts.TextConstantPayloadByteLength() == 2
        && facts.TextConstantCodePointLength() == 2
        && facts.TextConstantStorageEncodingCode() == MirTextConstantStorageEncodingCode(MirTextConstantStorageEncoding.AsciiBytes);
}

[Fact]
fn bool SourceModuleFloatLiteralConstantFactsPreserveParsePayloads()
{
    stack ascii source = "fn f64 Floats()\n{\n    return 1.5f;\n    return 2.25;\n}\n";
    stack mut TokenStream stream = new();
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    if (!BuildFloatLiteralModuleFactsForSource(source, stream, moduleFacts))
    {
        return false;
    }

    stack u32[0 max] f32Row = SourceFloatConstantRowForTypedLiteralRow(moduleFacts, 1);
    stack u32[0 max] f64Row = SourceFloatConstantRowForTypedLiteralRow(moduleFacts, 2);
    return SourceModuleFloatLiteralConstantRowsAreAligned(moduleFacts)
        && moduleFacts.LiteralExpressions.Count() == 2
        && moduleFacts.FloatConstants.Count() == 2
        && moduleFacts.FloatPayloadBytes.Count() == 7
        && f32Row == 1
        && f64Row == 2
        && MirFloatConstantPayloadStart(moduleFacts.FloatConstants, f32Row) == 1
        && MirFloatConstantPayloadByteLength(moduleFacts.FloatConstants, f32Row) == 3
        && MirFloatConstantType(moduleFacts.FloatConstants, f32Row) == MirType.F32
        && MirFloatConstantBitWidthOf(moduleFacts.FloatConstants, f32Row) == 32
        && MirFloatConstantPayloadStart(moduleFacts.FloatConstants, f64Row) == 4
        && MirFloatConstantPayloadByteLength(moduleFacts.FloatConstants, f64Row) == 4
        && MirFloatConstantType(moduleFacts.FloatConstants, f64Row) == MirType.F64
        && MirFloatConstantBitWidthOf(moduleFacts.FloatConstants, f64Row) == 64
        && moduleFacts.FloatPayloadBytes.Get(1) == 49
        && moduleFacts.FloatPayloadBytes.Get(2) == 46
        && moduleFacts.FloatPayloadBytes.Get(3) == 53
        && moduleFacts.FloatPayloadBytes.Get(4) == 50
        && moduleFacts.FloatPayloadBytes.Get(5) == 46
        && moduleFacts.FloatPayloadBytes.Get(6) == 50
        && moduleFacts.FloatPayloadBytes.Get(7) == 53;
}

[Fact]
fn bool SourceFloatLiteralNodeLoweringEmitsMirDescriptor()
{
    stack ascii source = "fn f64 Floats()\n{\n    return 1.5f;\n    return 2.25;\n}\n";
    stack mut TokenStream stream = new();
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    if (!BuildFloatLiteralModuleFactsForSource(source, stream, moduleFacts))
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] f32LiteralToken = moduleFacts.LiteralExpressions.LiteralTokenAt(0);
    stack u32[0 max] f64LiteralToken = moduleFacts.LiteralExpressions.LiteralTokenAt(1);
    stack u32[0 max] f32Node = MakeFloatLit(nodes, f32LiteralToken, 0);
    stack u32[0 max] f64Node = MakeFloatLit(nodes, f64LiteralToken, 0);
    if (!LinkSourceFloatLiteralRowsFromModuleFacts(nodes, moduleFacts))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId f32Value = LowerExprNodeWithModuleFacts(nodes, f32Node, instrs, moduleFacts);
    stack MirValueId f64Value = LowerExprNodeWithModuleFacts(nodes, f64Node, instrs, moduleFacts);
    return SourceFloatLiteralNodeTypedLiteralRowIndexPlusOne(nodes, f32Node) == 1
        && SourceFloatLiteralNodeTypedLiteralRowIndexPlusOne(nodes, f64Node) == 2
        && SourceTypedLiteralRowForToken(moduleFacts, f32LiteralToken) == 1
        && SourceTypedLiteralRowForToken(moduleFacts, f64LiteralToken) == 2
        && f32Value.Index() == 1
        && f64Value.Index() == 2
        && MirOpcodeOf(instrs, f32Value) == MirOp.FloatConstantValue
        && MirOpcodeOf(instrs, f64Value) == MirOp.FloatConstantValue
        && MirValueType(instrs, f32Value.Index()) == MirType.F32
        && MirValueType(instrs, f64Value.Index()) == MirType.F64
        && MirFloatConstantValueRowIndexOf(instrs, f32Value) == 1
        && MirFloatConstantValuePayloadStartOf(instrs, f32Value) == 1
        && MirFloatConstantValuePayloadByteLengthOf(instrs, f32Value) == 3
        && MirFloatConstantValueBitWidthOf(instrs, f32Value) == 32
        && MirFloatConstantValueTypeOf(instrs, f32Value) == MirType.F32
        && MirFloatConstantValueRowIndexOf(instrs, f64Value) == 2
        && MirFloatConstantValuePayloadStartOf(instrs, f64Value) == 4
        && MirFloatConstantValuePayloadByteLengthOf(instrs, f64Value) == 4
        && MirFloatConstantValueBitWidthOf(instrs, f64Value) == 64
        && MirFloatConstantValueTypeOf(instrs, f64Value) == MirType.F64;
}

[Fact]
fn bool SourceEnumExpressionNodesPreserveOwnerFacts()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] tagged = MakeEnumVariant(nodes, TypeIdOf(3), 1);
    stack u32[0 max] payload = MakeIntLit(nodes, 99);
    stack u32[0 max] inserted = MakeEnumPayloadInsert(nodes, TypeIdOf(3), 1, 0, tagged, payload, SourceResolvedFieldTypeCodeI32());
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut u32[0 max] taggedOwner = 0;
    stack mut u32[0 max] insertedOwner = 0;
    return TypeOfNodeWithLocals(nodes, tagged, localTypes) == ExprType.EnumType
        && TypeOfNodeWithLocals(nodes, inserted, localTypes) == ExprType.EnumType
        && TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, tagged, localTypes, taggedOwner)
        && TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, inserted, localTypes, insertedOwner)
        && taggedOwner == 3
        && insertedOwner == 3;
}

[Fact]
fn bool SourceAggregateLocalTypeCodesDoNotMasqueradeAsScalars()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] fixedArrayParam = MakeName(nodes, 0);
    stack u32[0 max] structValueParam = MakeName(nodes, 1);
    stack u32[0 max] scalarParam = MakeName(nodes, 2);
    stack u32[0 max] structTypeToken = 44;
    stack u32[0 max] structLocalTypeCode = SourceLocalTypeCodeForStructValueTypeToken(structTypeToken);
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack u32[0 max] fixedArrayTypeSlot = localTypes.Add(SourceLocalTypeCodeFixedArrayParam());
    stack u32[0 max] structTypeSlot = localTypes.Add(structLocalTypeCode);
    stack u32[0 max] scalarTypeSlot = localTypes.Add(SourceLocalTypeCodeI32());
    return fixedArrayTypeSlot == 1
        && structTypeSlot == 2
        && scalarTypeSlot == 3
        && TypeOfNodeWithLocals(nodes, fixedArrayParam, localTypes) == ExprType.AggregateType
        && TypeOfNodeWithLocals(nodes, structValueParam, localTypes) == ExprType.AggregateType
        && TypeOfNodeWithLocals(nodes, scalarParam, localTypes) == ExprType.IntType
        && SourceLocalTypeCodeForNodeWithLocals(nodes, fixedArrayParam, localTypes) == SourceLocalTypeCodeFixedArrayParam()
        && SourceLocalTypeCodeForNodeWithLocals(nodes, structValueParam, localTypes) == structLocalTypeCode
        && SourceLocalTypeCodeStructValueTypeToken(structLocalTypeCode) == structTypeToken;
}

[Fact]
fn bool SourceSwitchPatternDescriptorsPreserveShapeFacts()
{
    stack SourceSwitchAggregatePatternDescriptor plain =
        MakeSourceSwitchAggregatePatternDescriptor(44, 0, 3, 2);
    stack SourceSwitchAggregatePatternDescriptor variant =
        MakeSourceSwitchAggregatePatternDescriptor(45, 6, 7, 4);
    stack SourceSwitchListPatternDescriptor list =
        MakeSourceSwitchListPatternDescriptor(SourceResolvedFieldTypeCodeI32(), 3, 11, 2);
    return plain.OwnerTypeToken == 44
        && !SourceSwitchAggregatePatternHasEnumVariant(plain)
        && SourceSwitchAggregatePatternEnumVariantOrdinal(plain) == 0
        && variant.OwnerTypeToken == 45
        && SourceSwitchAggregatePatternHasEnumVariant(variant)
        && SourceSwitchAggregatePatternEnumVariantOrdinal(variant) == 5
        && variant.FieldPatternStart == 7
        && variant.FieldPatternCount == 4
        && list.ElementTypeCode == SourceResolvedFieldTypeCodeI32()
        && list.FixedLength == 3
        && list.ElementPatternStart == 11
        && list.ElementPatternCount == 2;
}

[Fact]
fn bool SourceSwitchPatternDecisionKindsClassifyNodeShapes()
{
    return SourceSwitchPatternDecisionKindIsKnown(SourceSwitchPatternDecisionKindDiscard())
        && SourceSwitchPatternDecisionKindIsKnown(SourceSwitchPatternDecisionKindScalarInterval())
        && SourceSwitchPatternDecisionKindIsKnown(SourceSwitchPatternDecisionKindCapture())
        && SourceSwitchPatternDecisionKindIsKnown(SourceSwitchPatternDecisionKindAggregate())
        && SourceSwitchPatternDecisionKindIsKnown(SourceSwitchPatternDecisionKindEnumAggregate())
        && SourceSwitchPatternDecisionKindIsKnown(SourceSwitchPatternDecisionKindList())
        && !SourceSwitchPatternDecisionKindIsKnown(99)
        && !SourceSwitchPatternDecisionKindIsNestedShape(SourceSwitchPatternDecisionKindScalarInterval())
        && !SourceSwitchPatternDecisionKindIsNestedShape(SourceSwitchPatternDecisionKindCapture())
        && SourceSwitchPatternDecisionKindIsNestedShape(SourceSwitchPatternDecisionKindAggregate())
        && SourceSwitchPatternDecisionKindIsNestedShape(SourceSwitchPatternDecisionKindEnumAggregate())
        && SourceSwitchPatternDecisionKindIsNestedShape(SourceSwitchPatternDecisionKindList());
}

[Fact]
fn bool SourceSwitchPatternDecisionNodesPreserveBackendFactRows()
{
    stack SourceSwitchPatternDecisionNode scalar =
        MakeSourceSwitchPatternDecisionNode(
            SourceSwitchPatternDecisionKindScalarInterval(),
            SourceResolvedFieldTypeCodeI64(),
            -7,
            13,
            0,
            0,
            0);
    stack SourceSwitchPatternDecisionNode capture =
        MakeSourceSwitchPatternDecisionNode(
            SourceSwitchPatternDecisionKindCapture(),
            SourceResolvedFieldTypeCodeI32(),
            0,
            0,
            55,
            0,
            0);
    stack SourceSwitchPatternDecisionNode aggregate =
        MakeSourceSwitchPatternDecisionNode(
            SourceSwitchPatternDecisionKindEnumAggregate(),
            SourceResolvedFieldTypeCodeInvalid(),
            0,
            0,
            0,
            3,
            0);
    stack SourceSwitchPatternDecisionNode list =
        MakeSourceSwitchPatternDecisionNode(
            SourceSwitchPatternDecisionKindList(),
            SourceResolvedFieldTypeCodeInvalid(),
            0,
            0,
            0,
            0,
            4);
    stack SourceSwitchPatternDecisionMember member =
        MakeSourceSwitchPatternDecisionMember(2, 9);
    return scalar.Kind == SourceSwitchPatternDecisionKindScalarInterval()
        && scalar.TypeCode == SourceResolvedFieldTypeCodeI64()
        && scalar.MinValue == -7
        && scalar.MaxValue == 13
        && SourceSwitchPatternDecisionNodeHasNoNestedRows(scalar)
        && capture.Kind == SourceSwitchPatternDecisionKindCapture()
        && capture.TypeCode == SourceResolvedFieldTypeCodeI32()
        && capture.CaptureNameToken == 55
        && SourceSwitchPatternDecisionNodeHasNoNestedRows(capture)
        && SourceSwitchPatternDecisionNodeUsesAggregateDescriptor(aggregate)
        && aggregate.AggregateDescriptorRow == 3
        && SourceSwitchPatternDecisionNodeUsesListDescriptor(list)
        && list.ListDescriptorRow == 4
        && member.Ordinal == 2
        && member.NodeRow == 9;
}

[Fact]
fn bool SourceSwitchPatternDecisionAppendHelpersValidateRows()
{
    stack mut IrTable<SourceSwitchPatternDecisionNode> nodes = new();
    stack mut IrTable<SourceSwitchPatternDecisionMember> members = new();
    stack mut IrTable<SourceSwitchAggregatePatternDescriptor> aggregateDescriptors = new();
    stack mut IrTable<SourceSwitchListPatternDescriptor> listDescriptors = new();
    stack u32[0 max] aggregateDescriptorRow =
        aggregateDescriptors.Add(MakeSourceSwitchAggregatePatternDescriptor(44, 0, 3, 2));
    stack u32[0 max] enumDescriptorRow =
        aggregateDescriptors.Add(MakeSourceSwitchAggregatePatternDescriptor(45, 6, 7, 4));
    stack u32[0 max] listDescriptorRow =
        listDescriptors.Add(MakeSourceSwitchListPatternDescriptor(SourceResolvedFieldTypeCodeI32(), 3, 11, 2));
    if (aggregateDescriptorRow == 0 || enumDescriptorRow == 0 || listDescriptorRow == 0)
    {
        return false;
    }

    stack mut u32[0 max] discardNodeRow = 0;
    stack mut u32[0 max] scalarNodeRow = 0;
    stack mut u32[0 max] captureNodeRow = 0;
    stack mut u32[0 max] aggregateNodeRow = 0;
    stack mut u32[0 max] enumNodeRow = 0;
    stack mut u32[0 max] listNodeRow = 0;
    stack mut u32[0 max] memberRow = 0;
    if (!TryAppendSourceSwitchDiscardPatternDecisionNode(nodes, discardNodeRow)
        || !TryAppendSourceSwitchScalarPatternDecisionNode(SourceResolvedFieldTypeCodeI32(), -4, 9, nodes, scalarNodeRow)
        || TryAppendSourceSwitchScalarPatternDecisionNode(SourceResolvedFieldTypeCodeBool(), 0, 2, nodes, scalarNodeRow)
        || !TryAppendSourceSwitchCapturePatternDecisionNode(SourceResolvedFieldTypeCodeI64(), 77, nodes, captureNodeRow)
        || TryAppendSourceSwitchCapturePatternDecisionNode(SourceResolvedFieldTypeCodeInvalid(), 77, nodes, captureNodeRow)
        || !TryAppendSourceSwitchAggregatePatternDecisionNode(false, aggregateDescriptorRow, aggregateDescriptors, nodes, aggregateNodeRow)
        || !TryAppendSourceSwitchAggregatePatternDecisionNode(true, enumDescriptorRow, aggregateDescriptors, nodes, enumNodeRow)
        || TryAppendSourceSwitchAggregatePatternDecisionNode(true, aggregateDescriptorRow, aggregateDescriptors, nodes, enumNodeRow)
        || TryAppendSourceSwitchAggregatePatternDecisionNode(false, enumDescriptorRow, aggregateDescriptors, nodes, aggregateNodeRow)
        || TryAppendSourceSwitchAggregatePatternDecisionNode(false, 99, aggregateDescriptors, nodes, aggregateNodeRow)
        || !TryAppendSourceSwitchListPatternDecisionNode(listDescriptorRow, listDescriptors, nodes, listNodeRow)
        || TryAppendSourceSwitchListPatternDecisionNode(99, listDescriptors, nodes, listNodeRow)
        || !TryAppendSourceSwitchPatternDecisionMember(3, scalarNodeRow, nodes, members, memberRow)
        || TryAppendSourceSwitchPatternDecisionMember(3, 99, nodes, members, memberRow))
    {
        return false;
    }

    stack SourceSwitchPatternDecisionNode discard = nodes.Get(discardNodeRow);
    stack SourceSwitchPatternDecisionNode scalar = nodes.Get(scalarNodeRow);
    stack SourceSwitchPatternDecisionNode capture = nodes.Get(captureNodeRow);
    stack SourceSwitchPatternDecisionNode aggregate = nodes.Get(aggregateNodeRow);
    stack SourceSwitchPatternDecisionNode enumAggregate = nodes.Get(enumNodeRow);
    stack SourceSwitchPatternDecisionNode list = nodes.Get(listNodeRow);
    stack SourceSwitchPatternDecisionMember member = members.Get(memberRow);
    return discard.Kind == SourceSwitchPatternDecisionKindDiscard()
        && scalar.Kind == SourceSwitchPatternDecisionKindScalarInterval()
        && scalar.TypeCode == SourceResolvedFieldTypeCodeI32()
        && scalar.MinValue == -4
        && scalar.MaxValue == 9
        && capture.Kind == SourceSwitchPatternDecisionKindCapture()
        && capture.TypeCode == SourceResolvedFieldTypeCodeI64()
        && capture.CaptureNameToken == 77
        && aggregate.Kind == SourceSwitchPatternDecisionKindAggregate()
        && SourceSwitchPatternDecisionNodeUsesAggregateDescriptor(aggregate)
        && aggregate.AggregateDescriptorRow == aggregateDescriptorRow
        && enumAggregate.Kind == SourceSwitchPatternDecisionKindEnumAggregate()
        && SourceSwitchPatternDecisionNodeUsesAggregateDescriptor(enumAggregate)
        && enumAggregate.AggregateDescriptorRow == enumDescriptorRow
        && SourceSwitchPatternDecisionNodeUsesListDescriptor(list)
        && list.ListDescriptorRow == listDescriptorRow
        && member.Ordinal == 3
        && member.NodeRow == scalarNodeRow;
}

[Fact]
fn bool SourceSwitchPatternDecisionMemberSpanValidationRejectsMalformedNodes()
{
    stack mut IrTable<SourceSwitchPatternDecisionNode> nodes = new();
    stack mut IrTable<SourceSwitchPatternDecisionMember> members = new();
    stack mut IrTable<SourceSwitchAggregatePatternDescriptor> aggregateDescriptors = new();
    stack mut IrTable<SourceSwitchListPatternDescriptor> listDescriptors = new();
    stack u32[0 max] aggregateDescriptorRow =
        aggregateDescriptors.Add(MakeSourceSwitchAggregatePatternDescriptor(44, 0, 3, 2));
    stack u32[0 max] enumDescriptorRow =
        aggregateDescriptors.Add(MakeSourceSwitchAggregatePatternDescriptor(45, 2, 7, 4));
    stack u32[0 max] listDescriptorRow =
        listDescriptors.Add(MakeSourceSwitchListPatternDescriptor(SourceResolvedFieldTypeCodeI32(), 3, 11, 2));
    if (aggregateDescriptorRow == 0 || enumDescriptorRow == 0 || listDescriptorRow == 0)
    {
        return false;
    }

    stack mut u32[0 max] scalarNodeRow = 0;
    stack mut u32[0 max] captureNodeRow = 0;
    stack mut u32[0 max] aggregateNodeRow = 0;
    stack mut u32[0 max] listNodeRow = 0;
    stack mut u32[0 max] scalarMemberRow = 0;
    stack mut u32[0 max] captureMemberRow = 0;
    stack mut u32[0 max] aggregateMemberRow = 0;
    stack mut u32[0 max] listMemberRow = 0;
    if (!TryAppendSourceSwitchScalarPatternDecisionNode(SourceResolvedFieldTypeCodeI32(), -4, 9, nodes, scalarNodeRow)
        || !TryAppendSourceSwitchCapturePatternDecisionNode(SourceResolvedFieldTypeCodeI64(), 77, nodes, captureNodeRow)
        || !TryAppendSourceSwitchAggregatePatternDecisionNode(false, aggregateDescriptorRow, aggregateDescriptors, nodes, aggregateNodeRow)
        || !TryAppendSourceSwitchListPatternDecisionNode(listDescriptorRow, listDescriptors, nodes, listNodeRow)
        || !TryAppendSourceSwitchPatternDecisionMember(0, scalarNodeRow, nodes, members, scalarMemberRow)
        || !TryAppendSourceSwitchPatternDecisionMember(1, captureNodeRow, nodes, members, captureMemberRow)
        || !TryAppendSourceSwitchPatternDecisionMember(2, aggregateNodeRow, nodes, members, aggregateMemberRow)
        || !TryAppendSourceSwitchPatternDecisionMember(3, listNodeRow, nodes, members, listMemberRow)
        || scalarMemberRow != 1
        || captureMemberRow != 2
        || aggregateMemberRow != 3
        || listMemberRow != 4)
    {
        return false;
    }

    stack u32[0 max] badKindNodeRow =
        nodes.Add(MakeSourceSwitchPatternDecisionNode(99, SourceResolvedFieldTypeCodeInvalid(), 0, 0, 0, 0, 0));
    stack u32[0 max] wrongAggregateNodeRow =
        nodes.Add(
            MakeSourceSwitchPatternDecisionNode(
                SourceSwitchPatternDecisionKindAggregate(),
                SourceResolvedFieldTypeCodeInvalid(),
                0,
                0,
                0,
                enumDescriptorRow,
                0));
    stack u32[0 max] badListNodeRow =
        nodes.Add(
            MakeSourceSwitchPatternDecisionNode(
                SourceSwitchPatternDecisionKindList(),
                SourceResolvedFieldTypeCodeInvalid(),
                0,
                0,
                0,
                0,
                99));
    if (badKindNodeRow == 0 || wrongAggregateNodeRow == 0 || badListNodeRow == 0)
    {
        return false;
    }

    stack u32[0 max] badKindMemberRow = members.Add(MakeSourceSwitchPatternDecisionMember(0, badKindNodeRow));
    stack u32[0 max] wrongAggregateMemberRow = members.Add(MakeSourceSwitchPatternDecisionMember(0, wrongAggregateNodeRow));
    stack u32[0 max] badListMemberRow = members.Add(MakeSourceSwitchPatternDecisionMember(0, badListNodeRow));
    if (badKindMemberRow == 0 || wrongAggregateMemberRow == 0 || badListMemberRow == 0)
    {
        return false;
    }

    return SourceSwitchPatternDecisionMemberSpanIsValid(
            scalarMemberRow,
            4,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors)
        && !SourceSwitchPatternDecisionMemberSpanIsValid(
            badKindMemberRow,
            1,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors)
        && !SourceSwitchPatternDecisionMemberSpanIsValid(
            wrongAggregateMemberRow,
            1,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors)
        && !SourceSwitchPatternDecisionMemberSpanIsValid(
            badListMemberRow,
            1,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors)
        && !SourceSwitchPatternDecisionMemberSpanIsValid(
            4294967295,
            2,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors);
}

[Fact]
fn bool SourceSwitchScalarPatternDecisionMembersMirrorPatternRows()
{
    stack mut IrTable<u32[0 max]> patternOrdinals = new();
    stack mut IrTable<u32[0 max]> patternTypeCodes = new();
    stack mut IrTable<u32[0 max]> patternKinds = new();
    stack mut IrTable<i64[min max]> patternMinValues = new();
    stack mut IrTable<i64[min max]> patternMaxValues = new();
    stack u32[0 max] firstOrdinalRow = patternOrdinals.Add(0);
    stack u32[0 max] firstTypeRow = patternTypeCodes.Add(SourceResolvedFieldTypeCodeI32());
    stack u32[0 max] firstKindRow = patternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval());
    stack u32[0 max] firstMinRow = patternMinValues.Add(1);
    stack u32[0 max] firstMaxRow = patternMaxValues.Add(4);
    stack u32[0 max] secondOrdinalRow = patternOrdinals.Add(2);
    stack u32[0 max] secondTypeRow = patternTypeCodes.Add(SourceResolvedFieldTypeCodeBool());
    stack u32[0 max] secondKindRow = patternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval());
    stack u32[0 max] secondMinRow = patternMinValues.Add(1);
    stack u32[0 max] secondMaxRow = patternMaxValues.Add(1);
    if (firstOrdinalRow != firstTypeRow
        || firstOrdinalRow != firstKindRow
        || firstOrdinalRow != firstMinRow
        || firstOrdinalRow != firstMaxRow
        || secondOrdinalRow != secondTypeRow
        || secondOrdinalRow != secondKindRow
        || secondOrdinalRow != secondMinRow
        || secondOrdinalRow != secondMaxRow)
    {
        return false;
    }

    stack mut IrTable<SourceSwitchPatternDecisionNode> nodes = new();
    stack mut IrTable<SourceSwitchPatternDecisionMember> members = new();
    stack mut u32[0 max] memberStart = 0;
    stack mut u32[0 max] memberCount = 0;
    if (!TryBuildSourceSwitchScalarPatternDecisionMembers(
            1,
            2,
            patternOrdinals,
            patternTypeCodes,
            patternKinds,
            patternMinValues,
            patternMaxValues,
            nodes,
            members,
            memberStart,
            memberCount)
        || memberStart != 1
        || memberCount != 2
        || nodes.Count() != 2
        || members.Count() != 2)
    {
        return false;
    }

    stack SourceSwitchPatternDecisionMember firstMember = members.Get(1);
    stack SourceSwitchPatternDecisionMember secondMember = members.Get(2);
    stack SourceSwitchPatternDecisionNode firstNode = nodes.Get(firstMember.NodeRow);
    stack SourceSwitchPatternDecisionNode secondNode = nodes.Get(secondMember.NodeRow);
    return firstMember.Ordinal == 0
        && firstNode.Kind == SourceSwitchPatternDecisionKindScalarInterval()
        && firstNode.TypeCode == SourceResolvedFieldTypeCodeI32()
        && firstNode.MinValue == 1
        && firstNode.MaxValue == 4
        && secondMember.Ordinal == 2
        && secondNode.Kind == SourceSwitchPatternDecisionKindScalarInterval()
        && secondNode.TypeCode == SourceResolvedFieldTypeCodeBool()
        && secondNode.MinValue == 1
        && secondNode.MaxValue == 1;
}

[Fact]
fn bool SourceSwitchStructFieldRowsTranslateToPatternDecisionMembers()
{
    stack mut IrTable<u32[0 max]> fieldPatternIndices = new();
    stack mut IrTable<u32[0 max]> fieldPatternTypeCodes = new();
