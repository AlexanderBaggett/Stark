[Fact]
fn bool BinaryRoundTripsPointerMemoryInstructions()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 16, 8);
    stack MirValueId field = MirPtrOffset(instrs, alloc, 4, 4);
    stack MirValueId value = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId store = MirStorePtrAlignedTyped(instrs, MirType.I32, field, value, 4);
    stack MirValueId load = MirLoadPtrAlignedTyped(instrs, MirType.I32, field, 4);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 5, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction fieldBack = back.Get(2);
    stack MirInstruction storeBack = back.Get(4);
    stack MirInstruction loadBack = back.Get(5);
    return back.Count() == 5
        && store.Index() == 4
        && load.Index() == 5
        && fieldBack.Opcode() == MirOp.PtrOffset
        && fieldBack.ResultType() == MirType.Ptr
        && fieldBack.OperandAIndex() == alloc.Index()
        && fieldBack.OperandBIndex() == 4
        && fieldBack.Immediate() == 4
        && storeBack.Opcode() == MirOp.StorePtr
        && storeBack.ResultType() == MirType.I32
        && storeBack.OperandAIndex() == field.Index()
        && storeBack.OperandBIndex() == value.Index()
        && storeBack.OperandCIndex() == 4
        && loadBack.Opcode() == MirOp.LoadPtr
        && loadBack.ResultType() == MirType.I32
        && loadBack.OperandAIndex() == field.Index()
        && loadBack.OperandBIndex() == 4;
}

