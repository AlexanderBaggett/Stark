        && System.Text.Contains(sink.View(), "store [3 x i64] %p0, ptr")
        && System.Text.Contains(sink.View(), ".scale = mul i64 %p1, 8")
        && System.Text.Contains(sink.View(), "call i64 @f1(ptr")
        && ClangVerifiesLlvmText(sink);
}

