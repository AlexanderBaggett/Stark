[Fact]
fn bool PackageTablesPreserveTerminalIntegerSwitch()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Classify(i64[min max] x) { switch (x) { case 0: return 10; case 1: return 20; default: return 30; } }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId firstCondition = MirBlockCondValue(blocks, MirBlockIdOf(1));
    stack MirValueId secondCondition = MirBlockCondValue(blocks, MirBlockIdOf(2));
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 5
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 5
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 8
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.Return
        && MirBlockTerminator(blocks, MirBlockIdOf(4)) == MirTermKind.Return
        && MirBlockTerminator(blocks, MirBlockIdOf(5)) == MirTermKind.Return
        && MirBlockCondThen(blocks, MirBlockIdOf(1)) == MirBlockIdOf(3)
        && MirBlockCondElse(blocks, MirBlockIdOf(1)) == MirBlockIdOf(2)
        && MirBlockCondThen(blocks, MirBlockIdOf(2)) == MirBlockIdOf(4)
        && MirBlockCondElse(blocks, MirBlockIdOf(2)) == MirBlockIdOf(5)
        && MirOpcodeOf(instrs, firstCondition) == MirOp.CmpEq
        && MirOpcodeOf(instrs, secondCondition) == MirOp.CmpEq;
}

