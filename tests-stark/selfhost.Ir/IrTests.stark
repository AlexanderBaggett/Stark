                "import Source.Import\nexport import Source.Export\nexport import Source.Both\nexport import Source.ReExport\n\n[Backend(Opaque)]\nmodule Source\n\npublic alias Pair<T, comptime type U> = (T, U);\n\n[Backend(Opaque)]\n[StructLayout(C), Pack(4), Align(8)]\n[Grant(Shareable) where Transferable(T)] public struct Buffer<T>\n{\n    [FieldOffset(0)] [Deny(Transferable)] internal rawptr<T> Data;\n    u64[0 max] Length;\n}\npublic enum Outcome<T>\n{\n    [Ok] Value(T),\n    Named { code: u32[0 max] },\n    [Err] Failure from Source.Error,\n}\npublic record Packet<T>(const rawptr<T>[count] Data, u64[0 max] count) : Source.Copyable, Source.Serializable\n{\n    alias Element = T;\n    alias Required;\n\n    u32[0 max] Code;\n\n    Packet(u32[0 max] code) { self.Code = code; }\n\n    mut drop { self.Code = 0; }\n\n    [Backend(Opaque)]\n    public static hot inline finite law u32[0 max] Inspect() { return 7; }\n}\npublic trait Handler\n{\n    alias Input;\n}\npublic dyn trait Dispatcher\n{\n    finite law u32[0 max] Dispatch(borrow Self self);\n}\npublic doctrine Rules<T>\n{\n    alias Item = T;\n\n    law bool Check(T value);\n}\n\npublic const u32 Zero = 0;\ninternal const bool[2] Flags = { false, false };\npublic static u64[0 max] Epoch;\ninternal static mut bool Enabled;\n\n[LinkName(\"source_copy\")]\n[Backend(Opaque)]\npublic strictfp hot inline unsafe ffi(c) varargs tail finite bool Copy<T>(disjoint const rawptr<u8[0 max]>[count] input, rawmutptr<u8[0 max]>[count] output, u64[0 max] count) where T: Source.Copyable where disjoint(input[0, count], output[0, count]) where dead_on_return(input) where Transferable(T) where count > 0;\npublic finite law T Identity<T>(T value) { return value; }\npublic finite law T Invoke<T>(T value) {\n    stack mut Source.Option<T> current = { Value = Source.Option.None };\n    stack fnptr<unsafe ffi(c) tail finite law void(rawptr<u8[0 max]>[count]) where overlap(arg0, arg1), same(arg0, arg2), dead_on_return(arg0)> callback = value;\n    stack heap closure<once tail finite law void(u8[0 max])> closureValue = value;\n    Source.Option.None;\n    (u8[0 max])Source.Option.None;\n    comptime (true ? Source.Option.None : Source.Option.None);\n    if (true is true) {\n        Source.Option.None;\n    } else {\n        ;\n    }\n    retry: while willexit bounded (false) {\n        Source.Option.None;\n        break retry;\n    }\n    for willexit independent (stack mut u8[0 max][4] index = { 0, 0, 0, 0 }; false; index = 0) {\n        Source.Option.None;\n    }\n    for willexit (register u64[0 max] itemIndex, borrow rawptr<u8[0 max]> item in value) {\n        Source.Option.None;\n    }\n    switch (value)\n    {\n        case Source.Option<T>.Some { Value: var payload }:\n            Source.Option.None;\n        case 0..3 when true:\n            Source.Option.None;\n        case [_, var tail]:\n            Source.Option.None;\n        default:\n            Source.Option.None;\n    }\n    {\n        Source.Option.None;\n    }\n    value = Source.Option.Make(value);\n    return Source.Identity<T, comptime N>(value.Value.Combine<T, 4>(Source.Option<T, comptime N>.Some(new(arena, 16)), Source.Option.Make(value), Source.Option.None));\n}\n")
            && TryBuildLogicalPackageLoadedSourceDocument(manifestJson, 0, loaded)
            && loaded.ModuleOrdinal() == 0
            && loaded.SourceTextEquals(rendered.View())
            && loaded.Syntax().Succeeded()
            && loaded.Syntax().HeaderCount() == 5
            && !loaded.Syntax().HeaderItemAt(0).IsExported
            && loaded.Syntax().HeaderItemAt(1).IsExported
            && loaded.Syntax().HeaderItemAt(2).IsExported
            && loaded.Syntax().HeaderItemAt(3).IsExported
            && loaded.Syntax().DeclarationCount() == 14
            && !TryRenderLogicalPackageSourceBridgePrefix(
                unsupportedManifestJson,
                0,
                rejected)
            && !TryRenderLogicalPackageSourceBridgePrefix(
                unsupportedGlobalManifestJson,
                0,
                rejectedGlobal)
            && !TryRenderLogicalPackageSourceBridgePrefix(
                unsupportedTypeManifestJson,
                0,
                rejectedType)
            && !TryRenderLogicalPackageSourceBridgePrefix(
                ambiguousTemplateManifestJson,
                0,
                rejectedTemplate)
            && !TryRenderLogicalPackageSourceBridgePrefix(
                unsupportedTypedTemplateManifestJson,
                0,
                rejectedTypedTemplate);
    }
}

