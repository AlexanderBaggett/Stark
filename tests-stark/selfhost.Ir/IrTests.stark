        && template.EnumCallCount() == 1
        && template.EnumValueCount() == 1
        && template.EnumPatternCount() == 1
        && template.DirectCallCount() == 1
        && template.MemberCallCount() == 1
        && template.FunctionAddressCount() == 1
        && objectCreation.FunctionTemplateRow() == 1
        && objectCreation.CreationOrdinal() == 0
        && objectCreation.StorageSelector() == 2
        && objectCreation.HasExpressionText()
        && objectExpressionText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ObjectCreationExpressionText
        && enumConstructor.FunctionTemplateRow() == 1
        && enumConstructor.ConstructorOrdinal() == 0
        && enumConstructor.PublishedOrdinal() == 21
        && enumConstructor.MemberCount() == 0
        && enumCall.CallOrdinal() == 0
        && enumCall.PublishedOrdinal() == 22
        && enumValue.ValueOrdinal() == 0
        && enumValue.PublishedOrdinal() == 23
        && enumPattern.PatternOrdinal() == 0
        && enumPattern.PublishedOrdinal() == 24
        && enumPattern.MemberCount() == 0
        && directCall.ParentKind() == LogicalPackageTemplateCallParentKind.DirectCall
        && directCall.ParentOrdinal() == 0
        && directCall.HasPublishedOrdinal()
        && directCall.PublishedOrdinal() == 31
        && directCall.HasQualifiedSourceName()
        && directCall.HasQualifiedTemplateName()
        && directCall.ParameterCount() == 1
        && directCall.TypeArgumentCount() == 1
        && directCall.ComptimeValueArgumentCount() == 1
        && memberCall.ParentKind() == LogicalPackageTemplateCallParentKind.MemberCall
        && memberCall.PublishedOrdinal() == 32
        && functionAddress.ParentKind() == LogicalPackageTemplateCallParentKind.FunctionAddress
        && functionAddress.PublishedOrdinal() == 33
        && functionAddress.HasTargetType()
        && directParameter.CallSignatureRow() == 1
        && directParameter.ParameterOrdinal() == 0
        && directParameter.IsDisjoint()
        && !directParameter.IsConst()
        && directTypeArgument.CallSignatureRow() == 1
        && directTypeArgument.TypeArgumentOrdinal() == 0
        && directComptimeArgument.CallSignatureRow() == 1
        && directComptimeArgument.ArgumentOrdinal() == 0
        && directComptimeArgument.IsSymbolic()
        && directComptimeArgument.HasSymbolicSourceName()
        && directComptimeArgumentType.Summary().HasBitWidth()
        && directComptimeArgumentType.Summary().BitWidth() == 32
        && objectCreatedType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateObjectCreationCreatedType
        && enumConstructorType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumConstructorEnumType
        && enumCallType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumCallEnumType
        && enumValueType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumValueEnumType
        && enumPatternType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumPatternEnumType
        && directReturnType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallReturnType
        && directParameterType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallParameterType
        && directTypeArgumentType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallTypeArgument
        && directComptimeArgumentType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallComptimeValueArgumentType
        && memberReturnType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallReturnType
        && functionAddressTargetType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressTargetType
        && functionAddressReturnType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressReturnType
        && AppendLogicalPackageGenericTemplateFactText(graph, objectExpressionText, objectExpression)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            enumConstructorVariantText,
            enumConstructorVariantName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, enumCallVariantText, enumCallVariantName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, enumValueVariantText, enumValueVariantName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            enumPatternVariantText,
            enumPatternVariantName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, directResolvedText, directResolvedName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, directParameterNameText, directParameterName)
            == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            objectCreation.CreatedTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            objectTypeName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            functionAddress.TargetTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            functionAddressTargetTypeName)
        && OwnedAsciiEqualsAscii(objectTypeName, "Demo.Box")
        && OwnedAsciiEqualsAscii(objectExpression, "new Demo.Box()")
        && OwnedAsciiEqualsAscii(enumConstructorVariantName, "Some")
        && OwnedAsciiEqualsAscii(enumCallVariantName, "Some")
        && OwnedAsciiEqualsAscii(enumValueVariantName, "None")
        && OwnedAsciiEqualsAscii(enumPatternVariantName, "Some")
        && OwnedAsciiEqualsAscii(directResolvedName, "Demo.Id#0")
        && OwnedAsciiEqualsAscii(directParameterName, "value")
        && OwnedAsciiEqualsAscii(functionAddressTargetTypeName, "Demo.FunctionTarget");
}

[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesGenericTemplateObjectAndEnumPayloads()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] templateRow = 0;
    stack mut u32[0 max] objectCreationRow = 0;
    stack mut u32[0 max] objectMemberRow = 0;
    stack mut u32[0 max] enumConstructorRow = 0;
    stack mut u32[0 max] enumConstructorMemberRow = 0;
    stack mut u32[0 max] enumPatternRow = 0;
    stack mut u32[0 max] enumPatternMemberRow = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddGenericTemplateFunction(
            0,
            "Demo.Project#0",
            "Demo.Project",
            "(input)",
            templateRow)
        || !manifestBuilder.AddGenericTemplateObjectCreation(
            templateRow,
            "Named",
            objectCreationRow)
        || !manifestBuilder.SetGenericTemplateObjectCreationCreatedTypeName(
            objectCreationRow,
            "Demo.Box")
        || !manifestBuilder.SetGenericTemplateObjectCreationConstructor(
            objectCreationRow,
            "Demo.Box",
            2,
            true)
        || !manifestBuilder.AddGenericTemplateObjectInitializerMember(
            objectCreationRow,
            "Value",
            7,
            "Named",
            objectMemberRow)
        || !manifestBuilder.SetGenericTemplateObjectInitializerMemberFieldTypeName(
            objectMemberRow,
            "Demo.Number")
        || !manifestBuilder.AddGenericTemplateEnumConstructor(
            templateRow,
            40,
            "Named",
            "Some",
            enumConstructorRow)
        || !manifestBuilder.SetGenericTemplateEnumConstructorTypeName(
            enumConstructorRow,
            "Demo.Option")
        || !manifestBuilder.AddGenericTemplateEnumConstructorMember(
            enumConstructorRow,
            "Value",
            3,
            "Integer",
            enumConstructorMemberRow)
        || !manifestBuilder.SetGenericTemplateEnumConstructorMemberFieldTypeIntegerFacts(
            enumConstructorMemberRow,
            32,
            "0",
            "max",
            true)
        || !manifestBuilder.AddGenericTemplateEnumPattern(
            templateRow,
            41,
            "Named",
            "Some",
            enumPatternRow)
        || !manifestBuilder.SetGenericTemplateEnumPatternTypeName(
            enumPatternRow,
            "Demo.Option")
        || !manifestBuilder.AddGenericTemplateEnumPatternMember(
            enumPatternRow,
            "Value",
            4,
            "Named",
            enumPatternMemberRow)
        || !manifestBuilder.SetGenericTemplateEnumPatternMemberFieldTypeName(
            enumPatternMemberRow,
            "Demo.Number"))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageGenericTemplateFactGraph graph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageGenericTemplateFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }
    }

    stack LogicalPackageTemplateObjectCreationRow objectCreation =
        graph.TemplateObjectCreationRowAt(1);
    stack LogicalPackageTemplateObjectInitializerMemberRow objectMember =
        graph.TemplateObjectInitializerMemberRowAt(1);
    stack LogicalPackageTemplateEnumConstructorRow enumConstructor =
        graph.TemplateEnumConstructorRowAt(1);
    stack LogicalPackageTemplateEnumConstructorMemberRow enumConstructorMember =
        graph.TemplateEnumConstructorMemberRowAt(1);
    stack LogicalPackageTemplateEnumPatternRow enumPattern =
        graph.TemplateEnumPatternRowAt(1);
    stack LogicalPackageTemplateEnumPatternMemberRow enumPatternMember =
        graph.TemplateEnumPatternMemberRowAt(1);
    stack LogicalPackageTypeReferenceRow objectMemberType =
        graph.TypeReferenceGraph().TypeReferenceAt(objectMember.FieldTypeReferenceRow());
    stack LogicalPackageTypeReferenceRow enumConstructorMemberType =
        graph.TypeReferenceGraph().TypeReferenceAt(enumConstructorMember.FieldTypeReferenceRow());
    stack LogicalPackageTypeReferenceRow enumPatternMemberType =
        graph.TypeReferenceGraph().TypeReferenceAt(enumPatternMember.FieldTypeReferenceRow());
    stack LogicalPackageGenericTemplateFactTextRow constructorTypeNameText =
        graph.TextRowAt(objectCreation.ConstructorTypeNameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow objectMemberFieldNameText =
        graph.TextRowAt(objectMember.FieldNameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow enumConstructorMemberFieldNameText =
        graph.TextRowAt(enumConstructorMember.FieldNameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow enumPatternMemberFieldNameText =
        graph.TextRowAt(enumPatternMember.FieldNameTextRow());
    stack mut OwnedAscii constructorTypeName = new();
    stack mut OwnedAscii objectMemberFieldName = new();
    stack mut OwnedAscii objectMemberTypeName = new();
    stack mut OwnedAscii enumConstructorMemberFieldName = new();
    stack mut OwnedAscii enumPatternMemberFieldName = new();
    stack mut OwnedAscii enumPatternMemberTypeName = new();
    return graph.TemplateObjectCreationRowCount() == 1
        && graph.TemplateObjectInitializerMemberRowCount() == 1
        && graph.TemplateEnumConstructorRowCount() == 1
        && graph.TemplateEnumConstructorMemberRowCount() == 1
        && graph.TemplateEnumPatternRowCount() == 1
        && graph.TemplateEnumPatternMemberRowCount() == 1
        && objectCreation.HasConstructor()
        && objectCreation.ConstructorParameterCount() == 2
        && objectCreation.ConstructorIsPrimaryShape()
        && objectCreation.InitializerMemberCount() == 1
        && constructorTypeNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ObjectCreationConstructorTypeName
        && objectMember.ObjectCreationRow() == 1
        && objectMember.MemberOrdinal() == 0
        && objectMember.FieldIndex() == 7
        && enumConstructor.MemberCount() == 1
        && enumConstructorMember.EnumConstructorRow() == 1
        && enumConstructorMember.MemberOrdinal() == 0
        && enumConstructorMember.FieldIndex() == 3
        && enumPattern.MemberCount() == 1
        && enumPatternMember.EnumPatternRow() == 1
        && enumPatternMember.MemberOrdinal() == 0
        && enumPatternMember.FieldIndex() == 4
        && objectMemberType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateObjectInitializerMemberFieldType
        && enumConstructorMemberType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumConstructorMemberFieldType
        && enumConstructorMemberType.Summary().HasBitWidth()
        && enumConstructorMemberType.Summary().BitWidth() == 32
        && enumPatternMemberType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumPatternMemberFieldType
        && objectMemberFieldNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ObjectInitializerMemberFieldName
        && enumConstructorMemberFieldNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.EnumConstructorMemberFieldName
        && enumPatternMemberFieldNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.EnumPatternMemberFieldName
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            constructorTypeNameText,
            constructorTypeName) == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            objectMemberFieldNameText,
            objectMemberFieldName) == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            objectMember.FieldTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            objectMemberTypeName)
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            enumConstructorMemberFieldNameText,
            enumConstructorMemberFieldName) == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            enumPatternMemberFieldNameText,
            enumPatternMemberFieldName) == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            enumPatternMember.FieldTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            enumPatternMemberTypeName)
        && OwnedAsciiEqualsAscii(constructorTypeName, "Demo.Box")
        && OwnedAsciiEqualsAscii(objectMemberFieldName, "Value")
        && OwnedAsciiEqualsAscii(objectMemberTypeName, "Demo.Number")
        && OwnedAsciiEqualsAscii(enumConstructorMemberFieldName, "Value")
        && OwnedAsciiEqualsAscii(enumPatternMemberFieldName, "Value")
        && OwnedAsciiEqualsAscii(enumPatternMemberTypeName, "Demo.Number");
}

[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesCompilerAbiFunctionFacts()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] abiFunctionRow = 0;
    stack mut u32[0 max] formatParameterRow = 0;
    stack mut u32[0 max] pairParameterRow = 0;
    stack mut u32[0 max] returnBufferParameterRow = 0;
    stack mut u32[0 max] carrier0Row = 0;
    stack mut u32[0 max] carrier1Row = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddCompilerFactAbiFunction(
            0,
            "Demo.CPrintf",
            "printf",
            "Integer",
            "Integer",
            true,
            abiFunctionRow)
        || !manifestBuilder.SetCompilerFactAbiFunctionSourceReturnIntegerFacts(
            abiFunctionRow,
            32,
            "min",
            "max",
            false)
        || !manifestBuilder.SetCompilerFactAbiFunctionLlvmReturnBitWidth(abiFunctionRow, 32)
        || !manifestBuilder.SetCompilerFactAbiFunctionFlags(abiFunctionRow, true, true, false)
        || !manifestBuilder.SetCompilerFactAbiFunctionSourceName(abiFunctionRow, "CPrintf")
        || !manifestBuilder.SetCompilerFactAbiFunctionFfiAbi(abiFunctionRow, "c")
        || !manifestBuilder.SetCompilerFactAbiFunctionLinkName(abiFunctionRow, "printf")
        || !manifestBuilder.AddCompilerFactAbiParameter(
            abiFunctionRow,
            "format",
            "format",
            "RawPointer",
            "RawPointer",
            "direct",
            formatParameterRow)
        || !manifestBuilder.SetCompilerFactAbiParameterRawPointerElementCountExpression(
            formatParameterRow,
            "length")
        || !manifestBuilder.AddCompilerFactAbiParameter(
            abiFunctionRow,
            "pair",
            "pair",
            "Named",
            "Integer",
            "direct",
            pairParameterRow)
        || !manifestBuilder.SetCompilerFactAbiParameterSourceTypeName(pairParameterRow, "Demo.Pair")
        || !manifestBuilder.SetCompilerFactAbiParameterLlvmTypeBitWidth(pairParameterRow, 64)
        || !manifestBuilder.AddCompilerFactAbiParameterLlvmType(pairParameterRow, "Integer", carrier0Row)
        || !manifestBuilder.SetCompilerFactAbiParameterLlvmCarrierTypeBitWidth(carrier0Row, 32)
        || !manifestBuilder.AddCompilerFactAbiParameterLlvmType(pairParameterRow, "Integer", carrier1Row)
        || !manifestBuilder.SetCompilerFactAbiParameterLlvmCarrierTypeBitWidth(carrier1Row, 32)
        || !manifestBuilder.AddCompilerFactAbiParameter(
            abiFunctionRow,
            "ret",
            "ret",
            "RawPointer",
            "RawPointer",
            "sret",
            returnBufferParameterRow))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageAbiFactGraph graph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageAbiFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }
    }

    stack LogicalPackageAbiFunctionRow functionRow = graph.AbiFunctionRowAt(1);
    stack LogicalPackageAbiParameterRow formatParameter = graph.ParameterRowAt(1);
    stack LogicalPackageAbiParameterRow pairParameter = graph.ParameterRowAt(2);
    stack LogicalPackageAbiParameterRow returnBufferParameter = graph.ParameterRowAt(3);
    stack LogicalPackageAbiParameterLlvmTypeRow carrier0 = graph.LlvmParameterTypeRowAt(1);
    stack LogicalPackageAbiParameterLlvmTypeRow carrier1 = graph.LlvmParameterTypeRowAt(2);
    stack LogicalPackageAbiFactTextRow functionNameText =
        graph.TextRowAt(functionRow.QualifiedResolvedNameTextRow());
    stack LogicalPackageAbiFactTextRow ffiAbiText = graph.TextRowAt(functionRow.FfiAbiTextRow());
    stack LogicalPackageAbiFactTextRow rawCountText =
        graph.TextRowAt(formatParameter.RawPointerElementCountExpressionTextRow());
    stack LogicalPackageTypeReferenceSummary sourceReturnSummary =
        graph.TypeReferenceAt(functionRow.SourceReturnTypeReferenceRow()).Summary();
    stack LogicalPackageTypeReferenceSummary llvmReturnSummary =
        graph.TypeReferenceAt(functionRow.LlvmReturnTypeReferenceRow()).Summary();
    stack LogicalPackageTypeReferenceSummary pairSourceSummary =
        graph.TypeReferenceAt(pairParameter.SourceTypeReferenceRow()).Summary();
    stack LogicalPackageTypeReferenceSummary pairLlvmSummary =
        graph.TypeReferenceAt(pairParameter.LlvmTypeReferenceRow()).Summary();
    stack LogicalPackageTypeReferenceSummary carrier0Summary =
        graph.TypeReferenceAt(carrier0.TypeReferenceRow()).Summary();
    stack mut OwnedAscii functionName = new();
    stack mut OwnedAscii ffiAbi = new();
    stack mut OwnedAscii rawCount = new();
    stack mut OwnedAscii pairSourceName = new();
    return graph.AbiFunctionRowCount() == 1
        && graph.ParameterRowCount() == 3
        && graph.LlvmParameterTypeRowCount() == 2
        && graph.TypeReferenceCount() == 10
        && graph.TextRowCount() == 12
        && functionRow.ModuleOrdinal() == 0
        && functionRow.AbiFunctionOrdinal() == 0
        && functionRow.ParameterRowCount() == 3
        && functionRow.IsFfi()
        && functionRow.UsesFastCallingConvention()
        && functionRow.IsVarargs()
        && !functionRow.UsesTailCallingConvention()
        && functionRow.HasSourceName()
        && functionRow.HasFfiAbi()
        && functionRow.HasLinkName()
        && formatParameter.Kind() == LogicalPackageAbiParameterKind.Direct
        && formatParameter.HasRawPointerElementCountExpression()
        && pairParameter.Kind() == LogicalPackageAbiParameterKind.Direct
        && pairParameter.FirstLlvmParameterTypeRow() == 1
        && pairParameter.LlvmParameterTypeRowCount() == 2
        && returnBufferParameter.Kind() == LogicalPackageAbiParameterKind.SRet
        && carrier0.AbiParameterRow() == 2
        && carrier0.TypeOrdinal() == 0
        && carrier1.AbiParameterRow() == 2
        && carrier1.TypeOrdinal() == 1
        && functionNameText.TextKind() == LogicalPackageAbiFactTextKind.QualifiedResolvedName
        && ffiAbiText.TextKind() == LogicalPackageAbiFactTextKind.FfiAbi
        && rawCountText.TextKind() == LogicalPackageAbiFactTextKind.ParameterRawPointerElementCountExpression
        && sourceReturnSummary.Source() == LogicalPackageTypedTypeReferenceSource.AbiFunctionSourceReturn
        && sourceReturnSummary.HasBitWidth()
        && sourceReturnSummary.BitWidth() == 32
        && sourceReturnSummary.HasRangeMin()
        && sourceReturnSummary.HasRangeMax()
        && sourceReturnSummary.HasIsUnsigned()
        && !sourceReturnSummary.IsUnsigned()
        && llvmReturnSummary.Source() == LogicalPackageTypedTypeReferenceSource.AbiFunctionLlvmReturn
        && llvmReturnSummary.HasBitWidth()
        && llvmReturnSummary.BitWidth() == 32
        && pairSourceSummary.Source() == LogicalPackageTypedTypeReferenceSource.AbiParameterSourceType
        && pairSourceSummary.HasName()
        && pairLlvmSummary.HasBitWidth()
        && pairLlvmSummary.BitWidth() == 64
        && carrier0Summary.Source() == LogicalPackageTypedTypeReferenceSource.AbiParameterLlvmCarrierType
        && carrier0Summary.PayloadOrdinal() == 0
        && carrier0Summary.HasBitWidth()
        && carrier0Summary.BitWidth() == 32
        && AppendLogicalPackageAbiFactText(graph, functionNameText, functionName) == MemoryStatus.Ok
        && AppendLogicalPackageAbiFactText(graph, ffiAbiText, ffiAbi) == MemoryStatus.Ok
        && AppendLogicalPackageAbiFactText(graph, rawCountText, rawCount) == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            pairParameter.SourceTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            pairSourceName)
        && OwnedAsciiEqualsAscii(functionName, "Demo.CPrintf")
        && OwnedAsciiEqualsAscii(ffiAbi, "c")
        && OwnedAsciiEqualsAscii(rawCount, "length")
        && OwnedAsciiEqualsAscii(pairSourceName, "Demo.Pair");
}

[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesConcreteLayoutAndNativeMetadataFacts()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] layoutRow = 0;
    stack mut u32[0 max] fieldARow = 0;
    stack mut u32[0 max] fieldBRow = 0;
    stack mut u32[0 max] nativeSourceRow = 0;
    stack mut u32[0 max] nativeLibraryRow = 0;
    stack mut u32[0 max] nativeLinkArgumentRow = 0;
    stack mut u32[0 max] nativePkgConfigRow = 0;
    stack mut u32[0 max] linkageRow = 0;
    stack mut u32[0 max] definedMainRow = 0;
    stack mut u32[0 max] definedHelperRow = 0;
    stack mut u32[0 max] referencedPutsRow = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddCompilerFactConcreteLayout(
            0,
            "Demo.Pair",
            16,
            8,
            layoutRow)
        || !manifestBuilder.AddCompilerFactConcreteField(
            layoutRow,
            "A",
            0,
            4,
            4,
            4,
            false,
            fieldARow)
        || !manifestBuilder.AddCompilerFactConcreteField(
            layoutRow,
            "B",
            8,
            8,
            8,
            8,
            false,
            fieldBRow)
        || !manifestBuilder.AddNativeDependency(
            LogicalPackageNativeDependencyKind.Source,
            "shim.c",
            nativeSourceRow)
        || !manifestBuilder.AddNativeDependency(
            LogicalPackageNativeDependencyKind.Library,
            "raylib",
            nativeLibraryRow)
        || !manifestBuilder.AddNativeDependency(
            LogicalPackageNativeDependencyKind.LinkArgument,
            "-framework",
            nativeLinkArgumentRow)
        || !manifestBuilder.AddNativeDependency(
            LogicalPackageNativeDependencyKind.PkgConfigPackage,
            "raylib",
            nativePkgConfigRow)
        || !manifestBuilder.AddCompilerFactLinkage(0, "Demo.o", linkageRow)
        || !manifestBuilder.AddCompilerFactLinkageDefinedSymbol(
            linkageRow,
            "Demo.main",
            definedMainRow)
        || !manifestBuilder.AddCompilerFactLinkageDefinedSymbol(
            linkageRow,
            "Demo.helper",
            definedHelperRow)
        || !manifestBuilder.AddCompilerFactLinkageReferencedSymbol(
            linkageRow,
            "puts",
            referencedPutsRow))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageLayoutFactGraph layoutGraph = new();
    stack mut LogicalPackageNativeMetadataFactGraph nativeGraph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageLayoutFactJsonGraph(manifestJson, 0, layoutGraph)
            || !TryMaterializeLogicalPackageNativeMetadataFactJsonGraph(
                manifestJson,
                0,
                nativeGraph))
        {
            return false;
        }
    }

    stack LogicalPackageConcreteTypeLayoutRow pairLayout = layoutGraph.ConcreteLayoutRowAt(1);
    stack LogicalPackageConcreteFieldLayoutRow fieldA = layoutGraph.ConcreteFieldRowAt(1);
    stack LogicalPackageConcreteFieldLayoutRow fieldB = layoutGraph.ConcreteFieldRowAt(2);
    stack LogicalPackageLayoutFactTextRow pairNameText =
        layoutGraph.TextRowAt(pairLayout.QualifiedTypeNameTextRow());
    stack LogicalPackageLayoutFactTextRow fieldBNameText =
        layoutGraph.TextRowAt(fieldB.NameTextRow());
    stack LogicalPackageNativeDependencyRow sourceDependency =
        nativeGraph.NativeDependencyRowAt(1);
    stack LogicalPackageNativeDependencyRow libraryDependency =
        nativeGraph.NativeDependencyRowAt(2);
    stack LogicalPackageNativeDependencyRow frameworkDependency =
        nativeGraph.NativeDependencyRowAt(3);
    stack LogicalPackageNativeDependencyRow pkgConfigDependency =
        nativeGraph.NativeDependencyRowAt(4);
    stack LogicalPackageLinkageRow emittedLinkage = nativeGraph.LinkageRowAt(1);
    stack LogicalPackageLinkageSymbolRow definedHelper =
        nativeGraph.DefinedSymbolRowAt(2);
    stack LogicalPackageLinkageSymbolRow referencedPuts =
        nativeGraph.ReferencedSymbolRowAt(1);
    stack LogicalPackageNativeMetadataFactTextRow sourceText =
        nativeGraph.TextRowAt(sourceDependency.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow libraryText =
        nativeGraph.TextRowAt(libraryDependency.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow frameworkText =
        nativeGraph.TextRowAt(frameworkDependency.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow pkgConfigText =
        nativeGraph.TextRowAt(pkgConfigDependency.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow objectFileText =
        nativeGraph.TextRowAt(emittedLinkage.ObjectFileNameTextRow());
    stack LogicalPackageNativeMetadataFactTextRow helperText =
        nativeGraph.TextRowAt(definedHelper.TextRow());
    stack LogicalPackageNativeMetadataFactTextRow putsText =
        nativeGraph.TextRowAt(referencedPuts.TextRow());
    stack mut OwnedAscii pairName = new();
    stack mut OwnedAscii fieldBName = new();
    stack mut OwnedAscii sourceName = new();
    stack mut OwnedAscii libraryName = new();
    stack mut OwnedAscii frameworkToken = new();
    stack mut OwnedAscii pkgConfigName = new();
    stack mut OwnedAscii objectFileName = new();
    stack mut OwnedAscii helperSymbol = new();
    stack mut OwnedAscii putsSymbol = new();
    return layoutGraph.ConcreteLayoutRowCount() == 1
        && layoutGraph.ConcreteFieldRowCount() == 2
        && layoutGraph.EnumLayoutRowCount() == 0
        && layoutGraph.TextRowCount() == 3
        && pairLayout.ModuleOrdinal() == 0
        && pairLayout.LayoutOrdinal() == 0
        && pairLayout.SizeBytes() == 16
        && pairLayout.AlignmentBytes() == 8
        && pairLayout.FirstFieldRow() == 1
        && pairLayout.FieldRowCount() == 2
        && fieldA.ConcreteLayoutRow() == 1
        && fieldA.FieldOrdinal() == 0
        && fieldA.OffsetBytes() == 0
        && fieldA.SizeBytes() == 4
        && fieldA.NaturalAlignmentBytes() == 4
        && fieldA.EffectiveAlignmentBytes() == 4
        && !fieldA.IsMisaligned()
        && fieldB.ConcreteLayoutRow() == 1
        && fieldB.FieldOrdinal() == 1
        && fieldB.OffsetBytes() == 8
        && fieldB.SizeBytes() == 8
        && pairNameText.TextKind() == LogicalPackageLayoutFactTextKind.QualifiedTypeName
        && fieldBNameText.TextKind() == LogicalPackageLayoutFactTextKind.ConcreteFieldName
        && nativeGraph.NativeDependencyRowCount() == 4
        && nativeGraph.LinkageRowCount() == 1
        && nativeGraph.DefinedSymbolRowCount() == 2
        && nativeGraph.ReferencedSymbolRowCount() == 1
        && nativeGraph.TextRowCount() == 8
        && sourceDependency.Kind() == LogicalPackageNativeDependencyKind.Source
        && sourceDependency.DependencyOrdinal() == 0
        && libraryDependency.Kind() == LogicalPackageNativeDependencyKind.Library
        && libraryDependency.DependencyOrdinal() == 0
        && frameworkDependency.Kind() == LogicalPackageNativeDependencyKind.LinkArgument
        && frameworkDependency.DependencyOrdinal() == 0
        && pkgConfigDependency.Kind() == LogicalPackageNativeDependencyKind.PkgConfigPackage
        && pkgConfigDependency.DependencyOrdinal() == 0
        && emittedLinkage.ModuleOrdinal() == 0
        && emittedLinkage.FirstDefinedSymbolRow() == 1
        && emittedLinkage.DefinedSymbolRowCount() == 2
        && emittedLinkage.FirstReferencedSymbolRow() == 1
        && emittedLinkage.ReferencedSymbolRowCount() == 1
        && definedHelper.LinkageRow() == 1
        && definedHelper.SymbolOrdinal() == 1
        && referencedPuts.LinkageRow() == 1
        && referencedPuts.SymbolOrdinal() == 0
        && sourceText.TextKind() == LogicalPackageNativeMetadataFactTextKind.NativeSource
        && libraryText.TextKind() == LogicalPackageNativeMetadataFactTextKind.NativeLibrary
        && frameworkText.TextKind() == LogicalPackageNativeMetadataFactTextKind.NativeLinkArgument
        && pkgConfigText.TextKind() == LogicalPackageNativeMetadataFactTextKind.NativePkgConfigPackage
        && objectFileText.TextKind() == LogicalPackageNativeMetadataFactTextKind.LinkageObjectFileName
        && helperText.TextKind() == LogicalPackageNativeMetadataFactTextKind.LinkageDefinedSymbol
        && putsText.TextKind() == LogicalPackageNativeMetadataFactTextKind.LinkageReferencedSymbol
        && AppendLogicalPackageLayoutFactText(layoutGraph, pairNameText, pairName) == MemoryStatus.Ok
        && AppendLogicalPackageLayoutFactText(layoutGraph, fieldBNameText, fieldBName)
            == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(nativeGraph, sourceText, sourceName)
            == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(nativeGraph, libraryText, libraryName)
            == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(nativeGraph, frameworkText, frameworkToken)
            == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(nativeGraph, pkgConfigText, pkgConfigName)
            == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(nativeGraph, objectFileText, objectFileName)
            == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(nativeGraph, helperText, helperSymbol)
            == MemoryStatus.Ok
        && AppendLogicalPackageNativeMetadataFactText(nativeGraph, putsText, putsSymbol)
            == MemoryStatus.Ok
        && OwnedAsciiEqualsAscii(pairName, "Demo.Pair")
        && OwnedAsciiEqualsAscii(fieldBName, "B")
        && OwnedAsciiEqualsAscii(sourceName, "shim.c")
        && OwnedAsciiEqualsAscii(libraryName, "raylib")
        && OwnedAsciiEqualsAscii(frameworkToken, "-framework")
        && OwnedAsciiEqualsAscii(pkgConfigName, "raylib")
        && OwnedAsciiEqualsAscii(objectFileName, "Demo.o")
        && OwnedAsciiEqualsAscii(helperSymbol, "Demo.helper")
        && OwnedAsciiEqualsAscii(putsSymbol, "puts");
}

[Fact]
fn bool LogicalPackageImageCopiesCompressedManifestPayload()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildProfileTargetLogicalPackageImage(image);

    stack mut LogicalPackageImageFacts facts = new();
    if (!TryReadLogicalPackageImageFacts(image, facts))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> payload = new();
    stack mut IrTable<u8[0 max]> rejectedPayload = new();
    stack LogicalPackageImageFacts emptyFacts = new();
    return facts.ManifestOffset() == 343
        && facts.ManifestLength() == 1
        && TryCopyLogicalPackageImageManifestPayload(image, facts, payload)
        && payload.Count() == 1
        && payload.Get(1) == 11
        && !TryCopyLogicalPackageImageManifestPayload(image, emptyFacts, rejectedPayload)
        && rejectedPayload.Count() == 0;
}

[Fact]
fn bool LogicalPackageImageReadsDecodedManifestJsonSummary()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildProfileTargetLogicalPackageImage(image);

    stack mut LogicalPackageImageFacts facts = new();
    if (!TryReadLogicalPackageImageFacts(image, facts))
    {
        return false;
    }

    stack ascii manifestJson = raw"""
        {
          "RootModule": "Demo",
          "LibraryFileName": "libDemo.a",
          "Modules": [
            { "ModuleName": "Helper", "ReExports": [], "Functions": [], "Types": [], "Globals": [] },
            { "ModuleName": "Demo", "ReExports": [], "Functions": [], "Types": [], "Globals": [] }
          ],
          "NativeDependencies": { "Libraries": [ "m" ] },
          "Target": {
            "Triple": "x86_64-unknown-linux-stark",
            "DataLayout": "e-p:64:64",
            "Cpu": "generic",
            "Features": [ "+sse2", "+popcnt" ],
            "RelocationModel": "static",
            "CodeModel": "small",
            "CDataModel": {
              "Kind": "linux",
              "CharIsSigned": false,
              "PointerBitWidth": 64,
              "LongBitWidth": 64,
              "SizeTBitWidth": 64,
              "PtrDiffTBitWidth": 64
            },
            "AggregateLayout": {
              "PointerSizeBytes": 8,
              "PointerAlignmentBytes": 8
            }
          },
          "BuildProfile": { "Name": "release" }
        }
        """;

    stack ascii mismatchedManifestJson = raw"""
        {
          "RootModule": "Demo",
          "LibraryFileName": "libDemo.a",
          "Modules": [
            { "ModuleName": "Demo", "ReExports": [], "Functions": [], "Types": [], "Globals": [] }
          ],
          "Target": {
            "Triple": "x86_64-unknown-linux-stark",
            "DataLayout": "e-p:64:64",
            "Cpu": "generic",
            "Features": [ "+popcnt", "+sse2" ],
            "RelocationModel": "static",
            "CodeModel": "small",
            "CDataModel": {
              "Kind": "linux",
              "CharIsSigned": false,
              "PointerBitWidth": 64,
              "LongBitWidth": 64,
              "SizeTBitWidth": 64,
              "PtrDiffTBitWidth": 64
            },
            "AggregateLayout": {
              "PointerSizeBytes": 8,
              "PointerAlignmentBytes": 8
            }
          },
          "BuildProfile": { "Name": "release" }
        }
        """;

    stack mut LogicalPackageManifestSummary summary = new();
    stack mut LogicalPackageManifestSummary rejectedSummary = new();
    unsafe
    {
        return TryReadLogicalPackageManifestJsonSummary(manifestJson, image, facts, summary)
            && summary.ModuleCount() == 2
            && summary.RootModuleOrdinal() == 1
            && summary.HasNativeDependencies()
            && summary.HasBuildProfile()
            && summary.HasTarget()
            && summary.HasCDataModel()
            && summary.HasAggregateLayout()
            && !TryReadLogicalPackageManifestJsonSummary(mismatchedManifestJson, image, facts, rejectedSummary);
    }
}

