                            "Expression": {
                              "Kind": "binary",
                              "Name": "+",
                              "Type": {
                                "Kind": "integer",
                                "BitWidth": 16,
                                "RangeMin": "0",
                                "RangeMax": "1000"
                              },
                              "Arguments": [
                                {
                                  "Kind": "conversion",
                                  "Type": {
                                    "Kind": "integer",
                                    "BitWidth": 16,
                                    "RangeMin": "0",
                                    "RangeMax": "1000"
                                  },
                                  "Arguments": [
                                    {
                                      "Kind": "literal",
                                      "LiteralText": "300",
                                      "Type": { "Kind": "integer", "BitWidth": 32 }
                                    }
                                  ]
                                },
                                {
                                  "Kind": "literal",
                                  "LiteralText": "7",
                                  "Type": { "Kind": "integer", "BitWidth": 16 }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "QualifiedResolvedName": "Demo.Nested#0",
                      "QualifiedName": "Demo.Nested",
                      "OverloadKey": "()",
                      "TopLevelStatementCount": 1,
                      "Conversions": [
                        {
                          "Ordinal": 0,
                          "TargetType": {
                            "Kind": "integer",
                            "BitWidth": 8,
                            "RangeMin": "0",
                            "RangeMax": "100"
                          }
                        },
                        {
                          "Ordinal": 1,
                          "TargetType": {
                            "Kind": "integer",
                            "BitWidth": 16,
                            "RangeMin": "0",
                            "RangeMax": "1000"
                          }
                        }
                      ],
                      "TypedBody": {
                        "Statements": [
                          {
                            "Kind": "block",
                            "BodyStatements": [
                              { "Kind": "empty" },
                              {
                                "Kind": "expression",
                                "Expression": {
                                  "Kind": "conversion",
                                  "Type": {
                                    "Kind": "integer",
                                    "BitWidth": 8,
                                    "RangeMin": "0",
                                    "RangeMax": "100"
                                  },
                                  "Arguments": [
                                    {
                                      "Kind": "literal",
                                      "LiteralText": "300",
                                      "Type": { "Kind": "integer", "BitWidth": 32 }
                                    }
                                  ]
                                }
                              },
                              {
                                "Kind": "return",
                                "Expression": {
                                  "Kind": "conversion",
                                  "Type": {
                                    "Kind": "integer",
                                    "BitWidth": 16,
                                    "RangeMin": "0",
                                    "RangeMax": "1000"
                                  },
                                  "Arguments": [
                                    {
                                      "Kind": "literal",
                                      "LiteralText": "9",
                                      "Type": { "Kind": "integer", "BitWidth": 32 }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "QualifiedResolvedName": "Demo.DeepNested#0",
                      "QualifiedName": "Demo.DeepNested",
                      "OverloadKey": "()",
                      "TopLevelStatementCount": 1,
                      "TypedBody": {
                        "Statements": [
                          {
                            "Kind": "block",
                            "BodyStatements": [
                              {
                                "Kind": "block",
                                "BodyStatements": [
                                  {
                                    "Kind": "return",
                                    "Expression": {
                                      "Kind": "literal",
