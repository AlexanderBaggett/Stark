        && System.Text.Contains(sink.View(), "call i32 @f1({ ptr, i64 } %v")
        && System.Text.Contains(sink.View(), "extractvalue { ptr, i64 } %p0, 0")
        && System.Text.Contains(sink.View(), "extractvalue { ptr, i64 } %p0, 1")
        && System.Text.Contains(sink.View(), "getelementptr i8, ptr %v")
        && ClangVerifiesLlvmText(sink);
}

