    stack u32[0 max] leftElementTypeRow = elementPatternTypeCodes.Add(SourceResolvedFieldTypeCodeI32());
    stack u32[0 max] leftElementKindRow = elementPatternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval());
    stack u32[0 max] leftElementMinRow = elementPatternMinValues.Add(0);
    stack u32[0 max] leftElementMaxRow = elementPatternMaxValues.Add(4);
    stack u32[0 max] rightElementRow = elementPatternIndices.Add(0);
    stack u32[0 max] rightElementTypeRow = elementPatternTypeCodes.Add(SourceResolvedFieldTypeCodeI32());
    stack u32[0 max] rightElementKindRow = elementPatternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval());
    stack u32[0 max] rightElementMinRow = elementPatternMinValues.Add(5);
    stack u32[0 max] rightElementMaxRow = elementPatternMaxValues.Add(9);
    if (leftElementRow != leftElementTypeRow
        || leftElementRow != leftElementKindRow
        || leftElementRow != leftElementMinRow
        || leftElementRow != leftElementMaxRow
        || rightElementRow != rightElementTypeRow
        || rightElementRow != rightElementKindRow
        || rightElementRow != rightElementMinRow
        || rightElementRow != rightElementMaxRow)
    {
        return false;
    }

    stack SourceSwitchListPatternDescriptor leftList =
        MakeSourceSwitchListPatternDescriptor(SourceResolvedFieldTypeCodeI32(), 3, leftElementRow, 1);
    stack SourceSwitchListPatternDescriptor rightList =
        MakeSourceSwitchListPatternDescriptor(SourceResolvedFieldTypeCodeI32(), 3, rightElementRow, 1);
    stack SourceSwitchListPatternDescriptor differentLengthList =
        MakeSourceSwitchListPatternDescriptor(SourceResolvedFieldTypeCodeI32(), 4, rightElementRow, 1);

    stack mut IrTable<u32[0 max]> fieldPatternIndices = new();
    stack mut IrTable<u32[0 max]> fieldPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> fieldPatternKinds = new();
    stack mut IrTable<i64[min max]> fieldPatternMinValues = new();
    stack mut IrTable<i64[min max]> fieldPatternMaxValues = new();
    stack u32[0 max] leftFieldRow = fieldPatternIndices.Add(1);
    stack u32[0 max] leftFieldTypeRow = fieldPatternTypeCodes.Add(SourceResolvedFieldTypeCodeI32());
    stack u32[0 max] leftFieldKindRow = fieldPatternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval());
    stack u32[0 max] leftFieldMinRow = fieldPatternMinValues.Add(0);
    stack u32[0 max] leftFieldMaxRow = fieldPatternMaxValues.Add(4);
    stack u32[0 max] rightFieldRow = fieldPatternIndices.Add(1);
    stack u32[0 max] rightFieldTypeRow = fieldPatternTypeCodes.Add(SourceResolvedFieldTypeCodeI32());
    stack u32[0 max] rightFieldKindRow = fieldPatternKinds.Add(SourceSwitchEnumPayloadPatternKindScalarInterval());
    stack u32[0 max] rightFieldMinRow = fieldPatternMinValues.Add(5);
    stack u32[0 max] rightFieldMaxRow = fieldPatternMaxValues.Add(9);
    if (leftFieldRow != leftFieldTypeRow
        || leftFieldRow != leftFieldKindRow
        || leftFieldRow != leftFieldMinRow
        || leftFieldRow != leftFieldMaxRow
        || rightFieldRow != rightFieldTypeRow
        || rightFieldRow != rightFieldKindRow
        || rightFieldRow != rightFieldMinRow
        || rightFieldRow != rightFieldMaxRow)
    {
        return false;
    }

    stack SourceSwitchAggregatePatternDescriptor leftAggregate =
        MakeSourceSwitchAggregatePatternDescriptor(77, 2, leftFieldRow, 1);
    stack SourceSwitchAggregatePatternDescriptor rightAggregate =
        MakeSourceSwitchAggregatePatternDescriptor(77, 2, rightFieldRow, 1);
    stack SourceSwitchAggregatePatternDescriptor differentOwnerAggregate =
        MakeSourceSwitchAggregatePatternDescriptor(78, 2, rightFieldRow, 1);
    stack SourceSwitchAggregatePatternDescriptor differentVariantAggregate =
        MakeSourceSwitchAggregatePatternDescriptor(77, 3, rightFieldRow, 1);

    return SourceSwitchListPatternDescriptorsAreProvablyDisjoint(
            leftList,
            rightList,
            elementPatternIndices,
            elementPatternTypeCodes,
            elementPatternKinds,
            elementPatternMinValues,
            elementPatternMaxValues)
        && !SourceSwitchListPatternDescriptorsAreProvablyDisjoint(
            leftList,
            differentLengthList,
            elementPatternIndices,
            elementPatternTypeCodes,
            elementPatternKinds,
            elementPatternMinValues,
            elementPatternMaxValues)
        && SourceSwitchAggregatePatternDescriptorsAreProvablyDisjoint(
            leftAggregate,
            rightAggregate,
            fieldPatternIndices,
            fieldPatternTypeCodes,
            fieldPatternKinds,
            fieldPatternMinValues,
            fieldPatternMaxValues)
        && !SourceSwitchAggregatePatternDescriptorsAreProvablyDisjoint(
            leftAggregate,
            differentOwnerAggregate,
            fieldPatternIndices,
            fieldPatternTypeCodes,
            fieldPatternKinds,
            fieldPatternMinValues,
            fieldPatternMaxValues)
        && !SourceSwitchAggregatePatternDescriptorsAreProvablyDisjoint(
            leftAggregate,
            differentVariantAggregate,
            fieldPatternIndices,
            fieldPatternTypeCodes,
            fieldPatternKinds,
            fieldPatternMinValues,
            fieldPatternMaxValues);
}

[Fact]
fn bool SourceSwitchPatternDecisionMemberSpansDetectScalarAndNestedAggregateDisjointness()
{
    stack mut IrTable<SourceSwitchPatternDecisionNode> nodes = new();
    stack mut IrTable<SourceSwitchPatternDecisionMember> members = new();
