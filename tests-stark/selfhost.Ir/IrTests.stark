[Fact]
fn bool ModuleAccumulatorWhileLoopRejectsUnsupportedShapes()
{
    stack mut OwnedAscii s = new();
    return !CompileModuleFromAst("fn sum(n) { var i = 0; var s = 0; while i < n { s = s + i; i = i + 1; } return s } fn main() { return sum(5) }", s)
        && !CompileModuleFromAst("fn sum() { var i = 0; var s = 0; while i < 5 { i = i + 1; s = s + i; } return s } fn main() { return sum() }", s)
        && !CompileModuleFromAst("fn sum() { var i = 0; var s = 0; while i < 5 { s = s + i; i = i * 2; } return s } fn main() { return sum() }", s)
        && !CompileModuleFromAst("fn sum() { var i = 0; var s = 0; while i < 5 { s = s + i; i = i + 1; } return i } fn main() { return sum() }", s)
        && CompileModuleFromAst("fn sum() { var i = 0; var s = 0; while i < 5 { s = s + i; i = i + 1; } return s } fn main() { return sum() }", s);
}

[Fact]
fn bool CompilesModuleCountingForLoopFromAst()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn count() { var i = 0; for willexit (; i < 5; i += 1) { } return i } fn main() { return count() }", s);
    return ok
        && System.Text.Contains(s.View(), "define internal dso_local i64 @f1()")
        && System.Text.Contains(s.View(), "%v4 = phi i64 [ %v1, %b1 ], [ %v6, %b3 ]")
        && System.Text.Contains(s.View(), "%v5 = icmp slt i64 %v4, %v2")
        && System.Text.Contains(s.View(), "%v6 = add i64 %v4, %v3")
        && System.Text.Contains(s.View(), "ret i64 %v4")
        && ClangVerifiesLlvmText(s);
}

