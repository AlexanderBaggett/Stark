    stack mut OwnedAscii tooWide = new();
    stack bool tooWideOk = CompileModuleFromAst("fn i64[0 10] bounded(i64[0 max] x) { if x < 12 return x else return 0 }", tooWide);
    return provenOk
        && System.Text.Contains(proven.View(), "define range(i64 0, 11) i64 @f1")
        && !tooWideOk;
}

