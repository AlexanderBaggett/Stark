[Fact]
fn bool SameOwnerSourceTryLoweringBranchesAndExtractsSuccessPayload()
{
    stack ascii source = raw"""
    enum Outcome
    {
        [Ok] Value(i32[0 max]),
        [Err] Failed(i8[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedEnumPayloadTable payloads = new();
    stack mut TypedEnumLayoutTable layouts = new();
    stack mut OwnedAscii sourceText = new();
    if (sourceText.AppendAscii(source) != MemoryStatus.Ok
        || !BuildTypedEnumTryInputsForSource(source, stream, declarations, payloads, layouts))
    {
        return false;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    moduleFacts.Declarations = declarations;
    moduleFacts.EnumPayloads = payloads;
    moduleFacts.EnumLayouts = layouts;

    stack mut SourceTryPropagationCompatibilityFacts facts = new();
    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    if (!TryResolveSourceTryPropagationCompatibility(stream, sourceText.View(), sourceBytes, moduleFacts, 0, 0, facts))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<BlockEmit> ranges = new();
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(1), 0);
    stack MirValueId payload = MirConstIntTyped(instrs, MirType.I32, 9);
    stack MirValueId operand = MirEnumPayloadInsert(instrs, TypeIdOf(1), 0, 0, tagged, payload);
    stack mut SourceTryPropagationLoweringResult lowered = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        facts,
        operand,
        0,
        0,
        MirBlockIdOf(4),
        1,
        MirType.I8,
        true,
        lowered))
    {
        return false;
    }

    stack MirInstruction tagRead = instrs.Get(4);
    stack MirInstruction errConst = instrs.Get(5);
    stack MirInstruction condition = instrs.Get(6);
    stack MirInstruction successExtract = instrs.Get(7);
    stack MirBlock entry = blocks.Get(lowered.EntryBlock().Index());
    stack MirBlock errorBlock = blocks.Get(lowered.ErrorBlock().Index());
    stack MirBlock continueBlock = blocks.Get(lowered.ContinueBlock().Index());
    return lowered.IsValid()
        && instrs.Count() == 7
        && blocks.Count() == 3
        && ranges.Count() == 3
        && lowered.ErrorReturn().Equals(operand)
        && lowered.SuccessValue().Index() == 7
        && tagRead.Opcode() == MirOp.EnumTagRead
        && tagRead.ResultType() == MirType.I8
        && tagRead.OperandAIndex() == operand.Index()
        && tagRead.OperandBIndex() == 1
        && errConst.Opcode() == MirOp.ConstInt
        && errConst.ResultType() == MirType.I8
        && errConst.Immediate() == 1
        && condition.Opcode() == MirOp.CmpEq
        && condition.ResultType() == MirType.I1
        && entry.Terminator() == MirTermKind.CondBranch
        && entry.Slot0Index() == lowered.Condition().Index()
        && entry.Slot1Index() == lowered.ErrorBlock().Index()
        && entry.Slot2Index() == lowered.ContinueBlock().Index()
        && errorBlock.Terminator() == MirTermKind.Return
        && errorBlock.Slot0Index() == operand.Index()
        && continueBlock.Terminator() == MirTermKind.Branch
        && continueBlock.Slot0Index() == 4
        && successExtract.Opcode() == MirOp.EnumPayloadExtract
        && successExtract.ResultType() == MirType.I32
        && successExtract.OperandAIndex() == operand.Index()
        && successExtract.OperandBIndex() == 1
        && successExtract.OperandCIndex() == 0
        && successExtract.OperandDIndex() == 0;
}

[Fact]
fn bool SameFailurePayloadSourceTryLoweringBuildsReturnErr()
{
    stack ascii source = raw"""
    enum Error { Bad }
    enum FetchOutcome
    {
        [Ok] Value(i32[0 max]),
        [Err] Failed(Error)
    }
    enum LoadOutcome
    {
        [Ok] Value(i32[0 max]),
        [Err] Failed(Error)
    }
    """;

    stack mut TokenStream stream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedEnumPayloadTable payloads = new();
    stack mut TypedEnumLayoutTable layouts = new();
    stack mut OwnedAscii sourceText = new();
    if (sourceText.AppendAscii(source) != MemoryStatus.Ok
        || !BuildTypedEnumTryInputsForSource(source, stream, declarations, payloads, layouts))
    {
        return false;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    moduleFacts.Declarations = declarations;
    moduleFacts.EnumPayloads = payloads;
    moduleFacts.EnumLayouts = layouts;

    stack mut SourceTryPropagationCompatibilityFacts facts = new();
    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    if (!TryResolveSourceTryPropagationCompatibility(stream, sourceText.View(), sourceBytes, moduleFacts, 1, 2, facts))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<BlockEmit> ranges = new();
    stack MirValueId errorUnit = MirEnumVariantTag(instrs, TypeIdOf(1), 0);
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(2), 1);
    stack MirValueId operand = MirEnumPayloadInsert(instrs, TypeIdOf(2), 1, 0, tagged, errorUnit);
    stack mut SourceTryPropagationLoweringResult lowered = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        facts,
        operand,
        1,
        2,
        MirBlockIdOf(4),
        1,
        MirType.I8,
        true,
        lowered))
    {
        return false;
    }

    stack MirInstruction failureExtract = instrs.Get(7);
    stack MirInstruction returnErrTag = instrs.Get(8);
    stack MirInstruction returnErrInsert = instrs.Get(9);
    stack MirInstruction successExtract = instrs.Get(10);
    stack MirBlock errorBlock = blocks.Get(lowered.ErrorBlock().Index());
    return lowered.IsValid()
        && instrs.Count() == 10
        && blocks.Count() == 3
        && lowered.ErrorReturn().Index() == 9
        && lowered.SuccessValue().Index() == 10
        && errorBlock.Terminator() == MirTermKind.Return
        && errorBlock.Slot0Index() == lowered.ErrorReturn().Index()
        && failureExtract.Opcode() == MirOp.EnumPayloadExtract
        && failureExtract.ResultType() == MirType.EnumValue
        && failureExtract.OperandAIndex() == operand.Index()
        && failureExtract.OperandBIndex() == 2
        && failureExtract.OperandCIndex() == 1
        && failureExtract.OperandDIndex() == 0
        && returnErrTag.Opcode() == MirOp.EnumVariantTag
        && returnErrTag.OperandAIndex() == 3
        && returnErrTag.OperandBIndex() == 1
        && returnErrInsert.Opcode() == MirOp.EnumPayloadInsert
        && returnErrInsert.OperandAIndex() == 8
        && returnErrInsert.OperandBIndex() == 7
        && returnErrInsert.OperandCIndex() == 3
        && returnErrInsert.OperandDIndex() == 1
        && successExtract.Opcode() == MirOp.EnumPayloadExtract
        && successExtract.ResultType() == MirType.I32
        && successExtract.OperandAIndex() == operand.Index()
        && successExtract.OperandBIndex() == 2
        && successExtract.OperandCIndex() == 0
        && successExtract.OperandDIndex() == 0;
}

[Fact]
fn bool FunnelFailurePayloadSourceTryLoweringBuildsReturnErr()
{
    stack ascii source = raw"""
    enum IOError { Read }
    enum LoadError
    {
        Io from IOError
    }
    enum FetchOutcome
    {
        [Ok] Value(i32[0 max]),
        [Err] Failed(IOError)
    }
    enum LoadOutcome
    {
        [Ok] Value(i32[0 max]),
        [Err] Failed(LoadError)
    }
    """;

    stack mut TokenStream stream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedEnumPayloadTable payloads = new();
    stack mut TypedEnumLayoutTable layouts = new();
    stack mut OwnedAscii sourceText = new();
    if (sourceText.AppendAscii(source) != MemoryStatus.Ok
        || !BuildTypedEnumTryInputsForSource(source, stream, declarations, payloads, layouts))
    {
        return false;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    moduleFacts.Declarations = declarations;
    moduleFacts.EnumPayloads = payloads;
    moduleFacts.EnumLayouts = layouts;

    stack mut SourceTryPropagationCompatibilityFacts facts = new();
    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    if (!TryResolveSourceTryPropagationCompatibility(stream, sourceText.View(), sourceBytes, moduleFacts, 2, 3, facts))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<BlockEmit> ranges = new();
    stack MirValueId ioError = MirEnumVariantTag(instrs, TypeIdOf(1), 0);
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(3), 1);
    stack MirValueId operand = MirEnumPayloadInsert(instrs, TypeIdOf(3), 1, 0, tagged, ioError);
    stack mut SourceTryPropagationLoweringResult lowered = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        facts,
        operand,
        2,
        3,
        MirBlockIdOf(4),
        1,
        MirType.I8,
        true,
        lowered))
    {
        return false;
    }

    stack MirInstruction returnErrTag = instrs.Get(7);
    stack MirInstruction failureExtract = instrs.Get(8);
    stack MirInstruction funnelTag = instrs.Get(9);
    stack MirInstruction funnelInsert = instrs.Get(10);
    stack MirInstruction returnErrInsert = instrs.Get(11);
    stack MirInstruction successExtract = instrs.Get(12);
    stack MirBlock errorBlock = blocks.Get(lowered.ErrorBlock().Index());
    return lowered.IsValid()
        && facts.ErrorCompatibilityKind() == SourceTryPropagationErrorCompatibilityKind.FunnelFailurePayloadType
        && instrs.Count() == 12
        && blocks.Count() == 3
        && lowered.ErrorReturn().Index() == 11
        && lowered.SuccessValue().Index() == 12
        && errorBlock.Terminator() == MirTermKind.Return
        && errorBlock.Slot0Index() == lowered.ErrorReturn().Index()
        && returnErrTag.Opcode() == MirOp.EnumVariantTag
        && returnErrTag.OperandAIndex() == 4
        && returnErrTag.OperandBIndex() == 1
        && failureExtract.Opcode() == MirOp.EnumPayloadExtract
        && failureExtract.ResultType() == MirType.EnumValue
        && failureExtract.OperandAIndex() == operand.Index()
        && failureExtract.OperandBIndex() == 3
        && failureExtract.OperandCIndex() == 1
        && failureExtract.OperandDIndex() == 0
        && funnelTag.Opcode() == MirOp.EnumVariantTag
        && funnelTag.OperandAIndex() == 2
        && funnelTag.OperandBIndex() == 0
        && funnelInsert.Opcode() == MirOp.EnumPayloadInsert
        && funnelInsert.OperandAIndex() == 9
        && funnelInsert.OperandBIndex() == 8
        && funnelInsert.OperandCIndex() == 2
        && funnelInsert.OperandDIndex() == 0
        && returnErrInsert.Opcode() == MirOp.EnumPayloadInsert
        && returnErrInsert.OperandAIndex() == 7
        && returnErrInsert.OperandBIndex() == 10
        && returnErrInsert.OperandCIndex() == 4
        && returnErrInsert.OperandDIndex() == 1
        && successExtract.Opcode() == MirOp.EnumPayloadExtract
        && successExtract.ResultType() == MirType.I32
        && successExtract.OperandAIndex() == operand.Index()
        && successExtract.OperandBIndex() == 3
        && successExtract.OperandCIndex() == 0
        && successExtract.OperandDIndex() == 0;
}

[Fact]
fn bool SourceModuleLowersLocalTryBindingToLlvm()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm(
        "enum Outcome { [Ok] Value(i32[0 max]), [Err] Failed(u8[0 max]) } fn Outcome main() { var value = try Outcome.Value(7); return Outcome.Value(value) }",
        sink);
    return ok
        && System.Text.Contains(sink.View(), "br i1")
        && System.Text.Contains(sink.View(), "extractvalue")
        && System.Text.Contains(sink.View(), "insertvalue")
        && System.Text.Contains(sink.View(), "ret {");
}

