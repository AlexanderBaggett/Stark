[Fact]
fn bool CompileFunctionSliceParameterReadUsesConcreteSliceAbiAndUnboundedIndex()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm("fn i32[min max] main(i32[min max][] view, i64[0 max] index) { return view[index] }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define i32 @main({ ptr, i64 } %p0, i64")
        && System.Text.Contains(sink.View(), "extractvalue { ptr, i64 } %p0, 0")
        && System.Text.Contains(sink.View(), "extractvalue { ptr, i64 } %p0, 1")
        && System.Text.Contains(sink.View(), ".scale = mul i64 %p1, 4")
        && System.Text.Contains(sink.View(), "getelementptr i8, ptr %v1, i64 %v")
        && !System.Text.Contains(sink.View(), "getelementptr inbounds i8")
        && System.Text.Contains(sink.View(), "load i32")
        && System.Text.Contains(sink.View(), "align 4")
        && System.Text.Contains(sink.View(), "ret i32")
        && !System.Text.Contains(sink.View(), "load i64")
        && ClangVerifiesLlvmText(sink);
}

