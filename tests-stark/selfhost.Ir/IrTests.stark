[Fact]
fn bool CompileFunctionDeadOnReturnRequiresExplicitPointerContract()
{
    stack mut OwnedAscii destroy = new();
    stack bool destroyOk = CompileFunctionToLlvm("fn i64 destroy(out i32 value) where dead_on_return(value) { return 1 }", destroy);
    stack mut OwnedAscii normalOut = new();
    stack bool normalOk = CompileFunctionToLlvm("fn i64 write(out i32 value) { return 1 }", normalOut);
    stack mut OwnedAscii scalar = new();
    stack mut OwnedAscii missing = new();
    return destroyOk
        && normalOk
        && LlvmTextEquals(destroy, "define i64 @main(ptr captures(none) writeonly writable initializes((0, 4)) dead_on_return %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n")
        && !System.Text.Contains(normalOut.View(), "dead_on_return")
        && !CompileFunctionToLlvm("fn i64 bad(i64 value) where dead_on_return(value) { return 1 }", scalar)
        && !CompileFunctionToLlvm("fn i64 bad(out i32 value) where dead_on_return(missing) { return 1 }", missing);
}

[Fact]
fn bool CompileFunctionWholePointerParamsEmitSeparateStorageAssume()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionToLlvm("fn i64 read2(borrow i32 left, borrow i32 right) { return 1 }", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool EmitsLlvmScopedNoAliasMetadataForParamRootedPointerMemoryOps()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId left = MirParamTyped(instrs, MirType.Ptr, 0);
    stack MirValueId right = MirParamTyped(instrs, MirType.Ptr, 1);
    stack MirValueId index = MirConstIntTyped(instrs, MirType.I64, 1);
    stack MirValueId value = MirConstIntTyped(instrs, MirType.I32, 7);
    stack MirValueId leftElement = MirPtrIndexOffset(instrs, left, index, 4, 0, 4);
    stack MirValueId rightElement = MirPtrIndexOffset(instrs, right, index, 4, 0, 4);
    stack MirValueId store = MirStorePtrAlignedTyped(instrs, MirType.I32, leftElement, value, 4);
    stack MirValueId load = MirLoadPtrAlignedTyped(instrs, MirType.I32, rightElement, 4);
    stack MirBlockId entry = MirReturnBlock(blocks, load);

    stack mut IrTable<u32[0 max]> noTailCallees = new();
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    stack mut IrTable<DistinctStoragePair> separateStorageFacts = new();
    if (!AddDistinctStoragePairIfAbsent(separateStorageFacts, 0, 1))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFactsCore(
        instrs,
        noTailCallees,
        noFunctionEffectFacts,
        noFunctionCallContractFacts,
        noFunctionLinkageFacts,
        noFunctionCallingConventionFacts,
        blocks,
        "scoped",
        false,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        separateStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        NoFunctionEffectFacts(),
        2,
        entry.Index(),
        1,
        8,
        sink))
    {
        case MemoryStatus.Ok:
            return store.IsValid()
                && LlvmTextEquals(sink, "define i32 @scoped(ptr %p0, ptr %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v3 = add i64 0, 1\n  %v4 = add i32 0, 7\n  %v5.scale = mul i64 %v3, 4\n  %v5 = getelementptr inbounds i8, ptr %p0, i64 %v5.scale\n  %v6.scale = mul i64 %v3, 4\n  %v6 = getelementptr inbounds i8, ptr %p1, i64 %v6.scale\n  store i32 %v4, ptr %v5, align 4, !alias.scope !204096, !noalias !208192\n  %v8 = load i32, ptr %v6, align 4, !alias.scope !204097, !noalias !208193\n  ret i32 %v8\n}\n!200000 = distinct !{!200000, !\"stark.noalias.mir\"}\n!200001 = distinct !{!200001, !200000, !\"stark.noalias.param.0\"}\n!200002 = distinct !{!200002, !200000, !\"stark.noalias.param.1\"}\n!204096 = !{!200001}\n!208192 = !{!200002}\n!204097 = !{!200002}\n!208193 = !{!200001}\n")
                && ClangVerifiesLlvmText(sink);
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmIndependentLoopAccessGroupMetadataForIndexedPointerMemoryOps()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId pointer = MirParamTyped(instrs, MirType.Ptr, 0);
    stack MirValueId index = MirConstIntTyped(instrs, MirType.I64, 1);
    stack MirValueId value = MirConstIntTyped(instrs, MirType.I32, 7);
    stack MirValueId element = MirPtrIndexOffset(instrs, pointer, index, 4, 0, 4);
    stack MirValueId store = MirStorePtrAlignedTyped(instrs, MirType.I32, element, value, 4);
    stack MirValueId load = MirLoadPtrAlignedTyped(instrs, MirType.I32, element, 4);
    stack MirBlockId entry = MirBranchBlock(blocks, MirBlockIdOf(2));
    stack MirBlockId loop = MirIndependentLoopBackedgeBlock(blocks, MirBlockIdOf(2));
    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(entry.Index(), 1, 0));
    stack u32[0 max] loopRange = ranges.Add(MakeBlockEmit(loop.Index(), 1, (u32[0 max])instrs.Count()));
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmBlocksWithRangeFacts(
        instrs,
        blocks,
        "loop_access",
        returnFacts,
        paramFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        1,
        ranges,
        sink))
    {
        case MemoryStatus.Ok:
            return store.IsValid()
                && load.IsValid()
                && entryRange == 1
                && loopRange == 2
                && System.Text.Contains(sink.View(), "store i32 %v3, ptr %v4, align 4, !llvm.access.group !")
                && System.Text.Contains(sink.View(), "%v6 = load i32, ptr %v4, align 4, !llvm.access.group !")
                && System.Text.Contains(sink.View(), "br label %b2, !llvm.loop !")
                && System.Text.Contains(sink.View(), "llvm.loop.vectorize.enable")
                && System.Text.Contains(sink.View(), "llvm.loop.parallel_accesses")
                && System.Text.Contains(sink.View(), " = distinct !{}")
                && ClangVerifiesLlvmText(sink);
        case MemoryStatus.Err(var error):
            return false;
    }
}

fn ParamAbiFacts PointerBorrowAbiForNoAliasCallTest()
{
    stack mut ParamAbiFacts abi = new();
    abi.IsPointer = true;
    abi.CaptureKind = 1;
    abi.ReadOnly = true;
    return abi;
}

[Fact]
fn bool EmitsLlvmScopedNoAliasMetadataForDirectPointerCall()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId left = MirParamTyped(instrs, MirType.Ptr, 0);
    stack MirValueId right = MirParamTyped(instrs, MirType.Ptr, 1);
    stack MirValueId call = MirCall1(instrs, MirFuncIdOf(1), left);
    stack MirBlockId entry = MirReturnBlock(blocks, call);

    stack mut IrTable<u32[0 max]> noTailCallees = new();
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> functionCallContractFacts = new();
    stack mut FunctionCallContractFacts calleeFacts = new();
    calleeFacts.ParamCount = 1;
    calleeFacts.Param0 = PointerBorrowAbiForNoAliasCallTest();
    if (functionCallContractFacts.Add(calleeFacts) == 0)
    {
        return false;
    }

    stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    stack mut IrTable<DistinctStoragePair> separateStorageFacts = new();
    if (!AddDistinctStoragePairIfAbsent(separateStorageFacts, 0, 1))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFactsCore(
        instrs,
        noTailCallees,
        noFunctionEffectFacts,
        functionCallContractFacts,
        noFunctionLinkageFacts,
        noFunctionCallingConventionFacts,
        blocks,
        "scoped_call",
        false,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        separateStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        NoFunctionEffectFacts(),
        2,
        entry.Index(),
        1,
        3,
        sink))
    {
        case MemoryStatus.Ok:
            return right.IsValid()
                && LlvmTextEquals(sink, "define i64 @scoped_call(ptr %p0, ptr %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v3 = call i64 @f1(ptr captures(none) readonly %p0), !alias.scope !212006, !noalias !212007\n  ret i64 %v3\n}\n!200000 = distinct !{!200000, !\"stark.noalias.mir\"}\n!200001 = distinct !{!200001, !200000, !\"stark.noalias.param.0\"}\n!200002 = distinct !{!200002, !200000, !\"stark.noalias.param.1\"}\n!204096 = !{!200001}\n!208192 = !{!200002}\n!204097 = !{!200002}\n!208193 = !{!200001}\n!212006 = !{!200001}\n!212007 = !{!200002}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmScopedNoAliasMetadataForTailPointerCall()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId left = MirParamTyped(instrs, MirType.Ptr, 0);
    stack MirValueId right = MirParamTyped(instrs, MirType.Ptr, 1);
    stack MirValueId call = MirTailCall1(instrs, MirFuncIdOf(1), left);
    stack MirBlockId entry = MirTailCallBlock(blocks, call);

    stack mut IrTable<u32[0 max]> tailFlags = new();
    stack u32[0 max] f1Tail = tailFlags.Add(1);
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> functionCallContractFacts = new();
    stack mut FunctionCallContractFacts calleeFacts = new();
    calleeFacts.ParamCount = 1;
    calleeFacts.Param0 = PointerBorrowAbiForNoAliasCallTest();
    if (functionCallContractFacts.Add(calleeFacts) == 0)
    {
        return false;
    }

    stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    stack mut IrTable<DistinctStoragePair> separateStorageFacts = new();
    if (!AddDistinctStoragePairIfAbsent(separateStorageFacts, 0, 1))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFactsCore(
        instrs,
        tailFlags,
        noFunctionEffectFacts,
        functionCallContractFacts,
        noFunctionLinkageFacts,
        noFunctionCallingConventionFacts,
        blocks,
        "scoped_tail",
        true,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        separateStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        NoFunctionEffectFacts(),
        2,
        entry.Index(),
        1,
        3,
        sink))
    {
        case MemoryStatus.Ok:
            return right.IsValid()
                && f1Tail == 1
                && LlvmTextEquals(sink, "define tailcc i64 @scoped_tail(ptr %p0, ptr %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v3 = musttail call tailcc i64 @f1(ptr captures(none) readonly %p0), !alias.scope !212006, !noalias !212007\n  ret i64 %v3\n}\n!200000 = distinct !{!200000, !\"stark.noalias.mir\"}\n!200001 = distinct !{!200001, !200000, !\"stark.noalias.param.0\"}\n!200002 = distinct !{!200002, !200000, !\"stark.noalias.param.1\"}\n!204096 = !{!200001}\n!208192 = !{!200002}\n!204097 = !{!200002}\n!208193 = !{!200001}\n!212006 = !{!200001}\n!212007 = !{!200002}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

