        if (MirOpcodeOf(instrs, value) == MirOp.EnumVariantTag)
        {
            sawTag = sawTag
                || (MirOperandAImmediateOf(instrs, value) == 1
                    && MirOperandBImmediateOf(instrs, value) == 1);
        }
        else if (MirOpcodeOf(instrs, value) == MirOp.EnumPayloadInsert)
        {
            sawXPayload = sawXPayload
                || (MirOperandCImmediateOf(instrs, value) == 1
                    && MirOperandDImmediateOf(instrs, value) == 1
                    && MirImmediateOf(instrs, value) == 0);
            sawFlagPayload = sawFlagPayload
                || (MirOperandCImmediateOf(instrs, value) == 1
                    && MirOperandDImmediateOf(instrs, value) == 1
                    && MirImmediateOf(instrs, value) == 1);
        }

        index = index + 1;
    }

    return ok
        && funcs.Count() == 1
        && sawTag
        && sawXPayload
        && sawFlagPayload;
}

