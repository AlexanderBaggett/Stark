        && System.Text.Contains(sink.View(), "store i32")
        && System.Text.Contains(sink.View(), "align 4")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool RejectsConstructedObjectDynamicFixedArrayIndexWithoutSourceBounds()
{
    stack mut OwnedAscii wideRead = new();
    stack mut OwnedAscii negativeRead = new();
    stack mut OwnedAscii boolRead = new();
    stack mut OwnedAscii wideWrite = new();
    return !CompileFunctionWithLocalsToLlvm("struct Box { i32[min max][3] values; } fn i32[min max] main(i64[0 3] index) { stack Box box = new Box(); return box.values[index] }", wideRead)
        && !CompileFunctionWithLocalsToLlvm("struct Box { i32[min max][3] values; } fn i32[min max] main(i64[-1 2] index) { stack Box box = new Box(); return box.values[index] }", negativeRead)
        && !CompileFunctionWithLocalsToLlvm("struct Box { i32[min max][3] values; } fn i32[min max] main(bool index) { stack Box box = new Box(); return box.values[index] }", boolRead)
        && !CompileFunctionWithLocalsToLlvm("struct Box { i32[min max][3] values; } fn i32[min max] main(i64[0 3] index) { stack Box box = new Box(); box.values[index] = 1; return 0 }", wideWrite);
}

[Fact]
fn bool RejectsConstructedObjectFixedArrayElementAssignmentInvalidTargetsAndValues()
{
    stack mut OwnedAscii outOfRangeWrite = new();
    stack mut OwnedAscii outOfRangeRead = new();
    stack mut OwnedAscii scalarIndex = new();
    stack mut OwnedAscii wrongType = new();
    stack mut OwnedAscii forward = new();
    return !CompileFunctionWithLocalsToLlvm("struct Box { i32[min max][2] values; } fn i32[min max] main() { stack Box box = new Box(); box.values[2] = 1; return 0 }", outOfRangeWrite)
        && !CompileFunctionWithLocalsToLlvm("struct Box { i32[min max][2] values; } fn i32[min max] main() { stack Box box = new Box(); return box.values[2] }", outOfRangeRead)
        && !CompileFunctionWithLocalsToLlvm("struct Box { i32[min max] value; } fn i32[min max] main() { stack Box box = new Box(); box.value[0] = 1; return 0 }", scalarIndex)
        && !CompileFunctionWithLocalsToLlvm("struct Box { bool[2] flags; } fn i32[min max] main() { stack Box box = new Box(); box.flags[1] = 1; return 0 }", wrongType)
        && !CompileFunctionWithLocalsToLlvm("struct Box { i32[min max][2] values; } fn i32[min max] main() { stack Box box = new Box(); box.values[1] = later; var later = 1; return 0 }", forward);
}

[Fact]
fn bool CompileLocalTerminalIfHeapObjectFieldAssignmentStoresBeforeBranch()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("struct Box { i64 value; bool flag; } fn main() { heap Box box = new Box(); box.flag = true; if box.flag return box.value else return 2 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "%v1 = call noalias nonnull noundef align 8 dereferenceable(16) ptr @__stark_heap_alloc(i64 noundef 16, i64 noundef 8)")
        && System.Text.Contains(sink.View(), "store i1")
        && System.Text.Contains(sink.View(), "load i1")
        && System.Text.Contains(sink.View(), "br i1")
        && !System.Text.Contains(sink.View(), "@__stark_arena_alloc")
        && ClangVerifiesLlvmText(sink);
}

