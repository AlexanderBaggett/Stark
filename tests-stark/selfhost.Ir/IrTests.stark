[Fact]
fn bool CompileFunctionFixedArrayParameterCanFeedSliceAndFixedArrayCalls()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("fn i32[min max] read_slice(i32[min max][] view, i64[0 2] index) { return view[index] } fn i32[min max] read_array(i32[min max][3] values, i64[0 2] index) { return values[index] } fn i32[min max] main(i32[min max][3] values, i64[0 2] index) { return read_slice(values, index) + read_array(values, index) }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define internal dso_local i32 @f1({ ptr, i64 } %p0, i64")
        && System.Text.Contains(sink.View(), "define internal dso_local i32 @f2([3 x i32] %p0, i64")
        && System.Text.Contains(sink.View(), "alloca [3 x i32], align 4")
        && System.Text.Contains(sink.View(), "store [3 x i32] %p0, ptr")
        && System.Text.Contains(sink.View(), "insertvalue { ptr, i64 } poison, ptr")
        && System.Text.Contains(sink.View(), "call i32 @f1({ ptr, i64 } %v")
        && System.Text.Contains(sink.View(), "call i32 @f2([3 x i32] %p0")
        && ClangVerifiesLlvmText(sink);
}

