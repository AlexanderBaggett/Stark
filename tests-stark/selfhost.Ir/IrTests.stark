[Fact]
fn bool LogicalPackageImageValidatesHeaderFacts()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 0);

    return ValidatePackageImage(image) == PackageImageValidationStatus.Ok
        && PackageImageIsValid(image);
}

[Fact]
fn bool LogicalPackageImageInspectsTextHeaderFacts()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 0);

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    return LlvmTextEquals(text, "package: STARKPKG, logical image, root Demo, library libDemo.a, 3 sections, 2 strings, 0 target features\n");
}

[Fact]
fn bool LogicalPackageImageInspectsJsonHeaderFacts()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 0);

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    return LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"logical\",\"rootModule\":\"Demo\",\"libraryFileName\":\"libDemo.a\",\"buildProfile\":null,\"targetTriple\":null,\"targetDataLayout\":null,\"targetCpu\":null,\"relocationModel\":null,\"codeModel\":null,\"targetFeatureNames\":[],\"cDataModel\":null,\"aggregateLayout\":null,\"sections\":3,\"strings\":2,\"targetFeatures\":0,\"hasBuildProfile\":false,\"hasTarget\":false,\"hasCDataModel\":false,\"hasAggregateLayout\":false}\n");
}

[Fact]
fn bool LogicalPackageImageInspectsProfileAndTargetHeaderFacts()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildProfileTargetLogicalPackageImage(image);

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    return ValidatePackageImage(image) == PackageImageValidationStatus.Ok
        && LlvmTextEquals(text, "package: STARKPKG, logical image, root Demo, library libDemo.a, profile release, target x86_64-unknown-linux-stark, data-layout e-p:64:64, cpu generic, relocation static, code-model small, features [+sse2, +popcnt], c-data-model linux char-signed=false pointer=64 long=64 size_t=64 ptrdiff_t=64, aggregate-layout pointer-size=8 pointer-align=8, 3 sections, 11 strings, 2 target features\n")
        && LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"logical\",\"rootModule\":\"Demo\",\"libraryFileName\":\"libDemo.a\",\"buildProfile\":\"release\",\"targetTriple\":\"x86_64-unknown-linux-stark\",\"targetDataLayout\":\"e-p:64:64\",\"targetCpu\":\"generic\",\"relocationModel\":\"static\",\"codeModel\":\"small\",\"targetFeatureNames\":[\"+sse2\",\"+popcnt\"],\"cDataModel\":{\"kind\":\"linux\",\"charIsSigned\":false,\"pointerBitWidth\":64,\"longBitWidth\":64,\"sizeTBitWidth\":64,\"ptrDiffTBitWidth\":64},\"aggregateLayout\":{\"pointerSizeBytes\":8,\"pointerAlignmentBytes\":8},\"sections\":3,\"strings\":11,\"targetFeatures\":2,\"hasBuildProfile\":true,\"hasTarget\":true,\"hasCDataModel\":true,\"hasAggregateLayout\":true}\n");
}

[Fact]
fn bool LogicalPackageImageReadsCompactFactsForCompatibilityChecks()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildProfileTargetLogicalPackageImage(image);

    stack mut LogicalPackageImageFacts facts = new();
    stack mut u32[0 max] feature0 = 0;
    stack mut u32[0 max] feature1 = 0;
    if (!TryReadLogicalPackageImageFacts(image, facts)
        || !TryReadLogicalPackageImageTargetFeatureStringIndex(image, facts, 0, feature0)
        || !TryReadLogicalPackageImageTargetFeatureStringIndex(image, facts, 1, feature1))
    {
        return false;
    }

    stack mut OwnedAscii root = new();
    switch (AppendLogicalPackageImageFactString(image, facts, facts.RootModuleStringIndex(), root))
    {
        case MemoryStatus.Err(var rootError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii profile = new();
    switch (AppendLogicalPackageImageFactString(image, facts, facts.BuildProfileStringIndex(), profile))
    {
        case MemoryStatus.Err(var profileError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii target = new();
    switch (AppendLogicalPackageImageFactString(image, facts, facts.TargetTripleStringIndex(), target))
    {
        case MemoryStatus.Err(var targetError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii dataLayout = new();
    switch (AppendLogicalPackageImageFactString(image, facts, facts.TargetDataLayoutStringIndex(), dataLayout))
    {
        case MemoryStatus.Err(var dataLayoutError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii feature0Name = new();
    switch (AppendLogicalPackageImageFactString(image, facts, feature0, feature0Name))
    {
        case MemoryStatus.Err(var feature0Error):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii feature1Name = new();
    switch (AppendLogicalPackageImageFactString(image, facts, feature1, feature1Name))
    {
        case MemoryStatus.Err(var feature1Error):
            return false;
        case MemoryStatus.Ok:
    }

    return facts.SectionCount() == 3
        && facts.StringCount() == 11
        && facts.HasBuildProfile()
        && facts.HasTarget()
        && facts.HasCDataModel()
        && facts.HasAggregateLayout()
        && facts.TargetFeatureCount() == 2
        && facts.CPointerBitWidth() == 64
        && facts.CLongBitWidth() == 64
        && facts.CSizeTBitWidth() == 64
        && facts.CPtrDiffTBitWidth() == 64
        && !facts.CCharIsSigned()
        && facts.AggregatePointerSizeBytes() == 8
        && facts.AggregatePointerAlignmentBytes() == 8
        && LlvmTextEquals(root, "Demo")
        && LlvmTextEquals(profile, "release")
        && LlvmTextEquals(target, "x86_64-unknown-linux-stark")
        && LlvmTextEquals(dataLayout, "e-p:64:64")
        && LlvmTextEquals(feature0Name, "+sse2")
        && LlvmTextEquals(feature1Name, "+popcnt");
}

[Fact]
fn bool LogicalPackageImageBuilderWritesDeduplicatedCompactFacts()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo")
        || !builder.SetLibraryFileName("Demo")
        || !builder.SetBuildProfile("release")
        || !builder.SetTargetTriple("x86_64-unknown-linux-stark")
        || !builder.SetTargetDataLayout("e-p:64:64")
        || !builder.SetTargetCpu("generic")
        || !builder.SetRelocationModel("static")
        || !builder.SetCodeModel("small")
        || !builder.AddTargetFeature("+sse2")
        || !builder.AddTargetFeature("+sse2")
        || !builder.AddTargetFeature("+popcnt")
        || !builder.SetCDataModel("linux", false, 64, 64, 64, 64)
        || !builder.SetAggregatePointerLayout(8, 8))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> manifestPayload = new();
    if (manifestPayload.Add(11) == 0 || manifestPayload.Add(22) == 0)
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> image = new();
    if (!TrySerializeLogicalPackageImage(builder, manifestPayload, image))
    {
        return false;
    }

    stack mut LogicalPackageImageFacts facts = new();
    stack mut u32[0 max] feature0 = 0;
    stack mut u32[0 max] feature1 = 0;
    stack mut u32[0 max] feature2 = 0;
    if (!PackageImageIsValid(image)
        || !TryReadLogicalPackageImageFacts(image, facts)
        || !TryReadLogicalPackageImageTargetFeatureStringIndex(image, facts, 0, feature0)
        || !TryReadLogicalPackageImageTargetFeatureStringIndex(image, facts, 1, feature1)
        || !TryReadLogicalPackageImageTargetFeatureStringIndex(image, facts, 2, feature2))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> copiedPayload = new();
    if (!TryCopyLogicalPackageImageManifestPayload(image, facts, copiedPayload))
    {
        return false;
    }

    return builder.StringCount() == 10
        && builder.TargetFeatureCount() == 3
        && facts.SectionCount() == 3
        && facts.StringCount() == 10
        && facts.RootModuleStringIndex() == 0
        && facts.LibraryFileNameStringIndex() == 0
        && facts.BuildProfileStringIndex() == 1
        && facts.TargetTripleStringIndex() == 2
        && facts.TargetDataLayoutStringIndex() == 3
        && facts.TargetCpuStringIndex() == 4
        && facts.RelocationModelStringIndex() == 5
        && facts.CodeModelStringIndex() == 6
        && facts.CDataModelKindStringIndex() == 9
        && facts.HasBuildProfile()
        && facts.HasTarget()
        && facts.HasCDataModel()
        && facts.HasAggregateLayout()
        && facts.TargetFeatureCount() == 3
        && feature0 == 7
        && feature1 == 7
        && feature2 == 8
        && facts.CPointerBitWidth() == 64
        && facts.CLongBitWidth() == 64
        && facts.CSizeTBitWidth() == 64
        && facts.CPtrDiffTBitWidth() == 64
        && !facts.CCharIsSigned()
        && facts.AggregatePointerSizeBytes() == 8
        && facts.AggregatePointerAlignmentBytes() == 8
        && copiedPayload.Count() == 2
        && copiedPayload.Get(1) == 11
        && copiedPayload.Get(2) == 22;
}

[Fact]
fn bool BrotliUtf8JsonPayloadWritesUncompressedMetaBlockStream()
{
    stack mut IrTable<u8[0 max]> raw = new();
    if (raw.Add(97) == 0 || raw.Add(98) == 0 || raw.Add(99) == 0)
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> encoded = new();
    if (!TryEncodeBrotliUtf8JsonPayload(raw, encoded))
    {
        return false;
    }

    return encoded.Count() == 7
        && encoded.Get(1) == 32
        && encoded.Get(2) == 0
        && encoded.Get(3) == 16
        && encoded.Get(4) == 97
        && encoded.Get(5) == 98
        && encoded.Get(6) == 99
        && encoded.Get(7) == 3;
}

[Fact]
fn bool Stage1BrotliManifestPayloadDecodesWithoutHostHandoff()
{
    stack mut IrTable<u8[0 max]> raw = new();
    stack mut u32[0 max] index = 0;
    stack mut u8[0 250] byteValue = 3;
    while willexit (index < 70000)
    {
        if (raw.Add((u8[0 max])byteValue) == 0)
        {
            return false;
        }

        if (byteValue >= 234)
        {
            byteValue = byteValue - 234;
        }
        else
        {
            byteValue = byteValue + 17;
        }

        index = index + 1;
    }

    stack mut IrTable<u8[0 max]> encoded = new();
    stack mut IrTable<u8[0 max]> decoded = new();
    if (!TryEncodeBrotliUtf8JsonPayload(raw, encoded)
        || !TryDecodeStage1BrotliUtf8JsonPayload(encoded, decoded)
        || decoded.Count() != raw.Count())
    {
        return false;
    }

    stack mut u32[0 max] byteIndex = 1;
    while willexit ((u64[0 2 ** 63 - 1])byteIndex <= raw.Count())
    {
        if (decoded.Get(byteIndex) != raw.Get(byteIndex))
        {
            return false;
        }

        byteIndex = byteIndex + 1;
    }

    stack mut LogicalPackageImageBuilder packageBuilder = new();
    if (!packageBuilder.SetRootModule("DecoderFixture")
        || !packageBuilder.SetLibraryFileName("libDecoderFixture.a")
        || !packageBuilder.SetBuildProfile("release")
        || !packageBuilder.SetTargetTriple("arm64-apple-macosx")
        || !packageBuilder.SetTargetDataLayout("e-m:o-i64:64-i128:128-n32:64-S128")
        || !packageBuilder.SetTargetCpu("generic")
        || !packageBuilder.SetRelocationModel("pic")
        || !packageBuilder.SetCodeModel("small")
        || !packageBuilder.SetCDataModel("macos", true, 64, 64, 64, 64)
        || !packageBuilder.SetAggregatePointerLayout(8, 8))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> image = new();
    stack mut LogicalPackageImageFacts imageFacts = new();
    stack mut IrTable<u8[0 max]> imageDecoded = new();
    if (!TrySerializeLogicalPackageImage(packageBuilder, encoded, image)
        || !TryReadLogicalPackageImageFacts(image, imageFacts)
        || !TryDecodeLogicalPackageImageManifestJsonBytes(image, imageFacts, imageDecoded)
        || imageDecoded.Count() != raw.Count())
    {
        return false;
    }

    stack mut u32[0 max] imageByteIndex = 1;
    while willexit ((u64[0 2 ** 63 - 1])imageByteIndex <= raw.Count())
    {
        if (imageDecoded.Get(imageByteIndex) != raw.Get(imageByteIndex))
        {
            return false;
        }

        imageByteIndex = imageByteIndex + 1;
    }

    stack mut IrTable<u8[0 max]> malformed = new();
    if (malformed.Add(255) == 0)
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> rejected = new();
    return !TryDecodeStage1BrotliUtf8JsonPayload(malformed, rejected);
}

[Fact]
fn bool LogicalPackageManifestBrotliJsonPayloadWrapsManifestForImageWriteout()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    if (!manifestBuilder.AddModule("Demo"))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> rawPayload = new();
    stack mut IrTable<u8[0 max]> brotliPayload = new();
    unsafe
    {
        if (!TryEncodeLogicalPackageManifestJson(builder, manifestBuilder, rawPayload)
            || !TryEncodeLogicalPackageManifestBrotliJson(builder, manifestBuilder, brotliPayload))
        {
            return false;
        }
    }

    if (rawPayload.Count() == 0
        || rawPayload.Count() > 65536
        || brotliPayload.Count() != rawPayload.Count() + 4
        || brotliPayload.Get(4) != rawPayload.Get(1))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> image = new();
    if (!TrySerializeLogicalPackageImage(builder, brotliPayload, image))
    {
        return false;
    }

    stack mut LogicalPackageImageFacts facts = new();
    stack mut IrTable<u8[0 max]> copiedPayload = new();
    if (!PackageImageIsValid(image)
        || !TryReadLogicalPackageImageFacts(image, facts)
        || !TryCopyLogicalPackageImageManifestPayload(image, facts, copiedPayload)
        || copiedPayload.Count() != brotliPayload.Count())
    {
        return false;
    }

    stack mut u32[0 max] byteRow = 1;
    while willexit ((u64[0 2 ** 63 - 1])byteRow <= brotliPayload.Count())
    {
        if (copiedPayload.Get(byteRow) != brotliPayload.Get(byteRow))
        {
            return false;
        }

        byteRow = byteRow + 1;
    }

    stack u32[0 max] lastByteRow = (u32[0 max])brotliPayload.Count();
    return facts.ManifestLength() == (u64[0 max])brotliPayload.Count()
        && brotliPayload.Get(lastByteRow) == 3;
}

[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesPackageHeaderAndModuleShells()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo")
        || !builder.SetLibraryFileName("Demo")
        || !builder.SetBuildProfile("release")
        || !builder.SetTargetTriple("x86_64-unknown-linux-stark")
        || !builder.SetTargetDataLayout("e-p:64:64")
        || !builder.SetTargetCpu("generic")
