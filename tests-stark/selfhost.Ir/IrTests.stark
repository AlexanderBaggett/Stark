[Fact]
fn bool CompileFunctionRejectsPointerParamsAsIntegerValues()
{
    stack mut OwnedAscii borrowValue = new();
    stack mut OwnedAscii outValue = new();
    return !CompileFunctionToLlvm("fn i64 bad(borrow i32 value) { return value }", borrowValue)
        && !CompileFunctionToLlvm("fn i64 bad(out i32 value) { return value }", outValue);
}

[Fact]
fn bool CompileModulePointerParametersLowerGranularAttributes()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn i64 read(borrow i32 value) { return 1 } fn i64 main() { return 0 }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1(ptr captures(none) readonly %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\ndefine internal dso_local i64 @f2() {\nb1:\n  %v1 = add i64 0, 0\n  ret i64 %v1\n}\n");
}

