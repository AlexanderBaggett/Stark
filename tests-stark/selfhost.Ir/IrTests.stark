        && !CompileModuleFromAst("fn classify(x) { switch (x) { case 0: return 10; case 1: return 20; case 0: return 30; default: return 40; } } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { switch (x) { case 0: return 10; case 1: return 20; } } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { switch (x) { case x: return 10; case 1: return 20; default: return 30; } } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { switch (x) { case 0: return x < 1; case 1: return 20; default: return 30; } } fn main() { return classify(1) }", s)
        && CompileModuleFromAst("fn classify(x) { switch (x) { case 0: return 10; case 1: return 20; default: return 30; } } fn main() { return classify(1) }", s);
