[Fact]
fn bool CompileFixedArrayStorageLocalListSwitchLocalScalarAssignmentUsesDirectElementLoads()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("fn i64[min max] main() { stack i32[0 20][3] values = { 1, 9, 3 }; var score = 0; switch (values) { case [1, _, 3]: score = 10; case [2, _, _]: { score = 20; } default: score = 30; } return score }", sink);
    return ok
        && System.Text.Contains(sink.View(), "alloca [12 x i8], align 4")
        && System.Text.Contains(sink.View(), "store i32 1")
        && System.Text.Contains(sink.View(), "store i32 9")
        && System.Text.Contains(sink.View(), "store i32 3")
        && System.Text.Contains(sink.View(), "load i32")
        && System.Text.Contains(sink.View(), "!range")
        && System.Text.Contains(sink.View(), "icmp eq i32")
        && System.Text.Contains(sink.View(), " phi i64 ")
        && System.Text.Contains(sink.View(), "br i1")
        && !System.Text.Contains(sink.View(), "extractvalue [3 x i32]")
        && !System.Text.Contains(sink.View(), "switch [3 x i32]")
        && ClangVerifiesLlvmText(sink);
}

