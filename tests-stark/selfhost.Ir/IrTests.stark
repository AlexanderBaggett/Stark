[Fact]
fn bool PackageTablesPreserveRecursiveNestedStorageMutationIfStatement()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Pick(bool outer, bool inner, bool deep) { stack mut i64[min max] value = 0; if outer { if inner { if deep { value = 1; } else { value = 2; } } else { value = 3; } } else { if inner { value = 4; } else { if deep { value = 5; } else { value = 6; } } } return value }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 16
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 16
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 20
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(4)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(5)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(6)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(7)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(8)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(9)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(10)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(11)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(12)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(13)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(14)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(15)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(16)) == MirTermKind.Return;
}

