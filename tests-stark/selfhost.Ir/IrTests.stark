                          "TargetType": { "Kind": "Named", "Name": "Demo.Item" }
                        },
                        {
                          "Name": "Required"
                        }
                      ],
                      "IsDynTrait": true,
                      "ThreadSafetyLawAttributes": [
                        {
                          "Kind": "grant",
                          "LawName": "Shareable",
                          "Condition": {
                            "LawName": "Transferable",
                            "Type": { "Kind": "Named", "Name": "Demo.Item" }
                          }
                        },
                        {
                          "Kind": "deny",
                          "LawName": "Transferable"
                        }
                      ]
                    }
                  ],
                  "Globals": []
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "TypedInterface": {
                "Functions": [],
                "Types": [
                  {
                    "Name": "Bad",
                    "QualifiedName": "Demo.Bad",
                    "Visibility": "public",
                    "Kind": "struct",
                    "Fields": [],
                    "ImplementedTraitTypes": [ { "Name": "MissingKind" } ]
                  }
                ],
                "Globals": []
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageTypedTypeFactGraph graph = new();
    stack mut LogicalPackageTypedTypeFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageTypedTypeFactJsonGraph(manifestJson, 0, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageTypedTypeFactJsonGraph(malformedJson, 0, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageTypedTypeRow typeRow = graph.TypeRowAt(1);
    stack LogicalPackageTypedTypeAssociatedTypeRow associatedItem = graph.AssociatedTypeRowAt(1);
    stack LogicalPackageTypedTypeAssociatedTypeRow associatedRequired = graph.AssociatedTypeRowAt(2);
    stack LogicalPackageTypedTypeImplementedTraitNameRow traitName = graph.ImplementedTraitNameRowAt(1);
    stack LogicalPackageTypedTypeImplementedTraitTypeRow traitType = graph.ImplementedTraitTypeRowAt(1);
    stack LogicalPackageTypedTypeThreadSafetyLawAttributeRow grant = graph.ThreadSafetyLawAttributeRowAt(1);
    stack LogicalPackageTypedTypeThreadSafetyLawAttributeRow deny = graph.ThreadSafetyLawAttributeRowAt(2);
    stack LogicalPackageTypeReferenceRow associatedTargetType =
        graph.TypeReferenceGraph().TypeReferenceAt(associatedItem.TargetTypeReferenceRow());
    stack LogicalPackageTypeReferenceRow implementedTraitType =
        graph.TypeReferenceGraph().TypeReferenceAt(traitType.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow conditionType =
        graph.TypeReferenceGraph().TypeReferenceAt(grant.ConditionTypeReferenceRow());
    stack LogicalPackageTypedTypeFactTextRow kindTextRow = graph.TextRowAt(typeRow.KindTextRow());
    stack LogicalPackageTypedTypeFactTextRow backendModeTextRow =
        graph.TextRowAt(typeRow.BackendOptimizationModeTextRow());
    stack LogicalPackageTypedTypeFactTextRow structLayoutTextRow =
        graph.TextRowAt(typeRow.StructLayoutTextRow());
    stack LogicalPackageTypedTypeFactTextRow associatedItemNameTextRow =
        graph.TextRowAt(associatedItem.NameTextRow());
    stack LogicalPackageTypedTypeFactTextRow associatedRequiredNameTextRow =
        graph.TextRowAt(associatedRequired.NameTextRow());
    stack LogicalPackageTypedTypeFactTextRow traitNameTextRow = graph.TextRowAt(traitName.NameTextRow());
    stack LogicalPackageTypedTypeFactTextRow grantKindTextRow = graph.TextRowAt(grant.KindTextRow());
    stack LogicalPackageTypedTypeFactTextRow grantLawNameTextRow = graph.TextRowAt(grant.LawNameTextRow());
    stack LogicalPackageTypedTypeFactTextRow grantConditionLawNameTextRow =
        graph.TextRowAt(grant.ConditionLawNameTextRow());
    stack LogicalPackageTypedTypeFactTextRow denyKindTextRow = graph.TextRowAt(deny.KindTextRow());
    stack mut OwnedAscii kind = new();
    stack mut OwnedAscii backendMode = new();
    stack mut OwnedAscii structLayout = new();
    stack mut OwnedAscii associatedName = new();
    stack mut OwnedAscii requiredName = new();
    stack mut OwnedAscii traitNameText = new();
    stack mut OwnedAscii grantKind = new();
    stack mut OwnedAscii grantLaw = new();
    stack mut OwnedAscii grantConditionLaw = new();
    stack mut OwnedAscii denyKind = new();
    stack mut OwnedAscii associatedTargetName = new();
    stack mut OwnedAscii traitTypeName = new();
    stack mut OwnedAscii conditionTypeName = new();
    return graph.TypeRowCount() == 1
        && graph.AssociatedTypeRowCount() == 2
        && graph.ImplementedTraitNameRowCount() == 1
        && graph.ImplementedTraitTypeRowCount() == 1
        && graph.ThreadSafetyLawAttributeRowCount() == 2
        && graph.TypeReferenceCount() == 3
        && graph.TextRowCount() >= 11
        && graph.TextByteCount() > 0
        && typeRow.ModuleOrdinal() == 0
        && typeRow.TypeOrdinal() == 0
        && typeRow.HasBackendOptimizationMode()
        && typeRow.HasStructLayout()
        && typeRow.HasPackBytes()
        && typeRow.PackBytes() == 1
        && typeRow.HasAlignBytes()
        && typeRow.AlignBytes() == 8
        && typeRow.IsDynTrait()
        && associatedItem.AssociatedTypeOrdinal() == 0
        && associatedItem.HasTargetType()
        && associatedRequired.AssociatedTypeOrdinal() == 1
        && !associatedRequired.HasTargetType()
        && traitName.TraitOrdinal() == 0
        && traitType.TraitOrdinal() == 0
        && grant.HasCondition()
        && deny.AttributeOrdinal() == 1
        && !deny.HasCondition()
        && associatedTargetType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.TypeAssociatedTypeTarget
        && associatedTargetType.Summary().PayloadOrdinal() == 0
        && implementedTraitType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.TypeImplementedTrait
        && conditionType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.TypeThreadSafetyLawAttributeConditionType
        && AppendLogicalPackageTypedTypeFactText(graph, kindTextRow, kind) == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(
            graph,
            backendModeTextRow,
            backendMode) == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(
            graph,
            structLayoutTextRow,
            structLayout) == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, associatedItemNameTextRow, associatedName)
            == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, associatedRequiredNameTextRow, requiredName)
            == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, traitNameTextRow, traitNameText)
            == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, grantKindTextRow, grantKind)
            == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, grantLawNameTextRow, grantLaw)
            == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(
            graph,
            grantConditionLawNameTextRow,
            grantConditionLaw) == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, denyKindTextRow, denyKind)
            == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            associatedItem.TargetTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            associatedTargetName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            traitType.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            traitTypeName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            grant.ConditionTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            conditionTypeName)
        && OwnedAsciiEqualsAscii(kind, "struct")
        && OwnedAsciiEqualsAscii(backendMode, "aggressive")
        && OwnedAsciiEqualsAscii(structLayout, "C")
        && OwnedAsciiEqualsAscii(associatedName, "Item")
        && OwnedAsciiEqualsAscii(requiredName, "Required")
        && OwnedAsciiEqualsAscii(traitNameText, "Demo.Drawable")
        && OwnedAsciiEqualsAscii(grantKind, "grant")
        && OwnedAsciiEqualsAscii(grantLaw, "Shareable")
        && OwnedAsciiEqualsAscii(grantConditionLaw, "Transferable")
        && OwnedAsciiEqualsAscii(denyKind, "deny")
        && OwnedAsciiEqualsAscii(associatedTargetName, "Demo.Item")
        && OwnedAsciiEqualsAscii(traitTypeName, "Demo.Drawable")
        && OwnedAsciiEqualsAscii(conditionTypeName, "Demo.Item");
}

[Fact]
fn bool LogicalPackageImageMaterializesTypedTypeEnumVariantRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "TypedInterface": {
                  "Functions": [],
                  "Types": [
                    {
                      "Name": "Packet",
                      "QualifiedName": "Demo.Packet",
                      "Visibility": "public",
                      "Kind": "enum",
                      "Fields": [],
                      "Variants": [
                        {
                          "Name": "Ok",
                          "UsesNamedFields": false,
                          "Role": "ok",
                          "Fields": [
                            {
                              "Name": "Item0",
                              "Type": { "Kind": "Named", "Name": "Demo.Item" }
                            }
                          ]
                        },
                        {
                          "Name": "Err",
                          "UsesNamedFields": true,
                          "Role": "err",
                          "AbsorbsErrorType": { "Kind": "Named", "Name": "Demo.Error" },
                          "Fields": [
                            {
                              "Name": "reason",
                              "Type": { "Kind": "Named", "Name": "Demo.Error" }
                            },
                            {
                              "Name": "code",
                              "Type": { "Kind": "Named", "Name": "Demo.Code" }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "Globals": []
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "TypedInterface": {
                "Functions": [],
                "Types": [
                  {
                    "Name": "Bad",
                    "QualifiedName": "Demo.Bad",
                    "Visibility": "public",
                    "Kind": "enum",
                    "Fields": [],
                    "Variants": [
                      {
                        "Name": "Broken",
                        "UsesNamedFields": false,
                        "Fields": [
                          { "Name": "Item0" }
                        ]
                      }
                    ]
                  }
                ],
                "Globals": []
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageTypedTypeFactGraph graph = new();
    stack mut LogicalPackageTypedTypeFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageTypedTypeFactJsonGraph(manifestJson, 0, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageTypedTypeFactJsonGraph(malformedJson, 0, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageTypedTypeEnumVariantRow okVariant = graph.EnumVariantRowAt(1);
    stack LogicalPackageTypedTypeEnumVariantRow errVariant = graph.EnumVariantRowAt(2);
    stack LogicalPackageTypedTypeEnumPayloadRow okPayload = graph.EnumPayloadRowAt(1);
    stack LogicalPackageTypedTypeEnumPayloadRow errPayloadReason = graph.EnumPayloadRowAt(2);
    stack LogicalPackageTypedTypeEnumPayloadRow errPayloadCode = graph.EnumPayloadRowAt(3);
    stack LogicalPackageTypeReferenceRow okPayloadType =
        graph.TypeReferenceGraph().TypeReferenceAt(okPayload.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow errAbsorbsType =
        graph.TypeReferenceGraph().TypeReferenceAt(errVariant.AbsorbsErrorTypeReferenceRow());
    stack LogicalPackageTypeReferenceRow errReasonType =
        graph.TypeReferenceGraph().TypeReferenceAt(errPayloadReason.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow errCodeType =
        graph.TypeReferenceGraph().TypeReferenceAt(errPayloadCode.TypeReferenceRow());
    stack LogicalPackageTypedTypeFactTextRow okNameTextRow = graph.TextRowAt(okVariant.NameTextRow());
    stack LogicalPackageTypedTypeFactTextRow okRoleTextRow = graph.TextRowAt(okVariant.RoleTextRow());
    stack LogicalPackageTypedTypeFactTextRow okPayloadNameTextRow =
        graph.TextRowAt(okPayload.NameTextRow());
    stack LogicalPackageTypedTypeFactTextRow errNameTextRow = graph.TextRowAt(errVariant.NameTextRow());
    stack LogicalPackageTypedTypeFactTextRow errRoleTextRow = graph.TextRowAt(errVariant.RoleTextRow());
    stack LogicalPackageTypedTypeFactTextRow errReasonNameTextRow =
        graph.TextRowAt(errPayloadReason.NameTextRow());
    stack LogicalPackageTypedTypeFactTextRow errCodeNameTextRow =
        graph.TextRowAt(errPayloadCode.NameTextRow());
    stack mut OwnedAscii okName = new();
    stack mut OwnedAscii okRole = new();
    stack mut OwnedAscii okPayloadName = new();
    stack mut OwnedAscii errName = new();
    stack mut OwnedAscii errRole = new();
    stack mut OwnedAscii errReasonName = new();
    stack mut OwnedAscii errCodeName = new();
    stack mut OwnedAscii okPayloadTypeName = new();
    stack mut OwnedAscii errAbsorbsTypeName = new();
    stack mut OwnedAscii errReasonTypeName = new();
    stack mut OwnedAscii errCodeTypeName = new();
    return graph.TypeRowCount() == 1
        && graph.EnumVariantRowCount() == 2
        && graph.EnumPayloadRowCount() == 3
        && graph.TypeReferenceCount() == 4
        && okVariant.ModuleOrdinal() == 0
        && okVariant.TypeOrdinal() == 0
        && okVariant.VariantOrdinal() == 0
        && !okVariant.UsesNamedFields()
        && okVariant.HasRole()
        && !okVariant.HasAbsorbsErrorType()
        && okVariant.FirstPayloadRow() == 1
        && okVariant.PayloadRowCount() == 1
        && errVariant.VariantOrdinal() == 1
        && errVariant.UsesNamedFields()
        && errVariant.HasRole()
        && errVariant.HasAbsorbsErrorType()
        && errVariant.FirstPayloadRow() == 2
        && errVariant.PayloadRowCount() == 2
        && okPayload.VariantOrdinal() == 0
        && okPayload.PayloadOrdinal() == 0
        && errPayloadReason.VariantOrdinal() == 1
        && errPayloadReason.PayloadOrdinal() == 0
        && errPayloadCode.PayloadOrdinal() == 1
        && okPayloadType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.TypeEnumVariantPayloadType
        && okPayloadType.Summary().VariantOrdinal() == 0
        && okPayloadType.Summary().PayloadOrdinal() == 0
        && errAbsorbsType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.TypeEnumVariantAbsorbsErrorType
        && errAbsorbsType.Summary().VariantOrdinal() == 1
        && errAbsorbsType.Summary().PayloadOrdinal() == 0
        && errReasonType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.TypeEnumVariantPayloadType
        && errReasonType.Summary().VariantOrdinal() == 1
        && errReasonType.Summary().PayloadOrdinal() == 0
        && errCodeType.Summary().VariantOrdinal() == 1
        && errCodeType.Summary().PayloadOrdinal() == 1
        && AppendLogicalPackageTypedTypeFactText(graph, okNameTextRow, okName) == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, okRoleTextRow, okRole) == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, okPayloadNameTextRow, okPayloadName)
            == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, errNameTextRow, errName) == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, errRoleTextRow, errRole) == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, errReasonNameTextRow, errReasonName)
            == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeFactText(graph, errCodeNameTextRow, errCodeName)
            == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            okPayload.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            okPayloadTypeName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            errVariant.AbsorbsErrorTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            errAbsorbsTypeName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            errPayloadReason.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            errReasonTypeName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            errPayloadCode.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            errCodeTypeName)
        && OwnedAsciiEqualsAscii(okName, "Ok")
        && OwnedAsciiEqualsAscii(okRole, "ok")
        && OwnedAsciiEqualsAscii(okPayloadName, "Item0")
        && OwnedAsciiEqualsAscii(errName, "Err")
        && OwnedAsciiEqualsAscii(errRole, "err")
        && OwnedAsciiEqualsAscii(errReasonName, "reason")
        && OwnedAsciiEqualsAscii(errCodeName, "code")
        && OwnedAsciiEqualsAscii(okPayloadTypeName, "Demo.Item")
        && OwnedAsciiEqualsAscii(errAbsorbsTypeName, "Demo.Error")
        && OwnedAsciiEqualsAscii(errReasonTypeName, "Demo.Error")
        && OwnedAsciiEqualsAscii(errCodeTypeName, "Demo.Code");
}

[Fact]
fn bool LogicalPackageImageValidatesStageCompatibility()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildProfileTargetLogicalPackageImage(image);

    stack mut LogicalPackageImageFacts facts = new();
    if (!TryReadLogicalPackageImageFacts(image, facts))
    {
        return false;
    }

    stack LogicalPackageImageFacts emptyFacts = new();
    return LogicalPackageImageMatchesBuildStage(facts, "stage0")
        && !LogicalPackageImageMatchesBuildStage(facts, "stage1")
        && !LogicalPackageImageMatchesBuildStage(facts, "stage2")
        && !LogicalPackageImageMatchesBuildStage(facts, "")
        && !LogicalPackageImageMatchesBuildStage(emptyFacts, "stage0");
}

[Fact]
fn bool LogicalPackageImageValidatesProfileTargetBackendCompatibility()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildProfileTargetLogicalPackageImage(image);

    stack mut LogicalPackageImageFacts facts = new();
    if (!TryReadLogicalPackageImageFacts(image, facts))
    {
        return false;
    }

    return LogicalPackageImageMatchesBuildProfile(image, facts, "release")
        && !LogicalPackageImageMatchesBuildProfile(image, facts, "debug")
        && LogicalPackageImageMatchesTargetIdentity(
            image,
            facts,
            "x86_64-unknown-linux-stark",
            "e-p:64:64")
        && !LogicalPackageImageMatchesTargetIdentity(
            image,
            facts,
            "x86_64-unknown-linux-stark",
            "e-p:32:32")
        && LogicalPackageImageMatchesTargetBackendFacts(image, facts, "generic", "static", "small")
        && !LogicalPackageImageMatchesTargetBackendFacts(image, facts, "generic", "pic", "small")
        && facts.TargetFeatureCount() == 2
        && LogicalPackageImageHasTargetFeature(image, facts, "+sse2")
        && LogicalPackageImageHasTargetFeature(image, facts, "+popcnt")
        && !LogicalPackageImageHasTargetFeature(image, facts, "+avx2")
        && LogicalPackageImageMatchesCDataModel(image, facts, "linux", false, 64, 64, 64, 64)
        && !LogicalPackageImageMatchesCDataModel(image, facts, "linux", true, 64, 64, 64, 64)
        && LogicalPackageImageMatchesAggregatePointerLayout(facts, 8, 8)
        && !LogicalPackageImageMatchesAggregatePointerLayout(facts, 4, 4);
}

[Fact]
fn bool LogicalPackageImageValidatesExactPackageVersionCompatibility()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildProfileTargetLogicalPackageImage(image);

    stack mut u32[0 max] version = 0;
    if (!TryReadPackageImageVersion(image, version)
        || version != SupportedPackageImageVersion()
        || !PackageImageMatchesSupportedVersion(image))
    {
        return false;
    }

    if (!image.Replace(9, 1)
        || !image.Replace(10, 0)
        || !image.Replace(11, 0)
        || !image.Replace(12, 0))
    {
        return false;
    }

    stack mut LogicalPackageImageFacts rejectedFacts = new();
    return TryReadPackageImageVersion(image, version)
        && version == 1
        && !PackageImageMatchesSupportedVersion(image)
        && !TryReadLogicalPackageImageFacts(image, rejectedFacts);
}

[Fact]
fn bool LogicalPackageImageDoesNotDeserializeAsMir()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 0);

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    return !DeserializePackageImage(image, instrs, blocks, funcs, globals);
}

[Fact]
fn bool LogicalPackageImageRejectsBadPackageFactStringIndex()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 2);
    return ValidatePackageImage(image) == PackageImageValidationStatus.MalformedSectionDirectory
        && !PackageImageIsValid(image);
}

[Fact]
fn bool LogicalPackageImageRejectsInvalidUtf8StringTable()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildInvalidUtf8LogicalPackageImage(image);
    return ValidatePackageImage(image) == PackageImageValidationStatus.MalformedSectionDirectory
        && !PackageImageIsValid(image);
}

[Fact]
fn bool SectionedPackageImageRejectsUnknownRequiredSection()
{
    stack mut IrTable<u8[0 max]> image = new();
    WriteU32(image, 1380013139);
    WriteU32(image, 1196118091);
    WriteU32(image, 2);
    WriteU32(image, 1);
    WriteU64(image, 32);
    WriteU32(image, 1162891086);
    WriteU32(image, 1);
    WriteU64(image, 56);
    WriteU64(image, 0);
    WriteU32(image, 0);
    WriteU32(image, 0);
    return ValidatePackageImage(image) == PackageImageValidationStatus.UnsupportedFormat
        && !PackageImageIsValid(image);
}

[Fact]
fn bool PackageImageRejectsBadMagic()
{
    // A buffer without the magic header is rejected (nothing deserialized).
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 12345);
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    return !DeserializePackageImage(buf, bi, bb, bf, bg);
}

[Fact]
fn bool PackageImageRejectsTruncatedHeaderAndInspectionStaysEmpty()
{
    // Truncated buffers are malformed package images, not short reads into row 0.
    stack mut IrTable<u8[0 max]> buf = new();
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack mut OwnedAscii sink = new();
    stack mut OwnedAscii json = new();
    switch (InspectPackageImage(buf, sink))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            switch (InspectPackageImageJson(buf, json))
            {
                case MemoryStatus.Err(var jsonError):
                    return false;
                case MemoryStatus.Ok:
                    return !DeserializePackageImage(buf, bi, bb, bf, bg)
                        && LlvmTextEquals(sink, "")
                        && LlvmTextEquals(json, "")
                        && bi.Count() == 0
                        && bb.Count() == 0
                        && bf.Count() == 0
                        && bg.Count() == 0;
            }
    }
}

[Fact]
fn bool MalformedPackageImageFileInspectionFails()
{
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 826757197);
    return !PackageImageIsValid(buf)
        && PackageImageBufferInspectionFailsThroughFile(buf, PackageImageInspectionFormat.Text)
        && PackageImageBufferInspectionFailsThroughFile(buf, PackageImageInspectionFormat.Json);
}

[Fact]
fn bool PackageImageValidationReportsFailureKinds()
{
    stack mut IrTable<u8[0 max]> empty = new();

    stack mut IrTable<u8[0 max]> badMagic = new();
    WriteU32(badMagic, 12345);

    stack mut IrTable<u8[0 max]> truncatedSection = new();
    WriteU32(truncatedSection, 826757197);
    WriteU32(truncatedSection, 21);
    WriteU32(truncatedSection, 25);
    WriteU32(truncatedSection, 29);
    WriteU32(truncatedSection, 33);

    stack mut IrTable<u8[0 max]> badDirectory = new();
    WriteU32(badDirectory, 826757197);
    WriteU32(badDirectory, 22);
    WriteU32(badDirectory, 26);
    WriteU32(badDirectory, 30);
    WriteU32(badDirectory, 34);

    stack mut OwnedAscii statusName = new();
    switch (statusName.AppendAscii(PackageImageValidationStatusName(PackageImageValidationStatus.MalformedSectionDirectory)))
    {
        case MemoryStatus.Err(var statusNameError):
            return false;
        case MemoryStatus.Ok:
    }

    return ValidatePackageImage(empty) == PackageImageValidationStatus.TruncatedHeader
        && ValidatePackageImage(badMagic) == PackageImageValidationStatus.UnsupportedFormat
        && ValidatePackageImage(truncatedSection) == PackageImageValidationStatus.TruncatedSection
        && ValidatePackageImage(badDirectory) == PackageImageValidationStatus.MalformedSectionDirectory
        && LlvmTextEquals(statusName, "malformed-section-directory");
}

[Fact]
fn bool PackageImageRejectsMissingSections()
{
    // "MIR1" with valid-looking offsets but no section count bytes must fail before
    // the fixed-record deserializers touch the image.
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 826757197);
    WriteU32(buf, 21);
    WriteU32(buf, 25);
    WriteU32(buf, 29);
    WriteU32(buf, 33);
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack mut OwnedAscii sink = new();
    stack mut OwnedAscii json = new();
    switch (InspectPackageImage(buf, sink))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            switch (InspectPackageImageJson(buf, json))
            {
                case MemoryStatus.Err(var jsonError):
                    return false;
                case MemoryStatus.Ok:
                    return !DeserializePackageImage(buf, bi, bb, bf, bg)
                        && LlvmTextEquals(sink, "")
                        && LlvmTextEquals(json, "")
                        && bi.Count() == 0
                        && bb.Count() == 0
                        && bf.Count() == 0
                        && bg.Count() == 0;
            }
    }
}

[Fact]
fn bool PackageImageWithAsmRejectsMissingAsmSection()
{
    // "MIR2" has four empty MIR sections here, but the required asm metadata section
    // count is absent at byte 41, so validation rejects the image.
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 844253517);
    WriteU32(buf, 25);
    WriteU32(buf, 29);
    WriteU32(buf, 33);
    WriteU32(buf, 37);
    WriteU32(buf, 41);
    WriteU32(buf, 0);
    WriteU32(buf, 0);
    WriteU32(buf, 0);
    WriteU32(buf, 0);
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack mut OwnedAscii sink = new();
    stack mut OwnedAscii json = new();
    switch (InspectPackageImage(buf, sink))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            switch (InspectPackageImageJson(buf, json))
            {
                case MemoryStatus.Err(var jsonError):
                    return false;
                case MemoryStatus.Ok:
                    return !DeserializePackageImageWithAsm(buf, bi, bb, bf, bg, asmMetadata)
                        && LlvmTextEquals(sink, "")
                        && LlvmTextEquals(json, "")
                        && bi.Count() == 0
                        && bb.Count() == 0
                        && bf.Count() == 0
                        && bg.Count() == 0
                        && asmMetadata.FunctionCount() == 0;
            }
    }
}

