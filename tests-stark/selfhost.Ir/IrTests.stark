import Compiler.AsmFacts
import Compiler.Ir
import Compiler.Mir
import Compiler.Lexing
import Compiler.Parsing
import Compiler.Typing.TypedEnumLayoutModel
import Compiler.Typing.TypedEnumPayloadModel
import Compiler.Typing.TypedPipeline
import System.Memory
import System.Text
import System.Runtime.Buffer
import System.Testing
import System.IO
import System.Console
[Collection("ir")]
module IrTests

[Fact]
fn bool TypedHandleRoundTripsIndex()
{
    // A handle wraps its 1-based index and reads it back; a non-zero index is valid.
    stack TypeId id = TypeIdOf(5);
    return id.Index() == 5 && id.IsValid();
}

[Fact]
fn bool DefaultHandleIsInvalidZero()
{
    // A default-constructed handle is the invalid sentinel (index 0), as is `Of(0)`.
    stack mut TypeId fresh = new();
    return fresh.Index() == 0
        && !fresh.IsValid()
        && !TypeIdOf(0).IsValid();
}

[Fact]
fn bool HandleEqualityComparesIndex()
{
    // Equality is by index; distinct indices are unequal.
    return MirValueIdOf(3).Equals(MirValueIdOf(3))
        && !MirValueIdOf(3).Equals(MirValueIdOf(4));
}

[Fact]
fn bool DistinctHandleKindsAreSeparateTypes()
{
    // The id kinds are distinct value types over the same index space — a SymbolId
    // and a TypeId built from the same index are independent values (the compiler
    // rejects passing one where the other is expected; here we just confirm both
    // round-trip their index).
    stack SymbolId sym = SymbolIdOf(7);
    stack TypeId ty = TypeIdOf(7);
    return sym.Index() == 7 && ty.Index() == 7;
}

[Fact]
fn bool IrTableAddsRowsWithOneBasedIndices()
{
    // The first row gets index 1 (0 stays the invalid sentinel), the second index 2,
    // and `Count` tracks the row total.
    stack mut IrTable<MirValueId> table = new();
    stack u32[0 max] first = table.Add(MirValueIdOf(100));
    stack u32[0 max] second = table.Add(MirValueIdOf(200));
    return first == 1 && second == 2 && table.Count() == 2;
}

[Fact]
fn bool IrTableGetReadsBackTheStoredRow()
{
    // A row read back at its index equals what was added.
    stack mut IrTable<MirValueId> table = new();
    stack u32[0 max] idx = table.Add(MirValueIdOf(42));
    stack MirValueId row = table.Get(idx);
    return table.Contains(idx) && row.Index() == 42;
}

[Fact]
fn bool IrTableContainsRejectsZeroAndOutOfRange()
{
    // Index 0 (invalid) and indices past the end are not contained.
    stack mut IrTable<TypeId> table = new();
    stack u32[0 max] idx = table.Add(TypeIdOf(1));
    return !table.Contains(0)
        && table.Contains(1)
        && !table.Contains(2);
}

[Fact]
fn bool ValueFactsDefaultToAbsent()
{
    // A fresh fact record has no attached facts.
    stack ValueFacts vf = new();
    return !vf.HasAlignment()
        && vf.AlignmentBytes() == 0
        && !vf.HasCallingAbi()
        && !vf.HasNoAlias()
        && !vf.Volatile()
        && !vf.HasIntegerRange()
        && !vf.HasNullability();
}

[Fact]
fn bool ValueFactsSetAndQuery()
{
    // Setting facts makes them present and queryable.
    stack mut ValueFacts vf = new();
    vf.SetAlignment(8);
    vf.SetCallingAbi(AbiKind.CAbi);
    vf.MarkNoAlias();
    vf.SetIntegerRange(2, 9);
    vf.MarkKnownNull();
    return vf.HasAlignment()
        && vf.AlignmentBytes() == 8
        && vf.HasCallingAbi()
        && vf.HasNoAlias()
        && vf.HasIntegerRange()
        && vf.IntegerRangeLower() == 2
        && vf.IntegerRangeUpperExclusive() == 9
        && vf.HasNullability()
        && vf.KnownNull()
        && !vf.KnownNonNull()
        && !vf.Volatile();
}

[Fact]
fn bool ValueFactsInheritCarriesPresentFactsOnly()
{
    // `InheritFrom` copies the source's present facts and leaves the destination's
    // own facts untouched where the source is absent.
    stack mut ValueFacts src = new();
    src.SetAlignment(16);
    src.MarkNoAlias();
    src.SetIntegerRange(0, 11);
    src.MarkKnownNonNull();

    stack mut ValueFacts dst = new();
    dst.MarkVolatile();
    dst.MarkKnownNull();
    dst.InheritFrom(src);

    return dst.HasAlignment()
        && dst.AlignmentBytes() == 16
        && dst.HasNoAlias()
        && dst.HasIntegerRange()
        && dst.IntegerRangeLower() == 0
        && dst.IntegerRangeUpperExclusive() == 11
        && dst.HasNullability()
        && !dst.KnownNull()
        && dst.KnownNonNull()
        && dst.Volatile()
        && !dst.HasCallingAbi();
}

[Fact]
fn bool ValueFactsInheritFromEmptyLeavesDestination()
{
    // Inheriting from a source with no facts changes nothing on the destination.
    stack ValueFacts empty = new();
    stack mut ValueFacts dst = new();
    dst.SetAlignment(4);
    dst.InheritFrom(empty);
    return dst.HasAlignment() && dst.AlignmentBytes() == 4;
}

[Fact]
fn bool ValueFactsStoreInIrTableByHandle()
{
    // Fact records attach to values through an `IrTable<ValueFacts>` keyed by the
    // value handle's index — the "one record per value" layout of doc 24 §4.
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts vf = new();
    vf.SetAlignment(32);
    stack u32[0 max] idx = facts.Add(vf);
    stack ValueFacts read = facts.Get(idx);
    return facts.Contains(idx) && read.AlignmentBytes() == 32;
}

[Fact]
fn bool ValueFactTransferRecordsGeneratedFactsAtMirHandle()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId value = MirConstInt(instrs, 42);
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts generated = new();
    generated.SetAlignment(8);
    generated.SetIntegerRange(42, 43);

    if (!RecordGeneratedValueFactsForMirValue(facts, value, generated))
    {
        return false;
    }

    stack ValueFacts read = ValueFactsForMirValue(facts, value);
    return facts.Count() == 1
        && read.HasAlignment()
        && read.AlignmentBytes() == 8
        && read.HasIntegerRange()
        && read.IntegerRangeLower() == 42
        && read.IntegerRangeUpperExclusive() == 43;
}

[Fact]
fn bool ValueFactTransferFillsSkippedHandlesWithEmptyFacts()
{
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts generated = new();
    generated.MarkNoAlias();
    generated.MarkKnownNull();

    if (!RecordGeneratedValueFactsForMirValue(facts, MirValueIdOf(3), generated))
    {
        return false;
    }

    stack ValueFacts first = ValueFactsForMirValue(facts, MirValueIdOf(1));
    stack ValueFacts second = ValueFactsForMirValue(facts, MirValueIdOf(2));
    stack ValueFacts third = ValueFactsForMirValue(facts, MirValueIdOf(3));
    return facts.Count() == 3
        && !first.HasNoAlias()
        && !first.HasNullability()
        && !second.HasNoAlias()
        && !second.HasNullability()
        && third.HasNoAlias()
        && third.KnownNull();
}

[Fact]
fn bool ValueFactTransferPreservesFactsForEquivalentValues()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId source = MirConstInt(instrs, 1);
    stack MirValueId zext = MirZExt(instrs, source);
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts sourceFacts = new();
    sourceFacts.SetIntegerRange(0, 2);
    sourceFacts.MarkVolatile();

    if (!RecordGeneratedValueFactsForMirValue(facts, source, sourceFacts))
    {
        return false;
    }

    if (!PreserveValueFactsForMirValue(facts, zext, source))
    {
        return false;
    }

    stack ValueFacts read = ValueFactsForMirValue(facts, zext);
    return facts.Count() == 2
        && read.HasIntegerRange()
        && read.IntegerRangeLower() == 0
        && read.IntegerRangeUpperExclusive() == 2
        && read.Volatile();
}

[Fact]
fn bool ValueFactTransferImportsParameterGlobalAndReturnFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId param = MirParam(instrs, 0);
    stack MirValueId call = MirCall(instrs, MirFuncIdOf(2));
    stack MirValueId load = MirLoadGlobal(instrs, 1);

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut ValueFacts p0Facts = new();
    p0Facts.SetIntegerRange(1, 6);
    stack u32[0 max] addedParam = paramFacts.Add(p0Facts);

    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts emptyReturn = new();
    stack u32[0 max] addedFirstReturn = functionReturnFacts.Add(emptyReturn);
    stack mut ValueFacts f2Facts = new();
    f2Facts.SetIntegerRange(10, 20);
    stack u32[0 max] addedSecondReturn = functionReturnFacts.Add(f2Facts);

    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut ValueFacts g1Facts = new();
    g1Facts.SetIntegerRange(-3, 4);
    stack u32[0 max] addedGlobal = globalFacts.Add(g1Facts);

    stack mut IrTable<ValueFacts> valueFacts = new();
    if (!ImportParameterValueFactsForMirValue(valueFacts, param, paramFacts, 0))
    {
        return false;
    }

    if (!ImportFunctionReturnValueFactsForMirValue(valueFacts, call, functionReturnFacts, MirFuncIdOf(2)))
    {
        return false;
    }

    if (!ImportGlobalValueFactsForMirValue(valueFacts, load, globalFacts, 1))
    {
        return false;
    }

    stack ValueFacts paramRead = ValueFactsForMirValue(valueFacts, param);
    stack ValueFacts callRead = ValueFactsForMirValue(valueFacts, call);
    stack ValueFacts loadRead = ValueFactsForMirValue(valueFacts, load);
    return addedParam == 1
        && addedFirstReturn == 1
        && addedSecondReturn == 2
        && addedGlobal == 1
        && valueFacts.Count() == 3
        && paramRead.IntegerRangeLower() == 1
        && paramRead.IntegerRangeUpperExclusive() == 6
        && callRead.IntegerRangeLower() == 10
        && callRead.IntegerRangeUpperExclusive() == 20
        && loadRead.IntegerRangeLower() == -3
        && loadRead.IntegerRangeUpperExclusive() == 4;
}

[Fact]
fn bool BuildMirValueRangeFactsImportsTypedCallReturnFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId call = MirCallTyped(instrs, MirType.I32, MirFuncIdOf(2));

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts emptyReturn = new();
    stack u32[0 max] addedFirstReturn = functionReturnFacts.Add(emptyReturn);
    stack mut ValueFacts f2Facts = new();
    f2Facts.SetIntegerRange(12, 13);
    f2Facts.SetAlignment(4);
    f2Facts.SetCallingAbi(AbiKind.CAbi);
    f2Facts.MarkNoAlias();
    f2Facts.MarkVolatile();
    stack u32[0 max] addedSecondReturn = functionReturnFacts.Add(f2Facts);
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts callFacts = ValueFactsForMirValue(valueFacts, call);
    return addedFirstReturn == 1
        && addedSecondReturn == 2
        && valueFacts.Count() == 1
        && MirValueType(instrs, call.Index()) == MirType.I32
        && callFacts.HasIntegerRange()
        && callFacts.IntegerRangeLower() == 12
        && callFacts.IntegerRangeUpperExclusive() == 13
        && callFacts.HasAlignment()
        && callFacts.AlignmentBytes() == 4
        && callFacts.HasCallingAbi()
        && callFacts.CallingAbi() == AbiKind.CAbi
        && callFacts.HasNoAlias()
        && callFacts.Volatile();
}

[Fact]
fn bool BuildMirValueRangeFactsImportsPointerCallReturnBackendFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId call = MirCallTyped(instrs, MirType.Ptr, MirFuncIdOf(1));

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts returnFacts = new();
    returnFacts.SetAlignment(8);
    returnFacts.MarkNoAlias();
    returnFacts.MarkKnownNonNull();
    stack u32[0 max] addedReturn = functionReturnFacts.Add(returnFacts);
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts callFacts = ValueFactsForMirValue(valueFacts, call);
    return addedReturn == 1
        && valueFacts.Count() == 1
        && MirValueType(instrs, call.Index()) == MirType.Ptr
        && callFacts.HasAlignment()
        && callFacts.AlignmentBytes() == 8
        && callFacts.HasNoAlias()
        && callFacts.HasNullability()
        && !callFacts.KnownNull()
        && callFacts.KnownNonNull();
}

[Fact]
fn bool BuildMirValueRangeFactsDerivesConstantsArithmeticAndPhi()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId two = MirConstInt(instrs, 2);
    stack MirValueId three = MirConstInt(instrs, 3);
    stack MirValueId five = MirAdd(instrs, two, three);
    stack MirValueId minusOne = MirSub(instrs, two, three);
    stack MirValueId six = MirMul(instrs, two, three);
    stack MirValueId less = MirCmpLt(instrs, two, three);
    stack MirValueId flag = MirZExt(instrs, less);
    stack MirValueId merged = MirPhi2(instrs, five, MirBlockIdOf(1), three, MirBlockIdOf(2));

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts fiveFacts = ValueFactsForMirValue(valueFacts, five);
    stack ValueFacts minusOneFacts = ValueFactsForMirValue(valueFacts, minusOne);
    stack ValueFacts sixFacts = ValueFactsForMirValue(valueFacts, six);
    stack ValueFacts lessFacts = ValueFactsForMirValue(valueFacts, less);
    stack ValueFacts flagFacts = ValueFactsForMirValue(valueFacts, flag);
    stack ValueFacts mergedFacts = ValueFactsForMirValue(valueFacts, merged);
    return valueFacts.Count() == instrs.Count()
        && fiveFacts.HasIntegerRange()
        && fiveFacts.IntegerRangeLower() == 5
        && fiveFacts.IntegerRangeUpperExclusive() == 6
        && minusOneFacts.HasIntegerRange()
        && minusOneFacts.IntegerRangeLower() == -1
        && minusOneFacts.IntegerRangeUpperExclusive() == 0
        && sixFacts.HasIntegerRange()
        && sixFacts.IntegerRangeLower() == 6
        && sixFacts.IntegerRangeUpperExclusive() == 7
        && lessFacts.HasIntegerRange()
        && lessFacts.IntegerRangeLower() == 0
        && lessFacts.IntegerRangeUpperExclusive() == 2
        && flagFacts.HasIntegerRange()
        && flagFacts.IntegerRangeLower() == 0
        && flagFacts.IntegerRangeUpperExclusive() == 2
        && mergedFacts.HasIntegerRange()
        && mergedFacts.IntegerRangeLower() == 3
        && mergedFacts.IntegerRangeUpperExclusive() == 6;
}

[Fact]
fn bool BuildMirValueRangeFactsPreservesCompactIntegerWidths()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId i8Min = MirConstIntTyped(instrs, MirType.I8, -128);
    stack MirValueId i8One = MirConstIntTyped(instrs, MirType.I8, 1);
    stack MirValueId i8Wrapped = MirWrappingSubTyped(instrs, MirType.I8, i8Min, i8One);
    stack MirValueId i16Min = MirConstIntTyped(instrs, MirType.I16, -32768);
    stack MirValueId i16One = MirConstIntTyped(instrs, MirType.I16, 1);
    stack MirValueId i16Saturated = MirSaturatingSubTyped(instrs, MirType.I16, i16Min, i16One);

    stack mut IrTable<ValueFacts> valueFacts = new();
    if (!RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i8Min)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i8One)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i8Wrapped)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i16Min)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i16One)
        || !RecomputeMirGeneratedValueFactsForMirValue(instrs, valueFacts, i16Saturated))
    {
        return false;
    }

    stack ValueFacts i8MinFacts = ValueFactsForMirValue(valueFacts, i8Min);
    stack ValueFacts i8WrappedFacts = ValueFactsForMirValue(valueFacts, i8Wrapped);
    stack ValueFacts i16MinFacts = ValueFactsForMirValue(valueFacts, i16Min);
    stack ValueFacts i16SaturatedFacts = ValueFactsForMirValue(valueFacts, i16Saturated);
    return MirValueType(instrs, i8Min.Index()) == MirType.I8
        && MirValueType(instrs, i16Min.Index()) == MirType.I16
        && i8MinFacts.HasIntegerRange()
        && i8MinFacts.IntegerRangeLower() == -128
        && i8MinFacts.IntegerRangeUpperExclusive() == -127
        && i8WrappedFacts.HasIntegerRange()
        && i8WrappedFacts.IntegerRangeLower() == 127
        && i8WrappedFacts.IntegerRangeUpperExclusive() == 128
        && i16MinFacts.HasIntegerRange()
        && i16MinFacts.IntegerRangeLower() == -32768
        && i16MinFacts.IntegerRangeUpperExclusive() == -32767
        && i16SaturatedFacts.HasIntegerRange()
        && i16SaturatedFacts.IntegerRangeLower() == -32768
        && i16SaturatedFacts.IntegerRangeUpperExclusive() == -32767;
}

[Fact]
fn bool BuildMirValueRangeFactsDerivesExactExtendedIntegerOps()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId twenty = MirConstIntTyped(instrs, MirType.I32, 20);
    stack MirValueId six = MirConstIntTyped(instrs, MirType.I32, 6);
    stack MirValueId sdiv = MirSDivTyped(instrs, MirType.I32, twenty, six);
    stack MirValueId udiv = MirUDivTyped(instrs, MirType.I32, twenty, six);
    stack MirValueId srem = MirSRemTyped(instrs, MirType.I32, twenty, six);
    stack MirValueId andValue = MirAndTyped(instrs, MirType.I32, twenty, six);
    stack MirValueId orValue = MirOrTyped(instrs, MirType.I32, twenty, six);
    stack MirValueId xorValue = MirXorTyped(instrs, MirType.I32, twenty, six);
    stack MirValueId shl = MirShlTyped(instrs, MirType.I32, twenty, six);
    stack MirValueId ashr = MirAShrTyped(instrs, MirType.I32, twenty, six);

    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts sdivFacts = ValueFactsForMirValue(valueFacts, sdiv);
    stack ValueFacts udivFacts = ValueFactsForMirValue(valueFacts, udiv);
    stack ValueFacts sremFacts = ValueFactsForMirValue(valueFacts, srem);
    stack ValueFacts andFacts = ValueFactsForMirValue(valueFacts, andValue);
    stack ValueFacts orFacts = ValueFactsForMirValue(valueFacts, orValue);
    stack ValueFacts xorFacts = ValueFactsForMirValue(valueFacts, xorValue);
    stack ValueFacts shlFacts = ValueFactsForMirValue(valueFacts, shl);
    stack ValueFacts ashrFacts = ValueFactsForMirValue(valueFacts, ashr);
    return valueFacts.Count() == instrs.Count()
        && sdivFacts.HasIntegerRange()
        && sdivFacts.IntegerRangeLower() == 3
        && sdivFacts.IntegerRangeUpperExclusive() == 4
        && udivFacts.HasIntegerRange()
        && udivFacts.IntegerRangeLower() == 3
        && udivFacts.IntegerRangeUpperExclusive() == 4
        && sremFacts.HasIntegerRange()
        && sremFacts.IntegerRangeLower() == 2
        && sremFacts.IntegerRangeUpperExclusive() == 3
        && andFacts.HasIntegerRange()
        && andFacts.IntegerRangeLower() == 4
        && andFacts.IntegerRangeUpperExclusive() == 5
        && orFacts.HasIntegerRange()
        && orFacts.IntegerRangeLower() == 22
        && orFacts.IntegerRangeUpperExclusive() == 23
        && xorFacts.HasIntegerRange()
        && xorFacts.IntegerRangeLower() == 18
        && xorFacts.IntegerRangeUpperExclusive() == 19
        && shlFacts.HasIntegerRange()
        && shlFacts.IntegerRangeLower() == 1280
        && shlFacts.IntegerRangeUpperExclusive() == 1281
        && ashrFacts.HasIntegerRange()
        && ashrFacts.IntegerRangeLower() == 0
        && ashrFacts.IntegerRangeUpperExclusive() == 1;
}

[Fact]
fn bool ValueFactTransferPolicyHelpersRecordEmptyRows()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 1);
    stack MirValueId b = MirConstInt(instrs, 2);
    stack MirValueId sum = MirAdd(instrs, a, b);
    stack MirValueId ret = MirReturn(instrs, sum);
    stack mut IrTable<ValueFacts> facts = new();

    if (!RecordEmptyValueFactsForMirValue(facts, a))
    {
        return false;
    }

    if (!RecomputeValueFactsForMirValue(facts, b))
    {
        return false;
    }

    if (!ConsumeValueFactsForMirValue(facts, sum))
    {
        return false;
    }

    if (!DropDebugOnlyValueFactsForMirValue(facts, ret))
    {
        return false;
    }

    return facts.Count() == 4
        && !ValueFactsForMirValue(facts, a).HasIntegerRange()
        && !ValueFactsForMirValue(facts, b).HasIntegerRange()
        && !ValueFactsForMirValue(facts, sum).HasIntegerRange()
        && !ValueFactsForMirValue(facts, ret).HasIntegerRange();
}

[Fact]
fn bool ValueFactTransferRejectsInvalidAndDuplicateHandles()
{
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts first = new();
    first.SetAlignment(4);
    stack mut ValueFacts second = new();
    second.SetAlignment(8);

    stack bool firstRecord = RecordGeneratedValueFactsForMirValue(facts, MirValueIdOf(1), first);
    stack bool duplicateRecord = RecordGeneratedValueFactsForMirValue(facts, MirValueIdOf(1), second);
    stack bool invalidRecord = RecordGeneratedValueFactsForMirValue(facts, MirValueIdOf(0), second);
    stack ValueFacts read = ValueFactsForMirValue(facts, MirValueIdOf(1));
    return firstRecord
        && !duplicateRecord
        && !invalidRecord
        && facts.Count() == 1
        && read.AlignmentBytes() == 4;
}

[Fact]
fn bool ValueFactTransferTranslateUsesProvidedFacts()
{
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts translated = new();
    translated.SetCallingAbi(AbiKind.CAbi);
    translated.MarkNoAlias();

    if (!TranslateValueFactsForMirValue(facts, MirValueIdOf(1), translated))
    {
        return false;
    }

    stack ValueFacts read = ValueFactsForMirValue(facts, MirValueIdOf(1));
    return read.HasCallingAbi()
        && read.CallingAbi() == AbiKind.CAbi
        && read.HasNoAlias();
}

[Fact]
fn bool IrFactCategoryIndexCoversConcreteDescriptors()
{
    stack u32[0 max] count = IrConcreteFactCategoryCount();
    if (count != 17 || IrFactCategoryAt(count) != IrFactCategory.Unknown)
    {
        return false;
    }

    for willexit (stack mut u32[0 max] index = 0; index < count; index += 1)
    {
        stack IrFactCategory category = IrFactCategoryAt(index);
        stack IrFactCategoryDescriptor descriptor = DescribeIrFactCategory(category);
        if (!IrFactCategoryIsConcrete(category)
            || descriptor.Category() != category
            || descriptor.AttachPoint() == IrFactAttachPoint.Unknown
            || descriptor.PhaseOwner() == IrFactPhaseOwner.Unknown
            || descriptor.Durability() == IrFactDurability.Unknown
            || descriptor.Producer() == IrFactProducer.Unknown
            || descriptor.Consumer() == IrFactConsumer.Unknown
            || descriptor.ValidationRule() == IrFactValidationRule.Unknown
            || descriptor.LoweringPolicy() == IrFactLoweringPolicy.Unknown)
        {
            return false;
        }
    }

    return true;
}

[Fact]
fn bool IrFactValueDescriptorsMatchCurrentValueFacts()
{
    stack IrFactCategoryDescriptor align = DescribeIrFactCategory(IrFactCategory.ValueAlignment);
    stack IrFactCategoryDescriptor range = DescribeIrFactCategory(IrFactCategory.ValueIntegerRange);
    stack IrFactCategoryDescriptor nullability = DescribeIrFactCategory(IrFactCategory.ValueNullability);
    stack IrFactCategoryDescriptor volatileFact = DescribeIrFactCategory(IrFactCategory.ValueVolatile);
    return align.AttachPoint() == IrFactAttachPoint.Value
        && align.PhaseOwner() == IrFactPhaseOwner.Mir
        && align.LoweringPolicy() == IrFactLoweringPolicy.Preserve
        && range.AttachPoint() == IrFactAttachPoint.Value
        && range.Durability() == IrFactDurability.Recomputable
        && range.ValidationRule() == IrFactValidationRule.Recompute
        && nullability.AttachPoint() == IrFactAttachPoint.Value
        && nullability.Durability() == IrFactDurability.Recomputable
        && nullability.LoweringPolicy() == IrFactLoweringPolicy.Preserve
        && volatileFact.Consumer() == IrFactConsumer.LlvmEmission
        && volatileFact.LoweringPolicy() == IrFactLoweringPolicy.ForbidDrop;
}

[Fact]
fn bool IrFactEnumLayoutDescriptorPreservesPackageBoundaryContract()
{
    stack IrFactCategoryDescriptor enumLayout = DescribeIrFactCategory(IrFactCategory.EnumLayout);
    return enumLayout.AttachPoint() == IrFactAttachPoint.Type
        && enumLayout.PhaseOwner() == IrFactPhaseOwner.Backend
        && enumLayout.Durability() == IrFactDurability.Durable
        && enumLayout.Producer() == IrFactProducer.TypeChecker
        && enumLayout.Consumer() == IrFactConsumer.PackageWriter
        && enumLayout.ValidationRule() == IrFactValidationRule.PackageRoundTrip
        && enumLayout.LoweringPolicy() == IrFactLoweringPolicy.ForbidDrop
        && IrFactCategoryIsLayoutFact(IrFactCategory.EnumLayout)
        && IrFactCategoryRequiresPackageSerialization(IrFactCategory.EnumLayout);
}

fn u32[0 max] MirEnumLayoutFactVariantIndexByName(
    borrow IrTable<MirEnumLayoutFact> facts,
    ascii source,
    borrow TokenStream stream,
    ascii variantName)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        if (found == 0 && fact.RowKind() == MirEnumLayoutFactRowKind.Variant)
        {
            stack ascii actual = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fact.VariantNameToken());
            if (System.Text.Equals(actual, variantName))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

fn u32[0 max] MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(
    borrow IrTable<MirEnumLayoutFact> facts,
    ascii source,
    borrow TokenStream stream,
    ascii variantName,
    u32[0 max] payloadOrdinal)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        if (found == 0
            && fact.RowKind() == MirEnumLayoutFactRowKind.Payload
            && fact.PayloadOrdinal() == payloadOrdinal)
        {
            stack ascii actual = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fact.VariantNameToken());
            if (System.Text.Equals(actual, variantName))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

[Fact]
fn bool MirEnumLayoutFactsPreserveTypedRows()
{
    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> facts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, facts))
    {
        return false;
    }

    stack u32[0 max] dataVariantSlot = MirEnumLayoutFactVariantIndexByName(facts, source, stream, "Data");
    stack u32[0 max] emptyVariantSlot = MirEnumLayoutFactVariantIndexByName(facts, source, stream, "Empty");
    stack u32[0 max] otherVariantSlot = MirEnumLayoutFactVariantIndexByName(facts, source, stream, "Other");
    stack u32[0 max] dataPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(facts, source, stream, "Data", 0);
    stack u32[0 max] otherPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(facts, source, stream, "Other", 0);
    if (dataVariantSlot == 0 || emptyVariantSlot == 0 || otherVariantSlot == 0 || dataPayloadSlot == 0 || otherPayloadSlot == 0)
    {
        return false;
    }

    stack MirEnumLayoutFact dataVariant = facts.Get(dataVariantSlot);
    stack MirEnumLayoutFact emptyVariant = facts.Get(emptyVariantSlot);
    stack MirEnumLayoutFact otherVariant = facts.Get(otherVariantSlot);
    stack MirEnumLayoutFact dataPayload = facts.Get(dataPayloadSlot);
    stack MirEnumLayoutFact otherPayload = facts.Get(otherPayloadSlot);
    stack TypeId dataOwner = dataVariant.OwnerType();
    stack TypeId otherPayloadOwner = otherPayload.OwnerType();
    stack ascii ownerName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])dataVariant.OwnerNameToken());

    return facts.Count() == 5
        && dataOwner.Index() == 1
        && otherPayloadOwner.Equals(dataOwner)
        && System.Text.Equals(ownerName, "Packet")
        && dataVariant.RowKind() == MirEnumLayoutFactRowKind.Variant
        && dataVariant.VariantTag() == 1
        && dataVariant.PayloadCount() == 1
        && dataVariant.SizeBytes() == 1
        && dataVariant.AlignmentBytes() == 1
        && dataVariant.BitWidth() == 8
        && dataVariant.HasConcreteLayout()
        && emptyVariant.VariantTag() == 0
        && emptyVariant.PayloadCount() == 0
        && otherVariant.VariantTag() == 2
        && dataPayload.RowKind() == MirEnumLayoutFactRowKind.Payload
        && dataPayload.StorageFieldOrdinal() == 1
        && dataPayload.OffsetBytes() == 1
        && dataPayload.SizeBytes() == 1
        && dataPayload.AlignmentBytes() == 1
        && dataPayload.HasConcreteLayout()
        && otherPayload.RowKind() == MirEnumLayoutFactRowKind.Payload
        && otherPayload.StorageFieldOrdinal() == 2
        && otherPayload.OffsetBytes() == 4
        && otherPayload.SizeBytes() == 4
        && otherPayload.AlignmentBytes() == 4
        && otherPayload.HasConcreteLayout();
}

[Fact]
fn bool MirEnumLayoutFactsBuildAbiSummaryAndCarrier()
{
    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> facts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, facts))
    {
        return false;
    }

    stack mut MirEnumAbiLayoutFacts layout = new();
    if (!TryBuildMirEnumAbiLayoutFacts(facts, TypeIdOf(1), layout))
    {
        return false;
    }

    stack mut CAbiAggregateCarrierFacts carrier = new();
    if (!TryBuildMirEnumCAbiCarrierFacts(facts, TypeIdOf(1), carrier))
    {
        return false;
    }

    stack ascii ownerName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])layout.OwnerNameToken());
    stack TypeId layoutOwner = layout.OwnerType();
    return layout.Present()
        && layoutOwner.Index() == 1
        && System.Text.Equals(ownerName, "Packet")
        && layout.VariantCount() == 3
        && layout.PayloadFieldCount() == 2
        && layout.TagOffsetBytes() == 0
        && layout.TagSizeBytes() == 1
        && layout.TagAlignmentBytes() == 1
        && !layout.TagIsMisaligned()
        && layout.SizeBytes() == 8
        && layout.AlignmentBytes() == 4
        && layout.HasConcreteLayout()
        && !layout.HasMisalignedStorage()
        && !MirEnumAbiRequiresIndirectParameter(layout)
        && !MirEnumAbiRequiresIndirectReturn(layout)
        && carrier.Present()
        && carrier.IsDirect()
        && !carrier.IsIndirect()
        && carrier.ByteSize() == 8
        && carrier.ByteAlignment() == 4
        && carrier.LlvmParameterCarrierCount() == 1
        && carrier.CarrierKindAt(0) == AbiCarrierKind.I64
        && carrier.CarrierKindAt(1) == AbiCarrierKind.None;
}

[Fact]
fn bool MirEnumLayoutFactsEmitLlvmStorageTypeFromRows()
{
    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> facts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, facts))
    {
        return false;
    }

    stack mut OwnedAscii llvmType = new();
    switch (EmitLlvmEnumStorageType(facts, TypeIdOf(1), llvmType))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
    }

    return LlvmTextEquals(llvmType, "{ i8, i8, [2 x i8], i32 }");
}

[Fact]
fn bool MirEnumLayoutFactsComputeLlvmFieldIndicesFromRows()
{
    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> facts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, facts))
    {
        return false;
    }

    stack u32[0 max] dataVariantSlot = MirEnumLayoutFactVariantIndexByName(facts, source, stream, "Data");
    stack u32[0 max] dataPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(facts, source, stream, "Data", 0);
    stack u32[0 max] otherPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(facts, source, stream, "Other", 0);
    if (dataVariantSlot == 0 || dataPayloadSlot == 0 || otherPayloadSlot == 0)
    {
        return false;
    }

    stack MirEnumLayoutFact dataVariant = facts.Get(dataVariantSlot);
    stack MirEnumLayoutFact dataPayload = facts.Get(dataPayloadSlot);
    stack MirEnumLayoutFact otherPayload = facts.Get(otherPayloadSlot);
    stack mut u32[0 max] tagIndex = 99;
    stack mut u32[0 max] dataIndex = 99;
    stack mut u32[0 max] otherIndex = 99;

    return TryGetLlvmEnumFactFieldIndex(facts, TypeIdOf(1), dataVariant, tagIndex)
        && TryGetLlvmEnumFactFieldIndex(facts, TypeIdOf(1), dataPayload, dataIndex)
        && TryGetLlvmEnumFactFieldIndex(facts, TypeIdOf(1), otherPayload, otherIndex)
        && tagIndex == 0
        && dataIndex == 1
        && otherIndex == 3;
}

[Fact]
fn bool MirEnumLayoutFactsEmitLlvmValueOpsFromRows()
{
    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> facts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, facts))
    {
        return false;
    }

    stack u32[0 max] otherVariantSlot = MirEnumLayoutFactVariantIndexByName(facts, source, stream, "Other");
    stack u32[0 max] otherPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(facts, source, stream, "Other", 0);
    if (otherVariantSlot == 0 || otherPayloadSlot == 0)
    {
        return false;
    }

    stack MirEnumLayoutFact otherVariant = facts.Get(otherVariantSlot);
    stack MirEnumLayoutFact otherPayload = facts.Get(otherPayloadSlot);
    stack mut OwnedAscii llvm = new();
    switch (EmitLlvmEnumVariantTagConstructor(facts, TypeIdOf(1), otherVariant.VariantOrdinal(), "%packet.tagged", llvm))
    {
        case MemoryStatus.Err(var tagError):
            return false;
        case MemoryStatus.Ok:
    }

    switch (EmitLlvmEnumPayloadInsert(facts, TypeIdOf(1), otherPayload.VariantOrdinal(), otherPayload.PayloadOrdinal(), "%packet.value", "%packet.tagged", "%payload", llvm))
    {
        case MemoryStatus.Err(var payloadError):
            return false;
        case MemoryStatus.Ok:
    }

    switch (EmitLlvmEnumValueStore(facts, TypeIdOf(1), "%packet.value", "%slot", llvm))
    {
        case MemoryStatus.Err(var storeError):
            return false;
        case MemoryStatus.Ok:
    }

    switch (EmitLlvmEnumValueLoad(facts, TypeIdOf(1), "%loaded", "%slot", llvm))
    {
        case MemoryStatus.Err(var loadError):
            return false;
        case MemoryStatus.Ok:
    }

    switch (EmitLlvmEnumTagRead(facts, TypeIdOf(1), "%tag", "%loaded", llvm))
    {
        case MemoryStatus.Err(var tagReadError):
            return false;
        case MemoryStatus.Ok:
    }

    return LlvmTextEquals(
        llvm,
        "  %packet.tagged = insertvalue { i8, i8, [2 x i8], i32 } zeroinitializer, i8 2, 0\n  %packet.value = insertvalue { i8, i8, [2 x i8], i32 } %packet.tagged, i32 %payload, 3\n  store { i8, i8, [2 x i8], i32 } %packet.value, ptr %slot, align 4\n  %loaded = load { i8, i8, [2 x i8], i32 }, ptr %slot, align 4\n  %tag = extractvalue { i8, i8, [2 x i8], i32 } %loaded, 0\n");
}

[Fact]
fn bool IrFactDurableDescriptorsRequirePackageSerialization()
{
    stack mut u32[0 max] durable = 0;
    stack u32[0 max] count = IrConcreteFactCategoryCount();
    for willexit (stack mut u32[0 max] index = 0; index < count; index += 1)
    {
        if (IrFactCategoryRequiresPackageSerialization(IrFactCategoryAt(index)))
        {
            durable = (u32[0 max])(durable + 1);
        }
    }

    return durable == 8
        && IrFactCategoryRequiresPackageSerialization(IrFactCategory.CallableAbi)
        && IrFactCategoryRequiresPackageSerialization(IrFactCategory.EnumLayout)
        && IrFactCategoryRequiresPackageSerialization(IrFactCategory.PackageCompatibility)
        && !IrFactCategoryRequiresPackageSerialization(IrFactCategory.ValueIntegerRange)
        && !IrFactCategoryRequiresPackageSerialization(IrFactCategory.DiagnosticSourceLocation);
}

[Fact]
fn bool IrFactAliasAndDropDescriptorsForbidSilentLoss()
{
    stack IrFactCategoryDescriptor noAlias = DescribeIrFactCategory(IrFactCategory.ValueNoAlias);
    stack IrFactCategoryDescriptor proof = DescribeIrFactCategory(IrFactCategory.AliasProofCarrier);
    stack IrFactCategoryDescriptor dropFact = DescribeIrFactCategory(IrFactCategory.OwnershipDrop);
    return noAlias.ValidationRule() == IrFactValidationRule.AliasProofRoot
        && noAlias.LoweringPolicy() == IrFactLoweringPolicy.ForbidDrop
        && proof.AttachPoint() == IrFactAttachPoint.AliasProof
        && proof.LoweringPolicy() == IrFactLoweringPolicy.Consume
        && dropFact.Consumer() == IrFactConsumer.DropLowering
        && dropFact.ValidationRule() == IrFactValidationRule.ForbidDrop
        && dropFact.LoweringPolicy() == IrFactLoweringPolicy.ForbidDrop;
}

[Fact]
fn bool IrFactValidationRejectsStaleTypedHandles()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId value = MirConstInt(instrs, 7);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId block = MirReturnBlock(blocks, value);
    stack mut IrTable<TypeId> types = new();
    stack u32[0 max] addedType = types.Add(TypeIdOf(1));

    return ValidateMirValueHandle(instrs, value) == IrFactValidationStatus.Ok
        && ValidateMirValueHandle(instrs, MirValueIdOf(0)) == IrFactValidationStatus.StaleHandle
        && ValidateMirValueHandle(instrs, MirValueIdOf(2)) == IrFactValidationStatus.StaleHandle
        && ValidateMirBlockHandle(blocks, block) == IrFactValidationStatus.Ok
        && ValidateMirBlockHandle(blocks, MirBlockIdOf(2)) == IrFactValidationStatus.StaleHandle
        && addedType == 1
        && ValidateTypeHandle(types, TypeIdOf(1)) == IrFactValidationStatus.Ok
        && ValidateTypeHandle(types, TypeIdOf(2)) == IrFactValidationStatus.StaleHandle;
}

[Fact]
fn bool IrFactValidationClassifiesMissingFactFamilies()
{
    return MissingFactStatusForCategory(IrFactCategory.Unknown) == IrFactValidationStatus.UnknownCategory
        && MissingFactStatusForCategory(IrFactCategory.ValueVolatile) == IrFactValidationStatus.DroppedForbidDropFact
        && MissingFactStatusForCategory(IrFactCategory.OwnershipDrop) == IrFactValidationStatus.DroppedForbidDropFact
        && MissingFactStatusForCategory(IrFactCategory.CallableAbi) == IrFactValidationStatus.MissingAbiFact
        && MissingFactStatusForCategory(IrFactCategory.CAbiAggregateCarrier) == IrFactValidationStatus.MissingAbiFact
        && MissingFactStatusForCategory(IrFactCategory.ValueNoAlias) == IrFactValidationStatus.MissingAliasFact
        && MissingFactStatusForCategory(IrFactCategory.AliasProofCarrier) == IrFactValidationStatus.MissingAliasFact
        && MissingFactStatusForCategory(IrFactCategory.TypeLayout) == IrFactValidationStatus.MissingLayoutFact
        && MissingFactStatusForCategory(IrFactCategory.FieldLayout) == IrFactValidationStatus.MissingLayoutFact
        && MissingFactStatusForCategory(IrFactCategory.EnumLayout) == IrFactValidationStatus.MissingLayoutFact
        && MissingFactStatusForCategory(IrFactCategory.PackageCompatibility) == IrFactValidationStatus.MissingDurablePackageFact;
}

[Fact]
fn bool IrFactValidationChecksMirValueFactsAtBoundary()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId source = MirConstInt(instrs, 1);
    stack MirValueId missing = MirConstInt(instrs, 2);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut ValueFacts facts = new();
    facts.SetAlignment(8);
    facts.MarkNoAlias();
    facts.MarkVolatile();
    facts.SetIntegerRange(1, 2);
    facts.MarkKnownNonNull();

    if (!RecordGeneratedValueFactsForMirValue(valueFacts, source, facts))
    {
        return false;
    }

    return ValidateMirValueFactAtBoundary(instrs, valueFacts, source, IrFactCategory.ValueAlignment) == IrFactValidationStatus.Ok
        && ValidateMirValueFactAtBoundary(instrs, valueFacts, source, IrFactCategory.ValueNoAlias) == IrFactValidationStatus.Ok
        && ValidateMirValueFactAtBoundary(instrs, valueFacts, source, IrFactCategory.ValueVolatile) == IrFactValidationStatus.Ok
        && ValidateMirValueFactAtBoundary(instrs, valueFacts, source, IrFactCategory.ValueIntegerRange) == IrFactValidationStatus.Ok
        && ValidateMirValueFactAtBoundary(instrs, valueFacts, source, IrFactCategory.ValueNullability) == IrFactValidationStatus.Ok
        && ValidateMirValueFactAtBoundary(instrs, valueFacts, missing, IrFactCategory.ValueNoAlias) == IrFactValidationStatus.MissingAliasFact
        && ValidateMirValueFactAtBoundary(instrs, valueFacts, missing, IrFactCategory.ValueNullability) == IrFactValidationStatus.MissingRequiredFact
        && ValidateMirValueFactAtBoundary(instrs, valueFacts, MirValueIdOf(3), IrFactCategory.ValueNoAlias) == IrFactValidationStatus.StaleHandle;
}

[Fact]
fn bool IrFactValidationChecksCallableAbiFacts()
{
    stack mut IrTable<MirFunction> functions = new();
    stack MirFuncId firstFunction = MirDefineFunction(functions, MirBlockIdOf(1), MirBlockIdOf(1), 1, MirValueIdOf(1), 1);
    stack MirFuncId secondFunction = MirDefineFunction(functions, MirBlockIdOf(2), MirBlockIdOf(2), 1, MirValueIdOf(2), 1);

    stack mut IrTable<ValueFacts> callableFacts = new();
    stack mut ValueFacts empty = new();
    stack u32[0 max] addedEmpty = callableFacts.Add(empty);
    stack mut ValueFacts abi = new();
    abi.SetCallingAbi(AbiKind.CAbi);
    stack u32[0 max] addedAbi = callableFacts.Add(abi);

    return firstFunction.Index() == 1
        && secondFunction.Index() == 2
        && addedEmpty == 1
        && addedAbi == 2
        && ValidateCallableAbiFactAtBoundary(functions, callableFacts, firstFunction) == IrFactValidationStatus.MissingAbiFact
        && ValidateCallableAbiFactAtBoundary(functions, callableFacts, secondFunction) == IrFactValidationStatus.Ok
        && ValidateCallableAbiFactAtBoundary(functions, callableFacts, MirFuncIdOf(3)) == IrFactValidationStatus.StaleHandle;
}

[Fact]
fn bool IrFactValidationChecksCAbiCarrierAndLayoutFacts()
{
    stack mut IrTable<TypeId> types = new();
    stack u32[0 max] addedType1 = types.Add(TypeIdOf(1));
    stack u32[0 max] addedType2 = types.Add(TypeIdOf(2));

    stack mut IrTable<CAbiAggregateCarrierFacts> carrierFacts = new();
    stack mut CAbiAggregateCarrierFacts emptyCarrier = new();
    stack u32[0 max] addedEmptyCarrier = carrierFacts.Add(emptyCarrier);
    stack mut CAbiAggregateCarrierFacts directCarrier = new();
    directCarrier.SetDirect(16, 8, 1, AbiCarrierKind.I64, AbiCarrierKind.None, AbiCarrierKind.None, AbiCarrierKind.None);
    stack u32[0 max] addedDirectCarrier = carrierFacts.Add(directCarrier);

    stack mut IrTable<u32[0 max]> layoutFacts = new();
    stack u32[0 max] addedLayout1 = layoutFacts.Add(16);
    stack u32[0 max] addedLayout2 = layoutFacts.Add(32);

    return addedType1 == 1
        && addedType2 == 2
        && addedEmptyCarrier == 1
        && addedDirectCarrier == 2
        && addedLayout1 == 1
        && addedLayout2 == 2
        && ValidateCAbiAggregateCarrierFactAtBoundary(types, carrierFacts, TypeIdOf(1)) == IrFactValidationStatus.MissingAbiFact
        && ValidateCAbiAggregateCarrierFactAtBoundary(types, carrierFacts, TypeIdOf(2)) == IrFactValidationStatus.Ok
        && ValidateCAbiAggregateCarrierFactAtBoundary(types, carrierFacts, TypeIdOf(3)) == IrFactValidationStatus.StaleHandle
        && ValidateLayoutFactAtBoundary(types, layoutFacts, TypeIdOf(1), IrFactCategory.TypeLayout) == IrFactValidationStatus.Ok
        && ValidateLayoutFactAtBoundary(types, layoutFacts, TypeIdOf(2), IrFactCategory.StructLayout) == IrFactValidationStatus.Ok
        && ValidateLayoutFactAtBoundary(types, layoutFacts, TypeIdOf(2), IrFactCategory.EnumLayout) == IrFactValidationStatus.Ok
        && ValidateLayoutFactAtBoundary(types, layoutFacts, TypeIdOf(3), IrFactCategory.TypeLayout) == IrFactValidationStatus.StaleHandle;
}

[Fact]
fn bool IrFactValidationChecksDurablePackageFacts()
{
    return ValidateDurablePackageFactAtBoundary(IrFactCategory.FunctionEffect, true) == IrFactValidationStatus.Ok
        && ValidateDurablePackageFactAtBoundary(IrFactCategory.FunctionEffect, false) == IrFactValidationStatus.MissingDurablePackageFact
        && ValidateDurablePackageFactAtBoundary(IrFactCategory.PackageCompatibility, false) == IrFactValidationStatus.MissingDurablePackageFact
        && ValidateDurablePackageFactAtBoundary(IrFactCategory.ValueNoAlias, false) == IrFactValidationStatus.Ok
        && IrFactValidationStatusName(IrFactValidationStatus.MissingDurablePackageFact) == "missing-durable-package-fact";
}

[Fact]
fn bool MirEmitsSequentialValueIds()
{
    // Each emitted instruction gets the next 1-based value id over the instruction
    // table; the table tracks the count and which values are defined.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 10);
    stack MirValueId b = MirConstInt(instrs, 20);
    stack MirValueId sum = MirAdd(instrs, a, b);
    return a.Index() == 1
        && b.Index() == 2
        && sum.Index() == 3
        && instrs.Count() == 3
        && MirDefines(instrs, sum)
        && !MirDefines(instrs, MirValueIdOf(4));
}

[Fact]
fn bool MirConstInstructionCarriesImmediate()
{
    // A `ConstInt` reads back its opcode and immediate.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId c = MirConstInt(instrs, 42);
    return MirOpcodeOf(instrs, c) == MirOp.ConstInt && MirImmediateOf(instrs, c) == 42;
}

[Fact]
fn bool MirBinaryInstructionReferencesOperandsByHandle()
{
    // A `Mul` records its opcode and its two operand value ids.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 3);
    stack MirValueId b = MirConstInt(instrs, 4);
    stack MirValueId prod = MirMul(instrs, a, b);
    stack MirValueId opA = MirOperandAOf(instrs, prod);
    stack MirValueId opB = MirOperandBOf(instrs, prod);
    return MirOpcodeOf(instrs, prod) == MirOp.Mul
        && opA.Equals(a)
        && opB.Equals(b);
}

[Fact]
fn bool MirReturnInstructionRecordsReturnedValue()
{
    // A `Return` records the returned value as operand A.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId v = MirConstInt(instrs, 7);
    stack MirValueId ret = MirReturn(instrs, v);
    stack MirValueId retOperand = MirOperandAOf(instrs, ret);
    return MirOpcodeOf(instrs, ret) == MirOp.Return
        && retOperand.Equals(v);
}

[Fact]
fn bool MirReturnBlockRecordsReturnedValue()
{
    // A block terminating in `return v` reads back its terminator kind and value.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 99);
    stack MirBlockId b = MirReturnBlock(blocks, v);
    stack MirValueId got = MirBlockReturnValue(blocks, b);
    return b.Index() == 1
        && MirBlockTerminator(blocks, b) == MirTermKind.Return
        && got.Equals(v);
}

[Fact]
fn bool MirReturnVoidBlockRecordsEmptyTerminator()
{
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId b = MirReturnVoidBlock(blocks);
    stack MirValueId got = MirBlockReturnValue(blocks, b);
    return b.Index() == 1
        && MirBlockTerminator(blocks, b) == MirTermKind.ReturnVoid
        && !got.IsValid();
}

[Fact]
fn bool MirBranchBlockRecordsTarget()
{
    // An unconditional branch records its target block id.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 1);
    stack MirBlockId dest = MirReturnBlock(blocks, v);
    stack MirBlockId br = MirBranchBlock(blocks, dest);
    stack MirBlockId got = MirBlockBranchTarget(blocks, br);
    return MirBlockTerminator(blocks, br) == MirTermKind.Branch
        && got.Equals(dest);
}

[Fact]
fn bool MirCondBlockRecordsConditionAndTargets()
{
    // A conditional branch records its condition value and both target blocks.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId cond = MirConstInt(instrs, 1);
    stack MirValueId tv = MirConstInt(instrs, 10);
    stack MirValueId ev = MirConstInt(instrs, 20);
    stack MirBlockId thenB = MirReturnBlock(blocks, tv);
    stack MirBlockId elseB = MirReturnBlock(blocks, ev);
    stack MirBlockId br = MirCondBlock(blocks, cond, thenB, elseB);
    stack MirValueId gotCond = MirBlockCondValue(blocks, br);
    stack MirBlockId gotThen = MirBlockCondThen(blocks, br);
    stack MirBlockId gotElse = MirBlockCondElse(blocks, br);
    return MirBlockTerminator(blocks, br) == MirTermKind.CondBranch
        && gotCond.Equals(cond)
        && gotThen.Equals(thenB)
        && gotElse.Equals(elseB);
}

[Fact]
fn bool MirTailCallBlockRecordsPayload()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId tail = MirTailCall1(instrs, MirFuncIdOf(3), p0);
    stack MirBlockId b = MirTailCallBlock(blocks, tail);
    stack MirValueId got = MirBlockTailCallValue(blocks, b);
    return MirOpcodeOf(instrs, tail) == MirOp.TailCall
        && MirCalleeOf(instrs, tail).Index() == 3
        && MirOperandAOf(instrs, tail).Equals(p0)
        && MirBlockTerminator(blocks, b) == MirTermKind.TailCall
        && got.Equals(tail);
}

[Fact]
fn bool MirBlockTerminatorIsUnterminatedOutOfRange()
{
    // Querying a block id that was never created reads as unterminated.
    stack mut IrTable<MirBlock> blocks = new();
    return MirBlockTerminator(blocks, MirBlockIdOf(7)) == MirTermKind.Unterminated;
}

[Fact]
fn bool MirFunctionRecordsEntryAndRanges()
{
    // A function owns the blocks/instructions emitted for it and names its entry.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    // Body: %1 = const 2; %2 = const 3; %3 = add %1 %2.
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId sum = MirAdd(instrs, a, b);
    // One block returning the sum.
    stack MirBlockId entry = MirReturnBlock(blocks, sum);
    stack MirFuncId f = MirDefineFunction(funcs, entry, entry, 1, a, 3);
    stack MirBlockId gotEntry = MirFunctionEntry(funcs, f);
    return f.Index() == 1
        && gotEntry.Equals(entry)
        && MirFunctionBlockCount(funcs, f) == 1
        && MirFunctionInstrCount(funcs, f) == 3;
}

[Fact]
fn bool MirFunctionOwnershipTracksRanges()
{
    // Ownership queries respect each function's half-open block/instruction ranges.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    // Function 1: instrs %1..%2, block #1.
    stack MirValueId a = MirConstInt(instrs, 1);
    stack MirValueId b = MirConstInt(instrs, 2);
    stack MirBlockId blk1 = MirReturnBlock(blocks, b);
    stack MirFuncId funcA = MirDefineFunction(funcs, blk1, blk1, 1, a, 2);
    // Function 2: instr %3, block #2.
    stack MirValueId c = MirConstInt(instrs, 3);
    stack MirBlockId blk2 = MirReturnBlock(blocks, c);
    stack MirFuncId funcB = MirDefineFunction(funcs, blk2, blk2, 1, c, 1);
    return MirFunctionOwnsBlock(funcs, funcA, blk1)
        && !MirFunctionOwnsBlock(funcs, funcA, blk2)
        && MirFunctionOwnsValue(funcs, funcA, a)
        && !MirFunctionOwnsValue(funcs, funcA, c)
        && MirFunctionOwnsBlock(funcs, funcB, blk2)
        && MirFunctionOwnsValue(funcs, funcB, c);
}

[Fact]
fn bool MirFunctionQueriesRejectOutOfRange()
{
    // An undefined function id yields an invalid entry and zero counts.
    stack mut IrTable<MirFunction> funcs = new();
    stack MirBlockId entry = MirFunctionEntry(funcs, MirFuncIdOf(3));
    return !entry.IsValid()
        && MirFunctionBlockCount(funcs, MirFuncIdOf(3)) == 0
        && MirFunctionInstrCount(funcs, MirFuncIdOf(3)) == 0;
}

// Builds an `OwnedAscii` from `expectedText` and compares it to `actual`.
fn bool LlvmTextEquals(borrow OwnedAscii actual, const ascii expectedText)
{
    stack mut OwnedAscii expected = new();
    switch (expected.AppendConstAscii(expectedText))
    {
        case MemoryStatus.Ok:
            return OwnedAscii.Equals(actual, expected);
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmForStraightLineFunction()
{
    // The integer MIR lowers to LLVM textual IR: each value is a `%vN` register,
    // ConstInt materializes via `add i64 0, imm`, and Return becomes `ret i64`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId sum = MirAdd(instrs, a, b);
    stack MirValueId unusedRet = MirReturn(instrs, sum);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmFunction(instrs, "add2", 1, 4, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @add2() {\nentry:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmForMixedArithmetic()
{
    // sub/mul opcodes lower to their LLVM mnemonics over `%vN` operands.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 10);
    stack MirValueId b = MirConstInt(instrs, 4);
    stack MirValueId diff = MirSub(instrs, a, b);
    stack MirValueId prod = MirMul(instrs, diff, b);
    stack MirValueId unusedRet = MirReturn(instrs, prod);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmFunction(instrs, "calc", 1, 5, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @calc() {\nentry:\n  %v1 = add i64 0, 10\n  %v2 = add i64 0, 4\n  %v3 = sub i64 %v1, %v2\n  %v4 = mul i64 %v3, %v2\n  ret i64 %v4\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmReturnTerminator()
{
    // A Return block lowers to `ret i64 %vN`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId a = MirConstInt(instrs, 1);
    stack MirValueId b = MirConstInt(instrs, 2);
    stack MirValueId sum = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, sum);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTerminator(instrs, blocks,blk, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "  ret i64 %v3\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmBranchTerminator()
{
    // An unconditional Branch block lowers to `br label %bN`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 5);
    stack MirBlockId dest = MirReturnBlock(blocks, v);
    stack MirBlockId br = MirBranchBlock(blocks, dest);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTerminator(instrs, blocks,br, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "  br label %b1\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCondBranchTerminator()
{
    // A CondBranch block lowers to `br i1 %vC, label %bT, label %bE`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId cond = MirConstInt(instrs, 1);
    stack MirValueId tv = MirConstInt(instrs, 10);
    stack MirValueId ev = MirConstInt(instrs, 20);
    stack MirBlockId thenB = MirReturnBlock(blocks, tv);
    stack MirBlockId elseB = MirReturnBlock(blocks, ev);
    stack MirBlockId br = MirCondBlock(blocks, cond, thenB, elseB);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTerminator(instrs, blocks,br, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "  br i1 %v1, label %b1, label %b2\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmReturnsParameterDirectly()
{
    // Regression: an identity function `fn id(x) { return x }` returns its parameter,
    // which must lower to `ret i64 %p0` — not an undefined `%vN` (a Param emits no
    // body line). The block terminator routes the value through the param-aware path.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirBlockId entry = MirReturnBlock(blocks, p0);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "id", 1, entry.Index(), 1, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @id(i64 %p0) {\nb1:\n  ret i64 %p0\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmVoidDefinitionWithParams()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId entry = MirReturnVoidBlock(blocks);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmVoidDefinitionWithParams(instrs, blocks, "noop", 0, entry.Index(), 1, 0, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define void @noop() {\nb1:\n  ret void\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCondBranchOnParameter()
{
    // Regression: a CondBranch whose condition is a parameter references `%pK`, not an
    // undefined `%vN`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId cond = MirParam(instrs, 0);
    stack MirValueId tv = MirConstInt(instrs, 1);
    stack MirValueId ev = MirConstInt(instrs, 2);
    stack MirBlockId thenB = MirReturnBlock(blocks, tv);
    stack MirBlockId elseB = MirReturnBlock(blocks, ev);
    stack MirBlockId br = MirCondBlock(blocks, cond, thenB, elseB);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTerminator(instrs, blocks, br, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "  br i1 %p0, label %b1, label %b2\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirDecodersGuardOnOpcode()
{
    // Regression: the shared immediate field is not misread across opcodes — a callee
    // id read as a param index yields 0, and a param index read as a callee is invalid.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId call = MirCall(instrs, MirFuncIdOf(7));
    stack MirValueId param = MirParam(instrs, 3);
    return MirParamIndexOf(instrs, call) == 0
        && !MirCalleeOf(instrs, param).IsValid()
        && MirParamIndexOf(instrs, param) == 3
        && MirCalleeOf(instrs, call).Equals(MirFuncIdOf(7));
}

[Fact]
fn bool MirFunctionDoesNotOwnInvalidId()
{
    // Regression: a function whose recorded range starts at the 0 sentinel never
    // reports the invalid id 0 as owned.
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, MirBlockIdOf(0), MirBlockIdOf(0), 1, MirValueIdOf(0), 1);
    return !MirFunctionOwnsBlock(funcs, f, MirBlockIdOf(0))
        && !MirFunctionOwnsValue(funcs, f, MirValueIdOf(0));
}

[Fact]
fn bool EmitsLlvmSingleBlockDefinition()
{
    // A whole function emits as `define i64 @name() { bN: <instrs> <terminator> }`,
    // the terminator coming from the entry block (not a MirReturn instruction).
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId sum = MirAdd(instrs, a, b);
    stack MirBlockId entry = MirReturnBlock(blocks, sum);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinition(instrs, blocks, "f", entry.Index(), 1, 3, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @f() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

// Emits two labelled blocks back to back into `sink`, each owning one instruction.
fn MemoryStatus EmitTwoBlockBody(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, u32[0 max] entryIndex, u32[0 max] secondIndex, mut borrow OwnedAscii sink)
{
    try EmitLlvmLabeledBlock(instrs, blocks, entryIndex, 1, 1, sink);
    try EmitLlvmLabeledBlock(instrs, blocks, secondIndex, 2, 1, sink);
    return MemoryStatus.Ok;
}

[Fact]
fn bool EmitsLlvmTwoBlockFunctionBody()
{
    // A two-block function: entry computes a value and branches; the second block
    // computes another value and returns. Each block emits its label, body, terminator.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v1 = MirConstInt(instrs, 7);
    stack MirValueId v2 = MirConstInt(instrs, 8);
    stack MirBlockId second = MirReturnBlock(blocks, v2);
    stack MirBlockId entry = MirBranchBlock(blocks, second);
    stack mut OwnedAscii sink = new();
    switch (EmitTwoBlockBody(instrs, blocks, entry.Index(), second.Index(), sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "b2:\n  %v1 = add i64 0, 7\n  br label %b1\nb1:\n  %v2 = add i64 0, 8\n  ret i64 %v2\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirCallRecordsCallee()
{
    // A Call instruction records its opcode and the callee function id.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId result = MirCall(instrs, MirFuncIdOf(5));
    stack MirFuncId callee = MirCalleeOf(instrs, result);
    return MirOpcodeOf(instrs, result) == MirOp.Call
        && callee.Equals(MirFuncIdOf(5));
}

[Fact]
fn bool MirParamRecordsIndex()
{
    // A Param instruction records its opcode and 0-based parameter index.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId p = MirParam(instrs, 3);
    return MirOpcodeOf(instrs, p) == MirOp.Param
        && MirParamIndexOf(instrs, p) == 3;
}

[Fact]
fn bool EmitsLlvmFunctionWithParams()
{
    // A function over its parameters declares them in the signature and references
    // them as `%pK` in the body; the Param instructions emit no body lines.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId p1 = MirParam(instrs, 1);
    stack MirValueId sum = MirAdd(instrs, p0, p1);
    stack MirBlockId entry = MirReturnBlock(blocks, sum);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "addp", 2, entry.Index(), 1, 3, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @addp(i64 %p0, i64 %p1) {\nb1:\n  %v3 = add i64 %p0, %p1\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCallInstruction()
{
    // A Call lowers to `%vN = call i64 @fK()`; its result feeds the return.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId result = MirCall(instrs, MirFuncIdOf(2));
    stack MirValueId unusedRet = MirReturn(instrs, result);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmFunction(instrs, "caller", 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @caller() {\nentry:\n  %v1 = call i64 @f2()\n  ret i64 %v1\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCallWithArguments()
{
    // A two-argument call lowers to `%vN = call i64 @fK(i64 %a, i64 %b)`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 4);
    stack MirValueId b = MirConstInt(instrs, 5);
    stack MirValueId result = MirCall2(instrs, MirFuncIdOf(3), a, b);
    stack MirValueId unusedRet = MirReturn(instrs, result);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmFunction(instrs, "caller", 1, 4, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @caller() {\nentry:\n  %v1 = add i64 0, 4\n  %v2 = add i64 0, 5\n  %v3 = call i64 @f3(i64 %v1, i64 %v2)\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCallForwardingAParameter()
{
    // A function that forwards its parameter as a call argument: the param lowers to
    // `%p0` in the argument position.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId result = MirCall1(instrs, MirFuncIdOf(1), p0);
    stack MirBlockId entry = MirReturnBlock(blocks, result);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "fwd", 1, entry.Index(), 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @fwd(i64 %p0) {\nb1:\n  %v2 = call i64 @f1(i64 %p0)\n  ret i64 %v2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmRangeAttributesForReturnAndParameters()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirBlockId entry = MirReturnBlock(blocks, p0);

    stack mut ValueFacts returnFacts = new();
    returnFacts.SetIntegerRange(0, 11);
    stack mut ValueFacts p0Facts = new();
    p0Facts.SetIntegerRange(1, 6);
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack u32[0 max] addedParamFact = paramFacts.Add(p0Facts);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFacts(instrs, blocks, "bounded", returnFacts, paramFacts, valueFacts, globalFacts, functionReturnFacts, 1, entry.Index(), 1, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define range(i64 0, 11) i64 @bounded(i64 range(i64 1, 6) %p0) {\nb1:\n  ret i64 %p0\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmRangeMetadataForCallResultsAndArguments()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId result = MirCall1(instrs, MirFuncIdOf(2), p0);
    stack MirBlockId entry = MirReturnBlock(blocks, result);

    stack mut ValueFacts emptyReturn = new();
    stack mut ValueFacts p0Facts = new();
    p0Facts.SetIntegerRange(0, 11);
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack u32[0 max] addedParamFact = paramFacts.Add(p0Facts);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts noFact = new();
    stack u32[0 max] addedFirstReturnFact = functionReturnFacts.Add(noFact);
    stack mut ValueFacts f2Facts = new();
    f2Facts.SetIntegerRange(5, 9);
    stack u32[0 max] addedSecondReturnFact = functionReturnFacts.Add(f2Facts);

    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFacts(instrs, blocks, "caller", emptyReturn, paramFacts, valueFacts, globalFacts, functionReturnFacts, 1, entry.Index(), 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @caller(i64 range(i64 0, 11) %p0) {\nb1:\n  %v2 = call i64 @f2(i64 range(i64 0, 11) %p0), !range !0\n  ret i64 %v2\n}\n!0 = !{i64 5, i64 9}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmRangeMetadataForGlobalLoads()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId value = MirLoadGlobal(instrs, 1);
    stack MirBlockId entry = MirReturnBlock(blocks, value);

    stack mut ValueFacts emptyReturn = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut ValueFacts g1Facts = new();
    g1Facts.SetIntegerRange(-3, 4);
    stack u32[0 max] g1 = globalFacts.Add(g1Facts);
    stack mut IrTable<ValueFacts> functionReturnFacts = new();

    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFacts(instrs, blocks, "readg", emptyReturn, paramFacts, valueFacts, globalFacts, functionReturnFacts, 0, entry.Index(), 1, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @readg() {\nb1:\n  %v1 = load i64, ptr @g1, !range !0\n  ret i64 %v1\n}\n!0 = !{i64 -3, i64 4}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmVolatileGlobalLoadStoreFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId loaded = MirLoadGlobal(instrs, 1);
    stack MirValueId value = MirConstInt(instrs, 9);
    stack MirValueId stored = MirStoreGlobal(instrs, 2, value);
    stack MirBlockId entry = MirReturnBlock(blocks, loaded);

    stack mut ValueFacts emptyReturn = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut ValueFacts loadFacts = new();
    loadFacts.MarkVolatile();
    loadFacts.SetIntegerRange(1, 10);
    stack u32[0 max] addedLoadFacts = globalFacts.Add(loadFacts);
    stack mut ValueFacts storeFacts = new();
    storeFacts.MarkVolatile();
    stack u32[0 max] addedStoreFacts = globalFacts.Add(storeFacts);
    stack mut IrTable<ValueFacts> functionReturnFacts = new();

    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFacts(
        instrs,
        blocks,
        "volatile_globals",
        emptyReturn,
        paramFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        0,
        entry.Index(),
        1,
        3,
        sink))
    {
        case MemoryStatus.Ok:
            return addedLoadFacts == 1
                && addedStoreFacts == 2
                && stored.IsValid()
                && LlvmTextEquals(
                    sink,
                    "define i64 @volatile_globals() {\nb1:\n  %v1 = load volatile i64, ptr @g1, !range !0\n  %v2 = add i64 0, 9\n  store volatile i64 %v2, ptr @g2\n  ret i64 %v1\n}\n!0 = !{i64 1, i64 10}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmAlignedGlobalLoadStoreFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId loaded = MirLoadGlobal(instrs, 1);
    stack MirValueId value = MirConstInt(instrs, 13);
    stack MirValueId stored = MirStoreGlobal(instrs, 2, value);
    stack MirBlockId entry = MirReturnBlock(blocks, loaded);

    stack mut ValueFacts emptyReturn = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut ValueFacts loadFacts = new();
    loadFacts.SetAlignment(16);
    loadFacts.SetIntegerRange(1, 10);
    stack u32[0 max] addedLoadFacts = globalFacts.Add(loadFacts);
    stack mut ValueFacts storeFacts = new();
    storeFacts.SetAlignment(8);
    stack u32[0 max] addedStoreFacts = globalFacts.Add(storeFacts);
    stack mut IrTable<ValueFacts> functionReturnFacts = new();

    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFacts(
        instrs,
        blocks,
        "aligned_globals",
        emptyReturn,
        paramFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        0,
        entry.Index(),
        1,
        3,
        sink))
    {
        case MemoryStatus.Ok:
            return addedLoadFacts == 1
                && addedStoreFacts == 2
                && stored.IsValid()
                && LlvmTextEquals(
                    sink,
                    "define i64 @aligned_globals() {\nb1:\n  %v1 = load i64, ptr @g1, align 16, !range !0\n  %v2 = add i64 0, 13\n  store i64 %v2, ptr @g2, align 8\n  ret i64 %v1\n}\n!0 = !{i64 1, i64 10}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool CompileFunctionRangeSignatureLowersToLlvmRangeAttributes()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionToLlvm("fn i64[0 10] id(i64[1 5] x) { return x }", sink);
    return ok
        && LlvmTextEquals(sink, "define range(i64 0, 11) i64 @main(i64 range(i64 1, 6) %p0) {\nb1:\n  ret i64 %p0\n}\n");
}

[Fact]
fn bool CompileFunctionArithmeticRangeSignatureLowersToLlvmRangeAttributes()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionToLlvm("fn i64[1 + 1 2 ** 4] id(i64[2 * 3 10 + 1] x) { return x }", sink);
    return ok
        && LlvmTextEquals(sink, "define range(i64 2, 17) i64 @main(i64 range(i64 6, 12) %p0) {\nb1:\n  ret i64 %p0\n}\n");
}

[Fact]
fn bool CompileModuleArithmeticCallArgumentLowersToLlvmRangeAttribute()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn i64[0 10] id(i64[0 10] x) { return x } fn i64[0 10] main() { return id(2 + 3) }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local range(i64 0, 11) i64 @f1(i64 range(i64 0, 11) %p0) {\nb1:\n  ret i64 %p0\n}\ndefine internal dso_local range(i64 0, 11) i64 @f2() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  %v4 = call i64 @f1(i64 range(i64 5, 6) %v3), !range !0\n  ret i64 %v4\n}\n!0 = !{i64 0, i64 11}\n");
}

[Fact]
fn bool CompileFunctionRejectsUnprovenReturnRangeAttributes()
{
    stack mut OwnedAscii good = new();
    stack mut OwnedAscii literalTooWide = new();
    stack mut OwnedAscii paramTooWide = new();
    return CompileFunctionToLlvm("fn i64[0 10] good() { return 7 }", good)
        && LlvmTextEquals(good, "define range(i64 0, 11) i64 @main() {\nb1:\n  %v1 = add i64 0, 7\n  ret i64 %v1\n}\n")
        && !CompileFunctionToLlvm("fn i64[0 10] bad() { return 99 }", literalTooWide)
        && !CompileFunctionToLlvm("fn i64[0 10] bad(i64[0 max] x) { return x }", paramTooWide);
}

[Fact]
fn bool CompileModuleBranchReturnRangeUsesComparisonProof()
{
    stack mut OwnedAscii proven = new();
    stack bool provenOk = CompileModuleFromAst("fn i64[0 10] bounded(i64[0 max] x) { if x < 11 return x else return 0 }", proven);
    stack mut OwnedAscii tooWide = new();
    stack bool tooWideOk = CompileModuleFromAst("fn i64[0 10] bounded(i64[0 max] x) { if x < 12 return x else return 0 }", tooWide);
    return provenOk
        && System.Text.Contains(proven.View(), "define internal dso_local range(i64 0, 11) i64 @f1")
        && !tooWideOk;
}

[Fact]
fn bool CompileFunctionFiniteLawLowersToStructuredEffectAttributes()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionToLlvm("finite law fn i64[0 10] id(i64[1 5] x) { return x }", sink);
    return ok
        && LlvmTextEquals(sink, "define range(i64 0, 11) i64 @main(i64 range(i64 1, 6) %p0) memory(none) nosync nofree willreturn mustprogress norecurse {\nb1:\n  ret i64 %p0\n}\n");
}

[Fact]
fn bool CompileFunctionLawAndFiniteKindsLowerSeparately()
{
    stack mut OwnedAscii lawSink = new();
    stack bool lawOk = CompileFunctionToLlvm("law fn i64 read(i64 x) { return x }", lawSink);
    stack mut OwnedAscii finiteSink = new();
    stack bool finiteOk = CompileFunctionToLlvm("finite fn i64 one() { return 1 }", finiteSink);
    return lawOk
        && finiteOk
        && LlvmTextEquals(lawSink, "define i64 @main(i64 %p0) memory(none) nosync nofree norecurse {\nb1:\n  ret i64 %p0\n}\n")
        && LlvmTextEquals(finiteSink, "define i64 @main() willreturn mustprogress norecurse {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool CompileFunctionPointerBorrowsLowerGranularCaptureAttributes()
{
    stack mut OwnedAscii borrowed = new();
    stack bool borrowOk = CompileFunctionToLlvm("fn i64 read(borrow i32 value) { return 1 }", borrowed);
    stack mut OwnedAscii returned = new();
    stack bool retOk = CompileFunctionToLlvm("fn i64 echo(retborrow i32 value) { return 1 }", returned);
    stack mut OwnedAscii stored = new();
    stack bool storeOk = CompileFunctionToLlvm("fn i64 hold(storeborrow i32 value) { return 1 }", stored);
    return borrowOk
        && retOk
        && storeOk
        && LlvmTextEquals(borrowed, "define i64 @main(ptr captures(none) readonly %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n")
        && LlvmTextEquals(returned, "define i64 @main(ptr captures(ret: address, read_provenance) readonly %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n")
        && LlvmTextEquals(stored, "define i64 @main(ptr captures(address, read_provenance) readonly %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n");
}

