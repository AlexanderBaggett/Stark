    stack u32[0 max] aggregateCaseCountRow = aggregateCaseCounts.Add(1);
    stack u32[0 max] aggregateCaseGuardRow = aggregateCaseGuards.Add(0);
    if (aggregateCaseStartRow != aggregateCaseCountRow || aggregateCaseStartRow != aggregateCaseGuardRow)
    {
        return false;
    }

    return !SourceSwitchPatternDecisionCaseOverlapsPreviousUnguardedCase(
            exprNodes,
            scalarCaseStarts,
            scalarCaseCounts,
            scalarCaseGuards,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors,
            rightScalarMember,
            1)
        && SourceSwitchPatternDecisionCaseOverlapsPreviousUnguardedCase(
            exprNodes,
            scalarCaseStarts,
            scalarCaseCounts,
            scalarCaseGuards,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors,
            overlapScalarMember,
            1)
        && SourceSwitchPatternDecisionCaseOverlapsPreviousUnguardedCase(
            exprNodes,
            scalarCaseStarts,
            malformedCaseCounts,
            scalarCaseGuards,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors,
            rightScalarMember,
