[Fact]
fn bool MirGlobalRecordsInitialValue()
{
    // A global records its 1-based id and integer initializer.
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g1 = MirDefineGlobal(globals, 7);
    stack u32[0 max] g2 = MirDefineGlobal(globals, -3);
    stack u32[0 max] g3 = MirDefineGlobalTyped(globals, MirType.I32, 17);
    stack u32[0 max] g4 = MirDefineGlobalTyped(globals, MirType.I8, -7);
    stack u32[0 max] g5 = MirDefineGlobalTyped(globals, MirType.I16, 30000);
    stack u32[0 max] rejected = MirDefineGlobalTyped(globals, MirType.I1, 2);
    stack u32[0 max] rejectedI8 = MirDefineGlobalTyped(globals, MirType.I8, 128);
    stack u32[0 max] rejectedI16 = MirDefineGlobalTyped(globals, MirType.I16, -32769);
    return g1 == 1
        && g2 == 2
        && g3 == 3
        && g4 == 4
        && g5 == 5
        && rejected == 0
        && rejectedI8 == 0
        && rejectedI16 == 0
        && globals.Count() == 5
        && MirGlobalType(globals, g1) == MirType.I64
        && MirGlobalType(globals, g3) == MirType.I32
        && MirGlobalType(globals, g4) == MirType.I8
        && MirGlobalType(globals, g5) == MirType.I16
        && MirGlobalInitialValue(globals, g1) == 7
        && MirGlobalInitialValue(globals, g2) == -3
        && MirGlobalInitialValue(globals, g3) == 17
        && MirGlobalInitialValue(globals, g4) == -7
        && MirGlobalInitialValue(globals, g5) == 30000
        && MirGlobalInitialValue(globals, 99) == 0;
}

[Fact]
fn bool EmitsLlvmGlobals()
{
    // Globals emit one `@gN = global <type> V` line each, in id order.
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] unused1 = MirDefineGlobal(globals, 7);
    stack u32[0 max] unused2 = MirDefineGlobal(globals, -3);
    stack u32[0 max] unused3 = MirDefineGlobalTyped(globals, MirType.I32, 12);
    stack u32[0 max] unused4 = MirDefineGlobalTyped(globals, MirType.Ptr, 0);
    stack u32[0 max] unused5 = MirDefineGlobalTyped(globals, MirType.I8, -8);
    stack u32[0 max] unused6 = MirDefineGlobalTyped(globals, MirType.I16, 1024);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmGlobals(globals, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "@g1 = global i64 7\n@g2 = global i64 -3\n@g3 = global i32 12\n@g4 = global ptr null\n@g5 = global i8 -8\n@g6 = global i16 1024\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

