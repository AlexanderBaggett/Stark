        "module Test\nfn i64[min max] Classify(bool flag) { var y = 0; switch (flag) { case true: y = 10; case false: y = 20; default: y = 30; } return y + 1 }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId condition = MirBlockCondValue(blocks, MirBlockIdOf(1));
    stack MirValueId returned = MirBlockReturnValue(blocks, MirBlockIdOf(4));
    stack MirValueId finalPhi = MirOperandAOf(instrs, returned);
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 4
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 4
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 5
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(4)) == MirTermKind.Return
        && MirBlockCondThen(blocks, MirBlockIdOf(1)) == MirBlockIdOf(2)
        && MirBlockCondElse(blocks, MirBlockIdOf(1)) == MirBlockIdOf(3)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(2)) == MirBlockIdOf(4)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(3)) == MirBlockIdOf(4)
        && MirOpcodeOf(instrs, condition) == MirOp.Param
        && MirValueType(instrs, condition.Index()) == MirType.I1
        && MirOpcodeOf(instrs, returned) == MirOp.Add
        && MirOpcodeOf(instrs, finalPhi) == MirOp.Phi
        && MirPhiIncomingBlock0(instrs, finalPhi) == MirBlockIdOf(2)
        && MirPhiIncomingBlock1(instrs, finalPhi) == MirBlockIdOf(3);
}

