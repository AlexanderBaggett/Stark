[Fact]
fn bool EmitsLlvmTailCallTerminator()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<u32[0 max]> tailFlags = new();
    stack u32[0 max] f1Tail = tailFlags.Add(1);
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId tail = MirTailCall1(instrs, MirFuncIdOf(1), p0);
    stack MirBlockId entry = MirTailCallBlock(blocks, tail);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParamsTail(instrs, tailFlags, blocks, "fwd", 1, entry.Index(), 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define tailcc i64 @fwd(i64 %p0) {\nb1:\n  %v2 = musttail call tailcc i64 @f1(i64 %p0)\n  ret i64 %v2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmTypedTailCallTerminator()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<u32[0 max]> tailFlags = new();
    stack u32[0 max] f1Tail = tailFlags.Add(1);
    stack MirValueId p0 = MirParamTyped(instrs, MirType.I32, 0);
    stack MirValueId tail = MirTailCall1Typed(instrs, MirType.I32, MirFuncIdOf(1), p0);
    stack MirBlockId entry = MirTailCallBlock(blocks, tail);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParamsTail(instrs, tailFlags, blocks, "fwd_i32", 1, entry.Index(), 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return MirValueType(instrs, tail.Index()) == MirType.I32
                && LlvmTextEquals(sink, "define tailcc i32 @fwd_i32(i32 %p0) {\nb1:\n  %v2 = musttail call tailcc i32 @f1(i32 %p0)\n  ret i32 %v2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool TailCallTerminatorRequiresTailCallableCallee()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId tail = MirTailCall(instrs, MirFuncIdOf(1));
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId entry = MirTailCallBlock(blocks, tail);
    stack mut IrTable<u32[0 max]> noTailFlags = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParamsTail(instrs, noTailFlags, blocks, "bad", 0, entry.Index(), 1, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define tailcc i64 @bad() {\nb1:\n  unreachable\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmOrdinaryCallToTailCallableWithTailcc()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<u32[0 max]> tailFlags = new();
    stack u32[0 max] f1Tail = tailFlags.Add(1);
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId result = MirCall1(instrs, MirFuncIdOf(1), p0);
    stack MirBlockId entry = MirReturnBlock(blocks, result);
    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, 2));
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmBlocksWithTailCallees(instrs, tailFlags, blocks, "caller", false, 1, ranges, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @caller(i64 %p0) {\nb1:\n  %v2 = call tailcc i64 @f1(i64 %p0)\n  ret i64 %v2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirComparisonRecordsOpcodeAndOperands()
{
    // Comparison instructions record their opcode and both operands.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 3);
    stack MirValueId b = MirConstInt(instrs, 4);
    stack MirValueId eq = MirCmpEq(instrs, a, b);
    stack MirValueId ge = MirCmpGe(instrs, a, b);
    stack MirValueId opA = MirOperandAOf(instrs, eq);
    stack MirValueId opB = MirOperandBOf(instrs, eq);
    return MirOpcodeOf(instrs, eq) == MirOp.CmpEq
        && MirOpcodeOf(instrs, ge) == MirOp.CmpGe
        && MirValueType(instrs, eq.Index()) == MirType.I1
        && MirValueType(instrs, ge.Index()) == MirType.I1
        && opA.Equals(a)
        && opB.Equals(b);
}

[Fact]
fn bool EmitsLlvmAllComparisonPredicates()
{
    // Each comparison opcode lowers to its LLVM `icmp` predicate (signed).
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId a = MirConstInt(instrs, 1);
    stack MirValueId b = MirConstInt(instrs, 2);
    stack MirValueId e1 = MirCmpEq(instrs, a, b);
    stack MirValueId e2 = MirCmpNe(instrs, a, b);
    stack MirValueId e3 = MirCmpLt(instrs, a, b);
    stack MirValueId e4 = MirCmpLe(instrs, a, b);
    stack MirValueId e5 = MirCmpGt(instrs, a, b);
    stack MirValueId e6 = MirCmpGe(instrs, a, b);
    stack MirBlockId entry = MirReturnBlock(blocks, a);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "cmps", 0, entry.Index(), 1, 8, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @cmps() {\nb1:\n  %v1 = add i64 0, 1\n  %v2 = add i64 0, 2\n  %v3 = icmp eq i64 %v1, %v2\n  %v4 = icmp ne i64 %v1, %v2\n  %v5 = icmp slt i64 %v1, %v2\n  %v6 = icmp sle i64 %v1, %v2\n  %v7 = icmp sgt i64 %v1, %v2\n  %v8 = icmp sge i64 %v1, %v2\n  ret i64 %v1\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmWellTypedConditionalBranch()
{
    // A comparison yields an i1 that feeds a CondBranch — `br i1 %vN` is now
    // well-typed (the condition register is a genuine icmp result, not an i64).
    // `fn cmp(x, y) { if x < y then 1 else 0 }`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId x = MirParam(instrs, 0);
    stack MirValueId y = MirParam(instrs, 1);
    stack MirValueId lt = MirCmpLt(instrs, x, y);
    stack MirValueId tv = MirConstInt(instrs, 1);
    stack MirValueId ev = MirConstInt(instrs, 0);
    stack MirBlockId thenB = MirReturnBlock(blocks, tv);
    stack MirBlockId elseB = MirReturnBlock(blocks, ev);
    stack MirBlockId entry = MirCondBlock(blocks, lt, thenB, elseB);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "cmp", 2, entry.Index(), 1, 3, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @cmp(i64 %p0, i64 %p1) {\nb3:\n  %v3 = icmp slt i64 %p0, %p1\n  br i1 %v3, label %b1, label %b2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool ByteBufferRoundTripsU32()
{
    // A u32 round-trips through 4 little-endian bytes.
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 305419896);
    WriteU32(buf, 0);
    return buf.Count() == 8
        && ReadU32(buf, 1) == 305419896
        && ReadU32(buf, 5) == 0;
}

[Fact]
fn bool ByteBufferRoundTripsU32Max()
{
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 4294967295);
    return buf.Count() == 4
        && buf.Get(1) == 255
        && buf.Get(2) == 255
        && buf.Get(3) == 255
        && buf.Get(4) == 255
        && ReadU32(buf, 1) == 4294967295;
}

[Fact]
fn bool ByteBufferRoundTripsI64()
{
    // An i64 round-trips through 8 little-endian bytes, including a negative value.
    stack mut IrTable<u8[0 max]> buf = new();
    WriteI64(buf, 9223372036854775807);
    WriteI64(buf, -5);
    return buf.Count() == 16
        && ReadI64(buf, 1) == 9223372036854775807
        && ReadI64(buf, 9) == -5;
}

[Fact]
fn bool BinaryRoundTripsBlocks()
{
    // The block table survives a binary round-trip: terminator kinds and slots.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 1);
    stack MirBlockId retB = MirReturnBlock(blocks, v);
    stack MirBlockId brB = MirBranchBlock(blocks, retB);
    stack MirBlockId condB = MirCondBlock(blocks, v, retB, brB);
    stack MirValueId tail = MirTailCall1(instrs, MirFuncIdOf(1), v);
    stack MirBlockId tailB = MirTailCallBlock(blocks, tail);
    stack MirBlockId voidB = MirReturnVoidBlock(blocks);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeBlocks(blocks, buf);
    stack mut IrTable<MirBlock> back = new();
    DeserializeBlocks(buf, back);
    stack MirBlockId brTarget = MirBlockBranchTarget(back, MirBlockIdOf(2));
    stack MirBlockId condThen = MirBlockCondThen(back, MirBlockIdOf(3));
    stack MirBlockId condElse = MirBlockCondElse(back, MirBlockIdOf(3));
    stack MirValueId tailPayload = MirBlockTailCallValue(back, MirBlockIdOf(4));
    return back.Count() == 5
        && MirBlockTerminator(back, MirBlockIdOf(1)) == MirTermKind.Return
        && MirBlockTerminator(back, MirBlockIdOf(2)) == MirTermKind.Branch
        && MirBlockTerminator(back, MirBlockIdOf(3)) == MirTermKind.CondBranch
        && MirBlockTerminator(back, MirBlockIdOf(4)) == MirTermKind.TailCall
        && MirBlockTerminator(back, MirBlockIdOf(5)) == MirTermKind.ReturnVoid
        && brTarget.Equals(MirBlockIdOf(1))
        && condThen.Equals(MirBlockIdOf(1))
        && condElse.Equals(MirBlockIdOf(2))
        && tailPayload.Equals(tail)
        && !MirBlockHasIndependentLoopBackedge(back, MirBlockIdOf(2))
        && voidB.Index() == 5;
}

[Fact]
fn bool BinaryRoundTripsIndependentLoopBackedgeFlag()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 1);
    stack MirBlockId retB = MirReturnBlock(blocks, v);
    stack MirBlockId indB = MirIndependentLoopBackedgeBlock(blocks, retB);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeBlocks(blocks, buf);
    stack mut IrTable<MirBlock> back = new();
    DeserializeBlocks(buf, back);
    return buf.Count() == 38
        && back.Count() == 2
        && indB.Index() == 2
        && MirBlockTerminator(back, MirBlockIdOf(2)) == MirTermKind.Branch
        && MirBlockBranchTarget(back, MirBlockIdOf(2)) == MirBlockIdOf(1)
        && MirBlockHasIndependentLoopBackedge(back, MirBlockIdOf(2))
        && !MirBlockHasIndependentLoopBackedge(back, MirBlockIdOf(1));
}

[Fact]
fn bool BinaryRoundTripsFunctions()
{
    // A function record survives a binary round-trip: entry + owned ranges.
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, MirBlockIdOf(2), MirBlockIdOf(2), 3, MirValueIdOf(5), 7);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeFunctions(funcs, buf);
    stack mut IrTable<MirFunction> back = new();
    DeserializeFunctions(buf, back);
    stack MirBlockId entry = MirFunctionEntry(back, MirFuncIdOf(1));
    return back.Count() == 1
        && entry.Equals(MirBlockIdOf(2))
        && MirFunctionBlockCount(back, MirFuncIdOf(1)) == 3
        && MirFunctionInstrCount(back, MirFuncIdOf(1)) == 7;
}

[Fact]
fn bool BinaryRoundTripsGlobals()
{
    // The globals table survives a binary round-trip, including typed initializers.
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g1 = MirDefineGlobal(globals, 100);
    stack u32[0 max] g2 = MirDefineGlobal(globals, -7);
    stack u32[0 max] g3 = MirDefineGlobalTyped(globals, MirType.I32, 55);
    stack u32[0 max] g4 = MirDefineGlobalTyped(globals, MirType.I8, -12);
    stack u32[0 max] g5 = MirDefineGlobalTyped(globals, MirType.I16, 32000);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeGlobals(globals, buf);
    stack mut IrTable<MirGlobal> back = new();
    DeserializeGlobals(buf, back);
    return back.Count() == 5
        && buf.Count() == 49
        && MirGlobalType(back, 1) == MirType.I64
        && MirGlobalType(back, 3) == MirType.I32
        && MirGlobalType(back, 4) == MirType.I8
        && MirGlobalType(back, 5) == MirType.I16
        && MirGlobalInitialValue(back, 1) == 100
        && MirGlobalInitialValue(back, 2) == -7
        && MirGlobalInitialValue(back, 3) == 55
        && MirGlobalInitialValue(back, 4) == -12
        && MirGlobalInitialValue(back, 5) == 32000;
}

[Fact]
fn bool LowersReturnIntSourceToLlvm()
{
    // The first source -> MIR -> LLVM thread (toward bootstrap #33): lex the source
    // `return 42`, find the integer literal, lower to MIR (const + return), and emit
    // the LLVM `@main` function.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnIntToLlvm("return 42", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 42\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool LowersReturnIntRejectsNoLiteral()
{
    // Source with no integer literal is rejected by the lowering.
    stack mut OwnedAscii sink = new();
    return !LowerReturnIntToLlvm("return", sink);
}

[Fact]
fn bool LowersReturnAddExpr()
{
    // `return 2 + 3` lexes + lowers to a MIR add and emits the LLVM function.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 2 + 3", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnSubAndMulExpr()
{
    // `-` and `*` lower to sub/mul.
    stack mut OwnedAscii sinkSub = new();
    stack bool okSub = LowerReturnExprToLlvm("return 10 - 4", sinkSub);
    stack mut OwnedAscii sinkMul = new();
    stack bool okMul = LowerReturnExprToLlvm("return 6 * 7", sinkMul);
    return okSub
        && okMul
        && LlvmTextEquals(sinkSub, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 10\n  %v2 = add i64 0, 4\n  %v3 = sub i64 %v1, %v2\n  ret i64 %v3\n}\n")
        && LlvmTextEquals(sinkMul, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 6\n  %v2 = add i64 0, 7\n  %v3 = mul i64 %v1, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnSingleConstViaExpr()
{
    // The single-constant case still works through the expression lowering.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 42", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 42\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool LowersReturnExpressionChain()
{
    // An arbitrary-length operator chain folds left-associatively:
    // `return 2 + 3 + 4` -> ((2 + 3) + 4).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 2 + 3 + 4", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  %v4 = add i64 0, 4\n  %v5 = add i64 %v3, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersProgramWithLocalVariable()
{
    // A two-statement program: a local binds an expression's value, and the return
    // reuses it by name. `var x = 2 + 3; return x * x` -> x = %v3 (the add), reused.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerProgramToLlvm("var x = 2 + 3; return x * x", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  %v4 = mul i64 %v3, %v3\n  ret i64 %v4\n}\n");
}

[Fact]
fn bool LowersProgramWithTwoLocals()
{
    // Two local declarations, both reused in the return: `var x = 2; var y = 3;
    // return x + y` -> x = %v1, y = %v2, ret add %v1, %v2.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerProgramToLlvm("var x = 2; var y = 3; return x + y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersProgramLocalReferencesEarlierLocal()
{
    // A later local can reference an earlier one: `var x = 4; var y = x * x;
    // return y + x` -> y = x*x (%v2), ret (y + x).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerProgramToLlvm("var x = 4; var y = x * x; return y + x", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 4\n  %v2 = mul i64 %v1, %v1\n  %v3 = add i64 %v2, %v1\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersProgramReturningLocalPlusConst()
{
    // The local appears in a larger expression: `var y = 6 * 7; return y + 1`.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerProgramToLlvm("var y = 6 * 7; return y + 1", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 6\n  %v2 = add i64 0, 7\n  %v3 = mul i64 %v1, %v2\n  %v4 = add i64 0, 1\n  %v5 = add i64 %v3, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersFunctionParameterAndCallArgument()
{
    // A function with a parameter, called with an argument:
    // `fn double(x) { return x + x } fn main() { return double(5) }` -> @f1 takes %p0
    // and doubles it; @f2 calls @f1 with the constant 5.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerModuleToLlvm("fn double(x) { return x + x } fn main() { return double(5) }", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @f1(i64 %p0) {\nb1:\n  %v3 = add i64 %p0, %p0\n  ret i64 %v3\n}\ndefine i64 @f2() {\nb2:\n  %v4 = add i64 0, 5\n  %v5 = call i64 @f1(i64 %v4)\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersTwoFunctionsWithCall()
{
    // Two function definitions where the second calls the first by name:
    // `fn helper() { return 7 } fn main() { return helper() }` -> a module with
    // @f1 (returns 7) and @f2 (calls @f1).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerModuleToLlvm("fn helper() { return 7 } fn main() { return helper() }", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @f1() {\nb1:\n  %v1 = add i64 0, 7\n  ret i64 %v1\n}\ndefine i64 @f2() {\nb2:\n  %v2 = call i64 @f1()\n  ret i64 %v2\n}\n");
}

[Fact]
fn bool LowersIfExpressionToBranchingLlvm()
{
    // An `if` from source compiles to a branching function with a phi merge:
    // `if x < y x else y` -> compare x,y; branch; phi selects x or y at the merge.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerIfToLlvm("if x < y x else y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v3 = icmp slt i64 %p0, %p1\n  br i1 %v3, label %b2, label %b3\nb2:\n  br label %b4\nb3:\n  br label %b4\nb4:\n  %v6 = phi i64 [ %p0, %b2 ], [ %p1, %b3 ]\n  ret i64 %v6\n}\n");
}

[Fact]
fn bool LowersIfWithExpressionArms()
{
    // The then/else arms are expressions computed in their own blocks:
    // `if x < y x + 1 else y - 1` -> then block computes x+1, else block computes y-1,
    // the merge phi selects between them.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerIfToLlvm("if x < y x + 1 else y - 1", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v3 = icmp slt i64 %p0, %p1\n  br i1 %v3, label %b2, label %b3\nb2:\n  %v5 = add i64 0, 1\n  %v6 = add i64 %p0, %v5\n  br label %b4\nb3:\n  %v8 = add i64 0, 1\n  %v9 = sub i64 %p1, %v8\n  br label %b4\nb4:\n  %v10 = phi i64 [ %v6, %b2 ], [ %v9, %b3 ]\n  ret i64 %v10\n}\n");
}

[Fact]
fn bool LowersReturnComparison()
{
    // `return x < y` lowers to a signed compare then zero-extend to i64 (1 or 0).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x < y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v3 = icmp slt i64 %p0, %p1\n  %v4 = zext i1 %v3 to i64\n  ret i64 %v4\n}\n");
}

[Fact]
fn bool LowersReturnComparisonBelowArithmetic()
{
    // Comparison binds below `+`: `return x + 1 < y` lowers as `(x + 1) < y`.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x + 1 < y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v2 = add i64 0, 1\n  %v3 = add i64 %p0, %v2\n  %v5 = icmp slt i64 %v3, %p1\n  %v6 = zext i1 %v5 to i64\n  ret i64 %v6\n}\n");
}

[Fact]
fn bool LowersReturnParameterExpression()
{
    // An identifier in the expression is the function parameter `x` (lowered to %p0),
    // and the function gains a parameter: `fn(x) return x + 1`.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x + 1", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0) {\nb1:\n  %v2 = add i64 0, 1\n  %v3 = add i64 %p0, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnParameterSquared()
{
    // `return x * x` references the same parameter twice (one symbol-table entry):
    // `mul i64 %p0, %p0`, one declared parameter.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x * x", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0) {\nb1:\n  %v3 = mul i64 %p0, %p0\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnTwoParameters()
{
    // Distinct identifiers become distinct parameters via the symbol table:
    // `x` -> %p0, `y` -> %p1, in first-appearance order.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x + y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v3 = add i64 %p0, %p1\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnTwoParametersWithPrecedence()
{
    // `return x + y * x` -> x + (y * x): y=%p1, x=%p0, mul then add.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x + y * x", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v4 = mul i64 %p1, %p0\n  %v5 = add i64 %p0, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersReturnDivisionAndRemainder()
{
    // `/` and `%` lower to `sdiv`/`srem` in the product tier.
    stack mut OwnedAscii sinkDiv = new();
    stack bool okDiv = LowerReturnExprToLlvm("return 12 / 3", sinkDiv);
    stack mut OwnedAscii sinkMod = new();
    stack bool okMod = LowerReturnExprToLlvm("return 17 % 5", sinkMod);
    return okDiv
        && okMod
        && LlvmTextEquals(sinkDiv, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 12\n  %v2 = add i64 0, 3\n  %v3 = sdiv i64 %v1, %v2\n  ret i64 %v3\n}\n")
        && LlvmTextEquals(sinkMod, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 17\n  %v2 = add i64 0, 5\n  %v3 = srem i64 %v1, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnDivisionPrecedence()
{
    // `/` binds tighter than `+`: `return 2 + 12 / 3` lowers as `2 + (12 / 3)`.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 2 + 12 / 3", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 12\n  %v3 = add i64 0, 3\n  %v4 = sdiv i64 %v2, %v3\n  %v5 = add i64 %v1, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersReturnRespectsPrecedence()
{
    // `*` binds tighter than `+`: `return 2 + 3 * 4` lowers as `2 + (3 * 4)`, so the
    // mul is computed first and fed to the add.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 2 + 3 * 4", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 0, 4\n  %v4 = mul i64 %v2, %v3\n  %v5 = add i64 %v1, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersReturnMixedOperatorChain()
{
    // A mixed chain folds left-to-right: `return 10 - 3 + 2` -> ((10 - 3) + 2).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 10 - 3 + 2", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 10\n  %v2 = add i64 0, 3\n  %v3 = sub i64 %v1, %v2\n  %v4 = add i64 0, 2\n  %v5 = add i64 %v3, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool FfiBindsLibcFunction()
{
    // The self-hosted compiler package can declare and call a C function via FFI — the
    // same mechanism a direct libLLVM C-API binding (#31) will use. libc `abs` resolves
    // from the system C library that macOS Stark binaries already link.
    return AbsViaFfi(-5) == 5
        && AbsViaFfi(7) == 7
        && AbsViaFfi(0) == 0;
}

[Fact]
fn bool EmittedLlvmCompilesToObject()
{
    // End-to-end #31 (subprocess route): emit a module's LLVM IR, write the `.ll`,
    // invoke `clang -c` to compile it, and confirm an object file was produced — the
    // self-hosted back end producing real native code. Tolerant of a missing toolchain
    // (passes if clang can't be spawned) so the suite stays portable.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    return CompileEmittedLlvmProducesObject(instrs, blocks, funcs);
}

[Fact]
fn bool LlvmModuleRoundTripsThroughFile()
{
    // The emitted LLVM IR text persists to a `.ll` file and reads back identically —
    // the self-hosted back end produces a real .ll file on disk (compilable by
    // clang/llc to an object, the non-FFI path toward #31).
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    return LlvmModuleFileRoundTrips(instrs, blocks, funcs);
}

[Fact]
fn bool PackageImageRoundTripsThroughFile()
{
    // End-to-end #32: serialize a module, write it to a temp file, read it back, and
    // deserialize — the full on-disk path (all I/O inside the module function).
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 5);
    stack MirValueId b = MirConstInt(instrs, 6);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g = MirDefineGlobal(globals, 42);
    return PackageImageFileRoundTrips(instrs, blocks, funcs, globals);
}

[Fact]
fn bool PackageImageInspectsThroughFile()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 5);
    stack MirValueId b = MirConstInt(instrs, 6);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g = MirDefineGlobal(globals, 42);
    stack mut IrTable<u8[0 max]> image = new();
    SerializePackageImage(instrs, blocks, funcs, globals, image);

    stack mut OwnedAscii expectedText = new();
    switch (expectedText.AppendConstAscii("package: 3 instructions, 1 blocks, 1 functions, 1 globals\n"))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii expectedJson = new();
    switch (expectedJson.AppendConstAscii("{\"format\":\"MIR1\",\"instructions\":3,\"blocks\":1,\"functions\":1,\"globals\":1}\n"))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    return PackageImageIsValid(image)
        && PackageImageBufferInspectsThroughFile(image, expectedText, expectedJson);
}

[Fact]
fn bool PackageImageBridgesToByteBuffer()
{
    // The image bytes convert to the stdlib DynamicByteBuffer (the exact type the file
    // API consumes/produces) and back without loss — the module survives the trip
    // through that container, so persisting to disk is a thin wrapper.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 7);
    stack MirValueId b = MirConstInt(instrs, 8);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g = MirDefineGlobal(globals, -3);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializePackageImage(instrs, blocks, funcs, globals, buf);
    stack mut DynamicByteBuffer dbuf = new();
    if (!ImageToByteBuffer(buf, dbuf))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> buf2 = new();
    if (!ImageFromByteBuffer(dbuf, buf2))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack bool ok = DeserializePackageImage(buf2, bi, bb, bf, bg);
    return ok
        && buf2.Count() == buf.Count()
        && bi.Count() == 3
        && bg.Count() == 1
        && MirOpcodeOf(bi, MirValueIdOf(3)) == MirOp.Add
        && MirGlobalInitialValue(bg, 1) == -3;
}

[Fact]
fn bool BinaryRoundTripsPackageImage()
{
    // A whole module — instructions, blocks, functions, globals — round-trips through
    // one combined package image (a section directory + the four streams).
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    stack MirValueId a = MirConstInt(instrs, 11);
    stack MirValueId b = MirConstInt(instrs, 22);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack u32[0 max] g = MirDefineGlobalTyped(globals, MirType.I32, -9);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializePackageImage(instrs, blocks, funcs, globals, buf);
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack bool ok = DeserializePackageImage(buf, bi, bb, bf, bg);
    stack MirBlockId entry = MirFunctionEntry(bf, MirFuncIdOf(1));
    return ok
        && bi.Count() == 3
        && bb.Count() == 1
        && bf.Count() == 1
        && bg.Count() == 1
        && MirOpcodeOf(bi, MirValueIdOf(3)) == MirOp.Add
        && MirBlockTerminator(bb, MirBlockIdOf(1)) == MirTermKind.Return
        && entry.Equals(MirBlockIdOf(1))
        && MirGlobalType(bg, 1) == MirType.I32
        && MirGlobalInitialValue(bg, 1) == -9;
}

[Fact]
fn bool SectionedPackageImageRoundTripsAndInspects()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    stack MirValueId a = MirConstInt(instrs, 13);
    stack MirValueId b = MirConstInt(instrs, 21);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack u32[0 max] g = MirDefineGlobal(globals, 34);

    stack mut IrTable<u8[0 max]> image = new();
    SerializeSectionedPackageImage(instrs, blocks, funcs, globals, image);

    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    if (!DeserializePackageImage(image, bi, bb, bf, bg))
    {
        return false;
    }

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    return PackageImageIsValid(image)
        && ReadU32(image, 1) == 1380013139
        && ReadU32(image, 5) == 1196118091
        && ReadU32(image, 9) == 2
        && ReadU32(image, 13) == 4
        && bi.Count() == 3
        && bb.Count() == 1
        && bf.Count() == 1
        && bg.Count() == 1
        && MirOpcodeOf(bi, MirValueIdOf(3)) == MirOp.Add
        && MirGlobalInitialValue(bg, 1) == 34
        && LlvmTextEquals(text, "package: STARKPKG, 3 instructions, 1 blocks, 1 functions, 1 globals\n")
        && LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"MIR1\",\"instructions\":3,\"blocks\":1,\"functions\":1,\"globals\":1}\n");
}

[Fact]
fn bool SectionedPackageImageRoundTripsEnumLayoutFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    stack MirValueId value = MirConstInt(instrs, 0);
    stack MirBlockId block = MirReturnBlock(blocks, value);
    stack MirFuncId functionId = MirDefineFunction(funcs, block, block, 1, value, 1);

    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> enumFacts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, enumFacts))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> enumFactBytes = new();
    SerializeEnumLayoutFacts(enumFacts, enumFactBytes);
    stack mut IrTable<MirEnumLayoutFact> directlyRestoredFacts = new();
    if (!DeserializeEnumLayoutFacts(enumFactBytes, directlyRestoredFacts))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> image = new();
    SerializeSectionedPackageImageWithEnumLayoutFacts(instrs, blocks, funcs, globals, enumFacts, image);

    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    if (!DeserializePackageImage(image, bi, bb, bf, bg))
    {
        return false;
    }

    stack mut IrTable<MirEnumLayoutFact> restoredFacts = new();
    if (!DeserializePackageImageEnumLayoutFacts(image, restoredFacts))
    {
        return false;
    }

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    stack u32[0 max] sourceDataPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(enumFacts, source, stream, "Data", 0);
    stack u32[0 max] directDataPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(directlyRestoredFacts, source, stream, "Data", 0);
    stack u32[0 max] restoredDataPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(restoredFacts, source, stream, "Data", 0);
    if (sourceDataPayloadSlot == 0 || directDataPayloadSlot == 0 || restoredDataPayloadSlot == 0)
    {
        return false;
    }

    stack MirEnumLayoutFact sourceDataPayload = enumFacts.Get(sourceDataPayloadSlot);
    stack MirEnumLayoutFact directDataPayload = directlyRestoredFacts.Get(directDataPayloadSlot);
    stack MirEnumLayoutFact restoredDataPayload = restoredFacts.Get(restoredDataPayloadSlot);
    stack TypeId sourcePayloadOwner = sourceDataPayload.OwnerType();
    stack TypeId directPayloadOwner = directDataPayload.OwnerType();
    stack TypeId restoredPayloadOwner = restoredDataPayload.OwnerType();
    return PackageImageIsValid(image)
        && ReadU32(image, 13) == 5
        && functionId.Index() == 1
        && bi.Count() == 1
        && bb.Count() == 1
        && bf.Count() == 1
        && bg.Count() == 0
        && enumFacts.Count() == 5
        && directlyRestoredFacts.Count() == 5
        && restoredFacts.Count() == 5
        && sourcePayloadOwner.Equals(directPayloadOwner)
        && sourcePayloadOwner.Equals(restoredPayloadOwner)
        && sourceDataPayload.RowKind() == directDataPayload.RowKind()
        && sourceDataPayload.RowKind() == restoredDataPayload.RowKind()
        && sourceDataPayload.PayloadKind() == directDataPayload.PayloadKind()
        && sourceDataPayload.PayloadKind() == restoredDataPayload.PayloadKind()
        && sourceDataPayload.TypeKind() == directDataPayload.TypeKind()
        && sourceDataPayload.TypeKind() == restoredDataPayload.TypeKind()
        && restoredDataPayload.VariantTag() == 1
        && restoredDataPayload.OffsetBytes() == 1
        && restoredDataPayload.SizeBytes() == 1
        && restoredDataPayload.AlignmentBytes() == 1
        && restoredDataPayload.HasConcreteLayout()
        && LlvmTextEquals(text, "package: STARKPKG, 1 instructions, 1 blocks, 1 functions, 0 globals, 5 enum layout facts\n")
        && LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"MIR1\",\"instructions\":1,\"blocks\":1,\"functions\":1,\"globals\":0,\"enumLayoutFacts\":5}\n");
}

internal fn void AppendImageByte(mut borrow IrTable<u8[0 max]> image, u8[0 max] value)
{
    stack u32[0 max] written = image.Add(value);
}

internal fn void BuildMinimalLogicalPackageImage(mut borrow IrTable<u8[0 max]> image, u32[0 max] rootStringIndex)
{
    stack u64[0 max] stringOffset = 120;
    stack u64[0 max] stringLength = 25;
    stack u64[0 max] factsOffset = 145;
    stack u64[0 max] factsLength = 44;
    stack u64[0 max] manifestOffset = 189;

    WriteStarkPackageImageMagic(image);
    WriteU32(image, SectionedPackageImageVersion());
    WriteU32(image, 3);
    WriteU64(image, 96);
    WritePackageSectionDirectoryEntry(image, PackageSectionStringTable(), SectionFlagsRequired(), stringOffset, stringLength, SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(image, PackageSectionPackageFacts(), SectionFlagsRequired(), factsOffset, factsLength, SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(image, PackageSectionManifest(), SectionFlagsRequired(), manifestOffset, 1, SectionEncodingBrotliUtf8Json());

    WriteU32(image, 2);
    WriteU32(image, 4);
    AppendImageByte(image, 68);
    AppendImageByte(image, 101);
    AppendImageByte(image, 109);
    AppendImageByte(image, 111);
    WriteU32(image, 9);
    AppendImageByte(image, 108);
    AppendImageByte(image, 105);
    AppendImageByte(image, 98);
    AppendImageByte(image, 68);
    AppendImageByte(image, 101);
    AppendImageByte(image, 109);
    AppendImageByte(image, 111);
    AppendImageByte(image, 46);
    AppendImageByte(image, 97);

    WriteU32(image, rootStringIndex);
    WriteU32(image, 1);
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, 0);
    WriteU32(image, 0);
    WriteU32(image, 0);
    AppendImageByte(image, 11);
}

