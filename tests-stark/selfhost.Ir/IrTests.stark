[Fact]
fn bool LogicalPackageImageReadsSourceSurfaceImportRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Source",
              "ReExports": [ { "ModuleName": "Legacy.Export" } ],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "Imports": [ { "ModuleName": "Legacy.Import", "IsExported": false } ],
              "SourceSurface": {
                "Imports": [
                  { "ModuleName": "Source.Import", "IsExported": false },
                  { "ModuleName": "Source.Export", "IsExported": true },
                  { "ModuleName": "Source.Both", "IsExported": false }
                ],
                "ReExports": [
                  { "ModuleName": "Source.Both" },
                  { "ModuleName": "Source.ReExport" }
                ]
              }
            },
            {
              "ModuleName": "LegacyOnly",
              "ReExports": [ { "ModuleName": "Legacy.Export" } ],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "Imports": [ { "ModuleName": "Legacy.Import", "IsExported": false } ]
            },
            {
              "ModuleName": "Bad",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "SourceSurface": {
                "Imports": [ { "ModuleName": "", "IsExported": false } ]
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageSourceSurfaceImportSummary sourceImport = new();
    stack mut LogicalPackageSourceSurfaceImportSummary sourceExport = new();
    stack mut LogicalPackageSourceSurfaceImportSummary sourceBoth = new();
    stack mut LogicalPackageSourceSurfaceImportSummary sourceReExport = new();
    stack mut LogicalPackageSourceSurfaceImportSummary legacyImport = new();
    stack mut LogicalPackageSourceSurfaceImportSummary legacyReExport = new();
    stack mut LogicalPackageSourceSurfaceImportSummary rejected = new();
    stack mut OwnedAscii sourceImportName = new();
    stack mut OwnedAscii sourceExportName = new();
    stack mut OwnedAscii sourceBothName = new();
    stack mut OwnedAscii sourceReExportName = new();
    stack mut OwnedAscii legacyImportName = new();
    stack mut OwnedAscii legacyReExportName = new();
    stack mut OwnedAscii rejectedName = new();
    unsafe
    {
        return TryReadLogicalPackageSourceSurfaceImportJsonSummary(
                manifestJson,
                0,
                0,
                sourceImport,
                sourceImportName)
            && sourceImport.ModuleOrdinal() == 0
            && sourceImport.ImportOrdinal() == 0
            && sourceImport.HasDirectImport()
            && !sourceImport.HasReExport()
            && !sourceImport.IsExported()
            && OwnedAsciiEqualsAscii(sourceImportName, "Source.Import")
            && TryReadLogicalPackageSourceSurfaceImportJsonSummary(
                manifestJson,
                0,
                1,
                sourceExport,
                sourceExportName)
            && sourceExport.HasDirectImport()
            && !sourceExport.HasReExport()
            && sourceExport.IsExported()
            && OwnedAsciiEqualsAscii(sourceExportName, "Source.Export")
            && TryReadLogicalPackageSourceSurfaceImportJsonSummary(
                manifestJson,
                0,
                2,
                sourceBoth,
                sourceBothName)
            && sourceBoth.HasDirectImport()
            && sourceBoth.HasReExport()
            && sourceBoth.IsExported()
            && OwnedAsciiEqualsAscii(sourceBothName, "Source.Both")
            && TryReadLogicalPackageSourceSurfaceImportJsonSummary(
                manifestJson,
                0,
                3,
                sourceReExport,
                sourceReExportName)
            && !sourceReExport.HasDirectImport()
            && sourceReExport.HasReExport()
            && sourceReExport.IsExported()
            && OwnedAsciiEqualsAscii(sourceReExportName, "Source.ReExport")
            && !TryReadLogicalPackageSourceSurfaceImportJsonSummary(
                manifestJson,
                0,
                4,
                rejected,
                rejectedName)
            && TryReadLogicalPackageSourceSurfaceImportJsonSummary(
                manifestJson,
                1,
                0,
                legacyImport,
                legacyImportName)
            && legacyImport.HasDirectImport()
            && !legacyImport.HasReExport()
            && !legacyImport.IsExported()
            && OwnedAsciiEqualsAscii(legacyImportName, "Legacy.Import")
            && TryReadLogicalPackageSourceSurfaceImportJsonSummary(
                manifestJson,
                1,
                1,
                legacyReExport,
                legacyReExportName)
            && !legacyReExport.HasDirectImport()
            && legacyReExport.HasReExport()
            && legacyReExport.IsExported()
            && OwnedAsciiEqualsAscii(legacyReExportName, "Legacy.Export")
            && !TryReadLogicalPackageSourceSurfaceImportJsonSummary(
                manifestJson,
                2,
                0,
                rejected,
                rejectedName);
    }
}

