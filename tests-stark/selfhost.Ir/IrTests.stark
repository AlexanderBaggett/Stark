        funcs,
        asmMetadata);
    stack MirValueId returned = MirBlockReturnValue(blocks, MirBlockIdOf(8));
    stack MirValueId yPhi = MirOperandAOf(instrs, returned);
    stack MirValueId zPhi = MirOperandBOf(instrs, returned);
    stack MirValueId yCase0 = MirOperandAOf(instrs, yPhi);
    stack MirValueId zCase0 = MirOperandAOf(instrs, zPhi);
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 10
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 10
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 21
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(4)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(5)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(6)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(7)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(8)) == MirTermKind.Return
        && MirBlockTerminator(blocks, MirBlockIdOf(9)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(10)) == MirTermKind.Branch
        && MirOpcodeOf(instrs, returned) == MirOp.Add
        && MirOpcodeOf(instrs, yPhi) == MirOp.Phi
        && MirOpcodeOf(instrs, zPhi) == MirOp.Phi
        && MirOpcodeOf(instrs, yCase0) == MirOp.ConstInt
        && MirOpcodeOf(instrs, zCase0) == MirOp.ConstInt
        && MirImmediateOf(instrs, yCase0) == 4
        && MirImmediateOf(instrs, zCase0) == 5
        && zCase0.Index() < yCase0.Index()
        && MirPhiIncomingBlock0(instrs, yPhi) == MirBlockIdOf(4)
        && MirPhiIncomingBlock1(instrs, yPhi) == MirBlockIdOf(9)
        && MirPhiIncomingBlock0(instrs, zPhi) == MirBlockIdOf(4)
        && MirPhiIncomingBlock1(instrs, zPhi) == MirBlockIdOf(9);
}

