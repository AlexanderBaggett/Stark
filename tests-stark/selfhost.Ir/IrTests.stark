    stack mut u32[0 max] leftScalarMember = 0;
    stack mut u32[0 max] rightScalarMember = 0;
    stack mut u32[0 max] overlapScalarMember = 0;
    if (!TryAppendSourceSwitchScalarPatternDecisionNode(SourceResolvedFieldTypeCodeI32(), 0, 4, nodes, leftScalarNode)
        || !TryAppendSourceSwitchScalarPatternDecisionNode(SourceResolvedFieldTypeCodeI32(), 5, 9, nodes, rightScalarNode)
        || !TryAppendSourceSwitchScalarPatternDecisionNode(SourceResolvedFieldTypeCodeI32(), 3, 9, nodes, overlapScalarNode)
        || !TryAppendSourceSwitchPatternDecisionMember(1, leftScalarNode, nodes, members, leftScalarMember)
        || !TryAppendSourceSwitchPatternDecisionMember(1, rightScalarNode, nodes, members, rightScalarMember)
        || !TryAppendSourceSwitchPatternDecisionMember(1, overlapScalarNode, nodes, members, overlapScalarMember))
    {
        return false;
    }

    stack SourceSwitchAggregatePatternDescriptor leftAggregate =
        MakeSourceSwitchAggregatePatternDescriptor(77, 0, leftScalarMember, 1);
    stack SourceSwitchAggregatePatternDescriptor rightAggregate =
        MakeSourceSwitchAggregatePatternDescriptor(77, 0, rightScalarMember, 1);
    stack SourceSwitchAggregatePatternDescriptor overlappingAggregate =
        MakeSourceSwitchAggregatePatternDescriptor(77, 0, overlapScalarMember, 1);
    stack u32[0 max] leftAggregateRow = aggregateDescriptors.Add(leftAggregate);
    stack u32[0 max] rightAggregateRow = aggregateDescriptors.Add(rightAggregate);
    stack u32[0 max] overlappingAggregateRow = aggregateDescriptors.Add(overlappingAggregate);
    if (leftAggregateRow == 0 || rightAggregateRow == 0 || overlappingAggregateRow == 0)
    {
        return false;
    }

    stack mut u32[0 max] leftAggregateNode = 0;
    stack mut u32[0 max] rightAggregateNode = 0;
    stack mut u32[0 max] overlappingAggregateNode = 0;
    stack mut u32[0 max] leftAggregateMember = 0;
    stack mut u32[0 max] rightAggregateMember = 0;
    stack mut u32[0 max] overlappingAggregateMember = 0;
    if (!TryAppendSourceSwitchAggregatePatternDecisionNode(false, leftAggregateRow, aggregateDescriptors, nodes, leftAggregateNode)
        || !TryAppendSourceSwitchAggregatePatternDecisionNode(false, rightAggregateRow, aggregateDescriptors, nodes, rightAggregateNode)
        || !TryAppendSourceSwitchAggregatePatternDecisionNode(false, overlappingAggregateRow, aggregateDescriptors, nodes, overlappingAggregateNode)
        || !TryAppendSourceSwitchPatternDecisionMember(0, leftAggregateNode, nodes, members, leftAggregateMember)
        || !TryAppendSourceSwitchPatternDecisionMember(0, rightAggregateNode, nodes, members, rightAggregateMember)
        || !TryAppendSourceSwitchPatternDecisionMember(0, overlappingAggregateNode, nodes, members, overlappingAggregateMember))
    {
        return false;
    }

    return SourceSwitchPatternDecisionMemberSpansAreProvablyDisjoint(
            leftScalarMember,
            1,
            rightScalarMember,
            1,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors)
        && !SourceSwitchPatternDecisionMemberSpansAreProvablyDisjoint(
            leftScalarMember,
            1,
            overlapScalarMember,
            1,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors)
        && SourceSwitchAggregatePatternDecisionDescriptorsAreProvablyDisjoint(
            leftAggregate,
            rightAggregate,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors)
        && SourceSwitchPatternDecisionMemberSpansAreProvablyDisjoint(
            leftAggregateMember,
            1,
            rightAggregateMember,
            1,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors)
        && !SourceSwitchPatternDecisionMemberSpansAreProvablyDisjoint(
            leftAggregateMember,
            1,
            overlappingAggregateMember,
            1,
            nodes,
            members,
            aggregateDescriptors,
            listDescriptors);
}

