[Fact]
fn bool PackageTablesPreserveLocalSwitchStatementAssignmentThenPostLocalTerminalIf()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Classify(i64[min max] x) { var y = 0; switch (x) { case 0: y = 4; case 1: y = 10; case 2: y = 40; default: y = 20; } var z = y + 1; if z < 15 return z else return z + y }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId tailCondition = MirBlockCondValue(blocks, MirBlockIdOf(8));
    stack MirValueId postLocal = MirOperandAOf(instrs, tailCondition);
    stack MirValueId finalPhi = MirOperandAOf(instrs, postLocal);
    stack MirValueId thenReturn = MirBlockReturnValue(blocks, MirBlockIdOf(11));
    stack MirValueId elseReturn = MirBlockReturnValue(blocks, MirBlockIdOf(12));
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 12
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 12
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 18
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(4)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(5)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(6)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(7)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(8)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(9)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(10)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(11)) == MirTermKind.Return
        && MirBlockTerminator(blocks, MirBlockIdOf(12)) == MirTermKind.Return
        && MirBlockCondThen(blocks, MirBlockIdOf(8)) == MirBlockIdOf(11)
        && MirBlockCondElse(blocks, MirBlockIdOf(8)) == MirBlockIdOf(12)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(4)) == MirBlockIdOf(8)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(5)) == MirBlockIdOf(9)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(6)) == MirBlockIdOf(10)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(7)) == MirBlockIdOf(10)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(9)) == MirBlockIdOf(8)
        && MirBlockBranchTarget(blocks, MirBlockIdOf(10)) == MirBlockIdOf(9)
        && MirOpcodeOf(instrs, tailCondition) == MirOp.CmpLt
        && MirOpcodeOf(instrs, postLocal) == MirOp.Add
        && MirOpcodeOf(instrs, finalPhi) == MirOp.Phi
        && MirOpcodeOf(instrs, elseReturn) == MirOp.Add
        && thenReturn.Index() == postLocal.Index()
        && MirPhiIncomingBlock0(instrs, finalPhi) == MirBlockIdOf(4)
        && MirPhiIncomingBlock1(instrs, finalPhi) == MirBlockIdOf(9);
}

[Fact]
fn bool CompilesUnaryMinusFromAst()
{
    stack mut OwnedAscii negText = new();
    stack bool negOk = CompileFunctionToLlvm("fn neg(x) { return -x }", negText);
    stack mut OwnedAscii precText = new();
    stack bool precOk = CompileFunctionToLlvm("fn f(x, y) { return -x * y }", precText);
    return negOk
        && LlvmTextEquals(negText, "define i64 @main(i64 %p0) {\nb1:\n  %v1 = add i64 0, 0\n  %v3 = sub i64 %v1, %p0\n  ret i64 %v3\n}\n")
        && ClangVerifiesLlvmText(negText)
        && precOk && ClangVerifiesLlvmText(precText);
}

[Fact]
fn bool CompilesBooleanValuedIfExpression()
{
    stack mut OwnedAscii boolIf = new();
    stack bool boolOk = CompileIfExpressionToLlvm("if x < y x < 1 else y < 1", boolIf);
    stack mut OwnedAscii mixed = new();
    return boolOk && ClangVerifiesLlvmText(boolIf)
        && !CompileIfExpressionToLlvm("if x < y x + 1 else y < 1", mixed);
}

[Fact]
fn bool AstControlFlowCompilesToObjectViaClang()
{
    stack mut OwnedAscii ifText = new();
    stack bool ifOk = CompileIfExpressionToLlvm("if a < b a + 1 else b - 1", ifText);
    stack mut OwnedAscii whileText = new();
    stack bool whileOk = CompileWhileLoopToLlvm("var i = 0; while i < 5 { i = i + 1 } return i", whileText);
    stack mut OwnedAscii localsText = new();
    stack bool localsOk = CompileFunctionWithLocalsToLlvm("fn g(a) { var x = a + 1; var y = x * 2; return y + a }", localsText);
    return ifOk && ClangVerifiesLlvmText(ifText)
        && whileOk && ClangVerifiesLlvmText(whileText)
        && localsOk && ClangVerifiesLlvmText(localsText);
}

[Fact]
fn bool AstModuleCompilesToObjectViaClang()
{
    return CompileModuleSourceProducesObject("fn add(a, b) { return a + b } fn lt(a, b) { return a < b } fn main() { var s = add(3, 4); return s + lt(1, 2) }");
}

[Fact]
fn bool MirFunctionWellFormednessIsVerified()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId good = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack MirFunction goodFn = funcs.Get(good.Index());
    stack bool goodOk = MirFunctionWellFormed(instrs, blocks, goodFn);
    stack MirFuncId badEntry = MirDefineFunction(funcs, MirBlockIdOf(99), blk, 1, a, 3);
    stack MirFunction badEntryFn = funcs.Get(badEntry.Index());
    stack bool badEntryRejected = !MirFunctionWellFormed(instrs, blocks, badEntryFn);
    stack mut MirBlock emptyBlock = new();
    stack u32[0 max] ub = blocks.Add(emptyBlock);
    stack MirFuncId badBlock = MirDefineFunction(funcs, MirBlockIdOf(ub), MirBlockIdOf(ub), 1, a, 3);
    stack MirFunction badBlockFn = funcs.Get(badBlock.Index());
    stack bool badBlockRejected = !MirFunctionWellFormed(instrs, blocks, badBlockFn);
    return goodOk && badEntryRejected && badBlockRejected;
}

[Fact]
fn bool VerifiedModuleEmissionGatesMalformedFunctions()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack MirValueId a = MirConstInt(instrs, 7);
    stack MirBlockId blk = MirReturnBlock(blocks, a);
    stack MirFuncId good = MirDefineFunction(funcs, blk, blk, 1, a, 1);
    stack mut OwnedAscii okSink = new();
    stack bool okEmit = EmitLlvmModuleVerified(instrs, blocks, funcs, okSink);
    stack mut MirBlock emptyBlock = new();
    stack u32[0 max] ub = blocks.Add(emptyBlock);
    stack MirFuncId bad = MirDefineFunction(funcs, MirBlockIdOf(ub), MirBlockIdOf(ub), 1, a, 1);
    stack mut OwnedAscii badSink = new();
    stack bool badRejected = !EmitLlvmModuleVerified(instrs, blocks, funcs, badSink);
    return okEmit && badRejected;
}
