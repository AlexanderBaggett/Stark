        && ClangVerifiesLlvmText(s)
        && !CompileModuleFromAst("fn i64[14 121] classify(i64[min max] x) { var y = 0; switch (x) { case 0: y = 4; case 1: y = 10; case 2: y = 40; default: y = 20; } var z = y + 1; var w = z * 2; return w + y } fn main() { return classify(1) }", tooNarrow);
}

[Fact]
fn bool CompilesBooleanLocalSwitchStatementAssignmentThenMultiplePostLocalsFromAst()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn i64[0 1] classify(i64[min max] x) { var y = 0 == 0; switch (x) { case 0: y = x == 0; case 1: y = x < 0; default: y = x == 2; } var z = y == (x == 0); var w = z == y; return w } fn main() { return classify(1) }", s);
    stack mut OwnedAscii tooNarrow = new();
    return ok
        && System.Text.Contains(s.View(), "define internal dso_local range(i64 0, 2) i64 @f1(i64 %p0)")
        && System.Text.Contains(s.View(), " phi i1 ")
        && System.Text.Contains(s.View(), "icmp eq i1")
        && System.Text.Contains(s.View(), "zext i1")
        && ClangVerifiesLlvmText(s)
        && !CompileModuleFromAst("fn i64[1 1] classify(i64[min max] x) { var y = 0 == 0; switch (x) { case 0: y = x == 0; case 1: y = x < 0; default: y = x == 2; } var z = y == (x == 0); var w = z == y; return w } fn main() { return classify(1) }", tooNarrow);
}

