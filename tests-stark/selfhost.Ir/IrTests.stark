[Fact]
fn bool AstCallLoweringEmitsCallWithArgument()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] arg = MakeIntLit(nodes, 5);
    stack u32[0 max] call = MakeCall(nodes, 1, 1, arg, 0, 0, 0);
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId value = LowerExprNode(nodes, call, instrs);
    stack mut OwnedAscii disasm = new();
    stack MemoryStatus status = EmitMirInstructions(instrs, 1, (u32[0 max])instrs.Count(), disasm);
    return LlvmTextEquals(disasm, "v1 = const 5\nv2 = call f1(v1)\n");
}

[Fact]
fn bool SourceEnumExpressionNodesPreserveOwnerFacts()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] tagged = MakeEnumVariant(nodes, TypeIdOf(3), 1);
    stack u32[0 max] payload = MakeIntLit(nodes, 99);
    stack u32[0 max] inserted = MakeEnumPayloadInsert(nodes, TypeIdOf(3), 1, 0, tagged, payload, SourceResolvedFieldTypeCodeI32());
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut u32[0 max] taggedOwner = 0;
    stack mut u32[0 max] insertedOwner = 0;
    return TypeOfNodeWithLocals(nodes, tagged, localTypes) == ExprType.EnumType
        && TypeOfNodeWithLocals(nodes, inserted, localTypes) == ExprType.EnumType
        && TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, tagged, localTypes, taggedOwner)
        && TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, inserted, localTypes, insertedOwner)
        && taggedOwner == 3
        && insertedOwner == 3;
}

[Fact]
fn bool SourceTryExpressionNodesKeepOperandSeparate()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] operand = MakeIntLit(nodes, 7);
    stack u32[0 max] tryNode = MakeTry(nodes, operand);
    stack mut u32[0 max] readOperand = 0;
    return TryGetSourceTryOperandNode(nodes, tryNode, readOperand)
        && readOperand == operand
        && TypeOfNode(nodes, tryNode) == ExprType.ErrorType;
}

