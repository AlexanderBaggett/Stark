    return ok
        && System.Text.Contains(sink.View(), "define i32 @main(ptr writable %p0, i1 %p1, i1 %p2, i1 %p3)")
        && System.Text.Contains(sink.View(), "store i32 11, ptr %p0, align 4")
        && System.Text.Contains(sink.View(), "store i32 13, ptr %p0, align 4")
        && System.Text.Contains(sink.View(), "store i32 17, ptr %p0, align 4")
        && System.Text.Contains(sink.View(), "store i32 19, ptr %p0, align 4")
        && System.Text.Contains(sink.View(), "store i32 23, ptr %p0, align 4")
        && System.Text.Contains(sink.View(), "store i32 29, ptr %p0, align 4")
        && System.Text.Contains(sink.View(), "load i32, ptr %p0, align 4")
        && ClangVerifiesLlvmText(sink);
