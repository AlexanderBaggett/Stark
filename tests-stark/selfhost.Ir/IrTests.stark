        && LlvmTextEquals(sink, "define i64 @main(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool EmitsLlvmScopedNoAliasMetadataForParamRootedPointerMemoryOps()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId left = MirParamTyped(instrs, MirType.Ptr, 0);
    stack MirValueId right = MirParamTyped(instrs, MirType.Ptr, 1);
    stack MirValueId index = MirConstIntTyped(instrs, MirType.I64, 1);
    stack MirValueId value = MirConstIntTyped(instrs, MirType.I32, 7);
    stack MirValueId leftElement = MirPtrIndexOffset(instrs, left, index, 4, 0, 4);
    stack MirValueId rightElement = MirPtrIndexOffset(instrs, right, index, 4, 0, 4);
    stack MirValueId store = MirStorePtrAlignedTyped(instrs, MirType.I32, leftElement, value, 4);
    stack MirValueId load = MirLoadPtrAlignedTyped(instrs, MirType.I32, rightElement, 4);
    stack MirBlockId entry = MirReturnBlock(blocks, load);

    stack mut IrTable<u32[0 max]> noTailCallees = new();
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    stack mut IrTable<DistinctStoragePair> separateStorageFacts = new();
    if (!AddDistinctStoragePairIfAbsent(separateStorageFacts, 0, 1))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFactsCore(
        instrs,
        noTailCallees,
        noFunctionEffectFacts,
        noFunctionCallContractFacts,
        noFunctionLinkageFacts,
        noFunctionCallingConventionFacts,
        blocks,
        "scoped",
        false,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        separateStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        NoFunctionEffectFacts(),
        2,
        entry.Index(),
        1,
        8,
        sink))
    {
        case MemoryStatus.Ok:
            return store.IsValid()
                && LlvmTextEquals(sink, "define i32 @scoped(ptr %p0, ptr %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v3 = add i64 0, 1\n  %v4 = add i32 0, 7\n  %v5.scale = mul i64 %v3, 4\n  %v5 = getelementptr inbounds i8, ptr %p0, i64 %v5.scale\n  %v6.scale = mul i64 %v3, 4\n  %v6 = getelementptr inbounds i8, ptr %p1, i64 %v6.scale\n  store i32 %v4, ptr %v5, align 4, !alias.scope !204096, !noalias !208192\n  %v8 = load i32, ptr %v6, align 4, !alias.scope !204097, !noalias !208193\n  ret i32 %v8\n}\n!200000 = distinct !{!200000, !\"stark.noalias.mir\"}\n!200001 = distinct !{!200001, !200000, !\"stark.noalias.param.0\"}\n!200002 = distinct !{!200002, !200000, !\"stark.noalias.param.1\"}\n!204096 = !{!200001}\n!208192 = !{!200002}\n!204097 = !{!200002}\n!208193 = !{!200001}\n")
                && ClangVerifiesLlvmText(sink);
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmIndependentLoopAccessGroupMetadataForIndexedPointerMemoryOps()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId pointer = MirParamTyped(instrs, MirType.Ptr, 0);
    stack MirValueId index = MirConstIntTyped(instrs, MirType.I64, 1);
    stack MirValueId value = MirConstIntTyped(instrs, MirType.I32, 7);
    stack MirValueId element = MirPtrIndexOffset(instrs, pointer, index, 4, 0, 4);
    stack MirValueId store = MirStorePtrAlignedTyped(instrs, MirType.I32, element, value, 4);
    stack MirValueId load = MirLoadPtrAlignedTyped(instrs, MirType.I32, element, 4);
    stack MirBlockId entry = MirBranchBlock(blocks, MirBlockIdOf(2));
    stack MirBlockId loop = MirIndependentLoopBackedgeBlock(blocks, MirBlockIdOf(2));
    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(entry.Index(), 1, 0));
    stack u32[0 max] loopRange = ranges.Add(MakeBlockEmit(loop.Index(), 1, (u32[0 max])instrs.Count()));
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmBlocksWithRangeFacts(
        instrs,
        blocks,
        "loop_access",
        returnFacts,
        paramFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        1,
        ranges,
        sink))
    {
        case MemoryStatus.Ok:
            return store.IsValid()
                && load.IsValid()
                && entryRange == 1
                && loopRange == 2
                && System.Text.Contains(sink.View(), "store i32 %v3, ptr %v4, align 4, !llvm.access.group !")
                && System.Text.Contains(sink.View(), "%v6 = load i32, ptr %v4, align 4, !llvm.access.group !")
                && System.Text.Contains(sink.View(), "br label %b2, !llvm.loop !")
                && System.Text.Contains(sink.View(), "llvm.loop.vectorize.enable")
                && System.Text.Contains(sink.View(), "llvm.loop.parallel_accesses")
                && System.Text.Contains(sink.View(), " = distinct !{}")
                && ClangVerifiesLlvmText(sink);
        case MemoryStatus.Err(var error):
            return false;
    }
}

fn ParamAbiFacts PointerBorrowAbiForNoAliasCallTest()
{
    stack mut ParamAbiFacts abi = new();
    abi.IsPointer = true;
    abi.CaptureKind = 1;
    abi.ReadOnly = true;
    return abi;
}

[Fact]
fn bool EmitsLlvmScopedNoAliasMetadataForDirectPointerCall()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId left = MirParamTyped(instrs, MirType.Ptr, 0);
    stack MirValueId right = MirParamTyped(instrs, MirType.Ptr, 1);
    stack MirValueId call = MirCall1(instrs, MirFuncIdOf(1), left);
    stack MirBlockId entry = MirReturnBlock(blocks, call);

    stack mut IrTable<u32[0 max]> noTailCallees = new();
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> functionCallContractFacts = new();
    stack mut FunctionCallContractFacts calleeFacts = new();
    calleeFacts.ParamCount = 1;
    calleeFacts.Param0 = PointerBorrowAbiForNoAliasCallTest();
    if (functionCallContractFacts.Add(calleeFacts) == 0)
    {
        return false;
    }

    stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    stack mut IrTable<DistinctStoragePair> separateStorageFacts = new();
    if (!AddDistinctStoragePairIfAbsent(separateStorageFacts, 0, 1))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFactsCore(
        instrs,
        noTailCallees,
        noFunctionEffectFacts,
        functionCallContractFacts,
        noFunctionLinkageFacts,
        noFunctionCallingConventionFacts,
        blocks,
        "scoped_call",
        false,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        separateStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        NoFunctionEffectFacts(),
        2,
        entry.Index(),
        1,
        3,
        sink))
    {
        case MemoryStatus.Ok:
            return right.IsValid()
                && LlvmTextEquals(sink, "define i64 @scoped_call(ptr %p0, ptr %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v3 = call i64 @f1(ptr captures(none) readonly %p0), !alias.scope !212006, !noalias !212007\n  ret i64 %v3\n}\n!200000 = distinct !{!200000, !\"stark.noalias.mir\"}\n!200001 = distinct !{!200001, !200000, !\"stark.noalias.param.0\"}\n!200002 = distinct !{!200002, !200000, !\"stark.noalias.param.1\"}\n!204096 = !{!200001}\n!208192 = !{!200002}\n!204097 = !{!200002}\n!208193 = !{!200001}\n!212006 = !{!200001}\n!212007 = !{!200002}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmScopedNoAliasMetadataForTailPointerCall()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId left = MirParamTyped(instrs, MirType.Ptr, 0);
    stack MirValueId right = MirParamTyped(instrs, MirType.Ptr, 1);
    stack MirValueId call = MirTailCall1(instrs, MirFuncIdOf(1), left);
    stack MirBlockId entry = MirTailCallBlock(blocks, call);

    stack mut IrTable<u32[0 max]> tailFlags = new();
    stack u32[0 max] f1Tail = tailFlags.Add(1);
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> functionCallContractFacts = new();
    stack mut FunctionCallContractFacts calleeFacts = new();
    calleeFacts.ParamCount = 1;
    calleeFacts.Param0 = PointerBorrowAbiForNoAliasCallTest();
    if (functionCallContractFacts.Add(calleeFacts) == 0)
    {
        return false;
    }

    stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    stack mut IrTable<DistinctStoragePair> separateStorageFacts = new();
    if (!AddDistinctStoragePairIfAbsent(separateStorageFacts, 0, 1))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFactsCore(
        instrs,
        tailFlags,
        noFunctionEffectFacts,
        functionCallContractFacts,
        noFunctionLinkageFacts,
        noFunctionCallingConventionFacts,
        blocks,
        "scoped_tail",
        true,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        separateStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        NoFunctionEffectFacts(),
        2,
        entry.Index(),
        1,
        3,
        sink))
    {
        case MemoryStatus.Ok:
            return right.IsValid()
                && f1Tail == 1
                && LlvmTextEquals(sink, "define tailcc i64 @scoped_tail(ptr %p0, ptr %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v3 = musttail call tailcc i64 @f1(ptr captures(none) readonly %p0), !alias.scope !212006, !noalias !212007\n  ret i64 %v3\n}\n!200000 = distinct !{!200000, !\"stark.noalias.mir\"}\n!200001 = distinct !{!200001, !200000, !\"stark.noalias.param.0\"}\n!200002 = distinct !{!200002, !200000, !\"stark.noalias.param.1\"}\n!204096 = !{!200001}\n!208192 = !{!200002}\n!204097 = !{!200002}\n!208193 = !{!200001}\n!212006 = !{!200001}\n!212007 = !{!200002}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool CompileFunctionWholeOverlapSuppressesSeparateStorageAssume()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionToLlvm("fn i64 read2(borrow i32 left, borrow i32 right) where overlap(left, right) { return 1 }", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool CompileFunctionSubrangeDisjointDoesNotBecomeSeparateStorageAssume()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionToLlvm("fn i64 read2(borrow i32 left, borrow i32 right, i64 count) where overlap(left, right), disjoint(left[0, count], right[0, count]) { return 1 }", sink);
    return ok
        && !System.Text.Contains(sink.View(), "separate_storage");
}

[Fact]
fn bool CompileFunctionPointerAttributesCoexistWithScalarRangeFacts()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionToLlvm("fn i64[0 10] mixed(i64[1 5] x, borrow i32 ptr) { return x }", sink);
    return ok
        && LlvmTextEquals(sink, "define range(i64 0, 11) i64 @main(i64 range(i64 1, 6) %p0, ptr captures(none) readonly %p1) {\nb1:\n  ret i64 %p0\n}\n");
}

[Fact]
fn bool CompileFunctionRejectsPointerParamsAsIntegerValues()
{
    stack mut OwnedAscii borrowValue = new();
    stack mut OwnedAscii outValue = new();
    return !CompileFunctionToLlvm("fn i64 bad(borrow i32 value) { return value }", borrowValue)
        && !CompileFunctionToLlvm("fn i64 bad(out i32 value) { return value }", outValue);
}

[Fact]
fn bool CompileModulePointerParametersLowerGranularAttributes()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn i64 read(borrow i32 value) { return 1 } fn i64 main() { return 0 }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1(ptr captures(none) readonly %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\ndefine internal dso_local i64 @f2() {\nb1:\n  %v1 = add i64 0, 0\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool CompileModuleWholePointerParamsEmitSeparateStorageAssume()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn i64 read2(borrow i32 left, borrow i32 right) { return 1 } fn i64 main() { return 0 }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\ndefine internal dso_local i64 @f2() {\nb1:\n  %v1 = add i64 0, 0\n  ret i64 %v1\n}\n")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileModulePointerCallArgumentsPreserveAbiAndAliasFacts()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn i64 touch(borrow i32 left, borrow i32 right) { return 1 } fn i64 main(borrow i32 left, borrow i32 right) { return touch(left, right) }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\ndefine internal dso_local i64 @f2(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v3 = call i64 @f1(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1)\n  ret i64 %v3\n}\n")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileModuleTailPointerCallArgumentsPreserveAbiAndAliasFacts()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("tail fn touch(borrow i32 left, borrow i32 right) { return 1 } tail fn bounce(borrow i32 left, borrow i32 right) { become touch(left, right) }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define internal dso_local tailcc i64 @f1(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1)")
        && System.Text.Contains(sink.View(), "%v3 = musttail call tailcc i64 @f1(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1)")
        && System.Text.Contains(sink.View(), "call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v3 = musttail")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileModulePointerCallArgumentsRequireCallerAliasProof()
{
    stack mut OwnedAscii overlapped = new();
    stack mut OwnedAscii repeated = new();
    stack mut OwnedAscii calleeOverlap = new();
    return !CompileModuleFromAst("fn i64 touch(borrow i32 left, borrow i32 right) { return 1 } fn i64 main(borrow i32 left, borrow i32 right) where overlap(left, right) { return touch(left, right) }", overlapped)
        && !CompileModuleFromAst("fn i64 touch(borrow i32 left, borrow i32 right) { return 1 } fn i64 main(borrow i32 left) { return touch(left, left) }", repeated)
        && CompileModuleFromAst("fn i64 touch(borrow i32 left, borrow i32 right) where overlap(left, right) { return 1 } fn i64 main(borrow i32 left, borrow i32 right) where overlap(left, right) { return touch(left, right) }", calleeOverlap);
}

[Fact]
fn bool CompileModulePointerCallArgumentKindsMustMatchCallee()
{
    stack mut OwnedAscii pointerToScalar = new();
    stack mut OwnedAscii scalarToPointer = new();
    return !CompileModuleFromAst("fn i64 id(i64 value) { return value } fn i64 main(borrow i32 value) { return id(value) }", pointerToScalar)
        && !CompileModuleFromAst("fn i64 touch(borrow i32 value) { return 1 } fn i64 main() { return touch(1) }", scalarToPointer);
}

[Fact]
fn bool CompileModuleFiniteLawLowersNumberedFunctionEffectAttributes()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("finite law fn id(x) { return x } fn main() { return id(7) }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1(i64 %p0) memory(none) nosync nofree willreturn mustprogress norecurse {\nb1:\n  ret i64 %p0\n}\ndefine internal dso_local i64 @f2() {\nb1:\n  %v1 = add i64 0, 7\n  %v2 = call i64 @f1(i64 range(i64 7, 8) %v1) memory(none) nosync nofree willreturn mustprogress norecurse\n  ret i64 %v2\n}\n")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileModuleFiniteLawBranchLowersBlockEffectAttributes()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("finite law fn pick(x, y) { if x < y return x else return y }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1(i64 %p0, i64 %p1) memory(none) nosync nofree willreturn mustprogress norecurse {\nb1:\n  %v3 = icmp slt i64 %p0, %p1\n  br i1 %v3, label %b2, label %b3\nb2:\n  ret i64 %p0\nb3:\n  ret i64 %p1\n}\n");
}

[Fact]
fn bool CompileModuleFiniteEffectsPropagateThroughProvenDirectCalls()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("finite fn one() { return 1 } finite fn two() { return one() }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1() willreturn mustprogress norecurse {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\ndefine internal dso_local i64 @f2() willreturn mustprogress norecurse {\nb1:\n  %v1 = call i64 @f1() willreturn mustprogress norecurse\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool CompileModuleLawEffectsPropagateThroughProvenDirectCalls()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("law fn id(x) { return x } law fn wrap(x) { return id(x) }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1(i64 %p0) memory(none) nosync nofree norecurse {\nb1:\n  ret i64 %p0\n}\ndefine internal dso_local i64 @f2(i64 %p0) memory(none) nosync nofree norecurse {\nb1:\n  %v2 = call i64 @f1(i64 %p0) memory(none) nosync nofree norecurse\n  ret i64 %v2\n}\n");
}

[Fact]
fn bool CompileModuleFfiCallingConventionsReachLlvmText()
{
    stack mut OwnedAscii win64 = new();
    stack mut OwnedAscii sysv = new();
    stack bool win64Ok = CompileModuleFromAst("unsafe ffi(win64) fn abi(x) { return x } fn main(x) { return abi(x) }", win64);
    stack bool sysvOk = CompileModuleFromAst("unsafe ffi(sysv) fn abi(x) { return x } fn main(x) { return abi(x) }", sysv);
    return win64Ok
        && sysvOk
        && System.Text.Contains(win64.View(), "define internal dso_local win64cc i64 @f1(i64 %p0)")
        && System.Text.Contains(win64.View(), "%v2 = call win64cc i64 @f1(i64 %p0)")
        && System.Text.Contains(sysv.View(), "define internal dso_local x86_64_sysvcc i64 @f1(i64 %p0)")
        && System.Text.Contains(sysv.View(), "%v2 = call x86_64_sysvcc i64 @f1(i64 %p0)");
}

[Fact]
fn bool CompileModuleSourceVisibilityControlsLlvmLinkage()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn hidden(x) { return x } internal fn helper(x) { return hidden(x) } public fn api(x) { return helper(x) } export fn entry(x) { return api(x) }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define internal dso_local i64 @f1(i64 %p0)")
        && System.Text.Contains(sink.View(), "define internal dso_local i64 @f2(i64 %p0)")
        && System.Text.Contains(sink.View(), "define i64 @f3(i64 %p0)")
        && System.Text.Contains(sink.View(), "define i64 @f4(i64 %p0)")
        && !System.Text.Contains(sink.View(), "define internal dso_local i64 @f3")
        && !System.Text.Contains(sink.View(), "define internal dso_local i64 @f4")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileModuleTailFiniteLawCallSitesLowerEffectAttributes()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("tail finite law fn id(x) { return x } tail finite law fn bounce(x) { become id(x) } fn main() { return bounce(7) }", sink);
    return ok
        && System.Text.Contains(sink.View(), "%v2 = musttail call tailcc i64 @f1(i64 %p0) memory(none) nosync nofree willreturn mustprogress norecurse\n  ret i64 %v2")
        && System.Text.Contains(sink.View(), "%v2 = call tailcc i64 @f2(i64 range(i64 7, 8) %v1) memory(none) nosync nofree willreturn mustprogress norecurse")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileModuleForwardDirectCallsUsePrecomputedEffectFacts()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("finite law fn wrap(x) { return id(x) } fn main() { return wrap(7) } finite law fn id(x) { return x }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define internal dso_local i64 @f1(i64 %p0) memory(none) nosync nofree willreturn mustprogress norecurse")
        && System.Text.Contains(sink.View(), "%v2 = call i64 @f3(i64 %p0) memory(none) nosync nofree willreturn mustprogress norecurse")
        && System.Text.Contains(sink.View(), "%v2 = call i64 @f1(i64 range(i64 7, 8) %v1) memory(none) nosync nofree willreturn mustprogress norecurse")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool EmitsLlvmTailCallTerminator()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<u32[0 max]> tailFlags = new();
    stack u32[0 max] f1Tail = tailFlags.Add(1);
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId tail = MirTailCall1(instrs, MirFuncIdOf(1), p0);
    stack MirBlockId entry = MirTailCallBlock(blocks, tail);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParamsTail(instrs, tailFlags, blocks, "fwd", 1, entry.Index(), 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define tailcc i64 @fwd(i64 %p0) {\nb1:\n  %v2 = musttail call tailcc i64 @f1(i64 %p0)\n  ret i64 %v2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmTypedTailCallTerminator()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<u32[0 max]> tailFlags = new();
    stack u32[0 max] f1Tail = tailFlags.Add(1);
    stack MirValueId p0 = MirParamTyped(instrs, MirType.I32, 0);
    stack MirValueId tail = MirTailCall1Typed(instrs, MirType.I32, MirFuncIdOf(1), p0);
    stack MirBlockId entry = MirTailCallBlock(blocks, tail);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParamsTail(instrs, tailFlags, blocks, "fwd_i32", 1, entry.Index(), 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return MirValueType(instrs, tail.Index()) == MirType.I32
                && LlvmTextEquals(sink, "define tailcc i32 @fwd_i32(i32 %p0) {\nb1:\n  %v2 = musttail call tailcc i32 @f1(i32 %p0)\n  ret i32 %v2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool TailCallTerminatorRequiresTailCallableCallee()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId tail = MirTailCall(instrs, MirFuncIdOf(1));
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId entry = MirTailCallBlock(blocks, tail);
    stack mut IrTable<u32[0 max]> noTailFlags = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParamsTail(instrs, noTailFlags, blocks, "bad", 0, entry.Index(), 1, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define tailcc i64 @bad() {\nb1:\n  unreachable\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmOrdinaryCallToTailCallableWithTailcc()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<u32[0 max]> tailFlags = new();
    stack u32[0 max] f1Tail = tailFlags.Add(1);
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId result = MirCall1(instrs, MirFuncIdOf(1), p0);
    stack MirBlockId entry = MirReturnBlock(blocks, result);
    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, 2));
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmBlocksWithTailCallees(instrs, tailFlags, blocks, "caller", false, 1, ranges, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @caller(i64 %p0) {\nb1:\n  %v2 = call tailcc i64 @f1(i64 %p0)\n  ret i64 %v2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirComparisonRecordsOpcodeAndOperands()
{
    // Comparison instructions record their opcode and both operands.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 3);
    stack MirValueId b = MirConstInt(instrs, 4);
    stack MirValueId eq = MirCmpEq(instrs, a, b);
    stack MirValueId ge = MirCmpGe(instrs, a, b);
    stack MirValueId opA = MirOperandAOf(instrs, eq);
    stack MirValueId opB = MirOperandBOf(instrs, eq);
    return MirOpcodeOf(instrs, eq) == MirOp.CmpEq
        && MirOpcodeOf(instrs, ge) == MirOp.CmpGe
        && MirValueType(instrs, eq.Index()) == MirType.I1
        && MirValueType(instrs, ge.Index()) == MirType.I1
        && opA.Equals(a)
        && opB.Equals(b);
}

[Fact]
fn bool EmitsLlvmAllComparisonPredicates()
{
    // Each comparison opcode lowers to its LLVM `icmp` predicate (signed).
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId a = MirConstInt(instrs, 1);
    stack MirValueId b = MirConstInt(instrs, 2);
    stack MirValueId e1 = MirCmpEq(instrs, a, b);
    stack MirValueId e2 = MirCmpNe(instrs, a, b);
    stack MirValueId e3 = MirCmpLt(instrs, a, b);
    stack MirValueId e4 = MirCmpLe(instrs, a, b);
    stack MirValueId e5 = MirCmpGt(instrs, a, b);
    stack MirValueId e6 = MirCmpGe(instrs, a, b);
    stack MirBlockId entry = MirReturnBlock(blocks, a);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "cmps", 0, entry.Index(), 1, 8, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @cmps() {\nb1:\n  %v1 = add i64 0, 1\n  %v2 = add i64 0, 2\n  %v3 = icmp eq i64 %v1, %v2\n  %v4 = icmp ne i64 %v1, %v2\n  %v5 = icmp slt i64 %v1, %v2\n  %v6 = icmp sle i64 %v1, %v2\n  %v7 = icmp sgt i64 %v1, %v2\n  %v8 = icmp sge i64 %v1, %v2\n  ret i64 %v1\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmWellTypedConditionalBranch()
{
    // A comparison yields an i1 that feeds a CondBranch — `br i1 %vN` is now
    // well-typed (the condition register is a genuine icmp result, not an i64).
    // `fn cmp(x, y) { if x < y then 1 else 0 }`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId x = MirParam(instrs, 0);
    stack MirValueId y = MirParam(instrs, 1);
    stack MirValueId lt = MirCmpLt(instrs, x, y);
    stack MirValueId tv = MirConstInt(instrs, 1);
    stack MirValueId ev = MirConstInt(instrs, 0);
    stack MirBlockId thenB = MirReturnBlock(blocks, tv);
    stack MirBlockId elseB = MirReturnBlock(blocks, ev);
    stack MirBlockId entry = MirCondBlock(blocks, lt, thenB, elseB);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "cmp", 2, entry.Index(), 1, 3, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @cmp(i64 %p0, i64 %p1) {\nb3:\n  %v3 = icmp slt i64 %p0, %p1\n  br i1 %v3, label %b1, label %b2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool ByteBufferRoundTripsU32()
{
    // A u32 round-trips through 4 little-endian bytes.
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 305419896);
    WriteU32(buf, 0);
    return buf.Count() == 8
        && ReadU32(buf, 1) == 305419896
        && ReadU32(buf, 5) == 0;
}

[Fact]
fn bool ByteBufferRoundTripsU32Max()
{
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 4294967295);
    return buf.Count() == 4
        && buf.Get(1) == 255
        && buf.Get(2) == 255
        && buf.Get(3) == 255
        && buf.Get(4) == 255
        && ReadU32(buf, 1) == 4294967295;
}

[Fact]
fn bool ByteBufferRoundTripsI64()
{
    // An i64 round-trips through 8 little-endian bytes, including a negative value.
    stack mut IrTable<u8[0 max]> buf = new();
    WriteI64(buf, 9223372036854775807);
    WriteI64(buf, -5);
    return buf.Count() == 16
        && ReadI64(buf, 1) == 9223372036854775807
        && ReadI64(buf, 9) == -5;
}

[Fact]
fn bool BinaryRoundTripsBlocks()
{
    // The block table survives a binary round-trip: terminator kinds and slots.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 1);
    stack MirBlockId retB = MirReturnBlock(blocks, v);
    stack MirBlockId brB = MirBranchBlock(blocks, retB);
    stack MirBlockId condB = MirCondBlock(blocks, v, retB, brB);
    stack MirValueId tail = MirTailCall1(instrs, MirFuncIdOf(1), v);
    stack MirBlockId tailB = MirTailCallBlock(blocks, tail);
    stack MirBlockId voidB = MirReturnVoidBlock(blocks);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeBlocks(blocks, buf);
    stack mut IrTable<MirBlock> back = new();
    DeserializeBlocks(buf, back);
    stack MirBlockId brTarget = MirBlockBranchTarget(back, MirBlockIdOf(2));
    stack MirBlockId condThen = MirBlockCondThen(back, MirBlockIdOf(3));
    stack MirBlockId condElse = MirBlockCondElse(back, MirBlockIdOf(3));
    stack MirValueId tailPayload = MirBlockTailCallValue(back, MirBlockIdOf(4));
    return back.Count() == 5
        && MirBlockTerminator(back, MirBlockIdOf(1)) == MirTermKind.Return
        && MirBlockTerminator(back, MirBlockIdOf(2)) == MirTermKind.Branch
        && MirBlockTerminator(back, MirBlockIdOf(3)) == MirTermKind.CondBranch
        && MirBlockTerminator(back, MirBlockIdOf(4)) == MirTermKind.TailCall
        && MirBlockTerminator(back, MirBlockIdOf(5)) == MirTermKind.ReturnVoid
        && brTarget.Equals(MirBlockIdOf(1))
        && condThen.Equals(MirBlockIdOf(1))
        && condElse.Equals(MirBlockIdOf(2))
        && tailPayload.Equals(tail)
        && !MirBlockHasIndependentLoopBackedge(back, MirBlockIdOf(2))
        && voidB.Index() == 5;
}

[Fact]
fn bool BinaryRoundTripsIndependentLoopBackedgeFlag()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 1);
    stack MirBlockId retB = MirReturnBlock(blocks, v);
    stack MirBlockId indB = MirIndependentLoopBackedgeBlock(blocks, retB);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeBlocks(blocks, buf);
    stack mut IrTable<MirBlock> back = new();
    DeserializeBlocks(buf, back);
    return buf.Count() == 38
        && back.Count() == 2
        && indB.Index() == 2
        && MirBlockTerminator(back, MirBlockIdOf(2)) == MirTermKind.Branch
        && MirBlockBranchTarget(back, MirBlockIdOf(2)) == MirBlockIdOf(1)
        && MirBlockHasIndependentLoopBackedge(back, MirBlockIdOf(2))
        && !MirBlockHasIndependentLoopBackedge(back, MirBlockIdOf(1));
}

[Fact]
fn bool BinaryRoundTripsFunctions()
{
    // A function record survives a binary round-trip: entry + owned ranges.
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, MirBlockIdOf(2), MirBlockIdOf(2), 3, MirValueIdOf(5), 7);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeFunctions(funcs, buf);
    stack mut IrTable<MirFunction> back = new();
    DeserializeFunctions(buf, back);
    stack MirBlockId entry = MirFunctionEntry(back, MirFuncIdOf(1));
    return back.Count() == 1
        && entry.Equals(MirBlockIdOf(2))
        && MirFunctionBlockCount(back, MirFuncIdOf(1)) == 3
        && MirFunctionInstrCount(back, MirFuncIdOf(1)) == 7;
}

[Fact]
fn bool BinaryRoundTripsGlobals()
{
    // The globals table survives a binary round-trip, including typed initializers.
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g1 = MirDefineGlobal(globals, 100);
    stack u32[0 max] g2 = MirDefineGlobal(globals, -7);
    stack u32[0 max] g3 = MirDefineGlobalTyped(globals, MirType.I32, 55);
    stack u32[0 max] g4 = MirDefineGlobalTyped(globals, MirType.I8, -12);
    stack u32[0 max] g5 = MirDefineGlobalTyped(globals, MirType.I16, 32000);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeGlobals(globals, buf);
    stack mut IrTable<MirGlobal> back = new();
    DeserializeGlobals(buf, back);
    return back.Count() == 5
        && buf.Count() == 49
        && MirGlobalType(back, 1) == MirType.I64
        && MirGlobalType(back, 3) == MirType.I32
        && MirGlobalType(back, 4) == MirType.I8
        && MirGlobalType(back, 5) == MirType.I16
        && MirGlobalInitialValue(back, 1) == 100
        && MirGlobalInitialValue(back, 2) == -7
        && MirGlobalInitialValue(back, 3) == 55
        && MirGlobalInitialValue(back, 4) == -12
        && MirGlobalInitialValue(back, 5) == 32000;
}

[Fact]
fn bool LowersReturnIntSourceToLlvm()
{
    // The first source -> MIR -> LLVM thread (toward bootstrap #33): lex the source
    // `return 42`, find the integer literal, lower to MIR (const + return), and emit
    // the LLVM `@main` function.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnIntToLlvm("return 42", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 42\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool LowersReturnIntRejectsNoLiteral()
{
    // Source with no integer literal is rejected by the lowering.
    stack mut OwnedAscii sink = new();
    return !LowerReturnIntToLlvm("return", sink);
}

[Fact]
fn bool LowersReturnAddExpr()
{
    // `return 2 + 3` lexes + lowers to a MIR add and emits the LLVM function.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 2 + 3", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnSubAndMulExpr()
{
    // `-` and `*` lower to sub/mul.
    stack mut OwnedAscii sinkSub = new();
    stack bool okSub = LowerReturnExprToLlvm("return 10 - 4", sinkSub);
    stack mut OwnedAscii sinkMul = new();
    stack bool okMul = LowerReturnExprToLlvm("return 6 * 7", sinkMul);
    return okSub
        && okMul
        && LlvmTextEquals(sinkSub, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 10\n  %v2 = add i64 0, 4\n  %v3 = sub i64 %v1, %v2\n  ret i64 %v3\n}\n")
        && LlvmTextEquals(sinkMul, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 6\n  %v2 = add i64 0, 7\n  %v3 = mul i64 %v1, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnSingleConstViaExpr()
{
    // The single-constant case still works through the expression lowering.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 42", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 42\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool LowersReturnExpressionChain()
{
    // An arbitrary-length operator chain folds left-associatively:
    // `return 2 + 3 + 4` -> ((2 + 3) + 4).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 2 + 3 + 4", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  %v4 = add i64 0, 4\n  %v5 = add i64 %v3, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersProgramWithLocalVariable()
{
    // A two-statement program: a local binds an expression's value, and the return
    // reuses it by name. `var x = 2 + 3; return x * x` -> x = %v3 (the add), reused.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerProgramToLlvm("var x = 2 + 3; return x * x", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  %v4 = mul i64 %v3, %v3\n  ret i64 %v4\n}\n");
}

[Fact]
fn bool LowersProgramWithTwoLocals()
{
    // Two local declarations, both reused in the return: `var x = 2; var y = 3;
    // return x + y` -> x = %v1, y = %v2, ret add %v1, %v2.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerProgramToLlvm("var x = 2; var y = 3; return x + y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersProgramLocalReferencesEarlierLocal()
{
    // A later local can reference an earlier one: `var x = 4; var y = x * x;
    // return y + x` -> y = x*x (%v2), ret (y + x).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerProgramToLlvm("var x = 4; var y = x * x; return y + x", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 4\n  %v2 = mul i64 %v1, %v1\n  %v3 = add i64 %v2, %v1\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersProgramReturningLocalPlusConst()
{
    // The local appears in a larger expression: `var y = 6 * 7; return y + 1`.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerProgramToLlvm("var y = 6 * 7; return y + 1", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 6\n  %v2 = add i64 0, 7\n  %v3 = mul i64 %v1, %v2\n  %v4 = add i64 0, 1\n  %v5 = add i64 %v3, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersFunctionParameterAndCallArgument()
{
    // A function with a parameter, called with an argument:
    // `fn double(x) { return x + x } fn main() { return double(5) }` -> @f1 takes %p0
    // and doubles it; @f2 calls @f1 with the constant 5.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerModuleToLlvm("fn double(x) { return x + x } fn main() { return double(5) }", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @f1(i64 %p0) {\nb1:\n  %v3 = add i64 %p0, %p0\n  ret i64 %v3\n}\ndefine i64 @f2() {\nb2:\n  %v4 = add i64 0, 5\n  %v5 = call i64 @f1(i64 %v4)\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersTwoFunctionsWithCall()
{
    // Two function definitions where the second calls the first by name:
    // `fn helper() { return 7 } fn main() { return helper() }` -> a module with
    // @f1 (returns 7) and @f2 (calls @f1).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerModuleToLlvm("fn helper() { return 7 } fn main() { return helper() }", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @f1() {\nb1:\n  %v1 = add i64 0, 7\n  ret i64 %v1\n}\ndefine i64 @f2() {\nb2:\n  %v2 = call i64 @f1()\n  ret i64 %v2\n}\n");
}

[Fact]
fn bool LowersIfExpressionToBranchingLlvm()
{
    // An `if` from source compiles to a branching function with a phi merge:
    // `if x < y x else y` -> compare x,y; branch; phi selects x or y at the merge.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerIfToLlvm("if x < y x else y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v3 = icmp slt i64 %p0, %p1\n  br i1 %v3, label %b2, label %b3\nb2:\n  br label %b4\nb3:\n  br label %b4\nb4:\n  %v6 = phi i64 [ %p0, %b2 ], [ %p1, %b3 ]\n  ret i64 %v6\n}\n");
}

[Fact]
fn bool LowersIfWithExpressionArms()
{
    // The then/else arms are expressions computed in their own blocks:
    // `if x < y x + 1 else y - 1` -> then block computes x+1, else block computes y-1,
    // the merge phi selects between them.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerIfToLlvm("if x < y x + 1 else y - 1", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v3 = icmp slt i64 %p0, %p1\n  br i1 %v3, label %b2, label %b3\nb2:\n  %v5 = add i64 0, 1\n  %v6 = add i64 %p0, %v5\n  br label %b4\nb3:\n  %v8 = add i64 0, 1\n  %v9 = sub i64 %p1, %v8\n  br label %b4\nb4:\n  %v10 = phi i64 [ %v6, %b2 ], [ %v9, %b3 ]\n  ret i64 %v10\n}\n");
}

[Fact]
fn bool LowersReturnComparison()
{
    // `return x < y` lowers to a signed compare then zero-extend to i64 (1 or 0).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x < y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v3 = icmp slt i64 %p0, %p1\n  %v4 = zext i1 %v3 to i64\n  ret i64 %v4\n}\n");
}

[Fact]
fn bool LowersReturnComparisonBelowArithmetic()
{
    // Comparison binds below `+`: `return x + 1 < y` lowers as `(x + 1) < y`.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x + 1 < y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v2 = add i64 0, 1\n  %v3 = add i64 %p0, %v2\n  %v5 = icmp slt i64 %v3, %p1\n  %v6 = zext i1 %v5 to i64\n  ret i64 %v6\n}\n");
}

[Fact]
fn bool LowersReturnParameterExpression()
{
    // An identifier in the expression is the function parameter `x` (lowered to %p0),
    // and the function gains a parameter: `fn(x) return x + 1`.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x + 1", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0) {\nb1:\n  %v2 = add i64 0, 1\n  %v3 = add i64 %p0, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnParameterSquared()
{
    // `return x * x` references the same parameter twice (one symbol-table entry):
    // `mul i64 %p0, %p0`, one declared parameter.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x * x", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0) {\nb1:\n  %v3 = mul i64 %p0, %p0\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnTwoParameters()
{
    // Distinct identifiers become distinct parameters via the symbol table:
    // `x` -> %p0, `y` -> %p1, in first-appearance order.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x + y", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v3 = add i64 %p0, %p1\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnTwoParametersWithPrecedence()
{
    // `return x + y * x` -> x + (y * x): y=%p1, x=%p0, mul then add.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return x + y * x", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(i64 %p0, i64 %p1) {\nb1:\n  %v4 = mul i64 %p1, %p0\n  %v5 = add i64 %p0, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersReturnDivisionAndRemainder()
{
    // `/` and `%` lower to `sdiv`/`srem` in the product tier.
    stack mut OwnedAscii sinkDiv = new();
    stack bool okDiv = LowerReturnExprToLlvm("return 12 / 3", sinkDiv);
    stack mut OwnedAscii sinkMod = new();
    stack bool okMod = LowerReturnExprToLlvm("return 17 % 5", sinkMod);
    return okDiv
        && okMod
        && LlvmTextEquals(sinkDiv, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 12\n  %v2 = add i64 0, 3\n  %v3 = sdiv i64 %v1, %v2\n  ret i64 %v3\n}\n")
        && LlvmTextEquals(sinkMod, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 17\n  %v2 = add i64 0, 5\n  %v3 = srem i64 %v1, %v2\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool LowersReturnDivisionPrecedence()
{
    // `/` binds tighter than `+`: `return 2 + 12 / 3` lowers as `2 + (12 / 3)`.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 2 + 12 / 3", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 12\n  %v3 = add i64 0, 3\n  %v4 = sdiv i64 %v2, %v3\n  %v5 = add i64 %v1, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersReturnRespectsPrecedence()
{
    // `*` binds tighter than `+`: `return 2 + 3 * 4` lowers as `2 + (3 * 4)`, so the
    // mul is computed first and fed to the add.
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 2 + 3 * 4", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 0, 4\n  %v4 = mul i64 %v2, %v3\n  %v5 = add i64 %v1, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool LowersReturnMixedOperatorChain()
{
    // A mixed chain folds left-to-right: `return 10 - 3 + 2` -> ((10 - 3) + 2).
    stack mut OwnedAscii sink = new();
    stack bool ok = LowerReturnExprToLlvm("return 10 - 3 + 2", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main() {\nb1:\n  %v1 = add i64 0, 10\n  %v2 = add i64 0, 3\n  %v3 = sub i64 %v1, %v2\n  %v4 = add i64 0, 2\n  %v5 = add i64 %v3, %v4\n  ret i64 %v5\n}\n");
}

[Fact]
fn bool FfiBindsLibcFunction()
{
    // The self-hosted compiler package can declare and call a C function via FFI — the
    // same mechanism a direct libLLVM C-API binding (#31) will use. libc `abs` resolves
    // from the system C library that macOS Stark binaries already link.
    return AbsViaFfi(-5) == 5
        && AbsViaFfi(7) == 7
        && AbsViaFfi(0) == 0;
}

[Fact]
fn bool EmittedLlvmCompilesToObject()
{
    // End-to-end #31 (subprocess route): emit a module's LLVM IR, write the `.ll`,
    // invoke `clang -c` to compile it, and confirm an object file was produced — the
    // self-hosted back end producing real native code. Tolerant of a missing toolchain
    // (passes if clang can't be spawned) so the suite stays portable.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    return CompileEmittedLlvmProducesObject(instrs, blocks, funcs);
}

[Fact]
fn bool LlvmModuleRoundTripsThroughFile()
{
    // The emitted LLVM IR text persists to a `.ll` file and reads back identically —
    // the self-hosted back end produces a real .ll file on disk (compilable by
    // clang/llc to an object, the non-FFI path toward #31).
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    return LlvmModuleFileRoundTrips(instrs, blocks, funcs);
}

[Fact]
fn bool PackageImageRoundTripsThroughFile()
{
    // End-to-end #32: serialize a module, write it to a temp file, read it back, and
    // deserialize — the full on-disk path (all I/O inside the module function).
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 5);
    stack MirValueId b = MirConstInt(instrs, 6);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g = MirDefineGlobal(globals, 42);
    return PackageImageFileRoundTrips(instrs, blocks, funcs, globals);
}

[Fact]
fn bool PackageImageInspectsThroughFile()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 5);
    stack MirValueId b = MirConstInt(instrs, 6);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g = MirDefineGlobal(globals, 42);
    stack mut IrTable<u8[0 max]> image = new();
    SerializePackageImage(instrs, blocks, funcs, globals, image);

    stack mut OwnedAscii expectedText = new();
    switch (expectedText.AppendConstAscii("package: 3 instructions, 1 blocks, 1 functions, 1 globals\n"))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii expectedJson = new();
    switch (expectedJson.AppendConstAscii("{\"format\":\"MIR1\",\"instructions\":3,\"blocks\":1,\"functions\":1,\"globals\":1}\n"))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    return PackageImageIsValid(image)
        && PackageImageBufferInspectsThroughFile(image, expectedText, expectedJson);
}

[Fact]
fn bool PackageImageBridgesToByteBuffer()
{
    // The image bytes convert to the stdlib DynamicByteBuffer (the exact type the file
    // API consumes/produces) and back without loss — the module survives the trip
    // through that container, so persisting to disk is a thin wrapper.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 7);
    stack MirValueId b = MirConstInt(instrs, 8);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g = MirDefineGlobal(globals, -3);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializePackageImage(instrs, blocks, funcs, globals, buf);
    stack mut DynamicByteBuffer dbuf = new();
    if (!ImageToByteBuffer(buf, dbuf))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> buf2 = new();
    if (!ImageFromByteBuffer(dbuf, buf2))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack bool ok = DeserializePackageImage(buf2, bi, bb, bf, bg);
    return ok
        && buf2.Count() == buf.Count()
        && bi.Count() == 3
        && bg.Count() == 1
        && MirOpcodeOf(bi, MirValueIdOf(3)) == MirOp.Add
        && MirGlobalInitialValue(bg, 1) == -3;
}

[Fact]
fn bool BinaryRoundTripsPackageImage()
{
    // A whole module — instructions, blocks, functions, globals — round-trips through
    // one combined package image (a section directory + the four streams).
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    stack MirValueId a = MirConstInt(instrs, 11);
    stack MirValueId b = MirConstInt(instrs, 22);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack u32[0 max] g = MirDefineGlobalTyped(globals, MirType.I32, -9);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializePackageImage(instrs, blocks, funcs, globals, buf);
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack bool ok = DeserializePackageImage(buf, bi, bb, bf, bg);
    stack MirBlockId entry = MirFunctionEntry(bf, MirFuncIdOf(1));
    return ok
        && bi.Count() == 3
        && bb.Count() == 1
        && bf.Count() == 1
        && bg.Count() == 1
        && MirOpcodeOf(bi, MirValueIdOf(3)) == MirOp.Add
        && MirBlockTerminator(bb, MirBlockIdOf(1)) == MirTermKind.Return
        && entry.Equals(MirBlockIdOf(1))
        && MirGlobalType(bg, 1) == MirType.I32
        && MirGlobalInitialValue(bg, 1) == -9;
}

[Fact]
fn bool SectionedPackageImageRoundTripsAndInspects()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    stack MirValueId a = MirConstInt(instrs, 13);
    stack MirValueId b = MirConstInt(instrs, 21);
    stack MirValueId s = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, s);
    stack MirFuncId f = MirDefineFunction(funcs, blk, blk, 1, a, 3);
    stack u32[0 max] g = MirDefineGlobal(globals, 34);

    stack mut IrTable<u8[0 max]> image = new();
    SerializeSectionedPackageImage(instrs, blocks, funcs, globals, image);

    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    if (!DeserializePackageImage(image, bi, bb, bf, bg))
    {
        return false;
    }

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    return PackageImageIsValid(image)
        && ReadU32(image, 1) == 1380013139
        && ReadU32(image, 5) == 1196118091
        && ReadU32(image, 9) == 2
        && ReadU32(image, 13) == 4
        && bi.Count() == 3
        && bb.Count() == 1
        && bf.Count() == 1
        && bg.Count() == 1
        && MirOpcodeOf(bi, MirValueIdOf(3)) == MirOp.Add
        && MirGlobalInitialValue(bg, 1) == 34
        && LlvmTextEquals(text, "package: STARKPKG, 3 instructions, 1 blocks, 1 functions, 1 globals\n")
        && LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"MIR1\",\"instructions\":3,\"blocks\":1,\"functions\":1,\"globals\":1}\n");
}

[Fact]
fn bool SectionedPackageImageRoundTripsEnumLayoutFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    stack MirValueId value = MirConstInt(instrs, 0);
    stack MirBlockId block = MirReturnBlock(blocks, value);
    stack MirFuncId functionId = MirDefineFunction(funcs, block, block, 1, value, 1);

    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> enumFacts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, enumFacts))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> enumFactBytes = new();
    SerializeEnumLayoutFacts(enumFacts, enumFactBytes);
    stack mut IrTable<MirEnumLayoutFact> directlyRestoredFacts = new();
    if (!DeserializeEnumLayoutFacts(enumFactBytes, directlyRestoredFacts))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> image = new();
    SerializeSectionedPackageImageWithEnumLayoutFacts(instrs, blocks, funcs, globals, enumFacts, image);

    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    if (!DeserializePackageImage(image, bi, bb, bf, bg))
    {
        return false;
    }

    stack mut IrTable<MirEnumLayoutFact> restoredFacts = new();
    if (!DeserializePackageImageEnumLayoutFacts(image, restoredFacts))
    {
        return false;
    }

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    stack u32[0 max] sourceDataPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(enumFacts, source, stream, "Data", 0);
    stack u32[0 max] directDataPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(directlyRestoredFacts, source, stream, "Data", 0);
    stack u32[0 max] restoredDataPayloadSlot = MirEnumLayoutFactPayloadIndexByVariantAndOrdinal(restoredFacts, source, stream, "Data", 0);
    if (sourceDataPayloadSlot == 0 || directDataPayloadSlot == 0 || restoredDataPayloadSlot == 0)
    {
        return false;
    }

    stack MirEnumLayoutFact sourceDataPayload = enumFacts.Get(sourceDataPayloadSlot);
    stack MirEnumLayoutFact directDataPayload = directlyRestoredFacts.Get(directDataPayloadSlot);
    stack MirEnumLayoutFact restoredDataPayload = restoredFacts.Get(restoredDataPayloadSlot);
    stack TypeId sourcePayloadOwner = sourceDataPayload.OwnerType();
    stack TypeId directPayloadOwner = directDataPayload.OwnerType();
    stack TypeId restoredPayloadOwner = restoredDataPayload.OwnerType();
    return PackageImageIsValid(image)
        && ReadU32(image, 13) == 5
        && functionId.Index() == 1
        && bi.Count() == 1
        && bb.Count() == 1
        && bf.Count() == 1
        && bg.Count() == 0
        && enumFacts.Count() == 5
        && directlyRestoredFacts.Count() == 5
        && restoredFacts.Count() == 5
        && sourcePayloadOwner.Equals(directPayloadOwner)
        && sourcePayloadOwner.Equals(restoredPayloadOwner)
        && sourceDataPayload.RowKind() == directDataPayload.RowKind()
        && sourceDataPayload.RowKind() == restoredDataPayload.RowKind()
        && sourceDataPayload.PayloadKind() == directDataPayload.PayloadKind()
        && sourceDataPayload.PayloadKind() == restoredDataPayload.PayloadKind()
        && sourceDataPayload.TypeKind() == directDataPayload.TypeKind()
        && sourceDataPayload.TypeKind() == restoredDataPayload.TypeKind()
        && restoredDataPayload.VariantTag() == 1
        && restoredDataPayload.OffsetBytes() == 1
        && restoredDataPayload.SizeBytes() == 1
        && restoredDataPayload.AlignmentBytes() == 1
        && restoredDataPayload.HasConcreteLayout()
        && LlvmTextEquals(text, "package: STARKPKG, 1 instructions, 1 blocks, 1 functions, 0 globals, 5 enum layout facts\n")
        && LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"MIR1\",\"instructions\":1,\"blocks\":1,\"functions\":1,\"globals\":0,\"enumLayoutFacts\":5}\n");
}

[Fact]
fn bool SectionedPackageImageRoundTripsTextConstants()
{
    stack mut IrTable<u8[0 max]> payloadBytes = new();
    payloadBytes.Add(72);
    payloadBytes.Add(105);
    payloadBytes.Add(206);
    payloadBytes.Add(177);

    stack mut IrTable<MirTextConstant> textConstants = new();
    stack u32[0 max] asciiRow = MirAddTextConstantRange(textConstants, payloadBytes, MirTextConstantStorageEncoding.AsciiBytes, 1, 2, 2);
    stack u32[0 max] utf8Row = MirAddTextConstantRange(textConstants, payloadBytes, MirTextConstantStorageEncoding.Utf8Bytes, 3, 2, 1);

    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId asciiValue = MirTextConstantValue(instrs, textConstants, asciiRow);
    stack MirValueId utf8Value = MirTextConstantValue(instrs, textConstants, utf8Row);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId block = MirReturnBlock(blocks, asciiValue);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId functionId = MirDefineFunction(funcs, block, block, 1, asciiValue, 2);
    stack mut IrTable<MirGlobal> globals = new();

    stack mut IrTable<u8[0 max]> image = new();
    SerializeSectionedPackageImageWithTextConstants(instrs, blocks, funcs, globals, payloadBytes, textConstants, image);

    stack mut IrTable<MirInstruction> restoredInstrs = new();
    stack mut IrTable<MirBlock> restoredBlocks = new();
    stack mut IrTable<MirFunction> restoredFuncs = new();
    stack mut IrTable<MirGlobal> restoredGlobals = new();
    stack mut IrTable<u8[0 max]> restoredPayloadBytes = new();
    stack mut IrTable<MirTextConstant> restoredTextConstants = new();
    if (!DeserializePackageImageWithTextConstants(
        image,
        restoredInstrs,
        restoredBlocks,
        restoredFuncs,
        restoredGlobals,
        restoredPayloadBytes,
        restoredTextConstants))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> directPayloadBytes = new();
    stack mut IrTable<MirTextConstant> directTextConstants = new();
    if (!DeserializePackageImageTextConstants(image, directPayloadBytes, directTextConstants))
    {
        return false;
    }

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    return PackageImageIsValid(image)
        && ReadU32(image, 13) == 6
        && asciiRow == 1
        && utf8Row == 2
        && asciiValue.Index() == 1
        && utf8Value.Index() == 2
        && functionId.Index() == 1
        && restoredInstrs.Count() == 2
        && restoredBlocks.Count() == 1
        && restoredFuncs.Count() == 1
        && restoredGlobals.Count() == 0
        && restoredPayloadBytes.Count() == 4
        && restoredPayloadBytes.Get(1) == 72
        && restoredPayloadBytes.Get(2) == 105
        && restoredPayloadBytes.Get(3) == 206
        && restoredPayloadBytes.Get(4) == 177
        && directPayloadBytes.Count() == 4
        && directTextConstants.Count() == 2
        && restoredTextConstants.Count() == 2
        && MirOpcodeOf(restoredInstrs, MirValueIdOf(1)) == MirOp.TextConstantValue
        && MirOpcodeOf(restoredInstrs, MirValueIdOf(2)) == MirOp.TextConstantValue
        && MirTextConstantValueRowIndexOf(restoredInstrs, MirValueIdOf(1)) == 1
        && MirTextConstantValuePayloadStartOf(restoredInstrs, MirValueIdOf(1)) == 1
        && MirTextConstantValuePayloadByteLengthOf(restoredInstrs, MirValueIdOf(1)) == 2
        && MirTextConstantValueCodePointLengthOf(restoredInstrs, MirValueIdOf(1)) == 2
        && MirTextConstantValueStorageEncodingOf(restoredInstrs, MirValueIdOf(1)) == MirTextConstantStorageEncoding.AsciiBytes
        && MirTextConstantValueRowIndexOf(restoredInstrs, MirValueIdOf(2)) == 2
        && MirTextConstantValuePayloadStartOf(restoredInstrs, MirValueIdOf(2)) == 3
        && MirTextConstantValuePayloadByteLengthOf(restoredInstrs, MirValueIdOf(2)) == 2
        && MirTextConstantValueCodePointLengthOf(restoredInstrs, MirValueIdOf(2)) == 1
        && MirTextConstantValueStorageEncodingOf(restoredInstrs, MirValueIdOf(2)) == MirTextConstantStorageEncoding.Utf8Bytes
        && MirTextConstantPayloadStart(restoredTextConstants, 1) == 1
        && MirTextConstantPayloadByteLength(restoredTextConstants, 1) == 2
        && MirTextConstantPayloadCodePointLength(restoredTextConstants, 1) == 2
        && MirTextConstantEncoding(restoredTextConstants, 1) == MirTextConstantStorageEncoding.AsciiBytes
        && MirTextConstantPayloadStart(restoredTextConstants, 2) == 3
        && MirTextConstantPayloadByteLength(restoredTextConstants, 2) == 2
        && MirTextConstantPayloadCodePointLength(restoredTextConstants, 2) == 1
        && MirTextConstantEncoding(restoredTextConstants, 2) == MirTextConstantStorageEncoding.Utf8Bytes
        && LlvmTextEquals(text, "package: STARKPKG, 2 instructions, 1 blocks, 1 functions, 0 globals, 4 text payload bytes, 2 text constants\n")
        && LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"MIR1\",\"instructions\":2,\"blocks\":1,\"functions\":1,\"globals\":0,\"textPayloadBytes\":4,\"textConstants\":2}\n");
}

[Fact]
fn bool SectionedPackageImageRoundTripsFloatConstants()
{
    stack mut IrTable<u8[0 max]> payloadBytes = new();
    payloadBytes.Add(49);
    payloadBytes.Add(46);
    payloadBytes.Add(53);
    payloadBytes.Add(45);
    payloadBytes.Add(50);
    payloadBytes.Add(46);
    payloadBytes.Add(50);
    payloadBytes.Add(53);

    stack mut IrTable<MirFloatConstant> floatConstants = new();
    stack u32[0 max] f32Row = MirAddFloatConstantRange(floatConstants, payloadBytes, MirType.F32, 1, 3);
    stack u32[0 max] f64Row = MirAddFloatConstantRange(floatConstants, payloadBytes, MirType.F64, 4, 5);

    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId f32Value = MirFloatConstantValue(instrs, floatConstants, f32Row);
    stack MirValueId f64Value = MirFloatConstantValue(instrs, floatConstants, f64Row);
    stack mut IrTable<MirBlock> blocks = new();
    stack MirBlockId f32Block = MirReturnBlock(blocks, f32Value);
    stack MirBlockId f64Block = MirReturnBlock(blocks, f64Value);
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f32Func = MirDefineFunction(funcs, f32Block, f32Block, 1, f32Value, 1);
    stack MirFuncId f64Func = MirDefineFunction(funcs, f64Block, f64Block, 1, f64Value, 1);
    stack mut IrTable<MirGlobal> globals = new();

    stack mut IrTable<u8[0 max]> image = new();
    SerializeSectionedPackageImageWithFloatConstants(instrs, blocks, funcs, globals, payloadBytes, floatConstants, image);

    stack mut IrTable<MirInstruction> restoredInstrs = new();
    stack mut IrTable<MirBlock> restoredBlocks = new();
    stack mut IrTable<MirFunction> restoredFuncs = new();
    stack mut IrTable<MirGlobal> restoredGlobals = new();
    stack mut IrTable<u8[0 max]> restoredPayloadBytes = new();
    stack mut IrTable<MirFloatConstant> restoredFloatConstants = new();
    if (!DeserializePackageImageWithFloatConstants(
        image,
        restoredInstrs,
        restoredBlocks,
        restoredFuncs,
        restoredGlobals,
        restoredPayloadBytes,
        restoredFloatConstants))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> directPayloadBytes = new();
    stack mut IrTable<MirFloatConstant> directFloatConstants = new();
    if (!DeserializePackageImageFloatConstants(image, directPayloadBytes, directFloatConstants))
    {
        return false;
    }

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii llvm = new();
    switch (EmitLlvmModuleWithFloatConstants(restoredInstrs, restoredBlocks, restoredFuncs, restoredPayloadBytes, llvm))
    {
        case MemoryStatus.Err(var llvmError):
            return false;
        case MemoryStatus.Ok:
    }

    return PackageImageIsValid(image)
        && ReadU32(image, 13) == 6
        && f32Row == 1
        && f64Row == 2
        && f32Value.Index() == 1
        && f64Value.Index() == 2
        && f32Func.Index() == 1
        && f64Func.Index() == 2
        && restoredInstrs.Count() == 2
        && restoredBlocks.Count() == 2
        && restoredFuncs.Count() == 2
        && restoredGlobals.Count() == 0
        && restoredPayloadBytes.Count() == 8
        && restoredPayloadBytes.Get(1) == 49
        && restoredPayloadBytes.Get(4) == 45
        && restoredPayloadBytes.Get(8) == 53
        && directPayloadBytes.Count() == 8
        && directFloatConstants.Count() == 2
        && restoredFloatConstants.Count() == 2
        && MirOpcodeOf(restoredInstrs, MirValueIdOf(1)) == MirOp.FloatConstantValue
        && MirOpcodeOf(restoredInstrs, MirValueIdOf(2)) == MirOp.FloatConstantValue
        && MirFloatConstantValueRowIndexOf(restoredInstrs, MirValueIdOf(1)) == 1
        && MirFloatConstantValuePayloadStartOf(restoredInstrs, MirValueIdOf(1)) == 1
        && MirFloatConstantValuePayloadByteLengthOf(restoredInstrs, MirValueIdOf(1)) == 3
        && MirFloatConstantValueBitWidthOf(restoredInstrs, MirValueIdOf(1)) == 32
        && MirFloatConstantValueTypeOf(restoredInstrs, MirValueIdOf(1)) == MirType.F32
        && MirFloatConstantValueRowIndexOf(restoredInstrs, MirValueIdOf(2)) == 2
        && MirFloatConstantValuePayloadStartOf(restoredInstrs, MirValueIdOf(2)) == 4
        && MirFloatConstantValuePayloadByteLengthOf(restoredInstrs, MirValueIdOf(2)) == 5
        && MirFloatConstantValueBitWidthOf(restoredInstrs, MirValueIdOf(2)) == 64
        && MirFloatConstantValueTypeOf(restoredInstrs, MirValueIdOf(2)) == MirType.F64
        && MirFloatConstantPayloadStart(restoredFloatConstants, 1) == 1
        && MirFloatConstantPayloadByteLength(restoredFloatConstants, 1) == 3
        && MirFloatConstantType(restoredFloatConstants, 1) == MirType.F32
        && MirFloatConstantPayloadStart(restoredFloatConstants, 2) == 4
        && MirFloatConstantPayloadByteLength(restoredFloatConstants, 2) == 5
        && MirFloatConstantType(restoredFloatConstants, 2) == MirType.F64
        && LlvmTextEquals(text, "package: STARKPKG, 2 instructions, 2 blocks, 2 functions, 0 globals, 8 float payload bytes, 2 float constants\n")
        && LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"MIR1\",\"instructions\":2,\"blocks\":2,\"functions\":2,\"globals\":0,\"floatPayloadBytes\":8,\"floatConstants\":2}\n")
        && LlvmTextEquals(llvm, "define float @f1() {\nb1:\n  %v1 = select i1 true, float 0x3FF8000000000000, float 0x0000000000000000\n  ret float %v1\n}\ndefine double @f2() {\nb2:\n  %v2 = select i1 true, double 0xC002000000000000, double 0x0000000000000000\n  ret double %v2\n}\n");
}

internal fn void AppendImageByte(mut borrow IrTable<u8[0 max]> image, u8[0 max] value)
{
    stack u32[0 max] written = image.Add(value);
}

internal fn void BuildMinimalLogicalPackageImage(mut borrow IrTable<u8[0 max]> image, u32[0 max] rootStringIndex)
{
    stack u64[0 max] stringOffset = 120;
    stack u64[0 max] stringLength = 25;
    stack u64[0 max] factsOffset = 145;
    stack u64[0 max] factsLength = 44;
    stack u64[0 max] manifestOffset = 189;

    WriteStarkPackageImageMagic(image);
    WriteU32(image, SectionedPackageImageVersion());
    WriteU32(image, 3);
    WriteU64(image, 96);
    WritePackageSectionDirectoryEntry(image, PackageSectionStringTable(), SectionFlagsRequired(), stringOffset, stringLength, SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(image, PackageSectionPackageFacts(), SectionFlagsRequired(), factsOffset, factsLength, SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(image, PackageSectionManifest(), SectionFlagsRequired(), manifestOffset, 1, SectionEncodingBrotliUtf8Json());

    WriteU32(image, 2);
    WriteU32(image, 4);
    AppendImageByte(image, 68);
    AppendImageByte(image, 101);
    AppendImageByte(image, 109);
    AppendImageByte(image, 111);
    WriteU32(image, 9);
    AppendImageByte(image, 108);
    AppendImageByte(image, 105);
    AppendImageByte(image, 98);
    AppendImageByte(image, 68);
    AppendImageByte(image, 101);
    AppendImageByte(image, 109);
    AppendImageByte(image, 111);
    AppendImageByte(image, 46);
    AppendImageByte(image, 97);

    WriteU32(image, rootStringIndex);
    WriteU32(image, 1);
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, 0);
    WriteU32(image, 0);
    WriteU32(image, 0);
    AppendImageByte(image, 11);
}

