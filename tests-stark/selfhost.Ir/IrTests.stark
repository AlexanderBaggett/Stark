[Fact]
fn bool EmitsLlvmForEnumConstructionInstructionsFromLayoutFacts()
{
    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> facts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, facts))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(1), 2);
    stack MirValueId payload = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId inserted = MirEnumPayloadInsert(instrs, TypeIdOf(1), 2, 0, tagged, payload);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmInstructionWithEnumLayouts(instrs, facts, sink, tagged.Index()))
    {
        case MemoryStatus.Err(var tagError):
            return false;
        case MemoryStatus.Ok:
    }

    switch (EmitLlvmInstructionWithEnumLayouts(instrs, facts, sink, payload.Index()))
    {
        case MemoryStatus.Err(var payloadConstError):
            return false;
        case MemoryStatus.Ok:
    }

    switch (EmitLlvmInstructionWithEnumLayouts(instrs, facts, sink, inserted.Index()))
    {
        case MemoryStatus.Err(var insertError):
            return false;
        case MemoryStatus.Ok:
    }

    return LlvmTextEquals(
        sink,
        "  %v1 = insertvalue { i8, i8, [2 x i8], i32 } zeroinitializer, i8 2, 0\n  %v2 = add i32 0, 99\n  %v3 = insertvalue { i8, i8, [2 x i8], i32 } %v1, i32 %v2, 3\n");
}

