[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesCompilerFunctionEffectFacts()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] workEffectRow = 0;
    stack mut u32[0 max] printfEffectRow = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddCompilerFactFunctionEffect(
            0,
            "Demo.Work",
            "finite",
            "inline",
            workEffectRow)
        || !manifestBuilder.SetCompilerFactFunctionEffectFlags(
            workEffectRow,
            true,
            false,
            true,
            true,
            true,
            true,
            true,
            true,
            false,
            true,
            false,
            false,
            false,
            true,
            true)
        || !manifestBuilder.SetCompilerFactFunctionEffectBackendOptimizationMode(
            workEffectRow,
            "opaque")
        || !manifestBuilder.AddCompilerFactFunctionEffect(
            0,
            "Demo.CPrintf",
            "fn",
            "noinline",
            printfEffectRow)
        || !manifestBuilder.SetCompilerFactFunctionEffectFlags(
            printfEffectRow,
            false,
            false,
            false,
            false,
            true,
            false,
            false,
            false,
            true,
            false,
            true,
            true,
            true,
            false,
            false)
        || !manifestBuilder.SetCompilerFactFunctionEffectFfiAbi(printfEffectRow, "c"))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageFunctionEffectFactGraph graph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageFunctionEffectFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }
    }

    stack LogicalPackageFunctionEffectRow work = graph.FunctionEffectRowAt(1);
    stack LogicalPackageFunctionEffectRow cPrintf = graph.FunctionEffectRowAt(2);
    stack LogicalPackageFunctionEffectFactTextRow workNameText =
        graph.TextRowAt(work.QualifiedResolvedNameTextRow());
    stack LogicalPackageFunctionEffectFactTextRow workBackendModeText =
        graph.TextRowAt(work.BackendOptimizationModeTextRow());
    stack LogicalPackageFunctionEffectFactTextRow cPrintfNameText =
        graph.TextRowAt(cPrintf.QualifiedResolvedNameTextRow());
    stack LogicalPackageFunctionEffectFactTextRow cPrintfKindText =
        graph.TextRowAt(cPrintf.KindTextRow());
    stack LogicalPackageFunctionEffectFactTextRow cPrintfInlineText =
        graph.TextRowAt(cPrintf.InlinePreferenceTextRow());
    stack LogicalPackageFunctionEffectFactTextRow cPrintfFfiAbiText =
        graph.TextRowAt(cPrintf.FfiAbiTextRow());
    stack mut OwnedAscii workName = new();
    stack mut OwnedAscii workBackendMode = new();
    stack mut OwnedAscii cPrintfName = new();
    stack mut OwnedAscii cPrintfKind = new();
    stack mut OwnedAscii cPrintfInline = new();
    stack mut OwnedAscii cPrintfFfiAbi = new();
    return graph.FunctionEffectRowCount() == 2
        && graph.TextRowCount() == 8
        && graph.TextByteCount() > 0
        && work.ModuleOrdinal() == 0
        && work.FunctionEffectOrdinal() == 0
        && work.ReadsArgumentMemory()
        && !work.IsPure()
        && work.NoSync()
        && work.NoFree()
        && work.NoUnwind()
        && work.WillReturn()
        && work.MustProgress()
        && work.UsesFastCallingConvention()
        && !work.IsFfi()
        && work.IsHot()
        && !work.IsCold()
        && !work.IsStrictFp()
        && !work.IsVarargs()
        && work.IsTailCallable()
        && !work.HasFfiAbi()
        && work.HasBackendOptimizationMode()
        && work.NoRecurse()
        && cPrintf.ModuleOrdinal() == 0
        && cPrintf.FunctionEffectOrdinal() == 1
        && !cPrintf.ReadsArgumentMemory()
        && !cPrintf.IsPure()
        && !cPrintf.NoSync()
        && !cPrintf.NoFree()
        && cPrintf.NoUnwind()
        && !cPrintf.WillReturn()
        && !cPrintf.MustProgress()
        && !cPrintf.UsesFastCallingConvention()
        && cPrintf.IsFfi()
        && !cPrintf.IsHot()
        && cPrintf.IsCold()
        && cPrintf.IsStrictFp()
        && cPrintf.IsVarargs()
        && !cPrintf.IsTailCallable()
        && cPrintf.HasFfiAbi()
        && !cPrintf.HasBackendOptimizationMode()
        && !cPrintf.NoRecurse()
        && workNameText.TextKind() == LogicalPackageFunctionEffectFactTextKind.QualifiedResolvedName
        && workBackendModeText.TextKind() == LogicalPackageFunctionEffectFactTextKind.BackendOptimizationMode
        && cPrintfNameText.TextKind() == LogicalPackageFunctionEffectFactTextKind.QualifiedResolvedName
        && cPrintfKindText.TextKind() == LogicalPackageFunctionEffectFactTextKind.Kind
        && cPrintfInlineText.TextKind() == LogicalPackageFunctionEffectFactTextKind.InlinePreference
        && cPrintfFfiAbiText.TextKind() == LogicalPackageFunctionEffectFactTextKind.FfiAbi
        && AppendLogicalPackageFunctionEffectFactText(graph, workNameText, workName) == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, workBackendModeText, workBackendMode)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, cPrintfNameText, cPrintfName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, cPrintfKindText, cPrintfKind)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, cPrintfInlineText, cPrintfInline)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, cPrintfFfiAbiText, cPrintfFfiAbi)
            == MemoryStatus.Ok
        && OwnedAsciiEqualsAscii(workName, "Demo.Work")
        && OwnedAsciiEqualsAscii(workBackendMode, "opaque")
        && OwnedAsciiEqualsAscii(cPrintfName, "Demo.CPrintf")
        && OwnedAsciiEqualsAscii(cPrintfKind, "fn")
        && OwnedAsciiEqualsAscii(cPrintfInline, "noinline")
        && OwnedAsciiEqualsAscii(cPrintfFfiAbi, "c");
}

[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesFunctionSemanticFacts()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] semanticRow = 0;
    stack mut u32[0 max] calledCalleeRow = 0;
    stack mut u32[0 max] calledHelperRow = 0;
    stack mut u32[0 max] bufferParameterRow = 0;
    stack mut u32[0 max] countParameterRow = 0;
    stack mut u32[0 max] firstRangeRow = 0;
    stack mut u32[0 max] secondRangeRow = 0;
    stack mut u32[0 max] callRow = 0;
    stack mut u32[0 max] bufferArgumentRow = 0;
    stack mut u32[0 max] countArgumentRow = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddCompilerFactFunctionSemantic(
            0,
            "Demo.Work",
            "fn",
            "finite",
            semanticRow)
        || !manifestBuilder.AddCompilerFactFunctionSemanticCalledFunction(
            semanticRow,
            "Demo.Callee",
            calledCalleeRow)
        || !manifestBuilder.AddCompilerFactFunctionSemanticCalledFunction(
            semanticRow,
            "Demo.Helper",
            calledHelperRow)
        || !manifestBuilder.SetCompilerFactFunctionSemanticMemoryEffects(
            semanticRow,
            true,
            false,
            true,
            true,
            false,
            true,
            true)
        || !manifestBuilder.AddCompilerFactFunctionSemanticParameter(
            semanticRow,
            "buffer",
            "borrow mut u8[0 max][]",
            "borrow",
            true,
            true,
            false,
            false,
            true,
            true,
            true,
            bufferParameterRow)
        || !manifestBuilder.SetCompilerFactFunctionSemanticParameterDereferenceableBytes(
            bufferParameterRow,
            16)
        || !manifestBuilder.SetCompilerFactFunctionSemanticParameterAlignmentBytes(
            bufferParameterRow,
            8)
        || !manifestBuilder.SetCompilerFactFunctionSemanticParameterPointeeDeadOnReturn(
            bufferParameterRow,
            true)
        || !manifestBuilder.AddCompilerFactFunctionSemanticInitializationRange(
            bufferParameterRow,
            0,
            8,
            firstRangeRow)
        || !manifestBuilder.AddCompilerFactFunctionSemanticInitializationRange(
            bufferParameterRow,
            8,
            16,
            secondRangeRow)
        || !manifestBuilder.AddCompilerFactFunctionSemanticParameter(
            semanticRow,
            "count",
            "i32[0 max]",
            "none",
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            countParameterRow)
        || !manifestBuilder.AddCompilerFactFunctionSemanticCall(
            semanticRow,
            "Demo.Callee",
            true,
            true,
            false,
            false,
            false,
            false,
            false,
            callRow)
        || !manifestBuilder.AddCompilerFactFunctionSemanticCallArgument(
            callRow,
            0,
            "borrow",
            true,
            false,
            bufferArgumentRow)
        || !manifestBuilder.SetCompilerFactFunctionSemanticCallArgumentCallerParameterName(
            bufferArgumentRow,
            "buffer")
        || !manifestBuilder.SetCompilerFactFunctionSemanticCallArgumentCalleeParameterName(
            bufferArgumentRow,
            "input")
        || !manifestBuilder.AddCompilerFactFunctionSemanticCallArgument(
            callRow,
            1,
            "none",
            false,
            false,
            countArgumentRow)
        || !manifestBuilder.SetCompilerFactFunctionSemanticCallArgumentCalleeParameterName(
            countArgumentRow,
            "count")
        || !manifestBuilder.SetCompilerFactFunctionSemanticHasOpaqueCall(semanticRow, false))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageFunctionSemanticFactGraph graph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageFunctionSemanticFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }
    }

    stack LogicalPackageFunctionSemanticRow semantic = graph.FunctionSemanticRowAt(1);
    stack LogicalPackageFunctionMemoryEffectFacts semanticEffects = semantic.MemoryEffects();
    stack LogicalPackageFunctionSemanticCalledFunctionRow calledHelper =
        graph.CalledFunctionRowAt(2);
    stack LogicalPackageFunctionSemanticParameterRow buffer = graph.ParameterRowAt(1);
    stack LogicalPackageFunctionSemanticParameterRow count = graph.ParameterRowAt(2);
    stack LogicalPackageFunctionSemanticInitializationRangeRow firstRange =
        graph.InitializationRangeRowAt(1);
    stack LogicalPackageFunctionSemanticInitializationRangeRow secondRange =
        graph.InitializationRangeRowAt(2);
    stack LogicalPackageFunctionSemanticCallRow call = graph.CallRowAt(1);
    stack LogicalPackageFunctionMemoryEffectFacts callEffects = call.MemoryEffects();
    stack LogicalPackageFunctionSemanticCallArgumentRow bufferArgument = graph.CallArgumentRowAt(1);
    stack LogicalPackageFunctionSemanticCallArgumentRow countArgument = graph.CallArgumentRowAt(2);
    stack LogicalPackageFunctionSemanticFactTextRow functionNameText =
        graph.TextRowAt(semantic.QualifiedResolvedNameTextRow());
    stack LogicalPackageFunctionSemanticFactTextRow calledHelperText =
        graph.TextRowAt(calledHelper.NameTextRow());
    stack LogicalPackageFunctionSemanticFactTextRow bufferTypeText =
        graph.TextRowAt(buffer.TypeTextRow());
    stack LogicalPackageFunctionSemanticFactTextRow bufferArgumentCallerText =
        graph.TextRowAt(bufferArgument.CallerParameterNameTextRow());
    stack LogicalPackageFunctionSemanticFactTextRow countArgumentCalleeText =
        graph.TextRowAt(countArgument.CalleeParameterNameTextRow());
    stack mut OwnedAscii functionName = new();
    stack mut OwnedAscii calledHelperName = new();
    stack mut OwnedAscii bufferType = new();
    stack mut OwnedAscii bufferArgumentCallerName = new();
    stack mut OwnedAscii countArgumentCalleeName = new();
    return graph.FunctionSemanticRowCount() == 1
        && graph.CalledFunctionRowCount() == 2
        && graph.ParameterRowCount() == 2
        && graph.InitializationRangeRowCount() == 2
        && graph.CallRowCount() == 1
        && graph.CallArgumentRowCount() == 2
        && graph.TextRowCount() == 17
        && graph.TextByteCount() > 0
        && semantic.ModuleOrdinal() == 0
        && semantic.FunctionSemanticOrdinal() == 0
        && semantic.FirstCalledFunctionRow() == 1
        && semantic.CalledFunctionRowCount() == 2
        && semantic.FirstParameterRow() == 1
        && semantic.ParameterRowCount() == 2
        && semantic.FirstCallRow() == 1
        && semantic.CallRowCount() == 1
        && semantic.HasMemoryEffects()
        && semantic.HasExplicitHasOpaqueCall()
        && !semantic.HasOpaqueCall()
        && semanticEffects.ReadsArgumentMemory()
        && !semanticEffects.WritesArgumentMemory()
        && semanticEffects.CapturesArgumentMemory()
        && semanticEffects.ReadsOtherMemory()
        && !semanticEffects.WritesOtherMemory()
        && semanticEffects.InitializesArgumentMemory()
        && semanticEffects.HasPointeeDeadOnReturnArgument()
        && calledHelper.CalledFunctionOrdinal() == 1
        && buffer.ParameterOrdinal() == 0
        && buffer.IsMemoryBacked()
        && buffer.GuaranteedNonNull()
        && !buffer.GuaranteedReadOnly()
        && !buffer.GuaranteedWriteOnly()
        && buffer.GuaranteedNoAlias()
        && buffer.HasDereferenceableBytes()
        && buffer.DereferenceableBytes() == 16
        && buffer.HasAlignmentBytes()
        && buffer.AlignmentBytes() == 8
        && buffer.Reads()
        && buffer.Writes()
        && buffer.PointeeDeadOnReturn()
        && buffer.FirstInitializationRangeRow() == 1
        && buffer.InitializationRangeRowCount() == 2
        && count.ParameterOrdinal() == 1
        && !count.IsMemoryBacked()
        && !count.HasDereferenceableBytes()
        && !count.HasAlignmentBytes()
        && !count.Reads()
        && !count.Writes()
        && !count.PointeeDeadOnReturn()
        && firstRange.StartByte() == 0
        && firstRange.EndByte() == 8
        && secondRange.StartByte() == 8
        && secondRange.EndByte() == 16
        && call.CallOrdinal() == 0
        && call.FirstArgumentRow() == 1
        && call.ArgumentRowCount() == 2
        && callEffects.ReadsArgumentMemory()
        && callEffects.WritesArgumentMemory()
        && !callEffects.CapturesArgumentMemory()
        && !callEffects.ReadsOtherMemory()
        && !callEffects.WritesOtherMemory()
        && !callEffects.InitializesArgumentMemory()
        && !callEffects.HasPointeeDeadOnReturnArgument()
        && bufferArgument.ArgumentIndex() == 0
        && bufferArgument.HasCallerParameterName()
        && bufferArgument.HasCalleeParameterName()
        && bufferArgument.Reads()
        && !bufferArgument.Writes()
        && countArgument.ArgumentIndex() == 1
        && !countArgument.HasCallerParameterName()
        && countArgument.HasCalleeParameterName()
        && !countArgument.Reads()
        && !countArgument.Writes()
        && functionNameText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.QualifiedResolvedName
        && calledHelperText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.CalledFunctionName
        && bufferTypeText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.ParameterType
        && bufferArgumentCallerText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.CallArgumentCallerParameterName
        && countArgumentCalleeText.TextKind()
            == LogicalPackageFunctionSemanticFactTextKind.CallArgumentCalleeParameterName
        && AppendLogicalPackageFunctionSemanticFactText(graph, functionNameText, functionName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionSemanticFactText(graph, calledHelperText, calledHelperName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionSemanticFactText(graph, bufferTypeText, bufferType)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionSemanticFactText(
            graph,
            bufferArgumentCallerText,
            bufferArgumentCallerName) == MemoryStatus.Ok
        && AppendLogicalPackageFunctionSemanticFactText(
            graph,
            countArgumentCalleeText,
            countArgumentCalleeName) == MemoryStatus.Ok
        && OwnedAsciiEqualsAscii(functionName, "Demo.Work")
        && OwnedAsciiEqualsAscii(calledHelperName, "Demo.Helper")
        && OwnedAsciiEqualsAscii(bufferType, "borrow mut u8[0 max][]")
        && OwnedAsciiEqualsAscii(bufferArgumentCallerName, "buffer")
        && OwnedAsciiEqualsAscii(countArgumentCalleeName, "count");
}

[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesFunctionOwnershipFacts()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] noOwnershipSemanticRow = 0;
    stack mut u32[0 max] workSemanticRow = 0;
    stack mut u32[0 max] implicitDropRow = 0;
    stack mut u32[0 max] moveRow = 0;
    stack mut u32[0 max] moveEventRow = 0;
    stack mut u32[0 max] dropEventRow = 0;
    stack mut u32[0 max] projectionRow = 0;
    stack mut u32[0 max] payloadRootRow = 0;
    stack mut u32[0 max] localRootRow = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddCompilerFactFunctionSemantic(
            0,
            "Demo.NoOwnership",
            "fn",
            "fn",
            noOwnershipSemanticRow)
        || !manifestBuilder.AddCompilerFactFunctionSemantic(
            0,
            "Demo.Work",
            "fn",
            "finite",
            workSemanticRow)
        || !manifestBuilder.SetCompilerFactFunctionOwnership(workSemanticRow, true)
        || !manifestBuilder.AddCompilerFactFunctionOwnershipImplicitDrop(
            workSemanticRow,
            "localValue",
            implicitDropRow)
        || !manifestBuilder.AddCompilerFactFunctionOwnershipMove(
            workSemanticRow,
            "payload",
            moveRow)
        || !manifestBuilder.AddCompilerFactFunctionOwnershipEvent(
            workSemanticRow,
            "move",
            "payload",
            "integer",
            true,
            moveEventRow)
        || !manifestBuilder.SetCompilerFactFunctionOwnershipEventPlaceTypeName(
            moveEventRow,
            "i32")
        || !manifestBuilder.SetCompilerFactFunctionOwnershipEventPlaceTypeIntegerFacts(
            moveEventRow,
            32,
            "0",
            "max",
            false)
        || !manifestBuilder.AddCompilerFactFunctionOwnershipEventProjection(
            moveEventRow,
            "Field",
            projectionRow)
        || !manifestBuilder.SetCompilerFactFunctionOwnershipEventLocation(moveEventRow, 12, 5)
        || !manifestBuilder.SetCompilerFactFunctionOwnershipEventLocationFilePath(
            moveEventRow,
            "Demo.stark")
        || !manifestBuilder.AddCompilerFactFunctionOwnershipEvent(
            workSemanticRow,
            "implicit-drop",
            "localValue",
            "named",
            false,
            dropEventRow)
        || !manifestBuilder.SetCompilerFactFunctionOwnershipEventPlaceTypeName(
            dropEventRow,
            "Demo.Box")
        || !manifestBuilder.AddCompilerFactFunctionOwnershipRoot(
            workSemanticRow,
            "payload",
            "integer",
            "parameter",
            "moved",
            false,
            false,
            true,
            false,
            true,
            false,
            false,
            false,
            false,
            true,
            payloadRootRow)
        || !manifestBuilder.SetCompilerFactFunctionOwnershipRootTypeName(payloadRootRow, "i32")
        || !manifestBuilder.SetCompilerFactFunctionOwnershipRootTypeIntegerFacts(
            payloadRootRow,
            32,
            "0",
            "max",
            false)
        || !manifestBuilder.AddCompilerFactFunctionOwnershipRoot(
            workSemanticRow,
            "localValue",
            "named",
            "local",
            "initialized",
            true,
            false,
            false,
            false,
            false,
            false,
            true,
            true,
            true,
            true,
            localRootRow)
        || !manifestBuilder.SetCompilerFactFunctionOwnershipRootTypeName(
            localRootRow,
            "Demo.Box"))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageFunctionOwnershipFactGraph graph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageFunctionOwnershipFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }
    }

    stack LogicalPackageFunctionOwnershipRow ownership = graph.FunctionOwnershipRowAt(1);
    stack LogicalPackageFunctionOwnershipNameRow implicitDrop = graph.ImplicitDropRowAt(1);
    stack LogicalPackageFunctionOwnershipNameRow move = graph.MoveRowAt(1);
    stack LogicalPackageFunctionOwnershipEventRow moveEvent = graph.EventRowAt(1);
    stack LogicalPackageFunctionOwnershipEventRow dropEvent = graph.EventRowAt(2);
    stack LogicalPackageFunctionOwnershipProjectionRow projection = graph.ProjectionRowAt(1);
    stack LogicalPackageFunctionOwnershipRootRow payloadRoot = graph.RootRowAt(1);
    stack LogicalPackageFunctionOwnershipRootRow localRoot = graph.RootRowAt(2);
    stack LogicalPackageTypeReferenceRow moveEventType =
        graph.TypeReferenceGraph().TypeReferenceAt(moveEvent.PlaceTypeReferenceRow());
    stack LogicalPackageTypeReferenceRow localRootType =
        graph.TypeReferenceGraph().TypeReferenceAt(localRoot.TypeReferenceRow());
    stack LogicalPackageFunctionOwnershipFactTextRow functionNameText =
        graph.TextRowAt(ownership.QualifiedResolvedNameTextRow());
    stack LogicalPackageFunctionOwnershipFactTextRow moveEventKindText =
        graph.TextRowAt(moveEvent.KindTextRow());
    stack LogicalPackageFunctionOwnershipFactTextRow projectionText =
        graph.TextRowAt(projection.ProjectionTextRow());
    stack LogicalPackageFunctionOwnershipFactTextRow localAvailabilityText =
        graph.TextRowAt(localRoot.FinalAvailabilityTextRow());
    stack mut OwnedAscii functionName = new();
    stack mut OwnedAscii moveEventKind = new();
    stack mut OwnedAscii projectionName = new();
    stack mut OwnedAscii localAvailability = new();
    stack mut OwnedAscii moveEventTypeKind = new();
    stack mut OwnedAscii localRootTypeName = new();
    return graph.FunctionOwnershipRowCount() == 1
        && graph.ImplicitDropRowCount() == 1
        && graph.MoveRowCount() == 1
        && graph.EventRowCount() == 2
        && graph.ProjectionRowCount() == 1
        && graph.RootRowCount() == 2
        && graph.TextRowCount() == 15
        && graph.TextByteCount() > 0
        && graph.TypeReferenceCount() == 4
        && ownership.ModuleOrdinal() == 0
        && ownership.FunctionSemanticOrdinal() == 1
        && ownership.OwnershipValid()
        && ownership.FirstImplicitDropRow() == 1
        && ownership.ImplicitDropRowCount() == 1
        && ownership.FirstMoveRow() == 1
        && ownership.MoveRowCount() == 1
        && ownership.FirstEventRow() == 1
        && ownership.EventRowCount() == 2
        && ownership.FirstRootRow() == 1
        && ownership.RootRowCount() == 2
        && implicitDrop.FunctionOwnershipRow() == 1
        && implicitDrop.NameOrdinal() == 0
        && move.FunctionOwnershipRow() == 1
        && move.NameOrdinal() == 0
        && moveEvent.EventOrdinal() == 0
        && moveEvent.HasIndexProjection()
        && moveEvent.HasLocation()
        && moveEvent.HasLocationFilePath()
        && moveEvent.LocationLine() == 12
        && moveEvent.LocationColumn() == 5
        && moveEvent.FirstProjectionRow() == 1
        && moveEvent.ProjectionRowCount() == 1
        && dropEvent.EventOrdinal() == 1
        && !dropEvent.HasIndexProjection()
        && !dropEvent.HasLocation()
        && dropEvent.LocationFilePathTextRow() == 0
        && projection.EventRow() == 1
        && projection.ProjectionOrdinal() == 0
        && payloadRoot.RootOrdinal() == 0
        && !payloadRoot.IsMutable()
        && payloadRoot.IsAddressTaken()
        && payloadRoot.HasMove()
        && !payloadRoot.HasPartialMove()
        && !payloadRoot.HasImplicitDrop()
        && payloadRoot.RequiresDrop()
        && localRoot.RootOrdinal() == 1
        && localRoot.IsMutable()
        && localRoot.HasImplicitDrop()
        && localRoot.HasAssignmentDrop()
        && localRoot.HasReinitialization()
        && moveEventType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.FunctionOwnershipEventPlaceType
        && moveEventType.Summary().PayloadOrdinal() == 0
        && moveEventType.Summary().HasBitWidth()
        && localRootType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.FunctionOwnershipRootType
        && localRootType.Summary().PayloadOrdinal() == 1
        && localRootType.Summary().HasName()
        && functionNameText.TextKind()
            == LogicalPackageFunctionOwnershipFactTextKind.QualifiedResolvedName
        && moveEventKindText.TextKind() == LogicalPackageFunctionOwnershipFactTextKind.EventKind
        && projectionText.TextKind()
            == LogicalPackageFunctionOwnershipFactTextKind.EventProjectionPath
        && localAvailabilityText.TextKind()
            == LogicalPackageFunctionOwnershipFactTextKind.RootFinalAvailability
        && AppendLogicalPackageFunctionOwnershipFactText(graph, functionNameText, functionName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionOwnershipFactText(graph, moveEventKindText, moveEventKind)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionOwnershipFactText(graph, projectionText, projectionName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionOwnershipFactText(
            graph,
            localAvailabilityText,
            localAvailability) == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            moveEvent.PlaceTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Kind,
            0,
            moveEventTypeKind)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            localRoot.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            localRootTypeName)
        && OwnedAsciiEqualsAscii(functionName, "Demo.Work")
        && OwnedAsciiEqualsAscii(moveEventKind, "move")
        && OwnedAsciiEqualsAscii(projectionName, "Field")
        && OwnedAsciiEqualsAscii(localAvailability, "initialized")
        && OwnedAsciiEqualsAscii(moveEventTypeKind, "integer")
        && OwnedAsciiEqualsAscii(localRootTypeName, "Demo.Box");
}

[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesGenericTemplateFunctionHeaders()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] idTemplateRow = 0;
    stack mut u32[0 max] mapTemplateRow = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddGenericTemplateFunction(
            0,
            "Demo.Id#0",
            "Demo.Id",
            "(value)",
            idTemplateRow)
        || !manifestBuilder.AddGenericTemplateFunction(
            0,
            "Demo.Map#0",
            "Demo.Map",
            "(input)",
            mapTemplateRow)
        || !manifestBuilder.SetGenericTemplateFunctionBodyText(
            mapTemplateRow,
            "{ return input; }")
        || !manifestBuilder.SetGenericTemplateFunctionTopLevelStatementCount(mapTemplateRow, 0)
        || !manifestBuilder.SetGenericTemplateFunctionEstimatedBodyCost(mapTemplateRow, 3)
        || !manifestBuilder.SetGenericTemplateFunctionSectionPresence(mapTemplateRow, true, true)
        || !manifestBuilder.SetGenericTemplateFunctionBackendOptimizationMode(
            mapTemplateRow,
            "aggressive"))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageGenericTemplateFactGraph graph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageGenericTemplateFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }
    }

    stack LogicalPackageFunctionTemplateRow idTemplate = graph.FunctionTemplateRowAt(1);
    stack LogicalPackageFunctionTemplateRow mapTemplate = graph.FunctionTemplateRowAt(2);
    stack LogicalPackageGenericTemplateFactTextRow idResolvedText =
        graph.TextRowAt(idTemplate.QualifiedResolvedNameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow mapQualifiedText =
        graph.TextRowAt(mapTemplate.QualifiedNameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow mapBodyText =
        graph.TextRowAt(mapTemplate.BodyTextRow());
    stack LogicalPackageGenericTemplateFactTextRow mapModeText =
        graph.TextRowAt(mapTemplate.BackendOptimizationModeTextRow());
    stack mut OwnedAscii idResolvedName = new();
    stack mut OwnedAscii mapQualifiedName = new();
    stack mut OwnedAscii mapBody = new();
    stack mut OwnedAscii mapMode = new();
    return graph.FunctionTemplateRowCount() == 2
        && graph.TextRowCount() == 8
        && graph.TextByteCount() > 0
        && graph.TypeReferenceCount() == 0
        && graph.TypedTemplateStatementRowCount() == 0
        && idTemplate.ModuleOrdinal() == 0
        && idTemplate.TemplateOrdinal() == 0
        && !idTemplate.HasBodyText()
        && !idTemplate.HasTopLevelStatementCount()
        && !idTemplate.HasEstimatedBodyCost()
        && !idTemplate.HasSemantics()
        && !idTemplate.HasTypedBody()
        && !idTemplate.HasBackendOptimizationMode()
        && mapTemplate.ModuleOrdinal() == 0
        && mapTemplate.TemplateOrdinal() == 1
        && mapTemplate.HasBodyText()
        && mapTemplate.HasTopLevelStatementCount()
        && mapTemplate.TopLevelStatementCount() == 0
        && mapTemplate.HasEstimatedBodyCost()
        && mapTemplate.EstimatedBodyCost() == 3
        && mapTemplate.HasSemantics()
        && mapTemplate.HasTypedBody()
        && mapTemplate.HasBackendOptimizationMode()
        && mapTemplate.DeferredFunctionInstantiationCount() == 0
        && mapTemplate.DeferredTypeInstantiationCount() == 0
        && mapTemplate.ObjectCreationCount() == 0
        && mapTemplate.EnumConstructorCount() == 0
        && mapTemplate.DirectCallCount() == 0
        && mapTemplate.BoundOperationCount() == 0
        && idResolvedText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.QualifiedResolvedName
        && idResolvedText.TextOrdinal() == 0
        && mapQualifiedText.TextKind() == LogicalPackageGenericTemplateFactTextKind.QualifiedName
        && mapQualifiedText.TextOrdinal() == 1
        && mapBodyText.TextKind() == LogicalPackageGenericTemplateFactTextKind.BodyText
        && mapBodyText.TextOrdinal() == 1
        && mapModeText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.BackendOptimizationMode
        && mapModeText.TextOrdinal() == 1
        && AppendLogicalPackageGenericTemplateFactText(graph, idResolvedText, idResolvedName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, mapQualifiedText, mapQualifiedName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, mapBodyText, mapBody)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, mapModeText, mapMode)
            == MemoryStatus.Ok
        && OwnedAsciiEqualsAscii(idResolvedName, "Demo.Id#0")
        && OwnedAsciiEqualsAscii(mapQualifiedName, "Demo.Map")
        && OwnedAsciiEqualsAscii(mapBody, "{ return input; }")
        && OwnedAsciiEqualsAscii(mapMode, "aggressive");
}

[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesGenericTemplateTypedBodyStatements()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] templateRow = 0;
    stack mut u32[0 max] statementRow = 0;
    stack mut u32[0 max] expressionRow = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddGenericTemplateFunction(
            0,
            "Demo.Map#0",
            "Demo.Map",
            "(input)",
            templateRow)
        || !manifestBuilder.AddGenericTemplateTopLevelStatement(
            templateRow,
            "local-variable",
            statementRow)
        || !manifestBuilder.SetGenericTemplateStatementName(statementRow, "result")
        || !manifestBuilder.SetGenericTemplateStatementStorageClass(statementRow, "stack")
        || !manifestBuilder.SetGenericTemplateStatementMutability(statementRow, true, false)
        || !manifestBuilder.SetGenericTemplateStatementType(statementRow, "Integer")
        || !manifestBuilder.SetGenericTemplateStatementTypeIntegerFacts(
            statementRow,
            32,
            "-2147483648",
            "2147483647",
            false)
        || !manifestBuilder.SetGenericTemplateStatementStorageCapacity(statementRow, 4)
        || !manifestBuilder.SetGenericTemplateStatementConstProvenance(statementRow, "literal")
        || !manifestBuilder.AddGenericTemplateExpression(templateRow, "literal", expressionRow)
        || !manifestBuilder.SetGenericTemplateExpressionLiteralText(expressionRow, "1")
        || !manifestBuilder.SetGenericTemplateExpressionType(expressionRow, "Integer")
        || !manifestBuilder.SetGenericTemplateExpressionTypeIntegerFacts(
            expressionRow,
            32,
            "-2147483648",
            "2147483647",
            false)
        || !manifestBuilder.SetGenericTemplateStatementExpression(statementRow, expressionRow))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageGenericTemplateFactGraph graph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageGenericTemplateFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }
    }

    stack LogicalPackageFunctionTemplateRow template = graph.FunctionTemplateRowAt(1);
    stack LogicalPackageTypedTemplateStatementRow statement = graph.TypedTemplateStatementRowAt(1);
    stack LogicalPackageTypedTemplateExpressionRow expression =
        graph.TypedTemplateExpressionRowAt(statement.ExpressionRow());
    stack LogicalPackageTypeReferenceRow statementType =
        graph.TypeReferenceGraph().TypeReferenceAt(statement.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow expressionType =
        graph.TypeReferenceGraph().TypeReferenceAt(expression.TypeReferenceRow());
    stack LogicalPackageGenericTemplateFactTextRow statementKindText =
        graph.TextRowAt(statement.KindTextRow());
    stack LogicalPackageGenericTemplateFactTextRow statementNameText =
        graph.TextRowAt(statement.NameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow expressionKindText =
        graph.TextRowAt(expression.KindTextRow());
    stack LogicalPackageGenericTemplateFactTextRow expressionLiteralText =
        graph.TextRowAt(expression.LiteralTextRow());
    stack mut OwnedAscii statementKind = new();
    stack mut OwnedAscii statementName = new();
    stack mut OwnedAscii expressionKind = new();
    stack mut OwnedAscii expressionLiteral = new();
    stack mut OwnedAscii statementTypeKind = new();
    stack mut OwnedAscii expressionTypeKind = new();
    // Three template identity rows, four statement rows (including storage and
    // const provenance), and two expression rows are preserved.
    return graph.FunctionTemplateRowCount() == 1
        && graph.TextRowCount() == 9
        && graph.TextByteCount() > 0
        && graph.TypeReferenceCount() == 2
        && graph.TypedTemplateStatementRowCount() == 1
        && graph.TypedTemplateExpressionRowCount() == 1
        && template.ModuleOrdinal() == 0
        && template.TemplateOrdinal() == 0
        && template.HasTypedBody()
        && template.HasTopLevelStatementCount()
        && template.TopLevelStatementCount() == 1
        && statement.FunctionTemplateRow() == 1
        && statement.ParentStatementRow() == 0
        && statement.ParentKind() == LogicalPackageTypedTemplateStatementParentKind.TopLevel
        && statement.StatementOrdinal() == 0
        && statement.HasExpression()
        && statement.ExpressionRow() == 1
        && statement.HasName()
        && statement.IsMutable()
        && !statement.IsConstant()
        && statement.HasType()
        && statement.TypeReferenceRow() != 0
        && statement.HasStorageCapacity()
        && statement.StorageCapacity() == 4
        && expression.FunctionTemplateRow() == 1
        && expression.ParentExpressionRow() == 0
        && expression.ParentKind() == LogicalPackageTypedTemplateExpressionParentKind.Root
        && expression.ExpressionOrdinal() == 0
        && expression.HasLiteralText()
        && expression.HasType()
        && expression.TypeReferenceRow() != 0
        && statementType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateStatementType
        && statementType.Summary().PayloadOrdinal() == 0
        && statementType.Summary().HasBitWidth()
        && statementType.Summary().BitWidth() == 32
        && statementType.Summary().HasRangeMin()
        && statementType.Summary().HasRangeMax()
        && statementType.Summary().HasIsUnsigned()
        && !statementType.Summary().IsUnsigned()
        && expressionType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionType
        && expressionType.Summary().PayloadOrdinal() == 0
        && expressionType.Summary().HasBitWidth()
        && expressionType.Summary().BitWidth() == 32
        && statementKindText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.StatementKind
        && statementNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.StatementName
        && expressionKindText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ExpressionKind
        && expressionLiteralText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ExpressionLiteralText
        && AppendLogicalPackageGenericTemplateFactText(graph, statementKindText, statementKind)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, statementNameText, statementName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, expressionKindText, expressionKind)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            expressionLiteralText,
            expressionLiteral) == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            statement.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Kind,
            0,
            statementTypeKind)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            expression.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Kind,
            0,
            expressionTypeKind)
        && OwnedAsciiEqualsAscii(statementKind, "local-variable")
        && OwnedAsciiEqualsAscii(statementName, "result")
        && OwnedAsciiEqualsAscii(expressionKind, "literal")
        && OwnedAsciiEqualsAscii(expressionLiteral, "1")
        && OwnedAsciiEqualsAscii(statementTypeKind, "Integer")
        && OwnedAsciiEqualsAscii(expressionTypeKind, "Integer");
}

[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesGenericTemplateExpressionChildPayloads()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] templateRow = 0;
    stack mut u32[0 max] statementRow = 0;
    stack mut u32[0 max] rootExpressionRow = 0;
    stack mut u32[0 max] leftExpressionRow = 0;
    stack mut u32[0 max] rightExpressionRow = 0;
    stack mut u32[0 max] memberNameRow = 0;
    stack mut u32[0 max] operatorNameRow = 0;
    stack mut u32[0 max] typeArgumentRow = 0;
    stack mut u32[0 max] comptimeValueArgumentRow = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddGenericTemplateFunction(
            0,
            "Demo.Map#0",
            "Demo.Map",
            "(input)",
            templateRow)
        || !manifestBuilder.AddGenericTemplateTopLevelStatement(
            templateRow,
            "expression",
            statementRow)
        || !manifestBuilder.AddGenericTemplateExpression(templateRow, "binary", rootExpressionRow)
        || !manifestBuilder.SetGenericTemplateExpressionType(rootExpressionRow, "Integer")
        || !manifestBuilder.SetGenericTemplateExpressionTypeIntegerFacts(
            rootExpressionRow,
            32,
            "-2147483648",
            "2147483647",
            false)
        || !manifestBuilder.AddGenericTemplateExpressionMemberName(
            rootExpressionRow,
            "Length",
            memberNameRow)
        || !manifestBuilder.AddGenericTemplateExpressionOperatorName(
            rootExpressionRow,
            "+",
            operatorNameRow)
        || !manifestBuilder.AddGenericTemplateExpressionTypeArgument(
            rootExpressionRow,
            "Named",
            typeArgumentRow)
        || !manifestBuilder.SetGenericTemplateExpressionTypeArgumentName(
            typeArgumentRow,
            "Demo.Number")
        || !manifestBuilder.AddGenericTemplateExpressionComptimeValueArgument(
            rootExpressionRow,
            "N",
            "4",
            "Integer",
            true,
            comptimeValueArgumentRow)
        || !manifestBuilder.SetGenericTemplateExpressionComptimeValueArgumentTypeIntegerFacts(
            comptimeValueArgumentRow,
            32,
            "0",
            "4294967295",
            true)
        || !manifestBuilder.SetGenericTemplateExpressionComptimeValueArgumentSymbolicSourceName(
            comptimeValueArgumentRow,
            "N")
        || !manifestBuilder.AddGenericTemplateExpressionArgument(
            rootExpressionRow,
            "name",
            leftExpressionRow)
        || !manifestBuilder.SetGenericTemplateExpressionName(leftExpressionRow, "left")
        || !manifestBuilder.AddGenericTemplateExpressionArgument(
            rootExpressionRow,
            "literal",
            rightExpressionRow)
        || !manifestBuilder.SetGenericTemplateExpressionLiteralText(rightExpressionRow, "2")
        || !manifestBuilder.SetGenericTemplateExpressionType(rightExpressionRow, "Integer")
        || !manifestBuilder.SetGenericTemplateExpressionTypeIntegerFacts(
            rightExpressionRow,
            32,
            "-2147483648",
            "2147483647",
            false)
        || !manifestBuilder.SetGenericTemplateStatementExpression(
            statementRow,
            rootExpressionRow))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageGenericTemplateFactGraph graph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageGenericTemplateFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }
    }

    stack LogicalPackageTypedTemplateStatementRow statement =
        graph.TypedTemplateStatementRowAt(1);
    stack LogicalPackageTypedTemplateExpressionRow rootExpression =
        graph.TypedTemplateExpressionRowAt(statement.ExpressionRow());
    stack LogicalPackageTypedTemplateExpressionRow leftExpression =
        graph.TypedTemplateExpressionRowAt(2);
    stack LogicalPackageTypedTemplateExpressionRow rightExpression =
        graph.TypedTemplateExpressionRowAt(3);
    stack LogicalPackageTypedTemplateExpressionMemberNameRow memberName =
        graph.TypedTemplateExpressionMemberNameRowAt(1);
    stack LogicalPackageTypedTemplateExpressionOperatorNameRow operatorName =
        graph.TypedTemplateExpressionOperatorNameRowAt(1);
    stack LogicalPackageTypedTemplateExpressionTypeArgumentRow typeArgument =
        graph.TypedTemplateExpressionTypeArgumentRowAt(1);
    stack LogicalPackageTypedTemplateExpressionComptimeValueArgumentRow comptimeValueArgument =
        graph.TypedTemplateExpressionComptimeValueArgumentRowAt(1);
    stack LogicalPackageTypeReferenceRow rootType =
        graph.TypeReferenceGraph().TypeReferenceAt(rootExpression.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow rightType =
        graph.TypeReferenceGraph().TypeReferenceAt(rightExpression.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow typeArgumentType =
        graph.TypeReferenceGraph().TypeReferenceAt(typeArgument.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow comptimeValueArgumentType =
        graph.TypeReferenceGraph().TypeReferenceAt(comptimeValueArgument.TypeReferenceRow());
    stack LogicalPackageGenericTemplateFactTextRow memberNameText =
        graph.TextRowAt(memberName.NameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow operatorNameText =
        graph.TextRowAt(operatorName.NameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow leftNameText =
        graph.TextRowAt(leftExpression.NameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow rightLiteralText =
        graph.TextRowAt(rightExpression.LiteralTextRow());
    stack LogicalPackageGenericTemplateFactTextRow comptimeParameterText =
        graph.TextRowAt(comptimeValueArgument.ParameterNameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow comptimeIntegerText =
        graph.TextRowAt(comptimeValueArgument.IntegerValueTextRow());
    stack LogicalPackageGenericTemplateFactTextRow comptimeSymbolicSourceText =
        graph.TextRowAt(comptimeValueArgument.SymbolicSourceNameTextRow());
    stack mut OwnedAscii memberNameValue = new();
    stack mut OwnedAscii operatorNameValue = new();
    stack mut OwnedAscii leftNameValue = new();
    stack mut OwnedAscii rightLiteralValue = new();
    stack mut OwnedAscii comptimeParameterValue = new();
    stack mut OwnedAscii comptimeIntegerValue = new();
    stack mut OwnedAscii comptimeSymbolicSourceValue = new();
    stack mut OwnedAscii typeArgumentNameValue = new();
    stack mut OwnedAscii comptimeTypeKindValue = new();
    return graph.FunctionTemplateRowCount() == 1
        && graph.TextRowCount() == 14
        && graph.TypeReferenceCount() == 4
        && graph.TypedTemplateStatementRowCount() == 1
        && graph.TypedTemplateExpressionRowCount() == 3
        && graph.TypedTemplateExpressionMemberNameRowCount() == 1
        && graph.TypedTemplateExpressionOperatorNameRowCount() == 1
        && graph.TypedTemplateExpressionTypeArgumentRowCount() == 1
        && graph.TypedTemplateExpressionComptimeValueArgumentRowCount() == 1
        && statement.ExpressionRow() == 1
        && rootExpression.ArgumentCount() == 2
        && rootExpression.MemberNameCount() == 1
        && rootExpression.OperatorNameCount() == 1
        && rootExpression.TypeArgumentCount() == 1
        && rootExpression.ComptimeValueArgumentCount() == 1
        && leftExpression.ParentExpressionRow() == 1
        && leftExpression.ParentKind() == LogicalPackageTypedTemplateExpressionParentKind.Argument
        && leftExpression.ExpressionOrdinal() == 0
        && leftExpression.HasName()
        && rightExpression.ParentExpressionRow() == 1
        && rightExpression.ParentKind() == LogicalPackageTypedTemplateExpressionParentKind.Argument
        && rightExpression.ExpressionOrdinal() == 1
        && rightExpression.HasLiteralText()
        && rightExpression.HasType()
        && memberName.ExpressionRow() == 1
        && memberName.MemberOrdinal() == 0
        && operatorName.ExpressionRow() == 1
        && operatorName.OperatorOrdinal() == 0
        && typeArgument.ExpressionRow() == 1
        && typeArgument.TypeArgumentOrdinal() == 0
        && comptimeValueArgument.ExpressionRow() == 1
        && comptimeValueArgument.ArgumentOrdinal() == 0
        && comptimeValueArgument.IsSymbolic()
        && comptimeValueArgument.HasSymbolicSourceName()
        && rootType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionType
        && rootType.Summary().PayloadOrdinal() == 0
        && rightType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionType
        && rightType.Summary().PayloadOrdinal() == 1
        && typeArgumentType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionTypeArgument
        && typeArgumentType.Summary().PayloadOrdinal() == 0
        && comptimeValueArgumentType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionComptimeValueArgumentType
        && comptimeValueArgumentType.Summary().PayloadOrdinal() == 0
        && memberNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ExpressionMemberName
        && operatorNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ExpressionOperatorName
        && leftNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ExpressionName
        && rightLiteralText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ExpressionLiteralText
        && comptimeParameterText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ExpressionComptimeValueArgumentParameterName
        && comptimeIntegerText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ExpressionComptimeValueArgumentIntegerValue
        && comptimeSymbolicSourceText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.ExpressionComptimeValueArgumentSymbolicSourceName
        && AppendLogicalPackageGenericTemplateFactText(graph, memberNameText, memberNameValue)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, operatorNameText, operatorNameValue)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, leftNameText, leftNameValue)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, rightLiteralText, rightLiteralValue)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            comptimeParameterText,
            comptimeParameterValue) == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            comptimeIntegerText,
            comptimeIntegerValue) == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            comptimeSymbolicSourceText,
            comptimeSymbolicSourceValue) == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            typeArgument.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            typeArgumentNameValue)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            comptimeValueArgument.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Kind,
            0,
            comptimeTypeKindValue)
        && OwnedAsciiEqualsAscii(memberNameValue, "Length")
        && OwnedAsciiEqualsAscii(operatorNameValue, "+")
        && OwnedAsciiEqualsAscii(leftNameValue, "left")
        && OwnedAsciiEqualsAscii(rightLiteralValue, "2")
        && OwnedAsciiEqualsAscii(comptimeParameterValue, "N")
        && OwnedAsciiEqualsAscii(comptimeIntegerValue, "4")
        && OwnedAsciiEqualsAscii(comptimeSymbolicSourceValue, "N")
        && OwnedAsciiEqualsAscii(typeArgumentNameValue, "Demo.Number")
        && OwnedAsciiEqualsAscii(comptimeTypeKindValue, "Integer");
}

