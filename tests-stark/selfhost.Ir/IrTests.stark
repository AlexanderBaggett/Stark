[Fact]
fn bool LocalSwitchStatementAssignmentRejectsUnsupportedShapes()
{
    stack mut OwnedAscii s = new();
    return !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: y = 4; case 0: y = 10; default: y = 20; } return y + 1 } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(bool flag) { var y = 0; switch (flag) { case true: y = 4; case true: y = 10; default: y = 20; } return y + 1 } fn main() { return 0 }", s)
        && !CompileModuleFromAst("fn classify(bool flag) { var y = 0; switch (flag) { case 0: y = 4; default: y = 20; } return y + 1 } fn main() { return 0 }", s)
        && !CompileModuleFromAst("fn classify(i64[min max] x) { var y = 0; switch (x) { case true: y = 4; default: y = 20; } return y + 1 } fn main() { return 0 }", s)
        && !CompileModuleFromAst("fn classify(bool flag) { var y = 0; switch (flag) { case true: y = flag; default: y = 20; } return y + 1 } fn main() { return 0 }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: y = 4; case 1: y = 10; } return y + 1 } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: z = 4; default: y = 20; } return y + 1 } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: y = x == 0; default: y = 20; } return y + 1 } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: y = y + 1; default: y = 20; } return y + 1 } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: y = 4; default: y = 20; } var z = y + 1; } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: y = 4; default: y = 20; } var z = y + 1; var z = y + 2; return z } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: y = 4; default: y = 20; } var z = w + 1; var w = y + 2; return z } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: { var a = b + 1; y = a; } default: y = 20; } return y + 1 } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: { var a = 1; } default: y = 20; } return y + 1 } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; var z = 0; switch (x) { case 0: { y = 4; } default: { y = 20; z = 21; } } return y + z } fn main() { return classify(1) }", s)
        && !CompileModuleFromAst("fn classify(x) { var y = 0; var z = 0; switch (x) { case 0: { y = 4; y = 5; } default: { y = 20; z = 21; } } return y + z } fn main() { return classify(1) }", s)
        && CompileModuleFromAst("fn classify(x) { var y = 0; switch (x) { case 0: y = 4; default: y = 20; } return y + 1 } fn main() { return classify(1) }", s);
}

[Fact]
fn bool CompilesLocalPrefixedBracedBooleanTerminalIfFromAst()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn pick(x) { var y = x + 1; if y < 10 { return y < 5; } else { return x == 10; } } fn main() { return pick(3) }", s);
    return ok
        && System.Text.Contains(s.View(), "define internal dso_local i64 @f1(i64 %p0)")
        && System.Text.Contains(s.View(), "br i1")
        && System.Text.Contains(s.View(), "icmp slt i64")
        && System.Text.Contains(s.View(), "icmp eq i64")
        && System.Text.Contains(s.View(), "zext i1")
        && !System.Text.Contains(s.View(), " phi ")
        && ClangVerifiesLlvmText(s);
}

