                          "TargetType": { "Kind": "integer", "BitWidth": 8, "RangeMin": "0", "RangeMax": "90" }
                        }
                      ],
                      "TypedBody": {
                        "Statements": [
                          {
                            "Kind": "return",
                            "Expression": {
                              "Kind": "conversion",
                              "Type": { "Kind": "integer", "BitWidth": 8, "RangeMin": "0", "RangeMax": "100" },
                              "Arguments": [
                                { "Kind": "literal", "LiteralText": "44", "Type": { "Kind": "integer", "BitWidth": 32 } }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "QualifiedResolvedName": "Demo.NeedsBinding#0",
                      "QualifiedName": "Demo.NeedsBinding",
                      "OverloadKey": "(value)",
                      "TopLevelStatementCount": 1,
                      "TypedBody": {
                        "Statements": [
                          {
                            "Kind": "return",
                            "Expression": {
                              "Kind": "name",
                              "Name": "value",
                              "Type": { "Kind": "integer", "BitWidth": 32 }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageGenericTemplateFactGraph graph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageGenericTemplateFactJsonGraph(
            manifestJson,
            0,
            graph))
        {
            return false;
        }
    }

    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> functions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts unconstrainedExpectedReturnFacts = new();
    stack mut ValueFacts sevenExpectedReturnFacts = new();
    sevenExpectedReturnFacts.SetIntegerRange(0, 11);
    stack mut MirFuncId sevenFunction = MirFuncIdOf(0);
    stack mut MirFuncId yesFunction = MirFuncIdOf(0);
    stack mut MirFuncId foldedFunction = MirFuncIdOf(0);
    stack mut MirFuncId logicalFunction = MirFuncIdOf(0);
    stack mut MirFuncId conditionalFunction = MirFuncIdOf(0);
    stack mut MirFuncId richFoldFunction = MirFuncIdOf(0);
    stack mut MirFuncId unsignedSevenFunction = MirFuncIdOf(0);
    stack mut MirFuncId convertedFunction = MirFuncIdOf(0);
    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            1,
            MirType.I32,
            false,
            sevenExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            sevenFunction) != ImportedTemplateMirLoweringStatus.Ok
        || LowerImportedTemplateScalarReturnToMir(
            graph,
            2,
            MirType.I1,
            false,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            yesFunction) != ImportedTemplateMirLoweringStatus.Ok
        || LowerImportedTemplateScalarReturnToMir(
            graph,
            3,
            MirType.I32,
            false,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            foldedFunction) != ImportedTemplateMirLoweringStatus.Ok
        || LowerImportedTemplateScalarReturnToMir(
            graph,
            4,
            MirType.I1,
            false,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            logicalFunction) != ImportedTemplateMirLoweringStatus.Ok)
    {
        return false;
    }

    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            5,
            MirType.I32,
            false,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            conditionalFunction) != ImportedTemplateMirLoweringStatus.Ok)
    {
        return false;
    }

    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            6,
            MirType.I1,
            false,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            richFoldFunction) != ImportedTemplateMirLoweringStatus.Ok)
    {
        return false;
    }

    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            7,
            MirType.I32,
            true,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            unsignedSevenFunction) != ImportedTemplateMirLoweringStatus.Ok)
    {
        return false;
    }

    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            8,
            MirType.I16,
            false,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            convertedFunction) != ImportedTemplateMirLoweringStatus.Ok)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] instructionCount = instructions.Count();
    stack u64[0 2 ** 63 - 1] blockCount = blocks.Count();
    stack u64[0 2 ** 63 - 1] functionCount = functions.Count();
    stack mut MirFuncId mismatchedFunction = MirFuncIdOf(0);
    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            1,
            MirType.I64,
            false,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            mismatchedFunction) != ImportedTemplateMirLoweringStatus.ReturnTypeMismatch
        || mismatchedFunction.IsValid()
        || instructions.Count() != instructionCount
        || blocks.Count() != blockCount
        || functions.Count() != functionCount
        || valueFacts.Count() != instructionCount
        || functionReturnFacts.Count() != functionCount)
    {
        return false;
    }

    stack mut ValueFacts rejectedExpectedReturnFacts = new();
    rejectedExpectedReturnFacts.SetIntegerRange(8, 10);
    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            1,
            MirType.I32,
            false,
            rejectedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            mismatchedFunction) != ImportedTemplateMirLoweringStatus.ReturnFactMismatch
        || mismatchedFunction.IsValid()
        || instructions.Count() != instructionCount
        || blocks.Count() != blockCount
        || functions.Count() != functionCount
        || valueFacts.Count() != instructionCount
        || functionReturnFacts.Count() != functionCount)
    {
        return false;
    }

    stack mut MirFuncId unsupportedFunction = MirFuncIdOf(0);
    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            9,
            MirType.I8,
            false,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            unsupportedFunction) != ImportedTemplateMirLoweringStatus.UnsupportedBody
        || unsupportedFunction.IsValid()
        || instructions.Count() != instructionCount
        || blocks.Count() != blockCount
        || functions.Count() != functionCount
        || valueFacts.Count() != instructionCount
        || functionReturnFacts.Count() != functionCount)
    {
        return false;
    }

    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            10,
            MirType.I32,
            false,
            unconstrainedExpectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            unsupportedFunction) != ImportedTemplateMirLoweringStatus.UnsupportedBody
        || unsupportedFunction.IsValid()
        || instructions.Count() != instructionCount
        || blocks.Count() != blockCount
        || functions.Count() != functionCount
        || valueFacts.Count() != instructionCount
        || functionReturnFacts.Count() != functionCount)
    {
        return false;
    }

    stack MirInstruction sevenLiteral = instructions.Get(1);
    stack MirInstruction yesLiteral = instructions.Get(2);
    stack MirInstruction foldedLiteral = instructions.Get(3);
    stack MirInstruction logicalLiteral = instructions.Get(4);
    stack MirInstruction conditionalLiteral = instructions.Get(5);
    stack MirInstruction richFoldLiteral = instructions.Get(6);
    stack MirInstruction unsignedSevenLiteral = instructions.Get(7);
    stack MirInstruction convertedLiteral = instructions.Get(8);
    stack ValueFacts sevenValueFacts = ValueFactsForMirValue(valueFacts, MirValueIdOf(1));
    stack ValueFacts yesValueFacts = ValueFactsForMirValue(valueFacts, MirValueIdOf(2));
    stack ValueFacts foldedValueFacts = ValueFactsForMirValue(valueFacts, MirValueIdOf(3));
    stack ValueFacts logicalValueFacts = ValueFactsForMirValue(valueFacts, MirValueIdOf(4));
    stack ValueFacts conditionalValueFacts = ValueFactsForMirValue(valueFacts, MirValueIdOf(5));
    stack ValueFacts richFoldValueFacts = ValueFactsForMirValue(valueFacts, MirValueIdOf(6));
    stack ValueFacts unsignedSevenValueFacts = ValueFactsForMirValue(valueFacts, MirValueIdOf(7));
    stack ValueFacts convertedValueFacts = ValueFactsForMirValue(valueFacts, MirValueIdOf(8));
    stack ValueFacts sevenReturnFacts = ValueFactsAtIndex(functionReturnFacts, sevenFunction.Index());
    stack ValueFacts yesReturnFacts = ValueFactsAtIndex(functionReturnFacts, yesFunction.Index());
    stack ValueFacts foldedReturnFacts = ValueFactsAtIndex(functionReturnFacts, foldedFunction.Index());
    stack ValueFacts logicalReturnFacts = ValueFactsAtIndex(functionReturnFacts, logicalFunction.Index());
    stack ValueFacts conditionalReturnFacts = ValueFactsAtIndex(
        functionReturnFacts,
        conditionalFunction.Index());
    stack ValueFacts richFoldReturnFacts = ValueFactsAtIndex(
        functionReturnFacts,
        richFoldFunction.Index());
    stack ValueFacts unsignedSevenReturnFacts = ValueFactsAtIndex(
        functionReturnFacts,
        unsignedSevenFunction.Index());
    stack ValueFacts convertedReturnFacts = ValueFactsAtIndex(
        functionReturnFacts,
        convertedFunction.Index());
    stack MirFunction seven = functions.Get(sevenFunction.Index());
    stack mut IrTable<ValueFacts> noParameterFacts = new();
    stack mut IrTable<ValueFacts> noGlobalFacts = new();
    stack mut OwnedAscii llvm = new();
    if (EmitLlvmDefinitionWithRangeFacts(
            instructions,
            blocks,
            "imported_const",
            sevenReturnFacts,
            noParameterFacts,
            valueFacts,
            noGlobalFacts,
            functionReturnFacts,
            0,
            seven.EntryIndex(),
            seven.FirstInstrIndex(),
            seven.OwnedInstrCount(),
            llvm) != MemoryStatus.Ok)
    {
        return false;
    }

    return sevenFunction.Index() == 1
        && yesFunction.Index() == 2
        && foldedFunction.Index() == 3
        && logicalFunction.Index() == 4
        && conditionalFunction.Index() == 5
        && richFoldFunction.Index() == 6
        && unsignedSevenFunction.Index() == 7
        && convertedFunction.Index() == 8
        && instructions.Count() == 8
        && blocks.Count() == 8
        && functions.Count() == 8
        && sevenLiteral.Opcode() == MirOp.ConstInt
        && sevenLiteral.ResultType() == MirType.I32
        && sevenLiteral.Immediate() == 7
        && yesLiteral.Opcode() == MirOp.ConstInt
        && yesLiteral.ResultType() == MirType.I1
        && yesLiteral.Immediate() == 1
        && foldedLiteral.Opcode() == MirOp.ConstInt
        && foldedLiteral.ResultType() == MirType.I32
        && foldedLiteral.Immediate() == 10
        && logicalLiteral.Opcode() == MirOp.ConstInt
        && logicalLiteral.ResultType() == MirType.I1
        && logicalLiteral.Immediate() == 1
        && conditionalLiteral.Opcode() == MirOp.ConstInt
        && conditionalLiteral.ResultType() == MirType.I32
        && conditionalLiteral.Immediate() == 42
        && richFoldLiteral.Opcode() == MirOp.ConstInt
        && richFoldLiteral.ResultType() == MirType.I1
        && richFoldLiteral.Immediate() == 1
        && unsignedSevenLiteral.Opcode() == MirOp.ConstInt
        && unsignedSevenLiteral.ResultType() == MirType.I32
        && unsignedSevenLiteral.Immediate() == 7
        && convertedLiteral.Opcode() == MirOp.ConstInt
        && convertedLiteral.ResultType() == MirType.I16
        && convertedLiteral.Immediate() == 44
        && sevenValueFacts.HasIntegerRange()
        && sevenValueFacts.IntegerRangeLower() == 7
        && sevenValueFacts.IntegerRangeUpperExclusive() == 8
        && yesValueFacts.HasIntegerRange()
        && yesValueFacts.IntegerRangeLower() == 1
        && yesValueFacts.IntegerRangeUpperExclusive() == 2
        && foldedValueFacts.HasIntegerRange()
        && foldedValueFacts.IntegerRangeLower() == 10
        && foldedValueFacts.IntegerRangeUpperExclusive() == 11
        && logicalValueFacts.HasIntegerRange()
        && logicalValueFacts.IntegerRangeLower() == 1
        && logicalValueFacts.IntegerRangeUpperExclusive() == 2
        && conditionalValueFacts.HasIntegerRange()
        && conditionalValueFacts.IntegerRangeLower() == 42
        && conditionalValueFacts.IntegerRangeUpperExclusive() == 43
        && richFoldValueFacts.HasIntegerRange()
        && richFoldValueFacts.IntegerRangeLower() == 1
        && richFoldValueFacts.IntegerRangeUpperExclusive() == 2
        && unsignedSevenValueFacts.HasIntegerRange()
        && unsignedSevenValueFacts.IntegerRangeLower() == 7
        && unsignedSevenValueFacts.IntegerRangeUpperExclusive() == 8
        && convertedValueFacts.HasIntegerRange()
        && convertedValueFacts.IntegerRangeLower() == 44
        && convertedValueFacts.IntegerRangeUpperExclusive() == 45
        && sevenReturnFacts.HasIntegerRange()
        && sevenReturnFacts.IntegerRangeLower() == 7
        && sevenReturnFacts.IntegerRangeUpperExclusive() == 8
        && yesReturnFacts.HasIntegerRange()
        && yesReturnFacts.IntegerRangeLower() == 1
        && yesReturnFacts.IntegerRangeUpperExclusive() == 2
        && foldedReturnFacts.HasIntegerRange()
        && foldedReturnFacts.IntegerRangeLower() == 10
        && foldedReturnFacts.IntegerRangeUpperExclusive() == 11
        && logicalReturnFacts.HasIntegerRange()
        && logicalReturnFacts.IntegerRangeLower() == 1
        && logicalReturnFacts.IntegerRangeUpperExclusive() == 2
        && conditionalReturnFacts.HasIntegerRange()
        && conditionalReturnFacts.IntegerRangeLower() == 42
        && conditionalReturnFacts.IntegerRangeUpperExclusive() == 43
        && richFoldReturnFacts.HasIntegerRange()
        && richFoldReturnFacts.IntegerRangeLower() == 1
        && richFoldReturnFacts.IntegerRangeUpperExclusive() == 2
        && unsignedSevenReturnFacts.HasIntegerRange()
        && unsignedSevenReturnFacts.IntegerRangeLower() == 7
        && unsignedSevenReturnFacts.IntegerRangeUpperExclusive() == 8
        && convertedReturnFacts.HasIntegerRange()
        && convertedReturnFacts.IntegerRangeLower() == 44
        && convertedReturnFacts.IntegerRangeUpperExclusive() == 45
        && LlvmTextEquals(
            llvm,
            "define range(i32 7, 8) i32 @imported_const() {\nb1:\n  %v1 = add i32 0, 7\n  ret i32 %v1\n}\n");
}

[Fact]
