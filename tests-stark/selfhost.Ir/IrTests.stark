[Fact]
fn bool CompileFunctionRejectsUnprovenReturnRangeAttributes()
{
    stack mut OwnedAscii good = new();
    stack mut OwnedAscii literalTooWide = new();
    stack mut OwnedAscii paramTooWide = new();
    return CompileFunctionToLlvm("fn i64[0 10] good() { return 7 }", good)
        && LlvmTextEquals(good, "define range(i64 0, 11) i64 @main() {\nb1:\n  %v1 = add i64 0, 7\n  ret i64 %v1\n}\n")
        && !CompileFunctionToLlvm("fn i64[0 10] bad() { return 99 }", literalTooWide)
        && !CompileFunctionToLlvm("fn i64[0 10] bad(i64[0 max] x) { return x }", paramTooWide);
}

