[Fact]
fn bool LogicalPackageManifestJsonBuilderWritesGenericTemplateDeferredInstantiations()
{
    stack mut LogicalPackageImageBuilder builder = new();
    if (!builder.SetRootModule("Demo") || !builder.SetLibraryFileName("Demo"))
    {
        return false;
    }

    stack mut LogicalPackageManifestJsonBuilder manifestBuilder = new();
    stack mut u32[0 max] templateRow = 0;
    stack mut u32[0 max] deferredFunctionRow = 0;
    stack mut u32[0 max] typeArgumentRow = 0;
    stack mut u32[0 max] comptimeValueArgumentRow = 0;
    stack mut u32[0 max] deferredTypeRow = 0;
    if (!manifestBuilder.AddModule("Demo")
        || !manifestBuilder.AddGenericTemplateFunction(
            0,
            "Demo.Map#0",
            "Demo.Map",
            "(input)",
            templateRow)
        || !manifestBuilder.AddGenericTemplateDeferredFunctionInstantiation(
            templateRow,
            "Demo.Id",
            deferredFunctionRow)
        || !manifestBuilder.AddGenericTemplateDeferredFunctionInstantiationTypeArgument(
            deferredFunctionRow,
            "Named",
            typeArgumentRow)
        || !manifestBuilder.SetGenericTemplateDeferredFunctionInstantiationTypeArgumentName(
            typeArgumentRow,
            "Demo.Number")
        || !manifestBuilder.AddGenericTemplateDeferredFunctionInstantiationComptimeValueArgument(
            deferredFunctionRow,
            "N",
            "8",
            "Integer",
            true,
            comptimeValueArgumentRow)
        || !manifestBuilder.SetGenericTemplateDeferredFunctionInstantiationComptimeValueArgumentTypeIntegerFacts(
            comptimeValueArgumentRow,
            32,
            "0",
            "4294967295",
            true)
        || !manifestBuilder.SetGenericTemplateDeferredFunctionInstantiationComptimeValueArgumentSymbolicSourceName(
            comptimeValueArgumentRow,
            "N")
        || !manifestBuilder.AddGenericTemplateDeferredTypeInstantiation(
            templateRow,
            "Named",
            deferredTypeRow)
        || !manifestBuilder.SetGenericTemplateDeferredTypeInstantiationTypeName(
            deferredTypeRow,
            "Demo.Box"))
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    stack mut LogicalPackageGenericTemplateFactGraph graph = new();
    unsafe
    {
        switch (WriteLogicalPackageManifestJson(writer, builder, manifestBuilder))
        {
            case JsonStatus.Err(var writeError):
                return false;
            case JsonStatus.Ok:
        }

        stack ascii manifestJson = writer.View();
        if (!TryMaterializeLogicalPackageGenericTemplateFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }
    }

    stack LogicalPackageFunctionTemplateRow template = graph.FunctionTemplateRowAt(1);
    stack LogicalPackageDeferredFunctionInstantiationRow deferredFunction =
        graph.DeferredFunctionInstantiationRowAt(1);
    stack LogicalPackageDeferredFunctionInstantiationTypeArgumentRow typeArgument =
        graph.DeferredFunctionInstantiationTypeArgumentRowAt(1);
    stack LogicalPackageDeferredFunctionInstantiationComptimeValueArgumentRow comptimeArgument =
        graph.DeferredFunctionInstantiationComptimeValueArgumentRowAt(1);
    stack LogicalPackageDeferredTypeInstantiationRow deferredType =
        graph.DeferredTypeInstantiationRowAt(1);
    stack LogicalPackageTypeReferenceRow typeArgumentType =
        graph.TypeReferenceGraph().TypeReferenceAt(typeArgument.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow comptimeArgumentType =
        graph.TypeReferenceGraph().TypeReferenceAt(comptimeArgument.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow deferredTypeReference =
        graph.TypeReferenceGraph().TypeReferenceAt(deferredType.TypeReferenceRow());
    stack LogicalPackageGenericTemplateFactTextRow calleeNameText =
        graph.TextRowAt(deferredFunction.CalleeTemplateNameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow parameterNameText =
        graph.TextRowAt(comptimeArgument.ParameterNameTextRow());
    stack LogicalPackageGenericTemplateFactTextRow integerValueText =
        graph.TextRowAt(comptimeArgument.IntegerValueTextRow());
    stack LogicalPackageGenericTemplateFactTextRow symbolicSourceNameText =
        graph.TextRowAt(comptimeArgument.SymbolicSourceNameTextRow());
    stack mut OwnedAscii calleeName = new();
    stack mut OwnedAscii parameterName = new();
    stack mut OwnedAscii integerValue = new();
    stack mut OwnedAscii symbolicSourceName = new();
    stack mut OwnedAscii typeArgumentName = new();
    stack mut OwnedAscii deferredTypeName = new();
    return graph.FunctionTemplateRowCount() == 1
        && graph.TypeReferenceCount() == 3
        && graph.DeferredFunctionInstantiationRowCount() == 1
        && graph.DeferredFunctionInstantiationTypeArgumentRowCount() == 1
        && graph.DeferredFunctionInstantiationComptimeValueArgumentRowCount() == 1
        && graph.DeferredTypeInstantiationRowCount() == 1
        && template.DeferredFunctionInstantiationCount() == 1
        && template.DeferredTypeInstantiationCount() == 1
        && deferredFunction.FunctionTemplateRow() == 1
        && deferredFunction.InstantiationOrdinal() == 0
        && deferredFunction.TypeArgumentCount() == 1
        && deferredFunction.ComptimeValueArgumentCount() == 1
        && typeArgument.InstantiationRow() == 1
        && typeArgument.TypeArgumentOrdinal() == 0
        && typeArgument.TypeReferenceRow() != 0
        && comptimeArgument.InstantiationRow() == 1
        && comptimeArgument.ArgumentOrdinal() == 0
        && comptimeArgument.TypeReferenceRow() != 0
        && comptimeArgument.IsSymbolic()
        && comptimeArgument.HasSymbolicSourceName()
        && deferredType.FunctionTemplateRow() == 1
        && deferredType.InstantiationOrdinal() == 0
        && deferredType.TypeReferenceRow() != 0
        && typeArgumentType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateDeferredFunctionInstantiationTypeArgument
        && typeArgumentType.Summary().PayloadOrdinal() == 0
        && comptimeArgumentType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateDeferredFunctionInstantiationComptimeValueArgumentType
        && comptimeArgumentType.Summary().PayloadOrdinal() == 0
        && comptimeArgumentType.Summary().HasBitWidth()
        && comptimeArgumentType.Summary().BitWidth() == 32
        && comptimeArgumentType.Summary().HasIsUnsigned()
        && comptimeArgumentType.Summary().IsUnsigned()
        && deferredTypeReference.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.GenericTemplateDeferredTypeInstantiationType
        && deferredTypeReference.Summary().PayloadOrdinal() == 0
        && calleeNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.DeferredFunctionInstantiationCalleeTemplateName
        && parameterNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.DeferredFunctionInstantiationComptimeValueArgumentParameterName
        && integerValueText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.DeferredFunctionInstantiationComptimeValueArgumentIntegerValue
        && symbolicSourceNameText.TextKind()
            == LogicalPackageGenericTemplateFactTextKind.DeferredFunctionInstantiationComptimeValueArgumentSymbolicSourceName
        && AppendLogicalPackageGenericTemplateFactText(graph, calleeNameText, calleeName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, parameterNameText, parameterName)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(graph, integerValueText, integerValue)
            == MemoryStatus.Ok
        && AppendLogicalPackageGenericTemplateFactText(
            graph,
            symbolicSourceNameText,
            symbolicSourceName) == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            typeArgument.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            typeArgumentName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            deferredType.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            deferredTypeName)
        && OwnedAsciiEqualsAscii(calleeName, "Demo.Id")
        && OwnedAsciiEqualsAscii(parameterName, "N")
        && OwnedAsciiEqualsAscii(integerValue, "8")
        && OwnedAsciiEqualsAscii(symbolicSourceName, "N")
        && OwnedAsciiEqualsAscii(typeArgumentName, "Demo.Number")
        && OwnedAsciiEqualsAscii(deferredTypeName, "Demo.Box");
}

