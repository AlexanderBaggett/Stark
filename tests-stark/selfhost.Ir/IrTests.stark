                      "QualifiedName": "Demo.Box",
                      "Visibility": "public",
                      "Kind": "struct",
                      "Fields": [],
                      "BackendOptimizationMode": "aggressive",
                      "StructLayout": "C",
                      "PackBytes": 1,
                      "AlignBytes": 8,
                      "ImplementedTraits": [ "Demo.Drawable" ],
                      "ImplementedTraitTypes": [
                        { "Kind": "Named", "Name": "Demo.Drawable" }
                      ],
                      "AssociatedTypes": [
