import Compiler.Ir
import Compiler.Mir
import System.Memory
import System.Text
import System.Runtime.Buffer
import System.Testing
import System.IO
[Collection("ir")]
module IrTests

[Fact]
fn bool TypedHandleRoundTripsIndex()
{
    // A handle wraps its 1-based index and reads it back; a non-zero index is valid.
    stack TypeId id = TypeIdOf(5);
    return id.Index() == 5 && id.IsValid();
}

[Fact]
fn bool DefaultHandleIsInvalidZero()
{
    // A default-constructed handle is the invalid sentinel (index 0), as is `Of(0)`.
    stack mut TypeId fresh = new();
    return fresh.Index() == 0
        && !fresh.IsValid()
        && !TypeIdOf(0).IsValid();
}

[Fact]
fn bool HandleEqualityComparesIndex()
{
    // Equality is by index; distinct indices are unequal.
    return MirValueIdOf(3).Equals(MirValueIdOf(3))
        && !MirValueIdOf(3).Equals(MirValueIdOf(4));
}

[Fact]
fn bool DistinctHandleKindsAreSeparateTypes()
{
    // The id kinds are distinct value types over the same index space — a SymbolId
    // and a TypeId built from the same index are independent values (the compiler
    // rejects passing one where the other is expected; here we just confirm both
    // round-trip their index).
    stack SymbolId sym = SymbolIdOf(7);
    stack TypeId ty = TypeIdOf(7);
    return sym.Index() == 7 && ty.Index() == 7;
}

[Fact]
fn bool IrTableAddsRowsWithOneBasedIndices()
{
    // The first row gets index 1 (0 stays the invalid sentinel), the second index 2,
    // and `Count` tracks the row total.
    stack mut IrTable<MirValueId> table = new();
    stack u32[0 max] first = table.Add(MirValueIdOf(100));
    stack u32[0 max] second = table.Add(MirValueIdOf(200));
    return first == 1 && second == 2 && table.Count() == 2;
}

[Fact]
fn bool IrTableGetReadsBackTheStoredRow()
{
    // A row read back at its index equals what was added.
    stack mut IrTable<MirValueId> table = new();
    stack u32[0 max] idx = table.Add(MirValueIdOf(42));
    stack MirValueId row = table.Get(idx);
    return table.Contains(idx) && row.Index() == 42;
}

[Fact]
fn bool IrTableContainsRejectsZeroAndOutOfRange()
{
    // Index 0 (invalid) and indices past the end are not contained.
    stack mut IrTable<TypeId> table = new();
    stack u32[0 max] idx = table.Add(TypeIdOf(1));
    return !table.Contains(0)
        && table.Contains(1)
        && !table.Contains(2);
}

[Fact]
fn bool ValueFactsDefaultToAbsent()
{
    // A fresh fact record has no attached facts.
    stack ValueFacts vf = new();
    return !vf.HasAlignment()
        && vf.AlignmentBytes() == 0
        && !vf.HasCallingAbi()
        && !vf.HasNoAlias()
        && !vf.Volatile()
        && !vf.HasIntegerRange();
}

[Fact]
fn bool ValueFactsSetAndQuery()
{
    // Setting facts makes them present and queryable.
    stack mut ValueFacts vf = new();
    vf.SetAlignment(8);
    vf.SetCallingAbi(AbiKind.CAbi);
    vf.MarkNoAlias();
    vf.SetIntegerRange(2, 9);
    return vf.HasAlignment()
        && vf.AlignmentBytes() == 8
        && vf.HasCallingAbi()
        && vf.HasNoAlias()
        && vf.HasIntegerRange()
        && vf.IntegerRangeLower() == 2
        && vf.IntegerRangeUpperExclusive() == 9
        && !vf.Volatile();
}

[Fact]
fn bool ValueFactsInheritCarriesPresentFactsOnly()
{
    // `InheritFrom` copies the source's present facts and leaves the destination's
    // own facts untouched where the source is absent.
    stack mut ValueFacts src = new();
    src.SetAlignment(16);
    src.MarkNoAlias();
    src.SetIntegerRange(0, 11);

    stack mut ValueFacts dst = new();
    dst.MarkVolatile();
    dst.InheritFrom(src);

    return dst.HasAlignment()
        && dst.AlignmentBytes() == 16
        && dst.HasNoAlias()
        && dst.HasIntegerRange()
        && dst.IntegerRangeLower() == 0
        && dst.IntegerRangeUpperExclusive() == 11
        && dst.Volatile()
        && !dst.HasCallingAbi();
}

[Fact]
fn bool ValueFactsInheritFromEmptyLeavesDestination()
{
    // Inheriting from a source with no facts changes nothing on the destination.
    stack ValueFacts empty = new();
    stack mut ValueFacts dst = new();
    dst.SetAlignment(4);
    dst.InheritFrom(empty);
    return dst.HasAlignment() && dst.AlignmentBytes() == 4;
}

[Fact]
fn bool ValueFactsStoreInIrTableByHandle()
{
    // Fact records attach to values through an `IrTable<ValueFacts>` keyed by the
    // value handle's index — the "one record per value" layout of doc 24 §4.
    stack mut IrTable<ValueFacts> facts = new();
    stack mut ValueFacts vf = new();
    vf.SetAlignment(32);
    stack u32[0 max] idx = facts.Add(vf);
    stack ValueFacts read = facts.Get(idx);
    return facts.Contains(idx) && read.AlignmentBytes() == 32;
}

[Fact]
fn bool MirEmitsSequentialValueIds()
{
    // Each emitted instruction gets the next 1-based value id over the instruction
    // table; the table tracks the count and which values are defined.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 10);
    stack MirValueId b = MirConstInt(instrs, 20);
    stack MirValueId sum = MirAdd(instrs, a, b);
    return a.Index() == 1
        && b.Index() == 2
        && sum.Index() == 3
        && instrs.Count() == 3
        && MirDefines(instrs, sum)
        && !MirDefines(instrs, MirValueIdOf(4));
}

[Fact]
fn bool MirConstInstructionCarriesImmediate()
{
    // A `ConstInt` reads back its opcode and immediate.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId c = MirConstInt(instrs, 42);
    return MirOpcodeOf(instrs, c) == MirOp.ConstInt && MirImmediateOf(instrs, c) == 42;
}

[Fact]
fn bool MirBinaryInstructionReferencesOperandsByHandle()
{
    // A `Mul` records its opcode and its two operand value ids.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 3);
    stack MirValueId b = MirConstInt(instrs, 4);
    stack MirValueId prod = MirMul(instrs, a, b);
    stack MirValueId opA = MirOperandAOf(instrs, prod);
    stack MirValueId opB = MirOperandBOf(instrs, prod);
    return MirOpcodeOf(instrs, prod) == MirOp.Mul
        && opA.Equals(a)
        && opB.Equals(b);
}

[Fact]
fn bool MirReturnInstructionRecordsReturnedValue()
{
    // A `Return` records the returned value as operand A.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId v = MirConstInt(instrs, 7);
    stack MirValueId ret = MirReturn(instrs, v);
    stack MirValueId retOperand = MirOperandAOf(instrs, ret);
    return MirOpcodeOf(instrs, ret) == MirOp.Return
        && retOperand.Equals(v);
}

[Fact]
fn bool MirReturnBlockRecordsReturnedValue()
{
    // A block terminating in `return v` reads back its terminator kind and value.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 99);
    stack MirBlockId b = MirReturnBlock(blocks, v);
    stack MirValueId got = MirBlockReturnValue(blocks, b);
    return b.Index() == 1
        && MirBlockTerminator(blocks, b) == MirTermKind.Return
        && got.Equals(v);
}

[Fact]
fn bool MirBranchBlockRecordsTarget()
{
    // An unconditional branch records its target block id.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 1);
    stack MirBlockId dest = MirReturnBlock(blocks, v);
    stack MirBlockId br = MirBranchBlock(blocks, dest);
    stack MirBlockId got = MirBlockBranchTarget(blocks, br);
    return MirBlockTerminator(blocks, br) == MirTermKind.Branch
        && got.Equals(dest);
}

[Fact]
fn bool MirCondBlockRecordsConditionAndTargets()
{
    // A conditional branch records its condition value and both target blocks.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId cond = MirConstInt(instrs, 1);
    stack MirValueId tv = MirConstInt(instrs, 10);
    stack MirValueId ev = MirConstInt(instrs, 20);
    stack MirBlockId thenB = MirReturnBlock(blocks, tv);
    stack MirBlockId elseB = MirReturnBlock(blocks, ev);
    stack MirBlockId br = MirCondBlock(blocks, cond, thenB, elseB);
    stack MirValueId gotCond = MirBlockCondValue(blocks, br);
    stack MirBlockId gotThen = MirBlockCondThen(blocks, br);
    stack MirBlockId gotElse = MirBlockCondElse(blocks, br);
    return MirBlockTerminator(blocks, br) == MirTermKind.CondBranch
        && gotCond.Equals(cond)
        && gotThen.Equals(thenB)
        && gotElse.Equals(elseB);
}

[Fact]
fn bool MirTailCallBlockRecordsPayload()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId tail = MirTailCall1(instrs, MirFuncIdOf(3), p0);
    stack MirBlockId b = MirTailCallBlock(blocks, tail);
    stack MirValueId got = MirBlockTailCallValue(blocks, b);
    return MirOpcodeOf(instrs, tail) == MirOp.TailCall
        && MirCalleeOf(instrs, tail).Index() == 3
        && MirOperandAOf(instrs, tail).Equals(p0)
        && MirBlockTerminator(blocks, b) == MirTermKind.TailCall
        && got.Equals(tail);
}

[Fact]
fn bool MirBlockTerminatorIsUnterminatedOutOfRange()
{
    // Querying a block id that was never created reads as unterminated.
    stack mut IrTable<MirBlock> blocks = new();
    return MirBlockTerminator(blocks, MirBlockIdOf(7)) == MirTermKind.Unterminated;
}

[Fact]
fn bool MirFunctionRecordsEntryAndRanges()
{
    // A function owns the blocks/instructions emitted for it and names its entry.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    // Body: %1 = const 2; %2 = const 3; %3 = add %1 %2.
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId sum = MirAdd(instrs, a, b);
    // One block returning the sum.
    stack MirBlockId entry = MirReturnBlock(blocks, sum);
    stack MirFuncId f = MirDefineFunction(funcs, entry, entry, 1, a, 3);
    stack MirBlockId gotEntry = MirFunctionEntry(funcs, f);
    return f.Index() == 1
        && gotEntry.Equals(entry)
        && MirFunctionBlockCount(funcs, f) == 1
        && MirFunctionInstrCount(funcs, f) == 3;
}

[Fact]
fn bool MirFunctionOwnershipTracksRanges()
{
    // Ownership queries respect each function's half-open block/instruction ranges.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    // Function 1: instrs %1..%2, block #1.
    stack MirValueId a = MirConstInt(instrs, 1);
    stack MirValueId b = MirConstInt(instrs, 2);
    stack MirBlockId blk1 = MirReturnBlock(blocks, b);
    stack MirFuncId funcA = MirDefineFunction(funcs, blk1, blk1, 1, a, 2);
    // Function 2: instr %3, block #2.
    stack MirValueId c = MirConstInt(instrs, 3);
    stack MirBlockId blk2 = MirReturnBlock(blocks, c);
    stack MirFuncId funcB = MirDefineFunction(funcs, blk2, blk2, 1, c, 1);
    return MirFunctionOwnsBlock(funcs, funcA, blk1)
        && !MirFunctionOwnsBlock(funcs, funcA, blk2)
        && MirFunctionOwnsValue(funcs, funcA, a)
        && !MirFunctionOwnsValue(funcs, funcA, c)
        && MirFunctionOwnsBlock(funcs, funcB, blk2)
        && MirFunctionOwnsValue(funcs, funcB, c);
}

[Fact]
fn bool MirFunctionQueriesRejectOutOfRange()
{
    // An undefined function id yields an invalid entry and zero counts.
    stack mut IrTable<MirFunction> funcs = new();
    stack MirBlockId entry = MirFunctionEntry(funcs, MirFuncIdOf(3));
    return !entry.IsValid()
        && MirFunctionBlockCount(funcs, MirFuncIdOf(3)) == 0
        && MirFunctionInstrCount(funcs, MirFuncIdOf(3)) == 0;
}

// Builds an `OwnedAscii` from `expectedText` and compares it to `actual`.
fn bool LlvmTextEquals(borrow OwnedAscii actual, const ascii expectedText)
{
    stack mut OwnedAscii expected = new();
    switch (expected.AppendConstAscii(expectedText))
    {
        case MemoryStatus.Ok:
            return OwnedAscii.Equals(actual, expected);
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmForStraightLineFunction()
{
    // The integer MIR lowers to LLVM textual IR: each value is a `%vN` register,
    // ConstInt materializes via `add i64 0, imm`, and Return becomes `ret i64`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId sum = MirAdd(instrs, a, b);
    stack MirValueId unusedRet = MirReturn(instrs, sum);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmFunction(instrs, "add2", 1, 4, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @add2() {\nentry:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmForMixedArithmetic()
{
    // sub/mul opcodes lower to their LLVM mnemonics over `%vN` operands.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 10);
    stack MirValueId b = MirConstInt(instrs, 4);
    stack MirValueId diff = MirSub(instrs, a, b);
    stack MirValueId prod = MirMul(instrs, diff, b);
    stack MirValueId unusedRet = MirReturn(instrs, prod);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmFunction(instrs, "calc", 1, 5, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @calc() {\nentry:\n  %v1 = add i64 0, 10\n  %v2 = add i64 0, 4\n  %v3 = sub i64 %v1, %v2\n  %v4 = mul i64 %v3, %v2\n  ret i64 %v4\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmReturnTerminator()
{
    // A Return block lowers to `ret i64 %vN`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId a = MirConstInt(instrs, 1);
    stack MirValueId b = MirConstInt(instrs, 2);
    stack MirValueId sum = MirAdd(instrs, a, b);
    stack MirBlockId blk = MirReturnBlock(blocks, sum);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTerminator(instrs, blocks,blk, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "  ret i64 %v3\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmBranchTerminator()
{
    // An unconditional Branch block lowers to `br label %bN`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirConstInt(instrs, 5);
    stack MirBlockId dest = MirReturnBlock(blocks, v);
    stack MirBlockId br = MirBranchBlock(blocks, dest);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTerminator(instrs, blocks,br, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "  br label %b1\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCondBranchTerminator()
{
    // A CondBranch block lowers to `br i1 %vC, label %bT, label %bE`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId cond = MirConstInt(instrs, 1);
    stack MirValueId tv = MirConstInt(instrs, 10);
    stack MirValueId ev = MirConstInt(instrs, 20);
    stack MirBlockId thenB = MirReturnBlock(blocks, tv);
    stack MirBlockId elseB = MirReturnBlock(blocks, ev);
    stack MirBlockId br = MirCondBlock(blocks, cond, thenB, elseB);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTerminator(instrs, blocks,br, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "  br i1 %v1, label %b1, label %b2\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmReturnsParameterDirectly()
{
    // Regression: an identity function `fn id(x) { return x }` returns its parameter,
    // which must lower to `ret i64 %p0` — not an undefined `%vN` (a Param emits no
    // body line). The block terminator routes the value through the param-aware path.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirBlockId entry = MirReturnBlock(blocks, p0);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "id", 1, entry.Index(), 1, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @id(i64 %p0) {\nb1:\n  ret i64 %p0\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCondBranchOnParameter()
{
    // Regression: a CondBranch whose condition is a parameter references `%pK`, not an
    // undefined `%vN`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId cond = MirParam(instrs, 0);
    stack MirValueId tv = MirConstInt(instrs, 1);
    stack MirValueId ev = MirConstInt(instrs, 2);
    stack MirBlockId thenB = MirReturnBlock(blocks, tv);
    stack MirBlockId elseB = MirReturnBlock(blocks, ev);
    stack MirBlockId br = MirCondBlock(blocks, cond, thenB, elseB);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTerminator(instrs, blocks, br, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "  br i1 %p0, label %b1, label %b2\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirDecodersGuardOnOpcode()
{
    // Regression: the shared immediate field is not misread across opcodes — a callee
    // id read as a param index yields 0, and a param index read as a callee is invalid.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId call = MirCall(instrs, MirFuncIdOf(7));
    stack MirValueId param = MirParam(instrs, 3);
    return MirParamIndexOf(instrs, call) == 0
        && !MirCalleeOf(instrs, param).IsValid()
        && MirParamIndexOf(instrs, param) == 3
        && MirCalleeOf(instrs, call).Equals(MirFuncIdOf(7));
}

[Fact]
fn bool MirFunctionDoesNotOwnInvalidId()
{
    // Regression: a function whose recorded range starts at the 0 sentinel never
    // reports the invalid id 0 as owned.
    stack mut IrTable<MirFunction> funcs = new();
    stack MirFuncId f = MirDefineFunction(funcs, MirBlockIdOf(0), MirBlockIdOf(0), 1, MirValueIdOf(0), 1);
    return !MirFunctionOwnsBlock(funcs, f, MirBlockIdOf(0))
        && !MirFunctionOwnsValue(funcs, f, MirValueIdOf(0));
}

[Fact]
fn bool EmitsLlvmSingleBlockDefinition()
{
    // A whole function emits as `define i64 @name() { bN: <instrs> <terminator> }`,
    // the terminator coming from the entry block (not a MirReturn instruction).
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId a = MirConstInt(instrs, 2);
    stack MirValueId b = MirConstInt(instrs, 3);
    stack MirValueId sum = MirAdd(instrs, a, b);
    stack MirBlockId entry = MirReturnBlock(blocks, sum);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinition(instrs, blocks, "f", entry.Index(), 1, 3, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @f() {\nb1:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

// Emits two labelled blocks back to back into `sink`, each owning one instruction.
fn MemoryStatus EmitTwoBlockBody(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, u32[0 max] entryIndex, u32[0 max] secondIndex, mut borrow OwnedAscii sink)
{
    try EmitLlvmLabeledBlock(instrs, blocks, entryIndex, 1, 1, sink);
    try EmitLlvmLabeledBlock(instrs, blocks, secondIndex, 2, 1, sink);
    return MemoryStatus.Ok;
}

[Fact]
fn bool EmitsLlvmTwoBlockFunctionBody()
{
    // A two-block function: entry computes a value and branches; the second block
    // computes another value and returns. Each block emits its label, body, terminator.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v1 = MirConstInt(instrs, 7);
    stack MirValueId v2 = MirConstInt(instrs, 8);
    stack MirBlockId second = MirReturnBlock(blocks, v2);
    stack MirBlockId entry = MirBranchBlock(blocks, second);
    stack mut OwnedAscii sink = new();
    switch (EmitTwoBlockBody(instrs, blocks, entry.Index(), second.Index(), sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "b2:\n  %v1 = add i64 0, 7\n  br label %b1\nb1:\n  %v2 = add i64 0, 8\n  ret i64 %v2\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirCallRecordsCallee()
{
    // A Call instruction records its opcode and the callee function id.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId result = MirCall(instrs, MirFuncIdOf(5));
    stack MirFuncId callee = MirCalleeOf(instrs, result);
    return MirOpcodeOf(instrs, result) == MirOp.Call
        && callee.Equals(MirFuncIdOf(5));
}

[Fact]
fn bool MirParamRecordsIndex()
{
    // A Param instruction records its opcode and 0-based parameter index.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId p = MirParam(instrs, 3);
    return MirOpcodeOf(instrs, p) == MirOp.Param
        && MirParamIndexOf(instrs, p) == 3;
}

[Fact]
fn bool EmitsLlvmFunctionWithParams()
{
    // A function over its parameters declares them in the signature and references
    // them as `%pK` in the body; the Param instructions emit no body lines.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId p1 = MirParam(instrs, 1);
    stack MirValueId sum = MirAdd(instrs, p0, p1);
    stack MirBlockId entry = MirReturnBlock(blocks, sum);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "addp", 2, entry.Index(), 1, 3, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @addp(i64 %p0, i64 %p1) {\nb1:\n  %v3 = add i64 %p0, %p1\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCallInstruction()
{
    // A Call lowers to `%vN = call i64 @fK()`; its result feeds the return.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId result = MirCall(instrs, MirFuncIdOf(2));
    stack MirValueId unusedRet = MirReturn(instrs, result);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmFunction(instrs, "caller", 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @caller() {\nentry:\n  %v1 = call i64 @f2()\n  ret i64 %v1\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCallWithArguments()
{
    // A two-argument call lowers to `%vN = call i64 @fK(i64 %a, i64 %b)`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 4);
    stack MirValueId b = MirConstInt(instrs, 5);
    stack MirValueId result = MirCall2(instrs, MirFuncIdOf(3), a, b);
    stack MirValueId unusedRet = MirReturn(instrs, result);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmFunction(instrs, "caller", 1, 4, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @caller() {\nentry:\n  %v1 = add i64 0, 4\n  %v2 = add i64 0, 5\n  %v3 = call i64 @f3(i64 %v1, i64 %v2)\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCallForwardingAParameter()
{
    // A function that forwards its parameter as a call argument: the param lowers to
    // `%p0` in the argument position.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId result = MirCall1(instrs, MirFuncIdOf(1), p0);
    stack MirBlockId entry = MirReturnBlock(blocks, result);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "fwd", 1, entry.Index(), 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @fwd(i64 %p0) {\nb1:\n  %v2 = call i64 @f1(i64 %p0)\n  ret i64 %v2\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmRangeAttributesForReturnAndParameters()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirBlockId entry = MirReturnBlock(blocks, p0);

    stack mut ValueFacts returnFacts = new();
    returnFacts.SetIntegerRange(0, 11);
    stack mut ValueFacts p0Facts = new();
    p0Facts.SetIntegerRange(1, 6);
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack u32[0 max] addedParamFact = paramFacts.Add(p0Facts);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFacts(instrs, blocks, "bounded", returnFacts, paramFacts, valueFacts, globalFacts, functionReturnFacts, 1, entry.Index(), 1, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define range(i64 0, 11) i64 @bounded(i64 range(i64 1, 6) %p0) {\nb1:\n  ret i64 %p0\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmRangeMetadataForCallResultsAndArguments()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId p0 = MirParam(instrs, 0);
    stack MirValueId result = MirCall1(instrs, MirFuncIdOf(2), p0);
    stack MirBlockId entry = MirReturnBlock(blocks, result);

    stack mut ValueFacts emptyReturn = new();
    stack mut ValueFacts p0Facts = new();
    p0Facts.SetIntegerRange(0, 11);
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack u32[0 max] addedParamFact = paramFacts.Add(p0Facts);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts noFact = new();
    stack u32[0 max] addedFirstReturnFact = functionReturnFacts.Add(noFact);
    stack mut ValueFacts f2Facts = new();
    f2Facts.SetIntegerRange(5, 9);
    stack u32[0 max] addedSecondReturnFact = functionReturnFacts.Add(f2Facts);

    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFacts(instrs, blocks, "caller", emptyReturn, paramFacts, valueFacts, globalFacts, functionReturnFacts, 1, entry.Index(), 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @caller(i64 range(i64 0, 11) %p0) {\nb1:\n  %v2 = call i64 @f2(i64 range(i64 0, 11) %p0), !range !0\n  ret i64 %v2\n}\n!0 = !{i64 5, i64 9}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmRangeMetadataForGlobalLoads()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId value = MirLoadGlobal(instrs, 1);
    stack MirBlockId entry = MirReturnBlock(blocks, value);

    stack mut ValueFacts emptyReturn = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut ValueFacts g1Facts = new();
    g1Facts.SetIntegerRange(-3, 4);
    stack u32[0 max] g1 = globalFacts.Add(g1Facts);
    stack mut IrTable<ValueFacts> functionReturnFacts = new();

    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFacts(instrs, blocks, "readg", emptyReturn, paramFacts, valueFacts, globalFacts, functionReturnFacts, 0, entry.Index(), 1, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @readg() {\nb1:\n  %v1 = load i64, ptr @g1, !range !0\n  ret i64 %v1\n}\n!0 = !{i64 -3, i64 4}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

