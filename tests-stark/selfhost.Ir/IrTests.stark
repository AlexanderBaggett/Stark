[Fact]
fn bool BooleanTerminalIntegerSwitchPreservesDeclaredBoolReturnType()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn bool classify(i64[min max] x) { switch (x) { case 0: return x == 0; case 1: return x < 0; default: return x == 2; } } fn main() { return 0 }", s);
    return ok
        && System.Text.Contains(s.View(), "define internal dso_local i1 @f1(i64 %p0)")
        && System.Text.Contains(s.View(), "ret i1")
        && !System.Text.Contains(s.View(), "zext i1")
        && ClangVerifiesLlvmText(s);
}

[Fact]
fn bool PackageTablesPreserveTerminalBooleanSwitch()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Classify(bool flag) { switch (flag) { case true: return 10; case false: return 20; default: return 30; } }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId condition = MirBlockCondValue(blocks, MirBlockIdOf(1));
    stack MirValueId trueReturn = MirBlockReturnValue(blocks, MirBlockIdOf(2));
    stack MirValueId falseReturn = MirBlockReturnValue(blocks, MirBlockIdOf(3));
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 3
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 3
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 3
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.Return
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.Return
        && MirBlockCondThen(blocks, MirBlockIdOf(1)) == MirBlockIdOf(2)
        && MirBlockCondElse(blocks, MirBlockIdOf(1)) == MirBlockIdOf(3)
        && MirOpcodeOf(instrs, condition) == MirOp.Param
        && MirValueType(instrs, condition.Index()) == MirType.I1
        && MirOpcodeOf(instrs, trueReturn) == MirOp.ConstInt
        && MirOpcodeOf(instrs, falseReturn) == MirOp.ConstInt
        && MirImmediateOf(instrs, trueReturn) == 10
        && MirImmediateOf(instrs, falseReturn) == 20;
}

