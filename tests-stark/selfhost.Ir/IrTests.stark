fn bool PackageTablesPreserveBooleanLocalIfStatementAssignmentThenReturn()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Pick(i64[min max] x) { var y = 0 == 0; if x < 10 y = x < 5; else y = x == 10; return y == (x < 5) }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 4
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 4
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 8
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(4)) == MirTermKind.Return;
}

