                0,
                LogicalPackageTypedDeclarationKind.Function,
                0,
                LogicalPackageTypedTypeReferenceSource.FunctionParameter,
                1,
                rejected,
                rejectedKind,
                rejectedName)
            && !TryReadLogicalPackageTypeReferenceJsonSummary(
                manifestJson,
                0,
                LogicalPackageTypedDeclarationKind.Type,
                0,
                LogicalPackageTypedTypeReferenceSource.MethodReturn,
                0,
                rejected,
                rejectedKind,
                rejectedName)
            && !TryReadLogicalPackageTypedCallableTypeReferenceJsonSummary(
                manifestJson,
                0,
                LogicalPackageTypedCallableKind.Method,
                0,
                0,
                LogicalPackageTypedTypeReferenceSource.FunctionReturn,
                0,
                rejected,
                rejectedKind,
                rejectedName)
            && !TryReadLogicalPackageTypeReferenceJsonSummary(
                malformedTypeReferenceJson,
                0,
                LogicalPackageTypedDeclarationKind.Type,
                0,
                LogicalPackageTypedTypeReferenceSource.TypeField,
                0,
                rejected,
                rejectedKind,
                rejectedName);
    }
}

[Fact]
fn bool LogicalPackageImageMaterializesTypedDeclarationTypeReferenceGraphRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "TypedInterface": {
                  "Functions": [],
                  "Types": [],
                  "Globals": [],
                  "TypeAliases": [
                    {
                      "Name": "Alias",
                      "QualifiedName": "Demo.Alias",
                      "Visibility": "public",
                      "TargetType": {
                        "Kind": "Named",
                        "Name": "Demo.Target",
                        "TypeArguments": [
                          {
                            "Kind": "RawPointer",
                            "IsMutablePointer": true,
                            "ElementType": {
                              "Kind": "Integer",
                              "BitWidth": 8,
                              "RangeMin": "0",
                              "RangeMax": "255",
                              "IsUnsigned": true
                            }
                          },
                          {
                            "Kind": "FunctionPointer",
                            "FunctionKind": "finite law",
                            "FunctionAbi": "c",
                            "FunctionIsUnsafe": true,
                            "FunctionIsTailCallable": true,
                            "ReturnType": { "Kind": "Void" },
                            "ParameterTypes": [ { "Kind": "Named", "Name": "Demo.Param" } ],
                            "ParameterRawPointerElementCountExpressions": [ "count", null ],
                            "DisjointParameterGroups": [
                              {
                                "ParameterNames": [ "buffer", "count" ],
                                "Regions": [
                                  {
                                    "ParameterName": "buffer",
                                    "StartExpression": "0",
                                    "CountExpression": "count"
                                  },
                                  {
                                    "ParameterName": "other",
                                    "CountExpression": "count"
                                  }
                                ]
                              }
                            ],
                            "OverlapParameterGroups": [
                              { "ParameterNames": [ "buffer", "alias" ] }
                            ],
                            "SameParameterGroups": [
                              { "ParameterNames": [ "buffer", "same" ] }
                            ],
                            "PointeeDeadOnReturnParameterNames": [ "buffer" ]
                          }
                        ],
                        "ComptimeValueArguments": [
                          {
                            "ParameterName": "N",
                            "IntegerValue": "4",
                            "Type": { "Kind": "Integer", "BitWidth": 32 },
                            "IsSymbolic": true,
                            "SymbolicSourceName": "N"
                          }
                        ],
                        "AssociatedOwnerType": { "Kind": "Named", "Name": "Demo.Owner" },
                        "AssociatedTypeName": "Item",
                        "SourceAliasName": "SourceAlias"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedNestedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "TypedInterface": {
                "Functions": [],
                "Types": [],
                "Globals": [],
                "TypeAliases": [
                  {
                    "Name": "Alias",
                    "QualifiedName": "Demo.Alias",
                    "Visibility": "public",
                    "TargetType": {
                      "Kind": "Named",
                      "TypeArguments": [ { "Name": "MissingKind" } ]
                    }
                  }
                ]
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageTypeReferenceGraph graph = new();
    stack mut LogicalPackageTypeReferenceGraph rejectedGraph = new();
    stack mut u32[0 max] rootRow = 0;
    stack mut u32[0 max] rejectedRootRow = 0;
    stack mut u32[0 max] rawPointerRow = 0;
    stack mut u32[0 max] functionPointerRow = 0;
    stack mut u32[0 max] comptimeTypeRow = 0;
    stack mut u32[0 max] associatedOwnerRow = 0;
    stack mut u32[0 max] elementTypeRow = 0;
    stack mut u32[0 max] returnTypeRow = 0;
    stack mut u32[0 max] parameterTypeRow = 0;
    stack mut u32[0 max] comptimeArgumentRow = 0;
    stack mut u32[0 max] disjointGroupRow = 0;
    stack mut u32[0 max] overlapGroupRow = 0;
    stack mut u32[0 max] sameGroupRow = 0;
    stack mut OwnedAscii rootKind = new();
    stack mut OwnedAscii rootName = new();
    stack mut OwnedAscii associatedTypeName = new();
    stack mut OwnedAscii sourceAliasName = new();
    stack mut OwnedAscii comptimeParameterName = new();
    stack mut OwnedAscii comptimeIntegerValue = new();
    stack mut OwnedAscii symbolicSourceName = new();
    stack mut OwnedAscii rawPointerKind = new();
    stack mut OwnedAscii functionPointerKind = new();
    stack mut OwnedAscii functionKind = new();
    stack mut OwnedAscii functionAbi = new();
    stack mut OwnedAscii parameterExpression = new();
    stack mut OwnedAscii missingParameterExpression = new();
    stack mut OwnedAscii deadParameterName = new();
    stack mut OwnedAscii elementRangeMin = new();
    stack mut OwnedAscii elementRangeMax = new();
    stack mut OwnedAscii associatedOwnerName = new();
    stack mut OwnedAscii parameterTypeName = new();
    stack mut OwnedAscii disjointFirstName = new();
    stack mut OwnedAscii disjointRegionParameterName = new();
    stack mut OwnedAscii disjointRegionStartExpression = new();
    stack mut OwnedAscii disjointRegionCountExpression = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageTypeReferenceJsonGraph(
            manifestJson,
            0,
            LogicalPackageTypedDeclarationKind.TypeAlias,
            0,
            LogicalPackageTypedTypeReferenceSource.TypeAliasTarget,
            0,
            graph,
            rootRow))
        {
            return false;
        }
    }

    stack LogicalPackageTypeReferenceRow root = graph.TypeReferenceAt(rootRow);
    stack LogicalPackageTypeReferenceSummary rootSummary = root.Summary();
    if (rootSummary.TypeArgumentCount() != 2
        || rootSummary.ComptimeValueArgumentCount() != 1
        || !rootSummary.HasAssociatedOwnerType()
        || !rootSummary.HasAssociatedTypeName()
        || !rootSummary.HasSourceAliasName())
    {
        return false;
    }

    if (!TryFindLogicalPackageTypeReferenceChild(graph, rootRow, LogicalPackageTypeReferenceChildKind.TypeArgument, 0, rawPointerRow)
        || !TryFindLogicalPackageTypeReferenceChild(graph, rootRow, LogicalPackageTypeReferenceChildKind.TypeArgument, 1, functionPointerRow)
        || !TryFindLogicalPackageTypeReferenceChild(graph, rootRow, LogicalPackageTypeReferenceChildKind.ComptimeValueArgumentType, 0, comptimeTypeRow)
        || !TryFindLogicalPackageTypeReferenceChild(graph, rootRow, LogicalPackageTypeReferenceChildKind.AssociatedOwnerType, 0, associatedOwnerRow)
        || !TryFindLogicalPackageTypeReferenceChild(graph, rawPointerRow, LogicalPackageTypeReferenceChildKind.ElementType, 0, elementTypeRow)
        || !TryFindLogicalPackageTypeReferenceChild(graph, functionPointerRow, LogicalPackageTypeReferenceChildKind.ReturnType, 0, returnTypeRow)
        || !TryFindLogicalPackageTypeReferenceChild(graph, functionPointerRow, LogicalPackageTypeReferenceChildKind.ParameterType, 0, parameterTypeRow))
    {
        return false;
    }

    if (!TryFindLogicalPackageTypeReferenceComptimeValueArgument(graph, rootRow, 0, comptimeArgumentRow)
        || !TryFindLogicalPackageTypeReferenceParameterGroup(
            graph,
            functionPointerRow,
            LogicalPackageTypeReferenceParameterGroupKind.Disjoint,
            0,
            disjointGroupRow)
        || !TryFindLogicalPackageTypeReferenceParameterGroup(
            graph,
            functionPointerRow,
            LogicalPackageTypeReferenceParameterGroupKind.Overlap,
            0,
            overlapGroupRow)
        || !TryFindLogicalPackageTypeReferenceParameterGroup(
            graph,
            functionPointerRow,
            LogicalPackageTypeReferenceParameterGroupKind.Same,
            0,
            sameGroupRow))
    {
        return false;
    }

    stack LogicalPackageTypeReferenceRow functionPointer = graph.TypeReferenceAt(functionPointerRow);
    stack LogicalPackageTypeReferenceSummary functionPointerSummary = functionPointer.Summary();
    stack LogicalPackageTypeReferenceRow elementType = graph.TypeReferenceAt(elementTypeRow);
    stack LogicalPackageTypeReferenceSummary elementTypeSummary = elementType.Summary();
    stack LogicalPackageTypeReferenceComptimeValueArgumentRow comptimeArgument =
        graph.ComptimeValueArgumentRowAt(comptimeArgumentRow);
    stack LogicalPackageTypeReferenceParameterGroupRow disjointGroup = graph.ParameterGroupRowAt(disjointGroupRow);
    stack LogicalPackageTypeReferenceParameterGroupRow overlapGroup = graph.ParameterGroupRowAt(overlapGroupRow);
    stack LogicalPackageTypeReferenceParameterGroupRow sameGroup = graph.ParameterGroupRowAt(sameGroupRow);
    stack LogicalPackageTypeReferenceParameterGroupNameRow disjointFirstNameRow =
        graph.ParameterGroupNameRowAt(disjointGroup.FirstNameRow());
    stack LogicalPackageTypeReferenceParameterGroupRegionRow disjointFirstRegionRow =
        graph.ParameterGroupRegionRowAt(disjointGroup.FirstRegionRow());
    stack LogicalPackageTypeReferenceTextRow disjointFirstNameTextRow =
        graph.TextRowAt(disjointFirstNameRow.NameTextRow());
    stack LogicalPackageTypeReferenceTextRow disjointRegionParameterNameTextRow =
        graph.TextRowAt(disjointFirstRegionRow.ParameterNameTextRow());
    stack LogicalPackageTypeReferenceTextRow disjointRegionStartExpressionTextRow =
        graph.TextRowAt(disjointFirstRegionRow.StartExpressionTextRow());
    stack LogicalPackageTypeReferenceTextRow disjointRegionCountExpressionTextRow =
        graph.TextRowAt(disjointFirstRegionRow.CountExpressionTextRow());
    unsafe
    {
        return graph.TypeReferenceCount() == 8
            && graph.ChildRowCount() == 7
            && graph.ComptimeValueArgumentRowCount() == 1
            && graph.ParameterGroupRowCount() == 3
            && graph.ParameterGroupNameRowCount() == 6
            && graph.ParameterGroupRegionRowCount() == 2
            && graph.TextRowCount() >= 20
            && graph.TextByteCount() > 0
            && root.ChildRowCount() == 4
            && root.ComptimeValueArgumentRowCount() == 1
            && functionPointer.ParameterGroupRowCount() == 3
            && functionPointerSummary.HasFunctionKind()
            && functionPointerSummary.HasFunctionAbi()
            && functionPointerSummary.HasFunctionIsUnsafe()
            && functionPointerSummary.FunctionIsUnsafe()
            && functionPointerSummary.HasFunctionIsTailCallable()
            && functionPointerSummary.FunctionIsTailCallable()
            && functionPointerSummary.HasReturnType()
            && functionPointerSummary.ParameterTypeCount() == 1
            && functionPointerSummary.ParameterRawPointerElementCountExpressionCount() == 2
            && functionPointerSummary.DisjointParameterGroupCount() == 1
            && functionPointerSummary.OverlapParameterGroupCount() == 1
            && functionPointerSummary.SameParameterGroupCount() == 1
            && functionPointerSummary.PointeeDeadOnReturnParameterNameCount() == 1
            && elementTypeSummary.HasBitWidth()
            && elementTypeSummary.BitWidth() == 8
            && elementTypeSummary.HasRangeMin()
            && elementTypeSummary.HasRangeMax()
            && elementTypeSummary.HasIsUnsigned()
            && elementTypeSummary.IsUnsigned()
            && comptimeArgument.TypeReferenceRow() == rootRow
            && comptimeArgument.ArgumentOrdinal() == 0
            && comptimeArgument.TypeChildTypeReferenceRow() == comptimeTypeRow
            && comptimeArgument.IsSymbolic()
            && comptimeArgument.HasSymbolicSourceName()
            && graph.ContainsTextRow(comptimeArgument.ParameterNameTextRow())
            && graph.ContainsTextRow(comptimeArgument.IntegerValueTextRow())
            && graph.ContainsTextRow(comptimeArgument.SymbolicSourceNameTextRow())
            && disjointGroup.GroupKind() == LogicalPackageTypeReferenceParameterGroupKind.Disjoint
            && disjointGroup.NameRowCount() == 2
            && disjointGroup.RegionRowCount() == 2
            && overlapGroup.GroupKind() == LogicalPackageTypeReferenceParameterGroupKind.Overlap
            && overlapGroup.NameRowCount() == 2
            && sameGroup.GroupKind() == LogicalPackageTypeReferenceParameterGroupKind.Same
            && sameGroup.NameRowCount() == 2
            && disjointFirstRegionRow.HasStartExpression()
            && disjointFirstRegionRow.HasCountExpression()
            && TryAppendLogicalPackageTypeReferenceText(graph, rootRow, LogicalPackageTypeReferenceTextKind.Kind, 0, rootKind)
            && TryAppendLogicalPackageTypeReferenceText(graph, rootRow, LogicalPackageTypeReferenceTextKind.Name, 0, rootName)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                rootRow,
                LogicalPackageTypeReferenceTextKind.AssociatedTypeName,
                0,
                associatedTypeName)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                rootRow,
                LogicalPackageTypeReferenceTextKind.SourceAliasName,
                0,
                sourceAliasName)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                rootRow,
                LogicalPackageTypeReferenceTextKind.ComptimeValueArgumentParameterName,
                0,
                comptimeParameterName)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                rootRow,
                LogicalPackageTypeReferenceTextKind.ComptimeValueArgumentIntegerValue,
                0,
                comptimeIntegerValue)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                rootRow,
                LogicalPackageTypeReferenceTextKind.ComptimeValueArgumentSymbolicSourceName,
                0,
                symbolicSourceName)
            && TryAppendLogicalPackageTypeReferenceText(graph, rawPointerRow, LogicalPackageTypeReferenceTextKind.Kind, 0, rawPointerKind)
            && TryAppendLogicalPackageTypeReferenceText(graph, functionPointerRow, LogicalPackageTypeReferenceTextKind.Kind, 0, functionPointerKind)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                functionPointerRow,
                LogicalPackageTypeReferenceTextKind.FunctionKind,
                0,
                functionKind)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                functionPointerRow,
                LogicalPackageTypeReferenceTextKind.FunctionAbi,
                0,
                functionAbi)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                functionPointerRow,
                LogicalPackageTypeReferenceTextKind.ParameterRawPointerElementCountExpression,
                0,
                parameterExpression)
            && !TryAppendLogicalPackageTypeReferenceText(
                graph,
                functionPointerRow,
                LogicalPackageTypeReferenceTextKind.ParameterRawPointerElementCountExpression,
                1,
                missingParameterExpression)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                functionPointerRow,
                LogicalPackageTypeReferenceTextKind.PointeeDeadOnReturnParameterName,
                0,
                deadParameterName)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                elementTypeRow,
                LogicalPackageTypeReferenceTextKind.RangeMin,
                0,
                elementRangeMin)
            && TryAppendLogicalPackageTypeReferenceText(
                graph,
                elementTypeRow,
                LogicalPackageTypeReferenceTextKind.RangeMax,
                0,
                elementRangeMax)
            && AppendLogicalPackageTypeReferenceText(
                graph,
                disjointFirstNameTextRow,
                disjointFirstName) == MemoryStatus.Ok
            && AppendLogicalPackageTypeReferenceText(
                graph,
                disjointRegionParameterNameTextRow,
                disjointRegionParameterName) == MemoryStatus.Ok
            && AppendLogicalPackageTypeReferenceText(
                graph,
                disjointRegionStartExpressionTextRow,
                disjointRegionStartExpression) == MemoryStatus.Ok
            && AppendLogicalPackageTypeReferenceText(
                graph,
                disjointRegionCountExpressionTextRow,
                disjointRegionCountExpression) == MemoryStatus.Ok
            && TryAppendLogicalPackageTypeReferenceText(graph, associatedOwnerRow, LogicalPackageTypeReferenceTextKind.Name, 0, associatedOwnerName)
            && TryAppendLogicalPackageTypeReferenceText(graph, parameterTypeRow, LogicalPackageTypeReferenceTextKind.Name, 0, parameterTypeName)
            && OwnedAsciiEqualsAscii(rootKind, "Named")
            && OwnedAsciiEqualsAscii(rootName, "Demo.Target")
            && OwnedAsciiEqualsAscii(associatedTypeName, "Item")
            && OwnedAsciiEqualsAscii(sourceAliasName, "SourceAlias")
            && OwnedAsciiEqualsAscii(comptimeParameterName, "N")
            && OwnedAsciiEqualsAscii(comptimeIntegerValue, "4")
            && OwnedAsciiEqualsAscii(symbolicSourceName, "N")
            && OwnedAsciiEqualsAscii(rawPointerKind, "RawPointer")
            && OwnedAsciiEqualsAscii(functionPointerKind, "FunctionPointer")
            && OwnedAsciiEqualsAscii(functionKind, "finite law")
            && OwnedAsciiEqualsAscii(functionAbi, "c")
            && OwnedAsciiEqualsAscii(parameterExpression, "count")
            && OwnedAsciiEqualsAscii(deadParameterName, "buffer")
            && OwnedAsciiEqualsAscii(elementRangeMin, "0")
            && OwnedAsciiEqualsAscii(elementRangeMax, "255")
            && OwnedAsciiEqualsAscii(disjointFirstName, "buffer")
            && OwnedAsciiEqualsAscii(disjointRegionParameterName, "buffer")
            && OwnedAsciiEqualsAscii(disjointRegionStartExpression, "0")
            && OwnedAsciiEqualsAscii(disjointRegionCountExpression, "count")
            && OwnedAsciiEqualsAscii(associatedOwnerName, "Demo.Owner")
            && OwnedAsciiEqualsAscii(parameterTypeName, "Demo.Param")
            && !TryMaterializeLogicalPackageTypeReferenceJsonGraph(
                malformedNestedJson,
                0,
                LogicalPackageTypedDeclarationKind.TypeAlias,
                0,
                LogicalPackageTypedTypeReferenceSource.TypeAliasTarget,
                0,
                rejectedGraph,
                rejectedRootRow);
    }
}

[Fact]
fn bool LogicalPackageImageMaterializesTypedCallableMethodTypeReferenceGraphRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "TypedInterface": {
                  "Functions": [],
                  "Types": [
                    {
                      "Name": "Box",
                      "QualifiedName": "Demo.Box",
                      "Visibility": "public",
                      "Kind": "struct",
                      "Fields": [],
                      "Methods": [
                        {
                          "Name": "Map",
                          "QualifiedName": "Demo.Box.Map",
                          "Visibility": "public",
                          "SymbolName": "Demo_Box_Map",
                          "Kind": "fn",
                          "ReturnType": {
                            "Kind": "Named",
                            "Name": "Demo.Result",
                            "TypeArguments": [
                              {
                                "Kind": "RawPointer",
                                "ElementType": { "Kind": "Integer", "BitWidth": 8, "IsUnsigned": true }
                              }
                            ]
                          },
                          "Parameters": [
                            {
                              "Name": "self",
                              "Type": {
                                "Kind": "Borrow",
                                "BorrowKind": "borrow",
                                "ElementType": { "Kind": "Named", "Name": "Demo.Box" }
                              }
                            }
                          ],
                          "IsFfi": false,
                          "IsStrictFp": false,
                          "UseFastCallingConvention": true
                        }
                      ]
                    }
                  ],
                  "Globals": []
                }
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageTypeReferenceGraph returnGraph = new();
    stack mut LogicalPackageTypeReferenceGraph parameterGraph = new();
    stack mut LogicalPackageTypeReferenceGraph rejectedGraph = new();
    stack mut u32[0 max] returnRootRow = 0;
    stack mut u32[0 max] parameterRootRow = 0;
    stack mut u32[0 max] rejectedRootRow = 0;
    stack mut u32[0 max] returnTypeArgumentRow = 0;
    stack mut u32[0 max] parameterElementRow = 0;
    stack mut OwnedAscii returnKind = new();
    stack mut OwnedAscii returnName = new();
    stack mut OwnedAscii parameterKind = new();
    stack mut OwnedAscii parameterBorrowKind = new();
    stack mut OwnedAscii parameterElementName = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageTypedCallableTypeReferenceJsonGraph(
            manifestJson,
            0,
            LogicalPackageTypedCallableKind.Method,
            0,
            0,
            LogicalPackageTypedTypeReferenceSource.MethodReturn,
            0,
            returnGraph,
            returnRootRow))
        {
            return false;
        }

        if (!TryMaterializeLogicalPackageTypedCallableTypeReferenceJsonGraph(
            manifestJson,
            0,
            LogicalPackageTypedCallableKind.Method,
            0,
            0,
            LogicalPackageTypedTypeReferenceSource.MethodParameter,
            0,
            parameterGraph,
            parameterRootRow))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageTypedCallableTypeReferenceJsonGraph(
            manifestJson,
            0,
            LogicalPackageTypedCallableKind.Method,
            0,
            0,
            LogicalPackageTypedTypeReferenceSource.FunctionReturn,
            0,
            rejectedGraph,
            rejectedRootRow))
        {
            return false;
        }
    }

    stack LogicalPackageTypeReferenceRow returnRoot = returnGraph.TypeReferenceAt(returnRootRow);
    stack LogicalPackageTypeReferenceSummary returnSummary = returnRoot.Summary();
    stack LogicalPackageTypeReferenceRow parameterRoot = parameterGraph.TypeReferenceAt(parameterRootRow);
    stack LogicalPackageTypeReferenceSummary parameterSummary = parameterRoot.Summary();
    unsafe
    {
        return returnGraph.TypeReferenceCount() == 3
            && returnGraph.ChildRowCount() == 2
            && returnSummary.DeclarationKind() == LogicalPackageTypedDeclarationKind.Type
            && returnSummary.DeclarationOrdinal() == 0
            && returnSummary.MethodOrdinal() == 0
            && returnSummary.Source() == LogicalPackageTypedTypeReferenceSource.MethodReturn
            && returnSummary.PayloadOrdinal() == 0
            && returnSummary.TypeArgumentCount() == 1
            && TryFindLogicalPackageTypeReferenceChild(
                returnGraph,
                returnRootRow,
                LogicalPackageTypeReferenceChildKind.TypeArgument,
                0,
                returnTypeArgumentRow)
            && TryAppendLogicalPackageTypeReferenceText(returnGraph, returnRootRow, LogicalPackageTypeReferenceTextKind.Kind, 0, returnKind)
            && TryAppendLogicalPackageTypeReferenceText(returnGraph, returnRootRow, LogicalPackageTypeReferenceTextKind.Name, 0, returnName)
            && OwnedAsciiEqualsAscii(returnKind, "Named")
            && OwnedAsciiEqualsAscii(returnName, "Demo.Result")
            && returnGraph.TypeReferenceAt(returnTypeArgumentRow).Summary().MethodOrdinal() == 0
            && parameterGraph.TypeReferenceCount() == 2
            && parameterGraph.ChildRowCount() == 1
            && parameterSummary.DeclarationKind() == LogicalPackageTypedDeclarationKind.Type
            && parameterSummary.DeclarationOrdinal() == 0
            && parameterSummary.MethodOrdinal() == 0
            && parameterSummary.Source() == LogicalPackageTypedTypeReferenceSource.MethodParameter
            && parameterSummary.PayloadOrdinal() == 0
            && parameterSummary.HasBorrowKind()
            && parameterSummary.HasElementType()
            && TryFindLogicalPackageTypeReferenceChild(
                parameterGraph,
                parameterRootRow,
                LogicalPackageTypeReferenceChildKind.ElementType,
                0,
                parameterElementRow)
            && TryAppendLogicalPackageTypeReferenceText(parameterGraph, parameterRootRow, LogicalPackageTypeReferenceTextKind.Kind, 0, parameterKind)
            && TryAppendLogicalPackageTypeReferenceText(
                parameterGraph,
                parameterRootRow,
                LogicalPackageTypeReferenceTextKind.BorrowKind,
                0,
                parameterBorrowKind)
            && TryAppendLogicalPackageTypeReferenceText(
                parameterGraph,
                parameterElementRow,
                LogicalPackageTypeReferenceTextKind.Name,
                0,
                parameterElementName)
            && OwnedAsciiEqualsAscii(parameterKind, "Borrow")
            && OwnedAsciiEqualsAscii(parameterBorrowKind, "borrow")
            && OwnedAsciiEqualsAscii(parameterElementName, "Demo.Box");
    }
}

[Fact]
fn bool LogicalPackageImageMaterializesTypedCallableFactGraphRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "TypedInterface": {
                  "Functions": [
                    {
                      "Name": "Run",
                      "QualifiedName": "Demo.Run",
                      "Visibility": "public",
                      "SymbolName": "Demo_Run",
                      "Kind": "fn",
                      "ReturnType": { "Kind": "Void" },
                      "Parameters": [],
                      "IsFfi": false,
                      "IsStrictFp": false,
                      "UseFastCallingConvention": true,
                      "Asm": {
                        "ArchitectureText": "x86_64",
                        "TemplateText": "syscall",
                        "Inputs": [
                          { "RegisterName": "rax", "ValueName": "number" },
                          { "RegisterName": "rdi", "ValueName": "arg1" }
                        ],
                        "Outputs": [
                          { "RegisterName": "rax", "ValueName": "result", "BindsReturnValue": true }
                        ],
                        "Clobbers": [ "rcx", "r11" ]
                      },
                      "FfiAbi": "sysv",
                      "LinkName": "demo_run",
                      "GenericParameters": [ "T", "U" ],
                      "ComptimeGenericParameters": [
                        {
                          "Name": "N",
                          "Type": { "Kind": "Integer", "BitWidth": 32, "IsUnsigned": true }
                        }
                      ],
                      "TypeParameterConstraints": [
                        {
                          "ParameterName": "T",
                          "BoundTraits": [
                            { "Kind": "Named", "Name": "Demo.Copyable" },
                            { "Kind": "Named", "Name": "Demo.Transferable" }
                          ]
                        }
                      ],
                      "ThreadSafetyLawPredicates": [
                        {
                          "LawName": "Shareable",
                          "Type": { "Kind": "Named", "Name": "Demo.Packet" }
                        }
                      ],
                      "ValueContracts": [
                        { "Left": "count", "Operator": "<=", "Right": "N" }
                      ],
                      "DisjointParameterGroups": [
                        {
                          "ParameterNames": [ "input", "output" ],
                          "Regions": [
                            {
                              "ParameterName": "input",
                              "StartExpression": "0",
                              "CountExpression": "count"
                            },
                            {
                              "ParameterName": "output",
                              "CountExpression": "count"
                            }
                          ]
                        }
                      ],
                      "OverlapParameterGroups": [
                        {
                          "ParameterNames": [ "input", "alias" ]
                        }
                      ],
                      "SameParameterGroups": [
                        {
                          "ParameterNames": [ "output", "same" ]
                        }
                      ]
                    }
                  ],
                  "Types": [
                    {
                      "Name": "Box",
                      "QualifiedName": "Demo.Box",
                      "Visibility": "public",
                      "Kind": "struct",
                      "Fields": [],
                      "Methods": [
