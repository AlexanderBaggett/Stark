[Fact]
fn bool BinaryRoundTripsStackAllocInstruction()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 24, 8);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 1, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack MirInstruction allocBack = back.Get(1);
    return back.Count() == 1
        && allocBack.Opcode() == MirOp.StackAlloc
        && allocBack.ResultType() == MirType.Ptr
        && allocBack.Immediate() == 24
        && allocBack.OperandAIndex() == 8;
}

