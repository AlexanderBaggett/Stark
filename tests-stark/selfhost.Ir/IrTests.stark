        index = index + 1;
    }

    return ok
        && funcs.Count() == 1
        && blocks.Count() == 3
        && sawStore
        && sawLoad;
}

[Fact]
fn bool PackageTablesPreserveTerminalIfMutableStackEnumLocalAssignmentMirFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nenum Packet { Empty, Other(u32[0 max]) }\nfn i64 Pick(i64 x) { stack mut Packet p = Packet.Empty; p = Packet.Other(99); if x == 0 return 1 else return 2 }",
        instrs,
        blocks,
        funcs,
        asmMetadata);

    stack mut u32[0 max] storeCount = 0;
    stack mut bool sawAssignedPayload = false;
    stack mut u64[0 2 ** 63 - 1] index = 1;
    while willexit (index <= instrs.Count())
    {
        stack MirValueId value = MirValueIdOf((u32[0 max])index);
        if (MirOpcodeOf(instrs, value) == MirOp.StoreEnumPtr
            && MirOperandCImmediateOf(instrs, value) == 1
            && MirOperandDImmediateOf(instrs, value) == 4)
        {
            storeCount = storeCount + 1;
        }
        else if (MirOpcodeOf(instrs, value) == MirOp.EnumPayloadInsert)
        {
            sawAssignedPayload = sawAssignedPayload
                || (MirOperandCImmediateOf(instrs, value) == 1
                    && MirOperandDImmediateOf(instrs, value) == 1
                    && MirImmediateOf(instrs, value) == 0);
        }

        index = index + 1;
    }

    return ok
        && funcs.Count() == 1
        && blocks.Count() == 3
        && storeCount == 2
        && sawAssignedPayload;
}

[Fact]
fn bool PackageTablesPreserveNestedIfStackEnumLocalAssignmentsMirFacts()
{
