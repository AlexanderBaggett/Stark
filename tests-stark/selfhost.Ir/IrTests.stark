    return ok
        && System.Text.Contains(s.View(), "define internal dso_local range(i64 10, 41) i64 @f1(i64 %p0)")
        && System.Text.Contains(s.View(), "add i64 %p0")
        && System.Text.Contains(s.View(), "switch i64 %v")
        && System.Text.Contains(s.View(), "i64 2, label %b4")
        && System.Text.Contains(s.View(), "i64 3, label %b5")
        && System.Text.Contains(s.View(), "i64 4, label %b6")
        && !System.Text.Contains(s.View(), "icmp eq i64 %v")
        && ClangVerifiesLlvmText(s);
}

