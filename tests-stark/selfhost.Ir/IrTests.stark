[Fact]
fn bool ModulePackageTablesWithAsmPreserveFunctionIdsAndCalls()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\ninternal unsafe ffi asm(x86_64) fn i64[min max] Raw(i64[min max] number) in(\"rax\") number, out(\"rax\") return, clobber(\"rcx\") { \"syscall\" }\nfn i64[min max] Call(i64[min max] number) { return Raw(number) }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    if (!ok)
    {
        return false;
    }

    stack AsmFunctionMetadata asmFunction = asmMetadata.FunctionAt(AsmFunctionIdOf(1));
    stack MirFuncId asmMirFunction = asmFunction.Function();
    stack AsmInputOperand input = asmMetadata.InputAt(asmFunction.FirstInput());
    return funcs.Count() == 2
        && asmMetadata.FunctionCount() == 1
        && instrs.Count() == 2
        && blocks.Count() == 1
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) == 0
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 0
        && MirFunctionInstrCount(funcs, MirFuncIdOf(2)) == 2
        && MirFunctionBlockCount(funcs, MirFuncIdOf(2)) == 1
        && asmMirFunction.Equals(MirFuncIdOf(1))
        && asmFunction.Architecture() == StarkAsmArchitecture.X86_64
        && asmMetadata.TextRangeEquals(input.Register(), "rax")
        && MirOpcodeOf(instrs, MirValueIdOf(2)) == MirOp.Call
        && MirCalleeOf(instrs, MirValueIdOf(2)).Equals(MirFuncIdOf(1))
        && MirOperandAOf(instrs, MirValueIdOf(2)).Equals(MirValueIdOf(1));
}

