internal fn void BuildInvalidUtf8LogicalPackageImage(mut borrow IrTable<u8[0 max]> image)
{
    stack u64[0 max] stringOffset = 120;
    stack u64[0 max] stringLength = 14;
    stack u64[0 max] factsOffset = 134;
    stack u64[0 max] factsLength = 44;
    stack u64[0 max] manifestOffset = 178;

    WriteStarkPackageImageMagic(image);
    WriteU32(image, SectionedPackageImageVersion());
    WriteU32(image, 3);
    WriteU64(image, 96);
    WritePackageSectionDirectoryEntry(image, PackageSectionStringTable(), SectionFlagsRequired(), stringOffset, stringLength, SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(image, PackageSectionPackageFacts(), SectionFlagsRequired(), factsOffset, factsLength, SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(image, PackageSectionManifest(), SectionFlagsRequired(), manifestOffset, 1, SectionEncodingBrotliUtf8Json());

    WriteU32(image, 2);
    WriteU32(image, 1);
    AppendImageByte(image, 192);
    WriteU32(image, 1);
    AppendImageByte(image, 97);

    WriteU32(image, 0);
    WriteU32(image, 1);
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, PackageImageNullStringIndex());
    WriteU32(image, 0);
    WriteU32(image, 0);
    WriteU32(image, 0);
    AppendImageByte(image, 11);
}

[Fact]
fn bool LogicalPackageImageValidatesHeaderFacts()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 0);

    return ValidatePackageImage(image) == PackageImageValidationStatus.Ok
        && PackageImageIsValid(image);
}

[Fact]
fn bool LogicalPackageImageInspectsTextHeaderFacts()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 0);

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    return LlvmTextEquals(text, "package: STARKPKG, logical image, root Demo, library libDemo.a, 3 sections, 2 strings, 0 target features\n");
}

[Fact]
fn bool LogicalPackageImageInspectsJsonHeaderFacts()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 0);

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    return LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"logical\",\"rootModule\":\"Demo\",\"libraryFileName\":\"libDemo.a\",\"buildProfile\":null,\"targetTriple\":null,\"targetDataLayout\":null,\"targetCpu\":null,\"relocationModel\":null,\"codeModel\":null,\"targetFeatureNames\":[],\"cDataModel\":null,\"aggregateLayout\":null,\"sections\":3,\"strings\":2,\"targetFeatures\":0,\"hasBuildProfile\":false,\"hasTarget\":false,\"hasCDataModel\":false,\"hasAggregateLayout\":false}\n");
}

[Fact]
fn bool LogicalPackageImageInspectsProfileAndTargetHeaderFacts()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildProfileTargetLogicalPackageImage(image);

    stack mut OwnedAscii text = new();
    switch (InspectPackageImage(image, text))
    {
        case MemoryStatus.Err(var textError):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii json = new();
    switch (InspectPackageImageJson(image, json))
    {
        case MemoryStatus.Err(var jsonError):
            return false;
        case MemoryStatus.Ok:
    }

    return ValidatePackageImage(image) == PackageImageValidationStatus.Ok
        && LlvmTextEquals(text, "package: STARKPKG, logical image, root Demo, library libDemo.a, profile release, target x86_64-unknown-linux-stark, data-layout e-p:64:64, cpu generic, relocation static, code-model small, features [+sse2, +popcnt], c-data-model linux char-signed=false pointer=64 long=64 size_t=64 ptrdiff_t=64, aggregate-layout pointer-size=8 pointer-align=8, 3 sections, 11 strings, 2 target features\n")
        && LlvmTextEquals(json, "{\"format\":\"STARKPKG\",\"payload\":\"logical\",\"rootModule\":\"Demo\",\"libraryFileName\":\"libDemo.a\",\"buildProfile\":\"release\",\"targetTriple\":\"x86_64-unknown-linux-stark\",\"targetDataLayout\":\"e-p:64:64\",\"targetCpu\":\"generic\",\"relocationModel\":\"static\",\"codeModel\":\"small\",\"targetFeatureNames\":[\"+sse2\",\"+popcnt\"],\"cDataModel\":{\"kind\":\"linux\",\"charIsSigned\":false,\"pointerBitWidth\":64,\"longBitWidth\":64,\"sizeTBitWidth\":64,\"ptrDiffTBitWidth\":64},\"aggregateLayout\":{\"pointerSizeBytes\":8,\"pointerAlignmentBytes\":8},\"sections\":3,\"strings\":11,\"targetFeatures\":2,\"hasBuildProfile\":true,\"hasTarget\":true,\"hasCDataModel\":true,\"hasAggregateLayout\":true}\n");
}

[Fact]
fn bool LogicalPackageImageDoesNotDeserializeAsMir()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 0);

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    return !DeserializePackageImage(image, instrs, blocks, funcs, globals);
}

[Fact]
fn bool LogicalPackageImageRejectsBadPackageFactStringIndex()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildMinimalLogicalPackageImage(image, 2);
    return ValidatePackageImage(image) == PackageImageValidationStatus.MalformedSectionDirectory
        && !PackageImageIsValid(image);
}

[Fact]
fn bool LogicalPackageImageRejectsInvalidUtf8StringTable()
{
    stack mut IrTable<u8[0 max]> image = new();
    BuildInvalidUtf8LogicalPackageImage(image);
    return ValidatePackageImage(image) == PackageImageValidationStatus.MalformedSectionDirectory
        && !PackageImageIsValid(image);
}

[Fact]
fn bool SectionedPackageImageRejectsUnknownRequiredSection()
{
    stack mut IrTable<u8[0 max]> image = new();
    WriteU32(image, 1380013139);
    WriteU32(image, 1196118091);
    WriteU32(image, 2);
    WriteU32(image, 1);
    WriteU64(image, 32);
    WriteU32(image, 1162891086);
    WriteU32(image, 1);
    WriteU64(image, 56);
    WriteU64(image, 0);
    WriteU32(image, 0);
    WriteU32(image, 0);
    return ValidatePackageImage(image) == PackageImageValidationStatus.UnsupportedFormat
        && !PackageImageIsValid(image);
}

[Fact]
fn bool PackageImageRejectsBadMagic()
{
    // A buffer without the magic header is rejected (nothing deserialized).
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 12345);
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    return !DeserializePackageImage(buf, bi, bb, bf, bg);
}

[Fact]
fn bool PackageImageRejectsTruncatedHeaderAndInspectionStaysEmpty()
{
    // Truncated buffers are malformed package images, not short reads into row 0.
    stack mut IrTable<u8[0 max]> buf = new();
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack mut OwnedAscii sink = new();
    stack mut OwnedAscii json = new();
    switch (InspectPackageImage(buf, sink))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            switch (InspectPackageImageJson(buf, json))
            {
                case MemoryStatus.Err(var jsonError):
                    return false;
                case MemoryStatus.Ok:
                    return !DeserializePackageImage(buf, bi, bb, bf, bg)
                        && LlvmTextEquals(sink, "")
                        && LlvmTextEquals(json, "")
                        && bi.Count() == 0
                        && bb.Count() == 0
                        && bf.Count() == 0
                        && bg.Count() == 0;
            }
    }
}

[Fact]
fn bool MalformedPackageImageFileInspectionFails()
{
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 826757197);
    return !PackageImageIsValid(buf)
        && PackageImageBufferInspectionFailsThroughFile(buf, PackageImageInspectionFormat.Text)
        && PackageImageBufferInspectionFailsThroughFile(buf, PackageImageInspectionFormat.Json);
}

[Fact]
fn bool PackageImageValidationReportsFailureKinds()
{
    stack mut IrTable<u8[0 max]> empty = new();

    stack mut IrTable<u8[0 max]> badMagic = new();
    WriteU32(badMagic, 12345);

    stack mut IrTable<u8[0 max]> truncatedSection = new();
    WriteU32(truncatedSection, 826757197);
    WriteU32(truncatedSection, 21);
    WriteU32(truncatedSection, 25);
    WriteU32(truncatedSection, 29);
    WriteU32(truncatedSection, 33);

    stack mut IrTable<u8[0 max]> badDirectory = new();
    WriteU32(badDirectory, 826757197);
    WriteU32(badDirectory, 22);
    WriteU32(badDirectory, 26);
    WriteU32(badDirectory, 30);
    WriteU32(badDirectory, 34);

    stack mut OwnedAscii statusName = new();
    switch (statusName.AppendAscii(PackageImageValidationStatusName(PackageImageValidationStatus.MalformedSectionDirectory)))
    {
        case MemoryStatus.Err(var statusNameError):
            return false;
        case MemoryStatus.Ok:
    }

    return ValidatePackageImage(empty) == PackageImageValidationStatus.TruncatedHeader
        && ValidatePackageImage(badMagic) == PackageImageValidationStatus.UnsupportedFormat
        && ValidatePackageImage(truncatedSection) == PackageImageValidationStatus.TruncatedSection
        && ValidatePackageImage(badDirectory) == PackageImageValidationStatus.MalformedSectionDirectory
        && LlvmTextEquals(statusName, "malformed-section-directory");
}

[Fact]
fn bool PackageImageRejectsMissingSections()
{
    // "MIR1" with valid-looking offsets but no section count bytes must fail before
    // the fixed-record deserializers touch the image.
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 826757197);
    WriteU32(buf, 21);
    WriteU32(buf, 25);
    WriteU32(buf, 29);
    WriteU32(buf, 33);
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack mut OwnedAscii sink = new();
    stack mut OwnedAscii json = new();
    switch (InspectPackageImage(buf, sink))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            switch (InspectPackageImageJson(buf, json))
            {
                case MemoryStatus.Err(var jsonError):
                    return false;
                case MemoryStatus.Ok:
                    return !DeserializePackageImage(buf, bi, bb, bf, bg)
                        && LlvmTextEquals(sink, "")
                        && LlvmTextEquals(json, "")
                        && bi.Count() == 0
                        && bb.Count() == 0
                        && bf.Count() == 0
                        && bg.Count() == 0;
            }
    }
}

[Fact]
fn bool PackageImageWithAsmRejectsMissingAsmSection()
{
    // "MIR2" has four empty MIR sections here, but the required asm metadata section
    // count is absent at byte 41, so validation rejects the image.
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 844253517);
    WriteU32(buf, 25);
    WriteU32(buf, 29);
    WriteU32(buf, 33);
    WriteU32(buf, 37);
    WriteU32(buf, 41);
    WriteU32(buf, 0);
    WriteU32(buf, 0);
    WriteU32(buf, 0);
    WriteU32(buf, 0);
    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack mut OwnedAscii sink = new();
    stack mut OwnedAscii json = new();
    switch (InspectPackageImage(buf, sink))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            switch (InspectPackageImageJson(buf, json))
            {
                case MemoryStatus.Err(var jsonError):
                    return false;
                case MemoryStatus.Ok:
                    return !DeserializePackageImageWithAsm(buf, bi, bb, bf, bg, asmMetadata)
                        && LlvmTextEquals(sink, "")
                        && LlvmTextEquals(json, "")
                        && bi.Count() == 0
                        && bb.Count() == 0
                        && bf.Count() == 0
                        && bg.Count() == 0
                        && asmMetadata.FunctionCount() == 0;
            }
    }
}

[Fact]
fn bool AsmMetadataRejectsTruncatedTextPool()
{
    stack mut IrTable<u8[0 max]> buf = new();
    WriteU32(buf, 1);
    stack mut AsmMetadataTable asmMetadata = new();
    return !DeserializeAsmMetadata(buf, asmMetadata)
        && asmMetadata.FunctionCount() == 0
        && asmMetadata.InputCount() == 0
        && asmMetadata.OutputCount() == 0
        && asmMetadata.ClobberCount() == 0;
}

[Fact]
fn bool AsmMetadataRejectsInvalidInputRegisterBeforeAppendingRows()
{
    stack mut AsmMetadataTable table = new();
    stack mut AsmFunctionId asmId = new();
    return !CollectFirstAsmFunctionMetadata(
            "module Test\ninternal unsafe ffi asm(x86_64) fn i64[min max] Bad(i64[min max] number) in(\"x0\") number, out(\"rax\") return { \"nop\" }",
            MirFuncIdOf(1),
            table,
            asmId)
        && !asmId.IsValid()
        && table.TextByteCount() == 0
        && table.FunctionCount() == 0
        && table.InputCount() == 0
        && table.OutputCount() == 0
        && table.ClobberCount() == 0;
}

