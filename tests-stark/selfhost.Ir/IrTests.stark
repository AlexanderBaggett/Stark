        && LlvmTextEquals(stored, "define i64 @main(ptr captures(address, provenance) %p0) {\nb1:\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n");
}

[Fact]
fn bool CompileFunctionOutAndInitLowerInitializationAttributes()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionToLlvm("fn i64 write(out i32 value, init i64 next) { return 1 }", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main(ptr captures(none) writeonly writable initializes((0, 4)) %p0, ptr captures(none) writeonly writable initializes((0, 8)) %p1) {\nb1:\n  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v1 = add i64 0, 1\n  ret i64 %v1\n}\n");
