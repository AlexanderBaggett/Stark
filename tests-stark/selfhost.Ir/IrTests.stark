[Fact]
fn bool EmitsRangeFactLlvmDefinitionWithEnumLayoutFacts()
{
    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> facts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, facts))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(1), 2);
    stack MirValueId payload = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId inserted = MirEnumPayloadInsert(instrs, TypeIdOf(1), 2, 0, tagged, payload);
    stack MirValueId returned = MirConstInt(instrs, 7);
    stack MirBlockId entry = MirReturnBlock(blocks, returned);
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFactsAndEnumLayouts(
        instrs,
        blocks,
        facts,
        "enum_make",
        returnFacts,
        paramFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        0,
        entry.Index(),
        1,
        4,
        sink))
    {
        case MemoryStatus.Err(var emitError):
            return false;
        case MemoryStatus.Ok:
            return MirOpcodeOf(instrs, inserted) == MirOp.EnumPayloadInsert
                && System.Text.Contains(sink.View(), "%v1 = insertvalue { i8, i8, [2 x i8], i32 } zeroinitializer, i8 2, 0")
                && System.Text.Contains(sink.View(), "%v3 = insertvalue { i8, i8, [2 x i8], i32 } %v1, i32 %v2, 3")
                && System.Text.Contains(sink.View(), "ret i64 %v4");
    }
}

[Fact]
fn bool EmitsLlvmModuleWithEnumLayoutFacts()
{
    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> facts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, facts))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack MirValueId tagged = MirEnumVariantTag(instrs, TypeIdOf(1), 2);
    stack MirValueId payload = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId inserted = MirEnumPayloadInsert(instrs, TypeIdOf(1), 2, 0, tagged, payload);
    stack MirValueId returned = MirConstInt(instrs, 7);
    stack MirBlockId entry = MirReturnBlock(blocks, returned);
    stack MirFuncId function = MirDefineFunction(funcs, entry, entry, 1, tagged, 4);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmModuleWithEnumLayouts(instrs, blocks, funcs, facts, sink))
    {
        case MemoryStatus.Err(var emitError):
            return false;
        case MemoryStatus.Ok:
            return function.Index() == 1
                && MirOpcodeOf(instrs, inserted) == MirOp.EnumPayloadInsert
                && System.Text.Contains(sink.View(), "define i64 @f1()")
                && System.Text.Contains(sink.View(), "%v1 = insertvalue { i8, i8, [2 x i8], i32 } zeroinitializer, i8 2, 0")
                && System.Text.Contains(sink.View(), "%v3 = insertvalue { i8, i8, [2 x i8], i32 } %v1, i32 %v2, 3")
                && System.Text.Contains(sink.View(), "ret i64 %v4");
    }
}

[Fact]
fn bool EmitsLlvmPointerMemoryOps()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId alloc = MirStackAlloc(instrs, 16, 8);
    stack MirValueId field = MirPtrOffset(instrs, alloc, 4, 4);
    stack MirValueId value = MirConstIntTyped(instrs, MirType.I32, 99);
    stack MirValueId store = MirStorePtrAlignedTyped(instrs, MirType.I32, field, value, 4);
    stack MirValueId load = MirLoadPtrAlignedTyped(instrs, MirType.I32, field, 4);
    stack MirValueId ret = MirReturn(instrs, load);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunction(instrs, "ptrmem", 1, 6, sink))
    {
        case MemoryStatus.Ok:
            return MirOpcodeOf(instrs, store) == MirOp.StorePtr
                && MirOpcodeOf(instrs, ret) == MirOp.Return
                && LlvmTextEquals(sink, "define i32 @ptrmem() {\nentry:\n  %v1 = alloca [16 x i8], align 8\n  %v2 = getelementptr inbounds i8, ptr %v1, i64 4\n  %v3 = add i32 0, 99\n  store i32 %v3, ptr %v2, align 4\n  %v5 = load i32, ptr %v2, align 4\n  ret i32 %v5\n}\n")
                && ClangVerifiesLlvmText(sink);
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmDynamicPointerMemoryOps()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId index = MirParam(instrs, 0);
    stack MirValueId alloc = MirStackAlloc(instrs, 32, 8);
    stack MirValueId element = MirPtrIndexOffset(instrs, alloc, index, 4, 8, 4);
    stack MirValueId load = MirLoadPtrAlignedTyped(instrs, MirType.I32, element, 4);
    stack MirValueId ret = MirReturn(instrs, load);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunction(instrs, "dynptr", 1, 5, sink))
    {
        case MemoryStatus.Ok:
            return MirOpcodeOf(instrs, element) == MirOp.PtrIndexOffset
                && MirOpcodeOf(instrs, ret) == MirOp.Return
                && LlvmTextEquals(sink, "define i32 @dynptr(i64 %p0) {\nentry:\n  %v2 = alloca [32 x i8], align 8\n  %v3.scale = mul i64 %p0, 4\n  %v3.offset = add i64 %v3.scale, 8\n  %v3 = getelementptr inbounds i8, ptr %v2, i64 %v3.offset\n  %v4 = load i32, ptr %v3, align 4\n  ret i32 %v4\n}\n")
                && ClangVerifiesLlvmText(sink);
        case MemoryStatus.Err(var error):
            return false;
    }
}

