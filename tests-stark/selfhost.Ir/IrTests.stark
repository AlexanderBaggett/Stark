[Fact]
fn bool PackageTablesPreserveLocalTryBindingNestedSuccessorLocalTryMirFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nenum Outcome { [Ok] Value(i32[0 max]), [Err] Failed(u8[0 max]) }\nfn Outcome Main() { var value = try Outcome.Value(7); var doubled = try Outcome.Value(value + 1); return Outcome.Value(doubled) }",
        instrs,
        blocks,
        funcs,
        asmMetadata);

    stack mut u32[0 max] tagReadCount = 0;
    stack mut u32[0 max] conditionCount = 0;
    stack mut u32[0 max] successExtractCount = 0;
    stack mut bool sawSuccessAdd = false;
    stack mut u64[0 2 ** 63 - 1] index = 1;
    while willexit (index <= instrs.Count())
    {
        stack MirValueId value = MirValueIdOf((u32[0 max])index);
        stack MirOp opcode = MirOpcodeOf(instrs, value);
        if (opcode == MirOp.EnumTagRead)
        {
            tagReadCount += 1;
        }
        else if (opcode == MirOp.CmpEq)
        {
            conditionCount += 1;
        }
        else if (opcode == MirOp.EnumPayloadExtract)
        {
            if (MirOperandCImmediateOf(instrs, value) == 0
                && MirOperandDImmediateOf(instrs, value) == 0
                && MirValueType(instrs, value.Index()) == MirType.I32)
            {
                successExtractCount += 1;
            }
        }
        else if (opcode == MirOp.Add)
        {
            sawSuccessAdd = sawSuccessAdd
                || MirValueType(instrs, value.Index()) == MirType.I32;
        }

        index = index + 1;
    }

    stack MirBlock entry = blocks.Get(1);
    stack MirBlock errorBlock = blocks.Get(2);
    stack MirBlock continueBlock = blocks.Get(3);
    stack MirBlock nestedEntry = blocks.Get(4);
    stack MirBlock nestedErrorBlock = blocks.Get(5);
    stack MirBlock nestedContinueBlock = blocks.Get(6);
    stack MirBlock finalBlock = blocks.Get(7);
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 7
        && entry.Terminator() == MirTermKind.CondBranch
        && errorBlock.Terminator() == MirTermKind.Return
        && continueBlock.Terminator() == MirTermKind.Branch
        && nestedEntry.Terminator() == MirTermKind.CondBranch
        && nestedErrorBlock.Terminator() == MirTermKind.Return
        && nestedContinueBlock.Terminator() == MirTermKind.Branch
        && finalBlock.Terminator() == MirTermKind.Return
        && tagReadCount == 2
        && conditionCount == 2
        && successExtractCount == 2
        && sawSuccessAdd;
}

[Fact]
fn bool PackageTablesPreserveLocalTryBindingSuccessorSliceStoreMirFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nenum Outcome { [Ok] Value(i32[0 max]), [Err] Failed(u8[0 max]) }\nfn Outcome Main(mut i32[0 max][] view, u64[0 max] index) { var value = try Outcome.Value(7); view[index] = value; return Outcome.Value(view[index]) }",
        instrs,
        blocks,
        funcs,
        asmMetadata);

    stack mut bool sawSliceBase = false;
    stack mut bool sawSliceLength = false;
    stack mut bool sawTagRead = false;
    stack mut bool sawCondition = false;
    stack mut bool sawSuccessExtract = false;
    stack mut bool sawReturnLoad = false;
    stack mut u32[0 max] indexedPointerCount = 0;
    stack mut u32[0 max] storeCount = 0;
    stack mut u64[0 2 ** 63 - 1] index = 1;
    while willexit (index <= instrs.Count())
    {
        stack MirValueId value = MirValueIdOf((u32[0 max])index);
        stack MirOp opcode = MirOpcodeOf(instrs, value);
        if (opcode == MirOp.SliceParamBase)
        {
            sawSliceBase = true;
        }
        else if (opcode == MirOp.SliceParamLength)
        {
            sawSliceLength = true;
        }
        else if (opcode == MirOp.PtrIndexOffsetUnbounded)
        {
            if (MirImmediateOf(instrs, value) == 0
                && MirOperandCImmediateOf(instrs, value) == 4
                && MirOperandDImmediateOf(instrs, value) == 4
                && MirValueType(instrs, value.Index()) == MirType.Ptr)
            {
                indexedPointerCount += 1;
            }
        }
        else if (opcode == MirOp.StorePtr)
        {
            if (MirValueType(instrs, value.Index()) == MirType.I32
                && MirOperandCImmediateOf(instrs, value) == 4)
            {
                storeCount += 1;
            }
        }
        else if (opcode == MirOp.LoadPtr)
        {
            sawReturnLoad = sawReturnLoad
                || (MirValueType(instrs, value.Index()) == MirType.I32
                    && MirOperandBImmediateOf(instrs, value) == 4);
        }
        else if (opcode == MirOp.EnumTagRead)
        {
            sawTagRead = true;
        }
        else if (opcode == MirOp.CmpEq)
        {
            sawCondition = true;
        }
        else if (opcode == MirOp.EnumPayloadExtract)
        {
            sawSuccessExtract = sawSuccessExtract
                || (MirOperandCImmediateOf(instrs, value) == 0
                    && MirOperandDImmediateOf(instrs, value) == 0
                    && MirValueType(instrs, value.Index()) == MirType.I32);
        }

        index = index + 1;
    }

    stack MirBlock entry = blocks.Get(1);
    stack MirBlock errorBlock = blocks.Get(2);
    stack MirBlock continueBlock = blocks.Get(3);
    stack MirBlock finalBlock = blocks.Get(4);
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 4
        && entry.Terminator() == MirTermKind.CondBranch
        && errorBlock.Terminator() == MirTermKind.Return
        && continueBlock.Terminator() == MirTermKind.Branch
        && finalBlock.Terminator() == MirTermKind.Return
        && sawSliceBase
        && sawSliceLength
        && indexedPointerCount >= 2
        && storeCount == 1
        && sawReturnLoad
        && sawTagRead
        && sawCondition
        && sawSuccessExtract;
}

