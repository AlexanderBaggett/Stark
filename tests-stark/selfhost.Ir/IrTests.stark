        && MirBlockBranchTarget(blocks, MirBlockIdOf(3)) == MirBlockIdOf(2)
        && MirBlockHasIndependentLoopBackedge(blocks, MirBlockIdOf(3));
}

[Fact]
fn bool PackageTablesPreserveBracedBooleanTerminalIf()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
