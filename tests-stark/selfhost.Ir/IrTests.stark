        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @addi64() {\nentry:\n  %v1 = add i64 0, 2\n  %v2 = add i64 0, 3\n  %v3 = add i64 %v1, %v2\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmTypedFunctionWithParameterTypesAndFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId p0 = MirParamTyped(instrs, MirType.I32, 0);
    stack MirValueId p1 = MirParamTyped(instrs, MirType.Ptr, 1);
    stack MirValueId one = MirConstIntTyped(instrs, MirType.I32, 1);
    stack MirValueId sum = MirAddTyped(instrs, MirType.I32, p0, one);
    stack MirValueId unusedRet = MirReturn(instrs, sum);
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut ValueFacts p0Facts = new();
    p0Facts.SetIntegerRange(0, 128);
    stack ValueFacts p1Facts = new();
    stack u32[0 max] addedP0Facts = paramFacts.Add(p0Facts);
    stack u32[0 max] addedP1Facts = paramFacts.Add(p1Facts);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunctionWithParamFacts(instrs, "typedparams", 2, paramFacts, 1, 5, sink))
    {
        case MemoryStatus.Ok:
            return MirParamTypeOf(instrs, 0) == MirType.I32
                && MirParamTypeOf(instrs, 1) == MirType.Ptr
                && MirParamTypeOf(instrs, 99) == MirType.I64
                && MirParamIndexOf(instrs, p0) == 0
                && MirParamIndexOf(instrs, p1) == 1
                && MirValueType(instrs, p0.Index()) == MirType.I32
                && MirValueType(instrs, p1.Index()) == MirType.Ptr
                && LlvmTextEquals(sink, "define i32 @typedparams(i32 range(i32 0, 128) %p0, ptr %p1) {\nentry:\n  %v3 = add i32 0, 1\n  %v4 = add i32 %p0, %v3\n  ret i32 %v4\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirFloatValueTypesRoundTripPackageCodecAndLlvmShapeFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId f32Param = MirParamTyped(instrs, MirType.F32, 0);
    stack MirValueId f64Param = MirParamTyped(instrs, MirType.F64, 1);
    stack MirValueId unusedRet = MirReturn(instrs, f32Param);

    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 3, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);

    stack u32[0 max] shape = StructValueShapeTypeCode(MirType.F32)
        + StructValueShapeTypeCode(MirType.F64) * StructValueShapeMultiplierForIndex(1);
    stack mut ParamAbiFacts shapeFacts = new();
    shapeFacts.IsStructValue = true;
    shapeFacts.StructValueFieldCount = 2;
    shapeFacts.StructValueShapeCode = shape;
    stack mut OwnedAscii shapeText = new();
    switch (EmitLlvmStructValueShapeType(2, shape, shapeText))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
    }

    stack mut OwnedAscii fnText = new();
    switch (EmitLlvmTypedFunctionWithParams(instrs, "floatparams", 2, 1, 3, fnText))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
    }

    return back.Count() == 3
        && MirOpcodeOf(back, MirValueIdOf(1)) == MirOp.Param
        && MirOpcodeOf(back, MirValueIdOf(2)) == MirOp.Param
        && MirValueType(back, f32Param.Index()) == MirType.F32
        && MirValueType(back, f64Param.Index()) == MirType.F64
        && MirTypeFromStorageCode(MirTypeStorageCode(MirType.F32)) == MirType.F32
        && MirTypeFromStorageCode(MirTypeStorageCode(MirType.F64)) == MirType.F64
        && StructValueShapeTypeIsSupported(MirType.F32)
        && StructValueShapeTypeIsSupported(MirType.F64)
        && StructValueShapeFieldStorageCodeAt(shapeFacts, 0) == StructValueShapeTypeCode(MirType.F32)
        && StructValueShapeFieldStorageCodeAt(shapeFacts, 1) == StructValueShapeTypeCode(MirType.F64)
        && StructValueShapeCodeFieldTypeAt(shape, 0) == MirType.F32
        && StructValueShapeCodeFieldTypeAt(shape, 1) == MirType.F64
        && LlvmTextEquals(shapeText, "{ float, double }")
        && LlvmTextEquals(fnText, "define float @floatparams(float %p0, double %p1) {\nentry:\n  ret float %p0\n}\n");
}

[Fact]
fn bool EmitsLlvmTypedFloatArithmeticFunction()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId f32Left = MirParamTyped(instrs, MirType.F32, 0);
    stack MirValueId f32Right = MirParamTyped(instrs, MirType.F32, 1);
    stack MirValueId f64Left = MirParamTyped(instrs, MirType.F64, 2);
    stack MirValueId f64Right = MirParamTyped(instrs, MirType.F64, 3);
    stack MirValueId sum = MirAddTyped(instrs, MirType.F32, f32Left, f32Right);
    stack MirValueId difference = MirSubTyped(instrs, MirType.F32, f32Left, f32Right);
    stack MirValueId product = MirMulTyped(instrs, MirType.F32, sum, difference);
    stack MirValueId quotient = MirSDivTyped(instrs, MirType.F64, f64Left, f64Right);
    stack MirValueId remainder = MirSRemTyped(instrs, MirType.F64, quotient, f64Right);
    stack MirValueId unusedRet = MirReturn(instrs, remainder);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunctionWithParams(instrs, "floatarith", 4, 1, 10, sink))
    {
        case MemoryStatus.Ok:
            return MirValueType(instrs, product.Index()) == MirType.F32
                && MirValueType(instrs, quotient.Index()) == MirType.F64
                && LlvmTextEquals(sink, "define double @floatarith(float %p0, float %p1, double %p2, double %p3) {\nentry:\n  %v5 = fadd float %p0, %p1\n  %v6 = fsub float %p0, %p1\n  %v7 = fmul float %v5, %v6\n  %v8 = fdiv double %p2, %p3\n  %v9 = frem double %v8, %p3\n  ret double %v9\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmTypedFloatComparisonFunction()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId left = MirParamTyped(instrs, MirType.F64, 0);
    stack MirValueId right = MirParamTyped(instrs, MirType.F64, 1);
    stack MirValueId eq = MirCmpEq(instrs, left, right);
    stack MirValueId ne = MirCmpNe(instrs, left, right);
    stack MirValueId lt = MirCmpLt(instrs, left, right);
    stack MirValueId le = MirCmpLe(instrs, left, right);
    stack MirValueId gt = MirCmpGt(instrs, left, right);
    stack MirValueId ge = MirCmpGe(instrs, left, right);
    stack MirValueId unusedRet = MirReturn(instrs, ge);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunctionWithParams(instrs, "floatcmps", 2, 1, 9, sink))
    {
        case MemoryStatus.Ok:
            return MirValueType(instrs, eq.Index()) == MirType.I1
                && MirValueType(instrs, ne.Index()) == MirType.I1
                && MirValueType(instrs, lt.Index()) == MirType.I1
                && MirValueType(instrs, le.Index()) == MirType.I1
                && MirValueType(instrs, gt.Index()) == MirType.I1
                && LlvmTextEquals(sink, "define i1 @floatcmps(double %p0, double %p1) {\nentry:\n  %v3 = fcmp oeq double %p0, %p1\n  %v4 = fcmp une double %p0, %p1\n  %v5 = fcmp olt double %p0, %p1\n  %v6 = fcmp ole double %p0, %p1\n  %v7 = fcmp ogt double %p0, %p1\n  %v8 = fcmp oge double %p0, %p1\n  ret i1 %v8\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirNullPointerConstantRoundTripsFactsAndTypedLlvm()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId nullValue = MirConstNullPtr(instrs);
    stack MirValueId unusedRet = MirReturn(instrs, nullValue);
    stack mut IrTable<u8[0 max]> buf = new();
    SerializeInstructions(instrs, 1, 2, buf);
    stack mut IrTable<MirInstruction> back = new();
    DeserializeInstructions(buf, back);
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    stack ValueFacts facts = ValueFactsForMirValue(valueFacts, nullValue);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunction(instrs, "null_ptr", 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return MirOpcodeOf(instrs, nullValue) == MirOp.ConstInt
                && MirImmediateOf(instrs, nullValue) == 0
                && MirValueType(instrs, nullValue.Index()) == MirType.Ptr
                && back.Count() == 2
                && MirOpcodeOf(back, MirValueIdOf(1)) == MirOp.ConstInt
                && MirValueType(back, 1) == MirType.Ptr
                && facts.HasNullability()
                && facts.KnownNull()
                && !facts.KnownNonNull()
                && LlvmTextEquals(sink, "define ptr @null_ptr() {\nentry:\n  %v1 = inttoptr i64 0 to ptr\n  ret ptr %v1\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirExtendedOpsRecordOpcodes()
{
    // The extended ALU opcodes round-trip through the instruction.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 1);
    stack MirValueId b = MirConstInt(instrs, 2);
    stack MirValueId ud = MirUDiv(instrs, a, b);
    stack MirValueId sr = MirSRem(instrs, a, b);
    stack MirValueId orv = MirOr(instrs, a, b);
    stack MirValueId xr = MirXor(instrs, a, b);
    stack MirValueId ash = MirAShr(instrs, a, b);
    return MirOpcodeOf(instrs, ud) == MirOp.UDiv
        && MirOpcodeOf(instrs, sr) == MirOp.SRem
        && MirOpcodeOf(instrs, orv) == MirOp.Or
        && MirOpcodeOf(instrs, xr) == MirOp.Xor
        && MirOpcodeOf(instrs, ash) == MirOp.AShr;
}

[Fact]
fn bool EmitsLlvmExtendedArithmetic()
{
    // The extended ALU ops lower to their LLVM mnemonics over `%vN` operands.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId a = MirConstInt(instrs, 20);
    stack MirValueId b = MirConstInt(instrs, 6);
    stack MirValueId q = MirSDiv(instrs, a, b);
    stack MirValueId m = MirAnd(instrs, a, b);
    stack MirValueId s = MirShl(instrs, q, m);
    stack MirBlockId entry = MirReturnBlock(blocks, s);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "alu", 0, entry.Index(), 1, 5, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @alu() {\nb1:\n  %v1 = add i64 0, 20\n  %v2 = add i64 0, 6\n  %v3 = sdiv i64 %v1, %v2\n  %v4 = and i64 %v1, %v2\n  %v5 = shl i64 %v3, %v4\n  ret i64 %v5\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirPhiRecordsIncomingEdges()
{
    // A 2-incoming phi records both incoming values (operands A/B) and both
    // predecessor block ids (packed into the immediate, decoded by div/mod).
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstInt(instrs, 10);
    stack MirValueId b = MirConstInt(instrs, 20);
    stack MirValueId phi = MirPhi2(instrs, a, MirBlockIdOf(2), b, MirBlockIdOf(3));
    stack MirValueId v0 = MirOperandAOf(instrs, phi);
    stack MirValueId v1 = MirOperandBOf(instrs, phi);
    stack MirBlockId blk0 = MirPhiIncomingBlock0(instrs, phi);
    stack MirBlockId blk1 = MirPhiIncomingBlock1(instrs, phi);
    return MirOpcodeOf(instrs, phi) == MirOp.Phi
        && v0.Equals(a)
        && v1.Equals(b)
        && blk0.Equals(MirBlockIdOf(2))
        && blk1.Equals(MirBlockIdOf(3));
}

[Fact]
fn bool EmitsLlvmPhiNode()
{
    // A phi at a merge lowers to `%vN = phi i64 [ <a>, %bX ], [ <b>, %bY ]`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId a = MirConstInt(instrs, 10);
    stack MirValueId b = MirConstInt(instrs, 20);
    stack MirValueId phi = MirPhi2(instrs, a, MirBlockIdOf(2), b, MirBlockIdOf(3));
    stack MirBlockId entry = MirReturnBlock(blocks, phi);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "merge", 0, entry.Index(), 1, 3, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @merge() {\nb1:\n  %v1 = add i64 0, 10\n  %v2 = add i64 0, 20\n  %v3 = phi i64 [ %v1, %b2 ], [ %v2, %b3 ]\n  ret i64 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirLoadGlobalRecordsTarget()
{
    // A LoadGlobal records its opcode and the loaded global id; the opcode guard
    // keeps a non-load value from being misread.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId v = MirLoadGlobal(instrs, 5);
    stack MirValueId typed = MirLoadGlobalTyped(instrs, MirType.I32, 6);
    stack MirValueId p = MirParam(instrs, 0);
    return MirOpcodeOf(instrs, v) == MirOp.LoadGlobal
        && MirLoadedGlobalOf(instrs, v) == 5
        && MirOpcodeOf(instrs, typed) == MirOp.LoadGlobal
        && MirLoadedGlobalOf(instrs, typed) == 6
        && MirValueType(instrs, typed.Index()) == MirType.I32
        && MirLoadedGlobalOf(instrs, p) == 0;
}

[Fact]
fn bool EmitsLlvmGlobalLoad()
{
    // A function that loads a global and returns it: `%v1 = load i64, ptr @g2`.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId v = MirLoadGlobal(instrs, 2);
    stack MirBlockId entry = MirReturnBlock(blocks, v);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "readg", 0, entry.Index(), 1, 1, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @readg() {\nb1:\n  %v1 = load i64, ptr @g2\n  ret i64 %v1\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirStoreGlobalRecordsTargetAndValue()
{
    // A StoreGlobal records its opcode, the target global id, and the stored value.
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId c = MirConstInt(instrs, 4);
    stack MirValueId st = MirStoreGlobal(instrs, 3, c);
    stack MirValueId c32 = MirConstIntTyped(instrs, MirType.I32, 11);
    stack MirValueId typed = MirStoreGlobalTyped(instrs, MirType.I32, 8, c32);
    stack MirValueId storedVal = MirOperandAOf(instrs, st);
    return MirOpcodeOf(instrs, st) == MirOp.StoreGlobal
        && MirStoredGlobalOf(instrs, st) == 3
        && MirLoadedGlobalOf(instrs, st) == 0
        && storedVal.Equals(c)
        && MirOpcodeOf(instrs, typed) == MirOp.StoreGlobal
        && MirStoredGlobalOf(instrs, typed) == 8
        && MirOperandAOf(instrs, typed).Equals(c32)
        && MirValueType(instrs, typed.Index()) == MirType.I32;
}

[Fact]
fn bool EmitsLlvmGlobalStore()
{
    // A function that stores a constant into a global then returns it:
    // `store i64 %v1, ptr @g1` has no result register.
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack MirValueId c = MirConstInt(instrs, 9);
    stack MirValueId st = MirStoreGlobal(instrs, 1, c);
    stack MirBlockId entry = MirReturnBlock(blocks, c);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithParams(instrs, blocks, "setg", 0, entry.Index(), 1, 2, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i64 @setg() {\nb1:\n  %v1 = add i64 0, 9\n  store i64 %v1, ptr @g1\n  ret i64 %v1\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmTypedGlobalLoadStore()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId loaded = MirLoadGlobalTyped(instrs, MirType.I32, 2);
    stack MirValueId c = MirConstIntTyped(instrs, MirType.I32, 9);
    stack MirValueId stored = MirStoreGlobalTyped(instrs, MirType.I32, 2, c);
    stack MirValueId ret = MirReturn(instrs, loaded);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunction(instrs, "typed_globals", 1, 4, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i32 @typed_globals() {\nentry:\n  %v1 = load i32, ptr @g2\n  %v2 = add i32 0, 9\n  store i32 %v2, ptr @g2\n  ret i32 %v1\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmCompactTypedParamComparison()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId p0 = MirParamTyped(instrs, MirType.I8, 0);
    stack MirValueId tag = MirConstIntTyped(instrs, MirType.I8, 2);
    stack MirValueId eq = MirCmpEq(instrs, p0, tag);
    stack MirValueId ret = MirReturn(instrs, eq);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunctionWithParams(instrs, "tag_eq", 1, 1, 4, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i1 @tag_eq(i8 %p0) {\nentry:\n  %v2 = add i8 0, 2\n  %v3 = icmp eq i8 %p0, %v2\n  ret i1 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool MirGlobalRecordsInitialValue()
{
    // A global records its 1-based id and integer initializer.
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] g1 = MirDefineGlobal(globals, 7);
    stack u32[0 max] g2 = MirDefineGlobal(globals, -3);
    stack u32[0 max] g3 = MirDefineGlobalTyped(globals, MirType.I32, 17);
    stack u32[0 max] g4 = MirDefineGlobalTyped(globals, MirType.I8, -7);
    stack u32[0 max] g5 = MirDefineGlobalTyped(globals, MirType.I16, 30000);
    stack u32[0 max] rejected = MirDefineGlobalTyped(globals, MirType.I1, 2);
    stack u32[0 max] rejectedI8 = MirDefineGlobalTyped(globals, MirType.I8, 128);
    stack u32[0 max] rejectedI16 = MirDefineGlobalTyped(globals, MirType.I16, -32769);
    return g1 == 1
        && g2 == 2
        && g3 == 3
        && g4 == 4
        && g5 == 5
        && rejected == 0
        && rejectedI8 == 0
        && rejectedI16 == 0
        && globals.Count() == 5
        && MirGlobalType(globals, g1) == MirType.I64
        && MirGlobalType(globals, g3) == MirType.I32
        && MirGlobalType(globals, g4) == MirType.I8
        && MirGlobalType(globals, g5) == MirType.I16
        && MirGlobalInitialValue(globals, g1) == 7
        && MirGlobalInitialValue(globals, g2) == -3
        && MirGlobalInitialValue(globals, g3) == 17
        && MirGlobalInitialValue(globals, g4) == -7
        && MirGlobalInitialValue(globals, g5) == 30000
        && MirGlobalInitialValue(globals, 99) == 0;
}

[Fact]
fn bool EmitsLlvmGlobals()
{
    // Globals emit one `@gN = global <type> V` line each, in id order.
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] unused1 = MirDefineGlobal(globals, 7);
    stack u32[0 max] unused2 = MirDefineGlobal(globals, -3);
    stack u32[0 max] unused3 = MirDefineGlobalTyped(globals, MirType.I32, 12);
    stack u32[0 max] unused4 = MirDefineGlobalTyped(globals, MirType.Ptr, 0);
    stack u32[0 max] unused5 = MirDefineGlobalTyped(globals, MirType.I8, -8);
    stack u32[0 max] unused6 = MirDefineGlobalTyped(globals, MirType.I16, 1024);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmGlobals(globals, sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "@g1 = global i64 7\n@g2 = global i64 -3\n@g3 = global i32 12\n@g4 = global ptr null\n@g5 = global i8 -8\n@g6 = global i16 1024\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmGlobalsWithLinkageFacts()
{
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] unused1 = MirDefineGlobal(globals, 7);
    stack u32[0 max] unused2 = MirDefineGlobalTyped(globals, MirType.I32, 12);
    stack u32[0 max] unused3 = MirDefineGlobalTyped(globals, MirType.Ptr, 0);
    stack mut IrTable<GlobalLinkageFacts> linkageFacts = new();
    stack u32[0 max] added1 = linkageFacts.Add(GlobalLinkageFactsOf(true));
    stack u32[0 max] added2 = linkageFacts.Add(GlobalLinkageFactsOf(false));
    stack u32[0 max] added3 = linkageFacts.Add(GlobalLinkageFactsOf(true));
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmGlobalsWithLinkageFacts(globals, linkageFacts, sink))
    {
        case MemoryStatus.Ok:
            return added1 == 1
                && added2 == 2
                && added3 == 3
                && LlvmTextEquals(sink, "@g1 = internal dso_local global i64 7\n@g2 = global i32 12\n@g3 = internal dso_local global ptr null\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmGlobalsWithBackendFacts()
{
    stack mut IrTable<MirGlobal> globals = new();
    stack u32[0 max] unused1 = MirDefineGlobal(globals, 7);
    stack u32[0 max] unused2 = MirDefineGlobalTyped(globals, MirType.I32, 12);
    stack u32[0 max] unused3 = MirDefineGlobalTyped(globals, MirType.Ptr, 0);

    stack mut IrTable<GlobalLinkageFacts> linkageFacts = new();
    stack u32[0 max] linkage1 = linkageFacts.Add(GlobalLinkageFactsOf(true));
    stack u32[0 max] linkage2 = linkageFacts.Add(GlobalLinkageFactsOf(false));
    stack u32[0 max] linkage3 = linkageFacts.Add(GlobalLinkageFactsOf(false));

    stack mut IrTable<GlobalVisibilityFacts> visibilityFacts = new();
    stack u32[0 max] visibility1 = visibilityFacts.Add(GlobalVisibilityFactsOf(GlobalVisibilityKind.Hidden));
    stack u32[0 max] visibility2 = visibilityFacts.Add(GlobalVisibilityFactsOf(GlobalVisibilityKind.Protected));
    stack u32[0 max] visibility3 = visibilityFacts.Add(GlobalVisibilityFactsOf(GlobalVisibilityKind.Default));

    stack mut IrTable<GlobalSectionFacts> sectionFacts = new();
    stack u32[0 max] section1 = sectionFacts.Add(GlobalSectionFactsOf(".stark.fast"));
    stack u32[0 max] section2 = sectionFacts.Add(GlobalSectionFactsOf("quote\"slash\\tail"));
    stack u32[0 max] section3 = sectionFacts.Add(GlobalSectionFactsOf(""));

    stack mut OwnedAscii sink = new();
    switch (EmitLlvmGlobalsWithBackendFacts(globals, linkageFacts, visibilityFacts, sectionFacts, sink))
    {
        case MemoryStatus.Ok:
            return linkage1 == 1
                && linkage2 == 2
                && linkage3 == 3
                && visibility1 == 1
                && visibility2 == 2
                && visibility3 == 3
                && section1 == 1
                && section2 == 2
                && section3 == 3
                && LlvmTextEquals(sink, "@g1 = internal dso_local hidden global i64 7, section \".stark.fast\"\n@g2 = protected global i32 12, section \"quote\\\"slash\\\\tail\"\n@g3 = global ptr null\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

