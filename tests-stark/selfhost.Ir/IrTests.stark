[Fact]
fn bool RejectsStackScalarSwitchAssignmentInvalidTargetsAndValues()
{
    stack mut OwnedAscii wrongType = new();
    stack mut OwnedAscii immutableAssignment = new();
    stack mut OwnedAscii forwardAssignment = new();
    stack mut OwnedAscii missingTarget = new();
    return !CompileModuleFromAstChecked("fn i64 main(i64 x) { stack mut bool flag = false; switch (x) { case 0: flag = 1; default: flag = false; } if flag return 1 else return 0 }", wrongType)
        && !CompileModuleFromAstChecked("fn i32[min max] main(i64 x) { stack i32[min max] value = 0; switch (x) { case 0: value = 4; default: value = 20; } return value }", immutableAssignment)
        && !CompileModuleFromAstChecked("fn i32[min max] main(i64 x) { stack mut i32[min max] value = 0; switch (x) { case 0: { value = later; var later = 1; } default: value = 20; } return value }", forwardAssignment)
        && !CompileModuleFromAstChecked("fn i32[min max] main(i64 x) { switch (x) { case 0: value = 4; default: value = 20; } return value }", missingTarget);
}

