        && MirBlockTerminator(blocks, MirBlockIdOf(8)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(9)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(10)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(11)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(12)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(13)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(14)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(15)) == MirTermKind.Branch
        && MirBlockTerminator(blocks, MirBlockIdOf(16)) == MirTermKind.Return;
}

[Fact]
fn bool CompileFunctionRecursiveNestedSingleLocalIfStatementKeepsTypedPhis()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("fn i32[min max] main(bool outer, bool inner, bool deep) { var value = 0; if outer { if inner { if deep { value = 1; } else { value = 2; } } else { value = 3; } } else { if inner { value = 4; } else { if deep { value = 5; } else { value = 6; } } } return value }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define i32 @main(i1 %p0, i1 %p1, i1 %p2)")
        && System.Text.Contains(sink.View(), " phi i32 ")
        && !System.Text.Contains(sink.View(), " phi i64 ")
        && System.Text.Contains(sink.View(), "br i1")
        && ClangVerifiesLlvmText(sink);
}

