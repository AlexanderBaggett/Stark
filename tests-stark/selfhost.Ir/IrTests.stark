[Fact]
fn bool CompileLocalTerminalIfHeapObjectFieldAssignmentStoresBeforeBranch()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("struct Box { i64 value; bool flag; } fn main() { heap Box box = new Box(); box.flag = true; if box.flag return box.value else return 2 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "%v1 = call noalias nonnull noundef align 8 dereferenceable(16) ptr @__stark_heap_alloc(i64 noundef 16, i64 noundef 8)")
        && System.Text.Contains(sink.View(), "store i1")
        && System.Text.Contains(sink.View(), "load i1")
        && System.Text.Contains(sink.View(), "br i1")
        && !System.Text.Contains(sink.View(), "@__stark_arena_alloc")
        && ClangVerifiesLlvmText(sink);
}

