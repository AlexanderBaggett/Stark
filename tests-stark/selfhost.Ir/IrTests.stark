[Fact]
fn bool SourceModuleLowersLocalTryBindingThroughSuccessorSliceStoreToLlvm()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm(
        "enum Outcome { [Ok] Value(i32[0 max]), [Err] Failed(u8[0 max]) } fn Outcome main(mut i32[0 max][] view, u64[0 max] index) { var value = try Outcome.Value(7); view[index] = value; return Outcome.Value(view[index]) }",
        sink);
    return ok
        && System.Text.Contains(sink.View(), "define { i64, i32 } @main({ ptr, i64 } %p0, i64")
        && System.Text.Contains(sink.View(), "extractvalue { ptr, i64 } %p0, 0")
        && System.Text.Contains(sink.View(), "extractvalue { ptr, i64 } %p0, 1")
        && System.Text.Contains(sink.View(), "br i1")
        && System.Text.Contains(sink.View(), ".scale = mul i64 %p1, 4")
        && System.Text.Contains(sink.View(), "getelementptr i8")
        && !System.Text.Contains(sink.View(), "getelementptr inbounds i8")
        && System.Text.Contains(sink.View(), "store i32")
        && System.Text.Contains(sink.View(), "load i32")
        && System.Text.Contains(sink.View(), "ret {");
}

