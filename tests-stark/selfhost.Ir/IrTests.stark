[Fact]
fn bool AsmMetadataRejectsInvalidClobberRegisterBeforeAppendingRows()
{
    stack mut AsmMetadataTable table = new();
    stack mut AsmFunctionId asmId = new();
    return !CollectFirstAsmFunctionMetadata(
            "module Test\ninternal unsafe ffi asm(aarch64) fn i64[min max] Bad(i64[min max] number) in(\"x8\") number, out(\"x0\") return, clobber(\"rax\") { \"svc #0\" }",
            MirFuncIdOf(1),
            table,
