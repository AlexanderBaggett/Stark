[Fact]
fn bool SourceTryCompatibilityAcceptsSameFailurePayloadType()
{
    stack ascii source = raw"""
    enum IOError { Read }
    enum FetchOutcome
    {
        [Ok] Value(i32[0 max]),
        [Err] Failed(IOError)
    }
    enum LoadOutcome
    {
        [Ok] Value(i32[0 max]),
        [Err] Failed(IOError)
    }
    """;

    stack mut TokenStream stream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedEnumPayloadTable payloads = new();
    stack mut TypedEnumLayoutTable layouts = new();
    stack mut OwnedAscii sourceText = new();
    if (sourceText.AppendAscii(source) != MemoryStatus.Ok
        || !BuildTypedEnumTryInputsForSource(source, stream, declarations, payloads, layouts))
    {
        return false;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    moduleFacts.Declarations = declarations;
    moduleFacts.EnumPayloads = payloads;
    moduleFacts.EnumLayouts = layouts;

    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    stack mut SourceTryPropagationCompatibilityFacts facts = new();
    stack bool ok = TryResolveSourceTryPropagationCompatibility(stream, sourceText.View(), sourceBytes, moduleFacts, 1, 2, facts);
    stack SourceTryPropagationRoleFacts operandRoles = facts.OperandRoles();
    stack SourceTryPropagationRoleFacts returnRoles = facts.ReturnRoles();
    return ok
        && facts.IsValid()
        && facts.ErrorCompatibilityKind() == SourceTryPropagationErrorCompatibilityKind.SameFailurePayloadType
        && operandRoles.ErrVariantOrdinal() == 1
        && returnRoles.ErrVariantOrdinal() == 1;
}

