        && graph.TemplateEnumPatternRowCount() == 1
        && graph.TemplateEnumPatternMemberRowCount() == 0
        && graph.TemplateCallSignatureRowCount() == 3
        && graph.TemplateCallParameterRowCount() == 1
        && graph.TemplateCallTypeArgumentRowCount() == 1
        && graph.TemplateCallComptimeValueArgumentRowCount() == 1
        && template.ObjectCreationCount() == 1
