fn bool SourceTryExpressionParserDoesNotEraseTry()
{
    return InferSourceExpressionType("try 1") == ExprType.ErrorType;
}

[Fact]
fn bool SourceTryExpressionGenericLoweringRequiresTryPath()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] operand = MakeIntLit(nodes, 7);
    stack u32[0 max] tryNode = MakeTry(nodes, operand);
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId lowered = LowerExprNode(nodes, tryNode, instrs);
    return lowered.Index() == 0 && instrs.Count() == 0;
}

fn bool BuildTypedEnumLayoutsForSource(ascii source, out TokenStream stream, out TypedEnumLayoutTable layouts)
{
    stream = new();
    layouts = new();

    stack mut TokenStream parsedStream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            parsedStream = lexed;
    }

    stack mut DeclarationList declarations = new();
    switch (ParseDeclarations(parsedStream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDeclarations):
            declarations = parsedDeclarations;
    }

    switch (BuildTypedEnumLayouts(source, parsedStream, declarations))
    {
        case ParseResult<TypedEnumLayoutTable>.Err(var layoutError):
            return false;
        case ParseResult<TypedEnumLayoutTable>.Ok(var builtLayouts):
            layouts = builtLayouts;
            stream = parsedStream;
            return true;
    }
}

fn bool BuildTypedEnumTryInputsForSource(
    ascii source,
    out TokenStream stream,
    out DeclarationList declarations,
    out TypedEnumPayloadTable payloads,
    out TypedEnumLayoutTable layouts)
{
    stream = new();
    declarations = new();
    payloads = new();
    layouts = new();

    stack mut TokenStream parsedStream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            parsedStream = lexed;
    }

    stack mut DeclarationList parsedDeclarations = new();
    switch (ParseDeclarations(parsedStream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsed):
            parsedDeclarations = parsed;
    }

    stack mut TypedEnumPayloadTable builtPayloads = new();
    switch (BuildTypedEnumPayloads(source, parsedStream, parsedDeclarations))
    {
        case ParseResult<TypedEnumPayloadTable>.Err(var payloadError):
            return false;
        case ParseResult<TypedEnumPayloadTable>.Ok(var parsedPayloads):
            builtPayloads = parsedPayloads;
    }

    switch (BuildTypedEnumLayouts(source, parsedStream, parsedDeclarations))
    {
        case ParseResult<TypedEnumLayoutTable>.Err(var layoutError):
            return false;
        case ParseResult<TypedEnumLayoutTable>.Ok(var builtLayouts):
            stream = parsedStream;
            declarations = parsedDeclarations;
            payloads = builtPayloads;
            layouts = builtLayouts;
            return true;
    }
}

[Fact]
fn bool SourceTryRoleFactsResolveOkErrEnumLayouts()
{
    stack ascii source = raw"""
    enum Outcome
    {
        [Ok] Value(i32[0 max]),
        [Err] Failure(u8[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedEnumPayloadTable payloads = new();
    stack mut TypedEnumLayoutTable layouts = new();
    stack mut OwnedAscii sourceText = new();
    if (sourceText.AppendAscii(source) != MemoryStatus.Ok
        || !BuildTypedEnumTryInputsForSource(source, stream, declarations, payloads, layouts))
    {
        return false;
    }

    stack mut SourceModuleLoweringFacts moduleFacts = new();
    moduleFacts.Declarations = declarations;
    moduleFacts.EnumPayloads = payloads;
    moduleFacts.EnumLayouts = layouts;

    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    stack mut SourceTryPropagationRoleFacts facts = new();
    return TryResolveSourceTryPropagationRoleFacts(stream, sourceBytes, moduleFacts, 0, facts)
        && facts.IsValid()
        && facts.OkVariantOrdinal() == 0
        && facts.OkVariantTag() == 0
        && facts.OkPayloadCount() == 1
        && facts.OkPayloadTypeCode() == SourceResolvedFieldTypeCodeI32()
        && facts.ErrVariantOrdinal() == 1
        && facts.ErrVariantTag() == 1
        && facts.ErrPayloadCount() == 1
        && facts.ErrPayloadTypeCode() == SourceResolvedFieldTypeCodeI8();
}

