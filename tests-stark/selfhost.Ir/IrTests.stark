fn bool BuildParamAbiFactsForFirstFunction(ascii source, out TokenStream stream, out IrTable<ParamAbiFacts> paramAbiFacts)
{
    stream = new();
    paramAbiFacts = new();

    stack mut OwnedAscii sourceText = new();
    stack MemoryStatus copyStatus = sourceText.AppendAscii(source);
    if (copyStatus != MemoryStatus.Ok)
    {
        return false;
    }

    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    stack mut TokenStream parsedStream = new();
    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            parsedStream = lexed;
    }

    stack mut bool foundFunction = false;
    stack mut u32[0 max] fnIndex = 0;
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < parsedStream.Count())
    {
        if (parsedStream.KindAt(scan) == TokenKind.Fn)
        {
            foundFunction = true;
            fnIndex = (u32[0 max])scan;
            scan = parsedStream.Count();
        }
        else
        {
            scan = scan + 1;
        }
    }

    if (!foundFunction)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(parsedStream, fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> builtFacts = new();
    if (!BuildParamAbiFacts(parsedStream, sourceBytes, signature, builtFacts))
    {
        return false;
    }

    stream = parsedStream;
    paramAbiFacts = builtFacts;
    return true;
}

[Fact]
fn bool BuildParamAbiFactsRecordsByValueStructParameterShape()
{
    stack ascii source = "struct Box { i32 value; bool flag; } fn i64 classify(Box box, i64 scalar) { return scalar }";
    stack mut TokenStream stream = new();
    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFactsForFirstFunction(source, stream, paramAbiFacts))
    {
        return false;
    }

    stack ParamAbiFacts boxFacts = AbiFactAt(paramAbiFacts, 1);
    stack ParamAbiFacts scalarFacts = AbiFactAt(paramAbiFacts, 2);
    stack ascii ownerName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])boxFacts.StructValueTypeToken);
    stack u32[0 max] expectedShape = StructValueShapeTypeCode(MirType.I32)
        + StructValueShapeTypeCode(MirType.I1) * StructValueShapeMultiplierForIndex(1);
    return boxFacts.IsStructValue
        && !boxFacts.IsPointer
        && !boxFacts.IsSlice
        && !boxFacts.IsFixedArray
        && ownerName == "Box"
        && boxFacts.StructValueSize == 8
        && boxFacts.StructValueAlignment == 4
        && boxFacts.StructValueFieldCount == 2
        && boxFacts.StructValueShapeCode == expectedShape
        && !scalarFacts.IsStructValue;
}

[Fact]
fn bool CompileFunctionByValueStructParameterEmitsAggregateSignature()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionToLlvm("struct Box { i32 value; bool flag; } fn i64 classify(Box box, i64 scalar) { return scalar }", sink);
    return ok
        && LlvmTextEquals(sink, "define i64 @main({ i32, i1 } %p0, i64 %p1) {\nb1:\n  ret i64 %p1\n}\n");
}

[Fact]
fn bool EmitLlvmStructParamFieldExtractsAggregateParameterDirectly()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack u32[0 max] shape = StructValueShapeTypeCode(MirType.I32)
        + StructValueShapeTypeCode(MirType.I1) * StructValueShapeMultiplierForIndex(1);
    stack MirValueId field = MirStructParamField(instrs, 0, 0, 2, shape, MirType.I32);
    stack MirBlockId entry = MirReturnBlock(blocks, field);

    stack mut ParamAbiFacts abi = new();
    abi.IsStructValue = true;
    abi.StructValueSize = 8;
    abi.StructValueAlignment = 4;
    abi.StructValueFieldCount = 2;
    abi.StructValueShapeCode = shape;

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (paramAbiFacts.Add(abi) != 1)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> noTailCallees = new();
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    stack mut IrTable<ValueFacts> paramFacts = new();
    stack mut IrTable<DistinctStoragePair> separateStorageFacts = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut ValueFacts returnFacts = new();
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmDefinitionWithRangeFactsCore(
        instrs,
        noTailCallees,
        noFunctionEffectFacts,
        noFunctionCallContractFacts,
        noFunctionLinkageFacts,
        noFunctionCallingConventionFacts,
        blocks,
        "read_box",
        false,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        separateStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        NoFunctionEffectFacts(),
        1,
        entry.Index(),
        1,
        1,
        sink))
    {
        case MemoryStatus.Ok:
            return LlvmTextEquals(sink, "define i32 @read_box({ i32, i1 } %p0) {\nb1:\n  %v1 = extractvalue { i32, i1 } %p0, 0\n  ret i32 %v1\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

