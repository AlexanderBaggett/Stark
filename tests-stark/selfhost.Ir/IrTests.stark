[Fact]
fn bool PackageTablesPreserveBooleanReturnIfExpression()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Pick(i64[min max] x) { return if x < 10 x < 5 else x == 10 }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId thenReturn = MirBlockReturnValue(blocks, MirBlockIdOf(2));
    stack MirValueId elseReturn = MirBlockReturnValue(blocks, MirBlockIdOf(3));
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 3
        && MirFunctionBlockCount(funcs, MirFuncIdOf(1)) == 3
        && MirFunctionInstrCount(funcs, MirFuncIdOf(1)) >= 8
        && MirBlockTerminator(blocks, MirBlockIdOf(1)) == MirTermKind.CondBranch
        && MirBlockTerminator(blocks, MirBlockIdOf(2)) == MirTermKind.Return
        && MirBlockTerminator(blocks, MirBlockIdOf(3)) == MirTermKind.Return
        && MirOpcodeOf(instrs, thenReturn) == MirOp.ZExt
        && MirOpcodeOf(instrs, elseReturn) == MirOp.ZExt
        && MirValueType(instrs, thenReturn.Index()) == MirType.I64
        && MirValueType(instrs, elseReturn.Index()) == MirType.I64;
}

