[Fact]
fn bool EmitsLlvmTypedI32ExtendedArithmeticFunction()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstIntTyped(instrs, MirType.I32, 20);
    stack MirValueId b = MirConstIntTyped(instrs, MirType.I32, 6);
    stack MirValueId sdiv = MirSDivTyped(instrs, MirType.I32, a, b);
    stack MirValueId udiv = MirUDivTyped(instrs, MirType.I32, a, b);
    stack MirValueId srem = MirSRemTyped(instrs, MirType.I32, a, b);
    stack MirValueId andValue = MirAndTyped(instrs, MirType.I32, a, b);
    stack MirValueId orValue = MirOrTyped(instrs, MirType.I32, a, b);
    stack MirValueId xorValue = MirXorTyped(instrs, MirType.I32, a, b);
    stack MirValueId shl = MirShlTyped(instrs, MirType.I32, a, b);
    stack MirValueId ashr = MirAShrTyped(instrs, MirType.I32, a, b);
    stack MirValueId unusedRet = MirReturn(instrs, ashr);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunction(instrs, "exti32", 1, 11, sink))
    {
        case MemoryStatus.Ok:
            return MirValueType(instrs, sdiv.Index()) == MirType.I32
                && MirValueType(instrs, udiv.Index()) == MirType.I32
                && MirValueType(instrs, srem.Index()) == MirType.I32
                && MirValueType(instrs, andValue.Index()) == MirType.I32
                && MirValueType(instrs, orValue.Index()) == MirType.I32
                && MirValueType(instrs, xorValue.Index()) == MirType.I32
                && MirValueType(instrs, shl.Index()) == MirType.I32
                && MirValueType(instrs, ashr.Index()) == MirType.I32
                && LlvmTextEquals(sink, "define i32 @exti32() {\nentry:\n  %v1 = add i32 0, 20\n  %v2 = add i32 0, 6\n  %v3 = sdiv i32 %v1, %v2\n  %v4 = udiv i32 %v1, %v2\n  %v5 = srem i32 %v1, %v2\n  %v6 = and i32 %v1, %v2\n  %v7 = or i32 %v1, %v2\n  %v8 = xor i32 %v1, %v2\n  %v9 = shl i32 %v1, %v2\n  %v10 = ashr i32 %v1, %v2\n  ret i32 %v10\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

[Fact]
fn bool EmitsLlvmTypedI32CallFunction()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId a = MirConstIntTyped(instrs, MirType.I32, 4);
    stack MirValueId b = MirConstIntTyped(instrs, MirType.I32, 5);
    stack MirValueId result = MirCall2Typed(instrs, MirType.I32, MirFuncIdOf(3), a, b);
    stack MirValueId unusedRet = MirReturn(instrs, result);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmTypedFunction(instrs, "typed_call", 1, 4, sink))
    {
        case MemoryStatus.Ok:
            return MirOpcodeOf(instrs, result) == MirOp.Call
                && MirCalleeOf(instrs, result).Equals(MirFuncIdOf(3))
                && MirValueType(instrs, result.Index()) == MirType.I32
                && LlvmTextEquals(sink, "define i32 @typed_call() {\nentry:\n  %v1 = add i32 0, 4\n  %v2 = add i32 0, 5\n  %v3 = call i32 @f3(i32 %v1, i32 %v2)\n  ret i32 %v3\n}\n");
        case MemoryStatus.Err(var error):
            return false;
    }
}

