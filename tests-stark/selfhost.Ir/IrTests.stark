        {
            sawStackAlloc = sawStackAlloc
                || (MirImmediateOf(instrs, value) == 8
                    && MirOperandAImmediateOf(instrs, value) == 4);
        }
        else if (opcode == MirOp.PtrIndexOffset)
        {
            if (MirImmediateOf(instrs, value) == 0
                && MirOperandCImmediateOf(instrs, value) == 4
                && MirOperandDImmediateOf(instrs, value) == 4
                && MirValueType(instrs, value.Index()) == MirType.Ptr)
            {
