                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageGenericTemplateFactGraph graph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageGenericTemplateFactJsonGraph(
            manifestJson,
            0,
            graph))
        {
            return false;
        }
    }

    stack mut IrTable<MirInstruction> instructions = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> functions = new();
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut ValueFacts expectedReturnFacts = new();
    expectedReturnFacts.SetIntegerRange(0, 1001);
    stack mut MirFuncId function = MirFuncIdOf(0);
    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            1,
            MirType.I16,
            false,
            expectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            function) != ImportedTemplateMirLoweringStatus.Ok)
    {
        return false;
    }

    stack mut MirFuncId nestedFunction = MirFuncIdOf(0);
    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            2,
            MirType.I16,
            false,
            expectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            nestedFunction) != ImportedTemplateMirLoweringStatus.Ok)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] instructionCount = instructions.Count();
    stack u64[0 2 ** 63 - 1] blockCount = blocks.Count();
    stack u64[0 2 ** 63 - 1] functionCount = functions.Count();
    stack mut MirFuncId deepNestedFunction = MirFuncIdOf(0);
    if (LowerImportedTemplateScalarReturnToMir(
            graph,
            3,
            MirType.I16,
            false,
            expectedReturnFacts,
            instructions,
            blocks,
            functions,
            valueFacts,
            functionReturnFacts,
            deepNestedFunction) != ImportedTemplateMirLoweringStatus.UnsupportedBody
        || deepNestedFunction.IsValid()
        || instructions.Count() != instructionCount
        || blocks.Count() != blockCount
        || functions.Count() != functionCount
        || valueFacts.Count() != instructionCount
        || functionReturnFacts.Count() != functionCount)
    {
        return false;
    }

    stack MirInstruction literal = instructions.Get(1);
    stack MirInstruction nestedLiteral = instructions.Get(2);
    stack ValueFacts literalFacts = ValueFactsForMirValue(
        valueFacts,
        MirValueIdOf(1));
    stack ValueFacts returnFacts = ValueFactsAtIndex(
        functionReturnFacts,
        function.Index());
    stack ValueFacts nestedLiteralFacts = ValueFactsForMirValue(
        valueFacts,
        MirValueIdOf(2));
    stack ValueFacts nestedReturnFacts = ValueFactsAtIndex(
        functionReturnFacts,
        nestedFunction.Index());
    stack MirFunction lowered = functions.Get(function.Index());
    stack MirFunction nestedLowered = functions.Get(nestedFunction.Index());
    stack mut IrTable<ValueFacts> noParameterFacts = new();
    stack mut IrTable<ValueFacts> noGlobalFacts = new();
    stack mut OwnedAscii llvm = new();
    stack mut OwnedAscii nestedLlvm = new();
    if (EmitLlvmDefinitionWithRangeFacts(
            instructions,
            blocks,
            "imported_preamble",
            returnFacts,
            noParameterFacts,
            valueFacts,
            noGlobalFacts,
            functionReturnFacts,
            0,
            lowered.EntryIndex(),
            lowered.FirstInstrIndex(),
            lowered.OwnedInstrCount(),
            llvm) != MemoryStatus.Ok)
    {
        return false;
    }

    if (EmitLlvmDefinitionWithRangeFacts(
            instructions,
            blocks,
            "imported_nested",
            nestedReturnFacts,
            noParameterFacts,
            valueFacts,
            noGlobalFacts,
            functionReturnFacts,
            0,
            nestedLowered.EntryIndex(),
            nestedLowered.FirstInstrIndex(),
            nestedLowered.OwnedInstrCount(),
            nestedLlvm) != MemoryStatus.Ok)
    {
        return false;
    }

    return function.Index() == 1
        && nestedFunction.Index() == 2
        && instructions.Count() == 2
        && blocks.Count() == 2
        && functions.Count() == 2
        && literal.Opcode() == MirOp.ConstInt
        && literal.ResultType() == MirType.I16
        && literal.Immediate() == 307
        && literalFacts.HasIntegerRange()
        && literalFacts.IntegerRangeLower() == 307
        && literalFacts.IntegerRangeUpperExclusive() == 308
        && nestedLiteral.Opcode() == MirOp.ConstInt
        && nestedLiteral.ResultType() == MirType.I16
        && nestedLiteral.Immediate() == 9
        && nestedLiteralFacts.HasIntegerRange()
        && nestedLiteralFacts.IntegerRangeLower() == 9
        && nestedLiteralFacts.IntegerRangeUpperExclusive() == 10
        && returnFacts.HasIntegerRange()
        && returnFacts.IntegerRangeLower() == 307
        && returnFacts.IntegerRangeUpperExclusive() == 308
        && nestedReturnFacts.HasIntegerRange()
        && nestedReturnFacts.IntegerRangeLower() == 9
        && nestedReturnFacts.IntegerRangeUpperExclusive() == 10
        && LlvmTextEquals(
            llvm,
            "define range(i16 307, 308) i16 @imported_preamble() {\nb1:\n  %v1 = add i16 0, 307\n  ret i16 %v1\n}\n")
        && LlvmTextEquals(
            nestedLlvm,
            "define range(i16 9, 10) i16 @imported_nested() {\nb2:\n  %v2 = add i16 0, 9\n  ret i16 %v2\n}\n");
}

[Fact]
fn bool LogicalPackageImageMaterializesTypedGlobalFactGraphRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "TypedInterface": {
                  "Functions": [],
                  "Types": [],
                  "Globals": [
                    {
                      "Name": "Counter",
                      "QualifiedName": "Demo.Counter",
                      "Visibility": "public",
                      "Kind": "static",
                      "Type": { "Kind": "Named", "Name": "Demo.Table" },
                      "IsMutable": true,
                      "ConstantInitializer": {
                        "Kind": "fixedarray",
                        "Type": { "Kind": "Named", "Name": "Demo.Table" },
                        "Elements": [
                          {
                            "Kind": "integer",
                            "Type": { "Kind": "Integer", "BitWidth": 32 },
                            "IntegerValue": "7"
                          },
                          {
                            "Kind": "enumaggregate",
                            "Type": { "Kind": "Named", "Name": "Demo.Flag" },
                            "VariantName": "On",
                            "Elements": [
                              {
                                "Kind": "bool",
                                "Type": { "Kind": "Bool" },
                                "BoolValue": true
                              }
                            ]
                          },
                          {
                            "Kind": "text",
                            "Type": { "Kind": "Named", "Name": "Demo.Text" },
                            "TextLiteralText": ""
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "TypedInterface": {
                "Functions": [],
                "Types": [],
                "Globals": [
                  {
                    "Name": "Bad",
                    "QualifiedName": "Demo.Bad",
                    "Visibility": "public",
                    "Kind": "static",
                    "Type": { "Kind": "Integer", "BitWidth": 32 },
                    "IsMutable": false,
                    "ConstantInitializer": {
                      "Kind": "integer",
                      "Type": { "Kind": "Integer", "BitWidth": 32 }
                    }
                  }
                ]
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageTypedGlobalFactGraph graph = new();
    stack mut LogicalPackageTypedGlobalFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageTypedGlobalFactJsonGraph(manifestJson, 0, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageTypedGlobalFactJsonGraph(malformedJson, 0, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageTypedGlobalRow global = graph.GlobalRowAt(1);
    stack LogicalPackageTypedConstantInitializerRow root = graph.InitializerRowAt(global.RootInitializerRow());
    stack LogicalPackageTypedConstantInitializerRow integerChild = graph.InitializerRowAt(root.FirstElementRow());
    stack LogicalPackageTypedConstantInitializerRow enumChild = graph.InitializerRowAt(root.FirstElementRow() + 1);
    stack LogicalPackageTypedConstantInitializerRow textChild = graph.InitializerRowAt(root.FirstElementRow() + 2);
    stack LogicalPackageTypedConstantInitializerRow boolChild = graph.InitializerRowAt(enumChild.FirstElementRow());
    stack LogicalPackageTypeReferenceRow globalType =
        graph.TypeReferenceGraph().TypeReferenceAt(global.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow rootType =
        graph.TypeReferenceGraph().TypeReferenceAt(root.TypeReferenceRow());
    stack LogicalPackageTypeReferenceRow boolType =
        graph.TypeReferenceGraph().TypeReferenceAt(boolChild.TypeReferenceRow());
    stack LogicalPackageTypedGlobalFactTextRow globalKindText = graph.TextRowAt(global.KindTextRow());
    stack LogicalPackageTypedGlobalFactTextRow rootKindText = graph.TextRowAt(root.KindTextRow());
    stack LogicalPackageTypedGlobalFactTextRow integerValueText = graph.TextRowAt(integerChild.IntegerValueTextRow());
    stack LogicalPackageTypedGlobalFactTextRow enumVariantText = graph.TextRowAt(enumChild.VariantNameTextRow());
    stack LogicalPackageTypedGlobalFactTextRow textLiteralText = graph.TextRowAt(textChild.TextLiteralTextRow());
    stack LogicalPackageTypedGlobalFactTextRow boolKindText = graph.TextRowAt(boolChild.KindTextRow());
    stack mut OwnedAscii globalKind = new();
    stack mut OwnedAscii rootKind = new();
    stack mut OwnedAscii integerValue = new();
    stack mut OwnedAscii enumVariant = new();
    stack mut OwnedAscii textLiteral = new();
    stack mut OwnedAscii boolKind = new();
    stack mut OwnedAscii globalTypeName = new();
    stack mut OwnedAscii rootTypeName = new();
    return graph.GlobalRowCount() == 1
        && graph.InitializerRowCount() == 5
        && graph.TypeReferenceCount() == 6
        && graph.TextRowCount() >= 9
        && graph.TextByteCount() > 0
        && global.ModuleOrdinal() == 0
        && global.GlobalOrdinal() == 0
        && global.IsMutable()
        && global.HasConstantInitializer()
        && global.RootInitializerRow() == 1
        && root.ParentInitializerRow() == 0
        && root.InitializerOrdinal() == 0
        && root.FirstElementRow() == 2
        && root.ElementRowCount() == 3
        && integerChild.ParentInitializerRow() == 1
        && integerChild.ParentChildOrdinal() == 0
        && integerChild.HasIntegerValue()
        && !integerChild.HasFloatLiteralText()
        && enumChild.ParentInitializerRow() == 1
        && enumChild.ParentChildOrdinal() == 1
        && enumChild.HasVariantName()
        && enumChild.FirstElementRow() == 5
        && enumChild.ElementRowCount() == 1
        && textChild.ParentInitializerRow() == 1
        && textChild.ParentChildOrdinal() == 2
        && textChild.HasTextLiteralText()
        && boolChild.ParentInitializerRow() == 3
        && boolChild.ParentChildOrdinal() == 0
        && boolChild.HasBoolValue()
        && boolChild.BoolValue()
        && globalType.Summary().Source() == LogicalPackageTypedTypeReferenceSource.GlobalType
        && globalType.Summary().DeclarationKind() == LogicalPackageTypedDeclarationKind.Global
        && globalType.Summary().PayloadOrdinal() == 0
        && rootType.Summary().Source() == LogicalPackageTypedTypeReferenceSource.GlobalConstantInitializerType
        && rootType.Summary().PayloadOrdinal() == 0
        && boolType.Summary().Source() == LogicalPackageTypedTypeReferenceSource.GlobalConstantInitializerType
        && boolType.Summary().PayloadOrdinal() == 4
        && AppendLogicalPackageTypedGlobalFactText(graph, globalKindText, globalKind) == MemoryStatus.Ok
        && AppendLogicalPackageTypedGlobalFactText(graph, rootKindText, rootKind) == MemoryStatus.Ok
        && AppendLogicalPackageTypedGlobalFactText(graph, integerValueText, integerValue) == MemoryStatus.Ok
        && AppendLogicalPackageTypedGlobalFactText(graph, enumVariantText, enumVariant) == MemoryStatus.Ok
        && AppendLogicalPackageTypedGlobalFactText(graph, textLiteralText, textLiteral) == MemoryStatus.Ok
        && AppendLogicalPackageTypedGlobalFactText(graph, boolKindText, boolKind) == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            global.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            globalTypeName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            root.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            rootTypeName)
        && OwnedAsciiEqualsAscii(globalKind, "static")
        && OwnedAsciiEqualsAscii(rootKind, "fixedarray")
        && OwnedAsciiEqualsAscii(integerValue, "7")
        && OwnedAsciiEqualsAscii(enumVariant, "On")
        && textLiteral.Length() == 0
        && OwnedAsciiEqualsAscii(boolKind, "bool")
        && OwnedAsciiEqualsAscii(globalTypeName, "Demo.Table")
        && OwnedAsciiEqualsAscii(rootTypeName, "Demo.Table");
}

[Fact]
fn bool LogicalPackageImageMaterializesTypedTypeAliasFactGraphRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "TypedInterface": {
                  "Functions": [],
                  "Types": [],
                  "Globals": [],
                  "TypeAliases": [
                    {
                      "Name": "SpanAlias",
                      "QualifiedName": "Demo.SpanAlias",
                      "Visibility": "public",
                      "TargetType": {
                        "Kind": "Named",
                        "Name": "Demo.Span",
                        "TypeArguments": [ { "Kind": "Named", "Name": "T" } ]
                      },
                      "GenericParameters": [ "T" ],
                      "ComptimeGenericParameters": [
                        {
                          "Name": "N",
                          "Type": { "Kind": "Integer", "BitWidth": 32, "IsUnsigned": true }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "TypedInterface": {
                "Functions": [],
                "Types": [],
                "Globals": [],
                "TypeAliases": [
                  {
                    "Name": "BadAlias",
                    "QualifiedName": "Demo.BadAlias",
                    "Visibility": "public",
                    "TargetType": { "Kind": "Named", "Name": "Demo.Target" },
                    "ComptimeGenericParameters": [ { "Name": "N" } ]
                  }
                ]
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageTypedTypeAliasFactGraph graph = new();
    stack mut LogicalPackageTypedTypeAliasFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageTypedTypeAliasFactJsonGraph(manifestJson, 0, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageTypedTypeAliasFactJsonGraph(malformedJson, 0, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageTypedTypeAliasRow aliasRow = graph.TypeAliasRowAt(1);
    stack LogicalPackageTypedTypeAliasGenericParameterRow genericParameter =
        graph.GenericParameterRowAt(1);
    stack LogicalPackageTypedTypeAliasComptimeGenericParameterRow comptimeGenericParameter =
        graph.ComptimeGenericParameterRowAt(1);
    stack LogicalPackageTypeReferenceRow targetType =
        graph.TypeReferenceGraph().TypeReferenceAt(aliasRow.TargetTypeReferenceRow());
    stack LogicalPackageTypeReferenceChildRow targetTypeArgument =
        graph.TypeReferenceGraph().ChildRowAt(targetType.FirstChildRow());
    stack LogicalPackageTypeReferenceRow targetTypeArgumentType =
        graph.TypeReferenceGraph().TypeReferenceAt(targetTypeArgument.ChildTypeReferenceRow());
    stack LogicalPackageTypeReferenceRow comptimeType =
        graph.TypeReferenceGraph().TypeReferenceAt(comptimeGenericParameter.TypeReferenceRow());
    stack LogicalPackageTypedTypeAliasFactTextRow genericNameTextRow =
        graph.TextRowAt(genericParameter.NameTextRow());
    stack LogicalPackageTypedTypeAliasFactTextRow comptimeNameTextRow =
        graph.TextRowAt(comptimeGenericParameter.NameTextRow());
    stack mut OwnedAscii genericName = new();
    stack mut OwnedAscii comptimeName = new();
    stack mut OwnedAscii targetName = new();
    stack mut OwnedAscii targetArgumentName = new();
    stack mut OwnedAscii comptimeKind = new();
    return graph.TypeAliasRowCount() == 1
        && graph.GenericParameterRowCount() == 1
        && graph.ComptimeGenericParameterRowCount() == 1
        && graph.TypeReferenceCount() == 3
        && graph.TextRowCount() == 2
        && graph.TextByteCount() > 0
        && aliasRow.ModuleOrdinal() == 0
        && aliasRow.TypeAliasOrdinal() == 0
        && aliasRow.FirstGenericParameterRow() == 1
        && aliasRow.GenericParameterRowCount() == 1
        && aliasRow.FirstComptimeGenericParameterRow() == 1
        && aliasRow.ComptimeGenericParameterRowCount() == 1
        && genericParameter.TypeAliasRow() == 1
        && genericParameter.ParameterOrdinal() == 0
        && comptimeGenericParameter.TypeAliasRow() == 1
        && comptimeGenericParameter.ParameterOrdinal() == 0
        && targetType.Summary().DeclarationKind() == LogicalPackageTypedDeclarationKind.TypeAlias
        && targetType.Summary().Source() == LogicalPackageTypedTypeReferenceSource.TypeAliasTarget
        && targetType.Summary().PayloadOrdinal() == 0
        && targetType.ChildRowCount() == 1
        && targetTypeArgument.ChildKind() == LogicalPackageTypeReferenceChildKind.TypeArgument
        && targetTypeArgument.ChildOrdinal() == 0
        && targetTypeArgumentType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.TypeAliasTarget
        && comptimeType.Summary().Source()
            == LogicalPackageTypedTypeReferenceSource.TypeAliasComptimeGenericParameterType
        && comptimeType.Summary().PayloadOrdinal() == 0
        && comptimeType.Summary().HasBitWidth()
        && comptimeType.Summary().HasIsUnsigned()
        && comptimeType.Summary().IsUnsigned()
        && AppendLogicalPackageTypedTypeAliasFactText(graph, genericNameTextRow, genericName)
            == MemoryStatus.Ok
        && AppendLogicalPackageTypedTypeAliasFactText(graph, comptimeNameTextRow, comptimeName)
            == MemoryStatus.Ok
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            aliasRow.TargetTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            targetName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            targetTypeArgument.ChildTypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Name,
            0,
            targetArgumentName)
        && TryAppendLogicalPackageTypeReferenceText(
            graph.TypeReferenceGraph(),
            comptimeGenericParameter.TypeReferenceRow(),
            LogicalPackageTypeReferenceTextKind.Kind,
            0,
            comptimeKind)
        && OwnedAsciiEqualsAscii(genericName, "T")
        && OwnedAsciiEqualsAscii(comptimeName, "N")
        && OwnedAsciiEqualsAscii(targetName, "Demo.Span")
        && OwnedAsciiEqualsAscii(targetArgumentName, "T")
        && OwnedAsciiEqualsAscii(comptimeKind, "Integer");
}

[Fact]
fn bool LogicalPackageImageMaterializesFunctionEffectFactGraphRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "CompilerFacts": {
                  "FunctionEffects": [
                    {
                      "QualifiedResolvedName": "Demo.Work",
                      "Kind": "finite",
                      "ReadsArgumentMemory": true,
                      "IsPure": false,
                      "NoSync": true,
                      "NoFree": true,
                      "NoUnwind": true,
                      "WillReturn": true,
                      "MustProgress": true,
                      "UseFastCallingConvention": true,
                      "IsFfi": false,
                      "IsHot": true,
                      "IsCold": false,
                      "InlinePreference": "inline",
                      "IsStrictFp": false,
                      "IsTailCallable": true,
                      "BackendOptimizationMode": "opaque",
                      "NoRecurse": true
                    },
                    {
                      "QualifiedResolvedName": "Demo.CPrintf",
                      "Kind": "fn",
                      "ReadsArgumentMemory": false,
                      "IsPure": false,
                      "NoSync": false,
                      "NoFree": false,
                      "NoUnwind": true,
                      "WillReturn": false,
                      "MustProgress": false,
                      "UseFastCallingConvention": false,
                      "IsFfi": true,
                      "IsHot": false,
                      "IsCold": true,
                      "InlinePreference": "noinline",
                      "IsStrictFp": true,
                      "IsVarargs": true,
                      "FfiAbi": "c"
                    }
                  ]
                }
              }
            }
          ]
        }
        """;

    stack ascii malformedJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerFacts": {
                "FunctionEffects": [
                  {
                    "QualifiedResolvedName": "Demo.Bad",
                    "Kind": "fn",
                    "ReadsArgumentMemory": false,
                    "IsPure": false,
                    "NoSync": false,
                    "NoFree": false,
                    "WillReturn": true,
                    "MustProgress": true,
                    "UseFastCallingConvention": false,
                    "IsFfi": false,
                    "IsHot": false,
                    "IsCold": false,
                    "InlinePreference": "inlinehint",
                    "IsStrictFp": false
                  }
                ]
              }
            }
          ]
        }
        """;

    stack mut LogicalPackageFunctionEffectFactGraph graph = new();
    stack mut LogicalPackageFunctionEffectFactGraph rejectedGraph = new();
    unsafe
    {
        if (!TryMaterializeLogicalPackageFunctionEffectFactJsonGraph(manifestJson, 0, graph))
        {
            return false;
        }

        if (TryMaterializeLogicalPackageFunctionEffectFactJsonGraph(malformedJson, 0, rejectedGraph))
        {
            return false;
        }
    }

    stack LogicalPackageFunctionEffectRow work = graph.FunctionEffectRowAt(1);
    stack LogicalPackageFunctionEffectRow cPrintf = graph.FunctionEffectRowAt(2);
    stack LogicalPackageFunctionEffectFactTextRow workNameText =
        graph.TextRowAt(work.QualifiedResolvedNameTextRow());
    stack LogicalPackageFunctionEffectFactTextRow workBackendModeText =
        graph.TextRowAt(work.BackendOptimizationModeTextRow());
    stack LogicalPackageFunctionEffectFactTextRow cPrintfNameText =
        graph.TextRowAt(cPrintf.QualifiedResolvedNameTextRow());
    stack LogicalPackageFunctionEffectFactTextRow cPrintfKindText =
        graph.TextRowAt(cPrintf.KindTextRow());
    stack LogicalPackageFunctionEffectFactTextRow cPrintfInlineText =
        graph.TextRowAt(cPrintf.InlinePreferenceTextRow());
    stack LogicalPackageFunctionEffectFactTextRow cPrintfFfiAbiText =
        graph.TextRowAt(cPrintf.FfiAbiTextRow());
    stack mut OwnedAscii workName = new();
    stack mut OwnedAscii workBackendMode = new();
    stack mut OwnedAscii cPrintfName = new();
    stack mut OwnedAscii cPrintfKind = new();
    stack mut OwnedAscii cPrintfInline = new();
    stack mut OwnedAscii cPrintfFfiAbi = new();
    return graph.FunctionEffectRowCount() == 2
        && graph.TextRowCount() == 8
        && graph.TextByteCount() > 0
        && work.ModuleOrdinal() == 0
        && work.FunctionEffectOrdinal() == 0
        && work.ReadsArgumentMemory()
        && !work.IsPure()
        && work.NoSync()
        && work.NoFree()
        && work.NoUnwind()
        && work.WillReturn()
        && work.MustProgress()
        && work.UsesFastCallingConvention()
        && !work.IsFfi()
        && work.IsHot()
        && !work.IsCold()
        && !work.IsStrictFp()
        && !work.IsVarargs()
        && work.IsTailCallable()
        && !work.HasFfiAbi()
        && work.FfiAbiTextRow() == 0
        && work.HasBackendOptimizationMode()
        && work.NoRecurse()
        && cPrintf.ModuleOrdinal() == 0
        && cPrintf.FunctionEffectOrdinal() == 1
        && !cPrintf.ReadsArgumentMemory()
        && !cPrintf.IsPure()
        && !cPrintf.NoSync()
        && !cPrintf.NoFree()
        && cPrintf.NoUnwind()
        && !cPrintf.WillReturn()
        && !cPrintf.MustProgress()
        && !cPrintf.UsesFastCallingConvention()
        && cPrintf.IsFfi()
        && !cPrintf.IsHot()
        && cPrintf.IsCold()
        && cPrintf.IsStrictFp()
        && cPrintf.IsVarargs()
        && !cPrintf.IsTailCallable()
        && cPrintf.HasFfiAbi()
        && !cPrintf.HasBackendOptimizationMode()
        && cPrintf.BackendOptimizationModeTextRow() == 0
        && !cPrintf.NoRecurse()
        && workNameText.TextKind() == LogicalPackageFunctionEffectFactTextKind.QualifiedResolvedName
        && workBackendModeText.TextKind() == LogicalPackageFunctionEffectFactTextKind.BackendOptimizationMode
        && cPrintfNameText.TextKind() == LogicalPackageFunctionEffectFactTextKind.QualifiedResolvedName
        && cPrintfKindText.TextKind() == LogicalPackageFunctionEffectFactTextKind.Kind
        && cPrintfInlineText.TextKind() == LogicalPackageFunctionEffectFactTextKind.InlinePreference
        && cPrintfFfiAbiText.TextKind() == LogicalPackageFunctionEffectFactTextKind.FfiAbi
        && AppendLogicalPackageFunctionEffectFactText(graph, workNameText, workName) == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, workBackendModeText, workBackendMode)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, cPrintfNameText, cPrintfName)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, cPrintfKindText, cPrintfKind)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, cPrintfInlineText, cPrintfInline)
            == MemoryStatus.Ok
        && AppendLogicalPackageFunctionEffectFactText(graph, cPrintfFfiAbiText, cPrintfFfiAbi)
            == MemoryStatus.Ok
        && OwnedAsciiEqualsAscii(workName, "Demo.Work")
        && OwnedAsciiEqualsAscii(workBackendMode, "opaque")
        && OwnedAsciiEqualsAscii(cPrintfName, "Demo.CPrintf")
        && OwnedAsciiEqualsAscii(cPrintfKind, "fn")
        && OwnedAsciiEqualsAscii(cPrintfInline, "noinline")
        && OwnedAsciiEqualsAscii(cPrintfFfiAbi, "c");
}

[Fact]
fn bool LogicalPackageImageMaterializesAbiFunctionRows()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
