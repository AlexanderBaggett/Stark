[Fact]
fn bool CompilesReturnIfExpressionFromAst()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn pick(x) { return if x < 10 x else 10 } fn main() { return pick(3) }", s);
    stack mut OwnedAscii trailing = new();
    return ok
        && System.Text.Contains(s.View(), "define internal dso_local i64 @f1(i64 %p0)")
        && System.Text.Contains(s.View(), "br i1")
        && System.Text.Contains(s.View(), "label %b2, label %b3")
        && System.Text.Contains(s.View(), "ret i64 %p0")
        && System.Text.Contains(s.View(), "ret i64 %v")
        && ClangVerifiesLlvmText(s)
        && !CompileModuleFromAst("fn pick(x) { return if x < 10 x else 10 x } fn main() { return pick(3) }", trailing);
}

[Fact]
fn bool ReturnIfExpressionPreservesDeclaredI16ReturnType()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn i16[min max] pick(i64[min max] x) { return if x < 10 7 else 11 } fn main() { return 0 }", s);
    return ok
        && System.Text.Contains(s.View(), "define internal dso_local i16 @f1(i64 %p0)")
        && System.Text.Contains(s.View(), "add i16 0, 7")
        && System.Text.Contains(s.View(), "add i16 0, 11")
        && System.Text.Contains(s.View(), "ret i16")
        && !System.Text.Contains(s.View(), "add i64 0, 7")
        && !System.Text.Contains(s.View(), "add i64 0, 11")
        && !System.Text.Contains(s.View(), "ret i64 7")
        && !System.Text.Contains(s.View(), "ret i64 11")
        && ClangVerifiesLlvmText(s);
}

[Fact]
fn bool ReturnIfExpressionPreservesBranchRangeFacts()
{
    stack mut OwnedAscii s = new();
    stack bool ok = CompileModuleFromAst("fn i64[0 10] pick(i64[0 max] x) { return if x < 10 x else 10 } fn main() { return pick(3) }", s);
    stack mut OwnedAscii tooNarrow = new();
    return ok
        && System.Text.Contains(s.View(), "range(i64 0, 11)")
        && System.Text.Contains(s.View(), "br i1")
        && ClangVerifiesLlvmText(s)
        && !CompileModuleFromAst("fn i64[0 9] pick(i64[0 max] x) { return if x < 10 x else 10 } fn main() { return pick(3) }", tooNarrow);
}

