[Fact]
fn bool AstCallLoweringEmitsCallWithArgument()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] arg = MakeIntLit(nodes, 5);
    stack u32[0 max] call = MakeCall(nodes, 1, 1, arg, 0, 0, 0);
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId value = LowerExprNode(nodes, call, instrs);
    stack mut OwnedAscii disasm = new();
    stack MemoryStatus status = EmitMirInstructions(instrs, 1, (u32[0 max])instrs.Count(), disasm);
    return LlvmTextEquals(disasm, "v1 = const 5\nv2 = call f1(v1)\n");
}

fn bool BuildTypedLiteralInputsForSource(
    ascii source,
    out TokenStream stream,
    out DeclarationList declarations,
    out TypedLiteralExpressionTable literals)
{
    stream = new();
    declarations = new();
    literals = new();

    stack mut TokenStream parsedStream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            parsedStream = lexed;
    }

    stack mut DeclarationList parsedDeclarations = new();
    switch (ParseDeclarations(parsedStream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsed):
            parsedDeclarations = parsed;
    }

    switch (BuildTypedLiteralExpressions(source, parsedStream, parsedDeclarations))
    {
        case ParseResult<TypedLiteralExpressionTable>.Err(var literalError):
            return false;
        case ParseResult<TypedLiteralExpressionTable>.Ok(var builtLiterals):
            stream = parsedStream;
            declarations = parsedDeclarations;
            literals = builtLiterals;
            return true;
    }
}

fn bool TryFindTextLiteralRows(
    borrow TypedLiteralExpressionTable literals,
    out u32[0 max] stringRow,
    out u32[0 max] characterRow)
{
    stringRow = 0;
    characterRow = 0;

    stack u64[0 2 ** 63 - 1] count = literals.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (literals.TextLiteralKindAt(index) == TypedTextLiteralKind.String && stringRow == 0)
        {
            stringRow = (u32[0 max])(index + 1);
        }
        else if (literals.TextLiteralKindAt(index) == TypedTextLiteralKind.Character && characterRow == 0)
        {
            characterRow = (u32[0 max])(index + 1);
        }
    }

    return stringRow != 0 && characterRow != 0;
}

fn bool BuildTextLiteralModuleFactsForSource(
    ascii source,
    out TokenStream stream,
    out SourceModuleLoweringFacts moduleFacts)
{
    stream = new();
    moduleFacts = new();

    stack mut TokenStream parsedStream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedLiteralExpressionTable literals = new();
    if (!BuildTypedLiteralInputsForSource(source, parsedStream, declarations, literals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> literalRowsByToken = new();
    if (!BuildSourceTypedLiteralRowsByToken(parsedStream, literals, literalRowsByToken))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> textPayloadBytes = new();
    stack mut IrTable<MirTextConstant> textConstants = new();
    stack mut IrTable<u32[0 max]> textConstantRowsByLiteralRow = new();
    if (!BuildSourceTextLiteralConstantFacts(source, parsedStream, literals, textPayloadBytes, textConstants, textConstantRowsByLiteralRow))
    {
        return false;
    }

    stack mut SourceModuleLoweringFacts built = new();
    built.LiteralExpressions = literals;
    built.LiteralRowsByToken = literalRowsByToken;
    built.TextPayloadBytes = textPayloadBytes;
    built.TextConstants = textConstants;
    built.TextConstantRowsByLiteralRow = textConstantRowsByLiteralRow;
    stream = parsedStream;
    moduleFacts = built;
    return true;
}

fn bool BuildFloatLiteralModuleFactsForSource(
    ascii source,
    out TokenStream stream,
    out SourceModuleLoweringFacts moduleFacts)
{
    stream = new();
    moduleFacts = new();

    stack mut TokenStream parsedStream = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedLiteralExpressionTable literals = new();
