    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nfn i64[min max] Pick(i64[min max] x) { if x < 10 { return x < 5; } else { return x == 10; } }",
        instrs,
        blocks,
        funcs,
        asmMetadata);
    stack MirValueId thenReturn = MirBlockReturnValue(blocks, MirBlockIdOf(2));
    stack MirValueId elseReturn = MirBlockReturnValue(blocks, MirBlockIdOf(3));
