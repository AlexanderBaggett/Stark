fn bool CompileFunctionStackObjectDynamicFixedArrayElementAssignmentStoresThroughIndexedPointer()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm("struct Box { bool flag; i32[min max][3] values; } fn i32[min max] main(i64[0 2] index) { stack Box box = new Box(); box.values[index] = 19; return box.values[0] }", sink);
    return ok
        && System.Text.Contains(sink.View(), ".scale = mul i64 %p0, 4")
        && System.Text.Contains(sink.View(), ".offset = add i64")
