[Fact]
fn bool CompilesModuleWithCallFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAst("fn double(x) { return x + x } fn main() { return double(5) }", sink);
    stack mut OwnedAscii ghost = new();
    return ok
        && LlvmTextEquals(sink, "define internal dso_local i64 @f1(i64 %p0) {\nb1:\n  %v3 = add i64 %p0, %p0\n  ret i64 %v3\n}\ndefine internal dso_local i64 @f2() {\nb1:\n  %v1 = add i64 0, 5\n  %v2 = call i64 @f1(i64 range(i64 5, 6) %v1)\n  ret i64 %v2\n}\n")
        && !CompileModuleFromAst("fn main() { return ghost() }", ghost);
}

[Fact]
fn bool CompilesTailBecomeFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("tail fn done(x) { return x } tail fn bounce(x) { become done(x) } fn main() { return bounce(5) }", sink);
    stack mut OwnedAscii nonTailFunction = new();
    stack mut OwnedAscii nonTailTarget = new();
    stack mut OwnedAscii mismatchedAbi = new();
    return ok
        && LlvmTextEquals(sink, "define internal dso_local tailcc i64 @f1(i64 %p0) {\nb1:\n  ret i64 %p0\n}\ndefine internal dso_local tailcc i64 @f2(i64 %p0) {\nb1:\n  %v2 = musttail call tailcc i64 @f1(i64 %p0)\n  ret i64 %v2\n}\ndefine internal dso_local i64 @f3() {\nb1:\n  %v1 = add i64 0, 5\n  %v2 = call tailcc i64 @f2(i64 range(i64 5, 6) %v1)\n  ret i64 %v2\n}\n")
        && !CompileModuleFromAst("tail fn done(x) { return x } fn bad(x) { become done(x) }", nonTailFunction)
        && !CompileModuleFromAst("fn plain(x) { return x } tail fn bad(x) { become plain(x) }", nonTailTarget)
        && !CompileModuleFromAst("tail fn one(x) { return x } tail fn two(x, y) { become one(x) }", mismatchedAbi);
}

[Fact]
fn bool CompilesZeroArgumentTailBecomeFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("tail fn done() { return 7 } tail fn bounce() { become done() } fn main() { return bounce() }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local tailcc i64 @f1() {\nb1:\n  %v1 = add i64 0, 7\n  ret i64 %v1\n}\ndefine internal dso_local tailcc i64 @f2() {\nb1:\n  %v1 = musttail call tailcc i64 @f1()\n  ret i64 %v1\n}\ndefine internal dso_local i64 @f3() {\nb1:\n  %v1 = call tailcc i64 @f2()\n  ret i64 %v1\n}\n")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompilesThreeAndFourArgumentTailBecomeFromAst()
{
    stack mut OwnedAscii three = new();
    stack bool threeOk = CompileModuleFromAstChecked("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }", three);
    stack mut OwnedAscii four = new();
    stack bool fourOk = CompileModuleFromAstChecked("tail fn add4(a, b, c, d) { return a + b + c + d } tail fn bounce4(a, b, c, d) { become add4(a, b, c, d) } fn main() { return bounce4(1, 2, 3, 4) }", four);
    stack bool threeTail = System.Text.Contains(three.View(), "musttail call tailcc i64 @f1(i64 %p0, i64 %p1, i64 %p2)\n  ret i64");
    stack bool threeCall = System.Text.Contains(three.View(), "call tailcc i64 @f2(i64 range(i64 1, 2) %v1, i64 range(i64 2, 3) %v2, i64 range(i64 3, 4) %v3)");
    stack bool fourTail = System.Text.Contains(four.View(), "musttail call tailcc i64 @f1(i64 %p0, i64 %p1, i64 %p2, i64 %p3)\n  ret i64");
    stack bool fourCall = System.Text.Contains(four.View(), "call tailcc i64 @f2(i64 range(i64 1, 2) %v1, i64 range(i64 2, 3) %v2, i64 range(i64 3, 4) %v3, i64 range(i64 4, 5) %v4)");
    if (!threeOk)
    {
        WriteLine("threeOk false");
        if (ProgramSemanticallyValid("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }"))
        {
            WriteLine("three semantic true");
        }
        else
        {
            WriteLine("three semantic false");
        }

        if (!ProgramNamesResolve("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }"))
        {
            WriteLine("names false");
        }

        if (!ProgramCallAritiesMatch("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }"))
        {
            WriteLine("arity false");
        }

        if (!ProgramDeclarationsUnique("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }"))
        {
            WriteLine("decl unique false");
        }

        if (!ProgramFunctionNamesUnique("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }"))
        {
            WriteLine("function names false");
        }

        if (!ProgramWhileConditionsAreBoolean("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }"))
        {
            WriteLine("while conditions false");
        }

        if (!ProgramIfConditionsAreBoolean("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }"))
        {
            WriteLine("if conditions false");
        }

        if (!ProgramNoBooleanOperand("tail fn add3(a, b, c) { return a + b + c } tail fn bounce3(a, b, c) { become add3(a, b, c) } fn main() { return bounce3(1, 2, 3) }"))
        {
            WriteLine("boolean operand false");
        }

        return false;
    }

    if (!threeTail)
    {
        WriteLine("threeTail false");
        WriteLine(three);
        return false;
    }

    if (!threeCall)
    {
        WriteLine("threeCall false");
        WriteLine(three);
        return false;
    }

    WriteLine("before three clang");
    stack bool threeClang = ClangVerifiesLlvmText(three);
    WriteLine("after three clang");
    if (!threeClang)
    {
        WriteLine("threeClang false");
        WriteLine(three);
        return false;
    }

    if (!fourOk)
    {
        WriteLine("fourOk false");
        return false;
    }

    if (!fourTail)
    {
        WriteLine("fourTail false");
        WriteLine(four);
        return false;
    }

    if (!fourCall)
    {
        WriteLine("fourCall false");
        WriteLine(four);
        return false;
    }

    WriteLine("before four clang");
    stack bool fourClang = ClangVerifiesLlvmText(four);
    WriteLine("after four clang");
    if (!fourClang)
    {
        WriteLine("fourClang false");
        WriteLine(four);
        return false;
    }

    return true;
}

[Fact]
fn bool RejectsBecomeToUnsupportedBooleanRoot()
{
    stack mut OwnedAscii sink = new();
    return !CompileModuleFromAst("tail fn bad(a, b) { become a < b }", sink);
}

[Fact]
fn bool CompilesTailRecursiveBranchFromAst()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("tail fn count(n, acc) { if n == 0 return acc else become count(n - 1, acc + 1) } fn main() { return count(3, 0) }", sink);
    return ok
        && LlvmTextEquals(sink, "define internal dso_local tailcc i64 @f1(i64 %p0, i64 %p1) {\nb1:\n  %v2 = add i64 0, 0\n  %v3 = icmp eq i64 %p0, %v2\n  br i1 %v3, label %b2, label %b3\nb2:\n  ret i64 %p1\nb3:\n  %v6 = add i64 0, 1\n  %v7 = sub i64 %p0, %v6\n  %v9 = add i64 0, 1\n  %v10 = add i64 %p1, %v9\n  %v11 = musttail call tailcc i64 @f1(i64 %v7, i64 %v10)\n  ret i64 %v11\n}\ndefine internal dso_local i64 @f2() {\nb1:\n  %v1 = add i64 0, 3\n  %v2 = add i64 0, 0\n  %v3 = call tailcc i64 @f1(i64 range(i64 3, 4) %v1, i64 range(i64 0, 1) %v2)\n  ret i64 %v3\n}\n");
}

[Fact]
fn bool CompileFunctionArenaLocalLowersFrameAndAllocatorFacts()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm("struct Box { i32 value; bool flag; } fn i64 main() { arena Box box = new Box(); return 7 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "declare noalias nonnull noundef ptr @__stark_arena_alloc(ptr captures(none) %frame, i64 noundef %size, i64 noundef allocalign %alignment) allocsize(1) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_arena_alloc\" nounwind")
        && System.Text.Contains(sink.View(), "%__stark_arena_frame = alloca { ptr, ptr, ptr }, align 8")
        && System.Text.Contains(sink.View(), "call noalias nonnull noundef align 4 dereferenceable(8) ptr @__stark_arena_alloc(ptr nonnull %__stark_arena_frame, i64 noundef 8, i64 noundef 4)")
        && System.Text.Contains(sink.View(), "call void @__stark_arena_leave(ptr nonnull %__stark_arena_frame)\n  ret i64 %v3")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_alloc")
        && !System.Text.Contains(sink.View(), "@__stark_runtime_realloc")
        && !System.Text.Contains(sink.View(), "@__stark_heap_alloc")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileFunctionStackObjectNewLowersAllocaAndFacts()
{
    stack mut OwnedAscii explicitSink = new();
    stack bool explicitOk = CompileFunctionWithLocalsToLlvm("struct Box { i32 value; bool flag; } fn i64 main() { stack Box box = new Box(); return 7 }", explicitSink);
    stack mut OwnedAscii inferredSink = new();
    stack bool inferredOk = CompileFunctionWithLocalsToLlvm("struct Box { i32 value; bool flag; } fn i64 main() { stack Box box = new(); return 7 }", inferredSink);
    return explicitOk
        && inferredOk
        && System.Text.Contains(explicitSink.View(), "%v1 = alloca [8 x i8], align 4")
        && System.Text.Contains(inferredSink.View(), "%v1 = alloca [8 x i8], align 4")
        && !System.Text.Contains(explicitSink.View(), "@__stark_arena_alloc")
        && !System.Text.Contains(inferredSink.View(), "@__stark_arena_alloc")
        && ClangVerifiesLlvmText(explicitSink)
        && ClangVerifiesLlvmText(inferredSink);
}

[Fact]
fn bool CompileFunctionHeapObjectNewLowersAllocatorAndFacts()
{
    stack mut OwnedAscii explicitSink = new();
    stack bool explicitOk = CompileFunctionWithLocalsToLlvm("struct Box { i32 value; bool flag; } fn i64 main() { heap Box box = new Box(); return 7 }", explicitSink);
    stack mut OwnedAscii inferredSink = new();
    stack bool inferredOk = CompileFunctionWithLocalsToLlvm("struct Box { i32 value; bool flag; } fn i64 main() { heap Box box = new(); return 7 }", inferredSink);
    return explicitOk
        && inferredOk
        && System.Text.Contains(explicitSink.View(), "declare noalias nonnull noundef ptr @__stark_heap_alloc(i64 noundef %size, i64 noundef allocalign %alignment) allocsize(0) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_heap_alloc\" nounwind")
        && System.Text.Contains(explicitSink.View(), "%v1 = call noalias nonnull noundef align 4 dereferenceable(8) ptr @__stark_heap_alloc(i64 noundef 8, i64 noundef 4)")
        && System.Text.Contains(inferredSink.View(), "%v1 = call noalias nonnull noundef align 4 dereferenceable(8) ptr @__stark_heap_alloc(i64 noundef 8, i64 noundef 4)")
        && !System.Text.Contains(explicitSink.View(), "@__stark_arena_alloc")
        && !System.Text.Contains(inferredSink.View(), "@__stark_arena_alloc")
        && !System.Text.Contains(explicitSink.View(), "%__stark_arena_frame")
        && !System.Text.Contains(inferredSink.View(), "%__stark_arena_frame")
        && ClangVerifiesLlvmText(explicitSink)
        && ClangVerifiesLlvmText(inferredSink);
}

[Fact]
fn bool CompileFunctionStackObjectFieldInitializersStoreTypedFields()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm("struct Box { i32 value; bool flag; i64 tail; } fn i64 main() { var n = 5; stack Box box = new Box() { value = 3, flag = true, tail = n + 4 }; return 7 }", sink);
    return ok
        && System.Text.Contains(sink.View(), "%v1 = alloca [16 x i8], align 8")
        && System.Text.Contains(sink.View(), "getelementptr inbounds i8, ptr %v1, i64 0")
        && System.Text.Contains(sink.View(), "getelementptr inbounds i8, ptr %v1, i64 4")
        && System.Text.Contains(sink.View(), "getelementptr inbounds i8, ptr %v1, i64 8")
        && System.Text.Contains(sink.View(), "store i32")
        && System.Text.Contains(sink.View(), "store i1")
        && System.Text.Contains(sink.View(), "store i64")
        && System.Text.Contains(sink.View(), "align 4")
        && System.Text.Contains(sink.View(), "align 1")
        && System.Text.Contains(sink.View(), "align 8")
        && ClangVerifiesLlvmText(sink);
}

