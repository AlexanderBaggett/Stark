[Fact]
fn bool CompileFunctionRecursiveNestedMultiLocalIfStatementKeepsTypedPhis()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("fn i32[min max] main(bool outer, bool inner, bool deep) { var a = 0; var b = 0; if outer { if inner { if deep { a = 1; b = 2; } else { b = 4; a = 3; } } else { a = 5; b = 6; } } else { if inner { b = 8; a = 7; } else { if deep { a = 9; b = 10; } else { b = 12; a = 11; } } } return a + b }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define i32 @main(i1 %p0, i1 %p1, i1 %p2)")
        && System.Text.Contains(sink.View(), " phi i32 ")
        && !System.Text.Contains(sink.View(), " phi i64 ")
        && System.Text.Contains(sink.View(), "br i1")
        && ClangVerifiesLlvmText(sink);
}

