[Fact]
fn bool PackageTablesPreserveSourceReturnTryMirFacts()
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut AsmMetadataTable asmMetadata = new();
    stack bool ok = BuildModulePackageTablesWithAsm(
        "module Test\nenum Outcome { [Ok] Value(i32[0 max]), [Err] Failed(u8[0 max]) }\nenum Inner { [Ok] Value(Outcome), [Err] Failed(u8[0 max]) }\nfn Outcome Main() { return try Inner.Value(Outcome.Value(7)) }",
        instrs,
        blocks,
        funcs,
        asmMetadata);

    stack mut bool sawTagRead = false;
    stack mut bool sawCondition = false;
    stack mut bool sawSuccessEnumExtract = false;
    stack mut u32[0 max] successExtractIndex = 0;
    stack mut u64[0 2 ** 63 - 1] index = 1;
    while willexit (index <= instrs.Count())
    {
        stack MirValueId value = MirValueIdOf((u32[0 max])index);
        stack MirOp opcode = MirOpcodeOf(instrs, value);
        if (opcode == MirOp.EnumTagRead)
        {
            sawTagRead = true;
        }
        else if (opcode == MirOp.CmpEq)
        {
            sawCondition = true;
        }
        else if (opcode == MirOp.EnumPayloadExtract
            && MirValueType(instrs, value.Index()) == MirType.EnumValue
            && MirOperandCImmediateOf(instrs, value) == 0
            && MirOperandDImmediateOf(instrs, value) == 0)
        {
            sawSuccessEnumExtract = true;
            successExtractIndex = value.Index();
        }

        index = index + 1;
    }

    stack MirBlock entry = blocks.Get(1);
    stack MirBlock errorBlock = blocks.Get(2);
    stack MirBlock continueBlock = blocks.Get(3);
    stack MirBlock finalBlock = blocks.Get(4);
    return ok
        && funcs.Count() == 1
        && blocks.Count() == 4
        && entry.Terminator() == MirTermKind.CondBranch
        && errorBlock.Terminator() == MirTermKind.Return
        && continueBlock.Terminator() == MirTermKind.Branch
        && finalBlock.Terminator() == MirTermKind.Return
        && finalBlock.Slot0Index() == successExtractIndex
        && sawTagRead
        && sawCondition
        && sawSuccessEnumExtract;
}

[Fact]
fn bool SourceEnumExpressionLoweringEmitsEnumMirOps()
{
    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] taggedNode = MakeEnumVariant(nodes, TypeIdOf(7), 2);
    stack u32[0 max] payloadNode = MakeIntLit(nodes, 99);
    stack u32[0 max] insertedNode = MakeEnumPayloadInsert(nodes, TypeIdOf(7), 2, 0, taggedNode, payloadNode, SourceResolvedFieldTypeCodeI32());
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId inserted = LowerExprNode(nodes, insertedNode, instrs);
    return inserted.Equals(MirValueIdOf(3))
        && MirOpcodeOf(instrs, MirValueIdOf(1)) == MirOp.EnumVariantTag
        && MirOperandAImmediateOf(instrs, MirValueIdOf(1)) == 7
        && MirOperandBImmediateOf(instrs, MirValueIdOf(1)) == 2
        && MirOpcodeOf(instrs, MirValueIdOf(2)) == MirOp.ConstInt
        && MirValueType(instrs, 2) == MirType.I32
        && MirImmediateOf(instrs, MirValueIdOf(2)) == 99
        && MirOpcodeOf(instrs, inserted) == MirOp.EnumPayloadInsert
        && MirOperandAOf(instrs, inserted).Equals(MirValueIdOf(1))
        && MirOperandBOf(instrs, inserted).Equals(MirValueIdOf(2))
        && MirOperandCImmediateOf(instrs, inserted) == 7
        && MirOperandDImmediateOf(instrs, inserted) == 2
        && MirImmediateOf(instrs, inserted) == 0;
}

[Fact]
fn bool SourceEnumExpressionLoweringEmitsLlvmWithLayoutFacts()
{
    stack ascii source = raw"""
    enum Packet
    {
        Data(u8[0 max]),
        Empty,
        Other(u32[0 max])
    }
    """;

    stack mut TokenStream stream = new();
    stack mut IrTable<MirEnumLayoutFact> facts = new();
    if (!BuildMirEnumLayoutFactsForSource(source, stream, facts))
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack u32[0 max] taggedNode = MakeEnumVariant(nodes, TypeIdOf(1), 2);
    stack u32[0 max] payloadNode = MakeIntLit(nodes, 99);
    stack u32[0 max] insertedNode = MakeEnumPayloadInsert(nodes, TypeIdOf(1), 2, 0, taggedNode, payloadNode, SourceResolvedFieldTypeCodeI32());
    stack mut IrTable<MirInstruction> instrs = new();
    stack MirValueId inserted = LowerExprNode(nodes, insertedNode, instrs);
    stack mut OwnedAscii sink = new();
    switch (EmitLlvmInstructionWithEnumLayouts(instrs, facts, sink, 1))
    {
        case MemoryStatus.Err(var tagError):
            return false;
        case MemoryStatus.Ok:
    }

    switch (EmitLlvmInstructionWithEnumLayouts(instrs, facts, sink, 2))
    {
        case MemoryStatus.Err(var payloadError):
            return false;
        case MemoryStatus.Ok:
    }

    switch (EmitLlvmInstructionWithEnumLayouts(instrs, facts, sink, inserted.Index()))
    {
        case MemoryStatus.Err(var insertError):
            return false;
        case MemoryStatus.Ok:
    }

    return inserted.Equals(MirValueIdOf(3))
        && LlvmTextEquals(
            sink,
            "  %v1 = insertvalue { i8, i8, [2 x i8], i32 } zeroinitializer, i8 2, 0\n  %v2 = add i32 0, 99\n  %v3 = insertvalue { i8, i8, [2 x i8], i32 } %v1, i32 %v2, 3\n");
}

[Fact]
fn bool SourceModuleLowersUnitEnumConstructorLocalToLlvm()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm(
        "enum Packet { Empty, Other(u32[0 max]) } fn i64 main() { var p = Packet.Empty; return 7 }",
        sink);
    return ok
        && System.Text.Contains(sink.View(), "insertvalue {")
        && System.Text.Contains(sink.View(), "zeroinitializer, i8 0, 0")
        && System.Text.Contains(sink.View(), "ret i64");
}

[Fact]
fn bool SourceModuleLowersPayloadEnumConstructorLocalToLlvm()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm(
        "enum Packet { Empty, Other(u32[0 max]) } fn i64 main() { var p = Packet.Other(99); return 7 }",
        sink);
    return ok
        && System.Text.Contains(sink.View(), "insertvalue {")
        && System.Text.Contains(sink.View(), "zeroinitializer, i8 1, 0")
        && System.Text.Contains(sink.View(), "add i32 0, 99")
        && System.Text.Contains(sink.View(), " i32 %v");
}

[Fact]
fn bool SourceModuleLowersNamedPayloadEnumConstructorLocalToLlvm()
{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileFunctionWithLocalsToLlvm(
        "enum Packet { Empty, Move { X: u32[0 max], Flag: bool } } fn i64 main() { var p = Packet.Move { Flag: true, X: 99 }; return 7 }",
        sink);
    return ok
        && System.Text.Contains(sink.View(), "insertvalue {")
        && System.Text.Contains(sink.View(), "zeroinitializer, i8 1, 0")
        && System.Text.Contains(sink.View(), "add i32 0, 99")
        && System.Text.Contains(sink.View(), "add i1 0, 1")
        && System.Text.Contains(sink.View(), " i1 %v")
        && System.Text.Contains(sink.View(), "ret i64");
}

