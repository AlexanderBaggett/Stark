{
    stack mut OwnedAscii sink = new();
    stack bool ok = CompileModuleFromAstChecked("fn i32[min max] read(i32[min max][] view, i64[0 max] index) { return view[index] } fn i32[min max] main(i64[0 2] index) { stack i32[min max][3] values = { 1, 2, 3 }; stack i32[min max][] view = values; return read(view, index) }", sink);
    return ok
        && System.Text.Contains(sink.View(), "define internal dso_local i32 @f1({ ptr, i64 } %p0, i64")
        && System.Text.Contains(sink.View(), "insertvalue { ptr, i64 } poison, ptr")
        && System.Text.Contains(sink.View(), "insertvalue { ptr, i64 } %v")
