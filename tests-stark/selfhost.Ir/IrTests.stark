    return ok
        && System.Text.Contains(sink.View(), "define internal dso_local tailcc i64 @f1(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1)")
        && System.Text.Contains(sink.View(), "%v3 = musttail call tailcc i64 @f1(ptr captures(none) readonly %p0, ptr captures(none) readonly %p1)")
        && System.Text.Contains(sink.View(), "call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p0, ptr %p1)]\n  %v3 = musttail")
        && ClangVerifiesLlvmText(sink);
}

[Fact]
fn bool CompileModulePointerCallArgumentsRequireCallerAliasProof()
{
    stack mut OwnedAscii overlapped = new();
    stack mut OwnedAscii repeated = new();
    stack mut OwnedAscii calleeOverlap = new();
    return !CompileModuleFromAst("fn i64 touch(borrow i32 left, borrow i32 right) { return 1 } fn i64 main(borrow i32 left, borrow i32 right) where overlap(left, right) { return touch(left, right) }", overlapped)
        && !CompileModuleFromAst("fn i64 touch(borrow i32 left, borrow i32 right) { return 1 } fn i64 main(borrow i32 left) { return touch(left, left) }", repeated)
        && CompileModuleFromAst("fn i64 touch(borrow i32 left, borrow i32 right) where overlap(left, right) { return 1 } fn i64 main(borrow i32 left, borrow i32 right) where overlap(left, right) { return touch(left, right) }", calleeOverlap);
}

