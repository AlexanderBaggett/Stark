import Compiler.Ir
import Compiler.Mir
import System.Memory
import System.Text
module ImportedTemplateOperatorTests

public fn bool ImportedTemplateIntegerOperatorsFoldDirectlyWithExactLlvmFacts()
{
    stack ascii manifestJson = raw"""
        {
          "Modules": [
            {
              "ModuleName": "Demo",
              "ReExports": [],
              "Functions": [],
              "Types": [],
              "Globals": [],
              "CompilerSections": {
                "GenericTemplates": {
                  "Functions": [
                    {
                      "QualifiedResolvedName": "Demo.IntegerOperators#0",
                      "QualifiedName": "Demo.IntegerOperators",
                      "OverloadKey": "()",
                      "TopLevelStatementCount": 9,
                      "Conversions": [
                        {
                          "Ordinal": 0,
                          "TargetType": { "Kind": "integer", "BitWidth": 8 }
                        }
                      ],
                      "TypedBody": {
                        "Statements": [
                          {
