[Fact]
fn bool InlineTablesParse()
{
    unsafe
    {
        switch (ParseText(raw"""
[dependencies]
raylib = { path = "../raylib" }
empty = {}
"""))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] dependencies = 0;
                if (!document.TryFindMemberOfKind(TomlRootNode, "dependencies", TomlKind.Table, dependencies))
                {
                    return false;
                }

                stack mut u64[0 2 ** 63 - 1] raylib = 0;
                if (!document.TryFindMemberOfKind(dependencies, "raylib", TomlKind.Table, raylib))
                {
                    return false;
                }

                stack mut u64[0 2 ** 63 - 1] path = 0;
                if (!document.TryFindMember(raylib, "path", path))
                {
                    return false;
                }

                stack mut u64[0 2 ** 63 - 1] empty = 0;
                if (!document.TryFindMemberOfKind(dependencies, "empty", TomlKind.Table, empty))
