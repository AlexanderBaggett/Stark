[Fact]
fn bool ArraysParseInOrder()
{
    unsafe
    {
        switch (ParseText(raw"""
members = [
  "stdlib",
  "examples/raylib",
  "examples/breakout",
]
"""))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] members = 0;
                if (!document.TryFindMemberOfKind(TomlRootNode, "members", TomlKind.Array, members))
                {
                    return false;
                }

                if (document.ChildCountAt(members) != 3)
                {
                    return false;
                }

                stack mut u64[0 2 ** 63 - 1] first = 0;
                if (!document.TryChildAt(members, 0, first))
                {
                    return false;
                }

                stack mut u64[0 2 ** 63 - 1] last = 0;
                if (!document.TryChildAt(members, 2, last))
                {
                    return false;
                }

                return document.TextAt(first) == "stdlib"
                    && document.TextAt(last) == "examples/breakout";
        }
    }
}

