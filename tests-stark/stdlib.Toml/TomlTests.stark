}

[Fact]
fn bool ArraysOfTablesAreUnsupportedForNow()
{
    unsafe
    {
        switch (ParseText(raw"""
[[bin]]
name = "tool"
"""))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return IsUnsupportedValue(error);
