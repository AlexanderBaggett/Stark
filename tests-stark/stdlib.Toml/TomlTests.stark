[Fact]
fn bool MultilineBasicStringTrimsLeadingNewlineEscapesAndContinues()
{
    // Built as an escaped ascii literal (not a raw string) so the `"""`
    // delimiters do not collide with the test file's own raw-string syntax.
    //   key = """<newline>The quick brown \<newline>   fox\tjumps."""<newline>
    // Expected decoding:
    //   - the leading newline after the opening `"""` is trimmed;
    //   - the trailing `\` is a line continuation: it trims the backslash, the
    //     newline, and the next line's leading whitespace, so `brown ` joins
    //     `fox` with the single source space preserved;
    //   - `\t` decodes to a real tab.
    unsafe
    {
        switch (ParseText("key = \"\"\"\nThe quick brown \\\n   fox\\tjumps.\"\"\"\n"))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] key = 0;
                if (!document.TryFindMember(TomlRootNode, "key", key))
                {
                    return false;
                }

                return document.KindAt(key) == TomlKind.Text
                    && document.TextAt(key) == "The quick brown fox\tjumps.";
        }
    }
}

[Fact]
fn bool MultilineBasicStringAllowsEmbeddedQuotes()
{
    // Two embedded quotation marks (`""`) are valid content; the closing `"""`
    // still terminates the string.
    //   key = """Here are two quotes: "". Done."""
    unsafe
    {
        switch (ParseText("key = \"\"\"Here are two quotes: \"\". Done.\"\"\"\n"))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] key = 0;
                if (!document.TryFindMember(TomlRootNode, "key", key))
                {
                    return false;
                }

                return document.TextAt(key) == "Here are two quotes: \"\". Done.";
        }
    }
}

[Fact]
fn bool MultilineBasicStringKeepsLiteralNewlines()
{
    // Without a line continuation, literal newlines inside the body are kept
    // verbatim. The leading newline after `"""` is still trimmed.
    //   key = """first<newline>second"""
    unsafe
    {
        switch (ParseText("key = \"\"\"first\nsecond\"\"\"\n"))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] key = 0;
                if (!document.TryFindMember(TomlRootNode, "key", key))
                {
                    return false;
                }

                return document.TextAt(key) == "first\nsecond";
        }
    }
}

[Fact]
fn bool MultilineLiteralStringIsVerbatim()
{
    // Multiline literal strings apply no escapes and no line continuation; the
    // leading newline after `'''` is trimmed and everything else is verbatim.
    //   path = '''<newline>C:\Users\nodejs\templates'''
    unsafe
    {
        switch (ParseText("path = '''\nC:\\Users\\nodejs\\templates'''\n"))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] path = 0;
                if (!document.TryFindMember(TomlRootNode, "path", path))
                {
                    return false;
                }

                return document.KindAt(path) == TomlKind.Text
                    && document.TextAt(path) == "C:\\Users\\nodejs\\templates";
        }
    }
}

[Fact]
fn bool MultilineLiteralStringKeepsNewlinesAndBackslashTrailing()
{
    // A backslash at the end of a line in a literal string is NOT a line
    // continuation; it and the newline are kept verbatim.
    //   key = '''a\<newline>b'''
    unsafe
    {
        switch (ParseText("key = '''a\\\nb'''\n"))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] key = 0;
                if (!document.TryFindMember(TomlRootNode, "key", key))
                {
                    return false;
                }

                return document.TextAt(key) == "a\\\nb";
        }
    }
}

[Fact]
fn bool UnterminatedMultilineBasicStringIsRejected()
{
    // An opening `"""` with no closing delimiter is an unterminated string.
    unsafe
    {
        switch (ParseText("key = \"\"\"no closing here\n"))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return IsUnterminatedString(error);
            case TomlResult<TomlDocument>.Ok(var value):
                return false;
        }
    }
}

[Fact]
fn bool MultilineBasicStringRoundTripsThroughEmitter()
{
    // A multiline basic string decodes to the same bytes as the equivalent
    // single-line basic string, so the canonical emitter (which always writes
    // single-line basic strings) re-emits it identically to the single-line
    // form. This confirms multiline `Text` nodes round-trip.
    return EmitMatches(
        "key = \"\"\"first\nsecond\"\"\"\n",
        "key = \"first\\nsecond\"\n");
}

[Fact]
fn bool UnderscoredIntegersNormalize()
{
    unsafe
    {
        switch (ParseText(raw"""
big = 1_000_000
negative = -42
"""))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] big = 0;
                if (!document.TryFindMember(TomlRootNode, "big", big))
                {
                    return false;
                }

                stack mut u64[0 2 ** 63 - 1] negative = 0;
                if (!document.TryFindMember(TomlRootNode, "negative", negative))
                {
                    return false;
                }

                stack mut i64[min max] bigValue = 0;
                switch (document.I64At(big))
                {
                    case TomlResult<i64[min max]>.Err(var bigError):
                        return false;
                    case TomlResult<i64[min max]>.Ok(var parsedBig):
                        bigValue = parsedBig;
                }

                stack mut i64[min max] negativeValue = 0;
                switch (document.I64At(negative))
                {
                    case TomlResult<i64[min max]>.Err(var negativeError):
                        return false;
                    case TomlResult<i64[min max]>.Ok(var parsedNegative):
                        negativeValue = parsedNegative;
                }

                return bigValue == 1000000 && negativeValue == -42;
        }
    }
}

