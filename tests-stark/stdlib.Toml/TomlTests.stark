// F64At returns a scalar f64, so these read the value and compare it with a
// Stark f64 literal. The parsed token and the literal go through the same
// correctly-rounded text->f64 conversion, so `==` is a bit-exact check inside
// the supported window (significand <= 2**53, |exp10| <= 22).
fn bool MemberF64Equals(mut borrow TomlDocument document, ascii key, f64 expected)
{
    stack mut u64[0 2 ** 63 - 1] node = 0;
    if (!document.TryFindMember(TomlRootNode, key, node))
    {
        return false;
    }

    switch (document.F64At(node))
    {
        case TomlResult<f64>.Err(var error):
            return false;
        case TomlResult<f64>.Ok(var value):
            return value == expected;
    }
}

[Fact]
fn bool FloatsParseToExactValues()
{
    unsafe
    {
        switch (ParseText(raw"""
half = 1.5
pi = 3.14
negzero = -0.0
tenth = 0.1
thousand = 1e3
fractional = 1234.5
underscored = 9_224.0
"""))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] half = 0;
                if (!document.TryFindMember(TomlRootNode, "half", half))
                {
                    return false;
                }

                if (document.KindAt(half) != TomlKind.Float)
                {
                    return false;
                }

                return MemberF64Equals(document, "half", 1.5)
                    && MemberF64Equals(document, "pi", 3.14)
                    && MemberF64Equals(document, "negzero", -0.0)
                    && MemberF64Equals(document, "tenth", 0.1)
                    && MemberF64Equals(document, "thousand", 1000.0)
                    && MemberF64Equals(document, "fractional", 1234.5)
                    && MemberF64Equals(document, "underscored", 9224.0);
        }
    }
}

[Fact]
fn bool FloatOutsideExactWindowReportsInvalidNumber()
{
    // |exp10| > 22 is outside the correctly-rounded window: F64At must report
    // InvalidNumber rather than mis-round the value.
    unsafe
    {
        switch (ParseText(raw"""
tiny = 1e40
"""))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] tiny = 0;
                if (!document.TryFindMember(TomlRootNode, "tiny", tiny))
                {
                    return false;
                }

                switch (document.F64At(tiny))
                {
                    case TomlResult<f64>.Err(var error):
                        return IsInvalidNumber(error);
                    case TomlResult<f64>.Ok(var parsedValue):
                        return false;
                }
        }
    }
}

[Fact]
fn bool PrefixedIntegersDecodeByRadix()
{
    unsafe
    {
        switch (ParseText(raw"""
hex = 0xDEAD
upperhex = 0XdeAd
octal = 0o755
binary = 0b1010
"""))
        {
            case TomlResult<TomlDocument>.Err(var error):
                return false;
            case TomlResult<TomlDocument>.Ok(var value):
                stack mut TomlDocument document = value;
                stack mut u64[0 2 ** 63 - 1] hex = 0;
                if (!document.TryFindMember(TomlRootNode, "hex", hex))
                {
                    return false;
                }

                stack mut u64[0 2 ** 63 - 1] upperhex = 0;
                if (!document.TryFindMember(TomlRootNode, "upperhex", upperhex))
                {
                    return false;
                }

                stack mut u64[0 2 ** 63 - 1] octal = 0;
                if (!document.TryFindMember(TomlRootNode, "octal", octal))
                {
                    return false;
                }

                stack mut u64[0 2 ** 63 - 1] binary = 0;
                if (!document.TryFindMember(TomlRootNode, "binary", binary))
                {
                    return false;
                }

                stack mut i64[min max] hexValue = 0;
                switch (document.I64At(hex))
                {
                    case TomlResult<i64[min max]>.Err(var hexError):
                        return false;
                    case TomlResult<i64[min max]>.Ok(var parsedHex):
                        hexValue = parsedHex;
                }

                stack mut i64[min max] upperhexValue = 0;
                switch (document.I64At(upperhex))
                {
                    case TomlResult<i64[min max]>.Err(var upperhexError):
                        return false;
                    case TomlResult<i64[min max]>.Ok(var parsedUpperhex):
                        upperhexValue = parsedUpperhex;
                }

                stack mut i64[min max] octalValue = 0;
                switch (document.I64At(octal))
                {
                    case TomlResult<i64[min max]>.Err(var octalError):
                        return false;
                    case TomlResult<i64[min max]>.Ok(var parsedOctal):
                        octalValue = parsedOctal;
                }

                stack mut i64[min max] binaryValue = 0;
                switch (document.I64At(binary))
                {
                    case TomlResult<i64[min max]>.Err(var binaryError):
                        return false;
                    case TomlResult<i64[min max]>.Ok(var parsedBinary):
                        binaryValue = parsedBinary;
                }

                return hexValue == 57005
                    && upperhexValue == 57005
                    && octalValue == 493
                    && binaryValue == 10;
        }
    }
}

[Fact]
fn bool UnderscoredPrefixedIntegersNormalize()
{
    unsafe
    {
        switch (ParseText(raw"""
hex = 0xDE_AD
binary = 0b1010_0101
"""))
