import LlvmTestSupport
import System.Testing
module CommentTriviaTestsP1

// Ported from CommentTriviaTests.LineBlockAndXmlCommentsAreIgnoredBeforeLowering.
public unsafe fn bool LineBlockAndXmlCommentsAreIgnoredBeforeLoweringImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "comment-trivia-ignored-before-lowering",
        raw"""
module Demo

//stuff.
// fn u32[0 2 ** 31 - 1] CommentedOutLine()
// {
//     return 11;
// }

/*
fn u32[0 2 ** 31 - 1] CommentedOutBlock()
{
    return 22;
}
*/

/// <summary>
/// fn u32[0 2 ** 31 - 1] CommentedOutXmlLine()
/// {
///     return 33;
/// }
/// </summary>
/**
 * <summary>
 * fn u32[0 2 ** 31 - 1] CommentedOutXmlBlock()
 * {
 *     return 44;
 * }
 * </summary>
 */
finite law u32[0 2 ** 31 - 1] Run()
{
    // stack u32[0 2 ** 31 - 1] commentedLocal = 55;
    /*
    stack u32[0 2 ** 31 - 1] commentedBlockLocal = 66;
    return commentedBlockLocal;
    */
    return 7;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc")
        && Contains(llvm, "@Run(")
        && Contains(llvm, "ret i32 7")
        && DoesNotContain(llvm, "CommentedOut")
        && DoesNotContain(llvm, "commentedLocal");
}
