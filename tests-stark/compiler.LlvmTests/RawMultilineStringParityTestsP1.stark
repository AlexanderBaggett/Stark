import LlvmTestSupport
import System.Testing
module RawMultilineStringParityTestsP1

// Ported from RawMultilineStringParityTests.MultilineRawStringsStripDelimiterNewlinesAndClosingIndentation.
public unsafe fn bool MultilineRawStringsStripDelimiterNewlinesAndClosingIndentationImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "raw-multiline-strip-delimiter-newlines",
        raw"""
module Demo

unsafe fn ascii Value()
{
    return raw"""
        first
          indented
        second
        """;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "c\"first\\0A  indented\\0Asecond\\00\"");
}

// Ported from RawMultilineStringParityTests.WhitespaceOnlyLinesShorterThanTheClosingIndentationBecomeEmptyLines.
public unsafe fn bool WhitespaceOnlyLinesShorterThanTheClosingIndentationBecomeEmptyLinesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "raw-multiline-whitespace-only-lines",
        raw"""
module Demo

unsafe fn ascii Value()
{
    return raw"""
        first

        second
        """;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "c\"first\\0A\\0Asecond\\00\"");
}

// Ported from RawMultilineStringParityTests.SingleLineRawTripleQuoteStringsKeepTheirContentVerbatim.
public unsafe fn bool SingleLineRawTripleQuoteStringsKeepTheirContentVerbatimImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "raw-single-line-triple-quote-verbatim",
        raw"""
module Demo

unsafe fn ascii Value()
{
    return raw"""quote " and \d inside""";
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "c\"quote \\22 and \\5Cd inside\\00\"");
}

// Ported from RawMultilineStringParityTests.InterpolatedRawMultilineStringsNormalizeBeforeHoleSplitting.
public unsafe fn bool InterpolatedRawMultilineStringsNormalizeBeforeHoleSplittingImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "raw-multiline-interpolated-normalize",
        raw"""
module Demo

unsafe fn ascii Value()
{
    return $raw"""
        Score: {100}
        next \d
        """;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "c\"Score: 100\\0Anext \\5Cd\\00\"");
}
