import LlvmTestSupport
import System.Testing
module LlvmIrEmissionTestsP7

// Ported from LlvmIrEmissionTests.ScalarizableEnumOrderedComparisonsEmitScalarLeafLexicographicHelperCalls.
public unsafe fn bool ScalarizableEnumOrderedComparisonsEmitScalarLeafLexicographicHelperCallsImpl()
{
    // PORT-NOTE: the C# oracle uses CountOccurrences(>= 1) for the i32 leaf
    // compares; the host bridge exposes only substring presence, so the count
    // assertions are reduced to plain Contains checks.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-scalarizable-enum-ordered-comparisons",
        raw"""
module Demo

enum Token
{
    None,
    Many(i32[min max], i32[min max], i32[min max], i32[min max], i32[min max]),
}

unsafe fn bool Less(Token left, Token right)
{
    return left < right;
}

unsafe fn bool LessOrEqual(Token left, Token right)
{
    return left <= right;
}

unsafe fn bool Greater(Token left, Token right)
{
    return left > right;
}

unsafe fn bool GreaterOrEqual(Token left, Token right)
{
    return left >= right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define internal dso_local i32 @__stark_named_compare_")
        && Contains(llvm, "call i32 @__stark_named_compare_")
        && Contains(llvm, "icmp slt i8")
        && Contains(llvm, "icmp sgt i8")
        && Contains(llvm, "icmp slt i32")
        && Contains(llvm, "icmp sgt i32")
        && Contains(llvm, "icmp sle i32")
        && Contains(llvm, "icmp sge i32")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Less")
        && DoesNotContain(llvm, "; LLVM body emission fallback for LessOrEqual")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Greater")
        && DoesNotContain(llvm, "; LLVM body emission fallback for GreaterOrEqual");
}

// Ported from LlvmIrEmissionTests.LargerFixedArrayEqualityAndInequalityEmitScalarLeafComparisons.
public unsafe fn bool LargerFixedArrayEqualityAndInequalityEmitScalarLeafComparisonsImpl()
{
    // PORT-NOTE: the C# oracle counts exactly one Equal/NotEqual definition and
    // requires >= 5 leaf compares plus >= 4 and/or combinators; the host bridge
    // exposes only substring presence, so the count assertions are reduced to
    // Contains checks.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-larger-fixed-array-equality",
        raw"""
module Demo

unsafe fn bool Equal(i32[min max][5] left, i32[min max][5] right)
{
    return left == right;
}

unsafe fn bool NotEqual(i32[min max][5] left, i32[min max][5] right)
{
    return left != right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i1 @Equal(")
        && Contains(llvm, "define fastcc i1 @NotEqual(")
        && Contains(llvm, "icmp eq i32")
        && Contains(llvm, "icmp ne i32")
        && Contains(llvm, "and i1")
        && Contains(llvm, "or i1")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Equal")
        && DoesNotContain(llvm, "; LLVM body emission fallback for NotEqual");
}

// Ported from LlvmIrEmissionTests.LargerEnumEqualityAndInequalityEmitScalarLeafComparisons.
public unsafe fn bool LargerEnumEqualityAndInequalityEmitScalarLeafComparisonsImpl()
{
    // PORT-NOTE: the C# oracle counts exactly one Equal/NotEqual definition and
    // requires >= 5 leaf compares plus >= 5 and/or combinators; reduced to
    // substring presence because the host bridge exposes no occurrence counter.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-larger-enum-equality",
        raw"""
module Demo

enum Token
{
    None,
    Many(i32[min max], i32[min max], i32[min max], i32[min max], i32[min max]),
}

unsafe fn bool Equal(Token left, Token right)
{
    return left == right;
}

unsafe fn bool NotEqual(Token left, Token right)
{
    return left != right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i1 @Equal(")
        && Contains(llvm, "define fastcc i1 @NotEqual(")
        && Contains(llvm, "icmp eq i8")
        && Contains(llvm, "icmp ne i8")
        && Contains(llvm, "icmp eq i32")
        && Contains(llvm, "icmp ne i32")
        && Contains(llvm, "and i1")
        && Contains(llvm, "or i1")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Equal")
        && DoesNotContain(llvm, "; LLVM body emission fallback for NotEqual");
}

// Ported from LlvmIrEmissionTests.TextEqualityAndInequalityEmitHelperCalls.
public unsafe fn bool TextEqualityAndInequalityEmitHelperCallsImpl()
{
    // PORT-NOTE: the C# oracle extracts the helper definition headers via
    // ExtractDefinitionHeader and asserts the header substrings within that
    // slice; the host bridge exposes only the whole-module text, so the header
    // substring checks are applied to the full LLVM output instead.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-text-equality-inequality",
        raw"""
module Demo

unsafe fn bool SameAscii(ascii left, ascii right)
{
    return left == right;
}

unsafe fn bool DifferentUnicode(unicode left, unicode right)
{
    return left != right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define internal dso_local i1 @__stark_ascii_equal(%stark_ascii %left, %stark_ascii %right)")
        && Contains(llvm, "define internal dso_local i1 @__stark_unicode_equal(%stark_unicode %left, %stark_unicode %right)")
        && Contains(llvm, "unnamed_addr")
        && Contains(llvm, "call i1 @__stark_ascii_equal(%stark_ascii %arg_left, %stark_ascii %arg_right)")
        && Contains(llvm, "call i1 @__stark_unicode_equal(%stark_unicode %arg_left, %stark_unicode %arg_right)")
        && Contains(llvm, "getelementptr inbounds nuw i8, ptr %left_data, i64 %textcmp_index")
        && Contains(llvm, "getelementptr inbounds nuw i32, ptr %left_data, i64 %textcmp_index")
        && Contains(llvm, "xor i1")
        && DoesNotContain(llvm, "; LLVM body emission fallback for SameAscii")
        && DoesNotContain(llvm, "; LLVM body emission fallback for DifferentUnicode");
}

