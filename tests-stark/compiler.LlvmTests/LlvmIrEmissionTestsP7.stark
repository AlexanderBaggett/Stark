// Ported from LlvmIrEmissionTests.PrimaryRecordConstructorArgumentsEmitOrderedAggregateUpdates.
public unsafe fn bool PrimaryRecordConstructorArgumentsEmitOrderedAggregateUpdatesImpl()
{
    // PORT-NOTE: the C# oracle requires >= 2 `insertvalue %Point` updates; the
    // host bridge exposes no occurrence counter, so that is reduced to substring
    // presence.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-primary-record-ordered-updates",
        raw"""
module Demo

record Point(i32[min max] X)
{
    i32[min max] Y;
}

unsafe fn Point Make()
{
    return new Point(3)
    {
        Y = 9
    };
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%Point = type { i32, i32 }")
        && Contains(llvm, "insertvalue %Point")
        && Contains(llvm, "ret %Point")
        && DoesNotContain(llvm, "declare fastcc %Point @Make()");
}

// Ported from LlvmIrEmissionTests.InternalAggregateParameterUsesDirectValueAbi.
public unsafe fn bool InternalAggregateParameterUsesDirectValueAbiImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-internal-aggregate-param-direct-abi",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Read(Box box)
{
    stack i32[min max] a = box.Value + (box.Value / 3);
    stack i32[min max] b = a - (a / 5);
    stack i32[min max] c = b + (b / 7);
    stack i32[min max] d = c - (c / 11);
    stack i32[min max] e = d + (d / 13);
    stack i32[min max] f = e - (e / 17);
    stack i32[min max] g = f + (f / 19);
    stack i32[min max] h = g - (g / 23);
    stack i32[min max] i = h + (h / 29);
    stack i32[min max] j = i - (i / 31);
    stack i32[min max] k = j + (j / 37);
    stack i32[min max] l = k - (k / 41);
    stack i32[min max] m = l + (l / 43);
    return m;
}

unsafe fn i32[min max] Run()
{
    return Read(new Box()
    {
        Value = 7
    });
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i32 @Read(%Box %arg_box)")
        && Contains(llvm, "extractvalue %Box %arg_box, 0")
        && Contains(llvm, "call fastcc i32 @Read(%Box")
        && DoesNotContain(llvm, "load %Box, ptr %arg_box");
}

// Ported from LlvmIrEmissionTests.BorrowedPaddedAggregateEmitsDerivedAlignmentAndLayoutFacts.
