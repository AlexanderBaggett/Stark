// Ported from LlvmIrEmissionTests.SliceEqualityAndInequalityEmitPointerAndLengthComparisons.
public unsafe fn bool SliceEqualityAndInequalityEmitPointerAndLengthComparisonsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-slice-equality-inequality",
        raw"""
module Demo

unsafe fn bool Same(i32[min max][] left, i32[min max][] right)
{
    return left == right;
}

unsafe fn bool Different(i32[min max][] left, i32[min max][] right)
{
    return left != right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i1 @Same({ ptr, i64 } %arg_left, { ptr, i64 } %arg_right)")
        && Contains(llvm, "define fastcc i1 @Different({ ptr, i64 } %arg_left, { ptr, i64 } %arg_right)")
        && Contains(llvm, "extractvalue { ptr, i64 } %arg_left, 0")
        && Contains(llvm, "extractvalue { ptr, i64 } %arg_right, 1")
        && Contains(llvm, "icmp eq ptr")
        && Contains(llvm, "icmp eq i64")
        && Contains(llvm, "icmp ne ptr")
        && Contains(llvm, "icmp ne i64")
        && Contains(llvm, "and i1")
        && Contains(llvm, "or i1")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Same")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Different");
}

