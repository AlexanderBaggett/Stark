module Demo

unsafe fn i32[min max] Run(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    stack u64[min max] bits = (u64[min max])left;
    stack rawmutptr<i32[min max]> hidden = (rawmutptr<i32[min max]>)bits;
    *hidden = 7;
    return *right;
}
""");
    if (!Succeeds(c))
