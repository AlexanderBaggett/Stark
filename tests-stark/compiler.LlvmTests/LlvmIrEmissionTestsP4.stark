        return false;
    }

    stack ascii llvm = Llvm(c);
    return DoesNotContain(llvm, "!alias.scope")
        && DoesNotContain(llvm, "!noalias")
        && DoesNotContain(llvm, "!\"stark.noalias.Run");
}

