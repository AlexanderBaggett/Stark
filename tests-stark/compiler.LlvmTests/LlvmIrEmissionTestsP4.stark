        "p4-ascii-to-unicode-const",
        raw"""
module Demo

unsafe fn unicode Run()
{
    return (unicode)"Hello";
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc %stark_unicode @Run()")
        && Contains(llvm, "ret %stark_unicode { ptr getelementptr inbounds nuw ([6 x i32], ptr @.str.")
        && DoesNotContain(llvm, "Unsupported SSA conversion from 'ascii' to 'unicode'")
        && DoesNotContain(llvm, "declare fastcc %stark_unicode @Run()");
}

