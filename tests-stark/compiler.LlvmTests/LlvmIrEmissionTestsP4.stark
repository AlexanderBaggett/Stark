// Ported from LlvmIrEmissionTests.UnsignedIntegerOperationsUseUnsignedLlvmOpcodes.
public unsafe fn bool UnsignedIntegerOperationsUseUnsignedLlvmOpcodesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-unsigned-opcodes",
        raw"""
module Demo

unsafe fn u64[0 max] Divide(u64[0 max] left, u64[0 max] right)
{
    return left / right;
}

unsafe fn u64[0 max] Remainder(u64[0 max] left, u64[0 max] right)
{
    return left % right;
}

unsafe fn bool Greater(u64[0 max] left, u64[0 max] right)
{
    return left > right;
}

unsafe fn u64[0 max] ShiftRight(u64[0 max] value)
{
    return value >> 1;
}

unsafe fn u64[0 max] Widen(u32[0 max] value)
{
    return (u64[0 max])value;
}

unsafe fn f64 ToFloat(u64[0 max] value)
{
    return (f64)value;
}

unsafe fn u64[0 max] FromFloat(f64 value)
{
    return (u64[0 max])value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "udiv i64")
        && Contains(llvm, "urem i64")
        && Contains(llvm, "icmp ugt i64")
        && Contains(llvm, "lshr i64")
        && Contains(llvm, "zext i32")
        && Contains(llvm, "uitofp i64")
        && Contains(llvm, "fptoui double");
}

// Ported from LlvmIrEmissionTests.ShiftRightAndSignedDivisionEmitExactWhenDivisibilityIsProven.
public unsafe fn bool ShiftRightAndSignedDivisionEmitExactWhenDivisibilityIsProvenImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-exact-shift-div",
        raw"""
module Demo

unsafe fn i32[min max] ShiftBack(i32[-536870912 536870911] value)
{
    return (value << 2) >> 1;
}

unsafe fn i32[min max] DivideProduct(i16[-1000 1000] value)
{
    return (value * 6) / 3;
}

unsafe fn i32[min max] DivideShift(i16[-1000 1000] value)
{
    return (value << 3) / 8;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: Assert.Equal(2, CountOccurrences("sdiv exact i32")) is reduced
    // to a presence check; the occurrence count is not expressible here.
    return Contains(llvm, "ashr exact i32")
        && Contains(llvm, "sdiv exact i32");
}

// Ported from LlvmIrEmissionTests.ShiftAndDivisionFlagsAreOmittedWhenProofFactsAreInsufficient.
public unsafe fn bool ShiftAndDivisionFlagsAreOmittedWhenProofFactsAreInsufficientImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-flags-omitted-insufficient",
        raw"""
module Demo

unsafe fn i32[min max] ShiftLeft(i32[min max] value)
{
    return value << 1;
}

unsafe fn i32[min max] ShiftRight(i32[min max] value)
{
    return value >> 1;
}

unsafe fn i32[min max] Divide(i32[min max] value, u8[2 2] divisor)
{
    return value / divisor;
}

unsafe fn i32[min max] Remainder(i32[min max] value, u8[2 2] divisor)
{
    return value % divisor;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "shl i32")
        && Contains(llvm, "ashr i32")
        && Contains(llvm, "sdiv i32")
        && Contains(llvm, "srem i32")
        && DoesNotContain(llvm, "shl nuw")
        && DoesNotContain(llvm, "shl nsw")
        && DoesNotContain(llvm, "ashr exact")
        && DoesNotContain(llvm, "sdiv exact");
}

// Ported from LlvmIrEmissionTests.ExplicitWrappingAndSaturatingArithmeticStayFlagFreeEvenWhenOrdinaryProofsExist.
public unsafe fn bool ExplicitWrappingAndSaturatingArithmeticStayFlagFreeEvenWhenOrdinaryProofsExistImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-wrap-sat-flag-free",
        raw"""
module Demo

unsafe fn i32[min max] Wrap(u8[0 10] left, u8[0 5] right)
{
    return left +% right *% 2 -% 1;
}

unsafe fn i32[min max] Sat(u8[0 10] left, u8[0 5] right)
{
    return left +| right *| 2 -| 1;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "mul i8")
        && Contains(llvm, "add i8")
        && Contains(llvm, "sub i8")
        && Contains(llvm, "mul i16")
        && Contains(llvm, "add i16")
        && Contains(llvm, "sub i16")
        && DoesNotContain(llvm, "nuw")
        && DoesNotContain(llvm, "nsw")
        && DoesNotContain(llvm, "exact");
}

// Ported from LlvmIrEmissionTests.ConstantFloatExponentExpressionsFoldBeforeLlvmEmission.
public unsafe fn bool ConstantFloatExponentExpressionsFoldBeforeLlvmEmissionImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-const-float-exponent-fold",
        raw"""
module Demo

unsafe fn f32 Run()
{
    return 2.0 ** 3.0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc float @Run()")
        && Contains(llvm, "ret float 0x4020000000000000")
        && DoesNotContain(llvm, "@llvm.pow.f32");
}

// Ported from LlvmIrEmissionTests.IntegerExponentExpressionsEmitInternalPowHelpers.
public unsafe fn bool IntegerExponentExpressionsEmitInternalPowHelpersImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-int-exponent-pow-helper",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    return left ** right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the helper-header-scoped Contains checks are reduced to
    // whole-module substring checks (ExtractDefinitionHeader is not modeled).
    return Contains(llvm, "define internal dso_local i32 @__stark_int_pow_i32(i32 %base, i32 %exponent)")
        && Contains(llvm, "unnamed_addr")
        && Contains(llvm, "call i32 @__stark_int_pow_i32(")
        && Contains(llvm, "select i1 %pow_is_odd")
        && Contains(llvm, "lshr i32 %pow_exp, 1")
        && DoesNotContain(llvm, "@llvm.pow.i32");
}

// Ported from LlvmIrEmissionTests.SmallConstantIntegerExponentExpressionsLowerToStraightLineMultiplies.
public unsafe fn bool SmallConstantIntegerExponentExpressionsLowerToStraightLineMultipliesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-small-int-exponent-multiplies",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] value)
{
    return value ** 4;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: Assert.Equal(3, Regex.Matches(runBody, "\bmul\b")) over the Run
    // body is reduced to a presence check for the straight-line multiply plus
    // the DoesNotContain on the pow helper.
    return Contains(llvm, "mul")
        && DoesNotContain(llvm, "@__stark_int_pow_i32");
}

// Ported from LlvmIrEmissionTests.ConstantLiteralSwitchesFoldBeforeLlvmEmission.
public unsafe fn bool ConstantLiteralSwitchesFoldBeforeLlvmEmissionImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-const-switch-fold",
        raw"""
module Demo

unsafe fn i32[min max] Run()
{
    stack i32[min max] value = 1;
    switch (value)
    {
        case 1:
            return 1;
        default:
            return 2;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i32 @Run()")
        && Contains(llvm, "ret i32 1")
        && DoesNotContain(llvm, "switch i32")
        && DoesNotContain(llvm, "icmp eq i32")
        && DoesNotContain(llvm, "declare fastcc i32 @Run()");
}

// Ported from LlvmIrEmissionTests.EnumSwitchExpressionCallEmitsSingleEvaluation.
public unsafe fn bool EnumSwitchExpressionCallEmitsSingleEvaluationImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-enum-switch-single-eval",
        raw"""
module Demo

enum Status
{
    Ok,
    Err(i32[min max]),
}

unsafe fn Status Next()
{
    stack mut i32[min max] acc = 977;
    stack mut i32[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    if (acc < 0)
    {
        return Status.Err(acc);
    }

    return Status.Ok;
}

unsafe fn i32[min max] Run()
{
    switch (Next())
    {
        case Status.Ok:
            return 1;
        case Status.Err(var error):
            return error;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: Assert.Equal(1, split count on "call fastcc %Status @Next()") is
    // reduced to a presence check; single-evaluation count is not expressible.
    return Contains(llvm, "call fastcc %Status @Next()");
}

// Ported from LlvmIrEmissionTests.LargeEnumSwitchLoadsTagWithRangeMetadataAndZeroTagsUnitCase.
public unsafe fn bool LargeEnumSwitchLoadsTagWithRangeMetadataAndZeroTagsUnitCaseImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-large-enum-switch-tag",
        raw"""
module Demo

enum Token
{
    Full(i32[min max], i32[min max], i32[min max], i32[min max], i32[min max]),
    Empty,
}

unsafe fn Token MakeEmpty()
{
    return Token.Empty;
}

unsafe fn Token MakeFull(i32[min max] value)
{
    return Token.Full(value, value, value, value, value);
}

unsafe fn i32[min max] Score(Token token)
{
    switch (token)
    {
        case Token.Empty:
            return 0;
        case Token.Full(var first, _, _, _, _):
            return first;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the load-tag Assert.Matches(@"load i8, ptr %..., !range !\d+")
    // regex is reduced to its literal `load i8, ptr` + `!range` fragments.
    return Contains(llvm, "%Token = type { i8, i32, i32, i32, i32, i32 }")
        && Contains(llvm, "call void @llvm.memset.inline.p0.i64(ptr align 4 %ret, i8 0, i64 24, i1 false)")
        && Contains(llvm, "insertvalue %Token zeroinitializer, i8 1, 0")
        && Contains(llvm, "!{i8 0, i8 2}")
        && Contains(llvm, "load i8, ptr")
        && Contains(llvm, "!range")
        && DoesNotContain(llvm, "load %Token, ptr %arg_token");
}

// Ported from LlvmIrEmissionTests.CaptureSwitchPatternEmitsConcreteBody.
public unsafe fn bool CaptureSwitchPatternEmitsConcreteBodyImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-capture-switch-body",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] value, bool allow)
{
    switch (value)
    {
        case var capture when allow:
            return capture;
        default:
            return 0;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "@Run(i32")
        && Contains(llvm, "%arg_value, i1")
        && Contains(llvm, "%arg_allow)")
        && Contains(llvm, "select i1 %arg_allow, i32 %arg_value, i32 0")
        && Contains(llvm, "ret i32 %select_")
        && DoesNotContain(llvm, "declare fastcc i32 @Run(i32, i1)");
}

// Ported from LlvmIrEmissionTests.MultiLabelGuardedSwitchEmitsDecisionTreeBody.
public unsafe fn bool MultiLabelGuardedSwitchEmitsDecisionTreeBodyImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-multilabel-guarded-switch",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] value, bool allow)
{
    switch (value)
    {
        case 1:
        case 2 when allow:
            return 10;
        default:
            return 20;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the define Assert.Matches regex is reduced to its `@Run(i32` /
    // `%arg_value, i1` / `%arg_allow)` literal fragments, and the
    // CountOccurrences("icmp eq i32") >= 2 check is reduced to presence.
    return Contains(llvm, "@Run(i32")
        && Contains(llvm, "%arg_value, i1")
        && Contains(llvm, "%arg_allow)")
        && Contains(llvm, "icmp eq i32")
        && Contains(llvm, "select i1 %arg_allow")
        && DoesNotContain(llvm, "switch i32")
        && DoesNotContain(llvm, "declare fastcc i32 @Run(i32, i1)");
}

// Ported from LlvmIrEmissionTests.LargeTextLiteralSwitchEmitsLengthPartitionedDispatch.
public unsafe fn bool LargeTextLiteralSwitchEmitsLengthPartitionedDispatchImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-large-text-switch-dispatch",
        raw"""
module Demo

unsafe fn i32[min max] Run(ascii value)
{
    switch (value)
    {
        case "":
            return 0;
        case "a":
            return 1;
        case "b":
            return 2;
        case "cc":
            return 3;
        case "dd":
            return 4;
        case "eee":
            return 5;
        case "fff":
            return 6;
        case "gggg":
            return 7;
        case "hhhh":
            return 8;
        case "iiiii":
            return 9;
        default:
            return 10;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: Assert.Equal(1, CountOccurrences("extractvalue %stark_ascii
    // %arg_value, 1")) is reduced to a presence check.
    return Contains(llvm, "extractvalue %stark_ascii %arg_value, 1")
        && Contains(llvm, "switch i64")
        && Contains(llvm, "icmp eq i8")
        && DoesNotContain(llvm, "declare fastcc i32 @Run(%stark_ascii)");
}

// Ported from LlvmIrEmissionTests.UnicodeTextLiteralSwitchEmitsConcreteBody.
public unsafe fn bool UnicodeTextLiteralSwitchEmitsConcreteBodyImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-unicode-text-switch-body",
        raw"""
module Demo

unsafe fn i32[min max] Run(unicode value)
{
    switch (value)
    {
        case "\u03c0":
            return 1;
        case "\u03bb":
            return 2;
        default:
            return 3;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the define Assert.Matches regex is reduced to its literal
    // `define fastcc` + `i32 @Run(%stark_unicode %arg_value)` fragments.
    return Contains(llvm, "i32 @Run(%stark_unicode %arg_value)")
        && Contains(llvm, "extractvalue %stark_unicode %arg_value, 0")
        && Contains(llvm, "load i32, ptr")
        && DoesNotContain(llvm, "declare fastcc i32 @Run(%stark_unicode)");
}

// Ported from LlvmIrEmissionTests.TextSlicesEmitShiftedAsciiAndUnicodeViews.
public unsafe fn bool TextSlicesEmitShiftedAsciiAndUnicodeViewsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-text-slices-shifted-views",
        raw"""
module Demo

unsafe fn ascii SliceAscii(ascii text, i32[min max] start, i32[min max] length)
{
    return text[start, length];
}

unsafe fn unicode SliceUnicode(unicode text, i32[min max] start, i32[min max] length)
{
    return text[start, length];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc %stark_ascii @SliceAscii(%stark_ascii %arg_text, i32 %arg_start, i32 %arg_length)")
        && Contains(llvm, "extractvalue %stark_ascii %arg_text, 0")
        && Contains(llvm, "getelementptr i8, ptr")
        && DoesNotContain(llvm, "getelementptr inbounds i8, ptr")
        && Contains(llvm, "insertvalue %stark_ascii")
        && Contains(llvm, "i64 %")
        && Contains(llvm, "define fastcc %stark_unicode @SliceUnicode(%stark_unicode %arg_text, i32 %arg_start, i32 %arg_length)")
        && Contains(llvm, "extractvalue %stark_unicode %arg_text, 0")
        && Contains(llvm, "getelementptr i32, ptr")
        && DoesNotContain(llvm, "getelementptr inbounds i32, ptr")
        && Contains(llvm, "insertvalue %stark_unicode");
}

// Ported from LlvmIrEmissionTests.ExplicitAsciiLiteralToUnicodeConversionEmitsUnicodeConstant.
