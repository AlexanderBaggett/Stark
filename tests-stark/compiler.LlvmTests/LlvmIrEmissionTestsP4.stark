// Ported from LlvmIrEmissionTests.SameWidthSignednessChangingIntegerConversionsTranslateReturnRangeFacts.
public unsafe fn bool SameWidthSignednessChangingIntegerConversionsTranslateReturnRangeFactsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-signedness-change-range",
        raw"""
module Demo

unsafe fn i32[min max] Full(u32[0 max] value)
{
    return (i32[min max])value;
}

unsafe fn i32[min max] Low(u32[0 2147483647] value)
{
    return (i32[min max])value;
}

unsafe fn i32[min max] High(u32[2147483648 max] value)
{
    return (i32[min max])value;
}

unsafe fn u32[0 max] NegativeToUnsigned(i32[min -1] value)
{
    return (u32[0 max])value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i32 @Full(i32 %arg_value)")
        && DoesNotContain(llvm, "define fastcc range(i32 0, -2147483648) i32 @Full")
        && Contains(llvm, "define fastcc range(i32 0, -2147483648) i32 @Low(i32 range(i32 0, -2147483648) %arg_value)")
        && Contains(llvm, "define fastcc range(i32 -2147483648, 0) i32 @High(i32 range(i32 -2147483648, 0) %arg_value)")
        && Contains(llvm, "define fastcc range(i32 -2147483648, 0) i32 @NegativeToUnsigned(i32 range(i32 -2147483648, 0) %arg_value)");
}

// Ported from LlvmIrEmissionTests.ProvenNonNegativeSignedDivisionAndModuloUseUnsignedLlvmOpcodes.
public unsafe fn bool ProvenNonNegativeSignedDivisionAndModuloUseUnsignedLlvmOpcodesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-nonneg-div-mod-unsigned",
        raw"""
module Demo

unsafe fn i32[min max] DivideMasked(i32[min max] value, u8[1 10] divisor)
{
    return (value & 255) / divisor;
}

unsafe fn i32[min max] ModuloMasked(i32[min max] value, u8[1 10] divisor)
{
    return (value & 255) % divisor;
}

unsafe fn bool LessMasked(i32[min max] value, u8[0 max] threshold)
{
    return (value & 255) < threshold;
}

unsafe fn bool GreaterMasked(i32[min max] value, u8[0 max] threshold)
{
    return (value & 255) > threshold;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "udiv i32")
        && Contains(llvm, "urem i32")
        && Contains(llvm, "icmp ult i32")
        && Contains(llvm, "icmp ugt i32")
        && Contains(llvm, "define fastcc range(i32 0, 256) i32 @DivideMasked")
        && Contains(llvm, "define fastcc range(i32 0, 10) i32 @ModuloMasked")
        && DoesNotContain(llvm, "sdiv i32")
        && DoesNotContain(llvm, "srem i32")
        && DoesNotContain(llvm, "icmp slt i32")
        && DoesNotContain(llvm, "icmp sgt i32");
}

