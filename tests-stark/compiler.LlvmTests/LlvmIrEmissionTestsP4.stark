// Ported from LlvmIrEmissionTests.UnsignedOrdinaryArithmeticDoesNotInventSignedNoWrapForHighBitResults.
public unsafe fn bool UnsignedOrdinaryArithmeticDoesNotInventSignedNoWrapForHighBitResultsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-unsigned-no-signed-nowrap",
        raw"""
module Demo

unsafe fn u32[0 max] AddIntoHighBit(u32[2147483647 2147483647] left)
{
    return left + (u32[0 max])1;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "add nuw i32")
        && DoesNotContain(llvm, "add nuw nsw i32")
        && DoesNotContain(llvm, "add nsw i32");
}

// Ported from LlvmIrEmissionTests.PropagatedValueFactsEmitUnsignedNoWrapForJoinedRanges.
public unsafe fn bool PropagatedValueFactsEmitUnsignedNoWrapForJoinedRangesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-joined-ranges-nuw-nsw",
        raw"""
module Demo

unsafe fn i32[min max] AddAfterJoin(bool flag, u8[0 10] left, u8[20 30] right)
{
    stack mut i32[min max] value = left;
    if (flag)
    {
        value = right;
    }

    return value + 1;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "add nuw nsw i32");
