public unsafe fn bool IndependentBoundedRawPointerLoopsEmitAccessGroupAndParallelLoopMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-independent-bounded-rawptr-parallel",
        raw"""
module Demo

unsafe fn void Copy(
    rawptr<i32[min max]>[count] input,
    rawmutptr<i32[min max]>[count] output,
    u8[0 10] count)
    where disjoint(input[0, count], output[0, count])
    {
        for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        *(&output[index]) = *(&input[index]) + 1;
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "!llvm.access.group !")
        && Contains(llvm, "!\"llvm.loop.parallel_accesses\"")
        && Contains(llvm, "!\"llvm.loop.mustprogress\"");
}

