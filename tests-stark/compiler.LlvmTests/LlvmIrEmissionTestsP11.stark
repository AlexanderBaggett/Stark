    return Contains(llvm, "declare void @llvm.memmove.p0.p0.i64(ptr nocapture writeonly, ptr nocapture readonly, i64, i1 immarg)")
        && Contains(llvm, "call void @llvm.memmove.p0.p0.i64(ptr align 4 %arg_output, ptr align 4 %arg_input, i64 16, i1 false)")
        && Contains(llvm, "store i32 17")
        && DoesNotContain(llvm, "@llvm.memcpy.p0.p0.i64");
}

// Ported from LlvmIrEmissionTests.BoundedRawPointerForwardBackwardMoveLoopLowersToMemmove.
public unsafe fn bool BoundedRawPointerForwardBackwardMoveLoopLowersToMemmoveImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-bounded-rawptr-fwd-bwd-move-memmove",
        raw"""
module Demo

unsafe fn void MoveOverlapSafe(
    rawptr<i32[min max]>[count] input,
    rawmutptr<i32[min max]>[count] output,
    u8[0 10] count)
    {
        if (count == 0)
    {
        return;
    }

    stack rawptr<i32[min max]> sourceStart = input;
    stack rawptr<i32[min max]> destinationStart = (rawptr<i32[min max]>)output;
    if (destinationStart < sourceStart)
    {
        for willexit (stack mut u8[0 10] index = 0; index < count; index += 1)
        {
            *(&output[index]) = *(&input[index]);
        }

        return;
    }

    stack mut u8[0 10] remaining = count;
    while willexit (remaining > 0)
    {
        remaining -= 1;
        *(&output[remaining]) = *(&input[remaining]);
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the byte-mul and aligned-memmove Assert.Matches regexes are
    // reduced to literal Contains on their stable fragments.
    return Contains(llvm, "declare void @llvm.memmove.p0.p0.i64(ptr nocapture writeonly, ptr nocapture readonly, i64, i1 immarg)")
        && Contains(llvm, ", 4")
        && Contains(llvm, "call void @llvm.memmove.p0.p0.i64(ptr align 4 %arg_output, ptr align 4 %arg_input, i64 ")
        && DoesNotContain(llvm, "icmp ult ptr")
        && DoesNotContain(llvm, "_phi = phi");
}

// Ported from LlvmIrEmissionTests.SliceForwardBackwardMoveLoopLowersToMemmoveWhenByteLengthIsRepresentable.
public unsafe fn bool SliceForwardBackwardMoveLoopLowersToMemmoveWhenByteLengthIsRepresentableImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-slice-fwd-bwd-move-memmove-representable",
        raw"""
module Demo

unsafe fn void MoveOverlapSafe(
    borrow i32[min max][] input,
    borrow mut i32[min max][] output,
    u64[0 2 ** 61 - 1] count)
    {
        if (count == 0)
    {
        return;
    }

    stack rawptr<i32[min max]> sourceStart = &input[0];
    stack rawptr<i32[min max]> destinationStart = (rawptr<i32[min max]>)(&output[0]);
    if (destinationStart < sourceStart)
    {
        for willexit (stack mut u64[0 2 ** 61 - 1] index = 0; index < count; index += 1)
        {
            output[index] = input[index];
        }

        return;
    }

    stack mut u64[0 2 ** 61 - 1] remaining = count;
    while willexit (remaining > 0)
    {
        remaining -= 1;
        output[remaining] = input[remaining];
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the byte-mul and aligned-memmove Assert.Matches regexes are
    // reduced to literal Contains on their stable fragments.
    return Contains(llvm, "declare void @llvm.memmove.p0.p0.i64(ptr nocapture writeonly, ptr nocapture readonly, i64, i1 immarg)")
        && Contains(llvm, " = mul i64 %arg_count, 4")
        && Contains(llvm, "call void @llvm.memmove.p0.p0.i64(ptr align 4 %abi_rawptr_loop_destination_data_")
        && DoesNotContain(llvm, "icmp ult ptr")
        && DoesNotContain(llvm, "_phi = phi");
}

// Ported from LlvmIrEmissionTests.BoundedRawPointerOverlapSafeTemporaryCopyWithTemporaryEpilogueUseKeepsScalarLowering.
public unsafe fn bool BoundedRawPointerOverlapSafeTemporaryCopyWithTemporaryEpilogueUseKeepsScalarLoweringImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-bounded-rawptr-overlap-safe-epilogue-scalar",
        raw"""
module Demo

unsafe fn void CopyOverlapSafe(
    rawptr<i32[min max]>[4] input,
    rawmutptr<i32[min max]>[4] output)
    {
        stack mut i32[min max][4] temporary =
    {
        0, 0, 0, 0
    };

    for willexit (stack mut u8[0 4] index = 0; index < 4; index += 1)
    {
        temporary[index] = *(&input[index]);
    }

    for willexit (stack mut u8[0 4] index = 0; index < 4; index += 1)
    {
        *(&output[index]) = temporary[index];
    }

    *(&output[0]) = temporary[0];
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the scalar load/store Assert.Matches regexes are reduced to
    // literal Contains on their instruction prefixes.
    return DoesNotContain(llvm, "@llvm.memmove.p0.p0.i64")
        && Contains(llvm, " = load i32, ptr %v")
        && Contains(llvm, "store i32 %v");
}

