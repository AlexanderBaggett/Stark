// Ported from LlvmIrEmissionTests.WillexitScalarLoopsEmitMustProgressLoopMetadata.
public unsafe fn bool WillexitScalarLoopsEmitMustProgressLoopMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-willexit-scalar-mustprogress",
        raw"""
module Demo

unsafe fn u8[0 10] Run(u8[0 10] limit)
{
    stack mut u8[0 10] value = 0;
    while willexit (value < limit)
    {
        value += 1;
    }

    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "!llvm.loop !")
        && Contains(llvm, "!\"llvm.loop.mustprogress\"")
        && DoesNotContain(llvm, "!\"llvm.loop.parallel_accesses\"");
}

