// Ported from LlvmIrEmissionTests.IndependentBoundedRawPointerFillAndTransformLoopsEmitParallelMetadata.
public unsafe fn bool IndependentBoundedRawPointerFillAndTransformLoopsEmitParallelMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-independent-bounded-rawptr-fill-transform-parallel",
        raw"""
module Demo

unsafe fn void Fill(rawmutptr<i64[min max]>[32] output, i64[min max] value)
{
    for willexit independent (stack mut u8[0 32] index = 0; index < 32; index += 1)
    {
        *(&output[index]) = value;
    }

    return;
}

unsafe fn void Transform(
    rawptr<i64[min max]>[32] input,
    rawmutptr<i64[min max]>[32] output)
    where disjoint(input[0, 32], output[0, 32])
    {
        for willexit independent (stack mut u8[0 32] index = 0; index < 32; index += 1)
    {
        *(&output[index]) = *(&input[index]) + 1;
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the two Assert.True(Regex.Matches(...).Count >= 2) occurrence
    // assertions are reduced to presence Contains probes for the parallel and
    // access-group markers.
    return Contains(llvm, "!\"llvm.loop.parallel_accesses\"")
        && Contains(llvm, "!llvm.access.group !")
        && Contains(llvm, "!\"llvm.loop.mustprogress\"");
}

