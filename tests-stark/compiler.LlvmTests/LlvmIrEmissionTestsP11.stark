// Ported from LlvmIrEmissionTests.IndependentSliceLoopsEmitAccessGroupAndParallelLoopMetadata.
public unsafe fn bool IndependentSliceLoopsEmitAccessGroupAndParallelLoopMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-independent-slice-parallel",
        raw"""
module Demo

unsafe fn void Add(
    borrow i32[min max][] left,
    borrow i32[min max][] right,
    borrow mut i32[min max][] output,
    u8[0 10] count)
    {
        for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        output[index] = left[index] + right[index];
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "!llvm.access.group !")
        && Contains(llvm, "!\"llvm.loop.parallel_accesses\"")
        && Contains(llvm, "!\"llvm.loop.mustprogress\"");
}

// Ported from LlvmIrEmissionTests.FixedArrayToSliceCallArgumentsMaterializeSliceAbiSlots.
public unsafe fn bool FixedArrayToSliceCallArgumentsMaterializeSliceAbiSlotsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-fixed-array-to-slice-abi-slots",
        raw"""
module Demo

unsafe fn void Touch(borrow i64[min max][] values)
{
    return;
}

unsafe fn void Run()
{
    stack mut i64[min max][2] values =
    {
        1, 2
    };
    Touch(values);
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the Assert.Matches call-with-slice-slot regex and the
    // Assert.DoesNotMatch call-with-bare-value regex are reduced to literal
    // Contains/DoesNotContain probes for the slice-slot suffix and the slice
    // store shape.
    return Contains(llvm, "store { ptr, i64 }")
        && Contains(llvm, "_slice)")
        && DoesNotContain(llvm, "call fastcc void @Touch(ptr %v");
}

// Ported from LlvmIrEmissionTests.IndependentSliceLoopsWithConditionalsEmitAccessGroupAndParallelLoopMetadata.
public unsafe fn bool IndependentSliceLoopsWithConditionalsEmitAccessGroupAndParallelLoopMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-independent-slice-conditional-parallel",
        raw"""
module Demo

unsafe fn void SelectPositive(
    borrow i32[min max][] left,
    borrow i32[min max][] right,
    borrow mut i32[min max][] output,
    u8[0 10] count)
    {
        for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        if (left[index] > 0)
        {
            output[index] = left[index];
        }
        else
        {
            output[index] = right[index];
        }
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "!llvm.access.group !")
        && Contains(llvm, "!\"llvm.loop.parallel_accesses\"")
        && Contains(llvm, "!\"llvm.loop.mustprogress\"");
}

