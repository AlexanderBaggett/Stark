import LlvmTestSupport
import System.Testing
module LlvmIrEmissionTestsP11

// Ported slice of tests/compiler.Tests/LlvmIrEmissionTests.cs, running against
// the current C# host compiler through the host test protocol. Each Impl
// compiles the embedded program, requests the rendered `llvm` artifact (raw
// LLVM-IR text), and asserts on substrings with System.Testing text helpers.
//
// PORT-NOTE (applies throughout): the C# oracle distinguishes GetLlvm (a
// noundef/whitespace-normalized rendering) from GetLlvmRaw, and uses
// ExtractDefinitionHeader / ExtractDefinitionBody to scope assertions to one
// function's `define`/`declare` line, plus Assert.Matches (regex),
// Assert.DoesNotMatch, and Assert.Equal(N, CountOccurrences(...)) for counts.
// The host bridge only exposes the raw `llvm` text and Contains/DoesNotContain,
// so: header/body scoping is reduced to whole-module Contains; regex matches are
// reduced to a representative literal substring; DoesNotMatch is reduced to a
// representative literal DoesNotContain; and exact-count assertions are reduced
// to a presence Contains check. Each such reduction is flagged inline.

// Ported from LlvmIrEmissionTests.ConstRawPointerParameterLoadsDoNotEmitInvariantLoadMetadata.
public unsafe fn bool ConstRawPointerParameterLoadsDoNotEmitInvariantLoadMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-const-rawptr-param-no-invariant-load",
        raw"""
module Demo

unsafe fn i32[min max] Read(const rawmutptr<i32[min max]> ptr)
{
    return *ptr;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: Assert.DoesNotMatch(@"load i32, ptr .* !invariant\.load !\d+")
    // reduced to a literal DoesNotContain on the invariant.load marker.
    return DoesNotContain(llvm, "!invariant.load !");
}

// Ported from LlvmIrEmissionTests.RawSlicesPreserveRuntimeDisjointScopedNoAliasMetadata.
public unsafe fn bool RawSlicesPreserveRuntimeDisjointScopedNoAliasMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-raw-slices-runtime-disjoint-noalias",
        raw"""
module Demo

unsafe fn i32[min max] CopyFirst(
    rawmutptr<i32[min max]>[count] left,
    rawptr<i32[min max]>[count] right,
    u8[1 10] count)
    {
        if disjoint(left[0, count], right[0, count])
    {
        unsafe
        {
            stack mut mut i32[min max][] leftView = slice(left, count);
            stack i32[min max][] rightView = slice(right, count);
            leftView[0] = rightView[0];
            return rightView[0];
        }
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the two Assert.Matches store/load scoped-noalias regexes are
    // reduced to literal Contains on the alias.scope/noalias markers.
    return Contains(llvm, "stark.noalias.CopyFirst.runtime-disjoint-0.param.left[0..9]")
        && Contains(llvm, "stark.noalias.CopyFirst.runtime-disjoint-0.param.right[0..9]")
        && Contains(llvm, "!alias.scope !")
        && Contains(llvm, "!noalias !");
}

