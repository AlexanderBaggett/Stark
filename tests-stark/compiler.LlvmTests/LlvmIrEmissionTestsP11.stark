// Ported from LlvmIrEmissionTests.IntegerArithmeticFoldLowersRepeatedProductRunsWithoutPowHelper.
public unsafe fn bool IntegerArithmeticFoldLowersRepeatedProductRunsWithoutPowHelperImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-integer-fold-product-runs-without-pow-helper",
        raw"""
module Demo

fn i32[min max] Run(i32[min max] value)
{
    return value * value * value * value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: Assert.Equal(3, Regex.Matches(runBody, @"\bmul\b").Count) is an
    // exact-count assertion the host bridge cannot express; it is reduced to a
    // presence Contains on `mul`. The no-pow-helper DoesNotContain probe is
    // kept as-is.
    return Contains(llvm, "mul")
        && DoesNotContain(llvm, "@__stark_int_pow_i32");
}
