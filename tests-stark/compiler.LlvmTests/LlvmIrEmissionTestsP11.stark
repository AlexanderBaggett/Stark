// Ported from LlvmIrEmissionTests.BoundedRawPointerCopyLoopLowersToMemcpyWhenNoAliasIsProven.
public unsafe fn bool BoundedRawPointerCopyLoopLowersToMemcpyWhenNoAliasIsProvenImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-bounded-rawptr-copy-memcpy-noalias",
        raw"""
module Demo

unsafe fn void Copy(
    rawptr<i32[min max]>[count] input,
    rawmutptr<i32[min max]>[count] output,
    u8[0 10] count)
    where disjoint(input[0, count], output[0, count])
    {
        for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        *(&output[index]) = *(&input[index]);
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the four Assert.Matches regexes (zext count, byte mul, the
    // aligned memcpy call, the scoped-noalias memcpy call) are reduced to
    // literal Contains probes for their stable fragments.
    return Contains(llvm, "declare void @llvm.memcpy.p0.p0.i64(ptr nocapture writeonly, ptr nocapture readonly, i64, i1 immarg)")
        && Contains(llvm, " = zext i8 %arg_count to i64")
        && Contains(llvm, ", 4")
        && Contains(llvm, "call void @llvm.memcpy.p0.p0.i64(ptr align 4 %arg_output, ptr align 4 %arg_input, i64 ")
        && Contains(llvm, "!alias.scope !")
        && DoesNotContain(llvm, "!\"llvm.loop.parallel_accesses\"");
}

// Ported from LlvmIrEmissionTests.BoundedRawPointerCopyLoopInsideNontrivialFunctionLowersToMemcpy.
public unsafe fn bool BoundedRawPointerCopyLoopInsideNontrivialFunctionLowersToMemcpyImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-bounded-rawptr-copy-memcpy-nontrivial",
        raw"""
module Demo

unsafe fn void Copy(
    rawptr<i32[min max]>[count] input,
    rawmutptr<i32[min max]>[count] output,
    u8[0 10] count)
    where disjoint(input[0, count], output[0, count])
    {
        for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        *(&output[index]) = *(&input[index]);
    }

    if (count > 0)
    {
        *(&output[0]) = 17;
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the aligned-memcpy Assert.Matches regex is reduced to a literal
    // Contains on its stable prefix.
    return Contains(llvm, "declare void @llvm.memcpy.p0.p0.i64(ptr nocapture writeonly, ptr nocapture readonly, i64, i1 immarg)")
        && Contains(llvm, "call void @llvm.memcpy.p0.p0.i64(ptr align 4 %arg_output, ptr align 4 %arg_input, i64 ")
        && DoesNotContain(llvm, "!\"llvm.loop.parallel_accesses\"");
}

// Ported from LlvmIrEmissionTests.BoundedRawPointerCopyLoopWithoutNoAliasProofKeepsScalarLowering.
public unsafe fn bool BoundedRawPointerCopyLoopWithoutNoAliasProofKeepsScalarLoweringImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-bounded-rawptr-copy-no-noalias-scalar",
        raw"""
module Demo

unsafe fn void Copy(
    rawptr<i32[min max]>[count] input,
    rawmutptr<i32[min max]>[count] output,
    u8[0 10] count)
    where overlap(input, output)
    {
        for willexit (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        *(&output[index]) = *(&input[index]);
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: Assert.DoesNotMatch on the memcpy regex reduced to a literal
    // DoesNotContain; the scalar load/store Assert.Matches regexes are reduced
    // to literal Contains on their instruction prefixes.
    return DoesNotContain(llvm, "call void @llvm.memcpy.p0.p0.i64")
        && Contains(llvm, " = load i32, ptr %v")
        && Contains(llvm, "store i32 %v");
}

