// Ported from LlvmIrEmissionTests.ClosureCallsWithFiniteKnownTargetSetsEmitCalleesMetadata.
public unsafe fn bool ClosureCallsWithFiniteKnownTargetSetsEmitCalleesMetadataImpl()
{
    // PORT-NOTE: the C# captures the `!callees !N` id and asserts the metadata
    // line `!N = !{... ptr @Apply___closure_adapter_* ...}` mentions two adapter
    // entries via regex. The host helpers cannot resolve the dynamic metadata
    // id, so this asserts the `!callees` marker plus effect attributes are
    // present in the Apply body, and the closure-adapter symbol appears in the
    // whole-module text.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-closure-finite-known-target-callees",
        raw"""
module Demo

noinline finite law i32[min max] Left(i32[min max] value)
{
    return value;
}

noinline finite law i32[min max] Right(i32[min max] value)
{
    return value + 1;
}

finite law i32[min max] Apply(bool chooseRight, i32[min max] value)
{
    stack mut closure<finite law i32[min max](i32[min max])> op = Left;
    if (chooseRight)
    {
        op = Right;
    }

    return op(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii applyBody = LlvmDefinitionBody(llvm, "Apply");
    return Contains(applyBody, "!callees")
        && Contains(applyBody, "willreturn")
        && Contains(applyBody, "mustprogress")
        && Contains(applyBody, "memory(argmem: read)")
        && Contains(llvm, "ptr @Apply___closure_adapter_");
}

