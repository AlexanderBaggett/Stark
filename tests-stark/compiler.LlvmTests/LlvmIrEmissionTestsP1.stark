// Ported from LlvmIrEmissionTests.FunctionPointerCallsWithLargeReturnValuesUseSretAbi.
public unsafe fn bool FunctionPointerCallsWithLargeReturnValuesUseSretAbiImpl()
{
    // PORT-NOTE: the C# `Assert.Matches(@"call fastcc void %arg_op\(ptr noalias
    // sret(%Big) nonnull dereferenceable(24) align 8 %ret")` is reduced to the
    // equivalent concrete substring (anchored on the `%ret` slot prefix).
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-fnptr-large-sret-abi",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
}

unsafe fn Big Make(i64[min max] seed)
{
    return new Big()
    {
        A = seed, B = seed + 1, C = seed + 2
    };
}

unsafe fn Big Apply(fnptr<unsafe fn Big(i64[min max])> op, i64[min max] seed)
{
    return op(seed);
}

unsafe fn i64[min max] Run()
{
    stack Big value = Apply(Make, 4);
    return value.C;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii applyBody = LlvmDefinitionBody(llvm, "Apply");
    return DoesNotContain(llvm, "; LLVM body emission fallback for Apply")
        && Contains(llvm, "define fastcc void @Apply(ptr noundef noalias sret(%Big)")
        && Contains(applyBody, "call fastcc void %arg_op(ptr noalias sret(%Big) nonnull dereferenceable(24) align 8 %ret")
        && DoesNotContain(applyBody, "%abi_indirect_callret_slot_")
        && DoesNotContain(applyBody, "call void @llvm.memcpy.inline.p0.p0.i64(ptr align 8 %ret");
}

// Ported from LlvmIrEmissionTests.DirectVoidStatementCallsWithOutParametersUseCallerStorage.
public unsafe fn bool DirectVoidStatementCallsWithOutParametersUseCallerStorageImpl()
{
    // PORT-NOTE: the C# `Assert.Matches(@"call fastcc void @Touch\(ptr [^\n]*\)")`
    // (any-pointer-args direct call) is reduced to the concrete substring prefix
    // `call fastcc void @Touch(ptr`.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-direct-void-out-caller-storage",
        raw"""
module Demo

fn void Touch(out i32[min max] value, i32[min max] seed)
{
    value = seed;
    value = value + (value / 3);
    value = value - (value / 5);
    value = value + (value / 7);
    value = value - (value / 11);
    value = value + (value / 13);
    value = value - (value / 17);
    value = value + (value / 19);
    value = value - (value / 23);
    value = value + (value / 29);
    value = value - (value / 31);
    value = value + (value / 37);
    value = value - (value / 41);
    value = value + (value / 43);
    return;
}

unsafe fn i32[min max] Run(i32[min max] seed)
{
    stack mut i32[min max] value = 0;
    Touch(value, seed);
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "define fastcc void @Touch(ptr noundef nonnull")
        && Contains(runBody, "call fastcc void @Touch(ptr")
        && DoesNotContain(runBody, "%abi_callarg_value");
}

// Ported from LlvmIrEmissionTests.DirectCallsWithLargeByValueTemporaryConstructDirectlyIntoByvalCallSlot.
public unsafe fn bool DirectCallsWithLargeByValueTemporaryConstructDirectlyIntoByvalCallSlotImpl()
{
    // PORT-NOTE: the C# `Assert.Matches(@"call fastcc i64 @Read\(ptr nonnull
    // byval(%Big) noalias readonly nocapture dereferenceable(32) align 8
    // %abi_callarg_value_\d+\)")` carries a numeric SSA suffix; the host helpers
    // cannot anchor a numeric capture, so it is reduced to the stable substring
    // prefix through the `%abi_callarg_value_` slot name.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-direct-large-byval-temp-slot",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

unsafe fn i64[min max] Read(Big value)
{
    stack i64[min max] a = value.A + (value.D / 3);
    stack i64[min max] b = a - (a / 5);
    stack i64[min max] c = b + (b / 7);
    stack i64[min max] d = c - (c / 11);
    stack i64[min max] e = d + (d / 13);
    stack i64[min max] f = e - (e / 17);
    stack i64[min max] g = f + (f / 19);
    stack i64[min max] h = g - (g / 23);
    stack i64[min max] i = h + (h / 29);
    stack i64[min max] j = i - (i / 31);
    stack i64[min max] k = j + (j / 37);
    stack i64[min max] l = k - (k / 41);
    stack i64[min max] m = l + (l / 43);
    return m;
}

unsafe fn i64[min max] Run()
{
    stack Big value = new Big()
    {
        A = 1, B = 2, C = 3, D = 4
    };
    return Read(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii runHeader = LlvmDefinitionHeader(llvm, "Run");
    stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(runHeader, "memory(none)")
        && DoesNotContain(runHeader, "memory(readwrite")
        && Contains(llvm, "define fastcc noundef i64 @Read(ptr noundef nonnull byval(%Big)")
        && Contains(runBody, "call fastcc i64 @Read(ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %abi_callarg_value_")
        && DoesNotContain(runBody, "%slot_value")
        && DoesNotContain(runBody, "load %Big")
        && DoesNotContain(runBody, "store %Big");
}
