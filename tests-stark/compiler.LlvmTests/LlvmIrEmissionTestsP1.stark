// Ported from LlvmIrEmissionTests.FunctionPointerCallSiteEffectAttributesComposeWithOutAndAggregateAbi.
public unsafe fn bool FunctionPointerCallSiteEffectAttributesComposeWithOutAndAggregateAbiImpl()
{
    // PORT-NOTE: three independent compiles (out / init / aggregate), each
    // extracting the `%arg_f` indirect-call line by regex. The port scopes the
    // attribute substring checks to each Apply body and ANDs all three cases.
    stack mut LlvmCompile outC = CompileLlvm(
        "llvm-fnptr-compose-out",
        raw"""
module Demo

finite bool Apply(fnptr<finite bool(out u32[0 max])> f, out u32[0 max] value)
{
    return f(value);
}
""");
    if (!Succeeds(outC))
    {
        return false;
    }

    stack ascii outLlvm = Llvm(outC);
    stack ascii outBody = LlvmDefinitionBody(outLlvm, "Apply");
    if (!(Contains(outBody, "writeonly")
        && Contains(outBody, "willreturn")
        && Contains(outBody, "mustprogress")))
    {
        return false;
    }

    stack mut LlvmCompile initC = CompileLlvm(
        "llvm-fnptr-compose-init",
        raw"""
module Demo

finite void Apply(fnptr<finite void(init u32[0 max][])> f, init u32[0 max][] values)
{
    f(values);
    return;
}
""");
    if (!Succeeds(initC))
    {
        return false;
    }

    stack ascii initLlvm = Llvm(initC);
    stack ascii initBody = LlvmDefinitionBody(initLlvm, "Apply");
    if (!(Contains(initBody, "noalias")
        && Contains(initBody, "willreturn")
        && Contains(initBody, "mustprogress")))
    {
        return false;
    }

    stack mut LlvmCompile aggregateC = CompileLlvm(
        "llvm-fnptr-compose-aggregate",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
}

finite law Big Apply(fnptr<finite law Big(Big)> f, Big value)
{
    return f(value);
}
""");
    if (!Succeeds(aggregateC))
    {
        return false;
    }

    stack ascii aggregateLlvm = Llvm(aggregateC);
    stack ascii aggregateBody = LlvmDefinitionBody(aggregateLlvm, "Apply");
    return Contains(aggregateBody, "sret(%Big)")
        && Contains(aggregateBody, "byval(%Big)")
        && Contains(aggregateBody, "willreturn")
        && Contains(aggregateBody, "mustprogress")
        && Contains(aggregateBody, "nosync")
        && Contains(aggregateBody, "nofree")
        && Contains(aggregateBody, "memory(argmem: readwrite)");
}

// Ported from LlvmIrEmissionTests.FunctionPointerCallsWithBorrowParametersUsePointerAbi.
public unsafe fn bool FunctionPointerCallsWithBorrowParametersUsePointerAbiImpl()
{
    // PORT-NOTE: the C# `Assert.Matches(@"call fastcc i32 %arg_op\(ptr nonnull
    // noalias readonly captures(address, read_provenance) dereferenceable(4)
    // align 4 %arg_box\)")` is reduced to the equivalent concrete substring.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-fnptr-borrow-pointer-abi",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Read(borrow Box box)
{
    return box.Value;
}

unsafe fn i32[min max] Apply(fnptr<unsafe fn i32[min max](borrow Box)> op, borrow Box box)
{
    return op(box);
}

unsafe fn i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 42
    };
    return Apply(Read, box);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii header = LlvmDefinitionHeader(llvm, "Apply");
    stack ascii applyBody = LlvmDefinitionBody(llvm, "Apply");
    return DoesNotContain(llvm, "; LLVM body emission fallback for Apply")
        && Contains(header, "ptr noundef nonnull %arg_op")
        && Contains(applyBody, "call fastcc i32 %arg_op(ptr nonnull noalias readonly captures(address, read_provenance) dereferenceable(4) align 4 %arg_box)");
}

