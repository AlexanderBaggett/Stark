import LlvmTestSupport
import System.Testing
module FixedArrayOrderedComparisonEmissionTests

// Ported from FixedArrayOrderedComparisonEmissionTests.FixedArrayOrderedComparisonsEmitLexicographicHelperCalls.
internal fn bool FixedArrayOrderedComparisonsEmitLexicographicHelperCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-fixed-array-ordered-comparisons",
        raw"""
module Demo

fn bool Less(i32[min max][3] left, i32[min max][3] right)
{
    return left < right;
}

fn bool LessOrEqual(i32[min max][3] left, i32[min max][3] right)
{
    return left <= right;
}

fn bool Greater(i32[min max][3] left, i32[min max][3] right)
{
    return left > right;
}

fn bool GreaterOrEqual(i32[min max][3] left, i32[min max][3] right)
{
    return left >= right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define internal dso_local i32 @__stark_fixed_array_compare_")
        && Contains(llvm, "call i32 @__stark_fixed_array_compare_")
        && Contains(llvm, "icmp slt i32")
        && Contains(llvm, "icmp sgt i32")
        && Contains(llvm, "icmp sle i32")
        && Contains(llvm, "icmp sge i32")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Less")
        && DoesNotContain(llvm, "; LLVM body emission fallback for LessOrEqual")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Greater")
        && DoesNotContain(llvm, "; LLVM body emission fallback for GreaterOrEqual");
}
