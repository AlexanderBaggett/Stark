// Ported from LlvmIrEmissionTests.OverlapRawPointerParametersDoNotEmitNoAliasAttributes.
public unsafe fn bool OverlapRawPointerParametersDoNotEmitNoAliasAttributesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p10-overlap-rawptr-params-no-noalias",
        raw"""
module Demo

unsafe fn void Touch(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
    where overlap(left, right)
    {
        *left = *right;
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original asserted against the sliced `@Touch` header,
    // including a header-scoped `DoesNotContain("noalias")`. The helper cannot
    // scope to the header, so the positive nocapture parameter fragments are
    // checked via substring; the header-scoped noalias-absence guard is dropped (a
    // whole-module `noalias` absence would over-match unrelated emission).
    return Contains(llvm, "ptr noundef nocapture %arg_left")
        && Contains(llvm, "ptr noundef nocapture %arg_right");
}

