// Ported from LlvmIrEmissionTests.HeapObjectCreationUsesAllocatorLowering.
public unsafe fn bool HeapObjectCreationUsesAllocatorLoweringImpl()
{
    // PORT-NOTE: C# pins TargetInfo to x86_64-unknown-linux-gnu; the host bridge
    // here compiles with default target options, so target-specific allocator
    // assertions may diverge. Kept verbatim as the closest available signal.
    stack mut LlvmCompile c = CompileLlvm(
        "p6-heap-object-allocator-lowering",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Run()
{
    heap Box box = new Box()
    {
        Value = 7
    };
    return box.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Matches on the `br ... !prof !N` and branch_weights
    // metadata reduced to substring fragments on their stable prefixes.
    return DoesNotContain(llvm, "@malloc(")
        && DoesNotContain(llvm, "@realloc(")
        && DoesNotContain(llvm, "@free(")
        && Contains(llvm, "define internal dso_local noalias nonnull noundef ptr @__stark_heap_alloc(i64 noundef %size, i64 noundef allocalign %alignment) unnamed_addr allocsize(0) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_heap_alloc\" nounwind")
        && Contains(llvm, "define internal dso_local void @__stark_heap_free(ptr %ptr) unnamed_addr allockind(\"free\") \"alloc-family\"=\"__stark_heap_alloc\" nounwind")
        && Contains(llvm, "define linkonce_odr hidden noalias nonnull noundef ptr @__stark_runtime_alloc(i64 noundef %size, i64 noundef allocalign %alignment) unnamed_addr allocsize(0) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_runtime_alloc\" nounwind comdat")
        && Contains(llvm, "define internal dso_local noalias noundef ptr @__stark_os_allocate(i64 noundef %size) unnamed_addr allocsize(0) allockind(\"alloc,uninitialized\") \"alloc-family\"=\"__stark_os_allocate\" nounwind")
        && Contains(llvm, "@__stark_alloc_lock = linkonce_odr hidden global i32 0, comdat, align 4")
        && Contains(llvm, "@__stark_alloc_bucket_16 = linkonce_odr hidden thread_local(localexec) global ptr null, comdat, align 8")
        && Contains(llvm, "@__stark_alloc_bucket_4096 = linkonce_odr hidden thread_local(localexec) global ptr null, comdat, align 8")
        && Contains(llvm, "define linkonce_odr hidden void @__stark_alloc_lock_acquire() unnamed_addr nounwind comdat")
        && Contains(llvm, "atomicrmw xchg ptr @__stark_alloc_lock, i32 1 acquire, align 4")
        && Contains(llvm, "store atomic i32 0, ptr @__stark_alloc_lock release, align 4")
        && DoesNotContain(llvm, "call void @__stark_alloc_lock_acquire()")
        && DoesNotContain(llvm, "call void @__stark_alloc_lock_release()")
        && Contains(llvm, "%bucket_alignment_ok = icmp ule i64 %effective_alignment, 16")
        && Contains(llvm, "%bucket_size_ok = icmp ule i64 %requested_size, 4096")
        && Contains(llvm, "br i1 %can_bucket, label %bucket_select_16, label %large_allocate")
        && Contains(llvm, "br label %bucket_16_refill")
        && Contains(llvm, "bucket_16_refill:")
        && Contains(llvm, "%bucket_16_slab_base = call noalias noundef ptr @__stark_os_allocate(i64 noundef")
        && Contains(llvm, "%bucket_16_refill_index = phi i64 [1, %bucket_16_slab_ok], [%bucket_16_refill_next, %bucket_16_refill_body]")
        && Contains(llvm, "%bucket_16_refill_offset = mul i64 %bucket_16_refill_index, 48")
        && Contains(llvm, "store i64 16, ptr %bucket_16_block_bucket_size_slot, align 8")
        && Contains(llvm, "store ptr %bucket_16_block, ptr @__stark_alloc_bucket_16, align 8")
        && Contains(llvm, "ret ptr %bucket_16_first")
        && Contains(llvm, "store i64 0, ptr %bucket_size_slot, align 8")
        && Contains(llvm, "store ptr %ptr, ptr @__stark_alloc_bucket_16, align 8")
        && Contains(llvm, "br i1 %bucket_is_4096, label %bucket_4096_push, label %free_os")
        && Contains(llvm, "call i64 asm sideeffect \"syscall\"")
        && Contains(llvm, "define internal dso_local coldcc void @__stark_oom_trap() unnamed_addr cold noreturn nounwind")
        && Contains(llvm, "call void @llvm.trap()")
        && Contains(llvm, "call coldcc void @__stark_oom_trap()")
        && Contains(llvm, ", !prof !")
        && Contains(llvm, "= !{!\"branch_weights\", i32 1, i32 2000}")
        && Contains(llvm, "call noalias nonnull noundef align 4 dereferenceable(4) ptr @__stark_heap_alloc(i64 noundef")
        && Contains(llvm, ", i64 noundef 4)")
        && Contains(llvm, "call void @__stark_heap_free(ptr %slot_box)")
        && DoesNotContain(llvm, "alloca %Box")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Run");
}

// Ported from LlvmIrEmissionTests.HeapFieldInitializationDoesNotReadUninitializedAggregateStorage.
public unsafe fn bool HeapFieldInitializationDoesNotReadUninitializedAggregateStorageImpl()
{
