        "p6-field-assignment-fold-scalar",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 1
    };
    box.Value = 2;
    return box.Value;
}
