    // here compiles with default target options.
    stack mut LlvmCompile c = CompileLlvm(
        "p6-heap-field-init-no-uninit-read",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

unsafe ffi fn void Touch(rawptr<Pair> pair);

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
