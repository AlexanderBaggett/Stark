    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i1 @Equal(%Pair %arg_left, %Pair %arg_right)")
        && Contains(llvm, "define fastcc i1 @NotEqual(%Pair %arg_left, %Pair %arg_right)")
        && Contains(llvm, "extractvalue %Pair %arg_left, 0")
        && Contains(llvm, "extractvalue %Pair %arg_right, 1")
        && Contains(llvm, "icmp eq i32")
        && Contains(llvm, "icmp ne i32")
        && Contains(llvm, "and i1")
        && Contains(llvm, "or i1")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Equal")
        && DoesNotContain(llvm, "; LLVM body emission fallback for NotEqual");
}

