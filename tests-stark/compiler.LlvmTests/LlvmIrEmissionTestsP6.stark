// Ported from LlvmIrEmissionTests.NonStrictFpFunctionsEmitFastMathFlagsOnBinaryOpsAndCalls.
public unsafe fn bool NonStrictFpFunctionsEmitFastMathFlagsOnBinaryOpsAndCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-nonstrict-fp-fastmath-binops-calls",
        raw"""
module Demo

noinline unsafe fn f32 Add(f32 left, f32 right)
{
    return left + right;
}

unsafe fn f32 Run(f32 left, f32 right)
{
    return Add(left, right);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "fadd fast float %arg_left, %arg_right")
        && Contains(llvm, "call fast fastcc float @Add(float %arg_left, float %arg_right)")
        && DoesNotContain(llvm, " strictfp ");
}

// Ported from LlvmIrEmissionTests.TailPositionDirectCallsEmitTailMarkerWhenAbiCompatible.
