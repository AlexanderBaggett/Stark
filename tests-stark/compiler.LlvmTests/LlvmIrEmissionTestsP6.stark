// Ported from LlvmIrEmissionTests.LargerRecordEqualityAndInequalityEmitScalarLeafComparisons.
public unsafe fn bool LargerRecordEqualityAndInequalityEmitScalarLeafComparisonsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-larger-record-equality-scalar-leaf",
        raw"""
module Demo

record Many(i32[min max] A, i32[min max] B, i32[min max] C, i32[min max] D, i32[min max] E)
{
}

unsafe fn bool Equal(Many left, Many right)
{
    return left == right;
}

unsafe fn bool NotEqual(Many left, Many right)
{
    return left != right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Equal(1, CountOccurrences(...)) on the definitions and
    // Assert.True(CountOccurrences(...) >= N) on the leaf-comparison instructions
    // are reduced to substring presence; the text helpers cannot count.
    return Contains(llvm, "define fastcc i1 @Equal(")
        && Contains(llvm, "define fastcc i1 @NotEqual(")
        && Contains(llvm, "icmp eq i32")
        && Contains(llvm, "icmp ne i32")
        && Contains(llvm, "and i1")
        && Contains(llvm, "or i1")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Equal")
        && DoesNotContain(llvm, "; LLVM body emission fallback for NotEqual");
}

// Ported from LlvmIrEmissionTests.LargerRecordOrderedComparisonsEmitScalarLeafLexicographicHelperCalls.
public unsafe fn bool LargerRecordOrderedComparisonsEmitScalarLeafLexicographicHelperCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-larger-record-ordered-lexicographic-helper",
        raw"""
module Demo

record Many(i32[min max] A, i32[min max] B, i32[min max] C, i32[min max] D, i32[min max] E)
{
}

unsafe fn bool Less(Many left, Many right)
{
    return left < right;
}

unsafe fn bool LessOrEqual(Many left, Many right)
{
    return left <= right;
}

unsafe fn bool Greater(Many left, Many right)
{
    return left > right;
}

unsafe fn bool GreaterOrEqual(Many left, Many right)
{
    return left >= right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.True(CountOccurrences(...) >= 5) on the slt/sgt leaf
    // comparisons reduced to substring presence; the text helpers cannot count.
    return Contains(llvm, "define internal dso_local i32 @__stark_named_compare_")
        && Contains(llvm, "call i32 @__stark_named_compare_")
        && Contains(llvm, "icmp slt i32")
        && Contains(llvm, "icmp sgt i32")
        && Contains(llvm, "icmp sle i32")
        && Contains(llvm, "icmp sge i32")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Less")
        && DoesNotContain(llvm, "; LLVM body emission fallback for LessOrEqual")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Greater")
        && DoesNotContain(llvm, "; LLVM body emission fallback for GreaterOrEqual");
}
