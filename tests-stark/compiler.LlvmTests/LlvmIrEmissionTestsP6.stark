// Ported from LlvmIrEmissionTests.StrictFpMultiplyAddExpressionsDoNotUseContractionIntrinsic.
public unsafe fn bool StrictFpMultiplyAddExpressionsDoNotUseContractionIntrinsicImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-strict-fp-no-fmuladd-contraction",
        raw"""
module Demo

strictfp fn f32 Accumulate(f32 acc, f32 left, f32 right)
{
    return acc + left * right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Matches over the SSA-numbered `%vN` constrained-fadd
    // operand reduced to substring fragments on the stable intrinsic+metadata.
    return Contains(llvm, "declare float @llvm.experimental.constrained.fmul.f32(float, float, metadata, metadata)")
        && Contains(llvm, "declare float @llvm.experimental.constrained.fadd.f32(float, float, metadata, metadata)")
        && Contains(llvm, "call float @llvm.experimental.constrained.fmul.f32(float %arg_left, float %arg_right, metadata !\"round.dynamic\", metadata !\"fpexcept.strict\") strictfp")
        && Contains(llvm, "call float @llvm.experimental.constrained.fadd.f32(float %arg_acc, float %")
        && Contains(llvm, "metadata !\"round.dynamic\", metadata !\"fpexcept.strict\") strictfp")
        && DoesNotContain(llvm, "@llvm.fmuladd.")
        && DoesNotContain(llvm, "@llvm.fma.");
}

// Ported from LlvmIrEmissionTests.StrictFpConversionsUseConstrainedFloatingPointIntrinsics.
public unsafe fn bool StrictFpConversionsUseConstrainedFloatingPointIntrinsicsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-strict-fp-constrained-conversions",
        raw"""
module Demo

strictfp fn f64 Run(f32 small, f64 wide, i32[min max] integer)
{
    stack f64 promoted = (f64)small;
    stack f32 narrowed = (f32)wide;
    stack f64 fromInteger = (f64)integer;
    stack i32[min max] backToInteger = (i32[min max])narrowed;
    return promoted + fromInteger + backToInteger;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "call double @llvm.experimental.constrained.fpext.f64.f32(float %arg_small, metadata !\"fpexcept.strict\") strictfp")
        && Contains(llvm, "call float @llvm.experimental.constrained.fptrunc.f32.f64(double %arg_wide, metadata !\"round.dynamic\", metadata !\"fpexcept.strict\") strictfp")
        && Contains(llvm, "call double @llvm.experimental.constrained.sitofp.f64.i32(i32 %arg_integer, metadata !\"round.dynamic\", metadata !\"fpexcept.strict\") strictfp")
        && Contains(llvm, "call i32 @llvm.experimental.constrained.fptosi.i32.f32(float %v")
        && Contains(llvm, "metadata !\"fpexcept.strict\") strictfp")
        && DoesNotContain(llvm, "fpext fast")
        && DoesNotContain(llvm, "fptrunc fast");
}

