// Ported from LlvmIrEmissionTests.NestedConstObjectGraphsEmitConcreteConstantInitializers.
public unsafe fn bool NestedConstObjectGraphsEmitConcreteConstantInitializersImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-nested-const-object-graphs",
        raw"""
module Demo

struct Inner
{
    i32[min max] Value;
}

struct Outer
{
    Inner Item;
    ascii Label;
}

const Outer Graph = new Outer()
{
    Item = new Inner()
    {
        Value = 7
    },
    Label = "ok"
};

unsafe finite i32[min max] Run()
{
    return Graph.Item.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%stark_ascii = type { ptr, i64 }")
        && Contains(llvm, "%Inner = type { i32 }")
        && Contains(llvm, "%Outer = type { %Inner, %stark_ascii }")
        && Contains(llvm, "@Graph = local_unnamed_addr constant %Outer { %Inner { i32 7 }, %stark_ascii { ptr getelementptr inbounds nuw (")
        && Contains(llvm, "i64 2 } }");
}

// Ported from LlvmIrEmissionTests.NestedAggregateLiteralsFoldIntoFrozenGlobalInitializers.
public unsafe fn bool NestedAggregateLiteralsFoldIntoFrozenGlobalInitializersImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-nested-aggregate-literals-frozen",
        raw"""
module Demo

struct Inner
{
    i32[min max][2] Pair;
}

struct Outer
{
    Inner Node;
    i32[min max][3] View;
}

const Outer Frozen =
{
    Node =
    {
        Pair =
        {
            4, 7
        }
    },
    View =
    {
        1, 2, 3
    }
};

unsafe finite i32[min max] Run()
{
    return Frozen.Node.Pair[1] + Frozen.View[0];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%Inner = type { [2 x i32] }")
        && Contains(llvm, "%Outer = type { %Inner, [3 x i32] }")
        && Contains(llvm, "@Frozen = local_unnamed_addr constant %Outer { %Inner { [2 x i32] [i32 4, i32 7] }, [3 x i32] [i32 1, i32 2, i32 3] }");
}

// Ported from LlvmIrEmissionTests.MutableAggregateGlobalsEmitConcreteInitializersAndStores.
public unsafe fn bool MutableAggregateGlobalsEmitConcreteInitializersAndStoresImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-mutable-aggregate-globals-stores",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

static mut Pair Current = new Pair()
{
    Left = 5, Right = 8
};
static mut i32[min max][3] Values =
{
    1, 2, 3
};

unsafe finite i32[min max] Run()
{
    Current.Right = 9;
    Values[1] = 7;
    return Current.Right + Values[1];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%Pair = type { i32, i32 }")
        && Contains(llvm, "@Current = global %Pair { i32 5, i32 8 }")
        && Contains(llvm, "@Values = global [3 x i32] [i32 1, i32 2, i32 3]")
        && Contains(llvm, "getelementptr inbounds nuw %Pair, ptr @Current, i32 0, i32 1")
        && Contains(llvm, "store i32 9")
        && DoesNotContain(llvm, "store %Pair")
        && Contains(llvm, "ptr @Current")
        && Contains(llvm, "getelementptr inbounds nuw [3 x i32], ptr @Values, i32 0, i32 1")
        && Contains(llvm, "store i32 7")
        && Contains(llvm, "load i32")
        && DoesNotContain(llvm, "load [3 x i32]")
        && DoesNotContain(llvm, "store [3 x i32]")
        && Contains(llvm, "ptr @Values");
}

// Ported from LlvmIrEmissionTests.StaticGenericConstructorInitializersCanForwardAggregateArguments.
public unsafe fn bool StaticGenericConstructorInitializersCanForwardAggregateArgumentsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-static-generic-ctor-forward-aggregate",
        raw"""
module Demo

struct Counter
{
    i32[min max] Value;
}

struct Box<T>
{
    T Value;

    Box(T initial)
    {
        self.Value = initial;
    }
}

static mut Box<Counter> Current = new Box<Counter>(new Counter()
{
    Value = 42
});

unsafe finite i32[min max] Run()
{
    return Current.Value.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%Counter = type { i32 }")
        && Contains(llvm, "@Current = global %Box_Counter_ { %Counter { i32 42 } }");
}

