}

// Ported from LlvmIrEmissionTests.InternalizedImmutableGlobalsUseUnnamedAddrOnlyWhenAddressesStayInsignificant.
public unsafe fn bool InternalizedImmutableGlobalsUseUnnamedAddrOnlyWhenAddressesStayInsignificantImpl()
{
    // PORT-NOTE: C# passed CompilerOptions(QualifyModuleSymbols: true); the
    // Stark helper has no options surface, so the `@Demo_*` qualified-symbol
    // assertions run against the default pipeline output.
    stack mut LlvmCompile c = CompileLlvm(
        "p3-internalized-immutable-globals-unnamed-addr",
        raw"""
module Demo

static i32[min max] Hidden = 1;
static i32[min max] Exposed = 2;

unsafe fn rawptr<i32[min max]> ExposedPtr()
{
    return &Exposed;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "@Demo_Hidden = internal unnamed_addr constant i32 1")
        && Contains(llvm, "@Demo_Exposed = internal constant i32 2")
        && DoesNotContain(llvm, "@Demo_Exposed = internal unnamed_addr constant i32 2")
        && DoesNotContain(llvm, "@Demo_Exposed = internal local_unnamed_addr constant i32 2")
        && Contains(llvm, "ret ptr @Demo_Exposed");
}

// Ported from LlvmIrEmissionTests.AggregateAndArrayGlobalsEmitConcreteInitializers.
public unsafe fn bool AggregateAndArrayGlobalsEmitConcreteInitializersImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-aggregate-array-globals-initializers",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

const Pair Origin = new Pair()
{
    Left = 1, Right = 2
};
static i32[min max][3] Values =
{
    4, 7, 9
};

unsafe finite i32[min max] Run()
{
    return Origin.Right + Values[1];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%Pair = type { i32, i32 }")
        && Contains(llvm, "@Origin = local_unnamed_addr constant %Pair { i32 1, i32 2 }")
        && Contains(llvm, "@Values = local_unnamed_addr constant [3 x i32] [i32 4, i32 7, i32 9]");
}

// Ported from LlvmIrEmissionTests.IntegralAndScientificFloatConstantsEmitValidHexFloatLiterals.
public unsafe fn bool IntegralAndScientificFloatConstantsEmitValidHexFloatLiteralsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-integral-scientific-float-hex-literals",
        raw"""
module Demo

const f64[23] Pow10 =
{
    1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22
};

unsafe finite f64 ScalarScientific()
{
    return 1e17;
}

unsafe finite f64 Run()
{
    return Pow10[17] + ScalarScientific();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the final `Assert.False(Regex.IsMatch(...))` guarding against
    // any surviving bare-integer / bare-scientific `double`/`float` literal is a
    // negative regex with no text-helper equivalent; reduced to positive hex
    // float substring checks plus a DoesNotContain on the canonical bug forms.
    return Contains(llvm, "@Pow10 = local_unnamed_addr constant [23 x double] [double 0x3FF0000000000000, double 0x4024000000000000")
        && Contains(llvm, "double 0x4376345785D8A000")
        && Contains(llvm, "double 0x4480F0CF064DD592")
        && Contains(llvm, "ret double 0x4376345785D8A000")
        && DoesNotContain(llvm, "double 1E+17")
        && DoesNotContain(llvm, "double 1,");
}

// Ported from LlvmIrEmissionTests.GlobalsAndUnicodeStringConstantsEmitConcreteAlignment.
public unsafe fn bool GlobalsAndUnicodeStringConstantsEmitConcreteAlignmentImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-globals-unicode-alignment",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

static mut i32[min max] Counter = 0;
const Pair Origin = new Pair()
{
    Left = 1, Right = 2
};
const i32[min max][3] Values =
{
    4, 7, 9
};

unsafe finite law unicode Greek()
{
    return (unicode)"\u03B1";
}

unsafe finite i32[min max] Run()
{
    return Counter + Origin.Right + Values[1];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "@Counter = global i32 0, align 4")
        && Contains(llvm, "@Origin = local_unnamed_addr constant %Pair { i32 1, i32 2 }, align 4")
        && Contains(llvm, "@Values = local_unnamed_addr constant [3 x i32] [i32 4, i32 7, i32 9], align 4")
        && Contains(llvm, "private unnamed_addr constant [2 x i32] [i32 945, i32 0], align 4");
}

