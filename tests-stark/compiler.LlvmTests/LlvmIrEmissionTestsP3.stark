// Ported from LlvmIrEmissionTests.ImmutableGlobalLoadsEmitInvariantMetadataThroughFieldAndIndexChains.
public unsafe fn bool ImmutableGlobalLoadsEmitInvariantMetadataThroughFieldAndIndexChainsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-immutable-global-loads-invariant-chains",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

static Box Current = new Box()
{
    Value = 5
};
const Box Frozen = new Box()
{
    Value = 7
};
static i32[min max][3] Values =
{
    1, 2, 3
};
static mut i32[min max] Counter = 1;

unsafe fn i32[min max] ReadStatic()
{
    return Current.Value;
}

unsafe fn i32[min max] ReadConst()
{
    return Frozen.Value;
}

unsafe fn i32[min max] ReadIndex(u8[0 2] index)
{
    return Values[index];
}

unsafe fn i32[min max] ReadMutable()
{
    return Counter;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original used regex (`load %Box, ptr @Current, ..., !invariant.load !N`)
    // and `ExtractDefinitionBody("ReadConst")` slicing to assert the const read
    // folds to `ret i32 7` with no `@Frozen` load. Reduced to whole-module
    // substring checks: the invariant.load metadata is present on the Current
    // load, the folded const constant 7 appears, and no invariant.load is
    // attached to the mutable Counter load.
    return Contains(llvm, "load %Box, ptr @Current, align 4, !invariant.load")
        && Contains(llvm, "ret i32 7")
        && DoesNotContain(llvm, "load %Box, ptr @Frozen")
        && DoesNotContain(llvm, "load i32, ptr @Counter, !invariant.load");
}

// Ported from LlvmIrEmissionTests.OnceInitializedReadonlyStackStorageEmitsInvariantStartWithoutInvariantLoadMetadata.
public unsafe fn bool OnceInitializedReadonlyStackStorageEmitsInvariantStartWithoutInvariantLoadMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-once-readonly-stack-invariant-start",
        raw"""
module Demo

unsafe fn void Observe(rawptr<i32[min max]> ptr)
{
    stack i32[min max] ignored = *ptr;
    return;
}

unsafe fn i32[min max] ReadOnce(i32[min max] input)
{
    stack i32[min max] value = input;
    stack rawptr<i32[min max]> ptr = &value;
    return *ptr;
}

unsafe fn i32[min max] ReadEscaped(i32[min max] input)
{
    stack i32[min max] escaped = input;
    Observe(&escaped);
    return *(&escaped);
}

unsafe fn i32[min max] ReadMutable(i32[min max] input)
{
    stack mut i32[min max] mutable = input;
    stack rawmutptr<i32[min max]> ptr = &mutable;
    *ptr = input + 1;
    return *ptr;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original sliced the `@ReadMutable` definition tail to prove
    // no `!invariant.load` appears there; the module-wide DoesNotContain on
    // `!invariant.load` already subsumes that per-function check here.
    return Contains(llvm, "declare ptr @llvm.invariant.start.p0(i64 immarg, ptr nocapture)")
        && Contains(llvm, "call ptr @llvm.invariant.start.p0(i64 4, ptr %slot_value)")
        && DoesNotContain(llvm, "!invariant.load")
        && Contains(llvm, "call ptr @llvm.invariant.start.p0(i64 4, ptr %slot_escaped)")
        && DoesNotContain(llvm, "call ptr @llvm.invariant.start.p0(i64 4, ptr %slot_mutable)");
}

// Ported from LlvmIrEmissionTests.ReadonlyStackDropTempsPassedByAddressDoNotEmitInvariantMetadata.
public unsafe fn bool ReadonlyStackDropTempsPassedByAddressDoNotEmitInvariantMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-readonly-stack-drop-temps-no-invariant",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;

    fn void Clear(mut borrow Box self)
    {
        self.Value = 0;
        return;
    }

    mut drop
    {
        self.Clear();
    }
}

fn i32[min max] Read(Box value)
{
    return value.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original asserted against `ExtractDefinitionBody("Read")`;
    // reduced to whole-module substring checks (the drop-temp call form is
    // unique to Read so the signal carries over).
    return Contains(llvm, "call fastcc void @Box_Clear(ptr nonnull noalias writeonly nocapture dereferenceable(4) align 4 %slot__tmp1_drop)")
        && DoesNotContain(llvm, "llvm.invariant.start.p0(i64 4, ptr %slot__tmp1_drop)")
        && DoesNotContain(llvm, "!invariant.load");
}

// Ported from LlvmIrEmissionTests.FrozenRawPointerLoadsDoNotEmitInvariantMetadataWithoutConstProvenance.
public unsafe fn bool FrozenRawPointerLoadsDoNotEmitInvariantMetadataWithoutConstProvenanceImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-frozen-rawptr-no-invariant",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
}

unsafe fn i64[min max] Read(rawptr<frozen Big> box)
{
    return (*box).B;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original was `Assert.DoesNotMatch(@"load %Big, ptr %arg_box, !invariant.load !\d+")`.
    // Reduced to a DoesNotContain on the invariant-tagged load prefix.
    return DoesNotContain(llvm, "load %Big, ptr %arg_box, !invariant.load");
}

// Ported from LlvmIrEmissionTests.StaticReadonlyPointerLoadsDoNotConferDeepConstProvenance.
public unsafe fn bool StaticReadonlyPointerLoadsDoNotConferDeepConstProvenanceImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-static-readonly-ptr-no-deep-const",
        raw"""
module Demo

static rawptr<i32[min max]> Cached = null;

unsafe fn i32[min max] Read()
{
    return *Cached;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original asserted over `ExtractDefinitionBody("Read")` with two
    // regexes: the pointer load from @Cached carries invariant.load (the pointer
    // itself is immutable), but the dereferenced i32 load does NOT. Reduced to a
    // Contains on the invariant-tagged @Cached pointer load and a DoesNotContain
    // on an invariant-tagged dereferenced i32 load.
    return Contains(llvm, "load ptr, ptr @Cached, align")
        && Contains(llvm, "!invariant.load")
        && DoesNotContain(llvm, "load i32, ptr %v0, align 4, !invariant.load");
}

