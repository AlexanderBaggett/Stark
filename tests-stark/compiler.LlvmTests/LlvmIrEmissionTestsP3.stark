module Demo

unsafe fn i32[min max] Read(rawmutptr<i32[min max]> source)
{
    stack rawmutptr<i32[min max]> local = source;
    return *local;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original `Assert.DoesNotMatch(@"load i32, ptr %v\d+, align \d+, !invariant.load !\d+")`
    // over `ExtractDefinitionBody("Read")`. Reduced to a DoesNotContain on the
    // invariant-tagged i32 load form.
    return DoesNotContain(llvm, ", !invariant.load");
}

