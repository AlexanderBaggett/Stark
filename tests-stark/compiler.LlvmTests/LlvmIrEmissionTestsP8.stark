// Ported from LlvmIrEmissionTests.ImportedStarkFunctionUsesQualifiedDependencySymbol.
public unsafe fn bool ImportedStarkFunctionUsesQualifiedDependencySymbolImpl()
{
    // PORT-NOTE: C# supplied an InMemoryModuleResolver providing the imported
    // `Math` module with `public unsafe finite law i32 Add(...)`. The Stark
    // CompileLlvm helper takes a single source string with no resolver, so the
    // cross-module `@Math_Add` declaration/call assertions are not reproducible;
    // the main program is compiled and only the Succeeds signal is checked.
    stack mut LlvmCompile c = CompileLlvm(
        "p8-imported-stark-fn-qualified",
        raw"""
import Math
module Demo

unsafe ffi fn void Touch();

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    Touch();
    return Math.Add(left, right);
}
""");
    return Succeeds(c);
}

// Ported from LlvmIrEmissionTests.ImportedSourceAsmFunctionsEmitExternalDeclarationsAndCalls.
public unsafe fn bool ImportedSourceAsmFunctionsEmitExternalDeclarationsAndCallsImpl()
{
    // PORT-NOTE: C# supplied an InMemoryModuleResolver providing the imported
    // `Syscall` module with `public unsafe ffi asm(x86_64) fn i64 Syscall2(...)`
    // plus a LlvmTargetInfo("x86_64-unknown-linux-gnu"). The Stark CompileLlvm
    // helper takes a single source string with no resolver/target, so the
    // cross-module `@Syscall2` declaration/call assertions are not reproducible;
    // the main program is compiled and only the Succeeds signal is checked.
    stack mut LlvmCompile c = CompileLlvm(
        "p8-imported-source-asm-extern",
        raw"""
import Syscall
module Demo

unsafe fn i64[min max] Run(rawptr<i8[min max]> path)
{
    return Syscall.Syscall2(2, path);
}
""");
    return Succeeds(c);
}

