        "p8-fixedarray-param-direct-abi",
        raw"""
module Demo

unsafe fn i32[min max] Read(i32[min max][2] values)
{
    return values[0] + values[1];
}

unsafe fn i32[min max] Run()
{
    stack i32[min max][2] values =
    {
        4, 7
    };
    return Read(values);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i32 @Read([2 x i32] %arg_values)")
        && Contains(llvm, "extractvalue [2 x i32] %arg_values, 0")
        && Contains(llvm, "extractvalue [2 x i32] %arg_values, 1")
        && Contains(llvm, "call fastcc i32 @Read([2 x i32]");
}

