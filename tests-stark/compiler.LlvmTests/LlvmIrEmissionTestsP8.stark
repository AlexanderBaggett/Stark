// Ported from LlvmIrEmissionTests.FixedArrayDynamicIndexEmitsGepFlagsOnlyWhenRangeProvesObjectBounds.
public unsafe fn bool FixedArrayDynamicIndexEmitsGepFlagsOnlyWhenRangeProvesObjectBoundsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-fixedarray-gep-flags-range-proof",
        raw"""
module Demo

unsafe fn i32[min max] Bounded(u8[0 2] index)
{
    stack i32[min max][3] values =
    {
        1, 2, 3
    };
    return values[index];
}

unsafe fn i32[min max] Unbounded(i32[min max] index)
{
    stack i32[min max][3] values =
    {
        1, 2, 3
    };
    return values[index];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the two GEP Assert.Matches regexes are reduced to their literal
    // forms, and Assert.Single (exactly one bounded GEP) is reduced to presence.
    return Contains(llvm, "getelementptr inbounds nuw [3 x i32], ptr %slot_values, i32 0, i8 %arg_index")
        && Contains(llvm, "getelementptr [3 x i32], ptr %slot_values, i32 0, i32 %arg_index")
        && DoesNotContain(llvm, "getelementptr inbounds [3 x i32], ptr %v");
}

