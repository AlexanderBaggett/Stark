// Ported from LlvmIrEmissionTests.FixedArrayBackedSliceAndKnownTextSliceCarryProvenGepFlags.
public unsafe fn bool FixedArrayBackedSliceAndKnownTextSliceCarryProvenGepFlagsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-fixedarray-slice-text-gep-flags",
        raw"""
module Demo

unsafe fn i32[min max] ReadView(i32[min max][3] values, u8[0 2] index)
{
    stack i32[min max][3] local = values;
    stack i32[min max][] view = local;
    return view[index];
}

unsafe fn ascii SliceLiteral(u8[0 4] start, u8[0 4] length)
{
    return "abcd"[start, length];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the two `%vN`/`%vN_data` Assert.Matches GEP regexes are reduced
    // to the literal inbounds-nuw GEP prefixes they require.
    return Contains(llvm, "getelementptr inbounds nuw i32, ptr")
        && Contains(llvm, "ptr getelementptr inbounds nuw ([5 x i8], ptr @.str.0, i32 0, i32 0)")
        && Contains(llvm, "getelementptr inbounds nuw i8, ptr");
}

// Ported from LlvmIrEmissionTests.PropagatedSliceAndTextLengthFactsCarryProvenGepFlags.
public unsafe fn bool PropagatedSliceAndTextLengthFactsCarryProvenGepFlagsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-propagated-slice-text-gep-flags",
        raw"""
module Demo

unsafe fn i32[min max] ReadJoinedSlice(bool flag, u8[0 1] index)
{
    stack i32[min max][3] left =
    {
        1, 2, 3
    };
    stack i32[min max][5] right =
    {
        4, 5, 6, 7, 8
    };
    stack mut i32[min max][] view = left;
    if (flag)
    {
        view = right;
    }

    return view[index];
}

unsafe fn ascii ResliceText(ascii source, u8[2 5] length, u8[0 2] start)
{
    stack ascii first = source[0, length];
    return first[start, 0];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the two `%vN_data` Assert.Matches GEP regexes are reduced to the
    // literal inbounds-nuw GEP prefixes they require.
    return Contains(llvm, "getelementptr inbounds nuw i32, ptr")
        && Contains(llvm, "getelementptr inbounds nuw i8, ptr");
}

// Ported from LlvmIrEmissionTests.FixedArrayParameterUsesDirectValueAbi.
public unsafe fn bool FixedArrayParameterUsesDirectValueAbiImpl()
{
