import LlvmTestSupport
import System.Testing
module LlvmIrEmissionTestsP8

// Ported slice (part 8) of tests/compiler.Tests/LlvmIrEmissionTests.cs. Each Impl
// compiles a small program through the host LLVM bridge, requests the rendered
// `llvm` artifact, and asserts on raw LLVM-IR substrings with the System.Testing
// Contains / DoesNotContain helpers. The embedded Stark programs are reproduced
// verbatim from the C# raw string literals. The original C# tests remain in
// tests/compiler.Tests as the oracle until cutover.
//
// PORT-NOTE conventions used below:
//  - Assert.Matches(regex) is reduced to the literal substring(s) the regex
//    requires; the variable `%vN` / `!N` parts are dropped.
//  - Assert.Single / Assert.Equal(N, CountOccurrences(...)) checks are reduced to
//    a presence (Contains) check; the count itself is not expressible.
//  - ExtractDefinitionHeader / ExtractDefinitionBody scoping is reduced to a
//    substring check against the whole module text.
//  - Tests that supplied an InMemoryModuleResolver / FileSystemModuleResolver for
//    an imported dependency module cannot be reproduced through the single-source
//    CompileLlvm helper; those are reduced to a Succeeds(...) signal on the main
//    program (the cross-module qualified-symbol assertions are not expressible).

// Ported from LlvmIrEmissionTests.LargeAggregateLocalForwardReturnKeepsDirectCallInSRetBuffer.
public unsafe fn bool LargeAggregateLocalForwardReturnKeepsDirectCallInSRetBufferImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-large-agg-local-forward-sret",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
    i64[min max] E;
}

unsafe fn Big Make()
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    return new Big()
    {
        A = acc, B = acc + 1, C = acc + 2, D = acc + 3, E = acc + 4
    };
}

unsafe fn Big Forward()
{
    stack Big value = Make();
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original DoesNotContain checks were scoped to the Forward
    // body via a regex; they are matched against the whole module text here.
    return Contains(llvm, "define fastcc void @Forward(ptr noalias sret(%Big) nonnull dereferenceable(40) align 8 %ret)")
        && Contains(llvm, "call fastcc void @Make(ptr noalias sret(%Big) nonnull dereferenceable(40) align 8 %ret)")
        && DoesNotContain(llvm, "%abi_callret_slot_")
        && DoesNotContain(llvm, "call void @llvm.memcpy.inline.p0.p0.i64(ptr align 8 %ret")
        && DoesNotContain(llvm, "load %Big, ptr %abi_callret_slot_")
        && DoesNotContain(llvm, "store %Big");
}

// Ported from LlvmIrEmissionTests.LargeAggregateReturnOfIndirectParameterSkipsEntryLoad.
public unsafe fn bool LargeAggregateReturnOfIndirectParameterSkipsEntryLoadImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-large-agg-return-indirect-param",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

unsafe fn Big Forward(Big value)
{
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the memcpy Assert.Matches regex (optional `align N`) is reduced
    // to the canonical aligned-pointer form the renderer emits.
    return Contains(llvm, "define fastcc void @Forward(ptr noalias sret(%Big) nonnull dereferenceable(32) align 8 %ret, ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %arg_value)")
        && Contains(llvm, "call void @llvm.memcpy.inline.p0.p0.i64(ptr align 8 %ret, ptr align 8 %arg_value, i64 32, i1 false)")
        && DoesNotContain(llvm, "load %Big, ptr %arg_value")
        && DoesNotContain(llvm, "%abi_arg_value_value")
        && DoesNotContain(llvm, "store %Big");
}

// Ported from LlvmIrEmissionTests.LargeAggregateIndirectParameterForwardingUsesOriginalPointer.
public unsafe fn bool LargeAggregateIndirectParameterForwardingUsesOriginalPointerImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-large-agg-indirect-forward-ptr",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

unsafe fn Big Step(Big value)
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    if (acc < -4000000000000000000)
    {
        return new Big()
        {
            A = value.A + acc, B = value.B, C = value.C, D = value.D
        };
    }

    return value;
}

unsafe fn Big Forward(Big value)
{
    return Step(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original DoesNotContain checks were scoped to the Forward
    // body via a regex; they are matched against the whole module text here.
    return Contains(llvm, "define fastcc void @Forward(ptr noalias sret(%Big) nonnull dereferenceable(32) align 8 %ret, ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %arg_value)")
        && Contains(llvm, "call fastcc void @Step(ptr noalias sret(%Big) nonnull dereferenceable(32) align 8 %ret")
        && Contains(llvm, "ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %arg_value")
        && DoesNotContain(llvm, "%abi_callret_slot_")
        && DoesNotContain(llvm, "load %Big, ptr %abi_callret_slot_");
}

// Ported from LlvmIrEmissionTests.LargeAggregateParametersUseByValueIndirectAbi.
public unsafe fn bool LargeAggregateParametersUseByValueIndirectAbiImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-large-agg-param-byval-indirect",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
}

unsafe fn i64[min max] Read(Big value)
{
    stack i64[min max] a = value.A + (value.C / 3);
    stack i64[min max] b = a - (a / 5);
    stack i64[min max] c = b + (b / 7);
    stack i64[min max] d = c - (c / 11);
    stack i64[min max] e = d + (d / 13);
    stack i64[min max] f = e - (e / 17);
    stack i64[min max] g = f + (f / 19);
    stack i64[min max] h = g - (g / 23);
    stack i64[min max] i = h + (h / 29);
    stack i64[min max] j = i - (i / 31);
    stack i64[min max] k = j + (j / 37);
    stack i64[min max] l = k - (k / 41);
    stack i64[min max] m = l + (l / 43);
    return m;
}

unsafe fn i64[min max] Run()
{
    return Read(new Big()
    {
        A = 1, B = 2, C = 3
    });
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i64 @Read(")
        && Contains(llvm, "ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(24) align 8 %arg_value")
        && Contains(llvm, "memory(argmem: read)")
        && Contains(llvm, "call fastcc i64 @Read(ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(24) align 8")
        && DoesNotContain(llvm, "define fastcc i64 @Read(%Big");
}

// Ported from LlvmIrEmissionTests.AggregateCallReturnRegressionBenchmarkKeepsSmallAggregatesOnDirectAbi.
public unsafe fn bool AggregateCallReturnRegressionBenchmarkKeepsSmallAggregatesOnDirectAbiImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-small-agg-direct-abi",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

unsafe fn Pair Step(Pair value, i32[min max] delta)
{
    stack i32[min max] a = value.Left + (delta / 3);
    stack i32[min max] b = a - (a / 5);
    stack i32[min max] c = b + (b / 7);
    stack i32[min max] d = c - (c / 11);
    stack i32[min max] e = d + (d / 13);
    stack i32[min max] f = e - (e / 17);
    stack i32[min max] g = f + (f / 19);
    stack i32[min max] h = g - (g / 23);
    stack i32[min max] i = h + (h / 29);
    stack i32[min max] j = i - (i / 31);
    stack i32[min max] k = j + (j / 37);
    stack i32[min max] l = k - (k / 41);
    stack i32[min max] m = l + (l / 43);
    return new Pair()
    {
        Left = m,
        Right = value.Right + delta
    };
}

unsafe fn i32[min max] Run()
{
    stack Pair current = Step(
        Step(
            Step(new Pair()
            {
                Left = 1, Right = 2
            },
            1),
            1),
        1);
    return current.Left + current.Right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc %Pair @Step(%Pair %arg_value, i32 %arg_delta)")
        && Contains(llvm, "call fastcc %Pair @Step(%Pair")
        && DoesNotContain(llvm, "sret(%Pair)")
        && DoesNotContain(llvm, "byval(%Pair)");
}

// Ported from LlvmIrEmissionTests.AggregateCallReturnRegressionBenchmarkKeepsLargeAggregatesOnIndirectAbi.
public unsafe fn bool AggregateCallReturnRegressionBenchmarkKeepsLargeAggregatesOnIndirectAbiImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-large-agg-indirect-abi",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

unsafe fn Big Step(Big value, i64[min max] delta)
{
    stack i64[min max] a = value.A + (delta / 3);
    stack i64[min max] b = a - (a / 5);
    stack i64[min max] c = b + (b / 7);
    stack i64[min max] d = c - (c / 11);
    stack i64[min max] e = d + (d / 13);
    stack i64[min max] f = e - (e / 17);
    stack i64[min max] g = f + (f / 19);
    stack i64[min max] h = g - (g / 23);
    stack i64[min max] i = h + (h / 29);
    stack i64[min max] j = i - (i / 31);
    stack i64[min max] k = j + (j / 37);
    stack i64[min max] l = k - (k / 41);
    stack i64[min max] m = l + (l / 43);
    return new Big()
    {
        A = m,
        B = value.B + delta,
        C = value.C + delta,
        D = value.D + delta
    };
}

unsafe fn i64[min max] Run()
{
    stack Big current = Step(
        Step(
            new Big()
            {
                A = 1, B = 2, C = 3, D = 4
            },
            1),
        1);
    return current.A + current.D;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @Step(ptr noalias sret(%Big) nonnull dereferenceable(32) align 8 %ret, ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %arg_value, i64 %arg_delta)")
        && Contains(llvm, "call fastcc void @Step(ptr noalias sret(%Big)")
        && Contains(llvm, "ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8")
        && DoesNotContain(llvm, "define fastcc %Big @Step(");
}

// Ported from LlvmIrEmissionTests.AggregateBranchJoinEmitsByValuePhiNode.
public unsafe fn bool AggregateBranchJoinEmitsByValuePhiNodeImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-agg-branch-join-phi",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Run(bool flag)
{
    stack mut Box box = new Box()
    {
        Value = 0
    };
    if (flag)
    {
        box = new Box()
        {
            Value = 1
        };
    }
    else
    {
        box = new Box()
        {
            Value = 2
        };
    }

    return box.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "phi %Box")
        && Contains(llvm, "extractvalue %Box")
        && DoesNotContain(llvm, "load %Box, ptr %slot_box");
}

// Ported from LlvmIrEmissionTests.ValueReceiverMethodsLowerToDirectAggregateCalls.
public unsafe fn bool ValueReceiverMethodsLowerToDirectAggregateCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-value-receiver-direct-agg",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;

    unsafe fn i32[min max] Read(Box box)
    {
        stack i32[min max] a = box.Value + (box.Value / 3);
        stack i32[min max] b = a - (a / 5);
        stack i32[min max] c = b + (b / 7);
        stack i32[min max] d = c - (c / 11);
        stack i32[min max] e = d + (d / 13);
        stack i32[min max] f = e - (e / 17);
        stack i32[min max] g = f + (f / 19);
        stack i32[min max] h = g - (g / 23);
        stack i32[min max] i = h + (h / 29);
        stack i32[min max] j = i - (i / 31);
        stack i32[min max] k = j + (j / 37);
        stack i32[min max] l = k - (k / 41);
        stack i32[min max] m = l + (l / 43);
        return m;
    }
}

unsafe fn i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 7
    };
    return box.Read();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i32 @Box_Read(%Box %arg_box)")
        && Contains(llvm, "extractvalue %Box %arg_box, 0")
        && Contains(llvm, "call fastcc i32 @Box_Read(%Box")
        && DoesNotContain(llvm, "load %Box, ptr %arg_box");
}

// Ported from LlvmIrEmissionTests.BorrowReceiverMethodsLowerToPointerReceiverCalls.
public unsafe fn bool BorrowReceiverMethodsLowerToPointerReceiverCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-borrow-receiver-ptr-calls",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;

    unsafe fn i32[min max] Read(borrow Box box)
    {
        return box.Value;
    }
}

unsafe fn i32[min max] Run(borrow Box box)
{
    return box.Read();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i32 @Box_Read(ptr nonnull noalias readonly nocapture dereferenceable(4) align 4 %arg_box)")
        && Contains(llvm, "define fastcc i32 @Run(ptr nonnull noalias readonly nocapture dereferenceable(4) align 4 %arg_box)")
        && Contains(llvm, "call fastcc i32 @Box_Read(ptr nonnull")
        && DoesNotContain(llvm, "tail call fastcc i32 @Box_Read");
}

// Ported from LlvmIrEmissionTests.IndexedFieldAddressBehindRawPointerEmitsDirectParameterGeps.
public unsafe fn bool IndexedFieldAddressBehindRawPointerEmitsDirectParameterGepsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-indexed-field-rawptr-geps",
        raw"""
module Demo

struct Buffer
{
    i8[min max][16] Storage;
    i64[min max] WritePos;
}

unsafe fn i32[min max] Touch(rawmutptr<Buffer> buffer, i64[min max] index, i8[min max] value)
{
    *(&(*buffer).Storage[index]) = value;
    return (i32[min max])*(&(*buffer).Storage[index]);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc range(i32 -128, 128) i32 @Touch(ptr nocapture %arg_buffer, i64 %arg_index, i8 %arg_value)")
        && Contains(llvm, "getelementptr inbounds nuw %Buffer, ptr %arg_buffer, i32 0, i32 0")
        && Contains(llvm, "getelementptr [16 x i8], ptr")
        && DoesNotContain(llvm, "getelementptr inbounds [16 x i8], ptr")
        && DoesNotContain(llvm, "getelementptr inbounds nuw [16 x i8], ptr")
        && DoesNotContain(llvm, "alloca %Buffer");
}

// Ported from LlvmIrEmissionTests.IndexedRawPointerElementsEmitDirectParameterGeps.
public unsafe fn bool IndexedRawPointerElementsEmitDirectParameterGepsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-indexed-rawptr-element-geps",
        raw"""
module Demo

unsafe fn i32[min max] Touch(rawmutptr<i8[min max]> data, i64[min max] index, i8[min max] value)
{
    *(&data[index]) = value;
    return (i32[min max])*(&data[index]);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc range(i32 -128, 128) i32 @Touch(ptr nocapture %arg_data, i64 %arg_index, i8 %arg_value)")
        && Contains(llvm, "getelementptr i8, ptr %arg_data, i64 %arg_index")
        && DoesNotContain(llvm, "getelementptr inbounds i8, ptr %arg_data, i64 %arg_index")
        && DoesNotContain(llvm, "alloca ptr");
}

// Ported from LlvmIrEmissionTests.BorrowReceiverIndexedFieldAddressesEmitDirectReceiverGeps.
public unsafe fn bool BorrowReceiverIndexedFieldAddressesEmitDirectReceiverGepsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-borrow-receiver-indexed-geps",
        raw"""
module Demo

struct Buffer
{
    i8[min max][16] Storage;

    unsafe fn void Put(borrow mut Buffer self, i64[min max] index, i8[min max] value)
    {
        *(&self.Storage[index]) = value;
        return;
    }

    unsafe fn i32[min max] Read(borrow Buffer self, i64[min max] index)
    {
        return (i32[min max])*(&self.Storage[index]);
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @Buffer_Put(ptr nonnull noalias nocapture dereferenceable(16) %arg_self, i64 %arg_index, i8 %arg_value)")
        && Contains(llvm, "define fastcc range(i32 -128, 128) i32 @Buffer_Read(ptr nonnull noalias readonly nocapture dereferenceable(16) %arg_self, i64 %arg_index)")
        && Contains(llvm, "getelementptr inbounds nuw %Buffer, ptr %arg_self, i32 0, i32 0")
        && Contains(llvm, "getelementptr [16 x i8], ptr %v")
        && DoesNotContain(llvm, "alloca %Buffer");
}

// Ported from LlvmIrEmissionTests.MutableBorrowedAggregateWriterEmitsWriteOnlyNoCaptureParameterFacts.
public unsafe fn bool MutableBorrowedAggregateWriterEmitsWriteOnlyNoCaptureParameterFactsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-mut-borrow-writeonly-nocapture",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn void Touch(borrow mut Box box)
{
    box.Value = 7;
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @Touch(ptr nonnull noalias writeonly nocapture dereferenceable(4) align 4 %arg_box)")
        && DoesNotContain(llvm, "define fastcc void @Touch(ptr nonnull noalias readonly");
