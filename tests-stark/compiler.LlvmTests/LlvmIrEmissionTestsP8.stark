// Ported from LlvmIrEmissionTests.MutableBorrowReturnedSliceWritesDoNotEmitReadonlyParameterFacts.
public unsafe fn bool MutableBorrowReturnedSliceWritesDoNotEmitReadonlyParameterFactsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-mut-borrow-slice-no-readonly",
        raw"""
module Demo

struct Buffer
{
    i8[min max][8] Storage;

    unsafe fn retborrow mut i8[min max][] View(borrow mut Buffer self)
    {
        unsafe
        {
            return slice(&self.Storage[0], 8);
        }
    }
}

unsafe fn void Touch(borrow mut Buffer buffer)
{
    buffer.View()[0] = 7;
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original used GetLlvmRaw + ExtractDefinitionHeader(llvm, "Touch")
    // to scope the DoesNotContain("readonly") to the Touch header. The
    // header-scoped check is reduced to a whole-module check that the Touch
    // writeonly parameter form is present and no readonly Touch parameter form is.
    return Contains(llvm, "store i8 7")
        && DoesNotContain(llvm, "@Touch(ptr nonnull noalias readonly");
}

