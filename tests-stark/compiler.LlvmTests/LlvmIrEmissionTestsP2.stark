import LlvmTestSupport
import System.Testing
module LlvmIrEmissionTestsP2

// Ported from LlvmIrEmissionTests.DirectCallsWithLargeByValueCurrentParameterUseByvalParameterPointer.
public unsafe fn bool DirectCallsWithLargeByValueCurrentParameterUseByvalParameterPointerImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-direct-call-large-byval-parameter",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

unsafe fn i64[min max] Read(Big value)
{
    stack i64[min max] a = value.A + (value.D / 3);
    stack i64[min max] b = a - (a / 5);
    stack i64[min max] c = b + (b / 7);
    stack i64[min max] d = c - (c / 11);
    stack i64[min max] e = d + (d / 13);
    stack i64[min max] f = e - (e / 17);
    stack i64[min max] g = f + (f / 19);
    stack i64[min max] h = g - (g / 23);
    stack i64[min max] i = h + (h / 29);
    stack i64[min max] j = i - (i / 31);
    stack i64[min max] k = j + (j / 37);
    stack i64[min max] l = k - (k / 41);
    stack i64[min max] m = l + (l / 43);
    return m;
}

unsafe fn i64[min max] Forward(Big value)
{
    return Read(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original scoped checks to the Forward header/body via ExtractDefinitionHeader/Body
    // and a regex over the call site; the helper exposes only the whole module text, so the
    // header/body fragments and the (de-parameterized) call fragment are matched against `llvm`.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Forward")
        && Contains(llvm, "define fastcc noundef i64 @Forward(ptr noundef nonnull byval(%Big)")
        && Contains(llvm, "memory(argmem: read)")
        && DoesNotContain(llvm, "memory(readwrite")
        && Contains(llvm, "call fastcc i64 @Read(ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %arg_value)")
        && DoesNotContain(llvm, "%abi_callarg_value")
        && DoesNotContain(llvm, "load %Big");
}

// Ported from LlvmIrEmissionTests.DynamicStorageAllocationIndexInitAndDropEmitRuntimeAllocatorCalls.
public unsafe fn bool DynamicStorageAllocationIndexInitAndDropEmitRuntimeAllocatorCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-alloc-index-init-drop",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u32[0 2 ** 31 - 1] values = new(4);
    init values[0] = 7;
    return values.Capacity;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original sliced the Run signature with a regex for the
    // memory()/nofree/nosync attribute checks; the helper matches those fragments
    // against the whole module text instead.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "@__stark_runtime_alloc")
        && Contains(llvm, "@__stark_runtime_free")
        && Contains(llvm, "insertvalue { ptr, i64, i64 }")
        && Contains(llvm, "extractvalue { ptr, i64, i64 }")
        && Contains(llvm, "getelementptr")
        && Contains(llvm, "i32 1")
        && Contains(llvm, "store i64")
        && Contains(llvm, "memory(readwrite");
}

// Ported from LlvmIrEmissionTests.DynamicStorageDropEmitsElementDestructorLoopBeforeFree.
public unsafe fn bool DynamicStorageDropEmitsElementDestructorLoopBeforeFreeImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-drop-destructor-loop",
        raw"""
module Demo

static mut i32[min max] Counter = 0;

unsafe fn void Bump(i32[min max] value)
{
    stack i32[min max] a = value + (value / 3);
    stack i32[min max] b = a - (a / 5);
    stack i32[min max] c = b + (b / 7);
    stack i32[min max] d = c - (c / 11);
    stack i32[min max] e = d + (d / 13);
    stack i32[min max] f = e - (e / 17);
    stack i32[min max] g = f + (f / 19);
    stack i32[min max] h = g - (g / 23);
    stack i32[min max] i = h + (h / 29);
    stack i32[min max] j = i - (i / 31);
    stack i32[min max] k = j + (j / 37);
    stack i32[min max] l = k - (k / 41);
    stack i32[min max] m = l + (l / 43);
    Counter = Counter + m;
    return;
}

struct Token
{
    i32[min max] Value;

    drop
    {
        Bump(self.Value);
    }
}

unsafe fn void Run()
{
    stack mut dynamic Token values = new(2);
    init values[0] = new Token()
    {
        Value = 1
    };
    init values[1] = new Token()
    {
        Value = 2
    };
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original checked the destructor call precedes the free within the
    // Run body via IndexOf ordering; the helper cannot express ordering or body
    // scoping, so both fragments are required to be present.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "call fastcc void @Bump")
        && Contains(llvm, "@__stark_runtime_free");
}

// Ported from LlvmIrEmissionTests.DynamicStorageElementLoadsAndStoresCarryElementAlignment.
public unsafe fn bool DynamicStorageElementLoadsAndStoresCarryElementAlignmentImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-element-alignment",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u64[0 2 ** 63 - 1] values = new(2);
    init values[0] = 7;
    init values[1] = 11;
    return values[1];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original used regexes over the Run body to count aligned 8-byte
    // stores/loads with %v-numbered operands; the helper matches the stable
    // alignment-carrying fragments against the whole module text.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "store i64")
        && Contains(llvm, "align 8")
        && Contains(llvm, "load i64, ptr");
}

