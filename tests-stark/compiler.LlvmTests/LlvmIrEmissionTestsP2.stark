        "llvm-large-dynamic-move-last-into-sret",
        raw"""
module Demo

struct Big
{
    i8[min max][512] Data;
    i64[min max] Len;
}

unsafe fn Big Run()
{
    stack mut dynamic Big values = new(1);
    init values[0] = new Big()
