// Ported from LlvmIrEmissionTests.UnsafeDynamicStorageNonTailMoveEmitsDirectElementLoad.
public unsafe fn bool UnsafeDynamicStorageNonTailMoveEmitsDirectElementLoadImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-unsafe-dynamic-non-tail-move-direct-load",
        raw"""
module Demo

struct Token
{
    u64[0 2 ** 63 - 1] Value;
}

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic Token values = new(2);
    init values[0] = new Token()
    {
        Value = 10
    };
    init values[1] = new Token()
    {
        Value = 20
    };
    unsafe
    {
        stack Token moved = values[0];
        return moved.Value;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the runBody-scoped checks are matched against the whole module text
    // since the helper does not expose per-function bodies.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && DoesNotContain(llvm, "dynamic_move_is_empty")
        && DoesNotContain(llvm, "dynamic_move_new_length")
        && Contains(llvm, "getelementptr")
        && Contains(llvm, "load %Token");
}

// Ported from LlvmIrEmissionTests.AggregateLoadedFromDynamicSlotKeepsSnapshotAfterSlotReplacement.
public unsafe fn bool AggregateLoadedFromDynamicSlotKeepsSnapshotAfterSlotReplacementImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-aggregate-snapshot-after-slot-replacement",
        raw"""
module Demo

enum Slot
{
    Empty,
    Full(u32[0 2 ** 31 - 1]),
}

unsafe fn u32[0 2 ** 31 - 1] Run()
{
    stack mut dynamic Slot slots = new(1);
    init slots[0] = Slot.Full(7);
    unsafe
    {
        stack Slot snapshot = slots[0];
        slots[0] = Slot.Empty;
        switch (snapshot)
        {
            case Slot.Full(var value):
                return value;
            case Slot.Empty:
                return 0;
        }
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original regex-captured the `load %Slot` SSA name and required both
    // extractvalue uses to reference that exact value; the helper cannot capture SSA
    // names, so the stable load and de-numbered extractvalue fragments are matched
    // against the whole module text.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "load %Slot, ptr")
        && Contains(llvm, "extractvalue %Slot")
        && Contains(llvm, ", 0")
        && Contains(llvm, ", 1");
}

// Ported from LlvmIrEmissionTests.NonCapturingLambdaFunctionPointersEmitSyntheticFunctionDefinitions.
public unsafe fn bool NonCapturingLambdaFunctionPointersEmitSyntheticFunctionDefinitionsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-non-capturing-lambda-synthetic-definitions",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] seed)
{
    stack fnptr<fn i32[min max](i32[min max])> increment = (i32[min max] value) =>
    {
        stack i32[min max] a = value + (value / 3);
        stack i32[min max] b = a - (a / 5);
        stack i32[min max] c = b + (b / 7);
        stack i32[min max] d = c - (c / 11);
        stack i32[min max] e = d + (d / 13);
        stack i32[min max] f = e - (e / 17);
        stack i32[min max] g = f + (f / 19);
        stack i32[min max] h = g - (g / 23);
        stack i32[min max] i = h + (h / 29);
        stack i32[min max] j = i - (i / 31);
        stack i32[min max] k = j + (j / 37);
        stack i32[min max] l = k - (k / 41);
        stack i32[min max] m = l + (l / 43);
        return m;
    };
    return increment(seed);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "; synthetic definition: Run.__lambda_")
        && Contains(llvm, "define internal dso_local fastcc noundef i32 @Run___lambda_")
        && Contains(llvm, "call fastcc i32 @Run___lambda_");
}

// Ported from LlvmIrEmissionTests.DebugMetadataIsEmittedForFunctionsParametersAndStackLocals.
public unsafe fn bool DebugMetadataIsEmittedForFunctionsParametersAndStackLocalsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-debug-metadata-functions-parameters-locals",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] input)
{
    stack mut i32[min max] value = input;
    stack rawmutptr<i32[min max]> ptr = &value;
    *ptr = input + 1;
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original compiled with an explicit "/virtual/Demo.stark" source path;
    // the helper does not take a source path, so the path-independent debug-metadata
    // fragments are matched against the whole module text.
    return Contains(llvm, "declare void @llvm.dbg.declare(metadata, metadata, metadata)")
        && Contains(llvm, "declare void @llvm.dbg.value(metadata, metadata, metadata)")
        && Contains(llvm, "!llvm.dbg.cu = !{!")
        && Contains(llvm, "distinct !DICompileUnit(")
        && Contains(llvm, "distinct !DISubprogram(name: \"Run\", linkageName: \"Run\"")
        && Contains(llvm, "!DILocalVariable(name: \"input\", arg: 1")
        && Contains(llvm, "!DILocalVariable(name: \"value\"")
        && Contains(llvm, "call void @llvm.dbg.value(metadata i32 %arg_input, metadata !")
        && Contains(llvm, "call void @llvm.dbg.declare(metadata ptr %slot_value, metadata !")
        && Contains(llvm, "!DILocation(line: 5, column:")
        && Contains(llvm, ", !dbg !");
}

