// Ported from LlvmIrEmissionTests.DynamicStorageMoveAtEmitsDirectLengthUpdateLoadAndMemmove.
public unsafe fn bool DynamicStorageMoveAtEmitsDirectLengthUpdateLoadAndMemmoveImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-move-at-direct-length-load-memmove",
        raw"""
module Demo

unsafe fn i64[min max] Run(u8[0 5] index)
{
    stack mut dynamic i64[min max] values = new(3);
    init values[0] = 10;
    init values[1] = 20;
    init values[2] = 30;
    stack i64[min max] moved = values.MoveAt(index);
    return moved + values[0] + values.Length;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original asserted at least two `getelementptr inbounds nuw i64` via
    // Regex.Matches().Count over the Run body; the helper checks the stable fragment
    // is present in the whole module text.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "dynamic_move_at_in_bounds")
        && Contains(llvm, "dynamic_move_at_new_length")
        && Contains(llvm, "getelementptr inbounds nuw i64")
        && Contains(llvm, "call void @llvm.memmove.p0.p0.i64")
        && DoesNotContain(llvm, "llvm.memcpy")
        && Contains(llvm, "store { ptr, i64, i64 }");
}

