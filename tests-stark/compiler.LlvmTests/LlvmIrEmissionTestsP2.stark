// Ported from LlvmIrEmissionTests.IfWeightAnnotationEmitsBranchWeightMetadata.
public unsafe fn bool IfWeightAnnotationEmitsBranchWeightMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-if-weight-branch-weight-metadata",
        raw"""
module Demo

unsafe finite law i32[min max] Run(bool flag)
{
    stack mut i32[min max] value = 0;
    if w99 (flag)
    {
        value = 1;
    }
    else
    {
        value = 2;
    }

    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original used regexes with `%bb<n>`/`!<n>` numbered labels; the helper
    // matches the stable, de-numbered prefixes and the exact branch_weights tuple
    // against the whole module text.
    return Contains(llvm, "br i1 %arg_flag, label %bb")
        && Contains(llvm, ", !prof !")
        && Contains(llvm, "= !{!\"branch_weights\", i32 99, i32 1}");
}

// Ported from LlvmIrEmissionTests.SwitchWeightAnnotationEmitsDistributedBranchWeightMetadata.
public unsafe fn bool SwitchWeightAnnotationEmitsDistributedBranchWeightMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-switch-weight-distributed-branch-weight-metadata",
        raw"""
module Demo

unsafe finite law i32[min max] Pick(u8[0 5] value)
{
    switch w75 (value)
    {
        case 0:
            return 10;
        case 1:
            return 11;
        case 2:
            return 12;
        case 3:
            return 13;
        case 4:
            return 14;
        default:
            return 99;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original used regexes with `%bb<n>`/`!<n>` numbered labels; the helper
    // matches the stable switch prefix, the !prof attachment, and the exact
    // distributed branch_weights tuple against the whole module text.
    return Contains(llvm, "switch i8 %arg_value, label %bb")
        && Contains(llvm, ", !prof !")
        && Contains(llvm, "= !{!\"branch_weights\", i32 25, i32 15, i32 15, i32 15, i32 15, i32 15}");
}

// Ported from LlvmIrEmissionTests.ColdCallBranchTargetsInferUnlikelyBranchWeightMetadata.
public unsafe fn bool ColdCallBranchTargetsInferUnlikelyBranchWeightMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-cold-call-branch-unlikely-weight-metadata",
        raw"""
module Demo

cold noinline unsafe fn i32[min max] Slow(i32[min max] value)
{
    return value + 1;
}

unsafe finite law i32[min max] Run(bool fail, i32[min max] value)
{
    if (fail)
    {
        return Slow(value);
    }

    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original used regexes with `%bb<n>`/`!<n>` numbered labels; the helper
    // matches the stable branch prefix, the !prof attachment, and the exact unlikely
    // branch_weights tuple against the whole module text.
    return Contains(llvm, "br i1 %arg_fail, label %bb")
        && Contains(llvm, ", !prof !")
        && Contains(llvm, "= !{!\"branch_weights\", i32 1, i32 2000}");
}

// Ported from LlvmIrEmissionTests.GlobalsUseVisibilityAwareLinkageAndConstantKinds.
public unsafe fn bool GlobalsUseVisibilityAwareLinkageAndConstantKindsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-globals-visibility-aware-linkage",
        raw"""
module Globals

public const Answer = 42;
internal static rawptr<i8[min max]> Buffer = null;
export static mut rawptr<i8[min max]> Visible = null;

unsafe finite law i32[min max] Run()
{
    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "; visibility: public")
        && Contains(llvm, "@Answer = local_unnamed_addr constant i8 42")
        && Contains(llvm, "; visibility: internal")
        && Contains(llvm, "@Buffer = local_unnamed_addr constant ptr null")
        && Contains(llvm, "; visibility: export")
        && Contains(llvm, "@Visible = global ptr null");
}
