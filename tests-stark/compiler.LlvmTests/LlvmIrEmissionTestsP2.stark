// Ported from LlvmIrEmissionTests.LargeDynamicStorageMoveLastIntoLocalUsesDestinationSlot.
public unsafe fn bool LargeDynamicStorageMoveLastIntoLocalUsesDestinationSlotImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-large-dynamic-move-last-into-local",
        raw"""
module Demo

struct Big
{
    i8[min max][512] Data;
    i64[min max] Len;
}

unsafe fn i64[min max] Run()
{
    stack mut dynamic Big values = new(1);
    init values[0] = new Big()
    {
        Len = 7
    };
    stack Big moved = values.MoveLast();
    return moved.Len;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original matched the memcpy with a `%abi_dynamic_move_element_ptr_<n>`
    // numbered operand via regex over the Run body; the helper matches the stable,
    // de-numbered memcpy prefix and destination/size against the whole module text.
    return Contains(llvm, "%slot_moved = alloca %Big")
        && Contains(llvm, "call void @llvm.memcpy.p0.p0.i64(ptr align 8 %slot_moved, ptr align 8 %abi_dynamic_move_element_ptr_")
        && DoesNotContain(llvm, "%abi_dynamic_move_result_slot_")
        && DoesNotContain(llvm, "load %Big")
        && DoesNotContain(llvm, "store %Big")
        && DoesNotContain(llvm, "phi %Big");
}

