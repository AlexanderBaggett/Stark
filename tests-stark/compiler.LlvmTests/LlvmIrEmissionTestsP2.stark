    // over the Run body; the helper matches the stable, de-numbered memcpy prefix
    // against the whole module text.
    return Contains(llvm, "define fastcc void @Run(ptr noundef noalias sret(%Big) nonnull dereferenceable(520) align 8 %ret)")
        && Contains(llvm, "call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret, ptr align 8 %abi_dynamic_move_element_ptr_")
        && DoesNotContain(llvm, "%abi_dynamic_move_result_slot_")
        && DoesNotContain(llvm, "load %Big")
        && DoesNotContain(llvm, "store %Big")
        && DoesNotContain(llvm, "phi %Big");
}

// Ported from LlvmIrEmissionTests.LargeDynamicStorageMoveAtReturnCopiesBeforeTailShift.
public unsafe fn bool LargeDynamicStorageMoveAtReturnCopiesBeforeTailShiftImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-large-dynamic-move-at-return-before-tail-shift",
        raw"""
module Demo

struct Big
{
    i8[min max][512] Data;
    i64[min max] Len;
}

unsafe fn Big Run()
{
    stack mut dynamic Big values = new(2);
    init values[0] = new Big()
    {
        Len = 7
    };
    init values[1] = new Big()
    {
        Len = 9
    };
    return values.MoveAt(0);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original required the element-copy memcpy (numbered operand) to
    // precede the tail-shift memmove via IndexOf ordering over the Run body; the
    // helper cannot express ordering, so both the de-numbered copy prefix and the
    // memmove are required to be present.
    return Contains(llvm, "call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret, ptr align 8 %abi_dynamic_move_at_element_ptr_")
        && Contains(llvm, "call void @llvm.memmove.p0.p0.i64")
        && DoesNotContain(llvm, "%abi_dynamic_move_at_result_slot_")
        && DoesNotContain(llvm, "load %Big")
        && DoesNotContain(llvm, "store %Big")
        && DoesNotContain(llvm, "phi %Big");
}

