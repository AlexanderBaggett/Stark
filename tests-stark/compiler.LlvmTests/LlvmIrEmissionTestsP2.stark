// Ported from LlvmIrEmissionTests.DynamicStorageMoveLastEmitsDirectLengthUpdateAndLoad.
public unsafe fn bool DynamicStorageMoveLastEmitsDirectLengthUpdateAndLoadImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-move-last-direct-length-load",
        raw"""
module Demo

unsafe fn i64[min max] Run(bool drain)
{
    stack mut dynamic i64[min max] values = new(2);
    init values[0] = 10;
    init values[1] = 20;
    if (drain)
    {
        stack i64[min max] a = values.MoveLast();
        stack i64[min max] b = values.MoveLast();
    }
    stack i64[min max] moved = values.MoveLast();
    return moved + values.Length;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "dynamic_move_is_empty")
        && Contains(llvm, "dynamic_move_new_length")
        && Contains(llvm, "call void @llvm.trap()")
        && Contains(llvm, "getelementptr inbounds nuw i64")
        && Contains(llvm, "load i64")
        && Contains(llvm, "store { ptr, i64, i64 }");
}

