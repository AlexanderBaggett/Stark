// Ported from LlvmIrEmissionTests.DynamicStorageTryReserveEmitsDirectFallibleReallocatePath.
public unsafe fn bool DynamicStorageTryReserveEmitsDirectFallibleReallocatePathImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-try-reserve-realloc",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u32[0 2 ** 31 - 1] values = new(4);
    if (!values.TryReserve(8))
    {
        return 0;
    }

    return values.Capacity;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the runBody-scoped fragments are matched against the whole module
    // text since the helper does not expose per-function bodies.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "@__stark_runtime_try_realloc")
        && Contains(llvm, "define linkonce_odr hidden noalias noundef ptr @__stark_runtime_try_alloc")
        && Contains(llvm, "define linkonce_odr hidden i1 @__stark_dynamic_try_reserve")
        && Contains(llvm, "dynamic_try_reserve_needed")
        && Contains(llvm, "call ptr @__stark_runtime_try_realloc")
        && Contains(llvm, "phi i1")
        && Contains(llvm, "dynamic_try_reserve_failed");
}

// Ported from LlvmIrEmissionTests.OptimizedDynamicStorageTryReserveSuccessPrunesImpossibleCapacityBranch.
public unsafe fn bool OptimizedDynamicStorageTryReserveSuccessPrunesImpossibleCapacityBranchImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-try-reserve-prune-branch",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u32[0 2 ** 31 - 1] values = new(4);
    if (!values.TryReserve(8))
    {
        return 1;
    }

    if (values.Capacity < 8)
    {
        return 2;
    }

    return 3;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the runBody-scoped fragments are matched against the whole module
    // text since the helper does not expose per-function bodies.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "dynamic_try_reserve_done")
        && Contains(llvm, "ret i64 1")
        && DoesNotContain(llvm, "ret i64 2")
        && Contains(llvm, "ret i64 3");
}

