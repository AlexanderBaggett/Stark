// Ported from LlvmIrEmissionTests.DynamicStorageInitSliceWritesCommitOwnerLength.
public unsafe fn bool DynamicStorageInitSliceWritesCommitOwnerLengthImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-init-slice-commit-length",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u32[0 2 ** 31 - 1] values = new(4);
    stack init u32[0 2 ** 31 - 1][] spare = init values[values.Length, 2];
    init spare[0] = 7;
    init spare[1] = 8;
    return values.Length;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original asserted at least two `store i64 %v..., ptr %v...` writes in
    // the Run body via Regex.Matches().Count; the helper checks the stable store
    // fragment is present in the whole module text.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "store i64");
}

// Ported from LlvmIrEmissionTests.OptimizedDynamicStorageInitSlicePreservesPointerDefinitionAndAlignment.
public unsafe fn bool OptimizedDynamicStorageInitSlicePreservesPointerDefinitionAndAlignmentImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-init-slice-pointer-alignment",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u64[0 2 ** 63 - 1] values = new(4);
    stack init u64[0 2 ** 63 - 1][] spare = init values[values.Length, 2];
    init spare[0] = 7;
    return values.Length;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original regex-captured the slice pointer SSA name and asserted its
    // getelementptr definition precedes the insertvalue; the helper cannot capture
    // SSA names or express ordering, so the stable structural fragments are matched
    // against the whole module text.
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(llvm, "insertvalue { ptr, i64 } zeroinitializer, ptr")
        && Contains(llvm, "getelementptr inbounds nuw i64, ptr")
        && Contains(llvm, "store i64 7, ptr")
        && Contains(llvm, "align 8");
}

