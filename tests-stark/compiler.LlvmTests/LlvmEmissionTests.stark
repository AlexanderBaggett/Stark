unsafe fn u32[0 max] Add(u32[0 max] left, u32[0 max] right)
{
    return left + right;
}

unsafe fn u32[0 max] Sub(u32[0 max] left, u32[0 max] right)
{
    return left - right;
}

unsafe fn u32[0 max] Mul(u32[0 max] left, u32[0 max] right)
{
