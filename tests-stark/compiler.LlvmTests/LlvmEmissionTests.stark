// Ported from LoopHeaderEmitsBackedgePhi.
[Fact]
[Collection("control-flow")]
fn bool LoopHeaderEmitsBackedgePhi()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-loop-backedge-phi",
            raw"""
module Demo

unsafe fn i32[min max] Run()
{
    stack mut i32[min max] i = 0;
    while willexit (i < 4)
    {
        i = i + 1;
    }

    return i;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "phi i32")
            && Contains(llvm, "%bb2")
            && Contains(llvm, "icmp slt i32");
    }
}

// Ported from GuardedSwitchBodyEmitsCompareAndGuardBranches.
[Fact]
[Collection("control-flow", "patterns")]
fn bool GuardedSwitchBodyEmitsCompareAndGuardBranches()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-guarded-switch",
            raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] value, bool allow)
{
    switch (value)
    {
        case 1 when allow:
            return 1;
        default:
            return 2;
    }
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "@Run(i32")
            && Contains(llvm, "icmp eq i32")
            && Contains(llvm, "select i1 %arg_allow, i32 1, i32 2")
            && DoesNotContain(llvm, "declare fastcc i32 @Run(i32, i1)");
    }
}

// Ported from OrPatternLiteralSwitchPreservesNativeSwitchLowering.
[Fact]
[Collection("control-flow", "patterns")]
fn bool OrPatternLiteralSwitchPreservesNativeSwitchLowering()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-orpattern-native-switch",
            raw"""
module Demo

unsafe fn i32[min max] Run(u8[0 3] value)
{
    switch (value)
    {
        case 0 | 2:
            return 10;
        case 1 | 3:
            return 20;
    }
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "switch i8 %arg_value")
            && Contains(llvm, "i8 0, label")
            && Contains(llvm, "i8 1, label")
            && Contains(llvm, "i8 2, label")
            && Contains(llvm, "i8 3, label")
            && DoesNotContain(llvm, "declare fastcc i32 @Run(i8)");
    }
}

// Ported from RangePatternIntegerSwitchEmitsGuardedComparisons.
[Fact]
[Collection("control-flow", "patterns")]
fn bool RangePatternIntegerSwitchEmitsGuardedComparisons()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-range-pattern-int-switch",
            raw"""
module Demo

unsafe fn i32[min max] Run(u8[0 30] value)
{
    switch (value)
    {
        case 0..9:
            return 10;
        case 12..20:
            return 20;
        default:
            return 30;
    }
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return DoesNotContain(llvm, "switch i8 %arg_value")
            && Contains(llvm, "icmp ule i8 %arg_value, 9")
            && Contains(llvm, "icmp uge i8 %arg_value, 12")
            && DoesNotContain(llvm, "declare fastcc i32 @Run(i8)");
    }
}

// Ported from RangePatternEnumPayloadSwitchEmitsPayloadComparison.
[Fact]
[Collection("control-flow", "patterns")]
fn bool RangePatternEnumPayloadSwitchEmitsPayloadComparison()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-range-pattern-enum-switch",
            raw"""
module Demo

enum Token
{
    Number(i32[min max]),
    End,
}

unsafe fn i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.Number(0..9):
            return 1;
        case Token.Number(_):
            return 2;
        case Token.End:
            return 0;
    }
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "@Run(%Token")
            && Contains(llvm, "icmp eq i8")
            && Contains(llvm, "icmp sge i32")
            && Contains(llvm, "icmp sle i32")
            && DoesNotContain(llvm, "declare fastcc i32 @Run(%Token)");
    }
}

// Ported from OrPatternEnumCapturesShareBodyLocal.
[Fact]
[Collection("control-flow", "patterns")]
fn bool OrPatternEnumCapturesShareBodyLocal()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-orpattern-enum-capture",
