import LlvmTestSupport
import System.Testing
[Collection("compiler", "llvm")]
module LlvmEmissionTests

// Ported slice of tests/compiler.Tests LLVM IR emission tests, running against
// the current C# host compiler through the host test protocol. Each fact
// compiles a small source program, requests the rendered `llvm` artifact, and
// asserts on raw LLVM-IR substrings / structure with System.Testing text
// helpers. Requires STARK_HOST_COMPILER to point at the host compiler
// executable. The original C# tests remain in tests/compiler.Tests as the
// oracle until cutover.
//
// The host bridge renders the RAW optimized LLVM (no `noundef`-stripping or
// whitespace normalization), matching the C# `GetLlvmRaw`. Facts that the C#
// suite asserted over the whitespace-normalized `GetLlvm` text are re-expressed
// here over the equivalent raw body-instruction substrings.

// ---------------------------------------------------------------------------
// LlvmIrEmissionTests
// ---------------------------------------------------------------------------

// Ported from StraightLineFunctionEmitsOptimizedLlvmBody.
[Fact]
fn bool StraightLineFunctionEmitsOptimizedLlvmBody()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-straight-line",
            raw"""
module Demo

unsafe finite law i32[min max] Run()
{
    stack mut i32[min max] value = 1;
    value = value + 1;
    return value;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "define fastcc noundef i32 @Run()")
            && Contains(llvm, "ret i32 2")
            && DoesNotContain(llvm, "add i32")
            && DoesNotContain(llvm, "alloca i32")
            && DoesNotContain(llvm, "declare fastcc i32 @Run()");
    }
}

// Ported from FunctionPointerCallsEmitFastccIndirectCall. The long divide chain
// keeps Add above the inliner threshold so the call survives.
[Fact]
[Collection("closures")]
fn bool FunctionPointerCallsEmitFastccIndirectCall()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-fnptr-indirect-call",
            raw"""
module Demo

unsafe fn i32[min max] Add(i32[min max] left, i32[min max] right)
{
    stack i32[min max] a = left + (right / 3);
    stack i32[min max] b = a - (a / 5);
    stack i32[min max] c = b + (b / 7);
    stack i32[min max] d = c - (c / 11);
    stack i32[min max] e = d + (d / 13);
    stack i32[min max] f = e - (e / 17);
    stack i32[min max] g = f + (f / 19);
    stack i32[min max] h = g - (g / 23);
    stack i32[min max] i = h + (h / 29);
    stack i32[min max] j = i - (i / 31);
    stack i32[min max] k = j + (j / 37);
    stack i32[min max] l = k - (k / 41);
    stack i32[min max] m = l + (l / 43);
    return m;
}

unsafe fn i32[min max] Run()
{
    stack fnptr<unsafe fn i32[min max](i32[min max], i32[min max])> op = Add;
    return op(40, 2);
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "call fastcc i32 @Add(");
    }
}

// Ported from DynTraitObjectDispatchLoadsVtableSlotAndCallsIndirectly.
[Fact]
[Collection("traits")]
fn bool DynTraitObjectDispatchLoadsVtableSlotAndCallsIndirectly()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-dyn-trait-dispatch",
            raw"""
module Demo

dyn trait Speaker
{
    finite law i32[min max] Speak(borrow Self self);
}

struct Dog : Speaker
{
    i32[min max] Volume;

    finite law i32[min max] Speak(borrow Dog self)
    {
        return self.Volume;
    }
}

export fn i32[min max] Announce(borrow dyn Speaker speaker)
{
    return speaker.Speak();
}

export fn i32[min max] main()
{
    stack Dog d = new Dog() { Volume = 7 };
    stack borrow dyn Speaker s = d;
    return Announce(s);
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii announceBody = LlvmDefinitionBody(llvm, "Announce");
        return Contains(llvm, "@__stark_vtable_Dog__Speaker")
            && Contains(announceBody, "getelementptr ptr,")
            && Contains(announceBody, "load ptr,")
            && Contains(announceBody, "call fastcc i32 %")
            && Contains(announceBody, "nosync nofree");
    }
}

// Ported from NonCapturingClosureValuesLowerToInvokeAndEnvironmentPair. The
// closure crosses an export boundary so the devirtualizer cannot collapse the
// invoke-pointer call to a direct lambda call.
[Fact]
[Collection("closures")]
fn bool NonCapturingClosureValuesLowerToInvokeAndEnvironmentPair()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-noncapturing-closure-pair",
            raw"""
module Demo

export fn i32[min max] Apply(closure<finite law i32[min max](i32[min max])> op)
{
    stack i32[min max] r = op(41);
    stack i32[min max] a = r + (r / 3);
    stack i32[min max] b = a - (a / 5);
    stack i32[min max] c = b + (b / 7);
    stack i32[min max] d = c - (c / 11);
    stack i32[min max] e = d + (d / 13);
    stack i32[min max] f = e - (e / 17);
    stack i32[min max] g = f + (f / 19);
    stack i32[min max] h = g - (g / 23);
    stack i32[min max] i = h + (h / 29);
    stack i32[min max] j = i - (i / 31);
    stack i32[min max] k = j + (j / 37);
    stack i32[min max] l = k - (k / 41);
    stack i32[min max] m = l + (l / 43);
    return m;
}

fn i32[min max] Run()
{
    stack closure<finite law i32[min max](i32[min max])> op =
        (i32[min max] value) => value + 1;

    return Apply(op);
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii applyBody = LlvmDefinitionBody(llvm, "Apply");
        return Contains(llvm, "{ ptr @Run___lambda_")
            && Contains(llvm, "ptr null")
            && Contains(applyBody, "extractvalue { ptr, ptr }")
            && Contains(applyBody, "call fastcc i32 %")
            && Contains(applyBody, "willreturn")
            && Contains(applyBody, "mustprogress");
    }
}

// Ported from OptimizedFunctionItemClosurePromotionDevirtualizesAndPrunesAdapter.
[Fact]
[Collection("closures")]
fn bool OptimizedFunctionItemClosurePromotionDevirtualizesAndPrunesAdapter()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-closure-promotion-devirt",
            raw"""
module Demo

fn i32[min max] AddOne(i32[min max] value)
{
    return value + 1;
}

fn i32[min max] Apply(borrow closure<fn i32[min max](i32[min max])> op, i32[min max] value)
{
    return op(value);
}

fn i32[min max] Run()
{
    return Apply(AddOne, 41);
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        return Contains(runBody, "ret i32 42")
            && DoesNotContain(llvm, "closure_adapter")
            && DoesNotContain(runBody, "alloca { ptr, ptr }")
            && DoesNotContain(runBody, "extractvalue { ptr, ptr }")
            && DoesNotContain(runBody, "call fastcc");
    }
}

// Ported from SmallRangeUnsignedIntegerOperationsUseUnsignedLlvmOpcodes.
[Fact]
[Collection("integers")]
fn bool SmallRangeUnsignedIntegerOperationsUseUnsignedLlvmOpcodes()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-small-unsigned-opcodes",
            raw"""
module Demo

unsafe fn bool Less(u8[0 127] left, u8[0 127] right)
{
    return left < right;
}

unsafe fn u8[0 127] Divide(u8[0 127] left, u8[0 127] right)
{
    return left / right;
}

unsafe fn u8[0 127] Remainder(u8[0 127] left, u8[0 127] right)
{
    return left % right;
}

unsafe fn u8[0 127] ShiftDown(u8[0 127] left, u8[0 127] right)
{
    return left >> right;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "icmp ult i8")
            && Contains(llvm, "udiv i8")
            && Contains(llvm, "urem i8")
            && Contains(llvm, "lshr i8")
            && DoesNotContain(llvm, "icmp slt i8")
            && DoesNotContain(llvm, "sdiv i8")
            && DoesNotContain(llvm, "srem i8")
            && DoesNotContain(llvm, "ashr i8");
    }
}

// Ported from NonCapturingLambdaArgumentsLowerToFunctionPointers. The long body
// keeps Apply opaque so the lambda stays a function-pointer argument.
[Fact]
[Collection("closures")]
fn bool NonCapturingLambdaArgumentsLowerToFunctionPointers()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-lambda-arg-fnptr",
            raw"""
module Demo

unsafe fn i32[min max] Apply(fnptr<fn i32[min max](i32[min max])> op)
{
    stack i32[min max] r = op(41);
    stack i32[min max] a = r + (r / 3);
    stack i32[min max] b = a - (a / 5);
    stack i32[min max] c = b + (b / 7);
    stack i32[min max] d = c - (c / 11);
    stack i32[min max] e = d + (d / 13);
    stack i32[min max] f = e - (e / 17);
    stack i32[min max] g = f + (f / 19);
    stack i32[min max] h = g - (g / 23);
    stack i32[min max] i = h + (h / 29);
    stack i32[min max] j = i - (i / 31);
    stack i32[min max] k = j + (j / 37);
    stack i32[min max] l = k - (k / 41);
    stack i32[min max] m = l + (l / 43);
    return m;
}

unsafe fn i32[min max] Run()
{
    return Apply((i32[min max] value) => value + 1);
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "; synthetic definition: Run.__lambda_")
            && Contains(llvm, "call fastcc i32 @Apply(ptr nonnull @Run___lambda_");
    }
}

// Ported from GenericSizeofAndAlignofLowerAfterConcreteInstantiation.
[Fact]
[Collection("comptime")]
fn bool GenericSizeofAndAlignofLowerAfterConcreteInstantiation()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-generic-sizeof-alignof",
            raw"""
module Demo

unsafe fn i64[min max] Layout<T>(T value)
{
    return sizeof(T) + alignof(T);
}

unsafe fn i64[min max] Run()
{
    return Layout(1);
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
        return Contains(runBody, "ret i64 2")
            && DoesNotContain(llvm, "LLVM body emission fallback");
    }
}

