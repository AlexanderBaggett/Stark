module Demo

enum Token
{
    Left(i32[min max]),
    Right(i32[min max]),
    End,
}

unsafe fn i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.Left(var value) | Token.Right(var value):
            return value;
        case Token.End:
            return 0;
    }
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "@Run(%Token")
            && Contains(llvm, "icmp eq i8")
            && Contains(llvm, "ret i32")
            && DoesNotContain(llvm, "declare fastcc i32 @Run(%Token)");
    }
}

// Ported from ComparisonChainEmitsShortCircuitBranchesAndSingleSharedEvaluation.
// The C# Assert.Equal counts are re-expressed with CountOccurrences.
[Fact]
[Collection("control-flow")]
fn bool ComparisonChainEmitsShortCircuitBranchesAndSingleSharedEvaluation()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-comparison-chain",
            raw"""
module Demo

noinline unsafe fn i32[min max] Next()
{
    return 1;
}

unsafe fn bool Run()
{
    return 0 < Next() < 3;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return CountOccurrences(llvm, "call fastcc i32 @Next()") == 1
            && CountOccurrences(llvm, "icmp slt i32") == 2
            && Contains(llvm, "br i1")
            && DoesNotContain(llvm, "declare fastcc i1 @Run()");
    }
}

// Ported from FloatComparisonChainsUseOrderedPredicates.
[Fact]
[Collection("control-flow", "floats")]
fn bool FloatComparisonChainsUseOrderedPredicates()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-float-comparison-chain",
            raw"""
module Demo

unsafe fn bool Run(f32 low, f32 value, f32 high)
{
    return low < value <= high;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "fcmp fast olt float")
            && Contains(llvm, "fcmp fast ole float")
            && Contains(llvm, "br i1");
    }
}

// Ported from TextLiteralSwitchEmitsLengthAndByteComparisons.
[Fact]
[Collection("control-flow", "text")]
fn bool TextLiteralSwitchEmitsLengthAndByteComparisons()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-text-literal-switch",
            raw"""
module Demo

unsafe fn i32[min max] Run(ascii value, bool allow)
{
    switch (value)
    {
        case "ab":
            return 1;
        case "cd" when allow:
            return 2;
        default:
            return 3;
    }
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "extractvalue %stark_ascii %arg_value, 0")
            && Contains(llvm, "extractvalue %stark_ascii %arg_value, 1")
            && Contains(llvm, "icmp eq i64")
            && Contains(llvm, "load i8, ptr")
            && Contains(llvm, "select i1 %arg_allow")
            && DoesNotContain(llvm, "switch %stark_ascii")
            && DoesNotContain(llvm, "declare fastcc i32 @Run(%stark_ascii, i1)");
    }
}

// ---------------------------------------------------------------------------
// FFI
// ---------------------------------------------------------------------------

// Ported from HelloWorldStyleFfiPutsEmitsStringGlobalAndMainBody. The C#
// `define i32 @main()` header (over normalized text) is re-expressed as the raw
// `@main() nounwind` substring.
[Fact]
[Collection("ffi")]
fn bool HelloWorldStyleFfiPutsEmitsStringGlobalAndMainBody()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-ffi-puts-hello-world",
            raw"""
module Hello

unsafe ffi fn i32[min max] puts(ascii text);
export unsafe fn i32[min max] main()
{
    puts("Hello, world!\n");
    return 0;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "@.str.0 = private unnamed_addr constant")
            && Contains(llvm, "%stark_ascii = type { ptr, i64 }")
            && Contains(llvm, "declare i32 @puts(ptr readonly) nounwind")
            && Contains(llvm, "@main() nounwind")
            && Contains(llvm, "call i32 @puts(ptr getelementptr inbounds nuw ([15 x i8], ptr @.str.0, i32 0, i32 0))")
            && DoesNotContain(llvm, "invoke i32 @puts");
    }
}

// ---------------------------------------------------------------------------
// LlvmTextOrderedComparisonEmissionTests
// ---------------------------------------------------------------------------

// Ported from TextOrderedComparisonsEmitLexicographicHelperCalls.
[Fact]
[Collection("text")]
fn bool TextOrderedComparisonsEmitLexicographicHelperCalls()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-text-ordered-comparisons",
            raw"""
module Demo

unsafe fn bool LessAscii(ascii left, ascii right)
{
    return left < right;
}

unsafe fn bool GreaterOrEqualUnicode(unicode left, unicode right)
{
    return left >= right;
}

unsafe fn bool BoolLess(bool left, bool right)
{
    return left < right;
}

unsafe fn bool PointerLess(rawptr<i32[min max]> left, rawptr<i32[min max]> right)
{
    return left < right;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "define internal dso_local i32 @__stark_ascii_compare(%stark_ascii %left, %stark_ascii %right)")
            && Contains(llvm, "define internal dso_local i32 @__stark_unicode_compare(%stark_unicode %left, %stark_unicode %right)")
            && Contains(llvm, "call i32 @__stark_ascii_compare(%stark_ascii %arg_left, %stark_ascii %arg_right)")
            && Contains(llvm, "call i32 @__stark_unicode_compare(%stark_unicode %arg_left, %stark_unicode %arg_right)")
            && Contains(llvm, "icmp slt i32")
            && Contains(llvm, "icmp sge i32")
            && Contains(llvm, "icmp ult i1")
            && Contains(llvm, "icmp ult ptr")
            && DoesNotContain(llvm, "; LLVM body emission fallback for LessAscii")
            && DoesNotContain(llvm, "; LLVM body emission fallback for GreaterOrEqualUnicode")
            && DoesNotContain(llvm, "; LLVM body emission fallback for BoolLess")
            && DoesNotContain(llvm, "; LLVM body emission fallback for PointerLess");
    }
}
