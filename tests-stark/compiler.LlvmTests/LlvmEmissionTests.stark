// Ported from WrappingArithmeticEmitsConcreteLlvmInstructions.
[Fact]
[Collection("integers")]
fn bool WrappingArithmeticEmitsConcreteLlvmInstructions()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-wrapping-arith",
            raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    return -%left +% right *% 2 -% right;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "sub i32 0, %arg_left")
            && Contains(llvm, "mul i32")
            && Contains(llvm, "add i32")
            && DoesNotContain(llvm, "sub nsw")
            && DoesNotContain(llvm, "sub nuw")
            && DoesNotContain(llvm, "mul nsw")
            && DoesNotContain(llvm, "mul nuw")
            && DoesNotContain(llvm, "add nsw")
            && DoesNotContain(llvm, "add nuw");
    }
}

// Ported from SaturatingArithmeticEmitsWideClampSequence.
[Fact]
[Collection("integers")]
fn bool SaturatingArithmeticEmitsWideClampSequence()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-saturating-arith",
            raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    return left +| right *| 2 -| 1;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "sext i32")
            && Contains(llvm, "mul i64")
            && Contains(llvm, "add i64")
            && Contains(llvm, "sub i64")
            && Contains(llvm, "icmp sgt i64")
            && Contains(llvm, "icmp slt i64")
            && Contains(llvm, "select i1")
            && Contains(llvm, "trunc i64")
            && DoesNotContain(llvm, "add nsw i64")
            && DoesNotContain(llvm, "add nuw i64")
            && DoesNotContain(llvm, "sub nsw i64")
            && DoesNotContain(llvm, "mul nsw i64");
    }
}

// Ported from ExplicitWrappingAndSaturatingArithmeticStayFlagFreeEvenWhenOrdinaryProofsExist.
[Fact]
[Collection("integers")]
fn bool ExplicitWrappingAndSaturatingArithmeticStayFlagFree()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-explicit-arith-flag-free",
            raw"""
module Demo

unsafe fn i32[min max] Wrap(u8[0 10] left, u8[0 5] right)
{
    return left +% right *% 2 -% 1;
}

unsafe fn i32[min max] Sat(u8[0 10] left, u8[0 5] right)
{
    return left +| right *| 2 -| 1;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "mul i8")
            && Contains(llvm, "add i8")
            && Contains(llvm, "sub i8")
            && Contains(llvm, "mul i16")
            && Contains(llvm, "add i16")
            && Contains(llvm, "sub i16")
            && DoesNotContain(llvm, "nuw")
            && DoesNotContain(llvm, "nsw")
            && DoesNotContain(llvm, "exact");
    }
}

// Ported from ExplicitIntegerArithmeticConstantsFoldBeforeLlvmEmission. The
// final Assert.Equal(2, ...) count is re-expressed with CountOccurrences.
[Fact]
[Collection("integers")]
fn bool ExplicitIntegerArithmeticConstantsFoldBeforeLlvmEmission()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-explicit-arith-const-fold",
            raw"""
module Demo

unsafe fn i32[min max] Wrap()
{
    return 2147483647 +% 1;
}

unsafe fn i32[min max] SatAdd()
{
    return 2147483647 +| 1;
}

unsafe fn i32[min max] SatMul()
{
    return 1073741824 *| 4;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "@Wrap()")
            && Contains(llvm, "ret i32 -2147483648")
            && Contains(llvm, "@SatAdd()")
            && Contains(llvm, "@SatMul()")
            && CountOccurrences(llvm, "ret i32 2147483647") == 2;
    }
}

// Ported from FloatLiteralArgumentsEmitValidHexFloatConstants.
[Fact]
[Collection("floats")]
fn bool FloatLiteralArgumentsEmitValidHexFloatConstants()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-float-hex-constants",
            raw"""
module Demo

noinline unsafe fn f64 Echo(f64 value)
{
    return value;
}

unsafe fn i32[min max] Run()
{
    if (Echo(0.0) != 0.0)
    {
        return 1;
    }

    if (Echo(3.0) != 3.0)
    {
        return 2;
    }

    return 0;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "call fast fastcc double @Echo(double 0x0000000000000000)")
            && Contains(llvm, "fcmp fast one double %")
            && Contains(llvm, ", 0x0000000000000000")
            && Contains(llvm, "call fast fastcc double @Echo(double 0x4008000000000000)")
            && Contains(llvm, ", 0x4008000000000000")
            && DoesNotContain(llvm, "call fast fastcc double @Echo(double 0)")
            && DoesNotContain(llvm, "call fast fastcc double @Echo(double 3)")
            && DoesNotContain(llvm, "double 3.0");
    }
}

