    End,
}

unsafe fn i32[min max] Run(Token token)
{
    switch (token)
    {
        case Token.Left(var value) | Token.Right(var value):
            return value;
        case Token.End:
            return 0;
    }
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "@Run(%Token")
            && Contains(llvm, "icmp eq i8")
            && Contains(llvm, "ret i32")
            && DoesNotContain(llvm, "declare fastcc i32 @Run(%Token)");
    }
}

// Ported from ComparisonChainEmitsShortCircuitBranchesAndSingleSharedEvaluation.
// The C# Assert.Equal counts are re-expressed with CountOccurrences.
[Fact]
[Collection("control-flow")]
fn bool ComparisonChainEmitsShortCircuitBranchesAndSingleSharedEvaluation()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-comparison-chain",
            raw"""
module Demo

noinline unsafe fn i32[min max] Next()
{
    return 1;
}

unsafe fn bool Run()
{
    return 0 < Next() < 3;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return CountOccurrences(llvm, "call fastcc i32 @Next()") == 1
            && CountOccurrences(llvm, "icmp slt i32") == 2
            && Contains(llvm, "br i1")
            && DoesNotContain(llvm, "declare fastcc i1 @Run()");
    }
}

