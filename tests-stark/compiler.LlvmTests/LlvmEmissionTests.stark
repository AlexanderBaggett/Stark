// Ported from BitwiseXorEmitsConcreteLlvmXorInstruction (header re-expressed
// over the raw `@Run(` symbol form; the C# version asserted the
// whitespace-normalized header).
[Fact]
[Collection("integers")]
fn bool BitwiseXorEmitsConcreteLlvmXorInstruction()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-bitwise-xor",
            raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    return left ^ right;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "@Run(i32 noundef %arg_left, i32 noundef %arg_right)")
            && Contains(llvm, "xor i32");
    }
}

// Ported from BitwiseAndShiftExpressionsEmitConcreteLlvmInstructions.
[Fact]
[Collection("integers")]
fn bool BitwiseAndShiftExpressionsEmitConcreteLlvmInstructions()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-bitwise-shift",
            raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] middle, i32[min max] right, i32[min max] mask)
{
    return left | middle ^ right & mask << 1 >> 1;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "shl i32")
            && Contains(llvm, "ashr exact i32")
            && Contains(llvm, "and i32")
            && Contains(llvm, "xor i32")
            && Contains(llvm, "or i32");
    }
}

// Ported from IntegerAndBoolUnaryOperatorsEmitConcreteLlvmInstructions.
[Fact]
[Collection("integers")]
fn bool IntegerAndBoolUnaryOperatorsEmitConcreteLlvmInstructions()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-unary-operators",
            raw"""
module Demo

unsafe fn i32[min max] Negate(i32[min max] value)
{
    return -value;
}

unsafe fn bool LogicalNot(bool value)
{
    return !value;
}

unsafe fn i32[min max] BitwiseNot(i32[min max] value)
{
    return ~value;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "sub i32 0, %arg_value")
            && Contains(llvm, "xor i1 %arg_value, true")
            && Contains(llvm, "xor i32 %arg_value, -1")
            && DoesNotContain(llvm, "; LLVM body emission fallback");
    }
}

// Ported from OrdinaryIntegerArithmeticEmitsSignedNoWrapFlags.
[Fact]
[Collection("integers")]
fn bool OrdinaryIntegerArithmeticEmitsSignedNoWrapFlags()
{
    unsafe
    {
        stack mut LlvmCompile compiled = CompileLlvm(
            "llvm-arith-nsw",
            raw"""
module Demo

unsafe fn i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

unsafe fn i32[min max] Sub(i32[min max] left, i32[min max] right)
{
    return left - right;
}

unsafe fn i32[min max] Mul(i32[min max] left, i32[min max] right)
{
    return left * right;
}
""");
        if (!Succeeds(compiled))
        {
            return false;
        }

        stack ascii llvm = Llvm(compiled);
        return Contains(llvm, "add nsw i32")
            && Contains(llvm, "sub nsw i32")
            && Contains(llvm, "mul nsw i32")
            && DoesNotContain(llvm, "add nuw")
            && DoesNotContain(llvm, "sub nuw")
            && DoesNotContain(llvm, "mul nuw");
    }
}

// Ported from UnconstrainedUnsignedOrdinaryArithmeticEmitsUnsignedNoWrapByContract.
