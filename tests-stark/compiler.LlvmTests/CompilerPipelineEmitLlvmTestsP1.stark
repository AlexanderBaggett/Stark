// Ported from CompilerPipelineEmitLlvmTests.ManifestBackedMemberCallForwarderGenericsUseOptimizationSummaryForPlanningAndCodegen.
public unsafe fn bool ManifestBackedMemberCallForwarderGenericsUseOptimizationSummaryForPlanningAndCodegenImpl()
{
    // PORT-NOTE: original drops FunctionSemantics and proves the member-call
    // forwarder specialization is planned InlineSmallBody and emitted with
    // alwaysinline from the OptimizationSummary. Manifest surgery / import
    // staging / plan inspection are out of reach; this compiles the library
    // module and asserts Succeeds.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-manifest-member-forwarder-generic",
        raw"""
module Facade

public record Box(i32[min max] Value)
{
    fn i32[min max] Bump(borrow Box self, i32[min max] delta)
    {
        return self.Value + delta;
    }
}

public fn i32[min max] Forward<T>(borrow Box box, i32[min max] delta, T tag)
{
    return box.Bump(delta);
}
""");
    return Succeeds(c);
}

