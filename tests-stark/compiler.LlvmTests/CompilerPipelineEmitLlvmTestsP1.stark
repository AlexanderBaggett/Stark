    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-manifest-generic-region-facts",
        raw"""
module Facade

public unsafe fn i32[min max] CopyFirst<T>(
    rawmutptr<i32[min max]> left,
    rawmutptr<i32[min max]> right,
