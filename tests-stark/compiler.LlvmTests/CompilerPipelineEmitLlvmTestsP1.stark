public unsafe fn bool ManifestBackedImportedGenericSpecializationsPreserveRegionFactsWithoutSourceBodiesImpl()
{
    // PORT-NOTE: original strips source bodies from the manifest and proves the
    // imported specialization preserves noalias region facts (alias.scope /
    // noalias metadata). Source-body stripping and import staging are out of
