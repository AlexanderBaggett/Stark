import LlvmTestSupport
import System.Testing
module CompilerPipelineEmitLlvmTestsP1

// Ported slice of tests/compiler.PipelineTests/CompilerPipelineEmitLlvmTests.cs,
// running against the current C# host compiler through the host test protocol.
// Each Impl compiles a source program, requests the rendered `llvm` artifact,
// and asserts on raw LLVM-IR substrings with System.Testing text helpers.
//
// PORT-NOTE (applies to every manifest/package-backed case below): the C#
// oracle stages a library compile, builds a `.starkpkg`/`.a` package image,
// rewrites manifest sections (dropping FunctionSemantics, corrupting template
// bodies, stripping source bodies, etc.), deletes the source, and re-runs the
// consumer through a FileSystemModuleResolver while inspecting
// MonomorphizationPlan / LoadedModuleSet / PackageImageFacts artifacts. The
// host LLVM bridge only exposes a single-source compile and the rendered `llvm`
// text, so those manifest-surgery and non-LLVM-artifact assertions cannot be
// reproduced. These ports compile the closest expressible program (the embedded
// consumer or library source) and assert over the LLVM text where possible,
// otherwise reduce to Succeeds(...).

// Ported from CompilerPipelineEmitLlvmTests.SourceBackedImportedInlineFunctionsEmitInternalLlvmBodyClones.
public unsafe fn bool SourceBackedImportedInlineFunctionsEmitInternalLlvmBodyClonesImpl()
{
    // PORT-NOTE: original imports a sibling `Lib.stark` resolved from disk; the
    // host bridge compiles a single source, so the inline `SelectOrAdd` body is
    // folded into the same module here. Clone-symbol / ABI-call assertions are
    // reduced to Succeeds because the imported-inline clone path requires the
    // FileSystemModuleResolver staging the C# test performs.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-source-imported-inline-body-clone",
        raw"""
module Lib

export inline fn u8[0 102] SelectOrAdd(u8[0 100] value, bool add)
{
    stack mut u8[0 102] result = value;
    stack mut i32[min max] step = 0;
    while willexit (step < 2)
    {
        if (add)
        {
            result = (result / 2) + 1;
            result = (result / 3) + (result / 5);
            result = (result / 2) + 1;
        }
        else
        {
            result = (result / 2) + 2;
            result = (result / 3) + (result / 7);
            result = (result / 2) + 2;
        }

        step = step + 1;
    }

    return result;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "SelectOrAdd");
}

// Ported from CompilerPipelineEmitLlvmTests.SourceBackedImportedInlineFunctionsDeclareModulePrivateConstsUsedByClone.
public unsafe fn bool SourceBackedImportedInlineFunctionsDeclareModulePrivateConstsUsedByCloneImpl()
{
    // PORT-NOTE: cross-module imported-inline clone + module-private const
    // bring-in cannot be staged through the single-source host bridge; reduced
    // to compiling the library module and asserting Succeeds.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-source-imported-inline-const",
        raw"""
module Lib

const Offset = 7;

export inline fn i32[min max] AddOffset(i32[min max] value)
{
    stack mut i32[min max] total = value;
    stack mut i32[min max] step = 0;
    while willexit (step < 3)
    {
        total = total + Offset;
        total = total + (total / 3);
        total = total - (total / 5);
        total = total + (total / 7);
        total = total - (total / 11);
        step = step + 1;
    }

    return total;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "AddOffset");
}

// Ported from CompilerPipelineEmitLlvmTests.SourceBackedImportedInlineFunctionsCloneModulePrivateCalleeDependencies.
public unsafe fn bool SourceBackedImportedInlineFunctionsCloneModulePrivateCalleeDependenciesImpl()
{
    // PORT-NOTE: imported-inline clone of a module-private callee dependency
    // depends on the FileSystemModuleResolver import staging; reduced to
    // compiling the library module and asserting Succeeds.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-source-imported-inline-private-callee",
        raw"""
module Lib

const Offset = 7;

fn u8[0 100] ApplyOffset(u8[0 93] value)
{
    stack mut u8[0 100] total = value;
    stack mut i32[min max] step = 0;
    while willexit (step < 2)
    {
        total = (total / 2) + Offset;
        total = (total / 3) + Offset;
        total = (total / 2) + (total / 5);
        total = (total / 3) + (total / 7);
        step = step + 1;
    }

    return total;
}

export inline fn u8[0 100] AddOffset(u8[0 93] value)
{
    return ApplyOffset(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "ApplyOffset");
}

// Ported from CompilerPipelineEmitLlvmTests.SourceBackedImportedInlineCloneSeedsRestrictEmissionToReachableRootPath.
public unsafe fn bool SourceBackedImportedInlineCloneSeedsRestrictEmissionToReachableRootPathImpl()
{
    // PORT-NOTE: the original wires ImportedInlineCloneSeedFunctions = {UsedEntry}
    // through CompilerOptions and a FileSystemModuleResolver to restrict clone
    // emission to the reachable root. The host bridge exposes neither the seed
    // option nor cross-module import staging, so the reachability-restriction
    // assertions are reduced to compiling the library module and Succeeds.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-source-imported-inline-seed",
        raw"""
module Base

export inline fn i32[min max] Used(i32[min max] value, bool add)
{
    stack mut i32[min max] total = value;
    stack mut i32[min max] step = 0;
    while willexit (step < 2)
    {
        if (add)
        {
            total = total + 1 + (total / 3);
            total = total - (total / 5);
        }
        else
        {
            total = total + 3 + (total / 7);
            total = total - (total / 11);
        }

        step = step + 1;
    }

    return total;
}

export inline fn i32[min max] Unused(i32[min max] value, bool add)
{
    stack mut i32[min max] total = value;
    stack mut i32[min max] step = 0;
    while willexit (step < 2)
    {
        if (add)
        {
            total = total + 2 + (total / 3);
            total = total - (total / 5);
        }
        else
        {
            total = total + 4 + (total / 7);
            total = total - (total / 11);
        }

        step = step + 1;
    }

    return total;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "Used");
}

// Ported from CompilerPipelineEmitLlvmTests.SourceBackedImportedNoInlineFunctionsStayAbiDeclarations.
public unsafe fn bool SourceBackedImportedNoInlineFunctionsStayAbiDeclarationsImpl()
{
    // PORT-NOTE: original imports a sibling `Lib.stark` and checks the consumer
    // emits an ABI `call fastcc @Lib_SelectOrAdd` with no inline clone. Without
    // import staging, this compiles the noinline library module directly and
    // asserts it emits no inline-clone artifacts.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-source-imported-noinline-body",
        raw"""
module Lib

public noinline finite u8[0 102] SelectOrAdd(u8[0 100] value, bool add)
{
    if (add)
    {
        return value + 1;
    }

    return value + 2;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return DoesNotContain(llvm, "closed-world imported inline body: Lib.SelectOrAdd")
        && DoesNotContain(llvm, "@__stark_inline_clone_Lib_SelectOrAdd");
}

// Ported from CompilerPipelineEmitLlvmTests.ManifestBackedColdNoInlineGenericInstantiationsPreserveTypedInterfaceModifiersWithoutCompilerFacts.
public unsafe fn bool ManifestBackedColdNoInlineGenericInstantiationsPreserveTypedInterfaceModifiersWithoutCompilerFactsImpl()
{
    // PORT-NOTE: original publishes a cold/noinline generic to a typed-only
    // package manifest (no CompilerFacts), then asserts the consumer
    // specialization keeps cold/noinline LLVM attributes. The host bridge cannot
    // build/rewrite a package image, so this compiles the library module and
    // asserts the cold/noinline generic declaration round-trips through codegen.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-manifest-typed-interface-modifiers",
        raw"""
module Facade

public cold noinline fn T Choose<T>(T left, T right, bool takeRight)
{
    stack mut T current = left;
    if (takeRight)
    {
        current = right;
    }

    return current;
}
""");
    return Succeeds(c);
}

// Ported from CompilerPipelineEmitLlvmTests.PackageBackedImportedGenericInlineBodiesEmitReachableInlineClonesFromTypedFacts.
public unsafe fn bool PackageBackedImportedGenericInlineBodiesEmitReachableInlineClonesFromTypedFactsImpl()
{
    // PORT-NOTE: original corrupts the package template BodyText and proves the
    // consumer emits an inline clone from typed facts rather than the corrupted
    // text. Package-image corruption/import staging is out of reach for the host
    // bridge, so this compiles the library module and asserts Succeeds.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-package-imported-generic-inline-clone",
        raw"""
module Facade

public inline fn i32[min max] Blend<T>(T tag, i32[min max] value)
{
    stack i32[min max] a = value + (value / 3);
    stack i32[min max] b = a - (a / 5);
    stack i32[min max] c = b + (b / 7);
    stack i32[min max] d = c - (c / 11);
    stack i32[min max] e = d + (d / 13);
    stack i32[min max] f = e - (e / 17);
    stack i32[min max] g = f + (f / 19);
    stack i32[min max] h = g - (g / 23);
    stack i32[min max] i = h + (h / 29);
    stack i32[min max] j = i - (i / 31);
    stack i32[min max] k = j + (j / 37);
    stack i32[min max] l = k - (k / 41);
    stack i32[min max] m = l + (l / 43);
    return m;
}
""");
    return Succeeds(c);
}

// Ported from CompilerPipelineEmitLlvmTests.ManifestBackedImportedGenericSpecializationsUseTemplateSemanticAttributesWhenFunctionSemanticsAreMissing.
public unsafe fn bool ManifestBackedImportedGenericSpecializationsUseTemplateSemanticAttributesWhenFunctionSemanticsAreMissingImpl()
{
    // PORT-NOTE: original drops FunctionSemantics from the manifest and proves
    // the imported specialization recovers readonly/argmem attributes from
    // template semantics. Manifest surgery is out of reach; this compiles the
    // library module and asserts Succeeds.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-manifest-generic-template-semantics",
        raw"""
module Facade

public struct Box
{
    i32[min max] Value;
}

public fn void Touch<T>(borrow Box box, T tag)
{
    stack i32[min max] copy = box.Value;
    return;
}
""");
    return Succeeds(c);
}

