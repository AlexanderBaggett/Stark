// Ported from CompilerPipelineEmitLlvmTests.ConstGlobalDerivedLoadsEmitInvariantLoadMetadataWithoutTaggingLocalLoads.
public unsafe fn bool ConstGlobalDerivedLoadsEmitInvariantLoadMetadataWithoutTaggingLocalLoadsImpl()
{
    // PORT-NOTE: the C# oracle slices the @Run body and counts that exactly two
    // i32 loads appear with exactly one carrying `!invariant.load`. The host
    // bridge exposes the raw LLVM text but not a body-scoped load counter, so
    // the per-load count assertions are reduced to substring checks: an
    // invariant-marked load is present and Run was emitted.
    stack mut LlvmCompile c = CompileLlvm(
        "emit-llvm-const-invariant-load",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

const Box Current = new Box()
{
    Value = 5
};

unsafe fn i32[min max] Run()
{
    stack mut i32[min max] local = 3;
    stack rawptr<i32[min max]> localPtr = &local;
    stack rawptr<frozen i32[min max]> constPtr = &(Current.Value);
    return (*localPtr) + (*constPtr);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "@Run(")
        && Contains(llvm, "!invariant.load");
}
