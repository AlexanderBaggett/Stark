// Ported from LlvmIrEmissionTests.InternalStringFunctionsUseConcreteStringAbi.
public unsafe fn bool InternalStringFunctionsUseConcreteStringAbiImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-internal-string-abi",
        raw"""
module Demo

unsafe finite law ascii Echo(ascii text)
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    if (acc > -4000000000000000000)
    {
        return text;
    }

    return text;
}

unsafe finite law ascii Run(ascii input)
{
    return Echo(input);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%stark_ascii = type { ptr, i64 }")
        && Contains(llvm, "define fastcc %stark_ascii @Echo(%stark_ascii %arg_text)")
        && Contains(llvm, "ret %stark_ascii %arg_text")
        && Contains(llvm, "define fastcc %stark_ascii @Run(%stark_ascii %arg_input)")
        && Contains(llvm, "call fastcc %stark_ascii @Echo(%stark_ascii %arg_input)");
}

// Ported from LlvmIrEmissionTests.CharacterLiteralsEmitConcreteStringValues.
public unsafe fn bool CharacterLiteralsEmitConcreteStringValuesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-character-literals",
        raw"""
module Demo

unsafe finite law ascii AsciiChar()
{
    return 'a';
}

unsafe finite law unicode UnicodeChar()
{
    return (unicode)'α';
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%stark_ascii = type { ptr, i64 }")
        && Contains(llvm, "%stark_unicode = type { ptr, i64 }")
        && Contains(llvm, "@.str.0 = private unnamed_addr constant [2 x i8] c\"a\\00\"")
        && Contains(llvm, "private unnamed_addr constant [2 x i32] [i32 945, i32 0]")
        && Contains(llvm, "define fastcc %stark_ascii @AsciiChar()")
        && Contains(llvm, "define fastcc %stark_unicode @UnicodeChar()")
        && Contains(llvm, "ret %stark_ascii { ptr getelementptr inbounds nuw ([2 x i8], ptr @.str.0, i32 0, i32 0), i64 1 }")
        && Contains(llvm, "ret %stark_unicode { ptr getelementptr inbounds nuw ([2 x i32], ptr @.str.")
        && Contains(llvm, ", i64 1 }");
}

// Ported from LlvmIrEmissionTests.UnicodeStringLiteralsUseUtf32CodeUnitLengthInRuntimeValues.
public unsafe fn bool UnicodeStringLiteralsUseUtf32CodeUnitLengthInRuntimeValuesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-unicode-utf32-code-unit-length",
        raw"""
module Demo

unsafe finite law unicode Greek()
{
    return (unicode)"α";
}

unsafe finite law unicode Accented()
{
    return (unicode)"\xC9";
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original asserts exactly 2 occurrences each of the unicode
    // `ret`/length fragments via Assert.Equal(2, CountOccurrences(...)); the
    // host helpers expose no occurrence count, so these are reduced to presence
    // Contains checks.
    return Contains(llvm, "%stark_unicode = type { ptr, i64 }")
        && Contains(llvm, "private unnamed_addr constant [2 x i32] [i32 945, i32 0]")
        && Contains(llvm, "private unnamed_addr constant [2 x i32] [i32 201, i32 0]")
        && Contains(llvm, "ret %stark_unicode { ptr getelementptr inbounds nuw ([2 x i32], ptr @.str.")
        && Contains(llvm, ", i64 1 }");
}

// Ported from LlvmIrEmissionTests.EquivalentAsciiLiteralPayloadsShareOneHelperGlobalAcrossGlobalAndFunctionUses.
public unsafe fn bool EquivalentAsciiLiteralPayloadsShareOneHelperGlobalAcrossGlobalAndFunctionUsesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-shared-ascii-literal-global",
        raw"""
module Demo

const ascii Label = '\x41';

unsafe finite law ascii Run()
{
    return "A";
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original asserts the payload constant appears exactly once and
    // is referenced exactly twice via Assert.Equal(N, CountOccurrences(...));
    // the host helpers cannot count, so this is reduced to presence Contains for
    // both the shared constant and a getelementptr reference to it.
    return Contains(llvm, "private unnamed_addr constant [2 x i8] c\"A\\00\"")
        && Contains(llvm, "getelementptr inbounds nuw ([2 x i8], ptr @.str.");
}

// Ported from LlvmIrEmissionTests.EquivalentUnicodeLiteralPayloadsShareOneHelperGlobal.
public unsafe fn bool EquivalentUnicodeLiteralPayloadsShareOneHelperGlobalImpl()
{
