// Ported from LlvmIrEmissionTests.FullyDefinedNonFfiAbiSurfacesEmitNoundef.
public unsafe fn bool FullyDefinedNonFfiAbiSurfacesEmitNoundefImpl()
{
    // PORT-NOTE: original scopes each header assertion to a specific function
    // (Pick/Echo/Keep/Copy) via ExtractDefinitionHeader over GetLlvmRaw; reduced
    // to whole-module Contains on the raw `llvm` text.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-non-ffi-abi-noundef",
        raw"""
module Demo

record Pair(u8[0 10] Left, u8[0 10] Right)
{
}
record Big(
    i64[min max] A,
    i64[min max] B,
    i64[min max] C)
    {
    }

unsafe fn rawptr<i8[min max]> Pick(rawptr<i8[min max]> ptr)
{
    return ptr;
}

unsafe fn ascii Echo(ascii text)
{
    return text;
}

unsafe fn Pair Keep(Pair pair)
{
    return pair;
}

unsafe fn Big Copy(Big value)
{
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef ptr @Pick(ptr noundef")
        && Contains(llvm, "define fastcc noundef %stark_ascii @Echo(%stark_ascii noundef %arg_text)")
        && Contains(llvm, "define fastcc noundef %Pair @Keep(%Pair noundef %arg_pair)")
        && Contains(llvm, "define fastcc void @Copy(ptr noundef noalias sret(%Big)")
        && Contains(llvm, "ptr noundef nonnull byval(%Big)");
}

// Ported from LlvmIrEmissionTests.PointerAbiContractsDistinguishSafeBorrowsAndNullableRawPointers.
public unsafe fn bool PointerAbiContractsDistinguishSafeBorrowsAndNullableRawPointersImpl()
{
    // PORT-NOTE: original scopes the ReadBorrow/ReadView/RawInternal assertions
    // to per-function headers via ExtractDefinitionHeader over GetLlvmRaw, and
    // the RawInternal-header DoesNotContain checks for `nonnull`/`dereferenceable`
    // are header-scoped. Reduced to whole-module Contains/DoesNotContain; the
    // module-wide DoesNotContain on the dereferenceable tokens within the
    // RawInternal/RawForeign forms is preserved as the closest expressible
    // signal.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-pointer-abi-contracts",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] ReadBorrow(borrow Box box)
{
    return box.Value;
}

unsafe fn i32[min max] ReadView(borrow i32[min max][] view, i32[min max] index)
{
    return view[index];
}

unsafe fn void RawInternal(rawptr<Box> ptr)
{
    return;
}

unsafe ffi fn void RawForeign(rawptr<Box> ptr);
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef i32 @ReadBorrow(ptr noundef nonnull noalias readonly nocapture dereferenceable(4) align 4 %arg_box)")
        && Contains(llvm, "define fastcc noundef i32 @ReadView(ptr noundef nonnull noalias readonly nocapture dereferenceable(16) align 8 %arg_view, i32 noundef %arg_index)")
        && Contains(llvm, "ptr noundef readonly nocapture %arg_ptr")
        && Contains(llvm, "declare void @RawForeign(ptr readonly)")
        && DoesNotContain(llvm, "declare void @RawForeign(ptr nonnull")
        && DoesNotContain(llvm, "declare void @RawForeign(ptr dereferenceable")
        && DoesNotContain(llvm, "declare void @RawForeign(ptr dereferenceable_or_null");
}

// Ported from LlvmIrEmissionTests.RawMutablePointerDeclarationsMayReadAndWriteArgumentMemory.
public unsafe fn bool RawMutablePointerDeclarationsMayReadAndWriteArgumentMemoryImpl()
{
    // PORT-NOTE: original isolates the single `declare fastcc void @Fill(` line
    // via Split/Single over GetLlvmRaw and asserts the absence of read/write
    // tokens on that one line. Reduced to whole-module Contains for the exact
    // declaration form plus module-wide DoesNotContain on the read/write tokens,
    // which holds because no other declaration in this module emits them.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-rawmut-pointer-decl-readwrite",
        raw"""
module Demo

unsafe fn void Fill(rawmutptr<i32[min max]> ptr);

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    Fill(ptr);
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare fastcc void @Fill(ptr noundef)")
        && DoesNotContain(llvm, "memory(argmem: read)")
        && DoesNotContain(llvm, "readonly")
        && DoesNotContain(llvm, "writeonly");
}

// Ported from LlvmIrEmissionTests.FfiRawMutablePointerCallsPropagateWrapperArgumentWrites.
public unsafe fn bool FfiRawMutablePointerCallsPropagateWrapperArgumentWritesImpl()
{
    // PORT-NOTE: original isolates the single `declare i32 @Fill(` line via
    // Split/Single and the `Run` header via ExtractDefinitionHeader over
    // GetLlvmRaw. Reduced to whole-module Contains for the declaration form plus
    // module-wide DoesNotContain on the read/write/memory tokens; these hold
    // because nothing else in this module emits them.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-ffi-rawmut-pointer-propagates-writes",
        raw"""
module Demo

unsafe ffi fn i32[min max] Fill(rawmutptr<i32[min max]> ptr);

unsafe fn i32[min max] Run(rawmutptr<i32[min max]> ptr)
{
    return Fill(ptr);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare i32 @Fill(ptr)")
        && DoesNotContain(llvm, "readonly")
        && DoesNotContain(llvm, "writeonly")
        && DoesNotContain(llvm, "memory(read, argmem: none)");
}

// Ported from LlvmIrEmissionTests.ConstrainedIntegerLoadsAndCallResultsEmitRangeMetadata.
public unsafe fn bool ConstrainedIntegerLoadsAndCallResultsEmitRangeMetadataImpl()
{
    // PORT-NOTE: original asserts the load/call range metadata via regex
    // (`load i8, ptr (?:%v\d+|%slot_value), !range !\d+` and
    // `call fastcc i8 @Bounded\(\), !range !\d+`); reduced to literal-substring
    // Contains on the stable token fragments (`!range !`, the typed load/call
    // prefixes) plus the concrete range-metadata node.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-constrained-int-range-metadata",
        raw"""
module Demo

unsafe fn u8[0 10] Bounded()
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    if (acc > 0)
    {
        return 7;
    }

    return 3;
}

unsafe fn u8[0 10] ReadThroughPointer(u8[0 10] input)
{
    stack mut u8[0 10] value = input;
    stack rawmutptr<u8[0 10]> ptr = &value;
    return *ptr;
}

unsafe fn u8[0 10] CallBounded()
{
    return Bounded();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "load i8, ptr")
        && Contains(llvm, "call fastcc i8 @Bounded()")
        && Contains(llvm, "!range !")
        && Contains(llvm, "!{i8 0, i8 11}");
}
