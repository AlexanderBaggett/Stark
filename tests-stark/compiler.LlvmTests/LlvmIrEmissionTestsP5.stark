public unsafe fn bool ImportedSystemBitOperationsBuiltinsAreInternalizedIntoConsumerIrImpl()
{
    // PORT-NOTE: the C# test stages a sibling `System.BitOperations` module
    // through an InMemoryModuleResolver and pins `x86_64-unknown-linux-gnu`. The
    // host bridge compiles a single source for the host default target, so the
    // imported `PopCount` law is folded into the consumer module here and the
    // internalized-clone symbol name plus ExtractDefinitionHeader scoping is
    // reduced to whole-module Contains on the concrete `PopCount` definition and
    // call.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-imported-bitops-internalized",
