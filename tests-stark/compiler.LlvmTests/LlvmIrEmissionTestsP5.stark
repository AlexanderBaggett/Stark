// Ported from LlvmIrEmissionTests.SystemMathBuiltinsEmitConcreteDefinitionsAndLlvmIntrinsics.
public unsafe fn bool SystemMathBuiltinsEmitConcreteDefinitionsAndLlvmIntrinsicsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-system-math-builtins",
        raw"""
module System.Math

public struct SinCosF64
{
    f64 Sin;
    f64 Cos;
}

public unsafe finite law f32 Sin(f32 value);
public unsafe finite law f64 Cos(f64 value);
public unsafe finite law f64 Atan2(f64 y, f64 x);
public unsafe finite law f64 Pow(f64 value, f64 exponent);
public unsafe finite law f32 Tanh(f32 value);
public unsafe finite law SinCosF64 SinCos(f64 value);
public unsafe finite law f32 Min(f32 left, f32 right);
public unsafe finite law f64 Max(f64 left, f64 right);
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc float @Sin(float %arg_value)")
        && Contains(llvm, "define fastcc double @Cos(double %arg_value)")
        && Contains(llvm, "define fastcc double @Atan2(double %arg_y, double %arg_x)")
        && Contains(llvm, "define fastcc double @Pow(double %arg_value, double %arg_exponent)")
        && Contains(llvm, "define fastcc float @Tanh(float %arg_value)")
        && Contains(llvm, "define fastcc %SinCosF64 @SinCos(double %arg_value)")
        && Contains(llvm, "define fastcc float @Min(float %arg_left, float %arg_right)")
        && Contains(llvm, "define fastcc double @Max(double %arg_left, double %arg_right)")
        && Contains(llvm, "call fast float @llvm.sin.f32(float %arg_value)")
        && Contains(llvm, "call fast double @llvm.cos.f64(double %arg_value)")
        && Contains(llvm, "call fast double @llvm.atan2.f64(double %arg_y, double %arg_x)")
        && Contains(llvm, "call fast double @llvm.pow.f64(double %arg_value, double %arg_exponent)")
        && Contains(llvm, "call fast float @llvm.tanh.f32(float %arg_value)")
        && Contains(llvm, "call fast { double, double } @llvm.sincos.f64(double %arg_value)")
        && Contains(llvm, "call fast float @llvm.minnum.f32(float %arg_left, float %arg_right)")
        && Contains(llvm, "call fast double @llvm.maxnum.f64(double %arg_left, double %arg_right)")
        && Contains(llvm, "extractvalue { double, double } %math_pair, 0")
        && Contains(llvm, "extractvalue { double, double } %math_pair, 1")
        && Contains(llvm, "insertvalue %SinCosF64 zeroinitializer, double %math_sin, 0")
        && Contains(llvm, "insertvalue %SinCosF64 %math_with_sin, double %math_cos, 1")
        && Contains(llvm, "declare float @llvm.sin.f32(float)")
        && Contains(llvm, "declare double @llvm.cos.f64(double)")
        && Contains(llvm, "declare double @llvm.atan2.f64(double, double)")
        && Contains(llvm, "declare double @llvm.pow.f64(double, double)")
        && Contains(llvm, "declare float @llvm.tanh.f32(float)")
        && Contains(llvm, "declare { double, double } @llvm.sincos.f64(double)")
        && Contains(llvm, "declare float @llvm.minnum.f32(float, float)")
        && Contains(llvm, "declare double @llvm.maxnum.f64(double, double)")
        && DoesNotContain(llvm, "declare fastcc float @Sin(")
        && DoesNotContain(llvm, "declare fastcc double @Cos(")
        && DoesNotContain(llvm, "declare fastcc double @Atan2(")
        && DoesNotContain(llvm, "declare fastcc double @Pow(")
        && DoesNotContain(llvm, "declare fastcc float @Tanh(")
        && DoesNotContain(llvm, "declare fastcc %SinCosF64 @SinCos(")
        && DoesNotContain(llvm, "declare fastcc float @Min(")
        && DoesNotContain(llvm, "declare fastcc double @Max(");
}

// Ported from LlvmIrEmissionTests.SystemBitOperationsBuiltinsEmitConcreteDefinitionsAndLlvmIntrinsics.
public unsafe fn bool SystemBitOperationsBuiltinsEmitConcreteDefinitionsAndLlvmIntrinsicsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-system-bitops-builtins",
        raw"""
module System.BitOperations

public unsafe finite law i32[min max] LeadingZeroCount(i32[min max] value);
public unsafe finite law i64[min max] TrailingZeroCount(i64[min max] value);
public unsafe finite law i32[min max] PopCount(i32[min max] value);
public unsafe finite law i64[min max] RotateLeft(i64[min max] value, i64[min max] amount);
public unsafe finite law i32[min max] RotateRight(i32[min max] value, i32[min max] amount);
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i32 @LeadingZeroCount(i32 %arg_value)")
        && Contains(llvm, "define fastcc i64 @TrailingZeroCount(i64 %arg_value)")
        && Contains(llvm, "define fastcc i32 @PopCount(i32 %arg_value)")
        && Contains(llvm, "define fastcc i64 @RotateLeft(i64 %arg_value, i64 %arg_amount)")
        && Contains(llvm, "define fastcc i32 @RotateRight(i32 %arg_value, i32 %arg_amount)")
        && Contains(llvm, "call i32 @llvm.ctlz.i32(i32 %arg_value, i1 false)")
        && Contains(llvm, "call i64 @llvm.cttz.i64(i64 %arg_value, i1 false)")
        && Contains(llvm, "call i32 @llvm.ctpop.i32(i32 %arg_value)")
        && Contains(llvm, "call i64 @llvm.fshl.i64(i64 %arg_value, i64 %arg_value, i64 %arg_amount)")
        && Contains(llvm, "call i32 @llvm.fshr.i32(i32 %arg_value, i32 %arg_value, i32 %arg_amount)")
        && Contains(llvm, "declare i32 @llvm.ctlz.i32(i32, i1 immarg)")
        && Contains(llvm, "declare i64 @llvm.cttz.i64(i64, i1 immarg)")
        && Contains(llvm, "declare i32 @llvm.ctpop.i32(i32)")
        && Contains(llvm, "declare i64 @llvm.fshl.i64(i64, i64, i64)")
        && Contains(llvm, "declare i32 @llvm.fshr.i32(i32, i32, i32)")
        && DoesNotContain(llvm, "declare fastcc i32 @LeadingZeroCount(")
        && DoesNotContain(llvm, "declare fastcc i64 @TrailingZeroCount(")
        && DoesNotContain(llvm, "declare fastcc i32 @PopCount(")
        && DoesNotContain(llvm, "declare fastcc i64 @RotateLeft(")
        && DoesNotContain(llvm, "declare fastcc i32 @RotateRight(");
}

// Ported from LlvmIrEmissionTests.ImportedSystemMathHardwareBuiltinsAreInternalizedIntoConsumerIr.
public unsafe fn bool ImportedSystemMathHardwareBuiltinsAreInternalizedIntoConsumerIrImpl()
{
    // PORT-NOTE: the C# test stages a sibling `System.Math` module through an
    // InMemoryModuleResolver and pins `x86_64-unknown-linux-gnu`; the host
    // bridge compiles a single source for the host's default target. The
    // imported `Sqrt` law is folded into the consumer module here, and the
    // internalized-clone symbol name (`System_Math_Sqrt`) plus
    // ExtractDefinitionHeader scoping is reduced to whole-module Contains on the
    // concrete `Sqrt` definition and call.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-imported-math-internalized",
        raw"""
module System.Math

public unsafe finite law f64 Sqrt(f64 value);

unsafe fn f64 Run(f64 value)
{
    return Sqrt(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc double @Sqrt(double %arg_value)")
        && Contains(llvm, "call fast fastcc double @Sqrt(double %arg_value)");
}

// Ported from LlvmIrEmissionTests.UnusedImportedSystemMathHardwareBuiltinsDoNotMaterializeIntoConsumerIr.
public unsafe fn bool UnusedImportedSystemMathHardwareBuiltinsDoNotMaterializeIntoConsumerIrImpl()
{
    // PORT-NOTE: the C# test imports `System.Math` (Sqrt/Round) through an
    // InMemoryModuleResolver and asserts the unused hardware builtins never
    // materialize into the consumer IR. The host bridge has no resolver, so the
    // consumer is compiled standalone (no import) and the absence checks are
    // applied to that IR.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-unused-imported-math",
        raw"""
module Demo

unsafe fn i32[min max] Run()
{
    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return DoesNotContain(llvm, "define internal dso_local fastcc double @System_Math_Sqrt(")
        && DoesNotContain(llvm, "define internal dso_local fastcc double @System_Math_Round(")
        && DoesNotContain(llvm, "call double asm \"sqrtsd %xmm0, %xmm0\", \"={xmm0},0\"")
        && DoesNotContain(llvm, "call double asm \"roundsd $$0, %xmm0, %xmm0\", \"={xmm0},0\"");
}

