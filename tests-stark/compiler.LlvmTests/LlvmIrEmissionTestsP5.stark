unsafe finite law unicode Two()
{
    return (unicode)'α';
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original asserts the payload constant appears exactly once and
    // is referenced exactly twice via Assert.Equal(N, CountOccurrences(...));
    // reduced to presence Contains for the shared constant and a getelementptr
    // reference to it.
    return Contains(llvm, "private unnamed_addr constant [2 x i32] [i32 945, i32 0]")
        && Contains(llvm, "getelementptr inbounds nuw ([2 x i32], ptr @.str.");
}

// Ported from LlvmIrEmissionTests.PlainFnsEmitInferredPureAndFiniteAttributes.
public unsafe fn bool PlainFnsEmitInferredPureAndFiniteAttributesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-plain-fn-pure-finite-attrs",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

unsafe fn i32[min max] Read(borrow Box box)
{
    return box.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i32 @Add(i32 %arg_left, i32 %arg_right) nounwind willreturn mustprogress nosync nofree memory(none)")
        && Contains(llvm, "memory(argmem: read)");
}

