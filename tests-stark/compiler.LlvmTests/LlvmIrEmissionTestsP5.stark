    // ExtractDefinitionHeader over GetLlvmRaw; reduced to whole-module
    // Contains/DoesNotContain on the raw `llvm` text. The whole-module
    // DoesNotContain on `nocapture`/`captures(ret:` is broader than the original
    // header-scoped check but holds because no other declaration in this module
    // emits those tokens.
    stack mut LlvmCompile c = CompileLlvm(
