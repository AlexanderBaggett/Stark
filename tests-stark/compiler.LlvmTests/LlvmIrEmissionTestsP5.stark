// Ported from LlvmIrEmissionTests.RetborrowScalarReturnsUsePointerAbiAndCanBeWrittenThrough.
public unsafe fn bool RetborrowScalarReturnsUsePointerAbiAndCanBeWrittenThroughImpl()
{
    // PORT-NOTE: original scopes the header assertion to `Box_Field` via
    // ExtractDefinitionHeader over GetLlvmRaw; reduced to whole-module Contains.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-retborrow-scalar-pointer-abi",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;

    unsafe fn retborrow mut i32[min max] Field(mut borrow Box self)
    {
        return self.Value;
    }
}

unsafe fn i32[min max] Run()
{
    stack mut Box box = new Box()
    {
        Value = 0
    };
    box.Field() = 7;
    return box.Field();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef nonnull dereferenceable(4) align 4 ptr @Box_Field(ptr noundef")
        && Contains(llvm, "call fastcc noundef nonnull dereferenceable(4) align 4 ptr @Box_Field(")
        && Contains(llvm, "ret ptr")
        && Contains(llvm, "store i32 7, ptr")
        && Contains(llvm, "load i32, ptr");
}

