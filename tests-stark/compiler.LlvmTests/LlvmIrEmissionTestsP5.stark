// Ported from LlvmIrEmissionTests.SystemTextAsciiToUnicodeLiteralSpecializationHandlesNullDestination.
public unsafe fn bool SystemTextAsciiToUnicodeLiteralSpecializationHandlesNullDestinationImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-ascii-unicode-null-destination",
        raw"""
module System.Text

public inline unsafe finite bool TryConvertAsciiToUnicode(rawmutptr<Unicode> destination, ascii source);

public unsafe fn bool Run()
{
    return TryConvertAsciiToUnicode(null, "Stark");
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // The constant-null destination folds the specialized null check all the way
    // to the failure result.
    return Contains(llvm, "ret i1 false")
        && DoesNotContain(llvm, "call fastcc i1 @TryConvertAsciiToUnicode(");
}

