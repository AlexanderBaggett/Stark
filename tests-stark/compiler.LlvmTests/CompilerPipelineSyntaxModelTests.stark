import LlvmTestSupport
import System.Testing
module CompilerPipelineSyntaxModelTests

// Ported from CompilerPipelineSyntaxModelTests.BackendOpaqueCallableEmitsLlvmOptimizationBoundary.
internal fn bool BackendOpaqueCallableEmitsLlvmOptimizationBoundaryImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "syntax-model-backend-opaque-llvm-boundary",
        raw"""
module Demo

[Backend(Opaque)]
finite law i32[min max] Read()
{
    return 1;
}

finite law i32[min max] Fast()
{
    return 2;
}

export fn i32[min max] main()
{
    return Read() + Fast();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "optnone")
        && Contains(llvm, "noinline")
        && Contains(llvm, "call fastcc i32 @Read(")
        && DoesNotContain(llvm, "call fastcc i32 @Fast(");
}
