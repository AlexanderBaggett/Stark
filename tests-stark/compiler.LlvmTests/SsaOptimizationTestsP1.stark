import LlvmTestSupport
import System.Testing
module SsaOptimizationTestsP1

// Ported from SsaOptimizationTests.ConstantPropagationFoldsConstantBranchesInLlvm.
public unsafe fn bool ConstantPropagationFoldsConstantBranchesInLlvmImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "ssa-const-prop-folds-constant-branches",
        raw"""
module Demo

fn i32[min max] Run()
{
    stack i32[min max] x = 1;
    if (x == 1)
    {
        return 7;
    }
    else
    {
        return 9;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }
    stack ascii llvm = Llvm(c);
    return Contains(llvm, "ret i32 7")
        && DoesNotContain(llvm, "icmp eq")
        && DoesNotContain(llvm, "br i1");
}

// Ported from SsaOptimizationTests.ConstantPropagationFoldsConstantSwitchesInLlvm.
public unsafe fn bool ConstantPropagationFoldsConstantSwitchesInLlvmImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "ssa-const-prop-folds-constant-switches",
        raw"""
module Demo

fn i32[min max] Run()
{
    stack i32[min max] value = 2;
    switch (value)
    {
        case 1:
            return 1;
        case 2:
            return 2;
        default:
            return 3;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }
    stack ascii llvm = Llvm(c);
    return Contains(llvm, "ret i32 2")
        && DoesNotContain(llvm, "switch i32")
        && DoesNotContain(llvm, "icmp eq");
}
