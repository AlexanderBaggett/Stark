// Ported from LlvmIrEmissionTests.PlainFnsEmitInferredPureAndFiniteAttributes.
internal fn bool PlainFnsEmitInferredPureAndFiniteAttributesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-plain-fn-pure-finite-attrs",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

unsafe fn i32[min max] Read(borrow Box box)
{
    return box.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef i32 @Add(i32 noundef %arg_left, i32 noundef %arg_right) nounwind willreturn mustprogress nosync nofree memory(none)")
        && Contains(llvm, "memory(argmem: read)");
}

