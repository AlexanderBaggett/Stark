    return Contains(llvm, "declare void @llvm.memcpy.p0.p0.i64(ptr nocapture writeonly, ptr nocapture readonly, i64, i1 immarg)")
        && Contains(llvm, ", 4")
        && Contains(llvm, "call void @llvm.memcpy.p0.p0.i64(ptr align 4 %abi_rawptr_loop_destination_data_")
        && DoesNotContain(llvm, "%v0_phi = phi");
