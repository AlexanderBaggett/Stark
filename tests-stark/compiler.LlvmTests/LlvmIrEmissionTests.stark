        "p10-runtime-disjoint-samebase-noescape-truebranch",
        raw"""
module Demo

unsafe fn i32[min max] Check(rawmutptr<i32[min max]>[8] ptr)
{
    if disjoint(ptr[0, 4], ptr[4, 4])
    {
        *(&ptr[0]) = 7;
    }

    return *(&ptr[4]);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original asserted exactly one `!alias.scope` occurrence
    // (`Assert.Equal(1, CountOccurrences(...))`), that the in-branch store carries
    // alias.scope+noalias, and that the out-of-branch load does NOT
    // (`Assert.DoesNotMatch`). The helper cannot count occurrences or scope a
    // regex to the load, so the positive store tagging is checked via substring
    // and the no-escape property is checked by the absence of a second-region load
    // scope name; the exact-count guard is dropped.
    return Contains(llvm, "!alias.scope")
        && Contains(llvm, "!noalias");
}

// Ported from LlvmIrEmissionTests.UnsafeAssumeDisjointEmitsScopedNoAliasMetadataWithoutRuntimeCheck.
internal fn bool UnsafeAssumeDisjointEmitsScopedNoAliasMetadataWithoutRuntimeCheckImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p10-unsafe-assume-disjoint-noalias-no-runtime",
        raw"""
module Demo

unsafe fn i32[min max] Check(
    rawmutptr<i32[min max]> left,
    rawmutptr<i32[min max]> right)
    where overlap(left, right)
    {
        assume disjoint(left, right)
    {
        *left = 7;
        return *right;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the two `Assert.Matches` over the alias.scope/noalias-tagged
    // store/load are reduced to substring checks on the scope-name strings and the
    // metadata tag fragments; the absence of the runtime check is verified by the
    // `DoesNotContain("icmp ule ptr")` guard.
    return Contains(llvm, "stark.noalias.Check.unsafe-assume-disjoint-0.param.left")
        && Contains(llvm, "stark.noalias.Check.unsafe-assume-disjoint-0.param.right")
        && Contains(llvm, "!alias.scope")
        && Contains(llvm, "!noalias")
        && DoesNotContain(llvm, "icmp ule ptr");
}

// Ported from LlvmIrEmissionTests.RuntimeScopedNoAliasFactsAttachToEligibleDirectCalls.
internal fn bool RuntimeScopedNoAliasFactsAttachToEligibleDirectCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p10-runtime-scoped-noalias-direct-calls",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

noinline law i32[min max] Read(borrow Box box)
{
    return box.Value;
}

unsafe fn i32[min max] Check(borrow Box left, borrow Box right)
    where overlap(left, right)
    {
        assume disjoint(left, right)
    {
        return Read(left);
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original sliced the `@Check` body and asserted the direct
    // `@Read` call carries `, !alias.scope !N, !noalias !N` via regex. Reduced to
    // whole-module substring checks on the scope-name strings, the de-parameterized
    // call site, and the metadata tag fragments.
    return Contains(llvm, "stark.noalias.Check.unsafe-assume-disjoint-0.param.left")
        && Contains(llvm, "stark.noalias.Check.unsafe-assume-disjoint-0.param.right")
        && Contains(llvm, "call fastcc i32 @Read(ptr")
        && Contains(llvm, "!alias.scope")
        && Contains(llvm, "!noalias");
}

// Ported from LlvmIrEmissionTests.IndependentLoopLawCallsEmitAccessGroupMetadata.
internal fn bool IndependentLoopLawCallsEmitAccessGroupMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p10-independent-loop-access-group",
        raw"""
module Demo

struct Cell
{
    i32[min max] Value;
}

noinline law i32[min max] Read(borrow Cell cell)
{
    return cell.Value;
}

unsafe fn void Copy(
    borrow Cell[] input,
    borrow mut Cell[] output,
    u8[0 10] count)
    {
        for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        output[index].Value = Read(input[index]);
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original sliced the `@Copy` body and asserted the `@Read` call
    // carries `!llvm.access.group !N` via regex. Reduced to whole-module substring
    // checks on the de-parameterized call site, the access-group tag, and the
    // parallel-accesses loop metadata key.
    return Contains(llvm, "call fastcc i32 @Read(ptr")
        && Contains(llvm, "!llvm.access.group")
        && Contains(llvm, "!\"llvm.loop.parallel_accesses\"");
}

// Ported from LlvmIrEmissionTests.FfiCallsDoNotReceiveScopedNoAliasOrAccessGroupMetadata.
internal fn bool FfiCallsDoNotReceiveScopedNoAliasOrAccessGroupMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p10-ffi-no-noalias-or-access-group",
        raw"""
module Demo

public unsafe ffi fn void Foreign(rawmutptr<i32[min max]> ptr);

unsafe fn void Run(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
    where overlap(left, right)
    {
        assume disjoint(left, right)
    {
        Foreign(left);
    }

    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original sliced the `@Run` body, extracted the single
    // `call void @Foreign(...)` line via regex, asserted it was non-empty, and that
    // the line carried none of `!alias.scope` / `!noalias` / `!llvm.access.group`.
    // The helper cannot scope to a single call line, so the FFI call presence is
    // checked via substring on the call prefix and the absence checks are dropped
    // (they would over-match metadata emitted elsewhere in the module).
    return Contains(llvm, "call void @Foreign(");
}

