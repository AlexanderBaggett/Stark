    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare void @llvm.memcpy.inline.p0.p0.i64")
        && Contains(llvm, "call void @llvm.memcpy.inline.p0.p0.i64(ptr align 4 %slot_dest, ptr align 4 %slot_source")
        && Contains(llvm, "i64 36, i1 false)");
