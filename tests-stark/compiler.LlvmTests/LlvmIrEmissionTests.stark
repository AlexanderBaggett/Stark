// Ported from LlvmIrEmissionTests.IndexedFieldAddressBehindRawPointerEmitsDirectParameterGeps.
internal fn bool IndexedFieldAddressBehindRawPointerEmitsDirectParameterGepsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-indexed-field-rawptr-geps",
        raw"""
module Demo

struct Buffer
{
    i8[min max][16] Storage;
    i64[min max] WritePos;
}

unsafe fn i32[min max] Touch(rawmutptr<Buffer> buffer, i64[min max] index, i8[min max] value)
{
    *(&(*buffer).Storage[index]) = value;
    return (i32[min max])*(&(*buffer).Storage[index]);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef range(i32 -128, 128) i32 @Touch(ptr noundef nocapture %arg_buffer, i64 noundef %arg_index, i8 noundef %arg_value)")
        && Contains(llvm, "getelementptr inbounds nuw %Buffer, ptr %arg_buffer, i32 0, i32 0")
        && Contains(llvm, "getelementptr [16 x i8], ptr")
        && DoesNotContain(llvm, "getelementptr inbounds [16 x i8], ptr")
        && DoesNotContain(llvm, "getelementptr inbounds nuw [16 x i8], ptr")
        && DoesNotContain(llvm, "alloca %Buffer");
}

// Ported from LlvmIrEmissionTests.IndexedRawPointerElementsEmitDirectParameterGeps.
internal fn bool IndexedRawPointerElementsEmitDirectParameterGepsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-indexed-rawptr-element-geps",
        raw"""
module Demo

unsafe fn i32[min max] Touch(rawmutptr<i8[min max]> data, i64[min max] index, i8[min max] value)
{
    *(&data[index]) = value;
    return (i32[min max])*(&data[index]);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef range(i32 -128, 128) i32 @Touch(ptr noundef nocapture %arg_data, i64 noundef %arg_index, i8 noundef %arg_value)")
        && Contains(llvm, "getelementptr i8, ptr %arg_data, i64 %arg_index")
        && DoesNotContain(llvm, "getelementptr inbounds i8, ptr %arg_data, i64 %arg_index")
        && DoesNotContain(llvm, "alloca ptr");
}

// Ported from LlvmIrEmissionTests.BorrowReceiverIndexedFieldAddressesEmitDirectReceiverGeps.
internal fn bool BorrowReceiverIndexedFieldAddressesEmitDirectReceiverGepsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-borrow-receiver-indexed-geps",
        raw"""
module Demo

struct Buffer
{
    i8[min max][16] Storage;

    unsafe fn void Put(borrow mut Buffer self, i64[min max] index, i8[min max] value)
    {
        *(&self.Storage[index]) = value;
        return;
    }

    unsafe fn i32[min max] Read(borrow Buffer self, i64[min max] index)
    {
        return (i32[min max])*(&self.Storage[index]);
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @Buffer_Put(ptr noundef nonnull noalias nocapture dereferenceable(16) %arg_self, i64 noundef %arg_index, i8 noundef %arg_value)")
        && Contains(llvm, "define fastcc noundef range(i32 -128, 128) i32 @Buffer_Read(ptr noundef nonnull noalias readonly nocapture dereferenceable(16) %arg_self, i64 noundef %arg_index)")
        && Contains(llvm, "getelementptr inbounds nuw %Buffer, ptr %arg_self, i32 0, i32 0")
        && Contains(llvm, "getelementptr [16 x i8], ptr %v")
        && DoesNotContain(llvm, "alloca %Buffer");
}

// Ported from LlvmIrEmissionTests.MutableBorrowedAggregateWriterEmitsWriteOnlyNoCaptureParameterFacts.
