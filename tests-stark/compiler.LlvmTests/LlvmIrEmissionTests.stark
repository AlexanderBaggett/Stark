// Ported from LlvmIrEmissionTests.NonStrictFpFunctionsEmitFastMathFlagsOnRemainingFloatInstructions.
internal fn bool NonStrictFpFunctionsEmitFastMathFlagsOnRemainingFloatInstructionsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-nonstrict-fp-fastmath-remaining",
        raw"""
module Demo

unsafe fn f32 Narrow(f64 value)
{
    return (f32)value;
}

unsafe fn f64 Promote(f32 value)
{
    return (f64)value;
}

unsafe fn f32 Negate(f32 value)
{
    return -value;
}

unsafe fn f32 Pick(bool flag, f32 left, f32 right)
{
    stack mut f32 value = left;
    if (flag)
    {
        value = right;
    }

    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Matches over the `phi fast float [ ..., %bbN ], ...`
    // line reduced to a substring on the stable `phi fast float` prefix.
    return Contains(llvm, "fptrunc fast double %arg_value to float")
        && Contains(llvm, "fpext fast float %arg_value to double")
        && Contains(llvm, "fneg fast float %arg_value")
        && Contains(llvm, "phi fast float [ %arg_left, ");
}

// Ported from LlvmIrEmissionTests.NonStrictFpMultiplyAddExpressionsUseContractionFriendlyIntrinsic.
internal fn bool NonStrictFpMultiplyAddExpressionsUseContractionFriendlyIntrinsicImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-nonstrict-fp-fmuladd-contraction",
        raw"""
module Demo

unsafe fn f32 Accumulate(f32 acc, f32 left, f32 right)
{
    return acc + left * right;
}

unsafe fn f32 AccumulateProductFirst(f32 acc, f32 left, f32 right)
{
    return left * right + acc;
}

unsafe fn f32 SubtractAddend(f32 acc, f32 left, f32 right)
{
    return left * right - acc;
}

unsafe fn f32 SubtractProduct(f32 acc, f32 left, f32 right)
{
    return acc - left * right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Matches over the SSA-numbered `%abi_fmuladd_neg_N`
    // fmuladd calls reduced to substring fragments on the stable intrinsic name.
    return Contains(llvm, "declare float @llvm.fmuladd.f32(float, float, float)")
        && Contains(llvm, "call fast float @llvm.fmuladd.f32(float %arg_left, float %arg_right, float %arg_acc)")
        && Contains(llvm, "fneg fast float %arg_acc")
        && Contains(llvm, "call fast float @llvm.fmuladd.f32(float %arg_left, float %arg_right, float %abi_fmuladd_neg_")
        && Contains(llvm, "fneg fast float %arg_left")
        && Contains(llvm, "call fast float @llvm.fmuladd.f32(float %abi_fmuladd_neg_")
        && DoesNotContain(llvm, "fadd fast float")
        && DoesNotContain(llvm, "@llvm.fma.");
}

// Ported from LlvmIrEmissionTests.StrictFpFunctionsOptOutOfFastMathFlags.
internal fn bool StrictFpFunctionsOptOutOfFastMathFlagsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-strict-fp-opt-out-fastmath",
        raw"""
module Demo

noinline strictfp fn f32 Add(f32 left, f32 right)
{
    return left + right;
}

strictfp fn f32 Run(f32 left, f32 right)
{
    return Add(left, right);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef float @Run(float noundef %arg_left, float noundef %arg_right)")
        && Contains(llvm, " strictfp ")
        && Contains(llvm, "declare float @llvm.experimental.constrained.fadd.f32(float, float, metadata, metadata)")
        && Contains(llvm, "call float @llvm.experimental.constrained.fadd.f32(float %arg_left, float %arg_right, metadata !\"round.dynamic\", metadata !\"fpexcept.strict\") strictfp")
        && DoesNotContain(llvm, "fadd fast float %arg_left, %arg_right")
        && Contains(llvm, "call fastcc float @Add(float %arg_left, float %arg_right) strictfp")
        && DoesNotContain(llvm, "call fast fastcc float @Add(float %arg_left, %arg_right)");
}

// Ported from LlvmIrEmissionTests.StrictFpFunctionPointerCallsComposeWithKindedCallSiteAttributes.
internal fn bool StrictFpFunctionPointerCallsComposeWithKindedCallSiteAttributesImpl()
{
