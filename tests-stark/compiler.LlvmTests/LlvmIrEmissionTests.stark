        && DoesNotContain(llvm, "call fast fastcc float %arg_op");
}

// Ported from LlvmIrEmissionTests.StrictFpMultiplyAddExpressionsDoNotUseContractionIntrinsic.
internal fn bool StrictFpMultiplyAddExpressionsDoNotUseContractionIntrinsicImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-strict-fp-no-fmuladd-contraction",
        raw"""
module Demo

strictfp fn f32 Accumulate(f32 acc, f32 left, f32 right)
{
    return acc + left * right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Matches over the SSA-numbered `%vN` constrained-fadd
    // operand reduced to substring fragments on the stable intrinsic+metadata.
    return Contains(llvm, "declare float @llvm.experimental.constrained.fmul.f32(float, float, metadata, metadata)")
        && Contains(llvm, "declare float @llvm.experimental.constrained.fadd.f32(float, float, metadata, metadata)")
        && Contains(llvm, "call float @llvm.experimental.constrained.fmul.f32(float %arg_left, float %arg_right, metadata !\"round.dynamic\", metadata !\"fpexcept.strict\") strictfp")
        && Contains(llvm, "call float @llvm.experimental.constrained.fadd.f32(float %arg_acc, float %")
        && Contains(llvm, "metadata !\"round.dynamic\", metadata !\"fpexcept.strict\") strictfp")
        && DoesNotContain(llvm, "@llvm.fmuladd.")
        && DoesNotContain(llvm, "@llvm.fma.");
}

// Ported from LlvmIrEmissionTests.StrictFpConversionsUseConstrainedFloatingPointIntrinsics.
internal fn bool StrictFpConversionsUseConstrainedFloatingPointIntrinsicsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-strict-fp-constrained-conversions",
        raw"""
module Demo

strictfp fn f64 Run(f32 small, f64 wide, i32[min max] integer)
{
    stack f64 promoted = (f64)small;
    stack f32 narrowed = (f32)wide;
    stack f64 fromInteger = (f64)integer;
    stack i32[min max] backToInteger = (i32[min max])narrowed;
    return promoted + fromInteger + backToInteger;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "call double @llvm.experimental.constrained.fpext.f64.f32(float %arg_small, metadata !\"fpexcept.strict\") strictfp")
        && Contains(llvm, "call float @llvm.experimental.constrained.fptrunc.f32.f64(double %arg_wide, metadata !\"round.dynamic\", metadata !\"fpexcept.strict\") strictfp")
        && Contains(llvm, "call double @llvm.experimental.constrained.sitofp.f64.i32(i32 %arg_integer, metadata !\"round.dynamic\", metadata !\"fpexcept.strict\") strictfp")
        && Contains(llvm, "call i32 @llvm.experimental.constrained.fptosi.i32.f32(float %v")
        && Contains(llvm, "metadata !\"fpexcept.strict\") strictfp")
        && DoesNotContain(llvm, "fpext fast")
        && DoesNotContain(llvm, "fptrunc fast");
}

// Ported from LlvmIrEmissionTests.UnrecoverableUnreachablePathsLowerThroughColdTrapHelper.
internal fn bool UnrecoverableUnreachablePathsLowerThroughColdTrapHelperImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-unreachable-cold-trap-helper",
        raw"""
module Demo

enum Color { Red, Green, Blue }

unsafe fn i32[min max] Run(Color c)
{
    switch (c)
    {
        case Color.Red: return 1;
        case Color.Green: return 2;
        case Color.Blue: return 3;
    }
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare void @llvm.trap() cold noreturn nounwind")
        && Contains(llvm, "define internal dso_local coldcc void @__stark_unreachable_trap() unnamed_addr cold noreturn nounwind")
        && Contains(llvm, "call void @llvm.trap()")
        && Contains(llvm, "call coldcc void @__stark_unreachable_trap()")
        && Contains(llvm, "unreachable")
        && DoesNotContain(llvm, "invoke ")
        && DoesNotContain(llvm, "landingpad")
        && DoesNotContain(llvm, "personality")
        && DoesNotContain(llvm, "resume ")
        && DoesNotContain(llvm, "@__stark_heap_alloc");
}

// Ported from LlvmIrEmissionTests.HeapObjectCreationUsesAllocatorLowering.
internal fn bool HeapObjectCreationUsesAllocatorLoweringImpl()
{
    // PORT-NOTE: C# pins TargetInfo to x86_64-unknown-linux-gnu; the host bridge
    // here compiles with default target options, so target-specific allocator
    // assertions may diverge. Kept verbatim as the closest available signal.
    stack mut LlvmCompile c = CompileLlvmForTarget(
        "p6-heap-object-allocator-lowering",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Run()
{
    heap Box box = new Box()
    {
        Value = 7
    };
    return box.Value;
}
""", "x86_64-unknown-linux-gnu");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Matches on the `br ... !prof !N` and branch_weights
    // metadata reduced to substring fragments on their stable prefixes.
    return DoesNotContain(llvm, "@malloc(")
        && DoesNotContain(llvm, "@realloc(")
        && DoesNotContain(llvm, "@free(")
        && Contains(llvm, "define internal dso_local noalias nonnull noundef ptr @__stark_heap_alloc(i64 noundef %size, i64 noundef allocalign %alignment) unnamed_addr allocsize(0) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_heap_alloc\" nounwind")
        && Contains(llvm, "define internal dso_local void @__stark_heap_free(ptr %ptr) unnamed_addr allockind(\"free\") \"alloc-family\"=\"__stark_heap_alloc\" nounwind")
        && Contains(llvm, "define linkonce_odr hidden noalias nonnull noundef ptr @__stark_runtime_alloc(i64 noundef %size, i64 noundef allocalign %alignment) unnamed_addr allocsize(0) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_runtime_alloc\" nounwind comdat")
        && Contains(llvm, "define internal dso_local noalias noundef ptr @__stark_os_allocate(i64 noundef %size) unnamed_addr allocsize(0) allockind(\"alloc,uninitialized\") \"alloc-family\"=\"__stark_os_allocate\" nounwind")
        && Contains(llvm, "@__stark_alloc_lock = linkonce_odr hidden global i32 0, comdat, align 4")
        && Contains(llvm, "@__stark_alloc_bucket_16 = linkonce_odr hidden thread_local(localexec) global ptr null, comdat, align 8")
        && Contains(llvm, "@__stark_alloc_bucket_4096 = linkonce_odr hidden thread_local(localexec) global ptr null, comdat, align 8")
        && Contains(llvm, "define linkonce_odr hidden void @__stark_alloc_lock_acquire() unnamed_addr nounwind comdat")
        && Contains(llvm, "atomicrmw xchg ptr @__stark_alloc_lock, i32 1 acquire, align 4")
        && Contains(llvm, "store atomic i32 0, ptr @__stark_alloc_lock release, align 4")
        && DoesNotContain(llvm, "call void @__stark_alloc_lock_acquire()")
        && DoesNotContain(llvm, "call void @__stark_alloc_lock_release()")
        && Contains(llvm, "%bucket_alignment_ok = icmp ule i64 %effective_alignment, 16")
        && Contains(llvm, "%bucket_size_ok = icmp ule i64 %requested_size, 4096")
        && Contains(llvm, "br i1 %can_bucket, label %bucket_select_16, label %large_allocate")
        && Contains(llvm, "br label %bucket_16_refill")
        && Contains(llvm, "bucket_16_refill:")
        && Contains(llvm, "%bucket_16_slab_base = call noalias noundef ptr @__stark_os_allocate(i64 noundef")
        && Contains(llvm, "%bucket_16_refill_index = phi i64 [1, %bucket_16_slab_ok], [%bucket_16_refill_next, %bucket_16_refill_body]")
        && Contains(llvm, "%bucket_16_refill_offset = mul i64 %bucket_16_refill_index, 48")
        && Contains(llvm, "store i64 16, ptr %bucket_16_block_bucket_size_slot, align 8")
        && Contains(llvm, "store ptr %bucket_16_block, ptr @__stark_alloc_bucket_16, align 8")
        && Contains(llvm, "ret ptr %bucket_16_first")
        && Contains(llvm, "store i64 0, ptr %bucket_size_slot, align 8")
        && Contains(llvm, "store ptr %ptr, ptr @__stark_alloc_bucket_16, align 8")
        && Contains(llvm, "br i1 %bucket_is_4096, label %bucket_4096_push, label %free_os")
        && Contains(llvm, "call i64 asm sideeffect \"syscall\"")
        && Contains(llvm, "define internal dso_local coldcc void @__stark_oom_trap() unnamed_addr cold noreturn nounwind")
        && Contains(llvm, "call void @llvm.trap()")
        && Contains(llvm, "call coldcc void @__stark_oom_trap()")
        && Contains(llvm, ", !prof !")
        && Contains(llvm, "= !{!\"branch_weights\", i32 1, i32 2000}")
        && Contains(llvm, "call noalias nonnull noundef align 4 dereferenceable(4) ptr @__stark_heap_alloc(i64 noundef")
        && Contains(llvm, ", i64 noundef 4)")
        && Contains(llvm, "call void @__stark_heap_free(ptr %slot_box)")
        && DoesNotContain(llvm, "alloca %Box")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Run");
}

// Ported from LlvmIrEmissionTests.HeapFieldInitializationDoesNotReadUninitializedAggregateStorage.
internal fn bool HeapFieldInitializationDoesNotReadUninitializedAggregateStorageImpl()
{
    // PORT-NOTE: C# pins TargetInfo to x86_64-unknown-linux-gnu; the host bridge
    // here compiles with default target options.
    stack mut LlvmCompile c = CompileLlvm(
        "p6-heap-field-init-no-uninit-read",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

unsafe ffi fn void Touch(rawptr<Pair> pair);

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    heap mut Pair pair;
    pair.Left = left;
    pair.Right = right;
    Touch(&pair);
    return pair.Left + pair.Right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "call noalias nonnull noundef align 4 dereferenceable(8) ptr @__stark_heap_alloc")
        && Contains(llvm, "store i32 %arg_left")
        && Contains(llvm, "store i32 %arg_right")
        && DoesNotContain(llvm, "load %Pair, ptr %slot_pair")
        && DoesNotContain(llvm, "insertvalue %Pair")
        && Contains(llvm, "call void @__stark_heap_free(ptr %slot_pair)")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Run");
}

// Ported from LlvmIrEmissionTests.SystemMemoryInternalAllocatorBuiltinsLowerToRuntimeAllocatorContract.
internal fn bool SystemMemoryInternalAllocatorBuiltinsLowerToRuntimeAllocatorContractImpl()
{
    // PORT-NOTE: C# pins TargetInfo to x86_64-unknown-linux-gnu; the host bridge
    // here compiles with default target options. The per-definition header
    // checks (ExtractDefinitionHeader on Allocate/Reallocate/Free) are reduced to
    // whole-module substring assertions on the same memory-effect fragments.
    stack mut LlvmCompile c = CompileLlvmForTarget(
        "p6-system-memory-runtime-allocator-contract",
        raw"""
module System.Memory

public struct Allocator
{
    u8[0 127] Kind;

    static unsafe finite law Allocator Default()
    {
        return new Allocator()
        {
            Kind = 0
        };
    }

    unsafe finite law bool IsDefault(borrow Allocator self)
    {
        return self.Kind == 0;
    }
}

internal struct Allocation
{
    rawmutptr<i8[min max]> Pointer;
    u64[0 2 ** 63 - 1] ByteLength;
    u64[1 2 ** 63 - 1] Alignment;
    Allocator Allocator;
}

internal unsafe fn Allocation Allocate(Allocator allocator, u64[0 2 ** 63 - 1] byteLength, u64[1 2 ** 63 - 1] alignment);
internal unsafe fn Allocation Reallocate(Allocation allocation, u64[0 2 ** 63 - 1] byteLength, u64[1 2 ** 63 - 1] alignment);
internal unsafe fn void Free(Allocation allocation);

export unsafe fn i32[min max] main()
{
    stack Allocator allocator = Allocator.Default();
    stack Allocation allocation = Allocate(allocator, 16, 8);
    stack Allocation grown = Reallocate(allocation, 32, 8);
    Free(grown);
    return 0;
}
""", "x86_64-unknown-linux-gnu");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare void @llvm.trap() cold noreturn nounwind")
        && DoesNotContain(llvm, "@malloc(")
        && DoesNotContain(llvm, "@realloc(")
        && DoesNotContain(llvm, "@free(")
        && Contains(llvm, "define linkonce_odr hidden noalias nonnull noundef ptr @__stark_runtime_alloc(i64 noundef %size, i64 noundef allocalign %alignment) unnamed_addr allocsize(0) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_runtime_alloc\" nounwind comdat")
        && Contains(llvm, "define linkonce_odr hidden noalias noundef ptr @__stark_runtime_try_alloc(i64 noundef %size, i64 noundef allocalign %alignment) unnamed_addr allocsize(0) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_runtime_alloc\" nounwind comdat")
        && Contains(llvm, "define linkonce_odr hidden nonnull noundef ptr @__stark_runtime_realloc(ptr %old_ptr, i64 noundef %old_size, i64 noundef %new_size, i64 noundef allocalign %alignment) unnamed_addr allocsize(2) allockind(\"realloc,aligned\") \"alloc-family\"=\"__stark_runtime_alloc\" nounwind comdat")
        && DoesNotContain(llvm, "define linkonce_odr hidden noalias nonnull noundef ptr @__stark_runtime_realloc")
        && Contains(llvm, "define linkonce_odr hidden ptr @__stark_runtime_try_realloc(ptr %old_ptr, i64 noundef %old_size, i64 noundef %new_size, i64 noundef allocalign %alignment) unnamed_addr allocsize(2) allockind(\"realloc,aligned\") \"alloc-family\"=\"__stark_runtime_alloc\" nounwind comdat")
        && Contains(llvm, "define linkonce_odr hidden void @__stark_runtime_free(ptr %ptr) unnamed_addr allockind(\"free\") \"alloc-family\"=\"__stark_runtime_alloc\" nounwind comdat")
        && Contains(llvm, "define internal dso_local noalias noundef ptr @__stark_os_allocate(i64 noundef %size) unnamed_addr allocsize(0) allockind(\"alloc,uninitialized\") \"alloc-family\"=\"__stark_os_allocate\" nounwind")
        && Contains(llvm, "call i64 asm sideeffect \"syscall\"")
        && Contains(llvm, "@Allocate(")
        && Contains(llvm, "memory(readwrite, argmem: write)")
        && Contains(llvm, "memory(readwrite, argmem: read)")
        && Contains(llvm, "@Reallocate(")
        && Contains(llvm, "call noalias nonnull noundef ptr @__stark_runtime_alloc(i64 noundef")
        && Contains(llvm, "call nonnull noundef ptr @__stark_runtime_realloc(ptr %memory_old_ptr, i64 noundef %memory_old_byte_length, i64 noundef")
        && DoesNotContain(llvm, "call noalias nonnull noundef ptr @__stark_runtime_realloc")
        && Contains(llvm, "%realloc_bucket_size = load i64, ptr %realloc_bucket_size_slot, align 8")
        && Contains(llvm, "%realloc_bucket_size_fits = icmp ule i64 %new_size, %realloc_bucket_size")
        && Contains(llvm, "%realloc_bucket_alignment_fits = icmp ule i64 %realloc_effective_alignment, 16")
        && Contains(llvm, "br i1 %realloc_bucket_can_reuse, label %reuse_old, label %fallback")
        && Contains(llvm, "reuse_old:")
        && Contains(llvm, "ret ptr %old_ptr")
        && Contains(llvm, "fallback:")
        && Contains(llvm, "call void @llvm.memcpy.p0.p0.i64(ptr align 8 %new_ptr, ptr align 8 %old_ptr, i64 %copy_length, i1 false)")
        && Contains(llvm, "call void @__stark_runtime_free(ptr %memory_old_ptr)")
        && Contains(llvm, "call void @__stark_runtime_free(ptr %memory_ptr)")
        && Contains(llvm, "extractvalue")
        && Contains(llvm, ", 3")
        && Contains(llvm, "insertvalue")
        && Contains(llvm, "call void @llvm.trap()")
        && DoesNotContain(llvm, "LLVM body emission fallback");
}

// Ported from LlvmIrEmissionTests.StackLocalsEmitInstructionAlignmentWhenLayoutsAreKnown.
internal fn bool StackLocalsEmitInstructionAlignmentWhenLayoutsAreKnownImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-stack-locals-instruction-alignment",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] input)
{
    stack mut i32[min max] value = input;
    stack rawmutptr<i32[min max]> ptr = &value;
    *ptr = input + 1;
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "alloca i32, align 4")
        && Contains(llvm, "store i32")
        && Contains(llvm, "ptr %slot_value, align 4")
        && Contains(llvm, "load i32, ptr %slot_value, align 4");
}

