// Ported from LlvmIrEmissionTests.IntegerLaunderedMutablePointersDoNotEmitInvariantMetadata.
internal fn bool IntegerLaunderedMutablePointersDoNotEmitInvariantMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-integer-laundered-ptr-no-invariant",
        raw"""
module Demo

unsafe fn i32[min max] Read()
{
    stack mut i32[min max] value = 7;
    stack rawmutptr<i32[min max]> ptr = &value;
    stack i64[min max] address = (i64[min max])ptr;
    stack rawmutptr<i32[min max]> roundTrip = (rawmutptr<i32[min max]>)address;
    return *roundTrip;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: trailing `Assert.DoesNotMatch(@"load i32, ptr %v\d+, ..., !invariant.load !\d+")`
    // over `ExtractDefinitionBody("Read")` reduced to a DoesNotContain on the
    // invariant-tagged load form.
    return Contains(llvm, "ptrtoint")
        && Contains(llvm, "inttoptr")
        && DoesNotContain(llvm, ", !invariant.load");
}

// Ported from LlvmIrEmissionTests.TypedScalarLoadsAndStoresEmitConservativeStarkTbaa.
internal fn bool TypedScalarLoadsAndStoresEmitConservativeStarkTbaaImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-typed-scalar-loads-stores-tbaa",
        raw"""
module Demo

unsafe fn u8[0 10] Run(u8[0 9] input)
{
    stack mut u8[0 10] value = input;
    return *(&value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the two `Assert.Matches` (store/load with `!tbaa !N`, the load
    // also carrying `!range !N`) are reduced to substring checks on the TBAA
    // root/type names plus the store/load `!tbaa` tag fragment.
    return Contains(llvm, "!\"Stark TBAA\"")
        && Contains(llvm, "!\"stark.i8\"")
        && Contains(llvm, "store i8")
        && Contains(llvm, "ptr %slot_value, !tbaa")
        && Contains(llvm, "load i8, ptr")
        && Contains(llvm, "!range")
        && Contains(llvm, "!tbaa");
}

// Ported from LlvmIrEmissionTests.TypedFieldAndFixedArrayElementLoadsEmitStructPathTbaa.
internal fn bool TypedFieldAndFixedArrayElementLoadsEmitStructPathTbaaImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-typed-field-array-struct-path-tbaa",
        raw"""
module Demo

struct Buffer
{
    u8[0 100] Header;
    u8[0 100][4] Values;
}

unsafe fn u8[0 100] ReadHeader(borrow Buffer buffer)
{
    return *(&buffer.Header);
}

unsafe fn u8[0 100] ReadElement(borrow Buffer buffer)
{
    return *(&buffer.Values[2]);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the `Assert.Matches` over the load form and the two struct-path
    // TBAA access-tag node shapes (`!{!N, !N, i64 0}` / `i64 3`) are reduced to
    // substring checks on the TBAA root/type names, the load `!tbaa` tag, and the
    // characteristic access-tag offset fragments.
    return Contains(llvm, "!\"Stark TBAA\"")
        && Contains(llvm, "!\"stark.Buffer\"")
        && Contains(llvm, "!\"stark.array.u8[0 100][4]\"")
        && Contains(llvm, "load i8, ptr")
        && Contains(llvm, "!tbaa")
        && Contains(llvm, ", i64 0}")
        && Contains(llvm, ", i64 3}");
}

// Ported from LlvmIrEmissionTests.RawPointerAndPointerIntegerEscapesSuppressTbaa.
internal fn bool RawPointerAndPointerIntegerEscapesSuppressTbaaImpl()
{
    // PORT-NOTE: the C# test compiled three separate programs and asserted on
    // each. Ported as three sequential CompileLlvm calls in one Impl; the result
    // is true only if all three programs compile and all their assertions hold.
    stack mut LlvmCompile rawPointer = CompileLlvm(
        "p3-rawptr-escape-suppress-tbaa-rawptr",
        raw"""
module Demo

unsafe fn u8[0 10] Read(rawptr<u8[0 10]> ptr)
{
    return *ptr;
}
""");
    if (!Succeeds(rawPointer))
    {
        return false;
    }

    stack ascii rawPointerLlvm = Llvm(rawPointer);
    if (!(DoesNotContain(rawPointerLlvm, "!tbaa")
        && DoesNotContain(rawPointerLlvm, "!\"Stark TBAA\"")))
    {
        return false;
    }

    stack mut LlvmCompile rawCast = CompileLlvm(
        "p3-rawptr-escape-suppress-tbaa-rawcast",
        raw"""
module Demo

unsafe fn u8[0 10] ReadCast()
{
    stack mut u8[0 10] value = 1;
    stack rawmutptr<u8[0 10]> mutablePtr = &value;
    stack rawptr<u8[0 10]> readonlyPtr = (rawptr<u8[0 10]>)mutablePtr;
    return *readonlyPtr;
}
""");
    if (!Succeeds(rawCast))
    {
        return false;
    }

    stack ascii rawCastLlvm = Llvm(rawCast);
    if (!(Contains(rawCastLlvm, "load i8, ptr %slot_value")
        && DoesNotContain(rawCastLlvm, "ptrtoint")
        && DoesNotContain(rawCastLlvm, "inttoptr")
        && DoesNotContain(rawCastLlvm, "!tbaa")))
    {
        return false;
    }

    stack mut LlvmCompile escaped = CompileLlvm(
        "p3-rawptr-escape-suppress-tbaa-escaped",
        raw"""
module Demo

unsafe fn u8[0 10] ReadEscaped()
{
    stack mut u8[0 10] value = 1;
    stack rawmutptr<u8[0 10]> ptr = &value;
    if ((i64[min max])ptr == 0)
    {
        return 0;
    }

    return value;
}
""");
    if (!Succeeds(escaped))
    {
        return false;
    }

    stack ascii escapedLlvm = Llvm(escaped);
    return Contains(escapedLlvm, "ptrtoint")
        && DoesNotContain(escapedLlvm, "!tbaa");
}

// Ported from LlvmIrEmissionTests.ExclusiveBorrowMemoryAccessesEmitScopedNoAliasMetadata.
internal fn bool ExclusiveBorrowMemoryAccessesEmitScopedNoAliasMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-exclusive-borrow-scoped-noalias",
        raw"""
module Demo

struct Box
{
    u8[0 100] Value;
}

unsafe fn u8[0 100] Sum(borrow mut Box left, borrow mut Box right)
{
    left.Value = 7;
    return right.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the four `Assert.Matches` (the store/load with alias.scope +
    // noalias tags and the three distinct noalias scope/domain node shapes) are
    // reduced to substring checks on the scope-name strings and the metadata
    // tag fragments.
    return Contains(llvm, "!\"stark.noalias.Sum\"")
        && Contains(llvm, "!alias.scope")
        && Contains(llvm, "!noalias")
        && Contains(llvm, "!\"stark.noalias.Sum.param.left\"")
        && Contains(llvm, "!\"stark.noalias.Sum.param.right\"");
}

// Ported from LlvmIrEmissionTests.SameRawPointerParametersShareAliasScopeAgainstDefaultDisjointParameters.
internal fn bool SameRawPointerParametersShareAliasScopeAgainstDefaultDisjointParametersImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-same-rawptr-share-alias-scope",
        raw"""
module Demo

unsafe fn i32[min max] Check(
    rawmutptr<i32[min max]> left,
    rawmutptr<i32[min max]> mirror,
    rawmutptr<i32[min max]> other)
    where same(left, mirror)
    {
        *left = 7;
    *mirror = 9;
    return *other;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original sliced the `@Check` header to assert `%arg_left` /
    // `%arg_mirror` are NOT marked `noalias` while `%arg_other` is, and used
    // regex/Count matches for the `llvm.assume` calls and the >=2 noalias
    // stores. Reduced to whole-module substring checks: the `same`-merged scope
    // name and the `other` scope name appear, the per-param left/mirror scope
    // names do NOT (they were merged), and the assume intrinsic is declared.
    return Contains(llvm, "declare void @llvm.assume(i1 noundef)")
        && Contains(llvm, "call void @llvm.assume(i1 %abi_same_ptr_")
        && Contains(llvm, "!\"stark.noalias.Check.same.param.left.param.mirror\"")
        && Contains(llvm, "!\"stark.noalias.Check.param.other\"")
        && DoesNotContain(llvm, "!\"stark.noalias.Check.param.left\"")
        && DoesNotContain(llvm, "!\"stark.noalias.Check.param.mirror\"")
        && Contains(llvm, "!alias.scope")
        && Contains(llvm, "!noalias");
}

// Ported from LlvmIrEmissionTests.SameSliceParametersEmitDataAndLengthAssumes.
internal fn bool SameSliceParametersEmitDataAndLengthAssumesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-same-slice-data-length-assumes",
        raw"""
module Demo

struct Cell
{
    u8[0 100] Value;
}

fn u8[0 200] Check(
    Cell[] view,
    Cell[] backing,
    Cell[] other)
    where same(view, backing)
    {
        return view[0].Value + backing[0].Value + other[0].Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the four `Assert.Matches` over the data/length equality icmps
    // and their `llvm.assume` calls (with numbered abi temporaries) are reduced
    // to substring checks on the assume declaration, the icmp/assume operand
    // prefixes, and the merged/other scope names.
    return Contains(llvm, "declare void @llvm.assume(i1 noundef)")
        && Contains(llvm, "= icmp eq ptr %abi_same_left_data_")
        && Contains(llvm, "= icmp eq i64 %abi_same_left_len_")
        && Contains(llvm, "call void @llvm.assume(i1 %abi_same_data_")
        && Contains(llvm, "call void @llvm.assume(i1 %abi_same_len_")
        && Contains(llvm, "!\"stark.noalias.Check.same.param.backing.param.view\"")
        && Contains(llvm, "!\"stark.noalias.Check.param.other\"");
}

// Ported slice (part 4) of tests/compiler.Tests/LlvmIrEmissionTests.cs. Each Impl
// compiles a small program through the host LLVM bridge, requests the rendered
// `llvm` artifact, and asserts on raw LLVM-IR substrings with the System.Testing
// Contains / DoesNotContain helpers. The embedded Stark programs are reproduced
// verbatim from the C# raw string literals. The original C# tests remain in
// tests/compiler.Tests as the oracle until cutover.
//
// PORT-NOTE conventions used below:
//  - Assert.Matches(regex) is reduced to the literal substring(s) the regex
//    requires; the variable `%vN` / `!N` parts are dropped.
//  - Assert.Equal(N, CountOccurrences(...)) / .Split(...).Length checks are
//    reduced to a presence (Contains) check; the count itself is not expressible.
//  - ExtractDefinitionHeader / ExtractDefinitionBody scoping is reduced to a
//    substring check against the whole module text.

// Ported from LlvmIrEmissionTests.DynamicLocalStorageAccessesEmitScopedNoAliasMetadata.
internal fn bool DynamicLocalStorageAccessesEmitScopedNoAliasMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-dynamic-local-noalias",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Run()
{
    stack mut dynamic u64[0 2 ** 63 - 1] left = new(2);
    stack mut dynamic u64[0 2 ** 63 - 1] right = new(2);
    init left[0] = 10;
    init right[0] = 20;
    return left[0] + right[0];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the two store/load Assert.Matches regexes are reduced to the
    // literal metadata fragments they require (`!alias.scope`, `!noalias`).
    return Contains(llvm, "!\"stark.noalias.Run.dynamic.left\"")
        && Contains(llvm, "!\"stark.noalias.Run.dynamic.right\"")
        && Contains(llvm, "!alias.scope")
        && Contains(llvm, "!noalias");
}

// Ported from LlvmIrEmissionTests.RawPointerMemoryAccessesDoNotEmitScopedNoAliasMetadata.
internal fn bool RawPointerMemoryAccessesDoNotEmitScopedNoAliasMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-rawptr-no-noalias",
        raw"""
module Demo

unsafe fn u8[0 100] Read(rawptr<u8[0 100]> left, rawptr<u8[0 100]> right)
    where overlap(left, right)
    {
        return *left + *right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return DoesNotContain(llvm, "!alias.scope")
        && DoesNotContain(llvm, "!noalias")
        && DoesNotContain(llvm, "!\"stark.noalias");
}

// Ported from LlvmIrEmissionTests.OverlappingConstViewsDoNotInferNoAliasFromConstness.
internal fn bool OverlappingConstViewsDoNotInferNoAliasFromConstnessImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-const-views-no-noalias",
        raw"""
module Demo

fn i32[min max] Read(const i32[min max][] left, const i32[min max][] right)
    where overlap(left, right)
    {
        return left[0] + right[0];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: ExtractDefinitionHeader(llvm, "Read") header-scoped
    // DoesNotContain("noalias") is reduced to a whole-module DoesNotContain of
    // the stark.noalias.Read metadata plus the !noalias instruction tag.
    return DoesNotContain(llvm, "!noalias")
        && DoesNotContain(llvm, "!\"stark.noalias.Read");
}

// Ported from LlvmIrEmissionTests.RawPointerEscapesSuppressScopedNoAliasMetadataForAffectedAccesses.
