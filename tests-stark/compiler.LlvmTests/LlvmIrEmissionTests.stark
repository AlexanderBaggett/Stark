// Ported from LlvmIrEmissionTests.MixedCallMemberAndIndexPostfixChainsEmitCallAndExtracts.
internal fn bool MixedCallMemberAndIndexPostfixChainsEmitCallAndExtractsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-mixed-call-member-index-chain",
        raw"""
module Demo

struct Cell
{
    i32[min max] Value;
}

struct Holder
{
    Cell[2] Cells;
}

unsafe fn Holder Make()
{
    return new Holder()
    {
        Cells =
        {
            new Cell()
            {
                Value = 3
            },
            new Cell()
            {
                Value = 5
            }
        }
    };
}

unsafe fn i32[min max] Run()
{
    return Make().Cells[1].Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%Cell = type { i32 }")
        && Contains(llvm, "%Holder = type { [2 x %Cell] }")
        && Contains(llvm, "call fastcc %Holder @Make()")
        && Contains(llvm, "extractvalue %Holder")
        && Contains(llvm, "extractvalue [2 x %Cell]")
        && Contains(llvm, "extractvalue %Cell");
}

