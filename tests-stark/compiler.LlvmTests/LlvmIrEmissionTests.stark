    return Contains(llvm, "define internal dso_local fastcc i32 @__stark_law_clone_Math_Numbers_Add(")
        && Contains(llvm, "call fastcc i32 @__stark_law_clone_Math_Numbers_Add(i32 %arg_left, i32 %arg_right)")
        && Contains(llvm, "call fastcc i32 @Math_Numbers_Add(i32 %arg_left, i32 %arg_right)");
}

