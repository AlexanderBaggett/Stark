    stack ascii llvm = Llvm(c);
    stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
    return Contains(runBody, "add nsw i32 %arg_seed, 1")
        && DoesNotContain(runBody, "insertvalue { ptr, ptr }")
        && DoesNotContain(runBody, "extractvalue { ptr, ptr }")
        && DoesNotContain(runBody, "call fastcc")
        && DoesNotContain(llvm, "@Run___lambda_");
}

// Ported from LlvmIrEmissionTests.FiniteLawFunctionPointerCallsEmitIndirectCallEffectAttributes.
internal fn bool FiniteLawFunctionPointerCallsEmitIndirectCallEffectAttributesImpl()
{
    // PORT-NOTE: the C# extracts the single `call fastcc i32 %arg_f(...)` line by
    // regex and asserts attribute substrings on it. The port scopes those
    // substring checks to the Apply function body instead of the isolated line.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-finite-law-fnptr-effects",
        raw"""
module Demo

finite law i32[min max] Apply(fnptr<finite law i32[min max](i32[min max])> f, i32[min max] x)
{
    return f(x);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii applyBody = LlvmDefinitionBody(llvm, "Apply");
    return Contains(applyBody, "call fastcc i32 %arg_f(")
        && Contains(applyBody, "nounwind")
        && Contains(applyBody, "willreturn")
        && Contains(applyBody, "mustprogress")
        && Contains(applyBody, "nosync")
        && Contains(applyBody, "nofree")
        && Contains(applyBody, "memory(none)");
}

// Ported from LlvmIrEmissionTests.FunctionPointerCallSiteEffectAttributesFollowPointerKind.
internal fn bool FunctionPointerCallSiteEffectAttributesFollowPointerKindImpl()
{
    // PORT-NOTE: the C# extracts each `%arg_f` indirect-call line per function by
    // regex (ExtractFirstIndirectCall) and asserts attribute presence/absence on
    // it. The port scopes those substring checks to each function body. Because
    // attributes may also legitimately appear on the body's `define` header /
    // other lines, the negative checks for plain/law/finite are scoped to the
    // body text, matching the dominant signal the C# captured on the call line.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-fnptr-effects-follow-kind",
        raw"""
module Demo

fn i32[min max] ApplyPlain(fnptr<fn i32[min max](i32[min max])> f, i32[min max] x)
{
    return f(x);
}

finite i32[min max] ApplyFinite(fnptr<finite i32[min max](i32[min max])> f, i32[min max] x)
{
    return f(x);
}

law i32[min max] ApplyLaw(fnptr<law i32[min max](i32[min max])> f, i32[min max] x)
{
    return f(x);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii plainBody = LlvmDefinitionBody(llvm, "ApplyPlain");
    stack ascii finiteBody = LlvmDefinitionBody(llvm, "ApplyFinite");
    stack ascii lawBody = LlvmDefinitionBody(llvm, "ApplyLaw");
    return DoesNotContain(plainBody, "willreturn")
        && DoesNotContain(plainBody, "mustprogress")
        && DoesNotContain(plainBody, "nosync")
        && DoesNotContain(plainBody, "nofree")
        && DoesNotContain(plainBody, "memory(")
        && Contains(finiteBody, "willreturn")
        && Contains(finiteBody, "mustprogress")
        && DoesNotContain(finiteBody, "nosync")
        && DoesNotContain(finiteBody, "nofree")
        && DoesNotContain(finiteBody, "memory(")
        && DoesNotContain(lawBody, "willreturn")
        && DoesNotContain(lawBody, "mustprogress")
        && Contains(lawBody, "nosync")
        && Contains(lawBody, "nofree")
        && Contains(lawBody, "memory(none)");
}

// Ported from LlvmIrEmissionTests.UnusedPlainFunctionPointerCallsAreNotRemovedBySsaCleanup.
internal fn bool UnusedPlainFunctionPointerCallsAreNotRemovedBySsaCleanupImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-unused-plain-fnptr-not-removed",
        raw"""
module Demo

unsafe fn void Apply(fnptr<fn void(i32[min max])> op, i32[min max] value)
{
    op(value);
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii applyBody = LlvmDefinitionBody(llvm, "Apply");
    return Contains(applyBody, "call fastcc void %arg_op(i32 %arg_value)");
}

// Ported from LlvmIrEmissionTests.FunctionPointerCallsWithFiniteKnownTargetSetsEmitCalleesMetadata.
internal fn bool FunctionPointerCallsWithFiniteKnownTargetSetsEmitCalleesMetadataImpl()
{
    // PORT-NOTE: the C# matches `!callees !N` on the indirect call, captures N,
    // and asserts the `!N = !{ptr @Left, ptr @Right}` metadata line by regex. The
    // host helpers cannot resolve the dynamic metadata id, so this asserts the
    // `!callees` marker plus the effect attributes are present in the Apply body,
    // and the callee-set members appear in the whole-module text.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-fnptr-finite-known-target-callees",
        raw"""
module Demo

noinline finite law i32[min max] Left(i32[min max] value)
{
    return value;
}

noinline finite law i32[min max] Right(i32[min max] value)
{
    return value;
}

finite law i32[min max] Apply(bool chooseRight, i32[min max] value)
{
    stack mut fnptr<finite law i32[min max](i32[min max])> op = Left;
    if (chooseRight)
    {
        op = Right;
    }

    return op(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii applyBody = LlvmDefinitionBody(llvm, "Apply");
    return Contains(applyBody, "!callees")
        && Contains(applyBody, "willreturn")
        && Contains(applyBody, "mustprogress")
        && Contains(applyBody, "memory(none)")
        && Contains(llvm, "ptr @Left")
        && Contains(llvm, "ptr @Right");
}

