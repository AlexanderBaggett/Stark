        && Contains(llvm, "@Values = local_unnamed_addr constant [3 x i32] [i32 4, i32 7, i32 9], align 4")
        && Contains(llvm, "private unnamed_addr constant [2 x i32] [i32 945, i32 0], align 4");
}

