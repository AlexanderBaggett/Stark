// Ported from LlvmIrEmissionTests.OwnedScalarArrayStoragePreservesVectorizationFriendlyAlignment.
internal fn bool OwnedScalarArrayStoragePreservesVectorizationFriendlyAlignmentImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-owned-scalar-array-vectorization-alignment",
        raw"""
module Demo

unsafe fn i32[min max] ReadStack(
    i32[min max][4] input,
    u8[0 3] index)
    {
        stack mut i32[min max][4] stackValues = input;
    return stackValues[index];
}

unsafe fn i32[min max] ReadHeap(
    i32[min max][4] input,
    u8[0 3] index)
    {
        heap i32[min max][4] heapValues = input;
    return heapValues[index];
}
""");
    if (!Succeeds(c))
