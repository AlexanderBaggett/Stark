        && Contains(llvm, "store [4 x i32] %arg_input, ptr %slot_stackValues, align 16")
        && Contains(llvm, "call noalias nonnull noundef align 16 dereferenceable(16) ptr @__stark_heap_alloc")
        && Contains(llvm, ", i64 noundef 16)")
        && Contains(llvm, "store [4 x i32] %arg_input, ptr %slot_heapValues, align 16");
