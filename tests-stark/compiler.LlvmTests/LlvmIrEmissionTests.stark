// Ported from LlvmIrEmissionTests.ClosedWorldModulePrivateLawHelpersEmitAlwaysInline.
internal fn bool ClosedWorldModulePrivateLawHelpersEmitAlwaysInlineImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-closed-world-private-law-alwaysinline",
        raw"""
module Demo

unsafe fn i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

unsafe law i32[min max] Use()
{
    return Add(1, 2);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef i32 @Add(i32 noundef %arg_left, i32 noundef %arg_right) nounwind willreturn mustprogress nosync nofree memory(none) alwaysinline")
        && Contains(llvm, "define fastcc noundef i32 @Use() nounwind willreturn mustprogress nosync nofree memory(none) alwaysinline")
        && DoesNotContain(llvm, "call fastcc i32 @Add(i32 1, i32 2)")
        && Contains(llvm, "ret i32 3");
}

