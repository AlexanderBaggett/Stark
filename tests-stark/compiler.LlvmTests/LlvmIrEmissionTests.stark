        && Contains(llvm, "%Pair");
}

// Ported from LlvmIrEmissionTests.AddressForwardedAggregateStoreDoesNotReadEndedLocalLifetime.
internal fn bool AddressForwardedAggregateStoreDoesNotReadEndedLocalLifetimeImpl()
{
    // PORT-NOTE: the C# oracle compares the byte offsets of the forwarded copy
    // and the lifetime.end marker to prove the copy reads the slot before its
    // LLVM lifetime ends. The host bridge exposes no index/ordering query, so the
    // ordering invariant is reduced to the substring presence of the forwarded
    // `%slot_inner` copy operand.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-address-forwarded-store-lifetime",
        raw"""
module Demo

struct Inner
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
}

struct Outer
{
    Inner Payload;
    i64[min max] Kind;
}

enum Result
{
    Ok(Outer),
    Err,
}

unsafe ffi fn void Touch(rawptr<Inner> value);

unsafe fn Result Make(i64[min max] seed)
{
    stack mut Inner inner = new Inner()
    {
        A = seed, B = seed + 1, C = seed + 2
    };
    Touch(&inner);
    stack Outer outer = new Outer()
    {
        Payload = inner, Kind = seed
    };
    return Result.Ok(outer);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "ptr align 8 %slot_inner");
}

