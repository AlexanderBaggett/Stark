    // precede the tail-shift memmove via IndexOf ordering over the Run body; the
    // helper cannot express ordering, so both the de-numbered copy prefix and the
    // memmove are required to be present.
    return Contains(llvm, "call void @llvm.memcpy.p0.p0.i64(ptr align 8 %ret, ptr align 8 %abi_dynamic_move_at_element_ptr_")
        && Contains(llvm, "call void @llvm.memmove.p0.p0.i64")
        && DoesNotContain(llvm, "%abi_dynamic_move_at_result_slot_")
        && DoesNotContain(llvm, "load %Big")
        && DoesNotContain(llvm, "store %Big")
        && DoesNotContain(llvm, "phi %Big");
}

