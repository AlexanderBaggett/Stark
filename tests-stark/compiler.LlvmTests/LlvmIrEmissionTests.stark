// Ported from LlvmIrEmissionTests.UnsignedIntegerOperationsUseUnsignedLlvmOpcodes.
internal fn bool UnsignedIntegerOperationsUseUnsignedLlvmOpcodesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-unsigned-opcodes",
        raw"""
module Demo

unsafe fn u64[0 max] Divide(u64[0 max] left, u64[0 max] right)
{
    return left / right;
}

unsafe fn u64[0 max] Remainder(u64[0 max] left, u64[0 max] right)
{
    return left % right;
}

unsafe fn bool Greater(u64[0 max] left, u64[0 max] right)
{
    return left > right;
}

unsafe fn u64[0 max] ShiftRight(u64[0 max] value)
{
    return value >> 1;
}

unsafe fn u64[0 max] Widen(u32[0 max] value)
{
    return (u64[0 max])value;
}

unsafe fn f64 ToFloat(u64[0 max] value)
{
    return (f64)value;
}

unsafe fn u64[0 max] FromFloat(f64 value)
{
    return (u64[0 max])value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "udiv i64")
        && Contains(llvm, "urem i64")
        && Contains(llvm, "icmp ugt i64")
        && Contains(llvm, "lshr i64")
        && Contains(llvm, "zext i32")
        && Contains(llvm, "uitofp i64")
        && Contains(llvm, "fptoui double");
}

// Ported from LlvmIrEmissionTests.ShiftRightAndSignedDivisionEmitExactWhenDivisibilityIsProven.
internal fn bool ShiftRightAndSignedDivisionEmitExactWhenDivisibilityIsProvenImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p4-exact-shift-div",
        raw"""
module Demo

unsafe fn i32[min max] ShiftBack(i32[-536870912 536870911] value)
{
    return (value << 2) >> 1;
}

unsafe fn i32[min max] DivideProduct(i16[-1000 1000] value)
{
    return (value * 6) / 3;
}

unsafe fn i32[min max] DivideShift(i16[-1000 1000] value)
{
    return (value << 3) / 8;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: Assert.Equal(2, CountOccurrences("sdiv exact i32")) is reduced
    // to a presence check; the occurrence count is not expressible here.
    return Contains(llvm, "ashr exact i32")
        && Contains(llvm, "sdiv exact i32");
}

