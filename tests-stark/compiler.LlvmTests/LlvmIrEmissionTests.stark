        "llvm-p9-backend-opaque-generic-fn-boundary",
        raw"""
module Demo

[Backend(Opaque)]
unsafe fn T Identity<T>(T value)
{
    return value;
}

unsafe fn i32[min max] Run(i32[min max] value)
{
    return Identity(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii specializationHeader = LlvmDefinitionHeader(llvm, "__stark_mono_fn_Demo__Identity__i32");
    return Contains(specializationHeader, "optnone")
        && Contains(specializationHeader, "noinline")
        && DoesNotContain(specializationHeader, "alwaysinline")
