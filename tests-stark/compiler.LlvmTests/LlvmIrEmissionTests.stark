// Ported from LlvmIrEmissionTests.LargeDynamicStorageMoveAtReturnCopiesBeforeTailShift.
internal fn bool LargeDynamicStorageMoveAtReturnCopiesBeforeTailShiftImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-large-dynamic-move-at-return-before-tail-shift",
        raw"""
module Demo

struct Big
{
    i8[min max][512] Data;
    i64[min max] Len;
}

unsafe fn Big Run()
{
    stack mut dynamic Big values = new(2);
    init values[0] = new Big()
    {
        Len = 7
    };
    init values[1] = new Big()
    {
        Len = 9
    };
    return values.MoveAt(0);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
