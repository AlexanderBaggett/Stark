// Ported from LlvmIrEmissionTests.DynamicStorageMoveAtEmitsDirectLengthUpdateLoadAndMemmove.
internal fn bool DynamicStorageMoveAtEmitsDirectLengthUpdateLoadAndMemmoveImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-dynamic-move-at-direct-length-load-memmove",
        raw"""
module Demo

unsafe fn i64[min max] Run(u8[0 5] index)
{
    stack mut dynamic i64[min max] values = new(3);
    init values[0] = 10;
    init values[1] = 20;
    init values[2] = 30;
    stack i64[min max] moved = values.MoveAt(index);
    return moved + values[0] + values.Length;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // C# slices the @Run body (Regex `define fastcc … @Run(…) … ^}`) before the
    // body-scoped checks; the no-memcpy / count assertions need that scope (memcpy
    // and GEPs appear in other functions). The fallback-log check is whole-module.
    stack ascii runBody = LlvmDefinitionBody(llvm, "Run");
    return DoesNotContain(llvm, "; LLVM body emission fallback for Run")
        && Contains(runBody, "dynamic_move_at_in_bounds")
        && Contains(runBody, "dynamic_move_at_new_length")
        && CountOccurrences(runBody, "getelementptr inbounds nuw i64") >= 2
        && Contains(runBody, "call void @llvm.memmove.p0.p0.i64")
        && DoesNotContain(runBody, "llvm.memcpy")
        && Contains(runBody, "store { ptr, i64, i64 }");
}

