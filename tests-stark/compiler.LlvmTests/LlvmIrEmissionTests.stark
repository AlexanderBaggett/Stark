{
    // C# built a package image for `Facade` (Identity + Forward) and consumed it
    // via FileSystemModuleResolver; the harness builds a real `.starkpkg` so the
    // transitive inline-specialization assertions reproduce.
    stack mut LlvmCompile c = CompileLlvmWithPackageNormalized(
        "llvm-p9-manifest-nested-generic-inline-transitive",
        raw"""
import Facade
module Demo

unsafe fn i32[min max] Run(i32[min max] value)
{
