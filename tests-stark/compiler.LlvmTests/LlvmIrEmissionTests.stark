    return Contains(llvm, "define fastcc noundef nonnull dereferenceable(4) align 4 ptr @Hold(ptr noundef")
        && Contains(llvm, "captures(address, read_provenance)")
        && DoesNotContain(llvm, "nocapture")
        && DoesNotContain(llvm, "captures(ret:");
