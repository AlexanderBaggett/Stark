// Ported from LlvmIrEmissionTests.StaticStackAndAbiTemporaryAllocasEmitInEntryBlock.
internal fn bool StaticStackAndAbiTemporaryAllocasEmitInEntryBlockImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-static-abi-allocas-entry-block",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
}

unsafe ffi fn void Drain(rawmutptr<i32[min max]> ptr);

unsafe fn Big Make()
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    return new Big()
    {
        A = acc, B = acc + 1, C = acc + 2
    };
}

unsafe fn i64[min max] Run(bool flag)
{
    if (flag)
    {
        stack mut i32[min max] value = 41;
        stack rawmutptr<i32[min max]> ptr = &value;
        Drain(ptr);
        stack Big made = Make();
        return (i64[min max])*ptr + made.A;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# uses NormalizeLlvm plus IndexOf/Regex ordering checks to
    // prove the stack and ABI-callret allocas precede the entry branch. The text
    // helpers cannot express relative offsets, so this is reduced to substring
    // presence of the entry block, the in-entry alloca, the callret alloca shape,
    // the dbg.declare placement, and the negative `bb1:`-alloca check.
    return Contains(llvm, "define fastcc noundef i64 @Run")
        && Contains(llvm, "bb0:")
        && Contains(llvm, "%slot_value = alloca i32, align 4")
        && Contains(llvm, " = alloca %Big, align 8")
        && Contains(llvm, "br i1 %arg_flag")
        && Contains(llvm, "bb1:\n  call void @llvm.dbg.declare(metadata ptr %slot_value")
        && DoesNotContain(llvm, "bb1:\n  %slot_value = alloca");
}

// Ported from LlvmIrEmissionTests.SmallRecordEqualityAndInequalityEmitScalarLeafComparisons.
internal fn bool SmallRecordEqualityAndInequalityEmitScalarLeafComparisonsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-small-record-equality-scalar-leaf",
        raw"""
module Demo

record Pair(i32[min max] Left, i32[min max] Right)
{
}

unsafe fn bool Equal(Pair left, Pair right)
{
    return left == right;
}

unsafe fn bool NotEqual(Pair left, Pair right)
{
    return left != right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef i1 @Equal(%Pair noundef %arg_left, %Pair noundef %arg_right)")
        && Contains(llvm, "define fastcc noundef i1 @NotEqual(%Pair noundef %arg_left, %Pair noundef %arg_right)")
        && Contains(llvm, "extractvalue %Pair %arg_left, 0")
        && Contains(llvm, "extractvalue %Pair %arg_right, 1")
        && Contains(llvm, "icmp eq i32")
        && Contains(llvm, "icmp ne i32")
        && Contains(llvm, "and i1")
        && Contains(llvm, "or i1")
        && DoesNotContain(llvm, "; LLVM body emission fallback for Equal")
        && DoesNotContain(llvm, "; LLVM body emission fallback for NotEqual");
}

