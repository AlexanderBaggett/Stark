        "llvm-p9-private-local-update-wrapper-alwaysinline",
        raw"""
module Demo

record Inner(i32[min max] Value)
{
}
record Box(Inner Inner)
{
}

unsafe fn i32[min max] Bump(borrow Box box, i32[min max] delta)
{
    stack mut i32[min max] current = box.Inner.Value;
    current += delta;
    return current;
}

unsafe fn i32[min max] Use(borrow Box box, i32[min max] delta)
{
    return Bump(box, delta);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the Regex.IsMatch for `define ...@Bump(...alwaysinline` is
    // reduced to whole-module substring checks.
    return Contains(llvm, "@Bump(")
        && Contains(llvm, "alwaysinline");
}

