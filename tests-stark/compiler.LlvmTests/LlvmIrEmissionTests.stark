// Ported slice (P3) of tests/compiler.Tests/LlvmIrEmissionTests.cs. Each Impl
// compiles the embedded Stark program through the host compiler, requests the
// rendered `llvm` artifact text, and re-expresses the original xUnit assertions
// with the System.Testing Contains/DoesNotContain helpers. The embedded program
// for each method is kept verbatim from the C# raw string literal.
//
// PORT-NOTE conventions: the C# host exposes both a whitespace-normalized
// `GetLlvm` and a raw `GetLlvmRaw`; the Stark `Llvm` helper returns the raw
// text. Assertions originally expressed with `Assert.Matches` (regex),
// `ExtractDefinitionBody`/`ExtractDefinitionHeader` (per-function slicing), or
// `Assert.False(Regex.IsMatch(...))` are reduced to the closest stable
// substring check over the whole module text, since the text helpers here
// cannot run regexes or slice a single definition body. Such reductions carry
// a `// PORT-NOTE:` comment naming what was dropped.

// Ported from LlvmIrEmissionTests.MutableGlobalsEmitRealDefinitionsStoresAndLoads.
internal fn bool MutableGlobalsEmitRealDefinitionsStoresAndLoadsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-mutable-globals-defs-stores-loads",
        raw"""
module Demo

static mut i32[min max] Counter = 0;

unsafe finite i32[min max] Run()
{
    Counter = Counter + 7;
    return Counter;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original `Assert.Matches(@"store i32 %[^,]+, ptr @Counter")`
    // reduced to a substring check on the store target.
    return Contains(llvm, "@Counter = global i32 0")
        && Contains(llvm, "load i32, ptr @Counter")
        && Contains(llvm, "ptr @Counter");
}

// Ported from LlvmIrEmissionTests.MutableGlobalLoadsAreNotForwardedAcrossDestructorBackedCalls.
internal fn bool MutableGlobalLoadsAreNotForwardedAcrossDestructorBackedCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-mutable-global-loads-not-forwarded",
        raw"""
module Demo

static mut i32[min max] Counter = 0;

struct LargeResource
{
    i8[min max][512] Data;
    i32[min max] Value;

    drop
    {
        Counter = Counter + self.Value;
    }
}

enum Result
{
    Ok(LargeResource),
    Err(i32[min max])
}

unsafe fn LargeResource MakeResource(i32[min max] value)
{
    stack mut LargeResource resource = new LargeResource();
    resource.Value = value;
    return resource;
}

unsafe fn Result MakeOk(i32[min max] value)
{
    stack LargeResource resource = MakeResource(value);
    return Result.Ok(resource);
}

unsafe fn void RunSuccessPayloadMove()
{
    stack Result result = MakeOk(7);
    switch (result)
    {
        case Result.Ok(var payload):
            stack LargeResource value = payload;
        case Result.Err(var code):
    }

    return;
}

export unsafe fn i32[min max] main()
{
    Counter = 0;
    RunSuccessPayloadMove();
    if (Counter != 7)
    {
        return 1;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original test sliced the `@main` body and asserted the
    // `load i32, ptr @Counter` falls AFTER the `call ... @RunSuccessPayloadMove`
    // (no load-forwarding across the destructor-backed call) and the success
    // path keeps `ret i32 0` rather than `ret i32 1`. Without body-slicing /
    // index comparison here, reduced to: the call survives, a post-call Counter
    // load exists, and no `ret i32 1` failure branch was folded in.
    return Contains(llvm, "call fastcc void @RunSuccessPayloadMove()")
        && Contains(llvm, "load i32, ptr @Counter")
        && DoesNotContain(llvm, "ret i32 1");
}

// Ported from LlvmIrEmissionTests.LibraryBuildQualifiesRootGlobalSymbolsAndPreservesExportNames.
internal fn bool LibraryBuildQualifiesRootGlobalSymbolsAndPreservesExportNamesImpl()
{
    // C# passed CompilerOptions(QualifyModuleSymbols: true) + GetLlvm; the
    // harness requests the normalized artifact with the `;qualify` option flag.
    stack mut LlvmCompile c = CompileLlvmNormalizedQualified(
        "p3-library-qualifies-root-globals",
        raw"""
module Math

public const Answer = 42;
internal static mut i32[min max] Counter = 0;
static i32[min max] Hidden = 1;
export static mut i32[min max] Visible = 0;

unsafe finite i32[min max] Run()
{
    Counter = Counter + 7;
    return Counter;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: trailing `Assert.Matches(@"store i32 %[^,]+, ptr @Math_Counter")`
    // reduced to a substring check on the store target.
    return Contains(llvm, "@Math_Answer = local_unnamed_addr constant i8 42")
        && Contains(llvm, "@Math_Counter = global i32 0")
        && Contains(llvm, "@Math_Hidden = internal unnamed_addr constant i32 1")
        && Contains(llvm, "@Visible = global i32 0")
        && Contains(llvm, "load i32, ptr @Math_Counter")
        && Contains(llvm, "ptr @Math_Counter");
}

// Ported from LlvmIrEmissionTests.ExecutableInternalizationCanMakeRootModulePrivateFunctionsLocal.
internal fn bool ExecutableInternalizationCanMakeRootModulePrivateFunctionsLocalImpl()
{
    // C# passed CompilerOptions(InternalizeModulePrivate: true) + GetLlvmRaw; the
    // harness requests the RAW artifact with the `;internalize` option flag.
    stack mut LlvmCompile c = CompileLlvmInternalized(
        "p3-executable-internalization-private-local",
        raw"""
module Demo

noinline unsafe fn i32[min max] Helper(i32[min max] value)
{
    return value + 1;
}

export unsafe ffi fn i32[min max] main(i32[min max] value)
{
    return Helper(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define internal dso_local fastcc noundef range(i32 -2147483647, -2147483648) i32 @Helper(i32 noundef %arg_value)")
        && Contains(llvm, "define i32 @main(i32 %arg_value)")
        && Contains(llvm, "call fastcc i32 @Helper(i32 %arg_value)")
        && DoesNotContain(llvm, "define internal dso_local i32 @main");
}

// Ported from LlvmIrEmissionTests.RootFunctionSymbolIsQualifiedWhenItWouldCollideWithFfiImport.
internal fn bool RootFunctionSymbolIsQualifiedWhenItWouldCollideWithFfiImportImpl()
{
    // C# supplied an InMemoryModuleResolver for the imported `Win32` module + GetLlvm;
    // the harness stages Win32 to a temp search directory and requests the
    // normalized artifact, so the symbol-collision qualification reproduces.
    stack mut LlvmCompile c = CompileLlvmWithModuleNormalized(
        "p3-root-fn-qualified-ffi-collision",
        raw"""
import Win32
module System.Runtime.Platform

internal unsafe fn void ExitProcess(i32[min max] code)
{
    Win32.ExitProcess(code);
    return;
}
""",
        "Win32",
        raw"""
module Win32

internal unsafe ffi fn void ExitProcess(i32[min max] code);
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @System_Runtime_Platform_ExitProcess(i32 %arg_code)")
        && Contains(llvm, "declare void @ExitProcess(i32)")
        && Contains(llvm, "call void @ExitProcess(i32 %arg_code)")
        && DoesNotContain(llvm, "define fastcc void @ExitProcess(");
}

