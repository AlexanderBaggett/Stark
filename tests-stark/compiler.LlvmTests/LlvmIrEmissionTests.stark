// Ported from LlvmIrEmissionTests.ImportedSourceBackedGenericSpecializationsUseLinkOnceOdrComdatDefinitionsAndInlineSmallCalls.
internal fn bool ImportedSourceBackedGenericSpecializationsUseLinkOnceOdrComdatDefinitionsAndInlineSmallCallsImpl()
{
    // C# supplied the imported `Facade` generic module via InMemoryModuleResolver;
    // staged here to a temp search directory so the linkonce_odr/comdat
    // specialization assertions are reproducible against the normalized LLVM.
    stack mut LlvmCompile c = CompileLlvmWithModuleNormalized(
        "llvm-p9-imported-generic-linkonce-odr-comdat",
        raw"""
import Facade
module Demo

unsafe fn i32[min max] Run(i32[min max] value)
{
    return Facade.Identity(value);
}
""",
        "Facade",
        raw"""
module Facade

public unsafe fn T Identity<T>(T value)
{
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii specializationHeader = LlvmDefinitionHeader(llvm, "__stark_mono_fn_Facade__Facade_Identity__i32");
    return Contains(llvm, "$__stark_mono_fn_Facade__Facade_Identity__i32 = comdat any")
        && Contains(specializationHeader, "define linkonce_odr dso_local fastcc i32 @__stark_mono_fn_Facade__Facade_Identity__i32(")
        && Contains(specializationHeader, "local_unnamed_addr")
        && Contains(specializationHeader, "comdat")
        && DoesNotContain(llvm, "call fastcc i32 @__stark_mono_fn_Facade__Facade_Identity__i32(")
        && DoesNotContain(llvm, "define internal dso_local fastcc i32 @__stark_mono_fn_Facade__Facade_Identity__i32(");
}

// Ported from LlvmIrEmissionTests.ImportedSourceBackedMutableBorrowGenericSpecializationsDoNotDenyArgumentMemoryAccess.
internal fn bool ImportedSourceBackedMutableBorrowGenericSpecializationsDoNotDenyArgumentMemoryAccessImpl()
{
    // C# supplied the imported `Facade.Box<T>` generic module via
    // InMemoryModuleResolver; staged here to a temp search directory so the
    // header-scoped `argmem: none` absence check is reproducible against the
    // normalized LLVM. The C# oracle finds the Box_Store specialization define
    // line by predicate; the mangled symbol is __stark_mono_fn_Facade__Facade_Box_Store__i32.
    stack mut LlvmCompile c = CompileLlvmWithModuleNormalized(
        "llvm-p9-imported-mutable-borrow-generic-argmem",
        raw"""
import Facade
module Demo

unsafe fn void Run()
{
    stack mut Facade.Box<i32[min max]> box = new Facade.Box<i32[min max]>()
    {
        Value = 1
    };
    box.Store(2);
    return;
}
""",
        "Facade",
        raw"""
module Facade

public struct Box<T>
{
    T Value;

    public unsafe fn void Store(mut borrow Box<T> self, T value)
    {
        TouchOther();
        self.Value = value;
        return;
    }
}

public unsafe ffi fn void TouchOther();
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    stack ascii specializationHeader = LlvmDefinitionHeader(llvm, "__stark_mono_fn_Facade__Facade_Box_Store__i32");
    return DoesNotContain(specializationHeader, "argmem: none");
}

// Ported from LlvmIrEmissionTests.ManifestBackedGenericCallsInlineSmallConcreteMonomorphizedSymbolsFromPackageImageTemplates.
internal fn bool ManifestBackedGenericCallsInlineSmallConcreteMonomorphizedSymbolsFromPackageImageTemplatesImpl()
{
    // C# built a package image for `Facade` and consumed it via
    // FileSystemModuleResolver; the harness builds a real `.starkpkg` and stages
    // it as a search directory so the package-template inline-specialization
    // assertions reproduce.
    stack mut LlvmCompile c = CompileLlvmWithPackageNormalized(
        "llvm-p9-manifest-generic-inline-small-mono",
        raw"""
import Facade
module Demo

unsafe fn i32[min max] Run(i32[min max] value)
{
    return Facade.Identity(value);
}
""",
        "Facade",
        raw"""
module Facade

public unsafe fn T Identity<T>(T value)
{
    return value;
}
""");
    // PORT-NOTE: the C# oracle uses a TYPED-ONLY manifest (function bodies
    // stripped via WithEffectiveLegacyCompilerSectionCopies) so the CONSUMER
    // materializes `@__stark_mono_fn_Demo__…` as `internal`. The CLI `--emit-lib`
    // package is a FULL image, so the consumer reuses the library's
    // `@__stark_mono_fn_Facade__…` `linkonce_odr` specialization — a different,
    // equally valid strategy. Typed-only package building isn't exposed by the CLI
    // (PAINPOINTS #4), so only the package build + cross-package compile is checked.
    return Succeeds(c);
}

// Ported from LlvmIrEmissionTests.ManifestBackedGenericInlineClosureCallSpecializesFromPackageImageTypedBody.
internal fn bool ManifestBackedGenericInlineClosureCallSpecializesFromPackageImageTypedBodyImpl()
{
    // PORT-NOTE: the original builds a typed-only package image for `Facade`
    // (closure template) and inspects the typed body kinds plus the consumer's
    // Run body; the helper models neither package images nor body scoping, so the
    // consumer program is compiled and reduced to Succeeds.
    stack mut LlvmCompile c = CompileLlvmWithPackageNormalized(
        "llvm-p9-manifest-generic-inline-closure-specializes",
        raw"""
import Facade
module Demo

inline fn i32[min max] LocalApply(inline closure<fn i32[min max](i32[min max])> op)
{
    stack i32[min max] value = 4;
    return Facade.Apply(value, op);
}

fn i32[min max] Run(i32[min max] offset)
{
    return LocalApply(capture(copy offset) (i32[min max] value) => value + offset);
}
""",
        "Facade",
        raw"""
module Facade

public inline fn T Apply<T>(T value, inline closure<fn T(T)> op)
{
    return op(value);
}
""");
    // PORT-NOTE: typed-only manifest closure-body specialization isn't reproducible
    // via the full `--emit-lib` package (PAINPOINTS #4); only the package build +
    // cross-package compile is checked.
    return Succeeds(c);
}

// Ported from LlvmIrEmissionTests.ManifestBackedNestedGenericCallsInlineTransitiveSmallConcreteMonomorphizedSymbolsFromPackageImageTemplates.
