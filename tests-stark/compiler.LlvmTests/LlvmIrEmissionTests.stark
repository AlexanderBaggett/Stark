    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @Step(ptr noundef noalias sret(%Big) nonnull dereferenceable(32) align 8 %ret, ptr noundef nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %arg_value, i64 noundef %arg_delta)")
        && Contains(llvm, "call fastcc void @Step(ptr noalias sret(%Big)")
        && Contains(llvm, "ptr noundef nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8")
        && DoesNotContain(llvm, "define fastcc %Big @Step(");
}

// Ported from LlvmIrEmissionTests.AggregateBranchJoinEmitsByValuePhiNode.
internal fn bool AggregateBranchJoinEmitsByValuePhiNodeImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-agg-branch-join-phi",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] Run(bool flag)
{
    stack mut Box box = new Box()
    {
        Value = 0
    };
    if (flag)
    {
        box = new Box()
        {
            Value = 1
        };
    }
    else
    {
        box = new Box()
        {
            Value = 2
        };
    }

    return box.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "phi %Box")
        && Contains(llvm, "extractvalue %Box")
        && DoesNotContain(llvm, "load %Box, ptr %slot_box");
}

// Ported from LlvmIrEmissionTests.ValueReceiverMethodsLowerToDirectAggregateCalls.
internal fn bool ValueReceiverMethodsLowerToDirectAggregateCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-value-receiver-direct-agg",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;

    unsafe fn i32[min max] Read(Box box)
    {
        stack i32[min max] a = box.Value + (box.Value / 3);
        stack i32[min max] b = a - (a / 5);
        stack i32[min max] c = b + (b / 7);
        stack i32[min max] d = c - (c / 11);
        stack i32[min max] e = d + (d / 13);
        stack i32[min max] f = e - (e / 17);
        stack i32[min max] g = f + (f / 19);
        stack i32[min max] h = g - (g / 23);
        stack i32[min max] i = h + (h / 29);
        stack i32[min max] j = i - (i / 31);
        stack i32[min max] k = j + (j / 37);
        stack i32[min max] l = k - (k / 41);
        stack i32[min max] m = l + (l / 43);
        return m;
    }
}

unsafe fn i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 7
    };
    return box.Read();
}
""");
    if (!Succeeds(c))
    {
        return false;
