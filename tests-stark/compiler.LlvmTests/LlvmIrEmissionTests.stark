        && Contains(llvm, "alwaysinline");
}

// Ported from LlvmIrEmissionTests.ModulePrivateLocalUpdateWrappersEmitAlwaysInline.
internal fn bool ModulePrivateLocalUpdateWrappersEmitAlwaysInlineImpl()
{
