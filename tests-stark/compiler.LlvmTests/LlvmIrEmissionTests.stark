    // checked via substring (they differ enough to distinguish the two functions);
    // the per-header negative guards are dropped, while the module-wide
    // `DoesNotContain("declare void @llvm.assume(i1 noundef)")` guard is preserved.
    return Contains(llvm, "ptr noundef nonnull dereferenceable(4) align 4 readonly nocapture %arg_input")
