// Ported from LlvmIrEmissionTests.MutableAggregateGlobalsEmitConcreteInitializersAndStores.
internal fn bool MutableAggregateGlobalsEmitConcreteInitializersAndStoresImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-mutable-aggregate-globals-stores",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

static mut Pair Current = new Pair()
{
    Left = 5, Right = 8
};
static mut i32[min max][3] Values =
{
    1, 2, 3
};

unsafe finite i32[min max] Run()
{
    Current.Right = 9;
    Values[1] = 7;
    return Current.Right + Values[1];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%Pair = type { i32, i32 }")
        && Contains(llvm, "@Current = global %Pair { i32 5, i32 8 }")
        && Contains(llvm, "@Values = global [3 x i32] [i32 1, i32 2, i32 3]")
        && Contains(llvm, "getelementptr inbounds nuw %Pair, ptr @Current, i32 0, i32 1")
        && Contains(llvm, "store i32 9")
        && DoesNotContain(llvm, "store %Pair")
        && Contains(llvm, "ptr @Current")
        && Contains(llvm, "getelementptr inbounds nuw [3 x i32], ptr @Values, i32 0, i32 1")
        && Contains(llvm, "store i32 7")
        && Contains(llvm, "load i32")
        && DoesNotContain(llvm, "load [3 x i32]")
        && DoesNotContain(llvm, "store [3 x i32]")
        && Contains(llvm, "ptr @Values");
}

