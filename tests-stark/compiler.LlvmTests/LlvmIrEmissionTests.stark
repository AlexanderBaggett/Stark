// Ported from LlvmIrEmissionTests.IntegralAndScientificFloatConstantsEmitValidHexFloatLiterals.
internal fn bool IntegralAndScientificFloatConstantsEmitValidHexFloatLiteralsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p3-integral-scientific-float-hex-literals",
        raw"""
module Demo

const f64[23] Pow10 =
{
    1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22
};

unsafe finite f64 ScalarScientific()
{
    return 1e17;
}

unsafe finite f64 Run()
{
    return Pow10[17] + ScalarScientific();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the final `Assert.False(Regex.IsMatch(...))` guarding against
    // any surviving bare-integer / bare-scientific `double`/`float` literal is a
    // negative regex with no text-helper equivalent; reduced to positive hex
    // float substring checks plus a DoesNotContain on the canonical bug forms.
    return Contains(llvm, "@Pow10 = local_unnamed_addr constant [23 x double] [double 0x3FF0000000000000, double 0x4024000000000000")
        && Contains(llvm, "double 0x4376345785D8A000")
        && Contains(llvm, "double 0x4480F0CF064DD592")
        && Contains(llvm, "ret double 0x4376345785D8A000")
        && DoesNotContain(llvm, "double 1E+17")
        && DoesNotContain(llvm, "double 1,");
}

