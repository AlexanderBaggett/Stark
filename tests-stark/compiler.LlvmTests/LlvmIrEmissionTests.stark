// Ported from LlvmIrEmissionTests.ImportedStarkFunctionUsesQualifiedDependencySymbol.
internal fn bool ImportedStarkFunctionUsesQualifiedDependencySymbolImpl()
{
    // C# supplied an InMemoryModuleResolver providing the imported `Math` module;
    // the Stark harness stages that dependency to a temp directory and passes it
    // as a host search directory, so the cross-module `@Math_Add`
    // declaration/call assertions are reproducible.
    stack mut LlvmCompile c = CompileLlvmWithModuleNormalized(
        "p8-imported-stark-fn-qualified",
        raw"""
import Math
module Demo

unsafe ffi fn void Touch();

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    Touch();
    return Math.Add(left, right);
}
""",
        "Math",
        raw"""
module Math

public unsafe finite law i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare fastcc i32 @Math_Add(i32, i32)")
        && Contains(llvm, "call fastcc i32 @Math_Add(i32");
}

// Ported from LlvmIrEmissionTests.ImportedSourceAsmFunctionsEmitExternalDeclarationsAndCalls.
internal fn bool ImportedSourceAsmFunctionsEmitExternalDeclarationsAndCallsImpl()
{
    // C# supplied the imported `Syscall` asm module via InMemoryModuleResolver
    // plus LlvmTargetInfo("x86_64-unknown-linux-gnu"); staged here to a temp
    // search directory with the matching target so the external-declaration/call
    // assertions are reproducible against the normalized LLVM.
    stack mut LlvmCompile c = CompileLlvmWithModuleForTargetNormalized(
        "p8-imported-source-asm-extern",
        raw"""
import Syscall
module Demo

unsafe fn i64[min max] Run(rawptr<i8[min max]> path)
{
    return Syscall.Syscall2(2, path);
}
""",
        "Syscall",
        raw"""
module Syscall

public unsafe ffi asm(x86_64) fn i64[min max] Syscall2(i64[min max] number, rawptr<i8[min max]> path)
    in("rax") number,
    in("rdi") path,
    out("rax") return,
    clobber("rcx", "r11")
{
    "syscall"
}
""",
        "x86_64-unknown-linux-gnu");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare i64 @Syscall2")
        && Contains(llvm, "call i64 @Syscall2(i64 2, ptr")
        && DoesNotContain(llvm, "; imported asm definition: Syscall.Syscall2")
        && DoesNotContain(llvm, "define i64 @Syscall2");
}

// Ported from LlvmIrEmissionTests.ImportedGlobalsUseQualifiedDependencySymbolsAndFoldConstValues.
internal fn bool ImportedGlobalsUseQualifiedDependencySymbolsAndFoldConstValuesImpl()
{
    // C# supplied the imported `Math` globals module via InMemoryModuleResolver;
    // staged here to a temp search directory so the qualified-symbol declaration
    // and load/store assertions are reproducible against the normalized LLVM.
    // PORT-NOTE: the C# oracle's Assert.Matches(@"store i32 %[^,]+, ptr
    // @Math_Counter") is reduced to a `store i32` substring (this program's only
    // store writes Counter).
    stack mut LlvmCompile c = CompileLlvmWithModuleNormalized(
        "p8-imported-globals-qualified-fold",
        raw"""
import Math
module Demo

unsafe fn i32[min max] Run()
{
    Math.Counter = Math.Counter + 7;
    return Math.Counter + Math.Answer + Math.Hidden;
}
""",
        "Math",
        raw"""
module Math

public const Answer = 3;
public static i32[min max] Hidden = 2;
public static mut i32[min max] Counter = 1;
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "; imported declaration: Math.Answer")
        && Contains(llvm, "@Math_Answer = external local_unnamed_addr constant i8")
        && Contains(llvm, "; imported declaration: Math.Hidden")
        && Contains(llvm, "@Math_Hidden = external local_unnamed_addr constant i32")
        && Contains(llvm, "; imported declaration: Math.Counter")
        && Contains(llvm, "@Math_Counter = external global i32")
        && Contains(llvm, "load i32, ptr @Math_Counter")
        && Contains(llvm, "store i32")
        && DoesNotContain(llvm, "load i8, ptr @Math_Answer");
}

// Ported from LlvmIrEmissionTests.ImportedReadonlyScalarArrayDeclarationsCarryVectorizationFriendlyAlignment.
internal fn bool ImportedReadonlyScalarArrayDeclarationsCarryVectorizationFriendlyAlignmentImpl()
{
    // C# supplied the imported `Tables` module via InMemoryModuleResolver; staged
    // here to a temp search directory so the external-constant alignment and
    // invariant-load assertions are reproducible against the normalized LLVM.
    // PORT-NOTE: the C# oracle's Assert.Matches(@"load i32, ptr %v\d+, align 4,
    // !invariant\.load !\d+") is reduced to a stable substring Contains.
    stack mut LlvmCompile c = CompileLlvmWithModuleNormalized(
        "p8-imported-readonly-array-align",
        raw"""
import Tables
module Demo

unsafe fn i32[min max] Read(u8[0 3] index)
{
    return Tables.Lookup[index];
}
""",
        "Tables",
        raw"""
module Tables

public static i32[min max][4] Lookup =
{
    1, 2, 3, 4
};
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "@Tables_Lookup = external constant [4 x i32], align 16")
        && Contains(llvm, ", align 4, !invariant.load !");
}

// Ported from LlvmIrEmissionTests.PackageImageBackedImportedReadonlyDataPreservesInvariantMetadata.
internal fn bool PackageImageBackedImportedReadonlyDataPreservesInvariantMetadataImpl()
{
    // C# built a real package image for `Facade` (PackageImageBuilder) and
    // consumed it through a FileSystemModuleResolver. The harness now builds a
    // genuine `.starkpkg` from the library source and stages it as a search
    // directory, so the cross-package invariant-load assertions are reproducible.
    // PORT-NOTE: the C# Assert.Matches(@"load i32, ptr %v\d+, align 4,
    // !invariant\.load !\d+") is reduced to a stable substring Contains.
    stack mut LlvmCompile c = CompileLlvmWithPackage(
        "p8-package-image-readonly-invariant",
        raw"""
import Facade
module Demo

unsafe fn i32[min max] Read(u8[0 2] index)
{
    return Facade.Values[index] + Facade.Counter;
}
""",
        "Facade",
        raw"""
module Facade

public static i32[min max][3] Values =
{
    1, 2, 3
};
public static mut i32[min max] Counter = 1;
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "@Facade_Values = external constant [3 x i32]")
        && Contains(llvm, "external global i32")
        && Contains(llvm, ", align 4, !invariant.load !");
}

// Ported from LlvmIrEmissionTests.ImmutableGlobalAddressesLowerWithoutPointerCasts.
internal fn bool ImmutableGlobalAddressesLowerWithoutPointerCastsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-immutable-global-addr-no-cast",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

static i32[min max] Counter = 0;
static Box Current = new Box()
{
    Value = 5
};

unsafe fn rawptr<i32[min max]> CounterPtr()
{
    return &Counter;
}

unsafe fn rawptr<i32[min max]> FieldPtr()
{
    return &(Current.Value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: Assert.Equal(0, CountOccurrences("getelementptr inbounds i8")) is
    // reduced to a DoesNotContain presence check.
    return Contains(llvm, "@Counter = constant i32 0")
        && Contains(llvm, "@Current = constant %Box { i32 5 }")
        && DoesNotContain(llvm, "@Counter = local_unnamed_addr constant i32 0")
        && DoesNotContain(llvm, "@Current = local_unnamed_addr constant %Box { i32 5 }")
        && Contains(llvm, "ret ptr @Counter")
        && Contains(llvm, "getelementptr inbounds nuw %Box, ptr @Current, i32 0, i32 0")
        && DoesNotContain(llvm, "getelementptr inbounds i8");
}

// Ported from LlvmIrEmissionTests.ImportedAggregateFunctionsUseCrossModuleAbiDeclarations.
internal fn bool ImportedAggregateFunctionsUseCrossModuleAbiDeclarationsImpl()
{
    // C# supplied the imported `Geometry` module via InMemoryModuleResolver;
    // staged here to a temp search directory so the cross-module aggregate-ABI
    // declaration/call assertions are reproducible against the normalized LLVM.
    stack mut LlvmCompile c = CompileLlvmWithModuleNormalized(
        "p8-imported-aggregate-cross-module-abi",
        raw"""
import Geometry
module Demo

export unsafe fn i32[min max] main()
{
    return Geometry.Read(Geometry.Make());
}
""",
        "Geometry",
        raw"""
module Geometry

public struct Box
{
    i32[min max] Value;
}

public unsafe fn Box Make()
{
    return new Box()
    {
        Value = 7
    };
}

public unsafe fn i32[min max] Read(Box box)
{
    return box.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare fastcc %Geometry_Box @Geometry_Make()")
        && Contains(llvm, "declare fastcc i32 @Geometry_Read(%Geometry_Box)")
        && Contains(llvm, "call fastcc %Geometry_Box @Geometry_Make()")
        && Contains(llvm, "call fastcc i32 @Geometry_Read(%Geometry_Box");
}

// Ported from LlvmIrEmissionTests.ConstantImportedLawCallsFoldBeforeClosedWorldCloneEmission.
internal fn bool ConstantImportedLawCallsFoldBeforeClosedWorldCloneEmissionImpl()
{
    // C# supplied the imported `Math` module via InMemoryModuleResolver; the
    // Stark harness stages it to a temp search directory so the cross-module law
    // fold assertions are reproducible against the normalized LLVM.
    stack mut LlvmCompile c = CompileLlvmWithModuleNormalized(
        "p8-const-imported-law-fold",
        raw"""
import Math
module Demo

unsafe law i32[min max] Use()
{
    return Math.UseLaw();
}
""",
        "Math",
        raw"""
module Math

unsafe law i32[min max] LawOnly()
{
    return 1;
}

public unsafe law i32[min max] UseLaw()
{
    return LawOnly();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return DoesNotContain(llvm, "__stark_law_clone_Math_UseLaw")
        && DoesNotContain(llvm, "call fastcc i32 @Math_UseLaw()")
        && Contains(llvm, "ret i32 1");
}

// PORT-NOTE conventions used across this file:
//  - The CompileLlvm helper exposes no CompilerOptions surface, so imported
//    sibling modules (InMemoryModuleResolver / FileSystemModuleResolver inputs)
//    cannot be supplied. Tests that depend on an imported `Math`/`Facade` module
//    compile the embedded root program through CompileLlvm and reduce to the
//    nearest available signal (Succeeds) plus whole-module substring checks.
//  - QualifyModuleSymbols / EmitLlvmIr options have no helper equivalent; the
//    embedded program is compiled and the qualified-symbol fragments are matched
//    against the whole module text where the default emission already qualifies.
//  - ExtractDefinitionHeader / ExtractDefinitionBody / regex header scoping is
//    reduced to whole-module Contains / DoesNotContain checks against `llvm`.
//  - Package-image (manifest) round-trips (PackageImageBuilder, typed-only
//    manifest, FileSystemModuleResolver) cannot be modeled by the helper; those
//    tests compile the consumer program and reduce to Succeeds.

// Ported from LlvmIrEmissionTests.ConstantImportedLawCallsStillFoldInsideImpureCallers.
internal fn bool ConstantImportedLawCallsStillFoldInsideImpureCallersImpl()
{
    // C# supplied the imported `Math` module via InMemoryModuleResolver; staged
    // here to a temp search directory so the law-fold-inside-impure-caller
    // assertions are reproducible against the normalized LLVM.
    stack mut LlvmCompile c = CompileLlvmWithModuleNormalized(
        "llvm-p9-const-imported-law-fold-impure",
        raw"""
import Math
module Demo

unsafe law i32[min max] UseLawClone()
{
    return Math.UseLaw();
}

unsafe fn i32[min max] UseDirect()
{
    Touch();
    return Math.UseLaw();
}

unsafe ffi fn void Touch();
""",
        "Math",
        raw"""
module Math

public unsafe law i32[min max] UseLaw()
{
    return 1;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return DoesNotContain(llvm, "__stark_law_clone_Math_UseLaw")
        && DoesNotContain(llvm, "call fastcc i32 @Math_UseLaw()")
        && Contains(llvm, "call void @Touch()")
        && Contains(llvm, "ret i32 1");
}

