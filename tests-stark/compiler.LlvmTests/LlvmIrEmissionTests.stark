    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%Pair = type { i32, i32 }")
        && Contains(llvm, "@Origin = local_unnamed_addr constant %Pair { i32 1, i32 2 }")
        && Contains(llvm, "@Values = local_unnamed_addr constant [3 x i32] [i32 4, i32 7, i32 9]");
