// Ported from LlvmIrEmissionTests.TextEqualityAndInequalityEmitHelperCalls.
internal fn bool TextEqualityAndInequalityEmitHelperCallsImpl()
{
    // PORT-NOTE: the C# oracle extracts the helper definition headers via
    // ExtractDefinitionHeader and asserts the header substrings within that
    // slice; the host bridge exposes only the whole-module text, so the header
    // substring checks are applied to the full LLVM output instead.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-text-equality-inequality",
        raw"""
module Demo

unsafe fn bool SameAscii(ascii left, ascii right)
{
    return left == right;
}

unsafe fn bool DifferentUnicode(unicode left, unicode right)
{
    return left != right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define internal dso_local i1 @__stark_ascii_equal(%stark_ascii %left, %stark_ascii %right)")
        && Contains(llvm, "define internal dso_local i1 @__stark_unicode_equal(%stark_unicode %left, %stark_unicode %right)")
        && Contains(llvm, "unnamed_addr")
        && Contains(llvm, "call i1 @__stark_ascii_equal(%stark_ascii %arg_left, %stark_ascii %arg_right)")
        && Contains(llvm, "call i1 @__stark_unicode_equal(%stark_unicode %arg_left, %stark_unicode %arg_right)")
        && Contains(llvm, "getelementptr inbounds nuw i8, ptr %left_data, i64 %textcmp_index")
        && Contains(llvm, "getelementptr inbounds nuw i32, ptr %left_data, i64 %textcmp_index")
        && Contains(llvm, "xor i1")
        && DoesNotContain(llvm, "; LLVM body emission fallback for SameAscii")
        && DoesNotContain(llvm, "; LLVM body emission fallback for DifferentUnicode");
}

