// Ported from LlvmIrEmissionTests.DynamicArrayIndexEmitsAddressBasedLoad.
internal fn bool DynamicArrayIndexEmitsAddressBasedLoadImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-dynamic-array-index-load",
        raw"""
module Demo

unsafe fn i32[min max] Run(i32[min max] index)
{
    stack i32[min max][3] values =
    {
        1, 2, 3
    };
    return values[index];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the GEP Assert.Matches regex is reduced to its literal form.
    return Contains(llvm, "define fastcc noundef i32 @Run(i32 noundef %arg_index)")
        && Contains(llvm, "alloca [3 x i32]")
        && Contains(llvm, "declare void @llvm.lifetime.start.p0(i64 immarg, ptr nocapture)")
        && Contains(llvm, "declare void @llvm.lifetime.end.p0(i64 immarg, ptr nocapture)")
        && Contains(llvm, "call void @llvm.lifetime.start.p0(i64 12, ptr %slot_values)")
        && Contains(llvm, "call void @llvm.lifetime.end.p0(i64 12, ptr %slot_values)")
        && Contains(llvm, "getelementptr [3 x i32], ptr %slot_values, i32 0, i32 %arg_index")
        && DoesNotContain(llvm, "getelementptr inbounds [3 x i32], ptr %v")
        && DoesNotContain(llvm, "getelementptr inbounds nuw [3 x i32], ptr %v")
        && Contains(llvm, "load i32, ptr")
        && DoesNotContain(llvm, "declare fastcc i32 @Run(i32)");
}

// Ported from LlvmIrEmissionTests.NonAddressableFixedArrayDynamicIndexSpillsOnlyTheTemporarySource.
internal fn bool NonAddressableFixedArrayDynamicIndexSpillsOnlyTheTemporarySourceImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-nonaddr-fixedarray-spill-temp",
        raw"""
module Demo

unsafe fn i32[min max][3] Make(i32[min max] left, i32[min max] middle, i32[min max] right)
{
    stack i32[min max][3] values =
    {
        left, middle, right
    };
    return values;
}

unsafe fn i32[min max] Run(i32[min max] index, i32[min max] seed)
{
    return Make(seed, seed + 1, seed + 2)[index];
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: original scoped checks to the Run body via ExtractDefinitionBody
    // and used a `%slot_<n>` GEP regex; both are reduced to whole-module substring
    // checks with the literal GEP prefix.
    return Contains(llvm, "call fastcc [3 x i32] @Make")
        && Contains(llvm, "alloca [3 x i32]")
        && Contains(llvm, "extractvalue [3 x i32]")
        && Contains(llvm, "getelementptr inbounds nuw [3 x i32], ptr %slot_")
        && Contains(llvm, "load i32, ptr")
        && DoesNotContain(llvm, "declare fastcc i32 @Run");
}

