// Ported from LlvmIrEmissionTests.LargeAggregateReturnUsesSRetAbi.
internal fn bool LargeAggregateReturnUsesSRetAbiImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-large-aggregate-return-sret",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
}

unsafe fn Big Make()
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    return new Big()
    {
        A = acc, B = acc + 1, C = acc + 2
    };
}

unsafe fn i64[min max] Run()
{
    stack Big value = Make();
    return (i64[min max])value.C;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @Make(ptr noundef noalias sret(%Big) nonnull dereferenceable(24) align 8 %ret)")
        && Contains(llvm, "call fastcc void @Make(ptr noalias sret(%Big)")
        && DoesNotContain(llvm, "define fastcc %Big @Make()")
        && DoesNotContain(llvm, "call fastcc %Big @Make()");
}

// Ported from LlvmIrEmissionTests.LargeAggregateReturnedThroughSRetMaterializesBeforeNestedInsert.
internal fn bool LargeAggregateReturnedThroughSRetMaterializesBeforeNestedInsertImpl()
{
    // PORT-NOTE: the C# oracle slices the @DefaultMaterialMap body via
    // ExtractDefinitionBody and pins the materialize/insert pair with regexes
    // over generated temp names. The host bridge exposes only the whole-module
    // text and no regex matcher, so the body-scoped regex assertions are reduced
    // to the stable substring prefixes of the same load/insertvalue sequence.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-large-aggregate-sret-materialize-before-insert",
        raw"""
module Demo

struct Texture
{
    i32[min max] Id;
    i32[min max] Width;
    i32[min max] Height;
    i32[min max] Mipmaps;
    i32[min max] Format;
}

struct MaterialMap
{
    Texture Texture;
    i32[min max] Color;
    i32[min max] Value;
}

unsafe fn Texture DefaultTexture()
{
    stack mut i32[min max] acc = 977;
    stack mut i32[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    return new Texture()
    {
        Id = acc,
        Width = acc + 1,
        Height = acc + 2,
        Mipmaps = acc + 3,
        Format = acc + 4
    };
}

unsafe fn MaterialMap DefaultMaterialMap()
{
    return new MaterialMap()
    {
        Texture = DefaultTexture(),
        Color = 1,
        Value = 2
    };
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "call fastcc void @DefaultTexture(ptr noalias sret(%Texture)")
        && Contains(llvm, "load %Texture, ptr %")
        && Contains(llvm, "insertvalue %MaterialMap zeroinitializer, %Texture %");
}

// Ported from LlvmIrEmissionTests.LargeAggregateInitializerReturnMaterializesDirectlyIntoSRetBuffer.
internal fn bool LargeAggregateInitializerReturnMaterializesDirectlyIntoSRetBufferImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-large-aggregate-initializer-return-sret",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
}

unsafe fn Big Make()
{
    return new Big()
    {
        A = 1, B = 2, C = 3
    };
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @Make(ptr noundef noalias sret(%Big) nonnull dereferenceable(24) align 8 %ret)")
        && Contains(llvm, "call void @llvm.memset.inline.p0.i64(ptr align 8 %ret, i8 0, i64 24, i1 false)")
        && Contains(llvm, "store i64 1, ptr %abi_insert_field_store_")
        && Contains(llvm, "store i64 2, ptr %abi_insert_field_store_")
        && Contains(llvm, "store i64 3, ptr %abi_insert_field_store_")
        && DoesNotContain(llvm, "store %Big");
}

// Ported from LlvmIrEmissionTests.LargeGenericEnumAggregateReturnMaterializesDirectlyIntoSRetBuffer.
internal fn bool LargeGenericEnumAggregateReturnMaterializesDirectlyIntoSRetBufferImpl()
{
    // PORT-NOTE: the C# oracle slices the @Make body via ExtractDefinitionBody
    // and asserts the body-scoped substrings; the host bridge exposes only the
    // whole-module text, so the body checks are applied to the full LLVM output.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-large-generic-enum-aggregate-return-sret",
        raw"""
module Demo

struct Big
{
    i8[min max][512] Data;
    i64[min max] Len;
}

enum IOResult<T>
{
    Ok(T),
    Err(i64[min max])
}

unsafe fn IOResult<Big> Make()
{
    return IOResult<Big>.Ok(new Big()
    {
        Len = 7
    });
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @Make(ptr noundef noalias sret(%IOResult_Big_) nonnull dereferenceable(536) align 8 %ret)")
        && Contains(llvm, "call void @llvm.memset.inline.p0.i64(ptr align 8 %ret, i8 0, i64 536, i1 false)")
        && Contains(llvm, "getelementptr inbounds nuw %IOResult_Big_, ptr %ret, i32 0, i32 1")
        && Contains(llvm, "store i64 7, ptr %abi_insert_field_store_")
        && DoesNotContain(llvm, "insertvalue %IOResult_Big_")
        && DoesNotContain(llvm, "insertvalue %Big")
        && DoesNotContain(llvm, "store %IOResult_Big_")
        && DoesNotContain(llvm, "store %Big");
}

// Ported from LlvmIrEmissionTests.LargeAggregateForwardReturnForwardsDirectCallIntoSRetBuffer.
internal fn bool LargeAggregateForwardReturnForwardsDirectCallIntoSRetBufferImpl()
{
    // PORT-NOTE: the C# oracle slices the @Forward body via regex and asserts the
    // forwarded sret call plus the absence of a callret slot / memcpy / aggregate
    // load/store within that slice. The host bridge exposes only the whole-module
    // text and no regex matcher, so the body-scoped negative checks are applied
    // to the full LLVM output.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-large-aggregate-forward-return-sret",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
    i64[min max] E;
}

unsafe fn Big Make()
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    return new Big()
    {
        A = acc, B = acc + 1, C = acc + 2, D = acc + 3, E = acc + 4
    };
}

unsafe fn Big Forward()
{
    return Make();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc void @Forward(ptr noundef noalias sret(%Big) nonnull dereferenceable(40) align 8 %ret)")
        && Contains(llvm, "call fastcc void @Make(ptr noalias sret(%Big) nonnull dereferenceable(40) align 8 %ret)")
        && DoesNotContain(llvm, "%abi_callret_slot_")
        && DoesNotContain(llvm, "call void @llvm.memcpy.inline.p0.p0.i64(ptr align 8 %ret")
        && DoesNotContain(llvm, "load %Big, ptr %abi_callret_slot_");
}

// Ported slice (part 8) of tests/compiler.Tests/LlvmIrEmissionTests.cs. Each Impl
// compiles a small program through the host LLVM bridge, requests the rendered
// `llvm` artifact, and asserts on raw LLVM-IR substrings with the System.Testing
// Contains / DoesNotContain helpers. The embedded Stark programs are reproduced
// verbatim from the C# raw string literals. The original C# tests remain in
// tests/compiler.Tests as the oracle until cutover.
//
// PORT-NOTE conventions used below:
//  - Assert.Matches(regex) is reduced to the literal substring(s) the regex
//    requires; the variable `%vN` / `!N` parts are dropped.
//  - Assert.Single / Assert.Equal(N, CountOccurrences(...)) checks are reduced to
//    a presence (Contains) check; the count itself is not expressible.
//  - ExtractDefinitionHeader / ExtractDefinitionBody scoping is reduced to a
//    substring check against the whole module text.
//  - Tests that supplied an InMemoryModuleResolver / FileSystemModuleResolver for
//    an imported dependency module cannot be reproduced through the single-source
//    CompileLlvm helper; those are reduced to a Succeeds(...) signal on the main
//    program (the cross-module qualified-symbol assertions are not expressible).

// Ported from LlvmIrEmissionTests.LargeAggregateLocalForwardReturnKeepsDirectCallInSRetBuffer.
internal fn bool LargeAggregateLocalForwardReturnKeepsDirectCallInSRetBufferImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-large-agg-local-forward-sret",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
    i64[min max] E;
}

unsafe fn Big Make()
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    return new Big()
    {
        A = acc, B = acc + 1, C = acc + 2, D = acc + 3, E = acc + 4
    };
}

unsafe fn Big Forward()
{
    stack Big value = Make();
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original DoesNotContain checks were scoped to the Forward
    // body via a regex; they are matched against the whole module text here.
    return Contains(llvm, "define fastcc void @Forward(ptr noundef noalias sret(%Big) nonnull dereferenceable(40) align 8 %ret)")
        && Contains(llvm, "call fastcc void @Make(ptr noalias sret(%Big) nonnull dereferenceable(40) align 8 %ret)")
        && DoesNotContain(llvm, "%abi_callret_slot_")
        && DoesNotContain(llvm, "call void @llvm.memcpy.inline.p0.p0.i64(ptr align 8 %ret")
        && DoesNotContain(llvm, "load %Big, ptr %abi_callret_slot_")
        && DoesNotContain(llvm, "store %Big");
}

// Ported from LlvmIrEmissionTests.LargeAggregateReturnOfIndirectParameterSkipsEntryLoad.
internal fn bool LargeAggregateReturnOfIndirectParameterSkipsEntryLoadImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-large-agg-return-indirect-param",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

unsafe fn Big Forward(Big value)
{
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the memcpy Assert.Matches regex (optional `align N`) is reduced
    // to the canonical aligned-pointer form the renderer emits.
    return Contains(llvm, "define fastcc void @Forward(ptr noundef noalias sret(%Big) nonnull dereferenceable(32) align 8 %ret, ptr noundef nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %arg_value)")
        && Contains(llvm, "call void @llvm.memcpy.inline.p0.p0.i64(ptr align 8 %ret, ptr align 8 %arg_value, i64 32, i1 false)")
        && DoesNotContain(llvm, "load %Big, ptr %arg_value")
        && DoesNotContain(llvm, "%abi_arg_value_value")
        && DoesNotContain(llvm, "store %Big");
}

// Ported from LlvmIrEmissionTests.LargeAggregateIndirectParameterForwardingUsesOriginalPointer.
internal fn bool LargeAggregateIndirectParameterForwardingUsesOriginalPointerImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-large-agg-indirect-forward-ptr",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

unsafe fn Big Step(Big value)
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    if (acc < -4000000000000000000)
    {
        return new Big()
        {
            A = value.A + acc, B = value.B, C = value.C, D = value.D
        };
    }

    return value;
}

unsafe fn Big Forward(Big value)
{
    return Step(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original DoesNotContain checks were scoped to the Forward
    // body via a regex; they are matched against the whole module text here.
    return Contains(llvm, "define fastcc void @Forward(ptr noundef noalias sret(%Big) nonnull dereferenceable(32) align 8 %ret, ptr noundef nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %arg_value)")
        && Contains(llvm, "call fastcc void @Step(ptr noalias sret(%Big) nonnull dereferenceable(32) align 8 %ret")
        && Contains(llvm, "ptr noundef nonnull byval(%Big) noalias readonly nocapture dereferenceable(32) align 8 %arg_value")
        && DoesNotContain(llvm, "%abi_callret_slot_")
        && DoesNotContain(llvm, "load %Big, ptr %abi_callret_slot_");
}

// Ported from LlvmIrEmissionTests.LargeAggregateParametersUseByValueIndirectAbi.
internal fn bool LargeAggregateParametersUseByValueIndirectAbiImpl()
{
    stack mut LlvmCompile c = CompileLlvmNormalized(
        "p8-large-agg-param-byval-indirect",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
}

unsafe fn i64[min max] Read(Big value)
{
    stack i64[min max] a = value.A + (value.C / 3);
    stack i64[min max] b = a - (a / 5);
    stack i64[min max] c = b + (b / 7);
    stack i64[min max] d = c - (c / 11);
    stack i64[min max] e = d + (d / 13);
    stack i64[min max] f = e - (e / 17);
    stack i64[min max] g = f + (f / 19);
    stack i64[min max] h = g - (g / 23);
    stack i64[min max] i = h + (h / 29);
    stack i64[min max] j = i - (i / 31);
    stack i64[min max] k = j + (j / 37);
    stack i64[min max] l = k - (k / 41);
    stack i64[min max] m = l + (l / 43);
    return m;
}

unsafe fn i64[min max] Run()
{
    return Read(new Big()
    {
        A = 1, B = 2, C = 3
    });
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i64 @Read(")
        && Contains(llvm, "ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(24) align 8 %arg_value")
        && Contains(llvm, "memory(argmem: read)")
        && Contains(llvm, "call fastcc i64 @Read(ptr nonnull byval(%Big) noalias readonly nocapture dereferenceable(24) align 8")
        && DoesNotContain(llvm, "define fastcc i64 @Read(%Big");
}

// Ported from LlvmIrEmissionTests.AggregateCallReturnRegressionBenchmarkKeepsSmallAggregatesOnDirectAbi.
internal fn bool AggregateCallReturnRegressionBenchmarkKeepsSmallAggregatesOnDirectAbiImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-small-agg-direct-abi",
        raw"""
module Demo

struct Pair
{
    i32[min max] Left;
    i32[min max] Right;
}

unsafe fn Pair Step(Pair value, i32[min max] delta)
{
    stack i32[min max] a = value.Left + (delta / 3);
    stack i32[min max] b = a - (a / 5);
    stack i32[min max] c = b + (b / 7);
    stack i32[min max] d = c - (c / 11);
    stack i32[min max] e = d + (d / 13);
    stack i32[min max] f = e - (e / 17);
    stack i32[min max] g = f + (f / 19);
    stack i32[min max] h = g - (g / 23);
    stack i32[min max] i = h + (h / 29);
    stack i32[min max] j = i - (i / 31);
    stack i32[min max] k = j + (j / 37);
    stack i32[min max] l = k - (k / 41);
    stack i32[min max] m = l + (l / 43);
    return new Pair()
    {
        Left = m,
        Right = value.Right + delta
    };
}

unsafe fn i32[min max] Run()
{
    stack Pair current = Step(
        Step(
            Step(new Pair()
            {
                Left = 1, Right = 2
            },
            1),
            1),
        1);
    return current.Left + current.Right;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef %Pair @Step(%Pair noundef %arg_value, i32 noundef %arg_delta)")
        && Contains(llvm, "call fastcc %Pair @Step(%Pair")
        && DoesNotContain(llvm, "sret(%Pair)")
        && DoesNotContain(llvm, "byval(%Pair)");
}

// Ported from LlvmIrEmissionTests.AggregateCallReturnRegressionBenchmarkKeepsLargeAggregatesOnIndirectAbi.
internal fn bool AggregateCallReturnRegressionBenchmarkKeepsLargeAggregatesOnIndirectAbiImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p8-large-agg-indirect-abi",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

unsafe fn Big Step(Big value, i64[min max] delta)
{
    stack i64[min max] a = value.A + (delta / 3);
    stack i64[min max] b = a - (a / 5);
    stack i64[min max] c = b + (b / 7);
    stack i64[min max] d = c - (c / 11);
    stack i64[min max] e = d + (d / 13);
    stack i64[min max] f = e - (e / 17);
    stack i64[min max] g = f + (f / 19);
    stack i64[min max] h = g - (g / 23);
    stack i64[min max] i = h + (h / 29);
    stack i64[min max] j = i - (i / 31);
    stack i64[min max] k = j + (j / 37);
    stack i64[min max] l = k - (k / 41);
    stack i64[min max] m = l + (l / 43);
    return new Big()
    {
        A = m,
        B = value.B + delta,
        C = value.C + delta,
        D = value.D + delta
    };
}

unsafe fn i64[min max] Run()
{
    stack Big current = Step(
        Step(
            new Big()
            {
                A = 1, B = 2, C = 3, D = 4
            },
            1),
        1);
    return current.A + current.D;
}
""");
    if (!Succeeds(c))
    {
