        raw"""
module Demo

unsafe fn void TouchPositive(rawptr<i32[min max]>[count] input, u8[1 10] count)
{
    return;
}

unsafe fn void TouchMaybeEmpty(rawptr<i32[min max]>[count] input, u8[0 10] count)
{
