}

// Ported from LlvmIrEmissionTests.PackedCStructLayoutEmitsPackedPhysicalTypeAndUnalignedFieldAccess.
internal fn bool PackedCStructLayoutEmitsPackedPhysicalTypeAndUnalignedFieldAccessImpl()
{
    // PORT-NOTE: the C# oracle slices Read's header/body via
    // ExtractDefinitionHeader/ExtractDefinitionBody and asserts substrings
    // within those slices; the host bridge exposes only the whole-module text,
    // so the header/body substring checks are applied to the full LLVM output.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-packed-cstruct-layout",
        raw"""
module Demo

[StructLayout(C), Pack(1)]
struct Packet
{
    u8[0 max] Tag;
    i32[min max] Value;
}

unsafe fn i32[min max] Read(borrow Packet packet)
{
    return packet.Value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%Packet = type <{ i8, i32 }>")
        && Contains(llvm, "dereferenceable(5)")
        && Contains(llvm, "getelementptr inbounds nuw i8, ptr %")
        && Contains(llvm, ", i64 1")
        && Contains(llvm, "load i32, ptr")
        && Contains(llvm, "align 1");
}

// Ported from LlvmIrEmissionTests.ExplicitStructLayoutEmitsByteStorageAndFieldOffsetAccess.
internal fn bool ExplicitStructLayoutEmitsByteStorageAndFieldOffsetAccessImpl()
{
    // PORT-NOTE: the C# oracle slices ReadHigh's header/body via
    // ExtractDefinitionHeader/ExtractDefinitionBody; the host bridge exposes only
    // the whole-module text, so the header/body substring checks are applied to
    // the full LLVM output.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-explicit-struct-layout-field-offset",
        raw"""
module Demo

[StructLayout(Explicit), Align(4)]
struct WordParts
{
    [FieldOffset(0)] u32[0 max] Whole;
    [FieldOffset(0)] u16[0 max] Low;
    [FieldOffset(2)] u16[0 max] High;
}

unsafe fn u16[0 max] ReadHigh(borrow WordParts value)
{
    return value.High;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%WordParts = type { [4 x i8] }")
        && Contains(llvm, "dereferenceable(4)")
        && Contains(llvm, "align 4")
        && Contains(llvm, "getelementptr inbounds nuw i8, ptr %")
        && Contains(llvm, ", i64 2")
        && Contains(llvm, "load i16, ptr")
        && Contains(llvm, "align 2");
}

