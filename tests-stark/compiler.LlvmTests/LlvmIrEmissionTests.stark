        && Contains(llvm, " = zext i8 %arg_count to i64")
        && Contains(llvm, "call void @llvm.memset.p0.i64(ptr %abi_rawptr_loop_destination_data_")
        && DoesNotContain(llvm, "%v0_phi = phi");
}

// Ported from LlvmIrEmissionTests.DynamicTailInitByteFillLoopLowersToMemsetAndCommitsLength.
internal fn bool DynamicTailInitByteFillLoopLowersToMemsetAndCommitsLengthImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-dynamic-tail-init-byte-fill-memset-commits-length",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Fill(i8[min max] value, u8[0 10] count)
{
    stack mut dynamic i8[min max] values = new(count);
    stack init i8[min max][] spare = init values[values.Length, count];
    for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        init spare[index] = value;
    }

    return values.Length;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: ExtractDefinitionBody(llvm, "Fill") scoping is reduced to
    // whole-module Contains; the memset Assert.Matches regex is reduced to a
    // literal Contains on its stable prefix.
    return Contains(llvm, "declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)")
        && Contains(llvm, "call void @llvm.memset.p0.i64(ptr %abi_rawptr_loop_destination_data_")
        && Contains(llvm, "dynamic_length_final")
        && DoesNotContain(llvm, "%v0_phi = phi");
}

// Ported from LlvmIrEmissionTests.DynamicAppendThroughLengthByteFillLoopLowersToMemsetAndCommitsLengthOnce.
internal fn bool DynamicAppendThroughLengthByteFillLoopLowersToMemsetAndCommitsLengthOnceImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-dynamic-append-byte-fill-memset-commits-length-once",
        raw"""
module Demo

unsafe fn u64[0 2 ** 63 - 1] Fill(i8[min max] value, u8[0 10] count)
{
    stack mut dynamic i8[min max] values = new(count);
    if (!values.TryReserve(count))
    {
        return 0;
    }

    for willexit (stack mut u8[0 10] index = 0; index < count; index += 1)
    {
        init values[values.Length] = value;
    }

    return values.Length;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: ExtractDefinitionBody(llvm, "Fill") scoping is reduced to
    // whole-module Contains; the memset Assert.Matches regex is reduced to a
    // literal Contains on its stable prefix. The _for_body/v7_phi
    // DoesNotContain probes are kept as-is.
    return Contains(llvm, "declare void @llvm.memset.p0.i64(ptr nocapture writeonly, i8, i64, i1 immarg)")
        && Contains(llvm, "call void @llvm.memset.p0.i64(ptr %dynamic_append_tail, i8 %arg_value, i64 ")
        && Contains(llvm, "%dynamic_append_final_length = add")
        && DoesNotContain(llvm, "_for_body")
        && DoesNotContain(llvm, "v7_phi");
}

