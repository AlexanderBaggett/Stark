        "llvm-ir-emit-disjoint-init-slice-copy-memcpy",
        raw"""
module Demo

unsafe fn void Copy(
    borrow i32[min max][] input,
    init i32[min max][] output,
    u8[0 10] count)
    {
        for willexit independent (stack mut u8[0 10] index = 0; index < count; index += 1)
