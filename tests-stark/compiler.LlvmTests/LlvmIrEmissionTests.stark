// Ported from LlvmIrEmissionTests.FullyDefinedNonFfiAbiSurfacesEmitNoundef.
internal fn bool FullyDefinedNonFfiAbiSurfacesEmitNoundefImpl()
{
    // PORT-NOTE: original scopes each header assertion to a specific function
    // (Pick/Echo/Keep/Copy) via ExtractDefinitionHeader over GetLlvmRaw; reduced
    // to whole-module Contains on the raw `llvm` text.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-non-ffi-abi-noundef",
        raw"""
module Demo

record Pair(u8[0 10] Left, u8[0 10] Right)
{
}
record Big(
    i64[min max] A,
    i64[min max] B,
    i64[min max] C)
    {
    }

unsafe fn rawptr<i8[min max]> Pick(rawptr<i8[min max]> ptr)
{
    return ptr;
}

unsafe fn ascii Echo(ascii text)
{
    return text;
}

unsafe fn Pair Keep(Pair pair)
{
    return pair;
}

unsafe fn Big Copy(Big value)
{
    return value;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef ptr @Pick(ptr noundef")
        && Contains(llvm, "define fastcc noundef %stark_ascii @Echo(%stark_ascii noundef %arg_text)")
        && Contains(llvm, "define fastcc noundef %Pair @Keep(%Pair noundef %arg_pair)")
        && Contains(llvm, "define fastcc void @Copy(ptr noundef noalias sret(%Big)")
        && Contains(llvm, "ptr noundef nonnull byval(%Big)");
}

// Ported from LlvmIrEmissionTests.PointerAbiContractsDistinguishSafeBorrowsAndNullableRawPointers.
internal fn bool PointerAbiContractsDistinguishSafeBorrowsAndNullableRawPointersImpl()
{
    // PORT-NOTE: original scopes the ReadBorrow/ReadView/RawInternal assertions
    // to per-function headers via ExtractDefinitionHeader over GetLlvmRaw, and
    // the RawInternal-header DoesNotContain checks for `nonnull`/`dereferenceable`
    // are header-scoped. Reduced to whole-module Contains/DoesNotContain; the
    // module-wide DoesNotContain on the dereferenceable tokens within the
    // RawInternal/RawForeign forms is preserved as the closest expressible
    // signal.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-pointer-abi-contracts",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

unsafe fn i32[min max] ReadBorrow(borrow Box box)
{
    return box.Value;
}

unsafe fn i32[min max] ReadView(borrow i32[min max][] view, i32[min max] index)
{
    return view[index];
}

unsafe fn void RawInternal(rawptr<Box> ptr)
{
    return;
}

unsafe ffi fn void RawForeign(rawptr<Box> ptr);
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef i32 @ReadBorrow(ptr noundef nonnull noalias readonly nocapture dereferenceable(4) align 4 %arg_box)")
        && Contains(llvm, "define fastcc noundef i32 @ReadView(ptr noundef nonnull noalias readonly nocapture dereferenceable(16) align 8 %arg_view, i32 noundef %arg_index)")
        && Contains(llvm, "ptr noundef readonly nocapture %arg_ptr")
        && Contains(llvm, "declare void @RawForeign(ptr readonly)")
        && DoesNotContain(llvm, "declare void @RawForeign(ptr nonnull")
        && DoesNotContain(llvm, "declare void @RawForeign(ptr dereferenceable")
        && DoesNotContain(llvm, "declare void @RawForeign(ptr dereferenceable_or_null");
}

// Ported from LlvmIrEmissionTests.RawMutablePointerDeclarationsMayReadAndWriteArgumentMemory.
internal fn bool RawMutablePointerDeclarationsMayReadAndWriteArgumentMemoryImpl()
{
    // PORT-NOTE: original isolates the single `declare fastcc void @Fill(` line
    // via Split/Single over GetLlvmRaw and asserts the absence of read/write
    // tokens on that one line. Reduced to whole-module Contains for the exact
    // declaration form plus module-wide DoesNotContain on the read/write tokens,
    // which holds because no other declaration in this module emits them.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-rawmut-pointer-decl-readwrite",
        raw"""
module Demo

unsafe fn void Fill(rawmutptr<i32[min max]> ptr);

unsafe fn void Run(rawmutptr<i32[min max]> ptr)
{
    Fill(ptr);
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare fastcc void @Fill(ptr noundef)")
        && DoesNotContain(llvm, "memory(argmem: read)")
        && DoesNotContain(llvm, "readonly")
        && DoesNotContain(llvm, "writeonly");
}

// Ported from LlvmIrEmissionTests.FfiRawMutablePointerCallsPropagateWrapperArgumentWrites.
internal fn bool FfiRawMutablePointerCallsPropagateWrapperArgumentWritesImpl()
{
    // PORT-NOTE: original isolates the single `declare i32 @Fill(` line via
    // Split/Single and the `Run` header via ExtractDefinitionHeader over
    // GetLlvmRaw. Reduced to whole-module Contains for the declaration form plus
    // module-wide DoesNotContain on the read/write/memory tokens; these hold
    // because nothing else in this module emits them.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-ffi-rawmut-pointer-propagates-writes",
        raw"""
module Demo

unsafe ffi fn i32[min max] Fill(rawmutptr<i32[min max]> ptr);

unsafe fn i32[min max] Run(rawmutptr<i32[min max]> ptr)
{
    return Fill(ptr);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare i32 @Fill(ptr)")
        && DoesNotContain(llvm, "readonly")
        && DoesNotContain(llvm, "writeonly")
        && DoesNotContain(llvm, "memory(read, argmem: none)");
}

// Ported from LlvmIrEmissionTests.ConstrainedIntegerLoadsAndCallResultsEmitRangeMetadata.
internal fn bool ConstrainedIntegerLoadsAndCallResultsEmitRangeMetadataImpl()
{
    // PORT-NOTE: original asserts the load/call range metadata via regex
    // (`load i8, ptr (?:%v\d+|%slot_value), !range !\d+` and
    // `call fastcc i8 @Bounded\(\), !range !\d+`); reduced to literal-substring
    // Contains on the stable token fragments (`!range !`, the typed load/call
    // prefixes) plus the concrete range-metadata node.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-ir-emit-constrained-int-range-metadata",
        raw"""
module Demo

unsafe fn u8[0 10] Bounded()
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    if (acc > 0)
    {
        return 7;
    }

    return 3;
}

unsafe fn u8[0 10] ReadThroughPointer(u8[0 10] input)
{
    stack mut u8[0 10] value = input;
    stack rawmutptr<u8[0 10]> ptr = &value;
    return *ptr;
}

unsafe fn u8[0 10] CallBounded()
{
    return Bounded();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "load i8, ptr")
        && Contains(llvm, "call fastcc i8 @Bounded()")
        && Contains(llvm, "!range !")
        && Contains(llvm, "!{i8 0, i8 11}");
}

// Ported slice of tests/compiler.Tests/LlvmIrEmissionTests.cs LLVM IR emission
// tests, running against the current C# host compiler through the host test
// protocol. Each Impl compiles a small source program, requests the rendered
// `llvm` artifact, and asserts on raw LLVM-IR substrings with System.Testing
// text helpers. Requires STARK_HOST_COMPILER to point at the host compiler
// executable. The original C# tests remain in tests/compiler.Tests as the
// oracle until cutover.
//
// The embedded Stark programs are reproduced verbatim from the C# raw string
// literals. The host bridge renders the RAW optimized LLVM, matching the C#
// `GetLlvmRaw`/`GetLlvm`. C# `Assert.Matches`/`Assert.Equal`/count and
// header-extraction assertions that the text helpers cannot express are reduced
// to the closest substring checks, noted inline with `// PORT-NOTE:`.

// Ported from LlvmIrEmissionTests.ConstrainedIntegerAbiSurfacesEmitRangeAttributes.
internal fn bool ConstrainedIntegerAbiSurfacesEmitRangeAttributesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-constrained-int-abi-range",
        raw"""
module Demo

unsafe fn u8[0 10] Bounded(u8[0 10] input)
{
    stack i32[min max] a = input + (input / 3);
    stack i32[min max] b = a - (a / 5);
    stack i32[min max] c = b + (b / 7);
    stack i32[min max] d = c - (c / 11);
    stack i32[min max] e = d + (d / 13);
    stack i32[min max] f = e - (e / 17);
    stack i32[min max] g = f + (f / 19);
    stack i32[min max] h = g - (g / 23);
    stack i32[min max] i = h + (h / 29);
    stack i32[min max] j = i - (i / 31);
    stack i32[min max] k = j + (j / 37);
    stack i32[min max] l = k - (k / 41);
    stack i32[min max] m = l + (l / 43);
    if (m < -2000000000)
    {
        return 3;
    }

    return 7;
}

unsafe fn u8[0 10] CallBounded(u8[0 10] input)
{
    return Bounded(input);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Matches on the `call ... !range !N` line reduced to a
    // substring check on the call prefix.
    return Contains(llvm, "define fastcc noundef range(i8 0, 11) i8 @Bounded(i8 noundef range(i8 0, 11) %arg_input)")
        && Contains(llvm, "define fastcc noundef range(i8 0, 11) i8 @CallBounded(i8 noundef range(i8 0, 11) %arg_input)")
        && Contains(llvm, "call fastcc i8 @Bounded(i8 range(i8 0, 11) %arg_input)")
        && Contains(llvm, "!{i8 0, i8 11}");
}

// Ported from LlvmIrEmissionTests.BranchRefinedIntegerComparisonsEmitTargetedAssumes.
internal fn bool BranchRefinedIntegerComparisonsEmitTargetedAssumesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-branch-refined-int-compare-assume",
        raw"""
module Demo

unsafe fn i32[min max] Range(rawmutptr<i32[min max]> sink, i32[min max] value)
{
    if (value >= 0)
    {
        *sink = value;
        return value;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Matches on the SSA-numbered `call void @llvm.assume`
    // and `xor ... true` lines reduced to stable substring fragments.
    return Contains(llvm, "declare void @llvm.assume(i1 noundef)")
        && Contains(llvm, "call void @llvm.assume(i1 ")
        && Contains(llvm, " = xor i1 ")
        && Contains(llvm, ", true");
}

// Ported from LlvmIrEmissionTests.BranchRefinedRawPointerNullChecksEmitNonnullAssumeBundle.
internal fn bool BranchRefinedRawPointerNullChecksEmitNonnullAssumeBundleImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-branch-refined-nonnull-assume",
        raw"""
module Demo

unsafe fn i32[min max] Read(rawptr<i32[min max]> ptr)
{
    if (ptr != null)
    {
        return *ptr;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# ExtractDefinitionHeader(Read) `DoesNotContain("nonnull")`
    // reduced; the nonnull-in-header check is dropped (the helpers cannot slice
    // a single definition header), keeping the global assume-bundle assertions.
    return Contains(llvm, "declare void @llvm.assume(i1 noundef)")
        && Contains(llvm, "call void @llvm.assume(i1 true) [\"nonnull\"(ptr %arg_ptr)]");
}

// Ported from LlvmIrEmissionTests.BranchRefinedPointerEqualityToKnownAddressEmitsAlignmentAssumeBundle.
internal fn bool BranchRefinedPointerEqualityToKnownAddressEmitsAlignmentAssumeBundleImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-branch-refined-align-assume",
        raw"""
module Demo

unsafe fn i64[min max] ReadIfSame(rawptr<i64[min max]> ptr)
{
    stack i64[min max] value = 9;
    if (ptr == &value)
    {
        return *ptr;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "declare void @llvm.assume(i1 noundef)")
        && Contains(llvm, "call void @llvm.assume(i1 true) [\"nonnull\"(ptr %arg_ptr), \"align\"(ptr %arg_ptr, i64 8)]");
}

// Ported from LlvmIrEmissionTests.BoundaryFactsAndPlainBoolBranchesDoNotEmitAssumeIntrinsic.
internal fn bool BoundaryFactsAndPlainBoolBranchesDoNotEmitAssumeIntrinsicImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-boundary-plain-bool-no-assume",
        raw"""
module Demo

unsafe fn u8[0 10] BoundaryOnly(u8[0 10] value)
{
    return value;
}

unsafe fn i32[min max] Plain(bool flag, i32[min max] value)
{
    if (flag)
    {
        return value;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return DoesNotContain(llvm, "@llvm.assume")
        && Contains(llvm, "define fastcc noundef range(i8 0, 11) i8 @BoundaryOnly(i8 noundef range(i8 0, 11) %arg_value)");
}

// Ported from LlvmIrEmissionTests.SignedConstrainedIntegerLoadsEmitWrappingRangeMetadata.
internal fn bool SignedConstrainedIntegerLoadsEmitWrappingRangeMetadataImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-signed-constrained-load-range",
        raw"""
module Demo

unsafe fn i8[-10 10] ReadThroughPointer(i8[-10 10] input)
{
    stack mut i8[-10 10] value = input;
    stack rawmutptr<i8[-10 10]> ptr = &value;
    return *ptr;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# Assert.Matches over the `load i8, ptr ..., !range !N` line
    // reduced to substring fragments for the load and the range metadata node.
    return Contains(llvm, "load i8, ptr ")
        && Contains(llvm, ", !range !")
        && Contains(llvm, "!{i8 -10, i8 11}");
}

// Ported from LlvmIrEmissionTests.MemoryAttributesDistinguishArgumentAndOtherMemoryEffects.
internal fn bool MemoryAttributesDistinguishArgumentAndOtherMemoryEffectsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-memory-attrs-distinguish-argmem",
        raw"""
module Demo

struct Box
{
    i32[min max] Value;
}

static mut i32[min max] Counter = 0;

unsafe fn i32[min max] ReadGlobal()
{
    return Counter;
}

unsafe fn void TouchArg(borrow mut Box box)
{
    box.Value = 1;
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc noundef i32 @ReadGlobal()")
        && Contains(llvm, "memory(read, argmem: none)")
        && Contains(llvm, "define fastcc void @TouchArg(ptr noundef nonnull noalias writeonly nocapture dereferenceable(4) align 4 %arg_box)")
        && Contains(llvm, "memory(argmem: readwrite)")
        && DoesNotContain(llvm, "load %Box, ptr %arg_box");
}

// Ported from LlvmIrEmissionTests.MemoryAttributesKeepArgumentEffectsWhenSyntheticTemporariesAreNeeded.
internal fn bool MemoryAttributesKeepArgumentEffectsWhenSyntheticTemporariesAreNeededImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-memory-attrs-keep-argmem-temporaries",
        raw"""
module Demo

struct Big
{
    i64[min max] A;
    i64[min max] B;
    i64[min max] C;
    i64[min max] D;
}

struct Box
{
    Big Value;
}

unsafe fn Big MakeBig()
{
    return new Big()
    {
        A = 1,
        B = 2,
        C = 3,
        D = 4
    };
}

unsafe fn void Store(borrow mut Box box)
{
    box.Value = MakeBig();
    return;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: C# extracts the `Store` definition header and asserts it
    // DoesNotContain "argmem: none". The helpers cannot slice a single header,
    // so this is reduced to a whole-module check: `Store` must keep argument
    // effects, i.e. the module must not carry an `argmem: none` memory effect.
    return DoesNotContain(llvm, "argmem: none");
}

// Ported from LlvmIrEmissionTests.EscapedTextLiteralsEmitDecodedBytes.
internal fn bool EscapedTextLiteralsEmitDecodedBytesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "p6-escaped-text-literals-decoded",
        raw"""
module Demo

unsafe finite law ascii Controls()
{
    return "\0\b\t\n\f\r\\\"\'";
}

unsafe finite law ascii HexChar()
{
    return '\x41';
}

unsafe finite law unicode Wide()
{
    return (unicode)"\xC9";
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "@.str.0 = private unnamed_addr constant [10 x i8] c\"\\00\\08\\09\\0A\\0C\\0D\\5C\\22'\\00\"")
        && Contains(llvm, "@.str.1 = private unnamed_addr constant [2 x i8] c\"A\\00\"")
        && Contains(llvm, "private unnamed_addr constant [2 x i32] [i32 201, i32 0]");
}

// Ported from LlvmIrEmissionTests.FfiStringCallsExtractPointerFromConcreteStringValues.
internal fn bool FfiStringCallsExtractPointerFromConcreteStringValuesImpl()
{
    stack mut LlvmCompile c = CompileLlvmNormalized(
        "p6-ffi-string-extract-pointer",
        raw"""
module Demo

unsafe ffi fn i32[min max] puts(ascii text);

unsafe fn ascii Message()
{
    stack mut i64[min max] acc = 977;
    stack mut i64[min max] step = 0;
    while willexit (step < 2)
    {
        acc = acc + (acc / 3);
        acc = acc - (acc / 5);
        acc = acc + (acc / 7);
        acc = acc - (acc / 11);
        acc = acc + (acc / 13);
        acc = acc - (acc / 17);
        acc = acc + (acc / 19);
        acc = acc - (acc / 23);
        acc = acc + (acc / 29);
        acc = acc - (acc / 31);
        step = step + 1;
    }

    if (acc > -4000000000000000000)
    {
        return "Hello";
    }

    return "Hello";
}

export unsafe fn i32[min max] main()
{
    stack ascii message = Message();
    puts(message);
    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "%stark_ascii = type { ptr, i64 }")
        && Contains(llvm, "define fastcc %stark_ascii @Message()")
        && Contains(llvm, "define i32 @main()")
        && Contains(llvm, "call fastcc %stark_ascii @Message()")
        && Contains(llvm, "extractvalue %stark_ascii")
        && Contains(llvm, "call i32 @puts(ptr %");
}

// Ported from LlvmIrEmissionTests.StructFieldAccessCanFoldToScalarReturn.
