    i32[min max] Count;
}

unsafe fn Outer Wrap(i32[min max] value, i32[min max] count)
{
    return new Outer()
    {
        Item =
        {
            Value = value
        },
        Count = count
    };
}

unsafe fn Outer Use(i32[min max] value, i32[min max] count)
{
    return Wrap(value, count);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the Regex.IsMatch for `define ...@Wrap(...alwaysinline` is
    // reduced to whole-module substring checks.
    return Contains(llvm, "@Wrap(")
        && Contains(llvm, "alwaysinline");
}

