import LlvmTestSupport
import System.Testing
module OutParameterDropRegressionTestsP1

// Ported from OutParameterDropRegressionTests.AssigningIntoAnOutParameterDoesNotFreeTheTransferredValueOnReturn.
public unsafe fn bool AssigningIntoAnOutParameterDoesNotFreeTheTransferredValueOnReturnImpl()
{
    // PORT-NOTE: the C# oracle extracts the body of @Fill, splits it into basic
    // blocks, selects the single block containing "ret i1 true" (the success
    // path that moves ownership of 'local' into the caller's out slot), and
    // asserts that block alone does NOT contain "__stark_runtime_free". The host
    // bridge helpers operate on whole-module LLVM text only and cannot isolate a
    // named definition or an individual basic block, so the block-scoped
    // DoesNotContain is reduced to: the compile succeeds and "ret i1 true" is
    // emitted (proving the success path lowered). The precise "no free on the
    // success return block" assertion cannot be expressed here.
    stack mut LlvmCompile c = CompileLlvm(
        "out-param-drop-regression-no-free-on-transfer-return",
        raw"""
module Demo

struct Box
{
    dynamic i64[min max] Items;
}

fn bool Fill(out Box target)
{
    stack mut Box local = new();
    if (!local.Items.TryReserve(2))
    {
        target = new();
        return false;
    }

    init local.Items[local.Items.Length] = 7;
    init local.Items[local.Items.Length] = 8;
    target = local;
    return true;
}

export fn i32[min max] main()
{
    stack mut Box box = new();
    if (!Fill(box))
    {
        return 1;
    }

    return 0;
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "ret i1 true");
}
