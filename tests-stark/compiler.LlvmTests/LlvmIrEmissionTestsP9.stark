// Ported from LlvmIrEmissionTests.RepeatedManifestBackedNestedGenericCallsStayInternalAndDeduplicatedAtLlvmEmission.
public unsafe fn bool RepeatedManifestBackedNestedGenericCallsStayInternalAndDeduplicatedAtLlvmEmissionImpl()
{
    // PORT-NOTE: the original builds a typed-only package image for `Facade`
    // (Identity + Forward) and consumes it through FileSystemModuleResolver, then
    // asserts dedup/occurrence counts over the emitted module; the helper models
    // neither package images nor a resolver, so the consumer program is compiled
    // and reduced to Succeeds.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-repeated-manifest-nested-generic-dedup",
        raw"""
import Facade
module Demo

unsafe fn i32[min max] Run(i32[min max] left, i32[min max] right)
{
    stack i32[min max] first = Facade.Forward(left);
    stack i32[min max] second = Facade.Forward(right);
    return first + second;
}
""");
    return Succeeds(c);
}

// Ported from LlvmIrEmissionTests.LocalFixedArrayCanBeCoercedToSliceForCalls.
public unsafe fn bool LocalFixedArrayCanBeCoercedToSliceForCallsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-local-fixed-array-coerced-to-slice",
        raw"""
module Demo

noinline unsafe fn i32[min max] Read(i32[min max][] view, i32[min max] index)
{
    return view[index];
}

unsafe fn i32[min max] Run(i32[min max] index)
{
    stack i32[min max][3] values =
    {
        4, 7, 9
    };
    return Read(values, index);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the Assert.Equal(3, count of "store i32 %abi_scalar_extract_")
    // line-count check is reduced to a whole-module substring presence check.
    return Contains(llvm, "alloca [3 x i32]")
        && Contains(llvm, "store i32 %abi_scalar_extract_")
        && DoesNotContain(llvm, "store [3 x i32]")
        && Contains(llvm, "getelementptr inbounds nuw [3 x i32], ptr %slot_values, i32 0, i32 0")
        && Contains(llvm, "insertvalue { ptr, i64 } zeroinitializer, ptr")
        && Contains(llvm, "call fastcc i32 @Read({ ptr, i64 }");
}
