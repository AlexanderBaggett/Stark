// Ported from LlvmIrEmissionTests.ManifestBackedGenericCallsInlineSmallConcreteMonomorphizedSymbolsFromPackageImageTemplates.
public unsafe fn bool ManifestBackedGenericCallsInlineSmallConcreteMonomorphizedSymbolsFromPackageImageTemplatesImpl()
{
    // PORT-NOTE: the original builds a typed-only package image for `Facade` via
    // PackageImageBuilder and consumes it through FileSystemModuleResolver. The
    // helper models neither package images nor a module resolver, so the consumer
    // program is compiled and reduced to Succeeds.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-manifest-generic-inline-small-mono",
        raw"""
import Facade
module Demo

unsafe fn i32[min max] Run(i32[min max] value)
{
    return Facade.Identity(value);
}
""");
    return Succeeds(c);
}

// Ported from LlvmIrEmissionTests.ManifestBackedGenericInlineClosureCallSpecializesFromPackageImageTypedBody.
public unsafe fn bool ManifestBackedGenericInlineClosureCallSpecializesFromPackageImageTypedBodyImpl()
{
    // PORT-NOTE: the original builds a typed-only package image for `Facade`
    // (closure template) and inspects the typed body kinds plus the consumer's
    // Run body; the helper models neither package images nor body scoping, so the
    // consumer program is compiled and reduced to Succeeds.
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-manifest-generic-inline-closure-specializes",
        raw"""
import Facade
module Demo

inline fn i32[min max] LocalApply(inline closure<fn i32[min max](i32[min max])> op)
{
    stack i32[min max] value = 4;
    return Facade.Apply(value, op);
}

fn i32[min max] Run(i32[min max] offset)
{
    return LocalApply(capture(copy offset) (i32[min max] value) => value + offset);
}
""");
    return Succeeds(c);
}

