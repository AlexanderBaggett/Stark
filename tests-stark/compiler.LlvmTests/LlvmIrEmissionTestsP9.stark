// Ported from LlvmIrEmissionTests.SourceBackedGenericCallsInlineSmallConcreteMonomorphizedSymbols.
public unsafe fn bool SourceBackedGenericCallsInlineSmallConcreteMonomorphizedSymbolsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-source-backed-generic-inline-small-mono",
        raw"""
module Demo

unsafe fn T Identity<T>(T value)
{
    return value;
}

unsafe fn i32[min max] Run(i32[min max] value)
{
    return Identity(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define internal dso_local fastcc i32 @__stark_mono_fn_Demo__Identity__i32(")
        && DoesNotContain(llvm, "declare internal fastcc i32 @__stark_mono_fn_Demo__Identity__i32(")
        && DoesNotContain(llvm, "call fastcc i32 @__stark_mono_fn_Demo__Identity__i32(")
        && DoesNotContain(llvm, "call fastcc i32 @Identity(");
}

// Ported from LlvmIrEmissionTests.BackendOpaqueGenericFunctionsRemainOptimizationBoundariesAfterMonomorphization.
public unsafe fn bool BackendOpaqueGenericFunctionsRemainOptimizationBoundariesAfterMonomorphizationImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-backend-opaque-generic-fn-boundary",
        raw"""
module Demo

[Backend(Opaque)]
unsafe fn T Identity<T>(T value)
{
    return value;
}

unsafe fn i32[min max] Run(i32[min max] value)
{
    return Identity(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: ExtractDefinitionHeader(llvm, "__stark_mono_fn_Demo__Identity__i32")
    // scoping is reduced to whole-module substring checks.
    return Contains(llvm, "optnone")
        && Contains(llvm, "noinline")
        && DoesNotContain(llvm, "alwaysinline")
        && Contains(llvm, "call fastcc i32 @__stark_mono_fn_Demo__Identity__i32(");
}

// Ported from LlvmIrEmissionTests.BackendOpaqueGenericTypeMethodsRemainOptimizationBoundariesAfterMonomorphization.
public unsafe fn bool BackendOpaqueGenericTypeMethodsRemainOptimizationBoundariesAfterMonomorphizationImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-backend-opaque-generic-type-method-boundary",
        raw"""
module Demo

[Backend(Opaque)]
struct Box<T>
{
    T Value;

    unsafe fn T Read(borrow Box<T> self)
    {
        return self.Value;
    }
}

unsafe fn i32[min max] Run()
{
    stack Box<i32[min max]> box = new Box<i32[min max]>()
    {
        Value = 7
    };
    return box.Read();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the original isolates the single mono Box_Read define line and
    // captures its symbol via regex to scope the call-site check; reduced here to
    // whole-module substring checks for the mono Box_Read symbol fragments.
    return Contains(llvm, "@__stark_mono_fn_Demo__")
        && Contains(llvm, "Box_Read")
        && Contains(llvm, "optnone")
        && Contains(llvm, "noinline")
        && DoesNotContain(llvm, "alwaysinline")
        && Contains(llvm, "call fastcc i32 @__stark_mono_fn_Demo__");
}

// Ported from LlvmIrEmissionTests.BackendOpaqueStructAndRecordMethodsRemainNarrowOptimizationBoundaries.
public unsafe fn bool BackendOpaqueStructAndRecordMethodsRemainNarrowOptimizationBoundariesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-backend-opaque-struct-record-narrow-boundary",
        raw"""
module Demo

[Backend(Opaque)]
struct Box
{
    i32[min max] Value;

    unsafe finite law i32[min max] Read(borrow Box self)
    {
        return self.Value;
    }
}

struct FastBox
{
    i32[min max] Value;

    unsafe finite law i32[min max] Read(borrow FastBox self)
    {
        return self.Value;
    }
}

[Backend(Opaque)]
record Point(i32[min max] X)
{
    unsafe finite law i32[min max] Read(borrow Point self)
    {
        return self.X;
    }
}

record FastPoint(i32[min max] X)
{
    unsafe finite law i32[min max] Read(borrow FastPoint self)
    {
        return self.X;
    }
}

unsafe fn i32[min max] Run()
{
    stack Box box = new Box()
    {
        Value = 7
    };
    stack FastBox fastBox = new FastBox()
    {
        Value = 3
    };
    stack Point point = new Point(11);
    stack FastPoint fastPoint = new FastPoint(5);
    return box.Read() + fastBox.Read() + point.Read() + fastPoint.Read();
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: ExtractDefinitionHeader(llvm, "<Type>_Read") header scoping for
    // each of the four methods is reduced to whole-module substring checks. The
    // header-local DoesNotContain checks for FastBox_Read / FastPoint_Read
    // (optnone / noinline absent) cannot be expressed without header scoping, so
    // only the alwaysinline presence and the opaque-side optnone/noinline/call
    // fragments are matched.
    return Contains(llvm, "optnone")
        && Contains(llvm, "noinline")
        && Contains(llvm, "call fastcc i32 @Box_Read(")
        && Contains(llvm, "alwaysinline")
        && Contains(llvm, "call fastcc i32 @Point_Read(")
        && Contains(llvm, "@FastBox_Read(")
        && Contains(llvm, "@FastPoint_Read(");
}

// Ported from LlvmIrEmissionTests.BackendOpaqueDoctrineMethodsRemainNarrowOptimizationBoundaries.
public unsafe fn bool BackendOpaqueDoctrineMethodsRemainNarrowOptimizationBoundariesImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-backend-opaque-doctrine-narrow-boundary",
        raw"""
module Demo

[Backend(Opaque)]
doctrine SlowNumbers
{
    unsafe finite law i32[min max] Add(i32[min max] left, i32[min max] right)
    {
        return left + right;
    }
}

doctrine FastNumbers
{
    unsafe finite law i32[min max] Add(i32[min max] left, i32[min max] right)
    {
        return left + right;
    }
}

unsafe fn i32[min max] Run(i32[min max] value)
{
    return SlowNumbers.Add(value, 1) + FastNumbers.Add(value, 2);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: ExtractDefinitionHeader scoping for SlowNumbers_Add /
    // FastNumbers_Add is reduced to whole-module substring checks; the
    // FastNumbers_Add header-local optnone/noinline-absence checks cannot be
    // expressed without header scoping and are dropped.
    return Contains(llvm, "optnone")
        && Contains(llvm, "noinline")
        && Contains(llvm, "call fastcc i32 @SlowNumbers_Add(")
        && Contains(llvm, "alwaysinline")
        && DoesNotContain(llvm, "call fastcc i32 @FastNumbers_Add(");
}

// Ported from LlvmIrEmissionTests.NestedSourceBackedGenericCallsInlineTransitiveSmallConcreteMonomorphizedSymbols.
public unsafe fn bool NestedSourceBackedGenericCallsInlineTransitiveSmallConcreteMonomorphizedSymbolsImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-nested-source-backed-generic-inline-transitive",
        raw"""
module Demo

unsafe fn T Identity<T>(T value)
{
    return value;
}

unsafe fn T Forward<T>(T value)
{
    return Identity(value);
}

unsafe fn i32[min max] Run(i32[min max] value)
{
    return Forward(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define internal dso_local fastcc i32 @__stark_mono_fn_Demo__Forward__i32(")
        && Contains(llvm, "define internal dso_local fastcc i32 @__stark_mono_fn_Demo__Identity__i32(")
        && DoesNotContain(llvm, "call fastcc i32 @__stark_mono_fn_Demo__Forward__i32(")
        && DoesNotContain(llvm, "call fastcc i32 @__stark_mono_fn_Demo__Identity__i32(")
        && DoesNotContain(llvm, "call fastcc i32 @Forward(")
        && DoesNotContain(llvm, "call fastcc i32 @Identity(");
}

