// Ported from LlvmIrEmissionTests.ClosedWorldModulePrivateLawHelpersEmitAlwaysInline.
public unsafe fn bool ClosedWorldModulePrivateLawHelpersEmitAlwaysInlineImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-closed-world-private-law-alwaysinline",
        raw"""
module Demo

unsafe fn i32[min max] Add(i32[min max] left, i32[min max] right)
{
    return left + right;
}

unsafe law i32[min max] Use()
{
    return Add(1, 2);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    return Contains(llvm, "define fastcc i32 @Add(i32 %arg_left, i32 %arg_right) nounwind willreturn mustprogress nosync nofree memory(none) alwaysinline")
        && Contains(llvm, "define fastcc i32 @Use() nounwind willreturn mustprogress nosync nofree memory(none) alwaysinline")
        && DoesNotContain(llvm, "call fastcc i32 @Add(i32 1, i32 2)")
        && Contains(llvm, "ret i32 3");
}

// Ported from LlvmIrEmissionTests.ModulePrivateDirectCallForwardersEmitAlwaysInline.
public unsafe fn bool ModulePrivateDirectCallForwardersEmitAlwaysInlineImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-private-direct-call-forwarder-alwaysinline",
        raw"""
module Demo

unsafe fn i32[min max] Core(i32[min max] value)
{
    return value + 1;
}

unsafe fn i32[min max] Forward(i32[min max] value)
{
    return Core(value);
}

unsafe fn i32[min max] Use(i32[min max] value)
{
    return Forward(value);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the Regex.IsMatch for `define ...@Forward(i32 %arg_value)...alwaysinline`
    // is reduced to whole-module substring checks for the two stable fragments.
    return Contains(llvm, "@Forward(i32 %arg_value)")
        && Contains(llvm, "alwaysinline")
        && DoesNotContain(llvm, "call fastcc i32 @Forward(i32 %arg_value)")
        && DoesNotContain(llvm, "call fastcc i32 @Core(");
}

// Ported from LlvmIrEmissionTests.ModulePrivateMemberCallForwardersEmitAlwaysInline.
public unsafe fn bool ModulePrivateMemberCallForwardersEmitAlwaysInlineImpl()
{
    stack mut LlvmCompile c = CompileLlvm(
        "llvm-p9-private-member-call-forwarder-alwaysinline",
        raw"""
module Demo

record Box(i32[min max] Value)
{
    unsafe fn i32[min max] Bump(borrow Box self, i32[min max] delta)
    {
        return self.Value + delta;
    }
}

unsafe fn i32[min max] Forward(borrow Box box, i32[min max] delta)
{
    return box.Bump(delta);
}

unsafe fn i32[min max] Use(borrow Box box, i32[min max] delta)
{
    return Forward(box, delta);
}
""");
    if (!Succeeds(c))
    {
        return false;
    }

    stack ascii llvm = Llvm(c);
    // PORT-NOTE: the Regex.IsMatch for `define ...@Forward(...alwaysinline` is
    // reduced to whole-module substring checks.
    return Contains(llvm, "@Forward(")
        && Contains(llvm, "alwaysinline")
        && DoesNotContain(llvm, "call fastcc i32 @Forward(");
}

