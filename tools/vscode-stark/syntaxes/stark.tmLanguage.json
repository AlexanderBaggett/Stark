{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stark",
  "scopeName": "source.stark",
  "fileTypes": [
    "stark"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.stark",
          "begin": "(?<!\\S)\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.begin.stark"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.end.stark"
            }
          },
          "patterns": [
            {
              "match": "\\b[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*\\b",
              "name": "entity.name.function.attribute.stark"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.stark",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.stark"
            }
          },
          "end": "$"
        },
        {
          "name": "comment.block.stark",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.stark"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.stark"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.module.stark",
          "match": "\\b(module|import)\\s+([A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.module.stark"
            },
            "2": {
              "name": "entity.name.namespace.stark"
            }
          }
        },
        {
          "name": "meta.type.declaration.stark",
          "match": "\\b(struct|record|enum|trait|doctrine|alias)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.stark"
            },
            "2": {
              "name": "entity.name.type.stark"
            }
          }
        },
        {
          "name": "meta.function.declaration.stark",
          "match": "\\b(fn|law|finite(?:\\s+law)?)\\s+(?:[^\\n(){};]*?\\s+)?([A-Za-z][A-Za-z0-9_]*)\\s*(?=(?:<[^\\n()]*>)?\\()",
          "captures": {
            "1": {
              "name": "storage.type.function.stark"
            },
            "2": {
              "name": "entity.name.function.stark"
            }
          }
        },
        {
          "name": "variable.other.member.self.stark",
          "match": "\\bself\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.declaration.stark",
          "match": "\\b(?:struct|record|enum|trait|doctrine|alias)\\b"
        },
        {
          "name": "storage.type.function.stark",
          "match": "\\b(?:fn|finite|law)\\b"
        },
        {
          "name": "keyword.control.stark",
          "match": "\\b(?:if|else|switch|case|default|when|while|for|return|break|continue|new|where|var|try|is|infinite|non-deterministic|willexit)\\b"
        },
        {
          "name": "keyword.control.import-export.stark",
          "match": "\\b(?:import|module|internal|public|export)\\b"
        },
        {
          "name": "storage.modifier.stark",
          "match": "\\b(?:inline|noinline|inlinehint|hot|cold|ffi|varargs|unsafe|strictfp|static|asm|clobber|in|once|assume)\\b"
        },
        {
          "name": "storage.modifier.storage-class.stark",
          "match": "\\b(?:stack|heap|register|arena|dynamic|dyn|closure)\\b"
        },
        {
          "name": "storage.modifier.memory.stark",
          "match": "\\b(?:borrow|retborrow|storeborrow|frozen|shared|out|init|mut|disjoint|overlap|same|const|comptime|from|independent)\\b"
        },
        {
          "name": "keyword.declaration.destructor.stark",
          "match": "\\bdrop\\b"
        },
        {
          "name": "support.function.builtin.stark",
          "match": "\\b(?:sizeof|alignof)\\b"
        },
        {
          "name": "constant.language.boolean.stark",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.weight.stark",
          "match": "\\bw\\d+\\b"
        },
        {
          "name": "constant.numeric.float.stark",
          "match": "\\b\\d+(?:\\.\\d+)(?:[eE][+-]?\\d+)?[fF]?\\b|\\b\\d+[eE][+-]?\\d+[fF]?\\b"
        },
        {
          "name": "constant.numeric.integer.stark",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.language.range-endpoint.stark",
          "match": "\\b(?:min|max)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.stark",
          "match": "\\+%=|-%=|\\*%=|\\+\\|=|-\\|=|\\*\\|=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|="
        },
        {
          "name": "keyword.operator.comparison.stark",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.stark",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.stark",
          "match": "\\*\\*|\\+%|-%|\\*%|\\+\\||-\\||\\*\\||\\+|-|\\*|/|%|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.other.stark",
          "match": "=>|\\?|\\$|<|>"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.stark",
          "match": ";"
        },
        {
          "name": "punctuation.separator.stark",
          "match": ",|\\."
        },
        {
          "name": "punctuation.section.braces.stark",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.stark",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.stark",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.key-value.stark",
          "match": ":"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.stark",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.stark"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.stark"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.stark",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.stark",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.stark"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.stark"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.stark",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.stark",
          "match": "\\b(?:void|bool|ascii|unicode|Ascii|Unicode|i8|u8|i16|u16|i24|u24|i32|u32|i48|u48|i64|u64|i96|u96|i128|u128|i192|u192|i256|u256|i384|u384|i512|u512|i768|u768|i1024|u1024|f16|f32|f64|f80|f128|rawptr|rawmutptr|fnptr)\\b"
        }
      ]
    }
  }
}
