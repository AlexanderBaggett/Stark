        stack mut u32[0 max] count = 0;
        stack VkResult result = vkEnumerateInstanceExtensionProperties(null, &count, null);
        if (result != VK_SUCCESS)
        {
            return VulkanCountResult.Err(ErrorFromVkResult(result));
