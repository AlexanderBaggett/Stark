public enum VulkanVersionResult
{
    [Ok] Ok(ApiVersion),
    [Err] Err(VulkanError),
}

public enum VulkanCountResult
{
    [Ok] Ok(u32[0 max]),
    [Err] Err(VulkanError),
}

public enum VulkanBoolResult
{
    [Ok] Ok(bool),
    [Err] Err(VulkanError),
}

internal enum VulkanProcAddressResult
{
    [Ok] Ok(rawptr<System.C.c_void>),
    [Err] Err(VulkanError),
}

public enum VulkanGlobalDispatchResult
{
    [Ok] Ok(VulkanGlobalDispatch),
    [Err] Err(VulkanError),
}

public enum VulkanInstanceDispatchResult
{
    [Ok] Ok(VulkanInstanceDispatch),
    [Err] Err(VulkanError),
}

public enum VulkanInstanceResult
{
    [Ok] Ok(VkInstance),
    [Err] Err(VulkanError),
}

public struct ApiVersion
{
    public u32[0 max] Raw;

    public inline finite law u32[0 max] Variant(borrow ApiVersion self)
    {
        return self.Raw >> 29;
    }

    public inline finite law u32[0 max] Major(borrow ApiVersion self)
    {
        return (self.Raw >> 22) & 127;
    }

    public inline finite law u32[0 max] Minor(borrow ApiVersion self)
    {
        return (self.Raw >> 12) & 1023;
    }

    public inline finite law u32[0 max] Patch(borrow ApiVersion self)
    {
        return self.Raw & 4095;
    }
}

public inline finite law u32[0 max] MakeApiVersion(
    u8[0 7] variant,
    u8[0 127] major,
    u16[0 1023] minor,
    u16[0 4095] patch)
{
    return ((u32[0 max])variant << 29) | ((u32[0 max])major << 22) | ((u32[0 max])minor << 12) | (u32[0 max])patch;
}

internal inline finite law VulkanError FromCStringError(System.C.CStringError error)
{
    return VulkanError.CString(error);
}

internal finite law VulkanError ErrorFromVkResult(VkResult result)
{
    if (result == VK_NOT_READY)
    {
        return VulkanError.NotReady;
    }

    if (result == VK_TIMEOUT)
    {
        return VulkanError.Timeout;
    }

    if (result == VK_EVENT_SET)
    {
        return VulkanError.EventSet;
    }

    if (result == VK_EVENT_RESET)
    {
        return VulkanError.EventReset;
    }

    if (result == VK_INCOMPLETE)
    {
        return VulkanError.Incomplete;
    }

    if (result == VK_ERROR_OUT_OF_HOST_MEMORY)
    {
        return VulkanError.OutOfHostMemory;
    }

    if (result == VK_ERROR_OUT_OF_DEVICE_MEMORY)
    {
        return VulkanError.OutOfDeviceMemory;
    }

    if (result == VK_ERROR_INITIALIZATION_FAILED)
    {
        return VulkanError.InitializationFailed;
    }

    if (result == VK_ERROR_DEVICE_LOST)
    {
        return VulkanError.DeviceLost;
    }

    if (result == VK_ERROR_MEMORY_MAP_FAILED)
    {
        return VulkanError.MemoryMapFailed;
    }

    if (result == VK_ERROR_LAYER_NOT_PRESENT)
    {
        return VulkanError.LayerNotPresent;
    }

    if (result == VK_ERROR_EXTENSION_NOT_PRESENT)
    {
        return VulkanError.ExtensionNotPresent;
    }

    if (result == VK_ERROR_FEATURE_NOT_PRESENT)
    {
        return VulkanError.FeatureNotPresent;
    }

    if (result == VK_ERROR_INCOMPATIBLE_DRIVER)
    {
        return VulkanError.IncompatibleDriver;
    }

    if (result == VK_ERROR_TOO_MANY_OBJECTS)
    {
        return VulkanError.TooManyObjects;
    }

    if (result == VK_ERROR_FORMAT_NOT_SUPPORTED)
    {
        return VulkanError.FormatNotSupported;
    }

    if (result == VK_ERROR_FRAGMENTED_POOL)
    {
        return VulkanError.FragmentedPool;
    }

    if (result == VK_ERROR_UNKNOWN)
    {
        return VulkanError.Unknown;
    }

    return VulkanError.Native(result);
}

internal finite law VulkanStatus StatusFromVkResult(VkResult result)
{
    if (result == VK_SUCCESS)
    {
        return VulkanStatus.Ok;
    }

    return VulkanStatus.Err(ErrorFromVkResult(result));
}

internal fn VulkanProcAddressResult GetGlobalProcAddress(ascii name)
{
    stack System.C.CStringResult<System.C.OwnedCStr> nameResult = System.C.FromAscii(name);
    switch (nameResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return VulkanProcAddressResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cName):
            unsafe
            {
                stack rawptr<System.C.c_void> symbol = vkGetInstanceProcAddr(null, cName.Data());
                if (symbol == null)
                {
                    return VulkanProcAddressResult.Err(VulkanError.ExtensionNotPresent);
                }

                return VulkanProcAddressResult.Ok(symbol);
            }
    }
}

internal fn VulkanProcAddressResult GetInstanceProcAddress(borrow VkInstance instance, ascii name)
{
    if (instance.Handle == null)
    {
        return VulkanProcAddressResult.Err(VulkanError.NullHandle);
    }

    stack System.C.CStringResult<System.C.OwnedCStr> nameResult = System.C.FromAscii(name);
    switch (nameResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return VulkanProcAddressResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cName):
            unsafe
            {
                stack rawptr<System.C.c_void> symbol = vkGetInstanceProcAddr(instance.Handle, cName.Data());
                if (symbol == null)
                {
                    return VulkanProcAddressResult.Err(VulkanError.ExtensionNotPresent);
                }

                return VulkanProcAddressResult.Ok(symbol);
            }
    }
}

public fn VulkanGlobalDispatchResult LoadGlobalDispatch()
{
    unsafe
    {
        stack mut PfnVkEnumerateInstanceVersion enumerateInstanceVersion;
        switch (GetGlobalProcAddress("vkEnumerateInstanceVersion"))
        {
            case VulkanProcAddressResult.Err(var error):
                return VulkanGlobalDispatchResult.Err(error);
            case VulkanProcAddressResult.Ok(var symbol):
                enumerateInstanceVersion = (PfnVkEnumerateInstanceVersion)symbol;
        }

        stack mut PfnVkEnumerateInstanceLayerProperties enumerateInstanceLayerProperties;
        switch (GetGlobalProcAddress("vkEnumerateInstanceLayerProperties"))
        {
            case VulkanProcAddressResult.Err(var error):
                return VulkanGlobalDispatchResult.Err(error);
            case VulkanProcAddressResult.Ok(var symbol):
                enumerateInstanceLayerProperties = (PfnVkEnumerateInstanceLayerProperties)symbol;
        }

        stack mut PfnVkEnumerateInstanceExtensionProperties enumerateInstanceExtensionProperties;
        switch (GetGlobalProcAddress("vkEnumerateInstanceExtensionProperties"))
        {
            case VulkanProcAddressResult.Err(var error):
                return VulkanGlobalDispatchResult.Err(error);
            case VulkanProcAddressResult.Ok(var symbol):
                enumerateInstanceExtensionProperties = (PfnVkEnumerateInstanceExtensionProperties)symbol;
        }

        stack mut PfnVkCreateInstance createInstance;
        switch (GetGlobalProcAddress("vkCreateInstance"))
        {
            case VulkanProcAddressResult.Err(var error):
                return VulkanGlobalDispatchResult.Err(error);
            case VulkanProcAddressResult.Ok(var symbol):
                createInstance = (PfnVkCreateInstance)symbol;
        }

        return VulkanGlobalDispatchResult.Ok(new VulkanGlobalDispatch()
        {
            EnumerateInstanceVersion = enumerateInstanceVersion,
            EnumerateInstanceLayerProperties = enumerateInstanceLayerProperties,
            EnumerateInstanceExtensionProperties = enumerateInstanceExtensionProperties,
            CreateInstance = createInstance
        });
    }
}

public fn VulkanInstanceDispatchResult LoadInstanceDispatch(borrow VkInstance instance)
{
    unsafe
    {
        stack mut PfnVkDestroyInstance destroyInstance;
        switch (GetInstanceProcAddress(instance, "vkDestroyInstance"))
        {
            case VulkanProcAddressResult.Err(var error):
                return VulkanInstanceDispatchResult.Err(error);
            case VulkanProcAddressResult.Ok(var symbol):
                destroyInstance = (PfnVkDestroyInstance)symbol;
        }

        stack mut PfnVkEnumeratePhysicalDevices enumeratePhysicalDevices;
        switch (GetInstanceProcAddress(instance, "vkEnumeratePhysicalDevices"))
        {
            case VulkanProcAddressResult.Err(var error):
                return VulkanInstanceDispatchResult.Err(error);
            case VulkanProcAddressResult.Ok(var symbol):
                enumeratePhysicalDevices = (PfnVkEnumeratePhysicalDevices)symbol;
        }

        return VulkanInstanceDispatchResult.Ok(new VulkanInstanceDispatch()
        {
            DestroyInstance = destroyInstance,
            EnumeratePhysicalDevices = enumeratePhysicalDevices
        });
    }
}

public fn VulkanVersionResult EnumerateInstanceVersion(borrow VulkanGlobalDispatch dispatch)
{
    unsafe
    {
        stack mut u32[0 max] version = VK_API_VERSION_1_0;
        stack VkResult result = dispatch.EnumerateInstanceVersion(&version);
        if (result != VK_SUCCESS)
        {
            return VulkanVersionResult.Err(ErrorFromVkResult(result));
        }

        return VulkanVersionResult.Ok(new ApiVersion()
        {
            Raw = version
        });
    }
}

public fn VulkanCountResult InstanceLayerCount(borrow VulkanGlobalDispatch dispatch)
{
    unsafe
    {
        stack mut u32[0 max] count = 0;
        stack VkResult result = dispatch.EnumerateInstanceLayerProperties(&count, null);
        if (result != VK_SUCCESS)
        {
            return VulkanCountResult.Err(ErrorFromVkResult(result));
        }

        return VulkanCountResult.Ok(count);
    }
}

public fn VulkanCountResult InstanceExtensionCount(borrow VulkanGlobalDispatch dispatch)
{
    unsafe
    {
        stack mut u32[0 max] count = 0;
        stack VkResult result = dispatch.EnumerateInstanceExtensionProperties(null, &count, null);
        if (result != VK_SUCCESS)
        {
            return VulkanCountResult.Err(ErrorFromVkResult(result));
        }

        return VulkanCountResult.Ok(count);
    }
}

public fn VulkanCountResult PhysicalDeviceCount(borrow VulkanInstanceDispatch dispatch, borrow VkInstance instance)
{
    if (instance.Handle == null)
    {
        return VulkanCountResult.Err(VulkanError.NullHandle);
    }

    unsafe
    {
        stack mut u32[0 max] count = 0;
        stack VkResult result = dispatch.EnumeratePhysicalDevices(instance.Handle, &count, null);
        if (result != VK_SUCCESS)
        {
            return VulkanCountResult.Err(ErrorFromVkResult(result));
        }

        return VulkanCountResult.Ok(count);
    }
}

