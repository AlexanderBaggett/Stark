public fn VulkanCountResult InstanceExtensionCountForLayer(ascii layerName)
{
    stack System.C.CStringResult<System.C.OwnedCStr> layerNameResult = System.C.FromAscii(layerName);
    switch (layerNameResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return VulkanCountResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cLayerName):
            unsafe
            {
                stack mut u32[0 max] count = 0;
                stack VkResult result = vkEnumerateInstanceExtensionProperties(cLayerName.Data(), &count, null);
                if (result != VK_SUCCESS)
                {
                    return VulkanCountResult.Err(ErrorFromVkResult(result));
                }

                return VulkanCountResult.Ok(count);
            }
    }
}

public fn VulkanInstanceResult CreateDefaultInstance(ascii applicationName, u32[0 max] apiVersion)
{
    stack System.C.CStringResult<System.C.OwnedCStr> applicationNameResult = System.C.FromAscii(applicationName);
    switch (applicationNameResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return VulkanInstanceResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cApplicationName):
            unsafe
            {
                stack VkApplicationInfo applicationInfo = new VkApplicationInfo()
                {
                    sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
                    pNext = null,
                    pApplicationName = cApplicationName.Data(),
                    applicationVersion = 0,
                    pEngineName = null,
                    engineVersion = 0,
                    apiVersion = apiVersion
                };

                stack VkInstanceCreateInfo createInfo = new VkInstanceCreateInfo()
                {
                    sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
                    pNext = null,
                    flags = 0,
                    pApplicationInfo = &applicationInfo,
                    enabledLayerCount = 0,
                    ppEnabledLayerNames = null,
                    enabledExtensionCount = 0,
                    ppEnabledExtensionNames = null
                };

                stack mut rawmutptr<VkInstanceNative> handle = null;
                stack VkResult result = vkCreateInstance(&createInfo, null, &handle);
                if (result != VK_SUCCESS)
                {
                    return VulkanInstanceResult.Err(ErrorFromVkResult(result));
                }

                return VulkanInstanceResult.Ok(new VkInstance()
                {
                    Handle = handle
                });
            }
    }
}

public fn void DestroyInstance(mut borrow VkInstance instance)
{
    unsafe
    {
        if (instance.Handle != null)
        {
            vkDestroyInstance(instance.Handle, null);
            instance.Handle = null;
        }
    }

    return;
}

public fn VulkanCountResult PhysicalDeviceCount(borrow VkInstance instance)
{
    if (instance.Handle == null)
    {
        return VulkanCountResult.Err(VulkanError.NullHandle);
    }

    unsafe
    {
        stack mut u32[0 max] count = 0;
        stack VkResult result = vkEnumeratePhysicalDevices(instance.Handle, &count, null);
        if (result != VK_SUCCESS)
        {
            return VulkanCountResult.Err(ErrorFromVkResult(result));
        }

        return VulkanCountResult.Ok(count);
    }
}

public fn VulkanBoolResult GlobalProcAvailable(ascii name)
{
    stack System.C.CStringResult<System.C.OwnedCStr> nameResult = System.C.FromAscii(name);
    switch (nameResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return VulkanBoolResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cName):
            unsafe
            {
                return VulkanBoolResult.Ok(vkGetInstanceProcAddr(null, cName.Data()) != null);
            }
    }
}
