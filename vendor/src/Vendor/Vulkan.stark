{
    unsafe
    {
        stack mut u32[0 max] version = VK_API_VERSION_1_0;
        stack VkResult result = vkEnumerateInstanceVersion(&version);
        if (result != VK_SUCCESS)
        {
            return VulkanVersionResult.Err(ErrorFromVkResult(result));
        }

        return VulkanVersionResult.Ok(new ApiVersion()
        {
            Raw = version
        });
    }
}

