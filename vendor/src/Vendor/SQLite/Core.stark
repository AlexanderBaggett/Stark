    {
        stack mut rawmutptr<SQLite3ValueNative> value = null;
        stack System.C.c_int nativeConstraintIndex = (i32[min max])constraintIndex;
        stack System.C.c_int status = sqlite3_vtab_rhs_value(indexInfo, nativeConstraintIndex, &value);
        if (status != SQLITE_OK)
