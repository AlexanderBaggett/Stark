        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cDestinationSchema):
            stack System.C.CStringResult<System.C.OwnedCStr> sourceSchemaResult = System.C.FromAscii(sourceSchemaName);
            switch (sourceSchemaResult)
