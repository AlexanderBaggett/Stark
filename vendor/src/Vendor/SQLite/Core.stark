internal finite law SQLiteError FromCStringError(System.C.CStringError error)
{
    return SQLiteError.CString(error);
}

internal unsafe finite law rawptr<System.C.c_char> PointerTypeData(borrow SQLitePointerType typeName)
{
    return typeName.Name.Data();
}

internal unsafe finite law rawptr<System.C.c_char> ClientDataKeyData(borrow SQLiteClientDataKey key)
{
    return key.Name.Data();
}

public fn SQLitePointerTypeResult CreatePointerType(ascii typeName)
{
    stack System.C.CStringResult<System.C.OwnedCStr> typeResult = System.C.FromAscii(typeName);
    switch (typeResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLitePointerTypeResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cType):
            return SQLitePointerTypeResult.Ok(new SQLitePointerType()
            {
                Name = cType
            });
    }
}

public fn SQLiteClientDataKeyResult CreateClientDataKey(ascii name)
{
    stack System.C.CStringResult<System.C.OwnedCStr> nameResult = System.C.FromAscii(name);
    switch (nameResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteClientDataKeyResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cName):
            return SQLiteClientDataKeyResult.Ok(new SQLiteClientDataKey()
            {
                Name = cName
            });
    }
}

internal finite law SQLiteError FromMemoryError(System.Memory.MemoryError error)
{
    switch (error)
    {
        case System.Memory.MemoryError.OutOfMemory:
            return SQLiteError.SQLite(SQLiteStatus.NoMemory);
        case System.Memory.MemoryError.TooLarge:
            return SQLiteError.TooLarge;
        case System.Memory.MemoryError.InvalidLayout:
            return SQLiteError.SQLite(SQLiteStatus.Misuse);
        case System.Memory.MemoryError.UnsupportedAlignment:
            return SQLiteError.SQLite(SQLiteStatus.Misuse);
    }
}

internal finite law SQLiteStatusResult FromMemoryStatus(System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Ok:
            return SQLiteStatusResult.Ok;
        case System.Memory.MemoryStatus.Err(var error):
            return SQLiteStatusResult.Err(FromMemoryError(error));
    }
}

internal finite law SQLiteStatusResult OperationFromCode(System.C.c_int code)
{
    return StatusResultFromCode((i32[min max])code);
}

internal finite law System.C.c_int BoolToCInt(bool value)
{
    if (value)
    {
        return 1;
    }

    return 0;
}

internal finite law bool IsBooleanDatabaseConfigOption(i32[min max] option)
{
    return option == SQLITE_DBCONFIG_ENABLE_FKEY
        || option == SQLITE_DBCONFIG_ENABLE_TRIGGER
        || option == SQLITE_DBCONFIG_ENABLE_FTS3_TOKENIZER
        || option == SQLITE_DBCONFIG_ENABLE_LOAD_EXTENSION
        || option == SQLITE_DBCONFIG_NO_CKPT_ON_CLOSE
        || option == SQLITE_DBCONFIG_ENABLE_QPSG
        || option == SQLITE_DBCONFIG_TRIGGER_EQP
        || option == SQLITE_DBCONFIG_RESET_DATABASE
        || option == SQLITE_DBCONFIG_DEFENSIVE
        || option == SQLITE_DBCONFIG_WRITABLE_SCHEMA
        || option == SQLITE_DBCONFIG_LEGACY_ALTER_TABLE
        || option == SQLITE_DBCONFIG_DQS_DML
        || option == SQLITE_DBCONFIG_DQS_DDL
        || option == SQLITE_DBCONFIG_ENABLE_VIEW
        || option == SQLITE_DBCONFIG_LEGACY_FILE_FORMAT
        || option == SQLITE_DBCONFIG_TRUSTED_SCHEMA
        || option == SQLITE_DBCONFIG_STMT_SCANSTATUS
        || option == SQLITE_DBCONFIG_REVERSE_SCANORDER
        || option == SQLITE_DBCONFIG_ENABLE_ATTACH_CREATE
        || option == SQLITE_DBCONFIG_ENABLE_ATTACH_WRITE
        || option == SQLITE_DBCONFIG_ENABLE_COMMENTS;
}

internal finite law bool IsValidLookasideSlotSize(u16[8 65528] slotSize)
{
    return (slotSize % 8) == 0;
}

internal finite law bool LookasideByteProductFits(u16[8 65528] slotSize, u32[1 2147483647] slotCount)
{
    stack u64[0 max] byteCount = (u64[0 max])slotSize * (u64[0 max])slotCount;
    return byteCount <= 2147418112;
}

internal finite law u64[0 2 ** 63 - 1] LookasideWordCount(u16[8 65528] slotSize, u32[1 2147483647] slotCount)
{
    stack u64[0 max] byteCount = (u64[0 max])slotSize * (u64[0 max])slotCount;
    return (u64[0 2 ** 63 - 1])((byteCount + 7) / 8);
}

internal unsafe fn SQLiteTextResult CopyCText(rawptr<System.C.c_char> text, u64[0 2 ** 63 - 1] maxLength)
{
    unsafe
    {
        stack System.C.CStringResult<System.C.CStr> viewResult = System.C.TryFromRawBounded(text, maxLength);
        switch (viewResult)
        {
            case System.C.CStringResult<System.C.CStr>.Err(var error):
                return SQLiteTextResult.Err(FromCStringError(error));
            case System.C.CStringResult<System.C.CStr>.Ok(var view):
                stack System.C.CStringResult<System.Text.OwnedAscii> asciiResult = System.C.ToAscii(view);
                switch (asciiResult)
                {
                    case System.C.CStringResult<System.Text.OwnedAscii>.Err(var asciiError):
                        return SQLiteTextResult.Err(FromCStringError(asciiError));
                    case System.C.CStringResult<System.Text.OwnedAscii>.Ok(var value):
                        return SQLiteTextResult.Ok(value);
                }
        }
    }
}

internal unsafe fn SQLiteTextResult CopyCTextWithLength(
    rawptr<System.C.c_char> text,
    u64[0 2 ** 63 - 1] length)
{
    unsafe
    {
        if (text == null)
        {
            return SQLiteTextResult.Err(SQLiteError.NullValue);
        }

        stack System.C.CStr view = System.C.FromRawUnchecked(text, length);
        stack System.C.CStringResult<System.Text.OwnedAscii> asciiResult = System.C.ToAscii(view);
        switch (asciiResult)
        {
            case System.C.CStringResult<System.Text.OwnedAscii>.Err(var error):
                return SQLiteTextResult.Err(FromCStringError(error));
            case System.C.CStringResult<System.Text.OwnedAscii>.Ok(var value):
                return SQLiteTextResult.Ok(value);
        }
    }
}

internal unsafe fn SQLiteUtf16Result CopyUtf16PointerWithByteLength(
    rawptr<System.C.c_void> text,
    u64[0 2 ** 63 - 1] byteLength)
{
    if ((byteLength & 1) != 0)
    {
        return SQLiteUtf16Result.Err(SQLiteError.SQLite(SQLiteStatus.Mismatch));
    }

    stack u64[0 2 ** 63 - 1] unitCount = byteLength / 2;
    stack mut System.Text.OwnedUtf16 result = new();
    if (unitCount == 0)
    {
        return SQLiteUtf16Result.Ok(result);
    }

    if (text == null)
    {
        return SQLiteUtf16Result.Err(SQLiteError.NullValue);
    }

    unsafe
    {
        stack rawptr<i16[min max]> units = (rawptr<i16[min max]>)text;
        stack mut u64[0 2 ** 63 - 1] index = 0;
        while willexit (index < unitCount)
        {
            stack System.Memory.MemoryStatus appendStatus = result.AppendCodeUnit(*(&units[index]));
            switch (appendStatus)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return SQLiteUtf16Result.Err(FromMemoryError(error));
                case System.Memory.MemoryStatus.Ok:
            }

            index += 1;
        }
    }

    return SQLiteUtf16Result.Ok(result);
}

internal unsafe fn SQLiteUtf16Result CopyUtf16NullTerminated(
    rawptr<System.C.c_void> text,
    u16[1 4096] maxUnits)
{
    if (text == null)
    {
        return SQLiteUtf16Result.Err(SQLiteError.NullValue);
    }

    stack mut System.Text.OwnedUtf16 result = new();
    unsafe
    {
        stack rawptr<i16[min max]> units = (rawptr<i16[min max]>)text;
        stack mut u16[0 4096] index = 0;
        while willexit (index < maxUnits)
        {
            stack i16[min max] unit = *(&units[index]);
            if (unit == 0)
            {
                return SQLiteUtf16Result.Ok(result);
            }

            stack System.Memory.MemoryStatus appendStatus = result.AppendCodeUnit(unit);
            switch (appendStatus)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return SQLiteUtf16Result.Err(FromMemoryError(error));
                case System.Memory.MemoryStatus.Ok:
            }

            index += 1;
        }
    }

    return SQLiteUtf16Result.Err(SQLiteError.TooLarge);
}

internal unsafe fn SQLiteBytesResult CopyBytesPointer(rawptr<System.C.c_void> data, u64[0 max] byteLength)
{
    if (byteLength == 0)
    {
        return SQLiteBytesResult.Ok(new SQLiteOwnedBytes()
        {
            Data = null,
            ByteLength = 0
        });
    }

    if (data == null)
    {
        return SQLiteBytesResult.Err(SQLiteError.NullValue);
    }

    unsafe
    {
        stack rawmutptr<u8[0 max]> destination = (rawmutptr<u8[0 max]>)sqlite3_malloc64(byteLength);
        if (destination == null)
        {
            return SQLiteBytesResult.Err(SQLiteError.SQLite(SQLiteStatus.NoMemory));
        }

        stack rawptr<u8[0 max]> source = (rawptr<u8[0 max]>)data;
        stack mut u64[0 max] index = 0;
        while willexit (index < byteLength)
        {
            *(&destination[index]) = *(&source[index]);
            index += 1;
        }

        return SQLiteBytesResult.Ok(new SQLiteOwnedBytes()
        {
            Data = destination,
            ByteLength = byteLength
        });
    }
}

internal unsafe fn SQLiteByteViewResult BorrowBytesPointer(rawptr<System.C.c_void> data, u64[0 max] byteLength)
{
    if (byteLength != 0 && data == null)
    {
        return SQLiteByteViewResult.Err(SQLiteError.NullValue);
    }

    return SQLiteByteViewResult.Ok(new SQLiteByteView()
    {
        Pointer = (rawptr<u8[0 max]>)data,
        ByteLength = byteLength
    });
}

internal fn SQLiteUtf16Result Utf16FromAsciiWithTerminator(ascii value)
{
    stack mut System.Text.OwnedUtf16 text = new();
    stack System.Memory.MemoryStatus convertStatus = text.AppendAscii(value);
    switch (convertStatus)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return SQLiteUtf16Result.Err(FromMemoryError(error));
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus terminatorStatus = text.AppendCodeUnit(0);
    switch (terminatorStatus)
    {
        case System.Memory.MemoryStatus.Err(var terminatorError):
            return SQLiteUtf16Result.Err(FromMemoryError(terminatorError));
        case System.Memory.MemoryStatus.Ok:
            return SQLiteUtf16Result.Ok(text);
    }
}

internal fn SQLiteUtf16Result Utf16FromUnicodeWithTerminator(unicode value)
{
    stack mut System.Text.OwnedUtf16 text = new();
    stack System.Memory.MemoryStatus convertStatus = text.AppendUnicode(value);
    switch (convertStatus)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return SQLiteUtf16Result.Err(FromMemoryError(error));
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus terminatorStatus = text.AppendCodeUnit(0);
    switch (terminatorStatus)
    {
        case System.Memory.MemoryStatus.Err(var terminatorError):
            return SQLiteUtf16Result.Err(FromMemoryError(terminatorError));
        case System.Memory.MemoryStatus.Ok:
            return SQLiteUtf16Result.Ok(text);
    }
}

internal unsafe finite law rawptr<System.C.c_void> Utf16Data(borrow System.Text.OwnedUtf16 text)
{
    stack i16[min max][] units = text.AsSlice();
    return (rawptr<System.C.c_void>)(&units[0]);
}

