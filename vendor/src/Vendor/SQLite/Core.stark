            case SQLiteStatusResult.Err(var error):
                return SQLiteTextResult.Err(error);
            case SQLiteStatusResult.Ok:
                return SQLiteTextResult.Err(SQLiteError.NullHandle);
        }
    }

    unsafe
    {
        stack System.C.c_int byteLength = sqlite3_str_length(builder.Handle);
        if (byteLength < 0)
        {
            return SQLiteTextResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
        }

        stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])byteLength;
        if (length > (u64[0 2 ** 63 - 1])maxLength)
        {
            return SQLiteTextResult.Err(SQLiteError.TooLarge);
