        if (!cValues.TryReserveCapacity(values.Length) || !pointers.TryReserveCapacity(values.Length))
        {
            return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.NoMemory));
        }

        for willexit (stack mut u64[0 max] valueIndex = 0; valueIndex < values.Length; valueIndex += 1)
        {
