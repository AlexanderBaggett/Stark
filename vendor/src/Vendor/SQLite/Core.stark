public fn SQLiteIntResult SetLimit(borrow Database database, i32[min max] limitId, i32[min max] newValue)
{
    if (database.Handle == null)
    {
        return SQLiteIntResult.Err(SQLiteError.NullHandle);
    }

    unsafe
    {
        stack System.C.c_int nativeLimitId = limitId;
        stack System.C.c_int nativeNewValue = newValue;
        return SQLiteIntResult.Ok((i32[min max])sqlite3_limit(database.Handle, nativeLimitId, nativeNewValue));
    }
}

public fn bool HasOpenStatements(borrow Database database)
{
    if (database.Handle == null)
    {
        return false;
    }

    unsafe
    {
        return sqlite3_next_stmt(database.Handle, null) != null;
    }
}

public fn SQLiteIntResult OpenStatementCount(borrow Database database)
{
    if (database.Handle == null)
    {
        return SQLiteIntResult.Err(SQLiteError.NullHandle);
    }

    stack mut i32[min max] count = 0;
    unsafe
    {
        stack mut rawmutptr<SQLite3StatementNative> current = sqlite3_next_stmt(database.Handle, null);
        while willexit (current != null)
        {
            count += 1;
            current = sqlite3_next_stmt(database.Handle, current);
        }
    }

    return SQLiteIntResult.Ok(count);
}

