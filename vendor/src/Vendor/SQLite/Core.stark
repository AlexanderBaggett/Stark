public unsafe fn SQLiteStatusResult RegisterScalarFunctionWithUserData(
    mut borrow Database database,
    ascii name,
    i8[-1 max] argumentCount,
    i32[min max] flags,
    rawmutptr<System.C.c_void> userData,
    SQLiteScalarCallback callback)
    where overlap(name, userData)
{
    stack SQLiteStatusResult handleResult = RequireDatabaseHandle(database);
    if (handleResult != SQLiteStatusResult.Ok)
    {
        return handleResult;
    }

    stack System.C.CStringResult<System.C.OwnedCStr> nameResult = System.C.FromAscii(name);
    switch (nameResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteStatusResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cName):
            unsafe
            {
                stack System.C.c_int nativeArgumentCount = (i32[min max])argumentCount;
                stack System.C.c_int nativeFlags = flags;
                return OperationFromCode(sqlite3_create_function_v2(
                    database.Handle,
                    cName.Data(),
                    nativeArgumentCount,
                    nativeFlags,
                    userData,
                    (rawptr<i8[min max]>)callback,
                    null,
                    null,
                    null));
            }
    }
}

