                case System.C.CStringResult<System.C.OwnedCStr>.Err(var sourceError):
                    return SQLiteBackupResult.Err(FromCStringError(sourceError));
                case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cSourceSchema):
