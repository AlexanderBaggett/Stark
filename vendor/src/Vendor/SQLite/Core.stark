public fn SQLiteStatusResult Execute(mut borrow Database database, ascii sql)
{
    stack SQLiteStatusResult handleResult = RequireDatabaseHandle(database);
    if (handleResult != SQLiteStatusResult.Ok)
    {
        return handleResult;
    }

    stack System.C.CStringResult<System.C.OwnedCStr> sqlResult = System.C.FromAscii(sql);
    switch (sqlResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteStatusResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cSql):
            unsafe
            {
                stack System.C.c_int status = sqlite3_exec(database.Handle, cSql.Data(), null, null, null);
                return OperationFromCode(status);
            }
    }
}

public fn SQLiteStatementResult Prepare(mut borrow Database database, ascii sql)
{
    stack SQLiteStatusResult handleResult = RequireDatabaseHandle(database);
    if (handleResult != SQLiteStatusResult.Ok)
    {
        switch (handleResult)
        {
            case SQLiteStatusResult.Err(var error):
                return SQLiteStatementResult.Err(error);
            case SQLiteStatusResult.Ok:
                return SQLiteStatementResult.Err(SQLiteError.NullHandle);
        }
    }

    stack System.C.CStringResult<System.C.OwnedCStr> sqlResult = System.C.FromAscii(sql);
    switch (sqlResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteStatementResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cSql):
            unsafe
            {
                stack mut rawmutptr<SQLite3StatementNative> statement = null;
                stack System.C.c_int byteCount = -1;
                stack System.C.c_int status = sqlite3_prepare_v2(database.Handle, cSql.Data(), byteCount, &statement, null);
                if (status != SQLITE_OK)
                {
                    if (statement != null)
                    {
                        sqlite3_finalize(statement);
                    }

                    return SQLiteStatementResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
                }

                if (statement == null)
                {
                    return SQLiteStatementResult.Err(SQLiteError.NoStatement);
                }

                return SQLiteStatementResult.Ok(new Statement()
                {
                    Handle = statement
                });
            }
    }
}

