public unsafe fn SQLiteStatusResult ResultPointer(
    rawmutptr<SQLite3ContextNative> context,
    rawmutptr<System.C.c_void> pointer,
    borrow SQLitePointerType typeName)
    where overlap(context, pointer),
        overlap(context, typeName),
        overlap(typeName, pointer)
{
    if (context == null)
    {
        return SQLiteStatusResult.Err(SQLiteError.NullHandle);
    }

    unsafe
    {
        sqlite3_result_pointer(context, pointer, PointerTypeData(typeName), null);
        return SQLiteStatusResult.Ok;
    }
}

public unsafe fn SQLiteStatusResult ResultPointerWithDestructor(
    rawmutptr<SQLite3ContextNative> context,
    rawmutptr<System.C.c_void> pointer,
    borrow SQLitePointerType typeName,
    SQLitePointerDestructor destroy)
    where overlap(context, pointer),
        overlap(context, typeName),
        overlap(typeName, pointer)
{
    if (context == null)
    {
        return SQLiteStatusResult.Err(SQLiteError.NullHandle);
    }

    unsafe
    {
        sqlite3_result_pointer(
            context,
            pointer,
            PointerTypeData(typeName),
            (rawptr<i8[min max]>)destroy);
        return SQLiteStatusResult.Ok;
    }
}

