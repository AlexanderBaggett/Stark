        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var format):
            stack System.C.CStringResult<System.C.OwnedCStr> valueResult = System.C.FromAscii(value);
            switch (valueResult)
            {
                case System.C.CStringResult<System.C.OwnedCStr>.Err(var valueError):
                    return SQLiteTextResult.Err(FromCStringError(valueError));
                case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cValue):
                    unsafe
                    {
                        stack rawmutptr<System.C.c_char> text = sqlite3_mprintf(format.Data(), cValue.Data());
                        return CopySQLiteOwnedCTextAndFree(text, (u64[0 2 ** 63 - 1])maxLength);
                    }
            }
    }
}

public fn SQLiteTextResult FormatSqlTextLiteralFixed(ascii value, u16[2 4096] capacity)
{
    stack System.C.CStringResult<System.C.OwnedCStr> formatResult = System.C.FromAscii("%Q");
    switch (formatResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteTextResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var format):
            stack System.C.CStringResult<System.C.OwnedCStr> valueResult = System.C.FromAscii(value);
            switch (valueResult)
            {
                case System.C.CStringResult<System.C.OwnedCStr>.Err(var valueError):
                    return SQLiteTextResult.Err(FromCStringError(valueError));
                case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cValue):
                    stack System.C.CStringResult<System.C.CCharBuffer> bufferResult =
                        System.C.NewCCharBuffer((u64[1 2 ** 63 - 1])capacity);
                    switch (bufferResult)
                    {
                        case System.C.CStringResult<System.C.CCharBuffer>.Err(var bufferError):
                            return SQLiteTextResult.Err(FromCStringError(bufferError));
                        case System.C.CStringResult<System.C.CCharBuffer>.Ok(var bufferValue):
                            stack mut System.C.CCharBuffer buffer = bufferValue;
                            unsafe
                            {
                                stack System.C.c_int nativeCapacity = (i32[min max])capacity;
                                sqlite3_snprintf(nativeCapacity, buffer.Data(), format.Data(), cValue.Data());
                                stack System.C.CStringResult<System.C.CStr> viewResult = buffer.TryAsCStr();
                                switch (viewResult)
                                {
                                    case System.C.CStringResult<System.C.CStr>.Err(var viewError):
                                        return SQLiteTextResult.Err(FromCStringError(viewError));
                                    case System.C.CStringResult<System.C.CStr>.Ok(var view):
                                        if (view.Length() >= (u64[0 2 ** 63 - 1])(capacity - 1))
                                        {
                                            return SQLiteTextResult.Err(SQLiteError.TooLarge);
                                        }

                                        stack System.C.CStringResult<System.Text.OwnedAscii> asciiResult = System.C.ToAscii(view);
                                        switch (asciiResult)
                                        {
                                            case System.C.CStringResult<System.Text.OwnedAscii>.Err(var asciiError):
                                                return SQLiteTextResult.Err(FromCStringError(asciiError));
                                            case System.C.CStringResult<System.Text.OwnedAscii>.Ok(var text):
                                                return SQLiteTextResult.Ok(text);
                                        }
                                }
                            }
                    }
            }
    }
}

