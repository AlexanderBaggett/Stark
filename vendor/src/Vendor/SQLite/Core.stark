public unsafe fn SQLitePreupdateValueResult PreupdateOldValue(
    SQLiteDatabaseCallback database,
    u32[0 2147483647] column)
{
    if (database == null)
    {
        return SQLitePreupdateValueResult.Err(SQLiteError.NullHandle);
