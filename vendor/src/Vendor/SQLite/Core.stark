public fn SQLiteStatusResult DeserializeDatabaseWithCapacity(
    mut borrow Database database,
    ascii schemaName,
    borrow u8[0 max][] bytes,
    u64[0 max] capacity,
    i32[min max] flags)
{
    stack SQLiteStatusResult handleResult = RequireDatabaseHandle(database);
    if (handleResult != SQLiteStatusResult.Ok)
    {
        return handleResult;
    }

    if (bytes.Length == 0 || capacity < bytes.Length)
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    if (bytes.Length > (u64[0 max])(2 ** 63 - 1) || capacity > (u64[0 max])(2 ** 63 - 1))
    {
        return SQLiteStatusResult.Err(SQLiteError.TooLarge);
    }

    if (flags < 0 || flags > 7)
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    stack System.C.CStringResult<System.C.OwnedCStr> schemaResult = System.C.FromAscii(schemaName);
    switch (schemaResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteStatusResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cSchema):
            unsafe
            {
                stack rawmutptr<u8[0 max]> data = (rawmutptr<u8[0 max]>)sqlite3_malloc64(capacity);
                if (data == null)
                {
                    return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.NoMemory));
                }

                stack mut u64[0 max] index = 0;
                while willexit (index < bytes.Length)
                {
                    *(&data[index]) = bytes[index];
                    index += 1;
                }

                stack i64[min max] byteCount = (i64[min max])bytes.Length;
                stack i64[min max] bufferSize = (i64[min max])capacity;
                stack System.C.c_uint nativeFlags = (u32[0 max])(flags | SQLITE_DESERIALIZE_FREEONCLOSE);
                stack System.C.c_int status = sqlite3_deserialize(
                    database.Handle,
                    cSchema.Data(),
                    data,
                    byteCount,
                    bufferSize,
                    nativeFlags);
                return OperationFromCode(status);
            }
    }
}

