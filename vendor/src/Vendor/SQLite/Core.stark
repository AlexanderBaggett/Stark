public unsafe fn SQLiteStatusResult ConfigureDefaultLookaside(
    u16[8 65528] slotSize,
    u32[1 2147483647] slotCount)
{
    if (!IsValidLookasideSlotSize(slotSize) || !LookasideByteProductFits(slotSize, slotCount))
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    unsafe
    {
        stack System.C.c_int nativeSlotSize = slotSize;
        stack System.C.c_int nativeSlotCount = (i32[min max])slotCount;
        return OperationFromCode(sqlite3_config(SQLITE_CONFIG_LOOKASIDE, nativeSlotSize, nativeSlotCount));
    }
}

public unsafe fn SQLiteStatusResult DisableDefaultLookaside()
{
    unsafe
    {
        stack System.C.c_int zero = 0;
        return OperationFromCode(sqlite3_config(SQLITE_CONFIG_LOOKASIDE, zero, zero));
    }
}

public unsafe fn SQLiteStatusResult ConfigureDefaultPageCacheHeap(
    u32[1 2147483647] slotByteCount,
    i32[min max] slotCount)
{
    unsafe
    {
        stack rawmutptr<System.C.c_void> memory = null;
        stack System.C.c_int nativeSlotByteCount = (i32[min max])slotByteCount;
        stack System.C.c_int nativeSlotCount = slotCount;
        return OperationFromCode(sqlite3_config(
            SQLITE_CONFIG_PAGECACHE,
            memory,
            nativeSlotByteCount,
            nativeSlotCount));
    }
}

