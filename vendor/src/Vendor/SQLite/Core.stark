public unsafe fn SQLiteStatusResult ResultValue(rawmutptr<SQLite3ContextNative> context, rawmutptr<SQLite3ValueNative> value)
{
    if (context == null)
    {
        return SQLiteStatusResult.Err(SQLiteError.NullHandle);
    }

    if (value == null)
    {
        return SQLiteStatusResult.Err(SQLiteError.NullValue);
    }

    unsafe
    {
        sqlite3_result_value(context, value);
        return SQLiteStatusResult.Ok;
    }
}

