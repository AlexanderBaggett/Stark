                    if (table != null)
                    {
                        sqlite3_free_table(table);
                    }

                    return SQLiteTableResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
                }

                if (rowCount < 0 || columnCount < 0)
