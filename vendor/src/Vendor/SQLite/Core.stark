                    }

                    return SQLiteTableResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
                }

                return SQLiteTableResult.Ok(new SQLiteTable()
                {
                    Data = table,
                    Rows = (u32[0 2147483647])rowCount,
                    Columns = (u32[0 2147483647])columnCount
                });
            }
    }
}

internal fn SQLiteStatusResult RequireTableEntry(borrow SQLiteTable table, u32[0 2147483647] row, u32[0 2147483647] column)
{
    if (table.Data == null)
    {
        return SQLiteStatusResult.Err(SQLiteError.NullHandle);
    }

    if (row >= table.Rows || column >= table.Columns)
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    return SQLiteStatusResult.Ok;
}

