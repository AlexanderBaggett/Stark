public unsafe fn SQLiteFilenameResult CreateFilenameWithRawParameters(
    ascii databaseName,
    ascii journalName,
    ascii walName,
    u32[0 2147483647] parameterCount,
    rawptr<System.C.c_void> parameters)
    where overlap(databaseName, parameters),
          overlap(journalName, parameters),
          overlap(walName, parameters)
{
    if (parameterCount != 0 && parameters == null)
    {
        return SQLiteFilenameResult.Err(SQLiteError.NullValue);
    }

    stack System.C.CStringResult<System.C.OwnedCStr> databaseResult = System.C.FromAscii(databaseName);
    switch (databaseResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteFilenameResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cDatabase):
            stack System.C.CStringResult<System.C.OwnedCStr> journalResult = System.C.FromAscii(journalName);
            switch (journalResult)
            {
                case System.C.CStringResult<System.C.OwnedCStr>.Err(var journalError):
                    return SQLiteFilenameResult.Err(FromCStringError(journalError));
                case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cJournal):
                    stack System.C.CStringResult<System.C.OwnedCStr> walResult = System.C.FromAscii(walName);
                    switch (walResult)
                    {
                        case System.C.CStringResult<System.C.OwnedCStr>.Err(var walError):
                            return SQLiteFilenameResult.Err(FromCStringError(walError));
                        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cWal):
                            unsafe
                            {
                                stack System.C.c_int nativeParameterCount = (i32[min max])parameterCount;
                                stack rawptr<System.C.c_char> filename = sqlite3_create_filename(
                                    cDatabase.Data(),
                                    cJournal.Data(),
                                    cWal.Data(),
                                    nativeParameterCount,
                                    parameters);
                                if (filename == null)
                                {
                                    return SQLiteFilenameResult.Err(SQLiteError.SQLite(SQLiteStatus.NoMemory));
                                }

                                return SQLiteFilenameResult.Ok(new SQLiteFilename()
                                {
                                    Handle = filename
                                });
                            }
                    }
            }
    }
}

