    }
}

public unsafe fn SQLiteStatusResult ConfigureDefaultPageCacheMemory(
    storeborrow mut u64[0 max][] memory,
    u32[1 2147483647] slotByteCount,
    u32[1 2147483647] slotCount)
{
    stack u64[0 max] requiredBytes = (u64[0 max])slotByteCount * (u64[0 max])slotCount;
    stack u64[0 max] requiredWords = (requiredBytes + 7) / 8;
    if ((u64[0 max])memory.Length < requiredWords)
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    unsafe
    {
        stack rawmutptr<System.C.c_void> buffer = (rawmutptr<System.C.c_void>)&memory[0];
        stack System.C.c_int nativeSlotByteCount = (i32[min max])slotByteCount;
        stack System.C.c_int nativeSlotCount = (i32[min max])slotCount;
        return OperationFromCode(sqlite3_config(
            SQLITE_CONFIG_PAGECACHE,
            buffer,
            nativeSlotByteCount,
            nativeSlotCount));
    }
}

public unsafe fn SQLiteStatusResult ConfigureHeapMemory(
    storeborrow mut u64[0 max][] memory,
    u16[1 4096] minimumAllocation)
{
    if (memory.Length == 0 || memory.Length > 268435455)
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    unsafe
    {
        stack u32[1 2147483647] byteCount = (u32[1 2147483647])((u64[0 max])memory.Length * 8);
        stack rawmutptr<System.C.c_void> buffer = (rawmutptr<System.C.c_void>)&memory[0];
        stack System.C.c_int nativeByteCount = (i32[min max])byteCount;
        stack System.C.c_int nativeMinimumAllocation = minimumAllocation;
        return OperationFromCode(sqlite3_config(
            SQLITE_CONFIG_HEAP,
            buffer,
            nativeByteCount,
            nativeMinimumAllocation));
    }
}

