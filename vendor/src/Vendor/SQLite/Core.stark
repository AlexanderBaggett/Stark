public unsafe fn SQLiteValueResult VirtualTableRightHandSideValue(
    rawmutptr<SQLite3IndexInfoNative> indexInfo,
    u32[0 2147483647] constraintIndex)
{
    if (indexInfo == null)
    {
        return SQLiteValueResult.Err(SQLiteError.NullValue);
