public fn SQLiteStatusResult ConfigureLookaside(
    mut borrow Database database,
    u16[8 65528] slotSize,
    u32[1 2147483647] slotCount)
{
    stack SQLiteStatusResult handleResult = RequireDatabaseHandle(database);
    if (handleResult != SQLiteStatusResult.Ok)
    {
        return handleResult;
    }

    if (!IsValidLookasideSlotSize(slotSize) || !LookasideByteProductFits(slotSize, slotCount))
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    unsafe
    {
        stack System.C.c_int nativeOption = SQLITE_DBCONFIG_LOOKASIDE;
        stack rawmutptr<System.C.c_void> buffer = null;
        stack System.C.c_int nativeSlotSize = slotSize;
        stack System.C.c_int nativeSlotCount = (i32[min max])slotCount;
        stack System.C.c_int status = sqlite3_db_config(database.Handle, nativeOption, buffer, nativeSlotSize, nativeSlotCount);
        if (status != SQLITE_OK)
        {
            return SQLiteStatusResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
        }

        database.LookasideWords = new();
        database.LookasideSlotSize = slotSize;
        database.LookasideSlotCount = slotCount;
        return SQLiteStatusResult.Ok;
    }
}

public fn SQLiteStatusResult ConfigureOwnedLookaside(
    mut borrow Database database,
    u16[8 65528] slotSize,
    u32[1 2147483647] slotCount)
{
    stack SQLiteStatusResult handleResult = RequireDatabaseHandle(database);
    if (handleResult != SQLiteStatusResult.Ok)
    {
        return handleResult;
    }

    if (!IsValidLookasideSlotSize(slotSize) || !LookasideByteProductFits(slotSize, slotCount))
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    stack u64[0 2 ** 63 - 1] wordCount = LookasideWordCount(slotSize, slotCount);
    stack mut dynamic u64[0 max] words = new();
    if (!words.TryReserve(wordCount))
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.NoMemory));
    }

    while willexit (words.Length < wordCount)
    {
        init words[words.Length] = 0;
    }

    unsafe
    {
        stack System.C.c_int nativeOption = SQLITE_DBCONFIG_LOOKASIDE;
        stack rawmutptr<System.C.c_void> buffer = (rawmutptr<System.C.c_void>)&words[0];
        stack System.C.c_int nativeSlotSize = slotSize;
        stack System.C.c_int nativeSlotCount = (i32[min max])slotCount;
        stack System.C.c_int status = sqlite3_db_config(database.Handle, nativeOption, buffer, nativeSlotSize, nativeSlotCount);
        if (status != SQLITE_OK)
        {
            return SQLiteStatusResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
        }

        database.LookasideWords = words;
        database.LookasideSlotSize = slotSize;
        database.LookasideSlotCount = slotCount;
        return SQLiteStatusResult.Ok;
    }
}

