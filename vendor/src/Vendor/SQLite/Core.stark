        }

        stack System.C.c_int nativeIndex = (i32[min max])index;
        stack System.C.c_int nativeCount = (i32[min max])values.Length;
        if (requireV2)
        {
            return OperationFromCode(stark_sqlite_carray_bind_text_v2_transient(
                statement.Handle,
                nativeIndex,
                data,
                nativeCount));
