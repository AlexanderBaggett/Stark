                                stack mut rawmutptr<SQLite3BlobNative> blob = null;
                                stack System.C.c_int status = sqlite3_blob_open(
                                    database.Handle,
                                    cSchema.Data(),
                                    cTable.Data(),
                                    cColumn.Data(),
                                    rowId,
