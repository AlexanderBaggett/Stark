        stack System.C.c_int resetFlag = BoolToCInt(reset);
        stack System.C.c_int status = sqlite3_status(nativeOperation, &current, &highWater, resetFlag);
        if (status != SQLITE_OK)
        {
            return SQLiteStatusSnapshotResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
        }
    }

    return SQLiteStatusSnapshotResult.Ok(new SQLiteStatusSnapshot()
    {
        Current = (i64[min max])current,
        HighWater = (i64[min max])highWater
    });
}

