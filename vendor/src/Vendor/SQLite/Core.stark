public fn SQLiteTextResult KeywordName(u32[0 2147483647] index, u16[1 4096] maxLength)
{
    if (index >= (u32[0 2147483647])KeywordCount())
    {
        return SQLiteTextResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    unsafe
    {
        stack mut rawptr<System.C.c_char> name = null;
        stack mut System.C.c_int length = 0;
        stack System.C.c_int nativeIndex = (i32[min max])index;
        stack System.C.c_int status = sqlite3_keyword_name(nativeIndex, &name, &length);
        if (status != SQLITE_OK)
        {
            return SQLiteTextResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
        }

        if (length < 0)
        {
            return SQLiteTextResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
        }

        stack u64[0 2 ** 63 - 1] byteLength = (u64[0 2 ** 63 - 1])length;
        if (byteLength > (u64[0 2 ** 63 - 1])maxLength)
        {
            return SQLiteTextResult.Err(SQLiteError.TooLarge);
        }

        return CopyCTextWithLength(name, byteLength);
    }
}

public fn SQLiteBoolResult IsKeyword(ascii name)
