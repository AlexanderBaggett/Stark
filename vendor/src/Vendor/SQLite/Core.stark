        return SQLiteValueResult.Ok(value);
    }
}

internal unsafe finite law SQLiteValueStepResult VirtualTableInStepFromCode(i32[min max] code, rawmutptr<SQLite3ValueNative> value)
{
    if (code == SQLITE_OK)
    {
        if (value == null)
        {
            return SQLiteValueStepResult.Done;
        }

        return SQLiteValueStepResult.Row(value);
    }

    if (code == SQLITE_DONE)
    {
        return SQLiteValueStepResult.Done;
    }

    return SQLiteValueStepResult.Err(SQLiteError.SQLite(StatusFromCode(code)));
}

