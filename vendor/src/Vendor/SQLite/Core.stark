        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cMessage):
            if (cMessage.Length() > (u64[0 2 ** 63 - 1])(2 ** 31 - 1))
            {
                return SQLiteStatusResult.Err(SQLiteError.TooLarge);
            }

            unsafe
            {
                stack System.C.c_int byteCount = (i32[min max])cMessage.Length();
                sqlite3_result_error(context, cMessage.Data(), byteCount);
                return SQLiteStatusResult.Ok;
            }
    }
}

public unsafe fn SQLiteStatusResult ResultError16Ascii(rawmutptr<SQLite3ContextNative> context, ascii message)
{
    if (context == null)
    {
        return SQLiteStatusResult.Err(SQLiteError.NullHandle);
    }

    stack SQLiteUtf16Result textResult = Utf16FromAsciiWithTerminator(message);
    switch (textResult)
    {
        case SQLiteUtf16Result.Err(var error):
            return SQLiteStatusResult.Err(error);
        case SQLiteUtf16Result.Ok(var text):
            if (text.Length() <= 1)
            {
                unsafe
                {
                    sqlite3_result_error16(context, Utf16Data(text), 0);
                    return SQLiteStatusResult.Ok;
                }
            }

            if (text.Length() - 1 > (u64[0 2 ** 63 - 1])(2 ** 30 - 1))
            {
                return SQLiteStatusResult.Err(SQLiteError.TooLarge);
            }

            unsafe
            {
                stack System.C.c_int byteCount = (i32[min max])((text.Length() - 1) * 2);
                sqlite3_result_error16(context, Utf16Data(text), byteCount);
                return SQLiteStatusResult.Ok;
            }
    }
}

