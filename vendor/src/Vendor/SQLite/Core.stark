public fn SQLiteBytesResult SerializeDatabaseWithFlags(borrow Database database, ascii schemaName, i32[min max] flags)
{
    if (database.Handle == null)
    {
        return SQLiteBytesResult.Err(SQLiteError.NullHandle);
    }

    if (flags < 0 || flags > SQLITE_SERIALIZE_NOCOPY)
    {
        return SQLiteBytesResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    if ((flags & SQLITE_SERIALIZE_NOCOPY) != 0)
    {
        return SQLiteBytesResult.Err(SQLiteError.SQLite(SQLiteStatus.Misuse));
    }

    stack System.C.CStringResult<System.C.OwnedCStr> schemaResult = System.C.FromAscii(schemaName);
    switch (schemaResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteBytesResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cSchema):
            unsafe
            {
                stack mut i64[min max] byteCount = 0;
                stack System.C.c_uint nativeFlags = (u32[0 max])flags;
                stack rawmutptr<u8[0 max]> data = sqlite3_serialize(database.Handle, cSchema.Data(), &byteCount, nativeFlags);
                if (byteCount < 0)
                {
                    if (data != null)
                    {
                        sqlite3_free((rawmutptr<System.C.c_void>)data);
                    }

                    return SQLiteBytesResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
                }

                if (data == null)
                {
                    if (byteCount == 0)
                    {
                        return SQLiteBytesResult.Ok(new SQLiteOwnedBytes()
                        {
                            Data = null,
                            ByteLength = 0
                        });
                    }

                    return SQLiteBytesResult.Err(SQLiteError.SQLite(SQLiteStatus.NoMemory));
                }

                return SQLiteBytesResult.Ok(new SQLiteOwnedBytes()
                {
                    Data = data,
                    ByteLength = (u64[0 max])byteCount
                });
            }
    }
}

