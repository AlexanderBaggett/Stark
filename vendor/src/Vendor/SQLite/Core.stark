        sqlite3_free((rawmutptr<System.C.c_void>)text);
        return result;
    }
}

public fn SQLiteTextResult FormatSqlTextLiteral(ascii value, u16[1 4096] maxLength)
{
    stack System.C.CStringResult<System.C.OwnedCStr> formatResult = System.C.FromAscii("%Q");
    switch (formatResult)
