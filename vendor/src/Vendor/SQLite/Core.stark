        {
            case SQLiteStatusResult.Err(var error):
                return SQLiteTextResult.Err(error);
            case SQLiteStatusResult.Ok:
                return SQLiteTextResult.Err(SQLiteError.NullHandle);
        }
    }

    unsafe
    {
        stack System.C.c_int byteLength = sqlite3_str_length(builder.Handle);
        if (byteLength < 0)
        {
            builder.Close();
            return SQLiteTextResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
        }

        stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])byteLength;
        if (length > (u64[0 2 ** 63 - 1])maxLength)
        {
            return SQLiteTextResult.Err(SQLiteError.TooLarge);
        }

        stack rawmutptr<System.C.c_char> value = sqlite3_str_finish(builder.Handle);
        builder.Handle = null;

        if (length == 0)
        {
            if (value != null)
            {
                sqlite3_free((rawmutptr<System.C.c_void>)value);
            }

            stack mut System.Text.OwnedAscii empty = new();
            return SQLiteTextResult.Ok(empty);
        }

        if (value == null)
        {
            return SQLiteTextResult.Err(SQLiteError.NullValue);
        }

        stack SQLiteTextResult result = CopyCTextWithLength((rawptr<System.C.c_char>)value, length);
        sqlite3_free((rawmutptr<System.C.c_void>)value);
        return result;
    }
}

