public fn SQLiteStatusResult SetErrorMessage(mut borrow Database database, SQLiteStatus status, ascii message)
{
    stack SQLiteStatusResult handleResult = RequireDatabaseHandle(database);
    if (handleResult != SQLiteStatusResult.Ok)
    {
