public fn SQLiteStatusResult Close(mut borrow Database database)
{
    if (database.Handle == null)
    {
        return SQLiteStatusResult.Ok;
    }

    unsafe
    {
        stack System.C.c_int status = sqlite3_close_v2(database.Handle);
        if (status == SQLITE_OK)
        {
            database.Handle = null;
            return SQLiteStatusResult.Ok;
        }

        return SQLiteStatusResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
    }
}

