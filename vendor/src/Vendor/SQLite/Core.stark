public fn SQLiteColumnMetadataResult TableColumnMetadata(
    borrow Database database,
    ascii schemaName,
    ascii tableName,
    ascii columnName,
    u16[1 4096] maxTextLength)
{
    if (database.Handle == null)
    {
        return SQLiteColumnMetadataResult.Err(SQLiteError.NullHandle);
    }

    stack System.C.CStringResult<System.C.OwnedCStr> schemaResult = System.C.FromAscii(schemaName);
    switch (schemaResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteColumnMetadataResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cSchema):
            stack System.C.CStringResult<System.C.OwnedCStr> tableResult = System.C.FromAscii(tableName);
            switch (tableResult)
            {
                case System.C.CStringResult<System.C.OwnedCStr>.Err(var tableError):
                    return SQLiteColumnMetadataResult.Err(FromCStringError(tableError));
                case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cTable):
                    stack System.C.CStringResult<System.C.OwnedCStr> columnResult = System.C.FromAscii(columnName);
                    switch (columnResult)
                    {
                        case System.C.CStringResult<System.C.OwnedCStr>.Err(var columnError):
                            return SQLiteColumnMetadataResult.Err(FromCStringError(columnError));
                        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cColumn):
                            unsafe
                            {
                                stack mut rawptr<System.C.c_char> dataType = null;
                                stack mut rawptr<System.C.c_char> collation = null;
                                stack mut System.C.c_int notNull = 0;
                                stack mut System.C.c_int primaryKey = 0;
                                stack mut System.C.c_int autoIncrement = 0;
                                stack System.C.c_int status = sqlite3_table_column_metadata(
                                    database.Handle,
                                    cSchema.Data(),
                                    cTable.Data(),
                                    cColumn.Data(),
                                    &dataType,
                                    &collation,
                                    &notNull,
                                    &primaryKey,
                                    &autoIncrement);
                                if (status != SQLITE_OK)
                                {
                                    return SQLiteColumnMetadataResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
                                }

                                stack SQLiteTextResult dataTypeResult = CopyCText(dataType, (u64[0 2 ** 63 - 1])maxTextLength);
                                switch (dataTypeResult)
                                {
                                    case SQLiteTextResult.Err(var textError):
                                        return SQLiteColumnMetadataResult.Err(textError);
                                    case SQLiteTextResult.Ok(var dataTypeText):
                                        stack SQLiteTextResult collationResult = CopyCText(collation, (u64[0 2 ** 63 - 1])maxTextLength);
                                        switch (collationResult)
                                        {
                                            case SQLiteTextResult.Err(var collationError):
                                                return SQLiteColumnMetadataResult.Err(collationError);
                                            case SQLiteTextResult.Ok(var collationText):
                                                return SQLiteColumnMetadataResult.Ok(new SQLiteColumnMetadata()
                                                {
                                                    DataType = dataTypeText,
                                                    Collation = collationText,
                                                    NotNull = notNull != 0,
                                                    PrimaryKey = primaryKey != 0,
                                                    AutoIncrement = autoIncrement != 0
                                                });
                                        }
                                }
                            }
                    }
            }
    }
}

