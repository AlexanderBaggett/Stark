public fn SQLiteStatusSnapshotResult GlobalStatus(i32[min max] operation, bool reset)
{
    stack mut i64[min max] current = 0;
    stack mut i64[min max] highWater = 0;
    unsafe
    {
        stack System.C.c_int nativeOperation = operation;
        stack System.C.c_int resetFlag = BoolToCInt(reset);
        stack System.C.c_int status = sqlite3_status64(nativeOperation, &current, &highWater, resetFlag);
        if (status != SQLITE_OK)
        {
            return SQLiteStatusSnapshotResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
        }
    }

    return SQLiteStatusSnapshotResult.Ok(new SQLiteStatusSnapshot()
    {
        Current = current,
        HighWater = highWater
    });
}

