public fn SQLiteDatabaseResult Open(ascii path, i32[min max] flags)
{
    stack System.C.CStringResult<System.C.OwnedCStr> pathResult = System.C.FromAscii(path);
    switch (pathResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteDatabaseResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cPath):
            unsafe
            {
                stack mut rawmutptr<SQLite3Native> handle = null;
                stack System.C.c_int nativeFlags = flags;
                stack System.C.c_int status = sqlite3_open_v2(cPath.Data(), &handle, nativeFlags, null);
                if (status != SQLITE_OK)
                {
                    if (handle != null)
                    {
                        sqlite3_close_v2(handle);
                    }

                    return SQLiteDatabaseResult.Err(SQLiteError.SQLite(StatusFromCode((i32[min max])status)));
                }

                if (handle == null)
                {
                    return SQLiteDatabaseResult.Err(SQLiteError.NullHandle);
                }

                return SQLiteDatabaseResult.Ok(new Database()
                {
                    Handle = handle
                });
            }
    }
}

