public fn SQLiteStatusResult Randomness(borrow mut u8[0 max][] destination)
{
    if (destination.Length == 0)
    {
        return SQLiteStatusResult.Ok;
    }

    if (destination.Length > (u64[0 max])(2 ** 31 - 1))
    {
        return SQLiteStatusResult.Err(SQLiteError.TooLarge);
    }

    unsafe
    {
        stack System.C.c_int byteCount = (i32[min max])destination.Length;
        sqlite3_randomness(byteCount, (rawmutptr<System.C.c_void>)(&destination[0]));
    }

    return SQLiteStatusResult.Ok;
}

