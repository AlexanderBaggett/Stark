public fn SQLiteStatusResult SetLockTimeout(mut borrow Database database, u32[0 2147483647] milliseconds, i32[min max] flags)
{
    stack SQLiteStatusResult handleResult = RequireDatabaseHandle(database);
    if (handleResult != SQLiteStatusResult.Ok)
    {
        return handleResult;
    }

    if (flags != 0 && flags != SQLITE_SETLK_BLOCK_ON_CONNECT)
    {
        return SQLiteStatusResult.Err(SQLiteError.SQLite(SQLiteStatus.Range));
    }

    unsafe
    {
        stack System.C.c_int nativeMilliseconds = (i32[min max])milliseconds;
        stack System.C.c_int nativeFlags = flags;
        return OperationFromCode(sqlite3_setlk_timeout(database.Handle, nativeMilliseconds, nativeFlags));
    }
}

