            case SQLiteStatusResult.Ok:
                return SQLiteTableResult.Err(SQLiteError.NullHandle);
        }
    }

    stack System.C.CStringResult<System.C.OwnedCStr> sqlResult = System.C.FromAscii(sql);
    switch (sqlResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SQLiteTableResult.Err(FromCStringError(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cSql):
            unsafe
            {
                stack mut rawmutptr<System.C.c_void> table = null;
                stack mut System.C.c_int rowCount = 0;
                stack mut System.C.c_int columnCount = 0;
                stack mut rawmutptr<System.C.c_char> errorMessage = null;
                stack System.C.c_int status = sqlite3_get_table(
                    database.Handle,
                    cSql.Data(),
                    &table,
                    &rowCount,
                    &columnCount,
                    &errorMessage);
                if (errorMessage != null)
                {
                    sqlite3_free((rawmutptr<System.C.c_void>)errorMessage);
                }

                if (status != SQLITE_OK)
