internal finite law bool IsDynamicMutexKind(i32[min max] kind)
{
    return kind == SQLITE_MUTEX_FAST || kind == SQLITE_MUTEX_RECURSIVE;
}

internal unsafe fn SQLiteStatusResult EnterMutexRaw(rawmutptr<SQLite3MutexNative> mutex)
{
    if (mutex == null)
    {
