[StructLayout(C)]
public struct SQLite3VfsNative
{
    System.C.c_int Version;
    System.C.c_int OsFileSize;
    System.C.c_int MaxPathname;
    rawmutptr<SQLite3VfsNative> Next;
    rawptr<System.C.c_char> Name;
    rawmutptr<System.C.c_void> ApplicationData;
    SQLiteVfsOpenCallback Open;
    SQLiteVfsDeleteCallback Delete;
    SQLiteVfsAccessCallback Access;
    SQLiteVfsFullPathnameCallback FullPathname;
    SQLiteVfsDynamicLibraryOpenCallback DynamicLibraryOpen;
    SQLiteVfsDynamicLibraryErrorCallback DynamicLibraryError;
    SQLiteVfsDynamicLibrarySymbolCallback DynamicLibrarySymbol;
    SQLiteVfsDynamicLibraryCloseCallback DynamicLibraryClose;
    SQLiteVfsRandomnessCallback Randomness;
    SQLiteVfsSleepCallback Sleep;
    SQLiteVfsCurrentTimeCallback CurrentTime;
    SQLiteVfsGetLastErrorCallback LastError;
    SQLiteVfsCurrentTimeInt64Callback CurrentTimeInt64;
    SQLiteVfsSetSystemCallCallback SetSystemCall;
    SQLiteVfsGetSystemCallCallback GetSystemCall;
    SQLiteVfsNextSystemCallCallback NextSystemCall;
}

