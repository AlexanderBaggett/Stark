{
    i8[min max] Opaque;
}

public struct SQLite3ContextNative
{
    internal i8[min max] Opaque;
}

public struct SQLite3ValueNative
{
    internal i8[min max] Opaque;
}

public alias SQLiteFunctionContext = rawmutptr<i8[min max]>;
public alias SQLiteFunctionArguments = rawmutptr<i8[min max]>;
public alias SQLiteScalarCallback = fnptr<unsafe ffi(c) fn void(
    SQLiteFunctionContext,
    i32[min max],
    SQLiteFunctionArguments)>;

internal unsafe ffi(c) fn System.C.c_int sqlite3_close_v2(rawmutptr<SQLite3Native> database);
internal unsafe ffi(c) fn System.C.c_int sqlite3_finalize(rawmutptr<SQLite3StatementNative> statement);
internal unsafe ffi(c) fn System.C.c_int sqlite3_blob_close(rawmutptr<SQLite3BlobNative> blob);
internal unsafe ffi(c) fn System.C.c_int sqlite3_backup_finish(rawmutptr<SQLite3BackupNative> backup);
internal unsafe ffi(c) fn void sqlite3_free(rawmutptr<System.C.c_void> memory);
internal unsafe ffi(c) fn void sqlite3_value_free(rawmutptr<SQLite3ValueNative> value);

public struct Database
{
    internal rawmutptr<SQLite3Native> Handle;

    Database()
    {
        self.Handle = null;
    }

    mut drop
    {
        unsafe
        {
            if (self.Handle != null)
            {
                sqlite3_close_v2(self.Handle);
                self.Handle = null;
            }
        }
    }
}

public struct Statement
{
    internal rawmutptr<SQLite3StatementNative> Handle;

    Statement()
    {
        self.Handle = null;
    }

    mut drop
    {
        unsafe
        {
            if (self.Handle != null)
            {
                sqlite3_finalize(self.Handle);
                self.Handle = null;
            }
        }
    }
}

public struct Blob
{
    internal rawmutptr<SQLite3BlobNative> Handle;

    Blob()
    {
        self.Handle = null;
    }

    mut drop
    {
        unsafe
        {
            if (self.Handle != null)
            {
                sqlite3_blob_close(self.Handle);
                self.Handle = null;
            }
        }
    }
}

public struct Backup
{
    internal rawmutptr<SQLite3BackupNative> Handle;

    Backup()
    {
        self.Handle = null;
    }

    mut drop
    {
        unsafe
        {
            if (self.Handle != null)
            {
                sqlite3_backup_finish(self.Handle);
                self.Handle = null;
            }
        }
    }
}

public struct SQLiteOwnedBytes
{
    internal rawmutptr<u8[0 max]> Data;
    internal u64[0 max] ByteLength;

    SQLiteOwnedBytes()
    {
        self.Data = null;
        self.ByteLength = 0;
    }

    public inline finite law u64[0 max] Length(borrow SQLiteOwnedBytes self)
    {
        return self.ByteLength;
    }

    public inline finite law bool IsEmpty(borrow SQLiteOwnedBytes self)
    {
        return self.ByteLength == 0;
    }

    public fn SQLiteStatusResult CopyTo(borrow SQLiteOwnedBytes self, borrow mut u8[0 max][] destination)
    {
        if (destination.Length < self.ByteLength)
        {
            return SQLiteStatusResult.Err(SQLiteError.TooLarge);
        }

        if (self.ByteLength == 0)
        {
            return SQLiteStatusResult.Ok;
        }

        if (self.Data == null)
        {
            return SQLiteStatusResult.Err(SQLiteError.NullValue);
        }

        unsafe
        {
            stack mut u64[0 max] index = 0;
            while willexit (index < self.ByteLength)
            {
                destination[index] = *(&self.Data[index]);
                index += 1;
            }
        }

        return SQLiteStatusResult.Ok;
    }

    public fn void Close(mut borrow SQLiteOwnedBytes self)
    {
        unsafe
        {
            if (self.Data != null)
            {
                sqlite3_free((rawmutptr<System.C.c_void>)self.Data);
                self.Data = null;
                self.ByteLength = 0;
            }
        }

        return;
    }

    mut drop
    {
        self.Close();
    }
}

public struct SQLiteOwnedValue
{
    internal rawmutptr<SQLite3ValueNative> Handle;

    SQLiteOwnedValue()
    {
        self.Handle = null;
    }

    public inline finite law bool IsOpen(borrow SQLiteOwnedValue self)
    {
        return self.Handle != null;
    }

    public fn void Close(mut borrow SQLiteOwnedValue self)
    {
        unsafe
        {
            if (self.Handle != null)
            {
                sqlite3_value_free(self.Handle);
                self.Handle = null;
            }
        }

        return;
    }

    mut drop
    {
        self.Close();
    }
}

