public fn StbImageStatus ResizeLinearInto(
    borrow Image source,
    borrow mut u8[0 max][] destination,
    u32[1 max] outputWidth,
    u32[1 max] outputHeight)
{
    switch (ValidateImageForWrite(source))
    {
        case StbImageStatus.Err(var error):
            return StbImageStatus.Err(error);
        case StbImageStatus.Ok:
            break;
    }

    stack u64[0 2 ** 63 - 1] requiredLength = PixelByteLengthOrZero(
        outputWidth,
        outputHeight,
        source.ChannelCount);
    if (requiredLength == 0)
    {
        return StbImageStatus.Err(StbImageError.InvalidDimensions);
    }

    if (destination.Length < requiredLength)
    {
        return StbImageStatus.Err(StbImageError.DestinationTooSmall);
    }

    unsafe
    {
        stack rawmutptr<u8[0 max]> resized = stbir_resize_uint8_linear_alias(
            &source.PixelBytes[0],
            (i32[min max])source.WidthValue,
            (i32[min max])source.HeightValue,
            0,
            &destination[0],
            (i32[min max])outputWidth,
            (i32[min max])outputHeight,
            0,
            source.ChannelCount);
        if (resized == null)
        {
            return StbImageStatus.Err(StbImageError.ResizeFailed);
        }

        return StbImageStatus.Ok;
    }
}

public fn ImageResult ResizeLinear(
    borrow Image source,
    u32[1 max] outputWidth,
    u32[1 max] outputHeight)
{
    switch (ValidateImageForWrite(source))
    {
        case StbImageStatus.Err(var error):
            return ImageResult.Err(error);
        case StbImageStatus.Ok:
            break;
    }

    stack u64[0 2 ** 63 - 1] requiredLength = PixelByteLengthOrZero(
        outputWidth,
        outputHeight,
        source.ChannelCount);
    if (requiredLength == 0)
    {
        return ImageResult.Err(StbImageError.InvalidDimensions);
    }

    stack mut Image destinationImage = new();
    destinationImage.WidthValue = outputWidth;
    destinationImage.HeightValue = outputHeight;
    destinationImage.ChannelCount = source.ChannelCount;
    if (!destinationImage.PixelBytes.TryReserve(requiredLength))
    {
        return ImageResult.Err(FromMemoryError(System.Memory.MemoryError.OutOfMemory));
    }

    stack init u8[0 max][] initialized = init destinationImage.PixelBytes[destinationImage.PixelBytes.Length, requiredLength];
    System.Memory.FillUnsignedBytes(initialized, 0, requiredLength);

    stack mut u8[0 max][] destination = destinationImage.PixelBytes[0, destinationImage.PixelBytes.Length];
    switch (ResizeLinearInto(source, destination, outputWidth, outputHeight))
    {
        case StbImageStatus.Err(var error):
            return ImageResult.Err(error);
        case StbImageStatus.Ok:
            return ImageResult.Ok(destinationImage);
    }
}
