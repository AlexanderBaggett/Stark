import System.C
import System.Memory
module Vendor.STB.Image

public const StbImageMaxNativeInputLength = 2147483647;

public enum ImageChannels
{
    Original,
    Gray,
    GrayAlpha,
    Rgb,
    Rgba,
}

public enum StbImageError
{
    Memory(System.Memory.MemoryError),
    SourceTooLarge,
    InvalidArgument,
    InvalidDimensions,
    UnsupportedChannels,
    DestinationTooSmall,
    DecodeFailed,
    EncodeFailed,
    ResizeFailed,
}

public enum StbImageStatus
{
    [Ok] Ok,
    [Err] Err(StbImageError),
}

public struct Image
{
    u32[0 max] WidthValue;
    u32[0 max] HeightValue;
    u8[0 4] ChannelCount;
    dynamic u8[0 max] PixelBytes;

    Image()
    {
        self.WidthValue = 0;
        self.HeightValue = 0;
        self.ChannelCount = 0;
        self.PixelBytes = new();
    }

    public inline finite law u32[0 max] Width(borrow Image self)
    {
        return self.WidthValue;
    }

    public inline finite law u32[0 max] Height(borrow Image self)
    {
        return self.HeightValue;
    }

    public inline finite law u8[0 4] Channels(borrow Image self)
    {
        return self.ChannelCount;
    }

    public inline finite law u64[0 2 ** 63 - 1] PixelByteLength(borrow Image self)
    {
        return self.PixelBytes.Length;
    }

    public inline finite law bool IsEmpty(borrow Image self)
    {
        return self.PixelBytes.Length == 0;
    }

    public finite law retborrow u8[0 max][] Pixels(borrow Image self)
    {
        return self.PixelBytes[0, self.PixelBytes.Length];
    }

    public finite retborrow mut u8[0 max][] MutablePixels(mut borrow Image self)
    {
        return self.PixelBytes[0, self.PixelBytes.Length];
    }
}

public enum ImageResult
{
    [Ok] Ok(Image),
    [Err] Err(StbImageError),
}

