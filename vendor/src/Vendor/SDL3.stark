internal finite law bool NativeBool(System.C.c_int value)
{
    return value != SDL_FALSE;
}

internal finite law SdlStatus StatusFromNative(System.C.c_int value, SdlError error)
{
    if (NativeBool(value))
    {
        return SdlStatus.Ok;
    }

    return SdlStatus.Err(error);
}

internal finite law SdlEventKind EventKindFromNative(u32[0 max] eventType)
{
    switch (eventType)
    {
        case 256:
            return SdlEventKind.Quit;
        case 514:
        case 515:
        case 516:
        case 517:
        case 518:
        case 519:
        case 520:
        case 521:
        case 522:
        case 523:
        case 524:
        case 525:
        case 526:
        case 527:
        case 528:
        case 529:
        case 530:
        case 531:
        case 532:
        case 533:
        case 534:
        case 535:
        case 536:
        case 537:
            return SdlEventKind.Window;
        case 768:
            return SdlEventKind.KeyDown;
        case 769:
            return SdlEventKind.KeyUp;
        case 1024:
            return SdlEventKind.MouseMotion;
        case 1025:
            return SdlEventKind.MouseButtonDown;
        case 1026:
            return SdlEventKind.MouseButtonUp;
        case 1027:
            return SdlEventKind.MouseWheel;
        case 4352:
        case 4353:
        case 4354:
            return SdlEventKind.AudioDevice;
        default:
            return SdlEventKind.Unknown(eventType);
    }
}

internal finite law SdlEvent EventFromNative(NativeEvent event)
{
    return new SdlEvent()
    {
        Type = event.Type,
        Kind = EventKindFromNative(event.Type),
        Timestamp = event.Timestamp,
        WindowId = event.WindowId,
        Which = event.Which,
        A = event.A,
        B = event.B,
        C = event.C,
        D = event.D,
        X = event.X,
        Y = event.Y,
        XRelative = event.XRelative,
        YRelative = event.YRelative
    };
}

internal finite law Version VersionFromPacked(i32[min max] packed)
{
    return new Version()
    {
        Major = packed / 1000000,
        Minor = (packed / 1000) % 1000,
        Patch = packed % 1000
    };
}

public fn Version GetVersion()
{
    unsafe
    {
        return VersionFromPacked((i32[min max])stark_sdl3_get_version());
    }
}

public fn u32[0 max] WasInitialized(u32[0 max] flags)
{
    unsafe
    {
        return stark_sdl3_was_init(flags);
    }
}

public fn LibraryResult Initialize(u32[0 max] flags)
{
    unsafe
    {
        if (!NativeBool(stark_sdl3_init(flags)))
        {
            return LibraryResult.Err(SdlError.InitFailed);
        }

        stack mut Library library = new();
        library.IsInitialized = true;
        return LibraryResult.Ok(library);
    }
}

public fn SdlStatus SetAppMetadata(ascii appName, ascii appVersion, ascii appIdentifier)
{
    stack System.C.CStringResult<System.C.OwnedCStr> appNameResult = System.C.FromAscii(appName);
    switch (appNameResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return SdlStatus.Err(SdlError.CString(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cAppName):
            stack System.C.CStringResult<System.C.OwnedCStr> appVersionResult = System.C.FromAscii(appVersion);
            switch (appVersionResult)
            {
                case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
                    return SdlStatus.Err(SdlError.CString(error));
                case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cAppVersion):
                    stack System.C.CStringResult<System.C.OwnedCStr> appIdentifierResult = System.C.FromAscii(appIdentifier);
                    switch (appIdentifierResult)
                    {
                        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
                            return SdlStatus.Err(SdlError.CString(error));
                        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cAppIdentifier):
                            unsafe
                            {
                                return StatusFromNative(
                                    stark_sdl3_set_app_metadata(
                                        cAppName.Data(),
                                        cAppVersion.Data(),
                                        cAppIdentifier.Data()),
                                    SdlError.MetadataFailed);
                            }
                    }
            }
    }
}

public fn WindowResult CreateWindow(
    u16[1 32767] width,
    u16[1 32767] height,
    u64[0 max] flags,
    ascii title)
{
    stack System.C.CStringResult<System.C.OwnedCStr> titleResult = System.C.FromAscii(title);
    switch (titleResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return WindowResult.Err(SdlError.CString(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cTitle):
            unsafe
            {
                stack System.C.c_int nativeWidth = width;
                stack System.C.c_int nativeHeight = height;
                stack rawmutptr<SDLWindowNative> handle = stark_sdl3_create_window(
                    cTitle.Data(),
                    nativeWidth,
                    nativeHeight,
                    flags);
                if (handle == null)
                {
                    return WindowResult.Err(SdlError.WindowCreationFailed);
                }

                stack mut Window window = new();
                window.Handle = handle;
                return WindowResult.Ok(window);
            }
    }
}

public fn WindowResult CreateHiddenWindow(u16[1 32767] width, u16[1 32767] height, ascii title)
{
    return CreateWindow(width, height, WindowHidden, title);
}

public fn SdlStatus SetWindowSize(mut borrow Window window, u16[1 32767] width, u16[1 32767] height)
{
    if (window.IsEmpty())
    {
        return SdlStatus.Err(SdlError.InvalidArgument);
    }

    unsafe
    {
        stack System.C.c_int nativeWidth = width;
        stack System.C.c_int nativeHeight = height;
        return StatusFromNative(
            stark_sdl3_set_window_size(window.Handle, nativeWidth, nativeHeight),
            SdlError.NativeFailure);
    }
}

public fn Size GetWindowSize(borrow Window window)
{
    unsafe
    {
        stack mut System.C.c_int width = 0;
        stack mut System.C.c_int height = 0;
        if (window.Handle != null)
        {
            stark_sdl3_get_window_size(window.Handle, &width, &height);
        }

        return new Size()
        {
            Width = (i32[min max])width,
            Height = (i32[min max])height
        };
    }
}

