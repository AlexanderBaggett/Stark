public inline finite law AudioSpec MakeAudioSpec(u32[0 max] format, u8[1 64] channels, u24[1 768000] frequency)
{
    return new AudioSpec()
    {
        Format = format,
        Channels = (i32[min max])channels,
        Frequency = (i32[min max])frequency
    };
