public fn RendererResult CreateDefaultRenderer(mut borrow Window window)
{
    if (window.IsEmpty())
    {
        return RendererResult.Err(SdlError.InvalidArgument);
    }

    unsafe
    {
        stack rawmutptr<SDLRendererNative> handle = stark_sdl3_create_renderer(window.Handle, null);
        if (handle == null)
        {
            return RendererResult.Err(SdlError.RendererCreationFailed);
        }

        stack mut Renderer renderer = new();
        renderer.Handle = handle;
        return RendererResult.Ok(renderer);
    }
}

public fn RendererResult CreateNamedRenderer(mut borrow Window window, ascii name)
{
    if (window.IsEmpty())
    {
        return RendererResult.Err(SdlError.InvalidArgument);
    }

    stack System.C.CStringResult<System.C.OwnedCStr> nameResult = System.C.FromAscii(name);
    switch (nameResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return RendererResult.Err(SdlError.CString(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cName):
            unsafe
            {
                stack rawmutptr<SDLRendererNative> handle = stark_sdl3_create_renderer(window.Handle, cName.Data());
                if (handle == null)
                {
                    return RendererResult.Err(SdlError.RendererCreationFailed);
                }

                stack mut Renderer renderer = new();
                renderer.Handle = handle;
                return RendererResult.Ok(renderer);
            }
    }
}

