public fn void PumpEvents()
{
    unsafe
    {
        stark_sdl3_pump_events();
    }
}

public fn EventPollResult PollEvent()
{
    unsafe
    {
        stack mut NativeEvent nativeEvent = new();
        if (!NativeBool(stark_sdl3_poll_event(&nativeEvent)))
        {
            return EventPollResult.None;
        }

        return EventPollResult.Some(EventFromNative(nativeEvent));
    }
}

public fn EventPollResult WaitEventTimeout(i32[min max] timeoutMilliseconds)
{
    unsafe
    {
        stack System.C.c_int nativeTimeout = timeoutMilliseconds;
        stack mut NativeEvent nativeEvent = new();
        if (!NativeBool(stark_sdl3_wait_event_timeout(&nativeEvent, nativeTimeout)))
        {
            return EventPollResult.None;
        }

        return EventPollResult.Some(EventFromNative(nativeEvent));
    }
}

