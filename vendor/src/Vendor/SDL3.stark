public struct Library
{
    bool IsInitialized;

    Library()
    {
        self.IsInitialized = false;
    }

    public inline finite law bool IsEmpty(borrow Library self)
    {
        return !self.IsInitialized;
    }

    mut drop
    {
        if (self.IsInitialized)
        {
            unsafe
            {
                stark_sdl3_quit();
            }

            self.IsInitialized = false;
        }
    }
}

public struct Window
{
    internal rawmutptr<SDLWindowNative> Handle;

    Window()
    {
        self.Handle = null;
    }

    public inline finite law bool IsEmpty(borrow Window self)
    {
        return self.Handle == null;
    }

    mut drop
    {
        unsafe
        {
            if (self.Handle != null)
            {
                stark_sdl3_destroy_window(self.Handle);
                self.Handle = null;
            }
        }
    }
}

