public fn AudioStreamResult OpenAudioDeviceStream(u32[0 max] deviceId, AudioSpec spec)
{
    unsafe
    {
        stack rawmutptr<SDLAudioStreamNative> handle = stark_sdl3_open_audio_device_stream(deviceId, &spec);
        if (handle == null)
        {
            return AudioStreamResult.Err(SdlError.AudioStreamCreationFailed);
        }

        stack mut AudioStream stream = new();
        stream.Handle = handle;
        return AudioStreamResult.Ok(stream);
    }
}

public fn AudioStreamResult OpenDefaultPlaybackStream(AudioSpec spec)
{
    return OpenAudioDeviceStream(DefaultPlaybackDevice, spec);
}

public fn SdlStatus PutAudioStreamBytes(mut borrow AudioStream stream, borrow u8[0 max][] data)
{
    if (stream.IsEmpty())
    {
        return SdlStatus.Err(SdlError.InvalidArgument);
    }

    if (data.Length == 0)
    {
        return SdlStatus.Ok;
    }

    if (data.Length > SDL3MaxNativeByteCount)
    {
        return SdlStatus.Err(SdlError.BufferTooLarge);
    }

    unsafe
    {
        stack rawptr<System.C.c_void> dataPointer = (rawptr<System.C.c_void>)(&data[0]);
        stack System.C.c_int nativeLength = (i32[min max])data.Length;
        return StatusFromNative(
            stark_sdl3_put_audio_stream_data(stream.Handle, dataPointer, nativeLength),
            SdlError.NativeFailure);
    }
}

public fn AudioDataResult GetAudioStreamBytes(mut borrow AudioStream stream, borrow mut u8[0 max][] destination)
{
    if (stream.IsEmpty())
    {
        return AudioDataResult.Err(SdlError.InvalidArgument);
    }

    if (destination.Length == 0)
    {
        return AudioDataResult.Ok(0);
    }

    if (destination.Length > SDL3MaxNativeByteCount)
    {
        return AudioDataResult.Err(SdlError.BufferTooLarge);
    }

    unsafe
    {
        stack rawmutptr<System.C.c_void> destinationPointer = (rawmutptr<System.C.c_void>)(&destination[0]);
        stack System.C.c_int nativeLength = (i32[min max])destination.Length;
        stack System.C.c_int read = stark_sdl3_get_audio_stream_data(
            stream.Handle,
            destinationPointer,
            nativeLength);
        if (read < 0)
        {
            return AudioDataResult.Err(SdlError.NativeFailure);
        }

        return AudioDataResult.Ok((u32[0 2147483647])read);
    }
}

public fn AudioAvailableResult GetAudioStreamAvailableBytes(borrow AudioStream stream)
{
    if (stream.IsEmpty())
    {
        return AudioAvailableResult.Err(SdlError.InvalidArgument);
    }

    unsafe
    {
        stack System.C.c_int available = stark_sdl3_get_audio_stream_available(stream.Handle);
        if (available < 0)
        {
            return AudioAvailableResult.Err(SdlError.NativeFailure);
        }

        return AudioAvailableResult.Ok((u32[0 2147483647])available);
    }
}

public fn SdlStatus FlushAudioStream(mut borrow AudioStream stream)
{
    if (stream.IsEmpty())
    {
        return SdlStatus.Err(SdlError.InvalidArgument);
    }

    unsafe
    {
        return StatusFromNative(stark_sdl3_flush_audio_stream(stream.Handle), SdlError.NativeFailure);
    }
}

