    return mipmaps;
}

public fn RlglPixelsResult rlReadTexturePixels(u32[0 max] id, i32[min max] width, i32[min max] height, i32[min max] format)
{
    if (width <= 0 || height <= 0) { return RlglPixelsResult.Err(RlglStatus.InvalidArgument); }
    unsafe
    {
        stack i32[min max] byteCount = stark_raylib_GetPixelDataSize(width, height, format);
        if (byteCount <= 0) { return RlglPixelsResult.Err(RlglStatus.Unsupported); }
        stack rawmutptr<i8[min max]> data = stark_rlgl_rlReadTexturePixels(id, width, height, format);
        if (data == null) { return RlglPixelsResult.Err(RlglStatus.InvalidArgument); }
        stack mut OwnedPixels pixels = new();
        pixels.Data = (rawmutptr<u8[0 max]>)data;
        pixels.ByteLength = (u64[0 2 ** 63 - 1])byteCount;
        return RlglPixelsResult.Ok(pixels);
    }
}

public fn RlglPixelsResult rlReadScreenPixels(i32[min max] width, i32[min max] height)
{
    if (width <= 0 || height <= 0) { return RlglPixelsResult.Err(RlglStatus.InvalidArgument); }
    unsafe
    {
        stack i32[min max] byteCount = stark_raylib_GetPixelDataSize(width, height, RL_PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
        stack rawmutptr<u8[0 max]> data = stark_rlgl_rlReadScreenPixels(width, height);
        if (data == null) { return RlglPixelsResult.Err(RlglStatus.InvalidArgument); }
        stack mut OwnedPixels pixels = new();
        pixels.Data = data;
        pixels.ByteLength = (u64[0 2 ** 63 - 1])byteCount;
        return RlglPixelsResult.Ok(pixels);
    }
}

