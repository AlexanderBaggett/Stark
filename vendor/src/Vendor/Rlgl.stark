import Vendor.Raylib.Types

module Vendor.Rlgl

public enum RlglStatus
{
    Ok,
    TooManyItems,
    InvalidArgument,
    DestinationTooSmall,
    SourceTooLarge,
    Unsupported,
}

public enum RlglPixelsResult
{
    [Ok] Ok(OwnedPixels),
    [Err] Err(RlglStatus),
}

[StructLayout(C)]
internal struct NativeVertexBuffer
{
    i32[min max] ElementCount;
    rawmutptr<f32> Vertices;
    rawmutptr<f32> Texcoords;
    rawmutptr<f32> Normals;
    rawmutptr<u8[0 max]> Colors;
    rawmutptr<u32[0 max]> Indices;
    u32[0 max] VaoId;
    u32[0 max][5] VboId;
}

[StructLayout(C)]
public struct DrawCall
{
    i32[min max] Mode;
    i32[min max] VertexCount;
    i32[min max] VertexAlignment;
    u32[0 max] TextureId;
}

[StructLayout(C)]
internal struct NativeRenderBatch
{
    i32[min max] BufferCount;
    i32[min max] CurrentBuffer;
    rawmutptr<NativeVertexBuffer> VertexBuffer;
    rawmutptr<DrawCall> Draws;
    i32[min max] DrawCounter;
    f32 CurrentDepth;
}

public struct RenderBatch
{
    internal NativeRenderBatch Native;

    RenderBatch()
    {
        self.Native = new();
    }

    public finite law bool IsEmpty(borrow RenderBatch self)
    {
        return self.Native.BufferCount == 0;
    }

    mut drop
    {
        unsafe
        {
            if (self.Native.BufferCount != 0)
            {
                stark_rlgl_rlUnloadRenderBatch(self.Native);
                self.Native = new();
            }
        }
    }
}

public struct GlTextureFormats
{
    u32[0 max] InternalFormat;
    u32[0 max] Format;
    u32[0 max] Type;
}

public struct OwnedPixels
{
    internal rawmutptr<u8[0 max]> Data;
    internal u64[0 2 ** 63 - 1] ByteLength;

    OwnedPixels()
    {
        self.Data = null;
        self.ByteLength = 0;
    }

    public finite law bool IsEmpty(borrow OwnedPixels self)
    {
        return self.Data == null || self.ByteLength == 0;
    }

    public finite law u64[0 2 ** 63 - 1] Length(borrow OwnedPixels self)
    {
        return self.ByteLength;
    }

    public fn RlglStatus CopyTo(borrow OwnedPixels self, borrow mut u8[0 max][] destination)
    {
        if (self.Data == null)
        {
            return RlglStatus.InvalidArgument;
        }

        if (destination.Length < self.ByteLength)
        {
            return RlglStatus.DestinationTooSmall;
        }

        unsafe
        {
            for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < self.ByteLength; index += 1)
            {
                destination[index] = *(&self.Data[index]);
            }
        }

        return RlglStatus.Ok;
    }

    mut drop
    {
        unsafe
        {
            if (self.Data != null)
            {
                stark_raylib_MemFree((rawmutptr<i8[min max]>)self.Data);
                self.Data = null;
                self.ByteLength = 0;
            }
        }
    }
}

[LinkName("MemFree")]
internal unsafe ffi fn void stark_raylib_MemFree(rawmutptr<i8[min max]> pointer);
[LinkName("GetPixelDataSize")]
internal unsafe ffi fn i32[min max] stark_raylib_GetPixelDataSize(i32[min max] width, i32[min max] height, i32[min max] format);

internal inline finite law bool TooManyForI32(u64[0 max] value)
{
    return value > (u64[0 max])(2 ** 31 - 1);
}

internal unsafe inline finite law rawptr<i8[min max]> ReadBytesOrNull(borrow i8[min max][] data)
{
    if (data.Length == 0)
    {
        return null;
    }

    return &data[0];
}

internal unsafe inline finite law rawmutptr<i8[min max]> MutableBytesOrNull(borrow mut i8[min max][] data)
{
    if (data.Length == 0)
    {
        return null;
    }

    return &data[0];
}

internal fn RlglStatus ValidateI32Length(u64[0 max] length)
{
    if (TooManyForI32(length))
    {
        return RlglStatus.TooManyItems;
    }

    return RlglStatus.Ok;
}

