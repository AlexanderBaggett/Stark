public fn GlTextureFormats rlGetGlTextureFormats(i32[min max] format)
{
    stack mut u32[0 max] internalFormat = 0;
    stack mut u32[0 max] glFormat = 0;
    stack mut u32[0 max] glType = 0;
    unsafe { stark_rlgl_rlGetGlTextureFormats(format, &internalFormat, &glFormat, &glType); }
    return new GlTextureFormats() { InternalFormat = internalFormat, Format = glFormat, Type = glType };
}

public fn RlglStatus rlGetPixelFormatName(u32[0 max] format, borrow mut i8[min max][] destination, out u64[0 2 ** 63 - 1] written)
{
    written = 0;
    unsafe
    {
        stack rawptr<i8[min max]> name = stark_rlgl_rlGetPixelFormatName(format);
        if (name == null) { return RlglStatus.InvalidArgument; }
        while willexit (*(&name[written]) != 0)
        {
            if (written >= destination.Length) { return RlglStatus.DestinationTooSmall; }
            destination[written] = *(&name[written]);
            written = (u64[0 2 ** 63 - 1])(written + (u64[0 2 ** 63 - 1])1);
            if (written == (u64[0 2 ** 63 - 1])(2 ** 31 - 1)) { return RlglStatus.SourceTooLarge; }
        }
    }
    return RlglStatus.Ok;
}

public fn i32[min max] rlGenTextureMipmaps(u32[0 max] id, i32[min max] width, i32[min max] height, i32[min max] format)
