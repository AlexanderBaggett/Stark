public fn i32[min max] rlGetShaderLocsDefault(borrow mut i32[min max][] locations)
{
    if (locations.Length == 0) { return 0; }
    stack mut i32[min max] copied = 0;
    unsafe
    {
        stack rawmutptr<i32[min max]> source = stark_rlgl_rlGetShaderLocsDefault();
        if (source == null) { return 0; }
        stack mut u64[0 2 ** 63 - 1] limit = locations.Length;
        if (limit > (u64[0 2 ** 63 - 1])RL_MAX_SHADER_LOCATIONS) { limit = (u64[0 2 ** 63 - 1])RL_MAX_SHADER_LOCATIONS; }
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < limit; index += 1)
        {
            locations[index] = *(&source[index]);
            copied += 1;
        }
    }
    return copied;
}

