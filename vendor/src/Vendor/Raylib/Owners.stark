public struct OwnedMaterials
{
    internal rawmutptr<Material> Data;
    internal u32[0 2 ** 31 - 1] Count;

    OwnedMaterials()
    {
        self.Data = null;
        self.Count = 0;
    }

    public inline finite law bool IsEmpty(borrow OwnedMaterials self)
    {
        return self.Data == null || self.Count == 0;
    }

    public inline finite law u32[0 2 ** 31 - 1] Length(borrow OwnedMaterials self)
    {
        return self.Count;
    }

    public fn bool TryGet(borrow OwnedMaterials self, u32[0 2 ** 31 - 1] index, out Material material)
    {
        material = DefaultMaterial();
        if (self.Data == null || index >= self.Count)
        {
            return false;
        }

        unsafe
        {
            material = *(&self.Data[index]);
        }

        return true;
    }

    public fn void Close(mut borrow OwnedMaterials self)
    {
        if (self.Data != null)
        {
            unsafe
            {
                stack mut u32[0 2 ** 31 - 1] index = 0;
                while willexit (index < self.Count)
                {
                    UnloadMaterial(*(&self.Data[index]));
                    index += 1;
                }

                stark_raylib_MemFree((rawmutptr<i8[min max]>)self.Data);
            }

            self.Data = null;
            self.Count = 0;
        }

        return;
    }

    mut drop
    {
        self.Close();
    }
}

internal unsafe fn OwnedMaterials OwnMaterials(rawmutptr<Material> materials, i32[min max] count)
{
    if (materials == null || count <= 0)
    {
        return new OwnedMaterials();
    }

    stack mut OwnedMaterials owner = new OwnedMaterials();
    owner.Data = materials;
    owner.Count = (u32[0 2 ** 31 - 1])count;
    return owner;
}

public fn OwnedMaterials LoadOwnedMaterials(ascii fileName)
{
    unsafe
    {
        stack mut i32[min max] count = 0;
        stack rawmutptr<Material> materials = LoadMaterials(fileName, &count);
        return OwnMaterials(materials, count);
    }
}

