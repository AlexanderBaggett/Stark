        return resource;
    }

    public fn void Close(mut borrow OwnedAutomationEventList self)
    {
        if (self.Resource.Events != null)
        {
            UnloadAutomationEventList(self.Resource);
            self.Resource = DefaultAutomationEventList();
        }
        return;
    }

    mut drop
    {
        self.Close();
    }
}

public fn OwnedAutomationEventList OwnAutomationEventList(AutomationEventList events)
{
    stack mut OwnedAutomationEventList owner = new OwnedAutomationEventList();
    owner.Resource = events;
    return owner;
}

public fn OwnedAutomationEventList LoadOwnedAutomationEventList(ascii fileName)
{
    return OwnAutomationEventList(LoadAutomationEventList(fileName));
}
