public struct OwnedImage
{
    internal Image Resource;

    OwnedImage()
    {
        self.Resource = DefaultImage();
    }

    public inline finite law Image Value(borrow OwnedImage self)
    {
        return self.Resource;
    }

    public inline finite law bool IsEmpty(borrow OwnedImage self)
    {
        return self.Resource.Data == null;
    }

    public fn bool IsValid(borrow OwnedImage self)
    {
        return IsImageValid(self.Resource);
    }

    public fn Image Release(mut borrow OwnedImage self)
    {
        stack Image resource = self.Resource;
        self.Resource = DefaultImage();
        return resource;
    }

    public fn void Close(mut borrow OwnedImage self)
    {
        if (IsImageValid(self.Resource))
        {
            UnloadImage(self.Resource);
            self.Resource = DefaultImage();
        }
        return;
    }

    mut drop
    {
        self.Close();
    }
}

public fn OwnedImage OwnImage(Image image)
{
    stack mut OwnedImage owner = new OwnedImage();
    owner.Resource = image;
    return owner;
}

public fn OwnedImage LoadOwnedImage(ascii fileName)
{
    return OwnImage(LoadImage(fileName));
}

