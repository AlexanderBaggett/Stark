public fn RaylibTextResult LoadUTF8(borrow i32[min max][] codepoints)
{
    if (TooManyForI32(codepoints.Length))
    {
        return RaylibTextResult.Err(RaylibStatus.TooManyItems);
    }

    unsafe
    {
        return OwnedTextFromPointer(stark_raylib_LoadUTF8(ReadCodepointsOrNull(codepoints), (i32[min max])codepoints.Length));
    }
}

public fn RaylibCodepointsResult LoadCodepoints(ascii text)
{
    unsafe
    {
        stack mut i32[min max] count = 0;
        stack rawmutptr<i32[min max]> codepoints = stark_raylib_LoadCodepoints(text, &count);
        if (count < 0)
        {
            if (codepoints != null)
            {
                stark_raylib_UnloadCodepoints(codepoints);
            }

            return RaylibCodepointsResult.Err(RaylibStatus.InvalidArgument);
        }

        if (count == 0)
        {
            if (codepoints != null)
            {
                stark_raylib_UnloadCodepoints(codepoints);
            }

            return RaylibCodepointsResult.Ok(new RaylibOwnedCodepoints());
        }

        if (codepoints == null)
        {
            return RaylibCodepointsResult.Err(RaylibStatus.InvalidArgument);
        }

        return RaylibCodepointsResult.Ok(new RaylibOwnedCodepoints()
        {
            Data = codepoints,
            Count = (u64[0 2 ** 63 - 1])count
        });
    }
}
