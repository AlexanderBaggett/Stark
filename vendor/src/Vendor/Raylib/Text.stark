[LinkName("TextCopy")]
internal unsafe ffi fn i32[min max] stark_raylib_TextCopy(rawmutptr<i8[min max]> dst, ascii src);
public fn RaylibStatus TextCopy(ascii source, borrow mut i8[min max][] destination, out i32[min max] copied) {
    copied = 0;
    if (destination.Length == 0)
    {
        return RaylibStatus.DestinationTooSmall;
    }

    unsafe {
        copied = stark_raylib_TextCopy(&destination[0], source);
    }

    return RaylibStatus.Ok;
}
