module Vendor.Raylib.Text

public enum RaylibTextResult
{
    [Ok] Ok(RaylibOwnedText),
    [Err] Err(RaylibStatus),
}

public struct RaylibOwnedText
{
    internal rawmutptr<i8[min max]> Data;

    RaylibOwnedText()
    {
        self.Data = null;
    }

    public fn bool IsEmpty(borrow RaylibOwnedText self)
    {
        return self.Length() == 0;
    }

    public fn u64[0 2 ** 63 - 1] Length(borrow RaylibOwnedText self)
    {
        if (self.Data == null)
        {
            return 0;
        }

        unsafe
        {
            stack mut u64[0 2 ** 63 - 1] length = 0;
            while willexit (*(&self.Data[length]) != 0)
            {
                length += 1;
                if (length == (u64[0 2 ** 63 - 1])(2 ** 63 - 1))
                {
                    return length;
                }
            }

            return length;
        }
    }

    public fn RaylibStatus CopyTo(borrow RaylibOwnedText self, borrow mut i8[min max][] destination, out u64[0 2 ** 63 - 1] written)
    {
        written = 0;
        if (self.Data == null)
        {
            return RaylibStatus.InvalidArgument;
        }

        stack u64[0 2 ** 63 - 1] length = self.Length();
        if (destination.Length < length)
        {
            return RaylibStatus.DestinationTooSmall;
        }

        unsafe
        {
            while willexit (written < length)
            {
                destination[written] = *(&self.Data[written]);
                written = (u64[0 2 ** 63 - 1])(written + (u64[0 2 ** 63 - 1])1);
            }
        }

        return RaylibStatus.Ok;
    }

    mut drop
    {
        unsafe
        {
            if (self.Data != null)
            {
                stark_raylib_MemFree(self.Data);
                self.Data = null;
            }
        }
    }
}

public enum RaylibCodepointsResult
{
    [Ok] Ok(RaylibOwnedCodepoints),
    [Err] Err(RaylibStatus),
}

public struct RaylibOwnedCodepoints
{
    internal rawmutptr<i32[min max]> Data;
    internal u64[0 2 ** 63 - 1] Count;

    RaylibOwnedCodepoints()
    {
        self.Data = null;
        self.Count = 0;
    }

    public inline finite law u64[0 2 ** 63 - 1] Length(borrow RaylibOwnedCodepoints self)
    {
        return self.Count;
    }

    public fn bool TryGet(borrow RaylibOwnedCodepoints self, u64[0 2 ** 63 - 1] index, out i32[min max] value)
    {
        value = 0;
        if (index >= self.Count || self.Data == null)
        {
            return false;
        }

        unsafe
        {
            value = *(&self.Data[index]);
        }

        return true;
    }

    public fn RaylibStatus CopyTo(borrow RaylibOwnedCodepoints self, borrow mut i32[min max][] destination)
    {
        if (destination.Length < self.Count)
        {
            return RaylibStatus.DestinationTooSmall;
        }

        unsafe
        {
            stack mut u64[0 2 ** 63 - 1] index = 0;
            while willexit (index < self.Count)
            {
                destination[index] = *(&self.Data[index]);
                index += 1;
            }
        }

        return RaylibStatus.Ok;
    }

    public fn void Close(mut borrow RaylibOwnedCodepoints self)
    {
        unsafe
        {
            if (self.Data != null)
            {
                stark_raylib_UnloadCodepoints(self.Data);
                self.Data = null;
                self.Count = 0;
            }
        }

        return;
    }

    mut drop
    {
        self.Close();
    }
}

internal unsafe inline finite law rawptr<u8[0 max]> ReadU8OrNull(borrow u8[0 max][] data)
{
    if (data.Length == 0)
    {
        return null;
    }

    return &data[0];
}

internal unsafe inline finite law rawptr<i32[min max]> ReadCodepointsOrNull(borrow i32[min max][] codepoints)
{
    if (codepoints.Length == 0)
    {
        return null;
    }

    return &codepoints[0];
}

internal inline finite law bool TooManyForI32(u64[0 max] length)
{
    return length > (u64[0 max])(2 ** 31 - 1);
}

internal unsafe fn RaylibTextResult OwnedTextFromPointer(rawmutptr<i8[min max]> data)
{
    if (data == null)
    {
        return RaylibTextResult.Err(RaylibStatus.InvalidArgument);
    }

    return RaylibTextResult.Ok(new RaylibOwnedText() { Data = data });
}

