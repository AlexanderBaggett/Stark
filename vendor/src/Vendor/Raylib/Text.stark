internal unsafe ffi fn Font stark_raylib_LoadFontFromMemory(ascii fileType, rawptr<u8[0 max]> fileData, i32[min max] dataSize, i32[min max] fontSize, rawptr<i32[min max]> codepoints, i32[min max] codepointCount);
public fn Font LoadFontFromMemory(ascii fileType, borrow u8[0 max][] fileData, i32[min max] fontSize, borrow i32[min max][] codepoints) {
    if (TooManyForI32(fileData.Length) || TooManyForI32(codepoints.Length))
    {
        return DefaultFont();
    }

    unsafe {
        return stark_raylib_LoadFontFromMemory(fileType, ReadU8OrNull(fileData), (i32[min max])fileData.Length, fontSize, ReadCodepointsOrNull(codepoints), (i32[min max])codepoints.Length);
    }
}

