public fn RaylibStatus DrawTextCodepoints(Font font, borrow i32[min max][] codepoints, Vector2 position, f32 fontSize, f32 spacing, Color tint) {
    if (TooManyForI32(codepoints.Length))
    {
        return RaylibStatus.TooManyItems;
    }

    unsafe {
        stark_raylib_DrawTextCodepoints(font, ReadCodepointsOrNull(codepoints), (i32[min max])codepoints.Length, position, fontSize, spacing, tint);
    }

    return RaylibStatus.Ok;
}

