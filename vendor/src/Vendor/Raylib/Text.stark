[LinkName("LoadFontEx")]
internal unsafe ffi fn Font stark_raylib_LoadFontEx(ascii fileName, i32[min max] fontSize, rawptr<i32[min max]> codepoints, i32[min max] codepointCount);
public fn Font LoadFontEx(ascii fileName, i32[min max] fontSize, borrow i32[min max][] codepoints) {
    if (TooManyForI32(codepoints.Length))
    {
        return DefaultFont();
    }

    unsafe {
        return stark_raylib_LoadFontEx(fileName, fontSize, ReadCodepointsOrNull(codepoints), (i32[min max])codepoints.Length);
    }
}

