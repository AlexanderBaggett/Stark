[LinkName("SetWindowIcons")]
internal unsafe ffi fn void stark_raylib_SetWindowIcons(rawptr<Image> images, i32[min max] count);
public fn RaylibStatus SetWindowIcons(borrow Image[] images) {
    if (images.Length > (u64[0 2 ** 63 - 1])(2 ** 31 - 1)) {
        return RaylibStatus.TooManyItems;
    }

    if (images.Length == 0) {
        return RaylibStatus.Ok;
    }

    unsafe {
        stark_raylib_SetWindowIcons(&images[0], (i32[min max])images.Length);
    }
    return RaylibStatus.Ok;
}
