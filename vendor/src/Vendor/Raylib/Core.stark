[LinkName("CompressData")]
internal unsafe ffi fn rawmutptr<u8[0 max]> stark_raylib_CompressData(rawptr<u8[0 max]> data, i32[min max] dataSize, rawmutptr<i32[min max]> compDataSize);
[LinkName("DecompressData")]
internal unsafe ffi fn rawmutptr<u8[0 max]> stark_raylib_DecompressData(rawptr<u8[0 max]> compData, i32[min max] compDataSize, rawmutptr<i32[min max]> dataSize);
[LinkName("EncodeDataBase64")]
internal unsafe ffi fn rawmutptr<i8[min max]> stark_raylib_EncodeDataBase64(rawptr<u8[0 max]> data, i32[min max] dataSize, rawmutptr<i32[min max]> outputSize);
[LinkName("DecodeDataBase64")]
internal unsafe ffi fn rawmutptr<u8[0 max]> stark_raylib_DecodeDataBase64(rawptr<u8[0 max]> data, rawmutptr<i32[min max]> outputSize);
[LinkName("ComputeCRC32")]
internal unsafe ffi fn u32[0 max] stark_raylib_ComputeCRC32(rawptr<u8[0 max]> data, i32[min max] dataSize);
public fn RaylibBytesResult CompressData(borrow u8[0 max][] data) {
    if (TooManyForI32(data.Length))
    {
        return RaylibBytesResult.Err(RaylibStatus.TooManyItems);
    }

    unsafe {
        stack mut i32[min max] compressedSize = 0;
