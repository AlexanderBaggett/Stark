[LinkName("LoadRandomSequence")]
internal unsafe ffi fn rawmutptr<i32[min max]> stark_raylib_LoadRandomSequence(u32[0 max] count, i32[min max] minValue, i32[min max] maxValue);
[LinkName("UnloadRandomSequence")]
internal unsafe ffi fn void stark_raylib_UnloadRandomSequence(rawmutptr<i32[min max]> sequence);
public fn RaylibRandomSequenceResult LoadRandomSequence(u32[0 max] count, i32[min max] minValue, i32[min max] maxValue) {
    if (count == 0 || count > (u32[0 max])(2 ** 31 - 1))
    {
        return RaylibRandomSequenceResult.Err(RaylibStatus.InvalidArgument);
    }

    unsafe {
        stack rawmutptr<i32[min max]> data = stark_raylib_LoadRandomSequence(count, minValue, maxValue);
        if (data == null)
        {
            return RaylibRandomSequenceResult.Err(RaylibStatus.InvalidArgument);
        }

        return RaylibRandomSequenceResult.Ok(new RaylibOwnedRandomSequence()
        {
            Data = data,
            Count = (u64[0 2 ** 63 - 1])count
        });
    }
}
