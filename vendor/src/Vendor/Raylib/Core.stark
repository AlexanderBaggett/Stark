public fn RaylibBytesResult LoadFileData(ascii fileName) {
    unsafe {
        stack mut i32[min max] dataSize = 0;
        stack rawmutptr<u8[0 max]> data = stark_raylib_LoadFileData(fileName, &dataSize);
        return OwnedBytesFromPointer(data, dataSize);
    }
}

public fn bool SaveFileData(ascii fileName, borrow u8[0 max][] data) {
    if (TooManyForI32(data.Length))
    {
        return false;
    }

    unsafe {
        return stark_raylib_SaveFileData(fileName, ReadU8OrNull(data), (i32[min max])data.Length);
    }
}

public fn bool ExportDataAsCode(borrow u8[0 max][] data, ascii fileName) {
    if (TooManyForI32(data.Length))
    {
        return false;
    }

    unsafe {
        return stark_raylib_ExportDataAsCode(ReadU8OrNull(data), (i32[min max])data.Length, fileName);
    }
}

public fn System.Memory.MemoryResult<System.Text.OwnedAscii> LoadFileText(ascii fileName) {
    unsafe {
        stack rawmutptr<i8[min max]> text = stark_raylib_LoadFileText(fileName);
        stack System.Memory.MemoryResult<System.Text.OwnedAscii> result = CopyCString(text);
        if (text != null)
        {
            stark_raylib_UnloadFileText(text);
        }

        return result;
    }
}

public fn bool SaveFileText(ascii fileName, ascii text) {
    unsafe {
        return stark_raylib_SaveFileText(fileName, text);
    }
}
