import Vendor.Raylib.Types
import System.Memory
import System.Text
export import Vendor.Raylib.Types
module Vendor.Raylib.Core

public enum RaylibBytesResult
{
    [Ok] Ok(RaylibOwnedBytes),
    [Err] Err(RaylibStatus),
}

public struct RaylibOwnedBytes
{
    internal rawmutptr<u8[0 max]> Data;
    internal u64[0 2 ** 63 - 1] ByteLength;

    RaylibOwnedBytes()
    {
        self.Data = null;
        self.ByteLength = 0;
    }

    public inline finite law u64[0 2 ** 63 - 1] Length(borrow RaylibOwnedBytes self)
    {
        return self.ByteLength;
    }

    public inline finite law bool IsEmpty(borrow RaylibOwnedBytes self)
    {
        return self.ByteLength == 0;
    }

    public fn RaylibStatus CopyTo(borrow RaylibOwnedBytes self, borrow mut u8[0 max][] destination)
    {
        if (destination.Length < self.ByteLength)
        {
            return RaylibStatus.DestinationTooSmall;
        }

        unsafe
        {
            stack mut u64[0 2 ** 63 - 1] index = 0;
            while willexit (index < self.ByteLength)
            {
                destination[index] = *(&self.Data[index]);
                index += 1;
            }
        }

        return RaylibStatus.Ok;
    }

    public fn void Close(mut borrow RaylibOwnedBytes self)
    {
        unsafe
        {
            if (self.Data != null)
            {
                stark_raylib_MemFree((rawmutptr<i8[min max]>)self.Data);
                self.Data = null;
                self.ByteLength = 0;
            }
        }

        return;
    }

    mut drop
    {
        self.Close();
    }
}

public enum RaylibRandomSequenceResult
{
    [Ok] Ok(RaylibOwnedRandomSequence),
    [Err] Err(RaylibStatus),
}

public struct RaylibOwnedRandomSequence
{
    internal rawmutptr<i32[min max]> Data;
    internal u64[0 2 ** 63 - 1] Count;

    RaylibOwnedRandomSequence()
    {
        self.Data = null;
        self.Count = 0;
    }

    public inline finite law u64[0 2 ** 63 - 1] Length(borrow RaylibOwnedRandomSequence self)
    {
        return self.Count;
    }

    public fn bool TryGet(borrow RaylibOwnedRandomSequence self, u64[0 2 ** 63 - 1] index, out i32[min max] value)
    {
        value = 0;
        if (index >= self.Count || self.Data == null)
        {
            return false;
        }

        unsafe
        {
            value = *(&self.Data[index]);
        }

        return true;
    }

    public fn RaylibStatus CopyTo(borrow RaylibOwnedRandomSequence self, borrow mut i32[min max][] destination)
    {
        if (destination.Length < self.Count)
        {
            return RaylibStatus.DestinationTooSmall;
        }

        unsafe
        {
            stack mut u64[0 2 ** 63 - 1] index = 0;
            while willexit (index < self.Count)
            {
                destination[index] = *(&self.Data[index]);
                index += 1;
            }
        }

        return RaylibStatus.Ok;
    }

    public fn void Close(mut borrow RaylibOwnedRandomSequence self)
    {
        unsafe
        {
            if (self.Data != null)
            {
                stark_raylib_UnloadRandomSequence(self.Data);
                self.Data = null;
                self.Count = 0;
            }
        }

        return;
    }

    mut drop
    {
        self.Close();
    }
}

internal inline finite law bool TooManyForI32(u64[0 max] length)
{
    return length > (u64[0 max])(2 ** 31 - 1);
}

internal unsafe inline finite law rawptr<u8[0 max]> ReadU8OrNull(borrow u8[0 max][] data)
{
    if (data.Length == 0)
    {
        return null;
    }

    return &data[0];
}

internal unsafe fn RaylibBytesResult OwnedBytesFromPointer(rawmutptr<u8[0 max]> data, i32[min max] byteLength)
{
    if (byteLength < 0)
    {
        if (data != null)
        {
            stark_raylib_MemFree((rawmutptr<i8[min max]>)data);
        }

        return RaylibBytesResult.Err(RaylibStatus.InvalidArgument);
    }

    if (byteLength == 0)
    {
        if (data != null)
        {
            stark_raylib_MemFree((rawmutptr<i8[min max]>)data);
        }

        return RaylibBytesResult.Ok(new RaylibOwnedBytes());
    }

    if (data == null)
    {
        return RaylibBytesResult.Err(RaylibStatus.InvalidArgument);
    }

    return RaylibBytesResult.Ok(new RaylibOwnedBytes()
    {
        Data = data,
        ByteLength = (u64[0 2 ** 63 - 1])byteLength
    });
}

internal unsafe fn System.Memory.MemoryResult<System.Text.OwnedAscii> CopyCString(rawptr<i8[min max]> data)
{
    if (data == null)
    {
        return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(System.Memory.MemoryError.InvalidLayout);
    }

    stack mut u64[0 2 ** 63 - 1] length = 0;
    while willexit (*(&data[length]) != 0)
    {
        if (length == (u64[0 2 ** 63 - 1])(2 ** 63 - 1))
        {
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(System.Memory.MemoryError.TooLarge);
        }

        length += 1;
    }

    stack mut System.Text.OwnedAscii destination = new();
    stack System.Memory.MemoryStatus reserveStatus = destination.Reserve(length);
    switch (reserveStatus)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < length)
    {
        stack System.Memory.MemoryStatus appendStatus = destination.AppendByte(*(&data[index]));
        switch (appendStatus)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        index += 1;
    }

    return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(destination);
}

