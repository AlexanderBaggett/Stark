public fn RaylibStatus ImageDrawTriangleStrip(Image dst, borrow Vector2[] points, Color color, out Image result) {
    stack mut Image working = dst;
    if (points.Length > (u64[0 2 ** 63 - 1])(2 ** 31 - 1)) {
        result = working;
        return RaylibStatus.TooManyItems;
    }

    if (points.Length == 0) {
        result = working;
        return RaylibStatus.Ok;
    }

    unsafe {
        stark_raylib_ImageDrawTriangleStrip(&working, &points[0], (i32[min max])points.Length, color);
    }
    result = working;
    return RaylibStatus.Ok;
}

