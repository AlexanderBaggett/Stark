[LinkName("ImageKernelConvolution")]
internal unsafe ffi fn void stark_raylib_ImageKernelConvolution(rawmutptr<Image> image, rawptr<f32> kernel, i32[min max] kernelSize);
public fn RaylibStatus ImageKernelConvolution(Image image, borrow f32[] kernel, out Image result) {
    stack mut Image working = image;
    if (kernel.Length == 0) {
        result = working;
        return RaylibStatus.InvalidArgument;
    }

    if (kernel.Length > (u64[0 2 ** 63 - 1])(2 ** 31 - 1)) {
        result = working;
        return RaylibStatus.TooManyItems;
    }

    unsafe {
        stark_raylib_ImageKernelConvolution(&working, &kernel[0], (i32[min max])kernel.Length);
    }
    result = working;
    return RaylibStatus.Ok;
}

