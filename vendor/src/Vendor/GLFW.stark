internal finite law System.C.c_int BoolToNative(bool value)
{
    if (value)
    {
        return GLFW_TRUE;
    }

    return GLFW_FALSE;
}

internal finite law bool NativeBool(System.C.c_int value)
{
    return value != GLFW_FALSE;
}

internal finite law GlfwError ErrorFromNative(i32[min max] code)
{
    switch (code)
    {
        case 0:
            return GlfwError.NoError;
        case 65537:
            return GlfwError.NotInitialized;
        case 65538:
            return GlfwError.NoCurrentContext;
        case 65539:
            return GlfwError.InvalidEnum;
        case 65540:
            return GlfwError.InvalidValue;
        case 65541:
            return GlfwError.OutOfMemory;
        case 65542:
            return GlfwError.ApiUnavailable;
        case 65543:
            return GlfwError.VersionUnavailable;
        case 65544:
            return GlfwError.PlatformError;
        case 65545:
            return GlfwError.FormatUnavailable;
        case 65546:
            return GlfwError.NoWindowContext;
        case 65547:
            return GlfwError.CursorUnavailable;
        case 65548:
            return GlfwError.FeatureUnavailable;
        case 65549:
            return GlfwError.FeatureUnimplemented;
        case 65550:
            return GlfwError.PlatformUnavailable;
        default:
            return GlfwError.Native(code);
    }
}

internal fn GlfwError LastErrorOr(GlfwError fallback)
{
    unsafe
    {
        stack System.C.c_int code = glfwGetError(null);
        if (code == GLFW_NO_ERROR)
        {
            return fallback;
        }

        return ErrorFromNative((i32[min max])code);
    }
}

internal finite law InputAction ActionFromNative(System.C.c_int action)
{
    switch (action)
    {
        case 0:
            return InputAction.Release;
        case 1:
            return InputAction.Press;
        case 2:
            return InputAction.Repeat;
        default:
            return InputAction.Unknown((i32[min max])action);
    }
}

internal finite law System.C.c_int ClientApiToNative(ClientApi api)
{
    switch (api)
    {
        case ClientApi.None:
            return GLFW_NO_API;
        case ClientApi.OpenGL:
            return GLFW_OPENGL_API;
        case ClientApi.OpenGLES:
            return GLFW_OPENGL_ES_API;
    }
}

internal finite law System.C.c_int OpenGLProfileToNative(OpenGLProfile profile)
{
    switch (profile)
    {
        case OpenGLProfile.Any:
            return GLFW_OPENGL_ANY_PROFILE;
        case OpenGLProfile.Core:
            return GLFW_OPENGL_CORE_PROFILE;
        case OpenGLProfile.Compatibility:
            return GLFW_OPENGL_COMPAT_PROFILE;
    }
}

internal finite law System.C.c_int HintToNative(WindowHint hint)
{
    switch (hint)
    {
        case WindowHint.Focused:
            return GLFW_FOCUSED;
        case WindowHint.Resizable:
            return GLFW_RESIZABLE;
        case WindowHint.Visible:
            return GLFW_VISIBLE;
        case WindowHint.Decorated:
            return GLFW_DECORATED;
        case WindowHint.AutoIconify:
            return GLFW_AUTO_ICONIFY;
        case WindowHint.Floating:
            return GLFW_FLOATING;
        case WindowHint.Maximized:
            return GLFW_MAXIMIZED;
        case WindowHint.CenterCursor:
            return GLFW_CENTER_CURSOR;
        case WindowHint.TransparentFramebuffer:
            return GLFW_TRANSPARENT_FRAMEBUFFER;
        case WindowHint.FocusOnShow:
            return GLFW_FOCUS_ON_SHOW;
        case WindowHint.ScaleToMonitor:
            return GLFW_SCALE_TO_MONITOR;
        case WindowHint.ClientApi:
            return GLFW_CLIENT_API;
        case WindowHint.ContextVersionMajor:
            return GLFW_CONTEXT_VERSION_MAJOR;
        case WindowHint.ContextVersionMinor:
            return GLFW_CONTEXT_VERSION_MINOR;
        case WindowHint.OpenGLProfile:
            return GLFW_OPENGL_PROFILE;
        case WindowHint.OpenGLForwardCompat:
            return GLFW_OPENGL_FORWARD_COMPAT;
    }
}

internal finite law GlfwEventKind EventKindFromNative(i32[min max] kind)
{
    switch (kind)
    {
        case 1:
            return GlfwEventKind.Close;
        case 2:
            return GlfwEventKind.WindowSize;
        case 3:
            return GlfwEventKind.FramebufferSize;
        case 4:
            return GlfwEventKind.Key;
        case 5:
            return GlfwEventKind.MouseButton;
        case 6:
            return GlfwEventKind.CursorPosition;
        case 7:
            return GlfwEventKind.Scroll;
        case 8:
            return GlfwEventKind.Focus;
        default:
            return GlfwEventKind.Unknown(kind);
    }
}

internal finite law GlfwEvent EventFromNative(NativeEvent event)
{
    return new GlfwEvent()
    {
        WindowToken = event.WindowToken,
        Kind = EventKindFromNative(event.Kind),
        A = event.A,
        B = event.B,
        C = event.C,
        D = event.D,
        X = event.X,
        Y = event.Y
    };
}

public fn Version GetVersion()
{
    unsafe
    {
        stack mut System.C.c_int major = 0;
        stack mut System.C.c_int minor = 0;
        stack mut System.C.c_int revision = 0;
        glfwGetVersion(&major, &minor, &revision);
        return new Version()
        {
            Major = (i32[min max])major,
            Minor = (i32[min max])minor,
            Revision = (i32[min max])revision
        };
    }
}

public fn GlfwError GetLastError()
{
    return LastErrorOr(GlfwError.NoError);
}

public fn LibraryResult Initialize()
{
    unsafe
    {
        if (glfwInit() == GLFW_FALSE)
        {
            return LibraryResult.Err(LastErrorOr(GlfwError.InitFailed));
        }

        stack mut Library library = new();
        library.IsInitialized = true;
        return LibraryResult.Ok(library);
    }
}

public fn void DefaultWindowHints()
{
    unsafe
    {
        glfwDefaultWindowHints();
    }
}

public fn void SetWindowHint(WindowHint hint, i32[min max] value)
{
    unsafe
    {
        stack System.C.c_int nativeValue = value;
        glfwWindowHint(HintToNative(hint), nativeValue);
    }
}

public fn void SetWindowHintBool(WindowHint hint, bool value)
{
    unsafe
    {
        glfwWindowHint(HintToNative(hint), BoolToNative(value));
    }
}

public fn void SetClientApiHint(ClientApi api)
{
    unsafe
    {
        glfwWindowHint(GLFW_CLIENT_API, ClientApiToNative(api));
    }
}

public fn void SetOpenGLProfileHint(OpenGLProfile profile)
{
    unsafe
    {
        glfwWindowHint(GLFW_OPENGL_PROFILE, OpenGLProfileToNative(profile));
    }
}

public fn WindowResult CreateWindow(u16[1 32767] width, u16[1 32767] height, ascii title)
{
    stack System.C.CStringResult<System.C.OwnedCStr> titleResult = System.C.FromAscii(title);
    switch (titleResult)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return WindowResult.Err(GlfwError.CString(error));
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cTitle):
            unsafe
            {
                stack System.C.c_int nativeWidth = width;
                stack System.C.c_int nativeHeight = height;
                stack rawmutptr<GLFWwindowNative> handle = glfwCreateWindow(
                    nativeWidth,
                    nativeHeight,
                    cTitle.Data(),
                    null,
                    null);
                if (handle == null)
                {
                    return WindowResult.Err(LastErrorOr(GlfwError.WindowCreationFailed));
                }

                stack mut Window window = new();
                window.Handle = handle;
                return WindowResult.Ok(window);
            }
    }
}

public fn WindowResult CreateHiddenWindow(u16[1 32767] width, u16[1 32767] height, ascii title)
{
    SetWindowHintBool(WindowHint.Visible, false);
    return CreateWindow(width, height, title);
}

public fn GlfwStatus VulkanSupported()
{
    unsafe
    {
        if (glfwVulkanSupported() == GLFW_FALSE)
        {
            return GlfwStatus.Err(GlfwError.VulkanUnavailable);
        }
    }

    return GlfwStatus.Ok;
}

public fn VulkanInstanceExtensionsResult RequiredVulkanInstanceExtensions()
{
    unsafe
    {
        stack mut u32[0 max] count = 0;
        stack mut VulkanInstanceExtensionsNative native = new VulkanInstanceExtensionsNative();
        native.Names = glfwGetRequiredInstanceExtensions(&count);
        if (native.Names == null || count == 0)
        {
            return VulkanInstanceExtensionsResult.Err(GlfwError.VulkanUnavailable);
        }

        return VulkanInstanceExtensionsResult.Ok(new VulkanInstanceExtensions()
        {
            Count = count,
            NamesToken = (u64[0 max])native.Names
        });
    }
}

public fn VulkanSurfaceResult CreateVulkanSurface(borrow Window window, u64[0 max] instanceToken)
{
    if (window.Handle == null || instanceToken == 0)
    {
        return VulkanSurfaceResult.Err(GlfwError.InvalidArgument);
    }

    unsafe
    {
        stack mut u64[0 max] surface = 0;
        stack i32[min max] result = glfwCreateWindowSurface(
            (rawmutptr<System.C.c_void>)instanceToken,
            window.Handle,
            null,
            &surface);
        if (result != 0)
        {
            return VulkanSurfaceResult.Err(GlfwError.Native(result));
        }

        if (surface == 0)
        {
            return VulkanSurfaceResult.Err(GlfwError.VulkanSurfaceCreationFailed);
        }

        return VulkanSurfaceResult.Ok(surface);
    }
}

public fn GlfwStatus EnableEventBridge(mut borrow Window window)
{
    if (window.IsEmpty())
    {
        return GlfwStatus.Err(GlfwError.InvalidArgument);
    }

    unsafe
    {
        if (stark_glfw_install_event_bridge(window.Handle) == GLFW_FALSE)
        {
            return GlfwStatus.Err(GlfwError.InvalidArgument);
        }
    }

    return GlfwStatus.Ok;
}

public fn void DisableEventBridge(mut borrow Window window)
{
    unsafe
    {
        if (window.Handle != null)
        {
            stark_glfw_uninstall_event_bridge(window.Handle);
        }
    }
}

public fn EventPollResult PollEvent()
{
    unsafe
    {
        stack mut NativeEvent nativeEvent = new();
        if (stark_glfw_poll_event(&nativeEvent) == GLFW_FALSE)
        {
            return EventPollResult.None;
        }

        return EventPollResult.Some(EventFromNative(nativeEvent));
    }
}

