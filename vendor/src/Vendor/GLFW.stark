public struct Library
{
    bool IsInitialized;

    Library()
    {
        self.IsInitialized = false;
    }

    public inline finite law bool IsEmpty(borrow Library self)
    {
        return !self.IsInitialized;
    }

    mut drop
    {
        if (self.IsInitialized)
        {
            unsafe
            {
                glfwTerminate();
            }

            self.IsInitialized = false;
        }
    }
}

public struct Window
{
    internal rawmutptr<GLFWwindowNative> Handle;

    Window()
    {
        self.Handle = null;
    }

    public inline finite law bool IsEmpty(borrow Window self)
    {
        return self.Handle == null;
    }

    public fn u64[0 max] Token(borrow Window self)
    {
        unsafe
        {
            return (u64[0 max])self.Handle;
        }
    }

    mut drop
    {
        unsafe
        {
            if (self.Handle != null)
            {
                stark_glfw_uninstall_event_bridge(self.Handle);
                glfwDestroyWindow(self.Handle);
                self.Handle = null;
            }
        }
    }
}

public struct VulkanInstanceExtensions
{
    public u32[0 max] Count;
    internal u64[0 max] NamesToken;

    VulkanInstanceExtensions()
    {
        self.Count = 0;
        self.NamesToken = 0;
    }

    public inline finite law bool IsEmpty(borrow VulkanInstanceExtensions self)
    {
        return self.Count == 0 || self.NamesToken == 0;
    }

    public inline finite law u64[0 max] Token(borrow VulkanInstanceExtensions self)
    {
        return self.NamesToken;
    }
}

