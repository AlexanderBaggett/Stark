public fn void SwapBuffers(borrow Window window)
{
    unsafe
    {
        if (window.Handle != null)
        {
            glfwSwapBuffers(window.Handle);
        }
    }
}

public fn void SwapInterval(i32[min max] interval)
{
    unsafe
    {
        stack System.C.c_int nativeInterval = interval;
        glfwSwapInterval(nativeInterval);
    }
}

public fn f64 GetTime()
{
    unsafe
    {
        return glfwGetTime();
    }
}

public fn void SetTime(f64 time)
{
    unsafe
    {
        glfwSetTime(time);
    }
}

public fn InputAction GetKey(borrow Window window, i32[min max] key)
{
    unsafe
    {
        if (window.Handle == null)
        {
            return InputAction.Release;
        }

        stack System.C.c_int nativeKey = key;
        return ActionFromNative(glfwGetKey(window.Handle, nativeKey));
    }
}

public fn InputAction GetMouseButton(borrow Window window, i32[min max] button)
{
    unsafe
    {
        if (window.Handle == null)
        {
            return InputAction.Release;
        }

        stack System.C.c_int nativeButton = button;
        return ActionFromNative(glfwGetMouseButton(window.Handle, nativeButton));
    }
}

public fn CursorPosition GetCursorPosition(borrow Window window)
{
    unsafe
    {
        stack mut f64 x = 0.0;
        stack mut f64 y = 0.0;
        if (window.Handle != null)
        {
            glfwGetCursorPos(window.Handle, &x, &y);
        }

        return new CursorPosition()
        {
            X = x,
            Y = y
        };
    }
}
