public inline finite law Vector4 Vector4Normalize(Vector4 v)
{
stack mut Vector4 result = DefaultVector4();
    stack mut f32 length = Sqrt((v.X*v.X) + (v.Y*v.Y) + (v.Z*v.Z) + (v.W*v.W));

    if (length > 0)
    {
        stack mut f32 ilength = 1.0f/length;
        result.X = v.X*ilength;
        result.Y = v.Y*ilength;
        result.Z = v.Z*ilength;
        result.W = v.W*ilength;
    }

    return result;
}

