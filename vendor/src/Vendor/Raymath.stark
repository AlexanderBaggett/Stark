    return result;
}

public inline finite law f32 MatrixDeterminant(Matrix mat)
{
stack mut f32 result = 0.0f;

    
    
    

    
    stack mut f32 m0 = mat.M0;

    
    
    

    
    stack mut f32 m1 = mat.M1;

    
    
    

    
    stack mut f32 m2 = mat.M2;

    
    
    

    
    stack mut f32 m3 = mat.M3;
    stack mut f32 m4 = mat.M4;
    stack mut f32 m5 = mat.M5;
    stack mut f32 m6 = mat.M6;
    stack mut f32 m7 = mat.M7;
    stack mut f32 m8 = mat.M8;
    stack mut f32 m9 = mat.M9;
    stack mut f32 m10 = mat.M10;
    stack mut f32 m11 = mat.M11;
    stack mut f32 m12 = mat.M12;
    stack mut f32 m13 = mat.M13;
    stack mut f32 m14 = mat.M14;
    stack mut f32 m15 = mat.M15;

    result = (m0*((m5*(m10*m15 - m11*m14) - m9*(m6*m15 - m7*m14) + m13*(m6*m11 - m7*m10))) -
        m4*((m1*(m10*m15 - m11*m14) - m9*(m2*m15 - m3*m14) + m13*(m2*m11 - m3*m10))) +
        m8*((m1*(m6*m15 - m7*m14) - m5*(m2*m15 - m3*m14) + m13*(m2*m7 - m3*m6))) -
        m12*((m1*(m6*m11 - m7*m10) - m5*(m2*m11 - m3*m10) + m9*(m2*m7 - m3*m6))));

    return result;
}

