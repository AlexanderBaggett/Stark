}

public inline finite law Matrix MatrixInvert(Matrix mat)
{
stack mut Matrix result = DefaultMatrix();

    
    stack mut f32 a00 = mat.M0;

    
    stack mut f32 a01 = mat.M1;

    
    stack mut f32 a02 = mat.M2;

    
    stack mut f32 a03 = mat.M3;
    stack mut f32 a10 = mat.M4;
    stack mut f32 a11 = mat.M5;
    stack mut f32 a12 = mat.M6;
    stack mut f32 a13 = mat.M7;
    stack mut f32 a20 = mat.M8;
    stack mut f32 a21 = mat.M9;
    stack mut f32 a22 = mat.M10;
    stack mut f32 a23 = mat.M11;
    stack mut f32 a30 = mat.M12;
    stack mut f32 a31 = mat.M13;
    stack mut f32 a32 = mat.M14;
    stack mut f32 a33 = mat.M15;

    stack mut f32 b00 = a00*a11 - a01*a10;
    stack mut f32 b01 = a00*a12 - a02*a10;
    stack mut f32 b02 = a00*a13 - a03*a10;
    stack mut f32 b03 = a01*a12 - a02*a11;
    stack mut f32 b04 = a01*a13 - a03*a11;
    stack mut f32 b05 = a02*a13 - a03*a12;
    stack mut f32 b06 = a20*a31 - a21*a30;
    stack mut f32 b07 = a20*a32 - a22*a30;
    stack mut f32 b08 = a20*a33 - a23*a30;
    stack mut f32 b09 = a21*a32 - a22*a31;
    stack mut f32 b10 = a21*a33 - a23*a31;
    stack mut f32 b11 = a22*a33 - a23*a32;

    
    stack mut f32 invDet = 1.0f/(b00*b11 - b01*b10 + b02*b09 + b03*b08 - b04*b07 + b05*b06);

    result.M0 = (a11*b11 - a12*b10 + a13*b09)*invDet;
    result.M1 = (-a01*b11 + a02*b10 - a03*b09)*invDet;
    result.M2 = (a31*b05 - a32*b04 + a33*b03)*invDet;
    result.M3 = (-a21*b05 + a22*b04 - a23*b03)*invDet;
    result.M4 = (-a10*b11 + a12*b08 - a13*b07)*invDet;
    result.M5 = (a00*b11 - a02*b08 + a03*b07)*invDet;
    result.M6 = (-a30*b05 + a32*b02 - a33*b01)*invDet;
    result.M7 = (a20*b05 - a22*b02 + a23*b01)*invDet;
    result.M8 = (a10*b10 - a11*b08 + a13*b06)*invDet;
    result.M9 = (-a00*b10 + a01*b08 - a03*b06)*invDet;
    result.M10 = (a30*b04 - a31*b02 + a33*b00)*invDet;
    result.M11 = (-a20*b04 + a21*b02 - a23*b00)*invDet;
    result.M12 = (-a10*b09 + a11*b07 - a12*b06)*invDet;
    result.M13 = (a00*b09 - a01*b07 + a02*b06)*invDet;
    result.M14 = (-a30*b03 + a31*b01 - a32*b00)*invDet;
    result.M15 = (a20*b03 - a21*b01 + a22*b00)*invDet;

    return result;
}

public inline finite law Matrix MatrixIdentity()
{
stack mut Matrix result = new Matrix() { M0 = 1.0f, M4 = 0.0f, M8 = 0.0f, M12 = 0.0f, M1 = 0.0f, M5 = 1.0f, M9 = 0.0f, M13 = 0.0f, M2 = 0.0f, M6 = 0.0f, M10 = 1.0f, M14 = 0.0f, M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f };

    return result;
}

public inline finite law Matrix MatrixAdd(Matrix left, Matrix right)
{
stack mut Matrix result = DefaultMatrix();

    result.M0 = left.M0 + right.M0;
    result.M1 = left.M1 + right.M1;
    result.M2 = left.M2 + right.M2;
    result.M3 = left.M3 + right.M3;
    result.M4 = left.M4 + right.M4;
    result.M5 = left.M5 + right.M5;
    result.M6 = left.M6 + right.M6;
    result.M7 = left.M7 + right.M7;
    result.M8 = left.M8 + right.M8;
    result.M9 = left.M9 + right.M9;
    result.M10 = left.M10 + right.M10;
    result.M11 = left.M11 + right.M11;
    result.M12 = left.M12 + right.M12;
    result.M13 = left.M13 + right.M13;
    result.M14 = left.M14 + right.M14;
    result.M15 = left.M15 + right.M15;

    return result;
}

public inline finite law Matrix MatrixSubtract(Matrix left, Matrix right)
{
stack mut Matrix result = DefaultMatrix();

    result.M0 = left.M0 - right.M0;
    result.M1 = left.M1 - right.M1;
    result.M2 = left.M2 - right.M2;
    result.M3 = left.M3 - right.M3;
    result.M4 = left.M4 - right.M4;
    result.M5 = left.M5 - right.M5;
    result.M6 = left.M6 - right.M6;
    result.M7 = left.M7 - right.M7;
    result.M8 = left.M8 - right.M8;
    result.M9 = left.M9 - right.M9;
    result.M10 = left.M10 - right.M10;
    result.M11 = left.M11 - right.M11;
    result.M12 = left.M12 - right.M12;
    result.M13 = left.M13 - right.M13;
    result.M14 = left.M14 - right.M14;
    result.M15 = left.M15 - right.M15;

    return result;
}

public inline finite law Matrix MatrixMultiply(Matrix left, Matrix right)
{
    stack mut Matrix result = DefaultMatrix();
    result.M0 = left.M0*right.M0 + left.M1*right.M4 + left.M2*right.M8 + left.M3*right.M12;
    result.M1 = left.M0*right.M1 + left.M1*right.M5 + left.M2*right.M9 + left.M3*right.M13;
    result.M2 = left.M0*right.M2 + left.M1*right.M6 + left.M2*right.M10 + left.M3*right.M14;
    result.M3 = left.M0*right.M3 + left.M1*right.M7 + left.M2*right.M11 + left.M3*right.M15;
    result.M4 = left.M4*right.M0 + left.M5*right.M4 + left.M6*right.M8 + left.M7*right.M12;
    result.M5 = left.M4*right.M1 + left.M5*right.M5 + left.M6*right.M9 + left.M7*right.M13;
    result.M6 = left.M4*right.M2 + left.M5*right.M6 + left.M6*right.M10 + left.M7*right.M14;
    result.M7 = left.M4*right.M3 + left.M5*right.M7 + left.M6*right.M11 + left.M7*right.M15;
    result.M8 = left.M8*right.M0 + left.M9*right.M4 + left.M10*right.M8 + left.M11*right.M12;
    result.M9 = left.M8*right.M1 + left.M9*right.M5 + left.M10*right.M9 + left.M11*right.M13;
    result.M10 = left.M8*right.M2 + left.M9*right.M6 + left.M10*right.M10 + left.M11*right.M14;
    result.M11 = left.M8*right.M3 + left.M9*right.M7 + left.M10*right.M11 + left.M11*right.M15;
    result.M12 = left.M12*right.M0 + left.M13*right.M4 + left.M14*right.M8 + left.M15*right.M12;
    result.M13 = left.M12*right.M1 + left.M13*right.M5 + left.M14*right.M9 + left.M15*right.M13;
    result.M14 = left.M12*right.M2 + left.M13*right.M6 + left.M14*right.M10 + left.M15*right.M14;
    result.M15 = left.M12*right.M3 + left.M13*right.M7 + left.M14*right.M11 + left.M15*right.M15;
    return result;
}

public inline finite law Matrix MatrixMultiplyValue(Matrix left, f32 value)
{
stack mut Matrix result = new Matrix() { M0 = left.M0*value, M4 = left.M4*value, M8 = left.M8*value, M12 = left.M12*value, M1 = left.M1*value, M5 = left.M5*value, M9 = left.M9*value, M13 = left.M13*value, M2 = left.M2*value, M6 = left.M6*value, M10 = left.M10*value, M14 = left.M14*value, M3 = left.M3*value, M7 = left.M7*value, M11 = left.M11*value, M15 = left.M15*value };

    return result;
}

public inline finite law Matrix MatrixTranslate(f32 x, f32 y, f32 z)
{
stack mut Matrix result = new Matrix() { M0 = 1.0f, M4 = 0.0f, M8 = 0.0f, M12 = x, M1 = 0.0f, M5 = 1.0f, M9 = 0.0f, M13 = y, M2 = 0.0f, M6 = 0.0f, M10 = 1.0f, M14 = z, M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f };

    return result;
}

public inline finite law Matrix MatrixRotate(Vector3 axis, f32 angle)
{
stack mut Matrix result = DefaultMatrix();

    stack mut f32 x = axis.X;

    stack mut f32 y = axis.Y;

    stack mut f32 z = axis.Z;

    stack mut f32 lengthSquared = x*x + y*y + z*z;

    if ((lengthSquared != 1.0f) && (lengthSquared != 0.0f))
    {
        stack mut f32 ilength = 1.0f/Sqrt(lengthSquared);
        x *= ilength;
        y *= ilength;
        z *= ilength;
    }

    stack mut f32 sinres = Sin(angle);
    stack mut f32 cosres = Cos(angle);
    stack mut f32 t = 1.0f - cosres;

    result.M0 = x*x*t + cosres;
    result.M1 = y*x*t + z*sinres;
    result.M2 = z*x*t - y*sinres;
    result.M3 = 0.0f;

    result.M4 = x*y*t - z*sinres;
    result.M5 = y*y*t + cosres;
    result.M6 = z*y*t + x*sinres;
    result.M7 = 0.0f;

    result.M8 = x*z*t + y*sinres;
    result.M9 = y*z*t - x*sinres;
    result.M10 = z*z*t + cosres;
    result.M11 = 0.0f;

    result.M12 = 0.0f;
    result.M13 = 0.0f;
    result.M14 = 0.0f;
    result.M15 = 1.0f;

    return result;
}

public inline finite law Matrix MatrixRotateX(f32 angle)
{
stack mut Matrix result = new Matrix() { M0 = 1.0f, M4 = 0.0f, M8 = 0.0f, M12 = 0.0f, M1 = 0.0f, M5 = 1.0f, M9 = 0.0f, M13 = 0.0f, M2 = 0.0f, M6 = 0.0f, M10 = 1.0f, M14 = 0.0f, M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f }; 

    stack mut f32 cosres = Cos(angle);
    stack mut f32 sinres = Sin(angle);

    result.M5 = cosres;
    result.M6 = sinres;
    result.M9 = -sinres;
    result.M10 = cosres;

    return result;
}

public inline finite law Matrix MatrixRotateY(f32 angle)
{
stack mut Matrix result = new Matrix() { M0 = 1.0f, M4 = 0.0f, M8 = 0.0f, M12 = 0.0f, M1 = 0.0f, M5 = 1.0f, M9 = 0.0f, M13 = 0.0f, M2 = 0.0f, M6 = 0.0f, M10 = 1.0f, M14 = 0.0f, M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f }; 

    stack mut f32 cosres = Cos(angle);
    stack mut f32 sinres = Sin(angle);

    result.M0 = cosres;
    result.M2 = -sinres;
    result.M8 = sinres;
    result.M10 = cosres;

    return result;
}

public inline finite law Matrix MatrixRotateZ(f32 angle)
{
stack mut Matrix result = new Matrix() { M0 = 1.0f, M4 = 0.0f, M8 = 0.0f, M12 = 0.0f, M1 = 0.0f, M5 = 1.0f, M9 = 0.0f, M13 = 0.0f, M2 = 0.0f, M6 = 0.0f, M10 = 1.0f, M14 = 0.0f, M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f }; 

    stack mut f32 cosres = Cos(angle);
    stack mut f32 sinres = Sin(angle);

    result.M0 = cosres;
    result.M1 = sinres;
    result.M4 = -sinres;
    result.M5 = cosres;

    return result;
}

public inline finite law Matrix MatrixRotateXYZ(Vector3 angle)
{
stack mut Matrix result = new Matrix() { M0 = 1.0f, M4 = 0.0f, M8 = 0.0f, M12 = 0.0f, M1 = 0.0f, M5 = 1.0f, M9 = 0.0f, M13 = 0.0f, M2 = 0.0f, M6 = 0.0f, M10 = 1.0f, M14 = 0.0f, M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f }; 

    stack mut f32 cosz = Cos(-angle.Z);
    stack mut f32 sinz = Sin(-angle.Z);
    stack mut f32 cosy = Cos(-angle.Y);
    stack mut f32 siny = Sin(-angle.Y);
    stack mut f32 cosx = Cos(-angle.X);
    stack mut f32 sinx = Sin(-angle.X);

    result.M0 = cosz*cosy;
    result.M1 = (cosz*siny*sinx) - (sinz*cosx);
    result.M2 = (cosz*siny*cosx) + (sinz*sinx);

    result.M4 = sinz*cosy;
    result.M5 = (sinz*siny*sinx) + (cosz*cosx);
    result.M6 = (sinz*siny*cosx) - (cosz*sinx);

    result.M8 = -siny;
    result.M9 = cosy*sinx;
    result.M10= cosy*cosx;

    return result;
}

public inline finite law Matrix MatrixRotateZYX(Vector3 angle)
{
stack mut Matrix result = DefaultMatrix();

    stack mut f32 cz = Cos(angle.Z);
    stack mut f32 sz = Sin(angle.Z);
    stack mut f32 cy = Cos(angle.Y);
    stack mut f32 sy = Sin(angle.Y);
    stack mut f32 cx = Cos(angle.X);
    stack mut f32 sx = Sin(angle.X);

    result.M0 = cz*cy;
    result.M4 = cz*sy*sx - cx*sz;
    result.M8 = sz*sx + cz*cx*sy;
    result.M12 = 0;

    result.M1 = cy*sz;
    result.M5 = cz*cx + sz*sy*sx;
    result.M9 = cx*sz*sy - cz*sx;
    result.M13 = 0;

    result.M2 = -sy;
    result.M6 = cy*sx;
    result.M10 = cy*cx;
    result.M14 = 0;

    result.M3 = 0;
    result.M7 = 0;
    result.M11 = 0;
    result.M15 = 1;

    return result;
}

public inline finite law Matrix MatrixScale(f32 x, f32 y, f32 z)
{
stack mut Matrix result = new Matrix() { M0 = x, M4 = 0.0f, M8 = 0.0f, M12 = 0.0f, M1 = 0.0f, M5 = y, M9 = 0.0f, M13 = 0.0f, M2 = 0.0f, M6 = 0.0f, M10 = z, M14 = 0.0f, M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f };

    return result;
}

public inline finite law Matrix MatrixFrustum(f64 left, f64 right, f64 bottom, f64 top, f64 nearPlane, f64 farPlane)
{
stack mut Matrix result = DefaultMatrix();

    stack mut f32 rl = (f32)(right - left);
    stack mut f32 tb = (f32)(top - bottom);
    stack mut f32 farNear = (f32)(farPlane - nearPlane);

    result.M0 = ((f32)nearPlane*2.0f)/rl;
    result.M1 = 0.0f;
    result.M2 = 0.0f;
    result.M3 = 0.0f;

    result.M4 = 0.0f;
    result.M5 = ((f32)nearPlane*2.0f)/tb;
    result.M6 = 0.0f;
    result.M7 = 0.0f;

    result.M8 = ((f32)right + (f32)left)/rl;
    result.M9 = ((f32)top + (f32)bottom)/tb;
    result.M10 = -((f32)farPlane + (f32)nearPlane)/farNear;
    result.M11 = -1.0f;

    result.M12 = 0.0f;
    result.M13 = 0.0f;
    result.M14 = -((f32)farPlane*(f32)nearPlane*2.0f)/farNear;
    result.M15 = 0.0f;

    return result;
}

public inline finite law Matrix MatrixPerspective(f64 fovY, f64 aspect, f64 nearPlane, f64 farPlane)
{
stack mut Matrix result = DefaultMatrix();

    stack mut f64 top = nearPlane*Tan(fovY*0.5);
    stack mut f64 bottom = -top;
    stack mut f64 right = top*aspect;
    stack mut f64 left = -right;

    
    stack mut f32 rl = (f32)(right - left);
    stack mut f32 tb = (f32)(top - bottom);
    stack mut f32 farNear = (f32)(farPlane - nearPlane);

    result.M0 = ((f32)nearPlane*2.0f)/rl;
    result.M5 = ((f32)nearPlane*2.0f)/tb;
    result.M8 = ((f32)right + (f32)left)/rl;
    result.M9 = ((f32)top + (f32)bottom)/tb;
    result.M10 = -((f32)farPlane + (f32)nearPlane)/farNear;
    result.M11 = -1.0f;
    result.M14 = -((f32)farPlane*(f32)nearPlane*2.0f)/farNear;

    return result;
}

public inline finite law Matrix MatrixOrtho(f64 left, f64 right, f64 bottom, f64 top, f64 nearPlane, f64 farPlane)
{
stack mut Matrix result = DefaultMatrix();

    stack mut f32 rl = (f32)(right - left);
    stack mut f32 tb = (f32)(top - bottom);
    stack mut f32 farNear = (f32)(farPlane - nearPlane);

    result.M0 = 2.0f/rl;
    result.M1 = 0.0f;
    result.M2 = 0.0f;
    result.M3 = 0.0f;
    result.M4 = 0.0f;
    result.M5 = 2.0f/tb;
    result.M6 = 0.0f;
    result.M7 = 0.0f;
    result.M8 = 0.0f;
    result.M9 = 0.0f;
    result.M10 = -2.0f/farNear;
    result.M11 = 0.0f;
    result.M12 = -((f32)left + (f32)right)/rl;
    result.M13 = -((f32)top + (f32)bottom)/tb;
    result.M14 = -((f32)farPlane + (f32)nearPlane)/farNear;
    result.M15 = 1.0f;

    return result;
}

public inline finite law Matrix MatrixLookAt(Vector3 eye, Vector3 target, Vector3 up)
{
stack mut Matrix result = DefaultMatrix();

    stack mut f32 length = 0.0f;
    stack mut f32 ilength = 0.0f;

    
    stack mut Vector3 vz = new Vector3() { X = eye.X - target.X, Y = eye.Y - target.Y, Z = eye.Z - target.Z };

    
    stack mut Vector3 v = vz;
    length = Sqrt(v.X*v.X + v.Y*v.Y + v.Z*v.Z);
    if (length == 0.0f) length = 1.0f;
    ilength = 1.0f/length;
    vz.X *= ilength;
    vz.Y *= ilength;
    vz.Z *= ilength;

    
    stack mut Vector3 vx = new Vector3() { X = up.Y*vz.Z - up.Z*vz.Y, Y = up.Z*vz.X - up.X*vz.Z, Z = up.X*vz.Y - up.Y*vz.X };

    
    v = vx;
    length = Sqrt(v.X*v.X + v.Y*v.Y + v.Z*v.Z);
    if (length == 0.0f) length = 1.0f;
    ilength = 1.0f/length;
    vx.X *= ilength;
    vx.Y *= ilength;
    vx.Z *= ilength;

    
    stack mut Vector3 vy = new Vector3() { X = vz.Y*vx.Z - vz.Z*vx.Y, Y = vz.Z*vx.X - vz.X*vx.Z, Z = vz.X*vx.Y - vz.Y*vx.X };

    result.M0 = vx.X;
    result.M1 = vy.X;
    result.M2 = vz.X;
    result.M3 = 0.0f;
    result.M4 = vx.Y;
    result.M5 = vy.Y;
    result.M6 = vz.Y;
    result.M7 = 0.0f;
    result.M8 = vx.Z;
    result.M9 = vy.Z;
    result.M10 = vz.Z;
    result.M11 = 0.0f;
    result.M12 = -(vx.X*eye.X + vx.Y*eye.Y + vx.Z*eye.Z);   
    result.M13 = -(vy.X*eye.X + vy.Y*eye.Y + vy.Z*eye.Z);   
    result.M14 = -(vz.X*eye.X + vz.Y*eye.Y + vz.Z*eye.Z);   
    result.M15 = 1.0f;

    return result;
}

public inline finite law Float16 MatrixToFloatV(Matrix mat)
{
stack mut Float16 result = DefaultFloat16();

    result.V[0] = mat.M0;
    result.V[1] = mat.M1;
    result.V[2] = mat.M2;
    result.V[3] = mat.M3;
    result.V[4] = mat.M4;
    result.V[5] = mat.M5;
    result.V[6] = mat.M6;
    result.V[7] = mat.M7;
    result.V[8] = mat.M8;
    result.V[9] = mat.M9;
    result.V[10] = mat.M10;
    result.V[11] = mat.M11;
    result.V[12] = mat.M12;
    result.V[13] = mat.M13;
    result.V[14] = mat.M14;
    result.V[15] = mat.M15;

    return result;
}

public inline finite law Quaternion QuaternionAdd(Quaternion q1, Quaternion q2)
{
stack mut Quaternion result = new Quaternion() { X = q1.X + q2.X, Y = q1.Y + q2.Y, Z = q1.Z + q2.Z, W = q1.W + q2.W };

    return result;
}

public inline finite law Quaternion QuaternionAddValue(Quaternion q, f32 add)
{
stack mut Quaternion result = new Quaternion() { X = q.X + add, Y = q.Y + add, Z = q.Z + add, W = q.W + add };

    return result;
}

public inline finite law Quaternion QuaternionSubtract(Quaternion q1, Quaternion q2)
{
stack mut Quaternion result = new Quaternion() { X = q1.X - q2.X, Y = q1.Y - q2.Y, Z = q1.Z - q2.Z, W = q1.W - q2.W };

    return result;
}

public inline finite law Quaternion QuaternionSubtractValue(Quaternion q, f32 sub)
{
stack mut Quaternion result = new Quaternion() { X = q.X - sub, Y = q.Y - sub, Z = q.Z - sub, W = q.W - sub };

    return result;
}

public inline finite law Quaternion QuaternionIdentity()
{
stack mut Quaternion result = new Quaternion() { X = 0.0f, Y = 0.0f, Z = 0.0f, W = 1.0f };

    return result;
}

public inline finite law f32 QuaternionLength(Quaternion q)
{
stack mut f32 result = Sqrt(q.X*q.X + q.Y*q.Y + q.Z*q.Z + q.W*q.W);

    return result;
}

public inline finite law Quaternion QuaternionNormalize(Quaternion q)
{
stack mut Quaternion result = DefaultQuaternion();

    stack mut f32 length = Sqrt(q.X*q.X + q.Y*q.Y + q.Z*q.Z + q.W*q.W);
    if (length == 0.0f) length = 1.0f;
    stack mut f32 ilength = 1.0f/length;

    result.X = q.X*ilength;
    result.Y = q.Y*ilength;
    result.Z = q.Z*ilength;
    result.W = q.W*ilength;

    return result;
}

public inline finite law Quaternion QuaternionInvert(Quaternion q)
{
stack mut Quaternion result = q;

    stack mut f32 lengthSq = q.X*q.X + q.Y*q.Y + q.Z*q.Z + q.W*q.W;

    if (lengthSq != 0.0f)
    {
        stack mut f32 invLength = 1.0f/lengthSq;

        result.X *= -invLength;
        result.Y *= -invLength;
        result.Z *= -invLength;
        result.W *= invLength;
    }

    return result;
}

public inline finite law Quaternion QuaternionMultiply(Quaternion q1, Quaternion q2)
{
stack mut Quaternion result = DefaultQuaternion();

    stack mut f32 qax = q1.X;

    stack mut f32 qay = q1.Y;

    stack mut f32 qaz = q1.Z;

    stack mut f32 qaw = q1.W;
    stack mut f32 qbx = q2.X;
    stack mut f32 qby = q2.Y;
    stack mut f32 qbz = q2.Z;
    stack mut f32 qbw = q2.W;

    result.X = qax*qbw + qaw*qbx + qay*qbz - qaz*qby;
    result.Y = qay*qbw + qaw*qby + qaz*qbx - qax*qbz;
    result.Z = qaz*qbw + qaw*qbz + qax*qby - qay*qbx;
    result.W = qaw*qbw - qax*qbx - qay*qby - qaz*qbz;

    return result;
}

public inline finite law Quaternion QuaternionScale(Quaternion q, f32 mul)
{
stack mut Quaternion result = DefaultQuaternion();

    result.X = q.X*mul;
    result.Y = q.Y*mul;
    result.Z = q.Z*mul;
    result.W = q.W*mul;

    return result;
}

public inline finite law Quaternion QuaternionDivide(Quaternion q1, Quaternion q2)
{
stack mut Quaternion result = new Quaternion() { X = q1.X/q2.X, Y = q1.Y/q2.Y, Z = q1.Z/q2.Z, W = q1.W/q2.W };

    return result;
}

public inline finite law Quaternion QuaternionLerp(Quaternion q1, Quaternion q2, f32 amount)
{
stack mut Quaternion result = DefaultQuaternion();

    result.X = q1.X + amount*(q2.X - q1.X);
    result.Y = q1.Y + amount*(q2.Y - q1.Y);
    result.Z = q1.Z + amount*(q2.Z - q1.Z);
    result.W = q1.W + amount*(q2.W - q1.W);

    return result;
}

public inline finite law Quaternion QuaternionNlerp(Quaternion q1, Quaternion q2, f32 amount)
{
stack mut Quaternion result = DefaultQuaternion();

    
    result.X = q1.X + amount*(q2.X - q1.X);
    result.Y = q1.Y + amount*(q2.Y - q1.Y);
    result.Z = q1.Z + amount*(q2.Z - q1.Z);
    result.W = q1.W + amount*(q2.W - q1.W);

    
    stack mut Quaternion q = result;
    stack mut f32 length = Sqrt(q.X*q.X + q.Y*q.Y + q.Z*q.Z + q.W*q.W);
    if (length == 0.0f) length = 1.0f;
    stack mut f32 ilength = 1.0f/length;

    result.X = q.X*ilength;
    result.Y = q.Y*ilength;
    result.Z = q.Z*ilength;
    result.W = q.W*ilength;

    return result;
}

public inline finite law Quaternion QuaternionSlerp(Quaternion q1, Quaternion q2, f32 amount)
{
    stack mut Quaternion result = DefaultQuaternion();
    stack mut Quaternion target = q2;
    stack mut f32 cosHalfTheta = q1.X * target.X + q1.Y * target.Y + q1.Z * target.Z + q1.W * target.W;
    if (cosHalfTheta < 0.0f)
    {
        target.X = -target.X;
        target.Y = -target.Y;
        target.Z = -target.Z;
        target.W = -target.W;
        cosHalfTheta = -cosHalfTheta;
    }

    if (AbsF32(cosHalfTheta) >= 1.0f)
    {
        result = q1;
    }
    else if (cosHalfTheta > 0.95f)
    {
        result = QuaternionNlerp(q1, target, amount);
    }
    else
    {
        stack f32 halfTheta = Acos(cosHalfTheta);
        stack f32 sinHalfTheta = Sqrt(1.0f - cosHalfTheta * cosHalfTheta);
        if (AbsF32(sinHalfTheta) < RAYMATH_EPSILON)
        {
            result.X = q1.X * 0.5f + target.X * 0.5f;
            result.Y = q1.Y * 0.5f + target.Y * 0.5f;
            result.Z = q1.Z * 0.5f + target.Z * 0.5f;
            result.W = q1.W * 0.5f + target.W * 0.5f;
        }
        else
        {
            stack f32 ratioA = Sin((1.0f - amount) * halfTheta) / sinHalfTheta;
            stack f32 ratioB = Sin(amount * halfTheta) / sinHalfTheta;
            result.X = q1.X * ratioA + target.X * ratioB;
            result.Y = q1.Y * ratioA + target.Y * ratioB;
            result.Z = q1.Z * ratioA + target.Z * ratioB;
            result.W = q1.W * ratioA + target.W * ratioB;
        }
    }

    return result;
}

public inline finite law Quaternion QuaternionCubicHermiteSpline(Quaternion q1, Quaternion outTangent1, Quaternion q2, Quaternion inTangent2, f32 t)
{
stack mut f32 t2 = t*t;
    stack mut f32 t3 = t2*t;
    stack mut f32 h00 = 2*t3 - 3*t2 + 1;
    stack mut f32 h10 = t3 - 2*t2 + t;
    stack mut f32 h01 = -2*t3 + 3*t2;
    stack mut f32 h11 = t3 - t2;

    stack mut Quaternion p0 = QuaternionScale(q1, h00);
    stack mut Quaternion m0 = QuaternionScale(outTangent1, h10);
    stack mut Quaternion p1 = QuaternionScale(q2, h01);
    stack mut Quaternion m1 = QuaternionScale(inTangent2, h11);

    stack mut Quaternion result = DefaultQuaternion();

    result = QuaternionAdd(p0, m0);
    result = QuaternionAdd(result, p1);
    result = QuaternionAdd(result, m1);
    result = QuaternionNormalize(result);

    return result;
}

public inline finite law Quaternion QuaternionFromVector3ToVector3(Vector3 source, Vector3 target)
{
stack mut Quaternion result = DefaultQuaternion();

    stack mut f32 cos2Theta = (source.X*target.X + source.Y*target.Y + source.Z*target.Z); 
    stack mut Vector3 cross = new Vector3() { X = source.Y*target.Z - source.Z*target.Y, Y = source.Z*target.X - source.X*target.Z, Z = source.X*target.Y - source.Y*target.X }; 

    result.X = cross.X;
    result.Y = cross.Y;
    result.Z = cross.Z;
    result.W = Sqrt(cross.X*cross.X + cross.Y*cross.Y + cross.Z*cross.Z + cos2Theta*cos2Theta) + cos2Theta;

    
    
    stack mut Quaternion q = result;
    stack mut f32 length = Sqrt(q.X*q.X + q.Y*q.Y + q.Z*q.Z + q.W*q.W);
    if (length == 0.0f) length = 1.0f;
    stack mut f32 ilength = 1.0f/length;

    result.X = q.X*ilength;
    result.Y = q.Y*ilength;
    result.Z = q.Z*ilength;
    result.W = q.W*ilength;

    return result;
}

public inline finite law Quaternion QuaternionFromMatrix(Matrix mat)
{
stack mut Quaternion result = DefaultQuaternion();

    stack mut f32 fourWSquaredMinus1 = mat.M0  + mat.M5 + mat.M10;
    stack mut f32 fourXSquaredMinus1 = mat.M0  - mat.M5 - mat.M10;
    stack mut f32 fourYSquaredMinus1 = mat.M5  - mat.M0 - mat.M10;
    stack mut f32 fourZSquaredMinus1 = mat.M10 - mat.M0 - mat.M5;

    stack mut i32[min max] biggestIndex = 0;
    stack mut f32 fourBiggestSquaredMinus1 = fourWSquaredMinus1;
    if (fourXSquaredMinus1 > fourBiggestSquaredMinus1)
    {
        fourBiggestSquaredMinus1 = fourXSquaredMinus1;
        biggestIndex = 1;
    }

    if (fourYSquaredMinus1 > fourBiggestSquaredMinus1)
    {
        fourBiggestSquaredMinus1 = fourYSquaredMinus1;
        biggestIndex = 2;
    }

    if (fourZSquaredMinus1 > fourBiggestSquaredMinus1)
    {
        fourBiggestSquaredMinus1 = fourZSquaredMinus1;
        biggestIndex = 3;
    }

    stack mut f32 biggestVal = Sqrt(fourBiggestSquaredMinus1 + 1.0f)*0.5f;
    stack mut f32 mult = 0.25f/biggestVal;

    switch (biggestIndex)
    {
        case 0:
            result.W = biggestVal;
            result.X = (mat.M6 - mat.M9)*mult;
            result.Y = (mat.M8 - mat.M2)*mult;
            result.Z = (mat.M1 - mat.M4)*mult;
            break;
        case 1:
            result.X = biggestVal;
            result.W = (mat.M6 - mat.M9)*mult;
            result.Y = (mat.M1 + mat.M4)*mult;
            result.Z = (mat.M8 + mat.M2)*mult;
            break;
        case 2:
            result.Y = biggestVal;
            result.W = (mat.M8 - mat.M2)*mult;
            result.X = (mat.M1 + mat.M4)*mult;
            result.Z = (mat.M6 + mat.M9)*mult;
            break;
        case 3:
            result.Z = biggestVal;
            result.W = (mat.M1 - mat.M4)*mult;
            result.X = (mat.M8 + mat.M2)*mult;
            result.Y = (mat.M6 + mat.M9)*mult;
            break;
        default:
            break;
    }

    return result;
}

public inline finite law Matrix QuaternionToMatrix(Quaternion q)
{
stack mut Matrix result = new Matrix() { M0 = 1.0f, M4 = 0.0f, M8 = 0.0f, M12 = 0.0f, M1 = 0.0f, M5 = 1.0f, M9 = 0.0f, M13 = 0.0f, M2 = 0.0f, M6 = 0.0f, M10 = 1.0f, M14 = 0.0f, M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f }; 

    stack mut f32 a2 = q.X*q.X;
    stack mut f32 b2 = q.Y*q.Y;
    stack mut f32 c2 = q.Z*q.Z;
    stack mut f32 ac = q.X*q.Z;
    stack mut f32 ab = q.X*q.Y;
    stack mut f32 bc = q.Y*q.Z;
    stack mut f32 ad = q.W*q.X;
    stack mut f32 bd = q.W*q.Y;
    stack mut f32 cd = q.W*q.Z;

    result.M0 = 1 - 2*(b2 + c2);
    result.M1 = 2*(ab + cd);
    result.M2 = 2*(ac - bd);

    result.M4 = 2*(ab - cd);
    result.M5 = 1 - 2*(a2 + c2);
    result.M6 = 2*(bc + ad);

    result.M8 = 2*(ac + bd);
    result.M9 = 2*(bc - ad);
    result.M10 = 1 - 2*(a2 + b2);

    return result;
}

public inline finite law Quaternion QuaternionFromAxisAngle(Vector3 axis, f32 angle)
{
    stack mut Quaternion result = new Quaternion() { X = 0.0f, Y = 0.0f, Z = 0.0f, W = 1.0f };
    stack f32 length = Sqrt(axis.X * axis.X + axis.Y * axis.Y + axis.Z * axis.Z);
    if (length != 0.0f)
    {
        stack f32 halfAngle = angle * 0.5f;
        stack f32 ilength = 1.0f / length;
        stack Vector3 normalizedAxis = new Vector3() { X = axis.X * ilength, Y = axis.Y * ilength, Z = axis.Z * ilength };
        stack f32 sinres = Sin(halfAngle);
        stack f32 cosres = Cos(halfAngle);
        result.X = normalizedAxis.X * sinres;
        result.Y = normalizedAxis.Y * sinres;
        result.Z = normalizedAxis.Z * sinres;
        result.W = cosres;
        result = QuaternionNormalize(result);
    }

    return result;
}

public inline finite law QuaternionAxisAngle QuaternionToAxisAngle(Quaternion q)
{
    stack mut Quaternion normalized = q;
    if (AbsF32(normalized.W) > 1.0f)
    {
        normalized = QuaternionNormalize(normalized);
    }

    stack mut Vector3 axis = Vector3Zero();
    stack f32 angle = 2.0f * Acos(normalized.W);
    stack f32 den = Sqrt(1.0f - normalized.W * normalized.W);
    if (den > RAYMATH_EPSILON)
    {
        axis.X = normalized.X / den;
        axis.Y = normalized.Y / den;
        axis.Z = normalized.Z / den;
    }
    else
    {
        axis.X = 1.0f;
    }

    return new QuaternionAxisAngle() { Axis = axis, Angle = angle };
}

public inline finite law Quaternion QuaternionFromEuler(f32 pitch, f32 yaw, f32 roll)
{
stack mut Quaternion result = DefaultQuaternion();

    stack mut f32 x0 = Cos(pitch*0.5f);
    stack mut f32 x1 = Sin(pitch*0.5f);
    stack mut f32 y0 = Cos(yaw*0.5f);
    stack mut f32 y1 = Sin(yaw*0.5f);
    stack mut f32 z0 = Cos(roll*0.5f);
    stack mut f32 z1 = Sin(roll*0.5f);

    result.X = x1*y0*z0 - x0*y1*z1;
    result.Y = x0*y1*z0 + x1*y0*z1;
    result.Z = x0*y0*z1 - x1*y1*z0;
    result.W = x0*y0*z0 + x1*y1*z1;

    return result;
}

public inline finite law Vector3 QuaternionToEuler(Quaternion q)
{
stack mut Vector3 result = DefaultVector3();

    
    stack mut f32 x0 = 2.0f*(q.W*q.X + q.Y*q.Z);
    stack mut f32 x1 = 1.0f - 2.0f*(q.X*q.X + q.Y*q.Y);
    result.X = Atan2(x0, x1);

    
    stack mut f32 y0 = 2.0f*(q.W*q.Y - q.Z*q.X);
    y0 = y0 > 1.0f ? 1.0f : y0;
    y0 = y0 < -1.0f ? -1.0f : y0;
    result.Y = Asin(y0);

    
    stack mut f32 z0 = 2.0f*(q.W*q.Z + q.X*q.Y);
    stack mut f32 z1 = 1.0f - 2.0f*(q.Y*q.Y + q.Z*q.Z);
    result.Z = Atan2(z0, z1);

    return result;
}

public inline finite law Quaternion QuaternionTransform(Quaternion q, Matrix mat)
{
stack mut Quaternion result = DefaultQuaternion();

    result.X = mat.M0*q.X + mat.M4*q.Y + mat.M8*q.Z + mat.M12*q.W;
    result.Y = mat.M1*q.X + mat.M5*q.Y + mat.M9*q.Z + mat.M13*q.W;
    result.Z = mat.M2*q.X + mat.M6*q.Y + mat.M10*q.Z + mat.M14*q.W;
    result.W = mat.M3*q.X + mat.M7*q.Y + mat.M11*q.Z + mat.M15*q.W;

    return result;
}

public inline finite law bool QuaternionEquals(Quaternion p, Quaternion q)
{
stack mut bool result = (((AbsF32(p.X - q.X)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.X), AbsF32(q.X))))) &&
                  ((AbsF32(p.Y - q.Y)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.Y), AbsF32(q.Y))))) &&
                  ((AbsF32(p.Z - q.Z)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.Z), AbsF32(q.Z))))) &&
                  ((AbsF32(p.W - q.W)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.W), AbsF32(q.W)))))) ||
                 (((AbsF32(p.X + q.X)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.X), AbsF32(q.X))))) &&
                  ((AbsF32(p.Y + q.Y)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.Y), AbsF32(q.Y))))) &&
                  ((AbsF32(p.Z + q.Z)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.Z), AbsF32(q.Z))))) &&
                  ((AbsF32(p.W + q.W)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.W), AbsF32(q.W))))));

    return result;
}

public inline finite law Matrix MatrixCompose(Vector3 translation, Quaternion rotation, Vector3 scale)
{
stack mut Vector3 right = new Vector3() { X = 1.0f, Y = 0.0f, Z = 0.0f };
    stack mut Vector3 up = new Vector3() { X = 0.0f, Y = 1.0f, Z = 0.0f };
    stack mut Vector3 forward = new Vector3() { X = 0.0f, Y = 0.0f, Z = 1.0f };

    
    right = Vector3Scale(right, scale.X);
    up = Vector3Scale(up, scale.Y);
    forward = Vector3Scale(forward , scale.Z);

    
    right = Vector3RotateByQuaternion(right, rotation);
    up = Vector3RotateByQuaternion(up, rotation);
    forward = Vector3RotateByQuaternion(forward, rotation);

    
    stack mut Matrix result = new Matrix() { M0 = right.X, M4 = up.X, M8 = forward.X, M12 = translation.X, M1 = right.Y, M5 = up.Y, M9 = forward.Y, M13 = translation.Y, M2 = right.Z, M6 = up.Z, M10 = forward.Z, M14 = translation.Z, M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f };

    return result;
}

public inline finite law MatrixDecomposeResult MatrixDecompose(Matrix mat)
{
    stack f32 eps = 0.000000001f;
    stack Vector3 translation = new Vector3() { X = mat.M12, Y = mat.M13, Z = mat.M14 };
    stack mut Vector3 col0 = new Vector3() { X = mat.M0, Y = mat.M4, Z = mat.M8 };
    stack mut Vector3 col1 = new Vector3() { X = mat.M1, Y = mat.M5, Z = mat.M9 };
    stack mut Vector3 col2 = new Vector3() { X = mat.M2, Y = mat.M6, Z = mat.M10 };
    stack mut Vector3 scale = Vector3Zero();
    stack mut f32 shear0 = 0.0f;
    stack mut f32 shear1 = 0.0f;
    stack mut f32 shear2 = 0.0f;

    stack mut f32 stabilizer = eps;
    stabilizer = Max(stabilizer, AbsF32(col0.X));
    stabilizer = Max(stabilizer, AbsF32(col0.Y));
    stabilizer = Max(stabilizer, AbsF32(col0.Z));
    stabilizer = Max(stabilizer, AbsF32(col1.X));
    stabilizer = Max(stabilizer, AbsF32(col1.Y));
    stabilizer = Max(stabilizer, AbsF32(col1.Z));
    stabilizer = Max(stabilizer, AbsF32(col2.X));
    stabilizer = Max(stabilizer, AbsF32(col2.Y));
    stabilizer = Max(stabilizer, AbsF32(col2.Z));

    col0 = Vector3Scale(col0, 1.0f / stabilizer);
    col1 = Vector3Scale(col1, 1.0f / stabilizer);
    col2 = Vector3Scale(col2, 1.0f / stabilizer);

    scale.X = Vector3Length(col0);
    if (scale.X > eps) { col0 = Vector3Scale(col0, 1.0f / scale.X); }
    shear0 = Vector3DotProduct(col0, col1);
    col1 = Vector3Subtract(col1, Vector3Scale(col0, shear0));
    scale.Y = Vector3Length(col1);
    if (scale.Y > eps) { col1 = Vector3Scale(col1, 1.0f / scale.Y); shear0 /= scale.Y; }
    shear1 = Vector3DotProduct(col0, col2);
    col2 = Vector3Subtract(col2, Vector3Scale(col0, shear1));
    shear2 = Vector3DotProduct(col1, col2);
    col2 = Vector3Subtract(col2, Vector3Scale(col1, shear2));
    scale.Z = Vector3Length(col2);
    if (scale.Z > eps) { col2 = Vector3Scale(col2, 1.0f / scale.Z); shear1 /= scale.Z; shear2 /= scale.Z; }

    stack f32 det = Vector3DotProduct(col0, Vector3CrossProduct(col1, col2));
    if (det < 0.0f)
    {
        scale.X = -scale.X;
        scale.Y = -scale.Y;
        scale.Z = -scale.Z;
        col0 = Vector3Negate(col0);
        col1 = Vector3Negate(col1);
        col2 = Vector3Negate(col2);
    }

    scale = Vector3Scale(scale, stabilizer);
    stack Matrix rotationMatrix = new Matrix()
    {
        M0 = col0.X, M4 = col0.Y, M8 = col0.Z, M12 = 0.0f,
        M1 = col1.X, M5 = col1.Y, M9 = col1.Z, M13 = 0.0f,
        M2 = col2.X, M6 = col2.Y, M10 = col2.Z, M14 = 0.0f,
        M3 = 0.0f, M7 = 0.0f, M11 = 0.0f, M15 = 1.0f
    };
    stack Quaternion rotation = QuaternionFromMatrix(rotationMatrix);
    return new MatrixDecomposeResult() { Translation = translation, Rotation = rotation, Scale = scale };
}
