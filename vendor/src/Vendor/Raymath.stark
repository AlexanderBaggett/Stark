}

public inline finite law Vector3 Vector3Multiply(Vector3 v1, Vector3 v2)
{
stack mut Vector3 result = new Vector3() { X = v1.X*v2.X, Y = v1.Y*v2.Y, Z = v1.Z*v2.Z };

    return result;
}

public inline finite law Vector3 Vector3CrossProduct(Vector3 v1, Vector3 v2)
{
stack mut Vector3 result = new Vector3() { X = v1.Y*v2.Z - v1.Z*v2.Y, Y = v1.Z*v2.X - v1.X*v2.Z, Z = v1.X*v2.Y - v1.Y*v2.X };

    return result;
}

public inline finite law Vector3 Vector3Perpendicular(Vector3 v)
{
stack mut Vector3 result = DefaultVector3();

    stack mut f32 min = AbsF32(v.X);
    stack mut Vector3 cardinalAxis = new Vector3() { X = 1.0f, Y = 0.0f, Z = 0.0f };

    if (AbsF32(v.Y) < min)
    {
        min = AbsF32(v.Y);
        stack mut Vector3 tmp = new Vector3() { X = 0.0f, Y = 1.0f, Z = 0.0f };
        cardinalAxis = tmp;
    }

    if (AbsF32(v.Z) < min)
    {
        stack mut Vector3 tmp = new Vector3() { X = 0.0f, Y = 0.0f, Z = 1.0f };
        cardinalAxis = tmp;
    }

    
    result.X = v.Y*cardinalAxis.Z - v.Z*cardinalAxis.Y;
    result.Y = v.Z*cardinalAxis.X - v.X*cardinalAxis.Z;
    result.Z = v.X*cardinalAxis.Y - v.Y*cardinalAxis.X;

    return result;
}

public inline finite law f32 Vector3Length(Vector3 v)
{
stack mut f32 result = Sqrt(v.X*v.X + v.Y*v.Y + v.Z*v.Z);

    return result;
}

public inline finite law f32 Vector3LengthSqr(Vector3 v)
{
stack mut f32 result = v.X*v.X + v.Y*v.Y + v.Z*v.Z;

    return result;
}

public inline finite law f32 Vector3DotProduct(Vector3 v1, Vector3 v2)
{
stack mut f32 result = (v1.X*v2.X + v1.Y*v2.Y + v1.Z*v2.Z);

    return result;
}

public inline finite law f32 Vector3Distance(Vector3 v1, Vector3 v2)
{
stack mut f32 result = 0.0f;

    stack mut f32 dx = v2.X - v1.X;
    stack mut f32 dy = v2.Y - v1.Y;
    stack mut f32 dz = v2.Z - v1.Z;
    result = Sqrt(dx*dx + dy*dy + dz*dz);

    return result;
}

public inline finite law f32 Vector3DistanceSqr(Vector3 v1, Vector3 v2)
{
stack mut f32 result = 0.0f;

    stack mut f32 dx = v2.X - v1.X;
    stack mut f32 dy = v2.Y - v1.Y;
    stack mut f32 dz = v2.Z - v1.Z;
    result = dx*dx + dy*dy + dz*dz;

    return result;
}

public inline finite law f32 Vector3Angle(Vector3 v1, Vector3 v2)
{
stack mut f32 result = 0.0f;

    stack mut Vector3 cross = new Vector3() { X = v1.Y*v2.Z - v1.Z*v2.Y, Y = v1.Z*v2.X - v1.X*v2.Z, Z = v1.X*v2.Y - v1.Y*v2.X };
    stack mut f32 len = Sqrt(cross.X*cross.X + cross.Y*cross.Y + cross.Z*cross.Z);
    stack mut f32 dot = (v1.X*v2.X + v1.Y*v2.Y + v1.Z*v2.Z);
    result = Atan2(len, dot);

    return result;
}

public inline finite law Vector3 Vector3Negate(Vector3 v)
{
stack mut Vector3 result = new Vector3() { X = -v.X, Y = -v.Y, Z = -v.Z };

    return result;
}

public inline finite law Vector3 Vector3Divide(Vector3 v1, Vector3 v2)
{
stack mut Vector3 result = new Vector3() { X = v1.X/v2.X, Y = v1.Y/v2.Y, Z = v1.Z/v2.Z };

    return result;
}

public inline finite law Vector3 Vector3Normalize(Vector3 v)
{
stack mut Vector3 result = v;

    stack mut f32 length = Sqrt(v.X*v.X + v.Y*v.Y + v.Z*v.Z);
    if (length != 0.0f)
    {
        stack mut f32 ilength = 1.0f/length;

        result.X *= ilength;
        result.Y *= ilength;
        result.Z *= ilength;
    }

    return result;
}

public inline finite law Vector3 Vector3Project(Vector3 v1, Vector3 v2)
{
stack mut Vector3 result = DefaultVector3();

    stack mut f32 v1dv2 = (v1.X*v2.X + v1.Y*v2.Y + v1.Z*v2.Z);
    stack mut f32 v2dv2 = (v2.X*v2.X + v2.Y*v2.Y + v2.Z*v2.Z);

    stack mut f32 mag = v1dv2/v2dv2;

    result.X = v2.X*mag;
    result.Y = v2.Y*mag;
    result.Z = v2.Z*mag;

    return result;
}

public inline finite law Vector3 Vector3Reject(Vector3 v1, Vector3 v2)
{
stack mut Vector3 result = DefaultVector3();

    stack mut f32 v1dv2 = (v1.X*v2.X + v1.Y*v2.Y + v1.Z*v2.Z);
    stack mut f32 v2dv2 = (v2.X*v2.X + v2.Y*v2.Y + v2.Z*v2.Z);

    stack mut f32 mag = v1dv2/v2dv2;

    result.X = v1.X - (v2.X*mag);
    result.Y = v1.Y - (v2.Y*mag);
    result.Z = v1.Z - (v2.Z*mag);

    return result;
}

public inline finite law Vector3Pair Vector3OrthoNormalize(Vector3 v1, Vector3 v2)
{
    stack mut Vector3 first = Vector3Normalize(v1);
    stack Vector3 vn1 = Vector3Normalize(Vector3CrossProduct(first, v2));
    stack Vector3 second = Vector3CrossProduct(vn1, first);
    return new Vector3Pair() { First = first, Second = second };
}

public inline finite law Vector3 Vector3Transform(Vector3 v, Matrix mat)
{
stack mut Vector3 result = DefaultVector3();

    stack mut f32 x = v.X;
    stack mut f32 y = v.Y;
    stack mut f32 z = v.Z;

    result.X = mat.M0*x + mat.M4*y + mat.M8*z + mat.M12;
    result.Y = mat.M1*x + mat.M5*y + mat.M9*z + mat.M13;
    result.Z = mat.M2*x + mat.M6*y + mat.M10*z + mat.M14;

    return result;
}

public inline finite law Vector3 Vector3RotateByQuaternion(Vector3 v, Quaternion q)
{
stack mut Vector3 result = DefaultVector3();

    result.X = v.X*(q.X*q.X + q.W*q.W - q.Y*q.Y - q.Z*q.Z) + v.Y*(2*q.X*q.Y - 2*q.W*q.Z) + v.Z*(2*q.X*q.Z + 2*q.W*q.Y);
    result.Y = v.X*(2*q.W*q.Z + 2*q.X*q.Y) + v.Y*(q.W*q.W - q.X*q.X + q.Y*q.Y - q.Z*q.Z) + v.Z*(-2*q.W*q.X + 2*q.Y*q.Z);
    result.Z = v.X*(-2*q.W*q.Y + 2*q.X*q.Z) + v.Y*(2*q.W*q.X + 2*q.Y*q.Z)+ v.Z*(q.W*q.W - q.X*q.X - q.Y*q.Y + q.Z*q.Z);

    return result;
}

public inline finite law Vector3 Vector3RotateByAxisAngle(Vector3 v, Vector3 axis, f32 angle)
{
    stack mut Vector3 result = v;
    stack mut Vector3 normalizedAxis = axis;
    stack f32 length = Sqrt(axis.X * axis.X + axis.Y * axis.Y + axis.Z * axis.Z);
    if (length != 0.0f)
    {
        stack f32 ilength = 1.0f / length;
        normalizedAxis.X *= ilength;
        normalizedAxis.Y *= ilength;
        normalizedAxis.Z *= ilength;
    }

    stack f32 halfAngle = angle / 2.0f;
    stack mut f32 a = Sin(halfAngle);
    stack f32 b = normalizedAxis.X * a;
    stack f32 c = normalizedAxis.Y * a;
    stack f32 d = normalizedAxis.Z * a;
    a = Cos(halfAngle);

    stack Vector3 w = new Vector3() { X = b, Y = c, Z = d };
    stack mut Vector3 wv = Vector3CrossProduct(w, v);
    stack mut Vector3 wwv = Vector3CrossProduct(w, wv);
    wv = Vector3Scale(wv, 2.0f * a);
    wwv = Vector3Scale(wwv, 2.0f);

    result.X += wv.X + wwv.X;
    result.Y += wv.Y + wwv.Y;
    result.Z += wv.Z + wwv.Z;
    return result;
}

public inline finite law Vector3 Vector3MoveTowards(Vector3 v, Vector3 target, f32 maxDistance)
{
stack mut Vector3 result = DefaultVector3();

    stack mut f32 dx = target.X - v.X;
    stack mut f32 dy = target.Y - v.Y;
    stack mut f32 dz = target.Z - v.Z;
    stack mut f32 value = (dx*dx) + (dy*dy) + (dz*dz);

    if ((value == 0) || ((maxDistance >= 0) && (value <= maxDistance*maxDistance))) return target;

    stack mut f32 dist = Sqrt(value);

    result.X = v.X + dx/dist*maxDistance;
    result.Y = v.Y + dy/dist*maxDistance;
    result.Z = v.Z + dz/dist*maxDistance;

    return result;
}

public inline finite law Vector3 Vector3Lerp(Vector3 v1, Vector3 v2, f32 amount)
{
stack mut Vector3 result = DefaultVector3();

    result.X = v1.X + amount*(v2.X - v1.X);
    result.Y = v1.Y + amount*(v2.Y - v1.Y);
    result.Z = v1.Z + amount*(v2.Z - v1.Z);

    return result;
}

public inline finite law Vector3 Vector3CubicHermite(Vector3 v1, Vector3 tangent1, Vector3 v2, Vector3 tangent2, f32 amount)
{
stack mut Vector3 result = DefaultVector3();

    stack mut f32 amountPow2 = amount*amount;
    stack mut f32 amountPow3 = amount*amount*amount;

    result.X = (2*amountPow3 - 3*amountPow2 + 1)*v1.X + (amountPow3 - 2*amountPow2 + amount)*tangent1.X + (-2*amountPow3 + 3*amountPow2)*v2.X + (amountPow3 - amountPow2)*tangent2.X;
    result.Y = (2*amountPow3 - 3*amountPow2 + 1)*v1.Y + (amountPow3 - 2*amountPow2 + amount)*tangent1.Y + (-2*amountPow3 + 3*amountPow2)*v2.Y + (amountPow3 - amountPow2)*tangent2.Y;
    result.Z = (2*amountPow3 - 3*amountPow2 + 1)*v1.Z + (amountPow3 - 2*amountPow2 + amount)*tangent1.Z + (-2*amountPow3 + 3*amountPow2)*v2.Z + (amountPow3 - amountPow2)*tangent2.Z;

    return result;
}

public inline finite law Vector3 Vector3Reflect(Vector3 v, Vector3 normal)
{
stack mut Vector3 result = DefaultVector3();

    
    
    

    stack mut f32 dotProduct = (v.X*normal.X + v.Y*normal.Y + v.Z*normal.Z);

    result.X = v.X - (2.0f*normal.X)*dotProduct;
    result.Y = v.Y - (2.0f*normal.Y)*dotProduct;
    result.Z = v.Z - (2.0f*normal.Z)*dotProduct;

    return result;
}

public inline finite law Vector3 Vector3Min(Vector3 v1, Vector3 v2)
