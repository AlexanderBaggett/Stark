stack mut Vector3 result = DefaultVector3();

    result.X = Min(v1.X, v2.X);
    result.Y = Min(v1.Y, v2.Y);
    result.Z = Min(v1.Z, v2.Z);

    return result;
}

public inline finite law Vector3 Vector3Max(Vector3 v1, Vector3 v2)
{
stack mut Vector3 result = DefaultVector3();

    result.X = Max(v1.X, v2.X);
    result.Y = Max(v1.Y, v2.Y);
    result.Z = Max(v1.Z, v2.Z);

    return result;
}

public inline finite law Vector3 Vector3Barycenter(Vector3 p, Vector3 a, Vector3 b, Vector3 c)
{
stack mut Vector3 result = DefaultVector3();

    stack mut Vector3 v0 = new Vector3() { X = b.X - a.X, Y = b.Y - a.Y, Z = b.Z - a.Z };   
    stack mut Vector3 v1 = new Vector3() { X = c.X - a.X, Y = c.Y - a.Y, Z = c.Z - a.Z };   
    stack mut Vector3 v2 = new Vector3() { X = p.X - a.X, Y = p.Y - a.Y, Z = p.Z - a.Z };   
    stack mut f32 d00 = (v0.X*v0.X + v0.Y*v0.Y + v0.Z*v0.Z);    
    stack mut f32 d01 = (v0.X*v1.X + v0.Y*v1.Y + v0.Z*v1.Z);    
    stack mut f32 d11 = (v1.X*v1.X + v1.Y*v1.Y + v1.Z*v1.Z);    
    stack mut f32 d20 = (v2.X*v0.X + v2.Y*v0.Y + v2.Z*v0.Z);    
    stack mut f32 d21 = (v2.X*v1.X + v2.Y*v1.Y + v2.Z*v1.Z);    

    stack mut f32 denom = d00*d11 - d01*d01;

    result.Y = (d11*d20 - d01*d21)/denom;
    result.Z = (d00*d21 - d01*d20)/denom;
    result.X = 1.0f - (result.Z + result.Y);

    return result;
}

public inline finite law Vector3 Vector3Unproject(Vector3 source, Matrix projection, Matrix view)
{
stack mut Vector3 result = DefaultVector3();

    
    stack mut Matrix matViewProj = new Matrix() { M0 = view.M0*projection.M0 + view.M1*projection.M4 + view.M2*projection.M8 + view.M3*projection.M12, M4 = view.M0*projection.M1 + view.M1*projection.M5 + view.M2*projection.M9 + view.M3*projection.M13, M8 = view.M0*projection.M2 + view.M1*projection.M6 + view.M2*projection.M10 + view.M3*projection.M14, M12 = view.M0*projection.M3 + view.M1*projection.M7 + view.M2*projection.M11 + view.M3*projection.M15, M1 = view.M4*projection.M0 + view.M5*projection.M4 + view.M6*projection.M8 + view.M7*projection.M12, M5 = view.M4*projection.M1 + view.M5*projection.M5 + view.M6*projection.M9 + view.M7*projection.M13, M9 = view.M4*projection.M2 + view.M5*projection.M6 + view.M6*projection.M10 + view.M7*projection.M14, M13 = view.M4*projection.M3 + view.M5*projection.M7 + view.M6*projection.M11 + view.M7*projection.M15, M2 = view.M8*projection.M0 + view.M9*projection.M4 + view.M10*projection.M8 + view.M11*projection.M12, M6 = view.M8*projection.M1 + view.M9*projection.M5 + view.M10*projection.M9 + view.M11*projection.M13, M10 = view.M8*projection.M2 + view.M9*projection.M6 + view.M10*projection.M10 + view.M11*projection.M14, M14 = view.M8*projection.M3 + view.M9*projection.M7 + view.M10*projection.M11 + view.M11*projection.M15, M3 = view.M12*projection.M0 + view.M13*projection.M4 + view.M14*projection.M8 + view.M15*projection.M12, M7 = view.M12*projection.M1 + view.M13*projection.M5 + view.M14*projection.M9 + view.M15*projection.M13, M11 = view.M12*projection.M2 + view.M13*projection.M6 + view.M14*projection.M10 + view.M15*projection.M14, M15 = view.M12*projection.M3 + view.M13*projection.M7 + view.M14*projection.M11 + view.M15*projection.M15 };

    
    
    stack mut f32 a00 = matViewProj.M0;

    
    
    stack mut f32 a01 = matViewProj.M1;

    
    
    stack mut f32 a02 = matViewProj.M2;

    
    
    stack mut f32 a03 = matViewProj.M3;
    stack mut f32 a10 = matViewProj.M4;
    stack mut f32 a11 = matViewProj.M5;
    stack mut f32 a12 = matViewProj.M6;
    stack mut f32 a13 = matViewProj.M7;
    stack mut f32 a20 = matViewProj.M8;
    stack mut f32 a21 = matViewProj.M9;
    stack mut f32 a22 = matViewProj.M10;
    stack mut f32 a23 = matViewProj.M11;
    stack mut f32 a30 = matViewProj.M12;
    stack mut f32 a31 = matViewProj.M13;
    stack mut f32 a32 = matViewProj.M14;
    stack mut f32 a33 = matViewProj.M15;

    stack mut f32 b00 = a00*a11 - a01*a10;
    stack mut f32 b01 = a00*a12 - a02*a10;
    stack mut f32 b02 = a00*a13 - a03*a10;
    stack mut f32 b03 = a01*a12 - a02*a11;
    stack mut f32 b04 = a01*a13 - a03*a11;
    stack mut f32 b05 = a02*a13 - a03*a12;
    stack mut f32 b06 = a20*a31 - a21*a30;
    stack mut f32 b07 = a20*a32 - a22*a30;
    stack mut f32 b08 = a20*a33 - a23*a30;
    stack mut f32 b09 = a21*a32 - a22*a31;
    stack mut f32 b10 = a21*a33 - a23*a31;
    stack mut f32 b11 = a22*a33 - a23*a32;

    
    stack mut f32 invDet = 1.0f/(b00*b11 - b01*b10 + b02*b09 + b03*b08 - b04*b07 + b05*b06);

    stack mut Matrix matViewProjInv = new Matrix() { M0 = (a11*b11 - a12*b10 + a13*b09)*invDet, M4 = (-a01*b11 + a02*b10 - a03*b09)*invDet, M8 = (a31*b05 - a32*b04 + a33*b03)*invDet, M12 = (-a21*b05 + a22*b04 - a23*b03)*invDet, M1 = (-a10*b11 + a12*b08 - a13*b07)*invDet, M5 = (a00*b11 - a02*b08 + a03*b07)*invDet, M9 = (-a30*b05 + a32*b02 - a33*b01)*invDet, M13 = (a20*b05 - a22*b02 + a23*b01)*invDet, M2 = (a10*b10 - a11*b08 + a13*b06)*invDet, M6 = (-a00*b10 + a01*b08 - a03*b06)*invDet, M10 = (a30*b04 - a31*b02 + a33*b00)*invDet, M14 = (-a20*b04 + a21*b02 - a23*b00)*invDet, M3 = (-a10*b09 + a11*b07 - a12*b06)*invDet, M7 = (a00*b09 - a01*b07 + a02*b06)*invDet, M11 = (-a30*b03 + a31*b01 - a32*b00)*invDet, M15 = (a20*b03 - a21*b01 + a22*b00)*invDet };

    
    stack mut Quaternion quat = new Quaternion() { X = source.X, Y = source.Y, Z = source.Z, W = 1.0f };

    
    stack mut Quaternion qtransformed = new Quaternion() { X = matViewProjInv.M0*quat.X + matViewProjInv.M4*quat.Y + matViewProjInv.M8*quat.Z + matViewProjInv.M12*quat.W, Y = matViewProjInv.M1*quat.X + matViewProjInv.M5*quat.Y + matViewProjInv.M9*quat.Z + matViewProjInv.M13*quat.W, Z = matViewProjInv.M2*quat.X + matViewProjInv.M6*quat.Y + matViewProjInv.M10*quat.Z + matViewProjInv.M14*quat.W, W = matViewProjInv.M3*quat.X + matViewProjInv.M7*quat.Y + matViewProjInv.M11*quat.Z + matViewProjInv.M15*quat.W };

    
    result.X = qtransformed.X/qtransformed.W;
    result.Y = qtransformed.Y/qtransformed.W;
    result.Z = qtransformed.Z/qtransformed.W;

    return result;
}

public inline finite law Float3 Vector3ToFloatV(Vector3 v)
{
stack mut Float3 buffer = DefaultFloat3();

    buffer.V[0] = v.X;
    buffer.V[1] = v.Y;
    buffer.V[2] = v.Z;

    return buffer;
}

public inline finite law Vector3 Vector3Invert(Vector3 v)
{
stack mut Vector3 result = new Vector3() { X = 1.0f/v.X, Y = 1.0f/v.Y, Z = 1.0f/v.Z };

    return result;
}

public inline finite law Vector3 Vector3Clamp(Vector3 v, Vector3 min, Vector3 max)
{
stack mut Vector3 result = DefaultVector3();

    result.X = Min(max.X, Max(min.X, v.X));
    result.Y = Min(max.Y, Max(min.Y, v.Y));
    result.Z = Min(max.Z, Max(min.Z, v.Z));

    return result;
}

public inline finite law Vector3 Vector3ClampValue(Vector3 v, f32 min, f32 max)
{
stack mut Vector3 result = v;

    stack mut f32 length = (v.X*v.X) + (v.Y*v.Y) + (v.Z*v.Z);
    if (length > 0.0f)
    {
        length = Sqrt(length);

        stack mut f32 scale = 1; 
        if (length < min) scale = min/length;
        else if (length > max) scale = max/length;

        result.X = v.X*scale;
        result.Y = v.Y*scale;
        result.Z = v.Z*scale;
    }

    return result;
}

public inline finite law bool Vector3Equals(Vector3 p, Vector3 q)
{
stack mut bool result = ((AbsF32(p.X - q.X)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.X), AbsF32(q.X))))) &&
                 ((AbsF32(p.Y - q.Y)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.Y), AbsF32(q.Y))))) &&
                 ((AbsF32(p.Z - q.Z)) <= (RAYMATH_EPSILON*Max(1.0f, Max(AbsF32(p.Z), AbsF32(q.Z)))));

    return result;
}

public inline finite law Vector3 Vector3Refract(Vector3 v, Vector3 n, f32 r)
{
    stack mut Vector3 result = DefaultVector3();
    stack f32 dot = v.X * n.X + v.Y * n.Y + v.Z * n.Z;
    stack mut f32 d = 1.0f - r * r * (1.0f - dot * dot);
    if (d >= 0.0f)
    {
        d = Sqrt(d);
        result.X = r * v.X - (r * dot + d) * n.X;
        result.Y = r * v.Y - (r * dot + d) * n.Y;
        result.Z = r * v.Z - (r * dot + d) * n.Z;
    }

    return result;
}

