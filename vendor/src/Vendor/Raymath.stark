public inline finite law Vector3 Vector3SubtractValue(Vector3 v, f32 sub)
{
stack mut Vector3 result = new Vector3() { X = v.X - sub, Y = v.Y - sub, Z = v.Z - sub };

    return result;
}

public inline finite law Vector3 Vector3Scale(Vector3 v, f32 scalar)
{
stack mut Vector3 result = new Vector3() { X = v.X*scalar, Y = v.Y*scalar, Z = v.Z*scalar };

