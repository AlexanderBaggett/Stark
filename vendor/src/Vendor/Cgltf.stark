public struct Document
{
    internal rawmutptr<CgltfDocumentNative> Handle;

    Document()
    {
        self.Handle = null;
    }

    public inline finite law bool IsEmpty(borrow Document self)
    {
        return self.Handle == null;
    }

    mut drop
    {
        unsafe
        {
            if (self.Handle != null)
            {
                stark_cgltf_free(self.Handle);
                self.Handle = null;
            }
        }
    }
}

