{
    InvalidArgument,
    OutOfRange,
    DestinationTooSmall,
    DataTooShort,
    UnknownFormat,
    InvalidJson,
    InvalidGltf,
    InvalidOptions,
    FileNotFound,
    IoError,
    OutOfMemory,
    LegacyGltf,
    Native(i32[min max]),
}

