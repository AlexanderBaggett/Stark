internal finite law CgltfError ErrorFromNative(i32[min max] code)
{
    switch (code)
    {
        case -1:
            return CgltfError.InvalidArgument;
        case -2:
            return CgltfError.OutOfRange;
        case -3:
            return CgltfError.DestinationTooSmall;
        case 1:
            return CgltfError.DataTooShort;
        case 2:
            return CgltfError.UnknownFormat;
        case 3:
            return CgltfError.InvalidJson;
        case 4:
            return CgltfError.InvalidGltf;
        case 5:
            return CgltfError.InvalidOptions;
        case 6:
            return CgltfError.FileNotFound;
        case 7:
            return CgltfError.IoError;
        case 8:
            return CgltfError.OutOfMemory;
        case 9:
            return CgltfError.LegacyGltf;
        default:
            return CgltfError.Native(code);
    }
}

internal finite law CgltfStatus StatusFromNative(System.C.c_int code)
{
    if (code == CGLTF_SUCCESS)
    {
        return CgltfStatus.Ok;
    }

    return CgltfStatus.Err(ErrorFromNative((i32[min max])code));
}

internal finite law System.C.c_int BoolToNative(bool value)
{
    if (value)
    {
        return 1;
    }

    return 0;
}

internal finite law System.C.c_int BufferPolicyToNative(BufferLoadPolicy policy)
{
    switch (policy)
    {
        case BufferLoadPolicy.MetadataOnly:
            return 0;
        case BufferLoadPolicy.LoadExternalBuffers:
            return 1;
    }
}

internal finite law bool NativeBool(i32[min max] value)
{
    return value != 0;
}

internal finite law AlphaMode AlphaModeFromNative(i32[min max] value)
{
    switch (value)
    {
        case 0:
            return AlphaMode.Opaque;
        case 1:
            return AlphaMode.Mask;
        case 2:
            return AlphaMode.Blend;
        default:
            return AlphaMode.Unknown;
    }
}

internal finite law ComponentType ComponentTypeFromNative(i32[min max] value)
{
    switch (value)
    {
        case 1:
            return ComponentType.I8;
        case 2:
            return ComponentType.U8;
        case 3:
            return ComponentType.I16;
        case 4:
            return ComponentType.U16;
        case 5:
            return ComponentType.U32;
        case 6:
            return ComponentType.F32;
        default:
            return ComponentType.Invalid;
    }
}

internal finite law AccessorType AccessorTypeFromNative(i32[min max] value)
{
    switch (value)
    {
        case 1:
            return AccessorType.Scalar;
        case 2:
            return AccessorType.Vec2;
        case 3:
            return AccessorType.Vec3;
        case 4:
            return AccessorType.Vec4;
        case 5:
            return AccessorType.Mat2;
        case 6:
            return AccessorType.Mat3;
        case 7:
            return AccessorType.Mat4;
        default:
            return AccessorType.Invalid;
    }
}

internal finite law PrimitiveMode PrimitiveModeFromNative(i32[min max] value)
{
    switch (value)
    {
        case 1:
            return PrimitiveMode.Points;
        case 2:
            return PrimitiveMode.Lines;
        case 3:
            return PrimitiveMode.LineLoop;
        case 4:
            return PrimitiveMode.LineStrip;
        case 5:
            return PrimitiveMode.Triangles;
        case 6:
            return PrimitiveMode.TriangleStrip;
        case 7:
            return PrimitiveMode.TriangleFan;
        default:
            return PrimitiveMode.Invalid;
    }
}

internal finite law MeshInfo MeshInfoFromNative(NativeMeshInfo info)
{
    return new MeshInfo()
    {
        NameByteLength = info.NameBytes,
        PrimitiveCount = info.Primitives,
        WeightCount = info.Weights,
        TargetNameCount = info.TargetNames
    };
}

internal finite law MaterialInfo MaterialInfoFromNative(NativeMaterialInfo info)
{
    return new MaterialInfo()
    {
        NameByteLength = info.NameBytes,
        HasPbrMetallicRoughness = NativeBool(info.HasPbrMetallicRoughness),
        HasPbrSpecularGlossiness = NativeBool(info.HasPbrSpecularGlossiness),
        Alpha = AlphaModeFromNative(info.AlphaModeValue),
        DoubleSided = NativeBool(info.DoubleSided),
        Unlit = NativeBool(info.Unlit)
    };
}

internal finite law BufferInfo BufferInfoFromNative(NativeBufferInfo info)
{
    return new BufferInfo()
    {
        NameByteLength = info.NameBytes,
        UriByteLength = info.UriBytes,
        SizeBytes = info.SizeBytes,
        IsLoaded = NativeBool(info.IsLoaded)
    };
}

internal finite law NodeInfo NodeInfoFromNative(NativeNodeInfo info)
{
    return new NodeInfo()
    {
        NameByteLength = info.NameBytes,
        ChildCount = info.Children,
        WeightCount = info.Weights,
        HasMesh = NativeBool(info.HasMesh),
        MeshIndex = info.MeshIndex,
        HasCamera = NativeBool(info.HasCamera),
        CameraIndex = info.CameraIndex,
        HasSkin = NativeBool(info.HasSkin),
        SkinIndex = info.SkinIndex,
        HasTranslation = NativeBool(info.HasTranslation),
        HasRotation = NativeBool(info.HasRotation),
        HasScale = NativeBool(info.HasScale),
        HasMatrix = NativeBool(info.HasMatrix)
    };
}

internal finite law SceneInfo SceneInfoFromNative(NativeSceneInfo info)
{
    return new SceneInfo()
    {
        NameByteLength = info.NameBytes,
        NodeCount = info.Nodes
    };
}

internal finite law AnimationInfo AnimationInfoFromNative(NativeAnimationInfo info)
{
    return new AnimationInfo()
    {
        NameByteLength = info.NameBytes,
        SamplerCount = info.Samplers,
        ChannelCount = info.Channels
    };
}

internal finite law AccessorInfo AccessorInfoFromNative(NativeAccessorInfo info)
{
    return new AccessorInfo()
    {
        NameByteLength = info.NameBytes,
        Count = info.Count,
        Stride = info.Stride,
        Component = ComponentTypeFromNative(info.ComponentTypeValue),
        Type = AccessorTypeFromNative(info.TypeValue),
        Normalized = NativeBool(info.Normalized),
        HasBufferView = NativeBool(info.HasBufferView),
        BufferViewIndex = info.BufferViewIndex,
        IsSparse = NativeBool(info.IsSparse)
    };
}

internal finite law PrimitiveInfo PrimitiveInfoFromNative(NativePrimitiveInfo info)
{
    return new PrimitiveInfo()
    {
        Mode = PrimitiveModeFromNative(info.TypeValue),
        AttributeCount = info.Attributes,
        TargetCount = info.Targets,
        HasIndices = NativeBool(info.HasIndices),
        IndicesAccessorIndex = info.IndicesAccessorIndex,
        HasMaterial = NativeBool(info.HasMaterial),
        MaterialIndex = info.MaterialIndex
    };
}

public fn DocumentResult ParseFromMemory(borrow u8[0 max][] encoded, bool validate)
{
    if (encoded.Length == 0)
    {
        return DocumentResult.Err(CgltfError.InvalidArgument);
    }

    unsafe
    {
        stack mut rawmutptr<CgltfDocumentNative> handle = null;
        stack System.C.c_size_t byteLength = encoded.Length;
        stack System.C.c_int status = stark_cgltf_parse_memory(
            &encoded[0],
            byteLength,
            BoolToNative(validate),
            &handle);
        if (status != CGLTF_SUCCESS)
        {
            return DocumentResult.Err(ErrorFromNative((i32[min max])status));
        }

        stack mut Document document = new();
        document.Handle = handle;
        return DocumentResult.Ok(document);
    }
}

public fn DocumentResult ParseFromFile(ascii path, BufferLoadPolicy bufferPolicy, bool validate)
{
    stack System.C.CStringResult<System.C.OwnedCStr> preparedPath = System.C.FromAscii(path);
    switch (preparedPath)
    {
        case System.C.CStringResult<System.C.OwnedCStr>.Err(var error):
            return DocumentResult.Err(CgltfError.InvalidArgument);
        case System.C.CStringResult<System.C.OwnedCStr>.Ok(var cPath):
            unsafe
            {
                stack mut rawmutptr<CgltfDocumentNative> handle = null;
                stack System.C.c_int status = stark_cgltf_parse_file(
                    cPath.Data(),
                    BufferPolicyToNative(bufferPolicy),
                    BoolToNative(validate),
                    &handle);
                if (status != CGLTF_SUCCESS)
                {
                    return DocumentResult.Err(ErrorFromNative((i32[min max])status));
                }

                stack mut Document document = new();
                document.Handle = handle;
                return DocumentResult.Ok(document);
            }
    }
}

public fn CgltfStatus Validate(borrow Document document)
{
    if (document.IsEmpty())
    {
        return CgltfStatus.Err(CgltfError.InvalidArgument);
    }

    unsafe
    {
        return StatusFromNative(stark_cgltf_validate(document.Handle));
    }
}

public fn CountsResult GetCounts(borrow Document document)
{
    if (document.IsEmpty())
    {
        return CountsResult.Err(CgltfError.InvalidArgument);
    }

    unsafe
    {
        stack mut DocumentCounts counts = new();
        stack System.C.c_int status = stark_cgltf_get_counts(document.Handle, &counts);
        if (status != CGLTF_SUCCESS)
        {
            return CountsResult.Err(ErrorFromNative((i32[min max])status));
        }

        return CountsResult.Ok(counts);
    }
}

