internal fn NameCopyResult CopyNameBytes(
    borrow Document document,
    System.C.c_int kind,
    u64[0 max] index,
    borrow mut i8[min max][] destination)
{
    if (document.IsEmpty())
    {
        return NameCopyResult.Err(CgltfError.InvalidArgument);
    }

    unsafe
    {
        stack mut rawmutptr<i8[min max]> output = null;
        if (destination.Length != 0)
        {
            output = &destination[0];
        }

        stack mut u64[0 max] bytesCopied = 0;
        stack System.C.c_size_t capacity = destination.Length;
        stack System.C.c_int status = stark_cgltf_copy_name(document.Handle, kind, index, output, capacity, &bytesCopied);
        if (status != CGLTF_SUCCESS)
        {
            return NameCopyResult.Err(ErrorFromNative((i32[min max])status));
        }

        return NameCopyResult.Ok(bytesCopied);
    }
}

public fn NameCopyResult CopyMeshNameBytes(borrow Document document, u64[0 max] index, borrow mut i8[min max][] destination)
{
    return CopyNameBytes(document, NAME_MESH, index, destination);
}

public fn NameCopyResult CopyMaterialNameBytes(borrow Document document, u64[0 max] index, borrow mut i8[min max][] destination)
{
    return CopyNameBytes(document, NAME_MATERIAL, index, destination);
}

