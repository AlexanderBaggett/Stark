    u32[0 max] clearValueCount;
    rawptr<VkClearValue> pClearValues;
}

[StructLayout(C)]
internal struct VkSemaphoreCreateInfo
{
    VkStructureType sType;
    rawptr<System.C.c_void> pNext;
    VkSemaphoreCreateFlags flags;
}

[StructLayout(C)]
internal struct VkSubmitInfo
{
    VkStructureType sType;
    rawptr<System.C.c_void> pNext;
    u32[0 max] waitSemaphoreCount;
    rawptr<u64[0 max]> pWaitSemaphores;
    rawptr<VkPipelineStageFlags> pWaitDstStageMask;
    u32[0 max] commandBufferCount;
    rawptr<System.C.c_void> pCommandBuffers;
    u32[0 max] signalSemaphoreCount;
    rawptr<u64[0 max]> pSignalSemaphores;
}

[StructLayout(C)]
internal struct VkPresentInfoKHR
{
    VkStructureType sType;
    rawptr<System.C.c_void> pNext;
    u32[0 max] waitSemaphoreCount;
    rawptr<u64[0 max]> pWaitSemaphores;
    u32[0 max] swapchainCount;
    rawptr<u64[0 max]> pSwapchains;
    rawptr<u32[0 max]> pImageIndices;
    rawmutptr<VkResult> pResults;
}

internal struct TrianglePhysicalDeviceChoice
{
    rawmutptr<VkPhysicalDeviceNative> PhysicalDevice;
    u8[0 63] QueueFamilyIndex;
}

internal enum TrianglePhysicalDeviceResult
{
    [Ok] Ok(TrianglePhysicalDeviceChoice),
    [Err] Err(VulkanError),
}

internal struct TriangleFrameResources
{
    rawmutptr<VkDeviceNative> Device;
    rawmutptr<VkQueueNative> Queue;
    u8[0 63] QueueFamilyIndex;
    VkFormat SurfaceFormat;
    VkColorSpaceKHR SurfaceColorSpace;
    VkExtent2D Extent;
    u64[0 max] Swapchain;
    u8[0 8] ImageCount;
    u64[0 max][8] ImageViews;
    u64[0 max] RenderPass;
    u64[0 max] PipelineLayout;
    u64[0 max] Pipeline;
    u64[0 max][8] Framebuffers;
    u64[0 max] CommandPool;
    rawmutptr<VkCommandBufferNative>[8] CommandBuffers;
    u64[0 max] ImageAvailableSemaphore;
    u64[0 max] RenderFinishedSemaphore;
}

public struct VulkanTriangleSession
{
    internal TriangleFrameResources Resources;
    internal bool IsInitialized;

    VulkanTriangleSession()
    {
        self.Resources = new TriangleFrameResources();
        self.IsInitialized = false;
    }

    public inline finite law bool IsEmpty(borrow VulkanTriangleSession self)
    {
        return !self.IsInitialized;
    }

    mut drop
    {
        if (self.IsInitialized)
        {
            CleanupTriangleResources(self.Resources);
            self.IsInitialized = false;
        }
    }
}

public enum VulkanTriangleSessionResult
{
    [Ok] Ok(VulkanTriangleSession),
    [Err] Err(VulkanError),
}

