{
  "Module": {
    "prefix": "module",
    "body": [
      "module ${1:Demo}",
      "",
      "$0"
    ],
    "description": "Declare a Stark module"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import ${1:System.Console}"
    ],
    "description": "Import a Stark module"
  },
  "Export Import": {
    "prefix": "export import",
    "body": [
      "export import ${1:System.Console}"
    ],
    "description": "Re-export a Stark module"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:void} ${2:Name}(${3})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Declare a Stark function"
  },
  "Finite Law": {
    "prefix": "finite law",
    "body": [
      "finite law ${1:i32[0 max]} ${2:Name}(${3})",
      "{",
      "\treturn ${4:0};",
      "}"
    ],
    "description": "Declare a pure terminating function"
  },
  "Tail Function": {
    "prefix": "tail fn",
    "body": [
      "tail fn ${1:i64[min max]} ${2:Name}(${3:i64[min max] value})",
      "{",
      "\tbecome ${4:Next}(${5:value});",
      "}"
    ],
    "description": "Declare a tail-callable function"
  },
  "Main Void": {
    "prefix": "main",
    "body": [
      "fn void Main()",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Declare a void entrypoint"
  },
  "Main Exit Code": {
    "prefix": "maincode",
    "body": [
      "fn u8[0 255] Main()",
      "{",
      "\treturn ${1:0};",
      "}"
    ],
    "description": "Declare an entrypoint with an exit code"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}",
      "{",
      "\t${2:i32[0 max]} ${3:Value};",
      "",
      "\t$0",
      "}"
    ],
    "description": "Declare a Stark struct"
  },
  "Record": {
    "prefix": "record",
    "body": [
      "record ${1:Name}(${2:i32[0 max] Value})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Declare a Stark record"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name}",
      "{",
      "\t${2:First},",
      "\t${3:Second}",
      "}",
      "$0"
    ],
    "description": "Declare a Stark enum"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name}<${2:T}>",
      "{",
      "\tlaw bool ${3:Matches}(borrow ${2:T} value);",
      "}",
      "$0"
    ],
    "description": "Declare a Stark trait"
  },
  "Doctrine": {
    "prefix": "doctrine",
    "body": [
      "doctrine ${1:Name}<${2:T}>",
      "{",
      "\tfinite law bool ${3:Matches}(borrow ${2:T} value);",
      "}",
      "$0"
    ],
    "description": "Declare a Stark doctrine"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:value})",
      "{",
      "\tcase ${2:0}:",
      "\t{",
      "\t\t$0",
      "\t}",
      "\tdefault:",
      "\t{",
      "\t}",
      "}"
    ],
    "description": "Declare a Stark switch statement"
  },
  "While Will Exit": {
    "prefix": "while",
    "body": [
      "while willexit (${1:condition})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Declare a while loop with an exit guarantee"
  },
  "For Will Exit": {
    "prefix": "for",
    "body": [
      "for willexit (${1:stack mut u64[0 max] index = 0}; ${2:index < count}; ${3:index += 1})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Declare a Stark for loop"
  },
  "For Independent": {
    "prefix": "for independent",
    "body": [
      "for willexit independent (${1:stack mut u64[0 max] index = 0}; ${2:index < count}; ${3:index += 1})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Declare an independent Stark for loop"
  },
  "Where Disjoint": {
    "prefix": "where disjoint",
    "body": [
      "where disjoint(${1:left}, ${2:right})"
    ],
    "description": "Add a disjoint memory contract"
  },
  "Where Dead On Return": {
    "prefix": "where dead_on_return",
    "body": [
      "where dead_on_return(${1:value})"
    ],
    "description": "Add a pointee-dead-after-return contract"
  },
  "Become": {
    "prefix": "become",
    "body": [
      "become ${1:Next}(${2:value});"
    ],
    "description": "Transfer to a tail-callable callee"
  },
  "If Disjoint": {
    "prefix": "if disjoint",
    "body": [
      "if disjoint(${1:left}, ${2:right})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Create a runtime disjointness branch"
  },
  "Unsafe Block": {
    "prefix": "unsafe",
    "body": [
      "unsafe",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Declare an unsafe block"
  },
  "FFI Declaration": {
    "prefix": "ffi",
    "body": [
      "unsafe ffi fn ${1:i32[min max]} ${2:NativeCall}(${3});"
    ],
    "description": "Declare a native FFI function"
  },
  "FFI LinkName Declaration": {
    "prefix": "linkname ffi",
    "body": [
      "[LinkName(\"${1:foreign_symbol}\")]",
      "unsafe ffi(c) fn ${2:i32[min max]} ${3:LocalName}(${4});"
    ],
    "description": "Declare a native FFI function with an explicit foreign linker symbol"
  },
  "C Aggregate FFI Declaration": {
    "prefix": "c aggregate ffi",
    "body": [
      "[StructLayout(C)]",
      "public struct ${1:NativeStruct}",
      "{",
      "\tpublic ${2:f32} ${3:X};",
      "\tpublic ${4:f32} ${5:Y};",
      "}",
      "",
      "[LinkName(\"${6:NativeSymbol}\")]",
      "unsafe ffi(c) fn ${1:NativeStruct} ${7:LocalName}(${8});"
    ],
    "description": "Declare a C-layout aggregate and a direct by-value FFI function"
  },
  "Assembly Function": {
    "prefix": "asmfn",
    "body": [
      "unsafe ffi asm(${1:x86_64}) fn ${2:i64[min max]} ${3:Name}(${4:i64[min max] value})",
      "\tin(\"${5:rax}\") ${6:value},",
      "\tout(\"${7:rax}\") return",
      "{",
      "\t\"${8:mov rax, rdi}\"",
      "}"
    ],
    "description": "Declare an assembly-backed function"
  },
  "Stack Local": {
    "prefix": "stack",
    "body": [
      "stack ${1:mut }${2:i32[0 max]} ${3:name} = ${4:0};"
    ],
    "description": "Declare a stack local"
  },
  "Arena Local": {
    "prefix": "arena",
    "body": [
      "arena ${1:mut }${2:Node} ${3:name} = new ${2:Node}();"
    ],
    "description": "Declare an arena-backed local"
  },
  "Arena Dynamic Storage": {
    "prefix": "new arena",
    "body": [
      "stack mut dynamic ${1:u8[0 max]} ${2:items} = new(arena, ${3:capacity});"
    ],
    "description": "Declare dynamic storage with arena-backed capacity"
  },
  "Constant": {
    "prefix": "const",
    "body": [
      "const ${1:Name} = ${2:0};"
    ],
    "description": "Declare a constant"
  }
}
