{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stark",
  "scopeName": "source.stark",
  "fileTypes": [
    "stark"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.stark",
          "begin": "(?x)(^|(?<=[{;,]))\\s*(\\[)\\s*(?=[A-Za-z])",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.attribute.begin.stark"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.end.stark"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "name": "entity.name.function.attribute.stark",
              "match": "\\b[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*\\b"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.stark",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.stark",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.stark",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.stark",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.module.stark",
          "match": "\\b(module|import)\\s+([A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.stark"
            },
            "2": {
              "name": "entity.name.namespace.stark"
            }
          }
        },
        {
          "name": "meta.type.declaration.stark",
          "match": "\\b(struct|record|enum|trait|doctrine|alias)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.stark"
            },
            "2": {
              "name": "entity.name.type.stark"
            }
          }
        },
        {
          "name": "meta.function.declaration.stark",
          "match": "(?x)\\b((?:(?:inline|noinline|inlinehint|hot|cold|ffi|varargs|unsafe|strictfp|static)\\s+)*)((?:finite\\s+law)|finite|law|fn)\\s+((?:[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*(?:<[^>\\n]+>)?(?:\\[[^\\]\\n]*\\])*|retborrow\\s+(?:mut\\s+)?(?:frozen\\s+)?[A-Za-z][A-Za-z0-9_]*(?:<[^>\\n]+>)?(?:\\[[^\\]\\n]*\\])*|void|bool|ascii|unicode|Ascii|Unicode|[iu](?:8|16|24|32|48|64|96|128|192|256|384|512|768|1024)(?:\\[[^\\]\\n]*\\])?|f(?:16|32|64|80|128)))\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "name": "keyword.modifier.stark",
                  "match": "\\b(inline|noinline|inlinehint|hot|cold|ffi|varargs|unsafe|strictfp|static)\\b"
                }
              ]
            },
            "2": {
              "name": "keyword.declaration.stark"
            },
            "3": {
              "patterns": [
                { "include": "#types" },
                { "include": "#keywords" },
                { "include": "#numbers" },
                { "include": "#punctuation" }
              ]
            },
            "4": {
              "name": "entity.name.function.stark"
            }
          }
        },
        {
          "name": "entity.name.function.call.stark",
          "match": "\\b(?!(?:if|while|for|switch|return|sizeof|alignof|disjoint|overlap|same|asm|clobber|in|out|init|new|case|when)\\b)([A-Za-z][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.stark"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.stark",
          "match": "\\b(if|else|switch|case|default|when|while|for|return|break|continue|try|is)\\b"
        },
        {
          "name": "keyword.declaration.stark",
          "match": "\\b(import|module|internal|public|export|fn|finite|law|struct|record|enum|trait|doctrine|alias|const|comptime|var|where|drop|new|from)\\b"
        },
        {
          "name": "keyword.modifier.stark",
          "match": "\\b(inline|noinline|inlinehint|hot|cold|ffi|varargs|unsafe|strictfp|static|asm|clobber|in|once|assume)\\b"
        },
        {
          "name": "keyword.storage.stark",
          "match": "\\b(stack|heap|register|arena|dynamic|dyn|rawptr|rawmutptr|fnptr|closure)\\b"
        },
        {
          "name": "keyword.operator.ownership.stark",
          "match": "\\b(borrow|retborrow|storeborrow|frozen|shared|out|init|mut|disjoint|overlap|same)\\b"
        },
        {
          "name": "keyword.control.loop-contract.stark",
          "match": "\\b(infinite|non-deterministic|willexit|independent)\\b"
        },
        {
          "name": "keyword.operator.layout.stark",
          "match": "\\b(sizeof|alignof)\\b"
        },
        {
          "name": "constant.language.boolean.stark",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.language.range-bound.stark",
          "match": "\\b(min|max)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.weight.stark",
          "match": "\\bw\\d+\\b"
        },
        {
          "name": "invalid.illegal.integer-type.stark",
          "match": "\\b[ui](?!8\\b|16\\b|24\\b|32\\b|48\\b|64\\b|96\\b|128\\b|192\\b|256\\b|384\\b|512\\b|768\\b|1024\\b)\\d+\\b"
        },
        {
          "name": "invalid.illegal.float-type.stark",
          "match": "\\bf(?!16\\b|32\\b|64\\b|80\\b|128\\b)\\d+\\b"
        },
        {
          "name": "constant.numeric.float.stark",
          "match": "\\b(?:\\d+\\.\\d+(?:[eE][+-]?\\d+)?[fF]?|\\d+[eE][+-]?\\d+[fF]?)\\b"
        },
        {
          "name": "constant.numeric.integer.stark",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.stark",
          "match": "\\+%=|-%=|\\*%=|\\+\\|=|-\\|=|\\*\\|=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|="
        },
        {
          "name": "keyword.operator.comparison.stark",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.stark",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.stark",
          "match": "\\*\\*|\\+%|-%|\\*%|\\+\\||-\\||\\*\\||[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.stark",
          "match": "[&|^~]"
        },
        {
          "name": "keyword.operator.arrow.stark",
          "match": "=>"
        },
        {
          "name": "keyword.operator.conditional.stark",
          "match": "[?:]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.stark",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.stark",
          "match": ","
        },
        {
          "name": "punctuation.accessor.stark",
          "match": "\\."
        },
        {
          "name": "punctuation.bracket.stark",
          "match": "[(){}\\[\\]]"
        },
        {
          "name": "constant.language.discard.stark",
          "match": "\\b_\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.stark",
          "begin": "(\\$)?\"",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.unicode.stark"
            }
          },
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.stark",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.character.stark",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.stark",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.stark",
          "match": "\\b(void|bool|ascii|unicode|Ascii|Unicode|[iu](?:8|16|24|32|48|64|96|128|192|256|384|512|768|1024)|f(?:16|32|64|80|128))\\b"
        }
      ]
    }
  }
}
