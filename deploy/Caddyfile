{
    email {$STARK_SITE_ACME_EMAIL}
}

{$STARK_SITE_DOMAIN} {
    root * {$STARK_SITE_ROOT:/var/www/stark/public}
    encode zstd gzip
    log {
        output file {$STARK_SITE_ACCESS_LOG:/var/log/caddy/stark-access.log} {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 720h
        }
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options DENY
    }

    @static {
        path *.css *.js *.mjs *.wasm *.svg *.png *.jpg *.jpeg *.webp *.ico *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    @html {
        path *.html /
    }
    header @html Cache-Control "public, max-age=300"

    file_server
}

www.{$STARK_SITE_DOMAIN} {
    redir https://{$STARK_SITE_DOMAIN}{uri} permanent
}
