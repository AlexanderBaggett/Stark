import System
import System.Testing
module StandardLibraryTests

[Fact]
fn bool IntegerAssertionsWork() {
    return System.Testing.Equal(4, 2 + 2);
}

[Fact]
fn bool TextAssertionsWork() {
    return System.Testing.Equal("Stark", "Stark");
}

export fn i32[min max] main() {
    stack mut u8[0 1] failed = 0;

    if (System.Testing.RunFact("IntegerAssertionsWork", IntegerAssertionsWork()) != 0) {
        failed = 1;
    }

    if (System.Testing.RunFact("TextAssertionsWork", TextAssertionsWork()) != 0) {
        failed = 1;
    }

    return System.Testing.ExitCode(failed);
}
