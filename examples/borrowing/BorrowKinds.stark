module Borrowing.BorrowKinds

struct Counter {
    i32[min max] Value;

    finite law i32[min max] Current(borrow Counter self) {
        return self.Value;
    }

    finite void Add(mut borrow Counter self, i32[min max] amount) {
        self.Value += amount;
        return;
    }

    finite retborrow mut i32[min max] Slot(mut borrow Counter self) {
        return self.Value;
    }
}

export ffi fn i32[min max] main() {
    stack mut Counter counter = new Counter() {
        Value = 4
    };

    counter.Add(5);

    if (counter.Current() != 9) {
        return 1;
    }

    counter.Slot() = 12;

    if (counter.Current() != 12) {
        return 2;
    }

    return 0;
}
