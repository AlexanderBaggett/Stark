import System.Console
import Vendor.Vulkan
module VulkanInfo

fn i32[min max] PrintUnavailable()
{
    WriteLine("Vulkan unavailable");
    return 0;
}

fn bool CountQuerySucceeded(VulkanCountResult result)
{
    switch (result)
    {
        case VulkanCountResult.Err(var error):
            return false;
        case VulkanCountResult.Ok(var count):
            return true;
    }
}

fn i32[min max] Run()
{
    switch (EnumerateInstanceVersion())
    {
        case VulkanVersionResult.Err(var error):
            return PrintUnavailable();
        case VulkanVersionResult.Ok(var version):
            if (version.Major() == 0 || version.Raw < VK_API_VERSION_1_0)
            {
                return 2;
            }
    }

    switch (GlobalProcAvailable("vkEnumerateInstanceVersion"))
    {
        case VulkanBoolResult.Err(var error):
            return PrintUnavailable();
        case VulkanBoolResult.Ok(var available):
            if (!available)
            {
                return 3;
            }
    }

    if (!CountQuerySucceeded(InstanceExtensionCount()))
    {
        return PrintUnavailable();
    }

    if (!CountQuerySucceeded(InstanceLayerCount()))
    {
        return PrintUnavailable();
    }

    switch (LoadGlobalDispatch())
    {
        case VulkanGlobalDispatchResult.Err(var error):
            return PrintUnavailable();
        case VulkanGlobalDispatchResult.Ok(var dispatch):
            switch (EnumerateInstanceVersion(dispatch))
            {
                case VulkanVersionResult.Err(var error):
                    return PrintUnavailable();
                case VulkanVersionResult.Ok(var dispatchVersion):
                    if (dispatchVersion.Major() == 0)
                    {
                        return 4;
                    }
            }

            if (!CountQuerySucceeded(InstanceExtensionCount(dispatch)))
            {
                return PrintUnavailable();
            }
    }

    WriteLine("Vulkan loader ok");
    return 0;
}

export fn i32[min max] main()
{
    return Run();
}
