module TypeSystem

alias Score = i32[0 100];

struct Reading {
    Score Value;
    bool Trusted;
}

record WeightedScore(Score Value, i32[1 10] Weight) { }

enum Assessment {
    Missing,
    Fail(i32[0 100]),
    Pass(i32[0 100]),
}

finite law Assessment Classify(Reading reading) {
    if (!reading.Trusted) {
        return Assessment.Missing;
    }

    if (reading.Value >= 60) {
        return Assessment.Pass(reading.Value);
    }

    return Assessment.Fail(reading.Value);
}

finite law bool Passed(Assessment assessment) {
    return assessment == Assessment.Pass(72);
}

export unsafe ffi fn i32[min max] main() {
    stack Reading reading = new Reading() {
        Value = 72,
        Trusted = true
    };
    stack WeightedScore weighted = new WeightedScore(reading.Value, 2);
    stack Assessment assessment = Classify(reading);

    if (!Passed(assessment)) {
        return 1;
    }

    if (weighted.Value * weighted.Weight != 144) {
        return 2;
    }

    if (Assessment.Missing == Assessment.Fail(72)) {
        return 3;
    }

    return 0;
}
