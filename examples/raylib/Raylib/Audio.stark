internal unsafe ffi fn void stark_raylib_LoadWave(rawmutptr<Wave> result, ascii fileName);
public fn Wave LoadWave(ascii fileName) {
    stack mut Wave result = DefaultWave();
    stark_raylib_LoadWave(&result, fileName);
    return result;
}

