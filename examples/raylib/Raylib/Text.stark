import Raylib.Types
export import Raylib.Types
module Raylib.Text

internal unsafe ffi fn void stark_raylib_GetFontDefault(rawmutptr<Font> result);
public fn Font GetFontDefault() {
    stack mut Font result = DefaultFont();
    stark_raylib_GetFontDefault(&result);
    return result;
}

internal unsafe ffi fn void stark_raylib_LoadFont(rawmutptr<Font> result, ascii fileName);
public fn Font LoadFont(ascii fileName) {
    stack mut Font result = DefaultFont();
    stark_raylib_LoadFont(&result, fileName);
    return result;
}

internal unsafe ffi fn void stark_raylib_LoadFontEx(rawmutptr<Font> result, ascii fileName, i32[min max] fontSize, rawmutptr<i32[min max]> codepoints, i32[min max] codepointCount);
public unsafe fn Font LoadFontEx(ascii fileName, i32[min max] fontSize, rawmutptr<i32[min max]> codepoints, i32[min max] codepointCount) {
    stack mut Font result = DefaultFont();
    stark_raylib_LoadFontEx(&result, fileName, fontSize, codepoints, codepointCount);
    return result;
}

internal unsafe ffi fn void stark_raylib_LoadFontFromImage(rawmutptr<Font> result, rawptr<Image> image, rawptr<Color> key, i32[min max] firstChar);
public fn Font LoadFontFromImage(Image image, Color key, i32[min max] firstChar) {
    stack mut Font result = DefaultFont();
    stark_raylib_LoadFontFromImage(&result, &image, &key, firstChar);
    return result;
}

internal unsafe ffi fn void stark_raylib_LoadFontFromMemory(rawmutptr<Font> result, ascii fileType, rawptr<u8[0 255]> fileData, i32[min max] dataSize, i32[min max] fontSize, rawmutptr<i32[min max]> codepoints, i32[min max] codepointCount);
