// Generated Raylib 5.5 type surface for Stark examples. Keep this file split from function categories so agents can read only the area they need.

module Raylib.Types

[StructLayout(C)]
public struct RAudioBuffer {
    i8[min max] Opaque;
}

[StructLayout(C)]
public struct RAudioProcessor {
    i8[min max] Opaque;
}

[StructLayout(C)]
public struct Vector2 {
    f32 X;
    f32 Y;
}

[StructLayout(C)]
public struct Vector3 {
    f32 X;
    f32 Y;
    f32 Z;
}

[StructLayout(C)]
public struct Vector4 {
    f32 X;
    f32 Y;
    f32 Z;
    f32 W;
}

[StructLayout(C)]
public struct Matrix {
    f32 M0;
    f32 M4;
    f32 M8;
    f32 M12;
    f32 M1;
    f32 M5;
    f32 M9;
    f32 M13;
    f32 M2;
    f32 M6;
    f32 M10;
    f32 M14;
    f32 M3;
    f32 M7;
    f32 M11;
    f32 M15;
}

[StructLayout(C)]
public struct Color {
    u8[0 max] R;
    u8[0 max] G;
    u8[0 max] B;
    u8[0 max] A;
}

[StructLayout(C)]
public struct Rectangle {
    f32 X;
    f32 Y;
    f32 Width;
    f32 Height;
}

[StructLayout(C)]
public struct Image {
    rawmutptr<i8[min max]> Data;
    i32[min max] Width;
    i32[min max] Height;
    i32[min max] Mipmaps;
    i32[min max] Format;
}

[StructLayout(C)]
public struct Texture {
    u32[0 max] Id;
    i32[min max] Width;
    i32[min max] Height;
    i32[min max] Mipmaps;
    i32[min max] Format;
}

[StructLayout(C)]
public struct RenderTexture {
    u32[0 max] Id;
    Texture Texture;
    Texture Depth;
}

[StructLayout(C)]
public struct NPatchInfo {
    Rectangle Source;
    i32[min max] Left;
    i32[min max] Top;
    i32[min max] Right;
    i32[min max] Bottom;
    i32[min max] Layout;
}

[StructLayout(C)]
public struct GlyphInfo {
    i32[min max] Value;
    i32[min max] OffsetX;
    i32[min max] OffsetY;
    i32[min max] AdvanceX;
    Image Image;
}

[StructLayout(C)]
public struct Font {
    i32[min max] BaseSize;
    i32[min max] GlyphCount;
    i32[min max] GlyphPadding;
    Texture2D Texture;
    rawmutptr<Rectangle> Recs;
    rawmutptr<GlyphInfo> Glyphs;
}

[StructLayout(C)]
public struct Camera3D {
    Vector3 Position;
    Vector3 Target;
    Vector3 Up;
    f32 Fovy;
    i32[min max] Projection;
}

[StructLayout(C)]
public struct Camera2D {
    Vector2 Offset;
    Vector2 Target;
    f32 Rotation;
    f32 Zoom;
}

[StructLayout(C)]
public struct Mesh {
    i32[min max] VertexCount;
    i32[min max] TriangleCount;
    rawmutptr<f32> Vertices;
    rawmutptr<f32> Texcoords;
    rawmutptr<f32> Texcoords2;
    rawmutptr<f32> Normals;
    rawmutptr<f32> Tangents;
    rawmutptr<u8[0 max]> Colors;
    rawmutptr<u16[0 max]> Indices;
    rawmutptr<f32> AnimVertices;
    rawmutptr<f32> AnimNormals;
    rawmutptr<u8[0 max]> BoneIds;
    rawmutptr<f32> BoneWeights;
    rawmutptr<Matrix> BoneMatrices;
    i32[min max] BoneCount;
    u32[0 max] VaoId;
    rawmutptr<u32[0 max]> VboId;
}

[StructLayout(C)]
public struct Shader {
    u32[0 max] Id;
    rawmutptr<i32[min max]> Locs;
}

[StructLayout(C)]
public struct MaterialMap {
    Texture2D Texture;
    Color Color;
    f32 Value;
}

[StructLayout(C)]
public struct Material {
    Shader Shader;
    rawmutptr<MaterialMap> Maps;
    f32[4] Params;
}

[StructLayout(C)]
public struct Transform {
    Vector3 Translation;
    Quaternion Rotation;
    Vector3 Scale;
}

[StructLayout(C)]
public struct BoneInfo {
    i8[min max][32] Name;
    i32[min max] Parent;
}

[StructLayout(C)]
public struct Model {
    Matrix Transform;
    i32[min max] MeshCount;
    i32[min max] MaterialCount;
    rawmutptr<Mesh> Meshes;
    rawmutptr<Material> Materials;
    rawmutptr<i32[min max]> MeshMaterial;
    i32[min max] BoneCount;
    rawmutptr<BoneInfo> Bones;
    rawmutptr<Transform> BindPose;
}

[Platform, StructLayout(C)]
public struct ModelAnimation {
    i32[min max] BoneCount;
    i32[min max] FrameCount;
    rawmutptr<BoneInfo> Bones;
    rawmutptr<rawptr<Transform>> FramePoses;
    i8[min max][32] Name;
}

[StructLayout(C)]
public struct Ray {
    Vector3 Position;
    Vector3 Direction;
}

[StructLayout(C)]
public struct RayCollision {
    bool Hit;
    f32 Distance;
    Vector3 Point;
    Vector3 Normal;
}

[StructLayout(C)]
public struct BoundingBox {
    Vector3 Min;
    Vector3 Max;
}

[StructLayout(C)]
public struct Wave {
    u32[0 max] FrameCount;
    u32[0 max] SampleRate;
    u32[0 max] SampleSize;
    u32[0 max] Channels;
    rawmutptr<i8[min max]> Data;
}

[StructLayout(C)]
public struct AudioStream {
    rawmutptr<RAudioBuffer> Buffer;
    rawmutptr<RAudioProcessor> Processor;
    u32[0 max] SampleRate;
    u32[0 max] SampleSize;
    u32[0 max] Channels;
}

[StructLayout(C)]
public struct Sound {
    AudioStream Stream;
    u32[0 max] FrameCount;
}

[StructLayout(C)]
public struct Music {
    AudioStream Stream;
    u32[0 max] FrameCount;
    bool Looping;
    i32[min max] CtxType;
    rawmutptr<i8[min max]> CtxData;
}

[StructLayout(C)]
public struct VrDeviceInfo {
    i32[min max] HResolution;
    i32[min max] VResolution;
    f32 HScreenSize;
    f32 VScreenSize;
    f32 EyeToScreenDistance;
    f32 LensSeparationDistance;
    f32 InterpupillaryDistance;
    f32[4] LensDistortionValues;
    f32[4] ChromaAbCorrection;
}

[StructLayout(C)]
public struct VrStereoConfig {
    Matrix[2] Projection;
    Matrix[2] ViewOffset;
    f32[2] LeftLensCenter;
    f32[2] RightLensCenter;
    f32[2] LeftScreenCenter;
    f32[2] RightScreenCenter;
    f32[2] Scale;
    f32[2] ScaleIn;
}

[Platform, StructLayout(C)]
public struct FilePathList {
    u32[0 max] Capacity;
    u32[0 max] Count;
    rawmutptr<rawptr<i8[min max]>> Paths;
}

[StructLayout(C)]
public struct AutomationEvent {
    u32[0 max] Frame;
    u32[0 max] Type;
    i32[min max][4] Params;
}

[StructLayout(C)]
public struct AutomationEventList {
    u32[0 max] Capacity;
    u32[0 max] Count;
    rawmutptr<AutomationEvent> Events;
}

public enum RaylibStatus {
    Ok,
    TooManyItems,
    InvalidArgument,
}

public struct CollisionPointResult {
    bool Hit;
    Vector2 Point;
}

public alias Quaternion = Vector4;
public alias Texture2D = Texture;
public alias TextureCubemap = Texture;
public alias RenderTexture2D = RenderTexture;
public alias Camera = Camera3D;

public alias TraceLogCallback = rawptr<i8[min max]>;
public alias LoadFileDataCallback = rawptr<i8[min max]>;
public alias SaveFileDataCallback = rawptr<i8[min max]>;
public alias LoadFileTextCallback = rawptr<i8[min max]>;
public alias SaveFileTextCallback = rawptr<i8[min max]>;
public alias AudioCallback = rawptr<i8[min max]>;

