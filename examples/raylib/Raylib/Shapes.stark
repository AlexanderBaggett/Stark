internal ffi fn void stark_raylib_SetShapesTexture(rawptr<Texture2D> texture, rawptr<Rectangle> source);
public fn void SetShapesTexture(Texture2D texture, Rectangle source) {
    stark_raylib_SetShapesTexture(&texture, &source);
    return;
}

internal ffi fn void stark_raylib_GetShapesTexture(rawmutptr<Texture2D> result);
public fn Texture2D GetShapesTexture() {
    stack mut Texture2D result = DefaultTexture();
    stark_raylib_GetShapesTexture(&result);
    return result;
}

