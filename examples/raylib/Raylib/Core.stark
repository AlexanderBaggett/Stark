// Raylib returns C long here. Keep the FFI declaration header-shaped and widen
// at the safe Stark wrapper boundary so this stays correct on LP64 and LLP64.
[LinkName("GetFileModTime")]
internal unsafe ffi(c) fn System.C.c_long stark_raylib_GetFileModTime(ascii fileName);
public fn i64[min max] GetFileModTime(ascii fileName) {
    unsafe {
        stack System.C.c_long nativeTime = stark_raylib_GetFileModTime(fileName);
        return (i64[min max])nativeTime;
    }
}
