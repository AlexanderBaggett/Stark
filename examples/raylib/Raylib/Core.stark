internal unsafe ffi fn void stark_raylib_UpdateCamera(rawmutptr<Camera> camera, i32[min max] mode);
public fn Camera UpdateCamera(Camera camera, i32[min max] mode) {
    stack mut Camera result = camera;
    unsafe {
        stark_raylib_UpdateCamera(&result, mode);
    }
    return result;
}

