import System
module BuildYourOwnGitCommit

fn bool WriteDemoCommitObject() {
    stack mut System.IO.File.File file =
        System.IO.File.Open("starkgit-demo/.starkgit/objects/demo-commit", System.IO.File.FileMode.Write);

    if (!file.IsOpen()) {
        return false;
    }

    file.WriteLine("tree empty");
    file.WriteLine("author Stark Example");
    file.WriteLine("");
    file.WriteLine("initial commit");
    return file.Close() == 0;
}

export ffi fn i32[min max] main() {
    if (!WriteDemoCommitObject()) {
        return 1;
    }

    if (System.Console.WriteLine("Wrote demo commit object") != System.IO.IOStatus.Ok) {
        return 2;
    }

    return 0;
}
