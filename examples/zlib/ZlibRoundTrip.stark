import System.Console
import System.IO
import Vendor.Zlib
module ZlibRoundTrip

fn bool SamePrefix(
    borrow i8[min max][] left,
    borrow i8[min max][] right,
    u64[0 2 ** 63 - 1] count)
{
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (left[index] != right[index])
        {
            return false;
        }
    }

    return true;
}

fn i32[min max] VerifyBlockRoundTrip(
    borrow i8[min max][] sourceBytes,
    borrow mut i8[min max][] compressedBuffer,
    borrow mut i8[min max][] restoredBuffer)
{
    switch (MaxCompressedSize(sourceBytes.Length))
    {
        case ZlibBlockResult.Err(var error):
            return 1;
        case ZlibBlockResult.Ok(var bound):
            if ((u64[0 2 ** 63 - 1])bound > compressedBuffer.Length)
            {
                return 2;
            }
    }

    switch (CompressBlock(sourceBytes, compressedBuffer, CompressionLevel.BestSpeed))
    {
        case ZlibBlockResult.Err(var error):
            return 3;
        case ZlibBlockResult.Ok(var compressedLength):
            switch (DecompressBlockPrefix(compressedBuffer, compressedLength, restoredBuffer))
            {
                case ZlibBlockResult.Err(var restoreError):
                    return 4;
                case ZlibBlockResult.Ok(var restoredLength):
                    if ((u64[0 2 ** 63 - 1])restoredLength != sourceBytes.Length)
                    {
                        return 5;
                    }
            }
    }

    if (!SamePrefix(sourceBytes, restoredBuffer, sourceBytes.Length))
    {
        return 6;
    }

    return 0;
}

fn i32[min max] VerifyStreamingRoundTrip(
    borrow i8[min max][] sourceBytes,
    borrow mut i8[min max][] compressedBuffer,
    borrow mut i8[min max][] restoredBuffer)
{
    stack mut DeflateStream encoder = new();
    switch (StartDeflate(CompressionLevel.BestCompression))
    {
        case DeflateStreamResult.Err(var error):
            return 10;
        case DeflateStreamResult.Ok(var stream):
            encoder = stream;
    }

    stack mut u32[0 max] compressedLength = 0;
    switch (DeflateChunk(
        encoder,
        sourceBytes,
        (u32[0 max])sourceBytes.Length,
        compressedBuffer,
        ZlibFlush.Finish))
    {
        case ZlibStreamStepResult.Err(var error):
            CloseDeflate(encoder);
            return 11;
        case ZlibStreamStepResult.Ok(var step):
            if (!step.Finished || (u64[0 2 ** 63 - 1])step.Consumed != sourceBytes.Length)
            {
                CloseDeflate(encoder);
                return 12;
            }

            compressedLength = step.Produced;
    }

    if (CloseDeflate(encoder) != ZlibStatusResult.Ok)
    {
        return 13;
    }

    stack mut InflateStream decoder = new();
    switch (StartInflate())
    {
        case InflateStreamResult.Err(var error):
            return 14;
        case InflateStreamResult.Ok(var stream):
            decoder = stream;
    }

    switch (InflateChunk(
        decoder,
        compressedBuffer,
        compressedLength,
        restoredBuffer,
        ZlibFlush.Finish))
    {
        case ZlibStreamStepResult.Err(var error):
            CloseInflate(decoder);
            return 15;
        case ZlibStreamStepResult.Ok(var step):
            if (!step.Finished || step.Consumed != compressedLength)
            {
                CloseInflate(decoder);
                return 16;
            }

            if ((u64[0 2 ** 63 - 1])step.Produced != sourceBytes.Length)
            {
                CloseInflate(decoder);
                return 17;
            }
    }

    if (CloseInflate(decoder) != ZlibStatusResult.Ok)
    {
        return 18;
    }

    if (!SamePrefix(sourceBytes, restoredBuffer, sourceBytes.Length))
    {
        return 19;
    }

    return 0;
}

export fn i32[min max] main()
{
    stack mut i8[min max][40] source =
    {
        83, 116, 97, 114, 107, 45, 90, 108,
        105, 98, 45, 114, 111, 117, 110, 100,
        45, 116, 114, 105, 112, 45, 112, 97,
        121, 108, 111, 97, 100, 45, 112, 97,
        121, 108, 111, 97, 100, 33, 33, 10
    };
    stack mut i8[min max][128] compressed = { 0 };
    stack mut i8[min max][40] restored = { 0 };
    stack i8[min max][] sourceBytes = source;
    stack mut i8[min max][] compressedBuffer = compressed;
    stack mut i8[min max][] restoredBuffer = restored;

    stack i32[min max] blockStatus = VerifyBlockRoundTrip(sourceBytes, compressedBuffer, restoredBuffer);
    if (blockStatus != 0)
    {
        return blockStatus;
    }

    stack i32[min max] streamStatus = VerifyStreamingRoundTrip(sourceBytes, compressedBuffer, restoredBuffer);
    if (streamStatus != 0)
    {
        return streamStatus;
    }

    if (System.Console.WriteLine("Zlib round trip ok") != System.IO.IOStatus.Ok)
    {
        return 20;
    }

    return 0;
}
