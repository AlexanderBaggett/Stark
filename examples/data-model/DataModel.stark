module DataModel

struct Box {
    i32[-2147483648 2147483647] Width;
    i32[-2147483648 2147483647] Height;
}

record Point(i32[-2147483648 2147483647] X, i32[-2147483648 2147483647] Y) { }

export ffi fn i32[-2147483648 2147483647] main() {
    stack Box box = new Box() { Width = 3, Height = 4 };
    stack Point point = new Point() { X = 1, Y = 2 };
    return box.Width * box.Height + point.X + point.Y;
}
