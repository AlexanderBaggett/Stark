// stark-bench: compile-only
import System.Experimental.Console
import System.Experimental.Runtime.Buffer
import System.Experimental.Text
import System.Memory
module Benchmarks.Console.ExperimentalConsoleReadSurface

fn System.Memory.MemoryResult<System.Experimental.Text.OwnedUnicode> ReadUnicodeLineExperimental() {
    return System.Experimental.Console.ReadLine();
}

fn System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii> ReadAsciiLineExperimental() {
    return System.Experimental.Console.ReadAsciiLine();
}

fn System.Memory.MemoryResult<System.Experimental.Text.OwnedUnicode> ReadUnitExperimental() {
    return System.Experimental.Console.Read();
}

fn System.Memory.MemoryResult<i64[0 max]> ReadDynamicBytes(
    mut borrow System.Experimental.Runtime.Buffer.DynamicByteBuffer destination) {
    return System.Experimental.Console.ReadBytes(destination, 4096);
}

fn System.Memory.MemoryResult<i64[0 max]> ReadFixedBytes(
    mut borrow System.Experimental.Runtime.Buffer.FixedByteBuffer8192 destination) {
    return System.Experimental.Console.ReadBytes(destination, 4096);
}
