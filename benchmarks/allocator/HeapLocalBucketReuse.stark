module Benchmarks.Allocator.HeapLocalBucketReuse

struct Box {
    i64[min max] Value;
}

export unsafe ffi fn i32[min max] main() {
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut u16[0 20000] i = 0; i < 20000; i += 1) {
        heap Box box = new Box() {
            Value = (i64[min max])i
        };
        checksum = checksum + box.Value;
    }

    if (checksum != 199990000) {
        return 1;
    }

    return 0;
}
