import System.Process
module Benchmarks.Micro.StackNestedFieldForwarding

record Inner(i64[min max] Value, i64[min max] Salt) { }
record Outer(Inner Left, Inner Right) { }

finite law i64[min max] Accumulate(i64[min max] seed, i64[min max] salt) {
    stack mut Outer outer = new Outer(new Inner(seed, salt), new Inner(salt, seed));
    outer.Left.Value = outer.Left.Value + outer.Right.Salt;
    stack i64[min max] first = outer.Left.Value;
    outer.Right.Value = first ^ (outer.Right.Value >> 5);
    return outer.Left.Value + outer.Right.Value + outer.Left.Salt;
}

export ffi fn i32[min max] main() {
    stack mut i64[min max] total = (i64[min max])System.Process.CurrentId();

    for willexit (stack mut i32[0 200000] i = 0; i < 200000; i += 1) {
        total += Accumulate(total % 1000000007, (i64[min max])i);
        total = total % 1000000007;
    }

    if (total <= 0) {
        return 1;
    }

    return 0;
}
