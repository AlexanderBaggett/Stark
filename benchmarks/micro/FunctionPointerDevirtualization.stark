module Benchmarks.Micro.FunctionPointerDevirtualization

noinline unsafe finite law i64[min max] Mix(i64[min max] value, i64[min max] salt) {
    return ((value * 31) + salt) % 1000003;
}

export unsafe ffi fn i32[min max] main() {
    stack mut i64[min max] total = 17;

    for willexit (stack mut i32[0 200000] i = 0; i < 200000; i += 1) {
        stack mut fnptr<finite law i64[min max](i64[min max], i64[min max])> op = Mix;
        if ((i % 2) != 0) {
            op = Mix;
        }

        total += op((i64[min max])i, total % 97);
        total = total % 1000000007;
    }

    if (total != 420921655) {
        return 1;
    }

    return 0;
}
