import System.Process
module Benchmarks.Micro.NullBranchPruning

unsafe noinline finite law i32[min max] Score(rawmutptr<i64[min max]> ptr, i64[min max] seed) {
    if (ptr != null) {
        if (ptr == null) {
            return 1;
        }

        return (i32[min max])((seed & 7) + 2);
    }

    return 0;
}

export unsafe ffi fn i32[min max] main() {
    stack mut i64[min max] total = (i64[min max])System.Process.CurrentId();
    stack mut i64[min max] slot = total;
    stack rawmutptr<i64[min max]> ptr = &slot;

    for willexit (stack mut u24[0 200000] i = 0; i < 200000; i += 1) {
        total += Score(ptr, total + (i64[min max])i);
        total = total % 1000000007;
    }

    if (total <= 0) {
        return 1;
    }

    return 0;
}
