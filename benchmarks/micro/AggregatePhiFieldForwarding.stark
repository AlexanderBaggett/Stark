import System.Process
module Benchmarks.Micro.AggregatePhiFieldForwarding

struct Pair {
    i64[min max] Value;
    i64[min max] Tag;
}

finite law i64[min max] ReadValue(bool flag, i64[min max] value, i64[min max] tag) {
    stack Pair pair = flag
        ? new Pair() { Value = value, Tag = tag }
        : new Pair() { Value = value, Tag = tag + 1 };
    return pair.Value;
}

export unsafe ffi fn i32[min max] main() {
    stack mut i64[min max] total = (i64[min max])System.Process.CurrentId();

    for willexit (stack mut u24[0 300000] i = 0; i < 300000; i += 1) {
        total += ReadValue((i & 1) == 0, total % 1000000007, (i64[min max])i);
        total = total % 1000000007;
    }

    if (total <= 0) {
        return 1;
    }

    return 0;
}
