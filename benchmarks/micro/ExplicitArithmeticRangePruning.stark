import System.Process
module Benchmarks.Micro.ExplicitArithmeticRangePruning

unsafe finite law i64[min max] Score(i32[0 10] left, i32[0 5] right, i64[min max] salt) {
    stack i32[-2147483648 2147483647] saturated = left +| right;
    stack i32[-2147483648 2147483647] wrapped = left +% right;

    if (saturated > 15) {
        return salt - 10000;
    }

    if (wrapped > 15) {
        return salt - 20000;
    }

    return (((i64[min max])saturated * 37) + ((i64[min max])wrapped * 17) + salt) % 1000003;
}

export unsafe ffi fn i32[min max] main() {
    stack mut i64[min max] total = (i64[min max])System.Process.CurrentId();

    for willexit (stack mut i32[0 200000] i = 0; i < 200000; i += 1) {
        total += Score((i32[0 10])(i % 11), (i32[0 5])(i % 6), total % 97);
        total = total % 1000000007;
    }

    if (total <= 0) {
        return 1;
    }

    return 0;
}
