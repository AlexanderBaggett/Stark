import System.Process
import System.Text
module Benchmarks.Micro.TextLiteralLengthPruning

finite law i64[min max] Score(i64[min max] salt) {
    stack mut i64[min max] adjusted = salt;

    if (System.Text.AsciiLength("stark-performance") == 17) {
        adjusted = (adjusted + 51) % 1000003;
    } else {
        adjusted -= 100000;
    }

    if (System.Text.UnicodeLength((unicode)"llvm-output") != 11) {
        return adjusted - 77777;
    }

    return ((adjusted + 11) * 17) % 1000003;
}

export ffi fn i32[min max] main() {
    stack mut i64[min max] total = (i64[min max])System.Process.CurrentId();

    for willexit (stack mut i32[0 200000] i = 0; i < 200000; i += 1) {
        total += Score(total + (i64[min max])i);
        total = total % 1000000007;
    }

    if (total <= 0) {
        return 1;
    }

    return 0;
}
