import System.Process
module Benchmarks.Micro.Branching

export unsafe ffi fn i32[min max] main() {
    stack i32[min max] seed = System.Process.CurrentId() % 13;
    stack mut i64[min max] score = 0;

    for willexit (stack mut i32[0 200000] i = 0; i < 200000; i += 1) {
        stack i32[min max] value = (i + seed) % 10;

        if (value < 3) {
            score += 3;
        } else if (value < 7) {
            score += 5;
        } else {
            score += 7;
        }

        switch (value) {
            case 0:
                score += 11;
            case 1:
                score += 13;
            default:
                score += 17;
        }
    }

    if (score <= 0) {
        return 1;
    }

    return 0;
}
