import System.Process
module Benchmarks.Micro.FactDrivenBranchPruning

finite law i64[min max] Score(i32[0 10] value, i64[min max] salt) {
    if (value < 20) {
        return (((i64[min max])value * 37) + salt) % 1000003;
    }

    return salt - 1000;
}

finite law i64[min max] SwitchScore(i32[10 12] value, i64[min max] salt) {
    stack i32[-2147483648 2147483647] widened = (i32[-2147483648 2147483647])value;
    switch (widened) {
        case 10:
            return salt + 10;
        case 40:
            return salt + 40;
        case 41:
            return salt + 41;
        default:
            return salt - 3;
    }
}

finite law i64[min max] NestedScore(i32[0 20] value, i64[min max] salt) {
    if (value < 10) {
        if (value >= 10) {
            return salt - 10000;
        }

        return (((i64[min max])value * 13) + salt) % 1000003;
    }

    return salt + (i64[min max])value;
}

export ffi fn i32[min max] main() {
    stack mut i64[min max] total = (i64[min max])System.Process.CurrentId();

    for willexit (stack mut i32[0 200000] i = 0; i < 200000; i += 1) {
        total += Score((i32[0 10])(i % 11), total % 97);
        total += SwitchScore((i32[10 12])(10 + (i % 3)), total % 31);
        total += NestedScore((i32[0 20])(i % 21), total % 53);
        total = total % 1000000007;
    }

    if (total <= 0) {
        return 1;
    }

    return 0;
}
