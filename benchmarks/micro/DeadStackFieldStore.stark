import System.Process
module Benchmarks.Micro.DeadStackFieldStore

record Pair(i64[min max] Left, i64[min max] Right) { }

unsafe finite law i64[min max] Accumulate(i64[min max] seed, i64[min max] salt) {
    stack mut Pair pair = new Pair(seed, salt);
    pair.Left = seed + salt;
    pair.Right = seed ^ salt;
    return ((seed * 3) + salt) % 1000000007;
}

export unsafe ffi fn i32[min max] main() {
    stack mut i64[min max] total = (i64[min max])System.Process.CurrentId();

    for willexit (stack mut u24[0 250000] i = 0; i < 250000; i += 1) {
        total += Accumulate(total, (i64[min max])i);
        total = total % 1000000007;
    }

    if (total <= 0) {
        return 1;
    }

    return 0;
}
