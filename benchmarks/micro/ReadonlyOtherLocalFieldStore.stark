import System.Process
module Benchmarks.Micro.ReadonlyOtherLocalFieldStore

record Box(i64[min max] Value) { }

noinline finite law i64[min max] ReadValue(borrow Box box) {
    return box.Value;
}

finite law i64[min max] Accumulate(i64[min max] seed, i64[min max] salt) {
    stack mut Box left = new Box(seed);
    stack mut Box right = new Box(salt);
    left.Value = seed + salt;
    stack i64[min max] observed = ReadValue(right);
    left.Value = (seed ^ observed) + 17;
    return left.Value + observed;
}

export unsafe ffi fn i32[min max] main() {
    stack mut i64[min max] total = (i64[min max])System.Process.CurrentId();

    for willexit (stack mut u24[0 200000] i = 0; i < 200000; i += 1) {
        total += Accumulate(total % 1000000007, (i64[min max])i);
        total = total % 1000000007;
    }

    if (total <= 0) {
        return 1;
    }

    return 0;
}
