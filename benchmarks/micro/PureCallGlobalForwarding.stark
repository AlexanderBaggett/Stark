import System.Process
module Benchmarks.Micro.PureCallGlobalForwarding

static mut i64[min max] Counter = 1;

noinline finite law i64[min max] Mix(i64[min max] value) {
    return (value ^ (value >> 7)) + 17;
}

finite i64[min max] Accumulate(i64[min max] salt) {
    Counter = (Counter + salt) % 1000000007;
    stack i64[min max] first = Counter;
    stack i64[min max] mixed = Mix(first);
    stack i64[min max] second = Counter;
    return mixed + first + second;
}

export ffi fn i32[min max] main() {
    Counter = (i64[min max])(System.Process.CurrentId() % 31) + 1;
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 200000] i = 0; i < 200000; i += 1) {
        checksum += Accumulate((i64[min max])(i % 97));
        checksum = checksum % 1000000007;
    }

    if (checksum <= 0) {
        return 1;
    }

    return 0;
}
