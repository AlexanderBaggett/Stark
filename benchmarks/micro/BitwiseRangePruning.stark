import System.Process
module Benchmarks.Micro.BitwiseRangePruning

finite law i64[min max] Score(u16[0 1023] value, i64[min max] salt) {
    stack u16[0 2047] masked = (u16[0 2047])(value & 255);
    stack u16[0 2047] shifted = (u16[0 2047])(masked << 1);
    stack u16[0 2047] folded = (u16[0 2047])(shifted | (value & 3));
    stack u16[0 4095] forced = (u16[0 4095])(folded | 2048);

    if (forced == 0) {
        return salt - 1;
    }

    if (folded < 512) {
        return salt + (i64[min max])folded;
    }

    return salt - (i64[min max])folded;
}

export unsafe ffi fn i32[min max] main() {
    stack mut i64[min max] total = (i64[min max])System.Process.CurrentId();

    for willexit (stack mut u24[0 200000] i = 0; i < 200000; i += 1) {
        total += Score((u16[0 1023])(i % 1024), total % 97);
        total = total % 1000000007;
    }

    if (total <= 0) {
        return 1;
    }

    return 0;
}
