import System.Experimental.FileSystem
import System.Experimental.IO.File
import System.Experimental.IO.Path
import System.Experimental.Text
import System.IO
import System.Memory
module Benchmarks.IO.ExperimentalFileSystemPathTranscode

const Iterations = 16;

fn bool IOOk(System.IO.IOStatus status) {
    switch (status) {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var error):
            return false;
    }
}

fn bool BoolOrFalse(System.IO.IOResult<bool> result) {
    switch (result) {
        case System.IO.IOResult<bool>.Ok(var value):
            return value;
        case System.IO.IOResult<bool>.Err(var error):
            return false;
    }
}

fn i64[min max] PathLength(System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii> result) {
    switch (result) {
        case System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii>.Ok(var value):
            return (i64[min max])value.Length();
        case System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii>.Err(var error):
            return -1;
    }
}

fn i64[min max] FirstEntryLength(System.Experimental.FileSystem.DirectoryReadResult result) {
    switch (result) {
        case System.Experimental.FileSystem.DirectoryReadResult.Entry(var entry):
            return (i64[min max])entry.Name.Length();
        case System.Experimental.FileSystem.DirectoryReadResult.End:
            return -1;
        case System.Experimental.FileSystem.DirectoryReadResult.Err(var error):
            return -1;
    }
}

export ffi fn i32[min max] main() {
    stack mut i64[min max] checksum = 0;
    System.Experimental.IO.File.Delete("experimental-io-bench-root/renamed.txt");
    System.Experimental.IO.File.Delete("experimental-io-bench-root/child.txt");
    System.Experimental.FileSystem.DeleteDirectory("experimental-io-bench-root");

    for willexit (stack mut i32[0 16] iteration = 0; iteration < Iterations; iteration += 1) {
        if (!IOOk(System.Experimental.FileSystem.CreateDirectory("experimental-io-bench-root"))) {
            return 1;
        }

        stack System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii> joined =
            System.Experimental.IO.Path.Join("experimental-io-bench-root", "child.txt");
        switch (joined) {
            case System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii>.Err(var joinError):
                return 2;
            case System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii>.Ok(var joinedPath):
                checksum += (i64[min max])joinedPath.Length();
                stack ascii childPath = joinedPath.View();
                stack System.IO.IOResult<System.Experimental.IO.File.File> opened =
                    System.Experimental.IO.File.Open(
                        childPath,
                        System.Experimental.IO.File.FileMode.Write,
                        System.Experimental.Text.Encoding.UTF16,
                        System.Experimental.IO.File.FileBuffering.None);
                switch (opened) {
                    case System.IO.IOResult<System.Experimental.IO.File.File>.Err(var openError):
                        return 3;
                    case System.IO.IOResult<System.Experimental.IO.File.File>.Ok(var value):
                        stack mut System.Experimental.IO.File.File writer = value;
                        if (!IOOk(writer.WriteLine("child"))
                            || !IOOk(writer.WriteLine((unicode)"wide"))
                            || !IOOk(writer.Close())) {
                            return 4;
                        }
                }

                if (!BoolOrFalse(System.Experimental.FileSystem.IsFile(childPath))) {
                    return 5;
                }
        }

        stack System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii> normalized =
            System.Experimental.IO.Path.NormalizeSeparators("experimental-io-bench-root//child.txt");
        checksum += PathLength(normalized);

        stack System.IO.IOResult<System.Experimental.FileSystem.Directory> directoryResult =
            System.Experimental.FileSystem.OpenDirectory("experimental-io-bench-root");
        switch (directoryResult) {
            case System.IO.IOResult<System.Experimental.FileSystem.Directory>.Err(var directoryError):
                return 6;
            case System.IO.IOResult<System.Experimental.FileSystem.Directory>.Ok(var directoryValue):
                stack mut System.Experimental.FileSystem.Directory directory = directoryValue;
                checksum += FirstEntryLength(directory.ReadNext());
                if (!IOOk(directory.Close())) {
                    return 7;
                }
        }

        if (!IOOk(System.Experimental.FileSystem.Move(
            "experimental-io-bench-root/child.txt",
            "experimental-io-bench-root/renamed.txt"))) {
            return 8;
        }

        if (!IOOk(System.Experimental.IO.File.Delete("experimental-io-bench-root/renamed.txt"))
            || !IOOk(System.Experimental.FileSystem.DeleteDirectory("experimental-io-bench-root"))) {
            return 9;
        }
    }

    if (checksum != 1296) {
        return 10;
    }

    return 0;
}
