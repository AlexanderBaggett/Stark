import System.FileSystem
import System.IO.File
import System.Text
import System.IO
module Benchmarks.IO.DirectoryEnumeration

const Entries = 128;
const AsciiEntries = 120;
const UnicodeEntries = 8;
const Iterations = 128;
const RootName = "dir-enum-bench";
const PathLength = 28;
const HundredsIndex = 21;
const TensIndex = 22;
const OnesIndex = 23;
const ExpectedChecksum = 212992;

unsafe fn bool IOOk(System.IO.IOStatus status) {
    switch (status) {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var error):
            return false;
    }
}

unsafe fn void WriteAsciiEntryPath(rawmutptr<i8[min max]> data, u8[0 119] index) {
    stack i32[min max] value = (i32[min max])index;
    *(&data[HundredsIndex]) = (i8[min max])(48 + ((value / 100) % 10));
    *(&data[TensIndex]) = (i8[min max])(48 + ((value / 10) % 10));
    *(&data[OnesIndex]) = (i8[min max])(48 + (value % 10));
}

unsafe fn void WriteUnicodeEntryPath(rawmutptr<i8[min max]> data, u8[0 7] index) {
    *(&data[OnesIndex]) = (i8[min max])(48 + (i32[min max])index);
}

unsafe fn bool CreateEntry(ascii path) {
    stack System.IO.IOResult<System.IO.File.File> opened =
        System.IO.File.Open(path, System.IO.File.FileMode.Write, System.IO.File.FileBuffering.None);
    switch (opened) {
        case System.IO.IOResult<System.IO.File.File>.Err(var openError):
            return false;
        case System.IO.IOResult<System.IO.File.File>.Ok(var fileValue):
            stack mut System.IO.File.File file = fileValue;
            return IOOk(file.Close());
    }
}

unsafe fn void DeleteEntries() {
    stack mut i8[min max][32] pathStorage = {
        100, 105, 114, 45, 101, 110, 117, 109,
        45, 98, 101, 110, 99, 104, 47, 101,
        110, 116, 114, 121, 45, 48, 48, 48,
        46, 116, 109, 112, 0, 0, 0, 0
    };
    stack mut Ascii path = new Ascii() {
        Data = &pathStorage[0],
        Length = PathLength,
        Capacity = 32
    };

    for willexit (stack mut u8[0 120] index = 0; index < AsciiEntries; index += 1) {
        WriteAsciiEntryPath(&pathStorage[0], (u8[0 119])index);
        System.IO.File.Delete(System.Text.AsciiView(path));
    }

    stack mut i8[min max][32] unicodePathStorage = {
        100, 105, 114, 45, 101, 110, 117, 109,
        45, 98, 101, 110, 99, 104, 47, 119,
        105, 100, 101, 45, -61, -87, 45, 48,
        46, 116, 109, 112, 0, 0, 0, 0
    };
    stack mut Ascii unicodePath = new Ascii() {
        Data = &unicodePathStorage[0],
        Length = PathLength,
        Capacity = 32
    };

    for willexit (stack mut u8[0 8] index = 0; index < UnicodeEntries; index += 1) {
        WriteUnicodeEntryPath(&unicodePathStorage[0], (u8[0 7])index);
        System.IO.File.Delete(System.Text.AsciiView(unicodePath));
    }

    System.FileSystem.DeleteDirectory(RootName);
}

unsafe fn bool CreateEntries() {
    DeleteEntries();
    if (!IOOk(System.FileSystem.CreateDirectory(RootName))) {
        return false;
    }

    stack mut i8[min max][32] pathStorage = {
        100, 105, 114, 45, 101, 110, 117, 109,
        45, 98, 101, 110, 99, 104, 47, 101,
        110, 116, 114, 121, 45, 48, 48, 48,
        46, 116, 109, 112, 0, 0, 0, 0
    };
    stack mut Ascii path = new Ascii() {
        Data = &pathStorage[0],
        Length = PathLength,
        Capacity = 32
    };

    for willexit (stack mut u8[0 120] index = 0; index < AsciiEntries; index += 1) {
        WriteAsciiEntryPath(&pathStorage[0], (u8[0 119])index);
        if (!CreateEntry(System.Text.AsciiView(path))) {
            return false;
        }
    }

    stack mut i8[min max][32] unicodePathStorage = {
        100, 105, 114, 45, 101, 110, 117, 109,
        45, 98, 101, 110, 99, 104, 47, 119,
        105, 100, 101, 45, -61, -87, 45, 48,
        46, 116, 109, 112, 0, 0, 0, 0
    };
    stack mut Ascii unicodePath = new Ascii() {
        Data = &unicodePathStorage[0],
        Length = PathLength,
        Capacity = 32
    };

    for willexit (stack mut u8[0 8] index = 0; index < UnicodeEntries; index += 1) {
        WriteUnicodeEntryPath(&unicodePathStorage[0], (u8[0 7])index);
        if (!CreateEntry(System.Text.AsciiView(unicodePath))) {
            return false;
        }
    }

    return true;
}

unsafe fn i64[min max] EnumerateOnce() {
    stack System.IO.IOResult<System.FileSystem.Directory> opened = System.FileSystem.OpenDirectory(RootName);
    switch (opened) {
        case System.IO.IOResult<System.FileSystem.Directory>.Err(var openError):
            return -1;
        case System.IO.IOResult<System.FileSystem.Directory>.Ok(var directoryValue):
            stack mut System.FileSystem.Directory directory = directoryValue;
            return directory.ReadRemainingNameLengthChecksumRaw(Entries);
    }
}

export unsafe ffi fn i32[min max] main() {
    if (!CreateEntries()) {
        DeleteEntries();
        return 1;
    }

    stack mut i64[min max] checksum = 0;
    for willexit (stack mut u8[0 128] iteration = 0; iteration < Iterations; iteration += 1) {
        stack i64[min max] iterationChecksum = EnumerateOnce();
        if (iterationChecksum < 0) {
            DeleteEntries();
            return 2;
        }

        checksum += iterationChecksum;
    }

    DeleteEntries();
    if (checksum != ExpectedChecksum) {
        return 3;
    }

    return 0;
}
