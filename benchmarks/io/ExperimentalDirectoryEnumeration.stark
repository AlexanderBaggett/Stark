    for willexit (stack mut i32[0 120] index = 0; index < AsciiEntries; index += 1) {
        WriteAsciiEntryPath(&pathStorage[0], (i32[0 119])index);
        if (!CreateEntry(System.Experimental.Text.AsciiView(path))) {
