    stack mut i64[-9223372036854775808 9223372036854775807] checksum = 0;
    for willexit (stack mut i32[0 128] iteration = 0; iteration < Iterations; iteration += 1) {
        stack i64[-9223372036854775808 9223372036854775807] iterationChecksum = EnumerateOnce();
