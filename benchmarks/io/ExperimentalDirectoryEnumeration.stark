fn i64[-9223372036854775808 9223372036854775807] EntryLength(System.Experimental.FileSystem.DirectoryReadInfoResult result) {
    switch (result) {
        case System.Experimental.FileSystem.DirectoryReadInfoResult.Entry(var entry):
            return (i64[-9223372036854775808 9223372036854775807])entry.NameLength;
        case System.Experimental.FileSystem.DirectoryReadInfoResult.End:
            return -1;
        case System.Experimental.FileSystem.DirectoryReadInfoResult.Err(var error):
            return -1;
    }
}

fn bool IsEnd(System.Experimental.FileSystem.DirectoryReadInfoResult result) {
    switch (result) {
        case System.Experimental.FileSystem.DirectoryReadInfoResult.Entry(var entry):
            return false;
        case System.Experimental.FileSystem.DirectoryReadInfoResult.End:
            return true;
        case System.Experimental.FileSystem.DirectoryReadInfoResult.Err(var error):
            return false;
    }
}

fn i64[-9223372036854775808 9223372036854775807] EnumerateOnce() {
    stack System.IO.IOResult<System.Experimental.FileSystem.Directory> opened = System.Experimental.FileSystem.OpenDirectory(RootName);
    switch (opened) {
        case System.IO.IOResult<System.Experimental.FileSystem.Directory>.Err(var openError):
            return -1;
        case System.IO.IOResult<System.Experimental.FileSystem.Directory>.Ok(var directoryValue):
            stack mut System.Experimental.FileSystem.Directory directory = directoryValue;
            stack mut i64[-9223372036854775808 9223372036854775807] checksum = 0;
            stack mut i64[-9223372036854775808 9223372036854775807] count = 0;

            for willexit (stack mut i32[0 128] index = 0; index < Entries; index += 1) {
                stack i64[-9223372036854775808 9223372036854775807] length = EntryLength(directory.ReadNextInfo());
                if (length < 0) {
                    directory.Close();
                    return -1;
                }

                checksum += length;
                count += 1;
