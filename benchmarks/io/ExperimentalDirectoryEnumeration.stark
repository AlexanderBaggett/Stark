    *(&data[OnesIndex]) = (i8[-128 127])(48 + (value % 10));
}

fn void WriteUnicodeEntryPath(rawmutptr<i8[-128 127]> data, i32[0 7] index) {
    *(&data[OnesIndex]) = (i8[-128 127])(48 + (i32[-2147483648 2147483647])index);
}

fn bool CreateEntry(ascii path) {
    stack System.IO.IOResult<System.Experimental.IO.File.File> opened =
        System.Experimental.IO.File.Open(path, System.Experimental.IO.File.FileMode.Write, System.Experimental.IO.File.FileBuffering.None);
    switch (opened) {
        case System.IO.IOResult<System.Experimental.IO.File.File>.Err(var openError):
            return false;
        case System.IO.IOResult<System.Experimental.IO.File.File>.Ok(var fileValue):
            stack mut System.Experimental.IO.File.File file = fileValue;
            return IOOk(file.Close());
    }
}

