            if (count != Entries || !IsEnd(directory.ReadNextInfo())) {
                directory.Close();
                return -1;
            }

            if (!IOOk(directory.Close())) {
                return -1;
            }

            return checksum;
    }
}

export ffi fn i32[-2147483648 2147483647] main() {
    if (!CreateEntries()) {
