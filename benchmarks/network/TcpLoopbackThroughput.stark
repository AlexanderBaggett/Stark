import System
import System.Net.Tcp
import System.Runtime.Buffer
import System.Memory
import System.Net
import System.Process
module Benchmarks.Network.TcpLoopbackThroughput

const ChunkBytes = 4096;
const Iterations = 256;
const ExpectedBytes = 1048576;

unsafe fn System.Net.IPv4Endpoint LoopbackEndpoint(u8[0 63] attempt) {
    stack i32[min max] processId = System.Process.CurrentId();
    stack mut u32[0 max] positiveProcessId = 0;
    if (processId > 0) {
        positiveProcessId = (u32[0 max])processId;
    }

    stack u16[0 max] port = (u16[0 max])(41000 + (positiveProcessId % 20000) + attempt);
    return new System.Net.IPv4Endpoint() {
        Address = new System.Net.IPv4Address() {
            A = 127,
            B = 0,
            C = 0,
            D = 1
        },
        Port = port
    };
}

unsafe fn bool MemoryOk(System.Memory.MemoryStatus status) {
    switch (status) {
        case System.Memory.MemoryStatus.Ok:
            return true;
        case System.Memory.MemoryStatus.Err(var error):
            return false;
    }
}

export unsafe ffi fn i32[min max] main() {
    stack mut System.Runtime.Buffer.FixedByteBuffer4096 writeBuffer = new();
    if (!MemoryOk(writeBuffer.WriteFill(0, ChunkBytes))) {
        return 9;
    }

    stack mut u8[0 63] attempt = 0;
    while willexit (attempt < 64) {
        stack System.Net.IPv4Endpoint endpoint = LoopbackEndpoint(attempt);
        stack System.Net.NetResult<System.Net.Tcp.TcpListener> listening =
            System.Net.Tcp.TcpListener.Listen(endpoint);

        switch (listening) {
            case System.Net.NetResult<System.Net.Tcp.TcpListener>.Err(var listenError):
                attempt += 1;
            case System.Net.NetResult<System.Net.Tcp.TcpListener>.Ok(var listenerValue):
                stack mut System.Net.Tcp.TcpListener listener = listenerValue;
                stack System.Net.NetResult<System.Net.Tcp.TcpClient> connected =
                    System.Net.Tcp.TcpClient.Connect(LoopbackEndpoint(attempt));

                switch (connected) {
                    case System.Net.NetResult<System.Net.Tcp.TcpClient>.Err(var connectError):
                        listener.Close();
                        return 2;
                    case System.Net.NetResult<System.Net.Tcp.TcpClient>.Ok(var clientValue):
                        stack mut System.Net.Tcp.TcpClient client = clientValue;
                        stack System.Net.NetResult<System.Net.Tcp.TcpClient> accepted = listener.Accept();
                        listener.Close();

                        switch (accepted) {
                            case System.Net.NetResult<System.Net.Tcp.TcpClient>.Err(var acceptError):
                                client.Close();
                                return 3;
                            case System.Net.NetResult<System.Net.Tcp.TcpClient>.Ok(var serverValue):
                                stack mut System.Net.Tcp.TcpClient server = serverValue;
                                stack mut u64[0 2 ** 63 - 1] totalRead = 0;

                                for willexit (stack mut u16[0 256] iteration = 0; iteration < Iterations; iteration += 1) {
                                    stack System.Net.NetResult<u64[0 2 ** 63 - 1]> written = client.Write(writeBuffer);
                                    switch (written) {
                                        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var writeError):
                                            server.Close();
                                            client.Close();
                                            return 4;
                                        case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var writtenBytes):
                                            if (writtenBytes != ChunkBytes) {
                                                server.Close();
                                                client.Close();
                                                return 5;
                                            }
                                    }

                                    stack mut u64[0 2 ** 63 - 1] chunkRead = 0;
                                    while willexit (chunkRead < ChunkBytes) {
                                        stack mut System.Runtime.Buffer.FixedByteBuffer4096 readBuffer = new();
                                        stack System.Net.NetResult<u64[0 2 ** 63 - 1]> read = server.Read(readBuffer);
                                        switch (read) {
                                            case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Err(var readError):
                                                server.Close();
                                                client.Close();
                                                return 6;
                                            case System.Net.NetResult<u64[0 2 ** 63 - 1]>.Ok(var readBytes):
                                                if (readBytes == 0) {
                                                    server.Close();
                                                    client.Close();
                                                    return 7;
                                                }

                                                chunkRead += readBytes;
                                                totalRead += readBytes;
                                        }
                                    }
                                }

                                client.Shutdown(System.Net.Tcp.TcpShutdown.Send);
                                client.Close();
                                server.Close();

                                if (totalRead != ExpectedBytes) {
                                    return 8;
                                }

                                return 0;
                        }
                }
        }
    }

    return 1;
}
