// stark-bench: compile-only
import System
import System.Memory
module Benchmarks.Text.TextPathCallerBuffer

unsafe fn bool Ok(System.Memory.MemoryStatus status) {
    switch (status) {
        case System.Memory.MemoryStatus.Ok:
            return true;
        case System.Memory.MemoryStatus.Err(var error):
            return false;
    }
}

export unsafe ffi fn i32[min max] main() {
    stack mut System.Text.OwnedAscii joined = new();
    stack mut System.Text.OwnedUnicode unicodeText = new();
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 2000] i = 0; i < 2000; i += 1) {
        if (!Ok(System.IO.Path.TryJoin(joined, "alpha", "beta.txt"))) {
            return 1;
        }

        if (!Ok(System.Text.FromAsciiToUnicode(unicodeText, joined.View()))) {
            return 2;
        }

        checksum += System.Text.AsciiLength(System.IO.Path.Extension(joined.View()));
        checksum += unicodeText.Length();
    }

    if (checksum != 36000) {
        return 3;
    }

    return 0;
}
