import System.Text
module Benchmarks.Text.TextParsing

const Iterations = 50;

fn bool ExpectBool(System.Text.TextResult<bool> result, bool expected) {
    switch (result) {
        case System.Text.TextResult<bool>.Ok(var value):
            return value == expected;
        case System.Text.TextResult<bool>.Err(var error):
            return false;
    }
}

fn bool ExpectI64(System.Text.TextResult<i64[min max]> result, i64[min max] expected) {
    switch (result) {
        case System.Text.TextResult<i64[min max]>.Ok(var value):
            return value == expected;
        case System.Text.TextResult<i64[min max]>.Err(var error):
            return false;
    }
}

fn bool ExpectU64(System.Text.TextResult<u64[0 max]> result, u64[0 max] expected) {
    switch (result) {
        case System.Text.TextResult<u64[0 max]>.Ok(var value):
            return value == expected;
        case System.Text.TextResult<u64[0 max]>.Err(var error):
            return false;
    }
}

fn bool ExpectI1024(System.Text.TextResult<i1024[min max]> result, i1024[min max] expected) {
    switch (result) {
        case System.Text.TextResult<i1024[min max]>.Ok(var value):
            return value == expected;
        case System.Text.TextResult<i1024[min max]>.Err(var error):
            return false;
    }
}

fn bool ExpectU1024(System.Text.TextResult<u1024[0 max]> result, u1024[0 max] expected) {
    switch (result) {
        case System.Text.TextResult<u1024[0 max]>.Ok(var value):
            return value == expected;
        case System.Text.TextResult<u1024[0 max]>.Err(var error):
            return false;
    }
}

export ffi fn i32[min max] main() {
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 50] i = 0; i < Iterations; i += 1) {
        if (!ExpectBool(System.Text.ParseBoolAscii("true"), true)) {
            return 1;
        }
        checksum += 1;

        if (!ExpectI64(System.Text.ParseI64Ascii("-9223372036854775808"), -(2**63))) {
            return 2;
        }
        checksum += 20;

        if (!ExpectU64(System.Text.ParseU64Ascii("18446744073709551615"), (u64[0 max])((2**64) - 1))) {
            return 3;
        }
        checksum += 20;

        if (!ExpectI1024(System.Text.ParseI1024Unicode((unicode)"-"), -(2**1023))) {
            return 4;
        }
        checksum += 309;

        if (!ExpectU1024(System.Text.ParseU1024Unicode((unicode)""), (u1024[0 max])((2**1024) - 1))) {
            return 5;
        }
        checksum += 309;
    }

    if (checksum != 32950) {
        return 6;
    }

    return 0;
}
