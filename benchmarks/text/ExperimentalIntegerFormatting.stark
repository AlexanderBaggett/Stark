import System.Experimental.Text
module Benchmarks.Text.ExperimentalIntegerFormatting

const Iterations = 50;

fn i64[min max] AsciiChecksum(borrow Ascii text) {
    return text.Length
        + (i64[min max])(*text.Data)
        + (i64[min max])(*(&text.Data[text.Length - 1]));
}

export ffi fn i32[min max] main() {
    stack mut i8[-128 127][320] storage;
    stack mut Ascii text = new Ascii() {
        Data = &storage[0],
        Length = 0,
        Capacity = 320
    };
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 50] i = 0; i < Iterations; i += 1) {
        if (!System.Experimental.Text.TryFormatI64Ascii(&text, -9223372036854775808)) {
            return 1;
        }
        checksum += AsciiChecksum(text);

        if (!System.Experimental.Text.TryFormatU64Ascii(&text, (u64[0 max])((2**64) - 1))) {
            return 2;
        }
        checksum += AsciiChecksum(text);

        if (!System.Experimental.Text.TryFormatI1024Ascii(&text, -(2**1023))) {
            return 3;
        }
        checksum += AsciiChecksum(text);

        if (!System.Experimental.Text.TryFormatU1024Ascii(&text, (u1024[0 max])((2**1024) - 1))) {
            return 4;
        }
        checksum += AsciiChecksum(text);
    }

    if (checksum != 53200) {
        return 5;
    }

    return 0;
}
