import System.Text
module Benchmarks.Text.TextConcatCopy

const Iterations = 5000;

unsafe fn i64[min max] AsciiChecksum(borrow Ascii text) {
    return text.Length
        + (i64[min max])(*text.Data)
        + (i64[min max])(*(&text.Data[text.Length - 1]));
}

unsafe fn i64[min max] UnicodeChecksum(borrow Unicode text) {
    return text.Length
        + (i64[min max])(*text.Data)
        + (i64[min max])(*(&text.Data[text.Length - 1]));
}

export unsafe ffi fn i32[min max] main() {
    stack mut i8[min max][32] asciiStorage;
    stack mut Ascii asciiText = new Ascii() {
        Data = &asciiStorage[0],
        Length = 0,
        Capacity = 32
    };
    stack mut i32[min max][32] unicodeStorage;
    stack mut Unicode unicodeText = new Unicode() {
        Data = &unicodeStorage[0],
        Length = 0,
        Capacity = 32
    };
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut u16[0 5000] i = 0; i < Iterations; i += 1) {
        if (!System.Text.TryConcatAscii(&asciiText, "prefix/", "body")) {
            return 1;
        }
        checksum += AsciiChecksum(asciiText);

        if (!System.Text.TryConcatUnicode(&unicodeText, (unicode)"Value:", (unicode)"body")) {
            return 2;
        }
        checksum += UnicodeChecksum(unicodeText);
    }

    if (checksum != 2305000) {
        return 3;
    }

    return 0;
}
