import System.IO.Path
import System.Text
import System.Memory
module Benchmarks.Text.OwnedPathAllocation

unsafe fn bool AddPathFacts(System.Memory.MemoryResult<System.Text.OwnedAscii> result, rawmutptr<i64[min max]> checksum) {
    switch (result) {
        case System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(var value):
            stack System.IO.Path.PathFacts facts = System.IO.Path.GetFacts(value.View());
            *checksum += facts.PathLength();
            *checksum += facts.ExtensionLength();
            *checksum += facts.BaseNameLength();
            *checksum += facts.DirectoryNameLength();
            return true;
        case System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(var error):
            return false;
    }
}

export unsafe ffi fn i32[min max] main() {
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut u16[0 2000] i = 0; i < 2000; i += 1) {
        if (!AddPathFacts(System.IO.Path.Join("alpha", "beta.txt"), &checksum)) {
            return 1;
        }

        if (!AddPathFacts(System.IO.Path.Join("alpha/", "/beta.txt"), &checksum)) {
            return 2;
        }
    }

    if (checksum != 108000) {
        return 3;
    }

    return 0;
}
