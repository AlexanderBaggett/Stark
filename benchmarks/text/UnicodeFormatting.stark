import System.Text
module Benchmarks.Text.UnicodeFormatting

const Iterations = 50;

unsafe fn i64[min max] UnicodeChecksum(borrow Unicode text) {
    return text.Length
        + (i64[min max])(*text.Data)
        + (i64[min max])(*(&text.Data[text.Length - 1]));
}

export unsafe ffi fn i32[min max] main() {
    stack mut i32[min max][320] storage;
    stack mut Unicode text = new Unicode() {
        Data = &storage[0],
        Length = 0,
        Capacity = 320
    };
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut u8[0 50] i = 0; i < Iterations; i += 1) {
        if (!System.Text.TryFormatEncodingUnicode(&text, System.Text.Encoding.UTF16)) {
            return 1;
        }
        checksum += UnicodeChecksum(text);

        if (!System.Text.TryFormatTextErrorUnicode(&text, System.Text.TextError.InvalidFormat)) {
            return 2;
        }
        checksum += UnicodeChecksum(text);

        if (!System.Text.TryFormatI1024Unicode(&text, (i1024[min max])(-(2 ** 1023)))) {
            return 3;
        }
        checksum += UnicodeChecksum(text);

        if (!System.Text.TryFormatU1024Unicode(&text, (u1024[0 max])(2 ** 1024 - 1))) {
            return 4;
        }
        checksum += UnicodeChecksum(text);
    }

    if (checksum != 58350) {
        return 5;
    }

    return 0;
}
