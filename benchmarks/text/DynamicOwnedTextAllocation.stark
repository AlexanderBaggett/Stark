module Benchmarks.Text.DynamicOwnedTextAllocation

fn i32[1 10] DigitCount(i32[0 max] value) {
    if (value < 10) {
        return 1;
    }

    if (value < 100) {
        return 2;
    }

    if (value < 1000) {
        return 3;
    }

    if (value < 10000) {
        return 4;
    }

    if (value < 100000) {
        return 5;
    }

    if (value < 1000000) {
        return 6;
    }

    if (value < 10000000) {
        return 7;
    }

    if (value < 100000000) {
        return 8;
    }

    if (value < 1000000000) {
        return 9;
    }

    return 10;
}

fn void AppendAsciiDigit(mut borrow dynamic i8[0 127] text, i32[0 9] digit) {
    text.Reserve(1);
    init text[text.Length] = (i8[0 127])(48 + digit);
}

fn void AppendUnicodeDigit(mut borrow dynamic i32[0 max] text, i32[0 9] digit) {
    text.Reserve(1);
    init text[text.Length] = (i32[0 max])(48 + digit);
}

fn void AppendAsciiDigits(mut borrow dynamic i8[0 127] text, i32[0 max] value) {
    stack i32[1 10] digits = DigitCount(value);
    stack mut i32[0 max] divisor = 1;
    for willexit (stack mut i32[1 10] index = 1; index < digits; index += 1) {
        divisor *= 10;
    }

    stack mut i32[0 max] remaining = value;
    while willexit (divisor > 0) {
        stack i32[0 9] digit = (i32[0 9])(remaining / divisor);
        AppendAsciiDigit(text, digit);
        remaining = (i32[0 max])(remaining % divisor);
        divisor = (i32[0 max])(divisor / 10);
    }
}

fn void AppendUnicodeDigits(mut borrow dynamic i32[0 max] text, i32[0 max] value) {
    stack i32[1 10] digits = DigitCount(value);
    stack mut i32[0 max] divisor = 1;
    for willexit (stack mut i32[1 10] index = 1; index < digits; index += 1) {
        divisor *= 10;
    }

    stack mut i32[0 max] remaining = value;
    while willexit (divisor > 0) {
        stack i32[0 9] digit = (i32[0 9])(remaining / divisor);
        AppendUnicodeDigit(text, digit);
        remaining = (i32[0 max])(remaining % divisor);
        divisor = (i32[0 max])(divisor / 10);
    }
}

fn void AppendAsciiScorePrefix(mut borrow dynamic i8[0 127] text) {
    text.Reserve(7);
    init text[text.Length] = 83;
    init text[text.Length] = 99;
    init text[text.Length] = 111;
    init text[text.Length] = 114;
    init text[text.Length] = 101;
    init text[text.Length] = 58;
    init text[text.Length] = 32;
}

fn void AppendUnicodeScorePrefix(mut borrow dynamic i32[0 max] text) {
    text.Reserve(7);
    init text[text.Length] = 83;
    init text[text.Length] = 99;
    init text[text.Length] = 111;
    init text[text.Length] = 114;
    init text[text.Length] = 101;
    init text[text.Length] = 58;
    init text[text.Length] = 32;
}

fn void AppendAsciiSlice(mut borrow dynamic i8[0 127] destination, borrow i8[0 127][] source, i64[0 max] sourceLength) {
    destination.Reserve(sourceLength);
    for willexit (stack mut i64[0 max] index = 0; index < sourceLength; index += 1) {
        init destination[destination.Length] = source[index];
    }
}

fn void AppendUnicodeSlice(mut borrow dynamic i32[0 max] destination, borrow i32[0 max][] source, i64[0 max] sourceLength) {
    destination.Reserve(sourceLength);
    for willexit (stack mut i64[0 max] index = 0; index < sourceLength; index += 1) {
        init destination[destination.Length] = source[index];
    }
}

fn i64[min max] AsciiChecksum(borrow i8[0 127][] text, i64[0 max] textLength) {
    stack mut i64[min max] checksum = textLength;
    for willexit (stack mut i64[0 max] index = 0; index < textLength; index += 1) {
        checksum += (i64[min max])text[index];
    }

    return checksum;
}

fn i64[min max] UnicodeChecksum(borrow i32[0 max][] text, i64[0 max] textLength) {
    stack mut i64[min max] checksum = textLength;
    for willexit (stack mut i64[0 max] index = 0; index < textLength; index += 1) {
        checksum += (i64[min max])text[index];
    }

    return checksum;
}

export ffi fn i32[min max] main() {
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 1000] i = 0; i < 1000; i += 1) {
        stack i32[0 max] value = i;
        stack i32[1 10] digitCount = DigitCount(value);

        stack mut dynamic i8[0 127] asciiText = new(digitCount);
        AppendAsciiDigits(asciiText, value);
        checksum += AsciiChecksum(asciiText[0, asciiText.Length], asciiText.Length);

        stack mut dynamic i32[0 max] unicodeText = new(digitCount);
        AppendUnicodeDigits(unicodeText, value);
        checksum += UnicodeChecksum(unicodeText[0, unicodeText.Length], unicodeText.Length);

        stack mut dynamic i8[0 127] asciiLabel = new((i64[0 max])(7 + asciiText.Length));
        AppendAsciiScorePrefix(asciiLabel);
        AppendAsciiSlice(asciiLabel, asciiText[0, asciiText.Length], asciiText.Length);
        checksum += AsciiChecksum(asciiLabel[0, asciiLabel.Length], asciiLabel.Length);

        stack mut dynamic i32[0 max] unicodeLabel = new((i64[0 max])(7 + unicodeText.Length));
        AppendUnicodeScorePrefix(unicodeLabel);
        AppendUnicodeSlice(unicodeLabel, unicodeText[0, unicodeText.Length], unicodeText.Length);
        checksum += UnicodeChecksum(unicodeLabel[0, unicodeLabel.Length], unicodeLabel.Length);
    }

    if (checksum != 1830440) {
        return 5;
    }

    return 0;
}
