import System.Experimental.IO.Path
module Benchmarks.Text.ExperimentalPathFacts

fn i64[min max] AddFacts(ascii path) {
    stack System.Experimental.IO.Path.PathFacts facts = System.Experimental.IO.Path.GetFacts(path);
    return facts.PathLength()
        + facts.ExtensionLength()
        + facts.BaseNameLength()
        + facts.DirectoryNameLength();
}

export ffi fn i32[min max] main() {
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 5000] i = 0; i < 5000; i += 1) {
        checksum += AddFacts("alpha/beta.txt");
        checksum += AddFacts("alpha/beta/gamma.txt");
        checksum += AddFacts("archive.tar.gz");
        checksum += AddFacts("alpha/.hidden");
    }

    if (checksum != 595000) {
        return 1;
    }

    return 0;
}
