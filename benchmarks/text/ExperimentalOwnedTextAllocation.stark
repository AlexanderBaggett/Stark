import System.Experimental.Text
import System.Memory
module Benchmarks.Text.ExperimentalOwnedTextAllocation

fn bool AddAsciiLength(System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii> result, rawmutptr<i64[min max]> checksum) {
    switch (result) {
        case System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii>.Ok(var value):
            *checksum += value.Length();
            return true;
        case System.Memory.MemoryResult<System.Experimental.Text.OwnedAscii>.Err(var error):
            return false;
    }
}

fn bool AddUnicodeLength(System.Memory.MemoryResult<System.Experimental.Text.OwnedUnicode> result, rawmutptr<i64[min max]> checksum) {
    switch (result) {
        case System.Memory.MemoryResult<System.Experimental.Text.OwnedUnicode>.Ok(var value):
            *checksum += value.Length();
            return true;
        case System.Memory.MemoryResult<System.Experimental.Text.OwnedUnicode>.Err(var error):
            return false;
    }
}

export ffi fn i32[min max] main() {
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 1000] i = 0; i < 1000; i += 1) {
        stack i32[min max] value = i;
        if (!AddAsciiLength(System.Experimental.Text.ToAscii(value), &checksum)) {
            return 1;
        }

        if (!AddUnicodeLength(System.Experimental.Text.ToUnicode(value), &checksum)) {
            return 2;
        }

        if (!AddAsciiLength(System.Experimental.Text.ConcatAscii("Score: ", 7, System.Experimental.Text.ToAscii(value)), &checksum)) {
            return 3;
        }

        if (!AddUnicodeLength(System.Experimental.Text.ConcatUnicode((unicode)"Score: ", 7, System.Experimental.Text.ToUnicode(value)), &checksum)) {
            return 4;
        }
    }

    if (checksum != 25560) {
        return 5;
    }

    return 0;
}
