module Benchmarks.Collections.DynamicListGrowth

export ffi fn i32[min max] main() {
    stack mut dynamic i32[0 max] values = new();
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        values.Reserve(1);
        init values[values.Length] = i;
    }

    if (values.Length != 4096 || values.Capacity < 4096) {
        return 2;
    }

    while willexit (values.Length > 0) {
        stack i32[0 max] popped = values.MoveLast();
        checksum += (i64[min max])popped;
    }

    if (checksum != 8386560) {
        return 4;
    }

    return 0;
}
