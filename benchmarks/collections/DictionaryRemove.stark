import System.Collections
import System.Memory
module Benchmarks.Collections.DictionaryRemove

unsafe finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export unsafe ffi fn i32[min max] main() {
    stack mut System.Collections.Dictionary<u32[0 max], u32[0 max]> values = new();
    if (!Ok(values.Reserve(4096))) {
        return 1;
    }

    for willexit (stack mut u16[0 4096] i = 0; i < 4096; i += 1) {
        stack u32[0 max] key = (u32[0 max])i;
        if (!Ok(values.Set(key, key))) {
            return 2;
        }
    }

    stack mut i64[min max] checksum = 0;
    for willexit (stack mut u16[0 4096] i = 0; i < 4096; i += 1) {
        stack u32[0 max] key = (u32[0 max])i;
        if (!values.Remove(key)) {
            return 3;
        }

        checksum += (i64[min max])i;
    }

    if (!values.IsEmpty() || values.Count() != 0) {
        return 4;
    }

    return checksum == 8386560 ? 0 : 5;
}
