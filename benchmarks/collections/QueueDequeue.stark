import System.Collections
import System.Memory
module Benchmarks.Collections.QueueDequeue

unsafe finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export unsafe ffi fn i32[min max] main() {
    stack mut System.Collections.Queue<u32[0 max]> queue = new();
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut u16[0 32768] i = 0; i < 32768; i += 1) {
        if (!Ok(queue.Enqueue(i))) {
            return 1;
        }
    }

    stack mut u32[0 max] value = 0;
    while willexit (!queue.IsEmpty()) {
        if (!queue.TryDequeue(value)) {
            return 2;
        }

        checksum += (i64[min max])value;
    }

    if (checksum != 536854528) {
        return 3;
    }

    return 0;
}
