import System.Collections
import System.Memory
module Benchmarks.Collections.ListIteration

unsafe finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export unsafe ffi fn i32[min max] main() {
    stack mut System.Collections.List<u32[0 max]> values = new();

    for willexit (stack mut u16[0 4096] i = 0; i < 4096; i += 1) {
        if (!Ok(values.Push(i))) {
            return 1;
        }
    }

    stack mut u64[0 2 ** 63 - 1] checksum = 0;
    for willexit (stack mut u16[0 4096] i = 0; i < 4096; i += 1) {
        checksum += (u64[0 2 ** 63 - 1])values.Get((u64[0 2 ** 63 - 1])i);
    }

    if (checksum != 8386560) {
        return 2;
    }

    return 0;
}
