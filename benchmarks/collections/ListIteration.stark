import System
module Benchmarks.Collections.ListIteration

finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export ffi fn i32[min max] main() {
    stack mut List<i32[0 max]> values = new();

    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        if (!Ok(values.Push(i))) {
            return 1;
        }
    }

    stack mut i64[min max] checksum = 0;
    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        checksum += (i64[min max])values.Get((i64[0 max])i);
    }

    if (checksum != 8386560) {
        return 2;
    }

    return 0;
}
