import System
module Benchmarks.Collections.LinkedListBuildClear

finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export ffi fn i32[min max] main() {
    stack mut LinkedList<i32[0 max]> values = new();

    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        if (!Ok(values.AddLast(i))) {
            return 1;
        }
    }

    if (values.Count() != 4096) {
        return 2;
    }

    values.Clear();
    if (!values.IsEmpty()) {
        return 3;
    }

    return 0;
}
