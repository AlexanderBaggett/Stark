import System
module Benchmarks.Collections.QueueGrowth

finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export ffi fn i32[min max] main() {
    stack mut Queue<i32[0 max]> queue = new();
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        if (!Ok(queue.Enqueue(i))) {
            return 1;
        }
    }

    if (queue.Count() != 4096) {
        return 2;
    }

    stack mut i32[0 max] value = 0;
    while willexit (!queue.IsEmpty()) {
        if (!queue.TryDequeue(value)) {
            return 3;
        }

        checksum += (i64[min max])value;
    }

    if (checksum != 8386560) {
        return 4;
    }

    return 0;
}
