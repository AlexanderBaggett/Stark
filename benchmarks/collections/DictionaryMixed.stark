import System
module Benchmarks.Collections.DictionaryMixed

finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export ffi fn i32[min max] main() {
    stack mut Dictionary<i32[0 max], i32[0 max]> values = new();
    if (!Ok(values.Reserve(4096))) {
        return 1;
    }

    for willexit (stack mut i32[0 2048] i = 0; i < 2048; i += 1) {
        if (!Ok(values.Set(i, i))) {
            return 2;
        }
    }

    stack mut i64[min max] checksum = 0;
    stack mut i32[0 max] found = 0;
    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        stack i32[0 max] key = (i32[0 max])(i % 2048);
        stack i32[0 3] operation = (i32[0 3])(i % 4);
        if (operation == 0) {
            if (!Ok(values.Set(key, i))) {
                return 3;
            }
        }
        else if (operation == 1) {
            if (values.TryGet(key, found)) {
                checksum += (i64[min max])found;
            }
        }
        else if (operation == 2) {
            values.Remove(key);
        }
        else {
            stack i32[0 max] value = (i32[0 max])(i * 3);
            if (!Ok(values.Set(key, value))) {
                return 4;
            }
        }
    }

    stack mut i64[min max] finalSum = 0;
    for willexit (stack mut i32[0 2048] key = 0; key < 2048; key += 1) {
        if (values.TryGet(key, found)) {
            finalSum += (i64[min max])found;
        }
    }

    if (values.Count() != 1536 || checksum != 1047552 || finalSum != 6815744) {
        return 5;
    }

    return 0;
}
