module Benchmarks.Collections.DynamicDictionaryLookup

fn bool Set(
    mut borrow i32[0 1][] states,
    mut borrow i32[0 max][] keys,
    mut borrow i32[0 max][] values,
    i32[0 max] key,
    i32[0 max] value) {
    stack mut i32[0 4095] index = (i32[0 4095])(key % 4096);
    for willexit (stack mut i32[0 4096] probe = 0; probe < 4096; probe += 1) {
        if (states[index] == 0 || keys[index] == key) {
            states[index] = 1;
            keys[index] = key;
            values[index] = value;
            return true;
        }

        index = (i32[0 4095])((index + 1) % 4096);
    }

    return false;
}

fn bool TryGet(
    borrow i32[0 1][] states,
    borrow i32[0 max][] keys,
    borrow i32[0 max][] values,
    i32[0 max] key,
    out i32[0 max] found) {
    stack mut i32[0 4095] index = (i32[0 4095])(key % 4096);
    for willexit (stack mut i32[0 4096] probe = 0; probe < 4096; probe += 1) {
        if (states[index] == 0) {
            return false;
        }

        if (keys[index] == key) {
            found = values[index];
            return true;
        }

        index = (i32[0 4095])((index + 1) % 4096);
    }

    return false;
}

export ffi fn i32[min max] main() {
    stack mut dynamic i32[0 1] statesStorage = new(4096);
    stack mut dynamic i32[0 max] keysStorage = new(4096);
    stack mut dynamic i32[0 max] valuesStorage = new(4096);

    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        init statesStorage[statesStorage.Length] = 0;
        init keysStorage[keysStorage.Length] = 0;
        init valuesStorage[valuesStorage.Length] = 0;
    }

    stack mut i32[0 1][] states = statesStorage[0, statesStorage.Length];
    stack mut i32[0 max][] keys = keysStorage[0, keysStorage.Length];
    stack mut i32[0 max][] values = valuesStorage[0, valuesStorage.Length];

    for willexit (stack mut i32[0 2048] i = 0; i < 2048; i += 1) {
        stack i32[0 max] key = i;
        stack i32[0 max] value = (i32[0 max])(i * 3);
        if (!Set(states, keys, values, key, value)) {
            return 1;
        }
    }

    stack mut i64[min max] checksum = 0;
    stack mut i32[0 max] found = 0;
    for willexit (stack mut i32[0 100000] i = 0; i < 100000; i += 1) {
        stack i32[0 max] key = (i32[0 max])(i % 2048);
        if (!TryGet(states, keys, values, key, found)) {
            return 2;
        }

        checksum += (i64[min max])found;
    }

    if (checksum != 306154512) {
        return 3;
    }

    return 0;
}
