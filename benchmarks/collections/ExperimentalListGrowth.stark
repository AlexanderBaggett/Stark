import System.Experimental.Collections
import System.Memory
module Benchmarks.Collections.ExperimentalListGrowth

finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export ffi fn i32[min max] main() {
    stack mut System.Experimental.Collections.List<i32[0 max]> values = new();
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        if (!Ok(values.Push(i))) {
            return 1;
        }
    }

    if (values.Count() != 4096 || values.Capacity() < 4096) {
        return 2;
    }

    stack mut i32[0 max] popped = 0;
    while willexit (values.Count() > 0) {
        if (!values.TryPop(popped)) {
            return 3;
        }

        checksum += (i64[min max])popped;
    }

    if (checksum != 8386560) {
        return 4;
    }

    return 0;
}
