import System.Collections
import System.Memory
module Benchmarks.Collections.DictionaryUpdate

unsafe finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export unsafe ffi fn i32[min max] main() {
    stack mut System.Collections.Dictionary<u32[0 2 ** 31 - 1], u32[0 2 ** 31 - 1]> values = new();
    if (!Ok(values.Reserve(4096))) {
        return 1;
    }

    for willexit (stack mut u16[0 4096] i = 0; i < 4096; i += 1) {
        if (!Ok(values.Set(i, i))) {
            return 2;
        }
    }

    for willexit (stack mut u16[0 4096] i = 0; i < 4096; i += 1) {
        stack u32[0 2 ** 31 - 1] value = (u32[0 2 ** 31 - 1])(i * 5);
        if (!Ok(values.Set(i, value))) {
            return 3;
        }
    }

    stack mut i64[min max] checksum = 0;
    stack mut u32[0 2 ** 31 - 1] found = 0;
    for willexit (stack mut u16[0 4096] i = 0; i < 4096; i += 1) {
        if (!values.TryGet(i, found)) {
            return 4;
        }

        checksum += (i64[min max])found;
    }

    return checksum == 41932800 ? 0 : 5;
}
