import System
module Benchmarks.Collections.DictionaryUpdate

finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export ffi fn i32[min max] main() {
    stack mut Dictionary<i32[0 max], i32[0 max]> values = new();
    if (!Ok(values.Reserve(4096))) {
        return 1;
    }

    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        if (!Ok(values.Set(i, i))) {
            return 2;
        }
    }

    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        stack i32[0 max] value = (i32[0 max])(i * 5);
        if (!Ok(values.Set(i, value))) {
            return 3;
        }
    }

    stack mut i64[min max] checksum = 0;
    stack mut i32[0 max] found = 0;
    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        if (!values.TryGet(i, found)) {
            return 4;
        }

        checksum += (i64[min max])found;
    }

    return checksum == 41932800 ? 0 : 5;
}
