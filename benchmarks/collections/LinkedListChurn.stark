import System.Collections
import System.Memory
module Benchmarks.Collections.LinkedListChurn

unsafe finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export unsafe ffi fn i32[min max] main() {
    stack mut System.Collections.LinkedList<i32[0 max]> values = new();
    stack mut i64[min max] checksum = 0;

    for willexit (stack mut i32[0 4096] i = 0; i < 4096; i += 1) {
        if (!Ok(values.AddLast(i))) {
            return 1;
        }

        stack mut i32[0 max] value = 0;
        if (!values.TryRemoveFirst(value)) {
            return 2;
        }

        checksum += (i64[min max])value;
    }

    if (!values.IsEmpty()) {
        return 3;
    }

    if (checksum != 8386560) {
        return 4;
    }

    return 0;
}
