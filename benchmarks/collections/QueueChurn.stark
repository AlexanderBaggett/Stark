import System.Collections
import System.Memory
module Benchmarks.Collections.QueueChurn

unsafe finite law bool Ok(MemoryStatus status) {
    switch (status) {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

export unsafe ffi fn i32[min max] main() {
    stack mut System.Collections.Queue<u32[0 2 ** 31 - 1]> queue = new();
    stack mut i64[min max] checksum = 0;
    stack mut u32[0 2 ** 31 - 1] next = 0;

    for willexit (stack mut u16[0 256] cycle = 0; cycle < 256; cycle += 1) {
        for willexit (stack mut u8[0 64] i = 0; i < 64; i += 1) {
            if (!Ok(queue.Enqueue(next))) {
                return 1;
            }

            next += 1;
        }

        stack mut u32[0 2 ** 31 - 1] value = 0;
        for willexit (stack mut u8[0 32] i = 0; i < 32; i += 1) {
            if (!queue.TryDequeue(value)) {
                return 2;
            }

            checksum += (i64[min max])value;
        }

        for willexit (stack mut u8[0 32] i = 0; i < 32; i += 1) {
            if (!Ok(queue.Enqueue(next))) {
                return 3;
            }

            next += 1;
        }

        for willexit (stack mut u8[0 64] i = 0; i < 64; i += 1) {
            if (!queue.TryDequeue(value)) {
                return 4;
            }

            checksum += (i64[min max])value;
        }
    }

    if (!queue.IsEmpty() || next != 24576) {
        return 5;
    }

    if (checksum != 301977600) {
        return 6;
    }

    return 0;
}
