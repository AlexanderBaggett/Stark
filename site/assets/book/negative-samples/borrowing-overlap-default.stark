module Book.Negative.BorrowingOverlapDefault

struct Cell
{
    i32[min max] Value;
}

fn void AddSeparate(mut borrow Cell left, mut borrow Cell right)
{
    left.Value += 1;
    right.Value += 1;
    return;
}

export fn i32[min max] main()
{
    stack mut Cell cell = new Cell()
    {
        Value = 1
    };

    AddSeparate(cell, cell);
    return cell.Value;
}
