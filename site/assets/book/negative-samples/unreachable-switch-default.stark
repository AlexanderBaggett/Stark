module Book.Negative.UnreachableSwitchDefault

enum Token {
    End,
    Integer(i32[min max]),
}

finite law i32[min max] Score(Token token) {
    switch (token) {
        case Token.End:
            return 0;
        case Token.Integer(_):
            return 1;
        default:
            return -1;
    }
}

export unsafe ffi fn i32[min max] main() {
    return Score(Token.End);
}
