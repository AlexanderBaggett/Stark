module Book.PackageSurface

public struct Rectangle {
    i32[0 1000] Width;
    i32[0 1000] Height;
}

internal finite law i32[min max] Multiply(i32[0 1000] left, i32[0 1000] right) {
    return left * right;
}

public finite law i32[min max] Area(Rectangle rectangle) {
    return Multiply(rectangle.Width, rectangle.Height);
}

export ffi fn i32[min max] main() {
    stack Rectangle rectangle = new Rectangle() {
        Width = 6,
        Height = 7
    };

    if (Area(rectangle) != 42) {
        return 1;
    }

    return 0;
}
