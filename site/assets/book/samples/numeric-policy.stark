module Book.NumericPolicy

finite law i32[min max] WrappedMaxPlusOne() {
    return 2147483647 +% 1;
}

finite law i32[min max] SaturatedMaxPlusOne() {
    return 2147483647 +| 1;
}

strictfp finite law f32 StrictAdd(f32 left, f32 right) {
    return left + right;
}

export unsafe ffi fn i32[min max] main() {
    if (WrappedMaxPlusOne() != -2147483648) {
        return 1;
    }

    if (SaturatedMaxPlusOne() != 2147483647) {
        return 2;
    }

    if (StrictAdd(1.0f, 2.0f) != 3.0f) {
        return 3;
    }

    return 0;
}
