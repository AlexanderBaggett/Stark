module Book.PerformanceTightLoop

finite law i32[min max] SumFixed(i32[min max][4] values) {
    stack mut i32[0 max] index = 0;
    stack mut i32[min max] total = 0;

    while willexit (index < 4) {
        total += values[index];
        index += 1;
    }

    return total;
}

finite law bool HasExpectedTotal(i32[min max][4] values) {
    return SumFixed(values) == 10;
}

export ffi fn i32[min max] main() {
    stack i32[min max][4] values = { 1, 2, 3, 4 };

    if (!HasExpectedTotal(values)) {
        return 1;
    }

    return 0;
}
