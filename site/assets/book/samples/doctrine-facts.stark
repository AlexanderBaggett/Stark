module Book.DoctrineFacts

doctrine ScoreRules {
    finite law bool IsPassing(i32[0 100] score) {
        return score >= 70;
    }

    finite law i32[0 100] PerfectScore() {
        return 100;
    }
}

export ffi fn i32[min max] main() {
    if (!ScoreRules.IsPassing(ScoreRules.PerfectScore())) {
        return 1;
    }

    if (ScoreRules.IsPassing(40)) {
        return 2;
    }

    return 0;
}
