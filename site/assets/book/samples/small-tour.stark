module Book.SmallTour

finite law i32[min max] SumTo(u32[0 max] limit) {
    stack mut u32[0 max] index = 0;
    stack mut i32[min max] total = 0;

    while willexit (index <= limit) {
        total += (i32[min max])index;
        index += 1;
    }

    return total;
}

export unsafe ffi fn i32[min max] main() {
    if (SumTo(4) != 10) {
        return 1;
    }

    return 0;
}
