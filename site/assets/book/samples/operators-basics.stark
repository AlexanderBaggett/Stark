module Book.OperatorsBasics

finite law bool ArithmeticWorks() {
    stack mut i32[min max] value = 6;

    value += 2;
    value *= 3;

    return value == 24
        && value / 3 == 8
        && value % 5 == 4;
}

finite law bool ComparisonsWork(i32[min max] value) {
    return value >= 0
        && value <= 100
        && value != 42;
}

finite law i32[min max] ChooseSign(i32[min max] value) {
    return value < 0 ? -1 : 1;
}

export unsafe ffi fn i32[min max] main() {
    if (!ArithmeticWorks()) {
        return 1;
    }

    if (!ComparisonsWork(50)) {
        return 2;
    }

    if (ChooseSign(-5) != -1) {
        return 3;
    }

    return 0;
}
