module Book.DynamicStoragePatterns

struct IntList {
    dynamic u32[0 max] Items;
}

fn void PushInt(mut borrow IntList self, u32[0 max] value) {
    if (self.Items.Length == self.Items.Capacity) {
        self.Items.Reserve(1);
    }

    init self.Items[self.Items.Length] = value;
}

fn u32[0 max] Sum(borrow IntList self) {
    stack u32[0 max][] values = self.Items[0, self.Items.Length];
    stack mut u64[0 max] index = 0;
    stack mut u32[0 max] total = 0;

    while willexit (index < self.Items.Length) {
        total += values[index];
        index += 1;
    }

    return total;
}

struct ByteBuffer {
    dynamic u8[0 max] Bytes;
}

fn void PushByte(mut borrow ByteBuffer self, u8[0 max] value) {
    if (self.Bytes.Length == self.Bytes.Capacity) {
        self.Bytes.Reserve(1);
    }

    init self.Bytes[self.Bytes.Length] = value;
}

fn void AppendStark(mut borrow ByteBuffer self) {
    PushByte(self, (u8[0 max])83);
    PushByte(self, (u8[0 max])116);
    PushByte(self, (u8[0 max])97);
    PushByte(self, (u8[0 max])114);
    PushByte(self, (u8[0 max])107);
}

fn void AppendCachePath(mut borrow ByteBuffer self) {
    PushByte(self, (u8[0 max])47);
    PushByte(self, (u8[0 max])99);
    PushByte(self, (u8[0 max])97);
    PushByte(self, (u8[0 max])99);
    PushByte(self, (u8[0 max])104);
    PushByte(self, (u8[0 max])101);
    PushByte(self, (u8[0 max])47);
    PushByte(self, (u8[0 max])115);
    PushByte(self, (u8[0 max])116);
    PushByte(self, (u8[0 max])97);
    PushByte(self, (u8[0 max])114);
    PushByte(self, (u8[0 max])107);
}

fn retborrow u8[0 max][] ViewBytes(borrow ByteBuffer self) {
    return self.Bytes[0, self.Bytes.Length];
}

export fn i32[min max] main() {
    stack mut IntList values = new();
    PushInt(values, 10);
    PushInt(values, 32);

    if (Sum(values) != 42) {
        return 1;
    }

    stack mut ByteBuffer text = new();
    AppendStark(text);
    stack u8[0 max][] textBytes = ViewBytes(text);
    if (text.Bytes.Length != 5 || textBytes[0] != (u8[0 max])83 || textBytes[4] != (u8[0 max])107) {
        return 2;
    }

    stack mut ByteBuffer path = new();
    AppendCachePath(path);
    stack u8[0 max][] pathBytes = ViewBytes(path);
    if (path.Bytes.Length != 12 || pathBytes[0] != (u8[0 max])47 || pathBytes[11] != (u8[0 max])107) {
        return 3;
    }

    return 0;
}
