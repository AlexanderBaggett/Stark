module Book.BorrowingFunctionPointerContracts

struct Cell
{
    i32[min max] Value;
}

fn i32[min max] SumOverlapSafe(borrow Cell left, borrow Cell right)
    where overlap(left, right)
{
    return left.Value + right.Value;
}

fn i32[min max] ApplyOverlap(
    fnptr<fn i32[min max](borrow Cell, borrow Cell) where overlap(arg0, arg1)> operation,
    borrow Cell left,
    borrow Cell right)
    where overlap(left, right)
{
    return operation(left, right);
}

export fn i32[min max] main()
{
    stack mut Cell left = new Cell()
    {
        Value = 1
    };
    stack mut Cell right = new Cell()
    {
        Value = 20
    };

    if (ApplyOverlap(SumOverlapSafe, left, right) != 21)
    {
        return 1;
    }

    if (ApplyOverlap(SumOverlapSafe, left, left) != 2)
    {
        return 2;
    }

    return 0;
}
