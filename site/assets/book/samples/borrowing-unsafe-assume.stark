module Book.BorrowingUnsafeAssume

unsafe fn void AddSeparate(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
{
    *left += 1;
    *right += 10;
    return;
}

unsafe fn void AddWithExternalProof(rawmutptr<i32[min max]> left, rawmutptr<i32[min max]> right)
    where overlap(left, right)
{
    assume disjoint(left, right)
    {
        AddSeparate(left, right);
    }

    return;
}

export unsafe fn i32[min max] main()
{
    stack mut i32[min max] left = 1;
    stack mut i32[min max] right = 20;

    AddWithExternalProof(&left, &right);

    if (left != 2 || right != 30)
    {
        return 1;
    }

    return 0;
}
