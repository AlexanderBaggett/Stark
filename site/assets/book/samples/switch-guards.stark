module Book.SwitchGuards

finite law i32[min max] Bucket(i32[min max] value) {
    switch (value) {
        case var captured when captured < 0:
            return -1;
        case 0:
            return 0;
        case _ when value < 10:
            return 1;
        default:
            return 2;
    }
}

export ffi fn i32[min max] main() {
    if (Bucket(-3) != -1) {
        return 1;
    }

    if (Bucket(0) != 0) {
        return 2;
    }

    if (Bucket(7) != 1) {
        return 3;
    }

    if (Bucket(12) != 2) {
        return 4;
    }

    return 0;
}
