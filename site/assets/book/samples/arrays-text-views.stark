module Book.ArraysTextViews

finite law i32[min max] SumThree(i32[min max][3] values) {
    return values[0] + values[1] + values[2];
}

finite law bool StartsWithOk(ascii text) {
    return text[0] == 'o' && text[1] == 'k';
}

finite law ascii FirstView(ascii text) {
    return text[0];
}

export ffi fn i32[min max] main() {
    stack i32[min max][3] values = { 1, 2, 3 };

    if (SumThree(values) != 6) {
        return 1;
    }

    if (!StartsWithOk("ok")) {
        return 2;
    }

    if (FirstView("stark") != "s") {
        return 3;
    }

    return 0;
}
