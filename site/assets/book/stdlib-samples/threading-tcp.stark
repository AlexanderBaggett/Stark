import System
module Book.Stdlib.ThreadingTcp

fn i32[min max] Worker() {
    return 7;
}

finite law bool JoinResultIs(System.Threading.ThreadJoinResult result, i32[min max] expected) {
    switch (result) {
        case System.Threading.ThreadJoinResult.Ok(var value):
            return value == expected;
        case System.Threading.ThreadJoinResult.Err(var error):
            return false;
    }
}

fn bool ThreadEntryShapeCompiles() {
    stack System.Threading.ThreadEntry entry = Worker;
    stack mut System.Threading.Thread worker = new(entry);
    stack System.Threading.ThreadJoinResult joined = worker.Join();
    return JoinResultIs(joined, 7);
}

finite law bool EndpointShapeWorks() {
    stack System.Net.IPv4Endpoint endpoint = new() {
        Address = new() {
            A = 127,
            B = 0,
            C = 0,
            D = 1
        },
        Port = 8080
    };

    stack System.Net.Tcp.TcpClient closed = new();
    return !closed.IsOpen() && endpoint.Port == 8080;
}

export unsafe ffi fn i32[min max] main() {
    if (!EndpointShapeWorks()) {
        return 1;
    }

    return 0;
}
