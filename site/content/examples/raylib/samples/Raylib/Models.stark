[LinkName("DrawTriangleStrip3D")]
internal unsafe ffi fn void stark_raylib_DrawTriangleStrip3D(rawptr<Vector3> points, i32[min max] pointCount, Color color);
public fn RaylibStatus DrawTriangleStrip3D(borrow Vector3[] points, Color color) {
    if (points.Length > (u64[0 2 ** 63 - 1])(2 ** 31 - 1)) {
        return RaylibStatus.TooManyItems;
    }

    if (points.Length == 0) {
        return RaylibStatus.Ok;
    }

    unsafe {
        stark_raylib_DrawTriangleStrip3D(&points[0], (i32[min max])points.Length, color);
    }
    return RaylibStatus.Ok;
}

