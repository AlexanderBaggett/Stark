[LinkName("CheckCollisionPointPoly")]
internal unsafe ffi fn bool stark_raylib_CheckCollisionPointPoly(Vector2 point, rawptr<Vector2> points, i32[min max] pointCount);
public fn bool CheckCollisionPointPoly(Vector2 point, borrow Vector2[] points) {
    if (points.Length == 0 || points.Length > (u64[0 2 ** 63 - 1])(2 ** 31 - 1)) {
        return false;
    }

    unsafe {
        return stark_raylib_CheckCollisionPointPoly(point, &points[0], (i32[min max])points.Length);
    }
}

[LinkName("CheckCollisionLines")]
internal unsafe ffi fn bool stark_raylib_CheckCollisionLines(Vector2 startPos1, Vector2 endPos1, Vector2 startPos2, Vector2 endPos2, rawmutptr<Vector2> collisionPoint);
public fn CollisionPointResult CheckCollisionLines(Vector2 startPos1, Vector2 endPos1, Vector2 startPos2, Vector2 endPos2) {
    stack mut Vector2 collisionPoint = DefaultVector2();
    stack mut bool hit = false;
    unsafe {
        hit = stark_raylib_CheckCollisionLines(startPos1, endPos1, startPos2, endPos2, &collisionPoint);
    }
    return new CollisionPointResult()
    {
        Hit = hit,
        Point = collisionPoint
    };
}

