[LinkName("DrawLineStrip")]
internal unsafe ffi fn void stark_raylib_DrawLineStrip(rawptr<Vector2> points, i32[min max] pointCount, Color color);
public fn RaylibStatus DrawLineStrip(borrow Vector2[] points, Color color) {
    if (points.Length > (u64[0 2 ** 63 - 1])(2 ** 31 - 1)) {
        return RaylibStatus.TooManyItems;
    }

    if (points.Length == 0) {
        return RaylibStatus.Ok;
    }

    unsafe {
        stark_raylib_DrawLineStrip(&points[0], (i32[min max])points.Length, color);
    }
    return RaylibStatus.Ok;
}

