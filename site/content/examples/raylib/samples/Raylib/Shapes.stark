    if (points.Length > (u64[0 2 ** 63 - 1])(2 ** 31 - 1)) {
        return RaylibStatus.TooManyItems;
    }

    if (points.Length == 0) {
        return RaylibStatus.Ok;
    }

    unsafe {
        stark_raylib_DrawTriangleFan(&points[0], (i32[min max])points.Length, color);
    }
    return RaylibStatus.Ok;
}

