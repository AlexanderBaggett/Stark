internal unsafe fn FileOpenResult OpenFileReadResult(ascii path)
{
    unsafe
    {
        switch (System.Runtime.Platform.Windows.OpenFileReadResult(path))
        {
            case System.Runtime.Platform.Windows.FileOpenResult.Ok(var handle):
                return FileOpenResult.Ok(handle);
            case System.Runtime.Platform.Windows.FileOpenResult.Err(var error):
                return FileOpenResult.Err(error);
        }
    }
}

