import System.Runtime.Platform.Windows
module System.Runtime.Platform

internal fn i32 WriteStdoutAscii(ascii text) {
    return System.Runtime.Platform.Windows.WriteStdoutAscii(text);
}

internal fn i32 WriteStdoutUnicode(unicode text) {
    return System.Runtime.Platform.Windows.WriteStdoutUnicode(text);
}

internal fn i32 WriteStderrAscii(ascii text) {
    return System.Runtime.Platform.Windows.WriteStderrAscii(text);
}

internal fn i32 WriteStderrUnicode(unicode text) {
    return System.Runtime.Platform.Windows.WriteStderrUnicode(text);
}

internal fn i32 WriteAscii(rawptr<i8> handle, ascii text) {
    return System.Runtime.Platform.Windows.WriteAscii(handle, text);
}

internal finite law ascii DirectorySeparator() {
    return System.Runtime.Platform.Windows.DirectorySeparator();
}

internal finite law ascii AlternateDirectorySeparator() {
    return System.Runtime.Platform.Windows.AlternateDirectorySeparator();
}

internal finite law ascii PathSeparator() {
    return System.Runtime.Platform.Windows.PathSeparator();
}

internal finite law bool IsDirectorySeparator(ascii value) {
    return System.Runtime.Platform.Windows.IsDirectorySeparator(value);
}

internal fn bool IsTerminal(rawptr<i8> handle) {
    return System.Runtime.Platform.Windows.IsTerminal(handle);
}

internal fn i32 WriteUnicode(rawptr<i8> handle, unicode text) {
    return System.Runtime.Platform.Windows.WriteUnicode(handle, text);
}

internal fn rawptr<i8> OpenFileRead(ascii path) {
    return System.Runtime.Platform.Windows.OpenFileRead(path);
}

internal fn rawptr<i8> OpenFileWrite(ascii path) {
    return System.Runtime.Platform.Windows.OpenFileWrite(path);
}

internal fn rawptr<i8> OpenFileAppend(ascii path) {
    return System.Runtime.Platform.Windows.OpenFileAppend(path);
}

internal fn rawptr<i8> OpenFileReadWrite(ascii path) {
    return System.Runtime.Platform.Windows.OpenFileReadWrite(path);
}

internal fn i32 CloseFile(rawptr<i8> handle) {
    return System.Runtime.Platform.Windows.CloseFile(handle);
}

internal fn i32 FlushFile(rawptr<i8> handle) {
    return System.Runtime.Platform.Windows.FlushFile(handle);
}

internal fn i64 ReadFile(rawptr<i8> buffer, i64 size, i64 count, rawptr<i8> handle) {
    return System.Runtime.Platform.Windows.ReadFile(buffer, size, count, handle);
}

internal fn i64 WriteFile(rawptr<i8> buffer, i64 size, i64 count, rawptr<i8> handle) {
    return System.Runtime.Platform.Windows.WriteFile(buffer, size, count, handle);
}

internal fn i32 DeleteFile(ascii path) {
    return System.Runtime.Platform.Windows.DeleteFile(path);
}

internal fn i32 MoveFile(ascii oldPath, ascii newPath) {
    return System.Runtime.Platform.Windows.MoveFile(oldPath, newPath);
}

internal fn bool FileExists(ascii path) {
    return System.Runtime.Platform.Windows.FileExists(path);
}

internal fn bool TryCurrentDirectory(rawmutptr<Ascii> destination) {
    return System.Runtime.Platform.Windows.TryCurrentDirectory(destination);
}
