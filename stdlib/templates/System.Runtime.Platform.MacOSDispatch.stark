internal unsafe fn FileOpenResult OpenFileReadResult(ascii path)
{
    switch (System.Runtime.Platform.MacOS.OpenFileReadResult(path))
    {
        case System.Runtime.Platform.MacOS.FileOpenResult.Ok(var handle):
            return FileOpenResult.Ok(handle);
        case System.Runtime.Platform.MacOS.FileOpenResult.Err(var error):
            return FileOpenResult.Err(error);
    }
}

