internal unsafe fn i32[min max] StartProcessCapture(
    rawptr<System.C.c_char> executable,
    borrow rawptr<System.C.c_char>[] argv,
    rawptr<System.C.c_char> workingDirectory,
    bool captureStdin,
    rawmutptr<i32[min max]> processId,
    rawmutptr<i32[min max]> stdinDescriptor,
    rawmutptr<i32[min max]> stdoutDescriptor,
    rawmutptr<i32[min max]> stderrDescriptor)
    where overlap(executable, argv),
          overlap(executable, workingDirectory),
          overlap(argv, workingDirectory),
          overlap(executable, processId),
          overlap(executable, stdinDescriptor),
          overlap(executable, stdoutDescriptor),
          overlap(executable, stderrDescriptor)
{
    return System.Runtime.Platform.MacOS.StartProcessCapture(
        executable,
        argv,
        workingDirectory,
        captureStdin,
        processId,
        stdinDescriptor,
        stdoutDescriptor,
        stderrDescriptor);
}

