export import System.IO.File
export import System.IO.Path
module System.IO

public enum IOError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidPath,
    BrokenPipe,
    DiskFull,
    Unknown(i32),
}

public enum IOResult<T> {
    Ok(T),
    Err(IOError),
}

public enum IOStatus {
    Ok,
    Err(IOError),
}
