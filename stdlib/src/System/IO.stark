module System.IO

public enum IOError
{
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidPath,
    BrokenPipe,
    DiskFull,
    NotADirectory,
    IsADirectory,
    DirectoryNotEmpty,
    TooManyLinks,
    Unknown(i32[min max]),
}

public enum IOResult<T>
{
    [Ok] Ok(T),
    [Err] Err(IOError),
}

public enum IOStatus
{
    [Ok] Ok,
    [Err] Err(IOError),
}
