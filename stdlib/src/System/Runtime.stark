import System.Runtime.Buffer
import System.Runtime.Platform
module System.Runtime

internal struct ByteSliceParts {
    rawptr<i8[-128 127]> Data;
    i64[0 max] Length;
}

internal struct MutableByteSliceParts {
    rawmutptr<i8[-128 127]> Data;
    i64[0 max] Length;
}

internal finite law ByteSliceParts GetByteSliceParts(borrow i8[-128 127][] source);
internal finite law MutableByteSliceParts GetMutableByteSliceParts(mut borrow i8[-128 127][] source);
