import System.Runtime.Buffer
import System.Runtime.Platform
module System.Runtime

internal struct ByteSliceParts
{
    rawptr<i8[min max]> Data;
    u64[0 2 ** 63 - 1] Length;
}

internal struct MutableByteSliceParts
{
    rawmutptr<i8[min max]> Data;
    u64[0 2 ** 63 - 1] Length;
}

internal finite law ByteSliceParts GetByteSliceParts(borrow i8[min max][] source);
internal finite law MutableByteSliceParts GetMutableByteSliceParts(mut borrow i8[min max][] source);
