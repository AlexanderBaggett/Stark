    return TextResult<i64[min max]>.Ok(
        (i64[min max])magnitude);
}

public finite TextResult<i64[min max]> ParseI64Ascii(ascii source)
{
    unsafe
    {
        stack i64[min max] length = AsciiLength(source);
        if (length <= 0)
        {
            return TextResult<i64[min max]>.Err(TextError.InvalidFormat);
        }

        stack rawptr<i8[min max]> data = AsciiData(source);
        if (data == null)
        {
            return TextResult<i64[min max]>.Err(TextError.InvalidFormat);
        }

        stack mut i64[min max] index = 0;
        stack mut bool negative = false;
        if (*(&data[0]) == (i8[min max])45)
        {
            if (length == 1)
            {
                return TextResult<i64[min max]>.Err(TextError.InvalidFormat);
            }

            negative = true;
            index = 1;
        }

        stack mut u64[0 max] limit = (u64[0 max])(2 ** 63 - 1);
        if (negative)
        {
            limit = (u64[0 max])(2 ** 63);
        }
        stack u64[0 max] cutoff = limit / (u64[0 max])10;
        stack u64[0 max] cutlim = limit % (u64[0 max])10;
        stack mut u64[0 max] value = 0;
        while willexit (index < length)
        {
            stack i8[-1 9] digit = AsciiDecimalDigitAt(data, index);
            if (digit < 0)
            {
                return TextResult<i64[min max]>.Err(TextError.InvalidFormat);
            }

            stack u8[0 9] unsignedDigit = (u8[0 9])digit;
            if (value > cutoff || (value == cutoff && (u64[0 max])unsignedDigit > cutlim))
            {
                return TextResult<i64[min max]>.Err(TextError.Overflow);
            }

            value = (value * (u64[0 max])10) + (u64[0 max])unsignedDigit;
            index += 1;
        }

        return FinishParsedI64(negative, value);
    }
