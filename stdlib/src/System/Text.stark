internal fn System.Memory.MemoryResult<OwnedAscii> FinishOwnedAsciiResult(OwnedAscii value, System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<OwnedAscii>.Ok(value);
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<OwnedAscii>.Err(error);
    }
}

internal fn System.Memory.MemoryResult<OwnedUnicode> FinishOwnedUnicodeResult(OwnedUnicode value, System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<OwnedUnicode>.Ok(value);
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<OwnedUnicode>.Err(error);
    }
}

internal fn System.Memory.MemoryStatus AppendFormattedI1024Ascii(mut borrow OwnedAscii destination, i1024[min max] value)
{
    unsafe
    {
        stack mut i8[min max][320] storage;
        stack mut Ascii text = new Ascii()
        {
            Data = &storage[0],
            Length = 0,
            Capacity = 320
        };

        if (!TryFormatI1024Ascii(&text, value))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        return destination.AppendAsciiDisjoint(AsciiView(text));
    }
}

