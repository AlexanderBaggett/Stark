public unsafe finite bool TryFormatU64Unicode(rawmutptr<Unicode> destination, u64[0 max] value)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i32[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (capacity < 0)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] digitCount = 1;
    stack mut u64[0 max] scan = value;
    while willexit (scan >= (u64[0 max])10)
    {
        scan = scan / (u64[0 max])10;
        digitCount += 1;
    }

    if (digitCount > capacity || data == null)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] writeIndex = digitCount - 1;
    stack mut u64[0 max] remaining = value;
    while willexit (remaining >= (u64[0 max])10)
    {
        stack u8[0 9] digit = (u8[0 9])(remaining % (u64[0 max])10);
        stack i32[min max] digitValue = (i32[min max])digit;
        *(&data[writeIndex]) = 48 + digitValue;
        remaining = remaining / (u64[0 max])10;
        writeIndex -= 1;
    }

    stack u8[0 9] finalDigit = (u8[0 9])remaining;
    stack i32[min max] finalDigitValue = (i32[min max])finalDigit;
    *(&data[writeIndex]) = 48 + finalDigitValue;

    *destination = new Unicode()
    {
        Data = data,
        Length = digitCount,
        Capacity = capacity
    };
    return true;
}

