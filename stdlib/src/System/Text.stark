public struct OwnedAscii
{
    alias Writer = OwnedAscii;

    internal dynamic i8[min max] Bytes;

    OwnedAscii()
    {
        self.Bytes = new();
    }

    inline finite law u64[0 2 ** 63 - 1] Length(borrow OwnedAscii self)
    {
        return self.Bytes.Length;
    }

    inline finite law u64[0 2 ** 63 - 1] Capacity(borrow OwnedAscii self)
    {
        return self.Bytes.Capacity;
    }

    inline finite law bool IsEmpty(borrow OwnedAscii self)
    {
        return self.Bytes.Length == 0;
    }

    static finite law u64[0 max] Hash(borrow OwnedAscii value)
    {
        return HashAsciiSlice(value.AsSlice(), value.Bytes.Length);
    }

    static finite law bool Equals(borrow OwnedAscii left, borrow OwnedAscii right)
        where overlap(left, right)
    {
        return EqualsAsciiSlices(left.AsSlice(), right.AsSlice(), left.Bytes.Length, right.Bytes.Length);
    }

    static finite law System.Collections.Ordering Compare(borrow OwnedAscii left, borrow OwnedAscii right)
        where overlap(left, right)
    {
        return CompareAsciiSlices(left.AsSlice(), right.AsSlice(), left.Bytes.Length, right.Bytes.Length);
    }

    static fn System.Memory.MemoryStatus Format(borrow OwnedAscii value, mut borrow OwnedAscii writer)
        where overlap(value, writer)
    {
        return writer.AppendSlice(value.AsSlice(), value.Bytes.Length);
    }

    finite retborrow i8[min max][] AsSlice(borrow OwnedAscii self)
    {
        return self.Bytes[0, self.Bytes.Length];
    }

    finite retborrow mut i8[min max][] AsMutableSlice(mut borrow OwnedAscii self)
    {
        return self.Bytes[0, self.Bytes.Length];
    }

    finite ascii View(mut borrow OwnedAscii self)
    {
        unsafe
        {
            if (self.Bytes.Length == 0)
            {
                return "";
            }

            stack mut Ascii text = new Ascii()
            {
                Data = &self.Bytes[0],
                Length = self.Bytes.Length,
                Capacity = self.Bytes.Length
            };
            return AsciiView(text);
        }
    }

    fn System.Memory.MemoryStatus Reserve(mut borrow OwnedAscii self, u64[0 2 ** 63 - 1] additional)
    {
        if (additional > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) - self.Bytes.Length)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
        }

        if (!self.Bytes.TryReserve(additional))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        return System.Memory.MemoryStatus.Ok;
    }

    fn System.Memory.MemoryStatus AppendByte(mut borrow OwnedAscii self, i8[min max] value)
    {
        stack System.Memory.MemoryStatus status = self.Reserve(1);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        init self.Bytes[self.Bytes.Length] = value;
        return System.Memory.MemoryStatus.Ok;
    }

    internal inline fn System.Memory.MemoryStatus AppendSliceDisjoint(
        mut borrow OwnedAscii self,
        borrow i8[min max][] source,
        u64[0 2 ** 63 - 1] count)
    {
        if (count == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack System.Memory.MemoryStatus status = self.Reserve(count);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        stack init i8[min max][] tail = init self.Bytes[self.Bytes.Length, count];
        unsafe
        {
            return System.Memory.InitializeBytesDisjoint(source, tail, count);
        }
    }

    internal inline fn System.Memory.MemoryStatus AppendAsciiDisjoint(
        mut borrow OwnedAscii self,
        ascii source)
    {
            unsafe
            {
            stack i64[min max] signedLength = AsciiLength(source);
            if (signedLength < 0)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }

            stack u64[0 2 ** 63 - 1] count = (u64[0 2 ** 63 - 1])signedLength;
            if (count == 0)
            {
                return System.Memory.MemoryStatus.Ok;
            }

            stack rawptr<i8[min max]> data = AsciiData(source);
            if (data == null)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }

            stack System.Memory.MemoryStatus status = self.Reserve(count);
            switch (status)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }

            stack init i8[min max][] tail = init self.Bytes[self.Bytes.Length, count];
            unsafe
            {
                return System.Memory.InitializeBytesFromPointerDisjoint(count, data, tail);
            }
            }
    }

    internal inline fn System.Memory.MemoryStatus AppendConstAsciiDisjoint(
        mut borrow OwnedAscii self,
        const ascii source)
        {
            unsafe
            {
            stack i64[min max] signedLength = AsciiLength(source);
            if (signedLength < 0)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }

            stack u64[0 2 ** 63 - 1] count = (u64[0 2 ** 63 - 1])signedLength;
            if (count == 0)
            {
                return System.Memory.MemoryStatus.Ok;
            }

            stack rawptr<i8[min max]> data = AsciiData(source);
            if (data == null)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }

            stack System.Memory.MemoryStatus status = self.Reserve(count);
            switch (status)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }

            stack init i8[min max][] tail = init self.Bytes[self.Bytes.Length, count];
            unsafe
            {
                return System.Memory.InitializeBytesFromPointerDisjoint(count, data, tail);
            }
            }
    }

    fn System.Memory.MemoryStatus AppendSlice(mut borrow OwnedAscii self, borrow i8[min max][] source, u64[0 2 ** 63 - 1] count)
    {
        unsafe
        {
            if (count == 0)
            {
                return System.Memory.MemoryStatus.Ok;
            }

            if disjoint(source, self.Bytes[0, self.Bytes.Length])
            {
                return self.AppendSliceDisjoint(source, count);
            }

            stack mut OwnedAscii snapshot = new();
            stack System.Memory.MemoryStatus snapshotStatus = snapshot.AppendSlice(source, count);
            switch (snapshotStatus)
            {
                case System.Memory.MemoryStatus.Err(var snapshotError):
                    return System.Memory.MemoryStatus.Err(snapshotError);
                case System.Memory.MemoryStatus.Ok:
            }

            return self.AppendSlice(snapshot.AsSlice(), count);
        }
    }

    fn System.Memory.MemoryStatus AppendConstAscii(mut borrow OwnedAscii self, const ascii source)
    {
        unsafe
        {
            stack i64[min max] signedLength = AsciiLength(source);
            if (signedLength < 0)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }

            stack u64[0 2 ** 63 - 1] count = (u64[0 2 ** 63 - 1])signedLength;
            if (count == 0)
            {
                return System.Memory.MemoryStatus.Ok;
            }

            stack rawptr<i8[min max]> data = AsciiData(source);
            if (data == null)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }

            if disjoint(source, self.Bytes[0, self.Bytes.Length])
            {
                return self.AppendConstAsciiDisjoint(source);
            }

            stack mut OwnedAscii snapshot = new();
            stack System.Memory.MemoryStatus snapshotStatus = snapshot.AppendAscii(source);
            switch (snapshotStatus)
            {
                case System.Memory.MemoryStatus.Err(var snapshotError):
                    return System.Memory.MemoryStatus.Err(snapshotError);
                case System.Memory.MemoryStatus.Ok:
            }

            return self.AppendSlice(snapshot.AsSlice(), count);
        }
    }

    fn System.Memory.MemoryStatus AppendAscii(mut borrow OwnedAscii self, ascii source)
        where overlap(self, source)
    {
        unsafe
        {
            stack i64[min max] signedLength = AsciiLength(source);
            if (signedLength < 0)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
