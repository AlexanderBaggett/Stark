fn i32[min max] NormalizeUnicodeCodePoint(i32[min max] codePoint)
{
    unsafe
    {
        if (codePoint < 0)
        {
            return 65533;
        }

        if (55296 <= codePoint && codePoint <= 57343)
        {
            return 65533;
        }

        if (codePoint > 1114111)
        {
            return 65533;
        }

        return codePoint;
    }
}

fn i64[min max] Utf8EncodedLength(i32[min max] codePoint)
{
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);

    if (scalar <= 127)
    {
        return 1;
    }

    if (scalar <= 2047)
    {
        return 2;
    }

    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        return 3;
    }

    return 4;
}

unsafe fn void WriteUtf8CodePoint(
    rawmutptr<i8[min max]>[capacity] destination,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> writeIndex,
    i32[min max] codePoint)
    {
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);
    stack i64[min max] index = *writeIndex;

    if (scalar <= 127)
    {
        *(&destination[index]) = (i8[min max])scalar;
        *writeIndex = index + 1;
        return;
    }

    if (scalar <= 2047)
    {
        *(&destination[index]) = (i8[min max])((scalar >> 6) | 192);
        *(&destination[index + 1]) = (i8[min max])((scalar & 63) | 128);
        *writeIndex = index + 2;
        return;
    }

    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        *(&destination[index]) = (i8[min max])((scalar >> 12) | 224);
        *(&destination[index + 1]) = (i8[min max])(((scalar >> 6) & 63) | 128);
        *(&destination[index + 2]) = (i8[min max])((scalar & 63) | 128);
        *writeIndex = index + 3;
        return;
    }

    *(&destination[index]) = (i8[min max])((scalar >> 18) | 240);
    *(&destination[index + 1]) = (i8[min max])(((scalar >> 12) & 63) | 128);
    *(&destination[index + 2]) = (i8[min max])(((scalar >> 6) & 63) | 128);
    *(&destination[index + 3]) = (i8[min max])((scalar & 63) | 128);
    *writeIndex = index + 4;
}

fn i64[min max] Utf16EncodedLength(i32[min max] codePoint)
{
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);
    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        return 1;
    }

    return 2;
}

unsafe fn void WriteUtf16CodePoint(
    rawmutptr<i16[min max]>[capacity] destination,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> writeIndex,
    i32[min max] codePoint)
    {
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);
    stack i64[min max] index = *writeIndex;

    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        *(&destination[index]) = (i16[min max])scalar;
        *writeIndex = index + 1;
        return;
    }

    stack i32[min max] adjusted = scalar - (i32[min max])(2 ** 16);
    *(&destination[index]) = (i16[min max])((adjusted >> 10) + 55296);
    *(&destination[index + 1]) = (i16[min max])((adjusted & 1023) + 56320);
    *writeIndex = index + 2;
}

unsafe fn bool TryDecodeUtf16CodePoint(
    rawptr<i16[min max]>[length] data,
    u64[0 2 ** 63 - 1] length,
    rawmutptr<i64[min max]> index,
    rawmutptr<i32[min max]> codePoint)
    {
    if (data == null || index == null || codePoint == null)
    {
        return false;
    }

    stack i64[min max] readIndex = *index;
    if (readIndex < 0 || readIndex >= length)
    {
        return false;
    }

    stack i32[min max] first = UnsignedWide(*(&data[readIndex]));
    if (55296 <= first && first <= 56319)
    {
        if (readIndex + 1 < length)
        {
            stack i32[min max] second = UnsignedWide(*(&data[readIndex + 1]));
            *index = readIndex + 2;
            if (56320 <= second && second <= 57343)
            {
                *codePoint = (((first - 55296) << 10) | (second - 56320)) + (i32[min max])(2 ** 16);
                return true;
            }

            *codePoint = 65533;
            return true;
        }

        *index = readIndex + 1;
        *codePoint = 65533;
        return true;
    }

    *index = readIndex + 1;
    if (56320 <= first && first <= 57343)
    {
        *codePoint = 65533;
        return true;
    }

    *codePoint = first;
    return true;
}

internal fn bool TryDecodeUtf16SliceCodePoint(
    borrow OwnedUtf16 data,
    i64[min max] index,
    out i64[min max] nextIndex,
    out i32[min max] codePoint)
{
    nextIndex = index;
    codePoint = 65533;
    if (index < 0 || index >= data.CodeUnits.Length)
    {
        return false;
    }

    stack i16[min max][] units = data.CodeUnits[0, data.CodeUnits.Length];
    stack i32[min max] first = UnsignedWide(units[(u64[0 2 ** 63 - 1])index]);
    if (55296 <= first && first <= 56319)
    {
        if (index + 1 < data.CodeUnits.Length)
        {
            stack i64[min max] secondIndex = index + 1;
            stack i32[min max] second = UnsignedWide(units[(u64[0 2 ** 63 - 1])secondIndex]);
            nextIndex = index + 2;
            if (56320 <= second && second <= 57343)
            {
                codePoint = (((first - 55296) << 10) | (second - 56320)) + (i32[min max])(2 ** 16);
                return true;
            }

            codePoint = 65533;
            return true;
        }

        nextIndex = index + 1;
        codePoint = 65533;
        return true;
    }

    nextIndex = index + 1;
    if (56320 <= first && first <= 57343)
    {
        codePoint = 65533;
        return true;
    }

    codePoint = first;
    return true;
}

public fn System.Memory.MemoryStatus FromUtf16ToUnicode(
    out OwnedUnicode destination,
    borrow OwnedUtf16 source)
{
    destination = new();
    if (source.CodeUnits.Length == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack System.Memory.MemoryStatus reserveStatus = destination.Reserve(source.CodeUnits.Length);
    switch (reserveStatus)
    {
        case System.Memory.MemoryStatus.Err(var reserveError):
            return System.Memory.MemoryStatus.Err(reserveError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut i64[min max] readIndex = 0;
    while willexit (readIndex < source.CodeUnits.Length)
    {
        stack mut i64[min max] nextIndex = readIndex;
        stack mut i32[min max] codePoint = 65533;
        if (!TryDecodeUtf16SliceCodePoint(source, readIndex, nextIndex, codePoint))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        init destination.CodePoints[destination.CodePoints.Length] = NormalizeUnicodeCodePoint(codePoint);
        readIndex = nextIndex;
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus FromUtf16ToAscii(
    out OwnedAscii destination,
    borrow OwnedUtf16 source)
{
    destination = new();
    if (source.CodeUnits.Length == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut i64[min max] readIndex = 0;
    stack mut i64[min max] required = 0;
    while willexit (readIndex < source.CodeUnits.Length)
    {
        stack mut i64[min max] nextIndex = readIndex;
        stack mut i32[min max] codePoint = 65533;
        if (!TryDecodeUtf16SliceCodePoint(source, readIndex, nextIndex, codePoint))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        required += Utf8EncodedLength(codePoint);
        if (required < 0)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
        }

        readIndex = nextIndex;
    }

    stack System.Memory.MemoryStatus reserveStatus = destination.Reserve((u64[0 2 ** 63 - 1])required);
    switch (reserveStatus)
    {
        case System.Memory.MemoryStatus.Err(var reserveError):
            return System.Memory.MemoryStatus.Err(reserveError);
        case System.Memory.MemoryStatus.Ok:
    }

    readIndex = 0;
    while willexit (readIndex < source.CodeUnits.Length)
    {
        stack mut i64[min max] nextIndex = readIndex;
        stack mut i32[min max] codePoint = 65533;
        if (!TryDecodeUtf16SliceCodePoint(source, readIndex, nextIndex, codePoint))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        stack System.Memory.MemoryStatus appendStatus = destination.AppendCodePointAsUtf8(codePoint);
        switch (appendStatus)
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }

        readIndex = nextIndex;
    }

    return System.Memory.MemoryStatus.Ok;
}

public unsafe finite bool TryConcatAscii(rawmutptr<Ascii> destination, ascii left, ascii right)
    where overlap(left, right);
public unsafe finite bool TryConcatUnicode(rawmutptr<Unicode> destination, unicode left, unicode right)
    where overlap(left, right);

public unsafe finite bool TryFormatBoolAscii(rawmutptr<Ascii> destination, bool value)
{
    if (value)
    {
        return TryConcatAscii(destination, "", "true");
    }

    return TryConcatAscii(destination, "", "false");
}

public unsafe finite bool TryFormatEncodingAscii(rawmutptr<Ascii> destination, Encoding value)
{
    switch (value)
    {
        case Encoding.Binary:
            return TryConcatAscii(destination, "", "Binary");
        case Encoding.UTF8:
            return TryConcatAscii(destination, "", "UTF8");
        case Encoding.UTF16:
            return TryConcatAscii(destination, "", "UTF16");
        case Encoding.UTF32:
