unsafe finite bool TryFormatFixed6Ascii(rawmutptr<Ascii> destination, bool negative, u64[0 max] whole, u24[0 999999] fractional)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (capacity < 0)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] digitCount = 1;
    stack mut u64[0 max] scan = whole;
    while willexit (scan >= (u64[0 max])10)
    {
        scan = scan / (u64[0 max])10;
        digitCount += 1;
    }

    stack mut i64[min max] required = digitCount + 7;
    if (negative)
    {
        required += 1;
    }

    if (required > capacity || data == null)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] writeIndex = required - 1;
    stack mut u24[0 999999] remainingFractional = fractional;
    stack mut u8[0 6] fractionalDigitCount = 0;
    while willexit (fractionalDigitCount < 6)
    {
        stack u8[0 9] digit = (u8[0 9])(remainingFractional % 10);
        *(&data[writeIndex]) = (i8[min max])(48 + digit);
        remainingFractional = (u24[0 999999])(remainingFractional / 10);
        writeIndex -= 1;
        fractionalDigitCount += 1;
    }

    *(&data[writeIndex]) = (i8[min max])46;
    writeIndex -= 1;

    stack mut u64[0 max] remainingWhole = whole;
    while willexit (remainingWhole >= (u64[0 max])10)
    {
        stack u8[0 9] digit = (u8[0 9])(remainingWhole % (u64[0 max])10);
        stack i64[min max] digitValue = (i64[min max])digit;
        *(&data[writeIndex]) = (i8[min max])(48 + digitValue);
        remainingWhole = remainingWhole / (u64[0 max])10;
        writeIndex -= 1;
    }

    stack u8[0 9] finalDigit = (u8[0 9])remainingWhole;
    stack i64[min max] finalDigitValue = (i64[min max])finalDigit;
    *(&data[writeIndex]) = (i8[min max])(48 + finalDigitValue);
    if (negative)
    {
        *(&data[0]) = (i8[min max])45;
    }

    *destination = new Ascii()
    {
        Data = data,
        Length = required,
        Capacity = capacity
    };
    return true;
}

public unsafe finite bool TryFormatF64Ascii(rawmutptr<Ascii> destination, f64 value)
{
    if (value != value)
    {
        return false;
    }

    if (value < (f64)(-(2 ** 53)) || value > (f64)(2 ** 53))
    {
        return false;
    }

    stack mut f64 working = value;
    stack mut bool negative = false;
    if (working < 0.0)
    {
        negative = true;
        working = 0.0 - working;
    }

    stack mut u64[0 max] whole = (u64[0 max])System.Math.Truncate(working);
    stack f64 fractional = working - (f64)whole;
    stack mut i64[min max] scaledFractional =
        (i64[min max])System.Math.Truncate((fractional * 1000000.0) + 0.5);

    if (scaledFractional >= 1000000)
    {
        whole += (u64[0 max])1;
        scaledFractional = 0;
    }

    return TryFormatFixed6Ascii(destination, negative, whole, (u24[0 999999])scaledFractional);
}

