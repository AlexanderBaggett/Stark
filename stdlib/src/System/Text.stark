public finite TextResult<i1024[min max]> ParseI1024Ascii(ascii source)
{
    unsafe
    {
        stack i64[min max] length = AsciiLength(source);
        if (length <= 0)
        {
            return TextResult<i1024[min max]>.Err(TextError.InvalidFormat);
        }

        stack rawptr<i8[min max]> data = AsciiData(source);
        if (data == null)
        {
            return TextResult<i1024[min max]>.Err(TextError.InvalidFormat);
        }

        stack mut i64[min max] index = 0;
        stack mut bool negative = false;
        if (*(&data[0]) == (i8[min max])45)
        {
            if (length == 1)
            {
                return TextResult<i1024[min max]>.Err(TextError.InvalidFormat);
            }

            negative = true;
            index = 1;
        }

        stack u1024[0 max] cutoff = (u1024[0 max]);
        stack mut u1024[0 max] cutlim = 7;
        if (negative)
        {
            cutlim = 8;
        }
        stack mut u1024[0 max] value = 0;
        while willexit (index < length)
        {
            stack i8[-1 9] digit = AsciiDecimalDigitAt(data, index);
            if (digit < 0)
            {
                return TextResult<i1024[min max]>.Err(TextError.InvalidFormat);
            }

            stack u8[0 9] unsignedDigit = (u8[0 9])digit;
            if (value > cutoff || (value == cutoff && (u1024[0 max])unsignedDigit > cutlim))
            {
                return TextResult<i1024[min max]>.Err(TextError.Overflow);
            }

            value = (value * (u1024[0 max])10) + (u1024[0 max])unsignedDigit;
            index += 1;
        }

        return FinishParsedI1024(negative, value);
    }
}

