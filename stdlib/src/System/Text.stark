public unsafe fn bool TryFormatBoolUnicode(rawmutptr<Unicode> destination, bool value)
{
    stack mut i8[min max][5] buffer =
    {
        0, 0, 0, 0, 0
    };
    stack mut Ascii asciiText = new Ascii()
    {
        Data = &buffer[0],
        Length = 0,
        Capacity = 5
    };

    if (!TryFormatBoolAscii(&asciiText, value))
    {
        return false;
    }

    return TryConvertAsciiToUnicode(destination, AsciiView(asciiText));
}

