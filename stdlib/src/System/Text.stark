finite TextResult<i1024[min max]> FinishParsedI1024(bool negative, u1024[0 max] magnitude)
{
    if (negative)
    {
        if (magnitude == (u1024[0 max])(2 ** 1023))
        {
            return TextResult<i1024[min max]>.Ok((i1024[min max])(-(2 ** 1023)));
        }

