unsafe finite bool TryFormatSignedU128Unicode(rawmutptr<Unicode> destination, bool negative, u128[0 max] magnitude)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i32[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (capacity < 0)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] digitCount = 1;
    stack mut u128[0 max] scan = magnitude;
    while willexit (scan >= (u128[0 max])10)
    {
        scan = scan / (u128[0 max])10;
        digitCount += 1;
    }

    stack mut i64[min max] required = digitCount;
    if (negative)
    {
        required += 1;
    }

    if (required > capacity || data == null)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] writeIndex = required - 1;
    stack mut u128[0 max] remaining = magnitude;
    while willexit (remaining >= (u128[0 max])10)
    {
        stack u8[0 9] digit = (u8[0 9])(remaining % (u128[0 max])10);
        stack i32[min max] digitValue = (i32[min max])digit;
        *(&data[writeIndex]) = 48 + digitValue;
        remaining = remaining / (u128[0 max])10;
        writeIndex -= 1;
    }

    stack u8[0 9] finalDigit = (u8[0 9])remaining;
    stack i32[min max] finalDigitValue = (i32[min max])finalDigit;
    *(&data[writeIndex]) = 48 + finalDigitValue;
    if (negative)
    {
        *(&data[0]) = 45;
    }

    *destination = new Unicode()
    {
        Data = data,
        Length = required,
        Capacity = capacity
    };
    return true;
}

public unsafe finite bool TryFormatI128Unicode(rawmutptr<Unicode> destination, i128[min max] value)
{
    if (value == (i128[min max])(-(2 ** 127)))
    {
