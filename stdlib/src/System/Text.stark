public unsafe finite bool TryFormatI64Unicode(rawmutptr<Unicode> destination, i64[min max] value)
{
    if (destination == null)
    {
        return false;
    }

    if (value == -(2 ** 63))
    {
        return TryConcatUnicode(destination, (unicode)"", (unicode)"-9223372036854775808");
    }

    stack rawmutptr<i32[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (capacity < 0)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack i64[min max] signedValue = value;
    stack bool negative = signedValue < 0;
    stack mut i64[min max] magnitude = signedValue;
    if (negative)
    {
        magnitude = 0 - signedValue;
    }

    stack mut i64[min max] digitCount = 1;
    stack mut i64[min max] scan = magnitude;
    while willexit (scan >= 10)
    {
        scan = scan / 10;
        digitCount += 1;
    }

    stack mut i64[min max] required = digitCount;
    if (negative)
    {
        required += 1;
    }

    if (required > capacity || data == null)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] writeIndex = required - 1;
    stack mut i64[min max] remaining = magnitude;
    while willexit (remaining >= 10)
    {
        stack i64[min max] digit = remaining % 10;
        *(&data[writeIndex]) = 48 + (i32[min max])digit;
        remaining = remaining / 10;
        writeIndex -= 1;
    }

    *(&data[writeIndex]) = 48 + (i32[min max])remaining;
    if (negative)
    {
        *(&data[0]) = 45;
    }

    *destination = new Unicode()
    {
        Data = data,
        Length = required,
        Capacity = capacity
    };
    return true;
}

unsafe finite bool TryFormatSignedU1024Unicode(rawmutptr<Unicode> destination, bool negative, u1024[0 max] magnitude)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i32[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (capacity < 0)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i8[min max][320] reversedDigits =
    {
        0
    };
    stack i64[min max] digitCount = WriteReversedU1024AsciiDigits(&reversedDigits[0], magnitude);
    stack mut i64[min max] required = digitCount;
    if (negative)
    {
        required += 1;
    }

    if (required > capacity || data == null)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    if (negative)
    {
        *(&data[0]) = 45;
    }

    for willexit (stack mut i64[min max] digitIndex = 0; digitIndex < digitCount; digitIndex += 1)
    {
        stack i64[min max] sourceIndex = digitCount - 1 - digitIndex;
        stack mut i64[min max] destinationIndex = digitIndex;
        if (negative)
        {
            destinationIndex += 1;
        }

        *(&data[destinationIndex]) = (i32[min max])reversedDigits[sourceIndex];
    }

    *destination = new Unicode()
    {
        Data = data,
        Length = required,
        Capacity = capacity
    };
    return true;
}

public unsafe finite bool TryFormatI1024Unicode(rawmutptr<Unicode> destination, i1024[min max] value)
{
    if (value == (i1024[min max])(-(2 ** 1023)))
    {
        return TryFormatSignedU1024Unicode(destination, true, (u1024[0 max])(2 ** 1023));
    }

    if (value < 0)
    {
        return TryFormatSignedU1024Unicode(destination, true, (u1024[0 max])(0 - value));
    }

    return TryFormatSignedU1024Unicode(destination, false, (u1024[0 max])value);
}

