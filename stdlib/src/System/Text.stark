public finite TextResult<u128[0 max]> ParseU128Ascii(ascii source)
{
    unsafe
    {
        stack i64[min max] length = AsciiLength(source);
        if (length <= 0)
        {
            return TextResult<u128[0 max]>.Err(TextError.InvalidFormat);
        }

        stack rawptr<i8[min max]> data = AsciiData(source);
        if (data == null)
        {
            return TextResult<u128[0 max]>.Err(TextError.InvalidFormat);
        }

        stack u128[0 max] limit = (u128[0 max])(2 ** 128 - 1);
        stack u128[0 max] cutoff = limit / (u128[0 max])10;
        stack u128[0 max] cutlim = limit % (u128[0 max])10;
        stack mut u128[0 max] value = 0;
        stack mut i64[min max] index = 0;
        while willexit (index < length)
        {
            stack i8[-1 9] digit = AsciiDecimalDigitAt(data, index);
            if (digit < 0)
            {
                return TextResult<u128[0 max]>.Err(TextError.InvalidFormat);
            }

            stack u8[0 9] unsignedDigit = (u8[0 9])digit;
            if (value > cutoff || (value == cutoff && (u128[0 max])unsignedDigit > cutlim))
            {
                return TextResult<u128[0 max]>.Err(TextError.Overflow);
            }

            value = (value * (u128[0 max])10) + (u128[0 max])unsignedDigit;
            index += 1;
        }

        return TextResult<u128[0 max]>.Ok(value);
    }
}

