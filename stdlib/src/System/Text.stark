public fn System.Memory.MemoryResult<OwnedUnicode> ToUnicode(Encoding value)
{
    stack mut OwnedUnicode destination = new();
    stack mut System.Memory.MemoryStatus status = System.Memory.MemoryStatus.Ok;
    switch (value)
    {
        case Encoding.Binary:
            status = destination.AppendConstUnicodeDisjoint((unicode)"Binary");
        case Encoding.UTF8:
            status = destination.AppendConstUnicodeDisjoint((unicode)"UTF8");
        case Encoding.UTF16:
            status = destination.AppendConstUnicodeDisjoint((unicode)"UTF16");
        case Encoding.UTF32:
            status = destination.AppendConstUnicodeDisjoint((unicode)"UTF32");
    }

    return FinishOwnedUnicodeResult(destination, status);
}

public fn System.Memory.MemoryResult<OwnedUnicode> ToUnicode(TextError value)
{
    stack mut OwnedUnicode destination = new();
    stack mut System.Memory.MemoryStatus status = System.Memory.MemoryStatus.Ok;
    switch (value)
    {
        case TextError.InvalidFormat:
            status = destination.AppendConstUnicodeDisjoint((unicode)"InvalidFormat");
        case TextError.Overflow:
            status = destination.AppendConstUnicodeDisjoint((unicode)"Overflow");
    }

    return FinishOwnedUnicodeResult(destination, status);
}

public fn System.Memory.MemoryResult<OwnedUnicode> ConcatUnicode(unicode left, u64[0 2 ** 63 - 1] leftLength, System.Memory.MemoryResult<OwnedUnicode> right)
{
    switch (right)
    {
        case System.Memory.MemoryResult<OwnedUnicode>.Ok(var value):
            stack mut OwnedUnicode rightValue = value;
            stack mut OwnedUnicode destination = new();
            if (leftLength > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) - rightValue.Length())
            {
                return System.Memory.MemoryResult<OwnedUnicode>.Err(System.Memory.MemoryError.TooLarge);
            }

            stack System.Memory.MemoryStatus reserveStatus = destination.Reserve(leftLength + rightValue.Length());
            switch (reserveStatus)
            {
                case System.Memory.MemoryStatus.Err(var reserveError):
                    return System.Memory.MemoryResult<OwnedUnicode>.Err(reserveError);
                case System.Memory.MemoryStatus.Ok:
            }

            stack System.Memory.MemoryStatus leftStatus = destination.AppendUnicodeDisjoint(left);
            switch (leftStatus)
            {
                case System.Memory.MemoryStatus.Err(var leftError):
                    return System.Memory.MemoryResult<OwnedUnicode>.Err(leftError);
                case System.Memory.MemoryStatus.Ok:
            }

            stack unicode rightView = rightValue.View();
            stack System.Memory.MemoryStatus rightStatus = destination.AppendUnicodeDisjoint(rightView);
            return FinishOwnedUnicodeResult(destination, rightStatus);
        case System.Memory.MemoryResult<OwnedUnicode>.Err(var error):
            return System.Memory.MemoryResult<OwnedUnicode>.Err(error);
    }
}
internal unsafe inline finite bool TryConvertAsciiToUnicode(rawmutptr<Unicode> destination, ascii source);

internal unsafe fn bool TryConvertAsciiToUtf16(
    rawmutptr<i16[min max]>[capacity] destination,
    u64[0 2 ** 63 - 1] capacity,
    ascii source,
    rawmutptr<i64[min max]> writtenLength)
    where disjoint(source, destination[0, capacity])
{
    if (writtenLength == null)
    {
        return false;
    }

    *writtenLength = 0;
    stack i64[min max] sourceLength = AsciiLength(source);
    if (sourceLength < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] sourceCount = (u64[0 2 ** 63 - 1])sourceLength;
    stack ascii view = source[0, sourceLength];
    stack rawptr<i8[min max]> data = AsciiData(view);
    if (sourceLength > 0 && data == null)
    {
        return false;
    }

    stack mut i64[min max] readIndex = 0;
    stack mut i64[min max] writeIndex = 0;
    while willexit (readIndex < sourceLength)
    {
        stack i64[min max] start = readIndex;
        stack mut i32[min max] codePoint = 65533;
        stack mut bool decoded = false;
        unsafe
        {
            decoded = TryDecodeUtf8CodePoint(data, sourceCount, &readIndex, &codePoint);
        }

        if (!decoded)
        {
            readIndex = start + 1;
        }

        stack i64[min max] required = Utf16EncodedLength(codePoint);
        if (writeIndex + required > capacity || (required > 0 && destination == null))
        {
            *writtenLength = 0;
            return false;
        }

        WriteUtf16CodePoint(destination, capacity, &writeIndex, codePoint);
    }

    *writtenLength = writeIndex;
    return true;
}

internal unsafe fn bool TryConvertUtf16ToUnicode(
    rawmutptr<Unicode> destination,
    rawptr<i16[min max]>[sourceLength] source,
    u64[0 2 ** 63 - 1] sourceLength)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i32[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (capacity < 0)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    if (sourceLength > 0 && source == null)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] readIndex = 0;
    stack mut i64[min max] required = 0;
    stack mut i32[min max] codePoint = 65533;
    while willexit (readIndex < sourceLength)
    {
        codePoint = 65533;
        if (!TryDecodeUtf16CodePoint(source, sourceLength, &readIndex, &codePoint))
        {
            *destination = new Unicode()
            {
                Data = data,
                Length = 0,
                Capacity = capacity
            };
            return false;
        }

        required += 1;
        if (required > capacity)
        {
            *destination = new Unicode()
            {
                Data = data,
                Length = 0,
                Capacity = capacity
            };
            return false;
        }
    }

    if (required > 0 && data == null)
    {
        *destination = new Unicode()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] writeIndex = 0;
    readIndex = 0;
    while willexit (readIndex < sourceLength)
    {
        codePoint = 65533;
        if (!TryDecodeUtf16CodePoint(source, sourceLength, &readIndex, &codePoint))
        {
            *destination = new Unicode()
            {
                Data = data,
                Length = 0,
                Capacity = capacity
            };
            return false;
        }

        *(&data[writeIndex]) = NormalizeUnicodeCodePoint(codePoint);
        writeIndex += 1;
    }

    *destination = new Unicode()
    {
        Data = data,
        Length = writeIndex,
        Capacity = capacity
    };
    return true;
}

internal unsafe fn bool TryConvertUnicodeToAscii(rawmutptr<Ascii> destination, unicode source)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (capacity < 0)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack u64[0 2 ** 63 - 1] safeCapacity = (u64[0 2 ** 63 - 1])capacity;
    stack i64[min max] sourceLength = UnicodeLength(source);
    if (sourceLength < 0)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack rawptr<i32[min max]> sourceData = UnicodeData(source);
    if (sourceLength > 0 && sourceData == null)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] readIndex = 0;
    stack mut i64[min max] required = 0;
    while willexit (readIndex < sourceLength)
    {
        required += Utf8EncodedLength(*(&sourceData[readIndex]));
        if (required > capacity)
        {
            *destination = new Ascii()
            {
                Data = data,
                Length = 0,
                Capacity = capacity
            };
            return false;
        }

        readIndex += 1;
    }

    if (required > 0 && data == null)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] writeIndex = 0;
    stack mut i64[min max] sourceIndex = 0;
    while willexit (sourceIndex < sourceLength)
    {
        unsafe
        {
            WriteUtf8CodePoint(data, safeCapacity, &writeIndex, *(&sourceData[sourceIndex]));
        }

        sourceIndex += 1;
    }

    *destination = new Ascii()
    {
        Data = data,
        Length = writeIndex,
        Capacity = capacity
    };
    return true;
}

internal unsafe fn bool TryConvertUnicodeToUtf16(
    rawmutptr<i16[min max]>[capacity] destination,
    u64[0 2 ** 63 - 1] capacity,
    unicode source,
    rawmutptr<i64[min max]> writtenLength)
    where disjoint(source, destination[0, capacity])
{
    if (writtenLength == null)
    {
        return false;
    }

    *writtenLength = 0;
    stack i64[min max] sourceLength = UnicodeLength(source);
    if (sourceLength < 0)
    {
        return false;
    }

    stack rawptr<i32[min max]> sourceData = UnicodeData(source);
    if (sourceLength > 0 && sourceData == null)
    {
        return false;
    }

    stack mut i64[min max] readIndex = 0;
    stack mut i64[min max] required = 0;
    while willexit (readIndex < sourceLength)
    {
        required += Utf16EncodedLength(*(&sourceData[readIndex]));
        if (required > capacity)
        {
            return false;
        }

        readIndex += 1;
    }

    if (required > 0 && destination == null)
    {
        return false;
    }

    stack mut i64[min max] writeIndex = 0;
    stack mut i64[min max] sourceIndex = 0;
    while willexit (sourceIndex < sourceLength)
    {
        WriteUtf16CodePoint(destination, capacity, &writeIndex, *(&sourceData[sourceIndex]));
        sourceIndex += 1;
    }

    *writtenLength = writeIndex;
    return true;
}

