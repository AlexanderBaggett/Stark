internal inline finite law u64[0 max] TextHashOffsetBasis()
{
    return (u64[0 max])14695981039346656037;
}

internal inline finite law u64[0 max] TextHashPrime()
{
    return (u64[0 max])1099511628211;
}

internal fn i32[min max] UnsignedByte(i8[min max] value)
{
    if (value < 0)
    {
        return ((i32[min max])value) + 256;
    }

    return (i32[min max])value;
}

internal inline finite law u64[0 max] UnsignedCodePoint(i32[min max] value)
{
    if (value < 0)
    {
        return (u64[0 max])((i64[min max])value + 4294967296);
    }

    return (u64[0 max])value;
}

internal inline finite law u64[0 max] MixAsciiHash(u64[0 max] hash, i8[min max] unit)
{
    return (hash ^ (u64[0 max])UnsignedByte(unit)) *% TextHashPrime();
}

internal inline finite law u64[0 max] MixUnicodeHash(u64[0 max] hash, i32[min max] unit)
{
    return (hash ^ UnsignedCodePoint(unit)) *% TextHashPrime();
}

internal finite law u64[0 max] HashAsciiSlice(
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] count)
{
    stack mut u64[0 max] hash = TextHashOffsetBasis();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        hash = MixAsciiHash(hash, source[index]);
    }

    return hash;
}

internal finite law u64[0 max] HashUnicodeSlice(
    borrow i32[min max][] source,
    u64[0 2 ** 63 - 1] count)
{
    stack mut u64[0 max] hash = TextHashOffsetBasis();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        hash = MixUnicodeHash(hash, source[index]);
    }

    return hash;
}

internal finite law bool EqualsAsciiSlices(
    borrow i8[min max][] left,
    borrow i8[min max][] right,
    u64[0 2 ** 63 - 1] leftLength,
    u64[0 2 ** 63 - 1] rightLength)
    where overlap(left, right)
{
    if (leftLength != rightLength)
    {
        return false;
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < leftLength; index += 1)
    {
        if (left[index] != right[index])
        {
            return false;
        }
    }

    return true;
}

internal finite law bool EqualsUnicodeSlices(
    borrow i32[min max][] left,
    borrow i32[min max][] right,
    u64[0 2 ** 63 - 1] leftLength,
    u64[0 2 ** 63 - 1] rightLength)
    where overlap(left, right)
{
