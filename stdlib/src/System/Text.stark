public unsafe finite bool TryFormatI64Ascii(rawmutptr<Ascii> destination, i64[min max] value)
{
    if (destination == null)
    {
        return false;
    }

    if (value == -(2 ** 63))
    {
        return TryConcatAscii(destination, "", "-9223372036854775808");
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (capacity < 0)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack i64[min max] signedValue = value;
    stack bool negative = signedValue < 0;
    stack mut i64[min max] magnitude = signedValue;
    if (negative)
    {
        magnitude = 0 - signedValue;
    }

    stack mut i64[min max] digitCount = 1;
    stack mut i64[min max] scan = magnitude;
    while willexit (scan >= 10)
    {
        scan = scan / 10;
        digitCount += 1;
    }

    stack mut i64[min max] required = digitCount;
    if (negative)
    {
        required += 1;
    }

    if (required > capacity || data == null)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i64[min max] writeIndex = required - 1;
    stack mut i64[min max] remaining = magnitude;
    while willexit (remaining >= 10)
    {
        stack i64[min max] digit = remaining % 10;
        *(&data[writeIndex]) = (i8[min max])(48 + digit);
        remaining = remaining / 10;
        writeIndex -= 1;
    }

    *(&data[writeIndex]) = (i8[min max])(48 + remaining);
    if (negative)
    {
        *(&data[0]) = (i8[min max])45;
    }

    *destination = new Ascii()
    {
        Data = data,
        Length = required,
        Capacity = capacity
    };
    return true;
}

unsafe finite void LoadU1024FormatLimbs(rawmutptr<u64[0 max]>[16] limbs, u1024[0 max] value)
{
    stack u1024[0 max] mask = (u1024[0 max])(2 ** 64 - 1);
    *(&limbs[0]) = (u64[0 max])(value & mask);
    *(&limbs[1]) = (u64[0 max])((value >> 64) & mask);
    *(&limbs[2]) = (u64[0 max])((value >> 128) & mask);
    *(&limbs[3]) = (u64[0 max])((value >> 192) & mask);
    *(&limbs[4]) = (u64[0 max])((value >> 256) & mask);
    *(&limbs[5]) = (u64[0 max])((value >> 320) & mask);
    *(&limbs[6]) = (u64[0 max])((value >> 384) & mask);
    *(&limbs[7]) = (u64[0 max])((value >> 448) & mask);
    *(&limbs[8]) = (u64[0 max])((value >> 512) & mask);
    *(&limbs[9]) = (u64[0 max])((value >> 576) & mask);
    *(&limbs[10]) = (u64[0 max])((value >> 640) & mask);
    *(&limbs[11]) = (u64[0 max])((value >> 704) & mask);
    *(&limbs[12]) = (u64[0 max])((value >> 768) & mask);
    *(&limbs[13]) = (u64[0 max])((value >> 832) & mask);
    *(&limbs[14]) = (u64[0 max])((value >> 896) & mask);
    *(&limbs[15]) = (u64[0 max])((value >> 960) & mask);
    return;
}

unsafe finite bool U1024FormatLimbsAreZero(rawptr<u64[0 max]>[16] limbs)
{
    for willexit (stack mut u8[0 16] index = 0; index < 16; index += 1)
    {
        if (*(&limbs[index]) != 0)
        {
            return false;
        }
    }

    return true;
}

unsafe finite u8[0 9] DivideU1024FormatLimbsBy10(rawmutptr<u64[0 max]>[16] limbs)
{
    stack mut u128[0 max] carry = 0;
    for willexit (stack mut u8[0 16] offset = 0; offset < 16; offset += 1)
    {
        stack u8[0 15] index = (u8[0 15])(15 - offset);
        stack u128[0 max] current = (carry << 64) | (u128[0 max])(*(&limbs[index]));
        *(&limbs[index]) = (u64[0 max])(current / (u128[0 max])10);
        carry = current % (u128[0 max])10;
    }

    return (u8[0 9])carry;
}

unsafe finite i64[min max] WriteReversedU1024AsciiDigits(rawmutptr<i8[min max]>[320] destination, u1024[0 max] magnitude)
{
    if (magnitude == 0)
    {
        *(&destination[0]) = (i8[min max])48;
        return 1;
    }

    stack mut u64[0 max][16] limbs =
    {
        0
    };
    LoadU1024FormatLimbs(&limbs[0], magnitude);

    stack mut i64[min max] digitCount = 0;
    while willexit (!U1024FormatLimbsAreZero(&limbs[0]))
    {
        stack u8[0 9] digit = DivideU1024FormatLimbsBy10(&limbs[0]);
        stack i64[min max] digitValue = (i64[min max])digit;
        *(&destination[digitCount]) = (i8[min max])(48 + digitValue);
        digitCount += 1;
    }

    return digitCount;
}

unsafe finite bool TryFormatSignedU1024Ascii(rawmutptr<Ascii> destination, bool negative, u1024[0 max] magnitude)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (capacity < 0)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack mut i8[min max][320] reversedDigits =
    {
        0
    };
    stack i64[min max] digitCount = WriteReversedU1024AsciiDigits(&reversedDigits[0], magnitude);
    stack mut i64[min max] required = digitCount;
    if (negative)
    {
        required += 1;
    }

    if (required > capacity || data == null)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    if (negative)
    {
        *(&data[0]) = (i8[min max])45;
    }

    for willexit (stack mut i64[min max] digitIndex = 0; digitIndex < digitCount; digitIndex += 1)
    {
        stack i64[min max] sourceIndex = digitCount - 1 - digitIndex;
        stack mut i64[min max] destinationIndex = digitIndex;
        if (negative)
        {
            destinationIndex += 1;
        }

        *(&data[destinationIndex]) = reversedDigits[sourceIndex];
    }

    *destination = new Ascii()
    {
        Data = data,
        Length = required,
        Capacity = capacity
    };
    return true;
}

public unsafe finite bool TryFormatI1024Ascii(rawmutptr<Ascii> destination, i1024[min max] value)
{
    if (value == (i1024[min max])(-(2 ** 1023)))
    {
        return TryFormatSignedU1024Ascii(destination, true, (u1024[0 max])(2 ** 1023));
    }

    if (value < 0)
    {
        return TryFormatSignedU1024Ascii(destination, true, (u1024[0 max])(0 - value));
    }

    return TryFormatSignedU1024Ascii(destination, false, (u1024[0 max])value);
}

