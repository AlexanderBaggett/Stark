public finite TextResult<bool> ParseBoolAscii(ascii source)
{
    unsafe
    {
        stack i64[min max] length = AsciiLength(source);
        stack rawptr<i8[min max]> data = AsciiData(source);
        if (data == null)
        {
            return TextResult<bool>.Err(TextError.InvalidFormat);
        }

        if (length == 4)
        {
            if (*(&data[0]) == (i8[min max])116
                && *(&data[1]) == (i8[min max])114
                && *(&data[2]) == (i8[min max])117
                && *(&data[3]) == (i8[min max])101)
                {
                return TextResult<bool>.Ok(true);
            }
        }

        if (length == 5)
        {
            if (*(&data[0]) == (i8[min max])102
                && *(&data[1]) == (i8[min max])97
                && *(&data[2]) == (i8[min max])108
                && *(&data[3]) == (i8[min max])115
                && *(&data[4]) == (i8[min max])101)
