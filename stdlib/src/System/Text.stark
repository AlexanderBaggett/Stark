public fn System.Memory.MemoryResult<OwnedAscii> ToAscii(Encoding value)
{
    stack mut OwnedAscii destination = new();
    stack mut System.Memory.MemoryStatus status = System.Memory.MemoryStatus.Ok;
    switch (value)
    {
        case Encoding.Binary:
            status = destination.AppendConstAsciiDisjoint("Binary");
        case Encoding.UTF8:
            status = destination.AppendConstAsciiDisjoint("UTF8");
        case Encoding.UTF16:
            status = destination.AppendConstAsciiDisjoint("UTF16");
        case Encoding.UTF32:
            status = destination.AppendConstAsciiDisjoint("UTF32");
    }

    return FinishOwnedAsciiResult(destination, status);
}

public fn System.Memory.MemoryResult<OwnedAscii> ToAscii(TextError value)
{
    stack mut OwnedAscii destination = new();
    stack mut System.Memory.MemoryStatus status = System.Memory.MemoryStatus.Ok;
    switch (value)
    {
        case TextError.InvalidFormat:
            status = destination.AppendConstAsciiDisjoint("InvalidFormat");
        case TextError.Overflow:
            status = destination.AppendConstAsciiDisjoint("Overflow");
    }

    return FinishOwnedAsciiResult(destination, status);
}

public fn System.Memory.MemoryResult<OwnedAscii> ConcatAscii(ascii left, u64[0 2 ** 63 - 1] leftLength, System.Memory.MemoryResult<OwnedAscii> right)
{
    switch (right)
    {
        case System.Memory.MemoryResult<OwnedAscii>.Ok(var value):
            stack mut OwnedAscii rightValue = value;
            stack mut OwnedAscii destination = new();
            if (leftLength > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) - rightValue.Length())
            {
                return System.Memory.MemoryResult<OwnedAscii>.Err(System.Memory.MemoryError.TooLarge);
            }

            stack System.Memory.MemoryStatus reserveStatus = destination.Reserve(leftLength + rightValue.Length());
            switch (reserveStatus)
            {
                case System.Memory.MemoryStatus.Err(var reserveError):
                    return System.Memory.MemoryResult<OwnedAscii>.Err(reserveError);
                case System.Memory.MemoryStatus.Ok:
            }

            stack System.Memory.MemoryStatus leftStatus = destination.AppendAsciiDisjoint(left);
            switch (leftStatus)
            {
                case System.Memory.MemoryStatus.Err(var leftError):
                    return System.Memory.MemoryResult<OwnedAscii>.Err(leftError);
                case System.Memory.MemoryStatus.Ok:
            }

            stack ascii rightView = rightValue.View();
            stack System.Memory.MemoryStatus rightStatus = destination.AppendAsciiDisjoint(rightView);
            return FinishOwnedAsciiResult(destination, rightStatus);
        case System.Memory.MemoryResult<OwnedAscii>.Err(var error):
            return System.Memory.MemoryResult<OwnedAscii>.Err(error);
    }
}

