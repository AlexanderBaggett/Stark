}

internal finite law System.Collections.Ordering CompareAsciiSlices(
    borrow i8[min max][] left,
    borrow i8[min max][] right,
    u64[0 2 ** 63 - 1] leftLength,
    u64[0 2 ** 63 - 1] rightLength)
    where overlap(left, right)
{
    stack mut u64[0 2 ** 63 - 1] count = leftLength;
    if (rightLength < count)
    {
        count = rightLength;
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack i32[min max] leftUnit = UnsignedByte(left[index]);
        stack i32[min max] rightUnit = UnsignedByte(right[index]);
        if (leftUnit < rightUnit)
        {
            return System.Collections.Ordering.Less;
        }

        if (leftUnit > rightUnit)
        {
            return System.Collections.Ordering.Greater;
        }
    }

    if (leftLength < rightLength)
    {
        return System.Collections.Ordering.Less;
    }

    if (leftLength > rightLength)
    {
        return System.Collections.Ordering.Greater;
    }

    return System.Collections.Ordering.Equal;
}

internal finite law System.Collections.Ordering CompareUnicodeSlices(
    borrow i32[min max][] left,
    borrow i32[min max][] right,
    u64[0 2 ** 63 - 1] leftLength,
    u64[0 2 ** 63 - 1] rightLength)
    where overlap(left, right)
{
    stack mut u64[0 2 ** 63 - 1] count = leftLength;
    if (rightLength < count)
    {
        count = rightLength;
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack u64[0 max] leftUnit = UnsignedCodePoint(left[index]);
        stack u64[0 max] rightUnit = UnsignedCodePoint(right[index]);
        if (leftUnit < rightUnit)
        {
            return System.Collections.Ordering.Less;
        }

        if (leftUnit > rightUnit)
        {
            return System.Collections.Ordering.Greater;
        }
    }

    if (leftLength < rightLength)
    {
        return System.Collections.Ordering.Less;
    }

    if (leftLength > rightLength)
    {
        return System.Collections.Ordering.Greater;
    }

    return System.Collections.Ordering.Equal;
}

public finite law u64[0 max] Hash(ascii value)
{
    unsafe
    {
        stack i64[min max] signedLength = AsciiLength(value);
        if (signedLength <= 0)
        {
            return TextHashOffsetBasis();
        }

        stack rawptr<i8[min max]> data = AsciiData(value);
        if (data == null)
        {
            return TextHashOffsetBasis();
        }

        stack mut u64[0 max] hash = TextHashOffsetBasis();
        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            hash = MixAsciiHash(hash, *(&data[index]));
        }

        return hash;
    }
}

public finite law u64[0 max] Hash(unicode value)
{
    unsafe
    {
        stack i64[min max] signedLength = UnicodeLength(value);
        if (signedLength <= 0)
        {
            return TextHashOffsetBasis();
        }

        stack rawptr<i32[min max]> data = UnicodeData(value);
        if (data == null)
        {
            return TextHashOffsetBasis();
        }

        stack mut u64[0 max] hash = TextHashOffsetBasis();
        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            hash = MixUnicodeHash(hash, *(&data[index]));
        }

        return hash;
    }
}

public finite law bool Equals(ascii left, ascii right)
    where overlap(left, right)
{
    return left == right;
}

public finite law bool Equals(unicode left, unicode right)
    where overlap(left, right)
{
    return left == right;
}

public finite law System.Collections.Ordering Compare(ascii left, ascii right)
    where overlap(left, right)
{
    unsafe
    {
        stack i64[min max] leftSignedLength = AsciiLength(left);
        stack i64[min max] rightSignedLength = AsciiLength(right);
        if (leftSignedLength < 0 || rightSignedLength < 0)
        {
            return System.Collections.Ordering.Equal;
        }

        stack u64[0 2 ** 63 - 1] leftLength = (u64[0 2 ** 63 - 1])leftSignedLength;
        stack u64[0 2 ** 63 - 1] rightLength = (u64[0 2 ** 63 - 1])rightSignedLength;
        stack mut u64[0 2 ** 63 - 1] count = leftLength;
        if (rightLength < count)
        {
            count = rightLength;
        }

        stack rawptr<i8[min max]> leftData = AsciiData(left);
        stack rawptr<i8[min max]> rightData = AsciiData(right);
        if ((leftData == null && leftLength != 0) || (rightData == null && rightLength != 0))
        {
            return System.Collections.Ordering.Equal;
        }

        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            stack i32[min max] leftUnit = UnsignedByte(*(&leftData[index]));
            stack i32[min max] rightUnit = UnsignedByte(*(&rightData[index]));
            if (leftUnit < rightUnit)
            {
                return System.Collections.Ordering.Less;
            }

            if (leftUnit > rightUnit)
            {
                return System.Collections.Ordering.Greater;
            }
        }

        if (leftLength < rightLength)
        {
            return System.Collections.Ordering.Less;
        }

        if (leftLength > rightLength)
        {
            return System.Collections.Ordering.Greater;
        }

        return System.Collections.Ordering.Equal;
    }
}

public finite law System.Collections.Ordering Compare(unicode left, unicode right)
    where overlap(left, right)
{
    unsafe
    {
        stack i64[min max] leftSignedLength = UnicodeLength(left);
        stack i64[min max] rightSignedLength = UnicodeLength(right);
        if (leftSignedLength < 0 || rightSignedLength < 0)
        {
            return System.Collections.Ordering.Equal;
        }

        stack u64[0 2 ** 63 - 1] leftLength = (u64[0 2 ** 63 - 1])leftSignedLength;
        stack u64[0 2 ** 63 - 1] rightLength = (u64[0 2 ** 63 - 1])rightSignedLength;
        stack mut u64[0 2 ** 63 - 1] count = leftLength;
        if (rightLength < count)
        {
            count = rightLength;
        }

        stack rawptr<i32[min max]> leftData = UnicodeData(left);
        stack rawptr<i32[min max]> rightData = UnicodeData(right);
        if ((leftData == null && leftLength != 0) || (rightData == null && rightLength != 0))
        {
            return System.Collections.Ordering.Equal;
        }

        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            stack u64[0 max] leftUnit = UnsignedCodePoint(*(&leftData[index]));
            stack u64[0 max] rightUnit = UnsignedCodePoint(*(&rightData[index]));
            if (leftUnit < rightUnit)
            {
                return System.Collections.Ordering.Less;
            }

            if (leftUnit > rightUnit)
            {
                return System.Collections.Ordering.Greater;
            }
        }

        if (leftLength < rightLength)
        {
            return System.Collections.Ordering.Less;
        }

        if (leftLength > rightLength)
        {
            return System.Collections.Ordering.Greater;
        }

        return System.Collections.Ordering.Equal;
    }
}

internal fn bool IsUtf8ContinuationByte(i8[min max] value)
{
    unsafe
    {
        stack i32[min max] unit = UnsignedByte(value);
        return 128 <= unit && unit <= 191;
    }
}

internal unsafe fn bool TryDecodeUtf8CodePoint(
    rawptr<i8[min max]>[length] data,
    u64[0 2 ** 63 - 1] length,
    rawmutptr<i64[min max]> index,
    rawmutptr<i32[min max]> codePoint)
{
    if (data == null || index == null || codePoint == null)
    {
        return false;
    }

    stack i64[min max] readIndex = *index;
    if (readIndex < 0 || readIndex >= length)
    {
        return false;
    }

    stack i32[min max] first = UnsignedByte(*(&data[readIndex]));
    if (first <= 127)
    {
        *index = readIndex + 1;
        *codePoint = first;
        return true;
    }

    if (194 <= first && first <= 223)
    {
        if (readIndex + 1 >= length)
        {
            return false;
        }

        stack i8[min max] secondRaw = *(&data[readIndex + 1]);
        if (!IsUtf8ContinuationByte(secondRaw))
        {
            return false;
        }

        stack i32[min max] second = UnsignedByte(secondRaw);
        *index = readIndex + 2;
        *codePoint = ((first & 31) << 6) | (second & 63);
        return true;
    }

    if (224 <= first && first <= 239)
    {
        if (readIndex + 2 >= length)
        {
            return false;
        }

        stack i8[min max] secondRaw = *(&data[readIndex + 1]);
        stack i8[min max] thirdRaw = *(&data[readIndex + 2]);
        if (!IsUtf8ContinuationByte(secondRaw) || !IsUtf8ContinuationByte(thirdRaw))
        {
            return false;
        }

        stack i32[min max] second = UnsignedByte(secondRaw);
        stack i32[min max] third = UnsignedByte(thirdRaw);
        if (first == 224 && second < 160)
        {
            return false;
        }

        if (first == 237 && second >= 160)
        {
            return false;
        }

        *index = readIndex + 3;
        *codePoint = ((first & 15) << 12)
            | ((second & 63) << 6)
            | (third & 63);
        return true;
    }

    if (240 <= first && first <= 244)
    {
        if (readIndex + 3 >= length)
        {
            return false;
        }

        stack i8[min max] secondRaw = *(&data[readIndex + 1]);
        stack i8[min max] thirdRaw = *(&data[readIndex + 2]);
        stack i8[min max] fourthRaw = *(&data[readIndex + 3]);
        if (!IsUtf8ContinuationByte(secondRaw)
            || !IsUtf8ContinuationByte(thirdRaw)
            || !IsUtf8ContinuationByte(fourthRaw))
            {
            return false;
        }

        stack i32[min max] second = UnsignedByte(secondRaw);
        stack i32[min max] third = UnsignedByte(thirdRaw);
        stack i32[min max] fourth = UnsignedByte(fourthRaw);
        if (first == 240 && second < 144)
        {
            return false;
        }

        if (first == 244 && second > 143)
        {
            return false;
        }

        *index = readIndex + 4;
        *codePoint = ((first & 7) << 18)
            | ((second & 63) << 12)
            | ((third & 63) << 6)
            | (fourth & 63);
        return true;
    }

    return false;
}

internal finite law u8[1 20] DecimalLengthI64(i64[min max] value)
{
    if (value == -(2 ** 63))
    {
        return 20;
    }

    stack mut i64[min max] remaining = value;
    stack mut u8[1 20] length = 1;
    if (remaining < 0)
    {
        length += 1;
        remaining = 0 - remaining;
    }

    while willexit (remaining >= 10)
    {
        remaining = remaining / 10;
        length += 1;
    }

    return length;
}

internal finite law u8[1 20] DecimalLengthU64(u64[0 max] value)
{
    stack mut u64[0 max] remaining = value;
    stack mut u8[1 20] length = 1;
    while willexit (remaining >= (u64[0 max])10)
    {
        remaining = remaining / (u64[0 max])10;
        length += 1;
    }

    return length;
}

