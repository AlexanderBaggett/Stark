public fn System.Memory.MemoryResult<i64[0 max]> ReadBytes(
    mut borrow System.Experimental.Runtime.Buffer.DynamicByteBuffer destination,
    i64[0 max] maxCount) {
    stack mut i64[0 max] readCount = 0;
    while willexit (readCount < maxCount) {
        stack mut i8[min max] value = 0;
        if (!TryReadInputByte(value)) {
            break;
        }

        stack System.Memory.MemoryStatus status = destination.WriteByte(value);
        switch (status) {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryResult<i64[0 max]>.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        readCount += 1;
    }

    return System.Memory.MemoryResult<i64[0 max]>.Ok(readCount);
}

public fn System.Memory.MemoryResult<i64[0 max]> ReadBytes(
    mut borrow System.Experimental.Runtime.Buffer.FixedByteBuffer512 destination,
    i64[0 max] maxCount) {
    stack mut i64[0 max] readCount = 0;
    while willexit (readCount < maxCount && destination.Writable() > 0) {
        stack mut i8[min max] value = 0;
        if (!TryReadInputByte(value)) {
            break;
        }

        stack System.Memory.MemoryStatus status = destination.WriteByte(value);
        switch (status) {
