        }

        if (self.Values.Length >= self.Values.Capacity || self.Links.Length >= self.Links.Capacity) {
            stack System.Memory.MemoryStatus reserveStatus = self.ReserveNodes(1);
            switch (reserveStatus) {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        index = self.Values.Length;
        init self.Values[index] = LinkedListValueSlot<T>.Occupied(value);
        init self.Links[self.Links.Length] = new LinkedListLinks() {
            Next = next,
            Previous = previous
        };

        return System.Memory.MemoryStatus.Ok;
    }

    internal fn bool SetNext(mut borrow LinkedList<T> self, i64[0 max] index, i64[0 max] next) {
        self.Links[index].Next = next;
        return true;
    }

    internal fn bool SetPrevious(mut borrow LinkedList<T> self, i64[0 max] index, i64[0 max] previous) {
        self.Links[index].Previous = previous;
        return true;
    }

    internal fn bool RemoveNode(mut borrow LinkedList<T> self, i64[0 max] index, out T value, out i64[0 max] next) {
        next = self.Links[index].Next;
        unsafe {
            stack LinkedListValueSlot<T> slot = self.Values[index];
            switch (slot) {
                case LinkedListValueSlot<T>.Occupied(var payload):
                    value = payload;
                    self.Values[index] = LinkedListValueSlot<T>.Free;
                    self.Links[index] = new LinkedListLinks() {
                        Next = self.FreeHead,
                        Previous = LinkedListNoneIndex()
                    };
                    self.FreeHead = index;
                    return true;
                case LinkedListValueSlot<T>.Free:
                    return false;
            }
        }
    }

    internal fn bool RemoveNodeFromTail(mut borrow LinkedList<T> self, i64[0 max] index, out T value, out i64[0 max] previous) {
        previous = self.Links[index].Previous;
        unsafe {
            stack LinkedListValueSlot<T> slot = self.Values[index];
            switch (slot) {
                case LinkedListValueSlot<T>.Occupied(var payload):
                    value = payload;
                    self.Values[index] = LinkedListValueSlot<T>.Free;
                    self.Links[index] = new LinkedListLinks() {
                        Next = self.FreeHead,
                        Previous = LinkedListNoneIndex()
                    };
                    self.FreeHead = index;
                    return true;
                case LinkedListValueSlot<T>.Free:
                    return false;
            }
        }
    }
}
