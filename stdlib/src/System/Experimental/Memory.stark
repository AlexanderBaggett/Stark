    stack i8[-128 127][] snapshotView = snapshot[0, snapshot.Length];
    if (!storage.TryReserve(count)) {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
    }

    for willexit (stack mut i64[0 max] copyIndex = 0; copyIndex < count; copyIndex += 1) {
        init storage[storage.Length] = snapshotView[copyIndex];
