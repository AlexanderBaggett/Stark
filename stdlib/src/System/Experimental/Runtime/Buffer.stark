internal finite law i64[0 max] MaxDynamicByteLength() {
    return (i64[0 max])((2**63) - 1);
}

internal finite law i64[0 max] ZeroIndex() {
    return 0;
}

internal finite law i64[0 max] Capacity512() {
    return 512;
}

internal finite law i64[0 max] Capacity4096() {
    return 4096;
}

internal finite law i64[0 max] Capacity8192() {
    return 8192;
}

internal finite law System.Memory.MemoryStatus TooLargeStatus() {
    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
}

internal finite law System.Memory.MemoryStatus OutOfMemoryStatus() {
    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
}

internal finite law i64[0 max] CursorReadable(i64[0 max] readPosition, i64[0 max] writePosition) {
    if (writePosition <= readPosition) {
        return 0;
    }

    return writePosition - readPosition;
}

internal finite law i64[0 max] CursorWritable(i64[0 max] writePosition, i64[0 max] capacity) {
    if (writePosition >= capacity) {
        return 0;
    }

    return capacity - writePosition;
}

internal fn System.Memory.MemoryStatus WriteByteToStorage(
    borrow mut i8[-128 127][] storage,
    i64[0 max] writePosition,
    i64[0 max] capacity,
    i8[-128 127] value,
    out i64[0 max] nextWritePosition) {
    nextWritePosition = writePosition;
    if (writePosition >= capacity) {
        return TooLargeStatus();
    }

    storage[writePosition] = value;
    nextWritePosition = (i64[0 max])(writePosition + 1);
    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus WriteSliceToStorage(
    borrow mut i8[-128 127][] storage,
    i64[0 max] writePosition,
    i64[0 max] capacity,
    borrow i8[-128 127][] source,
    i64[0 max] count,
    out i64[0 max] nextWritePosition) {
    nextWritePosition = writePosition;
    if (count == 0) {
        return System.Memory.MemoryStatus.Ok;
    }

    if (count > CursorWritable(writePosition, capacity)) {
        return TooLargeStatus();
    }

    stack i64[0 max] offset = writePosition;
    if disjoint(source, storage) {
        for willexit (stack mut i64[0 max] index = 0; index < count; index += 1) {
            storage[offset + index] = source[index];
        }

        nextWritePosition = (i64[0 max])(writePosition + count);
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut dynamic i8[-128 127] snapshot = new();
    if (!snapshot.TryReserve(count)) {
        return OutOfMemoryStatus();
    }

    for willexit (stack mut i64[0 max] snapshotIndex = 0; snapshotIndex < count; snapshotIndex += 1) {
        init snapshot[snapshot.Length] = source[snapshotIndex];
    }

    stack i8[-128 127][] snapshotView = snapshot[0, snapshot.Length];
    for willexit (stack mut i64[0 max] copyIndex = 0; copyIndex < count; copyIndex += 1) {
        storage[offset + copyIndex] = snapshotView[copyIndex];
    }

    nextWritePosition = (i64[0 max])(writePosition + count);
    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus WriteFillToStorage(
    borrow mut i8[-128 127][] storage,
    i64[0 max] writePosition,
    i64[0 max] capacity,
    i8[-128 127] value,
    i64[0 max] count,
    out i64[0 max] nextWritePosition) {
    nextWritePosition = writePosition;
    if (count == 0) {
        return System.Memory.MemoryStatus.Ok;
    }

    if (count > CursorWritable(writePosition, capacity)) {
        return TooLargeStatus();
    }

    stack i64[0 max] offset = writePosition;
    for willexit (stack mut i64[0 max] index = 0; index < count; index += 1) {
        storage[offset + index] = value;
    }

    nextWritePosition = (i64[0 max])(writePosition + count);
    return System.Memory.MemoryStatus.Ok;
}

internal fn void CompactStorage(
    borrow mut i8[-128 127][] storage,
    i64[0 max] readPosition,
    i64[0 max] writePosition,
    out i64[0 max] nextReadPosition,
    out i64[0 max] nextWritePosition) {
    nextReadPosition = readPosition;
    nextWritePosition = writePosition;
    stack i64[0 max] readable = CursorReadable(readPosition, writePosition);
    if (readPosition == 0) {
        return;
    }

    if (readable == 0) {
        nextReadPosition = 0;
        nextWritePosition = 0;
        return;
    }

    stack i64[0 max] sourceOffset = readPosition;
    for willexit (stack mut i64[0 max] index = 0; index < readable; index += 1) {
        storage[index] = storage[sourceOffset + index];
    }

    nextReadPosition = 0;
    nextWritePosition = readable;
}

internal fn System.Memory.MemoryStatus EnsureFixedStorage(
    mut borrow dynamic i8[-128 127] storage,
    i64[0 max] capacity) {
    if (storage.Length == capacity) {
        return System.Memory.MemoryStatus.Ok;
    }

    if (storage.Length > capacity) {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
    }

    stack i64[0 max] additional = capacity - storage.Length;
    if (!storage.TryReserve(additional)) {
        return OutOfMemoryStatus();
    }

    while willexit (storage.Length < capacity) {
        init storage[storage.Length] = 0;
    }

    return System.Memory.MemoryStatus.Ok;
}

