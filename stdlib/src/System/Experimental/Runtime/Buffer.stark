public struct DynamicByteBuffer {
    internal dynamic i8[-128 127] Storage;
    internal i64[0 max] ReadPosition;

    DynamicByteBuffer() {
        self.Storage = new();
        self.ReadPosition = 0;
    }

    finite law i64[0 max] Length(borrow DynamicByteBuffer self) {
        return self.Storage.Length;
    }

    finite law i64[0 max] Capacity(borrow DynamicByteBuffer self) {
        return self.Storage.Capacity;
    }

    finite law i64[0 max] Readable(borrow DynamicByteBuffer self) {
        return CursorReadable(self.ReadPosition, self.Storage.Length);
    }

    finite law i64[0 max] Writable(borrow DynamicByteBuffer self) {
        return MaxDynamicByteLength() - self.Storage.Length;
    }

    finite law bool IsEmpty(borrow DynamicByteBuffer self) {
        return self.Readable() == 0;
    }

    finite law retborrow i8[-128 127][] ReadSlice(borrow DynamicByteBuffer self) {
        return self.Storage[self.ReadPosition, self.Readable()];
    }

    finite retborrow mut i8[-128 127][] ReadMutableSlice(mut borrow DynamicByteBuffer self) {
        return self.Storage[self.ReadPosition, self.Readable()];
    }

    fn System.Memory.MemoryStatus Reserve(mut borrow DynamicByteBuffer self, i64[0 max] additional) {
        if (additional > self.Writable()) {
            return TooLargeStatus();
        }

        if (!self.Storage.TryReserve(additional)) {
            return OutOfMemoryStatus();
        }

        return System.Memory.MemoryStatus.Ok;
    }

    fn System.Memory.MemoryStatus WriteByte(mut borrow DynamicByteBuffer self, i8[-128 127] value) {
        stack System.Memory.MemoryStatus status = self.Reserve(1);
        switch (status) {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
                init self.Storage[self.Storage.Length] = value;
        }

        return System.Memory.MemoryStatus.Ok;
    }

    fn System.Memory.MemoryStatus WriteSlice(
        mut borrow DynamicByteBuffer self,
        borrow i8[-128 127][] source,
        i64[0 max] count) {
        if (count == 0) {
            return System.Memory.MemoryStatus.Ok;
        }

        stack i8[-128 127][] initialized = self.Storage[0, self.Storage.Length];
        if disjoint(source, initialized) {
            if (count > self.Writable()) {
                return TooLargeStatus();
            }

            if (!self.Storage.TryReserve(count)) {
                return OutOfMemoryStatus();
            }

            stack init i8[-128 127][] tail = init self.Storage[self.Storage.Length, count];
            unsafe {
                return System.Experimental.Memory.InitializeBytesDisjoint(source, tail, count);
            }
        }

        stack mut dynamic i8[-128 127] snapshot = new();
        if (!snapshot.TryReserve(count)) {
            return OutOfMemoryStatus();
        }

        stack init i8[-128 127][] snapshotTail = init snapshot[snapshot.Length, count];
        unsafe {
            System.Experimental.Memory.InitializeBytesDisjoint(source, snapshotTail, count);
        }

        stack i8[-128 127][] snapshotView = snapshot[0, snapshot.Length];
        if (count > self.Writable()) {
            return TooLargeStatus();
        }

        if (!self.Storage.TryReserve(count)) {
            return OutOfMemoryStatus();
        }

        stack init i8[-128 127][] tail = init self.Storage[self.Storage.Length, count];
        unsafe {
            return System.Experimental.Memory.InitializeBytesDisjoint(snapshotView, tail, count);
        }
    }

    fn System.Memory.MemoryStatus WriteFill(
        mut borrow DynamicByteBuffer self,
        i8[-128 127] value,
        i64[0 max] count) {
        if (count == 0) {
            return System.Memory.MemoryStatus.Ok;
        }

        if (count > self.Writable()) {
            return TooLargeStatus();
        }

        if (!self.Storage.TryReserve(count)) {
            return OutOfMemoryStatus();
        }

        stack init i8[-128 127][] tail = init self.Storage[self.Storage.Length, count];
        return System.Experimental.Memory.FillBytes(tail, value, count);
    }

    fn bool TryReadByte(mut borrow DynamicByteBuffer self, out i8[-128 127] value) {
        if (self.IsEmpty()) {
            value = 0;
            return false;
        }

        value = self.Storage[0, self.Storage.Length][self.ReadPosition];
        self.AdvanceRead(1);
        return true;
    }

    fn void AdvanceRead(mut borrow DynamicByteBuffer self, i64[0 max] count) {
        stack i64[0 max] readable = self.Readable();
        if (count >= readable) {
            self.Clear();
            return;
        }

        self.ReadPosition += count;
    }

    fn void Compact(mut borrow DynamicByteBuffer self) {
        stack i64[0 max] readable = self.Readable();
        if (self.ReadPosition == 0) {
            return;
        }

        if (readable == 0) {
            self.Clear();
            return;
        }

        stack mut i64[0 max] nextReadPosition = self.ReadPosition;
        stack mut i64[0 max] nextWritePosition = self.Storage.Length;
        CompactStorage(
            self.Storage[0, self.Storage.Length],
            self.ReadPosition,
            self.Storage.Length,
            nextReadPosition,
            nextWritePosition);

        while willexit (self.Storage.Length > readable) {
            stack i8[-128 127] discarded = self.Storage.MoveLast();
        }

        self.ReadPosition = nextReadPosition;
    }

    fn void Clear(mut borrow DynamicByteBuffer self) {
        while willexit (self.Storage.Length > 0) {
            stack i8[-128 127] discarded = self.Storage.MoveLast();
        }

        self.ReadPosition = 0;
    }
}
