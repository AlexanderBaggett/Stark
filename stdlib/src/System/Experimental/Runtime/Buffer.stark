        }

        for willexit (stack mut i64[0 max] index = 0; index < count; index += 1) {
            init self.Storage[self.Storage.Length] = value;
        }

        return System.Memory.MemoryStatus.Ok;
    }

    fn bool TryReadByte(mut borrow DynamicByteBuffer self, out i8[-128 127] value) {
        if (self.IsEmpty()) {
            value = 0;
            return false;
        }

        value = self.Storage[0, self.Storage.Length][self.ReadPosition];
        self.AdvanceRead(1);
        return true;
    }

    fn void AdvanceRead(mut borrow DynamicByteBuffer self, i64[0 max] count) {
        stack i64[0 max] readable = self.Readable();
        if (count >= readable) {
            self.Clear();
            return;
        }

        self.ReadPosition += count;
    }

    fn void Compact(mut borrow DynamicByteBuffer self) {
        stack i64[0 max] readable = self.Readable();
        if (self.ReadPosition == 0) {
            return;
        }

        if (readable == 0) {
            self.Clear();
            return;
        }

        stack mut i64[0 max] nextReadPosition = self.ReadPosition;
        stack mut i64[0 max] nextWritePosition = self.Storage.Length;
        CompactStorage(
            self.Storage[0, self.Storage.Length],
            self.ReadPosition,
            self.Storage.Length,
            nextReadPosition,
            nextWritePosition);

        while willexit (self.Storage.Length > readable) {
            stack i8[-128 127] discarded = self.Storage.MoveLast();
        }

        self.ReadPosition = nextReadPosition;
    }

    fn void Clear(mut borrow DynamicByteBuffer self) {
        while willexit (self.Storage.Length > 0) {
            stack i8[-128 127] discarded = self.Storage.MoveLast();
        }

        self.ReadPosition = 0;
    }
}
