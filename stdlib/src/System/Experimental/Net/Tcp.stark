import System.Experimental.Runtime.Buffer
import System.Memory
import System.Net
import System.Runtime
import System.Runtime.Platform
module System.Experimental.Net.Tcp

public enum TcpShutdown {
    Receive,
    Send,
    Both,
}

public struct TcpClient {
    internal rawptr<i8[min max]> Handle;
    internal bool Closed;

    TcpClient() {
        self.Handle = null;
        self.Closed = true;
    }

    static fn System.Net.NetResult<TcpClient> Connect(System.Net.IPv4Endpoint endpoint) {
        stack mut i32[min max] status = 0;
        stack rawptr<i8[min max]> handle = System.Runtime.Platform.ConnectTcpIPv4(
            endpoint.Address.A,
            endpoint.Address.B,
            endpoint.Address.C,
            endpoint.Address.D,
            endpoint.Port,
            &status);

        if (status < 0 || handle == null) {
            if (handle != null) {
                System.Runtime.Platform.CloseSocket(handle);
            }

            if (status == 0) {
                status = -1;
            }

            return System.Net.NetResult<TcpClient>.Err(NetworkErrorFromPlatformResult(status));
        }

        return System.Net.NetResult<TcpClient>.Ok(CreateTcpClient(handle));
    }

    finite law bool IsOpen(borrow TcpClient self) {
        return self.Handle != null && !self.Closed;
    }

    fn System.Net.NetResult<i64[0 max]> Read(mut borrow TcpClient self, mut borrow i8[min max][] destination) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.NotConnected);
        }

        stack System.Runtime.MutableByteSliceParts destinationParts = System.Runtime.GetMutableByteSliceParts(destination);
        if (destinationParts.Length == 0) {
            return System.Net.NetResult<i64[0 max]>.Ok(0);
        }

        if (destinationParts.Data == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.AddressInvalid);
        }

        stack mut i64[min max] result = 0;
        unsafe {
            result = System.Runtime.Platform.ReadSocket(self.Handle, destinationParts.Data, destinationParts.Length);
        }

        return ByteCountFromPlatformResult(result);
    }

    fn System.Net.NetResult<i64[0 max]> Read(
        mut borrow TcpClient self,
        mut borrow System.Experimental.Runtime.Buffer.FixedByteBuffer512 destination) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.NotConnected);
        }

        stack i64[0 max] capacity = destination.Writable();
        if (capacity == 0) {
            return System.Net.NetResult<i64[0 max]>.Ok(0);
        }

        stack mut i8[-128 127][] tail = destination.WriteSlice();
        stack System.Runtime.MutableByteSliceParts tailParts = System.Runtime.GetMutableByteSliceParts(tail);
        if (tailParts.Data == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.AddressInvalid);
        }

        stack mut i64[min max] result = 0;
        unsafe {
            result = System.Runtime.Platform.ReadSocket(self.Handle, tailParts.Data, tailParts.Length);
        }
        if (result < 0) {
            return System.Net.NetResult<i64[0 max]>.Err(NetworkErrorFromPlatformResult((i32[min max])result));
        }

        stack i64[0 max] count = (i64[0 max])result;
        destination.AdvanceWrite(count);
        return System.Net.NetResult<i64[0 max]>.Ok(count);
    }

    fn System.Net.NetResult<i64[0 max]> Read(
        mut borrow TcpClient self,
        mut borrow System.Experimental.Runtime.Buffer.FixedByteBuffer4096 destination) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.NotConnected);
        }

        stack i64[0 max] capacity = destination.Writable();
        if (capacity == 0) {
            return System.Net.NetResult<i64[0 max]>.Ok(0);
        }

        stack mut i8[-128 127][] tail = destination.WriteSlice();
        stack System.Runtime.MutableByteSliceParts tailParts = System.Runtime.GetMutableByteSliceParts(tail);
        if (tailParts.Data == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.AddressInvalid);
        }

        stack mut i64[min max] result = 0;
        unsafe {
            result = System.Runtime.Platform.ReadSocket(self.Handle, tailParts.Data, tailParts.Length);
        }
        if (result < 0) {
            return System.Net.NetResult<i64[0 max]>.Err(NetworkErrorFromPlatformResult((i32[min max])result));
        }

        stack i64[0 max] count = (i64[0 max])result;
        destination.AdvanceWrite(count);
        return System.Net.NetResult<i64[0 max]>.Ok(count);
    }

    fn System.Net.NetResult<i64[0 max]> Read(
        mut borrow TcpClient self,
        mut borrow System.Experimental.Runtime.Buffer.FixedByteBuffer8192 destination) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.NotConnected);
        }

        stack i64[0 max] capacity = destination.Writable();
        if (capacity == 0) {
            return System.Net.NetResult<i64[0 max]>.Ok(0);
        }

        stack mut i8[-128 127][] tail = destination.WriteSlice();
        stack System.Runtime.MutableByteSliceParts tailParts = System.Runtime.GetMutableByteSliceParts(tail);
        if (tailParts.Data == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.AddressInvalid);
        }

        stack mut i64[min max] result = 0;
        unsafe {
            result = System.Runtime.Platform.ReadSocket(self.Handle, tailParts.Data, tailParts.Length);
        }
        if (result < 0) {
            return System.Net.NetResult<i64[0 max]>.Err(NetworkErrorFromPlatformResult((i32[min max])result));
        }

        stack i64[0 max] count = (i64[0 max])result;
        destination.AdvanceWrite(count);
        return System.Net.NetResult<i64[0 max]>.Ok(count);
    }

    fn System.Net.NetResult<i64[0 max]> Read(
        mut borrow TcpClient self,
        mut borrow System.Experimental.Runtime.Buffer.DynamicByteBuffer destination,
        i64[0 max] maxCount) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.NotConnected);
        }

        stack mut i64[0 max] capacity = maxCount;
        if (capacity > 8192) {
            capacity = 8192;
        }

        if (capacity == 0) {
            return System.Net.NetResult<i64[0 max]>.Ok(0);
        }

        stack mut i8[-128 127][8192] scratch;
        stack mut i64[min max] result = 0;
        unsafe {
            result = System.Runtime.Platform.ReadSocket(self.Handle, &scratch[0], capacity);
        }
        if (result < 0) {
            return System.Net.NetResult<i64[0 max]>.Err(NetworkErrorFromPlatformResult((i32[min max])result));
        }

        stack i64[0 max] count = (i64[0 max])result;
        if (count == 0) {
            return System.Net.NetResult<i64[0 max]>.Ok(0);
        }

        stack rawptr<i8[-128 127]> scratchData = &scratch[0];
        unsafe {
            stack i8[-128 127][] readBytes = slice(scratchData, count);
            stack System.Memory.MemoryStatus appendStatus = destination.WriteSlice(readBytes, count);
            switch (appendStatus) {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.Unknown(-1));
                case System.Memory.MemoryStatus.Ok:
            }
        }

        return System.Net.NetResult<i64[0 max]>.Ok(count);
    }

    fn System.Net.NetResult<i64[0 max]> Write(mut borrow TcpClient self, borrow i8[min max][] source) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.NotConnected);
        }

        stack System.Runtime.ByteSliceParts sourceParts = System.Runtime.GetByteSliceParts(source);
        if (sourceParts.Length == 0) {
            return System.Net.NetResult<i64[0 max]>.Ok(0);
        }

        if (sourceParts.Data == null) {
            return System.Net.NetResult<i64[0 max]>.Err(System.Net.NetworkError.AddressInvalid);
        }

        stack mut i64[min max] result = 0;
        unsafe {
            result = System.Runtime.Platform.WriteSocket(self.Handle, sourceParts.Data, sourceParts.Length);
        }

        return ByteCountFromPlatformResult(result);
    }

    fn System.Net.NetResult<i64[0 max]> Write(
        mut borrow TcpClient self,
        borrow System.Experimental.Runtime.Buffer.DynamicByteBuffer source) {
        return self.Write(source.ReadSlice());
    }

    fn System.Net.NetResult<i64[0 max]> Write(
        mut borrow TcpClient self,
        borrow System.Experimental.Runtime.Buffer.FixedByteBuffer512 source) {
        return self.Write(source.ReadSlice());
    }

    fn System.Net.NetResult<i64[0 max]> Write(
        mut borrow TcpClient self,
        borrow System.Experimental.Runtime.Buffer.FixedByteBuffer4096 source) {
        return self.Write(source.ReadSlice());
    }

    fn System.Net.NetResult<i64[0 max]> Write(
        mut borrow TcpClient self,
        borrow System.Experimental.Runtime.Buffer.FixedByteBuffer8192 source) {
        return self.Write(source.ReadSlice());
    }

    fn System.Net.NetStatus WaitReadable(mut borrow TcpClient self, i32[min max] timeoutMilliseconds) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetStatus.Err(System.Net.NetworkError.NotConnected);
        }

        return StatusFromPlatformResult(System.Runtime.Platform.WaitReadable(self.Handle, timeoutMilliseconds));
    }

    fn System.Net.NetStatus WaitWritable(mut borrow TcpClient self, i32[min max] timeoutMilliseconds) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetStatus.Err(System.Net.NetworkError.NotConnected);
        }

        return StatusFromPlatformResult(System.Runtime.Platform.WaitWritable(self.Handle, timeoutMilliseconds));
    }

    fn System.Net.NetStatus Shutdown(mut borrow TcpClient self, TcpShutdown how) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetStatus.Err(System.Net.NetworkError.NotConnected);
        }

        return StatusFromPlatformResult(System.Runtime.Platform.ShutdownSocket(self.Handle, ShutdownMode(how)));
    }

    fn System.Net.NetStatus Close(mut borrow TcpClient self) {
        if (self.Closed || self.Handle == null) {
            self.Handle = null;
            self.Closed = true;
            return System.Net.NetStatus.Ok;
        }

        stack rawptr<i8[min max]> handle = self.Handle;
        self.Handle = null;
        self.Closed = true;
        return StatusFromPlatformResult(System.Runtime.Platform.CloseSocket(handle));
    }

    mut drop {
        self.Close();
    }
}

public struct TcpListener {
    internal rawptr<i8[min max]> Handle;
    internal bool Closed;

    TcpListener() {
        self.Handle = null;
        self.Closed = true;
    }

    static fn System.Net.NetResult<TcpListener> Listen(System.Net.IPv4Endpoint endpoint) {
        stack mut i32[min max] status = 0;
        stack rawptr<i8[min max]> handle = System.Runtime.Platform.ListenTcpIPv4(
            endpoint.Address.A,
            endpoint.Address.B,
            endpoint.Address.C,
            endpoint.Address.D,
            endpoint.Port,
            &status);

        if (status < 0 || handle == null) {
            if (handle != null) {
                System.Runtime.Platform.CloseSocket(handle);
            }

            if (status == 0) {
                status = -1;
            }

            return System.Net.NetResult<TcpListener>.Err(NetworkErrorFromPlatformResult(status));
        }

        return System.Net.NetResult<TcpListener>.Ok(CreateTcpListener(handle));
    }

    finite law bool IsOpen(borrow TcpListener self) {
        return self.Handle != null && !self.Closed;
    }

    fn System.Net.NetResult<TcpClient> Accept(mut borrow TcpListener self) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetResult<TcpClient>.Err(System.Net.NetworkError.NotConnected);
        }

        stack mut i32[min max] status = 0;
        stack rawptr<i8[min max]> handle = System.Runtime.Platform.AcceptSocket(self.Handle, &status);

        if (status < 0 || handle == null) {
            if (handle != null) {
                System.Runtime.Platform.CloseSocket(handle);
            }

            if (status == 0) {
                status = -1;
            }

            return System.Net.NetResult<TcpClient>.Err(NetworkErrorFromPlatformResult(status));
        }

        return System.Net.NetResult<TcpClient>.Ok(CreateTcpClient(handle));
    }

    fn System.Net.NetStatus WaitReadable(mut borrow TcpListener self, i32[min max] timeoutMilliseconds) {
        if (self.Closed || self.Handle == null) {
            return System.Net.NetStatus.Err(System.Net.NetworkError.NotConnected);
        }

        return StatusFromPlatformResult(System.Runtime.Platform.WaitReadable(self.Handle, timeoutMilliseconds));
    }

    fn System.Net.NetStatus Close(mut borrow TcpListener self) {
        if (self.Closed || self.Handle == null) {
            self.Handle = null;
            self.Closed = true;
            return System.Net.NetStatus.Ok;
        }

        stack rawptr<i8[min max]> handle = self.Handle;
        self.Handle = null;
        self.Closed = true;
        return StatusFromPlatformResult(System.Runtime.Platform.CloseSocket(handle));
    }

    mut drop {
        self.Close();
    }
}

fn TcpClient CreateTcpClient(rawptr<i8[min max]> handle) {
    return new TcpClient() {
        Handle = handle,
        Closed = handle == null
    };
}

fn TcpListener CreateTcpListener(rawptr<i8[min max]> handle) {
    return new TcpListener() {
        Handle = handle,
        Closed = handle == null
    };
}

fn i32[min max] ShutdownMode(TcpShutdown how) {
    switch (how) {
        case TcpShutdown.Receive:
            return 0;
        case TcpShutdown.Send:
            return 1;
        case TcpShutdown.Both:
            return 2;
    }
}

fn System.Net.NetworkError NetworkErrorFromPlatformResult(i32[min max] result) {
    if (result == -98 || result == -10048) {
        return System.Net.NetworkError.AddressInUse;
    }

    if (result == -111 || result == -10061) {
        return System.Net.NetworkError.ConnectionRefused;
    }

    if (result == -104 || result == -10054) {
        return System.Net.NetworkError.ConnectionReset;
    }

    if (result == -110 || result == -10060) {
        return System.Net.NetworkError.TimedOut;
    }

    if (result == -107 || result == -10057) {
        return System.Net.NetworkError.NotConnected;
    }

    if (result == -11 || result == -10035) {
        return System.Net.NetworkError.WouldBlock;
    }

    if (result == -97 || result == -99 || result == -10014 || result == -10047 || result == -10049) {
        return System.Net.NetworkError.AddressInvalid;
    }

    if (result == -95 || result == -10045) {
        return System.Net.NetworkError.Unsupported;
    }

    return System.Net.NetworkError.Unknown(result);
}

fn System.Net.NetStatus StatusFromPlatformResult(i32[min max] result) {
    if (result < 0) {
        return System.Net.NetStatus.Err(NetworkErrorFromPlatformResult(result));
    }

    return System.Net.NetStatus.Ok;
}

fn System.Net.NetResult<i64[0 max]> ByteCountFromPlatformResult(i64[min max] result) {
    if (result < 0) {
        return System.Net.NetResult<i64[0 max]>.Err(NetworkErrorFromPlatformResult((i32[min max])result));
    }

    return System.Net.NetResult<i64[0 max]>.Ok((i64[0 max])result);
}
