// 192-1024-bit atomics: no CPU supports lock-free atomics above 128 bits, so these
// types serialize through a spinlock word embedded in the struct itself (visible in
// the layout: sizeof includes the lock word). The API is identical to every other
// atomic width; only the documented cost differs. Never a hidden global lock table.


public struct AtomicI192
{
    internal i192[min max] Value;
    internal u32[0 max] Lock;

    AtomicI192(i192[min max] initial)
    {
        self.Value = initial;
        self.Lock = 0;
    }

    fn i192[min max] Load(borrow AtomicI192 self);
    fn void Store(mut borrow AtomicI192 self, i192[min max] value);
    fn i192[min max] Add(mut borrow AtomicI192 self, i192[min max] operand);
    fn i192[min max] Sub(mut borrow AtomicI192 self, i192[min max] operand);
    fn i192[min max] And(mut borrow AtomicI192 self, i192[min max] operand);
    fn i192[min max] Or(mut borrow AtomicI192 self, i192[min max] operand);
    fn i192[min max] Xor(mut borrow AtomicI192 self, i192[min max] operand);
    fn i192[min max] Exchange(mut borrow AtomicI192 self, i192[min max] value);
    fn bool CompareExchange(mut borrow AtomicI192 self, i192[min max] expected, i192[min max] desired);
}

