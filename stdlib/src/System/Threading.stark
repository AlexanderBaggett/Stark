    fn void Store(mut borrow AtomicI48 self, i48[min max] value);
    fn i48[min max] Add(mut borrow AtomicI48 self, i48[min max] operand);
    fn i48[min max] Sub(mut borrow AtomicI48 self, i48[min max] operand);
    fn i48[min max] And(mut borrow AtomicI48 self, i48[min max] operand);
    fn i48[min max] Or(mut borrow AtomicI48 self, i48[min max] operand);
    fn i48[min max] Xor(mut borrow AtomicI48 self, i48[min max] operand);
