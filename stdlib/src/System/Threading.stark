}

public struct AtomicI96
{
    internal i128[min max] Value;

    AtomicI96(i96[min max] initial)
    {
        self.Value = initial;
    }

    fn i96[min max] Load(borrow AtomicI96 self);
    fn void Store(mut borrow AtomicI96 self, i96[min max] value);
    fn i96[min max] Add(mut borrow AtomicI96 self, i96[min max] operand);
