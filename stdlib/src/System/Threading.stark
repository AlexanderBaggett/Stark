public struct AtomicBool
{
    // Stored as a byte (always exactly 0 or 1) so hardware atomic instructions can
    // operate on it directly.
    internal u8[0 max] Value;

    AtomicBool(bool initial)
    {
        if (initial)
        {
            self.Value = 1;
        }
        else
        {
            self.Value = 0;
        }
    }

    fn bool Load(borrow AtomicBool self);
    fn void Store(mut borrow AtomicBool self, bool value);
    fn bool Exchange(mut borrow AtomicBool self, bool value);
    fn bool CompareExchange(mut borrow AtomicBool self, bool expected, bool desired);
}

public struct Synchronized<T>
{
    internal AtomicBool Gate;

    [Grant(Shareable) where Transferable(T)]
    internal T Value;

    Synchronized(T initial)
    {
        self.Gate = new AtomicBool(false);
        self.Value = initial;
    }

    fn Locked<T> Lock(storeborrow mut Synchronized<T> self)
    {
        while willexit (!self.Gate.CompareExchange(false, true))
        {
            Thread.Yield();
        }

        return new Locked<T>(self);
    }
}

public struct Locked<T>
{
    internal storeborrow mut Synchronized<T> Owner;
    internal bool Held;

    Locked(storeborrow mut Synchronized<T> owner)
    {
        self.Owner = owner;
        self.Held = true;
    }

    fn retborrow mut T Value(mut borrow Locked<T> self)
    {
        return self.Owner.Value;
    }

    mut drop
    {
        if (self.Held)
        {
            self.Owner.Gate.Store(false);
            self.Held = false;
        }
    }
}

internal struct ChannelState<T>
{
    [Grant(Transferable) where Transferable(T)]
    System.Collections.Queue<T> Items;

    [Grant(Transferable)]
    [Grant(Shareable)]
    System.Collections.HashSet<u64[0 2 ** 63 - 1]> OpenSenders;

    u64[0 2 ** 63 - 1] SenderCount;
    u64[0 2 ** 63 - 1] NextSenderId;
    bool ReceiverTaken;
    bool ReceiverClosed;
}

public struct Channel<T>
{
    internal AtomicBool Gate;

    [Grant(Transferable) where Transferable(T)]
    [Grant(Shareable) where Transferable(T)]
    internal ChannelState<T> State;

    Channel()
    {
        self.Gate = new AtomicBool(false);
        self.State = new ChannelState<T>()
        {
            Items = new System.Collections.Queue<T>(),
            OpenSenders = new System.Collections.HashSet<u64[0 2 ** 63 - 1]>(),
            SenderCount = 0,
            NextSenderId = 0,
            ReceiverTaken = false,
            ReceiverClosed = false
        };
    }

    fn ChannelSenderResult<T> CreateSender(storeborrow mut Channel<T> self)
    {
        while willexit (!self.Gate.CompareExchange(false, true))
        {
            Thread.Yield();
        }

        if (self.State.ReceiverClosed)
        {
            self.Gate.Store(false);
            return ChannelSenderResult<T>.Err(ChannelError.Closed);
        }

        if (self.State.SenderCount == (u64[0 2 ** 63 - 1])(2 ** 63 - 1))
        {
            self.Gate.Store(false);
            return ChannelSenderResult<T>.Err(ChannelError.OutOfMemory);
        }

        if (self.State.NextSenderId == (u64[0 2 ** 63 - 1])(2 ** 63 - 1))
        {
            self.Gate.Store(false);
            return ChannelSenderResult<T>.Err(ChannelError.OutOfMemory);
        }

        stack u64[0 2 ** 63 - 1] senderId = self.State.NextSenderId;
        stack System.Memory.MemoryStatus status = self.State.OpenSenders.Add(senderId);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                self.Gate.Store(false);
                return ChannelSenderResult<T>.Err(ChannelError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        self.State.NextSenderId += 1;
        self.State.SenderCount += 1;
        self.Gate.Store(false);
        return ChannelSenderResult<T>.Ok(new Sender<T>(self, senderId));
    }

    fn ChannelReceiverResult<T> CreateReceiver(storeborrow mut Channel<T> self)
    {
        while willexit (!self.Gate.CompareExchange(false, true))
        {
            Thread.Yield();
        }

        if (self.State.ReceiverTaken)
        {
            self.Gate.Store(false);
            return ChannelReceiverResult<T>.Err(ChannelError.ReceiverAlreadyTaken);
        }

        self.State.ReceiverTaken = true;
        self.State.ReceiverClosed = false;
        self.Gate.Store(false);
        return ChannelReceiverResult<T>.Ok(new Receiver<T>(self));
    }

    fn u64[0 2 ** 63 - 1] PendingCount(storeborrow mut Channel<T> self)
    {
        while willexit (!self.Gate.CompareExchange(false, true))
        {
            Thread.Yield();
        }

        stack u64[0 2 ** 63 - 1] count = self.State.Items.Count();
        self.Gate.Store(false);
        return count;
    }
}

public struct Sender<T>
{
    [Grant(Transferable) where Shareable(Channel<T>)]
    [Grant(Shareable) where Shareable(Channel<T>)]
    internal storeborrow mut Channel<T> Owner;

    internal u64[0 2 ** 63 - 1] Id;
    internal bool Open;

    Sender(storeborrow mut Channel<T> owner, u64[0 2 ** 63 - 1] id)
    {
        self.Owner = owner;
        self.Id = id;
        self.Open = true;
    }

    fn ChannelStatus Send(mut borrow Sender<T> self, T value)
        where Transferable(T)
    {
        if (!self.Open)
        {
            return ChannelStatus.Err(ChannelError.Closed);
        }

        while willexit (!self.Owner.Gate.CompareExchange(false, true))
        {
            Thread.Yield();
        }

        if (self.Owner.State.ReceiverClosed)
        {
            self.Owner.Gate.Store(false);
            return ChannelStatus.Err(ChannelError.Closed);
        }

        if (!self.Owner.State.OpenSenders.Contains(self.Id))
        {
            self.Owner.Gate.Store(false);
            self.Open = false;
            return ChannelStatus.Err(ChannelError.Closed);
        }

        stack System.Memory.MemoryStatus status = self.Owner.State.Items.Enqueue(value);
        self.Owner.Gate.Store(false);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return ChannelStatus.Err(ChannelError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        return ChannelStatus.Ok;
    }

    fn ChannelStatus Close(mut borrow Sender<T> self)
    {
        if (!self.Open)
        {
            return ChannelStatus.Ok;
        }

        while willexit (!self.Owner.Gate.CompareExchange(false, true))
        {
            Thread.Yield();
        }

        if (self.Owner.State.OpenSenders.Remove(self.Id))
        {
            if (self.Owner.State.SenderCount > 0)
            {
                self.Owner.State.SenderCount -= 1;
            }
        }

        self.Owner.Gate.Store(false);
        self.Open = false;
        return ChannelStatus.Ok;
    }

    mut drop
    {
        self.Close();
    }
}

public struct Receiver<T>
{
    [Grant(Transferable) where Shareable(Channel<T>)]
    [Grant(Shareable) where Shareable(Channel<T>)]
    internal storeborrow mut Channel<T> Owner;

    internal bool Open;

    Receiver(storeborrow mut Channel<T> owner)
    {
        self.Owner = owner;
        self.Open = true;
    }

    fn ChannelReceiveResult<T> Receive(mut borrow Receiver<T> self)
    {
        if (!self.Open)
        {
            return ChannelReceiveResult<T>.Err(ChannelError.Closed);
        }

        while willexit (!self.Owner.Gate.CompareExchange(false, true))
        {
            Thread.Yield();
        }

        stack mut T value;
        if (self.Owner.State.Items.TryDequeue(value))
        {
            self.Owner.Gate.Store(false);
            return ChannelReceiveResult<T>.Item(value);
        }

        if (self.Owner.State.SenderCount == 0)
        {
            self.Owner.Gate.Store(false);
            return ChannelReceiveResult<T>.Err(ChannelError.Closed);
        }

        self.Owner.Gate.Store(false);
        return ChannelReceiveResult<T>.Err(ChannelError.Empty);
    }

    fn ChannelStatus Close(mut borrow Receiver<T> self)
    {
        if (!self.Open)
        {
            return ChannelStatus.Ok;
        }

        while willexit (!self.Owner.Gate.CompareExchange(false, true))
        {
            Thread.Yield();
        }

        self.Owner.State.ReceiverClosed = true;
        self.Owner.State.Items.Clear();
        self.Owner.State.OpenSenders.Clear();
        self.Owner.State.SenderCount = 0;
        self.Owner.Gate.Store(false);
        self.Open = false;
        return ChannelStatus.Ok;
    }

    mut drop
    {
        self.Close();
    }

}

// 24/48/96/128-bit atomics: the value lives sign/zero-extended inside a power-of-2
// storage container (i24 in 4 bytes, i48 in 8, i96/i128 in 16) so hardware
// compare-exchange can operate on it. Every operation except Add/Sub is still a
// single lock-free instruction; Add/Sub retry through a compare-exchange loop under
// contention. 128-bit atomics use cmpxchg16b-class instructions.

public struct AtomicI24
{
    internal i32[min max] Value;

    AtomicI24(i24[min max] initial)
    {
        self.Value = initial;
    }

    fn i24[min max] Load(borrow AtomicI24 self);
    fn void Store(mut borrow AtomicI24 self, i24[min max] value);
    fn i24[min max] Add(mut borrow AtomicI24 self, i24[min max] operand);
    fn i24[min max] Sub(mut borrow AtomicI24 self, i24[min max] operand);
    fn i24[min max] And(mut borrow AtomicI24 self, i24[min max] operand);
    fn i24[min max] Or(mut borrow AtomicI24 self, i24[min max] operand);
    fn i24[min max] Xor(mut borrow AtomicI24 self, i24[min max] operand);
    fn i24[min max] Exchange(mut borrow AtomicI24 self, i24[min max] value);
    fn bool CompareExchange(mut borrow AtomicI24 self, i24[min max] expected, i24[min max] desired);
}

