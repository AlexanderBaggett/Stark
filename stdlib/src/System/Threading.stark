import System.Runtime.Platform
module System.Threading

public alias ThreadEntry = fnptr<fn i32[min max]()>;

public enum ThreadError
{
    StartFailed,
    JoinFailed,
    AlreadyJoined,
    AlreadyDetached,
    InvalidState,
}

public enum ThreadStatus
{
    [Ok] Ok,
    [Err] Err(ThreadError),
}

public enum ThreadJoinResult
{
    [Ok] Ok(i32[min max]),
    [Err] Err(ThreadError),
}

public struct Thread
{
    internal rawmutptr<i8[min max]> Handle;
    internal bool Joined;
    internal bool Detached;
    internal bool StartFailed;

    Thread(ThreadEntry entry)
    {
        unsafe
        {
            self.Handle = System.Runtime.Platform.StartThread(entry);
        }

        self.Joined = false;
        self.Detached = false;
        self.StartFailed = self.Handle == null;
    }

    finite law bool IsJoinable(borrow Thread self)
    {
        return self.Handle != null && !self.Joined && !self.Detached && !self.StartFailed;
    }

    fn ThreadJoinResult Join(mut borrow Thread self)
    {
        unsafe
        {
            if (self.StartFailed)
            {
                return ThreadJoinResult.Err(ThreadError.StartFailed);
            }

            if (self.Joined)
            {
                return ThreadJoinResult.Err(ThreadError.AlreadyJoined);
            }

            if (self.Detached)
            {
                return ThreadJoinResult.Err(ThreadError.AlreadyDetached);
            }

            if (self.Handle == null)
            {
                return ThreadJoinResult.Err(ThreadError.InvalidState);
            }

            stack mut i32[min max] exitCode = 0;
            stack mut i32[min max] status = 0;
            unsafe
            {
                status = System.Runtime.Platform.JoinThread(self.Handle, &exitCode);
            }

            if (status != 0)
            {
                return ThreadJoinResult.Err(ThreadError.JoinFailed);
            }

            self.Handle = null;
            self.Joined = true;
            return ThreadJoinResult.Ok(exitCode);
        }
    }

    fn ThreadStatus Detach(mut borrow Thread self)
    {
        unsafe
        {
            if (self.StartFailed)
            {
                return ThreadStatus.Err(ThreadError.StartFailed);
            }

            if (self.Joined)
            {
                return ThreadStatus.Err(ThreadError.AlreadyJoined);
            }

            if (self.Detached)
            {
                return ThreadStatus.Err(ThreadError.AlreadyDetached);
            }

            if (self.Handle == null)
            {
                self.Detached = true;
                return ThreadStatus.Err(ThreadError.InvalidState);
            }

            stack mut i32[min max] status = 0;
            unsafe
            {
                status = System.Runtime.Platform.DetachThread(self.Handle);
            }

            if (status != 0)
            {
                return ThreadStatus.Err(ThreadError.InvalidState);
            }

            self.Detached = true;
            self.Handle = null;
            return ThreadStatus.Ok;
        }
    }

    static fn void Yield()
    {
        System.Runtime.Platform.YieldThread();
        return;
    }

    static fn void SleepMilliseconds(u64[0 2 ** 63 - 1] milliseconds)
    {
        System.Runtime.Platform.SleepThreadMilliseconds(milliseconds);
        return;
    }

    mut drop
    {
        if (self.IsJoinable())
        {
            self.Detach();
        }
    }
}

// Atomic types (docs/Self-host-Prep/12-atomics.md): the safe-sharing primitive for
// threads. One type per Stark integer width plus AtomicBool; every operation is a
// single indivisible seq-cst action. RMW operations return the PREVIOUS value;
// arithmetic wraps on overflow (two's complement, like the wrapping operators).
//
// The semicolon-bodied methods are compiler builtins: they lower directly onto LLVM
// atomic instructions (atomicrmw / cmpxchg / load atomic / store atomic). The 8/16/32/
// 64-bit types and AtomicBool are single hardware instructions on every supported
// target.

public struct AtomicI8
{
    internal i8[min max] Value;

    AtomicI8(i8[min max] initial)
    {
        self.Value = initial;
    }

    fn i8[min max] Load(borrow AtomicI8 self);
    fn void Store(mut borrow AtomicI8 self, i8[min max] value);
    fn i8[min max] Add(mut borrow AtomicI8 self, i8[min max] operand);
    fn i8[min max] Sub(mut borrow AtomicI8 self, i8[min max] operand);
    fn i8[min max] And(mut borrow AtomicI8 self, i8[min max] operand);
    fn i8[min max] Or(mut borrow AtomicI8 self, i8[min max] operand);
    fn i8[min max] Xor(mut borrow AtomicI8 self, i8[min max] operand);
    fn i8[min max] Exchange(mut borrow AtomicI8 self, i8[min max] value);
    fn bool CompareExchange(mut borrow AtomicI8 self, i8[min max] expected, i8[min max] desired);
}

