    fn i16[min max] And(mut borrow AtomicI16 self, i16[min max] operand);
    fn i16[min max] Or(mut borrow AtomicI16 self, i16[min max] operand);
    fn i16[min max] Xor(mut borrow AtomicI16 self, i16[min max] operand);
