import System.Text
import System.IO
import System.IO.File
import System.IO.Path
import System.Memory
import System.Runtime
import System.Runtime.Platform
import System.Runtime.Buffer
module System.FileSystem

const FileSystemMetadataKindOffset = 0;
const FileSystemMetadataPermissionsOffset = 4;
const FileSystemMetadataSizeOffset = 8;
const FileSystemMetadataModifiedSecondsOffset = 16;
const FileSystemMetadataModifiedNanosecondsOffset = 24;

public enum FileSystemEntryKind
{
    File,
    Directory,
    Symlink,
    Other,
}

public struct FileSystemEntry
{
    System.Text.OwnedAscii Name;
    FileSystemEntryKind Kind;

    finite ascii NameView(mut borrow FileSystemEntry self)
    {
        return self.Name.View();
    }
}

public struct FileSystemEntryInfo
{
    u64[0 2 ** 63 - 1] NameLength;
    FileSystemEntryKind Kind;
}

public struct FileMetadata
{
    u64[0 2 ** 63 - 1] Size;
    i64[min max] ModifiedUnixSeconds;
    i64[min max] ModifiedNanoseconds;
    u32[0 max] Permissions;
    FileSystemEntryKind Kind;

    inline finite law bool IsExecutable(borrow FileMetadata self)
    {
        return (self.Permissions & (u32[0 max])73) != 0;
    }
}

public enum DirectoryReadResult
{
    Entry(FileSystemEntry),
    End,
    Err(System.IO.IOError),
}

public enum DirectoryReadInfoResult
{
    Entry(FileSystemEntryInfo),
    End,
    Err(System.IO.IOError),
}

public struct Directory
{
    internal rawptr<i8[min max]> Handle;
    internal bool Closed;
    internal i64[min max] BufferReadPos;
    internal i64[min max] BufferWritePos;
    internal u64[0 2 ** 63 - 1] BufferCapacity;
    internal System.Runtime.Buffer.FixedByteBuffer8192 Buffer;

    finite law bool IsOpen(borrow Directory self)
    {
        return !self.Closed;
    }

    inline fn System.IO.IOStatus Close(mut borrow Directory self)
    {
        unsafe
        {
            if (self.Closed || self.Handle == null)
            {
                self.Handle = null;
                self.Closed = true;
                self.BufferReadPos = 0;
                self.BufferWritePos = 0;
                self.BufferCapacity = 0;
                return System.IO.IOStatus.Ok;
            }

            stack rawptr<i8[min max]> handle = self.Handle;
            self.Handle = null;
            self.Closed = true;
            self.BufferReadPos = 0;
            self.BufferWritePos = 0;
            self.BufferCapacity = 0;

            return StatusFromPlatformResult(System.Runtime.Platform.CloseDirectory(handle));
        }
    }

    internal unsafe inline fn i32[min max] ReadNextInfoRaw(
        mut borrow Directory self,
        rawmutptr<i64[min max]> nameLength,
        rawmutptr<i32[min max]> kindCode)
    {
        unsafe
        {
            if (nameLength == null || kindCode == null)
            {
                return -1;
            }

            if (self.Closed || self.Handle == null)
            {
                *nameLength = -2;
                *kindCode = -1;
                return -1;
            }

            stack rawmutptr<i8[min max]> buffer = self.Buffer.WritePointer();
            if (buffer == null || self.BufferCapacity == 0 || self.BufferCapacity > self.Buffer.Capacity())
            {
                *nameLength = -2;
                *kindCode = -36;
                return -36;
            }

            return System.Runtime.Platform.ReadDirectoryEntryInfo(
                self.Handle,
                buffer,
                self.BufferCapacity,
                &self.BufferReadPos,
                &self.BufferWritePos,
                nameLength,
                kindCode);
        }
    }

    internal unsafe inline fn i64[min max] ReadRemainingNameLengthChecksumRaw(
        mut borrow Directory self,
        i64[min max] expectedCount)
    {
        unsafe
        {
            if (expectedCount < 0)
            {
                return -1;
            }

            if (self.Closed || self.Handle == null)
            {
                return -1;
            }

            stack rawmutptr<i8[min max]> buffer = &self.Buffer.Storage[0];
            if (self.BufferCapacity == 0 || self.BufferCapacity > (u64[0 2 ** 63 - 1])8192)
            {
                return -1;
            }

            return System.Runtime.Platform.ReadDirectoryNameLengthChecksum(
                self.Handle,
                buffer,
                self.BufferCapacity,
                &self.BufferReadPos,
                &self.BufferWritePos,
                expectedCount);
        }
    }

    fn DirectoryReadInfoResult ReadNextInfo(mut borrow Directory self)
    {
        unsafe
        {
            stack mut i64[min max] nameLength = 0;
            stack mut i32[min max] kindCode = 0;
            self.ReadNextInfoRaw(&nameLength, &kindCode);
            return DirectoryReadInfoResultFromPlatformInfo(nameLength, kindCode);
        }
    }

    fn DirectoryReadResult ReadNext(mut borrow Directory self)
    {
        unsafe
        {
            if (self.Closed || self.Handle == null)
            {
                return DirectoryReadResult.Err(System.IO.IOError.Unknown(-1));
            }

            stack rawmutptr<i8[min max]> buffer = self.Buffer.WritePointer();
            if (buffer == null || self.BufferCapacity == 0 || self.BufferCapacity > self.Buffer.Capacity())
            {
                return DirectoryReadResult.Err(System.IO.IOError.InvalidPath);
            }

            stack mut i8[min max][256] nameStorage;
            stack mut Ascii name = new Ascii()
            {
                Data = &nameStorage[0],
                Length = 0,
                Capacity = 256
            };
            stack mut i32[min max] kindCode = 0;
            unsafe
            {
                System.Runtime.Platform.ReadDirectoryEntry(
                    self.Handle,
                    buffer,
                    self.BufferCapacity,
                    &self.BufferReadPos,
                    &self.BufferWritePos,
                    &name,
                    &kindCode);
            }

            return DirectoryReadResultFromPlatformResult(name, kindCode);
        }
    }

    mut drop
    {
        self.Close();
    }
}

fn System.IO.IOError IOErrorFromPlatformResult(i32[min max] result)
{
    if (result == -2 || result == -3)
    {
        return System.IO.IOError.NotFound;
    }

    if (result == -5 || result == -13)
    {
        return System.IO.IOError.PermissionDenied;
    }

    if (result == -17 || result == -183)
    {
        return System.IO.IOError.AlreadyExists;
    }

    if (result == -28 || result == -112)
    {
        return System.IO.IOError.DiskFull;
    }

    if (result == -32)
    {
        return System.IO.IOError.BrokenPipe;
    }

    if (result == -20)
    {
        return System.IO.IOError.NotADirectory;
    }

    if (result == -21)
    {
        return System.IO.IOError.IsADirectory;
    }

    // ENOTEMPTY is 39 on Linux and 66 on macOS.
    if (result == -39 || result == -66)
    {
        return System.IO.IOError.DirectoryNotEmpty;
    }

    // ELOOP is 40 on Linux and 62 on macOS; EMLINK is 31.
    if (result == -40 || result == -62 || result == -31)
    {
        return System.IO.IOError.TooManyLinks;
    }

    // ENAMETOOLONG is 36 on Linux and 63 on macOS; -206 is the Windows funnel.
    if (result == -36 || result == -63 || result == -206)
    {
        return System.IO.IOError.InvalidPath;
    }

    return System.IO.IOError.Unknown(result);
}

fn System.IO.IOStatus StatusFromPlatformResult(i32[min max] result)
{
    if (result < 0)
    {
        return System.IO.IOStatus.Err(IOErrorFromPlatformResult(result));
    }

    return System.IO.IOStatus.Ok;
}

fn FileSystemEntryKind FileSystemEntryKindFromPlatformKind(i32[min max] kindCode)
{
    if (kindCode == 1)
    {
        return FileSystemEntryKind.File;
    }

    if (kindCode == 2)
    {
        return FileSystemEntryKind.Directory;
    }

    if (kindCode == 3)
    {
        return FileSystemEntryKind.Symlink;
    }

    return FileSystemEntryKind.Other;
}

inline finite law System.IO.IOError IOErrorFromMemoryError(System.Memory.MemoryError error)
{
    switch (error)
    {
        case System.Memory.MemoryError.OutOfMemory:
            return System.IO.IOError.Unknown(-12);
        case System.Memory.MemoryError.UnsupportedAlignment:
            return System.IO.IOError.Unknown(-22);
        case System.Memory.MemoryError.TooLarge:
            return System.IO.IOError.Unknown(-27);
        case System.Memory.MemoryError.InvalidLayout:
            return System.IO.IOError.Unknown(-22);
    }
}

fn DirectoryReadInfoResult DirectoryReadInfoResultFromPlatformInfo(
    i64[min max] nameLength,
    i32[min max] kindCode)
{
    if (nameLength == -1)
    {
        return DirectoryReadInfoResult.End;
    }

    if (nameLength < 0)
    {
        return DirectoryReadInfoResult.Err(IOErrorFromPlatformResult(kindCode));
    }

    stack FileSystemEntryInfo entry = new FileSystemEntryInfo()
    {
        NameLength = (u64[0 2 ** 63 - 1])nameLength,
        Kind = FileSystemEntryKindFromPlatformKind(kindCode)
    };
    return DirectoryReadInfoResult.Entry(entry);
}

fn DirectoryReadResult DirectoryReadResultFromPlatformResult(
    Ascii name,
    i32[min max] kindCode)
{
    if (name.Length == -1)
    {
        return DirectoryReadResult.End;
    }

    if (name.Length < 0)
    {
        return DirectoryReadResult.Err(IOErrorFromPlatformResult(kindCode));
    }

    stack FileSystemEntryKind kind = FileSystemEntryKindFromPlatformKind(kindCode);

    if (name.Length < 0 || name.Length > name.Capacity)
    {
        return DirectoryReadResult.Err(System.IO.IOError.InvalidPath);
    }

    stack mut System.Text.OwnedAscii entryName = new();
    stack System.Memory.MemoryStatus status = entryName.AppendAsciiDisjoint(System.Text.AsciiView(name));
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return DirectoryReadResult.Err(System.IO.IOError.Unknown(-1));
        case System.Memory.MemoryStatus.Ok:
    }

    stack FileSystemEntry entry = new FileSystemEntry()
    {
        Name = entryName,
        Kind = kind
    };
    return DirectoryReadResult.Entry(entry);
}

fn System.IO.IOResult<Directory> OpenDirectoryWithPlatform(ascii path)
{
    unsafe
    {
        stack mut System.Runtime.Buffer.FixedByteBuffer8192 bufferStorage = new();
        stack u64[0 2 ** 63 - 1] bufferCapacity = System.Runtime.Platform.DirectoryBufferCapacity();
        if (bufferCapacity == 0 || bufferCapacity > bufferStorage.Capacity())
        {
            return System.IO.IOResult<Directory>.Err(System.IO.IOError.InvalidPath);
        }

        stack rawmutptr<i8[min max]> buffer = bufferStorage.WritePointer();
        if (buffer == null)
        {
            return System.IO.IOResult<Directory>.Err(System.IO.IOError.InvalidPath);
        }

        stack mut i64[min max] initialLength = 0;
        stack mut rawptr<i8[min max]> handle = null;
        unsafe
        {
            handle = System.Runtime.Platform.OpenDirectoryFastInto(
                path,
                buffer,
                bufferCapacity,
                &initialLength);
        }
        if (handle == null)
        {
            return System.IO.IOResult<Directory>.Err(System.IO.IOError.Unknown(-1));
        }

        stack Directory directory = new Directory()
        {
            Handle = handle,
            Closed = false,
            BufferReadPos = 0,
            BufferWritePos = initialLength,
            BufferCapacity = bufferCapacity,
            Buffer = bufferStorage
        };
        return System.IO.IOResult<Directory>.Ok(directory);
    }
}

public fn System.IO.IOStatus CreateDirectory(ascii path)
{
    return StatusFromPlatformResult(System.Runtime.Platform.CreateDirectory(path));
}

public fn System.IO.IOStatus DeleteDirectory(ascii path)
{
    return StatusFromPlatformResult(System.Runtime.Platform.DeleteDirectory(path));
}

internal fn System.IO.IOStatus DeleteTreePath(mut borrow System.Text.OwnedAscii path, FileSystemEntryKind kind)
{
    switch (kind)
    {
        case FileSystemEntryKind.Directory:
            stack mut Directory directory = new();
            switch (OpenDirectory(path.View()))
            {
                case System.IO.IOResult<Directory>.Err(var openError):
                    return System.IO.IOStatus.Err(openError);
                case System.IO.IOResult<Directory>.Ok(var opened):
                    directory = opened;
            }

            while willexit (true)
            {
                stack DirectoryReadResult next = directory.ReadNext();
                switch (next)
                {
                    case DirectoryReadResult.End:
                        switch (directory.Close())
                        {
                            case System.IO.IOStatus.Err(var closeError):
                                return System.IO.IOStatus.Err(closeError);
                            case System.IO.IOStatus.Ok:
                        }

                        return DeleteDirectory(path.View());
                    case DirectoryReadResult.Err(var readError):
                        directory.Close();
                        return System.IO.IOStatus.Err(readError);
                    case DirectoryReadResult.Entry(var entry):
                        stack mut FileSystemEntry child = entry;
                        stack u64[0 2 ** 63 - 1] previousLength = path.Length();
                        stack System.IO.IOStatus appendStatus = AppendPathSegment(path, child);
                        switch (appendStatus)
                        {
                            case System.IO.IOStatus.Err(var appendError):
                                directory.Close();
                                path.Truncate(previousLength);
                                return System.IO.IOStatus.Err(appendError);
                            case System.IO.IOStatus.Ok:
                        }

                        stack System.IO.IOStatus childStatus = DeleteTreePath(path, child.Kind);
                        path.Truncate(previousLength);
                        switch (childStatus)
                        {
                            case System.IO.IOStatus.Err(var childError):
                                directory.Close();
                                return System.IO.IOStatus.Err(childError);
                            case System.IO.IOStatus.Ok:
                        }
                }
            }
        case FileSystemEntryKind.File:
            return System.IO.File.Delete(path.View());
        case FileSystemEntryKind.Symlink:
            return System.IO.File.Delete(path.View());
        case FileSystemEntryKind.Other:
            return System.IO.File.Delete(path.View());
    }
}

internal fn System.IO.IOStatus DeleteTreeFromMetadata(ascii root, borrow FileMetadata metadata)
{
    stack mut System.Text.OwnedAscii rootPath = new();
    stack System.Memory.MemoryStatus appendStatus = rootPath.AppendAscii(root);
    switch (appendStatus)
    {
        case System.Memory.MemoryStatus.Err(var appendError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(appendError));
        case System.Memory.MemoryStatus.Ok:
    }

    return DeleteTreePath(rootPath, metadata.Kind);
}

public fn System.IO.IOStatus DeleteTree(ascii root)
{
    stack mut FileMetadata rootMetadata = new();
    switch (Metadata(root))
    {
        case System.IO.IOResult<FileMetadata>.Err(var metadataError):
            return System.IO.IOStatus.Err(metadataError);
        case System.IO.IOResult<FileMetadata>.Ok(var metadata):
            rootMetadata = metadata;
    }

    return DeleteTreeFromMetadata(root, rootMetadata);
}

public fn System.IO.IOStatus DeleteTreeIfExists(ascii root)
{
    stack mut FileMetadata rootMetadata = new();
    switch (Metadata(root))
    {
        case System.IO.IOResult<FileMetadata>.Err(var metadataError):
            switch (metadataError)
            {
                case System.IO.IOError.NotFound:
                    return System.IO.IOStatus.Ok;
                case System.IO.IOError.AlreadyExists:
                    return System.IO.IOStatus.Err(metadataError);
                case System.IO.IOError.PermissionDenied:
                    return System.IO.IOStatus.Err(metadataError);
                case System.IO.IOError.InvalidPath:
                    return System.IO.IOStatus.Err(metadataError);
                case System.IO.IOError.BrokenPipe:
                    return System.IO.IOStatus.Err(metadataError);
                case System.IO.IOError.DiskFull:
                    return System.IO.IOStatus.Err(metadataError);
                case System.IO.IOError.NotADirectory:
                    return System.IO.IOStatus.Err(metadataError);
                case System.IO.IOError.IsADirectory:
                    return System.IO.IOStatus.Err(metadataError);
                case System.IO.IOError.DirectoryNotEmpty:
                    return System.IO.IOStatus.Err(metadataError);
                case System.IO.IOError.TooManyLinks:
                    return System.IO.IOStatus.Err(metadataError);
                case System.IO.IOError.Unknown(var code):
                    return System.IO.IOStatus.Err(metadataError);
            }
        case System.IO.IOResult<FileMetadata>.Ok(var metadata):
            rootMetadata = metadata;
    }

    return DeleteTreeFromMetadata(root, rootMetadata);
}

public fn System.IO.IOResult<Directory> OpenDirectory(ascii path)
{
    return OpenDirectoryWithPlatform(path);
}

public fn System.IO.IOResult<bool> Exists(ascii path)
{
    return System.IO.IOResult<bool>.Ok(System.Runtime.Platform.PathExists(path));
}

public fn System.IO.IOResult<bool> IsFile(ascii path)
{
    return System.IO.IOResult<bool>.Ok(System.Runtime.Platform.IsFile(path));
}

public fn System.IO.IOResult<bool> IsDirectory(ascii path)
{
    return System.IO.IOResult<bool>.Ok(System.Runtime.Platform.IsDirectory(path));
}

public fn System.IO.IOStatus Move(ascii oldPath, ascii newPath)
{
    return StatusFromPlatformResult(System.Runtime.Platform.MoveFile(oldPath, newPath));
}

internal unsafe fn FileMetadata DecodeMetadataBuffer(rawptr<i8[min max]> metadataData)
{
    stack rawptr<i32[min max]> kindPointer = (rawptr<i32[min max]>)(&metadataData[FileSystemMetadataKindOffset]);
    stack rawptr<i32[min max]> permissionsPointer =
        (rawptr<i32[min max]>)(&metadataData[FileSystemMetadataPermissionsOffset]);
    stack rawptr<i64[min max]> sizePointer = (rawptr<i64[min max]>)(&metadataData[FileSystemMetadataSizeOffset]);
    stack rawptr<i64[min max]> modifiedSecondsPointer =
        (rawptr<i64[min max]>)(&metadataData[FileSystemMetadataModifiedSecondsOffset]);
    stack rawptr<i64[min max]> modifiedNanosecondsPointer =
        (rawptr<i64[min max]>)(&metadataData[FileSystemMetadataModifiedNanosecondsOffset]);

    stack mut i64[min max] size = *sizePointer;
    if (size < 0)
    {
        size = 0;
    }

    return new FileMetadata()
    {
        Size = (u64[0 2 ** 63 - 1])size,
        ModifiedUnixSeconds = *modifiedSecondsPointer,
        ModifiedNanoseconds = *modifiedNanosecondsPointer,
        Permissions = (u32[0 max])(*permissionsPointer),
        Kind = FileSystemEntryKindFromPlatformKind(*kindPointer)
    };
}

public fn System.IO.IOResult<FileMetadata> Metadata(ascii path)
{
    unsafe
    {
        stack mut System.Runtime.Buffer.FixedByteBuffer512 metadataBuffer = new System.Runtime.Buffer.FixedByteBuffer512();
        stack rawmutptr<i8[min max]> metadataData = metadataBuffer.WritePointer();
        if (metadataData == null)
        {
            return System.IO.IOResult<FileMetadata>.Err(System.IO.IOError.Unknown(-1));
        }

        stack i32[min max] metadataStatus = System.Runtime.Platform.ReadPathMetadata(path, metadataData);
        if (metadataStatus != 0)
        {
            return System.IO.IOResult<FileMetadata>.Err(IOErrorFromPlatformResult(metadataStatus));
        }

        return System.IO.IOResult<FileMetadata>.Ok(DecodeMetadataBuffer(metadataData));
    }
}

/// Reads metadata for a path WITHOUT following a final symbolic link
/// (lstat semantics). When the path is a symlink, the returned `Kind` is
/// `FileSystemEntryKind.Symlink`; `Metadata` follows the link and reports the
/// target's kind instead.
public fn System.IO.IOResult<FileMetadata> LinkMetadata(ascii path)
{
    unsafe
    {
        stack mut System.Runtime.Buffer.FixedByteBuffer512 metadataBuffer = new System.Runtime.Buffer.FixedByteBuffer512();
        stack rawmutptr<i8[min max]> metadataData = metadataBuffer.WritePointer();
        if (metadataData == null)
        {
            return System.IO.IOResult<FileMetadata>.Err(System.IO.IOError.Unknown(-1));
        }

        stack i32[min max] metadataStatus = System.Runtime.Platform.ReadLinkMetadata(path, metadataData);
        if (metadataStatus != 0)
        {
            return System.IO.IOResult<FileMetadata>.Err(IOErrorFromPlatformResult(metadataStatus));
        }

        return System.IO.IOResult<FileMetadata>.Ok(DecodeMetadataBuffer(metadataData));
    }
}

/// Returns whether `path` itself is a symbolic link (does not follow links).
public fn System.IO.IOResult<bool> IsSymlink(ascii path)
{
    switch (LinkMetadata(path))
    {
        case System.IO.IOResult<FileMetadata>.Err(var error):
            return System.IO.IOResult<bool>.Err(error);
        case System.IO.IOResult<FileMetadata>.Ok(var metadata):
            return System.IO.IOResult<bool>.Ok(metadata.Kind == FileSystemEntryKind.Symlink);
    }
}

/// Creates a symbolic link at `linkPath` pointing at `target`. `target` is
/// stored verbatim and may be relative to the link's own directory.
public fn System.IO.IOStatus CreateSymlink(ascii target, ascii linkPath)
{
    return StatusFromPlatformResult(System.Runtime.Platform.CreateSymlink(target, linkPath));
}

/// Reads the target path stored in the symbolic link at `path`. The result is
/// the raw link contents (not resolved to an absolute path).
public fn System.IO.IOResult<System.Text.OwnedAscii> ReadSymlink(ascii path)
{
    unsafe
    {
        stack mut System.Runtime.Buffer.FixedByteBuffer4096 targetBuffer = new System.Runtime.Buffer.FixedByteBuffer4096();
        stack rawmutptr<i8[min max]> targetData = targetBuffer.WritePointer();
        stack u64[0 2 ** 63 - 1] capacity = targetBuffer.Writable();
        if (targetData == null || capacity == 0)
        {
            return System.IO.IOResult<System.Text.OwnedAscii>.Err(System.IO.IOError.Unknown(-1));
        }

        stack i64[min max] written = System.Runtime.Platform.ReadSymlinkInto(path, targetData, capacity);
        if (written < 0)
        {
            return System.IO.IOResult<System.Text.OwnedAscii>.Err(IOErrorFromPlatformResult((i32[min max])written));
        }

        // readlink does not null-terminate and truncates silently when the
        // buffer fills; reject a result that exactly fills the buffer because
        // it may be truncated.
        if ((u64[0 2 ** 63 - 1])written >= capacity)
        {
            return System.IO.IOResult<System.Text.OwnedAscii>.Err(System.IO.IOError.InvalidPath);
        }

        stack mut System.Text.OwnedAscii target = new();
        stack System.Memory.MemoryStatus reserveStatus = target.Reserve((u64[0 2 ** 63 - 1])written);
        switch (reserveStatus)
        {
            case System.Memory.MemoryStatus.Err(var reserveError):
                return System.IO.IOResult<System.Text.OwnedAscii>.Err(IOErrorFromMemoryError(reserveError));
            case System.Memory.MemoryStatus.Ok:
        }

        for willexit (stack mut i64[min max] index = 0; index < written; index += 1)
        {
            stack System.Memory.MemoryStatus appendStatus = target.AppendByte(*(&targetData[index]));
            switch (appendStatus)
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.IO.IOResult<System.Text.OwnedAscii>.Err(IOErrorFromMemoryError(appendError));
                case System.Memory.MemoryStatus.Ok:
            }
        }

        return System.IO.IOResult<System.Text.OwnedAscii>.Ok(target);
    }
}

public fn System.IO.IOResult<System.Text.OwnedAscii> CreateTempDirectoryIn(ascii parent, ascii prefix)
{
    stack mut System.Text.OwnedAscii path = new();

    for willexit (stack mut u16[0 1024] attempt = 0; attempt < 1024; attempt += 1)
    {
        stack System.Memory.MemoryStatus buildStatus =
            System.IO.Path.TryTempPathIn(path, parent, prefix, (u64[0 max])attempt, "");
        switch (buildStatus)
        {
            case System.Memory.MemoryStatus.Err(var buildError):
                return System.IO.IOResult<System.Text.OwnedAscii>.Err(IOErrorFromMemoryError(buildError));
            case System.Memory.MemoryStatus.Ok:
        }

        stack System.IO.IOStatus createStatus = CreateDirectory(path.View());
        switch (createStatus)
        {
            case System.IO.IOStatus.Ok:
                return System.IO.IOResult<System.Text.OwnedAscii>.Ok(path);
            case System.IO.IOStatus.Err(var createError):
                switch (createError)
                {
                    case System.IO.IOError.AlreadyExists:
                        continue;
                    case System.IO.IOError.NotFound:
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                    case System.IO.IOError.PermissionDenied:
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                    case System.IO.IOError.InvalidPath:
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                    case System.IO.IOError.BrokenPipe:
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                    case System.IO.IOError.DiskFull:
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                    case System.IO.IOError.NotADirectory:
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                    case System.IO.IOError.IsADirectory:
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                    case System.IO.IOError.DirectoryNotEmpty:
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                    case System.IO.IOError.TooManyLinks:
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                    case System.IO.IOError.Unknown(var code):
                        return System.IO.IOResult<System.Text.OwnedAscii>.Err(createError);
                }
        }
    }

    return System.IO.IOResult<System.Text.OwnedAscii>.Err(System.IO.IOError.AlreadyExists);
}

public fn System.IO.IOResult<System.Text.OwnedAscii> CreateTempDirectory(ascii prefix)
{
    stack mut System.Text.OwnedAscii parent = new();
    stack System.Memory.MemoryStatus parentStatus = System.IO.Path.TempDirectory(parent);
    switch (parentStatus)
    {
        case System.Memory.MemoryStatus.Err(var parentError):
            return System.IO.IOResult<System.Text.OwnedAscii>.Err(IOErrorFromMemoryError(parentError));
        case System.Memory.MemoryStatus.Ok:
    }

    return CreateTempDirectoryIn(parent.View(), prefix);
}

internal fn System.IO.IOStatus AppendPathSegment(
    mut borrow System.Text.OwnedAscii path,
    mut borrow FileSystemEntry entry)
{
    stack System.Memory.MemoryStatus separatorStatus = path.AppendAscii(System.IO.Path.DirectorySeparator());
    switch (separatorStatus)
    {
        case System.Memory.MemoryStatus.Err(var separatorError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(separatorError));
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus nameStatus = path.AppendAscii(entry.NameView());
    switch (nameStatus)
    {
        case System.Memory.MemoryStatus.Err(var nameError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(nameError));
        case System.Memory.MemoryStatus.Ok:
            return System.IO.IOStatus.Ok;
    }
}

internal fn System.IO.IOStatus WalkRecursivePath(
    mut borrow System.Text.OwnedAscii path,
    FileSystemEntryKind kind,
    inline closure<fn System.IO.IOStatus(ascii, FileSystemEntryKind)> visitor)
{
    stack mut bool shouldRecurse = false;
    switch (kind)
    {
        case FileSystemEntryKind.Directory:
            shouldRecurse = true;
        case FileSystemEntryKind.Symlink:
            shouldRecurse = false;
        case FileSystemEntryKind.File:
            shouldRecurse = false;
        case FileSystemEntryKind.Other:
            shouldRecurse = false;
    }

    stack System.IO.IOStatus visitStatus = visitor(path.View(), kind);
    switch (visitStatus)
    {
        case System.IO.IOStatus.Err(var visitError):
            return System.IO.IOStatus.Err(visitError);
        case System.IO.IOStatus.Ok:
    }

    if (!shouldRecurse)
    {
        return System.IO.IOStatus.Ok;
    }

    stack System.IO.IOResult<Directory> opened = OpenDirectory(path.View());
    switch (opened)
    {
        case System.IO.IOResult<Directory>.Err(var openError):
            return System.IO.IOStatus.Err(openError);
        case System.IO.IOResult<Directory>.Ok(var value):
            stack mut Directory directory = value;
            while willexit (true)
            {
                stack DirectoryReadResult next = directory.ReadNext();
                switch (next)
                {
                    case DirectoryReadResult.End:
                        return directory.Close();
                    case DirectoryReadResult.Err(var readError):
                        directory.Close();
                        return System.IO.IOStatus.Err(readError);
                    case DirectoryReadResult.Entry(var entry):
                        stack mut FileSystemEntry child = entry;
                        stack u64[0 2 ** 63 - 1] previousLength = path.Length();
                        stack System.IO.IOStatus appendStatus = AppendPathSegment(path, child);
                        switch (appendStatus)
                        {
                            case System.IO.IOStatus.Err(var appendError):
                                directory.Close();
                                path.Truncate(previousLength);
                                return System.IO.IOStatus.Err(appendError);
                            case System.IO.IOStatus.Ok:
                        }

                        stack System.IO.IOStatus childStatus = WalkRecursivePath(path, child.Kind, visitor);
                        path.Truncate(previousLength);
                        switch (childStatus)
                        {
                            case System.IO.IOStatus.Err(var childError):
                                directory.Close();
                                return System.IO.IOStatus.Err(childError);
                            case System.IO.IOStatus.Ok:
                        }
                }
            }
    }
}

internal fn System.IO.IOStatus GlobRecursivePath(
    mut borrow System.Text.OwnedAscii path,
    FileSystemEntryKind kind,
    ascii pattern,
    inline closure<fn System.IO.IOStatus(ascii, FileSystemEntryKind)> visitor)
    where overlap(path, pattern)
{
    stack mut bool shouldRecurse = false;
    switch (kind)
    {
        case FileSystemEntryKind.Directory:
            shouldRecurse = true;
        case FileSystemEntryKind.Symlink:
            shouldRecurse = false;
        case FileSystemEntryKind.File:
            shouldRecurse = false;
        case FileSystemEntryKind.Other:
            shouldRecurse = false;
    }

    if (System.IO.Path.GlobMatches(pattern, path.View()))
    {
        stack System.IO.IOStatus visitStatus = visitor(path.View(), kind);
        switch (visitStatus)
        {
            case System.IO.IOStatus.Err(var visitError):
                return System.IO.IOStatus.Err(visitError);
            case System.IO.IOStatus.Ok:
        }
    }

    if (!shouldRecurse)
    {
        return System.IO.IOStatus.Ok;
    }

    stack System.IO.IOResult<Directory> opened = OpenDirectory(path.View());
    switch (opened)
    {
        case System.IO.IOResult<Directory>.Err(var openError):
            return System.IO.IOStatus.Err(openError);
        case System.IO.IOResult<Directory>.Ok(var value):
            stack mut Directory directory = value;
            while willexit (true)
            {
                stack DirectoryReadResult next = directory.ReadNext();
                switch (next)
                {
                    case DirectoryReadResult.End:
                        return directory.Close();
                    case DirectoryReadResult.Err(var readError):
                        directory.Close();
                        return System.IO.IOStatus.Err(readError);
                    case DirectoryReadResult.Entry(var entry):
                        stack mut FileSystemEntry child = entry;
                        stack u64[0 2 ** 63 - 1] previousLength = path.Length();
                        stack System.IO.IOStatus appendStatus = AppendPathSegment(path, child);
                        switch (appendStatus)
                        {
                            case System.IO.IOStatus.Err(var appendError):
                                directory.Close();
                                path.Truncate(previousLength);
                                return System.IO.IOStatus.Err(appendError);
                            case System.IO.IOStatus.Ok:
                        }

                        stack System.IO.IOStatus childStatus = GlobRecursivePath(path, child.Kind, pattern, visitor);
                        path.Truncate(previousLength);
                        switch (childStatus)
                        {
                            case System.IO.IOStatus.Err(var childError):
                                directory.Close();
                                return System.IO.IOStatus.Err(childError);
                            case System.IO.IOStatus.Ok:
                        }
                }
            }
    }
}

public fn System.IO.IOStatus WalkRecursive(
    ascii root,
    inline closure<fn System.IO.IOStatus(ascii, FileSystemEntryKind)> visitor)
{
    stack mut System.Text.OwnedAscii rootPath = new();
    stack System.Memory.MemoryStatus appendStatus = rootPath.AppendAscii(root);
    switch (appendStatus)
    {
        case System.Memory.MemoryStatus.Err(var appendError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(appendError));
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut FileMetadata rootMetadata = new();
    switch (Metadata(root))
    {
        case System.IO.IOResult<FileMetadata>.Err(var metadataError):
            return System.IO.IOStatus.Err(metadataError);
        case System.IO.IOResult<FileMetadata>.Ok(var metadata):
            rootMetadata = metadata;
    }

    return WalkRecursivePath(rootPath, rootMetadata.Kind, visitor);
}

public fn System.IO.IOStatus Glob(
    ascii root,
    ascii pattern,
    inline closure<fn System.IO.IOStatus(ascii, FileSystemEntryKind)> visitor)
    where overlap(root, pattern)
{
    stack mut System.Text.OwnedAscii rootPath = new();
    stack System.Memory.MemoryStatus appendStatus = rootPath.AppendAscii(root);
    switch (appendStatus)
    {
        case System.Memory.MemoryStatus.Err(var appendError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(appendError));
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut System.Text.OwnedAscii fullPattern = new();
    stack System.Memory.MemoryStatus patternStatus = System.IO.Path.TryJoin(fullPattern, root, pattern);
    switch (patternStatus)
    {
        case System.Memory.MemoryStatus.Err(var patternError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(patternError));
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut FileMetadata rootMetadata = new();
    switch (Metadata(root))
    {
        case System.IO.IOResult<FileMetadata>.Err(var metadataError):
            return System.IO.IOStatus.Err(metadataError);
        case System.IO.IOResult<FileMetadata>.Ok(var metadata):
            rootMetadata = metadata;
    }

    return GlobRecursivePath(rootPath, rootMetadata.Kind, fullPattern.View(), visitor);
}
