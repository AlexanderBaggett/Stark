public fn System.Memory.MemoryResult<System.Text.OwnedAscii> ReadAsciiLine()
{
    unsafe
    {
        stack mut System.Text.OwnedAscii line = new();
        stack mut bool pendingCarriageReturn = false;
        while willexit (true)
        {
            stack mut i8[min max] value = 0;
            if (!TryReadInputByte(value))
            {
                stack System.Memory.MemoryStatus finalStatus = AppendCarriageReturnIfPending(line, pendingCarriageReturn);
                switch (finalStatus)
                {
                    case System.Memory.MemoryStatus.Err(var finalError):
                        return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(finalError);
                    case System.Memory.MemoryStatus.Ok:
                }

                break;
            }

            if (value == (i8[min max])10)
            {
                pendingCarriageReturn = false;
                break;
            }

            stack System.Memory.MemoryStatus pendingStatus = AppendCarriageReturnIfPending(line, pendingCarriageReturn);
            switch (pendingStatus)
            {
                case System.Memory.MemoryStatus.Err(var pendingError):
                    return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(pendingError);
                case System.Memory.MemoryStatus.Ok:
            }

            if (value == (i8[min max])13)
            {
                pendingCarriageReturn = true;
            }
            else
            {
                stack System.Memory.MemoryStatus appendStatus = AppendAsciiByte(line, value);
                switch (appendStatus)
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(appendError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(line);
    }
}

public fn System.Memory.MemoryResult<System.Text.OwnedUnicode> ReadUnicodeLine()
{
    stack System.Memory.MemoryResult<System.Text.OwnedAscii> asciiResult = ReadAsciiLine();
    switch (asciiResult)
    {
        case System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(error);
        case System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(var asciiLine):
            stack mut System.Text.OwnedAscii mutableAsciiLine = asciiLine;
            return DecodeAsciiBytes(mutableAsciiLine);
    }
}

public fn System.Memory.MemoryResult<System.Text.OwnedUnicode> ReadLine()
{
    return ReadUnicodeLine();
}

public fn System.Memory.MemoryResult<System.Text.OwnedUnicode> Read()
{
    unsafe
    {
        stack mut System.Text.OwnedAscii bytes = new();
        stack mut i8[min max] first = 0;
        if (!TryReadInputByte(first))
        {
            return DecodeAsciiBytes(bytes);
        }

        stack u8[0 4] expectedLength = Utf8ExpectedByteCount(first);
        if (expectedLength == 0)
        {
            return ReplacementUnicodeResult();
        }

        stack System.Memory.MemoryStatus firstStatus = bytes.AppendByte(first);
        switch (firstStatus)
        {
            case System.Memory.MemoryStatus.Err(var firstError):
                return System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(firstError);
            case System.Memory.MemoryStatus.Ok:
        }

        stack mut u8[0 4] index = 1;
        while willexit (index < expectedLength)
        {
            stack mut i8[min max] value = 0;
            if (!TryReadInputByte(value))
            {
                return ReplacementUnicodeResult();
            }

            stack System.Memory.MemoryStatus appendStatus = bytes.AppendByte(value);
            switch (appendStatus)
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }

            index += 1;
        }

        return DecodeAsciiBytes(bytes);
    }
}
