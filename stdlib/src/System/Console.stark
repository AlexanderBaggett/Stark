public fn System.Memory.MemoryResult<u64[0 2 ** 63 - 1]> ReadBytes(
    mut borrow System.Runtime.Buffer.DynamicByteBuffer destination,
    u64[0 2 ** 63 - 1] maxCount)
{
        unsafe
        {
        stack mut u64[0 2 ** 63 - 1] readCount = 0;
        while willexit (readCount < maxCount)
        {
            stack mut i8[min max] value = 0;
            if (!TryReadInputByte(value))
            {
                break;
            }

            stack System.Memory.MemoryStatus status = destination.WriteByte(value);
            switch (status)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryResult<u64[0 2 ** 63 - 1]>.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }

            readCount += 1;
        }

        return System.Memory.MemoryResult<u64[0 2 ** 63 - 1]>.Ok(readCount);
        }
}

public fn System.Memory.MemoryResult<u64[0 2 ** 63 - 1]> ReadBytes(
    mut borrow System.Runtime.Buffer.FixedByteBuffer512 destination,
    u64[0 2 ** 63 - 1] maxCount)
{
        unsafe
        {
        stack mut u64[0 2 ** 63 - 1] readCount = 0;
        while willexit (readCount < maxCount && destination.Writable() > 0)
        {
            stack mut i8[min max] value = 0;
            if (!TryReadInputByte(value))
            {
                break;
            }

            stack System.Memory.MemoryStatus status = destination.WriteByte(value);
            switch (status)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryResult<u64[0 2 ** 63 - 1]>.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }

            readCount += 1;
        }

        return System.Memory.MemoryResult<u64[0 2 ** 63 - 1]>.Ok(readCount);
        }
}

