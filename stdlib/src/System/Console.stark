import System.Runtime.Buffer
import System.Text
import System.IO
import System.Memory
import System.Runtime
import System.Runtime.Platform
module System.Console

const ConsoleInputByteCapacity = 8192;

internal struct ConsoleInputByteStorage
{
    i8[min max][8192] Storage;
}

static mut ConsoleInputByteStorage ConsoleInputStorage = new ConsoleInputByteStorage();
static mut i64[min max] ConsoleInputReadPos = 0;
static mut i64[min max] ConsoleInputWritePos = 0;
static mut rawptr<i8[min max]> ConsoleInputHandle = null;
static mut bool ConsoleInputHandleInitialized = false;
static mut bool ConsoleInputEndOfInput = false;

fn System.IO.IOStatus StatusFromWriteResult(i32[min max] result)
{
    if (result < 0)
    {
        return System.IO.IOStatus.Err(System.IO.IOError.Unknown(result));
    }

    return System.IO.IOStatus.Ok;
}

fn i32[min max] UnsignedByte(i8[min max] value)
{
    if (value < 0)
    {
        return ((i32[min max])value) + 256;
    }

    return (i32[min max])value;
}

fn u8[0 4] Utf8ExpectedByteCount(i8[min max] firstByte)
{
    unsafe
    {
        stack i32[min max] first = UnsignedByte(firstByte);
        if (first <= 127)
        {
            return 1;
        }

        if (194 <= first && first <= 223)
        {
            return 2;
        }

        if (224 <= first && first <= 239)
        {
            return 3;
        }

        if (240 <= first && first <= 244)
        {
            return 4;
        }

        return 0;
    }
}

unsafe fn rawptr<i8[min max]> EnsureConsoleInputHandle()
{
    if (ConsoleInputEndOfInput)
    {
        return null;
    }

    if (ConsoleInputHandleInitialized)
    {
        return ConsoleInputHandle;
    }

    ConsoleInputHandle = System.Runtime.Platform.OpenStdin();
    ConsoleInputHandleInitialized = true;
    return ConsoleInputHandle;
}

fn void CloseConsoleInputHandle()
{
    unsafe
    {
        if (ConsoleInputHandle != null)
        {
            System.Runtime.Platform.CloseStdin(ConsoleInputHandle);
            ConsoleInputHandle = null;
        }

        ConsoleInputReadPos = 0;
        ConsoleInputWritePos = 0;
        ConsoleInputEndOfInput = true;
        return;
    }
}

fn bool RefillConsoleInput()
{
    unsafe
    {
        stack rawptr<i8[min max]> handle = EnsureConsoleInputHandle();
        if (handle == null)
        {
            CloseConsoleInputHandle();
            return false;
        }

        stack mut i64[min max] readCount = 0;
        unsafe
        {
            readCount = System.Runtime.Platform.ReadStdin(&ConsoleInputStorage.Storage[0], ConsoleInputByteCapacity);
        }

        if (readCount <= 0)
        {
            CloseConsoleInputHandle();
            return false;
        }

        ConsoleInputReadPos = 0;
        ConsoleInputWritePos = readCount;
        return true;
    }
}

fn bool TryReadInputByte(out i8[min max] destination)
{
    unsafe
    {
        destination = 0;
        if (ConsoleInputReadPos >= ConsoleInputWritePos)
        {
            if (!RefillConsoleInput())
            {
                return false;
            }
        }

        destination = *(&ConsoleInputStorage.Storage[ConsoleInputReadPos]);
        ConsoleInputReadPos += 1;
        return true;
    }
}

fn System.Memory.MemoryStatus AppendAsciiByte(
    mut borrow System.Text.OwnedAscii destination,
    i8[min max] value)
{
    if (destination.Length() >= ConsoleInputByteCapacity)
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    return destination.AppendByte(value);
}

fn System.Memory.MemoryStatus AppendCarriageReturnIfPending(
    mut borrow System.Text.OwnedAscii destination,
    out bool pendingCarriageReturn)
{
    if (!pendingCarriageReturn)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    pendingCarriageReturn = false;
    return AppendAsciiByte(destination, (i8[min max])13);
}

fn System.Memory.MemoryResult<System.Text.OwnedUnicode> DecodeAsciiBytes(
    mut borrow System.Text.OwnedAscii source)
{
    stack mut System.Text.OwnedUnicode destination = new();
    stack System.Memory.MemoryStatus status = destination.AppendAscii(source.View());
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedUnicode>.Ok(destination);
    }
}

fn System.Memory.MemoryResult<System.Text.OwnedUnicode> ReplacementUnicodeResult()
{
    stack mut System.Text.OwnedUnicode replacement = new();
    stack System.Memory.MemoryStatus status = replacement.AppendCodePoint(65533);
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedUnicode>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedUnicode>.Ok(replacement);
    }
}

fn System.IO.IOStatus WriteBytesToStdout(borrow i8[min max][] source)
{
    unsafe
    {
        stack System.Runtime.ByteSliceParts sourceParts = System.Runtime.GetByteSliceParts(source);
        if (sourceParts.Length == 0)
        {
            return System.IO.IOStatus.Ok;
        }

        if (sourceParts.Data == null)
        {
            return System.IO.IOStatus.Err(System.IO.IOError.InvalidPath);
        }

        stack mut i32[min max] result = 0;
        unsafe
        {
            result = System.Runtime.Platform.WriteStdoutBytes(sourceParts.Data, sourceParts.Length);
        }

        return StatusFromWriteResult(result);
    }
}

fn System.IO.IOStatus WriteBytesToStderr(borrow i8[min max][] source)
{
    unsafe
    {
        stack System.Runtime.ByteSliceParts sourceParts = System.Runtime.GetByteSliceParts(source);
        if (sourceParts.Length == 0)
        {
            return System.IO.IOStatus.Ok;
        }

        if (sourceParts.Data == null)
        {
            return System.IO.IOStatus.Err(System.IO.IOError.InvalidPath);
        }

        stack mut i32[min max] result = 0;
        unsafe
        {
            result = System.Runtime.Platform.WriteStderrBytes(sourceParts.Data, sourceParts.Length);
        }

        return StatusFromWriteResult(result);
    }
}

fn System.IO.IOStatus WriteBytesLineToStdout(borrow i8[min max][] source)
{
    unsafe
    {
        stack System.Runtime.ByteSliceParts sourceParts = System.Runtime.GetByteSliceParts(source);
        if (sourceParts.Length > 0 && sourceParts.Data == null)
        {
            return System.IO.IOStatus.Err(System.IO.IOError.InvalidPath);
        }

        stack mut i32[min max] result = 0;
        unsafe
        {
            result = System.Runtime.Platform.WriteStdoutBytesLine(sourceParts.Data, sourceParts.Length);
        }

        return StatusFromWriteResult(result);
    }
}

fn System.IO.IOStatus WriteBytesLineToStderr(borrow i8[min max][] source)
{
    unsafe
    {
        stack System.Runtime.ByteSliceParts sourceParts = System.Runtime.GetByteSliceParts(source);
        if (sourceParts.Length > 0 && sourceParts.Data == null)
        {
            return System.IO.IOStatus.Err(System.IO.IOError.InvalidPath);
        }

        stack mut i32[min max] result = 0;
        unsafe
        {
            result = System.Runtime.Platform.WriteStderrBytesLine(sourceParts.Data, sourceParts.Length);
        }

        return StatusFromWriteResult(result);
    }
}

