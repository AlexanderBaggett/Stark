public fn ProcessResult<System.Text.OwnedAscii> CurrentDirectory()
{
    stack System.Memory.MemoryResult<System.Text.OwnedAscii> result = System.IO.Path.CurrentDirectory();
    switch (result)
    {
        case System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(var error):
            return ProcessResult<System.Text.OwnedAscii>.Err(FromMemoryError(error));
        case System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(var value):
            return ProcessResult<System.Text.OwnedAscii>.Ok(value);
    }
}

public unsafe fn ProcessStatus SetCurrentDirectory(ascii path)
{
    stack ProcessResult<System.C.OwnedCStr> prepared = PrepareCString(path);
    switch (prepared)
    {
        case ProcessResult<System.C.OwnedCStr>.Err(var error):
            return ProcessStatus.Err(error);
        case ProcessResult<System.C.OwnedCStr>.Ok(var cPath):
            stack i32[min max] result = System.Runtime.Platform.ChangeCurrentDirectoryRaw(cPath.Data());
            if (result != 0)
            {
                return ProcessStatus.Err(ProcessError.Platform(result));
            }

            return ProcessStatus.Ok;
    }
}

internal unsafe fn ProcessStatus PushArgumentSlice(
    mut borrow ProcessArguments arguments,
    borrow i8[min max][] bytes,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] length)
{
    stack mut rawptr<i8[min max]> data = null;
    if (length > 0)
    {
        data = &bytes[start];
    }

    stack System.Memory.MemoryResult<System.Text.OwnedAscii> copied = System.Text.CopyAsciiPointer(data, length);
    switch (copied)
    {
        case System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(var error):
            return ProcessStatus.Err(FromMemoryError(error));
        case System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(var value):
            if (!arguments.Items.TryReserve(1))
            {
                return ProcessStatus.Err(ProcessError.Memory(System.Memory.MemoryError.OutOfMemory));
            }

            init arguments.Items[arguments.Items.Length] = value;
            return ProcessStatus.Ok;
    }
}

public unsafe fn ProcessResult<ProcessArguments> Arguments()
{
    stack mut dynamic i8[min max] bytes = new();
    stack i32[min max] readStatus = System.Runtime.Platform.ReadArgumentsBlock(bytes);
    if (readStatus != 0)
    {
        return ProcessResult<ProcessArguments>.Err(ProcessError.Platform(readStatus));
    }

    stack mut ProcessArguments arguments = new();
    stack i8[min max][] slice = bytes[0, bytes.Length];
    stack mut u64[0 2 ** 63 - 1] start = 0;
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < slice.Length; index += 1)
    {
        if (slice[index] == 0)
        {
            stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])(index - start);
            stack ProcessStatus status = PushArgumentSlice(arguments, slice, start, length);
            switch (status)
            {
                case ProcessStatus.Err(var pushError):
                    return ProcessResult<ProcessArguments>.Err(pushError);
                case ProcessStatus.Ok:
            }

            start = (u64[0 2 ** 63 - 1])(index + 1);
        }
    }

    if (start < slice.Length)
    {
        stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])(slice.Length - start);
        stack ProcessStatus status = PushArgumentSlice(arguments, slice, start, length);
        switch (status)
        {
            case ProcessStatus.Err(var pushError):
                return ProcessResult<ProcessArguments>.Err(pushError);
            case ProcessStatus.Ok:
        }
    }

    return ProcessResult<ProcessArguments>.Ok(arguments);
}

public unsafe fn ProcessResult<u64[0 2 ** 63 - 1]> ArgumentCount()
{
    stack ProcessResult<ProcessArguments> result = Arguments();
    switch (result)
    {
        case ProcessResult<ProcessArguments>.Err(var error):
            return ProcessResult<u64[0 2 ** 63 - 1]>.Err(error);
        case ProcessResult<ProcessArguments>.Ok(var arguments):
            return ProcessResult<u64[0 2 ** 63 - 1]>.Ok(arguments.Count());
    }
}
