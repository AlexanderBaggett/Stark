public unsafe fn ProcessResult<ProcessOutput> RunCapture(mut borrow ProcessCommand command)
{
    if (command.Executable.IsEmpty())
    {
        return ProcessResult<ProcessOutput>.Err(ProcessError.InvalidArgument);
    }

    stack mut dynamic rawptr<System.C.c_char> argv = new();
    stack ProcessStatus argvStatus = BuildArgumentVector(command, argv);
    switch (argvStatus)
    {
        case ProcessStatus.Err(var error):
            return ProcessResult<ProcessOutput>.Err(error);
        case ProcessStatus.Ok:
    }

    stack mut i32[min max] processId = -1;
    stack mut i32[min max] stdinDescriptor = -1;
    stack mut i32[min max] stdoutDescriptor = -1;
    stack mut i32[min max] stderrDescriptor = -1;
    stack mut rawptr<System.C.c_char> workingDirectory = null;
    if (command.HasWorkingDirectory)
    {
        workingDirectory = command.WorkingDirectory.Data();
    }

    stack rawptr<System.C.c_char>[] argvSlice = argv[0, argv.Length];
    stack i32[min max] startResult = System.Runtime.Platform.StartProcessCapture(
        command.Executable.Data(),
        argvSlice,
        workingDirectory,
        false,
        &processId,
        &stdinDescriptor,
        &stdoutDescriptor,
        &stderrDescriptor);
    if (startResult != 0)
    {
        return ProcessStartFailure(startResult);
    }

    stack mut ProcessOutput output = new();
    stack ProcessResult<i32[min max]> exitResult = CaptureChildOutput(processId, stdoutDescriptor, stderrDescriptor, output);
    switch (exitResult)
    {
        case ProcessResult<i32[min max]>.Err(var error):
            return ProcessResult<ProcessOutput>.Err(error);
        case ProcessResult<i32[min max]>.Ok(var code):
            output.ExitCode = code;
            return ProcessResult<ProcessOutput>.Ok(output);
    }
}

