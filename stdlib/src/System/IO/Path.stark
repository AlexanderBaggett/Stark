public finite law PathFacts GetFacts(ascii path)
{
    unsafe
    {
        stack mut i64[min max] end = System.Text.AsciiLength(path);
        stack rawptr<i8[min max]> data = System.Text.AsciiData(path);
        if (end > 0 && data == null)
        {
            return EmptyPathFacts();
        }

        stack i64[min max] pathLength = end;
        stack mut u64[0 2 ** 63 - 1] unsignedRootLength = 0;
        if (pathLength > 0)
        {
            if (HasWindowsRootRules())
            {
                if (pathLength >= 2)
                {
                    if (IsAsciiDriveLetterUnit(*data))
                    {
                        if (IsColonUnit(*(&data[1])))
                        {
                            unsignedRootLength = 2;
                            if (pathLength >= 3)
                            {
                                if (IsDirectorySeparatorUnit(*(&data[2])))
                                {
                                    unsignedRootLength = 3;
                                }
                            }
                        }
                    }
                }
            }

            if (unsignedRootLength == 0)
            {
                if (IsDirectorySeparatorUnit(*data))
                {
                    unsignedRootLength = 1;
                }
            }
        }

        stack i64[min max] rootLength = (i64[min max])unsignedRootLength;
        stack bool absolute = IsAbsoluteFromRootLength(unsignedRootLength);

        while willexit (end > 1)
        {
            if (!IsDirectorySeparatorUnit(*(&data[end - 1])))
            {
                break;
            }

            end -= 1;
        }

        if (end <= 0)
        {
            return EmptyPathFacts();
        }

        stack mut i64[min max] separator = end - 1;
        while willexit (separator >= 0)
        {
            if (IsDirectorySeparatorUnit(*(&data[separator])))
            {
                break;
            }

            separator -= 1;
        }

        stack mut i64[min max] segmentStart = separator + 1;
        if (separator < 0)
        {
            segmentStart = rootLength;
        }

        if (segmentStart < rootLength)
        {
            segmentStart = rootLength;
        }

        stack mut i64[min max] directoryLength = 0;
        if (end <= rootLength && rootLength > 0)
        {
            directoryLength = rootLength;
            segmentStart = end;
        }
        else
        {
            if (separator >= 0)
            {
                if (separator < rootLength)
                {
                    directoryLength = rootLength;
                }
                else
                {
                    if (separator == 0)
                    {
                        directoryLength = 1;
                    }
                    else
                    {
                        directoryLength = separator;
                    }
                }
            }
            else
            {
                if (rootLength > 0)
                {
                    directoryLength = rootLength;
                }
            }
        }

        stack mut i64[min max] extensionStart = end - 1;
        stack mut bool hasExtension = false;
        while willexit (extensionStart > segmentStart)
        {
            if (IsDotUnit(*(&data[extensionStart])))
            {
                hasExtension = true;
                break;
            }

            extensionStart -= 1;
        }

        return new PathFacts()
        {
            Path = path,
            Length = pathLength,
            End = end,
            RootLength = rootLength,
            SegmentStart = segmentStart,
            ExtensionStart = extensionStart,
            DirectoryLength = directoryLength,
            HasExtension = hasExtension,
            Absolute = absolute
        };
    }
}

