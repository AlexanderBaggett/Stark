internal unsafe inline fn System.Memory.MemoryStatus AppendJoinedPointerRangeDisjoint(
    mut borrow System.Text.OwnedAscii destination,
    u64[0 2 ** 63 - 1] count,
    rawptr<i8[min max]> data)
{
