            assume disjoint(destination, secondData)
            {
                assume disjoint(destination, thirdData)
                {
                    assume disjoint(destination, fourthData)
                    {
                        return TryJoinPointerRanges4(
                            destination,
                            firstCount,
                            firstData,
                            secondCount,
                            secondData,
                            thirdCount,
                            thirdData,
                            fourthCount,
                            fourthData);
                    }
                }
            }
        }
        }
}

