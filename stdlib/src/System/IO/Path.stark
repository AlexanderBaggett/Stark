                init destination.Bytes[destination.Bytes.Length] = DirectorySeparatorUnit();
            }
        }
    }

    if (copyLength == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    return AppendPointerRangeDisjoint(destination, copyLength, &data[start]);
