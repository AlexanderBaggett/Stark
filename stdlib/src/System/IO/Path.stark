import System.Memory
import System.Runtime.Platform
import System.Text
module System.IO.Path

internal finite law i8[min max] DirectorySeparatorUnit()
{
    unsafe
    {
        return *System.Text.AsciiData(DirectorySeparator());
    }
}

internal finite law bool IsDirectorySeparatorUnit(i8[min max] value)
{
    unsafe
    {
        stack i8[min max] separator = DirectorySeparatorUnit();
        if (value == separator)
        {
            return true;
        }

        stack ascii alternate = AlternateDirectorySeparator();
        if (System.Text.AsciiLength(alternate) <= 0)
        {
            return false;
        }

        return value == *System.Text.AsciiData(alternate);
    }
}

internal finite law bool IsDotUnit(i8[min max] value)
{
    return value == (i8[min max])46;
}

internal finite law bool IsColonUnit(i8[min max] value)
{
    return value == (i8[min max])58;
}

internal finite law i32[min max] AsciiUnitCode(i8[min max] value)
{
    if (value < 0)
    {
        return ((i32[min max])value) + 256;
    }

    return (i32[min max])value;
}

internal finite law bool IsAsciiDriveLetterUnit(i8[min max] value)
{
    stack i32[min max] unit = AsciiUnitCode(value);
    if (unit >= 65)
    {
        if (unit < 91)
        {
            return true;
        }
    }

    if (unit >= 97)
    {
        if (unit < 123)
        {
            return true;
        }
    }

    return false;
}

internal finite law bool HasWindowsRootRules()
{
    return System.Text.AsciiLength(AlternateDirectorySeparator()) > 0;
}

internal finite law bool IsAbsoluteFromRootLength(u64[0 2 ** 63 - 1] rootLength)
{
    if (rootLength == 0)
    {
        return false;
    }

    if (!HasWindowsRootRules())
    {
        return true;
    }

    return rootLength > 2;
}

internal unsafe finite law bool SegmentIsDot(
    rawptr<i8[min max]> data,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end)
{
    if (end - start != 1)
    {
        return false;
    }

    return IsDotUnit(*(&data[start]));
}

internal unsafe finite law bool SegmentIsDotDot(
    rawptr<i8[min max]> data,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end)
{
    if (end - start != 2)
    {
        return false;
    }

    if (!IsDotUnit(*(&data[start])))
    {
        return false;
    }

    return IsDotUnit(*(&data[start + 1]));
}

internal fn bool OwnedAsciiEndsWithDotDot(
    borrow System.Text.OwnedAscii value,
    u64[0 2 ** 63 - 1] rootLength)
{
    if (value.Bytes.Length < rootLength + 2)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] last =
        (u64[0 2 ** 63 - 1])(value.Bytes.Length - 1);
    stack u64[0 2 ** 63 - 1] previous =
        (u64[0 2 ** 63 - 1])(value.Bytes.Length - 2);
    stack i8[min max][] bytes = value.AsSlice();
    if (!IsDotUnit(bytes[previous]))
    {
        return false;
    }

    if (!IsDotUnit(bytes[last]))
    {
        return false;
    }

    if (previous == rootLength)
    {
        return true;
    }

    return IsDirectorySeparatorUnit(bytes[previous - (u64[0 2 ** 63 - 1])1]);
}

internal fn System.Memory.MemoryStatus AppendNormalizedSeparatorsCore(
    mut borrow System.Text.OwnedAscii destination,
    ascii source)
{
        unsafe
        {
        stack i64[min max] signedLength = System.Text.AsciiLength(source);
        if (signedLength < 0)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        stack u64[0 2 ** 63 - 1] pathLength = (u64[0 2 ** 63 - 1])signedLength;
        if (pathLength == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack rawptr<i8[min max]> data = System.Text.AsciiData(source);
        if (data == null)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        stack System.Memory.MemoryStatus reserveStatus = destination.Reserve(pathLength);
        switch (reserveStatus)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        stack mut bool previousWasSeparator = false;
        stack mut u64[0 2 ** 63 - 1] index = 0;
        while willexit (index < pathLength)
        {
            stack i8[min max] unit = *(&data[index]);
            if (IsDirectorySeparatorUnit(unit))
            {
                if (!previousWasSeparator)
                {
                    init destination.Bytes[destination.Bytes.Length] = DirectorySeparatorUnit();
                }

                previousWasSeparator = true;
            }
            else
            {
                init destination.Bytes[destination.Bytes.Length] = unit;
                previousWasSeparator = false;
            }

            index += 1;
        }

        return System.Memory.MemoryStatus.Ok;
        }
}

public struct PathFacts
{
    internal ascii Path;
    internal i64[min max] Length;
    internal i64[min max] End;
    internal i64[min max] RootLength;
    internal i64[min max] SegmentStart;
    internal i64[min max] ExtensionStart;
    internal i64[min max] DirectoryLength;
    internal bool HasExtension;
    internal bool Absolute;

    inline finite law i64[min max] PathLength(borrow PathFacts self)
    {
        return self.Length;
    }

    inline finite law i64[min max] ExtensionLength(borrow PathFacts self)
    {
        if (!self.HasExtension)
        {
            return 0;
        }

        return self.End - self.ExtensionStart;
    }

    inline finite law ascii Extension(borrow PathFacts self)
    {
        if (!self.HasExtension)
        {
            return "";
        }

        return self.Path[self.ExtensionStart, self.End - self.ExtensionStart];
    }

    inline finite law i64[min max] RootNameLength(borrow PathFacts self)
    {
        return self.RootLength;
    }

    inline finite law ascii RootName(borrow PathFacts self)
    {
        if (self.RootLength <= 0)
        {
            return "";
        }

        return self.Path[0, self.RootLength];
    }

    inline finite law bool IsRooted(borrow PathFacts self)
    {
        return self.RootLength > 0;
    }

    inline finite law bool HasExtension(borrow PathFacts self)
    {
        return self.HasExtension;
    }

    inline finite law bool IsAbsolute(borrow PathFacts self)
    {
        return self.Absolute;
    }

    inline finite law bool IsRelative(borrow PathFacts self)
    {
        return self.RootLength <= 0;
    }

    inline finite law i64[min max] BaseNameLength(borrow PathFacts self)
    {
        if (self.SegmentStart >= self.End)
        {
            return 0;
        }

        if (self.HasExtension)
        {
            return self.ExtensionStart - self.SegmentStart;
        }

        return self.End - self.SegmentStart;
    }

    inline finite law ascii BaseName(borrow PathFacts self)
    {
        if (self.SegmentStart >= self.End)
        {
            return "";
        }

        if (self.HasExtension)
        {
            return self.Path[self.SegmentStart, self.ExtensionStart - self.SegmentStart];
        }

        return self.Path[self.SegmentStart, self.End - self.SegmentStart];
    }

    inline finite law i64[min max] DirectoryNameLength(borrow PathFacts self)
    {
        return self.DirectoryLength;
    }

    inline finite law ascii DirectoryName(borrow PathFacts self)
    {
        if (self.DirectoryLength <= 0)
        {
            return "";
        }

        return self.Path[0, self.DirectoryLength];
    }
}

internal finite law PathFacts EmptyPathFacts()
{
    return new PathFacts()
    {
        Path = "",
        Length = 0,
        End = 0,
        RootLength = 0,
        SegmentStart = 0,
        ExtensionStart = 0,
        DirectoryLength = 0,
        HasExtension = false,
        Absolute = false
    };
}

public finite law ascii DirectorySeparator()
{
    return System.Runtime.Platform.DirectorySeparator();
}

public finite law ascii AlternateDirectorySeparator()
{
    return System.Runtime.Platform.AlternateDirectorySeparator();
}

public finite law ascii PathSeparator()
{
    return System.Runtime.Platform.PathSeparator();
}

public fn System.Memory.MemoryStatus CurrentDirectory(mut borrow System.Text.OwnedAscii destination)
{
    unsafe
    {
        stack mut i8[min max][4096] storage;
        stack mut Ascii path = new Ascii()
        {
            Data = &storage[0],
            Length = 0,
            Capacity = 4096
        };

        if (!System.Runtime.Platform.TryCurrentDirectory(&path))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        return destination.AppendAscii(System.Text.AsciiView(path));
    }
}

public fn System.Memory.MemoryResult<System.Text.OwnedAscii> CurrentDirectory()
{
    stack mut System.Text.OwnedAscii destination = new();
    stack System.Memory.MemoryStatus status = CurrentDirectory(destination);
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(destination);
    }
}

public fn System.Memory.MemoryStatus TempDirectory(mut borrow System.Text.OwnedAscii destination)
{
    unsafe
    {
        stack mut i8[min max][4096] storage;
        stack mut Ascii path = new Ascii()
        {
            Data = &storage[0],
            Length = 0,
            Capacity = 4096
        };

        if (!System.Runtime.Platform.TryTempDirectory(&path))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        return destination.AppendAscii(System.Text.AsciiView(path));
    }
}

public fn System.Memory.MemoryResult<System.Text.OwnedAscii> TempDirectory()
{
    stack mut System.Text.OwnedAscii destination = new();
    stack System.Memory.MemoryStatus status = TempDirectory(destination);
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(destination);
    }
}

public finite law ascii ParentDirectory()
{
    return "..";
}

internal finite law bool IsGlobStarUnit(i8[min max] value)
{
    return value == (i8[min max])42;
}

internal finite law bool IsGlobQuestionUnit(i8[min max] value)
{
    return value == (i8[min max])63;
}

internal unsafe finite law i64[min max] SkipGlobSeparators(
    rawptr<i8[min max]> data,
    i64[min max] start,
    i64[min max] length)
{
    stack mut i64[min max] index = start;
    while willexit (index < length)
    {
        if (!IsDirectorySeparatorUnit(*(&data[index])))
        {
            return index;
        }

        index += 1;
    }

    return index;
}

internal unsafe finite law i64[min max] NextGlobSegmentEnd(
    rawptr<i8[min max]> data,
    i64[min max] start,
    i64[min max] length)
{
    stack mut i64[min max] index = start;
    while willexit (index < length)
    {
        if (IsDirectorySeparatorUnit(*(&data[index])))
        {
            return index;
        }

        index += 1;
    }

    return index;
}

internal unsafe finite law i64[min max] AdvanceGlobPathSegment(
    rawptr<i8[min max]> data,
    i64[min max] start,
    i64[min max] length)
{
    if (start >= length)
    {
        return length;
    }

    stack i64[min max] segmentEnd = NextGlobSegmentEnd(data, start, length);
    return SkipGlobSeparators(data, segmentEnd, length);
}

internal unsafe finite law bool GlobSegmentIsDoubleStar(
    rawptr<i8[min max]> data,
    i64[min max] start,
    i64[min max] end)
{
    if (end - start != 2)
    {
        return false;
    }

    if (!IsGlobStarUnit(*(&data[start])))
    {
        return false;
    }

    return IsGlobStarUnit(*(&data[start + 1]));
}

internal unsafe finite law bool GlobSegmentsMatch(
    rawptr<i8[min max]> patternData,
    i64[min max] patternStart,
    i64[min max] patternEnd,
    rawptr<i8[min max]> pathData,
    i64[min max] pathStart,
    i64[min max] pathEnd)
    where overlap(patternData, pathData)
{
    stack mut i64[min max] patternIndex = patternStart;
    stack mut i64[min max] pathIndex = pathStart;
    stack mut i64[min max] starIndex = -1;
    stack mut i64[min max] starPathIndex = pathStart;

    while willexit (pathIndex < pathEnd)
    {
        if (patternIndex < patternEnd)
        {
            stack i8[min max] patternUnit = *(&patternData[patternIndex]);
            stack i8[min max] pathUnit = *(&pathData[pathIndex]);
            if (IsGlobQuestionUnit(patternUnit) || patternUnit == pathUnit)
            {
                patternIndex += 1;
                pathIndex += 1;
                continue;
            }

            if (IsGlobStarUnit(patternUnit))
            {
                starIndex = patternIndex;
                starPathIndex = pathIndex;
                patternIndex += 1;
                continue;
            }
        }

        if (starIndex >= 0)
        {
            starPathIndex += 1;
            pathIndex = starPathIndex;
            patternIndex = starIndex + 1;
            continue;
        }

        return false;
    }

    while willexit (patternIndex < patternEnd)
    {
        if (!IsGlobStarUnit(*(&patternData[patternIndex])))
        {
            return false;
        }

        patternIndex += 1;
    }

    return true;
}

public finite law bool GlobMatches(ascii pattern, ascii path)
    where overlap(pattern, path)
{
    unsafe
    {
        stack i64[min max] patternLength = System.Text.AsciiLength(pattern);
        stack i64[min max] pathLength = System.Text.AsciiLength(path);
        if (patternLength < 0 || pathLength < 0)
        {
            return false;
        }

        stack rawptr<i8[min max]> patternData = System.Text.AsciiData(pattern);
        stack rawptr<i8[min max]> pathData = System.Text.AsciiData(path);
        if ((patternLength > 0 && patternData == null) || (pathLength > 0 && pathData == null))
        {
            return false;
        }

        stack mut i64[min max] patternIndex = 0;
        stack mut i64[min max] pathIndex = 0;
        stack mut i64[min max] globstarPatternIndex = -1;
        stack mut i64[min max] globstarPathIndex = -1;

        while willexit (true)
        {
            patternIndex = SkipGlobSeparators(patternData, patternIndex, patternLength);
            pathIndex = SkipGlobSeparators(pathData, pathIndex, pathLength);

            if (patternIndex >= patternLength)
            {
                if (pathIndex >= pathLength)
                {
                    return true;
                }

                if (globstarPatternIndex >= 0 && globstarPathIndex < pathLength)
                {
                    stack i64[min max] nextPathIndex =
                        AdvanceGlobPathSegment(pathData, globstarPathIndex, pathLength);
                    if (nextPathIndex == globstarPathIndex)
                    {
                        return false;
                    }

                    globstarPathIndex = nextPathIndex;
                    patternIndex = globstarPatternIndex;
                    pathIndex = globstarPathIndex;
                    continue;
                }

                return false;
            }

            stack i64[min max] patternSegmentEnd =
                NextGlobSegmentEnd(patternData, patternIndex, patternLength);
            if (GlobSegmentIsDoubleStar(patternData, patternIndex, patternSegmentEnd))
            {
                stack i64[min max] nextPatternIndex =
                    SkipGlobSeparators(patternData, patternSegmentEnd, patternLength);
                if (nextPatternIndex >= patternLength)
                {
                    return true;
                }

                globstarPatternIndex = nextPatternIndex;
                globstarPathIndex = pathIndex;
                patternIndex = nextPatternIndex;
                continue;
            }

            stack mut i64[min max] pathSegmentEnd = pathIndex;
            if (pathIndex < pathLength)
            {
                pathSegmentEnd = NextGlobSegmentEnd(pathData, pathIndex, pathLength);
            }

            if (GlobSegmentsMatch(
                patternData,
                patternIndex,
                patternSegmentEnd,
                pathData,
                pathIndex,
                pathSegmentEnd))
            {
                patternIndex = patternSegmentEnd;
                pathIndex = pathSegmentEnd;
                continue;
            }

            if (globstarPatternIndex >= 0 && globstarPathIndex < pathLength)
            {
                stack i64[min max] nextGlobstarPathIndex =
                    AdvanceGlobPathSegment(pathData, globstarPathIndex, pathLength);
                if (nextGlobstarPathIndex == globstarPathIndex)
                {
                    return false;
                }

                globstarPathIndex = nextGlobstarPathIndex;
                patternIndex = globstarPatternIndex;
                pathIndex = globstarPathIndex;
                continue;
            }

            return false;
        }

        return false;
    }
}

public fn System.Memory.MemoryStatus TryTempName(
    mut borrow System.Text.OwnedAscii destination,
    ascii prefix,
    u64[0 max] attempt,
    ascii suffix)
    where overlap(destination, prefix),
          overlap(destination, suffix),
          overlap(prefix, suffix)
{
    stack mut ascii effectivePrefix = prefix;
    if (System.Text.AsciiLength(effectivePrefix) == 0)
    {
        effectivePrefix = "stark-";
    }

    stack mut ascii sourcePrefix = effectivePrefix;
    stack mut ascii sourceSuffix = suffix;
    stack mut System.Text.OwnedAscii prefixSnapshot = new();
    stack mut System.Text.OwnedAscii suffixSnapshot = new();

    unsafe
    {
        if (destination.Bytes.Length > 0)
        {
            if disjoint(effectivePrefix, destination.Bytes[0, destination.Bytes.Length])
            {
            }
            else
            {
                stack System.Memory.MemoryStatus prefixSnapshotStatus = prefixSnapshot.AppendAscii(effectivePrefix);
                switch (prefixSnapshotStatus)
                {
                    case System.Memory.MemoryStatus.Err(var prefixSnapshotError):
                        return System.Memory.MemoryStatus.Err(prefixSnapshotError);
                    case System.Memory.MemoryStatus.Ok:
                        sourcePrefix = prefixSnapshot.View();
                }
            }

            if disjoint(suffix, destination.Bytes[0, destination.Bytes.Length])
            {
            }
            else
            {
                stack System.Memory.MemoryStatus suffixSnapshotStatus = suffixSnapshot.AppendAscii(suffix);
                switch (suffixSnapshotStatus)
                {
                    case System.Memory.MemoryStatus.Err(var suffixSnapshotError):
                        return System.Memory.MemoryStatus.Err(suffixSnapshotError);
                    case System.Memory.MemoryStatus.Ok:
                        sourceSuffix = suffixSnapshot.View();
                }
            }
        }
    }

    stack i64[min max] prefixLength = System.Text.AsciiLength(sourcePrefix);
    stack i64[min max] suffixLength = System.Text.AsciiLength(sourceSuffix);
    if (prefixLength < 0 || suffixLength < 0)
    {
        destination.Clear();
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
    }

    stack mut u64[0 2 ** 63 - 1] required = (u64[0 2 ** 63 - 1])prefixLength;
    if (required > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) - 32)
    {
        destination.Clear();
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    required += 32;
    stack u64[0 2 ** 63 - 1] suffixCount = (u64[0 2 ** 63 - 1])suffixLength;
    if (suffixCount > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) - required)
    {
        destination.Clear();
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    required += suffixCount;
    destination.Clear();
    stack System.Memory.MemoryStatus reserveStatus = destination.Reserve(required);
    switch (reserveStatus)
    {
        case System.Memory.MemoryStatus.Err(var reserveError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(reserveError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus prefixStatus = destination.AppendAscii(sourcePrefix);
    switch (prefixStatus)
    {
        case System.Memory.MemoryStatus.Err(var prefixError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(prefixError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus processStatus =
        destination.AppendI64((i64[min max])System.Runtime.Platform.ProcessId());
    switch (processStatus)
    {
        case System.Memory.MemoryStatus.Err(var processError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(processError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus separatorStatus = destination.AppendByte((i8[min max])45);
    switch (separatorStatus)
    {
        case System.Memory.MemoryStatus.Err(var separatorError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(separatorError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus attemptStatus = destination.AppendU64(attempt);
    switch (attemptStatus)
    {
        case System.Memory.MemoryStatus.Err(var attemptError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(attemptError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus suffixStatus = destination.AppendAscii(sourceSuffix);
    switch (suffixStatus)
    {
        case System.Memory.MemoryStatus.Err(var suffixError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(suffixError);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryStatus.Ok;
    }
}

public fn System.Memory.MemoryResult<System.Text.OwnedAscii> TempName(
    ascii prefix,
    u64[0 max] attempt,
    ascii suffix)
    where overlap(prefix, suffix)
{
    stack mut System.Text.OwnedAscii destination = new();
    stack System.Memory.MemoryStatus status = TryTempName(destination, prefix, attempt, suffix);
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(destination);
    }
}

public fn System.Memory.MemoryStatus TryTempPathIn(
    mut borrow System.Text.OwnedAscii destination,
    ascii parent,
    ascii prefix,
    u64[0 max] attempt,
    ascii suffix)
    where overlap(destination, parent),
          overlap(destination, prefix),
          overlap(destination, suffix),
          overlap(parent, prefix),
          overlap(parent, suffix),
          overlap(prefix, suffix)
{
    stack mut System.Text.OwnedAscii name = new();
    stack System.Memory.MemoryStatus nameStatus = TryTempName(name, prefix, attempt, suffix);
    switch (nameStatus)
    {
        case System.Memory.MemoryStatus.Err(var nameError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(nameError);
        case System.Memory.MemoryStatus.Ok:
    }

    return TryJoin(destination, parent, name.View());
}

public fn System.Memory.MemoryResult<System.Text.OwnedAscii> TempPathIn(
    ascii parent,
    ascii prefix,
    u64[0 max] attempt,
    ascii suffix)
    where overlap(parent, prefix),
          overlap(parent, suffix),
          overlap(prefix, suffix)
{
    stack mut System.Text.OwnedAscii destination = new();
    stack System.Memory.MemoryStatus status = TryTempPathIn(destination, parent, prefix, attempt, suffix);
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(destination);
    }
}

internal unsafe fn System.Memory.MemoryStatus TryJoinPointerRanges(
    mut borrow System.Text.OwnedAscii destination,
    u64[0 2 ** 63 - 1] leftCount,
    rawptr<i8[min max]> leftData,
    u64[0 2 ** 63 - 1] rightCount,
    rawptr<i8[min max]> rightData)
    where overlap(leftData, rightData)
{
    stack mut u64[0 2 ** 63 - 1] rightStart = 0;
    stack mut u64[0 2 ** 63 - 1] rightCopyLength = rightCount;
    stack mut bool needsSeparator = false;

    if (leftCount > 0 && rightCount > 0)
    {
        stack bool leftEndsWithSeparator = IsDirectorySeparatorUnit(*(&leftData[(u64[0 2 ** 63 - 1])(leftCount - 1)]));
        stack bool rightStartsWithSeparator = IsDirectorySeparatorUnit(*rightData);
        if (leftEndsWithSeparator && rightStartsWithSeparator)
        {
            rightStart = 1;
            rightCopyLength -= 1;
        }
        else
        {
            if (!leftEndsWithSeparator && !rightStartsWithSeparator)
            {
                needsSeparator = true;
            }
        }
    }

    stack mut u64[0 2 ** 63 - 1] required = leftCount;
    if (rightCopyLength > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) - required)
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    required += rightCopyLength;
    if (needsSeparator)
    {
        if (required == (u64[0 2 ** 63 - 1])(2 ** 63 - 1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
        }

        required += 1;
    }

    if ((leftCount > 0 && leftData == null) || (rightCopyLength > 0 && rightData == null))
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
    }

    destination.Clear();

    stack System.Memory.MemoryStatus reserveStatus = destination.Reserve(required);
