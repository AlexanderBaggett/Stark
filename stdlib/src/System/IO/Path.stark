internal unsafe fn System.Memory.MemoryStatus TryChangeExtensionPointerRanges(
    mut borrow System.Text.OwnedAscii destination,
    u64[0 2 ** 63 - 1] prefixCount,
    rawptr<i8[min max]> pathData,
    u64[0 2 ** 63 - 1] extensionCount,
    rawptr<i8[min max]> extensionData)
    where overlap(pathData, extensionData)
{
    if (prefixCount > 0)
    {
        if (pathData == null)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }
    }

    if (extensionCount > 0)
    {
        if (extensionData == null)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }
    }

    stack mut u64[0 2 ** 63 - 1] required = prefixCount;
    if (extensionCount > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) - required)
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    required += extensionCount;
    stack mut bool needsDot = false;
    if (extensionCount > 0)
    {
        if (!IsDotUnit(*extensionData))
        {
            needsDot = true;
        }
    }
    if (needsDot)
    {
        if (required == (u64[0 2 ** 63 - 1])(2 ** 63 - 1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
        }

        required += 1;
    }

    destination.Clear();
    stack System.Memory.MemoryStatus reserveStatus = destination.Reserve(required);
    switch (reserveStatus)
    {
        case System.Memory.MemoryStatus.Err(var reserveError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(reserveError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus prefixStatus = AppendPointerRangeDisjoint(destination, prefixCount, pathData);
    switch (prefixStatus)
    {
        case System.Memory.MemoryStatus.Err(var prefixError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(prefixError);
        case System.Memory.MemoryStatus.Ok:
    }

    if (needsDot)
    {
        init destination.Bytes[destination.Bytes.Length] = (i8[min max])46;
    }

    stack System.Memory.MemoryStatus extensionStatus =
        AppendPointerRangeDisjoint(destination, extensionCount, extensionData);
    switch (extensionStatus)
    {
        case System.Memory.MemoryStatus.Err(var extensionError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(extensionError);
        case System.Memory.MemoryStatus.Ok:
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus TryChangeExtension(
    mut borrow System.Text.OwnedAscii destination,
    ascii path,
    ascii extension)
    where overlap(destination, path),
          overlap(destination, extension),
          overlap(path, extension)
{
        unsafe
        {
        stack PathFacts facts = GetFacts(path);
        stack i64[min max] extensionLength = System.Text.AsciiLength(extension);
        if (facts.Length < 0 || extensionLength < 0)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        stack mut u64[0 2 ** 63 - 1] prefixCount = (u64[0 2 ** 63 - 1])facts.End;
        if (facts.HasExtension)
        {
            prefixCount = (u64[0 2 ** 63 - 1])facts.ExtensionStart;
        }

        stack u64[0 2 ** 63 - 1] extensionCount = (u64[0 2 ** 63 - 1])extensionLength;
        stack mut rawptr<i8[min max]> pathData = System.Text.AsciiData(path);
        stack mut rawptr<i8[min max]> extensionData = System.Text.AsciiData(extension);
        if (prefixCount > 0)
        {
            if (pathData == null)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }
        }

        if (extensionCount > 0)
        {
            if (extensionData == null)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }
        }

        stack mut System.Text.OwnedAscii pathSnapshot = new();
        stack mut System.Text.OwnedAscii extensionSnapshot = new();
        if (destination.Bytes.Length > 0)
        {
            if disjoint(path, destination.Bytes[0, destination.Bytes.Length])
            {
            }
            else
            {
                stack System.Memory.MemoryStatus pathSnapshotStatus = pathSnapshot.AppendAscii(path);
                switch (pathSnapshotStatus)
                {
                    case System.Memory.MemoryStatus.Err(var pathSnapshotError):
                        return System.Memory.MemoryStatus.Err(pathSnapshotError);
                    case System.Memory.MemoryStatus.Ok:
                }

                pathData = System.Text.AsciiData(pathSnapshot.View());
            }

            if disjoint(extension, destination.Bytes[0, destination.Bytes.Length])
            {
            }
            else
            {
                stack System.Memory.MemoryStatus extensionSnapshotStatus = extensionSnapshot.AppendAscii(extension);
                switch (extensionSnapshotStatus)
                {
                    case System.Memory.MemoryStatus.Err(var extensionSnapshotError):
                        return System.Memory.MemoryStatus.Err(extensionSnapshotError);
                    case System.Memory.MemoryStatus.Ok:
                }

                extensionData = System.Text.AsciiData(extensionSnapshot.View());
            }
        }

        assume disjoint(destination, pathData)
        {
            assume disjoint(destination, extensionData)
            {
                return TryChangeExtensionPointerRanges(
                    destination,
                    prefixCount,
                    pathData,
                    extensionCount,
                    extensionData);
            }
        }
        }
}

