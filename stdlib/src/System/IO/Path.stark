internal unsafe fn System.Memory.MemoryStatus AppendLexicalRoot(
    mut borrow System.Text.OwnedAscii destination,
    rawptr<i8[min max]> data,
    u64[0 2 ** 63 - 1] rootLength)
{
    if (rootLength < 1)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    if (data == null)
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
    }

    stack bool windowsRoots = HasWindowsRootRules();
    if (windowsRoots)
    {
        if (rootLength >= 2)
        {
            if (IsAsciiDriveLetterUnit(*data))
            {
                if (IsColonUnit(*(&data[1])))
                {
                    stack System.Memory.MemoryStatus driveStatus =
                        AppendPointerRangeDisjoint(destination, 2, data);
                    switch (driveStatus)
                    {
                        case System.Memory.MemoryStatus.Err(var driveError):
                            return System.Memory.MemoryStatus.Err(driveError);
                        case System.Memory.MemoryStatus.Ok:
                    }

                    if (rootLength > 2)
                    {
                        init destination.Bytes[destination.Bytes.Length] = DirectorySeparatorUnit();
                    }

                    return System.Memory.MemoryStatus.Ok;
                }
            }
        }
    }

    stack mut bool isUncRoot = false;
    if (windowsRoots)
    {
        if (rootLength > 1)
        {
            if (IsDirectorySeparatorUnit(*data))
            {
                if (IsDirectorySeparatorUnit(*(&data[1])))
                {
                    isUncRoot = true;
                }
            }
        }
    }

    if (isUncRoot)
    {
        init destination.Bytes[destination.Bytes.Length] = DirectorySeparatorUnit();
        init destination.Bytes[destination.Bytes.Length] = DirectorySeparatorUnit();
        stack mut bool previousWasSeparator = true;
        stack mut u64[0 2 ** 63 - 1] index = 2;
        while willexit (index < rootLength)
        {
            stack i8[min max] unit = *(&data[index]);
            if (IsDirectorySeparatorUnit(unit))
            {
                if (!previousWasSeparator)
                {
                    init destination.Bytes[destination.Bytes.Length] = DirectorySeparatorUnit();
                }

                previousWasSeparator = true;
            }
            else
            {
                init destination.Bytes[destination.Bytes.Length] = unit;
                previousWasSeparator = false;
            }

            index += 1;
        }

        return System.Memory.MemoryStatus.Ok;
    }

    init destination.Bytes[destination.Bytes.Length] = DirectorySeparatorUnit();
    return System.Memory.MemoryStatus.Ok;
}

internal fn bool TryPopLastLexicalSegment(
    mut borrow System.Text.OwnedAscii destination,
    u64[0 2 ** 63 - 1] rootLength)
{
    if (destination.Bytes.Length < rootLength + (u64[0 2 ** 63 - 1])1)
    {
        return false;
    }

    if (rootLength == 0)
    {
        if (OwnedAsciiEndsWithDotDot(destination, rootLength))
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] start = destination.Bytes.Length;
    stack i8[min max][] bytes = destination.AsSlice();
    while willexit (start > rootLength)
    {
        if (IsDirectorySeparatorUnit(bytes[start - (u64[0 2 ** 63 - 1])1]))
        {
            break;
        }

        start -= 1;
    }

    if (start > rootLength)
    {
        destination.Truncate(start - (u64[0 2 ** 63 - 1])1);
    }
    else
    {
        destination.Truncate(rootLength);
    }

    return true;
}

internal unsafe fn System.Memory.MemoryStatus TryNormalizeLexicallyPointerRange(
    mut borrow System.Text.OwnedAscii destination,
    u64[0 2 ** 63 - 1] count,
    rawptr<i8[min max]> data,
    u64[0 2 ** 63 - 1] rootLength)
{
    if (count > 0)
    {
        if (data == null)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }
    }

    destination.Clear();
    if (count == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack System.Memory.MemoryStatus reserveStatus = destination.Reserve(count);
    switch (reserveStatus)
    {
        case System.Memory.MemoryStatus.Err(var reserveError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(reserveError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus rootStatus = AppendLexicalRoot(destination, data, rootLength);
    switch (rootStatus)
    {
        case System.Memory.MemoryStatus.Err(var rootError):
            destination.Clear();
            return System.Memory.MemoryStatus.Err(rootError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] normalizedRootLength = destination.Bytes.Length;
    stack mut u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])rootLength;
    while willexit (index < count)
    {
        while willexit (index < count)
        {
            if (!IsDirectorySeparatorUnit(*(&data[index])))
            {
                break;
            }

            index += 1;
        }

        stack u64[0 2 ** 63 - 1] segmentStart = index;
        while willexit (index < count)
        {
            if (IsDirectorySeparatorUnit(*(&data[index])))
            {
                break;
            }

            index += 1;
        }

        stack u64[0 2 ** 63 - 1] segmentEnd = index;
        stack mut bool skipSegment = false;
        if (segmentEnd == segmentStart)
        {
            skipSegment = true;
        }
        else
        {
            if (SegmentIsDot(data, segmentStart, segmentEnd))
            {
                skipSegment = true;
            }
        }

        if (skipSegment)
        {
        }
        else
        {
            if (SegmentIsDotDot(data, segmentStart, segmentEnd))
            {
                if (!TryPopLastLexicalSegment(destination, normalizedRootLength))
                {
                    if (normalizedRootLength == 0)
                    {
                        stack System.Memory.MemoryStatus parentStatus =
                            AppendJoinedPointerRangeDisjoint(destination, 2, &data[segmentStart]);
                        switch (parentStatus)
                        {
                            case System.Memory.MemoryStatus.Err(var parentError):
                                destination.Clear();
                                return System.Memory.MemoryStatus.Err(parentError);
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }
                }
            }
            else
            {
                stack u64[0 2 ** 63 - 1] segmentLength = segmentEnd - segmentStart;
                stack System.Memory.MemoryStatus segmentStatus =
                    AppendJoinedPointerRangeDisjoint(destination, segmentLength, &data[segmentStart]);
                switch (segmentStatus)
                {
                    case System.Memory.MemoryStatus.Err(var segmentError):
                        destination.Clear();
                        return System.Memory.MemoryStatus.Err(segmentError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus TryNormalizeLexically(
    mut borrow System.Text.OwnedAscii destination,
    ascii path)
    where overlap(destination, path)
{
        unsafe
        {
        stack i64[min max] pathLength = System.Text.AsciiLength(path);
        if (pathLength < 0)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        stack u64[0 2 ** 63 - 1] count = (u64[0 2 ** 63 - 1])pathLength;
        stack mut rawptr<i8[min max]> data = System.Text.AsciiData(path);
        if (count > 0)
        {
            if (data == null)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }
        }

        stack mut System.Text.OwnedAscii snapshot = new();
        if (destination.Bytes.Length > 0)
        {
            if disjoint(path, destination.Bytes[0, destination.Bytes.Length])
            {
            }
            else
            {
                stack System.Memory.MemoryStatus snapshotStatus = snapshot.AppendAscii(path);
                switch (snapshotStatus)
                {
                    case System.Memory.MemoryStatus.Err(var snapshotError):
                        return System.Memory.MemoryStatus.Err(snapshotError);
                    case System.Memory.MemoryStatus.Ok:
                }

                data = System.Text.AsciiData(snapshot.View());
            }
        }

        assume disjoint(destination, data)
        {
            stack PathFacts facts = GetFacts(path);
            return TryNormalizeLexicallyPointerRange(
                destination,
                count,
                data,
                (u64[0 2 ** 63 - 1])facts.RootLength);
        }
        }
}

public fn System.Memory.MemoryStatus TryNormalizeLexicallyConst(
    mut borrow System.Text.OwnedAscii destination,
    const ascii path)
{
        unsafe
        {
        stack i64[min max] pathLength = System.Text.AsciiLength(path);
        if (pathLength < 0)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        stack u64[0 2 ** 63 - 1] count = (u64[0 2 ** 63 - 1])pathLength;
        stack rawptr<i8[min max]> data = System.Text.AsciiData(path);
        if (count > 0)
        {
            if (data == null)
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }
        }

        assume disjoint(destination, data)
        {
            stack PathFacts facts = GetConstFacts(path);
            return TryNormalizeLexicallyPointerRange(
                destination,
                count,
                data,
                (u64[0 2 ** 63 - 1])facts.RootLength);
        }
        }
}

public fn System.Memory.MemoryResult<System.Text.OwnedAscii> NormalizeLexically(ascii path)
{
    stack mut System.Text.OwnedAscii destination = new();
    stack System.Memory.MemoryStatus status = TryNormalizeLexically(destination, path);
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(destination);
    }
}

public fn System.Memory.MemoryResult<System.Text.OwnedAscii> NormalizeLexicallyConst(const ascii path)
{
    stack mut System.Text.OwnedAscii destination = new();
    stack System.Memory.MemoryStatus status = TryNormalizeLexicallyConst(destination, path);
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(destination);
    }
}

public fn System.Memory.MemoryStatus TryFullPath(
    mut borrow System.Text.OwnedAscii destination,
    ascii path)
    where overlap(destination, path)
{
    if (IsAbsolute(path))
    {
        return TryNormalizeLexically(destination, path);
    }

    stack mut System.Text.OwnedAscii current = new();
    stack System.Memory.MemoryStatus currentStatus = CurrentDirectory(current);
    switch (currentStatus)
    {
        case System.Memory.MemoryStatus.Err(var currentError):
            return System.Memory.MemoryStatus.Err(currentError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut System.Text.OwnedAscii joined = new();
    stack System.Memory.MemoryStatus joinStatus = TryJoin(joined, current.View(), path);
    switch (joinStatus)
    {
        case System.Memory.MemoryStatus.Err(var joinError):
            return System.Memory.MemoryStatus.Err(joinError);
        case System.Memory.MemoryStatus.Ok:
    }

    return TryNormalizeLexically(destination, joined.View());
}

public fn System.Memory.MemoryStatus TryFullPathConst(
    mut borrow System.Text.OwnedAscii destination,
    const ascii path)
{
    if (IsAbsoluteConst(path))
    {
        return TryNormalizeLexicallyConst(destination, path);
    }

    stack mut System.Text.OwnedAscii current = new();
    stack System.Memory.MemoryStatus currentStatus = CurrentDirectory(current);
    switch (currentStatus)
    {
        case System.Memory.MemoryStatus.Err(var currentError):
            return System.Memory.MemoryStatus.Err(currentError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut System.Text.OwnedAscii joined = new();
    stack System.Memory.MemoryStatus joinStatus = TryJoin(joined, current.View(), path);
    switch (joinStatus)
    {
        case System.Memory.MemoryStatus.Err(var joinError):
            return System.Memory.MemoryStatus.Err(joinError);
        case System.Memory.MemoryStatus.Ok:
    }

    return TryNormalizeLexically(destination, joined.View());
}

public fn System.Memory.MemoryResult<System.Text.OwnedAscii> FullPath(ascii path)
{
    stack mut System.Text.OwnedAscii destination = new();
    stack System.Memory.MemoryStatus status = TryFullPath(destination, path);
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(destination);
    }
}

public fn System.Memory.MemoryResult<System.Text.OwnedAscii> FullPathConst(const ascii path)
{
    stack mut System.Text.OwnedAscii destination = new();
    stack System.Memory.MemoryStatus status = TryFullPathConst(destination, path);
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryResult<System.Text.OwnedAscii>.Ok(destination);
    }
}
