    }

    if (data == null)
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
    }

    stack mut u64[0 2 ** 63 - 1] start = 0;
    stack mut u64[0 2 ** 63 - 1] copyLength = count;
    if (destination.Bytes.Length > 0)
    {
        stack i8[min max][] bytes = destination.AsSlice();
        stack bool leftEndsWithSeparator =
            IsDirectorySeparatorUnit(bytes[(u64[0 2 ** 63 - 1])(destination.Bytes.Length - 1)]);
        stack bool rightStartsWithSeparator = IsDirectorySeparatorUnit(*data);
        if (leftEndsWithSeparator && rightStartsWithSeparator)
        {
            start = 1;
            copyLength -= 1;
        }
        else
        {
            if (!leftEndsWithSeparator && !rightStartsWithSeparator)
