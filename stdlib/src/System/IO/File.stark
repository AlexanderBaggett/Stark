internal unsafe fn rawptr<i8[min max]> OpenRead(ascii path)
{
    return System.Runtime.Platform.OpenFileRead(path);
}

internal unsafe fn rawptr<i8[min max]> OpenWrite(ascii path)
{
    return System.Runtime.Platform.OpenFileWrite(path);
}

internal unsafe fn rawptr<i8[min max]> OpenCreateNew(ascii path)
{
    return System.Runtime.Platform.OpenFileCreateNew(path);
}

internal unsafe fn rawptr<i8[min max]> OpenAppend(ascii path)
{
    return System.Runtime.Platform.OpenFileAppend(path);
}

internal unsafe fn i32[min max] Close(rawptr<i8[min max]> handle)
{
    return System.Runtime.Platform.CloseFile(handle);
}

internal unsafe fn i32[min max] Flush(rawptr<i8[min max]> handle)
{
    if (handle == null)
    {
        return 0;
    }

    return 0;
}

internal unsafe fn i32[min max] SyncAll(rawptr<i8[min max]> handle)
{
    return System.Runtime.Platform.FlushFile(handle);
}

internal unsafe fn i64[min max] ReadBytes(rawmutptr<i8[min max]> buffer, i64[min max] size, i64[min max] count, rawptr<i8[min max]> handle)
{
    return System.Runtime.Platform.ReadFile(buffer, size, count, handle);
}

internal unsafe fn i64[min max] WriteBytes(rawptr<i8[min max]> buffer, i64[min max] size, i64[min max] count, rawptr<i8[min max]> handle)
{
    return System.Runtime.Platform.WriteFile(buffer, size, count, handle);
}

internal unsafe fn i64[min max] Seek(rawptr<i8[min max]> handle, i64[min max] offset, SeekOrigin origin)
{
    return System.Runtime.Platform.SeekFile(handle, offset, SeekOriginCode(origin));
}

internal unsafe fn void WriteText(rawptr<i8[min max]> handle, ascii text)
{
    System.Runtime.Platform.WriteAscii(handle, text);
    return;
}

internal unsafe fn void WriteText(rawptr<i8[min max]> handle, unicode text)
{
    System.Runtime.Platform.WriteUnicode(handle, text);
    return;
}

internal unsafe fn void WriteLine(rawptr<i8[min max]> handle, ascii text)
{
    WriteAsciiLineHandle(handle, text);
    return;
}

internal unsafe fn void WriteLine(rawptr<i8[min max]> handle, unicode text)
{
    WriteUnicodeLineHandle(handle, text);
    return;
}

public fn System.IO.IOStatus Delete(ascii path)
{
    return StatusFromPlatformResult(System.Runtime.Platform.DeleteFile(path));
}

public fn System.IO.IOStatus Move(ascii oldPath, ascii newPath)
{
    return StatusFromPlatformResult(System.Runtime.Platform.MoveFile(oldPath, newPath));
}

public fn System.IO.IOResult<bool> Exists(ascii path)
{
    return System.IO.IOResult<bool>.Ok(System.Runtime.Platform.FileExists(path));
}
