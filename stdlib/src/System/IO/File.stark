    where disjoint(destination, source)
    in("a0") destination,
    in("a1") source,
    in("a2") length,
    clobber("t0", "t1", "t2", "t3", "t4"),
    memory(read(source), write(destination))
{
    "beq a2, zero, 2f\nli t0, 0\n1:\nadd t1, a1, t0\nlbu t2, 0(t1)\nadd t3, a0, t0\nsb t2, 0(t3)\naddi t0, t0, 1\nsub t4, a2, t0\nbne t4, zero, 1b\n2:"
}

internal unsafe ffi asm(x86) fn void CopyAsciiBytes(rawmutptr<i8[min max]>[length] destination, rawptr<i8[min max]>[length] source, u32[0 max] length)
    where disjoint(destination, source)
    in("eax") destination,
