internal fn System.IO.IOStatus AppendAtomicTempFileCandidate(
    mut borrow System.Text.OwnedAscii destination,
    ascii targetPath,
    i32[min max] processId,
    u16[0 1024] attempt)
{
    destination.Clear();
    stack System.IO.Path.PathFacts facts = System.IO.Path.GetFacts(targetPath);
    stack ascii directory = facts.DirectoryName();
    stack ascii baseName = facts.BaseName();

    stack mut System.Text.OwnedAscii name = new();
    stack System.Memory.MemoryStatus dotStatus = name.AppendByte((i8[min max])46);
    switch (dotStatus)
    {
        case System.Memory.MemoryStatus.Err(var dotError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(dotError));
        case System.Memory.MemoryStatus.Ok:
    }

    if (System.Text.AsciiLength(baseName) == 0)
    {
        stack System.Memory.MemoryStatus fallbackStatus = name.AppendAscii("stark");
        switch (fallbackStatus)
        {
            case System.Memory.MemoryStatus.Err(var fallbackError):
                return System.IO.IOStatus.Err(IOErrorFromMemoryError(fallbackError));
            case System.Memory.MemoryStatus.Ok:
        }
    }
    else
    {
        stack System.Memory.MemoryStatus baseStatus = name.AppendAscii(baseName);
        switch (baseStatus)
        {
            case System.Memory.MemoryStatus.Err(var baseError):
                return System.IO.IOStatus.Err(IOErrorFromMemoryError(baseError));
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack System.Memory.MemoryStatus markerStatus = name.AppendAscii(".stark-tmp-");
    switch (markerStatus)
    {
        case System.Memory.MemoryStatus.Err(var markerError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(markerError));
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus processStatus = name.AppendI64((i64[min max])processId);
    switch (processStatus)
    {
        case System.Memory.MemoryStatus.Err(var processError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(processError));
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus separatorStatus = name.AppendByte((i8[min max])45);
    switch (separatorStatus)
    {
        case System.Memory.MemoryStatus.Err(var separatorError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(separatorError));
        case System.Memory.MemoryStatus.Ok:
    }

    stack System.Memory.MemoryStatus attemptStatus = name.AppendU64((u64[0 max])attempt);
    switch (attemptStatus)
    {
        case System.Memory.MemoryStatus.Err(var attemptError):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(attemptError));
        case System.Memory.MemoryStatus.Ok:
    }

    if (System.Text.AsciiLength(directory) == 0)
    {
        return StatusFromMemoryStatus(destination.AppendAscii(name.View()));
    }

    stack System.Memory.MemoryStatus joinStatus = System.IO.Path.TryJoin(destination, directory, name.View());
    return StatusFromMemoryStatus(joinStatus);
}

internal fn System.IO.IOStatus AtomicWriteFailure(ascii tempPath, System.IO.IOError error)
{
    Delete(tempPath);
    return System.IO.IOStatus.Err(error);
}

internal fn System.IO.IOStatus SyncCloseAndPublishAtomicWrite(
    ascii targetPath,
    ascii tempPath,
    mut borrow File file)
{
    switch (file.SyncAll())
    {
        case System.IO.IOStatus.Err(var syncError):
            file.Close();
            return AtomicWriteFailure(tempPath, syncError);
        case System.IO.IOStatus.Ok:
    }

    switch (file.Close())
    {
        case System.IO.IOStatus.Err(var closeError):
            return AtomicWriteFailure(tempPath, closeError);
        case System.IO.IOStatus.Ok:
    }

    switch (Move(tempPath, targetPath))
    {
        case System.IO.IOStatus.Err(var moveError):
            return AtomicWriteFailure(tempPath, moveError);
        case System.IO.IOStatus.Ok:
            return System.IO.IOStatus.Ok;
    }
}

public fn System.IO.IOStatus WriteAllBytesAtomic(ascii path, borrow i8[min max][] source)
{
    stack mut System.Text.OwnedAscii tempPath = new();
    stack i32[min max] processId = System.Runtime.Platform.ProcessId();

    for willexit (stack mut u16[0 1024] attempt = 0; attempt < 1024; attempt += 1)
    {
        stack System.IO.IOStatus buildStatus = AppendAtomicTempFileCandidate(tempPath, path, processId, attempt);
        switch (buildStatus)
        {
            case System.IO.IOStatus.Err(var buildError):
                return System.IO.IOStatus.Err(buildError);
            case System.IO.IOStatus.Ok:
        }

        stack mut File file = new();
        switch (Open(tempPath.View(), FileMode.CreateNew, System.Text.Encoding.Binary, FileBuffering.None))
        {
            case System.IO.IOResult<File>.Err(var openError):
                switch (openError)
                {
                    case System.IO.IOError.AlreadyExists:
                        continue;
                    case System.IO.IOError.NotFound:
                        return System.IO.IOStatus.Err(openError);
                    case System.IO.IOError.PermissionDenied:
                        return System.IO.IOStatus.Err(openError);
                    case System.IO.IOError.InvalidPath:
                        return System.IO.IOStatus.Err(openError);
                    case System.IO.IOError.BrokenPipe:
                        return System.IO.IOStatus.Err(openError);
                    case System.IO.IOError.DiskFull:
                        return System.IO.IOStatus.Err(openError);
                    case System.IO.IOError.NotADirectory:
                        return System.IO.IOStatus.Err(openError);
                    case System.IO.IOError.IsADirectory:
                        return System.IO.IOStatus.Err(openError);
                    case System.IO.IOError.DirectoryNotEmpty:
                        return System.IO.IOStatus.Err(openError);
                    case System.IO.IOError.TooManyLinks:
                        return System.IO.IOStatus.Err(openError);
                    case System.IO.IOError.Unknown(var code):
                        return System.IO.IOStatus.Err(openError);
                }
            case System.IO.IOResult<File>.Ok(var opened):
                file = opened;
        }

        stack u64[0 2 ** 63 - 1] expected = source.Length;
        switch (file.Write(source))
        {
            case System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(var writeError):
                file.Close();
                return AtomicWriteFailure(tempPath.View(), writeError);
            case System.IO.IOResult<u64[0 2 ** 63 - 1]>.Ok(var written):
                if (written != expected)
                {
                    file.Close();
                    return AtomicWriteFailure(tempPath.View(), System.IO.IOError.BrokenPipe);
                }
        }

        return SyncCloseAndPublishAtomicWrite(path, tempPath.View(), file);
    }

    return System.IO.IOStatus.Err(System.IO.IOError.AlreadyExists);
}

public fn System.IO.IOStatus WriteAllBytesAtomic(ascii path, borrow System.Runtime.Buffer.DynamicByteBuffer source)
{
    return WriteAllBytesAtomic(path, source.ReadSlice());
}

public fn System.IO.IOStatus WriteAllBytesAtomic(ascii path, borrow System.Runtime.Buffer.FixedByteBuffer512 source)
{
    return WriteAllBytesAtomic(path, source.ReadSlice());
}

public fn System.IO.IOStatus WriteAllBytesAtomic(ascii path, borrow System.Runtime.Buffer.FixedByteBuffer4096 source)
{
    return WriteAllBytesAtomic(path, source.ReadSlice());
}

public fn System.IO.IOStatus WriteAllBytesAtomic(ascii path, borrow System.Runtime.Buffer.FixedByteBuffer8192 source)
{
    return WriteAllBytesAtomic(path, source.ReadSlice());
}

public fn System.IO.IOStatus WriteAllText(ascii path, ascii text)
{
    stack mut File file = new();
    switch (Open(path, FileMode.Write, System.Text.Encoding.UTF8, FileBuffering.None))
    {
        case System.IO.IOResult<File>.Err(var error):
            return System.IO.IOStatus.Err(error);
        case System.IO.IOResult<File>.Ok(var opened):
            file = opened;
    }

    switch (file.WriteText(text))
    {
        case System.IO.IOStatus.Err(var writeError):
            file.Close();
            return System.IO.IOStatus.Err(writeError);
        case System.IO.IOStatus.Ok:
    }

    return file.Close();
}

