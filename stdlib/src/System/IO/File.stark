fn System.IO.IOError IOErrorFromPlatformResult(i32[min max] result)
{
    if (result == -2 || result == -3)
    {
        return System.IO.IOError.NotFound;
    }

    if (result == -5 || result == -13)
    {
        return System.IO.IOError.PermissionDenied;
    }

    if (result == -17 || result == -183)
    {
        return System.IO.IOError.AlreadyExists;
    }

    if (result == -28 || result == -112)
    {
        return System.IO.IOError.DiskFull;
    }

    if (result == -32)
    {
        return System.IO.IOError.BrokenPipe;
    }

    if (result == -20)
    {
        return System.IO.IOError.NotADirectory;
    }

    if (result == -21)
    {
        return System.IO.IOError.IsADirectory;
    }

    // ENOTEMPTY is 39 on Linux and 66 on macOS.
    if (result == -39 || result == -66)
    {
        return System.IO.IOError.DirectoryNotEmpty;
    }

    // ELOOP is 40 on Linux and 62 on macOS; EMLINK is 31.
    if (result == -40 || result == -62 || result == -31)
    {
        return System.IO.IOError.TooManyLinks;
    }

    // ENAMETOOLONG is 36 on Linux and 63 on macOS; -206 is the Windows funnel.
    if (result == -36 || result == -63 || result == -206)
    {
        return System.IO.IOError.InvalidPath;
    }

    return System.IO.IOError.Unknown(result);
}

inline fn System.IO.IOStatus StatusFromPlatformResult(i32[min max] result)
{
    if (result < 0)
    {
        return System.IO.IOStatus.Err(IOErrorFromPlatformResult(result));
    }

    return System.IO.IOStatus.Ok;
}

inline fn System.IO.IOResult<u64[0 2 ** 63 - 1]> ByteCountFromPlatformResult(i64[min max] result)
{
    if (result < 0)
    {
        return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(IOErrorFromPlatformResult((i32[min max])result));
    }

    return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Ok((u64[0 2 ** 63 - 1])result);
}

inline finite law System.IO.IOError IOErrorFromMemoryError(System.Memory.MemoryError error)
{
    switch (error)
    {
        case System.Memory.MemoryError.OutOfMemory:
            return System.IO.IOError.Unknown(-12);
        case System.Memory.MemoryError.UnsupportedAlignment:
            return System.IO.IOError.Unknown(-22);
        case System.Memory.MemoryError.TooLarge:
            return System.IO.IOError.Unknown(-27);
        case System.Memory.MemoryError.InvalidLayout:
            return System.IO.IOError.Unknown(-22);
    }
}

inline fn System.IO.IOStatus StatusFromMemoryStatus(System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Ok:
            return System.IO.IOStatus.Ok;
        case System.Memory.MemoryStatus.Err(var error):
            return System.IO.IOStatus.Err(IOErrorFromMemoryError(error));
    }
}

unsafe fn OpenHandleResult HandleResult(System.Runtime.Platform.FileOpenResult result)
{
    switch (result)
    {
        case System.Runtime.Platform.FileOpenResult.Ok(var handle):
            return OpenHandleResult.Ok(handle);
        case System.Runtime.Platform.FileOpenResult.Err(var error):
            return OpenHandleResult.Err(IOErrorFromPlatformResult(error));
    }
}

unsafe fn OpenHandleResult OpenHandle(ascii path, FileMode mode)
{
    switch (mode)
    {
        case FileMode.Read:
            return HandleResult(System.Runtime.Platform.OpenFileReadResult(path));
        case FileMode.Write:
            return HandleResult(System.Runtime.Platform.OpenFileWriteResult(path));
        case FileMode.CreateNew:
            return HandleResult(System.Runtime.Platform.OpenFileCreateNewResult(path));
        case FileMode.Append:
            return HandleResult(System.Runtime.Platform.OpenFileAppendResult(path));
        case FileMode.ReadWrite:
            return HandleResult(System.Runtime.Platform.OpenFileReadWriteResult(path));
    }
}

finite law i32[min max] SeekOriginCode(SeekOrigin origin)
{
    switch (origin)
    {
        case SeekOrigin.Begin:
            return 0;
        case SeekOrigin.Current:
            return 1;
        case SeekOrigin.End:
            return 2;
    }
}

internal unsafe ffi asm(x86_64) fn void CopyAsciiBytes(rawmutptr<i8[min max]>[length] destination, rawptr<i8[min max]>[length] source, u32[0 max] length)
    where disjoint(destination, source)
    in("r8") destination,
    in("r9") source,
    in("r10") length,
    clobber("rdi", "rsi", "rcx"),
    memory(read(source), write(destination))
{
    "cld\nmovq %r8, %rdi\nmovq %r9, %rsi\nmovl %r10d, %ecx\nrep movsb"
}

internal unsafe ffi asm(aarch64) fn void CopyAsciiBytes(rawmutptr<i8[min max]>[length] destination, rawptr<i8[min max]>[length] source, u32[0 max] length)
    where disjoint(destination, source)
    in("x0") destination,
    in("x1") source,
    in("w2") length,
    clobber("w9", "w10", "w11"),
    memory(read(source), write(destination))
{
    "cbz w2, 2f\nmov w9, wzr\n1:\nldrb w10, [x1, w9, uxtw]\nstrb w10, [x0, w9, uxtw]\nadd w9, w9, #1\nsub w11, w2, w9\ncbnz w11, 1b\n2:"
}

