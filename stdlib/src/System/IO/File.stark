    fn FileLineReadResult ReadLine(mut borrow File self, mut borrow System.Text.OwnedAscii destination)
    {
        unsafe
        {
            destination.Clear();
            if (!self.IsOpen())
            {
                return FileLineReadResult.Err(System.IO.IOError.Unknown(-1));
            }

            stack mut bool sawBytes = false;
            stack mut i8[min max][8192] storage;
            stack mut i8[min max][] buffer = slice(&storage[0], 8192);
            stack rawptr<i8[min max]> data = &storage[0];

            while willexit (true)
            {
                stack mut u64[0 2 ** 63 - 1] count = 0;
                switch (self.Read(buffer))
                {
                    case System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(var readError):
                        return FileLineReadResult.Err(readError);
                    case System.IO.IOResult<u64[0 2 ** 63 - 1]>.Ok(var readCount):
                        count = readCount;
                }

                if (count == 0)
                {
                    if (sawBytes)
                    {
                        StripTrailingCarriageReturn(destination);
                        return FileLineReadResult.Line;
                    }

                    return FileLineReadResult.End;
                }

                stack mut u64[0 2 ** 63 - 1] newlineIndex = 0;
                stack mut bool foundNewline = false;
                while willexit (newlineIndex < count)
                {
                    if (*(&data[newlineIndex]) == (i8[min max])10)
                    {
                        foundNewline = true;
                        break;
                    }

                    newlineIndex += 1;
                }

                if (foundNewline)
                {
                    if (newlineIndex > 0)
                    {
                        stack i8[min max][] chunk = slice(&storage[0], newlineIndex);
                        stack System.Memory.MemoryStatus appendLineStatus =
                            destination.AppendSlice(chunk, newlineIndex);
                        switch (appendLineStatus)
                        {
                            case System.Memory.MemoryStatus.Err(var appendLineError):
                                return FileLineReadResult.Err(IOErrorFromMemoryError(appendLineError));
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }

                    StripTrailingCarriageReturn(destination);

                    stack u64[0 2 ** 63 - 1] unread = (u64[0 2 ** 63 - 1])(count - newlineIndex - 1);
                    if (unread > 0)
                    {
                        if (self.SeekRaw(-((i64[min max])unread), SeekOrigin.Current) < 0)
                        {
                            return FileLineReadResult.Err(System.IO.IOError.Unknown(-1));
                        }
                    }

                    return FileLineReadResult.Line;
                }

                stack i8[min max][] wholeChunk = slice(&storage[0], count);
                stack System.Memory.MemoryStatus appendStatus = destination.AppendSlice(wholeChunk, count);
                switch (appendStatus)
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return FileLineReadResult.Err(IOErrorFromMemoryError(appendError));
                    case System.Memory.MemoryStatus.Ok:
                }

                sawBytes = true;
            }
        }
    }

    mut drop
    {
        self.CloseRaw();
    }
}

fn System.IO.IOResult<File> FileResult(File file)
{
    if (!file.IsOpen())
    {
        return System.IO.IOResult<File>.Err(System.IO.IOError.Unknown(-1));
    }

    return System.IO.IOResult<File>.Ok(file);
}

public fn System.IO.IOResult<File> Open(ascii path, FileMode mode)
{
    return Open(path, mode, System.Text.Encoding.Binary);
}

public fn System.IO.IOResult<File> Open(ascii path, FileMode mode, FileBuffering buffering)
{
    return Open(path, mode, System.Text.Encoding.Binary, buffering);
}

public fn System.IO.IOResult<File> Open(ascii path, FileMode mode, System.Text.Encoding encoding)
{
    unsafe
    {
        switch (OpenHandle(path, mode))
        {
            case OpenHandleResult.Err(var error):
                return System.IO.IOResult<File>.Err(error);
            case OpenHandleResult.Ok(var handle):
                return FileResult(CreateFile(handle, encoding, DefaultBufferingForHandle(handle)));
        }
    }
}

public fn System.IO.IOResult<File> Open(ascii path, FileMode mode, System.Text.Encoding encoding, FileBuffering buffering)
{
    unsafe
    {
        switch (OpenHandle(path, mode))
        {
            case OpenHandleResult.Err(var error):
                return System.IO.IOResult<File>.Err(error);
            case OpenHandleResult.Ok(var handle):
                return FileResult(CreateFile(handle, encoding, buffering));
        }
    }
}

public fn System.IO.IOStatus ReadAllBytesInto(ascii path, mut borrow System.Runtime.Buffer.DynamicByteBuffer destination)
{
    unsafe
    {
        stack mut File file = new();
        switch (Open(path, FileMode.Read, System.Text.Encoding.Binary, FileBuffering.None))
        {
            case System.IO.IOResult<File>.Err(var error):
                return System.IO.IOStatus.Err(error);
            case System.IO.IOResult<File>.Ok(var opened):
                file = opened;
        }

        stack mut i8[min max][8192] storage;
        stack mut i8[min max][] buffer = slice(&storage[0], 8192);

        while willexit (true)
        {
            stack mut u64[0 2 ** 63 - 1] count = 0;
            switch (file.Read(buffer))
            {
                case System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(var readError):
                    file.Close();
                    return System.IO.IOStatus.Err(readError);
                case System.IO.IOResult<u64[0 2 ** 63 - 1]>.Ok(var readCount):
                    count = readCount;
            }

            if (count == 0)
            {
                return file.Close();
            }

            stack i8[min max][] chunk = slice(&storage[0], count);
            stack System.Memory.MemoryStatus writeStatus = destination.WriteSlice(chunk, count);
            switch (writeStatus)
            {
                case System.Memory.MemoryStatus.Err(var writeError):
                    file.Close();
                    return System.IO.IOStatus.Err(IOErrorFromMemoryError(writeError));
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }
}

public fn System.IO.IOResult<System.Runtime.Buffer.DynamicByteBuffer> ReadAllBytes(ascii path)
{
    stack mut System.Runtime.Buffer.DynamicByteBuffer destination = new();
    switch (ReadAllBytesInto(path, destination))
    {
        case System.IO.IOStatus.Err(var error):
            return System.IO.IOResult<System.Runtime.Buffer.DynamicByteBuffer>.Err(error);
        case System.IO.IOStatus.Ok:
            return System.IO.IOResult<System.Runtime.Buffer.DynamicByteBuffer>.Ok(destination);
    }
}

