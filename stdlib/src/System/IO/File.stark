public fn System.IO.IOStatus ReadLines(
    ascii path,
    inline closure<fn System.IO.IOStatus(ascii)> visitor)
{
    stack mut File file = new();
    switch (Open(path, FileMode.Read, System.Text.Encoding.UTF8, FileBuffering.None))
    {
        case System.IO.IOResult<File>.Err(var error):
            return System.IO.IOStatus.Err(error);
        case System.IO.IOResult<File>.Ok(var opened):
            file = opened;
    }

    stack mut System.Text.OwnedAscii line = new();
    while willexit (true)
    {
        switch (file.ReadLine(line))
        {
            case FileLineReadResult.Err(var readError):
                file.Close();
                return System.IO.IOStatus.Err(readError);
            case FileLineReadResult.End:
                return file.Close();
            case FileLineReadResult.Line:
                stack System.IO.IOStatus visitStatus = visitor(line.View());
                switch (visitStatus)
                {
                    case System.IO.IOStatus.Err(var visitError):
                        file.Close();
                        return System.IO.IOStatus.Err(visitError);
                    case System.IO.IOStatus.Ok:
                }
        }
    }
}

public fn System.IO.IOStatus WriteAllBytes(ascii path, borrow i8[min max][] source)
{
    stack mut File file = new();
    switch (Open(path, FileMode.Write, System.Text.Encoding.Binary, FileBuffering.None))
    {
        case System.IO.IOResult<File>.Err(var error):
            return System.IO.IOStatus.Err(error);
        case System.IO.IOResult<File>.Ok(var opened):
            file = opened;
    }

    stack u64[0 2 ** 63 - 1] expected = source.Length;
    switch (file.Write(source))
    {
        case System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(var writeError):
            file.Close();
            return System.IO.IOStatus.Err(writeError);
        case System.IO.IOResult<u64[0 2 ** 63 - 1]>.Ok(var written):
            if (written != expected)
            {
                file.Close();
                return System.IO.IOStatus.Err(System.IO.IOError.BrokenPipe);
            }
    }

    return file.Close();
}

public fn System.IO.IOStatus WriteAllBytes(ascii path, borrow System.Runtime.Buffer.DynamicByteBuffer source)
{
    return WriteAllBytes(path, source.ReadSlice());
}

