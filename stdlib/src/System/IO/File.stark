import System.Runtime.Buffer
import System.Text
import System.Runtime.Platform
module System.IO.File

public enum FileMode {
    Read,
    Write,
    Append,
    ReadWrite,
}

public enum FileBuffering {
    None,
    Line,
    Full,
}

fn rawptr<i8> OpenHandle(ascii path, FileMode mode) {
    switch (mode) {
        case FileMode.Read:
            return System.Runtime.Platform.OpenFileRead(path);
        case FileMode.Write:
            return System.Runtime.Platform.OpenFileWrite(path);
        case FileMode.Append:
            return System.Runtime.Platform.OpenFileAppend(path);
        case FileMode.ReadWrite:
            return System.Runtime.Platform.OpenFileReadWrite(path);
    }
}

internal ffi asm(x86_64) fn void CopyAsciiBytes(rawmutptr<i8> destination, rawptr<i8> source, i32 length)
    in("r8") destination,
    in("r9") source,
    in("r10") length,
    clobber("rdi", "rsi", "rcx")
{
    "cld\nmovq %r8, %rdi\nmovq %r9, %rsi\nmovl %r10d, %ecx\nrep movsb"
}

internal ffi asm(aarch64) fn void CopyAsciiBytes(rawmutptr<i8> destination, rawptr<i8> source, i32 length)
    in("x0") destination,
    in("x1") source,
    in("w2") length,
    clobber("w9", "w10", "w11")
{
    "cbz w2, 2f\nmov w9, wzr\n1:\nldrb w10, [x1, w9, uxtw]\nstrb w10, [x0, w9, uxtw]\nadd w9, w9, #1\nsub w11, w2, w9\ncbnz w11, 1b\n2:"
}

internal ffi asm(riscv64) fn void CopyAsciiBytes(rawmutptr<i8> destination, rawptr<i8> source, i32 length)
    in("a0") destination,
    in("a1") source,
    in("a2") length,
    clobber("t0", "t1", "t2", "t3", "t4")
{
    "beq a2, zero, 2f\nli t0, 0\n1:\nadd t1, a1, t0\nlbu t2, 0(t1)\nadd t3, a0, t0\nsb t2, 0(t3)\naddi t0, t0, 1\nsub t4, a2, t0\nbne t4, zero, 1b\n2:"
}

internal ffi asm(x86) fn void CopyAsciiBytes(rawmutptr<i8> destination, rawptr<i8> source, i32 length)
    in("eax") destination,
    in("edx") source,
    in("ebx") length,
    clobber("edi", "esi", "ecx")
{
    "cld\nmovl %eax, %edi\nmovl %edx, %esi\nmovl %ebx, %ecx\nrep movsb"
}

internal ffi asm(arm) fn void CopyAsciiBytes(rawmutptr<i8> destination, rawptr<i8> source, i32 length)
    in("r0") destination,
    in("r1") source,
    in("r2") length,
    clobber("r3", "r12")
{
    "cmp r2, #0\nbeq 2f\nmov r3, #0\n1:\nldrb r12, [r1, r3]\nstrb r12, [r0, r3]\nadd r3, r3, #1\nsub r12, r2, r3\ncmp r12, #0\nbne 1b\n2:"
}

fn i32 UnsignedByte(i8 value) {
    if (value < 0) {
        return ((i32)value) + 256;
    }

    return (i32)value;
}

fn i64 Utf8ChunkByteLengthLimited(rawptr<i8> data, i64 limit) {
    stack mut i64 read = 0;
    while willexit (read < limit) {
        stack i32 first = UnsignedByte(*(&data[read]));
        stack i64 needed = 1;
        if (194 <= first && first <= 223) {
            needed = 2;
        }
        else {
            if (224 <= first && first <= 239) {
                needed = 3;
            }
            else {
                if (240 <= first && first <= 244) {
                    needed = 4;
                }
            }
        }

        if (read + needed > limit) {
            if (read == 0) {
                return 1;
            }

            return read;
        }

        read += needed;
    }

    return read;
}

fn i64 Utf8ChunkByteLength(rawptr<i8> data, i64 remaining, i64 maxBytes) {
    if (data == null || remaining <= 0 || maxBytes <= 0) {
        return 0;
    }

    if (remaining <= maxBytes) {
        return Utf8ChunkByteLengthLimited(data, remaining);
    }

    return Utf8ChunkByteLengthLimited(data, maxBytes);
}

fn i32 WriteAllBytes(rawptr<i8> handle, rawptr<i8> buffer, i64 byteLength) {
    if (byteLength <= 0) {
        return 0;
    }

    if (handle == null || buffer == null) {
        return -1;
    }

    stack mut i64 offset = 0;
    while willexit (offset < byteLength) {
        stack rawptr<i8> chunk = &buffer[offset];
        stack i64 written = System.Runtime.Platform.WriteFile(chunk, 1, byteLength - offset, handle);
        if (written <= 0) {
            return -1;
        }

        offset += written;
    }

    return 0;
}

fn i32 WriteAsciiUtf16(rawptr<i8> handle, ascii text) {
    stack i64 sourceLength = System.Text.AsciiLength(text);
    if (sourceLength <= 0) {
        return 0;
    }

    stack ascii view = text[0, sourceLength];
    stack rawptr<i8> sourceData = System.Text.AsciiData(view);
    if (sourceData == null) {
        return -1;
    }

    stack mut i16[2048] utf16Storage;
    stack mut i64 sourceIndex = 0;
    while willexit (sourceIndex < sourceLength) {
        stack i64 chunkLength = Utf8ChunkByteLength(&sourceData[sourceIndex], sourceLength - sourceIndex, 2048);
        if (chunkLength <= 0) {
            return -1;
        }

        stack ascii chunk = view[sourceIndex, chunkLength];
        stack mut i64 writtenUnits = 0;
        if (!System.Text.TryConvertAsciiToUtf16(&utf16Storage[0], 2048, chunk, &writtenUnits)) {
            return -1;
        }

        if (WriteAllBytes(handle, (rawptr<i8>)(&utf16Storage[0]), writtenUnits * 2) != 0) {
            return -1;
        }

        sourceIndex += chunkLength;
    }

    return 0;
}

fn i32 WriteAsciiUtf32(rawptr<i8> handle, ascii text) {
    stack i64 sourceLength = System.Text.AsciiLength(text);
    if (sourceLength <= 0) {
        return 0;
    }

    stack ascii view = text[0, sourceLength];
    stack rawptr<i8> sourceData = System.Text.AsciiData(view);
    if (sourceData == null) {
        return -1;
    }

    stack mut i32[1024] unicodeStorage;
    stack mut Unicode owned = new Unicode() {
        Data = &unicodeStorage[0],
        Length = 0,
        Capacity = 1024
    };
    stack mut i64 sourceIndex = 0;
    while willexit (sourceIndex < sourceLength) {
        stack i64 chunkLength = Utf8ChunkByteLength(&sourceData[sourceIndex], sourceLength - sourceIndex, 1024);
        if (chunkLength <= 0) {
            return -1;
        }

        owned = new Unicode() {
            Data = &unicodeStorage[0],
            Length = 0,
            Capacity = 1024
        };

        stack ascii chunk = view[sourceIndex, chunkLength];
        if (!System.Text.TryConvertAsciiToUnicode(&owned, chunk)) {
            return -1;
        }

        if (WriteAllBytes(handle, (rawptr<i8>)owned.Data, owned.Length * 4) != 0) {
            return -1;
        }

        sourceIndex += chunkLength;
    }

    return 0;
}

fn i32 WriteUnicodeUtf16(rawptr<i8> handle, unicode text) {
    stack i64 sourceLength = System.Text.UnicodeLength(text);
    if (sourceLength <= 0) {
        return 0;
    }

    stack unicode view = text[0, sourceLength];
    stack mut i16[2048] utf16Storage;
    stack mut i64 sourceIndex = 0;
    while willexit (sourceIndex < sourceLength) {
        stack i64 chunkLength = sourceLength - sourceIndex;
        if (chunkLength > 1024) {
            chunkLength = 1024;
        }

        stack unicode chunk = view[sourceIndex, chunkLength];
        stack mut i64 writtenUnits = 0;
        if (!System.Text.TryConvertUnicodeToUtf16(&utf16Storage[0], 2048, chunk, &writtenUnits)) {
            return -1;
        }

        if (WriteAllBytes(handle, (rawptr<i8>)(&utf16Storage[0]), writtenUnits * 2) != 0) {
            return -1;
        }

        sourceIndex += chunkLength;
    }

    return 0;
}

fn i32 WriteUnicodeUtf32(rawptr<i8> handle, unicode text) {
    stack i64 sourceLength = System.Text.UnicodeLength(text);
    if (sourceLength <= 0) {
        return 0;
    }

    stack unicode view = text[0, sourceLength];
    stack rawptr<i32> sourceData = System.Text.UnicodeData(view);
    if (sourceData == null) {
        return -1;
    }

    stack mut i64 sourceIndex = 0;
    while willexit (sourceIndex < sourceLength) {
        stack i64 chunkLength = sourceLength - sourceIndex;
        if (chunkLength > 2048) {
            chunkLength = 2048;
        }

        if (WriteAllBytes(handle, (rawptr<i8>)(&sourceData[sourceIndex]), chunkLength * 4) != 0) {
            return -1;
        }

        sourceIndex += chunkLength;
    }

    return 0;
}

fn i32 WriteAsciiEncoded(rawptr<i8> handle, System.Text.Encoding encoding, ascii text) {
    switch (encoding) {
        case System.Text.Encoding.Binary:
            return System.Runtime.Platform.WriteAscii(handle, text);
        case System.Text.Encoding.UTF8:
            return System.Runtime.Platform.WriteAscii(handle, text);
        case System.Text.Encoding.UTF16:
            return WriteAsciiUtf16(handle, text);
        case System.Text.Encoding.UTF32:
            return WriteAsciiUtf32(handle, text);
    }
}

fn i32 WriteUnicodeEncoded(rawptr<i8> handle, System.Text.Encoding encoding, unicode text) {
    switch (encoding) {
        case System.Text.Encoding.Binary:
            return System.Runtime.Platform.WriteUnicode(handle, text);
        case System.Text.Encoding.UTF8:
            return System.Runtime.Platform.WriteUnicode(handle, text);
        case System.Text.Encoding.UTF16:
            return WriteUnicodeUtf16(handle, text);
        case System.Text.Encoding.UTF32:
            return WriteUnicodeUtf32(handle, text);
    }
}

fn void WriteAsciiLineHandle(rawptr<i8> handle, ascii text) {
    stack mut System.Runtime.Buffer.ByteBuffer512 lineBuffer = new System.Runtime.Buffer.ByteBuffer512();
    stack mut Ascii owned = new Ascii() {
        Data = lineBuffer.WritePointer(),
        Length = 0,
        Capacity = lineBuffer.Writable()
    };
    stack i64 textLength = System.Text.AsciiLength(text);
    stack i64 required = textLength + 1;

    if (owned.Data != null && required <= owned.Capacity) {
        stack ascii fullText = text[0, textLength];
        if (System.Text.TryConcatAscii(&owned, fullText, "\n")) {
            System.Runtime.Platform.WriteAscii(handle, System.Text.AsciiView(owned));
        }

        return;
    }

    stack ascii fullText = text[0, textLength];
    System.Runtime.Platform.WriteAscii(handle, fullText);
    System.Runtime.Platform.WriteAscii(handle, "\n");
    return;
}

fn void WriteUnicodeLineHandle(rawptr<i8> handle, unicode text) {
    System.Runtime.Platform.WriteUnicode(handle, text);
    System.Runtime.Platform.WriteUnicode(handle, (unicode)"\n");
    return;
}

fn FileBuffering DefaultBufferingForHandle(rawptr<i8> handle) {
    if (handle != null && System.Runtime.Platform.IsTerminal(handle)) {
        return FileBuffering.Line;
    }

    return FileBuffering.Full;
}

fn File CreateFile(rawptr<i8> handle, System.Text.Encoding encoding, FileBuffering buffering) {
    stack bool bufferWrites = true;
    stack bool flushOnLine = false;

    switch (buffering) {
        case FileBuffering.None:
            bufferWrites = false;
            flushOnLine = false;
        case FileBuffering.Line:
            bufferWrites = true;
            flushOnLine = true;
        case FileBuffering.Full:
            bufferWrites = true;
            flushOnLine = false;
    }

    return new File() {
        Handle = handle,
        Closed = handle == null,
        Encoding = encoding,
        BufferWrites = bufferWrites,
        FlushOnLine = flushOnLine,
        WriteBufferLength = 0
    };
}

public struct File {
    rawptr<i8> Handle;
    bool Closed;
    System.Text.Encoding Encoding;
    bool BufferWrites;
    bool FlushOnLine;
    i64 WriteBufferLength;
    i8[8192] WriteBufferStorage;

    fn bool IsOpen(borrow File self) {
        return !self.Closed;
    }

    fn ascii BufferedAscii(mut borrow File self) {
        stack i64 length = self.WriteBufferLength;
        if (length <= 0) {
            return "";
        }

        stack mut Ascii owned = new Ascii() {
            Data = &self.WriteBufferStorage[0],
            Length = length,
            Capacity = length
        };

        return System.Text.AsciiView(owned);
    }

    fn i32 FlushBufferedWrite(mut borrow File self) {
        if (self.Handle == null || self.WriteBufferLength <= 0) {
            return 0;
        }

        stack ascii buffered = self.BufferedAscii();
        stack i32 status = System.Runtime.Platform.WriteAscii(self.Handle, buffered);
        if (status == 0) {
            self.WriteBufferLength = 0;
        }

        return status;
    }

    fn bool TryAppendBufferedAscii(mut borrow File self, ascii text) {
        stack i64 textLength = System.Text.AsciiLength(text);
        if (textLength <= 0) {
            return true;
        }

        stack ascii fullText = text[0, textLength];

        stack i64 existingLength = self.WriteBufferLength;
        stack i64 capacity = 8192;
        if (existingLength + textLength > capacity) {
            return false;
        }

        stack rawptr<i8> textData = System.Text.AsciiData(fullText);
        if (textData == null) {
            return false;
        }

        CopyAsciiBytes(&self.WriteBufferStorage[existingLength], textData, (i32)textLength);
        self.WriteBufferLength = existingLength + textLength;
        return true;
    }

    fn i32 Close(mut borrow File self) {
        if (self.Closed || self.Handle == null) {
            self.Handle = null;
            self.Closed = true;
            return 0;
        }

        stack i32 flushStatus = self.Flush();
        stack i32 closeStatus = System.Runtime.Platform.CloseFile(self.Handle);
        self.Handle = null;
        self.Closed = true;

        if (flushStatus != 0) {
            return flushStatus;
        }

        return closeStatus;
    }

    fn i32 Flush(mut borrow File self) {
        if (self.Closed || self.Handle == null) {
            return 0;
        }

        stack i32 bufferStatus = self.FlushBufferedWrite();
        if (bufferStatus != 0) {
            return bufferStatus;
        }

        return System.Runtime.Platform.FlushFile(self.Handle);
    }

    fn i64 ReadBytes(mut borrow File self, rawptr<i8> buffer, i64 size, i64 count) {
        if (self.Closed || self.Handle == null) {
            return 0;
        }

        if (self.Flush() != 0) {
            return 0;
        }

        return System.Runtime.Platform.ReadFile(buffer, size, count, self.Handle);
    }

    fn i64 WriteBytes(mut borrow File self, rawptr<i8> buffer, i64 size, i64 count) {
        if (self.Closed || self.Handle == null) {
            return 0;
        }

        if (self.Flush() != 0) {
            return 0;
        }

        return System.Runtime.Platform.WriteFile(buffer, size, count, self.Handle);
    }

    fn void WriteText(mut borrow File self, ascii text) {
        if (self.Closed || self.Handle == null) {
            return;
        }

        switch (self.Encoding) {
            case System.Text.Encoding.Binary:
                stack i64 textLength = System.Text.AsciiLength(text);
                if (!self.BufferWrites) {
                    self.Flush();
                    stack ascii directText = text[0, textLength];
                    System.Runtime.Platform.WriteAscii(self.Handle, directText);
                    return;
                }

                stack i64 bufferedLength = self.WriteBufferLength;
                stack i64 capacity = 8192;
                if (bufferedLength + textLength <= capacity) {
                    stack ascii bufferedText = text[0, textLength];
                    self.TryAppendBufferedAscii(bufferedText);
                    return;
                }

                if (self.Flush() != 0) {
                    return;
                }

                if (textLength <= capacity) {
                    stack ascii bufferedText = text[0, textLength];
                    self.TryAppendBufferedAscii(bufferedText);
                    return;
                }

                stack ascii directText = text[0, textLength];
                System.Runtime.Platform.WriteAscii(self.Handle, directText);
                return;
            case System.Text.Encoding.UTF8:
                stack i64 textLength = System.Text.AsciiLength(text);
                if (!self.BufferWrites) {
                    self.Flush();
                    stack ascii directText = text[0, textLength];
                    System.Runtime.Platform.WriteAscii(self.Handle, directText);
                    return;
                }

                stack i64 bufferedLength = self.WriteBufferLength;
                stack i64 capacity = 8192;
                if (bufferedLength + textLength <= capacity) {
                    stack ascii bufferedText = text[0, textLength];
                    self.TryAppendBufferedAscii(bufferedText);
                    return;
                }

                if (self.Flush() != 0) {
                    return;
                }

                if (textLength <= capacity) {
                    stack ascii bufferedText = text[0, textLength];
                    self.TryAppendBufferedAscii(bufferedText);
                    return;
                }

                stack ascii directText = text[0, textLength];
                System.Runtime.Platform.WriteAscii(self.Handle, directText);
                return;
            case System.Text.Encoding.UTF16:
                if (self.FlushBufferedWrite() != 0) {
                    return;
                }

                WriteAsciiEncoded(self.Handle, self.Encoding, text);
                return;
            case System.Text.Encoding.UTF32:
                if (self.FlushBufferedWrite() != 0) {
                    return;
                }

                WriteAsciiEncoded(self.Handle, self.Encoding, text);
                return;
        }
    }

    fn void WriteText(mut borrow File self, unicode text) {
        if (self.Closed || self.Handle == null) {
            return;
        }

        switch (self.Encoding) {
            case System.Text.Encoding.Binary:
                if (self.FlushBufferedWrite() != 0) {
                    return;
                }

                WriteUnicodeEncoded(self.Handle, self.Encoding, text);
                return;
            case System.Text.Encoding.UTF8:
                if (self.FlushBufferedWrite() != 0) {
                    return;
                }

                WriteUnicodeEncoded(self.Handle, self.Encoding, text);
                return;
            case System.Text.Encoding.UTF16:
                if (self.FlushBufferedWrite() != 0) {
                    return;
                }

                WriteUnicodeEncoded(self.Handle, self.Encoding, text);
                return;
            case System.Text.Encoding.UTF32:
                if (self.FlushBufferedWrite() != 0) {
                    return;
                }

                WriteUnicodeEncoded(self.Handle, self.Encoding, text);
                return;
        }
    }

    fn void WriteLine(mut borrow File self, ascii text) {
        if (self.Closed || self.Handle == null) {
            return;
        }

        switch (self.Encoding) {
            case System.Text.Encoding.Binary:
                stack i64 textLength = System.Text.AsciiLength(text);
                if (!self.BufferWrites) {
                    stack ascii lineText = text[0, textLength];
                    WriteAsciiLineHandle(self.Handle, lineText);
                    return;
                }

                stack ascii lineText = text[0, textLength];
                self.WriteText(lineText);
                self.WriteText("\n");
                if (self.FlushOnLine) {
                    self.Flush();
                }

                return;
            case System.Text.Encoding.UTF8:
                stack i64 textLength = System.Text.AsciiLength(text);
                if (!self.BufferWrites) {
                    stack ascii lineText = text[0, textLength];
                    WriteAsciiLineHandle(self.Handle, lineText);
                    return;
                }

                stack ascii lineText = text[0, textLength];
                self.WriteText(lineText);
                self.WriteText("\n");
                if (self.FlushOnLine) {
                    self.Flush();
                }

                return;
            case System.Text.Encoding.UTF16:
                stack i64 textLength = System.Text.AsciiLength(text);
                stack ascii lineText = text[0, textLength];
                self.WriteText(lineText);
                self.WriteText("\n");
                if (self.FlushOnLine) {
                    self.Flush();
                }

                return;
            case System.Text.Encoding.UTF32:
                stack i64 textLength = System.Text.AsciiLength(text);
                stack ascii lineText = text[0, textLength];
                self.WriteText(lineText);
                self.WriteText("\n");
                if (self.FlushOnLine) {
                    self.Flush();
                }

                return;
        }
    }

    fn void WriteLine(mut borrow File self, unicode text) {
        if (self.Closed || self.Handle == null) {
            return;
        }

        switch (self.Encoding) {
            case System.Text.Encoding.Binary:
                if (self.FlushBufferedWrite() != 0) {
                    return;
                }

                WriteUnicodeLineHandle(self.Handle, text);
                return;
            case System.Text.Encoding.UTF8:
                if (self.FlushBufferedWrite() != 0) {
                    return;
                }

                WriteUnicodeLineHandle(self.Handle, text);
                return;
            case System.Text.Encoding.UTF16:
                self.WriteText(text);
                self.WriteText("\n");
                if (self.FlushOnLine) {
                    self.Flush();
                }

                return;
            case System.Text.Encoding.UTF32:
                self.WriteText(text);
                self.WriteText("\n");
                if (self.FlushOnLine) {
                    self.Flush();
                }

                return;
        }
    }

    mut drop {
        self.Close();
    }
}

public fn File Open(ascii path, FileMode mode) {
    return Open(path, mode, System.Text.Encoding.Binary);
}

public fn File Open(ascii path, FileMode mode, FileBuffering buffering) {
    return Open(path, mode, System.Text.Encoding.Binary, buffering);
}

public fn File Open(ascii path, FileMode mode, System.Text.Encoding encoding) {
    stack rawptr<i8> handle = OpenHandle(path, mode);
    return CreateFile(handle, encoding, DefaultBufferingForHandle(handle));
}

public fn File Open(ascii path, FileMode mode, System.Text.Encoding encoding, FileBuffering buffering) {
    stack rawptr<i8> handle = OpenHandle(path, mode);
    return CreateFile(handle, encoding, buffering);
}

public fn rawptr<i8> OpenRead(ascii path) {
    return System.Runtime.Platform.OpenFileRead(path);
}

public fn rawptr<i8> OpenWrite(ascii path) {
    return System.Runtime.Platform.OpenFileWrite(path);
}

public fn rawptr<i8> OpenAppend(ascii path) {
    return System.Runtime.Platform.OpenFileAppend(path);
}

public fn i32 Close(rawptr<i8> handle) {
    return System.Runtime.Platform.CloseFile(handle);
}

public fn i32 Flush(rawptr<i8> handle) {
    return System.Runtime.Platform.FlushFile(handle);
}

public fn i64 ReadBytes(rawptr<i8> buffer, i64 size, i64 count, rawptr<i8> handle) {
    return System.Runtime.Platform.ReadFile(buffer, size, count, handle);
}

public fn i64 WriteBytes(rawptr<i8> buffer, i64 size, i64 count, rawptr<i8> handle) {
    return System.Runtime.Platform.WriteFile(buffer, size, count, handle);
}

public fn void WriteText(rawptr<i8> handle, ascii text) {
    System.Runtime.Platform.WriteAscii(handle, text);
    return;
}

public fn void WriteText(rawptr<i8> handle, unicode text) {
    System.Runtime.Platform.WriteUnicode(handle, text);
    return;
}

public fn void WriteLine(rawptr<i8> handle, ascii text) {
    WriteAsciiLineHandle(handle, text);
    return;
}

public fn void WriteLine(rawptr<i8> handle, unicode text) {
    WriteUnicodeLineHandle(handle, text);
    return;
}

public fn i32 Delete(ascii path) {
    return System.Runtime.Platform.DeleteFile(path);
}

public fn i32 Move(ascii oldPath, ascii newPath) {
    return System.Runtime.Platform.MoveFile(oldPath, newPath);
}

public fn bool Exists(ascii path) {
    return System.Runtime.Platform.FileExists(path);
}
