    inline fn System.IO.IOResult<u64[0 2 ** 63 - 1]> Seek(mut borrow File self, i64[min max] offset, SeekOrigin origin)
    {
        return ByteCountFromPlatformResult(self.SeekRaw(offset, origin));
    }

    inline fn System.IO.IOResult<u64[0 2 ** 63 - 1]> Read(mut borrow File self, mut borrow i8[min max][] destination)
    {
        unsafe
        {
            if (!self.IsOpen())
            {
                return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(System.IO.IOError.Unknown(-1));
            }

            stack System.Runtime.MutableByteSliceParts destinationParts = System.Runtime.GetMutableByteSliceParts(destination);
            if (destinationParts.Length == 0)
            {
                return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Ok(0);
            }

            if (destinationParts.Data == null)
            {
                return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(System.IO.IOError.InvalidPath);
            }

            stack mut i64[min max] readCount = 0;
            unsafe
            {
                readCount = self.ReadByteRegionFast(destinationParts.Data, destinationParts.Length);
            }

            return ByteCountFromPlatformResult(readCount);
        }
    }

    inline fn System.IO.IOResult<u64[0 2 ** 63 - 1]> Write(mut borrow File self, borrow i8[min max][] source)
    {
        unsafe
        {
            if (!self.IsOpen())
            {
                return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(System.IO.IOError.Unknown(-1));
            }

            stack System.Runtime.ByteSliceParts sourceParts = System.Runtime.GetByteSliceParts(source);
            if (sourceParts.Length == 0)
            {
                return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Ok(0);
            }

            if (sourceParts.Data == null)
            {
                return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(System.IO.IOError.InvalidPath);
            }

            stack mut u64[0 2 ** 63 - 1] totalWritten = 0;
            stack i64[min max] bufferCapacity = 8192;
            if (self.BufferWrites)
            {
                while willexit (totalWritten < sourceParts.Length)
                {
                    if (self.WriteBufferLength >= bufferCapacity)
                    {
                        if (self.FlushRaw() != 0)
                        {
                            return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(System.IO.IOError.BrokenPipe);
                        }

                        continue;
                    }

                    stack u64[0 2 ** 63 - 1] remaining =
                        (u64[0 2 ** 63 - 1])(sourceParts.Length - totalWritten);
                    stack u64[0 2 ** 63 - 1] available =
                        (u64[0 2 ** 63 - 1])(bufferCapacity - self.WriteBufferLength);
                    stack mut u64[0 2 ** 63 - 1] chunkLength = remaining;
                    if (chunkLength > available)
                    {
                        chunkLength = available;
                    }

                    stack rawptr<i8[min max]> chunk = &sourceParts.Data[totalWritten];
                    if (!self.TryAppendBufferedBytes(chunk, chunkLength))
                    {
                        return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(System.IO.IOError.BrokenPipe);
                    }

                    totalWritten += chunkLength;
                }

                return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Ok(totalWritten);
            }

            while willexit (totalWritten < sourceParts.Length)
            {
                stack rawptr<i8[min max]> chunk = &sourceParts.Data[totalWritten];
                stack mut i64[min max] written = 0;
                unsafe
                {
                    written = self.WriteByteRegionFast(chunk, sourceParts.Length - totalWritten);
                }

                if (written <= 0)
                {
                    return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Err(System.IO.IOError.BrokenPipe);
                }

                totalWritten += (u64[0 2 ** 63 - 1])written;
            }

            return System.IO.IOResult<u64[0 2 ** 63 - 1]>.Ok(totalWritten);
        }
    }

