}

// A single generic over any DictionaryKey-supported element type collapses the
// former per-primitive overloads (i32/i64/u32/u64/ascii). Equality routes
// through the System.Collections.DictionaryKey doctrine, whose compiler-known
// machinery synthesizes element equality for bool, the Stark integer types,
// ascii, and unicode (the same path Dictionary/HashSet key comparisons use).
// `expected` is taken by value under `where Copyable(T)` so callers can still
// pass a literal (e.g. ContainsElement(xs, 20)); a borrowed `expected` would
// reject literals with STK3002 and force an `overlap` obligation on callers.
public finite law bool ContainsElement<T>(borrow T[] values, T expected)
    where Copyable(T)
{
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < values.Length)
    {
        if (System.Collections.DictionaryKey.Equals(values[index], expected))
        {
            return true;
        }

        index += 1;
    }

    return false;
}

// The element-shape mirrors of ContainsElement: same by-value `expected` under
// `where Copyable(T)` (so callers can still pass a literal) and the same
// DictionaryKey equality routing. DoesNotContainElement is the simple negation;
// SingleEquals fuses the Single shape check with a head-element equality.
public finite law bool DoesNotContainElement<T>(borrow T[] values, T expected)
    where Copyable(T)
{
    return !ContainsElement(values, expected);
}

public finite law bool SingleEquals<T>(borrow T[] values, T expected)
    where Copyable(T)
{
    return values.Length == 1
        && System.Collections.DictionaryKey.Equals(values[0], expected);
}

// List<T> mirror, matching the Single<T>/Count<T> List overloads above. The
// head element is read through the finite-law AsSlice() view (List.Get is plain
// `law`, too weak for a finite law); routing the equality through the array
// SingleEquals keeps one source of truth.
public finite law bool SingleEquals<T>(borrow System.Collections.List<T> values, T expected)
    where Copyable(T)
{
    return SingleEquals(values.AsSlice(), expected);
}

// A single generic collapses the former per-primitive SequenceEqual overloads
// (i32/i64/u32/u64). Element equality routes through the
// System.Collections.DictionaryKey doctrine's compiler-known machinery.
public finite law bool SequenceEqual<T>(borrow T[] expected, borrow T[] actual)
    where overlap(expected, actual)
{
    if (expected.Length != actual.Length)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < expected.Length)
    {
        if (!System.Collections.DictionaryKey.Equals(expected[index], actual[index]))
        {
            return false;
        }

        index += 1;
    }

    return true;
}

public finite law bool Contains(ascii value, ascii expected)
    where overlap(value, expected)
{
    return System.Text.Contains(value, expected);
}

public finite law bool Contains(unicode value, unicode expected)
    where overlap(value, expected)
{
    return System.Text.Contains(value, expected);
}

public finite law bool DoesNotContain(ascii value, ascii expected)
    where overlap(value, expected)
{
    return !System.Text.Contains(value, expected);
}

public finite law bool DoesNotContain(unicode value, unicode expected)
    where overlap(value, expected)
{
    return !System.Text.Contains(value, expected);
}

// Failure-reporting variants of Contains / DoesNotContain. They return the same
// bool as the `law` versions, but on a MISMATCH they also write a focused report
// to stderr — the searched-for fragment and a leading window of the actual text —
// so a failing emitter/SSA/LLVM golden assertion self-explains instead of
// returning a bare `false` that forces re-running the compiler by hand to see
// why. They are `fn` (not `law`) because they perform IO; the report goes to
// stderr so the runner's `ok`/`FAILED` stdout protocol stays clean. Use these in
// ported text-golden tests where diagnosing a mismatch is otherwise expensive.
public fn bool ContainsReport(ascii value, ascii expected)
    where overlap(value, expected)
{
    if (System.Text.Contains(value, expected))
    {
        return true;
    }

    ReportTextMismatch("expected to contain", expected, value);
    return false;
}

public fn bool DoesNotContainReport(ascii value, ascii unexpected)
    where overlap(value, unexpected)
{
    if (!System.Text.Contains(value, unexpected))
    {
        return true;
    }

    ReportTextMismatch("expected NOT to contain", unexpected, value);
    return false;
}

// Writes a two-part text-assertion failure report to stderr: the relation and
// searched-for fragment, then a leading window (up to 600 units) of the actual
// text. Kept internal; ContainsReport / DoesNotContainReport are the surface.
internal fn void ReportTextMismatch(ascii relation, ascii fragment, ascii actual)
    where overlap(relation, fragment), overlap(relation, actual), overlap(fragment, actual)
{
    stack System.IO.IOStatus s0 = System.Console.WriteErrorLine("  [assert] text mismatch:");
    stack System.IO.IOStatus s1 = System.Console.WriteError("    relation: ");
    stack System.IO.IOStatus s2 = System.Console.WriteErrorLine(relation);
    stack System.IO.IOStatus s3 = System.Console.WriteError("    fragment: ");
    stack System.IO.IOStatus s4 = System.Console.WriteErrorLine(fragment);
    stack System.IO.IOStatus s5 = System.Console.WriteErrorLine("    actual (leading window):");
    stack u64[0 2 ** 63 - 1] total = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(actual);
    stack mut u64[0 2 ** 63 - 1] windowLen = total;
    if (windowLen > 600)
    {
        windowLen = 600;
    }

    stack ascii window = actual[(i64[min max])0, (i64[min max])windowLen];
    stack System.IO.IOStatus s6 = System.Console.WriteErrorLine(window);
    return;
}

public finite law bool StartsWith(ascii value, ascii expected)
    where overlap(value, expected)
{
    return System.Text.StartsWith(value, expected);
}

public finite law bool StartsWith(unicode value, unicode expected)
    where overlap(value, expected)
{
    return System.Text.StartsWith(value, expected);
}

public finite law bool EndsWith(ascii value, ascii expected)
    where overlap(value, expected)
{
    return System.Text.EndsWith(value, expected);
}

public finite law bool EndsWith(unicode value, unicode expected)
    where overlap(value, expected)
{
    return System.Text.EndsWith(value, expected);
}

public finite law u64[0 2 ** 63 - 1] CountOccurrences(ascii value, ascii needle)
    where overlap(value, needle)
{
    return System.Text.CountOccurrences(value, needle);
}

// Returns the LLVM `define ...` header line whose symbol spells `@name(`, or
// empty text when no defined function matches. Ported feature tests use this
// (with LlvmDefinitionBody) instead of scraping module text by hand.
public finite ascii LlvmDefinitionHeader(ascii llvm, ascii symbolName)
    where overlap(llvm, symbolName)
{
    stack u64[0 2 ** 63 - 1] totalLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(llvm);
    stack mut u64[0 2 ** 63 - 1] lineStart = 0;
    stack mut u64[0 2 ** 63 - 1] lineEnd = 0;
    if (!TryFindLlvmDefinitionLine(llvm, symbolName, lineStart, lineEnd))
    {
        return "";
    }

    return llvm[(i64[min max])lineStart, (i64[min max])(lineEnd - lineStart)];
}

// Returns the LLVM function definition with the given symbol from its
// `define ...` header line through the closing `}` line, or empty text when no
// defined function matches.
public finite ascii LlvmDefinitionBody(ascii llvm, ascii symbolName)
    where overlap(llvm, symbolName)
{
    stack mut u64[0 2 ** 63 - 1] start = 0;
    stack mut u64[0 2 ** 63 - 1] headerEnd = 0;
    if (!TryFindLlvmDefinitionLine(llvm, symbolName, start, headerEnd))
    {
        return "";
    }

    stack u64[0 2 ** 63 - 1] totalLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(llvm);

    // Scan forward line by line for the closing `}` at column zero.
    stack mut u64[0 2 ** 63 - 1] lineStart = headerEnd;
    while willexit (lineStart < totalLength)
    {
        lineStart += 1;
        if (lineStart >= totalLength)
        {
            return "";
        }

        stack u64[0 2 ** 63 - 1] lineEnd = LineEndFrom(llvm, lineStart);
        if (lineEnd > lineStart && IsActualUnit(llvm, lineStart, "}"))
        {
            return llvm[(i64[min max])start, (i64[min max])(lineEnd - start)];
        }

        lineStart = lineEnd;
    }

    return "";
}

// Returns the SSA-text body of the single function `functionName`, from its
// column-zero `fn <name>(` header line through the line before the next
// column-zero `fn ` header (or end of text), or empty when none matches. The
// rendered `ssa` / `optimized-ssa` text lays out each function as a column-zero
// `fn <name>(...) -> ...` header followed by indented body lines, so scoping a
// "no surviving call/load" assertion to one function this way matches how the
// C# SSA oracle navigates a single SsaFunction instead of also matching a
// callee's own surviving definition header. This is the SSA analogue of
// LlvmDefinitionBody.
public finite ascii SsaFunctionBody(ascii ssaText, ascii functionName)
    where overlap(ssaText, functionName)
{
    stack u64[0 2 ** 63 - 1] totalLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(ssaText);
    stack mut u64[0 2 ** 63 - 1] currentLineStart = 0;
    while willexit (currentLineStart < totalLength)
    {
        stack u64[0 2 ** 63 - 1] lineEnd = LineEndFrom(ssaText, currentLineStart);
        stack ascii line = ssaText[(i64[min max])currentLineStart, (i64[min max])(lineEnd - currentLineStart)];
        if (SsaLineDefinesFunction(line, functionName))
        {
            stack mut u64[0 2 ** 63 - 1] scanLineStart = (u64[0 2 ** 63 - 1])(lineEnd + 1);
            while willexit (scanLineStart < totalLength)
            {
                stack u64[0 2 ** 63 - 1] scanLineEnd = LineEndFrom(ssaText, scanLineStart);
                stack ascii scanLine = ssaText[(i64[min max])scanLineStart, (i64[min max])(scanLineEnd - scanLineStart)];
                if (System.Text.StartsWith(scanLine, "fn "))
                {
                    return ssaText[(i64[min max])currentLineStart, (i64[min max])(scanLineStart - currentLineStart)];
                }

                scanLineStart = (u64[0 2 ** 63 - 1])(scanLineEnd + 1);
            }

            return ssaText[(i64[min max])currentLineStart, (i64[min max])(totalLength - currentLineStart)];
        }

        currentLineStart = (u64[0 2 ** 63 - 1])(lineEnd + 1);
    }

    return "";
}

// True when `line` begins a column-zero SSA function header `fn <name>(`.
internal finite law bool SsaLineDefinesFunction(ascii line, ascii functionName)
    where overlap(line, functionName)
{
    stack u64[0 2 ** 63 - 1] lineLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(line);
    stack u64[0 2 ** 63 - 1] nameLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(functionName);
    if (lineLength < nameLength + 4)
    {
        return false;
    }

    if (!System.Text.StartsWith(line, "fn "))
    {
        return false;
    }

    if (!IsActualUnit(line, (u64[0 2 ** 63 - 1])(nameLength + 3), "("))
    {
        return false;
    }

    return System.Text.Equals(
        line[(i64[min max])3, (i64[min max])nameLength],
        functionName);
}

// True when any single line of `value` contains both fragments. Ported
// feature tests use this where the C# originals match a one-line regex.
public finite law bool AnyLineContainsBoth(ascii value, ascii first, ascii second)
    where overlap(value, first), overlap(value, second), overlap(first, second)
{
    stack u64[0 2 ** 63 - 1] totalLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(value);
    stack mut u64[0 2 ** 63 - 1] lineStart = 0;
    while willexit (lineStart < totalLength)
    {
        stack u64[0 2 ** 63 - 1] lineEnd = LineEndFrom(value, lineStart);
        if (lineEnd > lineStart)
        {
            stack ascii line = value[(i64[min max])lineStart, (i64[min max])(lineEnd - lineStart)];
            if (System.Text.Contains(line, first) && System.Text.Contains(line, second))
            {
                return true;
            }
        }

        lineStart = (u64[0 2 ** 63 - 1])(lineEnd + 1);
    }

    return false;
}

// Index of the line break ending the line that starts at `from`, or the text
// length when the final line is unterminated.
internal finite law u64[0 2 ** 63 - 1] LineEndFrom(ascii value, u64[0 2 ** 63 - 1] searchStart)
{
    stack u64[0 2 ** 63 - 1] totalLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(value);
    stack mut u64[0 2 ** 63 - 1] index = searchStart;
    while willexit (index < totalLength)
    {
        if (IsActualUnit(value, index, "\n"))
        {
            return index;
        }

        index += 1;
    }

    return totalLength;
}

internal finite bool TryFindLlvmDefinitionLine(
    ascii llvm,
    ascii symbolName,
    out u64[0 2 ** 63 - 1] lineStart,
    out u64[0 2 ** 63 - 1] lineEndExclusive)
    where overlap(llvm, symbolName)
{
    lineStart = 0;
    lineEndExclusive = 0;
    if (System.Text.AsciiLength(llvm) <= 0 || System.Text.AsciiLength(symbolName) <= 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] totalLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(llvm);
    stack mut u64[0 2 ** 63 - 1] currentLineStart = 0;
    while willexit (currentLineStart < totalLength)
    {
        stack u64[0 2 ** 63 - 1] lineEnd = LineEndFrom(llvm, currentLineStart);
        if (lineEnd > currentLineStart)
        {
            stack ascii line = llvm[(i64[min max])currentLineStart, (i64[min max])(lineEnd - currentLineStart)];
            if (System.Text.StartsWith(line, "define ") && LineDefinesSymbol(line, symbolName))
            {
                lineStart = currentLineStart;
                lineEndExclusive = lineEnd;
                return true;
            }
        }

        currentLineStart = (u64[0 2 ** 63 - 1])(lineEnd + 1);
    }

    return false;
}

// The line must mention `@<symbolName>(` exactly.
internal finite law bool LineDefinesSymbol(ascii line, ascii symbolName)
    where overlap(line, symbolName)
{
    stack u64[0 2 ** 63 - 1] lineLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(line);
    stack u64[0 2 ** 63 - 1] symbolLength = (u64[0 2 ** 63 - 1])System.Text.AsciiLength(symbolName);
    if (lineLength < symbolLength + 2)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] lastStart = (u64[0 2 ** 63 - 1])(lineLength - symbolLength - 2);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index <= lastStart; index += 1)
    {
        if (IsActualUnit(line, index, "@")
            && IsActualUnit(line, (u64[0 2 ** 63 - 1])(index + symbolLength + 1), "(")
            && System.Text.Equals(
                line[(i64[min max])(index + 1), (i64[min max])symbolLength],
                symbolName))
        {
            return true;
        }
    }

    return false;
}

public finite law u64[0 2 ** 63 - 1] CountOccurrences(unicode value, unicode needle)
    where overlap(value, needle)
{
    return System.Text.CountOccurrences(value, needle);
}

public finite law bool Occurrences(u64[0 2 ** 63 - 1] expected, ascii value, ascii needle)
    where overlap(value, needle)
{
    return CountOccurrences(value, needle) == expected;
}

public finite law bool Occurrences(u64[0 2 ** 63 - 1] expected, unicode value, unicode needle)
    where overlap(value, needle)
{
    return CountOccurrences(value, needle) == expected;
}

public inline finite law bool DiagnosticCode(ascii expected, borrow Diagnostic diagnostic)
    where overlap(expected, diagnostic)
{
    return diagnostic.Code == expected;
}

inline finite law u8[0 2] DiagnosticSeverityRank(DiagnosticSeverity severity)
{
    switch (severity)
    {
        case DiagnosticSeverity.Info:
            return 0;
        case DiagnosticSeverity.Warning:
            return 1;
        case DiagnosticSeverity.Error:
            return 2;
    }

    return 2;
}

public inline finite law bool DiagnosticSeverityIs(DiagnosticSeverity expected, borrow Diagnostic diagnostic)
{
    return DiagnosticSeverityRank(diagnostic.Severity) == DiagnosticSeverityRank(expected);
}

public inline finite law bool DiagnosticStage(ascii expected, borrow Diagnostic diagnostic)
    where overlap(expected, diagnostic)
{
    return diagnostic.Stage == expected;
}

public inline finite law bool DiagnosticMessageEqual(ascii expected, borrow Diagnostic diagnostic)
    where overlap(expected, diagnostic)
{
    return diagnostic.Message == expected;
}

public inline finite law bool DiagnosticMessageContains(borrow Diagnostic diagnostic, ascii expected)
    where overlap(diagnostic, expected)
{
    return System.Text.Contains(diagnostic.Message, expected);
}

public inline finite law bool DiagnosticHasLocation(borrow Diagnostic diagnostic)
{
    return diagnostic.Location.HasValue;
}

public inline finite law bool DiagnosticHasEndLocation(borrow Diagnostic diagnostic)
{
    return diagnostic.Location.HasValue && diagnostic.Location.HasEndValue;
}

public inline finite law bool DiagnosticFilePath(ascii expected, borrow Diagnostic diagnostic)
    where overlap(expected, diagnostic)
{
    return diagnostic.Location.HasValue && diagnostic.Location.FilePath == expected;
}

public inline finite law bool DiagnosticAt(
    borrow Diagnostic diagnostic,
    u64[0 2 ** 63 - 1] line,
    u64[0 2 ** 63 - 1] column)
{
    return diagnostic.Location.HasValue
        && diagnostic.Location.Line == line
        && diagnostic.Location.Column == column;
}

public inline finite law bool DiagnosticEndsAt(
    borrow Diagnostic diagnostic,
    u64[0 2 ** 63 - 1] endLine,
    u64[0 2 ** 63 - 1] endColumn)
{
    return diagnostic.Location.HasValue
        && diagnostic.Location.HasEndValue
        && diagnostic.Location.EndLine == endLine
        && diagnostic.Location.EndColumn == endColumn;
}

public inline finite law bool DiagnosticMatches(
    borrow Diagnostic diagnostic,
    ascii code,
    DiagnosticSeverity severity,
    ascii stage,
    ascii messageContains)
    where overlap(diagnostic, code),
          overlap(diagnostic, stage),
          overlap(diagnostic, messageContains),
          overlap(code, stage),
          overlap(code, messageContains),
          overlap(stage, messageContains)
{
    return DiagnosticCode(code, diagnostic)
        && DiagnosticSeverityIs(severity, diagnostic)
        && DiagnosticStage(stage, diagnostic)
        && DiagnosticMessageContains(diagnostic, messageContains);
}

public inline finite law bool DiagnosticMatchesAt(
    borrow Diagnostic diagnostic,
    ascii code,
    DiagnosticSeverity severity,
    ascii stage,
    ascii messageContains,
    u64[0 2 ** 63 - 1] line,
    u64[0 2 ** 63 - 1] column)
    where overlap(diagnostic, code),
          overlap(diagnostic, stage),
          overlap(diagnostic, messageContains),
          overlap(code, stage),
          overlap(code, messageContains),
          overlap(stage, messageContains)
{
    return DiagnosticMatches(diagnostic, code, severity, stage, messageContains)
        && DiagnosticAt(diagnostic, line, column);
}

public finite law bool DiagnosticsCount(
    u64[0 2 ** 63 - 1] expected,
    borrow Diagnostic[] diagnostics)
{
    return diagnostics.Length == expected;
}

public finite law bool DiagnosticsEmpty(borrow Diagnostic[] diagnostics)
{
    return diagnostics.Length == 0;
}

public finite law bool DiagnosticsNotEmpty(borrow Diagnostic[] diagnostics)
{
    return diagnostics.Length != 0;
}

public finite law bool DiagnosticsContainCode(borrow Diagnostic[] diagnostics, ascii code)
    where overlap(diagnostics, code)
{
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < diagnostics.Length)
    {
        if (DiagnosticCode(code, diagnostics[index]))
        {
            return true;
        }

        index += 1;
    }

    return false;
}

public finite law bool DiagnosticsContainMessage(borrow Diagnostic[] diagnostics, ascii messageContains)
    where overlap(diagnostics, messageContains)
{
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < diagnostics.Length)
    {
        if (DiagnosticMessageContains(diagnostics[index], messageContains))
        {
            return true;
        }

        index += 1;
    }

    return false;
}

public finite law bool DiagnosticsContain(
    borrow Diagnostic[] diagnostics,
    ascii code,
    DiagnosticSeverity severity,
    ascii stage,
    ascii messageContains)
    where overlap(diagnostics, code),
          overlap(diagnostics, stage),
          overlap(diagnostics, messageContains),
          overlap(code, stage),
          overlap(code, messageContains),
          overlap(stage, messageContains)
{
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < diagnostics.Length)
    {
        if (DiagnosticMatches(diagnostics[index], code, severity, stage, messageContains))
        {
            return true;
        }

        index += 1;
    }

    return false;
}

public finite law bool DiagnosticsContainAt(
    borrow Diagnostic[] diagnostics,
    ascii code,
    DiagnosticSeverity severity,
    ascii stage,
    ascii messageContains,
    u64[0 2 ** 63 - 1] line,
    u64[0 2 ** 63 - 1] column)
    where overlap(diagnostics, code),
          overlap(diagnostics, stage),
          overlap(diagnostics, messageContains),
          overlap(code, stage),
          overlap(code, messageContains),
          overlap(stage, messageContains)
{
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < diagnostics.Length)
    {
        if (DiagnosticMatchesAt(diagnostics[index], code, severity, stage, messageContains, line, column))
        {
            return true;
        }

        index += 1;
    }

    return false;
}

public finite law u64[0 2 ** 63 - 1] DiagnosticsSeverityCount(
    DiagnosticSeverity severity,
    borrow Diagnostic[] diagnostics)
{
    stack mut u64[0 2 ** 63 - 1] count = 0;
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < diagnostics.Length)
    {
        if (DiagnosticSeverityIs(severity, diagnostics[index]))
        {
            count += 1;
        }

        index += 1;
    }

    return count;
}

public finite law u64[0 2 ** 63 - 1] DiagnosticsErrorCount(borrow Diagnostic[] diagnostics)
{
    return DiagnosticsSeverityCount(DiagnosticSeverity.Error, diagnostics);
}

public finite law u64[0 2 ** 63 - 1] DiagnosticsWarningCount(borrow Diagnostic[] diagnostics)
{
    return DiagnosticsSeverityCount(DiagnosticSeverity.Warning, diagnostics);
}

public finite law u64[0 2 ** 63 - 1] DiagnosticsInfoCount(borrow Diagnostic[] diagnostics)
{
    return DiagnosticsSeverityCount(DiagnosticSeverity.Info, diagnostics);
}

public finite law bool DiagnosticsHaveNoErrors(borrow Diagnostic[] diagnostics)
{
    return DiagnosticsErrorCount(diagnostics) == 0;
}

public finite law bool DiagnosticsHaveErrors(borrow Diagnostic[] diagnostics)
{
    return DiagnosticsErrorCount(diagnostics) != 0;
}

// Lowercase severity label for rendering, mirroring DiagnosticSeverityRank's
// switch shape. Returns a static ascii literal, so it stays finite law.
internal finite ascii DiagnosticSeverityLabel(DiagnosticSeverity severity)
{
    switch (severity)
    {
        case DiagnosticSeverity.Info:
            return "info";
        case DiagnosticSeverity.Warning:
            return "warning";
        case DiagnosticSeverity.Error:
            return "error";
    }

    return "error";
}

// Render one diagnostic as `<severity> <code>: <message>`, appending
// ` at <FilePath>:<Line>:<Column>` when the location is present and
// `-<EndLine>:<EndColumn>` when it carries an end. Threads MemoryStatus through
// every append exactly like AppendSnapshotDifference, early-returning on Err.
public fn System.Memory.MemoryStatus AppendDiagnostic(
    mut borrow System.Text.OwnedAscii writer,
    borrow Diagnostic d)
{
    switch (writer.AppendAscii(DiagnosticSeverityLabel(d.Severity)))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(" "))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(d.Code))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(": "))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(d.Message))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    if (!d.Location.HasValue)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    switch (writer.AppendAscii(" at "))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(d.Location.FilePath))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(":"))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendU64(d.Location.Line))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(":"))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendU64(d.Location.Column))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    if (!d.Location.HasEndValue)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    switch (writer.AppendAscii("-"))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendU64(d.Location.EndLine))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(":"))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    return writer.AppendU64(d.Location.EndColumn);
}

// Render every diagnostic in order, one per line. Threads MemoryStatus through
// each AppendDiagnostic and the newline separator, early-returning on Err.
public fn System.Memory.MemoryStatus AppendDiagnostics(
    mut borrow System.Text.OwnedAscii writer,
    borrow Diagnostic[] diagnostics)
{
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < diagnostics.Length)
    {
        switch (AppendDiagnostic(writer, diagnostics[index]))
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        switch (writer.AppendAscii("\n"))
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        index += 1;
    }

    return System.Memory.MemoryStatus.Ok;
}

// Render a two-line expected/actual block for a diagnostic that failed to match.
// The expected line echoes the matcher inputs (the same shape as
// DiagnosticMatches); the actual line reuses AppendDiagnostic. Threads
// MemoryStatus exactly like AppendSnapshotDifference.
public fn System.Memory.MemoryStatus AppendDiagnosticMismatch(
    mut borrow System.Text.OwnedAscii writer,
    ascii expectedCode,
    DiagnosticSeverity expectedSeverity,
    ascii expectedStage,
    ascii expectedMessageContains,
    borrow Diagnostic actual)
    where overlap(writer, expectedCode),
          overlap(writer, expectedStage),
          overlap(writer, expectedMessageContains),
          overlap(writer, actual),
          overlap(expectedCode, expectedStage),
          overlap(expectedCode, expectedMessageContains),
          overlap(expectedStage, expectedMessageContains)
{
    switch (writer.AppendAscii("expected: "))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(DiagnosticSeverityLabel(expectedSeverity)))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(" "))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(expectedCode))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(" ["))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(expectedStage))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii("]: "))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii(expectedMessageContains))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (writer.AppendAscii("\nactual: "))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
    }

    return AppendDiagnostic(writer, actual);
}

