// EXACT bit-equality for f64. f64 `==` is a valid runtime scalar comparison, so
// this mirrors the other Equal overloads: it accepts only values that are
// bit-for-bit identical (NaN never compares equal, +0.0 == -0.0 per IEEE-754).
public finite law bool Equal(f64 expected, f64 actual)
{
    return expected == actual;
}

// Tolerant f64 comparison within `ulps` units in the last place (approximation).
//
// Stark has no f64 bit-reinterpret / ToBits, so a true ULP comparison (counting
// representable steps between the two values) is not directly expressible. This
// is a documented relative-epsilon approximation: a value one ULP apart differs
// by roughly `epsilon * max(|expected|, |actual|)`, where `epsilon` is the f64
// machine epsilon (2 ** -52 ~= 2.220446049250313e-16). We therefore accept when
//   |expected - actual| <= ulps * epsilon * max(|expected|, |actual|, epsilon)
// The trailing `epsilon` floor keeps the tolerance non-zero near zero so values
// straddling zero (or both denormal/tiny) still compare within `ulps`. Exact
// equality short-circuits first. There is no System.Math.Abs(f64), so magnitudes
// use the stdlib `v < 0.0 ? 0.0 - v : v` idiom.
public finite law bool ApproxEqual(f64 expected, f64 actual, u32[0 max] ulps)
{
    if (expected == actual)
    {
        return true;
    }

    stack f64 epsilon = 2.220446049250313e-16;
    stack f64 difference = expected - actual;
    stack f64 absoluteDifference = difference < 0.0 ? 0.0 - difference : difference;
    stack f64 expectedMagnitude = expected < 0.0 ? 0.0 - expected : expected;
    stack f64 actualMagnitude = actual < 0.0 ? 0.0 - actual : actual;
    stack f64 scale = System.Math.Max(
        System.Math.Max(expectedMagnitude, actualMagnitude),
        epsilon);
    stack f64 tolerance = (f64)ulps * epsilon * scale;
    return absoluteDifference <= tolerance;
}

