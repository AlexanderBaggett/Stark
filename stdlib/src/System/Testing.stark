public finite law i32[min max] ExitCode(u32[0 2 ** 31 - 1] failureCount)
{
    if (failureCount == 0)
    {
        return 0;
    }

    return 1;
}

public fn void Exit(u32[0 2 ** 31 - 1] failureCount)
{
    System.Process.Exit(ExitCode(failureCount));
}

// Benchmark/regression gate: the threshold compare at the heart of a regression
// harness. `measured` passes when it is no slower than `tolerancePercent`% over
// `baseline` (measured <= baseline + baseline*tolerancePercent/100). Faster
// runs (measured < baseline) always pass. Arithmetic is widened to u128 so the
// `baseline * tolerancePercent` product cannot overflow for full-range u64
// inputs.
public finite law bool WithinRegression(
    u64[0 max] baseline,
    u64[0 max] measured,
    u64[0 max] tolerancePercent)
{
    if (measured <= baseline)
    {
        return true;
    }

    stack u128[0 max] allowance =
        (u128[0 max])baseline
        + (u128[0 max])baseline * (u128[0 max])tolerancePercent / (u128[0 max])100;
    return (u128[0 max])measured <= allowance;
}

// ---------------------------------------------------------------------------
// TEST-10 benchmark timing
// ---------------------------------------------------------------------------
// A SAFE monotonic clock accessor for benchmark harnesses. The only monotonic
// primitive is the per-OS `internal unsafe fn i64[min max] MonotonicMilliseconds()`
// dispatched through System.Runtime.Platform; that surface is intentionally kept
// `internal unsafe` (it returns a raw error-coded i64, negative on clock failure)
// rather than promoted to a public platform clock. This wrapper is the minimal
// safe exposure: it lives in System.Testing where the benchmark harness lives,
// wraps the existing call in an `unsafe { }` block (no new raw pointers), and
// folds the error case into a clean monotonic u64 by clamping a negative reading
// (clock failure) to 0. Reads never decrease, so ElapsedSince stays well-defined.
public fn u64[0 max] MonotonicMilliseconds()
{
    unsafe
    {
        stack i64[min max] raw = System.Runtime.Platform.MonotonicMilliseconds();
        if (raw < 0)
        {
            return (u64[0 max])0;
        }

        return (u64[0 max])raw;
    }
}

// Elapsed milliseconds since a prior MonotonicMilliseconds() reading. A monotonic
// clock never runs backwards, but if `start` somehow exceeds `now` (e.g. a clamped
// failure reading) the result is defined as 0 rather than wrapping.
public finite law u64[0 max] ElapsedSince(u64[0 max] start, u64[0 max] now)
{
    if (now <= start)
    {
        return (u64[0 max])0;
    }

    return now - start;
}

// A minimal stopwatch over the monotonic clock. Start() captures a reading and
// Elapsed() reports milliseconds since that capture; both route through the safe
// MonotonicMilliseconds()/ElapsedSince helpers above.
public struct Stopwatch
{
    internal u64[0 max] StartedAt;

    Stopwatch()
    {
        self.StartedAt = (u64[0 max])0;
    }

    fn void Start(mut borrow Stopwatch self)
    {
        self.StartedAt = MonotonicMilliseconds();
    }

    fn u64[0 max] Elapsed(borrow Stopwatch self)
    {
        return ElapsedSince(self.StartedAt, MonotonicMilliseconds());
    }
}

// ---------------------------------------------------------------------------
// TEST-02 AllDistinct
// ---------------------------------------------------------------------------
// True iff no two elements are equal. O(n^2) pairwise comparison routed through
// the System.Collections.DictionaryKey doctrine, matching ContainsElement. Empty
// and singleton slices are trivially distinct. `T` is compared by value, so the
// inner element is rebound to a `needle` local before being borrowed for
// DictionaryKey.Equals (see ContainsElement for the STK5002 address-of workaround).
public finite law bool AllDistinct<T>(borrow T[] values)
    where Copyable(T)
{
    stack mut u64[0 2 ** 63 - 1] outer = 0;
    while willexit (outer < values.Length)
    {
        stack T needle = values[outer];
        stack mut u64[0 2 ** 63 - 1] inner = outer + 1;
        while willexit (inner < values.Length)
        {
            if (System.Collections.DictionaryKey.Equals(values[inner], needle))
            {
                return false;
            }

            inner += 1;
        }

        outer += 1;
    }

    return true;
}
