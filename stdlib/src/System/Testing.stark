public finite law TestStatus Status(bool assertion)
{
    if (assertion)
    {
        return TestStatus.Passed;
    }

    return TestStatus.Failed;
}

// Collection-filter reporting for generated test runners. The runner emits
// the matching logic; these keep the printing (and the Testing module's
// raw-pointer-free policy) in one place.
// Process-argument access for generated runners, wrapped so the generated
// root needs no extra imports and no unsafe blocks.
public fn u64[0 2 ** 63 - 1] CollectionArgumentCount()
{
    unsafe
    {
        switch (System.Process.Arguments())
        {
            case System.Process.ProcessResult<System.Process.ProcessArguments>.Err(var error):
                return 0;
            case System.Process.ProcessResult<System.Process.ProcessArguments>.Ok(var value):
                stack System.Process.ProcessArguments arguments = value;
                return arguments.Count();
        }
    }
}

public fn bool CollectionArgumentEquals(u64[0 2 ** 63 - 1] index, ascii expected)
{
    unsafe
    {
        switch (System.Process.Arguments())
        {
            case System.Process.ProcessResult<System.Process.ProcessArguments>.Err(var error):
                return false;
            case System.Process.ProcessResult<System.Process.ProcessArguments>.Ok(var value):
                stack System.Process.ProcessArguments arguments = value;
                return arguments.ArgumentEquals(index, expected);
        }
    }
}

public fn void ReportUnknownCollection()
{
    System.Console.WriteLine("Unknown test collection argument. Known collections:");
    return;
}

public fn void ReportKnownCollection(ascii name)
{
    System.Console.WriteLine(name);
    return;
}

public fn void ReportNoFactsSelected()
{
    System.Console.WriteLine("No facts matched the requested collections.");
    return;
}

public fn u8[0 1] RunFact(ascii name, bool assertion)
{
    if (assertion)
    {
        System.Console.Write("ok ");
        System.Console.WriteLine(name);
        return 0;
    }

    System.Console.WriteError("FAILED ");
    System.Console.WriteErrorLine(name);
    return 1;
}

public fn u8[0 1] RunFact(unicode name, bool assertion)
{
    if (assertion)
    {
        System.Console.Write((unicode)"ok ");
        System.Console.WriteLine(name);
        return 0;
    }

    System.Console.WriteError((unicode)"FAILED ");
    System.Console.WriteErrorLine(name);
    return 1;
}

public fn u8[0 1] SkipFact(ascii name, ascii reason)
{
    System.Console.Write("skipped ");
    System.Console.Write(name);
    System.Console.Write(": ");
    System.Console.WriteLine(reason);
    return 0;
}

public fn u8[0 1] SkipFact(unicode name, unicode reason)
{
    System.Console.Write((unicode)"skipped ");
    System.Console.Write(name);
    System.Console.Write((unicode)": ");
    System.Console.WriteLine(reason);
    return 0;
}

public finite law i32[min max] ExitCode(u32[0 2 ** 31 - 1] failureCount)
{
    if (failureCount == 0)
    {
        return 0;
    }

    return 1;
}

public fn void Exit(u32[0 2 ** 31 - 1] failureCount)
{
    System.Process.Exit(ExitCode(failureCount));
}
