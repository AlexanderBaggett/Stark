public finite law bool OptionSome<T>(borrow System.Core.Option<T> value)
{
    switch (value)
    {
        case System.Core.Option<T>.Some(_):
            return true;
        case System.Core.Option<T>.None:
            return false;
    }
}

public finite law bool OptionNone<T>(borrow System.Core.Option<T> value)
{
    switch (value)
    {
        case System.Core.Option<T>.Some(_):
            return false;
        case System.Core.Option<T>.None:
            return true;
    }
}

public finite law bool ResultOk<T, E>(borrow System.Core.Result<T, E> value)
{
    switch (value)
    {
        case System.Core.Result<T, E>.Ok(_):
            return true;
        case System.Core.Result<T, E>.Err(_):
            return false;
    }
}

public finite law bool ResultErr<T, E>(borrow System.Core.Result<T, E> value)
{
    switch (value)
    {
        case System.Core.Result<T, E>.Ok(_):
            return false;
        case System.Core.Result<T, E>.Err(_):
            return true;
    }
}

// Value-carrying companions to the OptionSome/None and ResultOk/Err shape
// predicates above. They check both the variant AND the payload, routing payload
// equality through the System.Collections.DictionaryKey doctrine exactly like
// ContainsElement. `expected` is taken by value under `where Copyable(...)` so a
// literal still binds (e.g. OptionSomeEquals(opt, 5)).
public finite law bool OptionSomeEquals<T>(borrow System.Core.Option<T> value, T expected)
    where Copyable(T)
{
    switch (value)
    {
        case System.Core.Option<T>.Some(var v):
            return System.Collections.DictionaryKey.Equals(v, expected);
        case System.Core.Option<T>.None:
            return false;
    }
}

public finite law bool ResultOkEquals<T, E>(borrow System.Core.Result<T, E> value, T expected)
    where Copyable(T)
{
    switch (value)
    {
        case System.Core.Result<T, E>.Ok(var v):
            return System.Collections.DictionaryKey.Equals(v, expected);
        case System.Core.Result<T, E>.Err(_):
            return false;
    }
}

public finite law bool ResultErrEquals<T, E>(borrow System.Core.Result<T, E> value, E expected)
    where Copyable(E)
{
    switch (value)
    {
        case System.Core.Result<T, E>.Ok(_):
            return false;
        case System.Core.Result<T, E>.Err(var e):
            return System.Collections.DictionaryKey.Equals(e, expected);
    }
}

