public fn TestStatus Status(bool assertion)
{
    if (assertion)
    {
        return TestStatus.Passed;
    }

    return TestStatus.Failed;
}

public fn u8[0 1] RunFact(ascii name, bool assertion)
{
    if (assertion)
    {
        System.Console.Write("ok ");
        System.Console.WriteLine(name);
        return 0;
    }

    System.Console.WriteError("FAILED ");
    System.Console.WriteErrorLine(name);
    return 1;
}

public fn u8[0 1] RunFact(unicode name, bool assertion)
{
    if (assertion)
    {
        System.Console.Write((unicode)"ok ");
        System.Console.WriteLine(name);
        return 0;
    }

    System.Console.WriteError((unicode)"FAILED ");
    System.Console.WriteErrorLine(name);
    return 1;
}

public fn i32[min max] ExitCode(u32[0 2 ** 31 - 1] failureCount)
{
    if (failureCount == 0)
    {
        return 0;
    }

    return 1;
}

public fn void Exit(u32[0 2 ** 31 - 1] failureCount)
{
    System.Process.Exit(ExitCode(failureCount));
}
