public fn MemoryStatus CopyBytes(
    borrow i8[-128 127][] source,
    borrow mut i8[-128 127][] destination,
    i64[0 max] count) {
        unsafe {
        if (count == 0) {
            return MemoryStatus.Ok;
        }

        if disjoint(source, destination) {
            for willexit independent (stack mut i64[0 max] index = 0; index < count; index += 1) {
                destination[index] = source[index];
            }

            return MemoryStatus.Ok;
        }

        stack mut dynamic i8[-128 127] snapshot = new();
        if (!snapshot.TryReserve(count)) {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut i64[0 max] snapshotIndex = 0; snapshotIndex < count; snapshotIndex += 1) {
            init snapshot[snapshot.Length] = source[snapshotIndex];
        }

        stack i8[-128 127][] snapshotView = snapshot[0, snapshot.Length];
        for willexit (stack mut i64[0 max] copyIndex = 0; copyIndex < count; copyIndex += 1) {
            destination[copyIndex] = snapshotView[copyIndex];
        }

        return MemoryStatus.Ok;
        }
}

public inline finite void MoveBytesInfallible(
    borrow i8[-128 127][] source,
    borrow mut i8[-128 127][] destination,
    i64[0 max] count) {
        unsafe {
        if (count == 0) {
            return;
        }

        stack rawptr<i8[-128 127]> sourceStart = &source[0];
        stack rawptr<i8[-128 127]> destinationStart = (rawptr<i8[-128 127]>)(&destination[0]);
        if (destinationStart < sourceStart) {
            for willexit (stack mut i64[0 max] index = 0; index < count; index += 1) {
                destination[index] = source[index];
            }

            return;
        }

        stack mut i64[0 max] remaining = count;
        while willexit (remaining > 0) {
            remaining -= 1;
            destination[remaining] = source[remaining];
        }

        return;
        }
}

public inline finite MemoryStatus MoveBytes(
    borrow i8[-128 127][] source,
