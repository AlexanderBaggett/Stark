        if (count > ((2 ** 61) - 1)) {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        stack i64[0 (2 ** 61) - 1] safeCount = (i64[0 (2 ** 61) - 1])count;
        stack i32[-2147483648 2147483647][] initialized = storage[0, storage.Length];
        if disjoint(source, initialized) {
            unsafe {
                return AppendCodePointsDisjoint(storage, source, safeCount);
            }
        }

        stack mut dynamic i32[-2147483648 2147483647] snapshot = new();
        if (!snapshot.TryReserve(safeCount)) {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        stack init i32[-2147483648 2147483647][] snapshotTail = init snapshot[snapshot.Length, safeCount];
        unsafe {
            InitializeCodePointsDisjoint(source, snapshotTail, safeCount);
        }

        stack i32[-2147483648 2147483647][] snapshotView = snapshot[0, snapshot.Length];
        unsafe {
            return AppendCodePointsDisjoint(storage, snapshotView, safeCount);
        }
        }
}

