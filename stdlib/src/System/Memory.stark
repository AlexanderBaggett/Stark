    }

    return;
}

public inline finite MemoryStatus CopyBytesDisjoint(
    borrow i8[min max][] source,
    borrow mut i8[min max][] destination,
    u64[0 2 ** 63 - 1] count)
    {
    CopyBytesDisjointInfallible(source, destination, count);
    return MemoryStatus.Ok;
}

public fn MemoryStatus CopyBytes(
    borrow i8[min max][] source,
    borrow mut i8[min max][] destination,
    u64[0 2 ** 63 - 1] count)
    where overlap(source, destination)
{
        unsafe
        {
        if (count == 0)
        {
            return MemoryStatus.Ok;
        }

        if disjoint(source, destination)
        {
            for willexit independent (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
            {
                destination[index] = source[index];
            }

            return MemoryStatus.Ok;
        }

        stack mut dynamic i8[min max] snapshot = new();
        if (!snapshot.TryReserve(count))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut u64[0 2 ** 63 - 1] snapshotIndex = 0; snapshotIndex < count; snapshotIndex += 1)
        {
            init snapshot[snapshot.Length] = source[snapshotIndex];
        }

        stack i8[min max][] snapshotView = snapshot[0, snapshot.Length];
        for willexit (stack mut u64[0 2 ** 63 - 1] copyIndex = 0; copyIndex < count; copyIndex += 1)
        {
            destination[copyIndex] = snapshotView[copyIndex];
        }

        return MemoryStatus.Ok;
        }
}

public inline finite void MoveBytesInfallible(
    borrow i8[min max][] source,
    borrow mut i8[min max][] destination,
    u64[0 2 ** 63 - 1] count)
    where overlap(source, destination)
    {
        unsafe
        {
        if (count == 0)
        {
            return;
        }

        stack rawptr<i8[min max]> sourceStart = &source[0];
        stack rawptr<i8[min max]> destinationStart = (rawptr<i8[min max]>)(&destination[0]);
        if (destinationStart < sourceStart)
        {
            for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
            {
                destination[index] = source[index];
            }

            return;
        }

        stack mut u64[0 2 ** 63 - 1] remaining = count;
        while willexit (remaining > 0)
        {
            remaining -= 1;
            destination[remaining] = source[remaining];
        }

        return;
        }
}

public inline finite MemoryStatus MoveBytes(
    borrow i8[min max][] source,
    borrow mut i8[min max][] destination,
    u64[0 2 ** 63 - 1] count)
    where overlap(source, destination)
    {
    MoveBytesInfallible(source, destination, count);
    return MemoryStatus.Ok;
}

