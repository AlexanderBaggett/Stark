module System.Memory

public enum MemoryError
{
    OutOfMemory,
    InvalidLayout,
    UnsupportedAlignment,
    TooLarge,
}

public enum MemoryStatus
{
    Ok,
    Err(MemoryError),
}

public enum MemoryResult<T>
{
    Ok(T),
    Err(MemoryError),
}

public struct Allocator
{
    u8[0 2 ** 7 - 1] Kind;

    static inline finite law Allocator Default()
    {
        return new Allocator()
        {
            Kind = 0
        };
    }

    inline finite law bool IsDefault(borrow Allocator self)
    {
        return self.Kind == 0;
    }
}

internal struct Allocation
{
    rawmutptr<i8[min max]> Pointer;
    u64[0 2 ** 63 - 1] ByteLength;
    u64[1 2 ** 63 - 1] Alignment;
    Allocator Allocator;
}

internal inline fn Allocation Allocate(Allocator allocator, u64[0 2 ** 63 - 1] byteLength, u64[1 2 ** 63 - 1] alignment);
internal inline fn Allocation Reallocate(Allocation allocation, u64[0 2 ** 63 - 1] byteLength, u64[1 2 ** 63 - 1] alignment);
internal inline fn void Free(Allocation allocation);

public inline finite law bool SupportsDynamicAllocator(Allocator allocator)
{
    return allocator.IsDefault();
}

public inline fn MemoryStatus ReserveBytes(
    mut borrow dynamic i8[min max] storage,
    u64[0 2 ** 63 - 1] additional)
{
    if (!storage.TryReserve(additional))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    return MemoryStatus.Ok;
}

public inline fn MemoryStatus ReserveCodePoints(
    mut borrow dynamic i32[min max] storage,
    u64[0 2 ** 63 - 1] additional)
{
    if (!storage.TryReserve(additional))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    return MemoryStatus.Ok;
}

public inline fn MemoryStatus AppendBytesDisjoint(
    mut borrow dynamic i8[min max] storage,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] count)
{
    if (count == 0)
    {
        return MemoryStatus.Ok;
    }

    if (!storage.TryReserve(count))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    stack init i8[min max][] tail = init storage[storage.Length, count];
    unsafe
    {
        return InitializeBytesDisjoint(source, tail, count);
    }
}

public fn MemoryStatus AppendBytes(
    mut borrow dynamic i8[min max] storage,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] count)
    where overlap(storage, source)
{
        unsafe
        {
        if (count == 0)
        {
            return MemoryStatus.Ok;
        }

        stack i8[min max][] initialized = storage[0, storage.Length];
        if disjoint(source, initialized)
        {
            unsafe
            {
                return AppendBytesDisjoint(storage, source, count);
            }
        }

        stack mut dynamic i8[min max] snapshot = new();
        if (!snapshot.TryReserve(count))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        stack init i8[min max][] snapshotTail = init snapshot[snapshot.Length, count];
        unsafe
        {
            InitializeBytesDisjoint(source, snapshotTail, count);
        }

        stack i8[min max][] snapshotView = snapshot[0, snapshot.Length];
        unsafe
        {
            return AppendBytesDisjoint(storage, snapshotView, count);
        }
        }
}

public inline fn MemoryStatus AppendFillBytes(
    mut borrow dynamic i8[min max] storage,
    i8[min max] value,
    u64[0 2 ** 63 - 1] count)
{
    if (count == 0)
    {
        return MemoryStatus.Ok;
    }

    if (!storage.TryReserve(count))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    stack init i8[min max][] tail = init storage[storage.Length, count];
    return FillBytes(tail, value, count);
}

public inline fn MemoryStatus AppendCodePointsDisjoint(
    mut borrow dynamic i32[min max] storage,
    borrow i32[min max][] source,
    u64[0 2 ** 63 - 1] count)
{
    if (count == 0)
    {
        return MemoryStatus.Ok;
    }

    if (count > 2 ** 61 - 1)
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    if (!storage.TryReserve((u64[0 2 ** 61 - 1])count))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    stack init i32[min max][] tail = init storage[storage.Length, (u64[0 2 ** 61 - 1])count];
    unsafe
    {
        return InitializeCodePointsDisjoint(source, tail, (u64[0 2 ** 61 - 1])count);
    }
}

public fn MemoryStatus AppendCodePoints(
    mut borrow dynamic i32[min max] storage,
    borrow i32[min max][] source,
    u64[0 2 ** 63 - 1] count)
    where overlap(storage, source)
{
        unsafe
        {
        if (count == 0)
        {
            return MemoryStatus.Ok;
        }

        if (count > 2 ** 61 - 1)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        stack u64[0 2 ** 61 - 1] safeCount = (u64[0 2 ** 61 - 1])count;
        stack i32[min max][] initialized = storage[0, storage.Length];
        if disjoint(source, initialized)
        {
            unsafe
            {
                return AppendCodePointsDisjoint(storage, source, safeCount);
            }
        }

        stack mut dynamic i32[min max] snapshot = new();
        if (!snapshot.TryReserve(safeCount))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        stack init i32[min max][] snapshotTail = init snapshot[snapshot.Length, safeCount];
        unsafe
        {
            InitializeCodePointsDisjoint(source, snapshotTail, safeCount);
        }

        stack i32[min max][] snapshotView = snapshot[0, snapshot.Length];
        unsafe
        {
            return AppendCodePointsDisjoint(storage, snapshotView, safeCount);
        }
        }
}

public inline fn MemoryStatus AppendFillCodePoints(
    mut borrow dynamic i32[min max] storage,
    i32[min max] value,
    u64[0 2 ** 63 - 1] count)
{
    if (count == 0)
    {
        return MemoryStatus.Ok;
    }

    if (count > 2 ** 61 - 1)
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    stack u64[0 2 ** 61 - 1] safeCount = (u64[0 2 ** 61 - 1])count;
    if (!storage.TryReserve(safeCount))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    stack init i32[min max][] tail = init storage[storage.Length, safeCount];
    return FillCodePoints(tail, value, safeCount);
}

public inline finite MemoryStatus InitializeBytesDisjoint(
    borrow i8[min max][] source,
    init i8[min max][] destination,
    u64[0 2 ** 63 - 1] count)
    {
    for willexit independent (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        init destination[index] = source[index];
    }

    return MemoryStatus.Ok;
}

public inline finite MemoryStatus InitializeBytes(
    borrow i8[min max][] source,
    init i8[min max][] destination,
    u64[0 2 ** 63 - 1] count)
    {
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        init destination[index] = source[index];
    }

    return MemoryStatus.Ok;
}

internal unsafe inline finite MemoryStatus InitializeBytesFromPointerDisjoint(
    u64[0 2 ** 63 - 1] count,
    rawptr<i8[min max]>[count] source,
    init i8[min max][] destination)
    {
    for willexit independent (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        init destination[index] = *(&source[index]);
    }

    return MemoryStatus.Ok;
}

