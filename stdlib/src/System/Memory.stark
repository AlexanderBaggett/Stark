module System.Memory

public enum MemoryError {
    OutOfMemory,
    InvalidLayout,
    UnsupportedAlignment,
    TooLarge,
}

public enum MemoryStatus {
    Ok,
    Err(MemoryError),
}

public enum MemoryResult<T> {
    Ok(T),
    Err(MemoryError),
}

public struct Allocator {
    u8[0 127] Kind;

    static finite law Allocator Default() {
        return new Allocator() {
            Kind = 0
        };
    }

    finite law bool IsDefault(borrow Allocator self) {
        return self.Kind == 0;
    }
}

internal struct Allocation {
    rawmutptr<i8[-128 127]> Pointer;
    i64[0 max] ByteLength;
    i64[1 max] Alignment;
    Allocator Allocator;
}

internal fn Allocation Allocate(Allocator allocator, i64[0 max] byteLength, i64[1 max] alignment);
internal fn Allocation Reallocate(Allocation allocation, i64[0 max] byteLength, i64[1 max] alignment);
internal fn void Free(Allocation allocation);

public finite law bool SupportsDynamicAllocator(Allocator allocator) {
    return allocator.IsDefault();
}

public inline fn MemoryStatus ReserveBytes(
    mut borrow dynamic i8[-128 127] storage,
    i64[0 max] additional) {
    if (!storage.TryReserve(additional)) {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    return MemoryStatus.Ok;
}

public inline fn MemoryStatus ReserveCodePoints(
    mut borrow dynamic i32[-2147483648 2147483647] storage,
    i64[0 max] additional) {
    if (!storage.TryReserve(additional)) {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    return MemoryStatus.Ok;
}

public inline fn MemoryStatus AppendBytesDisjoint(
    disjoint mut borrow dynamic i8[-128 127] storage,
    disjoint borrow i8[-128 127][] source,
    i64[0 max] count) {
    if (count == 0) {
        return MemoryStatus.Ok;
    }

    if (!storage.TryReserve(count)) {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    stack init i8[-128 127][] tail = init storage[storage.Length, count];
    unsafe {
        return InitializeBytesDisjoint(source, tail, count);
    }
}

public fn MemoryStatus AppendBytes(
    mut borrow dynamic i8[-128 127] storage,
    borrow i8[-128 127][] source,
    i64[0 max] count) {
        unsafe {
        if (count == 0) {
            return MemoryStatus.Ok;
        }

        stack i8[-128 127][] initialized = storage[0, storage.Length];
        if disjoint(source, initialized) {
            unsafe {
                return AppendBytesDisjoint(storage, source, count);
            }
        }

        stack mut dynamic i8[-128 127] snapshot = new();
        if (!snapshot.TryReserve(count)) {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        stack init i8[-128 127][] snapshotTail = init snapshot[snapshot.Length, count];
        unsafe {
            InitializeBytesDisjoint(source, snapshotTail, count);
        }

        stack i8[-128 127][] snapshotView = snapshot[0, snapshot.Length];
        unsafe {
            return AppendBytesDisjoint(storage, snapshotView, count);
        }
        }
}

public inline fn MemoryStatus AppendFillBytes(
    mut borrow dynamic i8[-128 127] storage,
    i8[-128 127] value,
    i64[0 max] count) {
    if (count == 0) {
        return MemoryStatus.Ok;
    }

    if (!storage.TryReserve(count)) {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    stack init i8[-128 127][] tail = init storage[storage.Length, count];
    return FillBytes(tail, value, count);
}

public inline fn MemoryStatus AppendCodePointsDisjoint(
    disjoint mut borrow dynamic i32[-2147483648 2147483647] storage,
    disjoint borrow i32[-2147483648 2147483647][] source,
    i64[0 max] count) {
    if (count == 0) {
        return MemoryStatus.Ok;
    }

    if (count > ((2 ** 61) - 1)) {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    if (!storage.TryReserve((i64[0 (2 ** 61) - 1])count)) {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    stack init i32[-2147483648 2147483647][] tail = init storage[storage.Length, (i64[0 (2 ** 61) - 1])count];
    unsafe {
        return InitializeCodePointsDisjoint(source, tail, (i64[0 (2 ** 61) - 1])count);
    }
}

