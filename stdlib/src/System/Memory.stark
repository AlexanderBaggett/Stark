public fn MemoryStatus CopyCodePoints(
    borrow i32[min max][] source,
    borrow mut i32[min max][] destination,
    u64[0 2 ** 63 - 1] count)
    where overlap(source, destination)
{
        unsafe
        {
        if (count == 0)
        {
            return MemoryStatus.Ok;
        }

        if (count > 2 ** 61 - 1)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        stack u64[0 2 ** 61 - 1] safeCount = (u64[0 2 ** 61 - 1])count;
        if disjoint(source, destination)
        {
            for willexit independent (stack mut u64[0 2 ** 61 - 1] index = 0; index < safeCount; index += 1)
            {
                destination[index] = source[index];
            }

            return MemoryStatus.Ok;
        }

        stack mut dynamic i32[min max] snapshot = new();
        if (!snapshot.TryReserve(safeCount))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut u64[0 2 ** 61 - 1] snapshotIndex = 0; snapshotIndex < safeCount; snapshotIndex += 1)
        {
            init snapshot[snapshot.Length] = source[snapshotIndex];
        }

        stack i32[min max][] snapshotView = snapshot[0, snapshot.Length];
        for willexit (stack mut u64[0 2 ** 61 - 1] copyIndex = 0; copyIndex < safeCount; copyIndex += 1)
        {
            destination[copyIndex] = snapshotView[copyIndex];
        }

        return MemoryStatus.Ok;
        }
}

