public inline finite MemoryStatus InitializeBytesDisjoint(
    disjoint borrow i8[-128 127][] source,
    disjoint init i8[-128 127][] destination,
    i64[0 max] count) {
    for willexit independent (stack mut i64[0 max] index = 0; index < count; index += 1) {
        init destination[index] = source[index];
    }

    return MemoryStatus.Ok;
}

