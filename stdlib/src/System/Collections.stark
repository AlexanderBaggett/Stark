internal fn System.Memory.MemoryStatus ComputeContiguousGrowthCapacity(
    i64[0 max] length,
    i64[0 max] currentCapacity,
    i64[0 max] additional,
    i64[1 max] initialCapacity,
    out i64[0 max] nextCapacity) {
    nextCapacity = currentCapacity;
    if (additional == 0) {
        return System.Memory.MemoryStatus.Ok;
    }

    if (additional > 9223372036854775807 - length) {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    stack i64[0 max] required = length + additional;
    if (required <= currentCapacity) {
        return System.Memory.MemoryStatus.Ok;
    }

    if (nextCapacity == 0) {
        nextCapacity = initialCapacity;
    }

    while willexit (nextCapacity < required) {
        if (nextCapacity > 4611686018427387903) {
            nextCapacity = required;
        }
        else {
            nextCapacity = (i64[0 max])(nextCapacity * 2);
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus ComputeHashStorageGrowthCapacity(
    i64[0 max] length,
    i64[0 max] currentCapacity,
    i64[0 max] additional,
    out i64[0 max] nextCapacity) {
    nextCapacity = currentCapacity;
    if (additional == 0) {
        return System.Memory.MemoryStatus.Ok;
    }

    if (additional > 9223372036854775807 - length) {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    stack i64[0 max] required = length + additional;
    if (required > 4611686018427387904) {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    // Hash storage capacities stay powers of two so bucket selection can use a mask.
    stack mut i64[0 max] targetCapacity = required;
    if (targetCapacity <= 2305843009213693952) {
        targetCapacity = (i64[0 max])(targetCapacity * 2);
    }
    else {
        targetCapacity = 4611686018427387904;
    }

    if (targetCapacity <= currentCapacity) {
        return System.Memory.MemoryStatus.Ok;
    }

    stack i64[0 max] targetAdditional = (i64[0 max])(targetCapacity - length);
    return ComputeContiguousGrowthCapacity(length, currentCapacity, targetAdditional, 8, nextCapacity);
}

