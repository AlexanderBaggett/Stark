import System.Memory
import System.BitOperations
module System.Collections

public enum Ordering
{
    Less,
    Equal,
    Greater,
}

public trait Eq
{
    finite law bool Equals(borrow Self left, borrow Self right)
        where overlap(left, right);
}

public trait Hash
{
    alias Code = u64[0 max];

    finite law Self.Code Hash(borrow Self value);
}

public trait Ord
{
    finite law Ordering Compare(borrow Self left, borrow Self right)
        where overlap(left, right);
}

public trait Format
{
    alias Writer;

    finite law System.Memory.MemoryStatus Format(borrow Self value, mut borrow Self.Writer writer);
}

public trait Equatable<T>
{
    finite law bool Equals(borrow T left, borrow T right)
        where overlap(left, right);
}

public trait Hashable<T>
{
    finite law u64[0 max] Hash(borrow T value);
}

public doctrine DictionaryKey<T>
{
    finite law bool Equals(borrow T left, borrow T right)
        where overlap(left, right);
    finite law u64[0 max] Hash(borrow T value);
}

public inline finite law retborrow frozen T Lookup<T>(
    const T[] table,
    u64[0 2 ** 63 - 1] index)
{
    return table[index];
}

internal fn System.Memory.MemoryStatus ComputeContiguousGrowthCapacity(
    u64[0 2 ** 63 - 1] length,
    u64[0 2 ** 63 - 1] currentCapacity,
    u64[0 2 ** 63 - 1] additional,
    u64[1 2 ** 63 - 1] initialCapacity,
    out u64[0 2 ** 63 - 1] nextCapacity)
{
    nextCapacity = currentCapacity;
    if (additional == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    if (additional > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) - length)
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    stack u64[0 2 ** 63 - 1] required = (u64[0 2 ** 63 - 1])(length + additional);
    if (required <= currentCapacity)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    if (nextCapacity == 0)
    {
        nextCapacity = initialCapacity;
    }

    while willexit (nextCapacity < required)
    {
        if (nextCapacity > (u64[0 2 ** 63 - 1])(2 ** 62 - 1))
        {
            nextCapacity = required;
        }
        else
        {
            nextCapacity = (u64[0 2 ** 63 - 1])(nextCapacity * 2);
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus ComputeHashStorageGrowthCapacity(
    u64[0 2 ** 63 - 1] length,
    u64[0 2 ** 63 - 1] currentCapacity,
    u64[0 2 ** 63 - 1] additional,
    out u64[0 2 ** 63 - 1] nextCapacity)
{
    nextCapacity = currentCapacity;
    if (additional == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    if (additional > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) - length)
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    stack u64[0 2 ** 63 - 1] required = (u64[0 2 ** 63 - 1])(length + additional);
    if (required > (u64[0 2 ** 63 - 1])(2 ** 62))
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
    }

    stack mut u64[0 2 ** 63 - 1] targetCapacity = required;
    if (targetCapacity <= (u64[0 2 ** 63 - 1])(2 ** 61))
    {
        targetCapacity = (u64[0 2 ** 63 - 1])(targetCapacity * 2);
    }
    else
    {
        targetCapacity = (u64[0 2 ** 63 - 1])(2 ** 62);
    }

    if (targetCapacity <= currentCapacity)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] targetAdditional = (u64[0 2 ** 63 - 1])(targetCapacity - length);
    return ComputeContiguousGrowthCapacity(length, currentCapacity, targetAdditional, 8, nextCapacity);
}

internal inline finite law i64[min max] DictionaryStateOneBytes()
{
    return 72340172838076673;
}

internal inline finite law i64[min max] DictionaryStateTwoBytes()
{
    return 144680345676153346;
}

internal inline finite law i64[min max] DictionaryStateHighBits()
{
    return -9187201950435737472;
}

internal inline finite law i64[min max] DictionaryStateMatchMask(
    i64[min max] stateWord,
    i64[min max] repeatedByte)
{
        unsafe
        {
        stack i64[min max] candidate = stateWord ^ repeatedByte;
        return ((candidate -% DictionaryStateOneBytes()) & ~candidate) & DictionaryStateHighBits();
        }
}

internal inline finite law u64[0 2 ** 63 - 1] DictionaryStateMaskByteOffset(
    i64[min max] mask)
{
    return (u64[0 2 ** 63 - 1])(System.BitOperations.TrailingZeroCount(mask) / 8);
}

internal inline finite law i64[min max] DictionaryStateClearLowestMaskBit(
    i64[min max] mask)
{
    return mask & (mask -% 1);
}

public struct List<T>
{
    internal dynamic T Items;

    List()
    {
        self.Items = new();
    }

    mut drop
    {
        self.Clear();
    }

    inline finite law u64[0 2 ** 63 - 1] Count(borrow List<T> self)
    {
        return self.Items.Length;
    }

    inline finite law u64[0 2 ** 63 - 1] Capacity(borrow List<T> self)
    {
        return self.Items.Capacity;
    }

    inline finite law bool IsEmpty(borrow List<T> self)
    {
        return self.Items.Length == 0;
    }

    fn System.Memory.MemoryStatus Reserve(mut borrow List<T> self, u64[0 2 ** 63 - 1] additional)
    {
        stack mut u64[0 2 ** 63 - 1] nextCapacity = self.Items.Capacity;
        stack System.Memory.MemoryStatus capacityStatus =
            ComputeContiguousGrowthCapacity(self.Items.Length, self.Items.Capacity, additional, 4, nextCapacity);
        switch (capacityStatus)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        if (nextCapacity <= self.Items.Capacity)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u64[0 2 ** 63 - 1] elementSize = sizeof(T);
        if (elementSize == 0)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        if (nextCapacity > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) / elementSize)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
        }

        if (!self.Items.TryReserveCapacity(nextCapacity))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        return System.Memory.MemoryStatus.Ok;
    }

    fn System.Memory.MemoryStatus Push(mut borrow List<T> self, T value)
    {
        stack System.Memory.MemoryStatus status = self.Reserve(1);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        init self.Items[self.Items.Length] = value;
        return System.Memory.MemoryStatus.Ok;
    }

    fn bool TryPop(mut borrow List<T> self, out T value)
    {
        if (self.Items.Length == 0)
        {
            return false;
        }

        value = self.Items.MoveLast();
        return true;
    }

    law retborrow T Get(borrow List<T> self, u64[0 2 ** 63 - 1] index)
    {
        return self.Items[index];
    }

    fn retborrow mut T GetMut(mut borrow List<T> self, u64[0 2 ** 63 - 1] index)
    {
        return self.Items[index];
    }

    finite law retborrow T[] AsSlice(borrow List<T> self)
    {
        return self.Items[0, self.Items.Length];
    }

    finite retborrow mut T[] AsMutableSlice(mut borrow List<T> self)
    {
        return self.Items[0, self.Items.Length];
    }

    fn void Clear(mut borrow List<T> self)
    {
        while willexit (self.Items.Length > 0)
        {
            stack T value = self.Items.MoveLast();
        }

        return;
    }
}

public struct Stack<T>
{
    internal List<T> Items;

    Stack()
    {
        self.Items = new();
    }

    mut drop
    {
        self.Clear();
    }

    inline finite law u64[0 2 ** 63 - 1] Count(borrow Stack<T> self)
    {
        return self.Items.Count();
    }

    inline finite law bool IsEmpty(borrow Stack<T> self)
    {
        return self.Items.IsEmpty();
    }

    fn System.Memory.MemoryStatus Reserve(mut borrow Stack<T> self, u64[0 2 ** 63 - 1] additional)
    {
        return self.Items.Reserve(additional);
    }

    fn System.Memory.MemoryStatus Push(mut borrow Stack<T> self, T value)
    {
        return self.Items.Push(value);
    }

    fn bool TryPop(mut borrow Stack<T> self, out T value)
    {
        return self.Items.TryPop(value);
    }

    law retborrow T Peek(borrow Stack<T> self)
    {
        return self.Items.Get((u64[0 2 ** 63 - 1])(self.Items.Count() - 1));
    }

    fn void Clear(mut borrow Stack<T> self)
    {
        self.Items.Clear();
        return;
    }
}

internal struct SparseSlots<T>
{
    internal rawmutptr<T> Items;
    internal System.Memory.Allocation Allocation;
    internal System.Memory.Allocator Allocator;
    internal u64[0 2 ** 63 - 1] StorageCapacity;

    SparseSlots()
    {
        self.Allocator = System.Memory.Allocator.Default();
        self.Items = null;
        self.Allocation = new System.Memory.Allocation()
        {
            Pointer = null,
            ByteLength = 0,
            Alignment = alignof(T),
            Allocator = self.Allocator
        };
        self.StorageCapacity = 0;
    }

    SparseSlots(System.Memory.Allocator allocator)
    {
        self.Allocator = allocator;
        self.Items = null;
        self.Allocation = new System.Memory.Allocation()
        {
            Pointer = null,
            ByteLength = 0,
            Alignment = alignof(T),
            Allocator = allocator
        };
        self.StorageCapacity = 0;
    }

    mut drop
    {
        if (self.Allocation.Pointer != null)
        {
            System.Memory.Free(self.Allocation);
        }

        self.Items = null;
        self.StorageCapacity = 0;
    }

    inline finite law u64[0 2 ** 63 - 1] Capacity(borrow SparseSlots<T> self)
    {
        return self.StorageCapacity;
    }

    unsafe inline fn System.Memory.MemoryStatus ReserveRing(
        mut borrow SparseSlots<T> self,
        rawmutptr<u64[0 2 ** 63 - 1]> head,
        u64[0 2 ** 63 - 1] length,
        u64[0 2 ** 63 - 1] nextCapacity)
        {
        if (nextCapacity <= self.StorageCapacity)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u64[0 2 ** 63 - 1] elementSize = sizeof(T);
        if (elementSize == 0)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        if (nextCapacity > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) / elementSize)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
        }

        stack u64[0 2 ** 63 - 1] oldCapacity = self.StorageCapacity;
        stack u64[0 2 ** 63 - 1] oldHead = *head;
        stack rawmutptr<T> oldItems = self.Items;
        stack u64[0 2 ** 63 - 1] byteLength = (u64[0 2 ** 63 - 1])(nextCapacity * elementSize);
        stack System.Memory.Allocation nextAllocation = System.Memory.Allocate(self.Allocator, byteLength, alignof(T));
        if (nextAllocation.Pointer == null)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        stack rawmutptr<T> nextItems = (rawmutptr<T>)nextAllocation.Pointer;
        for willexit (stack mut u64[0 2 ** 63 - 1] offset = 0; offset < length; offset += 1)
        {
            stack mut u64[0 2 ** 63 - 1] sourceIndex = (u64[0 2 ** 63 - 1])(oldHead + offset);
            if (sourceIndex >= oldCapacity)
            {
                sourceIndex = (u64[0 2 ** 63 - 1])(sourceIndex - oldCapacity);
            }

            *(&nextItems[offset]) = *(&oldItems[sourceIndex]);
        }

        if (self.Allocation.Pointer != null)
        {
            System.Memory.Free(self.Allocation);
        }

        self.Allocation = nextAllocation;
        self.Items = nextItems;
        self.StorageCapacity = nextCapacity;
        *head = 0;
        return System.Memory.MemoryStatus.Ok;
    }

    unsafe inline fn void Write(mut borrow SparseSlots<T> self, u64[0 2 ** 63 - 1] index, T value)
    {
        *(&self.Items[index]) = value;
        return;
    }

    unsafe inline fn T MoveAt(mut borrow SparseSlots<T> self, u64[0 2 ** 63 - 1] index)
    {
        return *(&self.Items[index]);
    }

    unsafe inline law retborrow T Get(borrow SparseSlots<T> self, u64[0 2 ** 63 - 1] index)
    {
        return self.Items[index];
    }
}

public struct Queue<T>
{
    internal SparseSlots<T> Items;
    internal u64[0 2 ** 63 - 1] Head;
    internal u64[0 2 ** 63 - 1] Length;

    Queue()
    {
        self.Items = new();
        self.Head = 0;
        self.Length = 0;
    }

    Queue(System.Memory.Allocator allocator)
    {
        self.Items = new(allocator);
        self.Head = 0;
        self.Length = 0;
    }

    mut drop
    {
        self.Clear();
    }

    inline finite law u64[0 2 ** 63 - 1] Count(borrow Queue<T> self)
    {
        return self.Length;
    }

    inline finite law bool IsEmpty(borrow Queue<T> self)
    {
        return self.Length == 0;
    }

    fn System.Memory.MemoryStatus Reserve(mut borrow Queue<T> self, u64[0 2 ** 63 - 1] additional)
    {
        stack mut u64[0 2 ** 63 - 1] nextCapacity = self.Items.Capacity();
        stack System.Memory.MemoryStatus capacityStatus =
            ComputeContiguousGrowthCapacity(self.Length, self.Items.Capacity(), additional, 4, nextCapacity);
        switch (capacityStatus)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        if (nextCapacity <= self.Items.Capacity())
        {
            return System.Memory.MemoryStatus.Ok;
        }

        unsafe
        {
            return self.Items.ReserveRing(&self.Head, self.Length, nextCapacity);
        }
    }

    fn System.Memory.MemoryStatus Enqueue(mut borrow Queue<T> self, T value)
    {
        stack System.Memory.MemoryStatus status = self.Reserve(1);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        unsafe
        {
            stack mut u64[0 2 ** 63 - 1] tail = (u64[0 2 ** 63 - 1])(self.Head + self.Length);
            if (tail >= self.Items.Capacity())
            {
                tail = (u64[0 2 ** 63 - 1])(tail - self.Items.Capacity());
            }

            self.Items.Write(tail, value);
        }

        self.Length += 1;
        return System.Memory.MemoryStatus.Ok;
    }

    fn bool TryDequeue(mut borrow Queue<T> self, out T value)
    {
        if (self.Length == 0)
        {
            return false;
        }

        unsafe
        {
            value = self.Items.MoveAt(self.Head);
        }

        self.Head += 1;
        if (self.Head >= self.Items.Capacity())
        {
            self.Head = 0;
        }

        self.Length -= 1;
        if (self.Length == 0)
        {
            self.Head = 0;
        }

        return true;
    }

    law retborrow T Peek(borrow Queue<T> self)
    {
        unsafe
        {
            return self.Items.Get(self.Head);
        }
    }

    fn void Clear(mut borrow Queue<T> self)
    {
        unsafe
        {
            while willexit (self.Length > 0)
            {
                stack T slot = self.Items.MoveAt(self.Head);

                self.Head += 1;
                if (self.Head >= self.Items.Capacity())
                {
                    self.Head = 0;
                }

                self.Length -= 1;
            }
        }

        self.Head = 0;
        return;
    }
}

public struct RingQueue<T>
{
    internal SparseSlots<T> Slots;
    internal u64[0 2 ** 63 - 1] Head;
    internal u64[0 2 ** 63 - 1] Length;

    RingQueue()
    {
        self.Slots = new();
        self.Head = 0;
        self.Length = 0;
    }

    mut drop
    {
        self.Clear();
    }

    inline finite law u64[0 2 ** 63 - 1] Count(borrow RingQueue<T> self)
    {
        return self.Length;
    }

    inline finite law u64[0 2 ** 63 - 1] Capacity(borrow RingQueue<T> self)
    {
        return self.Slots.Capacity();
    }

    inline finite law bool IsEmpty(borrow RingQueue<T> self)
    {
        return self.Length == 0;
    }

    fn System.Memory.MemoryStatus Reserve(mut borrow RingQueue<T> self, u64[0 2 ** 63 - 1] additional)
    {
        stack mut u64[0 2 ** 63 - 1] nextCapacity = self.Slots.Capacity();
        stack System.Memory.MemoryStatus capacityStatus =
            ComputeContiguousGrowthCapacity(self.Length, self.Slots.Capacity(), additional, 4, nextCapacity);
        switch (capacityStatus)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        if (nextCapacity <= self.Slots.Capacity())
        {
            return System.Memory.MemoryStatus.Ok;
        }

        unsafe
        {
            return self.Slots.ReserveRing(&self.Head, self.Length, nextCapacity);
        }
    }

    fn System.Memory.MemoryStatus Enqueue(mut borrow RingQueue<T> self, T value)
    {
        stack System.Memory.MemoryStatus status = self.Reserve(1);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        stack mut u64[0 2 ** 63 - 1] tail = (u64[0 2 ** 63 - 1])(self.Head + self.Length);
        if (tail >= self.Slots.Capacity())
        {
            tail = (u64[0 2 ** 63 - 1])(tail - self.Slots.Capacity());
        }

        unsafe
        {
            self.Slots.Write(tail, value);
        }

        self.Length += 1;
        return System.Memory.MemoryStatus.Ok;
    }

    fn bool TryDequeue(mut borrow RingQueue<T> self, out T value)
    {
        if (self.Length == 0)
        {
            return false;
        }

        unsafe
        {
            value = self.Slots.MoveAt(self.Head);
        }

        self.Head += 1;
        if (self.Head >= self.Slots.Capacity())
        {
            self.Head = 0;
        }

        self.Length -= 1;
        if (self.Length == 0)
        {
            self.Head = 0;
        }

        return true;
    }

    law retborrow T Peek(borrow RingQueue<T> self)
    {
        unsafe
        {
            return self.Slots.Get(self.Head);
        }
    }

    fn void Clear(mut borrow RingQueue<T> self)
    {
        unsafe
        {
            while willexit (self.Length > 0)
            {
                stack T slot = self.Slots.MoveAt(self.Head);

                self.Head += 1;
                if (self.Head >= self.Slots.Capacity())
                {
                    self.Head = 0;
                }

                self.Length -= 1;
            }
        }

        self.Head = 0;
        return;
    }
}

public enum DictionaryRemoveResult<T>
{
    Missing,
    Removed(T),
}

// Raw pointer boundary: Dictionary keeps sparse key/value/control storage so it
// can leave empty hash-table slots uninitialized while still returning mutable
// borrows from occupied values. A dynamic enum-slot rewrite currently moves
// generic payloads during lookup/removal instead of projecting stable mutable
// borrows, so this internal boundary stays until sparse-slot borrows are a
// first-class language/storage feature.
public struct Dictionary<K, V>
{
    internal rawmutptr<K> Keys;
    internal rawmutptr<V> Values;
    internal rawmutptr<u8[0 2]> States;
    internal System.Memory.Allocation KeysAllocation;
    internal System.Memory.Allocation ValuesAllocation;
    internal System.Memory.Allocation StatesAllocation;
    internal u64[0 2 ** 63 - 1] Length;
    internal u64[0 2 ** 63 - 1] StorageCapacity;
    internal System.Memory.Allocator Allocator;

    Dictionary()
    {
        self.Allocator = System.Memory.Allocator.Default();
        self.Keys = null;
        self.Values = null;
        self.States = null;
        self.KeysAllocation = new System.Memory.Allocation()
        {
            Pointer = null,
            ByteLength = 0,
            Alignment = alignof(K),
            Allocator = self.Allocator
        };
        self.ValuesAllocation = new System.Memory.Allocation()
        {
            Pointer = null,
            ByteLength = 0,
            Alignment = alignof(V),
            Allocator = self.Allocator
        };
        self.StatesAllocation = new System.Memory.Allocation()
        {
            Pointer = null,
            ByteLength = 0,
            Alignment = alignof(i64[min max]),
            Allocator = self.Allocator
        };
        self.Length = 0;
        self.StorageCapacity = 0;
    }

    Dictionary(System.Memory.Allocator allocator)
    {
        self.Allocator = allocator;
        self.Keys = null;
        self.Values = null;
        self.States = null;
        self.KeysAllocation = new System.Memory.Allocation()
        {
            Pointer = null,
            ByteLength = 0,
            Alignment = alignof(K),
            Allocator = allocator
        };
        self.ValuesAllocation = new System.Memory.Allocation()
        {
            Pointer = null,
            ByteLength = 0,
            Alignment = alignof(V),
            Allocator = allocator
        };
        self.StatesAllocation = new System.Memory.Allocation()
        {
            Pointer = null,
            ByteLength = 0,
            Alignment = alignof(i64[min max]),
            Allocator = allocator
        };
        self.Length = 0;
        self.StorageCapacity = 0;
    }

    mut drop
    {
        self.Clear();
        if (self.KeysAllocation.Pointer != null)
        {
            System.Memory.Free(self.KeysAllocation);
        }

        if (self.ValuesAllocation.Pointer != null)
        {
            System.Memory.Free(self.ValuesAllocation);
        }

        if (self.StatesAllocation.Pointer != null)
        {
            System.Memory.Free(self.StatesAllocation);
        }

        self.Keys = null;
        self.Values = null;
        self.States = null;
        self.StorageCapacity = 0;
    }

    inline finite law u64[0 2 ** 63 - 1] Count(borrow Dictionary<K, V> self)
    {
        return self.Length;
    }

    inline finite law u64[0 2 ** 63 - 1] Capacity(borrow Dictionary<K, V> self)
    {
        return self.StorageCapacity;
    }

    inline finite law bool IsEmpty(borrow Dictionary<K, V> self)
    {
        return self.Length == 0;
    }

    inline finite law bool ContainsIndex(borrow Dictionary<K, V> self, u64[0 2 ** 63 - 1] index)
    {
        unsafe
        {
            if (index >= self.StorageCapacity)
            {
                return false;
            }

            return *(&self.States[index]) == 1;
        }
    }

    law retborrow V GetAtIndex(borrow Dictionary<K, V> self, u64[0 2 ** 63 - 1] index)
    {
        return self.Values[index];
    }

    fn retborrow mut V GetMutAtIndex(mut borrow Dictionary<K, V> self, u64[0 2 ** 63 - 1] index)
    {
        return self.Values[index];
    }

    internal unsafe inline finite void InitializeStates(
        borrow Dictionary<K, V> self,
        u64[0 2 ** 63 - 1] capacity,
        rawmutptr<u8[0 2]> states)
        {
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < capacity; index += 1)
        {
            *(&states[index]) = 0;
        }
    }

    internal unsafe inline fn void InsertEntryIntoStorage(
        mut borrow Dictionary<K, V> self,
        u64[0 2 ** 63 - 1] capacity,
        rawmutptr<K> keys,
        rawmutptr<V> values,
        rawmutptr<u8[0 2]> states,
        K key,
        V value)
        where overlap(self, keys),
              overlap(self, values),
              overlap(self, states)
    {
        stack u64[0 2 ** 63 - 1] storageMask = (u64[0 2 ** 63 - 1])(capacity - 1);
        stack mut K pendingKey = key;
        stack mut V pendingValue = value;
        stack mut u64[0 2 ** 63 - 1] index =
            (u64[0 2 ** 63 - 1])(DictionaryKey.Hash(pendingKey) & (u64[0 max])storageMask);
        stack mut u64[0 2 ** 63 - 1] distance = 0;
        stack mut u64[0 2 ** 63 - 1] probe = 0;

        while willexit (probe < capacity)
        {
            stack u8[0 2] state = *(&states[index]);
            if (state != 1)
            {
                *(&keys[index]) = pendingKey;
