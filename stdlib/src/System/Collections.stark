            {
                return System.Memory.MemoryStatus.Ok;
            }

            stack u64[0 2 ** 63 - 1] keySize = sizeof(K);
            stack u64[0 2 ** 63 - 1] valueSize = sizeof(V);
            stack u64[0 2 ** 63 - 1] stateSize = sizeof(u8[0 2]);
