    internal inline fn void BackwardShiftDelete(
        mut borrow Dictionary<K, V> self,
        u64[0 2 ** 63 - 1] removedIndex)
    {
            unsafe
            {
            stack u64[0 2 ** 63 - 1] storageMask = (u64[0 2 ** 63 - 1])(self.StorageCapacity - 1);
            stack mut u64[0 2 ** 63 - 1] holeIndex = removedIndex;
            stack mut u64[0 2 ** 63 - 1] scanIndex = (u64[0 2 ** 63 - 1])(removedIndex + 1);
            if (scanIndex >= self.StorageCapacity)
            {
                scanIndex = 0;
            }

            stack mut u64[0 2 ** 63 - 1] probe = 1;
            while willexit (probe < self.StorageCapacity)
            {
                stack u8[0 2] state = *(&self.States[scanIndex]);
                if (state == 0)
                {
                    *(&self.States[holeIndex]) = 0;
                    return;
                }

                if (state == 1)
                {
                    stack u64[0 2 ** 63 - 1] homeIndex =
                        (u64[0 2 ** 63 - 1])(DictionaryKey.Hash(self.Keys[scanIndex]) & (u64[0 max])storageMask);
                    stack u64[0 2 ** 63 - 1] scanDistance =
                        (u64[0 2 ** 63 - 1])(((scanIndex + self.StorageCapacity) - homeIndex) & storageMask);

                    if (scanDistance == 0)
                    {
                        *(&self.States[holeIndex]) = 0;
                        return;
                    }

                    stack K shiftedKey = *(&self.Keys[scanIndex]);
                    stack V shiftedValue = *(&self.Values[scanIndex]);
                    *(&self.Keys[holeIndex]) = shiftedKey;
                    *(&self.Values[holeIndex]) = shiftedValue;
                    *(&self.States[holeIndex]) = 1;
                    holeIndex = scanIndex;
