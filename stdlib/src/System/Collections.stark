                {
                    stack K movedKey = *(&self.Keys[oldIndex]);
                    stack V movedValue = *(&self.Values[oldIndex]);
                    self.InsertEntryIntoStorage(nextCapacity, nextKeys, nextValues, nextStates, movedKey, movedValue);
