    fn System.Memory.MemoryStatus Reserve(mut borrow Dictionary<K, V> self, u64[0 2 ** 63 - 1] additional) {
        unsafe {
            stack mut u64[0 2 ** 63 - 1] nextCapacity = self.StorageCapacity;
