internal finite law u64[0 2 ** 63 - 1] LinkedListNoneIndex()
{
    return (u64[0 2 ** 63 - 1])(2 ** 63 - 1);
}

internal struct LinkedListLinks
{
    u64[0 2 ** 63 - 1] Next;
    u64[0 2 ** 63 - 1] Previous;
}

internal enum LinkedListValueSlot<T>
{
    Free,
    Occupied(T),
}

public struct LinkedList<T>
{
    internal dynamic LinkedListValueSlot<T> Values;
    internal dynamic LinkedListLinks Links;
    internal u64[0 2 ** 63 - 1] Head;
    internal u64[0 2 ** 63 - 1] Tail;
    internal u64[0 2 ** 63 - 1] FreeHead;
    internal u64[0 2 ** 63 - 1] Length;

    LinkedList()
    {
        self.Values = new();
        self.Links = new();
        self.Head = LinkedListNoneIndex();
        self.Tail = LinkedListNoneIndex();
        self.FreeHead = LinkedListNoneIndex();
        self.Length = 0;
    }

    mut drop
    {
        self.Clear();
    }

    inline finite law u64[0 2 ** 63 - 1] Count(borrow LinkedList<T> self)
    {
        return self.Length;
    }

    inline finite law bool IsEmpty(borrow LinkedList<T> self)
    {
        return self.Length == 0;
    }

    fn System.Memory.MemoryStatus ReserveNodes(mut borrow LinkedList<T> self, u64[0 2 ** 63 - 1] count)
    {
        if (count == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u64[0 2 ** 63 - 1] valueByteLength = sizeof(LinkedListValueSlot<T>);
        stack u64[0 2 ** 63 - 1] linkByteLength = sizeof(LinkedListLinks);
        if (valueByteLength == 0 || linkByteLength == 0)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        if (count > LinkedListNoneIndex() - self.Values.Length)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
        }

        if (count > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) / valueByteLength || count > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) / linkByteLength)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
        }

        if (self.Values.Length != self.Links.Length)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        if (!self.Values.TryReserve(count) || !self.Links.TryReserve(count))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        return System.Memory.MemoryStatus.Ok;
    }

    fn System.Memory.MemoryStatus AddFirst(mut borrow LinkedList<T> self, T value)
    {
        stack mut u64[0 2 ** 63 - 1] index = 0;
        stack System.Memory.MemoryStatus status =
            self.AllocateNode(value, self.Head, LinkedListNoneIndex(), index);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        if (self.Head != LinkedListNoneIndex())
        {
            if (!self.SetPrevious(self.Head, index))
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }
        }
        else
        {
            self.Tail = index;
        }

        self.Head = index;
        self.Length += 1;
        return System.Memory.MemoryStatus.Ok;
    }

    fn System.Memory.MemoryStatus AddLast(mut borrow LinkedList<T> self, T value)
    {
        stack mut u64[0 2 ** 63 - 1] index = 0;
        stack System.Memory.MemoryStatus status =
            self.AllocateNode(value, LinkedListNoneIndex(), self.Tail, index);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }

        if (self.Tail != LinkedListNoneIndex())
        {
            if (!self.SetNext(self.Tail, index))
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
            }
        }
        else
        {
            self.Head = index;
        }

        self.Tail = index;
        self.Length += 1;
        return System.Memory.MemoryStatus.Ok;
    }

    fn bool TryRemoveFirst(mut borrow LinkedList<T> self, out T value)
    {
        if (self.Head == LinkedListNoneIndex())
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] index = self.Head;
        stack mut u64[0 2 ** 63 - 1] next = LinkedListNoneIndex();
        if (!self.RemoveNode(index, value, next))
        {
            return false;
        }

        self.Head = next;
        if (next != LinkedListNoneIndex())
        {
            if (!self.SetPrevious(next, LinkedListNoneIndex()))
            {
                return false;
            }
        }
        else
        {
            self.Tail = LinkedListNoneIndex();
        }

        self.Length -= 1;
        return true;
    }

    fn bool TryRemoveLast(mut borrow LinkedList<T> self, out T value)
    {
        if (self.Tail == LinkedListNoneIndex())
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] index = self.Tail;
        stack mut u64[0 2 ** 63 - 1] previous = LinkedListNoneIndex();
        if (!self.RemoveNodeFromTail(index, value, previous))
        {
            return false;
        }

        self.Tail = previous;
        if (previous != LinkedListNoneIndex())
        {
            if (!self.SetNext(previous, LinkedListNoneIndex()))
            {
                return false;
            }
        }
        else
        {
            self.Head = LinkedListNoneIndex();
        }

        self.Length -= 1;
        return true;
    }

    fn void Clear(mut borrow LinkedList<T> self)
    {
        while willexit (self.Head != LinkedListNoneIndex())
        {
            stack u64[0 2 ** 63 - 1] index = self.Head;
            stack mut u64[0 2 ** 63 - 1] next = LinkedListNoneIndex();
            unsafe
            {
                stack LinkedListValueSlot<T> slot = self.Values[index];
                switch (slot)
                {
                    case LinkedListValueSlot<T>.Occupied(var payload):
                        stack T value = payload;
                        next = self.Links[index].Next;
                        self.Values[index] = LinkedListValueSlot<T>.Free;
                        self.Links[index] = new LinkedListLinks()
                        {
                            Next = self.FreeHead,
                            Previous = LinkedListNoneIndex()
                        };
                        self.FreeHead = index;
                    case LinkedListValueSlot<T>.Free:
                        self.Head = LinkedListNoneIndex();
                        self.Tail = LinkedListNoneIndex();
                        self.Length = 0;
                        return;
                }
            }

            self.Head = next;
            self.Length -= 1;
        }

        self.Tail = LinkedListNoneIndex();
        return;
    }

    internal fn System.Memory.MemoryStatus AllocateNode(
        mut borrow LinkedList<T> self,
        T value,
        u64[0 2 ** 63 - 1] next,
        u64[0 2 ** 63 - 1] previous,
        out u64[0 2 ** 63 - 1] index)
    {
        if (self.Values.Length != self.Links.Length)
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        if (self.FreeHead != LinkedListNoneIndex())
        {
            index = self.FreeHead;
            stack u64[0 2 ** 63 - 1] freeNext = self.Links[index].Next;
            unsafe
            {
                self.FreeHead = freeNext;
                self.Links[index] = new LinkedListLinks()
                {
                    Next = next,
                    Previous = previous
                };
                self.Values[index] = LinkedListValueSlot<T>.Occupied(value);
            }

            return System.Memory.MemoryStatus.Ok;
        }

        if (self.Values.Length == LinkedListNoneIndex())
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
        }

        if (self.Values.Length >= self.Values.Capacity || self.Links.Length >= self.Links.Capacity)
        {
            stack System.Memory.MemoryStatus reserveStatus = self.ReserveNodes(1);
            switch (reserveStatus)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        index = self.Values.Length;
        init self.Values[index] = LinkedListValueSlot<T>.Occupied(value);
        init self.Links[self.Links.Length] = new LinkedListLinks()
        {
            Next = next,
            Previous = previous
        };

        return System.Memory.MemoryStatus.Ok;
    }

    internal fn bool SetNext(mut borrow LinkedList<T> self, u64[0 2 ** 63 - 1] index, u64[0 2 ** 63 - 1] next)
    {
        self.Links[index].Next = next;
        return true;
    }

    internal fn bool SetPrevious(mut borrow LinkedList<T> self, u64[0 2 ** 63 - 1] index, u64[0 2 ** 63 - 1] previous)
    {
        self.Links[index].Previous = previous;
        return true;
    }

    internal fn bool RemoveNode(mut borrow LinkedList<T> self, u64[0 2 ** 63 - 1] index, out T value, out u64[0 2 ** 63 - 1] next)
    {
        next = self.Links[index].Next;
        unsafe
        {
            stack LinkedListValueSlot<T> slot = self.Values[index];
            switch (slot)
            {
                case LinkedListValueSlot<T>.Occupied(var payload):
                    value = payload;
                    self.Values[index] = LinkedListValueSlot<T>.Free;
                    self.Links[index] = new LinkedListLinks()
                    {
                        Next = self.FreeHead,
                        Previous = LinkedListNoneIndex()
                    };
                    self.FreeHead = index;
                    return true;
                case LinkedListValueSlot<T>.Free:
                    return false;
            }
        }
    }

    internal fn bool RemoveNodeFromTail(mut borrow LinkedList<T> self, u64[0 2 ** 63 - 1] index, out T value, out u64[0 2 ** 63 - 1] previous)
    {
        previous = self.Links[index].Previous;
        unsafe
        {
            stack LinkedListValueSlot<T> slot = self.Values[index];
            switch (slot)
            {
                case LinkedListValueSlot<T>.Occupied(var payload):
                    value = payload;
                    self.Values[index] = LinkedListValueSlot<T>.Free;
                    self.Links[index] = new LinkedListLinks()
                    {
                        Next = self.FreeHead,
                        Previous = LinkedListNoneIndex()
                    };
                    self.FreeHead = index;
                    return true;
                case LinkedListValueSlot<T>.Free:
                    return false;
            }
        }
    }
}
