            }

            stack System.Memory.Allocation nextValuesAllocation = System.Memory.Allocate(self.Allocator, valuesByteLength, alignof(V));
            if (nextValuesAllocation.Pointer == null)
            {
                System.Memory.Free(nextKeysAllocation);
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
            }

            stack System.Memory.Allocation nextStatesAllocation =
                System.Memory.Allocate(self.Allocator, statesByteLength, alignof(i64[min max]));
            if (nextStatesAllocation.Pointer == null)
            {
                System.Memory.Free(nextValuesAllocation);
                System.Memory.Free(nextKeysAllocation);
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
            }

            stack rawmutptr<K> nextKeys = (rawmutptr<K>)nextKeysAllocation.Pointer;
            stack rawmutptr<V> nextValues = (rawmutptr<V>)nextValuesAllocation.Pointer;
            stack rawmutptr<u8[0 2]> nextStates = (rawmutptr<u8[0 2]>)nextStatesAllocation.Pointer;

