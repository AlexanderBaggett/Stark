            if (nextCapacity > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) / keySize
                || nextCapacity > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) / valueSize
                || nextCapacity > (u64[0 2 ** 63 - 1])(2 ** 63 - 1) / stateSize)
                {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
