    inline fn System.Memory.MemoryStatus Set(mut borrow Dictionary<K, V> self, K key, V value)
    {
        unsafe
        {
            if (self.Length == (u64[0 2 ** 63 - 1])(2 ** 63 - 1))
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
            }

            stack u64[0 max] keyHash = DictionaryKey.Hash(key);
            stack mut bool foundExisting = false;
            if (self.StorageCapacity > 0)
            {
                stack u64[0 2 ** 63 - 1] existingIndex = self.FindInsertionIndex(key, keyHash, foundExisting);
                if (foundExisting)
                {
                    stack V oldValue = *(&self.Values[existingIndex]);
                    *(&self.Values[existingIndex]) = value;
                    return System.Memory.MemoryStatus.Ok;
                }
            }

            stack u64[0 2 ** 63 - 1] required = (u64[0 2 ** 63 - 1])(self.Length + 1);
            stack mut bool shouldGrow = self.StorageCapacity == 0 || required >= self.StorageCapacity;
            if (!shouldGrow)
            {
                if (required > (u64[0 2 ** 63 - 1])(2 ** 62 - 1))
                {
                    shouldGrow = true;
