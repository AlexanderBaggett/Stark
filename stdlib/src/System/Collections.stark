public struct LinkedList<T> {
    internal rawmutptr<LinkedListNode<T>> Head;
    internal rawmutptr<LinkedListNode<T>> Tail;
    internal i64[0 max] Length;
    internal System.Memory.Allocator Allocator;

    LinkedList() {
        self.Head = null;
        self.Tail = null;
        self.Length = 0;
        self.Allocator = System.Memory.Allocator.Default();
    }

    LinkedList(System.Memory.Allocator allocator) {
        self.Head = null;
        self.Tail = null;
        self.Length = 0;
        self.Allocator = allocator;
    }

    mut drop {
        self.Clear();
    }

    finite law i64[0 max] Count(borrow LinkedList<T> self) {
        return self.Length;
    }

    finite law bool IsEmpty(borrow LinkedList<T> self) {
        return self.Length == 0;
    }

    fn System.Memory.MemoryStatus AddFirst(mut borrow LinkedList<T> self, T value) {
        stack i64[0 max] nodeByteLength = sizeof(LinkedListNode<T>);
        if (nodeByteLength == 0) {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        stack System.Memory.Allocation nodeAllocation = System.Memory.Allocate(self.Allocator, nodeByteLength, alignof(LinkedListNode<T>));
        if (nodeAllocation.Pointer == null) {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        stack rawmutptr<LinkedListNode<T>> node = (rawmutptr<LinkedListNode<T>>)nodeAllocation.Pointer;
        (*node).Next = self.Head;
        (*node).Previous = null;
        (*node).Value = value;

        if (self.Head != null) {
            (*self.Head).Previous = node;
        }
        else {
            self.Tail = node;
        }

        self.Head = node;
        self.Length += 1;
        return System.Memory.MemoryStatus.Ok;
    }

    fn System.Memory.MemoryStatus AddLast(mut borrow LinkedList<T> self, T value) {
        stack i64[0 max] nodeByteLength = sizeof(LinkedListNode<T>);
        if (nodeByteLength == 0) {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.InvalidLayout);
        }

        stack System.Memory.Allocation nodeAllocation = System.Memory.Allocate(self.Allocator, nodeByteLength, alignof(LinkedListNode<T>));
        if (nodeAllocation.Pointer == null) {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        stack rawmutptr<LinkedListNode<T>> node = (rawmutptr<LinkedListNode<T>>)nodeAllocation.Pointer;
        (*node).Next = null;
        (*node).Previous = self.Tail;
        (*node).Value = value;

        if (self.Tail != null) {
            (*self.Tail).Next = node;
        }
        else {
            self.Head = node;
        }

        self.Tail = node;
        self.Length += 1;
        return System.Memory.MemoryStatus.Ok;
    }

    fn bool TryRemoveFirst(mut borrow LinkedList<T> self, out T value) {
        if (self.Head == null) {
            return false;
        }

        stack rawmutptr<LinkedListNode<T>> node = self.Head;
        stack rawmutptr<LinkedListNode<T>> next = (*node).Next;
        if (next != null) {
            (*next).Previous = null;
        }
        else {
            self.Tail = null;
        }

        value = (*node).Value;
        System.Memory.Free(new System.Memory.Allocation() {
            Pointer = (rawmutptr<i8[-128 127]>)node,
            ByteLength = sizeof(LinkedListNode<T>),
            Alignment = alignof(LinkedListNode<T>),
            Allocator = self.Allocator
        });

        self.Head = next;
        self.Length -= 1;
        return true;
    }

    fn bool TryRemoveLast(mut borrow LinkedList<T> self, out T value) {
        if (self.Tail == null) {
            return false;
        }

        stack rawmutptr<LinkedListNode<T>> node = self.Tail;
        stack rawmutptr<LinkedListNode<T>> previous = (*node).Previous;
        if (previous != null) {
            (*previous).Next = null;
        }
        else {
            self.Head = null;
        }

        value = (*node).Value;
        System.Memory.Free(new System.Memory.Allocation() {
            Pointer = (rawmutptr<i8[-128 127]>)node,
            ByteLength = sizeof(LinkedListNode<T>),
            Alignment = alignof(LinkedListNode<T>),
            Allocator = self.Allocator
        });

        self.Tail = previous;
        self.Length -= 1;
        return true;
    }

    fn void Clear(mut borrow LinkedList<T> self) {
        stack mut rawmutptr<LinkedListNode<T>> current = self.Head;
        while willexit (current != null) {
            stack rawmutptr<LinkedListNode<T>> next = (*current).Next;
            stack T value = (*current).Value;
            System.Memory.Free(new System.Memory.Allocation() {
                Pointer = (rawmutptr<i8[-128 127]>)current,
                ByteLength = sizeof(LinkedListNode<T>),
                Alignment = alignof(LinkedListNode<T>),
                Allocator = self.Allocator
            });

            current = next;
        }

        self.Head = null;
        self.Tail = null;
