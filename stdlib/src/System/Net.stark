module System.Net

public enum NetworkError
{
    AddressInvalid,
    AddressInUse,
    ConnectionRefused,
    ConnectionReset,
    TimedOut,
    NotConnected,
    WouldBlock,
    Unsupported,
    Unknown(i32[min max]),
}

public enum NetStatus
{
    [Ok] Ok,
    [Err] Err(NetworkError),
}

public enum NetResult<T>
{
    [Ok] Ok(T),
    [Err] Err(NetworkError),
}

public struct IPv4Address
{
    u8[0 max] A;
    u8[0 max] B;
    u8[0 max] C;
    u8[0 max] D;
}

public struct IPv4Endpoint
{
    IPv4Address Address;
    u16[0 max] Port;
}
