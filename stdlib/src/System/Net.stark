module System.Net

public enum NetworkError {
    AddressInvalid,
    AddressInUse,
    ConnectionRefused,
    ConnectionReset,
    TimedOut,
    NotConnected,
    WouldBlock,
    Unsupported,
    Unknown(i32[-2147483648 2147483647]),
}

public enum NetStatus {
    Ok,
    Err(NetworkError),
}

public enum NetResult<T> {
    Ok(T),
    Err(NetworkError),
}

public struct IPv4Address {
    u8[0 255] A;
    u8[0 255] B;
    u8[0 255] C;
    u8[0 255] D;
}

public struct IPv4Endpoint {
    IPv4Address Address;
    u16[0 65535] Port;
}
