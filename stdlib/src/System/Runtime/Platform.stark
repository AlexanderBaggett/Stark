internal unsafe fn FileOpenResult OpenFileReadResult(ascii path)
{
    switch (System.Runtime.Platform.Linux.OpenFileReadResult(path))
    {
        case System.Runtime.Platform.Linux.FileOpenResult.Ok(var handle):
            return FileOpenResult.Ok(handle);
        case System.Runtime.Platform.Linux.FileOpenResult.Err(var error):
            return FileOpenResult.Err(error);
    }
}

