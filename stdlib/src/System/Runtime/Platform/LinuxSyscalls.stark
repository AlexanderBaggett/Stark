module System.Runtime.Platform.LinuxSyscalls

// Linux syscall identities are architecture ABI facts, not portable constants.
// x86_64 values come from arch/x86/entry/syscalls/syscall_64.tbl; AArch64
// and RISC-V values come from include/uapi/asm-generic/unistd.h. The x86 and
// ARM32 overloads deliberately report ENOSYS because Stark release targets are
// 64-bit only.

internal unsafe ffi asm(x86_64) fn i64[min max] LinuxKernelOpenDirectory(
    i64[min max] directoryHandle,
    rawptr<i8[min max]> path)
    in("rdi") directoryHandle,
    in("rsi") path,
    out("rax") return,
    clobber("rdx", "r10", "rcx", "r11")
{
    "movq $$257, %rax\nmovq $$589824, %rdx\nxorq %r10, %r10\nsyscall"
}

internal unsafe ffi asm(aarch64) fn i64[min max] LinuxKernelOpenDirectory(
    i64[min max] directoryHandle,
    rawptr<i8[min max]> path)
    in("x0") directoryHandle,
    in("x1") path,
    out("x0") return,
    clobber("x2", "x3", "x8")
{
    "movz x2, #0x4000\nmovk x2, #0x8, lsl #16\nmov x3, xzr\nmov x8, #56\nsvc #0"
}

internal unsafe ffi asm(riscv64) fn i64[min max] LinuxKernelOpenDirectory(
    i64[min max] directoryHandle,
    rawptr<i8[min max]> path)
    in("a0") directoryHandle,
    in("a1") path,
    out("a0") return,
    clobber("a2", "a3", "a7")
{
    "li a2, 540672\nli a3, 0\nli a7, 56\necall"
}

internal unsafe ffi asm(x86) fn i64[min max] LinuxKernelOpenDirectory(
    i64[min max] directoryHandle,
    rawptr<i8[min max]> path)
    in("ebx") directoryHandle,
    in("ecx") path,
    out("eax") return
{
    "movl $$-38, %eax"
}

internal unsafe ffi asm(arm) fn i64[min max] LinuxKernelOpenDirectory(
    i64[min max] directoryHandle,
    rawptr<i8[min max]> path)
    in("r0") directoryHandle,
    in("r1") path,
    out("r0") return
{
    "mov r0, #0\nsub r0, r0, #38"
}

