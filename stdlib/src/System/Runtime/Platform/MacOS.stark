internal unsafe inline fn i32[min max] CloseFile(rawptr<i8[min max]> handle)
{
    if (handle == null)
    {
        return 0;
    }

    stack rawptr<MacOSHandle> typedHandle = (rawptr<MacOSHandle>)handle;
    stack System.Memory.Allocation allocation = new System.Memory.Allocation()
    {
        Pointer = (*typedHandle).AllocationPointer,
        ByteLength = (u64[0 2 ** 63 - 1])sizeof(MacOSHandle),
        Alignment = alignof(MacOSHandle),
        Allocator = System.Memory.Allocator.Default()
    };
    stack i32[min max] result = close((*typedHandle).FileDescriptor);
    System.Memory.Free(allocation);
    if (result == 0)
    {
        return 0;
    }

    return NegativeErrno();
}

