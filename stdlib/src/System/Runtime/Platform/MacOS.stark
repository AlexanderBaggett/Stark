internal enum FileOpenResult
{
    Ok(rawptr<i8[min max]>),
    Err(i32[min max]),
}

internal unsafe fn i32[min max] NegativeErrno()
{
    stack rawmutptr<i32[min max]> errorPointer = __error();
    if (errorPointer == null)
    {
        return -1;
    }

    stack i32[min max] error = *errorPointer;
    if (error <= 0)
    {
        return -1;
    }

    return -error;
}

internal unsafe fn rawptr<i8[min max]> FdToHandle(i32[min max] fileDescriptor)
{
    if (fileDescriptor < 0)
    {
        return null;
    }

    stack System.Memory.Allocation allocation = System.Memory.Allocate(
        System.Memory.Allocator.Default(),
        (u64[0 2 ** 63 - 1])sizeof(MacOSHandle),
        alignof(MacOSHandle));
    if (allocation.Pointer == null)
    {
        close(fileDescriptor);
        return null;
    }

    stack rawmutptr<MacOSHandle> handle = (rawmutptr<MacOSHandle>)allocation.Pointer;
    *handle = new MacOSHandle()
    {
        FileDescriptor = fileDescriptor,
        AllocationPointer = allocation.Pointer
    };
    return (rawptr<i8[min max]>)handle;
}

internal unsafe inline finite law i32[min max] HandleToFd(rawptr<i8[min max]> handle)
{
    if (handle == null)
    {
        return -1;
    }

    stack rawptr<MacOSHandle> typedHandle = (rawptr<MacOSHandle>)handle;
    return (*typedHandle).FileDescriptor;
}

internal unsafe fn bool TryBuildMacOSPath(rawmutptr<Ascii> destination, ascii path)
{
    return TryConcatAscii(destination, path, "\0");
}

internal unsafe fn i64[min max] CStringLength(rawptr<i8[min max]> data, i64[min max] capacity)
{
    if (data == null || capacity <= 0)
    {
        return 0;
    }

    stack mut i64[min max] length = 0;
    while willexit (length < capacity)
    {
        if (*(&data[length]) == (i8[min max])0)
        {
            return length;
        }

        length += 1;
    }

    return capacity;
}

internal fn i32[min max] UnsignedShort(i16[min max] value)
{
    if (value < 0)
    {
        return ((i32[min max])value) + (i32[min max])(2 ** 16);
    }

    return (i32[min max])value;
}

internal fn i32[min max] UnsignedByte(i8[min max] value)
{
    if (value < 0)
    {
        return ((i32[min max])value) + 256;
    }

    return (i32[min max])value;
}

internal unsafe finite law bool IsDotDirectoryEntry(rawptr<i8[min max]> data, i64[min max] length)
{
    if (data == null)
    {
        return false;
    }

    if (length == 1)
    {
        return *(&data[0]) == (i8[min max])46;
    }

    if (length == 2)
    {
        return *(&data[0]) == (i8[min max])46 && *(&data[1]) == (i8[min max])46;
    }

    return false;
}

internal inline fn i32[min max] DirectoryEntryKindFromMacOSType(i32[min max] entryType)
{
    if (entryType == MacOSDirectoryEntryFileType)
    {
        return 1;
    }

    if (entryType == MacOSDirectoryEntryDirectoryType)
    {
        return 2;
    }

    if (entryType == MacOSDirectoryEntrySymlinkType)
    {
        return 3;
    }

    return 0;
}

internal inline finite law i32[min max] DirectoryEntryKindFromMacOSMode(i32[min max] mode)
{
    stack i32[min max] fileType = mode & MacOSStatTypeMask;
    if (fileType == MacOSStatRegularType)
    {
        return 1;
    }

    if (fileType == MacOSStatDirectoryType)
    {
        return 2;
    }

    if (fileType == MacOSStatSymlinkType)
    {
        return 3;
    }

    return 0;
}

internal unsafe fn i32[min max] WriteBufferToFd(
    i32[min max] fileDescriptor,
    rawptr<i8[min max]>[length] buffer,
    u64[0 2 ** 63 - 1] length)
{
    if (length == 0)
    {
        return 0;
    }

    if (buffer == null)
    {
        return -14;
    }

    stack mut u64[0 2 ** 63 - 1] remaining = length;
    stack mut u64[0 2 ** 63 - 1] written = 0;
    while willexit (remaining > 0)
    {
        stack rawptr<i8[min max]> data = &buffer[written];
        stack i64[min max] result = write(fileDescriptor, data, remaining);
        if (result < 0)
        {
            return NegativeErrno();
        }

        if (result == 0)
        {
            return -1;
        }

        stack u64[0 2 ** 63 - 1] chunk = (u64[0 2 ** 63 - 1])result;
        written += chunk;
        remaining -= chunk;
    }

    return 0;
}

internal unsafe fn i32[min max] WriteBufferToHandle(
    rawptr<i8[min max]> handle,
    rawptr<i8[min max]>[length] buffer,
    u64[0 2 ** 63 - 1] length)
    where overlap(handle, buffer)
{
    if (handle == null)
    {
        return -1;
    }

    return WriteBufferToFd(HandleToFd(handle), buffer, length);
}

internal unsafe fn i32[min max] WriteBufferLineToHandle(
    rawptr<i8[min max]> handle,
    rawptr<i8[min max]>[length] buffer,
    u64[0 2 ** 63 - 1] length)
    where overlap(handle, buffer)
{
    if (handle == null)
    {
        return -1;
    }

    return WriteBufferLineToFd(HandleToFd(handle), buffer, length);
}

internal unsafe fn i32[min max] WriteBufferLineToFd(
    i32[min max] fileDescriptor,
    rawptr<i8[min max]>[length] buffer,
    u64[0 2 ** 63 - 1] length)
{
    if (length > 0 && buffer == null)
    {
        return -14;
    }

    if (length < 8192)
    {
        stack mut System.Runtime.Buffer.FixedByteBuffer8192 lineBuffer = new System.Runtime.Buffer.FixedByteBuffer8192();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < length; index += 1)
        {
            lineBuffer.Storage[index] = *(&buffer[index]);
        }

        lineBuffer.Storage[length] = (i8[min max])10;
        return WriteBufferToFd(fileDescriptor, &lineBuffer.Storage[0], (u64[0 2 ** 63 - 1])(length + 1));
    }

    stack i32[min max] status = WriteBufferToFd(fileDescriptor, buffer, length);
    if (status != 0)
    {
        return status;
    }

    stack mut i8[min max][1] newline =
    {
        10
    };
    return WriteBufferToFd(fileDescriptor, &newline[0], 1);
}

internal unsafe fn i32[min max] FlushEncodedWriteBuffer(
    rawptr<i8[min max]> handle,
    mut borrow System.Runtime.Buffer.FixedByteBuffer4096 buffer)
    where overlap(handle, buffer)
{
    if (handle == null)
    {
        return -1;
    }

    return FlushEncodedWriteBufferToFd(HandleToFd(handle), buffer);
}

internal unsafe fn i32[min max] FlushEncodedWriteBufferToFd(
    i32[min max] fileDescriptor,
    mut borrow System.Runtime.Buffer.FixedByteBuffer4096 buffer)
{
    while willexit (true)
    {
        stack mut u64[0 2 ** 63 - 1] readPosition = buffer.ReadPosition;
        stack u64[0 2 ** 63 - 1] writePosition = buffer.WritePosition;
        if (readPosition >= writePosition)
        {
            buffer.Clear();
            return 0;
        }

        stack rawptr<i8[min max]> data = &buffer.Storage[readPosition];
        stack u64[0 2 ** 63 - 1] readable = writePosition - readPosition;
        stack i64[min max] result = write(fileDescriptor, data, readable);
        if (result < 0)
        {
            return NegativeErrno();
        }

        if (result == 0)
        {
            return -1;
        }

        readPosition = (u64[0 2 ** 63 - 1])(readPosition + (u64[0 2 ** 63 - 1])result);
        if (readPosition >= writePosition)
        {
            buffer.Clear();
            continue;
        }

        buffer.ReadPosition = readPosition;
    }
}

internal fn i32[min max] NormalizeUnicodeCodePoint(i32[min max] codePoint)
{
    if (codePoint < 0)
    {
        return 65533;
    }

    if (55296 <= codePoint && codePoint <= 57343)
    {
        return 65533;
    }

    if (codePoint > 1114111)
    {
        return 65533;
    }

    return codePoint;
}

internal fn i64[min max] Utf8EncodedLength(i32[min max] codePoint)
{
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);

    if (scalar <= 127)
    {
        return 1;
    }

    if (scalar <= 2047)
    {
        return 2;
    }

    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        return 3;
    }

    return 4;
}

internal fn void AppendUtf8CodePoint(
    mut borrow System.Runtime.Buffer.FixedByteBuffer4096 buffer,
    i32[min max] codePoint)
{
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);
    stack u64[0 2 ** 63 - 1] writePosition = buffer.WritePosition;

    if (scalar <= 127)
    {
        buffer.Storage[writePosition] = (i8[min max])scalar;
        buffer.WritePosition = (u64[0 2 ** 63 - 1])(writePosition + 1);
        return;
    }

    if (scalar <= 2047)
    {
        buffer.Storage[writePosition] = (i8[min max])((scalar >> 6) | 192);
        buffer.Storage[writePosition + 1] = (i8[min max])((scalar & 63) | 128);
        buffer.WritePosition = (u64[0 2 ** 63 - 1])(writePosition + 2);
        return;
    }

    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        buffer.Storage[writePosition] = (i8[min max])((scalar >> 12) | 224);
        buffer.Storage[writePosition + 1] = (i8[min max])(((scalar >> 6) & 63) | 128);
        buffer.Storage[writePosition + 2] = (i8[min max])((scalar & 63) | 128);
        buffer.WritePosition = (u64[0 2 ** 63 - 1])(writePosition + 3);
        return;
    }

    buffer.Storage[writePosition] = (i8[min max])((scalar >> 18) | 240);
    buffer.Storage[writePosition + 1] = (i8[min max])(((scalar >> 12) & 63) | 128);
    buffer.Storage[writePosition + 2] = (i8[min max])(((scalar >> 6) & 63) | 128);
    buffer.Storage[writePosition + 3] = (i8[min max])((scalar & 63) | 128);
    buffer.WritePosition = (u64[0 2 ** 63 - 1])(writePosition + 4);
}

internal unsafe fn i32[min max] WriteAsciiToHandle(rawptr<i8[min max]> handle, ascii text)
    where overlap(handle, text)
{
    if (handle == null)
    {
        return -1;
    }

    return WriteAsciiToFd(HandleToFd(handle), text);
}

internal unsafe fn i32[min max] WriteAsciiToFd(i32[min max] fileDescriptor, ascii text)
{
    stack mut i64[min max] remaining = AsciiLength(text);
    stack mut i64[min max] written = 0;

    while willexit (remaining > 0)
    {
        stack ascii chunk = text[written, remaining];
        stack rawptr<i8[min max]> data = AsciiData(chunk);
        stack i64[min max] result = write(fileDescriptor, data, (u64[0 2 ** 63 - 1])remaining);
        if (result < 0)
        {
            return NegativeErrno();
        }

        if (result == 0)
        {
            return -1;
        }

        written += result;
        remaining -= result;
    }

    return 0;
}

internal unsafe fn i32[min max] WriteUnicodeToHandle(rawptr<i8[min max]> handle, unicode text)
    where overlap(handle, text)
{
    if (handle == null)
    {
        return -1;
    }

    return WriteUnicodeToFd(HandleToFd(handle), text);
}

internal unsafe fn i32[min max] WriteUnicodeToFd(i32[min max] fileDescriptor, unicode text)
{
    stack i64[min max] length = UnicodeLength(text);
    if (length <= 0)
    {
        return 0;
    }

    stack mut System.Runtime.Buffer.FixedByteBuffer4096 utf8Buffer = new System.Runtime.Buffer.FixedByteBuffer4096();
    stack mut i64[min max] index = 0;

    while willexit (index < length)
    {
        stack unicode unit = text[index, 1];
        stack rawptr<i32[min max]> data = UnicodeData(unit);
        stack i32[min max] codePoint = *data;
        stack i64[min max] required = Utf8EncodedLength(codePoint);

        if (utf8Buffer.Writable() < required)
        {
            stack i32[min max] flushStatus = FlushEncodedWriteBufferToFd(fileDescriptor, utf8Buffer);
            if (flushStatus != 0)
            {
                return flushStatus;
            }
        }

        AppendUtf8CodePoint(utf8Buffer, codePoint);
        index += 1;
    }

    return FlushEncodedWriteBufferToFd(fileDescriptor, utf8Buffer);
}

internal unsafe fn i32[min max] WriteAsciiLineToHandle(rawptr<i8[min max]> handle, ascii text)
    where overlap(handle, text)
{
    if (handle == null)
    {
        return -1;
    }

    return WriteAsciiLineToFd(HandleToFd(handle), text);
}

internal unsafe fn i32[min max] WriteAsciiLineToFd(i32[min max] fileDescriptor, ascii text)
{
    stack i64[min max] length = AsciiLength(text);
    if (length < 0)
    {
        return -1;
    }

    if (length == 0)
    {
        return WriteBufferLineToFd(fileDescriptor, null, 0);
    }

    stack ascii view = text[0, length];
    return WriteBufferLineToFd(fileDescriptor, AsciiData(view), (u64[0 2 ** 63 - 1])length);
}

internal unsafe fn i32[min max] WriteUnicodeLineToHandle(rawptr<i8[min max]> handle, unicode text)
    where overlap(handle, text)
{
    if (handle == null)
    {
        return -1;
    }

    return WriteUnicodeLineToFd(HandleToFd(handle), text);
}

internal unsafe fn i32[min max] WriteUnicodeLineToFd(i32[min max] fileDescriptor, unicode text)
{
    stack i64[min max] length = UnicodeLength(text);
    if (length < 0)
    {
        return -1;
    }

    stack mut System.Runtime.Buffer.FixedByteBuffer4096 utf8Buffer = new System.Runtime.Buffer.FixedByteBuffer4096();
    stack mut i64[min max] index = 0;

    while willexit (index < length)
    {
        stack unicode unit = text[index, 1];
        stack rawptr<i32[min max]> data = UnicodeData(unit);
        stack i32[min max] codePoint = *data;
        stack i64[min max] required = Utf8EncodedLength(codePoint);

        if (utf8Buffer.Writable() < required)
        {
            stack i32[min max] flushStatus = FlushEncodedWriteBufferToFd(fileDescriptor, utf8Buffer);
            if (flushStatus != 0)
            {
                return flushStatus;
            }
        }

        AppendUtf8CodePoint(utf8Buffer, codePoint);
        index += 1;
    }

    if (utf8Buffer.Writable() < 1)
    {
        stack i32[min max] flushStatus = FlushEncodedWriteBufferToFd(fileDescriptor, utf8Buffer);
        if (flushStatus != 0)
        {
            return flushStatus;
        }
    }

    AppendUtf8CodePoint(utf8Buffer, 10);
    return FlushEncodedWriteBufferToFd(fileDescriptor, utf8Buffer);
}

