internal unsafe fn i32[min max] ReadDirectoryEntry(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> readPos,
    rawmutptr<i64[min max]> readLength,
    rawmutptr<Ascii> name,
    rawmutptr<i32[min max]> kind)
    where overlap(handle, buffer),
          overlap(handle, readPos),
          overlap(handle, readLength),
          overlap(handle, name),
          overlap(handle, kind)
{
    if (handle == null || name == null || kind == null)
    {
        return -1;
    }

    stack rawmutptr<i8[min max]> nameData = (*name).Data;
    stack i64[min max] nameCapacity = (*name).Capacity;

    while willexit (true)
    {
        stack rawmutptr<i8[min max]> entry = readdir(handle);
        if (entry == null)
        {
            *kind = 0;
            *name = new Ascii()
            {
                Data = nameData,
                Length = -1,
                Capacity = nameCapacity
            };
            return 0;
        }

        stack rawptr<i16[min max]> nameLengthPointer = (rawptr<i16[min max]>)(&entry[MacOSDirectoryEntryNameLengthOffset]);
        stack i64[min max] entryNameLength = (i64[min max])UnsignedShort(*nameLengthPointer);
        stack rawptr<i8[min max]> entryNameData = (rawptr<i8[min max]>)(&entry[MacOSDirectoryEntryNameOffset]);

        if (IsDotDirectoryEntry(entryNameData, entryNameLength))
        {
            continue;
        }

        if (entryNameLength > nameCapacity || (entryNameLength > 0 && nameData == null))
        {
            *kind = -1;
            *name = new Ascii()
            {
                Data = nameData,
                Length = -2,
                Capacity = nameCapacity
            };
            return -1;
        }

        stack mut i64[min max] copyIndex = 0;
        while willexit (copyIndex < entryNameLength)
        {
            *(&nameData[copyIndex]) = *(&entryNameData[copyIndex]);
            copyIndex += 1;
        }

        stack i8[min max] rawEntryType = *(&entry[MacOSDirectoryEntryTypeOffset]);
        *name = new Ascii()
        {
            Data = nameData,
            Length = entryNameLength,
            Capacity = nameCapacity
        };
        *kind = DirectoryEntryKindFromMacOSType(UnsignedByte(rawEntryType));
        return 1;
    }
}

internal unsafe inline fn i32[min max] ReadDirectoryEntryInfo(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> readPos,
    rawmutptr<i64[min max]> readLength,
    rawmutptr<i64[min max]> nameLength,
    rawmutptr<i32[min max]> kind)
    where overlap(handle, buffer),
          overlap(handle, readPos),
          overlap(handle, readLength),
          overlap(handle, nameLength),
          overlap(handle, kind)
{
    if (handle == null || nameLength == null || kind == null)
    {
        return -1;
    }

    while willexit (true)
    {
        stack rawmutptr<i8[min max]> entry = readdir(handle);
        if (entry == null)
        {
            *kind = 0;
            *nameLength = -1;
            return 0;
        }

        stack rawptr<i16[min max]> nameLengthPointer = (rawptr<i16[min max]>)(&entry[MacOSDirectoryEntryNameLengthOffset]);
        stack i64[min max] entryNameLength = (i64[min max])UnsignedShort(*nameLengthPointer);
        stack rawptr<i8[min max]> entryNameData = (rawptr<i8[min max]>)(&entry[MacOSDirectoryEntryNameOffset]);

        if (IsDotDirectoryEntry(entryNameData, entryNameLength))
        {
            continue;
        }

        stack i8[min max] rawEntryType = *(&entry[MacOSDirectoryEntryTypeOffset]);
        *nameLength = entryNameLength;
        *kind = DirectoryEntryKindFromMacOSType(UnsignedByte(rawEntryType));
        return 1;
    }
}

internal unsafe inline fn i64[min max] ReadDirectoryNameLengthChecksum(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> readPos,
    rawmutptr<i64[min max]> readLength,
    i64[min max] expectedCount)
    where overlap(handle, buffer),
          overlap(handle, readPos),
          overlap(handle, readLength)
{
    if (expectedCount < 0)
    {
        return -1;
    }

    stack mut i64[min max] checksum = 0;
    stack mut i64[min max] count = 0;
    while willexit (true)
    {
        stack mut i64[min max] nameLength = 0;
        stack mut i32[min max] kind = 0;
        stack i32[min max] status = ReadDirectoryEntryInfo(handle, buffer, capacity, readPos, readLength, &nameLength, &kind);
        if (status == 0)
        {
            if (count == expectedCount)
            {
                return checksum;
            }

            return -1;
        }

        if (status != 1 || nameLength < 0)
        {
            return -1;
        }

        checksum += nameLength;
        count += 1;
        if (count > expectedCount)
        {
            return -1;
        }
    }
}

internal unsafe fn bool TryCurrentDirectory(rawmutptr<Ascii> destination)
{
    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;

    if (data == null || capacity <= 0)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack rawmutptr<i8[min max]> result = getcwd(data, (u64[0 2 ** 63 - 1])capacity);
    if (result == null)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    *destination = new Ascii()
    {
        Data = data,
        Length = CStringLength((rawptr<i8[min max]>)data, capacity),
        Capacity = capacity
    };
    return true;
}

internal unsafe fn bool TryTempDirectory(rawmutptr<Ascii> destination)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (data == null || capacity < 4)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    *(&data[0]) = (i8[min max])47;
    *(&data[1]) = (i8[min max])116;
    *(&data[2]) = (i8[min max])109;
    *(&data[3]) = (i8[min max])112;

    *destination = new Ascii()
    {
        Data = data,
        Length = 4,
        Capacity = capacity
    };
    return true;
}

