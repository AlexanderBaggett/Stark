    stack rawmutptr<MacOSThreadContext> context = (rawmutptr<MacOSThreadContext>)allocation.Pointer;
    *context = new MacOSThreadContext()
    {
        Entry = ThreadNoPayloadContextEntry,
        Context = allocation.Pointer,
        ThreadEntry = entry
