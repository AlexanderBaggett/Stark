internal unsafe fn FileOpenResult OpenFileWithFlagsResult(ascii path, i32[min max] flags, i32[min max] mode)
{
    stack mut System.Runtime.Buffer.FixedByteBuffer4096 pathBuffer = new System.Runtime.Buffer.FixedByteBuffer4096();
    stack mut Ascii preparedPath = new Ascii();
    preparedPath.Data = pathBuffer.WritePointer();
    preparedPath.Length = 0;
    preparedPath.Capacity = pathBuffer.Writable();

    if (!TryBuildMacOSPath(&preparedPath, path))
    {
        return FileOpenResult.Err(-36);
    }

    stack i32[min max] fileDescriptor = open(preparedPath.Data, flags, mode);
    if (fileDescriptor < 0)
    {
        return FileOpenResult.Err(NegativeErrno());
    }

    stack rawptr<i8[min max]> handle = FdToHandle(fileDescriptor);
    if (handle == null)
    {
        return FileOpenResult.Err(-12);
    }

    return FileOpenResult.Ok(handle);
}

internal unsafe fn rawptr<i8[min max]> OpenFileWithFlags(ascii path, i32[min max] flags, i32[min max] mode)
{
    switch (OpenFileWithFlagsResult(path, flags, mode))
    {
        case FileOpenResult.Ok(var handle):
            return handle;
        case FileOpenResult.Err(var error):
            return null;
    }
}

