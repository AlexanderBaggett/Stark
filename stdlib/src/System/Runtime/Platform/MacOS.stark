internal unsafe fn i32[min max] FutexWait(rawmutptr<i32[min max]> address, i32[min max] expected)
{
    if (address == null)
    {
        return -14;
    }

    if (*address != expected)
    {
        return -11;
    }

    stack i32[min max] result = os_sync_wait_on_address(
        (rawmutptr<i8[min max]>)address,
        (i64[min max])expected,
        MacOSSyncAddressSizeI32,
        MacOSSyncAddressDefaultFlags);
    if (result == 0)
    {
        return 0;
    }

    return NegativeErrno();
}

internal unsafe fn i32[min max] FutexWake(rawmutptr<i32[min max]> address, i32[min max] count)
{
    if (address == null)
    {
        return -14;
    }

    if (count <= 0)
    {
        return 0;
    }

    if (count == 1)
    {
        os_sync_wake_by_address_any(
            (rawmutptr<i8[min max]>)address,
            MacOSSyncAddressSizeI32,
            MacOSSyncAddressDefaultFlags);
        return 0;
    }

    os_sync_wake_by_address_all(
        (rawmutptr<i8[min max]>)address,
        MacOSSyncAddressSizeI32,
        MacOSSyncAddressDefaultFlags);
    return 0;
}

internal unsafe fn void WriteTcpIPv4Sockaddr(
    rawmutptr<i8[min max]> destination,
    u8[0 max] a,
    u8[0 max] b,
    u8[0 max] c,
    u8[0 max] d,
    u16[0 max] port)
{
    if (destination == null)
    {
        return;
    }

    stack mut i64[min max] index = 0;
    while willexit (index < MacOSSockaddrInLength)
    {
        *(&destination[index]) = (i8[min max])0;
        index += 1;
    }

    stack i32[min max] portValue = (i32[min max])port;
    *(&destination[0]) = (i8[min max])MacOSSockaddrInLength;
    *(&destination[1]) = (i8[min max])MacOSAddressFamilyInet;
    *(&destination[2]) = (i8[min max])(portValue >> 8);
    *(&destination[3]) = (i8[min max])(portValue & 255);
    *(&destination[4]) = (i8[min max])a;
    *(&destination[5]) = (i8[min max])b;
    *(&destination[6]) = (i8[min max])c;
    *(&destination[7]) = (i8[min max])d;
}

internal unsafe fn void PrepareSocket(i32[min max] fileDescriptor)
{
    fcntl(fileDescriptor, MacOSFileControlSetFd, MacOSFileDescriptorCloseOnExec);

    stack mut i32[min max] enabled = 1;
    setsockopt(
        fileDescriptor,
        MacOSSolSocket,
        MacOSSocketNoSigPipe,
        (rawptr<i8[min max]>)(&enabled),
        4);
    return;
}

internal unsafe fn rawptr<i8[min max]> OpenTcpSocket(rawmutptr<i32[min max]> status)
{
    stack i32[min max] fileDescriptor = socket(MacOSAddressFamilyInet, MacOSSocketStream, MacOSSocketProtocolTcp);
    if (fileDescriptor < 0)
    {
        if (status != null)
        {
            *status = NegativeErrno();
        }

        return null;
    }

    PrepareSocket(fileDescriptor);
    return FdToHandle(fileDescriptor);
}

internal unsafe inline fn rawptr<i8[min max]> ConnectTcpIPv4(
    u8[0 max] a,
    u8[0 max] b,
    u8[0 max] c,
    u8[0 max] d,
    u16[0 max] port,
    rawmutptr<i32[min max]> status)
{
    if (status != null)
    {
        *status = 0;
    }

    stack rawptr<i8[min max]> handle = OpenTcpSocket(status);
    if (handle == null)
    {
        return null;
    }

    stack mut i8[min max][16] address;
    WriteTcpIPv4Sockaddr(&address[0], a, b, c, d, port);

    if (connect(HandleToFd(handle), (rawptr<i8[min max]>)(&address[0]), MacOSSockaddrInLength) != 0)
    {
        stack i32[min max] error = NegativeErrno();
        CloseSocket(handle);
        if (status != null)
        {
            *status = error;
        }

        return null;
    }

    return handle;
}

internal unsafe inline fn rawptr<i8[min max]> ListenTcpIPv4(
    u8[0 max] a,
    u8[0 max] b,
    u8[0 max] c,
    u8[0 max] d,
    u16[0 max] port,
    rawmutptr<i32[min max]> status)
{
    if (status != null)
    {
        *status = 0;
    }

    stack rawptr<i8[min max]> handle = OpenTcpSocket(status);
    if (handle == null)
    {
        return null;
    }

    stack mut i32[min max] enabled = 1;
    setsockopt(
        HandleToFd(handle),
        MacOSSolSocket,
        MacOSSocketReuseAddress,
        (rawptr<i8[min max]>)(&enabled),
        4);

    stack mut i8[min max][16] address;
    WriteTcpIPv4Sockaddr(&address[0], a, b, c, d, port);

    if (bind(HandleToFd(handle), (rawptr<i8[min max]>)(&address[0]), MacOSSockaddrInLength) != 0)
    {
        stack i32[min max] error = NegativeErrno();
        CloseSocket(handle);
        if (status != null)
        {
            *status = error;
        }

        return null;
    }

    if (listen(HandleToFd(handle), MacOSDefaultTcpListenBacklog) != 0)
    {
        stack i32[min max] error = NegativeErrno();
        CloseSocket(handle);
        if (status != null)
        {
            *status = error;
        }

        return null;
    }

    return handle;
}

internal unsafe inline fn i64[min max] ReadSocket(
    rawptr<i8[min max]> handle,
