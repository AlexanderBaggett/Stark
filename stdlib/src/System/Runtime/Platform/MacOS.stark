const MacOSPathBufferCapacity = 4096;
const MacOSOpenReadOnlyFlag = 0;
const MacOSOpenWriteOnlyFlag = 1;
const MacOSOpenReadWriteFlag = 2;
const MacOSOpenAppendFlag = 8;
const MacOSOpenCreateFlag = 512;
const MacOSOpenExclusiveFlag = 2048;
const MacOSOpenTruncateFlag = 1024;
const MacOSOpenCloseOnExecFlag = 16777216;
const MacOSDefaultCreateMode = 420;
const MacOSDefaultDirectoryMode = 493;
const MacOSStatModeOffset = 4;
const MacOSStatModifiedSecondsOffset = 48;
const MacOSStatModifiedNanosecondsOffset = 56;
const MacOSStatSizeOffset = 96;
const MacOSStatTypeMask = 61440;
const MacOSStatRegularType = 32768;
const MacOSStatDirectoryType = 16384;
const MacOSStatSymlinkType = 40960;
const MacOSPathMetadataKindOffset = 0;
const MacOSPathMetadataPermissionsOffset = 4;
const MacOSPathMetadataSizeOffset = 8;
const MacOSPathMetadataModifiedSecondsOffset = 16;
const MacOSPathMetadataModifiedNanosecondsOffset = 24;
const MacOSAddressFamilyInet = 2;
const MacOSSocketStream = 1;
const MacOSSocketProtocolTcp = 6;
const MacOSSockaddrInLength = 16;
const MacOSDefaultTcpListenBacklog = 128;
const MacOSFileControlSetFd = 2;
const MacOSFileDescriptorCloseOnExec = 1;
const MacOSSolSocket = 2 ** 16 - 1;
const MacOSSocketReuseAddress = 4;
const MacOSSocketNoSigPipe = 4130;
const MacOSPollReadableEvent = 1;
const MacOSPollWritableEvent = 4;
const MacOSDirectoryEntryNameLengthOffset = 18;
const MacOSDirectoryEntryTypeOffset = 20;
const MacOSDirectoryEntryNameOffset = 21;
const MacOSDirectoryEntryFileType = 8;
const MacOSDirectoryEntryDirectoryType = 4;
const MacOSDirectoryEntrySymlinkType = 10;
const MacOSSyncAddressSizeI32 = 4;
const MacOSSyncAddressDefaultFlags = 0;
const MacOSWaitNoHangOption = 1;
const MacOSSignalKill = 9;
const MacOSSpawnSetPGroup = 2;
const MacOSPollErrorEvent = 8;
const MacOSPollHangupEvent = 16;
