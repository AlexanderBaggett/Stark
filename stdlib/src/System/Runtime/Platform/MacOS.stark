    }

    stack rawptr<i8[min max]> handle = OpenFileRead("/dev/stdin");
    if (handle == null)
    {
        return 0;
    }

    stack i64[min max] readCount = ReadFileBytes(buffer, capacity, handle);
    CloseFile(handle);
    return readCount;
}

