    return NegativeErrno();
}

// Darwin's CLOCK_MONOTONIC is 6 (Linux uses 1).
const MacOSClockMonotonic = 6;

internal unsafe fn i64[min max] MonotonicMilliseconds()
{
    stack mut MacOSTimespec time = new MacOSTimespec()
    {
        Seconds = 0,
        Nanoseconds = 0
    };
    stack i32[min max] result = clock_gettime(MacOSClockMonotonic, &time);
    if (result != 0)
    {
        return (i64[min max])result;
    }

    return (time.Seconds * 1000) + (time.Nanoseconds / 1000000);
}

