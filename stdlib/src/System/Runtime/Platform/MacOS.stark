internal unsafe inline fn i64[min max] ReadSocketVector2(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[firstCapacity] firstBuffer,
    u64[0 2 ** 63 - 1] firstCapacity,
    rawmutptr<i8[min max]>[secondCapacity] secondBuffer,
    u64[0 2 ** 63 - 1] secondCapacity)
    where overlap(handle, firstBuffer),
          overlap(handle, secondBuffer)
{
    if (firstCapacity == 0)
    {
        return ReadSocket(handle, secondBuffer, secondCapacity);
    }

    if (secondCapacity == 0)
    {
        return ReadSocket(handle, firstBuffer, firstCapacity);
    }

    if (handle == null)
    {
        return -107;
    }

    if (firstBuffer == null || secondBuffer == null)
    {
        return -14;
    }

    stack mut MacOSIovec[2] vectors;
    init vectors[0] = new MacOSIovec()
    {
        Base = (rawptr<i8[min max]>)firstBuffer,
        Length = firstCapacity
    };
    init vectors[1] = new MacOSIovec()
    {
        Base = (rawptr<i8[min max]>)secondBuffer,
        Length = secondCapacity
    };

    stack i64[min max] result = readv(HandleToFd(handle), &vectors[0], 2);
    if (result < 0)
    {
        return (i64[min max])NegativeErrno();
    }

    return result;
}

internal unsafe inline fn i64[min max] WriteSocketVector2(
    rawptr<i8[min max]> handle,
    rawptr<i8[min max]>[firstLength] firstBuffer,
    u64[0 2 ** 63 - 1] firstLength,
    rawptr<i8[min max]>[secondLength] secondBuffer,
    u64[0 2 ** 63 - 1] secondLength)
    where overlap(handle, firstBuffer),
          overlap(handle, secondBuffer)
{
    if (firstLength == 0)
    {
        return WriteSocket(handle, secondBuffer, secondLength);
    }

    if (secondLength == 0)
    {
        return WriteSocket(handle, firstBuffer, firstLength);
    }

    if (handle == null)
    {
        return -107;
    }

    if (firstBuffer == null || secondBuffer == null)
    {
        return -14;
    }

    stack mut MacOSIovec[2] vectors;
    init vectors[0] = new MacOSIovec()
    {
        Base = firstBuffer,
        Length = firstLength
    };
    init vectors[1] = new MacOSIovec()
    {
        Base = secondBuffer,
        Length = secondLength
    };

    stack i64[min max] result = writev(HandleToFd(handle), &vectors[0], 2);
    if (result < 0)
    {
        return (i64[min max])NegativeErrno();
    }

    return result;
}

internal unsafe inline fn rawptr<i8[min max]> AcceptSocket(
    rawptr<i8[min max]> handle,
    rawmutptr<i32[min max]> status)
{
    if (status != null)
    {
        *status = 0;
    }

    if (handle == null)
    {
        if (status != null)
        {
            *status = -107;
        }

        return null;
    }

    stack i32[min max] accepted = accept(HandleToFd(handle), null, null);
    if (accepted < 0)
    {
        if (status != null)
        {
            *status = NegativeErrno();
        }

        return null;
    }

    PrepareSocket(accepted);
    return FdToHandle(accepted);
}

internal unsafe inline fn i32[min max] ShutdownSocket(rawptr<i8[min max]> handle, i32[min max] how)
{
    if (handle == null)
    {
        return -107;
    }

    if (how < 0 || how > 2)
    {
        return -95;
    }

    if (shutdown(HandleToFd(handle), how) == 0)
    {
        return 0;
    }

    return NegativeErrno();
}

internal unsafe inline fn i32[min max] CloseSocket(rawptr<i8[min max]> handle)
{
    return CloseFile(handle);
}

internal unsafe fn void CloseProcessDescriptorIfOpen(i32[min max] descriptor)
{
    if (descriptor >= 0)
    {
        stack i32[min max] ignoredClose = CloseRawDescriptor(descriptor);
    }

    return;
}

internal unsafe fn i32[min max] CreateProcessPipe(rawmutptr<i32[min max]> fileDescriptors)
{
    if (fileDescriptors == null)
    {
        return -1;
    }

    if (pipe(fileDescriptors) != 0)
    {
        return NegativeErrno();
    }

    return 0;
}

internal unsafe fn bool ProcessWorkingDirectoryExists(rawptr<System.C.c_char> path)
{
    stack mut System.Runtime.Buffer.FixedByteBuffer512 statBuffer = new System.Runtime.Buffer.FixedByteBuffer512();
    stack rawmutptr<i8[min max]> statData = statBuffer.WritePointer();
    if (statData == null)
    {
        return false;
    }

    if (stat(path, statData) != 0)
    {
        return false;
    }

    stack rawptr<i16[min max]> modePointer = (rawptr<i16[min max]>)(&statData[MacOSStatModeOffset]);
    stack i32[min max] mode = UnsignedShort(*modePointer);
    return (mode & MacOSStatTypeMask) == MacOSStatDirectoryType;
}

// Spawns the executable with stdout/stderr (and optionally stdin) routed
// through fresh pipes, using posix_spawnp with file actions instead of a
// fork/exec split. Returns 0 with the child id and parent-side pipe
// descriptors on success and a negative value when the pipes or the spawn
// itself cannot be created. Setup and exec failures that a fork/exec backend
// reports through the child's own exit status are returned directly as the
// shell-convention codes: 126 for a bad working directory and 127 when the
// executable cannot be found or run.
internal unsafe fn i32[min max] StartProcessCaptureCore(
    rawptr<System.C.c_char> executable,
    borrow rawptr<System.C.c_char>[] argv,
    rawptr<System.C.c_char> workingDirectory,
    bool captureStdin,
    bool newProcessGroup,
    rawmutptr<i32[min max]> processId,
    rawmutptr<i32[min max]> stdinDescriptor,
    rawmutptr<i32[min max]> stdoutDescriptor,
    rawmutptr<i32[min max]> stderrDescriptor)
    where overlap(executable, argv),
          overlap(executable, workingDirectory),
          overlap(argv, workingDirectory),
          overlap(executable, processId),
          overlap(executable, stdinDescriptor),
          overlap(executable, stdoutDescriptor),
          overlap(executable, stderrDescriptor)
{
    if (executable == null
        || argv.Length == 0
        || processId == null
        || stdinDescriptor == null
        || stdoutDescriptor == null
        || stderrDescriptor == null)
    {
        return -1;
    }

    stack mut i32[min max][2] stdinPipe;
    stack mut i32[min max][2] stdoutPipe;
    stack mut i32[min max][2] stderrPipe;
    stdinPipe[0] = -1;
    stdinPipe[1] = -1;
    stdoutPipe[0] = -1;
    stdoutPipe[1] = -1;
    stderrPipe[0] = -1;
    stderrPipe[1] = -1;

    if (captureStdin)
    {
        stack i32[min max] stdinPipeResult = CreateProcessPipe(&stdinPipe[0]);
        if (stdinPipeResult != 0)
        {
            return stdinPipeResult;
        }
    }

    stack i32[min max] stdoutPipeResult = CreateProcessPipe(&stdoutPipe[0]);
    if (stdoutPipeResult != 0)
    {
        CloseProcessDescriptorIfOpen(stdinPipe[0]);
        CloseProcessDescriptorIfOpen(stdinPipe[1]);
        return stdoutPipeResult;
    }

    stack i32[min max] stderrPipeResult = CreateProcessPipe(&stderrPipe[0]);
    if (stderrPipeResult != 0)
    {
        CloseProcessDescriptorIfOpen(stdinPipe[0]);
        CloseProcessDescriptorIfOpen(stdinPipe[1]);
        CloseProcessDescriptorIfOpen(stdoutPipe[0]);
        CloseProcessDescriptorIfOpen(stdoutPipe[1]);
        return stderrPipeResult;
    }

    // A fork/exec backend reports a bad working directory as child exit 126,
    // but posix_spawn folds it into the same errno space as a missing
    // executable, so check the directory before spawning.
    if (workingDirectory != null && !ProcessWorkingDirectoryExists(workingDirectory))
    {
        CloseProcessDescriptorIfOpen(stdinPipe[0]);
        CloseProcessDescriptorIfOpen(stdinPipe[1]);
        CloseProcessDescriptorIfOpen(stdoutPipe[0]);
        CloseProcessDescriptorIfOpen(stdoutPipe[1]);
        CloseProcessDescriptorIfOpen(stderrPipe[0]);
        CloseProcessDescriptorIfOpen(stderrPipe[1]);
        return 126;
    }

    stack mut rawmutptr<i8[min max]> fileActions = null;
    stack i32[min max] initResult = posix_spawn_file_actions_init(&fileActions);
    if (initResult != 0)
    {
        CloseProcessDescriptorIfOpen(stdinPipe[0]);
        CloseProcessDescriptorIfOpen(stdinPipe[1]);
        CloseProcessDescriptorIfOpen(stdoutPipe[0]);
        CloseProcessDescriptorIfOpen(stdoutPipe[1]);
        CloseProcessDescriptorIfOpen(stderrPipe[0]);
        CloseProcessDescriptorIfOpen(stderrPipe[1]);
        return -initResult;
    }

    // Mirror the fork/exec child descriptor dance in file-action order:
    // close parent-side ends, dup the child-side ends onto 0/1/2, close the
    // originals, then change directory last.
    stack mut i32[min max] actionResult = 0;
    if (captureStdin && actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_addclose(&fileActions, stdinPipe[1]);
    }

    if (actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_addclose(&fileActions, stdoutPipe[0]);
    }

    if (actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_addclose(&fileActions, stderrPipe[0]);
    }

    if (captureStdin && actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_adddup2(&fileActions, stdinPipe[0], 0);
    }

    if (actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_adddup2(&fileActions, stdoutPipe[1], 1);
    }

    if (actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_adddup2(&fileActions, stderrPipe[1], 2);
    }

    if (captureStdin && actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_addclose(&fileActions, stdinPipe[0]);
    }

    if (actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_addclose(&fileActions, stdoutPipe[1]);
    }

    if (actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_addclose(&fileActions, stderrPipe[1]);
    }

    if (workingDirectory != null && actionResult == 0)
    {
        actionResult = posix_spawn_file_actions_addchdir_np(&fileActions, workingDirectory);
    }

    if (actionResult != 0)
    {
        stack i32[min max] ignoredDestroyActions = posix_spawn_file_actions_destroy(&fileActions);
        CloseProcessDescriptorIfOpen(stdinPipe[0]);
        CloseProcessDescriptorIfOpen(stdinPipe[1]);
        CloseProcessDescriptorIfOpen(stdoutPipe[0]);
        CloseProcessDescriptorIfOpen(stdoutPipe[1]);
        CloseProcessDescriptorIfOpen(stderrPipe[0]);
        CloseProcessDescriptorIfOpen(stderrPipe[1]);
        return -actionResult;
    }

    // Attributes are always initialized so the spawn call has one shape; the
    // process-group flag is only set when the caller asked for a grouped
    // child (pgroup 0 makes the child its own group leader).
    stack mut rawmutptr<i8[min max]> spawnAttributes = null;
    stack i32[min max] attributesInit = posix_spawnattr_init(&spawnAttributes);
    if (attributesInit != 0)
    {
        stack i32[min max] ignoredDestroyActionsForAttributes = posix_spawn_file_actions_destroy(&fileActions);
        CloseProcessDescriptorIfOpen(stdinPipe[0]);
        CloseProcessDescriptorIfOpen(stdinPipe[1]);
        CloseProcessDescriptorIfOpen(stdoutPipe[0]);
        CloseProcessDescriptorIfOpen(stdoutPipe[1]);
        CloseProcessDescriptorIfOpen(stderrPipe[0]);
        CloseProcessDescriptorIfOpen(stderrPipe[1]);
        return -attributesInit;
    }

    stack mut i32[min max] attributesResult = 0;
    if (newProcessGroup)
    {
        attributesResult = posix_spawnattr_setflags(&spawnAttributes, MacOSSpawnSetPGroup);
        if (attributesResult == 0)
        {
            attributesResult = posix_spawnattr_setpgroup(&spawnAttributes, 0);
        }
    }

    if (attributesResult != 0)
    {
        stack i32[min max] ignoredDestroyAttributes = posix_spawnattr_destroy(&spawnAttributes);
        stack i32[min max] ignoredDestroyActionsForFlags = posix_spawn_file_actions_destroy(&fileActions);
        CloseProcessDescriptorIfOpen(stdinPipe[0]);
        CloseProcessDescriptorIfOpen(stdinPipe[1]);
        CloseProcessDescriptorIfOpen(stdoutPipe[0]);
        CloseProcessDescriptorIfOpen(stdoutPipe[1]);
        CloseProcessDescriptorIfOpen(stderrPipe[0]);
        CloseProcessDescriptorIfOpen(stderrPipe[1]);
        return -attributesResult;
    }

    stack mut i32[min max] spawnedId = -1;
    stack i32[min max] spawnResult = posix_spawnp(
        &spawnedId,
        executable,
        &fileActions,
        &spawnAttributes,
        &argv[0],
        *_NSGetEnviron());
    stack i32[min max] ignoredDestroyAttributesAfterSpawn = posix_spawnattr_destroy(&spawnAttributes);
    stack i32[min max] ignoredDestroy = posix_spawn_file_actions_destroy(&fileActions);

    CloseProcessDescriptorIfOpen(stdinPipe[0]);
    CloseProcessDescriptorIfOpen(stdoutPipe[1]);
    CloseProcessDescriptorIfOpen(stderrPipe[1]);

    if (spawnResult != 0)
    {
        CloseProcessDescriptorIfOpen(stdinPipe[1]);
        CloseProcessDescriptorIfOpen(stdoutPipe[0]);
        CloseProcessDescriptorIfOpen(stderrPipe[0]);

        // ENOENT(2), E2BIG(7), EACCES(13), and ENOTDIR(20) are the exec-stage
        // failures a fork/exec child reports as exit 127.
        if (spawnResult == 2 || spawnResult == 7 || spawnResult == 13 || spawnResult == 20)
        {
            return 127;
        }

        return -spawnResult;
    }

    *processId = spawnedId;
    if (captureStdin)
    {
        *stdinDescriptor = stdinPipe[1];
    }
    else
    {
        *stdinDescriptor = -1;
    }

    *stdoutDescriptor = stdoutPipe[0];
    *stderrDescriptor = stderrPipe[0];
    return 0;
}

internal unsafe fn i32[min max] WaitProcess(i32[min max] processId, rawmutptr<i32[min max]> status)
{
    if (status == null)
    {
        return -1;
    }

    if (waitpid(processId, status, 0) < 0)
    {
        return NegativeErrno();
    }

    return processId;
}

internal unsafe fn i32[min max] StartProcessCapture(
    rawptr<System.C.c_char> executable,
    borrow rawptr<System.C.c_char>[] argv,
    rawptr<System.C.c_char> workingDirectory,
    bool captureStdin,
    rawmutptr<i32[min max]> processId,
    rawmutptr<i32[min max]> stdinDescriptor,
    rawmutptr<i32[min max]> stdoutDescriptor,
    rawmutptr<i32[min max]> stderrDescriptor)
    where overlap(executable, argv),
          overlap(executable, workingDirectory),
          overlap(argv, workingDirectory),
          overlap(executable, processId),
          overlap(executable, stdinDescriptor),
          overlap(executable, stdoutDescriptor),
          overlap(executable, stderrDescriptor)
{
    return StartProcessCaptureCore(
        executable,
        argv,
        workingDirectory,
        captureStdin,
        false,
        processId,
        stdinDescriptor,
        stdoutDescriptor,
        stderrDescriptor);
}

// Spawns like StartProcessCapture but places the child in its own process
// group (POSIX_SPAWN_SETPGROUP with pgroup 0), so KillProcessGroup can end
// the whole tree.
internal unsafe fn i32[min max] StartProcessCaptureGrouped(
    rawptr<System.C.c_char> executable,
    borrow rawptr<System.C.c_char>[] argv,
    rawptr<System.C.c_char> workingDirectory,
    bool captureStdin,
    rawmutptr<i32[min max]> processId,
    rawmutptr<i32[min max]> stdinDescriptor,
    rawmutptr<i32[min max]> stdoutDescriptor,
    rawmutptr<i32[min max]> stderrDescriptor)
    where overlap(executable, argv),
          overlap(executable, workingDirectory),
          overlap(argv, workingDirectory),
          overlap(executable, processId),
          overlap(executable, stdinDescriptor),
          overlap(executable, stdoutDescriptor),
          overlap(executable, stderrDescriptor)
{
    return StartProcessCaptureCore(
        executable,
        argv,
        workingDirectory,
        captureStdin,
        true,
        processId,
        stdinDescriptor,
        stdoutDescriptor,
        stderrDescriptor);
}

internal unsafe fn i32[min max] WaitProcessNoHang(i32[min max] processId, rawmutptr<i32[min max]> status)
{
    if (status == null)
    {
        return -1;
    }

    stack i32[min max] waitResult = waitpid(processId, status, MacOSWaitNoHangOption);
    if (waitResult < 0)
    {
        return NegativeErrno();
    }

    return waitResult;
}

internal unsafe fn i32[min max] KillProcess(i32[min max] processId)
{
    if (kill(processId, MacOSSignalKill) != 0)
    {
        return NegativeErrno();
    }

    return 0;
}

// Kills every process in the child's process group (kill(-pgid)); pair with
// StartProcessCaptureGrouped, whose child is its own group leader.
internal unsafe fn i32[min max] KillProcessGroup(i32[min max] processId)
{
    if (processId <= 0)
    {
        return -1;
    }

    if (kill(-processId, MacOSSignalKill) != 0)
    {
        return NegativeErrno();
    }

    return 0;
}

internal unsafe fn i32[min max] PollProcessPipesTimed(
    i32[min max] stdoutDescriptor,
    i32[min max] stderrDescriptor,
    rawmutptr<i16[min max]> stdoutEvents,
    rawmutptr<i16[min max]> stderrEvents,
    i32[min max] timeoutMilliseconds)
{
    if (stdoutEvents == null || stderrEvents == null)
    {
        return -1;
    }

    stack mut MacOSPollFd[2] descriptors;
    descriptors[0] = new MacOSPollFd()
    {
        FileDescriptor = stdoutDescriptor,
        Events = (i16[min max])MacOSPollReadableEvent,
        Revents = 0
    };
    descriptors[1] = new MacOSPollFd()
    {
        FileDescriptor = stderrDescriptor,
        Events = (i16[min max])MacOSPollReadableEvent,
        Revents = 0
    };

    stack i32[min max] result = poll(&descriptors[0], 2, timeoutMilliseconds);
    *stdoutEvents = descriptors[0].Revents;
    *stderrEvents = descriptors[1].Revents;
    if (result < 0)
    {
        return NegativeErrno();
    }

    return result;
}

internal unsafe fn i32[min max] PollProcessIoTimed(
    i32[min max] stdinDescriptor,
    i32[min max] stdoutDescriptor,
    i32[min max] stderrDescriptor,
    rawmutptr<i16[min max]> stdinEvents,
    rawmutptr<i16[min max]> stdoutEvents,
    rawmutptr<i16[min max]> stderrEvents,
    i32[min max] timeoutMilliseconds)
{
    if (stdinEvents == null || stdoutEvents == null || stderrEvents == null)
    {
        return -1;
    }

    stack mut MacOSPollFd[3] descriptors;
    descriptors[0] = new MacOSPollFd()
    {
        FileDescriptor = stdinDescriptor,
        Events = (i16[min max])MacOSPollWritableEvent,
        Revents = 0
    };
    descriptors[1] = new MacOSPollFd()
    {
        FileDescriptor = stdoutDescriptor,
        Events = (i16[min max])MacOSPollReadableEvent,
        Revents = 0
    };
    descriptors[2] = new MacOSPollFd()
    {
        FileDescriptor = stderrDescriptor,
        Events = (i16[min max])MacOSPollReadableEvent,
        Revents = 0
    };

    stack i32[min max] result = poll(&descriptors[0], 3, timeoutMilliseconds);
    *stdinEvents = descriptors[0].Revents;
    *stdoutEvents = descriptors[1].Revents;
    *stderrEvents = descriptors[2].Revents;
    if (result < 0)
    {
        return NegativeErrno();
    }

    return result;
}

internal inline finite law bool ProcessPipeReadable(i16[min max] events)
{
    return ((i32[min max])events & MacOSPollReadableEvent) != 0;
}

internal inline finite law bool ProcessPipeWritable(i16[min max] events)
{
    return ((i32[min max])events & MacOSPollWritableEvent) != 0;
}

internal inline finite law bool ProcessPipeClosed(i16[min max] events)
{
    stack i32[min max] widened = (i32[min max])events;
    return (widened & MacOSPollHangupEvent) != 0 || (widened & MacOSPollErrorEvent) != 0;
}

internal unsafe fn i32[min max] SetEnvironmentRaw(rawptr<System.C.c_char> name, rawptr<System.C.c_char> value)
    where overlap(name, value)
{
    if (name == null || value == null)
    {
        return -1;
    }

    return setenv(name, value, 1);
}

internal unsafe fn i32[min max] RemoveEnvironmentRaw(rawptr<System.C.c_char> name)
{
    if (name == null)
    {
        return -1;
    }

    return unsetenv(name);
}

internal unsafe fn rawptr<System.C.c_char> GetEnvironmentRaw(rawptr<System.C.c_char> name)
{
    if (name == null)
    {
        return null;
    }

    return getenv(name);
}

internal unsafe fn i32[min max] ChangeCurrentDirectoryRaw(rawptr<System.C.c_char> path)
{
    if (path == null)
    {
        return -1;
    }

    return chdir(path);
}

// Appends the current process argument vector to the destination as
// NUL-terminated entries, one per argument, matching the byte format Linux
// reads from /proc/self/cmdline.
internal unsafe fn i32[min max] ReadArgumentsBlock(mut borrow dynamic i8[min max] destination)
{
    stack rawmutptr<i32[min max]> argumentCountPointer = _NSGetArgc();
    if (argumentCountPointer == null)
    {
        return -1;
    }

    stack i32[min max] argumentCount = *argumentCountPointer;
    if (argumentCount <= 0)
    {
        return 0;
    }

    stack rawmutptr<MacOSCStringSlot> arguments = *_NSGetArgv();
    if (arguments == null)
    {
        return 0;
    }

    stack mut i8[min max][1] terminator;
    terminator[0] = 0;
    for willexit (stack mut i32[min max] index = 0; index < argumentCount; index += 1)
    {
        stack rawmutptr<i8[min max]> argument = (*(&arguments[index])).Pointer;
        if (argument != null)
        {
            stack i64[min max] length = CStringLength(argument, MacOSProcessArgumentMaxLength);
            if (length > 0)
            {
                stack u64[0 2 ** 63 - 1] count = (u64[0 2 ** 63 - 1])length;
                stack i8[min max][] bytes = slice(argument, count);
                switch (System.Memory.AppendBytes(destination, bytes, count))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return -12;
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        stack i8[min max][] terminatorSlice = slice(&terminator[0], 1);
        switch (System.Memory.AppendBytes(destination, terminatorSlice, 1))
        {
            case System.Memory.MemoryStatus.Err(var terminatorError):
                return -12;
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return 0;
}
