    stack mut rawmutptr<i8[min max]> thread = null;
    stack i32[min max] result = pthread_create(&thread, null, ThreadEntryThunk, allocation.Pointer);
    if (result != 0)
    {
        System.Memory.Free(allocation);
        return null;
    }

    return thread;
}

