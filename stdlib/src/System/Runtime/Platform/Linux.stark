import System.C
import System.Memory
import System.Runtime.Buffer
module System.Runtime.Platform.Linux

internal unsafe finite law rawptr<i8[min max]> AsciiData(ascii source);
internal finite law i64[min max] AsciiLength(ascii source);
internal unsafe finite law rawptr<i32[min max]> UnicodeData(unicode source);
internal finite law i64[min max] UnicodeLength(unicode source);
internal unsafe finite bool TryConcatAscii(rawmutptr<Ascii> destination, ascii left, ascii right)
    where overlap(left, right);

[StructLayout(C)]
internal struct LinuxPollFd
{
    i32[min max] Fd;
    i16[min max] Events;
    i16[min max] Revents;
}

[StructLayout(C)]
internal struct LinuxTimespec
{
    i64[min max] Seconds;
    i64[min max] Nanoseconds;
}

internal unsafe ffi(c) fn i32[min max] chdir(rawptr<System.C.c_char> path);
internal unsafe ffi(c) fn i32[min max] clock_gettime(i32[min max] clockId, rawmutptr<LinuxTimespec> time);
