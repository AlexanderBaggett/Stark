    *(&event[1]) = (i8[min max])(events >> 8);
    *(&event[2]) = (i8[min max])(events >> 16);
    *(&event[3]) = (i8[min max])(events >> 24);

    stack mut i64[min max] index = 4;
    while willexit (index < LinuxEpollEventBytes) {
        *(&event[index]) = (i8[min max])0;
        index += 1;
    }
}

internal unsafe fn i32[min max] WaitForEvents(rawptr<i8[min max]> handle, i32[min max] events, i32[min max] timeoutMilliseconds) {
    if (handle == null) {
        return -1;
    }

    stack i64[min max] epollResult = LinuxSyscall1Integer(
        LinuxEpollCreate1SyscallNumber,
        LinuxEpollCloseOnExecFlag);
    if (epollResult < 0) {
        return (i32[min max])epollResult;
