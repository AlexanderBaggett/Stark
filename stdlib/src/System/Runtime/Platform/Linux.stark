internal unsafe ffi asm(x86_64) fn i64[min max] LinuxSyscall1Handle(i64[min max] number, rawptr<i8[min max]> arg1)
    in("rax") number,
    in("rdi") arg1,
    out("rax") return,
    clobber("rcx", "r11")
{
    "syscall"
}

internal unsafe ffi asm(x86_64) fn i64[min max] LinuxMapThreadRegion(i64[min max] length)
    in("rsi") length,
    out("rax") return,
    clobber("rdi", "rdx", "r10", "r8", "r9", "rcx", "r11")
{
    "xorq %rdi, %rdi\nmovq $$9, %rax\nmovq $$3, %rdx\nmovq $$131106, %r10\nmovq $$-1, %r8\nxorq %r9, %r9\nsyscall"
}

internal unsafe ffi asm(x86_64) fn i32[min max] LinuxReleaseThreadReference(rawptr<i8[min max]> control)
    in("rdi") control,
    out("rax") return
{
    "movl $$-1, %eax\nlock xaddl %eax, 32(%rdi)"
}

internal unsafe ffi asm(x86_64) fn i64[min max] LinuxCloneThread(i64[min max] flags, rawptr<i8[min max]> childStack, rawptr<i8[min max]> control)
    in("rdi") flags,
    in("rsi") childStack,
    in("r12") control,
    out("rax") return,
    clobber("rdx", "r10", "r8", "r9", "r13", "r14", "r15", "rbx", "rcx", "r11")
