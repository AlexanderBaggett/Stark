    stack rawptr<i8[min max]> epollHandle = (rawptr<i8[min max]>)epollResult;
    stack mut i8[min max][16] event;
    WriteEpollEvent(&event[0], events);

    stack i64[min max] controlResult = LinuxSyscall4HandlePointersInteger(
        LinuxEpollCtlSyscallNumber,
        epollHandle,
        (rawptr<i8[min max]>)LinuxEpollControlAdd,
        handle,
        (i64[min max])(&event[0]));
    if (controlResult < 0) {
        CloseFile(epollHandle);
        return (i32[min max])controlResult;
    }

    stack i64[min max] waitResult = LinuxSyscall4HandlePointersInteger(
        LinuxEpollWaitSyscallNumber,
        epollHandle,
        (rawptr<i8[min max]>)(&event[0]),
        (rawptr<i8[min max]>)1,
        (i64[min max])timeoutMilliseconds);
