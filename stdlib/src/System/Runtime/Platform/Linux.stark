    stack rawptr<i8[min max]> childStack = (rawptr<i8[min max]>)(&region[LinuxThreadStackTopOffset]);
    stack i64[min max] cloneResult = LinuxCloneThread(
        LinuxThreadCloneFlags,
        childStack,
