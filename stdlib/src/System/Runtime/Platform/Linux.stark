}

internal unsafe inline fn i64[min max] ReadDirectoryNameLengthChecksum(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> readPos,
    rawmutptr<i64[min max]> readLength,
    i64[min max] expectedCount)
    where overlap(handle, buffer),
          overlap(handle, readPos),
          overlap(handle, readLength)
{
    if (handle == null || buffer == null || capacity <= (u64[0 2 ** 63 - 1])LinuxDirent64HeaderLength || readPos == null || readLength == null || expectedCount < 0)
    {
        return -1;
    }

    stack mut i64[min max] localReadPos = *readPos;
    stack mut i64[min max] localReadLength = *readLength;
    stack mut i64[min max] checksum = 0;
    stack mut i64[min max] count = 0;

    while willexit (true)
    {
        if (localReadPos >= localReadLength)
        {
            stack i64[min max] syscallResult = LinuxSyscall3HandleBuffer(
                LinuxGetDents64SyscallNumber,
                handle,
                (rawptr<i8[min max]>)buffer,
                capacity);
            if (syscallResult < 0)
            {
                *readPos = localReadPos;
                *readLength = localReadLength;
                return -1;
            }

            if (syscallResult == 0)
            {
                *readPos = localReadPos;
                *readLength = localReadLength;
                if (count == expectedCount)
                {
                    return checksum;
                }

                return -1;
            }

            localReadPos = 0;
            localReadLength = syscallResult;
        }

        stack i64[min max] current = localReadPos;
        if (current < 0 || current + LinuxDirent64HeaderLength > localReadLength)
        {
            *readPos = localReadPos;
            *readLength = localReadLength;
            return -1;
        }

        stack rawptr<i16[min max]> recordLengthPointer = (rawptr<i16[min max]>)(&buffer[current + LinuxDirent64RecordLengthOffset]);
        stack i32[min max] recordLength = UnsignedShort(*recordLengthPointer);
        if (recordLength <= LinuxDirent64HeaderLength || current + recordLength > localReadLength)
        {
            *readPos = localReadPos;
            *readLength = localReadLength;
            return -1;
        }

        stack rawptr<i8[min max]> entryNameData = (rawptr<i8[min max]>)(&buffer[current + LinuxDirent64HeaderLength]);
        stack i64[min max] entryNameLength = LinuxDirectoryEntryNameLength(
            entryNameData,
            (i64[min max])recordLength - LinuxDirent64HeaderLength);
        localReadPos = current + recordLength;

        if (IsDotDirectoryEntry(entryNameData, entryNameLength))
        {
            continue;
        }

        checksum += entryNameLength;
        count += 1;
        if (count > expectedCount)
        {
            *readPos = localReadPos;
            *readLength = localReadLength;
            return -1;
        }
    }
}

internal unsafe fn bool TryCurrentDirectory(rawmutptr<Ascii> destination)
{
    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;

    if (data == null || capacity <= 0)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    stack i64[min max] syscallResult = LinuxSyscall2PathBuffer(LinuxGetcwdSyscallNumber, data, capacity);
    if (syscallResult <= 0)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    *destination = new Ascii()
    {
        Data = data,
        Length = syscallResult - 1,
        Capacity = capacity
    };
    return true;
}

internal unsafe fn bool TryTempDirectory(rawmutptr<Ascii> destination)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (data == null || capacity < 4)
    {
        *destination = new Ascii()
        {
            Data = data,
            Length = 0,
            Capacity = capacity
        };
        return false;
    }

    *(&data[0]) = (i8[min max])47;
    *(&data[1]) = (i8[min max])116;
    *(&data[2]) = (i8[min max])109;
    *(&data[3]) = (i8[min max])112;

    *destination = new Ascii()
    {
        Data = data,
        Length = 4,
        Capacity = capacity
    };
    return true;
}
