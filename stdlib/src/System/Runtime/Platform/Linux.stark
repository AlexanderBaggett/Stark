    {
        return WriteUnicodeLineToHandle((rawptr<i8[min max]>)2, text);
    }
}

internal unsafe fn i32[min max] WriteStderrBytesLine(rawptr<i8[min max]>[length] data, u64[0 2 ** 63 - 1] length)
