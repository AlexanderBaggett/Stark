internal unsafe ffi(c) fn i32[min max] dup2(i32[min max] oldFileDescriptor, i32[min max] newFileDescriptor);
internal unsafe ffi(c) fn i32[min max] execvp(rawptr<System.C.c_char> file, rawptr<rawptr<System.C.c_char>> argv)
    where overlap(file, argv);
internal unsafe ffi(c) fn i32[min max] fork();
internal unsafe ffi(c) fn rawptr<System.C.c_char> getenv(rawptr<System.C.c_char> name);
internal unsafe ffi(c) fn i32[min max] kill(i32[min max] processId, i32[min max] signal);
internal unsafe ffi(c) fn i32[min max] pipe(rawmutptr<i32[min max]> fileDescriptors);
internal unsafe ffi(c) fn i32[min max] poll(rawmutptr<LinuxPollFd> fileDescriptors, u64[0 2 ** 63 - 1] count, i32[min max] timeoutMilliseconds);
internal unsafe ffi(c) fn i64[min max] read(i32[min max] fileDescriptor, rawmutptr<i8[min max]> buffer, u64[0 2 ** 63 - 1] count);
internal unsafe ffi(c) fn i32[min max] setenv(rawptr<System.C.c_char> name, rawptr<System.C.c_char> value, i32[min max] overwrite);
internal unsafe ffi(c) fn i32[min max] unsetenv(rawptr<System.C.c_char> name);
internal unsafe ffi(c) fn i32[min max] waitpid(i32[min max] processId, rawmutptr<i32[min max]> status, i32[min max] options);

internal unsafe ffi asm(x86_64) fn i64[min max] LinuxSyscall1Handle(i64[min max] number, rawptr<i8[min max]> arg1)
    in("rax") number,
    in("rdi") arg1,
    out("rax") return,
    clobber("rcx", "r11")
{
    "syscall"
}

internal unsafe ffi asm(x86_64) fn i64[min max] LinuxMapThreadRegion(i64[min max] length)
    in("rsi") length,
    out("rax") return,
    clobber("rdi", "rdx", "r10", "r8", "r9", "rcx", "r11")
{
    "xorq %rdi, %rdi\nmovq $$9, %rax\nmovq $$3, %rdx\nmovq $$131106, %r10\nmovq $$-1, %r8\nxorq %r9, %r9\nsyscall"
}

internal unsafe ffi asm(x86_64) fn i32[min max] LinuxReleaseThreadReference(rawmutptr<i8[min max]> control)
    in("rdi") control,
    out("rax") return
{
    "movl $$-1, %eax\nlock xaddl %eax, 32(%rdi)"
}

internal unsafe ffi asm(x86_64) fn i64[min max] LinuxCloneThread(i64[min max] flags, rawptr<i8[min max]> childStack, rawmutptr<i8[min max]> control)
    in("rdi") flags,
    in("rsi") childStack,
    in("r12") control,
    out("rax") return,
    clobber("rdx", "r10", "r8", "r9", "r13", "r14", "r15", "rbx", "rcx", "r11")
{
    "movq $$56, %rax\nxorq %rdx, %rdx\nxorq %r10, %r10\nxorq %r8, %r8\nsyscall\ntestq %rax, %rax\njnz 2f\nmovq 40(%r12), %r13\nmovq 48(%r12), %rdi\ncallq *%r13\nmovl %eax, 24(%r12)\nmovl $$1, 28(%r12)\nmovq 8(%r12), %r14\nmovq 16(%r12), %r15\nmovl $$-1, %eax\nlock xaddl %eax, 32(%r12)\ncmpl $$1, %eax\njne 1f\nmovq $$11, %rax\nmovq %r14, %rdi\nmovq %r15, %rsi\nsyscall\nmovq $$60, %rax\nxorq %rdi, %rdi\nsyscall\n1:\nmovq $$202, %rax\nleaq 28(%r12), %rdi\nmovq $$129, %rsi\nmovq $$1, %rdx\nxorq %r10, %r10\nsyscall\nmovq $$60, %rax\nxorq %rdi, %rdi\nsyscall\n2:"
}

