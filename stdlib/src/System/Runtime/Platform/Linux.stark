internal unsafe fn void WriteEpollEvent(rawmutptr<i8[min max]> event, i32[min max] events)
{
    if (event == null)
    {
        return;
    }

    *(&event[0]) = (i8[min max])events;
    *(&event[1]) = (i8[min max])(events >> 8);
    *(&event[2]) = (i8[min max])(events >> 16);
    *(&event[3]) = (i8[min max])(events >> 24);

    stack mut i64[min max] index = 4;
    while willexit (index < LinuxEpollEventBytes)
    {
        *(&event[index]) = (i8[min max])0;
        index += 1;
    }
}

internal unsafe fn i32[min max] WaitForEvents(rawptr<i8[min max]> handle, i32[min max] events, i32[min max] timeoutMilliseconds)
{
    if (handle == null)
    {
        return -1;
    }

    stack i64[min max] epollResult = LinuxSyscall1Integer(
        LinuxEpollCreate1SyscallNumber,
        LinuxEpollCloseOnExecFlag);
    if (epollResult < 0)
    {
        return (i32[min max])epollResult;
    }

    stack rawptr<i8[min max]> epollHandle = (rawptr<i8[min max]>)epollResult;
    stack mut i8[min max][16] event;
    WriteEpollEvent(&event[0], events);

    stack i64[min max] controlResult = LinuxSyscall4HandlePointersInteger(
        LinuxEpollCtlSyscallNumber,
        epollHandle,
        (rawptr<i8[min max]>)LinuxEpollControlAdd,
        handle,
        (i64[min max])(&event[0]));
    if (controlResult < 0)
    {
        CloseFile(epollHandle);
        return (i32[min max])controlResult;
    }

    stack i64[min max] waitResult = LinuxSyscall4HandlePointersInteger(
        LinuxEpollWaitSyscallNumber,
        epollHandle,
        (rawptr<i8[min max]>)(&event[0]),
        (rawptr<i8[min max]>)1,
        (i64[min max])timeoutMilliseconds);
    CloseFile(epollHandle);
    return (i32[min max])waitResult;
}

