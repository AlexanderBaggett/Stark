    return;
}

internal unsafe fn i64[min max] ReadStdin(rawmutptr<i8[min max]>[capacity] buffer, u64[0 2 ** 63 - 1] capacity) {
    if (buffer == null || capacity == 0) {
        return 0;
    }

    stack rawptr<i8[min max]> handle = OpenFileRead("/dev/stdin");
    if (handle == null) {
        return 0;
    }

    stack i64[min max] readCount = ReadFile(buffer, 1, capacity, handle);
    CloseFile(handle);
    return readCount;
}

