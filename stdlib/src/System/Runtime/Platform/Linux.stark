    if (cloneResult < 0) {
        UnmapThreadRegion((rawptr<i8[min max]>)region, LinuxThreadRegionBytes);
        return null;
    }

    return (rawptr<i8[min max]>)control;
}

internal unsafe fn i32[min max] JoinThread(rawptr<i8[min max]> handle, rawmutptr<i32[min max]> exitCode) {
