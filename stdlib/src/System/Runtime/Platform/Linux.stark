internal unsafe fn i64[min max] ReadFile(rawmutptr<i8[min max]> buffer, i64[min max] size, i64[min max] count, rawptr<i8[min max]> handle)
    where overlap(buffer, handle)
{
    if (handle == null || buffer == null || size <= 0 || count <= 0)
    {
        return 0;
    }

    stack i64[min max] bytesRequested = size * count;
    stack i64[min max] syscallResult = LinuxSyscall3HandleBuffer(LinuxReadSyscallNumber, handle, buffer, bytesRequested);
    if (syscallResult <= 0)
    {
        return 0;
    }

    return syscallResult / size;
}

internal unsafe fn i64[min max] WriteFile(rawptr<i8[min max]> buffer, i64[min max] size, i64[min max] count, rawptr<i8[min max]> handle)
    where overlap(buffer, handle)
{
    if (handle == null || buffer == null || size <= 0 || count <= 0)
    {
        return 0;
    }

    stack i64[min max] bytesRequested = size * count;
    stack i64[min max] syscallResult = LinuxSyscall3HandleBuffer(LinuxWriteSyscallNumber, handle, buffer, bytesRequested);
    if (syscallResult <= 0)
    {
        return 0;
    }

    return syscallResult / size;
}

internal unsafe inline fn i64[min max] ReadFileBytes(rawmutptr<i8[min max]>[length] buffer, u64[0 2 ** 63 - 1] length, rawptr<i8[min max]> handle)
    where overlap(buffer, handle)
{
    if (handle == null || buffer == null || length == 0)
