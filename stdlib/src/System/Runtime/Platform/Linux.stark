internal unsafe fn i32[min max] JoinThread(rawmutptr<i8[min max]> handle, rawmutptr<i32[min max]> exitCode)
{
    if (handle == null || exitCode == null)
    {
        return -1;
    }

    stack rawmutptr<LinuxThreadControl> control = (rawmutptr<LinuxThreadControl>)handle;
    while willexit ((*control).State == LinuxThreadStateRunning)
    {
        FutexWait(&(*control).State, LinuxThreadStateRunning);
    }

    *exitCode = (*control).ExitCode;
    stack rawptr<i8[min max]> region = (rawptr<i8[min max]>)(*control).Region;
    stack i64[min max] regionLength = (*control).RegionLength;
    if (ReleaseThreadReference(control) == 1)
    {
        UnmapThreadRegion(region, regionLength);
    }

    return 0;
}

