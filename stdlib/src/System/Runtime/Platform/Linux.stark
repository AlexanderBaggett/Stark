internal unsafe fn rawptr<i8[min max]> StartThread(fnptr<fn i32[min max]()> entry) {
    stack i64[min max] regionResult = LinuxMapThreadRegion(LinuxThreadRegionBytes);
    if (regionResult < 0) {
        return null;
