}

internal unsafe fn bool IsTerminal(rawptr<i8[min max]> handle)
{
    if (handle == null)
    {
        return false;
    }

    stack mut System.Runtime.Buffer.FixedByteBuffer512 stateBuffer = new System.Runtime.Buffer.FixedByteBuffer512();
    stack rawmutptr<i8[min max]> state = stateBuffer.WritePointer();
    if (state == null)
    {
        return false;
    }

    return LinuxSyscall3HandleRequestPointer(
        LinuxIoctlSyscallNumber,
        handle,
        LinuxTcGetsRequest,
        state) >= 0;
}

