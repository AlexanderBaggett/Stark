internal unsafe inline fn i64[min max] LinuxDirectoryEntryNameLength(rawptr<i8[min max]> data, i64[min max] maxLength)
{
    if (data == null || maxLength <= 0)
    {
        return 0;
    }

    stack mut i64[min max] length = 0;
    while willexit (length < maxLength)
    {
        if (*(&data[length]) == (i8[min max])0)
        {
            return length;
        }

        length += 1;
    }

    return maxLength;
}

internal unsafe inline finite law bool IsDotDirectoryEntry(rawptr<i8[min max]> data, i64[min max] length)
{
    if (data == null)
    {
        return false;
    }

    if (length == 1)
    {
        return *(&data[0]) == (i8[min max])46;
    }

    if (length == 2)
    {
        return *(&data[0]) == (i8[min max])46 && *(&data[1]) == (i8[min max])46;
    }

    return false;
}

internal inline fn i32[min max] DirectoryEntryKindFromLinuxType(i32[min max] entryType)
{
    if (entryType == LinuxDirectoryEntryFileType)
    {
        return 1;
    }

    if (entryType == LinuxDirectoryEntryDirectoryType)
    {
        return 2;
    }

    if (entryType == LinuxDirectoryEntrySymlinkType)
    {
        return 3;
    }

    return 0;
}

internal unsafe fn i32[min max] ReadDirectoryEntry(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> readPos,
    rawmutptr<i64[min max]> readLength,
    rawmutptr<Ascii> name,
    rawmutptr<i32[min max]> kind)
    where overlap(handle, buffer),
          overlap(handle, readPos),
          overlap(handle, readLength),
          overlap(handle, name),
          overlap(handle, kind)
{
    if (handle == null || buffer == null || capacity <= (u64[0 2 ** 63 - 1])LinuxDirent64HeaderLength || readPos == null || readLength == null || name == null || kind == null)
    {
        return -1;
    }

    stack rawmutptr<i8[min max]> nameData = (*name).Data;
    stack i64[min max] nameCapacity = (*name).Capacity;
    if (nameCapacity < 0)
    {
        *kind = -1;
        *name = new Ascii()
        {
            Data = nameData,
            Length = -2,
            Capacity = nameCapacity
        };
        return -1;
    }

    while willexit (true)
    {
        if (*readPos >= *readLength)
        {
            stack i64[min max] syscallResult = LinuxSyscall3HandleBuffer(
                LinuxGetDents64SyscallNumber,
                handle,
                (rawptr<i8[min max]>)buffer,
                capacity);
            if (syscallResult < 0)
            {
                *kind = (i32[min max])syscallResult;
                *name = new Ascii()
                {
                    Data = nameData,
                    Length = -2,
                    Capacity = nameCapacity
                };
                return (i32[min max])syscallResult;
            }

            if (syscallResult == 0)
            {
                *kind = 0;
                *name = new Ascii()
                {
                    Data = nameData,
                    Length = -1,
                    Capacity = nameCapacity
                };
                return 0;
            }

            *readPos = 0;
            *readLength = syscallResult;
        }

        stack i64[min max] current = *readPos;
        if (current < 0 || current + LinuxDirent64HeaderLength > *readLength)
        {
            *kind = -1;
            *name = new Ascii()
            {
                Data = nameData,
                Length = -2,
                Capacity = nameCapacity
            };
            return -1;
        }

        stack rawptr<i16[min max]> recordLengthPointer = (rawptr<i16[min max]>)(&buffer[current + LinuxDirent64RecordLengthOffset]);
        stack i32[min max] recordLength = UnsignedShort(*recordLengthPointer);
        if (recordLength <= LinuxDirent64HeaderLength || current + recordLength > *readLength)
        {
            *kind = -1;
            *name = new Ascii()
            {
                Data = nameData,
                Length = -2,
                Capacity = nameCapacity
            };
            return -1;
        }

        stack rawptr<i8[min max]> entryNameData = (rawptr<i8[min max]>)(&buffer[current + LinuxDirent64HeaderLength]);
        stack i64[min max] entryNameLength = LinuxDirectoryEntryNameLength(
            entryNameData,
            (i64[min max])recordLength - LinuxDirent64HeaderLength);
        stack i8[min max] rawEntryType = *(&buffer[current + LinuxDirent64TypeOffset]);
        *readPos = current + recordLength;

        if (IsDotDirectoryEntry(entryNameData, entryNameLength))
        {
            continue;
        }

        if (entryNameLength > nameCapacity || (entryNameLength > 0 && nameData == null))
        {
            *kind = -1;
            *name = new Ascii()
            {
                Data = nameData,
                Length = -2,
                Capacity = nameCapacity
            };
            return -1;
        }

        stack mut i64[min max] copyIndex = 0;
        while willexit (copyIndex < entryNameLength)
        {
            *(&nameData[copyIndex]) = *(&entryNameData[copyIndex]);
            copyIndex += 1;
        }

        *name = new Ascii()
        {
            Data = nameData,
            Length = entryNameLength,
            Capacity = nameCapacity
        };
        *kind = DirectoryEntryKindFromLinuxType(UnsignedByte(rawEntryType));
        return 1;
    }
}

