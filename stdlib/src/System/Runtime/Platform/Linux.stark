    stack rawmutptr<i8[min max]> region = (rawmutptr<i8[min max]>)regionResult;
    stack rawmutptr<LinuxThreadControl> control = (rawmutptr<LinuxThreadControl>)region;
    *control = new LinuxThreadControl() {
        Entry = entry,
        Region = region,
        RegionLength = LinuxThreadRegionBytes,
        ExitCode = 0,
        State = LinuxThreadStateRunning,
        References = LinuxThreadInitialReferences
