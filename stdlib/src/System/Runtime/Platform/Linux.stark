internal unsafe fn i64[min max] ReadSocketVector2(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[firstCapacity] firstBuffer,
    u64[0 2 ** 63 - 1] firstCapacity,
    rawmutptr<i8[min max]>[secondCapacity] secondBuffer,
    u64[0 2 ** 63 - 1] secondCapacity)
{
    if (firstCapacity > 0) {
        return ReadSocket(handle, firstBuffer, firstCapacity);
    }

    return ReadSocket(handle, secondBuffer, secondCapacity);
}

internal unsafe fn i64[min max] WriteSocketVector2(
    rawptr<i8[min max]> handle,
    rawptr<i8[min max]>[firstLength] firstBuffer,
    u64[0 2 ** 63 - 1] firstLength,
    rawptr<i8[min max]>[secondLength] secondBuffer,
    u64[0 2 ** 63 - 1] secondLength)
{
    if (firstLength == 0) {
        return WriteSocket(handle, secondBuffer, secondLength);
    }

    stack i64[min max] first = WriteSocket(handle, firstBuffer, firstLength);
    if (first < 0 || first < (i64[min max])firstLength || secondLength == 0) {
        return first;
    }

    stack i64[min max] second = WriteSocket(handle, secondBuffer, secondLength);
    if (second < 0) {
        return second;
    }

    return first + second;
}

internal unsafe fn rawptr<i8[min max]> AcceptSocket(
    rawptr<i8[min max]> handle,
    rawmutptr<i32[min max]> status)
{
    if (status != null) {
        *status = 0;
    }

    if (handle == null) {
        if (status != null) {
            *status = -107;
        }

        return null;
    }

    stack i64[min max] acceptResult = LinuxSyscall4HandlePointersInteger(
        LinuxAccept4SyscallNumber,
        handle,
        null,
        null,
        LinuxSocketCloseOnExecFlag);
    if (acceptResult < 0) {
        if (status != null) {
            *status = (i32[min max])acceptResult;
        }

