internal unsafe fn void WriteTcpIPv4Sockaddr(
    rawmutptr<i8[min max]> destination,
    u8[0 max] a,
    u8[0 max] b,
    u8[0 max] c,
    u8[0 max] d,
    u16[0 max] port)
{
    if (destination == null)
    {
        return;
    }

    stack mut i64[min max] index = 0;
    while willexit (index < LinuxSockaddrInLength)
    {
        *(&destination[index]) = (i8[min max])0;
        index += 1;
    }

    stack i32[min max] portValue = (i32[min max])port;
    *(&destination[0]) = (i8[min max])LinuxAddressFamilyInet;
    *(&destination[1]) = (i8[min max])0;
    *(&destination[2]) = (i8[min max])(portValue >> 8);
    *(&destination[3]) = (i8[min max])(portValue & 255);
    *(&destination[4]) = (i8[min max])a;
    *(&destination[5]) = (i8[min max])b;
    *(&destination[6]) = (i8[min max])c;
    *(&destination[7]) = (i8[min max])d;
}

internal unsafe inline fn rawptr<i8[min max]> ConnectTcpIPv4(
    u8[0 max] a,
    u8[0 max] b,
    u8[0 max] c,
    u8[0 max] d,
    u16[0 max] port,
    rawmutptr<i32[min max]> status)
{
    if (status != null)
    {
        *status = 0;
    }

    stack i64[min max] socketResult = LinuxSyscall3Integers(
        LinuxSocketSyscallNumber,
        LinuxAddressFamilyInet,
        LinuxSocketStreamFlag | LinuxSocketCloseOnExecFlag,
        0);
    if (socketResult < 0)
    {
        if (status != null)
        {
            *status = (i32[min max])socketResult;
        }

        return null;
    }

    stack rawptr<i8[min max]> handle = (rawptr<i8[min max]>)socketResult;
    stack mut i8[min max][16] address;
    WriteTcpIPv4Sockaddr(&address[0], a, b, c, d, port);

    stack i64[min max] connectResult = LinuxSyscall3HandleBuffer(
        LinuxConnectSyscallNumber,
        handle,
        (rawptr<i8[min max]>)(&address[0]),
        LinuxSockaddrInLength);
    if (connectResult < 0)
    {
        CloseSocket(handle);
        if (status != null)
        {
            *status = (i32[min max])connectResult;
        }

        return null;
    }

    return handle;
}

internal unsafe inline fn rawptr<i8[min max]> ListenTcpIPv4(
    u8[0 max] a,
    u8[0 max] b,
    u8[0 max] c,
    u8[0 max] d,
    u16[0 max] port,
    rawmutptr<i32[min max]> status)
{
    if (status != null)
    {
        *status = 0;
    }

    stack i64[min max] socketResult = LinuxSyscall3Integers(
        LinuxSocketSyscallNumber,
        LinuxAddressFamilyInet,
        LinuxSocketStreamFlag | LinuxSocketCloseOnExecFlag,
        0);
    if (socketResult < 0)
    {
        if (status != null)
        {
            *status = (i32[min max])socketResult;
        }

        return null;
    }

    stack rawptr<i8[min max]> handle = (rawptr<i8[min max]>)socketResult;
    stack mut i8[min max][16] address;
    WriteTcpIPv4Sockaddr(&address[0], a, b, c, d, port);

    stack i64[min max] bindResult = LinuxSyscall3HandleBuffer(
        LinuxBindSyscallNumber,
        handle,
        (rawptr<i8[min max]>)(&address[0]),
        LinuxSockaddrInLength);
    if (bindResult < 0)
    {
        CloseSocket(handle);
        if (status != null)
        {
            *status = (i32[min max])bindResult;
        }

        return null;
    }

    stack i64[min max] listenResult = LinuxSyscall2HandleInteger(
        LinuxListenSyscallNumber,
        handle,
        LinuxDefaultTcpListenBacklog);
    if (listenResult < 0)
    {
        CloseSocket(handle);
        if (status != null)
        {
            *status = (i32[min max])listenResult;
        }

        return null;
    }

    return handle;
}

