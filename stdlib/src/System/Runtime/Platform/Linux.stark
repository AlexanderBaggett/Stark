// Raw numeric descriptors (process pipes) share the Linux fd-in-pointer handle
// contract, so they reuse the handle-based calls directly.
internal unsafe inline fn i32[min max] CloseRawDescriptor(i32[min max] descriptor)
{
    if (descriptor < 0)
    {
        return -1;
    }

    return CloseFile((rawptr<i8[min max]>)((i64[min max])descriptor));
}

