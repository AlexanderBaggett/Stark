internal unsafe fn i64[min max] WindowsWideNullTerminatedLength(rawptr<i16[min max]> data, i64[min max] maxLength)
{
    if (data == null || maxLength <= 0)
    {
        return 0;
    }

    stack mut i64[min max] length = 0;
    while willexit (length < maxLength)
    {
        if (*(&data[length]) == (i16[min max])0)
        {
            return length;
        }

        length += 1;
    }

    return maxLength;
}

internal unsafe finite law bool IsDotWideDirectoryEntry(rawptr<i16[min max]> data, i64[min max] length)
{
    if (data == null)
    {
        return false;
    }

    if (length == 1)
    {
        return UnsignedWide(*(&data[0])) == 46;
    }

    if (length == 2)
    {
        return UnsignedWide(*(&data[0])) == 46 && UnsignedWide(*(&data[1])) == 46;
    }

    return false;
}

internal inline fn i32[min max] DirectoryEntryKindFromWindowsAttributes(i32[min max] attributes)
{
    unsafe
    {
        if ((attributes & WinFileAttributeReparsePoint) != 0)
        {
            return 3;
        }

        if ((attributes & WinFileAttributeDirectory) != 0)
        {
            return 2;
        }

        return 1;
    }
}

internal unsafe fn i32[min max] ReadDirectoryEntry(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> readPos,
    rawmutptr<i64[min max]> readLength,
    rawmutptr<Ascii> name,
    rawmutptr<i32[min max]> kind)
    where overlap(handle, buffer),
          overlap(handle, readPos),
          overlap(handle, readLength),
          overlap(handle, name),
          overlap(handle, kind)
{
    if (handle == null || buffer == null || capacity < (u64[0 2 ** 63 - 1])WinFindDataMinBytes || readPos == null || readLength == null || name == null || kind == null)
    {
        return -1;
    }

    stack rawmutptr<i8[min max]> nameData = (*name).Data;
    stack i64[min max] nameCapacity = (*name).Capacity;

    while willexit (true)
    {
        if (*readLength > 0)
        {
            *readLength = 0;
        }
        else if (FindNextFileW(handle, buffer) == 0)
        {
            stack i32[min max] error = GetLastError();
            if (error == WinErrorNoMoreFiles)
            {
                *kind = 0;
                *name = new Ascii()
                {
                    Data = nameData,
                    Length = -1,
                    Capacity = nameCapacity
                };
                return 0;
            }

            if (error <= 0)
            {
                *kind = -1;
                *name = new Ascii()
                {
                    Data = nameData,
                    Length = -2,
                    Capacity = nameCapacity
                };
                return -1;
            }

            *kind = -error;
            *name = new Ascii()
            {
                Data = nameData,
                Length = -2,
                Capacity = nameCapacity
            };
            return -error;
        }

        stack rawptr<i32[min max]> attributesPointer = (rawptr<i32[min max]>)buffer;
        stack i32[min max] attributes = *attributesPointer;
        stack rawptr<i16[min max]> nameSource = (rawptr<i16[min max]>)(&buffer[WinFindDataFileNameOffset]);
        stack i64[min max] nameLength = WindowsWideNullTerminatedLength(nameSource, WinFindDataMaxFileNameLength);
        if (IsDotWideDirectoryEntry(nameSource, nameLength))
        {
            continue;
        }

        stack i32[min max] asciiCopyStatus = TryCopyWideAscii(name, nameSource, (i32[min max])nameLength);
        if (asciiCopyStatus < 0 || (asciiCopyStatus == 0 && !TryCopyWideUtf8(name, nameSource, (i32[min max])nameLength)))
        {
            *kind = -1;
            *name = new Ascii()
            {
                Data = nameData,
                Length = -2,
                Capacity = nameCapacity
            };
            return -1;
        }

        *kind = DirectoryEntryKindFromWindowsAttributes(attributes);
        return 1;
    }
}

internal unsafe inline fn i32[min max] ReadDirectoryEntryInfo(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> readPos,
    rawmutptr<i64[min max]> readLength,
    rawmutptr<i64[min max]> nameLength,
    rawmutptr<i32[min max]> kind)
    where overlap(handle, buffer),
          overlap(handle, readPos),
          overlap(handle, readLength),
          overlap(handle, nameLength),
          overlap(handle, kind)
{
    if (handle == null || buffer == null || capacity < (u64[0 2 ** 63 - 1])WinFindDataMinBytes || readPos == null || readLength == null || nameLength == null || kind == null)
    {
        return -1;
    }

    while willexit (true)
    {
        if (*readLength > 0)
        {
            *readLength = 0;
        }
        else if (FindNextFileW(handle, buffer) == 0)
        {
            stack i32[min max] error = GetLastError();
            if (error == WinErrorNoMoreFiles)
            {
                *kind = 0;
                *nameLength = -1;
                return 0;
            }

            if (error <= 0)
            {
                *kind = -1;
                *nameLength = -2;
                return -1;
            }

            *kind = -error;
            *nameLength = -2;
            return -error;
        }

        stack rawptr<i32[min max]> attributesPointer = (rawptr<i32[min max]>)buffer;
        stack i32[min max] attributes = *attributesPointer;
        stack rawptr<i16[min max]> nameSource = (rawptr<i16[min max]>)(&buffer[WinFindDataFileNameOffset]);
        stack i64[min max] wideLength = WindowsWideNullTerminatedLength(nameSource, WinFindDataMaxFileNameLength);
        if (IsDotWideDirectoryEntry(nameSource, wideLength))
        {
            continue;
        }

        stack i64[min max] encodedLength = WideUtf8Length(
            nameSource,
            (i32[min max])wideLength);
        if (encodedLength < 0)
        {
            *kind = -1;
            *nameLength = -2;
            return -1;
        }

        *nameLength = encodedLength;
        *kind = DirectoryEntryKindFromWindowsAttributes(attributes);
        return 1;
    }
}

internal unsafe inline fn i64[min max] ReadDirectoryNameLengthChecksum(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> readPos,
    rawmutptr<i64[min max]> readLength,
    i64[min max] expectedCount)
    where overlap(handle, buffer),
          overlap(handle, readPos),
          overlap(handle, readLength)
{
    if (expectedCount < 0)
    {
        return -1;
    }

    stack mut i64[min max] checksum = 0;
    stack mut i64[min max] count = 0;
    while willexit (true)
    {
        stack mut i64[min max] nameLength = 0;
        stack mut i32[min max] kind = 0;
        stack i32[min max] status = ReadDirectoryEntryInfo(handle, buffer, capacity, readPos, readLength, &nameLength, &kind);
        if (status == 0)
        {
            if (count == expectedCount)
            {
                return checksum;
            }

            return -1;
        }

        if (status != 1 || nameLength < 0)
        {
            return -1;
        }

        checksum += nameLength;
        count += 1;
        if (count > expectedCount)
        {
            return -1;
        }
    }
}

internal unsafe fn bool TryCurrentDirectory(rawmutptr<Ascii> destination)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (data == null || capacity <= 0)
    {
        ResetAsciiDestination(destination);
        return false;
    }

    stack mut i16[min max][4096] pathBuffer;
    stack i32[min max] written = GetCurrentDirectoryW(4096, &pathBuffer[0]);
    if (written <= 0 || written >= 4096)
    {
        ResetAsciiDestination(destination);
        return false;
    }

    return TryCopyWideUtf8(destination, &pathBuffer[0], written);
}

internal unsafe fn bool TryTempDirectory(rawmutptr<Ascii> destination)
{
    if (destination == null)
    {
        return false;
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    if (data == null || capacity <= 0)
    {
        ResetAsciiDestination(destination);
        return false;
    }

    stack mut i16[min max][4096] pathBuffer;
    stack mut i32[min max] written = GetTempPathW(4096, &pathBuffer[0]);
    if (written <= 0 || written >= 4096)
    {
        ResetAsciiDestination(destination);
        return false;
    }

    if (written > 3 && IsWideDirectorySeparatorUnit(UnsignedWide(*(&pathBuffer[written - 1]))))
    {
        written -= 1;
    }

    return TryCopyWideUtf8(destination, &pathBuffer[0], written);
}

// The Windows process backend is not implemented yet. These stubs keep the
// platform dispatch surface compiling for Windows targets and report -38
// (ENOSYS in the Linux-style negative errno convention the platform layer
// uses) until a CreateProcessW-based backend lands.
internal unsafe fn i32[min max] StartProcessCapture(
    rawptr<System.C.c_char> executable,
    borrow rawptr<System.C.c_char>[] argv,
    rawptr<System.C.c_char> workingDirectory,
    bool captureStdin,
    rawmutptr<i32[min max]> processId,
    rawmutptr<i32[min max]> stdinDescriptor,
    rawmutptr<i32[min max]> stdoutDescriptor,
    rawmutptr<i32[min max]> stderrDescriptor)
    where overlap(executable, argv),
          overlap(executable, workingDirectory),
          overlap(argv, workingDirectory),
          overlap(executable, processId),
          overlap(executable, stdinDescriptor),
          overlap(executable, stdoutDescriptor),
          overlap(executable, stderrDescriptor)
{
    if (executable == null
        || argv.Length == 0
        || processId == null
        || stdinDescriptor == null
        || stdoutDescriptor == null
        || stderrDescriptor == null)
    {
        return -1;
    }

    return -38;
}

