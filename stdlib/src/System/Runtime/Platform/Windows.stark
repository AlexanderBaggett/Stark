        lineBuffer.Storage[length] = (i8[min max])10;
        stack mut i32[min max] lineStatus = 0;
        unsafe
        {
            lineStatus = WriteBufferToHandle(
                handle,
                &lineBuffer.Storage[0],
                (u64[0 2 ** 63 - 1])(length + 1));
        }

        return lineStatus;
    }

    stack i32[min max] status = WriteBufferToHandle(handle, buffer, length);
    if (status != 0)
    {
        return status;
    }

    stack mut i8[min max][1] newline =
    {
        10
    };
    stack mut i32[min max] newlineStatus = 0;
    unsafe
    {
        newlineStatus = WriteBufferToHandle(handle, &newline[0], 1);
    }

    return newlineStatus;
}

internal unsafe fn i32[min max] WriteBufferLineToHandle(
    rawptr<i8[min max]> handle,
    rawptr<i8[min max]>[length] buffer,
    u64[0 2 ** 63 - 1] length)
    where overlap(handle, buffer)
{
    if (handle == null)
    {
        return -1;
    }

    if (length > 0 && buffer == null)
    {
        return -1;
    }

    if (length == 0)
    {
        stack mut i8[min max][1] newline =
        {
            10
        };
        stack mut i32[min max] newlineStatus = 0;
        unsafe
        {
            newlineStatus = WriteBufferToHandle(handle, &newline[0], 1);
        }

        return newlineStatus;
    }

    if (length < 512)
    {
        stack mut System.Runtime.Buffer.FixedByteBuffer512 lineBuffer = new System.Runtime.Buffer.FixedByteBuffer512();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < length; index += 1)
        {
            lineBuffer.Storage[index] = *(&buffer[index]);
        }

        lineBuffer.Storage[length] = (i8[min max])10;
        stack mut i32[min max] lineStatus = 0;
        unsafe
        {
            lineStatus = WriteBufferToHandle(
                handle,
                &lineBuffer.Storage[0],
                (u64[0 2 ** 63 - 1])(length + 1));
        }

        return lineStatus;
    }

    return WriteBufferLineToHandleLarge(handle, buffer, length);
}

internal fn i32[min max] NormalizeUnicodeCodePoint(i32[min max] codePoint)
{
    unsafe
    {
        if (codePoint < 0)
        {
            return 65533;
        }

        if (55296 <= codePoint && codePoint <= 57343)
        {
            return 65533;
        }

        if (codePoint > 1114111)
        {
            return 65533;
        }

        return codePoint;
    }
}

internal fn i64[min max] Utf8EncodedLength(i32[min max] codePoint)
{
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);

    if (scalar <= 127)
    {
        return 1;
    }

    if (scalar <= 2047)
    {
        return 2;
    }

    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        return 3;
    }

    return 4;
}

internal fn void AppendUtf8CodePoint(mut borrow System.Runtime.Buffer.FixedByteBuffer4096 buffer, i32[min max] codePoint)
{
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);
    stack u64[0 2 ** 63 - 1] writePosition = buffer.WritePosition;

    if (scalar <= 127)
    {
        buffer.Storage[writePosition] = (i8[min max])scalar;
        buffer.WritePosition = (u64[0 2 ** 63 - 1])(writePosition + 1);
        return;
    }

    if (scalar <= 2047)
    {
        buffer.Storage[writePosition] = (i8[min max])((scalar >> 6) | 192);
        buffer.Storage[writePosition + 1] = (i8[min max])((scalar & 63) | 128);
        buffer.WritePosition = (u64[0 2 ** 63 - 1])(writePosition + 2);
        return;
    }

    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        buffer.Storage[writePosition] = (i8[min max])((scalar >> 12) | 224);
        buffer.Storage[writePosition + 1] = (i8[min max])(((scalar >> 6) & 63) | 128);
        buffer.Storage[writePosition + 2] = (i8[min max])((scalar & 63) | 128);
        buffer.WritePosition = (u64[0 2 ** 63 - 1])(writePosition + 3);
        return;
    }

    buffer.Storage[writePosition] = (i8[min max])((scalar >> 18) | 240);
    buffer.Storage[writePosition + 1] = (i8[min max])(((scalar >> 12) & 63) | 128);
    buffer.Storage[writePosition + 2] = (i8[min max])(((scalar >> 6) & 63) | 128);
    buffer.Storage[writePosition + 3] = (i8[min max])((scalar & 63) | 128);
    buffer.WritePosition = (u64[0 2 ** 63 - 1])(writePosition + 4);
}

internal unsafe fn i32[min max] FlushEncodedWriteBuffer(rawptr<i8[min max]> handle, mut borrow System.Runtime.Buffer.FixedByteBuffer4096 buffer)
    where overlap(handle, buffer)
{
    stack u64[0 2 ** 63 - 1] length = buffer.WritePosition;
    if (length <= 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] byteLength = (u64[0 2 ** 63 - 1])length;
    stack mut i32[min max] status = 0;
    unsafe
    {
        status = WriteBufferToHandle(handle, &buffer.Storage[0], byteLength);
    }

    if (status == 0)
    {
        buffer.Clear();
    }

    return status;
}

internal unsafe fn i32[min max] WriteAsciiToHandle(rawptr<i8[min max]> handle, ascii text)
    where overlap(handle, text)
{
    stack i64[min max] length = AsciiLength(text);
    if (length <= 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] byteLength = (u64[0 2 ** 63 - 1])length;
    stack ascii view = text[0, length];
    stack mut i32[min max] status = 0;
    unsafe
    {
        status = WriteBufferToHandle(handle, AsciiData(view), byteLength);
    }

    return status;
}

internal unsafe fn i32[min max] WriteUnicodeToHandle(rawptr<i8[min max]> handle, unicode text)
    where overlap(handle, text)
{
    if (handle == null)
    {
        return -1;
    }

    stack i64[min max] length = UnicodeLength(text);
    if (length <= 0)
    {
        return 0;
    }

    stack mut System.Runtime.Buffer.FixedByteBuffer4096 utf8Buffer = new System.Runtime.Buffer.FixedByteBuffer4096();
    stack mut i64[min max] index = 0;

    while willexit (index < length)
    {
        stack unicode unit = text[index, 1];
        stack rawptr<i32[min max]> data = UnicodeData(unit);
        stack i32[min max] codePoint = *data;
        stack i64[min max] required = Utf8EncodedLength(codePoint);

        if (utf8Buffer.Writable() < required)
        {
            stack i32[min max] flushStatus = FlushEncodedWriteBuffer(handle, utf8Buffer);
            if (flushStatus != 0)
            {
                return flushStatus;
            }
        }

        AppendUtf8CodePoint(utf8Buffer, codePoint);
        index += 1;
    }

    return FlushEncodedWriteBuffer(handle, utf8Buffer);
}

