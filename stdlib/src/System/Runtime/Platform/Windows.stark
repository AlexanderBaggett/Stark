internal unsafe fn i32[min max] ReadPathMetadata(ascii path, rawmutptr<i8[min max]> metadataData)
{
    if (metadataData == null)
    {
        return -1;
    }

    stack mut i16[min max][4096] pathBuffer;
    if (!TryBuildWindowsWidePath(&pathBuffer[0], 4096, path))
    {
        return -1;
    }

    stack mut System.Runtime.Buffer.FixedByteBuffer512 attributeBuffer = new System.Runtime.Buffer.FixedByteBuffer512();
    stack rawmutptr<i8[min max]> attributeData = attributeBuffer.WritePointer();
    if (attributeData == null || attributeBuffer.Writable() < (u64[0 2 ** 63 - 1])WinFileAttributeDataMinBytes)
    {
        return -1;
    }

    if (GetFileAttributesExW(&pathBuffer[0], WinGetFileExInfoStandard, attributeData) == 0)
    {
        return NegativeLastError();
    }

    stack rawptr<i32[min max]> attributesPointer =
        (rawptr<i32[min max]>)(&attributeData[WinFileAttributeDataAttributesOffset]);
    stack rawptr<i32[min max]> modifiedLowPointer =
        (rawptr<i32[min max]>)(&attributeData[WinFileAttributeDataLastWriteTimeOffset]);
    stack rawptr<i32[min max]> modifiedHighPointer =
        (rawptr<i32[min max]>)(&attributeData[WinFileAttributeDataLastWriteTimeOffset + 4]);
    stack rawptr<i32[min max]> sizeHighPointer =
        (rawptr<i32[min max]>)(&attributeData[WinFileAttributeDataFileSizeHighOffset]);
    stack rawptr<i32[min max]> sizeLowPointer =
        (rawptr<i32[min max]>)(&attributeData[WinFileAttributeDataFileSizeLowOffset]);

    stack i32[min max] attributes = *attributesPointer;
    stack u64[0 max] fileSize = CombineUnsignedInts(*sizeHighPointer, *sizeLowPointer);
    stack u64[0 max] modifiedFileTime = CombineUnsignedInts(*modifiedHighPointer, *modifiedLowPointer);

    stack rawmutptr<i32[min max]> kindPointer =
        (rawmutptr<i32[min max]>)(&metadataData[WinPathMetadataKindOffset]);
    stack rawmutptr<i32[min max]> permissionsPointer =
        (rawmutptr<i32[min max]>)(&metadataData[WinPathMetadataPermissionsOffset]);
    stack rawmutptr<i64[min max]> sizeDestination =
        (rawmutptr<i64[min max]>)(&metadataData[WinPathMetadataSizeOffset]);
    stack rawmutptr<i64[min max]> modifiedSecondsDestination =
        (rawmutptr<i64[min max]>)(&metadataData[WinPathMetadataModifiedSecondsOffset]);
    stack rawmutptr<i64[min max]> modifiedNanosecondsDestination =
        (rawmutptr<i64[min max]>)(&metadataData[WinPathMetadataModifiedNanosecondsOffset]);

    *kindPointer = DirectoryEntryKindFromWindowsAttributes(attributes);
    *permissionsPointer = WindowsPermissionsFromAttributes(attributes);
    *sizeDestination = ClampUnsignedToNonNegativeI64(fileSize);
    *modifiedSecondsDestination = WindowsFileTimeToUnixSeconds(modifiedFileTime);
    *modifiedNanosecondsDestination = WindowsFileTimeToUnixNanoseconds(modifiedFileTime);
    return 0;
}

