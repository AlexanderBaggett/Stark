internal fn bool IsWideDirectorySeparatorUnit(i32[min max] value)
{
    return value == 47 || value == 92;
}

internal fn bool IsWideDriveLetter(i32[min max] value)
{
    unsafe
    {
        return (65 <= value && value <= 90)
            || (97 <= value && value <= 122);
    }
}

internal fn bool IsUtf8ContinuationByte(i8[min max] value)
{
    unsafe
    {
        stack i32[min max] unit = UnsignedByte(value);
        return 128 <= unit && unit <= 191;
    }
}

internal unsafe fn bool TryAppendWideCodeUnit(rawmutptr<i16[min max]> destination, i64[min max] capacity, rawmutptr<i64[min max]> writeIndex, i16[min max] value)
{
    if (destination == null || writeIndex == null)
    {
        return false;
    }

    stack i64[min max] index = *writeIndex;
    if (index >= capacity)
    {
        return false;
    }

    *(&destination[index]) = value;
    *writeIndex = index + 1;
    return true;
}

internal unsafe ffi asm(x86_64) fn void CopyWideUnits(rawmutptr<i16[min max]> destination, rawptr<i16[min max]> source, i32[min max] length)
