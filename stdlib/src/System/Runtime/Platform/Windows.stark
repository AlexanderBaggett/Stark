internal unsafe fn bool TryBuildWindowsDirectorySearchPath(rawmutptr<i16[min max]> destination, i64[min max] capacity, ascii path)
{
    stack mut System.Runtime.Buffer.FixedByteBuffer4096 pathBuffer = new System.Runtime.Buffer.FixedByteBuffer4096();
    stack mut Ascii searchPath = new Ascii();
    searchPath.Data = pathBuffer.WritePointer();
    searchPath.Length = 0;
    searchPath.Capacity = pathBuffer.Writable();
    stack i64[min max] length = AsciiLength(path);
    stack ascii fullPath = path[0, length];
    stack mut ascii suffix = "\\*";
    if (length > 0 && IsDirectorySeparator(path[length - 1, 1]))
    {
        suffix = "*";
    }

    if (!TryConcatAscii(&searchPath, fullPath, suffix))
    {
        return false;
    }

    return TryBuildWindowsWidePath(destination, capacity, AsciiView(searchPath));
}

internal unsafe fn rawptr<i8[min max]> OpenDirectoryWithFlags(ascii path, i32[min max] additionalFlags)
{
    stack mut i8[min max][592] findData;
    stack mut i64[min max] initialLength = 0;
    return OpenDirectoryWithFlagsInto(path, &findData[0], 592, &initialLength, additionalFlags);
}

internal unsafe fn rawptr<i8[min max]> OpenDirectoryWithFlagsInto(
    ascii path,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity,
    rawmutptr<i64[min max]> initialLength,
    i32[min max] additionalFlags)
{
    if (buffer == null || capacity < (u64[0 2 ** 63 - 1])WinFindDataMinBytes || initialLength == null)
    {
        return null;
    }

    stack mut i16[min max][4096] searchPath;
    if (!TryBuildWindowsDirectorySearchPath(&searchPath[0], 4096, path))
    {
        return null;
    }

    stack rawmutptr<i8[min max]> findHandle = FindFirstFileExW(
        &searchPath[0],
        WinFindExInfoBasic,
        buffer,
        WinFindExSearchNameMatch,
        null,
        additionalFlags);
    if (IsInvalidHandle(findHandle))
    {
        *initialLength = 0;
        return null;
    }

    *initialLength = 1;
    return (rawptr<i8[min max]>)findHandle;
}

