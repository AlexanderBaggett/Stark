internal unsafe fn i64[min max] ReadStdin(rawmutptr<i8[min max]>[capacity] buffer, u64[0 2 ** 63 - 1] capacity)
{
    stack rawptr<i8[min max]> handle = CachedStdin();
    if (handle == null || buffer == null || capacity == 0)
    {
        return 0;
    }

    stack mut i32[min max] bytesRead = 0;
    stack i32[min max] request = RequestedChunkLength((i64[min max])capacity);
    if (request <= 0)
    {
        return 0;
    }

    if (ReadFile(handle, buffer, request, &bytesRead, null) == 0 || bytesRead <= 0)
    {
        return 0;
    }

    return (i64[min max])bytesRead;
}

