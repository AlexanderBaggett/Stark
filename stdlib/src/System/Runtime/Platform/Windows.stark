internal fn void SleepThreadMilliseconds(u64[0 2 ** 63 - 1] milliseconds)
{
    unsafe
    {
        stack mut u64[0 2 ** 63 - 1] remaining = milliseconds;
        while willexit (remaining > 0)
        {
            stack mut u64[0 2 ** 63 - 1] chunk = remaining;
            if (chunk > WinMaxSleepMilliseconds)
            {
                chunk = (u64[0 2 ** 63 - 1])WinMaxSleepMilliseconds;
            }

            Sleep((i32[min max])chunk);
            remaining -= chunk;
        }

        return;
    }
}

