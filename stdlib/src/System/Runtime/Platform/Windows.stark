internal fn bool CachedStdoutIsTerminal()
{
    unsafe
    {
        if (!CachedStdoutTerminalInitialized)
        {
            stack rawptr<i8[min max]> handle = CachedStdout();
            CachedStdoutTerminal = handle != null && IsTerminal(handle);
            CachedStdoutTerminalInitialized = true;
        }

        return CachedStdoutTerminal;
    }
}

