internal fn i32[min max] ThreadNullEntry()
{
    return -1;
}

internal unsafe fn i32[min max] ThreadNoPayloadContextEntry(rawmutptr<i8[min max]> context)
{
    if (context == null)
    {
        return -1;
    }

    stack rawmutptr<WinThreadContext> typedContext = (rawmutptr<WinThreadContext>)context;
    return (*typedContext).ThreadEntry();
}

internal unsafe ffi(platform(windows.x86: stdcall, windows.x64: win64, default: c)) fn i32[min max] ThreadEntryThunk(rawmutptr<i8[min max]> context)
{
    if (context == null)
    {
        return -1;
    }

    stack rawmutptr<WinThreadContext> typedContext = (rawmutptr<WinThreadContext>)context;
    stack rawmutptr<i8[min max]> entryContext = (*typedContext).Context;
    stack i32[min max] exitCode = (*typedContext).Entry(entryContext);
    stack System.Memory.Allocation allocation = new System.Memory.Allocation()
    {
        Pointer = context,
        ByteLength = (u64[0 2 ** 63 - 1])sizeof(WinThreadContext),
        Alignment = alignof(WinThreadContext),
        Allocator = System.Memory.Allocator.Default()
    };
    System.Memory.Free(allocation);
    return exitCode;
}

internal unsafe fn rawmutptr<i8[min max]> StartThread(fnptr<fn i32[min max]()> entry)
{
    stack System.Memory.Allocation allocation = System.Memory.Allocate(
        System.Memory.Allocator.Default(),
        (u64[0 2 ** 63 - 1])sizeof(WinThreadContext),
        alignof(WinThreadContext));
    if (allocation.Pointer == null)
    {
        return null;
    }

    stack rawmutptr<WinThreadContext> context = (rawmutptr<WinThreadContext>)allocation.Pointer;
    *context = new WinThreadContext()
    {
        Entry = ThreadNoPayloadContextEntry,
        Context = allocation.Pointer,
        ThreadEntry = entry
    };

    stack rawmutptr<i8[min max]> handle = CreateThread(null, 0, ThreadEntryThunk, allocation.Pointer, 0, null);
    if (IsInvalidHandle(handle))
    {
        System.Memory.Free(allocation);
        return null;
    }

    return handle;
}

internal unsafe fn rawmutptr<i8[min max]> StartThreadWithContext(
    fnptr<unsafe fn i32[min max](rawmutptr<i8[min max]>)> entry,
    rawmutptr<i8[min max]> context)
{
    stack System.Memory.Allocation allocation = System.Memory.Allocate(
        System.Memory.Allocator.Default(),
        (u64[0 2 ** 63 - 1])sizeof(WinThreadContext),
        alignof(WinThreadContext));
    if (allocation.Pointer == null)
    {
        return null;
    }

    stack rawmutptr<WinThreadContext> threadContext = (rawmutptr<WinThreadContext>)allocation.Pointer;
    *threadContext = new WinThreadContext()
    {
        Entry = entry,
        Context = context,
        ThreadEntry = ThreadNullEntry
    };

    stack rawmutptr<i8[min max]> handle = CreateThread(null, 0, ThreadEntryThunk, allocation.Pointer, 0, null);
    if (IsInvalidHandle(handle))
    {
        System.Memory.Free(allocation);
        return null;
    }

    return handle;
}

internal unsafe fn i32[min max] JoinThread(rawmutptr<i8[min max]> handle, rawmutptr<i32[min max]> exitCode)
{
    if (handle == null || exitCode == null)
    {
        return -1;
    }

    if (WaitForSingleObject(handle, WinInfinite) != WinWaitObject0)
    {
        return NegativeLastError();
    }

    if (GetExitCodeThread(handle, exitCode) == 0)
    {
        return NegativeLastError();
    }

    if (CloseHandle(handle) == 0)
    {
        return NegativeLastError();
    }

    return 0;
}

internal unsafe fn i32[min max] DetachThread(rawmutptr<i8[min max]> handle)
{
    if (handle == null)
    {
        return -1;
    }

    if (CloseHandle(handle) == 0)
    {
        return NegativeLastError();
    }

    return 0;
}

internal fn i32[min max] NegativeSocketError()
{
    unsafe
    {
        stack i32[min max] error = WSAGetLastError();
        if (error <= 0)
        {
            return -1;
        }

        return -error;
    }
}

internal unsafe ffi(platform(windows.x86: stdcall, windows.x64: win64, default: c)) fn i32[min max] WinSockStartupOnce(
    rawmutptr<WinInitOnce> initOnce,
    rawptr<i8[min max]> parameter,
    rawmutptr<rawptr<i8[min max]>> context)
    where overlap(initOnce, parameter, context)
{
    stack mut i8[min max][512] data;
    stack i32[min max] result = WSAStartup(WinSockVersion2_2, &data[0]);
    if (result != 0)
    {
        WinSockStartupStatus = -result;
        return 0;
    }

    WinSockStartupStatus = 0;
    return 1;
}

internal fn i32[min max] EnsureWinSockStarted()
{
    unsafe
    {
        stack mut rawptr<i8[min max]> context = null;
        stack i32[min max] initialized = InitOnceExecuteOnce(
            &WinSockInitOnce,
            WinSockStartupOnce,
            null,
            &context);
        if (initialized == 0)
        {
            if (WinSockStartupStatus < 0)
            {
                return WinSockStartupStatus;
            }

            return NegativeLastError();
        }

        return WinSockStartupStatus;
    }
}

internal unsafe finite law bool IsInvalidSocket(rawmutptr<i8[min max]> handle)
{
    if (handle == null)
    {
        return true;
    }

    return (i64[min max])handle == -1;
}

internal unsafe fn rawptr<i8[min max]> OpenTcpSocket(rawmutptr<i32[min max]> status)
{
    stack i32[min max] startup = EnsureWinSockStarted();
    if (startup < 0)
    {
        if (status != null)
        {
            *status = startup;
        }

        return null;
    }

    stack rawmutptr<i8[min max]> socketHandle = WSASocketW(
        WinAddressFamilyInet,
        WinSocketStream,
        WinSocketProtocolTcp,
        null,
        0,
        WinSocketNoHandleInheritFlag);
    if (IsInvalidSocket(socketHandle))
    {
        if (status != null)
        {
            *status = NegativeSocketError();
        }

        return null;
    }

    return (rawptr<i8[min max]>)socketHandle;
}

internal unsafe fn void WriteTcpIPv4Sockaddr(
    rawmutptr<i8[min max]> destination,
    u8[0 max] a,
    u8[0 max] b,
    u8[0 max] c,
    u8[0 max] d,
    u16[0 max] port)
{
    if (destination == null)
    {
        return;
    }

    stack mut i64[min max] index = 0;
    while willexit (index < WinSockaddrInLength)
    {
        *(&destination[index]) = (i8[min max])0;
        index += 1;
    }

    stack i32[min max] portValue = (i32[min max])port;
    *(&destination[0]) = (i8[min max])WinAddressFamilyInet;
    *(&destination[1]) = (i8[min max])0;
    *(&destination[2]) = (i8[min max])(portValue >> 8);
    *(&destination[3]) = (i8[min max])(portValue & 255);
    *(&destination[4]) = (i8[min max])a;
    *(&destination[5]) = (i8[min max])b;
    *(&destination[6]) = (i8[min max])c;
    *(&destination[7]) = (i8[min max])d;
}

internal unsafe inline fn rawptr<i8[min max]> ConnectTcpIPv4(
    u8[0 max] a,
    u8[0 max] b,
    u8[0 max] c,
    u8[0 max] d,
    u16[0 max] port,
    rawmutptr<i32[min max]> status)
{
    if (status != null)
    {
        *status = 0;
    }

    stack rawptr<i8[min max]> handle = OpenTcpSocket(status);
    if (handle == null)
    {
        return null;
    }

    stack mut i8[min max][16] address;
    WriteTcpIPv4Sockaddr(&address[0], a, b, c, d, port);

    if (connect(handle, (rawptr<i8[min max]>)(&address[0]), (i32[min max])WinSockaddrInLength) != 0)
    {
        stack i32[min max] error = NegativeSocketError();
        CloseSocket(handle);
        if (status != null)
        {
            *status = error;
        }

        return null;
    }

    return handle;
}

internal unsafe inline fn rawptr<i8[min max]> ListenTcpIPv4(
    u8[0 max] a,
    u8[0 max] b,
    u8[0 max] c,
    u8[0 max] d,
    u16[0 max] port,
    rawmutptr<i32[min max]> status)
{
    if (status != null)
    {
        *status = 0;
    }

    stack rawptr<i8[min max]> handle = OpenTcpSocket(status);
    if (handle == null)
    {
        return null;
    }

    stack mut i8[min max][16] address;
    WriteTcpIPv4Sockaddr(&address[0], a, b, c, d, port);

    if (bind(handle, (rawptr<i8[min max]>)(&address[0]), (i32[min max])WinSockaddrInLength) != 0)
    {
        stack i32[min max] error = NegativeSocketError();
        CloseSocket(handle);
        if (status != null)
        {
            *status = error;
        }

        return null;
    }

    if (listen(handle, WinDefaultTcpListenBacklog) != 0)
    {
        stack i32[min max] error = NegativeSocketError();
        CloseSocket(handle);
        if (status != null)
        {
            *status = error;
        }

        return null;
    }

    return handle;
}

internal unsafe inline fn i64[min max] ReadSocket(
    rawptr<i8[min max]> handle,
    rawmutptr<i8[min max]>[capacity] buffer,
    u64[0 2 ** 63 - 1] capacity)
    where overlap(handle, buffer)
{
    if (handle == null)
    {
        return -10057;
    }

    if (capacity == 0)
    {
        return 0;
    }

    if (buffer == null)
    {
        return -10014;
    }

    stack i32[min max] request = RequestedChunkLength((i64[min max])capacity);
    stack i32[min max] result = recv(handle, buffer, request, 0);
    if (result < 0)
    {
        return NegativeSocketError();
    }

    return (i64[min max])result;
}

internal unsafe inline fn i64[min max] WriteSocket(
    rawptr<i8[min max]> handle,
    rawptr<i8[min max]>[length] buffer,
    u64[0 2 ** 63 - 1] length)
    where overlap(handle, buffer)
{
    if (handle == null)
    {
        return -10057;
    }

    if (length == 0)
    {
        return 0;
    }

    if (buffer == null)
    {
        return -10014;
    }

    stack i32[min max] request = RequestedChunkLength((i64[min max])length);
    stack i32[min max] result = send(handle, buffer, request, 0);
    if (result < 0)
    {
