    stack mut i32[min max] status = 0;
    unsafe
    {
        status = WriteBufferLineToHandle(handle, AsciiData(view), (u64[0 2 ** 63 - 1])length);
    }

    return status;
}

internal unsafe fn i32[min max] WriteUnicodeLineToHandle(rawptr<i8[min max]> handle, unicode text)
    where overlap(handle, text)
{
    if (handle == null)
    {
        return -1;
    }

    stack i64[min max] length = UnicodeLength(text);
    if (length < 0)
    {
        return -1;
    }

    stack mut System.Runtime.Buffer.FixedByteBuffer4096 utf8Buffer = new System.Runtime.Buffer.FixedByteBuffer4096();
    stack mut i64[min max] index = 0;

    while willexit (index < length)
    {
        stack unicode unit = text[index, 1];
        stack rawptr<i32[min max]> data = UnicodeData(unit);
        stack i32[min max] codePoint = *data;
        stack i64[min max] required = Utf8EncodedLength(codePoint);

        if (utf8Buffer.Writable() < required)
        {
            stack i32[min max] flushStatus = FlushEncodedWriteBuffer(handle, utf8Buffer);
            if (flushStatus != 0)
            {
                return flushStatus;
            }
        }

        AppendUtf8CodePoint(utf8Buffer, codePoint);
        index += 1;
    }

    if (utf8Buffer.Writable() < 1)
    {
        stack i32[min max] flushStatus = FlushEncodedWriteBuffer(handle, utf8Buffer);
        if (flushStatus != 0)
        {
            return flushStatus;
        }
    }

    AppendUtf8CodePoint(utf8Buffer, 10);
    return FlushEncodedWriteBuffer(handle, utf8Buffer);
}

internal unsafe fn bool TryAppendConsoleWideCodePoint(
    rawmutptr<i16[min max]> destination,
    i64[min max] capacity,
    rawmutptr<i64[min max]> writeIndex,
    i32[min max] codePoint)
{
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);
    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        return TryAppendWideCodeUnit(destination, capacity, writeIndex, (i16[min max])scalar);
    }

    stack i32[min max] adjusted = scalar - (i32[min max])(2 ** 16);
    if (!TryAppendWideCodeUnit(destination, capacity, writeIndex, (i16[min max])((adjusted >> 10) + 55296)))
    {
        return false;
    }

    return TryAppendWideCodeUnit(destination, capacity, writeIndex, (i16[min max])((adjusted & 1023) + 56320));
}

internal unsafe fn i32[min max] WriteWideConsoleBuffer(
    rawptr<i8[min max]> handle,
    rawptr<i16[min max]>[length] buffer,
    u64[0 2 ** 63 - 1] length)
{
    if (handle == null)
    {
        return -1;
    }

    if (length == 0)
    {
        return 0;
    }

    if (buffer == null)
    {
        return -1;
    }

    stack mut u64[0 2 ** 63 - 1] remaining = length;
    stack mut u64[0 2 ** 63 - 1] written = 0;
    while willexit (remaining > 0)
    {
        stack i32[min max] request = RequestedChunkLength((i64[min max])remaining);
        stack mut i32[min max] chunkWritten = 0;
        stack rawptr<i16[min max]> chunk = &buffer[written];
        if (WriteConsoleW(handle, chunk, request, &chunkWritten, null) == 0)
        {
            return NegativeLastError();
        }

        if (chunkWritten <= 0)
        {
            return -1;
        }

        stack u64[0 2 ** 63 - 1] chunkLength = (u64[0 2 ** 63 - 1])chunkWritten;
        written += chunkLength;
        remaining -= chunkLength;
    }

    return 0;
}

internal unsafe fn i32[min max] FlushWideConsoleBuffer(
    rawptr<i8[min max]> handle,
    rawmutptr<i16[min max]> buffer,
    rawmutptr<i64[min max]> writeIndex)
{
    stack i64[min max] length = *writeIndex;
    if (length <= 0)
    {
        return 0;
    }

    stack mut i32[min max] status = 0;
    unsafe
    {
        status = WriteWideConsoleBuffer(handle, buffer, (u64[0 2 ** 63 - 1])length);
    }

    if (status == 0)
    {
        *writeIndex = 0;
    }

    return status;
}

internal unsafe fn i32[min max] WriteUnicodeConsoleToHandle(rawptr<i8[min max]> handle, unicode text, bool trailingNewline)
    where overlap(handle, text)
{
    if (handle == null)
    {
        return -1;
    }

    stack i64[min max] length = UnicodeLength(text);
    if (length < 0)
    {
        return -1;
    }

    if (length == 0 && !trailingNewline)
    {
        return 0;
    }

    stack mut i16[min max][4096] wideBuffer;
    stack mut i64[min max] writeIndex = 0;
    stack mut i64[min max] index = 0;

    while willexit (index < length)
    {
        if (writeIndex > 4094)
        {
            stack i32[min max] flushStatus = FlushWideConsoleBuffer(handle, &wideBuffer[0], &writeIndex);
            if (flushStatus != 0)
            {
                return flushStatus;
            }
        }

        stack unicode unit = text[index, 1];
        stack rawptr<i32[min max]> data = UnicodeData(unit);
        if (!TryAppendConsoleWideCodePoint(&wideBuffer[0], 4096, &writeIndex, *data))
        {
            stack i32[min max] retryFlushStatus = FlushWideConsoleBuffer(handle, &wideBuffer[0], &writeIndex);
            if (retryFlushStatus != 0)
            {
                return retryFlushStatus;
            }

            if (!TryAppendConsoleWideCodePoint(&wideBuffer[0], 4096, &writeIndex, *data))
            {
                return -1;
            }
        }

        index += 1;
    }

    if (trailingNewline)
    {
        if (writeIndex >= 4096)
        {
            stack i32[min max] flushStatus = FlushWideConsoleBuffer(handle, &wideBuffer[0], &writeIndex);
            if (flushStatus != 0)
            {
                return flushStatus;
            }
        }

        TryAppendConsoleWideCodePoint(&wideBuffer[0], 4096, &writeIndex, 10);
    }

    return FlushWideConsoleBuffer(handle, &wideBuffer[0], &writeIndex);
}

internal unsafe fn FileOpenResult OpenFileWithDispositionResult(ascii path, i32[min max] desiredAccess, i32[min max] creationDisposition)
{
    stack mut i16[min max][4096] pathBuffer;
    if (!TryBuildWindowsWidePath(&pathBuffer[0], 4096, path))
    {
        return FileOpenResult.Err(-206);
    }

    stack rawmutptr<i8[min max]> handle = CreateFileW(
        &pathBuffer[0],
        desiredAccess,
        WinFileShareRead | WinFileShareWrite,
        null,
        creationDisposition,
        WinFileAttributeNormal,
        null);

    if (IsInvalidHandle(handle))
    {
        return FileOpenResult.Err(NegativeLastError());
    }

    return FileOpenResult.Ok((rawptr<i8[min max]>)handle);
}

internal unsafe fn rawptr<i8[min max]> OpenFileWithDisposition(ascii path, i32[min max] desiredAccess, i32[min max] creationDisposition)
{
    switch (OpenFileWithDispositionResult(path, desiredAccess, creationDisposition))
    {
        case FileOpenResult.Ok(var handle):
            return handle;
        case FileOpenResult.Err(var error):
            return null;
    }
}

