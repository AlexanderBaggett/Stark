internal unsafe fn i64[min max] ReadFile(rawmutptr<i8[min max]> buffer, i64[min max] size, i64[min max] count, rawptr<i8[min max]> handle)
    where overlap(buffer, handle)
{
    if (handle == null || buffer == null || size <= 0 || count <= 0)
    {
        return 0;
    }

    stack i64[min max] bytesRequested = size * count;
    stack i32[min max] request = RequestedChunkLength(bytesRequested);
    stack mut i32[min max] bytesRead = 0;
    if (ReadFile(handle, buffer, request, &bytesRead, null) == 0)
    {
        return 0;
    }

    if (bytesRead <= 0)
    {
        return 0;
    }

    return ((i64[min max])bytesRead) / size;
}

