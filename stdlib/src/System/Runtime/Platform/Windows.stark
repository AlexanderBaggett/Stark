            *kind = -1;
            *name = new Ascii() {
                Data = nameData,
                Length = -2,
                Capacity = nameCapacity
            };
            return -1;
        }

        *kind = DirectoryEntryKindFromWindowsAttributes(attributes);
        return 1;
    }
}

internal fn bool TryCurrentDirectory(rawmutptr<Ascii> destination) {
    if (destination == null) {
        return false;
    }

    stack rawmutptr<i8[-128 127]> data = (*destination).Data;
    stack i64[-9223372036854775808 9223372036854775807] capacity = (*destination).Capacity;
    if (data == null || capacity <= 0) {
        ResetAsciiDestination(destination);
        return false;
    }

    stack mut i16[-32768 32767][4096] pathBuffer;
    stack i32[-2147483648 2147483647] written = GetCurrentDirectoryW(4096, &pathBuffer[0]);
    if (written <= 0 || written >= 4096) {
        ResetAsciiDestination(destination);
        return false;
    }

    return TryCopyWideUtf8(destination, &pathBuffer[0], written);
}
