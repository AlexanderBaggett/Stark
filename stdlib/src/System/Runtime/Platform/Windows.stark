internal unsafe inline fn i64[min max] CompleteNtFileByteTransfer(
    i32[min max] status,
    rawmutptr<WinIoStatusBlock> ioStatus,
    rawptr<i8[min max]> handle)
    where overlap(ioStatus, handle)
{
    stack mut i32[min max] finalStatus = status;
    if (finalStatus == WinNtStatusPending)
    {
        if (WaitForSingleObject(handle, WinInfinite) != WinWaitObject0)
        {
            return (i64[min max])NegativeLastError();
        }

        finalStatus = (*ioStatus).Status;
    }

    if (finalStatus == WinNtStatusEndOfFile)
    {
        return 0;
    }

    if (finalStatus != WinNtStatusSuccess)
    {
        return (i64[min max])finalStatus;
    }

    if ((*ioStatus).Information <= 0)
    {
        return 0;
    }

    return (*ioStatus).Information;
}

internal unsafe inline fn i64[min max] ReadFileBytesFast(rawmutptr<i8[min max]>[length] buffer, u64[0 2 ** 63 - 1] length, rawptr<i8[min max]> handle)
    where overlap(buffer, handle)
{
    if (handle == null || buffer == null || length == 0)
    {
        return 0;
    }

    stack i32[min max] request = RequestedChunkLength((i64[min max])length);
    stack mut WinIoStatusBlock ioStatus = new WinIoStatusBlock()
    {
        Status = 0,
        Padding = 0,
        Information = 0
    };
    stack i32[min max] status = NtReadFile(
        handle,
        null,
        null,
        null,
        &ioStatus,
        buffer,
        request,
        null,
        null);

    return CompleteNtFileByteTransfer(status, &ioStatus, handle);
}

