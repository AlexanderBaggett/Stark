internal unsafe fn rawptr<i8[min max]> CachedStdout()
{
    if (!CachedStdoutHandleInitialized)
    {
        stack rawmutptr<i8[min max]> handle = GetStdHandle(WinStdOutputHandle);
        if (IsInvalidHandle(handle))
        {
            CachedStdoutHandle = null;
        }
        else
        {
            CachedStdoutHandle = (rawptr<i8[min max]>)handle;
        }

        CachedStdoutHandleInitialized = true;
    }

    return CachedStdoutHandle;
}

