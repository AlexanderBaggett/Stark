internal unsafe fn bool TryCopyWideRange(
    rawmutptr<i16[min max]> destination,
    i64[min max] capacity,
    rawmutptr<i64[min max]> writeIndex,
    rawptr<i16[min max]> source,
    i64[min max] sourceLength)
{
    if (destination == null || writeIndex == null || source == null || sourceLength < 0)
    {
        return false;
    }

    stack i64[min max] index = *writeIndex;
    if (index < 0 || index > capacity || sourceLength > capacity - index)
    {
        return false;
    }

    CopyWideUnits(&destination[index], source, (i32[min max])sourceLength);
    *writeIndex = index + sourceLength;
    return true;
}

internal unsafe fn bool HasLongPathPrefix(rawptr<i16[min max]> source, i64[min max] sourceLength)
{
    if (source == null || sourceLength < 4)
    {
        return false;
    }

    return UnsignedWide(*(&source[0])) == 92
        && UnsignedWide(*(&source[1])) == 92
        && UnsignedWide(*(&source[2])) == 63
        && UnsignedWide(*(&source[3])) == 92;
}

internal unsafe fn bool IsDriveAbsoluteWidePath(rawptr<i16[min max]> source, i64[min max] sourceLength)
{
    if (source == null || sourceLength < 3)
    {
        return false;
    }

    return IsWideDriveLetter(UnsignedWide(*(&source[0])))
        && UnsignedWide(*(&source[1])) == 58
        && IsWideDirectorySeparatorUnit(UnsignedWide(*(&source[2])));
}

internal unsafe fn bool IsUncWidePath(rawptr<i16[min max]> source, i64[min max] sourceLength)
{
    if (source == null || sourceLength < 2)
    {
        return false;
    }

    return IsWideDirectorySeparatorUnit(UnsignedWide(*(&source[0])))
        && IsWideDirectorySeparatorUnit(UnsignedWide(*(&source[1])));
}

internal unsafe fn bool TryDecodeUtf8CodePoint(
    rawptr<i8[min max]> data,
    i64[min max] length,
    rawmutptr<i64[min max]> index,
    rawmutptr<i32[min max]> codePoint)
{
    if (data == null || index == null || codePoint == null)
    {
        return false;
    }

    stack i64[min max] readIndex = *index;
    if (readIndex < 0 || readIndex >= length)
    {
        return false;
    }

    stack i32[min max] first = UnsignedByte(*(&data[readIndex]));
    if (first <= 127)
    {
        *index = readIndex + 1;
        *codePoint = first;
        return true;
    }

    if (194 <= first && first <= 223)
    {
        if (readIndex + 1 >= length)
        {
            return false;
        }

        stack i8[min max] secondRaw = *(&data[readIndex + 1]);
        if (!IsUtf8ContinuationByte(secondRaw))
        {
            return false;
        }

        stack i32[min max] second = UnsignedByte(secondRaw);
        *index = readIndex + 2;
        *codePoint = ((first & 31) << 6) | (second & 63);
        return true;
    }

    if (224 <= first && first <= 239)
    {
        if (readIndex + 2 >= length)
        {
            return false;
        }

        stack i8[min max] secondRaw = *(&data[readIndex + 1]);
        stack i8[min max] thirdRaw = *(&data[readIndex + 2]);
        if (!IsUtf8ContinuationByte(secondRaw) || !IsUtf8ContinuationByte(thirdRaw))
        {
            return false;
        }

        stack i32[min max] second = UnsignedByte(secondRaw);
        stack i32[min max] third = UnsignedByte(thirdRaw);
        if (first == 224 && second < 160)
        {
            return false;
        }

        if (first == 237 && second >= 160)
        {
            return false;
        }

        *index = readIndex + 3;
        *codePoint = ((first & 15) << 12)
            | ((second & 63) << 6)
            | (third & 63);
        return true;
    }

    if (240 <= first && first <= 244)
    {
        if (readIndex + 3 >= length)
        {
            return false;
        }

        stack i8[min max] secondRaw = *(&data[readIndex + 1]);
        stack i8[min max] thirdRaw = *(&data[readIndex + 2]);
        stack i8[min max] fourthRaw = *(&data[readIndex + 3]);
        if (!IsUtf8ContinuationByte(secondRaw)
            || !IsUtf8ContinuationByte(thirdRaw)
            || !IsUtf8ContinuationByte(fourthRaw))
            {
            return false;
        }

        stack i32[min max] second = UnsignedByte(secondRaw);
        stack i32[min max] third = UnsignedByte(thirdRaw);
        stack i32[min max] fourth = UnsignedByte(fourthRaw);
        if (first == 240 && second < 144)
        {
            return false;
        }

        if (first == 244 && second > 143)
        {
            return false;
        }

        *index = readIndex + 4;
        *codePoint = ((first & 7) << 18)
            | ((second & 63) << 12)
            | ((third & 63) << 6)
            | (fourth & 63);
        return true;
    }

    return false;
}

internal unsafe fn bool TryAppendWideCodePoint(
    rawmutptr<i16[min max]> destination,
    i64[min max] capacity,
    rawmutptr<i64[min max]> writeIndex,
    i32[min max] codePoint)
{
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);
    if (scalar == 0)
    {
        return false;
    }

    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        return TryAppendWideCodeUnit(destination, capacity, writeIndex, (i16[min max])scalar);
    }

    stack i32[min max] adjusted = scalar - (i32[min max])(2 ** 16);
    if (!TryAppendWideCodeUnit(destination, capacity, writeIndex, (i16[min max])((adjusted >> 10) + 55296)))
    {
        return false;
    }

    return TryAppendWideCodeUnit(destination, capacity, writeIndex, (i16[min max])((adjusted & 1023) + 56320));
}

internal unsafe fn bool TryDecodeUtf8PathToWide(
    rawmutptr<i16[min max]> destination,
    i64[min max] capacity,
    ascii path,
    rawmutptr<i64[min max]> writtenLength)
{
    if (destination == null || writtenLength == null || capacity <= 0)
    {
        return false;
    }

    stack i64[min max] length = AsciiLength(path);
    stack ascii fullPath = path[0, length];
    stack rawptr<i8[min max]> data = AsciiData(fullPath);
    if (length > 0 && data == null)
    {
        return false;
    }

    stack mut i64[min max] readIndex = 0;
    stack mut i64[min max] writeIndex = 0;

    while willexit (readIndex < length)
    {
        stack mut i32[min max] codePoint = 0;
        if (!TryDecodeUtf8CodePoint(data, length, &readIndex, &codePoint))
        {
            return false;
        }

        if (codePoint == 47)
        {
            codePoint = 92;
        }

        if (!TryAppendWideCodePoint(destination, capacity, &writeIndex, codePoint))
        {
            return false;
        }
    }

    *writtenLength = writeIndex;
    return true;
}

internal unsafe fn bool TryBuildAbsoluteWindowsWidePath(
    rawmutptr<i16[min max]> destination,
    i64[min max] capacity,
    rawptr<i16[min max]> source,
    i64[min max] sourceLength,
    rawmutptr<i64[min max]> writtenLength)
{
    if (destination == null || writtenLength == null || source == null)
    {
        return false;
    }

    if (IsDriveAbsoluteWidePath(source, sourceLength)
        || IsUncWidePath(source, sourceLength)
        || HasLongPathPrefix(source, sourceLength))
        {
        stack mut i64[min max] directLength = 0;
        if (!TryCopyWideRange(destination, capacity, &directLength, source, sourceLength))
        {
            return false;
        }

        *writtenLength = directLength;
        return true;
    }

    stack mut i16[min max][4096] currentDirectory;
    stack i32[min max] currentDirectoryLength = GetCurrentDirectoryW(4096, &currentDirectory[0]);
    if (currentDirectoryLength <= 0 || currentDirectoryLength >= 4096)
    {
        return false;
    }

    stack mut i64[min max] writeIndex = 0;
    if (sourceLength > 0 && IsWideDirectorySeparatorUnit(UnsignedWide(*(&source[0]))))
    {
        if (HasLongPathPrefix(&currentDirectory[0], currentDirectoryLength))
        {
            if (currentDirectoryLength < 6
                || !IsWideDriveLetter(UnsignedWide(*(&currentDirectory[4])))
                || UnsignedWide(*(&currentDirectory[5])) != 58)
                {
                return false;
            }

            if (!TryCopyWideRange(destination, capacity, &writeIndex, &currentDirectory[0], 6))
            {
                return false;
            }
        }
        else
        {
            if (currentDirectoryLength < 2
                || !IsWideDriveLetter(UnsignedWide(*(&currentDirectory[0])))
                || UnsignedWide(*(&currentDirectory[1])) != 58)
                {
                return false;
            }

            if (!TryCopyWideRange(destination, capacity, &writeIndex, &currentDirectory[0], 2))
            {
                return false;
            }
        }

        if (!TryCopyWideRange(destination, capacity, &writeIndex, source, sourceLength))
        {
            return false;
        }

        *writtenLength = writeIndex;
        return true;
    }

    if (!TryCopyWideRange(destination, capacity, &writeIndex, &currentDirectory[0], currentDirectoryLength))
    {
        return false;
    }

    if (writeIndex > 0 && !IsWideDirectorySeparatorUnit(UnsignedWide(*(&destination[writeIndex - 1]))))
    {
        if (!TryAppendWideCodeUnit(destination, capacity, &writeIndex, (i16[min max])92))
        {
            return false;
        }
    }

    if (!TryCopyWideRange(destination, capacity, &writeIndex, source, sourceLength))
    {
        return false;
    }

    *writtenLength = writeIndex;
    return true;
}

internal unsafe fn bool TryBuildLongWindowsWidePath(rawmutptr<i16[min max]> destination, i64[min max] capacity, rawptr<i16[min max]> source, i64[min max] sourceLength)
{
    if (destination == null || capacity <= 0 || source == null)
    {
        return false;
    }

    stack mut i16[min max][4096] absolutePath;
    stack mut rawptr<i16[min max]> absoluteSource = source;
    stack mut i64[min max] absoluteLength = sourceLength;

    if (!HasLongPathPrefix(source, sourceLength)
        && !IsDriveAbsoluteWidePath(source, sourceLength)
        && !IsUncWidePath(source, sourceLength))
        {
        if (!TryBuildAbsoluteWindowsWidePath(&absolutePath[0], 4096, source, sourceLength, &absoluteLength))
        {
            return false;
        }

        absoluteSource = &absolutePath[0];
    }

    stack mut i64[min max] writeIndex = 0;
    assume disjoint(destination, absoluteSource)
    {
        if (HasLongPathPrefix(absoluteSource, absoluteLength))
        {
            if (!TryCopyWideRange(destination, capacity - 1, &writeIndex, absoluteSource, absoluteLength))
            {
                return false;
            }
        }
        else if (IsUncWidePath(absoluteSource, absoluteLength))
        {
            if (!TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])92)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])92)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])63)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])92)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])85)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])78)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])67)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])92))
                {
                return false;
            }

            if (!TryCopyWideRange(destination, capacity - 1, &writeIndex, &absoluteSource[2], absoluteLength - 2))
            {
                return false;
            }
        }
        else if (IsDriveAbsoluteWidePath(absoluteSource, absoluteLength))
        {
            if (!TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])92)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])92)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])63)
                || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16[min max])92))
                {
                return false;
            }

            if (!TryCopyWideRange(destination, capacity - 1, &writeIndex, absoluteSource, absoluteLength))
            {
                return false;
            }
        }
        else
        {
            return false;
        }
    }

    *(&destination[writeIndex]) = 0;
    return true;
}

internal unsafe fn bool TryBuildWindowsWidePath(rawmutptr<i16[min max]> destination, i64[min max] capacity, ascii path)
{
    if (destination == null || capacity <= 0)
    {
        return false;
    }

    stack mut i16[min max][4096] normalizedPath;
    stack mut i64[min max] normalizedLength = 0;
    if (!TryDecodeUtf8PathToWide(&normalizedPath[0], 4096, path, &normalizedLength))
    {
        return false;
    }

    if (normalizedLength >= WinLongPathThreshold
        && !HasLongPathPrefix(&normalizedPath[0], normalizedLength))
        {
        return TryBuildLongWindowsWidePath(destination, capacity, &normalizedPath[0], normalizedLength);
    }

    if (normalizedLength + 1 > capacity)
    {
        return false;
    }

    stack mut i64[min max] writeIndex = 0;
    if (!TryCopyWideRange(destination, capacity - 1, &writeIndex, &normalizedPath[0], normalizedLength))
    {
        return false;
    }

    *(&destination[writeIndex]) = 0;
    return true;
}

internal unsafe fn void WriteUtf8CodePointToPointer(rawmutptr<i8[min max]> destination, rawmutptr<i64[min max]> writeIndex, i32[min max] codePoint)
{
    stack i32[min max] scalar = NormalizeUnicodeCodePoint(codePoint);
    stack i64[min max] index = *writeIndex;

    if (scalar <= 127)
    {
        *(&destination[index]) = (i8[min max])scalar;
        *writeIndex = index + 1;
        return;
    }

    if (scalar <= 2047)
    {
        *(&destination[index]) = (i8[min max])((scalar >> 6) | 192);
        *(&destination[index + 1]) = (i8[min max])((scalar & 63) | 128);
        *writeIndex = index + 2;
        return;
    }

    if (scalar <= (i32[min max])(2 ** 16 - 1))
    {
        *(&destination[index]) = (i8[min max])((scalar >> 12) | 224);
        *(&destination[index + 1]) = (i8[min max])(((scalar >> 6) & 63) | 128);
        *(&destination[index + 2]) = (i8[min max])((scalar & 63) | 128);
        *writeIndex = index + 3;
        return;
    }

    *(&destination[index]) = (i8[min max])((scalar >> 18) | 240);
    *(&destination[index + 1]) = (i8[min max])(((scalar >> 12) & 63) | 128);
    *(&destination[index + 2]) = (i8[min max])(((scalar >> 6) & 63) | 128);
    *(&destination[index + 3]) = (i8[min max])((scalar & 63) | 128);
    *writeIndex = index + 4;
}

internal unsafe fn bool TryCopyWideUtf8(rawmutptr<Ascii> destination, rawptr<i16[min max]> source, i32[min max] length)
{
    if (destination == null || source == null || length < 0)
    {
        ResetAsciiDestination(destination);
        return false;
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    stack i64[min max] required = (i64[min max])length;
    if (required > capacity)
    {
        ResetAsciiDestination(destination);
        return false;
    }

    if (required > 0 && data == null)
    {
        ResetAsciiDestination(destination);
        return false;
    }

    stack mut i64[min max] readIndex = 0;
    stack mut i64[min max] writeIndex = 0;
    while willexit (readIndex < required)
    {
        stack i32[min max] first = UnsignedWide(*(&source[readIndex]));
        stack mut i32[min max] codePoint = first;
        readIndex += 1;

        if (55296 <= first && first <= 56319)
        {
            if (readIndex < required)
            {
                stack i32[min max] second = UnsignedWide(*(&source[readIndex]));
                if (56320 <= second && second <= 57343)
                {
                    readIndex += 1;
                    codePoint = (((first - 55296) << 10) | (second - 56320)) + (i32[min max])(2 ** 16);
                }
                else
                {
                    codePoint = 65533;
                }
            }
            else
            {
                codePoint = 65533;
            }
        }
        else if (56320 <= first && first <= 57343)
        {
            codePoint = 65533;
        }

        stack i64[min max] encodedLength = Utf8EncodedLength(codePoint);
        if (writeIndex + encodedLength > capacity)
        {
            ResetAsciiDestination(destination);
            return false;
        }

        WriteUtf8CodePointToPointer(data, &writeIndex, codePoint);
    }

    *destination = new Ascii()
    {
        Data = data,
        Length = writeIndex,
        Capacity = capacity
    };
    return true;
}

internal unsafe fn i32[min max] TryCopyWideAscii(rawmutptr<Ascii> destination, rawptr<i16[min max]> source, i32[min max] length)
{
    if (destination == null || source == null || length < 0)
    {
        ResetAsciiDestination(destination);
        return -1;
    }

    stack rawmutptr<i8[min max]> data = (*destination).Data;
    stack i64[min max] capacity = (*destination).Capacity;
    stack i64[min max] required = (i64[min max])length;
    if (required > capacity)
    {
        ResetAsciiDestination(destination);
        return -1;
    }

    if (required > 0 && data == null)
    {
        ResetAsciiDestination(destination);
        return -1;
    }

    stack mut i64[min max] index = 0;
    while willexit (index < required)
    {
        stack i32[min max] value = UnsignedWide(*(&source[index]));
        if (value > 127)
        {
            return 0;
        }

        *(&data[index]) = (i8[min max])value;
        index += 1;
    }

    *destination = new Ascii()
    {
        Data = data,
        Length = required,
        Capacity = capacity
    };
    return 1;
}

internal unsafe fn i64[min max] WideUtf8Length(rawptr<i16[min max]> source, i32[min max] length)
{
    if (source == null || length < 0)
    {
        return -1;
    }

    stack i64[min max] required = (i64[min max])length;
    stack mut i64[min max] readIndex = 0;
    stack mut i64[min max] encodedLength = 0;
    while willexit (readIndex < required)
    {
        stack i32[min max] first = UnsignedWide(*(&source[readIndex]));
        if (first <= 127)
        {
            readIndex += 1;
            encodedLength += 1;
            continue;
        }

        stack mut i32[min max] codePoint = first;
        readIndex += 1;

        if (55296 <= first && first <= 56319)
        {
            if (readIndex < required)
            {
                stack i32[min max] second = UnsignedWide(*(&source[readIndex]));
                if (56320 <= second && second <= 57343)
                {
                    readIndex += 1;
                    codePoint = (((first - 55296) << 10) | (second - 56320)) + (i32[min max])(2 ** 16);
                }
                else
                {
                    codePoint = 65533;
                }
            }
            else
            {
                codePoint = 65533;
            }
        }
        else if (56320 <= first && first <= 57343)
        {
            codePoint = 65533;
        }

        encodedLength += Utf8EncodedLength(codePoint);
    }

    return encodedLength;
}

internal unsafe fn i32[min max] WriteBufferToHandle(rawptr<i8[min max]> handle, rawptr<i8[min max]>[length] buffer, u64[0 2 ** 63 - 1] length)
    where overlap(handle, buffer)
{
    if (handle == null)
    {
        return -1;
    }

    if (length == 0)
    {
        return 0;
    }

    if (buffer == null)
    {
        return -1;
    }

    stack mut u64[0 2 ** 63 - 1] remaining = length;
    stack mut u64[0 2 ** 63 - 1] written = 0;

    while willexit (remaining > 0)
    {
        stack i32[min max] request = RequestedChunkLength(remaining);
        stack mut i32[min max] chunkWritten = 0;
        stack rawptr<i8[min max]> chunk = &buffer[written];
        stack i32[min max] result = WriteFile(handle, chunk, request, &chunkWritten, null);
        if (result == 0)
        {
            return NegativeLastError();
        }

        if (chunkWritten <= 0)
        {
            return -1;
        }

        stack u64[0 2 ** 63 - 1] chunk = (u64[0 2 ** 63 - 1])chunkWritten;
        written += chunk;
        remaining -= chunk;
    }

    return 0;
}

internal unsafe noinline fn i32[min max] WriteBufferLineToHandleLarge(
    rawptr<i8[min max]> handle,
    rawptr<i8[min max]>[length] buffer,
    u64[0 2 ** 63 - 1] length)
    where overlap(handle, buffer)
{
    if (length < 8192)
    {
        stack mut System.Runtime.Buffer.FixedByteBuffer8192 lineBuffer = new System.Runtime.Buffer.FixedByteBuffer8192();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < length; index += 1)
        {
            lineBuffer.Storage[index] = *(&buffer[index]);
