import System.Runtime.Buffer
import System.Text
module System.Runtime.Platform.Windows

internal ffi fn rawmutptr<i8> GetStdHandle(i32 nStdHandle);
internal ffi fn i32 WriteFile(rawptr<i8> hFile, rawptr<i8> buffer, i32 bytesToWrite, rawmutptr<i32> bytesWritten, rawptr<i8> overlapped);
internal ffi fn i32 ReadFile(rawptr<i8> hFile, rawptr<i8> buffer, i32 bytesToRead, rawmutptr<i32> bytesRead, rawptr<i8> overlapped);
internal ffi fn rawmutptr<i8> CreateFileW(rawptr<i16> fileName, i32 desiredAccess, i32 shareMode, rawptr<i8> securityAttributes, i32 creationDisposition, i32 flagsAndAttributes, rawptr<i8> templateFile);
internal ffi fn i32 CloseHandle(rawptr<i8> handle);
internal ffi fn i32 FlushFileBuffers(rawptr<i8> handle);
internal ffi fn i32 DeleteFileW(rawptr<i16> path);
internal ffi fn i32 MoveFileExW(rawptr<i16> existingPath, rawptr<i16> newPath, i32 flags);
internal ffi fn i32 GetFileAttributesW(rawptr<i16> path);
internal ffi fn i32 GetCurrentDirectoryW(i32 bufferLength, rawmutptr<i16> buffer);
internal ffi fn i32 GetConsoleMode(rawptr<i8> handle, rawmutptr<i32> mode);
internal ffi fn i32 GetLastError();

const i32 WinStdOutputHandle = -11;
const i32 WinStdErrorHandle = -12;
const i32 WinGenericRead = -2147483648;
const i32 WinGenericWrite = 1073741824;
const i32 WinFileAppendData = 4;
const i32 WinFileShareRead = 1;
const i32 WinFileShareWrite = 2;
const i32 WinCreateAlways = 2;
const i32 WinOpenExisting = 3;
const i32 WinOpenAlways = 4;
const i32 WinFileAttributeNormal = 128;
const i32 WinMoveFileReplaceExisting = 1;
const i32 WinInvalidFileAttributes = -1;
const i64 WinLongPathThreshold = 248;

internal fn void ResetAsciiDestination(rawmutptr<Ascii> destination) {
    if (destination == null) {
        return;
    }

    stack rawmutptr<i8> data = (*destination).Data;
    stack i64 capacity = (*destination).Capacity;
    *destination = new Ascii() {
        Data = data,
        Length = 0,
        Capacity = capacity
    };
}

internal fn i32 NegativeLastError() {
    stack i32 error = GetLastError();
    if (error <= 0) {
        return -1;
    }

    return -error;
}

internal fn bool IsInvalidHandle(rawmutptr<i8> handle) {
    if (handle == null) {
        return true;
    }

    return (i64)handle == -1;
}

internal fn i32 RequestedChunkLength(i64 totalBytes) {
    if (totalBytes > 2147483647) {
        return 2147483647;
    }

    return (i32)totalBytes;
}

internal fn i32 UnsignedByte(i8 value) {
    if (value < 0) {
        return ((i32)value) + 256;
    }

    return (i32)value;
}

internal fn i32 UnsignedWide(i16 value) {
    if (value < 0) {
        return ((i32)value) + 65536;
    }

    return (i32)value;
}

internal fn bool IsWideDirectorySeparatorUnit(i32 value) {
    return value == 47 || value == 92;
}

internal fn bool IsWideDriveLetter(i32 value) {
    return (65 <= value && value <= 90)
        || (97 <= value && value <= 122);
}

internal fn bool IsUtf8ContinuationByte(i8 value) {
    stack i32 unit = UnsignedByte(value);
    return 128 <= unit && unit <= 191;
}

internal fn bool TryAppendWideCodeUnit(rawmutptr<i16> destination, i64 capacity, rawmutptr<i64> writeIndex, i16 value) {
    if (destination == null || writeIndex == null) {
        return false;
    }

    stack i64 index = *writeIndex;
    if (index >= capacity) {
        return false;
    }

    *(&destination[index]) = value;
    *writeIndex = index + 1;
    return true;
}

internal fn bool TryCopyWideRange(
    rawmutptr<i16> destination,
    i64 capacity,
    rawmutptr<i64> writeIndex,
    rawptr<i16> source,
    i64 sourceLength)
{
    if (destination == null || writeIndex == null || source == null || sourceLength < 0) {
        return false;
    }

    stack mut i64 index = 0;
    while willexit (index < sourceLength) {
        if (!TryAppendWideCodeUnit(destination, capacity, writeIndex, *(&source[index]))) {
            return false;
        }

        index += 1;
    }

    return true;
}

internal fn bool HasLongPathPrefix(rawptr<i16> source, i64 sourceLength) {
    if (source == null || sourceLength < 4) {
        return false;
    }

    return UnsignedWide(*(&source[0])) == 92
        && UnsignedWide(*(&source[1])) == 92
        && UnsignedWide(*(&source[2])) == 63
        && UnsignedWide(*(&source[3])) == 92;
}

internal fn bool IsDriveAbsoluteWidePath(rawptr<i16> source, i64 sourceLength) {
    if (source == null || sourceLength < 3) {
        return false;
    }

    return IsWideDriveLetter(UnsignedWide(*(&source[0])))
        && UnsignedWide(*(&source[1])) == 58
        && IsWideDirectorySeparatorUnit(UnsignedWide(*(&source[2])));
}

internal fn bool IsUncWidePath(rawptr<i16> source, i64 sourceLength) {
    if (source == null || sourceLength < 2) {
        return false;
    }

    return IsWideDirectorySeparatorUnit(UnsignedWide(*(&source[0])))
        && IsWideDirectorySeparatorUnit(UnsignedWide(*(&source[1])));
}

internal fn bool TryDecodeUtf8CodePoint(
    rawptr<i8> data,
    i64 length,
    rawmutptr<i64> index,
    rawmutptr<i32> codePoint)
{
    if (data == null || index == null || codePoint == null) {
        return false;
    }

    stack i64 readIndex = *index;
    if (readIndex < 0 || readIndex >= length) {
        return false;
    }

    stack i32 first = UnsignedByte(*(&data[readIndex]));
    if (first <= 127) {
        *index = readIndex + 1;
        *codePoint = first;
        return true;
    }

    if (194 <= first && first <= 223) {
        if (readIndex + 1 >= length) {
            return false;
        }

        stack i8 secondRaw = *(&data[readIndex + 1]);
        if (!IsUtf8ContinuationByte(secondRaw)) {
            return false;
        }

        stack i32 second = UnsignedByte(secondRaw);
        *index = readIndex + 2;
        *codePoint = ((first & 31) << 6) | (second & 63);
        return true;
    }

    if (224 <= first && first <= 239) {
        if (readIndex + 2 >= length) {
            return false;
        }

        stack i8 secondRaw = *(&data[readIndex + 1]);
        stack i8 thirdRaw = *(&data[readIndex + 2]);
        if (!IsUtf8ContinuationByte(secondRaw) || !IsUtf8ContinuationByte(thirdRaw)) {
            return false;
        }

        stack i32 second = UnsignedByte(secondRaw);
        stack i32 third = UnsignedByte(thirdRaw);
        if (first == 224 && second < 160) {
            return false;
        }

        if (first == 237 && second >= 160) {
            return false;
        }

        *index = readIndex + 3;
        *codePoint = ((first & 15) << 12)
            | ((second & 63) << 6)
            | (third & 63);
        return true;
    }

    if (240 <= first && first <= 244) {
        if (readIndex + 3 >= length) {
            return false;
        }

        stack i8 secondRaw = *(&data[readIndex + 1]);
        stack i8 thirdRaw = *(&data[readIndex + 2]);
        stack i8 fourthRaw = *(&data[readIndex + 3]);
        if (!IsUtf8ContinuationByte(secondRaw)
            || !IsUtf8ContinuationByte(thirdRaw)
            || !IsUtf8ContinuationByte(fourthRaw)) {
            return false;
        }

        stack i32 second = UnsignedByte(secondRaw);
        stack i32 third = UnsignedByte(thirdRaw);
        stack i32 fourth = UnsignedByte(fourthRaw);
        if (first == 240 && second < 144) {
            return false;
        }

        if (first == 244 && second > 143) {
            return false;
        }

        *index = readIndex + 4;
        *codePoint = ((first & 7) << 18)
            | ((second & 63) << 12)
            | ((third & 63) << 6)
            | (fourth & 63);
        return true;
    }

    return false;
}

internal fn bool TryAppendWideCodePoint(
    rawmutptr<i16> destination,
    i64 capacity,
    rawmutptr<i64> writeIndex,
    i32 codePoint)
{
    stack i32 scalar = NormalizeUnicodeCodePoint(codePoint);
    if (scalar == 0) {
        return false;
    }

    if (scalar <= 65535) {
        return TryAppendWideCodeUnit(destination, capacity, writeIndex, (i16)scalar);
    }

    stack i32 adjusted = scalar - 65536;
    if (!TryAppendWideCodeUnit(destination, capacity, writeIndex, (i16)((adjusted >> 10) + 55296))) {
        return false;
    }

    return TryAppendWideCodeUnit(destination, capacity, writeIndex, (i16)((adjusted & 1023) + 56320));
}

internal fn bool TryDecodeUtf8PathToWide(
    rawmutptr<i16> destination,
    i64 capacity,
    ascii path,
    rawmutptr<i64> writtenLength)
{
    if (destination == null || writtenLength == null || capacity <= 0) {
        return false;
    }

    stack i64 length = System.Text.AsciiLength(path);
    stack ascii fullPath = path[0, length];
    stack rawptr<i8> data = System.Text.AsciiData(fullPath);
    if (length > 0 && data == null) {
        return false;
    }

    stack mut i64 readIndex = 0;
    stack mut i64 writeIndex = 0;

    while willexit (readIndex < length) {
        stack i32 codePoint = 0;
        if (!TryDecodeUtf8CodePoint(data, length, &readIndex, &codePoint)) {
            return false;
        }

        if (codePoint == 47) {
            codePoint = 92;
        }

        if (!TryAppendWideCodePoint(destination, capacity, &writeIndex, codePoint)) {
            return false;
        }
    }

    *writtenLength = writeIndex;
    return true;
}

internal fn bool TryBuildAbsoluteWindowsWidePath(
    rawmutptr<i16> destination,
    i64 capacity,
    rawptr<i16> source,
    i64 sourceLength,
    rawmutptr<i64> writtenLength)
{
    if (destination == null || writtenLength == null || source == null) {
        return false;
    }

    if (IsDriveAbsoluteWidePath(source, sourceLength)
        || IsUncWidePath(source, sourceLength)
        || HasLongPathPrefix(source, sourceLength)) {
        stack mut i64 directLength = 0;
        if (!TryCopyWideRange(destination, capacity, &directLength, source, sourceLength)) {
            return false;
        }

        *writtenLength = directLength;
        return true;
    }

    stack mut i16[4096] currentDirectory;
    stack i32 currentDirectoryLength = GetCurrentDirectoryW(4096, &currentDirectory[0]);
    if (currentDirectoryLength <= 0 || currentDirectoryLength >= 4096) {
        return false;
    }

    stack mut i64 writeIndex = 0;
    if (sourceLength > 0 && IsWideDirectorySeparatorUnit(UnsignedWide(*(&source[0])))) {
        if (HasLongPathPrefix(&currentDirectory[0], currentDirectoryLength)) {
            if (currentDirectoryLength < 6
                || !IsWideDriveLetter(UnsignedWide(*(&currentDirectory[4])))
                || UnsignedWide(*(&currentDirectory[5])) != 58) {
                return false;
            }

            if (!TryCopyWideRange(destination, capacity, &writeIndex, &currentDirectory[0], 6)) {
                return false;
            }
        }
        else {
            if (currentDirectoryLength < 2
                || !IsWideDriveLetter(UnsignedWide(*(&currentDirectory[0])))
                || UnsignedWide(*(&currentDirectory[1])) != 58) {
                return false;
            }

            if (!TryCopyWideRange(destination, capacity, &writeIndex, &currentDirectory[0], 2)) {
                return false;
            }
        }

        if (!TryCopyWideRange(destination, capacity, &writeIndex, source, sourceLength)) {
            return false;
        }

        *writtenLength = writeIndex;
        return true;
    }

    if (!TryCopyWideRange(destination, capacity, &writeIndex, &currentDirectory[0], currentDirectoryLength)) {
        return false;
    }

    if (writeIndex > 0 && !IsWideDirectorySeparatorUnit(UnsignedWide(*(&destination[writeIndex - 1])))) {
        if (!TryAppendWideCodeUnit(destination, capacity, &writeIndex, (i16)92)) {
            return false;
        }
    }

    if (!TryCopyWideRange(destination, capacity, &writeIndex, source, sourceLength)) {
        return false;
    }

    *writtenLength = writeIndex;
    return true;
}

internal fn bool TryBuildLongWindowsWidePath(rawmutptr<i16> destination, i64 capacity, rawptr<i16> source, i64 sourceLength) {
    if (destination == null || capacity <= 0 || source == null) {
        return false;
    }

    stack mut i16[4096] absolutePath;
    stack rawptr<i16> absoluteSource = source;
    stack i64 absoluteLength = sourceLength;

    if (!HasLongPathPrefix(source, sourceLength)
        && !IsDriveAbsoluteWidePath(source, sourceLength)
        && !IsUncWidePath(source, sourceLength)) {
        if (!TryBuildAbsoluteWindowsWidePath(&absolutePath[0], 4096, source, sourceLength, &absoluteLength)) {
            return false;
        }

        absoluteSource = &absolutePath[0];
    }

    stack mut i64 writeIndex = 0;
    if (HasLongPathPrefix(absoluteSource, absoluteLength)) {
        if (!TryCopyWideRange(destination, capacity - 1, &writeIndex, absoluteSource, absoluteLength)) {
            return false;
        }
    }
    else if (IsUncWidePath(absoluteSource, absoluteLength)) {
        if (!TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)92)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)92)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)63)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)92)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)85)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)78)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)67)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)92)) {
            return false;
        }

        if (!TryCopyWideRange(destination, capacity - 1, &writeIndex, &absoluteSource[2], absoluteLength - 2)) {
            return false;
        }
    }
    else if (IsDriveAbsoluteWidePath(absoluteSource, absoluteLength)) {
        if (!TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)92)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)92)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)63)
            || !TryAppendWideCodeUnit(destination, capacity - 1, &writeIndex, (i16)92)) {
            return false;
        }

        if (!TryCopyWideRange(destination, capacity - 1, &writeIndex, absoluteSource, absoluteLength)) {
            return false;
        }
    }
    else {
        return false;
    }

    *(&destination[writeIndex]) = 0;
    return true;
}

internal fn bool TryBuildWindowsWidePath(rawmutptr<i16> destination, i64 capacity, ascii path) {
    if (destination == null || capacity <= 0) {
        return false;
    }

    stack mut i16[4096] normalizedPath;
    stack mut i64 normalizedLength = 0;
    if (!TryDecodeUtf8PathToWide(&normalizedPath[0], 4096, path, &normalizedLength)) {
        return false;
    }

    if (normalizedLength >= WinLongPathThreshold
        && !HasLongPathPrefix(&normalizedPath[0], normalizedLength)) {
        return TryBuildLongWindowsWidePath(destination, capacity, &normalizedPath[0], normalizedLength);
    }

    if (normalizedLength + 1 > capacity) {
        return false;
    }

    stack mut i64 writeIndex = 0;
    if (!TryCopyWideRange(destination, capacity - 1, &writeIndex, &normalizedPath[0], normalizedLength)) {
        return false;
    }

    *(&destination[writeIndex]) = 0;
    return true;
}

internal fn void WriteUtf8CodePointToPointer(rawmutptr<i8> destination, rawmutptr<i64> writeIndex, i32 codePoint) {
    stack i32 scalar = NormalizeUnicodeCodePoint(codePoint);
    stack i64 index = *writeIndex;

    if (scalar <= 127) {
        *(&destination[index]) = (i8)scalar;
        *writeIndex = index + 1;
        return;
    }

    if (scalar <= 2047) {
        *(&destination[index]) = (i8)((scalar >> 6) | 192);
        *(&destination[index + 1]) = (i8)((scalar & 63) | 128);
        *writeIndex = index + 2;
        return;
    }

    if (scalar <= 65535) {
        *(&destination[index]) = (i8)((scalar >> 12) | 224);
        *(&destination[index + 1]) = (i8)(((scalar >> 6) & 63) | 128);
        *(&destination[index + 2]) = (i8)((scalar & 63) | 128);
        *writeIndex = index + 3;
        return;
    }

    *(&destination[index]) = (i8)((scalar >> 18) | 240);
    *(&destination[index + 1]) = (i8)(((scalar >> 12) & 63) | 128);
    *(&destination[index + 2]) = (i8)(((scalar >> 6) & 63) | 128);
    *(&destination[index + 3]) = (i8)((scalar & 63) | 128);
    *writeIndex = index + 4;
}

internal fn bool TryCopyWideUtf8(rawmutptr<Ascii> destination, rawptr<i16> source, i32 length) {
    if (destination == null || source == null || length < 0) {
        ResetAsciiDestination(destination);
        return false;
    }

    stack rawmutptr<i8> data = (*destination).Data;
    stack i64 capacity = (*destination).Capacity;
    stack i64 required = (i64)length;
    if (required > capacity) {
        ResetAsciiDestination(destination);
        return false;
    }

    if (required > 0 && data == null) {
        ResetAsciiDestination(destination);
        return false;
    }

    stack mut i64 readIndex = 0;
    stack mut i64 writeIndex = 0;
    while willexit (readIndex < required) {
        stack i32 first = UnsignedWide(*(&source[readIndex]));
        stack i32 codePoint = first;
        readIndex += 1;

        if (55296 <= first && first <= 56319) {
            if (readIndex < required) {
                stack i32 second = UnsignedWide(*(&source[readIndex]));
                if (56320 <= second && second <= 57343) {
                    readIndex += 1;
                    codePoint = (((first - 55296) << 10) | (second - 56320)) + 65536;
                }
                else {
                    codePoint = 65533;
                }
            }
            else {
                codePoint = 65533;
            }
        }
        else if (56320 <= first && first <= 57343) {
            codePoint = 65533;
        }

        stack i64 encodedLength = Utf8EncodedLength(codePoint);
        if (writeIndex + encodedLength > capacity) {
            ResetAsciiDestination(destination);
            return false;
        }

        WriteUtf8CodePointToPointer(data, &writeIndex, codePoint);
    }

    *destination = new Ascii() {
        Data = data,
        Length = writeIndex,
        Capacity = capacity
    };
    return true;
}

internal fn i32 WriteBufferToHandle(rawptr<i8> handle, rawptr<i8> buffer, i64 length) {
    if (handle == null) {
        return -1;
    }

    if (length <= 0) {
        return 0;
    }

    if (buffer == null) {
        return -1;
    }

    stack i64 remaining = length;
    stack i64 written = 0;

    while willexit (remaining > 0) {
        stack i32 request = RequestedChunkLength(remaining);
        stack i32 chunkWritten = 0;
        stack rawptr<i8> chunk = &buffer[written];
        stack i32 result = WriteFile(handle, chunk, request, &chunkWritten, null);
        if (result == 0) {
            return NegativeLastError();
        }

        if (chunkWritten <= 0) {
            return -1;
        }

        written += chunkWritten;
        remaining -= chunkWritten;
    }

    return 0;
}

internal fn i32 NormalizeUnicodeCodePoint(i32 codePoint) {
    if (codePoint < 0) {
        return 65533;
    }

    if (55296 <= codePoint && codePoint <= 57343) {
        return 65533;
    }

    if (codePoint > 1114111) {
        return 65533;
    }

    return codePoint;
}

internal fn i64 Utf8EncodedLength(i32 codePoint) {
    stack i32 scalar = NormalizeUnicodeCodePoint(codePoint);

    if (scalar <= 127) {
        return 1;
    }

    if (scalar <= 2047) {
        return 2;
    }

    if (scalar <= 65535) {
        return 3;
    }

    return 4;
}

internal fn void AppendUtf8CodePoint(rawmutptr<System.Runtime.Buffer.ByteBuffer4096> buffer, i32 codePoint) {
    stack i32 scalar = NormalizeUnicodeCodePoint(codePoint);
    stack i64 writePos = *(&(*buffer).WritePos);

    if (scalar <= 127) {
        *(&(*buffer).Storage[writePos]) = (i8)scalar;
        *(&(*buffer).WritePos) = writePos + 1;
        return;
    }

    if (scalar <= 2047) {
        *(&(*buffer).Storage[writePos]) = (i8)((scalar >> 6) | 192);
        *(&(*buffer).Storage[writePos + 1]) = (i8)((scalar & 63) | 128);
        *(&(*buffer).WritePos) = writePos + 2;
        return;
    }

    if (scalar <= 65535) {
        *(&(*buffer).Storage[writePos]) = (i8)((scalar >> 12) | 224);
        *(&(*buffer).Storage[writePos + 1]) = (i8)(((scalar >> 6) & 63) | 128);
        *(&(*buffer).Storage[writePos + 2]) = (i8)((scalar & 63) | 128);
        *(&(*buffer).WritePos) = writePos + 3;
        return;
    }

    *(&(*buffer).Storage[writePos]) = (i8)((scalar >> 18) | 240);
    *(&(*buffer).Storage[writePos + 1]) = (i8)(((scalar >> 12) & 63) | 128);
    *(&(*buffer).Storage[writePos + 2]) = (i8)(((scalar >> 6) & 63) | 128);
    *(&(*buffer).Storage[writePos + 3]) = (i8)((scalar & 63) | 128);
    *(&(*buffer).WritePos) = writePos + 4;
}

internal fn i32 FlushEncodedWriteBuffer(rawptr<i8> handle, rawmutptr<System.Runtime.Buffer.ByteBuffer4096> buffer) {
    stack i64 length = *(&(*buffer).WritePos);
    if (length <= 0) {
        return 0;
    }

    stack i32 status = WriteBufferToHandle(handle, &(*buffer).Storage[0], length);
    if (status == 0) {
        *(&(*buffer).ReadPos) = 0;
        *(&(*buffer).WritePos) = 0;
    }

    return status;
}

internal fn i32 WriteAsciiToHandle(rawptr<i8> handle, ascii text) {
    stack i64 length = System.Text.AsciiLength(text);
    stack ascii view = text[0, length];
    return WriteBufferToHandle(handle, System.Text.AsciiData(view), length);
}

internal fn i32 WriteUnicodeToHandle(rawptr<i8> handle, unicode text) {
    if (handle == null) {
        return -1;
    }

    stack i64 length = System.Text.UnicodeLength(text);
    if (length <= 0) {
        return 0;
    }

    stack mut System.Runtime.Buffer.ByteBuffer4096 utf8Buffer = new System.Runtime.Buffer.ByteBuffer4096();
    stack mut i64 index = 0;

    while willexit (index < length) {
        stack unicode unit = text[index, 1];
        stack rawptr<i32> data = System.Text.UnicodeData(unit);
        stack i32 codePoint = *data;
        stack i64 required = Utf8EncodedLength(codePoint);

        if (utf8Buffer.Writable() < required) {
            stack i32 flushStatus = FlushEncodedWriteBuffer(handle, &utf8Buffer);
            if (flushStatus != 0) {
                return flushStatus;
            }
        }

        AppendUtf8CodePoint(&utf8Buffer, codePoint);
        index += 1;
    }

    return FlushEncodedWriteBuffer(handle, &utf8Buffer);
}

internal fn rawptr<i8> OpenFileWithDisposition(ascii path, i32 desiredAccess, i32 creationDisposition) {
    stack mut i16[4096] pathBuffer;
    if (!TryBuildWindowsWidePath(&pathBuffer[0], 4096, path)) {
        return null;
    }

    stack rawmutptr<i8> handle = CreateFileW(
        &pathBuffer[0],
        desiredAccess,
        WinFileShareRead | WinFileShareWrite,
        null,
        creationDisposition,
        WinFileAttributeNormal,
        null);

    if (IsInvalidHandle(handle)) {
        return null;
    }

    return (rawptr<i8>)handle;
}

internal fn i32 WriteStdoutAscii(ascii text) {
    stack rawmutptr<i8> handle = GetStdHandle(WinStdOutputHandle);
    if (IsInvalidHandle(handle)) {
        return -1;
    }

    return WriteAsciiToHandle((rawptr<i8>)handle, text);
}

internal fn i32 WriteStdoutUnicode(unicode text) {
    stack rawmutptr<i8> handle = GetStdHandle(WinStdOutputHandle);
    if (IsInvalidHandle(handle)) {
        return -1;
    }

    return WriteUnicodeToHandle((rawptr<i8>)handle, text);
}

internal fn i32 WriteStderrAscii(ascii text) {
    stack rawmutptr<i8> handle = GetStdHandle(WinStdErrorHandle);
    if (IsInvalidHandle(handle)) {
        return -1;
    }

    return WriteAsciiToHandle((rawptr<i8>)handle, text);
}

internal fn i32 WriteStderrUnicode(unicode text) {
    stack rawmutptr<i8> handle = GetStdHandle(WinStdErrorHandle);
    if (IsInvalidHandle(handle)) {
        return -1;
    }

    return WriteUnicodeToHandle((rawptr<i8>)handle, text);
}

internal fn i32 WriteAscii(rawptr<i8> handle, ascii text) {
    return WriteAsciiToHandle(handle, text);
}

internal finite law ascii DirectorySeparator() {
    return "\\";
}

internal finite law ascii AlternateDirectorySeparator() {
    return "/";
}

internal finite law ascii PathSeparator() {
    return ";";
}

internal finite law bool IsDirectorySeparator(ascii value) {
    stack i8 unit = *System.Text.AsciiData(value);
    return unit == (i8)47 || unit == (i8)92;
}

internal fn bool IsTerminal(rawptr<i8> handle) {
    if (handle == null) {
        return false;
    }

    stack mut i32 mode = 0;
    return GetConsoleMode(handle, &mode) != 0;
}

internal fn i32 WriteUnicode(rawptr<i8> handle, unicode text) {
    return WriteUnicodeToHandle(handle, text);
}

internal fn rawptr<i8> OpenFileRead(ascii path) {
    return OpenFileWithDisposition(path, WinGenericRead, WinOpenExisting);
}

internal fn rawptr<i8> OpenFileWrite(ascii path) {
    return OpenFileWithDisposition(path, WinGenericWrite, WinCreateAlways);
}

internal fn rawptr<i8> OpenFileAppend(ascii path) {
    return OpenFileWithDisposition(path, WinFileAppendData, WinOpenAlways);
}

internal fn rawptr<i8> OpenFileReadWrite(ascii path) {
    return OpenFileWithDisposition(path, WinGenericRead | WinGenericWrite, WinOpenExisting);
}

internal fn i32 CloseFile(rawptr<i8> handle) {
    if (handle == null) {
        return 0;
    }

    if (CloseHandle(handle) == 0) {
        return NegativeLastError();
    }

    return 0;
}

internal fn i32 FlushFile(rawptr<i8> handle) {
    if (handle == null) {
        return 0;
    }

    if (FlushFileBuffers(handle) == 0) {
        return NegativeLastError();
    }

    return 0;
}

internal fn i64 ReadFile(rawptr<i8> buffer, i64 size, i64 count, rawptr<i8> handle) {
    if (handle == null || buffer == null || size <= 0 || count <= 0) {
        return 0;
    }

    stack i64 bytesRequested = size * count;
    stack i32 request = RequestedChunkLength(bytesRequested);
    stack mut i32 bytesRead = 0;
    if (ReadFile(handle, buffer, request, &bytesRead, null) == 0) {
        return 0;
    }

    if (bytesRead <= 0) {
        return 0;
    }

    return ((i64)bytesRead) / size;
}

internal fn i64 WriteFile(rawptr<i8> buffer, i64 size, i64 count, rawptr<i8> handle) {
    if (handle == null || buffer == null || size <= 0 || count <= 0) {
        return 0;
    }

    stack i64 bytesRequested = size * count;
    stack i32 request = RequestedChunkLength(bytesRequested);
    stack mut i32 bytesWritten = 0;
    if (WriteFile(handle, buffer, request, &bytesWritten, null) == 0) {
        return 0;
    }

    if (bytesWritten <= 0) {
        return 0;
    }

    return ((i64)bytesWritten) / size;
}

internal fn i32 DeleteFile(ascii path) {
    stack mut i16[4096] pathBuffer;
    if (!TryBuildWindowsWidePath(&pathBuffer[0], 4096, path)) {
        return -1;
    }

    if (DeleteFileW(&pathBuffer[0]) == 0) {
        return NegativeLastError();
    }

    return 0;
}

internal fn i32 MoveFile(ascii oldPath, ascii newPath) {
    stack mut i16[4096] oldPathBuffer;
    stack mut i16[4096] newPathBuffer;
    if (!TryBuildWindowsWidePath(&oldPathBuffer[0], 4096, oldPath)
        || !TryBuildWindowsWidePath(&newPathBuffer[0], 4096, newPath)) {
        return -1;
    }

    if (MoveFileExW(&oldPathBuffer[0], &newPathBuffer[0], WinMoveFileReplaceExisting) == 0) {
        return NegativeLastError();
    }

    return 0;
}

internal fn bool FileExists(ascii path) {
    stack mut i16[4096] pathBuffer;
    if (!TryBuildWindowsWidePath(&pathBuffer[0], 4096, path)) {
        return false;
    }

    return GetFileAttributesW(&pathBuffer[0]) != WinInvalidFileAttributes;
}

internal fn bool TryCurrentDirectory(rawmutptr<Ascii> destination) {
    if (destination == null) {
        return false;
    }

    stack rawmutptr<i8> data = (*destination).Data;
    stack i64 capacity = (*destination).Capacity;
    if (data == null || capacity <= 0) {
        ResetAsciiDestination(destination);
        return false;
    }

    stack mut i16[4096] pathBuffer;
    stack i32 written = GetCurrentDirectoryW(4096, &pathBuffer[0]);
    if (written <= 0 || written >= 4096) {
        ResetAsciiDestination(destination);
        return false;
    }

    return TryCopyWideUtf8(destination, &pathBuffer[0], written);
}
