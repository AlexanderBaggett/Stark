        stack u64[0 2 ** 63 - 1] readable = self.Readable();
        if (count >= readable)
        {
            self.Clear();
            return;
        }

        self.ReadPosition += count;
    }

    fn void AdvanceWrite(mut borrow FixedByteBuffer8192 self, u64[0 2 ** 63 - 1] count)
    {
        stack u64[0 2 ** 63 - 1] writable = self.Writable();
        if (count >= writable)
        {
            self.WritePosition = Capacity8192();
            return;
        }

        self.WritePosition += count;
    }

    fn void Compact(mut borrow FixedByteBuffer8192 self)
    {
        unsafe
        {
            stack mut u64[0 2 ** 63 - 1] nextReadPosition = self.ReadPosition;
            stack mut u64[0 2 ** 63 - 1] nextWritePosition = self.WritePosition;
            stack rawmutptr<i8[min max]> data = &self.Storage[0];
            unsafe
            {
                stack mut i8[min max][] fixedStorage = slice(data, Capacity8192());
                CompactStorage(fixedStorage, self.ReadPosition, self.WritePosition, nextReadPosition, nextWritePosition);
            }
            self.ReadPosition = nextReadPosition;
            self.WritePosition = nextWritePosition;
        }
    }

    fn void Clear(mut borrow FixedByteBuffer8192 self)
    {
        self.ReadPosition = 0;
        self.WritePosition = 0;
    }
}

public struct DynamicByteBuffer
{
    internal dynamic i8[min max] Storage;
    internal u64[0 2 ** 63 - 1] ReadPosition;

    DynamicByteBuffer()
    {
        self.Storage = new();
        self.ReadPosition = 0;
    }

    inline finite law u64[0 2 ** 63 - 1] Length(borrow DynamicByteBuffer self)
    {
        return self.Storage.Length;
    }

    inline finite law u64[0 2 ** 63 - 1] Capacity(borrow DynamicByteBuffer self)
    {
        return self.Storage.Capacity;
    }

    inline finite law u64[0 2 ** 63 - 1] Readable(borrow DynamicByteBuffer self)
    {
        return CursorReadable(self.ReadPosition, self.Storage.Length);
    }

    inline finite law u64[0 2 ** 63 - 1] Writable(borrow DynamicByteBuffer self)
    {
        return (u64[0 2 ** 63 - 1])(MaxDynamicByteLength() - self.Storage.Length);
    }

    inline finite law bool IsEmpty(borrow DynamicByteBuffer self)
    {
        return self.Readable() == 0;
    }

    finite law retborrow i8[min max][] ReadSlice(borrow DynamicByteBuffer self)
    {
        return self.Storage[self.ReadPosition, self.Readable()];
    }

    finite retborrow mut i8[min max][] ReadMutableSlice(mut borrow DynamicByteBuffer self)
    {
        return self.Storage[self.ReadPosition, self.Readable()];
    }

    fn System.Memory.MemoryStatus Reserve(mut borrow DynamicByteBuffer self, u64[0 2 ** 63 - 1] additional)
    {
        if (additional > self.Writable())
        {
            return TooLargeStatus();
        }

        if (!self.Storage.TryReserve(additional))
        {
            return OutOfMemoryStatus();
        }

        return System.Memory.MemoryStatus.Ok;
    }

    fn System.Memory.MemoryStatus WriteByte(mut borrow DynamicByteBuffer self, i8[min max] value)
    {
        stack System.Memory.MemoryStatus status = self.Reserve(1);
        switch (status)
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
                init self.Storage[self.Storage.Length] = value;
        }

        return System.Memory.MemoryStatus.Ok;
    }

    fn System.Memory.MemoryStatus WriteSlice(
        mut borrow DynamicByteBuffer self,
        borrow i8[min max][] source,
        u64[0 2 ** 63 - 1] count)
        where overlap(self, source)
    {
            unsafe
            {
            if (count == 0)
            {
                return System.Memory.MemoryStatus.Ok;
            }

            stack i8[min max][] initialized = self.Storage[0, self.Storage.Length];
            if disjoint(source, initialized)
            {
                if (count > self.Writable())
                {
                    return TooLargeStatus();
                }

                if (!self.Storage.TryReserve(count))
                {
                    return OutOfMemoryStatus();
                }

                stack init i8[min max][] tail = init self.Storage[self.Storage.Length, count];
                unsafe
                {
                    return System.Memory.InitializeBytesDisjoint(source, tail, count);
                }
            }

            stack mut dynamic i8[min max] snapshot = new();
            if (!snapshot.TryReserve(count))
            {
                return OutOfMemoryStatus();
            }

            stack init i8[min max][] snapshotTail = init snapshot[snapshot.Length, count];
            unsafe
            {
                System.Memory.InitializeBytesDisjoint(source, snapshotTail, count);
            }

            stack i8[min max][] snapshotView = snapshot[0, snapshot.Length];
            if (count > self.Writable())
            {
                return TooLargeStatus();
            }

            if (!self.Storage.TryReserve(count))
            {
                return OutOfMemoryStatus();
            }

            stack init i8[min max][] tail = init self.Storage[self.Storage.Length, count];
            unsafe
            {
                return System.Memory.InitializeBytesDisjoint(snapshotView, tail, count);
            }
            }
    }

    fn System.Memory.MemoryStatus WriteFill(
        mut borrow DynamicByteBuffer self,
        i8[min max] value,
        u64[0 2 ** 63 - 1] count)
    {
        if (count == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (count > self.Writable())
        {
            return TooLargeStatus();
        }

        if (!self.Storage.TryReserve(count))
        {
            return OutOfMemoryStatus();
        }

        stack init i8[min max][] tail = init self.Storage[self.Storage.Length, count];
        return System.Memory.FillBytes(tail, value, count);
    }

    fn bool TryReadByte(mut borrow DynamicByteBuffer self, out i8[min max] value)
    {
        if (self.IsEmpty())
        {
            value = 0;
            return false;
        }

        value = self.Storage[0, self.Storage.Length][self.ReadPosition];
        self.AdvanceRead(1);
        return true;
    }

    fn void AdvanceRead(mut borrow DynamicByteBuffer self, u64[0 2 ** 63 - 1] count)
    {
        stack u64[0 2 ** 63 - 1] readable = self.Readable();
        if (count >= readable)
        {
            self.Clear();
            return;
        }

        self.ReadPosition += count;
    }

    fn void Compact(mut borrow DynamicByteBuffer self)
    {
        stack u64[0 2 ** 63 - 1] readable = self.Readable();
        if (self.ReadPosition == 0)
        {
            return;
        }

        if (readable == 0)
        {
            self.Clear();
            return;
        }

        stack mut u64[0 2 ** 63 - 1] nextReadPosition = self.ReadPosition;
        stack mut u64[0 2 ** 63 - 1] nextWritePosition = self.Storage.Length;
        CompactStorage(
            self.Storage[0, self.Storage.Length],
            self.ReadPosition,
            self.Storage.Length,
            nextReadPosition,
            nextWritePosition);

        while willexit (self.Storage.Length > readable)
        {
            stack i8[min max] discarded = self.Storage.MoveLast();
        }

        self.ReadPosition = nextReadPosition;
    }

    fn void Clear(mut borrow DynamicByteBuffer self)
    {
        while willexit (self.Storage.Length > 0)
        {
            stack i8[min max] discarded = self.Storage.MoveLast();
        }

        self.ReadPosition = 0;
    }
}
