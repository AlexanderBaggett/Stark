import System.Memory
module System.Runtime.Buffer

internal inline finite law u64[0 2 ** 63 - 1] MaxDynamicByteLength()
{
    return (u64[0 2 ** 63 - 1])(2 ** 63 - 1);
}

internal inline finite law u64[0 2 ** 63 - 1] ZeroIndex()
{
    return 0;
}

internal inline finite law u64[0 2 ** 63 - 1] Capacity512()
{
    return 512;
}

internal inline finite law u64[0 2 ** 63 - 1] Capacity4096()
{
    return 4096;
}

internal inline finite law u64[0 2 ** 63 - 1] Capacity8192()
{
    return 8192;
}

internal inline finite law System.Memory.MemoryStatus TooLargeStatus()
{
    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.TooLarge);
}

internal inline finite law System.Memory.MemoryStatus OutOfMemoryStatus()
{
    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
}

internal inline finite law u64[0 2 ** 63 - 1] CursorReadable(u64[0 2 ** 63 - 1] readPosition, u64[0 2 ** 63 - 1] writePosition)
{
    if (writePosition <= readPosition)
    {
        return 0;
    }

    return (u64[0 2 ** 63 - 1])(writePosition - readPosition);
}

internal inline finite law u64[0 2 ** 63 - 1] CursorWritable(u64[0 2 ** 63 - 1] writePosition, u64[0 2 ** 63 - 1] capacity)
{
    if (writePosition >= capacity)
    {
        return 0;
    }

    return (u64[0 2 ** 63 - 1])(capacity - writePosition);
}

internal fn System.Memory.MemoryStatus WriteByteToStorage(
    borrow mut i8[min max][] storage,
    u64[0 2 ** 63 - 1] writePosition,
    u64[0 2 ** 63 - 1] capacity,
    i8[min max] value,
    out u64[0 2 ** 63 - 1] nextWritePosition)
{
    nextWritePosition = writePosition;
    if (writePosition >= capacity)
    {
        return TooLargeStatus();
    }

    storage[writePosition] = value;
    nextWritePosition = (u64[0 2 ** 63 - 1])(writePosition + 1);
    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus WriteSliceToStorage(
    borrow mut i8[min max][] storage,
    u64[0 2 ** 63 - 1] writePosition,
    u64[0 2 ** 63 - 1] capacity,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] count,
    out u64[0 2 ** 63 - 1] nextWritePosition)
    where overlap(storage, source)
{
        unsafe
        {
        nextWritePosition = writePosition;
        if (count == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (count > CursorWritable(writePosition, capacity))
        {
            return TooLargeStatus();
        }

        stack rawmutptr<i8[min max]> destinationData = &storage[writePosition];
        unsafe
        {
            stack mut i8[min max][] destination = slice(destinationData, count);
            if disjoint(source, destination)
            {
                System.Memory.CopyBytesDisjointInfallible(source, destination, count);
            }
            else
            {
                System.Memory.MoveBytesInfallible(source, destination, count);
            }
        }

        nextWritePosition = (u64[0 2 ** 63 - 1])(writePosition + count);
        return System.Memory.MemoryStatus.Ok;
        }
}

internal fn System.Memory.MemoryStatus WriteFillToStorage(
    borrow mut i8[min max][] storage,
    u64[0 2 ** 63 - 1] writePosition,
    u64[0 2 ** 63 - 1] capacity,
    i8[min max] value,
    u64[0 2 ** 63 - 1] count,
    out u64[0 2 ** 63 - 1] nextWritePosition)
{
        unsafe
        {
        nextWritePosition = writePosition;
        if (count == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (count > CursorWritable(writePosition, capacity))
        {
            return TooLargeStatus();
        }

        stack rawmutptr<i8[min max]> destinationData = &storage[writePosition];
        unsafe
        {
            stack mut i8[min max][] destination = slice(destinationData, count);
            System.Memory.FillInitializedBytesInfallible(destination, value, count);
        }
        nextWritePosition = (u64[0 2 ** 63 - 1])(writePosition + count);
        return System.Memory.MemoryStatus.Ok;
        }
}

internal fn void CompactStorage(
    borrow mut i8[min max][] storage,
    u64[0 2 ** 63 - 1] readPosition,
    u64[0 2 ** 63 - 1] writePosition,
    out u64[0 2 ** 63 - 1] nextReadPosition,
    out u64[0 2 ** 63 - 1] nextWritePosition)
    where overlap(storage, nextReadPosition),
          overlap(storage, nextWritePosition)
{
        unsafe
        {
        nextReadPosition = readPosition;
        nextWritePosition = writePosition;
        stack u64[0 2 ** 63 - 1] readable = CursorReadable(readPosition, writePosition);
        if (readPosition == 0)
        {
            return;
        }

        if (readable == 0)
        {
            nextReadPosition = 0;
            nextWritePosition = 0;
            return;
        }

        stack rawptr<i8[min max]> sourceData = &storage[readPosition];
        stack rawmutptr<i8[min max]> destinationData = &storage[0];
        unsafe
        {
            stack i8[min max][] source = slice(sourceData, readable);
            stack mut i8[min max][] destination = slice(destinationData, readable);
            System.Memory.MoveBytesInfallible(source, destination, readable);
        }
        nextReadPosition = 0;
        nextWritePosition = readable;
        }
}

public struct FixedByteBuffer512
{
    internal i8[min max][512] Storage;
    internal u64[0 2 ** 63 - 1] ReadPosition;
    internal u64[0 2 ** 63 - 1] WritePosition;

    FixedByteBuffer512()
    {
        self.ReadPosition = 0;
        self.WritePosition = 0;
    }

    inline finite law u64[0 2 ** 63 - 1] Capacity(borrow FixedByteBuffer512 self)
    {
        return Capacity512();
    }

    inline finite law bool IsEmpty(borrow FixedByteBuffer512 self)
    {
        return self.ReadPosition == self.WritePosition;
    }

    inline finite law bool IsFull(borrow FixedByteBuffer512 self)
    {
        return self.WritePosition >= 512;
    }

    inline finite law u64[0 2 ** 63 - 1] Readable(borrow FixedByteBuffer512 self)
    {
        return CursorReadable(self.ReadPosition, self.WritePosition);
    }

    inline finite law u64[0 2 ** 63 - 1] Writable(borrow FixedByteBuffer512 self)
    {
        return CursorWritable(self.WritePosition, 512);
    }

    internal unsafe inline fn rawptr<i8[min max]> ReadPointer(borrow FixedByteBuffer512 self)
    {
        if (self.Readable() == 0)
        {
            return null;
        }

        return &self.Storage[self.ReadPosition];
    }

    internal unsafe inline fn rawmutptr<i8[min max]> ReadWritePointer(mut borrow FixedByteBuffer512 self)
    {
        if (self.Readable() == 0)
        {
            return null;
        }

        return &self.Storage[self.ReadPosition];
    }

    internal unsafe inline fn rawmutptr<i8[min max]> WritePointer(mut borrow FixedByteBuffer512 self)
    {
        if (self.Writable() == 0)
        {
            return null;
        }

        return &self.Storage[self.WritePosition];
    }

    finite law retborrow i8[min max][] ReadSlice(borrow FixedByteBuffer512 self)
    {
        unsafe
        {
            stack u64[0 2 ** 63 - 1] readable = self.Readable();
            if (readable == 0)
            {
                unsafe
                {
                    return slice(&self.Storage[0], 0);
                }
            }

            unsafe
            {
                return slice(&self.Storage[self.ReadPosition], readable);
            }
        }
    }

    finite retborrow mut i8[min max][] ReadMutableSlice(mut borrow FixedByteBuffer512 self)
    {
        unsafe
        {
            stack u64[0 2 ** 63 - 1] readable = self.Readable();
            if (readable == 0)
            {
                unsafe
                {
                    return slice(&self.Storage[0], 0);
                }
            }

            unsafe
            {
                return slice(&self.Storage[self.ReadPosition], readable);
            }
        }
    }

    finite retborrow mut i8[min max][] WriteSlice(mut borrow FixedByteBuffer512 self)
    {
        unsafe
        {
            stack u64[0 2 ** 63 - 1] writable = self.Writable();
            if (writable == 0)
            {
                unsafe
                {
                    return slice(&self.Storage[0], 0);
                }
            }

            unsafe
            {
                return slice(&self.Storage[self.WritePosition], writable);
            }
        }
    }

    fn System.Memory.MemoryStatus WriteByte(mut borrow FixedByteBuffer512 self, i8[min max] value)
    {
        unsafe
        {
            stack mut u64[0 2 ** 63 - 1] nextWritePosition = self.WritePosition;
            stack mut System.Memory.MemoryStatus status = System.Memory.MemoryStatus.Ok;
            stack rawmutptr<i8[min max]> data = &self.Storage[0];
            unsafe
            {
                stack mut i8[min max][] fixedStorage = slice(data, Capacity512());
                status = WriteByteToStorage(fixedStorage, self.WritePosition, Capacity512(), value, nextWritePosition);
            }
            switch (status)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
                    self.WritePosition = nextWritePosition;
            }

            return System.Memory.MemoryStatus.Ok;
        }
    }

    fn System.Memory.MemoryStatus WriteSlice(
        mut borrow FixedByteBuffer512 self,
        borrow i8[min max][] source,
        u64[0 2 ** 63 - 1] count)
        where overlap(self, source)
    {
            unsafe
            {
            stack mut u64[0 2 ** 63 - 1] nextWritePosition = self.WritePosition;
            stack mut System.Memory.MemoryStatus status = System.Memory.MemoryStatus.Ok;
            stack rawmutptr<i8[min max]> data = &self.Storage[0];
            unsafe
            {
                stack mut i8[min max][] fixedStorage = slice(data, Capacity512());
                status = WriteSliceToStorage(fixedStorage, self.WritePosition, Capacity512(), source, count, nextWritePosition);
            }
            switch (status)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
                    self.WritePosition = nextWritePosition;
            }

            return System.Memory.MemoryStatus.Ok;
            }
    }

    fn System.Memory.MemoryStatus WriteFill(
        mut borrow FixedByteBuffer512 self,
        i8[min max] value,
        u64[0 2 ** 63 - 1] count)
    {
            unsafe
            {
            stack mut u64[0 2 ** 63 - 1] nextWritePosition = self.WritePosition;
            stack mut System.Memory.MemoryStatus status = System.Memory.MemoryStatus.Ok;
            stack rawmutptr<i8[min max]> data = &self.Storage[0];
            unsafe
            {
                stack mut i8[min max][] fixedStorage = slice(data, Capacity512());
                status = WriteFillToStorage(fixedStorage, self.WritePosition, Capacity512(), value, count, nextWritePosition);
            }
            switch (status)
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
                    self.WritePosition = nextWritePosition;
            }

            return System.Memory.MemoryStatus.Ok;
            }
    }

    fn void AdvanceRead(mut borrow FixedByteBuffer512 self, u64[0 2 ** 63 - 1] count)
    {
        stack u64[0 2 ** 63 - 1] readable = self.Readable();
        if (count >= readable)
        {
            self.Clear();
            return;
        }

        self.ReadPosition += count;
    }

    fn void AdvanceWrite(mut borrow FixedByteBuffer512 self, u64[0 2 ** 63 - 1] count)
    {
        stack u64[0 2 ** 63 - 1] writable = self.Writable();
        if (count >= writable)
        {
            self.WritePosition = Capacity512();
            return;
        }

        self.WritePosition += count;
    }

    fn void Compact(mut borrow FixedByteBuffer512 self)
    {
        unsafe
        {
            stack mut u64[0 2 ** 63 - 1] nextReadPosition = self.ReadPosition;
            stack mut u64[0 2 ** 63 - 1] nextWritePosition = self.WritePosition;
            stack rawmutptr<i8[min max]> data = &self.Storage[0];
            unsafe
            {
                stack mut i8[min max][] fixedStorage = slice(data, Capacity512());
                CompactStorage(fixedStorage, self.ReadPosition, self.WritePosition, nextReadPosition, nextWritePosition);
            }
            self.ReadPosition = nextReadPosition;
            self.WritePosition = nextWritePosition;
        }
    }

    fn void Clear(mut borrow FixedByteBuffer512 self)
    {
        self.ReadPosition = 0;
        self.WritePosition = 0;
    }
}

