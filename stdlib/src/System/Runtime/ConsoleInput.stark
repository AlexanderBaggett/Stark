import System.IO.File
module System.Runtime.ConsoleInput

const i64 ConsoleInputUnicodeCapacity = 8192;
const i64 ConsoleInputByteCapacity = 8192;

internal struct ConsoleByteStorage {
    i8[8192] Storage;
}

internal struct ConsoleCodePointByteStorage {
    i8[4] Storage;
}

internal struct ConsoleSingleByteStorage {
    i8[1] Storage;
}

internal struct UnicodeConsoleLineStorage {
    i32[8192] Storage;
}

internal struct UnicodeConsoleUnitStorage {
    i32[1] Storage;
}

static mut UnicodeConsoleLineStorage ConsoleReadLineStorage = new UnicodeConsoleLineStorage();
static mut UnicodeConsoleUnitStorage ConsoleReadUnitStorage = new UnicodeConsoleUnitStorage();

fn i32 UnsignedByte(i8 value) {
    if (value < 0) {
        return ((i32)value) + 256;
    }

    return (i32)value;
}

fn bool IsUtf8ContinuationByte(i8 value) {
    stack i32 unit = UnsignedByte(value);
    return 128 <= unit && unit <= 191;
}

fn i32 NormalizeUnicodeCodePoint(i32 codePoint) {
    if (codePoint < 0) {
        return 65533;
    }

    if (55296 <= codePoint && codePoint <= 57343) {
        return 65533;
    }

    if (codePoint > 1114111) {
        return 65533;
    }

    return codePoint;
}

fn bool TryDecodeUtf8CodePoint(rawptr<i8> data, i64 length, rawmutptr<i64> index, rawmutptr<i32> codePoint) {
    if (data == null || index == null || codePoint == null) {
        return false;
    }

    stack i64 readIndex = *index;
    if (readIndex < 0 || readIndex >= length) {
        return false;
    }

    stack i32 first = UnsignedByte(*(&data[readIndex]));
    if (first <= 127) {
        *index = readIndex + 1;
        *codePoint = first;
        return true;
    }

    if (194 <= first && first <= 223) {
        if (readIndex + 1 >= length) {
            return false;
        }

        stack i8 secondRaw = *(&data[readIndex + 1]);
        if (!IsUtf8ContinuationByte(secondRaw)) {
            return false;
        }

        stack i32 second = UnsignedByte(secondRaw);
        *index = readIndex + 2;
        *codePoint = ((first & 31) << 6) | (second & 63);
        return true;
    }

    if (224 <= first && first <= 239) {
        if (readIndex + 2 >= length) {
            return false;
        }

        stack i8 secondRaw = *(&data[readIndex + 1]);
        stack i8 thirdRaw = *(&data[readIndex + 2]);
        if (!IsUtf8ContinuationByte(secondRaw) || !IsUtf8ContinuationByte(thirdRaw)) {
            return false;
        }

        stack i32 second = UnsignedByte(secondRaw);
        stack i32 third = UnsignedByte(thirdRaw);
        if (first == 224 && second < 160) {
            return false;
        }

        if (first == 237 && second >= 160) {
            return false;
        }

        *index = readIndex + 3;
        *codePoint = ((first & 15) << 12)
            | ((second & 63) << 6)
            | (third & 63);
        return true;
    }

    if (240 <= first && first <= 244) {
        if (readIndex + 3 >= length) {
            return false;
        }

        stack i8 secondRaw = *(&data[readIndex + 1]);
        stack i8 thirdRaw = *(&data[readIndex + 2]);
        stack i8 fourthRaw = *(&data[readIndex + 3]);
        if (!IsUtf8ContinuationByte(secondRaw)
            || !IsUtf8ContinuationByte(thirdRaw)
            || !IsUtf8ContinuationByte(fourthRaw)) {
            return false;
        }

        stack i32 second = UnsignedByte(secondRaw);
        stack i32 third = UnsignedByte(thirdRaw);
        stack i32 fourth = UnsignedByte(fourthRaw);
        if (first == 240 && second < 144) {
            return false;
        }

        if (first == 244 && second > 143) {
            return false;
        }

        *index = readIndex + 4;
        *codePoint = ((first & 7) << 18)
            | ((second & 63) << 12)
            | ((third & 63) << 6)
            | (fourth & 63);
        return true;
    }

    return false;
}

fn i64 Utf8ExpectedByteCount(i8 firstByte) {
    stack i32 first = UnsignedByte(firstByte);
    if (first <= 127) {
        return 1;
    }

    if (194 <= first && first <= 223) {
        return 2;
    }

    if (224 <= first && first <= 239) {
        return 3;
    }

    if (240 <= first && first <= 244) {
        return 4;
    }

    return 0;
}

fn bool TryReadInputByte(rawmutptr<i8> destination) {
    if (destination == null) {
        return false;
    }

    stack rawptr<i8> handle = System.IO.File.OpenRead("/dev/stdin");
    if (handle == null) {
        return false;
    }

    stack i64 readCount = System.IO.File.ReadBytes((rawptr<i8>)destination, 1, 1, handle);
    System.IO.File.Close(handle);
    return readCount == 1;
}

fn i64 DecodeUtf8BytesToUnicode(rawptr<i8> data, i64 length, rawmutptr<i32> destination, i64 capacity) {
    if (destination == null || capacity <= 0 || length <= 0) {
        return 0;
    }

    stack mut i64 readIndex = 0;
    stack mut i64 writeIndex = 0;
    while willexit (readIndex < length && writeIndex < capacity) {
        stack i64 start = readIndex;
        stack i32 codePoint = 65533;
        if (!TryDecodeUtf8CodePoint(data, length, &readIndex, &codePoint)) {
            readIndex = start + 1;
        }

        *(&destination[writeIndex]) = NormalizeUnicodeCodePoint(codePoint);
        writeIndex += 1;
    }

    return writeIndex;
}

fn Unicode BuildConsoleReadLineResult(i64 length) {
    return new Unicode() {
        Data = &ConsoleReadLineStorage.Storage[0],
        Length = length,
        Capacity = ConsoleInputUnicodeCapacity
    };
}

fn Unicode BuildConsoleReadUnitResult(i32 codePoint, i64 length) {
    if (length > 0) {
        ConsoleReadUnitStorage.Storage[0] = NormalizeUnicodeCodePoint(codePoint);
    }

    return new Unicode() {
        Data = &ConsoleReadUnitStorage.Storage[0],
        Length = length,
        Capacity = 1
    };
}

internal fn Unicode ReadLineUnicode() {
    stack mut ConsoleByteStorage lineBytes = new ConsoleByteStorage();
    stack mut ConsoleSingleByteStorage nextByte = new ConsoleSingleByteStorage();
    stack mut i64 byteLength = 0;

    while willexit (byteLength < ConsoleInputByteCapacity) {
        if (!TryReadInputByte(&nextByte.Storage[0])) {
            break;
        }

        if (nextByte.Storage[0] == (i8)10) {
            if (byteLength > 0 && lineBytes.Storage[byteLength - 1] == (i8)13) {
                byteLength -= 1;
            }

            break;
        }

        lineBytes.Storage[byteLength] = nextByte.Storage[0];
        byteLength += 1;
    }

    stack rawptr<i8> lineData = null;
    if (byteLength > 0) {
        lineData = &lineBytes.Storage[0];
    }

    stack i64 lineLength = DecodeUtf8BytesToUnicode(
        lineData,
        byteLength,
        &ConsoleReadLineStorage.Storage[0],
        ConsoleInputUnicodeCapacity);
    return BuildConsoleReadLineResult(lineLength);
}

internal fn Unicode ReadUnicode() {
    stack mut ConsoleCodePointByteStorage utf8Bytes = new ConsoleCodePointByteStorage();
    if (!TryReadInputByte(&utf8Bytes.Storage[0])) {
        return BuildConsoleReadUnitResult(0, 0);
    }

    stack i64 expectedLength = Utf8ExpectedByteCount(utf8Bytes.Storage[0]);
    if (expectedLength <= 0) {
        return BuildConsoleReadUnitResult(65533, 1);
    }

    if (expectedLength == 1) {
        return BuildConsoleReadUnitResult(UnsignedByte(utf8Bytes.Storage[0]), 1);
    }

    stack mut i64 index = 1;
    while willexit (index < expectedLength) {
        if (!TryReadInputByte(&utf8Bytes.Storage[index])) {
            return BuildConsoleReadUnitResult(65533, 1);
        }

        index += 1;
    }

    stack mut i64 consumed = 0;
    stack i32 codePoint = 65533;
    if (TryDecodeUtf8CodePoint(&utf8Bytes.Storage[0], expectedLength, &consumed, &codePoint)
        && consumed == expectedLength) {
        return BuildConsoleReadUnitResult(codePoint, 1);
    }

    return BuildConsoleReadUnitResult(65533, 1);
}
