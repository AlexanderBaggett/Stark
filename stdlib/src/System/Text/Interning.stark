import System.Collections
import System.Memory
import System.Text
module System.Text.Interning

public enum TextInternerError
{
    TooManyItems,
    InvalidId,
    Memory from System.Memory.MemoryError,
}

public enum TextInternerResult<T>
{
    [Ok] Ok(T),
    [Err] Err(TextInternerError),
}

internal inline finite law System.Collections.Ordering CompareIndex(
    u32[0 max] left,
    u32[0 max] right)
{
    if (left < right)
    {
        return System.Collections.Ordering.Less;
    }

    if (left > right)
    {
        return System.Collections.Ordering.Greater;
    }

    return System.Collections.Ordering.Equal;
}

public struct SymbolId
{
    internal u32[0 max] Value;

    inline finite law u32[0 max] Index(borrow SymbolId self)
    {
        return self.Value;
    }

    static finite law u64[0 max] Hash(borrow SymbolId value)
    {
        return (u64[0 max])value.Value;
    }

    static finite law bool Equals(borrow SymbolId left, borrow SymbolId right)
        where overlap(left, right)
    {
        return left.Value == right.Value;
    }

    static finite law System.Collections.Ordering Compare(borrow SymbolId left, borrow SymbolId right)
        where overlap(left, right)
    {
        return CompareIndex(left.Value, right.Value);
    }
}

