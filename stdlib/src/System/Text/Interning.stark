        }
    }

    fn TextInternerResult<OwnedAscii> CopyName(mut borrow FieldInterner self, FieldId id)
    {
        return self.Inner.CopyName(id.Value);
    }
}

public struct MemberInterner
{
    internal AsciiInterner Inner;

    MemberInterner()
    {
        self.Inner = new();
    }

    inline finite law u64[0 2 ** 63 - 1] Count(borrow MemberInterner self)
    {
        return self.Inner.Count();
    }

    inline finite law bool IsEmpty(borrow MemberInterner self)
    {
        return self.Inner.IsEmpty();
    }

    inline finite law bool Contains(borrow MemberInterner self, ascii name)
        where overlap(self, name)
    {
        return self.Inner.Contains(name);
    }

    inline fn bool TryGet(borrow MemberInterner self, ascii name, out MemberId id)
        where overlap(self, name),
              overlap(name, id)
    {
        stack mut u32[0 max] raw = 0;
        if (!self.Inner.TryGet(name, raw))
        {
            return false;
        }

        id = MakeMemberId(raw);
        return true;
    }

    fn TextInternerResult<MemberId> Intern(mut borrow MemberInterner self, ascii name)
        where overlap(self, name)
    {
        stack TextInternerResult<u32[0 max]> result = self.Inner.Intern(name);
        switch (result)
        {
            case TextInternerResult<u32[0 max]>.Err(var error):
                return TextInternerResult<MemberId>.Err(error);
            case TextInternerResult<u32[0 max]>.Ok(var raw):
                return TextInternerResult<MemberId>.Ok(MakeMemberId(raw));
        }
    }

    fn TextInternerResult<OwnedAscii> CopyName(mut borrow MemberInterner self, MemberId id)
    {
        return self.Inner.CopyName(id.Value);
    }
}

