    public law bool IsExternalAt(borrow TypedMemberSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedDeclFlagExternal());
    }

    public law bool IsUnsafeAt(borrow TypedMemberSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedDeclFlagUnsafe());
    }

    public law bool IsFfiAt(borrow TypedMemberSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
