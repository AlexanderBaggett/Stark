    public law u32[0 max] FieldCount(borrow TypedMemberSymbolTable self)
    {
        return self.CountOfKind(TypedMemberSymbolKind.Field);
    }

    public law u32[0 max] MethodCount(borrow TypedMemberSymbolTable self)
    {
