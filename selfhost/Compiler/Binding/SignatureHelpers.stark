import Compiler.Lexing
import Compiler.Parsing
import Compiler.Binding.TokenHelpers
import Compiler.Binding.LayoutHelpers
module Compiler.Binding.SignatureHelpers

internal fn bool TypeSpanIsMemoryBackedParameter(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    stack mut bool consumedIntegerRange = false;
    stack mut TokenKind previousTopLevel = TokenKind.EndOfFile;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0)
        {
            if (kind == TokenKind.Borrow || kind == TokenKind.Retborrow
                || kind == TokenKind.Storeborrow || kind == TokenKind.Out
                || kind == TokenKind.Init || kind == TokenKind.Rawptr
                || kind == TokenKind.Rawmutptr || kind == TokenKind.AsciiView
                || kind == TokenKind.UnicodeView)
            {
                return true;
            }

            if (kind == TokenKind.LBrack)
            {
                if (stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.RBrack)
                {
                    return true;
                }

                if (previousTopLevel == TokenKind.IntegerType && !consumedIntegerRange)
                {
                    consumedIntegerRange = true;
                }
            }
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        if (depth == 0 && kind != TokenKind.LBrack && kind != TokenKind.RBrack)
        {
            previousTopLevel = kind;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u64[0 2 ** 63 - 1] FunctionSignatureParamIndexPlusOneByName(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u32[0 max] nameToken)
{
    stack mut u64[0 2 ** 63 - 1] found = 0;
    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < paramCount; index += 1)
    {
        if (found == 0 && BindingTokenTextEqualsToken(source, stream, signature.ParamNameAt(index), nameToken))
        {
            found = (u64[0 2 ** 63 - 1])(index + 1);
        }
    }

    return found;
}

internal fn u32[0 max] MatchingCloseParenAfter(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.RParen && depth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn bool TryFindCallableParamList(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive, out u32[0 max] lparen, out u32[0 max] rparen)
{
    lparen = 0;
    rparen = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Fn)
        {
            stack mut u32[0 max] depth = 0;
            stack mut u32[0 max] cursor = (u32[0 max])(scan + 1);
            while willexit (cursor < endExclusive)
            {
                stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
                if (kind == TokenKind.LParen && depth == 0)
                {
                    lparen = cursor;
                    rparen = MatchingCloseParenAfter(stream, cursor, endExclusive);
                    return rparen != 0;
                }

                if (kind == TokenKind.LParen || kind == TokenKind.LBrack
                    || kind == TokenKind.LBrace || kind == TokenKind.Lt)
                {
                    depth = (u32[0 max])(depth + 1);
                }
                else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
                    || kind == TokenKind.RBrace || kind == TokenKind.Gt)
                {
                    if (depth > 0)
                    {
                        depth = (u32[0 max])(depth - 1);
                    }
                }

                cursor = (u32[0 max])(cursor + 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u32[0 max] CallableParamCount(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] rparen)
{
    if ((u32[0 max])(lparen + 1) >= rparen)
    {
        return 0;
    }

    stack mut u32[0 max] count = 1;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan < rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Comma && depth == 0)
        {
            count = (u32[0 max])(count + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

internal fn bool TryCallableParamSpan(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] rparen, u32[0 max] argIndex, out u32[0 max] start, out u32[0 max] endExclusive)
{
    start = 0;
    endExclusive = 0;
    stack mut u32[0 max] currentIndex = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(lparen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan <= rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if ((scan == rparen || (kind == TokenKind.Comma && depth == 0)))
        {
            if (currentIndex == argIndex)
            {
                start = segmentStart;
                endExclusive = scan;
                return segmentStart < scan;
            }

            currentIndex = (u32[0 max])(currentIndex + 1);
            segmentStart = (u32[0 max])(scan + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool TypeSpanIsOutputOnlyParameter(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Out)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Init);
}

internal fn bool TypeSpanFormsSafeBorrow(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Borrow)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Retborrow)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Storeborrow)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Out)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Init);
}
