import Compiler.Lexing
module Compiler.Binding.ReceiverTokenHelpers

internal finite law u32[0 max] ReceiverBodyOpenToken(borrow TokenStream stream, u32[0 max] ownerNameToken)
{
    stack mut u32[0 max] scan = ownerNameToken;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.LBrace)
        {
            return scan;
        }

        if (kind == TokenKind.Semi || kind == TokenKind.EndOfFile)
        {
            return 0;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal finite law u32[0 max] ReceiverMemberEndToken(borrow TokenStream stream, u32[0 max] memberStart)
{
    stack mut u32[0 max] scan = memberStart;
    stack mut u32[0 max] parenDepth = 0;
    stack mut u32[0 max] bracketDepth = 0;
    stack mut u32[0 max] angleDepth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return scan;
        }

        if (kind == TokenKind.Semi && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.RBrace && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            if (scan > memberStart)
            {
                return (u32[0 max])(scan - 1);
            }

            return scan;
        }

        if (kind == TokenKind.LBrace && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            stack mut u32[0 max] bodyDepth = 1;
            scan = (u32[0 max])(scan + 1);
            while willexit (guard > 0)
            {
                guard = (u64[0 2 ** 63 - 1])(guard - 1);
                stack TokenKind bodyKind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
                if (bodyKind == TokenKind.EndOfFile)
                {
                    return scan;
                }

                if (bodyKind == TokenKind.LBrace)
                {
                    bodyDepth = (u32[0 max])(bodyDepth + 1);
                }
                else if (bodyKind == TokenKind.RBrace)
                {
                    if (bodyDepth > 0)
                    {
                        bodyDepth = (u32[0 max])(bodyDepth - 1);
                    }

                    if (bodyDepth == 0)
                    {
                        return scan;
                    }
                }

                scan = (u32[0 max])(scan + 1);
            }

            return scan;
        }

        if (kind == TokenKind.LParen)
        {
            parenDepth = (u32[0 max])(parenDepth + 1);
        }
        else if (kind == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = (u32[0 max])(parenDepth - 1);
            }
        }
        else if (kind == TokenKind.LBrack)
        {
            bracketDepth = (u32[0 max])(bracketDepth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = (u32[0 max])(bracketDepth - 1);
            }
        }
        else if (kind == TokenKind.Lt)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return scan;
}

internal finite law u32[0 max] ReceiverMemberFunctionToken(borrow TokenStream stream, u32[0 max] memberStart, u32[0 max] memberEnd)
{
    stack mut u32[0 max] scan = memberStart;
    stack mut u32[0 max] callableKindToken = 0;
    stack mut u32[0 max] parenDepth = 0;
    stack mut u32[0 max] bracketDepth = 0;
    stack mut u32[0 max] angleDepth = 0;
    while willexit (scan <= memberEnd)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Fn && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            return scan;
        }

        if ((kind == TokenKind.Finite || kind == TokenKind.Law) && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            callableKindToken = scan;
        }

        if (kind == TokenKind.LBrace && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            return callableKindToken;
        }

        if (kind == TokenKind.LParen)
        {
            parenDepth = (u32[0 max])(parenDepth + 1);
        }
        else if (kind == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = (u32[0 max])(parenDepth - 1);
            }
        }
        else if (kind == TokenKind.LBrack)
        {
            bracketDepth = (u32[0 max])(bracketDepth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = (u32[0 max])(bracketDepth - 1);
            }
        }
        else if (kind == TokenKind.Lt)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return callableKindToken;
}
