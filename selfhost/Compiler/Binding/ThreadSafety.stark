import Compiler.Lexing
import Compiler.Parsing
import Compiler.Binding.Diagnostics
import Compiler.Binding.TokenHelpers
import Compiler.Binding.Declarations
import Compiler.Binding.TypeResolution
import Compiler.Binding.TypedMembers
import Compiler.Binding.GenericUseSites
import Compiler.Binding.TypedDeclarations
import Compiler.Binding.LayoutHelpers
import System.Memory
module Compiler.Binding.ThreadSafety

public enum ThreadSafetyLawKind
{
    Transferable,
    Shareable,
}

public struct ThreadSafetyLawFactTable
{
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] TransferableFlags;
    internal dynamic u32[0 max] ShareableFlags;
    internal dynamic u32[0 max] TransferableStates;
    internal dynamic u32[0 max] ShareableStates;

    ThreadSafetyLawFactTable()
    {
        self.NameTokens = new();
        self.TransferableFlags = new();
        self.ShareableFlags = new();
        self.TransferableStates = new();
        self.ShareableStates = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow ThreadSafetyLawFactTable self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] NameTokenAt(borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law bool IsTransferableAt(borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index)
    {
        return ThreadSafetyFlagHolds(self.TransferableFlagAt(index));
    }

    public law bool IsShareableAt(borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index)
    {
        return ThreadSafetyFlagHolds(self.ShareableFlagAt(index));
    }

    public law bool TransferableIsConditionalAt(borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index)
    {
        return ThreadSafetyFlagIsConditional(self.TransferableFlagAt(index));
    }

    public law bool ShareableIsConditionalAt(borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index)
    {
        return ThreadSafetyFlagIsConditional(self.ShareableFlagAt(index));
    }

    internal law u32[0 max] TransferableFlagAt(borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flag = 0;
        if (index < self.TransferableFlags.Length)
        {
            flag = self.TransferableFlags[index];
        }

        return flag;
    }

    internal law u32[0 max] ShareableFlagAt(borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flag = 0;
        if (index < self.ShareableFlags.Length)
        {
            flag = self.ShareableFlags[index];
        }

        return flag;
    }

    internal law u32[0 max] StateAt(borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index, ThreadSafetyLawKind lawKind)
    {
        stack mut u32[0 max] state = 0;
        switch (lawKind)
        {
            case ThreadSafetyLawKind.Transferable:
                if (index < self.TransferableStates.Length)
                {
                    state = self.TransferableStates[index];
                }

                return state;
            case ThreadSafetyLawKind.Shareable:
                if (index < self.ShareableStates.Length)
                {
                    state = self.ShareableStates[index];
                }

                return state;
        }
    }

    internal fn void SetStateAt(mut borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index, ThreadSafetyLawKind lawKind, u32[0 max] state)
    {
        switch (lawKind)
        {
            case ThreadSafetyLawKind.Transferable:
                if (index < self.TransferableStates.Length)
                {
                    self.TransferableStates[index] = state;
                }

                return;
            case ThreadSafetyLawKind.Shareable:
                if (index < self.ShareableStates.Length)
                {
                    self.ShareableStates[index] = state;
                }

                return;
        }
    }

    internal fn void SetFactAt(mut borrow ThreadSafetyLawFactTable self, u64[0 2 ** 63 - 1] index, ThreadSafetyLawKind lawKind, bool holds, bool conditional)
    {
        stack u32[0 max] flag = ThreadSafetyMakeFactFlag(holds, conditional);
        switch (lawKind)
        {
            case ThreadSafetyLawKind.Transferable:
                if (index < self.TransferableFlags.Length)
                {
                    self.TransferableFlags[index] = flag;
                }

                return;
            case ThreadSafetyLawKind.Shareable:
                if (index < self.ShareableFlags.Length)
                {
                    self.ShareableFlags[index] = flag;
                }

                return;
        }
    }

    internal fn System.Memory.MemoryStatus AppendPending(mut borrow ThreadSafetyLawFactTable self, u32[0 max] nameToken)
    {
        if (!self.NameTokens.TryReserve(1)
            || !self.TransferableFlags.TryReserve(1)
            || !self.ShareableFlags.TryReserve(1)
            || !self.TransferableStates.TryReserve(1)
            || !self.ShareableStates.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.TransferableFlags[self.TransferableFlags.Length] = 0;
        init self.ShareableFlags[self.ShareableFlags.Length] = 0;
        init self.TransferableStates[self.TransferableStates.Length] = 0;
        init self.ShareableStates[self.ShareableStates.Length] = 0;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal finite law u32[0 max] ThreadSafetyMakeFactFlag(bool holds, bool conditional)
{
    if (!holds)
    {
        return 0;
    }

    if (conditional)
    {
        return 2;
    }

    return 1;
}

internal finite law bool ThreadSafetyFlagHolds(u32[0 max] flag)
{
    return flag != 0;
}

internal finite law bool ThreadSafetyFlagIsConditional(u32[0 max] flag)
{
    return flag == 2;
}

internal finite law bool ThreadSafetyLawNameMatches(ascii source, borrow TokenStream stream, u32[0 max] token, ThreadSafetyLawKind lawKind)
{
    switch (lawKind)
    {
        case ThreadSafetyLawKind.Transferable:
            return TokenTextEquals(source, stream, token, "Transferable");
        case ThreadSafetyLawKind.Shareable:
            return TokenTextEquals(source, stream, token, "Shareable");
    }
}

internal finite law bool ThreadSafetyLawNameTokenIsKnown(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    return TokenTextEquals(source, stream, token, "Transferable")
        || TokenTextEquals(source, stream, token, "Shareable");
}

internal finite law ThreadSafetyLawKind ThreadSafetyLawKindFromToken(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    if (TokenTextEquals(source, stream, token, "Shareable"))
    {
        return ThreadSafetyLawKind.Shareable;
    }

    return ThreadSafetyLawKind.Transferable;
}

internal fn bool ThreadSafetyTryFindFactIndex(
    ascii source,
    borrow TokenStream stream,
    borrow ThreadSafetyLawFactTable facts,
    u32[0 max] nameToken,
    out u64[0 2 ** 63 - 1] factIndex)
{
    factIndex = 0;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (BindingTokenTextEqualsToken(source, stream, facts.NameTokenAt(index), nameToken))
        {
            factIndex = index;
            return true;
        }
    }

    return false;
}

internal fn bool ThreadSafetyTryTopLevelSuffixBracket(
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    out u32[0 max] open,
    out u32[0 max] close)
{
    open = 0;
    close = 0;
    if (start >= endExclusive)
    {
        return false;
    }

    stack mut u32[0 max] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.LBrack)
        {
            if (depth == 0)
            {
                stack u32[0 max] bracketClose = MatchingTypeCloseBefore(stream, scan, endExclusive);
                if ((u32[0 max])(bracketClose + 1) == endExclusive)
                {
                    open = scan;
                    close = bracketClose;
                    return true;
                }
            }

            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Lt || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrack || kind == TokenKind.Gt || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool ThreadSafetyTypePrefixToken(TokenKind kind)
{
    return kind == TokenKind.Stack
        || kind == TokenKind.Heap
        || kind == TokenKind.Register
        || kind == TokenKind.Arena
        || kind == TokenKind.Const
        || kind == TokenKind.Mut
        || kind == TokenKind.Frozen
        || kind == TokenKind.Shared
        || kind == TokenKind.Borrow
        || kind == TokenKind.Retborrow
        || kind == TokenKind.Out
        || kind == TokenKind.Init;
}

internal fn u32[0 max] ThreadSafetyCoreTypeStart(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] cursor = start;
    while willexit (cursor < endExclusive && ThreadSafetyTypePrefixToken(stream.KindAt((u64[0 2 ** 63 - 1])cursor)))
    {
        cursor = (u32[0 max])(cursor + 1);
    }

    return cursor;
}

internal finite law bool ThreadSafetyNameIsAtomicType(ascii source, borrow TokenStream stream, u32[0 max] headToken)
{
    if (TokenTextEquals(source, stream, headToken, "AtomicBool"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI8"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI16"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI24"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI32"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI48"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI64"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI96"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI128"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI192"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI256"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI384"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI512"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI768"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicI1024"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU8"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU16"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU24"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU32"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU48"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU64"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU96"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU128"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU192"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU256"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU384"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU512"))
    {
        return true;
    }

    if (TokenTextEquals(source, stream, headToken, "AtomicU768"))
    {
        return true;
    }

    return TokenTextEquals(source, stream, headToken, "AtomicU1024");
}

internal fn bool ThreadSafetyAttributeContainsLaw(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] attrStart,
    u32[0 max] attrEnd,
    ascii attributeName,
    ThreadSafetyLawKind lawKind)
{
    stack mut u32[0 max] scan = (u32[0 max])(attrStart + 1);
    while willexit (scan < attrEnd)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Identifier
            && TokenTextEquals(source, stream, scan, attributeName))
        {
            stack u32[0 max] open = (u32[0 max])(scan + 1);
            stack u32[0 max] lawToken = (u32[0 max])(scan + 2);
            stack u32[0 max] close = (u32[0 max])(scan + 3);
            if (close < attrEnd
                && stream.KindAt((u64[0 2 ** 63 - 1])open) == TokenKind.LParen
                && stream.KindAt((u64[0 2 ** 63 - 1])lawToken) == TokenKind.Identifier)
            {
                if (ThreadSafetyLawNameMatches(source, stream, lawToken, lawKind)
                    && stream.KindAt((u64[0 2 ** 63 - 1])close) == TokenKind.RParen)
                {
                    return true;
                }
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool ThreadSafetyTryReadGrantCondition(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] attrStart,
    u32[0 max] attrEnd,
    out ThreadSafetyLawKind conditionLaw,
    out u32[0 max] conditionStart,
    out u32[0 max] conditionEnd)
{
    conditionLaw = ThreadSafetyLawKind.Transferable;
    conditionStart = 0;
    conditionEnd = 0;
    stack mut u32[0 max] scan = (u32[0 max])(attrStart + 1);
    while willexit (scan < attrEnd)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Where)
        {
            stack u32[0 max] lawToken = (u32[0 max])(scan + 1);
            stack u32[0 max] open = (u32[0 max])(lawToken + 1);
            if (lawToken < attrEnd
                && open < attrEnd
                && stream.KindAt((u64[0 2 ** 63 - 1])lawToken) == TokenKind.Identifier
                && ThreadSafetyLawNameTokenIsKnown(source, stream, lawToken)
                && stream.KindAt((u64[0 2 ** 63 - 1])open) == TokenKind.LParen)
            {
                stack u32[0 max] close = MatchingMemberCloseToken(stream, open);
                if (close > open && close <= attrEnd)
                {
                    conditionLaw = ThreadSafetyLawKindFromToken(source, stream, lawToken);
                    conditionStart = (u32[0 max])(open + 1);
                    conditionEnd = close;
                    return conditionStart < conditionEnd;
                }
            }

            return false;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool ThreadSafetyAttributeRangeContainsLaw(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    ascii attributeName,
    ThreadSafetyLawKind lawKind)
{
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return false;
        }

        if (ThreadSafetyAttributeContainsLaw(source, stream, scan, attrEnd, attributeName, lawKind))
        {
            return true;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return false;
}

internal fn u32[0 max] ThreadSafetyFieldAttributeStart(borrow TokenStream stream, u32[0 max] typeStart)
{
    stack mut u32[0 max] cursor = typeStart;
    while willexit (cursor > 0)
    {
        stack u32[0 max] previous = (u32[0 max])(cursor - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])previous);
        if (kind == TokenKind.Semi || kind == TokenKind.LBrace || kind == TokenKind.RBrace)
        {
            return cursor;
        }

        cursor = previous;
    }

    return cursor;
}

internal finite law u32[0 max] ThreadSafetyMergeFactFlag(u32[0 max] left, u32[0 max] right)
{
    if (left == 0 || right == 0)
    {
        return 0;
    }

    if (left == 2 || right == 2)
    {
        return 2;
    }

    return 1;
}

internal fn u32[0 max] ThreadSafetyGrantFlagInRange(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow ThreadSafetyLawFactTable facts,
    u32[0 max] start,
    u32[0 max] endExclusive,
    ThreadSafetyLawKind lawKind,
    u32[0 max] depth)
{
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return 0;
        }

        if (ThreadSafetyAttributeContainsLaw(source, stream, scan, attrEnd, "Grant", lawKind))
        {
            stack mut ThreadSafetyLawKind conditionLaw = ThreadSafetyLawKind.Transferable;
            stack mut u32[0 max] conditionStart = 0;
            stack mut u32[0 max] conditionEnd = 0;
            if (!ThreadSafetyTryReadGrantCondition(source, stream, scan, attrEnd, conditionLaw, conditionStart, conditionEnd))
            {
                return 1;
            }

            if (ThreadSafetyTypeSpanLawFlag(
                decls,
                table,
                source,
                stream,
                facts,
                conditionStart,
                conditionEnd,
                conditionLaw,
                (u32[0 max])(depth + 1)) != 0)
            {
                return 2;
            }
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return 0;
}

internal fn u32[0 max] ThreadSafetyNamedTypeLawFlagCached(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow ThreadSafetyLawFactTable facts,
    u32[0 max] nameToken,
    ThreadSafetyLawKind lawKind,
    u32[0 max] depth)
{
    if (nameToken == 0 || depth > 32)
    {
        return 0;
    }

    stack mut u64[0 2 ** 63 - 1] factIndex = 0;
    if (!ThreadSafetyTryFindFactIndex(source, stream, facts, nameToken, factIndex))
    {
        return 2;
    }

    stack u32[0 max] state = facts.StateAt(factIndex, lawKind);
    if (state == 1)
    {
        return 1;
    }

    if (state == 2)
    {
        switch (lawKind)
        {
            case ThreadSafetyLawKind.Transferable:
                return facts.TransferableFlagAt(factIndex);
            case ThreadSafetyLawKind.Shareable:
                return facts.ShareableFlagAt(factIndex);
        }
    }

    facts.SetStateAt(factIndex, lawKind, 1);
    stack mut DeclItem item = new();
    stack mut DeclarationKind declarationKind = DeclarationKind.Unknown;
    stack mut u32[0 max] flag = 2;
    if (LayoutTryReadDeclarationItem(decls, table, source, stream, nameToken, item, declarationKind))
    {
        flag = ThreadSafetyDeclarationLawFlag(decls, table, source, stream, facts, item, lawKind, (u32[0 max])(depth + 1));
    }

    facts.SetFactAt(factIndex, lawKind, flag != 0, flag == 2);
    facts.SetStateAt(factIndex, lawKind, 2);
    return flag;
}

internal fn u32[0 max] ThreadSafetyTypeSpanLawFlag(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow ThreadSafetyLawFactTable facts,
    u32[0 max] start,
    u32[0 max] endExclusive,
    ThreadSafetyLawKind lawKind,
    u32[0 max] depth)
{
    if (start >= endExclusive || depth > 32)
    {
        return 0;
    }

    if (TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Storeborrow))
    {
        return 0;
    }

    stack mut u32[0 max] suffixOpen = 0;
    stack mut u32[0 max] suffixClose = 0;
    if (ThreadSafetyTryTopLevelSuffixBracket(stream, start, endExclusive, suffixOpen, suffixClose)
        && suffixOpen > start)
    {
        return ThreadSafetyTypeSpanLawFlag(decls, table, source, stream, facts, start, suffixOpen, lawKind, (u32[0 max])(depth + 1));
    }

    stack u32[0 max] coreStart = ThreadSafetyCoreTypeStart(stream, start, endExclusive);
    stack u32[0 max] primary = LayoutBoundedFirstTypeStart(stream, coreStart, endExclusive);
    if (primary == 0)
    {
        return 0;
    }

    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])primary);
    if (primaryKind == TokenKind.Bool
        || primaryKind == TokenKind.IntegerType
        || primaryKind == TokenKind.FloatType
        || primaryKind == TokenKind.Void
        || primaryKind == TokenKind.AsciiView
        || primaryKind == TokenKind.UnicodeView
        || primaryKind == TokenKind.Fnptr
        || primaryKind == TokenKind.Closure)
    {
        return 1;
    }

    if (primaryKind == TokenKind.Rawptr || primaryKind == TokenKind.Rawmutptr)
    {
        return 0;
    }

    if (primaryKind == TokenKind.Dynamic)
    {
        return ThreadSafetyTypeSpanLawFlag(
            decls,
            table,
            source,
            stream,
            facts,
            (u32[0 max])(primary + 1),
            endExclusive,
            lawKind,
            (u32[0 max])(depth + 1));
    }

    stack mut u32[0 max] head = LastTypeHeadIdentifierInSpan(stream, coreStart, endExclusive);
    if (head == 0)
    {
        head = primary;
    }

    if (head == 0)
    {
        return 0;
    }

    if (LayoutNameIsSystemCAlias(source, stream, head) || ThreadSafetyNameIsAtomicType(source, stream, head))
    {
        return 1;
    }

    if (primaryKind != TokenKind.Identifier)
    {
        return 2;
    }

    return ThreadSafetyNamedTypeLawFlagCached(decls, table, source, stream, facts, head, lawKind, (u32[0 max])(depth + 1));
}

internal fn u32[0 max] ThreadSafetyRecordHeaderFieldsLawFlag(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow ThreadSafetyLawFactTable facts,
    DeclItem item,
    ThreadSafetyLawKind lawKind,
    u32[0 max] depth)
{
    if (item.Kind != DeclarationKind.Record || item.NameToken == 0 || depth > 32)
    {
        return 1;
    }

    stack u32[0 max] open = RecordHeaderOpenToken(stream, item.NameToken, item.EndToken);
    if (open == 0)
    {
        return 1;
    }

    stack u32[0 max] close = MatchingMemberCloseToken(stream, open);
    if (close <= open)
    {
        return 1;
    }

    stack mut u32[0 max] result = 1;
    stack mut u32[0 max] segStart = (u32[0 max])(open + 1);
    stack mut u32[0 max] scan = segStart;
    stack mut u32[0 max] segmentDepth = 0;
    while willexit (scan <= close)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            segmentDepth = (u32[0 max])(segmentDepth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (segmentDepth > 0)
            {
                segmentDepth = (u32[0 max])(segmentDepth - 1);
            }
        }

        if (segmentDepth == 0 && (kind == TokenKind.Comma || kind == TokenKind.RParen))
        {
            stack u32[0 max] typeStart = LayoutSkipMemberModifiers(stream, segStart);
            stack u32[0 max] nameToken = LastTypeHeadIdentifierInSpan(stream, typeStart, scan);
            if (nameToken != 0)
            {
                stack u32[0 max] fieldFlag = ThreadSafetyTypeSpanLawFlag(
                    decls,
                    table,
                    source,
                    stream,
                    facts,
                    typeStart,
                    nameToken,
                    lawKind,
                    (u32[0 max])(depth + 1));
                result = ThreadSafetyMergeFactFlag(result, fieldFlag);
                if (result == 0)
                {
                    return 0;
                }
            }

            segStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return result;
}

internal fn u32[0 max] ThreadSafetyFieldLawFlag(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow ThreadSafetyLawFactTable facts,
    u32[0 max] fieldTypeStart,
    u32[0 max] fieldTypeEnd,
    ThreadSafetyLawKind lawKind,
    u32[0 max] depth)
{
    stack u32[0 max] attrStart = ThreadSafetyFieldAttributeStart(stream, fieldTypeStart);
    if (ThreadSafetyAttributeRangeContainsLaw(source, stream, attrStart, fieldTypeStart, "Grant", lawKind)
        && ThreadSafetyAttributeRangeContainsLaw(source, stream, attrStart, fieldTypeStart, "Deny", lawKind))
    {
        return 0;
    }

    stack u32[0 max] grantFlag = ThreadSafetyGrantFlagInRange(
        decls,
        table,
        source,
        stream,
        facts,
        attrStart,
        fieldTypeStart,
        lawKind,
        depth);
    if (grantFlag != 0)
    {
        return grantFlag;
    }

    if (ThreadSafetyAttributeRangeContainsLaw(source, stream, attrStart, fieldTypeStart, "Deny", lawKind))
    {
        return 0;
    }

    return ThreadSafetyTypeSpanLawFlag(decls, table, source, stream, facts, fieldTypeStart, fieldTypeEnd, lawKind, (u32[0 max])(depth + 1));
}

internal fn u32[0 max] ThreadSafetyAliasLawFlag(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow ThreadSafetyLawFactTable facts,
    DeclItem item,
    ThreadSafetyLawKind lawKind,
    u32[0 max] depth)
{
    stack mut u32[0 max] assign = item.KeywordToken;
    while willexit (assign < item.EndToken
        && stream.KindAt((u64[0 2 ** 63 - 1])assign) != TokenKind.Assign)
    {
        assign = (u32[0 max])(assign + 1);
    }

    if (assign >= item.EndToken)
    {
        return 0;
    }

    return ThreadSafetyTypeSpanLawFlag(decls, table, source, stream, facts, (u32[0 max])(assign + 1), item.EndToken, lawKind, (u32[0 max])(depth + 1));
}

internal fn u32[0 max] ThreadSafetyDeclarationLawFlag(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow ThreadSafetyLawFactTable facts,
    DeclItem item,
    ThreadSafetyLawKind lawKind,
    u32[0 max] depth)
{
    if (depth > 32 || item.NameToken == 0)
    {
        return 0;
    }

    if (ThreadSafetyAttributeRangeContainsLaw(source, stream, item.StartToken, item.KeywordToken, "Grant", lawKind)
        && ThreadSafetyAttributeRangeContainsLaw(source, stream, item.StartToken, item.KeywordToken, "Deny", lawKind))
    {
        return 0;
    }

    stack u32[0 max] grantFlag = ThreadSafetyGrantFlagInRange(decls, table, source, stream, facts, item.StartToken, item.KeywordToken, lawKind, depth);
    if (grantFlag != 0)
    {
        return grantFlag;
    }

    if (ThreadSafetyAttributeRangeContainsLaw(source, stream, item.StartToken, item.KeywordToken, "Deny", lawKind))
    {
        return 0;
    }

    if (item.Kind == DeclarationKind.Alias)
    {
        return ThreadSafetyAliasLawFlag(decls, table, source, stream, facts, item, lawKind, (u32[0 max])(depth + 1));
    }

    if (item.Kind == DeclarationKind.Enum)
    {
        stack mut TypeSpanList payloads = new();
        switch (ParseEnumPayloadTypeSpans(stream, item.KeywordToken))
        {
            case ParseResult<TypeSpanList>.Err(var payloadError):
                return 0;
            case ParseResult<TypeSpanList>.Ok(var parsedPayloads):
                payloads = parsedPayloads;
        }

        stack mut u32[0 max] result = 1;
        stack u64[0 2 ** 63 - 1] payloadCount = payloads.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] payload = 0; payload < payloadCount; payload += 1)
        {
            stack u32[0 max] payloadFlag = ThreadSafetyTypeSpanLawFlag(
                decls,
                table,
                source,
                stream,
                facts,
                payloads.StartTokenAt(payload),
                payloads.EndTokenAt(payload),
                lawKind,
                (u32[0 max])(depth + 1));
            result = ThreadSafetyMergeFactFlag(result, payloadFlag);
            if (result == 0)
            {
                return 0;
            }
        }

        return result;
    }

    if (item.Kind != DeclarationKind.Struct && item.Kind != DeclarationKind.Record)
    {
        return 0;
    }

    stack mut u32[0 max] result = ThreadSafetyRecordHeaderFieldsLawFlag(decls, table, source, stream, facts, item, lawKind, (u32[0 max])(depth + 1));
    if (result == 0)
    {
        return 0;
    }

    stack mut FieldList fields = new();
    switch (ParseStructFields(stream, item.KeywordToken))
    {
        case ParseResult<FieldList>.Err(var fieldError):
            return 0;
        case ParseResult<FieldList>.Ok(var parsedFields):
            fields = parsedFields;
    }

    stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < fieldCount; field += 1)
    {
        stack u32[0 max] fieldFlag = ThreadSafetyFieldLawFlag(
            decls,
            table,
            source,
            stream,
            facts,
            fields.TypeStartAt(field),
            fields.TypeEndAt(field),
            lawKind,
            (u32[0 max])(depth + 1));
        result = ThreadSafetyMergeFactFlag(result, fieldFlag);
        if (result == 0)
        {
            return 0;
        }
    }

    return result;
}

public fn BindResult<ThreadSafetyLawFactTable> BuildThreadSafetyLawFacts(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream)
{
    stack mut ThreadSafetyLawFactTable facts = new();
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (item.NameToken != 0
            && (item.Kind == DeclarationKind.Struct
                || item.Kind == DeclarationKind.Record
                || item.Kind == DeclarationKind.Enum
                || item.Kind == DeclarationKind.Alias))
        {
            switch (facts.AppendPending(item.NameToken))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return BindResult<ThreadSafetyLawFactTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack u64[0 2 ** 63 - 1] factCount = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] fact = 0; fact < factCount; fact += 1)
    {
        stack u32[0 max] nameToken = facts.NameTokenAt(fact);
        ThreadSafetyNamedTypeLawFlagCached(decls, table, source, stream, facts, nameToken, ThreadSafetyLawKind.Transferable, 0);
        ThreadSafetyNamedTypeLawFlagCached(decls, table, source, stream, facts, nameToken, ThreadSafetyLawKind.Shareable, 0);
    }

    return BindResult<ThreadSafetyLawFactTable>.Ok(facts);
}

internal struct ThreadSafetyLawPredicateTable
{
    internal dynamic u32[0 max] LawTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;

    ThreadSafetyLawPredicateTable()
    {
        self.LawTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow ThreadSafetyLawPredicateTable self)
    {
        return self.LawTokens.Length;
    }

    internal law u32[0 max] LawTokenAt(borrow ThreadSafetyLawPredicateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.LawTokens.Length)
        {
            token = self.LawTokens[index];
        }

        return token;
    }

    internal law u32[0 max] TypeStartTokenAt(borrow ThreadSafetyLawPredicateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeStartTokens.Length)
        {
            token = self.TypeStartTokens[index];
        }

        return token;
    }

    internal law u32[0 max] TypeEndTokenAt(borrow ThreadSafetyLawPredicateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeEndTokens.Length)
        {
            token = self.TypeEndTokens[index];
        }

        return token;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow ThreadSafetyLawPredicateTable self, u32[0 max] lawToken, u32[0 max] typeStart, u32[0 max] typeEnd)
    {
        if (!self.LawTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.LawTokens[self.LawTokens.Length] = lawToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStart;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEnd;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal fn BindResult<ThreadSafetyLawPredicateTable> BuildThreadSafetyLawPredicateTable(ascii source, borrow TokenStream stream, u32[0 max] ownerKeywordToken, ascii lawName)
{
    stack mut ThreadSafetyLawPredicateTable predicates = new();
    stack u32[0 max] ownerEnd = TypedGenericOwnerTerminatorToken(stream, ownerKeywordToken);
    if (ownerKeywordToken == 0 || ownerEnd <= ownerKeywordToken)
    {
        return BindResult<ThreadSafetyLawPredicateTable>.Ok(predicates);
    }

    stack mut bool inWhere = false;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = ownerKeywordToken;
    while willexit (scan < ownerEnd)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Where)
        {
            inWhere = true;
            scan = (u32[0 max])(scan + 1);
            continue;
        }

        if (inWhere && depth == 0
            && kind == TokenKind.Identifier
            && TokenTextEquals(source, stream, scan, lawName)
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            stack u32[0 max] open = (u32[0 max])(scan + 1);
            stack u32[0 max] close = MatchingMemberCloseToken(stream, open);
            if (close > open)
            {
                switch (predicates.Append(scan, (u32[0 max])(open + 1), close))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return BindResult<ThreadSafetyLawPredicateTable>.Err(BindError.OutOfMemory);
                    case System.Memory.MemoryStatus.Ok:
                }

                scan = (u32[0 max])(close + 1);
                continue;
            }
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return BindResult<ThreadSafetyLawPredicateTable>.Ok(predicates);
}

internal finite law bool ThreadSafetySingleIdentifierPrefixToken(TokenKind kind)
{
    return kind == TokenKind.Stack
        || kind == TokenKind.Heap
        || kind == TokenKind.Register
        || kind == TokenKind.Arena
        || kind == TokenKind.Const
        || kind == TokenKind.Mut
        || kind == TokenKind.Frozen
        || kind == TokenKind.Shared;
}

internal fn bool ThreadSafetyTypeSpanIsSingleIdentifier(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive, out u32[0 max] identifierToken)
{
    identifierToken = 0;
    stack mut u32[0 max] cursor = start;
    while willexit (cursor < endExclusive && ThreadSafetySingleIdentifierPrefixToken(stream.KindAt((u64[0 2 ** 63 - 1])cursor)))
    {
        cursor = (u32[0 max])(cursor + 1);
    }

    if (cursor < endExclusive
        && endExclusive == (u32[0 max])(cursor + 1)
        && stream.KindAt((u64[0 2 ** 63 - 1])cursor) == TokenKind.Identifier)
    {
        identifierToken = cursor;
        return true;
    }

    return false;
}

internal fn bool ThreadSafetyLawPredicatesContainSingleIdentifier(
    borrow ThreadSafetyLawPredicateTable predicates,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] identifierToken)
{
    if (identifierToken == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = predicates.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack mut u32[0 max] predicateIdentifier = 0;
        if (ThreadSafetyTypeSpanIsSingleIdentifier(stream, predicates.TypeStartTokenAt(index), predicates.TypeEndTokenAt(index), predicateIdentifier)
            && BindingTokenTextEqualsToken(source, stream, predicateIdentifier, identifierToken))
        {
            return true;
        }
    }

    return false;
}
