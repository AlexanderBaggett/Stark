import Compiler.Lexing
import Compiler.Binding.ReceiverTokenHelpers
import Compiler.Binding.TypedDeclarations
module Compiler.Binding.AssociatedTypes

internal struct AssociatedAliasMemberInfo
{
    internal u32[0 max] NameToken;
    internal u32[0 max] TypeHeadToken;
    internal u32[0 max] TypePrimaryToken;
    internal u32[0 max] TypeStartToken;
    internal u32[0 max] TypeEndToken;

    AssociatedAliasMemberInfo()
    {
        self.NameToken = 0;
        self.TypeHeadToken = 0;
        self.TypePrimaryToken = 0;
        self.TypeStartToken = 0;
        self.TypeEndToken = 0;
    }
}

internal finite law u32[0 max] AssociatedAliasNameEndToken(borrow TokenStream stream, u32[0 max] aliasKeyword, u32[0 max] memberEnd)
{
    stack mut u32[0 max] scan = (u32[0 max])(aliasKeyword + 1);
    stack mut u32[0 max] depth = 0;
    while willexit (scan <= memberEnd)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Assign || kind == TokenKind.Semi)
        {
            if (depth == 0)
            {
                return scan;
            }
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return memberEnd;
}

internal finite law u32[0 max] AssociatedAliasAssignToken(borrow TokenStream stream, u32[0 max] aliasKeyword, u32[0 max] memberEnd)
{
    stack mut u32[0 max] scan = aliasKeyword;
    stack mut u32[0 max] depth = 0;
    while willexit (scan <= memberEnd)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Assign && depth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal finite law AssociatedAliasMemberInfo ReadAssociatedAliasMemberInfo(borrow TokenStream stream, u32[0 max] aliasKeyword, u32[0 max] memberEnd)
{
    stack mut AssociatedAliasMemberInfo info = new();
    stack u32[0 max] nameEnd = AssociatedAliasNameEndToken(stream, aliasKeyword, memberEnd);
    info.NameToken = LastTypeHeadIdentifierInSpan(stream, (u32[0 max])(aliasKeyword + 1), nameEnd);

    stack u32[0 max] assignToken = AssociatedAliasAssignToken(stream, aliasKeyword, memberEnd);
    if (assignToken != 0 && assignToken < memberEnd)
    {
        info.TypeStartToken = (u32[0 max])(assignToken + 1);
        info.TypeEndToken = memberEnd;
        info.TypePrimaryToken = FirstTypeTokenInSpan(stream, info.TypeStartToken, info.TypeEndToken);
        info.TypeHeadToken = LastTypeHeadIdentifierInSpan(stream, info.TypeStartToken, info.TypeEndToken);
    }

    return info;
}
