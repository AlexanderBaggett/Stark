internal inline finite law u32[0 max] TypedFunctionBodyFlagNew() { return 32; }
internal inline finite law u32[0 max] TypedFunctionBodyFlagAssign() { return 64; }
internal inline finite law u32[0 max] TypedFunctionBodyFlagReturn() { return 128; }
internal inline finite law u32[0 max] TypedFunctionBodyFlagBecome() { return 256; }
internal inline finite law u32[0 max] TypedFunctionBodyFlagLocal() { return 512; }
