    public law bool HasBodyAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagHasBody()); }
    public law bool ReadsArgumentMemoryAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagReadsArgumentMemory()); }
    public law bool ReadsOtherMemoryAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagReadsOtherMemory()); }
    public law bool WritesOtherMemoryAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagWritesOtherMemory()); }
    public law bool IsPureAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagPure()); }
    public law bool NoSyncAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagNoSync()); }
    public law bool NoFreeAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagNoFree()); }
    public law bool NoUnwindAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagNoUnwind()); }
    public law bool WillReturnAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagWillReturn()); }
    public law bool MustProgressAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagMustProgress()); }
    public law bool NoRecurseAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagNoRecurse()); }
    public law bool UseFastCallingConventionAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagFastCall()); }
    public law bool IsFfiAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagFfi()); }
    public law bool IsVarargsAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagVarargs()); }
    public law bool IsHotAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagHot()); }
    public law bool IsColdAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagCold()); }
    public law bool IsStrictFpAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagStrictFp()); }
    public law bool IsTailCallableAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagTailCallable()); }
    public law bool IsAsmAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagAsm()); }
    public law bool BodyContainsCallAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.BodyFlagsAt(index), TypedFunctionBodyFlagCall()); }
    public law bool BodyContainsNewAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.BodyFlagsAt(index), TypedFunctionBodyFlagNew()); }
    public law bool BodyContainsAssignmentAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.BodyFlagsAt(index), TypedFunctionBodyFlagAssign()); }
    public law bool BodyContainsLoopAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.BodyFlagsAt(index), TypedFunctionBodyFlagLoop()); }
