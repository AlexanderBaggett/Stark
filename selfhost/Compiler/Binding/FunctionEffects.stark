    internal dynamic TypedFunctionInlinePreference InlinePreferences;
    internal dynamic TypedFunctionBackendOptimizationMode BackendOptimizationModes;
    internal dynamic u32[0 max] ParamCounts;
    internal dynamic u32[0 max] AbiNameTokens;
    internal dynamic u32[0 max] LinkNameValueTokens;
    internal dynamic u32[0 max] AsmInputCounts;
    internal dynamic u32[0 max] AsmOutputCounts;
    internal dynamic u32[0 max] AsmClobberCounts;
    internal dynamic u32[0 max] StatementCounts;
    internal dynamic u32[0 max] TopLevelStatementCounts;
    internal dynamic u32[0 max] ExpressionNodeCounts;
    internal dynamic u32[0 max] CallExpressionCounts;
    internal dynamic u32[0 max] NewExpressionCounts;
    internal dynamic u32[0 max] AssignmentExpressionCounts;
    internal dynamic u32[0 max] LocalDeclarationCounts;
    internal dynamic u32[0 max] ReturnCounts;
    internal dynamic u32[0 max] LoopCounts;
    internal dynamic u32[0 max] BranchCounts;
    internal dynamic u32[0 max] BodyFlags;
    internal dynamic u32[0 max] EffectFlags;

    TypedFunctionEffectSummaryTable()
    {
        self.OwnerKinds = new();
        self.DeclarationSymbolIndices = new();
        self.MemberSymbolIndices = new();
        self.OwnerDeclarationSymbolIndices = new();
        self.NameTokens = new();
        self.KeywordTokens = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.BodyOpenTokens = new();
        self.FunctionKinds = new();
        self.InlinePreferences = new();
        self.BackendOptimizationModes = new();
        self.ParamCounts = new();
        self.AbiNameTokens = new();
        self.LinkNameValueTokens = new();
        self.AsmInputCounts = new();
        self.AsmOutputCounts = new();
        self.AsmClobberCounts = new();
        self.StatementCounts = new();
        self.TopLevelStatementCounts = new();
        self.ExpressionNodeCounts = new();
        self.CallExpressionCounts = new();
        self.NewExpressionCounts = new();
        self.AssignmentExpressionCounts = new();
        self.LocalDeclarationCounts = new();
        self.ReturnCounts = new();
        self.LoopCounts = new();
        self.BranchCounts = new();
        self.BodyFlags = new();
        self.EffectFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedFunctionEffectSummaryTable self)
    {
        return self.NameTokens.Length;
    }

    public law TypedFunctionEffectOwnerKind OwnerKindAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedFunctionEffectOwnerKind kind = TypedFunctionEffectOwnerKind.Unknown;
        if (index < self.OwnerKinds.Length)
        {
            kind = self.OwnerKinds[index];
        }

        return kind;
    }

    public law u32[0 max] NameTokenAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

