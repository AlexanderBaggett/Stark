public enum TypedFunctionEffectOwnerKind
{
    Declaration,
    MemberMethod,
    Unknown,
}

public enum TypedFunctionInlinePreference
{
    InlineHint,
    Inline,
    NoInline,
}

public enum TypedFunctionBackendOptimizationMode
{
    Default,
    Opaque,
}

internal inline finite law u32[0 max] TypedFunctionEffectFlagHasBody() { return 1; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagReadsArgumentMemory() { return 2; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagPure() { return 4; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagNoSync() { return 8; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagNoFree() { return 16; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagNoUnwind() { return 32; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagWillReturn() { return 64; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagMustProgress() { return 128; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagFastCall() { return 256; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagFfi() { return 512; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagVarargs() { return 1024; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagHot() { return 2048; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagCold() { return 4096; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagStrictFp() { return 8192; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagReadsOtherMemory() { return 16384; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagWritesOtherMemory() { return 32768; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagNoRecurse() { return 65536; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagTailCallable() { return 131072; }
internal inline finite law u32[0 max] TypedFunctionEffectFlagAsm() { return 262144; }

internal inline finite law u32[0 max] TypedFunctionBodyFlagUnsafe() { return 1; }
internal inline finite law u32[0 max] TypedFunctionBodyFlagLoop() { return 2; }
internal inline finite law u32[0 max] TypedFunctionBodyFlagBranch() { return 4; }
internal inline finite law u32[0 max] TypedFunctionBodyFlagSwitch() { return 8; }
