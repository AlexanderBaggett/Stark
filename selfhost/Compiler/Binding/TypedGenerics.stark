import Compiler.Lexing
import Compiler.Parsing
import Compiler.Binding.Diagnostics
import Compiler.Binding.TokenHelpers
import Compiler.Binding.GenericUseSites
import Compiler.Binding.TypedDeclarations
import Compiler.Binding.TypedMembers
import System.Memory
module Compiler.Binding.TypedGenerics

public enum TypedGenericParameterKind
{
    Type,
    ComptimeValue,
    Unknown,
}

public enum TypedGenericOwnerKind
{
    Declaration,
    MemberMethod,
    Unknown,
}

internal inline finite law u32[0 max] TypedGenericFlagComptimeValue()
{
    return 1;
}

internal inline finite law u32[0 max] TypedGenericFlagHasType()
{
    return 2;
}

internal inline finite law u32[0 max] TypedGenericFlagIntegerType()
{
    return 4;
}

internal inline finite law u32[0 max] TypedGenericFlagFloatType()
{
    return 8;
}

internal inline finite law u32[0 max] TypedGenericFlagBoolType()
{
    return 16;
}

internal inline finite law u32[0 max] TypedGenericFlagTextType()
{
    return 32;
}

internal inline finite law u32[0 max] TypedGenericFlagNamedType()
{
    return 64;
}

internal inline finite law u32[0 max] TypedGenericFlagHasRangeBounds()
{
    return 128;
}

internal inline finite law u32[0 max] TypedGenericFlagHasConstraints()
{
    return 256;
}

public struct TypedGenericParameterSymbolTable
{
    internal dynamic u32[0 max] OwnerDeclarationSymbolIndices;
    internal dynamic u32[0 max] OwnerMemberSymbolIndices;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic TypedGenericOwnerKind OwnerKinds;
    internal dynamic TypedGenericParameterKind Kinds;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] EndTokens;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic u32[0 max] RangeStartTokens;
    internal dynamic u32[0 max] RangeEndTokens;
    internal dynamic u32[0 max] ParamOrdinals;
    internal dynamic u32[0 max] TypeOrdinals;
    internal dynamic u32[0 max] ComptimeOrdinals;
    internal dynamic u32[0 max] ConstraintCounts;
    internal dynamic u32[0 max] Flags;

    TypedGenericParameterSymbolTable()
    {
        self.OwnerDeclarationSymbolIndices = new();
        self.OwnerMemberSymbolIndices = new();
        self.OwnerNameTokens = new();
        self.OwnerKinds = new();
        self.Kinds = new();
        self.NameTokens = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.RangeStartTokens = new();
        self.RangeEndTokens = new();
        self.ParamOrdinals = new();
        self.TypeOrdinals = new();
        self.ComptimeOrdinals = new();
        self.ConstraintCounts = new();
        self.Flags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedGenericParameterSymbolTable self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] OwnerDeclarationSymbolIndexPlusOneAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.OwnerDeclarationSymbolIndices.Length)
        {
            value = self.OwnerDeclarationSymbolIndices[index];
        }

        return value;
    }

    public law u32[0 max] OwnerMemberSymbolIndexPlusOneAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.OwnerMemberSymbolIndices.Length)
        {
            value = self.OwnerMemberSymbolIndices[index];
        }

        return value;
    }

    public law u32[0 max] OwnerNameTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.OwnerNameTokens.Length)
        {
            token = self.OwnerNameTokens[index];
        }

        return token;
    }

    public law TypedGenericOwnerKind OwnerKindAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedGenericOwnerKind kind = TypedGenericOwnerKind.Unknown;
        if (index < self.OwnerKinds.Length)
        {
            kind = self.OwnerKinds[index];
        }

        return kind;
    }

    public law TypedGenericParameterKind KindAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedGenericParameterKind kind = TypedGenericParameterKind.Unknown;
        if (index < self.Kinds.Length)
        {
            kind = self.Kinds[index];
        }

        return kind;
    }

    public law u32[0 max] NameTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law u32[0 max] StartTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.StartTokens.Length)
        {
            token = self.StartTokens[index];
        }

        return token;
    }

    public law u32[0 max] EndTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
