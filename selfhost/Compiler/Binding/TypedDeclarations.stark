module Compiler.Binding.TypedDeclarations

public enum TypedDeclarationSymbolClass
{
    Type,
    Function,
    Value,
    Alias,
    Unknown,
}

public enum TypedDeclarationFunctionKind
{
    Fn,
    Finite,
    Law,
    FiniteLaw,
}

public enum TypedDeclarationStorageKind
{
    None,
    Const,
    Static,
    Heap,
    Stack,
    Register,
    Arena,
}

internal inline finite law u32[0 max] TypedDeclFlagExternal()
{
    return 1;
}

internal inline finite law u32[0 max] TypedDeclFlagUnsafe()
{
    return 2;
}

internal inline finite law u32[0 max] TypedDeclFlagFfi()
{
    return 4;
}

internal inline finite law u32[0 max] TypedDeclFlagAsm()
{
    return 8;
}

internal inline finite law u32[0 max] TypedDeclFlagVarargs()
{
    return 16;
}

internal inline finite law u32[0 max] TypedDeclFlagTailCallable()
{
    return 32;
}

internal inline finite law u32[0 max] TypedDeclFlagInline()
{
    return 64;
}

internal inline finite law u32[0 max] TypedDeclFlagNoInline()
{
    return 128;
}

internal inline finite law u32[0 max] TypedDeclFlagInlineHint()
{
    return 256;
}

internal inline finite law u32[0 max] TypedDeclFlagHot()
{
    return 512;
}

internal inline finite law u32[0 max] TypedDeclFlagCold()
{
    return 1024;
}

internal inline finite law u32[0 max] TypedDeclFlagStrictFp()
{
    return 2048;
}

internal inline finite law u32[0 max] TypedDeclFlagLinkName()
{
    return 4096;
}

internal inline finite law u32[0 max] TypedDeclFlagCAbi()
{
    return 8192;
}

internal inline finite law u32[0 max] TypedDeclFlagMutableStorage()
{
    return 16384;
}

internal inline finite law bool TypedDeclFlagPresent(u32[0 max] flags, u32[0 max] flag)
{
    return (flags & flag) != 0;
}

