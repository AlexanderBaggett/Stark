    public law u32[0 max] ArgumentDeclarationSymbolIndexPlusOneAt(borrow TypedGenericInstantiationPlanTable self, u64[0 2 ** 63 - 1] plan, u32[0 max] arg)
    {
        stack mut u32[0 max] value = 0;
        stack u64[0 2 ** 63 - 1] slot = self.ArgumentSlotOrInvalid(plan, arg);
