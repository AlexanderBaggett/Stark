module Compiler.Binding.TypedGenericInstantiations

public enum TypedGenericInstantiationTargetKind
{
    Declaration,
    MemberMethod,
    Unknown,
}

internal inline finite law u32[0 max] TypedGenericInstantiationFlagTargetResolved()
{
    return 1;
}

internal inline finite law u32[0 max] TypedGenericInstantiationFlagTargetGeneric()
{
    return 2;
}

internal inline finite law u32[0 max] TypedGenericInstantiationFlagArityMatches()
{
    return 4;
}

internal inline finite law u32[0 max] TypedGenericInstantiationFlagHasTypeArguments()
{
    return 8;
}

internal inline finite law u32[0 max] TypedGenericInstantiationFlagHasComptimeArguments()
{
    return 16;
}

internal inline finite law u32[0 max] TypedGenericInstantiationFlagContainsOpenGenericArguments()
{
    return 32;
}

internal inline finite law u32[0 max] TypedGenericInstantiationFlagHasUnresolvedArguments()
{
    return 64;
}

internal inline finite law u32[0 max] TypedGenericInstantiationFlagDirectlyMaterializable()
{
    return 128;
}

internal inline finite law u32[0 max] TypedGenericInstantiationArgumentFlagResolvedDeclaration()
{
    return 1;
}

internal inline finite law u32[0 max] TypedGenericInstantiationArgumentFlagResolvedGenericParameter()
{
    return 2;
}

internal inline finite law u32[0 max] TypedGenericInstantiationArgumentFlagOpenGeneric()
{
    return 4;
}

internal inline finite law u32[0 max] TypedGenericInstantiationArgumentFlagNestedGeneric()
{
    return 8;
}

internal inline finite law u32[0 max] TypedGenericInstantiationArgumentFlagComptimeForward()
{
    return 16;
}

public struct TypedGenericInstantiationPlanTable
{
    internal dynamic u32[0 max] GenericUseSiteIndices;
    internal dynamic u32[0 max] OwnerDeclarationSymbolIndices;
    internal dynamic u32[0 max] OwnerMemberSymbolIndices;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic TypedGenericInstantiationTargetKind TargetKinds;
    internal dynamic u32[0 max] TargetDeclarationSymbolIndices;
    internal dynamic u32[0 max] TargetMemberSymbolIndices;
    internal dynamic u32[0 max] TargetNameTokens;
    internal dynamic u32[0 max] OpenTokens;
    internal dynamic u32[0 max] CloseTokens;
    internal dynamic u32[0 max] ArgumentStartSlots;
    internal dynamic u32[0 max] ArgumentCounts;
    internal dynamic u32[0 max] TypeArgumentCounts;
    internal dynamic u32[0 max] ComptimeArgumentCounts;
    internal dynamic u32[0 max] ExpectedTypeParameterCounts;
    internal dynamic u32[0 max] ExpectedComptimeParameterCounts;
    internal dynamic u32[0 max] OpenGenericArgumentCounts;
    internal dynamic u32[0 max] UnresolvedArgumentCounts;
    internal dynamic u32[0 max] Flags;
    internal dynamic GenericUseSiteArgumentKind ArgumentKinds;
    internal dynamic u32[0 max] ArgumentStartTokens;
    internal dynamic u32[0 max] ArgumentEndTokens;
    internal dynamic u32[0 max] ArgumentTypeHeadTokens;
    internal dynamic u32[0 max] ArgumentTypePrimaryTokens;
    internal dynamic u32[0 max] ArgumentDeclarationSymbolIndices;
    internal dynamic u32[0 max] ArgumentGenericParameterSymbolIndices;
    internal dynamic u32[0 max] ArgumentFlags;

    TypedGenericInstantiationPlanTable()
    {
        self.GenericUseSiteIndices = new();
        self.OwnerDeclarationSymbolIndices = new();
        self.OwnerMemberSymbolIndices = new();
        self.OwnerNameTokens = new();
        self.TargetKinds = new();
        self.TargetDeclarationSymbolIndices = new();
        self.TargetMemberSymbolIndices = new();
        self.TargetNameTokens = new();
        self.OpenTokens = new();
        self.CloseTokens = new();
        self.ArgumentStartSlots = new();
        self.ArgumentCounts = new();
        self.TypeArgumentCounts = new();
        self.ComptimeArgumentCounts = new();
        self.ExpectedTypeParameterCounts = new();
        self.ExpectedComptimeParameterCounts = new();
        self.OpenGenericArgumentCounts = new();
        self.UnresolvedArgumentCounts = new();
        self.Flags = new();
        self.ArgumentKinds = new();
        self.ArgumentStartTokens = new();
        self.ArgumentEndTokens = new();
        self.ArgumentTypeHeadTokens = new();
        self.ArgumentTypePrimaryTokens = new();
        self.ArgumentDeclarationSymbolIndices = new();
        self.ArgumentGenericParameterSymbolIndices = new();
        self.ArgumentFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedGenericInstantiationPlanTable self)
    {
        return self.TargetKinds.Length;
    }

    public law u32[0 max] GenericUseSiteIndexPlusOneAt(borrow TypedGenericInstantiationPlanTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.GenericUseSiteIndices.Length)
        {
            value = self.GenericUseSiteIndices[index];
        }

        return value;
    }

