    public law GenericUseSiteArgumentKind ArgumentKindAt(borrow TypedGenericInstantiationPlanTable self, u64[0 2 ** 63 - 1] plan, u32[0 max] arg)
    {
        stack mut GenericUseSiteArgumentKind kind = GenericUseSiteArgumentKind.Type;
        stack u64[0 2 ** 63 - 1] slot = self.ArgumentSlotOrInvalid(plan, arg);
        if (slot < self.ArgumentKinds.Length)
        {
            kind = self.ArgumentKinds[slot];
        }

        return kind;
    }

    public law u32[0 max] ArgumentStartTokenAt(borrow TypedGenericInstantiationPlanTable self, u64[0 2 ** 63 - 1] plan, u32[0 max] arg)
    {
        stack mut u32[0 max] token = 0;
        stack u64[0 2 ** 63 - 1] slot = self.ArgumentSlotOrInvalid(plan, arg);
        if (slot < self.ArgumentStartTokens.Length)
        {
            token = self.ArgumentStartTokens[slot];
        }

        return token;
    }

    public law u32[0 max] ArgumentEndTokenAt(borrow TypedGenericInstantiationPlanTable self, u64[0 2 ** 63 - 1] plan, u32[0 max] arg)
    {
        stack mut u32[0 max] token = 0;
        stack u64[0 2 ** 63 - 1] slot = self.ArgumentSlotOrInvalid(plan, arg);
