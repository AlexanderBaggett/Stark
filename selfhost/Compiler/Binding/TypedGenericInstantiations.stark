    public law bool TargetResolvedAt(borrow TypedGenericInstantiationPlanTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericInstantiationFlagTargetResolved());
    }

    public law bool TargetIsGenericAt(borrow TypedGenericInstantiationPlanTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericInstantiationFlagTargetGeneric());
    }

    public law bool ArityMatchesAt(borrow TypedGenericInstantiationPlanTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericInstantiationFlagArityMatches());
    }

    public law bool HasTypeArgumentsAt(borrow TypedGenericInstantiationPlanTable self, u64[0 2 ** 63 - 1] index)
