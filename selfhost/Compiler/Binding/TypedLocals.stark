import System.Memory
module Compiler.Binding.TypedLocals

public enum TypedLocalSymbolKind
{
    Parameter,
    Local,
    PatternBinding,
    Unknown,
}

public enum TypedLocalOwnerKind
{
    DeclarationFunction,
    MemberMethod,
    Unknown,
}

internal inline finite law u32[0 max] TypedLocalFlagMutable()
{
    return 1;
}

internal inline finite law u32[0 max] TypedLocalFlagBorrow()
{
    return 2;
}

internal inline finite law u32[0 max] TypedLocalFlagRetborrow()
{
    return 4;
}

internal inline finite law u32[0 max] TypedLocalFlagStoreborrow()
{
    return 8;
}

internal inline finite law u32[0 max] TypedLocalFlagOut()
{
    return 16;
}

internal inline finite law u32[0 max] TypedLocalFlagInit()
{
    return 32;
}

internal inline finite law u32[0 max] TypedLocalFlagRawPointer()
{
    return 64;
}

internal inline finite law u32[0 max] TypedLocalFlagRawMutablePointer()
{
    return 128;
}

internal inline finite law u32[0 max] TypedLocalFlagTailCallableType()
{
    return 256;
}

internal inline finite law u32[0 max] TypedLocalFlagDeadOnReturn()
{
    return 512;
}

internal inline finite law u32[0 max] TypedLocalFlagCallableTypeDeadOnReturn()
{
    return 1024;
}

internal inline finite law u32[0 max] TypedLocalFlagMemoryBacked()
{
    return 2048;
}

internal inline finite law u32[0 max] TypedLocalFlagConstQualified()
{
    return 4096;
}

internal inline finite law u32[0 max] TypedLocalFlagShared()
{
    return 8192;
}

internal inline finite law u32[0 max] TypedLocalFlagFrozen()
{
    return 16384;
}

internal inline finite law u32[0 max] TypedLocalFlagDynamic()
{
    return 32768;
}

public struct TypedLocalSymbolTable
{
    internal dynamic u32[0 max] OwnerDeclarationSymbolIndices;
    internal dynamic u32[0 max] OwnerMemberSymbolIndices;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic TypedLocalOwnerKind OwnerKinds;
    internal dynamic TypedLocalSymbolKind Kinds;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] EndTokens;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic TypedDeclarationStorageKind StorageKinds;
    internal dynamic u32[0 max] ParamOrdinals;
    internal dynamic u32[0 max] StatementIndices;
    internal dynamic u32[0 max] Depths;
    internal dynamic u32[0 max] ScopeIds;
    internal dynamic u32[0 max] Flags;

    TypedLocalSymbolTable()
    {
        self.OwnerDeclarationSymbolIndices = new();
        self.OwnerMemberSymbolIndices = new();
        self.OwnerNameTokens = new();
        self.OwnerKinds = new();
        self.Kinds = new();
        self.NameTokens = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.StorageKinds = new();
        self.ParamOrdinals = new();
        self.StatementIndices = new();
        self.Depths = new();
        self.ScopeIds = new();
        self.Flags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedLocalSymbolTable self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] OwnerDeclarationSymbolIndexPlusOneAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.OwnerDeclarationSymbolIndices.Length)
        {
            value = self.OwnerDeclarationSymbolIndices[index];
        }

        return value;
    }

    public law u32[0 max] OwnerMemberSymbolIndexPlusOneAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
