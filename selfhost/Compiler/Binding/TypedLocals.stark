    public law bool IsMutableAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedLocalFlagMutable());
    }

    public law bool IsBorrowAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedLocalFlagBorrow());
    }

    public law bool IsRetborrowAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedLocalFlagRetborrow());
    }

    public law bool IsStoreborrowAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedLocalFlagStoreborrow());
    }

    public law bool IsOutAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedLocalFlagOut());
    }

    public law bool IsInitAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedLocalFlagInit());
    }

