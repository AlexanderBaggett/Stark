    public law bool IsDeadOnReturnAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedLocalFlagDeadOnReturn());
    }

    public law bool HasCallableTypeDeadOnReturnAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
