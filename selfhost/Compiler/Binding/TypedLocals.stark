    public law u32[0 max] ParameterCount(borrow TypedLocalSymbolTable self)
    {
        return self.CountOfKind(TypedLocalSymbolKind.Parameter);
    }

    public law u32[0 max] LocalCount(borrow TypedLocalSymbolTable self)
    {
        return self.CountOfKind(TypedLocalSymbolKind.Local);
    }

    public law u32[0 max] PatternBindingCount(borrow TypedLocalSymbolTable self)
    {
        return self.CountOfKind(TypedLocalSymbolKind.PatternBinding);
    }

    internal law u32[0 max] CountOfKind(borrow TypedLocalSymbolTable self, TypedLocalSymbolKind kind)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.KindAt(index) == kind)
            {
                total = (u32[0 max])(total + 1);
            }
        }

        return total;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedLocalSymbolTable self,
        u32[0 max] ownerDeclarationSymbolIndexPlusOne,
        u32[0 max] ownerMemberSymbolIndexPlusOne,
        u32[0 max] ownerNameToken,
        TypedLocalOwnerKind ownerKind,
        TypedLocalSymbolKind kind,
        u32[0 max] nameToken,
        u32[0 max] startToken,
        u32[0 max] endToken,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        TypedDeclarationStorageKind storageKind,
        u32[0 max] paramOrdinal,
        u32[0 max] statementIndexPlusOne,
        u32[0 max] depth,
        u32[0 max] scopeId,
        u32[0 max] flags)
    {
        if (!self.OwnerDeclarationSymbolIndices.TryReserve(1)
            || !self.OwnerMemberSymbolIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.OwnerKinds.TryReserve(1)
            || !self.Kinds.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.StorageKinds.TryReserve(1)
            || !self.ParamOrdinals.TryReserve(1)
            || !self.StatementIndices.TryReserve(1)
            || !self.Depths.TryReserve(1)
            || !self.ScopeIds.TryReserve(1)
            || !self.Flags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.OwnerDeclarationSymbolIndices[self.OwnerDeclarationSymbolIndices.Length] = ownerDeclarationSymbolIndexPlusOne;
        init self.OwnerMemberSymbolIndices[self.OwnerMemberSymbolIndices.Length] = ownerMemberSymbolIndexPlusOne;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.OwnerKinds[self.OwnerKinds.Length] = ownerKind;
        init self.Kinds[self.Kinds.Length] = kind;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.StartTokens[self.StartTokens.Length] = startToken;
        init self.EndTokens[self.EndTokens.Length] = endToken;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.StorageKinds[self.StorageKinds.Length] = storageKind;
        init self.ParamOrdinals[self.ParamOrdinals.Length] = paramOrdinal;
        init self.StatementIndices[self.StatementIndices.Length] = statementIndexPlusOne;
        init self.Depths[self.Depths.Length] = depth;
        init self.ScopeIds[self.ScopeIds.Length] = scopeId;
        init self.Flags[self.Flags.Length] = flags;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal finite law bool TypedLocalTypeSpanHasTopLevelToken(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive, TokenKind target)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == target)
        {
            return true;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool TypedLocalIsContextualTailToken(borrow TokenStream stream, u32[0 max] token)
{
    return stream.ContextualKindAt((u64[0 2 ** 63 - 1])token) == ContextualKeywordKind.Tail;
}

internal finite law bool TypedLocalTokenCanStartCallableFunctionKind(TokenKind kind)
{
    return kind == TokenKind.Fn || kind == TokenKind.Finite || kind == TokenKind.Law;
}

internal finite law bool TypedLocalTypeSpanContainsTailCallableSignature(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (TypedLocalIsContextualTailToken(stream, scan)
            && TypedLocalTokenCanStartCallableFunctionKind(stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1))))
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool TypedLocalTypeSpanContainsDeadOnReturnContract(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (stream.ContextualKindAt((u64[0 2 ** 63 - 1])scan) == ContextualKeywordKind.DeadOnReturn)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool TypedLocalTypeSpanIsMemoryBacked(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    stack mut bool consumedIntegerRange = false;
    stack mut TokenKind previousTopLevel = TokenKind.EndOfFile;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0)
        {
            if (kind == TokenKind.Borrow || kind == TokenKind.Retborrow
                || kind == TokenKind.Storeborrow || kind == TokenKind.Out
                || kind == TokenKind.Init || kind == TokenKind.Rawptr
                || kind == TokenKind.Rawmutptr || kind == TokenKind.AsciiView
                || kind == TokenKind.UnicodeView)
            {
                return true;
            }

            if (kind == TokenKind.LBrack)
            {
                if (stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.RBrack)
                {
                    return true;
                }

                if (previousTopLevel == TokenKind.IntegerType && !consumedIntegerRange)
                {
                    consumedIntegerRange = true;
                }
            }
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        if (depth == 0 && kind != TokenKind.LBrack && kind != TokenKind.RBrack)
        {
            previousTopLevel = kind;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law u32[0 max] TypedLocalFlagsForTypeSpan(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] flags = 0;
    if (start == 0 || start >= endExclusive)
    {
        return flags;
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Mut))
    {
        flags = flags | TypedLocalFlagMutable();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Borrow))
    {
        flags = flags | TypedLocalFlagBorrow();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Retborrow))
    {
        flags = flags | TypedLocalFlagRetborrow();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Storeborrow))
    {
        flags = flags | TypedLocalFlagStoreborrow();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Out))
    {
        flags = flags | TypedLocalFlagOut();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Init))
    {
        flags = flags | TypedLocalFlagInit();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Rawptr)
        || TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Rawmutptr))
    {
        flags = flags | TypedLocalFlagRawPointer();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Rawmutptr))
    {
        flags = flags | TypedLocalFlagRawMutablePointer();
    }

    if (TypedLocalTypeSpanContainsTailCallableSignature(stream, start, endExclusive))
    {
        flags = flags | TypedLocalFlagTailCallableType();
    }

    if (TypedLocalTypeSpanContainsDeadOnReturnContract(stream, start, endExclusive))
    {
        flags = flags | TypedLocalFlagCallableTypeDeadOnReturn();
    }

    if (TypedLocalTypeSpanIsMemoryBacked(stream, start, endExclusive))
    {
        flags = flags | TypedLocalFlagMemoryBacked();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Const))
    {
        flags = flags | TypedLocalFlagConstQualified();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Shared))
    {
        flags = flags | TypedLocalFlagShared();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Frozen))
    {
        flags = flags | TypedLocalFlagFrozen();
    }

    if (TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Dynamic))
    {
        flags = flags | TypedLocalFlagDynamic();
    }

    return flags;
}

internal fn bool TypedLocalSignatureParamHasDeadOnReturnContract(
    ascii source,
    borrow TokenStream stream,
    borrow FunctionSignature signature,
    u64[0 2 ** 63 - 1] paramIndex)
{
    stack u32[0 max] paramName = signature.ParamNameAt(paramIndex);
    stack u64[0 2 ** 63 - 1] contractCount = signature.DeadOnReturnParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < contractCount; index += 1)
    {
        if (BindingTokenTextEqualsToken(source, stream, paramName, signature.DeadOnReturnParamNameAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal finite law TypedDeclarationStorageKind TypedLocalStorageKind(borrow TokenStream stream, u32[0 max] startToken)
{
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])startToken);
    switch (kind)
    {
        case TokenKind.Const:
            return TypedDeclarationStorageKind.Const;
        case TokenKind.Static:
            return TypedDeclarationStorageKind.Static;
        case TokenKind.Heap:
            return TypedDeclarationStorageKind.Heap;
        case TokenKind.Stack:
            return TypedDeclarationStorageKind.Stack;
        case TokenKind.Register:
            return TypedDeclarationStorageKind.Register;
        case TokenKind.Arena:
            return TypedDeclarationStorageKind.Arena;
        default:
            return TypedDeclarationStorageKind.None;
    }
}

internal finite law TypedLocalSymbolKind TypedLocalKindForStatement(StatementKind kind)
{
    if (kind == StatementKind.PatternBinding)
    {
        return TypedLocalSymbolKind.PatternBinding;
    }

    if (kind == StatementKind.Local)
    {
        return TypedLocalSymbolKind.Local;
    }

    return TypedLocalSymbolKind.Unknown;
}

internal fn System.Memory.MemoryStatus AppendTypedParametersForSignature(
    mut borrow TypedLocalSymbolTable symbols,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerDeclarationSymbolIndexPlusOne,
    u32[0 max] ownerMemberSymbolIndexPlusOne,
    u32[0 max] ownerNameToken,
    TypedLocalOwnerKind ownerKind,
    borrow FunctionSignature signature)
{
    stack u64[0 2 ** 63 - 1] count = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack u32[0 max] nameToken = signature.ParamNameAt(index);
        if (nameToken != 0)
        {
            stack u32[0 max] startToken = signature.ParamStartTokenAt(index);
            stack u32[0 max] typeEndToken = signature.ParamTypeEndTokenAt(index);
            stack mut u32[0 max] flags = TypedLocalFlagsForTypeSpan(stream, startToken, typeEndToken);
            if (signature.ParamTypeTailCallable(index))
            {
                flags = flags | TypedLocalFlagTailCallableType();
            }

            if (signature.ParamTypeDeadOnReturnParamCount(index) > 0)
            {
                flags = flags | TypedLocalFlagCallableTypeDeadOnReturn();
            }

            if (TypedLocalSignatureParamHasDeadOnReturnContract(source, stream, signature, index))
            {
                flags = flags | TypedLocalFlagDeadOnReturn();
            }

            switch (symbols.Append(
                ownerDeclarationSymbolIndexPlusOne,
                ownerMemberSymbolIndexPlusOne,
                ownerNameToken,
                ownerKind,
                TypedLocalSymbolKind.Parameter,
                nameToken,
                startToken,
                signature.ParamEndTokenAt(index),
                signature.ParamTypeAt(index),
                signature.ParamTypeTokenAt(index),
                signature.ParamTypeStartTokenAt(index),
                typeEndToken,
                TypedDeclarationStorageKind.None,
                (u32[0 max])index,
                0,
                0,
                0,
                flags))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedLocalsForBody(
    mut borrow TypedLocalSymbolTable symbols,
    borrow TokenStream stream,
    u32[0 max] ownerDeclarationSymbolIndexPlusOne,
    u32[0 max] ownerMemberSymbolIndexPlusOne,
    u32[0 max] ownerNameToken,
    TypedLocalOwnerKind ownerKind,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        stack TypedLocalSymbolKind kind = TypedLocalKindForStatement(item.Kind);
        if (kind != TypedLocalSymbolKind.Unknown && item.NameToken != 0)
        {
            stack mut u32[0 max] flags = 0;
            if (item.TypeStartToken != 0 && item.TypeEndToken != 0)
            {
                flags = TypedLocalFlagsForTypeSpan(stream, item.TypeStartToken, item.TypeEndToken);
            }

            switch (symbols.Append(
                ownerDeclarationSymbolIndexPlusOne,
                ownerMemberSymbolIndexPlusOne,
                ownerNameToken,
                ownerKind,
                kind,
                item.NameToken,
                item.StartToken,
                item.EndToken,
                item.TypeHead,
                item.TypeToken,
                item.TypeStartToken,
                item.TypeEndToken,
                TypedLocalStorageKind(stream, item.StartToken),
                0,
                (u32[0 max])(index + 1),
                body.DepthAt(index),
                body.ScopeIdAt(index),
                flags))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedLocalsForFunction(
    mut borrow TypedLocalSymbolTable symbols,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerDeclarationSymbolIndexPlusOne,
    u32[0 max] ownerMemberSymbolIndexPlusOne,
    u32[0 max] fnKeyword,
    TypedLocalOwnerKind ownerKind)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack u32[0 max] ownerNameToken = signature.Name();
    switch (AppendTypedParametersForSignature(
        symbols,
        source,
        stream,
        ownerDeclarationSymbolIndexPlusOne,
        ownerMemberSymbolIndexPlusOne,
        ownerNameToken,
        ownerKind,
        signature))
    {
        case System.Memory.MemoryStatus.Err(var parameterError):
            return System.Memory.MemoryStatus.Err(parameterError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    return AppendTypedLocalsForBody(
        symbols,
        stream,
        ownerDeclarationSymbolIndexPlusOne,
        ownerMemberSymbolIndexPlusOne,
        ownerNameToken,
        ownerKind,
        body);
}

public fn BindResult<TypedLocalSymbolTable> BuildTypedLocalAndParameterSymbols(
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    borrow TypedMemberSymbolTable members)
{
    stack mut TypedLocalSymbolTable symbols = new();
    stack u64[0 2 ** 63 - 1] declarationCount = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < declarationCount; index += 1)
    {
        if (declarations.ClassAt(index) == TypedDeclarationSymbolClass.Function)
        {
            switch (AppendTypedLocalsForFunction(
                symbols,
                source,
                stream,
                (u32[0 max])(index + 1),
                0,
                declarations.KeywordTokenAt(index),
                TypedLocalOwnerKind.DeclarationFunction))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return BindResult<TypedLocalSymbolTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack u64[0 2 ** 63 - 1] memberCount = members.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < memberCount; index += 1)
    {
        if (members.KindAt(index) == TypedMemberSymbolKind.Method)
        {
            switch (AppendTypedLocalsForFunction(
                symbols,
                source,
                stream,
                members.OwnerDeclarationSymbolIndexPlusOneAt(index),
                (u32[0 max])(index + 1),
                members.KeywordTokenAt(index),
                TypedLocalOwnerKind.MemberMethod))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return BindResult<TypedLocalSymbolTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return BindResult<TypedLocalSymbolTable>.Ok(symbols);
}
