internal fn System.Memory.MemoryStatus AppendBoolText(mut borrow OwnedAscii writer, bool value)
{
    if (value)
    {
        return writer.AppendAscii("true");
    }

    return writer.AppendAscii("false");
}

internal fn System.Memory.MemoryStatus AppendU32Text(mut borrow OwnedAscii writer, u32[0 max] value)
{
    return writer.AppendU64((u64[0 max])value);
}

internal fn System.Memory.MemoryStatus AppendU64Text(
    mut borrow OwnedAscii writer,
    u64[0 2 ** 63 - 1] value)
{
    return writer.AppendU64((u64[0 max])value);
}

internal fn System.Memory.MemoryStatus AppendU64MaxText(mut borrow OwnedAscii writer, u64[0 max] value)
{
    return writer.AppendU64(value);
}

internal fn System.Memory.MemoryStatus AppendI64Text(mut borrow OwnedAscii writer, i64[min max] value)
{
    return writer.AppendI64(value);
}

internal fn System.Memory.MemoryStatus AppendOptionalTokenText(
    mut borrow OwnedAscii writer,
    ascii label,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] token)
{
    try writer.AppendAscii(label);
    try AppendU32Text(writer, token);
    if (token != 0)
    {
        try writer.AppendAscii(" text=");
        try writer.AppendAscii(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token));
    }

    return System.Memory.MemoryStatus.Ok;
}

