        try writer.AppendAscii(" generic-head=");
        try AppendBoolText(writer, signatures.TypeHeadIsGenericParameterAt(slot));
        try writer.AppendAscii("\n");
        slot += 1;
    }

    return System.Memory.MemoryStatus.Ok;
