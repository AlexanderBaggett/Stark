            writer,
            source,
            stream,
            signatures.TypeKindAt(slot),
            signatures.TypeHeadTokenAt(slot),
            signatures.TypePrimaryTokenAt(slot),
            signatures.TypeStartTokenAt(slot),
            signatures.TypeEndTokenAt(slot),
            signatures.RangeStartTokenAt(slot),
            signatures.RangeEndTokenAt(slot),
            signatures.ElementCountStartTokenAt(slot),
            signatures.ElementCountEndTokenAt(slot),
            signatures.BitWidthAt(slot),
            signatures.TypeArgumentCountAt(slot),
            signatures.ComptimeArgumentCountAt(slot),
            signatures.TypeFlagsAt(slot));
        try writer.AppendAscii(" signed=");
        try AppendBoolText(writer, signatures.IsIntegerSignedAt(slot));
        try writer.AppendAscii(" unsigned=");
        try AppendBoolText(writer, signatures.IsIntegerUnsignedAt(slot));
        try writer.AppendAscii(" ranged=");
        try AppendBoolText(writer, signatures.HasIntegerRangeAt(slot));
        try writer.AppendAscii(" borrow=");
        try AppendBoolText(writer, signatures.IsBorrowAt(slot));
        try writer.AppendAscii(" out=");
        try AppendBoolText(writer, signatures.IsOutAt(slot));
        try writer.AppendAscii(" rawmut=");
        try AppendBoolText(writer, signatures.IsRawMutablePointerAt(slot));
        try writer.AppendAscii(" counted=");
        try AppendBoolText(writer, signatures.HasElementCountExpressionAt(slot));
        try writer.AppendAscii(" tail=");
