        try writer.AppendAscii(": ");
        try writer.AppendAscii(SyntaxDiagnosticKindName(syntax.DiagnosticKindAt(index)));
        try writer.AppendAscii(" token=");
        try AppendU32Text(writer, syntax.DiagnosticTokenAt(index));
        try writer.AppendAscii(" line=");
        try AppendU32Text(writer, syntax.DiagnosticLineAt(index));
        try writer.AppendAscii(" column=");
        try AppendU32Text(writer, syntax.DiagnosticColumnAt(index));
        try writer.AppendAscii("\n");
        index += 1;
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus AppendCompilationUnitSyntaxArtifact(
    mut borrow OwnedAscii writer,
    ascii source,
    borrow CompilationUnitSyntax syntax)
{
    try writer.AppendAscii("syntax compilation-unit\n");
    try writer.AppendAscii("  succeeded: ");
    try AppendBoolText(writer, syntax.Succeeded());
    try writer.AppendAscii("\n  tokens: ");
    try AppendU64Text(writer, syntax.TokenCount());
    try writer.AppendAscii("\n  headers: ");
    try AppendU64Text(writer, syntax.HeaderCount());
    try writer.AppendAscii("\n");

    stack mut u64[0 2 ** 63 - 1] headerIndex = 0;
    while willexit (headerIndex < syntax.HeaderCount())
    {
        stack HeaderItem item = syntax.HeaderItemAt(headerIndex);
        try writer.AppendAscii("    ");
        try AppendU64Text(writer, headerIndex);
        try writer.AppendAscii(": ");
        try writer.AppendAscii(SyntaxKindName(item.Kind));
        try writer.AppendAscii(" ");
        try AppendHeaderName(writer, source, syntax, item);
        try writer.AppendAscii(" start=");
        try AppendU32Text(writer, item.StartToken);
        try writer.AppendAscii(" keyword=");
        try AppendU32Text(writer, item.KeywordToken);
        try writer.AppendAscii(" name-start=");
        try AppendU32Text(writer, item.NameStart);
        try writer.AppendAscii(" name-tokens=");
        try AppendU32Text(writer, item.NameTokenCount);
        try writer.AppendAscii(" segments=");
        try AppendU32Text(writer, item.NameSegments);
        try writer.AppendAscii(" exported=");
        try AppendBoolText(writer, item.IsExported);
        try writer.AppendAscii("\n");
        headerIndex += 1;
    }

    try writer.AppendAscii("  declarations: ");
    try AppendU64Text(writer, syntax.DeclarationCount());
    try writer.AppendAscii("\n");

    stack mut u64[0 2 ** 63 - 1] declarationIndex = 0;
    while willexit (declarationIndex < syntax.DeclarationCount())
    {
        stack DeclItem item = syntax.DeclarationAt(declarationIndex);
        try writer.AppendAscii("    ");
        try AppendU64Text(writer, declarationIndex);
        try writer.AppendAscii(": ");
        try writer.AppendAscii(DeclarationKindName(item.Kind));
        try writer.AppendAscii(" name=");
        try writer.AppendAscii(syntax.TokenTextAt(source, (u64[0 2 ** 63 - 1])item.NameToken));
        try writer.AppendAscii(" keyword=");
        try AppendU32Text(writer, item.KeywordToken);
        try writer.AppendAscii(" start=");
        try AppendU32Text(writer, item.StartToken);
        try writer.AppendAscii(" end=");
        try AppendU32Text(writer, item.EndToken);
        try writer.AppendAscii(" tail=");
        try AppendBoolText(writer, item.IsTailCallable);
        try writer.AppendAscii("\n");
        declarationIndex += 1;
    }

    return AppendCompilationUnitDiagnostics(writer, syntax);
}

