internal fn System.Memory.MemoryStatus AppendHeaderName(
    mut borrow OwnedAscii writer,
    ascii source,
    borrow CompilationUnitSyntax syntax,
    HeaderItem item)
{
    stack mut u32[0 max] offset = 0;
    while willexit (offset < item.NameTokenCount)
    {
        try writer.AppendAscii(syntax.TokenTextAt(source, (u64[0 2 ** 63 - 1])(item.NameStart + offset)));
        offset += 1;
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendCompilationUnitDiagnostics(
    mut borrow OwnedAscii writer,
    borrow CompilationUnitSyntax syntax)
{
    try writer.AppendAscii("  diagnostics: ");
