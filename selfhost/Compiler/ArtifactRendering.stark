public fn System.Memory.MemoryStatus AppendMirInstructionArtifact(
    mut borrow OwnedAscii writer,
    borrow IrTable<MirInstruction> instructions)
{
    try writer.AppendAscii("mir instructions\n");
    try writer.AppendAscii("  instructions: ");
    try AppendU64Text(writer, instructions.Count());
    try writer.AppendAscii("\n");

    stack mut u32[0 max] index = 1;
    while willexit ((u64[0 2 ** 63 - 1])index <= instructions.Count())
    {
        stack MirInstruction instruction = instructions.Get(index);
        try writer.AppendAscii("    ");
        try AppendU32Text(writer, index);
        try writer.AppendAscii(": ");
        try writer.AppendAscii(MirOpName(instruction.Opcode()));
        try writer.AppendAscii(" type=");
        try writer.AppendAscii(MirTypeName(instruction.ResultType()));
        try writer.AppendAscii(" a=");
        try AppendU32Text(writer, instruction.OperandAIndex());
        try writer.AppendAscii(" b=");
        try AppendU32Text(writer, instruction.OperandBIndex());
        try writer.AppendAscii(" c=");
        try AppendU32Text(writer, instruction.OperandCIndex());
        try writer.AppendAscii(" d=");
        try AppendU32Text(writer, instruction.OperandDIndex());
        try writer.AppendAscii(" imm=");
        try AppendI64Text(writer, instruction.Immediate());
        try writer.AppendAscii("\n");
        index += 1;
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus AppendMirBlockArtifact(
    mut borrow OwnedAscii writer,
    borrow IrTable<MirBlock> blocks)
{
    try writer.AppendAscii("mir blocks\n");
    try writer.AppendAscii("  blocks: ");
    try AppendU64Text(writer, blocks.Count());
    try writer.AppendAscii("\n");

    stack mut u32[0 max] index = 1;
    while willexit ((u64[0 2 ** 63 - 1])index <= blocks.Count())
    {
        stack MirBlock block = blocks.Get(index);
        try writer.AppendAscii("    ");
        try AppendU32Text(writer, index);
        try writer.AppendAscii(": ");
        try writer.AppendAscii(MirTermKindName(block.Terminator()));
        try writer.AppendAscii(" slot0=");
        try AppendU32Text(writer, block.Slot0Index());
        try writer.AppendAscii(" slot1=");
        try AppendU32Text(writer, block.Slot1Index());
        try writer.AppendAscii(" slot2=");
        try AppendU32Text(writer, block.Slot2Index());
        try writer.AppendAscii("\n");
        index += 1;
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus AppendMirFunctionArtifact(
    mut borrow OwnedAscii writer,
    borrow IrTable<MirFunction> functions)
{
    try writer.AppendAscii("mir functions\n");
    try writer.AppendAscii("  functions: ");
    try AppendU64Text(writer, functions.Count());
    try writer.AppendAscii("\n");

    stack mut u32[0 max] index = 1;
    while willexit ((u64[0 2 ** 63 - 1])index <= functions.Count())
    {
        stack MirFunction function = functions.Get(index);
        try writer.AppendAscii("    ");
        try AppendU32Text(writer, index);
        try writer.AppendAscii(": entry=");
        try AppendU32Text(writer, function.EntryIndex());
        try writer.AppendAscii(" blocks=");
        try AppendU32Text(writer, function.FirstBlockIndex());
        try writer.AppendAscii("+");
        try AppendU32Text(writer, function.OwnedBlockCount());
        try writer.AppendAscii(" instructions=");
        try AppendU32Text(writer, function.FirstInstrIndex());
        try writer.AppendAscii("+");
        try AppendU32Text(writer, function.OwnedInstrCount());
        try writer.AppendAscii("\n");
        index += 1;
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus AppendMirArtifact(
    mut borrow OwnedAscii writer,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> functions)
{
    try AppendMirInstructionArtifact(writer, instructions);
    try AppendMirBlockArtifact(writer, blocks);
    return AppendMirFunctionArtifact(writer, functions);
}

public fn System.Memory.MemoryStatus AppendSsaValueFactsArtifact(
    mut borrow OwnedAscii writer,
    borrow IrTable<ValueFacts> facts)
{
    try writer.AppendAscii("ssa value-facts\n");
    try writer.AppendAscii("  values: ");
    try AppendU64Text(writer, facts.Count());
    try writer.AppendAscii("\n");

    stack mut u32[0 max] index = 1;
    while willexit ((u64[0 2 ** 63 - 1])index <= facts.Count())
    {
        stack ValueFacts row = facts.Get(index);
        try writer.AppendAscii("    ");
        try AppendU32Text(writer, index);
        try writer.AppendAscii(": align-present=");
        try AppendBoolText(writer, row.HasAlignment());
        try writer.AppendAscii(" align=");
        try AppendU32Text(writer, row.AlignmentBytes());
        try writer.AppendAscii(" abi-present=");
        try AppendBoolText(writer, row.HasCallingAbi());
        try writer.AppendAscii(" abi=");
        try writer.AppendAscii(AbiKindName(row.CallingAbi()));
        try writer.AppendAscii(" noalias=");
        try AppendBoolText(writer, row.HasNoAlias());
        try writer.AppendAscii(" volatile=");
        try AppendBoolText(writer, row.Volatile());
        try writer.AppendAscii(" range-present=");
        try AppendBoolText(writer, row.HasIntegerRange());
        try writer.AppendAscii(" range=");
        try AppendI64Text(writer, row.IntegerRangeLower());
        try writer.AppendAscii("..");
        try AppendI64Text(writer, row.IntegerRangeUpperExclusive());
        try writer.AppendAscii(" text-present=");
        try AppendBoolText(writer, row.HasTextConstant());
        try writer.AppendAscii(" text-row=");
        try AppendU32Text(writer, row.TextConstantRowIndex());
        try writer.AppendAscii(" text-start=");
        try AppendU32Text(writer, row.TextConstantPayloadStart());
        try writer.AppendAscii(" text-bytes=");
        try AppendU32Text(writer, row.TextConstantPayloadByteLength());
        try writer.AppendAscii(" text-codepoints=");
        try AppendU32Text(writer, row.TextConstantCodePointLength());
        try writer.AppendAscii(" text-encoding=");
        try AppendU32Text(writer, row.TextConstantStorageEncodingCode());
        try writer.AppendAscii("\n");
        index += 1;
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus AppendLlvmModuleArtifact(
    mut borrow OwnedAscii writer,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> functions,
    borrow IrTable<MirGlobal> globals)
{
    try writer.AppendAscii("llvm module\n");
    return EmitLlvmModuleWithGlobals(instructions, blocks, functions, globals, writer);
}

public fn System.Memory.MemoryStatus AppendLlvmModuleArtifactWithEnumLayouts(
    mut borrow OwnedAscii writer,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> functions,
    borrow IrTable<MirGlobal> globals,
    borrow IrTable<MirEnumLayoutFact> enumLayoutFacts)
{
    try writer.AppendAscii("llvm module\n");
    return EmitLlvmModuleWithGlobalsAndEnumLayouts(instructions, blocks, functions, globals, enumLayoutFacts, writer);
}

public fn System.Memory.MemoryStatus AppendPackageImageArtifact(
    mut borrow OwnedAscii writer,
    borrow IrTable<u8[0 max]> image)
{
    try writer.AppendAscii("package image\n");
    return InspectPackageImage(image, writer);
}

internal fn System.Memory.MemoryStatus AppendCommonTypeTokenFacts(
    mut borrow OwnedAscii writer,
    ascii source,
    borrow TokenStream stream,
    TypedSignatureTypeKind kind,
    u32[0 max] headToken,
    u32[0 max] primaryToken,
    u32[0 max] startToken,
    u32[0 max] endToken,
    u32[0 max] rangeStartToken,
    u32[0 max] rangeEndToken,
    u32[0 max] elementCountStartToken,
    u32[0 max] elementCountEndToken,
    u32[0 max] bitWidth,
    u32[0 max] typeArgumentCount,
    u32[0 max] comptimeArgumentCount,
    u32[0 max] flags)
{
    try writer.AppendAscii(" type=");
    try writer.AppendAscii(TypedSignatureTypeKindName(kind));
    try AppendOptionalTokenText(writer, " head=", source, stream, headToken);
    try AppendOptionalTokenText(writer, " primary=", source, stream, primaryToken);
    try writer.AppendAscii(" span=");
    try AppendU32Text(writer, startToken);
    try writer.AppendAscii("..");
    try AppendU32Text(writer, endToken);
    try writer.AppendAscii(" range=");
    try AppendU32Text(writer, rangeStartToken);
    try writer.AppendAscii("..");
    try AppendU32Text(writer, rangeEndToken);
    try writer.AppendAscii(" elements=");
    try AppendU32Text(writer, elementCountStartToken);
    try writer.AppendAscii("..");
    try AppendU32Text(writer, elementCountEndToken);
    try writer.AppendAscii(" bits=");
    try AppendU32Text(writer, bitWidth);
    try writer.AppendAscii(" type-args=");
    try AppendU32Text(writer, typeArgumentCount);
    try writer.AppendAscii(" comptime-args=");
    try AppendU32Text(writer, comptimeArgumentCount);
    try writer.AppendAscii(" flags=");
    try AppendU32Text(writer, flags);
    return System.Memory.MemoryStatus.Ok;
}

