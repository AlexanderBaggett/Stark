public fn System.Memory.MemoryStatus AppendExpressionSyntaxArtifact(
    mut borrow OwnedAscii writer,
    ascii source,
    borrow ExpressionSyntax syntax)
{
    try writer.AppendAscii("syntax expression\n");
    try writer.AppendAscii("  succeeded: ");
    try AppendBoolText(writer, syntax.Succeeded());
    try writer.AppendAscii("\n  tokens: ");
    try AppendU64Text(writer, syntax.TokenCount());
    try writer.AppendAscii("\n  root: ");
    try AppendU32Text(writer, syntax.RootNode());
    try writer.AppendAscii("\n  nodes: ");
    try AppendU64Text(writer, syntax.NodeCount());
    try writer.AppendAscii("\n");

    stack mut u32[0 max] node = 1;
    while willexit ((u64[0 2 ** 63 - 1])node <= syntax.NodeCount())
    {
        stack u32[0 max] token = syntax.TokenAt(node);
        try writer.AppendAscii("    n");
        try AppendU32Text(writer, node);
        try writer.AppendAscii(": ");
        try writer.AppendAscii(ExprKindName(syntax.NodeKindAt(node)));
        try writer.AppendAscii(" token=");
        try AppendU32Text(writer, token);
        try writer.AppendAscii(" text=");
        try writer.AppendAscii(syntax.TokenTextAt(source, (u64[0 2 ** 63 - 1])token));
        try writer.AppendAscii(" left=");
        try AppendU32Text(writer, syntax.LeftAt(node));
        try writer.AppendAscii(" right=");
        try AppendU32Text(writer, syntax.RightAt(node));
        try writer.AppendAscii(" aux=");
        try AppendU32Text(writer, syntax.AuxAt(node));
        try writer.AppendAscii("\n");
        node += 1;
    }

    return AppendExpressionDiagnostics(writer, syntax);
}
