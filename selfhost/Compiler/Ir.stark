public struct IrFactCategoryDescriptor
{
    IrFactCategory CategoryValue;
    IrFactAttachPoint AttachPointValue;
    IrFactPhaseOwner PhaseOwnerValue;
    IrFactDurability DurabilityValue;
    IrFactProducer ProducerValue;
    IrFactConsumer ConsumerValue;
    IrFactValidationRule ValidationRuleValue;
    IrFactLoweringPolicy LoweringPolicyValue;

    IrFactCategoryDescriptor()
    {
        self.CategoryValue = IrFactCategory.Unknown;
        self.AttachPointValue = IrFactAttachPoint.Unknown;
        self.PhaseOwnerValue = IrFactPhaseOwner.Unknown;
        self.DurabilityValue = IrFactDurability.Unknown;
        self.ProducerValue = IrFactProducer.Unknown;
        self.ConsumerValue = IrFactConsumer.Unknown;
        self.ValidationRuleValue = IrFactValidationRule.Unknown;
        self.LoweringPolicyValue = IrFactLoweringPolicy.Unknown;
    }

    public inline finite law IrFactCategory Category(borrow IrFactCategoryDescriptor self)
    {
        return self.CategoryValue;
    }

    public inline finite law IrFactAttachPoint AttachPoint(borrow IrFactCategoryDescriptor self)
    {
        return self.AttachPointValue;
    }

    public inline finite law IrFactPhaseOwner PhaseOwner(borrow IrFactCategoryDescriptor self)
    {
        return self.PhaseOwnerValue;
    }

    public inline finite law IrFactDurability Durability(borrow IrFactCategoryDescriptor self)
    {
        return self.DurabilityValue;
    }

    public inline finite law IrFactProducer Producer(borrow IrFactCategoryDescriptor self)
    {
        return self.ProducerValue;
    }

    public inline finite law IrFactConsumer Consumer(borrow IrFactCategoryDescriptor self)
    {
        return self.ConsumerValue;
    }

    public inline finite law IrFactValidationRule ValidationRule(borrow IrFactCategoryDescriptor self)
    {
        return self.ValidationRuleValue;
    }

    public inline finite law IrFactLoweringPolicy LoweringPolicy(borrow IrFactCategoryDescriptor self)
    {
        return self.LoweringPolicyValue;
    }
}

internal finite law IrFactCategoryDescriptor MakeIrFactDescriptor(
    IrFactCategory category,
    IrFactAttachPoint attachPoint,
    IrFactPhaseOwner phaseOwner,
    IrFactDurability durability,
    IrFactProducer producer,
    IrFactConsumer consumer,
    IrFactValidationRule validationRule,
    IrFactLoweringPolicy loweringPolicy)
{
    stack mut IrFactCategoryDescriptor descriptor = new();
    descriptor.CategoryValue = category;
    descriptor.AttachPointValue = attachPoint;
    descriptor.PhaseOwnerValue = phaseOwner;
    descriptor.DurabilityValue = durability;
    descriptor.ProducerValue = producer;
    descriptor.ConsumerValue = consumer;
    descriptor.ValidationRuleValue = validationRule;
    descriptor.LoweringPolicyValue = loweringPolicy;
    return descriptor;
}

public inline finite law u32[0 max] IrConcreteFactCategoryCount()
{
    return 18;
}

public finite law IrFactCategory IrFactCategoryAt(u32[0 max] index)
{
    switch (index)
    {
        case 0: return IrFactCategory.ValueAlignment;
        case 1: return IrFactCategory.ValueAliasClass;
        case 2: return IrFactCategory.ValueNoAlias;
        case 3: return IrFactCategory.ValueVolatile;
        case 4: return IrFactCategory.ValueIntegerRange;
        case 5: return IrFactCategory.CallableAbi;
        case 6: return IrFactCategory.CAbiAggregateCarrier;
        case 7: return IrFactCategory.TypeLayout;
        case 8: return IrFactCategory.StructLayout;
        case 9: return IrFactCategory.EnumLayout;
        case 10: return IrFactCategory.FieldLayout;
        case 11: return IrFactCategory.OwnershipDrop;
        case 12: return IrFactCategory.AliasProofCarrier;
        case 13: return IrFactCategory.FunctionEffect;
        case 14: return IrFactCategory.PackageCompatibility;
        case 15: return IrFactCategory.DiagnosticSourceLocation;
        case 16: return IrFactCategory.ValueNullability;
        case 17: return IrFactCategory.ValueTextConstant;
        default: return IrFactCategory.Unknown;
    }
}

public inline finite law bool IrFactCategoryIsConcrete(IrFactCategory category)
{
    return category != IrFactCategory.Unknown;
}

public inline finite law bool IrFactDurabilityRequiresPackageSerialization(IrFactDurability durability)
{
    return durability == IrFactDurability.Durable;
}

public finite law bool IrFactCategoryRequiresPackageSerialization(IrFactCategory category)
{
    stack IrFactCategoryDescriptor descriptor = DescribeIrFactCategory(category);
    return IrFactDurabilityRequiresPackageSerialization(descriptor.Durability());
}

public finite law IrFactCategoryDescriptor DescribeIrFactCategory(IrFactCategory category)
{
    switch (category)
    {
        case IrFactCategory.ValueAlignment:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Value,
                IrFactPhaseOwner.Mir,
                IrFactDurability.Recomputable,
                IrFactProducer.TypeChecker,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.LayoutRequired,
                IrFactLoweringPolicy.Preserve);
        case IrFactCategory.ValueAliasClass:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Value,
                IrFactPhaseOwner.Ssa,
                IrFactDurability.Transient,
                IrFactProducer.SsaLowering,
                IrFactConsumer.SsaOptimizer,
                IrFactValidationRule.AliasProofRoot,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.ValueNoAlias:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Value,
                IrFactPhaseOwner.Ssa,
                IrFactDurability.Transient,
                IrFactProducer.BorrowValidator,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.AliasProofRoot,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.ValueVolatile:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Value,
                IrFactPhaseOwner.Backend,
                IrFactDurability.Transient,
                IrFactProducer.TypeChecker,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.ForbidDrop,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.ValueIntegerRange:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Value,
                IrFactPhaseOwner.Mir,
                IrFactDurability.Recomputable,
                IrFactProducer.TypeChecker,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.Recompute,
                IrFactLoweringPolicy.Preserve);
        case IrFactCategory.ValueNullability:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Value,
                IrFactPhaseOwner.Mir,
                IrFactDurability.Recomputable,
                IrFactProducer.TypeChecker,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.Recompute,
                IrFactLoweringPolicy.Preserve);
        case IrFactCategory.ValueTextConstant:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Value,
                IrFactPhaseOwner.Mir,
                IrFactDurability.Recomputable,
                IrFactProducer.MirLowering,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.Recompute,
                IrFactLoweringPolicy.Preserve);
        case IrFactCategory.CallableAbi:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Function,
                IrFactPhaseOwner.Backend,
                IrFactDurability.Durable,
                IrFactProducer.TypeChecker,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.PackageRoundTrip,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.CAbiAggregateCarrier:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Type,
                IrFactPhaseOwner.Backend,
                IrFactDurability.Durable,
                IrFactProducer.AbiLowering,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.LayoutRequired,
                IrFactLoweringPolicy.Translate);
        case IrFactCategory.TypeLayout:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Type,
                IrFactPhaseOwner.Backend,
                IrFactDurability.Durable,
                IrFactProducer.TypeChecker,
                IrFactConsumer.AbiLowering,
                IrFactValidationRule.LayoutRequired,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.StructLayout:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Type,
                IrFactPhaseOwner.Backend,
                IrFactDurability.Durable,
                IrFactProducer.TypeChecker,
                IrFactConsumer.PackageWriter,
                IrFactValidationRule.PackageRoundTrip,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.EnumLayout:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Type,
                IrFactPhaseOwner.Backend,
                IrFactDurability.Durable,
                IrFactProducer.TypeChecker,
                IrFactConsumer.PackageWriter,
                IrFactValidationRule.PackageRoundTrip,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.FieldLayout:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Symbol,
                IrFactPhaseOwner.Backend,
                IrFactDurability.Durable,
                IrFactProducer.TypeChecker,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.LayoutRequired,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.OwnershipDrop:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Value,
                IrFactPhaseOwner.Mir,
                IrFactDurability.Transient,
                IrFactProducer.BorrowValidator,
                IrFactConsumer.DropLowering,
                IrFactValidationRule.ForbidDrop,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.AliasProofCarrier:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.AliasProof,
                IrFactPhaseOwner.Ssa,
                IrFactDurability.Transient,
                IrFactProducer.SsaLowering,
                IrFactConsumer.SsaOptimizer,
                IrFactValidationRule.AliasProofRoot,
                IrFactLoweringPolicy.Consume);
        case IrFactCategory.FunctionEffect:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Function,
                IrFactPhaseOwner.Mir,
                IrFactDurability.Durable,
                IrFactProducer.TypeChecker,
                IrFactConsumer.LlvmEmission,
                IrFactValidationRule.PackageRoundTrip,
                IrFactLoweringPolicy.Preserve);
        case IrFactCategory.PackageCompatibility:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Package,
                IrFactPhaseOwner.Package,
                IrFactDurability.Durable,
                IrFactProducer.PackageLoader,
                IrFactConsumer.PackageLoader,
                IrFactValidationRule.PackageRoundTrip,
                IrFactLoweringPolicy.ForbidDrop);
        case IrFactCategory.DiagnosticSourceLocation:
            return MakeIrFactDescriptor(
                category,
                IrFactAttachPoint.Diagnostic,
                IrFactPhaseOwner.Tooling,
                IrFactDurability.Transient,
                IrFactProducer.Parser,
                IrFactConsumer.Diagnostics,
                IrFactValidationRule.DiagnosticLocation,
                IrFactLoweringPolicy.DebugOnly);
        default:
            return new IrFactCategoryDescriptor();
    }
}

public enum IrFactValidationStatus
{
    Ok,
    UnknownCategory,
    StaleHandle,
    DroppedForbidDropFact,
    MissingAbiFact,
    MissingAliasFact,
    MissingLayoutFact,
    MissingDurablePackageFact,
    MissingRequiredFact,
}

public finite law ascii IrFactValidationStatusName(IrFactValidationStatus status)
{
    switch (status)
    {
        case IrFactValidationStatus.Ok:
            return "ok";
        case IrFactValidationStatus.UnknownCategory:
            return "unknown-category";
        case IrFactValidationStatus.StaleHandle:
            return "stale-handle";
        case IrFactValidationStatus.DroppedForbidDropFact:
            return "dropped-forbid-drop-fact";
        case IrFactValidationStatus.MissingAbiFact:
            return "missing-abi-fact";
        case IrFactValidationStatus.MissingAliasFact:
            return "missing-alias-fact";
        case IrFactValidationStatus.MissingLayoutFact:
            return "missing-layout-fact";
        case IrFactValidationStatus.MissingDurablePackageFact:
            return "missing-durable-package-fact";
        case IrFactValidationStatus.MissingRequiredFact:
            return "missing-required-fact";
    }
}

public inline finite law IrFactValidationStatus ValidateTypeHandle<T>(borrow IrTable<T> table, TypeId id)
{
    if (table.Contains(id.Index()))
    {
        return IrFactValidationStatus.Ok;
    }

    return IrFactValidationStatus.StaleHandle;
}

public inline finite law IrFactValidationStatus ValidateSymbolHandle<T>(borrow IrTable<T> table, SymbolId id)
{
    if (table.Contains(id.Index()))
    {
        return IrFactValidationStatus.Ok;
    }

    return IrFactValidationStatus.StaleHandle;
}

public inline finite law IrFactValidationStatus ValidateMirValueHandle<T>(borrow IrTable<T> table, MirValueId id)
{
    if (table.Contains(id.Index()))
    {
        return IrFactValidationStatus.Ok;
    }

    return IrFactValidationStatus.StaleHandle;
}

public inline finite law IrFactValidationStatus ValidateMirBlockHandle<T>(borrow IrTable<T> table, MirBlockId id)
{
    if (table.Contains(id.Index()))
    {
        return IrFactValidationStatus.Ok;
    }

    return IrFactValidationStatus.StaleHandle;
}

public inline finite law IrFactValidationStatus ValidateMirFunctionHandle<T>(borrow IrTable<T> table, MirFuncId id)
{
    if (table.Contains(id.Index()))
    {
        return IrFactValidationStatus.Ok;
    }

    return IrFactValidationStatus.StaleHandle;
}

public inline finite law IrFactValidationStatus ValidateSsaValueHandle<T>(borrow IrTable<T> table, SsaValueId id)
{
    if (table.Contains(id.Index()))
    {
        return IrFactValidationStatus.Ok;
    }

    return IrFactValidationStatus.StaleHandle;
}

public inline finite law IrFactValidationStatus ValidatePackageHandle<T>(borrow IrTable<T> table, PackageId id)
{
    if (table.Contains(id.Index()))
    {
        return IrFactValidationStatus.Ok;
    }

    return IrFactValidationStatus.StaleHandle;
}

public finite law bool IrFactCategoryIsAbiFact(IrFactCategory category)
{
    return category == IrFactCategory.CallableAbi
        || category == IrFactCategory.CAbiAggregateCarrier;
}

public finite law bool IrFactCategoryIsAliasFact(IrFactCategory category)
{
    return category == IrFactCategory.ValueAliasClass
        || category == IrFactCategory.ValueNoAlias
        || category == IrFactCategory.AliasProofCarrier;
}

public finite law bool IrFactCategoryIsLayoutFact(IrFactCategory category)
{
    return category == IrFactCategory.ValueAlignment
        || category == IrFactCategory.TypeLayout
        || category == IrFactCategory.StructLayout
        || category == IrFactCategory.EnumLayout
        || category == IrFactCategory.FieldLayout;
}

public finite law IrFactValidationStatus MissingFactStatusForCategory(IrFactCategory category)
{
    if (!IrFactCategoryIsConcrete(category))
    {
        return IrFactValidationStatus.UnknownCategory;
    }

    if (IrFactCategoryIsAbiFact(category))
    {
        return IrFactValidationStatus.MissingAbiFact;
    }

    if (IrFactCategoryIsAliasFact(category))
    {
        return IrFactValidationStatus.MissingAliasFact;
    }

    if (IrFactCategoryIsLayoutFact(category))
    {
        return IrFactValidationStatus.MissingLayoutFact;
    }

    stack IrFactCategoryDescriptor descriptor = DescribeIrFactCategory(category);
    if (descriptor.Durability() == IrFactDurability.Durable)
    {
        return IrFactValidationStatus.MissingDurablePackageFact;
    }

    if (descriptor.LoweringPolicy() == IrFactLoweringPolicy.ForbidDrop
        || descriptor.ValidationRule() == IrFactValidationRule.ForbidDrop)
    {
        return IrFactValidationStatus.DroppedForbidDropFact;
    }

    return IrFactValidationStatus.MissingRequiredFact;
}

public finite law IrFactValidationStatus ValidateRequiredFactCategory(IrFactCategory category, bool present)
{
    if (present)
    {
        return IrFactValidationStatus.Ok;
    }

    return MissingFactStatusForCategory(category);
}

public finite law bool ValueFactsContainCategory(borrow ValueFacts facts, IrFactCategory category)
{
    switch (category)
    {
        case IrFactCategory.ValueAlignment:
            return facts.HasAlignment();
        case IrFactCategory.ValueNoAlias:
            return facts.HasNoAlias();
        case IrFactCategory.ValueVolatile:
            return facts.Volatile();
        case IrFactCategory.ValueIntegerRange:
            return facts.HasIntegerRange();
        case IrFactCategory.ValueNullability:
            return facts.HasNullability();
        case IrFactCategory.ValueTextConstant:
            return facts.HasTextConstant();
        case IrFactCategory.CallableAbi:
            return facts.HasCallingAbi();
        default:
            return false;
    }
}

public fn IrFactValidationStatus ValidateMirValueFactAtBoundary<T>(
    borrow IrTable<T> valueDefinitions,
    borrow IrTable<ValueFacts> valueFacts,
    MirValueId value,
    IrFactCategory category)
{
    stack IrFactValidationStatus handleStatus = ValidateMirValueHandle<T>(valueDefinitions, value);
    if (handleStatus != IrFactValidationStatus.Ok)
    {
        return handleStatus;
    }

    if (!valueFacts.Contains(value.Index()))
    {
        return MissingFactStatusForCategory(category);
    }

    stack ValueFacts row = ValueFactsAtIndex(valueFacts, value.Index());
    return ValidateRequiredFactCategory(category, ValueFactsContainCategory(row, category));
}

public fn IrFactValidationStatus ValidateCallableAbiFactAtBoundary<T>(
    borrow IrTable<T> functionDefinitions,
    borrow IrTable<ValueFacts> callableFacts,
    MirFuncId function)
{
    stack IrFactValidationStatus handleStatus = ValidateMirFunctionHandle<T>(functionDefinitions, function);
    if (handleStatus != IrFactValidationStatus.Ok)
    {
        return handleStatus;
    }

    if (!callableFacts.Contains(function.Index()))
    {
        return IrFactValidationStatus.MissingAbiFact;
    }

    stack ValueFacts row = ValueFactsAtIndex(callableFacts, function.Index());
    return ValidateRequiredFactCategory(IrFactCategory.CallableAbi, row.HasCallingAbi());
}

public fn IrFactValidationStatus ValidateCAbiAggregateCarrierFactAtBoundary<T>(
    borrow IrTable<T> typeDefinitions,
    borrow IrTable<CAbiAggregateCarrierFacts> carrierFacts,
    TypeId type)
{
    stack IrFactValidationStatus handleStatus = ValidateTypeHandle<T>(typeDefinitions, type);
    if (handleStatus != IrFactValidationStatus.Ok)
    {
        return handleStatus;
    }

    if (!carrierFacts.Contains(type.Index()))
    {
        return IrFactValidationStatus.MissingAbiFact;
    }

    stack CAbiAggregateCarrierFacts row = CAbiAggregateCarrierFactsAtIndex(carrierFacts, type.Index());
    if (!row.Present())
    {
        return IrFactValidationStatus.MissingAbiFact;
    }

    return IrFactValidationStatus.Ok;
}

public finite law IrFactValidationStatus ValidateLayoutFactAtBoundary<TDefinition, TLayout>(
    borrow IrTable<TDefinition> definitions,
    borrow IrTable<TLayout> layoutFacts,
    TypeId type,
    IrFactCategory category)
{
    stack IrFactValidationStatus handleStatus = ValidateTypeHandle<TDefinition>(definitions, type);
    if (handleStatus != IrFactValidationStatus.Ok)
    {
        return handleStatus;
    }

    if (!IrFactCategoryIsLayoutFact(category))
    {
        return MissingFactStatusForCategory(category);
    }

    if (!layoutFacts.Contains(type.Index()))
    {
        return IrFactValidationStatus.MissingLayoutFact;
    }

    return IrFactValidationStatus.Ok;
}

public finite law IrFactValidationStatus ValidateDurablePackageFactAtBoundary(IrFactCategory category, bool serialized)
{
    if (!IrFactCategoryRequiresPackageSerialization(category))
    {
        return IrFactValidationStatus.Ok;
    }

    if (serialized)
    {
        return IrFactValidationStatus.Ok;
    }

    return IrFactValidationStatus.MissingDurablePackageFact;
}

// An inline-assembly metadata row id. These rows describe source `unsafe ffi asm`
// declarations after parsing/binding, independent of the parser's token stream.
public struct AsmFunctionId
{
    u32[0 max] Value;

    AsmFunctionId()
    {
        self.Value = 0;
    }

    public inline finite law u32[0 max] Index(borrow AsmFunctionId self)
    {
        return self.Value;
    }

    public inline finite law bool IsValid(borrow AsmFunctionId self)
    {
        return self.Value != 0;
    }

    public inline finite law bool Equals(borrow AsmFunctionId self, AsmFunctionId other)
    {
        return self.Value == other.Value;
    }
}

public fn AsmFunctionId AsmFunctionIdOf(u32[0 max] index)
{
    stack mut AsmFunctionId id = new();
    id.Value = index;
    return id;
}

// A byte range in `AsmMetadataTable.TextBytes`. Ranges are 0-based internally so
// they copy directly from slices and serialize without sentinel adjustment.
public struct AsmTextRange
{
    u32[0 max] StartByte;
    u32[0 max] ByteCount;

    AsmTextRange()
    {
        self.StartByte = 0;
        self.ByteCount = 0;
    }

    public inline finite law u32[0 max] Start(borrow AsmTextRange self)
    {
        return self.StartByte;
    }

    public inline finite law u32[0 max] Length(borrow AsmTextRange self)
    {
        return self.ByteCount;
    }

    public inline finite law bool IsEmpty(borrow AsmTextRange self)
    {
        return self.ByteCount == 0;
    }
}

public fn AsmTextRange AsmTextRangeOf(u32[0 max] start, u32[0 max] length)
{
    stack mut AsmTextRange range = new();
    range.StartByte = start;
    range.ByteCount = length;
    return range;
}

public struct AsmInputOperand
{
    AsmTextRange RegisterText;
    AsmTextRange ValueText;

    AsmInputOperand()
    {
        self.RegisterText = new();
        self.ValueText = new();
    }

    public inline finite law AsmTextRange Register(borrow AsmInputOperand self)
    {
        return self.RegisterText;
    }

    public inline finite law AsmTextRange Value(borrow AsmInputOperand self)
    {
        return self.ValueText;
    }
}

public struct AsmOutputOperand
{
    AsmTextRange RegisterText;
    AsmTextRange ValueText;
    bool ReturnBinding;

    AsmOutputOperand()
    {
        self.RegisterText = new();
        self.ValueText = new();
        self.ReturnBinding = false;
    }

    public inline finite law AsmTextRange Register(borrow AsmOutputOperand self)
    {
        return self.RegisterText;
    }

    public inline finite law AsmTextRange Value(borrow AsmOutputOperand self)
    {
        return self.ValueText;
    }

    public inline finite law bool BindsReturn(borrow AsmOutputOperand self)
    {
        return self.ReturnBinding;
    }
}

public struct AsmFunctionMetadata
{
    MirFuncId MirFunction;
    u32[0 max] ArchitectureCode;
    AsmTextRange TemplateText;
    u32[0 max] FirstInputRow;
    u32[0 max] InputRowCount;
    u32[0 max] FirstOutputRow;
    u32[0 max] OutputRowCount;
    u32[0 max] FirstClobberRow;
    u32[0 max] ClobberRowCount;

    AsmFunctionMetadata()
    {
        self.MirFunction = new();
        self.ArchitectureCode = 0;
        self.TemplateText = new();
        self.FirstInputRow = 0;
        self.InputRowCount = 0;
        self.FirstOutputRow = 0;
        self.OutputRowCount = 0;
        self.FirstClobberRow = 0;
        self.ClobberRowCount = 0;
    }

    public inline finite law MirFuncId Function(borrow AsmFunctionMetadata self)
    {
        return self.MirFunction;
    }

    public inline finite law Compiler.AsmFacts.StarkAsmArchitecture Architecture(borrow AsmFunctionMetadata self)
    {
        return AsmArchitectureFromStorageCode(self.ArchitectureCode);
    }

    public inline finite law AsmTextRange Template(borrow AsmFunctionMetadata self)
    {
        return self.TemplateText;
    }

    public inline finite law u32[0 max] FirstInput(borrow AsmFunctionMetadata self)
    {
        return self.FirstInputRow;
    }

    public inline finite law u32[0 max] InputCount(borrow AsmFunctionMetadata self)
    {
        return self.InputRowCount;
    }

    public inline finite law u32[0 max] FirstOutput(borrow AsmFunctionMetadata self)
    {
        return self.FirstOutputRow;
    }

    public inline finite law u32[0 max] OutputCount(borrow AsmFunctionMetadata self)
    {
        return self.OutputRowCount;
    }

    public inline finite law u32[0 max] FirstClobber(borrow AsmFunctionMetadata self)
    {
        return self.FirstClobberRow;
    }

    public inline finite law u32[0 max] ClobberCount(borrow AsmFunctionMetadata self)
    {
        return self.ClobberRowCount;
    }
}

internal inline finite law u32[0 max] AsmArchitectureStorageCode(Compiler.AsmFacts.StarkAsmArchitecture architecture)
{
    switch (architecture)
    {
        case Compiler.AsmFacts.StarkAsmArchitecture.X86_64: return 1;
        case Compiler.AsmFacts.StarkAsmArchitecture.AArch64: return 2;
        case Compiler.AsmFacts.StarkAsmArchitecture.RiscV64: return 3;
        case Compiler.AsmFacts.StarkAsmArchitecture.X86: return 4;
        case Compiler.AsmFacts.StarkAsmArchitecture.Arm32: return 5;
        default: return 0;
    }
}

internal inline finite law Compiler.AsmFacts.StarkAsmArchitecture AsmArchitectureFromStorageCode(u32[0 max] value)
{
    switch (value)
    {
        case 1: return Compiler.AsmFacts.StarkAsmArchitecture.X86_64;
        case 2: return Compiler.AsmFacts.StarkAsmArchitecture.AArch64;
        case 3: return Compiler.AsmFacts.StarkAsmArchitecture.RiscV64;
        case 4: return Compiler.AsmFacts.StarkAsmArchitecture.X86;
        case 5: return Compiler.AsmFacts.StarkAsmArchitecture.Arm32;
        default: return Compiler.AsmFacts.StarkAsmArchitecture.Unknown;
    }
}

// Dense append-only metadata for source assembly declarations. Textual facts live
// in one byte pool and all cross-references are fixed-width row/range values, so
// later package-image serialization is a straight linear write.
public struct AsmMetadataTable
{
    internal dynamic i8[min max] TextBytes;
    internal dynamic u32[0 max] InputRows;
    internal dynamic u32[0 max] OutputRows;
    internal dynamic u32[0 max] ClobberRows;
    internal dynamic u32[0 max] FunctionRows;

    AsmMetadataTable()
    {
        self.TextBytes = new();
        self.InputRows = new();
        self.OutputRows = new();
        self.ClobberRows = new();
        self.FunctionRows = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] TextByteCount(borrow AsmMetadataTable self)
    {
        return self.TextBytes.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] InputCount(borrow AsmMetadataTable self)
    {
        return self.InputRows.Length / 4;
    }

    public inline finite law u64[0 2 ** 63 - 1] OutputCount(borrow AsmMetadataTable self)
    {
        return self.OutputRows.Length / 5;
    }

    public inline finite law u64[0 2 ** 63 - 1] ClobberCount(borrow AsmMetadataTable self)
    {
        return self.ClobberRows.Length / 2;
    }

    public inline finite law u64[0 2 ** 63 - 1] FunctionCount(borrow AsmMetadataTable self)
    {
        return self.FunctionRows.Length / 10;
    }

    internal inline finite law u32[0 max] InputWordAt(borrow AsmMetadataTable self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.InputRows.Length)
        {
            return self.InputRows[index];
        }

        return 0;
    }

    internal inline finite law u32[0 max] OutputWordAt(borrow AsmMetadataTable self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.OutputRows.Length)
        {
            return self.OutputRows[index];
        }

        return 0;
    }

    internal inline finite law u32[0 max] ClobberWordAt(borrow AsmMetadataTable self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.ClobberRows.Length)
        {
            return self.ClobberRows[index];
        }

        return 0;
    }

    internal inline finite law u32[0 max] FunctionWordAt(borrow AsmMetadataTable self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.FunctionRows.Length)
        {
            return self.FunctionRows[index];
        }

        return 0;
    }

    public fn MemoryStatus AppendText(mut borrow AsmMetadataTable self, ascii text, out AsmTextRange range)
    {
        range = new();
        stack i64[min max] signedLength = System.Text.AsciiLength(text);
        if (signedLength < 0)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        range.StartByte = (u32[0 max])self.TextBytes.Length;
        range.ByteCount = (u32[0 max])signedLength;
        if (signedLength == 0)
        {
            return MemoryStatus.Ok;
        }

        unsafe
        {
            stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
            if (data == null)
            {
                return MemoryStatus.Err(MemoryError.OutOfMemory);
            }

            if (!self.TextBytes.TryReserve((u64[0 2 ** 63 - 1])signedLength))
            {
                return MemoryStatus.Err(MemoryError.OutOfMemory);
            }

            for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
            {
                init self.TextBytes[self.TextBytes.Length] = *(&data[index]);
            }
        }

        return MemoryStatus.Ok;
    }

    public fn MemoryStatus AppendTextByte(mut borrow AsmMetadataTable self, i8[min max] value)
    {
        if (!self.TextBytes.TryReserve(1))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        init self.TextBytes[self.TextBytes.Length] = value;
        return MemoryStatus.Ok;
    }

    public fn MemoryStatus AppendInputOperand(mut borrow AsmMetadataTable self, AsmTextRange registerText, AsmTextRange valueText)
    {
        if (!self.InputRows.TryReserve(4))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        init self.InputRows[self.InputRows.Length] = registerText.Start();
        init self.InputRows[self.InputRows.Length] = registerText.Length();
        init self.InputRows[self.InputRows.Length] = valueText.Start();
        init self.InputRows[self.InputRows.Length] = valueText.Length();
        return MemoryStatus.Ok;
    }

    public fn MemoryStatus AppendOutputOperand(mut borrow AsmMetadataTable self, AsmTextRange registerText, AsmTextRange valueText, bool bindsReturn)
    {
        if (!self.OutputRows.TryReserve(5))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        init self.OutputRows[self.OutputRows.Length] = registerText.Start();
        init self.OutputRows[self.OutputRows.Length] = registerText.Length();
        init self.OutputRows[self.OutputRows.Length] = valueText.Start();
        init self.OutputRows[self.OutputRows.Length] = valueText.Length();
        if (bindsReturn)
        {
            init self.OutputRows[self.OutputRows.Length] = 1;
        }
        else
        {
            init self.OutputRows[self.OutputRows.Length] = 0;
        }

        return MemoryStatus.Ok;
    }

    public fn MemoryStatus AppendClobber(mut borrow AsmMetadataTable self, AsmTextRange registerText)
    {
        if (!self.ClobberRows.TryReserve(2))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        init self.ClobberRows[self.ClobberRows.Length] = registerText.Start();
        init self.ClobberRows[self.ClobberRows.Length] = registerText.Length();
        return MemoryStatus.Ok;
    }

    public fn MemoryStatus AppendFunction(
        mut borrow AsmMetadataTable self,
        MirFuncId functionId,
        Compiler.AsmFacts.StarkAsmArchitecture architecture,
        AsmTextRange templateText,
        u32[0 max] firstInput,
        u32[0 max] inputCount,
        u32[0 max] firstOutput,
        u32[0 max] outputCount,
        u32[0 max] firstClobber,
        u32[0 max] clobberCount,
        out AsmFunctionId asmFunctionId)
    {
        asmFunctionId = new();
        if (!self.FunctionRows.TryReserve(10))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        stack u32[0 max] nextIndex = (u32[0 max])self.FunctionCount() + 1;
        stack u32[0 max] architectureCode = AsmArchitectureStorageCode(architecture);
        init self.FunctionRows[self.FunctionRows.Length] = functionId.Index();
        init self.FunctionRows[self.FunctionRows.Length] = architectureCode;
        init self.FunctionRows[self.FunctionRows.Length] = templateText.Start();
        init self.FunctionRows[self.FunctionRows.Length] = templateText.Length();
        init self.FunctionRows[self.FunctionRows.Length] = firstInput;
        init self.FunctionRows[self.FunctionRows.Length] = inputCount;
        init self.FunctionRows[self.FunctionRows.Length] = firstOutput;
        init self.FunctionRows[self.FunctionRows.Length] = outputCount;
        init self.FunctionRows[self.FunctionRows.Length] = firstClobber;
        init self.FunctionRows[self.FunctionRows.Length] = clobberCount;
        asmFunctionId = AsmFunctionIdOf(nextIndex);
        return MemoryStatus.Ok;
    }

    public law AsmFunctionMetadata FunctionAt(borrow AsmMetadataTable self, AsmFunctionId id)
    {
        if (id.Index() != 0)
        {
            stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(id.Index() - 1) * 10;
            if (index + 9 < self.FunctionRows.Length)
            {
                stack mut AsmFunctionMetadata row = new();
                row.MirFunction = MirFuncIdOf(self.FunctionWordAt(index));
                row.ArchitectureCode = self.FunctionWordAt(index + 1);
                row.TemplateText = AsmTextRangeOf(self.FunctionWordAt(index + 2), self.FunctionWordAt(index + 3));
                row.FirstInputRow = self.FunctionWordAt(index + 4);
                row.InputRowCount = self.FunctionWordAt(index + 5);
                row.FirstOutputRow = self.FunctionWordAt(index + 6);
                row.OutputRowCount = self.FunctionWordAt(index + 7);
                row.FirstClobberRow = self.FunctionWordAt(index + 8);
                row.ClobberRowCount = self.FunctionWordAt(index + 9);
                return row;
            }
        }

        return new AsmFunctionMetadata();
    }

    public law AsmInputOperand InputAt(borrow AsmMetadataTable self, u32[0 max] rowIndex)
    {
        if (rowIndex != 0)
        {
            stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(rowIndex - 1) * 4;
            if (index + 3 < self.InputRows.Length)
            {
                stack mut AsmInputOperand row = new();
                row.RegisterText = AsmTextRangeOf(self.InputWordAt(index), self.InputWordAt(index + 1));
                row.ValueText = AsmTextRangeOf(self.InputWordAt(index + 2), self.InputWordAt(index + 3));
                return row;
            }
        }

        return new AsmInputOperand();
    }

    public law AsmOutputOperand OutputAt(borrow AsmMetadataTable self, u32[0 max] rowIndex)
    {
        if (rowIndex != 0)
        {
            stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(rowIndex - 1) * 5;
            if (index + 4 < self.OutputRows.Length)
            {
                stack mut AsmOutputOperand row = new();
                row.RegisterText = AsmTextRangeOf(self.OutputWordAt(index), self.OutputWordAt(index + 1));
                row.ValueText = AsmTextRangeOf(self.OutputWordAt(index + 2), self.OutputWordAt(index + 3));
                row.ReturnBinding = self.OutputWordAt(index + 4) != 0;
                return row;
            }
        }

        return new AsmOutputOperand();
    }

    public law AsmTextRange ClobberAt(borrow AsmMetadataTable self, u32[0 max] rowIndex)
    {
        if (rowIndex != 0)
        {
            stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(rowIndex - 1) * 2;
            if (index + 1 < self.ClobberRows.Length)
            {
                return AsmTextRangeOf(self.ClobberWordAt(index), self.ClobberWordAt(index + 1));
            }
        }

        return new AsmTextRange();
    }

    public finite law i8[min max] TextByteAt(borrow AsmMetadataTable self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.TextBytes.Length)
        {
            return self.TextBytes[index];
        }

        return 0;
    }

    public finite law bool TextRangeEquals(borrow AsmMetadataTable self, AsmTextRange range, ascii expected)
        where overlap(self, expected)
    {
        unsafe
        {
            stack i64[min max] signedLength = System.Text.AsciiLength(expected);
            if (signedLength < 0 || (u32[0 max])signedLength != range.Length())
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] start = (u64[0 2 ** 63 - 1])range.Start();
            stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])range.Length();
            if (start + length > self.TextBytes.Length)
            {
                return false;
            }

            if (length == 0)
            {
                return true;
            }

            stack rawptr<i8[min max]> expectedData = System.Text.AsciiData(expected);
            if (expectedData == null)
            {
                return false;
            }

            for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < length; index += 1)
            {
                stack u64[0 2 ** 63 - 1] byteIndex = start + index;
                if (self.TextBytes[byteIndex] != *(&expectedData[(i64[min max])index]))
                {
                    return false;
                }
            }

            return true;
        }
    }
}
