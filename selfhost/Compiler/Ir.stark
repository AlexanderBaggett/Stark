import System.Collections
import System.Memory
module Compiler.Ir

// The self-hosted compiler's IR memory model: typed handle indices into dense
// tables (docs/Self-host-Prep/24). Each IR id is a DISTINCT value type wrapping a
// compact 1-based index (0 is the invalid/null sentinel), so a `MirValueId` can
// never be passed where a `TypeId` is expected — handles are not interchangeable
// integers. They are small Copyable values, freely copied and stored in fact side
// tables. A no-reuse dense `IrTable<T>` owns the rows; use the generational
// `System.Collections.Arena.Arena<T>` only for tables that need deletion/reuse.

// A type-table row id.
public struct TypeId
{
    u32[0 max] Value;

    TypeId()
    {
        self.Value = 0;
    }

    public inline finite law u32[0 max] Index(borrow TypeId self)
    {
        return self.Value;
    }

    public inline finite law bool IsValid(borrow TypeId self)
    {
        return self.Value != 0;
    }

    public inline finite law bool Equals(borrow TypeId self, TypeId other)
    {
        return self.Value == other.Value;
    }
}

// The `TypeId` for the 1-based row index `index` (0 = the invalid id).
public fn TypeId TypeIdOf(u32[0 max] index)
{
    stack mut TypeId id = new();
    id.Value = index;
    return id;
}

