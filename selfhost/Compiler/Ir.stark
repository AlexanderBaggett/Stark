// A dense IR table: rows owned in insertion order, addressed by a 1-based index
// (0 stays the invalid sentinel, so a freshly default handle never aliases row 0).
// Prefer this no-reuse table inside a phase for speed and simpler diagnostics;
// reach for `Arena<T>` only where deletion/reuse is proven necessary (doc 24 §3).
public struct IrTable<T>
{
    internal System.Collections.List<T> Rows;

    IrTable()
    {
        self.Rows = new();
    }

    // The number of rows (also the largest valid 1-based index).
    public inline finite law u64[0 2 ** 63 - 1] Count(borrow IrTable<T> self)
    {
        return self.Rows.Count();
    }

    public inline finite law bool IsEmpty(borrow IrTable<T> self)
    {
        return self.Rows.Count() == 0;
    }

    // Appends `row`, returning its 1-based index (never 0). Returns 0 — the invalid
    // sentinel — when the backing allocation fails.
    public fn u32[0 max] Add(mut borrow IrTable<T> self, T row)
    {
        switch (self.Rows.Push(row))
        {
            case MemoryStatus.Ok:
                return (u32[0 max])self.Rows.Count();
            case MemoryStatus.Err(var error):
                return 0;
        }
    }

    // True when `index` is a live 1-based row index.
    public inline finite law bool Contains(borrow IrTable<T> self, u32[0 max] index)
    {
        return index != 0 && (u64[0 2 ** 63 - 1])index <= self.Rows.Count();
    }

    // Borrows the row at the 1-based `index`; the caller must ensure `Contains`.
    public law retborrow T Get(borrow IrTable<T> self, u32[0 max] index)
    {
        return self.Rows.Get((u64[0 2 ** 63 - 1])(index - 1));
    }
}

// === Fact categories (doc 24 §4) ===
// Concrete per-value fact records a pass attaches to a handle. These are plain
// Copyable value types using bool presence flags + raw values (NOT `Option`), so
// they instantiate cleanly across packages (a generic `Option<CompilerType>` value
// in a body materialized from a downstream package currently crashes the host
// `lower-mir`). The "one record per value" layout (`ValueFacts`) is the doc's form.

// The calling/ABI convention of a callable value (doc 24 §4 `CallingAbi`).
public enum AbiKind
{
    StarkAbi,
    CAbi,
    PlatformAbi,
}

public enum CAbiAggregatePassKind
{
    None,
    Direct,
    Indirect,
    Unsupported,
}

public enum AbiCarrierKind
{
    None,
    I8,
    I16,
    I32,
    I64,
    F32,
    F64,
    Vector2F32,
}

public struct CAbiAggregateCarrierFacts
{
    bool HasFact;
    CAbiAggregatePassKind PassKind;
    u32[0 max] SizeBytes;
    u32[0 max] AlignBytes;
    u32[0 max] CarrierCount;
    bool ReturnUsesLlvmStruct;
    AbiCarrierKind Carrier0;
    AbiCarrierKind Carrier1;
    AbiCarrierKind Carrier2;
    AbiCarrierKind Carrier3;

    CAbiAggregateCarrierFacts()
    {
        self.HasFact = false;
        self.PassKind = CAbiAggregatePassKind.None;
        self.SizeBytes = 0;
        self.AlignBytes = 0;
        self.CarrierCount = 0;
        self.ReturnUsesLlvmStruct = false;
        self.Carrier0 = AbiCarrierKind.None;
        self.Carrier1 = AbiCarrierKind.None;
        self.Carrier2 = AbiCarrierKind.None;
        self.Carrier3 = AbiCarrierKind.None;
    }

    public inline finite law bool Present(borrow CAbiAggregateCarrierFacts self)
    {
        return self.HasFact;
    }

    public inline finite law CAbiAggregatePassKind Kind(borrow CAbiAggregateCarrierFacts self)
    {
        return self.PassKind;
    }

    public inline finite law bool IsDirect(borrow CAbiAggregateCarrierFacts self)
    {
        return self.HasFact && self.PassKind == CAbiAggregatePassKind.Direct;
    }

    public inline finite law bool IsIndirect(borrow CAbiAggregateCarrierFacts self)
    {
        return self.HasFact && self.PassKind == CAbiAggregatePassKind.Indirect;
    }

    public inline finite law u32[0 max] ByteSize(borrow CAbiAggregateCarrierFacts self)
    {
        return self.SizeBytes;
    }

    public inline finite law u32[0 max] ByteAlignment(borrow CAbiAggregateCarrierFacts self)
    {
        return self.AlignBytes;
    }

    public inline finite law u32[0 max] LlvmParameterCarrierCount(borrow CAbiAggregateCarrierFacts self)
    {
        return self.CarrierCount;
    }

    public inline finite law bool ReturnCarrierIsLlvmStruct(borrow CAbiAggregateCarrierFacts self)
    {
        return self.ReturnUsesLlvmStruct;
    }

    public finite law AbiCarrierKind CarrierKindAt(borrow CAbiAggregateCarrierFacts self, u32[0 max] index)
    {
        switch (index)
        {
            case 0:
                return self.Carrier0;
            case 1:
                return self.Carrier1;
            case 2:
                return self.Carrier2;
            case 3:
                return self.Carrier3;
            default:
                return AbiCarrierKind.None;
        }
    }

    public fn void SetDirect(
        mut borrow CAbiAggregateCarrierFacts self,
        u32[0 max] sizeBytes,
        u32[0 max] alignBytes,
        u32[0 max] carrierCount,
        AbiCarrierKind carrier0,
        AbiCarrierKind carrier1,
        AbiCarrierKind carrier2,
        AbiCarrierKind carrier3)
    {
        self.HasFact = true;
        self.PassKind = CAbiAggregatePassKind.Direct;
        self.SizeBytes = sizeBytes;
        self.AlignBytes = alignBytes;
        self.CarrierCount = carrierCount;
        self.ReturnUsesLlvmStruct = carrierCount > 1;
        self.Carrier0 = carrier0;
        self.Carrier1 = carrier1;
        self.Carrier2 = carrier2;
        self.Carrier3 = carrier3;
    }

    public fn void SetIndirect(mut borrow CAbiAggregateCarrierFacts self, u32[0 max] sizeBytes, u32[0 max] alignBytes)
    {
        self.HasFact = true;
        self.PassKind = CAbiAggregatePassKind.Indirect;
        self.SizeBytes = sizeBytes;
        self.AlignBytes = alignBytes;
        self.CarrierCount = 0;
        self.ReturnUsesLlvmStruct = false;
        self.Carrier0 = AbiCarrierKind.None;
        self.Carrier1 = AbiCarrierKind.None;
        self.Carrier2 = AbiCarrierKind.None;
        self.Carrier3 = AbiCarrierKind.None;
    }

    public fn void SetUnsupported(mut borrow CAbiAggregateCarrierFacts self)
    {
        self.HasFact = true;
        self.PassKind = CAbiAggregatePassKind.Unsupported;
        self.SizeBytes = 0;
        self.AlignBytes = 0;
        self.CarrierCount = 0;
        self.ReturnUsesLlvmStruct = false;
        self.Carrier0 = AbiCarrierKind.None;
        self.Carrier1 = AbiCarrierKind.None;
        self.Carrier2 = AbiCarrierKind.None;
        self.Carrier3 = AbiCarrierKind.None;
    }
}

// The optimization/backend facts attached to one MIR/SSA value (doc 24 §4). A fact
// is present when its `Has*` flag is set; absent facts read as 0/false/`StarkAbi`.
// `InheritFrom` is the lowering fact-transfer primitive (doc 24 §5): a lowered value
// carries forward each PRESENT fact of the value it derives from, and an absent
// source fact leaves the destination's own fact untouched.
public struct ValueFacts
{
    bool HasAlign;
    u32[0 max] AlignBytes;
    bool HasAbi;
    AbiKind Abi;
    bool NoAlias;
    bool IsVolatile;
    bool HasRange;
    i64[min max] RangeLower;
    i64[min max] RangeUpperExclusive;

    ValueFacts()
    {
        self.HasAlign = false;
        self.AlignBytes = 0;
        self.HasAbi = false;
        self.Abi = AbiKind.StarkAbi;
        self.NoAlias = false;
        self.IsVolatile = false;
        self.HasRange = false;
        self.RangeLower = 0;
        self.RangeUpperExclusive = 0;
    }

    public inline finite law bool HasAlignment(borrow ValueFacts self)
    {
        return self.HasAlign;
    }

    // The known alignment in bytes (0 when no alignment fact is attached).
    public inline finite law u32[0 max] AlignmentBytes(borrow ValueFacts self)
    {
        return self.AlignBytes;
    }

    public inline finite law bool HasCallingAbi(borrow ValueFacts self)
    {
        return self.HasAbi;
    }

    // The calling ABI (defaults to `StarkAbi` when no ABI fact is attached).
    public inline finite law AbiKind CallingAbi(borrow ValueFacts self)
    {
        return self.Abi;
    }

    public inline finite law bool HasNoAlias(borrow ValueFacts self)
    {
        return self.NoAlias;
    }

    public inline finite law bool Volatile(borrow ValueFacts self)
    {
        return self.IsVolatile;
    }

    public inline finite law bool HasIntegerRange(borrow ValueFacts self)
    {
        return self.HasRange;
    }

    public inline finite law i64[min max] IntegerRangeLower(borrow ValueFacts self)
    {
        return self.RangeLower;
    }

    public inline finite law i64[min max] IntegerRangeUpperExclusive(borrow ValueFacts self)
    {
        return self.RangeUpperExclusive;
    }

    public fn void SetAlignment(mut borrow ValueFacts self, u32[0 max] bytes)
    {
        self.HasAlign = true;
        self.AlignBytes = bytes;
    }

    public fn void SetCallingAbi(mut borrow ValueFacts self, AbiKind abi)
    {
        self.HasAbi = true;
        self.Abi = abi;
    }

    public fn void MarkNoAlias(mut borrow ValueFacts self)
    {
        self.NoAlias = true;
    }

    public fn void MarkVolatile(mut borrow ValueFacts self)
    {
        self.IsVolatile = true;
    }

    public fn void SetIntegerRange(mut borrow ValueFacts self, i64[min max] lower, i64[min max] upperExclusive)
    {
        self.HasRange = true;
        self.RangeLower = lower;
        self.RangeUpperExclusive = upperExclusive;
    }

    // Carries each PRESENT fact of `src` onto `self`; an absent source fact leaves
    // `self`'s value untouched (the doc 24 §5 `Inherit`/`preserve` contract).
    public fn void InheritFrom(mut borrow ValueFacts self, ValueFacts src)
    {
        if (src.HasAlign)
        {
            self.HasAlign = true;
            self.AlignBytes = src.AlignBytes;
        }

        if (src.HasAbi)
        {
            self.HasAbi = true;
            self.Abi = src.Abi;
        }

        if (src.NoAlias)
        {
            self.NoAlias = true;
        }

        if (src.IsVolatile)
        {
            self.IsVolatile = true;
        }

        if (src.HasRange)
        {
            self.HasRange = true;
            self.RangeLower = src.RangeLower;
            self.RangeUpperExclusive = src.RangeUpperExclusive;
        }
    }
}

// An inline-assembly metadata row id. These rows describe source `unsafe ffi asm`
// declarations after parsing/binding, independent of the parser's token stream.
public struct AsmFunctionId
{
    u32[0 max] Value;

    AsmFunctionId()
    {
        self.Value = 0;
    }

    public inline finite law u32[0 max] Index(borrow AsmFunctionId self)
    {
        return self.Value;
    }

    public inline finite law bool IsValid(borrow AsmFunctionId self)
    {
        return self.Value != 0;
    }

    public inline finite law bool Equals(borrow AsmFunctionId self, AsmFunctionId other)
    {
        return self.Value == other.Value;
    }
}

public fn AsmFunctionId AsmFunctionIdOf(u32[0 max] index)
{
    stack mut AsmFunctionId id = new();
    id.Value = index;
    return id;
}

// A byte range in `AsmMetadataTable.TextBytes`. Ranges are 0-based internally so
// they copy directly from slices and serialize without sentinel adjustment.
public struct AsmTextRange
{
    u32[0 max] StartByte;
    u32[0 max] ByteCount;

    AsmTextRange()
    {
        self.StartByte = 0;
        self.ByteCount = 0;
    }

    public inline finite law u32[0 max] Start(borrow AsmTextRange self)
    {
        return self.StartByte;
    }

    public inline finite law u32[0 max] Length(borrow AsmTextRange self)
    {
        return self.ByteCount;
    }

    public inline finite law bool IsEmpty(borrow AsmTextRange self)
    {
        return self.ByteCount == 0;
    }
}

public fn AsmTextRange AsmTextRangeOf(u32[0 max] start, u32[0 max] length)
{
    stack mut AsmTextRange range = new();
    range.StartByte = start;
    range.ByteCount = length;
    return range;
}

