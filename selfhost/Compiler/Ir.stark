// A dense IR table: rows owned in insertion order, addressed by a 1-based index
// (0 stays the invalid sentinel, so a freshly default handle never aliases row 0).
// Prefer this no-reuse table inside a phase for speed and simpler diagnostics;
// reach for `Arena<T>` only where deletion/reuse is proven necessary (doc 24 §3).
public struct IrTable<T>
{
    internal System.Collections.List<T> Rows;

    IrTable()
    {
        self.Rows = new();
    }

    // The number of rows (also the largest valid 1-based index).
    public inline finite law u64[0 2 ** 63 - 1] Count(borrow IrTable<T> self)
    {
        return self.Rows.Count();
    }

    public inline finite law bool IsEmpty(borrow IrTable<T> self)
    {
        return self.Rows.Count() == 0;
    }

    public fn MemoryStatus Reserve(mut borrow IrTable<T> self, u64[0 2 ** 63 - 1] additional)
    {
        return self.Rows.Reserve(additional);
    }

    // Appends `row`, returning its 1-based index (never 0). Returns 0 — the invalid
    // sentinel — when the backing allocation fails.
    public fn u32[0 max] Add(mut borrow IrTable<T> self, T row)
    {
        switch (self.Rows.Push(row))
        {
            case MemoryStatus.Ok:
                return (u32[0 max])self.Rows.Count();
            case MemoryStatus.Err(var error):
                return 0;
        }
    }

    // True when `index` is a live 1-based row index.
    public inline finite law bool Contains(borrow IrTable<T> self, u32[0 max] index)
    {
        return index != 0 && (u64[0 2 ** 63 - 1])index <= self.Rows.Count();
    }

    // Borrows the row at the 1-based `index`; the caller must ensure `Contains`.
    public finite law retborrow T Get(borrow IrTable<T> self, u32[0 max] index)
    {
        return self.Rows.Get((u64[0 2 ** 63 - 1])(index - 1));
    }

    public finite bool Replace(mut borrow IrTable<T> self, u32[0 max] index, T row)
    {
        if (!self.Contains(index))
        {
            return false;
        }

        self.Rows.GetMut((u64[0 2 ** 63 - 1])(index - 1)) = row;
        return true;
    }
}

// === Fact categories (doc 24 §4) ===
// Concrete per-value fact records a pass attaches to a handle. These are plain
// Copyable value types using bool presence flags + raw values (NOT `Option`), so
// they instantiate cleanly across packages (a generic `Option<CompilerType>` value
// in a body materialized from a downstream package currently crashes the host
// `lower-mir`). The "one record per value" layout (`ValueFacts`) is the doc's form.

// The calling/ABI convention of a callable value (doc 24 §4 `CallingAbi`).
public enum AbiKind
{
    StarkAbi,
    CAbi,
    PlatformAbi,
}

public enum CAbiAggregatePassKind
{
    None,
    Direct,
    Indirect,
    Unsupported,
}

public enum AbiCarrierKind
{
    None,
    I8,
    I16,
    I32,
    I64,
    F32,
    F64,
    Vector2F32,
}

public struct CAbiAggregateCarrierFacts
{
    bool HasFact;
    CAbiAggregatePassKind PassKind;
    u32[0 max] SizeBytes;
    u32[0 max] AlignBytes;
    u32[0 max] CarrierCount;
    bool ReturnUsesLlvmStruct;
    AbiCarrierKind Carrier0;
    AbiCarrierKind Carrier1;
    AbiCarrierKind Carrier2;
    AbiCarrierKind Carrier3;

    CAbiAggregateCarrierFacts()
    {
        self.HasFact = false;
        self.PassKind = CAbiAggregatePassKind.None;
        self.SizeBytes = 0;
        self.AlignBytes = 0;
        self.CarrierCount = 0;
        self.ReturnUsesLlvmStruct = false;
        self.Carrier0 = AbiCarrierKind.None;
        self.Carrier1 = AbiCarrierKind.None;
        self.Carrier2 = AbiCarrierKind.None;
        self.Carrier3 = AbiCarrierKind.None;
    }

    public inline finite law bool Present(borrow CAbiAggregateCarrierFacts self)
    {
        return self.HasFact;
    }

    public inline finite law CAbiAggregatePassKind Kind(borrow CAbiAggregateCarrierFacts self)
    {
        return self.PassKind;
    }

    public inline finite law bool IsDirect(borrow CAbiAggregateCarrierFacts self)
    {
        return self.HasFact && self.PassKind == CAbiAggregatePassKind.Direct;
    }

    public inline finite law bool IsIndirect(borrow CAbiAggregateCarrierFacts self)
    {
        return self.HasFact && self.PassKind == CAbiAggregatePassKind.Indirect;
    }

    public inline finite law u32[0 max] ByteSize(borrow CAbiAggregateCarrierFacts self)
    {
        return self.SizeBytes;
    }

    public inline finite law u32[0 max] ByteAlignment(borrow CAbiAggregateCarrierFacts self)
    {
        return self.AlignBytes;
    }

    public inline finite law u32[0 max] LlvmParameterCarrierCount(borrow CAbiAggregateCarrierFacts self)
    {
        return self.CarrierCount;
    }

    public inline finite law bool ReturnCarrierIsLlvmStruct(borrow CAbiAggregateCarrierFacts self)
    {
        return self.ReturnUsesLlvmStruct;
    }

    public finite law AbiCarrierKind CarrierKindAt(borrow CAbiAggregateCarrierFacts self, u32[0 max] index)
    {
        switch (index)
        {
            case 0:
                return self.Carrier0;
            case 1:
                return self.Carrier1;
            case 2:
                return self.Carrier2;
            case 3:
                return self.Carrier3;
            default:
                return AbiCarrierKind.None;
        }
    }

    public fn void SetDirect(
        mut borrow CAbiAggregateCarrierFacts self,
        u32[0 max] sizeBytes,
        u32[0 max] alignBytes,
        u32[0 max] carrierCount,
        AbiCarrierKind carrier0,
        AbiCarrierKind carrier1,
        AbiCarrierKind carrier2,
        AbiCarrierKind carrier3)
    {
        self.HasFact = true;
        self.PassKind = CAbiAggregatePassKind.Direct;
        self.SizeBytes = sizeBytes;
        self.AlignBytes = alignBytes;
        self.CarrierCount = carrierCount;
        self.ReturnUsesLlvmStruct = carrierCount > 1;
        self.Carrier0 = carrier0;
        self.Carrier1 = carrier1;
        self.Carrier2 = carrier2;
        self.Carrier3 = carrier3;
    }

    public fn void SetIndirect(mut borrow CAbiAggregateCarrierFacts self, u32[0 max] sizeBytes, u32[0 max] alignBytes)
    {
        self.HasFact = true;
        self.PassKind = CAbiAggregatePassKind.Indirect;
        self.SizeBytes = sizeBytes;
        self.AlignBytes = alignBytes;
        self.CarrierCount = 0;
        self.ReturnUsesLlvmStruct = false;
        self.Carrier0 = AbiCarrierKind.None;
        self.Carrier1 = AbiCarrierKind.None;
        self.Carrier2 = AbiCarrierKind.None;
        self.Carrier3 = AbiCarrierKind.None;
    }

    public fn void SetUnsupported(mut borrow CAbiAggregateCarrierFacts self)
    {
        self.HasFact = true;
        self.PassKind = CAbiAggregatePassKind.Unsupported;
        self.SizeBytes = 0;
        self.AlignBytes = 0;
        self.CarrierCount = 0;
        self.ReturnUsesLlvmStruct = false;
        self.Carrier0 = AbiCarrierKind.None;
        self.Carrier1 = AbiCarrierKind.None;
        self.Carrier2 = AbiCarrierKind.None;
        self.Carrier3 = AbiCarrierKind.None;
    }
}

public finite law CAbiAggregateCarrierFacts CAbiAggregateCarrierFactsAtIndex(borrow IrTable<CAbiAggregateCarrierFacts> facts, u32[0 max] index)
{
    stack mut CAbiAggregateCarrierFacts empty = new();
    if (facts.Contains(index))
    {
        return facts.Get(index);
    }

    return empty;
}

// The optimization/backend facts attached to one MIR/SSA value (doc 24 §4). A fact
// is present when its `Has*` flag is set; absent facts read as 0/false/`StarkAbi`.
// `InheritFrom` is the lowering fact-transfer primitive (doc 24 §5): a lowered value
// carries forward each PRESENT fact of the value it derives from, and an absent
// source fact leaves the destination's own fact untouched.
public struct ValueFacts
{
    bool HasAlign;
    u32[0 max] AlignBytes;
    bool HasAbi;
    AbiKind Abi;
    bool NoAlias;
    bool IsVolatile;
    bool HasRange;
    i64[min max] RangeLower;
    i64[min max] RangeUpperExclusive;
    bool IsKnownNullValue;
    bool IsKnownNonNullValue;
    bool HasTextLiteralConstant;
    u32[0 max] TextConstantRow;
    u32[0 max] TextPayloadStart;
    u32[0 max] TextPayloadBytes;
    u32[0 max] TextCodePoints;
    u32[0 max] TextEncoding;

    ValueFacts()
    {
        self.HasAlign = false;
        self.AlignBytes = 0;
        self.HasAbi = false;
        self.Abi = AbiKind.StarkAbi;
        self.NoAlias = false;
        self.IsVolatile = false;
        self.HasRange = false;
        self.RangeLower = 0;
        self.RangeUpperExclusive = 0;
        self.IsKnownNullValue = false;
        self.IsKnownNonNullValue = false;
        self.HasTextLiteralConstant = false;
        self.TextConstantRow = 0;
        self.TextPayloadStart = 0;
        self.TextPayloadBytes = 0;
        self.TextCodePoints = 0;
        self.TextEncoding = 0;
    }

    public inline finite law bool HasAlignment(borrow ValueFacts self)
    {
        return self.HasAlign;
    }

    // The known alignment in bytes (0 when no alignment fact is attached).
    public inline finite law u32[0 max] AlignmentBytes(borrow ValueFacts self)
    {
        return self.AlignBytes;
    }

    public inline finite law bool HasCallingAbi(borrow ValueFacts self)
    {
        return self.HasAbi;
    }

    // The calling ABI (defaults to `StarkAbi` when no ABI fact is attached).
    public inline finite law AbiKind CallingAbi(borrow ValueFacts self)
    {
        return self.Abi;
    }

    public inline finite law bool HasNoAlias(borrow ValueFacts self)
    {
        return self.NoAlias;
    }

    public inline finite law bool Volatile(borrow ValueFacts self)
    {
        return self.IsVolatile;
    }

    public inline finite law bool HasIntegerRange(borrow ValueFacts self)
    {
        return self.HasRange;
    }

    public inline finite law i64[min max] IntegerRangeLower(borrow ValueFacts self)
    {
        return self.RangeLower;
    }

    public inline finite law i64[min max] IntegerRangeUpperExclusive(borrow ValueFacts self)
    {
        return self.RangeUpperExclusive;
    }

    public inline finite law bool HasNullability(borrow ValueFacts self)
    {
        return self.IsKnownNullValue || self.IsKnownNonNullValue;
    }

    public inline finite law bool KnownNull(borrow ValueFacts self)
    {
        return self.IsKnownNullValue;
    }

    public inline finite law bool KnownNonNull(borrow ValueFacts self)
    {
        return self.IsKnownNonNullValue;
    }

    public inline finite law bool HasTextConstant(borrow ValueFacts self)
    {
        return self.HasTextLiteralConstant;
    }

    public inline finite law u32[0 max] TextConstantRowIndex(borrow ValueFacts self)
    {
        return self.TextConstantRow;
    }

    public inline finite law u32[0 max] TextConstantPayloadStart(borrow ValueFacts self)
    {
        return self.TextPayloadStart;
    }

    public inline finite law u32[0 max] TextConstantPayloadByteLength(borrow ValueFacts self)
    {
        return self.TextPayloadBytes;
    }

    public inline finite law u32[0 max] TextConstantCodePointLength(borrow ValueFacts self)
    {
        return self.TextCodePoints;
    }

    public inline finite law u32[0 max] TextConstantStorageEncodingCode(borrow ValueFacts self)
    {
        return self.TextEncoding;
    }

    public fn void SetAlignment(mut borrow ValueFacts self, u32[0 max] bytes)
    {
        self.HasAlign = true;
        self.AlignBytes = bytes;
    }

    public fn void SetCallingAbi(mut borrow ValueFacts self, AbiKind abi)
    {
        self.HasAbi = true;
        self.Abi = abi;
    }

    public fn void MarkNoAlias(mut borrow ValueFacts self)
    {
        self.NoAlias = true;
    }

    public fn void MarkVolatile(mut borrow ValueFacts self)
    {
        self.IsVolatile = true;
    }

    public fn void SetIntegerRange(mut borrow ValueFacts self, i64[min max] lower, i64[min max] upperExclusive)
    {
        self.HasRange = true;
        self.RangeLower = lower;
        self.RangeUpperExclusive = upperExclusive;
    }

    public fn void MarkKnownNull(mut borrow ValueFacts self)
    {
        self.IsKnownNullValue = true;
        self.IsKnownNonNullValue = false;
    }

    public fn void MarkKnownNonNull(mut borrow ValueFacts self)
    {
        self.IsKnownNullValue = false;
        self.IsKnownNonNullValue = true;
    }

    public fn void SetTextConstant(
        mut borrow ValueFacts self,
        u32[0 max] rowIndex,
        u32[0 max] payloadStart,
        u32[0 max] payloadByteLength,
        u32[0 max] codePointLength,
        u32[0 max] storageEncoding)
    {
        self.HasTextLiteralConstant = true;
        self.TextConstantRow = rowIndex;
        self.TextPayloadStart = payloadStart;
        self.TextPayloadBytes = payloadByteLength;
        self.TextCodePoints = codePointLength;
        self.TextEncoding = storageEncoding;
    }

    // Carries each PRESENT fact of `src` onto `self`; an absent source fact leaves
    // `self`'s value untouched (the doc 24 §5 `Inherit`/`preserve` contract).
    public fn void InheritFrom(mut borrow ValueFacts self, ValueFacts src)
    {
        if (src.HasAlign)
        {
            self.HasAlign = true;
            self.AlignBytes = src.AlignBytes;
        }

        if (src.HasAbi)
        {
            self.HasAbi = true;
            self.Abi = src.Abi;
        }

        if (src.NoAlias)
        {
            self.NoAlias = true;
        }

        if (src.IsVolatile)
        {
            self.IsVolatile = true;
        }

        if (src.HasRange)
        {
            self.HasRange = true;
            self.RangeLower = src.RangeLower;
            self.RangeUpperExclusive = src.RangeUpperExclusive;
        }

        if (src.IsKnownNullValue)
        {
            self.IsKnownNullValue = true;
            self.IsKnownNonNullValue = false;
        }

        if (src.IsKnownNonNullValue)
        {
            self.IsKnownNullValue = false;
            self.IsKnownNonNullValue = true;
        }

        if (src.HasTextLiteralConstant)
        {
            self.HasTextLiteralConstant = true;
            self.TextConstantRow = src.TextConstantRow;
            self.TextPayloadStart = src.TextPayloadStart;
            self.TextPayloadBytes = src.TextPayloadBytes;
            self.TextCodePoints = src.TextCodePoints;
            self.TextEncoding = src.TextEncoding;
        }
    }
}

// Reads the fact row attached to a 1-based value index. Missing/invalid rows read as
// empty facts so callers can stay branch-light in hot lowering/emission paths.
public finite law ValueFacts ValueFactsAtIndex(borrow IrTable<ValueFacts> facts, u32[0 max] index)
{
    stack mut ValueFacts empty = new();
    if (facts.Contains(index))
    {
        return facts.Get(index);
    }

    return empty;
}

// Reads the fact row attached to a MIR value handle. Invalid handles read as empty.
public finite law ValueFacts ValueFactsForMirValue(borrow IrTable<ValueFacts> facts, MirValueId value)
{
    return ValueFactsAtIndex(facts, value.Index());
}

// Appends `row` as the fact record for `value`, filling any skipped earlier value
// rows with empty facts. Existing rows are never overwritten; a stale/duplicate
// handle returns false so phase validation can report the compiler bug.
public fn bool RecordValueFactsForMirValue(mut borrow IrTable<ValueFacts> facts, MirValueId value, ValueFacts row)
{
    stack u32[0 max] targetIndex = value.Index();
    if (targetIndex == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] targetBefore = (u64[0 2 ** 63 - 1])(targetIndex - 1);
    while willexit (facts.Count() < targetBefore)
    {
        stack mut ValueFacts empty = new();
        if (facts.Add(empty) == 0)
        {
            return false;
        }
    }

    if (facts.Count() != targetBefore)
    {
        return false;
    }

    return facts.Add(row) == targetIndex;
}

// Records an empty fact row for builders whose result has no inherited facts or
// whose facts must be recomputed by a later analysis pass.
public fn bool RecordEmptyValueFactsForMirValue(mut borrow IrTable<ValueFacts> facts, MirValueId value)
{
    stack mut ValueFacts empty = new();
    return RecordValueFactsForMirValue(facts, value, empty);
}

// Records facts generated directly by the builder, such as constants, loads, or
// allocations with known alignment/range/alias facts.
public fn bool RecordGeneratedValueFactsForMirValue(mut borrow IrTable<ValueFacts> facts, MirValueId value, ValueFacts generated)
{
    return RecordValueFactsForMirValue(facts, value, generated);
}

// Preserves facts from a source value onto an equivalent lowered value. Use this
// only for value-preserving builders such as casts/projections/moves; arithmetic
// builders should recompute or provide translated facts instead.
public fn bool PreserveValueFactsForMirValue(mut borrow IrTable<ValueFacts> facts, MirValueId value, MirValueId source)
{
    return RecordValueFactsForMirValue(facts, value, ValueFactsForMirValue(facts, source));
}

// Records facts that were intentionally translated to the new value/phase shape.
public fn bool TranslateValueFactsForMirValue(mut borrow IrTable<ValueFacts> facts, MirValueId value, ValueFacts translated)
{
    return RecordValueFactsForMirValue(facts, value, translated);
}

// Records the recompute policy: old facts are intentionally invalidated and a
// later analysis must derive any new range/alias/layout facts.
public fn bool RecomputeValueFactsForMirValue(mut borrow IrTable<ValueFacts> facts, MirValueId value)
{
    return RecordEmptyValueFactsForMirValue(facts, value);
}

// Records the consume policy: the fact was used by the builder and does not
// survive as a value fact after this handle.
public fn bool ConsumeValueFactsForMirValue(mut borrow IrTable<ValueFacts> facts, MirValueId value)
{
    return RecordEmptyValueFactsForMirValue(facts, value);
}

// Records the debug-only policy: debug/inspection facts may disappear from this
// value without changing optimized backend behavior.
public fn bool DropDebugOnlyValueFactsForMirValue(mut borrow IrTable<ValueFacts> facts, MirValueId value)
{
    return RecordEmptyValueFactsForMirValue(facts, value);
}

// Imports a fact row from a non-value side table into the MIR value-fact table.
public fn bool ImportValueFactsForMirValue(
    mut borrow IrTable<ValueFacts> facts,
    MirValueId value,
    borrow IrTable<ValueFacts> sourceFacts,
    u32[0 max] sourceIndex)
{
    return RecordValueFactsForMirValue(facts, value, ValueFactsAtIndex(sourceFacts, sourceIndex));
}

// Parameters are keyed by their 0-based source parameter index but stored in
// 1-based fact rows.
public fn bool ImportParameterValueFactsForMirValue(
    mut borrow IrTable<ValueFacts> facts,
    MirValueId value,
    borrow IrTable<ValueFacts> parameterFacts,
    u32[0 max] parameterIndex)
{
    return ImportValueFactsForMirValue(facts, value, parameterFacts, parameterIndex + 1);
}

// Globals and function returns are already keyed by their 1-based MIR handles.
public fn bool ImportGlobalValueFactsForMirValue(
    mut borrow IrTable<ValueFacts> facts,
    MirValueId value,
    borrow IrTable<ValueFacts> globalFacts,
    u32[0 max] globalId)
{
    return ImportValueFactsForMirValue(facts, value, globalFacts, globalId);
}

public fn bool ImportFunctionReturnValueFactsForMirValue(
    mut borrow IrTable<ValueFacts> facts,
    MirValueId value,
    borrow IrTable<ValueFacts> functionReturnFacts,
    MirFuncId callee)
{
    return ImportValueFactsForMirValue(facts, value, functionReturnFacts, callee.Index());
}

