}

public fn MirValueId MirTailCall3Typed(mut borrow IrTable<MirInstruction> instrs, MirType type, MirFuncId callee, MirValueId arg0, MirValueId arg1, MirValueId arg2)
{
    stack mut MirInstruction instr = new();
    instr.Op = MirOp.TailCall;
    instr.AIndex = arg0.Index();
    instr.BIndex = arg1.Index();
    instr.CIndex = arg2.Index();
