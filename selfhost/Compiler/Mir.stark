    return false;
}

internal fn bool FunctionIdFlagIsSet(borrow IrTable<u32[0 max]> flags, u32[0 max] functionId)
{
    if (functionId == 0 || !flags.Contains(functionId))
    {
        return false;
    }

    return flags.Get(functionId) != 0;
}

internal fn bool MirInstructionRangeCallsOnlyFlaggedFunctions(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount, borrow IrTable<u32[0 max]> flags)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.Call || instr.Opcode() == MirOp.TailCall)
            {
                if (!FunctionIdFlagIsSet(flags, (u32[0 max])instr.Immediate()))
                {
                    return false;
                }
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return true;
}

internal fn bool FunctionIdLawMayReadMemory(borrow IrTable<FunctionEffectFacts> functionEffectFacts, u32[0 max] functionId)
{
    if (functionId == 0 || !functionEffectFacts.Contains(functionId))
    {
        return true;
    }

    stack FunctionEffectFacts facts = functionEffectFacts.Get(functionId);
    return !facts.IsLaw || facts.LawMayReadMemory;
}

internal fn bool MirInstructionRangeReadsMemoryWithFunctionEffects(
    borrow IrTable<MirInstruction> instrs,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.LoadGlobal || MirInstructionIsArenaRuntime(instr))
            {
                return true;
            }

            if (instr.Opcode() == MirOp.Call || instr.Opcode() == MirOp.TailCall)
            {
                if (FunctionIdLawMayReadMemory(functionEffectFacts, (u32[0 max])instr.Immediate()))
                {
                    return true;
                }
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangeCallsAnyLawMayReadMemory(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount, borrow IrTable<FunctionEffectFacts> functionEffectFacts)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.Call || instr.Opcode() == MirOp.TailCall)
            {
                if (FunctionIdLawMayReadMemory(functionEffectFacts, (u32[0 max])instr.Immediate()))
                {
                    return true;
                }
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangesReadMemoryWithFunctionEffects(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<BlockEmit> ranges,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeReadsMemoryWithFunctionEffects(instrs, ranges.Get(i).First, ranges.Get(i).Count, functionEffectFacts))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool MirInstructionRangesCallOnlyFlaggedFunctions(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges, borrow IrTable<u32[0 max]> flags)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (!MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, ranges.Get(i).First, ranges.Get(i).Count, flags))
        {
            return false;
        }

        i = i + 1;
    }

    return true;
}

internal fn bool MirInstructionRangesCallAnyLawMayReadMemory(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges, borrow IrTable<FunctionEffectFacts> functionEffectFacts)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeCallsAnyLawMayReadMemory(instrs, ranges.Get(i).First, ranges.Get(i).Count, functionEffectFacts))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn FunctionEffectFacts FunctionEffectsFromSignatureAndBody(
    borrow Compiler.Parsing.FunctionSignature signature,
    bool hasCall,
    bool readsMemory,
    bool writesMemory,
    bool callsOnlyLaw,
    bool callsAnyLawMayReadMemory,
    bool callsOnlyFinite,
    bool callsOnlyNoRecurse)
{
    stack mut FunctionEffectFacts facts = new();
    if (signature.LawKind() && !writesMemory && (!hasCall || callsOnlyLaw))
    {
        facts.IsLaw = true;
        facts.LawMayReadMemory = readsMemory || callsAnyLawMayReadMemory;
    }

    if (signature.FiniteKind() && (!hasCall || callsOnlyFinite))
    {
        facts.IsFinite = true;
    }

    if ((signature.FiniteKind() || signature.LawKind()) && (!hasCall || callsOnlyNoRecurse))
    {
        facts.IsNoRecurse = true;
    }

    return facts;
}

internal fn FunctionEffectFacts FunctionEffectsFromSignatureAndInstructionRange(
    borrow Compiler.Parsing.FunctionSignature signature,
    borrow IrTable<MirInstruction> instrs,
    u32[0 max] firstInstr,
    u32[0 max] instrCount)
{
    stack mut IrTable<u32[0 max]> noProofFlags = new();
    return FunctionEffectsFromSignatureAndBody(
        signature,
        MirInstructionRangeHasCall(instrs, firstInstr, instrCount),
        MirInstructionRangeReadsMemory(instrs, firstInstr, instrCount),
        MirInstructionRangeWritesMemory(instrs, firstInstr, instrCount),
        MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, firstInstr, instrCount, noProofFlags),
        MirInstructionRangeHasCall(instrs, firstInstr, instrCount),
        MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, firstInstr, instrCount, noProofFlags),
        MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, firstInstr, instrCount, noProofFlags));
}

internal fn FunctionEffectFacts FunctionEffectsFromSignatureAndInstructionRangeWithProofs(
    borrow Compiler.Parsing.FunctionSignature signature,
    borrow IrTable<MirInstruction> instrs,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    borrow IrTable<u32[0 max]> lawProofFlags,
    borrow IrTable<u32[0 max]> finiteProofFlags,
    borrow IrTable<u32[0 max]> noRecurseProofFlags)
{
    return FunctionEffectsFromSignatureAndBody(
        signature,
        MirInstructionRangeHasCall(instrs, firstInstr, instrCount),
        MirInstructionRangeReadsMemoryWithFunctionEffects(instrs, firstInstr, instrCount, functionEffectFacts),
        MirInstructionRangeWritesMemory(instrs, firstInstr, instrCount),
        MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, firstInstr, instrCount, lawProofFlags),
        MirInstructionRangeCallsAnyLawMayReadMemory(instrs, firstInstr, instrCount, functionEffectFacts),
        MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, firstInstr, instrCount, finiteProofFlags),
        MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, firstInstr, instrCount, noRecurseProofFlags));
}

internal fn FunctionEffectFacts FunctionEffectsFromSignatureAndBlockRanges(
    borrow Compiler.Parsing.FunctionSignature signature,
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<BlockEmit> ranges)
{
    stack mut IrTable<u32[0 max]> noProofFlags = new();
    return FunctionEffectsFromSignatureAndBody(
        signature,
        MirInstructionRangesHaveCall(instrs, ranges),
        MirInstructionRangesReadMemory(instrs, ranges),
        MirInstructionRangesWriteMemory(instrs, ranges),
        MirInstructionRangesCallOnlyFlaggedFunctions(instrs, ranges, noProofFlags),
        MirInstructionRangesHaveCall(instrs, ranges),
        MirInstructionRangesCallOnlyFlaggedFunctions(instrs, ranges, noProofFlags),
        MirInstructionRangesCallOnlyFlaggedFunctions(instrs, ranges, noProofFlags));
}

internal fn FunctionEffectFacts FunctionEffectsFromSignatureAndBlockRangesWithProofs(
    borrow Compiler.Parsing.FunctionSignature signature,
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<BlockEmit> ranges,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    borrow IrTable<u32[0 max]> lawProofFlags,
    borrow IrTable<u32[0 max]> finiteProofFlags,
    borrow IrTable<u32[0 max]> noRecurseProofFlags)
{
    return FunctionEffectsFromSignatureAndBody(
        signature,
        MirInstructionRangesHaveCall(instrs, ranges),
        MirInstructionRangesReadMemoryWithFunctionEffects(instrs, ranges, functionEffectFacts),
        MirInstructionRangesWriteMemory(instrs, ranges),
        MirInstructionRangesCallOnlyFlaggedFunctions(instrs, ranges, lawProofFlags),
        MirInstructionRangesCallAnyLawMayReadMemory(instrs, ranges, functionEffectFacts),
        MirInstructionRangesCallOnlyFlaggedFunctions(instrs, ranges, finiteProofFlags),
        MirInstructionRangesCallOnlyFlaggedFunctions(instrs, ranges, noRecurseProofFlags));
}

internal fn bool AppendFunctionEffectProofFlags(
    FunctionEffectFacts effects,
    mut borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    mut borrow IrTable<u32[0 max]> lawProofFlags,
    mut borrow IrTable<u32[0 max]> finiteProofFlags,
    mut borrow IrTable<u32[0 max]> noRecurseProofFlags)
{
    if (functionEffectFacts.Add(effects) == 0)
    {
        return false;
    }

    stack mut u32[0 max] lawFlag = 0;
    if (effects.IsLaw)
    {
        lawFlag = 1;
    }

    stack mut u32[0 max] finiteFlag = 0;
    if (effects.IsFinite)
    {
        finiteFlag = 1;
    }

    stack mut u32[0 max] noRecurseFlag = 0;
    if (effects.IsNoRecurse)
    {
        noRecurseFlag = 1;
    }

    if (lawProofFlags.Add(lawFlag) == 0)
    {
        return false;
    }

    if (finiteProofFlags.Add(finiteFlag) == 0)
    {
        return false;
    }

    if (noRecurseProofFlags.Add(noRecurseFlag) == 0)
    {
        return false;
    }

    return true;
}

internal fn bool AddBoolFlag(mut borrow IrTable<u32[0 max]> flags, bool value)
{
    stack mut u32[0 max] flag = 0;
    if (value)
    {
        flag = 1;
    }

    return flags.Add(flag) != 0;
}

internal fn bool CopyFlagTable(borrow IrTable<u32[0 max]> source, out IrTable<u32[0 max]> destination)
{
    stack mut IrTable<u32[0 max]> built = new();
    stack u64[0 2 ** 63 - 1] total = source.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (built.Add(source.Get(i)) == 0)
        {
            return false;
        }

        i = i + 1;
    }

    destination = built;
    return true;
}

internal fn bool BuildModuleFunctionTablesForEffectPrepass(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<MirFunction> funcs)
{
    stack u64[0 2 ** 63 - 1] tokenCount = stream.Count();
    stack mut u32[0 max] functionNumber = 0;
    stack mut u64[0 2 ** 63 - 1] f = 0;
    while willexit (f < tokenCount)
    {
        if (stream.KindAt(f) == TokenKind.Fn)
        {
            functionNumber = functionNumber + 1;
            stack u32[0 max] firstInstr = (u32[0 max])instrs.Count() + 1;
            stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
            stack bool isTailCallable = FunctionIdIsTailCallable(funcTailFlags, functionNumber);
            stack i64[min max] bodyBrace = FirstTokenOfKindAfter(stream, TokenKind.LBrace, f);
            stack mut LoweredBody body = new();
            if (bodyBrace >= 0 && stream.KindAt((u64[0 2 ** 63 - 1])bodyBrace + 1) == TokenKind.If)
            {
                if (!LowerModuleIfReturnFunctionToTables(
                    stream,
                    source,
                    funcNames,
                    funcParamCounts,
                    functionCallContractFacts,
                    funcTailFlags,
                    isTailCallable,
                    f,
                    instrs,
                    blocks,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithReturnIfExpression(stream, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleReturnIfExpressionFunctionToBlocks(
                    stream,
                    source,
                    funcNames,
                    funcParamCounts,
                    functionCallContractFacts,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithReturnedLocalIfExpression(stream, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleReturnedLocalIfExpressionFunctionToBlocks(
                    stream,
                    source,
                    funcNames,
                    funcParamCounts,
                    functionCallContractFacts,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithLocalIfExpressionInitializer(stream, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleLocalIfExpressionFunctionToBlocks(
                    stream,
                    source,
                    funcNames,
                    funcParamCounts,
                    functionCallContractFacts,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithReturnedLocalIfStatement(stream, source, funcNames, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleReturnedLocalIfStatementFunctionToBlocks(
                    stream,
                    source,
                    funcNames,
                    funcParamCounts,
                    functionCallContractFacts,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithLocalIfStatementAssignment(stream, source, funcNames, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleLocalIfStatementFunctionToBlocks(
                    stream,
                    source,
                    funcNames,
                    funcParamCounts,
                    functionCallContractFacts,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithCountingWhileLoop(stream, source, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleCountingLoopFunctionToBlocks(
                    stream,
                    source,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithAccumulatorWhileLoop(stream, source, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleAccumulatorLoopFunctionToBlocks(
                    stream,
                    source,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithHeaderCountingForLoop(stream, source, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleHeaderCountingForLoopFunctionToBlocks(
                    stream,
                    source,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithCountingForLoop(stream, source, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleCountingForLoopFunctionToBlocks(
                    stream,
                    source,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyHasLocalPrefixedTerminalIf(stream, f))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleLocalIfReturnFunctionToBlocks(
                    stream,
                    source,
                    funcNames,
                    funcParamCounts,
                    functionCallContractFacts,
                    funcTailFlags,
                    isTailCallable,
                    f,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else
            {
                body = LowerFunctionWithLocals(stream, source, funcNames, funcParamCounts, functionCallContractFacts, funcTailFlags, isTailCallable, f, instrs, blocks);
                if (!body.Ok)
                {
                    return false;
                }
            }

            stack u32[0 max] instrCount = (u32[0 max])instrs.Count() - (firstInstr - 1);
            stack u32[0 max] blockCount = (u32[0 max])blocks.Count() - (firstBlock - 1);
            stack MirFuncId functionId = MirDefineFunction(funcs, MirBlockIdOf(body.EntryBlock), MirBlockIdOf(firstBlock), blockCount, MirValueIdOf(firstInstr), instrCount);
            if (functionId.Index() != functionNumber)
            {
                return false;
            }
        }

        f = f + 1;
    }

    return (u64[0 2 ** 63 - 1])functionNumber == funcNames.Count();
}

internal fn bool BuildModuleEffectCandidateFlags(
    borrow TokenStream stream,
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirFunction> funcs,
    mut borrow IrTable<u32[0 max]> lawCandidates,
    mut borrow IrTable<u32[0 max]> finiteCandidates,
    mut borrow IrTable<u32[0 max]> noRecurseCandidates)
{
    stack u64[0 2 ** 63 - 1] tokenCount = stream.Count();
    stack mut u32[0 max] functionNumber = 0;
    stack mut u64[0 2 ** 63 - 1] f = 0;
    while willexit (f < tokenCount)
    {
        if (stream.KindAt(f) == TokenKind.Fn)
        {
            functionNumber = functionNumber + 1;
            if (!funcs.Contains(functionNumber))
            {
                return false;
            }

            stack mut Compiler.Parsing.FunctionSignature signature = new();
            if (!ParseFunctionSignatureAt(stream, (u32[0 max])f, signature))
            {
                return false;
            }

            stack MirFunction func = funcs.Get(functionNumber);
            stack bool writesMemory = MirInstructionRangeWritesMemory(instrs, func.FirstInstrIndex(), func.OwnedInstrCount());
            if (!AddBoolFlag(lawCandidates, signature.LawKind() && !writesMemory))
            {
                return false;
            }

            if (!AddBoolFlag(finiteCandidates, signature.FiniteKind()))
            {
                return false;
            }

            if (!AddBoolFlag(noRecurseCandidates, signature.FiniteKind() || signature.LawKind()))
            {
                return false;
            }
        }

        f = f + 1;
    }

    return (u64[0 2 ** 63 - 1])functionNumber == funcs.Count();
}

internal fn bool BuildNextDecreasingCallProofFlags(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<u32[0 max]> candidates,
    borrow IrTable<u32[0 max]> current,
    out IrTable<u32[0 max]> next,
    out bool changed)
{
    stack mut IrTable<u32[0 max]> built = new();
    changed = false;
    stack u64[0 2 ** 63 - 1] total = funcs.Count();
    stack mut u32[0 max] functionId = 1;
    while willexit ((u64[0 2 ** 63 - 1])functionId <= total)
    {
        stack MirFunction func = funcs.Get(functionId);
        stack bool value = FunctionIdFlagIsSet(candidates, functionId)
            && MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, func.FirstInstrIndex(), func.OwnedInstrCount(), current);
        if (!AddBoolFlag(built, value))
        {
            return false;
        }

        if (FunctionIdFlagIsSet(current, functionId) != value)
        {
            changed = true;
        }

        functionId = functionId + 1;
    }

    next = built;
    return true;
}

internal fn bool BuildNextIncreasingCallProofFlags(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<u32[0 max]> candidates,
    borrow IrTable<u32[0 max]> current,
    out IrTable<u32[0 max]> next,
    out bool changed)
{
    stack mut IrTable<u32[0 max]> built = new();
    changed = false;
    stack u64[0 2 ** 63 - 1] total = funcs.Count();
    stack mut u32[0 max] functionId = 1;
    while willexit ((u64[0 2 ** 63 - 1])functionId <= total)
    {
        stack MirFunction func = funcs.Get(functionId);
        stack bool value = FunctionIdFlagIsSet(current, functionId)
            || (FunctionIdFlagIsSet(candidates, functionId)
                && MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, func.FirstInstrIndex(), func.OwnedInstrCount(), current));
        if (!AddBoolFlag(built, value))
        {
            return false;
        }

        if (FunctionIdFlagIsSet(current, functionId) != value)
        {
            changed = true;
        }

        functionId = functionId + 1;
    }

    next = built;
    return true;
}

internal fn bool ComputeDecreasingCallProofFlags(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<u32[0 max]> candidates,
    out IrTable<u32[0 max]> flags)
{
    stack mut IrTable<u32[0 max]> current = new();
    if (!CopyFlagTable(candidates, current))
    {
        return false;
    }

    stack mut bool changed = true;
    stack u64[0 2 ** 63 - 1] total = funcs.Count();
    stack mut u64[0 2 ** 63 - 1] iteration = 0;
    while willexit (changed && iteration <= total)
    {
        stack mut IrTable<u32[0 max]> next = new();
        if (!BuildNextDecreasingCallProofFlags(instrs, funcs, candidates, current, next, changed))
        {
            return false;
        }

        current = next;
        iteration = iteration + 1;
    }

    if (changed)
    {
        return false;
    }

    flags = current;
    return true;
}

internal fn bool ComputeIncreasingCallProofFlags(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<u32[0 max]> candidates,
    out IrTable<u32[0 max]> flags)
{
    stack mut IrTable<u32[0 max]> current = new();
    stack u64[0 2 ** 63 - 1] total = funcs.Count();
    stack mut u32[0 max] seed = 1;
    while willexit ((u64[0 2 ** 63 - 1])seed <= total)
    {
        if (!AddBoolFlag(current, false))
        {
            return false;
        }

        seed = seed + 1;
    }

    stack mut bool changed = true;
    stack mut u64[0 2 ** 63 - 1] iteration = 0;
    while willexit (changed && iteration <= total)
    {
        stack mut IrTable<u32[0 max]> next = new();
        if (!BuildNextIncreasingCallProofFlags(instrs, funcs, candidates, current, next, changed))
        {
            return false;
        }

        current = next;
        iteration = iteration + 1;
    }

    if (changed)
    {
        return false;
    }

    flags = current;
    return true;
}

internal fn bool FunctionIdLawMayReadMemoryFromFlags(
    borrow IrTable<u32[0 max]> lawFlags,
    borrow IrTable<u32[0 max]> lawMayReadFlags,
    u32[0 max] functionId)
{
    if (!FunctionIdFlagIsSet(lawFlags, functionId))
    {
        return true;
    }

    return FunctionIdFlagIsSet(lawMayReadFlags, functionId);
}

internal fn bool MirInstructionRangeReadsMemoryWithLawMayReadFlags(
    borrow IrTable<MirInstruction> instrs,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    borrow IrTable<u32[0 max]> lawFlags,
    borrow IrTable<u32[0 max]> lawMayReadFlags)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.LoadGlobal || MirInstructionIsArenaRuntime(instr))
            {
                return true;
            }

            if (instr.Opcode() == MirOp.Call || instr.Opcode() == MirOp.TailCall)
            {
                if (FunctionIdLawMayReadMemoryFromFlags(lawFlags, lawMayReadFlags, (u32[0 max])instr.Immediate()))
                {
                    return true;
                }
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool BuildNextLawMayReadFlags(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<u32[0 max]> lawFlags,
    borrow IrTable<u32[0 max]> current,
    out IrTable<u32[0 max]> next,
    out bool changed)
{
    stack mut IrTable<u32[0 max]> built = new();
    changed = false;
    stack u64[0 2 ** 63 - 1] total = funcs.Count();
    stack mut u32[0 max] functionId = 1;
    while willexit ((u64[0 2 ** 63 - 1])functionId <= total)
    {
        stack mut bool value = false;
        if (FunctionIdFlagIsSet(lawFlags, functionId))
        {
            stack MirFunction func = funcs.Get(functionId);
            value = MirInstructionRangeReadsMemoryWithLawMayReadFlags(
                instrs,
                func.FirstInstrIndex(),
                func.OwnedInstrCount(),
                lawFlags,
                current);
        }

        if (!AddBoolFlag(built, value))
        {
            return false;
        }

        if (FunctionIdFlagIsSet(current, functionId) != value)
        {
            changed = true;
        }

        functionId = functionId + 1;
    }

    next = built;
    return true;
}

internal fn bool ComputeLawMayReadFlags(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<u32[0 max]> lawFlags,
    out IrTable<u32[0 max]> flags)
{
    stack mut IrTable<u32[0 max]> current = new();
    stack u64[0 2 ** 63 - 1] total = funcs.Count();
    stack mut u32[0 max] seed = 1;
    while willexit ((u64[0 2 ** 63 - 1])seed <= total)
    {
        if (!AddBoolFlag(current, false))
        {
            return false;
        }

        seed = seed + 1;
    }

    stack mut bool changed = true;
    stack mut u64[0 2 ** 63 - 1] iteration = 0;
    while willexit (changed && iteration <= total)
    {
        stack mut IrTable<u32[0 max]> next = new();
        if (!BuildNextLawMayReadFlags(instrs, funcs, lawFlags, current, next, changed))
        {
            return false;
        }

        current = next;
        iteration = iteration + 1;
    }

    if (changed)
    {
        return false;
    }

    flags = current;
    return true;
}

internal fn bool BuildFunctionEffectFactsFromFlags(
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<u32[0 max]> lawFlags,
    borrow IrTable<u32[0 max]> lawMayReadFlags,
    borrow IrTable<u32[0 max]> finiteFlags,
    borrow IrTable<u32[0 max]> noRecurseFlags,
    out IrTable<FunctionEffectFacts> functionEffectFacts)
{
    stack mut IrTable<FunctionEffectFacts> built = new();
    stack u64[0 2 ** 63 - 1] total = funcs.Count();
    stack mut u32[0 max] functionId = 1;
    while willexit ((u64[0 2 ** 63 - 1])functionId <= total)
    {
        stack mut FunctionEffectFacts facts = new();
        facts.IsLaw = FunctionIdFlagIsSet(lawFlags, functionId);
        facts.LawMayReadMemory = facts.IsLaw && FunctionIdFlagIsSet(lawMayReadFlags, functionId);
        facts.IsFinite = FunctionIdFlagIsSet(finiteFlags, functionId);
        facts.IsNoRecurse = FunctionIdFlagIsSet(noRecurseFlags, functionId);
        if (built.Add(facts) == 0)
        {
            return false;
        }

        functionId = functionId + 1;
    }

    functionEffectFacts = built;
    return true;
}

// Emits `define <ret> @name(<params>) { <block>* }` over an arbitrary ordered list of
// blocks — the general form behind `EmitLlvmDiamond` (4 blocks) and the loop/nested-if
// shapes (any number). Each descriptor's terminator comes from the block table, so any
// CFG (branches, back-edges, multi-way merges) emits as long as the blocks carry the
// right terminators and the descriptors list them in the desired output order.
public fn MemoryStatus EmitLlvmBlocks(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] paramCount, borrow IrTable<BlockEmit> ranges, mut borrow OwnedAscii sink)
{
    stack mut IrTable<u32[0 max]> noTailCallees = new();
    return EmitLlvmBlocksWithTailCallees(instrs, noTailCallees, blocks, name, false, paramCount, ranges, sink);
}

public fn MemoryStatus EmitLlvmBlocksWithTailCallees(borrow IrTable<MirInstruction> instrs, borrow IrTable<u32[0 max]> funcTailFlags, borrow IrTable<MirBlock> blocks, const ascii name, bool isTailCallable, u32[0 max] paramCount, borrow IrTable<BlockEmit> ranges, mut borrow OwnedAscii sink)
{
    try EmitLlvmArenaRuntimePreambleForRanges(instrs, ranges, sink);

    if (isTailCallable)
    {
        try sink.AppendConstAscii("define tailcc ");
    }
    else
    {
        try sink.AppendConstAscii("define ");
    }

    try EmitLlvmTypeName(MirBlockRangesScalarReturnType(instrs, blocks, ranges), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try EmitLlvmTypedParamList(instrs, paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        try EmitLlvmLabeledBlockWithTailCallees(instrs, funcTailFlags, blocks, ranges.Get(i).BlockIndex, ranges.Get(i).First, ranges.Get(i).Count, sink);
        i = i + 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmBlocksWithRangeFactsCore(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<MirBlock> blocks,
    const ascii name,
    bool isTailCallable,
    ValueFacts returnFacts,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    borrow IrTable<DistinctStoragePair> separateStorageFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    FunctionEffectFacts functionEffects,
    u32[0 max] paramCount,
    borrow IrTable<BlockEmit> ranges,
    mut borrow OwnedAscii sink)
    where overlap(funcTailFlags, paramAbiFacts), overlap(paramAbiFacts, functionReturnFacts)
{
    try EmitLlvmArenaRuntimePreambleForRanges(instrs, ranges, sink);

    try sink.AppendConstAscii("define");
    try EmitLlvmDefinitionLinkage(FunctionLinkageFactsAt(functionLinkageFacts, 1), sink);
    try EmitLlvmDefinitionCallingConvention(isTailCallable, FunctionCallingConventionFactsAt(functionCallingConventionFacts, 1), sink);

    stack MirType returnType = MirBlockRangesScalarReturnType(instrs, blocks, ranges);
    try EmitLlvmRangeAttribute(returnType, returnFacts, sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmTypeName(returnType, sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try EmitLlvmParamListWithRangeAndAbiFacts(instrs, paramCount, paramFacts, paramAbiFacts, sink);
    try EmitLlvmFunctionEffectAttributes(functionEffects, sink);
    try sink.AppendConstAscii(" {\n");
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        try EmitLlvmLabeledBlockWithRangeFactsAndSeparateStorage(
            instrs,
            funcTailFlags,
            functionEffectFacts,
            functionCallContractFacts,
            functionCallingConventionFacts,
            paramFacts,
            valueFacts,
            globalFacts,
            functionReturnFacts,
            rangeMetadata,
            separateStorageFacts,
            i == 1,
            blocks,
            ranges.Get(i).BlockIndex,
            ranges.Get(i).First,
            ranges.Get(i).Count,
            LlvmLoopMetadataBase(),
            sink);
        i = i + 1;
    }

    try sink.AppendConstAscii("}\n");
    try EmitLlvmIndependentLoopMetadataDefinitions(blocks, ranges, LlvmLoopMetadataBase(), sink);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmBlocksWithRangeFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    const ascii name,
    ValueFacts returnFacts,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    u32[0 max] paramCount,
    borrow IrTable<BlockEmit> ranges,
    mut borrow OwnedAscii sink)
{
    stack mut IrTable<u32[0 max]> noTailCallees = new();
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut IrTable<ParamAbiFacts> noParamAbiFacts = new();
    stack mut IrTable<DistinctStoragePair> noSeparateStorageFacts = new();
    try EmitLlvmBlocksWithRangeFactsCore(
        instrs,
        noTailCallees,
        noFunctionEffectFacts,
        noFunctionCallContractFacts,
        noFunctionLinkageFacts,
        noFunctionCallingConventionFacts,
        blocks,
        name,
        false,
        returnFacts,
        paramFacts,
        noParamAbiFacts,
        noSeparateStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        NoFunctionEffectFacts(),
        paramCount,
        ranges,
        sink);
    try EmitLlvmRangeMetadataDefinitions(rangeMetadata, sink);
    return MemoryStatus.Ok;
}

// Like `EmitLlvmBlocks` but emits a NUMBERED function name `@<prefix><number>` (e.g. `@f3`)
// instead of a fixed name — the multi-block counterpart of `EmitLlvmNumberedFunction`, so a
// module function (`@fN`) can have an arbitrary block list (a branch, a loop), not just one
// block.
public fn MemoryStatus EmitLlvmBlocksNumbered(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii prefix, u32[0 max] number, u32[0 max] paramCount, borrow IrTable<BlockEmit> ranges, mut borrow OwnedAscii sink)
{
    stack mut IrTable<u32[0 max]> noTailCallees = new();
    return EmitLlvmBlocksNumberedWithTailCallees(instrs, noTailCallees, blocks, prefix, number, false, paramCount, ranges, sink);
}

public fn MemoryStatus EmitLlvmBlocksNumberedWithTailCallees(borrow IrTable<MirInstruction> instrs, borrow IrTable<u32[0 max]> funcTailFlags, borrow IrTable<MirBlock> blocks, const ascii prefix, u32[0 max] number, bool isTailCallable, u32[0 max] paramCount, borrow IrTable<BlockEmit> ranges, mut borrow OwnedAscii sink)
{
    if (isTailCallable)
    {
        try sink.AppendConstAscii("define tailcc ");
    }
    else
    {
        try sink.AppendConstAscii("define ");
    }

    try EmitLlvmTypeName(MirBlockRangesScalarReturnType(instrs, blocks, ranges), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(prefix);
    try sink.AppendU64((u64[0 max])number);
    try EmitLlvmTypedParamList(instrs, paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        try EmitLlvmLabeledBlockWithTailCallees(instrs, funcTailFlags, blocks, ranges.Get(i).BlockIndex, ranges.Get(i).First, ranges.Get(i).Count, sink);
        i = i + 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmBlocksNumberedWithRangeFactsCore(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<MirBlock> blocks,
    const ascii prefix,
    u32[0 max] number,
    bool isTailCallable,
    ValueFacts returnFacts,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    borrow IrTable<DistinctStoragePair> separateStorageFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    FunctionEffectFacts functionEffects,
    u32[0 max] paramCount,
    borrow IrTable<BlockEmit> ranges,
    mut borrow OwnedAscii sink)
    where overlap(funcTailFlags, paramAbiFacts), overlap(paramAbiFacts, functionReturnFacts)
{
    try sink.AppendConstAscii("define");
    try EmitLlvmDefinitionLinkage(FunctionLinkageFactsAt(functionLinkageFacts, number), sink);
    try EmitLlvmDefinitionCallingConvention(isTailCallable, FunctionCallingConventionFactsAt(functionCallingConventionFacts, number), sink);

    stack MirType returnType = MirBlockRangesScalarReturnType(instrs, blocks, ranges);
    try EmitLlvmRangeAttribute(returnType, returnFacts, sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmTypeName(returnType, sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(prefix);
    try sink.AppendU64((u64[0 max])number);
    try EmitLlvmParamListWithRangeAndAbiFacts(instrs, paramCount, paramFacts, paramAbiFacts, sink);
    try EmitLlvmFunctionEffectAttributes(functionEffects, sink);
    try sink.AppendConstAscii(" {\n");
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        try EmitLlvmLabeledBlockWithRangeFactsAndSeparateStorage(
            instrs,
            funcTailFlags,
            functionEffectFacts,
            functionCallContractFacts,
            functionCallingConventionFacts,
            paramFacts,
            valueFacts,
            globalFacts,
            functionReturnFacts,
            rangeMetadata,
            separateStorageFacts,
            i == 1,
            blocks,
            ranges.Get(i).BlockIndex,
            ranges.Get(i).First,
            ranges.Get(i).Count,
            LlvmLoopMetadataBase() + number * 1000,
            sink);
        i = i + 1;
    }

    try sink.AppendConstAscii("}\n");
    try EmitLlvmIndependentLoopMetadataDefinitions(blocks, ranges, LlvmLoopMetadataBase() + number * 1000, sink);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmDiamond(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] paramCount, u32[0 max] entryBlock, u32[0 max] entryFirst, u32[0 max] entryCount, u32[0 max] thenBlock, u32[0 max] thenFirst, u32[0 max] thenCount, u32[0 max] elseBlock, u32[0 max] elseFirst, u32[0 max] elseCount, u32[0 max] mergeBlock, u32[0 max] mergeFirst, u32[0 max] mergeCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(name);
    try EmitLlvmParamList(paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlock, entryFirst, entryCount, sink);
    try EmitLlvmLabeledBlock(instrs, blocks, thenBlock, thenFirst, thenCount, sink);
    try EmitLlvmLabeledBlock(instrs, blocks, elseBlock, elseFirst, elseCount, sink);
    try EmitLlvmLabeledBlock(instrs, blocks, mergeBlock, mergeFirst, mergeCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// === Module emission ===
// Emits a whole LLVM module: one `define` per function in the function table,
// named `@fN` (N = the function's 1-based id). PRECONDITION: each function is
// single-block — only its entry block is emitted (over the whole instruction range),
// and `OwnedBlockCount` is NOT consulted, so a function recorded with more than one
// block would silently drop its non-entry blocks. Multi-block-per-function emission
// (iterating the owned block range, each block over its own instruction sub-range)
// is a later slice once the model records per-block instruction ranges; it reuses
// `EmitLlvmLabeledBlock`.

// Emits `define <ret> @<prefix><number>() { <entry block> }`.
internal fn MemoryStatus EmitLlvmDefinitionNumbered(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii prefix, u32[0 max] number, u32[0 max] entryBlockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define ");
    try EmitLlvmTypeName(MirBlockScalarReturnType(instrs, blocks, entryBlockIndex), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(prefix);
    try sink.AppendU64((u64[0 max])number);
    try sink.AppendConstAscii("() {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Emits an LLVM module: one single-block `define` per function in `funcs`, in id
// order, each a single-block definition over its entry block. An empty table emits
// nothing.
public fn MemoryStatus EmitLlvmModule(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction f = funcs.Get(id);
        try EmitLlvmDefinitionNumbered(instrs, blocks, "f", id, f.EntryIndex(), f.FirstInstrIndex(), f.OwnedInstrCount(), sink);
        id = id + 1;
    }

    return MemoryStatus.Ok;
}

// Verify-then-emit: a phase-boundary gate that runs `MirFunctionWellFormed` over EVERY
// function in the module and emits the LLVM ONLY if all are structurally well-formed. A
// malformed function (a dangling reference, an unterminated block) is rejected before any
// output, so the back end never emits corrupt IR. Returns false on a malformed module OR an
// emit failure; true on a clean emit — the canonical "validate at the phase boundary, then
// lower" shape for the MIR-function-table codegen path.
public fn bool EmitLlvmModuleVerified(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction f = funcs.Get(id);
        if (!MirFunctionWellFormed(instrs, blocks, f))
        {
            return false;
        }

        id = id + 1;
    }

    switch (EmitLlvmModule(instrs, blocks, funcs, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

// === Module-level globals ===
// A module global variable with a scalar initializer, named `@gN` (N = its 1-based
// id in an `IrTable<MirGlobal>`). Flat record + free functions, like the rest of MIR.

public struct MirGlobal
{
    MirType TypeValue;
    i64[min max] Init;

    MirGlobal()
    {
        self.TypeValue = MirType.I64;
        self.Init = 0;
    }

    public inline finite law MirType StoredType(borrow MirGlobal self)
    {
        return self.TypeValue;
    }

    public inline finite law i64[min max] InitialValue(borrow MirGlobal self)
    {
        return self.Init;
    }
}

internal inline finite law u32[0 max] MirGlobalRecordSize()
{
    return 9;
}

internal finite law bool MirGlobalInitialValueFitsType(MirType type, i64[min max] value)
{
    switch (type)
    {
        case MirType.I1:
            return value == 0 || value == 1;
        case MirType.I32:
            return value >= (i64[min max])(-(2 ** 31))
                && value <= 2147483647;
        case MirType.I64:
            return true;
        case MirType.Ptr:
            return true;
    }
}

internal fn u32[0 max] MirDefineGlobalUnchecked(mut borrow IrTable<MirGlobal> globals, MirType type, i64[min max] value)
{
    stack mut MirGlobal g = new();
    g.TypeValue = type;
    g.Init = value;
    return globals.Add(g);
}

// Records a global with integer initializer `value`, returning its 1-based id.
public fn u32[0 max] MirDefineGlobal(mut borrow IrTable<MirGlobal> globals, i64[min max] value)
{
    return MirDefineGlobalTyped(globals, MirType.I64, value);
}

// Records a typed scalar global initializer, returning 0 when the value cannot
// be represented by the declared MIR storage type.
public fn u32[0 max] MirDefineGlobalTyped(mut borrow IrTable<MirGlobal> globals, MirType type, i64[min max] value)
{
    if (!MirGlobalInitialValueFitsType(type, value))
    {
        return 0;
    }

    return MirDefineGlobalUnchecked(globals, type, value);
}

// The declared MIR storage type of global `id` (`I64` when out of range).
public fn MirType MirGlobalType(borrow IrTable<MirGlobal> globals, u32[0 max] id)
{
    if (!globals.Contains(id))
    {
        return MirType.I64;
    }

    stack MirGlobal g = globals.Get(id);
    return g.StoredType();
}

// The initializer of global `id` (0 when out of range).
public fn i64[min max] MirGlobalInitialValue(borrow IrTable<MirGlobal> globals, u32[0 max] id)
{
    if (!globals.Contains(id))
    {
        return 0;
    }

    stack MirGlobal g = globals.Get(id);
    return g.InitialValue();
}

internal fn MemoryStatus EmitLlvmGlobalInitializer(MirType type, i64[min max] value, mut borrow OwnedAscii sink)
{
    if (type == MirType.Ptr)
    {
        if (value == 0)
        {
            try sink.AppendConstAscii("null");
        }
        else
        {
            try sink.AppendConstAscii("inttoptr (i64 ");
            try sink.AppendI64(value);
            try sink.AppendConstAscii(" to ptr)");
        }

        return MemoryStatus.Ok;
    }

    try sink.AppendI64(value);
    return MemoryStatus.Ok;
}

// Emits one `@gN = global <type> V` line per global in id order (empty table -> nothing).
public fn MemoryStatus EmitLlvmGlobals(borrow IrTable<MirGlobal> globals, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = globals.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirGlobal g = globals.Get(id);
        try sink.AppendConstAscii("@g");
        try sink.AppendU64((u64[0 max])id);
        try sink.AppendConstAscii(" = global ");
        try EmitLlvmTypeName(g.StoredType(), sink);
        try sink.AppendConstAscii(" ");
        try EmitLlvmGlobalInitializer(g.StoredType(), g.InitialValue(), sink);
        try sink.AppendConstAscii("\n");
        id = id + 1;
    }

    return MemoryStatus.Ok;
}

// Emits a complete module: globals first, then function definitions.
public fn MemoryStatus EmitLlvmModuleWithGlobals(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, borrow IrTable<MirGlobal> globals, mut borrow OwnedAscii sink)
{
    try EmitLlvmGlobals(globals, sink);
    try EmitLlvmModule(instrs, blocks, funcs, sink);
    return MemoryStatus.Ok;
}

// === Typed function emission (types beyond i64) ===
// A parallel straight-line emitter that spells each value's `MirType` instead of the
// hardcoded `i64` of the untyped emitters. The function's return type is derived from
// the trailing `Return` instruction's value, so a uniform-typed (e.g. i32) function
// emits its type throughout. Untyped instructions default to `I64`, so this path
// reproduces the i64 output for default values. Handles the const/arith/return subset.

// `  %vDst = <mnemonic> <type> <a>, <b>`, spelling `type` instead of a fixed `i64`.
internal fn MemoryStatus EmitLlvmTypedBinary(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] dst, const ascii mnemonic, MirType t, u32[0 max] a, u32[0 max] b)
{
    try sink.AppendConstAscii("  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(" = ");
    try sink.AppendConstAscii(mnemonic);
    try sink.AppendConstAscii(" ");
    try EmitLlvmTypeName(t, sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmOperand(instrs, sink, a);
    try sink.AppendConstAscii(", ");
    try EmitLlvmOperand(instrs, sink, b);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmTypedComparison(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] dst, const ascii predicate, u32[0 max] a, u32[0 max] b)
{
    try sink.AppendConstAscii("  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(" = icmp ");
    try sink.AppendConstAscii(predicate);
    try sink.AppendConstAscii(" ");
    try EmitLlvmTypeName(MirValueType(instrs, a), sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmOperand(instrs, sink, a);
    try sink.AppendConstAscii(", ");
    try EmitLlvmOperand(instrs, sink, b);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmSaturatingBinary(
    borrow IrTable<MirInstruction> instrs,
    mut borrow OwnedAscii sink,
    u32[0 max] dst,
    const ascii mnemonic,
    MirType type,
    u32[0 max] a,
    u32[0 max] b)
{
    stack mut ascii wideType = "i64";
    stack mut i64[min max] lower = (i64[min max])(-(2 ** 31));
    stack mut i64[min max] upper = 2147483647;
    if (type == MirType.I64)
    {
        wideType = "i128";
        lower = I64MinValue();
        upper = I64MaxValue();
    }
    else if (type != MirType.I32)
    {
        return MemoryStatus.Ok;
    }

    try sink.AppendConstAscii("  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".wleft = sext ");
    try EmitLlvmTypeName(type, sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmOperand(instrs, sink, a);
    try sink.AppendConstAscii(" to ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii("\n  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".wright = sext ");
    try EmitLlvmTypeName(type, sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmOperand(instrs, sink, b);
    try sink.AppendConstAscii(" to ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii("\n  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".wide = ");
    try sink.AppendConstAscii(mnemonic);
    try sink.AppendConstAscii(" ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii(" ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".wleft, ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".wright\n  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".low = icmp slt ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii(" ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".wide, ");
    try sink.AppendI64(lower);
    try sink.AppendConstAscii("\n  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".high = icmp sgt ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii(" ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".wide, ");
    try sink.AppendI64(upper);
    try sink.AppendConstAscii("\n  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".clow = select i1 ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".low, ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii(" ");
    try sink.AppendI64(lower);
    try sink.AppendConstAscii(", ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii(" ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".wide\n  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".clamp = select i1 ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".high, ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii(" ");
    try sink.AppendI64(upper);
    try sink.AppendConstAscii(", ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii(" ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".clow\n  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(" = trunc ");
    try sink.AppendAscii(wideType);
    try sink.AppendConstAscii(" ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(".clamp to ");
    try EmitLlvmTypeName(type, sink);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmTypedCallArg(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] valueIndex)
{
    try EmitLlvmTypeName(MirValueType(instrs, valueIndex), sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmOperand(instrs, sink, valueIndex);
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmTypedCallArgs(
    borrow IrTable<MirInstruction> instrs,
    mut borrow OwnedAscii sink,
    u32[0 max] a,
    u32[0 max] b,
    u32[0 max] c,
    u32[0 max] d)
{
    try sink.AppendConstAscii("(");
    if (a != 0)
    {
        try EmitLlvmTypedCallArg(instrs, sink, a);
    }

    if (b != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmTypedCallArg(instrs, sink, b);
    }

    if (c != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmTypedCallArg(instrs, sink, c);
    }

    if (d != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmTypedCallArg(instrs, sink, d);
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

// Emits the typed LLVM line for the instruction at `index`; unsupported opcodes emit
// nothing until their typed lowering slice lands.
internal fn MemoryStatus EmitLlvmTypedInstruction(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] index)
{
    if (!instrs.Contains(index))
    {
        return MemoryStatus.Ok;
    }

    stack MirInstruction instr = instrs.Get(index);
    switch (instr.Opcode())
    {
        case MirOp.ConstInt:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            if (instr.ResultType() == MirType.Ptr)
            {
                try sink.AppendConstAscii(" = inttoptr i64 ");
                try sink.AppendI64(instr.Immediate());
                try sink.AppendConstAscii(" to ptr\n");
            }
            else
            {
                try sink.AppendConstAscii(" = add ");
                try EmitLlvmTypeName(instr.ResultType(), sink);
                try sink.AppendConstAscii(" 0, ");
                try sink.AppendI64(instr.Immediate());
                try sink.AppendConstAscii("\n");
            }
        case MirOp.Add:
            try EmitLlvmTypedBinary(instrs, sink, index, "add", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Sub:
            try EmitLlvmTypedBinary(instrs, sink, index, "sub", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Mul:
            try EmitLlvmTypedBinary(instrs, sink, index, "mul", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingAdd:
            try EmitLlvmTypedBinary(instrs, sink, index, "add", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingSub:
            try EmitLlvmTypedBinary(instrs, sink, index, "sub", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingMul:
            try EmitLlvmTypedBinary(instrs, sink, index, "mul", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingAdd:
            try EmitLlvmSaturatingBinary(instrs, sink, index, "add", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingSub:
            try EmitLlvmSaturatingBinary(instrs, sink, index, "sub", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingMul:
            try EmitLlvmSaturatingBinary(instrs, sink, index, "mul", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SDiv:
            try EmitLlvmTypedBinary(instrs, sink, index, "sdiv", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.UDiv:
            try EmitLlvmTypedBinary(instrs, sink, index, "udiv", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SRem:
            try EmitLlvmTypedBinary(instrs, sink, index, "srem", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.And:
            try EmitLlvmTypedBinary(instrs, sink, index, "and", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Or:
            try EmitLlvmTypedBinary(instrs, sink, index, "or", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Xor:
            try EmitLlvmTypedBinary(instrs, sink, index, "xor", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Shl:
            try EmitLlvmTypedBinary(instrs, sink, index, "shl", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.AShr:
            try EmitLlvmTypedBinary(instrs, sink, index, "ashr", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpEq:
            try EmitLlvmTypedComparison(instrs, sink, index, "eq", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpNe:
            try EmitLlvmTypedComparison(instrs, sink, index, "ne", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLt:
            try EmitLlvmTypedComparison(instrs, sink, index, "slt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLe:
            try EmitLlvmTypedComparison(instrs, sink, index, "sle", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGt:
            try EmitLlvmTypedComparison(instrs, sink, index, "sgt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGe:
            try EmitLlvmTypedComparison(instrs, sink, index, "sge", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.LoadGlobal:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = load ");
            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(", ptr @g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.StoreGlobal:
            try sink.AppendConstAscii("  store ");
            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", ptr @g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.Call:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = call ");
            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(" @f");
            try sink.AppendI64(instr.Immediate());
            try EmitLlvmTypedCallArgs(
                instrs,
                sink,
                instr.OperandAIndex(),
                instr.OperandBIndex(),
                instr.OperandCIndex(),
                instr.OperandDIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.Return:
            try sink.AppendConstAscii("  ret ");
            try EmitLlvmTypeName(MirValueType(instrs, instr.OperandAIndex()), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
        default:
            try sink.AppendConstAscii("");
    }

    return MemoryStatus.Ok;
}

// The return type of a typed function: the type of the value returned by its trailing
// `Return` instruction (`I64` if absent / out of range).
internal fn MirType TypedFunctionReturnType(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    if (instrCount == 0)
    {
        return MirType.I64;
    }

    stack u32[0 max] lastIndex = firstInstr + instrCount - 1;
    if (!instrs.Contains(lastIndex))
    {
        return MirType.I64;
    }

    stack MirInstruction last = instrs.Get(lastIndex);
    if (last.Opcode() != MirOp.Return)
    {
        return MirType.I64;
    }

    return MirValueType(instrs, last.OperandAIndex());
}

// Emits `define <retType> @name() { entry: <typed instructions> }` for the
// instruction range [firstInstr, firstInstr+instrCount), spelling each value's type.
public fn MemoryStatus EmitLlvmTypedFunction(borrow IrTable<MirInstruction> instrs, const ascii name, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define ");
    try EmitLlvmTypeName(TypedFunctionReturnType(instrs, firstInstr, instrCount), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try sink.AppendConstAscii("() {\nentry:\n");
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitLlvmTypedInstruction(instrs, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Emits a typed LLVM function with a typed parameter list.
public fn MemoryStatus EmitLlvmTypedFunctionWithParams(
    borrow IrTable<MirInstruction> instrs,
    const ascii name,
    u32[0 max] paramCount,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define ");
    try EmitLlvmTypeName(TypedFunctionReturnType(instrs, firstInstr, instrCount), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try EmitLlvmTypedParamList(instrs, paramCount, sink);
    try sink.AppendConstAscii(" {\nentry:\n");
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitLlvmTypedInstruction(instrs, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Emits a typed LLVM function with typed parameter range facts.
public fn MemoryStatus EmitLlvmTypedFunctionWithParamFacts(
    borrow IrTable<MirInstruction> instrs,
    const ascii name,
    u32[0 max] paramCount,
    borrow IrTable<ValueFacts> paramFacts,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define ");
    try EmitLlvmTypeName(TypedFunctionReturnType(instrs, firstInstr, instrCount), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try EmitLlvmTypedParamListWithRangeFacts(instrs, paramCount, paramFacts, sink);
    try sink.AppendConstAscii(" {\nentry:\n");
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitLlvmTypedInstruction(instrs, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// === MIR text disassembler ===
// A readable dump of the MIR instruction stream (the textual core of an `inspect`
// tool). MIR operands are spelled `vN` (the raw value id) uniformly — the LLVM
// `%pK` parameter distinction is an LLVM-emission concern, not a MIR-level one.

// Appends a MIR value reference `vN`.
internal fn MemoryStatus EmitMirValue(mut borrow OwnedAscii sink, u32[0 max] index)
{
    try sink.AppendConstAscii("v");
    try sink.AppendU64((u64[0 max])index);
    return MemoryStatus.Ok;
}

// Appends `  vDst = <mnemonic> vA, vB` for a binary op / comparison.
internal fn MemoryStatus EmitMirBinaryLine(mut borrow OwnedAscii sink, u32[0 max] dst, const ascii mnemonic, u32[0 max] a, u32[0 max] b)
{
    try EmitMirValue(sink, dst);
    try sink.AppendConstAscii(" = ");
    try sink.AppendConstAscii(mnemonic);
    try sink.AppendConstAscii(" ");
    try EmitMirValue(sink, a);
    try sink.AppendConstAscii(", ");
    try EmitMirValue(sink, b);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

// Appends the MIR text line for the instruction at 1-based `index`.
internal fn MemoryStatus EmitMirInstruction(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] index)
{
    if (!instrs.Contains(index))
    {
        return MemoryStatus.Ok;
    }

    stack MirInstruction instr = instrs.Get(index);
    switch (instr.Opcode())
    {
        case MirOp.ConstInt:
            try EmitMirValue(sink, index);
            if (instr.ResultType() == MirType.Ptr)
            {
                try sink.AppendConstAscii(" = const-null ptr\n");
            }
            else
            {
                try sink.AppendConstAscii(" = const ");
                try sink.AppendI64(instr.Immediate());
                try sink.AppendConstAscii("\n");
            }
        case MirOp.Param:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = param ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.Add:
            try EmitMirBinaryLine(sink, index, "add", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Sub:
            try EmitMirBinaryLine(sink, index, "sub", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Mul:
            try EmitMirBinaryLine(sink, index, "mul", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingAdd:
            try EmitMirBinaryLine(sink, index, "wrap-add", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingSub:
            try EmitMirBinaryLine(sink, index, "wrap-sub", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingMul:
            try EmitMirBinaryLine(sink, index, "wrap-mul", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingAdd:
            try EmitMirBinaryLine(sink, index, "sat-add", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingSub:
            try EmitMirBinaryLine(sink, index, "sat-sub", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingMul:
            try EmitMirBinaryLine(sink, index, "sat-mul", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SDiv:
            try EmitMirBinaryLine(sink, index, "sdiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.UDiv:
            try EmitMirBinaryLine(sink, index, "udiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SRem:
            try EmitMirBinaryLine(sink, index, "srem", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.And:
            try EmitMirBinaryLine(sink, index, "and", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Or:
            try EmitMirBinaryLine(sink, index, "or", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Xor:
            try EmitMirBinaryLine(sink, index, "xor", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Shl:
            try EmitMirBinaryLine(sink, index, "shl", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.AShr:
            try EmitMirBinaryLine(sink, index, "ashr", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpEq:
            try EmitMirBinaryLine(sink, index, "eq", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpNe:
            try EmitMirBinaryLine(sink, index, "ne", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLt:
            try EmitMirBinaryLine(sink, index, "slt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLe:
            try EmitMirBinaryLine(sink, index, "sle", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGt:
            try EmitMirBinaryLine(sink, index, "sgt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGe:
            try EmitMirBinaryLine(sink, index, "sge", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.ZExt:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = zext ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.LoadGlobal:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = load g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.StoreGlobal:
            try sink.AppendConstAscii("store g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.ArenaFrameEnter:
            try sink.AppendConstAscii("arena-frame.enter\n");
        case MirOp.ArenaAlloc:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = arena.alloc ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", align ");
            try sink.AppendU64((u64[0 max])instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.ArenaDynamicStorageInit:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = arena.dynamic.init capacity ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", element ");
            try sink.AppendU64((u64[0 max])instr.OperandAIndex());
            try sink.AppendConstAscii(", align ");
            try sink.AppendU64((u64[0 max])instr.OperandBIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.ArenaDynamicStorageReserve:
            try sink.AppendConstAscii("arena.dynamic.reserve ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", additional ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", element ");
            try sink.AppendU64((u64[0 max])instr.OperandBIndex());
            try sink.AppendConstAscii(", align ");
            try sink.AppendU64((u64[0 max])instr.OperandCIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.ArenaDynamicStorageTryReserve:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = arena.dynamic.try-reserve ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", additional ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", element ");
            try sink.AppendU64((u64[0 max])instr.OperandBIndex());
            try sink.AppendConstAscii(", align ");
            try sink.AppendU64((u64[0 max])instr.OperandCIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.ArenaDynamicStorageTryReserveCapacity:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = arena.dynamic.try-reserve-capacity ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", capacity ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", element ");
            try sink.AppendU64((u64[0 max])instr.OperandBIndex());
            try sink.AppendConstAscii(", align ");
            try sink.AppendU64((u64[0 max])instr.OperandCIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.ArenaFrameLeave:
            try sink.AppendConstAscii("arena-frame.leave\n");
        case MirOp.Phi:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = phi ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii("@b");
            try sink.AppendU64((u64[0 max])DecodePhiBlock0(instr.Immediate()));
            try sink.AppendConstAscii(", ");
            try EmitMirValue(sink, instr.OperandBIndex());
            try sink.AppendConstAscii("@b");
            try sink.AppendU64((u64[0 max])DecodePhiBlock1(instr.Immediate()));
            try sink.AppendConstAscii("\n");
        case MirOp.Call:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = call f");
            try sink.AppendI64(instr.Immediate());
            try EmitMirCallArgs(instrs, sink, instr.OperandAIndex(), instr.OperandBIndex(), instr.OperandCIndex(), instr.OperandDIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.TailCall:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = tailcall f");
            try sink.AppendI64(instr.Immediate());
            try EmitMirCallArgs(instrs, sink, instr.OperandAIndex(), instr.OperandBIndex(), instr.OperandCIndex(), instr.OperandDIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.Return:
            try sink.AppendConstAscii("ret ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
    }

    return MemoryStatus.Ok;
}

// Appends a MIR call argument list `(vA, vB)` for the up-to-two operand slots.
internal fn MemoryStatus EmitMirCallArgs(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] a, u32[0 max] b, u32[0 max] c, u32[0 max] d)
{
    try sink.AppendConstAscii("(");
    if (a != 0)
    {
        try EmitMirValue(sink, a);
    }

    if (b != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitMirValue(sink, b);
    }

    if (c != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitMirValue(sink, c);
    }

    if (d != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitMirValue(sink, d);
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

// Dumps the MIR text for the instruction range [firstInstr, firstInstr+instrCount).
public fn MemoryStatus EmitMirInstructions(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitMirInstruction(instrs, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    return MemoryStatus.Ok;
}

// === Binary serialization primitives (toward package images, #32) ===
// A byte buffer is an `IrTable<u8[0 max]>` (1-based, append-only). Integers are
// encoded little-endian via div/mod (no bitwise); a signed i64 is encoded through its
// two's-complement bit pattern (`(u64)value`), which Stark's modular casts recover.

// Appends `value` as 4 little-endian bytes.
public fn void WriteU32(mut borrow IrTable<u8[0 max]> buf, u32[0 max] value)
{
    stack u64[0 max] wide = (u64[0 max])value;
    stack u32[0 max] a0 = buf.Add((u8[0 max])(wide % 256));
    stack u32[0 max] a1 = buf.Add((u8[0 max])((wide / 256) % 256));
    stack u32[0 max] a2 = buf.Add((u8[0 max])((wide / 65536) % 256));
    stack u32[0 max] a3 = buf.Add((u8[0 max])((wide / 16777216) % 256));
}

// Reads a 4-byte little-endian u32 starting at the 1-based byte index `at`.
public fn u32[0 max] ReadU32(borrow IrTable<u8[0 max]> buf, u32[0 max] at)
{
    stack u8[0 max] b0 = buf.Get(at);
    stack u8[0 max] b1 = buf.Get(at + 1);
    stack u8[0 max] b2 = buf.Get(at + 2);
    stack u8[0 max] b3 = buf.Get(at + 3);
    stack u64[0 max] value = (u64[0 max])b0
        + (u64[0 max])b1 * 256
        + (u64[0 max])b2 * 65536
        + (u64[0 max])b3 * 16777216;
    return (u32[0 max])value;
}

// Appends `value` as 8 little-endian bytes (two's-complement for negatives).
public fn void WriteI64(mut borrow IrTable<u8[0 max]> buf, i64[min max] value)
{
    stack mut u64[0 max] rem = (u64[0 max])value;
    stack mut u32[0 max] i = 0;
    while willexit (i < 8)
    {
        stack u32[0 max] w = buf.Add((u8[0 max])(rem % 256));
        rem = rem / 256;
        i = i + 1;
    }
}

// Appends `value` as 8 little-endian bytes.
public fn void WriteU64(mut borrow IrTable<u8[0 max]> buf, u64[0 max] value)
{
    stack mut u64[0 max] rem = value;
    stack mut u32[0 max] i = 0;
    while willexit (i < 8)
    {
        stack u32[0 max] w = buf.Add((u8[0 max])(rem % 256));
        rem = rem / 256;
        i = i + 1;
    }
}

// Reads an 8-byte little-endian i64 starting at the 1-based byte index `at`.
public fn i64[min max] ReadI64(borrow IrTable<u8[0 max]> buf, u32[0 max] at)
{
    stack mut u64[0 max] acc = 0;
    stack mut u64[0 max] mul = 1;
    stack mut u32[0 max] i = 0;
    while willexit (i < 8)
    {
        stack u8[0 max] byte = buf.Get(at + i);
        acc = acc + (u64[0 max])byte * mul;
        mul = mul * 256;
        i = i + 1;
    }

    return (i64[min max])acc;
}

// Reads an 8-byte little-endian u64 starting at the 1-based byte index `at`.
public fn u64[0 max] ReadU64(borrow IrTable<u8[0 max]> buf, u32[0 max] at)
{
    stack mut u64[0 max] acc = 0;
    stack mut u64[0 max] mul = 1;
    stack mut u32[0 max] i = 0;
    while willexit (i < 8)
    {
        stack u8[0 max] byte = buf.Get(at + i);
        acc = acc + (u64[0 max])byte * mul;
        if (i < 7)
        {
            mul = mul * 256;
        }

        i = i + 1;
    }

    return acc;
}

// True when the 1-based byte range `[start, start + byteCount)` is present.
// This is the guard all package-image readers use before touching raw bytes.
internal inline finite law bool CanReadImageBytes(borrow IrTable<u8[0 max]> buf, u32[0 max] start, u64[0 max] byteCount)
{
    if (start == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] total = buf.Count();
    stack u64[0 max] first = (u64[0 max])start;
    if (byteCount == 0)
    {
        return first <= (u64[0 max])total + 1;
    }

    if (first > (u64[0 max])total)
    {
        return false;
    }

    stack u64[0 max] available = (u64[0 max])total - first + 1;
    return byteCount <= available;
}

internal inline finite law bool SectionLastByteFitsU32(u32[0 max] start, u64[0 max] byteCount)
{
    if (byteCount == 0)
    {
        return true;
    }

    return (u64[0 max])start + byteCount - 1 <= (u64[0 max])(2 ** 32 - 1);
}

internal fn bool TryReadU32FromImage(borrow IrTable<u8[0 max]> buf, u32[0 max] at, out u32[0 max] value)
{
    value = 0;
    if (!CanReadImageBytes(buf, at, 4))
    {
        return false;
    }

    value = ReadU32(buf, at);
    return true;
}

internal fn bool TryReadU64FromImage(borrow IrTable<u8[0 max]> buf, u32[0 max] at, out u64[0 max] value)
{
    value = 0;
    if (!CanReadImageBytes(buf, at, 8))
    {
        return false;
    }

    value = ReadU64(buf, at);
    return true;
}

internal fn bool TryAdvanceImageCursor(borrow IrTable<u8[0 max]> buf, u32[0 max] cursor, u64[0 max] byteCount, out u32[0 max] nextCursor)
{
    nextCursor = cursor;
    if (!CanReadImageBytes(buf, cursor, byteCount))
    {
        return false;
    }

    if (!SectionLastByteFitsU32(cursor, byteCount))
    {
        return false;
    }

    stack u64[0 max] next = (u64[0 max])cursor + byteCount;
    if (next > (u64[0 max])(2 ** 32 - 1))
    {
        return false;
    }

    nextCursor = (u32[0 max])next;
    return true;
}

internal fn bool TryReadFixedRecordSectionSize(
    borrow IrTable<u8[0 max]> buf,
    u32[0 max] offset,
    u32[0 max] recordSize,
    out u32[0 max] rowCount,
    out u64[0 max] byteCount)
{
    rowCount = 0;
    byteCount = 0;
    stack mut u32[0 max] localRowCount = 0;
    if (!TryReadU32FromImage(buf, offset, localRowCount))
    {
        return false;
    }

    stack u64[0 max] localByteCount = 4 + (u64[0 max])localRowCount * (u64[0 max])recordSize;
    if (!SectionLastByteFitsU32(offset, localByteCount))
    {
        return false;
    }

    if (!CanReadImageBytes(buf, offset, localByteCount))
    {
        return false;
    }

    rowCount = localRowCount;
    byteCount = localByteCount;
    return true;
}

// === MIR instruction serialization (toward binary package images, #32) ===
// A serialized instruction is a fixed 26-byte record: opcode (1) + result type (1) +
// operands A/B/C/D (4 LE each) + immediate (8 LE). An instruction stream is a u32 count
// followed by that many records. Round-trips through the byte buffer above — INCLUDING a
// call's third/fourth arguments (the C/D operand slots), so a 3-or-4-argument call survives
// a package-image round-trip intact.

// Opcode <-> byte (explicit both ways; no reliance on enum-ordinal casts).
internal fn u8[0 max] MirOpToByte(MirOp op)
{
    switch (op)
    {
        case MirOp.ConstInt: return 0;
        case MirOp.Param: return 1;
        case MirOp.Add: return 2;
        case MirOp.Sub: return 3;
        case MirOp.Mul: return 4;
        case MirOp.SDiv: return 5;
        case MirOp.UDiv: return 6;
        case MirOp.SRem: return 7;
        case MirOp.And: return 8;
        case MirOp.Or: return 9;
        case MirOp.Xor: return 10;
        case MirOp.Shl: return 11;
        case MirOp.AShr: return 12;
        case MirOp.CmpEq: return 13;
        case MirOp.CmpNe: return 14;
        case MirOp.CmpLt: return 15;
        case MirOp.CmpLe: return 16;
        case MirOp.CmpGt: return 17;
        case MirOp.CmpGe: return 18;
        case MirOp.LoadGlobal: return 19;
        case MirOp.StoreGlobal: return 20;
        case MirOp.Phi: return 21;
        case MirOp.Call: return 22;
        case MirOp.Return: return 23;
        case MirOp.ZExt: return 24;
        case MirOp.TailCall: return 25;
        case MirOp.ArenaFrameEnter: return 26;
        case MirOp.ArenaAlloc: return 27;
        case MirOp.ArenaFrameLeave: return 28;
        case MirOp.ArenaDynamicStorageInit: return 29;
        case MirOp.ArenaDynamicStorageReserve: return 30;
        case MirOp.ArenaDynamicStorageTryReserve: return 31;
        case MirOp.ArenaDynamicStorageTryReserveCapacity: return 32;
        case MirOp.WrappingAdd: return 33;
        case MirOp.WrappingSub: return 34;
        case MirOp.WrappingMul: return 35;
        case MirOp.SaturatingAdd: return 36;
        case MirOp.SaturatingSub: return 37;
        case MirOp.SaturatingMul: return 38;
    }
}

internal fn MirOp MirOpFromByte(u8[0 max] b)
{
    switch (b)
    {
        case 1: return MirOp.Param;
        case 2: return MirOp.Add;
        case 3: return MirOp.Sub;
        case 4: return MirOp.Mul;
        case 5: return MirOp.SDiv;
        case 6: return MirOp.UDiv;
        case 7: return MirOp.SRem;
        case 8: return MirOp.And;
        case 9: return MirOp.Or;
        case 10: return MirOp.Xor;
        case 11: return MirOp.Shl;
        case 12: return MirOp.AShr;
        case 13: return MirOp.CmpEq;
        case 14: return MirOp.CmpNe;
        case 15: return MirOp.CmpLt;
        case 16: return MirOp.CmpLe;
        case 17: return MirOp.CmpGt;
        case 18: return MirOp.CmpGe;
        case 19: return MirOp.LoadGlobal;
        case 20: return MirOp.StoreGlobal;
        case 21: return MirOp.Phi;
        case 22: return MirOp.Call;
        case 23: return MirOp.Return;
        case 24: return MirOp.ZExt;
        case 25: return MirOp.TailCall;
        case 26: return MirOp.ArenaFrameEnter;
        case 27: return MirOp.ArenaAlloc;
        case 28: return MirOp.ArenaFrameLeave;
        case 29: return MirOp.ArenaDynamicStorageInit;
        case 30: return MirOp.ArenaDynamicStorageReserve;
        case 31: return MirOp.ArenaDynamicStorageTryReserve;
        case 32: return MirOp.ArenaDynamicStorageTryReserveCapacity;
        case 33: return MirOp.WrappingAdd;
        case 34: return MirOp.WrappingSub;
        case 35: return MirOp.WrappingMul;
        case 36: return MirOp.SaturatingAdd;
        case 37: return MirOp.SaturatingSub;
        case 38: return MirOp.SaturatingMul;
        default: return MirOp.ConstInt;
    }
}

internal fn u8[0 max] MirTypeToByte(MirType t)
{
    switch (t)
    {
        case MirType.I1: return 0;
        case MirType.I32: return 1;
        case MirType.I64: return 2;
        case MirType.Ptr: return 3;
    }
}

internal fn MirType MirTypeFromByte(u8[0 max] b)
{
    switch (b)
    {
        case 0: return MirType.I1;
        case 1: return MirType.I32;
        case 3: return MirType.Ptr;
        default: return MirType.I64;
    }
}

// Serializes the instruction range [firstInstr, firstInstr+instrCount) into `buf`:
// a u32 count followed by one 18-byte record per instruction.
public fn void SerializeInstructions(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow IrTable<u8[0 max]> buf)
{
    WriteU32(buf, instrCount);
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            stack u32[0 max] wOp = buf.Add(MirOpToByte(instr.Opcode()));
            stack u32[0 max] wType = buf.Add(MirTypeToByte(instr.ResultType()));
            WriteU32(buf, instr.OperandAIndex());
            WriteU32(buf, instr.OperandBIndex());
            WriteU32(buf, instr.OperandCIndex());
            WriteU32(buf, instr.OperandDIndex());
            WriteI64(buf, instr.Immediate());
        }

        index = index + 1;
        remaining = remaining - 1;
    }
}

// Deserializes a stream written by `SerializeInstructions` into `outInstrs`,
// reconstructing each instruction (opcode, result type, operands, immediate).
public fn void DeserializeInstructions(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirInstruction> outInstrs)
{
    DeserializeInstructionsAt(buf, 1, outInstrs);
}

// As `DeserializeInstructions` but the section begins at the 1-based byte
// `startOffset` (for combined package images with several sections).
public fn void DeserializeInstructionsAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow IrTable<MirInstruction> outInstrs)
{
    stack u32[0 max] count = ReadU32(buf, startOffset);
    stack mut u32[0 max] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] recordBase = startOffset + 4 + i * 26;
        stack u8[0 max] opByte = buf.Get(recordBase);
        stack u8[0 max] typeByte = buf.Get(recordBase + 1);
        stack u32[0 max] a = ReadU32(buf, recordBase + 2);
        stack u32[0 max] b = ReadU32(buf, recordBase + 6);
        stack u32[0 max] c = ReadU32(buf, recordBase + 10);
        stack u32[0 max] d = ReadU32(buf, recordBase + 14);
        stack i64[min max] imm = ReadI64(buf, recordBase + 18);
        stack mut MirInstruction instr = new();
        instr.Op = MirOpFromByte(opByte);
        instr.ResType = MirTypeFromByte(typeByte);
        instr.AIndex = a;
        instr.BIndex = b;
        instr.CIndex = c;
        instr.DIndex = d;
        instr.Imm = imm;
        stack u32[0 max] added = outInstrs.Add(instr);
        i = i + 1;
    }
}

// === Block / function / global serialization (toward a full package image, #32) ===
// Each is a fixed-record stream like the instruction stream: a u32 count followed by
// fixed-size records. (Each section serializes into its own buffer; a combined
// multi-section image with a section directory is a later slice.)

internal fn u8[0 max] MirTermToByte(MirTermKind t)
{
    switch (t)
    {
        case MirTermKind.Unterminated: return 0;
        case MirTermKind.Return: return 1;
        case MirTermKind.Branch: return 2;
        case MirTermKind.CondBranch: return 3;
        case MirTermKind.TailCall: return 4;
        case MirTermKind.ReturnVoid: return 5;
    }
}

internal fn MirTermKind MirTermFromByte(u8[0 max] b)
{
    switch (b)
    {
        case 1: return MirTermKind.Return;
        case 2: return MirTermKind.Branch;
        case 3: return MirTermKind.CondBranch;
        case 4: return MirTermKind.TailCall;
        case 5: return MirTermKind.ReturnVoid;
        default: return MirTermKind.Unterminated;
    }
}

internal inline finite law u32[0 max] MirBlockRecordSize()
{
    return 17;
}

// Adds a block from raw fields (used when reconstructing from a serialized stream).
internal fn MirBlockId MirAddBlockRaw(
    mut borrow IrTable<MirBlock> blocks,
    MirTermKind term,
    u32[0 max] slot0,
    u32[0 max] slot1,
    u32[0 max] slot2,
    u32[0 max] flags)
{
    stack mut MirBlock blk = new();
    blk.Term = term;
    blk.Slot0 = slot0;
    blk.Slot1 = slot1;
    blk.Slot2 = slot2;
    if (MirBlockFlagsAreValid(term, flags))
    {
        blk.Flags = flags;
    }

    return MirBlockIdOf(blocks.Add(blk));
}

// Blocks: u32 count + fixed records (term byte + 3 u32 slots + u32 flags).
public fn void SerializeBlocks(borrow IrTable<MirBlock> blocks, mut borrow IrTable<u8[0 max]> buf)
{
    stack u64[0 2 ** 63 - 1] count = blocks.Count();
    WriteU32(buf, (u32[0 max])count);
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirBlock blk = blocks.Get(id);
        stack u32[0 max] w = buf.Add(MirTermToByte(blk.Terminator()));
        WriteU32(buf, blk.Slot0Index());
        WriteU32(buf, blk.Slot1Index());
        WriteU32(buf, blk.Slot2Index());
        WriteU32(buf, blk.FlagBits());
        id = id + 1;
    }
}

public fn void DeserializeBlocks(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirBlock> outBlocks)
{
    DeserializeBlocksAt(buf, 1, outBlocks);
}

public fn void DeserializeBlocksAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow IrTable<MirBlock> outBlocks)
{
    stack u32[0 max] count = ReadU32(buf, startOffset);
    stack mut u32[0 max] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] recordBase = startOffset + 4 + i * MirBlockRecordSize();
        stack u8[0 max] termByte = buf.Get(recordBase);
        stack u32[0 max] s0 = ReadU32(buf, recordBase + 1);
        stack u32[0 max] s1 = ReadU32(buf, recordBase + 5);
        stack u32[0 max] s2 = ReadU32(buf, recordBase + 9);
        stack u32[0 max] flags = ReadU32(buf, recordBase + 13);
        stack MirBlockId v = MirAddBlockRaw(outBlocks, MirTermFromByte(termByte), s0, s1, s2, flags);
        i = i + 1;
    }
}

// Functions: u32 count + 20-byte records (entry, firstBlock, blockCount, firstInstr,
// instrCount — five u32s).
public fn void SerializeFunctions(borrow IrTable<MirFunction> funcs, mut borrow IrTable<u8[0 max]> buf)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    WriteU32(buf, (u32[0 max])count);
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction f = funcs.Get(id);
        WriteU32(buf, f.EntryIndex());
        WriteU32(buf, f.FirstBlockIndex());
        WriteU32(buf, f.OwnedBlockCount());
        WriteU32(buf, f.FirstInstrIndex());
        WriteU32(buf, f.OwnedInstrCount());
        id = id + 1;
    }
}

public fn void DeserializeFunctions(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirFunction> outFuncs)
{
    DeserializeFunctionsAt(buf, 1, outFuncs);
}

public fn void DeserializeFunctionsAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow IrTable<MirFunction> outFuncs)
{
    stack u32[0 max] count = ReadU32(buf, startOffset);
    stack mut u32[0 max] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] recordBase = startOffset + 4 + i * 20;
        stack u32[0 max] entry = ReadU32(buf, recordBase);
        stack u32[0 max] firstBlock = ReadU32(buf, recordBase + 4);
        stack u32[0 max] blockCount = ReadU32(buf, recordBase + 8);
        stack u32[0 max] firstInstr = ReadU32(buf, recordBase + 12);
        stack u32[0 max] instrCount = ReadU32(buf, recordBase + 16);
        stack MirFuncId v = MirDefineFunction(outFuncs, MirBlockIdOf(entry), MirBlockIdOf(firstBlock), blockCount, MirValueIdOf(firstInstr), instrCount);
        i = i + 1;
    }
}

// Globals: u32 count + fixed records (type byte + i64 initializer).
public fn void SerializeGlobals(borrow IrTable<MirGlobal> globals, mut borrow IrTable<u8[0 max]> buf)
{
    stack u64[0 2 ** 63 - 1] count = globals.Count();
    WriteU32(buf, (u32[0 max])count);
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirGlobal g = globals.Get(id);
        stack u32[0 max] wType = buf.Add(MirTypeToByte(g.StoredType()));
        WriteI64(buf, g.InitialValue());
        id = id + 1;
    }
}

public fn void DeserializeGlobals(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirGlobal> outGlobals)
{
    DeserializeGlobalsAt(buf, 1, outGlobals);
}

public fn void DeserializeGlobalsAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow IrTable<MirGlobal> outGlobals)
{
    stack u32[0 max] count = ReadU32(buf, startOffset);
    stack mut u32[0 max] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] recordBase = startOffset + 4 + i * MirGlobalRecordSize();
        stack u8[0 max] typeByte = buf.Get(recordBase);
        stack MirType type = MirTypeFromByte(typeByte);
        stack i64[min max] initValue = ReadI64(buf, recordBase + 1);
        stack u32[0 max] v = MirDefineGlobalUnchecked(outGlobals, type, initValue);
        i = i + 1;
    }
}

// Enum layout facts: u32 count + fixed 108-byte records. This is a durable
// package-boundary section, not a transient MIR optimization fact.
internal inline finite law u32[0 max] MirEnumLayoutFactRecordSize()
{
    return 108;
}

internal inline finite law u32[0 max] BoolToU32(bool value)
{
    if (value)
    {
        return 1;
    }

    return 0;
}

internal inline finite law bool BoolFromU32(u32[0 max] value)
{
    return value != 0;
}

internal finite law u32[0 max] MirEnumLayoutFactRowKindToU32(MirEnumLayoutFactRowKind kind)
{
    switch (kind)
    {
        case MirEnumLayoutFactRowKind.Variant:
            return 1;
        case MirEnumLayoutFactRowKind.Payload:
            return 2;
        default:
            return 0;
    }
}

internal finite law MirEnumLayoutFactRowKind MirEnumLayoutFactRowKindFromU32(u32[0 max] value)
{
    switch (value)
    {
        case 1:
            return MirEnumLayoutFactRowKind.Variant;
        case 2:
            return MirEnumLayoutFactRowKind.Payload;
        default:
            return MirEnumLayoutFactRowKind.Unknown;
    }
}

internal finite law u32[0 max] TypedEnumPayloadKindToU32(Compiler.Typing.TypedEnumPayloadKind kind)
{
    switch (kind)
    {
        case Compiler.Typing.TypedEnumPayloadKind.Positional:
            return 1;
        case Compiler.Typing.TypedEnumPayloadKind.Named:
            return 2;
        case Compiler.Typing.TypedEnumPayloadKind.From:
            return 3;
        default:
            return 0;
    }
}

internal finite law Compiler.Typing.TypedEnumPayloadKind TypedEnumPayloadKindFromU32(u32[0 max] value)
{
    switch (value)
    {
        case 1:
            return Compiler.Typing.TypedEnumPayloadKind.Positional;
        case 2:
            return Compiler.Typing.TypedEnumPayloadKind.Named;
        case 3:
            return Compiler.Typing.TypedEnumPayloadKind.From;
        default:
            return Compiler.Typing.TypedEnumPayloadKind.Unknown;
    }
}

internal finite law u32[0 max] TypedEnumVariantRoleToU32(Compiler.Typing.TypedEnumVariantRole role)
{
    switch (role)
    {
        case Compiler.Typing.TypedEnumVariantRole.Ok:
            return 1;
        case Compiler.Typing.TypedEnumVariantRole.Err:
            return 2;
        case Compiler.Typing.TypedEnumVariantRole.OkErr:
            return 3;
        default:
            return 0;
    }
}

internal finite law Compiler.Typing.TypedEnumVariantRole TypedEnumVariantRoleFromU32(u32[0 max] value)
{
    switch (value)
    {
        case 1:
            return Compiler.Typing.TypedEnumVariantRole.Ok;
        case 2:
            return Compiler.Typing.TypedEnumVariantRole.Err;
        case 3:
            return Compiler.Typing.TypedEnumVariantRole.OkErr;
        default:
            return Compiler.Typing.TypedEnumVariantRole.None;
    }
}

internal finite law u32[0 max] TypedSignatureTypeKindToU32(Compiler.Typing.TypedSignatureTypeKind kind)
{
    switch (kind)
    {
        case Compiler.Typing.TypedSignatureTypeKind.Void:
            return 1;
        case Compiler.Typing.TypedSignatureTypeKind.Bool:
            return 2;
        case Compiler.Typing.TypedSignatureTypeKind.Integer:
            return 3;
        case Compiler.Typing.TypedSignatureTypeKind.Float:
            return 4;
        case Compiler.Typing.TypedSignatureTypeKind.Text:
            return 5;
        case Compiler.Typing.TypedSignatureTypeKind.Named:
            return 6;
        case Compiler.Typing.TypedSignatureTypeKind.GenericParameter:
            return 7;
        case Compiler.Typing.TypedSignatureTypeKind.RawPointer:
            return 8;
        case Compiler.Typing.TypedSignatureTypeKind.FunctionPointer:
            return 9;
        case Compiler.Typing.TypedSignatureTypeKind.Closure:
            return 10;
        case Compiler.Typing.TypedSignatureTypeKind.Dynamic:
            return 11;
        case Compiler.Typing.TypedSignatureTypeKind.FixedArray:
            return 12;
        case Compiler.Typing.TypedSignatureTypeKind.Slice:
            return 13;
        default:
            return 0;
    }
}

internal finite law Compiler.Typing.TypedSignatureTypeKind TypedSignatureTypeKindFromU32(u32[0 max] value)
{
    switch (value)
    {
        case 1:
            return Compiler.Typing.TypedSignatureTypeKind.Void;
        case 2:
            return Compiler.Typing.TypedSignatureTypeKind.Bool;
        case 3:
            return Compiler.Typing.TypedSignatureTypeKind.Integer;
        case 4:
            return Compiler.Typing.TypedSignatureTypeKind.Float;
        case 5:
            return Compiler.Typing.TypedSignatureTypeKind.Text;
        case 6:
            return Compiler.Typing.TypedSignatureTypeKind.Named;
        case 7:
            return Compiler.Typing.TypedSignatureTypeKind.GenericParameter;
        case 8:
            return Compiler.Typing.TypedSignatureTypeKind.RawPointer;
        case 9:
            return Compiler.Typing.TypedSignatureTypeKind.FunctionPointer;
        case 10:
            return Compiler.Typing.TypedSignatureTypeKind.Closure;
        case 11:
            return Compiler.Typing.TypedSignatureTypeKind.Dynamic;
        case 12:
            return Compiler.Typing.TypedSignatureTypeKind.FixedArray;
        case 13:
            return Compiler.Typing.TypedSignatureTypeKind.Slice;
        default:
            return Compiler.Typing.TypedSignatureTypeKind.Unknown;
    }
}

public fn void SerializeEnumLayoutFacts(borrow IrTable<MirEnumLayoutFact> facts, mut borrow IrTable<u8[0 max]> buf)
{
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    WriteU32(buf, (u32[0 max])count);
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirEnumLayoutFact fact = facts.Get(id);
        stack TypeId ownerType = fact.OwnerType();
        WriteU32(buf, MirEnumLayoutFactRowKindToU32(fact.RowKind()));
        WriteU32(buf, ownerType.Index());
        WriteU32(buf, fact.OwnerNameToken());
        WriteU32(buf, fact.VariantOrdinal());
        WriteU32(buf, fact.VariantNameToken());
        WriteU32(buf, fact.VariantTag());
        WriteU32(buf, fact.PayloadCount());
        WriteU32(buf, fact.PayloadOrdinal());
        WriteU32(buf, fact.PayloadNameToken());
        WriteU32(buf, TypedEnumPayloadKindToU32(fact.PayloadKind()));
        WriteU32(buf, TypedEnumVariantRoleToU32(fact.VariantRole()));
        WriteU32(buf, BoolToU32(fact.IsErrorFunnel()));
        WriteU32(buf, BoolToU32(fact.UsesNamedPayloads()));
        WriteU32(buf, fact.StorageFieldOrdinal());
        WriteU64(buf, fact.OffsetBytes());
        WriteU64(buf, fact.SizeBytes());
        WriteU64(buf, fact.AlignmentBytes());
        WriteU32(buf, BoolToU32(fact.IsMisaligned()));
        WriteU32(buf, TypedSignatureTypeKindToU32(fact.TypeKind()));
        WriteU32(buf, fact.TypeHeadToken());
        WriteU32(buf, fact.TypePrimaryToken());
        WriteU32(buf, fact.BitWidth());
        WriteU32(buf, fact.TypeFlags());
        WriteU32(buf, BoolToU32(fact.HasConcreteLayout()));
        id = id + 1;
    }
}

public fn bool DeserializeEnumLayoutFacts(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirEnumLayoutFact> outFacts)
{
    return DeserializeEnumLayoutFactsAt(buf, 1, outFacts);
}

public fn bool DeserializeEnumLayoutFactsAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow IrTable<MirEnumLayoutFact> outFacts)
{
    stack mut u32[0 max] rowCount = 0;
    stack mut u64[0 max] byteCount = 0;
    if (!TryReadFixedRecordSectionSize(buf, startOffset, MirEnumLayoutFactRecordSize(), rowCount, byteCount))
    {
        return false;
    }

    stack mut u32[0 max] i = 0;
    while willexit (i < rowCount)
    {
        stack u32[0 max] recordBase = startOffset + 4 + i * MirEnumLayoutFactRecordSize();
        stack mut MirEnumLayoutFact fact = new();
        fact.RowKindValue = MirEnumLayoutFactRowKindFromU32(ReadU32(buf, recordBase));
        fact.OwnerTypeValue = TypeIdOf(ReadU32(buf, recordBase + 4));
        fact.OwnerNameTokenValue = ReadU32(buf, recordBase + 8);
        fact.VariantOrdinalValue = ReadU32(buf, recordBase + 12);
        fact.VariantNameTokenValue = ReadU32(buf, recordBase + 16);
        fact.VariantTagValue = ReadU32(buf, recordBase + 20);
        fact.PayloadCountValue = ReadU32(buf, recordBase + 24);
        fact.PayloadOrdinalValue = ReadU32(buf, recordBase + 28);
        fact.PayloadNameTokenValue = ReadU32(buf, recordBase + 32);
        fact.PayloadKindValue = TypedEnumPayloadKindFromU32(ReadU32(buf, recordBase + 36));
        fact.VariantRoleValue = TypedEnumVariantRoleFromU32(ReadU32(buf, recordBase + 40));
        fact.ErrorFunnelValue = BoolFromU32(ReadU32(buf, recordBase + 44));
        fact.UsesNamedPayloadsValue = BoolFromU32(ReadU32(buf, recordBase + 48));
        fact.StorageFieldOrdinalValue = ReadU32(buf, recordBase + 52);
        fact.OffsetBytesValue = ReadU64(buf, recordBase + 56);
        fact.SizeBytesValue = ReadU64(buf, recordBase + 64);
        fact.AlignmentBytesValue = ReadU64(buf, recordBase + 72);
        fact.MisalignedValue = BoolFromU32(ReadU32(buf, recordBase + 80));
        fact.TypeKindValue = TypedSignatureTypeKindFromU32(ReadU32(buf, recordBase + 84));
        fact.TypeHeadTokenValue = ReadU32(buf, recordBase + 88);
        fact.TypePrimaryTokenValue = ReadU32(buf, recordBase + 92);
        fact.BitWidthValue = ReadU32(buf, recordBase + 96);
        fact.TypeFlagsValue = ReadU32(buf, recordBase + 100);
        fact.ConcreteLayoutValue = BoolFromU32(ReadU32(buf, recordBase + 104));
        if (outFacts.Add(fact) == 0)
        {
            return false;
        }

        i = i + 1;
    }

    return true;
}

// Assembly metadata: a text byte pool followed by fixed-width input/output/clobber
// rows and function rows. This preserves source assembly declarations for imported
// package consumers without keeping parser tokens or source text alive.

internal fn u32[0 max] AsmArchitectureToU32(Compiler.AsmFacts.StarkAsmArchitecture architecture)
{
    switch (architecture)
    {
        case Compiler.AsmFacts.StarkAsmArchitecture.X86_64: return 1;
        case Compiler.AsmFacts.StarkAsmArchitecture.AArch64: return 2;
        case Compiler.AsmFacts.StarkAsmArchitecture.RiscV64: return 3;
        case Compiler.AsmFacts.StarkAsmArchitecture.X86: return 4;
        case Compiler.AsmFacts.StarkAsmArchitecture.Arm32: return 5;
        default: return 0;
    }
}

internal fn Compiler.AsmFacts.StarkAsmArchitecture AsmArchitectureFromU32(u32[0 max] value)
{
    switch (value)
    {
        case 1: return Compiler.AsmFacts.StarkAsmArchitecture.X86_64;
        case 2: return Compiler.AsmFacts.StarkAsmArchitecture.AArch64;
        case 3: return Compiler.AsmFacts.StarkAsmArchitecture.RiscV64;
        case 4: return Compiler.AsmFacts.StarkAsmArchitecture.X86;
        case 5: return Compiler.AsmFacts.StarkAsmArchitecture.Arm32;
        default: return Compiler.AsmFacts.StarkAsmArchitecture.Unknown;
    }
}

internal fn void WriteAsmTextRange(mut borrow IrTable<u8[0 max]> buf, AsmTextRange range)
{
    WriteU32(buf, range.Start());
    WriteU32(buf, range.Length());
}

internal fn AsmTextRange ReadAsmTextRange(borrow IrTable<u8[0 max]> buf, u32[0 max] at)
{
    return AsmTextRangeOf(ReadU32(buf, at), ReadU32(buf, at + 4));
}

public fn void SerializeAsmMetadata(borrow AsmMetadataTable table, mut borrow IrTable<u8[0 max]> buf)
{
    stack u64[0 2 ** 63 - 1] textCount = table.TextByteCount();
    WriteU32(buf, (u32[0 max])textCount);
    stack mut u64[0 2 ** 63 - 1] textIndex = 0;
    while willexit (textIndex < textCount)
    {
        stack u32[0 max] written = buf.Add((u8[0 max])table.TextByteAt(textIndex));
        textIndex = textIndex + 1;
    }

    stack u64[0 2 ** 63 - 1] inputCount = table.InputCount();
    WriteU32(buf, (u32[0 max])inputCount);
    stack mut u32[0 max] inputIndex = 1;
    while willexit ((u64[0 2 ** 63 - 1])inputIndex <= inputCount)
    {
        stack AsmInputOperand input = table.InputAt(inputIndex);
        WriteAsmTextRange(buf, input.Register());
        WriteAsmTextRange(buf, input.Value());
        inputIndex = inputIndex + 1;
    }

    stack u64[0 2 ** 63 - 1] outputCount = table.OutputCount();
    WriteU32(buf, (u32[0 max])outputCount);
    stack mut u32[0 max] outputIndex = 1;
    while willexit ((u64[0 2 ** 63 - 1])outputIndex <= outputCount)
    {
        stack AsmOutputOperand output = table.OutputAt(outputIndex);
        WriteAsmTextRange(buf, output.Register());
        WriteAsmTextRange(buf, output.Value());
        if (output.BindsReturn())
        {
            WriteU32(buf, 1);
        }
        else
        {
            WriteU32(buf, 0);
        }

        outputIndex = outputIndex + 1;
    }

    stack u64[0 2 ** 63 - 1] clobberCount = table.ClobberCount();
    WriteU32(buf, (u32[0 max])clobberCount);
    stack mut u32[0 max] clobberIndex = 1;
    while willexit ((u64[0 2 ** 63 - 1])clobberIndex <= clobberCount)
    {
        WriteAsmTextRange(buf, table.ClobberAt(clobberIndex));
        clobberIndex = clobberIndex + 1;
    }

    stack u64[0 2 ** 63 - 1] functionCount = table.FunctionCount();
    WriteU32(buf, (u32[0 max])functionCount);
    stack mut u32[0 max] functionIndex = 1;
    while willexit ((u64[0 2 ** 63 - 1])functionIndex <= functionCount)
    {
        stack AsmFunctionMetadata function = table.FunctionAt(AsmFunctionIdOf(functionIndex));
        stack MirFuncId mirFunction = function.Function();
        WriteU32(buf, mirFunction.Index());
        WriteU32(buf, AsmArchitectureToU32(function.Architecture()));
        WriteAsmTextRange(buf, function.Template());
        WriteU32(buf, function.FirstInput());
        WriteU32(buf, function.InputCount());
        WriteU32(buf, function.FirstOutput());
        WriteU32(buf, function.OutputCount());
        WriteU32(buf, function.FirstClobber());
        WriteU32(buf, function.ClobberCount());
        functionIndex = functionIndex + 1;
    }
}

public fn bool DeserializeAsmMetadata(borrow IrTable<u8[0 max]> buf, mut borrow AsmMetadataTable outTable)
{
    return DeserializeAsmMetadataAt(buf, 1, outTable);
}

public fn bool DeserializeAsmMetadataAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow AsmMetadataTable outTable)
{
    stack mut u64[0 max] byteCount = 0;
    stack mut u32[0 max] functionCount = 0;
    if (!TryReadAsmMetadataSectionSizeAndFunctionCount(buf, startOffset, byteCount, functionCount))
    {
        return false;
    }

    return DeserializeAsmMetadataAtUnchecked(buf, startOffset, outTable);
}

internal fn bool TryReadAsmMetadataSectionSizeAndFunctionCount(
    borrow IrTable<u8[0 max]> buf,
    u32[0 max] startOffset,
    out u64[0 max] byteCount,
    out u32[0 max] functionCount)
{
    byteCount = 0;
    functionCount = 0;
    stack mut u64[0 max] localByteCount = 0;
    stack mut u32[0 max] localFunctionCount = 0;
    stack mut u32[0 max] cursor = startOffset;
    stack mut u32[0 max] nextCursor = 0;
    stack mut u32[0 max] count = 0;

    if (!TryReadU32FromImage(buf, cursor, count))
    {
        return false;
    }

    if (!TryAdvanceImageCursor(buf, cursor, 4, nextCursor))
    {
        return false;
    }

    cursor = nextCursor;
    localByteCount = localByteCount + 4;
    if (!TryAdvanceImageCursor(buf, cursor, (u64[0 max])count, nextCursor))
    {
        return false;
    }

    cursor = nextCursor;
    localByteCount = localByteCount + (u64[0 max])count;

    if (!TryReadU32FromImage(buf, cursor, count))
    {
        return false;
    }

    if (!TryAdvanceImageCursor(buf, cursor, 4, nextCursor))
    {
        return false;
    }

    cursor = nextCursor;
    localByteCount = localByteCount + 4;
    stack u64[0 max] inputBytes = (u64[0 max])count * 16;
    if (!TryAdvanceImageCursor(buf, cursor, inputBytes, nextCursor))
    {
        return false;
    }

    cursor = nextCursor;
    localByteCount = localByteCount + inputBytes;

    if (!TryReadU32FromImage(buf, cursor, count))
    {
        return false;
    }

    if (!TryAdvanceImageCursor(buf, cursor, 4, nextCursor))
    {
        return false;
    }

    cursor = nextCursor;
    localByteCount = localByteCount + 4;
    stack u64[0 max] outputBytes = (u64[0 max])count * 20;
    if (!TryAdvanceImageCursor(buf, cursor, outputBytes, nextCursor))
    {
        return false;
    }

    cursor = nextCursor;
    localByteCount = localByteCount + outputBytes;

    if (!TryReadU32FromImage(buf, cursor, count))
    {
        return false;
    }

    if (!TryAdvanceImageCursor(buf, cursor, 4, nextCursor))
    {
        return false;
    }

    cursor = nextCursor;
    localByteCount = localByteCount + 4;
    stack u64[0 max] clobberBytes = (u64[0 max])count * 8;
    if (!TryAdvanceImageCursor(buf, cursor, clobberBytes, nextCursor))
    {
        return false;
    }

    cursor = nextCursor;
    localByteCount = localByteCount + clobberBytes;

    if (!TryReadU32FromImage(buf, cursor, localFunctionCount))
    {
        return false;
    }

    if (!TryAdvanceImageCursor(buf, cursor, 4, nextCursor))
    {
        return false;
    }

    cursor = nextCursor;
    localByteCount = localByteCount + 4;
    stack u64[0 max] functionBytes = (u64[0 max])localFunctionCount * 40;
    if (!TryAdvanceImageCursor(buf, cursor, functionBytes, nextCursor))
    {
        return false;
    }

    localByteCount = localByteCount + functionBytes;
    byteCount = localByteCount;
    functionCount = localFunctionCount;
    return true;
}

internal fn bool DeserializeAsmMetadataAtUnchecked(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow AsmMetadataTable outTable)
{
    stack mut u32[0 max] cursor = startOffset;
    stack u32[0 max] textCount = ReadU32(buf, cursor);
    cursor = cursor + 4;
    stack mut u32[0 max] textIndex = 0;
    while willexit (textIndex < textCount)
    {
        switch (outTable.AppendTextByte((i8[min max])buf.Get(cursor)))
        {
            case MemoryStatus.Err(var textError):
                return false;
            case MemoryStatus.Ok:
        }

        cursor = cursor + 1;
        textIndex = textIndex + 1;
    }

    stack u32[0 max] inputCount = ReadU32(buf, cursor);
    cursor = cursor + 4;
    stack mut u32[0 max] inputIndex = 0;
    while willexit (inputIndex < inputCount)
    {
        stack AsmTextRange registerRange = ReadAsmTextRange(buf, cursor);
        stack AsmTextRange valueRange = ReadAsmTextRange(buf, cursor + 8);
        switch (outTable.AppendInputOperand(registerRange, valueRange))
        {
            case MemoryStatus.Err(var inputError):
                return false;
            case MemoryStatus.Ok:
        }

        cursor = cursor + 16;
        inputIndex = inputIndex + 1;
    }

    stack u32[0 max] outputCount = ReadU32(buf, cursor);
    cursor = cursor + 4;
    stack mut u32[0 max] outputIndex = 0;
    while willexit (outputIndex < outputCount)
    {
        stack AsmTextRange registerRange = ReadAsmTextRange(buf, cursor);
        stack AsmTextRange valueRange = ReadAsmTextRange(buf, cursor + 8);
        stack bool bindsReturn = ReadU32(buf, cursor + 16) != 0;
        switch (outTable.AppendOutputOperand(registerRange, valueRange, bindsReturn))
        {
            case MemoryStatus.Err(var outputError):
                return false;
            case MemoryStatus.Ok:
        }

        cursor = cursor + 20;
        outputIndex = outputIndex + 1;
    }

    stack u32[0 max] clobberCount = ReadU32(buf, cursor);
    cursor = cursor + 4;
    stack mut u32[0 max] clobberIndex = 0;
    while willexit (clobberIndex < clobberCount)
    {
        stack AsmTextRange clobberRange = ReadAsmTextRange(buf, cursor);
        switch (outTable.AppendClobber(clobberRange))
        {
            case MemoryStatus.Err(var clobberError):
                return false;
            case MemoryStatus.Ok:
        }

        cursor = cursor + 8;
        clobberIndex = clobberIndex + 1;
    }

    stack u32[0 max] functionCount = ReadU32(buf, cursor);
    cursor = cursor + 4;
    stack mut u32[0 max] functionIndex = 0;
    while willexit (functionIndex < functionCount)
    {
        stack MirFuncId functionId = MirFuncIdOf(ReadU32(buf, cursor));
        stack Compiler.AsmFacts.StarkAsmArchitecture architecture = AsmArchitectureFromU32(ReadU32(buf, cursor + 4));
        stack AsmTextRange templateRange = ReadAsmTextRange(buf, cursor + 8);
        stack u32[0 max] firstInput = ReadU32(buf, cursor + 16);
        stack u32[0 max] functionInputCount = ReadU32(buf, cursor + 20);
        stack u32[0 max] firstOutput = ReadU32(buf, cursor + 24);
        stack u32[0 max] functionOutputCount = ReadU32(buf, cursor + 28);
        stack u32[0 max] firstClobber = ReadU32(buf, cursor + 32);
        stack u32[0 max] functionClobberCount = ReadU32(buf, cursor + 36);
        stack mut AsmFunctionId asmFunction = new();
        switch (outTable.AppendFunction(
            functionId,
            architecture,
            templateRange,
            firstInput,
            functionInputCount,
            firstOutput,
            functionOutputCount,
            firstClobber,
            functionClobberCount,
            asmFunction))
        {
            case MemoryStatus.Err(var functionError):
                return false;
            case MemoryStatus.Ok:
        }

        cursor = cursor + 40;
        functionIndex = functionIndex + 1;
    }

    return true;
}

// === Combined package image (#32) ===
// A package image concatenates the four section streams behind a fixed 20-byte
// header: a magic u32 then the 1-based byte offset of each section
// (instructions, blocks, functions, globals). Sections therefore start at byte 21.
// `InspectPackageImage` reads only the header + per-section counts (an `inspect-pkg`
// summary) without materializing the IR.

// The magic identifying a MIR package image ("MIR1" little-endian-ish constant).
internal fn u32[0 max] MirImageMagic()
{
    return 826757197;
}

// The magic identifying a MIR package image with assembly metadata ("MIR2").
internal fn u32[0 max] MirImageWithAsmMagic()
{
    return 844253517;
}

internal inline finite law u32[0 max] FourCc(u8[0 max] a, u8[0 max] b, u8[0 max] c, u8[0 max] d)
{
    return (u32[0 max])a
        + (u32[0 max])b * 256
        + (u32[0 max])c * 65536
        + (u32[0 max])d * 16777216;
}

internal fn u32[0 max] SectionedPackageImageVersion()
{
    return 2;
}

internal fn u32[0 max] SectionFlagsRequired()
{
    return 1;
}

internal fn u32[0 max] SectionEncodingRaw()
{
    return 0;
}

internal fn u32[0 max] SectionEncodingBrotliUtf8Json()
{
    return 1;
}

internal fn u32[0 max] PackageImageNullStringIndex()
{
    return 4294967295;
}

internal fn u32[0 max] PackageSectionStringTable()
{
    return FourCc(83, 84, 82, 83); // STRS
}

internal fn u32[0 max] PackageSectionPackageFacts()
{
    return FourCc(80, 73, 78, 70); // PINF
}

internal fn u32[0 max] PackageSectionManifest()
{
    return FourCc(77, 65, 78, 70); // MANF
}

internal fn u32[0 max] PackageSectionInstructions()
{
    return FourCc(77, 73, 78, 83); // MINS
}

internal fn u32[0 max] PackageSectionBlocks()
{
    return FourCc(77, 66, 76, 75); // MBLK
}

internal fn u32[0 max] PackageSectionFunctions()
{
    return FourCc(77, 70, 85, 78); // MFUN
}

internal fn u32[0 max] PackageSectionGlobals()
{
    return FourCc(77, 71, 76, 66); // MGLB
}

internal fn u32[0 max] PackageSectionAsmMetadata()
{
    return FourCc(77, 65, 83, 77); // MASM
}

internal fn u32[0 max] PackageSectionEnumLayoutFacts()
{
    return FourCc(77, 69, 76, 70); // MELF
}

public enum PackageImageInspectionFormat
{
    Text,
    Json,
}

public enum PackageImageValidationStatus
{
    Ok,
    TruncatedHeader,
    UnsupportedFormat,
    MalformedSectionDirectory,
    TruncatedSection,
}

public finite law ascii PackageImageValidationStatusName(PackageImageValidationStatus status)
{
    switch (status)
    {
        case PackageImageValidationStatus.Ok:
            return "ok";
        case PackageImageValidationStatus.TruncatedHeader:
            return "truncated-header";
        case PackageImageValidationStatus.UnsupportedFormat:
            return "unsupported-format";
        case PackageImageValidationStatus.MalformedSectionDirectory:
            return "malformed-section-directory";
        case PackageImageValidationStatus.TruncatedSection:
            return "truncated-section";
    }
}

