public fn MirValueId MirTailCall2Typed(mut borrow IrTable<MirInstruction> instrs, MirType type, MirFuncId callee, MirValueId arg0, MirValueId arg1)
{
    return MirEmitTyped(instrs, MirOp.TailCall, type, arg0.Index(), arg1.Index(), (i64[min max])callee.Index());
}

public fn MirValueId MirTailCall3(mut borrow IrTable<MirInstruction> instrs, MirFuncId callee, MirValueId arg0, MirValueId arg1, MirValueId arg2)
{
    stack mut MirInstruction instr = new();
    instr.Op = MirOp.TailCall;
    instr.AIndex = arg0.Index();
    instr.BIndex = arg1.Index();
    instr.CIndex = arg2.Index();
