    internal fn bool Observe(
        mut borrow MirEnumAbiSlotAccumulator self,
        u64[0 max] slotStart,
        u64[0 max] slotSize,
        u64[0 max] unitOffset,
        u64[0 max] unitSize,
        MirEnumAbiStorageKind kind)
    {
        if (unitSize == 0)
        {
            return true;
        }

        stack u64[0 max] slotEnd = slotStart + slotSize;
        stack u64[0 max] unitEnd = unitOffset + unitSize;
        if (unitOffset < slotEnd && unitEnd > slotStart)
        {
            self.Any = true;
            if (unitOffset < slotStart || unitEnd > slotEnd)
            {
                return false;
            }

            if (kind == MirEnumAbiStorageKind.Integer)
            {
                self.AnyInteger = true;
            }
            else if (kind == MirEnumAbiStorageKind.Sse)
            {
                if (self.SseCount == 0)
                {
                    self.FirstOffset = unitOffset;
                    self.FirstSize = unitSize;
                }
                else if (self.SseCount == 1)
                {
                    self.SecondOffset = unitOffset;
                    self.SecondSize = unitSize;
                }

                self.SseCount = self.SseCount + 1;
            }
        }

        return true;
    }

    internal finite law AbiCarrierKind Carrier(borrow MirEnumAbiSlotAccumulator self, u64[0 max] slotStart, u64[0 max] slotSize)
    {
        if (!self.Any || self.AnyInteger)
        {
            return MirEnumAbiIntegerCarrierForSize(slotSize);
        }

        if (self.SseCount == 1)
        {
            if (self.FirstOffset == slotStart && self.FirstSize == 4)
            {
                return AbiCarrierKind.F32;
            }

            if (self.FirstOffset == slotStart && self.FirstSize == 8)
            {
                return AbiCarrierKind.F64;
            }
        }

        if (self.SseCount == 2
            && self.FirstOffset == slotStart
            && self.SecondOffset == slotStart + 4
            && self.FirstSize == 4
            && self.SecondSize == 4)
        {
            return AbiCarrierKind.Vector2F32;
        }

        return AbiCarrierKind.None;
    }
}

internal inline finite law u64[0 max] MirEnumAbiIndirectThresholdBytes()
{
    return 16;
}

internal inline finite law bool MirEnumAbiFitsU32(u64[0 max] value)
{
    return value <= 4294967295;
}

internal finite law u64[0 max] MirEnumAbiAlignUp(u64[0 max] value, u64[0 max] alignment)
{
    if (alignment <= 1)
    {
        return value;
    }

    stack u64[0 max] remainder = value % alignment;
    if (remainder == 0)
    {
        return value;
    }

    return value + alignment - remainder;
}

internal finite law AbiCarrierKind MirEnumAbiIntegerCarrierForSize(u64[0 max] sizeBytes)
{
    if (sizeBytes <= 1)
    {
        return AbiCarrierKind.I8;
    }

    if (sizeBytes <= 2)
    {
        return AbiCarrierKind.I16;
    }

    if (sizeBytes <= 4)
    {
        return AbiCarrierKind.I32;
    }

    if (sizeBytes <= 8)
    {
        return AbiCarrierKind.I64;
    }

    return AbiCarrierKind.None;
}

internal finite law MirEnumAbiStorageKind MirEnumAbiStorageKindForFact(MirEnumLayoutFact fact)
{
    if (fact.TypeKind() == Compiler.Typing.TypedSignatureTypeKind.Float
        && (fact.SizeBytes() == 4 || fact.SizeBytes() == 8))
    {
        return MirEnumAbiStorageKind.Sse;
    }

    if (fact.TypeKind() != Compiler.Typing.TypedSignatureTypeKind.Unknown)
    {
        return MirEnumAbiStorageKind.Integer;
    }

    return MirEnumAbiStorageKind.Unknown;
}

public fn bool TryBuildMirEnumAbiLayoutFacts(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    out MirEnumAbiLayoutFacts layout)
{
    layout = new();
    stack mut bool tagSeen = false;
    stack mut bool concrete = true;
    stack mut bool misaligned = false;
    stack mut bool tagMisaligned = false;
    stack mut u32[0 max] ownerNameToken = 0;
    stack mut u32[0 max] variantCount = 0;
    stack mut u32[0 max] payloadFieldCount = 0;
    stack mut u64[0 max] tagOffset = 0;
    stack mut u64[0 max] tagSize = 0;
    stack mut u64[0 max] tagAlignment = 0;
    stack mut u64[0 max] maxEnd = 0;
    stack mut u64[0 max] maxAlignment = 1;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        stack TypeId factOwner = fact.OwnerType();
        if (factOwner.Equals(ownerType)
            && (fact.RowKind() == MirEnumLayoutFactRowKind.Variant || fact.RowKind() == MirEnumLayoutFactRowKind.Payload))
        {
            if (ownerNameToken == 0)
            {
                ownerNameToken = fact.OwnerNameToken();
            }

            if (!fact.HasConcreteLayout())
            {
                concrete = false;
            }

            if (fact.IsMisaligned())
            {
                misaligned = true;
            }

            stack u64[0 max] end = fact.OffsetBytes() + fact.SizeBytes();
            if (end > maxEnd)
            {
                maxEnd = end;
            }

            if (fact.AlignmentBytes() > maxAlignment)
            {
                maxAlignment = fact.AlignmentBytes();
            }

            if (fact.RowKind() == MirEnumLayoutFactRowKind.Variant)
            {
                variantCount = variantCount + 1;
                if (!tagSeen)
                {
                    tagSeen = true;
                    tagOffset = fact.OffsetBytes();
                    tagSize = fact.SizeBytes();
                    tagAlignment = fact.AlignmentBytes();
                    tagMisaligned = fact.IsMisaligned();
                }
                else if (tagOffset != fact.OffsetBytes()
                    || tagSize != fact.SizeBytes()
                    || tagAlignment != fact.AlignmentBytes())
                {
                    concrete = false;
                }
            }
            else
            {
                payloadFieldCount = payloadFieldCount + 1;
            }
        }
    }

    if (!tagSeen || variantCount == 0 || tagSize == 0 || tagAlignment == 0 || maxEnd == 0)
    {
        return false;
    }

    stack mut MirEnumAbiLayoutFacts built = new();
    built.HasFactsValue = true;
    built.OwnerTypeValue = ownerType;
    built.OwnerNameTokenValue = ownerNameToken;
    built.VariantCountValue = variantCount;
    built.PayloadFieldCountValue = payloadFieldCount;
    built.TagOffsetBytesValue = tagOffset;
    built.TagSizeBytesValue = tagSize;
    built.TagAlignmentBytesValue = tagAlignment;
    built.TagMisalignedValue = tagMisaligned;
    built.SizeBytesValue = MirEnumAbiAlignUp(maxEnd, maxAlignment);
    built.AlignmentBytesValue = maxAlignment;
    built.ConcreteLayoutValue = concrete;
    built.MisalignedStorageValue = misaligned;
    layout = built;
    return true;
}

public finite law bool MirEnumAbiRequiresIndirectParameter(MirEnumAbiLayoutFacts layout)
{
    return layout.Present()
        && layout.HasConcreteLayout()
        && layout.SizeBytes() > MirEnumAbiIndirectThresholdBytes();
}

public finite law bool MirEnumAbiRequiresIndirectReturn(MirEnumAbiLayoutFacts layout)
{
    return MirEnumAbiRequiresIndirectParameter(layout);
}

internal fn AbiCarrierKind MirEnumAbiSlotCarrierForFacts(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    MirEnumAbiLayoutFacts layout,
    u64[0 max] slotStart,
    u64[0 max] slotSize)
{
    stack mut MirEnumAbiSlotAccumulator accumulator = new();
    if (!accumulator.Observe(
        slotStart,
        slotSize,
        layout.TagOffsetBytes(),
        layout.TagSizeBytes(),
        MirEnumAbiStorageKind.Integer))
    {
        return AbiCarrierKind.None;
    }

    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        stack TypeId factOwner = fact.OwnerType();
        if (factOwner.Equals(ownerType) && fact.RowKind() == MirEnumLayoutFactRowKind.Payload)
        {
            if (!accumulator.Observe(
                slotStart,
                slotSize,
                fact.OffsetBytes(),
                fact.SizeBytes(),
                MirEnumAbiStorageKindForFact(fact)))
            {
                return AbiCarrierKind.None;
            }
        }
    }

    return accumulator.Carrier(slotStart, slotSize);
}

public fn bool TryBuildMirEnumCAbiCarrierFacts(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    out CAbiAggregateCarrierFacts carrierFacts)
{
    carrierFacts = new();
    stack mut MirEnumAbiLayoutFacts layout = new();
    if (!TryBuildMirEnumAbiLayoutFacts(facts, ownerType, layout))
    {
        return false;
    }

    if (!layout.HasConcreteLayout()
        || !MirEnumAbiFitsU32(layout.SizeBytes())
        || !MirEnumAbiFitsU32(layout.AlignmentBytes()))
    {
        carrierFacts.SetUnsupported();
        return true;
    }

    if (layout.HasMisalignedStorage() || layout.SizeBytes() > MirEnumAbiIndirectThresholdBytes())
    {
        carrierFacts.SetIndirect((u32[0 max])layout.SizeBytes(), (u32[0 max])layout.AlignmentBytes());
        return true;
    }

    stack mut u32[0 max] carrierCount = 0;
    stack mut AbiCarrierKind carrier0 = AbiCarrierKind.None;
    stack mut AbiCarrierKind carrier1 = AbiCarrierKind.None;
    stack mut AbiCarrierKind carrier2 = AbiCarrierKind.None;
    stack mut AbiCarrierKind carrier3 = AbiCarrierKind.None;
    stack mut u64[0 max] slotStart = 0;
    while willexit (slotStart < layout.SizeBytes())
    {
        stack mut u64[0 max] slotSize = 8;
        if (layout.SizeBytes() - slotStart < 8)
        {
            slotSize = layout.SizeBytes() - slotStart;
        }

        stack AbiCarrierKind carrier = MirEnumAbiSlotCarrierForFacts(facts, ownerType, layout, slotStart, slotSize);
        if (carrier == AbiCarrierKind.None)
        {
            carrierFacts.SetUnsupported();
            return true;
        }

        switch (carrierCount)
        {
            case 0:
                carrier0 = carrier;
            case 1:
                carrier1 = carrier;
            case 2:
                carrier2 = carrier;
            case 3:
                carrier3 = carrier;
            default:
                carrierFacts.SetUnsupported();
                return true;
        }

        carrierCount = carrierCount + 1;
        slotStart = slotStart + 8;
    }

    carrierFacts.SetDirect(
        (u32[0 max])layout.SizeBytes(),
        (u32[0 max])layout.AlignmentBytes(),
        carrierCount,
        carrier0,
        carrier1,
        carrier2,
        carrier3);
    return true;
}

internal fn MemoryStatus EmitLlvmByteStorageType(u64[0 max] sizeBytes, mut borrow OwnedAscii sink)
{
    if (sizeBytes <= 1)
    {
        try sink.AppendConstAscii("i8");
        return MemoryStatus.Ok;
    }

    try sink.AppendConstAscii("[");
    try sink.AppendU64(sizeBytes);
    try sink.AppendConstAscii(" x i8]");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmIntegerStorageType(u32[0 max] bitWidth, u64[0 max] sizeBytes, mut borrow OwnedAscii sink)
{
    if (bitWidth == 0)
    {
        return EmitLlvmByteStorageType(sizeBytes, sink);
    }

    try sink.AppendConstAscii("i");
    try sink.AppendU64((u64[0 max])bitWidth);
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmEnumFactStorageType(MirEnumLayoutFact fact, mut borrow OwnedAscii sink)
{
    switch (fact.TypeKind())
    {
        case Compiler.Typing.TypedSignatureTypeKind.Bool:
            try sink.AppendConstAscii("i1");
        case Compiler.Typing.TypedSignatureTypeKind.Integer:
            try EmitLlvmIntegerStorageType(fact.BitWidth(), fact.SizeBytes(), sink);
        case Compiler.Typing.TypedSignatureTypeKind.Float:
            if (fact.SizeBytes() == 2)
            {
                try sink.AppendConstAscii("half");
            }
            else if (fact.SizeBytes() == 4)
            {
                try sink.AppendConstAscii("float");
            }
            else if (fact.SizeBytes() == 8)
            {
                try sink.AppendConstAscii("double");
            }
            else
            {
                try EmitLlvmByteStorageType(fact.SizeBytes(), sink);
            }
        case Compiler.Typing.TypedSignatureTypeKind.RawPointer:
            if (fact.SizeBytes() == 8)
            {
                try sink.AppendConstAscii("ptr");
            }
            else
            {
                try EmitLlvmByteStorageType(fact.SizeBytes(), sink);
            }
        case Compiler.Typing.TypedSignatureTypeKind.FunctionPointer:
            if (fact.SizeBytes() == 8)
            {
                try sink.AppendConstAscii("ptr");
            }
            else
            {
                try EmitLlvmByteStorageType(fact.SizeBytes(), sink);
            }
        default:
            try EmitLlvmByteStorageType(fact.SizeBytes(), sink);
    }

    return MemoryStatus.Ok;
}

internal struct MirEnumStorageEmitState
{
    u64[0 max] Cursor;
    bool EmittedField;

    MirEnumStorageEmitState()
    {
        self.Cursor = 0;
        self.EmittedField = false;
    }

    internal inline finite law u64[0 max] CursorBytes(borrow MirEnumStorageEmitState self)
    {
        return self.Cursor;
    }

    internal inline finite law bool HasEmittedField(borrow MirEnumStorageEmitState self)
    {
        return self.EmittedField;
    }
}

internal fn MemoryStatus EmitLlvmEnumStorageField(
    MirEnumLayoutFact fact,
    mut borrow MirEnumStorageEmitState state,
    mut borrow OwnedAscii sink)
{
    if (fact.OffsetBytes() < state.Cursor)
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (fact.OffsetBytes() > state.Cursor)
    {
        if (state.EmittedField)
        {
            try sink.AppendConstAscii(", ");
        }

        try EmitLlvmByteStorageType(fact.OffsetBytes() - state.Cursor, sink);
        state.Cursor = fact.OffsetBytes();
        state.EmittedField = true;
    }

    if (state.EmittedField)
    {
        try sink.AppendConstAscii(", ");
    }

    try EmitLlvmEnumFactStorageType(fact, sink);
    state.Cursor = fact.OffsetBytes() + fact.SizeBytes();
    state.EmittedField = true;
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmEnumStorageType(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    mut borrow OwnedAscii sink)
{
    stack mut MirEnumAbiLayoutFacts layout = new();
    if (!TryBuildMirEnumAbiLayoutFacts(facts, ownerType, layout) || !layout.HasConcreteLayout())
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    try sink.AppendConstAscii("{ ");
    stack mut MirEnumStorageEmitState emitState = new();
    stack mut bool emittedTag = false;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        stack TypeId factOwner = fact.OwnerType();
        if (!emittedTag
            && factOwner.Equals(ownerType)
            && fact.RowKind() == MirEnumLayoutFactRowKind.Variant)
        {
            try EmitLlvmEnumStorageField(fact, emitState, sink);
            emittedTag = true;
        }
    }

    if (!emittedTag)
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        stack TypeId factOwner = fact.OwnerType();
        if (factOwner.Equals(ownerType) && fact.RowKind() == MirEnumLayoutFactRowKind.Payload)
        {
            try EmitLlvmEnumStorageField(fact, emitState, sink);
        }
    }

    if (emitState.CursorBytes() > layout.SizeBytes())
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (emitState.CursorBytes() < layout.SizeBytes())
    {
        if (emitState.HasEmittedField())
        {
            try sink.AppendConstAscii(", ");
        }

        try EmitLlvmByteStorageType(layout.SizeBytes() - emitState.CursorBytes(), sink);
    }

    try sink.AppendConstAscii(" }");
    return MemoryStatus.Ok;
}

public fn bool TryGetMirEnumVariantFact(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    u32[0 max] variantOrdinal,
    out MirEnumLayoutFact variantFact)
{
    variantFact = new();
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        stack TypeId factOwner = fact.OwnerType();
        if (factOwner.Equals(ownerType)
            && fact.RowKind() == MirEnumLayoutFactRowKind.Variant
            && fact.VariantOrdinal() == variantOrdinal
            && fact.HasConcreteLayout())
        {
            variantFact = fact;
            return true;
        }
    }

    return false;
}

public fn bool TryGetMirEnumPayloadFact(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    out MirEnumLayoutFact payloadFact)
{
    payloadFact = new();
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        stack TypeId factOwner = fact.OwnerType();
        if (factOwner.Equals(ownerType)
            && fact.RowKind() == MirEnumLayoutFactRowKind.Payload
            && fact.VariantOrdinal() == variantOrdinal
            && fact.PayloadOrdinal() == payloadOrdinal
            && fact.HasConcreteLayout())
        {
            payloadFact = fact;
            return true;
        }
    }

    return false;
}

internal finite law bool MirEnumLayoutFactTargetsSameField(MirEnumLayoutFact fact, MirEnumLayoutFact target)
{
    stack TypeId factOwner = fact.OwnerType();
    stack TypeId targetOwner = target.OwnerType();
    if (!factOwner.Equals(targetOwner) || fact.RowKind() != target.RowKind())
    {
        return false;
    }

    if (fact.RowKind() == MirEnumLayoutFactRowKind.Variant)
    {
        return true;
    }

    if (fact.RowKind() == MirEnumLayoutFactRowKind.Payload)
    {
        return fact.VariantOrdinal() == target.VariantOrdinal()
            && fact.PayloadOrdinal() == target.PayloadOrdinal();
    }

    return false;
}

public fn bool TryGetLlvmEnumFactFieldIndex(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    MirEnumLayoutFact target,
    out u32[0 max] llvmFieldIndex)
{
    llvmFieldIndex = 0;
    stack TypeId targetOwner = target.OwnerType();
    if (!targetOwner.Equals(ownerType)
        || (target.RowKind() != MirEnumLayoutFactRowKind.Variant && target.RowKind() != MirEnumLayoutFactRowKind.Payload)
        || !target.HasConcreteLayout())
    {
        return false;
    }

    stack mut MirEnumAbiLayoutFacts layout = new();
    if (!TryBuildMirEnumAbiLayoutFacts(facts, ownerType, layout) || !layout.HasConcreteLayout())
    {
        return false;
    }

    stack mut u64[0 max] cursorBytes = 0;
    stack mut u32[0 max] fieldIndex = 0;
    stack mut bool emittedTag = false;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        stack TypeId factOwner = fact.OwnerType();
        if (!emittedTag
            && factOwner.Equals(ownerType)
            && fact.RowKind() == MirEnumLayoutFactRowKind.Variant)
        {
            if (fact.OffsetBytes() < cursorBytes)
            {
                return false;
            }

            if (fact.OffsetBytes() > cursorBytes)
            {
                fieldIndex = (u32[0 max])(fieldIndex + 1);
                cursorBytes = fact.OffsetBytes();
            }

            if (target.RowKind() == MirEnumLayoutFactRowKind.Variant)
            {
                llvmFieldIndex = fieldIndex;
                return true;
            }

            cursorBytes = fact.OffsetBytes() + fact.SizeBytes();
            fieldIndex = (u32[0 max])(fieldIndex + 1);
            emittedTag = true;
        }
    }

    if (!emittedTag)
    {
        return false;
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        stack TypeId factOwner = fact.OwnerType();
        if (factOwner.Equals(ownerType) && fact.RowKind() == MirEnumLayoutFactRowKind.Payload)
        {
            if (fact.OffsetBytes() < cursorBytes)
            {
                return false;
            }

            if (fact.OffsetBytes() > cursorBytes)
            {
                fieldIndex = (u32[0 max])(fieldIndex + 1);
                cursorBytes = fact.OffsetBytes();
            }

            if (MirEnumLayoutFactTargetsSameField(fact, target))
            {
                llvmFieldIndex = fieldIndex;
                return true;
            }

            cursorBytes = fact.OffsetBytes() + fact.SizeBytes();
            fieldIndex = (u32[0 max])(fieldIndex + 1);
        }
    }

    return false;
}

public fn bool TryGetLlvmEnumTagFieldIndex(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    out u32[0 max] llvmFieldIndex)
{
    llvmFieldIndex = 0;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack MirEnumLayoutFact fact = facts.Get((u32[0 max])(index + 1));
        stack TypeId factOwner = fact.OwnerType();
        if (factOwner.Equals(ownerType)
            && fact.RowKind() == MirEnumLayoutFactRowKind.Variant
            && fact.HasConcreteLayout())
        {
            return TryGetLlvmEnumFactFieldIndex(facts, ownerType, fact, llvmFieldIndex);
        }
    }

    return false;
}

public fn bool TryGetLlvmEnumPayloadFieldIndex(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    out u32[0 max] llvmFieldIndex)
{
    llvmFieldIndex = 0;
    stack mut MirEnumLayoutFact payloadFact = new();
    if (!TryGetMirEnumPayloadFact(facts, ownerType, variantOrdinal, payloadOrdinal, payloadFact))
    {
        return false;
    }

    return TryGetLlvmEnumFactFieldIndex(facts, ownerType, payloadFact, llvmFieldIndex);
}

internal fn MemoryStatus EmitLlvmEnumStorageTypeOperand(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    const ascii valueName,
    mut borrow OwnedAscii sink)
{
    try EmitLlvmEnumStorageType(facts, ownerType, sink);
    try sink.AppendConstAscii(" ");
    try sink.AppendConstAscii(valueName);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmEnumVariantTagConstructor(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    u32[0 max] variantOrdinal,
    const ascii resultName,
    mut borrow OwnedAscii sink)
{
    stack mut MirEnumLayoutFact variantFact = new();
    if (!TryGetMirEnumVariantFact(facts, ownerType, variantOrdinal, variantFact))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    stack mut u32[0 max] fieldIndex = 0;
    if (!TryGetLlvmEnumFactFieldIndex(facts, ownerType, variantFact, fieldIndex))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    try sink.AppendConstAscii("  ");
    try sink.AppendConstAscii(resultName);
    try sink.AppendConstAscii(" = insertvalue ");
    try EmitLlvmEnumStorageType(facts, ownerType, sink);
    try sink.AppendConstAscii(" zeroinitializer, ");
    try EmitLlvmEnumFactStorageType(variantFact, sink);
    try sink.AppendConstAscii(" ");
    try sink.AppendU64((u64[0 max])variantFact.VariantTag());
    try sink.AppendConstAscii(", ");
    try sink.AppendU64((u64[0 max])fieldIndex);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmEnumPayloadInsert(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    const ascii resultName,
    const ascii sourceValueName,
    const ascii payloadValueName,
    mut borrow OwnedAscii sink)
{
    stack mut MirEnumLayoutFact payloadFact = new();
    if (!TryGetMirEnumPayloadFact(facts, ownerType, variantOrdinal, payloadOrdinal, payloadFact))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    stack mut u32[0 max] fieldIndex = 0;
    if (!TryGetLlvmEnumFactFieldIndex(facts, ownerType, payloadFact, fieldIndex))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    try sink.AppendConstAscii("  ");
    try sink.AppendConstAscii(resultName);
    try sink.AppendConstAscii(" = insertvalue ");
    try EmitLlvmEnumStorageTypeOperand(facts, ownerType, sourceValueName, sink);
    try sink.AppendConstAscii(", ");
    try EmitLlvmEnumFactStorageType(payloadFact, sink);
    try sink.AppendConstAscii(" ");
    try sink.AppendConstAscii(payloadValueName);
    try sink.AppendConstAscii(", ");
    try sink.AppendU64((u64[0 max])fieldIndex);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmEnumValueLoad(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    const ascii resultName,
    const ascii sourcePtrName,
    mut borrow OwnedAscii sink)
{
    stack mut MirEnumAbiLayoutFacts layout = new();
    if (!TryBuildMirEnumAbiLayoutFacts(facts, ownerType, layout) || !layout.HasConcreteLayout())
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    try sink.AppendConstAscii("  ");
    try sink.AppendConstAscii(resultName);
    try sink.AppendConstAscii(" = load ");
    try EmitLlvmEnumStorageType(facts, ownerType, sink);
    try sink.AppendConstAscii(", ptr ");
    try sink.AppendConstAscii(sourcePtrName);
    try sink.AppendConstAscii(", align ");
    try sink.AppendU64(layout.AlignmentBytes());
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmEnumValueStore(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    const ascii valueName,
    const ascii targetPtrName,
    mut borrow OwnedAscii sink)
{
    stack mut MirEnumAbiLayoutFacts layout = new();
    if (!TryBuildMirEnumAbiLayoutFacts(facts, ownerType, layout) || !layout.HasConcreteLayout())
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    try sink.AppendConstAscii("  store ");
    try EmitLlvmEnumStorageTypeOperand(facts, ownerType, valueName, sink);
    try sink.AppendConstAscii(", ptr ");
    try sink.AppendConstAscii(targetPtrName);
    try sink.AppendConstAscii(", align ");
    try sink.AppendU64(layout.AlignmentBytes());
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmEnumTagRead(
    borrow IrTable<MirEnumLayoutFact> facts,
    TypeId ownerType,
    const ascii resultName,
    const ascii enumValueName,
    mut borrow OwnedAscii sink)
{
    stack mut u32[0 max] fieldIndex = 0;
    if (!TryGetLlvmEnumTagFieldIndex(facts, ownerType, fieldIndex))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    try sink.AppendConstAscii("  ");
    try sink.AppendConstAscii(resultName);
    try sink.AppendConstAscii(" = extractvalue ");
    try EmitLlvmEnumStorageTypeOperand(facts, ownerType, enumValueName, sink);
    try sink.AppendConstAscii(", ");
    try sink.AppendU64((u64[0 max])fieldIndex);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

internal finite law MirEnumLayoutFactRowKind MirEnumLayoutFactRowKindFromTyped(Compiler.Typing.TypedEnumLayoutRowKind kind)
{
    switch (kind)
    {
        case Compiler.Typing.TypedEnumLayoutRowKind.Variant:
            return MirEnumLayoutFactRowKind.Variant;
        case Compiler.Typing.TypedEnumLayoutRowKind.Payload:
            return MirEnumLayoutFactRowKind.Payload;
        default:
            return MirEnumLayoutFactRowKind.Unknown;
    }
}

internal fn MirEnumLayoutFact MirEnumLayoutFactFromTypedRow(
    borrow Compiler.Typing.TypedEnumLayoutTable layouts,
    u64[0 2 ** 63 - 1] index)
{
    stack mut MirEnumLayoutFact fact = new();
    fact.RowKindValue = MirEnumLayoutFactRowKindFromTyped(layouts.RowKindAt(index));
    fact.OwnerTypeValue = TypeIdOf((u32[0 max])(layouts.OwnerDeclarationIndexAt(index) + 1));
    fact.OwnerNameTokenValue = layouts.OwnerNameTokenAt(index);
    fact.VariantOrdinalValue = layouts.VariantOrdinalAt(index);
    fact.VariantNameTokenValue = layouts.VariantNameTokenAt(index);
    fact.VariantTagValue = layouts.VariantTagAt(index);
    fact.PayloadCountValue = layouts.PayloadCountAt(index);
    fact.PayloadOrdinalValue = layouts.PayloadOrdinalAt(index);
    fact.PayloadNameTokenValue = layouts.PayloadNameTokenAt(index);
    fact.PayloadKindValue = layouts.PayloadKindAt(index);
    fact.VariantRoleValue = layouts.VariantRoleAt(index);
    fact.ErrorFunnelValue = layouts.IsErrorFunnelAt(index);
    fact.UsesNamedPayloadsValue = layouts.UsesNamedPayloadsAt(index);
    fact.StorageFieldOrdinalValue = layouts.StorageFieldOrdinalAt(index);
    fact.OffsetBytesValue = layouts.OffsetBytesAt(index);
    fact.SizeBytesValue = layouts.SizeBytesAt(index);
    fact.AlignmentBytesValue = layouts.AlignmentBytesAt(index);
    fact.MisalignedValue = layouts.IsMisalignedAt(index);
    fact.TypeKindValue = layouts.TypeKindAt(index);
    fact.TypeHeadTokenValue = layouts.TypeHeadTokenAt(index);
    fact.TypePrimaryTokenValue = layouts.TypePrimaryTokenAt(index);
    fact.BitWidthValue = layouts.BitWidthAt(index);
    fact.TypeFlagsValue = layouts.TypeFlagsAt(index);
    fact.ConcreteLayoutValue = layouts.HasConcreteLayoutAt(index);
    return fact;
}

public fn bool BuildMirEnumLayoutFactsFromTypedLayouts(
    borrow Compiler.Typing.TypedEnumLayoutTable layouts,
    mut borrow IrTable<MirEnumLayoutFact> facts)
{
    stack u64[0 2 ** 63 - 1] count = layouts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (facts.Add(MirEnumLayoutFactFromTypedRow(layouts, index)) == 0)
        {
            return false;
        }
    }

    return true;
}

public fn bool BuildMirEnumLayoutFactsForSource(ascii source, out TokenStream stream, out IrTable<MirEnumLayoutFact> facts)
{
    stream = new();
    facts = new();

    stack mut TokenStream parsedStream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var lexed):
            parsedStream = lexed;
    }

    stack mut DeclarationList declarations = new();
    switch (Compiler.Parsing.ParseDeclarations(parsedStream, 0))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDeclarations):
            declarations = parsedDeclarations;
    }

    stack mut Compiler.Typing.TypedEnumLayoutTable typedLayouts = new();
    switch (Compiler.Typing.BuildTypedEnumLayouts(source, parsedStream, declarations))
    {
        case ParseResult<Compiler.Typing.TypedEnumLayoutTable>.Err(var layoutError):
            return false;
        case ParseResult<Compiler.Typing.TypedEnumLayoutTable>.Ok(var builtLayouts):
            typedLayouts = builtLayouts;
    }

    stack mut IrTable<MirEnumLayoutFact> builtFacts = new();
    if (!BuildMirEnumLayoutFactsFromTypedLayouts(typedLayouts, builtFacts))
    {
        return false;
    }

    facts = builtFacts;
    stream = parsedStream;
    return true;
}

internal struct ParamAbiFacts
{
    bool IsPointer;
    // 0 = none, 1 = captures(none), 2 = ret read-provenance,
    // 3 = ret provenance, 4 = address read-provenance, 5 = address provenance.
    u32[0 max] CaptureKind;
    bool ReadOnly;
    bool WriteOnly;
    bool Writable;
    bool DeadOnReturn;
    u32[0 max] InitializesBytes;

    ParamAbiFacts()
    {
        self.IsPointer = false;
        self.CaptureKind = 0;
        self.ReadOnly = false;
        self.WriteOnly = false;
        self.Writable = false;
        self.DeadOnReturn = false;
        self.InitializesBytes = 0;
    }
}

internal fn ParamAbiFacts AbiFactAt(borrow IrTable<ParamAbiFacts> facts, u32[0 max] index)
{
    stack mut ParamAbiFacts empty = new();
    if (facts.Contains(index))
    {
        return facts.Get(index);
    }

    return empty;
}

internal fn MemoryStatus EmitLlvmCaptureAttribute(ParamAbiFacts facts, mut borrow OwnedAscii sink)
{
    switch (facts.CaptureKind)
    {
        case 1:
            try sink.AppendConstAscii(" captures(none)");
        case 2:
            try sink.AppendConstAscii(" captures(ret: address, read_provenance)");
        case 3:
            try sink.AppendConstAscii(" captures(ret: address, provenance)");
        case 4:
            try sink.AppendConstAscii(" captures(address, read_provenance)");
        case 5:
            try sink.AppendConstAscii(" captures(address, provenance)");
        default:
            try sink.AppendConstAscii("");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmParamAbiAttributes(ParamAbiFacts facts, mut borrow OwnedAscii sink)
{
    try EmitLlvmCaptureAttribute(facts, sink);
    if (facts.ReadOnly)
    {
        try sink.AppendConstAscii(" readonly");
    }

    if (facts.WriteOnly)
    {
        try sink.AppendConstAscii(" writeonly");
    }

    if (facts.Writable)
    {
        try sink.AppendConstAscii(" writable");
    }

    if (facts.InitializesBytes > 0)
    {
        try sink.AppendConstAscii(" initializes((0, ");
        try sink.AppendU64((u64[0 max])facts.InitializesBytes);
        try sink.AppendConstAscii("))");
    }

    if (facts.DeadOnReturn)
    {
        try sink.AppendConstAscii(" dead_on_return");
    }

    return MemoryStatus.Ok;
}

internal struct DistinctStoragePair
{
    u32[0 max] LeftParam;
    u32[0 max] RightParam;

    DistinctStoragePair()
    {
        self.LeftParam = 0;
        self.RightParam = 0;
    }
}

internal fn DistinctStoragePair MakeDistinctStoragePair(u32[0 max] leftParam, u32[0 max] rightParam)
{
    stack mut DistinctStoragePair pair = new();
    if (leftParam <= rightParam)
    {
        pair.LeftParam = leftParam;
        pair.RightParam = rightParam;
    }
    else
    {
        pair.LeftParam = rightParam;
        pair.RightParam = leftParam;
    }

    return pair;
}

internal fn bool DistinctStoragePairExists(borrow IrTable<DistinctStoragePair> facts, u32[0 max] leftParam, u32[0 max] rightParam)
{
    stack DistinctStoragePair canonical = MakeDistinctStoragePair(leftParam, rightParam);
    stack u64[0 2 ** 63 - 1] total = facts.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        stack DistinctStoragePair pair = facts.Get(i);
        if (pair.LeftParam == canonical.LeftParam && pair.RightParam == canonical.RightParam)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool AddDistinctStoragePairIfAbsent(mut borrow IrTable<DistinctStoragePair> facts, u32[0 max] leftParam, u32[0 max] rightParam)
{
    if (leftParam == rightParam)
    {
        return true;
    }

    if (DistinctStoragePairExists(facts, leftParam, rightParam))
    {
        return true;
    }

    return facts.Add(MakeDistinctStoragePair(leftParam, rightParam)) != 0;
}

internal fn bool AddDistinctStoragePairIfPointerParams(
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    mut borrow IrTable<DistinctStoragePair> facts,
    u32[0 max] leftParam,
    u32[0 max] rightParam)
{
    if (!AbiFactAt(paramAbiFacts, leftParam + 1).IsPointer
        || !AbiFactAt(paramAbiFacts, rightParam + 1).IsPointer)
    {
        return true;
    }

    return AddDistinctStoragePairIfAbsent(facts, leftParam, rightParam);
}

internal struct FunctionCallContractFacts
{
    u32[0 max] ParamCount;
    ParamAbiFacts Param0;
    ParamAbiFacts Param1;
    ParamAbiFacts Param2;
    ParamAbiFacts Param3;
    u32[0 max] DistinctCount;
    DistinctStoragePair Distinct0;
    DistinctStoragePair Distinct1;
    DistinctStoragePair Distinct2;
    DistinctStoragePair Distinct3;
    DistinctStoragePair Distinct4;
    DistinctStoragePair Distinct5;

    FunctionCallContractFacts()
    {
        self.ParamCount = 0;
        self.Param0 = new();
        self.Param1 = new();
        self.Param2 = new();
        self.Param3 = new();
        self.DistinctCount = 0;
        self.Distinct0 = new();
        self.Distinct1 = new();
        self.Distinct2 = new();
        self.Distinct3 = new();
        self.Distinct4 = new();
        self.Distinct5 = new();
    }
}

internal fn ParamAbiFacts FunctionCallContractParamAbi(FunctionCallContractFacts facts, u32[0 max] paramIndex)
{
    switch (paramIndex)
    {
        case 0:
            return facts.Param0;
        case 1:
            return facts.Param1;
        case 2:
            return facts.Param2;
        case 3:
            return facts.Param3;
        default:
            stack mut ParamAbiFacts empty = new();
            return empty;
    }
}

internal fn DistinctStoragePair FunctionCallContractDistinctPair(FunctionCallContractFacts facts, u32[0 max] pairIndex)
{
    switch (pairIndex)
    {
        case 0:
            return facts.Distinct0;
        case 1:
            return facts.Distinct1;
        case 2:
            return facts.Distinct2;
        case 3:
            return facts.Distinct3;
        case 4:
            return facts.Distinct4;
        case 5:
            return facts.Distinct5;
        default:
            stack mut DistinctStoragePair empty = new();
            return empty;
    }
}

internal fn FunctionCallContractFacts FunctionCallContractFactsAt(borrow IrTable<FunctionCallContractFacts> facts, u32[0 max] functionId)
{
    stack mut FunctionCallContractFacts empty = new();
    if (functionId != 0 && facts.Contains(functionId))
    {
        return facts.Get(functionId);
    }

    return empty;
}

internal fn bool BuildFunctionCallContractFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.FunctionSignature signature,
    u32[0 max] fnKeyword,
    out FunctionCallContractFacts facts)
{
    facts = new();
    stack mut FunctionCallContractFacts built = new();
    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    built.ParamCount = (u32[0 max])signature.ParamCount();
    built.Param0 = AbiFactAt(paramAbiFacts, 1);
    built.Param1 = AbiFactAt(paramAbiFacts, 2);
    built.Param2 = AbiFactAt(paramAbiFacts, 3);
    built.Param3 = AbiFactAt(paramAbiFacts, 4);

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, fnKeyword, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] distinctCount = distinctStorageFacts.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= distinctCount && i <= 6)
    {
        stack DistinctStoragePair pair = distinctStorageFacts.Get(i);
        switch (i)
        {
            case 1:
                built.Distinct0 = pair;
            case 2:
                built.Distinct1 = pair;
            case 3:
                built.Distinct2 = pair;
            case 4:
                built.Distinct3 = pair;
            case 5:
                built.Distinct4 = pair;
            case 6:
                built.Distinct5 = pair;
            default:
                stack bool ignored = true;
        }

        i = i + 1;
    }

    built.DistinctCount = (u32[0 max])distinctCount;
    if (built.DistinctCount > 6)
    {
        built.DistinctCount = 6;
    }

    facts = built;
    return true;
}

internal struct LlvmRangeMetadata
{
    MirType Type;
    i64[min max] Lower;
    i64[min max] UpperExclusive;

    LlvmRangeMetadata()
    {
        self.Type = MirType.I64;
        self.Lower = 0;
        self.UpperExclusive = 0;
    }
}

internal fn LlvmRangeMetadata MakeLlvmRangeMetadata(MirType type, ValueFacts facts)
{
    stack mut LlvmRangeMetadata metadata = new();
    metadata.Type = type;
    metadata.Lower = facts.IntegerRangeLower();
    metadata.UpperExclusive = facts.IntegerRangeUpperExclusive();
    return metadata;
}

internal fn bool LlvmRangeMetadataEquals(LlvmRangeMetadata metadata, MirType type, ValueFacts facts)
{
    return metadata.Type == type
        && metadata.Lower == facts.IntegerRangeLower()
        && metadata.UpperExclusive == facts.IntegerRangeUpperExclusive();
}

internal fn MemoryStatus GetOrAddLlvmRangeMetadata(mut borrow IrTable<LlvmRangeMetadata> ranges, MirType type, ValueFacts facts, out u32[0 max] metadataId)
{
    metadataId = 0;
    if (!facts.HasIntegerRange())
    {
        return MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] count = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack LlvmRangeMetadata metadata = ranges.Get(i);
        if (LlvmRangeMetadataEquals(metadata, type, facts))
        {
            metadataId = i - 1;
            return MemoryStatus.Ok;
        }

        i = i + 1;
    }

    stack u32[0 max] added = ranges.Add(MakeLlvmRangeMetadata(type, facts));
    if (added == 0)
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    metadataId = added - 1;
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmRangeMetadataAttachment(MirType type, ValueFacts facts, mut borrow IrTable<LlvmRangeMetadata> ranges, mut borrow OwnedAscii sink)
{
    if (!facts.HasIntegerRange())
    {
        return MemoryStatus.Ok;
    }

    stack mut u32[0 max] metadataId = 0;
    try GetOrAddLlvmRangeMetadata(ranges, type, facts, metadataId);
    try sink.AppendConstAscii(", !range !");
    try sink.AppendU64((u64[0 max])metadataId);
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmRangeMetadataDefinitions(borrow IrTable<LlvmRangeMetadata> ranges, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack LlvmRangeMetadata metadata = ranges.Get(i);
        try sink.AppendConstAscii("!");
        try sink.AppendU64((u64[0 max])(i - 1));
        try sink.AppendConstAscii(" = !{");
        try EmitLlvmTypeName(metadata.Type, sink);
        try sink.AppendConstAscii(" ");
        try sink.AppendI64(metadata.Lower);
        try sink.AppendConstAscii(", ");
        try EmitLlvmTypeName(metadata.Type, sink);
        try sink.AppendConstAscii(" ");
        try sink.AppendI64(metadata.UpperExclusive);
        try sink.AppendConstAscii("}\n");
        i = i + 1;
    }

    return MemoryStatus.Ok;
}

internal inline finite law u32[0 max] LlvmLoopMetadataBase()
{
    return 100000;
}

internal inline finite law u32[0 max] LlvmLoopMetadataNodeId(u32[0 max] base, u32[0 max] blockIndex)
{
    return base + blockIndex * 2;
}

internal fn MemoryStatus EmitLlvmIndependentLoopMetadataAttachment(
    borrow IrTable<MirBlock> blocks,
    MirBlockId block,
    u32[0 max] metadataBase,
    mut borrow OwnedAscii sink)
{
    if (!MirBlockHasIndependentLoopBackedge(blocks, block))
    {
        return MemoryStatus.Ok;
    }

    try sink.AppendConstAscii(", !llvm.loop !");
    try sink.AppendU64((u64[0 max])LlvmLoopMetadataNodeId(metadataBase, block.Index()));
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmIndependentLoopMetadataDefinitions(
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<BlockEmit> ranges,
    u32[0 max] metadataBase,
    mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        stack u32[0 max] blockIndex = ranges.Get(i).BlockIndex;
        if (MirBlockHasIndependentLoopBackedge(blocks, MirBlockIdOf(blockIndex)))
        {
            stack u32[0 max] nodeId = LlvmLoopMetadataNodeId(metadataBase, blockIndex);
            try sink.AppendConstAscii("!");
            try sink.AppendU64((u64[0 max])nodeId);
            try sink.AppendConstAscii(" = distinct !{!");
            try sink.AppendU64((u64[0 max])nodeId);
            try sink.AppendConstAscii(", !");
            try sink.AppendU64((u64[0 max])(nodeId + 1));
            try sink.AppendConstAscii("}\n!");
            try sink.AppendU64((u64[0 max])(nodeId + 1));
            try sink.AppendConstAscii(" = !{!\"llvm.loop.vectorize.enable\", i1 true}\n");
        }

        i = i + 1;
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallArg(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] valueIndex)
{
    try EmitLlvmTypeName(MirValueType(instrs, valueIndex), sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmOperand(instrs, sink, valueIndex);
    return MemoryStatus.Ok;
}

// Appends an LLVM call argument list. Each argument carries the MIR type of its
// defining value and lowers to either `%vN` or a parameter operand `%pK`.
internal fn MemoryStatus EmitLlvmCallArgs(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] a, u32[0 max] b, u32[0 max] c, u32[0 max] d)
{
    // Arguments are contiguous (a, then b, c, d, with 0 = absent in the trailing slots), so
    // each non-zero slot after the first is preceded by an existing argument — the `, `
    // separator never produces a leading comma.
    try sink.AppendConstAscii("(");
    if (a != 0)
    {
        try EmitLlvmCallArg(instrs, sink, a);
    }

    if (b != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmCallArg(instrs, sink, b);
    }

    if (c != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmCallArg(instrs, sink, c);
    }

    if (d != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmCallArg(instrs, sink, d);
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallArgWithRangeFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow OwnedAscii sink,
    u32[0 max] valueIndex)
{
    stack MirType valueType = MirValueType(instrs, valueIndex);
    try EmitLlvmTypeName(valueType, sink);
    try EmitLlvmRangeAttribute(
        valueType,
        RangeFactForValue(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, valueIndex),
        sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmOperand(instrs, sink, valueIndex);
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmPointerCallArgAttributes(ParamAbiFacts abi, ValueFacts facts, mut borrow OwnedAscii sink)
{
    if (facts.KnownNonNull())
    {
        try sink.AppendConstAscii(" nonnull");
    }

    if (facts.HasNoAlias())
    {
        try sink.AppendConstAscii(" noalias");
    }

    try EmitLlvmParamAbiAttributes(abi, sink);

    if (facts.HasAlignment())
    {
        try sink.AppendConstAscii(" align ");
        try sink.AppendU64((u64[0 max])facts.AlignmentBytes());
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallArgWithRangeAndAbiFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    FunctionCallContractFacts calleeFacts,
    u32[0 max] argIndex,
    mut borrow OwnedAscii sink,
    u32[0 max] valueIndex)
{
    stack ParamAbiFacts abi = FunctionCallContractParamAbi(calleeFacts, argIndex);
    stack ValueFacts facts = RangeFactForValue(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, valueIndex);
    if (abi.IsPointer)
    {
        try sink.AppendConstAscii("ptr");
        try EmitLlvmPointerCallArgAttributes(abi, facts, sink);
        try sink.AppendConstAscii(" ");
        try EmitLlvmOperand(instrs, sink, valueIndex);
        return MemoryStatus.Ok;
    }

    stack MirType valueType = MirValueType(instrs, valueIndex);
    try EmitLlvmTypeName(valueType, sink);
    try EmitLlvmRangeAttribute(valueType, facts, sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmOperand(instrs, sink, valueIndex);
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallArgsWithRangeFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow OwnedAscii sink,
    u32[0 max] a,
    u32[0 max] b,
    u32[0 max] c,
    u32[0 max] d)
{
    try sink.AppendConstAscii("(");
    if (a != 0)
    {
        try EmitLlvmCallArgWithRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, sink, a);
    }

    if (b != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmCallArgWithRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, sink, b);
    }

    if (c != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmCallArgWithRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, sink, c);
    }

    if (d != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmCallArgWithRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, sink, d);
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallArgsWithRangeAndAbiFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    FunctionCallContractFacts calleeFacts,
    mut borrow OwnedAscii sink,
    u32[0 max] a,
    u32[0 max] b,
    u32[0 max] c,
    u32[0 max] d)
{
    try sink.AppendConstAscii("(");
    if (a != 0)
    {
        try EmitLlvmCallArgWithRangeAndAbiFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, calleeFacts, 0, sink, a);
    }

    if (b != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmCallArgWithRangeAndAbiFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, calleeFacts, 1, sink, b);
    }

    if (c != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmCallArgWithRangeAndAbiFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, calleeFacts, 2, sink, c);
    }

    if (d != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitLlvmCallArgWithRangeAndAbiFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts, calleeFacts, 3, sink, d);
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

internal finite law u32[0 max] CallArgumentValueIndexForParam(MirInstruction instr, u32[0 max] paramIndex)
{
    switch (paramIndex)
    {
        case 0:
            return instr.OperandAIndex();
        case 1:
            return instr.OperandBIndex();
        case 2:
            return instr.OperandCIndex();
        case 3:
            return instr.OperandDIndex();
        default:
            return 0;
    }
}

internal fn MemoryStatus EmitLlvmSeparateStorageAssumeForValues(
    borrow IrTable<MirInstruction> instrs,
    u32[0 max] leftValue,
    u32[0 max] rightValue,
    mut borrow OwnedAscii sink)
{
    if (leftValue == 0 || rightValue == 0 || leftValue == rightValue)
    {
        return MemoryStatus.Ok;
    }

    try sink.AppendConstAscii("  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr ");
    try EmitLlvmOperand(instrs, sink, leftValue);
    try sink.AppendConstAscii(", ptr ");
    try EmitLlvmOperand(instrs, sink, rightValue);
    try sink.AppendConstAscii(")]\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallSeparateStorageAssumes(
    borrow IrTable<MirInstruction> instrs,
    MirInstruction instr,
    FunctionCallContractFacts calleeFacts,
    mut borrow OwnedAscii sink)
{
    stack mut u32[0 max] i = 0;
    while willexit (i < calleeFacts.DistinctCount)
    {
        stack DistinctStoragePair pair = FunctionCallContractDistinctPair(calleeFacts, i);
        stack u32[0 max] leftValue = CallArgumentValueIndexForParam(instr, pair.LeftParam);
        stack u32[0 max] rightValue = CallArgumentValueIndexForParam(instr, pair.RightParam);
        try EmitLlvmSeparateStorageAssumeForValues(instrs, leftValue, rightValue, sink);
        i = i + 1;
    }

    return MemoryStatus.Ok;
}

// Appends one LLVM line for a 2-incoming phi. The incoming values go through the
// param-aware operand path; the block ids are decoded from `packed`.
internal fn MemoryStatus EmitLlvmPhi(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] dst, u32[0 max] a, u32[0 max] b, i64[min max] packed)
{
    try sink.AppendConstAscii("  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(" = phi ");
    try EmitLlvmTypeName(MirValueType(instrs, dst), sink);
    try sink.AppendConstAscii(" [ ");
    try EmitLlvmOperand(instrs, sink, a);
    try sink.AppendConstAscii(", ");
    try EmitLlvmBlockRef(sink, DecodePhiBlock0(packed));
    try sink.AppendConstAscii(" ], [ ");
    try EmitLlvmOperand(instrs, sink, b);
    try sink.AppendConstAscii(", ");
    try EmitLlvmBlockRef(sink, DecodePhiBlock1(packed));
    try sink.AppendConstAscii(" ]\n");
    return MemoryStatus.Ok;
}

// Appends one LLVM line for a binary op: `  %vDst = <mnemonic> i64 <a>, <b>`, where
// each operand is a value reference (`%vN` or `%pK`).
internal fn MemoryStatus EmitLlvmBinary(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] dst, const ascii mnemonic, u32[0 max] a, u32[0 max] b)
{
    try sink.AppendConstAscii("  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(" = ");
    try sink.AppendConstAscii(mnemonic);
    try sink.AppendConstAscii(" i64 ");
    try EmitLlvmOperand(instrs, sink, a);
    try sink.AppendConstAscii(", ");
    try EmitLlvmOperand(instrs, sink, b);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

internal fn bool FunctionIdIsTailCallable(borrow IrTable<u32[0 max]> funcTailFlags, u32[0 max] functionId)
{
    if (functionId == 0 || !funcTailFlags.Contains(functionId))
    {
        return false;
    }

    return funcTailFlags.Get(functionId) != 0;
}

// Appends the LLVM line for the instruction at 1-based `index` in `instrs`. An
// out-of-range index emits nothing (rather than reading past the table — `Get`
// requires `Contains`, and `index - 1` on a 0 index would wrap).
internal fn MemoryStatus EmitLlvmInstructionWithTailCallees(borrow IrTable<MirInstruction> instrs, borrow IrTable<u32[0 max]> funcTailFlags, mut borrow OwnedAscii sink, u32[0 max] index)
{
    if (!instrs.Contains(index))
    {
        return MemoryStatus.Ok;
    }

    stack MirInstruction instr = instrs.Get(index);
    switch (instr.Opcode())
    {
        case MirOp.ConstInt:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            if (instr.ResultType() == MirType.Ptr)
            {
                try sink.AppendConstAscii(" = inttoptr i64 ");
                try sink.AppendI64(instr.Immediate());
                try sink.AppendConstAscii(" to ptr\n");
            }
            else
            {
                try sink.AppendConstAscii(" = add ");
                try EmitLlvmTypeName(instr.ResultType(), sink);
                try sink.AppendConstAscii(" 0, ");
                try sink.AppendI64(instr.Immediate());
                try sink.AppendConstAscii("\n");
            }
        case MirOp.Param:
            // Declared in the signature; emits no body line.
            try sink.AppendConstAscii("");
        case MirOp.Add:
            try EmitLlvmBinary(instrs, sink, index, "add", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Sub:
            try EmitLlvmBinary(instrs, sink, index, "sub", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Mul:
            try EmitLlvmBinary(instrs, sink, index, "mul", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingAdd:
            try EmitLlvmBinary(instrs, sink, index, "add", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingSub:
            try EmitLlvmBinary(instrs, sink, index, "sub", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingMul:
            try EmitLlvmBinary(instrs, sink, index, "mul", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingAdd:
            try EmitLlvmSaturatingBinary(instrs, sink, index, "add", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingSub:
            try EmitLlvmSaturatingBinary(instrs, sink, index, "sub", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingMul:
            try EmitLlvmSaturatingBinary(instrs, sink, index, "mul", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SDiv:
            try EmitLlvmBinary(instrs, sink, index, "sdiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.UDiv:
            try EmitLlvmBinary(instrs, sink, index, "udiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SRem:
            try EmitLlvmBinary(instrs, sink, index, "srem", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.And:
            try EmitLlvmBinary(instrs, sink, index, "and", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Or:
            try EmitLlvmBinary(instrs, sink, index, "or", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Xor:
            try EmitLlvmBinary(instrs, sink, index, "xor", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Shl:
            try EmitLlvmBinary(instrs, sink, index, "shl", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.AShr:
            try EmitLlvmBinary(instrs, sink, index, "ashr", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpEq:
            try EmitLlvmTypedComparison(instrs, sink, index, "eq", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpNe:
            try EmitLlvmTypedComparison(instrs, sink, index, "ne", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLt:
            try EmitLlvmTypedComparison(instrs, sink, index, "slt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLe:
            try EmitLlvmTypedComparison(instrs, sink, index, "sle", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGt:
            try EmitLlvmTypedComparison(instrs, sink, index, "sgt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGe:
            try EmitLlvmTypedComparison(instrs, sink, index, "sge", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.ZExt:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = zext i1 ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii(" to i64\n");
        case MirOp.LoadGlobal:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = load ");
            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(", ptr @g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.StoreGlobal:
            try sink.AppendConstAscii("  store ");
            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", ptr @g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.ArenaFrameEnter:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaAlloc:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaDynamicStorageInit:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaDynamicStorageReserve:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaDynamicStorageTryReserve:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaDynamicStorageTryReserveCapacity:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaFrameLeave:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.Phi:
            try EmitLlvmPhi(instrs, sink, index, instr.OperandAIndex(), instr.OperandBIndex(), instr.Immediate());
        case MirOp.Call:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = call ");
            if (FunctionIdIsTailCallable(funcTailFlags, (u32[0 max])instr.Immediate()))
            {
                try sink.AppendConstAscii("tailcc ");
            }

            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(" @f");
            try sink.AppendI64(instr.Immediate());
            try EmitLlvmCallArgs(instrs, sink, instr.OperandAIndex(), instr.OperandBIndex(), instr.OperandCIndex(), instr.OperandDIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.TailCall:
            // TailCall is a terminator payload. `EmitLlvmTerminatorWithTailCallees`
            // emits the required `musttail call tailcc` followed by `ret`.
            try sink.AppendConstAscii("");
        case MirOp.Return:
            try sink.AppendConstAscii("  ret ");
            try EmitLlvmTypeName(MirValueType(instrs, instr.OperandAIndex()), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmInstructionWithRangeFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    mut borrow OwnedAscii sink,
    u32[0 max] index)
{
    if (!instrs.Contains(index))
    {
        return MemoryStatus.Ok;
    }

    stack MirInstruction instr = instrs.Get(index);
    switch (instr.Opcode())
    {
        case MirOp.ConstInt:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            if (instr.ResultType() == MirType.Ptr)
            {
                try sink.AppendConstAscii(" = inttoptr i64 ");
                try sink.AppendI64(instr.Immediate());
                try sink.AppendConstAscii(" to ptr\n");
            }
            else
            {
                try sink.AppendConstAscii(" = add ");
                try EmitLlvmTypeName(instr.ResultType(), sink);
                try sink.AppendConstAscii(" 0, ");
                try sink.AppendI64(instr.Immediate());
                try sink.AppendConstAscii("\n");
            }
        case MirOp.Param:
            try sink.AppendConstAscii("");
        case MirOp.Add:
            try EmitLlvmBinary(instrs, sink, index, "add", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Sub:
            try EmitLlvmBinary(instrs, sink, index, "sub", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Mul:
            try EmitLlvmBinary(instrs, sink, index, "mul", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingAdd:
            try EmitLlvmBinary(instrs, sink, index, "add", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingSub:
            try EmitLlvmBinary(instrs, sink, index, "sub", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.WrappingMul:
            try EmitLlvmBinary(instrs, sink, index, "mul", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingAdd:
            try EmitLlvmSaturatingBinary(instrs, sink, index, "add", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingSub:
            try EmitLlvmSaturatingBinary(instrs, sink, index, "sub", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SaturatingMul:
            try EmitLlvmSaturatingBinary(instrs, sink, index, "mul", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SDiv:
            try EmitLlvmBinary(instrs, sink, index, "sdiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.UDiv:
            try EmitLlvmBinary(instrs, sink, index, "udiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SRem:
            try EmitLlvmBinary(instrs, sink, index, "srem", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.And:
            try EmitLlvmBinary(instrs, sink, index, "and", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Or:
            try EmitLlvmBinary(instrs, sink, index, "or", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Xor:
            try EmitLlvmBinary(instrs, sink, index, "xor", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Shl:
            try EmitLlvmBinary(instrs, sink, index, "shl", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.AShr:
            try EmitLlvmBinary(instrs, sink, index, "ashr", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpEq:
            try EmitLlvmTypedComparison(instrs, sink, index, "eq", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpNe:
            try EmitLlvmTypedComparison(instrs, sink, index, "ne", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLt:
            try EmitLlvmTypedComparison(instrs, sink, index, "slt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLe:
            try EmitLlvmTypedComparison(instrs, sink, index, "sle", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGt:
            try EmitLlvmTypedComparison(instrs, sink, index, "sgt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGe:
            try EmitLlvmTypedComparison(instrs, sink, index, "sge", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.ZExt:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = zext i1 ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii(" to i64\n");
        case MirOp.LoadGlobal:
            stack ValueFacts loadFacts = FactAt(globalFacts, (u32[0 max])instr.Immediate());
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = load ");
            try EmitLlvmVolatileMarker(loadFacts, sink);
            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(", ptr @g");
            try sink.AppendI64(instr.Immediate());
            try EmitLlvmMemoryAlignment(loadFacts, sink);
            try EmitLlvmRangeMetadataAttachment(instr.ResultType(), loadFacts, rangeMetadata, sink);
            try sink.AppendConstAscii("\n");
        case MirOp.StoreGlobal:
            stack ValueFacts storeFacts = FactAt(globalFacts, (u32[0 max])instr.Immediate());
            try sink.AppendConstAscii("  store ");
            try EmitLlvmVolatileMarker(storeFacts, sink);
            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", ptr @g");
            try sink.AppendI64(instr.Immediate());
            try EmitLlvmMemoryAlignment(storeFacts, sink);
            try sink.AppendConstAscii("\n");
        case MirOp.ArenaFrameEnter:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaAlloc:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaDynamicStorageInit:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaDynamicStorageReserve:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaDynamicStorageTryReserve:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaDynamicStorageTryReserveCapacity:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.ArenaFrameLeave:
            try EmitLlvmArenaInstruction(sink, index, instr);
        case MirOp.Phi:
            try EmitLlvmPhi(instrs, sink, index, instr.OperandAIndex(), instr.OperandBIndex(), instr.Immediate());
        case MirOp.Call:
            stack FunctionCallContractFacts calleeFacts = FunctionCallContractFactsAt(functionCallContractFacts, (u32[0 max])instr.Immediate());
            try EmitLlvmCallSeparateStorageAssumes(instrs, instr, calleeFacts, sink);
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = call ");
            try EmitLlvmCallCallingConvention(funcTailFlags, functionCallingConventionFacts, (u32[0 max])instr.Immediate(), sink);

            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(" @f");
            try sink.AppendI64(instr.Immediate());
            try EmitLlvmCallArgsWithRangeAndAbiFacts(
                instrs,
                paramFacts,
                valueFacts,
                globalFacts,
                functionReturnFacts,
                calleeFacts,
                sink,
                instr.OperandAIndex(),
                instr.OperandBIndex(),
                instr.OperandCIndex(),
                instr.OperandDIndex());
            try EmitLlvmCallSiteEffectAttributes(functionEffectFacts, (u32[0 max])instr.Immediate(), sink);
            try EmitLlvmRangeMetadataAttachment(instr.ResultType(), FactAt(functionReturnFacts, (u32[0 max])instr.Immediate()), rangeMetadata, sink);
            try sink.AppendConstAscii("\n");
        case MirOp.TailCall:
            try sink.AppendConstAscii("");
        case MirOp.Return:
            try sink.AppendConstAscii("  ret ");
            try EmitLlvmTypeName(MirValueType(instrs, instr.OperandAIndex()), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmInstruction(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] index)
{
    stack mut IrTable<u32[0 max]> noTailCallees = new();
    return EmitLlvmInstructionWithTailCallees(instrs, noTailCallees, sink, index);
}

// Emits an LLVM `define i64 @<name>() { entry: ... }` for the instruction range
// [firstInstr, firstInstr+instrCount), in table order, into `sink`.
public fn MemoryStatus EmitLlvmFunction(borrow IrTable<MirInstruction> instrs, const ascii name, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try EmitLlvmArenaRuntimePreambleForRange(instrs, firstInstr, instrCount, sink);

    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(name);
    try sink.AppendConstAscii("() {\nentry:\n");
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitLlvmInstruction(instrs, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Appends the LLVM block-label reference (`%bN`) for the block at 1-based `index`.
internal fn MemoryStatus EmitLlvmBlockRef(mut borrow OwnedAscii sink, u32[0 max] index)
{
    try sink.AppendConstAscii("%b");
    try sink.AppendU64((u64[0 max])index);
    return MemoryStatus.Ok;
}

// Appends the LLVM terminator line for block `b`: a typed `ret <v>` for a Return,
// `br label %bN` for an unconditional Branch, `br i1 <c>, label %bT, label %bE`
// for a CondBranch, or `unreachable` for an unterminated/out-of-range block. The
// returned value and the condition are value operands, so they go through
// `EmitLlvmOperand` (a `%pK` parameter or a `%vN` instruction result) — `instrs` is
// threaded in for that lookup.
public fn MemoryStatus EmitLlvmTerminatorWithTailCallees(borrow IrTable<MirInstruction> instrs, borrow IrTable<u32[0 max]> funcTailFlags, borrow IrTable<MirBlock> blocks, MirBlockId b, mut borrow OwnedAscii sink)
{
    if (!blocks.Contains(b.Index()))
    {
        try sink.AppendConstAscii("  unreachable\n");
        return MemoryStatus.Ok;
    }

    stack MirBlock blk = blocks.Get(b.Index());
    switch (blk.Terminator())
    {
        case MirTermKind.Return:
            try sink.AppendConstAscii("  ret ");
            try EmitLlvmTypeName(MirValueType(instrs, blk.Slot0Index()), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, blk.Slot0Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.ReturnVoid:
            try sink.AppendConstAscii("  ret void\n");
        case MirTermKind.Branch:
            try sink.AppendConstAscii("  br label ");
            try EmitLlvmBlockRef(sink, blk.Slot0Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.CondBranch:
            try sink.AppendConstAscii("  br i1 ");
            try EmitLlvmOperand(instrs, sink, blk.Slot0Index());
            try sink.AppendConstAscii(", label ");
            try EmitLlvmBlockRef(sink, blk.Slot1Index());
            try sink.AppendConstAscii(", label ");
            try EmitLlvmBlockRef(sink, blk.Slot2Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.TailCall:
            if (!instrs.Contains(blk.Slot0Index()))
            {
                try sink.AppendConstAscii("  unreachable\n");
                return MemoryStatus.Ok;
            }

            stack MirInstruction tailCall = instrs.Get(blk.Slot0Index());
            if (tailCall.Opcode() != MirOp.TailCall)
            {
                try sink.AppendConstAscii("  unreachable\n");
                return MemoryStatus.Ok;
            }

            if (!FunctionIdIsTailCallable(funcTailFlags, (u32[0 max])tailCall.Immediate()))
            {
                try sink.AppendConstAscii("  unreachable\n");
                return MemoryStatus.Ok;
            }

            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, blk.Slot0Index());
            try sink.AppendConstAscii(" = musttail call tailcc ");
            try EmitLlvmTypeName(tailCall.ResultType(), sink);
            try sink.AppendConstAscii(" @f");
            try sink.AppendI64(tailCall.Immediate());
            try EmitLlvmCallArgs(instrs, sink, tailCall.OperandAIndex(), tailCall.OperandBIndex(), tailCall.OperandCIndex(), tailCall.OperandDIndex());
            try sink.AppendConstAscii("\n  ret ");
            try EmitLlvmTypeName(tailCall.ResultType(), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, blk.Slot0Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.Unterminated:
            try sink.AppendConstAscii("  unreachable\n");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmTerminatorWithRangeFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<MirBlock> blocks,
    MirBlockId b,
    u32[0 max] loopMetadataBase,
    mut borrow OwnedAscii sink)
{
    if (!blocks.Contains(b.Index()))
    {
        try sink.AppendConstAscii("  unreachable\n");
        return MemoryStatus.Ok;
    }

    stack MirBlock blk = blocks.Get(b.Index());
    switch (blk.Terminator())
    {
        case MirTermKind.Return:
            try sink.AppendConstAscii("  ret ");
            try EmitLlvmTypeName(MirValueType(instrs, blk.Slot0Index()), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, blk.Slot0Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.ReturnVoid:
            try sink.AppendConstAscii("  ret void\n");
        case MirTermKind.Branch:
            try sink.AppendConstAscii("  br label ");
            try EmitLlvmBlockRef(sink, blk.Slot0Index());
            try EmitLlvmIndependentLoopMetadataAttachment(blocks, b, loopMetadataBase, sink);
            try sink.AppendConstAscii("\n");
        case MirTermKind.CondBranch:
            try sink.AppendConstAscii("  br i1 ");
            try EmitLlvmOperand(instrs, sink, blk.Slot0Index());
            try sink.AppendConstAscii(", label ");
            try EmitLlvmBlockRef(sink, blk.Slot1Index());
            try sink.AppendConstAscii(", label ");
            try EmitLlvmBlockRef(sink, blk.Slot2Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.TailCall:
            if (!instrs.Contains(blk.Slot0Index()))
            {
                try sink.AppendConstAscii("  unreachable\n");
                return MemoryStatus.Ok;
            }

            stack MirInstruction tailCall = instrs.Get(blk.Slot0Index());
            if (tailCall.Opcode() != MirOp.TailCall)
            {
                try sink.AppendConstAscii("  unreachable\n");
                return MemoryStatus.Ok;
            }

            if (!FunctionIdIsTailCallable(funcTailFlags, (u32[0 max])tailCall.Immediate()))
            {
                try sink.AppendConstAscii("  unreachable\n");
                return MemoryStatus.Ok;
            }

            stack FunctionCallContractFacts calleeFacts = FunctionCallContractFactsAt(functionCallContractFacts, (u32[0 max])tailCall.Immediate());
            try EmitLlvmCallSeparateStorageAssumes(instrs, tailCall, calleeFacts, sink);
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, blk.Slot0Index());
            try sink.AppendConstAscii(" = musttail call tailcc ");
            try EmitLlvmTypeName(tailCall.ResultType(), sink);
            try sink.AppendConstAscii(" @f");
            try sink.AppendI64(tailCall.Immediate());
            try EmitLlvmCallArgsWithRangeAndAbiFacts(
                instrs,
                paramFacts,
                valueFacts,
                globalFacts,
                functionReturnFacts,
                calleeFacts,
                sink,
                tailCall.OperandAIndex(),
                tailCall.OperandBIndex(),
                tailCall.OperandCIndex(),
                tailCall.OperandDIndex());
            try EmitLlvmCallSiteEffectAttributes(functionEffectFacts, (u32[0 max])tailCall.Immediate(), sink);
            try EmitLlvmRangeMetadataAttachment(tailCall.ResultType(), FactAt(functionReturnFacts, (u32[0 max])tailCall.Immediate()), rangeMetadata, sink);
            try sink.AppendConstAscii("\n  ret ");
            try EmitLlvmTypeName(tailCall.ResultType(), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, blk.Slot0Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.Unterminated:
            try sink.AppendConstAscii("  unreachable\n");
    }

    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmTerminator(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, MirBlockId b, mut borrow OwnedAscii sink)
{
    stack mut IrTable<u32[0 max]> noTailCallees = new();
    return EmitLlvmTerminatorWithTailCallees(instrs, noTailCallees, blocks, b, sink);
}

internal fn MemoryStatus EmitLlvmSeparateStorageAssume(borrow DistinctStoragePair pair, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p");
    try sink.AppendU64((u64[0 max])pair.LeftParam);
    try sink.AppendConstAscii(", ptr %p");
    try sink.AppendU64((u64[0 max])pair.RightParam);
    try sink.AppendConstAscii(")]\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmSeparateStorageAssumes(borrow IrTable<DistinctStoragePair> facts, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] total = facts.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        stack DistinctStoragePair pair = facts.Get(i);
        try EmitLlvmSeparateStorageAssume(pair, sink);
        i = i + 1;
    }

    return MemoryStatus.Ok;
}

// === Whole-function LLVM emission ===
// Stitches the instruction and control-flow layers into a complete LLVM function.
// A block owns a CONTIGUOUS instruction range [firstInstr, firstInstr+instrCount)
// (the caller tracks the per-block split, since the flat model stores instructions
// in one table); each block emits as `bN:` + its body instructions + its terminator.

// Emits one labelled LLVM block: `bN:` then the instructions
// [firstInstr, firstInstr+instrCount) then block N's terminator.
public fn MemoryStatus EmitLlvmLabeledBlockWithTailCallees(borrow IrTable<MirInstruction> instrs, borrow IrTable<u32[0 max]> funcTailFlags, borrow IrTable<MirBlock> blocks, u32[0 max] blockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("b");
    try sink.AppendU64((u64[0 max])blockIndex);
    try sink.AppendConstAscii(":\n");
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitLlvmInstructionWithTailCallees(instrs, funcTailFlags, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    try EmitLlvmTerminatorWithTailCallees(instrs, funcTailFlags, blocks, MirBlockIdOf(blockIndex), sink);
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmLabeledBlockWithRangeFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<MirBlock> blocks,
    u32[0 max] blockIndex,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    mut borrow OwnedAscii sink)
{
    stack mut IrTable<DistinctStoragePair> noSeparateStorageFacts = new();
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    return EmitLlvmLabeledBlockWithRangeFactsAndSeparateStorage(
        instrs,
        funcTailFlags,
        noFunctionEffectFacts,
        noFunctionCallContractFacts,
        noFunctionCallingConventionFacts,
        paramFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        noSeparateStorageFacts,
        false,
        blocks,
        blockIndex,
        firstInstr,
        instrCount,
        LlvmLoopMetadataBase(),
        sink);
}

internal fn MemoryStatus EmitLlvmLabeledBlockWithRangeFactsAndSeparateStorage(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<DistinctStoragePair> separateStorageFacts,
    bool emitSeparateStorageFacts,
    borrow IrTable<MirBlock> blocks,
    u32[0 max] blockIndex,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    u32[0 max] loopMetadataBase,
    mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("b");
    try sink.AppendU64((u64[0 max])blockIndex);
    try sink.AppendConstAscii(":\n");
    if (emitSeparateStorageFacts)
    {
        try EmitLlvmSeparateStorageAssumes(separateStorageFacts, sink);
    }

    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitLlvmInstructionWithRangeFacts(
            instrs,
            funcTailFlags,
            functionEffectFacts,
            functionCallContractFacts,
            functionCallingConventionFacts,
            paramFacts,
            valueFacts,
            globalFacts,
            functionReturnFacts,
            rangeMetadata,
            sink,
            index);
        index = index + 1;
        remaining = remaining - 1;
    }

    try EmitLlvmTerminatorWithRangeFacts(
        instrs,
        funcTailFlags,
        functionEffectFacts,
        functionCallContractFacts,
        paramFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        blocks,
        MirBlockIdOf(blockIndex),
        loopMetadataBase,
        sink);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmLabeledBlock(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, u32[0 max] blockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    stack mut IrTable<u32[0 max]> noTailCallees = new();
    return EmitLlvmLabeledBlockWithTailCallees(instrs, noTailCallees, blocks, blockIndex, firstInstr, instrCount, sink);
}

// Emits a complete single-block LLVM function whose scalar return type is inferred
// from the entry block terminator.
public fn MemoryStatus EmitLlvmDefinition(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] entryBlockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try EmitLlvmArenaRuntimePreambleForRange(instrs, firstInstr, instrCount, sink);

    try sink.AppendConstAscii("define ");
    try EmitLlvmTypeName(MirBlockScalarReturnType(instrs, blocks, entryBlockIndex), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try sink.AppendConstAscii("() {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Appends an LLVM parameter list `(i64 %p0, i64 %p1, …)` for `paramCount` params
// (just `()` when zero).
internal fn MemoryStatus EmitLlvmParamList(u32[0 max] paramCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("(");
    stack mut u32[0 max] i = 0;
    while willexit (i < paramCount)
    {
        if (i > 0)
        {
            try sink.AppendConstAscii(", ");
        }

        try sink.AppendConstAscii("i64 %p");
        try sink.AppendU64((u64[0 max])i);
        i = i + 1;
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

// Appends a typed LLVM parameter list using MIR Param result types.
internal fn MemoryStatus EmitLlvmTypedParamList(borrow IrTable<MirInstruction> instrs, u32[0 max] paramCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("(");
    stack mut u32[0 max] i = 0;
    while willexit (i < paramCount)
    {
        if (i > 0)
        {
            try sink.AppendConstAscii(", ");
        }

        try EmitLlvmTypeName(MirParamTypeOf(instrs, i), sink);
        try sink.AppendConstAscii(" %p");
        try sink.AppendU64((u64[0 max])i);
        i = i + 1;
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

// Appends a typed LLVM parameter list and keeps integer range facts width-correct.
internal fn MemoryStatus EmitLlvmTypedParamListWithRangeFacts(
    borrow IrTable<MirInstruction> instrs,
    u32[0 max] paramCount,
    borrow IrTable<ValueFacts> paramFacts,
    mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("(");
    stack mut u32[0 max] i = 0;
    while willexit (i < paramCount)
    {
        if (i > 0)
        {
            try sink.AppendConstAscii(", ");
        }

        stack MirType paramType = MirParamTypeOf(instrs, i);
        try EmitLlvmTypeName(paramType, sink);
        try EmitLlvmRangeAttribute(paramType, FactAt(paramFacts, i + 1), sink);
        try sink.AppendConstAscii(" %p");
        try sink.AppendU64((u64[0 max])i);
        i = i + 1;
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmParamListWithRangeFacts(u32[0 max] paramCount, borrow IrTable<ValueFacts> paramFacts, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("(");
    stack mut u32[0 max] i = 0;
    while willexit (i < paramCount)
    {
        if (i > 0)
        {
            try sink.AppendConstAscii(", ");
        }

        try sink.AppendConstAscii("i64");
        try EmitLlvmRangeAttribute(MirType.I64, FactAt(paramFacts, i + 1), sink);
        try sink.AppendConstAscii(" %p");
        try sink.AppendU64((u64[0 max])i);
        i = i + 1;
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmParamListWithRangeAndAbiFacts(
    borrow IrTable<MirInstruction> instrs,
    u32[0 max] paramCount,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("(");
    stack mut u32[0 max] i = 0;
    while willexit (i < paramCount)
    {
        if (i > 0)
        {
            try sink.AppendConstAscii(", ");
        }

        stack ParamAbiFacts abi = AbiFactAt(paramAbiFacts, i + 1);
        if (abi.IsPointer)
        {
            try sink.AppendConstAscii("ptr");
            try EmitLlvmParamAbiAttributes(abi, sink);
        }
        else
        {
            stack MirType paramType = MirParamTypeOf(instrs, i);
            try EmitLlvmTypeName(paramType, sink);
            try EmitLlvmRangeAttribute(paramType, FactAt(paramFacts, i + 1), sink);
        }

        try sink.AppendConstAscii(" %p");
        try sink.AppendU64((u64[0 max])i);
        i = i + 1;
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

// Emits a single-block LLVM function with a typed parameter list. Body uses of
// `MirParam` values lower to `%pK`, including a parameter returned directly by the
// block terminator. CONTRACT: the `MirParam` indices used in the body must be a
// dense `0..paramCount-1` prefix matching the declared signature.
public fn MemoryStatus EmitLlvmDefinitionWithParams(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] paramCount, u32[0 max] entryBlockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try EmitLlvmArenaRuntimePreambleForRange(instrs, firstInstr, instrCount, sink);

    try sink.AppendConstAscii("define ");
    try EmitLlvmTypeName(MirBlockScalarReturnType(instrs, blocks, entryBlockIndex), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try EmitLlvmTypedParamList(instrs, paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmVoidDefinitionWithParams(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] paramCount, u32[0 max] entryBlockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try EmitLlvmArenaRuntimePreambleForRange(instrs, firstInstr, instrCount, sink);

    try sink.AppendConstAscii("define void @");
    try sink.AppendConstAscii(name);
    try EmitLlvmTypedParamList(instrs, paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmDefinitionWithParamsTail(borrow IrTable<MirInstruction> instrs, borrow IrTable<u32[0 max]> funcTailFlags, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] paramCount, u32[0 max] entryBlockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try EmitLlvmArenaRuntimePreambleForRange(instrs, firstInstr, instrCount, sink);

    try sink.AppendConstAscii("define tailcc ");
    try EmitLlvmTypeName(MirBlockScalarReturnType(instrs, blocks, entryBlockIndex), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try EmitLlvmTypedParamList(instrs, paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    try EmitLlvmLabeledBlockWithTailCallees(instrs, funcTailFlags, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmDefinitionWithRangeFactsCore(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<MirBlock> blocks,
    const ascii name,
    bool isTailCallable,
    ValueFacts returnFacts,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    borrow IrTable<DistinctStoragePair> separateStorageFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    FunctionEffectFacts functionEffects,
    u32[0 max] paramCount,
    u32[0 max] entryBlockIndex,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    mut borrow OwnedAscii sink)
    where overlap(funcTailFlags, paramAbiFacts), overlap(paramAbiFacts, functionReturnFacts)
{
    try EmitLlvmArenaRuntimePreambleForRange(instrs, firstInstr, instrCount, sink);

    try sink.AppendConstAscii("define");
    try EmitLlvmDefinitionLinkage(FunctionLinkageFactsAt(functionLinkageFacts, 1), sink);
    try EmitLlvmDefinitionCallingConvention(isTailCallable, FunctionCallingConventionFactsAt(functionCallingConventionFacts, 1), sink);

    stack MirType returnType = MirBlockScalarReturnType(instrs, blocks, entryBlockIndex);
    try EmitLlvmRangeAttribute(returnType, returnFacts, sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmTypeName(returnType, sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try EmitLlvmParamListWithRangeAndAbiFacts(instrs, paramCount, paramFacts, paramAbiFacts, sink);
    try EmitLlvmFunctionEffectAttributes(functionEffects, sink);
    try sink.AppendConstAscii(" {\n");
    try EmitLlvmLabeledBlockWithRangeFactsAndSeparateStorage(
        instrs,
        funcTailFlags,
        functionEffectFacts,
        functionCallContractFacts,
        functionCallingConventionFacts,
        paramFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        separateStorageFacts,
        true,
        blocks,
        entryBlockIndex,
        firstInstr,
        instrCount,
        LlvmLoopMetadataBase(),
        sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmDefinitionWithRangeFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    const ascii name,
    ValueFacts returnFacts,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    u32[0 max] paramCount,
    u32[0 max] entryBlockIndex,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    mut borrow OwnedAscii sink)
{
    stack mut IrTable<u32[0 max]> noTailCallees = new();
    stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut IrTable<ParamAbiFacts> noParamAbiFacts = new();
    stack mut IrTable<DistinctStoragePair> noSeparateStorageFacts = new();
    try EmitLlvmDefinitionWithRangeFactsCore(
        instrs,
        noTailCallees,
        noFunctionEffectFacts,
        noFunctionCallContractFacts,
        noFunctionLinkageFacts,
        noFunctionCallingConventionFacts,
        blocks,
        name,
        false,
        returnFacts,
        paramFacts,
        noParamAbiFacts,
        noSeparateStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        NoFunctionEffectFacts(),
        paramCount,
        entryBlockIndex,
        firstInstr,
        instrCount,
        sink);
    try EmitLlvmRangeMetadataDefinitions(rangeMetadata, sink);
    return MemoryStatus.Ok;
}

// Emits a multi-block diamond-CFG function: an entry
// block (ending in a conditional branch to the then/else blocks), then/else blocks
// (each over its own instruction range — the branch-arm computation — ending in an
// unconditional branch to the merge block), and a merge block (its instruction range,
// typically a phi, ending in a return). Each block emits over the (first, count)
// instruction range it is given. Real branching control flow with a phi merge, built
// by composing `EmitLlvmLabeledBlock`; the block terminators come from `blocks`.
// One block's emission descriptor: which block, and the contiguous instruction range
// (1-based first index + count) it owns. A sequence of these is a whole function body
// for an arbitrary CFG shape (diamond, loop, nested-if, switch, …).
public struct BlockEmit
{
    u32[0 max] BlockIndex;
    u32[0 max] First;
    u32[0 max] Count;

    BlockEmit()
    {
        self.BlockIndex = 0;
        self.First = 0;
        self.Count = 0;
    }
}

// Builds a `BlockEmit` descriptor.
internal fn BlockEmit MakeBlockEmit(u32[0 max] blockIndex, u32[0 max] first, u32[0 max] count)
{
    stack mut BlockEmit be = new();
    be.BlockIndex = blockIndex;
    be.First = first;
    be.Count = count;
    return be;
}

internal fn bool MirBlockHasScalarReturnType(borrow IrTable<MirBlock> blocks, u32[0 max] blockIndex)
{
    if (!blocks.Contains(blockIndex))
    {
        return false;
    }

    stack MirBlock block = blocks.Get(blockIndex);
    return block.Terminator() == MirTermKind.Return
        || block.Terminator() == MirTermKind.TailCall;
}

internal fn MirType MirBlockScalarReturnType(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    u32[0 max] blockIndex)
{
    if (!blocks.Contains(blockIndex))
    {
        return MirType.I64;
    }

    stack MirBlock block = blocks.Get(blockIndex);
    switch (block.Terminator())
    {
        case MirTermKind.Return:
            return MirValueType(instrs, block.Slot0Index());
        case MirTermKind.TailCall:
            if (!instrs.Contains(block.Slot0Index()))
            {
                return MirType.I64;
            }

            stack MirInstruction tailCall = instrs.Get(block.Slot0Index());
            return tailCall.ResultType();
        default:
            return MirType.I64;
    }
}

internal fn MirType MirBlockRangesScalarReturnType(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<BlockEmit> ranges)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        stack u32[0 max] blockIndex = ranges.Get(i).BlockIndex;
        if (MirBlockHasScalarReturnType(blocks, blockIndex))
        {
            return MirBlockScalarReturnType(instrs, blocks, blockIndex);
        }

        i = i + 1;
    }

    return MirType.I64;
}

internal fn bool MirInstructionRangesUseArenaRuntime(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeUsesArenaRuntime(instrs, ranges.Get(i).First, ranges.Get(i).Count))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool MirInstructionRangesUseArenaDynamicRuntime(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeUsesArenaDynamicRuntime(instrs, ranges.Get(i).First, ranges.Get(i).Count))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn MemoryStatus EmitLlvmArenaRuntimePreambleForRanges(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges, mut borrow OwnedAscii sink)
{
    if (MirInstructionRangesUseArenaDynamicRuntime(instrs, ranges))
    {
        try EmitLlvmArenaDynamicRuntimeDeclarations(sink);
    }
    else if (MirInstructionRangesUseArenaRuntime(instrs, ranges))
    {
        try EmitLlvmArenaRuntimeDeclarations(sink);
    }

    return MemoryStatus.Ok;
}

internal fn bool MirInstructionRangeHasCall(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.Call || instr.Opcode() == MirOp.TailCall)
            {
                return true;
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangeReadsMemory(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.LoadGlobal || instr.Opcode() == MirOp.Call || instr.Opcode() == MirOp.TailCall || MirInstructionIsArenaRuntime(instr))
            {
                return true;
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangeWritesMemory(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.StoreGlobal || MirInstructionIsArenaRuntime(instr))
            {
                return true;
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangesHaveCall(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeHasCall(instrs, ranges.Get(i).First, ranges.Get(i).Count))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool MirInstructionRangesReadMemory(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeReadsMemory(instrs, ranges.Get(i).First, ranges.Get(i).Count))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool MirInstructionRangesWriteMemory(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeWritesMemory(instrs, ranges.Get(i).First, ranges.Get(i).Count))
        {
            return true;
        }

        i = i + 1;
