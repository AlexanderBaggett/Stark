// The callee of the call instruction naming `value` (invalid when not a call /
// out of range). Guards on the opcode so the shared `Imm` field is not misread for
// a ConstInt/Param value that also stores data there.
public fn MirFuncId MirCalleeOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirFuncIdOf(0);
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    if (instr.Opcode() != MirOp.Call && instr.Opcode() != MirOp.TailCall)
    {
        return MirFuncIdOf(0);
    }

    return MirFuncIdOf((u32[0 max])instr.Immediate());
}

// True when `value` names a live instruction in `instrs`.
public inline finite law bool MirDefines(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    return instrs.Contains(value.Index());
}

// The opcode of the instruction naming `value` (`Return` when out of range).
public fn MirOp MirOpcodeOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirOp.Return;
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    return instr.Opcode();
}

// The first operand of the instruction naming `value` (invalid when out of range).
public fn MirValueId MirOperandAOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirValueIdOf(0);
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    return MirValueIdOf(instr.OperandAIndex());
}

public fn MirValueId MirOperandBOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirValueIdOf(0);
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    return MirValueIdOf(instr.OperandBIndex());
}

// The immediate of the instruction naming `value` (0 when out of range).
public fn i64[min max] MirImmediateOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return 0;
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    return instr.Immediate();
}

// === Basic blocks + terminators ===
// A MIR control-flow block is named by a `MirBlockId` (its 1-based index in an
// `IrTable<MirBlock>` the caller owns). This first slice records each block's
// terminator; associating instructions to a block is a later slice. Like the
// instruction layer, blocks are flat records built/read through free functions.

// How a block transfers control at its end.
public enum MirTermKind
{
    // No terminator yet (a freshly created or out-of-range block).
    Unterminated,
    // `return Slot0` — returns the value named by slot 0.
    Return,
    // `return void` — returns without a value.
    ReturnVoid,
    // `branch Slot0` — unconditionally jumps to the block named by slot 0.
    Branch,
    // `if Slot0 then Slot1 else Slot2` — conditional branch on a value to two blocks.
    CondBranch,
    // `tailcall Slot0` — transfers to the call-shaped TailCall instruction named by slot 0.
    TailCall,
}

// A MIR basic block: its terminator kind and up to three operand slots whose meaning
// depends on the kind (a value id or a block id, 0 when unused).
public struct MirBlock
{
    MirTermKind Term;
    u32[0 max] Slot0;
    u32[0 max] Slot1;
    u32[0 max] Slot2;
    u32[0 max] Flags;

    MirBlock()
    {
        self.Term = MirTermKind.Unterminated;
        self.Slot0 = 0;
        self.Slot1 = 0;
        self.Slot2 = 0;
        self.Flags = 0;
    }

    public inline finite law MirTermKind Terminator(borrow MirBlock self)
    {
        return self.Term;
    }

    public inline finite law u32[0 max] Slot0Index(borrow MirBlock self)
    {
        return self.Slot0;
    }

    public inline finite law u32[0 max] Slot1Index(borrow MirBlock self)
    {
        return self.Slot1;
    }

    public inline finite law u32[0 max] Slot2Index(borrow MirBlock self)
    {
        return self.Slot2;
    }

    public inline finite law u32[0 max] FlagBits(borrow MirBlock self)
    {
        return self.Flags;
    }
}

internal inline finite law u32[0 max] MirBlockFlagIndependentLoopBackedge()
{
    return 1;
}

internal finite law bool MirBlockFlagsAreValid(MirTermKind term, u32[0 max] flags)
{
    if (flags == 0)
    {
        return true;
    }

    return term == MirTermKind.Branch && flags == MirBlockFlagIndependentLoopBackedge();
}

// Appends a block terminating in `return value`, returning its id.
public fn MirBlockId MirReturnBlock(mut borrow IrTable<MirBlock> blocks, MirValueId value)
{
    stack mut MirBlock blk = new();
    blk.Term = MirTermKind.Return;
    blk.Slot0 = value.Index();
    return MirBlockIdOf(blocks.Add(blk));
}

// Appends a block terminating in `return void`, returning its id.
public fn MirBlockId MirReturnVoidBlock(mut borrow IrTable<MirBlock> blocks)
{
    stack mut MirBlock blk = new();
    blk.Term = MirTermKind.ReturnVoid;
    return MirBlockIdOf(blocks.Add(blk));
}

// Appends a block unconditionally branching to `target`, returning its id.
public fn MirBlockId MirBranchBlock(mut borrow IrTable<MirBlock> blocks, MirBlockId target)
{
    stack mut MirBlock blk = new();
    blk.Term = MirTermKind.Branch;
    blk.Slot0 = target.Index();
    return MirBlockIdOf(blocks.Add(blk));
}

// Appends an unconditional loop backedge that preserves a source-level `independent`
// promise for LLVM loop metadata emission.
public fn MirBlockId MirIndependentLoopBackedgeBlock(mut borrow IrTable<MirBlock> blocks, MirBlockId target)
{
    stack mut MirBlock blk = new();
    blk.Term = MirTermKind.Branch;
    blk.Slot0 = target.Index();
    blk.Flags = MirBlockFlagIndependentLoopBackedge();
    return MirBlockIdOf(blocks.Add(blk));
}

// Appends a block conditionally branching on `cond` to `thenTarget`/`elseTarget`.
public fn MirBlockId MirCondBlock(mut borrow IrTable<MirBlock> blocks, MirValueId cond, MirBlockId thenTarget, MirBlockId elseTarget)
{
    stack mut MirBlock blk = new();
    blk.Term = MirTermKind.CondBranch;
    blk.Slot0 = cond.Index();
    blk.Slot1 = thenTarget.Index();
    blk.Slot2 = elseTarget.Index();
    return MirBlockIdOf(blocks.Add(blk));
}

// Appends a block terminating in a guaranteed tail call. `tailCall` must name a
// MirOp.TailCall instruction carrying the callee and arguments.
public fn MirBlockId MirTailCallBlock(mut borrow IrTable<MirBlock> blocks, MirValueId tailCall)
{
    stack mut MirBlock blk = new();
    blk.Term = MirTermKind.TailCall;
    blk.Slot0 = tailCall.Index();
    return MirBlockIdOf(blocks.Add(blk));
}

// The terminator kind of block `b` (`Unterminated` when out of range).
public fn MirTermKind MirBlockTerminator(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirTermKind.Unterminated;
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return blk.Terminator();
}

// The value returned by a `Return` block (invalid when not a return / out of range).
public fn MirValueId MirBlockReturnValue(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirValueIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirValueIdOf(blk.Slot0Index());
}

// The target of a `Branch` block (invalid when out of range).
public fn MirBlockId MirBlockBranchTarget(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirBlockIdOf(blk.Slot0Index());
}

public fn bool MirBlockHasIndependentLoopBackedge(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return false;
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return blk.Terminator() == MirTermKind.Branch
        && (blk.FlagBits() & MirBlockFlagIndependentLoopBackedge()) != 0;
}

// The condition value of a `CondBranch` block (invalid when out of range).
public fn MirValueId MirBlockCondValue(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirValueIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirValueIdOf(blk.Slot0Index());
}

// The then-/else-target blocks of a `CondBranch` block (invalid when out of range).
public fn MirBlockId MirBlockCondThen(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirBlockIdOf(blk.Slot1Index());
}

public fn MirBlockId MirBlockCondElse(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirBlockIdOf(blk.Slot2Index());
}

// The TailCall instruction payload of a `TailCall` block.
public fn MirValueId MirBlockTailCallValue(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirValueIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirValueIdOf(blk.Slot0Index());
}

// === Function model ===
// A MIR function is the unit a backend pass lowers. It owns a CONTIGUOUS range of
// blocks in an `IrTable<MirBlock>` and a contiguous range of instructions in an
// `IrTable<MirInstruction>` (both built in order during lowering), and names its
// entry block. Like the rest of the MIR it is a flat record (only raw indices, no
// nested generic field) built/read through free functions over `IrTable<MirFunction>`.

// A MIR function: its entry block plus the half-open block range it owns and the
// half-open instruction range it owns, each as (first 1-based index, count).
public struct MirFunction
{
    u32[0 max] Entry;
    u32[0 max] FirstBlock;
    u32[0 max] BlockCount;
    u32[0 max] FirstInstr;
    u32[0 max] InstrCount;

    MirFunction()
    {
        self.Entry = 0;
        self.FirstBlock = 0;
        self.BlockCount = 0;
        self.FirstInstr = 0;
        self.InstrCount = 0;
    }

    public inline finite law u32[0 max] EntryIndex(borrow MirFunction self)
    {
        return self.Entry;
    }

    public inline finite law u32[0 max] FirstBlockIndex(borrow MirFunction self)
    {
        return self.FirstBlock;
    }

    public inline finite law u32[0 max] OwnedBlockCount(borrow MirFunction self)
    {
        return self.BlockCount;
    }

    public inline finite law u32[0 max] FirstInstrIndex(borrow MirFunction self)
    {
        return self.FirstInstr;
    }

    public inline finite law u32[0 max] OwnedInstrCount(borrow MirFunction self)
    {
        return self.InstrCount;
    }
}

// Records a function owning blocks [firstBlock, firstBlock+blockCount) and
// instructions [firstInstr, firstInstr+instrCount), entered at `entry`.
public fn MirFuncId MirDefineFunction(mut borrow IrTable<MirFunction> funcs, MirBlockId entry, MirBlockId firstBlock, u32[0 max] blockCount, MirValueId firstInstr, u32[0 max] instrCount)
{
    stack mut MirFunction f = new();
    f.Entry = entry.Index();
    f.FirstBlock = firstBlock.Index();
    f.BlockCount = blockCount;
    f.FirstInstr = firstInstr.Index();
    f.InstrCount = instrCount;
    return MirFuncIdOf(funcs.Add(f));
}

// The entry block of function `id` (invalid when out of range).
public fn MirBlockId MirFunctionEntry(borrow IrTable<MirFunction> funcs, MirFuncId id)
{
    if (!funcs.Contains(id.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirFunction f = funcs.Get(id.Index());
    return MirBlockIdOf(f.EntryIndex());
}

// The number of blocks function `id` owns (0 when out of range).
public fn u32[0 max] MirFunctionBlockCount(borrow IrTable<MirFunction> funcs, MirFuncId id)
{
    if (!funcs.Contains(id.Index()))
    {
        return 0;
    }

    stack MirFunction f = funcs.Get(id.Index());
    return f.OwnedBlockCount();
}

// The number of instructions function `id` owns (0 when out of range).
public fn u32[0 max] MirFunctionInstrCount(borrow IrTable<MirFunction> funcs, MirFuncId id)
{
    if (!funcs.Contains(id.Index()))
    {
        return 0;
    }

    stack MirFunction f = funcs.Get(id.Index());
    return f.OwnedInstrCount();
}

// True when block `b` falls inside function `id`'s owned block range. The invalid
// id 0 is never owned (even if a malformed function records a 0 range start).
public fn bool MirFunctionOwnsBlock(borrow IrTable<MirFunction> funcs, MirFuncId id, MirBlockId b)
{
    if (!funcs.Contains(id.Index()) || b.Index() == 0)
    {
        return false;
    }

    stack MirFunction f = funcs.Get(id.Index());
    stack u64[0 max] first = (u64[0 max])f.FirstBlockIndex();
    stack u64[0 max] count = (u64[0 max])f.OwnedBlockCount();
    stack u64[0 max] idx = (u64[0 max])b.Index();
    return idx >= first && idx < first + count;
}

// True when instruction `value` falls inside function `id`'s owned instruction range.
// The invalid id 0 is never owned (even if a malformed function records a 0 start).
public fn bool MirFunctionOwnsValue(borrow IrTable<MirFunction> funcs, MirFuncId id, MirValueId value)
{
    if (!funcs.Contains(id.Index()) || value.Index() == 0)
    {
        return false;
    }

    stack MirFunction f = funcs.Get(id.Index());
    stack u64[0 max] first = (u64[0 max])f.FirstInstrIndex();
    stack u64[0 max] count = (u64[0 max])f.OwnedInstrCount();
    stack u64[0 max] idx = (u64[0 max])value.Index();
    return idx >= first && idx < first + count;
}

// === Phase-boundary MIR verification (doc 24, toward #30) ===
// A structural well-formedness check over a function's owned MIR before a later phase (e.g.
// codegen) consumes it: the block/instruction ranges lie within the tables, the entry block
// is one the function owns, every owned instruction's operands name values that EXIST (no
// dangling/out-of-range reference), and every owned block is TERMINATED and names only
// in-range values (a Return / CondBranch condition) and blocks (Branch / CondBranch targets).
// This catches the structural-corruption class (a 0 or out-of-range slot) at a phase
// boundary, independent of the emitter — the kind of invariant a real compiler asserts
// between passes. (Operand 0 is the "unused" sentinel and is allowed; a phi's forward
// back-edge reference is in-range by construction, so the bound is the value table size.)
internal fn bool MirFunctionWellFormed(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow MirFunction func)
{
    stack u32[0 max] instrTotal = (u32[0 max])instrs.Count();
    stack u32[0 max] blockTotal = (u32[0 max])blocks.Count();

    // (1) The block range lies within the block table.
    if (func.OwnedBlockCount() == 0 || func.FirstBlockIndex() == 0 || func.FirstBlockIndex() + func.OwnedBlockCount() - 1 > blockTotal)
    {
        return false;
    }

    // (2) The entry block is one the function owns.
    if (func.EntryIndex() < func.FirstBlockIndex() || func.EntryIndex() > func.FirstBlockIndex() + func.OwnedBlockCount() - 1)
    {
        return false;
    }

    // (3) The instruction range lies within the value table (a function may own none).
    if (func.OwnedInstrCount() > 0 && (func.FirstInstrIndex() == 0 || func.FirstInstrIndex() + func.OwnedInstrCount() - 1 > instrTotal))
    {
        return false;
    }

    // (4) Every owned instruction names existing values (operand 0 = unused is fine).
    stack mut u32[0 max] vi = func.FirstInstrIndex();
    stack mut u32[0 max] viRemaining = func.OwnedInstrCount();
    while willexit (viRemaining > 0)
    {
        stack MirInstruction instr = instrs.Get(vi);
        if (instr.Opcode() == MirOp.ArenaAlloc)
        {
            if (instr.OperandBIndex() > instrTotal || instr.OperandCIndex() > instrTotal || instr.OperandDIndex() > instrTotal)
            {
                return false;
            }
        }
        else if (instr.Opcode() == MirOp.ArenaDynamicStorageInit)
        {
            if (instr.OperandCIndex() > instrTotal || instr.OperandDIndex() > instrTotal)
            {
                return false;
            }
        }
        else if (instr.Opcode() == MirOp.ArenaDynamicStorageReserve
            || instr.Opcode() == MirOp.ArenaDynamicStorageTryReserve
            || instr.Opcode() == MirOp.ArenaDynamicStorageTryReserveCapacity)
        {
            if (instr.OperandAIndex() == 0 || instr.OperandAIndex() > instrTotal || instr.OperandDIndex() > instrTotal)
            {
                return false;
            }
        }
        else if (instr.OperandAIndex() > instrTotal || instr.OperandBIndex() > instrTotal || instr.OperandCIndex() > instrTotal || instr.OperandDIndex() > instrTotal)
        {
            return false;
        }

        vi = vi + 1;
        viRemaining = viRemaining - 1;
    }

    // (5) Every owned block is terminated and names in-range values/blocks.
    stack mut u32[0 max] bi = func.FirstBlockIndex();
    stack mut u32[0 max] biRemaining = func.OwnedBlockCount();
    while willexit (biRemaining > 0)
    {
        stack MirBlock blk = blocks.Get(bi);
        if (!MirBlockFlagsAreValid(blk.Terminator(), blk.FlagBits()))
        {
            return false;
        }

        switch (blk.Terminator())
        {
            case MirTermKind.Unterminated:
                return false;
            case MirTermKind.Return:
                if (blk.Slot0Index() == 0 || blk.Slot0Index() > instrTotal)
                {
                    return false;
                }
            case MirTermKind.ReturnVoid:
                if (blk.Slot0Index() != 0 || blk.Slot1Index() != 0 || blk.Slot2Index() != 0)
                {
                    return false;
                }
            case MirTermKind.Branch:
                if (blk.Slot0Index() == 0 || blk.Slot0Index() > blockTotal)
                {
                    return false;
                }
            case MirTermKind.CondBranch:
                if (blk.Slot0Index() == 0 || blk.Slot0Index() > instrTotal || blk.Slot1Index() == 0 || blk.Slot1Index() > blockTotal || blk.Slot2Index() == 0 || blk.Slot2Index() > blockTotal)
                {
                    return false;
                }
            case MirTermKind.TailCall:
                if (blk.Slot0Index() == 0 || blk.Slot0Index() > instrTotal)
                {
                    return false;
                }

                stack MirInstruction payload = instrs.Get(blk.Slot0Index());
                if (payload.Opcode() != MirOp.TailCall)
                {
                    return false;
                }
        }

        bi = bi + 1;
        biRemaining = biRemaining - 1;
    }

    return true;
}

// === LLVM textual IR emission (first backend lowering, step toward #31) ===
// A first lowering of the integer MIR subset to LLVM textual IR. Each MIR value
// `%vN` (N = its 1-based instruction index) becomes a NAMED LLVM SSA register, so
// the output is valid LLVM IR (named locals sidestep LLVM's numbered-value
// consecutiveness rule). `ConstInt` materializes via `add i64 0, imm`. This is text
// generation only; binding to libLLVM for object emission is a later slice. Each
// helper returns `MemoryStatus` and threads append failures sink via `try`.

// Appends an LLVM integer type name (`i1`/`i32`/`i64`).
internal fn MemoryStatus EmitLlvmTypeName(MirType t, mut borrow OwnedAscii sink)
{
    switch (t)
    {
        case MirType.I1:
            try sink.AppendConstAscii("i1");
        case MirType.I32:
            try sink.AppendConstAscii("i32");
        case MirType.I64:
            try sink.AppendConstAscii("i64");
        case MirType.Ptr:
            try sink.AppendConstAscii("ptr");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmAbiCarrierKind(AbiCarrierKind kind, mut borrow OwnedAscii sink)
{
    switch (kind)
    {
        case AbiCarrierKind.I8:
            try sink.AppendConstAscii("i8");
        case AbiCarrierKind.I16:
            try sink.AppendConstAscii("i16");
        case AbiCarrierKind.I32:
            try sink.AppendConstAscii("i32");
        case AbiCarrierKind.I64:
            try sink.AppendConstAscii("i64");
        case AbiCarrierKind.F32:
            try sink.AppendConstAscii("float");
        case AbiCarrierKind.F64:
            try sink.AppendConstAscii("double");
        case AbiCarrierKind.Vector2F32:
            try sink.AppendConstAscii("<2 x float>");
        default:
            try sink.AppendConstAscii("unknown");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitCAbiAggregateCarrierShape(CAbiAggregateCarrierFacts facts, bool isReturn, mut borrow OwnedAscii sink)
{
    if (facts.IsDirect())
    {
        try sink.AppendConstAscii("direct ");
        if (isReturn && facts.ReturnCarrierIsLlvmStruct())
        {
            try sink.AppendConstAscii("{ ");
        }

        stack u32[0 max] count = facts.LlvmParameterCarrierCount();
        stack mut u32[0 max] index = 0;
        while willexit (index < count)
        {
            if (index > 0)
            {
                try sink.AppendConstAscii(", ");
            }

            try EmitLlvmAbiCarrierKind(facts.CarrierKindAt(index), sink);
            index = (u32[0 max])(index + 1);
        }

        if (isReturn && facts.ReturnCarrierIsLlvmStruct())
        {
            try sink.AppendConstAscii(" }");
        }

        return MemoryStatus.Ok;
    }

    if (facts.IsIndirect())
    {
        try sink.AppendConstAscii("indirect");
        return MemoryStatus.Ok;
    }

    try sink.AppendConstAscii("unsupported");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitTokenText(ascii source, borrow TokenStream stream, u32[0 max] token, mut borrow OwnedAscii sink)
{
    return sink.AppendAscii(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token));
}

public fn MemoryStatus EmitCAbiAggregateBoundaryFacts(ascii source, mut borrow OwnedAscii sink)
{
    stack mut TokenStream stream = new();
    switch (LexText(source))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return MemoryStatus.Err(MemoryError.InvalidLayout);
        case LexResult<TokenStream>.Ok(var lexed):
            stream = lexed;
    }

    stack mut u32[0 max] declStart = 0;
    switch (Compiler.Parsing.ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return MemoryStatus.Err(MemoryError.InvalidLayout);
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    stack mut DeclarationList decls = new();
    switch (Compiler.Parsing.ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return MemoryStatus.Err(MemoryError.InvalidLayout);
        case ParseResult<DeclarationList>.Ok(var parsedDecls):
            decls = parsedDecls;
    }

    stack mut CAbiAggregateBoundaryTable boundaries = new();
    switch (Compiler.Binding.BuildCAbiAggregateBoundaryTable(source, stream, decls))
    {
        case BindResult<CAbiAggregateBoundaryTable>.Err(var bindError):
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        case BindResult<CAbiAggregateBoundaryTable>.Ok(var built):
            boundaries = built;
    }

    stack u64[0 2 ** 63 - 1] count = boundaries.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack bool isReturn = boundaries.KindAt(index) == Compiler.Binding.CAbiAggregateBoundaryKind.Return;
        if (isReturn)
        {
            try sink.AppendConstAscii("return ");
        }
        else
        {
            try sink.AppendConstAscii("param ");
        }

        try EmitTokenText(source, stream, boundaries.FunctionNameTokenAt(index), sink);
        if (!isReturn)
        {
            try sink.AppendConstAscii("#");
            try sink.AppendU64((u64[0 max])boundaries.ParamIndexAt(index));
        }

        try sink.AppendConstAscii(" ");
        try EmitTokenText(source, stream, boundaries.TypeNameTokenAt(index), sink);
        try sink.AppendConstAscii(" ");
        try EmitCAbiAggregateCarrierShape(boundaries.FactsAt(index), isReturn, sink);
        try sink.AppendConstAscii("\n");
    }

    return MemoryStatus.Ok;
}

// Appends the LLVM register name (`%vN`) for the value at 1-based `index`.
internal fn MemoryStatus EmitLlvmRegister(mut borrow OwnedAscii sink, u32[0 max] index)
{
    try sink.AppendConstAscii("%v");
    try sink.AppendU64((u64[0 max])index);
    return MemoryStatus.Ok;
}

// Appends the LLVM reference for an OPERAND value at `valueIndex`: `%pK` when it
// names a Param instruction (K = its 0-based param index), else `%vN`. Operands go
// through this (not `EmitLlvmRegister`) so parameter uses lower to `%pK`.
internal fn MemoryStatus EmitLlvmOperand(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] valueIndex)
{
    if (instrs.Contains(valueIndex))
    {
        stack MirInstruction op = instrs.Get(valueIndex);
        if (op.Opcode() == MirOp.Param)
        {
            try sink.AppendConstAscii("%p");
            try sink.AppendI64(op.Immediate());
            return MemoryStatus.Ok;
        }
    }

    return EmitLlvmRegister(sink, valueIndex);
}

internal fn bool MirInstructionIsArenaRuntime(MirInstruction instr)
{
    switch (instr.Opcode())
    {
        case MirOp.ArenaFrameEnter:
            return true;
        case MirOp.ArenaAlloc:
            return true;
        case MirOp.ArenaDynamicStorageInit:
            return true;
        case MirOp.ArenaDynamicStorageReserve:
            return true;
        case MirOp.ArenaDynamicStorageTryReserve:
            return true;
        case MirOp.ArenaDynamicStorageTryReserveCapacity:
            return true;
        case MirOp.ArenaFrameLeave:
            return true;
        default:
            return false;
    }
}

internal fn bool MirInstructionIsArenaDynamicRuntime(MirInstruction instr)
{
    switch (instr.Opcode())
    {
        case MirOp.ArenaDynamicStorageInit:
            return true;
        case MirOp.ArenaDynamicStorageReserve:
            return true;
        case MirOp.ArenaDynamicStorageTryReserve:
            return true;
        case MirOp.ArenaDynamicStorageTryReserveCapacity:
            return true;
        default:
            return false;
    }
}

internal fn bool MirInstructionRangeUsesArenaRuntime(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (MirInstructionIsArenaRuntime(instr))
            {
                return true;
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangeUsesArenaDynamicRuntime(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (MirInstructionIsArenaDynamicRuntime(instr))
            {
                return true;
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool TokenStreamMentionsArenaRuntime(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Arena)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TokenTextIsReserveName(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 7)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    return source[start] == 82
        && source[start + 1] == 101
        && source[start + 2] == 115
        && source[start + 3] == 101
        && source[start + 4] == 114
        && source[start + 5] == 118
        && source[start + 6] == 101;
}

internal fn bool TokenTextIsTryReserveName(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 10)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    return source[start] == 84
        && source[start + 1] == 114
        && source[start + 2] == 121
        && source[start + 3] == 82
        && source[start + 4] == 101
        && source[start + 5] == 115
        && source[start + 6] == 101
        && source[start + 7] == 114
        && source[start + 8] == 118
        && source[start + 9] == 101;
}

internal fn bool TokenTextIsTryReserveCapacityName(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 18)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    return source[start] == 84
        && source[start + 1] == 114
        && source[start + 2] == 121
        && source[start + 3] == 82
        && source[start + 4] == 101
        && source[start + 5] == 115
        && source[start + 6] == 101
        && source[start + 7] == 114
        && source[start + 8] == 118
        && source[start + 9] == 101
        && source[start + 10] == 67
        && source[start + 11] == 97
        && source[start + 12] == 112
        && source[start + 13] == 97
        && source[start + 14] == 99
        && source[start + 15] == 105
        && source[start + 16] == 116
        && source[start + 17] == 121;
}

internal fn bool TokenTextIsArenaDynamicReserveMethod(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    return TokenTextIsReserveName(stream, source, token)
        || TokenTextIsTryReserveName(stream, source, token)
        || TokenTextIsTryReserveCapacityName(stream, source, token);
}

internal fn bool TokenStreamMentionsArenaDynamicRuntime(borrow TokenStream stream, borrow i8[min max][] source)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut bool sawArena = false;
    stack mut bool sawDynamicReserve = false;
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack TokenKind kind = stream.KindAt(i);
        if (kind == TokenKind.Arena)
        {
            sawArena = true;
        }
        else if (kind == TokenKind.Identifier && TokenTextIsArenaDynamicReserveMethod(stream, source, (u32[0 max])i))
        {
            sawDynamicReserve = true;
        }

        i = i + 1;
    }

    return sawArena && sawDynamicReserve;
}

internal fn MemoryStatus EmitLlvmArenaRuntimeDeclarations(mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("declare void @__stark_arena_enter(ptr captures(none) %frame) nounwind\n");
    try sink.AppendConstAscii("declare noalias nonnull noundef ptr @__stark_arena_alloc(ptr captures(none) %frame, i64 noundef %size, i64 noundef allocalign %alignment) allocsize(1) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_arena_alloc\" nounwind\n");
    try sink.AppendConstAscii("declare void @__stark_arena_leave(ptr captures(none) %frame) nounwind\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmArenaDynamicStorageGrowCopyHelperTail(mut borrow OwnedAscii sink, const ascii newCapacity, bool fallible, const ascii successLabel)
{
    try sink.AppendConstAscii("  %new_bytes = mul i64 ");
    try sink.AppendConstAscii(newCapacity);
    try sink.AppendConstAscii(", %element_size\n");
    if (fallible)
    {
        try sink.AppendConstAscii("  %new_ptr = call noalias noundef ptr @__stark_arena_try_alloc(ptr %frame, i64 noundef %new_bytes, i64 noundef %alignment)\n");
        try sink.AppendConstAscii("  %new_ptr_is_null = icmp eq ptr %new_ptr, null\n");
        try sink.AppendConstAscii("  br i1 %new_ptr_is_null, label %failed, label %copy_check\n\n");
        try sink.AppendConstAscii("copy_check:\n");
    }
    else
    {
        try sink.AppendConstAscii("  %new_ptr = call noalias nonnull noundef ptr @__stark_arena_alloc(ptr %frame, i64 noundef %new_bytes, i64 noundef %alignment)\n");
    }

    try sink.AppendConstAscii("  %has_live = icmp ne i64 %length, 0\n");
    try sink.AppendConstAscii("  br i1 %has_live, label %copy, label %update\n\n");
    try sink.AppendConstAscii("copy:\n");
    try sink.AppendConstAscii("  %live_bytes = mul i64 %length, %element_size\n");
    try sink.AppendConstAscii("  call void @llvm.memcpy.p0.p0.i64(ptr %new_ptr, ptr %ptr, i64 %live_bytes, i1 false)\n");
    try sink.AppendConstAscii("  br label %update\n\n");
    try sink.AppendConstAscii("update:\n");
    try sink.AppendConstAscii("  %with_ptr = insertvalue { ptr, i64, i64 } %current, ptr %new_ptr, 0\n");
    try sink.AppendConstAscii("  %updated = insertvalue { ptr, i64, i64 } %with_ptr, i64 ");
    try sink.AppendConstAscii(newCapacity);
    try sink.AppendConstAscii(", 2\n");
    try sink.AppendConstAscii("  store { ptr, i64, i64 } %updated, ptr %storage\n");
    try sink.AppendConstAscii("  br label %");
    try sink.AppendConstAscii(successLabel);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmArenaDynamicRuntimeDeclarations(mut borrow OwnedAscii sink)
{
    try EmitLlvmArenaRuntimeDeclarations(sink);
    try sink.AppendConstAscii("declare noalias noundef ptr @__stark_arena_try_alloc(ptr captures(none) %frame, i64 noundef %size, i64 noundef allocalign %alignment) allocsize(1) allockind(\"alloc,uninitialized,aligned\") \"alloc-family\"=\"__stark_arena_alloc\" nounwind\n");
    try sink.AppendConstAscii("declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n");
    try sink.AppendConstAscii("declare void @llvm.trap() nounwind\n\n");

    try sink.AppendConstAscii("define internal void @__stark_arena_dynamic_reserve(ptr captures(none) %frame, ptr captures(none) %storage, i64 noundef %additional, i64 noundef %element_size, i64 noundef allocalign %alignment, i64 noundef %max_count) nounwind {\n");
    try sink.AppendConstAscii("entry:\n");
    try sink.AppendConstAscii("  %current = load { ptr, i64, i64 }, ptr %storage\n");
    try sink.AppendConstAscii("  %ptr = extractvalue { ptr, i64, i64 } %current, 0\n");
    try sink.AppendConstAscii("  %length = extractvalue { ptr, i64, i64 } %current, 1\n");
    try sink.AppendConstAscii("  %capacity = extractvalue { ptr, i64, i64 } %current, 2\n");
    try sink.AppendConstAscii("  %needed = add i64 %length, %additional\n");
    try sink.AppendConstAscii("  %needed_overflow = icmp ult i64 %needed, %length\n");
    try sink.AppendConstAscii("  br i1 %needed_overflow, label %overflow, label %check\n\n");
    try sink.AppendConstAscii("overflow:\n");
    try sink.AppendConstAscii("  call void @llvm.trap()\n");
    try sink.AppendConstAscii("  unreachable\n\n");
    try sink.AppendConstAscii("check:\n");
    try sink.AppendConstAscii("  %enough = icmp ule i64 %needed, %capacity\n");
    try sink.AppendConstAscii("  br i1 %enough, label %done, label %grow\n\n");
    try sink.AppendConstAscii("grow:\n");
    try sink.AppendConstAscii("  %doubled = shl i64 %capacity, 1\n");
    try sink.AppendConstAscii("  %can_double = icmp ule i64 %capacity, 9223372036854775807\n");
    try sink.AppendConstAscii("  %doubled_or_max = select i1 %can_double, i64 %doubled, i64 -1\n");
    try sink.AppendConstAscii("  %capacity_small = icmp ult i64 %capacity, 2\n");
    try sink.AppendConstAscii("  %minimum = select i1 %capacity_small, i64 4, i64 %doubled_or_max\n");
    try sink.AppendConstAscii("  %needed_larger = icmp ugt i64 %needed, %minimum\n");
    try sink.AppendConstAscii("  %new_capacity = select i1 %needed_larger, i64 %needed, i64 %minimum\n");
    try sink.AppendConstAscii("  %too_large = icmp ugt i64 %new_capacity, %max_count\n");
    try sink.AppendConstAscii("  br i1 %too_large, label %overflow, label %allocate\n\n");
    try sink.AppendConstAscii("allocate:\n");
    try EmitLlvmArenaDynamicStorageGrowCopyHelperTail(sink, "%new_capacity", false, "done");
    try sink.AppendConstAscii("\n");
    try sink.AppendConstAscii("done:\n");
    try sink.AppendConstAscii("  ret void\n");
    try sink.AppendConstAscii("}\n\n");

    try sink.AppendConstAscii("define internal i1 @__stark_arena_dynamic_try_reserve(ptr captures(none) %frame, ptr captures(none) %storage, i64 noundef %additional, i64 noundef %element_size, i64 noundef allocalign %alignment, i64 noundef %max_count) nounwind {\n");
    try sink.AppendConstAscii("entry:\n");
    try sink.AppendConstAscii("  %current = load { ptr, i64, i64 }, ptr %storage\n");
    try sink.AppendConstAscii("  %ptr = extractvalue { ptr, i64, i64 } %current, 0\n");
    try sink.AppendConstAscii("  %length = extractvalue { ptr, i64, i64 } %current, 1\n");
    try sink.AppendConstAscii("  %capacity = extractvalue { ptr, i64, i64 } %current, 2\n");
    try sink.AppendConstAscii("  %needed = add i64 %length, %additional\n");
    try sink.AppendConstAscii("  %needed_overflow = icmp ult i64 %needed, %length\n");
    try sink.AppendConstAscii("  br i1 %needed_overflow, label %failed, label %check\n\n");
    try sink.AppendConstAscii("check:\n");
    try sink.AppendConstAscii("  %enough = icmp ule i64 %needed, %capacity\n");
    try sink.AppendConstAscii("  br i1 %enough, label %succeeded, label %grow\n\n");
    try sink.AppendConstAscii("grow:\n");
    try sink.AppendConstAscii("  %doubled = shl i64 %capacity, 1\n");
    try sink.AppendConstAscii("  %can_double = icmp ule i64 %capacity, 9223372036854775807\n");
    try sink.AppendConstAscii("  %doubled_or_max = select i1 %can_double, i64 %doubled, i64 -1\n");
    try sink.AppendConstAscii("  %capacity_small = icmp ult i64 %capacity, 2\n");
    try sink.AppendConstAscii("  %minimum = select i1 %capacity_small, i64 4, i64 %doubled_or_max\n");
    try sink.AppendConstAscii("  %needed_larger = icmp ugt i64 %needed, %minimum\n");
    try sink.AppendConstAscii("  %new_capacity = select i1 %needed_larger, i64 %needed, i64 %minimum\n");
    try sink.AppendConstAscii("  %too_large = icmp ugt i64 %new_capacity, %max_count\n");
    try sink.AppendConstAscii("  br i1 %too_large, label %failed, label %allocate\n\n");
    try sink.AppendConstAscii("allocate:\n");
    try EmitLlvmArenaDynamicStorageGrowCopyHelperTail(sink, "%new_capacity", true, "succeeded");
    try sink.AppendConstAscii("\n");
    try sink.AppendConstAscii("succeeded:\n");
    try sink.AppendConstAscii("  ret i1 true\n\n");
    try sink.AppendConstAscii("failed:\n");
    try sink.AppendConstAscii("  ret i1 false\n");
    try sink.AppendConstAscii("}\n\n");

    try sink.AppendConstAscii("define internal i1 @__stark_arena_dynamic_try_reserve_capacity(ptr captures(none) %frame, ptr captures(none) %storage, i64 noundef %target_capacity, i64 noundef %element_size, i64 noundef allocalign %alignment, i64 noundef %max_count) nounwind {\n");
    try sink.AppendConstAscii("entry:\n");
    try sink.AppendConstAscii("  %current = load { ptr, i64, i64 }, ptr %storage\n");
    try sink.AppendConstAscii("  %ptr = extractvalue { ptr, i64, i64 } %current, 0\n");
    try sink.AppendConstAscii("  %length = extractvalue { ptr, i64, i64 } %current, 1\n");
    try sink.AppendConstAscii("  %capacity = extractvalue { ptr, i64, i64 } %current, 2\n");
    try sink.AppendConstAscii("  %enough = icmp ule i64 %target_capacity, %capacity\n");
    try sink.AppendConstAscii("  br i1 %enough, label %succeeded, label %check\n\n");
    try sink.AppendConstAscii("check:\n");
    try sink.AppendConstAscii("  %too_large = icmp ugt i64 %target_capacity, %max_count\n");
    try sink.AppendConstAscii("  br i1 %too_large, label %failed, label %allocate\n\n");
    try sink.AppendConstAscii("allocate:\n");
    try EmitLlvmArenaDynamicStorageGrowCopyHelperTail(sink, "%target_capacity", true, "succeeded");
    try sink.AppendConstAscii("\n");
    try sink.AppendConstAscii("succeeded:\n");
    try sink.AppendConstAscii("  ret i1 true\n\n");
    try sink.AppendConstAscii("failed:\n");
    try sink.AppendConstAscii("  ret i1 false\n");
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmArenaRuntimePreambleForRange(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    if (MirInstructionRangeUsesArenaDynamicRuntime(instrs, firstInstr, instrCount))
    {
        try EmitLlvmArenaDynamicRuntimeDeclarations(sink);
    }
    else if (MirInstructionRangeUsesArenaRuntime(instrs, firstInstr, instrCount))
    {
        try EmitLlvmArenaRuntimeDeclarations(sink);
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmArenaInstruction(mut borrow OwnedAscii sink, u32[0 max] index, MirInstruction instr)
{
    switch (instr.Opcode())
    {
        case MirOp.ArenaFrameEnter:
            try sink.AppendConstAscii("  %__stark_arena_frame = alloca { ptr, ptr, ptr }, align 8\n");
            try sink.AppendConstAscii("  call void @__stark_arena_enter(ptr nonnull %__stark_arena_frame)\n");
        case MirOp.ArenaAlloc:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = call noalias nonnull noundef align ");
            try sink.AppendU64((u64[0 max])instr.OperandAIndex());
            try sink.AppendConstAscii(" dereferenceable(");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(") ptr @__stark_arena_alloc(ptr nonnull %__stark_arena_frame, i64 noundef ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendU64((u64[0 max])instr.OperandAIndex());
            try sink.AppendConstAscii(")\n");
        case MirOp.ArenaDynamicStorageInit:
            stack u64[0 max] capacity = (u64[0 max])instr.Immediate();
            stack u64[0 max] elementSize = (u64[0 max])instr.OperandAIndex();
            stack u64[0 max] byteLength = capacity * elementSize;
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = alloca { ptr, i64, i64 }, align 8\n");
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(".data = call noalias nonnull noundef align ");
            try sink.AppendU64((u64[0 max])instr.OperandBIndex());
            try sink.AppendConstAscii(" dereferenceable(");
            try sink.AppendU64(byteLength);
            try sink.AppendConstAscii(") ptr @__stark_arena_alloc(ptr nonnull %__stark_arena_frame, i64 noundef ");
            try sink.AppendU64(byteLength);
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendU64((u64[0 max])instr.OperandBIndex());
            try sink.AppendConstAscii(")\n");
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(".with_ptr = insertvalue { ptr, i64, i64 } zeroinitializer, ptr ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(".data, 0\n");
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(".with_length = insertvalue { ptr, i64, i64 } ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(".with_ptr, i64 0, 1\n");
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(".value = insertvalue { ptr, i64, i64 } ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(".with_length, i64 ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", 2\n");
            try sink.AppendConstAscii("  store { ptr, i64, i64 } ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(".value, ptr ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(", align 8\n");
        case MirOp.ArenaDynamicStorageReserve:
            try sink.AppendConstAscii("  call void @__stark_arena_dynamic_reserve(ptr nonnull %__stark_arena_frame, ptr nonnull ");
            try EmitLlvmRegister(sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendU64((u64[0 max])instr.OperandBIndex());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendU64((u64[0 max])instr.OperandCIndex());
            try sink.AppendConstAscii(", i64 noundef 9223372036854775807)\n");
        case MirOp.ArenaDynamicStorageTryReserve:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = call i1 @__stark_arena_dynamic_try_reserve(ptr nonnull %__stark_arena_frame, ptr nonnull ");
            try EmitLlvmRegister(sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendU64((u64[0 max])instr.OperandBIndex());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendU64((u64[0 max])instr.OperandCIndex());
            try sink.AppendConstAscii(", i64 noundef 9223372036854775807)\n");
        case MirOp.ArenaDynamicStorageTryReserveCapacity:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = call i1 @__stark_arena_dynamic_try_reserve_capacity(ptr nonnull %__stark_arena_frame, ptr nonnull ");
            try EmitLlvmRegister(sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendU64((u64[0 max])instr.OperandBIndex());
            try sink.AppendConstAscii(", i64 noundef ");
            try sink.AppendU64((u64[0 max])instr.OperandCIndex());
            try sink.AppendConstAscii(", i64 noundef 9223372036854775807)\n");
        case MirOp.ArenaFrameLeave:
            try sink.AppendConstAscii("  call void @__stark_arena_leave(ptr nonnull %__stark_arena_frame)\n");
        default:
            try sink.AppendConstAscii("");
    }

    return MemoryStatus.Ok;
}

internal fn ValueFacts FactAt(borrow IrTable<ValueFacts> facts, u32[0 max] index)
{
    return ValueFactsAtIndex(facts, index);
}

internal fn MemoryStatus EmitLlvmVolatileMarker(ValueFacts facts, mut borrow OwnedAscii sink)
{
    if (facts.Volatile())
    {
        try sink.AppendConstAscii("volatile ");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmMemoryAlignment(ValueFacts facts, mut borrow OwnedAscii sink)
{
    if (facts.HasAlignment() && facts.AlignmentBytes() != 0)
    {
        try sink.AppendConstAscii(", align ");
        try sink.AppendU64((u64[0 max])facts.AlignmentBytes());
    }

    return MemoryStatus.Ok;
}

internal fn ValueFacts RangeFactForValue(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    u32[0 max] valueIndex)
{
    if (!instrs.Contains(valueIndex))
    {
        return FactAt(valueFacts, valueIndex);
    }

    stack MirInstruction instr = instrs.Get(valueIndex);
    if (instr.Opcode() == MirOp.Param)
    {
        return FactAt(paramFacts, (u32[0 max])instr.Immediate() + 1);
    }

    if (instr.Opcode() == MirOp.LoadGlobal)
    {
        return FactAt(globalFacts, (u32[0 max])instr.Immediate());
    }

    if (instr.Opcode() == MirOp.Call || instr.Opcode() == MirOp.TailCall)
    {
        return FactAt(functionReturnFacts, (u32[0 max])instr.Immediate());
    }

    return FactAt(valueFacts, valueIndex);
}

internal fn MemoryStatus EmitLlvmRangeAttribute(MirType type, ValueFacts facts, mut borrow OwnedAscii sink)
{
    if (!facts.HasIntegerRange())
    {
        return MemoryStatus.Ok;
    }

    try sink.AppendConstAscii(" range(");
    try EmitLlvmTypeName(type, sink);
    try sink.AppendConstAscii(" ");
    try sink.AppendI64(facts.IntegerRangeLower());
    try sink.AppendConstAscii(", ");
    try sink.AppendI64(facts.IntegerRangeUpperExclusive());
    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

internal struct FunctionEffectFacts
{
    bool IsLaw;
    bool LawMayReadMemory;
    bool IsFinite;
    bool IsNoRecurse;

    FunctionEffectFacts()
    {
        self.IsLaw = false;
        self.LawMayReadMemory = false;
        self.IsFinite = false;
        self.IsNoRecurse = false;
    }
}

internal fn FunctionEffectFacts NoFunctionEffectFacts()
{
    stack mut FunctionEffectFacts facts = new();
    return facts;
}

internal fn FunctionEffectFacts FunctionEffectFactsAt(borrow IrTable<FunctionEffectFacts> facts, u32[0 max] functionId)
{
    if (functionId == 0 || !facts.Contains(functionId))
    {
        return NoFunctionEffectFacts();
    }

    return facts.Get(functionId);
}

internal fn MemoryStatus EmitLlvmFunctionEffectAttributes(FunctionEffectFacts facts, mut borrow OwnedAscii sink)
{
    if (facts.IsLaw)
    {
        if (facts.LawMayReadMemory)
        {
            try sink.AppendConstAscii(" memory(read)");
        }
        else
        {
            try sink.AppendConstAscii(" memory(none)");
        }

        try sink.AppendConstAscii(" nosync nofree");
    }

    if (facts.IsFinite)
    {
        try sink.AppendConstAscii(" willreturn mustprogress");
    }

    if (facts.IsNoRecurse)
    {
        try sink.AppendConstAscii(" norecurse");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallSiteEffectAttributes(borrow IrTable<FunctionEffectFacts> functionEffectFacts, u32[0 max] calleeId, mut borrow OwnedAscii sink)
{
    return EmitLlvmFunctionEffectAttributes(FunctionEffectFactsAt(functionEffectFacts, calleeId), sink);
}

internal struct FunctionLinkageFacts
{
    bool IsInternal;

    FunctionLinkageFacts()
    {
        self.IsInternal = false;
    }
}

internal fn FunctionLinkageFacts FunctionLinkageFactsAt(borrow IrTable<FunctionLinkageFacts> facts, u32[0 max] functionId)
{
    stack mut FunctionLinkageFacts empty = new();
    if (functionId != 0 && facts.Contains(functionId))
    {
        return facts.Get(functionId);
    }

    return empty;
}

internal fn MemoryStatus EmitLlvmDefinitionLinkage(FunctionLinkageFacts facts, mut borrow OwnedAscii sink)
{
    if (facts.IsInternal)
    {
        try sink.AppendConstAscii(" internal dso_local");
    }

    return MemoryStatus.Ok;
}

internal struct FunctionCallingConventionFacts
{
    bool HasFfiAbi;
    Compiler.TargetFacts.StarkFfiAbi FfiAbi;

    FunctionCallingConventionFacts()
    {
        self.HasFfiAbi = false;
        self.FfiAbi = Compiler.TargetFacts.StarkFfiAbi.C;
    }
}

internal fn void SetFfiCallingConvention(mut borrow FunctionCallingConventionFacts facts, Compiler.TargetFacts.StarkFfiAbi abi)
{
    facts.HasFfiAbi = true;
    facts.FfiAbi = abi;
}

internal fn FunctionCallingConventionFacts FunctionCallingConventionFactsAt(borrow IrTable<FunctionCallingConventionFacts> facts, u32[0 max] functionId)
{
    stack mut FunctionCallingConventionFacts empty = new();
    if (functionId != 0 && facts.Contains(functionId))
    {
        return facts.Get(functionId);
    }

    return empty;
}

internal fn MemoryStatus EmitLlvmDefinitionCallingConvention(bool isTailCallable, FunctionCallingConventionFacts facts, mut borrow OwnedAscii sink)
{
    if (isTailCallable)
    {
        try sink.AppendConstAscii(" tailcc");
        return MemoryStatus.Ok;
    }

    if (facts.HasFfiAbi)
    {
        stack ascii convention = Compiler.TargetFacts.FfiAbiLlvmCallingConventionName(facts.FfiAbi);
        if (System.Text.AsciiLength(convention) > 0)
        {
            try sink.AppendConstAscii(" ");
            try sink.AppendAscii(convention);
        }
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallCallingConvention(
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    u32[0 max] functionId,
    mut borrow OwnedAscii sink)
{
    if (FunctionIdIsTailCallable(funcTailFlags, functionId))
    {
        try sink.AppendConstAscii("tailcc ");
        return MemoryStatus.Ok;
    }

    stack FunctionCallingConventionFacts facts = FunctionCallingConventionFactsAt(functionCallingConventionFacts, functionId);
    if (facts.HasFfiAbi)
    {
        stack ascii convention = Compiler.TargetFacts.FfiAbiLlvmCallingConventionName(facts.FfiAbi);
        if (System.Text.AsciiLength(convention) > 0)
        {
            try sink.AppendAscii(convention);
            try sink.AppendConstAscii(" ");
        }
    }

    return MemoryStatus.Ok;
}

