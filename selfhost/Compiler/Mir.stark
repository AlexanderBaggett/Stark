import Compiler.Ir
import Compiler.Lexing
import System.Memory
import System.Text
import System.Runtime.Buffer
import System.IO
import System.IO.File
import System.FileSystem
import System.Process
module Compiler.Mir

// A first slice of the self-hosted compiler's MIR (mid-level IR), built on the
// `Compiler.Ir` typed-handle substrate (docs/Self-host-Prep/24). Instructions live
// in a dense `IrTable<MirInstruction>` the caller owns directly; each instruction's
// result is named by a `MirValueId` (its 1-based table index), and operands are
// raw 1-based value indices into the same table.
//
// The MIR builder is a set of FREE FUNCTIONS over the table rather than methods on a
// wrapper struct: a struct field whose type is a generic aggregate (an `IrTable<T>`
// field) currently miscompiles in the host backend (an invalid `getelementptr`), so
// the table is passed directly instead of being wrapped. `MirInstruction` is a flat
// record (plain enum + raw `u32`/`i64`), avoiding nested handle structs.

// A MIR instruction opcode (a flat, non-generic enum).
public enum MirOp
{
    // An integer constant; its value is the instruction's immediate.
    ConstInt,
    // A function parameter; its 0-based index rides in the immediate. Declared in the
    // signature, so it emits no body line and is referenced as `%pK` by its uses.
    Param,
    Add,
    Sub,
    Mul,
    // The rest of the integer ALU over operands A/B: signed/unsigned divide and
    // remainder, bitwise and/or/xor, and left/arithmetic-right shifts. Map to LLVM
    // sdiv/udiv/srem/and/or/xor/shl/ashr.
    SDiv,
    UDiv,
    SRem,
    And,
    Or,
    Xor,
    Shl,
    AShr,
    // Signed integer comparisons over operands A/B; each yields an i1 (LLVM `icmp`),
    // meant to feed a `CondBranch` condition. Eq/Ne/Lt/Le/Gt/Ge map to LLVM
    // eq/ne/slt/sle/sgt/sge.
    CmpEq,
    CmpNe,
    CmpLt,
    CmpLe,
    CmpGt,
    CmpGe,
    // Zero-extends operand A (an i1, e.g. a comparison result) to i64.
    ZExt,
    // Loads the i64 value of module global `@gN` (N = the global id in the immediate);
    // its result is the value naming this instruction.
    LoadGlobal,
    // Stores operand A into module global `@gN` (N = the global id in the immediate).
    // A side-effecting instruction with no meaningful result register.
    StoreGlobal,
    // A 2-incoming SSA phi: result = operand A from one predecessor block, operand B
    // from another. The two predecessor block ids are packed into the immediate as
    // `block0 + block1 * 2**32` (decoded by div/mod 2**32), since the flat instruction
    // has no spare fields for them. Used at a control-flow merge.
    Phi,
    // Calls function `@fN` where N is the callee id held in the immediate. Zero-arg
    // for now; its result is the value naming this instruction.
    Call,
    // Returns operand A from the function.
    Return,
}

// A MIR value type. The integer subset is currently the only modeled family; values
// default to `I64` so untyped builders emit `i64` exactly as before.
public enum MirType
{
    I1,
    I32,
    I64,
}

// One MIR instruction: an opcode, up to two operand value indices (0 = absent), an
// integer immediate (used by `ConstInt`/`Param`/`Call`/`*Global`/`Phi`), and the
// type of its result value (defaults to `I64`).
public struct MirInstruction
{
    MirOp Op;
    u32[0 max] AIndex;
    u32[0 max] BIndex;
    // Extra operand slots for calls with three or four arguments (0 = unused). A call's
    // arguments ride in operands A/B/C/D; ordinary instructions use only A/B.
    u32[0 max] CIndex;
    u32[0 max] DIndex;
    i64[min max] Imm;
    MirType ResType;

    MirInstruction()
    {
        self.Op = MirOp.ConstInt;
        self.AIndex = 0;
        self.BIndex = 0;
        self.CIndex = 0;
        self.DIndex = 0;
        self.Imm = 0;
        self.ResType = MirType.I64;
    }

    public inline finite law MirOp Opcode(borrow MirInstruction self)
    {
        return self.Op;
    }

    public inline finite law MirType ResultType(borrow MirInstruction self)
    {
        return self.ResType;
    }

    public inline finite law u32[0 max] OperandAIndex(borrow MirInstruction self)
    {
        return self.AIndex;
    }

    public inline finite law u32[0 max] OperandBIndex(borrow MirInstruction self)
    {
        return self.BIndex;
    }

    public inline finite law u32[0 max] OperandCIndex(borrow MirInstruction self)
    {
        return self.CIndex;
    }

    public inline finite law u32[0 max] OperandDIndex(borrow MirInstruction self)
    {
        return self.DIndex;
    }

    public inline finite law i64[min max] Immediate(borrow MirInstruction self)
    {
        return self.Imm;
    }
}

// Appends an instruction to `instrs`, returning the `MirValueId` naming its result.
internal fn MirValueId MirEmit(mut borrow IrTable<MirInstruction> instrs, MirOp op, u32[0 max] aIndex, u32[0 max] bIndex, i64[min max] imm)
{
    stack mut MirInstruction instr = new();
    instr.Op = op;
    instr.AIndex = aIndex;
    instr.BIndex = bIndex;
    instr.Imm = imm;
    return MirValueIdOf(instrs.Add(instr));
}

// Like `MirEmit` but sets the result type (the untyped `MirEmit` leaves it `I64`).
internal fn MirValueId MirEmitTyped(mut borrow IrTable<MirInstruction> instrs, MirOp op, MirType type, u32[0 max] aIndex, u32[0 max] bIndex, i64[min max] imm)
{
    stack mut MirInstruction instr = new();
    instr.Op = op;
    instr.AIndex = aIndex;
    instr.BIndex = bIndex;
    instr.Imm = imm;
    instr.ResType = type;
    return MirValueIdOf(instrs.Add(instr));
}

// The result type of the instruction naming `value` (`I64` when out of range).
public fn MirType MirValueType(borrow IrTable<MirInstruction> instrs, u32[0 max] valueIndex)
{
    if (!instrs.Contains(valueIndex))
    {
        return MirType.I64;
    }

    stack MirInstruction instr = instrs.Get(valueIndex);
    return instr.ResultType();
}

// Emits an integer constant, returning the value naming it.
public fn MirValueId MirConstInt(mut borrow IrTable<MirInstruction> instrs, i64[min max] value)
{
    return MirEmit(instrs, MirOp.ConstInt, 0, 0, value);
}

// A typed integer constant of result type `type`.
public fn MirValueId MirConstIntTyped(mut borrow IrTable<MirInstruction> instrs, MirType type, i64[min max] value)
{
    return MirEmitTyped(instrs, MirOp.ConstInt, type, 0, 0, value);
}

// A typed integer add of result type `type` over A/B.
public fn MirValueId MirAddTyped(mut borrow IrTable<MirInstruction> instrs, MirType type, MirValueId a, MirValueId b)
{
    return MirEmitTyped(instrs, MirOp.Add, type, a.Index(), b.Index(), 0);
}

// Declares the 0-based function parameter `paramIndex` as a value. Uses of the
// returned value emit `%pParamIndex`; it produces no body line of its own.
public fn MirValueId MirParam(mut borrow IrTable<MirInstruction> instrs, u32[0 max] paramIndex)
{
    return MirEmit(instrs, MirOp.Param, 0, 0, (i64[min max])paramIndex);
}

// The 0-based parameter index of the param instruction naming `value` (0 when not a
// param / out of range). Guards on the opcode so the shared `Imm` field is not
// misread for a ConstInt/Call value that also stores data there.
public fn u32[0 max] MirParamIndexOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return 0;
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    if (instr.Opcode() != MirOp.Param)
    {
        return 0;
    }

    return (u32[0 max])instr.Immediate();
}

public fn MirValueId MirAdd(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.Add, a.Index(), b.Index(), 0);
}

public fn MirValueId MirSub(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.Sub, a.Index(), b.Index(), 0);
}

public fn MirValueId MirMul(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.Mul, a.Index(), b.Index(), 0);
}

// The rest of the integer ALU: signed/unsigned divide and remainder, bitwise
// and/or/xor, and left/arithmetic-right shifts, each over operands A/B.
public fn MirValueId MirSDiv(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.SDiv, a.Index(), b.Index(), 0);
}

public fn MirValueId MirUDiv(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.UDiv, a.Index(), b.Index(), 0);
}

public fn MirValueId MirSRem(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.SRem, a.Index(), b.Index(), 0);
}

public fn MirValueId MirAnd(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.And, a.Index(), b.Index(), 0);
}

public fn MirValueId MirOr(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.Or, a.Index(), b.Index(), 0);
}

public fn MirValueId MirXor(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.Xor, a.Index(), b.Index(), 0);
}

public fn MirValueId MirShl(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.Shl, a.Index(), b.Index(), 0);
}

public fn MirValueId MirAShr(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.AShr, a.Index(), b.Index(), 0);
}

// Signed integer comparisons; each emits an `i1`-valued instruction over A/B.
public fn MirValueId MirCmpEq(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.CmpEq, a.Index(), b.Index(), 0);
}

public fn MirValueId MirCmpNe(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.CmpNe, a.Index(), b.Index(), 0);
}

public fn MirValueId MirCmpLt(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.CmpLt, a.Index(), b.Index(), 0);
}

public fn MirValueId MirCmpLe(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.CmpLe, a.Index(), b.Index(), 0);
}

public fn MirValueId MirCmpGt(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.CmpGt, a.Index(), b.Index(), 0);
}

public fn MirValueId MirCmpGe(mut borrow IrTable<MirInstruction> instrs, MirValueId a, MirValueId b)
{
    return MirEmit(instrs, MirOp.CmpGe, a.Index(), b.Index(), 0);
}

// Zero-extends `value` (an i1) to i64.
public fn MirValueId MirZExt(mut borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    return MirEmit(instrs, MirOp.ZExt, value.Index(), 0, 0);
}

public fn MirValueId MirReturn(mut borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    return MirEmit(instrs, MirOp.Return, value.Index(), 0, 0);
}

// Loads module global `@gN` (globalId), returning the value naming the loaded result.
// The global id rides in the immediate field.
public fn MirValueId MirLoadGlobal(mut borrow IrTable<MirInstruction> instrs, u32[0 max] globalId)
{
    return MirEmit(instrs, MirOp.LoadGlobal, 0, 0, (i64[min max])globalId);
}

// The global id loaded by the load instruction naming `value` (0 when not a load /
// out of range). Guards on the opcode so the shared `Imm` field is not misread.
public fn u32[0 max] MirLoadedGlobalOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return 0;
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    if (instr.Opcode() != MirOp.LoadGlobal)
    {
        return 0;
    }

    return (u32[0 max])instr.Immediate();
}

// Stores `value` into module global `@gN` (globalId). The stored value rides in
// operand A; the global id rides in the immediate. The returned id names the store
// instruction itself (a store has no meaningful result).
public fn MirValueId MirStoreGlobal(mut borrow IrTable<MirInstruction> instrs, u32[0 max] globalId, MirValueId value)
{
    return MirEmit(instrs, MirOp.StoreGlobal, value.Index(), 0, (i64[min max])globalId);
}

// The global id written by the store instruction naming `value` (0 when not a store /
// out of range). Guards on the opcode so the shared `Imm` field is not misread.
public fn u32[0 max] MirStoredGlobalOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return 0;
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    if (instr.Opcode() != MirOp.StoreGlobal)
    {
        return 0;
    }

    return (u32[0 max])instr.Immediate();
}

// The two predecessor block ids of a 2-incoming phi are packed into the immediate as
// `block0 + block1 * 2**32`; these decode the low/high halves (div/mod, no bitwise).
internal fn u32[0 max] DecodePhiBlock0(i64[min max] packed)
{
    return (u32[0 max])(packed % 4294967296);
}

internal fn u32[0 max] DecodePhiBlock1(i64[min max] packed)
{
    return (u32[0 max])(packed / 4294967296);
}

// A 2-incoming SSA phi: `value0` from `block0`, `value1` from `block1`. The values
// ride in operands A/B; the two block ids are packed into the immediate.
public fn MirValueId MirPhi2(mut borrow IrTable<MirInstruction> instrs, MirValueId value0, MirBlockId block0, MirValueId value1, MirBlockId block1)
{
    stack i64[min max] packed = (i64[min max])block0.Index() + (i64[min max])block1.Index() * 4294967296;
    return MirEmit(instrs, MirOp.Phi, value0.Index(), value1.Index(), packed);
}

// The first/second incoming predecessor block of the phi naming `value` (invalid when
// not a phi / out of range). Guards on the opcode before decoding the immediate.
public fn MirBlockId MirPhiIncomingBlock0(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    if (instr.Opcode() != MirOp.Phi)
    {
        return MirBlockIdOf(0);
    }

    return MirBlockIdOf(DecodePhiBlock0(instr.Immediate()));
}

public fn MirBlockId MirPhiIncomingBlock1(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    if (instr.Opcode() != MirOp.Phi)
    {
        return MirBlockIdOf(0);
    }

    return MirBlockIdOf(DecodePhiBlock1(instr.Immediate()));
}

// Emits a zero-arg call to `callee`, returning the value naming its result. The
// callee id rides in the immediate field.
public fn MirValueId MirCall(mut borrow IrTable<MirInstruction> instrs, MirFuncId callee)
{
    return MirEmit(instrs, MirOp.Call, 0, 0, (i64[min max])callee.Index());
}

// Emits a one-argument call `callee(arg0)`; the argument rides in operand A.
public fn MirValueId MirCall1(mut borrow IrTable<MirInstruction> instrs, MirFuncId callee, MirValueId arg0)
{
    return MirEmit(instrs, MirOp.Call, arg0.Index(), 0, (i64[min max])callee.Index());
}

// Emits a two-argument call `callee(arg0, arg1)`; the arguments ride in operands A/B.
public fn MirValueId MirCall2(mut borrow IrTable<MirInstruction> instrs, MirFuncId callee, MirValueId arg0, MirValueId arg1)
{
    return MirEmit(instrs, MirOp.Call, arg0.Index(), arg1.Index(), (i64[min max])callee.Index());
}

// Emits a three-argument call `callee(arg0, arg1, arg2)`; the arguments ride in A/B/C.
public fn MirValueId MirCall3(mut borrow IrTable<MirInstruction> instrs, MirFuncId callee, MirValueId arg0, MirValueId arg1, MirValueId arg2)
{
    stack mut MirInstruction instr = new();
    instr.Op = MirOp.Call;
    instr.AIndex = arg0.Index();
    instr.BIndex = arg1.Index();
    instr.CIndex = arg2.Index();
    instr.Imm = (i64[min max])callee.Index();
    return MirValueIdOf(instrs.Add(instr));
}

// Emits a four-argument call `callee(arg0, arg1, arg2, arg3)`; the arguments ride in A/B/C/D.
public fn MirValueId MirCall4(mut borrow IrTable<MirInstruction> instrs, MirFuncId callee, MirValueId arg0, MirValueId arg1, MirValueId arg2, MirValueId arg3)
{
    stack mut MirInstruction instr = new();
    instr.Op = MirOp.Call;
    instr.AIndex = arg0.Index();
    instr.BIndex = arg1.Index();
    instr.CIndex = arg2.Index();
    instr.DIndex = arg3.Index();
    instr.Imm = (i64[min max])callee.Index();
    return MirValueIdOf(instrs.Add(instr));
}

// The callee of the call instruction naming `value` (invalid when not a call /
// out of range). Guards on the opcode so the shared `Imm` field is not misread for
// a ConstInt/Param value that also stores data there.
public fn MirFuncId MirCalleeOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirFuncIdOf(0);
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    if (instr.Opcode() != MirOp.Call)
    {
        return MirFuncIdOf(0);
    }

    return MirFuncIdOf((u32[0 max])instr.Immediate());
}

// True when `value` names a live instruction in `instrs`.
public inline finite law bool MirDefines(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    return instrs.Contains(value.Index());
}

// The opcode of the instruction naming `value` (`Return` when out of range).
public fn MirOp MirOpcodeOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirOp.Return;
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    return instr.Opcode();
}

// The first operand of the instruction naming `value` (invalid when out of range).
public fn MirValueId MirOperandAOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirValueIdOf(0);
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    return MirValueIdOf(instr.OperandAIndex());
}

public fn MirValueId MirOperandBOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return MirValueIdOf(0);
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    return MirValueIdOf(instr.OperandBIndex());
}

// The immediate of the instruction naming `value` (0 when out of range).
public fn i64[min max] MirImmediateOf(borrow IrTable<MirInstruction> instrs, MirValueId value)
{
    if (!instrs.Contains(value.Index()))
    {
        return 0;
    }

    stack MirInstruction instr = instrs.Get(value.Index());
    return instr.Immediate();
}

// === Basic blocks + terminators ===
// A MIR control-flow block is named by a `MirBlockId` (its 1-based index in an
// `IrTable<MirBlock>` the caller owns). This first slice records each block's
// terminator; associating instructions to a block is a later slice. Like the
// instruction layer, blocks are flat records built/read through free functions.

// How a block transfers control at its end.
public enum MirTermKind
{
    // No terminator yet (a freshly created or out-of-range block).
    Unterminated,
    // `return Slot0` — returns the value named by slot 0.
    Return,
    // `branch Slot0` — unconditionally jumps to the block named by slot 0.
    Branch,
    // `if Slot0 then Slot1 else Slot2` — conditional branch on a value to two blocks.
    CondBranch,
}

// A MIR basic block: its terminator kind and up to three operand slots whose meaning
// depends on the kind (a value id or a block id, 0 when unused).
public struct MirBlock
{
    MirTermKind Term;
    u32[0 max] Slot0;
    u32[0 max] Slot1;
    u32[0 max] Slot2;

    MirBlock()
    {
        self.Term = MirTermKind.Unterminated;
        self.Slot0 = 0;
        self.Slot1 = 0;
        self.Slot2 = 0;
    }

    public inline finite law MirTermKind Terminator(borrow MirBlock self)
    {
        return self.Term;
    }

    public inline finite law u32[0 max] Slot0Index(borrow MirBlock self)
    {
        return self.Slot0;
    }

    public inline finite law u32[0 max] Slot1Index(borrow MirBlock self)
    {
        return self.Slot1;
    }

    public inline finite law u32[0 max] Slot2Index(borrow MirBlock self)
    {
        return self.Slot2;
    }
}

// Appends a block terminating in `return value`, returning its id.
public fn MirBlockId MirReturnBlock(mut borrow IrTable<MirBlock> blocks, MirValueId value)
{
    stack mut MirBlock blk = new();
    blk.Term = MirTermKind.Return;
    blk.Slot0 = value.Index();
    return MirBlockIdOf(blocks.Add(blk));
}

// Appends a block unconditionally branching to `target`, returning its id.
public fn MirBlockId MirBranchBlock(mut borrow IrTable<MirBlock> blocks, MirBlockId target)
{
    stack mut MirBlock blk = new();
    blk.Term = MirTermKind.Branch;
    blk.Slot0 = target.Index();
    return MirBlockIdOf(blocks.Add(blk));
}

// Appends a block conditionally branching on `cond` to `thenTarget`/`elseTarget`.
public fn MirBlockId MirCondBlock(mut borrow IrTable<MirBlock> blocks, MirValueId cond, MirBlockId thenTarget, MirBlockId elseTarget)
{
    stack mut MirBlock blk = new();
    blk.Term = MirTermKind.CondBranch;
    blk.Slot0 = cond.Index();
    blk.Slot1 = thenTarget.Index();
    blk.Slot2 = elseTarget.Index();
    return MirBlockIdOf(blocks.Add(blk));
}

// The terminator kind of block `b` (`Unterminated` when out of range).
public fn MirTermKind MirBlockTerminator(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirTermKind.Unterminated;
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return blk.Terminator();
}

// The value returned by a `Return` block (invalid when not a return / out of range).
public fn MirValueId MirBlockReturnValue(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirValueIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirValueIdOf(blk.Slot0Index());
}

// The target of a `Branch` block (invalid when out of range).
public fn MirBlockId MirBlockBranchTarget(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirBlockIdOf(blk.Slot0Index());
}

// The condition value of a `CondBranch` block (invalid when out of range).
public fn MirValueId MirBlockCondValue(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirValueIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirValueIdOf(blk.Slot0Index());
}

// The then-/else-target blocks of a `CondBranch` block (invalid when out of range).
public fn MirBlockId MirBlockCondThen(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirBlockIdOf(blk.Slot1Index());
}

public fn MirBlockId MirBlockCondElse(borrow IrTable<MirBlock> blocks, MirBlockId b)
{
    if (!blocks.Contains(b.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirBlock blk = blocks.Get(b.Index());
    return MirBlockIdOf(blk.Slot2Index());
}

// === Function model ===
// A MIR function is the unit a backend pass lowers. It owns a CONTIGUOUS range of
// blocks in an `IrTable<MirBlock>` and a contiguous range of instructions in an
// `IrTable<MirInstruction>` (both built in order during lowering), and names its
// entry block. Like the rest of the MIR it is a flat record (only raw indices, no
// nested generic field) built/read through free functions over `IrTable<MirFunction>`.

// A MIR function: its entry block plus the half-open block range it owns and the
// half-open instruction range it owns, each as (first 1-based index, count).
public struct MirFunction
{
    u32[0 max] Entry;
    u32[0 max] FirstBlock;
    u32[0 max] BlockCount;
    u32[0 max] FirstInstr;
    u32[0 max] InstrCount;

    MirFunction()
    {
        self.Entry = 0;
        self.FirstBlock = 0;
        self.BlockCount = 0;
        self.FirstInstr = 0;
        self.InstrCount = 0;
    }

    public inline finite law u32[0 max] EntryIndex(borrow MirFunction self)
    {
        return self.Entry;
    }

    public inline finite law u32[0 max] FirstBlockIndex(borrow MirFunction self)
    {
        return self.FirstBlock;
    }

    public inline finite law u32[0 max] OwnedBlockCount(borrow MirFunction self)
    {
        return self.BlockCount;
    }

    public inline finite law u32[0 max] FirstInstrIndex(borrow MirFunction self)
    {
        return self.FirstInstr;
    }

    public inline finite law u32[0 max] OwnedInstrCount(borrow MirFunction self)
    {
        return self.InstrCount;
    }
}

// Records a function owning blocks [firstBlock, firstBlock+blockCount) and
// instructions [firstInstr, firstInstr+instrCount), entered at `entry`.
public fn MirFuncId MirDefineFunction(mut borrow IrTable<MirFunction> funcs, MirBlockId entry, MirBlockId firstBlock, u32[0 max] blockCount, MirValueId firstInstr, u32[0 max] instrCount)
{
    stack mut MirFunction f = new();
    f.Entry = entry.Index();
    f.FirstBlock = firstBlock.Index();
    f.BlockCount = blockCount;
    f.FirstInstr = firstInstr.Index();
    f.InstrCount = instrCount;
    return MirFuncIdOf(funcs.Add(f));
}

// The entry block of function `id` (invalid when out of range).
public fn MirBlockId MirFunctionEntry(borrow IrTable<MirFunction> funcs, MirFuncId id)
{
    if (!funcs.Contains(id.Index()))
    {
        return MirBlockIdOf(0);
    }

    stack MirFunction f = funcs.Get(id.Index());
    return MirBlockIdOf(f.EntryIndex());
}

// The number of blocks function `id` owns (0 when out of range).
public fn u32[0 max] MirFunctionBlockCount(borrow IrTable<MirFunction> funcs, MirFuncId id)
{
    if (!funcs.Contains(id.Index()))
    {
        return 0;
    }

    stack MirFunction f = funcs.Get(id.Index());
    return f.OwnedBlockCount();
}

// The number of instructions function `id` owns (0 when out of range).
public fn u32[0 max] MirFunctionInstrCount(borrow IrTable<MirFunction> funcs, MirFuncId id)
{
    if (!funcs.Contains(id.Index()))
    {
        return 0;
    }

    stack MirFunction f = funcs.Get(id.Index());
    return f.OwnedInstrCount();
}

// True when block `b` falls inside function `id`'s owned block range. The invalid
// id 0 is never owned (even if a malformed function records a 0 range start).
public fn bool MirFunctionOwnsBlock(borrow IrTable<MirFunction> funcs, MirFuncId id, MirBlockId b)
{
    if (!funcs.Contains(id.Index()) || b.Index() == 0)
    {
        return false;
    }

    stack MirFunction f = funcs.Get(id.Index());
    stack u64[0 max] first = (u64[0 max])f.FirstBlockIndex();
    stack u64[0 max] count = (u64[0 max])f.OwnedBlockCount();
    stack u64[0 max] idx = (u64[0 max])b.Index();
    return idx >= first && idx < first + count;
}

// True when instruction `value` falls inside function `id`'s owned instruction range.
// The invalid id 0 is never owned (even if a malformed function records a 0 start).
public fn bool MirFunctionOwnsValue(borrow IrTable<MirFunction> funcs, MirFuncId id, MirValueId value)
{
    if (!funcs.Contains(id.Index()) || value.Index() == 0)
    {
        return false;
    }

    stack MirFunction f = funcs.Get(id.Index());
    stack u64[0 max] first = (u64[0 max])f.FirstInstrIndex();
    stack u64[0 max] count = (u64[0 max])f.OwnedInstrCount();
    stack u64[0 max] idx = (u64[0 max])value.Index();
    return idx >= first && idx < first + count;
}

// === Phase-boundary MIR verification (doc 24, toward #30) ===
// A structural well-formedness check over a function's owned MIR before a later phase (e.g.
// codegen) consumes it: the block/instruction ranges lie within the tables, the entry block
// is one the function owns, every owned instruction's operands name values that EXIST (no
// dangling/out-of-range reference), and every owned block is TERMINATED and names only
// in-range values (a Return / CondBranch condition) and blocks (Branch / CondBranch targets).
// This catches the structural-corruption class (a 0 or out-of-range slot) at a phase
// boundary, independent of the emitter — the kind of invariant a real compiler asserts
// between passes. (Operand 0 is the "unused" sentinel and is allowed; a phi's forward
// back-edge reference is in-range by construction, so the bound is the value table size.)
internal fn bool MirFunctionWellFormed(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow MirFunction func)
{
    stack u32[0 max] instrTotal = (u32[0 max])instrs.Count();
    stack u32[0 max] blockTotal = (u32[0 max])blocks.Count();

    // (1) The block range lies within the block table.
    if (func.OwnedBlockCount() == 0 || func.FirstBlockIndex() == 0 || func.FirstBlockIndex() + func.OwnedBlockCount() - 1 > blockTotal)
    {
        return false;
    }

    // (2) The entry block is one the function owns.
    if (func.EntryIndex() < func.FirstBlockIndex() || func.EntryIndex() > func.FirstBlockIndex() + func.OwnedBlockCount() - 1)
    {
        return false;
    }

    // (3) The instruction range lies within the value table (a function may own none).
    if (func.OwnedInstrCount() > 0 && (func.FirstInstrIndex() == 0 || func.FirstInstrIndex() + func.OwnedInstrCount() - 1 > instrTotal))
    {
        return false;
    }

    // (4) Every owned instruction names existing values (operand 0 = unused is fine).
    stack mut u32[0 max] vi = func.FirstInstrIndex();
    stack mut u32[0 max] viRemaining = func.OwnedInstrCount();
    while willexit (viRemaining > 0)
    {
        stack MirInstruction instr = instrs.Get(vi);
        if (instr.OperandAIndex() > instrTotal || instr.OperandBIndex() > instrTotal || instr.OperandCIndex() > instrTotal || instr.OperandDIndex() > instrTotal)
        {
            return false;
        }

        vi = vi + 1;
        viRemaining = viRemaining - 1;
    }

    // (5) Every owned block is terminated and names in-range values/blocks.
    stack mut u32[0 max] bi = func.FirstBlockIndex();
    stack mut u32[0 max] biRemaining = func.OwnedBlockCount();
    while willexit (biRemaining > 0)
    {
        stack MirBlock blk = blocks.Get(bi);
        switch (blk.Terminator())
        {
            case MirTermKind.Unterminated:
                return false;
            case MirTermKind.Return:
                if (blk.Slot0Index() == 0 || blk.Slot0Index() > instrTotal)
                {
                    return false;
                }
            case MirTermKind.Branch:
                if (blk.Slot0Index() == 0 || blk.Slot0Index() > blockTotal)
                {
                    return false;
                }
            case MirTermKind.CondBranch:
                if (blk.Slot0Index() == 0 || blk.Slot0Index() > instrTotal || blk.Slot1Index() == 0 || blk.Slot1Index() > blockTotal || blk.Slot2Index() == 0 || blk.Slot2Index() > blockTotal)
                {
                    return false;
                }
        }

        bi = bi + 1;
        biRemaining = biRemaining - 1;
    }

    return true;
}

// === LLVM textual IR emission (first backend lowering, step toward #31) ===
// A first lowering of the integer MIR subset to LLVM textual IR. Each MIR value
// `%vN` (N = its 1-based instruction index) becomes a NAMED LLVM SSA register, so
// the output is valid LLVM IR (named locals sidestep LLVM's numbered-value
// consecutiveness rule). `ConstInt` materializes via `add i64 0, imm`. This is text
// generation only; binding to libLLVM for object emission is a later slice. Each
// helper returns `MemoryStatus` and threads append failures sink via `try`.

// Appends the LLVM register name (`%vN`) for the value at 1-based `index`.
internal fn MemoryStatus EmitLlvmRegister(mut borrow OwnedAscii sink, u32[0 max] index)
{
    try sink.AppendConstAscii("%v");
    try sink.AppendU64((u64[0 max])index);
    return MemoryStatus.Ok;
}

// Appends the LLVM reference for an OPERAND value at `valueIndex`: `%pK` when it
// names a Param instruction (K = its 0-based param index), else `%vN`. Operands go
// through this (not `EmitLlvmRegister`) so parameter uses lower to `%pK`.
internal fn MemoryStatus EmitLlvmOperand(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] valueIndex)
{
    if (instrs.Contains(valueIndex))
    {
        stack MirInstruction op = instrs.Get(valueIndex);
        if (op.Opcode() == MirOp.Param)
        {
            try sink.AppendConstAscii("%p");
            try sink.AppendI64(op.Immediate());
            return MemoryStatus.Ok;
        }
    }

    return EmitLlvmRegister(sink, valueIndex);
}

// Appends an LLVM call argument list `(i64 <a>, i64 <b>)` for the up-to-two operand
// slots (0 = absent): `()`, `(i64 <a>)`, or `(i64 <a>, i64 <b>)`. Each argument is a
// value reference (`%vN` or `%pK`).
internal fn MemoryStatus EmitLlvmCallArgs(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] a, u32[0 max] b, u32[0 max] c, u32[0 max] d)
{
    // Arguments are contiguous (a, then b, c, d, with 0 = absent in the trailing slots), so
    // each non-zero slot after the first is preceded by an existing argument — the `, `
    // separator never produces a leading comma.
    try sink.AppendConstAscii("(");
    if (a != 0)
    {
        try sink.AppendConstAscii("i64 ");
        try EmitLlvmOperand(instrs, sink, a);
    }

    if (b != 0)
    {
        try sink.AppendConstAscii(", i64 ");
        try EmitLlvmOperand(instrs, sink, b);
    }

    if (c != 0)
    {
        try sink.AppendConstAscii(", i64 ");
        try EmitLlvmOperand(instrs, sink, c);
    }

    if (d != 0)
    {
        try sink.AppendConstAscii(", i64 ");
        try EmitLlvmOperand(instrs, sink, d);
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

// Appends one LLVM line for a 2-incoming phi:
// `  %vDst = phi i64 [ <a>, %bBlock0 ], [ <b>, %bBlock1 ]`. The incoming values go
// through the param-aware operand path; the block ids are decoded from `packed`.
internal fn MemoryStatus EmitLlvmPhi(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] dst, u32[0 max] a, u32[0 max] b, i64[min max] packed)
{
    try sink.AppendConstAscii("  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(" = phi i64 [ ");
    try EmitLlvmOperand(instrs, sink, a);
    try sink.AppendConstAscii(", ");
    try EmitLlvmBlockRef(sink, DecodePhiBlock0(packed));
    try sink.AppendConstAscii(" ], [ ");
    try EmitLlvmOperand(instrs, sink, b);
    try sink.AppendConstAscii(", ");
    try EmitLlvmBlockRef(sink, DecodePhiBlock1(packed));
    try sink.AppendConstAscii(" ]\n");
    return MemoryStatus.Ok;
}

// Appends one LLVM line for a binary op: `  %vDst = <mnemonic> i64 <a>, <b>`, where
// each operand is a value reference (`%vN` or `%pK`).
internal fn MemoryStatus EmitLlvmBinary(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] dst, const ascii mnemonic, u32[0 max] a, u32[0 max] b)
{
    try sink.AppendConstAscii("  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(" = ");
    try sink.AppendConstAscii(mnemonic);
    try sink.AppendConstAscii(" i64 ");
    try EmitLlvmOperand(instrs, sink, a);
    try sink.AppendConstAscii(", ");
    try EmitLlvmOperand(instrs, sink, b);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

// Appends the LLVM line for the instruction at 1-based `index` in `instrs`. An
// out-of-range index emits nothing (rather than reading past the table — `Get`
// requires `Contains`, and `index - 1` on a 0 index would wrap).
internal fn MemoryStatus EmitLlvmInstruction(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] index)
{
    if (!instrs.Contains(index))
    {
        return MemoryStatus.Ok;
    }

    stack MirInstruction instr = instrs.Get(index);
    switch (instr.Opcode())
    {
        case MirOp.ConstInt:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = add i64 0, ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.Param:
            // Declared in the signature; emits no body line.
            try sink.AppendConstAscii("");
        case MirOp.Add:
            try EmitLlvmBinary(instrs, sink, index, "add", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Sub:
            try EmitLlvmBinary(instrs, sink, index, "sub", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Mul:
            try EmitLlvmBinary(instrs, sink, index, "mul", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SDiv:
            try EmitLlvmBinary(instrs, sink, index, "sdiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.UDiv:
            try EmitLlvmBinary(instrs, sink, index, "udiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SRem:
            try EmitLlvmBinary(instrs, sink, index, "srem", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.And:
            try EmitLlvmBinary(instrs, sink, index, "and", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Or:
            try EmitLlvmBinary(instrs, sink, index, "or", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Xor:
            try EmitLlvmBinary(instrs, sink, index, "xor", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Shl:
            try EmitLlvmBinary(instrs, sink, index, "shl", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.AShr:
            try EmitLlvmBinary(instrs, sink, index, "ashr", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpEq:
            try EmitLlvmBinary(instrs, sink, index, "icmp eq", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpNe:
            try EmitLlvmBinary(instrs, sink, index, "icmp ne", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLt:
            try EmitLlvmBinary(instrs, sink, index, "icmp slt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLe:
            try EmitLlvmBinary(instrs, sink, index, "icmp sle", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGt:
            try EmitLlvmBinary(instrs, sink, index, "icmp sgt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGe:
            try EmitLlvmBinary(instrs, sink, index, "icmp sge", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.ZExt:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = zext i1 ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii(" to i64\n");
        case MirOp.LoadGlobal:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = load i64, ptr @g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.StoreGlobal:
            try sink.AppendConstAscii("  store i64 ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii(", ptr @g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.Phi:
            try EmitLlvmPhi(instrs, sink, index, instr.OperandAIndex(), instr.OperandBIndex(), instr.Immediate());
        case MirOp.Call:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = call i64 @f");
            try sink.AppendI64(instr.Immediate());
            try EmitLlvmCallArgs(instrs, sink, instr.OperandAIndex(), instr.OperandBIndex(), instr.OperandCIndex(), instr.OperandDIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.Return:
            try sink.AppendConstAscii("  ret i64 ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
    }

    return MemoryStatus.Ok;
}

// Emits an LLVM `define i64 @<name>() { entry: ... }` for the instruction range
// [firstInstr, firstInstr+instrCount), in table order, into `sink`.
public fn MemoryStatus EmitLlvmFunction(borrow IrTable<MirInstruction> instrs, const ascii name, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(name);
    try sink.AppendConstAscii("() {\nentry:\n");
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitLlvmInstruction(instrs, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Appends the LLVM block-label reference (`%bN`) for the block at 1-based `index`.
internal fn MemoryStatus EmitLlvmBlockRef(mut borrow OwnedAscii sink, u32[0 max] index)
{
    try sink.AppendConstAscii("%b");
    try sink.AppendU64((u64[0 max])index);
    return MemoryStatus.Ok;
}

// Appends the LLVM terminator line for block `b`: `ret i64 <v>` for a Return,
// `br label %bN` for an unconditional Branch, `br i1 <c>, label %bT, label %bE`
// for a CondBranch, or `unreachable` for an unterminated/out-of-range block. The
// returned value and the condition are value operands, so they go through
// `EmitLlvmOperand` (a `%pK` parameter or a `%vN` instruction result) — `instrs` is
// threaded in for that lookup. (The CondBranch condition is still typed `i1` though
// the modeled subset only produces `i64` values; a real `icmp` lowering is a later
// slice.)
public fn MemoryStatus EmitLlvmTerminator(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, MirBlockId b, mut borrow OwnedAscii sink)
{
    if (!blocks.Contains(b.Index()))
    {
        try sink.AppendConstAscii("  unreachable\n");
        return MemoryStatus.Ok;
    }

    stack MirBlock blk = blocks.Get(b.Index());
    switch (blk.Terminator())
    {
        case MirTermKind.Return:
            try sink.AppendConstAscii("  ret i64 ");
            try EmitLlvmOperand(instrs, sink, blk.Slot0Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.Branch:
            try sink.AppendConstAscii("  br label ");
            try EmitLlvmBlockRef(sink, blk.Slot0Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.CondBranch:
            try sink.AppendConstAscii("  br i1 ");
            try EmitLlvmOperand(instrs, sink, blk.Slot0Index());
            try sink.AppendConstAscii(", label ");
            try EmitLlvmBlockRef(sink, blk.Slot1Index());
            try sink.AppendConstAscii(", label ");
            try EmitLlvmBlockRef(sink, blk.Slot2Index());
            try sink.AppendConstAscii("\n");
        case MirTermKind.Unterminated:
            try sink.AppendConstAscii("  unreachable\n");
    }

    return MemoryStatus.Ok;
}

// === Whole-function LLVM emission ===
// Stitches the instruction and control-flow layers into a complete LLVM function.
// A block owns a CONTIGUOUS instruction range [firstInstr, firstInstr+instrCount)
// (the caller tracks the per-block split, since the flat model stores instructions
// in one table); each block emits as `bN:` + its body instructions + its terminator.

// Emits one labelled LLVM block: `bN:` then the instructions
// [firstInstr, firstInstr+instrCount) then block N's terminator.
public fn MemoryStatus EmitLlvmLabeledBlock(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, u32[0 max] blockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("b");
    try sink.AppendU64((u64[0 max])blockIndex);
    try sink.AppendConstAscii(":\n");
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitLlvmInstruction(instrs, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    try EmitLlvmTerminator(instrs, blocks, MirBlockIdOf(blockIndex), sink);
    return MemoryStatus.Ok;
}

// Emits a complete single-block LLVM function: `define i64 @name() { ... }` whose
// body is the entry block (its instruction range + its terminator).
public fn MemoryStatus EmitLlvmDefinition(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] entryBlockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(name);
    try sink.AppendConstAscii("() {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Appends an LLVM parameter list `(i64 %p0, i64 %p1, …)` for `paramCount` params
// (just `()` when zero).
internal fn MemoryStatus EmitLlvmParamList(u32[0 max] paramCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("(");
    stack mut u32[0 max] i = 0;
    while willexit (i < paramCount)
    {
        if (i > 0)
        {
            try sink.AppendConstAscii(", ");
        }

        try sink.AppendConstAscii("i64 %p");
        try sink.AppendU64((u64[0 max])i);
        i = i + 1;
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

// Emits a single-block LLVM function with a parameter list: `define i64
// @name(i64 %p0, …) { <entry block> }`. Body uses of `MirParam` values lower to
// `%pK`, including a parameter returned directly by the block terminator (which
// goes through the param-aware operand path). CONTRACT: the `MirParam` indices used
// in the body must be a dense `0..paramCount-1` prefix matching the declared
// signature — the signature is numbered independently `%p0..%p(paramCount-1)`, so a
// non-dense index (e.g. `MirParam(instrs, 5)` with `paramCount = 2`) would reference
// an undeclared `%p5`.
public fn MemoryStatus EmitLlvmDefinitionWithParams(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] paramCount, u32[0 max] entryBlockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(name);
    try EmitLlvmParamList(paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Emits a multi-block diamond-CFG function `define i64 @name(...) { … }`: an entry
// block (ending in a conditional branch to the then/else blocks), then/else blocks
// (each over its own instruction range — the branch-arm computation — ending in an
// unconditional branch to the merge block), and a merge block (its instruction range,
// typically a phi, ending in a return). Each block emits over the (first, count)
// instruction range it is given. Real branching control flow with a phi merge, built
// by composing `EmitLlvmLabeledBlock`; the block terminators come from `blocks`.
// One block's emission descriptor: which block, and the contiguous instruction range
// (1-based first index + count) it owns. A sequence of these is a whole function body
// for an arbitrary CFG shape (diamond, loop, nested-if, switch, …).
public struct BlockEmit
{
    u32[0 max] BlockIndex;
    u32[0 max] First;
    u32[0 max] Count;

    BlockEmit()
    {
        self.BlockIndex = 0;
        self.First = 0;
        self.Count = 0;
    }
}

// Builds a `BlockEmit` descriptor.
internal fn BlockEmit MakeBlockEmit(u32[0 max] blockIndex, u32[0 max] first, u32[0 max] count)
{
    stack mut BlockEmit be = new();
    be.BlockIndex = blockIndex;
    be.First = first;
    be.Count = count;
    return be;
}

// Emits `define i64 @name(<params>) { <block>* }` over an arbitrary ordered list of
// blocks — the general form behind `EmitLlvmDiamond` (4 blocks) and the loop/nested-if
// shapes (any number). Each descriptor's terminator comes from the block table, so any
// CFG (branches, back-edges, multi-way merges) emits as long as the blocks carry the
// right terminators and the descriptors list them in the desired output order.
public fn MemoryStatus EmitLlvmBlocks(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] paramCount, borrow IrTable<BlockEmit> ranges, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(name);
    try EmitLlvmParamList(paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        try EmitLlvmLabeledBlock(instrs, blocks, ranges.Get(i).BlockIndex, ranges.Get(i).First, ranges.Get(i).Count, sink);
        i = i + 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Like `EmitLlvmBlocks` but emits a NUMBERED function name `@<prefix><number>` (e.g. `@f3`)
// instead of a fixed name — the multi-block counterpart of `EmitLlvmNumberedFunction`, so a
// module function (`@fN`) can have an arbitrary block list (a branch, a loop), not just one
// block.
public fn MemoryStatus EmitLlvmBlocksNumbered(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii prefix, u32[0 max] number, u32[0 max] paramCount, borrow IrTable<BlockEmit> ranges, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(prefix);
    try sink.AppendU64((u64[0 max])number);
    try EmitLlvmParamList(paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        try EmitLlvmLabeledBlock(instrs, blocks, ranges.Get(i).BlockIndex, ranges.Get(i).First, ranges.Get(i).Count, sink);
        i = i + 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmDiamond(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii name, u32[0 max] paramCount, u32[0 max] entryBlock, u32[0 max] entryFirst, u32[0 max] entryCount, u32[0 max] thenBlock, u32[0 max] thenFirst, u32[0 max] thenCount, u32[0 max] elseBlock, u32[0 max] elseFirst, u32[0 max] elseCount, u32[0 max] mergeBlock, u32[0 max] mergeFirst, u32[0 max] mergeCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(name);
    try EmitLlvmParamList(paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlock, entryFirst, entryCount, sink);
    try EmitLlvmLabeledBlock(instrs, blocks, thenBlock, thenFirst, thenCount, sink);
    try EmitLlvmLabeledBlock(instrs, blocks, elseBlock, elseFirst, elseCount, sink);
    try EmitLlvmLabeledBlock(instrs, blocks, mergeBlock, mergeFirst, mergeCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// === Module emission ===
// Emits a whole LLVM module: one `define` per function in the function table,
// named `@fN` (N = the function's 1-based id). PRECONDITION: each function is
// single-block — only its entry block is emitted (over the whole instruction range),
// and `OwnedBlockCount` is NOT consulted, so a function recorded with more than one
// block would silently drop its non-entry blocks. Multi-block-per-function emission
// (iterating the owned block range, each block over its own instruction sub-range)
// is a later slice once the model records per-block instruction ranges; it reuses
// `EmitLlvmLabeledBlock`.

// Emits `define i64 @<prefix><number>() { <entry block> }`.
internal fn MemoryStatus EmitLlvmDefinitionNumbered(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii prefix, u32[0 max] number, u32[0 max] entryBlockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(prefix);
    try sink.AppendU64((u64[0 max])number);
    try sink.AppendConstAscii("() {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Emits an LLVM module: one `define i64 @fN() { … }` per function in `funcs`, in id
// order, each a single-block definition over its entry block. An empty table emits
// nothing.
public fn MemoryStatus EmitLlvmModule(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction f = funcs.Get(id);
        try EmitLlvmDefinitionNumbered(instrs, blocks, "f", id, f.EntryIndex(), f.FirstInstrIndex(), f.OwnedInstrCount(), sink);
        id = id + 1;
    }

    return MemoryStatus.Ok;
}

// Verify-then-emit: a phase-boundary gate that runs `MirFunctionWellFormed` over EVERY
// function in the module and emits the LLVM ONLY if all are structurally well-formed. A
// malformed function (a dangling reference, an unterminated block) is rejected before any
// output, so the back end never emits corrupt IR. Returns false on a malformed module OR an
// emit failure; true on a clean emit — the canonical "validate at the phase boundary, then
// lower" shape for the MIR-function-table codegen path.
public fn bool EmitLlvmModuleVerified(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction f = funcs.Get(id);
        if (!MirFunctionWellFormed(instrs, blocks, f))
        {
            return false;
        }

        id = id + 1;
    }

    switch (EmitLlvmModule(instrs, blocks, funcs, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

// === Module-level globals ===
// A module global variable with an integer initializer, named `@gN` (N = its 1-based
// id in an `IrTable<MirGlobal>`). Flat record + free functions, like the rest of MIR.

public struct MirGlobal
{
    i64[min max] Init;

    MirGlobal()
    {
        self.Init = 0;
    }

    public inline finite law i64[min max] InitialValue(borrow MirGlobal self)
    {
        return self.Init;
    }
}

// Records a global with integer initializer `value`, returning its 1-based id.
public fn u32[0 max] MirDefineGlobal(mut borrow IrTable<MirGlobal> globals, i64[min max] value)
{
    stack mut MirGlobal g = new();
    g.Init = value;
    return globals.Add(g);
}

// The initializer of global `id` (0 when out of range).
public fn i64[min max] MirGlobalInitialValue(borrow IrTable<MirGlobal> globals, u32[0 max] id)
{
    if (!globals.Contains(id))
    {
        return 0;
    }

    stack MirGlobal g = globals.Get(id);
    return g.InitialValue();
}

// Emits one `@gN = global i64 V` line per global in id order (empty table → nothing).
public fn MemoryStatus EmitLlvmGlobals(borrow IrTable<MirGlobal> globals, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = globals.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirGlobal g = globals.Get(id);
        try sink.AppendConstAscii("@g");
        try sink.AppendU64((u64[0 max])id);
        try sink.AppendConstAscii(" = global i64 ");
        try sink.AppendI64(g.InitialValue());
        try sink.AppendConstAscii("\n");
        id = id + 1;
    }

    return MemoryStatus.Ok;
}

// Emits a complete module: globals first, then function definitions.
public fn MemoryStatus EmitLlvmModuleWithGlobals(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, borrow IrTable<MirGlobal> globals, mut borrow OwnedAscii sink)
{
    try EmitLlvmGlobals(globals, sink);
    try EmitLlvmModule(instrs, blocks, funcs, sink);
    return MemoryStatus.Ok;
}

// === Typed function emission (types beyond i64) ===
// A parallel straight-line emitter that spells each value's `MirType` instead of the
// hardcoded `i64` of the untyped emitters. The function's return type is derived from
// the trailing `Return` instruction's value, so a uniform-typed (e.g. i32) function
// emits its type throughout. Untyped instructions default to `I64`, so this path
// reproduces the i64 output for default values. Handles the const/arith/return subset.

// Appends an LLVM integer type name (`i1`/`i32`/`i64`).
internal fn MemoryStatus EmitLlvmTypeName(MirType t, mut borrow OwnedAscii sink)
{
    switch (t)
    {
        case MirType.I1:
            try sink.AppendConstAscii("i1");
        case MirType.I32:
            try sink.AppendConstAscii("i32");
        case MirType.I64:
            try sink.AppendConstAscii("i64");
    }

    return MemoryStatus.Ok;
}

// `  %vDst = <mnemonic> <type> <a>, <b>`, spelling `type` instead of a fixed `i64`.
internal fn MemoryStatus EmitLlvmTypedBinary(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] dst, const ascii mnemonic, MirType t, u32[0 max] a, u32[0 max] b)
{
    try sink.AppendConstAscii("  ");
    try EmitLlvmRegister(sink, dst);
    try sink.AppendConstAscii(" = ");
    try sink.AppendConstAscii(mnemonic);
    try sink.AppendConstAscii(" ");
    try EmitLlvmTypeName(t, sink);
    try sink.AppendConstAscii(" ");
    try EmitLlvmOperand(instrs, sink, a);
    try sink.AppendConstAscii(", ");
    try EmitLlvmOperand(instrs, sink, b);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

// Emits the typed LLVM line for the instruction at `index` (const/arith/return subset;
// other opcodes emit nothing in this first typed path).
internal fn MemoryStatus EmitLlvmTypedInstruction(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] index)
{
    if (!instrs.Contains(index))
    {
        return MemoryStatus.Ok;
    }

    stack MirInstruction instr = instrs.Get(index);
    switch (instr.Opcode())
    {
        case MirOp.ConstInt:
            try sink.AppendConstAscii("  ");
            try EmitLlvmRegister(sink, index);
            try sink.AppendConstAscii(" = add ");
            try EmitLlvmTypeName(instr.ResultType(), sink);
            try sink.AppendConstAscii(" 0, ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.Add:
            try EmitLlvmTypedBinary(instrs, sink, index, "add", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Sub:
            try EmitLlvmTypedBinary(instrs, sink, index, "sub", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Mul:
            try EmitLlvmTypedBinary(instrs, sink, index, "mul", instr.ResultType(), instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Return:
            try sink.AppendConstAscii("  ret ");
            try EmitLlvmTypeName(MirValueType(instrs, instr.OperandAIndex()), sink);
            try sink.AppendConstAscii(" ");
            try EmitLlvmOperand(instrs, sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
        default:
            try sink.AppendConstAscii("");
    }

    return MemoryStatus.Ok;
}

// The return type of a typed function: the type of the value returned by its trailing
// `Return` instruction (`I64` if absent / out of range).
internal fn MirType TypedFunctionReturnType(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    if (instrCount == 0)
    {
        return MirType.I64;
    }

    stack u32[0 max] lastIndex = firstInstr + instrCount - 1;
    if (!instrs.Contains(lastIndex))
    {
        return MirType.I64;
    }

    stack MirInstruction last = instrs.Get(lastIndex);
    if (last.Opcode() != MirOp.Return)
    {
        return MirType.I64;
    }

    return MirValueType(instrs, last.OperandAIndex());
}

// Emits `define <retType> @name() { entry: <typed instructions> }` for the
// instruction range [firstInstr, firstInstr+instrCount), spelling each value's type.
public fn MemoryStatus EmitLlvmTypedFunction(borrow IrTable<MirInstruction> instrs, const ascii name, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define ");
    try EmitLlvmTypeName(TypedFunctionReturnType(instrs, firstInstr, instrCount), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(name);
    try sink.AppendConstAscii("() {\nentry:\n");
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitLlvmTypedInstruction(instrs, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// === MIR text disassembler ===
// A readable dump of the MIR instruction stream (the textual core of an `inspect`
// tool). MIR operands are spelled `vN` (the raw value id) uniformly — the LLVM
// `%pK` parameter distinction is an LLVM-emission concern, not a MIR-level one.

// Appends a MIR value reference `vN`.
internal fn MemoryStatus EmitMirValue(mut borrow OwnedAscii sink, u32[0 max] index)
{
    try sink.AppendConstAscii("v");
    try sink.AppendU64((u64[0 max])index);
    return MemoryStatus.Ok;
}

// Appends `  vDst = <mnemonic> vA, vB` for a binary op / comparison.
internal fn MemoryStatus EmitMirBinaryLine(mut borrow OwnedAscii sink, u32[0 max] dst, const ascii mnemonic, u32[0 max] a, u32[0 max] b)
{
    try EmitMirValue(sink, dst);
    try sink.AppendConstAscii(" = ");
    try sink.AppendConstAscii(mnemonic);
    try sink.AppendConstAscii(" ");
    try EmitMirValue(sink, a);
    try sink.AppendConstAscii(", ");
    try EmitMirValue(sink, b);
    try sink.AppendConstAscii("\n");
    return MemoryStatus.Ok;
}

// Appends the MIR text line for the instruction at 1-based `index`.
internal fn MemoryStatus EmitMirInstruction(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] index)
{
    if (!instrs.Contains(index))
    {
        return MemoryStatus.Ok;
    }

    stack MirInstruction instr = instrs.Get(index);
    switch (instr.Opcode())
    {
        case MirOp.ConstInt:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = const ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.Param:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = param ");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.Add:
            try EmitMirBinaryLine(sink, index, "add", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Sub:
            try EmitMirBinaryLine(sink, index, "sub", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Mul:
            try EmitMirBinaryLine(sink, index, "mul", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SDiv:
            try EmitMirBinaryLine(sink, index, "sdiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.UDiv:
            try EmitMirBinaryLine(sink, index, "udiv", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.SRem:
            try EmitMirBinaryLine(sink, index, "srem", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.And:
            try EmitMirBinaryLine(sink, index, "and", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Or:
            try EmitMirBinaryLine(sink, index, "or", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Xor:
            try EmitMirBinaryLine(sink, index, "xor", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.Shl:
            try EmitMirBinaryLine(sink, index, "shl", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.AShr:
            try EmitMirBinaryLine(sink, index, "ashr", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpEq:
            try EmitMirBinaryLine(sink, index, "eq", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpNe:
            try EmitMirBinaryLine(sink, index, "ne", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLt:
            try EmitMirBinaryLine(sink, index, "slt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpLe:
            try EmitMirBinaryLine(sink, index, "sle", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGt:
            try EmitMirBinaryLine(sink, index, "sgt", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.CmpGe:
            try EmitMirBinaryLine(sink, index, "sge", instr.OperandAIndex(), instr.OperandBIndex());
        case MirOp.ZExt:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = zext ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.LoadGlobal:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = load g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii("\n");
        case MirOp.StoreGlobal:
            try sink.AppendConstAscii("store g");
            try sink.AppendI64(instr.Immediate());
            try sink.AppendConstAscii(", ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.Phi:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = phi ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii("@b");
            try sink.AppendU64((u64[0 max])DecodePhiBlock0(instr.Immediate()));
            try sink.AppendConstAscii(", ");
            try EmitMirValue(sink, instr.OperandBIndex());
            try sink.AppendConstAscii("@b");
            try sink.AppendU64((u64[0 max])DecodePhiBlock1(instr.Immediate()));
            try sink.AppendConstAscii("\n");
        case MirOp.Call:
            try EmitMirValue(sink, index);
            try sink.AppendConstAscii(" = call f");
            try sink.AppendI64(instr.Immediate());
            try EmitMirCallArgs(instrs, sink, instr.OperandAIndex(), instr.OperandBIndex(), instr.OperandCIndex(), instr.OperandDIndex());
            try sink.AppendConstAscii("\n");
        case MirOp.Return:
            try sink.AppendConstAscii("ret ");
            try EmitMirValue(sink, instr.OperandAIndex());
            try sink.AppendConstAscii("\n");
    }

    return MemoryStatus.Ok;
}

// Appends a MIR call argument list `(vA, vB)` for the up-to-two operand slots.
internal fn MemoryStatus EmitMirCallArgs(borrow IrTable<MirInstruction> instrs, mut borrow OwnedAscii sink, u32[0 max] a, u32[0 max] b, u32[0 max] c, u32[0 max] d)
{
    try sink.AppendConstAscii("(");
    if (a != 0)
    {
        try EmitMirValue(sink, a);
    }

    if (b != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitMirValue(sink, b);
    }

    if (c != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitMirValue(sink, c);
    }

    if (d != 0)
    {
        try sink.AppendConstAscii(", ");
        try EmitMirValue(sink, d);
    }

    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

// Dumps the MIR text for the instruction range [firstInstr, firstInstr+instrCount).
public fn MemoryStatus EmitMirInstructions(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        try EmitMirInstruction(instrs, sink, index);
        index = index + 1;
        remaining = remaining - 1;
    }

    return MemoryStatus.Ok;
}

// === Binary serialization primitives (toward package images, #32) ===
// A byte buffer is an `IrTable<u8[0 max]>` (1-based, append-only). Integers are
// encoded little-endian via div/mod (no bitwise); a signed i64 is encoded through its
// two's-complement bit pattern (`(u64)value`), which Stark's modular casts recover.

// Appends `value` as 4 little-endian bytes.
public fn void WriteU32(mut borrow IrTable<u8[0 max]> buf, u32[0 max] value)
{
    stack u32[0 max] a0 = buf.Add((u8[0 max])(value % 256));
    stack u32[0 max] a1 = buf.Add((u8[0 max])((value / 256) % 256));
    stack u32[0 max] a2 = buf.Add((u8[0 max])((value / 65536) % 256));
    stack u32[0 max] a3 = buf.Add((u8[0 max])((value / 16777216) % 256));
}

// Reads a 4-byte little-endian u32 starting at the 1-based byte index `at`.
public fn u32[0 max] ReadU32(borrow IrTable<u8[0 max]> buf, u32[0 max] at)
{
    stack u8[0 max] b0 = buf.Get(at);
    stack u8[0 max] b1 = buf.Get(at + 1);
    stack u8[0 max] b2 = buf.Get(at + 2);
    stack u8[0 max] b3 = buf.Get(at + 3);
    return (u32[0 max])b0
        + (u32[0 max])b1 * 256
        + (u32[0 max])b2 * 65536
        + (u32[0 max])b3 * 16777216;
}

// Appends `value` as 8 little-endian bytes (two's-complement for negatives).
public fn void WriteI64(mut borrow IrTable<u8[0 max]> buf, i64[min max] value)
{
    stack mut u64[0 max] rem = (u64[0 max])value;
    stack mut u32[0 max] i = 0;
    while willexit (i < 8)
    {
        stack u32[0 max] w = buf.Add((u8[0 max])(rem % 256));
        rem = rem / 256;
        i = i + 1;
    }
}

// Reads an 8-byte little-endian i64 starting at the 1-based byte index `at`.
public fn i64[min max] ReadI64(borrow IrTable<u8[0 max]> buf, u32[0 max] at)
{
    stack mut u64[0 max] acc = 0;
    stack mut u64[0 max] mul = 1;
    stack mut u32[0 max] i = 0;
    while willexit (i < 8)
    {
        stack u8[0 max] byte = buf.Get(at + i);
        acc = acc + (u64[0 max])byte * mul;
        mul = mul * 256;
        i = i + 1;
    }

    return (i64[min max])acc;
}

// === MIR instruction serialization (toward binary package images, #32) ===
// A serialized instruction is a fixed 26-byte record: opcode (1) + result type (1) +
// operands A/B/C/D (4 LE each) + immediate (8 LE). An instruction stream is a u32 count
// followed by that many records. Round-trips through the byte buffer above — INCLUDING a
// call's third/fourth arguments (the C/D operand slots), so a 3-or-4-argument call survives
// a package-image round-trip intact.

// Opcode <-> byte (explicit both ways; no reliance on enum-ordinal casts).
internal fn u8[0 max] MirOpToByte(MirOp op)
{
    switch (op)
    {
        case MirOp.ConstInt: return 0;
        case MirOp.Param: return 1;
        case MirOp.Add: return 2;
        case MirOp.Sub: return 3;
        case MirOp.Mul: return 4;
        case MirOp.SDiv: return 5;
        case MirOp.UDiv: return 6;
        case MirOp.SRem: return 7;
        case MirOp.And: return 8;
        case MirOp.Or: return 9;
        case MirOp.Xor: return 10;
        case MirOp.Shl: return 11;
        case MirOp.AShr: return 12;
        case MirOp.CmpEq: return 13;
        case MirOp.CmpNe: return 14;
        case MirOp.CmpLt: return 15;
        case MirOp.CmpLe: return 16;
        case MirOp.CmpGt: return 17;
        case MirOp.CmpGe: return 18;
        case MirOp.LoadGlobal: return 19;
        case MirOp.StoreGlobal: return 20;
        case MirOp.Phi: return 21;
        case MirOp.Call: return 22;
        case MirOp.Return: return 23;
        case MirOp.ZExt: return 24;
    }
}

internal fn MirOp MirOpFromByte(u8[0 max] b)
{
    switch (b)
    {
        case 1: return MirOp.Param;
        case 2: return MirOp.Add;
        case 3: return MirOp.Sub;
        case 4: return MirOp.Mul;
        case 5: return MirOp.SDiv;
        case 6: return MirOp.UDiv;
        case 7: return MirOp.SRem;
        case 8: return MirOp.And;
        case 9: return MirOp.Or;
        case 10: return MirOp.Xor;
        case 11: return MirOp.Shl;
        case 12: return MirOp.AShr;
        case 13: return MirOp.CmpEq;
        case 14: return MirOp.CmpNe;
        case 15: return MirOp.CmpLt;
        case 16: return MirOp.CmpLe;
        case 17: return MirOp.CmpGt;
        case 18: return MirOp.CmpGe;
        case 19: return MirOp.LoadGlobal;
        case 20: return MirOp.StoreGlobal;
        case 21: return MirOp.Phi;
        case 22: return MirOp.Call;
        case 23: return MirOp.Return;
        case 24: return MirOp.ZExt;
        default: return MirOp.ConstInt;
    }
}

internal fn u8[0 max] MirTypeToByte(MirType t)
{
    switch (t)
    {
        case MirType.I1: return 0;
        case MirType.I32: return 1;
        case MirType.I64: return 2;
    }
}

internal fn MirType MirTypeFromByte(u8[0 max] b)
{
    switch (b)
    {
        case 0: return MirType.I1;
        case 1: return MirType.I32;
        default: return MirType.I64;
    }
}

// Serializes the instruction range [firstInstr, firstInstr+instrCount) into `buf`:
// a u32 count followed by one 18-byte record per instruction.
public fn void SerializeInstructions(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow IrTable<u8[0 max]> buf)
{
    WriteU32(buf, instrCount);
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            stack u32[0 max] wOp = buf.Add(MirOpToByte(instr.Opcode()));
            stack u32[0 max] wType = buf.Add(MirTypeToByte(instr.ResultType()));
            WriteU32(buf, instr.OperandAIndex());
            WriteU32(buf, instr.OperandBIndex());
            WriteU32(buf, instr.OperandCIndex());
            WriteU32(buf, instr.OperandDIndex());
            WriteI64(buf, instr.Immediate());
        }

        index = index + 1;
        remaining = remaining - 1;
    }
}

// Deserializes a stream written by `SerializeInstructions` into `outInstrs`,
// reconstructing each instruction (opcode, result type, operands, immediate).
public fn void DeserializeInstructions(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirInstruction> outInstrs)
{
    DeserializeInstructionsAt(buf, 1, outInstrs);
}

// As `DeserializeInstructions` but the section begins at the 1-based byte
// `startOffset` (for combined package images with several sections).
public fn void DeserializeInstructionsAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow IrTable<MirInstruction> outInstrs)
{
    stack u32[0 max] count = ReadU32(buf, startOffset);
    stack mut u32[0 max] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] recordBase = startOffset + 4 + i * 26;
        stack u8[0 max] opByte = buf.Get(recordBase);
        stack u8[0 max] typeByte = buf.Get(recordBase + 1);
        stack u32[0 max] a = ReadU32(buf, recordBase + 2);
        stack u32[0 max] b = ReadU32(buf, recordBase + 6);
        stack u32[0 max] c = ReadU32(buf, recordBase + 10);
        stack u32[0 max] d = ReadU32(buf, recordBase + 14);
        stack i64[min max] imm = ReadI64(buf, recordBase + 18);
        stack mut MirInstruction instr = new();
        instr.Op = MirOpFromByte(opByte);
        instr.ResType = MirTypeFromByte(typeByte);
        instr.AIndex = a;
        instr.BIndex = b;
        instr.CIndex = c;
        instr.DIndex = d;
        instr.Imm = imm;
        stack u32[0 max] added = outInstrs.Add(instr);
        i = i + 1;
    }
}

// === Block / function / global serialization (toward a full package image, #32) ===
// Each is a fixed-record stream like the instruction stream: a u32 count followed by
// fixed-size records. (Each section serializes into its own buffer; a combined
// multi-section image with a section directory is a later slice.)

internal fn u8[0 max] MirTermToByte(MirTermKind t)
{
    switch (t)
    {
        case MirTermKind.Unterminated: return 0;
        case MirTermKind.Return: return 1;
        case MirTermKind.Branch: return 2;
        case MirTermKind.CondBranch: return 3;
    }
}

internal fn MirTermKind MirTermFromByte(u8[0 max] b)
{
    switch (b)
    {
        case 1: return MirTermKind.Return;
        case 2: return MirTermKind.Branch;
        case 3: return MirTermKind.CondBranch;
        default: return MirTermKind.Unterminated;
    }
}

// Adds a block from raw fields (used when reconstructing from a serialized stream).
internal fn MirBlockId MirAddBlockRaw(mut borrow IrTable<MirBlock> blocks, MirTermKind term, u32[0 max] slot0, u32[0 max] slot1, u32[0 max] slot2)
{
    stack mut MirBlock blk = new();
    blk.Term = term;
    blk.Slot0 = slot0;
    blk.Slot1 = slot1;
    blk.Slot2 = slot2;
    return MirBlockIdOf(blocks.Add(blk));
}

// Blocks: u32 count + 13-byte records (term byte + 3 u32 slots).
public fn void SerializeBlocks(borrow IrTable<MirBlock> blocks, mut borrow IrTable<u8[0 max]> buf)
{
    stack u64[0 2 ** 63 - 1] count = blocks.Count();
    WriteU32(buf, (u32[0 max])count);
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirBlock blk = blocks.Get(id);
        stack u32[0 max] w = buf.Add(MirTermToByte(blk.Terminator()));
        WriteU32(buf, blk.Slot0Index());
        WriteU32(buf, blk.Slot1Index());
        WriteU32(buf, blk.Slot2Index());
        id = id + 1;
    }
}

public fn void DeserializeBlocks(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirBlock> outBlocks)
{
    DeserializeBlocksAt(buf, 1, outBlocks);
}

public fn void DeserializeBlocksAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow IrTable<MirBlock> outBlocks)
{
    stack u32[0 max] count = ReadU32(buf, startOffset);
    stack mut u32[0 max] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] recordBase = startOffset + 4 + i * 13;
        stack u8[0 max] termByte = buf.Get(recordBase);
        stack u32[0 max] s0 = ReadU32(buf, recordBase + 1);
        stack u32[0 max] s1 = ReadU32(buf, recordBase + 5);
        stack u32[0 max] s2 = ReadU32(buf, recordBase + 9);
        stack MirBlockId v = MirAddBlockRaw(outBlocks, MirTermFromByte(termByte), s0, s1, s2);
        i = i + 1;
    }
}

// Functions: u32 count + 20-byte records (entry, firstBlock, blockCount, firstInstr,
// instrCount — five u32s).
public fn void SerializeFunctions(borrow IrTable<MirFunction> funcs, mut borrow IrTable<u8[0 max]> buf)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    WriteU32(buf, (u32[0 max])count);
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction f = funcs.Get(id);
        WriteU32(buf, f.EntryIndex());
        WriteU32(buf, f.FirstBlockIndex());
        WriteU32(buf, f.OwnedBlockCount());
        WriteU32(buf, f.FirstInstrIndex());
        WriteU32(buf, f.OwnedInstrCount());
        id = id + 1;
    }
}

public fn void DeserializeFunctions(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirFunction> outFuncs)
{
    DeserializeFunctionsAt(buf, 1, outFuncs);
}

public fn void DeserializeFunctionsAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow IrTable<MirFunction> outFuncs)
{
    stack u32[0 max] count = ReadU32(buf, startOffset);
    stack mut u32[0 max] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] recordBase = startOffset + 4 + i * 20;
        stack u32[0 max] entry = ReadU32(buf, recordBase);
        stack u32[0 max] firstBlock = ReadU32(buf, recordBase + 4);
        stack u32[0 max] blockCount = ReadU32(buf, recordBase + 8);
        stack u32[0 max] firstInstr = ReadU32(buf, recordBase + 12);
        stack u32[0 max] instrCount = ReadU32(buf, recordBase + 16);
        stack MirFuncId v = MirDefineFunction(outFuncs, MirBlockIdOf(entry), MirBlockIdOf(firstBlock), blockCount, MirValueIdOf(firstInstr), instrCount);
        i = i + 1;
    }
}

// Globals: u32 count + 8-byte records (i64 initializer).
public fn void SerializeGlobals(borrow IrTable<MirGlobal> globals, mut borrow IrTable<u8[0 max]> buf)
{
    stack u64[0 2 ** 63 - 1] count = globals.Count();
    WriteU32(buf, (u32[0 max])count);
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirGlobal g = globals.Get(id);
        WriteI64(buf, g.InitialValue());
        id = id + 1;
    }
}

public fn void DeserializeGlobals(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirGlobal> outGlobals)
{
    DeserializeGlobalsAt(buf, 1, outGlobals);
}

public fn void DeserializeGlobalsAt(borrow IrTable<u8[0 max]> buf, u32[0 max] startOffset, mut borrow IrTable<MirGlobal> outGlobals)
{
    stack u32[0 max] count = ReadU32(buf, startOffset);
    stack mut u32[0 max] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] recordBase = startOffset + 4 + i * 8;
        stack i64[min max] initValue = ReadI64(buf, recordBase);
        stack u32[0 max] v = MirDefineGlobal(outGlobals, initValue);
        i = i + 1;
    }
}

// === Combined package image (#32) ===
// A package image concatenates the four section streams behind a fixed 20-byte
// header: a magic u32 then the 1-based byte offset of each section
// (instructions, blocks, functions, globals). Sections therefore start at byte 21.
// `InspectPackageImage` reads only the header + per-section counts (an `inspect-pkg`
// summary) without materializing the IR.

// The magic identifying a MIR package image ("MIR1" little-endian-ish constant).
internal fn u32[0 max] MirImageMagic()
{
    return 826757197;
}

// Appends every byte of `src` to `dst`.
internal fn void AppendBytes(mut borrow IrTable<u8[0 max]> dst, borrow IrTable<u8[0 max]> src)
{
    stack u64[0 2 ** 63 - 1] count = src.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack u8[0 max] b = src.Get(i);
        stack u32[0 max] w = dst.Add(b);
        i = i + 1;
    }
}

// Serializes a whole MIR module (instructions/blocks/functions/globals) into one
// package image in `buf`.
public fn void SerializePackageImage(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, borrow IrTable<MirGlobal> globals, mut borrow IrTable<u8[0 max]> buf)
{
    stack mut IrTable<u8[0 max]> instrBuf = new();
    SerializeInstructions(instrs, 1, (u32[0 max])instrs.Count(), instrBuf);
    stack mut IrTable<u8[0 max]> blockBuf = new();
    SerializeBlocks(blocks, blockBuf);
    stack mut IrTable<u8[0 max]> funcBuf = new();
    SerializeFunctions(funcs, funcBuf);
    stack mut IrTable<u8[0 max]> globalBuf = new();
    SerializeGlobals(globals, globalBuf);

    // Header is 20 bytes (magic + 4 offsets), so the first section starts at byte 21.
    stack u32[0 max] instrOffset = 21;
    stack u32[0 max] blockOffset = instrOffset + (u32[0 max])instrBuf.Count();
    stack u32[0 max] funcOffset = blockOffset + (u32[0 max])blockBuf.Count();
    stack u32[0 max] globalOffset = funcOffset + (u32[0 max])funcBuf.Count();

    WriteU32(buf, MirImageMagic());
    WriteU32(buf, instrOffset);
    WriteU32(buf, blockOffset);
    WriteU32(buf, funcOffset);
    WriteU32(buf, globalOffset);
    AppendBytes(buf, instrBuf);
    AppendBytes(buf, blockBuf);
    AppendBytes(buf, funcBuf);
    AppendBytes(buf, globalBuf);
}

// Reads a package image into the four out-tables. Returns false (touching nothing)
// when the magic does not match.
public fn bool DeserializePackageImage(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirInstruction> outInstrs, mut borrow IrTable<MirBlock> outBlocks, mut borrow IrTable<MirFunction> outFuncs, mut borrow IrTable<MirGlobal> outGlobals)
{
    if (ReadU32(buf, 1) != MirImageMagic())
    {
        return false;
    }

    DeserializeInstructionsAt(buf, ReadU32(buf, 5), outInstrs);
    DeserializeBlocksAt(buf, ReadU32(buf, 9), outBlocks);
    DeserializeFunctionsAt(buf, ReadU32(buf, 13), outFuncs);
    DeserializeGlobalsAt(buf, ReadU32(buf, 17), outGlobals);
    return true;
}

// Emits an `inspect-pkg` one-line summary of a package image, reading only the header
// and each section's count (no IR materialized). Empty when the magic is wrong.
public fn MemoryStatus InspectPackageImage(borrow IrTable<u8[0 max]> buf, mut borrow OwnedAscii sink)
{
    if (ReadU32(buf, 1) != MirImageMagic())
    {
        return MemoryStatus.Ok;
    }

    try sink.AppendConstAscii("package: ");
    try sink.AppendU64((u64[0 max])ReadU32(buf, ReadU32(buf, 5)));
    try sink.AppendConstAscii(" instructions, ");
    try sink.AppendU64((u64[0 max])ReadU32(buf, ReadU32(buf, 9)));
    try sink.AppendConstAscii(" blocks, ");
    try sink.AppendU64((u64[0 max])ReadU32(buf, ReadU32(buf, 13)));
    try sink.AppendConstAscii(" functions, ");
    try sink.AppendU64((u64[0 max])ReadU32(buf, ReadU32(buf, 17)));
    try sink.AppendConstAscii(" globals\n");
    return MemoryStatus.Ok;
}

// === Bridge to the stdlib byte buffer (toward on-disk package images, #32) ===
// `System.IO.File.WriteAllBytes`/`ReadAllBytes` consume/produce a
// `System.Runtime.Buffer.DynamicByteBuffer`, so a package image (an `IrTable<u8>`)
// converts to/from that type. Bytes are u8 here and i8 in the buffer; the modular
// cast preserves the bit pattern. With these, persisting an image is a thin wrapper:
// `SerializePackageImage` -> `ImageToByteBuffer` -> `File.WriteAllBytes`, and the
// reverse for loading.

// Copies every byte of the image `src` into the byte buffer `dst`.
public fn void ImageToByteBuffer(borrow IrTable<u8[0 max]> src, mut borrow DynamicByteBuffer dst)
{
    stack u64[0 2 ** 63 - 1] count = src.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack u8[0 max] b = src.Get(i);
        stack System.Memory.MemoryStatus ws = dst.WriteByte((i8[min max])b);
        i = i + 1;
    }
}

// Copies the readable bytes of `src` into the image `dst`.
public fn void ImageFromByteBuffer(borrow DynamicByteBuffer src, mut borrow IrTable<u8[0 max]> dst)
{
    stack i8[min max][] bytes = src.ReadSlice();
    stack u64[0 2 ** 63 - 1] len = src.Readable();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < len)
    {
        stack i8[min max] sb = bytes[i];
        stack u32[0 max] w = dst.Add((u8[0 max])sb);
        i = i + 1;
    }
}

// === On-disk package image (#32, end-to-end file round-trip) ===
// Serializes a module to a package image, writes it to a temp file via System.IO.File,
// reads it back, and deserializes — exercising the full on-disk path. All filesystem +
// dynamic-buffer work stays in this module (a [Fact] only builds inputs + checks the
// bool). Switch arms are all non-empty (the empty `case Ok:` arm crashes host lower-mir
// for cross-package stdlib-enum switches).

internal fn bool WriteImageFile(ascii path, borrow DynamicByteBuffer dbuf)
{
    switch (System.IO.File.WriteAllBytes(path, dbuf))
    {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var writeError):
            return false;
    }
}

internal fn bool ReadImageFile(ascii path, mut borrow IrTable<u8[0 max]> outBuf)
{
    switch (System.IO.File.ReadAllBytes(path))
    {
        case System.IO.IOResult<DynamicByteBuffer>.Ok(var contents):
            ImageFromByteBuffer(contents, outBuf);
            return true;
        case System.IO.IOResult<DynamicByteBuffer>.Err(var readError):
            return false;
    }
}

// Builds `<fresh temp dir>/<filename>` into `outPath` (filename should lead with `/`).
internal fn bool MakeTempPath(mut borrow OwnedAscii outPath, const ascii filename)
{
    switch (System.FileSystem.CreateTempDirectory("mir"))
    {
        case System.IO.IOResult<OwnedAscii>.Ok(var dir):
            stack mut OwnedAscii dirPath = dir;
            stack System.Memory.MemoryStatus appendDir = outPath.AppendAscii(dirPath.View());
            stack System.Memory.MemoryStatus appendName = outPath.AppendConstAscii(filename);
            return true;
        case System.IO.IOResult<OwnedAscii>.Err(var dirError):
            return false;
    }
}

// Writes a serialized module to a temp file, reads it back, and reports whether the
// section counts survive the on-disk round-trip.
public fn bool PackageImageFileRoundTrips(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, borrow IrTable<MirGlobal> globals)
{
    stack mut OwnedAscii path = new();
    if (!MakeTempPath(path, "/image.mirpkg"))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> buf = new();
    SerializePackageImage(instrs, blocks, funcs, globals, buf);
    stack mut DynamicByteBuffer dbuf = new();
    ImageToByteBuffer(buf, dbuf);

    if (!WriteImageFile(path.View(), dbuf))
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> readBuf = new();
    if (!ReadImageFile(path.View(), readBuf))
    {
        return false;
    }

    stack mut IrTable<MirInstruction> bi = new();
    stack mut IrTable<MirBlock> bb = new();
    stack mut IrTable<MirFunction> bf = new();
    stack mut IrTable<MirGlobal> bg = new();
    stack bool ok = DeserializePackageImage(readBuf, bi, bb, bf, bg);
    return ok
        && bi.Count() == instrs.Count()
        && bb.Count() == blocks.Count()
        && bf.Count() == funcs.Count()
        && bg.Count() == globals.Count();
}

// === LLVM IR text to disk (toward object output via clang/llc, #31) ===
// The textual LLVM emitter + file I/O produce a real `.ll` file on disk. With
// `clang module.ll -c` (or `llc`), that `.ll` becomes an object file — the standard
// non-FFI path to native code that many compiler front ends use. (Direct libLLVM
// C-API emission is the alternative; this subprocess path needs no FFI.)

internal fn bool WriteAsciiFile(ascii path, borrow OwnedAscii text)
{
    switch (System.IO.File.WriteAllBytes(path, text.AsSlice()))
    {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var writeError):
            return false;
    }
}

internal fn void AppendBufferToAscii(borrow DynamicByteBuffer src, mut borrow OwnedAscii dst)
{
    stack i8[min max][] bytes = src.ReadSlice();
    stack u64[0 2 ** 63 - 1] len = src.Readable();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < len)
    {
        stack i8[min max] b = bytes[i];
        stack System.Memory.MemoryStatus w = dst.AppendByte(b);
        i = i + 1;
    }
}

internal fn bool ReadAsciiFileEquals(ascii path, borrow OwnedAscii expected)
{
    switch (System.IO.File.ReadAllBytes(path))
    {
        case System.IO.IOResult<DynamicByteBuffer>.Ok(var contents):
            stack mut OwnedAscii readback = new();
            AppendBufferToAscii(contents, readback);
            return System.Text.OwnedAscii.Equals(expected, readback);
        case System.IO.IOResult<DynamicByteBuffer>.Err(var readError):
            return false;
    }
}

// Emits the module as LLVM IR text, writes it to a temp `.ll` file, reads it back, and
// reports whether the on-disk text matches the emitted text exactly.
public fn bool LlvmModuleFileRoundTrips(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs)
{
    stack mut OwnedAscii text = new();
    stack System.Memory.MemoryStatus emitStatus = EmitLlvmModule(instrs, blocks, funcs, text);

    stack mut OwnedAscii path = new();
    if (!MakeTempPath(path, "/module.ll"))
    {
        return false;
    }

    if (!WriteAsciiFile(path.View(), text))
    {
        return false;
    }

    return ReadAsciiFileEquals(path.View(), text);
}

// === Object generation via the toolchain (subprocess route, #31) ===
// Emits a module's LLVM IR to a `.ll` file, invokes `clang -c` on it, and confirms an
// object file was produced — the end-to-end subprocess path to native code. Success is
// detected by the object file existing (ProcessOutput.ExitCode is not externally
// readable). Tolerant of a missing toolchain so the suite stays portable.

internal fn bool MakeTempDir(mut borrow OwnedAscii outDir)
{
    switch (System.FileSystem.CreateTempDirectory("mirobj"))
    {
        case System.IO.IOResult<OwnedAscii>.Ok(var dir):
            stack mut OwnedAscii dirPath = dir;
            stack System.Memory.MemoryStatus appendDir = outDir.AppendAscii(dirPath.View());
            return true;
        case System.IO.IOResult<OwnedAscii>.Err(var dirError):
            return false;
    }
}

// True when `path` names a non-empty file (used to detect that clang wrote an object).
internal fn bool NonEmptyFileExists(ascii path)
{
    switch (System.IO.File.ReadAllBytes(path))
    {
        case System.IO.IOResult<DynamicByteBuffer>.Ok(var contents):
            return contents.Readable() > 0;
        case System.IO.IOResult<DynamicByteBuffer>.Err(var readError):
            return false;
    }
}

internal fn bool RunClangCapture(mut borrow System.Process.ProcessCommand command, ascii objPath)
{
    unsafe
    {
        switch (System.Process.RunCapture(command))
        {
            case System.Process.ProcessResult<System.Process.ProcessOutput>.Ok(var ranOutput):
                return NonEmptyFileExists(objPath);
            case System.Process.ProcessResult<System.Process.ProcessOutput>.Err(var runError):
                return true;
        }
    }
}

internal fn bool RunClang(ascii llPath, ascii objPath)
{
    switch (System.Process.Command("clang"))
    {
        case System.Process.ProcessResult<System.Process.ProcessCommand>.Ok(var cmd):
            stack mut System.Process.ProcessCommand command = cmd;
            stack System.Process.ProcessStatus s1 = command.AddArgument("-c");
            stack System.Process.ProcessStatus s2 = command.AddArgument(llPath);
            stack System.Process.ProcessStatus s3 = command.AddArgument("-o");
            stack System.Process.ProcessStatus s4 = command.AddArgument(objPath);
            return RunClangCapture(command, objPath);
        case System.Process.ProcessResult<System.Process.ProcessCommand>.Err(var cmdError):
            return true;
    }
}

// Emits the module's LLVM IR, writes it to a `.ll` file, and runs `clang -c` to produce
// an object. Returns true when an object was produced OR the toolchain is unavailable;
// false only when clang ran but produced no object (i.e. the IR was rejected).
public fn bool CompileEmittedLlvmProducesObject(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs)
{
    stack mut OwnedAscii dir = new();
    if (!MakeTempDir(dir))
    {
        return false;
    }

    stack mut OwnedAscii llPath = new();
    stack System.Memory.MemoryStatus la = llPath.AppendAscii(dir.View());
    stack System.Memory.MemoryStatus lb = llPath.AppendConstAscii("/module.ll");
    stack mut OwnedAscii objPath = new();
    stack System.Memory.MemoryStatus oa = objPath.AppendAscii(dir.View());
    stack System.Memory.MemoryStatus ob = objPath.AppendConstAscii("/module.o");

    stack mut OwnedAscii text = new();
    stack System.Memory.MemoryStatus emitStatus = EmitLlvmModule(instrs, blocks, funcs, text);
    if (!WriteAsciiFile(llPath.View(), text))
    {
        return false;
    }

    return RunClang(llPath.View(), objPath.View());
}

// Writes already-emitted LLVM text to a temp `.ll` and runs `clang -c` on it — proving the
// IR is LLVM-VERIFIER-VALID native code, not merely text matching a hand-predicted string.
// clang's verifier independently rejects malformed IR (e.g. an `i1` flowing into an `i64`
// operand — the recurring trap), so this is a stronger check than `LlvmTextEquals`. Tolerant
// of a missing toolchain (RunClang passes when clang cannot be spawned) so the suite stays
// portable. The shared verifier-level check behind every AST-codegen clang fact.
public fn bool ClangVerifiesLlvmText(borrow OwnedAscii text)
{
    stack mut OwnedAscii dir = new();
    if (!MakeTempDir(dir))
    {
        return false;
    }

    stack mut OwnedAscii llPath = new();
    stack System.Memory.MemoryStatus la = llPath.AppendAscii(dir.View());
    stack System.Memory.MemoryStatus lb = llPath.AppendConstAscii("/unit.ll");
    stack mut OwnedAscii objPath = new();
    stack System.Memory.MemoryStatus oa = objPath.AppendAscii(dir.View());
    stack System.Memory.MemoryStatus ob = objPath.AppendConstAscii("/unit.o");

    if (!WriteAsciiFile(llPath.View(), text))
    {
        return false;
    }

    return RunClang(llPath.View(), objPath.View());
}

// Compiles a multi-function module SOURCE through the AST path and clang-verifies the emitted
// LLVM (see ClangVerifiesLlvmText). Returns false if the source does not compile.
public fn bool CompileModuleSourceProducesObject(ascii source)
{
    stack mut OwnedAscii text = new();
    if (!CompileModuleFromAst(source, text))
    {
        return false;
    }

    return ClangVerifiesLlvmText(text);
}

// === FFI capability probe (foundation for a libLLVM C-API binding, #31 direct) ===
// The libLLVM direct-C-API route is `ffi fn` declarations of the LLVM C API linked
// against libLLVM. As a foundation check that the self-hosted compiler package can
// declare and call C functions through FFI, this binds libc `abs` — resolved from the
// system C library that every macOS Stark binary already links. The remaining work
// for the real binding is the static-archive link integration for libLLVM (it ships
// here only as `libLLVM*.a` component archives, with no single shared `libLLVM`).

internal unsafe ffi fn i32[min max] abs(i32[min max] value);

// Calls libc `abs` through FFI.
public fn i32[min max] AbsViaFfi(i32[min max] value)
{
    unsafe
    {
        return abs(value);
    }
}

// === Minimal source -> MIR -> LLVM thread (toward bootstrap, #33) ===
// Connects the front end (lexer) to the back end (MIR + codegen) for a trivial
// `return <int>` program: lex the source, find the first integer literal, parse its
// value from the source span, build a MIR `const`+`return`, and emit the LLVM. This
// is the first source-to-codegen thread — a minimal but real bootstrap-direction
// slice (a full Stark-source -> MIR translator is the multi-session capstone).

// Parses the decimal digits at [start, start+length) of `source` into an integer.
internal fn i64[min max] ParseDigitSpan(borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] length)
{
    stack mut i64[min max] value = 0;
    stack mut u64[0 2 ** 63 - 1] j = 0;
    while willexit (j < length)
    {
        stack i8[min max] digitByte = source[start + j];
        stack i64[min max] digit = (i64[min max])digitByte - 48;
        value = value * 10 + digit;
        j = j + 1;
    }

    return value;
}

// The value of the first IntegerLiteral token in `stream` (parsed from `source`), or
// -1 if there is none.
internal fn i64[min max] FirstIntLiteralValue(borrow TokenStream stream, borrow i8[min max][] source)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.IntegerLiteral)
        {
            return ParseDigitSpan(source, stream.StartAt(i), stream.LengthAt(i));
        }

        i = i + 1;
    }

    return -1;
}

// Lexes a trivial `return <int>` source, lowers it to MIR, and emits the LLVM function
// `@main` into `sink`. Returns false if the source has no integer literal or fails to
// lex.
public fn bool LowerReturnIntToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack i64[min max] value = FirstIntLiteralValue(stream, sourceBytes);
            if (value < 0)
            {
                return false;
            }

            stack mut IrTable<MirInstruction> instrs = new();
            stack mut IrTable<MirBlock> blocks = new();
            stack MirValueId v = MirConstInt(instrs, value);
            stack MirBlockId entry = MirReturnBlock(blocks, v);
            stack System.Memory.MemoryStatus emitStatus = EmitLlvmDefinition(instrs, blocks, "main", entry.Index(), 1, 1, sink);
            return true;
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Extends the source thread to a binary expression `return <int> <op> <int>` (and the
// single-constant case): finds the first integer literal, and if a `+`/`-`/`*` token
// follows with another literal, lowers to MIR `add`/`sub`/`mul`.

// The token index of the first IntegerLiteral in `stream`, or -1 if none.
internal fn i64[min max] FirstIntLiteralIndex(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.IntegerLiteral)
        {
            return (i64[min max])i;
        }

        i = i + 1;
    }

    return -1;
}

// A "primary" expression token: an integer literal or an identifier (a parameter).
internal fn bool IsPrimaryToken(TokenKind k)
{
    return k == TokenKind.IntegerLiteral || k == TokenKind.Identifier;
}

// The token index of the first primary (literal or identifier), or -1 if none. The
// `return` keyword lexes as `TokenKind.Return`, so it is never mistaken for a primary.
internal fn i64[min max] FirstPrimaryIndex(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (IsPrimaryToken(stream.KindAt(i)))
        {
            return (i64[min max])i;
        }

        i = i + 1;
    }

    return -1;
}

// True when `stream` contains any identifier token (so the function takes a parameter).
internal fn bool StreamHasIdentifier(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Identifier)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

// A parameter name as a source span, stored in a symbol table whose row order is the
// parameter index (so the Kth distinct identifier is parameter K = `%pK`).
public struct ParamName
{
    u64[0 2 ** 63 - 1] Start;
    u64[0 2 ** 63 - 1] Length;

    ParamName()
    {
        self.Start = 0;
        self.Length = 0;
    }

    public inline finite law u64[0 2 ** 63 - 1] StartIndex(borrow ParamName self)
    {
        return self.Start;
    }

    public inline finite law u64[0 2 ** 63 - 1] LengthValue(borrow ParamName self)
    {
        return self.Length;
    }
}

// True when the two source spans contain the same bytes.
internal fn bool SpanEquals(borrow i8[min max][] source, u64[0 2 ** 63 - 1] aStart, u64[0 2 ** 63 - 1] aLength, u64[0 2 ** 63 - 1] bStart, u64[0 2 ** 63 - 1] bLength)
{
    if (aLength != bLength)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] k = 0;
    while willexit (k < aLength)
    {
        if (source[aStart + k] != source[bStart + k])
        {
            return false;
        }

        k = k + 1;
    }

    return true;
}

// The 0-based parameter index for the name span [start, start+length), or -1 if the
// name is not yet in the table.
internal fn i64[min max] ParamIndexOf(borrow IrTable<ParamName> params, borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] length)
{
    stack u64[0 2 ** 63 - 1] count = params.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack ParamName existing = params.Get((u32[0 max])(i + 1));
        if (SpanEquals(source, existing.StartIndex(), existing.LengthValue(), start, length))
        {
            return (i64[min max])i;
        }

        i = i + 1;
    }

    return -1;
}

// Builds the parameter symbol table from the distinct identifiers in `stream`, in
// first-appearance order.
internal fn void BuildParamTable(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ParamName> params)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Identifier)
        {
            stack u64[0 2 ** 63 - 1] start = stream.StartAt(i);
            stack u64[0 2 ** 63 - 1] length = stream.LengthAt(i);
            if (ParamIndexOf(params, source, start, length) < 0)
            {
                stack mut ParamName name = new();
                name.Start = start;
                name.Length = length;
                stack u32[0 max] added = params.Add(name);
            }
        }

        i = i + 1;
    }
}

// A local variable binding: a name span and the MIR value it is bound to.
public struct LocalBinding
{
    u64[0 2 ** 63 - 1] Start;
    u64[0 2 ** 63 - 1] Length;
    u32[0 max] ValueIndex;

    LocalBinding()
    {
        self.Start = 0;
        self.Length = 0;
        self.ValueIndex = 0;
    }

    public inline finite law u64[0 2 ** 63 - 1] StartIndex(borrow LocalBinding self)
    {
        return self.Start;
    }

    public inline finite law u64[0 2 ** 63 - 1] LengthValue(borrow LocalBinding self)
    {
        return self.Length;
    }

    public inline finite law u32[0 max] BoundValueIndex(borrow LocalBinding self)
    {
        return self.ValueIndex;
    }
}

// The 1-based MIR value index a local name span is bound to, or -1 if not a local.
internal fn i64[min max] LocalValueOf(borrow IrTable<LocalBinding> locals, borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] length)
{
    stack u64[0 2 ** 63 - 1] count = locals.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack LocalBinding binding = locals.Get((u32[0 max])(i + 1));
        if (SpanEquals(source, binding.StartIndex(), binding.LengthValue(), start, length))
        {
            return (i64[min max])binding.BoundValueIndex();
        }

        i = i + 1;
    }

    return -1;
}

// The token index of the first token of kind `kind`, or -1 if absent.
internal fn i64[min max] FirstTokenOfKind(borrow TokenStream stream, TokenKind kind)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == kind)
        {
            return (i64[min max])i;
        }

        i = i + 1;
    }

    return -1;
}

// The token index of the first token of kind `kind` strictly after `after`, or -1.
internal fn i64[min max] FirstTokenOfKindAfter(borrow TokenStream stream, TokenKind kind, u64[0 2 ** 63 - 1] after)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = after + 1;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == kind)
        {
            return (i64[min max])i;
        }

        i = i + 1;
    }

    return -1;
}

// Emits `define i64 @<prefix><number>(<params>) { <entry block> }`.
internal fn MemoryStatus EmitLlvmNumberedFunction(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii prefix, u32[0 max] number, u32[0 max] paramCount, u32[0 max] entryBlock, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define i64 @");
    try sink.AppendConstAscii(prefix);
    try sink.AppendU64((u64[0 max])number);
    try EmitLlvmParamList(paramCount, sink);
    try sink.AppendConstAscii(" {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlock, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Lowers the primary at token `index` to a value: an integer literal becomes a MIR
// constant; an identifier resolves to a local binding (its bound value) if present,
// otherwise to the parameter named by its source span.
internal fn MirValueId LowerPrimary(borrow TokenStream stream, borrow i8[min max][] source, borrow IrTable<ParamName> params, borrow IrTable<LocalBinding> locals, mut borrow IrTable<MirInstruction> instrs, u64[0 2 ** 63 - 1] index)
{
    if (stream.KindAt(index) == TokenKind.IntegerLiteral)
    {
        return MirConstInt(instrs, ParseDigitSpan(source, stream.StartAt(index), stream.LengthAt(index)));
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt(index);
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt(index);
    stack i64[min max] localValue = LocalValueOf(locals, source, start, length);
    if (localValue >= 0)
    {
        return MirValueIdOf((u32[0 max])localValue);
    }

    stack i64[min max] paramIndex = ParamIndexOf(params, source, start, length);
    if (paramIndex < 0)
    {
        return MirParam(instrs, 0);
    }

    return MirParam(instrs, (u32[0 max])paramIndex);
}

// Folds a `term (('+'|'-') term)*` (sum of products) expression starting at the
// primary under `startCursor`, returning the resulting MIR value. The fold stops at
// the first token that is not a continuation (e.g. `;`, `return`, end of stream), so
// it lowers exactly one expression. Identifiers resolve through `locals` then `params`.
internal fn MirValueId FoldExpr(borrow TokenStream stream, borrow i8[min max][] source, borrow IrTable<ParamName> params, borrow IrTable<LocalBinding> locals, mut borrow IrTable<MirInstruction> instrs, u64[0 2 ** 63 - 1] startCursor)
{
    stack mut u64[0 2 ** 63 - 1] cursor = startCursor;
    stack mut MirValueId acc = LowerPrimary(stream, source, params, locals, instrs, cursor);
    while willexit (IsProductOpToken(stream.KindAt(cursor + 1)) && IsPrimaryToken(stream.KindAt(cursor + 2)))
    {
        stack TokenKind productOp = stream.KindAt(cursor + 1);
        stack MirValueId factor = LowerPrimary(stream, source, params, locals, instrs, cursor + 2);
        acc = LowerProductOp(instrs, productOp, acc, factor);
        cursor = cursor + 2;
    }

    while willexit (IsAddSubToken(stream.KindAt(cursor + 1)) && IsPrimaryToken(stream.KindAt(cursor + 2)))
    {
        stack TokenKind op = stream.KindAt(cursor + 1);
        cursor = cursor + 2;
        stack mut MirValueId term = LowerPrimary(stream, source, params, locals, instrs, cursor);
        while willexit (IsProductOpToken(stream.KindAt(cursor + 1)) && IsPrimaryToken(stream.KindAt(cursor + 2)))
        {
            stack TokenKind productOp = stream.KindAt(cursor + 1);
            stack MirValueId factor = LowerPrimary(stream, source, params, locals, instrs, cursor + 2);
            term = LowerProductOp(instrs, productOp, term, factor);
            cursor = cursor + 2;
        }

        acc = LowerBinOp(instrs, op, acc, term);
    }

    return acc;
}

// Lowers a binary op token to the matching MIR instruction (Plus is the default).
internal fn MirValueId LowerBinOp(mut borrow IrTable<MirInstruction> instrs, TokenKind op, MirValueId a, MirValueId b)
{
    if (op == TokenKind.Minus)
    {
        return MirSub(instrs, a, b);
    }

    if (op == TokenKind.Star)
    {
        return MirMul(instrs, a, b);
    }

    // Division and modulo must route to their own opcodes — defaulting them to `add`
    // silently miscompiles `/`/`%` (an AST-lowering path passes every product operator,
    // not just `*`, through here).
    if (op == TokenKind.Div)
    {
        return MirSDiv(instrs, a, b);
    }

    if (op == TokenKind.Mod)
    {
        return MirSRem(instrs, a, b);
    }

    return MirAdd(instrs, a, b);
}

// True when `k` is a `+`/`-` additive operator token.
internal fn bool IsAddSubToken(TokenKind k)
{
    return k == TokenKind.Plus || k == TokenKind.Minus;
}

// True when `k` is a `*`/`/`/`%` multiplicative operator token.
internal fn bool IsProductOpToken(TokenKind k)
{
    return k == TokenKind.Star || k == TokenKind.Div || k == TokenKind.Mod;
}

// The token index of the first `<`/`>` comparison operator, or -1 if absent.
internal fn i64[min max] FirstComparisonIndex(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack TokenKind k = stream.KindAt(i);
        if (k == TokenKind.Lt || k == TokenKind.Gt)
        {
            return (i64[min max])i;
        }

        i = i + 1;
    }

    return -1;
}

// The token index of the first primary strictly after `after`, or -1 if none.
internal fn i64[min max] FirstPrimaryIndexAfter(borrow TokenStream stream, u64[0 2 ** 63 - 1] after)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = after + 1;
    while willexit (i < count)
    {
        if (IsPrimaryToken(stream.KindAt(i)))
        {
            return (i64[min max])i;
        }

        i = i + 1;
    }

    return -1;
}

// Lowers a `<`/`>` comparison to its signed MIR comparison (`<` is the default).
internal fn MirValueId LowerComparison(mut borrow IrTable<MirInstruction> instrs, TokenKind op, MirValueId a, MirValueId b)
{
    // Every comparison operator must route to its own opcode. Defaulting the four
    // non-`<`/`>` operators to `slt` silently miscompiles them — the AST path passes all
    // six comparison operators through here (the positional lowering only ever passes
    // `<`/`>`, which is why this was latent).
    if (op == TokenKind.Gt)
    {
        return MirCmpGt(instrs, a, b);
    }

    if (op == TokenKind.Lte)
    {
        return MirCmpLe(instrs, a, b);
    }

    if (op == TokenKind.Gte)
    {
        return MirCmpGe(instrs, a, b);
    }

    if (op == TokenKind.EqEq)
    {
        return MirCmpEq(instrs, a, b);
    }

    if (op == TokenKind.Neq)
    {
        return MirCmpNe(instrs, a, b);
    }

    return MirCmpLt(instrs, a, b);
}

// Lowers a multiplicative op token to its MIR instruction (`*` is the default).
internal fn MirValueId LowerProductOp(mut borrow IrTable<MirInstruction> instrs, TokenKind op, MirValueId a, MirValueId b)
{
    if (op == TokenKind.Div)
    {
        return MirSDiv(instrs, a, b);
    }

    if (op == TokenKind.Mod)
    {
        return MirSRem(instrs, a, b);
    }

    return MirMul(instrs, a, b);
}

// Lowers a `return <expr>` where `<expr>` is a sum of products: `term (('+'|'-') term)*`
// and `term` is `int ('*' int)*`. `*` binds tighter than `+`/`-` (real precedence);
// each tier folds left-associatively (the product fold is inlined for the first term
// and again per additive term). `2 + 3 * 4` lowers as `2 + (3 * 4)`.
internal fn bool LowerExprStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack i64[min max] firstIndex = FirstPrimaryIndex(stream);
    if (firstIndex < 0)
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<ParamName> params = new();
    BuildParamTable(stream, source, params);
    stack mut IrTable<LocalBinding> locals = new();

    // A single optional comparison binds below `+`/`-`: `<sum> (('<'|'>') <sum>)?`. The
    // i1 result is zero-extended to i64 so the function can return it.
    stack mut MirValueId acc = FoldExpr(stream, source, params, locals, instrs, (u64[0 2 ** 63 - 1])firstIndex);
    stack i64[min max] comparisonIndex = FirstComparisonIndex(stream);
    if (comparisonIndex >= 0)
    {
        stack i64[min max] rhsIndex = FirstPrimaryIndexAfter(stream, (u64[0 2 ** 63 - 1])comparisonIndex);
        if (rhsIndex >= 0)
        {
            stack MirValueId rhs = FoldExpr(stream, source, params, locals, instrs, (u64[0 2 ** 63 - 1])rhsIndex);
            stack MirValueId comparison = LowerComparison(instrs, stream.KindAt((u64[0 2 ** 63 - 1])comparisonIndex), acc, rhs);
            acc = MirZExt(instrs, comparison);
        }
    }

    stack MirBlockId entry = MirReturnBlock(blocks, acc);
    stack u32[0 max] count = (u32[0 max])instrs.Count();
    stack u32[0 max] paramCount = (u32[0 max])params.Count();
    stack System.Memory.MemoryStatus emitStatus = EmitLlvmDefinitionWithParams(instrs, blocks, "main", paramCount, entry.Index(), 1, count, sink);
    return true;
}

// Lowers a program `(var <name> = <expr>;)* return <expr>` to LLVM: each `var` binds a
// local to its expression's value (earlier locals are visible to later ones), and the
// `return` expression may reference any of them by name. No parameters in this mode.
// A `var` statement is `var Id = <expr> ;`, so its name is at the var token + 1 and its
// expression begins at + 3 (after `=`).
internal fn bool LowerProgramStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack i64[min max] returnIndex = FirstTokenOfKind(stream, TokenKind.Return);
    if (returnIndex < 0)
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<ParamName> params = new();
    stack mut IrTable<LocalBinding> locals = new();

    // Bind every `var` declaration, in source order.
    stack u64[0 2 ** 63 - 1] tokenCount = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < tokenCount)
    {
        if (stream.KindAt(i) == TokenKind.Var)
        {
            stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt(i + 1);
            stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt(i + 1);
            stack MirValueId boundValue = FoldExpr(stream, source, params, locals, instrs, i + 3);
            stack mut LocalBinding binding = new();
            binding.Start = nameStart;
            binding.Length = nameLength;
            binding.ValueIndex = boundValue.Index();
            stack u32[0 max] addedLocal = locals.Add(binding);
        }

        i = i + 1;
    }

    // `return <expr>`: expression begins at returnIndex + 1.
    stack MirValueId resultValue = FoldExpr(stream, source, params, locals, instrs, (u64[0 2 ** 63 - 1])returnIndex + 1);

    stack MirBlockId entry = MirReturnBlock(blocks, resultValue);
    stack u32[0 max] count = (u32[0 max])instrs.Count();
    stack System.Memory.MemoryStatus emitStatus = EmitLlvmDefinitionWithParams(instrs, blocks, "main", 0, entry.Index(), 1, count, sink);
    return true;
}

// Lexes and lowers a `var <name> = <expr>; return <expr>` program to LLVM `@main`.
public fn bool LowerProgramToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerProgramStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Lexes a `return <int>` or `return <int> <+|-|*> <int>` source, lowers it to MIR, and
// emits the LLVM `@main` function into `sink`.
public fn bool LowerReturnExprToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerExprStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// === If-from-source -> branching control flow (toward bootstrap, #33) ===
// Lowers `if <a> <cmp> <b> <then> else <else>` (single-primary operands) to a real
// diamond CFG: compare a/b, conditionally branch, and merge the then/else values with
// a phi. This wires the front end's `if` to the multi-block back end emitter.

internal fn bool LowerIfStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack i64[min max] ifIndex = FirstTokenOfKind(stream, TokenKind.If);
    stack i64[min max] elseKeyword = FirstTokenOfKind(stream, TokenKind.Else);
    if (ifIndex < 0 || elseKeyword < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] base = (u64[0 2 ** 63 - 1])ifIndex;
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<ParamName> params = new();
    BuildParamTable(stream, source, params);
    stack mut IrTable<LocalBinding> locals = new();

    // Entry block: `<lhs> <cmp> <rhs>` (single-primary operands), ending in a compare.
    stack MirValueId lhs = LowerPrimary(stream, source, params, locals, instrs, base + 1);
    stack MirValueId rhs = LowerPrimary(stream, source, params, locals, instrs, base + 3);
    stack MirValueId comparison = LowerComparison(instrs, stream.KindAt(base + 2), lhs, rhs);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count();

    // Then arm: the expression after the comparison; its instructions form the then
    // block. `FoldExpr` stops at `else`.
    stack u32[0 max] thenFirst = entryCount + 1;
    stack MirValueId thenValue = FoldExpr(stream, source, params, locals, instrs, base + 4);
    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - entryCount;

    // Else arm: the expression after `else`; its instructions form the else block.
    stack i64[min max] elseArm = FirstPrimaryIndexAfter(stream, (u64[0 2 ** 63 - 1])elseKeyword);
    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId elseValue = FoldExpr(stream, source, params, locals, instrs, (u64[0 2 ** 63 - 1])elseArm);
    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    // Merge block: a phi selecting the then/else value, then a return.
    stack MirValueId phi = MirPhi2(instrs, thenValue, MirBlockIdOf(2), elseValue, MirBlockIdOf(3));

    // Blocks, created in order so their ids are b1..b4.
    stack MirBlockId entry = MirCondBlock(blocks, comparison, MirBlockIdOf(2), MirBlockIdOf(3));
    stack MirBlockId thenBlock = MirBranchBlock(blocks, MirBlockIdOf(4));
    stack MirBlockId elseBlock = MirBranchBlock(blocks, MirBlockIdOf(4));
    stack MirBlockId mergeBlock = MirReturnBlock(blocks, phi);

    stack u32[0 max] paramCount = (u32[0 max])params.Count();
    stack System.Memory.MemoryStatus emitStatus = EmitLlvmDiamond(instrs, blocks, "main", paramCount, entry.Index(), 1, entryCount, thenBlock.Index(), thenFirst, thenCount, elseBlock.Index(), elseFirst, elseCount, mergeBlock.Index(), phi.Index(), 1, sink);
    return true;
}

// Lexes and lowers an `if <a> <cmp> <b> <then> else <else>` program to a branching
// LLVM `@main` (with a phi merge).
public fn bool LowerIfToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerIfStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Lowers a one-level else-if chain `if <a> <cmp> <b> <then1> else if <c> <cmp> <d>
// <then2> else <else>` (single-primary comparison operands; arm values are folded
// expressions) to a seven-block CFG of two composed diamonds, emitted through the
// general `EmitLlvmBlocks`. Requires the token after the first `else` to be `if`.
internal fn bool LowerNestedIfStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack i64[min max] ifIndex = FirstTokenOfKind(stream, TokenKind.If);
    stack i64[min max] else1 = FirstTokenOfKind(stream, TokenKind.Else);
    if (ifIndex < 0 || else1 < 0)
    {
        return false;
    }

    // The else arm must itself open with `if` (the chained `else if`).
    stack u64[0 2 ** 63 - 1] innerIf = (u64[0 2 ** 63 - 1])else1 + 1;
    if (stream.KindAt(innerIf) != TokenKind.If)
    {
        return false;
    }

    stack i64[min max] else2 = FirstTokenOfKindAfter(stream, TokenKind.Else, innerIf);
    if (else2 < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] base = (u64[0 2 ** 63 - 1])ifIndex;
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<ParamName> params = new();
    BuildParamTable(stream, source, params);
    stack mut IrTable<LocalBinding> locals = new();

    // Entry block (b1): outer comparison `<a> <cmp> <b>`.
    stack MirValueId lhs1 = LowerPrimary(stream, source, params, locals, instrs, base + 1);
    stack MirValueId rhs1 = LowerPrimary(stream, source, params, locals, instrs, base + 3);
    stack MirValueId cond1 = LowerComparison(instrs, stream.KindAt(base + 2), lhs1, rhs1);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count();

    // then1 block (b2): the first arm value (folded, stops at `else`).
    stack u32[0 max] then1First = entryCount + 1;
    stack MirValueId then1Value = FoldExpr(stream, source, params, locals, instrs, base + 4);
    stack u32[0 max] then1Count = (u32[0 max])instrs.Count() - entryCount;

    // inner-entry block (b3): inner comparison `<c> <cmp> <d>` after the chained `if`.
    stack u32[0 max] innerEntryFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId lhs2 = LowerPrimary(stream, source, params, locals, instrs, innerIf + 1);
    stack MirValueId rhs2 = LowerPrimary(stream, source, params, locals, instrs, innerIf + 3);
    stack MirValueId cond2 = LowerComparison(instrs, stream.KindAt(innerIf + 2), lhs2, rhs2);
    stack u32[0 max] innerEntryCount = (u32[0 max])instrs.Count() - (innerEntryFirst - 1);

    // then2 block (b4): the second arm value (folded, stops at `else`).
    stack u32[0 max] then2First = (u32[0 max])instrs.Count() + 1;
    stack MirValueId then2Value = FoldExpr(stream, source, params, locals, instrs, innerIf + 4);
    stack u32[0 max] then2Count = (u32[0 max])instrs.Count() - (then2First - 1);

    // else2 block (b5): the final else value.
    stack i64[min max] elseArm = FirstPrimaryIndexAfter(stream, (u64[0 2 ** 63 - 1])else2);
    stack u32[0 max] else2First = (u32[0 max])instrs.Count() + 1;
    stack MirValueId elseValue = FoldExpr(stream, source, params, locals, instrs, (u64[0 2 ** 63 - 1])elseArm);
    stack u32[0 max] else2Count = (u32[0 max])instrs.Count() - (else2First - 1);

    // inner-merge block (b6): phi over the inner diamond, then branch to the outer merge.
    stack u32[0 max] innerMergeFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId innerPhi = MirPhi2(instrs, then2Value, MirBlockIdOf(4), elseValue, MirBlockIdOf(5));
    // outer-merge block (b7): phi selecting then1 vs the inner result, then return.
    stack u32[0 max] outerMergeFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId outerPhi = MirPhi2(instrs, then1Value, MirBlockIdOf(2), innerPhi, MirBlockIdOf(6));

    // Blocks in order b1..b7.
    stack MirBlockId entry = MirCondBlock(blocks, cond1, MirBlockIdOf(2), MirBlockIdOf(3));
    stack MirBlockId then1 = MirBranchBlock(blocks, MirBlockIdOf(7));
    stack MirBlockId innerEntry = MirCondBlock(blocks, cond2, MirBlockIdOf(4), MirBlockIdOf(5));
    stack MirBlockId then2 = MirBranchBlock(blocks, MirBlockIdOf(6));
    stack MirBlockId else2Block = MirBranchBlock(blocks, MirBlockIdOf(6));
    stack MirBlockId innerMerge = MirBranchBlock(blocks, MirBlockIdOf(7));
    stack MirBlockId outerMerge = MirReturnBlock(blocks, outerPhi);

    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, entryCount));
    stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(then1.Index(), then1First, then1Count));
    stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(innerEntry.Index(), innerEntryFirst, innerEntryCount));
    stack u32[0 max] r4 = ranges.Add(MakeBlockEmit(then2.Index(), then2First, then2Count));
    stack u32[0 max] r5 = ranges.Add(MakeBlockEmit(else2Block.Index(), else2First, else2Count));
    stack u32[0 max] r6 = ranges.Add(MakeBlockEmit(innerMerge.Index(), innerMergeFirst, 1));
    stack u32[0 max] r7 = ranges.Add(MakeBlockEmit(outerMerge.Index(), outerMergeFirst, 1));

    stack u32[0 max] paramCount = (u32[0 max])params.Count();
    switch (EmitLlvmBlocks(instrs, blocks, "main", paramCount, ranges, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

// Lexes and lowers an `if … else if … else …` one-level chain to a branching `@main`.
public fn bool LowerNestedIfToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerNestedIfStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// === Multi-function modules + cross-function calls (toward bootstrap, #33) ===
// Lowers `(fn <name>() { return <body> })+` to an LLVM module with one function per
// definition. A body is either an arithmetic expression or a call `<name>()` to
// another function in the module (resolved by name to its id), demonstrating
// cross-function calls. Functions emit as `@fN` in definition order.

// Lowers a function body's `return` expression starting at the primary `exprStart`:
// an `<identifier> (` is a call to the named function (looked up in `funcNames`);
// otherwise it is an arithmetic expression.
internal fn MirValueId LowerReturnBody(borrow TokenStream stream, borrow i8[min max][] source, borrow IrTable<ParamName> funcNames, borrow IrTable<ParamName> params, mut borrow IrTable<MirInstruction> instrs, u64[0 2 ** 63 - 1] exprStart)
{
    // `<identifier> (` is a call to a named function (optionally with one argument).
    if (stream.KindAt(exprStart) == TokenKind.Identifier && stream.KindAt(exprStart + 1) == TokenKind.LParen)
    {
        stack i64[min max] calleeIndex = ParamIndexOf(funcNames, source, stream.StartAt(exprStart), stream.LengthAt(exprStart));
        if (calleeIndex >= 0)
        {
            stack mut IrTable<LocalBinding> noLocals = new();
            if (IsPrimaryToken(stream.KindAt(exprStart + 2)))
            {
                stack MirValueId argument = LowerPrimary(stream, source, params, noLocals, instrs, exprStart + 2);
                return MirCall1(instrs, MirFuncIdOf((u32[0 max])(calleeIndex + 1)), argument);
            }

            return MirCall(instrs, MirFuncIdOf((u32[0 max])(calleeIndex + 1)));
        }
    }

    stack mut IrTable<LocalBinding> bodyLocals = new();
    return FoldExpr(stream, source, params, bodyLocals, instrs, exprStart);
}

internal fn bool LowerModuleStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] tokenCount = stream.Count();

    // Function name table (definition order = id order). The name follows `fn`.
    stack mut IrTable<ParamName> funcNames = new();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < tokenCount)
    {
        if (stream.KindAt(i) == TokenKind.Fn)
        {
            stack mut ParamName name = new();
            name.Start = stream.StartAt(i + 1);
            name.Length = stream.LengthAt(i + 1);
            stack u32[0 max] added = funcNames.Add(name);
        }

        i = i + 1;
    }

    if (funcNames.Count() == 0)
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();

    // Lower + emit each function in definition order. Layout: `fn <name> ( <param>? )
    // { return <body> }` — so the optional parameter is the token at the fn index + 3.
    stack mut u32[0 max] functionNumber = 0;
    stack mut u64[0 2 ** 63 - 1] f = 0;
    while willexit (f < tokenCount)
    {
        if (stream.KindAt(f) == TokenKind.Fn)
        {
            functionNumber = functionNumber + 1;

            stack mut IrTable<ParamName> params = new();
            if (stream.KindAt(f + 3) == TokenKind.Identifier)
            {
                stack mut ParamName param = new();
                param.Start = stream.StartAt(f + 3);
                param.Length = stream.LengthAt(f + 3);
                stack u32[0 max] addedParam = params.Add(param);
            }

            stack u32[0 max] paramCount = (u32[0 max])params.Count();
            stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, f);
            if (returnIndex >= 0)
            {
                stack i64[min max] exprStart = FirstPrimaryIndexAfter(stream, (u64[0 2 ** 63 - 1])returnIndex);
                if (exprStart >= 0)
                {
                    stack u32[0 max] firstInstr = (u32[0 max])instrs.Count() + 1;
                    stack MirValueId value = LowerReturnBody(stream, source, funcNames, params, instrs, (u64[0 2 ** 63 - 1])exprStart);
                    stack MirBlockId entry = MirReturnBlock(blocks, value);
                    stack u32[0 max] instrCount = (u32[0 max])instrs.Count() - (firstInstr - 1);
                    stack System.Memory.MemoryStatus emitStatus = EmitLlvmNumberedFunction(instrs, blocks, "f", functionNumber, paramCount, entry.Index(), firstInstr, instrCount, sink);
                }
            }
        }

        f = f + 1;
    }

    return true;
}

// Lowers a counting loop `var <i> = <init>; while <i> <cmp> <bound> { <i> = <i> <op>
// <step> } return <i>` to a four-block loop CFG (preheader, header with an induction
// phi, body, exit). The loop variable is single-assignment in SSA: its preheader value
// feeds one phi incoming, its body update (`<i> <op> <step>`) the other (back-edge).
internal fn bool LowerCountingLoopStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack i64[min max] whileIdx = FirstTokenOfKind(stream, TokenKind.While);
    stack i64[min max] cmpIdx = FirstComparisonIndex(stream);
    stack i64[min max] initIdx = FirstIntLiteralIndex(stream);
    if (whileIdx < 0 || cmpIdx < 0 || initIdx < 0)
    {
        return false;
    }

    // The `=` inside the body follows `while`; its RHS is `<i> <op> <step>`.
    stack i64[min max] bodyAssign = FirstTokenOfKindAfter(stream, TokenKind.Assign, (u64[0 2 ** 63 - 1])whileIdx);
    if (bodyAssign < 0)
    {
        return false;
    }

    stack TokenKind cmpOp = stream.KindAt((u64[0 2 ** 63 - 1])cmpIdx);
    stack TokenKind updateOp = stream.KindAt((u64[0 2 ** 63 - 1])bodyAssign + 2);
    stack i64[min max] loopInit = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])initIdx), stream.LengthAt((u64[0 2 ** 63 - 1])initIdx));
    stack i64[min max] bound = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])cmpIdx + 1), stream.LengthAt((u64[0 2 ** 63 - 1])cmpIdx + 1));
    stack i64[min max] step = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])bodyAssign + 3), stream.LengthAt((u64[0 2 ** 63 - 1])bodyAssign + 3));

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();

    // Preheader constants (%v1..%v3); all loop-invariant.
    stack MirValueId initConst = MirConstInt(instrs, loopInit);
    stack MirValueId boundConst = MirConstInt(instrs, bound);
    stack MirValueId stepConst = MirConstInt(instrs, step);
    // Header: induction phi (%v4) — [ init, preheader(b1) ], [ iNext(%v6), body(b3) ] —
    // then the comparison (%v5). iNext is forward-referenced (it lives in the body).
    stack MirValueId iVar = MirPhi2(instrs, initConst, MirBlockIdOf(1), MirValueIdOf(6), MirBlockIdOf(3));
    stack MirValueId cond = LowerComparison(instrs, cmpOp, iVar, boundConst);
    // Body: the update (%v6).
    stack MirValueId iNext = LowerBinOp(instrs, updateOp, iVar, stepConst);

    // Blocks: entry(b1), header(b2), body(b3), exit(b4).
    stack MirBlockId entry = MirBranchBlock(blocks, MirBlockIdOf(2));
    stack MirBlockId header = MirCondBlock(blocks, cond, MirBlockIdOf(3), MirBlockIdOf(4));
    stack MirBlockId body = MirBranchBlock(blocks, MirBlockIdOf(2));
    stack MirBlockId exit = MirReturnBlock(blocks, iVar);

    switch (EmitLlvmDiamond(instrs, blocks, "main", 0, entry.Index(), 1, 3, header.Index(), 4, 2, body.Index(), 6, 1, exit.Index(), 8, 0, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

// Lexes and lowers a counting-loop program to a branching LLVM `@main` function.
public fn bool LowerCountingLoopToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerCountingLoopStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Lowers a TWO-variable accumulator loop with a multi-statement body — the canonical
// shape `var i = <iInit>; var s = <sInit>; while i < <bound> { s = s <op> i; i = i
// <op2> <step> } return s` — to the four-block loop CFG whose header carries TWO
// induction phis (counter `i` and accumulator `s`), each fed by the preheader and a
// body back-edge. The two body statements feed the two phis; `s`'s update reads both
// loop variables. Operators (`<op>`, `<op2>`) and all four literals come from source;
// the structure (which var is counter vs accumulator, condition uses the counter) is
// the fixed canonical layout. Both updates are single-assignment in SSA.
internal fn bool LowerAccumulatorLoopStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack i64[min max] whileIdx = FirstTokenOfKind(stream, TokenKind.While);
    stack i64[min max] cmpIdx = FirstComparisonIndex(stream);
    stack i64[min max] iInitIdx = FirstIntLiteralIndex(stream);
    stack i64[min max] firstAssign = FirstTokenOfKind(stream, TokenKind.Assign);
    stack i64[min max] lbraceIdx = FirstTokenOfKind(stream, TokenKind.LBrace);
    if (whileIdx < 0 || cmpIdx < 0 || iInitIdx < 0 || firstAssign < 0 || lbraceIdx < 0)
    {
        return false;
    }

    // Second `var` init `s = <sInit>`: the `=` after the first, its operand the literal.
    stack i64[min max] secondAssign = FirstTokenOfKindAfter(stream, TokenKind.Assign, (u64[0 2 ** 63 - 1])firstAssign);
    // Body assignments: `s = s <op> i` then `i = i <op2> <step>` (both after `{`).
    stack i64[min max] accAssign = FirstTokenOfKindAfter(stream, TokenKind.Assign, (u64[0 2 ** 63 - 1])lbraceIdx);
    if (secondAssign < 0 || accAssign < 0)
    {
        return false;
    }

    stack i64[min max] countAssign = FirstTokenOfKindAfter(stream, TokenKind.Assign, (u64[0 2 ** 63 - 1])accAssign);
    if (countAssign < 0)
    {
        return false;
    }

    stack TokenKind cmpOp = stream.KindAt((u64[0 2 ** 63 - 1])cmpIdx);
    stack TokenKind accOp = stream.KindAt((u64[0 2 ** 63 - 1])accAssign + 2);
    stack TokenKind countOp = stream.KindAt((u64[0 2 ** 63 - 1])countAssign + 2);
    stack i64[min max] iInit = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])iInitIdx), stream.LengthAt((u64[0 2 ** 63 - 1])iInitIdx));
    stack i64[min max] sInit = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])secondAssign + 1), stream.LengthAt((u64[0 2 ** 63 - 1])secondAssign + 1));
    stack i64[min max] bound = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])cmpIdx + 1), stream.LengthAt((u64[0 2 ** 63 - 1])cmpIdx + 1));
    stack i64[min max] step = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])countAssign + 3), stream.LengthAt((u64[0 2 ** 63 - 1])countAssign + 3));

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();

    // Preheader constants (%v1..%v4).
    stack MirValueId iInitConst = MirConstInt(instrs, iInit);
    stack MirValueId sInitConst = MirConstInt(instrs, sInit);
    stack MirValueId boundConst = MirConstInt(instrs, bound);
    stack MirValueId stepConst = MirConstInt(instrs, step);
    // Header: i-phi (%v5) back-edges iNext(%v9); s-phi (%v6) back-edges sNext(%v8).
    stack MirValueId iVar = MirPhi2(instrs, iInitConst, MirBlockIdOf(1), MirValueIdOf(9), MirBlockIdOf(3));
    stack MirValueId sVar = MirPhi2(instrs, sInitConst, MirBlockIdOf(1), MirValueIdOf(8), MirBlockIdOf(3));
    stack MirValueId cond = LowerComparison(instrs, cmpOp, iVar, boundConst);
    // Body: sNext = s <op> i (%v8) ; iNext = i <op2> step (%v9).
    stack MirValueId sNext = LowerBinOp(instrs, accOp, sVar, iVar);
    stack MirValueId iNext = LowerBinOp(instrs, countOp, iVar, stepConst);

    stack MirBlockId entry = MirBranchBlock(blocks, MirBlockIdOf(2));
    stack MirBlockId header = MirCondBlock(blocks, cond, MirBlockIdOf(3), MirBlockIdOf(4));
    stack MirBlockId body = MirBranchBlock(blocks, MirBlockIdOf(2));
    stack MirBlockId exit = MirReturnBlock(blocks, sVar);

    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, 4));
    stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(header.Index(), 5, 3));
    stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(body.Index(), 8, 2));
    stack u32[0 max] r4 = ranges.Add(MakeBlockEmit(exit.Index(), 10, 0));

    switch (EmitLlvmBlocks(instrs, blocks, "sum", 0, ranges, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

// Lexes and lowers a two-variable accumulator loop to a branching LLVM `@sum`.
public fn bool LowerAccumulatorLoopToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerAccumulatorLoopStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Lowers a SELF-RECURSIVE single-parameter function `fn <name>(<p>) { if <p> <cmp>
// <a> return <base> else return <p> <op> <name>(<p> <op2> <step>) }` to the recursive
// `@f1` — an entry block branching on the comparison to a base-case return or a
// recursive block that decrements the parameter, calls the function's OWN id, combines
// with the parameter, and returns. The single parameter is referenced directly as
// `%p0` throughout; literals/operators come from source, the structure is the fixed
// factorial shape. (Demonstrates source -> recursion end to end.)
internal fn bool LowerRecursiveFactorialStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack i64[min max] ifIdx = FirstTokenOfKind(stream, TokenKind.If);
    stack i64[min max] cmpIdx = FirstComparisonIndex(stream);
    stack i64[min max] firstReturn = FirstTokenOfKind(stream, TokenKind.Return);
    if (ifIdx < 0 || cmpIdx < 0 || firstReturn < 0)
    {
        return false;
    }

    stack i64[min max] secondReturn = FirstTokenOfKindAfter(stream, TokenKind.Return, (u64[0 2 ** 63 - 1])firstReturn);
    if (secondReturn < 0)
    {
        return false;
    }

    // The recursive call's `(` is the first LParen after the second `return`; its `n -
    // 1` operands follow.
    stack i64[min max] callLParen = FirstTokenOfKindAfter(stream, TokenKind.LParen, (u64[0 2 ** 63 - 1])secondReturn);
    if (callLParen < 0)
    {
        return false;
    }

    stack TokenKind cmpOp = stream.KindAt((u64[0 2 ** 63 - 1])cmpIdx);
    stack TokenKind mulOp = stream.KindAt((u64[0 2 ** 63 - 1])secondReturn + 2);
    stack TokenKind subOp = stream.KindAt((u64[0 2 ** 63 - 1])callLParen + 2);
    stack i64[min max] condRhs = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])cmpIdx + 1), stream.LengthAt((u64[0 2 ** 63 - 1])cmpIdx + 1));
    stack i64[min max] baseValue = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])firstReturn + 1), stream.LengthAt((u64[0 2 ** 63 - 1])firstReturn + 1));
    stack i64[min max] subStep = ParseDigitSpan(source, stream.StartAt((u64[0 2 ** 63 - 1])callLParen + 3), stream.LengthAt((u64[0 2 ** 63 - 1])callLParen + 3));

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();

    // Entry block: the base-vs-recurse comparison `<p> <cmp> <a>`.
    stack MirValueId p = MirParam(instrs, 0);
    stack MirValueId condRhsConst = MirConstInt(instrs, condRhs);
    stack MirValueId cond = LowerComparison(instrs, cmpOp, p, condRhsConst);
    // Base block: `return <base>`.
    stack MirValueId baseConst = MirConstInt(instrs, baseValue);
    // Recursive block: `<p> <op> <name>(<p> <op2> <step>)`.
    stack MirValueId subConst = MirConstInt(instrs, subStep);
    stack MirValueId reduced = LowerBinOp(instrs, subOp, p, subConst);
    stack MirValueId recursive = MirCall1(instrs, MirFuncIdOf(1), reduced);
    stack MirValueId result = LowerBinOp(instrs, mulOp, p, recursive);

    stack MirBlockId entry = MirCondBlock(blocks, cond, MirBlockIdOf(2), MirBlockIdOf(3));
    stack MirBlockId base = MirReturnBlock(blocks, baseConst);
    stack MirBlockId recurse = MirReturnBlock(blocks, result);

    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, 3));
    stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(base.Index(), 4, 1));
    stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(recurse.Index(), 5, 4));

    switch (EmitLlvmBlocks(instrs, blocks, "f1", 1, ranges, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

// Lexes and lowers a self-recursive factorial-shaped function to the recursive `@f1`.
public fn bool LowerRecursiveFactorialToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerRecursiveFactorialStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// === Name resolution (toward the binder, #33) ===
// A first semantic-analysis pass over the lexed token stream — beyond lexing/lowering:
// it answers "does every identifier USE refer to something declared?" without emitting
// any code. Declared names are the identifiers introduced by `var` (and any function
// parameters between `fn <name> (` and `)`). A use-position identifier that resolves to
// none of them is an unbound name — the canonical first binder diagnostic.

// True when token `index` is in a DECLARING position: right after `var` (a local) or a
// parameter name inside the `( … )` that follows `fn <name>` (so it is being introduced,
// not used).
internal fn bool IsDeclaringIdentifier(borrow TokenStream stream, u64[0 2 ** 63 - 1] index)
{
    if (index == 0)
    {
        return false;
    }

    stack TokenKind prev = stream.KindAt(index - 1);
    if (prev == TokenKind.Var)
    {
        return true;
    }

    // A function name: the identifier introduced right after `fn` (also a callable name,
    // so references to it elsewhere resolve).
    if (prev == TokenKind.Fn)
    {
        return true;
    }

    // A parameter: the identifier sits after `fn <name> (` and before the matching `)`,
    // i.e. the nearest preceding bracket-relevant token is `(` or a `,` following the
    // function name. Approximate with: previous token is `(` or `,` AND a `fn` precedes
    // the opening paren on this declaration.
    if (prev == TokenKind.LParen || prev == TokenKind.Comma)
    {
        // Walk back to the matching `(`; if a `fn` sits two tokens before it, this is a
        // parameter-list identifier.
        stack mut i64[min max] k = (i64[min max])index - 1;
        while willexit (k >= 0)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])k) == TokenKind.LParen)
            {
                return k >= 2 && stream.KindAt((u64[0 2 ** 63 - 1])k - 2) == TokenKind.Fn;
            }

            k = k - 1;
        }
    }

    return false;
}

// True when the identifier at `index` is a function name (introduced right after `fn`).
// Function names live in MODULE scope — callable from any function body.
internal fn bool IsFunctionNameIdentifier(borrow TokenStream stream, u64[0 2 ** 63 - 1] index)
{
    return index > 0 && stream.KindAt(index - 1) == TokenKind.Fn;
}

// Resolves names within ONE scope [start, end): every use-position identifier must bind
// to a name declared IN THIS SCOPE (a `var` local or this function's parameters/name) or
// to a MODULE-level function name (visible everywhere). Params/locals of OTHER functions
// are NOT visible here.
internal fn bool ScopeNamesResolve(borrow TokenStream stream, borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end, borrow IrTable<ParamName> funcNames)
{
    stack mut IrTable<ParamName> declared = new();
    stack mut u64[0 2 ** 63 - 1] i = start;
    while willexit (i < end)
    {
        if (stream.KindAt(i) == TokenKind.Identifier && IsDeclaringIdentifier(stream, i))
        {
            stack mut ParamName name = new();
            name.Start = stream.StartAt(i);
            name.Length = stream.LengthAt(i);
            stack u32[0 max] added = declared.Add(name);
        }

        i = i + 1;
    }

    stack mut u64[0 2 ** 63 - 1] j = start;
    while willexit (j < end)
    {
        if (stream.KindAt(j) == TokenKind.Identifier && !IsDeclaringIdentifier(stream, j))
        {
            stack u64[0 2 ** 63 - 1] useStart = stream.StartAt(j);
            stack u64[0 2 ** 63 - 1] useLength = stream.LengthAt(j);
            stack i64[min max] localIdx = ParamIndexOf(declared, source, useStart, useLength);
            stack i64[min max] funcIdx = ParamIndexOf(funcNames, source, useStart, useLength);
            if (localIdx < 0 && funcIdx < 0)
            {
                return false;
            }
        }

        j = j + 1;
    }

    return true;
}

internal fn bool NamesResolveStream(borrow TokenStream stream, borrow i8[min max][] source)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();

    // Module scope: every function name (visible from any function body).
    stack mut IrTable<ParamName> funcNames = new();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Identifier && IsFunctionNameIdentifier(stream, i))
        {
            stack mut ParamName name = new();
            name.Start = stream.StartAt(i);
            name.Length = stream.LengthAt(i);
            stack u32[0 max] added = funcNames.Add(name);
        }

        i = i + 1;
    }

    stack i64[min max] firstFn = FirstTokenOfKind(stream, TokenKind.Fn);

    // No functions: the whole program is one scope.
    if (firstFn < 0)
    {
        return ScopeNamesResolve(stream, source, 0, count, funcNames);
    }

    // Any top-level region before the first function is its own scope.
    if (firstFn > 0 && !ScopeNamesResolve(stream, source, 0, (u64[0 2 ** 63 - 1])firstFn, funcNames))
    {
        return false;
    }

    // Each function spans from its `fn` to the next `fn` (or end) — a separate scope.
    stack mut u64[0 2 ** 63 - 1] f = (u64[0 2 ** 63 - 1])firstFn;
    while willexit (f < count)
    {
        if (stream.KindAt(f) == TokenKind.Fn)
        {
            stack i64[min max] nextFn = FirstTokenOfKindAfter(stream, TokenKind.Fn, f);
            stack mut u64[0 2 ** 63 - 1] scopeEnd = count;
            if (nextFn >= 0)
            {
                scopeEnd = (u64[0 2 ** 63 - 1])nextFn;
            }

            if (!ScopeNamesResolve(stream, source, f, scopeEnd, funcNames))
            {
                return false;
            }
        }

        f = f + 1;
    }

    return true;
}

// Lexes a program and returns true iff every identifier USE resolves to a declared
// name (a `var` local or a function parameter). The first binder check: unbound-name
// detection over the lexed token stream.
public fn bool ProgramNamesResolve(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return NamesResolveStream(stream, sourceBytes);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// === Call arity checking (toward the typer, #33) ===
// A function name paired with its declared parameter count. The next semantic check
// after name resolution: a call must pass exactly as many arguments as its function
// declares — the first ARITY/TYPE consistency rule.
public struct FuncArity
{
    u64[0 2 ** 63 - 1] Start;
    u64[0 2 ** 63 - 1] Length;
    i64[min max] Arity;

    FuncArity()
    {
        self.Start = 0;
        self.Length = 0;
        self.Arity = 0;
    }
}

// The arity delimited by the `(` at `lparenIndex` and its matching `)`: 0 for an empty
// `()`, else (top-level commas) + 1. Emptiness is decided by the token immediately after
// the `(` — so a SINGLE argument that is itself parenthesized (`f((5))`) still counts as
// one. Paren NESTING is tracked by depth, so a comma inside a nested argument call
// (`f(g(a, b), c)`) is not miscounted as a top-level separator.
internal fn i64[min max] CountArgsBetweenParens(borrow TokenStream stream, u64[0 2 ** 63 - 1] lparenIndex)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();

    // Empty argument list: `(` immediately followed by `)`.
    if (lparenIndex + 1 < count && stream.KindAt(lparenIndex + 1) == TokenKind.RParen)
    {
        return 0;
    }

    // Non-empty: count top-level commas, then add one for the final argument.
    stack mut i64[min max] depth = 0;
    stack mut i64[min max] commas = 0;
    stack mut u64[0 2 ** 63 - 1] k = lparenIndex;
    while willexit (k < count)
    {
        stack TokenKind kind = stream.KindAt(k);
        if (kind == TokenKind.LParen)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen)
        {
            depth = depth - 1;
            if (depth == 0)
            {
                k = count;
            }
        }
        else if (depth == 1 && kind == TokenKind.Comma)
        {
            commas = commas + 1;
        }

        k = k + 1;
    }

    return commas + 1;
}

// The declared arity for the function-name span [start, start+length), or -1 if absent.
internal fn i64[min max] FuncArityOf(borrow IrTable<FuncArity> funcs, borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] length)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack FuncArity existing = funcs.Get((u32[0 max])(i + 1));
        if (SpanEquals(source, existing.Start, existing.Length, start, length))
        {
            return existing.Arity;
        }

        i = i + 1;
    }

    return -1;
}

internal fn bool CallAritiesMatchStream(borrow TokenStream stream, borrow i8[min max][] source)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();

    // Build the fn -> declared-arity table from each `fn <name> ( … )` header.
    stack mut IrTable<FuncArity> funcs = new();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Fn && i + 2 < count && stream.KindAt(i + 1) == TokenKind.Identifier && stream.KindAt(i + 2) == TokenKind.LParen)
        {
            stack mut FuncArity fa = new();
            fa.Start = stream.StartAt(i + 1);
            fa.Length = stream.LengthAt(i + 1);
            fa.Arity = CountArgsBetweenParens(stream, i + 2);
            stack u32[0 max] added = funcs.Add(fa);
        }

        i = i + 1;
    }

    // Each call site `<name> ( … )` (an identifier+`(` not preceded by `fn`) must pass
    // exactly the function's declared number of arguments.
    stack mut u64[0 2 ** 63 - 1] j = 0;
    while willexit (j < count)
    {
        stack bool isCall = stream.KindAt(j) == TokenKind.Identifier && j + 1 < count && stream.KindAt(j + 1) == TokenKind.LParen;
        stack bool isDef = j > 0 && stream.KindAt(j - 1) == TokenKind.Fn;
        if (isCall && !isDef)
        {
            stack i64[min max] declaredArity = FuncArityOf(funcs, source, stream.StartAt(j), stream.LengthAt(j));
            if (declaredArity >= 0)
            {
                stack i64[min max] callArity = CountArgsBetweenParens(stream, j + 1);
                if (callArity != declaredArity)
                {
                    return false;
                }
            }
        }

        j = j + 1;
    }

    return true;
}

// Lexes a module and returns true iff every call to a defined function passes exactly
// that function's declared number of arguments. The first arity/type consistency check.
public fn bool ProgramCallAritiesMatch(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return CallAritiesMatchStream(stream, sourceBytes);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// === Redeclaration checking (toward the binder, #33) ===
// The third semantic check: within ONE scope no name may be declared twice. Scopes are
// per-function — the same parameter name in two different functions is fine, but a
// duplicate parameter or a local redeclared in the same function is an error.

// True iff the declared names (params + `fn` name + `var` locals) in the half-open token
// range [start, end) are all distinct.
internal fn bool ScopeDeclarationsUnique(borrow TokenStream stream, borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack mut IrTable<ParamName> declared = new();
    stack mut u64[0 2 ** 63 - 1] i = start;
    while willexit (i < end)
    {
        // The function's OWN name lives in MODULE scope, not its local scope — so a
        // parameter or local may legally share it; only params + locals are checked here.
        if (stream.KindAt(i) == TokenKind.Identifier && IsDeclaringIdentifier(stream, i) && !IsFunctionNameIdentifier(stream, i))
        {
            stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt(i);
            stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt(i);
            if (ParamIndexOf(declared, source, nameStart, nameLength) >= 0)
            {
                return false;
            }

            stack mut ParamName name = new();
            name.Start = nameStart;
            name.Length = nameLength;
            stack u32[0 max] added = declared.Add(name);
        }

        i = i + 1;
    }

    return true;
}

internal fn bool DeclarationsUniqueStream(borrow TokenStream stream, borrow i8[min max][] source)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack i64[min max] firstFn = FirstTokenOfKind(stream, TokenKind.Fn);

    // No functions: the whole program is one scope.
    if (firstFn < 0)
    {
        return ScopeDeclarationsUnique(stream, source, 0, count);
    }

    // Any top-level region before the first function is its own scope.
    if (firstFn > 0 && !ScopeDeclarationsUnique(stream, source, 0, (u64[0 2 ** 63 - 1])firstFn))
    {
        return false;
    }

    // Each function spans from its `fn` to the next `fn` (or end) — a separate scope.
    stack mut u64[0 2 ** 63 - 1] f = (u64[0 2 ** 63 - 1])firstFn;
    while willexit (f < count)
    {
        if (stream.KindAt(f) == TokenKind.Fn)
        {
            stack i64[min max] nextFn = FirstTokenOfKindAfter(stream, TokenKind.Fn, f);
            stack mut u64[0 2 ** 63 - 1] scopeEnd = count;
            if (nextFn >= 0)
            {
                scopeEnd = (u64[0 2 ** 63 - 1])nextFn;
            }

            if (!ScopeDeclarationsUnique(stream, source, f, scopeEnd))
            {
                return false;
            }
        }

        f = f + 1;
    }

    return true;
}

// Lexes a program and returns true iff no scope declares the same name twice (a
// duplicate parameter, or a local/parameter redeclared within one function). The same
// name in DIFFERENT functions is allowed. The redeclaration diagnostic.
public fn bool ProgramDeclarationsUnique(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return DeclarationsUniqueStream(stream, sourceBytes);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// === Module-scope function-name uniqueness (toward the binder, #33) ===
// The per-function redeclaration pass deliberately leaves the MODULE scope unchecked
// (each function name lives there). This pass closes that gap — the gap an adversarial
// review flagged — by rejecting two functions defined with the same name, the way two
// parameters or two locals in one function are already rejected.
internal fn bool FunctionNamesUniqueStream(borrow TokenStream stream, borrow i8[min max][] source)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut IrTable<ParamName> seen = new();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Identifier && IsFunctionNameIdentifier(stream, i))
        {
            stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt(i);
            stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt(i);
            if (ParamIndexOf(seen, source, nameStart, nameLength) >= 0)
            {
                return false;
            }

            stack mut ParamName name = new();
            name.Start = nameStart;
            name.Length = nameLength;
            stack u32[0 max] added = seen.Add(name);
        }

        i = i + 1;
    }

    return true;
}

// Lexes a module and returns true iff no two functions are defined with the same name.
public fn bool ProgramFunctionNamesUnique(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return FunctionNamesUniqueStream(stream, sourceBytes);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// === Expression type inference (toward the typer, #33) ===
// The first step that reasons about TYPES, not names. This integer grammar has two value
// types: an integer (`Int`, lowered to LLVM `i64`) and a boolean (`Bool`, an `i1` produced
// by a comparison). An expression's type is decided by its top operator: a comparison
// (`<`/`>`) yields `Bool`, anything else yields `Int`. A second comparison makes the
// expression compare a boolean (`a < b < c`) — ill-typed in this grammar, so `Error`.
public enum ExprType
{
    IntType,
    BoolType,
    ErrorType,
}

// True for EVERY comparison operator the lexer can produce — `<` `>` `<=` `>=` `==` `!=`.
// (The Lt/Gt-only `FirstComparisonIndex` used by the LOWERING is deliberately narrower,
// because `LowerComparison` only emits signed `slt`/`sgt`; type inference must recognize
// the full set so a `<=`/`==`/`!=` expression is correctly typed boolean.)
internal fn bool IsComparisonOperator(TokenKind k)
{
    return k == TokenKind.Lt
        || k == TokenKind.Gt
        || k == TokenKind.Lte
        || k == TokenKind.Gte
        || k == TokenKind.EqEq
        || k == TokenKind.Neq;
}

// Infers the type of the expression in the half-open token range [start, end). Only
// TOP-LEVEL (paren-depth 0) comparisons decide the type — a comparison nested in
// parentheses belongs to an inner expression (a call argument `f(a < b)`, a grouped
// sub-expression), so it does NOT make the whole expression boolean. This is a token
// approximation: it does not strip redundant outer parens, so a fully-parenthesized
// comparison `(a < b)` reads as `Int` (its `<` is at depth 1) — a real structural typer
// is the #33 work; bare conditions / single-primary comparisons are the supported shape.
internal fn ExprType InferTypeInRange(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack mut i64[min max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] comparisons = 0;
    stack mut u64[0 2 ** 63 - 1] i = start;
    while willexit (i < end)
    {
        stack TokenKind k = stream.KindAt(i);
        if (k == TokenKind.LParen)
        {
            depth = depth + 1;
        }
        else if (k == TokenKind.RParen)
        {
            depth = depth - 1;
        }
        else if (depth == 0 && IsComparisonOperator(k))
        {
            comparisons = comparisons + 1;
        }

        i = i + 1;
    }

    // Two or more comparisons compare a boolean operand — ill-typed.
    if (comparisons >= 2)
    {
        return ExprType.ErrorType;
    }

    // Exactly one comparison yields a boolean; none yields an integer.
    if (comparisons == 1)
    {
        return ExprType.BoolType;
    }

    return ExprType.IntType;
}

internal fn ExprType InferTypeStream(borrow TokenStream stream)
{
    return InferTypeInRange(stream, 0, stream.Count());
}

// Lexes one expression and infers its type: `Int` for arithmetic / a literal / a
// variable / a call, `Bool` for a single comparison, `Error` for a chained comparison.
public fn ExprType InferExpressionType(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return InferTypeStream(stream);
        case LexResult<TokenStream>.Err(var lexError):
            return ExprType.ErrorType;
    }
}

// A statement-level type rule: a `while` condition must be a boolean. The condition spans
// from `while` to its loop body's `{`; it is well-typed only if it infers to `BoolType`
// (exactly one comparison) — a bare integer (`while i`) or a chained comparison
// (`while a < b < c`) is a type error.
internal fn bool WhileConditionsAreBooleanStream(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.While)
        {
            stack i64[min max] brace = FirstTokenOfKindAfter(stream, TokenKind.LBrace, i);
            if (brace < 0)
            {
                return false;
            }

            stack ExprType conditionType = InferTypeInRange(stream, i + 1, (u64[0 2 ** 63 - 1])brace);
            if (conditionType == ExprType.BoolType)
            {
                // Well-typed condition; keep scanning.
            }
            else
            {
                return false;
            }
        }

        i = i + 1;
    }

    return true;
}

// Lexes a program and returns true iff every `while` condition has boolean type.
public fn bool ProgramWhileConditionsAreBoolean(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return WhileConditionsAreBooleanStream(stream);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// The same statement-level rule for `if` conditions. In this grammar an `if` condition is
// a single-primary comparison `<a> <cmp> <b>` — the three tokens at `if`+1..`if`+3, the
// exact positions the `if`/`else if` lowering parses — so it is well-typed only if those
// tokens infer to `BoolType`. A non-comparison condition (`if x ...`) is a type error; so
// is a CHAINED comparison (`if a < b < c ...`), detected because a single-primary
// condition is followed by its then-value (a primary), whereas a chained comparison puts
// a comparison operator at `if`+4. (This positional check supports only bare single-primary
// conditions; a structural typer for parenthesized/nested conditions is the #33 work.)
internal fn bool IfConditionsAreBooleanStream(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.If)
        {
            stack ExprType conditionType = InferTypeInRange(stream, i + 1, i + 4);
            stack bool chained = IsComparisonOperator(stream.KindAt(i + 4));
            if (conditionType == ExprType.BoolType && !chained)
            {
                // Well-typed boolean condition; keep scanning.
            }
            else
            {
                return false;
            }
        }

        i = i + 1;
    }

    return true;
}

// Lexes a program and returns true iff every `if` condition has boolean type.
public fn bool ProgramIfConditionsAreBoolean(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return IfConditionsAreBooleanStream(stream);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// An operand-type rule: a comparison yields a boolean, and a boolean is never a valid
// operand of arithmetic or a function argument in this integer grammar. The ONLY way a
// comparison's result becomes such an operand is by parenthesizing it — `(a < b) + 1`,
// `f(a < b)` — i.e. a comparison operator appearing at paren-depth >= 1. A comparison at
// paren-depth 0 is the top-level operator of its expression (a condition / return value)
// and is fine, even when an OPERAND is parenthesized arithmetic (`(a + b) < c`).
internal fn bool NoBooleanOperandStream(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut i64[min max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack TokenKind k = stream.KindAt(i);
        if (k == TokenKind.LParen)
        {
            depth = depth + 1;
        }
        else if (k == TokenKind.RParen)
        {
            depth = depth - 1;
        }
        else if (depth >= 1 && IsComparisonOperator(k))
        {
            // A comparison nested in parentheses feeds its boolean result into an
            // arithmetic or call context that expects an integer — a type error.
            return false;
        }

        i = i + 1;
    }

    return true;
}

// Lexes a program and returns true iff no comparison's boolean result is used as an
// arithmetic / call operand (no comparison nested inside parentheses).
public fn bool ProgramNoBooleanOperand(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return NoBooleanOperandStream(stream);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// === Composed semantic-analysis gate (toward the binder/typer, #33) ===
// The front-end's single "is this program well-formed?" verdict: every binder and typer
// pass run over ONE lex. A program is semantically valid only if all hold — names bind,
// calls match arity, no scope redeclares, function names are unique, every condition is
// boolean, and no comparison's boolean result is used as an integer operand.
internal fn bool SemanticallyValidStream(borrow TokenStream stream, borrow i8[min max][] source)
{
    return NamesResolveStream(stream, source)
        && CallAritiesMatchStream(stream, source)
        && DeclarationsUniqueStream(stream, source)
        && FunctionNamesUniqueStream(stream, source)
        && WhileConditionsAreBooleanStream(stream)
        && IfConditionsAreBooleanStream(stream)
        && NoBooleanOperandStream(stream);
}

// Lexes a program once and returns true iff it passes EVERY binder and typer check.
public fn bool ProgramSemanticallyValid(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return SemanticallyValidStream(stream, sourceBytes);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// The CHECKED compile path: the front-end semantic gate guards the back-end codegen —
// the canonical pipeline (lex → analyze → lower), where analysis gates lowering. A
// module is lowered to LLVM ONLY if it passes every binder/typer check; a semantically
// invalid program (an unbound name, a wrong-arity call, a duplicate function, …) emits
// NOTHING and returns false, so codegen never produces wrong output for a bad program.
// Lexes once and shares the token stream between the check and the lowering.
public fn bool CompileModuleChecked(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            if (!SemanticallyValidStream(stream, sourceBytes))
            {
                return false;
            }

            return LowerModuleStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// === Structural expression typer (toward the real typer, #33) ===
// The token-counting type inference (InferExpressionType) has a structural ceiling — it
// cannot see expression shape, so it mis-types a comparison inside a call argument, a
// parenthesized comparison, or a chained comparison. The fix is a real expression AST
// and a typer that recurses over it. This is that AST: a FLAT node table (free functions
// over a directly-owned `IrTable<ExprNode>`, per the host-codegen discipline — no wrapper
// struct, no nested generic field). Each node is one of five kinds; Binary/Compare carry
// an operator and two child node ids; a Call carries its (single) argument node id;
// parentheses are a parser concern and produce no node (the inner expression stands in).
public enum ExprKind
{
    IntLitExpr,
    NameExpr,
    BinaryExpr,
    CompareExpr,
    CallExpr,
}

public struct ExprNode
{
    ExprKind Kind;
    TokenKind Op;
    u32[0 max] Left;
    u32[0 max] Right;
    // A call's 2nd/3rd/4th argument nodes (0 = none); unused by the other node kinds. The
    // AST call model carries up to four arguments (Right = first, Arg2/Arg3/Arg4 = the rest).
    u32[0 max] Arg2;
    u32[0 max] Arg3;
    u32[0 max] Arg4;
    i64[min max] Imm;

    ExprNode()
    {
        self.Kind = ExprKind.IntLitExpr;
        self.Op = TokenKind.Plus;
        self.Left = 0;
        self.Right = 0;
        self.Arg2 = 0;
        self.Arg3 = 0;
        self.Arg4 = 0;
        self.Imm = 0;
    }
}

// Node builders — each appends one node and returns its 1-based id.
public fn u32[0 max] MakeIntLit(mut borrow IrTable<ExprNode> nodes, i64[min max] value)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.IntLitExpr;
    node.Imm = value;
    return nodes.Add(node);
}

public fn u32[0 max] MakeName(mut borrow IrTable<ExprNode> nodes, u32[0 max] paramIndex)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.NameExpr;
    node.Left = paramIndex;
    return nodes.Add(node);
}

public fn u32[0 max] MakeBinary(mut borrow IrTable<ExprNode> nodes, TokenKind op, u32[0 max] left, u32[0 max] right)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.BinaryExpr;
    node.Op = op;
    node.Left = left;
    node.Right = right;
    return nodes.Add(node);
}

public fn u32[0 max] MakeCompare(mut borrow IrTable<ExprNode> nodes, TokenKind op, u32[0 max] left, u32[0 max] right)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.CompareExpr;
    node.Op = op;
    node.Left = left;
    node.Right = right;
    return nodes.Add(node);
}

// A call node. `callee` is the resolved function id (0 = unresolved, filled in once the
// parser threads a function-name table); `argCount` is the number of arguments WRITTEN at
// the call site (checked against the callee's declared arity); `arg1`..`arg4` are the up-to-
// four argument nodes the AST model carries (0 = none, filled contiguously — so 0-, 1-, 2-,
// 3-, and 4-argument calls lower).
public fn u32[0 max] MakeCall(mut borrow IrTable<ExprNode> nodes, u32[0 max] callee, u32[0 max] argCount, u32[0 max] arg1, u32[0 max] arg2, u32[0 max] arg3, u32[0 max] arg4)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.CallExpr;
    node.Left = callee;
    node.Imm = (i64[min max])argCount;
    node.Right = arg1;
    node.Arg2 = arg2;
    node.Arg3 = arg3;
    node.Arg4 = arg4;
    return nodes.Add(node);
}

// The STRUCTURAL type of the expression rooted at `id`, recursing over the AST. A literal,
// a variable, and a call are integers; an arithmetic node is an integer ONLY if both
// operands are integers (else a type error — a boolean fed to arithmetic, e.g.
// `(a < b) + 1`); a comparison is a boolean ONLY if both operands are integers (else a
// type error — a boolean compared, e.g. the chained `a < b < c` = compare(compare(a,b),c)).
// Unlike the token heuristic, this is correct on calls, parens, and chains by construction.
// As `TypeOfNode`, but a name's type comes from `localTypes` (a per-index type table:
// entry `index+1` is 1 for a BOOLEAN local, anything else — including absent — is integer,
// covering parameters and integer locals). This lets a `var` local carry its initializer's
// type, so a boolean local returns correctly (zero-extended) yet `bool + int` is a type
// error. An empty `localTypes` recovers the param-only behavior (every name is integer).
public fn ExprType TypeOfNodeWithLocals(borrow IrTable<ExprNode> nodes, u32[0 max] id, borrow IrTable<u32[0 max]> localTypes)
{
    if (!nodes.Contains(id))
    {
        return ExprType.ErrorType;
    }

    stack ExprNode node = nodes.Get(id);
    switch (node.Kind)
    {
        case ExprKind.IntLitExpr:
            return ExprType.IntType;
        case ExprKind.NameExpr:
            if (localTypes.Contains(node.Left + 1) && localTypes.Get(node.Left + 1) == 1)
            {
                return ExprType.BoolType;
            }

            return ExprType.IntType;
        case ExprKind.CallExpr:
            return ExprType.IntType;
        case ExprKind.BinaryExpr:
            if (TypeOfNodeWithLocals(nodes, node.Left, localTypes) == ExprType.IntType && TypeOfNodeWithLocals(nodes, node.Right, localTypes) == ExprType.IntType)
            {
                return ExprType.IntType;
            }

            return ExprType.ErrorType;
        case ExprKind.CompareExpr:
            if (TypeOfNodeWithLocals(nodes, node.Left, localTypes) == ExprType.IntType && TypeOfNodeWithLocals(nodes, node.Right, localTypes) == ExprType.IntType)
            {
                return ExprType.BoolType;
            }

            return ExprType.ErrorType;
    }
}

// Types an expression where every name is a parameter (integer) — the common case.
public fn ExprType TypeOfNode(borrow IrTable<ExprNode> nodes, u32[0 max] id)
{
    stack mut IrTable<u32[0 max]> noLocalTypes = new();
    return TypeOfNodeWithLocals(nodes, id, noLocalTypes);
}

// === Recursive-descent expression parser (toward the real typer, #33) ===
// Builds the `ExprNode` AST from source. Stark has no mutable-borrow cursor (an in-out
// primitive index is the write-only `out` mode), so each parser THREADS the cursor by
// RETURN VALUE: it takes a cursor by value and returns the node it built plus the next
// cursor. Recursion (parentheses, call arguments) composes through these returns. Grammar,
// lowest precedence first: compare := add ((< > <= >= == !=) add)* ; add := mul ((+ -) mul)* ;
// mul := primary ((* / %) primary)* ; primary := int | name | name(args) | ( compare ).
// Left-associative folding makes a chained comparison a nested Compare node, which the
// structural typer then flags.
public struct ParseResult
{
    u32[0 max] NodeId;
    u64[0 2 ** 63 - 1] Next;

    ParseResult()
    {
        self.NodeId = 0;
        self.Next = 0;
    }
}

internal fn ParseResult MakeParseResult(u32[0 max] nodeId, u64[0 2 ** 63 - 1] next)
{
    stack mut ParseResult result = new();
    result.NodeId = nodeId;
    result.Next = next;
    return result;
}

// Resolves an identifier span to a 0-based parameter index in first-appearance order,
// appending it to `params` the first time it is seen (so `a + b` makes `a`->0, `b`->1,
// and a reused name maps to the same index).
internal fn u32[0 max] ResolveParam(mut borrow IrTable<ParamName> params, borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] length)
{
    stack i64[min max] existing = ParamIndexOf(params, source, start, length);
    if (existing >= 0)
    {
        return (u32[0 max])existing;
    }

    stack mut ParamName name = new();
    name.Start = start;
    name.Length = length;
    stack u32[0 max] added = params.Add(name);
    return added - 1;
}

internal fn ParseResult ParsePrimaryIn(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, borrow IrTable<ParamName> funcNames, u64[0 2 ** 63 - 1] cursor)
{
    stack TokenKind k = stream.KindAt(cursor);
    if (k == TokenKind.IntegerLiteral)
    {
        stack i64[min max] value = ParseDigitSpan(source, stream.StartAt(cursor), stream.LengthAt(cursor));
        return MakeParseResult(MakeIntLit(nodes, value), cursor + 1);
    }

    if (k == TokenKind.Minus)
    {
        // Unary minus: `-<primary>` lowers as `0 - <primary>`. It binds at the PRIMARY level
        // (tighter than the binary operators), so `-x * y` parses as `(-x) * y` and `2 - -3`
        // as `2 - (-3)`. A leading `-` is unambiguously unary here (a binary `-` is consumed
        // between terms by ParseAdd, never at the start of a primary).
        stack ParseResult operand = ParsePrimaryIn(stream, source, nodes, params, funcNames, cursor + 1);
        stack u32[0 max] zero = MakeIntLit(nodes, 0);
        stack u32[0 max] negated = MakeBinary(nodes, TokenKind.Minus, zero, operand.NodeId);
        return MakeParseResult(negated, operand.Next);
    }

    if (k == TokenKind.LParen)
    {
        // Parenthesized sub-expression: parse it, then skip the matching `)`.
        stack ParseResult inner = ParseExprIn(stream, source, nodes, params, funcNames, cursor + 1);
        return MakeParseResult(inner.NodeId, inner.Next + 1);
    }

    if (k == TokenKind.Identifier && stream.KindAt(cursor + 1) == TokenKind.LParen)
    {
        // A call `name ( args )`. The callee NAME at `cursor` resolves against the
        // function-name table to its 1-based function id (0 = unresolved — e.g. a call in a
        // single-function context, whose table is empty, or a call to an unknown function).
        stack i64[min max] calleeIndex = ParamIndexOf(funcNames, source, stream.StartAt(cursor), stream.LengthAt(cursor));
        stack mut u32[0 max] callee = 0;
        if (calleeIndex >= 0)
        {
            callee = (u32[0 max])(calleeIndex + 1);
        }

        // Empty args -> a 0-argument call.
        if (stream.KindAt(cursor + 2) == TokenKind.RParen)
        {
            return MakeParseResult(MakeCall(nodes, callee, 0, 0, 0, 0, 0), cursor + 3);
        }

        // Parse the first argument, then consume any further comma-separated arguments,
        // CAPTURING up to four and COUNTING the total — the count is checked against the
        // callee's arity at validation (the AST model lowers up to four arguments, so a wider
        // call is rejected by the count, not silently truncated).
        stack ParseResult firstArg = ParseExprIn(stream, source, nodes, params, funcNames, cursor + 2);
        stack mut u64[0 2 ** 63 - 1] argCursor = firstArg.Next;
        stack mut u32[0 max] argCount = 1;
        stack mut u32[0 max] secondArg = 0;
        stack mut u32[0 max] thirdArg = 0;
        stack mut u32[0 max] fourthArg = 0;
        while willexit (stream.KindAt(argCursor) == TokenKind.Comma)
        {
            stack ParseResult more = ParseExprIn(stream, source, nodes, params, funcNames, argCursor + 1);
            if (argCount == 1)
            {
                secondArg = more.NodeId;
            }
            else if (argCount == 2)
            {
                thirdArg = more.NodeId;
            }
            else if (argCount == 3)
            {
                fourthArg = more.NodeId;
            }

            argCursor = more.Next;
            argCount = argCount + 1;
        }

        return MakeParseResult(MakeCall(nodes, callee, argCount, firstArg.NodeId, secondArg, thirdArg, fourthArg), argCursor + 1);
    }

    // A bare name: resolve it to a parameter index (first-appearance order).
    stack u32[0 max] paramIndex = ResolveParam(params, source, stream.StartAt(cursor), stream.LengthAt(cursor));
    return MakeParseResult(MakeName(nodes, paramIndex), cursor + 1);
}

internal fn ParseResult ParseMulIn(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, borrow IrTable<ParamName> funcNames, u64[0 2 ** 63 - 1] cursor)
{
    stack mut ParseResult left = ParsePrimaryIn(stream, source, nodes, params, funcNames, cursor);
    while willexit (IsProductOpToken(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ParseResult right = ParsePrimaryIn(stream, source, nodes, params, funcNames, left.Next + 1);
        left.NodeId = MakeBinary(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

internal fn ParseResult ParseAddIn(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, borrow IrTable<ParamName> funcNames, u64[0 2 ** 63 - 1] cursor)
{
    stack mut ParseResult left = ParseMulIn(stream, source, nodes, params, funcNames, cursor);
    while willexit (IsAddSubToken(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ParseResult right = ParseMulIn(stream, source, nodes, params, funcNames, left.Next + 1);
        left.NodeId = MakeBinary(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

// The full expression parser, parameterized by a function-name table so a call's callee
// resolves to its function id. `ParseExpr` below is the thin wrapper used by the
// single-function/expression paths (which pass an empty table — their calls, if any,
// resolve to the 0 sentinel); the multi-function module compiler calls this directly.
internal fn ParseResult ParseExprIn(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, borrow IrTable<ParamName> funcNames, u64[0 2 ** 63 - 1] cursor)
{
    stack mut ParseResult left = ParseAddIn(stream, source, nodes, params, funcNames, cursor);
    while willexit (IsComparisonOperator(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ParseResult right = ParseAddIn(stream, source, nodes, params, funcNames, left.Next + 1);
        left.NodeId = MakeCompare(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

// Single-function/expression entry: no cross-function call resolution (an empty
// function-name table), so an unqualified `name(args)` keeps the 0 callee sentinel.
internal fn ParseResult ParseExpr(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, u64[0 2 ** 63 - 1] cursor)
{
    stack mut IrTable<ParamName> noFuncs = new();
    return ParseExprIn(stream, source, nodes, params, noFuncs, cursor);
}

// Lexes ONE expression, parses it into the AST, and returns the STRUCTURAL type of the
// root — the correct successor to the token-counting `InferExpressionType`.
public fn ExprType InferSourceExpressionType(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack mut IrTable<ExprNode> nodes = new();
            stack mut IrTable<ParamName> params = new();
            stack ParseResult root = ParseExpr(stream, sourceBytes, nodes, params, 0);
            return TypeOfNode(nodes, root.NodeId);
        case LexResult<TokenStream>.Err(var lexError):
            return ExprType.ErrorType;
    }
}

// Lowers an expression AST node to MIR, recursing over its children — the bridge from
// the parser/AST front-end to the existing MIR/codegen back end. A literal becomes a MIR
// constant; an arithmetic node its `add`/`sub`/… over the lowered operands; a comparison
// its `icmp`. A name lowers to a parameter (`%pK`) UNLESS its index has a `localOverrides`
// entry — a `var` local's index is redirected to the SSA value its initializer produced,
// so locals and parameters share one index space but lower to different values. The
// override table is positional: entry at index `paramIndex + 1` holds the local's MIR
// value id (0 = a real parameter, no override). A `call` lowers to a placeholder callee
// (callee resolution is later #33 work).
public fn MirValueId LowerExprNodeWithLocals(borrow IrTable<ExprNode> nodes, u32[0 max] id, mut borrow IrTable<MirInstruction> instrs, borrow IrTable<u32[0 max]> localOverrides)
{
    if (!nodes.Contains(id))
    {
        return MirConstInt(instrs, 0);
    }

    stack ExprNode node = nodes.Get(id);
    switch (node.Kind)
    {
        case ExprKind.IntLitExpr:
            return MirConstInt(instrs, node.Imm);
        case ExprKind.NameExpr:
            stack u32[0 max] paramIndex = node.Left;
            if (localOverrides.Contains(paramIndex + 1))
            {
                stack u32[0 max] override = localOverrides.Get(paramIndex + 1);
                if (override != 0)
                {
                    return MirValueIdOf(override);
                }
            }

            return MirParam(instrs, paramIndex);
        case ExprKind.CallExpr:
            if (node.Arg4 != 0)
            {
                stack MirValueId a0 = LowerExprNodeWithLocals(nodes, node.Right, instrs, localOverrides);
                stack MirValueId a1 = LowerExprNodeWithLocals(nodes, node.Arg2, instrs, localOverrides);
                stack MirValueId a2 = LowerExprNodeWithLocals(nodes, node.Arg3, instrs, localOverrides);
                stack MirValueId a3 = LowerExprNodeWithLocals(nodes, node.Arg4, instrs, localOverrides);
                return MirCall4(instrs, MirFuncIdOf(node.Left), a0, a1, a2, a3);
            }

            if (node.Arg3 != 0)
            {
                stack MirValueId b0 = LowerExprNodeWithLocals(nodes, node.Right, instrs, localOverrides);
                stack MirValueId b1 = LowerExprNodeWithLocals(nodes, node.Arg2, instrs, localOverrides);
                stack MirValueId b2 = LowerExprNodeWithLocals(nodes, node.Arg3, instrs, localOverrides);
                return MirCall3(instrs, MirFuncIdOf(node.Left), b0, b1, b2);
            }

            if (node.Arg2 != 0)
            {
                stack MirValueId firstCallArg = LowerExprNodeWithLocals(nodes, node.Right, instrs, localOverrides);
                stack MirValueId secondCallArg = LowerExprNodeWithLocals(nodes, node.Arg2, instrs, localOverrides);
                return MirCall2(instrs, MirFuncIdOf(node.Left), firstCallArg, secondCallArg);
            }

            if (node.Right != 0)
            {
                stack MirValueId callArgument = LowerExprNodeWithLocals(nodes, node.Right, instrs, localOverrides);
                return MirCall1(instrs, MirFuncIdOf(node.Left), callArgument);
            }

            return MirCall(instrs, MirFuncIdOf(node.Left));
        case ExprKind.BinaryExpr:
            stack MirValueId binLeft = LowerExprNodeWithLocals(nodes, node.Left, instrs, localOverrides);
            stack MirValueId binRight = LowerExprNodeWithLocals(nodes, node.Right, instrs, localOverrides);
            return LowerBinOp(instrs, node.Op, binLeft, binRight);
        case ExprKind.CompareExpr:
            stack MirValueId cmpLeft = LowerExprNodeWithLocals(nodes, node.Left, instrs, localOverrides);
            stack MirValueId cmpRight = LowerExprNodeWithLocals(nodes, node.Right, instrs, localOverrides);
            return LowerComparison(instrs, node.Op, cmpLeft, cmpRight);
    }
}

// Lowers an expression with NO locals (every name is a parameter) — the common case.
public fn MirValueId LowerExprNode(borrow IrTable<ExprNode> nodes, u32[0 max] id, mut borrow IrTable<MirInstruction> instrs)
{
    stack mut IrTable<u32[0 max]> noOverrides = new();
    return LowerExprNodeWithLocals(nodes, id, instrs, noOverrides);
}

// The unified front-to-back path for a single expression: lex -> parse to AST -> lower
// the AST to MIR -> emit an LLVM `@main` that returns the expression's value. This wires
// the recursive-descent parser to the MIR/codegen back end (source -> AST -> MIR -> LLVM).
public fn bool CompileExpressionToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack mut IrTable<ExprNode> nodes = new();
            stack mut IrTable<ParamName> params = new();
            stack ParseResult root = ParseExpr(stream, sourceBytes, nodes, params, 0);
            // Type-gate codegen: an ill-typed expression (a chained comparison, a boolean
            // fed to arithmetic) produces no output.
            stack ExprType rootType = TypeOfNode(nodes, root.NodeId);
            if (rootType == ExprType.ErrorType)
            {
                return false;
            }

            stack mut IrTable<MirInstruction> instrs = new();
            stack mut IrTable<MirBlock> blocks = new();
            stack MirValueId value = LowerExprNode(nodes, root.NodeId, instrs);
            // A boolean expression is an `i1`; zero-extend it to `i64` for the return.
            stack mut MirValueId returnValue = value;
            if (rootType == ExprType.BoolType)
            {
                returnValue = MirZExt(instrs, value);
            }

            stack MirBlockId entry = MirReturnBlock(blocks, returnValue);
            stack u32[0 max] instrCount = (u32[0 max])instrs.Count();
            stack u32[0 max] paramCount = (u32[0 max])params.Count();
            switch (EmitLlvmDefinitionWithParams(instrs, blocks, "main", paramCount, entry.Index(), 1, instrCount, sink))
            {
                case MemoryStatus.Ok:
                    return true;
                case MemoryStatus.Err(var error):
                    return false;
            }
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Seeds the symbol table with the parameters declared in a `( … )` signature, in
// DECLARATION order — so the parameter index is fixed by the signature, not by which name
// the body happens to reference first.
internal fn void SeedSignatureParams(borrow TokenStream stream, borrow i8[min max][] source, u64[0 2 ** 63 - 1] lparenIndex, mut borrow IrTable<ParamName> params)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] cursor = lparenIndex + 1;
    while willexit (cursor < count && stream.KindAt(cursor) != TokenKind.RParen)
    {
        if (stream.KindAt(cursor) == TokenKind.Identifier)
        {
            stack u32[0 max] index = ResolveParam(params, source, stream.StartAt(cursor), stream.LengthAt(cursor));
        }

        cursor = cursor + 1;
    }
}

// The unified front-to-back path for a single FUNCTION declaration `fn <name>(<params>)
// { return <expr> }`: lex -> seed the symbol table from the SIGNATURE (so parameter order
// is authoritative) -> parse the return expression (names resolve to signature params) ->
// lower to MIR -> emit `@main`. The next step up from `CompileExpressionToLlvm`, where
// parameters come from a real declaration instead of first-appearance in an expression.
public fn bool CompileFunctionToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack i64[min max] fnIndex = FirstTokenOfKind(stream, TokenKind.Fn);
            stack i64[min max] returnIndex = FirstTokenOfKind(stream, TokenKind.Return);
            if (fnIndex < 0 || returnIndex < 0)
            {
                return false;
            }

            // The signature's `(` follows `fn <name>`.
            stack mut IrTable<ParamName> params = new();
            SeedSignatureParams(stream, sourceBytes, (u64[0 2 ** 63 - 1])fnIndex + 2, params);

            // Freeze the declared arity: the body may only reference the signature's
            // parameters. If parsing the body APPENDS a name (an undeclared identifier),
            // that is an unbound reference — reject rather than emit a phantom parameter.
            stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();
            stack mut IrTable<ExprNode> nodes = new();
            stack ParseResult root = ParseExpr(stream, sourceBytes, nodes, params, (u64[0 2 ** 63 - 1])returnIndex + 1);
            if (params.Count() != signatureParamCount)
            {
                return false;
            }

            // Type-gate codegen: an ill-typed return expression produces no output.
            stack ExprType rootType = TypeOfNode(nodes, root.NodeId);
            if (rootType == ExprType.ErrorType)
            {
                return false;
            }

            stack mut IrTable<MirInstruction> instrs = new();
            stack mut IrTable<MirBlock> blocks = new();
            stack MirValueId value = LowerExprNode(nodes, root.NodeId, instrs);
            // A boolean return expression is an `i1`; zero-extend it to `i64`.
            stack mut MirValueId returnValue = value;
            if (rootType == ExprType.BoolType)
            {
                returnValue = MirZExt(instrs, value);
            }

            stack MirBlockId entry = MirReturnBlock(blocks, returnValue);
            stack u32[0 max] instrCount = (u32[0 max])instrs.Count();
            stack u32[0 max] paramCount = (u32[0 max])signatureParamCount;
            switch (EmitLlvmDefinitionWithParams(instrs, blocks, "main", paramCount, entry.Index(), 1, instrCount, sink))
            {
                case MemoryStatus.Ok:
                    return true;
                case MemoryStatus.Err(var error):
                    return false;
            }
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// True iff every CALL node in the AST is well-formed against the module: (1) its callee
// resolved to a defined function (a non-0 1-based id — a 0 would emit an invalid `@f0`);
// (2) its argument count is at most four (the AST call model carries up to four arguments,
// so a wider call cannot be lowered); (3) that count matches the callee's declared parameter
// count (an arity mismatch would emit a `call` LLVM rejects); and (4) each present argument
// is integer-typed (a boolean `i1` argument would be passed as an `i64` call operand —
// invalid LLVM, since parameters are `i64`). `funcParamCounts` is indexed by 1-based id.
// `localTypes` records each name index's type (1 = boolean), so a boolean LOCAL passed as a
// call argument (`var c = a < b; f(c)`) is caught too — `TypeOfNode` alone is locals-blind
// and would mis-type that local as an integer.
internal fn bool ValidateModuleCalls(borrow IrTable<ExprNode> nodes, borrow IrTable<u32[0 max]> funcParamCounts, borrow IrTable<u32[0 max]> localTypes)
{
    stack u64[0 2 ** 63 - 1] count = nodes.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack ExprNode node = nodes.Get((u32[0 max])(i + 1));
        if (node.Kind == ExprKind.CallExpr)
        {
            if (node.Left == 0)
            {
                return false;
            }

            if (node.Imm > 4)
            {
                return false;
            }

            if (node.Imm != (i64[min max])funcParamCounts.Get(node.Left))
            {
                return false;
            }

            if (node.Right != 0 && TypeOfNodeWithLocals(nodes, node.Right, localTypes) != ExprType.IntType)
            {
                return false;
            }

            if (node.Arg2 != 0 && TypeOfNodeWithLocals(nodes, node.Arg2, localTypes) != ExprType.IntType)
            {
                return false;
            }

            if (node.Arg3 != 0 && TypeOfNodeWithLocals(nodes, node.Arg3, localTypes) != ExprType.IntType)
            {
                return false;
            }

            if (node.Arg4 != 0 && TypeOfNodeWithLocals(nodes, node.Arg4, localTypes) != ExprType.IntType)
            {
                return false;
            }
        }

        i = i + 1;
    }

    return true;
}

// The result of lowering a function body: whether it was well-formed, its entry block's
// 1-based index, and its declared parameter count (the emit caller turns these into a
// `define`). Ok = false means the body was malformed / ill-typed / had an invalid call.
public struct LoweredBody
{
    bool Ok;
    u32[0 max] EntryBlock;
    u32[0 max] ParamCount;

    LoweredBody()
    {
        self.Ok = false;
        self.EntryBlock = 0;
        self.ParamCount = 0;
    }
}

// Lowers ONE function body — `fn <name>(<params>) { (var <n> = <expr>;)* return <expr> }` —
// through the AST path into caller-owned `instrs`/`blocks`, returning the entry block + the
// declared parameter count (or `Ok = false` on any malformed/ill-typed/invalid-call body).
// Parameters and `var` locals share one index space: the signature seeds the parameters;
// each `var` appends its name (so later statements resolve it) and at lower time its index is
// REDIRECTED — via `localOverrides` — to the SSA value its initializer produced (computed
// once, reused). The body is parsed against `funcNames` so a call resolves to its callee id,
// and `ValidateModuleCalls` enforces the call model against `funcParamCounts`. SHARED by the
// single-function path (`CompileFunctionWithLocalsToLlvm`) and the multi-function module path
// (`EmitModuleFunctionAst`), so a module function gets `var` locals just like a top-level one.
internal fn LoweredBody LowerFunctionWithLocals(borrow TokenStream stream, borrow i8[min max][] source, borrow IrTable<ParamName> funcNames, borrow IrTable<u32[0 max]> funcParamCounts, u64[0 2 ** 63 - 1] fnIndex, mut borrow IrTable<MirInstruction> instrs, mut borrow IrTable<MirBlock> blocks)
{
    stack mut LoweredBody result = new();

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return result;
    }

    // The brace/return search scans to end-of-stream, so a function with NO body brace or NO
    // return of its OWN would silently borrow a LATER function's. Bound them to this function:
    // if either falls at or beyond the next `fn`, this function is malformed — reject it
    // rather than fabricate a body from the next function's tokens.
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0 && (braceIndex >= nextFnIndex || returnIndex >= nextFnIndex))
    {
        return result;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParams(stream, source, fnIndex + 2, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    // Per-index types (1 = boolean, 0 = integer/parameter); signature parameters are integer.
    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> varRoots = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut u64[0 2 ** 63 - 1] seedT = 0;
    while willexit (seedT < signatureParamCount)
    {
        stack u32[0 max] paramTypeSlot = localTypes.Add(0);
        seedT = seedT + 1;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Var)
    {
        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt(cursor + 1);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt(cursor + 1);

        // A local must not redeclare a parameter or earlier local (the override scheme needs
        // each local a fresh, distinct index).
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
        {
            return result;
        }

        // The initializer may reference only ALREADY-declared names — reject if parsing it
        // grew the table (an undeclared/forward/self reference inserts a phantom index).
        stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
        stack ParseResult varExpr = ParseExprIn(stream, source, nodes, params, funcNames, cursor + 3);
        if (params.Count() != beforeInit)
        {
            return result;
        }

        stack ExprType varType = TypeOfNodeWithLocals(nodes, varExpr.NodeId, localTypes);
        if (varType == ExprType.ErrorType)
        {
            return result;
        }

        stack u32[0 max] addedRoot = varRoots.Add(varExpr.NodeId);
        stack u32[0 max] localIndex = ResolveParam(params, source, nameStart, nameLength);
        if (varType == ExprType.BoolType)
        {
            stack u32[0 max] boolSlot = localTypes.Add(1);
        }
        else
        {
            stack u32[0 max] intSlot = localTypes.Add(0);
        }

        cursor = varExpr.Next + 1;
    }

    stack ParseResult returnRoot = ParseExprIn(stream, source, nodes, params, funcNames, (u64[0 2 ** 63 - 1])returnIndex + 1);

    // Every body name must be a parameter or a declared local — no phantom names.
    if (params.Count() != signatureParamCount + varRoots.Count())
    {
        return result;
    }

    // Every call must be well-formed against the module (resolved callee, matching arity,
    // integer arguments — typed WITH the locals so a boolean local argument is caught —
    // within the model's argument limit).
    if (!ValidateModuleCalls(nodes, funcParamCounts, localTypes))
    {
        return result;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, localTypes);
    if (rootType == ExprType.ErrorType)
    {
        return result;
    }

    // Build the override table: signature parameters have no override (0); each local lowers
    // (seeing earlier locals) and appends its value.
    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] p = 0;
    while willexit (p < signatureParamCount)
    {
        stack u32[0 max] zero = localOverrides.Add(0);
        p = p + 1;
    }

    stack u64[0 2 ** 63 - 1] varCount = varRoots.Count();
    stack mut u64[0 2 ** 63 - 1] v = 0;
    while willexit (v < varCount)
    {
        stack u32[0 max] varRoot = varRoots.Get((u32[0 max])(v + 1));
        stack MirValueId varValue = LowerExprNodeWithLocals(nodes, varRoot, instrs, localOverrides);
        stack u32[0 max] addedOverride = localOverrides.Add(varValue.Index());
        v = v + 1;
    }

    stack MirValueId value = LowerExprNodeWithLocals(nodes, returnRoot.NodeId, instrs, localOverrides);
    stack mut MirValueId returnValue = value;
    if (rootType == ExprType.BoolType)
    {
        returnValue = MirZExt(instrs, value);
    }

    stack MirBlockId entry = MirReturnBlock(blocks, returnValue);
    result.Ok = true;
    result.EntryBlock = entry.Index();
    result.ParamCount = (u32[0 max])signatureParamCount;
    return result;
}

// Parses + lowers a BRANCH-bodied module function `fn <name>(<params>) { if <cond> return
// <then> else return <else> }` into a three-block CFG — an entry that conditionally branches
// to a then-block (returns `<then>`) or an else-block (returns `<else>`), no merge — and
// emits `@f<functionNumber>`. The arms are full expressions parsed against `funcNames`, so a
// return arm may CALL another function, INCLUDING THE FUNCTION ITSELF (the first pass put
// every name in `funcNames`): that is RECURSION through the AST path (e.g. factorial). The
// condition must be boolean and both returned arms integer. Returns false if the body is not
// this shape, or is malformed / ill-typed / has an invalid call.
internal fn bool EmitModuleIfReturnFunction(borrow TokenStream stream, borrow i8[min max][] source, borrow IrTable<ParamName> funcNames, borrow IrTable<u32[0 max]> funcParamCounts, u64[0 2 ** 63 - 1] fnIndex, u32[0 max] functionNumber, mut borrow OwnedAscii sink)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0 || stream.KindAt((u64[0 2 ** 63 - 1])braceIndex + 1) != TokenKind.If)
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParams(stream, source, fnIndex + 2, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    // `if <cond> return <then> else return <else>`.
    stack mut IrTable<ExprNode> nodes = new();
    stack u64[0 2 ** 63 - 1] ifIndex = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack ParseResult condResult = ParseExprIn(stream, source, nodes, params, funcNames, ifIndex + 1);
    if (stream.KindAt(condResult.Next) != TokenKind.Return)
    {
        return false;
    }

    stack ParseResult thenResult = ParseExprIn(stream, source, nodes, params, funcNames, condResult.Next + 1);
    if (stream.KindAt(thenResult.Next) != TokenKind.Else || stream.KindAt(thenResult.Next + 1) != TokenKind.Return)
    {
        return false;
    }

    stack ParseResult elseResult = ParseExprIn(stream, source, nodes, params, funcNames, thenResult.Next + 2);

    // Only the signature parameters may be referenced (no undeclared name appended).
    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    // Calls (including the self-call) must be well-formed. No locals here, so an empty types
    // table — a parameter argument types Int, a boolean argument is rejected.
    stack mut IrTable<u32[0 max]> noLocalTypes = new();
    if (!ValidateModuleCalls(nodes, funcParamCounts, noLocalTypes))
    {
        return false;
    }

    // Condition boolean; both returned arms integer (each becomes an `i64` return).
    if (TypeOfNode(nodes, condResult.NodeId) != ExprType.BoolType)
    {
        return false;
    }

    if (TypeOfNode(nodes, thenResult.NodeId) != ExprType.IntType || TypeOfNode(nodes, elseResult.NodeId) != ExprType.IntType)
    {
        return false;
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();

    // Entry block: lower the condition (i1).
    stack MirValueId condValue = LowerExprNode(nodes, condResult.NodeId, instrs);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count();
    // Then block: lower + return the first arm.
    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId thenValue = LowerExprNode(nodes, thenResult.NodeId, instrs);
    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);
    // Else block: lower + return the second arm.
    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId elseValue = LowerExprNode(nodes, elseResult.NodeId, instrs);
    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(2), MirBlockIdOf(3));
    stack MirBlockId thenBlock = MirReturnBlock(blocks, thenValue);
    stack MirBlockId elseBlock = MirReturnBlock(blocks, elseValue);

    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, entryCount));
    stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
    stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));

    stack u32[0 max] paramCount = (u32[0 max])signatureParamCount;
    switch (EmitLlvmBlocksNumbered(instrs, blocks, "f", functionNumber, paramCount, ranges, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

// Parses + lowers ONE function of a module through the AST path and emits
// `define i64 @f<functionNumber>(…) { … }` with per-function value numbering. A function
// whose body begins with `if` is a BRANCH-bodied function (`if … return … else return …`,
// which may RECURSE) and routes to `EmitModuleIfReturnFunction`; otherwise it is the shared
// `var`-locals-then-`return` body. Returns false on any malformed/ill-typed/invalid function.
internal fn bool EmitModuleFunctionAst(borrow TokenStream stream, borrow i8[min max][] source, borrow IrTable<ParamName> funcNames, borrow IrTable<u32[0 max]> funcParamCounts, u64[0 2 ** 63 - 1] fnIndex, u32[0 max] functionNumber, mut borrow OwnedAscii sink)
{
    stack i64[min max] bodyBrace = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (bodyBrace >= 0 && stream.KindAt((u64[0 2 ** 63 - 1])bodyBrace + 1) == TokenKind.If)
    {
        return EmitModuleIfReturnFunction(stream, source, funcNames, funcParamCounts, fnIndex, functionNumber, sink);
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack LoweredBody body = LowerFunctionWithLocals(stream, source, funcNames, funcParamCounts, fnIndex, instrs, blocks);
    if (!body.Ok)
    {
        return false;
    }

    stack u32[0 max] instrCount = (u32[0 max])instrs.Count();
    switch (EmitLlvmNumberedFunction(instrs, blocks, "f", functionNumber, body.ParamCount, body.EntryBlock, 1, instrCount, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

// Compiles a MULTI-FUNCTION module `(fn <name>(<params>) { return <expr> })+` through the
// AST path: a first pass builds the function-name table (definition order = 1-based id
// order), then each function's return body is parsed against that table — so a call
// `<name>(<args>)` resolves its callee NAME to the right `@fN` — lowered, and emitted. This
// is the AST counterpart of the positional `LowerModuleStream`, but a call's callee comes
// from real name resolution, not a positional scan, and arguments flow through the AST.
internal fn bool CompileModuleFromAstStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] tokenCount = stream.Count();

    // Function-name table and parallel parameter-count table (definition order = 1-based id
    // order, built in lockstep so a callee id indexes both). The name follows `fn`; the
    // signature's `(` is at the fn index + 2.
    stack mut IrTable<ParamName> funcNames = new();
    stack mut IrTable<u32[0 max]> funcParamCounts = new();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < tokenCount)
    {
        if (stream.KindAt(i) == TokenKind.Fn)
        {
            stack mut ParamName name = new();
            name.Start = stream.StartAt(i + 1);
            name.Length = stream.LengthAt(i + 1);
            stack u32[0 max] added = funcNames.Add(name);

            stack i64[min max] paramCount = CountArgsBetweenParens(stream, i + 2);
            stack mut u32[0 max] paramCountValue = 0;
            if (paramCount > 0)
            {
                paramCountValue = (u32[0 max])paramCount;
            }

            stack u32[0 max] addedCount = funcParamCounts.Add(paramCountValue);
        }

        i = i + 1;
    }

    if (funcNames.Count() == 0)
    {
        return false;
    }

    // Lower + emit each function in definition order.
    stack mut u32[0 max] functionNumber = 0;
    stack mut u64[0 2 ** 63 - 1] f = 0;
    while willexit (f < tokenCount)
    {
        if (stream.KindAt(f) == TokenKind.Fn)
        {
            functionNumber = functionNumber + 1;
            if (!EmitModuleFunctionAst(stream, source, funcNames, funcParamCounts, f, functionNumber, sink))
            {
                return false;
            }
        }

        f = f + 1;
    }

    return true;
}

// Lexes a multi-function module and compiles it through the AST path (see
// `CompileModuleFromAstStream`).
public fn bool CompileModuleFromAst(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return CompileModuleFromAstStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// The CHECKED AST module path: the full front-end semantic gate (`SemanticallyValidStream`
// — names bind, calls match arity, no scope redeclares, function names are unique, every
// condition is boolean, no comparison feeds an integer operand) guards the AST module
// codegen, so a module is lowered ONLY if it passes. This is the canonical lex → analyze →
// lower pipeline for the AST path (the counterpart of the positional `CompileModuleChecked`,
// but lowering through `CompileModuleFromAstStream`). The gate catches a BROADER class than
// the AST path's own `ValidateModuleCalls` (e.g. a duplicate function name, an unbound name
// outside a call), while `ValidateModuleCalls` still enforces the lowering model's limit
// (at most one argument); together they reject every malformed module. Lexes once.
public fn bool CompileModuleFromAstChecked(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            if (!SemanticallyValidStream(stream, sourceBytes))
            {
                return false;
            }

            return CompileModuleFromAstStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// The unified path for a MULTI-STATEMENT function body `fn <name>(<params>) { (var <n> =
// <expr>;)* return <expr> }`. Parameters and `var` locals share one index space: the
// signature seeds the parameters; each `var` appends its name (so later statements resolve
// it), and at lower time its index is REDIRECTED — via `localOverrides` — to the SSA value
// its initializer produced (computed once, reused on each reference). The emitted function
// declares only the SIGNATURE parameters; locals are interior values, not parameters.
public fn bool CompileFunctionWithLocalsToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack i64[min max] fnIndex = FirstTokenOfKind(stream, TokenKind.Fn);
            if (fnIndex < 0)
            {
                return false;
            }

            // The same body lowering the module path uses, with EMPTY function tables (a
            // single function has no cross-function calls — any call resolves to 0 and is
            // rejected by the shared `ValidateModuleCalls`). Emitted as `@main`.
            stack mut IrTable<ParamName> noFuncs = new();
            stack mut IrTable<u32[0 max]> noFuncCounts = new();
            stack mut IrTable<MirInstruction> instrs = new();
            stack mut IrTable<MirBlock> blocks = new();
            stack LoweredBody body = LowerFunctionWithLocals(stream, sourceBytes, noFuncs, noFuncCounts, (u64[0 2 ** 63 - 1])fnIndex, instrs, blocks);
            if (!body.Ok)
            {
                return false;
            }

            stack u32[0 max] instrCount = (u32[0 max])instrs.Count();
            switch (EmitLlvmDefinitionWithParams(instrs, blocks, "main", body.ParamCount, body.EntryBlock, 1, instrCount, sink))
            {
                case MemoryStatus.Ok:
                    return true;
                case MemoryStatus.Err(var error):
                    return false;
            }
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Lowers an `if <cond> <then> else <else>` EXPRESSION to a branching `@main` (a diamond
// CFG with a phi merge) through the AST path. Each of the three parts is parsed as a full
// expression (the parser's left-to-right fold delimits them: the condition ends where a
// non-operator begins; `else` separates the arms), so — unlike the positional
// `LowerIfToLlvm` — the condition and arms may be arbitrary parenthesized/arithmetic
// expressions, not just single primaries. The condition must be boolean.
public fn bool CompileIfExpressionToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack i64[min max] ifIndex = FirstTokenOfKind(stream, TokenKind.If);
            if (ifIndex < 0)
            {
                return false;
            }

            stack mut IrTable<ExprNode> nodes = new();
            stack mut IrTable<ParamName> params = new();
            // Condition (ends at the first non-operator token), then the two arms split by
            // `else`.
            stack ParseResult condResult = ParseExpr(stream, sourceBytes, nodes, params, (u64[0 2 ** 63 - 1])ifIndex + 1);
            if (TypeOfNode(nodes, condResult.NodeId) == ExprType.BoolType)
            {
                // A boolean condition; continue.
            }
            else
            {
                return false;
            }

            stack ParseResult thenResult = ParseExpr(stream, sourceBytes, nodes, params, condResult.Next);
            if (stream.KindAt(thenResult.Next) != TokenKind.Else)
            {
                return false;
            }

            stack ParseResult elseResult = ParseExpr(stream, sourceBytes, nodes, params, thenResult.Next + 1);

            // Both arms must have the SAME type — both integer (i64) or both boolean (i1) —
            // since the phi merges them: mismatched arms (one i64, one i1) would emit invalid
            // LLVM. A BOOLEAN-valued if-expression is supported by zero-extending each i1 arm
            // to i64 in its block, so the phi and the i64 return stay well-typed.
            stack ExprType thenType = TypeOfNode(nodes, thenResult.NodeId);
            stack ExprType elseType = TypeOfNode(nodes, elseResult.NodeId);
            stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
            stack bool bothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
            if (!bothInt && !bothBool)
            {
                return false;
            }

            stack mut IrTable<MirInstruction> instrs = new();
            stack mut IrTable<MirBlock> blocks = new();

            // Entry block: lower the condition (a comparison -> i1).
            stack MirValueId condValue = LowerExprNode(nodes, condResult.NodeId, instrs);
            stack u32[0 max] entryCount = (u32[0 max])instrs.Count();
            // Then block: the first arm.
            stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
            stack MirValueId thenValue = LowerExprNode(nodes, thenResult.NodeId, instrs);
            // A boolean arm is an i1; zero-extend it to i64 IN ITS BLOCK so the phi merges
            // two i64 values (the zext is part of the then arm's instruction range).
            stack mut MirValueId thenPhiValue = thenValue;
            if (bothBool)
            {
                thenPhiValue = MirZExt(instrs, thenValue);
            }

            stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);
            // Else block: the second arm.
            stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
            stack MirValueId elseValue = LowerExprNode(nodes, elseResult.NodeId, instrs);
            stack mut MirValueId elsePhiValue = elseValue;
            if (bothBool)
            {
                elsePhiValue = MirZExt(instrs, elseValue);
            }

            stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);
            // Merge block: a phi over the two arms (zero-extended when boolean), then return.
            stack MirValueId phi = MirPhi2(instrs, thenPhiValue, MirBlockIdOf(2), elsePhiValue, MirBlockIdOf(3));

            stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(2), MirBlockIdOf(3));
            stack MirBlockId thenBlock = MirBranchBlock(blocks, MirBlockIdOf(4));
            stack MirBlockId elseBlock = MirBranchBlock(blocks, MirBlockIdOf(4));
            stack MirBlockId mergeBlock = MirReturnBlock(blocks, phi);

            stack u32[0 max] paramCount = (u32[0 max])params.Count();
            switch (EmitLlvmDiamond(instrs, blocks, "main", paramCount, entry.Index(), 1, entryCount, thenBlock.Index(), thenFirst, thenCount, elseBlock.Index(), elseFirst, elseCount, mergeBlock.Index(), phi.Index(), 1, sink))
            {
                case MemoryStatus.Ok:
                    return true;
                case MemoryStatus.Err(var error):
                    return false;
            }
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Lowers a counting `while` loop `var i = <init>; while i < <bound> { i = i <op> <step> }
// return i` to a back-edge loop CFG through the AST path. The loop variable `i` is an
// induction phi (its preheader value and its body update are the two incomings); the
// condition, body update, and bound are full parsed expressions. The phi FORWARD-references
// its body update, whose instruction index is not known until the body is lowered — so the
// condition and body are first lowered into SCRATCH tables to COUNT their instructions
// (the loop variable resolves through an override either way, so the counts match), the
// update's future index is computed, the phi is built with that forward reference, and the
// real condition/body are lowered in place.
public fn bool CompileWhileLoopToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack i64[min max] varIndex = FirstTokenOfKind(stream, TokenKind.Var);
            stack i64[min max] whileIndex = FirstTokenOfKind(stream, TokenKind.While);
            stack i64[min max] braceIndex = FirstTokenOfKind(stream, TokenKind.LBrace);
            stack i64[min max] returnIndex = FirstTokenOfKind(stream, TokenKind.Return);
            if (varIndex < 0 || whileIndex < 0 || braceIndex < 0 || returnIndex < 0)
            {
                return false;
            }

            stack i64[min max] bodyAssign = FirstTokenOfKindAfter(stream, TokenKind.Assign, (u64[0 2 ** 63 - 1])braceIndex);
            if (bodyAssign < 0)
            {
                return false;
            }

            // Parse the four sub-expressions: the init, the condition, the body update
            // (the right side of `i = …`), and the return. The loop variable `i` is the
            // first name resolved, so it takes index 0.
            stack mut IrTable<ExprNode> nodes = new();
            stack mut IrTable<ParamName> params = new();
            stack ParseResult initResult = ParseExpr(stream, sourceBytes, nodes, params, (u64[0 2 ** 63 - 1])varIndex + 3);
            stack u32[0 max] loopVarIndex = ResolveParam(params, sourceBytes, stream.StartAt((u64[0 2 ** 63 - 1])varIndex + 1), stream.LengthAt((u64[0 2 ** 63 - 1])varIndex + 1));
            stack ParseResult condResult = ParseExpr(stream, sourceBytes, nodes, params, (u64[0 2 ** 63 - 1])whileIndex + 1);
            if (TypeOfNode(nodes, condResult.NodeId) == ExprType.BoolType)
            {
                // A boolean loop condition; continue.
            }
            else
            {
                return false;
            }

            stack ParseResult updateResult = ParseExpr(stream, sourceBytes, nodes, params, (u64[0 2 ** 63 - 1])bodyAssign + 1);
            stack ParseResult retResult = ParseExpr(stream, sourceBytes, nodes, params, (u64[0 2 ** 63 - 1])returnIndex + 1);

            // The supported shape is a SELF-CONTAINED counting loop: the only name anywhere
            // (init, condition, update, return) is the loop variable. That guarantees the
            // loop variable is index 0 (so the override binds it, not a name the init pulled
            // in first) AND that no free name/parameter is referenced (which would emit an
            // undeclared `%pK`, since `@main` is declared with no parameters).
            if (params.Count() != 1)
            {
                return false;
            }

            // The body must assign to the loop variable, as a SINGLE statement: the token
            // after `{` is the loop variable, and the update expression ends at `}`.
            if (SpanEquals(sourceBytes, stream.StartAt((u64[0 2 ** 63 - 1])braceIndex + 1), stream.LengthAt((u64[0 2 ** 63 - 1])braceIndex + 1), stream.StartAt((u64[0 2 ** 63 - 1])varIndex + 1), stream.LengthAt((u64[0 2 ** 63 - 1])varIndex + 1)))
            {
                // The body assigns to the loop variable; continue.
            }
            else
            {
                return false;
            }

            if (stream.KindAt(updateResult.Next) != TokenKind.RBrace)
            {
                return false;
            }

            stack mut IrTable<MirInstruction> instrs = new();
            stack mut IrTable<MirBlock> blocks = new();

            // Preheader: lower the initializer (no reference to the loop variable yet).
            stack mut IrTable<u32[0 max]> noOverride = new();
            stack MirValueId initValue = LowerExprNodeWithLocals(nodes, initResult.NodeId, instrs, noOverride);
            stack u32[0 max] initCount = (u32[0 max])instrs.Count();

            // Measure the condition and body instruction counts in scratch tables (the loop
            // variable resolves through an override, so the count is independent of it).
            stack mut IrTable<u32[0 max]> measureOverride = new();
            stack u32[0 max] measureSlot = measureOverride.Add(initValue.Index());
            stack mut IrTable<MirInstruction> scratchCond = new();
            stack MirValueId scratchCondValue = LowerExprNodeWithLocals(nodes, condResult.NodeId, scratchCond, measureOverride);
            stack u32[0 max] condCount = (u32[0 max])scratchCond.Count();
            stack mut IrTable<MirInstruction> scratchBody = new();
            stack MirValueId scratchBodyValue = LowerExprNodeWithLocals(nodes, updateResult.NodeId, scratchBody, measureOverride);
            stack u32[0 max] bodyCount = (u32[0 max])scratchBody.Count();

            // The body update's value lands at this index: init + the phi + cond + body.
            stack u32[0 max] updateIndex = initCount + 1 + condCount + bodyCount;

            // Header phi: `i = phi [ init, preheader(b1) ], [ update(forward), body(b3) ]`.
            stack MirValueId loopPhi = MirPhi2(instrs, initValue, MirBlockIdOf(1), MirValueIdOf(updateIndex), MirBlockIdOf(3));
            stack mut IrTable<u32[0 max]> loopOverride = new();
            stack u32[0 max] loopSlot = loopOverride.Add(loopPhi.Index());

            // Header: the condition (referencing the phi). Body: the update (referencing it).
            stack MirValueId condValue = LowerExprNodeWithLocals(nodes, condResult.NodeId, instrs, loopOverride);
            stack u32[0 max] headerEnd = (u32[0 max])instrs.Count();
            stack u32[0 max] bodyFirst = (u32[0 max])instrs.Count() + 1;
            stack MirValueId updateValue = LowerExprNodeWithLocals(nodes, updateResult.NodeId, instrs, loopOverride);
            stack u32[0 max] bodyEnd = (u32[0 max])instrs.Count();

            // Blocks: preheader(b1) → header(b2); header cond-branches to body(b3)/exit(b4);
            // body branches back to the header; exit returns the loop variable.
            stack MirBlockId entry = MirBranchBlock(blocks, MirBlockIdOf(2));
            stack MirBlockId header = MirCondBlock(blocks, condValue, MirBlockIdOf(3), MirBlockIdOf(4));
            stack MirBlockId body = MirBranchBlock(blocks, MirBlockIdOf(2));
            stack MirBlockId exit = MirReturnBlock(blocks, loopPhi);

            stack mut IrTable<BlockEmit> ranges = new();
            stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, initCount));
            stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(header.Index(), initCount + 1, headerEnd - initCount));
            stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(body.Index(), bodyFirst, bodyEnd - bodyFirst + 1));
            stack u32[0 max] r4 = ranges.Add(MakeBlockEmit(exit.Index(), bodyEnd + 1, 0));

            switch (EmitLlvmBlocks(instrs, blocks, "main", 0, ranges, sink))
            {
                case MemoryStatus.Ok:
                    return true;
                case MemoryStatus.Err(var error):
                    return false;
            }
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Lexes and lowers a `(fn <name>() { return <body> })+` program to an LLVM module.
public fn bool LowerModuleToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerModuleStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}
