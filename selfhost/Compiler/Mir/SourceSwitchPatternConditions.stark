internal fn bool SourceSwitchStructFieldPatternRangesAreProvablyDisjoint(
    u32[0 max] leftStart,
    u32[0 max] leftCount,
    u32[0 max] rightStart,
    u32[0 max] rightCount,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues)
{
    if (leftCount == 0 || rightCount == 0)
    {
        return false;
    }

    stack mut u32[0 max] leftOffset = 0;
    while willexit (leftOffset < leftCount)
    {
        stack u32[0 max] leftRow = leftStart + leftOffset;
        if (!fieldPatternIndices.Contains(leftRow)
            || !fieldPatternTypeCodes.Contains(leftRow)
            || !fieldPatternKinds.Contains(leftRow)
            || !fieldPatternMinValues.Contains(leftRow)
            || !fieldPatternMaxValues.Contains(leftRow)
            || fieldPatternKinds.Get(leftRow) != SourceSwitchEnumPayloadPatternKindScalarInterval())
        {
            return false;
        }

        stack u32[0 max] leftFieldIndex = fieldPatternIndices.Get(leftRow);
        stack u32[0 max] leftTypeCode = fieldPatternTypeCodes.Get(leftRow);
        stack i64[min max] leftMin = fieldPatternMinValues.Get(leftRow);
        stack i64[min max] leftMax = fieldPatternMaxValues.Get(leftRow);

        stack mut u32[0 max] rightOffset = 0;
        while willexit (rightOffset < rightCount)
        {
            stack u32[0 max] rightRow = rightStart + rightOffset;
            if (!fieldPatternIndices.Contains(rightRow)
                || !fieldPatternTypeCodes.Contains(rightRow)
                || !fieldPatternKinds.Contains(rightRow)
                || !fieldPatternMinValues.Contains(rightRow)
                || !fieldPatternMaxValues.Contains(rightRow)
                || fieldPatternKinds.Get(rightRow) != SourceSwitchEnumPayloadPatternKindScalarInterval())
            {
                return false;
            }

            stack u32[0 max] rightFieldIndex = fieldPatternIndices.Get(rightRow);
            stack u32[0 max] rightTypeCode = fieldPatternTypeCodes.Get(rightRow);
            if (leftFieldIndex == rightFieldIndex && leftTypeCode == rightTypeCode)
            {
                stack i64[min max] rightMin = fieldPatternMinValues.Get(rightRow);
                stack i64[min max] rightMax = fieldPatternMaxValues.Get(rightRow);
                if (SourceSwitchScalarIntervalsAreDisjoint(leftMin, leftMax, rightMin, rightMax))
                {
                    return true;
                }
            }

            rightOffset = rightOffset + 1;
        }

        leftOffset = leftOffset + 1;
    }

    return false;
}

