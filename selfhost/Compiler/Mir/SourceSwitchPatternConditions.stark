}

internal finite law bool SourceSwitchGuardNodeIsUnconditional(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] guardNode)
{
    if (guardNode == 0)
    {
        return true;
    }

    if (!nodes.Contains(guardNode))
    {
        return true;
    }

    stack ExprNode node = nodes.Get(guardNode);
    return node.Kind == Compiler.Mir.SourceExpressions.ExprKind.BoolLitExpr && node.Imm == 1;
}

