internal finite law bool SourceSwitchStructPatternCanUseFlatOverlapPreflight(
    borrow IrTable<u32[0 max]> caseNestedCounts,
    u32[0 max] nestedCount)
{
    if (nestedCount != 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = caseNestedCounts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (caseNestedCounts.Get((u32[0 max])(index + 1)) != 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}
