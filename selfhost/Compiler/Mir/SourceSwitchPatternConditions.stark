    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(i + 1);
        stack u32[0 max] previousGuardNode = caseGuardNodes.Get(caseSlot);
        if (SourceSwitchGuardNodeIsUnconditional(nodes, previousGuardNode))
        {
            stack u32[0 max] previousStart = caseDecisionMemberStarts.Get(caseSlot);
