module Compiler.Mir.SourceTryLowering

// Source try shape detection and MIR control-flow lowering. Every accepted
// path preserves typed enum layout, value-range, storage, and cleanup facts.

internal fn bool FunctionBodyStartsWithLocalTryBinding(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    if (nextFnIndex >= 0 && (braceIndex >= nextFnIndex || returnIndex >= nextFnIndex))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (!TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
    if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])returnIndex, statementEnd)
        || statementEnd >= (u64[0 2 ** 63 - 1])returnIndex)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
    return FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken)
        && stream.KindAt(assignToken + 1) == TokenKind.Try;
}

internal fn bool FunctionBodyStartsWithLocalTryAssignment(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    if (nextFnIndex >= 0 && (braceIndex >= nextFnIndex || returnIndex >= nextFnIndex))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (stream.KindAt(localStart) != TokenKind.Var)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (!FindSelfHostedStatementEnd(stream, localStart, (u64[0 2 ** 63 - 1])returnIndex, localEnd))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = localEnd + 1;
    if (assignmentStart >= (u64[0 2 ** 63 - 1])returnIndex)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || assignmentEnd + 1 != (u64[0 2 ** 63 - 1])returnIndex
        || !StatementStartsScalarStorageAssignment(stream, assignmentStart, assignmentEnd))
    {
        return false;
    }

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    if (localNameToken == 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentAssignToken = assignmentEnd;
    return FindSelfHostedStatementAssign(stream, assignmentStart, assignmentEnd, assignmentAssignToken)
        && TokenTextEqualsAsciiSpan(stream, source, localNameToken, (u32[0 max])assignmentStart)
        && stream.KindAt(assignmentAssignToken + 1) == TokenKind.Try;
}

internal fn bool FunctionBodyStartsWithStorageTryAssignment(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    if (nextFnIndex >= 0 && (braceIndex >= nextFnIndex || returnIndex >= nextFnIndex))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (stream.KindAt(localStart) != TokenKind.Stack)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (!FindSelfHostedStatementEnd(stream, localStart, (u64[0 2 ** 63 - 1])returnIndex, localEnd)
        || !SelfHostedLocalDeclarationHasMut(stream, localStart, localEnd))
    {
        return false;
    }

    stack u32[0 max] localTypeToken = FindSelfHostedLocalTypeToken(stream, localStart, localEnd);
    if (localTypeToken == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = localEnd + 1;
    if (assignmentStart >= (u64[0 2 ** 63 - 1])returnIndex)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || assignmentEnd + 1 != (u64[0 2 ** 63 - 1])returnIndex
        || !StatementStartsScalarStorageAssignment(stream, assignmentStart, assignmentEnd))
    {
        return false;
    }

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    if (localNameToken == 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentAssignToken = assignmentEnd;
    return FindSelfHostedStatementAssign(stream, assignmentStart, assignmentEnd, assignmentAssignToken)
        && TokenTextEqualsAsciiSpan(stream, source, localNameToken, (u32[0 max])assignmentStart)
        && stream.KindAt(assignmentAssignToken + 1) == TokenKind.Try;
}

internal fn bool FindSelfHostedBracketedAssignToken(
    borrow TokenStream stream,
    u64[0 2 ** 63 - 1] openBracket,
    u64[0 2 ** 63 - 1] end,
    out u64[0 2 ** 63 - 1] assignToken)
{
    assignToken = end;
    stack mut u64[0 2 ** 63 - 1] cursor = openBracket;
    stack mut u32[0 max] depth = 0;
    while willexit (cursor < end)
    {
        stack TokenKind kind = stream.KindAt(cursor);
        if (kind == TokenKind.LBrack)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RBrack)
        {
            if (depth == 0)
            {
                return false;
            }

            depth = depth - 1;
            if (depth == 0)
            {
                stack u64[0 2 ** 63 - 1] candidate = cursor + 1;
                if (candidate < end && stream.KindAt(candidate) == TokenKind.Assign)
                {
                    assignToken = candidate;
                    return true;
                }

                return false;
            }
        }

        cursor = cursor + 1;
    }

    return false;
}

internal fn bool FunctionBodyStartsWithSourceSliceElementTryAssignment(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    if (nextFnIndex >= 0 && (braceIndex >= nextFnIndex || returnIndex >= nextFnIndex))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || assignmentEnd + 1 != (u64[0 2 ** 63 - 1])returnIndex
        || !StatementStartsSourceSliceElementAssignment(stream, assignmentStart, assignmentEnd))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentAssignToken = assignmentEnd;
    return FindSelfHostedBracketedAssignToken(stream, assignmentStart + 1, assignmentEnd, assignmentAssignToken)
        && stream.KindAt(assignmentAssignToken + 1) == TokenKind.Try;
}

internal fn bool FunctionBodyStartsWithLocalSourceSliceElementTryAssignment(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    if (nextFnIndex >= 0 && (braceIndex >= nextFnIndex || returnIndex >= nextFnIndex))
    {
        return false;
    }

    stack mut bool sawLocal = false;
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    while willexit (cursor < (u64[0 2 ** 63 - 1])returnIndex && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])returnIndex, statementEnd))
        {
            return false;
        }

        sawLocal = true;
        cursor = statementEnd + 1;
    }

    if (!sawLocal || cursor >= (u64[0 2 ** 63 - 1])returnIndex)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = cursor;
    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || assignmentEnd + 1 != (u64[0 2 ** 63 - 1])returnIndex
        || !StatementStartsSourceSliceElementAssignment(stream, assignmentStart, assignmentEnd))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentAssignToken = assignmentEnd;
    return FindSelfHostedBracketedAssignToken(stream, assignmentStart + 1, assignmentEnd, assignmentAssignToken)
        && stream.KindAt(assignmentAssignToken + 1) == TokenKind.Try;
}

internal fn bool FindConstructedObjectFieldAssignmentAssignToken(
    borrow TokenStream stream,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end,
    out u64[0 2 ** 63 - 1] assignToken)
{
    assignToken = end;
    if (start + 3 >= end
        || stream.KindAt(start) != TokenKind.Identifier
        || stream.KindAt(start + 1) != TokenKind.Dot
        || stream.KindAt(start + 2) != TokenKind.Identifier)
    {
        return false;
    }

    if (stream.KindAt(start + 3) == TokenKind.Assign)
    {
        assignToken = start + 3;
        return true;
    }

    if (stream.KindAt(start + 3) == TokenKind.LBrack)
    {
        return FindSelfHostedBracketedAssignToken(stream, start + 3, end, assignToken);
    }

    if (stream.KindAt(start + 3) != TokenKind.Dot)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] scan = start + 3;
    while willexit (stream.KindAt(scan) == TokenKind.Dot
        && stream.KindAt(scan + 1) == TokenKind.Identifier)
    {
        scan = scan + 2;
    }

    if (scan < end && stream.KindAt(scan) == TokenKind.Assign)
    {
        assignToken = scan;
        return true;
    }

    if (scan < end && stream.KindAt(scan) == TokenKind.LBrack)
    {
        return FindSelfHostedBracketedAssignToken(stream, scan, end, assignToken);
    }

    return false;
}

internal fn bool FunctionBodyStartsWithConstructedObjectFieldTryAssignment(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    if (nextFnIndex >= 0 && (braceIndex >= nextFnIndex || returnIndex >= nextFnIndex))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack TokenKind localStorage = stream.KindAt(localStart);
    if (localStorage != TokenKind.Stack && localStorage != TokenKind.Heap)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (!FindSelfHostedStatementEnd(stream, localStart, (u64[0 2 ** 63 - 1])returnIndex, localEnd))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localAssignToken = localEnd;
    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    stack u32[0 max] localTypeToken = FindSelfHostedLocalTypeToken(stream, localStart, localEnd);
    if (localNameToken == 0
        || localTypeToken == 0
        || !FindSelfHostedStatementAssign(stream, localStart, localEnd, localAssignToken))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = localEnd + 1;
    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || assignmentEnd + 1 != (u64[0 2 ** 63 - 1])returnIndex
        || !StatementStartsConstructedObjectFieldAssignment(stream, assignmentStart, assignmentEnd)
        || !TokenTextEqualsAsciiSpan(stream, source, localNameToken, (u32[0 max])assignmentStart))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentAssignToken = assignmentEnd;
    return FindConstructedObjectFieldAssignmentAssignToken(stream, assignmentStart, assignmentEnd, assignmentAssignToken)
        && stream.KindAt(assignmentAssignToken + 1) == TokenKind.Try;
}

internal fn bool FunctionBodyStartsWithReturnTryExpression(
    borrow TokenStream stream,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    if (nextFnIndex >= 0 && braceIndex >= nextFnIndex)
    {
        return false;
    }

    stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])braceIndex);
    if (closeBrace == (u32[0 max])braceIndex)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] returnIndex = (u64[0 2 ** 63 - 1])braceIndex + 1;
    return returnIndex + 1 < (u64[0 2 ** 63 - 1])closeBrace
        && stream.KindAt(returnIndex) == TokenKind.Return
        && stream.KindAt(returnIndex + 1) == TokenKind.Try;
}

internal fn bool TryGetSourceTryEnumTagType(
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    out MirType tagType)
{
    tagType = MirType.I8;
    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (moduleFacts.EnumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Variant)
        {
            stack u32[0 max] bitWidth = moduleFacts.EnumLayouts.BitWidthAt(index);
            if (bitWidth <= 1)
            {
                tagType = MirType.I1;
                return true;
            }

            if (bitWidth <= 8)
            {
                tagType = MirType.I8;
                return true;
            }

            if (bitWidth <= 16)
            {
                tagType = MirType.I16;
                return true;
            }

            if (bitWidth <= 32)
            {
                tagType = MirType.I32;
                return true;
            }

            if (bitWidth <= 64)
            {
                tagType = MirType.I64;
                return true;
            }

            return false;
        }

        index = index + 1;
    }

    return false;
}

internal inline finite law u32[0 max] SourceTryBindingSuccessorStatementKindLocal()
{
    return 1;
}

internal inline finite law u32[0 max] SourceTryBindingSuccessorStatementKindMutation()
{
    return 2;
}

internal inline finite law u32[0 max] SourceTryBindingSuccessorStatementKindScalarStorage()
{
    return 3;
}

internal inline finite law u32[0 max] SourceTryBindingSuccessorStatementKindFixedArrayStorage()
{
    return 4;
}

internal inline finite law u32[0 max] SourceTryBindingSuccessorStatementKindSliceDescriptor()
{
    return 5;
}

internal inline finite law u32[0 max] SourceTryBindingSuccessorStatementKindEnumStorage()
{
    return 6;
}

internal inline finite law u32[0 max] SourceTryBindingSuccessorStatementKindConstructedObjectStorage()
{
    return 7;
}

internal inline finite law u32[0 max] SourceTryBindingSuccessorStatementKindLocalTryBinding()
{
    return 8;
}

internal struct SourceTryBindingSuccessorStatement
{
    u32[0 max] Kind;
    u32[0 max] Index;

    SourceTryBindingSuccessorStatement()
    {
        self.Kind = 0;
        self.Index = 0;
    }
}

internal struct SourceTryBindingNestedTryBinding
{
    u32[0 max] OperandNode;
    u32[0 max] OperandOwnerDeclarationIndex;
    u32[0 max] LocalParamIndex;
    MirType TagType;
    SourceTryPropagationCompatibilityFacts Compatibility;

    SourceTryBindingNestedTryBinding()
    {
        self.OperandNode = 0;
        self.OperandOwnerDeclarationIndex = 0;
        self.LocalParamIndex = 0;
        self.TagType = MirType.I8;
        self.Compatibility = new();
    }
}

internal struct SourceTryBindingStorageAllocation
{
    u32[0 max] LocalOrdinal;
    u32[0 max] ParamIndex;
    u32[0 max] ByteSize;
    u32[0 max] Alignment;

    SourceTryBindingStorageAllocation()
    {
        self.LocalOrdinal = 0;
        self.ParamIndex = 0;
        self.ByteSize = 0;
        self.Alignment = 0;
    }
}

internal fn bool TryResolveLocalTryBindingValueTypeCode(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    TokenKind localStorage,
    u32[0 max] localTypeToken,
    u32[0 max] okPayloadTypeCode,
    out u32[0 max] localTypeCode)
{
    localTypeCode = SourceLocalTypeCodeNonValue();
    stack u32[0 max] valueTypeCode = SourceLocalTypeCodeForResolvedScalarValue(okPayloadTypeCode);
    if (valueTypeCode == SourceLocalTypeCodeNonValue())
    {
        return false;
    }

    if (localStorage == TokenKind.Var)
    {
        localTypeCode = valueTypeCode;
        return true;
    }

    if (localStorage != TokenKind.Stack || localTypeToken == 0)
    {
        return false;
    }

    stack mut MirType scalarType = MirType.I64;
    if (!MirTypeForKnownSourceScalarType(stream, source, localTypeToken, scalarType))
    {
        return false;
    }

    if (SourceResolvedFieldTypeCodeForMirType(scalarType) != okPayloadTypeCode)
    {
        return false;
    }

    localTypeCode = valueTypeCode;
    return true;
}

internal fn bool LowerModuleLocalTryBindingFunctionToBlocks(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithLocalTryBinding(stream, source, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut u64[0 2 ** 63 - 1] statementEnd = localStart;
    if (!FindSelfHostedStatementEnd(stream, localStart, (u64[0 2 ** 63 - 1])returnIndex, statementEnd))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
    if (!FindSelfHostedStatementAssign(stream, localStart, statementEnd, assignToken))
    {
        return false;
    }

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, statementEnd);
    if (localNameToken == 0)
    {
        return false;
    }

    stack mut FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut IrTable<StackObjectFieldInitializer> stackObjectFieldInitializers = new();
    stack mut IrTable<ScalarStorageLocal> scalarStorageLocals = new();
    stack mut IrTable<FixedArrayStorageLocal> fixedArrayStorageLocals = new();
    stack mut IrTable<FixedArrayStorageInitializer> fixedArrayStorageInitializers = new();
    stack mut IrTable<EnumStorageLocal> enumStorageLocals = new();
    stack mut IrTable<EnumStorageInitializer> enumStorageInitializers = new();
    stack mut IrTable<ScalarStorageInitializer> scalarStorageInitializers = new();
    stack mut IrTable<ScalarStorageAssignment> scalarStorageAssignments = new();
    stack mut IrTable<EnumStorageAssignment> enumStorageAssignments = new();
    stack mut IrTable<ConstructedObjectFieldAssignment> constructedObjectFieldAssignments = new();
    stack mut IrTable<SourceStorageMutationStatement> storageMutationStatements = new();
    stack mut IrTable<SourceTryBindingSuccessorStatement> successorStatements = new();
    stack mut IrTable<SourceTryBindingNestedTryBinding> nestedTryBindings = new();
    stack mut IrTable<SourceTryBindingStorageAllocation> storageAllocations = new();
    stack u64[0 2 ** 63 - 1] beforeTryParse = params.Count();
    stack ExprParseResult tryExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
