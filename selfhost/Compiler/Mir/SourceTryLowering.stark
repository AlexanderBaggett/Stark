                            }

                            stack mut SourceTryBindingSuccessorStatement successor = new();
                            successor.Kind = SourceTryBindingSuccessorStatementKindEnumStorage();
                            successor.Index = (u32[0 max])storageAllocations.Count();
                            if (successorStatements.Add(successor) == 0)
                            {
                                return false;
                            }
                        }
                        else
                        {
                            stack mut MirType scalarFieldType = MirType.I64;
                            if (!MirTypeForKnownSourceScalarType(stream, source, localTypeToken, scalarFieldType))
                            {
                                return false;
                            }

                            stack u32[0 max] scalarAllocationSize = TypeKnownByteExtentForLocal(stream, source, localTypeToken);
                            stack u32[0 max] scalarAllocationAlign = TypeKnownByteAlignment(stream, source, localTypeToken);
                            stack u32[0 max] scalarLocalTypeCode = SourceLocalStoredScalarTypeCodeForMirType(scalarFieldType);
                            if (scalarAllocationSize == 0
                                || scalarAllocationAlign == 0
                                || !SourceLocalTypeCodeIsStoredScalar(scalarLocalTypeCode))
                            {
                                return false;
                            }

                            if (!hasStackInitializer && !SelfHostedLocalDeclarationHasMut(stream, successorCursor, successorEnd))
                            {
                                return false;
                            }

                            stack mut ExprParseResult scalarExpr = new();
                            stack mut ValueFacts scalarFacts = new();
                            if (hasStackInitializer)
                            {
                                stack u64[0 2 ** 63 - 1] beforeScalarParse = params.Count();
                                scalarExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
                                    stream,
                                    source,
                                    nodes,
                                    params,
                                    funcNames,
                                    constructedObjectLocals,
                                    sliceDescriptorLocals,
                                    localTypes,
                                    sourceValueFacts,
                                    moduleFacts,
                                    successorAssignToken + 1);
                                if (scalarExpr.NodeId == 0
                                    || scalarExpr.Next != successorEnd
                                    || params.Count() != beforeScalarParse)
                                {
                                    return false;
                                }

                                stack mut u32[0 max] nestedTryOperand = 0;
                                if (TryGetSourceTryOperandNode(nodes, scalarExpr.NodeId, nestedTryOperand))
                                {
                                    return false;
                                }

                                stack ExprType scalarExprType = TypeOfNodeWithLocals(nodes, scalarExpr.NodeId, localTypes);
                                if (!FieldInitializerTypeMatches(scalarFieldType, scalarExprType))
                                {
                                    return false;
                                }

                                if (!SelfHostedLocalDeclarationHasMut(stream, successorCursor, successorEnd))
                                {
                                    stack mut ValueFacts parsedFacts = new();
                                    if (TryBuildSourceValueFactsForNode(nodes, scalarExpr.NodeId, sourceValueFacts, parsedFacts))
                                    {
                                        scalarFacts = parsedFacts;
                                    }
                                }
                            }

                            stack u32[0 max] scalarLocalIndex = ResolveParam(params, source, successorNameStart, successorNameLength);
                            if (scalarLocalIndex != (u32[0 max])localTypes.Count())
                            {
                                return false;
                            }

                            if (localTypes.Add(scalarLocalTypeCode) == 0 || sourceValueFacts.Add(scalarFacts) == 0)
                            {
                                return false;
                            }

                            stack u32[0 max] scalarLocalOrdinal = (u32[0 max])((u64[0 2 ** 63 - 1])scalarLocalIndex + 1 - signatureParamCount);
                            stack mut ScalarStorageLocal scalarLocal = new();
                            scalarLocal.Start = successorNameStart;
                            scalarLocal.Length = successorNameLength;
                            scalarLocal.ParamIndex = scalarLocalIndex;
                            scalarLocal.StorageValue = 0;
                            scalarLocal.FieldAlignment = scalarAllocationAlign;
                            scalarLocal.FieldType = scalarFieldType;
                            scalarLocal.Mutable = SelfHostedLocalDeclarationHasMut(stream, successorCursor, successorEnd);
                            if (scalarStorageLocals.Add(scalarLocal) == 0)
                            {
                                return false;
                            }

                            if (hasStackInitializer)
                            {
                                stack mut ScalarStorageInitializer scalarInitializer = new();
                                scalarInitializer.LocalOrdinal = scalarLocalOrdinal;
                                scalarInitializer.ParamIndex = scalarLocalIndex;
                                scalarInitializer.FieldAlignment = scalarAllocationAlign;
                                scalarInitializer.FieldType = scalarFieldType;
                                scalarInitializer.ExprRoot = scalarExpr.NodeId;
                                if (scalarStorageInitializers.Add(scalarInitializer) == 0)
                                {
                                    return false;
                                }
                            }

                            stack mut SourceTryBindingStorageAllocation allocation = new();
                            allocation.LocalOrdinal = scalarLocalOrdinal;
                            allocation.ParamIndex = scalarLocalIndex;
                            allocation.ByteSize = scalarAllocationSize;
                            allocation.Alignment = scalarAllocationAlign;
                            if (storageAllocations.Add(allocation) == 0)
                            {
                                return false;
                            }

                            stack mut SourceTryBindingSuccessorStatement successor = new();
                            successor.Kind = SourceTryBindingSuccessorStatementKindScalarStorage();
                            successor.Index = (u32[0 max])storageAllocations.Count();
                            if (successorStatements.Add(successor) == 0)
                            {
                                return false;
                            }
                        }
                    }
                }
            }
            else
            {
                return false;
            }
        }
        else
        {
            stack u64[0 2 ** 63 - 1] beforeMutationParse = params.Count();
            stack u64[0 2 ** 63 - 1] beforeMutationCount = storageMutationStatements.Count();
            if (!TryParseSourceStorageMutationStatement(
                stream,
                source,
                nodes,
                params,
                funcNames,
                constructedObjectLocals,
                sliceDescriptorLocals,
                scalarStorageLocals,
                enumStorageLocals,
                localTypes,
                sourceValueFacts,
                moduleFacts,
                successorCursor,
                successorEnd,
                scalarStorageAssignments,
                enumStorageAssignments,
                constructedObjectFieldAssignments,
                storageMutationStatements))
            {
                return false;
            }

            if (params.Count() != beforeMutationParse
                || storageMutationStatements.Count() != beforeMutationCount + 1)
            {
                return false;
            }

            stack mut SourceTryBindingSuccessorStatement successor = new();
            successor.Kind = SourceTryBindingSuccessorStatementKindMutation();
            successor.Index = (u32[0 max])storageMutationStatements.Count();
            if (successorStatements.Add(successor) == 0)
            {
                return false;
            }
        }

        successorCursor = successorEnd + 1;
    }

    stack u64[0 2 ** 63 - 1] beforeReturnParse = params.Count();
    stack ExprParseResult returnRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        (u64[0 2 ** 63 - 1])returnIndex + 1);
    if (returnRoot.NodeId == 0 || params.Count() != beforeReturnParse)
    {
        return false;
    }

    if (!AnnotateCallExpressionResultTypesFromContracts(nodes, functionCallContractFacts))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, loweringLocalTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack mut MirType tagType = MirType.I8;
    if (!TryGetSourceTryEnumTagType(moduleFacts, operandOwnerDeclarationIndex, tagType))
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId operandValue = LowerExprNodeWithCallContext(
        nodes,
        operandNode,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals);
    if (!operandValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack mut SourceTryPropagationLoweringResult loweredTry = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        compatibility,
        operandValue,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        MirBlockIdOf(firstBlock + 3),
        entryFirst,
        tagType,
        recordRanges,
        loweredTry))
    {
        return false;
    }

    if (localOverrides.Add(loweredTry.SuccessValueValue.Index()) == 0)
    {
        return false;
    }

    stack mut u32[0 max] segmentFirst = (u32[0 max])instrs.Count() + 1;
    stack mut u32[0 max] nextScalarStorageInitializer = 1;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    stack mut u32[0 max] nextEnumStorageInitializer = 1;
    stack mut u32[0 max] nextStackObjectInitializer = 1;
    stack mut u32[0 max] successorIndex = 1;
    while willexit ((u64[0 2 ** 63 - 1])successorIndex <= successorStatements.Count())
    {
        stack SourceTryBindingSuccessorStatement successor = successorStatements.Get(successorIndex);
        if (successor.Kind == SourceTryBindingSuccessorStatementKindLocal())
        {
            stack MirValueId successorValue = LowerExprNodeWithCallContext(
                nodes,
                successor.Index,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
            if (!successorValue.IsValid() || localOverrides.Add(successorValue.Index()) == 0)
            {
                return false;
            }
        }
        else if (successor.Kind == SourceTryBindingSuccessorStatementKindLocalTryBinding())
        {
            if (!nestedTryBindings.Contains(successor.Index))
            {
                return false;
            }

            stack SourceTryBindingNestedTryBinding nestedTryBinding = nestedTryBindings.Get(successor.Index);
            stack MirValueId nestedOperandValue = LowerExprNodeWithCallContext(
                nodes,
                nestedTryBinding.OperandNode,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
            if (!nestedOperandValue.IsValid())
            {
                return false;
            }

            stack u32[0 max] nestedFirstBlock = (u32[0 max])blocks.Count() + 1;
            stack mut SourceTryPropagationLoweringResult loweredNestedTry = new();
            if (!TryLowerSameFamilySourceTryPropagation(
                instrs,
                blocks,
                ranges,
                nestedTryBinding.Compatibility,
                nestedOperandValue,
                nestedTryBinding.OperandOwnerDeclarationIndex,
                returnOwnerDeclarationIndex,
                MirBlockIdOf(nestedFirstBlock + 3),
                segmentFirst,
                nestedTryBinding.TagType,
                recordRanges,
                loweredNestedTry))
            {
                return false;
            }

            stack u32[0 max] nestedOverride = localOverrides.Add(loweredNestedTry.SuccessValueValue.Index());
            if (nestedOverride == 0 || nestedOverride != nestedTryBinding.LocalParamIndex + 1)
            {
                return false;
            }

            segmentFirst = (u32[0 max])instrs.Count() + 1;
        }
        else if (successor.Kind == SourceTryBindingSuccessorStatementKindSliceDescriptor())
        {
            stack u32[0 max] sliceDescriptorOverride = localOverrides.Add(0);
            if (sliceDescriptorOverride == 0 || sliceDescriptorOverride != successor.Index + 1)
            {
                return false;
            }
        }
        else if (successor.Kind == SourceTryBindingSuccessorStatementKindScalarStorage())
        {
            if (!storageAllocations.Contains(successor.Index))
            {
                return false;
            }

            stack SourceTryBindingStorageAllocation allocation = storageAllocations.Get(successor.Index);
            stack MirValueId scalarStorage = MirStackAlloc(instrs, allocation.ByteSize, allocation.Alignment);
            stack u32[0 max] storageOverride = localOverrides.Add(scalarStorage.Index());
            if (!scalarStorage.IsValid() || storageOverride == 0 || storageOverride != allocation.ParamIndex + 1)
            {
                return false;
            }

            nextScalarStorageInitializer = LowerScalarStorageInitializersForLocalWithCallContext(
                scalarStorageInitializers,
                allocation.LocalOrdinal,
                nextScalarStorageInitializer,
                nodes,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
        }
        else if (successor.Kind == SourceTryBindingSuccessorStatementKindFixedArrayStorage())
        {
            if (!storageAllocations.Contains(successor.Index))
            {
                return false;
            }

            stack SourceTryBindingStorageAllocation allocation = storageAllocations.Get(successor.Index);
            stack MirValueId arrayStorage = MirStackAlloc(instrs, allocation.ByteSize, allocation.Alignment);
            stack u32[0 max] storageOverride = localOverrides.Add(arrayStorage.Index());
            if (!arrayStorage.IsValid() || storageOverride == 0 || storageOverride != allocation.ParamIndex + 1)
            {
                return false;
            }

            nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
                fixedArrayStorageInitializers,
                allocation.LocalOrdinal,
                nextFixedArrayStorageInitializer,
                nodes,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
        }
        else if (successor.Kind == SourceTryBindingSuccessorStatementKindConstructedObjectStorage())
        {
            if (!storageAllocations.Contains(successor.Index))
            {
                return false;
            }

            stack SourceTryBindingStorageAllocation allocation = storageAllocations.Get(successor.Index);
            stack MirValueId objectStorage = MirStackAlloc(instrs, allocation.ByteSize, allocation.Alignment);
            stack u32[0 max] storageOverride = localOverrides.Add(objectStorage.Index());
            if (!objectStorage.IsValid() || storageOverride == 0 || storageOverride != allocation.ParamIndex + 1)
            {
                return false;
            }

            nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
                stackObjectFieldInitializers,
                allocation.LocalOrdinal,
                nextStackObjectInitializer,
                nodes,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
        }
        else if (successor.Kind == SourceTryBindingSuccessorStatementKindEnumStorage())
        {
            if (!storageAllocations.Contains(successor.Index))
            {
                return false;
            }

            stack SourceTryBindingStorageAllocation allocation = storageAllocations.Get(successor.Index);
            stack MirValueId enumStorage = MirStackAlloc(instrs, allocation.ByteSize, allocation.Alignment);
            stack u32[0 max] storageOverride = localOverrides.Add(enumStorage.Index());
            if (!enumStorage.IsValid() || storageOverride == 0 || storageOverride != allocation.ParamIndex + 1)
            {
                return false;
            }

            nextEnumStorageInitializer = LowerEnumStorageInitializersForLocalWithCallContext(
                enumStorageInitializers,
                allocation.LocalOrdinal,
                nextEnumStorageInitializer,
                nodes,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
        }
        else if (successor.Kind == SourceTryBindingSuccessorStatementKindMutation())
        {
            if (!LowerSourceStorageMutationStatementWithCallContext(
                storageMutationStatements,
                scalarStorageAssignments,
                enumStorageAssignments,
                constructedObjectFieldAssignments,
                successor.Index,
                nodes,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals))
            {
                return false;
            }
        }
        else
        {
            return false;
        }

        successorIndex = successorIndex + 1;
    }

    if ((u64[0 2 ** 63 - 1])(nextScalarStorageInitializer - 1) != scalarStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextEnumStorageInitializer - 1) != enumStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextStackObjectInitializer - 1) != stackObjectFieldInitializers.Count())
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    stack u32[0 max] finalFirst = segmentFirst;
    stack MirValueId returnValue = LowerScalarReturnExprNodeWithCallContext(
        nodes,
        returnRoot.NodeId,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals,
        rootType,
        hasDeclaredReturnType,
        declaredReturnType);
    if (!returnValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] finalCount = (u32[0 max])instrs.Count() - (finalFirst - 1);
    stack u32[0 max] expectedFinalBlockIndex = (u32[0 max])blocks.Count() + 1;
    stack MirBlockId finalBlock = MirReturnBlock(blocks, returnValue);
    if (finalBlock.Index() != expectedFinalBlockIndex)
    {
        return false;
    }

    if (recordRanges && ranges.Add(MakeBlockEmit(finalBlock.Index(), finalFirst, finalCount)) == 0)
    {
        return false;
    }

    body.Ok = true;
    body.EntryBlock = loweredTry.EntryBlockValue.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = loweredTry.ConditionValue.Index();
    body.ThenValue = loweredTry.ErrorReturnValue.Index();
    body.ElseValue = loweredTry.SuccessValueValue.Index();
    return true;
}

internal fn bool LowerModuleLocalTryAssignmentFunctionToBlocks(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithLocalTryAssignment(stream, source, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (stream.KindAt(localStart) != TokenKind.Var
        || !FindSelfHostedStatementEnd(stream, localStart, (u64[0 2 ** 63 - 1])returnIndex, localEnd))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localAssignToken = localEnd;
    if (!FindSelfHostedStatementAssign(stream, localStart, localEnd, localAssignToken))
    {
        return false;
    }

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    if (localNameToken == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = localEnd + 1;
    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || !StatementStartsScalarStorageAssignment(stream, assignmentStart, assignmentEnd)
        || !TokenTextEqualsAsciiSpan(stream, source, localNameToken, (u32[0 max])assignmentStart))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentAssignToken = assignmentEnd;
    if (!FindSelfHostedStatementAssign(stream, assignmentStart, assignmentEnd, assignmentAssignToken))
    {
        return false;
    }

    stack mut FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localNameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] localNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, localNameStart, localNameLength) >= 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeInitParse = params.Count();
    stack ExprParseResult initResult = ParseExprIn(stream, source, nodes, params, funcNames, localAssignToken + 1);
    if (initResult.NodeId == 0
        || initResult.Next != localEnd
        || params.Count() != beforeInitParse
        || !ExprNodeCanBeDiscardedIfOverwritten(nodes, initResult.NodeId))
    {
        return false;
    }

    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack u64[0 2 ** 63 - 1] beforeTryParse = params.Count();
    stack ExprParseResult tryExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        assignmentAssignToken + 1);
    if (tryExpr.NodeId == 0 || tryExpr.Next != assignmentEnd || params.Count() != beforeTryParse)
    {
        return false;
    }

    stack mut u32[0 max] operandNode = 0;
    if (!TryGetSourceTryOperandNode(nodes, tryExpr.NodeId, operandNode))
    {
        return false;
    }

    stack mut u32[0 max] operandOwnerDeclarationIndex = 0;
    if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, operandNode, localTypes, operandOwnerDeclarationIndex))
    {
        return false;
    }

    stack mut u32[0 max] returnOwnerDeclarationIndex = 0;
    stack mut DeclItem returnEnumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(
        stream,
        source,
        moduleFacts,
        signature.ReturnTypeTokenAt(),
        returnOwnerDeclarationIndex,
        returnEnumItem))
    {
        return false;
    }

    stack mut SourceTryPropagationCompatibilityFacts compatibility = new();
    if (!TryResolveSourceTryPropagationCompatibility(
        stream,
        sourceText,
        source,
        moduleFacts,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        compatibility))
    {
        return false;
    }

    stack SourceTryPropagationRoleFacts operandRoles = compatibility.OperandRoles();
    if (operandRoles.OkPayloadCount() != 1
        || !SourceExpressionTypeMatchesEnumPayloadTypeCode(TypeOfNodeWithLocals(nodes, initResult.NodeId, localTypes), operandRoles.OkPayloadTypeCode()))
    {
        return false;
    }

    stack u32[0 max] localTypeCode = SourceLocalTypeCodeForResolvedScalarValue(operandRoles.OkPayloadTypeCode());
    if (localTypeCode == SourceLocalTypeCodeNonValue())
    {
        return false;
    }

    stack u32[0 max] localIndex = ResolveParam(params, source, localNameStart, localNameLength);
    if (localIndex + 1 != (u32[0 max])(signatureParamCount + 1))
    {
        return false;
    }

    if (localTypes.Add(localTypeCode) == 0)
    {
        return false;
    }

    stack mut ValueFacts localFacts = new();
    if (localTypeCode == SourceLocalTypeCodeBool())
    {
        localFacts.SetIntegerRange(0, 2);
    }

    if (sourceValueFacts.Add(localFacts) == 0)
    {
        return false;
    }

    stack ExprParseResult returnRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        (u64[0 2 ** 63 - 1])returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (returnRoot.NodeId == 0 || stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != signatureParamCount + 1)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, loweringLocalTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack u32[0 max] localOverrideIndex = localOverrides.Add(0);
    if (localOverrideIndex == 0 || localOverrideIndex != localIndex + 1)
    {
        return false;
    }

    stack mut MirType tagType = MirType.I8;
    if (!TryGetSourceTryEnumTagType(moduleFacts, operandOwnerDeclarationIndex, tagType))
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId operandValue = LowerExprNodeWithCallContext(
        nodes,
        operandNode,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals);
    if (!operandValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack mut SourceTryPropagationLoweringResult loweredTry = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        compatibility,
        operandValue,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        MirBlockIdOf(firstBlock + 3),
        entryFirst,
        tagType,
        recordRanges,
        loweredTry))
    {
        return false;
    }

    if (!localOverrides.Replace(localIndex + 1, loweredTry.SuccessValueValue.Index()))
    {
        return false;
    }

    stack u32[0 max] finalFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    stack MirValueId returnValue = LowerScalarReturnExprNodeWithCallContext(
        nodes,
        returnRoot.NodeId,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals,
        rootType,
        hasDeclaredReturnType,
        declaredReturnType);
    if (!returnValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] finalCount = (u32[0 max])instrs.Count() - (finalFirst - 1);
    stack MirBlockId finalBlock = MirReturnBlock(blocks, returnValue);
    if (finalBlock.Index() != firstBlock + 3)
    {
        return false;
    }

    if (recordRanges && ranges.Add(MakeBlockEmit(finalBlock.Index(), finalFirst, finalCount)) == 0)
    {
        return false;
    }

    body.Ok = true;
    body.EntryBlock = loweredTry.EntryBlockValue.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = loweredTry.ConditionValue.Index();
    body.ThenValue = loweredTry.ErrorReturnValue.Index();
    body.ElseValue = loweredTry.SuccessValueValue.Index();
    return true;
}

internal fn bool LowerModuleLocalSourceSliceElementTryAssignmentFunctionToBlocks(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithLocalSourceSliceElementTryAssignment(stream, source, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    stack mut FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localRoots = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut IrTable<FixedArrayStorageLocal> fixedArrayStorageLocals = new();
    stack mut IrTable<FixedArrayStorageInitializer> fixedArrayStorageInitializers = new();
    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    stack mut IrTable<u32[0 max]> localOverrideValues = new();
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut bool sawLocal = false;
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    while willexit (cursor < (u64[0 2 ** 63 - 1])returnIndex && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])returnIndex, statementEnd))
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(cursor);
        stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, statementEnd);
        stack u32[0 max] scalarTypeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
        if (localStorage != TokenKind.Stack || localNameToken == 0 || scalarTypeToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
        {
            return false;
        }

        if (hasAssign && TryReadSliceSuffix(stream, scalarTypeToken))
        {
            stack mut SourceSliceDescriptorLocal sliceDescriptor = new();
            stack mut bool resolvedSliceDescriptor = TryResolveSliceDescriptorFromFixedArrayStorageLocal(
                stream,
                source,
                fixedArrayStorageLocals,
                scalarTypeToken,
                assignToken + 1,
                statementEnd,
                sliceDescriptor);
            if (!resolvedSliceDescriptor)
            {
                resolvedSliceDescriptor = TryResolveSliceDescriptorFromSourceSliceDescriptorLocal(
                    stream,
                    source,
                    sliceDescriptorLocals,
                    scalarTypeToken,
                    assignToken + 1,
                    statementEnd,
                    sliceDescriptor);
            }

            if (!resolvedSliceDescriptor)
            {
                return false;
            }

            stack u32[0 max] sliceLocalIndex = ResolveParam(params, source, nameStart, nameLength);
            stack u32[0 max] sliceLocalRoot = localRoots.Add(0);
            stack u32[0 max] sliceLocalType = localTypes.Add(SourceLocalTypeCodeNonValue());
            stack u32[0 max] sliceOverrideValue = localOverrideValues.Add(0);
            if (sliceLocalRoot == 0
                || sliceLocalType == 0
                || sliceOverrideValue == 0
                || sourceValueFacts.Add(new ValueFacts()) == 0)
            {
                return false;
            }

            sliceDescriptor.Start = nameStart;
            sliceDescriptor.Length = nameLength;
            sliceDescriptor.Mutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
            sliceDescriptor.ParamIndex = sliceLocalIndex;
            if (sliceDescriptorLocals.Add(sliceDescriptor) == 0)
            {
                return false;
            }

            sawLocal = true;
            cursor = statementEnd + 1;
            continue;
        }

        stack mut u32[0 max] fixedArrayLength = 0;
        if (!TryReadFixedArrayLengthSuffix(stream, source, scalarTypeToken, fixedArrayLength))
        {
            return false;
        }

        stack mut MirType elementType = MirType.I64;
        if (!MirTypeForKnownSourceScalarTypeHead(stream, source, scalarTypeToken, elementType))
        {
            return false;
        }

        stack u32[0 max] elementSize = ScalarTypeKnownByteExtent(stream, source, scalarTypeToken);
        stack u32[0 max] elementAlignment = NaturalAlignmentForByteExtent(elementSize);
        stack u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
        stack u32[0 max] arrayAllocationSize = TypeKnownByteExtentForLocal(stream, source, scalarTypeToken);
        stack u32[0 max] arrayAllocationAlign = TypeKnownByteAlignment(stream, source, scalarTypeToken);
        if (fixedArrayLength == 0
            || elementSize == 0
            || elementAlignment == 0
            || fieldTypeCode == SourceResolvedFieldTypeCodeInvalid()
            || arrayAllocationSize == 0
            || arrayAllocationAlign == 0)
        {
            return false;
        }

        stack mut IrTable<u32[0 max]> initializerRoots = new();
        if (hasAssign)
        {
            if (stream.KindAt(assignToken + 1) != TokenKind.LBrace)
            {
                return false;
            }

            stack u32[0 max] initializerClose = MatchingBraceForMirLowering(stream, (u32[0 max])(assignToken + 1));
            if (initializerClose == (u32[0 max])(assignToken + 1)
                || (u64[0 2 ** 63 - 1])initializerClose + 1 != statementEnd)
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
            if (!TryParseFixedArrayStorageInitializerRoots(
                stream,
                source,
                nodes,
                params,
                funcNames,
                constructedObjectLocals,
                sliceDescriptorLocals,
                localTypes,
                sourceValueFacts,
                moduleFacts,
                fixedArrayLength,
                fieldTypeCode,
                assignToken + 1,
                (u64[0 2 ** 63 - 1])initializerClose,
                initializerRoots)
                || params.Count() != beforeInit)
            {
                return false;
            }
        }
        else if (!SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd))
        {
            return false;
        }

        stack MirValueId arrayStorage = MirStackAlloc(instrs, arrayAllocationSize, arrayAllocationAlign);
        stack u32[0 max] arrayLocalIndex = ResolveParam(params, source, nameStart, nameLength);
        stack u32[0 max] arrayLocalOrdinal = localRoots.Add(0);
        stack u32[0 max] arrayLocalType = localTypes.Add(SourceLocalTypeCodeNonValue());
        stack u32[0 max] arrayOverrideValue = localOverrideValues.Add(arrayStorage.Index());
        if (arrayLocalOrdinal == 0
            || arrayLocalType == 0
            || arrayOverrideValue == 0
            || sourceValueFacts.Add(new ValueFacts()) == 0)
        {
            return false;
        }

        stack mut FixedArrayStorageLocal fixedArrayLocal = new();
        fixedArrayLocal.Start = nameStart;
        fixedArrayLocal.Length = nameLength;
        fixedArrayLocal.Mutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
        fixedArrayLocal.ParamIndex = arrayLocalIndex;
        fixedArrayLocal.StorageValue = arrayStorage.Index();
        fixedArrayLocal.ElementSize = elementSize;
        fixedArrayLocal.Alignment = elementAlignment;
        fixedArrayLocal.ArrayLength = fixedArrayLength;
        fixedArrayLocal.ElementType = elementType;
        fixedArrayLocal.FieldTypeCode = fieldTypeCode;
        if (fixedArrayStorageLocals.Add(fixedArrayLocal) == 0)
        {
            return false;
        }

        stack SourceSliceDescriptorLocal fixedArrayDescriptor = SourceSliceDescriptorFromFixedArrayStorageLocal(fixedArrayLocal);
        if (sliceDescriptorLocals.Add(fixedArrayDescriptor) == 0)
        {
            return false;
        }

        if (hasAssign)
        {
            stack mut u32[0 max] elementIndex = 0;
            while willexit (elementIndex < fixedArrayLength)
            {
                stack mut FixedArrayStorageInitializer initializer = new();
                initializer.LocalOrdinal = arrayLocalOrdinal;
                initializer.ParamIndex = arrayLocalIndex;
                initializer.ElementIndex = elementIndex;
                initializer.ElementSize = elementSize;
                initializer.Alignment = elementAlignment;
                initializer.ElementType = elementType;
                if (initializerRoots.Contains(elementIndex + 1))
                {
                    initializer.ExprRoot = initializerRoots.Get(elementIndex + 1);
                }

                if (fixedArrayStorageInitializers.Add(initializer) == 0)
                {
                    return false;
                }

                elementIndex = elementIndex + 1;
            }
        }

        sawLocal = true;
        cursor = statementEnd + 1;
    }

    if (!sawLocal)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = cursor;
    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || assignmentEnd + 1 != (u64[0 2 ** 63 - 1])returnIndex)
    {
        return false;
    }

    stack mut ConstructedObjectFieldAssignment fieldAssignment = new();
    if (!TryParseSourceSliceElementTryAssignmentStatement(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        assignmentStart,
        assignmentEnd,
        fieldAssignment))
    {
        return false;
    }

    stack mut u32[0 max] operandNode = 0;
    if (!TryGetSourceTryOperandNode(nodes, fieldAssignment.ExprRoot, operandNode))
    {
        return false;
    }

    stack mut u32[0 max] operandOwnerDeclarationIndex = 0;
    if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, operandNode, localTypes, operandOwnerDeclarationIndex))
    {
        return false;
    }

    stack mut u32[0 max] returnOwnerDeclarationIndex = 0;
    stack mut DeclItem returnEnumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(
        stream,
        source,
        moduleFacts,
        signature.ReturnTypeTokenAt(),
        returnOwnerDeclarationIndex,
        returnEnumItem))
    {
        return false;
    }

    stack mut SourceTryPropagationCompatibilityFacts compatibility = new();
    if (!TryResolveSourceTryPropagationCompatibility(
        stream,
        sourceText,
        source,
        moduleFacts,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        compatibility))
    {
        return false;
    }

    stack SourceTryPropagationRoleFacts operandRoles = compatibility.OperandRoles();
    if (operandRoles.OkPayloadCount() != 1
        || operandRoles.OkPayloadTypeCode() != fieldAssignment.FieldTypeCode
        || !SourceTryOkPayloadSatisfiesDeclaredAssignmentRange(
            stream,
            source,
            moduleFacts,
            operandOwnerDeclarationIndex,
            operandRoles,
            fieldAssignment))
    {
        return false;
    }

    stack ExprParseResult returnRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        (u64[0 2 ** 63 - 1])returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (returnRoot.NodeId == 0
        || stream.KindAt(afterReturn) != TokenKind.RBrace
        || params.Count() != signatureParamCount + localRoots.Count())
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, loweringLocalTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localCount = localRoots.Count();
    stack mut u64[0 2 ** 63 - 1] localCursor = 0;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    while willexit (localCursor < localCount)
    {
        stack u32[0 max] localOrdinal = (u32[0 max])(localCursor + 1);
        stack mut u32[0 max] storageOverride = 0;
        if (localOverrideValues.Contains(localOrdinal))
        {
            storageOverride = localOverrideValues.Get(localOrdinal);
        }

        stack u32[0 max] overrideIndex = localOverrides.Add(storageOverride);
        if (overrideIndex == 0)
        {
            return false;
        }

        nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
            fixedArrayStorageInitializers,
            localOrdinal,
            nextFixedArrayStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        localCursor = localCursor + 1;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return false;
    }

    stack mut MirType tagType = MirType.I8;
    if (!TryGetSourceTryEnumTagType(moduleFacts, operandOwnerDeclarationIndex, tagType))
    {
        return false;
    }

    stack MirValueId operandValue = LowerExprNodeWithCallContext(
        nodes,
        operandNode,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals);
    if (!operandValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack mut SourceTryPropagationLoweringResult loweredTry = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        compatibility,
        operandValue,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        MirBlockIdOf(firstBlock + 3),
        entryFirst,
        tagType,
        recordRanges,
        loweredTry))
    {
        return false;
    }

    stack u32[0 max] finalFirst = (u32[0 max])instrs.Count() + 1;
    if (!LowerConstructedObjectFieldAssignmentValueWithCallContext(
        fieldAssignment,
        loweredTry.SuccessValueValue,
        nodes,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    stack MirValueId returnValue = LowerScalarReturnExprNodeWithCallContext(
        nodes,
        returnRoot.NodeId,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals,
        rootType,
        hasDeclaredReturnType,
        declaredReturnType);
    if (!returnValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] finalCount = (u32[0 max])instrs.Count() - (finalFirst - 1);
    stack MirBlockId finalBlock = MirReturnBlock(blocks, returnValue);
    if (finalBlock.Index() != firstBlock + 3)
    {
        return false;
    }

    if (recordRanges && ranges.Add(MakeBlockEmit(finalBlock.Index(), finalFirst, finalCount)) == 0)
    {
        return false;
    }

    body.Ok = true;
    body.EntryBlock = loweredTry.EntryBlockValue.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = loweredTry.ConditionValue.Index();
    body.ThenValue = loweredTry.ErrorReturnValue.Index();
    body.ElseValue = loweredTry.SuccessValueValue.Index();
    return true;
}

internal fn bool LowerModuleStorageTryAssignmentFunctionToBlocks(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithStorageTryAssignment(stream, source, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (stream.KindAt(localStart) != TokenKind.Stack
        || !FindSelfHostedStatementEnd(stream, localStart, (u64[0 2 ** 63 - 1])returnIndex, localEnd)
        || !SelfHostedLocalDeclarationHasMut(stream, localStart, localEnd))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localAssignToken = localEnd;
    stack bool hasInitializer = FindSelfHostedStatementAssign(stream, localStart, localEnd, localAssignToken);

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    stack u32[0 max] localTypeToken = FindSelfHostedLocalTypeToken(stream, localStart, localEnd);
    if (localNameToken == 0 || localTypeToken == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = localEnd + 1;
    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || !StatementStartsScalarStorageAssignment(stream, assignmentStart, assignmentEnd)
        || !TokenTextEqualsAsciiSpan(stream, source, localNameToken, (u32[0 max])assignmentStart))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentAssignToken = assignmentEnd;
    if (!FindSelfHostedStatementAssign(stream, assignmentStart, assignmentEnd, assignmentAssignToken))
    {
        return false;
    }

    stack mut FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localNameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] localNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, localNameStart, localNameLength) >= 0)
    {
        return false;
    }

    stack mut MirType scalarFieldType = MirType.I64;
    if (!MirTypeForKnownSourceScalarType(stream, source, localTypeToken, scalarFieldType))
    {
        return false;
    }

    stack u32[0 max] scalarAllocationSize = TypeKnownByteExtentForLocal(stream, source, localTypeToken);
    stack u32[0 max] scalarAllocationAlign = TypeKnownByteAlignment(stream, source, localTypeToken);
    stack u32[0 max] scalarLocalTypeCode = SourceLocalStoredScalarTypeCodeForMirType(scalarFieldType);
    stack u32[0 max] scalarFieldTypeCode = SourceResolvedFieldTypeCodeForMirType(scalarFieldType);
    if (scalarAllocationSize == 0
        || scalarAllocationAlign == 0
        || !SourceLocalTypeCodeIsStoredScalar(scalarLocalTypeCode)
        || scalarFieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut ExprParseResult initResult = new();
    if (hasInitializer)
    {
        stack u64[0 2 ** 63 - 1] beforeInitParse = params.Count();
        initResult = ParseConstructedObjectExprWithEnumsAndSlicesIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            localTypes,
            sourceValueFacts,
            moduleFacts,
            localAssignToken + 1);
        if (initResult.NodeId == 0 || initResult.Next != localEnd || params.Count() != beforeInitParse)
        {
            return false;
        }

        if (!FieldInitializerTypeMatches(scalarFieldType, TypeOfNodeWithLocals(nodes, initResult.NodeId, localTypes)))
        {
            return false;
        }
    }

    stack mut u32[0 max] localIndex = 0;
    stack mut ExprParseResult tryExpr = new();
    if (hasInitializer)
    {
        localIndex = ResolveParam(params, source, localNameStart, localNameLength);
        if (localIndex + 1 != (u32[0 max])(signatureParamCount + 1))
        {
            return false;
        }

        if (localTypes.Add(scalarLocalTypeCode) == 0 || sourceValueFacts.Add(new ValueFacts()) == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforeTryParse = params.Count();
        tryExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            localTypes,
            sourceValueFacts,
            moduleFacts,
            assignmentAssignToken + 1);
        if (tryExpr.NodeId == 0 || tryExpr.Next != assignmentEnd || params.Count() != beforeTryParse)
        {
            return false;
        }
    }
    else
    {
        stack u64[0 2 ** 63 - 1] beforeTryParse = params.Count();
        tryExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            localTypes,
            sourceValueFacts,
            moduleFacts,
            assignmentAssignToken + 1);
        if (tryExpr.NodeId == 0 || tryExpr.Next != assignmentEnd || params.Count() != beforeTryParse)
        {
            return false;
        }

        localIndex = ResolveParam(params, source, localNameStart, localNameLength);
        if (localIndex + 1 != (u32[0 max])(signatureParamCount + 1))
        {
            return false;
        }

        if (localTypes.Add(scalarLocalTypeCode) == 0 || sourceValueFacts.Add(new ValueFacts()) == 0)
        {
            return false;
        }
    }

    stack mut u32[0 max] operandNode = 0;
    if (!TryGetSourceTryOperandNode(nodes, tryExpr.NodeId, operandNode))
    {
        return false;
    }

    stack mut u32[0 max] operandOwnerDeclarationIndex = 0;
    if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, operandNode, localTypes, operandOwnerDeclarationIndex))
    {
        return false;
    }

    stack mut u32[0 max] returnOwnerDeclarationIndex = 0;
    stack mut DeclItem returnEnumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(
        stream,
        source,
        moduleFacts,
        signature.ReturnTypeTokenAt(),
        returnOwnerDeclarationIndex,
        returnEnumItem))
    {
        return false;
    }

    stack mut SourceTryPropagationCompatibilityFacts compatibility = new();
    if (!TryResolveSourceTryPropagationCompatibility(
        stream,
        sourceText,
        source,
        moduleFacts,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        compatibility))
    {
        return false;
    }

    stack SourceTryPropagationRoleFacts operandRoles = compatibility.OperandRoles();
    if (operandRoles.OkPayloadCount() != 1 || operandRoles.OkPayloadTypeCode() != scalarFieldTypeCode)
    {
        return false;
    }

    stack ExprParseResult returnRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        (u64[0 2 ** 63 - 1])returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (returnRoot.NodeId == 0 || stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != signatureParamCount + 1)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, loweringLocalTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack mut MirType tagType = MirType.I8;
    if (!TryGetSourceTryEnumTagType(moduleFacts, operandOwnerDeclarationIndex, tagType))
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId scalarStorage = MirStackAlloc(instrs, scalarAllocationSize, scalarAllocationAlign);
    stack u32[0 max] localOverrideIndex = localOverrides.Add(scalarStorage.Index());
    if (!scalarStorage.IsValid() || localOverrideIndex == 0 || localOverrideIndex != localIndex + 1)
    {
        return false;
    }

    if (hasInitializer)
    {
        stack MirValueId initValue = LowerExprNodeAsTypeWithCallContext(
            nodes,
            initResult.NodeId,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals,
            scalarFieldType);
        stack MirValueId initStore = MirStorePtrAlignedTyped(instrs, scalarFieldType, scalarStorage, initValue, scalarAllocationAlign);
        if (!initValue.IsValid() || !initStore.IsValid())
        {
            return false;
        }
    }

    stack MirValueId operandValue = LowerExprNodeWithCallContext(
        nodes,
        operandNode,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals);
    if (!operandValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack mut SourceTryPropagationLoweringResult loweredTry = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        compatibility,
        operandValue,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        MirBlockIdOf(firstBlock + 3),
        entryFirst,
        tagType,
        recordRanges,
        loweredTry))
    {
        return false;
    }

    stack u32[0 max] finalFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId successStore = MirStorePtrAlignedTyped(instrs, scalarFieldType, scalarStorage, loweredTry.SuccessValueValue, scalarAllocationAlign);
    if (!successStore.IsValid())
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    stack MirValueId returnValue = LowerScalarReturnExprNodeWithCallContext(
        nodes,
        returnRoot.NodeId,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals,
        rootType,
        hasDeclaredReturnType,
        declaredReturnType);
    if (!returnValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] finalCount = (u32[0 max])instrs.Count() - (finalFirst - 1);
    stack MirBlockId finalBlock = MirReturnBlock(blocks, returnValue);
    if (finalBlock.Index() != firstBlock + 3)
    {
        return false;
    }

    if (recordRanges && ranges.Add(MakeBlockEmit(finalBlock.Index(), finalFirst, finalCount)) == 0)
    {
        return false;
    }

    body.Ok = true;
    body.EntryBlock = loweredTry.EntryBlockValue.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = loweredTry.ConditionValue.Index();
    body.ThenValue = loweredTry.ErrorReturnValue.Index();
    body.ElseValue = loweredTry.SuccessValueValue.Index();
    return true;
}

internal fn bool LowerModuleSourceSliceElementTryAssignmentFunctionToBlocks(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithSourceSliceElementTryAssignment(stream, source, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || !StatementStartsSourceSliceElementAssignment(stream, assignmentStart, assignmentEnd))
    {
        return false;
    }

    stack mut FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut ConstructedObjectFieldAssignment fieldAssignment = new();
    if (!TryParseSourceSliceElementTryAssignmentStatement(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        assignmentStart,
        assignmentEnd,
        fieldAssignment))
    {
        return false;
    }

    stack mut u32[0 max] operandNode = 0;
    if (!TryGetSourceTryOperandNode(nodes, fieldAssignment.ExprRoot, operandNode))
    {
        return false;
    }

    stack mut u32[0 max] operandOwnerDeclarationIndex = 0;
    if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, operandNode, localTypes, operandOwnerDeclarationIndex))
    {
        return false;
    }

    stack mut u32[0 max] returnOwnerDeclarationIndex = 0;
    stack mut DeclItem returnEnumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(
        stream,
        source,
        moduleFacts,
        signature.ReturnTypeTokenAt(),
        returnOwnerDeclarationIndex,
        returnEnumItem))
    {
        return false;
    }

    stack mut SourceTryPropagationCompatibilityFacts compatibility = new();
    if (!TryResolveSourceTryPropagationCompatibility(
        stream,
        sourceText,
        source,
        moduleFacts,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        compatibility))
    {
        return false;
    }

    stack SourceTryPropagationRoleFacts operandRoles = compatibility.OperandRoles();
    if (operandRoles.OkPayloadCount() != 1
        || operandRoles.OkPayloadTypeCode() != fieldAssignment.FieldTypeCode
        || !SourceTryOkPayloadSatisfiesDeclaredAssignmentRange(
            stream,
            source,
            moduleFacts,
            operandOwnerDeclarationIndex,
            operandRoles,
            fieldAssignment))
    {
        return false;
    }

    stack ExprParseResult returnRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        (u64[0 2 ** 63 - 1])returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (returnRoot.NodeId == 0 || stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, loweringLocalTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack mut MirType tagType = MirType.I8;
    if (!TryGetSourceTryEnumTagType(moduleFacts, operandOwnerDeclarationIndex, tagType))
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId operandValue = LowerExprNodeWithCallContext(
        nodes,
        operandNode,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals);
    if (!operandValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack mut SourceTryPropagationLoweringResult loweredTry = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        compatibility,
        operandValue,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        MirBlockIdOf(firstBlock + 3),
        entryFirst,
        tagType,
        recordRanges,
        loweredTry))
    {
        return false;
    }

    stack u32[0 max] finalFirst = (u32[0 max])instrs.Count() + 1;
    if (!LowerConstructedObjectFieldAssignmentValueWithCallContext(
        fieldAssignment,
        loweredTry.SuccessValueValue,
        nodes,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    stack MirValueId returnValue = LowerScalarReturnExprNodeWithCallContext(
        nodes,
        returnRoot.NodeId,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals,
        rootType,
        hasDeclaredReturnType,
        declaredReturnType);
    if (!returnValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] finalCount = (u32[0 max])instrs.Count() - (finalFirst - 1);
    stack MirBlockId finalBlock = MirReturnBlock(blocks, returnValue);
    if (finalBlock.Index() != firstBlock + 3)
    {
        return false;
    }

    if (recordRanges && ranges.Add(MakeBlockEmit(finalBlock.Index(), finalFirst, finalCount)) == 0)
    {
        return false;
    }

    body.Ok = true;
    body.EntryBlock = loweredTry.EntryBlockValue.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = loweredTry.ConditionValue.Index();
    body.ThenValue = loweredTry.ErrorReturnValue.Index();
    body.ElseValue = loweredTry.SuccessValueValue.Index();
    return true;
}

internal fn bool LowerModuleConstructedObjectFieldTryAssignmentFunctionToBlocks(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithConstructedObjectFieldTryAssignment(stream, source, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    stack i64[min max] returnIndex = FirstTokenOfKindAfter(stream, TokenKind.Return, fnIndex);
    if (braceIndex < 0 || returnIndex < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    stack TokenKind localStorage = stream.KindAt(localStart);
    if ((localStorage != TokenKind.Stack && localStorage != TokenKind.Heap)
        || !FindSelfHostedStatementEnd(stream, localStart, (u64[0 2 ** 63 - 1])returnIndex, localEnd))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localAssignToken = localEnd;
    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    stack u32[0 max] objectTypeToken = FindSelfHostedLocalTypeToken(stream, localStart, localEnd);
    if (localNameToken == 0
        || objectTypeToken == 0
        || !FindSelfHostedStatementAssign(stream, localStart, localEnd, localAssignToken))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] assignmentStart = localEnd + 1;
    stack mut u64[0 2 ** 63 - 1] assignmentEnd = assignmentStart;
    if (!FindSelfHostedStatementEnd(stream, assignmentStart, (u64[0 2 ** 63 - 1])returnIndex, assignmentEnd)
        || !StatementStartsConstructedObjectFieldAssignment(stream, assignmentStart, assignmentEnd)
        || !TokenTextEqualsAsciiSpan(stream, source, localNameToken, (u32[0 max])assignmentStart))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentAssignToken = assignmentEnd;
    if (!FindConstructedObjectFieldAssignmentAssignToken(stream, assignmentStart, assignmentEnd, assignmentAssignToken))
    {
        return false;
    }

    stack mut FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    if (localStorage == TokenKind.Heap && signature.LawKind())
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localNameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] localNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, localNameStart, localNameLength) >= 0)
    {
        return false;
    }

    stack mut u32[0 max] bodyOpen = 0;
    stack mut u32[0 max] bodyClose = 0;
    stack mut u32[0 max] argsOpen = 0;
    stack mut u32[0 max] argsClose = 0;
    stack mut bool objectConstructor = false;
    stack mut bool positionalRecordConstructor = false;
    if (TryParseTargetTypedObjectConstructorShape(stream, source, objectTypeToken, localAssignToken, localEnd, bodyOpen, bodyClose))
    {
        objectConstructor = true;
    }
    else if (TryParseTargetTypedPositionalRecordConstructorShape(stream, source, objectTypeToken, localAssignToken, localEnd, argsOpen, argsClose))
    {
        objectConstructor = true;
        positionalRecordConstructor = true;
    }

    stack u32[0 max] objectAllocationSize = TypeKnownByteExtentForLocalWithEnums(stream, source, moduleFacts, objectTypeToken);
    stack u32[0 max] objectAllocationAlign = TypeKnownByteAlignmentWithEnums(stream, source, moduleFacts, objectTypeToken);
    if (!objectConstructor || objectAllocationSize == 0 || objectAllocationAlign == 0)
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId objectAllocation = new();
    if (localStorage == TokenKind.Heap)
    {
        objectAllocation = MirHeapAlloc(instrs, objectAllocationSize, objectAllocationAlign);
    }
    else
    {
        objectAllocation = MirStackAlloc(instrs, objectAllocationSize, objectAllocationAlign);
    }

    if (!objectAllocation.IsValid())
    {
        return false;
    }

    stack u32[0 max] objectLocalIndex = ResolveParam(params, source, localNameStart, localNameLength);
    stack u32[0 max] objectLocalTypeIndex = localTypes.Add(SourceLocalTypeCodeNonValue());
    stack u32[0 max] objectValueFactsIndex = sourceValueFacts.Add(new ValueFacts());
    if (objectLocalIndex + 1 != (u32[0 max])(signatureParamCount + 1)
        || objectLocalTypeIndex != objectLocalIndex + 1
        || objectValueFactsIndex != objectLocalIndex + 1)
    {
        return false;
    }

    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut IrTable<StackObjectFieldInitializer> stackObjectFieldInitializers = new();
    stack u32[0 max] objectLocalOrdinal = 1;
    if (positionalRecordConstructor)
    {
        if (!TryParseStackObjectPositionalRecordConstructorInitializers(
            stream,
            source,
            moduleFacts,
            objectTypeToken,
            argsOpen,
            argsClose,
            objectLocalOrdinal,
            objectLocalIndex,
            objectAllocation,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            localTypes,
            sourceValueFacts,
            stackObjectFieldInitializers))
        {
            return false;
        }
    }
    else
    {
        if (!TryParseStackObjectDefaultConstructorInitializers(
            stream,
            source,
            moduleFacts,
            objectTypeToken,
            objectLocalOrdinal,
            objectLocalIndex,
            objectAllocation,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            localTypes,
            sourceValueFacts,
            stackObjectFieldInitializers))
        {
            return false;
        }

        if (!TryParseStackObjectFieldInitializers(
            stream,
            source,
            moduleFacts,
            objectTypeToken,
            bodyOpen,
            bodyClose,
            objectLocalOrdinal,
            objectLocalIndex,
            objectAllocation,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            localTypes,
            sourceValueFacts,
            stackObjectFieldInitializers))
        {
            return false;
        }
    }

    stack mut ConstructedObjectLocal constructedObjectLocal = new();
    constructedObjectLocal.Start = localNameStart;
    constructedObjectLocal.Length = localNameLength;
    constructedObjectLocal.ParamIndex = objectLocalIndex;
    constructedObjectLocal.TypeToken = objectTypeToken;
    if (constructedObjectLocals.Add(constructedObjectLocal) == 0)
    {
        return false;
    }

    stack mut ConstructedObjectFieldAssignment fieldAssignment = new();
    if (!TryParseConstructedObjectFieldTryAssignmentStatement(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        assignmentStart,
        assignmentEnd,
        fieldAssignment)
        || fieldAssignment.ReceiverParamIndex != objectLocalIndex)
    {
        return false;
    }

    stack mut u32[0 max] operandNode = 0;
    if (!TryGetSourceTryOperandNode(nodes, fieldAssignment.ExprRoot, operandNode))
    {
        return false;
    }

    stack mut u32[0 max] operandOwnerDeclarationIndex = 0;
    if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, operandNode, localTypes, operandOwnerDeclarationIndex))
    {
        return false;
    }

    stack mut u32[0 max] returnOwnerDeclarationIndex = 0;
    stack mut DeclItem returnEnumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(
        stream,
        source,
        moduleFacts,
        signature.ReturnTypeTokenAt(),
        returnOwnerDeclarationIndex,
        returnEnumItem))
    {
        return false;
    }

    stack mut SourceTryPropagationCompatibilityFacts compatibility = new();
    if (!TryResolveSourceTryPropagationCompatibility(
        stream,
        sourceText,
        source,
        moduleFacts,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        compatibility))
    {
        return false;
    }

    stack SourceTryPropagationRoleFacts operandRoles = compatibility.OperandRoles();
    if (operandRoles.OkPayloadCount() != 1
        || operandRoles.OkPayloadTypeCode() != fieldAssignment.FieldTypeCode
        || !SourceTryOkPayloadSatisfiesDeclaredAssignmentRange(
            stream,
            source,
            moduleFacts,
            operandOwnerDeclarationIndex,
            operandRoles,
            fieldAssignment))
    {
        return false;
    }

    stack ExprParseResult returnRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        (u64[0 2 ** 63 - 1])returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (returnRoot.NodeId == 0 || stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != signatureParamCount + 1)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, loweringLocalTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack u32[0 max] objectOverrideIndex = localOverrides.Add(objectAllocation.Index());
    if (objectOverrideIndex == 0 || objectOverrideIndex != objectLocalIndex + 1)
    {
        return false;
    }

    stack u32[0 max] nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
        stackObjectFieldInitializers,
        objectLocalOrdinal,
        1,
        nodes,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals);
    if ((u64[0 2 ** 63 - 1])(nextStackObjectInitializer - 1) != stackObjectFieldInitializers.Count())
    {
        return false;
    }

    stack mut MirType tagType = MirType.I8;
    if (!TryGetSourceTryEnumTagType(moduleFacts, operandOwnerDeclarationIndex, tagType))
    {
        return false;
    }

    stack MirValueId operandValue = LowerExprNodeWithCallContext(
        nodes,
        operandNode,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals);
    if (!operandValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack mut SourceTryPropagationLoweringResult loweredTry = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        compatibility,
        operandValue,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        MirBlockIdOf(firstBlock + 3),
        entryFirst,
        tagType,
        recordRanges,
        loweredTry))
    {
        return false;
    }

    stack u32[0 max] finalFirst = (u32[0 max])instrs.Count() + 1;
    if (!LowerConstructedObjectFieldAssignmentValueWithCallContext(
        fieldAssignment,
        loweredTry.SuccessValueValue,
        nodes,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    stack MirValueId returnValue = LowerScalarReturnExprNodeWithCallContext(
        nodes,
        returnRoot.NodeId,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals,
        rootType,
        hasDeclaredReturnType,
        declaredReturnType);
    if (!returnValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] finalCount = (u32[0 max])instrs.Count() - (finalFirst - 1);
    stack MirBlockId finalBlock = MirReturnBlock(blocks, returnValue);
    if (finalBlock.Index() != firstBlock + 3)
    {
        return false;
    }

    if (recordRanges && ranges.Add(MakeBlockEmit(finalBlock.Index(), finalFirst, finalCount)) == 0)
    {
        return false;
    }

    body.Ok = true;
    body.EntryBlock = loweredTry.EntryBlockValue.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = loweredTry.ConditionValue.Index();
    body.ThenValue = loweredTry.ErrorReturnValue.Index();
    body.ElseValue = loweredTry.SuccessValueValue.Index();
    return true;
}

internal fn bool LowerModuleReturnTryExpressionFunctionToBlocks(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithReturnTryExpression(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])braceIndex);
    if (closeBrace == (u32[0 max])braceIndex)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] returnIndex = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack ExprParseResult tryExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterTry = tryExpr.Next;
    if (stream.KindAt(afterTry) == TokenKind.Semi)
    {
        afterTry = afterTry + 1;
    }

    if (tryExpr.NodeId == 0 || afterTry != (u64[0 2 ** 63 - 1])closeBrace || params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut u32[0 max] operandNode = 0;
    if (!TryGetSourceTryOperandNode(nodes, tryExpr.NodeId, operandNode))
    {
        return false;
    }

    stack mut u32[0 max] operandOwnerDeclarationIndex = 0;
    if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, operandNode, localTypes, operandOwnerDeclarationIndex))
    {
        return false;
    }

    stack mut u32[0 max] returnOwnerDeclarationIndex = 0;
    stack mut DeclItem returnEnumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(
        stream,
        source,
        moduleFacts,
        signature.ReturnTypeTokenAt(),
        returnOwnerDeclarationIndex,
        returnEnumItem))
    {
        return false;
    }

    stack mut SourceTryPropagationCompatibilityFacts compatibility = new();
    if (!TryResolveSourceTryPropagationCompatibility(
        stream,
        sourceText,
        source,
        moduleFacts,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        compatibility))
    {
        return false;
    }

    stack SourceTryPropagationRoleFacts operandRoles = compatibility.OperandRoles();
    if (operandRoles.OkPayloadCount() != 1
        || !SourceResolvedFieldTypeCodeIsEnum(operandRoles.OkPayloadTypeCode())
        || SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(operandRoles.OkPayloadTypeCode()) != returnOwnerDeclarationIndex)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack mut MirType tagType = MirType.I8;
    if (!TryGetSourceTryEnumTagType(moduleFacts, operandOwnerDeclarationIndex, tagType))
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId operandValue = LowerExprNodeWithCallContext(
        nodes,
        operandNode,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals);
    if (!operandValue.IsValid())
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack mut SourceTryPropagationLoweringResult loweredTry = new();
    if (!TryLowerSameFamilySourceTryPropagation(
        instrs,
        blocks,
        ranges,
        compatibility,
        operandValue,
        operandOwnerDeclarationIndex,
        returnOwnerDeclarationIndex,
        MirBlockIdOf(firstBlock + 3),
        entryFirst,
        tagType,
        recordRanges,
        loweredTry))
    {
        return false;
    }

    stack u32[0 max] finalFirst = (u32[0 max])instrs.Count() + 1;
    stack MirBlockId finalBlock = MirReturnBlock(blocks, loweredTry.SuccessValueValue);
    if (finalBlock.Index() != firstBlock + 3)
    {
        return false;
    }

    if (recordRanges && ranges.Add(MakeBlockEmit(finalBlock.Index(), finalFirst, 0)) == 0)
    {
        return false;
    }

    body.Ok = true;
    body.EntryBlock = loweredTry.EntryBlockValue.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = loweredTry.ConditionValue.Index();
    body.ThenValue = loweredTry.ErrorReturnValue.Index();
    body.ElseValue = loweredTry.SuccessValueValue.Index();
    return true;
}
