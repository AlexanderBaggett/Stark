import Compiler.Parsing
import Compiler.Mir.PackageImage.Loader.ManifestJsonReader
import Compiler.Mir.PackageImage.Loader.SourceSurfaceSectionLoader
import System.Json
import System.Memory
import System.Text
import Compiler.Mir.PackageImage.Bridge.PackageImageSourceBridgeCore
module Compiler.Mir.PackageImage.Bridge.PackageImageSourceExpressionRenderer

// Typed generic arguments, callable contracts, type references, enum/call
// expressions, and general expression reconstruction.

internal fn bool PackageImageSourceBridgeFindTemplateOperationByOrdinal(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    ascii memberName,
    u32[0 max] ordinal,
    out u64[0 2 ** 63 - 1] operationNode)
{
    operationNode = 0;
    stack mut u64[0 2 ** 63 - 1] operationsNode = 0;
    stack mut u32[0 max] operationCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            templateNode,
            memberName,
            operationsNode,
            operationCount))
    {
        return false;
    }

    stack mut bool matched = false;
    stack mut u32[0 max] operationIndex = 0;
    while willexit (operationIndex < operationCount)
    {
        stack mut u64[0 2 ** 63 - 1] candidateNode = 0;
        stack mut u32[0 max] candidateOrdinal = 0;
        if (!document.TryChildAt(
                operationsNode,
                (u64[0 2 ** 63 - 1])operationIndex,
                candidateNode)
            || document.KindAt(candidateNode) != JsonKind.Object
            || !LogicalPackageImageJsonRequiredU32MemberValue(
                document,
                candidateNode,
                "Ordinal",
                candidateOrdinal))
        {
            return false;
        }

        if (candidateOrdinal == ordinal)
        {
            if (matched)
            {
                return false;
            }

            matched = true;
            operationNode = candidateNode;
        }

        operationIndex = operationIndex + 1;
    }

    return matched;
}

internal fn bool PackageImageSourceBridgeRenderTypedGenericArguments(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeArgumentsNode,
    u32[0 max] typeArgumentCount,
    u64[0 2 ** 63 - 1] comptimeArgumentsNode,
    u32[0 max] comptimeArgumentCount,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    stack u32[0 max] genericArgumentCount = typeArgumentCount + comptimeArgumentCount;
    if (genericArgumentCount == 0)
    {
        return true;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, "<"))
    {
        return false;
    }

    stack mut u32[0 max] typeArgumentIndex = 0;
    while willexit (typeArgumentIndex < typeArgumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                typeArgumentsNode,
                (u64[0 2 ** 63 - 1])typeArgumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (typeArgumentIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        typeArgumentIndex = typeArgumentIndex + 1;
    }

    stack mut u32[0 max] comptimeArgumentIndex = 0;
    while willexit (comptimeArgumentIndex < comptimeArgumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] integerValueNode = 0;
        stack mut u64[0 2 ** 63 - 1] symbolicSourceNameNode = 0;
        stack mut bool isSymbolic = false;
        stack mut bool hasSymbolicSourceName = false;
        if (!document.TryChildAt(
                comptimeArgumentsNode,
                (u64[0 2 ** 63 - 1])comptimeArgumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || !document.TryFindMember(argumentNode, "ParameterName", parameterNameNode)
            || document.KindAt(parameterNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(parameterNameNode)) == 0
            || !document.TryFindMember(argumentNode, "IntegerValue", integerValueNode)
            || document.KindAt(integerValueNode) != JsonKind.Text
            || AsciiLength(document.TextAt(integerValueNode)) == 0
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                argumentNode,
                "IsSymbolic",
                isSymbolic)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                argumentNode,
                "SymbolicSourceName",
                symbolicSourceNameNode,
                hasSymbolicSourceName)
            || ((typeArgumentCount != 0 || comptimeArgumentIndex != 0)
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || (isSymbolic && !PackageImageSourceBridgeAppendConst(sink, "comptime "))
            || !PackageImageSourceBridgeAppend(
                sink,
                isSymbolic
                    ? hasSymbolicSourceName
                        ? document.TextAt(symbolicSourceNameNode)
                        : document.TextAt(parameterNameNode)
                    : document.TextAt(integerValueNode)))
        {
            return false;
        }

        comptimeArgumentIndex = comptimeArgumentIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ">");
}

internal fn bool PackageImageSourceBridgeRenderTypedCallableContractGroups(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] groupsNode,
    u32[0 max] groupCount,
    ascii relationName,
    bool hadClause,
    mut borrow OwnedAscii sink,
    out bool hasClause)
{
    hasClause = hadClause;
    stack mut u32[0 max] groupIndex = 0;
    while willexit (groupIndex < groupCount)
    {
        stack mut u64[0 2 ** 63 - 1] groupNode = 0;
        stack mut u64[0 2 ** 63 - 1] namesNode = 0;
        stack mut u32[0 max] nameCount = 0;
        if (!document.TryChildAt(
                groupsNode,
                (u64[0 2 ** 63 - 1])groupIndex,
                groupNode)
            || document.KindAt(groupNode) != JsonKind.Object
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                groupNode,
                "ParameterNames",
                namesNode,
                nameCount))
        {
            return false;
        }

        stack mut u32[0 max] uniqueNameCount = 0;
        stack mut u32[0 max] nameIndex = 0;
        while willexit (nameIndex < nameCount)
        {
            stack mut u64[0 2 ** 63 - 1] nameNode = 0;
            if (!document.TryChildAt(
                    namesNode,
                    (u64[0 2 ** 63 - 1])nameIndex,
                    nameNode)
                || document.KindAt(nameNode) != JsonKind.Text)
            {
                return false;
            }

            stack ascii name = document.TextAt(nameNode);
            stack mut bool duplicate = AsciiLength(name) == 0;
            stack mut u32[0 max] earlierIndex = 0;
            while willexit (!duplicate && earlierIndex < nameIndex)
            {
                stack mut u64[0 2 ** 63 - 1] earlierNode = 0;
                if (!document.TryChildAt(
                        namesNode,
                        (u64[0 2 ** 63 - 1])earlierIndex,
                        earlierNode)
                    || document.KindAt(earlierNode) != JsonKind.Text)
                {
                    return false;
                }

                duplicate = document.TextAt(earlierNode) == name;
                earlierIndex = earlierIndex + 1;
            }

            if (!duplicate)
            {
                uniqueNameCount = uniqueNameCount + 1;
            }

            nameIndex = nameIndex + 1;
        }

        if (uniqueNameCount >= 2)
        {
            if (!PackageImageSourceBridgeAppendConst(
                    sink,
                    hasClause ? ", " : " where ")
                || !PackageImageSourceBridgeAppend(sink, relationName)
                || !PackageImageSourceBridgeAppendConst(sink, "("))
            {
                return false;
            }

            stack mut u32[0 max] renderedNameCount = 0;
            nameIndex = 0;
            while willexit (nameIndex < nameCount)
            {
                stack mut u64[0 2 ** 63 - 1] nameNode = 0;
                if (!document.TryChildAt(
                        namesNode,
                        (u64[0 2 ** 63 - 1])nameIndex,
                        nameNode)
                    || document.KindAt(nameNode) != JsonKind.Text)
                {
                    return false;
                }

                stack ascii name = document.TextAt(nameNode);
                stack mut bool duplicate = AsciiLength(name) == 0;
                stack mut u32[0 max] earlierIndex = 0;
                while willexit (!duplicate && earlierIndex < nameIndex)
                {
                    stack mut u64[0 2 ** 63 - 1] earlierNode = 0;
                    if (!document.TryChildAt(
                            namesNode,
                            (u64[0 2 ** 63 - 1])earlierIndex,
                            earlierNode)
                        || document.KindAt(earlierNode) != JsonKind.Text)
                    {
                        return false;
                    }

                    duplicate = document.TextAt(earlierNode) == name;
                    earlierIndex = earlierIndex + 1;
                }

                if (!duplicate
                    && ((renderedNameCount != 0
                            && !PackageImageSourceBridgeAppendConst(sink, ", "))
                        || !PackageImageSourceBridgeAppend(sink, name)))
                {
                    return false;
                }

                if (!duplicate)
                {
                    renderedNameCount = renderedNameCount + 1;
                }

                nameIndex = nameIndex + 1;
            }

            if (!PackageImageSourceBridgeAppendConst(sink, ")"))
            {
                return false;
            }

            hasClause = true;
        }

        groupIndex = groupIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderTypedCallableTypeReference(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeNode,
    ascii kind,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] returnTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] parameterTypesNode = 0;
    stack mut u64[0 2 ** 63 - 1] parameterCountExpressionsNode = 0;
    stack mut u64[0 2 ** 63 - 1] functionKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] functionAbiNode = 0;
    stack mut u64[0 2 ** 63 - 1] closureStorageKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] closureCallCapabilityNode = 0;
    stack mut u64[0 2 ** 63 - 1] overlapGroupsNode = 0;
    stack mut u64[0 2 ** 63 - 1] sameGroupsNode = 0;
    stack mut u64[0 2 ** 63 - 1] deadNamesNode = 0;
    stack mut bool hasFunctionKind = false;
    stack mut bool hasFunctionAbi = false;
    stack mut bool hasClosureStorageKind = false;
    stack mut bool hasClosureCallCapability = false;
    stack mut bool functionIsUnsafe = false;
    stack mut bool functionIsTailCallable = false;
    stack mut u32[0 max] parameterTypeCount = 0;
    stack mut u32[0 max] parameterCountExpressionCount = 0;
    stack mut u32[0 max] overlapGroupCount = 0;
    stack mut u32[0 max] sameGroupCount = 0;
    stack mut u32[0 max] deadNameCount = 0;
    if (!LogicalPackageImageJsonRequiredObjectMember(
            document,
            typeNode,
            "ReturnType",
            returnTypeNode)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "ParameterTypes",
            parameterTypesNode,
            parameterTypeCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "ParameterRawPointerElementCountExpressions",
            parameterCountExpressionsNode,
            parameterCountExpressionCount)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "FunctionKind",
            functionKindNode,
            hasFunctionKind)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "FunctionAbi",
            functionAbiNode,
            hasFunctionAbi)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "FunctionIsUnsafe",
            functionIsUnsafe)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "FunctionIsTailCallable",
            functionIsTailCallable)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "ClosureStorageKind",
            closureStorageKindNode,
            hasClosureStorageKind)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "ClosureCallCapability",
            closureCallCapabilityNode,
            hasClosureCallCapability)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "OverlapParameterGroups",
            overlapGroupsNode,
            overlapGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "SameParameterGroups",
            sameGroupsNode,
            sameGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "PointeeDeadOnReturnParameterNames",
            deadNamesNode,
            deadNameCount))
    {
        return false;
    }

    stack bool isClosure = kind == "closure" || kind == "Closure";
    if (isClosure)
    {
        if ((hasClosureStorageKind
                && document.TextAt(closureStorageKindNode) == "inline"
                && !PackageImageSourceBridgeAppendConst(sink, "inline "))
            || (hasClosureStorageKind
                && document.TextAt(closureStorageKindNode) == "heap"
                && !PackageImageSourceBridgeAppendConst(sink, "heap "))
            || !PackageImageSourceBridgeAppendConst(sink, "closure<")
            || (hasClosureCallCapability
                && document.TextAt(closureCallCapabilityNode) == "mut"
                && !PackageImageSourceBridgeAppendConst(sink, "mut "))
            || (hasClosureCallCapability
                && document.TextAt(closureCallCapabilityNode) == "once"
                && !PackageImageSourceBridgeAppendConst(sink, "once ")))
        {
            return false;
        }
    }
    else if (!PackageImageSourceBridgeAppendConst(sink, "fnptr<")
        || (functionIsUnsafe
            && !PackageImageSourceBridgeAppendConst(sink, "unsafe "))
        || (hasFunctionAbi
            && AsciiLength(document.TextAt(functionAbiNode)) != 0
            && (!PackageImageSourceBridgeAppendConst(sink, "ffi(")
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(functionAbiNode))
                || !PackageImageSourceBridgeAppendConst(sink, ") "))))
    {
        return false;
    }

    stack ascii functionKind = hasFunctionKind
        ? document.TextAt(functionKindNode)
        : "fn";
    stack ascii renderedFunctionKind = functionKind == "finite"
        ? "finite"
        : functionKind == "law"
            ? "law"
            : functionKind == "finite law" || functionKind == "finitelaw"
                ? "finite law"
                : "fn";
    if ((functionIsTailCallable
            && !PackageImageSourceBridgeAppendConst(sink, "tail "))
        || !PackageImageSourceBridgeAppend(sink, renderedFunctionKind)
        || !PackageImageSourceBridgeAppendConst(sink, " ")
        || !PackageImageSourceBridgeRenderTypedTypeReference(
            document,
            returnTypeNode,
            depth + 1,
            sink)
        || !PackageImageSourceBridgeAppendConst(sink, "("))
    {
        return false;
    }

    stack mut u32[0 max] parameterIndex = 0;
    while willexit (parameterIndex < parameterTypeCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterTypeNode = 0;
        if (!document.TryChildAt(
                parameterTypesNode,
                (u64[0 2 ** 63 - 1])parameterIndex,
                parameterTypeNode)
            || document.KindAt(parameterTypeNode) != JsonKind.Object
            || (parameterIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                parameterTypeNode,
                depth + 1,
                sink))
        {
            return false;
        }

        if (parameterIndex < parameterCountExpressionCount)
        {
            stack mut u64[0 2 ** 63 - 1] countExpressionNode = 0;
            if (!document.TryChildAt(
                    parameterCountExpressionsNode,
                    (u64[0 2 ** 63 - 1])parameterIndex,
                    countExpressionNode)
                || (document.KindAt(countExpressionNode) != JsonKind.Null
                    && document.KindAt(countExpressionNode) != JsonKind.Text)
                || (document.KindAt(countExpressionNode) == JsonKind.Text
                    && AsciiLength(document.TextAt(countExpressionNode)) != 0
                    && (!PackageImageSourceBridgeAppendConst(sink, "[")
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(countExpressionNode))
                        || !PackageImageSourceBridgeAppendConst(sink, "]"))))
            {
                return false;
            }
        }

        parameterIndex = parameterIndex + 1;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, ")"))
    {
        return false;
    }

    stack mut bool hasClause = false;
    if (!PackageImageSourceBridgeRenderTypedCallableContractGroups(
            document,
            overlapGroupsNode,
            overlapGroupCount,
            "overlap",
            hasClause,
            sink,
            hasClause)
        || !PackageImageSourceBridgeRenderTypedCallableContractGroups(
            document,
            sameGroupsNode,
            sameGroupCount,
            "same",
            hasClause,
            sink,
            hasClause))
    {
        return false;
    }

    stack mut u32[0 max] deadNameIndex = 0;
    while willexit (deadNameIndex < deadNameCount)
    {
        stack mut u64[0 2 ** 63 - 1] deadNameNode = 0;
        if (!document.TryChildAt(
                deadNamesNode,
                (u64[0 2 ** 63 - 1])deadNameIndex,
                deadNameNode)
            || document.KindAt(deadNameNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii deadName = document.TextAt(deadNameNode);
        stack mut bool duplicate = AsciiLength(deadName) == 0;
        stack mut u32[0 max] earlierDeadIndex = 0;
        while willexit (!duplicate && earlierDeadIndex < deadNameIndex)
        {
            stack mut u64[0 2 ** 63 - 1] earlierDeadNode = 0;
            if (!document.TryChildAt(
                    deadNamesNode,
                    (u64[0 2 ** 63 - 1])earlierDeadIndex,
                    earlierDeadNode)
                || document.KindAt(earlierDeadNode) != JsonKind.Text)
            {
                return false;
            }

            duplicate = document.TextAt(earlierDeadNode) == deadName;
            earlierDeadIndex = earlierDeadIndex + 1;
        }

        if (!duplicate
            && (!PackageImageSourceBridgeAppendConst(
                    sink,
                    hasClause ? ", dead_on_return(" : " where dead_on_return(")
                || !PackageImageSourceBridgeAppend(sink, deadName)
                || !PackageImageSourceBridgeAppendConst(sink, ")")))
        {
            return false;
        }

        if (!duplicate)
        {
            hasClause = true;
        }

        deadNameIndex = deadNameIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ">");
}

internal fn bool PackageImageSourceBridgeRenderTypedTypeReference(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeNode,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (depth == 64)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] kindNode = 0;
    stack mut u64[0 2 ** 63 - 1] nameNode = 0;
    stack mut u64[0 2 ** 63 - 1] sourceAliasNode = 0;
    stack mut u64[0 2 ** 63 - 1] borrowKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] accessKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] initializationKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] rangeMinNode = 0;
    stack mut u64[0 2 ** 63 - 1] rangeMaxNode = 0;
    stack mut u64[0 2 ** 63 - 1] fixedLengthParameterNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] elementTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] associatedOwnerTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] associatedTypeNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] dynTraitStorageKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] typeArgumentsNode = 0;
    stack mut u64[0 2 ** 63 - 1] comptimeArgumentsNode = 0;
    stack mut bool hasName = false;
    stack mut bool hasSourceAlias = false;
    stack mut bool hasBorrowKind = false;
    stack mut bool hasAccessKind = false;
    stack mut bool hasInitializationKind = false;
    stack mut bool hasBitWidth = false;
    stack mut bool hasRangeMin = false;
    stack mut bool hasRangeMax = false;
    stack mut bool hasFixedLength = false;
    stack mut bool hasFixedLengthParameterName = false;
    stack mut bool hasElementType = false;
    stack mut bool hasAssociatedOwnerType = false;
    stack mut bool hasAssociatedTypeName = false;
    stack mut bool hasDynTraitStorageKind = false;
    stack mut bool isMutableView = false;
    stack mut bool isUnsigned = false;
    stack mut bool isMutablePointer = false;
    stack mut u32[0 max] bitWidth = 0;
    stack mut u32[0 max] fixedLength = 0;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    if (!document.TryFindMember(typeNode, "Kind", kindNode)
        || document.KindAt(kindNode) != JsonKind.Text
        || AsciiLength(document.TextAt(kindNode)) == 0
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "Name",
            nameNode,
            hasName)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "SourceAliasName",
            sourceAliasNode,
            hasSourceAlias)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "BorrowKind",
            borrowKindNode,
            hasBorrowKind)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "AccessKind",
            accessKindNode,
            hasAccessKind)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "InitializationKind",
            initializationKindNode,
            hasInitializationKind)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "IsMutableView",
            isMutableView)
        || !LogicalPackageImageJsonOptionalU32MemberValue(
            document,
            typeNode,
            "BitWidth",
            hasBitWidth,
            bitWidth)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "RangeMin",
            rangeMinNode,
            hasRangeMin)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "RangeMax",
            rangeMaxNode,
            hasRangeMax)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "IsUnsigned",
            isUnsigned)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "IsMutablePointer",
            isMutablePointer)
        || !LogicalPackageImageJsonOptionalU32MemberValue(
            document,
            typeNode,
            "FixedLength",
            hasFixedLength,
            fixedLength)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "FixedLengthParameterName",
            fixedLengthParameterNameNode,
            hasFixedLengthParameterName)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            typeNode,
            "ElementType",
            elementTypeNode,
            hasElementType)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            typeNode,
            "AssociatedOwnerType",
            associatedOwnerTypeNode,
            hasAssociatedOwnerType)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "AssociatedTypeName",
            associatedTypeNameNode,
            hasAssociatedTypeName)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "DynTraitStorageKind",
            dynTraitStorageKindNode,
            hasDynTraitStorageKind)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "TypeArguments",
            typeArgumentsNode,
            typeArgumentCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "ComptimeValueArguments",
            comptimeArgumentsNode,
            comptimeArgumentCount)
        || (hasBorrowKind
            && document.TextAt(borrowKindNode) != "borrow"
            && document.TextAt(borrowKindNode) != "retborrow"
            && document.TextAt(borrowKindNode) != "storeborrow")
        || (hasAccessKind
            && document.TextAt(accessKindNode) != "shared"
            && document.TextAt(accessKindNode) != "frozen")
        || (hasInitializationKind
            && document.TextAt(initializationKindNode) != "out"
            && document.TextAt(initializationKindNode) != "init")
        || (isMutableView && !PackageImageSourceBridgeAppendConst(sink, "mut "))
        || (hasBorrowKind
            && (!PackageImageSourceBridgeAppend(sink, document.TextAt(borrowKindNode))
                || !PackageImageSourceBridgeAppendConst(sink, " ")))
        || (hasAccessKind
            && (!PackageImageSourceBridgeAppend(sink, document.TextAt(accessKindNode))
                || !PackageImageSourceBridgeAppendConst(sink, " ")))
        || (hasInitializationKind
            && (!PackageImageSourceBridgeAppend(sink, document.TextAt(initializationKindNode))
                || !PackageImageSourceBridgeAppendConst(sink, " "))))
    {
        return false;
    }

    if (hasSourceAlias)
    {
        return AsciiLength(document.TextAt(sourceAliasNode)) != 0
            && PackageImageSourceBridgeAppend(sink, document.TextAt(sourceAliasNode));
    }

    stack ascii kind = document.TextAt(kindNode);
    stack bool isNamed = kind == "named" || kind == "Named";
    stack bool isDynTrait = kind == "dyntrait" || kind == "DynTrait";
    if (isNamed || isDynTrait)
    {
        if (!hasName || AsciiLength(document.TextAt(nameNode)) == 0)
        {
            return false;
        }

        if (isDynTrait
            && ((hasDynTraitStorageKind
                    && document.TextAt(dynTraitStorageKindNode) == "heap"
                    && !PackageImageSourceBridgeAppendConst(sink, "heap "))
                || !PackageImageSourceBridgeAppendConst(sink, "dyn ")))
        {
            return false;
        }

        return PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
            && PackageImageSourceBridgeRenderTypedGenericArguments(
                document,
                typeArgumentsNode,
                typeArgumentCount,
                comptimeArgumentsNode,
                comptimeArgumentCount,
                depth,
                sink);
    }

    if (typeArgumentCount != 0 || comptimeArgumentCount != 0)
    {
        return false;
    }

    if (kind == "error" || kind == "Error")
    {
        return PackageImageSourceBridgeAppendConst(sink, "<error>");
    }

    if (kind == "void" || kind == "Void")
    {
        return PackageImageSourceBridgeAppendConst(sink, "void");
    }

    if (kind == "bool" || kind == "Bool")
    {
        return PackageImageSourceBridgeAppendConst(sink, "bool");
    }

    if (kind == "ascii" || kind == "Ascii")
    {
        return PackageImageSourceBridgeAppendConst(sink, "ascii");
    }

    if (kind == "unicode" || kind == "Unicode")
    {
        return PackageImageSourceBridgeAppendConst(sink, "unicode");
    }

    if (kind == "cvoid" || kind == "CVoid")
    {
        return PackageImageSourceBridgeAppendConst(sink, "System.C.c_void");
    }

    if (kind == "cvalist" || kind == "CVaList")
    {
        return PackageImageSourceBridgeAppendConst(sink, "System.C.VaList");
    }

    if (kind == "null" || kind == "Null")
    {
        return PackageImageSourceBridgeAppendConst(sink, "null");
    }

    if (kind == "integer" || kind == "Integer")
    {
        stack u32[0 max] renderedBitWidth = hasBitWidth
            ? bitWidth
            : (u32[0 max])32;
        if ((hasRangeMin != hasRangeMax)
            || !PackageImageSourceBridgeAppendConst(sink, isUnsigned ? "u" : "i")
            || !PackageImageSourceBridgeAppendU32(sink, renderedBitWidth)
            || !PackageImageSourceBridgeAppendConst(sink, "["))
        {
            return false;
        }

        if (hasRangeMin)
        {
            if (!PackageImageSourceBridgeAppend(sink, document.TextAt(rangeMinNode))
                || !PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(rangeMaxNode)))
            {
                return false;
            }
        }
        else if (!PackageImageSourceBridgeAppendConst(
                sink,
                isUnsigned ? "0 max" : "min max"))
        {
            return false;
        }

        return PackageImageSourceBridgeAppendConst(sink, "]");
    }

    if (kind == "float" || kind == "Float")
    {
        return hasBitWidth
            && PackageImageSourceBridgeAppendConst(sink, "f")
            && PackageImageSourceBridgeAppendU32(sink, bitWidth);
    }

    if (kind == "rawpointer" || kind == "RawPointer")
    {
        return hasElementType
            && PackageImageSourceBridgeAppendConst(
                sink,
                isMutablePointer ? "rawmutptr<" : "rawptr<")
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                elementTypeNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, ">");
    }

    if (kind == "fixedarray" || kind == "FixedArray")
    {
        if (!hasElementType
            || hasFixedLength == hasFixedLengthParameterName
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                elementTypeNode,
                depth + 1,
                sink)
            || !PackageImageSourceBridgeAppendConst(sink, "["))
        {
            return false;
        }

        if (hasFixedLength
            ? !PackageImageSourceBridgeAppendU32(sink, fixedLength)
            : AsciiLength(document.TextAt(fixedLengthParameterNameNode)) == 0
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(fixedLengthParameterNameNode)))
        {
            return false;
        }

        return PackageImageSourceBridgeAppendConst(sink, "]");
    }

    if (kind == "slice" || kind == "Slice")
    {
        return hasElementType
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                elementTypeNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, "[]");
    }

    if (kind == "dynamic" || kind == "Dynamic")
    {
        return hasElementType
            && PackageImageSourceBridgeAppendConst(sink, "dynamic ")
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                elementTypeNode,
                depth + 1,
                sink);
    }

    if (kind == "associatedtype" || kind == "AssociatedType")
    {
        return hasAssociatedOwnerType
            && hasAssociatedTypeName
            && AsciiLength(document.TextAt(associatedTypeNameNode)) != 0
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                associatedOwnerTypeNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, ".")
            && PackageImageSourceBridgeAppend(
                sink,
                document.TextAt(associatedTypeNameNode));
    }

    if (kind == "functionpointer"
        || kind == "FunctionPointer"
        || kind == "closure"
        || kind == "Closure")
    {
        return PackageImageSourceBridgeRenderTypedCallableTypeReference(
            document,
            typeNode,
            kind,
            depth,
            sink);
    }

    return false;
}
internal fn bool PackageImageSourceBridgeRenderTypedEnumExpression(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    ascii kind,
    u32[0 max] ordinal,
    u64[0 2 ** 63 - 1] argumentsNode,
    u32[0 max] argumentCount,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    stack ascii operationMemberName = kind == "enum-constructor"
        ? "EnumConstructors"
        : kind == "enum-call"
            ? "EnumCalls"
            : kind == "enum-value" ? "EnumValues" : "";
    stack mut u64[0 2 ** 63 - 1] operationNode = 0;
    stack mut u64[0 2 ** 63 - 1] enumTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] variantNameNode = 0;
    if (AsciiLength(operationMemberName) == 0
        || (kind == "enum-value" && argumentCount != 0)
        || !PackageImageSourceBridgeFindTemplateOperationByOrdinal(
            document,
            templateNode,
            operationMemberName,
            ordinal,
            operationNode)
        || !LogicalPackageImageJsonRequiredObjectMember(
            document,
            operationNode,
            "EnumType",
            enumTypeNode)
        || !document.TryFindMember(operationNode, "VariantName", variantNameNode)
        || document.KindAt(variantNameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(variantNameNode)) == 0
        || !PackageImageSourceBridgeRenderTypedTypeReference(
            document,
            enumTypeNode,
            depth + 1,
            sink)
        || !PackageImageSourceBridgeAppendConst(sink, ".")
        || !PackageImageSourceBridgeAppend(sink, document.TextAt(variantNameNode)))
    {
        return false;
    }

    if (kind == "enum-value")
    {
        return true;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, "("))
    {
        return false;
    }

    stack mut u32[0 max] argumentIndex = 0;
    while willexit (argumentIndex < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                argumentsNode,
                (u64[0 2 ** 63 - 1])argumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (argumentIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        argumentIndex = argumentIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ")");
}

internal fn bool PackageImageSourceBridgeRenderTypedCallGenericArguments(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeArgumentsNode,
    u32[0 max] typeArgumentCount,
    u64[0 2 ** 63 - 1] comptimeArgumentsNode,
    u32[0 max] comptimeArgumentCount,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (typeArgumentCount == 0 && comptimeArgumentCount == 0)
    {
        return true;
    }

    if (depth == 64 || !PackageImageSourceBridgeAppendConst(sink, "<"))
    {
        return false;
    }

    stack mut u32[0 max] typeArgumentIndex = 0;
    while willexit (typeArgumentIndex < typeArgumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                typeArgumentsNode,
                (u64[0 2 ** 63 - 1])typeArgumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (typeArgumentIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        typeArgumentIndex = typeArgumentIndex + 1;
    }

    stack mut u32[0 max] comptimeArgumentIndex = 0;
    while willexit (comptimeArgumentIndex < comptimeArgumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] integerValueNode = 0;
        stack mut u64[0 2 ** 63 - 1] symbolicSourceNameNode = 0;
        stack mut bool isSymbolic = false;
        stack mut bool hasSymbolicSourceName = false;
        if (!document.TryChildAt(
                comptimeArgumentsNode,
                (u64[0 2 ** 63 - 1])comptimeArgumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || !document.TryFindMember(argumentNode, "ParameterName", parameterNameNode)
            || document.KindAt(parameterNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(parameterNameNode)) == 0
            || !document.TryFindMember(argumentNode, "IntegerValue", integerValueNode)
            || document.KindAt(integerValueNode) != JsonKind.Text
            || AsciiLength(document.TextAt(integerValueNode)) == 0
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                argumentNode,
                "IsSymbolic",
                isSymbolic)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                argumentNode,
                "SymbolicSourceName",
                symbolicSourceNameNode,
                hasSymbolicSourceName)
            || ((typeArgumentCount != 0 || comptimeArgumentIndex != 0)
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || (isSymbolic && !PackageImageSourceBridgeAppendConst(sink, "comptime "))
            || !PackageImageSourceBridgeAppend(
                sink,
                isSymbolic
                    ? hasSymbolicSourceName
                        ? document.TextAt(symbolicSourceNameNode)
                        : document.TextAt(parameterNameNode)
                    : document.TextAt(integerValueNode)))
        {
            return false;
        }

        comptimeArgumentIndex = comptimeArgumentIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ">");
}

internal fn bool PackageImageSourceBridgeRenderTypedExpressionArguments(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    u64[0 2 ** 63 - 1] argumentsNode,
    u32[0 max] argumentCount,
    u32[0 max] firstArgument,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (firstArgument > argumentCount)
    {
        return false;
    }

    stack mut u32[0 max] argumentIndex = firstArgument;
    while willexit (argumentIndex < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                argumentsNode,
                (u64[0 2 ** 63 - 1])argumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (argumentIndex != firstArgument
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        argumentIndex = argumentIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderTypedExpression(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    u64[0 2 ** 63 - 1] expressionNode,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (depth == 64)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] kindNode = 0;
    if (!document.TryFindMember(expressionNode, "Kind", kindNode)
        || document.KindAt(kindNode) != JsonKind.Text
        || AsciiLength(document.TextAt(kindNode)) == 0)
    {
        return false;
    }

    stack ascii kind = document.TextAt(kindNode);
    if (kind == "name" || kind == "literal")
    {
        stack ascii memberName = kind == "name" ? "Name" : "LiteralText";
        stack mut u64[0 2 ** 63 - 1] valueNode = 0;
        return document.TryFindMember(expressionNode, memberName, valueNode)
            && document.KindAt(valueNode) == JsonKind.Text
            && (kind == "literal" || AsciiLength(document.TextAt(valueNode)) != 0)
            && PackageImageSourceBridgeAppend(sink, document.TextAt(valueNode));
    }

    stack mut u64[0 2 ** 63 - 1] argumentsNode = 0;
    stack mut u32[0 max] argumentCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "Arguments",
            argumentsNode,
            argumentCount))
    {
        return false;
    }

    if (kind == "object-initializer")
    {
        stack mut u64[0 2 ** 63 - 1] memberNamesNode = 0;
        stack mut u32[0 max] memberNameCount = 0;
        if (!LogicalPackageImageJsonOptionalArrayMember(
                document,
                expressionNode,
                "MemberNames",
                memberNamesNode,
                memberNameCount)
            || memberNameCount != argumentCount
            || !PackageImageSourceBridgeAppendConst(sink, "{ "))
        {
            return false;
        }

        stack mut u32[0 max] memberIndex = 0;
        while willexit (memberIndex < memberNameCount)
        {
            stack mut u64[0 2 ** 63 - 1] memberNameNode = 0;
            stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
            if (!document.TryChildAt(
                    memberNamesNode,
                    (u64[0 2 ** 63 - 1])memberIndex,
                    memberNameNode)
                || document.KindAt(memberNameNode) != JsonKind.Text
                || AsciiLength(document.TextAt(memberNameNode)) == 0
                || !document.TryChildAt(
                    argumentsNode,
                    (u64[0 2 ** 63 - 1])memberIndex,
                    argumentNode)
                || document.KindAt(argumentNode) != JsonKind.Object
                || (memberIndex != 0
                    && !PackageImageSourceBridgeAppendConst(sink, ", "))
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(memberNameNode))
                || !PackageImageSourceBridgeAppendConst(sink, " = ")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    argumentNode,
                    depth + 1,
                    sink))
            {
                return false;
            }

            memberIndex = memberIndex + 1;
        }

        return PackageImageSourceBridgeAppendConst(sink, " }");
    }

    if (kind == "array-initializer")
    {
        return PackageImageSourceBridgeAppendConst(
                sink,
                argumentCount == 0 ? "{ }" : "{ ")
            && PackageImageSourceBridgeRenderTypedExpressionArguments(
                document,
                templateNode,
                argumentsNode,
                argumentCount,
                0,
                depth,
                sink)
            && (argumentCount == 0
                || PackageImageSourceBridgeAppendConst(sink, " }"));
    }

    if (kind == "assignment")
    {
        stack mut u64[0 2 ** 63 - 1] targetExpressionNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] assignmentOperatorNode = 0;
        stack mut bool hasTargetExpression = false;
        stack mut bool hasName = false;
        stack mut bool hasAssignmentOperator = false;
        stack mut u64[0 2 ** 63 - 1] valueNode = 0;
        if (argumentCount != 1
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                expressionNode,
                "TargetExpression",
                targetExpressionNode,
                hasTargetExpression)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "AssignmentOperator",
                assignmentOperatorNode,
                hasAssignmentOperator)
            || (!hasTargetExpression && !hasName)
            || !document.TryChildAt(argumentsNode, 0, valueNode)
            || document.KindAt(valueNode) != JsonKind.Object)
        {
            return false;
        }

        stack ascii assignmentOperator = hasAssignmentOperator
            ? document.TextAt(assignmentOperatorNode)
            : "=";
        return (assignmentOperator != "init ="
                || PackageImageSourceBridgeAppendConst(sink, "init "))
            && (hasTargetExpression
                ? PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    targetExpressionNode,
                    depth + 1,
                    sink)
                : AsciiLength(document.TextAt(nameNode)) != 0
                    && PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode)))
            && PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeAppend(
                sink,
                assignmentOperator == "init =" ? "=" : assignmentOperator)
            && PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                valueNode,
                depth + 1,
                sink);
    }

    if (kind == "conversion" || kind == "type-layout")
    {
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut bool hasType = false;
        stack mut bool hasName = false;
        if (!LogicalPackageImageJsonOptionalObjectMember(
                document,
                expressionNode,
                "Type",
                typeNode,
                hasType)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName)
            || !hasType)
        {
            return false;
        }

        if (kind == "type-layout")
        {
            return argumentCount == 0
                && hasName
                && AsciiLength(document.TextAt(nameNode)) != 0
                && PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
                && PackageImageSourceBridgeAppendConst(sink, "(")
                && PackageImageSourceBridgeRenderTypedTypeReference(
                    document,
                    typeNode,
                    depth + 1,
                    sink)
                && PackageImageSourceBridgeAppendConst(sink, ")");
        }

        stack mut u64[0 2 ** 63 - 1] valueNode = 0;
        return argumentCount == 1
            && document.TryChildAt(argumentsNode, 0, valueNode)
            && document.KindAt(valueNode) == JsonKind.Object
            && PackageImageSourceBridgeAppendConst(sink, "(")
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                typeNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, ")")
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                valueNode,
                depth + 1,
                sink);
    }

    if (kind == "try" || kind == "unary" || kind == "comptime")
    {
        stack mut u64[0 2 ** 63 - 1] valueNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut bool hasName = false;
        if (argumentCount != 1
            || !document.TryChildAt(argumentsNode, 0, valueNode)
            || document.KindAt(valueNode) != JsonKind.Object
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName))
        {
            return false;
        }

        if (kind == "unary"
            && (!hasName || AsciiLength(document.TextAt(nameNode)) == 0))
        {
            return false;
        }

        return (kind == "try"
                ? PackageImageSourceBridgeAppendConst(sink, "try ")
                : kind == "comptime"
                    ? PackageImageSourceBridgeAppendConst(sink, "comptime (")
                    : PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode)))
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                valueNode,
                depth + 1,
                sink)
            && (kind != "comptime"
                || PackageImageSourceBridgeAppendConst(sink, ")"));
    }

    if (kind == "binary" || kind == "conditional")
    {
        stack mut u64[0 2 ** 63 - 1] firstNode = 0;
        stack mut u64[0 2 ** 63 - 1] secondNode = 0;
        stack mut u64[0 2 ** 63 - 1] thirdNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut bool hasName = false;
        if ((kind == "binary" && argumentCount != 2)
            || (kind == "conditional" && argumentCount != 3)
            || !document.TryChildAt(argumentsNode, 0, firstNode)
            || !document.TryChildAt(argumentsNode, 1, secondNode)
            || document.KindAt(firstNode) != JsonKind.Object
            || document.KindAt(secondNode) != JsonKind.Object
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName)
            || (kind == "binary"
                && (!hasName || AsciiLength(document.TextAt(nameNode)) == 0))
            || (kind == "conditional"
                && (!document.TryChildAt(argumentsNode, 2, thirdNode)
                    || document.KindAt(thirdNode) != JsonKind.Object)))
        {
            return false;
        }

        return PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                firstNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeAppend(
                sink,
                kind == "binary" ? document.TextAt(nameNode) : "?")
            && PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                secondNode,
                depth + 1,
                sink)
            && (kind == "binary"
                || (PackageImageSourceBridgeAppendConst(sink, " : ")
                    && PackageImageSourceBridgeRenderTypedExpression(
                        document,
                        templateNode,
                        thirdNode,
                        depth + 1,
                        sink)));
    }

    if (kind == "comparison-chain")
    {
        stack mut u64[0 2 ** 63 - 1] operatorsNode = 0;
        stack mut u32[0 max] operatorCount = 0;
        if (argumentCount < 2
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                expressionNode,
                "OperatorNames",
                operatorsNode,
                operatorCount)
            || operatorCount != argumentCount - 1)
        {
            return false;
        }

        stack mut u32[0 max] comparisonIndex = 0;
        while willexit (comparisonIndex < argumentCount)
        {
            stack mut u64[0 2 ** 63 - 1] valueNode = 0;
            if (!document.TryChildAt(
                    argumentsNode,
                    (u64[0 2 ** 63 - 1])comparisonIndex,
                    valueNode)
                || document.KindAt(valueNode) != JsonKind.Object
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    valueNode,
                    depth + 1,
                    sink))
            {
                return false;
            }

            if (comparisonIndex < operatorCount)
            {
                stack mut u64[0 2 ** 63 - 1] operatorNode = 0;
                if (!document.TryChildAt(
                        operatorsNode,
                        (u64[0 2 ** 63 - 1])comparisonIndex,
                        operatorNode)
                    || document.KindAt(operatorNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(operatorNode)) == 0
                    || !PackageImageSourceBridgeAppendConst(sink, " ")
                    || !PackageImageSourceBridgeAppend(
                        sink,
                        document.TextAt(operatorNode))
                    || !PackageImageSourceBridgeAppendConst(sink, " "))
                {
                    return false;
                }
            }

            comparisonIndex = comparisonIndex + 1;
        }

        return true;
    }

    if (kind == "closure-call"
        || kind == "index-access"
        || kind == "dyntrait-from-parts")
    {
        stack mut u64[0 2 ** 63 - 1] firstNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut bool hasName = false;
        if (argumentCount == 0
            || !document.TryChildAt(argumentsNode, 0, firstNode)
            || document.KindAt(firstNode) != JsonKind.Object
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName)
            || (kind == "dyntrait-from-parts"
                && (argumentCount != 2
                    || !hasName
                    || AsciiLength(document.TextAt(nameNode)) == 0)))
        {
            return false;
        }

        if (kind == "dyntrait-from-parts")
        {
            return PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
                && PackageImageSourceBridgeAppendConst(sink, "(")
                && PackageImageSourceBridgeRenderTypedExpressionArguments(
                    document,
                    templateNode,
                    argumentsNode,
                    argumentCount,
                    0,
                    depth,
                    sink)
                && PackageImageSourceBridgeAppendConst(sink, ")");
        }

        return PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                firstNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(
                sink,
                kind == "closure-call" ? "(" : "[")
            && PackageImageSourceBridgeRenderTypedExpressionArguments(
                document,
                templateNode,
                argumentsNode,
                argumentCount,
                1,
                depth,
                sink)
            && PackageImageSourceBridgeAppendConst(
                sink,
                kind == "closure-call" ? ")" : "]");
    }

    stack mut u32[0 max] ordinal = 0;
    if (!LogicalPackageImageJsonRequiredU32MemberValue(
            document,
            expressionNode,
            "Ordinal",
            ordinal))
    {
        return false;
    }

    if (kind == "object-creation")
    {
        stack mut u64[0 2 ** 63 - 1] creationsNode = 0;
        stack mut u64[0 2 ** 63 - 1] creationNode = 0;
        stack mut u64[0 2 ** 63 - 1] createdTypeNode = 0;
        stack mut u64[0 2 ** 63 - 1] constructorNode = 0;
        stack mut u64[0 2 ** 63 - 1] initializerMembersNode = 0;
        stack mut u64[0 2 ** 63 - 1] expressionTextNode = 0;
        stack mut bool hasConstructor = false;
        stack mut bool hasStorageSelector = false;
        stack mut bool hasExpressionText = false;
        stack mut u32[0 max] creationCount = 0;
        stack mut u32[0 max] storageSelector = 0;
        stack mut u32[0 max] initializerMemberCount = 0;
        if (!LogicalPackageImageJsonOptionalArrayMember(
                document,
                templateNode,
                "ObjectCreations",
                creationsNode,
                creationCount)
            || ordinal >= creationCount
            || !document.TryChildAt(
                creationsNode,
                (u64[0 2 ** 63 - 1])ordinal,
                creationNode)
            || document.KindAt(creationNode) != JsonKind.Object
            || !LogicalPackageImageJsonRequiredObjectMember(
                document,
                creationNode,
                "CreatedType",
                createdTypeNode)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                creationNode,
                "Constructor",
                constructorNode,
                hasConstructor)
            || !LogicalPackageImageJsonOptionalU32MemberValue(
                document,
                creationNode,
                "StorageSelector",
                hasStorageSelector,
                storageSelector)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                creationNode,
                "InitializerMembers",
                initializerMembersNode,
                initializerMemberCount)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                creationNode,
                "ExpressionText",
                expressionTextNode,
                hasExpressionText)
            || (hasStorageSelector && storageSelector > 1))
        {
            return false;
        }

        if (argumentCount == 0 && hasExpressionText)
        {
            return PackageImageSourceBridgeAppend(sink, document.TextAt(expressionTextNode));
        }

        if (hasStorageSelector && storageSelector == 1)
        {
            if (!PackageImageSourceBridgeAppendConst(sink, "new(arena"))
            {
                return false;
            }

            stack mut u32[0 max] arenaArgumentIndex = 0;
            while willexit (arenaArgumentIndex < argumentCount)
            {
                stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
                if (!document.TryChildAt(
                        argumentsNode,
                        (u64[0 2 ** 63 - 1])arenaArgumentIndex,
                        argumentNode)
                    || document.KindAt(argumentNode) != JsonKind.Object
                    || !PackageImageSourceBridgeAppendConst(sink, ", ")
                    || !PackageImageSourceBridgeRenderTypedExpression(
                        document,
                        templateNode,
                        argumentNode,
                        depth + 1,
                        sink))
                {
                    return false;
                }

                arenaArgumentIndex = arenaArgumentIndex + 1;
            }

            return PackageImageSourceBridgeAppendConst(sink, ")");
        }

        if (!PackageImageSourceBridgeAppendConst(sink, "new ")
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                createdTypeNode,
                depth + 1,
                sink)
            || !PackageImageSourceBridgeAppendConst(sink, "("))
        {
            return false;
        }

        if (!hasConstructor && initializerMemberCount != 0)
        {
            if (initializerMemberCount != argumentCount
                || !PackageImageSourceBridgeAppendConst(sink, ") { "))
            {
                return false;
            }

            stack mut u32[0 max] initializerIndex = 0;
            while willexit (initializerIndex < initializerMemberCount)
            {
                stack mut u64[0 2 ** 63 - 1] initializerNode = 0;
                stack mut u64[0 2 ** 63 - 1] fieldNameNode = 0;
                stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
                if (!document.TryChildAt(
                        initializerMembersNode,
                        (u64[0 2 ** 63 - 1])initializerIndex,
                        initializerNode)
                    || document.KindAt(initializerNode) != JsonKind.Object
                    || !document.TryFindMember(initializerNode, "FieldName", fieldNameNode)
                    || document.KindAt(fieldNameNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(fieldNameNode)) == 0
                    || !document.TryChildAt(
                        argumentsNode,
                        (u64[0 2 ** 63 - 1])initializerIndex,
                        argumentNode)
                    || document.KindAt(argumentNode) != JsonKind.Object
                    || (initializerIndex != 0
                        && !PackageImageSourceBridgeAppendConst(sink, ", "))
                    || !PackageImageSourceBridgeAppend(sink, document.TextAt(fieldNameNode))
                    || !PackageImageSourceBridgeAppendConst(sink, " = ")
                    || !PackageImageSourceBridgeRenderTypedExpression(
                        document,
                        templateNode,
                        argumentNode,
                        depth + 1,
                        sink))
                {
                    return false;
                }

                initializerIndex = initializerIndex + 1;
            }

            return PackageImageSourceBridgeAppendConst(sink, " }");
        }

        stack mut u32[0 max] objectArgumentIndex = 0;
        while willexit (objectArgumentIndex < argumentCount)
        {
            stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
            if (!document.TryChildAt(
                    argumentsNode,
                    (u64[0 2 ** 63 - 1])objectArgumentIndex,
                    argumentNode)
                || document.KindAt(argumentNode) != JsonKind.Object
                || (objectArgumentIndex != 0
                    && !PackageImageSourceBridgeAppendConst(sink, ", "))
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    argumentNode,
                    depth + 1,
                    sink))
            {
                return false;
            }

            objectArgumentIndex = objectArgumentIndex + 1;
        }

        return PackageImageSourceBridgeAppendConst(sink, ")");
    }

    if (kind == "enum-constructor"
        || kind == "enum-call"
        || kind == "enum-value")
    {
        return PackageImageSourceBridgeRenderTypedEnumExpression(
            document,
            templateNode,
            kind,
            ordinal,
            argumentsNode,
            argumentCount,
            depth,
            sink);
    }

    if (kind == "field-access")
    {
        stack mut u64[0 2 ** 63 - 1] fieldNode = 0;
        stack mut u64[0 2 ** 63 - 1] fieldNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] receiverNode = 0;
        return argumentCount == 1
            && PackageImageSourceBridgeFindTemplateOperationByOrdinal(
                document,
                templateNode,
                "FieldAccesses",
                ordinal,
                fieldNode)
            && document.TryFindMember(fieldNode, "FieldName", fieldNameNode)
            && document.KindAt(fieldNameNode) == JsonKind.Text
            && AsciiLength(document.TextAt(fieldNameNode)) != 0
            && document.TryChildAt(argumentsNode, 0, receiverNode)
            && document.KindAt(receiverNode) == JsonKind.Object
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                receiverNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, ".")
            && PackageImageSourceBridgeAppend(sink, document.TextAt(fieldNameNode));
    }

    stack ascii operationMemberName = kind == "direct-call"
        ? "DirectCalls"
        : kind == "member-call" ? "MemberCalls" : "";
    stack mut u64[0 2 ** 63 - 1] callNode = 0;
    stack mut u64[0 2 ** 63 - 1] resolvedNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] sourceNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] templateNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] typeArgumentsNode = 0;
    stack mut u64[0 2 ** 63 - 1] comptimeArgumentsNode = 0;
    stack mut bool hasSourceName = false;
    stack mut bool hasTemplateName = false;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    if (AsciiLength(operationMemberName) == 0
        || !PackageImageSourceBridgeFindTemplateOperationByOrdinal(
            document,
            templateNode,
            operationMemberName,
            ordinal,
            callNode)
        || !document.TryFindMember(callNode, "QualifiedResolvedName", resolvedNameNode)
        || document.KindAt(resolvedNameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(resolvedNameNode)) == 0
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            callNode,
            "QualifiedSourceName",
            sourceNameNode,
            hasSourceName)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            callNode,
            "QualifiedTemplateName",
            templateNameNode,
            hasTemplateName)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            callNode,
            "TypeArguments",
            typeArgumentsNode,
            typeArgumentCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            callNode,
            "ComptimeValueArguments",
            comptimeArgumentsNode,
            comptimeArgumentCount))
    {
        return false;
    }

    stack mut u32[0 max] firstCallArgument = 0;
    if (kind == "member-call")
    {
        stack mut u64[0 2 ** 63 - 1] receiverNode = 0;
        if (argumentCount == 0
            || !document.TryChildAt(argumentsNode, 0, receiverNode)
            || document.KindAt(receiverNode) != JsonKind.Object
            || !PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                receiverNode,
                depth + 1,
                sink)
            || !PackageImageSourceBridgeAppendConst(sink, "."))
        {
            return false;
        }

        stack ascii sourceName = hasSourceName
            ? document.TextAt(sourceNameNode)
            : document.TextAt(resolvedNameNode);
        stack i64[min max] signedNameLength = AsciiLength(sourceName);
        if (signedNameLength <= 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameLength = (u64[0 2 ** 63 - 1])signedNameLength;
        stack mut u64[0 2 ** 63 - 1] memberStart = 0;
        stack mut u64[0 2 ** 63 - 1] nameIndex = 0;
        while willexit (nameIndex < nameLength)
        {
            if (sourceName[nameIndex, 1] == ".")
            {
                memberStart = nameIndex + 1;
            }

            nameIndex = nameIndex + 1;
        }

        if (memberStart == nameLength
            || !PackageImageSourceBridgeAppend(
                sink,
                sourceName[memberStart, nameLength - memberStart])
            || !PackageImageSourceBridgeRenderTypedCallGenericArguments(
                document,
                typeArgumentsNode,
                typeArgumentCount,
                comptimeArgumentsNode,
                comptimeArgumentCount,
                depth + 1,
                sink))
        {
            return false;
        }

        firstCallArgument = 1;
    }
    else if (!PackageImageSourceBridgeAppend(
            sink,
            hasSourceName
                ? document.TextAt(sourceNameNode)
                : hasTemplateName
                    ? document.TextAt(templateNameNode)
                    : document.TextAt(resolvedNameNode))
        || (comptimeArgumentCount != 0
            && !PackageImageSourceBridgeRenderTypedCallGenericArguments(
                document,
                typeArgumentsNode,
                typeArgumentCount,
                comptimeArgumentsNode,
                comptimeArgumentCount,
                depth + 1,
                sink)))
    {
        return false;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, "("))
    {
        return false;
    }

    stack mut u32[0 max] argumentIndex = firstCallArgument;
    while willexit (argumentIndex < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                argumentsNode,
                (u64[0 2 ** 63 - 1])argumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (argumentIndex != firstCallArgument
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        argumentIndex = argumentIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ")");
}
