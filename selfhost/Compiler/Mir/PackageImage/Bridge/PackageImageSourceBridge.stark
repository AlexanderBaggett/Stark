import Compiler.Parsing
import Compiler.Mir.PackageImage.Loader.ManifestJsonReader
import Compiler.Mir.PackageImage.Loader.SourceSurfaceSectionLoader
import System.Json
import System.Memory
import System.Text
module Compiler.Mir.PackageImage.Bridge.PackageImageSourceBridge

// Compatibility document owned by Stage1 after source-surface reconstruction.
// The source bytes stay alive beside the token/span tables. Structured package
// facts remain authoritative for typing, specialization, ABI, and LLVM; this
// document exists for parser/binder paths that still require source syntax.
public struct LogicalPackageLoadedSourceDocument
{
    internal u32[0 max] ModuleOrdinalValue;
    internal OwnedAscii SourceTextValue;
    internal CompilationUnitSyntax SyntaxValue;

    LogicalPackageLoadedSourceDocument()
    {
        self.ModuleOrdinalValue = 0;
        self.SourceTextValue = new();
        self.SyntaxValue = new();
    }

    public inline finite law u32[0 max] ModuleOrdinal(
        borrow LogicalPackageLoadedSourceDocument self)
    {
        return self.ModuleOrdinalValue;
    }

    public finite law bool SourceTextEquals(
        borrow LogicalPackageLoadedSourceDocument self,
        ascii expected)
    {
        return System.Text.OwnedAsciiEqualsAscii(self.SourceTextValue, expected);
    }

    public finite law retborrow CompilationUnitSyntax Syntax(
        borrow LogicalPackageLoadedSourceDocument self)
    {
        return self.SyntaxValue;
    }
}

internal fn bool PackageImageSourceBridgeAppend(
    mut borrow OwnedAscii sink,
    ascii text)
    where overlap(sink, text)
{
    switch (sink.AppendAscii(text))
    {
        case MemoryStatus.Err(var appendError):
            return false;
        case MemoryStatus.Ok:
            return true;
    }
}

internal fn bool PackageImageSourceBridgeAppendConst(
    mut borrow OwnedAscii sink,
    const ascii text)
{
    switch (sink.AppendConstAscii(text))
    {
        case MemoryStatus.Err(var appendError):
            return false;
        case MemoryStatus.Ok:
            return true;
    }
}

internal fn bool PackageImageSourceBridgeAppendRequiredTextMember(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] memberNode = 0;
    return document.TryFindMember(objectNode, memberName, memberNode)
        && document.KindAt(memberNode) == JsonKind.Text
        && AsciiLength(document.TextAt(memberNode)) != 0
        && PackageImageSourceBridgeAppend(sink, document.TextAt(memberNode));
}

internal fn bool PackageImageSourceBridgeOptionalTextMemberNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out u64[0 2 ** 63 - 1] memberNode,
    out bool present)
{
    memberNode = 0;
    present = false;
    stack mut u64[0 2 ** 63 - 1] found = 0;
    if (!document.TryFindMember(objectNode, memberName, found)
        || document.KindAt(found) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(found) != JsonKind.Text
        || AsciiLength(document.TextAt(found)) == 0)
    {
        return false;
    }

    memberNode = found;
    present = true;
    return true;
}

internal struct PackageImageSourceBridgeTemplateContext
{
    u64[0 2 ** 63 - 1] TemplateFunctionsNode;
    u32[0 max] TemplateFunctionCount;
    u64[0 2 ** 63 - 1] TypedInterfaceNode;
    bool HasTypedInterface;

    PackageImageSourceBridgeTemplateContext()
    {
        self.TemplateFunctionsNode = 0;
        self.TemplateFunctionCount = 0;
        self.TypedInterfaceNode = 0;
        self.HasTypedInterface = false;
    }
}

internal struct PackageImageSourceBridgeTemplateBodyMatch
{
    u64[0 2 ** 63 - 1] TemplateNode;
    u64[0 2 ** 63 - 1] TypedBodyNode;
    u64[0 2 ** 63 - 1] LegacyBodyTextNode;
    bool HasTypedBody;
    bool HasLegacyBodyText;

    PackageImageSourceBridgeTemplateBodyMatch()
    {
        self.TemplateNode = 0;
        self.TypedBodyNode = 0;
        self.LegacyBodyTextNode = 0;
        self.HasTypedBody = false;
        self.HasLegacyBodyText = false;
    }
}

internal fn bool PackageImageSourceBridgeEffectiveOptionalCompilerSectionNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    ascii sectionName,
    out u64[0 2 ** 63 - 1] sectionNode,
    out bool present)
{
    sectionNode = 0;
    present = false;
    stack mut u64[0 2 ** 63 - 1] directNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionNode = 0;
    stack mut bool hasDirect = false;
    stack mut bool hasCompilerSections = false;
    stack mut bool hasCompilerSection = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            moduleNode,
            sectionName,
            directNode,
            hasDirect)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            moduleNode,
            "CompilerSections",
            compilerSectionsNode,
            hasCompilerSections))
    {
        return false;
    }

    if (hasCompilerSections
        && !LogicalPackageImageJsonOptionalObjectMember(
            document,
            compilerSectionsNode,
            sectionName,
            compilerSectionNode,
            hasCompilerSection))
    {
        return false;
    }

    if (hasCompilerSection)
    {
        sectionNode = compilerSectionNode;
        present = true;
    }
    else if (hasDirect)
    {
        sectionNode = directNode;
        present = true;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeBuildTemplateContext(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    out PackageImageSourceBridgeTemplateContext context)
{
    context = new();
    stack mut u64[0 2 ** 63 - 1] genericTemplatesNode = 0;
    stack mut bool hasGenericTemplates = false;
    if (!PackageImageSourceBridgeEffectiveOptionalCompilerSectionNode(
            document,
            moduleNode,
            "GenericTemplates",
            genericTemplatesNode,
            hasGenericTemplates)
        || !PackageImageSourceBridgeEffectiveOptionalCompilerSectionNode(
            document,
            moduleNode,
            "TypedInterface",
            context.TypedInterfaceNode,
            context.HasTypedInterface))
    {
        return false;
    }

    if (!hasGenericTemplates)
    {
        return true;
    }

    return LogicalPackageImageJsonRequiredArrayMember(
        document,
        genericTemplatesNode,
        "Functions",
        context.TemplateFunctionsNode,
        context.TemplateFunctionCount);
}

internal inline finite law bool PackageImageSourceBridgeAsciiIsWhitespace(ascii unit)
{
    return unit == " " || unit == "\t" || unit == "\r" || unit == "\n";
}

internal inline finite law bool PackageImageSourceBridgeAsciiIsTypeQualifier(ascii word)
{
    return word == "mut"
        || word == "borrow"
        || word == "retborrow"
        || word == "storeborrow"
        || word == "shared"
        || word == "frozen"
        || word == "out"
        || word == "init";
}

internal fn bool PackageImageSourceBridgeAppendCanonicalOverloadType(
    ascii typeText,
    mut borrow OwnedAscii sink)
    where overlap(typeText, sink)
{
    stack i64[min max] signedLength = AsciiLength(typeText);
    if (signedLength <= 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])signedLength;
    stack mut u64[0 2 ** 63 - 1] cursor = 0;
    stack mut bool hasMut = false;
    stack mut bool hasBorrow = false;
    stack mut bool hasRetBorrow = false;
    stack mut bool hasStoreBorrow = false;
    stack mut bool hasShared = false;
    stack mut bool hasFrozen = false;
    stack mut bool hasOut = false;
    stack mut bool hasInit = false;
    while willexit (cursor < length)
    {
        while willexit (cursor < length
            && PackageImageSourceBridgeAsciiIsWhitespace(typeText[cursor, 1]))
        {
            cursor = cursor + 1;
        }

        stack u64[0 2 ** 63 - 1] wordStart = cursor;
        while willexit (cursor < length
            && !PackageImageSourceBridgeAsciiIsWhitespace(typeText[cursor, 1]))
        {
            cursor = cursor + 1;
        }

        if (wordStart == cursor)
        {
            break;
        }

        stack ascii word = typeText[wordStart, cursor - wordStart];
        if (!PackageImageSourceBridgeAsciiIsTypeQualifier(word))
        {
            cursor = wordStart;
            break;
        }

        if (word == "mut") { hasMut = true; }
        else if (word == "borrow") { hasBorrow = true; }
        else if (word == "retborrow") { hasRetBorrow = true; }
        else if (word == "storeborrow") { hasStoreBorrow = true; }
        else if (word == "shared") { hasShared = true; }
        else if (word == "frozen") { hasFrozen = true; }
        else if (word == "out") { hasOut = true; }
        else if (word == "init") { hasInit = true; }
    }

    if ((hasMut && !PackageImageSourceBridgeAppendConst(sink, "mut"))
        || (hasBorrow && !PackageImageSourceBridgeAppendConst(sink, "borrow"))
        || (hasRetBorrow && !PackageImageSourceBridgeAppendConst(sink, "retborrow"))
        || (hasStoreBorrow && !PackageImageSourceBridgeAppendConst(sink, "storeborrow"))
        || (hasShared && !PackageImageSourceBridgeAppendConst(sink, "shared"))
        || (hasFrozen && !PackageImageSourceBridgeAppendConst(sink, "frozen"))
        || (hasOut && !PackageImageSourceBridgeAppendConst(sink, "out"))
        || (hasInit && !PackageImageSourceBridgeAppendConst(sink, "init")))
    {
        return false;
    }

    while willexit (cursor < length)
    {
        stack ascii unit = typeText[cursor, 1];
        if (!PackageImageSourceBridgeAsciiIsWhitespace(unit)
            && !PackageImageSourceBridgeAppend(sink, unit))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeBuildCallableOverloadKey(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callableNode,
    mut borrow OwnedAscii scratch)
{
    scratch.Clear();
    stack mut u64[0 2 ** 63 - 1] parametersNode = 0;
    stack mut u32[0 max] parameterCount = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(
            document,
            callableNode,
            "Parameters",
            parametersNode,
            parameterCount)
        || !PackageImageSourceBridgeAppendConst(scratch, "("))
    {
        return false;
    }

    stack mut u32[0 max] parameterIndex = 0;
    while willexit (parameterIndex < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        if (!document.TryChildAt(
                parametersNode,
                (u64[0 2 ** 63 - 1])parameterIndex,
                parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || !document.TryFindMember(parameterNode, "Type", typeNode)
            || document.KindAt(typeNode) != JsonKind.Text
            || AsciiLength(document.TextAt(typeNode)) == 0
            || (parameterIndex != 0
                && !PackageImageSourceBridgeAppendConst(scratch, ","))
            || !PackageImageSourceBridgeAppendCanonicalOverloadType(
                document.TextAt(typeNode),
                scratch))
        {
            return false;
        }

        parameterIndex = parameterIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(scratch, ")");
}

internal fn bool PackageImageSourceBridgeFindPublishedOverloadKeyInCallableArray(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callablesNode,
    u32[0 max] callableCount,
    ascii symbolName,
    out u64[0 2 ** 63 - 1] overloadKeyNode,
    out bool present)
    where overlap(document, symbolName)
{
    overloadKeyNode = 0;
    present = false;
    stack mut u32[0 max] callableIndex = 0;
    while willexit (callableIndex < callableCount)
    {
        stack mut u64[0 2 ** 63 - 1] callableNode = 0;
        stack mut u64[0 2 ** 63 - 1] symbolNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] candidateKeyNode = 0;
        stack mut bool hasCandidateKey = false;
        if (!document.TryChildAt(
                callablesNode,
                (u64[0 2 ** 63 - 1])callableIndex,
                callableNode)
            || document.KindAt(callableNode) != JsonKind.Object
            || !document.TryFindMember(callableNode, "SymbolName", symbolNameNode)
            || document.KindAt(symbolNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(symbolNameNode)) == 0
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                callableNode,
                "PublishedOverloadKey",
                candidateKeyNode,
                hasCandidateKey))
        {
            return false;
        }

        if (document.TextAt(symbolNameNode) == symbolName && hasCandidateKey)
        {
            if (present)
            {
                return false;
            }

            overloadKeyNode = candidateKeyNode;
            present = true;
        }

        callableIndex = callableIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeResolvePublishedOverloadKey(
    borrow JsonDocument document,
    borrow PackageImageSourceBridgeTemplateContext context,
    u64[0 2 ** 63 - 1] callableNode,
    out u64[0 2 ** 63 - 1] overloadKeyNode,
    out bool present)
{
    overloadKeyNode = 0;
    present = false;
    if (!context.HasTypedInterface)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] symbolNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] functionsNode = 0;
    stack mut u64[0 2 ** 63 - 1] typesNode = 0;
    stack mut u32[0 max] functionCount = 0;
    stack mut u32[0 max] typeCount = 0;
    if (!document.TryFindMember(callableNode, "SymbolName", symbolNameNode)
        || document.KindAt(symbolNameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(symbolNameNode)) == 0
        || !LogicalPackageImageJsonRequiredArrayMember(
            document,
            context.TypedInterfaceNode,
            "Functions",
            functionsNode,
            functionCount)
        || !LogicalPackageImageJsonRequiredArrayMember(
            document,
            context.TypedInterfaceNode,
            "Types",
            typesNode,
            typeCount))
    {
        return false;
    }

    stack ascii symbolName = document.TextAt(symbolNameNode);
    if (!PackageImageSourceBridgeFindPublishedOverloadKeyInCallableArray(
            document,
            functionsNode,
            functionCount,
            symbolName,
            overloadKeyNode,
            present))
    {
        return false;
    }

    stack mut u32[0 max] typeIndex = 0;
    while willexit (typeIndex < typeCount)
    {
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u64[0 2 ** 63 - 1] methodsNode = 0;
        stack mut u32[0 max] methodCount = 0;
        stack mut u64[0 2 ** 63 - 1] methodKeyNode = 0;
        stack mut bool hasMethodKey = false;
        if (!document.TryChildAt(
                typesNode,
                (u64[0 2 ** 63 - 1])typeIndex,
                typeNode)
            || document.KindAt(typeNode) != JsonKind.Object
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                typeNode,
                "Methods",
                methodsNode,
                methodCount)
            || !PackageImageSourceBridgeFindPublishedOverloadKeyInCallableArray(
                document,
                methodsNode,
                methodCount,
                symbolName,
                methodKeyNode,
                hasMethodKey))
        {
            return false;
        }

        if (hasMethodKey)
        {
            if (present)
            {
                return false;
            }

            overloadKeyNode = methodKeyNode;
            present = true;
        }

        typeIndex = typeIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeFindTemplateBody(
    borrow JsonDocument document,
    borrow PackageImageSourceBridgeTemplateContext context,
    u64[0 2 ** 63 - 1] callableNode,
    mut borrow OwnedAscii overloadKeyScratch,
    out PackageImageSourceBridgeTemplateBodyMatch result)
{
    result = new();
    if (context.TemplateFunctionCount == 0)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] qualifiedNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] publishedOverloadKeyNode = 0;
    stack mut bool hasPublishedOverloadKey = false;
    if (!document.TryFindMember(callableNode, "QualifiedName", qualifiedNameNode)
        || document.KindAt(qualifiedNameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(qualifiedNameNode)) == 0
        || !PackageImageSourceBridgeResolvePublishedOverloadKey(
            document,
            context,
            callableNode,
            publishedOverloadKeyNode,
            hasPublishedOverloadKey)
        || (!hasPublishedOverloadKey
            && !PackageImageSourceBridgeBuildCallableOverloadKey(
                document,
                callableNode,
                overloadKeyScratch)))
    {
        return false;
    }

    stack ascii qualifiedName = document.TextAt(qualifiedNameNode);
    stack mut bool matched = false;
    stack mut u32[0 max] templateIndex = 0;
    while willexit (templateIndex < context.TemplateFunctionCount)
    {
        stack mut u64[0 2 ** 63 - 1] templateNode = 0;
        stack mut u64[0 2 ** 63 - 1] templateQualifiedNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] templateOverloadKeyNode = 0;
        stack mut u64[0 2 ** 63 - 1] typedBodyNode = 0;
        stack mut u64[0 2 ** 63 - 1] candidateBodyTextNode = 0;
        stack mut bool hasTypedBody = false;
        stack mut bool hasCandidateBodyText = false;
        if (!document.TryChildAt(
                context.TemplateFunctionsNode,
                (u64[0 2 ** 63 - 1])templateIndex,
                templateNode)
            || document.KindAt(templateNode) != JsonKind.Object
            || !document.TryFindMember(
                templateNode,
                "QualifiedName",
                templateQualifiedNameNode)
            || document.KindAt(templateQualifiedNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(templateQualifiedNameNode)) == 0
            || !document.TryFindMember(
                templateNode,
                "OverloadKey",
                templateOverloadKeyNode)
            || document.KindAt(templateOverloadKeyNode) != JsonKind.Text
            || AsciiLength(document.TextAt(templateOverloadKeyNode)) == 0
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                templateNode,
                "TypedBody",
                typedBodyNode,
                hasTypedBody)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                templateNode,
                "BodyText",
                candidateBodyTextNode,
                hasCandidateBodyText))
        {
            return false;
        }

        stack bool overloadMatches = hasPublishedOverloadKey
            ? document.TextAt(templateOverloadKeyNode)
                == document.TextAt(publishedOverloadKeyNode)
            : document.TextAt(templateOverloadKeyNode) == overloadKeyScratch.View();
        if (document.TextAt(templateQualifiedNameNode) == qualifiedName
            && overloadMatches)
        {
            if (matched)
            {
                return false;
            }

            matched = true;
            result.TemplateNode = templateNode;
            result.TypedBodyNode = typedBodyNode;
            result.HasTypedBody = hasTypedBody;
            if (!hasTypedBody && hasCandidateBodyText)
            {
                result.LegacyBodyTextNode = candidateBodyTextNode;
                result.HasLegacyBodyText = true;
            }
        }

        templateIndex = templateIndex + 1;
    }

    return true;
}

internal inline finite law bool PackageImageSourceBridgeExpressionKindRequiresBody(ascii kind)
{
    return kind == "object-initializer"
        || kind == "object-creation"
        || kind == "enum-constructor"
        || kind == "enum-call"
        || kind == "enum-value"
        || kind == "direct-call"
        || kind == "field-access"
        || kind == "member-call";
}

internal fn bool PackageImageSourceBridgeTypedExpressionRequiresBody(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] expressionNode,
    u8[0 64] depth,
    out bool requiresBody)
{
    requiresBody = false;
    if (depth == 64)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] kindNode = 0;
    stack mut u64[0 2 ** 63 - 1] targetNode = 0;
    stack mut u64[0 2 ** 63 - 1] argumentsNode = 0;
    stack mut bool hasTarget = false;
    stack mut u32[0 max] argumentCount = 0;
    if (!document.TryFindMember(expressionNode, "Kind", kindNode)
        || document.KindAt(kindNode) != JsonKind.Text
        || AsciiLength(document.TextAt(kindNode)) == 0
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            expressionNode,
            "TargetExpression",
            targetNode,
            hasTarget)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "Arguments",
            argumentsNode,
            argumentCount))
    {
        return false;
    }

    if (PackageImageSourceBridgeExpressionKindRequiresBody(document.TextAt(kindNode)))
    {
        requiresBody = true;
        return true;
    }

    stack mut bool childRequiresBody = false;
    if (hasTarget
        && (!PackageImageSourceBridgeTypedExpressionRequiresBody(
                document,
                targetNode,
                depth + 1,
                childRequiresBody)
            || childRequiresBody))
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    stack mut u32[0 max] argumentIndex = 0;
    while willexit (argumentIndex < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                argumentsNode,
                (u64[0 2 ** 63 - 1])argumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || !PackageImageSourceBridgeTypedExpressionRequiresBody(
                document,
                argumentNode,
                depth + 1,
                childRequiresBody))
        {
            return false;
        }

        if (childRequiresBody)
        {
            requiresBody = true;
            return true;
        }

        argumentIndex = argumentIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeTypedPatternRequiresBody(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] patternNode,
    u8[0 64] depth,
    out bool requiresBody)
{
    requiresBody = false;
    if (depth == 64)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] expressionNode = 0;
    stack mut u64[0 2 ** 63 - 1] endExpressionNode = 0;
    stack mut u64[0 2 ** 63 - 1] membersNode = 0;
    stack mut bool hasExpression = false;
    stack mut bool hasEndExpression = false;
    stack mut u32[0 max] memberCount = 0;
    if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            patternNode,
            "Expression",
            expressionNode,
            hasExpression)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            patternNode,
            "EndExpression",
            endExpressionNode,
            hasEndExpression)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            patternNode,
            "Members",
            membersNode,
            memberCount))
    {
        return false;
    }

    stack mut bool childRequiresBody = false;
    if (hasExpression)
    {
        if (!PackageImageSourceBridgeTypedExpressionRequiresBody(
                document,
                expressionNode,
                depth + 1,
                childRequiresBody))
        {
            return false;
        }

        if (childRequiresBody)
        {
            requiresBody = true;
            return true;
        }
    }

    if (hasEndExpression)
    {
        if (!PackageImageSourceBridgeTypedExpressionRequiresBody(
                document,
                endExpressionNode,
                depth + 1,
                childRequiresBody))
        {
            return false;
        }

        if (childRequiresBody)
        {
            requiresBody = true;
            return true;
        }
    }

    stack mut u32[0 max] memberIndex = 0;
    while willexit (memberIndex < memberCount)
    {
        stack mut u64[0 2 ** 63 - 1] memberNode = 0;
        if (!document.TryChildAt(
                membersNode,
                (u64[0 2 ** 63 - 1])memberIndex,
                memberNode)
            || document.KindAt(memberNode) != JsonKind.Object
            || !PackageImageSourceBridgeTypedPatternRequiresBody(
                document,
                memberNode,
                depth + 1,
                childRequiresBody))
        {
            return false;
        }

        if (childRequiresBody)
        {
            requiresBody = true;
            return true;
        }

        memberIndex = memberIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeTypedOptionalExpressionRequiresBody(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownerNode,
    ascii memberName,
    u8[0 64] depth,
    out bool requiresBody)
{
    requiresBody = false;
    stack mut u64[0 2 ** 63 - 1] expressionNode = 0;
    stack mut bool hasExpression = false;
    return LogicalPackageImageJsonOptionalObjectMember(
            document,
            ownerNode,
            memberName,
            expressionNode,
            hasExpression)
        && (!hasExpression
            || PackageImageSourceBridgeTypedExpressionRequiresBody(
                document,
                expressionNode,
                depth,
                requiresBody));
}

internal fn bool PackageImageSourceBridgeTypedOptionalStatementArrayRequiresBody(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownerNode,
    ascii memberName,
    u8[0 64] depth,
    out bool requiresBody)
{
    requiresBody = false;
    stack mut u64[0 2 ** 63 - 1] statementsNode = 0;
    stack mut u32[0 max] statementCount = 0;
    return LogicalPackageImageJsonOptionalArrayMember(
            document,
            ownerNode,
            memberName,
            statementsNode,
            statementCount)
        && PackageImageSourceBridgeTypedStatementArrayRequiresBody(
            document,
            statementsNode,
            statementCount,
            depth,
            requiresBody);
}

internal fn bool PackageImageSourceBridgeTypedOptionalPatternArrayRequiresBody(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownerNode,
    ascii memberName,
    u8[0 64] depth,
    out bool requiresBody)
{
    requiresBody = false;
    stack mut u64[0 2 ** 63 - 1] patternsNode = 0;
    stack mut u32[0 max] patternCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            ownerNode,
            memberName,
            patternsNode,
            patternCount))
    {
        return false;
    }

    stack mut u32[0 max] patternIndex = 0;
    while willexit (patternIndex < patternCount)
    {
        stack mut u64[0 2 ** 63 - 1] patternNode = 0;
        stack mut bool patternRequiresBody = false;
        if (!document.TryChildAt(
                patternsNode,
                (u64[0 2 ** 63 - 1])patternIndex,
                patternNode)
            || document.KindAt(patternNode) != JsonKind.Object
            || !PackageImageSourceBridgeTypedPatternRequiresBody(
                document,
                patternNode,
                depth,
                patternRequiresBody))
        {
            return false;
        }

        if (patternRequiresBody)
        {
            requiresBody = true;
            return true;
        }

        patternIndex = patternIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeTypedStatementRequiresBody(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] statementNode,
    u8[0 64] depth,
    out bool requiresBody)
{
    requiresBody = false;
    if (depth == 64)
    {
        return false;
    }

    stack mut bool childRequiresBody = false;
    if (!PackageImageSourceBridgeTypedOptionalExpressionRequiresBody(
            document,
            statementNode,
            "Expression",
            depth + 1,
            childRequiresBody)
        || childRequiresBody)
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    if (!PackageImageSourceBridgeTypedOptionalExpressionRequiresBody(
            document,
            statementNode,
            "TargetExpression",
            depth + 1,
            childRequiresBody)
        || childRequiresBody)
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    if (!PackageImageSourceBridgeTypedOptionalExpressionRequiresBody(
            document,
            statementNode,
            "TraversalSource",
            depth + 1,
            childRequiresBody)
        || childRequiresBody)
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    stack mut u64[0 2 ** 63 - 1] conditionPatternNode = 0;
    stack mut bool hasConditionPattern = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            statementNode,
            "ConditionPattern",
            conditionPatternNode,
            hasConditionPattern)
        || (hasConditionPattern
            && (!PackageImageSourceBridgeTypedPatternRequiresBody(
                    document,
                    conditionPatternNode,
                    depth + 1,
                    childRequiresBody)
                || childRequiresBody)))
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    if (!PackageImageSourceBridgeTypedOptionalStatementArrayRequiresBody(
            document,
            statementNode,
            "BodyStatements",
            depth + 1,
            childRequiresBody)
        || childRequiresBody)
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    if (!PackageImageSourceBridgeTypedOptionalStatementArrayRequiresBody(
            document,
            statementNode,
            "InitializerStatements",
            depth + 1,
            childRequiresBody)
        || childRequiresBody)
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    if (!PackageImageSourceBridgeTypedOptionalStatementArrayRequiresBody(
            document,
            statementNode,
            "IteratorStatements",
            depth + 1,
            childRequiresBody)
        || childRequiresBody)
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    if (!PackageImageSourceBridgeTypedOptionalStatementArrayRequiresBody(
            document,
            statementNode,
            "ThenStatements",
            depth + 1,
            childRequiresBody)
        || childRequiresBody)
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    if (!PackageImageSourceBridgeTypedOptionalStatementArrayRequiresBody(
            document,
            statementNode,
            "ElseStatements",
            depth + 1,
            childRequiresBody)
        || childRequiresBody)
    {
        requiresBody = childRequiresBody;
        return childRequiresBody;
    }

    stack mut u64[0 2 ** 63 - 1] switchCasesNode = 0;
    stack mut u32[0 max] switchCaseCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            statementNode,
            "SwitchCases",
            switchCasesNode,
            switchCaseCount))
    {
        return false;
    }

    stack mut u32[0 max] switchCaseIndex = 0;
    while willexit (switchCaseIndex < switchCaseCount)
    {
        stack mut u64[0 2 ** 63 - 1] switchCaseNode = 0;
        stack mut u64[0 2 ** 63 - 1] switchStatementsNode = 0;
        stack mut u32[0 max] switchStatementCount = 0;
        if (!document.TryChildAt(
                switchCasesNode,
                (u64[0 2 ** 63 - 1])switchCaseIndex,
                switchCaseNode)
            || document.KindAt(switchCaseNode) != JsonKind.Object
            || !PackageImageSourceBridgeTypedOptionalExpressionRequiresBody(
                document,
                switchCaseNode,
                "Expression",
                depth + 1,
                childRequiresBody))
        {
            return false;
        }

        if (childRequiresBody)
        {
            requiresBody = true;
            return true;
        }

        if (!PackageImageSourceBridgeTypedOptionalExpressionRequiresBody(
                document,
                switchCaseNode,
                "GuardExpression",
                depth + 1,
                childRequiresBody)
            || childRequiresBody)
        {
            requiresBody = childRequiresBody;
            return childRequiresBody;
        }

        if (!PackageImageSourceBridgeTypedOptionalExpressionRequiresBody(
                document,
                switchCaseNode,
                "EndExpression",
                depth + 1,
                childRequiresBody)
            || childRequiresBody)
        {
            requiresBody = childRequiresBody;
            return childRequiresBody;
        }

        if (!PackageImageSourceBridgeTypedOptionalPatternArrayRequiresBody(
                document,
                switchCaseNode,
                "Members",
                depth + 1,
                childRequiresBody)
            || childRequiresBody)
        {
            requiresBody = childRequiresBody;
            return childRequiresBody;
        }

        if (!LogicalPackageImageJsonOptionalArrayMember(
                document,
                switchCaseNode,
                "Statements",
                switchStatementsNode,
                switchStatementCount)
            || !PackageImageSourceBridgeTypedStatementArrayRequiresBody(
                document,
                switchStatementsNode,
                switchStatementCount,
                depth + 1,
                childRequiresBody))
        {
            return false;
        }

        if (childRequiresBody)
        {
            requiresBody = true;
            return true;
        }

        switchCaseIndex = switchCaseIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeTypedStatementArrayRequiresBody(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] statementsNode,
    u32[0 max] statementCount,
    u8[0 64] depth,
    out bool requiresBody)
{
    requiresBody = false;
    stack mut u32[0 max] statementIndex = 0;
    while willexit (statementIndex < statementCount)
    {
        stack mut u64[0 2 ** 63 - 1] statementNode = 0;
        stack mut bool statementRequiresBody = false;
        if (!document.TryChildAt(
                statementsNode,
                (u64[0 2 ** 63 - 1])statementIndex,
                statementNode)
            || document.KindAt(statementNode) != JsonKind.Object
            || !PackageImageSourceBridgeTypedStatementRequiresBody(
                document,
                statementNode,
                depth,
                statementRequiresBody))
        {
            return false;
        }

        if (statementRequiresBody)
        {
            requiresBody = true;
            return true;
        }

        statementIndex = statementIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeFindTemplateOperationByOrdinal(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    ascii memberName,
    u32[0 max] ordinal,
    out u64[0 2 ** 63 - 1] operationNode)
{
    operationNode = 0;
    stack mut u64[0 2 ** 63 - 1] operationsNode = 0;
    stack mut u32[0 max] operationCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            templateNode,
            memberName,
            operationsNode,
            operationCount))
    {
        return false;
    }

    stack mut bool matched = false;
    stack mut u32[0 max] operationIndex = 0;
    while willexit (operationIndex < operationCount)
    {
        stack mut u64[0 2 ** 63 - 1] candidateNode = 0;
        stack mut u32[0 max] candidateOrdinal = 0;
        if (!document.TryChildAt(
                operationsNode,
                (u64[0 2 ** 63 - 1])operationIndex,
                candidateNode)
            || document.KindAt(candidateNode) != JsonKind.Object
            || !LogicalPackageImageJsonRequiredU32MemberValue(
                document,
                candidateNode,
                "Ordinal",
                candidateOrdinal))
        {
            return false;
        }

        if (candidateOrdinal == ordinal)
        {
            if (matched)
            {
                return false;
            }

            matched = true;
            operationNode = candidateNode;
        }

        operationIndex = operationIndex + 1;
    }

    return matched;
}

internal fn bool PackageImageSourceBridgeRenderTypedGenericArguments(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeArgumentsNode,
    u32[0 max] typeArgumentCount,
    u64[0 2 ** 63 - 1] comptimeArgumentsNode,
    u32[0 max] comptimeArgumentCount,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    stack u32[0 max] genericArgumentCount = typeArgumentCount + comptimeArgumentCount;
    if (genericArgumentCount == 0)
    {
        return true;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, "<"))
    {
        return false;
    }

    stack mut u32[0 max] typeArgumentIndex = 0;
    while willexit (typeArgumentIndex < typeArgumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                typeArgumentsNode,
                (u64[0 2 ** 63 - 1])typeArgumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (typeArgumentIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        typeArgumentIndex = typeArgumentIndex + 1;
    }

    stack mut u32[0 max] comptimeArgumentIndex = 0;
    while willexit (comptimeArgumentIndex < comptimeArgumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] integerValueNode = 0;
        stack mut u64[0 2 ** 63 - 1] symbolicSourceNameNode = 0;
        stack mut bool isSymbolic = false;
        stack mut bool hasSymbolicSourceName = false;
        if (!document.TryChildAt(
                comptimeArgumentsNode,
                (u64[0 2 ** 63 - 1])comptimeArgumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || !document.TryFindMember(argumentNode, "ParameterName", parameterNameNode)
            || document.KindAt(parameterNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(parameterNameNode)) == 0
            || !document.TryFindMember(argumentNode, "IntegerValue", integerValueNode)
            || document.KindAt(integerValueNode) != JsonKind.Text
            || AsciiLength(document.TextAt(integerValueNode)) == 0
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                argumentNode,
                "IsSymbolic",
                isSymbolic)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                argumentNode,
                "SymbolicSourceName",
                symbolicSourceNameNode,
                hasSymbolicSourceName)
            || ((typeArgumentCount != 0 || comptimeArgumentIndex != 0)
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || (isSymbolic && !PackageImageSourceBridgeAppendConst(sink, "comptime "))
            || !PackageImageSourceBridgeAppend(
                sink,
                isSymbolic
                    ? hasSymbolicSourceName
                        ? document.TextAt(symbolicSourceNameNode)
                        : document.TextAt(parameterNameNode)
                    : document.TextAt(integerValueNode)))
        {
            return false;
        }

        comptimeArgumentIndex = comptimeArgumentIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ">");
}

internal fn bool PackageImageSourceBridgeRenderTypedCallableContractGroups(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] groupsNode,
    u32[0 max] groupCount,
    ascii relationName,
    bool hadClause,
    mut borrow OwnedAscii sink,
    out bool hasClause)
{
    hasClause = hadClause;
    stack mut u32[0 max] groupIndex = 0;
    while willexit (groupIndex < groupCount)
    {
        stack mut u64[0 2 ** 63 - 1] groupNode = 0;
        stack mut u64[0 2 ** 63 - 1] namesNode = 0;
        stack mut u32[0 max] nameCount = 0;
        if (!document.TryChildAt(
                groupsNode,
                (u64[0 2 ** 63 - 1])groupIndex,
                groupNode)
            || document.KindAt(groupNode) != JsonKind.Object
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                groupNode,
                "ParameterNames",
                namesNode,
                nameCount))
        {
            return false;
        }

        stack mut u32[0 max] uniqueNameCount = 0;
        stack mut u32[0 max] nameIndex = 0;
        while willexit (nameIndex < nameCount)
        {
            stack mut u64[0 2 ** 63 - 1] nameNode = 0;
            if (!document.TryChildAt(
                    namesNode,
                    (u64[0 2 ** 63 - 1])nameIndex,
                    nameNode)
                || document.KindAt(nameNode) != JsonKind.Text)
            {
                return false;
            }

            stack ascii name = document.TextAt(nameNode);
            stack mut bool duplicate = AsciiLength(name) == 0;
            stack mut u32[0 max] earlierIndex = 0;
            while willexit (!duplicate && earlierIndex < nameIndex)
            {
                stack mut u64[0 2 ** 63 - 1] earlierNode = 0;
                if (!document.TryChildAt(
                        namesNode,
                        (u64[0 2 ** 63 - 1])earlierIndex,
                        earlierNode)
                    || document.KindAt(earlierNode) != JsonKind.Text)
                {
                    return false;
                }

                duplicate = document.TextAt(earlierNode) == name;
                earlierIndex = earlierIndex + 1;
            }

            if (!duplicate)
            {
                uniqueNameCount = uniqueNameCount + 1;
            }

            nameIndex = nameIndex + 1;
        }

        if (uniqueNameCount >= 2)
        {
            if (!PackageImageSourceBridgeAppendConst(
                    sink,
                    hasClause ? ", " : " where ")
                || !PackageImageSourceBridgeAppend(sink, relationName)
                || !PackageImageSourceBridgeAppendConst(sink, "("))
            {
                return false;
            }

            stack mut u32[0 max] renderedNameCount = 0;
            nameIndex = 0;
            while willexit (nameIndex < nameCount)
            {
                stack mut u64[0 2 ** 63 - 1] nameNode = 0;
                if (!document.TryChildAt(
                        namesNode,
                        (u64[0 2 ** 63 - 1])nameIndex,
                        nameNode)
                    || document.KindAt(nameNode) != JsonKind.Text)
                {
                    return false;
                }

                stack ascii name = document.TextAt(nameNode);
                stack mut bool duplicate = AsciiLength(name) == 0;
                stack mut u32[0 max] earlierIndex = 0;
                while willexit (!duplicate && earlierIndex < nameIndex)
                {
                    stack mut u64[0 2 ** 63 - 1] earlierNode = 0;
                    if (!document.TryChildAt(
                            namesNode,
                            (u64[0 2 ** 63 - 1])earlierIndex,
                            earlierNode)
                        || document.KindAt(earlierNode) != JsonKind.Text)
                    {
                        return false;
                    }

                    duplicate = document.TextAt(earlierNode) == name;
                    earlierIndex = earlierIndex + 1;
                }

                if (!duplicate
                    && ((renderedNameCount != 0
                            && !PackageImageSourceBridgeAppendConst(sink, ", "))
                        || !PackageImageSourceBridgeAppend(sink, name)))
                {
                    return false;
                }

                if (!duplicate)
                {
                    renderedNameCount = renderedNameCount + 1;
                }

                nameIndex = nameIndex + 1;
            }

            if (!PackageImageSourceBridgeAppendConst(sink, ")"))
            {
                return false;
            }

            hasClause = true;
        }

        groupIndex = groupIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderTypedCallableTypeReference(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeNode,
    ascii kind,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] returnTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] parameterTypesNode = 0;
    stack mut u64[0 2 ** 63 - 1] parameterCountExpressionsNode = 0;
    stack mut u64[0 2 ** 63 - 1] functionKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] functionAbiNode = 0;
    stack mut u64[0 2 ** 63 - 1] closureStorageKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] closureCallCapabilityNode = 0;
    stack mut u64[0 2 ** 63 - 1] overlapGroupsNode = 0;
    stack mut u64[0 2 ** 63 - 1] sameGroupsNode = 0;
    stack mut u64[0 2 ** 63 - 1] deadNamesNode = 0;
    stack mut bool hasFunctionKind = false;
    stack mut bool hasFunctionAbi = false;
    stack mut bool hasClosureStorageKind = false;
    stack mut bool hasClosureCallCapability = false;
    stack mut bool functionIsUnsafe = false;
    stack mut bool functionIsTailCallable = false;
    stack mut u32[0 max] parameterTypeCount = 0;
    stack mut u32[0 max] parameterCountExpressionCount = 0;
    stack mut u32[0 max] overlapGroupCount = 0;
    stack mut u32[0 max] sameGroupCount = 0;
    stack mut u32[0 max] deadNameCount = 0;
    if (!LogicalPackageImageJsonRequiredObjectMember(
            document,
            typeNode,
            "ReturnType",
            returnTypeNode)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "ParameterTypes",
            parameterTypesNode,
            parameterTypeCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "ParameterRawPointerElementCountExpressions",
            parameterCountExpressionsNode,
            parameterCountExpressionCount)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "FunctionKind",
            functionKindNode,
            hasFunctionKind)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "FunctionAbi",
            functionAbiNode,
            hasFunctionAbi)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "FunctionIsUnsafe",
            functionIsUnsafe)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "FunctionIsTailCallable",
            functionIsTailCallable)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "ClosureStorageKind",
            closureStorageKindNode,
            hasClosureStorageKind)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "ClosureCallCapability",
            closureCallCapabilityNode,
            hasClosureCallCapability)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "OverlapParameterGroups",
            overlapGroupsNode,
            overlapGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "SameParameterGroups",
            sameGroupsNode,
            sameGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "PointeeDeadOnReturnParameterNames",
            deadNamesNode,
            deadNameCount))
    {
        return false;
    }

    stack bool isClosure = kind == "closure" || kind == "Closure";
    if (isClosure)
    {
        if ((hasClosureStorageKind
                && document.TextAt(closureStorageKindNode) == "inline"
                && !PackageImageSourceBridgeAppendConst(sink, "inline "))
            || (hasClosureStorageKind
                && document.TextAt(closureStorageKindNode) == "heap"
                && !PackageImageSourceBridgeAppendConst(sink, "heap "))
            || !PackageImageSourceBridgeAppendConst(sink, "closure<")
            || (hasClosureCallCapability
                && document.TextAt(closureCallCapabilityNode) == "mut"
                && !PackageImageSourceBridgeAppendConst(sink, "mut "))
            || (hasClosureCallCapability
                && document.TextAt(closureCallCapabilityNode) == "once"
                && !PackageImageSourceBridgeAppendConst(sink, "once ")))
        {
            return false;
        }
    }
    else if (!PackageImageSourceBridgeAppendConst(sink, "fnptr<")
        || (functionIsUnsafe
            && !PackageImageSourceBridgeAppendConst(sink, "unsafe "))
        || (hasFunctionAbi
            && AsciiLength(document.TextAt(functionAbiNode)) != 0
            && (!PackageImageSourceBridgeAppendConst(sink, "ffi(")
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(functionAbiNode))
                || !PackageImageSourceBridgeAppendConst(sink, ") "))))
    {
        return false;
    }

    stack ascii functionKind = hasFunctionKind
        ? document.TextAt(functionKindNode)
        : "fn";
    stack ascii renderedFunctionKind = functionKind == "finite"
        ? "finite"
        : functionKind == "law"
            ? "law"
            : functionKind == "finite law" || functionKind == "finitelaw"
                ? "finite law"
                : "fn";
    if ((functionIsTailCallable
            && !PackageImageSourceBridgeAppendConst(sink, "tail "))
        || !PackageImageSourceBridgeAppend(sink, renderedFunctionKind)
        || !PackageImageSourceBridgeAppendConst(sink, " ")
        || !PackageImageSourceBridgeRenderTypedTypeReference(
            document,
            returnTypeNode,
            depth + 1,
            sink)
        || !PackageImageSourceBridgeAppendConst(sink, "("))
    {
        return false;
    }

    stack mut u32[0 max] parameterIndex = 0;
    while willexit (parameterIndex < parameterTypeCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterTypeNode = 0;
        if (!document.TryChildAt(
                parameterTypesNode,
                (u64[0 2 ** 63 - 1])parameterIndex,
                parameterTypeNode)
            || document.KindAt(parameterTypeNode) != JsonKind.Object
            || (parameterIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                parameterTypeNode,
                depth + 1,
                sink))
        {
            return false;
        }

        if (parameterIndex < parameterCountExpressionCount)
        {
            stack mut u64[0 2 ** 63 - 1] countExpressionNode = 0;
            if (!document.TryChildAt(
                    parameterCountExpressionsNode,
                    (u64[0 2 ** 63 - 1])parameterIndex,
                    countExpressionNode)
                || (document.KindAt(countExpressionNode) != JsonKind.Null
                    && document.KindAt(countExpressionNode) != JsonKind.Text)
                || (document.KindAt(countExpressionNode) == JsonKind.Text
                    && AsciiLength(document.TextAt(countExpressionNode)) != 0
                    && (!PackageImageSourceBridgeAppendConst(sink, "[")
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(countExpressionNode))
                        || !PackageImageSourceBridgeAppendConst(sink, "]"))))
            {
                return false;
            }
        }

        parameterIndex = parameterIndex + 1;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, ")"))
    {
        return false;
    }

    stack mut bool hasClause = false;
    if (!PackageImageSourceBridgeRenderTypedCallableContractGroups(
            document,
            overlapGroupsNode,
            overlapGroupCount,
            "overlap",
            hasClause,
            sink,
            hasClause)
        || !PackageImageSourceBridgeRenderTypedCallableContractGroups(
            document,
            sameGroupsNode,
            sameGroupCount,
            "same",
            hasClause,
            sink,
            hasClause))
    {
        return false;
    }

    stack mut u32[0 max] deadNameIndex = 0;
    while willexit (deadNameIndex < deadNameCount)
    {
        stack mut u64[0 2 ** 63 - 1] deadNameNode = 0;
        if (!document.TryChildAt(
                deadNamesNode,
                (u64[0 2 ** 63 - 1])deadNameIndex,
                deadNameNode)
            || document.KindAt(deadNameNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii deadName = document.TextAt(deadNameNode);
        stack mut bool duplicate = AsciiLength(deadName) == 0;
        stack mut u32[0 max] earlierDeadIndex = 0;
        while willexit (!duplicate && earlierDeadIndex < deadNameIndex)
        {
            stack mut u64[0 2 ** 63 - 1] earlierDeadNode = 0;
            if (!document.TryChildAt(
                    deadNamesNode,
                    (u64[0 2 ** 63 - 1])earlierDeadIndex,
                    earlierDeadNode)
                || document.KindAt(earlierDeadNode) != JsonKind.Text)
            {
                return false;
            }

            duplicate = document.TextAt(earlierDeadNode) == deadName;
            earlierDeadIndex = earlierDeadIndex + 1;
        }

        if (!duplicate
            && (!PackageImageSourceBridgeAppendConst(
                    sink,
                    hasClause ? ", dead_on_return(" : " where dead_on_return(")
                || !PackageImageSourceBridgeAppend(sink, deadName)
                || !PackageImageSourceBridgeAppendConst(sink, ")")))
        {
            return false;
        }

        if (!duplicate)
        {
            hasClause = true;
        }

        deadNameIndex = deadNameIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ">");
}

internal fn bool PackageImageSourceBridgeRenderTypedTypeReference(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeNode,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (depth == 64)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] kindNode = 0;
    stack mut u64[0 2 ** 63 - 1] nameNode = 0;
    stack mut u64[0 2 ** 63 - 1] sourceAliasNode = 0;
    stack mut u64[0 2 ** 63 - 1] borrowKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] accessKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] initializationKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] rangeMinNode = 0;
    stack mut u64[0 2 ** 63 - 1] rangeMaxNode = 0;
    stack mut u64[0 2 ** 63 - 1] fixedLengthParameterNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] elementTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] associatedOwnerTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] associatedTypeNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] dynTraitStorageKindNode = 0;
    stack mut u64[0 2 ** 63 - 1] typeArgumentsNode = 0;
    stack mut u64[0 2 ** 63 - 1] comptimeArgumentsNode = 0;
    stack mut bool hasName = false;
    stack mut bool hasSourceAlias = false;
    stack mut bool hasBorrowKind = false;
    stack mut bool hasAccessKind = false;
    stack mut bool hasInitializationKind = false;
    stack mut bool hasBitWidth = false;
    stack mut bool hasRangeMin = false;
    stack mut bool hasRangeMax = false;
    stack mut bool hasFixedLength = false;
    stack mut bool hasFixedLengthParameterName = false;
    stack mut bool hasElementType = false;
    stack mut bool hasAssociatedOwnerType = false;
    stack mut bool hasAssociatedTypeName = false;
    stack mut bool hasDynTraitStorageKind = false;
    stack mut bool isMutableView = false;
    stack mut bool isUnsigned = false;
    stack mut bool isMutablePointer = false;
    stack mut u32[0 max] bitWidth = 0;
    stack mut u32[0 max] fixedLength = 0;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    if (!document.TryFindMember(typeNode, "Kind", kindNode)
        || document.KindAt(kindNode) != JsonKind.Text
        || AsciiLength(document.TextAt(kindNode)) == 0
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "Name",
            nameNode,
            hasName)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "SourceAliasName",
            sourceAliasNode,
            hasSourceAlias)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "BorrowKind",
            borrowKindNode,
            hasBorrowKind)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "AccessKind",
            accessKindNode,
            hasAccessKind)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "InitializationKind",
            initializationKindNode,
            hasInitializationKind)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "IsMutableView",
            isMutableView)
        || !LogicalPackageImageJsonOptionalU32MemberValue(
            document,
            typeNode,
            "BitWidth",
            hasBitWidth,
            bitWidth)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "RangeMin",
            rangeMinNode,
            hasRangeMin)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "RangeMax",
            rangeMaxNode,
            hasRangeMax)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "IsUnsigned",
            isUnsigned)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            typeNode,
            "IsMutablePointer",
            isMutablePointer)
        || !LogicalPackageImageJsonOptionalU32MemberValue(
            document,
            typeNode,
            "FixedLength",
            hasFixedLength,
            fixedLength)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "FixedLengthParameterName",
            fixedLengthParameterNameNode,
            hasFixedLengthParameterName)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            typeNode,
            "ElementType",
            elementTypeNode,
            hasElementType)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            typeNode,
            "AssociatedOwnerType",
            associatedOwnerTypeNode,
            hasAssociatedOwnerType)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "AssociatedTypeName",
            associatedTypeNameNode,
            hasAssociatedTypeName)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            typeNode,
            "DynTraitStorageKind",
            dynTraitStorageKindNode,
            hasDynTraitStorageKind)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "TypeArguments",
            typeArgumentsNode,
            typeArgumentCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            typeNode,
            "ComptimeValueArguments",
            comptimeArgumentsNode,
            comptimeArgumentCount)
        || (hasBorrowKind
            && document.TextAt(borrowKindNode) != "borrow"
            && document.TextAt(borrowKindNode) != "retborrow"
            && document.TextAt(borrowKindNode) != "storeborrow")
        || (hasAccessKind
            && document.TextAt(accessKindNode) != "shared"
            && document.TextAt(accessKindNode) != "frozen")
        || (hasInitializationKind
            && document.TextAt(initializationKindNode) != "out"
            && document.TextAt(initializationKindNode) != "init")
        || (isMutableView && !PackageImageSourceBridgeAppendConst(sink, "mut "))
        || (hasBorrowKind
            && (!PackageImageSourceBridgeAppend(sink, document.TextAt(borrowKindNode))
                || !PackageImageSourceBridgeAppendConst(sink, " ")))
        || (hasAccessKind
            && (!PackageImageSourceBridgeAppend(sink, document.TextAt(accessKindNode))
                || !PackageImageSourceBridgeAppendConst(sink, " ")))
        || (hasInitializationKind
            && (!PackageImageSourceBridgeAppend(sink, document.TextAt(initializationKindNode))
                || !PackageImageSourceBridgeAppendConst(sink, " "))))
    {
        return false;
    }

    if (hasSourceAlias)
    {
        return AsciiLength(document.TextAt(sourceAliasNode)) != 0
            && PackageImageSourceBridgeAppend(sink, document.TextAt(sourceAliasNode));
    }

    stack ascii kind = document.TextAt(kindNode);
    stack bool isNamed = kind == "named" || kind == "Named";
    stack bool isDynTrait = kind == "dyntrait" || kind == "DynTrait";
    if (isNamed || isDynTrait)
    {
        if (!hasName || AsciiLength(document.TextAt(nameNode)) == 0)
        {
            return false;
        }

        if (isDynTrait
            && ((hasDynTraitStorageKind
                    && document.TextAt(dynTraitStorageKindNode) == "heap"
                    && !PackageImageSourceBridgeAppendConst(sink, "heap "))
                || !PackageImageSourceBridgeAppendConst(sink, "dyn ")))
        {
            return false;
        }

        return PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
            && PackageImageSourceBridgeRenderTypedGenericArguments(
                document,
                typeArgumentsNode,
                typeArgumentCount,
                comptimeArgumentsNode,
                comptimeArgumentCount,
                depth,
                sink);
    }

    if (typeArgumentCount != 0 || comptimeArgumentCount != 0)
    {
        return false;
    }

    if (kind == "error" || kind == "Error")
    {
        return PackageImageSourceBridgeAppendConst(sink, "<error>");
    }

    if (kind == "void" || kind == "Void")
    {
        return PackageImageSourceBridgeAppendConst(sink, "void");
    }

    if (kind == "bool" || kind == "Bool")
    {
        return PackageImageSourceBridgeAppendConst(sink, "bool");
    }

    if (kind == "ascii" || kind == "Ascii")
    {
        return PackageImageSourceBridgeAppendConst(sink, "ascii");
    }

    if (kind == "unicode" || kind == "Unicode")
    {
        return PackageImageSourceBridgeAppendConst(sink, "unicode");
    }

    if (kind == "cvoid" || kind == "CVoid")
    {
        return PackageImageSourceBridgeAppendConst(sink, "System.C.c_void");
    }

    if (kind == "cvalist" || kind == "CVaList")
    {
        return PackageImageSourceBridgeAppendConst(sink, "System.C.VaList");
    }

    if (kind == "null" || kind == "Null")
    {
        return PackageImageSourceBridgeAppendConst(sink, "null");
    }

    if (kind == "integer" || kind == "Integer")
    {
        stack u32[0 max] renderedBitWidth = hasBitWidth
            ? bitWidth
            : (u32[0 max])32;
        if ((hasRangeMin != hasRangeMax)
            || !PackageImageSourceBridgeAppendConst(sink, isUnsigned ? "u" : "i")
            || !PackageImageSourceBridgeAppendU32(sink, renderedBitWidth)
            || !PackageImageSourceBridgeAppendConst(sink, "["))
        {
            return false;
        }

        if (hasRangeMin)
        {
            if (!PackageImageSourceBridgeAppend(sink, document.TextAt(rangeMinNode))
                || !PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(rangeMaxNode)))
            {
                return false;
            }
        }
        else if (!PackageImageSourceBridgeAppendConst(
                sink,
                isUnsigned ? "0 max" : "min max"))
        {
            return false;
        }

        return PackageImageSourceBridgeAppendConst(sink, "]");
    }

    if (kind == "float" || kind == "Float")
    {
        return hasBitWidth
            && PackageImageSourceBridgeAppendConst(sink, "f")
            && PackageImageSourceBridgeAppendU32(sink, bitWidth);
    }

    if (kind == "rawpointer" || kind == "RawPointer")
    {
        return hasElementType
            && PackageImageSourceBridgeAppendConst(
                sink,
                isMutablePointer ? "rawmutptr<" : "rawptr<")
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                elementTypeNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, ">");
    }

    if (kind == "fixedarray" || kind == "FixedArray")
    {
        if (!hasElementType
            || hasFixedLength == hasFixedLengthParameterName
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                elementTypeNode,
                depth + 1,
                sink)
            || !PackageImageSourceBridgeAppendConst(sink, "["))
        {
            return false;
        }

        if (hasFixedLength
            ? !PackageImageSourceBridgeAppendU32(sink, fixedLength)
            : AsciiLength(document.TextAt(fixedLengthParameterNameNode)) == 0
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(fixedLengthParameterNameNode)))
        {
            return false;
        }

        return PackageImageSourceBridgeAppendConst(sink, "]");
    }

    if (kind == "slice" || kind == "Slice")
    {
        return hasElementType
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                elementTypeNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, "[]");
    }

    if (kind == "dynamic" || kind == "Dynamic")
    {
        return hasElementType
            && PackageImageSourceBridgeAppendConst(sink, "dynamic ")
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                elementTypeNode,
                depth + 1,
                sink);
    }

    if (kind == "associatedtype" || kind == "AssociatedType")
    {
        return hasAssociatedOwnerType
            && hasAssociatedTypeName
            && AsciiLength(document.TextAt(associatedTypeNameNode)) != 0
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                associatedOwnerTypeNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, ".")
            && PackageImageSourceBridgeAppend(
                sink,
                document.TextAt(associatedTypeNameNode));
    }

    if (kind == "functionpointer"
        || kind == "FunctionPointer"
        || kind == "closure"
        || kind == "Closure")
    {
        return PackageImageSourceBridgeRenderTypedCallableTypeReference(
            document,
            typeNode,
            kind,
            depth,
            sink);
    }

    return false;
}
internal fn bool PackageImageSourceBridgeRenderTypedEnumExpression(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    ascii kind,
    u32[0 max] ordinal,
    u64[0 2 ** 63 - 1] argumentsNode,
    u32[0 max] argumentCount,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    stack ascii operationMemberName = kind == "enum-constructor"
        ? "EnumConstructors"
        : kind == "enum-call"
            ? "EnumCalls"
            : kind == "enum-value" ? "EnumValues" : "";
    stack mut u64[0 2 ** 63 - 1] operationNode = 0;
    stack mut u64[0 2 ** 63 - 1] enumTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] variantNameNode = 0;
    if (AsciiLength(operationMemberName) == 0
        || (kind == "enum-value" && argumentCount != 0)
        || !PackageImageSourceBridgeFindTemplateOperationByOrdinal(
            document,
            templateNode,
            operationMemberName,
            ordinal,
            operationNode)
        || !LogicalPackageImageJsonRequiredObjectMember(
            document,
            operationNode,
            "EnumType",
            enumTypeNode)
        || !document.TryFindMember(operationNode, "VariantName", variantNameNode)
        || document.KindAt(variantNameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(variantNameNode)) == 0
        || !PackageImageSourceBridgeRenderTypedTypeReference(
            document,
            enumTypeNode,
            depth + 1,
            sink)
        || !PackageImageSourceBridgeAppendConst(sink, ".")
        || !PackageImageSourceBridgeAppend(sink, document.TextAt(variantNameNode)))
    {
        return false;
    }

    if (kind == "enum-value")
    {
        return true;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, "("))
    {
        return false;
    }

    stack mut u32[0 max] argumentIndex = 0;
    while willexit (argumentIndex < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                argumentsNode,
                (u64[0 2 ** 63 - 1])argumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (argumentIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        argumentIndex = argumentIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ")");
}

internal fn bool PackageImageSourceBridgeRenderTypedCallGenericArguments(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeArgumentsNode,
    u32[0 max] typeArgumentCount,
    u64[0 2 ** 63 - 1] comptimeArgumentsNode,
    u32[0 max] comptimeArgumentCount,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (typeArgumentCount == 0 && comptimeArgumentCount == 0)
    {
        return true;
    }

    if (depth == 64 || !PackageImageSourceBridgeAppendConst(sink, "<"))
    {
        return false;
    }

    stack mut u32[0 max] typeArgumentIndex = 0;
    while willexit (typeArgumentIndex < typeArgumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                typeArgumentsNode,
                (u64[0 2 ** 63 - 1])typeArgumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (typeArgumentIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        typeArgumentIndex = typeArgumentIndex + 1;
    }

    stack mut u32[0 max] comptimeArgumentIndex = 0;
    while willexit (comptimeArgumentIndex < comptimeArgumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] integerValueNode = 0;
        stack mut u64[0 2 ** 63 - 1] symbolicSourceNameNode = 0;
        stack mut bool isSymbolic = false;
        stack mut bool hasSymbolicSourceName = false;
        if (!document.TryChildAt(
                comptimeArgumentsNode,
                (u64[0 2 ** 63 - 1])comptimeArgumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || !document.TryFindMember(argumentNode, "ParameterName", parameterNameNode)
            || document.KindAt(parameterNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(parameterNameNode)) == 0
            || !document.TryFindMember(argumentNode, "IntegerValue", integerValueNode)
            || document.KindAt(integerValueNode) != JsonKind.Text
            || AsciiLength(document.TextAt(integerValueNode)) == 0
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                argumentNode,
                "IsSymbolic",
                isSymbolic)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                argumentNode,
                "SymbolicSourceName",
                symbolicSourceNameNode,
                hasSymbolicSourceName)
            || ((typeArgumentCount != 0 || comptimeArgumentIndex != 0)
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || (isSymbolic && !PackageImageSourceBridgeAppendConst(sink, "comptime "))
            || !PackageImageSourceBridgeAppend(
                sink,
                isSymbolic
                    ? hasSymbolicSourceName
                        ? document.TextAt(symbolicSourceNameNode)
                        : document.TextAt(parameterNameNode)
                    : document.TextAt(integerValueNode)))
        {
            return false;
        }

        comptimeArgumentIndex = comptimeArgumentIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ">");
}

internal fn bool PackageImageSourceBridgeRenderTypedExpressionArguments(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    u64[0 2 ** 63 - 1] argumentsNode,
    u32[0 max] argumentCount,
    u32[0 max] firstArgument,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (firstArgument > argumentCount)
    {
        return false;
    }

    stack mut u32[0 max] argumentIndex = firstArgument;
    while willexit (argumentIndex < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                argumentsNode,
                (u64[0 2 ** 63 - 1])argumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (argumentIndex != firstArgument
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        argumentIndex = argumentIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderTypedExpression(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    u64[0 2 ** 63 - 1] expressionNode,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (depth == 64)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] kindNode = 0;
    if (!document.TryFindMember(expressionNode, "Kind", kindNode)
        || document.KindAt(kindNode) != JsonKind.Text
        || AsciiLength(document.TextAt(kindNode)) == 0)
    {
        return false;
    }

    stack ascii kind = document.TextAt(kindNode);
    if (kind == "name" || kind == "literal")
    {
        stack ascii memberName = kind == "name" ? "Name" : "LiteralText";
        stack mut u64[0 2 ** 63 - 1] valueNode = 0;
        return document.TryFindMember(expressionNode, memberName, valueNode)
            && document.KindAt(valueNode) == JsonKind.Text
            && (kind == "literal" || AsciiLength(document.TextAt(valueNode)) != 0)
            && PackageImageSourceBridgeAppend(sink, document.TextAt(valueNode));
    }

    stack mut u64[0 2 ** 63 - 1] argumentsNode = 0;
    stack mut u32[0 max] argumentCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "Arguments",
            argumentsNode,
            argumentCount))
    {
        return false;
    }

    if (kind == "object-initializer")
    {
        stack mut u64[0 2 ** 63 - 1] memberNamesNode = 0;
        stack mut u32[0 max] memberNameCount = 0;
        if (!LogicalPackageImageJsonOptionalArrayMember(
                document,
                expressionNode,
                "MemberNames",
                memberNamesNode,
                memberNameCount)
            || memberNameCount != argumentCount
            || !PackageImageSourceBridgeAppendConst(sink, "{ "))
        {
            return false;
        }

        stack mut u32[0 max] memberIndex = 0;
        while willexit (memberIndex < memberNameCount)
        {
            stack mut u64[0 2 ** 63 - 1] memberNameNode = 0;
            stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
            if (!document.TryChildAt(
                    memberNamesNode,
                    (u64[0 2 ** 63 - 1])memberIndex,
                    memberNameNode)
                || document.KindAt(memberNameNode) != JsonKind.Text
                || AsciiLength(document.TextAt(memberNameNode)) == 0
                || !document.TryChildAt(
                    argumentsNode,
                    (u64[0 2 ** 63 - 1])memberIndex,
                    argumentNode)
                || document.KindAt(argumentNode) != JsonKind.Object
                || (memberIndex != 0
                    && !PackageImageSourceBridgeAppendConst(sink, ", "))
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(memberNameNode))
                || !PackageImageSourceBridgeAppendConst(sink, " = ")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    argumentNode,
                    depth + 1,
                    sink))
            {
                return false;
            }

            memberIndex = memberIndex + 1;
        }

        return PackageImageSourceBridgeAppendConst(sink, " }");
    }

    if (kind == "array-initializer")
    {
        return PackageImageSourceBridgeAppendConst(
                sink,
                argumentCount == 0 ? "{ }" : "{ ")
            && PackageImageSourceBridgeRenderTypedExpressionArguments(
                document,
                templateNode,
                argumentsNode,
                argumentCount,
                0,
                depth,
                sink)
            && (argumentCount == 0
                || PackageImageSourceBridgeAppendConst(sink, " }"));
    }

    if (kind == "assignment")
    {
        stack mut u64[0 2 ** 63 - 1] targetExpressionNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] assignmentOperatorNode = 0;
        stack mut bool hasTargetExpression = false;
        stack mut bool hasName = false;
        stack mut bool hasAssignmentOperator = false;
        stack mut u64[0 2 ** 63 - 1] valueNode = 0;
        if (argumentCount != 1
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                expressionNode,
                "TargetExpression",
                targetExpressionNode,
                hasTargetExpression)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "AssignmentOperator",
                assignmentOperatorNode,
                hasAssignmentOperator)
            || (!hasTargetExpression && !hasName)
            || !document.TryChildAt(argumentsNode, 0, valueNode)
            || document.KindAt(valueNode) != JsonKind.Object)
        {
            return false;
        }

        stack ascii assignmentOperator = hasAssignmentOperator
            ? document.TextAt(assignmentOperatorNode)
            : "=";
        return (assignmentOperator != "init ="
                || PackageImageSourceBridgeAppendConst(sink, "init "))
            && (hasTargetExpression
                ? PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    targetExpressionNode,
                    depth + 1,
                    sink)
                : AsciiLength(document.TextAt(nameNode)) != 0
                    && PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode)))
            && PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeAppend(
                sink,
                assignmentOperator == "init =" ? "=" : assignmentOperator)
            && PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                valueNode,
                depth + 1,
                sink);
    }

    if (kind == "conversion" || kind == "type-layout")
    {
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut bool hasType = false;
        stack mut bool hasName = false;
        if (!LogicalPackageImageJsonOptionalObjectMember(
                document,
                expressionNode,
                "Type",
                typeNode,
                hasType)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName)
            || !hasType)
        {
            return false;
        }

        if (kind == "type-layout")
        {
            return argumentCount == 0
                && hasName
                && AsciiLength(document.TextAt(nameNode)) != 0
                && PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
                && PackageImageSourceBridgeAppendConst(sink, "(")
                && PackageImageSourceBridgeRenderTypedTypeReference(
                    document,
                    typeNode,
                    depth + 1,
                    sink)
                && PackageImageSourceBridgeAppendConst(sink, ")");
        }

        stack mut u64[0 2 ** 63 - 1] valueNode = 0;
        return argumentCount == 1
            && document.TryChildAt(argumentsNode, 0, valueNode)
            && document.KindAt(valueNode) == JsonKind.Object
            && PackageImageSourceBridgeAppendConst(sink, "(")
            && PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                typeNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, ")")
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                valueNode,
                depth + 1,
                sink);
    }

    if (kind == "try" || kind == "unary" || kind == "comptime")
    {
        stack mut u64[0 2 ** 63 - 1] valueNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut bool hasName = false;
        if (argumentCount != 1
            || !document.TryChildAt(argumentsNode, 0, valueNode)
            || document.KindAt(valueNode) != JsonKind.Object
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName))
        {
            return false;
        }

        if (kind == "unary"
            && (!hasName || AsciiLength(document.TextAt(nameNode)) == 0))
        {
            return false;
        }

        return (kind == "try"
                ? PackageImageSourceBridgeAppendConst(sink, "try ")
                : kind == "comptime"
                    ? PackageImageSourceBridgeAppendConst(sink, "comptime (")
                    : PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode)))
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                valueNode,
                depth + 1,
                sink)
            && (kind != "comptime"
                || PackageImageSourceBridgeAppendConst(sink, ")"));
    }

    if (kind == "binary" || kind == "conditional")
    {
        stack mut u64[0 2 ** 63 - 1] firstNode = 0;
        stack mut u64[0 2 ** 63 - 1] secondNode = 0;
        stack mut u64[0 2 ** 63 - 1] thirdNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut bool hasName = false;
        if ((kind == "binary" && argumentCount != 2)
            || (kind == "conditional" && argumentCount != 3)
            || !document.TryChildAt(argumentsNode, 0, firstNode)
            || !document.TryChildAt(argumentsNode, 1, secondNode)
            || document.KindAt(firstNode) != JsonKind.Object
            || document.KindAt(secondNode) != JsonKind.Object
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName)
            || (kind == "binary"
                && (!hasName || AsciiLength(document.TextAt(nameNode)) == 0))
            || (kind == "conditional"
                && (!document.TryChildAt(argumentsNode, 2, thirdNode)
                    || document.KindAt(thirdNode) != JsonKind.Object)))
        {
            return false;
        }

        return PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                firstNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeAppend(
                sink,
                kind == "binary" ? document.TextAt(nameNode) : "?")
            && PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                secondNode,
                depth + 1,
                sink)
            && (kind == "binary"
                || (PackageImageSourceBridgeAppendConst(sink, " : ")
                    && PackageImageSourceBridgeRenderTypedExpression(
                        document,
                        templateNode,
                        thirdNode,
                        depth + 1,
                        sink)));
    }

    if (kind == "comparison-chain")
    {
        stack mut u64[0 2 ** 63 - 1] operatorsNode = 0;
        stack mut u32[0 max] operatorCount = 0;
        if (argumentCount < 2
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                expressionNode,
                "OperatorNames",
                operatorsNode,
                operatorCount)
            || operatorCount != argumentCount - 1)
        {
            return false;
        }

        stack mut u32[0 max] comparisonIndex = 0;
        while willexit (comparisonIndex < argumentCount)
        {
            stack mut u64[0 2 ** 63 - 1] valueNode = 0;
            if (!document.TryChildAt(
                    argumentsNode,
                    (u64[0 2 ** 63 - 1])comparisonIndex,
                    valueNode)
                || document.KindAt(valueNode) != JsonKind.Object
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    valueNode,
                    depth + 1,
                    sink))
            {
                return false;
            }

            if (comparisonIndex < operatorCount)
            {
                stack mut u64[0 2 ** 63 - 1] operatorNode = 0;
                if (!document.TryChildAt(
                        operatorsNode,
                        (u64[0 2 ** 63 - 1])comparisonIndex,
                        operatorNode)
                    || document.KindAt(operatorNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(operatorNode)) == 0
                    || !PackageImageSourceBridgeAppendConst(sink, " ")
                    || !PackageImageSourceBridgeAppend(
                        sink,
                        document.TextAt(operatorNode))
                    || !PackageImageSourceBridgeAppendConst(sink, " "))
                {
                    return false;
                }
            }

            comparisonIndex = comparisonIndex + 1;
        }

        return true;
    }

    if (kind == "closure-call"
        || kind == "index-access"
        || kind == "dyntrait-from-parts")
    {
        stack mut u64[0 2 ** 63 - 1] firstNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut bool hasName = false;
        if (argumentCount == 0
            || !document.TryChildAt(argumentsNode, 0, firstNode)
            || document.KindAt(firstNode) != JsonKind.Object
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                expressionNode,
                "Name",
                nameNode,
                hasName)
            || (kind == "dyntrait-from-parts"
                && (argumentCount != 2
                    || !hasName
                    || AsciiLength(document.TextAt(nameNode)) == 0)))
        {
            return false;
        }

        if (kind == "dyntrait-from-parts")
        {
            return PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
                && PackageImageSourceBridgeAppendConst(sink, "(")
                && PackageImageSourceBridgeRenderTypedExpressionArguments(
                    document,
                    templateNode,
                    argumentsNode,
                    argumentCount,
                    0,
                    depth,
                    sink)
                && PackageImageSourceBridgeAppendConst(sink, ")");
        }

        return PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                firstNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(
                sink,
                kind == "closure-call" ? "(" : "[")
            && PackageImageSourceBridgeRenderTypedExpressionArguments(
                document,
                templateNode,
                argumentsNode,
                argumentCount,
                1,
                depth,
                sink)
            && PackageImageSourceBridgeAppendConst(
                sink,
                kind == "closure-call" ? ")" : "]");
    }

    stack mut u32[0 max] ordinal = 0;
    if (!LogicalPackageImageJsonRequiredU32MemberValue(
            document,
            expressionNode,
            "Ordinal",
            ordinal))
    {
        return false;
    }

    if (kind == "object-creation")
    {
        stack mut u64[0 2 ** 63 - 1] creationsNode = 0;
        stack mut u64[0 2 ** 63 - 1] creationNode = 0;
        stack mut u64[0 2 ** 63 - 1] createdTypeNode = 0;
        stack mut u64[0 2 ** 63 - 1] constructorNode = 0;
        stack mut u64[0 2 ** 63 - 1] initializerMembersNode = 0;
        stack mut u64[0 2 ** 63 - 1] expressionTextNode = 0;
        stack mut bool hasConstructor = false;
        stack mut bool hasStorageSelector = false;
        stack mut bool hasExpressionText = false;
        stack mut u32[0 max] creationCount = 0;
        stack mut u32[0 max] storageSelector = 0;
        stack mut u32[0 max] initializerMemberCount = 0;
        if (!LogicalPackageImageJsonOptionalArrayMember(
                document,
                templateNode,
                "ObjectCreations",
                creationsNode,
                creationCount)
            || ordinal >= creationCount
            || !document.TryChildAt(
                creationsNode,
                (u64[0 2 ** 63 - 1])ordinal,
                creationNode)
            || document.KindAt(creationNode) != JsonKind.Object
            || !LogicalPackageImageJsonRequiredObjectMember(
                document,
                creationNode,
                "CreatedType",
                createdTypeNode)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                creationNode,
                "Constructor",
                constructorNode,
                hasConstructor)
            || !LogicalPackageImageJsonOptionalU32MemberValue(
                document,
                creationNode,
                "StorageSelector",
                hasStorageSelector,
                storageSelector)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                creationNode,
                "InitializerMembers",
                initializerMembersNode,
                initializerMemberCount)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                creationNode,
                "ExpressionText",
                expressionTextNode,
                hasExpressionText)
            || (hasStorageSelector && storageSelector > 1))
        {
            return false;
        }

        if (argumentCount == 0 && hasExpressionText)
        {
            return PackageImageSourceBridgeAppend(sink, document.TextAt(expressionTextNode));
        }

        if (hasStorageSelector && storageSelector == 1)
        {
            if (!PackageImageSourceBridgeAppendConst(sink, "new(arena"))
            {
                return false;
            }

            stack mut u32[0 max] arenaArgumentIndex = 0;
            while willexit (arenaArgumentIndex < argumentCount)
            {
                stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
                if (!document.TryChildAt(
                        argumentsNode,
                        (u64[0 2 ** 63 - 1])arenaArgumentIndex,
                        argumentNode)
                    || document.KindAt(argumentNode) != JsonKind.Object
                    || !PackageImageSourceBridgeAppendConst(sink, ", ")
                    || !PackageImageSourceBridgeRenderTypedExpression(
                        document,
                        templateNode,
                        argumentNode,
                        depth + 1,
                        sink))
                {
                    return false;
                }

                arenaArgumentIndex = arenaArgumentIndex + 1;
            }

            return PackageImageSourceBridgeAppendConst(sink, ")");
        }

        if (!PackageImageSourceBridgeAppendConst(sink, "new ")
            || !PackageImageSourceBridgeRenderTypedTypeReference(
                document,
                createdTypeNode,
                depth + 1,
                sink)
            || !PackageImageSourceBridgeAppendConst(sink, "("))
        {
            return false;
        }

        if (!hasConstructor && initializerMemberCount != 0)
        {
            if (initializerMemberCount != argumentCount
                || !PackageImageSourceBridgeAppendConst(sink, ") { "))
            {
                return false;
            }

            stack mut u32[0 max] initializerIndex = 0;
            while willexit (initializerIndex < initializerMemberCount)
            {
                stack mut u64[0 2 ** 63 - 1] initializerNode = 0;
                stack mut u64[0 2 ** 63 - 1] fieldNameNode = 0;
                stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
                if (!document.TryChildAt(
                        initializerMembersNode,
                        (u64[0 2 ** 63 - 1])initializerIndex,
                        initializerNode)
                    || document.KindAt(initializerNode) != JsonKind.Object
                    || !document.TryFindMember(initializerNode, "FieldName", fieldNameNode)
                    || document.KindAt(fieldNameNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(fieldNameNode)) == 0
                    || !document.TryChildAt(
                        argumentsNode,
                        (u64[0 2 ** 63 - 1])initializerIndex,
                        argumentNode)
                    || document.KindAt(argumentNode) != JsonKind.Object
                    || (initializerIndex != 0
                        && !PackageImageSourceBridgeAppendConst(sink, ", "))
                    || !PackageImageSourceBridgeAppend(sink, document.TextAt(fieldNameNode))
                    || !PackageImageSourceBridgeAppendConst(sink, " = ")
                    || !PackageImageSourceBridgeRenderTypedExpression(
                        document,
                        templateNode,
                        argumentNode,
                        depth + 1,
                        sink))
                {
                    return false;
                }

                initializerIndex = initializerIndex + 1;
            }

            return PackageImageSourceBridgeAppendConst(sink, " }");
        }

        stack mut u32[0 max] objectArgumentIndex = 0;
        while willexit (objectArgumentIndex < argumentCount)
        {
            stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
            if (!document.TryChildAt(
                    argumentsNode,
                    (u64[0 2 ** 63 - 1])objectArgumentIndex,
                    argumentNode)
                || document.KindAt(argumentNode) != JsonKind.Object
                || (objectArgumentIndex != 0
                    && !PackageImageSourceBridgeAppendConst(sink, ", "))
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    argumentNode,
                    depth + 1,
                    sink))
            {
                return false;
            }

            objectArgumentIndex = objectArgumentIndex + 1;
        }

        return PackageImageSourceBridgeAppendConst(sink, ")");
    }

    if (kind == "enum-constructor"
        || kind == "enum-call"
        || kind == "enum-value")
    {
        return PackageImageSourceBridgeRenderTypedEnumExpression(
            document,
            templateNode,
            kind,
            ordinal,
            argumentsNode,
            argumentCount,
            depth,
            sink);
    }

    if (kind == "field-access")
    {
        stack mut u64[0 2 ** 63 - 1] fieldNode = 0;
        stack mut u64[0 2 ** 63 - 1] fieldNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] receiverNode = 0;
        return argumentCount == 1
            && PackageImageSourceBridgeFindTemplateOperationByOrdinal(
                document,
                templateNode,
                "FieldAccesses",
                ordinal,
                fieldNode)
            && document.TryFindMember(fieldNode, "FieldName", fieldNameNode)
            && document.KindAt(fieldNameNode) == JsonKind.Text
            && AsciiLength(document.TextAt(fieldNameNode)) != 0
            && document.TryChildAt(argumentsNode, 0, receiverNode)
            && document.KindAt(receiverNode) == JsonKind.Object
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                receiverNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, ".")
            && PackageImageSourceBridgeAppend(sink, document.TextAt(fieldNameNode));
    }

    stack ascii operationMemberName = kind == "direct-call"
        ? "DirectCalls"
        : kind == "member-call" ? "MemberCalls" : "";
    stack mut u64[0 2 ** 63 - 1] callNode = 0;
    stack mut u64[0 2 ** 63 - 1] resolvedNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] sourceNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] templateNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] typeArgumentsNode = 0;
    stack mut u64[0 2 ** 63 - 1] comptimeArgumentsNode = 0;
    stack mut bool hasSourceName = false;
    stack mut bool hasTemplateName = false;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    if (AsciiLength(operationMemberName) == 0
        || !PackageImageSourceBridgeFindTemplateOperationByOrdinal(
            document,
            templateNode,
            operationMemberName,
            ordinal,
            callNode)
        || !document.TryFindMember(callNode, "QualifiedResolvedName", resolvedNameNode)
        || document.KindAt(resolvedNameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(resolvedNameNode)) == 0
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            callNode,
            "QualifiedSourceName",
            sourceNameNode,
            hasSourceName)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            callNode,
            "QualifiedTemplateName",
            templateNameNode,
            hasTemplateName)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            callNode,
            "TypeArguments",
            typeArgumentsNode,
            typeArgumentCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            callNode,
            "ComptimeValueArguments",
            comptimeArgumentsNode,
            comptimeArgumentCount))
    {
        return false;
    }

    stack mut u32[0 max] firstCallArgument = 0;
    if (kind == "member-call")
    {
        stack mut u64[0 2 ** 63 - 1] receiverNode = 0;
        if (argumentCount == 0
            || !document.TryChildAt(argumentsNode, 0, receiverNode)
            || document.KindAt(receiverNode) != JsonKind.Object
            || !PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                receiverNode,
                depth + 1,
                sink)
            || !PackageImageSourceBridgeAppendConst(sink, "."))
        {
            return false;
        }

        stack ascii sourceName = hasSourceName
            ? document.TextAt(sourceNameNode)
            : document.TextAt(resolvedNameNode);
        stack i64[min max] signedNameLength = AsciiLength(sourceName);
        if (signedNameLength <= 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameLength = (u64[0 2 ** 63 - 1])signedNameLength;
        stack mut u64[0 2 ** 63 - 1] memberStart = 0;
        stack mut u64[0 2 ** 63 - 1] nameIndex = 0;
        while willexit (nameIndex < nameLength)
        {
            if (sourceName[nameIndex, 1] == ".")
            {
                memberStart = nameIndex + 1;
            }

            nameIndex = nameIndex + 1;
        }

        if (memberStart == nameLength
            || !PackageImageSourceBridgeAppend(
                sink,
                sourceName[memberStart, nameLength - memberStart])
            || !PackageImageSourceBridgeRenderTypedCallGenericArguments(
                document,
                typeArgumentsNode,
                typeArgumentCount,
                comptimeArgumentsNode,
                comptimeArgumentCount,
                depth + 1,
                sink))
        {
            return false;
        }

        firstCallArgument = 1;
    }
    else if (!PackageImageSourceBridgeAppend(
            sink,
            hasSourceName
                ? document.TextAt(sourceNameNode)
                : hasTemplateName
                    ? document.TextAt(templateNameNode)
                    : document.TextAt(resolvedNameNode))
        || (comptimeArgumentCount != 0
            && !PackageImageSourceBridgeRenderTypedCallGenericArguments(
                document,
                typeArgumentsNode,
                typeArgumentCount,
                comptimeArgumentsNode,
                comptimeArgumentCount,
                depth + 1,
                sink)))
    {
        return false;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, "("))
    {
        return false;
    }

    stack mut u32[0 max] argumentIndex = firstCallArgument;
    while willexit (argumentIndex < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(
                argumentsNode,
                (u64[0 2 ** 63 - 1])argumentIndex,
                argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || (argumentIndex != firstCallArgument
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                argumentNode,
                depth + 1,
                sink))
        {
            return false;
        }

        argumentIndex = argumentIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ")");
}

internal fn bool PackageImageSourceBridgeAppendIndent(
    mut borrow OwnedAscii sink,
    u8[0 64] indentLevel)
{
    stack mut u8[0 64] indentIndex = 0;
    while willexit (indentIndex < indentLevel)
    {
        if (!PackageImageSourceBridgeAppendConst(sink, "    "))
        {
            return false;
        }

        indentIndex = indentIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderTypedForHeaderStatementArray(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    u64[0 2 ** 63 - 1] statementsNode,
    u32[0 max] statementCount,
    mut borrow OwnedAscii sink)
{
    stack mut u32[0 max] statementIndex = 0;
    while willexit (statementIndex < statementCount)
    {
        stack mut u64[0 2 ** 63 - 1] statementNode = 0;
        stack mut u64[0 2 ** 63 - 1] kindNode = 0;
        stack mut u64[0 2 ** 63 - 1] expressionNode = 0;
        stack mut u64[0 2 ** 63 - 1] targetExpressionNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] assignmentOperatorNode = 0;
        stack mut u64[0 2 ** 63 - 1] storageClassNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut bool hasExpression = false;
        stack mut bool hasTargetExpression = false;
        stack mut bool hasName = false;
        stack mut bool hasAssignmentOperator = false;
        stack mut bool hasStorageClass = false;
        stack mut bool hasType = false;
        stack mut bool isMutable = false;
        stack mut bool isConstant = false;
        if (!document.TryChildAt(
                statementsNode,
                (u64[0 2 ** 63 - 1])statementIndex,
                statementNode)
            || document.KindAt(statementNode) != JsonKind.Object
            || !document.TryFindMember(statementNode, "Kind", kindNode)
            || document.KindAt(kindNode) != JsonKind.Text
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                statementNode,
                "Expression",
                expressionNode,
                hasExpression)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                statementNode,
                "TargetExpression",
                targetExpressionNode,
                hasTargetExpression)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                statementNode,
                "Name",
                nameNode,
                hasName)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                statementNode,
                "AssignmentOperator",
                assignmentOperatorNode,
                hasAssignmentOperator)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                statementNode,
                "StorageClass",
                storageClassNode,
                hasStorageClass)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                statementNode,
                "Type",
                typeNode,
                hasType)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                statementNode,
                "IsMutable",
                isMutable)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                statementNode,
                "IsConstant",
                isConstant)
            || (statementIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", ")))
        {
            return false;
        }

        stack ascii kind = document.TextAt(kindNode);
        if (kind == "local-variable")
        {
            if (!hasName
                || AsciiLength(document.TextAt(nameNode)) == 0
                || !hasType
                || !hasExpression
                || (isConstant
                    ? !PackageImageSourceBridgeAppendConst(sink, "const ")
                    : !hasStorageClass
                        || AsciiLength(document.TextAt(storageClassNode)) == 0
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(storageClassNode))
                        || !PackageImageSourceBridgeAppendConst(sink, " ")
                        || (isMutable
                            && !PackageImageSourceBridgeAppendConst(sink, "mut ")))
                || !PackageImageSourceBridgeRenderTypedTypeReference(
                    document,
                    typeNode,
                    0,
                    sink)
                || !PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
                || !PackageImageSourceBridgeAppendConst(sink, " = ")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    expressionNode,
                    0,
                    sink))
            {
                return false;
            }
        }
        else if (kind == "expression")
        {
            if (!hasExpression
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    expressionNode,
                    0,
                    sink))
            {
                return false;
            }
        }
        else if (kind == "assignment")
        {
            stack ascii assignmentOperator = hasAssignmentOperator
                ? document.TextAt(assignmentOperatorNode)
                : "=";
            if (!hasExpression
                || (!hasTargetExpression && !hasName)
                || (assignmentOperator == "init ="
                    && !PackageImageSourceBridgeAppendConst(sink, "init "))
                || (hasTargetExpression
                    ? !PackageImageSourceBridgeRenderTypedExpression(
                        document,
                        templateNode,
                        targetExpressionNode,
                        0,
                        sink)
                    : !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode)))
                || !PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeAppend(
                    sink,
                    assignmentOperator == "init =" ? "=" : assignmentOperator)
                || !PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    expressionNode,
                    0,
                    sink))
            {
                return false;
            }
        }
        else
        {
            return false;
        }

        statementIndex = statementIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderTypedPattern(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    u64[0 2 ** 63 - 1] patternNode,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (depth == 64)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] kindNode = 0;
    stack mut u64[0 2 ** 63 - 1] nameNode = 0;
    stack mut u64[0 2 ** 63 - 1] expressionNode = 0;
    stack mut u64[0 2 ** 63 - 1] endExpressionNode = 0;
    stack mut u64[0 2 ** 63 - 1] membersNode = 0;
    stack mut bool hasName = false;
    stack mut bool hasExpression = false;
    stack mut bool hasEndExpression = false;
    stack mut u32[0 max] memberCount = 0;
    if (!document.TryFindMember(patternNode, "Kind", kindNode)
        || document.KindAt(kindNode) != JsonKind.Text
        || AsciiLength(document.TextAt(kindNode)) == 0
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            patternNode,
            "Name",
            nameNode,
            hasName)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            patternNode,
            "Expression",
            expressionNode,
            hasExpression)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            patternNode,
            "EndExpression",
            endExpressionNode,
            hasEndExpression)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            patternNode,
            "Members",
            membersNode,
            memberCount))
    {
        return false;
    }

    stack ascii kind = document.TextAt(kindNode);
    if (kind == "discard" || (kind == "match-all" && !hasName))
    {
        return PackageImageSourceBridgeAppendConst(sink, "_");
    }

    if (kind == "capture" || kind == "match-all")
    {
        return hasName
            && AsciiLength(document.TextAt(nameNode)) != 0
            && PackageImageSourceBridgeAppendConst(sink, "var ")
            && PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode));
    }

    if (kind == "literal")
    {
        return hasExpression
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                expressionNode,
                depth + 1,
                sink);
    }

    if (kind == "range")
    {
        return hasExpression
            && hasEndExpression
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                expressionNode,
                depth + 1,
                sink)
            && PackageImageSourceBridgeAppendConst(sink, "..")
            && PackageImageSourceBridgeRenderTypedExpression(
                document,
                templateNode,
                endExpressionNode,
                depth + 1,
                sink);
    }

    if (kind == "list-pattern")
    {
        if (!PackageImageSourceBridgeAppendConst(sink, "["))
        {
            return false;
        }

        stack mut u32[0 max] listMemberIndex = 0;
        while willexit (listMemberIndex < memberCount)
        {
            stack mut u64[0 2 ** 63 - 1] memberNode = 0;
            if (!document.TryChildAt(
                    membersNode,
                    (u64[0 2 ** 63 - 1])listMemberIndex,
                    memberNode)
                || document.KindAt(memberNode) != JsonKind.Object
                || (listMemberIndex != 0
                    && !PackageImageSourceBridgeAppendConst(sink, ", "))
                || !PackageImageSourceBridgeRenderTypedPattern(
                    document,
                    templateNode,
                    memberNode,
                    depth + 1,
                    sink))
            {
                return false;
            }

            listMemberIndex = listMemberIndex + 1;
        }

        return PackageImageSourceBridgeAppendConst(sink, "]");
    }

    if (kind != "enum-pattern" && kind != "aggregate-pattern")
    {
        return false;
    }

    stack mut u32[0 max] ordinal = 0;
    stack mut u64[0 2 ** 63 - 1] operationNode = 0;
    stack mut u64[0 2 ** 63 - 1] typeNode = 0;
    stack mut u64[0 2 ** 63 - 1] variantNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] publishedMembersNode = 0;
    stack mut u32[0 max] publishedMemberCount = 0;
    if (!LogicalPackageImageJsonRequiredU32MemberValue(
            document,
            patternNode,
            "Ordinal",
            ordinal)
        || !PackageImageSourceBridgeFindTemplateOperationByOrdinal(
            document,
            templateNode,
            kind == "enum-pattern" ? "EnumPatterns" : "AggregatePatterns",
            ordinal,
            operationNode)
        || !LogicalPackageImageJsonRequiredObjectMember(
            document,
            operationNode,
            kind == "enum-pattern" ? "EnumType" : "Type",
            typeNode)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            operationNode,
            "Members",
            publishedMembersNode,
            publishedMemberCount)
        || (kind == "enum-pattern"
            && (!document.TryFindMember(
                    operationNode,
                    "VariantName",
                    variantNameNode)
                || document.KindAt(variantNameNode) != JsonKind.Text
                || AsciiLength(document.TextAt(variantNameNode)) == 0))
        || !PackageImageSourceBridgeRenderTypedTypeReference(
            document,
            typeNode,
            depth + 1,
            sink)
        || (kind == "enum-pattern"
            && (!PackageImageSourceBridgeAppendConst(sink, ".")
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(variantNameNode)))))
    {
        return false;
    }

    if (hasName)
    {
        return memberCount == 0
            && AsciiLength(document.TextAt(nameNode)) != 0
            && PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode));
    }

    if (memberCount == 0)
    {
        return true;
    }

    stack bool usesNamedMembers = publishedMemberCount == memberCount;
    if (!PackageImageSourceBridgeAppendConst(
            sink,
            usesNamedMembers ? " { " : "("))
    {
        return false;
    }

    stack mut u32[0 max] memberIndex = 0;
    while willexit (memberIndex < memberCount)
    {
        stack mut u64[0 2 ** 63 - 1] memberNode = 0;
        stack mut u64[0 2 ** 63 - 1] publishedMemberNode = 0;
        stack mut u64[0 2 ** 63 - 1] fieldNameNode = 0;
        if (!document.TryChildAt(
                membersNode,
                (u64[0 2 ** 63 - 1])memberIndex,
                memberNode)
            || document.KindAt(memberNode) != JsonKind.Object
            || (memberIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || (usesNamedMembers
                && (!document.TryChildAt(
                        publishedMembersNode,
                        (u64[0 2 ** 63 - 1])memberIndex,
                        publishedMemberNode)
                    || document.KindAt(publishedMemberNode) != JsonKind.Object
                    || !document.TryFindMember(
                        publishedMemberNode,
                        "FieldName",
                        fieldNameNode)
                    || document.KindAt(fieldNameNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(fieldNameNode)) == 0
                    || !PackageImageSourceBridgeAppend(
                        sink,
                        document.TextAt(fieldNameNode))
                    || !PackageImageSourceBridgeAppendConst(sink, ": ")))
            || !PackageImageSourceBridgeRenderTypedPattern(
                document,
                templateNode,
                memberNode,
                depth + 1,
                sink))
        {
            return false;
        }

        memberIndex = memberIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(
        sink,
        usesNamedMembers ? " }" : ")");
}

internal fn bool PackageImageSourceBridgeRenderTypedStatementArray(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    u64[0 2 ** 63 - 1] statementsNode,
    u32[0 max] statementCount,
    u8[0 64] indentLevel,
    mut borrow OwnedAscii sink)
{
    if (indentLevel == 64)
    {
        return false;
    }

    stack mut u32[0 max] statementIndex = 0;
    while willexit (statementIndex < statementCount)
    {
        stack mut u64[0 2 ** 63 - 1] statementNode = 0;
        stack mut u64[0 2 ** 63 - 1] statementKindNode = 0;
        stack mut u64[0 2 ** 63 - 1] expressionNode = 0;
        stack mut u64[0 2 ** 63 - 1] targetExpressionNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] assignmentOperatorNode = 0;
        stack mut u64[0 2 ** 63 - 1] storageClassNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut bool hasExpression = false;
        stack mut bool hasTargetExpression = false;
        stack mut bool hasName = false;
        stack mut bool hasAssignmentOperator = false;
        stack mut bool hasStorageClass = false;
        stack mut bool hasType = false;
        stack mut bool isMutable = false;
        stack mut bool isConstant = false;
        if (!document.TryChildAt(
                statementsNode,
                (u64[0 2 ** 63 - 1])statementIndex,
                statementNode)
            || document.KindAt(statementNode) != JsonKind.Object
            || !document.TryFindMember(statementNode, "Kind", statementKindNode)
            || document.KindAt(statementKindNode) != JsonKind.Text
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                statementNode,
                "Expression",
                expressionNode,
                hasExpression)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                statementNode,
                "TargetExpression",
                targetExpressionNode,
                hasTargetExpression)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                statementNode,
                "Name",
                nameNode,
                hasName)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                statementNode,
                "AssignmentOperator",
                assignmentOperatorNode,
                hasAssignmentOperator)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                statementNode,
                "StorageClass",
                storageClassNode,
                hasStorageClass)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                statementNode,
                "Type",
                typeNode,
                hasType)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                statementNode,
                "IsMutable",
                isMutable)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                statementNode,
                "IsConstant",
                isConstant)
            || !PackageImageSourceBridgeAppendIndent(sink, indentLevel))
        {
            return false;
        }

        stack ascii statementKind = document.TextAt(statementKindNode);
        stack mut bool isBlockStatement = false;
        if (statementKind == "block")
        {
            stack mut u64[0 2 ** 63 - 1] bodyStatementsNode = 0;
            stack mut u32[0 max] bodyStatementCount = 0;
            if (!LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "BodyStatements",
                    bodyStatementsNode,
                    bodyStatementCount)
                || !PackageImageSourceBridgeAppendConst(sink, "{\n")
                || !PackageImageSourceBridgeRenderTypedStatementArray(
                    document,
                    templateNode,
                    bodyStatementsNode,
                    bodyStatementCount,
                    indentLevel + 1,
                    sink)
                || !PackageImageSourceBridgeAppendIndent(sink, indentLevel)
                || !PackageImageSourceBridgeAppendConst(sink, "}"))
            {
                return false;
            }

            isBlockStatement = true;
        }
        else if (statementKind == "switch")
        {
            stack mut u64[0 2 ** 63 - 1] switchCasesNode = 0;
            stack mut u32[0 max] switchCaseCount = 0;
            if (!hasExpression
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "SwitchCases",
                    switchCasesNode,
                    switchCaseCount)
                || switchCaseCount == 0
                || (hasName
                    && (AsciiLength(document.TextAt(nameNode)) == 0
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(nameNode))
                        || !PackageImageSourceBridgeAppendConst(sink, ": ")))
                || !PackageImageSourceBridgeAppendConst(sink, "switch (")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    expressionNode,
                    0,
                    sink)
                || !PackageImageSourceBridgeAppendConst(sink, ")\n")
                || !PackageImageSourceBridgeAppendIndent(sink, indentLevel)
                || !PackageImageSourceBridgeAppendConst(sink, "{\n"))
            {
                return false;
            }

            stack mut u32[0 max] switchCaseIndex = 0;
            while willexit (switchCaseIndex < switchCaseCount)
            {
                stack mut u64[0 2 ** 63 - 1] switchCaseNode = 0;
                stack mut u64[0 2 ** 63 - 1] switchCaseKindNode = 0;
                stack mut u64[0 2 ** 63 - 1] guardExpressionNode = 0;
                stack mut u64[0 2 ** 63 - 1] caseStatementsNode = 0;
                stack mut bool hasGuardExpression = false;
                stack mut u32[0 max] caseStatementCount = 0;
                if (!document.TryChildAt(
                        switchCasesNode,
                        (u64[0 2 ** 63 - 1])switchCaseIndex,
                        switchCaseNode)
                    || document.KindAt(switchCaseNode) != JsonKind.Object
                    || !document.TryFindMember(
                        switchCaseNode,
                        "Kind",
                        switchCaseKindNode)
                    || document.KindAt(switchCaseKindNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(switchCaseKindNode)) == 0
                    || !LogicalPackageImageJsonOptionalObjectMember(
                        document,
                        switchCaseNode,
                        "GuardExpression",
                        guardExpressionNode,
                        hasGuardExpression)
                    || !LogicalPackageImageJsonOptionalArrayMember(
                        document,
                        switchCaseNode,
                        "Statements",
                        caseStatementsNode,
                        caseStatementCount)
                    || !PackageImageSourceBridgeAppendIndent(
                        sink,
                        indentLevel + 1))
                {
                    return false;
                }

                stack ascii switchCaseKind = document.TextAt(switchCaseKindNode);
                if (switchCaseKind == "default")
                {
                    if (!PackageImageSourceBridgeAppendConst(sink, "default"))
                    {
                        return false;
                    }
                }
                else if (!PackageImageSourceBridgeAppendConst(sink, "case ")
                    || !PackageImageSourceBridgeRenderTypedPattern(
                        document,
                        templateNode,
                        switchCaseNode,
                        0,
                        sink))
                {
                    return false;
                }

                if ((hasGuardExpression
                        && (!PackageImageSourceBridgeAppendConst(sink, " when ")
                            || !PackageImageSourceBridgeRenderTypedExpression(
                                document,
                                templateNode,
                                guardExpressionNode,
                                0,
                                sink)))
                    || !PackageImageSourceBridgeAppendConst(sink, ":\n")
                    || !PackageImageSourceBridgeRenderTypedStatementArray(
                        document,
                        templateNode,
                        caseStatementsNode,
                        caseStatementCount,
                        indentLevel + 2,
                        sink))
                {
                    return false;
                }

                switchCaseIndex = switchCaseIndex + 1;
            }

            if (!PackageImageSourceBridgeAppendIndent(sink, indentLevel)
                || !PackageImageSourceBridgeAppendConst(sink, "}"))
            {
                return false;
            }

            isBlockStatement = true;
        }
        else if (statementKind == "for")
        {
            stack mut u64[0 2 ** 63 - 1] loopBehaviorNode = 0;
            stack mut u64[0 2 ** 63 - 1] loopContractsNode = 0;
            stack mut u64[0 2 ** 63 - 1] initializerStatementsNode = 0;
            stack mut u64[0 2 ** 63 - 1] iteratorStatementsNode = 0;
            stack mut u64[0 2 ** 63 - 1] bodyStatementsNode = 0;
            stack mut bool hasLoopBehavior = false;
            stack mut u32[0 max] loopContractCount = 0;
            stack mut u32[0 max] initializerStatementCount = 0;
            stack mut u32[0 max] iteratorStatementCount = 0;
            stack mut u32[0 max] bodyStatementCount = 0;
            if (!PackageImageSourceBridgeOptionalTextMemberNode(
                    document,
                    statementNode,
                    "LoopBehavior",
                    loopBehaviorNode,
                    hasLoopBehavior)
                || !hasLoopBehavior
                || AsciiLength(document.TextAt(loopBehaviorNode)) == 0
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "LoopContracts",
                    loopContractsNode,
                    loopContractCount)
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "InitializerStatements",
                    initializerStatementsNode,
                    initializerStatementCount)
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "IteratorStatements",
                    iteratorStatementsNode,
                    iteratorStatementCount)
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "BodyStatements",
                    bodyStatementsNode,
                    bodyStatementCount)
                || (hasName
                    && (AsciiLength(document.TextAt(nameNode)) == 0
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(nameNode))
                        || !PackageImageSourceBridgeAppendConst(sink, ": ")))
                || !PackageImageSourceBridgeAppendConst(sink, "for ")
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(loopBehaviorNode)))
            {
                return false;
            }

            stack mut u32[0 max] loopContractIndex = 0;
            while willexit (loopContractIndex < loopContractCount)
            {
                stack mut u64[0 2 ** 63 - 1] loopContractNode = 0;
                if (!document.TryChildAt(
                        loopContractsNode,
                        (u64[0 2 ** 63 - 1])loopContractIndex,
                        loopContractNode)
                    || document.KindAt(loopContractNode) != JsonKind.Text
                    || (AsciiLength(document.TextAt(loopContractNode)) != 0
                        && (!PackageImageSourceBridgeAppendConst(sink, " ")
                            || !PackageImageSourceBridgeAppend(
                                sink,
                                document.TextAt(loopContractNode)))))
                {
                    return false;
                }

                loopContractIndex = loopContractIndex + 1;
            }

            if (!PackageImageSourceBridgeAppendConst(sink, " (")
                || !PackageImageSourceBridgeRenderTypedForHeaderStatementArray(
                    document,
                    templateNode,
                    initializerStatementsNode,
                    initializerStatementCount,
                    sink)
                || !PackageImageSourceBridgeAppendConst(sink, "; ")
                || (hasExpression
                    && !PackageImageSourceBridgeRenderTypedExpression(
                        document,
                        templateNode,
                        expressionNode,
                        0,
                        sink))
                || !PackageImageSourceBridgeAppendConst(sink, "; ")
                || !PackageImageSourceBridgeRenderTypedForHeaderStatementArray(
                    document,
                    templateNode,
                    iteratorStatementsNode,
                    iteratorStatementCount,
                    sink)
                || !PackageImageSourceBridgeAppendConst(sink, ") {\n")
                || !PackageImageSourceBridgeRenderTypedStatementArray(
                    document,
                    templateNode,
                    bodyStatementsNode,
                    bodyStatementCount,
                    indentLevel + 1,
                    sink)
                || !PackageImageSourceBridgeAppendIndent(sink, indentLevel)
                || !PackageImageSourceBridgeAppendConst(sink, "}"))
            {
                return false;
            }

            isBlockStatement = true;
        }
        else if (statementKind == "for-traversal")
        {
            stack mut u64[0 2 ** 63 - 1] loopBehaviorNode = 0;
            stack mut u64[0 2 ** 63 - 1] loopContractsNode = 0;
            stack mut u64[0 2 ** 63 - 1] bodyStatementsNode = 0;
            stack mut u64[0 2 ** 63 - 1] traversalSourceNode = 0;
            stack mut u64[0 2 ** 63 - 1] traversalIndexNameNode = 0;
            stack mut u64[0 2 ** 63 - 1] traversalIndexStorageClassNode = 0;
            stack mut u64[0 2 ** 63 - 1] traversalIndexTypeNode = 0;
            stack mut u64[0 2 ** 63 - 1] traversalElementNameNode = 0;
            stack mut u64[0 2 ** 63 - 1] traversalElementTypeNode = 0;
            stack mut bool hasLoopBehavior = false;
            stack mut bool hasTraversalSource = false;
            stack mut bool hasTraversalIndexName = false;
            stack mut bool hasTraversalIndexStorageClass = false;
            stack mut bool hasTraversalIndexType = false;
            stack mut bool hasTraversalElementName = false;
            stack mut bool hasTraversalElementType = false;
            stack mut u32[0 max] loopContractCount = 0;
            stack mut u32[0 max] bodyStatementCount = 0;
            if (!PackageImageSourceBridgeOptionalTextMemberNode(
                    document,
                    statementNode,
                    "LoopBehavior",
                    loopBehaviorNode,
                    hasLoopBehavior)
                || !hasLoopBehavior
                || AsciiLength(document.TextAt(loopBehaviorNode)) == 0
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "LoopContracts",
                    loopContractsNode,
                    loopContractCount)
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "BodyStatements",
                    bodyStatementsNode,
                    bodyStatementCount)
                || !LogicalPackageImageJsonOptionalObjectMember(
                    document,
                    statementNode,
                    "TraversalSource",
                    traversalSourceNode,
                    hasTraversalSource)
                || !PackageImageSourceBridgeOptionalTextMemberNode(
                    document,
                    statementNode,
                    "TraversalIndexName",
                    traversalIndexNameNode,
                    hasTraversalIndexName)
                || !PackageImageSourceBridgeOptionalTextMemberNode(
                    document,
                    statementNode,
                    "TraversalIndexStorageClass",
                    traversalIndexStorageClassNode,
                    hasTraversalIndexStorageClass)
                || !LogicalPackageImageJsonOptionalObjectMember(
                    document,
                    statementNode,
                    "TraversalIndexType",
                    traversalIndexTypeNode,
                    hasTraversalIndexType)
                || !PackageImageSourceBridgeOptionalTextMemberNode(
                    document,
                    statementNode,
                    "TraversalElementName",
                    traversalElementNameNode,
                    hasTraversalElementName)
                || !LogicalPackageImageJsonOptionalObjectMember(
                    document,
                    statementNode,
                    "TraversalElementType",
                    traversalElementTypeNode,
                    hasTraversalElementType)
                || !hasTraversalSource
                || !hasTraversalElementName
                || AsciiLength(document.TextAt(traversalElementNameNode)) == 0
                || !hasTraversalElementType
                || (hasTraversalIndexName != hasTraversalIndexStorageClass)
                || (hasTraversalIndexName != hasTraversalIndexType)
                || (hasTraversalIndexName
                    && (AsciiLength(document.TextAt(traversalIndexNameNode)) == 0
                        || AsciiLength(document.TextAt(
                            traversalIndexStorageClassNode)) == 0))
                || (hasName
                    && (AsciiLength(document.TextAt(nameNode)) == 0
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(nameNode))
                        || !PackageImageSourceBridgeAppendConst(sink, ": ")))
                || !PackageImageSourceBridgeAppendConst(sink, "for ")
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(loopBehaviorNode)))
            {
                return false;
            }

            stack mut u32[0 max] loopContractIndex = 0;
            while willexit (loopContractIndex < loopContractCount)
            {
                stack mut u64[0 2 ** 63 - 1] loopContractNode = 0;
                if (!document.TryChildAt(
                        loopContractsNode,
                        (u64[0 2 ** 63 - 1])loopContractIndex,
                        loopContractNode)
                    || document.KindAt(loopContractNode) != JsonKind.Text
                    || (AsciiLength(document.TextAt(loopContractNode)) != 0
                        && (!PackageImageSourceBridgeAppendConst(sink, " ")
                            || !PackageImageSourceBridgeAppend(
                                sink,
                                document.TextAt(loopContractNode)))))
                {
                    return false;
                }

                loopContractIndex = loopContractIndex + 1;
            }

            if (!PackageImageSourceBridgeAppendConst(sink, " (")
                || (hasTraversalIndexName
                    && (!PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(traversalIndexStorageClassNode))
                        || !PackageImageSourceBridgeAppendConst(sink, " ")
                        || !PackageImageSourceBridgeRenderTypedTypeReference(
                            document,
                            traversalIndexTypeNode,
                            0,
                            sink)
                        || !PackageImageSourceBridgeAppendConst(sink, " ")
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(traversalIndexNameNode))
                        || !PackageImageSourceBridgeAppendConst(sink, ", ")))
                || !PackageImageSourceBridgeRenderTypedTypeReference(
                    document,
                    traversalElementTypeNode,
                    0,
                    sink)
                || !PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(traversalElementNameNode))
                || !PackageImageSourceBridgeAppendConst(sink, " in ")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    traversalSourceNode,
                    0,
                    sink)
                || !PackageImageSourceBridgeAppendConst(sink, ") {\n")
                || !PackageImageSourceBridgeRenderTypedStatementArray(
                    document,
                    templateNode,
                    bodyStatementsNode,
                    bodyStatementCount,
                    indentLevel + 1,
                    sink)
                || !PackageImageSourceBridgeAppendIndent(sink, indentLevel)
                || !PackageImageSourceBridgeAppendConst(sink, "}"))
            {
                return false;
            }

            isBlockStatement = true;
        }
        else if (statementKind == "while")
        {
            stack mut u64[0 2 ** 63 - 1] loopBehaviorNode = 0;
            stack mut u64[0 2 ** 63 - 1] loopContractsNode = 0;
            stack mut u64[0 2 ** 63 - 1] bodyStatementsNode = 0;
            stack mut u64[0 2 ** 63 - 1] conditionPatternNode = 0;
            stack mut bool hasLoopBehavior = false;
            stack mut bool hasConditionPattern = false;
            stack mut u32[0 max] loopContractCount = 0;
            stack mut u32[0 max] bodyStatementCount = 0;
            if (!hasExpression
                || !PackageImageSourceBridgeOptionalTextMemberNode(
                    document,
                    statementNode,
                    "LoopBehavior",
                    loopBehaviorNode,
                    hasLoopBehavior)
                || !hasLoopBehavior
                || AsciiLength(document.TextAt(loopBehaviorNode)) == 0
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "LoopContracts",
                    loopContractsNode,
                    loopContractCount)
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "BodyStatements",
                    bodyStatementsNode,
                    bodyStatementCount)
                || !LogicalPackageImageJsonOptionalObjectMember(
                    document,
                    statementNode,
                    "ConditionPattern",
                    conditionPatternNode,
                    hasConditionPattern)
                || (hasName
                    && (AsciiLength(document.TextAt(nameNode)) == 0
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(nameNode))
                        || !PackageImageSourceBridgeAppendConst(sink, ": ")))
                || !PackageImageSourceBridgeAppendConst(sink, "while ")
                || !PackageImageSourceBridgeAppend(
                    sink,
                    document.TextAt(loopBehaviorNode)))
            {
                return false;
            }

            stack mut u32[0 max] loopContractIndex = 0;
            while willexit (loopContractIndex < loopContractCount)
            {
                stack mut u64[0 2 ** 63 - 1] loopContractNode = 0;
                if (!document.TryChildAt(
                        loopContractsNode,
                        (u64[0 2 ** 63 - 1])loopContractIndex,
                        loopContractNode)
                    || document.KindAt(loopContractNode) != JsonKind.Text
                    || (AsciiLength(document.TextAt(loopContractNode)) != 0
                        && (!PackageImageSourceBridgeAppendConst(sink, " ")
                            || !PackageImageSourceBridgeAppend(
                                sink,
                                document.TextAt(loopContractNode)))))
                {
                    return false;
                }

                loopContractIndex = loopContractIndex + 1;
            }

            if (!PackageImageSourceBridgeAppendConst(sink, " (")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    expressionNode,
                    0,
                    sink)
                || (hasConditionPattern
                    && (!PackageImageSourceBridgeAppendConst(sink, " is ")
                        || !PackageImageSourceBridgeRenderTypedPattern(
                            document,
                            templateNode,
                            conditionPatternNode,
                            0,
                            sink)))
                || !PackageImageSourceBridgeAppendConst(sink, ") {\n")
                || !PackageImageSourceBridgeRenderTypedStatementArray(
                    document,
                    templateNode,
                    bodyStatementsNode,
                    bodyStatementCount,
                    indentLevel + 1,
                    sink)
                || !PackageImageSourceBridgeAppendIndent(sink, indentLevel)
                || !PackageImageSourceBridgeAppendConst(sink, "}"))
            {
                return false;
            }

            isBlockStatement = true;
        }
        else if (statementKind == "if")
        {
            stack mut u64[0 2 ** 63 - 1] thenStatementsNode = 0;
            stack mut u64[0 2 ** 63 - 1] elseStatementsNode = 0;
            stack mut u64[0 2 ** 63 - 1] conditionPatternNode = 0;
            stack mut u32[0 max] thenStatementCount = 0;
            stack mut u32[0 max] elseStatementCount = 0;
            stack mut bool hasConditionPattern = false;
            if (!hasExpression
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "ThenStatements",
                    thenStatementsNode,
                    thenStatementCount)
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    statementNode,
                    "ElseStatements",
                    elseStatementsNode,
                    elseStatementCount)
                || !LogicalPackageImageJsonOptionalObjectMember(
                    document,
                    statementNode,
                    "ConditionPattern",
                    conditionPatternNode,
                    hasConditionPattern)
                || !PackageImageSourceBridgeAppendConst(sink, "if (")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    expressionNode,
                    0,
                    sink)
                || (hasConditionPattern
                    && (!PackageImageSourceBridgeAppendConst(sink, " is ")
                        || !PackageImageSourceBridgeRenderTypedPattern(
                            document,
                            templateNode,
                            conditionPatternNode,
                            0,
                            sink)))
                || !PackageImageSourceBridgeAppendConst(sink, ") {\n")
                || !PackageImageSourceBridgeRenderTypedStatementArray(
                    document,
                    templateNode,
                    thenStatementsNode,
                    thenStatementCount,
                    indentLevel + 1,
                    sink)
                || !PackageImageSourceBridgeAppendIndent(sink, indentLevel)
                || !PackageImageSourceBridgeAppendConst(sink, "}")
                || (elseStatementCount != 0
                    && (!PackageImageSourceBridgeAppendConst(sink, " else {\n")
                        || !PackageImageSourceBridgeRenderTypedStatementArray(
                            document,
                            templateNode,
                            elseStatementsNode,
                            elseStatementCount,
                            indentLevel + 1,
                            sink)
                        || !PackageImageSourceBridgeAppendIndent(sink, indentLevel)
                        || !PackageImageSourceBridgeAppendConst(sink, "}"))))
            {
                return false;
            }

            isBlockStatement = true;
        }
        else if (statementKind == "local-variable")
        {
            if (!hasName
                || AsciiLength(document.TextAt(nameNode)) == 0
                || !hasType
                || !hasExpression
                || (isConstant
                    ? !PackageImageSourceBridgeAppendConst(sink, "const ")
                    : !hasStorageClass
                        || AsciiLength(document.TextAt(storageClassNode)) == 0
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(storageClassNode))
                        || !PackageImageSourceBridgeAppendConst(sink, " ")
                        || (isMutable
                            && !PackageImageSourceBridgeAppendConst(sink, "mut ")))
                || !PackageImageSourceBridgeRenderTypedTypeReference(
                    document,
                    typeNode,
                    0,
                    sink)
                || !PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
                || !PackageImageSourceBridgeAppendConst(sink, " = ")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    expressionNode,
                    0,
                    sink))
            {
                return false;
            }
        }
        else if (statementKind == "return")
        {
            if (!PackageImageSourceBridgeAppendConst(sink, "return")
                || (hasExpression
                    && (!PackageImageSourceBridgeAppendConst(sink, " ")
                        || !PackageImageSourceBridgeRenderTypedExpression(
                            document,
                            templateNode,
                            expressionNode,
                            0,
                            sink))))
            {
                return false;
            }
        }
        else if (statementKind == "expression")
        {
            if (!hasExpression
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    expressionNode,
                    0,
                    sink))
            {
                return false;
            }
        }
        else if (statementKind == "assignment")
        {
            stack ascii assignmentOperator = hasAssignmentOperator
                ? document.TextAt(assignmentOperatorNode)
                : "=";
            if (!hasExpression
                || (!hasTargetExpression && !hasName)
                || (assignmentOperator == "init ="
                    && !PackageImageSourceBridgeAppendConst(sink, "init "))
                || (hasTargetExpression
                    ? !PackageImageSourceBridgeRenderTypedExpression(
                        document,
                        templateNode,
                        targetExpressionNode,
                        0,
                        sink)
                    : !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode)))
                || !PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeAppend(
                    sink,
                    assignmentOperator == "init =" ? "=" : assignmentOperator)
                || !PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeRenderTypedExpression(
                    document,
                    templateNode,
                    expressionNode,
                    0,
                    sink))
            {
                return false;
            }
        }
        else if (statementKind == "break" || statementKind == "continue")
        {
            if (!PackageImageSourceBridgeAppend(sink, statementKind)
                || (hasName
                    && (!PackageImageSourceBridgeAppendConst(sink, " ")
                        || !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode)))))
            {
                return false;
            }
        }
        else if (statementKind != "empty")
        {
            return false;
        }

        if (!(isBlockStatement
                ? PackageImageSourceBridgeAppendConst(sink, "\n")
                : PackageImageSourceBridgeAppendConst(sink, ";\n")))
        {
            return false;
        }

        statementIndex = statementIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderTypedOperationBody(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] templateNode,
    u64[0 2 ** 63 - 1] typedBodyNode,
    mut borrow OwnedAscii sink)
{
    sink.Clear();
    stack mut u64[0 2 ** 63 - 1] statementsNode = 0;
    stack mut u32[0 max] statementCount = 0;
    return LogicalPackageImageJsonRequiredArrayMember(
            document,
            typedBodyNode,
            "Statements",
            statementsNode,
            statementCount)
        && statementCount != 0
        && PackageImageSourceBridgeAppendConst(sink, "{\n")
        && PackageImageSourceBridgeRenderTypedStatementArray(
            document,
            templateNode,
            statementsNode,
            statementCount,
            1,
            sink)
        && PackageImageSourceBridgeAppendConst(sink, "}");
}

internal fn bool PackageImageSourceBridgePrepareTemplateBody(
    mut borrow JsonDocument document,
    borrow PackageImageSourceBridgeTemplateContext context,
    u64[0 2 ** 63 - 1] callableNode,
    mut borrow OwnedAscii overloadKeyScratch,
    mut borrow OwnedAscii typedBodyScratch,
    out u64[0 2 ** 63 - 1] legacyBodyTextNode,
    out bool hasLegacyBodyText,
    out bool hasTypedBodyText)
{
    legacyBodyTextNode = 0;
    hasLegacyBodyText = false;
    hasTypedBodyText = false;
    typedBodyScratch.Clear();
    stack mut PackageImageSourceBridgeTemplateBodyMatch match = new();
    if (!PackageImageSourceBridgeFindTemplateBody(
            document,
            context,
            callableNode,
            overloadKeyScratch,
            match))
    {
        return false;
    }

    legacyBodyTextNode = match.LegacyBodyTextNode;
    hasLegacyBodyText = match.HasLegacyBodyText;
    if (!match.HasTypedBody)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] statementsNode = 0;
    stack mut u32[0 max] statementCount = 0;
    stack mut bool requiresBody = false;
    if (!LogicalPackageImageJsonRequiredArrayMember(
            document,
            match.TypedBodyNode,
            "Statements",
            statementsNode,
            statementCount)
        || !PackageImageSourceBridgeTypedStatementArrayRequiresBody(
            document,
            statementsNode,
            statementCount,
            0,
            requiresBody))
    {
        return false;
    }

    if (!requiresBody)
    {
        return true;
    }

    stack bool renderedTypedBody = PackageImageSourceBridgeRenderTypedOperationBody(
        document,
        match.TemplateNode,
        match.TypedBodyNode,
        typedBodyScratch);
    hasTypedBodyText = renderedTypedBody;
    return renderedTypedBody;
}

internal fn bool PackageImageSourceBridgeEffectiveCompilerFactsNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    out u64[0 2 ** 63 - 1] compilerFactsNode,
    out bool present)
{
    compilerFactsNode = 0;
    present = false;
    stack mut u64[0 2 ** 63 - 1] directNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsNode = 0;
    stack mut u64[0 2 ** 63 - 1] sectionsNode = 0;
    stack mut bool hasDirect = false;
    stack mut bool hasCompilerSections = false;
    stack mut bool hasSectionsNode = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            moduleNode,
            "CompilerFacts",
            directNode,
            hasDirect)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            moduleNode,
            "CompilerSections",
            compilerSectionsNode,
            hasCompilerSections))
    {
        return false;
    }

    if (hasCompilerSections
        && !LogicalPackageImageJsonOptionalObjectMember(
            document,
            compilerSectionsNode,
            "CompilerFacts",
            sectionsNode,
            hasSectionsNode))
    {
        return false;
    }

    if (hasSectionsNode)
    {
        compilerFactsNode = sectionsNode;
        present = true;
    }
    else if (hasDirect)
    {
        compilerFactsNode = directNode;
        present = true;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderGenericParameters(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownerNode,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] genericParametersNode = 0;
    stack mut u32[0 max] genericParameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] comptimeParametersNode = 0;
    stack mut u32[0 max] comptimeParameterCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            ownerNode,
            "GenericParameters",
            genericParametersNode,
            genericParameterCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            ownerNode,
            "ComptimeGenericParameters",
            comptimeParametersNode,
            comptimeParameterCount)
        || comptimeParameterCount > (u32[0 max])(2 ** 32 - 1) - genericParameterCount)
    {
        return false;
    }

    stack u32[0 max] totalParameterCount = genericParameterCount + comptimeParameterCount;
    if (totalParameterCount != 0
        && !PackageImageSourceBridgeAppendConst(sink, "<"))
    {
        return false;
    }

    stack mut u32[0 max] genericIndex = 0;
    while willexit (genericIndex < genericParameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        if (!document.TryChildAt(
                genericParametersNode,
                (u64[0 2 ** 63 - 1])genericIndex,
                parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Text
            || AsciiLength(document.TextAt(parameterNode)) == 0
            || (genericIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(parameterNode)))
        {
            return false;
        }

        genericIndex = genericIndex + 1;
    }

    stack mut u32[0 max] comptimeIndex = 0;
    while willexit (comptimeIndex < comptimeParameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterTypeNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterTypeKindNode = 0;
        if (!document.TryChildAt(
                comptimeParametersNode,
                (u64[0 2 ** 63 - 1])comptimeIndex,
                parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || !document.TryFindMember(parameterNode, "Name", parameterNameNode)
            || document.KindAt(parameterNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(parameterNameNode)) == 0
            || !document.TryFindMember(parameterNode, "Type", parameterTypeNode)
            || document.KindAt(parameterTypeNode) != JsonKind.Object
            || !document.TryFindMember(parameterTypeNode, "Kind", parameterTypeKindNode)
            || document.KindAt(parameterTypeKindNode) != JsonKind.Text
            || AsciiLength(document.TextAt(parameterTypeKindNode)) == 0
            || ((genericParameterCount != 0 || comptimeIndex != 0)
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeAppendConst(sink, "comptime ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(parameterTypeKindNode))
            || !PackageImageSourceBridgeAppendConst(sink, " ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(parameterNameNode)))
        {
            return false;
        }

        comptimeIndex = comptimeIndex + 1;
    }

    return totalParameterCount == 0
        || PackageImageSourceBridgeAppendConst(sink, ">");
}

internal fn bool PackageImageSourceBridgeRenderTypeParameterConstraints(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownerNode,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] constraintsNode = 0;
    stack mut u32[0 max] constraintCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            ownerNode,
            "TypeParameterConstraints",
            constraintsNode,
            constraintCount))
    {
        return false;
    }

    stack mut u32[0 max] constraintIndex = 0;
    while willexit (constraintIndex < constraintCount)
    {
        stack mut u64[0 2 ** 63 - 1] constraintNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] boundTraitsNode = 0;
        stack mut u32[0 max] boundTraitCount = 0;
        if (!document.TryChildAt(
                constraintsNode,
                (u64[0 2 ** 63 - 1])constraintIndex,
                constraintNode)
            || document.KindAt(constraintNode) != JsonKind.Object
            || !document.TryFindMember(constraintNode, "ParameterName", parameterNameNode)
            || document.KindAt(parameterNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(parameterNameNode)) == 0
            || !LogicalPackageImageJsonRequiredArrayMember(
                document,
                constraintNode,
                "BoundTraits",
                boundTraitsNode,
                boundTraitCount))
        {
            return false;
        }

        if (boundTraitCount != 0
            && (!PackageImageSourceBridgeAppendConst(sink, " where ")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(parameterNameNode))
                || !PackageImageSourceBridgeAppendConst(sink, ": ")))
        {
            return false;
        }

        stack mut u32[0 max] boundTraitIndex = 0;
        while willexit (boundTraitIndex < boundTraitCount)
        {
            stack mut u64[0 2 ** 63 - 1] boundTraitNode = 0;
            if (!document.TryChildAt(
                    boundTraitsNode,
                    (u64[0 2 ** 63 - 1])boundTraitIndex,
                    boundTraitNode)
                || document.KindAt(boundTraitNode) != JsonKind.Text
                || AsciiLength(document.TextAt(boundTraitNode)) == 0
                || (boundTraitIndex != 0
                    && !PackageImageSourceBridgeAppendConst(sink, ", "))
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(boundTraitNode)))
            {
                return false;
            }

            boundTraitIndex = boundTraitIndex + 1;
        }

        constraintIndex = constraintIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderThreadSafetyLawPredicates(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownerNode,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] predicatesNode = 0;
    stack mut u32[0 max] predicateCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            ownerNode,
            "ThreadSafetyLawPredicates",
            predicatesNode,
            predicateCount))
    {
        return false;
    }

    stack mut u32[0 max] predicateIndex = 0;
    while willexit (predicateIndex < predicateCount)
    {
        stack mut u64[0 2 ** 63 - 1] predicateNode = 0;
        stack mut u64[0 2 ** 63 - 1] lawNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        if (!document.TryChildAt(
                predicatesNode,
                (u64[0 2 ** 63 - 1])predicateIndex,
                predicateNode)
            || document.KindAt(predicateNode) != JsonKind.Object
            || !document.TryFindMember(predicateNode, "LawName", lawNameNode)
            || document.KindAt(lawNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(lawNameNode)) == 0
            || !document.TryFindMember(predicateNode, "Type", typeNode)
            || document.KindAt(typeNode) != JsonKind.Text
            || AsciiLength(document.TextAt(typeNode)) == 0
            || !PackageImageSourceBridgeAppendConst(sink, " where ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(lawNameNode))
            || !PackageImageSourceBridgeAppendConst(sink, "(")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(typeNode))
            || !PackageImageSourceBridgeAppendConst(sink, ")"))
        {
            return false;
        }

        predicateIndex = predicateIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderValueContracts(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownerNode,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] contractsNode = 0;
    stack mut u32[0 max] contractCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            ownerNode,
            "ValueContracts",
            contractsNode,
            contractCount))
    {
        return false;
    }

    stack mut u32[0 max] contractIndex = 0;
    while willexit (contractIndex < contractCount)
    {
        stack mut u64[0 2 ** 63 - 1] contractNode = 0;
        stack mut u64[0 2 ** 63 - 1] leftNode = 0;
        stack mut u64[0 2 ** 63 - 1] operatorNode = 0;
        stack mut u64[0 2 ** 63 - 1] rightNode = 0;
        if (!document.TryChildAt(
                contractsNode,
                (u64[0 2 ** 63 - 1])contractIndex,
                contractNode)
            || document.KindAt(contractNode) != JsonKind.Object
            || !document.TryFindMember(contractNode, "Left", leftNode)
            || document.KindAt(leftNode) != JsonKind.Text
            || AsciiLength(document.TextAt(leftNode)) == 0
            || !document.TryFindMember(contractNode, "Operator", operatorNode)
            || document.KindAt(operatorNode) != JsonKind.Text
            || AsciiLength(document.TextAt(operatorNode)) == 0
            || !document.TryFindMember(contractNode, "Right", rightNode)
            || document.KindAt(rightNode) != JsonKind.Text
            || AsciiLength(document.TextAt(rightNode)) == 0
            || !PackageImageSourceBridgeAppendConst(sink, " where ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(leftNode))
            || !PackageImageSourceBridgeAppendConst(sink, " ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(operatorNode))
            || !PackageImageSourceBridgeAppendConst(sink, " ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(rightNode)))
        {
            return false;
        }

        contractIndex = contractIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderParameterMemoryContractGroups(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownerNode,
    ascii memberName,
    ascii relationName,
    bool isFfi,
    bool isDisjointRelation,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] groupsNode = 0;
    stack mut u32[0 max] groupCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            ownerNode,
            memberName,
            groupsNode,
            groupCount))
    {
        return false;
    }

    stack mut u32[0 max] groupIndex = 0;
    while willexit (groupIndex < groupCount)
    {
        stack mut u64[0 2 ** 63 - 1] groupNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterNamesNode = 0;
        stack mut u32[0 max] parameterNameCount = 0;
        stack mut u64[0 2 ** 63 - 1] regionsNode = 0;
        stack mut u32[0 max] regionCount = 0;
        if (!document.TryChildAt(
                groupsNode,
                (u64[0 2 ** 63 - 1])groupIndex,
                groupNode)
            || document.KindAt(groupNode) != JsonKind.Object
            || !LogicalPackageImageJsonRequiredArrayMember(
                document,
                groupNode,
                "ParameterNames",
                parameterNamesNode,
                parameterNameCount)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                groupNode,
                "Regions",
                regionsNode,
                regionCount))
        {
            return false;
        }

        stack bool useRegions = regionCount >= 2;
        stack u32[0 max] operandCount = useRegions ? regionCount : parameterNameCount;
        stack bool emitGroup = operandCount >= 2
            && (!isDisjointRelation || isFfi || useRegions);
        if (emitGroup
            && (!PackageImageSourceBridgeAppendConst(sink, " where ")
                || !PackageImageSourceBridgeAppend(sink, relationName)
                || !PackageImageSourceBridgeAppendConst(sink, "(")))
        {
            return false;
        }

        stack mut u32[0 max] operandIndex = 0;
        while willexit (operandIndex < operandCount)
        {
            stack mut u64[0 2 ** 63 - 1] operandNode = 0;
            stack mut u64[0 2 ** 63 - 1] parameterNameNode = 0;
            stack mut u64[0 2 ** 63 - 1] startNode = 0;
            stack mut u64[0 2 ** 63 - 1] countNode = 0;
            stack mut bool hasStart = false;
            stack mut bool hasCount = false;
            if (!document.TryChildAt(
                    useRegions ? regionsNode : parameterNamesNode,
                    (u64[0 2 ** 63 - 1])operandIndex,
                    operandNode))
            {
                return false;
            }

            if (useRegions)
            {
                if (document.KindAt(operandNode) != JsonKind.Object
                    || !document.TryFindMember(operandNode, "ParameterName", parameterNameNode)
                    || document.KindAt(parameterNameNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(parameterNameNode)) == 0
                    || !PackageImageSourceBridgeOptionalTextMemberNode(
                        document,
                        operandNode,
                        "StartExpression",
                        startNode,
                        hasStart)
                    || !PackageImageSourceBridgeOptionalTextMemberNode(
                        document,
                        operandNode,
                        "CountExpression",
                        countNode,
                        hasCount)
                    || hasStart != hasCount)
                {
                    return false;
                }
            }
            else
            {
                if (document.KindAt(operandNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(operandNode)) == 0)
                {
                    return false;
                }

                parameterNameNode = operandNode;
            }

            if (emitGroup
                && ((operandIndex != 0
                        && !PackageImageSourceBridgeAppendConst(sink, ", "))
                    || !PackageImageSourceBridgeAppend(sink, document.TextAt(parameterNameNode))
                    || (hasStart
                        && (!PackageImageSourceBridgeAppendConst(sink, "[")
                            || !PackageImageSourceBridgeAppend(sink, document.TextAt(startNode))
                            || !PackageImageSourceBridgeAppendConst(sink, ", ")
                            || !PackageImageSourceBridgeAppend(sink, document.TextAt(countNode))
                            || !PackageImageSourceBridgeAppendConst(sink, "]")))))
            {
                return false;
            }

            operandIndex = operandIndex + 1;
        }

        if (emitGroup && !PackageImageSourceBridgeAppendConst(sink, ")"))
        {
            return false;
        }

        groupIndex = groupIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderFunctionParameter(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] parameterNode,
    bool emitDisjointPrefix,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] nameNode = 0;
    stack mut u64[0 2 ** 63 - 1] typeNode = 0;
    stack mut u64[0 2 ** 63 - 1] countNode = 0;
    stack mut bool isDisjoint = false;
    stack mut bool isConst = false;
    stack mut bool hasCount = false;
    if (!document.TryFindMember(parameterNode, "Name", nameNode)
        || document.KindAt(nameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(nameNode)) == 0
        || !document.TryFindMember(parameterNode, "Type", typeNode)
        || document.KindAt(typeNode) != JsonKind.Text
        || AsciiLength(document.TextAt(typeNode)) == 0
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            parameterNode,
            "IsDisjoint",
            isDisjoint)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            parameterNode,
            "IsConst",
            isConst)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            parameterNode,
            "RawPointerElementCountExpression",
            countNode,
            hasCount))
    {
        return false;
    }

    if (emitDisjointPrefix && isDisjoint
        && !PackageImageSourceBridgeAppendConst(sink, "disjoint "))
    {
        return false;
    }

    if (isConst && !PackageImageSourceBridgeAppendConst(sink, "const "))
    {
        return false;
    }

    return PackageImageSourceBridgeAppend(sink, document.TextAt(typeNode))
        && (!hasCount
            || (PackageImageSourceBridgeAppendConst(sink, "[")
                && PackageImageSourceBridgeAppend(sink, document.TextAt(countNode))
                && PackageImageSourceBridgeAppendConst(sink, "]")))
        && PackageImageSourceBridgeAppendConst(sink, " ")
        && PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode));
}

internal fn bool PackageImageSourceBridgeRenderConstGlobalType(
    ascii typeText,
    mut borrow OwnedAscii sink)
    where overlap(typeText, sink)
{
    stack i64[min max] signedLength = AsciiLength(typeText);
    if (signedLength < 4)
    {
        return PackageImageSourceBridgeAppend(sink, typeText);
    }

    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])signedLength;
    stack bool integerPrefix = (typeText[0, 1] == "i" || typeText[0, 1] == "u")
        && typeText[1, 1] >= "0"
        && typeText[1, 1] <= "9";
    if (!integerPrefix)
    {
        return PackageImageSourceBridgeAppend(sink, typeText);
    }

    stack mut u64[0 2 ** 63 - 1] rangeStart = length;
    stack mut u64[0 2 ** 63 - 1] index = 2;
    while willexit (index < length)
    {
        stack ascii unit = typeText[index, 1];
        if (unit == "[")
        {
            rangeStart = index;
            break;
        }

        if (unit < "0" || unit > "9")
        {
            return PackageImageSourceBridgeAppend(sink, typeText);
        }

        index = index + 1;
    }

    if (rangeStart == length || typeText[length - 1, 1] != "]")
    {
        return PackageImageSourceBridgeAppend(sink, typeText);
    }

    stack ascii bareType = typeText[0, rangeStart];
    return PackageImageSourceBridgeAppend(sink, bareType);
}

internal fn bool PackageImageSourceBridgeRenderConstantInitializer(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] initializerNode,
    u8[0 64] depth,
    mut borrow OwnedAscii sink)
{
    if (depth >= 64)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] kindNode = 0;
    stack mut u64[0 2 ** 63 - 1] typeNode = 0;
    if (!document.TryFindMember(initializerNode, "Kind", kindNode)
        || document.KindAt(kindNode) != JsonKind.Text
        || AsciiLength(document.TextAt(kindNode)) == 0
        || !document.TryFindMember(initializerNode, "Type", typeNode)
        || document.KindAt(typeNode) != JsonKind.Object)
    {
        return false;
    }

    stack ascii kind = document.TextAt(kindNode);
    if (kind == "integer" || kind == "float")
    {
        return PackageImageSourceBridgeAppendConst(sink, "0");
    }

    if (kind == "bool")
    {
        return PackageImageSourceBridgeAppendConst(sink, "false");
    }

    if (kind == "text")
    {
        return PackageImageSourceBridgeAppendConst(sink, "\"\"");
    }

    if (kind == "null")
    {
        return PackageImageSourceBridgeAppendConst(sink, "null");
    }

    if (kind != "fixedarray")
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] elementsNode = 0;
    stack mut u32[0 max] elementCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            initializerNode,
            "Elements",
            elementsNode,
            elementCount)
        || !PackageImageSourceBridgeAppendConst(sink, "{ "))
    {
        return false;
    }

    stack mut u32[0 max] elementIndex = 0;
    while willexit (elementIndex < elementCount)
    {
        stack mut u64[0 2 ** 63 - 1] elementNode = 0;
        if (!document.TryChildAt(
                elementsNode,
                (u64[0 2 ** 63 - 1])elementIndex,
                elementNode)
            || document.KindAt(elementNode) != JsonKind.Object
            || (elementIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderConstantInitializer(
                document,
                elementNode,
                depth + 1,
                sink))
        {
            return false;
        }

        elementIndex = elementIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, " }");
}

internal fn bool PackageImageSourceBridgeRenderGlobals(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] globalsNode = 0;
    stack mut u32[0 max] globalCount = 0;
    if (!LogicalPackageImageJsonSourceSurfaceGlobalNodes(
            document,
            moduleNode,
            globalsNode,
            globalCount))
    {
        return false;
    }

    stack mut u32[0 max] globalIndex = 0;
    while willexit (globalIndex < globalCount)
    {
        stack mut u64[0 2 ** 63 - 1] globalNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] qualifiedNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] visibilityNode = 0;
        stack mut u64[0 2 ** 63 - 1] kindNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u64[0 2 ** 63 - 1] initializerNode = 0;
        stack mut bool isMutable = false;
        stack mut bool hasInitializer = false;
        if (!document.TryChildAt(
                globalsNode,
                (u64[0 2 ** 63 - 1])globalIndex,
                globalNode)
            || document.KindAt(globalNode) != JsonKind.Object
            || !document.TryFindMember(globalNode, "Name", nameNode)
            || document.KindAt(nameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(nameNode)) == 0
            || !document.TryFindMember(globalNode, "QualifiedName", qualifiedNameNode)
            || document.KindAt(qualifiedNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(qualifiedNameNode)) == 0
            || !document.TryFindMember(globalNode, "Visibility", visibilityNode)
            || document.KindAt(visibilityNode) != JsonKind.Text
            || AsciiLength(document.TextAt(visibilityNode)) == 0
            || !document.TryFindMember(globalNode, "Kind", kindNode)
            || document.KindAt(kindNode) != JsonKind.Text
            || !document.TryFindMember(globalNode, "Type", typeNode)
            || document.KindAt(typeNode) != JsonKind.Text
            || AsciiLength(document.TextAt(typeNode)) == 0
            || !LogicalPackageImageJsonRequiredBoolMemberValue(
                document,
                globalNode,
                "IsMutable",
                isMutable)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                globalNode,
                "ConstantInitializer",
                initializerNode,
                hasInitializer)
            || (document.TextAt(kindNode) != "static"
                && document.TextAt(kindNode) != "static mut"
                && document.TextAt(kindNode) != "globalconstant")
            || (document.TextAt(kindNode) == "globalconstant"
                && (isMutable || !hasInitializer))
            || (document.TextAt(kindNode) != "globalconstant" && hasInitializer)
            || (isMutable && document.TextAt(kindNode) != "static mut")
            || (!isMutable
                && document.TextAt(kindNode) != "static"
                && document.TextAt(kindNode) != "globalconstant"))
        {
            return false;
        }

        if (globalIndex == 0
            && !PackageImageSourceBridgeAppendConst(sink, "\n"))
        {
            return false;
        }

        if (!PackageImageSourceBridgeAppend(sink, document.TextAt(visibilityNode))
            || (document.TextAt(kindNode) == "globalconstant"
                ? !PackageImageSourceBridgeAppendConst(sink, " const ")
                : (!PackageImageSourceBridgeAppendConst(sink, " static ")
                    || (isMutable && !PackageImageSourceBridgeAppendConst(sink, "mut "))))
            || (document.TextAt(kindNode) == "globalconstant"
                ? !PackageImageSourceBridgeRenderConstGlobalType(
                    document.TextAt(typeNode),
                    sink)
                : !PackageImageSourceBridgeAppend(sink, document.TextAt(typeNode)))
            || !PackageImageSourceBridgeAppendConst(sink, " ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
            || (document.TextAt(kindNode) == "globalconstant"
                && (!PackageImageSourceBridgeAppendConst(sink, " = ")
                    || !PackageImageSourceBridgeRenderConstantInitializer(
                        document,
                        initializerNode,
                        0,
                        sink)))
            || !PackageImageSourceBridgeAppendConst(sink, ";\n"))
        {
            return false;
        }

        globalIndex = globalIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeAppendU32(
    mut borrow OwnedAscii sink,
    u32[0 max] value)
{
    switch (sink.AppendU64((u64[0 max])value))
    {
        case MemoryStatus.Err(var appendError):
            return false;
        case MemoryStatus.Ok:
            return true;
    }
}

internal fn bool PackageImageSourceBridgeRenderThreadSafetyLawAttributes(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownerNode,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] attributesNode = 0;
    stack mut u32[0 max] attributeCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            ownerNode,
            "ThreadSafetyLawAttributes",
            attributesNode,
            attributeCount))
    {
        return false;
    }

    stack mut u32[0 max] attributeIndex = 0;
    while willexit (attributeIndex < attributeCount)
    {
        stack mut u64[0 2 ** 63 - 1] attributeNode = 0;
        stack mut u64[0 2 ** 63 - 1] kindNode = 0;
        stack mut u64[0 2 ** 63 - 1] lawNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] conditionNode = 0;
        stack mut bool hasCondition = false;
        if (!document.TryChildAt(
                attributesNode,
                (u64[0 2 ** 63 - 1])attributeIndex,
                attributeNode)
            || document.KindAt(attributeNode) != JsonKind.Object
            || !document.TryFindMember(attributeNode, "Kind", kindNode)
            || document.KindAt(kindNode) != JsonKind.Text
            || (document.TextAt(kindNode) != "grant"
                && document.TextAt(kindNode) != "deny")
            || !document.TryFindMember(attributeNode, "LawName", lawNameNode)
            || document.KindAt(lawNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(lawNameNode)) == 0
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                attributeNode,
                "Condition",
                conditionNode,
                hasCondition)
            || !PackageImageSourceBridgeAppendConst(
                sink,
                document.TextAt(kindNode) == "deny" ? "[Deny(" : "[Grant(")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(lawNameNode))
            || !PackageImageSourceBridgeAppendConst(sink, ")"))
        {
            return false;
        }

        if (hasCondition)
        {
            stack mut u64[0 2 ** 63 - 1] conditionLawNode = 0;
            stack mut u64[0 2 ** 63 - 1] conditionTypeNode = 0;
            if (!document.TryFindMember(conditionNode, "LawName", conditionLawNode)
                || document.KindAt(conditionLawNode) != JsonKind.Text
                || AsciiLength(document.TextAt(conditionLawNode)) == 0
                || !document.TryFindMember(conditionNode, "Type", conditionTypeNode)
                || document.KindAt(conditionTypeNode) != JsonKind.Text
                || AsciiLength(document.TextAt(conditionTypeNode)) == 0
                || !PackageImageSourceBridgeAppendConst(sink, " where ")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(conditionLawNode))
                || !PackageImageSourceBridgeAppendConst(sink, "(")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(conditionTypeNode))
                || !PackageImageSourceBridgeAppendConst(sink, ")"))
            {
                return false;
            }
        }

        if (!PackageImageSourceBridgeAppendConst(sink, "] "))
        {
            return false;
        }

        attributeIndex = attributeIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderTypeField(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] fieldNode,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] nameNode = 0;
    stack mut u64[0 2 ** 63 - 1] typeNode = 0;
    stack mut u64[0 2 ** 63 - 1] visibilityNode = 0;
    stack mut bool hasVisibility = false;
    stack mut bool hasOffset = false;
    stack mut u32[0 max] offsetBytes = 0;
    if (!document.TryFindMember(fieldNode, "Name", nameNode)
        || document.KindAt(nameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(nameNode)) == 0
        || !document.TryFindMember(fieldNode, "Type", typeNode)
        || document.KindAt(typeNode) != JsonKind.Text
        || AsciiLength(document.TextAt(typeNode)) == 0
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            fieldNode,
            "Visibility",
            visibilityNode,
            hasVisibility)
        || !LogicalPackageImageJsonOptionalU32MemberValue(
            document,
            fieldNode,
            "ExplicitOffsetBytes",
            hasOffset,
            offsetBytes))
    {
        return false;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, "    "))
    {
        return false;
    }

    if (hasOffset
        && (!PackageImageSourceBridgeAppendConst(sink, "[FieldOffset(")
            || !PackageImageSourceBridgeAppendU32(sink, offsetBytes)
            || !PackageImageSourceBridgeAppendConst(sink, ")] ")))
    {
        return false;
    }

    if (!PackageImageSourceBridgeRenderThreadSafetyLawAttributes(document, fieldNode, sink))
    {
        return false;
    }

    if (hasVisibility
        && document.TextAt(visibilityNode) != "public"
        && (!PackageImageSourceBridgeAppend(sink, document.TextAt(visibilityNode))
            || !PackageImageSourceBridgeAppendConst(sink, " ")))
    {
        return false;
    }

    return PackageImageSourceBridgeAppend(sink, document.TextAt(typeNode))
        && PackageImageSourceBridgeAppendConst(sink, " ")
        && PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
        && PackageImageSourceBridgeAppendConst(sink, ";\n");
}

internal fn bool PackageImageSourceBridgeRenderPrimaryConstructorParameters(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] parametersNode,
    u32[0 max] parameterCount,
    mut borrow OwnedAscii sink)
{
    if (!PackageImageSourceBridgeAppendConst(sink, "("))
    {
        return false;
    }

    stack mut u32[0 max] parameterIndex = 0;
    while willexit (parameterIndex < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        if (!document.TryChildAt(
                parametersNode,
                (u64[0 2 ** 63 - 1])parameterIndex,
                parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || (parameterIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderFunctionParameter(
                document,
                parameterNode,
                false,
                sink))
        {
            return false;
        }

        parameterIndex = parameterIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ")");
}

internal fn bool PackageImageSourceBridgePrimaryConstructorContainsName(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] parametersNode,
    u32[0 max] parameterCount,
    ascii name,
    out bool contains)
    where overlap(document, name)
{
    contains = false;
    stack mut u32[0 max] parameterIndex = 0;
    while willexit (parameterIndex < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u64[0 2 ** 63 - 1] parameterNameNode = 0;
        if (!document.TryChildAt(
                parametersNode,
                (u64[0 2 ** 63 - 1])parameterIndex,
                parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || !document.TryFindMember(parameterNode, "Name", parameterNameNode)
            || document.KindAt(parameterNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(parameterNameNode)) == 0)
        {
            return false;
        }

        if (document.TextAt(parameterNameNode) == name)
        {
            contains = true;
            return true;
        }

        parameterIndex = parameterIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderImplementedTraits(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] traitsNode,
    u32[0 max] traitCount,
    mut borrow OwnedAscii sink)
{
    if (traitCount != 0
        && !PackageImageSourceBridgeAppendConst(sink, " : "))
    {
        return false;
    }

    stack mut u32[0 max] traitIndex = 0;
    while willexit (traitIndex < traitCount)
    {
        stack mut u64[0 2 ** 63 - 1] traitNode = 0;
        if (!document.TryChildAt(
                traitsNode,
                (u64[0 2 ** 63 - 1])traitIndex,
                traitNode)
            || document.KindAt(traitNode) != JsonKind.Text
            || AsciiLength(document.TextAt(traitNode)) == 0
            || (traitIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(traitNode)))
        {
            return false;
        }

        traitIndex = traitIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderAssociatedTypes(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] associatedTypesNode,
    u32[0 max] associatedTypeCount,
    mut borrow OwnedAscii sink)
{
    stack mut u32[0 max] associatedTypeIndex = 0;
    while willexit (associatedTypeIndex < associatedTypeCount)
    {
        stack mut u64[0 2 ** 63 - 1] associatedTypeNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] targetTypeNode = 0;
        stack mut bool hasTargetType = false;
        if (!document.TryChildAt(
                associatedTypesNode,
                (u64[0 2 ** 63 - 1])associatedTypeIndex,
                associatedTypeNode)
            || document.KindAt(associatedTypeNode) != JsonKind.Object
            || !document.TryFindMember(associatedTypeNode, "Name", nameNode)
            || document.KindAt(nameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(nameNode)) == 0
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                associatedTypeNode,
                "TargetType",
                targetTypeNode,
                hasTargetType)
            || !PackageImageSourceBridgeAppendConst(sink, "    alias ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
            || (hasTargetType
                && (!PackageImageSourceBridgeAppendConst(sink, " = ")
                    || !PackageImageSourceBridgeAppend(sink, document.TextAt(targetTypeNode))))
            || !PackageImageSourceBridgeAppendConst(sink, ";\n"))
        {
            return false;
        }

        associatedTypeIndex = associatedTypeIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderEnumVariant(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] variantNode,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] nameNode = 0;
    stack mut u64[0 2 ** 63 - 1] payloadsNode = 0;
    stack mut u32[0 max] payloadCount = 0;
    stack mut u64[0 2 ** 63 - 1] roleNode = 0;
    stack mut u64[0 2 ** 63 - 1] absorbsErrorTypeNode = 0;
    stack mut bool usesNamedFields = false;
    stack mut bool hasRole = false;
    stack mut bool hasAbsorbsErrorType = false;
    if (!document.TryFindMember(variantNode, "Name", nameNode)
        || document.KindAt(nameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(nameNode)) == 0
        || !LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            variantNode,
            "UsesNamedFields",
            usesNamedFields)
        || !LogicalPackageImageJsonRequiredArrayMember(
            document,
            variantNode,
            "Fields",
            payloadsNode,
            payloadCount)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            variantNode,
            "Role",
            roleNode,
            hasRole)
        || (hasRole
            && document.TextAt(roleNode) != "ok"
            && document.TextAt(roleNode) != "err")
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            variantNode,
            "AbsorbsErrorType",
            absorbsErrorTypeNode,
            hasAbsorbsErrorType)
        || (hasAbsorbsErrorType && (usesNamedFields || payloadCount != 1)))
    {
        return false;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, "    ")
        || (hasRole
            && ((!PackageImageSourceBridgeAppendConst(
                    sink,
                    document.TextAt(roleNode) == "ok" ? "[Ok] " : "[Err] "))))
        || !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode)))
    {
        return false;
    }

    if (hasAbsorbsErrorType)
    {
        stack mut u64[0 2 ** 63 - 1] payloadNode = 0;
        stack mut u64[0 2 ** 63 - 1] payloadTypeNode = 0;
        if (!document.TryChildAt(payloadsNode, 0, payloadNode)
            || document.KindAt(payloadNode) != JsonKind.Object
            || !document.TryFindMember(payloadNode, "Type", payloadTypeNode)
            || document.KindAt(payloadTypeNode) != JsonKind.Text
            || document.TextAt(payloadTypeNode) != document.TextAt(absorbsErrorTypeNode)
            || !PackageImageSourceBridgeAppendConst(sink, " from ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(absorbsErrorTypeNode)))
        {
            return false;
        }
    }
    else if (payloadCount != 0)
    {
        if (!PackageImageSourceBridgeAppendConst(sink, usesNamedFields ? " { " : "("))
        {
            return false;
        }

        stack mut u32[0 max] payloadIndex = 0;
        while willexit (payloadIndex < payloadCount)
        {
            stack mut u64[0 2 ** 63 - 1] payloadNode = 0;
            stack mut u64[0 2 ** 63 - 1] payloadNameNode = 0;
            stack mut u64[0 2 ** 63 - 1] payloadTypeNode = 0;
            if (!document.TryChildAt(
                    payloadsNode,
                    (u64[0 2 ** 63 - 1])payloadIndex,
                    payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object
                || !document.TryFindMember(payloadNode, "Type", payloadTypeNode)
                || document.KindAt(payloadTypeNode) != JsonKind.Text
                || AsciiLength(document.TextAt(payloadTypeNode)) == 0
                || (usesNamedFields
                    && (!document.TryFindMember(payloadNode, "Name", payloadNameNode)
                        || document.KindAt(payloadNameNode) != JsonKind.Text
                        || AsciiLength(document.TextAt(payloadNameNode)) == 0))
                || (payloadIndex != 0
                    && !PackageImageSourceBridgeAppendConst(sink, ", "))
                || (usesNamedFields
                    && (!PackageImageSourceBridgeAppend(sink, document.TextAt(payloadNameNode))
                        || !PackageImageSourceBridgeAppendConst(sink, ": ")))
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(payloadTypeNode)))
            {
                return false;
            }

            payloadIndex = payloadIndex + 1;
        }

        if (!PackageImageSourceBridgeAppendConst(sink, usesNamedFields ? " }" : ")"))
        {
            return false;
        }
    }

    return PackageImageSourceBridgeAppendConst(sink, ",\n");
}

internal fn bool PackageImageSourceBridgeRenderConstructor(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] constructorNode,
    ascii typeName,
    mut borrow OwnedAscii sink)
    where overlap(document, typeName)
{
    stack mut u64[0 2 ** 63 - 1] parametersNode = 0;
    stack mut u32[0 max] parameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] bodyNode = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(
            document,
            constructorNode,
            "Parameters",
            parametersNode,
            parameterCount)
        || !document.TryFindMember(constructorNode, "BodyText", bodyNode)
        || document.KindAt(bodyNode) != JsonKind.Text
        || AsciiLength(document.TextAt(bodyNode)) == 0
        || !PackageImageSourceBridgeAppendConst(sink, "    ")
        || !PackageImageSourceBridgeAppend(sink, typeName)
        || !PackageImageSourceBridgeAppendConst(sink, "("))
    {
        return false;
    }

    stack mut u32[0 max] parameterIndex = 0;
    while willexit (parameterIndex < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        if (!document.TryChildAt(
                parametersNode,
                (u64[0 2 ** 63 - 1])parameterIndex,
                parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || (parameterIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderFunctionParameter(
                document,
                parameterNode,
                false,
                sink))
        {
            return false;
        }

        parameterIndex = parameterIndex + 1;
    }

    return PackageImageSourceBridgeAppendConst(sink, ") ")
        && PackageImageSourceBridgeAppend(sink, document.TextAt(bodyNode))
        && PackageImageSourceBridgeAppendConst(sink, "\n");
}

internal fn bool PackageImageSourceBridgeRenderDestructor(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] destructorNode,
    mut borrow OwnedAscii sink)
{
    stack mut bool isMutable = false;
    stack mut u64[0 2 ** 63 - 1] bodyNode = 0;
    return LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            destructorNode,
            "IsMutable",
            isMutable)
        && document.TryFindMember(destructorNode, "BodyText", bodyNode)
        && document.KindAt(bodyNode) == JsonKind.Text
        && AsciiLength(document.TextAt(bodyNode)) != 0
        && PackageImageSourceBridgeAppendConst(sink, "    ")
        && (!isMutable || PackageImageSourceBridgeAppendConst(sink, "mut "))
        && PackageImageSourceBridgeAppendConst(sink, "drop ")
        && PackageImageSourceBridgeAppend(sink, document.TextAt(bodyNode))
        && PackageImageSourceBridgeAppendConst(sink, "\n");
}

internal fn bool PackageImageSourceBridgeRenderMethod(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] methodNode,
    bool supportsVisibility,
    borrow PackageImageSourceBridgeTemplateContext templateContext,
    mut borrow OwnedAscii overloadKeyScratch,
    mut borrow OwnedAscii typedBodyScratch,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] nameNode = 0;
    stack mut u64[0 2 ** 63 - 1] qualifiedNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] symbolNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] kindNode = 0;
    stack mut u64[0 2 ** 63 - 1] returnTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] parametersNode = 0;
    stack mut u32[0 max] parameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] visibilityNode = 0;
    stack mut u64[0 2 ** 63 - 1] inlineNode = 0;
    stack mut u64[0 2 ** 63 - 1] ffiAbiNode = 0;
    stack mut u64[0 2 ** 63 - 1] backendNode = 0;
    stack mut u64[0 2 ** 63 - 1] deadNamesNode = 0;
    stack mut u32[0 max] deadNameCount = 0;
    stack mut bool hasVisibility = false;
    stack mut bool hasInline = false;
    stack mut bool hasFfiAbi = false;
    stack mut bool hasBackend = false;
    stack mut bool isFfi = false;
    stack mut bool isStrictFp = false;
    stack mut bool useFastCallingConvention = false;
    stack mut bool isHot = false;
    stack mut bool isCold = false;
    stack mut bool hasExplicitInlinePreference = false;
    stack mut bool isStatic = false;
    stack mut bool isUnsafe = false;
    stack mut bool isVarargs = false;
    stack mut bool isTailCallable = false;
    if (!document.TryFindMember(methodNode, "Name", nameNode)
        || document.KindAt(nameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(nameNode)) == 0
        || !document.TryFindMember(methodNode, "QualifiedName", qualifiedNameNode)
        || document.KindAt(qualifiedNameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(qualifiedNameNode)) == 0
        || !document.TryFindMember(methodNode, "SymbolName", symbolNameNode)
        || document.KindAt(symbolNameNode) != JsonKind.Text
        || AsciiLength(document.TextAt(symbolNameNode)) == 0
        || !document.TryFindMember(methodNode, "Kind", kindNode)
        || document.KindAt(kindNode) != JsonKind.Text
        || AsciiLength(document.TextAt(kindNode)) == 0
        || !document.TryFindMember(methodNode, "ReturnType", returnTypeNode)
        || document.KindAt(returnTypeNode) != JsonKind.Text
        || AsciiLength(document.TextAt(returnTypeNode)) == 0
        || !LogicalPackageImageJsonRequiredArrayMember(
            document,
            methodNode,
            "Parameters",
            parametersNode,
            parameterCount)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            methodNode,
            "Visibility",
            visibilityNode,
            hasVisibility)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            methodNode,
            "InlinePreference",
            inlineNode,
            hasInline)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            methodNode,
            "FfiAbi",
            ffiAbiNode,
            hasFfiAbi)
        || !PackageImageSourceBridgeOptionalTextMemberNode(
            document,
            methodNode,
            "BackendOptimizationMode",
            backendNode,
            hasBackend)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            methodNode,
            "PointeeDeadOnReturnParameterNames",
            deadNamesNode,
            deadNameCount)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(document, methodNode, "IsFfi", isFfi)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            methodNode,
            "IsStrictFp",
            isStrictFp)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            methodNode,
            "UseFastCallingConvention",
            useFastCallingConvention)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, methodNode, "IsHot", isHot)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, methodNode, "IsCold", isCold)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            methodNode,
            "HasExplicitInlinePreference",
            hasExplicitInlinePreference)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, methodNode, "IsStatic", isStatic)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, methodNode, "IsUnsafe", isUnsafe)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, methodNode, "IsVarargs", isVarargs)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            methodNode,
            "IsTailCallable",
            isTailCallable)
        || useFastCallingConvention
        || (isHot && isCold)
        || (hasExplicitInlinePreference && !hasInline)
        || (hasInline
            && document.TextAt(inlineNode) != "inline"
            && document.TextAt(inlineNode) != "noinline"
            && document.TextAt(inlineNode) != "inlinehint")
        || (hasFfiAbi && !isFfi)
        || (isVarargs && !isFfi)
        || (hasBackend && document.TextAt(backendNode) != "opaque"))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] bodyTextNode = 0;
    stack mut bool hasBodyText = false;
    stack mut bool hasTypedBodyText = false;
    if (!PackageImageSourceBridgePrepareTemplateBody(
            document,
            templateContext,
            methodNode,
            overloadKeyScratch,
            typedBodyScratch,
            bodyTextNode,
            hasBodyText,
            hasTypedBodyText)
        || ((hasBodyText || hasTypedBodyText) && isFfi))
    {
        return false;
    }

    if (hasBackend
        && (!PackageImageSourceBridgeAppendConst(sink, "    [Backend(Opaque)]\n")))
    {
        return false;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, "    ")
        || (supportsVisibility && hasVisibility
            && (!PackageImageSourceBridgeAppend(sink, document.TextAt(visibilityNode))
                || !PackageImageSourceBridgeAppendConst(sink, " ")))
        || (isStatic && !PackageImageSourceBridgeAppendConst(sink, "static "))
        || (isStrictFp && !PackageImageSourceBridgeAppendConst(sink, "strictfp "))
        || (isHot && !PackageImageSourceBridgeAppendConst(sink, "hot "))
        || (isCold && !PackageImageSourceBridgeAppendConst(sink, "cold "))
        || (hasExplicitInlinePreference
            && (!PackageImageSourceBridgeAppend(sink, document.TextAt(inlineNode))
                || !PackageImageSourceBridgeAppendConst(sink, " ")))
        || (isUnsafe && !PackageImageSourceBridgeAppendConst(sink, "unsafe "))
        || (isFfi
            && (!PackageImageSourceBridgeAppendConst(sink, "ffi")
                || (hasFfiAbi
                    && (!PackageImageSourceBridgeAppendConst(sink, "(")
                        || !PackageImageSourceBridgeAppend(sink, document.TextAt(ffiAbiNode))
                        || !PackageImageSourceBridgeAppendConst(sink, ")")))
                || !PackageImageSourceBridgeAppendConst(sink, " ")))
        || (isVarargs && !PackageImageSourceBridgeAppendConst(sink, "varargs "))
        || (isTailCallable && !PackageImageSourceBridgeAppendConst(sink, "tail "))
        || !PackageImageSourceBridgeAppend(sink, document.TextAt(kindNode))
        || !PackageImageSourceBridgeAppendConst(sink, " ")
        || !PackageImageSourceBridgeAppend(sink, document.TextAt(returnTypeNode))
        || !PackageImageSourceBridgeAppendConst(sink, " ")
        || !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
        || !PackageImageSourceBridgeRenderGenericParameters(document, methodNode, sink)
        || !PackageImageSourceBridgeAppendConst(sink, "("))
    {
        return false;
    }

    stack mut u32[0 max] parameterIndex = 0;
    while willexit (parameterIndex < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        if (!document.TryChildAt(
                parametersNode,
                (u64[0 2 ** 63 - 1])parameterIndex,
                parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || (parameterIndex != 0
                && !PackageImageSourceBridgeAppendConst(sink, ", "))
            || !PackageImageSourceBridgeRenderFunctionParameter(
                document,
                parameterNode,
                isFfi,
                sink))
        {
            return false;
        }

        parameterIndex = parameterIndex + 1;
    }

    if (!PackageImageSourceBridgeAppendConst(sink, ")")
        || !PackageImageSourceBridgeRenderTypeParameterConstraints(document, methodNode, sink)
        || !PackageImageSourceBridgeRenderParameterMemoryContractGroups(
            document,
            methodNode,
            "DisjointParameterGroups",
            "disjoint",
            isFfi,
            true,
            sink)
        || !PackageImageSourceBridgeRenderParameterMemoryContractGroups(
            document,
            methodNode,
            "OverlapParameterGroups",
            "overlap",
            isFfi,
            false,
            sink)
        || !PackageImageSourceBridgeRenderParameterMemoryContractGroups(
            document,
            methodNode,
            "SameParameterGroups",
            "same",
            isFfi,
            false,
            sink))
    {
        return false;
    }

    stack mut u32[0 max] deadNameIndex = 0;
    while willexit (deadNameIndex < deadNameCount)
    {
        stack mut u64[0 2 ** 63 - 1] deadNameNode = 0;
        if (!document.TryChildAt(
                deadNamesNode,
                (u64[0 2 ** 63 - 1])deadNameIndex,
                deadNameNode)
            || document.KindAt(deadNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(deadNameNode)) == 0
            || !PackageImageSourceBridgeAppendConst(sink, " where dead_on_return(")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(deadNameNode))
            || !PackageImageSourceBridgeAppendConst(sink, ")"))
        {
            return false;
        }

        deadNameIndex = deadNameIndex + 1;
    }

    if (!PackageImageSourceBridgeRenderThreadSafetyLawPredicates(document, methodNode, sink)
        || !PackageImageSourceBridgeRenderValueContracts(document, methodNode, sink))
    {
        return false;
    }

    if (hasTypedBodyText)
    {
        return PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeAppend(sink, typedBodyScratch.View())
            && PackageImageSourceBridgeAppendConst(sink, "\n");
    }

    if (hasBodyText)
    {
        return PackageImageSourceBridgeAppendConst(sink, " ")
            && PackageImageSourceBridgeAppend(sink, document.TextAt(bodyTextNode))
            && PackageImageSourceBridgeAppendConst(sink, "\n");
    }

    return PackageImageSourceBridgeAppendConst(sink, ";\n");
}

internal fn bool PackageImageSourceBridgeRenderTypes(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    borrow PackageImageSourceBridgeTemplateContext templateContext,
    mut borrow OwnedAscii overloadKeyScratch,
    mut borrow OwnedAscii typedBodyScratch,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] typesNode = 0;
    stack mut u32[0 max] typeCount = 0;
    if (!LogicalPackageImageJsonSourceSurfaceTypeNodes(
            document,
            moduleNode,
            typesNode,
            typeCount))
    {
        return false;
    }

    stack mut u32[0 max] typeIndex = 0;
    while willexit (typeIndex < typeCount)
    {
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] qualifiedNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] visibilityNode = 0;
        stack mut u64[0 2 ** 63 - 1] kindNode = 0;
        stack mut u64[0 2 ** 63 - 1] fieldsNode = 0;
        stack mut u32[0 max] fieldCount = 0;
        stack mut u64[0 2 ** 63 - 1] primaryConstructorParametersNode = 0;
        stack mut u32[0 max] primaryConstructorParameterCount = 0;
        stack mut u64[0 2 ** 63 - 1] variantsNode = 0;
        stack mut u32[0 max] variantCount = 0;
        stack mut u64[0 2 ** 63 - 1] associatedTypesNode = 0;
        stack mut u32[0 max] associatedTypeCount = 0;
        stack mut u64[0 2 ** 63 - 1] implementedTraitsNode = 0;
        stack mut u32[0 max] implementedTraitCount = 0;
        stack mut u64[0 2 ** 63 - 1] methodsNode = 0;
        stack mut u32[0 max] methodCount = 0;
        stack mut u64[0 2 ** 63 - 1] constructorsNode = 0;
        stack mut u32[0 max] constructorCount = 0;
        stack mut u64[0 2 ** 63 - 1] backendNode = 0;
        stack mut u64[0 2 ** 63 - 1] layoutNode = 0;
        stack mut bool hasBackend = false;
        stack mut bool hasLayout = false;
        stack mut bool hasPack = false;
        stack mut bool hasAlign = false;
        stack mut u32[0 max] packBytes = 0;
        stack mut u32[0 max] alignBytes = 0;
        stack mut u64[0 2 ** 63 - 1] destructorNode = 0;
        stack mut bool hasDestructor = false;
        stack mut bool isDynTrait = false;
        if (!document.TryChildAt(
                typesNode,
                (u64[0 2 ** 63 - 1])typeIndex,
                typeNode)
            || document.KindAt(typeNode) != JsonKind.Object
            || !document.TryFindMember(typeNode, "Name", nameNode)
            || document.KindAt(nameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(nameNode)) == 0
            || !document.TryFindMember(typeNode, "QualifiedName", qualifiedNameNode)
            || document.KindAt(qualifiedNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(qualifiedNameNode)) == 0
            || !document.TryFindMember(typeNode, "Visibility", visibilityNode)
            || document.KindAt(visibilityNode) != JsonKind.Text
            || AsciiLength(document.TextAt(visibilityNode)) == 0
            || !document.TryFindMember(typeNode, "Kind", kindNode)
            || document.KindAt(kindNode) != JsonKind.Text
            || (document.TextAt(kindNode) != "struct"
                && document.TextAt(kindNode) != "record"
                && document.TextAt(kindNode) != "enum"
                && document.TextAt(kindNode) != "trait"
                && document.TextAt(kindNode) != "doctrine")
            || !LogicalPackageImageJsonRequiredArrayMember(
                document,
                typeNode,
                "Fields",
                fieldsNode,
                fieldCount)
            || (document.TextAt(kindNode) == "trait" && fieldCount != 0)
            || (document.TextAt(kindNode) == "doctrine" && fieldCount != 0)
            || (document.TextAt(kindNode) == "enum" && fieldCount != 0)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                typeNode,
                "BackendOptimizationMode",
                backendNode,
                hasBackend)
            || (hasBackend && document.TextAt(backendNode) != "opaque")
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                typeNode,
                "StructLayout",
                layoutNode,
                hasLayout)
            || (hasLayout
                && document.TextAt(layoutNode) != "Auto"
                && document.TextAt(layoutNode) != "C"
                && document.TextAt(layoutNode) != "Explicit")
            || !LogicalPackageImageJsonOptionalU32MemberValue(
                document,
                typeNode,
                "PackBytes",
                hasPack,
                packBytes)
            || !LogicalPackageImageJsonOptionalU32MemberValue(
                document,
                typeNode,
                "AlignBytes",
                hasAlign,
                alignBytes)
            || ((hasPack || hasAlign) && !hasLayout)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                typeNode,
                "Destructor",
                destructorNode,
                hasDestructor)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                typeNode,
                "IsDynTrait",
                isDynTrait)
            || (isDynTrait && document.TextAt(kindNode) != "trait")
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                typeNode,
                "PrimaryConstructorParameters",
                primaryConstructorParametersNode,
                primaryConstructorParameterCount)
            || (primaryConstructorParameterCount != 0
                && document.TextAt(kindNode) != "record")
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                typeNode,
                "Variants",
                variantsNode,
                variantCount)
            || (document.TextAt(kindNode) == "enum" && variantCount == 0)
            || (document.TextAt(kindNode) != "enum" && variantCount != 0)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                typeNode,
                "Methods",
                methodsNode,
                methodCount)
            || (methodCount != 0 && document.TextAt(kindNode) == "enum")
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                typeNode,
                "Constructors",
                constructorsNode,
                constructorCount)
            || (constructorCount != 0
                && document.TextAt(kindNode) != "struct"
                && document.TextAt(kindNode) != "record")
            || (hasDestructor
                && document.TextAt(kindNode) != "struct"
                && document.TextAt(kindNode) != "record")
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                typeNode,
                "AssociatedTypes",
                associatedTypesNode,
                associatedTypeCount)
            || (associatedTypeCount != 0 && document.TextAt(kindNode) == "enum")
            || (isDynTrait && associatedTypeCount != 0)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                typeNode,
                "ImplementedTraits",
                implementedTraitsNode,
                implementedTraitCount)
            || (implementedTraitCount != 0
                && document.TextAt(kindNode) != "struct"
                && document.TextAt(kindNode) != "record"))
        {
            return false;
        }

        if (typeIndex == 0
            && !PackageImageSourceBridgeAppendConst(sink, "\n"))
        {
            return false;
        }

        if (hasBackend
            && !PackageImageSourceBridgeAppendConst(sink, "[Backend(Opaque)]\n"))
        {
            return false;
        }

        if (hasLayout)
        {
            if (!PackageImageSourceBridgeAppendConst(sink, "[StructLayout(")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(layoutNode))
                || (hasPack
                    && (!PackageImageSourceBridgeAppendConst(sink, "), Pack(")
                        || !PackageImageSourceBridgeAppendU32(sink, packBytes)))
                || (hasAlign
                    && (!PackageImageSourceBridgeAppendConst(sink, "), Align(")
                        || !PackageImageSourceBridgeAppendU32(sink, alignBytes)))
                || !PackageImageSourceBridgeAppendConst(sink, ")]\n"))
            {
                return false;
            }
        }

        if (!PackageImageSourceBridgeRenderThreadSafetyLawAttributes(document, typeNode, sink)
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(visibilityNode))
            || !PackageImageSourceBridgeAppendConst(sink, " ")
            || (isDynTrait
                && !PackageImageSourceBridgeAppendConst(sink, "dyn "))
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(kindNode))
            || !PackageImageSourceBridgeAppendConst(sink, " ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
            || !PackageImageSourceBridgeRenderGenericParameters(document, typeNode, sink)
            || (primaryConstructorParameterCount != 0
                && !PackageImageSourceBridgeRenderPrimaryConstructorParameters(
                    document,
                    primaryConstructorParametersNode,
                    primaryConstructorParameterCount,
                    sink))
            || !PackageImageSourceBridgeRenderImplementedTraits(
                document,
                implementedTraitsNode,
                implementedTraitCount,
                sink)
            || !PackageImageSourceBridgeAppendConst(sink, "\n{\n"))
        {
            return false;
        }

        if (document.TextAt(kindNode) == "enum")
        {
            stack mut u32[0 max] variantIndex = 0;
            while willexit (variantIndex < variantCount)
            {
                stack mut u64[0 2 ** 63 - 1] variantNode = 0;
                if (!document.TryChildAt(
                        variantsNode,
                        (u64[0 2 ** 63 - 1])variantIndex,
                        variantNode)
                    || document.KindAt(variantNode) != JsonKind.Object
                    || !PackageImageSourceBridgeRenderEnumVariant(document, variantNode, sink))
                {
                    return false;
                }

                variantIndex = variantIndex + 1;
            }
        }
        else
        {
            if (!PackageImageSourceBridgeRenderAssociatedTypes(
                    document,
                    associatedTypesNode,
                    associatedTypeCount,
                    sink)
                || (associatedTypeCount != 0
                    && fieldCount != 0
                    && !PackageImageSourceBridgeAppendConst(sink, "\n")))
            {
                return false;
            }

            stack mut u32[0 max] fieldIndex = 0;
            while willexit (fieldIndex < fieldCount)
            {
                stack mut u64[0 2 ** 63 - 1] fieldNode = 0;
                stack mut u64[0 2 ** 63 - 1] fieldNameNode = 0;
                stack mut bool isPrimaryConstructorField = false;
                if (!document.TryChildAt(
                        fieldsNode,
                        (u64[0 2 ** 63 - 1])fieldIndex,
                        fieldNode)
                    || document.KindAt(fieldNode) != JsonKind.Object
                    || !document.TryFindMember(fieldNode, "Name", fieldNameNode)
                    || document.KindAt(fieldNameNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(fieldNameNode)) == 0)
                {
                    return false;
                }

                stack ascii fieldName = document.TextAt(fieldNameNode);
                if (!PackageImageSourceBridgePrimaryConstructorContainsName(
                        document,
                        primaryConstructorParametersNode,
                        primaryConstructorParameterCount,
                        fieldName,
                        isPrimaryConstructorField)
                    || (!isPrimaryConstructorField
                        && !PackageImageSourceBridgeRenderTypeField(document, fieldNode, sink)))
                {
                    return false;
                }

                fieldIndex = fieldIndex + 1;
            }

            if (constructorCount != 0
                && (fieldCount != 0 || associatedTypeCount != 0)
                && !PackageImageSourceBridgeAppendConst(sink, "\n"))
            {
                return false;
            }

            stack ascii renderedTypeName = document.TextAt(nameNode);
            stack mut u32[0 max] constructorIndex = 0;
            while willexit (constructorIndex < constructorCount)
            {
                stack mut u64[0 2 ** 63 - 1] constructorNode = 0;
                if (!document.TryChildAt(
                        constructorsNode,
                        (u64[0 2 ** 63 - 1])constructorIndex,
                        constructorNode)
                    || document.KindAt(constructorNode) != JsonKind.Object
                    || !PackageImageSourceBridgeRenderConstructor(
                        document,
                        constructorNode,
                        renderedTypeName,
                        sink))
                {
                    return false;
                }

                constructorIndex = constructorIndex + 1;
            }

            if (hasDestructor
                && ((constructorCount != 0 || fieldCount != 0 || associatedTypeCount != 0)
                    && !PackageImageSourceBridgeAppendConst(sink, "\n")))
            {
                return false;
            }

            if (hasDestructor
                && !PackageImageSourceBridgeRenderDestructor(document, destructorNode, sink))
            {
                return false;
            }

            if (methodCount != 0
                && (hasDestructor
                    || constructorCount != 0
                    || fieldCount != 0
                    || associatedTypeCount != 0)
                && !PackageImageSourceBridgeAppendConst(sink, "\n"))
            {
                return false;
            }

            stack bool supportsMemberVisibility = document.TextAt(kindNode) == "struct"
                || document.TextAt(kindNode) == "record";
            stack mut u32[0 max] methodIndex = 0;
            while willexit (methodIndex < methodCount)
            {
                stack mut u64[0 2 ** 63 - 1] methodNode = 0;
                if (!document.TryChildAt(
                        methodsNode,
                        (u64[0 2 ** 63 - 1])methodIndex,
                        methodNode)
                    || document.KindAt(methodNode) != JsonKind.Object
                    || !PackageImageSourceBridgeRenderMethod(
                        document,
                        methodNode,
                        supportsMemberVisibility,
                        templateContext,
                        overloadKeyScratch,
                        typedBodyScratch,
                        sink))
                {
                    return false;
                }

                methodIndex = methodIndex + 1;
            }
        }

        if (!PackageImageSourceBridgeAppendConst(sink, "}\n"))
        {
            return false;
        }

        typeIndex = typeIndex + 1;
    }

    return true;
}

internal fn bool PackageImageSourceBridgeRenderFunctions(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    borrow PackageImageSourceBridgeTemplateContext templateContext,
    mut borrow OwnedAscii overloadKeyScratch,
    mut borrow OwnedAscii typedBodyScratch,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] functionsNode = 0;
    stack mut u32[0 max] functionCount = 0;
    if (!LogicalPackageImageJsonSourceSurfaceFunctionNodes(
            document,
            moduleNode,
            functionsNode,
            functionCount))
    {
        return false;
    }

    stack mut u32[0 max] functionIndex = 0;
    while willexit (functionIndex < functionCount)
    {
        stack mut u64[0 2 ** 63 - 1] functionNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] qualifiedNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] visibilityNode = 0;
        stack mut u64[0 2 ** 63 - 1] symbolNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] kindNode = 0;
        stack mut u64[0 2 ** 63 - 1] returnTypeNode = 0;
        stack mut u64[0 2 ** 63 - 1] parametersNode = 0;
        stack mut u32[0 max] parameterCount = 0;
        stack mut u64[0 2 ** 63 - 1] inlineNode = 0;
        stack mut u64[0 2 ** 63 - 1] ffiAbiNode = 0;
        stack mut u64[0 2 ** 63 - 1] backendNode = 0;
        stack mut u64[0 2 ** 63 - 1] linkNameNode = 0;
        stack mut u64[0 2 ** 63 - 1] deadNamesNode = 0;
        stack mut u32[0 max] deadNameCount = 0;
        stack mut bool hasInline = false;
        stack mut bool hasFfiAbi = false;
        stack mut bool hasBackend = false;
        stack mut bool hasLinkName = false;
        stack mut bool isFfi = false;
        stack mut bool isStrictFp = false;
        stack mut bool useFastCallingConvention = false;
        stack mut bool isHot = false;
        stack mut bool isCold = false;
        stack mut bool hasExplicitInlinePreference = false;
        stack mut bool isUnsafe = false;
        stack mut bool isVarargs = false;
        stack mut bool isTailCallable = false;
        stack mut u64[0 2 ** 63 - 1] asmNode = 0;
        stack mut bool hasAsm = false;
        if (!document.TryChildAt(
                functionsNode,
                (u64[0 2 ** 63 - 1])functionIndex,
                functionNode)
            || document.KindAt(functionNode) != JsonKind.Object
            || !document.TryFindMember(functionNode, "Name", nameNode)
            || document.KindAt(nameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(nameNode)) == 0
            || !document.TryFindMember(functionNode, "QualifiedName", qualifiedNameNode)
            || document.KindAt(qualifiedNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(qualifiedNameNode)) == 0
            || !document.TryFindMember(functionNode, "Visibility", visibilityNode)
            || document.KindAt(visibilityNode) != JsonKind.Text
            || AsciiLength(document.TextAt(visibilityNode)) == 0
            || !document.TryFindMember(functionNode, "SymbolName", symbolNameNode)
            || document.KindAt(symbolNameNode) != JsonKind.Text
            || AsciiLength(document.TextAt(symbolNameNode)) == 0
            || !document.TryFindMember(functionNode, "Kind", kindNode)
            || document.KindAt(kindNode) != JsonKind.Text
            || AsciiLength(document.TextAt(kindNode)) == 0
            || !document.TryFindMember(functionNode, "ReturnType", returnTypeNode)
            || document.KindAt(returnTypeNode) != JsonKind.Text
            || AsciiLength(document.TextAt(returnTypeNode)) == 0
            || !LogicalPackageImageJsonRequiredArrayMember(
                document,
                functionNode,
                "Parameters",
                parametersNode,
                parameterCount)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                functionNode,
                "InlinePreference",
                inlineNode,
                hasInline)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                functionNode,
                "FfiAbi",
                ffiAbiNode,
                hasFfiAbi)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                functionNode,
                "BackendOptimizationMode",
                backendNode,
                hasBackend)
            || !PackageImageSourceBridgeOptionalTextMemberNode(
                document,
                functionNode,
                "LinkName",
                linkNameNode,
                hasLinkName)
            || !LogicalPackageImageJsonRequiredBoolMemberValue(document, functionNode, "IsFfi", isFfi)
            || !LogicalPackageImageJsonRequiredBoolMemberValue(
                document,
                functionNode,
                "IsStrictFp",
                isStrictFp)
            || !LogicalPackageImageJsonRequiredBoolMemberValue(
                document,
                functionNode,
                "UseFastCallingConvention",
                useFastCallingConvention)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(document, functionNode, "IsHot", isHot)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(document, functionNode, "IsCold", isCold)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                functionNode,
                "HasExplicitInlinePreference",
                hasExplicitInlinePreference)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                functionNode,
                "IsUnsafe",
                isUnsafe)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                functionNode,
                "IsVarargs",
                isVarargs)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                functionNode,
                "IsTailCallable",
                isTailCallable)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                functionNode,
                "Asm",
                asmNode,
                hasAsm)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                functionNode,
                "PointeeDeadOnReturnParameterNames",
                deadNamesNode,
                deadNameCount)
            || hasAsm
            || useFastCallingConvention
            || (isHot && isCold)
            || (hasExplicitInlinePreference && !hasInline)
            || (hasInline
                && document.TextAt(inlineNode) != "inline"
                && document.TextAt(inlineNode) != "noinline"
                && document.TextAt(inlineNode) != "inlinehint")
            || (hasFfiAbi && !isFfi)
            || (hasLinkName && !isFfi)
            || (isVarargs && !isFfi)
            || (hasBackend && document.TextAt(backendNode) != "opaque"))
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] bodyTextNode = 0;
        stack mut bool hasBodyText = false;
        stack mut bool hasTypedBodyText = false;
        if (!PackageImageSourceBridgePrepareTemplateBody(
                document,
                templateContext,
                functionNode,
                overloadKeyScratch,
                typedBodyScratch,
                bodyTextNode,
                hasBodyText,
                hasTypedBodyText)
            || ((hasBodyText || hasTypedBodyText) && isFfi))
        {
            return false;
        }

        if (functionIndex == 0
            && !PackageImageSourceBridgeAppendConst(sink, "\n"))
        {
            return false;
        }

        if (hasLinkName
            && (!PackageImageSourceBridgeAppendConst(sink, "[LinkName(\"")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(linkNameNode))
                || !PackageImageSourceBridgeAppendConst(sink, "\")]\n")))
        {
            return false;
        }

        if (hasBackend
            && !PackageImageSourceBridgeAppendConst(sink, "[Backend(Opaque)]\n"))
        {
            return false;
        }

        if (!PackageImageSourceBridgeAppend(sink, document.TextAt(visibilityNode))
            || !PackageImageSourceBridgeAppendConst(sink, " ")
            || (isStrictFp && !PackageImageSourceBridgeAppendConst(sink, "strictfp "))
            || (isHot && !PackageImageSourceBridgeAppendConst(sink, "hot "))
            || (isCold && !PackageImageSourceBridgeAppendConst(sink, "cold "))
            || (hasExplicitInlinePreference
                && (!PackageImageSourceBridgeAppend(sink, document.TextAt(inlineNode))
                    || !PackageImageSourceBridgeAppendConst(sink, " ")))
            || (isUnsafe && !PackageImageSourceBridgeAppendConst(sink, "unsafe "))
            || (isFfi
                && (!PackageImageSourceBridgeAppendConst(sink, "ffi")
                    || (hasFfiAbi
                        && (!PackageImageSourceBridgeAppendConst(sink, "(")
                            || !PackageImageSourceBridgeAppend(sink, document.TextAt(ffiAbiNode))
                            || !PackageImageSourceBridgeAppendConst(sink, ")")))
                    || !PackageImageSourceBridgeAppendConst(sink, " ")))
            || (isVarargs && !PackageImageSourceBridgeAppendConst(sink, "varargs "))
            || (isTailCallable && !PackageImageSourceBridgeAppendConst(sink, "tail "))
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(kindNode))
            || !PackageImageSourceBridgeAppendConst(sink, " ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(returnTypeNode))
            || !PackageImageSourceBridgeAppendConst(sink, " ")
            || !PackageImageSourceBridgeAppend(sink, document.TextAt(nameNode))
            || !PackageImageSourceBridgeRenderGenericParameters(document, functionNode, sink)
            || !PackageImageSourceBridgeAppendConst(sink, "("))
        {
            return false;
        }

        stack mut u32[0 max] parameterIndex = 0;
        while willexit (parameterIndex < parameterCount)
        {
            stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
            if (!document.TryChildAt(
                    parametersNode,
                    (u64[0 2 ** 63 - 1])parameterIndex,
                    parameterNode)
                || document.KindAt(parameterNode) != JsonKind.Object
                || (parameterIndex != 0
                    && !PackageImageSourceBridgeAppendConst(sink, ", "))
                || !PackageImageSourceBridgeRenderFunctionParameter(
                    document,
                    parameterNode,
                    isFfi,
                    sink))
            {
                return false;
            }

            parameterIndex = parameterIndex + 1;
        }

        if (!PackageImageSourceBridgeAppendConst(sink, ")"))
        {
            return false;
        }

        if (!PackageImageSourceBridgeRenderTypeParameterConstraints(
                document,
                functionNode,
                sink)
            || !PackageImageSourceBridgeRenderParameterMemoryContractGroups(
                document,
                functionNode,
                "DisjointParameterGroups",
                "disjoint",
                isFfi,
                true,
                sink)
            || !PackageImageSourceBridgeRenderParameterMemoryContractGroups(
                document,
                functionNode,
                "OverlapParameterGroups",
                "overlap",
                isFfi,
                false,
                sink)
            || !PackageImageSourceBridgeRenderParameterMemoryContractGroups(
                document,
                functionNode,
                "SameParameterGroups",
                "same",
                isFfi,
                false,
                sink))
        {
            return false;
        }

        stack mut u32[0 max] deadNameIndex = 0;
        while willexit (deadNameIndex < deadNameCount)
        {
            stack mut u64[0 2 ** 63 - 1] deadNameNode = 0;
            if (!document.TryChildAt(
                    deadNamesNode,
                    (u64[0 2 ** 63 - 1])deadNameIndex,
                    deadNameNode)
                || document.KindAt(deadNameNode) != JsonKind.Text
                || AsciiLength(document.TextAt(deadNameNode)) == 0
                || !PackageImageSourceBridgeAppendConst(sink, " where dead_on_return(")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(deadNameNode))
                || !PackageImageSourceBridgeAppendConst(sink, ")"))
            {
                return false;
            }

            deadNameIndex = deadNameIndex + 1;
        }

        if (!PackageImageSourceBridgeRenderThreadSafetyLawPredicates(
                document,
                functionNode,
                sink)
            || !PackageImageSourceBridgeRenderValueContracts(
                document,
                functionNode,
                sink))
        {
            return false;
        }

        if (hasTypedBodyText
            ? (!PackageImageSourceBridgeAppendConst(sink, " ")
                || !PackageImageSourceBridgeAppend(sink, typedBodyScratch.View())
                || !PackageImageSourceBridgeAppendConst(sink, "\n"))
            : hasBodyText
                ? (!PackageImageSourceBridgeAppendConst(sink, " ")
                    || !PackageImageSourceBridgeAppend(sink, document.TextAt(bodyTextNode))
                    || !PackageImageSourceBridgeAppendConst(sink, "\n"))
                : !PackageImageSourceBridgeAppendConst(sink, ";\n"))
        {
            return false;
        }

        functionIndex = functionIndex + 1;
    }

    return true;
}

// Renders the source bridge prefix without reparsing MANF for every import.
// Remaining member/constant/body reconstruction is layered after this
// boundary. Unsupported source-only payloads are rejected so this compatibility
// bridge never silently drops layout, backend, ownership, or aliasing facts.
public unsafe fn bool TryRenderLogicalPackageSourceBridgePrefix(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    mut borrow OwnedAscii sink)
{
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
            stack mut u64[0 2 ** 63 - 1] importsNode = 0;
            stack mut u32[0 max] importCount = 0;
            stack mut u64[0 2 ** 63 - 1] reExportsNode = 0;
            stack mut u32[0 max] reExportCount = 0;
            stack mut PackageImageSourceBridgeTemplateContext templateContext = new();
            stack mut OwnedAscii overloadKeyScratch = new();
            stack mut OwnedAscii typedBodyScratch = new();
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !document.TryFindMember(moduleNode, "ModuleName", moduleNameNode)
                || document.KindAt(moduleNameNode) != JsonKind.Text
                || AsciiLength(document.TextAt(moduleNameNode)) == 0
                || !LogicalPackageImageJsonSourceSurfaceImportNodes(
                    document,
                    moduleNode,
                    importsNode,
                    importCount,
                    reExportsNode,
                    reExportCount)
                || !PackageImageSourceBridgeBuildTemplateContext(
                    document,
                    moduleNode,
                    templateContext))
            {
                return false;
            }

            stack mut u32[0 max] importIndex = 0;
            while willexit (importIndex < importCount)
            {
                stack mut u64[0 2 ** 63 - 1] importNode = 0;
                stack mut u64[0 2 ** 63 - 1] importNameNode = 0;
                stack mut bool isExported = false;
                if (!document.TryChildAt(importsNode, (u64[0 2 ** 63 - 1])importIndex, importNode)
                    || document.KindAt(importNode) != JsonKind.Object
                    || !document.TryFindMember(importNode, "ModuleName", importNameNode)
                    || document.KindAt(importNameNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(importNameNode)) == 0
                    || !LogicalPackageImageJsonRequiredBoolMemberValue(
                        document,
                        importNode,
                        "IsExported",
                        isExported))
                {
                    return false;
                }

                stack ascii importName = document.TextAt(importNameNode);
                stack bool hasReExport = LogicalPackageImageJsonReExportListHasModuleName(
                    document,
                    reExportsNode,
                    reExportCount,
                    importName);
                if ((isExported || hasReExport)
                    && !PackageImageSourceBridgeAppendConst(sink, "export "))
                {
                    return false;
                }

                if (!PackageImageSourceBridgeAppendConst(sink, "import ")
                    || !PackageImageSourceBridgeAppend(sink, importName)
                    || !PackageImageSourceBridgeAppendConst(sink, "\n"))
                {
                    return false;
                }

                importIndex = importIndex + 1;
            }

            stack mut u32[0 max] reExportIndex = 0;
            while willexit (reExportIndex < reExportCount)
            {
                stack mut u64[0 2 ** 63 - 1] reExportNode = 0;
                stack mut u64[0 2 ** 63 - 1] reExportNameNode = 0;
                if (!document.TryChildAt(
                        reExportsNode,
                        (u64[0 2 ** 63 - 1])reExportIndex,
                        reExportNode)
                    || document.KindAt(reExportNode) != JsonKind.Object
                    || !document.TryFindMember(reExportNode, "ModuleName", reExportNameNode)
                    || document.KindAt(reExportNameNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(reExportNameNode)) == 0)
                {
                    return false;
                }

                stack ascii reExportName = document.TextAt(reExportNameNode);
                if (!LogicalPackageImageJsonImportListHasModuleName(
                        document,
                        importsNode,
                        importCount,
                        reExportName)
                    && (!PackageImageSourceBridgeAppendConst(sink, "export import ")
                        || !PackageImageSourceBridgeAppend(sink, reExportName)
                        || !PackageImageSourceBridgeAppendConst(sink, "\n")))
                {
                    return false;
                }

                reExportIndex = reExportIndex + 1;
            }

            if ((importCount > 0 || reExportCount > 0)
                && !PackageImageSourceBridgeAppendConst(sink, "\n"))
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] compilerFactsNode = 0;
            stack mut u64[0 2 ** 63 - 1] moduleBackendNode = 0;
            stack mut bool hasCompilerFacts = false;
            stack mut bool hasModuleBackend = false;
            if (!PackageImageSourceBridgeEffectiveCompilerFactsNode(
                    document,
                    moduleNode,
                    compilerFactsNode,
                    hasCompilerFacts)
                || (hasCompilerFacts
                    && !PackageImageSourceBridgeOptionalTextMemberNode(
                        document,
                        compilerFactsNode,
                        "BackendOptimizationMode",
                        moduleBackendNode,
                        hasModuleBackend))
                || (hasModuleBackend
                    && document.TextAt(moduleBackendNode) != "speed"
                    && document.TextAt(moduleBackendNode) != "opaque"))
            {
                return false;
            }

            if (hasModuleBackend
                && document.TextAt(moduleBackendNode) == "opaque"
                && !PackageImageSourceBridgeAppendConst(sink, "[Backend(Opaque)]\n"))
            {
                return false;
            }

            if (!PackageImageSourceBridgeAppendConst(sink, "module ")
                || !PackageImageSourceBridgeAppend(sink, document.TextAt(moduleNameNode))
                || !PackageImageSourceBridgeAppendConst(sink, "\n"))
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] typeAliasesNode = 0;
            stack mut u32[0 max] typeAliasCount = 0;
            if (!LogicalPackageImageJsonSourceSurfaceTypeAliasNodes(
                    document,
                    moduleNode,
                    typeAliasesNode,
                    typeAliasCount))
            {
                return false;
            }

            if (typeAliasCount != 0
                && !PackageImageSourceBridgeAppendConst(sink, "\n"))
            {
                return false;
            }

            stack mut u32[0 max] typeAliasIndex = 0;
            while willexit (typeAliasIndex < typeAliasCount)
            {
                stack mut u64[0 2 ** 63 - 1] typeAliasNode = 0;
                stack mut u64[0 2 ** 63 - 1] aliasNameNode = 0;
                stack mut u64[0 2 ** 63 - 1] visibilityNode = 0;
                stack mut u64[0 2 ** 63 - 1] targetTypeNode = 0;
                stack mut u64[0 2 ** 63 - 1] genericParametersNode = 0;
                stack mut u32[0 max] genericParameterCount = 0;
                stack mut u64[0 2 ** 63 - 1] comptimeParametersNode = 0;
                stack mut u32[0 max] comptimeParameterCount = 0;
                if (!document.TryChildAt(
                        typeAliasesNode,
                        (u64[0 2 ** 63 - 1])typeAliasIndex,
                        typeAliasNode)
                    || document.KindAt(typeAliasNode) != JsonKind.Object
                    || !document.TryFindMember(typeAliasNode, "Name", aliasNameNode)
                    || document.KindAt(aliasNameNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(aliasNameNode)) == 0
                    || !document.TryFindMember(typeAliasNode, "Visibility", visibilityNode)
                    || document.KindAt(visibilityNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(visibilityNode)) == 0
                    || !document.TryFindMember(typeAliasNode, "TargetType", targetTypeNode)
                    || document.KindAt(targetTypeNode) != JsonKind.Text
                    || AsciiLength(document.TextAt(targetTypeNode)) == 0
                    || !LogicalPackageImageJsonOptionalArrayMember(
                        document,
                        typeAliasNode,
                        "GenericParameters",
                        genericParametersNode,
                        genericParameterCount)
                    || !LogicalPackageImageJsonOptionalArrayMember(
                        document,
                        typeAliasNode,
                        "ComptimeGenericParameters",
                        comptimeParametersNode,
                        comptimeParameterCount))
                {
                    return false;
                }

                if (!PackageImageSourceBridgeAppend(sink, document.TextAt(visibilityNode))
                    || !PackageImageSourceBridgeAppendConst(sink, " alias ")
                    || !PackageImageSourceBridgeAppend(sink, document.TextAt(aliasNameNode)))
                {
                    return false;
                }

                if (comptimeParameterCount > (u32[0 max])(2 ** 32 - 1) - genericParameterCount)
                {
                    return false;
                }

                stack u32[0 max] totalParameterCount = genericParameterCount + comptimeParameterCount;
                if (totalParameterCount != 0
                    && !PackageImageSourceBridgeAppendConst(sink, "<"))
                {
                    return false;
                }

                stack mut u32[0 max] parameterIndex = 0;
                while willexit (parameterIndex < genericParameterCount)
                {
                    stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
                    if (!document.TryChildAt(
                            genericParametersNode,
                            (u64[0 2 ** 63 - 1])parameterIndex,
                            parameterNode)
                        || document.KindAt(parameterNode) != JsonKind.Text
                        || AsciiLength(document.TextAt(parameterNode)) == 0
                        || (parameterIndex != 0
                            && !PackageImageSourceBridgeAppendConst(sink, ", "))
                        || !PackageImageSourceBridgeAppend(sink, document.TextAt(parameterNode)))
                    {
                        return false;
                    }

                    parameterIndex = parameterIndex + 1;
                }

                stack mut u32[0 max] comptimeIndex = 0;
                while willexit (comptimeIndex < comptimeParameterCount)
                {
                    stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
                    stack mut u64[0 2 ** 63 - 1] parameterNameNode = 0;
                    stack mut u64[0 2 ** 63 - 1] parameterTypeNode = 0;
                    stack mut u64[0 2 ** 63 - 1] parameterTypeKindNode = 0;
                    if (!document.TryChildAt(
                            comptimeParametersNode,
                            (u64[0 2 ** 63 - 1])comptimeIndex,
                            parameterNode)
                        || document.KindAt(parameterNode) != JsonKind.Object
                        || !document.TryFindMember(parameterNode, "Name", parameterNameNode)
                        || document.KindAt(parameterNameNode) != JsonKind.Text
                        || AsciiLength(document.TextAt(parameterNameNode)) == 0
                        || !document.TryFindMember(parameterNode, "Type", parameterTypeNode)
                        || document.KindAt(parameterTypeNode) != JsonKind.Object
                        || !document.TryFindMember(parameterTypeNode, "Kind", parameterTypeKindNode)
                        || document.KindAt(parameterTypeKindNode) != JsonKind.Text
                        || AsciiLength(document.TextAt(parameterTypeKindNode)) == 0
                        || ((genericParameterCount != 0 || comptimeIndex != 0)
                            && !PackageImageSourceBridgeAppendConst(sink, ", "))
                        || !PackageImageSourceBridgeAppendConst(sink, "comptime ")
                        || !PackageImageSourceBridgeAppend(
                            sink,
                            document.TextAt(parameterTypeKindNode))
                        || !PackageImageSourceBridgeAppendConst(sink, " ")
                        || !PackageImageSourceBridgeAppend(sink, document.TextAt(parameterNameNode)))
                    {
                        return false;
                    }

                    comptimeIndex = comptimeIndex + 1;
                }

                if ((totalParameterCount != 0
                        && !PackageImageSourceBridgeAppendConst(sink, ">"))
                    || !PackageImageSourceBridgeAppendConst(sink, " = ")
                    || !PackageImageSourceBridgeAppend(sink, document.TextAt(targetTypeNode))
                    || !PackageImageSourceBridgeAppendConst(sink, ";\n"))
                {
                    return false;
                }

                typeAliasIndex = typeAliasIndex + 1;
            }

            return PackageImageSourceBridgeRenderTypes(
                    document,
                    moduleNode,
                    templateContext,
                    overloadKeyScratch,
                    typedBodyScratch,
                    sink)
                && PackageImageSourceBridgeRenderGlobals(document, moduleNode, sink)
                && PackageImageSourceBridgeRenderFunctions(
                    document,
                    moduleNode,
                    templateContext,
                    overloadKeyScratch,
                    typedBodyScratch,
                    sink);
    }
}

// Builds the Stage1-owned compatibility source document in one MANF parse and
// one source parse. Syntax diagnostics reject the document; callers must use
// the separately loaded typed-interface/compiler/template graphs for all
// backend-visible facts rather than treating this parse tree as canonical.
public unsafe fn bool TryBuildLogicalPackageLoadedSourceDocument(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    out LogicalPackageLoadedSourceDocument loadedDocument)
{
    loadedDocument = new();
    stack mut OwnedAscii sourceText = new();
    if (!TryRenderLogicalPackageSourceBridgePrefix(manifestJson, moduleOrdinal, sourceText))
    {
        return false;
    }

    switch (ParseCompilationUnit(sourceText.View()))
    {
        case ParseResult<CompilationUnitSyntax>.Err(var parseError):
            return false;
        case ParseResult<CompilationUnitSyntax>.Ok(var syntax):
            if (!syntax.Succeeded())
            {
                return false;
            }

            loadedDocument.ModuleOrdinalValue = moduleOrdinal;
            loadedDocument.SourceTextValue = sourceText;
            loadedDocument.SyntaxValue = syntax;
            return true;
    }
}
