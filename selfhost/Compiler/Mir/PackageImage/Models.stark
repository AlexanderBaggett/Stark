import Compiler.Ir
module Compiler.Mir.PackageImage.Models

// Public package-image status surface. The compatibility facade re-exports
// these declarations from Compiler.Mir.PackageImage.

public enum PackageImageInspectionFormat
{
    Text,
    Json,
}

public enum PackageImageValidationStatus
{
    Ok,
    TruncatedHeader,
    UnsupportedFormat,
    MalformedSectionDirectory,
    TruncatedSection,
}

public finite law ascii PackageImageValidationStatusName(PackageImageValidationStatus status)
{
    switch (status)
    {
        case PackageImageValidationStatus.Ok:
            return "ok";
        case PackageImageValidationStatus.TruncatedHeader:
            return "truncated-header";
        case PackageImageValidationStatus.UnsupportedFormat:
            return "unsupported-format";
        case PackageImageValidationStatus.MalformedSectionDirectory:
            return "malformed-section-directory";
        case PackageImageValidationStatus.TruncatedSection:
            return "truncated-section";
    }
}

