    internal IrTable<LogicalPackageSourceSurfaceTypeEnumVariantPayloadSummary> TypeEnumVariantPayloadRows;
    internal IrTable<LogicalPackageSourceSurfaceGlobalSummary> GlobalRows;
    internal IrTable<LogicalPackageSourceSurfaceFunctionSummary> FunctionRows;
    internal IrTable<LogicalPackageSourceSurfaceFunctionParameterSummary> FunctionParameterRows;

    LogicalPackageSourceSurfaceBridgeGraph()
    {
        self.ImportRows = new();
        self.TypeAliasRows = new();
        self.TypeAliasGenericParameterRows = new();
