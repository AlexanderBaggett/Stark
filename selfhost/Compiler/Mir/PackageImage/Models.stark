        self.UsesFastCallingConvention = false;
        self.IsHot = false;
        self.IsCold = false;
        self.HasExplicitInlinePreference = false;
        self.IsUnsafe = false;
        self.IsVarargs = false;
        self.IsTailCallable = false;
    }
}

