import Compiler.Ir
export import Compiler.Mir.PackageImage.ModelKinds
export import Compiler.Mir.PackageImage.ManifestJsonRows
export import Compiler.Mir.PackageImage.GenericTemplateModels
export import Compiler.Mir.PackageImage.TypedInterfaceFactModels
export import Compiler.Mir.PackageImage.FunctionFactModels
export import Compiler.Mir.PackageImage.BackendFactModels
module Compiler.Mir.PackageImage.Models

// Public package-image status, summary, source-surface, typed-declaration,
// manifest, and module-graph carriers. Focused model families are re-exported
// above so existing facade consumers retain the same zero-copy fact surface.

// Public package-image status surface. The compatibility facade re-exports
// these declarations from Compiler.Mir.PackageImage.

public enum PackageImageInspectionFormat
{
    Text,
    Json,
}

public enum PackageImageValidationStatus
{
    Ok,
    TruncatedHeader,
    UnsupportedFormat,
    MalformedSectionDirectory,
    TruncatedSection,
}

public finite law ascii PackageImageValidationStatusName(PackageImageValidationStatus status)
{
    switch (status)
    {
        case PackageImageValidationStatus.Ok:
            return "ok";
        case PackageImageValidationStatus.TruncatedHeader:
            return "truncated-header";
        case PackageImageValidationStatus.UnsupportedFormat:
            return "unsupported-format";
        case PackageImageValidationStatus.MalformedSectionDirectory:
            return "malformed-section-directory";
        case PackageImageValidationStatus.TruncatedSection:
            return "truncated-section";
    }
}

// Internal typed-interface manifest rows. They carry serialized row indices
// and scalar flags only; JSON materialization stays outside Models.

internal struct PackageImageSummary
{
    bool IsLogical;
    bool IsSectioned;
    bool HasAsm;
    u32[0 max] StringTableOffset;
    u64[0 max] StringTableLength;
    u32[0 max] ManifestOffset;
    u64[0 max] ManifestLength;
    u32[0 max] RootModuleStringIndex;
    u32[0 max] LibraryFileNameStringIndex;
    u32[0 max] BuildProfileStringIndex;
    u32[0 max] TargetTripleStringIndex;
    u32[0 max] TargetDataLayoutStringIndex;
    u32[0 max] TargetCpuStringIndex;
    u32[0 max] RelocationModelStringIndex;
    u32[0 max] CodeModelStringIndex;
    u32[0 max] FeatureStringIndexOffset;
    u32[0 max] CDataModelKindStringIndex;
    bool CCharIsSigned;
    u32[0 max] CPointerBitWidth;
    u32[0 max] CLongBitWidth;
    u32[0 max] CSizeTBitWidth;
    u32[0 max] CPtrDiffTBitWidth;
    u32[0 max] AggregatePointerSizeBytes;
    u32[0 max] AggregatePointerAlignmentBytes;
    u32[0 max] InstructionCount;
    u32[0 max] BlockCount;
    u32[0 max] FunctionCount;
    u32[0 max] GlobalCount;
    u32[0 max] AsmFunctionCount;
    u32[0 max] EnumLayoutFactCount;
    u32[0 max] TextPayloadByteCount;
    u32[0 max] TextConstantCount;
    u32[0 max] FloatPayloadByteCount;
    u32[0 max] FloatConstantCount;
    u32[0 max] SectionCount;
    u32[0 max] StringCount;
    u32[0 max] TargetFeatureCount;
    bool HasBuildProfile;
    bool HasTarget;
    bool HasCDataModel;
    bool HasAggregateLayout;
    bool HasEnumLayoutFacts;
    bool HasTextConstants;
    bool HasFloatConstants;

    PackageImageSummary()
    {
        self.IsLogical = false;
        self.IsSectioned = false;
        self.HasAsm = false;
        self.StringTableOffset = 0;
        self.StringTableLength = 0;
        self.ManifestOffset = 0;
        self.ManifestLength = 0;
        self.RootModuleStringIndex = PackageImageMissingStringIndex();
        self.LibraryFileNameStringIndex = PackageImageMissingStringIndex();
        self.BuildProfileStringIndex = PackageImageMissingStringIndex();
        self.TargetTripleStringIndex = PackageImageMissingStringIndex();
        self.TargetDataLayoutStringIndex = PackageImageMissingStringIndex();
        self.TargetCpuStringIndex = PackageImageMissingStringIndex();
        self.RelocationModelStringIndex = PackageImageMissingStringIndex();
        self.CodeModelStringIndex = PackageImageMissingStringIndex();
        self.FeatureStringIndexOffset = 0;
        self.CDataModelKindStringIndex = PackageImageMissingStringIndex();
        self.CCharIsSigned = false;
        self.CPointerBitWidth = 0;
        self.CLongBitWidth = 0;
        self.CSizeTBitWidth = 0;
        self.CPtrDiffTBitWidth = 0;
        self.AggregatePointerSizeBytes = 0;
        self.AggregatePointerAlignmentBytes = 0;
        self.InstructionCount = 0;
        self.BlockCount = 0;
        self.FunctionCount = 0;
        self.GlobalCount = 0;
        self.AsmFunctionCount = 0;
        self.EnumLayoutFactCount = 0;
        self.TextPayloadByteCount = 0;
        self.TextConstantCount = 0;
        self.FloatPayloadByteCount = 0;
        self.FloatConstantCount = 0;
        self.SectionCount = 0;
        self.StringCount = 0;
        self.TargetFeatureCount = 0;
        self.HasBuildProfile = false;
        self.HasTarget = false;
        self.HasCDataModel = false;
        self.HasAggregateLayout = false;
        self.HasEnumLayoutFacts = false;
        self.HasTextConstants = false;
        self.HasFloatConstants = false;
    }
}

