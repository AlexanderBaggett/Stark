        borrow LogicalPackageSourceSurfaceBridgeGraph self)
    {
        return self.ImportRowCount()
            + self.TypeAliasRowCount()
            + self.TypeAliasGenericParameterRowCount()
            + self.TypeRowCount()
            + self.TypeFieldRowCount()
