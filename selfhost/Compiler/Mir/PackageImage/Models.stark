    internal IrTable<LogicalPackageAbiParameterRow> ParameterRows;
    internal IrTable<LogicalPackageAbiParameterLlvmTypeRow> LlvmParameterTypeRows;
    internal LogicalPackageTypeReferenceGraph TypeReferences;

    LogicalPackageAbiFactGraph()
    {
        self.TextBytes = new();
        self.TextRows = new();
        self.AbiFunctionRows = new();
        self.ParameterRows = new();
        self.LlvmParameterTypeRows = new();
        self.TypeReferences = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] TextByteCount(
        borrow LogicalPackageAbiFactGraph self)
    {
        return self.TextBytes.Length;
