internal fn LogicalPackageImageFacts LogicalPackageImageFactsOf(PackageImageSummary summary)
{
    return new LogicalPackageImageFacts()
    {
        SectionCountValue = summary.SectionCount,
        StringCountValue = summary.StringCount,
        StringTableOffsetValue = summary.StringTableOffset,
        StringTableLengthValue = summary.StringTableLength,
        ManifestOffsetValue = summary.ManifestOffset,
        ManifestLengthValue = summary.ManifestLength,
        RootModuleStringIndexValue = summary.RootModuleStringIndex,
        LibraryFileNameStringIndexValue = summary.LibraryFileNameStringIndex,
        BuildProfileStringIndexValue = summary.BuildProfileStringIndex,
        TargetTripleStringIndexValue = summary.TargetTripleStringIndex,
        TargetDataLayoutStringIndexValue = summary.TargetDataLayoutStringIndex,
        TargetCpuStringIndexValue = summary.TargetCpuStringIndex,
        RelocationModelStringIndexValue = summary.RelocationModelStringIndex,
        CodeModelStringIndexValue = summary.CodeModelStringIndex,
        FeatureStringIndexOffsetValue = summary.FeatureStringIndexOffset,
        TargetFeatureCountValue = summary.TargetFeatureCount,
        CDataModelKindStringIndexValue = summary.CDataModelKindStringIndex,
        CCharIsSignedValue = summary.CCharIsSigned,
        CPointerBitWidthValue = summary.CPointerBitWidth,
        CLongBitWidthValue = summary.CLongBitWidth,
        CSizeTBitWidthValue = summary.CSizeTBitWidth,
        CPtrDiffTBitWidthValue = summary.CPtrDiffTBitWidth,
        AggregatePointerSizeBytesValue = summary.AggregatePointerSizeBytes,
        AggregatePointerAlignmentBytesValue = summary.AggregatePointerAlignmentBytes,
        HasBuildProfileValue = summary.HasBuildProfile,
        HasTargetValue = summary.HasTarget,
        HasCDataModelValue = summary.HasCDataModel,
        HasAggregateLayoutValue = summary.HasAggregateLayout
    };
}

internal fn PackageImageSummary LogicalPackageImageSummaryOf(
    u32[0 max] sectionCount,
    u32[0 max] stringCount,
    u32[0 max] stringTableOffset,
    u64[0 max] stringTableLength,
    u32[0 max] manifestOffset,
    u64[0 max] manifestLength,
    LogicalPackageFactsHeader facts)
{
    stack mut PackageImageSummary summary = new();
    summary.IsLogical = true;
    summary.IsSectioned = true;
    summary.StringTableOffset = stringTableOffset;
    summary.StringTableLength = stringTableLength;
    summary.ManifestOffset = manifestOffset;
    summary.ManifestLength = manifestLength;
    summary.RootModuleStringIndex = facts.RootModuleStringIndex;
    summary.LibraryFileNameStringIndex = facts.LibraryFileNameStringIndex;
    summary.BuildProfileStringIndex = facts.BuildProfileStringIndex;
    summary.TargetTripleStringIndex = facts.TargetTripleStringIndex;
    summary.TargetDataLayoutStringIndex = facts.TargetDataLayoutStringIndex;
    summary.TargetCpuStringIndex = facts.TargetCpuStringIndex;
    summary.RelocationModelStringIndex = facts.RelocationModelStringIndex;
    summary.CodeModelStringIndex = facts.CodeModelStringIndex;
    summary.FeatureStringIndexOffset = facts.FeatureStringIndexOffset;
    summary.CDataModelKindStringIndex = facts.CDataModelKindStringIndex;
    summary.CCharIsSigned = facts.CCharIsSigned;
    summary.CPointerBitWidth = facts.CPointerBitWidth;
    summary.CLongBitWidth = facts.CLongBitWidth;
    summary.CSizeTBitWidth = facts.CSizeTBitWidth;
    summary.CPtrDiffTBitWidth = facts.CPtrDiffTBitWidth;
    summary.AggregatePointerSizeBytes = facts.AggregatePointerSizeBytes;
    summary.AggregatePointerAlignmentBytes = facts.AggregatePointerAlignmentBytes;
    summary.SectionCount = sectionCount;
    summary.StringCount = stringCount;
    summary.TargetFeatureCount = facts.TargetFeatureCount;
    summary.HasBuildProfile = facts.HasBuildProfile;
    summary.HasTarget = facts.HasTarget;
    summary.HasCDataModel = facts.HasCDataModel;
    summary.HasAggregateLayout = facts.HasAggregateLayout;
    return summary;
}
