    public inline finite law bool NoRecurse(borrow LogicalPackageFunctionEffectRow self)
    {
        return self.NoRecurseValue;
    }
}

public struct LogicalPackageFunctionEffectFactGraph
{
    internal dynamic i8[min max] TextBytes;
    internal IrTable<LogicalPackageFunctionEffectFactTextRow> TextRows;
    internal IrTable<LogicalPackageFunctionEffectRow> FunctionEffectRows;

    LogicalPackageFunctionEffectFactGraph()
    {
        self.TextBytes = new();
        self.TextRows = new();
        self.FunctionEffectRows = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] TextByteCount(
        borrow LogicalPackageFunctionEffectFactGraph self)
    {
        return self.TextBytes.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] TextRowCount(
        borrow LogicalPackageFunctionEffectFactGraph self)
    {
        return self.TextRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] FunctionEffectRowCount(
        borrow LogicalPackageFunctionEffectFactGraph self)
    {
        return self.FunctionEffectRows.Count();
    }

    public finite law retborrow LogicalPackageFunctionEffectFactTextRow TextRowAt(
        borrow LogicalPackageFunctionEffectFactGraph self,
        u32[0 max] row)
    {
        return self.TextRows.Get(row);
    }

    public finite law retborrow LogicalPackageFunctionEffectRow FunctionEffectRowAt(
        borrow LogicalPackageFunctionEffectFactGraph self,
        u32[0 max] row)
    {
        return self.FunctionEffectRows.Get(row);
    }
}

