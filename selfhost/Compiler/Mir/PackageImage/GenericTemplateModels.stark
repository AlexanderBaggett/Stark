module Compiler.Mir.PackageImage.GenericTemplateModels

// Generic-template fact rows and graph carriers. Population and JSON
// materialization remain in the package-image builder and loader modules.

public struct LogicalPackageGenericTemplateFactTextRow
{
    LogicalPackageGenericTemplateFactTextKind TextKindValue;
    u32[0 max] TextOrdinalValue;
    u32[0 max] ByteOffsetValue;
    u32[0 max] ByteLengthValue;

    LogicalPackageGenericTemplateFactTextRow()
    {
        self.TextKindValue = LogicalPackageGenericTemplateFactTextKind.QualifiedResolvedName;
        self.TextOrdinalValue = 0;
        self.ByteOffsetValue = 0;
        self.ByteLengthValue = 0;
    }

    public inline finite law LogicalPackageGenericTemplateFactTextKind TextKind(
        borrow LogicalPackageGenericTemplateFactTextRow self)
    {
        return self.TextKindValue;
    }

    public inline finite law u32[0 max] TextOrdinal(
        borrow LogicalPackageGenericTemplateFactTextRow self)
    {
        return self.TextOrdinalValue;
    }

    public inline finite law u32[0 max] ByteOffset(
        borrow LogicalPackageGenericTemplateFactTextRow self)
    {
        return self.ByteOffsetValue;
    }

    public inline finite law u32[0 max] ByteLength(
        borrow LogicalPackageGenericTemplateFactTextRow self)
    {
        return self.ByteLengthValue;
    }
}

