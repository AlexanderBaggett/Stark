internal fn bool LogicalPackageGenericTemplateFactGraphAddTemplateBoundOperationRow(
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    u32[0 max] functionTemplateRow,
    u32[0 max] operationOrdinal,
    u32[0 max] kindTextRow,
    u32[0 max] line,
    u32[0 max] column,
    u32[0 max] resultTypeReferenceRow,
    bool hasPublishedOrdinal,
    u32[0 max] publishedOrdinal,
    bool hasEnclosingFunctionName,
    u32[0 max] enclosingFunctionNameTextRow,
    u32[0 max] callArgumentCount,
    out u32[0 max] boundOperationRow)
{
    boundOperationRow = 0;
    if (!graph.FunctionTemplateRows.Contains(functionTemplateRow)
        || !graph.TextRows.Contains(kindTextRow)
        || !graph.TypeReferences.ContainsTypeReference(resultTypeReferenceRow)
        || (!hasPublishedOrdinal && publishedOrdinal != 0)
        || (hasEnclosingFunctionName && !graph.TextRows.Contains(enclosingFunctionNameTextRow))
        || (!hasEnclosingFunctionName && enclosingFunctionNameTextRow != 0))
    {
        return false;
    }

    stack LogicalPackageTemplateBoundOperationRow row =
        new LogicalPackageTemplateBoundOperationRow()
    {
        FunctionTemplateRowValue = functionTemplateRow,
        OperationOrdinalValue = operationOrdinal,
        KindTextRowValue = kindTextRow,
        LineValue = line,
        ColumnValue = column,
        ResultTypeReferenceRowValue = resultTypeReferenceRow,
        PublishedOrdinalValue = publishedOrdinal,
        EnclosingFunctionNameTextRowValue = enclosingFunctionNameTextRow,
        CallArgumentCountValue = callArgumentCount,
        HasPublishedOrdinalValue = hasPublishedOrdinal,
        HasEnclosingFunctionNameValue = hasEnclosingFunctionName
    };
    boundOperationRow = graph.TemplateBoundOperationRows.Add(row);
    return boundOperationRow != 0;
}

internal fn bool LogicalPackageGenericTemplateFactGraphSetTemplateBoundOperationCallSignature(
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    u32[0 max] boundOperationRow,
    u32[0 max] callSignatureRow)
{
    if (!graph.TemplateBoundOperationRows.Contains(boundOperationRow)
        || !graph.TemplateCallSignatureRows.Contains(callSignatureRow))
    {
        return false;
    }

    stack mut LogicalPackageTemplateBoundOperationRow row =
        graph.TemplateBoundOperationRows.Get(boundOperationRow);
    row.CallSignatureRowValue = callSignatureRow;
    row.HasCallSignatureValue = true;
    return graph.TemplateBoundOperationRows.Replace(boundOperationRow, row);
}

