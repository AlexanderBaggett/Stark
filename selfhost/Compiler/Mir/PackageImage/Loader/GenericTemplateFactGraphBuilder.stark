import Compiler.Ir
import Compiler.Mir.PackageImage.Models
import System.Memory
import System.Text
module Compiler.Mir.PackageImage.Loader.GenericTemplateFactGraphBuilder

// Allocation-conscious generic-template graph mutation and text ownership.
// Rows retain their stable manifest ordinals and direct table identities.

internal fn MemoryStatus LogicalPackageGenericTemplateFactGraphAppendText(
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    ascii text,
    out u32[0 max] byteOffset,
    out u32[0 max] byteLength)
{
    byteOffset = 0;
    byteLength = 0;
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength <= 0 || signedLength > (i64[min max])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (graph.TextBytes.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || graph.TextBytes.Length + (u64[0 2 ** 63 - 1])signedLength > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    byteOffset = (u32[0 max])graph.TextBytes.Length;
    byteLength = (u32[0 max])signedLength;
    unsafe
    {
        stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
        if (data == null)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        if (!graph.TextBytes.TryReserve((u64[0 2 ** 63 - 1])signedLength))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            init graph.TextBytes[graph.TextBytes.Length] = *(&data[index]);
        }
    }

    return MemoryStatus.Ok;
}
internal fn bool LogicalPackageGenericTemplateFactGraphAddTextRow(
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    LogicalPackageGenericTemplateFactTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u32[0 max] byteOffset = 0;
    stack mut u32[0 max] byteLength = 0;
    switch (LogicalPackageGenericTemplateFactGraphAppendText(graph, text, byteOffset, byteLength))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            stack LogicalPackageGenericTemplateFactTextRow row =
                new LogicalPackageGenericTemplateFactTextRow()
            {
                TextKindValue = textKind,
                TextOrdinalValue = textOrdinal,
                ByteOffsetValue = byteOffset,
                ByteLengthValue = byteLength
            };
            textRow = graph.TextRows.Add(row);
            return textRow != 0;
    }
}

internal fn bool LogicalPackageGenericTemplateFactGraphAddFunctionTemplateRow(
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    u32[0 max] moduleOrdinal,
    u32[0 max] templateOrdinal,
    u32[0 max] qualifiedResolvedNameTextRow,
    u32[0 max] qualifiedNameTextRow,
    u32[0 max] overloadKeyTextRow,
    bool hasBodyText,
    u32[0 max] bodyTextRow,
    bool hasBackendOptimizationMode,
    u32[0 max] backendOptimizationModeTextRow,
    bool hasTopLevelStatementCount,
    u32[0 max] topLevelStatementCount,
    bool hasEstimatedBodyCost,
    u32[0 max] estimatedBodyCost,
    bool hasSemantics,
    bool hasTypedBody,
    u32[0 max] deferredFunctionInstantiationCount,
    u32[0 max] deferredTypeInstantiationCount,
    u32[0 max] objectCreationCount,
    u32[0 max] enumConstructorCount,
    u32[0 max] enumCallCount,
    u32[0 max] enumValueCount,
    u32[0 max] enumPatternCount,
    u32[0 max] aggregatePatternCount,
    u32[0 max] localDeclarationCount,
    u32[0 max] conversionCount,
    u32[0 max] directCallCount,
    u32[0 max] fieldAccessCount,
    u32[0 max] memberCallCount,
    u32[0 max] functionAddressCount,
    u32[0 max] boundOperationCount,
    u32[0 max] tryPropagationCount,
    out u32[0 max] templateRow)
{
    templateRow = 0;
    if (!graph.TextRows.Contains(qualifiedResolvedNameTextRow)
        || !graph.TextRows.Contains(qualifiedNameTextRow)
        || !graph.TextRows.Contains(overloadKeyTextRow)
        || (hasBodyText && !graph.TextRows.Contains(bodyTextRow))
        || (!hasBodyText && bodyTextRow != 0)
        || (hasBackendOptimizationMode && !graph.TextRows.Contains(backendOptimizationModeTextRow))
        || (!hasBackendOptimizationMode && backendOptimizationModeTextRow != 0)
        || (!hasTopLevelStatementCount && topLevelStatementCount != 0)
        || (!hasEstimatedBodyCost && estimatedBodyCost != 0))
    {
        return false;
    }

    stack LogicalPackageFunctionTemplateRow row = new LogicalPackageFunctionTemplateRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        TemplateOrdinalValue = templateOrdinal,
        QualifiedResolvedNameTextRowValue = qualifiedResolvedNameTextRow,
        QualifiedNameTextRowValue = qualifiedNameTextRow,
        OverloadKeyTextRowValue = overloadKeyTextRow,
        BodyTextRowValue = bodyTextRow,
        BackendOptimizationModeTextRowValue = backendOptimizationModeTextRow,
        TopLevelStatementCountValue = topLevelStatementCount,
        EstimatedBodyCostValue = estimatedBodyCost,
        HasBodyTextValue = hasBodyText,
        HasTopLevelStatementCountValue = hasTopLevelStatementCount,
        HasEstimatedBodyCostValue = hasEstimatedBodyCost,
        HasSemanticsValue = hasSemantics,
        HasTypedBodyValue = hasTypedBody,
        HasBackendOptimizationModeValue = hasBackendOptimizationMode,
        DeferredFunctionInstantiationCountValue = deferredFunctionInstantiationCount,
        DeferredTypeInstantiationCountValue = deferredTypeInstantiationCount,
        ObjectCreationCountValue = objectCreationCount,
        EnumConstructorCountValue = enumConstructorCount,
        EnumCallCountValue = enumCallCount,
        EnumValueCountValue = enumValueCount,
        EnumPatternCountValue = enumPatternCount,
        AggregatePatternCountValue = aggregatePatternCount,
        LocalDeclarationCountValue = localDeclarationCount,
        ConversionCountValue = conversionCount,
        DirectCallCountValue = directCallCount,
        FieldAccessCountValue = fieldAccessCount,
        MemberCallCountValue = memberCallCount,
        FunctionAddressCountValue = functionAddressCount,
        BoundOperationCountValue = boundOperationCount,
        TryPropagationCountValue = tryPropagationCount
    };
    templateRow = graph.FunctionTemplateRows.Add(row);
    return templateRow != 0;
}

internal fn bool LogicalPackageGenericTemplateFactGraphAddTypedTemplateExpressionRow(
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    u32[0 max] functionTemplateRow,
    u32[0 max] parentExpressionRow,
    LogicalPackageTypedTemplateExpressionParentKind parentKind,
    u32[0 max] expressionOrdinal,
    u32[0 max] kindTextRow,
    bool hasName,
    u32[0 max] nameTextRow,
    bool hasAssignmentOperator,
    u32[0 max] assignmentOperatorTextRow,
    bool hasLiteralText,
    u32[0 max] literalTextRow,
    bool hasOrdinal,
    u32[0 max] ordinal,
    bool hasType,
    u32[0 max] typeReferenceRow,
    bool hasTargetExpression,
    u32[0 max] argumentCount,
    u32[0 max] memberNameCount,
    u32[0 max] operatorNameCount,
    u32[0 max] typeArgumentCount,
    u32[0 max] comptimeValueArgumentCount,
    out u32[0 max] expressionRow)
{
    expressionRow = 0;
    if (!graph.FunctionTemplateRows.Contains(functionTemplateRow)
        || !graph.TextRows.Contains(kindTextRow)
        || (parentExpressionRow == 0
            && parentKind != LogicalPackageTypedTemplateExpressionParentKind.Root)
        || (parentExpressionRow != 0
            && parentKind == LogicalPackageTypedTemplateExpressionParentKind.Root)
        || (parentExpressionRow != 0 && !graph.TypedTemplateExpressionRows.Contains(parentExpressionRow))
        || (hasName && !graph.TextRows.Contains(nameTextRow))
        || (!hasName && nameTextRow != 0)
        || (hasAssignmentOperator && !graph.TextRows.Contains(assignmentOperatorTextRow))
        || (!hasAssignmentOperator && assignmentOperatorTextRow != 0)
        || (hasLiteralText && !graph.TextRows.Contains(literalTextRow))
        || (!hasLiteralText && literalTextRow != 0)
        || (!hasOrdinal && ordinal != 0)
        || (hasType && !graph.TypeReferences.ContainsTypeReference(typeReferenceRow))
        || (!hasType && typeReferenceRow != 0))
    {
        return false;
    }

    stack LogicalPackageTypedTemplateExpressionRow row =
        new LogicalPackageTypedTemplateExpressionRow()
    {
        FunctionTemplateRowValue = functionTemplateRow,
        ParentExpressionRowValue = parentExpressionRow,
        ParentKindValue = parentKind,
        ExpressionOrdinalValue = expressionOrdinal,
        KindTextRowValue = kindTextRow,
        NameTextRowValue = nameTextRow,
        AssignmentOperatorTextRowValue = assignmentOperatorTextRow,
        LiteralTextRowValue = literalTextRow,
        TypeReferenceRowValue = typeReferenceRow,
        HasNameValue = hasName,
        HasAssignmentOperatorValue = hasAssignmentOperator,
        HasLiteralTextValue = hasLiteralText,
        HasOrdinalValue = hasOrdinal,
        OrdinalValue = ordinal,
        HasTypeValue = hasType,
        HasTargetExpressionValue = hasTargetExpression,
        ArgumentCountValue = argumentCount,
        MemberNameCountValue = memberNameCount,
        OperatorNameCountValue = operatorNameCount,
        TypeArgumentCountValue = typeArgumentCount,
        ComptimeValueArgumentCountValue = comptimeValueArgumentCount
    };
    expressionRow = graph.TypedTemplateExpressionRows.Add(row);
    return expressionRow != 0;
}

internal fn bool LogicalPackageGenericTemplateFactGraphAddTypedTemplateStatementRow(
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    u32[0 max] functionTemplateRow,
    u32[0 max] parentStatementRow,
    u32[0 max] parentSwitchCaseRow,
    LogicalPackageTypedTemplateStatementParentKind parentKind,
    u32[0 max] statementOrdinal,
    u32[0 max] kindTextRow,
    bool hasExpression,
    u32[0 max] expressionRow,
    bool hasTargetExpression,
    u32[0 max] targetExpressionRow,
    bool hasTraversalSourceExpression,
    u32[0 max] traversalSourceExpressionRow,
    bool hasName,
    u32[0 max] nameTextRow,
    bool hasAssignmentOperator,
    u32[0 max] assignmentOperatorTextRow,
    bool hasStorageClass,
    u32[0 max] storageClassTextRow,
    bool hasLoopBehavior,
    u32[0 max] loopBehaviorTextRow,
    bool hasConstProvenance,
    u32[0 max] constProvenanceTextRow,
    bool hasTraversalIndexName,
    u32[0 max] traversalIndexNameTextRow,
    bool hasTraversalIndexStorageClass,
    u32[0 max] traversalIndexStorageClassTextRow,
    bool hasTraversalElementName,
    u32[0 max] traversalElementNameTextRow,
    bool isMutable,
    bool isConstant,
    bool hasType,
    u32[0 max] typeReferenceRow,
    bool hasStorageCapacity,
    u32[0 max] storageCapacity,
    bool hasTraversalIndexType,
    u32[0 max] traversalIndexTypeReferenceRow,
    bool hasTraversalElementType,
    u32[0 max] traversalElementTypeReferenceRow,
    bool hasConditionPattern,
    u32[0 max] switchCaseCount,
    u32[0 max] initializerStatementCount,
    u32[0 max] iteratorStatementCount,
    u32[0 max] bodyStatementCount,
    u32[0 max] thenStatementCount,
    u32[0 max] elseStatementCount,
    u32[0 max] loopContractCount,
    out u32[0 max] statementRow)
{
    statementRow = 0;
    if (!graph.FunctionTemplateRows.Contains(functionTemplateRow)
        || !graph.TextRows.Contains(kindTextRow)
        || (parentStatementRow == 0
            && parentKind != LogicalPackageTypedTemplateStatementParentKind.TopLevel)
        || (parentStatementRow != 0
            && parentKind == LogicalPackageTypedTemplateStatementParentKind.TopLevel)
        || (parentStatementRow != 0 && !graph.TypedTemplateStatementRows.Contains(parentStatementRow))
        || (parentKind == LogicalPackageTypedTemplateStatementParentKind.SwitchCase
            && !graph.TypedTemplateSwitchCaseRows.Contains(parentSwitchCaseRow))
        || (parentKind != LogicalPackageTypedTemplateStatementParentKind.SwitchCase
            && parentSwitchCaseRow != 0)
        || (hasExpression && !graph.TypedTemplateExpressionRows.Contains(expressionRow))
        || (!hasExpression && expressionRow != 0)
        || (hasTargetExpression && !graph.TypedTemplateExpressionRows.Contains(targetExpressionRow))
        || (!hasTargetExpression && targetExpressionRow != 0)
        || (hasTraversalSourceExpression
            && !graph.TypedTemplateExpressionRows.Contains(traversalSourceExpressionRow))
        || (!hasTraversalSourceExpression && traversalSourceExpressionRow != 0)
        || (hasName && !graph.TextRows.Contains(nameTextRow))
        || (!hasName && nameTextRow != 0)
        || (hasAssignmentOperator && !graph.TextRows.Contains(assignmentOperatorTextRow))
        || (!hasAssignmentOperator && assignmentOperatorTextRow != 0)
        || (hasStorageClass && !graph.TextRows.Contains(storageClassTextRow))
        || (!hasStorageClass && storageClassTextRow != 0)
        || (hasLoopBehavior && !graph.TextRows.Contains(loopBehaviorTextRow))
        || (!hasLoopBehavior && loopBehaviorTextRow != 0)
        || (hasConstProvenance && !graph.TextRows.Contains(constProvenanceTextRow))
        || (!hasConstProvenance && constProvenanceTextRow != 0)
        || (hasTraversalIndexName && !graph.TextRows.Contains(traversalIndexNameTextRow))
        || (!hasTraversalIndexName && traversalIndexNameTextRow != 0)
        || (hasTraversalIndexStorageClass
            && !graph.TextRows.Contains(traversalIndexStorageClassTextRow))
        || (!hasTraversalIndexStorageClass && traversalIndexStorageClassTextRow != 0)
        || (hasTraversalElementName && !graph.TextRows.Contains(traversalElementNameTextRow))
        || (!hasTraversalElementName && traversalElementNameTextRow != 0)
        || (hasType && !graph.TypeReferences.ContainsTypeReference(typeReferenceRow))
        || (!hasType && typeReferenceRow != 0)
        || (!hasStorageCapacity && storageCapacity != 0))
    {
        return false;
    }

    if ((hasTraversalIndexType
            && !graph.TypeReferences.ContainsTypeReference(traversalIndexTypeReferenceRow))
        || (!hasTraversalIndexType && traversalIndexTypeReferenceRow != 0)
        || (hasTraversalElementType
            && !graph.TypeReferences.ContainsTypeReference(traversalElementTypeReferenceRow))
        || (!hasTraversalElementType && traversalElementTypeReferenceRow != 0))
    {
        return false;
    }

    stack LogicalPackageTypedTemplateStatementRow row =
        new LogicalPackageTypedTemplateStatementRow()
    {
        FunctionTemplateRowValue = functionTemplateRow,
        ParentStatementRowValue = parentStatementRow,
        ParentSwitchCaseRowValue = parentSwitchCaseRow,
        ParentKindValue = parentKind,
        StatementOrdinalValue = statementOrdinal,
        KindTextRowValue = kindTextRow,
        ExpressionRowValue = expressionRow,
        TargetExpressionRowValue = targetExpressionRow,
        TraversalSourceExpressionRowValue = traversalSourceExpressionRow,
        NameTextRowValue = nameTextRow,
        AssignmentOperatorTextRowValue = assignmentOperatorTextRow,
        StorageClassTextRowValue = storageClassTextRow,
        LoopBehaviorTextRowValue = loopBehaviorTextRow,
        ConstProvenanceTextRowValue = constProvenanceTextRow,
        TraversalIndexNameTextRowValue = traversalIndexNameTextRow,
        TraversalIndexStorageClassTextRowValue = traversalIndexStorageClassTextRow,
        TraversalElementNameTextRowValue = traversalElementNameTextRow,
        HasExpressionValue = hasExpression,
        HasTargetExpressionValue = hasTargetExpression,
        HasTraversalSourceExpressionValue = hasTraversalSourceExpression,
        HasNameValue = hasName,
        HasAssignmentOperatorValue = hasAssignmentOperator,
        HasStorageClassValue = hasStorageClass,
        HasLoopBehaviorValue = hasLoopBehavior,
        HasConstProvenanceValue = hasConstProvenance,
        HasTraversalIndexNameValue = hasTraversalIndexName,
        HasTraversalIndexStorageClassValue = hasTraversalIndexStorageClass,
        HasTraversalElementNameValue = hasTraversalElementName,
        IsMutableValue = isMutable,
        IsConstantValue = isConstant,
        HasTypeValue = hasType,
        TypeReferenceRowValue = typeReferenceRow,
        HasStorageCapacityValue = hasStorageCapacity,
        StorageCapacityValue = storageCapacity,
        HasTraversalIndexTypeValue = hasTraversalIndexType,
        TraversalIndexTypeReferenceRowValue = traversalIndexTypeReferenceRow,
        HasTraversalElementTypeValue = hasTraversalElementType,
        TraversalElementTypeReferenceRowValue = traversalElementTypeReferenceRow,
        HasConditionPatternValue = hasConditionPattern,
        SwitchCaseCountValue = switchCaseCount,
        InitializerStatementCountValue = initializerStatementCount,
        IteratorStatementCountValue = iteratorStatementCount,
        BodyStatementCountValue = bodyStatementCount,
        ThenStatementCountValue = thenStatementCount,
        ElseStatementCountValue = elseStatementCount,
        LoopContractCountValue = loopContractCount
    };
    statementRow = graph.TypedTemplateStatementRows.Add(row);
    return statementRow != 0;
}

