internal fn bool LogicalPackageGenericTemplateFactGraphAddTypedTemplatePatternRow(
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    u32[0 max] statementRow,
    u32[0 max] switchCaseRow,
    u32[0 max] parentPatternRow,
    LogicalPackageTypedTemplatePatternParentKind parentKind,
    u32[0 max] patternOrdinal,
    u32[0 max] kindTextRow,
    bool hasName,
    u32[0 max] nameTextRow,
    bool hasOrdinal,
    u32[0 max] ordinal,
    bool hasExpression,
    u32[0 max] expressionRow,
    bool hasEndExpression,
    u32[0 max] endExpressionRow,
    u32[0 max] memberPatternCount,
    out u32[0 max] patternRow)
{
    patternRow = 0;
    stack mut bool validParent = false;
    if (parentKind == LogicalPackageTypedTemplatePatternParentKind.StatementCondition)
    {
        validParent = graph.TypedTemplateStatementRows.Contains(statementRow)
            && switchCaseRow == 0
            && parentPatternRow == 0;
    }
    else if (parentKind == LogicalPackageTypedTemplatePatternParentKind.SwitchCaseMember)
    {
        validParent = statementRow == 0
            && graph.TypedTemplateSwitchCaseRows.Contains(switchCaseRow)
            && parentPatternRow == 0;
    }
    else
    {
        validParent = statementRow == 0
            && switchCaseRow == 0
            && graph.TypedTemplatePatternRows.Contains(parentPatternRow);
    }

    if (!validParent
        || !graph.TextRows.Contains(kindTextRow)
        || (hasName && !graph.TextRows.Contains(nameTextRow))
        || (!hasName && nameTextRow != 0)
        || (!hasOrdinal && ordinal != 0)
        || (hasExpression && !graph.TypedTemplateExpressionRows.Contains(expressionRow))
        || (!hasExpression && expressionRow != 0)
        || (hasEndExpression && !graph.TypedTemplateExpressionRows.Contains(endExpressionRow))
        || (!hasEndExpression && endExpressionRow != 0))
    {
        return false;
    }

    stack LogicalPackageTypedTemplatePatternRow row =
        new LogicalPackageTypedTemplatePatternRow()
    {
        StatementRowValue = statementRow,
        SwitchCaseRowValue = switchCaseRow,
        ParentPatternRowValue = parentPatternRow,
        ParentKindValue = parentKind,
        PatternOrdinalValue = patternOrdinal,
        KindTextRowValue = kindTextRow,
        NameTextRowValue = nameTextRow,
        ExpressionRowValue = expressionRow,
        EndExpressionRowValue = endExpressionRow,
        HasNameValue = hasName,
        HasOrdinalValue = hasOrdinal,
        OrdinalValue = ordinal,
        HasExpressionValue = hasExpression,
        HasEndExpressionValue = hasEndExpression,
        MemberPatternCountValue = memberPatternCount
    };
    patternRow = graph.TypedTemplatePatternRows.Add(row);
    return patternRow != 0;
}

