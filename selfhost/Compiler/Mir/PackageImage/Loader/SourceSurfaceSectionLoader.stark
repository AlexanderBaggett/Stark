internal fn bool LogicalPackageImageJsonImportModuleNameEquals(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] importsNode,
    u32[0 max] importIndex,
    ascii expectedModuleName)
    where overlap(document, expectedModuleName)
{
    stack mut u64[0 2 ** 63 - 1] importNode = 0;
    stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
    if (importsNode == 0
        || !document.TryChildAt(importsNode, (u64[0 2 ** 63 - 1])importIndex, importNode)
        || document.KindAt(importNode) != JsonKind.Object
        || !document.TryFindMember(importNode, "ModuleName", moduleNameNode)
        || document.KindAt(moduleNameNode) != JsonKind.Text)
    {
        return false;
    }

    stack ascii moduleName = document.TextAt(moduleNameNode);
    return System.Text.AsciiLength(moduleName) > 0
        && moduleName == expectedModuleName;
}

internal fn bool LogicalPackageImageJsonReExportModuleNameEquals(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] reExportsNode,
    u32[0 max] reExportIndex,
    ascii expectedModuleName)
    where overlap(document, expectedModuleName)
{
    stack mut u64[0 2 ** 63 - 1] reExportNode = 0;
    stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
    if (reExportsNode == 0
        || !document.TryChildAt(reExportsNode, (u64[0 2 ** 63 - 1])reExportIndex, reExportNode)
        || document.KindAt(reExportNode) != JsonKind.Object
        || !document.TryFindMember(reExportNode, "ModuleName", moduleNameNode)
        || document.KindAt(moduleNameNode) != JsonKind.Text)
    {
        return false;
    }

    stack ascii moduleName = document.TextAt(moduleNameNode);
    return System.Text.AsciiLength(moduleName) > 0
        && moduleName == expectedModuleName;
}

internal fn bool LogicalPackageImageJsonImportListHasModuleName(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] importsNode,
    u32[0 max] importCount,
    ascii moduleName)
    where overlap(document, moduleName)
{
    stack mut u32[0 max] importIndex = 0;
    while willexit (importIndex < importCount)
    {
        if (LogicalPackageImageJsonImportModuleNameEquals(document, importsNode, importIndex, moduleName))
        {
            return true;
        }

        importIndex = importIndex + 1;
    }

    return false;
}

internal fn bool LogicalPackageImageJsonReExportListHasModuleName(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] reExportsNode,
    u32[0 max] reExportCount,
    ascii moduleName)
    where overlap(document, moduleName)
{
    stack mut u32[0 max] reExportIndex = 0;
    while willexit (reExportIndex < reExportCount)
    {
        if (LogicalPackageImageJsonReExportModuleNameEquals(document, reExportsNode, reExportIndex, moduleName))
        {
            return true;
        }

        reExportIndex = reExportIndex + 1;
    }

    return false;
}

internal fn bool LogicalPackageImageJsonSourceSurfaceTypeAliasNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    u32[0 max] typeAliasOrdinal,
    out u64[0 2 ** 63 - 1] typeAliasNode)
{
    typeAliasNode = 0;
    stack mut u64[0 2 ** 63 - 1] typeAliasesNode = 0;
    stack mut u32[0 max] typeAliasCount = 0;
    stack mut u64[0 2 ** 63 - 1] found = 0;
    if (!LogicalPackageImageJsonSourceSurfaceTypeAliasNodes(document, moduleNode, typeAliasesNode, typeAliasCount)
        || typeAliasesNode == 0
        || typeAliasOrdinal >= typeAliasCount
        || !document.TryChildAt(typeAliasesNode, (u64[0 2 ** 63 - 1])typeAliasOrdinal, found)
        || document.KindAt(found) != JsonKind.Object)
    {
        return false;
    }

    typeAliasNode = found;
    return true;
}

