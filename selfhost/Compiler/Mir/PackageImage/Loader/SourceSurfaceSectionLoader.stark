                    inlinePreference,
                    hasInlinePreference)
                || !LogicalPackageImageJsonAppendOptionalTextMember(document, functionNode, "FfiAbi", ffiAbi, hasFfiAbi)
                || !LogicalPackageImageJsonAppendOptionalTextMember(
                    document,
                    functionNode,
                    "BackendOptimizationMode",
                    backendOptimizationMode,
                    hasBackendOptimizationMode)
                || !LogicalPackageImageJsonAppendOptionalTextMember(document, functionNode, "LinkName", linkName, hasLinkName)
                || !LogicalPackageImageJsonOptionalObjectMember(document, functionNode, "Asm", asmNode, hasAsm)
                || !LogicalPackageImageJsonRequiredBoolMemberValue(document, functionNode, "IsFfi", isFfi)
                || !LogicalPackageImageJsonRequiredBoolMemberValue(document, functionNode, "IsStrictFp", isStrictFp)
                || !LogicalPackageImageJsonRequiredBoolMemberValue(
                    document,
                    functionNode,
                    "UseFastCallingConvention",
                    usesFastCallingConvention)
                || !LogicalPackageImageJsonOptionalBoolMemberValue(document, functionNode, "IsHot", isHot)
                || !LogicalPackageImageJsonOptionalBoolMemberValue(document, functionNode, "IsCold", isCold)
                || !LogicalPackageImageJsonOptionalBoolMemberValue(
                    document,
                    functionNode,
                    "HasExplicitInlinePreference",
                    hasExplicitInlinePreference)
                || !LogicalPackageImageJsonOptionalBoolMemberValue(document, functionNode, "IsUnsafe", isUnsafe)
                || !LogicalPackageImageJsonOptionalBoolMemberValue(document, functionNode, "IsVarargs", isVarargs)
                || !LogicalPackageImageJsonOptionalBoolMemberValue(document, functionNode, "IsTailCallable", isTailCallable))
            {
                return false;
            }

            functionSummary = new LogicalPackageSourceSurfaceFunctionSummary()
            {
                ModuleOrdinalValue = moduleOrdinal,
                FunctionOrdinalValue = functionOrdinal,
                ParameterCountValue = parameterCount,
                GenericParameterCountValue = genericParameterCount,
                ComptimeGenericParameterCountValue = comptimeGenericParameterCount,
                TypeParameterConstraintCountValue = typeParameterConstraintCount,
                ThreadSafetyLawPredicateCountValue = threadSafetyLawPredicateCount,
                ValueContractCountValue = valueContractCount,
                DisjointParameterGroupCountValue = disjointParameterGroupCount,
                OverlapParameterGroupCountValue = overlapParameterGroupCount,
                SameParameterGroupCountValue = sameParameterGroupCount,
                PointeeDeadOnReturnParameterNameCountValue = pointeeDeadOnReturnParameterNameCount,
                HasInlinePreferenceValue = hasInlinePreference,
                HasFfiAbiValue = hasFfiAbi,
                HasBackendOptimizationModeValue = hasBackendOptimizationMode,
                HasLinkNameValue = hasLinkName,
                HasAsmValue = hasAsm,
                IsFfiValue = isFfi,
                IsStrictFpValue = isStrictFp,
                UsesFastCallingConventionValue = usesFastCallingConvention,
                IsHotValue = isHot,
                IsColdValue = isCold,
                HasExplicitInlinePreferenceValue = hasExplicitInlinePreference,
                IsUnsafeValue = isUnsafe,
                IsVarargsValue = isVarargs,
                IsTailCallableValue = isTailCallable
            };
            return true;
    }
}

public unsafe fn bool TryReadLogicalPackageSourceSurfaceFunctionParameterJsonSummary(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionOrdinal,
    u32[0 max] parameterOrdinal,
    out LogicalPackageSourceSurfaceFunctionParameterSummary parameterSummary,
    mut borrow OwnedAscii name,
    mut borrow OwnedAscii typeText,
    mut borrow OwnedAscii rawPointerElementCountExpression)
{
    parameterSummary = new();
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] functionNode = 0;
            stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
            stack mut bool isDisjoint = false;
            stack mut bool isConst = false;
            stack mut bool hasRawPointerElementCountExpression = false;
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonSourceSurfaceFunctionNode(
                    document,
                    moduleNode,
                    functionOrdinal,
                    functionNode)
                || !LogicalPackageImageJsonSourceSurfaceFunctionParameterNode(
                    document,
                    functionNode,
                    parameterOrdinal,
                    parameterNode)
                || !LogicalPackageImageJsonAppendRequiredTextMember(document, parameterNode, "Name", name)
                || !LogicalPackageImageJsonAppendRequiredTextMember(document, parameterNode, "Type", typeText)
                || !LogicalPackageImageJsonAppendOptionalTextMember(
                    document,
                    parameterNode,
                    "RawPointerElementCountExpression",
                    rawPointerElementCountExpression,
                    hasRawPointerElementCountExpression)
                || !LogicalPackageImageJsonOptionalBoolMemberValue(document, parameterNode, "IsDisjoint", isDisjoint)
                || !LogicalPackageImageJsonOptionalBoolMemberValue(document, parameterNode, "IsConst", isConst))
            {
                return false;
            }

            parameterSummary = new LogicalPackageSourceSurfaceFunctionParameterSummary()
            {
                ModuleOrdinalValue = moduleOrdinal,
                FunctionOrdinalValue = functionOrdinal,
                ParameterOrdinalValue = parameterOrdinal,
                IsDisjointValue = isDisjoint,
                IsConstValue = isConst,
                HasRawPointerElementCountExpressionValue = hasRawPointerElementCountExpression
            };
            return true;
    }
}
