import Compiler.Mir.PackageImage.Loader.ManifestJsonReader
import Compiler.Mir.PackageImage.Models
import System.Json
import System.Memory
import System.Text
module Compiler.Mir.PackageImage.Loader.SourceSurfaceSectionLoader

// Validates and locates source-surface manifest nodes for later materialization.

internal fn bool LogicalPackageImageJsonSourceSurfaceImportNodes(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    out u64[0 2 ** 63 - 1] importsNode,
    out u32[0 max] importCount,
    out u64[0 2 ** 63 - 1] reExportsNode,
    out u32[0 max] reExportCount)
{
    importsNode = 0;
    importCount = 0;
    reExportsNode = 0;
    reExportCount = 0;
    stack mut u64[0 2 ** 63 - 1] sourceSurfaceNode = 0;
    stack mut bool hasSourceSurface = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "SourceSurface", sourceSurfaceNode, hasSourceSurface))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] ownerNode = moduleNode;
    if (hasSourceSurface)
    {
        ownerNode = sourceSurfaceNode;
    }

    return LogicalPackageImageJsonOptionalArrayMember(document, ownerNode, "Imports", importsNode, importCount)
        && LogicalPackageImageJsonOptionalArrayMember(document, ownerNode, "ReExports", reExportsNode, reExportCount);
}

