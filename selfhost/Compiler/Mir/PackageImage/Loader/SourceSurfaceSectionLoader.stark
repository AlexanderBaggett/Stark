internal fn bool LogicalPackageImageJsonSourceSurfaceTypeAliasGenericParameterNodes(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeAliasNode,
    out u64[0 2 ** 63 - 1] genericParametersNode,
    out u32[0 max] genericParameterCount)
{
    genericParametersNode = 0;
    genericParameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] localGenericParametersNode = 0;
    stack mut u32[0 max] localGenericParameterCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
        document,
        typeAliasNode,
        "GenericParameters",
        localGenericParametersNode,
        localGenericParameterCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < localGenericParameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        if (!document.TryChildAt(localGenericParametersNode, (u64[0 2 ** 63 - 1])index, parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Text
            || System.Text.AsciiLength(document.TextAt(parameterNode)) <= 0)
        {
            return false;
        }

        index = index + 1;
    }

    genericParametersNode = localGenericParametersNode;
    genericParameterCount = localGenericParameterCount;
    return true;
}

internal fn bool LogicalPackageImageJsonSourceSurfaceTypeAliasComptimeGenericParameterCount(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeAliasNode,
    out u32[0 max] comptimeGenericParameterCount)
{
    comptimeGenericParameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] comptimeParametersNode = 0;
    stack mut u32[0 max] localComptimeGenericParameterCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
        document,
        typeAliasNode,
        "ComptimeGenericParameters",
        comptimeParametersNode,
        localComptimeGenericParameterCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < localComptimeGenericParameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        if (!document.TryChildAt(comptimeParametersNode, (u64[0 2 ** 63 - 1])index, parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || !document.TryFindMember(parameterNode, "Name", nameNode)
            || document.KindAt(nameNode) != JsonKind.Text
            || System.Text.AsciiLength(document.TextAt(nameNode)) <= 0
            || !LogicalPackageImageJsonRequiredObjectMember(document, parameterNode, "Type", typeNode))
        {
            return false;
        }

        index = index + 1;
    }

    comptimeGenericParameterCount = localComptimeGenericParameterCount;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeSourceSurfaceImportRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageSourceSurfaceBridgeGraph graph)
{
    stack mut u64[0 2 ** 63 - 1] importsNode = 0;
    stack mut u32[0 max] importCount = 0;
    stack mut u64[0 2 ** 63 - 1] reExportsNode = 0;
    stack mut u32[0 max] reExportCount = 0;
    if (!LogicalPackageImageJsonSourceSurfaceImportNodes(
        document,
        moduleNode,
        importsNode,
        importCount,
        reExportsNode,
        reExportCount))
    {
        return false;
    }

    stack mut u32[0 max] effectiveOrdinal = 0;
    stack mut u32[0 max] importIndex = 0;
    while willexit (importIndex < importCount)
    {
        stack mut u64[0 2 ** 63 - 1] importNode = 0;
        stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
        stack mut bool isExported = false;
        if (!document.TryChildAt(importsNode, (u64[0 2 ** 63 - 1])importIndex, importNode)
            || document.KindAt(importNode) != JsonKind.Object
            || !document.TryFindMember(importNode, "ModuleName", moduleNameNode)
            || document.KindAt(moduleNameNode) != JsonKind.Text
            || !LogicalPackageImageJsonRequiredBoolMemberValue(document, importNode, "IsExported", isExported))
        {
            return false;
        }

        stack ascii importModuleName = document.TextAt(moduleNameNode);
        if (System.Text.AsciiLength(importModuleName) <= 0)
        {
            return false;
        }

        stack bool hasReExport = LogicalPackageImageJsonReExportListHasModuleName(
            document,
            reExportsNode,
            reExportCount,
            importModuleName);
        stack LogicalPackageSourceSurfaceImportSummary row = new LogicalPackageSourceSurfaceImportSummary()
        {
            ModuleOrdinalValue = moduleOrdinal,
            ImportOrdinalValue = effectiveOrdinal,
            HasDirectImportValue = true,
            HasReExportValue = hasReExport,
            IsExportedValue = isExported || hasReExport
        };
        if (graph.ImportRows.Add(row) == 0)
        {
            return false;
        }

        importIndex = importIndex + 1;
        effectiveOrdinal = effectiveOrdinal + 1;
    }

    stack mut u32[0 max] reExportIndex = 0;
    while willexit (reExportIndex < reExportCount)
    {
        stack mut u64[0 2 ** 63 - 1] reExportNode = 0;
        stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
        if (!document.TryChildAt(reExportsNode, (u64[0 2 ** 63 - 1])reExportIndex, reExportNode)
            || document.KindAt(reExportNode) != JsonKind.Object
            || !document.TryFindMember(reExportNode, "ModuleName", moduleNameNode)
            || document.KindAt(moduleNameNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii reExportModuleName = document.TextAt(moduleNameNode);
        if (System.Text.AsciiLength(reExportModuleName) <= 0)
        {
            return false;
        }

        if (!LogicalPackageImageJsonImportListHasModuleName(
                document,
                importsNode,
                importCount,
                reExportModuleName))
        {
            stack LogicalPackageSourceSurfaceImportSummary row = new LogicalPackageSourceSurfaceImportSummary()
            {
                ModuleOrdinalValue = moduleOrdinal,
                ImportOrdinalValue = effectiveOrdinal,
                HasDirectImportValue = false,
                HasReExportValue = true,
                IsExportedValue = true
            };
            if (graph.ImportRows.Add(row) == 0)
            {
                return false;
            }

            effectiveOrdinal = effectiveOrdinal + 1;
        }

        reExportIndex = reExportIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeSourceSurfaceTypeAliasRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageSourceSurfaceBridgeGraph graph)
{
    stack mut u64[0 2 ** 63 - 1] typeAliasesNode = 0;
    stack mut u32[0 max] typeAliasCount = 0;
    if (!LogicalPackageImageJsonSourceSurfaceTypeAliasNodes(
        document,
        moduleNode,
        typeAliasesNode,
        typeAliasCount))
    {
        return false;
    }

    stack mut u32[0 max] typeAliasIndex = 0;
    while willexit (typeAliasIndex < typeAliasCount)
    {
        stack mut u64[0 2 ** 63 - 1] typeAliasNode = 0;
        stack mut u64[0 2 ** 63 - 1] genericParametersNode = 0;
        stack mut u32[0 max] genericParameterCount = 0;
        stack mut u32[0 max] comptimeGenericParameterCount = 0;
        if (!document.TryChildAt(typeAliasesNode, (u64[0 2 ** 63 - 1])typeAliasIndex, typeAliasNode)
            || document.KindAt(typeAliasNode) != JsonKind.Object
            || !LogicalPackageImageJsonRequiredTextMemberPresent(document, typeAliasNode, "Name")
            || !LogicalPackageImageJsonRequiredTextMemberPresent(document, typeAliasNode, "QualifiedName")
            || !LogicalPackageImageJsonRequiredTextMemberPresent(document, typeAliasNode, "Visibility")
            || !LogicalPackageImageJsonRequiredTextMemberPresent(document, typeAliasNode, "TargetType")
            || !LogicalPackageImageJsonSourceSurfaceTypeAliasGenericParameterNodes(
                document,
                typeAliasNode,
                genericParametersNode,
                genericParameterCount)
            || !LogicalPackageImageJsonSourceSurfaceTypeAliasComptimeGenericParameterCount(
                document,
                typeAliasNode,
                comptimeGenericParameterCount))
        {
            return false;
        }

        stack LogicalPackageSourceSurfaceTypeAliasSummary aliasRow =
            new LogicalPackageSourceSurfaceTypeAliasSummary()
            {
                ModuleOrdinalValue = moduleOrdinal,
                TypeAliasOrdinalValue = typeAliasIndex,
                GenericParameterCountValue = genericParameterCount,
                ComptimeGenericParameterCountValue = comptimeGenericParameterCount
            };
        if (graph.TypeAliasRows.Add(aliasRow) == 0)
        {
            return false;
        }

        stack mut u32[0 max] parameterIndex = 0;
        while willexit (parameterIndex < genericParameterCount)
        {
            stack LogicalPackageSourceSurfaceTypeAliasGenericParameterSummary parameterRow =
                new LogicalPackageSourceSurfaceTypeAliasGenericParameterSummary()
                {
                    ModuleOrdinalValue = moduleOrdinal,
                    TypeAliasOrdinalValue = typeAliasIndex,
                    ParameterOrdinalValue = parameterIndex
                };
            if (graph.TypeAliasGenericParameterRows.Add(parameterRow) == 0)
            {
                return false;
            }

            parameterIndex = parameterIndex + 1;
        }

        typeAliasIndex = typeAliasIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeSourceSurfaceTypeFieldRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] fieldsNode,
    u32[0 max] fieldCount,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeOrdinal,
    mut borrow LogicalPackageSourceSurfaceBridgeGraph graph)
{
    stack mut u32[0 max] fieldIndex = 0;
    while willexit (fieldIndex < fieldCount)
    {
        stack mut u64[0 2 ** 63 - 1] fieldNode = 0;
        stack mut u32[0 max] threadSafetyLawAttributeCount = 0;
        stack mut u32[0 max] explicitOffsetBytes = 0;
        stack mut bool hasVisibility = false;
        stack mut bool hasExplicitOffsetBytes = false;
        if (!document.TryChildAt(fieldsNode, (u64[0 2 ** 63 - 1])fieldIndex, fieldNode)
            || document.KindAt(fieldNode) != JsonKind.Object
            || !LogicalPackageImageJsonRequiredTextMemberPresent(document, fieldNode, "Name")
            || !LogicalPackageImageJsonRequiredTextMemberPresent(document, fieldNode, "Type")
            || !LogicalPackageImageJsonMemberIsPresentText(document, fieldNode, "Visibility", hasVisibility)
            || !LogicalPackageImageJsonOptionalU32MemberValue(
                document,
                fieldNode,
                "ExplicitOffsetBytes",
                hasExplicitOffsetBytes,
                explicitOffsetBytes)
            || !LogicalPackageImageJsonOptionalArrayMemberCount(
                document,
                fieldNode,
                "ThreadSafetyLawAttributes",
                threadSafetyLawAttributeCount))
        {
            return false;
        }

        stack LogicalPackageSourceSurfaceTypeFieldSummary row =
            new LogicalPackageSourceSurfaceTypeFieldSummary()
            {
                ModuleOrdinalValue = moduleOrdinal,
                TypeOrdinalValue = typeOrdinal,
                FieldOrdinalValue = fieldIndex,
                ThreadSafetyLawAttributeCountValue = threadSafetyLawAttributeCount,
                ExplicitOffsetBytesValue = explicitOffsetBytes,
                HasVisibilityValue = hasVisibility,
                HasExplicitOffsetBytesValue = hasExplicitOffsetBytes
            };
        if (graph.TypeFieldRows.Add(row) == 0)
        {
            return false;
        }

        fieldIndex = fieldIndex + 1;
    }

    return true;
}

