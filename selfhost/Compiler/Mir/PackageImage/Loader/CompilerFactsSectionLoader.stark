    if (layout.VariantRowCountValue == 0)
    {
        layout.FirstVariantRowValue = addedVariantRow;
    }
    else if (addedVariantRow != layout.FirstVariantRowValue + layout.VariantRowCountValue)
    {
        return false;
    }

    layout.VariantRowCountValue = layout.VariantRowCountValue + 1;
    if (!graph.EnumLayoutRows.Replace(enumLayoutRow, layout))
    {
        return false;
