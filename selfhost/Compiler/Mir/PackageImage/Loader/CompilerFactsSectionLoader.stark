        index = index + 1;
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageImageJsonMaterializeFunctionSemanticFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageFunctionSemanticFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageFunctionSemanticFactGraph graph,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    return LogicalPackageFunctionSemanticFactGraphAddTextRow(
        graph,
        textKind,
        textOrdinal,
        value,
        textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeOptionalFunctionSemanticFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageFunctionSemanticFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageFunctionSemanticFactGraph graph,
    out bool present,
    out u32[0 max] textRow)
{
    present = false;
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    if (!LogicalPackageFunctionSemanticFactGraphAddTextRow(
        graph,
        textKind,
        textOrdinal,
        value,
        textRow))
    {
        return false;
    }

    present = true;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeFunctionMemoryEffectFacts(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] memoryEffectsNode,
    out LogicalPackageFunctionMemoryEffectFacts facts)
{
    facts = new();
    stack mut bool readsArgumentMemory = false;
    stack mut bool writesArgumentMemory = false;
    stack mut bool capturesArgumentMemory = false;
    stack mut bool readsOtherMemory = false;
    stack mut bool writesOtherMemory = false;
    stack mut bool initializesArgumentMemory = false;
    stack mut bool hasPointeeDeadOnReturnArgument = false;
    if (!LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            memoryEffectsNode,
            "ReadsArgumentMemory",
            readsArgumentMemory)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            memoryEffectsNode,
            "WritesArgumentMemory",
            writesArgumentMemory)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            memoryEffectsNode,
            "CapturesArgumentMemory",
            capturesArgumentMemory)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            memoryEffectsNode,
            "ReadsOtherMemory",
            readsOtherMemory)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            memoryEffectsNode,
            "WritesOtherMemory",
            writesOtherMemory)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            memoryEffectsNode,
            "InitializesArgumentMemory",
            initializesArgumentMemory)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            memoryEffectsNode,
            "HasPointeeDeadOnReturnArgument",
            hasPointeeDeadOnReturnArgument))
    {
        return false;
    }

    facts = new LogicalPackageFunctionMemoryEffectFacts()
    {
        ReadsArgumentMemoryValue = readsArgumentMemory,
        WritesArgumentMemoryValue = writesArgumentMemory,
        CapturesArgumentMemoryValue = capturesArgumentMemory,
        ReadsOtherMemoryValue = readsOtherMemory,
        WritesOtherMemoryValue = writesOtherMemory,
        InitializesArgumentMemoryValue = initializesArgumentMemory,
        HasPointeeDeadOnReturnArgumentValue = hasPointeeDeadOnReturnArgument
    };
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeFunctionSemanticCalledFunctionRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] functionSemanticNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionSemanticOrdinal,
    u32[0 max] functionSemanticRow,
    mut borrow LogicalPackageFunctionSemanticFactGraph graph,
    out u32[0 max] calledFunctionCount)
{
    calledFunctionCount = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(
        document,
        functionSemanticNode,
        "CalledFunctions",
        arrayNode,
        calledFunctionCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < calledFunctionCount)
    {
        stack mut u64[0 2 ** 63 - 1] calledFunctionNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, calledFunctionNode)
            || document.KindAt(calledFunctionNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii name = document.TextAt(calledFunctionNode);
        if (System.Text.AsciiLength(name) <= 0
            || !LogicalPackageFunctionSemanticFactGraphAddTextRow(
                graph,
                LogicalPackageFunctionSemanticFactTextKind.CalledFunctionName,
                index,
                name,
                nameTextRow)
            || !LogicalPackageFunctionSemanticFactGraphAddCalledFunctionRow(
                graph,
                functionSemanticRow,
                moduleOrdinal,
                functionSemanticOrdinal,
                index,
                nameTextRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

