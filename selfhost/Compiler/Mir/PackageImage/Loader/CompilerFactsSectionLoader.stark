    i64[min max] locationColumn,
    out u32[0 max] eventRow)
{
    eventRow = 0;
    if (!graph.FunctionOwnershipRows.Contains(functionOwnershipRow)
        || !graph.TextRows.Contains(kindTextRow)
        || !graph.TextRows.Contains(rootNameTextRow)
        || !graph.TypeReferences.ContainsTypeReference(placeTypeReferenceRow)
        || (hasLocationFilePath && !graph.TextRows.Contains(locationFilePathTextRow))
        || (!hasLocationFilePath && locationFilePathTextRow != 0)
        || (!hasLocation && (hasLocationFilePath || locationLine != 0 || locationColumn != 0)))
    {
        return false;
    }

    stack LogicalPackageFunctionOwnershipEventRow row = new LogicalPackageFunctionOwnershipEventRow()
    {
        FunctionOwnershipRowValue = functionOwnershipRow,
        ModuleOrdinalValue = moduleOrdinal,
        FunctionSemanticOrdinalValue = functionSemanticOrdinal,
