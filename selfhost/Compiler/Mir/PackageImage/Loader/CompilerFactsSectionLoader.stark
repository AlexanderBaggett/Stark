    {
        stack mut u64[0 2 ** 63 - 1] layoutNode = 0;
        stack mut u64[0 2 ** 63 - 1] tagFieldNode = 0;
        stack mut u64[0 2 ** 63 - 1] tagFieldTypeNode = 0;
        stack mut u64[0 2 ** 63 - 1] kindNode = 0;
        stack mut u32[0 max] qualifiedTypeNameTextRow = 0;
        stack mut u32[0 max] kindTextRow = 0;
        stack mut u32[0 max] tagFieldNameTextRow = 0;
        stack mut u32[0 max] tagFieldTypeReferenceRow = 0;
        stack mut LogicalPackageEnumLayoutKind kind = LogicalPackageEnumLayoutKind.DirectTag;
