            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                functionSemanticNode,
                "Ownership",
                ownershipNode,
                hasOwnership))
        {
            return false;
        }

        if (!hasOwnership)
        {
            index = index + 1;
            continue;
        }

        stack mut bool ownershipValid = false;
        stack mut u32[0 max] qualifiedResolvedNameTextRow = 0;
        stack mut u32[0 max] functionOwnershipRow = 0;
        stack mut u32[0 max] implicitDropCount = 0;
        stack mut u32[0 max] moveCount = 0;
        stack mut u32[0 max] eventCount = 0;
        stack mut u32[0 max] rootCount = 0;
        if (!LogicalPackageImageJsonMaterializeFunctionOwnershipFactTextMemberRow(
                document,
                functionSemanticNode,
                "QualifiedResolvedName",
                LogicalPackageFunctionOwnershipFactTextKind.QualifiedResolvedName,
                index,
                graph,
                qualifiedResolvedNameTextRow)
            || !LogicalPackageImageJsonRequiredBoolMemberValue(
                document,
                ownershipNode,
                "OwnershipValid",
                ownershipValid)
            || !LogicalPackageFunctionOwnershipFactGraphAddFunctionOwnershipRow(
                graph,
                moduleOrdinal,
                index,
                qualifiedResolvedNameTextRow,
                ownershipValid,
                functionOwnershipRow)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipNameRows(
                document,
                ownershipNode,
                "ImplicitDrops",
                LogicalPackageFunctionOwnershipFactTextKind.ImplicitDropName,
                true,
                moduleOrdinal,
                index,
                functionOwnershipRow,
                graph,
                implicitDropCount)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipNameRows(
                document,
                ownershipNode,
                "Moves",
                LogicalPackageFunctionOwnershipFactTextKind.MoveName,
                false,
                moduleOrdinal,
                index,
                functionOwnershipRow,
                graph,
                moveCount)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipEventRows(
                document,
                ownershipNode,
                moduleOrdinal,
                index,
                functionOwnershipRow,
                graph,
                eventCount)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipRootRows(
                document,
                ownershipNode,
                moduleOrdinal,
                index,
                functionOwnershipRow,
                graph,
                rootCount))
        {
            return false;
        }

        functionOwnershipCount = functionOwnershipCount + 1;
        index = index + 1;
    }

    return true;
}

