internal fn bool LogicalPackageImageJsonMaterializeLinkageRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] compilerFactsNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    out bool hasLinkage)
{
    hasLinkage = false;
    stack mut u64[0 2 ** 63 - 1] linkageNode = 0;
    if (!LogicalPackageImageJsonOptionalObjectMember(
        document,
        compilerFactsNode,
        "Linkage",
        linkageNode,
        hasLinkage))
    {
        return false;
    }

    if (!hasLinkage)
    {
        return true;
    }

    stack mut u32[0 max] objectFileNameTextRow = 0;
    stack mut u32[0 max] linkageRow = 0;
    stack mut u32[0 max] definedSymbolCount = 0;
    stack mut u32[0 max] referencedSymbolCount = 0;
    return LogicalPackageImageJsonMaterializeNativeMetadataFactTextMemberRow(
            document,
            linkageNode,
            "ObjectFileName",
            LogicalPackageNativeMetadataFactTextKind.LinkageObjectFileName,
            0,
            graph,
            objectFileNameTextRow)
        && LogicalPackageNativeMetadataFactGraphAddLinkageRow(
            graph,
            moduleOrdinal,
            objectFileNameTextRow,
            linkageRow)
        && LogicalPackageImageJsonMaterializeLinkageDefinedSymbolRows(
            document,
            linkageNode,
            linkageRow,
            graph,
            definedSymbolCount)
        && LogicalPackageImageJsonMaterializeLinkageReferencedSymbolRows(
            document,
            linkageNode,
            linkageRow,
            graph,
            referencedSymbolCount);
}

internal fn bool LogicalPackageImageJsonMaterializeNativeMetadataFactRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] manifestNode,
    u64[0 2 ** 63 - 1] compilerFactsNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    out u32[0 max] nativeDependencyCount,
    out bool hasLinkage)
{
    nativeDependencyCount = 0;
    hasLinkage = false;
    return LogicalPackageImageJsonMaterializeNativeDependencyRows(
            document,
            manifestNode,
            graph,
            nativeDependencyCount)
        && LogicalPackageImageJsonMaterializeLinkageRows(
            document,
            compilerFactsNode,
            moduleOrdinal,
            graph,
            hasLinkage);
}

public unsafe fn bool TryMaterializeLogicalPackageNativeMetadataFactJsonGraph(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageNativeMetadataFactGraph graph)
{
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] compilerFactsNode = 0;
            stack mut bool usesCompilerSections = false;
            stack mut u32[0 max] nativeDependencyCount = 0;
            stack mut bool hasLinkage = false;
            if (document.KindAt(0) != JsonKind.Object
                || !LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonEffectiveCompilerFactsNode(
                    document,
                    moduleNode,
                    compilerFactsNode,
                    usesCompilerSections))
            {
                return false;
            }

            return LogicalPackageImageJsonMaterializeNativeMetadataFactRows(
                document,
                0,
                compilerFactsNode,
                moduleOrdinal,
                graph,
                nativeDependencyCount,
                hasLinkage);
    }
}

internal fn MemoryStatus LogicalPackageFunctionSemanticFactGraphAppendText(
    mut borrow LogicalPackageFunctionSemanticFactGraph graph,
    ascii text,
    out u32[0 max] byteOffset,
    out u32[0 max] byteLength)
{
    byteOffset = 0;
    byteLength = 0;
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength <= 0 || signedLength > (i64[min max])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (graph.TextBytes.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || graph.TextBytes.Length + (u64[0 2 ** 63 - 1])signedLength > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    byteOffset = (u32[0 max])graph.TextBytes.Length;
    byteLength = (u32[0 max])signedLength;
    unsafe
    {
        stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
        if (data == null)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        if (!graph.TextBytes.TryReserve((u64[0 2 ** 63 - 1])signedLength))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            init graph.TextBytes[graph.TextBytes.Length] = *(&data[index]);
        }
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageFunctionSemanticFactGraphAddTextRow(
    mut borrow LogicalPackageFunctionSemanticFactGraph graph,
    LogicalPackageFunctionSemanticFactTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u32[0 max] byteOffset = 0;
    stack mut u32[0 max] byteLength = 0;
    switch (LogicalPackageFunctionSemanticFactGraphAppendText(graph, text, byteOffset, byteLength))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            stack LogicalPackageFunctionSemanticFactTextRow row =
                new LogicalPackageFunctionSemanticFactTextRow()
            {
                TextKindValue = textKind,
                TextOrdinalValue = textOrdinal,
                ByteOffsetValue = byteOffset,
                ByteLengthValue = byteLength
            };
            textRow = graph.TextRows.Add(row);
            return textRow != 0;
    }
}

internal fn bool LogicalPackageFunctionSemanticFactGraphAddFunctionSemanticRow(
    mut borrow LogicalPackageFunctionSemanticFactGraph graph,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionSemanticOrdinal,
    u32[0 max] qualifiedResolvedNameTextRow,
    u32[0 max] declaredKindTextRow,
    u32[0 max] effectiveKindTextRow,
    bool hasMemoryEffects,
    LogicalPackageFunctionMemoryEffectFacts memoryEffects,
    bool hasExplicitHasOpaqueCall,
    bool hasOpaqueCall,
    out u32[0 max] functionSemanticRow)
{
    functionSemanticRow = 0;
    if (!graph.TextRows.Contains(qualifiedResolvedNameTextRow)
        || !graph.TextRows.Contains(declaredKindTextRow)
        || !graph.TextRows.Contains(effectiveKindTextRow))
    {
        return false;
    }

    stack LogicalPackageFunctionSemanticRow row = new LogicalPackageFunctionSemanticRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        FunctionSemanticOrdinalValue = functionSemanticOrdinal,
        QualifiedResolvedNameTextRowValue = qualifiedResolvedNameTextRow,
        DeclaredKindTextRowValue = declaredKindTextRow,
        EffectiveKindTextRowValue = effectiveKindTextRow,
        MemoryEffectsValue = memoryEffects,
        HasMemoryEffectsValue = hasMemoryEffects,
        HasExplicitHasOpaqueCallValue = hasExplicitHasOpaqueCall,
        HasOpaqueCallValue = hasOpaqueCall
    };
    functionSemanticRow = graph.FunctionSemanticRows.Add(row);
    return functionSemanticRow != 0;
}

internal fn bool LogicalPackageFunctionSemanticFactGraphAddCalledFunctionRow(
    mut borrow LogicalPackageFunctionSemanticFactGraph graph,
    u32[0 max] functionSemanticRow,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionSemanticOrdinal,
    u32[0 max] calledFunctionOrdinal,
    u32[0 max] nameTextRow)
{
    if (!graph.FunctionSemanticRows.Contains(functionSemanticRow)
        || !graph.TextRows.Contains(nameTextRow))
    {
        return false;
    }

    stack LogicalPackageFunctionSemanticCalledFunctionRow row =
        new LogicalPackageFunctionSemanticCalledFunctionRow()
    {
        FunctionSemanticRowValue = functionSemanticRow,
        ModuleOrdinalValue = moduleOrdinal,
        FunctionSemanticOrdinalValue = functionSemanticOrdinal,
        CalledFunctionOrdinalValue = calledFunctionOrdinal,
        NameTextRowValue = nameTextRow
    };
    stack u32[0 max] addedRow = graph.CalledFunctionRows.Add(row);
    if (addedRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageFunctionSemanticRow parent =
        graph.FunctionSemanticRows.Get(functionSemanticRow);
    if (parent.CalledFunctionRowCountValue == 0)
    {
        parent.FirstCalledFunctionRowValue = addedRow;
    }
    else if (addedRow != parent.FirstCalledFunctionRowValue + parent.CalledFunctionRowCountValue)
    {
        return false;
    }

    parent.CalledFunctionRowCountValue = parent.CalledFunctionRowCountValue + 1;
    return graph.FunctionSemanticRows.Replace(functionSemanticRow, parent);
}

internal fn bool LogicalPackageFunctionSemanticFactGraphAddParameterRow(
    mut borrow LogicalPackageFunctionSemanticFactGraph graph,
    u32[0 max] functionSemanticRow,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionSemanticOrdinal,
    u32[0 max] parameterOrdinal,
    u32[0 max] nameTextRow,
    u32[0 max] typeTextRow,
    u32[0 max] captureKindTextRow,
    bool isMemoryBacked,
    bool guaranteedNonNull,
    bool guaranteedReadOnly,
    bool guaranteedWriteOnly,
    bool guaranteedNoAlias,
    bool hasDereferenceableBytes,
    u32[0 max] dereferenceableBytes,
    bool hasAlignmentBytes,
    u32[0 max] alignmentBytes,
    bool reads,
    bool writes,
    bool pointeeDeadOnReturn,
    out u32[0 max] parameterRow)
{
    parameterRow = 0;
    if (!graph.FunctionSemanticRows.Contains(functionSemanticRow)
        || !graph.TextRows.Contains(nameTextRow)
        || !graph.TextRows.Contains(typeTextRow)
        || !graph.TextRows.Contains(captureKindTextRow)
        || (!hasDereferenceableBytes && dereferenceableBytes != 0)
        || (!hasAlignmentBytes && alignmentBytes != 0))
    {
        return false;
    }

    stack LogicalPackageFunctionSemanticParameterRow row =
        new LogicalPackageFunctionSemanticParameterRow()
    {
        FunctionSemanticRowValue = functionSemanticRow,
        ModuleOrdinalValue = moduleOrdinal,
        FunctionSemanticOrdinalValue = functionSemanticOrdinal,
        ParameterOrdinalValue = parameterOrdinal,
        NameTextRowValue = nameTextRow,
        TypeTextRowValue = typeTextRow,
        CaptureKindTextRowValue = captureKindTextRow,
        DereferenceableBytesValue = dereferenceableBytes,
        AlignmentBytesValue = alignmentBytes,
        IsMemoryBackedValue = isMemoryBacked,
        GuaranteedNonNullValue = guaranteedNonNull,
        GuaranteedReadOnlyValue = guaranteedReadOnly,
        GuaranteedWriteOnlyValue = guaranteedWriteOnly,
        GuaranteedNoAliasValue = guaranteedNoAlias,
        HasDereferenceableBytesValue = hasDereferenceableBytes,
        HasAlignmentBytesValue = hasAlignmentBytes,
        ReadsValue = reads,
        WritesValue = writes,
        PointeeDeadOnReturnValue = pointeeDeadOnReturn
    };
    stack u32[0 max] addedRow = graph.ParameterRows.Add(row);
    if (addedRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageFunctionSemanticRow parent =
        graph.FunctionSemanticRows.Get(functionSemanticRow);
    if (parent.ParameterRowCountValue == 0)
    {
        parent.FirstParameterRowValue = addedRow;
    }
    else if (addedRow != parent.FirstParameterRowValue + parent.ParameterRowCountValue)
    {
        return false;
    }

    parent.ParameterRowCountValue = parent.ParameterRowCountValue + 1;
    if (!graph.FunctionSemanticRows.Replace(functionSemanticRow, parent))
    {
        return false;
    }

    parameterRow = addedRow;
    return true;
}

