        }
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageAbiFactGraphAddTextRow(
    mut borrow LogicalPackageAbiFactGraph graph,
    LogicalPackageAbiFactTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u32[0 max] byteOffset = 0;
    stack mut u32[0 max] byteLength = 0;
    switch (LogicalPackageAbiFactGraphAppendText(graph, text, byteOffset, byteLength))
    {
        case MemoryStatus.Err(var error):
            return false;
