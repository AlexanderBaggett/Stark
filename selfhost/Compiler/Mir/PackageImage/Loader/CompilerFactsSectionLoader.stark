internal fn bool LogicalPackageImageJsonMaterializeLayoutFactRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] compilerFactsNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageLayoutFactGraph graph,
    out u32[0 max] concreteLayoutCount,
    out u32[0 max] enumLayoutCount)
{
    concreteLayoutCount = 0;
    enumLayoutCount = 0;
    return LogicalPackageImageJsonMaterializeConcreteLayoutRows(
            document,
            compilerFactsNode,
            moduleOrdinal,
            graph,
            concreteLayoutCount)
        && LogicalPackageImageJsonMaterializeEnumLayoutRows(
            document,
            compilerFactsNode,
            moduleOrdinal,
            graph,
            enumLayoutCount);
}

public unsafe fn bool TryMaterializeLogicalPackageLayoutFactJsonGraph(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageLayoutFactGraph graph)
{
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] compilerFactsNode = 0;
            stack mut bool usesCompilerSections = false;
            stack mut u32[0 max] concreteLayoutCount = 0;
            stack mut u32[0 max] enumLayoutCount = 0;
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonEffectiveCompilerFactsNode(
                    document,
                    moduleNode,
                    compilerFactsNode,
                    usesCompilerSections))
            {
                return false;
            }

            return LogicalPackageImageJsonMaterializeLayoutFactRows(
                document,
                compilerFactsNode,
                moduleOrdinal,
                graph,
                concreteLayoutCount,
                enumLayoutCount);
    }
}

internal fn MemoryStatus LogicalPackageNativeMetadataFactGraphAppendText(
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    ascii text,
    out u32[0 max] byteOffset,
    out u32[0 max] byteLength)
{
    byteOffset = 0;
    byteLength = 0;
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength <= 0 || signedLength > (i64[min max])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (graph.TextBytes.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || graph.TextBytes.Length + (u64[0 2 ** 63 - 1])signedLength > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    byteOffset = (u32[0 max])graph.TextBytes.Length;
    byteLength = (u32[0 max])signedLength;
    unsafe
    {
        stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
        if (data == null)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        if (!graph.TextBytes.TryReserve((u64[0 2 ** 63 - 1])signedLength))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            init graph.TextBytes[graph.TextBytes.Length] = *(&data[index]);
        }
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageNativeMetadataFactGraphAddTextRow(
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    LogicalPackageNativeMetadataFactTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u32[0 max] byteOffset = 0;
    stack mut u32[0 max] byteLength = 0;
    switch (LogicalPackageNativeMetadataFactGraphAppendText(graph, text, byteOffset, byteLength))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            stack LogicalPackageNativeMetadataFactTextRow row =
                new LogicalPackageNativeMetadataFactTextRow()
            {
                TextKindValue = textKind,
                TextOrdinalValue = textOrdinal,
                ByteOffsetValue = byteOffset,
                ByteLengthValue = byteLength
            };
            textRow = graph.TextRows.Add(row);
            return textRow != 0;
    }
}

internal fn bool LogicalPackageNativeMetadataFactGraphAddNativeDependencyRow(
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    LogicalPackageNativeDependencyKind kind,
    u32[0 max] dependencyOrdinal,
    u32[0 max] textRow,
    out u32[0 max] dependencyRow)
{
    dependencyRow = 0;
    if (!graph.TextRows.Contains(textRow))
    {
        return false;
    }

    stack LogicalPackageNativeDependencyRow row = new LogicalPackageNativeDependencyRow()
    {
        KindValue = kind,
        DependencyOrdinalValue = dependencyOrdinal,
        TextRowValue = textRow
    };
    dependencyRow = graph.NativeDependencyRows.Add(row);
    return dependencyRow != 0;
}

internal fn bool LogicalPackageNativeMetadataFactGraphAddLinkageRow(
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    u32[0 max] moduleOrdinal,
    u32[0 max] objectFileNameTextRow,
    out u32[0 max] linkageRow)
{
    linkageRow = 0;
    if (!graph.TextRows.Contains(objectFileNameTextRow))
    {
        return false;
    }

    stack LogicalPackageLinkageRow row = new LogicalPackageLinkageRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        ObjectFileNameTextRowValue = objectFileNameTextRow
    };
    linkageRow = graph.LinkageRows.Add(row);
    return linkageRow != 0;
}

internal fn bool LogicalPackageNativeMetadataFactGraphAddDefinedSymbolRow(
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    u32[0 max] linkageRow,
    u32[0 max] symbolOrdinal,
    u32[0 max] textRow,
    out u32[0 max] symbolRow)
{
    symbolRow = 0;
    if (!graph.LinkageRows.Contains(linkageRow)
        || !graph.TextRows.Contains(textRow))
    {
        return false;
    }

    stack LogicalPackageLinkageSymbolRow row = new LogicalPackageLinkageSymbolRow()
    {
        LinkageRowValue = linkageRow,
        SymbolOrdinalValue = symbolOrdinal,
        TextRowValue = textRow
    };
    stack u32[0 max] addedSymbolRow = graph.DefinedSymbolRows.Add(row);
    if (addedSymbolRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageLinkageRow linkage = graph.LinkageRows.Get(linkageRow);
    if (linkage.DefinedSymbolRowCountValue == 0)
    {
        linkage.FirstDefinedSymbolRowValue = addedSymbolRow;
    }
    else if (addedSymbolRow != linkage.FirstDefinedSymbolRowValue + linkage.DefinedSymbolRowCountValue)
    {
        return false;
    }

    linkage.DefinedSymbolRowCountValue = linkage.DefinedSymbolRowCountValue + 1;
    if (!graph.LinkageRows.Replace(linkageRow, linkage))
    {
        return false;
    }

    symbolRow = addedSymbolRow;
    return true;
}

internal fn bool LogicalPackageNativeMetadataFactGraphAddReferencedSymbolRow(
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    u32[0 max] linkageRow,
    u32[0 max] symbolOrdinal,
    u32[0 max] textRow,
    out u32[0 max] symbolRow)
{
    symbolRow = 0;
    if (!graph.LinkageRows.Contains(linkageRow)
        || !graph.TextRows.Contains(textRow))
    {
        return false;
    }

    stack LogicalPackageLinkageSymbolRow row = new LogicalPackageLinkageSymbolRow()
    {
        LinkageRowValue = linkageRow,
        SymbolOrdinalValue = symbolOrdinal,
        TextRowValue = textRow
    };
    stack u32[0 max] addedSymbolRow = graph.ReferencedSymbolRows.Add(row);
    if (addedSymbolRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageLinkageRow linkage = graph.LinkageRows.Get(linkageRow);
    if (linkage.ReferencedSymbolRowCountValue == 0)
    {
        linkage.FirstReferencedSymbolRowValue = addedSymbolRow;
    }
    else if (addedSymbolRow != linkage.FirstReferencedSymbolRowValue + linkage.ReferencedSymbolRowCountValue)
    {
        return false;
    }

    linkage.ReferencedSymbolRowCountValue = linkage.ReferencedSymbolRowCountValue + 1;
    if (!graph.LinkageRows.Replace(linkageRow, linkage))
    {
        return false;
    }

    symbolRow = addedSymbolRow;
    return true;
}

public fn MemoryStatus AppendLogicalPackageNativeMetadataFactText(
    borrow LogicalPackageNativeMetadataFactGraph graph,
    LogicalPackageNativeMetadataFactTextRow textRow,
    mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] start = (u64[0 2 ** 63 - 1])textRow.ByteOffsetValue;
    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])textRow.ByteLengthValue;
    if (start + length > graph.TextBytes.Length)
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < length)
    {
        try sink.AppendByte(graph.TextBytes[start + index]);
        index = index + 1;
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageImageJsonMaterializeNativeMetadataFactTextNodeRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] textNode,
    LogicalPackageNativeMetadataFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    out u32[0 max] textRow)
{
    textRow = 0;
    if (document.KindAt(textNode) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(textNode);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    return LogicalPackageNativeMetadataFactGraphAddTextRow(
        graph,
        textKind,
        textOrdinal,
        value,
        textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeNativeMetadataFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageNativeMetadataFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member))
    {
        return false;
    }

    return LogicalPackageImageJsonMaterializeNativeMetadataFactTextNodeRow(
        document,
        member,
        textKind,
        textOrdinal,
        graph,
        textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeNativeDependencyArrayRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] nativeDependenciesNode,
    ascii memberName,
    LogicalPackageNativeDependencyKind dependencyKind,
    LogicalPackageNativeMetadataFactTextKind textKind,
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    out u32[0 max] addedCount)
{
    addedCount = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    stack mut u32[0 max] itemCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
        document,
        nativeDependenciesNode,
        memberName,
        arrayNode,
        itemCount))
    {
        return false;
    }

    stack mut u32[0 max] itemIndex = 0;
    while willexit (itemIndex < itemCount)
    {
        stack mut u64[0 2 ** 63 - 1] itemNode = 0;
        stack mut u32[0 max] textRow = 0;
        stack mut u32[0 max] dependencyRow = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])itemIndex, itemNode)
            || !LogicalPackageImageJsonMaterializeNativeMetadataFactTextNodeRow(
                document,
                itemNode,
                textKind,
                itemIndex,
                graph,
                textRow)
            || !LogicalPackageNativeMetadataFactGraphAddNativeDependencyRow(
                graph,
                dependencyKind,
                itemIndex,
                textRow,
                dependencyRow))
        {
            return false;
        }

        addedCount = addedCount + 1;
        itemIndex = itemIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeNativeDependencyRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] manifestNode,
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    out u32[0 max] nativeDependencyCount)
{
    nativeDependencyCount = 0;
    stack mut u64[0 2 ** 63 - 1] nativeDependenciesNode = 0;
    stack mut bool hasNativeDependencies = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(
        document,
        manifestNode,
        "NativeDependencies",
        nativeDependenciesNode,
        hasNativeDependencies))
    {
        return false;
    }

    if (!hasNativeDependencies)
    {
        return true;
    }

    stack mut u32[0 max] sources = 0;
    stack mut u32[0 max] includeDirectories = 0;
    stack mut u32[0 max] libraryDirectories = 0;
    stack mut u32[0 max] libraries = 0;
    stack mut u32[0 max] linkArguments = 0;
    stack mut u32[0 max] pkgConfigPackages = 0;
    if (!LogicalPackageImageJsonMaterializeNativeDependencyArrayRows(
            document,
            nativeDependenciesNode,
            "Sources",
            LogicalPackageNativeDependencyKind.Source,
            LogicalPackageNativeMetadataFactTextKind.NativeSource,
            graph,
            sources)
        || !LogicalPackageImageJsonMaterializeNativeDependencyArrayRows(
            document,
            nativeDependenciesNode,
            "IncludeDirectories",
            LogicalPackageNativeDependencyKind.IncludeDirectory,
            LogicalPackageNativeMetadataFactTextKind.NativeIncludeDirectory,
            graph,
            includeDirectories)
        || !LogicalPackageImageJsonMaterializeNativeDependencyArrayRows(
            document,
            nativeDependenciesNode,
            "LibraryDirectories",
            LogicalPackageNativeDependencyKind.LibraryDirectory,
            LogicalPackageNativeMetadataFactTextKind.NativeLibraryDirectory,
            graph,
            libraryDirectories)
        || !LogicalPackageImageJsonMaterializeNativeDependencyArrayRows(
            document,
            nativeDependenciesNode,
            "Libraries",
            LogicalPackageNativeDependencyKind.Library,
            LogicalPackageNativeMetadataFactTextKind.NativeLibrary,
            graph,
            libraries)
        || !LogicalPackageImageJsonMaterializeNativeDependencyArrayRows(
            document,
            nativeDependenciesNode,
            "LinkArguments",
            LogicalPackageNativeDependencyKind.LinkArgument,
            LogicalPackageNativeMetadataFactTextKind.NativeLinkArgument,
            graph,
            linkArguments)
        || !LogicalPackageImageJsonMaterializeNativeDependencyArrayRows(
            document,
            nativeDependenciesNode,
            "PkgConfigPackages",
            LogicalPackageNativeDependencyKind.PkgConfigPackage,
            LogicalPackageNativeMetadataFactTextKind.NativePkgConfigPackage,
            graph,
            pkgConfigPackages))
    {
        return false;
    }

    nativeDependencyCount =
        sources + includeDirectories + libraryDirectories + libraries + linkArguments + pkgConfigPackages;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeLinkageDefinedSymbolRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] linkageNode,
    u32[0 max] linkageRow,
    mut borrow LogicalPackageNativeMetadataFactGraph graph,
    out u32[0 max] symbolCount)
{
    symbolCount = 0;
    stack mut u64[0 2 ** 63 - 1] symbolsNode = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(
        document,
        linkageNode,
        "DefinedSymbols",
        symbolsNode,
        symbolCount))
    {
        return false;
    }

    stack mut u32[0 max] symbolIndex = 0;
    while willexit (symbolIndex < symbolCount)
    {
        stack mut u64[0 2 ** 63 - 1] symbolNode = 0;
        stack mut u32[0 max] textRow = 0;
        stack mut u32[0 max] symbolRow = 0;
        if (!document.TryChildAt(symbolsNode, (u64[0 2 ** 63 - 1])symbolIndex, symbolNode)
            || !LogicalPackageImageJsonMaterializeNativeMetadataFactTextNodeRow(
                document,
                symbolNode,
                LogicalPackageNativeMetadataFactTextKind.LinkageDefinedSymbol,
                symbolIndex,
                graph,
                textRow)
            || !LogicalPackageNativeMetadataFactGraphAddDefinedSymbolRow(
                graph,
                linkageRow,
                symbolIndex,
                textRow,
                symbolRow))
        {
            return false;
        }

        symbolIndex = symbolIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeLinkageReferencedSymbolRows(
    mut borrow JsonDocument document,
