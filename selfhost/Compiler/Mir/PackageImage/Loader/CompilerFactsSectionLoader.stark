            || !LogicalPackageImageJsonMaterializeEnumLayoutOrderedFieldRows(
                document,
                layoutNode,
                moduleOrdinal,
                layoutIndex,
                enumLayoutRow,
                graph)
            || !LogicalPackageImageJsonMaterializeEnumLayoutVariantRows(
