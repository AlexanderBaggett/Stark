import Compiler.Mir.PackageImage.Loader.ManifestJsonReader
import Compiler.Mir.PackageImage.Loader.TypedInterfaceSectionLoader
import Compiler.Mir.PackageImage.Models
import System.Json
import System.Memory
import System.Text
module Compiler.Mir.PackageImage.Loader.CompilerFactsSectionLoader

// Validates and materializes compiler-fact manifest sections.

internal fn MemoryStatus LogicalPackageFunctionEffectFactGraphAppendText(
    mut borrow LogicalPackageFunctionEffectFactGraph graph,
    ascii text,
    out u32[0 max] byteOffset,
    out u32[0 max] byteLength)
{
    byteOffset = 0;
    byteLength = 0;
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength <= 0 || signedLength > (i64[min max])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (graph.TextBytes.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || graph.TextBytes.Length + (u64[0 2 ** 63 - 1])signedLength > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    byteOffset = (u32[0 max])graph.TextBytes.Length;
    byteLength = (u32[0 max])signedLength;
    unsafe
    {
        stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
        if (data == null)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        if (!graph.TextBytes.TryReserve((u64[0 2 ** 63 - 1])signedLength))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            init graph.TextBytes[graph.TextBytes.Length] = *(&data[index]);
        }
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageFunctionEffectFactGraphAddTextRow(
    mut borrow LogicalPackageFunctionEffectFactGraph graph,
    LogicalPackageFunctionEffectFactTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u32[0 max] byteOffset = 0;
    stack mut u32[0 max] byteLength = 0;
    switch (LogicalPackageFunctionEffectFactGraphAppendText(graph, text, byteOffset, byteLength))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            stack LogicalPackageFunctionEffectFactTextRow row =
                new LogicalPackageFunctionEffectFactTextRow()
            {
                TextKindValue = textKind,
                TextOrdinalValue = textOrdinal,
                ByteOffsetValue = byteOffset,
                ByteLengthValue = byteLength
            };
            textRow = graph.TextRows.Add(row);
            return textRow != 0;
    }
}

internal fn bool LogicalPackageFunctionEffectFactGraphAddFunctionEffectRow(
    mut borrow LogicalPackageFunctionEffectFactGraph graph,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionEffectOrdinal,
    u32[0 max] qualifiedResolvedNameTextRow,
    u32[0 max] kindTextRow,
    u32[0 max] inlinePreferenceTextRow,
    bool hasFfiAbi,
    u32[0 max] ffiAbiTextRow,
    bool hasBackendOptimizationMode,
    u32[0 max] backendOptimizationModeTextRow,
    bool readsArgumentMemory,
    bool isPure,
    bool noSync,
    bool noFree,
    bool noUnwind,
    bool willReturn,
    bool mustProgress,
    bool usesFastCallingConvention,
    bool isFfi,
    bool isHot,
    bool isCold,
    bool isStrictFp,
    bool isVarargs,
    bool isTailCallable,
    bool noRecurse,
    out u32[0 max] functionEffectRow)
{
    functionEffectRow = 0;
    if (!graph.TextRows.Contains(qualifiedResolvedNameTextRow)
        || !graph.TextRows.Contains(kindTextRow)
        || !graph.TextRows.Contains(inlinePreferenceTextRow)
        || (hasFfiAbi && !graph.TextRows.Contains(ffiAbiTextRow))
        || (!hasFfiAbi && ffiAbiTextRow != 0)
        || (hasBackendOptimizationMode && !graph.TextRows.Contains(backendOptimizationModeTextRow))
        || (!hasBackendOptimizationMode && backendOptimizationModeTextRow != 0))
    {
        return false;
    }

    stack LogicalPackageFunctionEffectRow row = new LogicalPackageFunctionEffectRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        FunctionEffectOrdinalValue = functionEffectOrdinal,
        QualifiedResolvedNameTextRowValue = qualifiedResolvedNameTextRow,
        KindTextRowValue = kindTextRow,
        InlinePreferenceTextRowValue = inlinePreferenceTextRow,
        FfiAbiTextRowValue = ffiAbiTextRow,
        BackendOptimizationModeTextRowValue = backendOptimizationModeTextRow,
        ReadsArgumentMemoryValue = readsArgumentMemory,
        IsPureValue = isPure,
        NoSyncValue = noSync,
        NoFreeValue = noFree,
        NoUnwindValue = noUnwind,
        WillReturnValue = willReturn,
        MustProgressValue = mustProgress,
        UsesFastCallingConventionValue = usesFastCallingConvention,
        IsFfiValue = isFfi,
        IsHotValue = isHot,
        IsColdValue = isCold,
        IsStrictFpValue = isStrictFp,
        IsVarargsValue = isVarargs,
        IsTailCallableValue = isTailCallable,
        HasFfiAbiValue = hasFfiAbi,
        HasBackendOptimizationModeValue = hasBackendOptimizationMode,
        NoRecurseValue = noRecurse
    };
    functionEffectRow = graph.FunctionEffectRows.Add(row);
    return functionEffectRow != 0;
}

