}

internal fn bool LogicalPackageLayoutFactGraphAddEnumVariantRow(
    mut borrow LogicalPackageLayoutFactGraph graph,
    u32[0 max] enumLayoutRow,
    u32[0 max] variantOrdinal,
    u32[0 max] nameTextRow,
    u32[0 max] tagValue,
    bool usesNamedFields,
    out u32[0 max] variantRow)
{
    variantRow = 0;
    if (!graph.EnumLayoutRows.Contains(enumLayoutRow)
        || !graph.TextRows.Contains(nameTextRow))
    {
        return false;
    }

    stack LogicalPackageEnumVariantLayoutRow row = new LogicalPackageEnumVariantLayoutRow()
    {
        EnumLayoutRowValue = enumLayoutRow,
        VariantOrdinalValue = variantOrdinal,
        NameTextRowValue = nameTextRow,
