{
    groupCount = 0;
    stack mut u64[0 2 ** 63 - 1] groupsNode = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(document, callableNode, memberName, groupsNode, groupCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < groupCount)
    {
        stack mut u64[0 2 ** 63 - 1] groupNode = 0;
        stack mut u32[0 max] groupRow = 0;
        stack mut u32[0 max] nameCount = 0;
        stack mut u32[0 max] regionCount = 0;
        if (!document.TryChildAt(groupsNode, (u64[0 2 ** 63 - 1])index, groupNode)
            || document.KindAt(groupNode) != JsonKind.Object
            || !LogicalPackageTypedCallableFactGraphAddParameterGroupRow(
                graph,
                moduleOrdinal,
                callableKind,
                declarationOrdinal,
                methodOrdinal,
                groupKind,
                index,
                groupRow)
            || !LogicalPackageImageJsonMaterializeCallableParameterGroupNameRows(
