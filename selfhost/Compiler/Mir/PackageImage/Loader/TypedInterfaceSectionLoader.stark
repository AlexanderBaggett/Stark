{
    genericParameterCount = 0;
    comptimeGenericParameterCount = 0;
    parameterCount = 0;
    threadSafetyLawPredicateCount = 0;
    typeParameterConstraintCount = 0;
    valueContractCount = 0;
    disjointParameterGroupCount = 0;
    overlapParameterGroupCount = 0;
    sameParameterGroupCount = 0;
    pointeeDeadOnReturnParameterNameCount = 0;
