                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressParameterType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressTypeArgument:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressComptimeValueArgumentType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationResultType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationReturnType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationParameterType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationTypeArgument:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationComptimeValueArgumentType:
