import Compiler.Ir
import Compiler.Mir.PackageImage.Loader.ManifestJsonReader
import Compiler.Mir.PackageImage.Models
import Compiler.Mir.PackageImage.Shared.TypeCodec
import System.Json
import System.Memory
import System.Text
module Compiler.Mir.PackageImage.Loader.TypedInterfaceSectionLoader

// Typed-interface manifest node lookup for declaration, callable, and type-reference rows.

internal fn bool LogicalPackageImageJsonTypedInterfaceCounts(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typedInterfaceNode,
    out u32[0 max] functionCount,
    out u32[0 max] typeCount,
    out u32[0 max] globalCount,
    out u32[0 max] typeAliasCount,
    out u32[0 max] importCount)
{
    functionCount = 0;
    typeCount = 0;
    globalCount = 0;
    typeAliasCount = 0;
    importCount = 0;
    return LogicalPackageImageJsonRequiredArrayMemberCount(document, typedInterfaceNode, "Functions", functionCount)
        && LogicalPackageImageJsonRequiredArrayMemberCount(document, typedInterfaceNode, "Types", typeCount)
        && LogicalPackageImageJsonRequiredArrayMemberCount(document, typedInterfaceNode, "Globals", globalCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, typedInterfaceNode, "TypeAliases", typeAliasCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, typedInterfaceNode, "Imports", importCount);
}

internal fn bool LogicalPackageImageJsonEffectiveTypedInterfaceNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    out u64[0 2 ** 63 - 1] typedInterfaceNode,
    out bool usesCompilerSections)
{
    typedInterfaceNode = 0;
    usesCompilerSections = false;
    stack mut u64[0 2 ** 63 - 1] directTypedInterfaceNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsTypedInterfaceNode = 0;
    stack mut bool hasDirectTypedInterface = false;
    stack mut bool hasCompilerSections = false;
    stack mut bool hasCompilerSectionsTypedInterface = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "TypedInterface", directTypedInterfaceNode, hasDirectTypedInterface)
        || !LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "CompilerSections", compilerSectionsNode, hasCompilerSections))
    {
        return false;
    }

    if (hasCompilerSections)
    {
        if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            compilerSectionsNode,
            "TypedInterface",
            compilerSectionsTypedInterfaceNode,
            hasCompilerSectionsTypedInterface))
        {
            return false;
        }
    }

    if (hasCompilerSectionsTypedInterface)
    {
        typedInterfaceNode = compilerSectionsTypedInterfaceNode;
        usesCompilerSections = true;
        return true;
    }

    if (hasDirectTypedInterface)
    {
        typedInterfaceNode = directTypedInterfaceNode;
        return true;
    }

    return false;
}

internal fn bool LogicalPackageImageJsonTypedDeclarationArrayNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typedInterfaceNode,
    LogicalPackageTypedDeclarationKind declarationKind,
    out u64[0 2 ** 63 - 1] declarationsNode,
    out u32[0 max] declarationCount)
{
    declarationsNode = 0;
    declarationCount = 0;
    switch (declarationKind)
    {
        case LogicalPackageTypedDeclarationKind.TypeAlias:
            return LogicalPackageImageJsonOptionalArrayMember(document, typedInterfaceNode, "TypeAliases", declarationsNode, declarationCount);
        case LogicalPackageTypedDeclarationKind.Type:
            return LogicalPackageImageJsonRequiredArrayMember(document, typedInterfaceNode, "Types", declarationsNode, declarationCount);
        case LogicalPackageTypedDeclarationKind.Function:
            return LogicalPackageImageJsonRequiredArrayMember(document, typedInterfaceNode, "Functions", declarationsNode, declarationCount);
        case LogicalPackageTypedDeclarationKind.Global:
            return LogicalPackageImageJsonRequiredArrayMember(document, typedInterfaceNode, "Globals", declarationsNode, declarationCount);
    }
}

internal fn bool LogicalPackageImageJsonTypedDeclarationNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typedInterfaceNode,
    LogicalPackageTypedDeclarationKind declarationKind,
    u32[0 max] declarationOrdinal,
    out u64[0 2 ** 63 - 1] declarationNode)
{
    declarationNode = 0;
    stack mut u64[0 2 ** 63 - 1] declarationsNode = 0;
    stack mut u32[0 max] declarationCount = 0;
    if (!LogicalPackageImageJsonTypedDeclarationArrayNode(document, typedInterfaceNode, declarationKind, declarationsNode, declarationCount)
        || declarationOrdinal >= declarationCount)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] found = 0;
    if (!document.TryChildAt(declarationsNode, (u64[0 2 ** 63 - 1])declarationOrdinal, found)
        || document.KindAt(found) != JsonKind.Object)
    {
        return false;
    }

    declarationNode = found;
    return true;
}

internal fn bool LogicalPackageImageJsonTypedCallableNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typedInterfaceNode,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    out u64[0 2 ** 63 - 1] callableNode)
{
    callableNode = 0;
    switch (callableKind)
    {
        case LogicalPackageTypedCallableKind.Function:
            if (methodOrdinal != 0)
            {
                return false;
            }

            return LogicalPackageImageJsonTypedDeclarationNode(
                document,
                typedInterfaceNode,
                LogicalPackageTypedDeclarationKind.Function,
                declarationOrdinal,
                callableNode);
        case LogicalPackageTypedCallableKind.Method:
            stack mut u64[0 2 ** 63 - 1] typeNode = 0;
            stack mut u64[0 2 ** 63 - 1] methodsNode = 0;
            stack mut u32[0 max] methodCount = 0;
            stack mut u64[0 2 ** 63 - 1] found = 0;
            if (!LogicalPackageImageJsonTypedDeclarationNode(
                    document,
                    typedInterfaceNode,
                    LogicalPackageTypedDeclarationKind.Type,
                    declarationOrdinal,
                    typeNode)
                || !LogicalPackageImageJsonOptionalArrayMember(document, typeNode, "Methods", methodsNode, methodCount)
                || methodOrdinal >= methodCount
                || !document.TryChildAt(methodsNode, (u64[0 2 ** 63 - 1])methodOrdinal, found)
                || document.KindAt(found) != JsonKind.Object)
            {
                return false;
            }

            callableNode = found;
            return true;
    }
}

internal fn bool LogicalPackageImageJsonTypedCallableParameterNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callableNode,
    u32[0 max] parameterOrdinal,
    out u64[0 2 ** 63 - 1] parameterNode)
{
    parameterNode = 0;
    stack mut u64[0 2 ** 63 - 1] parametersNode = 0;
    stack mut u32[0 max] parameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] found = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(document, callableNode, "Parameters", parametersNode, parameterCount)
        || parameterOrdinal >= parameterCount
        || !document.TryChildAt(parametersNode, (u64[0 2 ** 63 - 1])parameterOrdinal, found)
        || document.KindAt(found) != JsonKind.Object)
    {
        return false;
    }

    parameterNode = found;
    return true;
}

internal fn bool LogicalPackageImageJsonTypedDeclarationTypeReferenceNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] declarationNode,
    LogicalPackageTypedDeclarationKind declarationKind,
    LogicalPackageTypedTypeReferenceSource source,
    u32[0 max] payloadOrdinal,
    out u64[0 2 ** 63 - 1] typeReferenceNode)
{
    typeReferenceNode = 0;
    stack mut u64[0 2 ** 63 - 1] payloadArrayNode = 0;
    stack mut u64[0 2 ** 63 - 1] payloadNode = 0;
    stack mut u32[0 max] payloadCount = 0;
    switch (source)
    {
        case LogicalPackageTypedTypeReferenceSource.TypeAliasTarget:
            if (declarationKind != LogicalPackageTypedDeclarationKind.TypeAlias
                || payloadOrdinal != 0)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, declarationNode, "TargetType", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeAliasComptimeGenericParameterType:
            if (declarationKind != LogicalPackageTypedDeclarationKind.TypeAlias
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    declarationNode,
                    "ComptimeGenericParameters",
                    payloadArrayNode,
                    payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.FunctionReturn:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Function
                || payloadOrdinal != 0)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, declarationNode, "ReturnType", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.FunctionParameter:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Function
                || !LogicalPackageImageJsonRequiredArrayMember(document, declarationNode, "Parameters", payloadArrayNode, payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.MethodReturn:
        case LogicalPackageTypedTypeReferenceSource.MethodParameter:
        case LogicalPackageTypedTypeReferenceSource.CallableComptimeGenericParameterType:
        case LogicalPackageTypedTypeReferenceSource.CallableTypeParameterConstraintBoundTrait:
        case LogicalPackageTypedTypeReferenceSource.CallableThreadSafetyLawPredicateType:
        case LogicalPackageTypedTypeReferenceSource.GlobalConstantInitializerType:
            return false;
        case LogicalPackageTypedTypeReferenceSource.GlobalType:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Global
                || payloadOrdinal != 0)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, declarationNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeField:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Type
                || !LogicalPackageImageJsonRequiredArrayMember(document, declarationNode, "Fields", payloadArrayNode, payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeAssociatedTypeTarget:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Type
                || !LogicalPackageImageJsonRequiredArrayMember(document, declarationNode, "AssociatedTypes", payloadArrayNode, payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "TargetType", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeImplementedTrait:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Type
                || !LogicalPackageImageJsonRequiredArrayMember(document, declarationNode, "ImplementedTraitTypes", payloadArrayNode, payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            typeReferenceNode = payloadNode;
            return true;
        case LogicalPackageTypedTypeReferenceSource.TypeThreadSafetyLawAttributeConditionType:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Type
                || !LogicalPackageImageJsonRequiredArrayMember(
                    document,
                    declarationNode,
                    "ThreadSafetyLawAttributes",
                    payloadArrayNode,
                    payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object
                || !LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Condition", payloadNode))
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantPayloadType:
        case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantAbsorbsErrorType:
        case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipEventPlaceType:
        case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipRootType:
        case LogicalPackageTypedTypeReferenceSource.AbiFunctionSourceReturn:
        case LogicalPackageTypedTypeReferenceSource.AbiFunctionLlvmReturn:
        case LogicalPackageTypedTypeReferenceSource.AbiParameterSourceType:
        case LogicalPackageTypedTypeReferenceSource.AbiParameterLlvmType:
        case LogicalPackageTypedTypeReferenceSource.AbiParameterLlvmCarrierType:
        case LogicalPackageTypedTypeReferenceSource.LayoutEnumTagFieldType:
        case LogicalPackageTypedTypeReferenceSource.LayoutEnumOrderedFieldType:
        case LogicalPackageTypedTypeReferenceSource.LayoutEnumVariantFieldType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateStatementType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateStatementTraversalIndexType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateStatementTraversalElementType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionTypeArgument:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionComptimeValueArgumentType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateDeferredFunctionInstantiationTypeArgument:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateDeferredFunctionInstantiationComptimeValueArgumentType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateDeferredTypeInstantiationType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateLocalDeclarationType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateConversionTargetType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateFieldAccessFieldType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationOperandType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationReturnType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationSuccessPayloadType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationOperandFailurePayloadType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationEnclosingFailurePayloadType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateObjectCreationCreatedType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateObjectInitializerMemberFieldType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumConstructorEnumType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumConstructorMemberFieldType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumCallEnumType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumValueEnumType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumPatternEnumType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumPatternMemberFieldType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateAggregatePatternType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateAggregatePatternMemberFieldType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallReturnType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallParameterType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallTypeArgument:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallComptimeValueArgumentType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallReturnType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallParameterType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallTypeArgument:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallComptimeValueArgumentType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressTargetType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressReturnType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressParameterType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressTypeArgument:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressComptimeValueArgumentType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationResultType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationReturnType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationParameterType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationTypeArgument:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationComptimeValueArgumentType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationCallArgumentParameterType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationCallArgumentArgumentType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationReceiverType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationFunctionPointerType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationClosureType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationSourceType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationTargetType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationCreatedType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationConstructorParameterType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationObjectInitializerMemberFieldType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationEnumType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationEnumMemberFieldType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationLayoutQueryTargetType:
        case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationSwitchType:
            return false;
    }
}

internal fn bool LogicalPackageImageJsonTypedCallableTypeReferenceNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typedInterfaceNode,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    LogicalPackageTypedTypeReferenceSource source,
    u32[0 max] payloadOrdinal,
    out u64[0 2 ** 63 - 1] typeReferenceNode)
{
    typeReferenceNode = 0;
    stack mut u64[0 2 ** 63 - 1] callableNode = 0;
    stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
    stack mut u64[0 2 ** 63 - 1] payloadArrayNode = 0;
    stack mut u64[0 2 ** 63 - 1] payloadNode = 0;
    stack mut u32[0 max] payloadCount = 0;
    switch (callableKind)
    {
        case LogicalPackageTypedCallableKind.Function:
            if (methodOrdinal != 0)
            {
                return false;
            }

            switch (source)
            {
                case LogicalPackageTypedTypeReferenceSource.FunctionReturn:
                    if (payloadOrdinal != 0
                        || !LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode))
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(
                        document,
                        callableNode,
                        "ReturnType",
                        typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.FunctionParameter:
                    if (!LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode)
                        || !LogicalPackageImageJsonTypedCallableParameterNode(
                            document,
                            callableNode,
                            payloadOrdinal,
                            parameterNode))
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(document, parameterNode, "Type", typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.CallableComptimeGenericParameterType:
                    if (!LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode)
                        || !LogicalPackageImageJsonOptionalArrayMember(
                            document,
                            callableNode,
                            "ComptimeGenericParameters",
                            payloadArrayNode,
                            payloadCount)
                        || payloadOrdinal >= payloadCount
                        || !document.TryChildAt(
                            payloadArrayNode,
                            (u64[0 2 ** 63 - 1])payloadOrdinal,
                            payloadNode)
                        || document.KindAt(payloadNode) != JsonKind.Object)
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(
                        document,
                        payloadNode,
                        "Type",
                        typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.TypeAliasTarget:
                case LogicalPackageTypedTypeReferenceSource.TypeAliasComptimeGenericParameterType:
                case LogicalPackageTypedTypeReferenceSource.MethodReturn:
                case LogicalPackageTypedTypeReferenceSource.MethodParameter:
                case LogicalPackageTypedTypeReferenceSource.CallableTypeParameterConstraintBoundTrait:
                case LogicalPackageTypedTypeReferenceSource.CallableThreadSafetyLawPredicateType:
                case LogicalPackageTypedTypeReferenceSource.GlobalType:
                case LogicalPackageTypedTypeReferenceSource.GlobalConstantInitializerType:
                case LogicalPackageTypedTypeReferenceSource.TypeField:
                case LogicalPackageTypedTypeReferenceSource.TypeAssociatedTypeTarget:
                case LogicalPackageTypedTypeReferenceSource.TypeImplementedTrait:
                case LogicalPackageTypedTypeReferenceSource.TypeThreadSafetyLawAttributeConditionType:
                case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantPayloadType:
                case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantAbsorbsErrorType:
                case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipEventPlaceType:
                case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipRootType:
                case LogicalPackageTypedTypeReferenceSource.AbiFunctionSourceReturn:
                case LogicalPackageTypedTypeReferenceSource.AbiFunctionLlvmReturn:
                case LogicalPackageTypedTypeReferenceSource.AbiParameterSourceType:
                case LogicalPackageTypedTypeReferenceSource.AbiParameterLlvmType:
                case LogicalPackageTypedTypeReferenceSource.AbiParameterLlvmCarrierType:
                case LogicalPackageTypedTypeReferenceSource.LayoutEnumTagFieldType:
                case LogicalPackageTypedTypeReferenceSource.LayoutEnumOrderedFieldType:
                case LogicalPackageTypedTypeReferenceSource.LayoutEnumVariantFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateStatementType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateStatementTraversalIndexType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateStatementTraversalElementType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionTypeArgument:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionComptimeValueArgumentType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDeferredFunctionInstantiationTypeArgument:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDeferredFunctionInstantiationComptimeValueArgumentType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDeferredTypeInstantiationType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateLocalDeclarationType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateConversionTargetType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFieldAccessFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationOperandType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationReturnType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationSuccessPayloadType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationOperandFailurePayloadType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationEnclosingFailurePayloadType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateObjectCreationCreatedType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateObjectInitializerMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumConstructorEnumType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumConstructorMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumCallEnumType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumValueEnumType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumPatternEnumType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumPatternMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateAggregatePatternType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateAggregatePatternMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallReturnType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallParameterType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallTypeArgument:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallComptimeValueArgumentType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallReturnType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallParameterType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallTypeArgument:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallComptimeValueArgumentType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressTargetType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressReturnType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressParameterType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressTypeArgument:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressComptimeValueArgumentType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationResultType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationReturnType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationParameterType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationTypeArgument:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationComptimeValueArgumentType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationCallArgumentParameterType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationCallArgumentArgumentType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationReceiverType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationFunctionPointerType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationClosureType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationSourceType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationTargetType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationCreatedType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationConstructorParameterType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationObjectInitializerMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationEnumType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationEnumMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationLayoutQueryTargetType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationSwitchType:
                    return false;
            }
        case LogicalPackageTypedCallableKind.Method:
            switch (source)
            {
                case LogicalPackageTypedTypeReferenceSource.MethodReturn:
                    if (payloadOrdinal != 0
                        || !LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode))
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(
                        document,
                        callableNode,
                        "ReturnType",
                        typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.MethodParameter:
                    if (!LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode)
                        || !LogicalPackageImageJsonTypedCallableParameterNode(
                            document,
                            callableNode,
                            payloadOrdinal,
                            parameterNode))
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(document, parameterNode, "Type", typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.CallableComptimeGenericParameterType:
                    if (!LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode)
                        || !LogicalPackageImageJsonOptionalArrayMember(
                            document,
                            callableNode,
                            "ComptimeGenericParameters",
                            payloadArrayNode,
                            payloadCount)
                        || payloadOrdinal >= payloadCount
                        || !document.TryChildAt(
                            payloadArrayNode,
                            (u64[0 2 ** 63 - 1])payloadOrdinal,
                            payloadNode)
                        || document.KindAt(payloadNode) != JsonKind.Object)
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(
                        document,
                        payloadNode,
                        "Type",
                        typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.TypeAliasTarget:
                case LogicalPackageTypedTypeReferenceSource.TypeAliasComptimeGenericParameterType:
                case LogicalPackageTypedTypeReferenceSource.FunctionReturn:
                case LogicalPackageTypedTypeReferenceSource.FunctionParameter:
