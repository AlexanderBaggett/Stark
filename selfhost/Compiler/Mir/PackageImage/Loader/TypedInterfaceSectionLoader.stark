public fn bool TryFindLogicalPackageTypedCallableParameterGroup(
    borrow LogicalPackageTypedCallableFactGraph graph,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    LogicalPackageTypeReferenceParameterGroupKind groupKind,
    u32[0 max] groupOrdinal,
    out u32[0 max] groupRow)
{
    groupRow = 0;
    stack mut u64[0 2 ** 63 - 1] rowIndex = 1;
    while willexit (rowIndex <= graph.ParameterGroupRows.Count())
    {
        if (rowIndex > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
        {
            return false;
        }

        stack u32[0 max] narrowedRowIndex = (u32[0 max])rowIndex;
        stack LogicalPackageTypedCallableParameterGroupRow row =
            graph.ParameterGroupRows.Get(narrowedRowIndex);
        if (row.ModuleOrdinalValue == moduleOrdinal
            && row.CallableKindValue == callableKind
            && row.DeclarationOrdinalValue == declarationOrdinal
            && row.MethodOrdinalValue == methodOrdinal
            && row.GroupKindValue == groupKind
            && row.GroupOrdinalValue == groupOrdinal)
        {
            groupRow = narrowedRowIndex;
            return true;
        }

        rowIndex = rowIndex + 1;
    }

    return false;
}
