                case LogicalPackageTypedTypeReferenceSource.GenericTemplateFieldAccessFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationOperandType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateTryPropagationReturnType:
