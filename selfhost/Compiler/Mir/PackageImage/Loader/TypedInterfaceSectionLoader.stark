                case LogicalPackageTypedTypeReferenceSource.GenericTemplateObjectCreationCreatedType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateObjectInitializerMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumConstructorEnumType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumConstructorMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumCallEnumType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumValueEnumType:
