internal fn bool LogicalPackageImageJsonMaterializeCallableImportRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callableNode,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    out bool hasImportRow)
{
    hasImportRow = false;
    stack mut bool hasFfiAbi = false;
    stack mut bool hasLinkName = false;
    stack mut u32[0 max] ffiAbiTextRow = 0;
    stack mut u32[0 max] linkNameTextRow = 0;
    if (!LogicalPackageImageJsonMaterializeOptionalCallableFactTextMemberRow(
            document,
            callableNode,
            "FfiAbi",
            LogicalPackageTypedCallableFactTextKind.FfiAbi,
            0,
            graph,
            hasFfiAbi,
            ffiAbiTextRow))
    {
        return false;
    }

    if (callableKind == LogicalPackageTypedCallableKind.Method
        && LogicalPackageImageJsonMemberHasValue(document, callableNode, "LinkName"))
    {
        return false;
    }

    if (callableKind == LogicalPackageTypedCallableKind.Function
        && !LogicalPackageImageJsonMaterializeOptionalCallableFactTextMemberRow(
            document,
            callableNode,
            "LinkName",
            LogicalPackageTypedCallableFactTextKind.LinkName,
            0,
            graph,
            hasLinkName,
            linkNameTextRow))
    {
        return false;
    }

    if (!hasFfiAbi && !hasLinkName)
    {
        return true;
    }

    hasImportRow = true;
    return LogicalPackageTypedCallableFactGraphAddImportRow(
        graph,
        moduleOrdinal,
        callableKind,
        declarationOrdinal,
        methodOrdinal,
        hasFfiAbi,
        ffiAbiTextRow,
        hasLinkName,
        linkNameTextRow);
}

internal fn bool LogicalPackageImageJsonMaterializeCallableAsmRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callableNode,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    out bool hasAsmRow)
{
    hasAsmRow = false;
    if (callableKind == LogicalPackageTypedCallableKind.Method)
    {
        return !LogicalPackageImageJsonMemberHasValue(document, callableNode, "Asm");
    }

    stack mut u64[0 2 ** 63 - 1] asmNode = 0;
    stack mut bool hasAsm = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(document, callableNode, "Asm", asmNode, hasAsm))
    {
        return false;
    }

    if (!hasAsm)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] inputsNode = 0;
    stack mut u64[0 2 ** 63 - 1] outputsNode = 0;
    stack mut u64[0 2 ** 63 - 1] clobbersNode = 0;
    stack mut u32[0 max] inputCount = 0;
    stack mut u32[0 max] outputCount = 0;
    stack mut u32[0 max] clobberCount = 0;
    stack mut u32[0 max] architectureTextRow = 0;
    stack mut u32[0 max] templateTextRow = 0;
    stack mut u32[0 max] asmRow = 0;
    if (!LogicalPackageImageJsonMaterializeCallableFactTextMemberRow(
            document,
            asmNode,
            "ArchitectureText",
            LogicalPackageTypedCallableFactTextKind.AsmArchitecture,
            0,
            graph,
            architectureTextRow)
        || !LogicalPackageImageJsonMaterializeCallableFactTextMemberRow(
            document,
            asmNode,
            "TemplateText",
            LogicalPackageTypedCallableFactTextKind.AsmTemplate,
            0,
            graph,
            templateTextRow)
        || !LogicalPackageImageJsonRequiredArrayMember(document, asmNode, "Inputs", inputsNode, inputCount)
        || !LogicalPackageImageJsonRequiredArrayMember(document, asmNode, "Outputs", outputsNode, outputCount)
        || !LogicalPackageImageJsonRequiredArrayMember(document, asmNode, "Clobbers", clobbersNode, clobberCount)
        || !LogicalPackageTypedCallableFactGraphAddAsmRow(
            graph,
            moduleOrdinal,
            declarationOrdinal,
            architectureTextRow,
            templateTextRow,
            asmRow))
    {
        return false;
    }

    stack mut u32[0 max] inputIndex = 0;
    while willexit (inputIndex < inputCount)
    {
        stack mut u64[0 2 ** 63 - 1] inputNode = 0;
        stack mut u32[0 max] registerNameTextRow = 0;
        stack mut u32[0 max] valueNameTextRow = 0;
        if (!document.TryChildAt(inputsNode, (u64[0 2 ** 63 - 1])inputIndex, inputNode)
            || document.KindAt(inputNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeCallableFactTextMemberRow(
                document,
                inputNode,
                "RegisterName",
                LogicalPackageTypedCallableFactTextKind.AsmInputRegisterName,
                inputIndex,
                graph,
                registerNameTextRow)
            || !LogicalPackageImageJsonMaterializeCallableFactTextMemberRow(
                document,
                inputNode,
                "ValueName",
                LogicalPackageTypedCallableFactTextKind.AsmInputValueName,
                inputIndex,
                graph,
                valueNameTextRow)
            || !LogicalPackageTypedCallableFactGraphAddAsmInputRow(
                graph,
                asmRow,
                inputIndex,
                registerNameTextRow,
                valueNameTextRow))
        {
            return false;
        }

        inputIndex = inputIndex + 1;
    }

    stack mut u32[0 max] outputIndex = 0;
    while willexit (outputIndex < outputCount)
    {
        stack mut u64[0 2 ** 63 - 1] outputNode = 0;
        stack mut bool bindsReturnValue = false;
        stack mut u32[0 max] registerNameTextRow = 0;
        stack mut u32[0 max] valueNameTextRow = 0;
        if (!document.TryChildAt(outputsNode, (u64[0 2 ** 63 - 1])outputIndex, outputNode)
            || document.KindAt(outputNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeCallableFactTextMemberRow(
                document,
                outputNode,
                "RegisterName",
                LogicalPackageTypedCallableFactTextKind.AsmOutputRegisterName,
                outputIndex,
                graph,
                registerNameTextRow)
            || !LogicalPackageImageJsonMaterializeCallableFactTextMemberRow(
                document,
                outputNode,
                "ValueName",
                LogicalPackageTypedCallableFactTextKind.AsmOutputValueName,
                outputIndex,
                graph,
                valueNameTextRow)
            || !LogicalPackageImageJsonRequiredBoolMemberValue(
                document,
                outputNode,
                "BindsReturnValue",
                bindsReturnValue)
            || !LogicalPackageTypedCallableFactGraphAddAsmOutputRow(
                graph,
                asmRow,
                outputIndex,
                registerNameTextRow,
                valueNameTextRow,
                bindsReturnValue))
        {
            return false;
        }

        outputIndex = outputIndex + 1;
    }

    stack mut u32[0 max] clobberIndex = 0;
    while willexit (clobberIndex < clobberCount)
    {
        stack mut u64[0 2 ** 63 - 1] clobberNode = 0;
        stack mut u32[0 max] registerNameTextRow = 0;
        if (!document.TryChildAt(clobbersNode, (u64[0 2 ** 63 - 1])clobberIndex, clobberNode)
            || document.KindAt(clobberNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii registerName = document.TextAt(clobberNode);
        if (System.Text.AsciiLength(registerName) <= 0
            || !LogicalPackageTypedCallableFactGraphAddTextRow(
                graph,
                LogicalPackageTypedCallableFactTextKind.AsmClobberRegisterName,
                clobberIndex,
                registerName,
                registerNameTextRow)
            || !LogicalPackageTypedCallableFactGraphAddAsmClobberRow(
                graph,
                asmRow,
                clobberIndex,
                registerNameTextRow))
        {
            return false;
        }

        clobberIndex = clobberIndex + 1;
    }

    hasAsmRow = true;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedCallableFactRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callableNode,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    mut borrow LogicalPackageTypedCallableFactGraph graph)
{
    stack mut u32[0 max] genericParameterCount = 0;
    stack mut u32[0 max] comptimeGenericParameterCount = 0;
    stack mut u32[0 max] typeParameterConstraintCount = 0;
    stack mut u32[0 max] threadSafetyLawPredicateCount = 0;
    stack mut u32[0 max] valueContractCount = 0;
    stack mut u32[0 max] disjointParameterGroupCount = 0;
    stack mut u32[0 max] overlapParameterGroupCount = 0;
    stack mut u32[0 max] sameParameterGroupCount = 0;
    stack mut bool hasImportRow = false;
    stack mut bool hasAsmRow = false;
    return LogicalPackageImageJsonMaterializeCallableGenericParameterRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            genericParameterCount)
        && LogicalPackageImageJsonMaterializeCallableComptimeGenericParameterRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            comptimeGenericParameterCount)
        && LogicalPackageImageJsonMaterializeCallableTypeParameterConstraintRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            typeParameterConstraintCount)
        && LogicalPackageImageJsonMaterializeCallableThreadSafetyLawPredicateRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            threadSafetyLawPredicateCount)
        && LogicalPackageImageJsonMaterializeCallableValueContractRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            valueContractCount)
        && LogicalPackageImageJsonMaterializeCallableParameterGroupRows(
            document,
            callableNode,
            "DisjointParameterGroups",
            LogicalPackageTypeReferenceParameterGroupKind.Disjoint,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            disjointParameterGroupCount)
        && LogicalPackageImageJsonMaterializeCallableParameterGroupRows(
            document,
            callableNode,
            "OverlapParameterGroups",
            LogicalPackageTypeReferenceParameterGroupKind.Overlap,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            overlapParameterGroupCount)
        && LogicalPackageImageJsonMaterializeCallableParameterGroupRows(
            document,
            callableNode,
            "SameParameterGroups",
            LogicalPackageTypeReferenceParameterGroupKind.Same,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            sameParameterGroupCount)
        && LogicalPackageImageJsonMaterializeCallableImportRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            hasImportRow)
        && LogicalPackageImageJsonMaterializeCallableAsmRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            graph,
            hasAsmRow);
}

internal fn bool LogicalPackageImageJsonMaterializeGlobalFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageTypedGlobalFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageTypedGlobalFactGraph graph,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    return LogicalPackageTypedGlobalFactGraphAddTextRow(graph, textKind, textOrdinal, value, false, textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeOptionalGlobalFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageTypedGlobalFactTextKind textKind,
    u32[0 max] textOrdinal,
    bool allowEmpty,
    mut borrow LogicalPackageTypedGlobalFactGraph graph,
    out bool present,
    out u32[0 max] textRow)
{
    present = false;
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) < 0
        || (!allowEmpty && System.Text.AsciiLength(value) == 0))
    {
        return false;
    }

    if (!LogicalPackageTypedGlobalFactGraphAddTextRow(
        graph,
        textKind,
        textOrdinal,
        value,
        allowEmpty,
        textRow))
    {
        return false;
    }

    present = true;
    return true;
}

