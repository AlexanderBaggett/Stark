    out bool hasRawPointerElementCountExpression)
{
    hasRawPointerElementCountExpression = false;
    return LogicalPackageImageJsonAppendRequiredTextMember(document, parameterNode, "Name", name)
        && LogicalPackageImageJsonAppendOptionalTextMember(
            document,
            parameterNode,
            "RawPointerElementCountExpression",
