    stack mut LogicalPackageTypedTypeAliasRow parent = graph.TypeAliasRows.Get(typeAliasRow);
    if (parent.GenericParameterRowCountValue == 0)
    {
        parent.FirstGenericParameterRowValue = addedRow;
