                LogicalPackageTypedCallableFactTextKind.ParameterGroupRegionParameterName,
                index,
                graph,
                parameterNameTextRow)
            || !LogicalPackageImageJsonMaterializeOptionalCallableFactTextMemberRow(
                document,
                regionNode,
                "StartExpression",
                LogicalPackageTypedCallableFactTextKind.ParameterGroupRegionStartExpression,
                index,
                graph,
                hasStartExpression,
                startExpressionTextRow)
            || !LogicalPackageImageJsonMaterializeOptionalCallableFactTextMemberRow(
                document,
                regionNode,
                "CountExpression",
                LogicalPackageTypedCallableFactTextKind.ParameterGroupRegionCountExpression,
                index,
                graph,
                hasCountExpression,
                countExpressionTextRow)
            || !LogicalPackageTypedCallableFactGraphAddParameterGroupRegionRow(
                graph,
                groupRow,
                index,
                parameterNameTextRow,
                hasStartExpression,
                startExpressionTextRow,
                hasCountExpression,
                countExpressionTextRow,
                regionRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeCallableParameterGroupRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callableNode,
    ascii memberName,
