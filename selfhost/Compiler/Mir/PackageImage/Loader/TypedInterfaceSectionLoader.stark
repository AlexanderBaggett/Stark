        {
            return false;
        }

        if (!LogicalPackageTypedTypeFactGraphAddEnumVariantRow(
            graph,
            moduleOrdinal,
            typeOrdinal,
            index,
            nameTextRow,
            usesNamedFields,
            hasRole,
            roleTextRow,
