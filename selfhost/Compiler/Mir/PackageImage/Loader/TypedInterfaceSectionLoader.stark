        || !LogicalPackageImageJsonOptionalU32MemberValue(document, typeNode, "AlignBytes", hasAlignBytes, alignBytes)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, typeNode, "IsDynTrait", isDynTrait)
        || !LogicalPackageTypedTypeFactGraphAddTypeRow(
