                case LogicalPackageTypedTypeReferenceSource.GenericTemplateEnumPatternMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateAggregatePatternType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateAggregatePatternMemberFieldType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallReturnType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallParameterType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallTypeArgument:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallComptimeValueArgumentType:
                case LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallReturnType:
