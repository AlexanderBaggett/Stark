    LogicalPackageTypedTypeReferenceSource source,
    u32[0 max] payloadOrdinal,
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    out u32[0 max] typeReferenceRow)
{
    typeReferenceRow = 0;
    stack LogicalPackageTypedDeclarationKind declarationKind =
        callableKind == LogicalPackageTypedCallableKind.Method
            ? LogicalPackageTypedDeclarationKind.Type
            : LogicalPackageTypedDeclarationKind.Function;
    return LogicalPackageImageJsonMaterializeTypeReferenceGraph(
        document,
        typeReferenceNode,
        moduleOrdinal,
        declarationKind,
        declarationOrdinal,
        methodOrdinal,
        0,
        source,
        payloadOrdinal,
        graph.TypeReferences,
        typeReferenceRow);
}

internal fn bool LogicalPackageImageJsonMaterializeCallableGenericParameterRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callableNode,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    out u32[0 max] parameterCount)
{
    parameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(document, callableNode, "GenericParameters", arrayNode, parameterCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii name = document.TextAt(parameterNode);
        if (System.Text.AsciiLength(name) <= 0
            || !LogicalPackageTypedCallableFactGraphAddTextRow(
                graph,
                LogicalPackageTypedCallableFactTextKind.GenericParameterName,
                index,
                name,
                nameTextRow)
            || !LogicalPackageTypedCallableFactGraphAddGenericParameterRow(
                graph,
                moduleOrdinal,
                callableKind,
                declarationOrdinal,
                methodOrdinal,
                index,
                nameTextRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

