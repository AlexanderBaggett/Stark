internal fn bool LogicalPackageImageJsonTypedCallableParameterFacts(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] parameterNode,
    out bool isDisjoint,
    out bool isConst)
{
    isDisjoint = false;
    isConst = false;
    stack mut u64[0 2 ** 63 - 1] typeNode = 0;
    return LogicalPackageImageJsonRequiredObjectMember(document, parameterNode, "Type", typeNode)
        && LogicalPackageImageJsonOptionalBoolMemberValue(document, parameterNode, "IsDisjoint", isDisjoint)
        && LogicalPackageImageJsonOptionalBoolMemberValue(document, parameterNode, "IsConst", isConst);
