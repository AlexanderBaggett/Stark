internal fn bool LogicalPackageImageJsonConstantInitializerKindHasAggregateElements(ascii kind)
{
    return System.Text.Equals(kind, "fixedarray")
        || System.Text.Equals(kind, "namedaggregate")
        || System.Text.Equals(kind, "enumaggregate");
}

internal fn bool LogicalPackageImageJsonConstantInitializerKindShapeIsValid(
    ascii kind,
    bool hasIntegerValue,
    bool hasFloatLiteralText,
    bool hasBoolValue,
    bool hasTextLiteralText,
    bool hasVariantName,
    bool hasElements)
{
    if (System.Text.Equals(kind, "integer"))
    {
        return hasIntegerValue && !hasElements;
    }

    if (System.Text.Equals(kind, "float"))
    {
        return hasFloatLiteralText && !hasElements;
    }

    if (System.Text.Equals(kind, "bool"))
    {
        return hasBoolValue && !hasElements;
    }

    if (System.Text.Equals(kind, "text"))
    {
        return hasTextLiteralText && !hasElements;
    }

    if (System.Text.Equals(kind, "null"))
    {
        return !hasElements;
    }

    if (System.Text.Equals(kind, "fixedarray")
        || System.Text.Equals(kind, "namedaggregate"))
    {
        return hasElements;
    }

    if (System.Text.Equals(kind, "enumaggregate"))
    {
        return hasElements && hasVariantName;
    }

    return false;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedConstantInitializerRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] rootInitializerNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] globalOrdinal,
    mut borrow LogicalPackageTypedGlobalFactGraph graph,
    out u32[0 max] rootInitializerRow)
{
    rootInitializerRow = 0;
    stack mut IrTable<LogicalPackageTypedConstantInitializerWorkItem> work = new();
    if (!LogicalPackageTypedConstantInitializerWorkListAdd(work, rootInitializerNode, 0, 0))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] workCursor = 1;
    while willexit (workCursor <= work.Count())
    {
        if (workCursor > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
        {
            return false;
        }

        stack LogicalPackageTypedConstantInitializerWorkItem item = work.Get((u32[0 max])workCursor);
        if (document.KindAt(item.NodeValue) != JsonKind.Object)
        {
            return false;
        }

        stack u32[0 max] initializerOrdinal = (u32[0 max])(workCursor - 1);
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u64[0 2 ** 63 - 1] elementsNode = 0;
        stack mut u64[0 2 ** 63 - 1] kindMember = 0;
        stack mut u32[0 max] elementCount = 0;
        stack mut u32[0 max] kindTextRow = 0;
        stack mut u32[0 max] typeReferenceRow = 0;
        stack mut bool hasIntegerValue = false;
        stack mut bool hasFloatLiteralText = false;
        stack mut bool hasBoolValue = false;
        stack mut bool boolValue = false;
        stack mut bool hasTextLiteralText = false;
        stack mut bool hasVariantName = false;
        stack mut u32[0 max] integerValueTextRow = 0;
        stack mut u32[0 max] floatLiteralTextRow = 0;
        stack mut u32[0 max] textLiteralTextRow = 0;
        stack mut u32[0 max] variantNameTextRow = 0;
        stack mut bool hasElements = false;
        if (!LogicalPackageImageJsonMaterializeGlobalFactTextMemberRow(
                document,
                item.NodeValue,
                "Kind",
                LogicalPackageTypedGlobalFactTextKind.ConstantInitializerKind,
                initializerOrdinal,
                graph,
                kindTextRow)
            || !LogicalPackageImageJsonRequiredObjectMember(document, item.NodeValue, "Type", typeNode)
            || !LogicalPackageImageJsonMaterializeTypeReferenceGraph(
                document,
                typeNode,
                moduleOrdinal,
                LogicalPackageTypedDeclarationKind.Global,
                globalOrdinal,
                0,
                0,
                LogicalPackageTypedTypeReferenceSource.GlobalConstantInitializerType,
                initializerOrdinal,
                graph.TypeReferences,
                typeReferenceRow)
            || !LogicalPackageImageJsonMaterializeOptionalGlobalFactTextMemberRow(
                document,
                item.NodeValue,
                "IntegerValue",
                LogicalPackageTypedGlobalFactTextKind.ConstantInitializerIntegerValue,
                initializerOrdinal,
                false,
                graph,
                hasIntegerValue,
                integerValueTextRow)
            || !LogicalPackageImageJsonMaterializeOptionalGlobalFactTextMemberRow(
                document,
                item.NodeValue,
                "FloatLiteralText",
                LogicalPackageTypedGlobalFactTextKind.ConstantInitializerFloatLiteralText,
                initializerOrdinal,
                false,
                graph,
                hasFloatLiteralText,
                floatLiteralTextRow)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(document, item.NodeValue, "BoolValue", boolValue)
            || !LogicalPackageImageJsonMaterializeOptionalGlobalFactTextMemberRow(
                document,
                item.NodeValue,
                "TextLiteralText",
                LogicalPackageTypedGlobalFactTextKind.ConstantInitializerTextLiteralText,
                initializerOrdinal,
                true,
                graph,
                hasTextLiteralText,
                textLiteralTextRow)
            || !LogicalPackageImageJsonMaterializeOptionalGlobalFactTextMemberRow(
                document,
                item.NodeValue,
                "VariantName",
                LogicalPackageTypedGlobalFactTextKind.ConstantInitializerVariantName,
                initializerOrdinal,
                false,
                graph,
                hasVariantName,
                variantNameTextRow))
        {
            return false;
        }

        if (!document.TryFindMember(item.NodeValue, "Kind", kindMember)
            || document.KindAt(kindMember) != JsonKind.Text)
        {
            return false;
        }

        stack ascii kind = document.TextAt(kindMember);
        if (System.Text.AsciiLength(kind) <= 0)
        {
            return false;
        }

        hasBoolValue = LogicalPackageImageJsonMemberHasValue(document, item.NodeValue, "BoolValue");
        hasElements = LogicalPackageImageJsonMemberHasValue(document, item.NodeValue, "Elements");
        if (LogicalPackageImageJsonConstantInitializerKindHasAggregateElements(kind))
        {
            if (!LogicalPackageImageJsonRequiredArrayMember(
                document,
                item.NodeValue,
                "Elements",
                elementsNode,
                elementCount))
            {
                return false;
            }
        }
        else if (hasElements)
        {
            return false;
        }

        if (!LogicalPackageImageJsonConstantInitializerKindShapeIsValid(
            kind,
            hasIntegerValue,
            hasFloatLiteralText,
            hasBoolValue,
            hasTextLiteralText,
            hasVariantName,
            hasElements))
        {
            return false;
        }

        stack mut u32[0 max] initializerRow = 0;
        if (!LogicalPackageTypedGlobalFactGraphAddInitializerRow(
            graph,
            item.ParentInitializerRowValue,
            item.ParentChildOrdinalValue,
            moduleOrdinal,
            globalOrdinal,
            initializerOrdinal,
            kindTextRow,
            typeReferenceRow,
            hasIntegerValue,
            integerValueTextRow,
            hasFloatLiteralText,
            floatLiteralTextRow,
            hasBoolValue,
            boolValue,
            hasTextLiteralText,
            textLiteralTextRow,
            hasVariantName,
            variantNameTextRow,
            initializerRow))
        {
            return false;
        }

        if (rootInitializerRow == 0)
        {
            rootInitializerRow = initializerRow;
        }

        stack mut u32[0 max] elementIndex = 0;
        while willexit (elementIndex < elementCount)
        {
            stack mut u64[0 2 ** 63 - 1] childNode = 0;
            if (!document.TryChildAt(elementsNode, (u64[0 2 ** 63 - 1])elementIndex, childNode)
                || document.KindAt(childNode) != JsonKind.Object
                || !LogicalPackageTypedConstantInitializerWorkListAdd(
                    work,
                    childNode,
                    initializerRow,
                    elementIndex))
            {
                return false;
            }

            elementIndex = elementIndex + 1;
        }

        workCursor = workCursor + 1;
    }

    return rootInitializerRow != 0;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedGlobalFactRows(
