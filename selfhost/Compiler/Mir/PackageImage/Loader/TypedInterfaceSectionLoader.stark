            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                variantNode,
                "AbsorbsErrorType",
                absorbsErrorTypeNode,
                hasAbsorbsErrorType))
        {
            return false;
        }

        if (hasAbsorbsErrorType
            && !LogicalPackageImageJsonMaterializeTypeReferenceGraph(
                document,
                absorbsErrorTypeNode,
                moduleOrdinal,
                LogicalPackageTypedDeclarationKind.Type,
                typeOrdinal,
                0,
                index,
                LogicalPackageTypedTypeReferenceSource.TypeEnumVariantAbsorbsErrorType,
                0,
                graph.TypeReferences,
