internal fn bool LogicalPackageTypeReferenceWorkListAdd(
    mut borrow IrTable<LogicalPackageTypeReferenceWorkItem> work,
    u64[0 2 ** 63 - 1] node,
    u32[0 max] parentTypeReferenceRow,
    LogicalPackageTypeReferenceChildKind parentChildKind,
    u32[0 max] parentChildOrdinal)
{
    if (node == 0)
    {
        return false;
    }

    stack LogicalPackageTypeReferenceWorkItem item = new LogicalPackageTypeReferenceWorkItem()
    {
        NodeValue = node,
        ParentTypeReferenceRowValue = parentTypeReferenceRow,
        ParentChildKindValue = parentChildKind,
        ParentChildOrdinalValue = parentChildOrdinal
    };
    return work.Add(item) != 0;
}

internal fn bool LogicalPackageTypedConstantInitializerWorkListAdd(
    mut borrow IrTable<LogicalPackageTypedConstantInitializerWorkItem> work,
    u64[0 2 ** 63 - 1] node,
    u32[0 max] parentInitializerRow,
    u32[0 max] parentChildOrdinal)
{
    if (node == 0)
    {
        return false;
    }

    stack LogicalPackageTypedConstantInitializerWorkItem item =
        new LogicalPackageTypedConstantInitializerWorkItem()
    {
        NodeValue = node,
        ParentInitializerRowValue = parentInitializerRow,
        ParentChildOrdinalValue = parentChildOrdinal
    };
    return work.Add(item) != 0;
}

internal fn bool LogicalPackageImageJsonAppendTypedDeclarationHeaderText(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] declarationNode,
    LogicalPackageTypedDeclarationKind declarationKind,
    mut borrow OwnedAscii name,
    mut borrow OwnedAscii qualifiedName,
    mut borrow OwnedAscii visibility,
    mut borrow OwnedAscii manifestKind,
    out bool hasManifestKind)
{
    hasManifestKind = false;
    if (!LogicalPackageImageJsonAppendRequiredTextMember(document, declarationNode, "Name", name)
        || !LogicalPackageImageJsonAppendRequiredTextMember(document, declarationNode, "QualifiedName", qualifiedName)
        || !LogicalPackageImageJsonAppendRequiredTextMember(document, declarationNode, "Visibility", visibility))
    {
        return false;
    }

    switch (declarationKind)
    {
        case LogicalPackageTypedDeclarationKind.TypeAlias:
            return true;
        case LogicalPackageTypedDeclarationKind.Type:
        case LogicalPackageTypedDeclarationKind.Function:
        case LogicalPackageTypedDeclarationKind.Global:
            if (!LogicalPackageImageJsonAppendRequiredTextMember(document, declarationNode, "Kind", manifestKind))
            {
                return false;
            }

            hasManifestKind = true;
            return true;
    }
}

internal fn bool LogicalPackageImageJsonTypedDeclarationTypeAliasFacts(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] declarationNode,
    out u32[0 max] genericParameterCount,
    out u32[0 max] comptimeGenericParameterCount)
{
    genericParameterCount = 0;
    comptimeGenericParameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] targetTypeNode = 0;
    return LogicalPackageImageJsonRequiredObjectMember(document, declarationNode, "TargetType", targetTypeNode)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "GenericParameters", genericParameterCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "ComptimeGenericParameters", comptimeGenericParameterCount);
}

internal fn bool LogicalPackageImageJsonTypedDeclarationTypeFacts(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] declarationNode,
    out u32[0 max] genericParameterCount,
    out u32[0 max] comptimeGenericParameterCount,
    out u32[0 max] fieldCount,
    out u32[0 max] variantCount,
    out u32[0 max] methodCount,
    out u32[0 max] constructorCount,
    out u32[0 max] associatedTypeCount,
    out u32[0 max] implementedTraitCount,
    out u32[0 max] threadSafetyLawAttributeCount,
    out bool hasBackendOptimizationMode,
    out bool hasStructLayout,
    out bool hasPackBytes,
    out bool hasAlignBytes,
    out bool isDynTrait)
{
    genericParameterCount = 0;
    comptimeGenericParameterCount = 0;
    fieldCount = 0;
    variantCount = 0;
    methodCount = 0;
    constructorCount = 0;
    associatedTypeCount = 0;
    implementedTraitCount = 0;
    threadSafetyLawAttributeCount = 0;
    hasBackendOptimizationMode = false;
    hasStructLayout = false;
    hasPackBytes = false;
    hasAlignBytes = false;
    isDynTrait = false;
    stack mut u64[0 2 ** 63 - 1] backendOptimizationModeNode = 0;
    stack mut u64[0 2 ** 63 - 1] structLayoutNode = 0;
    hasBackendOptimizationMode = LogicalPackageImageJsonMemberHasValue(document, declarationNode, "BackendOptimizationMode");
    hasStructLayout = LogicalPackageImageJsonMemberHasValue(document, declarationNode, "StructLayout");
    return LogicalPackageImageJsonRequiredArrayMemberCount(document, declarationNode, "Fields", fieldCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "GenericParameters", genericParameterCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "ComptimeGenericParameters", comptimeGenericParameterCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "Variants", variantCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "Methods", methodCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "Constructors", constructorCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "AssociatedTypes", associatedTypeCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "ImplementedTraits", implementedTraitCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "ThreadSafetyLawAttributes", threadSafetyLawAttributeCount)
        && (!document.TryFindMember(declarationNode, "BackendOptimizationMode", backendOptimizationModeNode)
            || document.KindAt(backendOptimizationModeNode) == JsonKind.Null
            || document.KindAt(backendOptimizationModeNode) == JsonKind.Text)
        && (!document.TryFindMember(declarationNode, "StructLayout", structLayoutNode)
            || document.KindAt(structLayoutNode) == JsonKind.Null
            || document.KindAt(structLayoutNode) == JsonKind.Text)
        && LogicalPackageImageJsonMemberIsPresentNumber(document, declarationNode, "PackBytes", hasPackBytes)
        && LogicalPackageImageJsonMemberIsPresentNumber(document, declarationNode, "AlignBytes", hasAlignBytes)
        && LogicalPackageImageJsonOptionalBoolMemberValue(document, declarationNode, "IsDynTrait", isDynTrait);
}

internal fn bool LogicalPackageImageJsonTypedDeclarationFunctionFacts(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] declarationNode,
    out u32[0 max] genericParameterCount,
    out u32[0 max] comptimeGenericParameterCount,
    out u32[0 max] parameterCount,
    out u32[0 max] threadSafetyLawPredicateCount,
    out u32[0 max] typeParameterConstraintCount,
    out u32[0 max] valueContractCount,
    out bool hasBackendOptimizationMode,
    out bool isFfi,
    out bool isStrictFp,
    out bool usesFastCallingConvention,
    out bool hasGenericTemplateBody)
{
    genericParameterCount = 0;
    comptimeGenericParameterCount = 0;
    parameterCount = 0;
    threadSafetyLawPredicateCount = 0;
    typeParameterConstraintCount = 0;
    valueContractCount = 0;
    hasBackendOptimizationMode = false;
    isFfi = false;
    isStrictFp = false;
    usesFastCallingConvention = false;
    hasGenericTemplateBody = false;
    stack mut u64[0 2 ** 63 - 1] returnTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] symbolNameNode = 0;
    stack mut u64[0 2 ** 63 - 1] backendOptimizationModeNode = 0;
    hasBackendOptimizationMode = LogicalPackageImageJsonMemberHasValue(document, declarationNode, "BackendOptimizationMode");
    return LogicalPackageImageJsonRequiredObjectMember(document, declarationNode, "ReturnType", returnTypeNode)
        && document.TryFindMember(declarationNode, "SymbolName", symbolNameNode)
        && document.KindAt(symbolNameNode) == JsonKind.Text
        && System.Text.AsciiLength(document.TextAt(symbolNameNode)) > 0
        && LogicalPackageImageJsonRequiredArrayMemberCount(document, declarationNode, "Parameters", parameterCount)
        && LogicalPackageImageJsonRequiredBoolMemberValue(document, declarationNode, "IsFfi", isFfi)
        && LogicalPackageImageJsonRequiredBoolMemberValue(document, declarationNode, "IsStrictFp", isStrictFp)
        && LogicalPackageImageJsonRequiredBoolMemberValue(document, declarationNode, "UseFastCallingConvention", usesFastCallingConvention)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "GenericParameters", genericParameterCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "ComptimeGenericParameters", comptimeGenericParameterCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "ThreadSafetyLawPredicates", threadSafetyLawPredicateCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "TypeParameterConstraints", typeParameterConstraintCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, declarationNode, "ValueContracts", valueContractCount)
        && LogicalPackageImageJsonOptionalBoolMemberValue(document, declarationNode, "HasGenericTemplateBody", hasGenericTemplateBody)
        && (!document.TryFindMember(declarationNode, "BackendOptimizationMode", backendOptimizationModeNode)
            || document.KindAt(backendOptimizationModeNode) == JsonKind.Null
            || document.KindAt(backendOptimizationModeNode) == JsonKind.Text);
}

internal fn bool LogicalPackageImageJsonAppendTypedCallableText(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callableNode,
    LogicalPackageTypedCallableKind callableKind,
    mut borrow OwnedAscii name,
    mut borrow OwnedAscii qualifiedName,
    mut borrow OwnedAscii visibility,
    mut borrow OwnedAscii symbolName,
    mut borrow OwnedAscii manifestKind,
    mut borrow OwnedAscii qualifiedResolvedName,
    mut borrow OwnedAscii publishedOverloadKey,
    mut borrow OwnedAscii inlinePreference,
    mut borrow OwnedAscii ffiAbi,
    mut borrow OwnedAscii backendOptimizationMode,
    mut borrow OwnedAscii linkName,
    out bool hasVisibility,
    out bool hasQualifiedResolvedName,
    out bool hasPublishedOverloadKey,
    out bool hasInlinePreference,
    out bool hasFfiAbi,
    out bool hasBackendOptimizationMode,
    out bool hasLinkName)
{
    hasVisibility = false;
    hasQualifiedResolvedName = false;
    hasPublishedOverloadKey = false;
    hasInlinePreference = false;
    hasFfiAbi = false;
    hasBackendOptimizationMode = false;
    hasLinkName = false;
    if (!LogicalPackageImageJsonAppendRequiredTextMember(document, callableNode, "Name", name)
        || !LogicalPackageImageJsonAppendRequiredTextMember(document, callableNode, "QualifiedName", qualifiedName)
        || !LogicalPackageImageJsonAppendRequiredTextMember(document, callableNode, "SymbolName", symbolName)
        || !LogicalPackageImageJsonAppendRequiredTextMember(document, callableNode, "Kind", manifestKind))
    {
        return false;
    }

    switch (callableKind)
    {
        case LogicalPackageTypedCallableKind.Function:
            if (!LogicalPackageImageJsonAppendRequiredTextMember(document, callableNode, "Visibility", visibility))
            {
                return false;
            }

            hasVisibility = true;
        case LogicalPackageTypedCallableKind.Method:
            if (!LogicalPackageImageJsonAppendOptionalTextMember(document, callableNode, "Visibility", visibility, hasVisibility))
            {
                return false;
            }
    }

    if (!LogicalPackageImageJsonAppendOptionalTextMember(
            document,
            callableNode,
            "QualifiedResolvedName",
            qualifiedResolvedName,
            hasQualifiedResolvedName)
        || !LogicalPackageImageJsonAppendOptionalTextMember(
            document,
            callableNode,
            "PublishedOverloadKey",
            publishedOverloadKey,
            hasPublishedOverloadKey)
        || !LogicalPackageImageJsonAppendOptionalTextMember(
            document,
            callableNode,
            "InlinePreference",
            inlinePreference,
            hasInlinePreference)
        || !LogicalPackageImageJsonAppendOptionalTextMember(document, callableNode, "FfiAbi", ffiAbi, hasFfiAbi)
        || !LogicalPackageImageJsonAppendOptionalTextMember(
            document,
            callableNode,
            "BackendOptimizationMode",
            backendOptimizationMode,
            hasBackendOptimizationMode))
    {
        return false;
    }

    if (callableKind == LogicalPackageTypedCallableKind.Function)
    {
        return LogicalPackageImageJsonAppendOptionalTextMember(document, callableNode, "LinkName", linkName, hasLinkName);
    }

    return true;
}

internal fn bool LogicalPackageImageJsonTypedCallableFacts(
    borrow JsonDocument document,
