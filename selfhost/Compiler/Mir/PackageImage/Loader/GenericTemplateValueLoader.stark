module Compiler.Mir.PackageImage.Loader.GenericTemplateValueLoader

// Generic-template call, bound-operation, object/enum, conversion, field,
// local, and try-propagation JSON materialization.

internal fn bool LogicalPackageImageJsonEffectiveGenericTemplatesNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    out u64[0 2 ** 63 - 1] genericTemplatesNode,
    out bool usesCompilerSections)
{
    genericTemplatesNode = 0;
    usesCompilerSections = false;
    stack mut u64[0 2 ** 63 - 1] directGenericTemplatesNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsGenericTemplatesNode = 0;
    stack mut bool hasDirectGenericTemplates = false;
    stack mut bool hasCompilerSections = false;
    stack mut bool hasCompilerSectionsGenericTemplates = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "GenericTemplates", directGenericTemplatesNode, hasDirectGenericTemplates)
        || !LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "CompilerSections", compilerSectionsNode, hasCompilerSections))
    {
        return false;
    }

    if (hasCompilerSections)
    {
        if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            compilerSectionsNode,
            "GenericTemplates",
            compilerSectionsGenericTemplatesNode,
            hasCompilerSectionsGenericTemplates))
        {
            return false;
        }
    }

    if (hasCompilerSectionsGenericTemplates)
    {
        genericTemplatesNode = compilerSectionsGenericTemplatesNode;
        usesCompilerSections = true;
        return true;
    }

    if (hasDirectGenericTemplates)
    {
        genericTemplatesNode = directGenericTemplatesNode;
        return true;
    }

    return false;
}

internal fn bool LogicalPackageImageJsonMaterializeGenericTemplateFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageGenericTemplateFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    return LogicalPackageGenericTemplateFactGraphAddTextRow(graph, textKind, textOrdinal, value, textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageGenericTemplateFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out bool present,
    out u32[0 max] textRow)
{
    present = false;
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    if (!LogicalPackageGenericTemplateFactGraphAddTextRow(graph, textKind, textOrdinal, value, textRow))
    {
        return false;
    }

    present = true;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRowAllowEmpty(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageGenericTemplateFactTextKind textKind,
    u32[0 max] textOrdinal,
    bool allowEmpty,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out bool present,
    out u32[0 max] textRow)
{
    present = false;
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) < 0
        || (!allowEmpty && System.Text.AsciiLength(value) == 0))
    {
        return false;
    }

    if (!LogicalPackageGenericTemplateFactGraphAddTextRow(graph, textKind, textOrdinal, value, textRow))
    {
        return false;
    }

    present = true;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeGenericTemplateTypeReference(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeReferenceNode,
    u32[0 max] functionTemplateRow,
    LogicalPackageTypedTypeReferenceSource source,
    u32[0 max] payloadOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out u32[0 max] typeReferenceRow)
{
    typeReferenceRow = 0;
    if (!graph.FunctionTemplateRows.Contains(functionTemplateRow))
    {
        return false;
    }

    stack LogicalPackageFunctionTemplateRow template =
        graph.FunctionTemplateRows.Get(functionTemplateRow);
    return LogicalPackageImageJsonMaterializeTypeReferenceGraph(
        document,
        typeReferenceNode,
        template.ModuleOrdinal(),
        LogicalPackageTypedDeclarationKind.Function,
        template.TemplateOrdinal(),
        0,
        0,
        source,
        payloadOrdinal,
        graph.TypeReferences,
        typeReferenceRow);
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateExpressionMemberNameRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] memberNamesNode,
    u32[0 max] memberNameCount,
    u32[0 max] expressionRow,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < memberNameCount)
    {
        stack mut u64[0 2 ** 63 - 1] memberNameNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        if (!document.TryChildAt(memberNamesNode, (u64[0 2 ** 63 - 1])index, memberNameNode)
            || document.KindAt(memberNameNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii memberName = document.TextAt(memberNameNode);
        if (System.Text.AsciiLength(memberName) <= 0
            || !LogicalPackageGenericTemplateFactGraphAddTextRow(
                graph,
                LogicalPackageGenericTemplateFactTextKind.ExpressionMemberName,
                index,
                memberName,
                nameTextRow)
            || !LogicalPackageGenericTemplateFactGraphAddTypedTemplateExpressionMemberNameRow(
                graph,
                expressionRow,
                index,
                nameTextRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

