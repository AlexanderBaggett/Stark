internal fn LogicalPackageTypedTypeReferenceSource LogicalPackageTemplateCallReturnTypeSource(
    LogicalPackageTemplateCallParentKind parentKind)
{
    switch (parentKind)
    {
        case LogicalPackageTemplateCallParentKind.DirectCall:
            return LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallReturnType;
        case LogicalPackageTemplateCallParentKind.MemberCall:
            return LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallReturnType;
        case LogicalPackageTemplateCallParentKind.FunctionAddress:
            return LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressReturnType;
        case LogicalPackageTemplateCallParentKind.BoundOperation:
            return LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationReturnType;
    }
}

internal fn LogicalPackageTypedTypeReferenceSource LogicalPackageTemplateCallParameterTypeSource(
    LogicalPackageTemplateCallParentKind parentKind)
{
    switch (parentKind)
    {
        case LogicalPackageTemplateCallParentKind.DirectCall:
            return LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallParameterType;
        case LogicalPackageTemplateCallParentKind.MemberCall:
            return LogicalPackageTypedTypeReferenceSource.GenericTemplateMemberCallParameterType;
        case LogicalPackageTemplateCallParentKind.FunctionAddress:
            return LogicalPackageTypedTypeReferenceSource.GenericTemplateFunctionAddressParameterType;
        case LogicalPackageTemplateCallParentKind.BoundOperation:
            return LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationParameterType;
    }
}

internal fn LogicalPackageTypedTypeReferenceSource LogicalPackageTemplateCallTypeArgumentSource(
    LogicalPackageTemplateCallParentKind parentKind)
{
    switch (parentKind)
    {
        case LogicalPackageTemplateCallParentKind.DirectCall:
            return LogicalPackageTypedTypeReferenceSource.GenericTemplateDirectCallTypeArgument;
        case LogicalPackageTemplateCallParentKind.MemberCall:
