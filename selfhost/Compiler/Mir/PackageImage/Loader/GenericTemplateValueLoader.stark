internal fn bool LogicalPackageImageJsonMaterializeTemplateCallParameterRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] parametersNode,
    u32[0 max] parameterCount,
    u32[0 max] callSignatureRow,
    u32[0 max] functionTemplateRow,
    LogicalPackageTemplateCallParentKind parentKind,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        stack mut u32[0 max] typeReferenceRow = 0;
        stack mut u32[0 max] rawPointerElementCountExpressionTextRow = 0;
        stack mut bool isDisjoint = false;
        stack mut bool isConst = false;
        stack mut bool hasRawPointerElementCountExpression = false;
        if (!document.TryChildAt(parametersNode, (u64[0 2 ** 63 - 1])index, parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeGenericTemplateFactTextMemberRow(
                document,
                parameterNode,
                "Name",
                LogicalPackageGenericTemplateFactTextKind.CallParameterName,
                index,
                graph,
                nameTextRow)
            || !LogicalPackageImageJsonRequiredObjectMember(document, parameterNode, "Type", typeNode)
            || !LogicalPackageImageJsonMaterializeGenericTemplateTypeReference(
                document,
                typeNode,
                functionTemplateRow,
                LogicalPackageTemplateCallParameterTypeSource(parentKind),
                index,
                graph,
                typeReferenceRow)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(document, parameterNode, "IsDisjoint", isDisjoint)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(document, parameterNode, "IsConst", isConst)
            || !LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRow(
                document,
                parameterNode,
                "RawPointerElementCountExpression",
                LogicalPackageGenericTemplateFactTextKind.CallParameterRawPointerElementCountExpression,
                index,
                graph,
                hasRawPointerElementCountExpression,
                rawPointerElementCountExpressionTextRow)
            || !LogicalPackageGenericTemplateFactGraphAddTemplateCallParameterRow(
                graph,
                callSignatureRow,
                index,
                nameTextRow,
                typeReferenceRow,
                isDisjoint,
                isConst,
                hasRawPointerElementCountExpression,
                rawPointerElementCountExpressionTextRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeTemplateCallTypeArgumentRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeArgumentsNode,
    u32[0 max] typeArgumentCount,
    u32[0 max] callSignatureRow,
    u32[0 max] functionTemplateRow,
    LogicalPackageTemplateCallParentKind parentKind,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < typeArgumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u32[0 max] typeReferenceRow = 0;
        if (!document.TryChildAt(typeArgumentsNode, (u64[0 2 ** 63 - 1])index, typeNode)
            || document.KindAt(typeNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeGenericTemplateTypeReference(
                document,
                typeNode,
                functionTemplateRow,
                LogicalPackageTemplateCallTypeArgumentSource(parentKind),
                index,
                graph,
                typeReferenceRow)
            || !LogicalPackageGenericTemplateFactGraphAddTemplateCallTypeArgumentRow(
                graph,
                callSignatureRow,
                index,
                typeReferenceRow))
        {
