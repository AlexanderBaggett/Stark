internal fn bool LogicalPackageImageJsonMaterializeDeferredFunctionInstantiationRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] instantiationsNode,
    u32[0 max] instantiationCount,
    u32[0 max] functionTemplateRow,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < instantiationCount)
    {
        stack mut u64[0 2 ** 63 - 1] instantiationNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeArgumentsNode = 0;
        stack mut u32[0 max] typeArgumentCount = 0;
        stack mut u64[0 2 ** 63 - 1] comptimeValueArgumentsNode = 0;
        stack mut u32[0 max] comptimeValueArgumentCount = 0;
        stack mut u32[0 max] calleeTemplateNameTextRow = 0;
        stack mut u32[0 max] instantiationRow = 0;
        if (!document.TryChildAt(
                instantiationsNode,
                (u64[0 2 ** 63 - 1])index,
                instantiationNode)
            || document.KindAt(instantiationNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeGenericTemplateFactTextMemberRow(
                document,
                instantiationNode,
                "CalleeTemplateName",
                LogicalPackageGenericTemplateFactTextKind.DeferredFunctionInstantiationCalleeTemplateName,
                index,
                graph,
                calleeTemplateNameTextRow)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                instantiationNode,
                "TypeArguments",
                typeArgumentsNode,
                typeArgumentCount)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                instantiationNode,
                "ComptimeValueArguments",
                comptimeValueArgumentsNode,
                comptimeValueArgumentCount)
            || !LogicalPackageGenericTemplateFactGraphAddDeferredFunctionInstantiationRow(
                graph,
                functionTemplateRow,
                index,
                calleeTemplateNameTextRow,
                typeArgumentCount,
                comptimeValueArgumentCount,
                instantiationRow)
            || !LogicalPackageImageJsonMaterializeDeferredFunctionInstantiationTypeArgumentRows(
                document,
                typeArgumentsNode,
                typeArgumentCount,
                instantiationRow,
                functionTemplateRow,
                graph)
            || !LogicalPackageImageJsonMaterializeDeferredFunctionInstantiationComptimeValueArgumentRows(
                document,
                comptimeValueArgumentsNode,
                comptimeValueArgumentCount,
                instantiationRow,
                functionTemplateRow,
                graph))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

