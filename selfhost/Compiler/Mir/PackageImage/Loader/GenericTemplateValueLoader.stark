internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateExpressionComptimeValueArgumentRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] argumentsNode,
    u32[0 max] argumentCount,
    u32[0 max] expressionRow,
    u32[0 max] functionTemplateRow,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u32[0 max] parameterNameTextRow = 0;
        stack mut u32[0 max] integerValueTextRow = 0;
        stack mut u32[0 max] symbolicSourceNameTextRow = 0;
        stack mut bool hasSymbolicSourceName = false;
        stack mut bool isSymbolic = false;
        stack mut u32[0 max] typeReferenceRow = 0;
        if (!document.TryChildAt(argumentsNode, (u64[0 2 ** 63 - 1])index, argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeGenericTemplateFactTextMemberRow(
                document,
                argumentNode,
                "ParameterName",
                LogicalPackageGenericTemplateFactTextKind.ExpressionComptimeValueArgumentParameterName,
                index,
                graph,
                parameterNameTextRow)
            || !LogicalPackageImageJsonMaterializeGenericTemplateFactTextMemberRow(
                document,
                argumentNode,
                "IntegerValue",
                LogicalPackageGenericTemplateFactTextKind.ExpressionComptimeValueArgumentIntegerValue,
                index,
                graph,
                integerValueTextRow)
            || !LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRow(
                document,
                argumentNode,
                "SymbolicSourceName",
                LogicalPackageGenericTemplateFactTextKind.ExpressionComptimeValueArgumentSymbolicSourceName,
                index,
                graph,
                hasSymbolicSourceName,
                symbolicSourceNameTextRow)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(document, argumentNode, "IsSymbolic", isSymbolic)
            || !LogicalPackageImageJsonRequiredObjectMember(document, argumentNode, "Type", typeNode)
            || !LogicalPackageImageJsonMaterializeGenericTemplateTypeReference(
                document,
                typeNode,
                functionTemplateRow,
                LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionComptimeValueArgumentType,
                index,
                graph,
                typeReferenceRow)
            || !LogicalPackageGenericTemplateFactGraphAddTypedTemplateExpressionComptimeValueArgumentRow(
                graph,
                expressionRow,
                index,
                parameterNameTextRow,
                integerValueTextRow,
                typeReferenceRow,
                isSymbolic,
                hasSymbolicSourceName,
                symbolicSourceNameTextRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

