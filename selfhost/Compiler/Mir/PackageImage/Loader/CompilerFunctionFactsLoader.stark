internal fn bool LogicalPackageFunctionOwnershipFactGraphAddFunctionOwnershipRow(
    mut borrow LogicalPackageFunctionOwnershipFactGraph graph,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionSemanticOrdinal,
    u32[0 max] qualifiedResolvedNameTextRow,
    bool ownershipValid,
    out u32[0 max] functionOwnershipRow)
{
    functionOwnershipRow = 0;
    if (!graph.TextRows.Contains(qualifiedResolvedNameTextRow))
    {
        return false;
    }

    stack LogicalPackageFunctionOwnershipRow row = new LogicalPackageFunctionOwnershipRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        FunctionSemanticOrdinalValue = functionSemanticOrdinal,
        QualifiedResolvedNameTextRowValue = qualifiedResolvedNameTextRow,
        OwnershipValidValue = ownershipValid
    };
    functionOwnershipRow = graph.FunctionOwnershipRows.Add(row);
    return functionOwnershipRow != 0;
}

