internal fn bool LogicalPackageFunctionOwnershipFactGraphAddRootRow(
    mut borrow LogicalPackageFunctionOwnershipFactGraph graph,
    u32[0 max] functionOwnershipRow,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionSemanticOrdinal,
    u32[0 max] rootOrdinal,
    u32[0 max] nameTextRow,
    u32[0 max] typeReferenceRow,
    u32[0 max] rootKindTextRow,
    u32[0 max] finalAvailabilityTextRow,
    bool isMutable,
    bool isConstant,
    bool isAddressTaken,
    bool hasRawPointerEscape,
    bool hasMove,
    bool hasPartialMove,
    bool hasImplicitDrop,
    bool hasAssignmentDrop,
    bool hasReinitialization,
    bool requiresDrop)
{
    if (!graph.FunctionOwnershipRows.Contains(functionOwnershipRow)
        || !graph.TextRows.Contains(nameTextRow)
        || !graph.TypeReferences.ContainsTypeReference(typeReferenceRow)
        || !graph.TextRows.Contains(rootKindTextRow)
        || !graph.TextRows.Contains(finalAvailabilityTextRow))
    {
        return false;
    }

    stack LogicalPackageFunctionOwnershipRootRow row =
        new LogicalPackageFunctionOwnershipRootRow()
    {
        FunctionOwnershipRowValue = functionOwnershipRow,
        ModuleOrdinalValue = moduleOrdinal,
        FunctionSemanticOrdinalValue = functionSemanticOrdinal,
        RootOrdinalValue = rootOrdinal,
        NameTextRowValue = nameTextRow,
        TypeReferenceRowValue = typeReferenceRow,
        RootKindTextRowValue = rootKindTextRow,
        FinalAvailabilityTextRowValue = finalAvailabilityTextRow,
        IsMutableValue = isMutable,
        IsConstantValue = isConstant,
        IsAddressTakenValue = isAddressTaken,
        HasRawPointerEscapeValue = hasRawPointerEscape,
        HasMoveValue = hasMove,
        HasPartialMoveValue = hasPartialMove,
        HasImplicitDropValue = hasImplicitDrop,
        HasAssignmentDropValue = hasAssignmentDrop,
        HasReinitializationValue = hasReinitialization,
        RequiresDropValue = requiresDrop
    };
    stack u32[0 max] addedRow = graph.RootRows.Add(row);
    if (addedRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageFunctionOwnershipRow parent =
        graph.FunctionOwnershipRows.Get(functionOwnershipRow);
    if (parent.RootRowCountValue == 0)
    {
        parent.FirstRootRowValue = addedRow;
    }
    else if (addedRow != parent.FirstRootRowValue + parent.RootRowCountValue)
    {
        return false;
    }

    parent.RootRowCountValue = parent.RootRowCountValue + 1;
    return graph.FunctionOwnershipRows.Replace(functionOwnershipRow, parent);
}

public fn MemoryStatus AppendLogicalPackageFunctionSemanticFactText(
    borrow LogicalPackageFunctionSemanticFactGraph graph,
    LogicalPackageFunctionSemanticFactTextRow textRow,
    mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] start = (u64[0 2 ** 63 - 1])textRow.ByteOffsetValue;
    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])textRow.ByteLengthValue;
    if (start + length > graph.TextBytes.Length)
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < length)
    {
        try sink.AppendByte(graph.TextBytes[start + index]);
        index = index + 1;
    }

    return MemoryStatus.Ok;
}

