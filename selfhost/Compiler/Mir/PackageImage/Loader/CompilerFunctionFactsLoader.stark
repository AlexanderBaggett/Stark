internal fn bool LogicalPackageImageJsonMaterializeFunctionOwnershipEventRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] ownershipNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionSemanticOrdinal,
    u32[0 max] functionOwnershipRow,
    mut borrow LogicalPackageFunctionOwnershipFactGraph graph,
    out u32[0 max] eventCount)
{
    eventCount = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(document, ownershipNode, "Events", arrayNode, eventCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < eventCount)
    {
        stack mut u64[0 2 ** 63 - 1] eventNode = 0;
        stack mut u64[0 2 ** 63 - 1] placeNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u64[0 2 ** 63 - 1] locationNode = 0;
        stack mut bool hasIndexProjection = false;
        stack mut bool hasLocation = false;
        stack mut bool hasLocationFilePath = false;
        stack mut i64[min max] locationLine = 0;
        stack mut i64[min max] locationColumn = 0;
        stack mut u32[0 max] kindTextRow = 0;
        stack mut u32[0 max] rootNameTextRow = 0;
        stack mut u32[0 max] locationFilePathTextRow = 0;
        stack mut u32[0 max] placeTypeReferenceRow = 0;
        stack mut u32[0 max] eventRow = 0;
        stack mut u32[0 max] projectionCount = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, eventNode)
            || document.KindAt(eventNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipFactTextMemberRow(
                document,
                eventNode,
                "Kind",
                LogicalPackageFunctionOwnershipFactTextKind.EventKind,
                index,
                graph,
                kindTextRow)
            || !LogicalPackageImageJsonRequiredObjectMember(document, eventNode, "Place", placeNode)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipFactTextMemberRow(
                document,
                placeNode,
                "RootName",
                LogicalPackageFunctionOwnershipFactTextKind.EventRootName,
                index,
                graph,
                rootNameTextRow)
            || !LogicalPackageImageJsonRequiredObjectMember(document, placeNode, "Type", typeNode)
            || !LogicalPackageImageJsonOptionalBoolMemberValue(
                document,
                placeNode,
                "HasIndexProjection",
                hasIndexProjection)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                eventNode,
                "Location",
                locationNode,
                hasLocation))
        {
            return false;
        }

        if (hasLocation
            && (!LogicalPackageImageJsonMaterializeOptionalFunctionOwnershipFactTextMemberRow(
                    document,
                    locationNode,
                    "FilePath",
                    LogicalPackageFunctionOwnershipFactTextKind.EventLocationFilePath,
                    index,
                    graph,
                    hasLocationFilePath,
                    locationFilePathTextRow)
                || !LogicalPackageImageJsonRequiredI64MemberValue(
                    document,
                    locationNode,
                    "Line",
                    locationLine)
                || !LogicalPackageImageJsonRequiredI64MemberValue(
                    document,
                    locationNode,
                    "Column",
                    locationColumn)))
        {
            return false;
        }

        if (!LogicalPackageImageJsonMaterializeTypeReferenceGraph(
                document,
                typeNode,
                moduleOrdinal,
                LogicalPackageTypedDeclarationKind.Function,
                functionSemanticOrdinal,
                0,
                0,
                LogicalPackageTypedTypeReferenceSource.FunctionOwnershipEventPlaceType,
                index,
                graph.TypeReferences,
                placeTypeReferenceRow)
            || !LogicalPackageFunctionOwnershipFactGraphAddEventRow(
                graph,
                functionOwnershipRow,
                moduleOrdinal,
                functionSemanticOrdinal,
                index,
                kindTextRow,
                rootNameTextRow,
                placeTypeReferenceRow,
                hasIndexProjection,
                hasLocation,
                hasLocationFilePath,
                locationFilePathTextRow,
                locationLine,
                locationColumn,
                eventRow)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipProjectionRows(
                document,
                placeNode,
                moduleOrdinal,
                functionSemanticOrdinal,
                index,
                eventRow,
                graph,
                projectionCount))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
