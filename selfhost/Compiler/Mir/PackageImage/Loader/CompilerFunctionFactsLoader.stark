internal fn bool LogicalPackageFunctionSemanticFactGraphAddCallArgumentRow(
    mut borrow LogicalPackageFunctionSemanticFactGraph graph,
    u32[0 max] callRow,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionSemanticOrdinal,
    u32[0 max] callOrdinal,
    u32[0 max] callArgumentOrdinal,
    u32[0 max] argumentIndex,
    bool hasCallerParameterName,
    u32[0 max] callerParameterNameTextRow,
    bool hasCalleeParameterName,
    u32[0 max] calleeParameterNameTextRow,
    u32[0 max] captureKindTextRow,
    bool reads,
    bool writes)
{
    if (!graph.CallRows.Contains(callRow)
        || (hasCallerParameterName && !graph.TextRows.Contains(callerParameterNameTextRow))
        || (!hasCallerParameterName && callerParameterNameTextRow != 0)
        || (hasCalleeParameterName && !graph.TextRows.Contains(calleeParameterNameTextRow))
        || (!hasCalleeParameterName && calleeParameterNameTextRow != 0)
        || !graph.TextRows.Contains(captureKindTextRow))
    {
        return false;
    }

    stack LogicalPackageFunctionSemanticCallArgumentRow row =
        new LogicalPackageFunctionSemanticCallArgumentRow()
    {
        CallRowValue = callRow,
        ModuleOrdinalValue = moduleOrdinal,
        FunctionSemanticOrdinalValue = functionSemanticOrdinal,
        CallOrdinalValue = callOrdinal,
        CallArgumentOrdinalValue = callArgumentOrdinal,
        ArgumentIndexValue = argumentIndex,
        CallerParameterNameTextRowValue = callerParameterNameTextRow,
        CalleeParameterNameTextRowValue = calleeParameterNameTextRow,
        CaptureKindTextRowValue = captureKindTextRow,
        HasCallerParameterNameValue = hasCallerParameterName,
        HasCalleeParameterNameValue = hasCalleeParameterName,
        ReadsValue = reads,
        WritesValue = writes
    };
    stack u32[0 max] addedRow = graph.CallArgumentRows.Add(row);
    if (addedRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageFunctionSemanticCallRow parent = graph.CallRows.Get(callRow);
    if (parent.ArgumentRowCountValue == 0)
    {
        parent.FirstArgumentRowValue = addedRow;
    }
    else if (addedRow != parent.FirstArgumentRowValue + parent.ArgumentRowCountValue)
    {
        return false;
    }

    parent.ArgumentRowCountValue = parent.ArgumentRowCountValue + 1;
    return graph.CallRows.Replace(callRow, parent);
}

