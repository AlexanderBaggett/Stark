    if (!LogicalPackageImageJsonRequiredArrayMember(document, ownershipNode, memberName, arrayNode, nameCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < nameCount)
    {
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, nameNode)
            || document.KindAt(nameNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii name = document.TextAt(nameNode);
        if (System.Text.AsciiLength(name) <= 0
            || !LogicalPackageFunctionOwnershipFactGraphAddTextRow(
                graph,
                textKind,
                index,
                name,
                nameTextRow))
        {
            return false;
        }

        if (isImplicitDrop)
        {
            if (!LogicalPackageFunctionOwnershipFactGraphAddImplicitDropRow(
                graph,
                functionOwnershipRow,
                moduleOrdinal,
                functionSemanticOrdinal,
                index,
                nameTextRow))
            {
                return false;
            }
        }
        else if (!LogicalPackageFunctionOwnershipFactGraphAddMoveRow(
            graph,
            functionOwnershipRow,
            moduleOrdinal,
            functionSemanticOrdinal,
            index,
            nameTextRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

