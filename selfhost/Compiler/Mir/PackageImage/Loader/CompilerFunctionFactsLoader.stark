internal fn bool LogicalPackageFunctionOwnershipFactGraphAddEventRow(
    mut borrow LogicalPackageFunctionOwnershipFactGraph graph,
    u32[0 max] functionOwnershipRow,
    u32[0 max] moduleOrdinal,
    u32[0 max] functionSemanticOrdinal,
    u32[0 max] eventOrdinal,
    u32[0 max] kindTextRow,
    u32[0 max] rootNameTextRow,
    u32[0 max] placeTypeReferenceRow,
    bool hasIndexProjection,
    bool hasLocation,
    bool hasLocationFilePath,
    u32[0 max] locationFilePathTextRow,
    i64[min max] locationLine,
    i64[min max] locationColumn,
    out u32[0 max] eventRow)
{
    eventRow = 0;
    if (!graph.FunctionOwnershipRows.Contains(functionOwnershipRow)
        || !graph.TextRows.Contains(kindTextRow)
        || !graph.TextRows.Contains(rootNameTextRow)
        || !graph.TypeReferences.ContainsTypeReference(placeTypeReferenceRow)
        || (hasLocationFilePath && !graph.TextRows.Contains(locationFilePathTextRow))
        || (!hasLocationFilePath && locationFilePathTextRow != 0)
        || (!hasLocation && (hasLocationFilePath || locationLine != 0 || locationColumn != 0)))
    {
        return false;
    }

    stack LogicalPackageFunctionOwnershipEventRow row = new LogicalPackageFunctionOwnershipEventRow()
    {
        FunctionOwnershipRowValue = functionOwnershipRow,
        ModuleOrdinalValue = moduleOrdinal,
        FunctionSemanticOrdinalValue = functionSemanticOrdinal,
        EventOrdinalValue = eventOrdinal,
        KindTextRowValue = kindTextRow,
        RootNameTextRowValue = rootNameTextRow,
        PlaceTypeReferenceRowValue = placeTypeReferenceRow,
        LocationFilePathTextRowValue = locationFilePathTextRow,
        LocationLineValue = locationLine,
        LocationColumnValue = locationColumn,
        HasIndexProjectionValue = hasIndexProjection,
        HasLocationValue = hasLocation,
        HasLocationFilePathValue = hasLocationFilePath
    };
    stack u32[0 max] addedRow = graph.EventRows.Add(row);
    if (addedRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageFunctionOwnershipRow parent =
        graph.FunctionOwnershipRows.Get(functionOwnershipRow);
    if (parent.EventRowCountValue == 0)
    {
        parent.FirstEventRowValue = addedRow;
    }
    else if (addedRow != parent.FirstEventRowValue + parent.EventRowCountValue)
    {
        return false;
    }

    parent.EventRowCountValue = parent.EventRowCountValue + 1;
    if (!graph.FunctionOwnershipRows.Replace(functionOwnershipRow, parent))
    {
        return false;
    }

    eventRow = addedRow;
    return true;
}

