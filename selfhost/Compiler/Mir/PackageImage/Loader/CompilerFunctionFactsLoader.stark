internal fn bool LogicalPackageImageJsonMaterializeFunctionOwnershipFactRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] compilerFactsNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageFunctionOwnershipFactGraph graph,
    out u32[0 max] functionOwnershipCount)
{
    functionOwnershipCount = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    stack mut u32[0 max] functionSemanticCount = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(
        document,
        compilerFactsNode,
        "FunctionSemantics",
        arrayNode,
        functionSemanticCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < functionSemanticCount)
    {
        stack mut u64[0 2 ** 63 - 1] functionSemanticNode = 0;
        stack mut u64[0 2 ** 63 - 1] ownershipNode = 0;
        stack mut bool hasOwnership = false;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, functionSemanticNode)
            || document.KindAt(functionSemanticNode) != JsonKind.Object
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                functionSemanticNode,
                "Ownership",
                ownershipNode,
                hasOwnership))
        {
            return false;
        }

        if (!hasOwnership)
        {
            index = index + 1;
            continue;
        }

        stack mut bool ownershipValid = false;
        stack mut u32[0 max] qualifiedResolvedNameTextRow = 0;
        stack mut u32[0 max] functionOwnershipRow = 0;
        stack mut u32[0 max] implicitDropCount = 0;
        stack mut u32[0 max] moveCount = 0;
        stack mut u32[0 max] eventCount = 0;
        stack mut u32[0 max] rootCount = 0;
        if (!LogicalPackageImageJsonMaterializeFunctionOwnershipFactTextMemberRow(
                document,
                functionSemanticNode,
                "QualifiedResolvedName",
                LogicalPackageFunctionOwnershipFactTextKind.QualifiedResolvedName,
                index,
                graph,
                qualifiedResolvedNameTextRow)
            || !LogicalPackageImageJsonRequiredBoolMemberValue(
                document,
                ownershipNode,
                "OwnershipValid",
                ownershipValid)
            || !LogicalPackageFunctionOwnershipFactGraphAddFunctionOwnershipRow(
                graph,
                moduleOrdinal,
                index,
                qualifiedResolvedNameTextRow,
                ownershipValid,
                functionOwnershipRow)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipNameRows(
                document,
                ownershipNode,
                "ImplicitDrops",
                LogicalPackageFunctionOwnershipFactTextKind.ImplicitDropName,
                true,
                moduleOrdinal,
                index,
                functionOwnershipRow,
                graph,
                implicitDropCount)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipNameRows(
                document,
                ownershipNode,
                "Moves",
                LogicalPackageFunctionOwnershipFactTextKind.MoveName,
                false,
                moduleOrdinal,
                index,
                functionOwnershipRow,
                graph,
                moveCount)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipEventRows(
                document,
                ownershipNode,
                moduleOrdinal,
                index,
                functionOwnershipRow,
                graph,
                eventCount)
            || !LogicalPackageImageJsonMaterializeFunctionOwnershipRootRows(
                document,
                ownershipNode,
                moduleOrdinal,
                index,
                functionOwnershipRow,
                graph,
                rootCount))
        {
            return false;
        }

        functionOwnershipCount = functionOwnershipCount + 1;
        index = index + 1;
    }

    return true;
}

public unsafe fn bool TryMaterializeLogicalPackageFunctionSemanticFactJsonGraph(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageFunctionSemanticFactGraph graph)
{
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] compilerFactsNode = 0;
            stack mut bool usesCompilerSections = false;
            stack mut u32[0 max] functionSemanticCount = 0;
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonEffectiveCompilerFactsNode(
                    document,
                    moduleNode,
                    compilerFactsNode,
                    usesCompilerSections))
            {
                return false;
            }

            return LogicalPackageImageJsonMaterializeFunctionSemanticFactRows(
                document,
                compilerFactsNode,
                moduleOrdinal,
                graph,
                functionSemanticCount);
    }
}

