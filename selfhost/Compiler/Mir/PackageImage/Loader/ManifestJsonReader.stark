internal fn bool LogicalPackageImageJsonOptionalU32MemberValue(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out bool present,
    out u32[0 max] value)
{
    present = false;
    value = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Number)
    {
        return false;
    }

    switch (document.I64At(member))
    {
        case JsonResult<i64[min max]>.Err(var error):
            return false;
        case JsonResult<i64[min max]>.Ok(var parsed):
            if (parsed < 0 || parsed > (i64[min max])(2 ** 32 - 1))
            {
                return false;
            }

            present = true;
            value = (u32[0 max])parsed;
            return true;
    }
}

internal fn bool LogicalPackageImageJsonRequiredU32MemberValue(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out u32[0 max] value)
{
    value = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Number)
    {
        return false;
    }

    switch (document.I64At(member))
    {
        case JsonResult<i64[min max]>.Err(var error):
            return false;
        case JsonResult<i64[min max]>.Ok(var parsed):
            if (parsed < 0 || parsed > (i64[min max])(2 ** 32 - 1))
            {
                return false;
            }

            value = (u32[0 max])parsed;
            return true;
    }
}

internal fn bool LogicalPackageImageJsonRequiredI64MemberValue(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out i64[min max] value)
{
    value = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Number)
    {
        return false;
    }

    switch (document.I64At(member))
    {
        case JsonResult<i64[min max]>.Err(var error):
            return false;
        case JsonResult<i64[min max]>.Ok(var parsed):
            value = parsed;
            return true;
    }
}

internal fn bool LogicalPackageImageJsonRequiredBoolMemberValue(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out bool value)
{
    value = false;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member))
    {
        return false;
    }

    stack JsonKind kind = document.KindAt(member);
    if (kind != JsonKind.True && kind != JsonKind.False)
    {
        return false;
    }

    value = document.BoolAt(member);
    return true;
}

internal fn bool LogicalPackageImageJsonOptionalBoolMemberPresenceValueWithDefault(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    bool defaultValue,
    out bool present,
    out bool value)
{
    present = false;
    value = defaultValue;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    stack JsonKind kind = document.KindAt(member);
    if (kind != JsonKind.True && kind != JsonKind.False)
    {
        return false;
    }

    present = true;
    value = document.BoolAt(member);
    return true;
}

