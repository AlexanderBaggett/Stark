internal fn bool LogicalPackageImageJsonOptionalObjectMember(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out u64[0 2 ** 63 - 1] member,
    out bool present)
{
    member = 0;
    present = false;
    stack mut u64[0 2 ** 63 - 1] found = 0;
    if (!document.TryFindMember(objectNode, memberName, found)
        || document.KindAt(found) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(found) != JsonKind.Object)
    {
        return false;
    }

    member = found;
    present = true;
    return true;
}

