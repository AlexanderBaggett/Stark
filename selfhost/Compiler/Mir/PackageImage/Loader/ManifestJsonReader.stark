import System.Json
import System.Memory
import System.Text
module Compiler.Mir.PackageImage.Loader.ManifestJsonReader

// Shared manifest-JSON shape, scalar, and text-member readers for section loaders.

internal fn bool LogicalPackageImageJsonMemberHasValue(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName)
{
    stack mut u64[0 2 ** 63 - 1] member = 0;
    return document.TryFindMember(objectNode, memberName, member)
        && document.KindAt(member) != JsonKind.Null;
}

internal fn bool LogicalPackageImageJsonArrayNodeCount(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] node,
    out u32[0 max] count)
{
    count = 0;
    if (document.KindAt(node) != JsonKind.Array)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] childCount = document.ChildCountAt(node);
    if (childCount > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return false;
    }

    count = (u32[0 max])childCount;
    return true;
}

internal fn bool LogicalPackageImageJsonRequiredArrayMember(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out u64[0 2 ** 63 - 1] member,
    out u32[0 max] count)
{
    member = 0;
    count = 0;
    stack mut u64[0 2 ** 63 - 1] found = 0;
    if (!document.TryFindMember(objectNode, memberName, found))
    {
        return false;
    }

    if (!LogicalPackageImageJsonArrayNodeCount(document, found, count))
    {
        return false;
    }

    member = found;
    return true;
}

internal fn bool LogicalPackageImageJsonRequiredArrayMemberCount(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out u32[0 max] count)
{
    count = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member))
    {
        return false;
    }

    return LogicalPackageImageJsonArrayNodeCount(document, member, count);
}

