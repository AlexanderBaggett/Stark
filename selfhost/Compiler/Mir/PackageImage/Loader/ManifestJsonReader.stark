    }
}

internal fn bool LogicalPackageImageJsonRequiredTextMemberPresent(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName)
{
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    return System.Text.AsciiLength(document.TextAt(member)) > 0;
}

internal fn bool LogicalPackageImageJsonOptionalTextMemberPresentAllowEmpty(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out bool present)
{
    present = false;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    if (System.Text.AsciiLength(document.TextAt(member)) <= 0)
    {
        return true;
    }

    present = true;
    return true;
}

internal fn bool LogicalPackageImageJsonOptionalTextArrayMemberCount(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out u32[0 max] count)
{
    count = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    stack mut u32[0 max] localCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(document, objectNode, memberName, arrayNode, localCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < localCount)
    {
        stack mut u64[0 2 ** 63 - 1] itemNode = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, itemNode)
            || document.KindAt(itemNode) != JsonKind.Text
            || System.Text.AsciiLength(document.TextAt(itemNode)) <= 0)
        {
            return false;
        }

        index = index + 1;
    }

    count = localCount;
    return true;
}

internal fn bool LogicalPackageImageJsonOptionalComptimeGenericParameterArrayMemberCount(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out u32[0 max] count)
{
    count = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    stack mut u32[0 max] localCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(document, objectNode, memberName, arrayNode, localCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < localCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u64[0 2 ** 63 - 1] nameNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || !document.TryFindMember(parameterNode, "Name", nameNode)
            || document.KindAt(nameNode) != JsonKind.Text
            || System.Text.AsciiLength(document.TextAt(nameNode)) <= 0
            || !LogicalPackageImageJsonRequiredObjectMember(document, parameterNode, "Type", typeNode))
        {
            return false;
        }

        index = index + 1;
    }

    count = localCount;
    return true;
}

internal fn bool LogicalPackageImageJsonModuleNode(
    borrow JsonDocument document,
    u32[0 max] moduleOrdinal,
    out u64[0 2 ** 63 - 1] moduleNode)
{
    moduleNode = 0;
    if (document.Count() == 0 || document.KindAt(0) != JsonKind.Object)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] modulesNode = 0;
    if (!document.TryFindMember(0, "Modules", modulesNode)
        || document.KindAt(modulesNode) != JsonKind.Array)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] moduleCount = document.ChildCountAt(modulesNode);
    if (moduleCount == 0
        || moduleCount > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || (u64[0 2 ** 63 - 1])moduleOrdinal >= moduleCount)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] found = 0;
    if (!document.TryChildAt(modulesNode, (u64[0 2 ** 63 - 1])moduleOrdinal, found)
        || document.KindAt(found) != JsonKind.Object)
    {
        return false;
    }

    moduleNode = found;
    return true;
}
