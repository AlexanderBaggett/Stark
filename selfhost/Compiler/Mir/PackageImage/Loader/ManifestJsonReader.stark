internal fn bool LogicalPackageImageJsonAppendRequiredTextMember(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    mut borrow OwnedAscii sink)
{
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    switch (sink.AppendAscii(value))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            return true;
    }
}

internal fn bool LogicalPackageImageJsonMemberIsPresentText(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    out bool present)
{
    present = false;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    present = true;
    return true;
}

internal fn bool LogicalPackageImageJsonAppendOptionalTextMember(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
