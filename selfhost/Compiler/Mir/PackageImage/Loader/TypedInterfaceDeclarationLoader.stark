import Compiler.Ir
import Compiler.Mir.PackageImage.Loader.ManifestJsonReader
import Compiler.Mir.PackageImage.Models
import Compiler.Mir.PackageImage.Shared.TypeCodec
import System.Json
import System.Memory
import System.Text
import Compiler.Mir.PackageImage.Loader.TypedInterfaceTypeReferenceLoader
module Compiler.Mir.PackageImage.Loader.TypedInterfaceDeclarationLoader

// Typed alias, callable, global, and named-type fact materialization. All ABI,
// layout, thread-safety, and type-reference facts retain their manifest rows.

internal fn bool LogicalPackageImageJsonMaterializeTypeAliasFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageTypedTypeAliasFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    return LogicalPackageTypedTypeAliasFactGraphAddTextRow(graph, textKind, textOrdinal, value, textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeTypeAliasFactTypeReference(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeReferenceNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeAliasOrdinal,
    LogicalPackageTypedTypeReferenceSource source,
    u32[0 max] payloadOrdinal,
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph,
    out u32[0 max] typeReferenceRow)
{
    typeReferenceRow = 0;
    return LogicalPackageImageJsonMaterializeTypeReferenceGraph(
        document,
        typeReferenceNode,
        moduleOrdinal,
        LogicalPackageTypedDeclarationKind.TypeAlias,
        typeAliasOrdinal,
        0,
        0,
        source,
        payloadOrdinal,
        graph.TypeReferences,
        typeReferenceRow);
}

internal fn bool LogicalPackageImageJsonMaterializeTypeAliasGenericParameterRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeAliasNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeAliasOrdinal,
    u32[0 max] typeAliasRow,
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph,
    out u32[0 max] parameterCount)
{
    parameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
        document,
        typeAliasNode,
        "GenericParameters",
        arrayNode,
        parameterCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii name = document.TextAt(parameterNode);
        if (System.Text.AsciiLength(name) <= 0
            || !LogicalPackageTypedTypeAliasFactGraphAddTextRow(
                graph,
                LogicalPackageTypedTypeAliasFactTextKind.GenericParameterName,
                index,
                name,
                nameTextRow)
            || !LogicalPackageTypedTypeAliasFactGraphAddGenericParameterRow(
                graph,
                typeAliasRow,
                moduleOrdinal,
                typeAliasOrdinal,
                index,
                nameTextRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}
internal fn bool LogicalPackageImageJsonMaterializeTypeAliasComptimeGenericParameterRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeAliasNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeAliasOrdinal,
    u32[0 max] typeAliasRow,
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph,
    out u32[0 max] parameterCount)
{
    parameterCount = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
        document,
        typeAliasNode,
        "ComptimeGenericParameters",
        arrayNode,
        parameterCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        stack mut u32[0 max] typeReferenceRow = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypeAliasFactTextMemberRow(
                document,
                parameterNode,
                "Name",
                LogicalPackageTypedTypeAliasFactTextKind.ComptimeGenericParameterName,
                index,
                graph,
                nameTextRow)
            || !LogicalPackageImageJsonRequiredObjectMember(document, parameterNode, "Type", typeNode)
            || !LogicalPackageImageJsonMaterializeTypeAliasFactTypeReference(
                document,
                typeNode,
                moduleOrdinal,
                typeAliasOrdinal,
                LogicalPackageTypedTypeReferenceSource.TypeAliasComptimeGenericParameterType,
                index,
                graph,
                typeReferenceRow)
            || !LogicalPackageTypedTypeAliasFactGraphAddComptimeGenericParameterRow(
                graph,
                typeAliasRow,
                moduleOrdinal,
                typeAliasOrdinal,
                index,
                nameTextRow,
                typeReferenceRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTypeAliasFactRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeAliasNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeAliasOrdinal,
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph)
{
    stack mut u64[0 2 ** 63 - 1] targetTypeNode = 0;
    stack mut u32[0 max] targetTypeReferenceRow = 0;
    stack mut u32[0 max] typeAliasRow = 0;
    stack mut u32[0 max] genericParameterCount = 0;
    stack mut u32[0 max] comptimeGenericParameterCount = 0;
    return LogicalPackageImageJsonRequiredObjectMember(document, typeAliasNode, "TargetType", targetTypeNode)
        && LogicalPackageImageJsonMaterializeTypeAliasFactTypeReference(
            document,
            targetTypeNode,
            moduleOrdinal,
            typeAliasOrdinal,
            LogicalPackageTypedTypeReferenceSource.TypeAliasTarget,
            0,
            graph,
            targetTypeReferenceRow)
        && LogicalPackageTypedTypeAliasFactGraphAddTypeAliasRow(
            graph,
            moduleOrdinal,
            typeAliasOrdinal,
            targetTypeReferenceRow,
            typeAliasRow)
        && LogicalPackageImageJsonMaterializeTypeAliasGenericParameterRows(
            document,
            typeAliasNode,
            moduleOrdinal,
            typeAliasOrdinal,
            typeAliasRow,
            graph,
            genericParameterCount)
        && LogicalPackageImageJsonMaterializeTypeAliasComptimeGenericParameterRows(
            document,
            typeAliasNode,
            moduleOrdinal,
            typeAliasOrdinal,
            typeAliasRow,
            graph,
            comptimeGenericParameterCount);
}


internal fn MemoryStatus LogicalPackageTypedTypeAliasFactGraphAppendText(
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph,
    ascii text,
    out u32[0 max] byteOffset,
    out u32[0 max] byteLength)
{
    byteOffset = 0;
    byteLength = 0;
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength <= 0 || signedLength > (i64[min max])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (graph.TextBytes.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || graph.TextBytes.Length + (u64[0 2 ** 63 - 1])signedLength > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    byteOffset = (u32[0 max])graph.TextBytes.Length;
    byteLength = (u32[0 max])signedLength;
    unsafe
    {
        stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
        if (data == null)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        if (!graph.TextBytes.TryReserve((u64[0 2 ** 63 - 1])signedLength))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            init graph.TextBytes[graph.TextBytes.Length] = *(&data[index]);
        }
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageTypedTypeAliasFactGraphAddTextRow(
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph,
    LogicalPackageTypedTypeAliasFactTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u32[0 max] byteOffset = 0;
    stack mut u32[0 max] byteLength = 0;
    switch (LogicalPackageTypedTypeAliasFactGraphAppendText(graph, text, byteOffset, byteLength))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            stack LogicalPackageTypedTypeAliasFactTextRow row =
                new LogicalPackageTypedTypeAliasFactTextRow()
            {
                TextKindValue = textKind,
                TextOrdinalValue = textOrdinal,
                ByteOffsetValue = byteOffset,
                ByteLengthValue = byteLength
            };
            textRow = graph.TextRows.Add(row);
            return textRow != 0;
    }
}

internal fn bool LogicalPackageTypedTypeAliasFactGraphAddTypeAliasRow(
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeAliasOrdinal,
    u32[0 max] targetTypeReferenceRow,
    out u32[0 max] typeAliasRow)
{
    typeAliasRow = 0;
    if (!graph.TypeReferences.ContainsTypeReference(targetTypeReferenceRow))
    {
        return false;
    }

    stack LogicalPackageTypedTypeAliasRow row = new LogicalPackageTypedTypeAliasRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        TypeAliasOrdinalValue = typeAliasOrdinal,
        TargetTypeReferenceRowValue = targetTypeReferenceRow
    };
    typeAliasRow = graph.TypeAliasRows.Add(row);
    return typeAliasRow != 0;
}

internal fn bool LogicalPackageTypedTypeAliasFactGraphAddGenericParameterRow(
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph,
    u32[0 max] typeAliasRow,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeAliasOrdinal,
    u32[0 max] parameterOrdinal,
    u32[0 max] nameTextRow)
{
    if (!graph.TypeAliasRows.Contains(typeAliasRow)
        || !graph.TextRows.Contains(nameTextRow))
    {
        return false;
    }

    stack LogicalPackageTypedTypeAliasGenericParameterRow row =
        new LogicalPackageTypedTypeAliasGenericParameterRow()
    {
        TypeAliasRowValue = typeAliasRow,
        ModuleOrdinalValue = moduleOrdinal,
        TypeAliasOrdinalValue = typeAliasOrdinal,
        ParameterOrdinalValue = parameterOrdinal,
        NameTextRowValue = nameTextRow
    };
    stack u32[0 max] addedRow = graph.GenericParameterRows.Add(row);
    if (addedRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageTypedTypeAliasRow parent = graph.TypeAliasRows.Get(typeAliasRow);
    if (parent.GenericParameterRowCountValue == 0)
    {
        parent.FirstGenericParameterRowValue = addedRow;
    }
    else if (addedRow != parent.FirstGenericParameterRowValue + parent.GenericParameterRowCountValue)
    {
        return false;
    }

    parent.GenericParameterRowCountValue = parent.GenericParameterRowCountValue + 1;
    return graph.TypeAliasRows.Replace(typeAliasRow, parent);
}

internal fn bool LogicalPackageTypedTypeAliasFactGraphAddComptimeGenericParameterRow(
    mut borrow LogicalPackageTypedTypeAliasFactGraph graph,
    u32[0 max] typeAliasRow,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeAliasOrdinal,
    u32[0 max] parameterOrdinal,
    u32[0 max] nameTextRow,
    u32[0 max] typeReferenceRow)
{
    if (!graph.TypeAliasRows.Contains(typeAliasRow)
        || !graph.TextRows.Contains(nameTextRow)
        || !graph.TypeReferences.ContainsTypeReference(typeReferenceRow))
    {
        return false;
    }

    stack LogicalPackageTypedTypeAliasComptimeGenericParameterRow row =
        new LogicalPackageTypedTypeAliasComptimeGenericParameterRow()
    {
        TypeAliasRowValue = typeAliasRow,
        ModuleOrdinalValue = moduleOrdinal,
        TypeAliasOrdinalValue = typeAliasOrdinal,
        ParameterOrdinalValue = parameterOrdinal,
        NameTextRowValue = nameTextRow,
        TypeReferenceRowValue = typeReferenceRow
    };
    stack u32[0 max] addedRow = graph.ComptimeGenericParameterRows.Add(row);
    if (addedRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageTypedTypeAliasRow parent = graph.TypeAliasRows.Get(typeAliasRow);
    if (parent.ComptimeGenericParameterRowCountValue == 0)
    {
        parent.FirstComptimeGenericParameterRowValue = addedRow;
    }
    else if (addedRow
        != parent.FirstComptimeGenericParameterRowValue + parent.ComptimeGenericParameterRowCountValue)
    {
        return false;
    }

    parent.ComptimeGenericParameterRowCountValue =
        parent.ComptimeGenericParameterRowCountValue + 1;
    return graph.TypeAliasRows.Replace(typeAliasRow, parent);
}


