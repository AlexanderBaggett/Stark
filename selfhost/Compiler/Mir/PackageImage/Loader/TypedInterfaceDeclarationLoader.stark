    }

    stack mut u32[0 max] index = 0;
    while willexit (index < parameterCount)
    {
        stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, parameterNode)
            || document.KindAt(parameterNode) != JsonKind.Text)
