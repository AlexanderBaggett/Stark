internal fn bool LogicalPackageImageJsonMaterializeTypeAssociatedTypeRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeOrdinal,
    mut borrow LogicalPackageTypedTypeFactGraph graph,
    out u32[0 max] associatedTypeCount)
{
    associatedTypeCount = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(document, typeNode, "AssociatedTypes", arrayNode, associatedTypeCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < associatedTypeCount)
    {
        stack mut u64[0 2 ** 63 - 1] associatedTypeNode = 0;
        stack mut u64[0 2 ** 63 - 1] targetTypeNode = 0;
        stack mut bool hasTargetType = false;
        stack mut u32[0 max] nameTextRow = 0;
        stack mut u32[0 max] targetTypeReferenceRow = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, associatedTypeNode)
            || document.KindAt(associatedTypeNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypeFactTextMemberRow(
                document,
                associatedTypeNode,
                "Name",
                LogicalPackageTypedTypeFactTextKind.AssociatedTypeName,
                index,
                graph,
                nameTextRow)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                associatedTypeNode,
                "TargetType",
                targetTypeNode,
                hasTargetType))
        {
            return false;
        }

        if (hasTargetType
            && !LogicalPackageImageJsonMaterializeTypeReferenceGraph(
                document,
                targetTypeNode,
                moduleOrdinal,
                LogicalPackageTypedDeclarationKind.Type,
                typeOrdinal,
                0,
                0,
                LogicalPackageTypedTypeReferenceSource.TypeAssociatedTypeTarget,
                index,
                graph.TypeReferences,
                targetTypeReferenceRow))
        {
            return false;
        }

        if (!LogicalPackageTypedTypeFactGraphAddAssociatedTypeRow(
            graph,
            moduleOrdinal,
            typeOrdinal,
            index,
            nameTextRow,
            hasTargetType,
            targetTypeReferenceRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

