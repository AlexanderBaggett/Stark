internal fn bool LogicalPackageTypedCallableFactGraphAddParameterGroupNameRow(
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    u32[0 max] parameterGroupRow,
    u32[0 max] parameterOrdinal,
    u32[0 max] nameTextRow,
    out u32[0 max] nameRow)
{
    nameRow = 0;
    if (!graph.ParameterGroupRows.Contains(parameterGroupRow)
        || !graph.TextRows.Contains(nameTextRow))
    {
        return false;
    }

    stack LogicalPackageTypedCallableParameterGroupNameRow row =
        new LogicalPackageTypedCallableParameterGroupNameRow()
    {
        ParameterGroupRowValue = parameterGroupRow,
        ParameterOrdinalValue = parameterOrdinal,
        NameTextRowValue = nameTextRow
    };
    stack u32[0 max] addedNameRow = graph.ParameterGroupNameRows.Add(row);
    if (addedNameRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageTypedCallableParameterGroupRow group =
        graph.ParameterGroupRows.Get(parameterGroupRow);
    if (group.NameRowCountValue == 0)
    {
        group.FirstNameRowValue = addedNameRow;
    }
    else if (addedNameRow != group.FirstNameRowValue + group.NameRowCountValue)
    {
        return false;
    }

    group.NameRowCountValue = group.NameRowCountValue + 1;
    if (!graph.ParameterGroupRows.Replace(parameterGroupRow, group))
    {
        return false;
    }

    nameRow = addedNameRow;
    return true;
}

internal fn bool LogicalPackageTypedCallableFactGraphAddParameterGroupRegionRow(
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    u32[0 max] parameterGroupRow,
    u32[0 max] regionOrdinal,
    u32[0 max] parameterNameTextRow,
    bool hasStartExpression,
    u32[0 max] startExpressionTextRow,
    bool hasCountExpression,
    u32[0 max] countExpressionTextRow,
    out u32[0 max] regionRow)
{
    regionRow = 0;
    if (!graph.ParameterGroupRows.Contains(parameterGroupRow)
        || !graph.TextRows.Contains(parameterNameTextRow)
        || (hasStartExpression && !graph.TextRows.Contains(startExpressionTextRow))
        || (hasCountExpression && !graph.TextRows.Contains(countExpressionTextRow)))
    {
        return false;
    }

    stack LogicalPackageTypedCallableParameterGroupRegionRow row =
        new LogicalPackageTypedCallableParameterGroupRegionRow()
    {
        ParameterGroupRowValue = parameterGroupRow,
        RegionOrdinalValue = regionOrdinal,
        ParameterNameTextRowValue = parameterNameTextRow,
        HasStartExpressionValue = hasStartExpression,
        StartExpressionTextRowValue = startExpressionTextRow,
        HasCountExpressionValue = hasCountExpression,
        CountExpressionTextRowValue = countExpressionTextRow
    };
    stack u32[0 max] addedRegionRow = graph.ParameterGroupRegionRows.Add(row);
    if (addedRegionRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageTypedCallableParameterGroupRow group =
        graph.ParameterGroupRows.Get(parameterGroupRow);
    if (group.RegionRowCountValue == 0)
    {
        group.FirstRegionRowValue = addedRegionRow;
    }
    else if (addedRegionRow != group.FirstRegionRowValue + group.RegionRowCountValue)
    {
        return false;
    }

    group.RegionRowCountValue = group.RegionRowCountValue + 1;
    if (!graph.ParameterGroupRows.Replace(parameterGroupRow, group))
    {
        return false;
    }

    regionRow = addedRegionRow;
    return true;
}

internal fn bool LogicalPackageTypedCallableFactGraphAddImportRow(
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    bool hasFfiAbi,
    u32[0 max] ffiAbiTextRow,
    bool hasLinkName,
    u32[0 max] linkNameTextRow)
{
    if ((!hasFfiAbi && !hasLinkName)
        || (hasFfiAbi && !graph.TextRows.Contains(ffiAbiTextRow))
        || (hasLinkName && !graph.TextRows.Contains(linkNameTextRow)))
    {
        return false;
    }

    stack LogicalPackageTypedCallableImportRow row = new LogicalPackageTypedCallableImportRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        CallableKindValue = callableKind,
        DeclarationOrdinalValue = declarationOrdinal,
        MethodOrdinalValue = methodOrdinal,
        FfiAbiTextRowValue = ffiAbiTextRow,
        LinkNameTextRowValue = linkNameTextRow,
        HasFfiAbiValue = hasFfiAbi,
        HasLinkNameValue = hasLinkName
    };
    return graph.ImportRows.Add(row) != 0;
}

