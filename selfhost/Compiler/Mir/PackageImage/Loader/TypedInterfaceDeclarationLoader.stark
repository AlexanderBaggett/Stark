            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            comptimeGenericParameterCount)
        && LogicalPackageImageJsonMaterializeCallableTypeParameterConstraintRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            typeParameterConstraintCount)
        && LogicalPackageImageJsonMaterializeCallableThreadSafetyLawPredicateRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            threadSafetyLawPredicateCount)
        && LogicalPackageImageJsonMaterializeCallableValueContractRows(
            document,
            callableNode,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
            methodOrdinal,
            graph,
            valueContractCount)
        && LogicalPackageImageJsonMaterializeCallableParameterGroupRows(
            document,
            callableNode,
            "DisjointParameterGroups",
            LogicalPackageTypeReferenceParameterGroupKind.Disjoint,
            moduleOrdinal,
            callableKind,
            declarationOrdinal,
