internal fn bool LogicalPackageImageJsonMaterializeCallableFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageTypedCallableFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    return LogicalPackageTypedCallableFactGraphAddTextRow(graph, textKind, textOrdinal, value, textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeOptionalCallableFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageTypedCallableFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    out bool present,
    out u32[0 max] textRow)
{
    present = false;
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    if (!LogicalPackageTypedCallableFactGraphAddTextRow(graph, textKind, textOrdinal, value, textRow))
    {
        return false;
    }

    present = true;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeCallableFactTypeReference(
