internal fn bool LogicalPackageTypedCallableFactGraphAddParameterGroupRow(
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    LogicalPackageTypeReferenceParameterGroupKind groupKind,
    u32[0 max] groupOrdinal,
    out u32[0 max] parameterGroupRow)
{
    parameterGroupRow = 0;
    stack LogicalPackageTypedCallableParameterGroupRow row =
        new LogicalPackageTypedCallableParameterGroupRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        CallableKindValue = callableKind,
        DeclarationOrdinalValue = declarationOrdinal,
        MethodOrdinalValue = methodOrdinal,
        GroupKindValue = groupKind,
        GroupOrdinalValue = groupOrdinal
    };
    parameterGroupRow = graph.ParameterGroupRows.Add(row);
