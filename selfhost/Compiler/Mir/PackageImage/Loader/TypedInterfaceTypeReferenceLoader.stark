    };
    row.FirstTextRowValue = firstTextRow;
    row.TextRowCountValue = (u32[0 max])textRowsWritten;
    return graph.TypeReferenceRows.Replace(typeReferenceRow, row);
}

internal fn bool LogicalPackageImageJsonMaterializeTypeReferenceGraph(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] rootTypeReferenceNode,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedDeclarationKind declarationKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    u32[0 max] variantOrdinal,
    LogicalPackageTypedTypeReferenceSource source,
    u32[0 max] payloadOrdinal,
    mut borrow LogicalPackageTypeReferenceGraph graph,
    out u32[0 max] rootTypeReferenceRow)
{
    rootTypeReferenceRow = 0;
    stack mut IrTable<LogicalPackageTypeReferenceWorkItem> work = new();
    if (!LogicalPackageTypeReferenceWorkListAdd(
        work,
        rootTypeReferenceNode,
        0,
        LogicalPackageTypeReferenceChildKind.Root,
        0))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] workCursor = 1;
    while willexit (workCursor <= work.Count())
    {
        if (workCursor > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
        {
            return false;
        }

        stack LogicalPackageTypeReferenceWorkItem item = work.Get((u32[0 max])workCursor);
        stack LogicalPackageTypeReferenceRow placeholder = new LogicalPackageTypeReferenceRow()
        {
            ParentTypeReferenceRowValue = item.ParentTypeReferenceRowValue,
            ParentChildKindValue = item.ParentChildKindValue,
            ParentChildOrdinalValue = item.ParentChildOrdinalValue
        };
        stack u32[0 max] typeReferenceRow = graph.TypeReferenceRows.Add(placeholder);
        if (typeReferenceRow == 0)
        {
            return false;
        }

        if (rootTypeReferenceRow == 0)
        {
            rootTypeReferenceRow = typeReferenceRow;
        }

        if (item.ParentTypeReferenceRowValue != 0
            && !LogicalPackageTypeReferenceGraphAddChildRow(
                graph,
                item.ParentTypeReferenceRowValue,
                typeReferenceRow,
                item.ParentChildKindValue,
                item.ParentChildOrdinalValue))
        {
            return false;
        }

        if (!LogicalPackageImageJsonMaterializeTypeReferenceRow(
            document,
            item.NodeValue,
            typeReferenceRow,
            moduleOrdinal,
            declarationKind,
            declarationOrdinal,
            methodOrdinal,
            variantOrdinal,
            source,
            payloadOrdinal,
            graph,
            work))
        {
            return false;
        }

        workCursor = workCursor + 1;
    }

    return rootTypeReferenceRow != 0;
}
