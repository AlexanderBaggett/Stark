        }

        variantIndex = variantIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeEnumLayoutRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] compilerFactsNode,
    u32[0 max] moduleOrdinal,
