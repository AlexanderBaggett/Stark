            || !LogicalPackageImageJsonMaterializeLayoutFactTextMemberRow(
                document,
                layoutNode,
                "Kind",
                LogicalPackageLayoutFactTextKind.EnumLayoutKind,
                layoutIndex,
                graph,
                kindTextRow)
            || !document.TryFindMember(layoutNode, "Kind", kindNode)
            || document.KindAt(kindNode) != JsonKind.Text
            || !LogicalPackageImageJsonParseEnumLayoutKind(document.TextAt(kindNode), kind)
            || !LogicalPackageImageJsonRequiredObjectMember(document, layoutNode, "TagField", tagFieldNode)
            || !LogicalPackageImageJsonMaterializeLayoutFactTextMemberRow(
                document,
                tagFieldNode,
                "Name",
                LogicalPackageLayoutFactTextKind.EnumTagFieldName,
                layoutIndex,
                graph,
                tagFieldNameTextRow)
            || !document.TryFindMember(tagFieldNode, "Type", tagFieldTypeNode)
            || document.KindAt(tagFieldTypeNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypeReferenceGraph(
                document,
                tagFieldTypeNode,
                moduleOrdinal,
                LogicalPackageTypedDeclarationKind.Type,
                layoutIndex,
                0,
                0,
                LogicalPackageTypedTypeReferenceSource.LayoutEnumTagFieldType,
                0,
                graph.TypeReferences,
                tagFieldTypeReferenceRow)
            || !LogicalPackageLayoutFactGraphAddEnumLayoutRow(
                graph,
                moduleOrdinal,
                layoutIndex,
                qualifiedTypeNameTextRow,
                kind,
                kindTextRow,
                tagFieldNameTextRow,
                tagFieldTypeReferenceRow,
