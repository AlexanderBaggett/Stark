import Compiler.Mir.PackageImage.Loader.ManifestJsonReader
import Compiler.Mir.PackageImage.Loader.TypedInterfaceSectionLoader
import Compiler.Mir.PackageImage.Models
import System.Json
import System.Memory
import System.Text
import Compiler.Mir.PackageImage.Loader.CompilerEffectAbiFactsLoader
module Compiler.Mir.PackageImage.Loader.CompilerLayoutNativeFactsLoader

// Concrete layout, enum layout, native dependency, and linkage fact
// materialization with stable manifest and text-row identities.

internal fn MemoryStatus LogicalPackageLayoutFactGraphAppendText(
    mut borrow LogicalPackageLayoutFactGraph graph,
    ascii text,
    out u32[0 max] byteOffset,
    out u32[0 max] byteLength)
{
    byteOffset = 0;
    byteLength = 0;
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength <= 0 || signedLength > (i64[min max])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (graph.TextBytes.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || graph.TextBytes.Length + (u64[0 2 ** 63 - 1])signedLength > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    byteOffset = (u32[0 max])graph.TextBytes.Length;
    byteLength = (u32[0 max])signedLength;
    unsafe
    {
        stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
        if (data == null)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        if (!graph.TextBytes.TryReserve((u64[0 2 ** 63 - 1])signedLength))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            init graph.TextBytes[graph.TextBytes.Length] = *(&data[index]);
        }
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageLayoutFactGraphAddTextRow(
    mut borrow LogicalPackageLayoutFactGraph graph,
    LogicalPackageLayoutFactTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u32[0 max] byteOffset = 0;
    stack mut u32[0 max] byteLength = 0;
    switch (LogicalPackageLayoutFactGraphAppendText(graph, text, byteOffset, byteLength))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            stack LogicalPackageLayoutFactTextRow row = new LogicalPackageLayoutFactTextRow()
            {
                TextKindValue = textKind,
                TextOrdinalValue = textOrdinal,
                ByteOffsetValue = byteOffset,
                ByteLengthValue = byteLength
            };
            textRow = graph.TextRows.Add(row);
            return textRow != 0;
    }
}
internal fn bool LogicalPackageLayoutFactGraphAddConcreteLayoutRow(
    mut borrow LogicalPackageLayoutFactGraph graph,
    u32[0 max] moduleOrdinal,
    u32[0 max] layoutOrdinal,
    u32[0 max] qualifiedTypeNameTextRow,
    u32[0 max] sizeBytes,
    u32[0 max] alignmentBytes,
    out u32[0 max] layoutRow)
{
    layoutRow = 0;
    if (!graph.TextRows.Contains(qualifiedTypeNameTextRow)
        || alignmentBytes == 0)
    {
        return false;
    }

    stack LogicalPackageConcreteTypeLayoutRow row = new LogicalPackageConcreteTypeLayoutRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        LayoutOrdinalValue = layoutOrdinal,
        QualifiedTypeNameTextRowValue = qualifiedTypeNameTextRow,
        SizeBytesValue = sizeBytes,
        AlignmentBytesValue = alignmentBytes
    };
    layoutRow = graph.ConcreteLayoutRows.Add(row);
    return layoutRow != 0;
}

internal fn bool LogicalPackageLayoutFactGraphAddConcreteFieldRow(
    mut borrow LogicalPackageLayoutFactGraph graph,
    u32[0 max] concreteLayoutRow,
    u32[0 max] fieldOrdinal,
    u32[0 max] nameTextRow,
    u32[0 max] offsetBytes,
    u32[0 max] sizeBytes,
    u32[0 max] naturalAlignmentBytes,
    u32[0 max] effectiveAlignmentBytes,
    bool isMisaligned,
    out u32[0 max] fieldRow)
{
    fieldRow = 0;
    if (!graph.ConcreteLayoutRows.Contains(concreteLayoutRow)
        || !graph.TextRows.Contains(nameTextRow)
        || naturalAlignmentBytes == 0
        || effectiveAlignmentBytes == 0)
    {
        return false;
    }

    stack LogicalPackageConcreteFieldLayoutRow row = new LogicalPackageConcreteFieldLayoutRow()
    {
        ConcreteLayoutRowValue = concreteLayoutRow,
        FieldOrdinalValue = fieldOrdinal,
        NameTextRowValue = nameTextRow,
        OffsetBytesValue = offsetBytes,
        SizeBytesValue = sizeBytes,
        NaturalAlignmentBytesValue = naturalAlignmentBytes,
        EffectiveAlignmentBytesValue = effectiveAlignmentBytes,
        IsMisalignedValue = isMisaligned
    };
    stack u32[0 max] addedFieldRow = graph.ConcreteFieldRows.Add(row);
    if (addedFieldRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageConcreteTypeLayoutRow layout =
        graph.ConcreteLayoutRows.Get(concreteLayoutRow);
    if (layout.FieldRowCountValue == 0)
    {
        layout.FirstFieldRowValue = addedFieldRow;
    }
    else if (addedFieldRow != layout.FirstFieldRowValue + layout.FieldRowCountValue)
    {
        return false;
    }

    layout.FieldRowCountValue = layout.FieldRowCountValue + 1;
    if (!graph.ConcreteLayoutRows.Replace(concreteLayoutRow, layout))
    {
        return false;
    }

    fieldRow = addedFieldRow;
    return true;
}

internal fn bool LogicalPackageLayoutFactGraphAddEnumLayoutRow(
    mut borrow LogicalPackageLayoutFactGraph graph,
    u32[0 max] moduleOrdinal,
    u32[0 max] layoutOrdinal,
    u32[0 max] qualifiedTypeNameTextRow,
    LogicalPackageEnumLayoutKind kind,
    u32[0 max] kindTextRow,
    u32[0 max] tagFieldNameTextRow,
    u32[0 max] tagFieldTypeReferenceRow,
    out u32[0 max] layoutRow)
{
    layoutRow = 0;
    if (!graph.TextRows.Contains(qualifiedTypeNameTextRow)
        || !graph.TextRows.Contains(kindTextRow)
        || !graph.TextRows.Contains(tagFieldNameTextRow)
        || !graph.TypeReferences.ContainsTypeReference(tagFieldTypeReferenceRow))
    {
        return false;
    }

    stack LogicalPackageEnumLayoutRow row = new LogicalPackageEnumLayoutRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        LayoutOrdinalValue = layoutOrdinal,
        QualifiedTypeNameTextRowValue = qualifiedTypeNameTextRow,
        KindValue = kind,
        KindTextRowValue = kindTextRow,
        TagFieldNameTextRowValue = tagFieldNameTextRow,
        TagFieldTypeReferenceRowValue = tagFieldTypeReferenceRow
    };
    layoutRow = graph.EnumLayoutRows.Add(row);
    return layoutRow != 0;
}

