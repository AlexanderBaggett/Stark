internal fn bool LogicalPackageLayoutFactGraphAddEnumVariantFieldRow(
    mut borrow LogicalPackageLayoutFactGraph graph,
    u32[0 max] enumVariantRow,
    u32[0 max] fieldOrdinal,
    u32[0 max] sourcePosition,
    bool hasSourceFieldName,
    u32[0 max] sourceFieldNameTextRow,
    u32[0 max] storageFieldNameTextRow,
    u32[0 max] storageFieldIndex,
    u32[0 max] typeReferenceRow,
    out u32[0 max] fieldRow)
{
    fieldRow = 0;
    if (!graph.EnumVariantRows.Contains(enumVariantRow)
        || (hasSourceFieldName && !graph.TextRows.Contains(sourceFieldNameTextRow))
        || (!hasSourceFieldName && sourceFieldNameTextRow != 0)
        || !graph.TextRows.Contains(storageFieldNameTextRow)
        || !graph.TypeReferences.ContainsTypeReference(typeReferenceRow))
    {
        return false;
    }

    stack LogicalPackageEnumVariantFieldLayoutRow row =
        new LogicalPackageEnumVariantFieldLayoutRow()
    {
        EnumVariantRowValue = enumVariantRow,
        FieldOrdinalValue = fieldOrdinal,
        SourcePositionValue = sourcePosition,
        SourceFieldNameTextRowValue = sourceFieldNameTextRow,
        StorageFieldNameTextRowValue = storageFieldNameTextRow,
        StorageFieldIndexValue = storageFieldIndex,
        TypeReferenceRowValue = typeReferenceRow,
        HasSourceFieldNameValue = hasSourceFieldName
    };
    stack u32[0 max] addedFieldRow = graph.EnumVariantFieldRows.Add(row);
    if (addedFieldRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageEnumVariantLayoutRow variant =
        graph.EnumVariantRows.Get(enumVariantRow);
    if (variant.FieldRowCountValue == 0)
    {
        variant.FirstFieldRowValue = addedFieldRow;
    }
    else if (addedFieldRow != variant.FirstFieldRowValue + variant.FieldRowCountValue)
    {
        return false;
    }

    variant.FieldRowCountValue = variant.FieldRowCountValue + 1;
    if (!graph.EnumVariantRows.Replace(enumVariantRow, variant))
    {
        return false;
    }

    fieldRow = addedFieldRow;
    return true;
}

public fn MemoryStatus AppendLogicalPackageLayoutFactText(
    borrow LogicalPackageLayoutFactGraph graph,
    LogicalPackageLayoutFactTextRow textRow,
    mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] start = (u64[0 2 ** 63 - 1])textRow.ByteOffsetValue;
    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])textRow.ByteLengthValue;
    if (start + length > graph.TextBytes.Length)
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < length)
    {
        try sink.AppendByte(graph.TextBytes[start + index]);
        index = index + 1;
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageImageJsonMaterializeLayoutFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageLayoutFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageLayoutFactGraph graph,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    return LogicalPackageLayoutFactGraphAddTextRow(graph, textKind, textOrdinal, value, textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeOptionalLayoutFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageLayoutFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageLayoutFactGraph graph,
    out bool present,
    out u32[0 max] textRow)
{
    present = false;
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    if (!LogicalPackageLayoutFactGraphAddTextRow(graph, textKind, textOrdinal, value, textRow))
    {
        return false;
    }

    present = true;
    return true;
}

internal fn bool LogicalPackageImageJsonParseEnumLayoutKind(
    ascii kindText,
    out LogicalPackageEnumLayoutKind kind)
    where overlap(kindText, kind)
{
    if (kindText == "directtag")
    {
        kind = LogicalPackageEnumLayoutKind.DirectTag;
        return true;
    }

    kind = LogicalPackageEnumLayoutKind.DirectTag;
    return false;
}

internal fn bool LogicalPackageImageJsonMaterializeConcreteLayoutFieldRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] layoutNode,
    u32[0 max] concreteLayoutRow,
    mut borrow LogicalPackageLayoutFactGraph graph)
{
    stack mut u64[0 2 ** 63 - 1] fieldsNode = 0;
    stack mut u32[0 max] fieldCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
        document,
        layoutNode,
        "Fields",
        fieldsNode,
        fieldCount))
    {
        return false;
    }

    stack mut u32[0 max] fieldIndex = 0;
    while willexit (fieldIndex < fieldCount)
    {
        stack mut u64[0 2 ** 63 - 1] fieldNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        stack mut u32[0 max] offsetBytes = 0;
        stack mut u32[0 max] sizeBytes = 0;
        stack mut u32[0 max] naturalAlignmentBytes = 0;
        stack mut u32[0 max] effectiveAlignmentBytes = 0;
        stack mut bool isMisaligned = false;
        stack mut u32[0 max] fieldRow = 0;
        if (!document.TryChildAt(fieldsNode, (u64[0 2 ** 63 - 1])fieldIndex, fieldNode)
            || document.KindAt(fieldNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeLayoutFactTextMemberRow(
                document,
                fieldNode,
                "Name",
                LogicalPackageLayoutFactTextKind.ConcreteFieldName,
                fieldIndex,
                graph,
                nameTextRow)
            || !LogicalPackageImageJsonRequiredU32MemberValue(document, fieldNode, "OffsetBytes", offsetBytes)
            || !LogicalPackageImageJsonRequiredU32MemberValue(document, fieldNode, "SizeBytes", sizeBytes)
            || !LogicalPackageImageJsonRequiredU32MemberValue(
                document,
                fieldNode,
                "NaturalAlignmentBytes",
                naturalAlignmentBytes)
            || !LogicalPackageImageJsonRequiredU32MemberValue(
                document,
                fieldNode,
                "EffectiveAlignmentBytes",
                effectiveAlignmentBytes)
            || !LogicalPackageImageJsonRequiredBoolMemberValue(
                document,
                fieldNode,
                "IsMisaligned",
                isMisaligned)
            || !LogicalPackageLayoutFactGraphAddConcreteFieldRow(
                graph,
                concreteLayoutRow,
                fieldIndex,
                nameTextRow,
                offsetBytes,
                sizeBytes,
                naturalAlignmentBytes,
                effectiveAlignmentBytes,
                isMisaligned,
                fieldRow))
        {
            return false;
        }

        fieldIndex = fieldIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeConcreteLayoutRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] compilerFactsNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageLayoutFactGraph graph,
    out u32[0 max] concreteLayoutCount)
{
    concreteLayoutCount = 0;
    stack mut u64[0 2 ** 63 - 1] layoutsNode = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
        document,
        compilerFactsNode,
        "ConcreteLayouts",
        layoutsNode,
        concreteLayoutCount))
    {
        return false;
    }

    stack mut u32[0 max] layoutIndex = 0;
    while willexit (layoutIndex < concreteLayoutCount)
    {
        stack mut u64[0 2 ** 63 - 1] layoutNode = 0;
        stack mut u32[0 max] qualifiedTypeNameTextRow = 0;
        stack mut u32[0 max] sizeBytes = 0;
        stack mut u32[0 max] alignmentBytes = 0;
        stack mut u32[0 max] layoutRow = 0;
        if (!document.TryChildAt(layoutsNode, (u64[0 2 ** 63 - 1])layoutIndex, layoutNode)
            || document.KindAt(layoutNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeLayoutFactTextMemberRow(
                document,
                layoutNode,
                "QualifiedTypeName",
                LogicalPackageLayoutFactTextKind.QualifiedTypeName,
                layoutIndex,
                graph,
                qualifiedTypeNameTextRow)
            || !LogicalPackageImageJsonRequiredU32MemberValue(document, layoutNode, "SizeBytes", sizeBytes)
            || !LogicalPackageImageJsonRequiredU32MemberValue(
                document,
                layoutNode,
                "AlignmentBytes",
                alignmentBytes)
            || !LogicalPackageLayoutFactGraphAddConcreteLayoutRow(
                graph,
                moduleOrdinal,
                layoutIndex,
                qualifiedTypeNameTextRow,
                sizeBytes,
                alignmentBytes,
                layoutRow)
            || !LogicalPackageImageJsonMaterializeConcreteLayoutFieldRows(
                document,
                layoutNode,
                layoutRow,
                graph))
        {
            return false;
        }

        layoutIndex = layoutIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeEnumLayoutOrderedFieldRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] enumLayoutNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] layoutOrdinal,
    u32[0 max] enumLayoutRow,
    mut borrow LogicalPackageLayoutFactGraph graph)
{
    stack mut u64[0 2 ** 63 - 1] fieldsNode = 0;
    stack mut u32[0 max] fieldCount = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(
        document,
        enumLayoutNode,
        "OrderedFields",
        fieldsNode,
        fieldCount))
    {
        return false;
    }

    stack mut u32[0 max] fieldIndex = 0;
    while willexit (fieldIndex < fieldCount)
    {
        stack mut u64[0 2 ** 63 - 1] fieldNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        stack mut u32[0 max] typeReferenceRow = 0;
        stack mut u32[0 max] fieldRow = 0;
        if (!document.TryChildAt(fieldsNode, (u64[0 2 ** 63 - 1])fieldIndex, fieldNode)
            || document.KindAt(fieldNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeLayoutFactTextMemberRow(
                document,
                fieldNode,
                "Name",
                LogicalPackageLayoutFactTextKind.EnumOrderedFieldName,
                fieldIndex,
                graph,
                nameTextRow)
            || !document.TryFindMember(fieldNode, "Type", typeNode)
            || document.KindAt(typeNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypeReferenceGraph(
                document,
                typeNode,
                moduleOrdinal,
                LogicalPackageTypedDeclarationKind.Type,
                layoutOrdinal,
                0,
                0,
                LogicalPackageTypedTypeReferenceSource.LayoutEnumOrderedFieldType,
                fieldIndex,
                graph.TypeReferences,
                typeReferenceRow)
            || !LogicalPackageLayoutFactGraphAddEnumOrderedFieldRow(
                graph,
                enumLayoutRow,
                fieldIndex,
                nameTextRow,
                typeReferenceRow,
                fieldRow))
        {
            return false;
        }

        fieldIndex = fieldIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeEnumLayoutVariantFieldRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] variantNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] layoutOrdinal,
    u32[0 max] variantOrdinal,
    u32[0 max] variantRow,
    mut borrow LogicalPackageLayoutFactGraph graph)
{
    stack mut u64[0 2 ** 63 - 1] fieldsNode = 0;
    stack mut u32[0 max] fieldCount = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(document, variantNode, "Fields", fieldsNode, fieldCount))
    {
        return false;
    }

    stack mut u32[0 max] fieldIndex = 0;
    while willexit (fieldIndex < fieldCount)
    {
        stack mut u64[0 2 ** 63 - 1] fieldNode = 0;
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u32[0 max] sourcePosition = 0;
        stack mut u32[0 max] sourceFieldNameTextRow = 0;
        stack mut u32[0 max] storageFieldNameTextRow = 0;
        stack mut u32[0 max] storageFieldIndex = 0;
        stack mut u32[0 max] typeReferenceRow = 0;
        stack mut u32[0 max] fieldRow = 0;
        stack mut bool hasSourceFieldName = false;
        if (!document.TryChildAt(fieldsNode, (u64[0 2 ** 63 - 1])fieldIndex, fieldNode)
            || document.KindAt(fieldNode) != JsonKind.Object
            || !LogicalPackageImageJsonRequiredU32MemberValue(
                document,
                fieldNode,
                "SourcePosition",
                sourcePosition)
            || !LogicalPackageImageJsonMaterializeOptionalLayoutFactTextMemberRow(
                document,
                fieldNode,
                "SourceFieldName",
                LogicalPackageLayoutFactTextKind.EnumVariantSourceFieldName,
                fieldIndex,
                graph,
                hasSourceFieldName,
                sourceFieldNameTextRow)
            || !LogicalPackageImageJsonMaterializeLayoutFactTextMemberRow(
                document,
                fieldNode,
                "StorageFieldName",
                LogicalPackageLayoutFactTextKind.EnumVariantStorageFieldName,
                fieldIndex,
                graph,
                storageFieldNameTextRow)
            || !LogicalPackageImageJsonRequiredU32MemberValue(
                document,
                fieldNode,
                "StorageFieldIndex",
                storageFieldIndex)
            || !document.TryFindMember(fieldNode, "Type", typeNode)
            || document.KindAt(typeNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypeReferenceGraph(
                document,
                typeNode,
                moduleOrdinal,
                LogicalPackageTypedDeclarationKind.Type,
                layoutOrdinal,
                0,
                variantOrdinal,
                LogicalPackageTypedTypeReferenceSource.LayoutEnumVariantFieldType,
                fieldIndex,
                graph.TypeReferences,
                typeReferenceRow)
            || !LogicalPackageLayoutFactGraphAddEnumVariantFieldRow(
                graph,
                variantRow,
                fieldIndex,
                sourcePosition,
                hasSourceFieldName,
                sourceFieldNameTextRow,
                storageFieldNameTextRow,
                storageFieldIndex,
                typeReferenceRow,
                fieldRow))
        {
            return false;
        }

        fieldIndex = fieldIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeEnumLayoutVariantRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] enumLayoutNode,
    u32[0 max] moduleOrdinal,
    u32[0 max] layoutOrdinal,
    u32[0 max] enumLayoutRow,
    mut borrow LogicalPackageLayoutFactGraph graph)
{
    stack mut u64[0 2 ** 63 - 1] variantsNode = 0;
    stack mut u32[0 max] variantCount = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(
        document,
        enumLayoutNode,
        "Variants",
        variantsNode,
        variantCount))
    {
        return false;
    }

    stack mut u32[0 max] variantIndex = 0;
    while willexit (variantIndex < variantCount)
    {
        stack mut u64[0 2 ** 63 - 1] variantNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        stack mut u32[0 max] tagValue = 0;
        stack mut bool usesNamedFields = false;
        stack mut u32[0 max] variantRow = 0;
        if (!document.TryChildAt(variantsNode, (u64[0 2 ** 63 - 1])variantIndex, variantNode)
            || document.KindAt(variantNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeLayoutFactTextMemberRow(
                document,
                variantNode,
                "Name",
                LogicalPackageLayoutFactTextKind.EnumVariantName,
                variantIndex,
                graph,
                nameTextRow)
            || !LogicalPackageImageJsonRequiredU32MemberValue(
                document,
                variantNode,
                "TagValue",
                tagValue)
            || !LogicalPackageImageJsonRequiredBoolMemberValue(
                document,
                variantNode,
                "UsesNamedFields",
                usesNamedFields)
            || !LogicalPackageLayoutFactGraphAddEnumVariantRow(
                graph,
                enumLayoutRow,
                variantIndex,
