internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateSwitchCaseRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] switchCasesNode,
    u32[0 max] switchCaseCount,
    u32[0 max] statementRow,
    u32[0 max] functionTemplateRow,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    mut borrow IrTable<LogicalPackageTypedTemplateStatementWorkItem> work)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < switchCaseCount)
    {
        stack mut u64[0 2 ** 63 - 1] switchCaseNode = 0;
        stack mut u32[0 max] kindTextRow = 0;
        stack mut u32[0 max] nameTextRow = 0;
        stack mut bool hasName = false;
        stack mut bool hasOrdinal = false;
        stack mut u32[0 max] ordinal = 0;
        stack mut u64[0 2 ** 63 - 1] expressionNode = 0;
        stack mut u64[0 2 ** 63 - 1] guardExpressionNode = 0;
        stack mut u64[0 2 ** 63 - 1] endExpressionNode = 0;
        stack mut bool hasExpression = false;
        stack mut bool hasGuardExpression = false;
        stack mut bool hasEndExpression = false;
        stack mut u32[0 max] expressionRow = 0;
        stack mut u32[0 max] guardExpressionRow = 0;
        stack mut u32[0 max] endExpressionRow = 0;
        stack mut u64[0 2 ** 63 - 1] membersNode = 0;
        stack mut u64[0 2 ** 63 - 1] statementsNode = 0;
        stack mut u32[0 max] memberPatternCount = 0;
        stack mut u32[0 max] statementCount = 0;
        stack mut u32[0 max] switchCaseRow = 0;
        if (!document.TryChildAt(switchCasesNode, (u64[0 2 ** 63 - 1])index, switchCaseNode)
            || document.KindAt(switchCaseNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeGenericTemplateFactTextMemberRow(
                document,
                switchCaseNode,
                "Kind",
                LogicalPackageGenericTemplateFactTextKind.SwitchCaseKind,
                index,
                graph,
                kindTextRow)
            || !LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRow(
                document,
                switchCaseNode,
                "Name",
                LogicalPackageGenericTemplateFactTextKind.SwitchCaseName,
                index,
                graph,
                hasName,
