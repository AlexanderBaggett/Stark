    u64[0 2 ** 63 - 1] operationNode,
    ascii kindText,
    u32[0 max] functionTemplateRow,
    u32[0 max] boundOperationRow,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    if (kindText == "direct-call")
    {
        return true;
    }

    if (kindText == "member-call")
    {
        return LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTypePayload(
                document,
