import Compiler.Ir
import Compiler.Mir.PackageImage.Loader.ManifestJsonReader
import Compiler.Mir.PackageImage.Loader.TypedInterfaceSectionLoader
export import Compiler.Mir.PackageImage.Loader.GenericTemplateFactGraphBuilder
import Compiler.Mir.PackageImage.Loader.GenericTemplateValueLoader
import Compiler.Mir.PackageImage.Models
import System.Json
import System.Text
module Compiler.Mir.PackageImage.Loader.GenericTemplateSectionLoader

// Typed expression, pattern, statement, body, and function-template tree
// materialization plus the public generic-template graph entry point.

internal fn bool LogicalPackageImageJsonEnqueueTypedTemplateExpressionWorkItem(
    mut borrow IrTable<LogicalPackageTypedTemplateExpressionWorkItem> work,
    u64[0 2 ** 63 - 1] node,
    u32[0 max] parentRow,
    LogicalPackageTypedTemplateExpressionParentKind parentKind,
    u32[0 max] ordinal)
{
    if (node == 0)
    {
        return false;
    }

    stack LogicalPackageTypedTemplateExpressionWorkItem item =
        new LogicalPackageTypedTemplateExpressionWorkItem()
    {
        NodeValue = node,
        ParentExpressionRowValue = parentRow,
        ParentKindValue = parentKind,
        ExpressionOrdinalValue = ordinal
    };
    return work.Add(item) != 0;
}

internal fn bool LogicalPackageImageJsonEnqueueTypedTemplateExpressionChildren(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] expressionNode,
    u32[0 max] parentExpressionRow,
    mut borrow IrTable<LogicalPackageTypedTemplateExpressionWorkItem> work)
{
    stack mut u64[0 2 ** 63 - 1] targetExpressionNode = 0;
    stack mut bool hasTargetExpression = false;
    stack mut u64[0 2 ** 63 - 1] argumentsNode = 0;
    stack mut u32[0 max] argumentCount = 0;
    if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            expressionNode,
            "TargetExpression",
            targetExpressionNode,
            hasTargetExpression)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "Arguments",
            argumentsNode,
            argumentCount))
    {
        return false;
    }

    if (hasTargetExpression
        && !LogicalPackageImageJsonEnqueueTypedTemplateExpressionWorkItem(
            work,
            targetExpressionNode,
            parentExpressionRow,
            LogicalPackageTypedTemplateExpressionParentKind.TargetExpression,
            0))
    {
        return false;
    }

    stack mut u32[0 max] argumentIndex = 0;
    while willexit (argumentIndex < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(argumentsNode, (u64[0 2 ** 63 - 1])argumentIndex, argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || !LogicalPackageImageJsonEnqueueTypedTemplateExpressionWorkItem(
                work,
                argumentNode,
                parentExpressionRow,
                LogicalPackageTypedTemplateExpressionParentKind.Argument,
                argumentIndex))
        {
            return false;
        }

        argumentIndex = argumentIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateExpressionRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] expressionsNode,
    u32[0 max] expressionCount,
    u32[0 max] functionTemplateRow,
    u32[0 max] parentExpressionRow,
    LogicalPackageTypedTemplateExpressionParentKind parentKind,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < expressionCount)
    {
        stack mut u64[0 2 ** 63 - 1] expressionNode = 0;
        stack mut u32[0 max] expressionRow = 0;
        if (!document.TryChildAt(expressionsNode, (u64[0 2 ** 63 - 1])index, expressionNode)
            || document.KindAt(expressionNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypedTemplateExpressionTree(
                document,
                expressionNode,
                functionTemplateRow,
                parentExpressionRow,
                parentKind,
                index,
                graph,
                expressionRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateExpressionTree(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] rootExpressionNode,
    u32[0 max] functionTemplateRow,
    u32[0 max] parentExpressionRow,
    LogicalPackageTypedTemplateExpressionParentKind parentKind,
    u32[0 max] expressionOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out u32[0 max] expressionRow)
{
    expressionRow = 0;
    stack mut IrTable<LogicalPackageTypedTemplateExpressionWorkItem> work = new();
    if (!LogicalPackageImageJsonEnqueueTypedTemplateExpressionWorkItem(
        work,
        rootExpressionNode,
        parentExpressionRow,
        parentKind,
        expressionOrdinal))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = 1;
    while willexit (cursor <= work.Count())
    {
        if (cursor > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
        {
            return false;
        }

        stack LogicalPackageTypedTemplateExpressionWorkItem item = work.Get((u32[0 max])cursor);
        stack mut u32[0 max] currentExpressionRow = 0;
        if (!LogicalPackageImageJsonMaterializeTypedTemplateExpressionRow(
                document,
                item.NodeValue,
                functionTemplateRow,
                item.ParentExpressionRowValue,
                item.ParentKindValue,
                item.ExpressionOrdinalValue,
                graph,
                currentExpressionRow)
            || !LogicalPackageImageJsonEnqueueTypedTemplateExpressionChildren(
                document,
                item.NodeValue,
                currentExpressionRow,
                work))
        {
            return false;
        }

        if (cursor == 1)
        {
            expressionRow = currentExpressionRow;
        }

        cursor = cursor + 1;
    }

    return expressionRow != 0;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateExpressionRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] expressionNode,
    u32[0 max] functionTemplateRow,
    u32[0 max] parentExpressionRow,
    LogicalPackageTypedTemplateExpressionParentKind parentKind,
    u32[0 max] expressionOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out u32[0 max] expressionRow)
{
    expressionRow = 0;
    stack mut u32[0 max] kindTextRow = 0;
    stack mut u32[0 max] nameTextRow = 0;
    stack mut u32[0 max] assignmentOperatorTextRow = 0;
    stack mut u32[0 max] literalTextRow = 0;
    stack mut bool hasName = false;
    stack mut bool hasAssignmentOperator = false;
    stack mut bool hasLiteralText = false;
    stack mut bool hasOrdinal = false;
    stack mut u32[0 max] ordinal = 0;
    stack mut u64[0 2 ** 63 - 1] typeNode = 0;
    stack mut bool hasType = false;
    stack mut u32[0 max] typeReferenceRow = 0;
    stack mut u64[0 2 ** 63 - 1] targetExpressionNode = 0;
    stack mut bool hasTargetExpression = false;
    stack mut u64[0 2 ** 63 - 1] argumentsNode = 0;
    stack mut u32[0 max] argumentCount = 0;
    stack mut u64[0 2 ** 63 - 1] memberNamesNode = 0;
    stack mut u32[0 max] memberNameCount = 0;
    stack mut u64[0 2 ** 63 - 1] operatorNamesNode = 0;
    stack mut u32[0 max] operatorNameCount = 0;
    stack mut u64[0 2 ** 63 - 1] typeArgumentsNode = 0;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u64[0 2 ** 63 - 1] comptimeValueArgumentsNode = 0;
    stack mut u32[0 max] comptimeValueArgumentCount = 0;
    stack mut u32[0 max] addedExpressionRow = 0;
    if (!LogicalPackageImageJsonMaterializeGenericTemplateFactTextMemberRow(
            document,
            expressionNode,
            "Kind",
            LogicalPackageGenericTemplateFactTextKind.ExpressionKind,
            expressionOrdinal,
            graph,
            kindTextRow)
        || !LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRow(
            document,
            expressionNode,
            "Name",
            LogicalPackageGenericTemplateFactTextKind.ExpressionName,
            expressionOrdinal,
            graph,
            hasName,
            nameTextRow)
        || !LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRow(
            document,
            expressionNode,
            "AssignmentOperator",
            LogicalPackageGenericTemplateFactTextKind.ExpressionAssignmentOperator,
            expressionOrdinal,
            graph,
            hasAssignmentOperator,
            assignmentOperatorTextRow)
        || !LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRowAllowEmpty(
            document,
            expressionNode,
            "LiteralText",
            LogicalPackageGenericTemplateFactTextKind.ExpressionLiteralText,
            expressionOrdinal,
            true,
            graph,
            hasLiteralText,
            literalTextRow)
        || !LogicalPackageImageJsonOptionalU32MemberValue(document, expressionNode, "Ordinal", hasOrdinal, ordinal)
        || !LogicalPackageImageJsonOptionalObjectMember(document, expressionNode, "Type", typeNode, hasType)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            expressionNode,
            "TargetExpression",
            targetExpressionNode,
            hasTargetExpression)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "Arguments",
            argumentsNode,
            argumentCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "MemberNames",
            memberNamesNode,
            memberNameCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "OperatorNames",
            operatorNamesNode,
            operatorNameCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "TypeArguments",
            typeArgumentsNode,
            typeArgumentCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "ComptimeValueArguments",
            comptimeValueArgumentsNode,
            comptimeValueArgumentCount))
    {
        return false;
    }

    if (hasType
        && !LogicalPackageImageJsonMaterializeGenericTemplateTypeReference(
            document,
            typeNode,
            functionTemplateRow,
            LogicalPackageTypedTypeReferenceSource.GenericTemplateExpressionType,
            expressionOrdinal,
            graph,
            typeReferenceRow))
    {
        return false;
    }

    if (!LogicalPackageGenericTemplateFactGraphAddTypedTemplateExpressionRow(
            graph,
            functionTemplateRow,
            parentExpressionRow,
            parentKind,
            expressionOrdinal,
            kindTextRow,
            hasName,
            nameTextRow,
            hasAssignmentOperator,
            assignmentOperatorTextRow,
            hasLiteralText,
            literalTextRow,
            hasOrdinal,
            ordinal,
            hasType,
            typeReferenceRow,
            hasTargetExpression,
            argumentCount,
            memberNameCount,
            operatorNameCount,
            typeArgumentCount,
            comptimeValueArgumentCount,
            addedExpressionRow))
    {
        return false;
    }

    stack u32[0 max] currentExpressionRow = addedExpressionRow;
    if (!LogicalPackageImageJsonMaterializeTypedTemplateExpressionMemberNameRows(
            document,
            memberNamesNode,
            memberNameCount,
            currentExpressionRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTypedTemplateExpressionOperatorNameRows(
            document,
            operatorNamesNode,
            operatorNameCount,
            currentExpressionRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTypedTemplateExpressionTypeArgumentRows(
            document,
            typeArgumentsNode,
            typeArgumentCount,
            currentExpressionRow,
            functionTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTypedTemplateExpressionComptimeValueArgumentRows(
            document,
            comptimeValueArgumentsNode,
            comptimeValueArgumentCount,
            currentExpressionRow,
            functionTemplateRow,
            graph))
    {
        return false;
    }

    expressionRow = currentExpressionRow;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateStatementLoopContractRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] loopContractsNode,
    u32[0 max] loopContractCount,
    u32[0 max] statementRow,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < loopContractCount)
    {
        stack mut u64[0 2 ** 63 - 1] contractNode = 0;
        stack mut u32[0 max] nameTextRow = 0;
        if (!document.TryChildAt(loopContractsNode, (u64[0 2 ** 63 - 1])index, contractNode)
            || document.KindAt(contractNode) != JsonKind.Text)
        {
            return false;
        }

        stack ascii contractName = document.TextAt(contractNode);
        if (System.Text.AsciiLength(contractName) <= 0
            || !LogicalPackageGenericTemplateFactGraphAddTextRow(
                graph,
                LogicalPackageGenericTemplateFactTextKind.StatementLoopContractName,
                index,
                contractName,
                nameTextRow)
            || !LogicalPackageGenericTemplateFactGraphAddTypedTemplateStatementLoopContractRow(
                graph,
                statementRow,
                index,
                nameTextRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonEnqueueTypedTemplatePatternWorkItem(
    mut borrow IrTable<LogicalPackageTypedTemplatePatternWorkItem> work,
    u64[0 2 ** 63 - 1] node,
    u32[0 max] statementRow,
    u32[0 max] switchCaseRow,
    u32[0 max] parentPatternRow,
    LogicalPackageTypedTemplatePatternParentKind parentKind,
    u32[0 max] ordinal)
{
    if (node == 0)
    {
        return false;
    }

    stack LogicalPackageTypedTemplatePatternWorkItem item =
        new LogicalPackageTypedTemplatePatternWorkItem()
    {
        NodeValue = node,
        StatementRowValue = statementRow,
        SwitchCaseRowValue = switchCaseRow,
        ParentPatternRowValue = parentPatternRow,
        ParentKindValue = parentKind,
        PatternOrdinalValue = ordinal
    };
    return work.Add(item) != 0;
}

internal fn bool LogicalPackageImageJsonEnqueueTypedTemplatePatternMembers(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] patternNode,
    u32[0 max] parentPatternRow,
    mut borrow IrTable<LogicalPackageTypedTemplatePatternWorkItem> work)
{
    stack mut u64[0 2 ** 63 - 1] membersNode = 0;
    stack mut u32[0 max] memberCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            patternNode,
            "Members",
            membersNode,
            memberCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < memberCount)
    {
        stack mut u64[0 2 ** 63 - 1] memberNode = 0;
        if (!document.TryChildAt(membersNode, (u64[0 2 ** 63 - 1])index, memberNode)
            || document.KindAt(memberNode) != JsonKind.Object
            || !LogicalPackageImageJsonEnqueueTypedTemplatePatternWorkItem(
                work,
                memberNode,
                0,
                0,
                parentPatternRow,
                LogicalPackageTypedTemplatePatternParentKind.PatternMember,
                index))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTemplatePatternRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] patternNode,
    u32[0 max] functionTemplateRow,
    u32[0 max] statementRow,
    u32[0 max] switchCaseRow,
    u32[0 max] parentPatternRow,
    LogicalPackageTypedTemplatePatternParentKind parentKind,
    u32[0 max] patternOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out u32[0 max] patternRow)
{
    patternRow = 0;
    stack mut u32[0 max] kindTextRow = 0;
    stack mut u32[0 max] nameTextRow = 0;
    stack mut bool hasName = false;
    stack mut bool hasOrdinal = false;
    stack mut u32[0 max] ordinal = 0;
    stack mut u64[0 2 ** 63 - 1] expressionNode = 0;
    stack mut u64[0 2 ** 63 - 1] endExpressionNode = 0;
    stack mut bool hasExpression = false;
    stack mut bool hasEndExpression = false;
    stack mut u32[0 max] expressionRow = 0;
    stack mut u32[0 max] endExpressionRow = 0;
    stack mut u64[0 2 ** 63 - 1] membersNode = 0;
    stack mut u32[0 max] memberPatternCount = 0;
    if (!LogicalPackageImageJsonMaterializeGenericTemplateFactTextMemberRow(
            document,
            patternNode,
            "Kind",
            LogicalPackageGenericTemplateFactTextKind.PatternKind,
            patternOrdinal,
            graph,
            kindTextRow)
        || !LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRow(
            document,
            patternNode,
            "Name",
            LogicalPackageGenericTemplateFactTextKind.PatternName,
            patternOrdinal,
            graph,
            hasName,
            nameTextRow)
        || !LogicalPackageImageJsonOptionalU32MemberValue(document, patternNode, "Ordinal", hasOrdinal, ordinal)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            patternNode,
            "Expression",
            expressionNode,
            hasExpression)
        || !LogicalPackageImageJsonOptionalObjectMember(
            document,
            patternNode,
            "EndExpression",
            endExpressionNode,
            hasEndExpression)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            patternNode,
            "Members",
            membersNode,
            memberPatternCount))
    {
        return false;
    }

    if (hasExpression
        && !LogicalPackageImageJsonMaterializeTypedTemplateExpressionTree(
            document,
            expressionNode,
            functionTemplateRow,
            0,
            LogicalPackageTypedTemplateExpressionParentKind.Root,
            0,
            graph,
            expressionRow))
    {
        return false;
    }

    if (hasEndExpression
        && !LogicalPackageImageJsonMaterializeTypedTemplateExpressionTree(
            document,
            endExpressionNode,
            functionTemplateRow,
            0,
            LogicalPackageTypedTemplateExpressionParentKind.Root,
            1,
            graph,
            endExpressionRow))
    {
        return false;
    }

    return LogicalPackageGenericTemplateFactGraphAddTypedTemplatePatternRow(
        graph,
        statementRow,
        switchCaseRow,
        parentPatternRow,
        parentKind,
        patternOrdinal,
        kindTextRow,
        hasName,
        nameTextRow,
        hasOrdinal,
        ordinal,
        hasExpression,
        expressionRow,
        hasEndExpression,
        endExpressionRow,
        memberPatternCount,
        patternRow);
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTemplatePatternTree(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] rootPatternNode,
    u32[0 max] functionTemplateRow,
    u32[0 max] statementRow,
    u32[0 max] switchCaseRow,
    u32[0 max] parentPatternRow,
    LogicalPackageTypedTemplatePatternParentKind parentKind,
    u32[0 max] patternOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out u32[0 max] patternRow)
{
    patternRow = 0;
    stack mut IrTable<LogicalPackageTypedTemplatePatternWorkItem> work = new();
    if (!LogicalPackageImageJsonEnqueueTypedTemplatePatternWorkItem(
            work,
            rootPatternNode,
            statementRow,
            switchCaseRow,
            parentPatternRow,
            parentKind,
            patternOrdinal))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = 1;
    while willexit (cursor <= work.Count())
    {
        if (cursor > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
        {
            return false;
        }

        stack LogicalPackageTypedTemplatePatternWorkItem item = work.Get((u32[0 max])cursor);
        stack mut u32[0 max] currentPatternRow = 0;
        if (!LogicalPackageImageJsonMaterializeTypedTemplatePatternRow(
                document,
                item.NodeValue,
                functionTemplateRow,
                item.StatementRowValue,
                item.SwitchCaseRowValue,
                item.ParentPatternRowValue,
                item.ParentKindValue,
                item.PatternOrdinalValue,
                graph,
                currentPatternRow)
            || !LogicalPackageImageJsonEnqueueTypedTemplatePatternMembers(
                document,
                item.NodeValue,
                currentPatternRow,
                work))
        {
            return false;
        }

        if (cursor == 1)
        {
            patternRow = currentPatternRow;
        }

        cursor = cursor + 1;
    }

    return patternRow != 0;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTemplatePatternRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] patternsNode,
    u32[0 max] patternCount,
    u32[0 max] functionTemplateRow,
    u32[0 max] statementRow,
    u32[0 max] switchCaseRow,
    u32[0 max] parentPatternRow,
    LogicalPackageTypedTemplatePatternParentKind parentKind,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < patternCount)
    {
        stack mut u64[0 2 ** 63 - 1] patternNode = 0;
        stack mut u32[0 max] patternRow = 0;
        if (!document.TryChildAt(patternsNode, (u64[0 2 ** 63 - 1])index, patternNode)
            || document.KindAt(patternNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypedTemplatePatternTree(
                document,
                patternNode,
                functionTemplateRow,
                statementRow,
                switchCaseRow,
                parentPatternRow,
                parentKind,
                index,
                graph,
                patternRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

