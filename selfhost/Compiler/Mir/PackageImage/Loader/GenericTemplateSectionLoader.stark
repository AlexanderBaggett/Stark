                document,
                operationNode,
                "IndexCount",
                boundOperationRow,
                LogicalPackageTemplateBoundOperationU32PayloadKind.IndexCount,
                0,
                graph);
    }

    if (kindText == "dynamic-storage-operation")
    {
        return LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTextPayload(
                document,
                operationNode,
                "OperationName",
                boundOperationRow,
                LogicalPackageGenericTemplateFactTextKind.BoundOperationOperationName,
