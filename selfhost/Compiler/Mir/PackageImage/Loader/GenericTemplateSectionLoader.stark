internal fn bool LogicalPackageImageJsonEnqueueTypedTemplateStatementArrayMember(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] statementNode,
    ascii memberName,
    u32[0 max] parentStatementRow,
    LogicalPackageTypedTemplateStatementParentKind parentKind,
    mut borrow IrTable<LogicalPackageTypedTemplateStatementWorkItem> work)
{
    stack mut u64[0 2 ** 63 - 1] childStatementsNode = 0;
    stack mut u32[0 max] childStatementCount = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(
        document,
        statementNode,
        memberName,
        childStatementsNode,
        childStatementCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < childStatementCount)
    {
        stack mut u64[0 2 ** 63 - 1] childStatementNode = 0;
        if (!document.TryChildAt(
                childStatementsNode,
                (u64[0 2 ** 63 - 1])index,
                childStatementNode)
            || document.KindAt(childStatementNode) != JsonKind.Object
            || !LogicalPackageImageJsonEnqueueTypedTemplateStatementWorkItem(
                work,
                childStatementNode,
                parentStatementRow,
                0,
                parentKind,
                index))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

