        || !LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRowAllowEmpty(
            document,
            expressionNode,
            "LiteralText",
            LogicalPackageGenericTemplateFactTextKind.ExpressionLiteralText,
            expressionOrdinal,
            true,
            graph,
