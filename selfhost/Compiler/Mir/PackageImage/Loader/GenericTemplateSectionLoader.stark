                item.ParentKindValue,
                item.StatementOrdinalValue,
                graph,
                statementRow)
            || !LogicalPackageImageJsonEnqueueTypedTemplateStatementChildren(
                document,
                item.NodeValue,
                statementRow,
                functionTemplateRow,
                graph,
                work))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    return true;
}

