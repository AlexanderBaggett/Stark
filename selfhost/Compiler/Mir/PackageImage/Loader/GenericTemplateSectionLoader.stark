            boundOperationRow,
            LogicalPackageTemplateBoundOperationTypePayloadKind.Closure,
            LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationClosureType,
            0,
            graph);
    }

    if (kindText == "index-access" || kindText == "slice-access")
    {
        return LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTextPayload(
                document,
                operationNode,
                "AccessKind",
                boundOperationRow,
                LogicalPackageGenericTemplateFactTextKind.BoundOperationAccessKind,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTextPayload(
                document,
                operationNode,
                "SourceKind",
