        new LogicalPackageTypedTemplateStatementLoopContractRow()
    {
        StatementRowValue = statementRow,
        ContractOrdinalValue = contractOrdinal,
        NameTextRowValue = nameTextRow
    };
    return graph.TypedTemplateStatementLoopContractRows.Add(row) != 0;
}

