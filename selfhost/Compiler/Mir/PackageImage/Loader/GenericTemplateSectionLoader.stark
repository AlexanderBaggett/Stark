                work,
                statementNode,
                parentStatementRow,
                0,
                parentKind,
                index))
        {
            return false;
        }

        index = index + 1;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = 1;
    while willexit (cursor <= work.Count())
    {
        if (cursor > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
        {
            return false;
        }

        stack LogicalPackageTypedTemplateStatementWorkItem item = work.Get((u32[0 max])cursor);
        stack mut u32[0 max] statementRow = 0;
        if (!LogicalPackageImageJsonMaterializeTypedTemplateStatementRow(
                document,
                item.NodeValue,
                functionTemplateRow,
                item.ParentStatementRowValue,
