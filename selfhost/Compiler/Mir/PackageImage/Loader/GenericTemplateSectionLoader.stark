internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateExpressionTree(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] rootExpressionNode,
    u32[0 max] functionTemplateRow,
    u32[0 max] parentExpressionRow,
    LogicalPackageTypedTemplateExpressionParentKind parentKind,
    u32[0 max] expressionOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out u32[0 max] expressionRow)
{
    expressionRow = 0;
    stack mut IrTable<LogicalPackageTypedTemplateExpressionWorkItem> work = new();
    if (!LogicalPackageImageJsonEnqueueTypedTemplateExpressionWorkItem(
        work,
        rootExpressionNode,
        parentExpressionRow,
        parentKind,
        expressionOrdinal))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = 1;
    while willexit (cursor <= work.Count())
    {
        if (cursor > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
        {
            return false;
        }

        stack LogicalPackageTypedTemplateExpressionWorkItem item = work.Get((u32[0 max])cursor);
        stack mut u32[0 max] currentExpressionRow = 0;
        if (!LogicalPackageImageJsonMaterializeTypedTemplateExpressionRow(
                document,
                item.NodeValue,
                functionTemplateRow,
                item.ParentExpressionRowValue,
                item.ParentKindValue,
                item.ExpressionOrdinalValue,
                graph,
                currentExpressionRow)
            || !LogicalPackageImageJsonEnqueueTypedTemplateExpressionChildren(
                document,
                item.NodeValue,
                currentExpressionRow,
                work))
        {
            return false;
        }

        if (cursor == 1)
        {
            expressionRow = currentExpressionRow;
        }

        cursor = cursor + 1;
    }

    return expressionRow != 0;
}

internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateExpressionRow(
