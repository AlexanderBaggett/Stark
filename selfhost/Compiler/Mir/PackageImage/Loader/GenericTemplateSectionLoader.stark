internal fn bool LogicalPackageImageJsonEnqueueTypedTemplateExpressionWorkItem(
    mut borrow IrTable<LogicalPackageTypedTemplateExpressionWorkItem> work,
    u64[0 2 ** 63 - 1] node,
    u32[0 max] parentRow,
    LogicalPackageTypedTemplateExpressionParentKind parentKind,
    u32[0 max] ordinal)
{
    if (node == 0)
    {
        return false;
    }

    stack LogicalPackageTypedTemplateExpressionWorkItem item =
        new LogicalPackageTypedTemplateExpressionWorkItem()
    {
        NodeValue = node,
        ParentExpressionRowValue = parentRow,
        ParentKindValue = parentKind,
        ExpressionOrdinalValue = ordinal
    };
    return work.Add(item) != 0;
}

internal fn bool LogicalPackageImageJsonEnqueueTypedTemplateExpressionChildren(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] expressionNode,
    u32[0 max] parentExpressionRow,
    mut borrow IrTable<LogicalPackageTypedTemplateExpressionWorkItem> work)
{
    stack mut u64[0 2 ** 63 - 1] targetExpressionNode = 0;
    stack mut bool hasTargetExpression = false;
    stack mut u64[0 2 ** 63 - 1] argumentsNode = 0;
    stack mut u32[0 max] argumentCount = 0;
    if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            expressionNode,
            "TargetExpression",
            targetExpressionNode,
            hasTargetExpression)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            expressionNode,
            "Arguments",
            argumentsNode,
            argumentCount))
    {
        return false;
    }

    if (hasTargetExpression
        && !LogicalPackageImageJsonEnqueueTypedTemplateExpressionWorkItem(
            work,
            targetExpressionNode,
            parentExpressionRow,
            LogicalPackageTypedTemplateExpressionParentKind.TargetExpression,
            0))
    {
        return false;
    }

    stack mut u32[0 max] argumentIndex = 0;
    while willexit (argumentIndex < argumentCount)
    {
        stack mut u64[0 2 ** 63 - 1] argumentNode = 0;
        if (!document.TryChildAt(argumentsNode, (u64[0 2 ** 63 - 1])argumentIndex, argumentNode)
            || document.KindAt(argumentNode) != JsonKind.Object
            || !LogicalPackageImageJsonEnqueueTypedTemplateExpressionWorkItem(
                work,
                argumentNode,
                parentExpressionRow,
                LogicalPackageTypedTemplateExpressionParentKind.Argument,
                argumentIndex))
        {
            return false;
        }

        argumentIndex = argumentIndex + 1;
    }

    return true;
}

