internal fn bool LogicalPackageImageJsonMaterializeTypedTemplateStatementRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] statementsNode,
    u32[0 max] statementCount,
    u32[0 max] functionTemplateRow,
    u32[0 max] parentStatementRow,
    LogicalPackageTypedTemplateStatementParentKind parentKind,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut IrTable<LogicalPackageTypedTemplateStatementWorkItem> work = new();
    stack mut u32[0 max] index = 0;
    while willexit (index < statementCount)
    {
        stack mut u64[0 2 ** 63 - 1] statementNode = 0;
        if (!document.TryChildAt(statementsNode, (u64[0 2 ** 63 - 1])index, statementNode)
            || document.KindAt(statementNode) != JsonKind.Object
