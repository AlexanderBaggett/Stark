            localDeclarationsNode,
            localDeclarationCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            templateNode,
            "Conversions",
            conversionsNode,
            conversionCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            templateNode,
            "DirectCalls",
            directCallsNode,
            directCallCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            templateNode,
            "FieldAccesses",
            fieldAccessesNode,
            fieldAccessCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            templateNode,
            "MemberCalls",
            memberCallsNode,
            memberCallCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            templateNode,
            "FunctionAddresses",
            functionAddressesNode,
            functionAddressCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            templateNode,
            "BoundOperations",
            boundOperationsNode,
            boundOperationCount)
        || !LogicalPackageImageJsonOptionalArrayMember(
            document,
            templateNode,
            "TryPropagations",
            tryPropagationsNode,
            tryPropagationCount))
    {
        return false;
    }

    stack mut u32[0 max] addedTemplateRow = 0;
    if (!LogicalPackageGenericTemplateFactGraphAddFunctionTemplateRow(
            graph,
            moduleOrdinal,
            templateOrdinal,
            qualifiedResolvedNameTextRow,
            qualifiedNameTextRow,
            overloadKeyTextRow,
            hasBodyText,
            bodyTextRow,
            hasBackendOptimizationMode,
            backendOptimizationModeTextRow,
            hasTopLevelStatementCount,
            topLevelStatementCount,
            hasEstimatedBodyCost,
            estimatedBodyCost,
            hasSemantics,
            hasTypedBody,
            deferredFunctionInstantiationCount,
            deferredTypeInstantiationCount,
            objectCreationCount,
            enumConstructorCount,
            enumCallCount,
            enumValueCount,
            enumPatternCount,
            aggregatePatternCount,
            localDeclarationCount,
            conversionCount,
            directCallCount,
            fieldAccessCount,
            memberCallCount,
            functionAddressCount,
            boundOperationCount,
            tryPropagationCount,
            addedTemplateRow))
    {
        return false;
    }

    stack u32[0 max] currentTemplateRow = addedTemplateRow;
    if (hasTypedBody
        && !LogicalPackageImageJsonMaterializeTypedTemplateBodyRows(
            document,
            typedBodyNode,
            currentTemplateRow,
            graph))
    {
        return false;
    }

    if (!LogicalPackageImageJsonMaterializeDeferredFunctionInstantiationRows(
            document,
            deferredFunctionInstantiationsNode,
            deferredFunctionInstantiationCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeDeferredTypeInstantiationRows(
            document,
            deferredTypeInstantiationsNode,
            deferredTypeInstantiationCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateObjectCreationRows(
            document,
            objectCreationsNode,
            objectCreationCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateEnumConstructorRows(
            document,
            enumConstructorsNode,
            enumConstructorCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateEnumCallRows(
            document,
            enumCallsNode,
            enumCallCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateEnumValueRows(
            document,
            enumValuesNode,
            enumValueCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateEnumPatternRows(
            document,
            enumPatternsNode,
            enumPatternCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateAggregatePatternRows(
            document,
            aggregatePatternsNode,
            aggregatePatternCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateLocalDeclarationRows(
            document,
            localDeclarationsNode,
            localDeclarationCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateConversionRows(
            document,
            conversionsNode,
            conversionCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateCallSignatureRows(
            document,
            directCallsNode,
            directCallCount,
            LogicalPackageTemplateCallParentKind.DirectCall,
            currentTemplateRow,
            false,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateFieldAccessRows(
            document,
            fieldAccessesNode,
            fieldAccessCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateCallSignatureRows(
            document,
            memberCallsNode,
            memberCallCount,
            LogicalPackageTemplateCallParentKind.MemberCall,
            currentTemplateRow,
            false,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateCallSignatureRows(
            document,
            functionAddressesNode,
            functionAddressCount,
            LogicalPackageTemplateCallParentKind.FunctionAddress,
            currentTemplateRow,
            true,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateBoundOperationRows(
            document,
            boundOperationsNode,
            boundOperationCount,
            currentTemplateRow,
            graph)
        || !LogicalPackageImageJsonMaterializeTemplateTryPropagationRows(
            document,
            tryPropagationsNode,
            tryPropagationCount,
            currentTemplateRow,
            graph))
    {
        return false;
    }

    templateRow = currentTemplateRow;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeGenericTemplateFactRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] genericTemplatesNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out u32[0 max] functionTemplateCount)
{
    functionTemplateCount = 0;
    stack mut u64[0 2 ** 63 - 1] functionsNode = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(
        document,
        genericTemplatesNode,
        "Functions",
        functionsNode,
        functionTemplateCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < functionTemplateCount)
    {
        stack mut u64[0 2 ** 63 - 1] functionNode = 0;
        stack mut u32[0 max] templateRow = 0;
        if (!document.TryChildAt(functionsNode, (u64[0 2 ** 63 - 1])index, functionNode)
            || document.KindAt(functionNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeFunctionTemplateRow(
                document,
                functionNode,
                moduleOrdinal,
                index,
                graph,
                templateRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

public unsafe fn bool TryMaterializeLogicalPackageGenericTemplateFactJsonGraph(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] genericTemplatesNode = 0;
            stack mut bool usesCompilerSections = false;
            stack mut u32[0 max] functionTemplateCount = 0;
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonEffectiveGenericTemplatesNode(
                    document,
                    moduleNode,
                    genericTemplatesNode,
                    usesCompilerSections))
            {
                return false;
            }

            return LogicalPackageImageJsonMaterializeGenericTemplateFactRows(
                document,
                genericTemplatesNode,
                moduleOrdinal,
                graph,
                functionTemplateCount);
    }
}
