internal fn bool LogicalPackageImageJsonMaterializeTemplateBoundOperationRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] operationsNode,
    u32[0 max] operationCount,
    u32[0 max] functionTemplateRow,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    stack mut u32[0 max] index = 0;
    while willexit (index < operationCount)
    {
        stack mut u64[0 2 ** 63 - 1] operationNode = 0;
        stack mut u64[0 2 ** 63 - 1] kindNode = 0;
        stack mut u64[0 2 ** 63 - 1] resultTypeNode = 0;
        stack mut u64[0 2 ** 63 - 1] callArgumentsNode = 0;
        stack mut u64[0 2 ** 63 - 1] qualifiedResolvedNameNode = 0;
        stack mut u32[0 max] kindTextRow = 0;
        stack mut u32[0 max] line = 0;
        stack mut u32[0 max] column = 0;
        stack mut u32[0 max] resultTypeReferenceRow = 0;
        stack mut bool hasPublishedOrdinal = false;
        stack mut u32[0 max] publishedOrdinal = 0;
        stack mut bool hasEnclosingFunctionName = false;
        stack mut u32[0 max] enclosingFunctionNameTextRow = 0;
        stack mut u32[0 max] callArgumentCount = 0;
        stack mut u32[0 max] boundOperationRow = 0;
        stack mut bool hasCallSignature = false;
        stack mut u32[0 max] callSignatureRow = 0;
        if (!document.TryChildAt(operationsNode, (u64[0 2 ** 63 - 1])index, operationNode)
            || document.KindAt(operationNode) != JsonKind.Object
            || !document.TryFindMember(operationNode, "Kind", kindNode)
            || document.KindAt(kindNode) != JsonKind.Text
            || !LogicalPackageImageJsonMaterializeGenericTemplateFactTextMemberRow(
                document,
                operationNode,
                "Kind",
                LogicalPackageGenericTemplateFactTextKind.BoundOperationKind,
                index,
                graph,
                kindTextRow)
            || !LogicalPackageImageJsonRequiredU32MemberValue(document, operationNode, "Line", line)
            || !LogicalPackageImageJsonRequiredU32MemberValue(document, operationNode, "Column", column)
            || !LogicalPackageImageJsonRequiredObjectMember(document, operationNode, "ResultType", resultTypeNode)
            || !LogicalPackageImageJsonMaterializeGenericTemplateTypeReference(
                document,
                resultTypeNode,
                functionTemplateRow,
                LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationResultType,
                index,
                graph,
                resultTypeReferenceRow)
            || !LogicalPackageImageJsonOptionalU32MemberValue(
                document,
                operationNode,
                "Ordinal",
                hasPublishedOrdinal,
                publishedOrdinal)
            || !LogicalPackageImageJsonMaterializeOptionalGenericTemplateFactTextMemberRow(
                document,
                operationNode,
                "EnclosingFunctionName",
                LogicalPackageGenericTemplateFactTextKind.BoundOperationEnclosingFunctionName,
                index,
                graph,
                hasEnclosingFunctionName,
                enclosingFunctionNameTextRow)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                operationNode,
                "CallArguments",
                callArgumentsNode,
                callArgumentCount))
        {
            return false;
        }

        stack ascii kindText = document.TextAt(kindNode);
        if (document.TryFindMember(operationNode, "QualifiedResolvedName", qualifiedResolvedNameNode)
            && document.KindAt(qualifiedResolvedNameNode) != JsonKind.Null)
        {
            if (document.KindAt(qualifiedResolvedNameNode) != JsonKind.Text)
            {
                return false;
            }

            hasCallSignature = true;
        }

        if ((kindText == "direct-call" || kindText == "member-call") && !hasCallSignature)
        {
            return false;
        }

        if (!LogicalPackageGenericTemplateFactGraphAddTemplateBoundOperationRow(
                graph,
                functionTemplateRow,
                index,
                kindTextRow,
                line,
                column,
                resultTypeReferenceRow,
                hasPublishedOrdinal,
                publishedOrdinal,
                hasEnclosingFunctionName,
                enclosingFunctionNameTextRow,
                callArgumentCount,
                boundOperationRow))
        {
            return false;
        }

        if (hasCallSignature
            && (!LogicalPackageImageJsonMaterializeTemplateCallSignatureRow(
                    document,
                    operationNode,
                    LogicalPackageTemplateCallParentKind.BoundOperation,
                    index,
                    functionTemplateRow,
                    false,
                    false,
                    graph,
                    callSignatureRow)
                || !LogicalPackageGenericTemplateFactGraphSetTemplateBoundOperationCallSignature(
                    graph,
                    boundOperationRow,
                    callSignatureRow)))
        {
            return false;
        }

        if (!LogicalPackageImageJsonMaterializeTemplateBoundOperationCallArgumentRows(
                document,
                callArgumentsNode,
                callArgumentCount,
                boundOperationRow,
                functionTemplateRow,
                graph)
            || !LogicalPackageImageJsonMaterializeTemplateBoundOperationPayloadRows(
                document,
                operationNode,
                kindText,
                functionTemplateRow,
                boundOperationRow,
                graph))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

