public struct LogicalPackageTypedTypeFactGraph
{
    internal dynamic i8[min max] TextBytes;
    internal IrTable<LogicalPackageTypedTypeFactTextRow> TextRows;
    internal IrTable<LogicalPackageTypedTypeRow> TypeRows;
    internal IrTable<LogicalPackageTypedTypeAssociatedTypeRow> AssociatedTypeRows;
    internal IrTable<LogicalPackageTypedTypeImplementedTraitNameRow> ImplementedTraitNameRows;
    internal IrTable<LogicalPackageTypedTypeImplementedTraitTypeRow> ImplementedTraitTypeRows;
    internal IrTable<LogicalPackageTypedTypeThreadSafetyLawAttributeRow> ThreadSafetyLawAttributeRows;
    internal IrTable<LogicalPackageTypedTypeEnumVariantRow> EnumVariantRows;
    internal IrTable<LogicalPackageTypedTypeEnumPayloadRow> EnumPayloadRows;
    internal LogicalPackageTypeReferenceGraph TypeReferences;

    LogicalPackageTypedTypeFactGraph()
    {
        self.TextBytes = new();
        self.TextRows = new();
        self.TypeRows = new();
        self.AssociatedTypeRows = new();
        self.ImplementedTraitNameRows = new();
        self.ImplementedTraitTypeRows = new();
        self.ThreadSafetyLawAttributeRows = new();
        self.EnumVariantRows = new();
        self.EnumPayloadRows = new();
        self.TypeReferences = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] TextByteCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.TextBytes.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] TextRowCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.TextRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] TypeRowCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.TypeRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] AssociatedTypeRowCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.AssociatedTypeRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] ImplementedTraitNameRowCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.ImplementedTraitNameRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] ImplementedTraitTypeRowCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.ImplementedTraitTypeRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] ThreadSafetyLawAttributeRowCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.ThreadSafetyLawAttributeRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] EnumVariantRowCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.EnumVariantRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] EnumPayloadRowCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.EnumPayloadRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] TypeReferenceCount(
        borrow LogicalPackageTypedTypeFactGraph self)
    {
        return self.TypeReferences.TypeReferenceCount();
    }

    public finite law retborrow LogicalPackageTypedTypeFactTextRow TextRowAt(
        borrow LogicalPackageTypedTypeFactGraph self,
        u32[0 max] row)
    {
        return self.TextRows.Get(row);
    }

    public finite law retborrow LogicalPackageTypedTypeRow TypeRowAt(
        borrow LogicalPackageTypedTypeFactGraph self,
        u32[0 max] row)
    {
        return self.TypeRows.Get(row);
    }

    public finite law retborrow LogicalPackageTypedTypeAssociatedTypeRow AssociatedTypeRowAt(
