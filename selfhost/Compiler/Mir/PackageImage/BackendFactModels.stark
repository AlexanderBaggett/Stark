import Compiler.Ir
import Compiler.Mir.PackageImage.ModelKinds
module Compiler.Mir.PackageImage.BackendFactModels

// Native metadata, layout, type-reference, ABI, and function-effect fact
// carriers. Their exact ranges, alias/ABI facts, and backend effect flags stay
// in the same allocation-free table representations consumed by lowering.

public struct LogicalPackageNativeMetadataFactTextRow
{
    LogicalPackageNativeMetadataFactTextKind TextKindValue;
    u32[0 max] TextOrdinalValue;
    u32[0 max] ByteOffsetValue;
    u32[0 max] ByteLengthValue;

    LogicalPackageNativeMetadataFactTextRow()
    {
        self.TextKindValue = LogicalPackageNativeMetadataFactTextKind.NativeSource;
        self.TextOrdinalValue = 0;
        self.ByteOffsetValue = 0;
        self.ByteLengthValue = 0;
    }

    public inline finite law LogicalPackageNativeMetadataFactTextKind TextKind(
        borrow LogicalPackageNativeMetadataFactTextRow self)
    {
        return self.TextKindValue;
    }

    public inline finite law u32[0 max] TextOrdinal(
        borrow LogicalPackageNativeMetadataFactTextRow self)
    {
        return self.TextOrdinalValue;
    }

    public inline finite law u32[0 max] ByteOffset(
        borrow LogicalPackageNativeMetadataFactTextRow self)
    {
        return self.ByteOffsetValue;
    }

    public inline finite law u32[0 max] ByteLength(
        borrow LogicalPackageNativeMetadataFactTextRow self)
    {
        return self.ByteLengthValue;
    }
}

