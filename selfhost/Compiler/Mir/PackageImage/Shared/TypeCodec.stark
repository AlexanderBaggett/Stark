    out u32[0 max] regionRow)
{
    regionRow = 0;
    if (!graph.ParameterGroupRows.Contains(parameterGroupRow)
        || !graph.TextRows.Contains(parameterNameTextRow)
        || (hasStartExpression && !graph.TextRows.Contains(startExpressionTextRow))
        || (hasCountExpression && !graph.TextRows.Contains(countExpressionTextRow)))
    {
        return false;
    }

    stack LogicalPackageTypeReferenceParameterGroupRegionRow row =
        new LogicalPackageTypeReferenceParameterGroupRegionRow()
    {
        ParameterGroupRowValue = parameterGroupRow,
        RegionOrdinalValue = regionOrdinal,
        ParameterNameTextRowValue = parameterNameTextRow,
        StartExpressionTextRowValue = startExpressionTextRow,
        CountExpressionTextRowValue = countExpressionTextRow,
        HasStartExpressionValue = hasStartExpression,
        HasCountExpressionValue = hasCountExpression
    };
    stack u32[0 max] addedRegionRow = graph.ParameterGroupRegionRows.Add(row);
    if (addedRegionRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageTypeReferenceParameterGroupRow group = graph.ParameterGroupRows.Get(parameterGroupRow);
    if (group.RegionRowCountValue == 0)
    {
        group.FirstRegionRowValue = addedRegionRow;
    }
    else if (addedRegionRow != group.FirstRegionRowValue + group.RegionRowCountValue)
    {
        return false;
    }

    group.RegionRowCountValue = group.RegionRowCountValue + 1;
    if (!graph.ParameterGroupRows.Replace(parameterGroupRow, group))
    {
        return false;
    }

    regionRow = addedRegionRow;
    return true;
}

internal fn MemoryStatus LogicalPackageTypeReferenceGraphAppendText(
    mut borrow LogicalPackageTypeReferenceGraph graph,
    ascii text,
    out u32[0 max] byteOffset,
    out u32[0 max] byteLength)
{
    byteOffset = 0;
    byteLength = 0;
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength < 0 || signedLength > (i64[min max])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (graph.TextBytes.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || graph.TextBytes.Length + (u64[0 2 ** 63 - 1])signedLength > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    byteOffset = (u32[0 max])graph.TextBytes.Length;
    byteLength = (u32[0 max])signedLength;
    if (signedLength == 0)
    {
        return MemoryStatus.Ok;
    }

    unsafe
    {
        stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
        if (data == null)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        if (!graph.TextBytes.TryReserve((u64[0 2 ** 63 - 1])signedLength))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            init graph.TextBytes[graph.TextBytes.Length] = *(&data[index]);
        }
    }

    return MemoryStatus.Ok;
}

public fn MemoryStatus AppendLogicalPackageTypeReferenceText(
    borrow LogicalPackageTypeReferenceGraph graph,
    LogicalPackageTypeReferenceTextRow textRow,
    mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] start = (u64[0 2 ** 63 - 1])textRow.ByteOffsetValue;
    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])textRow.ByteLengthValue;
    if (start + length > graph.TextBytes.Length)
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < length)
    {
        try sink.AppendByte(graph.TextBytes[start + index]);
        index = index + 1;
    }

    return MemoryStatus.Ok;
}

public fn bool TryAppendLogicalPackageTypeReferenceText(
    borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] typeReferenceRow,
    LogicalPackageTypeReferenceTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow OwnedAscii sink)
{
    if (!graph.TypeReferenceRows.Contains(typeReferenceRow))
    {
        return false;
    }

    stack LogicalPackageTypeReferenceRow row = graph.TypeReferenceRows.Get(typeReferenceRow);
    stack mut u32[0 max] offset = 0;
    while willexit (offset < row.TextRowCountValue)
    {
        stack u32[0 max] textRowIndex = row.FirstTextRowValue + offset;
        if (!graph.TextRows.Contains(textRowIndex))
        {
            return false;
        }

        stack LogicalPackageTypeReferenceTextRow textRow = graph.TextRows.Get(textRowIndex);
        if (textRow.TextKindValue == textKind
            && textRow.TextOrdinalValue == textOrdinal)
        {
            return AppendLogicalPackageTypeReferenceText(graph, textRow, sink) == MemoryStatus.Ok;
        }

        offset = offset + 1;
    }

    return false;
}

public fn bool TryFindLogicalPackageTypeReferenceChild(
    borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] parentTypeReferenceRow,
    LogicalPackageTypeReferenceChildKind childKind,
    u32[0 max] childOrdinal,
    out u32[0 max] childTypeReferenceRow)
{
    childTypeReferenceRow = 0;
    if (!graph.TypeReferenceRows.Contains(parentTypeReferenceRow))
    {
        return false;
    }

    stack LogicalPackageTypeReferenceRow row = graph.TypeReferenceRows.Get(parentTypeReferenceRow);
    stack mut u32[0 max] offset = 0;
    while willexit (offset < row.ChildRowCountValue)
    {
        stack u32[0 max] childRowIndex = row.FirstChildRowValue + offset;
        if (!graph.ChildRows.Contains(childRowIndex))
        {
            return false;
        }

        stack LogicalPackageTypeReferenceChildRow child = graph.ChildRows.Get(childRowIndex);
        if (child.ChildKindValue == childKind
            && child.ChildOrdinalValue == childOrdinal)
        {
            stack u32[0 max] foundChildRow = child.ChildTypeReferenceRowValue;
            if (!graph.TypeReferenceRows.Contains(foundChildRow))
            {
                return false;
            }

            childTypeReferenceRow = foundChildRow;
            return true;
        }

        offset = offset + 1;
    }

    return false;
}

public fn bool TryFindLogicalPackageTypeReferenceComptimeValueArgument(
    borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] typeReferenceRow,
    u32[0 max] argumentOrdinal,
    out u32[0 max] argumentRow)
