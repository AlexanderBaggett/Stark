    stack LogicalPackageTypeReferenceRow row = graph.TypeReferenceRows.Get(typeReferenceRow);
    stack mut u32[0 max] offset = 0;
    while willexit (offset < row.ComptimeValueArgumentRowCountValue)
    {
        stack u32[0 max] argumentRowIndex = row.FirstComptimeValueArgumentRowValue + offset;
        if (!graph.ComptimeValueArgumentRows.Contains(argumentRowIndex))
        {
            return false;
        }

        stack LogicalPackageTypeReferenceComptimeValueArgumentRow argument =
            graph.ComptimeValueArgumentRows.Get(argumentRowIndex);
        if (argument.ArgumentOrdinalValue == argumentOrdinal)
        {
            argumentRow = argumentRowIndex;
            return true;
        }

        offset = offset + 1;
    }

    return false;
}

