import Compiler.Mir.Model
import Compiler.Mir.PackageImage.Models
import System.Memory
import System.Text
module Compiler.Mir.PackageImage.Shared.TypeCodec

// Stable one-byte encoding for MIR value types in legacy package sections.

internal fn u8[0 max] MirTypeToByte(MirType t)
{
    switch (t)
    {
        case MirType.I1: return 0;
        case MirType.I32: return 1;
        case MirType.I64: return 2;
        case MirType.Ptr: return 3;
        case MirType.I8: return 4;
        case MirType.I16: return 5;
        case MirType.EnumValue: return 6;
        case MirType.F32: return 7;
        case MirType.F64: return 8;
    }
}

internal fn MirType MirTypeFromByte(u8[0 max] b)
{
    switch (b)
    {
        case 0: return MirType.I1;
        case 1: return MirType.I32;
        case 3: return MirType.Ptr;
        case 4: return MirType.I8;
        case 5: return MirType.I16;
        case 6: return MirType.EnumValue;
        case 7: return MirType.F32;
        case 8: return MirType.F64;
        default: return MirType.I64;
    }
}

// Durable logical type-reference graph storage and lookup helpers.

internal fn bool LogicalPackageTypeReferenceGraphAddTextRowWithId(
    mut borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] typeReferenceRow,
    LogicalPackageTypeReferenceTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u32[0 max] byteOffset = 0;
    stack mut u32[0 max] byteLength = 0;
    switch (LogicalPackageTypeReferenceGraphAppendText(graph, text, byteOffset, byteLength))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            stack LogicalPackageTypeReferenceTextRow row = new LogicalPackageTypeReferenceTextRow()
            {
                TypeReferenceRowValue = typeReferenceRow,
                TextKindValue = textKind,
                TextOrdinalValue = textOrdinal,
                ByteOffsetValue = byteOffset,
                ByteLengthValue = byteLength
            };
            textRow = graph.TextRows.Add(row);
            return textRow != 0;
    }
}

internal fn bool LogicalPackageTypeReferenceGraphAddTextRow(
    mut borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] typeReferenceRow,
    LogicalPackageTypeReferenceTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text)
{
    stack mut u32[0 max] textRow = 0;
    return LogicalPackageTypeReferenceGraphAddTextRowWithId(
        graph,
        typeReferenceRow,
        textKind,
        textOrdinal,
        text,
        textRow);
}

internal fn bool LogicalPackageTypeReferenceGraphSetComptimeValueArgumentTypeChild(
    mut borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] parentRow,
    u32[0 max] childOrdinal,
    u32[0 max] childRow)
{
    if (!graph.TypeReferenceRows.Contains(parentRow)
        || !graph.TypeReferenceRows.Contains(childRow))
    {
        return false;
    }

    stack LogicalPackageTypeReferenceRow parent = graph.TypeReferenceRows.Get(parentRow);
    stack mut u32[0 max] offset = 0;
    while willexit (offset < parent.ComptimeValueArgumentRowCountValue)
    {
        stack u32[0 max] argumentRowIndex = parent.FirstComptimeValueArgumentRowValue + offset;
        if (!graph.ComptimeValueArgumentRows.Contains(argumentRowIndex))
        {
            return false;
        }

        stack mut LogicalPackageTypeReferenceComptimeValueArgumentRow argument =
            graph.ComptimeValueArgumentRows.Get(argumentRowIndex);
        if (argument.ArgumentOrdinalValue == childOrdinal)
        {
            argument.TypeChildTypeReferenceRowValue = childRow;
            return graph.ComptimeValueArgumentRows.Replace(argumentRowIndex, argument);
        }

        offset = offset + 1;
    }

    return false;
}

internal fn bool LogicalPackageTypeReferenceGraphAddChildRow(
    mut borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] parentRow,
    u32[0 max] childRow,
    LogicalPackageTypeReferenceChildKind childKind,
    u32[0 max] childOrdinal)
{
    if (!graph.TypeReferenceRows.Contains(parentRow)
        || !graph.TypeReferenceRows.Contains(childRow))
    {
        return false;
    }

    stack LogicalPackageTypeReferenceChildRow child = new LogicalPackageTypeReferenceChildRow()
    {
        ParentTypeReferenceRowValue = parentRow,
        ChildTypeReferenceRowValue = childRow,
        ChildKindValue = childKind,
        ChildOrdinalValue = childOrdinal
    };
    stack u32[0 max] childLinkRow = graph.ChildRows.Add(child);
    if (childLinkRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageTypeReferenceRow parent = graph.TypeReferenceRows.Get(parentRow);
    if (parent.ChildRowCountValue == 0)
    {
        parent.FirstChildRowValue = childLinkRow;
    }
    else if (childLinkRow != parent.FirstChildRowValue + parent.ChildRowCountValue)
    {
        return false;
    }

    parent.ChildRowCountValue = parent.ChildRowCountValue + 1;
    if (!graph.TypeReferenceRows.Replace(parentRow, parent))
    {
        return false;
    }

    if (childKind == LogicalPackageTypeReferenceChildKind.ComptimeValueArgumentType)
    {
        return LogicalPackageTypeReferenceGraphSetComptimeValueArgumentTypeChild(
            graph,
            parentRow,
            childOrdinal,
            childRow);
    }

    return true;
}

internal fn bool LogicalPackageTypeReferenceGraphAddComptimeValueArgumentRow(
    mut borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] typeReferenceRow,
    u32[0 max] argumentOrdinal,
    u32[0 max] parameterNameTextRow,
    u32[0 max] integerValueTextRow,
    bool isSymbolic,
    bool hasSymbolicSourceName,
    u32[0 max] symbolicSourceNameTextRow,
    out u32[0 max] argumentRow)
{
    argumentRow = 0;
    if (!graph.TypeReferenceRows.Contains(typeReferenceRow)
        || !graph.TextRows.Contains(parameterNameTextRow)
        || !graph.TextRows.Contains(integerValueTextRow)
        || (hasSymbolicSourceName && !graph.TextRows.Contains(symbolicSourceNameTextRow)))
    {
        return false;
    }

    stack LogicalPackageTypeReferenceComptimeValueArgumentRow row =
        new LogicalPackageTypeReferenceComptimeValueArgumentRow()
    {
        TypeReferenceRowValue = typeReferenceRow,
        ArgumentOrdinalValue = argumentOrdinal,
        ParameterNameTextRowValue = parameterNameTextRow,
        IntegerValueTextRowValue = integerValueTextRow,
        SymbolicSourceNameTextRowValue = symbolicSourceNameTextRow,
        IsSymbolicValue = isSymbolic,
        HasSymbolicSourceNameValue = hasSymbolicSourceName
    };
    stack u32[0 max] addedArgumentRow = graph.ComptimeValueArgumentRows.Add(row);
    if (addedArgumentRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageTypeReferenceRow parent = graph.TypeReferenceRows.Get(typeReferenceRow);
    if (parent.ComptimeValueArgumentRowCountValue == 0)
    {
        parent.FirstComptimeValueArgumentRowValue = addedArgumentRow;
    }
    else if (addedArgumentRow != parent.FirstComptimeValueArgumentRowValue + parent.ComptimeValueArgumentRowCountValue)
    {
        return false;
    }

    parent.ComptimeValueArgumentRowCountValue = parent.ComptimeValueArgumentRowCountValue + 1;
    if (!graph.TypeReferenceRows.Replace(typeReferenceRow, parent))
    {
        return false;
    }

    argumentRow = addedArgumentRow;
    return true;
}

