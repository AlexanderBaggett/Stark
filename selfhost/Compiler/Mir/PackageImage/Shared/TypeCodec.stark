internal fn bool LogicalPackageTypeReferenceGraphAddParameterGroupRegionRow(
    mut borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] parameterGroupRow,
    u32[0 max] regionOrdinal,
    u32[0 max] parameterNameTextRow,
    bool hasStartExpression,
