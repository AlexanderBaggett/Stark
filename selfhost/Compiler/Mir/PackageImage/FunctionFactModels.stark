public struct LogicalPackageFunctionOwnershipFactGraph
{
    internal dynamic i8[min max] TextBytes;
    internal IrTable<LogicalPackageFunctionOwnershipFactTextRow> TextRows;
    internal IrTable<LogicalPackageFunctionOwnershipRow> FunctionOwnershipRows;
    internal IrTable<LogicalPackageFunctionOwnershipNameRow> ImplicitDropRows;
    internal IrTable<LogicalPackageFunctionOwnershipNameRow> MoveRows;
    internal IrTable<LogicalPackageFunctionOwnershipEventRow> EventRows;
    internal IrTable<LogicalPackageFunctionOwnershipProjectionRow> ProjectionRows;
    internal IrTable<LogicalPackageFunctionOwnershipRootRow> RootRows;
    internal LogicalPackageTypeReferenceGraph TypeReferences;

    LogicalPackageFunctionOwnershipFactGraph()
    {
        self.TextBytes = new();
        self.TextRows = new();
        self.FunctionOwnershipRows = new();
        self.ImplicitDropRows = new();
        self.MoveRows = new();
        self.EventRows = new();
        self.ProjectionRows = new();
        self.RootRows = new();
        self.TypeReferences = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] TextByteCount(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.TextBytes.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] TextRowCount(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.TextRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] FunctionOwnershipRowCount(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.FunctionOwnershipRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] ImplicitDropRowCount(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.ImplicitDropRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] MoveRowCount(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.MoveRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] EventRowCount(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.EventRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] ProjectionRowCount(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.ProjectionRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] RootRowCount(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.RootRows.Count();
    }

    public inline finite law u64[0 2 ** 63 - 1] TypeReferenceCount(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.TypeReferences.TypeReferenceCount();
    }

    public finite law retborrow LogicalPackageTypeReferenceGraph TypeReferenceGraph(
        borrow LogicalPackageFunctionOwnershipFactGraph self)
    {
        return self.TypeReferences;
    }

    public finite law retborrow LogicalPackageFunctionOwnershipFactTextRow TextRowAt(
        borrow LogicalPackageFunctionOwnershipFactGraph self,
        u32[0 max] row)
    {
        return self.TextRows.Get(row);
    }

    public finite law retborrow LogicalPackageFunctionOwnershipRow FunctionOwnershipRowAt(
        borrow LogicalPackageFunctionOwnershipFactGraph self,
        u32[0 max] row)
    {
        return self.FunctionOwnershipRows.Get(row);
    }

    public finite law retborrow LogicalPackageFunctionOwnershipNameRow ImplicitDropRowAt(
        borrow LogicalPackageFunctionOwnershipFactGraph self,
        u32[0 max] row)
    {
        return self.ImplicitDropRows.Get(row);
    }

    public finite law retborrow LogicalPackageFunctionOwnershipNameRow MoveRowAt(
        borrow LogicalPackageFunctionOwnershipFactGraph self,
        u32[0 max] row)
    {
        return self.MoveRows.Get(row);
    }

    public finite law retborrow LogicalPackageFunctionOwnershipEventRow EventRowAt(
        borrow LogicalPackageFunctionOwnershipFactGraph self,
        u32[0 max] row)
    {
        return self.EventRows.Get(row);
    }

    public finite law retborrow LogicalPackageFunctionOwnershipProjectionRow ProjectionRowAt(
        borrow LogicalPackageFunctionOwnershipFactGraph self,
        u32[0 max] row)
    {
        return self.ProjectionRows.Get(row);
    }

    public finite law retborrow LogicalPackageFunctionOwnershipRootRow RootRowAt(
        borrow LogicalPackageFunctionOwnershipFactGraph self,
        u32[0 max] row)
    {
        return self.RootRows.Get(row);
    }

    public finite law retborrow LogicalPackageTypeReferenceRow TypeReferenceAt(
        borrow LogicalPackageFunctionOwnershipFactGraph self,
        u32[0 max] row)
    {
        return self.TypeReferences.TypeReferenceAt(row);
    }
}

