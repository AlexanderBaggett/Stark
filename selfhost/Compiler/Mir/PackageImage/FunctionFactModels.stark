import Compiler.Ir
import Compiler.Mir.PackageImage.ModelKinds
import Compiler.Mir.PackageImage.BackendFactModels
module Compiler.Mir.PackageImage.FunctionFactModels

// Function ownership and semantic fact carriers. Place/type references remain
// linked to the shared type-reference graph by stable row identity.

public struct LogicalPackageFunctionOwnershipFactTextRow
{
    LogicalPackageFunctionOwnershipFactTextKind TextKindValue;
    u32[0 max] TextOrdinalValue;
    u32[0 max] ByteOffsetValue;
    u32[0 max] ByteLengthValue;

    LogicalPackageFunctionOwnershipFactTextRow()
    {
        self.TextKindValue = LogicalPackageFunctionOwnershipFactTextKind.QualifiedResolvedName;
        self.TextOrdinalValue = 0;
        self.ByteOffsetValue = 0;
        self.ByteLengthValue = 0;
    }

    public inline finite law LogicalPackageFunctionOwnershipFactTextKind TextKind(
        borrow LogicalPackageFunctionOwnershipFactTextRow self)
    {
        return self.TextKindValue;
    }

    public inline finite law u32[0 max] TextOrdinal(
        borrow LogicalPackageFunctionOwnershipFactTextRow self)
    {
        return self.TextOrdinalValue;
    }

    public inline finite law u32[0 max] ByteOffset(
        borrow LogicalPackageFunctionOwnershipFactTextRow self)
    {
        return self.ByteOffsetValue;
    }

    public inline finite law u32[0 max] ByteLength(
        borrow LogicalPackageFunctionOwnershipFactTextRow self)
    {
        return self.ByteLengthValue;
    }
}

