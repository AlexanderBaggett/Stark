    stack mut IrTable<u8[0 max]> blockBuf = new();
    SerializeBlocks(blocks, blockBuf);
    stack mut IrTable<u8[0 max]> funcBuf = new();
    SerializeFunctions(funcs, funcBuf);
    stack mut IrTable<u8[0 max]> globalBuf = new();
    SerializeGlobals(globals, globalBuf);
    stack mut IrTable<u8[0 max]> asmBuf = new();
    SerializeAsmMetadata(asmMetadata, asmBuf);

    stack u32[0 max] sectionCount = 5;
    stack u64[0 max] instrOffset = PackageImageDataOffset(sectionCount);
    stack u64[0 max] blockOffset = instrOffset + (u64[0 max])instrBuf.Count();
    stack u64[0 max] funcOffset = blockOffset + (u64[0 max])blockBuf.Count();
    stack u64[0 max] globalOffset = funcOffset + (u64[0 max])funcBuf.Count();
    stack u64[0 max] asmOffset = globalOffset + (u64[0 max])globalBuf.Count();
    stack u64[0 max] totalLength = asmOffset + (u64[0 max])asmBuf.Count();
    stack bool reserved = TryReservePackageImageCapacity(buf, totalLength);

    WriteSectionedPackageImageHeader(buf, sectionCount);
    WritePackageSectionDirectoryEntry(buf, PackageSectionInstructions(), SectionFlagsRequired(), instrOffset, (u64[0 max])instrBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionBlocks(), SectionFlagsRequired(), blockOffset, (u64[0 max])blockBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionFunctions(), SectionFlagsRequired(), funcOffset, (u64[0 max])funcBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionGlobals(), SectionFlagsRequired(), globalOffset, (u64[0 max])globalBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionAsmMetadata(), SectionFlagsRequired(), asmOffset, (u64[0 max])asmBuf.Count(), SectionEncodingRaw());
    AppendBytes(buf, instrBuf);
    AppendBytes(buf, blockBuf);
    AppendBytes(buf, funcBuf);
    AppendBytes(buf, globalBuf);
    AppendBytes(buf, asmBuf);
}

