    internal fn bool AddSourceSurfaceTypeField(
        mut borrow LogicalPackageManifestJsonSourceSurfaceBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] typeRow,
        ascii name,
        ascii typeText,
        ascii visibility,
        bool hasVisibility,
        u32[0 max] explicitOffsetBytes,
        bool hasExplicitOffsetBytes,
        u32[0 max] threadSafetyLawAttributeCount)
    {
        if (!self.SourceSurfaceTypeRows.Contains(typeRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonSourceSurfaceTypeRow typeFacts = self.SourceSurfaceTypeRows.Get(typeRow);
        if (typeFacts.FieldCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
