        stack mut u32[0 max] nameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] typeStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] visibilityStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, name, nameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, typeText, typeStringIndex))
        {
            return false;
        }

        if (hasVisibility
            && !LogicalPackageImageStringTableBuilderTryAdd(strings, visibility, visibilityStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonSourceSurfaceTypeFieldRow row =
            new LogicalPackageManifestJsonSourceSurfaceTypeFieldRow()
            {
                NameStringIndex = nameStringIndex,
                TypeStringIndex = typeStringIndex,
                VisibilityStringIndex = visibilityStringIndex,
                ThreadSafetyLawAttributeCount = threadSafetyLawAttributeCount,
                ExplicitOffsetBytes = explicitOffsetBytes,
                HasVisibility = hasVisibility,
                HasExplicitOffsetBytes = hasExplicitOffsetBytes
            };
        stack u32[0 max] rowIndex = self.SourceSurfaceTypeFieldRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (typeFacts.FieldCount == 0)
        {
            typeFacts.FieldFirstRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = typeFacts.FieldLastRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonSourceSurfaceTypeFieldRow lastRow =
                self.SourceSurfaceTypeFieldRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.SourceSurfaceTypeFieldRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        typeFacts.FieldLastRow = rowIndex;
        typeFacts.FieldCount = typeFacts.FieldCount + 1;
        return self.SourceSurfaceTypeRows.Replace(typeRow, typeFacts);
    }

