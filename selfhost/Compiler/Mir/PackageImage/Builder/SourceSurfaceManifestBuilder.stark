        stack u32[0 max] rowIndex = self.SourceSurfaceFunctionParameterRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (function.ParameterCount == 0)
        {
            function.ParameterFirstRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = function.ParameterLastRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonSourceSurfaceFunctionParameterRow lastRow =
                self.SourceSurfaceFunctionParameterRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.SourceSurfaceFunctionParameterRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        function.ParameterLastRow = rowIndex;
        function.ParameterCount = function.ParameterCount + 1;
        return self.SourceSurfaceFunctionRows.Replace(functionRow, function);
    }

