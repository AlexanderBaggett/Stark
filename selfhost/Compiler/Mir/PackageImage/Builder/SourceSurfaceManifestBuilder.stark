    internal fn bool AddModule(mut borrow LogicalPackageManifestJsonSourceSurfaceBuilder self)
    {
        return self.ModuleRows.Add(false) != 0
            && self.SourceSurfaceImportFirstRows.Add(0) != 0
            && self.SourceSurfaceImportLastRows.Add(0) != 0
            && self.SourceSurfaceImportCounts.Add(0) != 0
            && self.SourceSurfaceReExportFirstRows.Add(0) != 0
            && self.SourceSurfaceReExportLastRows.Add(0) != 0
            && self.SourceSurfaceReExportCounts.Add(0) != 0
            && self.SourceSurfaceTypeAliasFirstRows.Add(0) != 0
            && self.SourceSurfaceTypeAliasLastRows.Add(0) != 0
            && self.SourceSurfaceTypeAliasCounts.Add(0) != 0
            && self.SourceSurfaceTypeFirstRows.Add(0) != 0
            && self.SourceSurfaceTypeLastRows.Add(0) != 0
            && self.SourceSurfaceTypeCounts.Add(0) != 0
            && self.SourceSurfaceGlobalFirstRows.Add(0) != 0
            && self.SourceSurfaceGlobalLastRows.Add(0) != 0
            && self.SourceSurfaceGlobalCounts.Add(0) != 0
            && self.SourceSurfaceFunctionFirstRows.Add(0) != 0
            && self.SourceSurfaceFunctionLastRows.Add(0) != 0
            && self.SourceSurfaceFunctionCounts.Add(0) != 0;
    }

    internal fn bool AddSourceSurfaceImport(
        mut borrow LogicalPackageManifestJsonSourceSurfaceBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] moduleOrdinal,
        ascii moduleName,
        bool isExported)
    {
        stack u32[0 max] moduleRow = moduleOrdinal + 1;
        if (!self.ModuleRows.Contains(moduleRow))
        {
            return false;
        }

        stack u32[0 max] count = self.SourceSurfaceImportCounts.Get(moduleRow);
        if (count == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] stringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, moduleName, stringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonSourceSurfaceImportRow row =
            new LogicalPackageManifestJsonSourceSurfaceImportRow()
            {
                ModuleNameStringIndex = stringIndex,
                IsExported = isExported
            };
        stack u32[0 max] rowIndex = self.SourceSurfaceImportRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (count == 0 && !self.SourceSurfaceImportFirstRows.Replace(moduleRow, rowIndex))
        {
            return false;
        }
        else if (count != 0)
        {
            stack u32[0 max] lastRowIndex = self.SourceSurfaceImportLastRows.Get(moduleRow);
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonSourceSurfaceImportRow lastRow =
                self.SourceSurfaceImportRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.SourceSurfaceImportRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        return self.SourceSurfaceImportLastRows.Replace(moduleRow, rowIndex)
            && self.SourceSurfaceImportCounts.Replace(moduleRow, count + 1);
    }

