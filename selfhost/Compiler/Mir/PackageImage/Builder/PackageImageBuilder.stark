internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteNativeDependencyArray(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    ascii memberName,
    u32[0 max] firstRow,
    u32[0 max] dependencyCount,
    mut borrow OwnedAscii scratch)
{
    if (dependencyCount == 0)
    {
        return JsonStatus.Ok;
    }

    stack JsonStatus keyStatus = writer.Key(memberName);
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginArray();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] dependencyRow = firstRow;
    stack mut u32[0 max] remainingDependencies = dependencyCount;
    while willexit (remainingDependencies != 0)
    {
        if (dependencyRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack LogicalPackageManifestJsonNativeDependencyRow rowFacts =
            manifestBuilder.CompilerFacts.NativeDependencyRows.Get(dependencyRow);
        stack JsonStatus valueStatus = LogicalPackageImageStringTableBuilderWriteTextValue(
            manifestBuilder.Strings,
            rowFacts.TextStringIndex,
            writer,
            scratch);
        switch (valueStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        dependencyRow = rowFacts.NextRow;
        remainingDependencies = remainingDependencies - 1;
    }

    return writer.EndArray();
}

internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteNativeDependenciesMember(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    mut borrow OwnedAscii scratch)
{
    if (manifestBuilder.CompilerFacts.NativeSourceDependencyCount == 0
        && manifestBuilder.CompilerFacts.NativeIncludeDirectoryDependencyCount == 0
        && manifestBuilder.CompilerFacts.NativeLibraryDirectoryDependencyCount == 0
        && manifestBuilder.CompilerFacts.NativeLibraryDependencyCount == 0
        && manifestBuilder.CompilerFacts.NativeLinkArgumentDependencyCount == 0
        && manifestBuilder.CompilerFacts.NativePkgConfigPackageDependencyCount == 0)
    {
        return JsonStatus.Ok;
    }

    stack JsonStatus keyStatus = writer.Key("NativeDependencies");
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginObject();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus sourcesStatus = LogicalPackageManifestJsonWriteNativeDependencyArray(
        writer,
        manifestBuilder,
        "Sources",
        manifestBuilder.CompilerFacts.NativeSourceDependencyFirstRow,
        manifestBuilder.CompilerFacts.NativeSourceDependencyCount,
        scratch);
    switch (sourcesStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus includeStatus = LogicalPackageManifestJsonWriteNativeDependencyArray(
        writer,
        manifestBuilder,
        "IncludeDirectories",
        manifestBuilder.CompilerFacts.NativeIncludeDirectoryDependencyFirstRow,
        manifestBuilder.CompilerFacts.NativeIncludeDirectoryDependencyCount,
        scratch);
    switch (includeStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus libraryDirectoryStatus = LogicalPackageManifestJsonWriteNativeDependencyArray(
        writer,
        manifestBuilder,
        "LibraryDirectories",
        manifestBuilder.CompilerFacts.NativeLibraryDirectoryDependencyFirstRow,
        manifestBuilder.CompilerFacts.NativeLibraryDirectoryDependencyCount,
        scratch);
    switch (libraryDirectoryStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus librariesStatus = LogicalPackageManifestJsonWriteNativeDependencyArray(
        writer,
        manifestBuilder,
        "Libraries",
        manifestBuilder.CompilerFacts.NativeLibraryDependencyFirstRow,
        manifestBuilder.CompilerFacts.NativeLibraryDependencyCount,
        scratch);
    switch (librariesStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus linkArgumentsStatus = LogicalPackageManifestJsonWriteNativeDependencyArray(
        writer,
        manifestBuilder,
        "LinkArguments",
        manifestBuilder.CompilerFacts.NativeLinkArgumentDependencyFirstRow,
        manifestBuilder.CompilerFacts.NativeLinkArgumentDependencyCount,
        scratch);
    switch (linkArgumentsStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus pkgConfigStatus = LogicalPackageManifestJsonWriteNativeDependencyArray(
        writer,
        manifestBuilder,
        "PkgConfigPackages",
        manifestBuilder.CompilerFacts.NativePkgConfigPackageDependencyFirstRow,
        manifestBuilder.CompilerFacts.NativePkgConfigPackageDependencyCount,
        scratch);
    switch (pkgConfigStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    return writer.EndObject();
}

public unsafe fn JsonStatus WriteLogicalPackageManifestJson(
    mut borrow JsonWriter writer,
    borrow LogicalPackageImageBuilder packageBuilder,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder)
{
    if (!LogicalPackageImageBuilderHasString(packageBuilder.RootModuleStringIndexValue)
        || !LogicalPackageImageBuilderHasString(packageBuilder.LibraryFileNameStringIndexValue)
        || !LogicalPackageImageBuilderTargetFactsAreValid(packageBuilder)
        || manifestBuilder.ModuleCount() == 0
        || !LogicalPackageManifestJsonBuilderContainsPackageString(
            manifestBuilder,
            packageBuilder.Strings,
            packageBuilder.RootModuleStringIndexValue))
    {
        return JsonStatus.Err(JsonError.InvalidValue);
    }

    stack mut OwnedAscii scratch = new();
    stack JsonStatus beginStatus = writer.BeginObject();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus rootStatus = LogicalPackageManifestJsonWriteStringMember(
        writer,
        "RootModule",
        packageBuilder.Strings,
        packageBuilder.RootModuleStringIndexValue,
        scratch);
    switch (rootStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus libraryStatus = LogicalPackageManifestJsonWriteStringMember(
        writer,
        "LibraryFileName",
        packageBuilder.Strings,
        packageBuilder.LibraryFileNameStringIndexValue,
        scratch);
    switch (libraryStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus nativeDependenciesStatus = LogicalPackageManifestJsonWriteNativeDependenciesMember(
        writer,
        manifestBuilder,
        scratch);
    switch (nativeDependenciesStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus modulesKeyStatus = writer.Key("Modules");
    switch (modulesKeyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginModulesStatus = writer.BeginArray();
    switch (beginModulesStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] moduleCount = manifestBuilder.ModuleNameStringIndexes.Count();
    stack mut u32[0 max] moduleRow = 1;
    while willexit ((u64[0 2 ** 63 - 1])moduleRow <= moduleCount)
    {
        stack JsonStatus moduleStatus = LogicalPackageManifestJsonWriteModuleShell(
            writer,
            manifestBuilder,
            moduleRow,
            scratch);
        switch (moduleStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        moduleRow = moduleRow + 1;
    }

    stack JsonStatus endModulesStatus = writer.EndArray();
    switch (endModulesStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    if (packageBuilder.HasTargetValue)
    {
        stack JsonStatus targetStatus = LogicalPackageManifestJsonWriteTargetMember(writer, packageBuilder, scratch);
        switch (targetStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (LogicalStringIndexIsPresent(packageBuilder.BuildProfileStringIndexValue))
    {
        stack JsonStatus buildProfileKeyStatus = writer.Key("BuildProfile");
        switch (buildProfileKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginBuildProfileStatus = writer.BeginObject();
        switch (beginBuildProfileStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus profileNameStatus = LogicalPackageManifestJsonWriteStringMember(
            writer,
            "Name",
            packageBuilder.Strings,
            packageBuilder.BuildProfileStringIndexValue,
            scratch);
        switch (profileNameStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus endBuildProfileStatus = writer.EndObject();
        switch (endBuildProfileStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    return writer.EndObject();
}

public unsafe fn bool TryEncodeLogicalPackageManifestJson(
    borrow LogicalPackageImageBuilder packageBuilder,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    mut borrow IrTable<u8[0 max]> payload)
{
    if (!payload.IsEmpty())
    {
        return false;
    }

    stack mut JsonWriter writer = new();
    switch (WriteLogicalPackageManifestJson(writer, packageBuilder, manifestBuilder))
    {
        case JsonStatus.Err(var error):
            return false;
        case JsonStatus.Ok:
    }

    stack ascii manifestJson = writer.View();
    stack i64[min max] signedLength = System.Text.AsciiLength(manifestJson);
    if (signedLength <= 0 || signedLength > (i64[min max])(2 ** 32 - 1))
    {
        return false;
    }

    switch (payload.Reserve((u64[0 2 ** 63 - 1])signedLength))
    {
        case MemoryStatus.Err(var reserveError):
            return false;
        case MemoryStatus.Ok:
    }

    stack rawptr<i8[min max]> data = System.Text.AsciiData(manifestJson);
    if (data == null)
    {
        return false;
    }

    stack mut i64[min max] index = 0;
    while willexit (index < signedLength)
    {
        if (payload.Add(ImageByteFromI8(*(&data[index]))) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}


public unsafe fn bool TryEncodeLogicalPackageManifestBrotliJson(
    borrow LogicalPackageImageBuilder packageBuilder,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    mut borrow IrTable<u8[0 max]> payload)
{
    if (!payload.IsEmpty())
    {
        return false;
    }

    stack mut IrTable<u8[0 max]> manifestJson = new();
    if (!TryEncodeLogicalPackageManifestJson(packageBuilder, manifestBuilder, manifestJson))
    {
        return false;
    }

    return TryEncodeBrotliUtf8JsonPayload(manifestJson, payload);
}
