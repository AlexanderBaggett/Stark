    stack u64[0 2 ** 63 - 1] featureCount = packageBuilder.TargetFeatureStringIndexes.Count();
    stack mut u32[0 max] featureRow = 1;
    while willexit ((u64[0 2 ** 63 - 1])featureRow <= featureCount)
