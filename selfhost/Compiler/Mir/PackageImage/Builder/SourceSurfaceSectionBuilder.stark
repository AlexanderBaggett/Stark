internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteSourceSurfaceImportRow(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    u32[0 max] row,
    mut borrow OwnedAscii scratch)
{
    stack LogicalPackageManifestJsonSourceSurfaceImportRow importRow =
        manifestBuilder.SourceSurface.SourceSurfaceImportRows.Get(row);
    stack JsonStatus beginStatus = writer.BeginObject();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus moduleNameStatus = LogicalPackageManifestJsonWriteStringMember(
        writer,
        "ModuleName",
        manifestBuilder.Strings,
        importRow.ModuleNameStringIndex,
        scratch);
    switch (moduleNameStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus exportedStatus = LogicalPackageManifestJsonWriteBoolMember(
        writer,
        "IsExported",
        importRow.IsExported);
    switch (exportedStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    return writer.EndObject();
}

