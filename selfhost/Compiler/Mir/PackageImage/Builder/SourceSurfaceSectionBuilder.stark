        switch (abiStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.HasBackendOptimizationMode)
    {
        stack JsonStatus modeStatus = LogicalPackageManifestJsonWriteStringMember(
            writer,
            "BackendOptimizationMode",
            manifestBuilder.Strings,
            functionRow.BackendOptimizationModeStringIndex,
            scratch);
        switch (modeStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.HasLinkName)
    {
        stack JsonStatus linkStatus = LogicalPackageManifestJsonWriteStringMember(
            writer,
            "LinkName",
            manifestBuilder.Strings,
            functionRow.LinkNameStringIndex,
            scratch);
        switch (linkStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.HasAsm)
    {
        stack JsonStatus asmKeyStatus = writer.Key("Asm");
        switch (asmKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginAsmStatus = writer.BeginObject();
        switch (beginAsmStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus endAsmStatus = writer.EndObject();
        switch (endAsmStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.IsHot)
    {
        stack JsonStatus hotStatus = LogicalPackageManifestJsonWriteBoolMember(writer, "IsHot", true);
        switch (hotStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.IsCold)
    {
        stack JsonStatus coldStatus = LogicalPackageManifestJsonWriteBoolMember(writer, "IsCold", true);
        switch (coldStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.HasExplicitInlinePreference)
    {
        stack JsonStatus explicitInlineStatus = LogicalPackageManifestJsonWriteBoolMember(
            writer,
            "HasExplicitInlinePreference",
            true);
        switch (explicitInlineStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.IsUnsafe)
    {
        stack JsonStatus unsafeStatus = LogicalPackageManifestJsonWriteBoolMember(writer, "IsUnsafe", true);
        switch (unsafeStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.IsVarargs)
    {
        stack JsonStatus varargsStatus = LogicalPackageManifestJsonWriteBoolMember(writer, "IsVarargs", true);
        switch (varargsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.IsTailCallable)
    {
        stack JsonStatus tailStatus = LogicalPackageManifestJsonWriteBoolMember(writer, "IsTailCallable", true);
        switch (tailStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.TypeParameterConstraintCount != 0)
    {
        stack JsonStatus constraintsStatus = LogicalPackageManifestJsonWriteEmptyObjectArrayMember(
            writer,
            "TypeParameterConstraints",
            functionRow.TypeParameterConstraintCount);
        switch (constraintsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.ThreadSafetyLawPredicateCount != 0)
    {
        stack JsonStatus lawsStatus = LogicalPackageManifestJsonWriteEmptyObjectArrayMember(
            writer,
            "ThreadSafetyLawPredicates",
            functionRow.ThreadSafetyLawPredicateCount);
        switch (lawsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.ValueContractCount != 0)
    {
        stack JsonStatus contractsStatus = LogicalPackageManifestJsonWriteEmptyObjectArrayMember(
            writer,
            "ValueContracts",
            functionRow.ValueContractCount);
        switch (contractsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.DisjointParameterGroupCount != 0)
    {
        stack JsonStatus disjointStatus = LogicalPackageManifestJsonWriteEmptyObjectArrayMember(
            writer,
            "DisjointParameterGroups",
            functionRow.DisjointParameterGroupCount);
        switch (disjointStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.OverlapParameterGroupCount != 0)
    {
        stack JsonStatus overlapStatus = LogicalPackageManifestJsonWriteEmptyObjectArrayMember(
            writer,
            "OverlapParameterGroups",
            functionRow.OverlapParameterGroupCount);
        switch (overlapStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.SameParameterGroupCount != 0)
    {
        stack JsonStatus sameStatus = LogicalPackageManifestJsonWriteEmptyObjectArrayMember(
            writer,
            "SameParameterGroups",
            functionRow.SameParameterGroupCount);
        switch (sameStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionRow.PointeeDeadOnReturnParameterNameCount != 0)
    {
        stack JsonStatus deadKeyStatus = writer.Key("PointeeDeadOnReturnParameterNames");
        switch (deadKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginDeadStatus = writer.BeginArray();
        switch (beginDeadStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack mut u32[0 max] deadRow = functionRow.PointeeDeadOnReturnParameterNameFirstRow;
        stack mut u32[0 max] remainingDeadNames = functionRow.PointeeDeadOnReturnParameterNameCount;
        while willexit (remainingDeadNames != 0)
        {
            if (deadRow == 0)
            {
                return JsonStatus.Err(JsonError.InvalidValue);
            }

            stack LogicalPackageManifestJsonSourceSurfaceFunctionDeadParameterNameRow deadFacts =
                manifestBuilder.SourceSurface.SourceSurfaceFunctionDeadParameterNameRows.Get(deadRow);
            stack JsonStatus deadStatus = LogicalPackageImageStringTableBuilderWriteTextValue(
                manifestBuilder.Strings,
                deadFacts.NameStringIndex,
                writer,
                scratch);
            switch (deadStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }

            deadRow = deadFacts.NextRow;
            remainingDeadNames = remainingDeadNames - 1;
        }

        stack JsonStatus endDeadStatus = writer.EndArray();
        switch (endDeadStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    return writer.EndObject();
}

internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteSourceSurfaceMember(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    u32[0 max] moduleRow,
    mut borrow OwnedAscii scratch)
{
    stack u32[0 max] importCount = manifestBuilder.SourceSurface.SourceSurfaceImportCounts.Get(moduleRow);
    stack u32[0 max] reExportCount = manifestBuilder.SourceSurface.SourceSurfaceReExportCounts.Get(moduleRow);
    stack u32[0 max] typeAliasCount = manifestBuilder.SourceSurface.SourceSurfaceTypeAliasCounts.Get(moduleRow);
    stack u32[0 max] typeCount = manifestBuilder.SourceSurface.SourceSurfaceTypeCounts.Get(moduleRow);
    stack u32[0 max] globalCount = manifestBuilder.SourceSurface.SourceSurfaceGlobalCounts.Get(moduleRow);
    stack u32[0 max] functionCount = manifestBuilder.SourceSurface.SourceSurfaceFunctionCounts.Get(moduleRow);
    if (importCount == 0
        && reExportCount == 0
        && typeAliasCount == 0
        && typeCount == 0
        && globalCount == 0
        && functionCount == 0)
    {
        return JsonStatus.Ok;
    }

    stack JsonStatus keyStatus = writer.Key("SourceSurface");
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginObject();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    if (importCount != 0)
    {
        stack JsonStatus importsKeyStatus = writer.Key("Imports");
        switch (importsKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginImportsStatus = writer.BeginArray();
        switch (beginImportsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack mut u32[0 max] importRow = manifestBuilder.SourceSurface.SourceSurfaceImportFirstRows.Get(moduleRow);
        stack mut u32[0 max] remainingImports = importCount;
        while willexit (remainingImports != 0)
        {
            if (importRow == 0)
            {
                return JsonStatus.Err(JsonError.InvalidValue);
            }

            stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteSourceSurfaceImportRow(
                writer,
                manifestBuilder,
                importRow,
                scratch);
            switch (rowStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }

            stack LogicalPackageManifestJsonSourceSurfaceImportRow rowFacts =
                manifestBuilder.SourceSurface.SourceSurfaceImportRows.Get(importRow);
            importRow = rowFacts.NextRow;
            remainingImports = remainingImports - 1;
        }

        stack JsonStatus endImportsStatus = writer.EndArray();
        switch (endImportsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (reExportCount != 0)
    {
        stack JsonStatus reExportsKeyStatus = writer.Key("ReExports");
        switch (reExportsKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginReExportsStatus = writer.BeginArray();
        switch (beginReExportsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack mut u32[0 max] reExportRow = manifestBuilder.SourceSurface.SourceSurfaceReExportFirstRows.Get(moduleRow);
        stack mut u32[0 max] remainingReExports = reExportCount;
        while willexit (remainingReExports != 0)
        {
            if (reExportRow == 0)
            {
                return JsonStatus.Err(JsonError.InvalidValue);
            }

            stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteSourceSurfaceReExportRow(
                writer,
                manifestBuilder,
                reExportRow,
                scratch);
            switch (rowStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }

            stack LogicalPackageManifestJsonSourceSurfaceReExportRow rowFacts =
                manifestBuilder.SourceSurface.SourceSurfaceReExportRows.Get(reExportRow);
            reExportRow = rowFacts.NextRow;
            remainingReExports = remainingReExports - 1;
        }

        stack JsonStatus endReExportsStatus = writer.EndArray();
        switch (endReExportsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (functionCount != 0)
    {
        stack JsonStatus functionsKeyStatus = writer.Key("Functions");
        switch (functionsKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginFunctionsStatus = writer.BeginArray();
        switch (beginFunctionsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack mut u32[0 max] functionRow = manifestBuilder.SourceSurface.SourceSurfaceFunctionFirstRows.Get(moduleRow);
        stack mut u32[0 max] remainingFunctions = functionCount;
        while willexit (remainingFunctions != 0)
        {
            if (functionRow == 0)
            {
                return JsonStatus.Err(JsonError.InvalidValue);
            }

            stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteSourceSurfaceFunctionRow(
                writer,
                manifestBuilder,
                functionRow,
                scratch);
            switch (rowStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }

            stack LogicalPackageManifestJsonSourceSurfaceFunctionRow rowFacts =
                manifestBuilder.SourceSurface.SourceSurfaceFunctionRows.Get(functionRow);
            functionRow = rowFacts.NextRow;
            remainingFunctions = remainingFunctions - 1;
        }

        stack JsonStatus endFunctionsStatus = writer.EndArray();
        switch (endFunctionsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (typeCount != 0)
    {
        stack JsonStatus typesKeyStatus = writer.Key("Types");
        switch (typesKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginTypesStatus = writer.BeginArray();
        switch (beginTypesStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack mut u32[0 max] typeRow = manifestBuilder.SourceSurface.SourceSurfaceTypeFirstRows.Get(moduleRow);
        stack mut u32[0 max] remainingTypes = typeCount;
        while willexit (remainingTypes != 0)
        {
            if (typeRow == 0)
            {
                return JsonStatus.Err(JsonError.InvalidValue);
            }

            stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteSourceSurfaceTypeRow(
                writer,
                manifestBuilder,
                typeRow,
                scratch);
            switch (rowStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }

            stack LogicalPackageManifestJsonSourceSurfaceTypeRow rowFacts =
                manifestBuilder.SourceSurface.SourceSurfaceTypeRows.Get(typeRow);
            typeRow = rowFacts.NextRow;
            remainingTypes = remainingTypes - 1;
        }

        stack JsonStatus endTypesStatus = writer.EndArray();
        switch (endTypesStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (globalCount != 0)
    {
        stack JsonStatus globalsKeyStatus = writer.Key("Globals");
        switch (globalsKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginGlobalsStatus = writer.BeginArray();
        switch (beginGlobalsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack mut u32[0 max] globalRow = manifestBuilder.SourceSurface.SourceSurfaceGlobalFirstRows.Get(moduleRow);
        stack mut u32[0 max] remainingGlobals = globalCount;
        while willexit (remainingGlobals != 0)
        {
            if (globalRow == 0)
            {
                return JsonStatus.Err(JsonError.InvalidValue);
            }

            stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteSourceSurfaceGlobalRow(
                writer,
                manifestBuilder,
                globalRow,
                scratch);
            switch (rowStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }

            stack LogicalPackageManifestJsonSourceSurfaceGlobalRow rowFacts =
                manifestBuilder.SourceSurface.SourceSurfaceGlobalRows.Get(globalRow);
            globalRow = rowFacts.NextRow;
            remainingGlobals = remainingGlobals - 1;
        }

        stack JsonStatus endGlobalsStatus = writer.EndArray();
        switch (endGlobalsStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (typeAliasCount != 0)
    {
        stack JsonStatus typeAliasesKeyStatus = writer.Key("TypeAliases");
        switch (typeAliasesKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginTypeAliasesStatus = writer.BeginArray();
        switch (beginTypeAliasesStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack mut u32[0 max] typeAliasRow = manifestBuilder.SourceSurface.SourceSurfaceTypeAliasFirstRows.Get(moduleRow);
        stack mut u32[0 max] remainingTypeAliases = typeAliasCount;
        while willexit (remainingTypeAliases != 0)
        {
            if (typeAliasRow == 0)
            {
                return JsonStatus.Err(JsonError.InvalidValue);
            }

            stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteSourceSurfaceTypeAliasRow(
                writer,
                manifestBuilder,
                typeAliasRow,
                scratch);
            switch (rowStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }

            stack LogicalPackageManifestJsonSourceSurfaceTypeAliasRow rowFacts =
                manifestBuilder.SourceSurface.SourceSurfaceTypeAliasRows.Get(typeAliasRow);
            typeAliasRow = rowFacts.NextRow;
            remainingTypeAliases = remainingTypeAliases - 1;
        }

        stack JsonStatus endTypeAliasesStatus = writer.EndArray();
        switch (endTypeAliasesStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    return writer.EndObject();
}
