// Serializes ABI, layout, effect, ownership, and linkage facts.

internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteCompilerFactAbiTypeReferenceObject(
    mut borrow JsonWriter writer,
    borrow LogicalPackageImageStringTableBuilder strings,
    LogicalPackageManifestJsonTypeReferenceDescriptor descriptor,
    mut borrow OwnedAscii scratch)
{
    stack JsonStatus beginStatus = writer.BeginObject();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus kindStatus = LogicalPackageManifestJsonWriteStringMember(
        writer,
        "Kind",
        strings,
        descriptor.KindStringIndex,
        scratch);
    switch (kindStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    if (descriptor.HasName)
    {
        stack JsonStatus nameStatus = LogicalPackageManifestJsonWriteStringMember(
            writer,
            "Name",
            strings,
            descriptor.NameStringIndex,
            scratch);
        switch (nameStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (descriptor.HasBitWidth)
    {
        stack JsonStatus bitWidthStatus = LogicalPackageManifestJsonWriteU32Member(
            writer,
            "BitWidth",
            descriptor.BitWidth);
        switch (bitWidthStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (descriptor.HasRangeMin)
    {
        stack JsonStatus rangeMinStatus = LogicalPackageManifestJsonWriteStringMember(
            writer,
            "RangeMin",
            strings,
            descriptor.RangeMinStringIndex,
            scratch);
        switch (rangeMinStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (descriptor.HasRangeMax)
    {
        stack JsonStatus rangeMaxStatus = LogicalPackageManifestJsonWriteStringMember(
            writer,
            "RangeMax",
            strings,
            descriptor.RangeMaxStringIndex,
            scratch);
        switch (rangeMaxStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (descriptor.HasIsUnsigned)
    {
        stack JsonStatus unsignedStatus = LogicalPackageManifestJsonWriteBoolMember(
            writer,
            "IsUnsigned",
            descriptor.IsUnsigned);
        switch (unsignedStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    return writer.EndObject();
}

internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteCompilerFactAbiTypeReferenceMember(
    mut borrow JsonWriter writer,
    ascii memberName,
    borrow LogicalPackageImageStringTableBuilder strings,
    LogicalPackageManifestJsonTypeReferenceDescriptor descriptor,
    mut borrow OwnedAscii scratch)
{
    stack JsonStatus keyStatus = writer.Key(memberName);
    switch (keyStatus)
