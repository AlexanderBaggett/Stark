internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteCompilerFactFunctionSemanticCalledFunctionsMember(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    LogicalPackageManifestJsonCompilerFactFunctionSemanticRow semanticRow,
    mut borrow OwnedAscii scratch)
{
    stack JsonStatus keyStatus = writer.Key("CalledFunctions");
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginArray();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] calledFunctionRow = semanticRow.FirstCalledFunctionRow;
    stack mut u32[0 max] remainingCalledFunctions = semanticRow.CalledFunctionCount;
    while willexit (remainingCalledFunctions != 0)
    {
        if (calledFunctionRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack LogicalPackageManifestJsonCompilerFactFunctionSemanticCalledFunctionRow rowFacts =
            manifestBuilder.CompilerFacts.CompilerFactFunctionSemanticCalledFunctionRows.Get(calledFunctionRow);
        stack JsonStatus valueStatus = LogicalPackageImageStringTableBuilderWriteTextValue(
            manifestBuilder.Strings,
            rowFacts.NameStringIndex,
            writer,
            scratch);
        switch (valueStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        calledFunctionRow = rowFacts.NextRow;
        remainingCalledFunctions = remainingCalledFunctions - 1;
    }

    return writer.EndArray();
}

