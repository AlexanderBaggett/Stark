internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteTypedInterfaceMember(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    u32[0 max] moduleRow,
    mut borrow OwnedAscii scratch)
{
    stack u32[0 max] functionCount = manifestBuilder.TypedInterface.TypedInterfaceFunctionCounts.Get(moduleRow);
    stack u32[0 max] typeCount = manifestBuilder.TypedInterface.TypedInterfaceTypeCounts.Get(moduleRow);
    stack u32[0 max] globalCount = manifestBuilder.TypedInterface.TypedInterfaceGlobalCounts.Get(moduleRow);
    stack u32[0 max] typeAliasCount = manifestBuilder.TypedInterface.TypedInterfaceTypeAliasCounts.Get(moduleRow);
    if (functionCount == 0 && typeCount == 0 && globalCount == 0 && typeAliasCount == 0)
    {
        return JsonStatus.Ok;
    }

    stack JsonStatus keyStatus = writer.Key("TypedInterface");
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginObject();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus functionsKeyStatus = writer.Key("Functions");
    switch (functionsKeyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginFunctionsStatus = writer.BeginArray();
    switch (beginFunctionsStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] functionRow = manifestBuilder.TypedInterface.TypedInterfaceFunctionFirstRows.Get(moduleRow);
    stack mut u32[0 max] remainingFunctions = functionCount;
    while willexit (remainingFunctions != 0)
    {
        if (functionRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteTypedInterfaceFunctionRow(
            writer,
            manifestBuilder,
            functionRow,
            scratch);
        switch (rowStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack LogicalPackageManifestJsonTypedInterfaceFunctionRow rowFacts =
            manifestBuilder.TypedInterface.TypedInterfaceFunctionRows.Get(functionRow);
        functionRow = rowFacts.NextRow;
        remainingFunctions = remainingFunctions - 1;
    }

    stack JsonStatus endFunctionsStatus = writer.EndArray();
    switch (endFunctionsStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus typesKeyStatus = writer.Key("Types");
    switch (typesKeyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginTypesStatus = writer.BeginArray();
    switch (beginTypesStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] typeRow = manifestBuilder.TypedInterface.TypedInterfaceTypeFirstRows.Get(moduleRow);
    stack mut u32[0 max] remainingTypes = typeCount;
    while willexit (remainingTypes != 0)
    {
        if (typeRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteTypedInterfaceTypeRow(
            writer,
            manifestBuilder,
            typeRow,
            scratch);
        switch (rowStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack LogicalPackageManifestJsonTypedInterfaceTypeRow rowFacts =
            manifestBuilder.TypedInterface.TypedInterfaceTypeRows.Get(typeRow);
        typeRow = rowFacts.NextRow;
        remainingTypes = remainingTypes - 1;
    }

    stack JsonStatus endTypesStatus = writer.EndArray();
    switch (endTypesStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus globalsKeyStatus = writer.Key("Globals");
    switch (globalsKeyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginGlobalsStatus = writer.BeginArray();
    switch (beginGlobalsStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] globalRow = manifestBuilder.TypedInterface.TypedInterfaceGlobalFirstRows.Get(moduleRow);
    stack mut u32[0 max] remainingGlobals = globalCount;
    while willexit (remainingGlobals != 0)
    {
        if (globalRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteTypedInterfaceGlobalRow(
            writer,
            manifestBuilder,
            globalRow,
            scratch);
        switch (rowStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack LogicalPackageManifestJsonTypedInterfaceGlobalRow rowFacts =
            manifestBuilder.TypedInterface.TypedInterfaceGlobalRows.Get(globalRow);
        globalRow = rowFacts.NextRow;
        remainingGlobals = remainingGlobals - 1;
    }

    stack JsonStatus endGlobalsStatus = writer.EndArray();
    switch (endGlobalsStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus typeAliasesKeyStatus = writer.Key("TypeAliases");
    switch (typeAliasesKeyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginTypeAliasesStatus = writer.BeginArray();
    switch (beginTypeAliasesStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] typeAliasRow = manifestBuilder.TypedInterface.TypedInterfaceTypeAliasFirstRows.Get(moduleRow);
    stack mut u32[0 max] remainingTypeAliases = typeAliasCount;
    while willexit (remainingTypeAliases != 0)
    {
        if (typeAliasRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteTypedInterfaceTypeAliasRow(
            writer,
            manifestBuilder,
            typeAliasRow,
            scratch);
        switch (rowStatus)
