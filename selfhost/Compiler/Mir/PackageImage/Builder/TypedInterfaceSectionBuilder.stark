internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteTypedInterfaceTypeAliasRow(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    u32[0 max] row,
    mut borrow OwnedAscii scratch)
{
    stack LogicalPackageManifestJsonTypedInterfaceTypeAliasRow aliasRow =
        manifestBuilder.TypedInterface.TypedInterfaceTypeAliasRows.Get(row);
    stack JsonStatus beginStatus = writer.BeginObject();
