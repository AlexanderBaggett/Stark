    }

    stack JsonStatus endTypeAliasesStatus = writer.EndArray();
    switch (endTypeAliasesStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    return writer.EndObject();
}
