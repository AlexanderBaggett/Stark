        switch (beginComptimeStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack mut u32[0 max] parameterRow = aliasRow.ComptimeGenericParameterFirstRow;
        stack mut u32[0 max] remainingParameters = aliasRow.ComptimeGenericParameterCount;
        while willexit (remainingParameters != 0)
        {
            if (parameterRow == 0)
            {
                return JsonStatus.Err(JsonError.InvalidValue);
            }

            stack JsonStatus parameterStatus =
                LogicalPackageManifestJsonWriteTypedInterfaceTypeAliasComptimeGenericParameterRow(
                    writer,
                    manifestBuilder,
                    parameterRow,
                    scratch);
            switch (parameterStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }

            stack LogicalPackageManifestJsonTypedInterfaceTypeAliasComptimeGenericParameterRow rowFacts =
                manifestBuilder.TypedInterface.TypedInterfaceTypeAliasComptimeGenericParameterRows.Get(parameterRow);
            parameterRow = rowFacts.NextRow;
