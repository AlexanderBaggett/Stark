        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus targetStatus = LogicalPackageManifestJsonWriteNamedTypeReferenceMember(
        writer,
        "TargetType",
        manifestBuilder.Strings,
        aliasRow.TargetTypeKindStringIndex,
        aliasRow.TargetTypeNameStringIndex,
        scratch);
    switch (targetStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    if (aliasRow.GenericParameterCount != 0)
    {
        stack JsonStatus genericKeyStatus = writer.Key("GenericParameters");
        switch (genericKeyStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus beginGenericStatus = writer.BeginArray();
        switch (beginGenericStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack mut u32[0 max] parameterRow = aliasRow.GenericParameterFirstRow;
        stack mut u32[0 max] remainingParameters = aliasRow.GenericParameterCount;
        while willexit (remainingParameters != 0)
        {
            if (parameterRow == 0)
            {
                return JsonStatus.Err(JsonError.InvalidValue);
            }

            stack LogicalPackageManifestJsonTypedInterfaceTypeAliasGenericParameterRow rowFacts =
                manifestBuilder.TypedInterface.TypedInterfaceTypeAliasGenericParameterRows.Get(parameterRow);
            stack JsonStatus parameterStatus = LogicalPackageImageStringTableBuilderWriteTextValue(
                manifestBuilder.Strings,
                rowFacts.NameStringIndex,
                writer,
                scratch);
            switch (parameterStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }

            parameterRow = rowFacts.NextRow;
            remainingParameters = remainingParameters - 1;
        }

        stack JsonStatus endGenericStatus = writer.EndArray();
        switch (endGenericStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (aliasRow.ComptimeGenericParameterCount != 0)
    {
        stack JsonStatus comptimeKeyStatus = writer.Key("ComptimeGenericParameters");
