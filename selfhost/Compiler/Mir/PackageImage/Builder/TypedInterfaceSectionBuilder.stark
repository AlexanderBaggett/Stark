// Serializes typed declarations from the logical-manifest accumulator.

internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteNamedTypeReferenceObject(
    mut borrow JsonWriter writer,
    borrow LogicalPackageImageStringTableBuilder strings,
    u32[0 max] kindStringIndex,
    u32[0 max] nameStringIndex,
    mut borrow OwnedAscii scratch)
{
    stack JsonStatus beginStatus = writer.BeginObject();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus kindStatus = LogicalPackageManifestJsonWriteStringMember(
        writer,
        "Kind",
        strings,
        kindStringIndex,
        scratch);
    switch (kindStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus nameStatus = LogicalPackageManifestJsonWriteStringMember(
        writer,
        "Name",
        strings,
        nameStringIndex,
        scratch);
    switch (nameStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    return writer.EndObject();
}

