            }

            stack LogicalPackageManifestJsonTypedInterfaceFunctionDeadParameterNameRow deadFacts =
                manifestBuilder.TypedInterface.TypedInterfaceFunctionDeadParameterNameRows.Get(deadRow);
            stack JsonStatus deadStatus = LogicalPackageImageStringTableBuilderWriteTextValue(
                manifestBuilder.Strings,
