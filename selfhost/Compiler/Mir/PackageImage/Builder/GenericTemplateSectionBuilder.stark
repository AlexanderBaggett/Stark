module Compiler.Mir.PackageImage.Builder.GenericTemplateSectionBuilder

// Serializes generic-template headers, typed bodies, expression/pattern trees,
// and bound operations from the logical-manifest accumulator.

internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteGenericTemplateExpressionArgumentsMember(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    LogicalPackageManifestJsonGenericTemplateExpressionRow row,
    mut borrow OwnedAscii scratch)
{
    stack JsonStatus keyStatus = writer.Key("Arguments");
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginArray();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] argumentExpressionRow = row.FirstArgumentExpressionRow;
    stack mut u32[0 max] remainingArguments = row.ArgumentCount;
    while willexit (remainingArguments != 0)
    {
        if (argumentExpressionRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack JsonStatus argumentStatus =
            LogicalPackageManifestJsonWriteGenericTemplateExpressionObject(
                writer,
                manifestBuilder,
                argumentExpressionRow,
                scratch);
        switch (argumentStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack LogicalPackageManifestJsonGenericTemplateExpressionRow argumentRow =
            manifestBuilder.GenericTemplates.GenericTemplateExpressionRows.Get(argumentExpressionRow);
        argumentExpressionRow = argumentRow.NextSiblingExpressionRow;
        remainingArguments = remainingArguments - 1;
    }

    return writer.EndArray();
}

internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteGenericTemplateExpressionNameArrayMember(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    ascii memberName,
    borrow IrTable<LogicalPackageManifestJsonGenericTemplateExpressionNameListRow> nameRows,
    u32[0 max] firstRow,
    u32[0 max] nameCount,
    mut borrow OwnedAscii scratch)
    where overlap(manifestBuilder, nameRows)
{
    stack JsonStatus keyStatus = writer.Key(memberName);
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginArray();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] nameRow = firstRow;
    stack mut u32[0 max] remainingNames = nameCount;
    while willexit (remainingNames != 0)
    {
        if (nameRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack LogicalPackageManifestJsonGenericTemplateExpressionNameListRow rowFacts =
            nameRows.Get(nameRow);
        stack JsonStatus nameStatus = LogicalPackageImageStringTableBuilderWriteTextValue(
            manifestBuilder.Strings,
            rowFacts.NameStringIndex,
            writer,
            scratch);
        switch (nameStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        nameRow = rowFacts.NextRow;
        remainingNames = remainingNames - 1;
    }

    return writer.EndArray();
}

