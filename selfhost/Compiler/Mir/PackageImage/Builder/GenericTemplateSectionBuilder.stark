    }

    if (row.HasOrdinal)
    {
        stack JsonStatus ordinalStatus = LogicalPackageManifestJsonWriteU32Member(
            writer,
            "Ordinal",
            row.Ordinal);
        switch (ordinalStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
