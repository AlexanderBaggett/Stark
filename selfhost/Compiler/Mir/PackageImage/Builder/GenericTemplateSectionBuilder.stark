internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteGenericTemplateExpressionComptimeValueArgumentsMember(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    LogicalPackageManifestJsonGenericTemplateExpressionRow row,
    mut borrow OwnedAscii scratch)
{
    stack JsonStatus keyStatus = writer.Key("ComptimeValueArguments");
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginArray();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] argumentRow = row.FirstComptimeValueArgumentRow;
    stack mut u32[0 max] remainingArguments = row.ComptimeValueArgumentCount;
    while willexit (remainingArguments != 0)
    {
        if (argumentRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack LogicalPackageManifestJsonGenericTemplateExpressionComptimeValueArgumentRow rowFacts =
            manifestBuilder.GenericTemplates.GenericTemplateExpressionComptimeValueArgumentRows.Get(argumentRow);
        stack JsonStatus beginObjectStatus = writer.BeginObject();
        switch (beginObjectStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus parameterStatus = LogicalPackageManifestJsonWriteStringMember(
            writer,
            "ParameterName",
            manifestBuilder.Strings,
            rowFacts.ParameterNameStringIndex,
            scratch);
        switch (parameterStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus integerStatus = LogicalPackageManifestJsonWriteStringMember(
            writer,
            "IntegerValue",
            manifestBuilder.Strings,
            rowFacts.IntegerValueStringIndex,
            scratch);
        switch (integerStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack JsonStatus typeStatus =
            LogicalPackageManifestJsonWriteCompilerFactAbiTypeReferenceMember(
                writer,
                "Type",
                manifestBuilder.Strings,
                rowFacts.TypeReference,
                scratch);
        switch (typeStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        if (rowFacts.IsSymbolic)
        {
            stack JsonStatus symbolicStatus = LogicalPackageManifestJsonWriteBoolMember(
                writer,
                "IsSymbolic",
                true);
            switch (symbolicStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }
        }

        if (rowFacts.HasSymbolicSourceName)
        {
            stack JsonStatus sourceNameStatus = LogicalPackageManifestJsonWriteStringMember(
                writer,
                "SymbolicSourceName",
                manifestBuilder.Strings,
                rowFacts.SymbolicSourceNameStringIndex,
                scratch);
            switch (sourceNameStatus)
            {
                case JsonStatus.Err(var error):
                    return JsonStatus.Err(error);
                case JsonStatus.Ok:
            }
        }

        stack JsonStatus endObjectStatus = writer.EndObject();
        switch (endObjectStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        argumentRow = rowFacts.NextRow;
        remainingArguments = remainingArguments - 1;
    }

    return writer.EndArray();
}

internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteGenericTemplateExpressionObject(
