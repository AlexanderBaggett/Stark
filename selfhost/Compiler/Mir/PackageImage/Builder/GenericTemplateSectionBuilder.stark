        switch (typeStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }
    }

    if (row.ArgumentCount != 0)
    {
        stack JsonStatus argumentsStatus =
