internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteGenericTemplatesMember(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    u32[0 max] moduleRow,
    mut borrow OwnedAscii scratch)
{
    stack JsonStatus keyStatus = writer.Key("GenericTemplates");
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginObject();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus functionsKeyStatus = writer.Key("Functions");
    switch (functionsKeyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginFunctionsStatus = writer.BeginArray();
    switch (beginFunctionsStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack mut u32[0 max] functionRow = manifestBuilder.GenericTemplates.GenericTemplateFunctionFirstRows.Get(moduleRow);
    stack mut u32[0 max] remainingFunctions = manifestBuilder.GenericTemplates.GenericTemplateFunctionCounts.Get(moduleRow);
    while willexit (remainingFunctions != 0)
    {
        if (functionRow == 0)
        {
            return JsonStatus.Err(JsonError.InvalidValue);
        }

        stack JsonStatus rowStatus = LogicalPackageManifestJsonWriteGenericTemplateFunctionRow(
            writer,
            manifestBuilder,
            functionRow,
            scratch);
        switch (rowStatus)
        {
            case JsonStatus.Err(var error):
                return JsonStatus.Err(error);
            case JsonStatus.Ok:
        }

        stack LogicalPackageManifestJsonGenericTemplateFunctionRow rowFacts =
            manifestBuilder.GenericTemplates.GenericTemplateFunctionRows.Get(functionRow);
        functionRow = rowFacts.NextRow;
        remainingFunctions = remainingFunctions - 1;
    }

    stack JsonStatus endFunctionsStatus = writer.EndArray();
    switch (endFunctionsStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    return writer.EndObject();
}

