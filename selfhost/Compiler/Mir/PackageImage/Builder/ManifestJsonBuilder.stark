import Compiler.Ir
import Compiler.Mir.PackageImage.Builder.CompilerFactsManifestBuilder
import Compiler.Mir.PackageImage.Builder.GenericTemplateManifestBuilder
import Compiler.Mir.PackageImage.Builder.ManifestTypeReferenceBuilder
import Compiler.Mir.PackageImage.Builder.StringTableBuilder
import Compiler.Mir.PackageImage.Builder.SourceSurfaceManifestBuilder
import Compiler.Mir.PackageImage.Builder.TypedInterfaceManifestBuilder
import Compiler.Mir.PackageImage.Models
import Compiler.Mir.PackageImage.Shared.BinaryFormat
module Compiler.Mir.PackageImage.Builder.ManifestJsonBuilder

// Public compatibility aggregate for logical-manifest construction. Focused
// family builders own all row storage and mutation; this type preserves the
// established member-call surface while coordinating the shared string table.


public struct LogicalPackageManifestJsonBuilder
{
    internal LogicalPackageImageStringTableBuilder Strings;
    internal IrTable<u32[0 max]> ModuleNameStringIndexes;
    internal LogicalPackageManifestJsonSourceSurfaceBuilder SourceSurface;
    internal LogicalPackageManifestJsonTypedInterfaceBuilder TypedInterface;
    internal LogicalPackageManifestJsonCompilerFactsBuilder CompilerFacts;
    internal LogicalPackageManifestJsonGenericTemplateBuilder GenericTemplates;

    LogicalPackageManifestJsonBuilder()
    {
        self.Strings = new();
        self.ModuleNameStringIndexes = new();
        self.SourceSurface = new();
        self.TypedInterface = new();
        self.CompilerFacts = new();
        self.GenericTemplates = new();
    }

    public inline finite law u32[0 max] ModuleCount(borrow LogicalPackageManifestJsonBuilder self)
    {
        return (u32[0 max])self.ModuleNameStringIndexes.Count();
    }

    public fn bool AddModule(mut borrow LogicalPackageManifestJsonBuilder self, ascii moduleName)
    {
        stack mut u32[0 max] stringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(self.Strings, moduleName, stringIndex))
        {
            return false;
        }

        if (self.ModuleNameStringIndexes.Add(stringIndex) == 0
            || !self.SourceSurface.AddModule()
            || !self.TypedInterface.AddModule()
            || !self.GenericTemplates.AddModule()
            || !self.CompilerFacts.AddModule())
        {
            return false;
        }

        return true;
    }

