    LogicalPackageManifestJsonCompilerFactsBuilder()
    {
        self.ModuleRows = new();
        self.CompilerFactFunctionEffectRows = new();
        self.CompilerFactFunctionEffectFirstRows = new();
        self.CompilerFactFunctionEffectLastRows = new();
        self.CompilerFactFunctionEffectCounts = new();
        self.CompilerFactFunctionSemanticRows = new();
        self.CompilerFactFunctionSemanticFirstRows = new();
        self.CompilerFactFunctionSemanticLastRows = new();
        self.CompilerFactFunctionSemanticCounts = new();
        self.CompilerFactFunctionSemanticCalledFunctionRows = new();
        self.CompilerFactFunctionSemanticParameterRows = new();
        self.CompilerFactFunctionSemanticInitializationRangeRows = new();
        self.CompilerFactFunctionSemanticCallRows = new();
        self.CompilerFactFunctionSemanticCallArgumentRows = new();
        self.CompilerFactFunctionOwnershipImplicitDropRows = new();
        self.CompilerFactFunctionOwnershipMoveRows = new();
        self.CompilerFactFunctionOwnershipEventRows = new();
        self.CompilerFactFunctionOwnershipProjectionRows = new();
        self.CompilerFactFunctionOwnershipRootRows = new();
        self.CompilerFactAbiFunctionRows = new();
        self.CompilerFactAbiFunctionFirstRows = new();
        self.CompilerFactAbiFunctionLastRows = new();
        self.CompilerFactAbiFunctionCounts = new();
        self.CompilerFactAbiParameterRows = new();
        self.CompilerFactAbiParameterLlvmTypeRows = new();
        self.CompilerFactConcreteLayoutRows = new();
        self.CompilerFactConcreteLayoutFirstRows = new();
        self.CompilerFactConcreteLayoutLastRows = new();
        self.CompilerFactConcreteLayoutCounts = new();
        self.CompilerFactConcreteFieldRows = new();
        self.NativeDependencyRows = new();
        self.NativeSourceDependencyFirstRow = 0;
        self.NativeSourceDependencyLastRow = 0;
        self.NativeSourceDependencyCount = 0;
        self.NativeIncludeDirectoryDependencyFirstRow = 0;
        self.NativeIncludeDirectoryDependencyLastRow = 0;
        self.NativeIncludeDirectoryDependencyCount = 0;
        self.NativeLibraryDirectoryDependencyFirstRow = 0;
        self.NativeLibraryDirectoryDependencyLastRow = 0;
        self.NativeLibraryDirectoryDependencyCount = 0;
        self.NativeLibraryDependencyFirstRow = 0;
        self.NativeLibraryDependencyLastRow = 0;
        self.NativeLibraryDependencyCount = 0;
        self.NativeLinkArgumentDependencyFirstRow = 0;
        self.NativeLinkArgumentDependencyLastRow = 0;
        self.NativeLinkArgumentDependencyCount = 0;
        self.NativePkgConfigPackageDependencyFirstRow = 0;
        self.NativePkgConfigPackageDependencyLastRow = 0;
        self.NativePkgConfigPackageDependencyCount = 0;
        self.CompilerFactLinkageRows = new();
        self.CompilerFactLinkageRowsByModule = new();
        self.CompilerFactLinkageDefinedSymbolRows = new();
        self.CompilerFactLinkageReferencedSymbolRows = new();
    }

    internal fn bool AddModule(mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self)
    {
        return self.ModuleRows.Add(false) != 0
            && self.CompilerFactFunctionEffectFirstRows.Add(0) != 0
            && self.CompilerFactFunctionEffectLastRows.Add(0) != 0
            && self.CompilerFactFunctionEffectCounts.Add(0) != 0
            && self.CompilerFactFunctionSemanticFirstRows.Add(0) != 0
            && self.CompilerFactFunctionSemanticLastRows.Add(0) != 0
            && self.CompilerFactFunctionSemanticCounts.Add(0) != 0
            && self.CompilerFactAbiFunctionFirstRows.Add(0) != 0
            && self.CompilerFactAbiFunctionLastRows.Add(0) != 0
            && self.CompilerFactAbiFunctionCounts.Add(0) != 0
            && self.CompilerFactConcreteLayoutFirstRows.Add(0) != 0
            && self.CompilerFactConcreteLayoutLastRows.Add(0) != 0
            && self.CompilerFactConcreteLayoutCounts.Add(0) != 0
            && self.CompilerFactLinkageRowsByModule.Add(0) != 0;
    }

    internal fn bool AddCompilerFactFunctionEffect(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] moduleOrdinal,
        ascii qualifiedResolvedName,
        ascii kind,
        ascii inlinePreference,
        out u32[0 max] functionEffectRow)
    {
        functionEffectRow = 0;
        stack u32[0 max] moduleRow = moduleOrdinal + 1;
        if (!self.ModuleRows.Contains(moduleRow))
        {
            return false;
        }

        stack u32[0 max] count = self.CompilerFactFunctionEffectCounts.Get(moduleRow);
        if (count == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] qualifiedResolvedNameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] kindStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] inlinePreferenceStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(
                strings,
                qualifiedResolvedName,
                qualifiedResolvedNameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, kind, kindStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(
                strings,
                inlinePreference,
                inlinePreferenceStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonCompilerFactFunctionEffectRow row =
            new LogicalPackageManifestJsonCompilerFactFunctionEffectRow()
            {
                QualifiedResolvedNameStringIndex = qualifiedResolvedNameStringIndex,
                KindStringIndex = kindStringIndex,
                InlinePreferenceStringIndex = inlinePreferenceStringIndex
            };
        stack u32[0 max] rowIndex = self.CompilerFactFunctionEffectRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (count == 0)
        {
            if (!self.CompilerFactFunctionEffectFirstRows.Replace(moduleRow, rowIndex))
            {
                return false;
            }
        }
        else
        {
            stack u32[0 max] lastRowIndex = self.CompilerFactFunctionEffectLastRows.Get(moduleRow);
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonCompilerFactFunctionEffectRow lastRow =
                self.CompilerFactFunctionEffectRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.CompilerFactFunctionEffectRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        if (!self.CompilerFactFunctionEffectLastRows.Replace(moduleRow, rowIndex)
            || !self.CompilerFactFunctionEffectCounts.Replace(moduleRow, count + 1))
        {
            return false;
        }

        functionEffectRow = rowIndex;
        return true;
    }

    internal fn bool SetCompilerFactFunctionEffectFlags(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionEffectRow,
        bool readsArgumentMemory,
        bool isPure,
        bool noSync,
        bool noFree,
        bool noUnwind,
        bool willReturn,
        bool mustProgress,
        bool usesFastCallingConvention,
        bool isFfi,
        bool isHot,
        bool isCold,
        bool isStrictFp,
        bool isVarargs,
        bool isTailCallable,
        bool noRecurse)
    {
        if (!self.CompilerFactFunctionEffectRows.Contains(functionEffectRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonCompilerFactFunctionEffectRow row =
            self.CompilerFactFunctionEffectRows.Get(functionEffectRow);
        row.ReadsArgumentMemory = readsArgumentMemory;
        row.IsPure = isPure;
        row.NoSync = noSync;
        row.NoFree = noFree;
        row.NoUnwind = noUnwind;
        row.WillReturn = willReturn;
        row.MustProgress = mustProgress;
        row.UsesFastCallingConvention = usesFastCallingConvention;
        row.IsFfi = isFfi;
        row.IsHot = isHot;
        row.IsCold = isCold;
        row.IsStrictFp = isStrictFp;
        row.IsVarargs = isVarargs;
        row.IsTailCallable = isTailCallable;
        row.NoRecurse = noRecurse;
        return self.CompilerFactFunctionEffectRows.Replace(functionEffectRow, row);
    }

    internal fn bool SetCompilerFactFunctionEffectFfiAbi(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionEffectRow,
        ascii ffiAbi)
    {
        if (!self.CompilerFactFunctionEffectRows.Contains(functionEffectRow))
        {
            return false;
        }

        stack mut u32[0 max] ffiAbiStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, ffiAbi, ffiAbiStringIndex))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonCompilerFactFunctionEffectRow row =
            self.CompilerFactFunctionEffectRows.Get(functionEffectRow);
        row.FfiAbiStringIndex = ffiAbiStringIndex;
        row.HasFfiAbi = true;
        return self.CompilerFactFunctionEffectRows.Replace(functionEffectRow, row);
    }

    internal fn bool SetCompilerFactFunctionEffectBackendOptimizationMode(
