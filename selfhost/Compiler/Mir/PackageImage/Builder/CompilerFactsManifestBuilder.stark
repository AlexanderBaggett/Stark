    internal fn bool SetCompilerFactFunctionSemanticMemoryEffects(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionSemanticRow,
        bool readsArgumentMemory,
        bool writesArgumentMemory,
        bool capturesArgumentMemory,
        bool readsOtherMemory,
        bool writesOtherMemory,
        bool initializesArgumentMemory,
        bool hasPointeeDeadOnReturnArgument)
    {
        if (!self.CompilerFactFunctionSemanticRows.Contains(functionSemanticRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonCompilerFactFunctionSemanticRow row =
            self.CompilerFactFunctionSemanticRows.Get(functionSemanticRow);
        row.MemoryEffects = new LogicalPackageManifestJsonFunctionMemoryEffectFacts()
        {
            ReadsArgumentMemory = readsArgumentMemory,
            WritesArgumentMemory = writesArgumentMemory,
            CapturesArgumentMemory = capturesArgumentMemory,
            ReadsOtherMemory = readsOtherMemory,
            WritesOtherMemory = writesOtherMemory,
            InitializesArgumentMemory = initializesArgumentMemory,
            HasPointeeDeadOnReturnArgument = hasPointeeDeadOnReturnArgument
        };
        row.HasMemoryEffects = true;
        return self.CompilerFactFunctionSemanticRows.Replace(functionSemanticRow, row);
    }

