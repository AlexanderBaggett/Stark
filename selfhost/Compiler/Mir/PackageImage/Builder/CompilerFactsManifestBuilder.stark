{
    internal IrTable<bool> ModuleRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactFunctionEffectRow>
        CompilerFactFunctionEffectRows;
    internal IrTable<u32[0 max]> CompilerFactFunctionEffectFirstRows;
