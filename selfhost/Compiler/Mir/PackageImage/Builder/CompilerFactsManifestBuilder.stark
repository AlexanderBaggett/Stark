            };
        stack u32[0 max] rowIndex = self.CompilerFactLinkageReferencedSymbolRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (linkage.ReferencedSymbolCount == 0)
        {
            linkage.FirstReferencedSymbolRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = linkage.LastReferencedSymbolRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonCompilerFactLinkageSymbolRow lastRow =
                self.CompilerFactLinkageReferencedSymbolRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.CompilerFactLinkageReferencedSymbolRows.Replace(lastRowIndex, lastRow))
            {
                return false;
