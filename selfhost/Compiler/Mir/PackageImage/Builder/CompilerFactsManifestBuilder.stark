    internal fn bool AddCompilerFactFunctionSemanticInitializationRange(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] parameterRow,
        i64[min max] startByte,
        i64[min max] endByte,
        out u32[0 max] initializationRangeRow)
    {
        initializationRangeRow = 0;
        if (!self.CompilerFactFunctionSemanticParameterRows.Contains(parameterRow)
            || startByte < 0
            || endByte < startByte)
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonCompilerFactFunctionSemanticParameterRow parent =
            self.CompilerFactFunctionSemanticParameterRows.Get(parameterRow);
        if (parent.InitializationRangeCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
