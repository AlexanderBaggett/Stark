    internal IrTable<LogicalPackageManifestJsonCompilerFactAbiParameterLlvmTypeRow>
        CompilerFactAbiParameterLlvmTypeRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactConcreteLayoutRow>
