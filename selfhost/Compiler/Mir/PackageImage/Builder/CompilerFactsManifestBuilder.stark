    internal u32[0 max] NativeIncludeDirectoryDependencyFirstRow;
    internal u32[0 max] NativeIncludeDirectoryDependencyLastRow;
    internal u32[0 max] NativeIncludeDirectoryDependencyCount;
    internal u32[0 max] NativeLibraryDirectoryDependencyFirstRow;
    internal u32[0 max] NativeLibraryDirectoryDependencyLastRow;
    internal u32[0 max] NativeLibraryDirectoryDependencyCount;
    internal u32[0 max] NativeLibraryDependencyFirstRow;
    internal u32[0 max] NativeLibraryDependencyLastRow;
    internal u32[0 max] NativeLibraryDependencyCount;
    internal u32[0 max] NativeLinkArgumentDependencyFirstRow;
    internal u32[0 max] NativeLinkArgumentDependencyLastRow;
    internal u32[0 max] NativeLinkArgumentDependencyCount;
    internal u32[0 max] NativePkgConfigPackageDependencyFirstRow;
    internal u32[0 max] NativePkgConfigPackageDependencyLastRow;
    internal u32[0 max] NativePkgConfigPackageDependencyCount;
    internal IrTable<LogicalPackageManifestJsonCompilerFactLinkageRow>
        CompilerFactLinkageRows;
    internal IrTable<u32[0 max]> CompilerFactLinkageRowsByModule;
    internal IrTable<LogicalPackageManifestJsonCompilerFactLinkageSymbolRow>
        CompilerFactLinkageDefinedSymbolRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactLinkageSymbolRow>
