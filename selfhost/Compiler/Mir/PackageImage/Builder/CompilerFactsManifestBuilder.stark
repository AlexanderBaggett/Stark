    {
        if (!self.CompilerFactFunctionSemanticRows.Contains(functionSemanticRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonCompilerFactFunctionSemanticRow row =
            self.CompilerFactFunctionSemanticRows.Get(functionSemanticRow);
        row.HasExplicitHasOpaqueCall = true;
        row.HasOpaqueCall = hasOpaqueCall;
        return self.CompilerFactFunctionSemanticRows.Replace(functionSemanticRow, row);
    }

    internal fn bool AddCompilerFactFunctionSemanticCalledFunction(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionSemanticRow,
        ascii name,
        out u32[0 max] calledFunctionRow)
    {
        calledFunctionRow = 0;
        if (!self.CompilerFactFunctionSemanticRows.Contains(functionSemanticRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonCompilerFactFunctionSemanticRow semanticRow =
            self.CompilerFactFunctionSemanticRows.Get(functionSemanticRow);
        if (semanticRow.CalledFunctionCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] nameStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, name, nameStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonCompilerFactFunctionSemanticCalledFunctionRow row =
            new LogicalPackageManifestJsonCompilerFactFunctionSemanticCalledFunctionRow()
            {
                FunctionSemanticRow = functionSemanticRow,
                NameStringIndex = nameStringIndex
            };
        stack u32[0 max] rowIndex = self.CompilerFactFunctionSemanticCalledFunctionRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (semanticRow.CalledFunctionCount == 0)
        {
            semanticRow.FirstCalledFunctionRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = semanticRow.LastCalledFunctionRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonCompilerFactFunctionSemanticCalledFunctionRow
                lastRow = self.CompilerFactFunctionSemanticCalledFunctionRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.CompilerFactFunctionSemanticCalledFunctionRows.Replace(
                lastRowIndex,
                lastRow))
            {
                return false;
            }
        }

        semanticRow.LastCalledFunctionRow = rowIndex;
        semanticRow.CalledFunctionCount = semanticRow.CalledFunctionCount + 1;
        if (!self.CompilerFactFunctionSemanticRows.Replace(functionSemanticRow, semanticRow))
        {
            return false;
        }

        calledFunctionRow = rowIndex;
        return true;
    }

    internal fn bool AddCompilerFactFunctionSemanticParameter(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionSemanticRow,
        ascii name,
        ascii typeName,
        ascii captureKind,
        bool isMemoryBacked,
        bool guaranteedNonNull,
        bool guaranteedReadOnly,
        bool guaranteedWriteOnly,
        bool guaranteedNoAlias,
        bool reads,
        bool writes,
        out u32[0 max] parameterRow)
    {
        parameterRow = 0;
        if (!self.CompilerFactFunctionSemanticRows.Contains(functionSemanticRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonCompilerFactFunctionSemanticRow semanticRow =
            self.CompilerFactFunctionSemanticRows.Get(functionSemanticRow);
        if (semanticRow.ParameterCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] nameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] typeStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] captureKindStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, name, nameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, typeName, typeStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(
                strings,
                captureKind,
                captureKindStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonCompilerFactFunctionSemanticParameterRow row =
            new LogicalPackageManifestJsonCompilerFactFunctionSemanticParameterRow()
            {
                FunctionSemanticRow = functionSemanticRow,
                NameStringIndex = nameStringIndex,
                TypeStringIndex = typeStringIndex,
                CaptureKindStringIndex = captureKindStringIndex,
                IsMemoryBacked = isMemoryBacked,
                GuaranteedNonNull = guaranteedNonNull,
                GuaranteedReadOnly = guaranteedReadOnly,
                GuaranteedWriteOnly = guaranteedWriteOnly,
                GuaranteedNoAlias = guaranteedNoAlias,
                Reads = reads,
                Writes = writes
            };
        stack u32[0 max] rowIndex = self.CompilerFactFunctionSemanticParameterRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (semanticRow.ParameterCount == 0)
        {
            semanticRow.FirstParameterRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = semanticRow.LastParameterRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonCompilerFactFunctionSemanticParameterRow
                lastRow = self.CompilerFactFunctionSemanticParameterRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.CompilerFactFunctionSemanticParameterRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        semanticRow.LastParameterRow = rowIndex;
        semanticRow.ParameterCount = semanticRow.ParameterCount + 1;
        if (!self.CompilerFactFunctionSemanticRows.Replace(functionSemanticRow, semanticRow))
        {
            return false;
        }

        parameterRow = rowIndex;
        return true;
    }

