    internal fn bool AddNativeDependency(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        LogicalPackageNativeDependencyKind kind,
        ascii value,
        out u32[0 max] nativeDependencyRow)
    {
        nativeDependencyRow = 0;
        stack mut u32[0 max] count = 0;
        stack mut u32[0 max] lastRowIndex = 0;
        switch (kind)
        {
            case LogicalPackageNativeDependencyKind.Source:
                count = self.NativeSourceDependencyCount;
                lastRowIndex = self.NativeSourceDependencyLastRow;
            case LogicalPackageNativeDependencyKind.IncludeDirectory:
                count = self.NativeIncludeDirectoryDependencyCount;
                lastRowIndex = self.NativeIncludeDirectoryDependencyLastRow;
            case LogicalPackageNativeDependencyKind.LibraryDirectory:
                count = self.NativeLibraryDirectoryDependencyCount;
                lastRowIndex = self.NativeLibraryDirectoryDependencyLastRow;
            case LogicalPackageNativeDependencyKind.Library:
                count = self.NativeLibraryDependencyCount;
                lastRowIndex = self.NativeLibraryDependencyLastRow;
            case LogicalPackageNativeDependencyKind.LinkArgument:
                count = self.NativeLinkArgumentDependencyCount;
                lastRowIndex = self.NativeLinkArgumentDependencyLastRow;
            case LogicalPackageNativeDependencyKind.PkgConfigPackage:
                count = self.NativePkgConfigPackageDependencyCount;
                lastRowIndex = self.NativePkgConfigPackageDependencyLastRow;
        }

        if (count == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] textStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, value, textStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonNativeDependencyRow row =
            new LogicalPackageManifestJsonNativeDependencyRow()
            {
                Kind = kind,
                TextStringIndex = textStringIndex
            };
        stack u32[0 max] rowIndex = self.NativeDependencyRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (count == 0)
        {
            switch (kind)
            {
                case LogicalPackageNativeDependencyKind.Source:
                    self.NativeSourceDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.IncludeDirectory:
                    self.NativeIncludeDirectoryDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.LibraryDirectory:
                    self.NativeLibraryDirectoryDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.Library:
                    self.NativeLibraryDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.LinkArgument:
                    self.NativeLinkArgumentDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.PkgConfigPackage:
                    self.NativePkgConfigPackageDependencyFirstRow = rowIndex;
            }
        }
        else
        {
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonNativeDependencyRow lastRow =
                self.NativeDependencyRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.NativeDependencyRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        switch (kind)
        {
            case LogicalPackageNativeDependencyKind.Source:
                self.NativeSourceDependencyLastRow = rowIndex;
                self.NativeSourceDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.IncludeDirectory:
                self.NativeIncludeDirectoryDependencyLastRow = rowIndex;
                self.NativeIncludeDirectoryDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.LibraryDirectory:
                self.NativeLibraryDirectoryDependencyLastRow = rowIndex;
                self.NativeLibraryDirectoryDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.Library:
                self.NativeLibraryDependencyLastRow = rowIndex;
                self.NativeLibraryDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.LinkArgument:
                self.NativeLinkArgumentDependencyLastRow = rowIndex;
                self.NativeLinkArgumentDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.PkgConfigPackage:
                self.NativePkgConfigPackageDependencyLastRow = rowIndex;
                self.NativePkgConfigPackageDependencyCount = count + 1;
        }

        nativeDependencyRow = rowIndex;
        return true;
    }

    internal fn bool AddCompilerFactLinkage(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] moduleOrdinal,
        ascii objectFileName,
        out u32[0 max] linkageRow)
    {
        linkageRow = 0;
        stack u32[0 max] moduleRow = moduleOrdinal + 1;
        if (!self.ModuleRows.Contains(moduleRow)
            || self.CompilerFactLinkageRowsByModule.Get(moduleRow) != 0)
        {
            return false;
        }

        stack mut u32[0 max] objectFileNameStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(
            strings,
            objectFileName,
            objectFileNameStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonCompilerFactLinkageRow row =
            new LogicalPackageManifestJsonCompilerFactLinkageRow()
            {
                ObjectFileNameStringIndex = objectFileNameStringIndex
            };
        stack u32[0 max] rowIndex = self.CompilerFactLinkageRows.Add(row);
        if (rowIndex == 0 || !self.CompilerFactLinkageRowsByModule.Replace(moduleRow, rowIndex))
        {
            return false;
        }

        linkageRow = rowIndex;
        return true;
    }

    internal fn bool AddCompilerFactLinkageDefinedSymbol(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] linkageRow,
        ascii symbol,
        out u32[0 max] symbolRow)
    {
        symbolRow = 0;
        if (!self.CompilerFactLinkageRows.Contains(linkageRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonCompilerFactLinkageRow linkage =
            self.CompilerFactLinkageRows.Get(linkageRow);
        if (linkage.DefinedSymbolCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] symbolStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, symbol, symbolStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonCompilerFactLinkageSymbolRow row =
            new LogicalPackageManifestJsonCompilerFactLinkageSymbolRow()
            {
                LinkageRow = linkageRow,
                SymbolStringIndex = symbolStringIndex
            };
        stack u32[0 max] rowIndex = self.CompilerFactLinkageDefinedSymbolRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (linkage.DefinedSymbolCount == 0)
        {
            linkage.FirstDefinedSymbolRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = linkage.LastDefinedSymbolRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonCompilerFactLinkageSymbolRow lastRow =
                self.CompilerFactLinkageDefinedSymbolRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.CompilerFactLinkageDefinedSymbolRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        linkage.LastDefinedSymbolRow = rowIndex;
        linkage.DefinedSymbolCount = linkage.DefinedSymbolCount + 1;
        if (!self.CompilerFactLinkageRows.Replace(linkageRow, linkage))
        {
            return false;
        }

        symbolRow = rowIndex;
        return true;
    }

    internal fn bool AddCompilerFactLinkageReferencedSymbol(
        mut borrow LogicalPackageManifestJsonCompilerFactsBuilder self,
