    internal IrTable<LogicalPackageManifestJsonCompilerFactFunctionSemanticCallRow>
        CompilerFactFunctionSemanticCallRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactFunctionSemanticCallArgumentRow>
        CompilerFactFunctionSemanticCallArgumentRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactFunctionOwnershipNameRow>
        CompilerFactFunctionOwnershipImplicitDropRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactFunctionOwnershipNameRow>
        CompilerFactFunctionOwnershipMoveRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactFunctionOwnershipEventRow>
        CompilerFactFunctionOwnershipEventRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactFunctionOwnershipProjectionRow>
        CompilerFactFunctionOwnershipProjectionRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactFunctionOwnershipRootRow>
        CompilerFactFunctionOwnershipRootRows;
    internal IrTable<LogicalPackageManifestJsonCompilerFactAbiFunctionRow>
        CompilerFactAbiFunctionRows;
    internal IrTable<u32[0 max]> CompilerFactAbiFunctionFirstRows;
    internal IrTable<u32[0 max]> CompilerFactAbiFunctionLastRows;
    internal IrTable<u32[0 max]> CompilerFactAbiFunctionCounts;
    internal IrTable<LogicalPackageManifestJsonCompilerFactAbiParameterRow>
