    internal IrTable<LogicalPackageManifestJsonCompilerFactConcreteFieldRow>
        CompilerFactConcreteFieldRows;
    internal IrTable<LogicalPackageManifestJsonNativeDependencyRow> NativeDependencyRows;
    internal u32[0 max] NativeSourceDependencyFirstRow;
    internal u32[0 max] NativeSourceDependencyLastRow;
