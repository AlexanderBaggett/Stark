    internal fn bool AddGenericTemplateDeferredFunctionInstantiation(
        mut borrow LogicalPackageManifestJsonGenericTemplateBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionTemplateRow,
        ascii calleeTemplateName,
        out u32[0 max] instantiationRow)
    {
        instantiationRow = 0;
        if (!self.GenericTemplateFunctionRows.Contains(functionTemplateRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonGenericTemplateFunctionRow functionRow =
            self.GenericTemplateFunctionRows.Get(functionTemplateRow);
        if (functionRow.DeferredFunctionInstantiationCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] calleeTemplateNameStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(
            strings,
            calleeTemplateName,
            calleeTemplateNameStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonGenericTemplateDeferredFunctionInstantiationRow row =
            new LogicalPackageManifestJsonGenericTemplateDeferredFunctionInstantiationRow()
            {
                FunctionTemplateRow = functionTemplateRow,
                CalleeTemplateNameStringIndex = calleeTemplateNameStringIndex
            };
        stack u32[0 max] rowIndex = self.GenericTemplateDeferredFunctionInstantiationRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (functionRow.DeferredFunctionInstantiationCount == 0)
        {
            functionRow.FirstDeferredFunctionInstantiationRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = functionRow.LastDeferredFunctionInstantiationRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonGenericTemplateDeferredFunctionInstantiationRow lastRow =
                self.GenericTemplateDeferredFunctionInstantiationRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.GenericTemplateDeferredFunctionInstantiationRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        functionRow.LastDeferredFunctionInstantiationRow = rowIndex;
        functionRow.DeferredFunctionInstantiationCount =
            functionRow.DeferredFunctionInstantiationCount + 1;
        if (!self.GenericTemplateFunctionRows.Replace(functionTemplateRow, functionRow))
        {
            return false;
        }

        instantiationRow = rowIndex;
        return true;
    }

