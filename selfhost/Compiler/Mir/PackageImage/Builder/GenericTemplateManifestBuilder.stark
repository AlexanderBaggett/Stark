    internal IrTable<LogicalPackageManifestJsonGenericTemplateBoundOperationU32PayloadRow>
        GenericTemplateBoundOperationU32PayloadRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateBoundOperationBoolPayloadRow>
        GenericTemplateBoundOperationBoolPayloadRows;
