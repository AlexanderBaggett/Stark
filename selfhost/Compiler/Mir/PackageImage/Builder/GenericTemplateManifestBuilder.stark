    internal IrTable<LogicalPackageManifestJsonGenericTemplateEnumRow>
        GenericTemplateEnumCallRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateEnumRow>
        GenericTemplateEnumValueRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateEnumRow>
