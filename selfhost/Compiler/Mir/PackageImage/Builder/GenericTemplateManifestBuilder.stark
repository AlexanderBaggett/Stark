    internal IrTable<LogicalPackageManifestJsonGenericTemplateExpressionNameListRow>
        GenericTemplateExpressionOperatorNameRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateExpressionTypeArgumentRow>
        GenericTemplateExpressionTypeArgumentRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateExpressionComptimeValueArgumentRow>
        GenericTemplateExpressionComptimeValueArgumentRows;
