    internal fn bool AddGenericTemplateSwitchCaseMemberPattern(
        mut borrow LogicalPackageManifestJsonGenericTemplateBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] switchCaseRow,
        ascii kind,
        out u32[0 max] patternRow)
    {
        patternRow = 0;
        if (!self.GenericTemplateSwitchCaseRows.Contains(switchCaseRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonGenericTemplateSwitchCaseRow switchCase =
            self.GenericTemplateSwitchCaseRows.Get(switchCaseRow);
        if (switchCase.MemberPatternCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] kindStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, kind, kindStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonGenericTemplatePatternRow row =
            new LogicalPackageManifestJsonGenericTemplatePatternRow()
            {
                FunctionTemplateRow = switchCase.FunctionTemplateRow,
                KindStringIndex = kindStringIndex
            };
        stack u32[0 max] rowIndex = self.GenericTemplatePatternRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (switchCase.MemberPatternCount == 0)
        {
            switchCase.FirstMemberPatternRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastPatternRow = switchCase.LastMemberPatternRow;
            if (lastPatternRow == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonGenericTemplatePatternRow lastRow =
                self.GenericTemplatePatternRows.Get(lastPatternRow);
            lastRow.NextRow = rowIndex;
            if (!self.GenericTemplatePatternRows.Replace(lastPatternRow, lastRow))
            {
                return false;
            }
        }

        switchCase.LastMemberPatternRow = rowIndex;
        switchCase.MemberPatternCount = switchCase.MemberPatternCount + 1;
        if (!self.GenericTemplateSwitchCaseRows.Replace(switchCaseRow, switchCase))
        {
            return false;
        }

        patternRow = rowIndex;
        return true;
    }

