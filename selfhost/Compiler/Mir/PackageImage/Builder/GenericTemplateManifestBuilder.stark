        GenericTemplatePatternRows;

    LogicalPackageManifestJsonGenericTemplateBuilder()
    {
        self.ModuleRows = new();
        self.GenericTemplateFunctionRows = new();
        self.GenericTemplateFunctionFirstRows = new();
        self.GenericTemplateFunctionLastRows = new();
        self.GenericTemplateFunctionCounts = new();
        self.GenericTemplateDeferredFunctionInstantiationRows = new();
        self.GenericTemplateDeferredFunctionInstantiationTypeArgumentRows = new();
        self.GenericTemplateDeferredFunctionInstantiationComptimeValueArgumentRows = new();
        self.GenericTemplateDeferredTypeInstantiationRows = new();
        self.GenericTemplateObjectCreationRows = new();
        self.GenericTemplateObjectInitializerMemberRows = new();
        self.GenericTemplateEnumConstructorRows = new();
        self.GenericTemplateEnumConstructorMemberRows = new();
        self.GenericTemplateEnumCallRows = new();
        self.GenericTemplateEnumValueRows = new();
        self.GenericTemplateEnumPatternRows = new();
        self.GenericTemplateEnumPatternMemberRows = new();
        self.GenericTemplateCallSignatureRows = new();
        self.GenericTemplateCallParameterRows = new();
        self.GenericTemplateCallTypeArgumentRows = new();
        self.GenericTemplateCallComptimeValueArgumentRows = new();
        self.GenericTemplateBoundOperationRows = new();
        self.GenericTemplateBoundOperationCallArgumentRows = new();
        self.GenericTemplateBoundOperationTypePayloadRows = new();
        self.GenericTemplateBoundOperationTextPayloadRows = new();
        self.GenericTemplateBoundOperationU32PayloadRows = new();
        self.GenericTemplateBoundOperationBoolPayloadRows = new();
        self.GenericTemplateStatementRows = new();
        self.GenericTemplateExpressionRows = new();
        self.GenericTemplateExpressionMemberNameRows = new();
        self.GenericTemplateExpressionOperatorNameRows = new();
        self.GenericTemplateExpressionTypeArgumentRows = new();
        self.GenericTemplateExpressionComptimeValueArgumentRows = new();
        self.GenericTemplateSwitchCaseRows = new();
        self.GenericTemplatePatternRows = new();
    }

    internal fn bool AddModule(mut borrow LogicalPackageManifestJsonGenericTemplateBuilder self)
    {
        return self.ModuleRows.Add(false) != 0
            && self.GenericTemplateFunctionFirstRows.Add(0) != 0
            && self.GenericTemplateFunctionLastRows.Add(0) != 0
            && self.GenericTemplateFunctionCounts.Add(0) != 0;
    }

    internal fn bool AddGenericTemplateFunction(
        mut borrow LogicalPackageManifestJsonGenericTemplateBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] moduleOrdinal,
        ascii qualifiedResolvedName,
        ascii qualifiedName,
        ascii overloadKey,
        out u32[0 max] functionTemplateRow)
    {
        functionTemplateRow = 0;
        stack u32[0 max] moduleRow = moduleOrdinal + 1;
        if (!self.ModuleRows.Contains(moduleRow))
        {
            return false;
        }

        stack u32[0 max] count = self.GenericTemplateFunctionCounts.Get(moduleRow);
        if (count == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] qualifiedResolvedNameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] qualifiedNameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] overloadKeyStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(
                strings,
                qualifiedResolvedName,
                qualifiedResolvedNameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(
                strings,
                qualifiedName,
                qualifiedNameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(
                strings,
                overloadKey,
                overloadKeyStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonGenericTemplateFunctionRow row =
            new LogicalPackageManifestJsonGenericTemplateFunctionRow()
            {
                QualifiedResolvedNameStringIndex = qualifiedResolvedNameStringIndex,
                QualifiedNameStringIndex = qualifiedNameStringIndex,
                OverloadKeyStringIndex = overloadKeyStringIndex
            };
        stack u32[0 max] rowIndex = self.GenericTemplateFunctionRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (count == 0)
        {
            if (!self.GenericTemplateFunctionFirstRows.Replace(moduleRow, rowIndex))
            {
                return false;
            }
        }
        else
        {
            stack u32[0 max] lastRowIndex = self.GenericTemplateFunctionLastRows.Get(moduleRow);
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonGenericTemplateFunctionRow lastRow =
                self.GenericTemplateFunctionRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.GenericTemplateFunctionRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        if (!self.GenericTemplateFunctionLastRows.Replace(moduleRow, rowIndex)
            || !self.GenericTemplateFunctionCounts.Replace(moduleRow, count + 1))
        {
            return false;
        }

        functionTemplateRow = rowIndex;
        return true;
    }

    internal fn bool SetGenericTemplateFunctionBodyText(
        mut borrow LogicalPackageManifestJsonGenericTemplateBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionTemplateRow,
        ascii bodyText)
    {
        if (!self.GenericTemplateFunctionRows.Contains(functionTemplateRow))
        {
            return false;
        }

        stack mut u32[0 max] bodyTextStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, bodyText, bodyTextStringIndex))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonGenericTemplateFunctionRow row =
            self.GenericTemplateFunctionRows.Get(functionTemplateRow);
        row.BodyTextStringIndex = bodyTextStringIndex;
        row.HasBodyText = true;
        return self.GenericTemplateFunctionRows.Replace(functionTemplateRow, row);
    }

