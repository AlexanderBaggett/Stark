        GenericTemplateCallSignatureRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateCallParameterRow>
        GenericTemplateCallParameterRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateCallTypeArgumentRow>
        GenericTemplateCallTypeArgumentRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateCallComptimeValueArgumentRow>
        GenericTemplateCallComptimeValueArgumentRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateBoundOperationRow>
        GenericTemplateBoundOperationRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateBoundOperationCallArgumentRow>
        GenericTemplateBoundOperationCallArgumentRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateBoundOperationTypePayloadRow>
        GenericTemplateBoundOperationTypePayloadRows;
    internal IrTable<LogicalPackageManifestJsonGenericTemplateBoundOperationTextPayloadRow>
