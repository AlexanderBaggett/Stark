    fn bool AddGenericTemplateTopLevelCallSignature(
        mut borrow LogicalPackageManifestJsonGenericTemplateBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionTemplateRow,
        LogicalPackageTemplateCallParentKind parentKind,
        u32[0 max] publishedOrdinal,
        ascii qualifiedResolvedName,
        ascii returnTypeKind,
        ascii targetTypeKind,
        bool hasTargetType,
        out u32[0 max] callSignatureRow)
    {
        callSignatureRow = 0;
        if (!self.GenericTemplateFunctionRows.Contains(functionTemplateRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonGenericTemplateFunctionRow functionRow =
            self.GenericTemplateFunctionRows.Get(functionTemplateRow);
        stack mut u32[0 max] parentOrdinal = 0;
        switch (parentKind)
        {
            case LogicalPackageTemplateCallParentKind.DirectCall:
                parentOrdinal = functionRow.DirectCallCount;
            case LogicalPackageTemplateCallParentKind.MemberCall:
                parentOrdinal = functionRow.MemberCallCount;
            case LogicalPackageTemplateCallParentKind.FunctionAddress:
                parentOrdinal = functionRow.FunctionAddressCount;
            case LogicalPackageTemplateCallParentKind.BoundOperation:
                return false;
        }

        if (parentOrdinal == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] qualifiedResolvedNameStringIndex = PackageImageNullStringIndex();
        stack mut LogicalPackageManifestJsonTypeReferenceDescriptor returnType = new();
        stack mut LogicalPackageManifestJsonTypeReferenceDescriptor targetType = new();
        if (!LogicalPackageImageStringTableBuilderTryAdd(
                strings,
                qualifiedResolvedName,
                qualifiedResolvedNameStringIndex)
            || !LogicalPackageManifestJsonBuildTypeReferenceDescriptor(
                strings,
                returnTypeKind,
                returnType))
        {
            return false;
        }

        if (hasTargetType
            && !LogicalPackageManifestJsonBuildTypeReferenceDescriptor(
                strings,
                targetTypeKind,
                targetType))
        {
            return false;
        }

        stack LogicalPackageManifestJsonGenericTemplateCallSignatureRow row =
            new LogicalPackageManifestJsonGenericTemplateCallSignatureRow()
            {
                ParentKind = parentKind,
                FunctionTemplateRow = functionTemplateRow,
                ParentOrdinal = parentOrdinal,
                PublishedOrdinal = publishedOrdinal,
                QualifiedResolvedNameStringIndex = qualifiedResolvedNameStringIndex,
                ReturnType = returnType,
                TargetType = targetType,
                HasPublishedOrdinal = true,
                HasTargetType = hasTargetType
            };
        stack u32[0 max] rowIndex = self.GenericTemplateCallSignatureRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        switch (parentKind)
        {
            case LogicalPackageTemplateCallParentKind.DirectCall:
                if (functionRow.DirectCallCount == 0)
                {
                    functionRow.FirstDirectCallSignatureRow = rowIndex;
                }
                else
                {
                    stack u32[0 max] lastRowIndex = functionRow.LastDirectCallSignatureRow;
                    if (lastRowIndex == 0)
                    {
                        return false;
                    }

                    stack mut LogicalPackageManifestJsonGenericTemplateCallSignatureRow lastRow =
                        self.GenericTemplateCallSignatureRows.Get(lastRowIndex);
                    lastRow.NextRow = rowIndex;
                    if (!self.GenericTemplateCallSignatureRows.Replace(lastRowIndex, lastRow))
                    {
                        return false;
                    }
                }

                functionRow.LastDirectCallSignatureRow = rowIndex;
                functionRow.DirectCallCount = functionRow.DirectCallCount + 1;
            case LogicalPackageTemplateCallParentKind.MemberCall:
                if (functionRow.MemberCallCount == 0)
                {
                    functionRow.FirstMemberCallSignatureRow = rowIndex;
                }
                else
                {
                    stack u32[0 max] lastRowIndex = functionRow.LastMemberCallSignatureRow;
                    if (lastRowIndex == 0)
                    {
                        return false;
                    }

                    stack mut LogicalPackageManifestJsonGenericTemplateCallSignatureRow lastRow =
                        self.GenericTemplateCallSignatureRows.Get(lastRowIndex);
                    lastRow.NextRow = rowIndex;
                    if (!self.GenericTemplateCallSignatureRows.Replace(lastRowIndex, lastRow))
                    {
                        return false;
                    }
                }

                functionRow.LastMemberCallSignatureRow = rowIndex;
                functionRow.MemberCallCount = functionRow.MemberCallCount + 1;
            case LogicalPackageTemplateCallParentKind.FunctionAddress:
                if (functionRow.FunctionAddressCount == 0)
                {
                    functionRow.FirstFunctionAddressSignatureRow = rowIndex;
                }
                else
                {
                    stack u32[0 max] lastRowIndex = functionRow.LastFunctionAddressSignatureRow;
                    if (lastRowIndex == 0)
                    {
                        return false;
                    }

                    stack mut LogicalPackageManifestJsonGenericTemplateCallSignatureRow lastRow =
                        self.GenericTemplateCallSignatureRows.Get(lastRowIndex);
                    lastRow.NextRow = rowIndex;
                    if (!self.GenericTemplateCallSignatureRows.Replace(lastRowIndex, lastRow))
                    {
                        return false;
                    }
                }

                functionRow.LastFunctionAddressSignatureRow = rowIndex;
                functionRow.FunctionAddressCount = functionRow.FunctionAddressCount + 1;
            case LogicalPackageTemplateCallParentKind.BoundOperation:
                return false;
        }

        if (!self.GenericTemplateFunctionRows.Replace(functionTemplateRow, functionRow))
        {
            return false;
        }

        callSignatureRow = rowIndex;
        return true;
    }

