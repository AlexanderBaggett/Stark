    internal fn bool SetTypedInterfaceGlobalScalarConstantInitializer(
        mut borrow LogicalPackageManifestJsonTypedInterfaceBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] globalRow,
        ascii initializerKind,
        ascii initializerTypeKind,
        ascii initializerTypeName,
        ascii integerValue,
        bool hasIntegerValue,
        ascii floatLiteralText,
        bool hasFloatLiteralText,
        bool boolValue,
        bool hasBoolValue,
        ascii textLiteralText,
        bool hasTextLiteralText)
    {
        if (!self.TypedInterfaceGlobalRows.Contains(globalRow))
        {
            return false;
        }

        stack bool isInteger = System.Text.Equals(initializerKind, "integer");
        stack bool isFloat = System.Text.Equals(initializerKind, "float");
        stack bool isBool = System.Text.Equals(initializerKind, "bool");
        stack bool isText = System.Text.Equals(initializerKind, "text");
        stack bool isNull = System.Text.Equals(initializerKind, "null");
        if ((!isInteger && !isFloat && !isBool && !isText && !isNull)
            || (isInteger != hasIntegerValue)
            || (isFloat != hasFloatLiteralText)
            || (isBool != hasBoolValue)
            || (isText != hasTextLiteralText)
            || (isNull
                && (hasIntegerValue || hasFloatLiteralText || hasBoolValue || hasTextLiteralText)))
        {
            return false;
        }

        stack mut u32[0 max] kindStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] typeKindStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] typeNameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] integerValueStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] floatLiteralTextStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] textLiteralTextStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, initializerKind, kindStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, initializerTypeKind, typeKindStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, initializerTypeName, typeNameStringIndex)
            || (hasIntegerValue
                && !LogicalPackageImageStringTableBuilderTryAdd(
                    strings,
                    integerValue,
                    integerValueStringIndex))
            || (hasFloatLiteralText
                && !LogicalPackageImageStringTableBuilderTryAdd(
                    strings,
                    floatLiteralText,
                    floatLiteralTextStringIndex))
            || (hasTextLiteralText
                && !LogicalPackageImageStringTableBuilderTryAdd(
                    strings,
                    textLiteralText,
                    textLiteralTextStringIndex)))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonTypedInterfaceGlobalRow row =
            self.TypedInterfaceGlobalRows.Get(globalRow);
        row.HasConstantInitializer = true;
        row.InitializerKindStringIndex = kindStringIndex;
        row.InitializerTypeKindStringIndex = typeKindStringIndex;
        row.InitializerTypeNameStringIndex = typeNameStringIndex;
        row.InitializerIntegerValueStringIndex = integerValueStringIndex;
        row.InitializerFloatLiteralTextStringIndex = floatLiteralTextStringIndex;
        row.InitializerTextLiteralTextStringIndex = textLiteralTextStringIndex;
        row.HasInitializerIntegerValue = hasIntegerValue;
        row.HasInitializerFloatLiteralText = hasFloatLiteralText;
        row.HasInitializerBoolValue = hasBoolValue;
        row.InitializerBoolValue = boolValue;
        row.HasInitializerTextLiteralText = hasTextLiteralText;
        return self.TypedInterfaceGlobalRows.Replace(globalRow, row);
    }

