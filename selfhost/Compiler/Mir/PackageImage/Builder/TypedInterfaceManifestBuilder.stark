    internal fn bool AddTypedInterfaceFunctionParameter(
        mut borrow LogicalPackageManifestJsonTypedInterfaceBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionRow,
        ascii name,
        ascii typeKind,
        ascii typeName,
        ascii rawPointerElementCountExpression,
        bool hasRawPointerElementCountExpression,
        bool isDisjoint,
        bool isConst)
    {
        if (!self.TypedInterfaceFunctionRows.Contains(functionRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonTypedInterfaceFunctionRow function =
            self.TypedInterfaceFunctionRows.Get(functionRow);
        if (function.ParameterCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] nameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] typeKindStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] typeNameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] rawCountStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, name, nameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, typeKind, typeKindStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, typeName, typeNameStringIndex)
            || (hasRawPointerElementCountExpression
                && !LogicalPackageImageStringTableBuilderTryAdd(
                    strings,
                    rawPointerElementCountExpression,
                    rawCountStringIndex)))
        {
            return false;
        }

        stack LogicalPackageManifestJsonTypedInterfaceFunctionParameterRow row =
            new LogicalPackageManifestJsonTypedInterfaceFunctionParameterRow()
            {
                NameStringIndex = nameStringIndex,
                TypeKindStringIndex = typeKindStringIndex,
                TypeNameStringIndex = typeNameStringIndex,
                RawPointerElementCountExpressionStringIndex = rawCountStringIndex,
                HasRawPointerElementCountExpression = hasRawPointerElementCountExpression,
                IsDisjoint = isDisjoint,
                IsConst = isConst
            };
        stack u32[0 max] rowIndex = self.TypedInterfaceFunctionParameterRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (function.ParameterCount == 0)
        {
            function.ParameterFirstRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = function.ParameterLastRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonTypedInterfaceFunctionParameterRow lastRow =
                self.TypedInterfaceFunctionParameterRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.TypedInterfaceFunctionParameterRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        function.ParameterLastRow = rowIndex;
        function.ParameterCount = function.ParameterCount + 1;
        return self.TypedInterfaceFunctionRows.Replace(functionRow, function);
    }

    internal fn bool AddTypedInterfaceFunctionGenericParameter(
        mut borrow LogicalPackageManifestJsonTypedInterfaceBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionRow,
        ascii name)
    {
        if (!self.TypedInterfaceFunctionRows.Contains(functionRow))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonTypedInterfaceFunctionRow function =
            self.TypedInterfaceFunctionRows.Get(functionRow);
        if (function.GenericParameterCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] nameStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, name, nameStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonTypedInterfaceFunctionGenericParameterRow row =
            new LogicalPackageManifestJsonTypedInterfaceFunctionGenericParameterRow()
            {
                NameStringIndex = nameStringIndex
            };
        stack u32[0 max] rowIndex = self.TypedInterfaceFunctionGenericParameterRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (function.GenericParameterCount == 0)
