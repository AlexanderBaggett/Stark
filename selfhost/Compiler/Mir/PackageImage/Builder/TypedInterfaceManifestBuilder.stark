        TypedInterfaceTypeImplementedTraitRows;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeImplementedTraitTypeRow>
        TypedInterfaceTypeImplementedTraitTypeRows;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeThreadSafetyLawAttributeRow>
        TypedInterfaceTypeThreadSafetyLawAttributeRows;

    LogicalPackageManifestJsonTypedInterfaceBuilder()
    {
        self.ModuleRows = new();
        self.TypedInterfaceFunctionRows = new();
        self.TypedInterfaceFunctionFirstRows = new();
        self.TypedInterfaceFunctionLastRows = new();
        self.TypedInterfaceFunctionCounts = new();
        self.TypedInterfaceFunctionParameterRows = new();
        self.TypedInterfaceFunctionGenericParameterRows = new();
        self.TypedInterfaceFunctionComptimeGenericParameterRows = new();
        self.TypedInterfaceFunctionDeadParameterNameRows = new();
        self.TypedInterfaceGlobalRows = new();
        self.TypedInterfaceGlobalFirstRows = new();
        self.TypedInterfaceGlobalLastRows = new();
        self.TypedInterfaceGlobalCounts = new();
        self.TypedInterfaceTypeAliasRows = new();
        self.TypedInterfaceTypeAliasFirstRows = new();
        self.TypedInterfaceTypeAliasLastRows = new();
        self.TypedInterfaceTypeAliasCounts = new();
        self.TypedInterfaceTypeAliasGenericParameterRows = new();
        self.TypedInterfaceTypeAliasComptimeGenericParameterRows = new();
        self.TypedInterfaceTypeRows = new();
        self.TypedInterfaceTypeFirstRows = new();
        self.TypedInterfaceTypeLastRows = new();
        self.TypedInterfaceTypeCounts = new();
        self.TypedInterfaceTypeFieldRows = new();
        self.TypedInterfaceTypeGenericParameterRows = new();
        self.TypedInterfaceTypeComptimeGenericParameterRows = new();
        self.TypedInterfaceTypeAssociatedTypeRows = new();
        self.TypedInterfaceTypeEnumVariantRows = new();
        self.TypedInterfaceTypeEnumVariantPayloadRows = new();
        self.TypedInterfaceTypeImplementedTraitRows = new();
        self.TypedInterfaceTypeImplementedTraitTypeRows = new();
        self.TypedInterfaceTypeThreadSafetyLawAttributeRows = new();
    }

    internal fn bool AddModule(mut borrow LogicalPackageManifestJsonTypedInterfaceBuilder self)
    {
        return self.ModuleRows.Add(false) != 0
            && self.TypedInterfaceFunctionFirstRows.Add(0) != 0
            && self.TypedInterfaceFunctionLastRows.Add(0) != 0
            && self.TypedInterfaceFunctionCounts.Add(0) != 0
            && self.TypedInterfaceGlobalFirstRows.Add(0) != 0
            && self.TypedInterfaceGlobalLastRows.Add(0) != 0
            && self.TypedInterfaceGlobalCounts.Add(0) != 0
            && self.TypedInterfaceTypeAliasFirstRows.Add(0) != 0
            && self.TypedInterfaceTypeAliasLastRows.Add(0) != 0
            && self.TypedInterfaceTypeAliasCounts.Add(0) != 0
            && self.TypedInterfaceTypeFirstRows.Add(0) != 0
            && self.TypedInterfaceTypeLastRows.Add(0) != 0
            && self.TypedInterfaceTypeCounts.Add(0) != 0;
    }

    internal fn bool AddTypedInterfaceTypeAlias(
        mut borrow LogicalPackageManifestJsonTypedInterfaceBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] moduleOrdinal,
        ascii name,
        ascii qualifiedName,
        ascii visibility,
        ascii targetTypeKind,
        ascii targetTypeName,
        out u32[0 max] typeAliasRow)
    {
        typeAliasRow = 0;
        stack u32[0 max] moduleRow = moduleOrdinal + 1;
        if (!self.ModuleRows.Contains(moduleRow))
        {
            return false;
        }

        stack u32[0 max] count = self.TypedInterfaceTypeAliasCounts.Get(moduleRow);
        if (count == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] nameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] qualifiedNameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] visibilityStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] targetTypeKindStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] targetTypeNameStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, name, nameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, qualifiedName, qualifiedNameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, visibility, visibilityStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, targetTypeKind, targetTypeKindStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, targetTypeName, targetTypeNameStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonTypedInterfaceTypeAliasRow row =
            new LogicalPackageManifestJsonTypedInterfaceTypeAliasRow()
            {
                NameStringIndex = nameStringIndex,
                QualifiedNameStringIndex = qualifiedNameStringIndex,
                VisibilityStringIndex = visibilityStringIndex,
                TargetTypeKindStringIndex = targetTypeKindStringIndex,
                TargetTypeNameStringIndex = targetTypeNameStringIndex
            };
        stack u32[0 max] rowIndex = self.TypedInterfaceTypeAliasRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (count == 0 && !self.TypedInterfaceTypeAliasFirstRows.Replace(moduleRow, rowIndex))
        {
            return false;
        }
        else if (count != 0)
        {
            stack u32[0 max] lastRowIndex = self.TypedInterfaceTypeAliasLastRows.Get(moduleRow);
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonTypedInterfaceTypeAliasRow lastRow =
                self.TypedInterfaceTypeAliasRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.TypedInterfaceTypeAliasRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        if (!self.TypedInterfaceTypeAliasLastRows.Replace(moduleRow, rowIndex)
            || !self.TypedInterfaceTypeAliasCounts.Replace(moduleRow, count + 1))
        {
            return false;
        }

        typeAliasRow = rowIndex;
        return true;
    }

