    internal fn bool AddTypedInterfaceFunction(
        mut borrow LogicalPackageManifestJsonTypedInterfaceBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] moduleOrdinal,
        ascii name,
        ascii qualifiedName,
        ascii visibility,
        ascii symbolName,
        ascii manifestKind,
        ascii returnTypeKind,
        ascii returnTypeName,
        bool isFfi,
        bool isStrictFp,
        bool usesFastCallingConvention,
        out u32[0 max] functionRow)
    {
        functionRow = 0;
        stack u32[0 max] moduleRow = moduleOrdinal + 1;
        if (!self.ModuleRows.Contains(moduleRow))
        {
            return false;
        }

        stack u32[0 max] count = self.TypedInterfaceFunctionCounts.Get(moduleRow);
        if (count == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
