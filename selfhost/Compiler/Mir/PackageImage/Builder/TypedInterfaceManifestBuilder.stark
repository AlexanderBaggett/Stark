    internal IrTable<u32[0 max]> TypedInterfaceTypeAliasLastRows;
    internal IrTable<u32[0 max]> TypedInterfaceTypeAliasCounts;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeAliasGenericParameterRow>
        TypedInterfaceTypeAliasGenericParameterRows;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeAliasComptimeGenericParameterRow>
        TypedInterfaceTypeAliasComptimeGenericParameterRows;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeRow> TypedInterfaceTypeRows;
    internal IrTable<u32[0 max]> TypedInterfaceTypeFirstRows;
    internal IrTable<u32[0 max]> TypedInterfaceTypeLastRows;
    internal IrTable<u32[0 max]> TypedInterfaceTypeCounts;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeFieldRow> TypedInterfaceTypeFieldRows;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeGenericParameterRow>
        TypedInterfaceTypeGenericParameterRows;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeComptimeGenericParameterRow>
        TypedInterfaceTypeComptimeGenericParameterRows;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeAssociatedTypeRow>
        TypedInterfaceTypeAssociatedTypeRows;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceTypeEnumVariantRow>
        TypedInterfaceTypeEnumVariantRows;
