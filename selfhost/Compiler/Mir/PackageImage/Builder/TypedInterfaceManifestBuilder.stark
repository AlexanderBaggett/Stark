        stack LogicalPackageManifestJsonTypedInterfaceTypeAliasGenericParameterRow row =
            new LogicalPackageManifestJsonTypedInterfaceTypeAliasGenericParameterRow()
            {
                NameStringIndex = nameStringIndex
            };
        stack u32[0 max] rowIndex = self.TypedInterfaceTypeAliasGenericParameterRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (aliasRow.GenericParameterCount == 0)
        {
            aliasRow.GenericParameterFirstRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = aliasRow.GenericParameterLastRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonTypedInterfaceTypeAliasGenericParameterRow lastRow =
                self.TypedInterfaceTypeAliasGenericParameterRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.TypedInterfaceTypeAliasGenericParameterRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        aliasRow.GenericParameterLastRow = rowIndex;
        aliasRow.GenericParameterCount = aliasRow.GenericParameterCount + 1;
        return self.TypedInterfaceTypeAliasRows.Replace(typeAliasRow, aliasRow);
    }

