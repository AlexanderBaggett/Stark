        stack mut u32[0 max] nameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] qualifiedNameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] visibilityStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] symbolNameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] kindStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] returnTypeKindStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] returnTypeNameStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(strings, name, nameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, qualifiedName, qualifiedNameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, visibility, visibilityStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, symbolName, symbolNameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, manifestKind, kindStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, returnTypeKind, returnTypeKindStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(strings, returnTypeName, returnTypeNameStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonTypedInterfaceFunctionRow row =
            new LogicalPackageManifestJsonTypedInterfaceFunctionRow()
            {
                NameStringIndex = nameStringIndex,
                QualifiedNameStringIndex = qualifiedNameStringIndex,
                VisibilityStringIndex = visibilityStringIndex,
                SymbolNameStringIndex = symbolNameStringIndex,
                KindStringIndex = kindStringIndex,
                ReturnTypeKindStringIndex = returnTypeKindStringIndex,
                ReturnTypeNameStringIndex = returnTypeNameStringIndex,
                IsFfi = isFfi,
                IsStrictFp = isStrictFp,
                UsesFastCallingConvention = usesFastCallingConvention
            };
        stack u32[0 max] rowIndex = self.TypedInterfaceFunctionRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (count == 0 && !self.TypedInterfaceFunctionFirstRows.Replace(moduleRow, rowIndex))
        {
            return false;
        }
        else if (count != 0)
        {
            stack u32[0 max] lastRowIndex = self.TypedInterfaceFunctionLastRows.Get(moduleRow);
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonTypedInterfaceFunctionRow lastRow =
                self.TypedInterfaceFunctionRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.TypedInterfaceFunctionRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        if (!self.TypedInterfaceFunctionLastRows.Replace(moduleRow, rowIndex)
            || !self.TypedInterfaceFunctionCounts.Replace(moduleRow, count + 1))
        {
            return false;
        }

        functionRow = rowIndex;
        return true;
    }

    internal fn bool SetTypedInterfaceFunctionFlags(
        mut borrow LogicalPackageManifestJsonTypedInterfaceBuilder self,
        mut borrow LogicalPackageImageStringTableBuilder strings,
        u32[0 max] functionRow,
        bool hasGenericTemplateBody,
        bool isHot,
        bool isCold,
        bool hasExplicitInlinePreference,
        bool isUnsafe,
        bool isVarargs,
        bool isTailCallable,
        bool hasBody)
    {
        if (!self.TypedInterfaceFunctionRows.Contains(functionRow) || (isHot && isCold))
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonTypedInterfaceFunctionRow row =
            self.TypedInterfaceFunctionRows.Get(functionRow);
        row.HasGenericTemplateBody = hasGenericTemplateBody;
        row.IsHot = isHot;
        row.IsCold = isCold;
        row.HasExplicitInlinePreference = hasExplicitInlinePreference;
        row.IsUnsafe = isUnsafe;
        row.IsVarargs = isVarargs;
        row.IsTailCallable = isTailCallable;
        row.HasBody = hasBody;
        return self.TypedInterfaceFunctionRows.Replace(functionRow, row);
    }

