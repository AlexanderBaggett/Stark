module Compiler.Mir.PackageImage.Builder.TypedInterfaceManifestBuilder

// Typed-interface row ownership for the temporary logical-manifest accumulator.
internal struct LogicalPackageManifestJsonTypedInterfaceBuilder
{
    internal IrTable<bool> ModuleRows;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceFunctionRow> TypedInterfaceFunctionRows;
    internal IrTable<u32[0 max]> TypedInterfaceFunctionFirstRows;
    internal IrTable<u32[0 max]> TypedInterfaceFunctionLastRows;
    internal IrTable<u32[0 max]> TypedInterfaceFunctionCounts;
    internal IrTable<LogicalPackageManifestJsonTypedInterfaceFunctionParameterRow>
        TypedInterfaceFunctionParameterRows;
