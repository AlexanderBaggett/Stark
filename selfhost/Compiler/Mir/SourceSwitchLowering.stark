internal finite law u32[0 max] MatchingBracketForMirLowering(borrow TokenStream stream, u32[0 max] open)
{
    stack mut u32[0 max] index = open;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return open;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return index;
                }
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return open;
}

internal fn bool TryParseMirSourceDeclarations(borrow TokenStream stream, out DeclarationList declarations)
{
    declarations = new();
    stack mut CompilationUnitHeader header = new();
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var parsedHeader):
            header = parsedHeader;
    }

    switch (ParseDeclarations(stream, header.NextToken))
    {
        case ParseResult<DeclarationList>.Err(var declarationError):
            return false;
        case ParseResult<DeclarationList>.Ok(var parsedDeclarations):
            declarations = parsedDeclarations;
            return true;
    }

    return false;
}

internal fn bool TryGetEnumVariantOrdinalForToken(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    DeclItem enumItem,
    u32[0 max] variantToken,
    out u32[0 max] variantOrdinal)
{
    variantOrdinal = 0;
    switch (ParseEnumVariants(stream, enumItem.KeywordToken))
    {
        case ParseResult<VariantList>.Err(var variantError):
            return false;
        case ParseResult<VariantList>.Ok(var variants):
            stack u64[0 2 ** 63 - 1] count = variants.Count();
            stack mut u64[0 2 ** 63 - 1] index = 0;
            while willexit (index < count)
            {
                if (TokenTextEqualsToken(stream, source, variants.NameTokenAt(index), variantToken))
                {
                    variantOrdinal = (u32[0 max])index;
                    return true;
                }

                index = index + 1;
            }
    }

    return false;
}

internal fn bool SourceSwitchEnumPayloadOrdinalListContains(
    borrow IrTable<u32[0 max]> payloadOrdinals,
    u32[0 max] payloadOrdinal)
{
    stack u64[0 2 ** 63 - 1] count = payloadOrdinals.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (payloadOrdinals.Get((u32[0 max])(index + 1)) == payloadOrdinal)
        {
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool TryGetTerminalSwitchNamedEnumPayloadOrdinal(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadNameToken,
    out u32[0 max] payloadOrdinal)
{
    payloadOrdinal = 0;

    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] rowPayloadNameToken = moduleFacts.EnumLayouts.PayloadNameTokenAt(index);
        if (moduleFacts.EnumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Payload
            && moduleFacts.EnumLayouts.VariantOrdinalAt(index) == variantOrdinal
            && moduleFacts.EnumLayouts.UsesNamedPayloadsAt(index)
            && rowPayloadNameToken != 0
            && TokenTextEqualsToken(stream, source, payloadNameToken, rowPayloadNameToken))
        {
            payloadOrdinal = moduleFacts.EnumLayouts.PayloadOrdinalAt(index);
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal inline finite law u32[0 max] SourceSwitchEnumPayloadPatternKindDiscard()
{
    return 0;
}

internal inline finite law u32[0 max] SourceSwitchEnumPayloadPatternKindScalarInterval()
{
    return 1;
}

internal inline finite law bool SourceSwitchResolvedFieldTypeCodeIsInteger(u32[0 max] typeCode)
{
    return typeCode == SourceResolvedFieldTypeCodeI8()
        || typeCode == SourceResolvedFieldTypeCodeI16()
        || typeCode == SourceResolvedFieldTypeCodeI32()
        || typeCode == SourceResolvedFieldTypeCodeI64();
}

internal inline finite law bool SourceSwitchResolvedFieldTypeCodeSupportsScalarInterval(u32[0 max] typeCode)
{
    return typeCode == SourceResolvedFieldTypeCodeBool()
        || SourceSwitchResolvedFieldTypeCodeIsInteger(typeCode);
}

internal finite law bool SourceSwitchScalarIntervalBoundsAreValidForType(
    u32[0 max] typeCode,
    i64[min max] minValue,
    i64[min max] maxValue)
{
    if (minValue > maxValue)
    {
        return false;
    }

    if (typeCode == SourceResolvedFieldTypeCodeBool())
    {
        return minValue >= 0 && maxValue <= 1;
    }

    if (typeCode == SourceResolvedFieldTypeCodeI8())
    {
        return minValue >= -128 && maxValue <= 127;
    }

    if (typeCode == SourceResolvedFieldTypeCodeI16())
    {
        return minValue >= -32768 && maxValue <= 32767;
    }

    if (typeCode == SourceResolvedFieldTypeCodeI32())
    {
        return minValue >= -2147483648 && maxValue <= 2147483647;
    }

    return typeCode == SourceResolvedFieldTypeCodeI64();
}

internal fn bool SourceSwitchScalarIntervalPatternRowIsValid(
    u32[0 max] row,
    borrow IrTable<u32[0 max]> patternTypeCodes,
    borrow IrTable<u32[0 max]> patternKinds,
    borrow IrTable<i64[min max]> patternMinValues,
    borrow IrTable<i64[min max]> patternMaxValues,
    out u32[0 max] patternTypeCode)
{
    patternTypeCode = SourceResolvedFieldTypeCodeInvalid();
    if (!patternTypeCodes.Contains(row)
        || !patternKinds.Contains(row)
        || !patternMinValues.Contains(row)
        || !patternMaxValues.Contains(row)
        || patternKinds.Get(row) != SourceSwitchEnumPayloadPatternKindScalarInterval())
    {
        return false;
    }

    stack u32[0 max] resolvedPatternTypeCode = patternTypeCodes.Get(row);
    stack i64[min max] minValue = patternMinValues.Get(row);
    stack i64[min max] maxValue = patternMaxValues.Get(row);
    patternTypeCode = resolvedPatternTypeCode;
    return SourceSwitchResolvedFieldTypeCodeSupportsScalarInterval(resolvedPatternTypeCode)
        && SourceSwitchScalarIntervalBoundsAreValidForType(
            resolvedPatternTypeCode,
            minValue,
            maxValue);
}

internal struct SourceSwitchAggregatePatternDescriptor
{
    u32[0 max] OwnerTypeToken;
    u32[0 max] EnumVariantOrdinalPlusOne;
    u32[0 max] FieldPatternStart;
    u32[0 max] FieldPatternCount;

    SourceSwitchAggregatePatternDescriptor()
    {
        self.OwnerTypeToken = 0;
        self.EnumVariantOrdinalPlusOne = 0;
        self.FieldPatternStart = 0;
        self.FieldPatternCount = 0;
    }
}

internal finite law SourceSwitchAggregatePatternDescriptor MakeSourceSwitchAggregatePatternDescriptor(
    u32[0 max] ownerTypeToken,
    u32[0 max] enumVariantOrdinalPlusOne,
    u32[0 max] fieldPatternStart,
    u32[0 max] fieldPatternCount)
{
    stack mut SourceSwitchAggregatePatternDescriptor descriptor = new();
    descriptor.OwnerTypeToken = ownerTypeToken;
    descriptor.EnumVariantOrdinalPlusOne = enumVariantOrdinalPlusOne;
    descriptor.FieldPatternStart = fieldPatternStart;
    descriptor.FieldPatternCount = fieldPatternCount;
    return descriptor;
}

internal inline finite law bool SourceSwitchAggregatePatternHasEnumVariant(SourceSwitchAggregatePatternDescriptor descriptor)
{
    return descriptor.EnumVariantOrdinalPlusOne != 0;
}

internal finite law u32[0 max] SourceSwitchAggregatePatternEnumVariantOrdinal(SourceSwitchAggregatePatternDescriptor descriptor)
{
    if (descriptor.EnumVariantOrdinalPlusOne == 0)
    {
        return 0;
    }

    return descriptor.EnumVariantOrdinalPlusOne - 1;
}

internal struct SourceSwitchListPatternDescriptor
{
    u32[0 max] ElementTypeCode;
    u32[0 max] FixedLength;
    u32[0 max] ElementPatternStart;
    u32[0 max] ElementPatternCount;

    SourceSwitchListPatternDescriptor()
    {
        self.ElementTypeCode = SourceResolvedFieldTypeCodeInvalid();
        self.FixedLength = 0;
        self.ElementPatternStart = 0;
        self.ElementPatternCount = 0;
    }
}

internal finite law SourceSwitchListPatternDescriptor MakeSourceSwitchListPatternDescriptor(
    u32[0 max] elementTypeCode,
    u32[0 max] fixedLength,
    u32[0 max] elementPatternStart,
    u32[0 max] elementPatternCount)
{
    stack mut SourceSwitchListPatternDescriptor descriptor = new();
    descriptor.ElementTypeCode = elementTypeCode;
    descriptor.FixedLength = fixedLength;
    descriptor.ElementPatternStart = elementPatternStart;
    descriptor.ElementPatternCount = elementPatternCount;
    return descriptor;
}

internal fn bool TryBuildSourceSwitchListPatternCaseDescriptors(
    ParamAbiFacts fixedArrayFacts,
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    mut borrow IrTable<SourceSwitchListPatternDescriptor> descriptors,
    mut borrow IrTable<u32[0 max]> caseDescriptorRows)
{
    stack u64[0 2 ** 63 - 1] count = casePatternStarts.Count();
    if (casePatternCounts.Count() != count
        || !fixedArrayFacts.IsFixedArray
        || fixedArrayFacts.FixedArrayLength == 0
        || fixedArrayFacts.FixedArrayFieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] row = (u32[0 max])(index + 1);
        stack u32[0 max] patternStart = casePatternStarts.Get(row);
        stack u32[0 max] patternCount = casePatternCounts.Get(row);
        stack SourceSwitchListPatternDescriptor descriptor = MakeSourceSwitchListPatternDescriptor(
            fixedArrayFacts.FixedArrayFieldTypeCode,
            fixedArrayFacts.FixedArrayLength,
            patternStart,
            patternCount);
        stack u32[0 max] descriptorRow = descriptors.Add(descriptor);
        if (descriptorRow == 0 || caseDescriptorRows.Add(descriptorRow) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool TryBuildSourceSwitchAggregatePatternCaseDescriptors(
    u32[0 max] ownerTypeToken,
    u32[0 max] enumVariantOrdinalPlusOne,
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    mut borrow IrTable<SourceSwitchAggregatePatternDescriptor> descriptors,
    mut borrow IrTable<u32[0 max]> caseDescriptorRows)
{
    stack u64[0 2 ** 63 - 1] count = casePatternStarts.Count();
    if (casePatternCounts.Count() != count || ownerTypeToken == 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] row = (u32[0 max])(index + 1);
        stack u32[0 max] patternStart = casePatternStarts.Get(row);
        stack u32[0 max] patternCount = casePatternCounts.Get(row);
        stack SourceSwitchAggregatePatternDescriptor descriptor =
            MakeSourceSwitchAggregatePatternDescriptor(
                ownerTypeToken,
                enumVariantOrdinalPlusOne,
                patternStart,
                patternCount);
        stack u32[0 max] descriptorRow = descriptors.Add(descriptor);
        if (descriptorRow == 0 || caseDescriptorRows.Add(descriptorRow) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool TryGetSourceSwitchEnumVariantOrdinalForTag(
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    i64[min max] tagValue,
    out u32[0 max] variantOrdinal)
{
    variantOrdinal = 0;
    if (tagValue < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (moduleFacts.EnumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Variant
            && (i64[min max])moduleFacts.EnumLayouts.VariantTagAt(index) == tagValue)
        {
            variantOrdinal = moduleFacts.EnumLayouts.VariantOrdinalAt(index);
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool SourceSwitchEnumPayloadPatternRowsMatchVariant(
    u32[0 max] variantOrdinal,
    u32[0 max] patternStart,
    u32[0 max] patternCount,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals)
{
    stack mut u32[0 max] offset = 0;
    while willexit (offset < patternCount)
    {
        stack u32[0 max] row = patternStart + offset;
        if (!payloadPatternVariantOrdinals.Contains(row)
            || payloadPatternVariantOrdinals.Get(row) != variantOrdinal)
        {
            return false;
        }

        offset = offset + 1;
    }

    return true;
}

internal fn bool TryBuildSourceSwitchEnumAggregatePatternCaseDescriptors(
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    mut borrow IrTable<SourceSwitchAggregatePatternDescriptor> descriptors,
    mut borrow IrTable<u32[0 max]> caseDescriptorRows)
{
    stack u64[0 2 ** 63 - 1] count = caseValues.Count();
    if (casePatternStarts.Count() != count || casePatternCounts.Count() != count)
    {
        return false;
    }

    stack u32[0 max] ownerTypeToken = ownerDeclarationIndex + 1;
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] row = (u32[0 max])(index + 1);
        stack i64[min max] tagValue = caseValues.Get(row);
        stack u32[0 max] patternStart = casePatternStarts.Get(row);
        stack u32[0 max] patternCount = casePatternCounts.Get(row);
        stack mut u32[0 max] variantOrdinal = 0;
        if (patternCount != 0)
        {
            if (!payloadPatternVariantOrdinals.Contains(patternStart))
            {
                return false;
            }

            variantOrdinal = payloadPatternVariantOrdinals.Get(patternStart);
            stack mut u64[0 max] patternVariantTag = 0;
            if (!moduleFacts.EnumLayouts.TryGetEnumVariantTag(
                    ownerDeclarationIndex,
                    variantOrdinal,
                    patternVariantTag)
                || (i64[min max])patternVariantTag != tagValue)
            {
                return false;
            }
        }
        else if (!TryGetSourceSwitchEnumVariantOrdinalForTag(
                moduleFacts,
                ownerDeclarationIndex,
                tagValue,
                variantOrdinal))
        {
            return false;
        }

        if (!SourceSwitchEnumPayloadPatternRowsMatchVariant(
                variantOrdinal,
                patternStart,
                patternCount,
                payloadPatternVariantOrdinals))
        {
            return false;
        }

        stack SourceSwitchAggregatePatternDescriptor descriptor =
            MakeSourceSwitchAggregatePatternDescriptor(
                ownerTypeToken,
                variantOrdinal + 1,
                patternStart,
                patternCount);
        stack u32[0 max] descriptorRow = descriptors.Add(descriptor);
        if (descriptorRow == 0 || caseDescriptorRows.Add(descriptorRow) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool SourceSwitchListPatternDescriptorRowsAreValid(
    borrow IrTable<SourceSwitchListPatternDescriptor> descriptors,
    borrow IrTable<u32[0 max]> caseDescriptorRows,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues)
{
    stack u64[0 2 ** 63 - 1] count = caseDescriptorRows.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] descriptorRow = caseDescriptorRows.Get((u32[0 max])(index + 1));
        if (!descriptors.Contains(descriptorRow))
        {
            return false;
        }

        stack SourceSwitchListPatternDescriptor descriptor = descriptors.Get(descriptorRow);
        if (!SourceSwitchResolvedFieldTypeCodeSupportsScalarInterval(descriptor.ElementTypeCode)
            || descriptor.FixedLength == 0)
        {
            return false;
        }

        stack mut u32[0 max] offset = 0;
        while willexit (offset < descriptor.ElementPatternCount)
        {
            if (descriptor.ElementPatternStart > 4294967295 - offset)
            {
                return false;
            }

            stack u32[0 max] row = descriptor.ElementPatternStart + offset;
            stack mut u32[0 max] patternTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!elementPatternIndices.Contains(row)
                || !SourceSwitchScalarIntervalPatternRowIsValid(
                    row,
                    elementPatternTypeCodes,
                    elementPatternKinds,
                    elementPatternMinValues,
                    elementPatternMaxValues,
                    patternTypeCode)
                || patternTypeCode != descriptor.ElementTypeCode
                || elementPatternIndices.Get(row) >= descriptor.FixedLength)
            {
                return false;
            }

            offset = offset + 1;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool SourceSwitchStructValuePatternDescriptorRowsAreValid(
    u32[0 max] structTypeToken,
    ParamAbiFacts structValueFacts,
    borrow IrTable<SourceSwitchAggregatePatternDescriptor> descriptors,
    borrow IrTable<u32[0 max]> caseDescriptorRows,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternMemberFactRows,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues)
{
    if (!structValueFacts.IsStructValue
        || structValueFacts.StructValueFieldCount == 0
        || structValueFacts.StructValueFieldCount > StructValueShapeMaxFields())
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = caseDescriptorRows.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] descriptorRow = caseDescriptorRows.Get((u32[0 max])(index + 1));
        if (!descriptors.Contains(descriptorRow))
        {
            return false;
        }

        stack SourceSwitchAggregatePatternDescriptor descriptor = descriptors.Get(descriptorRow);
        if (descriptor.OwnerTypeToken != structTypeToken
            || SourceSwitchAggregatePatternHasEnumVariant(descriptor))
        {
            return false;
        }

        stack mut u32[0 max] offset = 0;
        while willexit (offset < descriptor.FieldPatternCount)
        {
            if (descriptor.FieldPatternStart > 4294967295 - offset)
            {
                return false;
            }

            stack u32[0 max] row = descriptor.FieldPatternStart + offset;
            stack mut u32[0 max] patternTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!fieldPatternIndices.Contains(row)
                || !fieldPatternMemberFactRows.Contains(row)
                || !SourceSwitchScalarIntervalPatternRowIsValid(
                    row,
                    fieldPatternTypeCodes,
                    fieldPatternKinds,
                    fieldPatternMinValues,
                    fieldPatternMaxValues,
                    patternTypeCode))
            {
                return false;
            }

            stack u32[0 max] fieldIndex = fieldPatternIndices.Get(row);
            stack MirType fieldType = MirTypeForResolvedFieldTypeCode(patternTypeCode);
            if (fieldIndex >= structValueFacts.StructValueFieldCount
                || !StructValueShapeTypeIsSupported(fieldType)
                || StructValueShapeFieldStorageCodeAt(structValueFacts, fieldIndex) != StructValueShapeTypeCode(fieldType))
            {
                return false;
            }

            offset = offset + 1;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool SourceSwitchStructStoragePatternDescriptorRowsAreValid(
    u32[0 max] structTypeToken,
    u32[0 max] structBaseByteOffset,
    borrow IrTable<SourceSwitchAggregatePatternDescriptor> descriptors,
    borrow IrTable<u32[0 max]> caseDescriptorRows,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternOffsets,
    borrow IrTable<u32[0 max]> fieldPatternAlignments,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternMemberFactRows,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues)
{
    stack u64[0 2 ** 63 - 1] count = caseDescriptorRows.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] descriptorRow = caseDescriptorRows.Get((u32[0 max])(index + 1));
        if (!descriptors.Contains(descriptorRow))
        {
            return false;
        }

        stack SourceSwitchAggregatePatternDescriptor descriptor = descriptors.Get(descriptorRow);
        if (descriptor.OwnerTypeToken != structTypeToken
            || SourceSwitchAggregatePatternHasEnumVariant(descriptor))
        {
            return false;
        }

        stack mut u32[0 max] offset = 0;
        while willexit (offset < descriptor.FieldPatternCount)
        {
            if (descriptor.FieldPatternStart > 4294967295 - offset)
            {
                return false;
            }

            stack u32[0 max] row = descriptor.FieldPatternStart + offset;
            stack mut u32[0 max] patternTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!fieldPatternIndices.Contains(row)
                || !fieldPatternOffsets.Contains(row)
                || !fieldPatternAlignments.Contains(row)
                || !fieldPatternMemberFactRows.Contains(row)
                || !SourceSwitchScalarIntervalPatternRowIsValid(
                    row,
                    fieldPatternTypeCodes,
                    fieldPatternKinds,
                    fieldPatternMinValues,
                    fieldPatternMaxValues,
                    patternTypeCode))
            {
                return false;
            }

            stack u32[0 max] fieldOffset = fieldPatternOffsets.Get(row);
            stack u32[0 max] fieldAlignment = fieldPatternAlignments.Get(row);
            if (fieldAlignment == 0 || fieldOffset > 4294967295 - structBaseByteOffset)
            {
                return false;
            }

            offset = offset + 1;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool SourceSwitchEnumPayloadPatternDescriptorRowsAreValid(
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<SourceSwitchAggregatePatternDescriptor> descriptors,
    borrow IrTable<u32[0 max]> caseDescriptorRows,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternTypeCodes,
    borrow IrTable<u32[0 max]> payloadPatternKinds,
    borrow IrTable<i64[min max]> payloadPatternMinValues,
    borrow IrTable<i64[min max]> payloadPatternMaxValues)
{
    stack u64[0 2 ** 63 - 1] count = caseDescriptorRows.Count();
    if (caseValues.Count() != count)
    {
        return false;
    }

    stack u32[0 max] ownerTypeToken = ownerDeclarationIndex + 1;
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(index + 1);
        stack u32[0 max] descriptorRow = caseDescriptorRows.Get(caseSlot);
        if (!descriptors.Contains(descriptorRow))
        {
            return false;
        }

        stack SourceSwitchAggregatePatternDescriptor descriptor = descriptors.Get(descriptorRow);
        if (descriptor.OwnerTypeToken != ownerTypeToken
            || !SourceSwitchAggregatePatternHasEnumVariant(descriptor))
        {
            return false;
        }

        stack u32[0 max] variantOrdinal = SourceSwitchAggregatePatternEnumVariantOrdinal(descriptor);
        stack mut u64[0 max] variantTag = 0;
        if (!moduleFacts.EnumLayouts.TryGetEnumVariantTag(ownerDeclarationIndex, variantOrdinal, variantTag)
            || (i64[min max])variantTag != caseValues.Get(caseSlot)
            || !SourceSwitchEnumPayloadPatternRowsMatchVariant(
                variantOrdinal,
                descriptor.FieldPatternStart,
                descriptor.FieldPatternCount,
                payloadPatternVariantOrdinals))
        {
            return false;
        }

        stack mut u32[0 max] offset = 0;
        while willexit (offset < descriptor.FieldPatternCount)
        {
            if (descriptor.FieldPatternStart > 4294967295 - offset)
            {
                return false;
            }

            stack u32[0 max] row = descriptor.FieldPatternStart + offset;
            stack mut u32[0 max] patternTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!payloadPatternOrdinals.Contains(row)
                || !SourceSwitchScalarIntervalPatternRowIsValid(
                    row,
                    payloadPatternTypeCodes,
                    payloadPatternKinds,
                    payloadPatternMinValues,
                    payloadPatternMaxValues,
                    patternTypeCode))
            {
                return false;
            }

            stack u32[0 max] payloadOrdinal = payloadPatternOrdinals.Get(row);
            stack mut u64[0 max] payloadOffset = 0;
            stack mut u64[0 max] payloadSize = 0;
            stack mut u64[0 max] payloadAlignment = 0;
            stack mut bool payloadMisaligned = false;
            if (!moduleFacts.EnumLayouts.TryGetEnumVariantPayloadLayout(
                    ownerDeclarationIndex,
                    variantOrdinal,
                    payloadOrdinal,
                    payloadOffset,
                    payloadSize,
                    payloadAlignment,
                    payloadMisaligned))
            {
                return false;
            }

            offset = offset + 1;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool TryGetSourceSwitchEnumTagType(
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    out MirType tagType)
{
    tagType = MirType.I8;
    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (moduleFacts.EnumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Variant)
        {
            stack u32[0 max] bitWidth = moduleFacts.EnumLayouts.BitWidthAt(index);
            if (bitWidth <= 1)
            {
                tagType = MirType.I1;
                return true;
            }

            if (bitWidth <= 8)
            {
                tagType = MirType.I8;
                return true;
            }

            if (bitWidth <= 16)
            {
                tagType = MirType.I16;
                return true;
            }

            if (bitWidth <= 32)
            {
                tagType = MirType.I32;
                return true;
            }

            if (bitWidth <= 64)
            {
                tagType = MirType.I64;
                return true;
            }

            return false;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool TryParseSourceSwitchEnumPayloadScalarPattern(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] payloadTypeCode,
    u64[0 2 ** 63 - 1] valueStart,
    out u32[0 max] patternKind,
    out i64[min max] minValue,
    out i64[min max] maxValue,
    out u64[0 2 ** 63 - 1] nextToken)
{
    patternKind = SourceSwitchEnumPayloadPatternKindDiscard();
    minValue = 0;
    maxValue = 0;
    nextToken = valueStart;
    if (stream.KindAt(valueStart) == TokenKind.Discard)
    {
        nextToken = valueStart + 1;
        return true;
    }

    if (payloadTypeCode == SourceResolvedFieldTypeCodeBool())
    {
        stack mut u32[0 max] boolValue = 0;
        if (!TryParseTerminalSwitchBooleanCaseLabel(stream, valueStart, boolValue, nextToken))
        {
            return false;
        }

        patternKind = SourceSwitchEnumPayloadPatternKindScalarInterval();
        minValue = (i64[min max])boolValue;
        maxValue = (i64[min max])boolValue;
        return true;
    }

    if (SourceSwitchResolvedFieldTypeCodeIsInteger(payloadTypeCode))
    {
        if (!TryParseTerminalSwitchIntegerCaseInterval(stream, source, valueStart, minValue, maxValue, nextToken))
        {
            return false;
        }

        patternKind = SourceSwitchEnumPayloadPatternKindScalarInterval();
        return true;
    }

    return false;
}

internal fn bool TryParseSourceSwitchEnumPayloadScalarOrCapturePattern(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] payloadTypeCode,
    bool allowPayloadCapture,
    u64[0 2 ** 63 - 1] valueStart,
    out u32[0 max] patternKind,
    out i64[min max] minValue,
    out i64[min max] maxValue,
    out u32[0 max] captureNameToken,
    out u64[0 2 ** 63 - 1] nextToken)
{
    patternKind = SourceSwitchEnumPayloadPatternKindDiscard();
    minValue = 0;
    maxValue = 0;
    captureNameToken = 0;
    nextToken = valueStart;
    if (allowPayloadCapture
        && stream.KindAt(valueStart) == TokenKind.Var
        && stream.KindAt(valueStart + 1) == TokenKind.Identifier
        && (payloadTypeCode == SourceResolvedFieldTypeCodeBool() || SourceSwitchResolvedFieldTypeCodeIsInteger(payloadTypeCode)))
    {
        captureNameToken = (u32[0 max])(valueStart + 1);
        nextToken = valueStart + 2;
        return true;
    }

    return TryParseSourceSwitchEnumPayloadScalarPattern(
        stream,
        source,
        payloadTypeCode,
        valueStart,
        patternKind,
        minValue,
        maxValue,
        nextToken);
}

internal fn bool TryParseTerminalSwitchEnumNamedPayloadLabel(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u64[0 max] payloadCount,
    u64[0 2 ** 63 - 1] openBrace,
    out u64[0 2 ** 63 - 1] nextToken)
{
    nextToken = openBrace;
    if (stream.KindAt(openBrace) != TokenKind.LBrace)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> seenPayloadOrdinals = new();
    stack mut u64[0 max] parsedPayloads = 0;
    stack mut u64[0 2 ** 63 - 1] cursor = openBrace + 1;
    while willexit (parsedPayloads < payloadCount)
    {
        if (stream.KindAt(cursor) != TokenKind.Identifier
            || stream.KindAt(cursor + 1) != TokenKind.Colon
            || stream.KindAt(cursor + 2) != TokenKind.Discard)
        {
            return false;
        }

        stack mut u32[0 max] payloadOrdinal = 0;
        if (!TryGetTerminalSwitchNamedEnumPayloadOrdinal(
                stream,
                source,
                moduleFacts,
                ownerDeclarationIndex,
                variantOrdinal,
                (u32[0 max])cursor,
                payloadOrdinal)
            || SourceSwitchEnumPayloadOrdinalListContains(seenPayloadOrdinals, payloadOrdinal)
            || seenPayloadOrdinals.Add(payloadOrdinal) == 0)
        {
            return false;
        }

        parsedPayloads = parsedPayloads + 1;
        cursor = cursor + 3;
        if (parsedPayloads < payloadCount)
        {
            if (stream.KindAt(cursor) != TokenKind.Comma)
            {
                return false;
            }

            cursor = cursor + 1;
        }
        else if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            cursor = cursor + 1;
        }
    }

    if (stream.KindAt(cursor) != TokenKind.RBrace)
    {
        return false;
    }

    nextToken = cursor + 1;
    return true;
}

internal fn bool TryParseTerminalSwitchEnumCaseLabel(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    u64[0 2 ** 63 - 1] valueStart,
    out i64[min max] value,
    out u64[0 2 ** 63 - 1] nextToken)
{
    value = 0;
    nextToken = valueStart;
    if ((u64[0 2 ** 63 - 1])ownerDeclarationIndex >= moduleFacts.Declarations.Count())
    {
        return false;
    }

    stack DeclItem enumItem = moduleFacts.Declarations.ItemAt((u64[0 2 ** 63 - 1])ownerDeclarationIndex);
    if (enumItem.Kind != DeclarationKind.Enum
        || enumItem.NameToken == 0
        || stream.KindAt(valueStart) != TokenKind.Identifier
        || stream.KindAt(valueStart + 1) != TokenKind.Dot
        || stream.KindAt(valueStart + 2) != TokenKind.Identifier
        || !TokenTextEqualsToken(stream, source, (u32[0 max])valueStart, enumItem.NameToken))
    {
        return false;
    }

    stack mut u32[0 max] variantOrdinal = 0;
    if (!TryGetEnumVariantOrdinalForToken(stream, source, enumItem, (u32[0 max])(valueStart + 2), variantOrdinal))
    {
        return false;
    }

    stack mut u64[0 max] payloadCount = 0;
    stack mut u64[0 max] tagValue = 0;
    if (!moduleFacts.EnumLayouts.TryGetEnumVariantPayloadCount(ownerDeclarationIndex, variantOrdinal, payloadCount)
        || !moduleFacts.EnumLayouts.TryGetEnumVariantTag(ownerDeclarationIndex, variantOrdinal, tagValue))
    {
        return false;
    }

    if (payloadCount == 0)
    {
        value = (i64[min max])tagValue;
        nextToken = valueStart + 3;
        return true;
    }

    if (stream.KindAt(valueStart + 3) == TokenKind.LBrace)
    {
        if (!TryParseTerminalSwitchEnumNamedPayloadLabel(
                stream,
                source,
                moduleFacts,
                ownerDeclarationIndex,
                variantOrdinal,
                payloadCount,
                valueStart + 3,
                nextToken))
        {
            return false;
        }

        value = (i64[min max])tagValue;
        return true;
    }

    if (stream.KindAt(valueStart + 3) != TokenKind.LParen)
    {
        return false;
    }

    stack mut u64[0 max] parsedPayloads = 0;
    stack mut u64[0 2 ** 63 - 1] cursor = valueStart + 4;
    while willexit (parsedPayloads < payloadCount)
    {
        if (stream.KindAt(cursor) != TokenKind.Discard)
        {
            return false;
        }

        parsedPayloads = parsedPayloads + 1;
        cursor = cursor + 1;
        if (parsedPayloads < payloadCount)
        {
            if (stream.KindAt(cursor) != TokenKind.Comma)
            {
                return false;
            }

            cursor = cursor + 1;
        }
        else if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            cursor = cursor + 1;
        }
    }

    if (stream.KindAt(cursor) != TokenKind.RParen)
    {
        return false;
    }

    value = (i64[min max])tagValue;
    nextToken = cursor + 1;
    return true;
}

