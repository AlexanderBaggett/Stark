internal fn bool LowerModuleTerminalEnumSwitchFunctionToBlocks(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (AsciiLength(sourceText) == 0 || !FunctionBodyStartsWithTerminalSwitch(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut u32[0 max] caseOwnerDeclarationIndex = 0;
    if (!TryGetSwitchFirstEnumCaseOwnerDeclarationIndex(
        stream,
        source,
        moduleFacts,
        (u64[0 2 ** 63 - 1])braceIndex + 1,
        caseOwnerDeclarationIndex))
    {
        return false;
    }

    stack mut u32[0 max] enumReturnOwnerDeclarationIndex = 0;
    stack mut Compiler.Parsing.DeclItem enumReturnItem = new();
    if (TryGetSourceEnumOwnerDeclarationForToken(
        stream,
        source,
        moduleFacts,
        signature.ReturnTypeTokenAt(),
        enumReturnOwnerDeclarationIndex,
        enumReturnItem))
    {
        stack mut IrTable<u32[0 max]> enumLocalTypes = new();
        if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, enumLocalTypes))
        {
            return false;
        }

        stack mut IrTable<ValueFacts> sourceValueFacts = new();
        if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
        {
            return false;
        }

        stack mut IrTable<ExprNode> enumNodes = new();
        stack mut ExprParseResult enumScrutinee = new();
        stack mut IrTable<i64[min max]> enumCaseValues = new();
        stack mut IrTable<i64[min max]> enumCaseMaxValues = new();
        stack mut IrTable<ExprParseResult> enumCaseArms = new();
        stack mut IrTable<u32[0 max]> enumCasePayloadPatternStarts = new();
        stack mut IrTable<u32[0 max]> enumCasePayloadPatternCounts = new();
        stack mut IrTable<u32[0 max]> enumCasePayloadCaptureStarts = new();
        stack mut IrTable<u32[0 max]> enumCasePayloadCaptureCounts = new();
        stack mut IrTable<u32[0 max]> enumPayloadPatternVariantOrdinals = new();
        stack mut IrTable<u32[0 max]> enumPayloadPatternOrdinals = new();
        stack mut IrTable<u32[0 max]> enumPayloadPatternTypeCodes = new();
        stack mut IrTable<u32[0 max]> enumPayloadPatternKinds = new();
        stack mut IrTable<i64[min max]> enumPayloadPatternMinValues = new();
        stack mut IrTable<i64[min max]> enumPayloadPatternMaxValues = new();
        stack mut IrTable<u32[0 max]> enumPayloadCaptureVariantOrdinals = new();
        stack mut IrTable<u32[0 max]> enumPayloadCaptureOrdinals = new();
        stack mut IrTable<u32[0 max]> enumPayloadCaptureTypeCodes = new();
        stack mut IrTable<u32[0 max]> enumPayloadCaptureNameTokens = new();
        stack mut ExprParseResult enumDefaultArm = new();
        stack mut u64[0 2 ** 63 - 1] enumNextToken = 0;
        if (!TryParseTerminalEnumSwitchReturnCasesWithEnumsAndPayloadPatterns(
            stream,
            source,
            moduleFacts,
            caseOwnerDeclarationIndex,
            enumNodes,
            params,
            funcNames,
            enumLocalTypes,
            sourceValueFacts,
            (u64[0 2 ** 63 - 1])braceIndex + 1,
            enumScrutinee,
            enumCaseValues,
            enumCaseArms,
            enumCasePayloadPatternStarts,
            enumCasePayloadPatternCounts,
            enumCasePayloadCaptureStarts,
            enumCasePayloadCaptureCounts,
            enumPayloadPatternVariantOrdinals,
            enumPayloadPatternOrdinals,
            enumPayloadPatternTypeCodes,
            enumPayloadPatternKinds,
            enumPayloadPatternMinValues,
            enumPayloadPatternMaxValues,
            enumPayloadCaptureVariantOrdinals,
            enumPayloadCaptureOrdinals,
            enumPayloadCaptureTypeCodes,
            enumPayloadCaptureNameTokens,
            enumDefaultArm,
            enumNextToken))
        {
            return false;
        }

        if (!CopyCaseValuesToCaseMaxValues(enumCaseValues, enumCaseMaxValues))
        {
            return false;
        }

        if (stream.KindAt(enumNextToken) != TokenKind.RBrace)
        {
            return false;
        }

        if (params.Count() != signatureParamCount)
        {
            return false;
        }

        stack mut u32[0 max] enumScrutineeOwnerDeclarationIndex = 0;
        if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(enumNodes, enumScrutinee.NodeId, enumLocalTypes, enumScrutineeOwnerDeclarationIndex)
            || enumScrutineeOwnerDeclarationIndex != caseOwnerDeclarationIndex)
        {
            return false;
        }

        stack mut IrTable<DistinctStoragePair> enumDistinctStorageFacts = new();
        if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, enumDistinctStorageFacts))
        {
            return false;
        }

        if (enumPayloadCaptureOrdinals.Count() != 0)
        {
            if (!ValidateModuleCallsForRoot(
                    enumNodes,
                    enumScrutinee.NodeId,
                    funcParamCounts,
                    functionCallContractFacts,
                    enumLocalTypes,
                    enumDistinctStorageFacts)
                || !ValidateModuleCallsForRoot(
                    enumNodes,
                    enumDefaultArm.NodeId,
                    funcParamCounts,
                    functionCallContractFacts,
                    enumLocalTypes,
                    enumDistinctStorageFacts)
                || enumCasePayloadCaptureStarts.Count() != enumCaseArms.Count()
                || enumCasePayloadCaptureCounts.Count() != enumCaseArms.Count())
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] enumCaseCallIndex = 0;
            while willexit (enumCaseCallIndex < enumCaseArms.Count())
            {
                stack ExprParseResult enumCaseArm = enumCaseArms.Get((u32[0 max])(enumCaseCallIndex + 1));
                stack u32[0 max] enumCaptureStart = enumCasePayloadCaptureStarts.Get((u32[0 max])(enumCaseCallIndex + 1));
                stack u32[0 max] enumCaptureCount = enumCasePayloadCaptureCounts.Get((u32[0 max])(enumCaseCallIndex + 1));
                stack mut IrTable<u32[0 max]> enumArmLocalTypes = new();
                if (!BuildTerminalSwitchCaptureLocalTypes(
                        enumPayloadCaptureTypeCodes,
                        enumCaptureStart,
                        enumCaptureCount,
                        enumLocalTypes,
                        enumArmLocalTypes)
                    || !ValidateModuleCallsForRoot(
                        enumNodes,
                        enumCaseArm.NodeId,
                        funcParamCounts,
                        functionCallContractFacts,
                        enumArmLocalTypes,
                        enumDistinctStorageFacts))
                {
                    return false;
                }

                enumCaseCallIndex = enumCaseCallIndex + 1;
            }
        }
        else if (!ValidateModuleCalls(enumNodes, funcParamCounts, functionCallContractFacts, enumLocalTypes, enumDistinctStorageFacts))
        {
            return false;
        }

        stack mut IrTable<u32[0 max]> enumNoOverrides = new();
        stack u32[0 max] enumEntryFirst = (u32[0 max])instrs.Count() + 1;
        stack mut MirType ignoredDeclaredReturnType = MirType.I64;
        stack bool ignoredHasDeclaredReturnType = false;
        if (enumPayloadPatternOrdinals.Count() != 0 || enumPayloadCaptureOrdinals.Count() != 0)
        {
            return LowerTerminalEnumSwitchCasesWithPayloadPatternsToBlocks(
                enumNodes,
                enumScrutinee.NodeId,
                caseOwnerDeclarationIndex,
                moduleFacts,
                enumCaseValues,
                enumCaseArms,
                enumCasePayloadPatternStarts,
                enumCasePayloadPatternCounts,
                enumCasePayloadCaptureStarts,
                enumCasePayloadCaptureCounts,
                enumPayloadPatternVariantOrdinals,
                enumPayloadPatternOrdinals,
                enumPayloadPatternTypeCodes,
                enumPayloadPatternKinds,
                enumPayloadPatternMinValues,
                enumPayloadPatternMaxValues,
                enumPayloadCaptureVariantOrdinals,
                enumPayloadCaptureOrdinals,
                enumPayloadCaptureTypeCodes,
                enumDefaultArm,
                enumLocalTypes,
                enumNoOverrides,
                (u32[0 max])signatureParamCount,
                enumEntryFirst,
                instrs,
                blocks,
                ranges,
                recordRanges,
                ignoredHasDeclaredReturnType,
                ignoredDeclaredReturnType,
                true,
                enumReturnOwnerDeclarationIndex,
                false,
                body);
        }

        return LowerTerminalIntegerSwitchCasesToBlocks(
            enumNodes,
            enumScrutinee.NodeId,
            enumCaseValues,
            enumCaseMaxValues,
            enumCaseArms,
            enumDefaultArm,
            enumLocalTypes,
            enumNoOverrides,
            (u32[0 max])signatureParamCount,
            enumEntryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            ignoredHasDeclaredReturnType,
            ignoredDeclaredReturnType,
            true,
            enumReturnOwnerDeclarationIndex,
            false,
            body);
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<i64[min max]> caseMaxValues = new();
    stack mut IrTable<ExprParseResult> caseArms = new();
    stack mut ExprParseResult defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (!TryParseTerminalEnumSwitchReturnCases(
        stream,
        source,
        moduleFacts,
        caseOwnerDeclarationIndex,
        nodes,
        params,
        funcNames,
        (u64[0 2 ** 63 - 1])braceIndex + 1,
        scrutinee,
        caseValues,
        caseArms,
        defaultArm,
        nextToken))
    {
        return false;
    }

    if (!CopyCaseValuesToCaseMaxValues(caseValues, caseMaxValues))
    {
        return false;
    }

    if (stream.KindAt(nextToken) != TokenKind.RBrace)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut u32[0 max] scrutineeOwnerDeclarationIndex = 0;
    if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, scrutinee.NodeId, localTypes, scrutineeOwnerDeclarationIndex)
        || scrutineeOwnerDeclarationIndex != caseOwnerDeclarationIndex)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    return LowerTerminalIntegerSwitchCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        caseArms,
        defaultArm,
        localTypes,
        noOverrides,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        hasDeclaredReturnType,
        declaredReturnType,
        false,
        0,
        false,
        body);
}

internal fn bool LowerModuleTerminalFixedArrayListSwitchFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyStartsWithTerminalSwitch(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0 || !SwitchFirstCaseLabelIsListPattern(stream, (u64[0 2 ** 63 - 1])braceIndex + 1))
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut u32[0 max] enumReturnOwnerDeclarationIndex = 0;
    stack mut Compiler.Parsing.DeclItem enumReturnItem = new();
    if (TryGetSourceEnumOwnerDeclarationForToken(
        stream,
        source,
        moduleFacts,
        signature.ReturnTypeTokenAt(),
        enumReturnOwnerDeclarationIndex,
        enumReturnItem))
    {
        stack mut IrTable<u32[0 max]> enumLocalTypes = new();
        if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, enumLocalTypes))
        {
            return false;
        }

        stack mut IrTable<ValueFacts> sourceValueFacts = new();
        if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
        {
            return false;
        }

        stack mut IrTable<SourceSliceDescriptorLocal> enumSliceDescriptorLocals = new();
        if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, enumSliceDescriptorLocals))
        {
            return false;
        }

        stack mut IrTable<ExprNode> enumNodes = new();
        stack mut ExprParseResult enumScrutinee = new();
        stack mut u32[0 max] enumFixedArrayParamIndex = 0;
        stack mut ParamAbiFacts enumFixedArrayFacts = new();
        stack mut IrTable<ExprParseResult> enumCaseArms = new();
        stack mut IrTable<u32[0 max]> enumCasePatternStarts = new();
        stack mut IrTable<u32[0 max]> enumCasePatternCounts = new();
        stack mut IrTable<u32[0 max]> enumCaseGuardNodes = new();
        stack mut IrTable<u32[0 max]> enumElementPatternIndices = new();
        stack mut IrTable<u32[0 max]> enumElementPatternTypeCodes = new();
        stack mut IrTable<u32[0 max]> enumElementPatternKinds = new();
        stack mut IrTable<i64[min max]> enumElementPatternMinValues = new();
        stack mut IrTable<i64[min max]> enumElementPatternMaxValues = new();
        stack mut IrTable<u32[0 max]> enumCaseElementCaptureStarts = new();
        stack mut IrTable<u32[0 max]> enumCaseElementCaptureCounts = new();
        stack mut IrTable<u32[0 max]> enumElementCaptureIndices = new();
        stack mut IrTable<u32[0 max]> enumElementCaptureTypeCodes = new();
        stack mut IrTable<u32[0 max]> enumElementCaptureNameTokens = new();
        stack mut ExprParseResult enumDefaultArm = new();
        stack mut u64[0 2 ** 63 - 1] enumNextToken = 0;
        if (!TryParseTerminalFixedArrayListSwitchReturnCasesWithEnums(
            stream,
            source,
            moduleFacts,
            paramAbiFacts,
            enumNodes,
            params,
            funcNames,
            enumLocalTypes,
            sourceValueFacts,
            enumSliceDescriptorLocals,
            (u64[0 2 ** 63 - 1])braceIndex + 1,
            enumScrutinee,
            enumFixedArrayParamIndex,
            enumFixedArrayFacts,
            enumCaseArms,
            enumCasePatternStarts,
            enumCasePatternCounts,
            enumCaseGuardNodes,
            enumElementPatternIndices,
            enumElementPatternTypeCodes,
            enumElementPatternKinds,
            enumElementPatternMinValues,
            enumElementPatternMaxValues,
            enumCaseElementCaptureStarts,
            enumCaseElementCaptureCounts,
            enumElementCaptureIndices,
            enumElementCaptureTypeCodes,
            enumElementCaptureNameTokens,
            enumDefaultArm,
            enumNextToken))
        {
            return false;
        }

        if (stream.KindAt(enumNextToken) != TokenKind.RBrace || params.Count() != signatureParamCount)
        {
            return false;
        }

        stack mut IrTable<DistinctStoragePair> enumDistinctStorageFacts = new();
        if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, enumDistinctStorageFacts))
        {
            return false;
        }

        stack mut IrTable<SourceSliceArgumentLocal> enumSliceArgumentLocals = new();
        if (!BuildSourceSliceArgumentLocals(enumSliceDescriptorLocals, enumSliceArgumentLocals))
        {
            return false;
        }

        if (enumElementCaptureIndices.Count() != 0)
        {
            if (!ValidateModuleCallsForRootWithSlices(
                    enumNodes,
                    enumScrutinee.NodeId,
                    funcParamCounts,
                    functionCallContractFacts,
                    enumLocalTypes,
                    enumSliceDescriptorLocals,
                    enumDistinctStorageFacts)
                || !ValidateModuleCallsForRootWithSlices(
                    enumNodes,
                    enumDefaultArm.NodeId,
                    funcParamCounts,
                    functionCallContractFacts,
                    enumLocalTypes,
                    enumSliceDescriptorLocals,
                    enumDistinctStorageFacts)
                || enumCaseElementCaptureStarts.Count() != enumCaseArms.Count()
                || enumCaseElementCaptureCounts.Count() != enumCaseArms.Count())
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] enumCaseCallIndex = 0;
            while willexit (enumCaseCallIndex < enumCaseArms.Count())
            {
                stack mut u32[0 max] guardNode = 0;
                if (enumCaseGuardNodes.Count() != 0)
                {
                    guardNode = enumCaseGuardNodes.Get((u32[0 max])(enumCaseCallIndex + 1));
                }

                stack ExprParseResult enumCaseArm = enumCaseArms.Get((u32[0 max])(enumCaseCallIndex + 1));
                stack u32[0 max] enumCaptureStart = enumCaseElementCaptureStarts.Get((u32[0 max])(enumCaseCallIndex + 1));
                stack u32[0 max] enumCaptureCount = enumCaseElementCaptureCounts.Get((u32[0 max])(enumCaseCallIndex + 1));
                stack mut IrTable<u32[0 max]> enumArmLocalTypes = new();
                stack mut IrTable<SourceSliceDescriptorLocal> enumArmSliceDescriptorLocals = new();
                if (!BuildTerminalSwitchCaptureLocalTypes(
                        enumElementCaptureTypeCodes,
                        enumCaptureStart,
                        enumCaptureCount,
                        enumLocalTypes,
                        enumArmLocalTypes)
                    || !BuildTerminalFixedArraySwitchCaptureSliceDescriptorLocals(
                        enumFixedArrayParamIndex,
                        enumFixedArrayFacts,
                        false,
                        enumElementCaptureIndices,
                        enumElementCaptureTypeCodes,
                        enumCaptureStart,
                        enumCaptureCount,
                        enumLocalTypes,
                        enumSliceDescriptorLocals,
                        enumArmSliceDescriptorLocals))
                {
                    return false;
                }

                if (guardNode != 0
                    && !ValidateModuleCallsForRootWithSlices(
                        enumNodes,
                        guardNode,
                        funcParamCounts,
                        functionCallContractFacts,
                        enumArmLocalTypes,
                        enumArmSliceDescriptorLocals,
                        enumDistinctStorageFacts))
                {
                    return false;
                }

                if (!ValidateModuleCallsForRootWithSlices(
                        enumNodes,
                        enumCaseArm.NodeId,
                        funcParamCounts,
                        functionCallContractFacts,
                        enumArmLocalTypes,
                        enumArmSliceDescriptorLocals,
                        enumDistinctStorageFacts))
                {
                    return false;
                }

                enumCaseCallIndex = enumCaseCallIndex + 1;
            }
        }
        else if (!ValidateModuleCallsWithSlices(
            enumNodes,
            funcParamCounts,
            functionCallContractFacts,
            enumLocalTypes,
            enumSliceDescriptorLocals,
            enumDistinctStorageFacts))
        {
            return false;
        }

        stack mut IrTable<u32[0 max]> enumNoOverrides = new();
        stack u32[0 max] enumEntryFirst = (u32[0 max])instrs.Count() + 1;
        stack mut MirType ignoredDeclaredReturnType = MirType.I64;
        stack bool ignoredHasDeclaredReturnType = false;
        stack mut FixedArrayStorageLocal noEnumFixedArrayStorageLocal = new();
        return LowerTerminalFixedArrayListSwitchCasesToBlocks(
            enumNodes,
            enumFixedArrayParamIndex,
            enumFixedArrayFacts,
            false,
            noEnumFixedArrayStorageLocal,
            enumCaseArms,
            enumCasePatternStarts,
            enumCasePatternCounts,
            enumCaseGuardNodes,
            enumElementPatternIndices,
            enumElementPatternTypeCodes,
            enumElementPatternKinds,
            enumElementPatternMinValues,
            enumElementPatternMaxValues,
            enumCaseElementCaptureStarts,
            enumCaseElementCaptureCounts,
            enumElementCaptureIndices,
            enumElementCaptureTypeCodes,
            enumDefaultArm,
            enumLocalTypes,
            enumNoOverrides,
            functionCallContractFacts,
            enumSliceArgumentLocals,
            (u32[0 max])signatureParamCount,
            enumEntryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            ignoredHasDeclaredReturnType,
            ignoredDeclaredReturnType,
            true,
            enumReturnOwnerDeclarationIndex,
            false,
            body);
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack mut ExprParseResult scrutinee = new();
    stack mut u32[0 max] fixedArrayParamIndex = 0;
    stack mut ParamAbiFacts fixedArrayFacts = new();
    stack mut IrTable<ExprParseResult> caseArms = new();
    stack mut IrTable<u32[0 max]> casePatternStarts = new();
    stack mut IrTable<u32[0 max]> casePatternCounts = new();
    stack mut IrTable<u32[0 max]> caseGuardNodes = new();
    stack mut IrTable<u32[0 max]> elementPatternIndices = new();
    stack mut IrTable<u32[0 max]> elementPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> elementPatternKinds = new();
    stack mut IrTable<i64[min max]> elementPatternMinValues = new();
    stack mut IrTable<i64[min max]> elementPatternMaxValues = new();
    stack mut IrTable<u32[0 max]> caseElementCaptureStarts = new();
    stack mut IrTable<u32[0 max]> caseElementCaptureCounts = new();
    stack mut IrTable<u32[0 max]> elementCaptureIndices = new();
    stack mut IrTable<u32[0 max]> elementCaptureTypeCodes = new();
    stack mut IrTable<u32[0 max]> elementCaptureNameTokens = new();
    stack mut ExprParseResult defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    if (!TryParseTerminalFixedArrayListSwitchReturnCases(
        stream,
        source,
        moduleFacts,
        paramAbiFacts,
        nodes,
        params,
        funcNames,
        localTypes,
        sourceValueFacts,
        sliceDescriptorLocals,
        (u64[0 2 ** 63 - 1])braceIndex + 1,
        scrutinee,
        fixedArrayParamIndex,
        fixedArrayFacts,
        caseArms,
        casePatternStarts,
        casePatternCounts,
        caseGuardNodes,
        elementPatternIndices,
        elementPatternTypeCodes,
        elementPatternKinds,
        elementPatternMinValues,
        elementPatternMaxValues,
        caseElementCaptureStarts,
        caseElementCaptureCounts,
        elementCaptureIndices,
        elementCaptureTypeCodes,
        elementCaptureNameTokens,
        defaultArm,
        nextToken))
    {
        return false;
    }

    if (stream.KindAt(nextToken) != TokenKind.RBrace || params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (elementCaptureIndices.Count() != 0)
    {
        if (!ValidateModuleCallsForRootWithSlices(
                nodes,
                scrutinee.NodeId,
                funcParamCounts,
                functionCallContractFacts,
                localTypes,
                sliceDescriptorLocals,
                distinctStorageFacts)
            || !ValidateModuleCallsForRootWithSlices(
                nodes,
                defaultArm.NodeId,
                funcParamCounts,
                functionCallContractFacts,
                localTypes,
                sliceDescriptorLocals,
                distinctStorageFacts)
            || caseElementCaptureStarts.Count() != caseArms.Count()
            || caseElementCaptureCounts.Count() != caseArms.Count())
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] caseCallIndex = 0;
        while willexit (caseCallIndex < caseArms.Count())
        {
            stack mut u32[0 max] guardNode = 0;
            if (caseGuardNodes.Count() != 0)
            {
                guardNode = caseGuardNodes.Get((u32[0 max])(caseCallIndex + 1));
            }

            stack ExprParseResult caseArm = caseArms.Get((u32[0 max])(caseCallIndex + 1));
            stack u32[0 max] captureStart = caseElementCaptureStarts.Get((u32[0 max])(caseCallIndex + 1));
            stack u32[0 max] captureCount = caseElementCaptureCounts.Get((u32[0 max])(caseCallIndex + 1));
            stack mut IrTable<u32[0 max]> armLocalTypes = new();
            stack mut IrTable<SourceSliceDescriptorLocal> armSliceDescriptorLocals = new();
            if (!BuildTerminalSwitchCaptureLocalTypes(
                    elementCaptureTypeCodes,
                    captureStart,
                    captureCount,
                    localTypes,
                    armLocalTypes)
                || !BuildTerminalFixedArraySwitchCaptureSliceDescriptorLocals(
                    fixedArrayParamIndex,
                    fixedArrayFacts,
                    false,
                    elementCaptureIndices,
                    elementCaptureTypeCodes,
                    captureStart,
                    captureCount,
                    localTypes,
                    sliceDescriptorLocals,
                    armSliceDescriptorLocals))
            {
                return false;
            }

            if (guardNode != 0
                && !ValidateModuleCallsForRootWithSlices(
                    nodes,
                    guardNode,
                    funcParamCounts,
                    functionCallContractFacts,
                    armLocalTypes,
                    armSliceDescriptorLocals,
                    distinctStorageFacts))
            {
                return false;
            }

            if (!ValidateModuleCallsForRootWithSlices(
                    nodes,
                    caseArm.NodeId,
                    funcParamCounts,
                    functionCallContractFacts,
                    armLocalTypes,
                    armSliceDescriptorLocals,
                    distinctStorageFacts))
            {
                return false;
            }

            caseCallIndex = caseCallIndex + 1;
        }
    }
    else if (!ValidateModuleCallsWithSlices(
        nodes,
        funcParamCounts,
        functionCallContractFacts,
        localTypes,
        sliceDescriptorLocals,
        distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    stack mut FixedArrayStorageLocal noFixedArrayStorageLocal = new();
    return LowerTerminalFixedArrayListSwitchCasesToBlocks(
        nodes,
        fixedArrayParamIndex,
        fixedArrayFacts,
        false,
        noFixedArrayStorageLocal,
        caseArms,
        casePatternStarts,
        casePatternCounts,
        caseGuardNodes,
        elementPatternIndices,
        elementPatternTypeCodes,
        elementPatternKinds,
        elementPatternMinValues,
        elementPatternMaxValues,
        caseElementCaptureStarts,
        caseElementCaptureCounts,
        elementCaptureIndices,
        elementCaptureTypeCodes,
        defaultArm,
        localTypes,
        noOverrides,
        functionCallContractFacts,
        sliceArgumentLocals,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        hasDeclaredReturnType,
        declaredReturnType,
        false,
        0,
        false,
        body);
}

internal fn bool LowerModuleTerminalSwitchFunctionToBlocks(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    if (!BuildSourceModuleLoweringFacts(sourceText, stream, source, moduleFacts))
    {
        return false;
    }

    if (LowerModuleTerminalBooleanSwitchFunctionToBlocks(
        stream,
        source,
        moduleFacts,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body))
    {
        return true;
    }

    if (LowerModuleTerminalEnumSwitchFunctionToBlocks(
        sourceText,
        stream,
        source,
        moduleFacts,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body))
    {
        return true;
    }

    if (LowerModuleTerminalFixedArrayListSwitchFunctionToBlocks(
        stream,
        source,
        moduleFacts,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body))
    {
        return true;
    }

    return LowerModuleTerminalIntegerSwitchFunctionToBlocks(
        stream,
        source,
        moduleFacts,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body);
}

internal fn bool LowerModuleLocalSwitchStatementFunctionToBlocks(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithLocalSwitchStatementAssignment(stream, source, funcNames, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localRoots = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut IrTable<FixedArrayStorageLocal> fixedArrayStorageLocals = new();
    stack mut IrTable<FixedArrayStorageInitializer> fixedArrayStorageInitializers = new();
    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    stack mut IrTable<u32[0 max]> localOverrideValues = new();
    stack mut IrTable<StackObjectFieldInitializer> stackObjectFieldInitializers = new();
    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    stack mut bool setupLocalTypesSeeded = false;
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    stack mut bool moduleFactsBuilt = false;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> targetNameTokens = new();
    stack mut IrTable<u32[0 max]> targetInitRoots = new();
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut bool setupNeedsModuleFacts = false;
    stack mut u64[0 2 ** 63 - 1] setupScanCursor = cursor;
    while willexit (setupScanCursor < limit && (stream.KindAt(setupScanCursor) == TokenKind.Stack || stream.KindAt(setupScanCursor) == TokenKind.Heap))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = setupScanCursor;
        if (!FindSelfHostedStatementEnd(stream, setupScanCursor, limit, statementEnd))
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(setupScanCursor);
        stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, setupScanCursor, statementEnd);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, setupScanCursor, statementEnd, assignToken);
        stack mut u32[0 max] bodyOpen = 0;
        stack mut u32[0 max] bodyClose = 0;
        stack mut u32[0 max] argsOpen = 0;
        stack mut u32[0 max] argsClose = 0;
        if ((localStorage == TokenKind.Stack || localStorage == TokenKind.Heap)
            && hasAssign
            && typeToken != 0
            && (TryParseTargetTypedObjectConstructorShape(stream, source, typeToken, assignToken, statementEnd, bodyOpen, bodyClose)
                || TryParseTargetTypedPositionalRecordConstructorShape(stream, source, typeToken, assignToken, statementEnd, argsOpen, argsClose)))
        {
            setupNeedsModuleFacts = true;
        }

        setupScanCursor = statementEnd + 1;
    }

