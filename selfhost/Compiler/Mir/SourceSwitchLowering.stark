    mut borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    mut borrow IrTable<EnumStorageAssignment> enumAssignments,
    mut borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    mut borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    out ParsedSwitchFieldAssignmentArm defaultArm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(scalarStorageLocals, sourceValueFacts),
          overlap(enumStorageLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(caseValues, sourceValueFacts),
          overlap(caseArms, sourceValueFacts),
          overlap(armLocalRoots, sourceValueFacts),
          overlap(scalarAssignments, sourceValueFacts),
          overlap(enumAssignments, sourceValueFacts),
          overlap(fieldAssignments, sourceValueFacts),
          overlap(storageMutationStatements, sourceValueFacts)
{
    scrutinee = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeScrutinee = params.Count();
    stack ExprParseResult parsedScrutinee = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, switchIndex + 2);
    if (params.Count() != beforeScrutinee
        || stream.KindAt(parsedScrutinee.Next) != TokenKind.RParen
        || stream.KindAt(parsedScrutinee.Next + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] switchBodyOpen = parsedScrutinee.Next + 1;
    stack u32[0 max] switchBodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])switchBodyOpen);
    if (switchBodyClose == (u32[0 max])switchBodyOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = switchBodyOpen + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Case)
    {
        stack mut u32[0 max] caseValue = 0;
        stack mut u64[0 2 ** 63 - 1] afterCaseLabel = cursor + 1;
        if (!TryParseTerminalSwitchBooleanCaseLabel(stream, cursor + 1, caseValue, afterCaseLabel)
            || stream.KindAt(afterCaseLabel) != TokenKind.Colon
            || TerminalBooleanSwitchCaseValueExists(caseValues, caseValue))
        {
            return false;
        }

        stack mut ParsedSwitchFieldAssignmentArm caseArm = new();
        stack mut u64[0 2 ** 63 - 1] afterCase = afterCaseLabel + 1;
        if (!TryParseSwitchFieldAssignmentArm(
            stream,
            source,
            nodes,
            params,
            baseParamCount,
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            scalarStorageLocals,
            enumStorageLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            afterCaseLabel + 1,
            armLocalRoots,
            scalarAssignments,
            enumAssignments,
            fieldAssignments,
            storageMutationStatements,
            caseArm,
            afterCase))
        {
            return false;
        }

        if (caseValues.Add(caseValue) == 0 || caseArms.Add(caseArm) == 0)
        {
            return false;
        }

        cursor = afterCase;
    }

    if (caseValues.Count() == 0 || caseValues.Count() > 2)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ParsedSwitchFieldAssignmentArm parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseSwitchFieldAssignmentArm(
        stream,
        source,
        nodes,
        params,
        baseParamCount,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        scalarStorageLocals,
        enumStorageLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        cursor + 2,
        armLocalRoots,
        scalarAssignments,
        enumAssignments,
        fieldAssignments,
        storageMutationStatements,
        parsedDefault,
        afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = parsedScrutinee;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}

internal fn bool TerminalSwitchCaseValueExists(borrow IrTable<i64[min max]> caseValues, i64[min max] value)
{
    stack mut u64[0 2 ** 63 - 1] i = 0;
    stack u64[0 2 ** 63 - 1] count = caseValues.Count();
    while willexit (i < count)
    {
        stack i64[min max] current = caseValues.Get((u32[0 max])(i + 1));
        if (current == value)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TerminalBooleanSwitchCaseValueExists(borrow IrTable<u32[0 max]> caseValues, u32[0 max] value)
{
    stack mut u64[0 2 ** 63 - 1] i = 0;
    stack u64[0 2 ** 63 - 1] count = caseValues.Count();
    while willexit (i < count)
    {
        stack u32[0 max] current = caseValues.Get((u32[0 max])(i + 1));
        if (current == value)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TryParseTerminalIntegerSwitchReturnCases(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] switchIndex,
    out ExprParseResult scrutinee,
    mut borrow IrTable<i64[min max]> caseValues,
    mut borrow IrTable<i64[min max]> caseMaxValues,
    mut borrow IrTable<ExprParseResult> caseArms,
    out ExprParseResult defaultArm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    scrutinee = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack ExprParseResult parsedScrutinee = ParseExprIn(stream, source, nodes, params, funcNames, switchIndex + 2);
    if (stream.KindAt(parsedScrutinee.Next) != TokenKind.RParen
        || stream.KindAt(parsedScrutinee.Next + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] switchBodyOpen = parsedScrutinee.Next + 1;
    stack u32[0 max] switchBodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])switchBodyOpen);
    if (switchBodyClose == (u32[0 max])switchBodyOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = switchBodyOpen + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Case)
    {
        stack mut i64[min max] caseValue = 0;
        stack mut i64[min max] caseMaxValue = 0;
        stack mut u64[0 2 ** 63 - 1] afterCaseLabel = cursor + 1;
        if (!TryParseTerminalSwitchIntegerCaseInterval(stream, source, cursor + 1, caseValue, caseMaxValue, afterCaseLabel)
            || stream.KindAt(afterCaseLabel) != TokenKind.Colon
            || TerminalSwitchCaseIntervalOverlaps(caseValues, caseMaxValues, caseValue, caseMaxValue))
        {
            return false;
        }

        stack mut ExprParseResult caseArm = new();
        stack mut u64[0 2 ** 63 - 1] afterCase = afterCaseLabel + 1;
        if (!TryParseTerminalSwitchReturnArm(stream, source, nodes, params, funcNames, afterCaseLabel + 1, caseArm, afterCase))
        {
            return false;
        }

        if (caseValues.Add(caseValue) == 0
            || caseMaxValues.Add(caseMaxValue) == 0
            || caseArms.Add(caseArm) == 0)
        {
            return false;
        }

        cursor = afterCase;
    }

    if (caseValues.Count() == 0)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ExprParseResult parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseTerminalSwitchReturnArm(stream, source, nodes, params, funcNames, cursor + 2, parsedDefault, afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = parsedScrutinee;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}

