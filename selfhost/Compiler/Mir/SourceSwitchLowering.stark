    }

    stack mut u32[0 max] variantOrdinal = 0;
    if (!TryGetEnumVariantOrdinalForToken(stream, source, enumItem, (u32[0 max])(valueStart + 2), variantOrdinal))
    {
        return false;
    }

    stack mut u64[0 max] payloadCount = 0;
    stack mut u64[0 max] tagValue = 0;
    if (!moduleFacts.EnumLayouts.TryGetEnumVariantPayloadCount(ownerDeclarationIndex, variantOrdinal, payloadCount)
        || !moduleFacts.EnumLayouts.TryGetEnumVariantTag(ownerDeclarationIndex, variantOrdinal, tagValue))
    {
        return false;
    }

    if (payloadCount == 0)
    {
        value = (i64[min max])tagValue;
        nextToken = valueStart + 3;
        return true;
    }

    if (stream.KindAt(valueStart + 3) == TokenKind.LBrace)
    {
        if (!TryParseTerminalSwitchEnumNamedPayloadPatternLabelWithCaptures(
                stream,
                source,
                moduleFacts,
                ownerDeclarationIndex,
                variantOrdinal,
                payloadCount,
                valueStart + 3,
                payloadPatternVariantOrdinals,
                payloadPatternOrdinals,
                payloadPatternTypeCodes,
                payloadPatternKinds,
                payloadPatternMinValues,
                payloadPatternMaxValues,
                payloadCaptureVariantOrdinals,
                payloadCaptureOrdinals,
                payloadCaptureTypeCodes,
                payloadCaptureNameTokens,
                payloadPatternStart,
                payloadPatternCount,
                payloadCaptureStart,
                payloadCaptureCount,
                nextToken))
        {
            return false;
        }

        value = (i64[min max])tagValue;
        return true;
    }

    if (stream.KindAt(valueStart + 3) != TokenKind.LParen)
    {
        return false;
    }

    stack mut u64[0 max] parsedPayloads = 0;
    stack mut u64[0 2 ** 63 - 1] cursor = valueStart + 4;
    while willexit (parsedPayloads < payloadCount)
    {
        stack u32[0 max] payloadOrdinal = (u32[0 max])parsedPayloads;
        stack mut u32[0 max] payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();
        if (!TryGetSourceEnumPayloadTypeCode(
                stream,
                source,
                moduleFacts,
                ownerDeclarationIndex,
                variantOrdinal,
                payloadOrdinal,
                payloadTypeCode))
        {
            return false;
        }

        stack mut u32[0 max] patternKind = SourceSwitchEnumPayloadPatternKindDiscard();
        stack mut i64[min max] minValue = 0;
        stack mut i64[min max] maxValue = 0;
        stack mut u32[0 max] captureNameToken = 0;
        stack mut u64[0 2 ** 63 - 1] afterPattern = cursor;
        if (!TryParseSourceSwitchEnumPayloadScalarOrCapturePattern(
                stream,
                source,
                payloadTypeCode,
                true,
                cursor,
                patternKind,
                minValue,
                maxValue,
                captureNameToken,
                afterPattern))
        {
            return false;
        }

        if (captureNameToken != 0)
        {
            if (payloadCaptureVariantOrdinals.Add(variantOrdinal) == 0
                || payloadCaptureOrdinals.Add(payloadOrdinal) == 0
                || payloadCaptureTypeCodes.Add(payloadTypeCode) == 0
                || payloadCaptureNameTokens.Add(captureNameToken) == 0)
            {
                return false;
            }

            payloadCaptureCount = payloadCaptureCount + 1;
        }

        if (patternKind != SourceSwitchEnumPayloadPatternKindDiscard())
        {
            if (payloadPatternVariantOrdinals.Add(variantOrdinal) == 0
                || payloadPatternOrdinals.Add(payloadOrdinal) == 0
                || payloadPatternTypeCodes.Add(payloadTypeCode) == 0
                || payloadPatternKinds.Add(patternKind) == 0
                || payloadPatternMinValues.Add(minValue) == 0
                || payloadPatternMaxValues.Add(maxValue) == 0)
            {
                return false;
            }

            payloadPatternCount = payloadPatternCount + 1;
        }

        parsedPayloads = parsedPayloads + 1;
        cursor = afterPattern;
        if (parsedPayloads < payloadCount)
        {
            if (stream.KindAt(cursor) != TokenKind.Comma)
            {
                return false;
            }

            cursor = cursor + 1;
        }
        else if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            cursor = cursor + 1;
        }
    }

    if (stream.KindAt(cursor) != TokenKind.RParen)
    {
        return false;
    }

    value = (i64[min max])tagValue;
    nextToken = cursor + 1;
    return true;
}

internal fn bool TryGetSwitchFirstEnumCaseOwnerDeclarationIndex(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u64[0 2 ** 63 - 1] switchIndex,
    out u32[0 max] ownerDeclarationIndex)
{
    ownerDeclarationIndex = 0;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] closeParen = MatchingBracketForMirLowering(stream, (u32[0 max])(switchIndex + 1));
    if (closeParen == (u32[0 max])(switchIndex + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] firstCase = (u64[0 2 ** 63 - 1])closeParen + 2;
    if (stream.KindAt(firstCase) != TokenKind.Case
        || stream.KindAt(firstCase + 1) != TokenKind.Identifier
        || stream.KindAt(firstCase + 2) != TokenKind.Dot)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = moduleFacts.Declarations.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack DeclItem item = moduleFacts.Declarations.ItemAt(index);
        if (item.Kind == DeclarationKind.Enum
            && item.NameToken != 0
            && TokenTextEqualsToken(stream, source, (u32[0 max])(firstCase + 1), item.NameToken))
        {
            ownerDeclarationIndex = (u32[0 max])index;
            return true;
        }

        index = index + 1;
    }

    return false;
}




internal fn bool FunctionBodyStartsWithTerminalSwitch(borrow TokenStream stream, u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0 && braceIndex >= nextFnIndex)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] bodyStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    return stream.KindAt(bodyStart) == TokenKind.Switch;
}

internal fn bool FunctionBodyHasLocalPrefixedTerminalSwitch(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (cursor >= limit || !TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        return false;
    }

    while willexit (cursor < limit && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        if (stream.KindAt(cursor) != TokenKind.Var)
        {
            stack TokenKind localStorage = stream.KindAt(cursor);
            if (localStorage != TokenKind.Stack && localStorage != TokenKind.Heap)
            {
                return false;
            }

            stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
            stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
            stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
            stack mut u32[0 max] fixedArrayLength = 0;
            if (localStorage == TokenKind.Stack
                && typeToken != 0
                && TryReadFixedArrayLengthSuffix(stream, source, typeToken, fixedArrayLength))
            {
                if (!hasAssign || stream.KindAt(assignToken + 1) != TokenKind.LBrace)
                {
                    return false;
                }

                stack u32[0 max] initializerClose = MatchingBraceForMirLowering(stream, (u32[0 max])(assignToken + 1));
                if (initializerClose == (u32[0 max])(assignToken + 1)
                    || (u64[0 2 ** 63 - 1])initializerClose + 1 != statementEnd)
                {
                    return false;
                }

                cursor = statementEnd + 1;
                continue;
            }

            stack mut u32[0 max] dynamicCapacity = 0;
            stack mut u32[0 max] dynamicAlignment = 0;
            if (localStorage == TokenKind.Stack
                && FindSelfHostedDynamicElementTypeToken(stream, cursor, statementEnd) != 0
                && TryParseArenaSelectorCapacity(stream, source, cursor, statementEnd, dynamicCapacity, dynamicAlignment))
            {
                cursor = statementEnd + 1;
                continue;
            }

            stack mut u32[0 max] bodyOpen = 0;
            stack mut u32[0 max] bodyClose = 0;
            stack mut u32[0 max] argsOpen = 0;
            stack mut u32[0 max] argsClose = 0;
            if (hasAssign
                && typeToken != 0
                && (TryParseTargetTypedObjectConstructorShape(stream, source, typeToken, assignToken, statementEnd, bodyOpen, bodyClose)
                    || TryParseTargetTypedPositionalRecordConstructorShape(stream, source, typeToken, assignToken, statementEnd, argsOpen, argsClose)))
            {
                cursor = statementEnd + 1;
                continue;
            }

            return false;
        }

        cursor = statementEnd + 1;
    }

    return cursor < limit && stream.KindAt(cursor) == TokenKind.Switch;
}

internal fn bool FunctionBodyStartsWithLocalSwitchStatementAssignment(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> targetNameTokens = new();
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut bool skippedListStorageSetupLocal = false;
    while willexit (cursor < limit && (stream.KindAt(cursor) == TokenKind.Stack || stream.KindAt(cursor) == TokenKind.Heap))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(cursor);
        stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
        stack mut u32[0 max] fixedArrayLength = 0;
        if (localStorage == TokenKind.Stack
            && typeToken != 0
            && TryReadFixedArrayLengthSuffix(stream, source, typeToken, fixedArrayLength))
        {
            if (fixedArrayLength == 0
                || !hasAssign
                || stream.KindAt(assignToken + 1) != TokenKind.LBrace)
            {
                return false;
            }

            stack u32[0 max] initializerClose = MatchingBraceForMirLowering(stream, (u32[0 max])(assignToken + 1));
            if (initializerClose == (u32[0 max])(assignToken + 1)
                || (u64[0 2 ** 63 - 1])initializerClose + 1 != statementEnd)
            {
                return false;
            }

            skippedListStorageSetupLocal = true;
            cursor = statementEnd + 1;
            continue;
        }

        stack mut u32[0 max] bodyOpen = 0;
        stack mut u32[0 max] bodyClose = 0;
        stack mut u32[0 max] argsOpen = 0;
        stack mut u32[0 max] argsClose = 0;
        if (hasAssign
            && typeToken != 0
            && (TryParseTargetTypedObjectConstructorShape(stream, source, typeToken, assignToken, statementEnd, bodyOpen, bodyClose)
                || TryParseTargetTypedPositionalRecordConstructorShape(stream, source, typeToken, assignToken, statementEnd, argsOpen, argsClose)))
        {
            if (localStorage == TokenKind.Heap && signature.LawKind())
            {
                return false;
            }

            skippedListStorageSetupLocal = true;
            cursor = statementEnd + 1;
            continue;
        }

        return false;
    }

    if (cursor >= limit || stream.KindAt(cursor) != TokenKind.Var)
    {
        return false;
    }

    while willexit (cursor < limit && stream.KindAt(cursor) == TokenKind.Var)
    {
        stack mut u64[0 2 ** 63 - 1] localEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, localEnd))
        {
            return false;
        }

        stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, localEnd);
        if (localNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0
            || TokenTextExistsInTokenTable(stream, source, targetNameTokens, localNameToken))
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] assignToken = localEnd;
        if (!FindSelfHostedStatementAssign(stream, cursor, localEnd, assignToken))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
        stack ExprParseResult initResult = ParseExprIn(stream, source, nodes, params, funcNames, assignToken + 1);
        if (initResult.Next != localEnd
            || params.Count() != beforeInit
            || !ExprNodeCanBeDiscardedIfOverwritten(nodes, initResult.NodeId))
        {
            return false;
        }

        if (targetNameTokens.Add(localNameToken) == 0)
        {
            return false;
        }

        cursor = localEnd + 1;
    }

    if (targetNameTokens.Count() == 0 || cursor >= limit || stream.KindAt(cursor) != TokenKind.Switch)
    {
        return false;
    }

    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<i64[min max]> caseMaxValues = new();
    stack mut IrTable<u32[0 max]> booleanCaseValues = new();
    stack mut IrTable<ParsedSwitchAssignmentArm> caseArms = new();
    stack mut IrTable<u32[0 max]> casePayloadPatternStarts = new();
    stack mut IrTable<u32[0 max]> casePayloadPatternCounts = new();
    stack mut IrTable<u32[0 max]> payloadPatternVariantOrdinals = new();
    stack mut IrTable<u32[0 max]> payloadPatternOrdinals = new();
    stack mut IrTable<u32[0 max]> payloadPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> payloadPatternKinds = new();
    stack mut IrTable<i64[min max]> payloadPatternMinValues = new();
    stack mut IrTable<i64[min max]> payloadPatternMaxValues = new();
    stack mut u32[0 max] fixedArrayParamIndex = 0;
    stack mut ParamAbiFacts fixedArrayFacts = new();
    stack mut IrTable<u32[0 max]> casePatternStarts = new();
    stack mut IrTable<u32[0 max]> casePatternCounts = new();
    stack mut IrTable<u32[0 max]> caseGuardNodes = new();
    stack mut IrTable<u32[0 max]> elementPatternIndices = new();
    stack mut IrTable<u32[0 max]> elementPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> elementPatternKinds = new();
    stack mut IrTable<i64[min max]> elementPatternMinValues = new();
    stack mut IrTable<i64[min max]> elementPatternMaxValues = new();
    stack mut IrTable<u32[0 max]> caseElementCaptureStarts = new();
    stack mut IrTable<u32[0 max]> caseElementCaptureCounts = new();
    stack mut IrTable<u32[0 max]> elementCaptureIndices = new();
    stack mut IrTable<u32[0 max]> elementCaptureTypeCodes = new();
    stack mut IrTable<u32[0 max]> elementCaptureNameTokens = new();
    stack mut IrTable<u32[0 max]> armLocalRoots = new();
    stack mut IrTable<u32[0 max]> assignedRoots = new();
    stack mut IrTable<u32[0 max]> assignedTargetOffsets = new();
    stack mut ParsedSwitchAssignmentArm defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (SwitchFirstCaseLabelLooksQualifiedName(stream, cursor))
    {
        return true;
    }

    if (SwitchFirstCaseLabelIsBoolean(stream, cursor))
    {
        if (!TryParseBooleanSwitchAssignmentCases(
            stream,
            source,
            nodes,
            params,
            funcNames,
            cursor,
            targetNameTokens,
            signatureParamCount,
            scrutinee,
            booleanCaseValues,
            caseArms,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            defaultArm,
            nextToken))
        {
            return false;
        }
    }
    else if (SwitchFirstCaseLabelIsListPattern(stream, cursor))
    {
        if (skippedListStorageSetupLocal)
        {
            return true;
        }

        stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
        if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts)
            || !TryParseFixedArrayListSwitchAssignmentCases(
                stream,
                source,
                paramAbiFacts,
                nodes,
                params,
                funcNames,
                cursor,
                targetNameTokens,
                signatureParamCount,
                scrutinee,
                fixedArrayParamIndex,
                fixedArrayFacts,
                caseArms,
                casePatternStarts,
                casePatternCounts,
                caseGuardNodes,
                elementPatternIndices,
                elementPatternTypeCodes,
                elementPatternKinds,
                elementPatternMinValues,
                elementPatternMaxValues,
                caseElementCaptureStarts,
                caseElementCaptureCounts,
                elementCaptureIndices,
                elementCaptureTypeCodes,
                elementCaptureNameTokens,
                armLocalRoots,
                assignedRoots,
                assignedTargetOffsets,
                defaultArm,
                nextToken))
        {
            return false;
        }
    }
    else if (!TryParseIntegerSwitchAssignmentCases(
        stream,
        source,
        nodes,
        params,
        funcNames,
        cursor,
        targetNameTokens,
        signatureParamCount,
        scrutinee,
        caseValues,
        caseMaxValues,
        caseArms,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        defaultArm,
        nextToken))
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut u32[0 max] switchCaseCount = (u32[0 max])caseValues.Count();
    if (SwitchFirstCaseLabelIsBoolean(stream, cursor))
    {
        switchCaseCount = (u32[0 max])booleanCaseValues.Count();
    }
    else if (SwitchFirstCaseLabelIsListPattern(stream, cursor))
    {
        switchCaseCount = (u32[0 max])casePatternStarts.Count();
    }

    stack mut u64[0 2 ** 63 - 1] targetIndex = 0;
    while willexit (targetIndex < targetNameTokens.Count())
    {
        stack u32[0 max] targetNameToken = targetNameTokens.Get((u32[0 max])(targetIndex + 1));
        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])targetNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])targetNameToken);
        if (ResolveParam(params, source, nameStart, nameLength) != (u32[0 max])(signatureParamCount + targetIndex))
        {
            return false;
        }

        if (!UpdateSwitchAssignmentTargetRawPointerFacts(
            params,
            nodes,
            caseArms,
            assignedRoots,
            assignedTargetOffsets,
            defaultArm,
            (u32[0 max])(signatureParamCount + targetIndex),
            (u32[0 max])targetIndex,
            switchCaseCount))
        {
            return false;
        }

        targetIndex = targetIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] returnIndex = nextToken;
    stack mut u64[0 2 ** 63 - 1] expectedParamCount = signatureParamCount + targetNameTokens.Count();
    while willexit (returnIndex < limit && stream.KindAt(returnIndex) == TokenKind.Var)
    {
        stack mut u64[0 2 ** 63 - 1] postLocalEnd = returnIndex;
        if (!FindSelfHostedStatementEnd(stream, returnIndex, limit, postLocalEnd))
        {
            return false;
        }

        stack u32[0 max] postLocalNameToken = FindSelfHostedLocalNameToken(stream, returnIndex, postLocalEnd);
        if (postLocalNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] postNameStart = stream.StartAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        stack u64[0 2 ** 63 - 1] postNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        if (ParamIndexOf(params, source, postNameStart, postNameLength) >= 0)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] postAssignToken = postLocalEnd;
        if (!FindSelfHostedStatementAssign(stream, returnIndex, postLocalEnd, postAssignToken))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforePostLocal = params.Count();
        stack ExprParseResult postLocalRoot = ParseExprIn(stream, source, nodes, params, funcNames, postAssignToken + 1);
        if (postLocalRoot.Next != postLocalEnd || params.Count() != beforePostLocal)
        {
            return false;
        }

        if (ResolveParam(params, source, postNameStart, postNameLength) != (u32[0 max])expectedParamCount)
        {
            return false;
        }

        returnIndex = postLocalEnd + 1;
        expectedParamCount = expectedParamCount + 1;
    }

    if (returnIndex >= limit)
    {
        return false;
    }

    if (stream.KindAt(returnIndex) == TokenKind.Return)
    {
        stack ExprParseResult returnRoot = ParseExprIn(stream, source, nodes, params, funcNames, returnIndex + 1);
        stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
        if (stream.KindAt(afterReturn) == TokenKind.Semi)
        {
            afterReturn = afterReturn + 1;
        }

        return stream.KindAt(afterReturn) == TokenKind.RBrace
            && params.Count() == expectedParamCount;
    }

    if (stream.KindAt(returnIndex) == TokenKind.If)
    {
        stack mut ParsedIfReturnArms tailArms = new();
        if (!TryParseTerminalIfReturnArms(stream, source, nodes, params, funcNames, returnIndex, tailArms)
            || tailArms.ThenBecome
            || tailArms.ElseBecome)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] afterIf = tailArms.ElseArm.Next;
        return stream.KindAt(afterIf) == TokenKind.RBrace
            && params.Count() == expectedParamCount;
    }

    return false;
}

internal fn bool TryParseTerminalSwitchReturnArm(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    arm = new();
    nextToken = armStart;
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart || stream.KindAt(armStart + 1) != TokenKind.Return)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (stream.KindAt(armStart) != TokenKind.Return)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TryParseTerminalSwitchReturnArmWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap_all(sourceValueFacts)
{
    arm = new();
    nextToken = armStart;
    stack mut IrTable<ConstructedObjectLocal> noConstructedObjectLocals = new();
    stack mut IrTable<SourceSliceDescriptorLocal> noSliceDescriptorLocals = new();
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart || stream.KindAt(armStart + 1) != TokenKind.Return)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            noConstructedObjectLocals,
            noSliceDescriptorLocals,
            localTypes,
            sourceValueFacts,
            moduleFacts,
            armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (stream.KindAt(armStart) != TokenKind.Return)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        noConstructedObjectLocals,
        noSliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool CopyTerminalSwitchCaptureParams(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    mut borrow IrTable<ParamName> armParams)
{
    if (!CopyParamNamePrefix(baseParams, baseParamCount, armParams))
    {
        return false;
    }

    stack mut u32[0 max] captureOffset = 0;
    while willexit (captureOffset < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureOffset;
        if (!captureNameTokens.Contains(captureRow) || !captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] captureTypeCode = captureTypeCodes.Get(captureRow);
        stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeNonValue();
        if (!TrySourceSwitchCaptureLocalTypeCode(captureTypeCode, localTypeCode))
        {
            return false;
        }

        stack u32[0 max] captureNameToken = captureNameTokens.Get(captureRow);
        stack u64[0 2 ** 63 - 1] captureNameStart = stream.StartAt((u64[0 2 ** 63 - 1])captureNameToken);
        stack u64[0 2 ** 63 - 1] captureNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])captureNameToken);
        if (ParamIndexOf(armParams, source, captureNameStart, captureNameLength) >= 0)
        {
            return false;
        }

        stack u32[0 max] captureLocalIndex = ResolveParam(armParams, source, captureNameStart, captureNameLength);
        if (captureLocalIndex != (u32[0 max])(baseParamCount + (u64[0 2 ** 63 - 1])captureOffset))
        {
            return false;
        }

        captureOffset = captureOffset + 1;
    }

    return true;
}

internal fn bool TrySourceSwitchCaptureLocalTypeCode(u32[0 max] captureTypeCode, out u32[0 max] localTypeCode)
{
    localTypeCode = SourceLocalTypeCodeNonValue();
    if (captureTypeCode == SourceLocalTypeCodeFixedArrayParam() || SourceLocalTypeCodeIsStructValue(captureTypeCode))
    {
        localTypeCode = captureTypeCode;
        return true;
    }

    localTypeCode = SourceLocalTypeCodeForResolvedScalarValue(captureTypeCode);
    return localTypeCode != SourceLocalTypeCodeNonValue();
}

internal inline finite law bool SourceSwitchCaptureTypeCodeIsAggregateLocal(u32[0 max] captureTypeCode)
{
    return captureTypeCode == SourceLocalTypeCodeFixedArrayParam() || SourceLocalTypeCodeIsStructValue(captureTypeCode);
}

internal inline finite law bool SourceSwitchCaptureIsFixedArrayWholeParam(
    u32[0 max] elementIndex,
    u32[0 max] captureTypeCode,
    ParamAbiFacts fixedArrayFacts)
{
    return fixedArrayFacts.IsFixedArray
        && elementIndex == fixedArrayFacts.FixedArrayLength
        && captureTypeCode == SourceLocalTypeCodeFixedArrayParam();
}

internal inline finite law bool SourceSwitchCaptureIsStructWholeParam(
    u32[0 max] fieldIndex,
    u32[0 max] captureTypeCode,
    ParamAbiFacts structValueFacts)
{
    return structValueFacts.IsStructValue
        && structValueFacts.StructValueTypeToken != 0
        && fieldIndex == structValueFacts.StructValueFieldCount
        && SourceLocalTypeCodeIsStructValue(captureTypeCode)
        && SourceLocalTypeCodeStructValueTypeToken(captureTypeCode) == structValueFacts.StructValueTypeToken;
}

internal fn bool TryParseSwitchGuardWithCaptures(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    u64[0 2 ** 63 - 1] guardStart,
    out ExprParseResult guard,
    out u64[0 2 ** 63 - 1] nextToken)
{
    guard = new();
    nextToken = guardStart;

    stack mut IrTable<ParamName> guardParams = new();
    if (!CopyTerminalSwitchCaptureParams(
            stream,
            source,
            baseParams,
            baseParamCount,
            captureNameTokens,
            captureTypeCodes,
            captureStart,
            captureCount,
            guardParams))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] expectedParamCount = baseParamCount + (u64[0 2 ** 63 - 1])captureCount;
    stack ExprParseResult parsedGuard = ParseExprIn(stream, source, nodes, guardParams, funcNames, guardStart);
    if (parsedGuard.NodeId == 0
        || parsedGuard.Next == guardStart
        || guardParams.Count() != expectedParamCount)
    {
        return false;
    }

    guard = parsedGuard;
    nextToken = parsedGuard.Next;
    return true;
}

internal fn bool BuildTerminalSwitchCaptureLocalTypes(
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    mut borrow IrTable<u32[0 max]> armLocalTypes)
    where overlap(captureTypeCodes, baseLocalTypes)
{
    stack u64[0 2 ** 63 - 1] baseLocalTypeCount = baseLocalTypes.Count();
    stack mut u64[0 2 ** 63 - 1] typeIndex = 0;
    while willexit (typeIndex < baseLocalTypeCount)
    {
        stack u32[0 max] typeSlot = (u32[0 max])(typeIndex + 1);
        stack mut u32[0 max] typeCode = 0;
        if (baseLocalTypes.Contains(typeSlot))
        {
            typeCode = baseLocalTypes.Get(typeSlot);
        }

        if (armLocalTypes.Add(typeCode) == 0)
        {
            return false;
        }

        typeIndex = typeIndex + 1;
    }

    stack mut u32[0 max] captureIndex = 0;
    while willexit (captureIndex < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureIndex;
        if (!captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] captureTypeCode = captureTypeCodes.Get(captureRow);
        stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeNonValue();
        if (!TrySourceSwitchCaptureLocalTypeCode(captureTypeCode, localTypeCode))
        {
            return false;
        }

        if (armLocalTypes.Add(localTypeCode) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    return true;
}

internal fn bool BuildTerminalSwitchCaptureLocalTypesAndFacts(
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    borrow IrTable<ValueFacts> baseSourceValueFacts,
    mut borrow IrTable<u32[0 max]> armLocalTypes,
    mut borrow IrTable<ValueFacts> armSourceValueFacts)
    where overlap(captureTypeCodes, baseLocalTypes), overlap_all(baseSourceValueFacts)
{
    if (!BuildTerminalSwitchCaptureLocalTypes(
        captureTypeCodes,
        captureStart,
        captureCount,
        baseLocalTypes,
        armLocalTypes))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] baseLocalTypeCount = baseLocalTypes.Count();
    stack mut u64[0 2 ** 63 - 1] factsIndex = 0;
    while willexit (factsIndex < baseLocalTypeCount)
    {
        stack u32[0 max] factsSlot = (u32[0 max])(factsIndex + 1);
        stack mut ValueFacts facts = new();
        if (baseSourceValueFacts.Contains(factsSlot))
        {
            facts = baseSourceValueFacts.Get(factsSlot);
        }

        if (armSourceValueFacts.Add(facts) == 0)
        {
            return false;
        }

        factsIndex = factsIndex + 1;
    }

    stack mut u32[0 max] captureIndex = 0;
    while willexit (captureIndex < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureIndex;
        if (!captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack mut ValueFacts captureFacts = new();
        stack u32[0 max] captureTypeCode = captureTypeCodes.Get(captureRow);
        if (!SourceSwitchCaptureTypeCodeIsAggregateLocal(captureTypeCode))
        {
            stack MirType payloadType = MirTypeForResolvedFieldTypeCode(captureTypeCode);
            stack bool ignored = TrySetFullIntegerRangeForMirType(captureFacts, payloadType);
        }

        if (armSourceValueFacts.Add(captureFacts) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    return true;
}

internal fn bool TryParseTerminalSwitchReturnArmWithCaptures(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    arm = new();
    nextToken = armStart;

    stack mut IrTable<ParamName> armParams = new();
    if (!CopyTerminalSwitchCaptureParams(
            stream,
            source,
            baseParams,
            baseParamCount,
            captureNameTokens,
            captureTypeCodes,
            captureStart,
            captureCount,
            armParams))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] expectedParamCount = baseParamCount + (u64[0 2 ** 63 - 1])captureCount;
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart || stream.KindAt(armStart + 1) != TokenKind.Return)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, armParams, funcNames, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace || armParams.Count() != expectedParamCount)
        {
            return false;
        }

        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (stream.KindAt(armStart) != TokenKind.Return)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, armParams, funcNames, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    if (armParams.Count() != expectedParamCount)
    {
        return false;
    }

    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

