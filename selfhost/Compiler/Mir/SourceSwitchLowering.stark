            baseLocalOverrides,
            instrs,
            localOverrides))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack MirValueId localValue = LowerExprNodeWithTypesAndLocals(nodes, localRoot, instrs, armLocalTypes, localOverrides);
        if (localOverrides.Add(localValue.Index()) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut IrTable<u32[0 max]> sourceOrderValues = new();
    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] assignedRoot = assignedRoots.Get(rootSlot);
        stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, assignedRoot, instrs, armLocalTypes, localOverrides);
        if (sourceOrderValues.Add(value.Index()) == 0)
        {
            return false;
        }

        assignedIndex = assignedIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] targetIndex = 0;
    while willexit (targetIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack mut bool foundTarget = false;
        assignedIndex = 0;
        while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
        {
            stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
            stack u32[0 max] currentTargetOffset = assignedTargetOffsets.Get(rootSlot);
            if (currentTargetOffset == (u32[0 max])targetIndex)
            {
                if (foundTarget)
                {
                    return false;
                }

                stack u32[0 max] sourceOrderValue = sourceOrderValues.Get((u32[0 max])(assignedIndex + 1));
                if (values.Add(sourceOrderValue) == 0)
                {
                    return false;
                }

                foundTarget = true;
            }

            assignedIndex = assignedIndex + 1;
        }

        if (!foundTarget)
        {
            return false;
        }

        targetIndex = targetIndex + 1;
    }

    return true;
}

