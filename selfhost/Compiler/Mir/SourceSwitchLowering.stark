            funcNames,
            localTypes,
            sourceValueFacts,
            sliceDescriptorLocals,
            resolvedFixedArrayLocal.ParamIndex,
            resolvedFixedArrayFacts,
            true,
            elementCaptureIndices,
            elementCaptureNameTokens,
            elementCaptureTypeCodes,
            captureStart,
            captureCount,
            colonToken + 1,
            caseArm,
            afterCase))
        {
            return false;
        }

        if (caseArms.Add(caseArm) == 0
            || casePatternStarts.Add(patternStart) == 0
            || casePatternCounts.Add(patternCount) == 0
            || caseGuardNodes.Add(guardNode) == 0
            || caseElementCaptureStarts.Add(captureStart) == 0
            || caseElementCaptureCounts.Add(captureCount) == 0)
        {
            return false;
        }

        cursor = afterCase;
    }

    if (caseArms.Count() == 0)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ExprParseResult parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseTerminalSwitchReturnArmWithEnums(
        stream,
        source,
        moduleFacts,
