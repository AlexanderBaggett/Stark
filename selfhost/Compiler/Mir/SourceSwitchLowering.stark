        parsedDefault,
        afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = resolvedScrutinee;
    fixedArrayLocal = resolvedFixedArrayLocal;
    fixedArrayParamIndex = resolvedFixedArrayLocal.ParamIndex;
    fixedArrayFacts = resolvedFixedArrayFacts;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
