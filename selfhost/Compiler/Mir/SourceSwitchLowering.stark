internal fn bool TryParseSwitchAssignmentArm(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] signatureParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> targetNameTokens,
    u64[0 2 ** 63 - 1] armStart,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<u32[0 max]> assignedRoots,
    mut borrow IrTable<u32[0 max]> assignedTargetOffsets,
    out ParsedSwitchAssignmentArm arm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    arm = new();
    nextToken = armStart;

    stack u64[0 2 ** 63 - 1] targetCountWide = targetNameTokens.Count();
    if (targetCountWide == 0)
    {
        return false;
    }

    stack mut IrTable<ParamName> armParams = new();
    if (!CopyParamNamePrefix(baseParams, signatureParamCount, armParams))
    {
        return false;
    }

    stack u32[0 max] localRootStart = (u32[0 max])(armLocalRoots.Count() + 1);
    stack u32[0 max] assignedRootStart = (u32[0 max])(assignedRoots.Count() + 1);
    stack mut u32[0 max] localRootCount = 0;
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] cursor = armStart + 1;
        while willexit (cursor < (u64[0 2 ** 63 - 1])closeBrace && stream.KindAt(cursor) == TokenKind.Var)
        {
            stack mut u64[0 2 ** 63 - 1] localEnd = cursor;
            if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])closeBrace, localEnd))
            {
                return false;
            }

            stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, localEnd);
            if (localNameToken == 0)
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] localNameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
            stack u64[0 2 ** 63 - 1] localNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
            if (ParamIndexOf(armParams, source, localNameStart, localNameLength) >= 0)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] localAssignToken = localEnd;
            if (!FindSelfHostedStatementAssign(stream, cursor, localEnd, localAssignToken))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeLocal = armParams.Count();
            stack ExprParseResult localRoot = ParseExprIn(stream, source, nodes, armParams, funcNames, localAssignToken + 1);
            if (localRoot.Next != localEnd || armParams.Count() != beforeLocal)
            {
                return false;
            }

            stack u32[0 max] localIndex = ResolveParam(armParams, source, localNameStart, localNameLength);
            if (armLocalRoots.Add(localRoot.NodeId) == 0)
            {
                return false;
            }

            localRootCount = localRootCount + 1;
            cursor = localEnd + 1;
        }

        stack mut u64[0 2 ** 63 - 1] assignmentIndex = 0;
        while willexit (assignmentIndex < targetCountWide)
        {
            stack mut u32[0 max] targetOffset = 0;
            if (cursor >= (u64[0 2 ** 63 - 1])closeBrace
                || stream.KindAt(cursor) != TokenKind.Identifier
                || stream.KindAt(cursor + 1) != TokenKind.Assign
                || !TryFindSwitchTargetOffsetForToken(stream, source, targetNameTokens, (u32[0 max])cursor, targetOffset)
                || SwitchAssignmentArmTargetOffsetExists(assignedTargetOffsets, assignedRootStart, (u32[0 max])assignmentIndex, targetOffset))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeAssign = armParams.Count();
            stack ExprParseResult parsedAssigned = ParseExprIn(stream, source, nodes, armParams, funcNames, cursor + 2);
            if (armParams.Count() != beforeAssign)
            {
                return false;
            }

            if (assignmentIndex == 0)
            {
                arm.Assigned = parsedAssigned;
            }

            if (assignedRoots.Add(parsedAssigned.NodeId) == 0 || assignedTargetOffsets.Add(targetOffset) == 0)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] afterExpr = parsedAssigned.Next;
            stack mut bool hasSemicolon = false;
            if (stream.KindAt(afterExpr) == TokenKind.Semi)
            {
                hasSemicolon = true;
                afterExpr = afterExpr + 1;
            }

            assignmentIndex = assignmentIndex + 1;
            if (assignmentIndex < targetCountWide)
            {
                if (!hasSemicolon)
                {
                    return false;
                }

                cursor = afterExpr;
            }
            else
            {
                if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
                {
                    return false;
                }

                cursor = afterExpr;
            }
        }

        if (cursor != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        arm.AssignedRootStart = assignedRootStart;
        arm.AssignedRootCount = (u32[0 max])targetCountWide;
        arm.LocalRootStart = localRootStart;
        arm.LocalRootCount = localRootCount;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (targetCountWide != 1)
    {
        return false;
    }

    stack u32[0 max] compactTargetNameToken = targetNameTokens.Get(1);
    if (stream.KindAt(armStart) != TokenKind.Identifier
        || stream.KindAt(armStart + 1) != TokenKind.Assign
        || !TokenTextEqualsAsciiSpan(stream, source, compactTargetNameToken, (u32[0 max])armStart))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeCompact = armParams.Count();
    stack ExprParseResult parsedCompactArm = ParseExprIn(stream, source, nodes, armParams, funcNames, armStart + 2);
    stack mut u64[0 2 ** 63 - 1] afterCompactExpr = parsedCompactArm.Next;
    if (stream.KindAt(afterCompactExpr) == TokenKind.Semi)
    {
        afterCompactExpr = afterCompactExpr + 1;
    }

    if (armParams.Count() != beforeCompact)
    {
        return false;
    }

    arm.Assigned = parsedCompactArm;
    arm.AssignedRootStart = assignedRootStart;
    arm.AssignedRootCount = 1;
    arm.LocalRootStart = localRootStart;
    arm.LocalRootCount = 0;
    if (assignedRoots.Add(parsedCompactArm.NodeId) == 0)
    {
        return false;
    }

    if (assignedTargetOffsets.Add(0) == 0)
    {
        return false;
    }

    nextToken = afterCompactExpr;
    return true;
}

internal struct ParsedSwitchFieldAssignmentArm
{
    u32[0 max] AssignmentStart;
    u32[0 max] AssignmentCount;
    u32[0 max] LocalRootStart;
    u32[0 max] LocalRootCount;

    ParsedSwitchFieldAssignmentArm()
    {
        self.AssignmentStart = 0;
        self.AssignmentCount = 0;
        self.LocalRootStart = 0;
        self.LocalRootCount = 0;
    }
}

internal fn bool BuildSwitchFieldAssignmentArmLocalTypes(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchFieldAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] baseLocalCount,
    mut borrow IrTable<u32[0 max]> armLocalTypes)
{
    stack mut u64[0 2 ** 63 - 1] localTypeIndex = 0;
    while willexit (localTypeIndex < (u64[0 2 ** 63 - 1])baseLocalCount)
    {
        stack mut u32[0 max] typeCode = 0;
        stack u32[0 max] typeSlot = (u32[0 max])(localTypeIndex + 1);
        if (baseLocalTypes.Contains(typeSlot))
        {
            typeCode = baseLocalTypes.Get(typeSlot);
        }

        if (armLocalTypes.Add(typeCode) == 0)
        {
            return false;
        }

        localTypeIndex = localTypeIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack ExprType localType = TypeOfNodeWithLocals(nodes, localRoot, armLocalTypes);
        if (localType == ExprType.ErrorType || localType == ExprType.PtrType)
        {
            return false;
        }

        stack u32[0 max] localTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, localRoot, armLocalTypes);
        if (armLocalTypes.Add(localTypeCode) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    return true;
}

internal fn bool TryParseSwitchFieldAssignmentArm(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<ScalarStorageLocal> scalarStorageLocals,
    borrow IrTable<EnumStorageLocal> enumStorageLocals,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    borrow IrTable<ValueFacts> baseSourceValueFacts,
    borrow DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] armStart,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    mut borrow IrTable<EnumStorageAssignment> enumAssignments,
    mut borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    mut borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    out ParsedSwitchFieldAssignmentArm arm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap(stream, baseSourceValueFacts),
          overlap(source, baseSourceValueFacts),
          overlap(nodes, baseSourceValueFacts),
          overlap(baseParams, baseSourceValueFacts),
          overlap(funcNames, baseSourceValueFacts),
          overlap(constructedObjectLocals, baseSourceValueFacts),
          overlap(sliceDescriptorLocals, baseSourceValueFacts),
          overlap(scalarStorageLocals, baseSourceValueFacts),
          overlap(enumStorageLocals, baseSourceValueFacts),
          overlap(baseLocalTypes, baseSourceValueFacts),
          overlap(declarations, baseSourceValueFacts),
          overlap(enumLayouts, baseSourceValueFacts),
          overlap(armLocalRoots, baseSourceValueFacts),
          overlap(scalarAssignments, baseSourceValueFacts),
          overlap(enumAssignments, baseSourceValueFacts),
          overlap(fieldAssignments, baseSourceValueFacts),
          overlap(storageMutationStatements, baseSourceValueFacts)
{
    arm = new();
    nextToken = armStart;

    stack mut IrTable<ParamName> armParams = new();
    if (!CopyParamNamePrefix(baseParams, baseParamCount, armParams))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    stack mut IrTable<ValueFacts> armSourceValueFacts = new();
    stack mut u64[0 2 ** 63 - 1] baseTypeIndex = 0;
    while willexit (baseTypeIndex < baseParamCount)
    {
        stack mut u32[0 max] typeCode = 0;
        stack u32[0 max] typeSlot = (u32[0 max])(baseTypeIndex + 1);
        if (baseLocalTypes.Contains(typeSlot))
        {
            typeCode = baseLocalTypes.Get(typeSlot);
        }

        if (armLocalTypes.Add(typeCode) == 0)
        {
            return false;
        }

        stack mut ValueFacts baseFacts = new();
        if (baseSourceValueFacts.Contains(typeSlot))
        {
            baseFacts = baseSourceValueFacts.Get(typeSlot);
        }

        if (armSourceValueFacts.Add(baseFacts) == 0)
        {
            return false;
        }

        baseTypeIndex = baseTypeIndex + 1;
    }

    stack u32[0 max] localRootStart = (u32[0 max])(armLocalRoots.Count() + 1);
    stack u32[0 max] assignmentStart = (u32[0 max])(storageMutationStatements.Count() + 1);
    stack mut u32[0 max] localRootCount = 0;
    stack mut u32[0 max] assignmentCount = 0;

    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] cursor = armStart + 1;
        while willexit (cursor < (u64[0 2 ** 63 - 1])closeBrace && stream.KindAt(cursor) == TokenKind.Var)
        {
            stack mut u64[0 2 ** 63 - 1] localEnd = cursor;
            if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])closeBrace, localEnd))
            {
                return false;
            }

            stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, localEnd);
            if (localNameToken == 0)
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] localNameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
            stack u64[0 2 ** 63 - 1] localNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
            if (ParamIndexOf(armParams, source, localNameStart, localNameLength) >= 0)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] localAssignToken = localEnd;
            if (!FindSelfHostedStatementAssign(stream, cursor, localEnd, localAssignToken))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeLocal = armParams.Count();
            stack ExprParseResult localRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, armParams, funcNames, constructedObjectLocals, sliceDescriptorLocals, armLocalTypes, armSourceValueFacts, declarations, enumLayouts, localAssignToken + 1);
            if (localRoot.Next != localEnd || armParams.Count() != beforeLocal)
            {
                return false;
            }

            stack ExprType localType = TypeOfNodeWithLocals(nodes, localRoot.NodeId, armLocalTypes);
            if (localType == ExprType.ErrorType || localType == ExprType.PtrType)
            {
                return false;
            }

            stack u32[0 max] localIndex = ResolveParam(armParams, source, localNameStart, localNameLength);
            stack mut ValueFacts localFacts = new();
            if (!TryBuildSourceValueFactsForNode(nodes, localRoot.NodeId, armSourceValueFacts, localFacts)
                && localType == ExprType.BoolType)
            {
                localFacts.SetIntegerRange(0, 2);
            }

            if (armLocalRoots.Add(localRoot.NodeId) == 0
                || armLocalTypes.Add(SourceLocalTypeCodeForNodeWithLocals(nodes, localRoot.NodeId, armLocalTypes)) == 0
                || armSourceValueFacts.Add(localFacts) == 0)
            {
                return false;
            }

            localRootCount = localRootCount + 1;
            cursor = localEnd + 1;
        }

        while willexit (cursor < (u64[0 2 ** 63 - 1])closeBrace)
        {
            stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
            if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])closeBrace, statementEnd))
            {
                return false;
            }

            if (!TryParseSourceStorageMutationStatement(
                stream,
                source,
                nodes,
                armParams,
                funcNames,
                constructedObjectLocals,
                sliceDescriptorLocals,
                scalarStorageLocals,
                enumStorageLocals,
                armLocalTypes,
                armSourceValueFacts,
                declarations,
                enumLayouts,
                cursor,
                statementEnd,
                scalarAssignments,
                enumAssignments,
                fieldAssignments,
                storageMutationStatements))
            {
                return false;
            }

            assignmentCount = assignmentCount + 1;
            cursor = statementEnd + 1;
        }

        if (assignmentCount == 0 || cursor != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        arm.AssignmentStart = assignmentStart;
        arm.AssignmentCount = assignmentCount;
        arm.LocalRootStart = localRootStart;
        arm.LocalRootCount = localRootCount;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] compactEnd = armStart;
    if (!FindSelfHostedStatementEnd(stream, armStart, stream.Count(), compactEnd))
    {
        return false;
    }

    if (!TryParseSourceStorageMutationStatement(
        stream,
        source,
        nodes,
        armParams,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        scalarStorageLocals,
        enumStorageLocals,
        armLocalTypes,
        armSourceValueFacts,
        declarations,
        enumLayouts,
        armStart,
        compactEnd,
        scalarAssignments,
        enumAssignments,
        fieldAssignments,
        storageMutationStatements))
    {
        return false;
    }

    arm.AssignmentStart = assignmentStart;
    arm.AssignmentCount = 1;
    arm.LocalRootStart = localRootStart;
    arm.LocalRootCount = 0;
    nextToken = compactEnd + 1;
    return true;
}

internal fn bool ValidateSwitchFieldAssignmentArmModuleCalls(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchFieldAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] baseLocalCount,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<DistinctStoragePair> callerDistinctStorageFacts)
{
    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    if (!BuildSwitchFieldAssignmentArmLocalTypes(nodes, arm, armLocalRoots, baseLocalTypes, baseLocalCount, armLocalTypes))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        if (!ValidateModuleCallsForRootWithSlices(nodes, localRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentIndex = 0;
    while willexit (assignmentIndex < (u64[0 2 ** 63 - 1])arm.AssignmentCount)
    {
        stack u32[0 max] assignmentSlot = arm.AssignmentStart + (u32[0 max])assignmentIndex;
        if (!storageMutationStatements.Contains(assignmentSlot))
        {
            return false;
        }

        stack SourceStorageMutationStatement statement = storageMutationStatements.Get(assignmentSlot);
        if (statement.Kind == SourceStorageMutationKindScalar())
        {
            if (!scalarAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ScalarStorageAssignment assignment = scalarAssignments.Get(statement.AssignmentIndex);
            if (!ValidateModuleCallsForRootWithSlices(nodes, assignment.ExprRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindEnum())
        {
            if (!enumAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack EnumStorageAssignment assignment = enumAssignments.Get(statement.AssignmentIndex);
            if (!ValidateModuleCallsForRootWithSlices(nodes, assignment.ExprRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindConstructedObjectField())
        {
            if (!fieldAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ConstructedObjectFieldAssignment assignment = fieldAssignments.Get(statement.AssignmentIndex);
            if (assignment.IndexRoot != 0
                && !ValidateModuleCallsForRootWithSlices(nodes, assignment.IndexRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
            {
                return false;
            }

            if (!ValidateModuleCallsForRootWithSlices(nodes, assignment.ExprRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
            {
                return false;
            }
        }
        else
        {
            return false;
        }

        assignmentIndex = assignmentIndex + 1;
    }

    return true;
}

internal fn bool LowerSwitchFieldAssignmentArmStores(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchFieldAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] overrideIndex = 0;
    while willexit (overrideIndex < baseLocalOverrides.Count())
    {
        stack u32[0 max] overrideValue = baseLocalOverrides.Get((u32[0 max])(overrideIndex + 1));
        if (localOverrides.Add(overrideValue) == 0)
        {
            return false;
        }

        overrideIndex = overrideIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack MirValueId localValue = LowerExprNodeWithCallContext(nodes, localRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (localOverrides.Add(localValue.Index()) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentIndex = 0;
    while willexit (assignmentIndex < (u64[0 2 ** 63 - 1])arm.AssignmentCount)
    {
        stack u32[0 max] assignmentSlot = arm.AssignmentStart + (u32[0 max])assignmentIndex;
        if (!storageMutationStatements.Contains(assignmentSlot))
        {
            return false;
        }

        stack SourceStorageMutationStatement statement = storageMutationStatements.Get(assignmentSlot);
        if (statement.Kind == SourceStorageMutationKindScalar())
        {
            if (!scalarAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ScalarStorageAssignment assignment = scalarAssignments.Get(statement.AssignmentIndex);
            if (!LowerScalarStorageAssignmentWithCallContext(assignment, nodes, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindEnum())
        {
            if (!enumAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack EnumStorageAssignment assignment = enumAssignments.Get(statement.AssignmentIndex);
            if (!LowerEnumStorageAssignmentWithCallContext(assignment, nodes, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindConstructedObjectField())
        {
            if (!fieldAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ConstructedObjectFieldAssignment assignment = fieldAssignments.Get(statement.AssignmentIndex);
            if (!LowerConstructedObjectFieldAssignmentWithCallContext(assignment, nodes, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals))
            {
                return false;
            }
        }
        else
        {
            return false;
        }

        assignmentIndex = assignmentIndex + 1;
    }

    return true;
}



internal fn bool LowerTerminalIntegerSwitchCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<i64[min max]> caseMaxValues,
    borrow IrTable<ExprParseResult> caseArms,
    ExprParseResult defaultArm,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    bool hasDeclaredReturnType,
    MirType declaredReturnType,
    out LoweredBody body)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseMaxValues.Count() != caseCountWide || caseArms.Count() != caseCountWide)
    {
        return false;
    }

    stack ExprType scrutineeType = TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes);
    if (scrutineeType != ExprType.IntType && scrutineeType != ExprType.EnumType)
    {
        return false;
    }

    stack ExprType defaultType = TypeOfNodeWithLocals(nodes, defaultArm.NodeId, localTypes);
    if (defaultType != ExprType.IntType && defaultType != ExprType.BoolType)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] typeIndex = 0;
    while willexit (typeIndex < caseCountWide)
    {
        stack ExprParseResult caseArm = caseArms.Get((u32[0 max])(typeIndex + 1));
        if (TypeOfNodeWithLocals(nodes, caseArm.NodeId, localTypes) != defaultType)
        {
            return false;
        }

        typeIndex = typeIndex + 1;
    }

    stack u32[0 max] caseCount = (u32[0 max])caseCountWide;
    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] caseReturnBase = firstBlock + caseCount;
    stack u32[0 max] defaultBlockIndex = firstBlock + caseCount + caseCount;

    stack mut IrTable<u32[0 max]> testFirsts = new();
    stack mut IrTable<u32[0 max]> testCounts = new();
    stack mut IrTable<u32[0 max]> conditionValues = new();
    stack mut IrTable<u32[0 max]> caseFirsts = new();
    stack mut IrTable<u32[0 max]> caseCounts = new();
    stack mut IrTable<u32[0 max]> returnValues = new();

    stack MirValueId scrutineeValue = LowerExprNodeWithTypesAndLocals(nodes, scrutineeNode, instrs, localTypes, localOverrides);
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack mut u32[0 max] testFirst = (u32[0 max])instrs.Count() + 1;
        if (caseIndex == 0)
        {
            testFirst = entryFirst;
        }

        stack i64[min max] caseMin = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack i64[min max] caseMax = caseMaxValues.Get((u32[0 max])(caseIndex + 1));
        stack MirValueId condition = LowerIntegerSwitchCaseCondition(instrs, scrutineeValue, caseMin, caseMax);
        stack u32[0 max] testCount = (u32[0 max])instrs.Count() - (testFirst - 1);
        if (testFirsts.Add(testFirst) == 0
            || testCounts.Add(testCount) == 0
            || conditionValues.Add(condition.Index()) == 0)
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack ExprParseResult caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        stack u32[0 max] caseFirst = (u32[0 max])instrs.Count() + 1;
        stack MirValueId caseValue = LowerScalarReturnExprNodeWithTypesAndLocals(
            nodes,
            caseArm.NodeId,
            instrs,
            localTypes,
            localOverrides,
            defaultType,
            hasDeclaredReturnType,
            declaredReturnType);

        stack u32[0 max] caseInstrCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
        if (caseFirsts.Add(caseFirst) == 0
            || caseCounts.Add(caseInstrCount) == 0
            || returnValues.Add(caseValue.Index()) == 0)
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    stack u32[0 max] defaultFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId defaultValue = LowerScalarReturnExprNodeWithTypesAndLocals(
        nodes,
        defaultArm.NodeId,
        instrs,
        localTypes,
        localOverrides,
        defaultType,
        hasDeclaredReturnType,
        declaredReturnType);

    stack u32[0 max] defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] currentBlock = firstBlock + (u32[0 max])caseIndex;
        stack u32[0 max] thenBlock = caseReturnBase + (u32[0 max])caseIndex;
        stack mut u32[0 max] elseBlock = defaultBlockIndex;
        if (caseIndex + 1 < caseCountWide)
        {
            elseBlock = currentBlock + 1;
        }

        stack u32[0 max] conditionValue = conditionValues.Get((u32[0 max])(caseIndex + 1));
        stack MirBlockId testBlock = MirCondBlock(
            blocks,
            MirValueIdOf(conditionValue),
            MirBlockIdOf(thenBlock),
            MirBlockIdOf(elseBlock));
        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] returnValue = returnValues.Get((u32[0 max])(caseIndex + 1));
        stack MirBlockId caseBlock = MirReturnBlock(blocks, MirValueIdOf(returnValue));
        caseIndex = caseIndex + 1;
    }

    stack MirBlockId defaultBlock = MirReturnBlock(blocks, defaultValue);

    if (recordRanges)
    {
        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] testFirst = testFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testCount = testCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testRange = ranges.Add(MakeBlockEmit(
                firstBlock + (u32[0 max])caseIndex,
                testFirst,
                testCount));
            caseIndex = caseIndex + 1;
        }

        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] caseFirst = caseFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRangeCount = caseCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(
                caseReturnBase + (u32[0 max])caseIndex,
                caseFirst,
                caseRangeCount));
            caseIndex = caseIndex + 1;
        }

        stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(defaultBlock.Index(), defaultFirst, defaultCount));
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    stack u32[0 max] firstConditionValue = conditionValues.Get(1);
    stack u32[0 max] firstReturnValue = returnValues.Get(1);
    body.CondValue = firstConditionValue;
    body.ThenValue = firstReturnValue;
    body.ElseValue = defaultValue.Index();
    return true;
}

internal fn bool LowerTerminalBooleanSwitchCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<u32[0 max]> caseValues,
    borrow IrTable<ExprParseResult> caseArms,
    ExprParseResult defaultArm,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    bool hasDeclaredReturnType,
    MirType declaredReturnType,
    out LoweredBody body)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseCountWide > 2 || caseArms.Count() != caseCountWide)
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType defaultType = TypeOfNodeWithLocals(nodes, defaultArm.NodeId, localTypes);
    if (defaultType != ExprType.IntType && defaultType != ExprType.BoolType)
    {
        return false;
    }

    stack mut bool hasTrue = false;
    stack mut bool hasFalse = false;
    stack mut ExprParseResult trueArm = new();
    stack mut ExprParseResult falseArm = new();
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] caseValue = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack ExprParseResult caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        if (TypeOfNodeWithLocals(nodes, caseArm.NodeId, localTypes) != defaultType)
        {
            return false;
        }

        if (caseValue == 1)
        {
            hasTrue = true;
            trueArm = caseArm;
        }
        else if (caseValue == 0)
        {
            hasFalse = true;
            falseArm = caseArm;
        }
        else
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack MirValueId scrutineeValue = LowerExprNodeWithTypesAndLocals(nodes, scrutineeNode, instrs, localTypes, localOverrides);
    if (MirValueType(instrs, scrutineeValue.Index()) != MirType.I1)
    {
        return false;
    }

    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);
    if (hasTrue && hasFalse)
    {
        stack u32[0 max] trueFirst = (u32[0 max])instrs.Count() + 1;
        stack MirValueId trueValue = LowerScalarReturnExprNodeWithTypesAndLocals(
            nodes,
            trueArm.NodeId,
            instrs,
            localTypes,
            localOverrides,
            defaultType,
            hasDeclaredReturnType,
            declaredReturnType);

        stack u32[0 max] trueCount = (u32[0 max])instrs.Count() - (trueFirst - 1);
        stack u32[0 max] falseFirst = (u32[0 max])instrs.Count() + 1;
        stack MirValueId falseValue = LowerScalarReturnExprNodeWithTypesAndLocals(
            nodes,
            falseArm.NodeId,
            instrs,
            localTypes,
            localOverrides,
            defaultType,
            hasDeclaredReturnType,
            declaredReturnType);

        stack u32[0 max] falseCount = (u32[0 max])instrs.Count() - (falseFirst - 1);

        stack MirBlockId entry = MirCondBlock(blocks, scrutineeValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
        stack MirBlockId trueBlock = MirReturnBlock(blocks, trueValue);
        stack MirBlockId falseBlock = MirReturnBlock(blocks, falseValue);

        if (recordRanges)
        {
            stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
            stack u32[0 max] trueRange = ranges.Add(MakeBlockEmit(trueBlock.Index(), trueFirst, trueCount));
            stack u32[0 max] falseRange = ranges.Add(MakeBlockEmit(falseBlock.Index(), falseFirst, falseCount));
        }

        body.Ok = true;
        body.EntryBlock = entry.Index();
        body.ParamCount = paramCount;
        body.CondValue = scrutineeValue.Index();
        body.ThenValue = trueValue.Index();
        body.ElseValue = falseValue.Index();
        return true;
    }

    stack mut ExprParseResult selectedArm = falseArm;
    if (hasTrue)
    {
        selectedArm = trueArm;
    }

    stack u32[0 max] caseFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId caseValue = LowerScalarReturnExprNodeWithTypesAndLocals(
        nodes,
        selectedArm.NodeId,
        instrs,
        localTypes,
        localOverrides,
        defaultType,
        hasDeclaredReturnType,
        declaredReturnType);

    stack u32[0 max] caseCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
    stack u32[0 max] defaultFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId defaultValue = LowerScalarReturnExprNodeWithTypesAndLocals(
        nodes,
        defaultArm.NodeId,
        instrs,
        localTypes,
        localOverrides,
        defaultType,
        hasDeclaredReturnType,
        declaredReturnType);

    stack u32[0 max] defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);
    stack mut MirBlockId thenBlock = MirBlockIdOf(firstBlock + 1);
    stack mut MirBlockId elseBlock = MirBlockIdOf(firstBlock + 2);
    if (hasFalse)
    {
        thenBlock = MirBlockIdOf(firstBlock + 2);
        elseBlock = MirBlockIdOf(firstBlock + 1);
    }

    stack MirBlockId entry = MirCondBlock(blocks, scrutineeValue, thenBlock, elseBlock);
    stack MirBlockId selectedBlock = MirReturnBlock(blocks, caseValue);
    stack MirBlockId defaultBlock = MirReturnBlock(blocks, defaultValue);

    if (recordRanges)
    {
        stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(selectedBlock.Index(), caseFirst, caseCount));
        stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(defaultBlock.Index(), defaultFirst, defaultCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = paramCount;
    body.CondValue = scrutineeValue.Index();
    body.ThenValue = caseValue.Index();
    body.ElseValue = defaultValue.Index();
    return true;
}

internal fn bool BuildSwitchAssignmentArmLocalTypes(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] paramCount,
    mut borrow IrTable<u32[0 max]> armLocalTypes)
{
    stack mut u64[0 2 ** 63 - 1] paramIndex = 0;
    while willexit (paramIndex < paramCount)
    {
        stack mut u32[0 max] typeCode = 0;
        stack u32[0 max] typeSlot = (u32[0 max])(paramIndex + 1);
        if (baseLocalTypes.Contains(typeSlot))
        {
            typeCode = baseLocalTypes.Get(typeSlot);
        }

        if (armLocalTypes.Add(typeCode) == 0)
        {
            return false;
        }

        paramIndex = paramIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack ExprType localType = TypeOfNodeWithLocals(nodes, localRoot, armLocalTypes);
        if (localType == ExprType.ErrorType || localType == ExprType.PtrType)
        {
            return false;
        }

        stack u32[0 max] localTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, localRoot, armLocalTypes);

        if (armLocalTypes.Add(localTypeCode) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    return true;
}

internal fn ExprType TypeOfSwitchAssignmentArm(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] paramCount,
    u32[0 max] targetOffset)
{
    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    if (!BuildSwitchAssignmentArmLocalTypes(nodes, arm, armLocalRoots, baseLocalTypes, paramCount, armLocalTypes))
    {
        return ExprType.ErrorType;
    }

    if (targetOffset >= arm.AssignedRootCount)
    {
        return ExprType.ErrorType;
    }

    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return ExprType.ErrorType;
        }

        stack u32[0 max] currentTargetOffset = assignedTargetOffsets.Get(rootSlot);
        if (currentTargetOffset == targetOffset)
        {
            stack u32[0 max] rootNode = assignedRoots.Get(rootSlot);
            return TypeOfNodeWithLocals(nodes, rootNode, armLocalTypes);
        }

        assignedIndex = assignedIndex + 1;
    }

    return ExprType.ErrorType;
}

internal fn bool TryGetSwitchAssignmentArmAssignedRoot(
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    u32[0 max] targetOffset,
    out u32[0 max] rootNode)
{
    rootNode = 0;
    if (targetOffset >= arm.AssignedRootCount)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return false;
        }

        if (assignedTargetOffsets.Get(rootSlot) == targetOffset)
        {
            rootNode = assignedRoots.Get(rootSlot);
            return true;
        }

        assignedIndex = assignedIndex + 1;
    }

    return false;
}

internal fn bool UpdateSwitchAssignmentTargetRawPointerFacts(
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    ParsedSwitchAssignmentArm defaultArm,
    u32[0 max] targetParamIndex,
    u32[0 max] targetOffset,
    u32[0 max] caseCount)
{
    stack mut u32[0 max] defaultRoot = 0;
    if (!TryGetSwitchAssignmentArmAssignedRoot(defaultArm, assignedRoots, assignedTargetOffsets, targetOffset, defaultRoot))
    {
        return false;
    }

    stack mut bool mergedMutable = false;
    stack mut u32[0 max] mergedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] mergedElementSize = 0;
    stack mut u32[0 max] mergedElementAlignment = 0;
    stack mut bool defaultMutable = false;
    stack mut u32[0 max] defaultFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] defaultElementSize = 0;
    stack mut u32[0 max] defaultElementAlignment = 0;
    stack bool defaultIsRawPointer = TryGetRawPointerFactsForNode(
        nodes,
        params,
        defaultRoot,
        defaultMutable,
        defaultFieldTypeCode,
        defaultElementSize,
        defaultElementAlignment);

    stack mut bool anyRawPointer = defaultIsRawPointer;
    stack mut bool hasElementCount = false;
    stack mut bool elementCountIsParam = false;
    stack mut u32[0 max] elementCountLiteral = 0;
    stack mut u32[0 max] elementCountParamIndex = 0;
    if (defaultIsRawPointer)
    {
        mergedMutable = defaultMutable;
        mergedFieldTypeCode = defaultFieldTypeCode;
        mergedElementSize = defaultElementSize;
        mergedElementAlignment = defaultElementAlignment;
        if (!TryGetRawPointerElementCountFactsForNameNode(
            nodes,
            params,
            defaultRoot,
            hasElementCount,
            elementCountIsParam,
            elementCountLiteral,
            elementCountParamIndex))
        {
            hasElementCount = false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < (u64[0 2 ** 63 - 1])caseCount)
    {
        if (!caseArms.Contains((u32[0 max])(caseIndex + 1)))
        {
            return false;
        }

        stack ParsedSwitchAssignmentArm caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        stack mut u32[0 max] caseRoot = 0;
        if (!TryGetSwitchAssignmentArmAssignedRoot(caseArm, assignedRoots, assignedTargetOffsets, targetOffset, caseRoot))
        {
            return false;
        }

        stack mut bool caseMutable = false;
        stack mut u32[0 max] caseFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] caseElementSize = 0;
        stack mut u32[0 max] caseElementAlignment = 0;
        stack bool caseIsRawPointer = TryGetRawPointerFactsForNode(
            nodes,
            params,
            caseRoot,
            caseMutable,
            caseFieldTypeCode,
            caseElementSize,
            caseElementAlignment);
        anyRawPointer = anyRawPointer || caseIsRawPointer;
        if (defaultIsRawPointer || caseIsRawPointer)
        {
            if (!defaultIsRawPointer
                || !caseIsRawPointer
                || mergedMutable != caseMutable
                || mergedFieldTypeCode != caseFieldTypeCode
                || mergedElementSize != caseElementSize
                || mergedElementAlignment != caseElementAlignment)
            {
                return false;
            }

            stack mut bool caseHasElementCount = false;
            stack mut bool caseElementCountIsParam = false;
            stack mut u32[0 max] caseElementCountLiteral = 0;
            stack mut u32[0 max] caseElementCountParamIndex = 0;
            if (!TryGetRawPointerElementCountFactsForNameNode(
                nodes,
                params,
                caseRoot,
                caseHasElementCount,
                caseElementCountIsParam,
                caseElementCountLiteral,
                caseElementCountParamIndex)
                || !RawPointerElementCountFactsEqual(
                    hasElementCount,
                    elementCountIsParam,
                    elementCountLiteral,
                    elementCountParamIndex,
                    caseHasElementCount,
                    caseElementCountIsParam,
                    caseElementCountLiteral,
                    caseElementCountParamIndex))
            {
                hasElementCount = false;
            }
        }

        caseIndex = caseIndex + 1;
    }

    if (!anyRawPointer)
    {
        return true;
    }

    return ReplaceParamRawPointerFacts(
        params,
        targetParamIndex,
        mergedMutable,
        mergedFieldTypeCode,
        mergedElementSize,
        mergedElementAlignment,
        hasElementCount,
        elementCountIsParam,
        elementCountLiteral,
        elementCountParamIndex);
}

internal fn bool ValidateSwitchAssignmentArmModuleCalls(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] paramCount,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<DistinctStoragePair> callerDistinctStorageFacts)
{
    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    if (!BuildSwitchAssignmentArmLocalTypes(nodes, arm, armLocalRoots, baseLocalTypes, paramCount, armLocalTypes))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        if (!ValidateModuleCallsForRoot(nodes, localRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, callerDistinctStorageFacts))
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] assignedRoot = assignedRoots.Get(rootSlot);
        if (!ValidateModuleCallsForRoot(nodes, assignedRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, callerDistinctStorageFacts))
        {
            return false;
        }

        assignedIndex = assignedIndex + 1;
    }

    return true;
}

internal fn bool LowerSwitchAssignmentArmValues(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> localTypes,
    u32[0 max] paramCount,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<u32[0 max]> values)
{
    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] paramIndex = 0;
    while willexit (paramIndex < paramCount)
    {
        if (localOverrides.Add(0) == 0)
        {
            return false;
        }

        paramIndex = paramIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack MirValueId localValue = LowerExprNodeWithTypesAndLocals(nodes, localRoot, instrs, localTypes, localOverrides);
        if (localOverrides.Add(localValue.Index()) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut IrTable<u32[0 max]> sourceOrderValues = new();
    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] assignedRoot = assignedRoots.Get(rootSlot);
        stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, assignedRoot, instrs, localTypes, localOverrides);
        if (sourceOrderValues.Add(value.Index()) == 0)
        {
            return false;
        }

        assignedIndex = assignedIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] targetIndex = 0;
    while willexit (targetIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack mut bool foundTarget = false;
        assignedIndex = 0;
        while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
        {
            stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
            stack u32[0 max] currentTargetOffset = assignedTargetOffsets.Get(rootSlot);
            if (currentTargetOffset == (u32[0 max])targetIndex)
            {
                if (foundTarget)
                {
                    return false;
                }

                stack u32[0 max] sourceOrderValue = sourceOrderValues.Get((u32[0 max])(assignedIndex + 1));
                if (values.Add(sourceOrderValue) == 0)
                {
                    return false;
                }

                foundTarget = true;
            }

            assignedIndex = assignedIndex + 1;
        }

        if (!foundTarget)
        {
            return false;
        }

        targetIndex = targetIndex + 1;
    }

    return true;
}

internal fn bool LowerAssignedIntegerSwitchCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<i64[min max]> caseMaxValues,
    borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    ParsedSwitchAssignmentArm defaultArm,
    u32[0 max] targetCount,
    borrow IrTable<u32[0 max]> postLocalRoots,
    bool hasTerminalIf,
    ParsedIfReturnArms terminalIfArms,
    u32[0 max] returnRootNode,
    borrow IrTable<u32[0 max]> localTypes,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseMaxValues.Count() != caseCountWide || caseArms.Count() != caseCountWide || targetCount == 0)
    {
        return false;
    }

    stack ExprType scrutineeType = TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes);
    if (scrutineeType != ExprType.IntType && scrutineeType != ExprType.EnumType)
    {
        return false;
    }

    if (localTypes.Count() < (u64[0 2 ** 63 - 1])(paramCount + targetCount))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> phiTypeCodes = new();
    stack mut u64[0 2 ** 63 - 1] targetTypeIndex = 0;
    while willexit (targetTypeIndex < (u64[0 2 ** 63 - 1])targetCount)
    {
        stack u32[0 max] targetTypeCode = localTypes.Get(paramCount + (u32[0 max])targetTypeIndex + 1);
        stack mut ExprType expectedTargetType = ExprType.IntType;
        if (targetTypeCode == SourceLocalTypeCodeBool())
        {
            expectedTargetType = ExprType.BoolType;
        }
        else if (targetTypeCode == SourceLocalTypeCodePointer())
        {
            expectedTargetType = ExprType.PtrType;
        }

        if (TypeOfSwitchAssignmentArm(nodes, defaultArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, (u32[0 max])targetTypeIndex) != expectedTargetType)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] typeIndex = 0;
        while willexit (typeIndex < caseCountWide)
        {
            stack ParsedSwitchAssignmentArm caseArm = caseArms.Get((u32[0 max])(typeIndex + 1));
            if (TypeOfSwitchAssignmentArm(nodes, caseArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, (u32[0 max])targetTypeIndex) != expectedTargetType)
            {
                return false;
            }

            typeIndex = typeIndex + 1;
        }

        if (phiTypeCodes.Add(targetTypeCode) == 0)
        {
            return false;
        }

        targetTypeIndex = targetTypeIndex + 1;
    }

    stack mut ExprType rootType = ExprType.IntType;
    stack mut bool terminalBothBool = false;
    if (hasTerminalIf)
    {
        if (TypeOfNodeWithLocals(nodes, terminalIfArms.Condition.NodeId, localTypes) != ExprType.BoolType)
        {
            return false;
        }

        stack ExprType thenType = TypeOfNodeWithLocals(nodes, terminalIfArms.ThenArm.NodeId, localTypes);
        stack ExprType elseType = TypeOfNodeWithLocals(nodes, terminalIfArms.ElseArm.NodeId, localTypes);
        stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
        terminalBothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
        if (!bothInt && !terminalBothBool)
        {
            return false;
        }

        rootType = thenType;
    }
    else
    {
        rootType = TypeOfNodeWithLocals(nodes, returnRootNode, localTypes);
        if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRootNode, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack u32[0 max] caseCount = (u32[0 max])caseCountWide;
    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] caseBlockBase = firstBlock + caseCount;
    stack u32[0 max] defaultBlockIndex = caseBlockBase + caseCount;
    stack u32[0 max] mergeBlockBase = defaultBlockIndex + 1;
    stack u32[0 max] terminalThenBlockIndex = mergeBlockBase + caseCount;
    stack u32[0 max] terminalElseBlockIndex = terminalThenBlockIndex + 1;

    stack mut IrTable<u32[0 max]> testFirsts = new();
    stack mut IrTable<u32[0 max]> testCounts = new();
    stack mut IrTable<u32[0 max]> conditionValues = new();
    stack mut IrTable<u32[0 max]> caseFirsts = new();
    stack mut IrTable<u32[0 max]> caseCounts = new();
    stack mut IrTable<u32[0 max]> assignedValues = new();
    stack mut IrTable<u32[0 max]> defaultValues = new();
    stack mut IrTable<u32[0 max]> mergeFirsts = new();
    stack mut IrTable<u32[0 max]> mergeCounts = new();

    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId scrutineeValue = LowerExprNodeWithTypesAndLocals(nodes, scrutineeNode, instrs, localTypes, noOverrides);
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack mut u32[0 max] testFirst = (u32[0 max])instrs.Count() + 1;
        if (caseIndex == 0)
        {
            testFirst = entryFirst;
        }

        stack i64[min max] caseMin = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack i64[min max] caseMax = caseMaxValues.Get((u32[0 max])(caseIndex + 1));
        stack MirValueId condition = LowerIntegerSwitchCaseCondition(instrs, scrutineeValue, caseMin, caseMax);
        stack u32[0 max] testCount = (u32[0 max])instrs.Count() - (testFirst - 1);
        if (testFirsts.Add(testFirst) == 0
            || testCounts.Add(testCount) == 0
            || conditionValues.Add(condition.Index()) == 0)
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack ParsedSwitchAssignmentArm caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        stack u32[0 max] caseFirst = (u32[0 max])instrs.Count() + 1;
        stack mut IrTable<u32[0 max]> caseArmValues = new();
        if (!LowerSwitchAssignmentArmValues(nodes, caseArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, caseArmValues)
            || caseArmValues.Count() != (u64[0 2 ** 63 - 1])targetCount)
        {
            return false;
        }

        stack u32[0 max] caseInstrCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
        if (caseFirsts.Add(caseFirst) == 0
            || caseCounts.Add(caseInstrCount) == 0)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] targetValueIndex = 0;
        while willexit (targetValueIndex < (u64[0 2 ** 63 - 1])targetCount)
        {
            stack u32[0 max] caseArmValue = caseArmValues.Get((u32[0 max])(targetValueIndex + 1));
            if (assignedValues.Add(caseArmValue) == 0)
            {
                return false;
            }

            targetValueIndex = targetValueIndex + 1;
        }

        caseIndex = caseIndex + 1;
    }

    stack u32[0 max] defaultFirst = (u32[0 max])instrs.Count() + 1;
    if (!LowerSwitchAssignmentArmValues(nodes, defaultArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, defaultValues)
        || defaultValues.Count() != (u64[0 2 ** 63 - 1])targetCount)
    {
        return false;
    }

    stack u32[0 max] defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);

    stack mut IrTable<u32[0 max]> tailValues = new();
    stack mut u64[0 2 ** 63 - 1] initialTailIndex = 0;
    while willexit (initialTailIndex < (u64[0 2 ** 63 - 1])targetCount)
    {
        stack u32[0 max] defaultValue = defaultValues.Get((u32[0 max])(initialTailIndex + 1));
        if (tailValues.Add(defaultValue) == 0)
        {
            return false;
        }

        initialTailIndex = initialTailIndex + 1;
    }

    stack mut u32[0 max] tailBlock = defaultBlockIndex;
    stack mut IrTable<u32[0 max]> finalPhis = new();
    stack u32[0 max] firstDefaultValue = defaultValues.Get(1);
    stack mut MirValueId finalReturnValue = MirValueIdOf(firstDefaultValue);
    stack mut MirValueId terminalIfCondValue = MirValueIdOf(firstDefaultValue);
    stack mut MirValueId terminalIfThenValue = MirValueIdOf(firstDefaultValue);
    stack mut MirValueId terminalIfElseValue = MirValueIdOf(firstDefaultValue);
    stack mut u32[0 max] terminalIfMergeCount = 0;
    stack mut u32[0 max] terminalIfThenFirst = 0;
    stack mut u32[0 max] terminalIfThenCount = 0;
    stack mut u32[0 max] terminalIfElseFirst = 0;
    stack mut u32[0 max] terminalIfElseCount = 0;
    caseIndex = caseCountWide;
    while willexit (caseIndex > 0)
    {
        caseIndex = caseIndex - 1;
        stack u32[0 max] caseBlockIndex = caseBlockBase + (u32[0 max])caseIndex;
        stack u32[0 max] mergeBlockIndex = mergeBlockBase + (u32[0 max])caseIndex;
        stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
        stack mut IrTable<u32[0 max]> newTailValues = new();
        stack mut u64[0 2 ** 63 - 1] targetPhiIndex = 0;
        while willexit (targetPhiIndex < (u64[0 2 ** 63 - 1])targetCount)
        {
            stack u32[0 max] caseAssignedValue = assignedValues.Get((u32[0 max])(caseIndex * (u64[0 2 ** 63 - 1])targetCount + targetPhiIndex + 1));
            stack u32[0 max] incomingTailValue = tailValues.Get((u32[0 max])(targetPhiIndex + 1));
            stack u32[0 max] targetTypeCode = phiTypeCodes.Get((u32[0 max])(targetPhiIndex + 1));
            stack mut MirType phiType = MirType.I64;
            stack mut MirType knownPhiType = MirType.I64;
            if (TryMirTypeForSourceLocalValueTypeCode(targetTypeCode, knownPhiType))
            {
                phiType = knownPhiType;
            }

            stack MirValueId phi = MirPhi2Typed(
                instrs,
                phiType,
                MirValueIdOf(caseAssignedValue),
                MirBlockIdOf(caseBlockIndex),
                MirValueIdOf(incomingTailValue),
                MirBlockIdOf(tailBlock));
            if (newTailValues.Add(phi.Index()) == 0)
            {
                return false;
            }

            targetPhiIndex = targetPhiIndex + 1;
        }

        if (caseIndex == 0)
        {
            stack mut IrTable<u32[0 max]> returnOverrides = new();
            stack mut u64[0 2 ** 63 - 1] p = 0;
            while willexit (p < paramCount)
            {
                if (returnOverrides.Add(0) == 0)
                {
                    return false;
                }

                p = p + 1;
            }

            targetPhiIndex = 0;
            while willexit (targetPhiIndex < (u64[0 2 ** 63 - 1])targetCount)
            {
                stack u32[0 max] finalPhiIndex = newTailValues.Get((u32[0 max])(targetPhiIndex + 1));
                if (finalPhis.Add(finalPhiIndex) == 0 || returnOverrides.Add(finalPhiIndex) == 0)
                {
                    return false;
                }

                targetPhiIndex = targetPhiIndex + 1;
            }

            postLocalIndex = 0;
            while willexit (postLocalIndex < postLocalRoots.Count())
            {
                stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
                stack MirValueId postLocalValue = LowerExprNodeWithTypesAndLocals(nodes, postLocalRootNode, instrs, localTypes, returnOverrides);
                if (returnOverrides.Add(postLocalValue.Index()) == 0)
                {
                    return false;
                }

                postLocalIndex = postLocalIndex + 1;
            }

            if (hasTerminalIf)
            {
                terminalIfCondValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.Condition.NodeId, instrs, localTypes, returnOverrides);
                terminalIfMergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

                terminalIfThenFirst = (u32[0 max])instrs.Count() + 1;
                terminalIfThenValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.ThenArm.NodeId, instrs, localTypes, returnOverrides);
                if (terminalBothBool)
                {
                    terminalIfThenValue = MirZExt(instrs, terminalIfThenValue);
                }

                terminalIfThenCount = (u32[0 max])instrs.Count() - (terminalIfThenFirst - 1);

                terminalIfElseFirst = (u32[0 max])instrs.Count() + 1;
                terminalIfElseValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.ElseArm.NodeId, instrs, localTypes, returnOverrides);
                if (terminalBothBool)
                {
                    terminalIfElseValue = MirZExt(instrs, terminalIfElseValue);
                }

                terminalIfElseCount = (u32[0 max])instrs.Count() - (terminalIfElseFirst - 1);
            }
            else
            {
                stack mut MirValueId returnValue = LowerExprNodeWithTypesAndLocals(nodes, returnRootNode, instrs, localTypes, returnOverrides);
                if (rootType == ExprType.BoolType)
                {
                    returnValue = MirZExt(instrs, returnValue);
                }

                finalReturnValue = returnValue;
            }
        }

        stack mut u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);
        if (hasTerminalIf && caseIndex == 0)
        {
            mergeCount = terminalIfMergeCount;
        }

        if (mergeFirsts.Add(mergeFirst) == 0 || mergeCounts.Add(mergeCount) == 0)
        {
            return false;
        }

        tailValues = newTailValues;
        tailBlock = mergeBlockIndex;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] currentBlock = firstBlock + (u32[0 max])caseIndex;
        stack u32[0 max] thenBlock = caseBlockBase + (u32[0 max])caseIndex;
        stack mut u32[0 max] elseBlock = defaultBlockIndex;
        if (caseIndex + 1 < caseCountWide)
        {
            elseBlock = currentBlock + 1;
        }

        stack u32[0 max] conditionValue = conditionValues.Get((u32[0 max])(caseIndex + 1));
        stack MirBlockId testBlock = MirCondBlock(
            blocks,
            MirValueIdOf(conditionValue),
            MirBlockIdOf(thenBlock),
            MirBlockIdOf(elseBlock));
        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] mergeBlockIndex = mergeBlockBase + (u32[0 max])caseIndex;
        stack MirBlockId caseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        caseIndex = caseIndex + 1;
    }

    stack MirBlockId defaultBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockBase + caseCount - 1));

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        if (caseIndex == 0)
        {
            if (hasTerminalIf)
            {
                stack MirBlockId mergeBlock = MirCondBlock(
                    blocks,
                    terminalIfCondValue,
                    MirBlockIdOf(terminalThenBlockIndex),
                    MirBlockIdOf(terminalElseBlockIndex));
            }
            else
            {
                stack MirBlockId mergeBlock = MirReturnBlock(blocks, finalReturnValue);
            }
        }
        else
        {
            stack MirBlockId mergeBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockBase + (u32[0 max])caseIndex - 1));
        }

        caseIndex = caseIndex + 1;
    }

    if (hasTerminalIf)
    {
        stack MirBlockId terminalThenBlock = MirReturnBlock(blocks, terminalIfThenValue);
        stack MirBlockId terminalElseBlock = MirReturnBlock(blocks, terminalIfElseValue);
    }

    if (recordRanges)
    {
        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] testFirst = testFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testCount = testCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testRange = ranges.Add(MakeBlockEmit(
                firstBlock + (u32[0 max])caseIndex,
                testFirst,
                testCount));
            caseIndex = caseIndex + 1;
        }

        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] caseFirst = caseFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRangeCount = caseCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(
                caseBlockBase + (u32[0 max])caseIndex,
                caseFirst,
                caseRangeCount));
            caseIndex = caseIndex + 1;
        }

        stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(defaultBlock.Index(), defaultFirst, defaultCount));

        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] storedIndex = (u32[0 max])(caseCountWide - caseIndex);
            stack u32[0 max] mergeFirst = mergeFirsts.Get(storedIndex);
            stack u32[0 max] mergeCount = mergeCounts.Get(storedIndex);
            stack u32[0 max] mergeRange = ranges.Add(MakeBlockEmit(
                mergeBlockBase + (u32[0 max])caseIndex,
                mergeFirst,
                mergeCount));
            caseIndex = caseIndex + 1;
        }

        if (hasTerminalIf)
        {
            stack u32[0 max] terminalThenRange = ranges.Add(MakeBlockEmit(
                terminalThenBlockIndex,
                terminalIfThenFirst,
                terminalIfThenCount));
            stack u32[0 max] terminalElseRange = ranges.Add(MakeBlockEmit(
                terminalElseBlockIndex,
                terminalIfElseFirst,
                terminalIfElseCount));
        }
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    stack u32[0 max] firstConditionValue = conditionValues.Get(1);
    body.CondValue = firstConditionValue;
    body.ThenValue = finalPhis.Get(1);
    if (hasTerminalIf)
    {
        body.ElseValue = terminalIfCondValue.Index();
    }
    else
    {
        body.ElseValue = finalReturnValue.Index();
    }

    return true;
}

internal fn bool LowerAssignedBooleanSwitchCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<u32[0 max]> caseValues,
    borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    ParsedSwitchAssignmentArm defaultArm,
    u32[0 max] targetCount,
    borrow IrTable<u32[0 max]> postLocalRoots,
    bool hasTerminalIf,
    ParsedIfReturnArms terminalIfArms,
    u32[0 max] returnRootNode,
    borrow IrTable<u32[0 max]> localTypes,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseCountWide > 2 || caseArms.Count() != caseCountWide || targetCount == 0)
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    if (localTypes.Count() < (u64[0 2 ** 63 - 1])(paramCount + targetCount))
    {
        return false;
    }

    stack mut bool hasTrue = false;
    stack mut bool hasFalse = false;
    stack mut ParsedSwitchAssignmentArm trueArm = new();
    stack mut ParsedSwitchAssignmentArm falseArm = new();
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] caseValue = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack ParsedSwitchAssignmentArm caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        if (caseValue == 1)
        {
            hasTrue = true;
            trueArm = caseArm;
        }
        else if (caseValue == 0)
        {
            hasFalse = true;
            falseArm = caseArm;
        }
        else
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    stack bool hasBoth = hasTrue && hasFalse;
    stack mut IrTable<u32[0 max]> phiTypeCodes = new();
    stack mut u64[0 2 ** 63 - 1] targetTypeIndex = 0;
    while willexit (targetTypeIndex < (u64[0 2 ** 63 - 1])targetCount)
    {
        stack u32[0 max] targetTypeCode = localTypes.Get(paramCount + (u32[0 max])targetTypeIndex + 1);
        stack mut ExprType expectedTargetType = ExprType.IntType;
        if (targetTypeCode == SourceLocalTypeCodeBool())
        {
            expectedTargetType = ExprType.BoolType;
        }
        else if (targetTypeCode == SourceLocalTypeCodePointer())
        {
            expectedTargetType = ExprType.PtrType;
        }

        if (TypeOfSwitchAssignmentArm(nodes, defaultArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, (u32[0 max])targetTypeIndex) != expectedTargetType)
        {
            return false;
        }

        if (hasTrue
            && TypeOfSwitchAssignmentArm(nodes, trueArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, (u32[0 max])targetTypeIndex) != expectedTargetType)
        {
            return false;
        }

        if (hasFalse
            && TypeOfSwitchAssignmentArm(nodes, falseArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, (u32[0 max])targetTypeIndex) != expectedTargetType)
        {
            return false;
        }

        if (phiTypeCodes.Add(targetTypeCode) == 0)
        {
            return false;
        }

        targetTypeIndex = targetTypeIndex + 1;
    }

    stack mut ExprType rootType = ExprType.IntType;
    stack mut bool terminalBothBool = false;
    if (hasTerminalIf)
    {
        if (TypeOfNodeWithLocals(nodes, terminalIfArms.Condition.NodeId, localTypes) != ExprType.BoolType)
        {
            return false;
        }

        stack ExprType thenType = TypeOfNodeWithLocals(nodes, terminalIfArms.ThenArm.NodeId, localTypes);
        stack ExprType elseType = TypeOfNodeWithLocals(nodes, terminalIfArms.ElseArm.NodeId, localTypes);
        stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
        terminalBothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
        if (!bothInt && !terminalBothBool)
        {
            return false;
        }

        rootType = thenType;
    }
    else
    {
        rootType = TypeOfNodeWithLocals(nodes, returnRootNode, localTypes);
        if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRootNode, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] firstArmBlockIndex = firstBlock + 1;
    stack u32[0 max] secondArmBlockIndex = firstBlock + 2;
    stack u32[0 max] mergeBlockIndex = firstBlock + 3;
    stack u32[0 max] terminalThenBlockIndex = mergeBlockIndex + 1;
    stack u32[0 max] terminalElseBlockIndex = terminalThenBlockIndex + 1;

    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId scrutineeValue = LowerExprNodeWithTypesAndLocals(nodes, scrutineeNode, instrs, localTypes, noOverrides);
    if (MirValueType(instrs, scrutineeValue.Index()) != MirType.I1)
    {
        return false;
    }

    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);
    stack mut IrTable<u32[0 max]> trueValues = new();
    stack mut IrTable<u32[0 max]> falseValues = new();
    stack mut IrTable<u32[0 max]> caseValuesForMerge = new();
    stack mut IrTable<u32[0 max]> defaultValues = new();
    stack mut u32[0 max] trueFirst = 0;
    stack mut u32[0 max] trueCount = 0;
    stack mut u32[0 max] falseFirst = 0;
    stack mut u32[0 max] falseCount = 0;
    stack mut u32[0 max] caseFirst = 0;
    stack mut u32[0 max] caseInstrCount = 0;
    stack mut u32[0 max] defaultFirst = 0;
    stack mut u32[0 max] defaultCount = 0;
    if (hasBoth)
    {
        trueFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchAssignmentArmValues(nodes, trueArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, trueValues)
            || trueValues.Count() != (u64[0 2 ** 63 - 1])targetCount)
        {
            return false;
        }

        trueCount = (u32[0 max])instrs.Count() - (trueFirst - 1);
        falseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchAssignmentArmValues(nodes, falseArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, falseValues)
            || falseValues.Count() != (u64[0 2 ** 63 - 1])targetCount)
        {
            return false;
        }

        falseCount = (u32[0 max])instrs.Count() - (falseFirst - 1);
    }
    else
    {
        stack mut ParsedSwitchAssignmentArm selectedArm = trueArm;
        if (hasFalse)
        {
            selectedArm = falseArm;
        }

        caseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchAssignmentArmValues(nodes, selectedArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, caseValuesForMerge)
            || caseValuesForMerge.Count() != (u64[0 2 ** 63 - 1])targetCount)
        {
            return false;
        }

        caseInstrCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
        defaultFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchAssignmentArmValues(nodes, defaultArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, defaultValues)
            || defaultValues.Count() != (u64[0 2 ** 63 - 1])targetCount)
        {
            return false;
        }

        defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);
    }

    stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> returnOverrides = new();
    stack mut u64[0 2 ** 63 - 1] p = 0;
    while willexit (p < paramCount)
    {
        if (returnOverrides.Add(0) == 0)
        {
            return false;
        }

        p = p + 1;
    }

    stack mut IrTable<u32[0 max]> finalPhis = new();
    targetTypeIndex = 0;
    while willexit (targetTypeIndex < (u64[0 2 ** 63 - 1])targetCount)
    {
        stack u32[0 max] targetTypeCode = phiTypeCodes.Get((u32[0 max])(targetTypeIndex + 1));
        stack mut MirType phiType = MirType.I64;
        stack mut MirType knownPhiType = MirType.I64;
        if (TryMirTypeForSourceLocalValueTypeCode(targetTypeCode, knownPhiType))
        {
            phiType = knownPhiType;
        }

        stack mut MirValueId phi = MirValueIdOf(0);
        if (hasBoth)
        {
            stack u32[0 max] trueValueIndex = trueValues.Get((u32[0 max])(targetTypeIndex + 1));
            stack u32[0 max] falseValueIndex = falseValues.Get((u32[0 max])(targetTypeIndex + 1));
            phi = MirPhi2Typed(
                instrs,
                phiType,
                MirValueIdOf(trueValueIndex),
                MirBlockIdOf(firstArmBlockIndex),
                MirValueIdOf(falseValueIndex),
                MirBlockIdOf(secondArmBlockIndex));
        }
        else
        {
            stack u32[0 max] caseValueIndex = caseValuesForMerge.Get((u32[0 max])(targetTypeIndex + 1));
            stack u32[0 max] defaultValueIndex = defaultValues.Get((u32[0 max])(targetTypeIndex + 1));
            phi = MirPhi2Typed(
                instrs,
                phiType,
                MirValueIdOf(caseValueIndex),
                MirBlockIdOf(firstArmBlockIndex),
                MirValueIdOf(defaultValueIndex),
                MirBlockIdOf(secondArmBlockIndex));
        }

        if (finalPhis.Add(phi.Index()) == 0 || returnOverrides.Add(phi.Index()) == 0)
        {
            return false;
        }

        targetTypeIndex = targetTypeIndex + 1;
    }

    postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack MirValueId postLocalValue = LowerExprNodeWithTypesAndLocals(nodes, postLocalRootNode, instrs, localTypes, returnOverrides);
        if (returnOverrides.Add(postLocalValue.Index()) == 0)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack u32[0 max] firstFinalPhi = finalPhis.Get(1);
    stack mut MirValueId finalReturnValue = MirValueIdOf(firstFinalPhi);
    stack mut MirValueId terminalIfCondValue = MirValueIdOf(firstFinalPhi);
    stack mut MirValueId terminalIfThenValue = MirValueIdOf(firstFinalPhi);
    stack mut MirValueId terminalIfElseValue = MirValueIdOf(firstFinalPhi);
    stack mut u32[0 max] terminalIfMergeCount = 0;
    stack mut u32[0 max] terminalIfThenFirst = 0;
    stack mut u32[0 max] terminalIfThenCount = 0;
    stack mut u32[0 max] terminalIfElseFirst = 0;
    stack mut u32[0 max] terminalIfElseCount = 0;
    if (hasTerminalIf)
    {
        terminalIfCondValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.Condition.NodeId, instrs, localTypes, returnOverrides);
        terminalIfMergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

        terminalIfThenFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfThenValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.ThenArm.NodeId, instrs, localTypes, returnOverrides);
        if (terminalBothBool)
        {
            terminalIfThenValue = MirZExt(instrs, terminalIfThenValue);
        }

        terminalIfThenCount = (u32[0 max])instrs.Count() - (terminalIfThenFirst - 1);

        terminalIfElseFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfElseValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.ElseArm.NodeId, instrs, localTypes, returnOverrides);
        if (terminalBothBool)
        {
            terminalIfElseValue = MirZExt(instrs, terminalIfElseValue);
        }

        terminalIfElseCount = (u32[0 max])instrs.Count() - (terminalIfElseFirst - 1);
    }
    else
    {
        stack mut MirValueId returnValue = LowerExprNodeWithTypesAndLocals(nodes, returnRootNode, instrs, localTypes, returnOverrides);
        if (rootType == ExprType.BoolType)
        {
            returnValue = MirZExt(instrs, returnValue);
        }

        finalReturnValue = returnValue;
    }

    stack mut u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);
    if (hasTerminalIf)
    {
        mergeCount = terminalIfMergeCount;
    }

    if (hasBoth)
    {
        stack MirBlockId entry = MirCondBlock(
            blocks,
            scrutineeValue,
            MirBlockIdOf(firstArmBlockIndex),
            MirBlockIdOf(secondArmBlockIndex));
        stack MirBlockId trueBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        stack MirBlockId falseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    }
    else
    {
        stack mut MirBlockId thenTarget = MirBlockIdOf(firstArmBlockIndex);
        stack mut MirBlockId elseTarget = MirBlockIdOf(secondArmBlockIndex);
        if (hasFalse)
        {
            thenTarget = MirBlockIdOf(secondArmBlockIndex);
            elseTarget = MirBlockIdOf(firstArmBlockIndex);
        }

        stack MirBlockId entry = MirCondBlock(blocks, scrutineeValue, thenTarget, elseTarget);
        stack MirBlockId caseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        stack MirBlockId defaultBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    }

    if (hasTerminalIf)
    {
        stack MirBlockId mergeBlock = MirCondBlock(
            blocks,
            terminalIfCondValue,
            MirBlockIdOf(terminalThenBlockIndex),
            MirBlockIdOf(terminalElseBlockIndex));
        stack MirBlockId terminalThenBlock = MirReturnBlock(blocks, terminalIfThenValue);
        stack MirBlockId terminalElseBlock = MirReturnBlock(blocks, terminalIfElseValue);
    }
    else
    {
        stack MirBlockId mergeBlock = MirReturnBlock(blocks, finalReturnValue);
    }

    if (recordRanges)
    {
        stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(firstBlock, entryFirst, entryCount));
        if (hasBoth)
        {
            stack u32[0 max] trueRange = ranges.Add(MakeBlockEmit(firstArmBlockIndex, trueFirst, trueCount));
            stack u32[0 max] falseRange = ranges.Add(MakeBlockEmit(secondArmBlockIndex, falseFirst, falseCount));
        }
        else
        {
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(firstArmBlockIndex, caseFirst, caseInstrCount));
            stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(secondArmBlockIndex, defaultFirst, defaultCount));
        }

        stack u32[0 max] mergeRange = ranges.Add(MakeBlockEmit(mergeBlockIndex, mergeFirst, mergeCount));
        if (hasTerminalIf)
        {
            stack u32[0 max] terminalThenRange = ranges.Add(MakeBlockEmit(
                terminalThenBlockIndex,
                terminalIfThenFirst,
                terminalIfThenCount));
            stack u32[0 max] terminalElseRange = ranges.Add(MakeBlockEmit(
                terminalElseBlockIndex,
                terminalIfElseFirst,
                terminalIfElseCount));
        }
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    body.CondValue = scrutineeValue.Index();
    body.ThenValue = finalPhis.Get(1);
    if (hasTerminalIf)
    {
        body.ElseValue = terminalIfCondValue.Index();
    }
    else
    {
        body.ElseValue = finalReturnValue.Index();
    }

    return true;
}

internal fn bool LowerIntegerSwitchFieldAssignmentCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<i64[min max]> caseMaxValues,
    borrow IrTable<ParsedSwitchFieldAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    ParsedSwitchFieldAssignmentArm defaultArm,
    borrow IrTable<u32[0 max]> postLocalRoots,
    bool hasTerminalIf,
    ParsedIfReturnArms terminalIfArms,
    u32[0 max] returnRootNode,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals,
    out LoweredBody body)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseMaxValues.Count() != caseCountWide || caseArms.Count() != caseCountWide)
    {
        return false;
    }

    stack ExprType scrutineeType = TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes);
    if (scrutineeType != ExprType.IntType && scrutineeType != ExprType.EnumType)
    {
        return false;
    }

    stack mut ExprType rootType = ExprType.IntType;
    stack mut bool terminalBothBool = false;
    if (hasTerminalIf)
    {
        if (TypeOfNodeWithLocals(nodes, terminalIfArms.Condition.NodeId, localTypes) != ExprType.BoolType)
        {
            return false;
        }

        stack ExprType thenType = TypeOfNodeWithLocals(nodes, terminalIfArms.ThenArm.NodeId, localTypes);
        stack ExprType elseType = TypeOfNodeWithLocals(nodes, terminalIfArms.ElseArm.NodeId, localTypes);
        stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
        terminalBothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
        if (!bothInt && !terminalBothBool)
        {
            return false;
        }

        rootType = thenType;
    }
    else
    {
        rootType = TypeOfNodeWithLocals(nodes, returnRootNode, localTypes);
        if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRootNode, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack u32[0 max] caseCount = (u32[0 max])caseCountWide;
    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] caseBlockBase = firstBlock + caseCount;
    stack u32[0 max] defaultBlockIndex = caseBlockBase + caseCount;
    stack u32[0 max] mergeBlockIndex = defaultBlockIndex + 1;
    stack u32[0 max] terminalThenBlockIndex = mergeBlockIndex + 1;
    stack u32[0 max] terminalElseBlockIndex = terminalThenBlockIndex + 1;

    stack mut IrTable<u32[0 max]> testFirsts = new();
    stack mut IrTable<u32[0 max]> testCounts = new();
    stack mut IrTable<u32[0 max]> conditionValues = new();
    stack mut IrTable<u32[0 max]> caseFirsts = new();
    stack mut IrTable<u32[0 max]> caseCounts = new();

    stack MirValueId scrutineeValue = LowerExprNodeWithCallContext(nodes, scrutineeNode, instrs, localTypes, baseLocalOverrides, functionCallContractFacts, sliceArgumentLocals);
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack mut u32[0 max] testFirst = (u32[0 max])instrs.Count() + 1;
        if (caseIndex == 0)
        {
            testFirst = entryFirst;
        }

        stack i64[min max] caseMin = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack i64[min max] caseMax = caseMaxValues.Get((u32[0 max])(caseIndex + 1));
        stack MirValueId condition = LowerIntegerSwitchCaseCondition(instrs, scrutineeValue, caseMin, caseMax);
        stack u32[0 max] testCount = (u32[0 max])instrs.Count() - (testFirst - 1);
        if (testFirsts.Add(testFirst) == 0
            || testCounts.Add(testCount) == 0
            || conditionValues.Add(condition.Index()) == 0)
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack ParsedSwitchFieldAssignmentArm caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        stack u32[0 max] caseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, caseArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        stack u32[0 max] caseInstrCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
        if (caseFirsts.Add(caseFirst) == 0
            || caseCounts.Add(caseInstrCount) == 0)
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    stack u32[0 max] defaultFirst = (u32[0 max])instrs.Count() + 1;
    if (!LowerSwitchFieldAssignmentArmStores(nodes, defaultArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
    {
        return false;
    }

    stack u32[0 max] defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);

    stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> returnOverrides = new();
    stack mut u64[0 2 ** 63 - 1] overrideIndex = 0;
    while willexit (overrideIndex < baseLocalOverrides.Count())
    {
        stack u32[0 max] overrideValue = baseLocalOverrides.Get((u32[0 max])(overrideIndex + 1));
        if (returnOverrides.Add(overrideValue) == 0)
        {
            return false;
        }

        overrideIndex = overrideIndex + 1;
    }

    postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack MirValueId postLocalValue = LowerExprNodeWithCallContext(nodes, postLocalRootNode, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (returnOverrides.Add(postLocalValue.Index()) == 0)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack mut MirValueId finalReturnValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfCondValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfThenValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfElseValue = MirValueIdOf(0);
    stack mut u32[0 max] terminalIfMergeCount = 0;
    stack mut u32[0 max] terminalIfThenFirst = 0;
    stack mut u32[0 max] terminalIfThenCount = 0;
    stack mut u32[0 max] terminalIfElseFirst = 0;
    stack mut u32[0 max] terminalIfElseCount = 0;
    if (hasTerminalIf)
    {
        terminalIfCondValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.Condition.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        terminalIfMergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

        terminalIfThenFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfThenValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.ThenArm.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (terminalBothBool)
        {
            terminalIfThenValue = MirZExt(instrs, terminalIfThenValue);
        }

        terminalIfThenCount = (u32[0 max])instrs.Count() - (terminalIfThenFirst - 1);

        terminalIfElseFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfElseValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.ElseArm.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (terminalBothBool)
        {
            terminalIfElseValue = MirZExt(instrs, terminalIfElseValue);
        }

        terminalIfElseCount = (u32[0 max])instrs.Count() - (terminalIfElseFirst - 1);
    }
    else
    {
        stack mut MirValueId returnValue = LowerExprNodeWithCallContext(nodes, returnRootNode, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (rootType == ExprType.BoolType)
        {
            returnValue = MirZExt(instrs, returnValue);
        }

        finalReturnValue = returnValue;
    }

    stack mut u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);
    if (hasTerminalIf)
    {
        mergeCount = terminalIfMergeCount;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] currentBlock = firstBlock + (u32[0 max])caseIndex;
        stack u32[0 max] thenBlock = caseBlockBase + (u32[0 max])caseIndex;
        stack mut u32[0 max] elseBlock = defaultBlockIndex;
        if (caseIndex + 1 < caseCountWide)
        {
            elseBlock = currentBlock + 1;
        }

        stack u32[0 max] conditionValue = conditionValues.Get((u32[0 max])(caseIndex + 1));
        stack MirBlockId testBlock = MirCondBlock(
            blocks,
            MirValueIdOf(conditionValue),
            MirBlockIdOf(thenBlock),
            MirBlockIdOf(elseBlock));
        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack MirBlockId caseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        caseIndex = caseIndex + 1;
    }

    stack MirBlockId defaultBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    if (hasTerminalIf)
    {
        stack MirBlockId mergeBlock = MirCondBlock(
            blocks,
            terminalIfCondValue,
            MirBlockIdOf(terminalThenBlockIndex),
            MirBlockIdOf(terminalElseBlockIndex));
        stack MirBlockId terminalThenBlock = MirReturnBlock(blocks, terminalIfThenValue);
        stack MirBlockId terminalElseBlock = MirReturnBlock(blocks, terminalIfElseValue);
    }
    else
    {
        stack MirBlockId mergeBlock = MirReturnBlock(blocks, finalReturnValue);
    }

    if (recordRanges)
    {
        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] testFirst = testFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testCount = testCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testRange = ranges.Add(MakeBlockEmit(
                firstBlock + (u32[0 max])caseIndex,
                testFirst,
                testCount));
            caseIndex = caseIndex + 1;
        }

        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] caseFirst = caseFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRangeCount = caseCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(
                caseBlockBase + (u32[0 max])caseIndex,
                caseFirst,
                caseRangeCount));
            caseIndex = caseIndex + 1;
        }

        stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(defaultBlockIndex, defaultFirst, defaultCount));
        stack u32[0 max] mergeRange = ranges.Add(MakeBlockEmit(mergeBlockIndex, mergeFirst, mergeCount));
        if (hasTerminalIf)
        {
            stack u32[0 max] terminalThenRange = ranges.Add(MakeBlockEmit(
                terminalThenBlockIndex,
                terminalIfThenFirst,
                terminalIfThenCount));
            stack u32[0 max] terminalElseRange = ranges.Add(MakeBlockEmit(
                terminalElseBlockIndex,
                terminalIfElseFirst,
                terminalIfElseCount));
        }
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    stack u32[0 max] firstConditionValue = conditionValues.Get(1);
    body.CondValue = firstConditionValue;
    body.ThenValue = finalReturnValue.Index();
    if (hasTerminalIf)
    {
        body.ElseValue = terminalIfCondValue.Index();
    }
    else
    {
        body.ElseValue = finalReturnValue.Index();
    }

    return true;
}

internal fn bool LowerBooleanSwitchFieldAssignmentCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<u32[0 max]> caseValues,
    borrow IrTable<ParsedSwitchFieldAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    ParsedSwitchFieldAssignmentArm defaultArm,
    borrow IrTable<u32[0 max]> postLocalRoots,
    bool hasTerminalIf,
    ParsedIfReturnArms terminalIfArms,
    u32[0 max] returnRootNode,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals,
    out LoweredBody body)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseCountWide > 2 || caseArms.Count() != caseCountWide)
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack mut bool hasTrue = false;
    stack mut bool hasFalse = false;
    stack mut ParsedSwitchFieldAssignmentArm trueArm = new();
    stack mut ParsedSwitchFieldAssignmentArm falseArm = new();
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] caseValue = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack ParsedSwitchFieldAssignmentArm caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        if (caseValue == 1)
        {
            hasTrue = true;
            trueArm = caseArm;
        }
        else if (caseValue == 0)
        {
            hasFalse = true;
            falseArm = caseArm;
        }
        else
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    stack bool hasBoth = hasTrue && hasFalse;
    stack mut ExprType rootType = ExprType.IntType;
    stack mut bool terminalBothBool = false;
    if (hasTerminalIf)
    {
        if (TypeOfNodeWithLocals(nodes, terminalIfArms.Condition.NodeId, localTypes) != ExprType.BoolType)
        {
            return false;
        }

        stack ExprType thenType = TypeOfNodeWithLocals(nodes, terminalIfArms.ThenArm.NodeId, localTypes);
        stack ExprType elseType = TypeOfNodeWithLocals(nodes, terminalIfArms.ElseArm.NodeId, localTypes);
        stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
        terminalBothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
        if (!bothInt && !terminalBothBool)
        {
            return false;
        }

        rootType = thenType;
    }
    else
    {
        rootType = TypeOfNodeWithLocals(nodes, returnRootNode, localTypes);
        if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRootNode, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] firstArmBlockIndex = firstBlock + 1;
    stack u32[0 max] secondArmBlockIndex = firstBlock + 2;
    stack u32[0 max] mergeBlockIndex = firstBlock + 3;
    stack u32[0 max] terminalThenBlockIndex = mergeBlockIndex + 1;
    stack u32[0 max] terminalElseBlockIndex = terminalThenBlockIndex + 1;

    stack MirValueId scrutineeValue = LowerExprNodeWithCallContext(nodes, scrutineeNode, instrs, localTypes, baseLocalOverrides, functionCallContractFacts, sliceArgumentLocals);
    if (MirValueType(instrs, scrutineeValue.Index()) != MirType.I1)
    {
        return false;
    }

    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);
    stack mut u32[0 max] trueFirst = 0;
    stack mut u32[0 max] trueCount = 0;
    stack mut u32[0 max] falseFirst = 0;
    stack mut u32[0 max] falseCount = 0;
    stack mut u32[0 max] caseFirst = 0;
    stack mut u32[0 max] caseInstrCount = 0;
    stack mut u32[0 max] defaultFirst = 0;
    stack mut u32[0 max] defaultCount = 0;
    if (hasBoth)
    {
        trueFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, trueArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        trueCount = (u32[0 max])instrs.Count() - (trueFirst - 1);
        falseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, falseArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        falseCount = (u32[0 max])instrs.Count() - (falseFirst - 1);
    }
    else
    {
        stack mut ParsedSwitchFieldAssignmentArm selectedArm = trueArm;
        if (hasFalse)
        {
            selectedArm = falseArm;
        }

        caseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, selectedArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        caseInstrCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
        defaultFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, defaultArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);
    }

    stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> returnOverrides = new();
    stack mut u64[0 2 ** 63 - 1] overrideIndex = 0;
    while willexit (overrideIndex < baseLocalOverrides.Count())
    {
        stack u32[0 max] overrideValue = baseLocalOverrides.Get((u32[0 max])(overrideIndex + 1));
        if (returnOverrides.Add(overrideValue) == 0)
        {
            return false;
        }

        overrideIndex = overrideIndex + 1;
    }

    postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack MirValueId postLocalValue = LowerExprNodeWithCallContext(nodes, postLocalRootNode, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (returnOverrides.Add(postLocalValue.Index()) == 0)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack mut MirValueId finalReturnValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfCondValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfThenValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfElseValue = MirValueIdOf(0);
    stack mut u32[0 max] terminalIfMergeCount = 0;
    stack mut u32[0 max] terminalIfThenFirst = 0;
    stack mut u32[0 max] terminalIfThenCount = 0;
    stack mut u32[0 max] terminalIfElseFirst = 0;
    stack mut u32[0 max] terminalIfElseCount = 0;
    if (hasTerminalIf)
    {
        terminalIfCondValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.Condition.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        terminalIfMergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

        terminalIfThenFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfThenValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.ThenArm.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (terminalBothBool)
        {
            terminalIfThenValue = MirZExt(instrs, terminalIfThenValue);
        }

        terminalIfThenCount = (u32[0 max])instrs.Count() - (terminalIfThenFirst - 1);

        terminalIfElseFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfElseValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.ElseArm.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (terminalBothBool)
        {
            terminalIfElseValue = MirZExt(instrs, terminalIfElseValue);
        }

        terminalIfElseCount = (u32[0 max])instrs.Count() - (terminalIfElseFirst - 1);
    }
    else
    {
        stack mut MirValueId returnValue = LowerExprNodeWithCallContext(nodes, returnRootNode, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (rootType == ExprType.BoolType)
        {
            returnValue = MirZExt(instrs, returnValue);
        }

        finalReturnValue = returnValue;
    }

    stack mut u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);
    if (hasTerminalIf)
    {
        mergeCount = terminalIfMergeCount;
    }

    if (hasBoth)
    {
        stack MirBlockId entry = MirCondBlock(
            blocks,
            scrutineeValue,
            MirBlockIdOf(firstArmBlockIndex),
            MirBlockIdOf(secondArmBlockIndex));
        stack MirBlockId trueBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        stack MirBlockId falseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    }
    else
    {
        stack mut MirBlockId thenTarget = MirBlockIdOf(firstArmBlockIndex);
        stack mut MirBlockId elseTarget = MirBlockIdOf(secondArmBlockIndex);
        if (hasFalse)
        {
            thenTarget = MirBlockIdOf(secondArmBlockIndex);
            elseTarget = MirBlockIdOf(firstArmBlockIndex);
        }

        stack MirBlockId entry = MirCondBlock(blocks, scrutineeValue, thenTarget, elseTarget);
        stack MirBlockId caseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        stack MirBlockId defaultBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    }

    if (hasTerminalIf)
    {
        stack MirBlockId mergeBlock = MirCondBlock(
            blocks,
            terminalIfCondValue,
            MirBlockIdOf(terminalThenBlockIndex),
            MirBlockIdOf(terminalElseBlockIndex));
        stack MirBlockId terminalThenBlock = MirReturnBlock(blocks, terminalIfThenValue);
        stack MirBlockId terminalElseBlock = MirReturnBlock(blocks, terminalIfElseValue);
    }
    else
    {
        stack MirBlockId mergeBlock = MirReturnBlock(blocks, finalReturnValue);
    }

    if (recordRanges)
    {
        stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(firstBlock, entryFirst, entryCount));
        if (hasBoth)
        {
            stack u32[0 max] trueRange = ranges.Add(MakeBlockEmit(firstArmBlockIndex, trueFirst, trueCount));
            stack u32[0 max] falseRange = ranges.Add(MakeBlockEmit(secondArmBlockIndex, falseFirst, falseCount));
        }
        else
        {
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(firstArmBlockIndex, caseFirst, caseInstrCount));
            stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(secondArmBlockIndex, defaultFirst, defaultCount));
        }

        stack u32[0 max] mergeRange = ranges.Add(MakeBlockEmit(mergeBlockIndex, mergeFirst, mergeCount));
        if (hasTerminalIf)
        {
            stack u32[0 max] terminalThenRange = ranges.Add(MakeBlockEmit(
                terminalThenBlockIndex,
                terminalIfThenFirst,
                terminalIfThenCount));
            stack u32[0 max] terminalElseRange = ranges.Add(MakeBlockEmit(
                terminalElseBlockIndex,
                terminalIfElseFirst,
                terminalIfElseCount));
        }
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    body.CondValue = scrutineeValue.Index();
    body.ThenValue = finalReturnValue.Index();
    if (hasTerminalIf)
    {
        body.ElseValue = terminalIfCondValue.Index();
    }
    else
    {
        body.ElseValue = finalReturnValue.Index();
    }

    return true;
}

internal fn bool FunctionBodyStartsWithConstructedObjectSwitchFieldAssignment(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut bool sawStorageBackedLocal = false;
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    while willexit (cursor < limit && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(cursor);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
        stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
        stack mut u32[0 max] bodyOpen = 0;
        stack mut u32[0 max] bodyClose = 0;
        stack mut u32[0 max] argsOpen = 0;
        stack mut u32[0 max] argsClose = 0;
        if (localStorage == TokenKind.Stack
            && typeToken != 0)
        {
            stack mut MirType scalarProbeType = MirType.I64;
            if (MirTypeForKnownSourceScalarType(stream, source, typeToken, scalarProbeType))
            {
                sawStorageBackedLocal = hasAssign || SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
            }
            else if (hasAssign)
            {
                sawStorageBackedLocal = true;
            }
        }

        if ((localStorage == TokenKind.Stack || localStorage == TokenKind.Heap)
            && hasAssign
            && typeToken != 0
            && (TryParseTargetTypedObjectConstructorShape(stream, source, typeToken, assignToken, statementEnd, bodyOpen, bodyClose)
                || TryParseTargetTypedPositionalRecordConstructorShape(stream, source, typeToken, assignToken, statementEnd, argsOpen, argsClose)))
        {
            sawStorageBackedLocal = true;
        }

        cursor = statementEnd + 1;
    }

    if (cursor >= limit || stream.KindAt(cursor) != TokenKind.Switch)
    {
        return false;
    }

    if (stream.KindAt(cursor + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] closeParen = MatchingBracketForMirLowering(stream, (u32[0 max])(cursor + 1));
    if (closeParen == (u32[0 max])(cursor + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] firstCase = (u64[0 2 ** 63 - 1])closeParen + 2;
    if (stream.KindAt(firstCase) != TokenKind.Case)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterLabel = firstCase + 1;
    while willexit (afterLabel < limit && stream.KindAt(afterLabel) != TokenKind.Colon)
    {
        afterLabel = afterLabel + 1;
    }

    if (afterLabel >= limit || stream.KindAt(afterLabel) != TokenKind.Colon)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] armStart = afterLabel + 1;
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] armCursor = armStart + 1;
        while willexit (armCursor < (u64[0 2 ** 63 - 1])closeBrace && stream.KindAt(armCursor) == TokenKind.Var)
        {
            stack mut u64[0 2 ** 63 - 1] localEnd = armCursor;
            if (!FindSelfHostedStatementEnd(stream, armCursor, (u64[0 2 ** 63 - 1])closeBrace, localEnd))
            {
                return false;
            }

            armCursor = localEnd + 1;
        }

        return armCursor < (u64[0 2 ** 63 - 1])closeBrace
            && (StatementStartsRawPointerDerefAssignment(stream, armCursor, (u64[0 2 ** 63 - 1])closeBrace)
                || (sawStorageBackedLocal
                    && (StatementStartsConstructedObjectFieldAssignment(stream, armCursor, (u64[0 2 ** 63 - 1])closeBrace)
                        || StatementStartsScalarStorageAssignment(stream, armCursor, (u64[0 2 ** 63 - 1])closeBrace)
                        || StatementStartsSourceSliceElementAssignment(stream, armCursor, (u64[0 2 ** 63 - 1])closeBrace))));
    }

    return StatementStartsRawPointerDerefAssignment(stream, armStart, limit)
        || (sawStorageBackedLocal
            && (StatementStartsConstructedObjectFieldAssignment(stream, armStart, limit)
                || StatementStartsScalarStorageAssignment(stream, armStart, limit)
                || StatementStartsSourceSliceElementAssignment(stream, armStart, limit)));
}

internal fn bool LowerModuleConstructedObjectSwitchFieldAssignmentFunctionToBlocks(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithConstructedObjectSwitchFieldAssignment(stream, source, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localRoots = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut IrTable<StackObjectFieldInitializer> stackObjectFieldInitializers = new();
    stack mut IrTable<FixedArrayStorageLocal> fixedArrayStorageLocals = new();
    stack mut IrTable<FixedArrayStorageInitializer> fixedArrayStorageInitializers = new();
    stack mut IrTable<ScalarStorageLocal> scalarStorageLocals = new();
    stack mut IrTable<ScalarStorageInitializer> scalarStorageInitializers = new();
    stack mut IrTable<ScalarStorageAssignment> scalarAssignments = new();
    stack mut IrTable<EnumStorageLocal> enumStorageLocals = new();
    stack mut IrTable<EnumStorageInitializer> enumStorageInitializers = new();
    stack mut IrTable<EnumStorageAssignment> enumAssignments = new();
    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    stack mut IrTable<SourceStorageMutationStatement> storageMutationStatements = new();
    stack mut IrTable<u32[0 max]> localOverrideValues = new();
    stack mut DeclarationList declarations = new();
    stack mut TypedEnumLayoutTable enumLayouts = new();
    if (AsciiLength(sourceText) == 0 || !TryParseMirSourceDeclarations(stream, declarations))
    {
        return false;
    }

    switch (BuildTypedEnumLayouts(sourceText, stream, declarations))
    {
        case ParseResult<TypedEnumLayoutTable>.Err(var layoutError):
            return false;
        case ParseResult<TypedEnumLayoutTable>.Ok(var builtLayouts):
            enumLayouts = builtLayouts;
    }

    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, declarations, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    while willexit (cursor < limit && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, statementEnd);
        if (localNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(cursor);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
        if (localStorage == TokenKind.Var)
        {
            if (!hasAssign)
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
            stack ExprParseResult varExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, assignToken + 1);
            if (varExpr.Next != statementEnd || params.Count() != beforeInit)
            {
                return false;
            }

            stack ExprType varType = TypeOfNodeWithLocals(nodes, varExpr.NodeId, localTypes);
            stack mut bool rawPointerAliasMutable = false;
            stack mut u32[0 max] rawPointerAliasFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
            stack mut u32[0 max] rawPointerAliasElementSize = 0;
            stack mut u32[0 max] rawPointerAliasElementAlignment = 0;
            stack mut bool rawPointerAliasHasElementCount = false;
            stack mut bool rawPointerAliasElementCountIsParam = false;
            stack mut u32[0 max] rawPointerAliasElementCountLiteral = 0;
            stack mut u32[0 max] rawPointerAliasElementCountParamIndex = 0;
            stack bool rawPointerAlias = varType == ExprType.PtrType
                && TryGetRawPointerFactsForNode(
                    nodes,
                    params,
                    varExpr.NodeId,
                    rawPointerAliasMutable,
                    rawPointerAliasFieldTypeCode,
                    rawPointerAliasElementSize,
                    rawPointerAliasElementAlignment);
            if (varType == ExprType.ErrorType || (varType == ExprType.PtrType && !rawPointerAlias))
            {
                return false;
            }

            stack mut u32[0 max] localIndex = 0;
            if (rawPointerAlias)
            {
                if (!TryGetRawPointerElementCountFactsForNameNode(
                    nodes,
                    params,
                    varExpr.NodeId,
                    rawPointerAliasHasElementCount,
                    rawPointerAliasElementCountIsParam,
                    rawPointerAliasElementCountLiteral,
                    rawPointerAliasElementCountParamIndex))
                {
                    rawPointerAliasHasElementCount = false;
                }

                localIndex = ResolveParamWithRawPointerElementAndCountFacts(
                    params,
                    source,
                    nameStart,
                    nameLength,
                    rawPointerAliasMutable,
                    rawPointerAliasFieldTypeCode,
                    rawPointerAliasElementSize,
                    rawPointerAliasElementAlignment,
                    rawPointerAliasHasElementCount,
                    rawPointerAliasElementCountIsParam,
                    rawPointerAliasElementCountLiteral,
                    rawPointerAliasElementCountParamIndex);
            }
            else
            {
                localIndex = ResolveParam(params, source, nameStart, nameLength);
            }

            if (localRoots.Add(varExpr.NodeId) == 0 || localOverrideValues.Add(0) == 0)
            {
                return false;
            }

            stack mut ValueFacts localFacts = new();
            if (!TryBuildSourceValueFactsForNode(nodes, varExpr.NodeId, sourceValueFacts, localFacts)
                && varType == ExprType.BoolType)
            {
                localFacts.SetIntegerRange(0, 2);
            }

            if (localTypes.Add(SourceLocalTypeCodeForNodeWithLocals(nodes, varExpr.NodeId, localTypes)) == 0
                || sourceValueFacts.Add(localFacts) == 0)
            {
                return false;
            }

            cursor = statementEnd + 1;
            continue;
        }

        stack u32[0 max] scalarTypeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
        if (localStorage == TokenKind.Stack
            && hasAssign
            && scalarTypeToken != 0
            && TryReadSliceSuffix(stream, scalarTypeToken))
        {
            stack mut SourceSliceDescriptorLocal sliceDescriptor = new();
            stack mut bool resolvedSliceDescriptor = TryResolveSliceDescriptorFromConstructedObjectFixedArray(
                stream,
                source,
                declarations,
                enumLayouts,
                constructedObjectLocals,
                scalarTypeToken,
                assignToken + 1,
                statementEnd,
                sliceDescriptor);
            if (!resolvedSliceDescriptor)
            {
                resolvedSliceDescriptor = TryResolveSliceDescriptorFromFixedArrayStorageLocal(
                    stream,
                    source,
                    fixedArrayStorageLocals,
                    scalarTypeToken,
                    assignToken + 1,
                    statementEnd,
                    sliceDescriptor);
            }

            if (!resolvedSliceDescriptor)
            {
                resolvedSliceDescriptor = TryResolveSliceDescriptorFromSourceSliceDescriptorLocal(
                    stream,
                    source,
                    sliceDescriptorLocals,
                    scalarTypeToken,
                    assignToken + 1,
                    statementEnd,
                    sliceDescriptor);
            }

            if (!resolvedSliceDescriptor)
            {
                return false;
            }

            stack u32[0 max] sliceLocalIndex = ResolveParam(params, source, nameStart, nameLength);
            stack u32[0 max] sliceLocalRoot = localRoots.Add(0);
            stack u32[0 max] sliceLocalType = localTypes.Add(SourceLocalTypeCodeNonValue());
            stack u32[0 max] sliceOverrideValue = localOverrideValues.Add(0);
            if (sliceLocalRoot == 0
                || sliceLocalType == 0
                || sliceOverrideValue == 0
                || sourceValueFacts.Add(new ValueFacts()) == 0)
            {
                return false;
            }

            sliceDescriptor.Start = nameStart;
            sliceDescriptor.Length = nameLength;
            sliceDescriptor.Mutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
            sliceDescriptor.ParamIndex = sliceLocalIndex;
            if (sliceDescriptorLocals.Add(sliceDescriptor) == 0)
            {
                return false;
            }

            cursor = statementEnd + 1;
            continue;
        }

        stack mut u32[0 max] fixedArrayLength = 0;
        if (localStorage == TokenKind.Stack
            && scalarTypeToken != 0
            && TryReadFixedArrayLengthSuffix(stream, source, scalarTypeToken, fixedArrayLength))
        {
            stack mut MirType elementType = MirType.I64;
            if (!MirTypeForKnownSourceScalarTypeHead(stream, source, scalarTypeToken, elementType))
            {
                return false;
            }

            stack u32[0 max] elementSize = ScalarTypeKnownByteExtent(stream, source, scalarTypeToken);
            stack u32[0 max] elementAlignment = NaturalAlignmentForByteExtent(elementSize);
            stack u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
            stack u32[0 max] arrayAllocationSize = TypeKnownByteExtentForLocal(stream, source, scalarTypeToken);
            stack u32[0 max] arrayAllocationAlign = TypeKnownByteAlignment(stream, source, scalarTypeToken);
            if (fixedArrayLength == 0
                || elementSize == 0
                || elementAlignment == 0
                || fieldTypeCode == SourceResolvedFieldTypeCodeInvalid()
                || arrayAllocationSize == 0
                || arrayAllocationAlign == 0)
            {
                return false;
            }

            stack mut IrTable<u32[0 max]> initializerRoots = new();
            if (hasAssign)
            {
                if (stream.KindAt(assignToken + 1) != TokenKind.LBrace)
                {
                    return false;
                }

                stack u32[0 max] initializerClose = MatchingBraceForMirLowering(stream, (u32[0 max])(assignToken + 1));
                if (initializerClose == (u32[0 max])(assignToken + 1)
                    || (u64[0 2 ** 63 - 1])initializerClose + 1 != statementEnd)
                {
                    return false;
                }

                stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
                if (!TryParseFixedArrayStorageInitializerRoots(
                    stream,
                    source,
                    nodes,
                    params,
                    funcNames,
                    constructedObjectLocals,
                    sliceDescriptorLocals,
                    localTypes,
                    sourceValueFacts,
                    declarations,
                    enumLayouts,
                    fixedArrayLength,
                    fieldTypeCode,
                    assignToken + 1,
                    (u64[0 2 ** 63 - 1])initializerClose,
                    initializerRoots)
                    || params.Count() != beforeInit)
                {
                    return false;
                }
            }
            else if (!SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd))
            {
                return false;
            }

            stack MirValueId arrayStorage = MirStackAlloc(instrs, arrayAllocationSize, arrayAllocationAlign);
            stack u32[0 max] arrayLocalIndex = ResolveParam(params, source, nameStart, nameLength);
            stack u32[0 max] arrayLocalOrdinal = localRoots.Add(0);
            stack u32[0 max] arrayLocalType = localTypes.Add(SourceLocalTypeCodeNonValue());
            stack u32[0 max] arrayOverrideValue = localOverrideValues.Add(arrayStorage.Index());
            if (arrayLocalOrdinal == 0
                || arrayLocalType == 0
                || arrayOverrideValue == 0
                || sourceValueFacts.Add(new ValueFacts()) == 0)
            {
                return false;
            }

            stack mut FixedArrayStorageLocal fixedArrayLocal = new();
            fixedArrayLocal.Start = nameStart;
            fixedArrayLocal.Length = nameLength;
            fixedArrayLocal.Mutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
            fixedArrayLocal.ParamIndex = arrayLocalIndex;
            fixedArrayLocal.StorageValue = arrayStorage.Index();
            fixedArrayLocal.ElementSize = elementSize;
            fixedArrayLocal.Alignment = elementAlignment;
            fixedArrayLocal.ArrayLength = fixedArrayLength;
            fixedArrayLocal.ElementType = elementType;
            fixedArrayLocal.FieldTypeCode = fieldTypeCode;
            if (fixedArrayStorageLocals.Add(fixedArrayLocal) == 0)
            {
                return false;
            }

            stack SourceSliceDescriptorLocal fixedArrayDescriptor = SourceSliceDescriptorFromFixedArrayStorageLocal(fixedArrayLocal);
            if (sliceDescriptorLocals.Add(fixedArrayDescriptor) == 0)
            {
                return false;
            }

            if (hasAssign)
            {
                stack mut u32[0 max] elementIndex = 0;
                while willexit (elementIndex < fixedArrayLength)
                {
                    stack mut FixedArrayStorageInitializer initializer = new();
                    initializer.LocalOrdinal = arrayLocalOrdinal;
                    initializer.ParamIndex = arrayLocalIndex;
                    initializer.ElementIndex = elementIndex;
                    initializer.ElementSize = elementSize;
                    initializer.Alignment = elementAlignment;
                    initializer.ElementType = elementType;
                    if (initializerRoots.Contains(elementIndex + 1))
                    {
                        initializer.ExprRoot = initializerRoots.Get(elementIndex + 1);
                    }

                    if (fixedArrayStorageInitializers.Add(initializer) == 0)
                    {
                        return false;
                    }

                    elementIndex = elementIndex + 1;
                }
            }

            cursor = statementEnd + 1;
            continue;
        }

        if (localStorage == TokenKind.Stack
            && hasAssign
            && scalarTypeToken != 0
            && TryDeclareInitializedRawPointerStorageLocal(
                stream,
                source,
                nodes,
                params,
                funcNames,
                constructedObjectLocals,
                sliceDescriptorLocals,
                localTypes,
                localRoots,
                localOverrideValues,
                sourceValueFacts,
                declarations,
                enumLayouts,
                cursor,
                statementEnd,
                nameStart,
                nameLength,
                scalarTypeToken,
                assignToken + 1,
                instrs,
                scalarStorageLocals,
                scalarStorageInitializers))
        {
            cursor = statementEnd + 1;
            continue;
        }

        stack mut MirType scalarFieldType = MirType.I64;
        if (localStorage == TokenKind.Stack
            && hasAssign
            && scalarTypeToken != 0
            && MirTypeForKnownSourceScalarType(stream, source, scalarTypeToken, scalarFieldType))
        {
            stack u32[0 max] scalarAllocationSize = TypeKnownByteExtentForLocal(stream, source, scalarTypeToken);
            stack u32[0 max] scalarAllocationAlign = TypeKnownByteAlignment(stream, source, scalarTypeToken);
            stack u32[0 max] scalarLocalTypeCode = SourceLocalStoredScalarTypeCodeForMirType(scalarFieldType);
            if (scalarAllocationSize == 0
                || scalarAllocationAlign == 0
                || !SourceLocalTypeCodeIsStoredScalar(scalarLocalTypeCode))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
            stack ExprParseResult scalarExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, assignToken + 1);
            if (params.Count() != beforeInit || scalarExpr.NodeId == 0 || scalarExpr.Next != statementEnd)
            {
                return false;
            }

            stack ExprType scalarExprType = TypeOfNodeWithLocals(nodes, scalarExpr.NodeId, localTypes);
            if (!FieldInitializerTypeMatches(scalarFieldType, scalarExprType))
            {
                return false;
            }

            stack MirValueId scalarStorage = MirStackAlloc(instrs, scalarAllocationSize, scalarAllocationAlign);
            stack bool scalarMutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
            stack u32[0 max] scalarLocalIndex = ResolveParam(params, source, nameStart, nameLength);
            stack u32[0 max] scalarLocalOrdinal = localRoots.Add(0);
            if (scalarLocalOrdinal == 0
                || localTypes.Add(scalarLocalTypeCode) == 0
                || localOverrideValues.Add(scalarStorage.Index()) == 0)
            {
                return false;
            }

            stack mut ValueFacts scalarFacts = new();
            if (!scalarMutable)
            {
                stack mut ValueFacts parsedFacts = new();
                if (TryBuildSourceValueFactsForNode(nodes, scalarExpr.NodeId, sourceValueFacts, parsedFacts))
                {
                    scalarFacts = parsedFacts;
                }
            }

            if (sourceValueFacts.Add(scalarFacts) == 0)
            {
                return false;
            }

            stack mut ScalarStorageLocal scalarLocal = new();
            scalarLocal.Start = nameStart;
            scalarLocal.Length = nameLength;
            scalarLocal.ParamIndex = scalarLocalIndex;
            scalarLocal.StorageValue = scalarStorage.Index();
            scalarLocal.FieldAlignment = scalarAllocationAlign;
            scalarLocal.FieldType = scalarFieldType;
            scalarLocal.Mutable = scalarMutable;
            if (scalarStorageLocals.Add(scalarLocal) == 0)
            {
                return false;
            }

            stack mut ScalarStorageInitializer scalarInitializer = new();
            scalarInitializer.LocalOrdinal = scalarLocalOrdinal;
            scalarInitializer.ParamIndex = scalarLocalIndex;
            scalarInitializer.FieldAlignment = scalarAllocationAlign;
            scalarInitializer.FieldType = scalarFieldType;
            scalarInitializer.ExprRoot = scalarExpr.NodeId;
            if (scalarStorageInitializers.Add(scalarInitializer) == 0)
            {
                return false;
            }

            cursor = statementEnd + 1;
            continue;
        }

        if (localStorage == TokenKind.Stack
            && !hasAssign
            && scalarTypeToken != 0
            && TryDeclareUninitializedRawPointerStorageLocal(
                stream,
                source,
                cursor,
                statementEnd,
                nameStart,
                nameLength,
                scalarTypeToken,
                params,
                instrs,
                localRoots,
                localTypes,
                localOverrideValues,
                sourceValueFacts,
                scalarStorageLocals))
        {
            cursor = statementEnd + 1;
            continue;
        }

        if (localStorage == TokenKind.Stack
            && !hasAssign
            && scalarTypeToken != 0
            && MirTypeForKnownSourceScalarType(stream, source, scalarTypeToken, scalarFieldType))
        {
            if (!TryDeclareUninitializedScalarStorageLocal(
                stream,
                source,
                cursor,
                statementEnd,
                nameStart,
                nameLength,
                scalarTypeToken,
                scalarFieldType,
                params,
                instrs,
                localRoots,
                localTypes,
                localOverrideValues,
                sourceValueFacts,
                scalarStorageLocals))
            {
                return false;
            }

            cursor = statementEnd + 1;
            continue;
        }

        stack mut u32[0 max] enumOwnerDeclarationIndex = 0;
        stack mut Compiler.Parsing.DeclItem enumItem = new();
        if (localStorage == TokenKind.Stack
            && hasAssign
            && scalarTypeToken != 0
            && TryGetSourceEnumOwnerDeclarationForToken(stream, source, declarations, scalarTypeToken, enumOwnerDeclarationIndex, enumItem))
        {
            stack mut u32[0 max] enumAllocationSize = 0;
            stack mut u32[0 max] enumAllocationAlign = 1;
            if (!TryGetSourceEnumStorageLayout(enumLayouts, enumOwnerDeclarationIndex, enumAllocationSize, enumAllocationAlign))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
            stack ExprParseResult enumExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, assignToken + 1);
            if (params.Count() != beforeInit || enumExpr.NodeId == 0 || enumExpr.Next != statementEnd)
            {
                return false;
            }

            stack mut u32[0 max] enumExprOwnerTypeIndex = 0;
            stack u32[0 max] enumOwnerTypeIndex = enumOwnerDeclarationIndex + 1;
            if (TypeOfNodeWithLocals(nodes, enumExpr.NodeId, localTypes) != ExprType.EnumType
                || !TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, enumExpr.NodeId, localTypes, enumExprOwnerTypeIndex)
                || enumExprOwnerTypeIndex != enumOwnerTypeIndex)
            {
                return false;
            }

            stack MirValueId enumStorage = MirStackAlloc(instrs, enumAllocationSize, enumAllocationAlign);
            stack bool enumMutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
            stack u32[0 max] enumLocalIndex = ResolveParam(params, source, nameStart, nameLength);
            stack u32[0 max] enumLocalOrdinal = localRoots.Add(0);
            if (enumLocalOrdinal == 0
                || localTypes.Add(SourceLocalTypeCodeForStoredEnumOwnerDeclarationIndex(enumOwnerDeclarationIndex)) == 0
                || localOverrideValues.Add(enumStorage.Index()) == 0
                || sourceValueFacts.Add(new ValueFacts()) == 0)
            {
                return false;
            }

            stack mut EnumStorageLocal enumLocal = new();
            enumLocal.Start = nameStart;
            enumLocal.Length = nameLength;
            enumLocal.ParamIndex = enumLocalIndex;
            enumLocal.StorageValue = enumStorage.Index();
            enumLocal.FieldAlignment = enumAllocationAlign;
            enumLocal.OwnerTypeIndex = enumOwnerTypeIndex;
            enumLocal.Mutable = enumMutable;
            if (enumStorageLocals.Add(enumLocal) == 0)
            {
                return false;
            }

            stack mut EnumStorageInitializer enumInitializer = new();
            enumInitializer.LocalOrdinal = enumLocalOrdinal;
            enumInitializer.ParamIndex = enumLocalIndex;
            enumInitializer.FieldAlignment = enumAllocationAlign;
            enumInitializer.OwnerTypeIndex = enumOwnerTypeIndex;
            enumInitializer.ExprRoot = enumExpr.NodeId;
            if (enumStorageInitializers.Add(enumInitializer) == 0)
            {
                return false;
            }

            cursor = statementEnd + 1;
            continue;
        }

        stack u32[0 max] objectTypeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
        stack mut u32[0 max] bodyOpen = 0;
        stack mut u32[0 max] bodyClose = 0;
        stack mut u32[0 max] argsOpen = 0;
        stack mut u32[0 max] argsClose = 0;
        stack bool objectStorageLocal = localStorage == TokenKind.Stack || localStorage == TokenKind.Heap;
        stack mut bool objectConstructor = false;
        stack mut bool positionalRecordConstructor = false;
        if (objectStorageLocal
            && hasAssign
            && objectTypeToken != 0
            && TryParseTargetTypedObjectConstructorShape(stream, source, objectTypeToken, assignToken, statementEnd, bodyOpen, bodyClose))
        {
            objectConstructor = true;
        }
        else if (objectStorageLocal
            && hasAssign
            && objectTypeToken != 0
            && TryParseTargetTypedPositionalRecordConstructorShape(stream, source, objectTypeToken, assignToken, statementEnd, argsOpen, argsClose))
        {
            objectConstructor = true;
            positionalRecordConstructor = true;
        }

        if (!objectConstructor || (localStorage == TokenKind.Heap && signature.LawKind()))
        {
            return false;
        }

        stack u32[0 max] objectAllocationSize = TypeKnownByteExtentForLocalWithEnums(stream, source, declarations, enumLayouts, objectTypeToken);
        stack u32[0 max] objectAllocationAlign = TypeKnownByteAlignmentWithEnums(stream, source, declarations, enumLayouts, objectTypeToken);
        if (objectAllocationSize == 0 || objectAllocationAlign == 0)
        {
            return false;
        }

        stack mut MirValueId objectAllocation = new();
        if (localStorage == TokenKind.Heap)
        {
            objectAllocation = MirHeapAlloc(instrs, objectAllocationSize, objectAllocationAlign);
        }
        else
        {
            objectAllocation = MirStackAlloc(instrs, objectAllocationSize, objectAllocationAlign);
        }

        stack u32[0 max] objectLocalIndex = ResolveParam(params, source, nameStart, nameLength);
        stack u32[0 max] objectNonValueRoot = localRoots.Add(0);
        if (objectNonValueRoot == 0
            || localTypes.Add(SourceLocalTypeCodeNonValue()) == 0
            || localOverrideValues.Add(objectAllocation.Index()) == 0
            || sourceValueFacts.Add(new ValueFacts()) == 0)
        {
            return false;
        }

        if (positionalRecordConstructor)
        {
            if (!TryParseStackObjectPositionalRecordConstructorInitializers(
                stream,
                source,
                declarations,
                enumLayouts,
                objectTypeToken,
                argsOpen,
                argsClose,
                objectNonValueRoot,
                objectAllocation,
                nodes,
                params,
                funcNames,
                constructedObjectLocals,
                localTypes,
                sourceValueFacts,
                stackObjectFieldInitializers))
            {
                return false;
            }
        }
        else
        {
            if (!TryParseStackObjectFieldInitializers(
                stream,
                source,
                declarations,
                enumLayouts,
                objectTypeToken,
                bodyOpen,
                bodyClose,
                objectNonValueRoot,
                objectAllocation,
                nodes,
                params,
                funcNames,
                constructedObjectLocals,
                localTypes,
                sourceValueFacts,
                stackObjectFieldInitializers))
            {
                return false;
            }
        }

        stack mut ConstructedObjectLocal constructedObjectLocal = new();
        constructedObjectLocal.Start = nameStart;
        constructedObjectLocal.Length = nameLength;
        constructedObjectLocal.ParamIndex = objectLocalIndex;
        constructedObjectLocal.TypeToken = objectTypeToken;
        if (constructedObjectLocals.Add(constructedObjectLocal) == 0)
        {
            return false;
        }

        cursor = statementEnd + 1;
    }

    if ((constructedObjectLocals.Count() == 0
        && fixedArrayStorageLocals.Count() == 0
        && sliceDescriptorLocals.Count() == 0
        && scalarStorageLocals.Count() == 0
        && enumStorageLocals.Count() == 0)
        || cursor >= limit
        || stream.KindAt(cursor) != TokenKind.Switch)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] baseParamCount = params.Count();
    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<i64[min max]> caseMaxValues = new();
    stack mut IrTable<u32[0 max]> booleanCaseValues = new();
    stack bool switchCasesAreBoolean = SwitchFirstCaseLabelIsBoolean(stream, cursor);
    stack bool switchCasesAreEnum = !switchCasesAreBoolean && SwitchFirstCaseLabelLooksQualifiedName(stream, cursor);
    stack mut u32[0 max] caseOwnerDeclarationIndex = 0;
    if (switchCasesAreEnum)
    {
        if (!TryGetSwitchFirstEnumCaseOwnerDeclarationIndex(
                stream,
                source,
                declarations,
                cursor,
                caseOwnerDeclarationIndex))
        {
            return false;
        }
    }

    stack mut IrTable<ParsedSwitchFieldAssignmentArm> caseArms = new();
    stack mut IrTable<u32[0 max]> armLocalRoots = new();
    stack mut IrTable<ConstructedObjectFieldAssignment> fieldAssignments = new();
    stack mut ParsedSwitchFieldAssignmentArm defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (switchCasesAreBoolean)
    {
        if (!TryParseBooleanSwitchFieldAssignmentCases(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            scalarStorageLocals,
            enumStorageLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            cursor,
            baseParamCount,
            scrutinee,
            booleanCaseValues,
            caseArms,
            armLocalRoots,
            scalarAssignments,
            enumAssignments,
            fieldAssignments,
            storageMutationStatements,
            defaultArm,
            nextToken))
        {
            return false;
        }
    }
    else if (switchCasesAreEnum)
    {
        if (!TryParseEnumSwitchFieldAssignmentCases(
            stream,
            source,
            declarations,
            enumLayouts,
            caseOwnerDeclarationIndex,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            scalarStorageLocals,
            enumStorageLocals,
            localTypes,
            sourceValueFacts,
            cursor,
            baseParamCount,
            scrutinee,
            caseValues,
            caseArms,
            armLocalRoots,
            scalarAssignments,
            enumAssignments,
            fieldAssignments,
            storageMutationStatements,
            defaultArm,
            nextToken))
        {
            return false;
        }

        if (!CopyCaseValuesToCaseMaxValues(caseValues, caseMaxValues))
        {
            return false;
        }
    }
    else if (!TryParseIntegerSwitchFieldAssignmentCases(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        scalarStorageLocals,
        enumStorageLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        cursor,
        baseParamCount,
        scrutinee,
        caseValues,
        caseMaxValues,
        caseArms,
        armLocalRoots,
        scalarAssignments,
        enumAssignments,
        fieldAssignments,
        storageMutationStatements,
        defaultArm,
        nextToken))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] switchCaseCount = caseValues.Count();
    if (switchCasesAreBoolean)
    {
        switchCaseCount = booleanCaseValues.Count();
    }

    stack mut IrTable<u32[0 max]> postLocalRoots = new();
    stack mut u64[0 2 ** 63 - 1] returnIndex = nextToken;
    stack mut u64[0 2 ** 63 - 1] expectedParamCount = params.Count();
    while willexit (returnIndex < limit && stream.KindAt(returnIndex) == TokenKind.Var)
    {
        stack mut u64[0 2 ** 63 - 1] postLocalEnd = returnIndex;
        if (!FindSelfHostedStatementEnd(stream, returnIndex, limit, postLocalEnd))
        {
            return false;
        }

        stack u32[0 max] postLocalNameToken = FindSelfHostedLocalNameToken(stream, returnIndex, postLocalEnd);
        if (postLocalNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] postNameStart = stream.StartAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        stack u64[0 2 ** 63 - 1] postNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        if (ParamIndexOf(params, source, postNameStart, postNameLength) >= 0)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] postAssignToken = postLocalEnd;
        if (!FindSelfHostedStatementAssign(stream, returnIndex, postLocalEnd, postAssignToken))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforePostLocal = params.Count();
        stack ExprParseResult postLocalRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, postAssignToken + 1);
        if (postLocalRoot.Next != postLocalEnd || params.Count() != beforePostLocal)
        {
            return false;
        }

        if (ResolveParam(params, source, postNameStart, postNameLength) != (u32[0 max])expectedParamCount)
        {
            return false;
        }

        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRoot.NodeId, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        stack mut ValueFacts postLocalFacts = new();
        if (!TryBuildSourceValueFactsForNode(nodes, postLocalRoot.NodeId, sourceValueFacts, postLocalFacts)
            && postLocalType == ExprType.BoolType)
        {
            postLocalFacts.SetIntegerRange(0, 2);
        }

        if (postLocalRoots.Add(postLocalRoot.NodeId) == 0
            || localTypes.Add(SourceLocalTypeCodeForNodeWithLocals(nodes, postLocalRoot.NodeId, localTypes)) == 0
            || sourceValueFacts.Add(postLocalFacts) == 0)
        {
            return false;
        }

        returnIndex = postLocalEnd + 1;
        expectedParamCount = expectedParamCount + 1;
    }

    stack mut bool hasTerminalIf = false;
    stack mut ParsedIfReturnArms terminalIfArms = new();
    stack mut ExprParseResult returnRoot = new();
    if (returnIndex >= limit)
    {
        return false;
    }

    if (stream.KindAt(returnIndex) == TokenKind.Return)
    {
        returnRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, returnIndex + 1);
        stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
        if (stream.KindAt(afterReturn) == TokenKind.Semi)
        {
            afterReturn = afterReturn + 1;
        }

        if (stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != expectedParamCount)
        {
            return false;
        }
    }
    else if (stream.KindAt(returnIndex) == TokenKind.If)
    {
        hasTerminalIf = true;
        if (!TryParseTerminalIfReturnArmsWithConstructedObjectLocalsAndSlices(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, returnIndex, terminalIfArms)
            || terminalIfArms.ThenBecome
            || terminalIfArms.ElseBecome)
        {
            return false;
        }

        if (stream.KindAt(terminalIfArms.ElseArm.Next) != TokenKind.RBrace || params.Count() != expectedParamCount)
        {
            return false;
        }
    }
    else
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localCallIndex = 0;
    while willexit (localCallIndex < localRoots.Count())
    {
        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(localCallIndex + 1));
        if (localRoot != 0
            && !ValidateModuleCallsForRootWithSlices(nodes, localRoot, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
        {
            return false;
        }

        localCallIndex = localCallIndex + 1;
    }

    if (!ValidateModuleCallsForRootWithSlices(nodes, scrutinee.NodeId, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts)
        || !ValidateSwitchFieldAssignmentArmModuleCalls(nodes, defaultArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, storageMutationStatements, loweringLocalTypes, (u32[0 max])baseParamCount, funcParamCounts, functionCallContractFacts, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] callArmIndex = 0;
    while willexit (callArmIndex < switchCaseCount)
    {
        stack ParsedSwitchFieldAssignmentArm caseArmForCalls = caseArms.Get((u32[0 max])(callArmIndex + 1));
        if (!ValidateSwitchFieldAssignmentArmModuleCalls(nodes, caseArmForCalls, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, storageMutationStatements, loweringLocalTypes, (u32[0 max])baseParamCount, funcParamCounts, functionCallContractFacts, sliceDescriptorLocals, distinctStorageFacts))
        {
            return false;
        }

        callArmIndex = callArmIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] postCallIndex = 0;
    while willexit (postCallIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalCallRoot = postLocalRoots.Get((u32[0 max])(postCallIndex + 1));
        if (!ValidateModuleCallsForRootWithSlices(nodes, postLocalCallRoot, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
        {
            return false;
        }

        postCallIndex = postCallIndex + 1;
    }

    if (hasTerminalIf)
    {
        if (!ValidateModuleCallsForRootWithSlices(nodes, terminalIfArms.Condition.NodeId, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts)
            || !ValidateModuleCallsForRootWithSlices(nodes, terminalIfArms.ThenArm.NodeId, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts)
            || !ValidateModuleCallsForRootWithSlices(nodes, terminalIfArms.ElseArm.NodeId, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
        {
            return false;
        }
    }
    else if (!ValidateModuleCallsForRootWithSlices(nodes, returnRoot.NodeId, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localCount = localRoots.Count();
    stack mut u64[0 2 ** 63 - 1] v = 0;
    stack mut u32[0 max] nextStackObjectInitializer = 1;
    stack mut u32[0 max] nextScalarStorageInitializer = 1;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    stack mut u32[0 max] nextEnumStorageInitializer = 1;
    while willexit (v < localCount)
    {
        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(v + 1));
        if (localRoot == 0)
        {
            stack mut u32[0 max] storageOverride = 0;
            if (localOverrideValues.Contains((u32[0 max])(v + 1)))
            {
                storageOverride = localOverrideValues.Get((u32[0 max])(v + 1));
            }

            if (localOverrides.Add(storageOverride) == 0)
            {
                return false;
            }
        }
        else
        {
            stack MirValueId varValue = LowerExprNodeWithCallContext(nodes, localRoot, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
            if (localOverrides.Add(varValue.Index()) == 0)
            {
                return false;
            }
        }

        nextScalarStorageInitializer = LowerScalarStorageInitializersForLocalWithCallContext(
            scalarStorageInitializers,
            (u32[0 max])(v + 1),
            nextScalarStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
            fixedArrayStorageInitializers,
            (u32[0 max])(v + 1),
            nextFixedArrayStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextEnumStorageInitializer = LowerEnumStorageInitializersForLocalWithCallContext(
            enumStorageInitializers,
            (u32[0 max])(v + 1),
            nextEnumStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
            stackObjectFieldInitializers,
            (u32[0 max])(v + 1),
            nextStackObjectInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);
        v = v + 1;
    }

    if ((u64[0 2 ** 63 - 1])(nextScalarStorageInitializer - 1) != scalarStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextEnumStorageInitializer - 1) != enumStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return false;
    }

    if (switchCasesAreBoolean)
    {
        return LowerBooleanSwitchFieldAssignmentCasesToBlocks(
            nodes,
            scrutinee.NodeId,
            booleanCaseValues,
            caseArms,
            armLocalRoots,
            scalarAssignments,
            enumAssignments,
            fieldAssignments,
            storageMutationStatements,
            defaultArm,
            postLocalRoots,
            hasTerminalIf,
            terminalIfArms,
            returnRoot.NodeId,
            loweringLocalTypes,
            localOverrides,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            functionCallContractFacts,
            sliceArgumentLocals,
            body);
    }

    return LowerIntegerSwitchFieldAssignmentCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        caseArms,
        armLocalRoots,
        scalarAssignments,
        enumAssignments,
        fieldAssignments,
        storageMutationStatements,
        defaultArm,
        postLocalRoots,
        hasTerminalIf,
        terminalIfArms,
        returnRoot.NodeId,
        loweringLocalTypes,
        localOverrides,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        functionCallContractFacts,
        sliceArgumentLocals,
        body);
}

internal fn bool LowerModuleTerminalIntegerSwitchFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyStartsWithTerminalSwitch(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<i64[min max]> caseMaxValues = new();
    stack mut IrTable<ExprParseResult> caseArms = new();
    stack mut ExprParseResult defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (!TryParseTerminalIntegerSwitchReturnCases(
        stream,
        source,
        nodes,
        params,
        funcNames,
        (u64[0 2 ** 63 - 1])braceIndex + 1,
        scrutinee,
        caseValues,
        caseMaxValues,
        caseArms,
        defaultArm,
        nextToken))
    {
        return false;
    }

    if (stream.KindAt(nextToken) != TokenKind.RBrace)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    return LowerTerminalIntegerSwitchCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        caseArms,
        defaultArm,
        localTypes,
        noOverrides,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        hasDeclaredReturnType,
        declaredReturnType,
        body);
}

internal fn bool LowerModuleTerminalBooleanSwitchFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyStartsWithTerminalSwitch(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<u32[0 max]> caseValues = new();
    stack mut IrTable<ExprParseResult> caseArms = new();
    stack mut ExprParseResult defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (!TryParseTerminalBooleanSwitchReturnCases(
        stream,
        source,
        nodes,
        params,
        funcNames,
        (u64[0 2 ** 63 - 1])braceIndex + 1,
        scrutinee,
        caseValues,
        caseArms,
        defaultArm,
        nextToken))
    {
        return false;
    }

    if (stream.KindAt(nextToken) != TokenKind.RBrace)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    return LowerTerminalBooleanSwitchCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseArms,
        defaultArm,
        localTypes,
        noOverrides,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        hasDeclaredReturnType,
        declaredReturnType,
        body);
}

internal fn bool LowerModuleTerminalEnumSwitchFunctionToBlocks(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (AsciiLength(sourceText) == 0 || !FunctionBodyStartsWithTerminalSwitch(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut DeclarationList declarations = new();
    if (!TryParseMirSourceDeclarations(stream, declarations))
    {
        return false;
    }

    stack mut TypedEnumLayoutTable enumLayouts = new();
    switch (BuildTypedEnumLayouts(sourceText, stream, declarations))
    {
        case ParseResult<TypedEnumLayoutTable>.Err(var layoutError):
            return false;
        case ParseResult<TypedEnumLayoutTable>.Ok(var builtLayouts):
            enumLayouts = builtLayouts;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut u32[0 max] caseOwnerDeclarationIndex = 0;
    if (!TryGetSwitchFirstEnumCaseOwnerDeclarationIndex(
        stream,
        source,
        declarations,
        (u64[0 2 ** 63 - 1])braceIndex + 1,
        caseOwnerDeclarationIndex))
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<i64[min max]> caseMaxValues = new();
    stack mut IrTable<ExprParseResult> caseArms = new();
    stack mut ExprParseResult defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (!TryParseTerminalEnumSwitchReturnCases(
        stream,
        source,
        declarations,
        enumLayouts,
        caseOwnerDeclarationIndex,
        nodes,
        params,
        funcNames,
        (u64[0 2 ** 63 - 1])braceIndex + 1,
        scrutinee,
        caseValues,
        caseArms,
        defaultArm,
        nextToken))
    {
        return false;
    }

    if (!CopyCaseValuesToCaseMaxValues(caseValues, caseMaxValues))
    {
        return false;
    }

    if (stream.KindAt(nextToken) != TokenKind.RBrace)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, declarations, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut u32[0 max] scrutineeOwnerDeclarationIndex = 0;
    if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, scrutinee.NodeId, localTypes, scrutineeOwnerDeclarationIndex)
        || scrutineeOwnerDeclarationIndex != caseOwnerDeclarationIndex)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    return LowerTerminalIntegerSwitchCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        caseArms,
        defaultArm,
        localTypes,
        noOverrides,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        hasDeclaredReturnType,
        declaredReturnType,
        body);
}

internal fn bool LowerModuleTerminalSwitchFunctionToBlocks(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    if (LowerModuleTerminalBooleanSwitchFunctionToBlocks(
        stream,
        source,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body))
    {
        return true;
    }

    if (LowerModuleTerminalEnumSwitchFunctionToBlocks(
        sourceText,
        stream,
        source,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body))
    {
        return true;
    }

    return LowerModuleTerminalIntegerSwitchFunctionToBlocks(
        stream,
        source,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body);
}

internal fn bool LowerModuleLocalSwitchStatementFunctionToBlocks(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithLocalSwitchStatementAssignment(stream, source, funcNames, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> targetNameTokens = new();
    stack mut IrTable<u32[0 max]> targetInitRoots = new();
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (cursor >= limit || stream.KindAt(cursor) != TokenKind.Var)
    {
        return false;
    }

    while willexit (cursor < limit && stream.KindAt(cursor) == TokenKind.Var)
    {
        stack mut u64[0 2 ** 63 - 1] localEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, localEnd))
        {
            return false;
        }

        stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, localEnd);
        if (localNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0
            || TokenTextExistsInTokenTable(stream, source, targetNameTokens, localNameToken))
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] assignToken = localEnd;
        if (!FindSelfHostedStatementAssign(stream, cursor, localEnd, assignToken))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
        stack ExprParseResult initResult = ParseExprIn(stream, source, nodes, params, funcNames, assignToken + 1);
        if (initResult.Next != localEnd
            || params.Count() != beforeInit
            || !ExprNodeCanBeDiscardedIfOverwritten(nodes, initResult.NodeId))
        {
            return false;
        }

        if (targetNameTokens.Add(localNameToken) == 0 || targetInitRoots.Add(initResult.NodeId) == 0)
        {
            return false;
        }

        cursor = localEnd + 1;
    }

    if (targetNameTokens.Count() == 0 || cursor >= limit || stream.KindAt(cursor) != TokenKind.Switch)
    {
        return false;
    }

    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<i64[min max]> caseMaxValues = new();
    stack mut IrTable<u32[0 max]> booleanCaseValues = new();
    stack bool switchCasesAreBoolean = SwitchFirstCaseLabelIsBoolean(stream, cursor);
    stack bool switchCasesAreEnum = !switchCasesAreBoolean && SwitchFirstCaseLabelLooksQualifiedName(stream, cursor);
    stack mut DeclarationList declarations = new();
    stack mut TypedEnumLayoutTable enumLayouts = new();
    stack mut u32[0 max] caseOwnerDeclarationIndex = 0;
    if (switchCasesAreEnum)
    {
        if (AsciiLength(sourceText) == 0
            || !TryParseMirSourceDeclarations(stream, declarations)
            || !TryGetSwitchFirstEnumCaseOwnerDeclarationIndex(
                stream,
                source,
                declarations,
                cursor,
                caseOwnerDeclarationIndex))
        {
            return false;
        }

        switch (BuildTypedEnumLayouts(sourceText, stream, declarations))
        {
            case ParseResult<TypedEnumLayoutTable>.Err(var layoutError):
                return false;
            case ParseResult<TypedEnumLayoutTable>.Ok(var builtLayouts):
                enumLayouts = builtLayouts;
        }
    }

    stack mut IrTable<ParsedSwitchAssignmentArm> caseArms = new();
    stack mut IrTable<u32[0 max]> armLocalRoots = new();
    stack mut IrTable<u32[0 max]> assignedRoots = new();
    stack mut IrTable<u32[0 max]> assignedTargetOffsets = new();
    stack mut ParsedSwitchAssignmentArm defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (switchCasesAreBoolean)
    {
        if (!TryParseBooleanSwitchAssignmentCases(
            stream,
            source,
            nodes,
            params,
            funcNames,
            cursor,
            targetNameTokens,
            signatureParamCount,
            scrutinee,
            booleanCaseValues,
            caseArms,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            defaultArm,
            nextToken))
        {
            return false;
        }
    }
    else if (switchCasesAreEnum)
    {
        if (!TryParseEnumSwitchAssignmentCases(
            stream,
            source,
            declarations,
            enumLayouts,
            caseOwnerDeclarationIndex,
            nodes,
            params,
            funcNames,
            cursor,
            targetNameTokens,
            signatureParamCount,
            scrutinee,
            caseValues,
            caseArms,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            defaultArm,
            nextToken))
        {
            return false;
        }

        if (!CopyCaseValuesToCaseMaxValues(caseValues, caseMaxValues))
        {
            return false;
        }
    }
    else if (!TryParseIntegerSwitchAssignmentCases(
        stream,
        source,
        nodes,
        params,
        funcNames,
        cursor,
        targetNameTokens,
        signatureParamCount,
        scrutinee,
        caseValues,
        caseMaxValues,
        caseArms,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        defaultArm,
        nextToken))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] switchCaseCount = caseValues.Count();
    if (switchCasesAreBoolean)
    {
        switchCaseCount = booleanCaseValues.Count();
    }

    stack mut u64[0 2 ** 63 - 1] targetIndex = 0;
    while willexit (targetIndex < targetNameTokens.Count())
    {
        stack u32[0 max] targetNameToken = targetNameTokens.Get((u32[0 max])(targetIndex + 1));
        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])targetNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])targetNameToken);
        if (ResolveParam(params, source, nameStart, nameLength) != (u32[0 max])(signatureParamCount + targetIndex))
        {
            return false;
        }

        if (!UpdateSwitchAssignmentTargetRawPointerFacts(
            params,
            nodes,
            caseArms,
            assignedRoots,
            assignedTargetOffsets,
            defaultArm,
            (u32[0 max])(signatureParamCount + targetIndex),
            (u32[0 max])targetIndex,
            (u32[0 max])switchCaseCount))
        {
            return false;
        }

        targetIndex = targetIndex + 1;
    }

    stack mut IrTable<u32[0 max]> postLocalRoots = new();
    stack mut u64[0 2 ** 63 - 1] returnIndex = nextToken;
    stack mut u64[0 2 ** 63 - 1] expectedParamCount = signatureParamCount + targetNameTokens.Count();
    while willexit (returnIndex < limit && stream.KindAt(returnIndex) == TokenKind.Var)
    {
        stack mut u64[0 2 ** 63 - 1] postLocalEnd = returnIndex;
        if (!FindSelfHostedStatementEnd(stream, returnIndex, limit, postLocalEnd))
        {
            return false;
        }

        stack u32[0 max] postLocalNameToken = FindSelfHostedLocalNameToken(stream, returnIndex, postLocalEnd);
        if (postLocalNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] postNameStart = stream.StartAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        stack u64[0 2 ** 63 - 1] postNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        if (ParamIndexOf(params, source, postNameStart, postNameLength) >= 0)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] postAssignToken = postLocalEnd;
        if (!FindSelfHostedStatementAssign(stream, returnIndex, postLocalEnd, postAssignToken))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforePostLocal = params.Count();
        stack ExprParseResult postLocalRoot = ParseExprIn(stream, source, nodes, params, funcNames, postAssignToken + 1);
        if (postLocalRoot.Next != postLocalEnd || params.Count() != beforePostLocal)
        {
            return false;
        }

        if (ResolveParam(params, source, postNameStart, postNameLength) != (u32[0 max])expectedParamCount)
        {
            return false;
        }

        if (postLocalRoots.Add(postLocalRoot.NodeId) == 0)
        {
            return false;
        }

        returnIndex = postLocalEnd + 1;
        expectedParamCount = expectedParamCount + 1;
    }

    stack mut bool hasTerminalIf = false;
    stack mut ParsedIfReturnArms terminalIfArms = new();
    stack mut ExprParseResult returnRoot = new();
    if (returnIndex >= limit)
    {
        return false;
    }

    if (stream.KindAt(returnIndex) == TokenKind.Return)
    {
        returnRoot = ParseExprIn(stream, source, nodes, params, funcNames, returnIndex + 1);
        stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
        if (stream.KindAt(afterReturn) == TokenKind.Semi)
        {
            afterReturn = afterReturn + 1;
        }

        if (stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != expectedParamCount)
        {
            return false;
        }
    }
    else if (stream.KindAt(returnIndex) == TokenKind.If)
    {
        hasTerminalIf = true;
        if (!TryParseTerminalIfReturnArms(stream, source, nodes, params, funcNames, returnIndex, terminalIfArms)
            || terminalIfArms.ThenBecome
            || terminalIfArms.ElseBecome)
        {
            return false;
        }

        if (stream.KindAt(terminalIfArms.ElseArm.Next) != TokenKind.RBrace || params.Count() != expectedParamCount)
        {
            return false;
        }
    }
    else
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut bool seededLocalTypes = false;
    if (switchCasesAreEnum)
    {
        seededLocalTypes = SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, declarations, signature, paramAbiFacts, signatureParamCount, localTypes);
    }
    else
    {
        seededLocalTypes = SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes);
    }

    if (!seededLocalTypes)
    {
        return false;
    }

    if (switchCasesAreEnum)
    {
        stack mut u32[0 max] scrutineeOwnerDeclarationIndex = 0;
        if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, scrutinee.NodeId, localTypes, scrutineeOwnerDeclarationIndex)
            || scrutineeOwnerDeclarationIndex != caseOwnerDeclarationIndex)
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] targetTypeIndex = 0;
    while willexit (targetTypeIndex < targetNameTokens.Count())
    {
        stack u32[0 max] initRootNode = targetInitRoots.Get((u32[0 max])(targetTypeIndex + 1));
        stack ExprType initType = TypeOfNodeWithLocals(nodes, initRootNode, localTypes);
        stack ExprType defaultType = TypeOfSwitchAssignmentArm(
            nodes,
            defaultArm,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            localTypes,
            (u32[0 max])signatureParamCount,
            (u32[0 max])targetTypeIndex);
        stack mut bool allInt = initType == ExprType.IntType && defaultType == ExprType.IntType;
        stack mut bool allBool = initType == ExprType.BoolType && defaultType == ExprType.BoolType;
        stack mut bool allPtr = initType == ExprType.PtrType && defaultType == ExprType.PtrType;
        stack mut u64[0 2 ** 63 - 1] typeIndex = 0;
        while willexit (typeIndex < switchCaseCount)
        {
            stack ParsedSwitchAssignmentArm caseArm = caseArms.Get((u32[0 max])(typeIndex + 1));
            stack ExprType caseType = TypeOfSwitchAssignmentArm(
                nodes,
                caseArm,
                armLocalRoots,
                assignedRoots,
                assignedTargetOffsets,
                localTypes,
                (u32[0 max])signatureParamCount,
                (u32[0 max])targetTypeIndex);
            allInt = allInt && caseType == ExprType.IntType;
            allBool = allBool && caseType == ExprType.BoolType;
            allPtr = allPtr && caseType == ExprType.PtrType;
            typeIndex = typeIndex + 1;
        }

        if (!allInt && !allBool && !allPtr)
        {
            return false;
        }

        stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeInt();
        if (allBool)
        {
            localTypeCode = SourceLocalTypeCodeBool();
        }
        else if (allPtr)
        {
            localTypeCode = SourceLocalTypeCodePointer();
        }

        if (localTypes.Add(localTypeCode) == 0)
        {
            return false;
        }

        targetTypeIndex = targetTypeIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] postLocalTypeIndex = 0;
    while willexit (postLocalTypeIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalTypeIndex + 1));
        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRootNode, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        stack u32[0 max] postLocalTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, postLocalRootNode, localTypes);

        if (localTypes.Add(postLocalTypeCode) == 0)
        {
            return false;
        }

        postLocalTypeIndex = postLocalTypeIndex + 1;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] initCallIndex = 0;
    while willexit (initCallIndex < targetInitRoots.Count())
    {
        stack u32[0 max] initCallRoot = targetInitRoots.Get((u32[0 max])(initCallIndex + 1));
        if (!ValidateModuleCallsForRoot(nodes, initCallRoot, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
        {
            return false;
        }

        initCallIndex = initCallIndex + 1;
    }

    if (!ValidateModuleCallsForRoot(nodes, scrutinee.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts)
        || !ValidateSwitchAssignmentArmModuleCalls(nodes, defaultArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, (u32[0 max])signatureParamCount, funcParamCounts, functionCallContractFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] callArmIndex = 0;
    while willexit (callArmIndex < switchCaseCount)
    {
        stack ParsedSwitchAssignmentArm caseArmForCalls = caseArms.Get((u32[0 max])(callArmIndex + 1));
        if (!ValidateSwitchAssignmentArmModuleCalls(nodes, caseArmForCalls, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, (u32[0 max])signatureParamCount, funcParamCounts, functionCallContractFacts, distinctStorageFacts))
        {
            return false;
        }

        callArmIndex = callArmIndex + 1;
    }

    postLocalTypeIndex = 0;
    while willexit (postLocalTypeIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalCallRootNode = postLocalRoots.Get((u32[0 max])(postLocalTypeIndex + 1));
        if (!ValidateModuleCallsForRoot(nodes, postLocalCallRootNode, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
        {
            return false;
        }

        postLocalTypeIndex = postLocalTypeIndex + 1;
    }

    if (hasTerminalIf)
    {
        if (!ValidateModuleCallsForRoot(nodes, terminalIfArms.Condition.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts)
            || !ValidateModuleCallsForRoot(nodes, terminalIfArms.ThenArm.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts)
            || !ValidateModuleCallsForRoot(nodes, terminalIfArms.ElseArm.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
        {
            return false;
        }
    }
    else if (!ValidateModuleCallsForRoot(nodes, returnRoot.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    if (switchCasesAreBoolean)
    {
        return LowerAssignedBooleanSwitchCasesToBlocks(
            nodes,
            scrutinee.NodeId,
            booleanCaseValues,
            caseArms,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            defaultArm,
            (u32[0 max])targetNameTokens.Count(),
            postLocalRoots,
            hasTerminalIf,
            terminalIfArms,
            returnRoot.NodeId,
            localTypes,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            body);
    }

    return LowerAssignedIntegerSwitchCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        caseArms,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        defaultArm,
        (u32[0 max])targetNameTokens.Count(),
        postLocalRoots,
        hasTerminalIf,
        terminalIfArms,
        returnRoot.NodeId,
        localTypes,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body);
}

internal fn bool LowerModuleLocalTerminalIntegerSwitchFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyHasLocalPrefixedTerminalSwitch(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localRoots = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    while willexit (cursor < limit && stream.KindAt(cursor) == TokenKind.Var)
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, statementEnd);
        if (localNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        if (!FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
        stack ExprParseResult varExpr = ParseExprIn(stream, source, nodes, params, funcNames, assignToken + 1);
        if (varExpr.Next != statementEnd || params.Count() != beforeInit)
        {
            return false;
        }

        stack ExprType varType = TypeOfNodeWithLocals(nodes, varExpr.NodeId, localTypes);
        stack mut bool rawPointerAliasMutable = false;
        stack mut u32[0 max] rawPointerAliasFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] rawPointerAliasElementSize = 0;
        stack mut u32[0 max] rawPointerAliasElementAlignment = 0;
        stack mut bool rawPointerAliasHasElementCount = false;
        stack mut bool rawPointerAliasElementCountIsParam = false;
        stack mut u32[0 max] rawPointerAliasElementCountLiteral = 0;
        stack mut u32[0 max] rawPointerAliasElementCountParamIndex = 0;
        stack bool rawPointerAlias = varType == ExprType.PtrType
            && TryGetRawPointerFactsForNode(
                nodes,
                params,
                varExpr.NodeId,
                rawPointerAliasMutable,
                rawPointerAliasFieldTypeCode,
                rawPointerAliasElementSize,
                rawPointerAliasElementAlignment);
        if (varType == ExprType.ErrorType || (varType == ExprType.PtrType && !rawPointerAlias))
        {
            return false;
        }

        stack mut u32[0 max] localIndex = 0;
        if (rawPointerAlias)
        {
            if (!TryGetRawPointerElementCountFactsForNameNode(
                nodes,
                params,
                varExpr.NodeId,
                rawPointerAliasHasElementCount,
                rawPointerAliasElementCountIsParam,
                rawPointerAliasElementCountLiteral,
                rawPointerAliasElementCountParamIndex))
            {
                rawPointerAliasHasElementCount = false;
            }

            localIndex = ResolveParamWithRawPointerElementAndCountFacts(
                params,
                source,
                nameStart,
                nameLength,
                rawPointerAliasMutable,
                rawPointerAliasFieldTypeCode,
                rawPointerAliasElementSize,
                rawPointerAliasElementAlignment,
                rawPointerAliasHasElementCount,
                rawPointerAliasElementCountIsParam,
                rawPointerAliasElementCountLiteral,
                rawPointerAliasElementCountParamIndex);
        }
        else
        {
            localIndex = ResolveParam(params, source, nameStart, nameLength);
        }

        stack u32[0 max] addedRoot = localRoots.Add(varExpr.NodeId);
        if (varType == ExprType.BoolType)
        {
            stack u32[0 max] boolSlot = localTypes.Add(SourceLocalTypeCodeBool());
        }
        else
        {
            stack u32[0 max] intSlot = localTypes.Add(SourceLocalTypeCodeForNodeWithLocals(nodes, varExpr.NodeId, localTypes));
        }

        cursor = statementEnd + 1;
    }

    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<i64[min max]> caseMaxValues = new();
    stack mut IrTable<ExprParseResult> caseArms = new();
    stack mut ExprParseResult defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (!TryParseTerminalIntegerSwitchReturnCases(
        stream,
        source,
        nodes,
        params,
        funcNames,
        cursor,
        scrutinee,
        caseValues,
        caseMaxValues,
        caseArms,
        defaultArm,
        nextToken))
    {
        return false;
    }

    if (stream.KindAt(nextToken) != TokenKind.RBrace)
    {
        return false;
    }

    if (params.Count() != signatureParamCount + localRoots.Count())
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);

    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] p = 0;
    while willexit (p < signatureParamCount)
    {
        stack u32[0 max] zero = localOverrides.Add(0);
        p = p + 1;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack u64[0 2 ** 63 - 1] localCount = localRoots.Count();
    stack mut u64[0 2 ** 63 - 1] v = 0;
    while willexit (v < localCount)
    {
        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(v + 1));
        stack MirValueId varValue = LowerExprNodeWithTypesAndLocals(nodes, localRoot, instrs, localTypes, localOverrides);
        stack u32[0 max] addedOverride = localOverrides.Add(varValue.Index());
        v = v + 1;
    }

    return LowerTerminalIntegerSwitchCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        caseArms,
        defaultArm,
        localTypes,
        localOverrides,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        hasDeclaredReturnType,
        declaredReturnType,
        body);
}


internal fn bool EmitModuleTerminalIntegerSwitchFunction(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    bool isTailCallable,
    u64[0 2 ** 63 - 1] fnIndex,
    u32[0 max] functionNumber,
    mut borrow OwnedAscii sink)
    where overlap(sourceText, source)
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<BlockEmit> ranges = new();
    stack mut LoweredBody body = new();
    if (!LowerModuleTerminalSwitchFunctionToBlocks(
        sourceText,
        stream,
        source,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        true,
        body))
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> paramFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, paramFacts))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack ValueFacts returnFacts = FunctionReturnRangeFact(stream, source, signature);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    if (!ValidateBlockReturnRangeFacts(returnFacts, blocks, valueFacts))
    {
        return false;
    }

    stack FunctionEffectFacts functionEffects = FunctionEffectFactsAt(functionEffectFacts, functionNumber);

    switch (EmitLlvmBlocksNumberedWithRangeFactsCore(
        instrs,
        funcTailFlags,
        functionEffectFacts,
        functionCallContractFacts,
        functionLinkageFacts,
        functionCallingConventionFacts,
        blocks,
        "f",
        functionNumber,
        isTailCallable,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        distinctStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        functionEffects,
        body.ParamCount,
        ranges,
        sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

internal fn bool EmitModuleLocalSwitchStatementFunction(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    bool isTailCallable,
    u64[0 2 ** 63 - 1] fnIndex,
    u32[0 max] functionNumber,
    mut borrow OwnedAscii sink)
    where overlap(sourceText, source)
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<BlockEmit> ranges = new();
    stack mut LoweredBody body = new();
    if (!LowerModuleLocalSwitchStatementFunctionToBlocks(
        sourceText,
        stream,
        source,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        true,
        body))
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> paramFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, paramFacts))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack ValueFacts returnFacts = FunctionReturnRangeFact(stream, source, signature);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    if (!ValidateBlockReturnRangeFacts(returnFacts, blocks, valueFacts))
    {
        return false;
    }

    stack FunctionEffectFacts functionEffects = FunctionEffectFactsAt(functionEffectFacts, functionNumber);

    switch (EmitLlvmBlocksNumberedWithRangeFactsCore(
        instrs,
        funcTailFlags,
        functionEffectFacts,
        functionCallContractFacts,
        functionLinkageFacts,
        functionCallingConventionFacts,
        blocks,
        "f",
        functionNumber,
        isTailCallable,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        distinctStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        functionEffects,
        body.ParamCount,
        ranges,
        sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

