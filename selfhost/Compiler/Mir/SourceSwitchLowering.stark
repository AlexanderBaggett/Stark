        stack mut u64[0 2 ** 63 - 1] colonToken = afterCaseLabel;
        if (stream.KindAt(afterCaseLabel) == TokenKind.When)
        {
            stack mut ExprParseResult parsedGuard = new();
            if (captureCount != 0)
            {
                if (!TryParseSwitchGuardWithFixedArrayCapturesAndSlices(
                        stream,
                        source,
                        moduleFacts,
                        nodes,
                        params,
                        params.Count(),
                        funcNames,
                        localTypes,
                        sourceValueFacts,
                        sliceDescriptorLocals,
                        resolvedFixedArrayParamIndex,
