        {
            return false;
        }

        stack u32[0 max] postLocalNameToken = FindSelfHostedLocalNameToken(stream, returnIndex, postLocalEnd);
        if (postLocalNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] postNameStart = stream.StartAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        stack u64[0 2 ** 63 - 1] postNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        if (ParamIndexOf(params, source, postNameStart, postNameLength) >= 0)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] postAssignToken = postLocalEnd;
        if (!FindSelfHostedStatementAssign(stream, returnIndex, postLocalEnd, postAssignToken))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforePostLocal = params.Count();
        stack ExprParseResult postLocalRoot = ParseExprIn(stream, source, nodes, params, funcNames, postAssignToken + 1);
        if (postLocalRoot.Next != postLocalEnd || params.Count() != beforePostLocal)
        {
            return false;
        }

        if (ResolveParam(params, source, postNameStart, postNameLength) != (u32[0 max])expectedParamCount)
        {
            return false;
        }

        if (postLocalRoots.Add(postLocalRoot.NodeId) == 0)
        {
            return false;
        }

        returnIndex = postLocalEnd + 1;
        expectedParamCount = expectedParamCount + 1;
    }

    stack mut bool hasTerminalIf = false;
    stack mut ParsedIfReturnArms terminalIfArms = new();
    stack mut ExprParseResult returnRoot = new();
    if (returnIndex >= limit)
    {
        return false;
    }

    if (stream.KindAt(returnIndex) == TokenKind.Return)
    {
        returnRoot = ParseExprIn(stream, source, nodes, params, funcNames, returnIndex + 1);
        stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
        if (stream.KindAt(afterReturn) == TokenKind.Semi)
        {
            afterReturn = afterReturn + 1;
        }

        if (stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != expectedParamCount)
        {
            return false;
        }
    }
    else if (stream.KindAt(returnIndex) == TokenKind.If)
    {
        hasTerminalIf = true;
        if (!TryParseTerminalIfReturnArms(stream, source, nodes, params, funcNames, returnIndex, terminalIfArms)
            || terminalIfArms.ThenBecome
            || terminalIfArms.ElseBecome)
        {
            return false;
        }

        if (stream.KindAt(terminalIfArms.ElseArm.Next) != TokenKind.RBrace || params.Count() != expectedParamCount)
        {
            return false;
        }
    }
    else
    {
        return false;
    }

    stack mut bool seededLocalTypes = false;
    if (setupLocalTypesSeeded)
    {
        if (fixedArrayStorageLocals.Count() != 0 && !switchCasesAreListPattern)
        {
            return false;
        }

        seededLocalTypes = true;
    }
    else if (switchCasesAreEnum)
    {
        seededLocalTypes = SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes);
    }
    else
    {
        seededLocalTypes = SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes);
    }

    if (!seededLocalTypes)
    {
        return false;
    }

    if (switchCasesAreEnum)
    {
        stack mut u32[0 max] scrutineeOwnerDeclarationIndex = 0;
        if (!TryGetSourceLocalEnumOwnerDeclarationIndexForNode(nodes, scrutinee.NodeId, localTypes, scrutineeOwnerDeclarationIndex)
            || scrutineeOwnerDeclarationIndex != caseOwnerDeclarationIndex)
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] targetTypeIndex = 0;
    while willexit (targetTypeIndex < targetNameTokens.Count())
    {
        stack u32[0 max] initRootNode = targetInitRoots.Get((u32[0 max])(targetTypeIndex + 1));
        stack ExprType initType = TypeOfNodeWithLocals(nodes, initRootNode, localTypes);
        stack mut ExprType defaultType = ExprType.ErrorType;
        if (switchCasesAreListPattern)
        {
            defaultType = TypeOfSwitchAssignmentArmWithCaptures(
                nodes,
                defaultArm,
                armLocalRoots,
                elementCaptureTypeCodes,
                assignedRoots,
                assignedTargetOffsets,
                localTypes,
                targetParamStart,
                (u32[0 max])targetTypeIndex);
        }
        else if (switchCasesAreStructAggregate)
        {
            defaultType = TypeOfSwitchAssignmentArmWithCaptures(
                nodes,
                defaultArm,
                armLocalRoots,
                structFieldCaptureTypeCodes,
                assignedRoots,
                assignedTargetOffsets,
                localTypes,
                targetParamStart,
                (u32[0 max])targetTypeIndex);
        }
        else
        {
            defaultType = TypeOfSwitchAssignmentArmWithCaptures(
                nodes,
                defaultArm,
                armLocalRoots,
                payloadCaptureTypeCodes,
                assignedRoots,
                assignedTargetOffsets,
                localTypes,
                targetParamStart,
                (u32[0 max])targetTypeIndex);
        }

        stack mut bool allInt = initType == ExprType.IntType && defaultType == ExprType.IntType;
        stack mut bool allBool = initType == ExprType.BoolType && defaultType == ExprType.BoolType;
        stack mut bool allPtr = initType == ExprType.PtrType && defaultType == ExprType.PtrType;
        stack mut u64[0 2 ** 63 - 1] typeIndex = 0;
        while willexit (typeIndex < switchCaseCount)
        {
            stack ParsedSwitchAssignmentArm caseArm = caseArms.Get((u32[0 max])(typeIndex + 1));
            stack mut ExprType caseType = ExprType.ErrorType;
            if (switchCasesAreListPattern)
            {
                caseType = TypeOfSwitchAssignmentArmWithCaptures(
                    nodes,
                    caseArm,
                    armLocalRoots,
                    elementCaptureTypeCodes,
                    assignedRoots,
                    assignedTargetOffsets,
                    localTypes,
                    targetParamStart,
                    (u32[0 max])targetTypeIndex);
            }
            else if (switchCasesAreStructAggregate)
            {
                caseType = TypeOfSwitchAssignmentArmWithCaptures(
                    nodes,
                    caseArm,
                    armLocalRoots,
                    structFieldCaptureTypeCodes,
                    assignedRoots,
                    assignedTargetOffsets,
                    localTypes,
                    targetParamStart,
                    (u32[0 max])targetTypeIndex);
            }
            else
            {
                caseType = TypeOfSwitchAssignmentArmWithCaptures(
                    nodes,
                    caseArm,
                    armLocalRoots,
                    payloadCaptureTypeCodes,
                    assignedRoots,
                    assignedTargetOffsets,
                    localTypes,
                    targetParamStart,
                    (u32[0 max])targetTypeIndex);
            }

            allInt = allInt && caseType == ExprType.IntType;
            allBool = allBool && caseType == ExprType.BoolType;
            allPtr = allPtr && caseType == ExprType.PtrType;
            typeIndex = typeIndex + 1;
        }

        if (!allInt && !allBool && !allPtr)
        {
            return false;
        }

        stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeInt();
        if (allBool)
        {
            localTypeCode = SourceLocalTypeCodeBool();
        }
        else if (allPtr)
        {
            localTypeCode = SourceLocalTypeCodePointer();
        }

        if (localTypes.Add(localTypeCode) == 0)
        {
            return false;
        }

        targetTypeIndex = targetTypeIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] postLocalTypeIndex = 0;
    while willexit (postLocalTypeIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalTypeIndex + 1));
        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRootNode, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        stack u32[0 max] postLocalTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, postLocalRootNode, localTypes);

        if (localTypes.Add(postLocalTypeCode) == 0)
        {
            return false;
        }

        postLocalTypeIndex = postLocalTypeIndex + 1;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] initCallIndex = 0;
    while willexit (initCallIndex < targetInitRoots.Count())
    {
        stack u32[0 max] initCallRoot = targetInitRoots.Get((u32[0 max])(initCallIndex + 1));
        if (!ValidateModuleCallsForRoot(nodes, initCallRoot, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
        {
            return false;
        }

        initCallIndex = initCallIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] fixedArrayInitCallIndex = 0;
    while willexit (fixedArrayInitCallIndex < fixedArrayStorageInitializers.Count())
    {
        stack FixedArrayStorageInitializer initializerForCalls = fixedArrayStorageInitializers.Get((u32[0 max])(fixedArrayInitCallIndex + 1));
        if (initializerForCalls.ExprRoot != 0
            && !ValidateModuleCallsForRoot(nodes, initializerForCalls.ExprRoot, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
        {
            return false;
        }

        fixedArrayInitCallIndex = fixedArrayInitCallIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] stackObjectInitCallIndex = 0;
    while willexit (stackObjectInitCallIndex < stackObjectFieldInitializers.Count())
    {
        stack StackObjectFieldInitializer initializerForCalls = stackObjectFieldInitializers.Get((u32[0 max])(stackObjectInitCallIndex + 1));
        if (initializerForCalls.ExprRoot != 0
            && !ValidateModuleCallsForRoot(nodes, initializerForCalls.ExprRoot, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
        {
            return false;
        }

        stackObjectInitCallIndex = stackObjectInitCallIndex + 1;
    }

    stack mut bool defaultCallsValid = false;
    if (switchCasesAreListPattern)
    {
        defaultCallsValid = ValidateSwitchAssignmentArmModuleCallsWithCaptures(nodes, defaultArm, armLocalRoots, elementCaptureTypeCodes, assignedRoots, assignedTargetOffsets, localTypes, targetParamStart, funcParamCounts, functionCallContractFacts, distinctStorageFacts);
    }
    else if (switchCasesAreStructAggregate)
    {
        defaultCallsValid = ValidateSwitchAssignmentArmModuleCallsWithCaptures(nodes, defaultArm, armLocalRoots, structFieldCaptureTypeCodes, assignedRoots, assignedTargetOffsets, localTypes, targetParamStart, funcParamCounts, functionCallContractFacts, distinctStorageFacts);
    }
    else
    {
        defaultCallsValid = ValidateSwitchAssignmentArmModuleCallsWithCaptures(nodes, defaultArm, armLocalRoots, payloadCaptureTypeCodes, assignedRoots, assignedTargetOffsets, localTypes, targetParamStart, funcParamCounts, functionCallContractFacts, distinctStorageFacts);
    }

    if (!ValidateModuleCallsForRoot(nodes, scrutinee.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts)
        || !defaultCallsValid)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] callArmIndex = 0;
    while willexit (callArmIndex < switchCaseCount)
    {
        stack ParsedSwitchAssignmentArm caseArmForCalls = caseArms.Get((u32[0 max])(callArmIndex + 1));
        stack mut bool caseCallsValid = false;
        if (switchCasesAreListPattern)
        {
            caseCallsValid = ValidateSwitchAssignmentArmModuleCallsWithCaptures(nodes, caseArmForCalls, armLocalRoots, elementCaptureTypeCodes, assignedRoots, assignedTargetOffsets, localTypes, targetParamStart, funcParamCounts, functionCallContractFacts, distinctStorageFacts);
        }
        else if (switchCasesAreStructAggregate)
        {
            caseCallsValid = ValidateSwitchAssignmentArmModuleCallsWithCaptures(nodes, caseArmForCalls, armLocalRoots, structFieldCaptureTypeCodes, assignedRoots, assignedTargetOffsets, localTypes, targetParamStart, funcParamCounts, functionCallContractFacts, distinctStorageFacts);
        }
        else
        {
            caseCallsValid = ValidateSwitchAssignmentArmModuleCallsWithCaptures(nodes, caseArmForCalls, armLocalRoots, payloadCaptureTypeCodes, assignedRoots, assignedTargetOffsets, localTypes, targetParamStart, funcParamCounts, functionCallContractFacts, distinctStorageFacts);
        }

        if (!caseCallsValid)
        {
            return false;
        }

        callArmIndex = callArmIndex + 1;
    }

    if (caseGuardNodes.Count() != 0)
    {
        stack mut u64[0 2 ** 63 - 1] guardCallIndex = 0;
        while willexit (guardCallIndex < caseGuardNodes.Count())
        {
            stack u32[0 max] guardNode = caseGuardNodes.Get((u32[0 max])(guardCallIndex + 1));
            if (guardNode != 0)
            {
                stack ParsedSwitchAssignmentArm guardArm = caseArms.Get((u32[0 max])(guardCallIndex + 1));
                stack mut IrTable<u32[0 max]> guardLocalTypes = new();
                stack mut bool builtGuardTypes = false;
                if (switchCasesAreListPattern)
                {
                    builtGuardTypes = BuildSwitchAssignmentArmLocalTypesWithCaptures(
                        nodes,
                        guardArm,
                        armLocalRoots,
                        elementCaptureTypeCodes,
                        localTypes,
                        targetParamStart,
                        guardLocalTypes);
                }
                else if (switchCasesAreStructAggregate)
                {
                    builtGuardTypes = BuildSwitchAssignmentArmLocalTypesWithCaptures(
                        nodes,
                        guardArm,
                        armLocalRoots,
                        structFieldCaptureTypeCodes,
                        localTypes,
                        targetParamStart,
                        guardLocalTypes);
                }

                if (!builtGuardTypes
                    || !ValidateModuleCallsForRoot(nodes, guardNode, funcParamCounts, functionCallContractFacts, guardLocalTypes, distinctStorageFacts))
                {
                    return false;
                }
            }

            guardCallIndex = guardCallIndex + 1;
        }
    }

    postLocalTypeIndex = 0;
    while willexit (postLocalTypeIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalCallRootNode = postLocalRoots.Get((u32[0 max])(postLocalTypeIndex + 1));
        if (!ValidateModuleCallsForRoot(nodes, postLocalCallRootNode, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
        {
            return false;
        }

        postLocalTypeIndex = postLocalTypeIndex + 1;
    }

    if (hasTerminalIf)
    {
        if (!ValidateModuleCallsForRoot(nodes, terminalIfArms.Condition.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts)
            || !ValidateModuleCallsForRoot(nodes, terminalIfArms.ThenArm.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts)
            || !ValidateModuleCallsForRoot(nodes, terminalIfArms.ElseArm.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
        {
            return false;
        }
    }
    else if (!ValidateModuleCallsForRoot(nodes, returnRoot.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    if (fixedArrayStorageLocals.Count() != 0 && !switchCasesAreListPattern)
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverridesForAssignedSwitch = new();
    stack mut u64[0 2 ** 63 - 1] p = 0;
    while willexit (p < signatureParamCount)
    {
        if (localOverridesForAssignedSwitch.Add(0) == 0)
        {
            return false;
        }

        p = p + 1;
    }

    stack u64[0 2 ** 63 - 1] localCount = localRoots.Count();
    stack mut u64[0 2 ** 63 - 1] v = 0;
    stack mut u32[0 max] nextStackObjectInitializer = 1;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    while willexit (v < localCount)
    {
        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(v + 1));
        if (localRoot == 0)
        {
            stack mut u32[0 max] storageOverride = 0;
            if (localOverrideValues.Contains((u32[0 max])(v + 1)))
            {
                storageOverride = localOverrideValues.Get((u32[0 max])(v + 1));
            }

            if (localOverridesForAssignedSwitch.Add(storageOverride) == 0)
            {
                return false;
            }
        }
        else
        {
            stack MirValueId varValue = LowerExprNodeWithTypesAndLocals(nodes, localRoot, instrs, localTypes, localOverridesForAssignedSwitch);
            if (localOverridesForAssignedSwitch.Add(varValue.Index()) == 0)
            {
                return false;
            }
        }

        nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
            fixedArrayStorageInitializers,
            (u32[0 max])(v + 1),
            nextFixedArrayStorageInitializer,
            nodes,
            instrs,
            localTypes,
            localOverridesForAssignedSwitch,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
            stackObjectFieldInitializers,
            (u32[0 max])(v + 1),
            nextStackObjectInitializer,
            nodes,
            instrs,
            localTypes,
            localOverridesForAssignedSwitch,
            functionCallContractFacts,
            sliceArgumentLocals);

        v = v + 1;
    }

    if ((u64[0 2 ** 63 - 1])(nextStackObjectInitializer - 1) != stackObjectFieldInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return false;
    }

    if (switchCasesAreBoolean)
    {
        return LowerAssignedBooleanSwitchCasesToBlocks(
            nodes,
            scrutinee.NodeId,
            booleanCaseValues,
            caseArms,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            defaultArm,
            (u32[0 max])targetNameTokens.Count(),
            postLocalRoots,
            hasTerminalIf,
            terminalIfArms,
            returnRoot.NodeId,
            localTypes,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            body);
    }

    return LowerAssignedIntegerSwitchCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        switchCasesAreEnum && (payloadPatternOrdinals.Count() != 0 || payloadCaptureOrdinals.Count() != 0),
        switchCasesAreListPattern,
        switchCasesAreStructAggregate,
        fixedArrayParamIndex,
        fixedArrayFacts,
        useFixedArrayStorageLocal,
        fixedArrayLocal,
        structParamIndex,
        structTypeToken,
        structBaseByteOffset,
        useStructValueParam,
        structValueFacts,
        localOverridesForAssignedSwitch,
        caseOwnerDeclarationIndex,
        moduleFacts,
        casePayloadPatternStarts,
        casePayloadPatternCounts,
        payloadPatternVariantOrdinals,
        payloadPatternOrdinals,
        payloadPatternTypeCodes,
        payloadPatternKinds,
        payloadPatternMinValues,
        payloadPatternMaxValues,
        payloadCaptureVariantOrdinals,
        payloadCaptureOrdinals,
        payloadCaptureTypeCodes,
        casePatternStarts,
        casePatternCounts,
        elementPatternIndices,
        elementPatternTypeCodes,
        elementPatternKinds,
        elementPatternMinValues,
        elementPatternMaxValues,
        caseElementCaptureStarts,
        caseElementCaptureCounts,
        elementCaptureIndices,
        elementCaptureTypeCodes,
        structFieldPatternIndices,
        caseGuardNodes,
        structFieldPatternOffsets,
        structFieldPatternAlignments,
        structFieldPatternTypeCodes,
        structFieldPatternMemberFactRows,
        structFieldPatternKinds,
        structFieldPatternMinValues,
        structFieldPatternMaxValues,
        caseStructFieldCaptureStarts,
        caseStructFieldCaptureCounts,
        structFieldCaptureIndices,
        structFieldCaptureOffsets,
        structFieldCaptureAlignments,
        structFieldCaptureTypeCodes,
        structFieldCaptureMemberFactRows,
        caseArms,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        defaultArm,
        (u32[0 max])targetNameTokens.Count(),
        postLocalRoots,
        hasTerminalIf,
        terminalIfArms,
        returnRoot.NodeId,
        localTypes,
        (u32[0 max])signatureParamCount,
        targetParamStart,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body);
}

internal fn bool LowerModuleLocalTerminalIntegerSwitchFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyHasLocalPrefixedTerminalSwitch(stream, source, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localRoots = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut IrTable<FixedArrayStorageLocal> fixedArrayStorageLocals = new();
    stack mut IrTable<FixedArrayStorageInitializer> fixedArrayStorageInitializers = new();
    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    stack mut IrTable<u32[0 max]> localOverrideValues = new();
    stack mut IrTable<StackObjectFieldInitializer> stackObjectFieldInitializers = new();
    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    stack mut bool usesArenaFrame = false;
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    while willexit (cursor < limit && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, statementEnd);
        if (localNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(cursor);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
        if (localStorage != TokenKind.Var)
        {
            stack u32[0 max] scalarTypeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
            stack mut u32[0 max] fixedArrayLength = 0;
            if (localStorage == TokenKind.Stack
                && scalarTypeToken != 0
                && TryReadFixedArrayLengthSuffix(stream, source, scalarTypeToken, fixedArrayLength))
            {
                stack mut MirType elementType = MirType.I64;
                if (!MirTypeForKnownSourceScalarTypeHead(stream, source, scalarTypeToken, elementType))
                {
                    return false;
                }

                stack u32[0 max] elementSize = ScalarTypeKnownByteExtent(stream, source, scalarTypeToken);
                stack u32[0 max] elementAlignment = NaturalAlignmentForByteExtent(elementSize);
                stack u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
                stack u32[0 max] arrayAllocationSize = TypeKnownByteExtentForLocal(stream, source, scalarTypeToken);
                stack u32[0 max] arrayAllocationAlign = TypeKnownByteAlignment(stream, source, scalarTypeToken);
                if (fixedArrayLength == 0
                    || elementSize == 0
                    || elementAlignment == 0
                    || fieldTypeCode == SourceResolvedFieldTypeCodeInvalid()
                    || arrayAllocationSize == 0
                    || arrayAllocationAlign == 0)
                {
                    return false;
                }

                stack mut IrTable<u32[0 max]> initializerRoots = new();
                if (hasAssign)
                {
                    if (stream.KindAt(assignToken + 1) != TokenKind.LBrace)
                    {
                        return false;
                    }

                    stack u32[0 max] initializerClose = MatchingBraceForMirLowering(stream, (u32[0 max])(assignToken + 1));
                    if (initializerClose == (u32[0 max])(assignToken + 1)
                        || (u64[0 2 ** 63 - 1])initializerClose + 1 != statementEnd)
                    {
                        return false;
