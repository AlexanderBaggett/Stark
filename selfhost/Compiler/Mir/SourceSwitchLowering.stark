internal fn bool BuildTerminalFixedArraySwitchCaptureSliceDescriptorLocals(
    u32[0 max] fixedArrayParamIndex,
    ParamAbiFacts fixedArrayFacts,
    bool useFixedArrayStorageLocal,
    borrow IrTable<u32[0 max]> captureElementIndices,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    borrow IrTable<SourceSliceDescriptorLocal> baseSliceDescriptorLocals,
    mut borrow IrTable<SourceSliceDescriptorLocal> armSliceDescriptorLocals)
    where overlap(captureTypeCodes, baseLocalTypes)
{
    if (!CopySwitchSliceDescriptorLocals(baseSliceDescriptorLocals, armSliceDescriptorLocals))
    {
        return false;
    }

    stack u32[0 max] baseLocalCount = (u32[0 max])baseLocalTypes.Count();
    stack mut u32[0 max] captureIndex = 0;
    while willexit (captureIndex < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureIndex;
        if (!captureElementIndices.Contains(captureRow)
            || !captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] elementIndex = captureElementIndices.Get(captureRow);
        stack u32[0 max] captureTypeCode = captureTypeCodes.Get(captureRow);
        if (SourceSwitchCaptureIsFixedArrayWholeParam(elementIndex, captureTypeCode, fixedArrayFacts))
        {
            stack u32[0 max] captureParamIndex = baseLocalCount + captureIndex;
            if (useFixedArrayStorageLocal)
            {
                if (!AddTerminalFixedArrayWholeCaptureCopyStorageSliceDescriptor(
                    captureParamIndex,
                    fixedArrayFacts,
                    armSliceDescriptorLocals))
                {
                    return false;
                }
            }
            else if (!AddTerminalFixedArrayWholeCaptureSliceDescriptor(
                captureParamIndex,
                fixedArrayParamIndex,
                fixedArrayFacts,
                armSliceDescriptorLocals))
            {
                return false;
            }
        }

        captureIndex = captureIndex + 1;
    }

    return true;
}

internal fn bool BuildTerminalFixedArraySwitchCaptureSliceArgumentLocals(
    u32[0 max] fixedArrayParamIndex,
    ParamAbiFacts fixedArrayFacts,
    bool useFixedArrayStorageLocal,
    borrow IrTable<u32[0 max]> captureElementIndices,
    borrow IrTable<u32[0 max]> captureTypeCodes,
