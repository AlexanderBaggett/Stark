    borrow IrTable<u32[0 max]> targetNameTokens,
    u64[0 2 ** 63 - 1] signatureParamCount,
    out ExprParseResult scrutinee,
    out u32[0 max] fixedArrayParamIndex,
    out ParamAbiFacts fixedArrayFacts,
    mut borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    mut borrow IrTable<u32[0 max]> casePatternStarts,
    mut borrow IrTable<u32[0 max]> casePatternCounts,
    mut borrow IrTable<u32[0 max]> caseGuardNodes,
    mut borrow IrTable<u32[0 max]> elementPatternIndices,
    mut borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    mut borrow IrTable<u32[0 max]> elementPatternKinds,
    mut borrow IrTable<i64[min max]> elementPatternMinValues,
    mut borrow IrTable<i64[min max]> elementPatternMaxValues,
    mut borrow IrTable<u32[0 max]> caseElementCaptureStarts,
    mut borrow IrTable<u32[0 max]> caseElementCaptureCounts,
    mut borrow IrTable<u32[0 max]> elementCaptureIndices,
    mut borrow IrTable<u32[0 max]> elementCaptureTypeCodes,
    mut borrow IrTable<u32[0 max]> elementCaptureNameTokens,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<u32[0 max]> assignedRoots,
    mut borrow IrTable<u32[0 max]> assignedTargetOffsets,
    out ParsedSwitchAssignmentArm defaultArm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    scrutinee = new();
    fixedArrayParamIndex = 0;
    fixedArrayFacts = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack ExprParseResult parsedScrutinee = ParseExprIn(stream, source, nodes, params, funcNames, switchIndex + 2);
    stack mut u32[0 max] resolvedFixedArrayParamIndex = 0;
    stack mut ParamAbiFacts resolvedFixedArrayFacts = new();
    if (stream.KindAt(parsedScrutinee.Next) != TokenKind.RParen
        || stream.KindAt(parsedScrutinee.Next + 1) != TokenKind.LBrace
        || !TryResolveFixedArraySwitchScrutineeFacts(nodes, parsedScrutinee.NodeId, paramAbiFacts, resolvedFixedArrayParamIndex, resolvedFixedArrayFacts))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] switchBodyOpen = parsedScrutinee.Next + 1;
    stack u32[0 max] switchBodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])switchBodyOpen);
    if (switchBodyClose == (u32[0 max])switchBodyOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = switchBodyOpen + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Case)
    {
        stack mut u32[0 max] patternStart = 0;
        stack mut u32[0 max] patternCount = 0;
        stack mut u32[0 max] captureStart = 0;
        stack mut u32[0 max] captureCount = 0;
        stack mut u64[0 2 ** 63 - 1] afterCaseLabel = cursor + 1;
        if (!TryParseTerminalSwitchFixedArrayListCaseLabelWithCaptures(
                stream,
                source,
                resolvedFixedArrayFacts,
                cursor + 1,
                elementPatternIndices,
                elementPatternTypeCodes,
                elementPatternKinds,
                elementPatternMinValues,
                elementPatternMaxValues,
                elementCaptureIndices,
                elementCaptureTypeCodes,
                elementCaptureNameTokens,
                patternStart,
                patternCount,
                captureStart,
                captureCount,
                afterCaseLabel))
        {
            return false;
        }

        stack mut u32[0 max] guardNode = 0;
        stack mut u64[0 2 ** 63 - 1] colonToken = afterCaseLabel;
        if (stream.KindAt(afterCaseLabel) == TokenKind.When)
        {
            stack mut ExprParseResult parsedGuard = new();
            if (captureCount != 0)
            {
                if (!TryParseSwitchGuardWithCaptures(
                        stream,
                        source,
                        nodes,
                        params,
                        signatureParamCount,
                        funcNames,
                        elementCaptureNameTokens,
                        elementCaptureTypeCodes,
                        captureStart,
                        captureCount,
                        afterCaseLabel + 1,
                        parsedGuard,
                        colonToken))
                {
                    return false;
                }
            }
            else
            {
                stack u64[0 2 ** 63 - 1] beforeGuardParamCount = params.Count();
                parsedGuard = ParseExprIn(stream, source, nodes, params, funcNames, afterCaseLabel + 1);
                if (parsedGuard.NodeId == 0
                    || parsedGuard.Next == afterCaseLabel + 1
                    || params.Count() != beforeGuardParamCount)
                {
                    return false;
                }

                colonToken = parsedGuard.Next;
            }

            guardNode = parsedGuard.NodeId;
        }

        if (stream.KindAt(colonToken) != TokenKind.Colon
            || SourceSwitchListPatternCaseOverlapsPreviousUnguardedCase(
                nodes,
                casePatternStarts,
                casePatternCounts,
                caseGuardNodes,
                elementPatternIndices,
                elementPatternTypeCodes,
                elementPatternKinds,
                elementPatternMinValues,
                elementPatternMaxValues,
                patternStart,
                patternCount))
        {
            return false;
        }

        stack mut ParsedSwitchAssignmentArm caseArm = new();
        stack mut u64[0 2 ** 63 - 1] afterCase = colonToken + 1;
        if (!TryParseSwitchAssignmentArmWithCaptures(
            stream,
            source,
            nodes,
            params,
            signatureParamCount,
            funcNames,
            targetNameTokens,
            elementCaptureNameTokens,
            elementCaptureTypeCodes,
            captureStart,
            captureCount,
            colonToken + 1,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            caseArm,
            afterCase))
        {
            return false;
        }

        if (caseArms.Add(caseArm) == 0
            || casePatternStarts.Add(patternStart) == 0
            || casePatternCounts.Add(patternCount) == 0
            || caseGuardNodes.Add(guardNode) == 0
            || caseElementCaptureStarts.Add(captureStart) == 0
            || caseElementCaptureCounts.Add(captureCount) == 0)
        {
            return false;
        }

        cursor = afterCase;
    }

    if (caseArms.Count() == 0)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ParsedSwitchAssignmentArm parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseSwitchAssignmentArm(
        stream,
        source,
        nodes,
        params,
        signatureParamCount,
        funcNames,
        targetNameTokens,
        cursor + 2,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        parsedDefault,
        afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = parsedScrutinee;
    fixedArrayParamIndex = resolvedFixedArrayParamIndex;
    fixedArrayFacts = resolvedFixedArrayFacts;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}

