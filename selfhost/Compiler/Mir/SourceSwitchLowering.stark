    structTypeToken = resolvedStructTypeToken;
    structBaseByteOffset = resolvedStructBaseByteOffset;
    useStructValueParam = resolvedUseStructValueParam;
    structValueFacts = resolvedStructValueFacts;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}

internal fn bool TryParseStructAggregateSwitchAssignmentCases(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] switchIndex,
    borrow IrTable<u32[0 max]> targetNameTokens,
    u64[0 2 ** 63 - 1] signatureParamCount,
    out ExprParseResult scrutinee,
    out u32[0 max] structParamIndex,
    out u32[0 max] structTypeToken,
    out u32[0 max] structBaseByteOffset,
    out bool useStructValueParam,
    out ParamAbiFacts structValueFacts,
    mut borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    mut borrow IrTable<u32[0 max]> casePatternStarts,
    mut borrow IrTable<u32[0 max]> casePatternCounts,
    mut borrow IrTable<u32[0 max]> caseFieldCaptureStarts,
    mut borrow IrTable<u32[0 max]> caseFieldCaptureCounts,
    mut borrow IrTable<u32[0 max]> caseGuardNodes,
    mut borrow IrTable<u32[0 max]> fieldPatternIndices,
    mut borrow IrTable<u32[0 max]> fieldPatternOffsets,
    mut borrow IrTable<u32[0 max]> fieldPatternAlignments,
    mut borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    mut borrow IrTable<u32[0 max]> fieldPatternMemberFactRows,
    mut borrow IrTable<u32[0 max]> fieldPatternKinds,
    mut borrow IrTable<i64[min max]> fieldPatternMinValues,
    mut borrow IrTable<i64[min max]> fieldPatternMaxValues,
    mut borrow IrTable<u32[0 max]> fieldCaptureIndices,
    mut borrow IrTable<u32[0 max]> fieldCaptureOffsets,
    mut borrow IrTable<u32[0 max]> fieldCaptureAlignments,
    mut borrow IrTable<u32[0 max]> fieldCaptureTypeCodes,
    mut borrow IrTable<u32[0 max]> fieldCaptureMemberFactRows,
    mut borrow IrTable<u32[0 max]> fieldCaptureNameTokens,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<u32[0 max]> assignedRoots,
    mut borrow IrTable<u32[0 max]> assignedTargetOffsets,
    out ParsedSwitchAssignmentArm defaultArm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap(constructedObjectLocals, source)
{
    scrutinee = new();
    structParamIndex = 0;
    structTypeToken = 0;
    structBaseByteOffset = 0;
    useStructValueParam = false;
    structValueFacts = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] closeParen = MatchingBracketForMirLowering(stream, (u32[0 max])(switchIndex + 1));
    stack mut ExprParseResult resolvedScrutinee = new();
    stack mut u32[0 max] resolvedStructParamIndex = 0;
    stack mut u32[0 max] resolvedStructTypeToken = 0;
    stack mut u32[0 max] resolvedStructBaseByteOffset = 0;
    stack mut bool resolvedUseStructValueParam = false;
    stack mut ParamAbiFacts resolvedStructValueFacts = new();
    if (closeParen == (u32[0 max])(switchIndex + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace
        || !TryResolveStructAggregateSwitchScrutineeFacts(
            stream,
            source,
            moduleFacts,
            constructedObjectLocals,
            nodes,
            params,
            paramAbiFacts,
            switchIndex + 2,
            (u64[0 2 ** 63 - 1])closeParen,
            resolvedScrutinee,
            resolvedStructParamIndex,
            resolvedStructTypeToken,
            resolvedStructBaseByteOffset,
            resolvedUseStructValueParam,
            resolvedStructValueFacts))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] switchBodyOpen = (u64[0 2 ** 63 - 1])closeParen + 1;
    stack u32[0 max] switchBodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])switchBodyOpen);
    if (switchBodyClose == (u32[0 max])switchBodyOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = switchBodyOpen + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Case)
    {
        stack mut u32[0 max] patternStart = 0;
        stack mut u32[0 max] patternCount = 0;
        stack mut u32[0 max] captureStart = 0;
        stack mut u32[0 max] captureCount = 0;
        stack mut u64[0 2 ** 63 - 1] afterCaseLabel = cursor + 1;
        if (!TryParseTerminalSwitchStructAggregateCaseLabel(
                stream,
                source,
                moduleFacts,
                resolvedStructTypeToken,
                cursor + 1,
                fieldPatternIndices,
                fieldPatternOffsets,
                fieldPatternAlignments,
                fieldPatternTypeCodes,
                fieldPatternMemberFactRows,
                fieldPatternKinds,
                fieldPatternMinValues,
                fieldPatternMaxValues,
                fieldCaptureIndices,
                fieldCaptureOffsets,
                fieldCaptureAlignments,
                fieldCaptureTypeCodes,
                fieldCaptureMemberFactRows,
                fieldCaptureNameTokens,
                patternStart,
                patternCount,
                captureStart,
                captureCount,
                afterCaseLabel))
        {
            return false;
        }

        stack mut u32[0 max] guardNode = 0;
        stack mut u64[0 2 ** 63 - 1] colonToken = afterCaseLabel;
        if (stream.KindAt(afterCaseLabel) == TokenKind.When)
        {
            stack mut ExprParseResult parsedGuard = new();
            if (captureCount != 0)
            {
                if (!TryParseSwitchGuardWithCaptures(
                        stream,
                        source,
                        nodes,
                        params,
                        signatureParamCount,
                        funcNames,
                        fieldCaptureNameTokens,
                        fieldCaptureTypeCodes,
                        captureStart,
                        captureCount,
                        afterCaseLabel + 1,
                        parsedGuard,
                        colonToken))
                {
                    return false;
                }
            }
            else
            {
                stack u64[0 2 ** 63 - 1] beforeGuardParamCount = params.Count();
                parsedGuard = ParseExprIn(stream, source, nodes, params, funcNames, afterCaseLabel + 1);
                if (parsedGuard.NodeId == 0
                    || parsedGuard.Next == afterCaseLabel + 1
                    || params.Count() != beforeGuardParamCount)
                {
                    return false;
                }

                colonToken = parsedGuard.Next;
            }

            guardNode = parsedGuard.NodeId;
        }

        if (stream.KindAt(colonToken) != TokenKind.Colon
            || SourceSwitchStructPatternCaseOverlapsPreviousUnguardedCase(
                nodes,
                casePatternStarts,
                casePatternCounts,
                caseGuardNodes,
                fieldPatternIndices,
                fieldPatternTypeCodes,
                fieldPatternKinds,
                fieldPatternMinValues,
                fieldPatternMaxValues,
                patternStart,
                patternCount))
        {
            return false;
        }

        stack mut ParsedSwitchAssignmentArm caseArm = new();
        stack mut u64[0 2 ** 63 - 1] afterCase = colonToken + 1;
        if (!TryParseSwitchAssignmentArmWithCaptures(
            stream,
            source,
            nodes,
            params,
            signatureParamCount,
            funcNames,
            targetNameTokens,
            fieldCaptureNameTokens,
            fieldCaptureTypeCodes,
            captureStart,
            captureCount,
            colonToken + 1,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            caseArm,
            afterCase))
        {
            return false;
        }

        if (caseArms.Add(caseArm) == 0
            || casePatternStarts.Add(patternStart) == 0
            || casePatternCounts.Add(patternCount) == 0
            || caseFieldCaptureStarts.Add(captureStart) == 0
            || caseFieldCaptureCounts.Add(captureCount) == 0
            || caseGuardNodes.Add(guardNode) == 0)
        {
            return false;
        }

        cursor = afterCase;
    }

    if (caseArms.Count() == 0)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ParsedSwitchAssignmentArm parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseSwitchAssignmentArm(
        stream,
        source,
        nodes,
        params,
        signatureParamCount,
        funcNames,
        targetNameTokens,
        cursor + 2,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        parsedDefault,
        afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = resolvedScrutinee;
    structParamIndex = resolvedStructParamIndex;
    structTypeToken = resolvedStructTypeToken;
    structBaseByteOffset = resolvedStructBaseByteOffset;
    useStructValueParam = resolvedUseStructValueParam;
    structValueFacts = resolvedStructValueFacts;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}




internal fn bool TryParseSwitchAssignmentArmWithCaptures(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> targetNameTokens,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    u64[0 2 ** 63 - 1] armStart,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<u32[0 max]> assignedRoots,
    mut borrow IrTable<u32[0 max]> assignedTargetOffsets,
    out ParsedSwitchAssignmentArm arm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    arm = new();
    nextToken = armStart;

    stack u64[0 2 ** 63 - 1] targetCountWide = targetNameTokens.Count();
    if (targetCountWide == 0)
    {
        return false;
    }

    stack mut IrTable<ParamName> armParams = new();
    if (!CopyParamNamePrefix(baseParams, baseParamCount, armParams))
    {
        return false;
    }

    stack mut u32[0 max] captureOffset = 0;
    while willexit (captureOffset < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureOffset;
        if (!captureNameTokens.Contains(captureRow) || !captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] captureNameToken = captureNameTokens.Get(captureRow);
        stack u64[0 2 ** 63 - 1] captureNameStart = stream.StartAt((u64[0 2 ** 63 - 1])captureNameToken);
        stack u64[0 2 ** 63 - 1] captureNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])captureNameToken);
        if (ParamIndexOf(armParams, source, captureNameStart, captureNameLength) >= 0)
        {
            return false;
        }

        stack u32[0 max] captureLocalIndex = ResolveParam(armParams, source, captureNameStart, captureNameLength);
        if (captureLocalIndex != (u32[0 max])(baseParamCount + (u64[0 2 ** 63 - 1])captureOffset))
        {
            return false;
        }

        captureOffset = captureOffset + 1;
    }

    stack u32[0 max] localRootStart = (u32[0 max])(armLocalRoots.Count() + 1);
    stack u32[0 max] assignedRootStart = (u32[0 max])(assignedRoots.Count() + 1);
    stack mut u32[0 max] localRootCount = 0;
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] cursor = armStart + 1;
        while willexit (cursor < (u64[0 2 ** 63 - 1])closeBrace && stream.KindAt(cursor) == TokenKind.Var)
        {
            stack mut u64[0 2 ** 63 - 1] localEnd = cursor;
            if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])closeBrace, localEnd))
            {
                return false;
            }

            stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, localEnd);
            if (localNameToken == 0)
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] localNameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
            stack u64[0 2 ** 63 - 1] localNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
            if (ParamIndexOf(armParams, source, localNameStart, localNameLength) >= 0)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] localAssignToken = localEnd;
            if (!FindSelfHostedStatementAssign(stream, cursor, localEnd, localAssignToken))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeLocal = armParams.Count();
            stack ExprParseResult localRoot = ParseExprIn(stream, source, nodes, armParams, funcNames, localAssignToken + 1);
            if (localRoot.Next != localEnd || armParams.Count() != beforeLocal)
            {
                return false;
            }

            stack u32[0 max] localIndex = ResolveParam(armParams, source, localNameStart, localNameLength);
            if (armLocalRoots.Add(localRoot.NodeId) == 0)
            {
                return false;
            }

            localRootCount = localRootCount + 1;
            cursor = localEnd + 1;
        }

        stack mut u64[0 2 ** 63 - 1] assignmentIndex = 0;
        while willexit (assignmentIndex < targetCountWide)
        {
            stack mut u32[0 max] targetOffset = 0;
            if (cursor >= (u64[0 2 ** 63 - 1])closeBrace
                || stream.KindAt(cursor) != TokenKind.Identifier
                || stream.KindAt(cursor + 1) != TokenKind.Assign
                || !TryFindSwitchTargetOffsetForToken(stream, source, targetNameTokens, (u32[0 max])cursor, targetOffset)
                || SwitchAssignmentArmTargetOffsetExists(assignedTargetOffsets, assignedRootStart, (u32[0 max])assignmentIndex, targetOffset))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeAssign = armParams.Count();
            stack ExprParseResult parsedAssigned = ParseExprIn(stream, source, nodes, armParams, funcNames, cursor + 2);
            if (armParams.Count() != beforeAssign)
            {
                return false;
            }

            if (assignmentIndex == 0)
            {
                arm.Assigned = parsedAssigned;
            }

            if (assignedRoots.Add(parsedAssigned.NodeId) == 0 || assignedTargetOffsets.Add(targetOffset) == 0)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] afterExpr = parsedAssigned.Next;
            stack mut bool hasSemicolon = false;
            if (stream.KindAt(afterExpr) == TokenKind.Semi)
            {
                hasSemicolon = true;
                afterExpr = afterExpr + 1;
            }

            assignmentIndex = assignmentIndex + 1;
            if (assignmentIndex < targetCountWide)
            {
                if (!hasSemicolon)
                {
                    return false;
                }

                cursor = afterExpr;
            }
            else
            {
                if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
                {
                    return false;
                }

                cursor = afterExpr;
            }
        }

        if (cursor != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        arm.AssignedRootStart = assignedRootStart;
        arm.AssignedRootCount = (u32[0 max])targetCountWide;
        arm.CaptureStart = captureStart;
        arm.CaptureCount = captureCount;
        arm.LocalRootStart = localRootStart;
        arm.LocalRootCount = localRootCount;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (targetCountWide != 1)
    {
        return false;
    }

    stack u32[0 max] compactTargetNameToken = targetNameTokens.Get(1);
    if (stream.KindAt(armStart) != TokenKind.Identifier
        || stream.KindAt(armStart + 1) != TokenKind.Assign
        || !TokenTextEqualsAsciiSpan(stream, source, compactTargetNameToken, (u32[0 max])armStart))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeCompact = armParams.Count();
    stack ExprParseResult parsedCompactArm = ParseExprIn(stream, source, nodes, armParams, funcNames, armStart + 2);
    stack mut u64[0 2 ** 63 - 1] afterCompactExpr = parsedCompactArm.Next;
    if (stream.KindAt(afterCompactExpr) == TokenKind.Semi)
    {
        afterCompactExpr = afterCompactExpr + 1;
    }

    if (armParams.Count() != beforeCompact)
    {
        return false;
    }

    arm.Assigned = parsedCompactArm;
    arm.AssignedRootStart = assignedRootStart;
    arm.AssignedRootCount = 1;
    arm.CaptureStart = captureStart;
    arm.CaptureCount = captureCount;
    arm.LocalRootStart = localRootStart;
    arm.LocalRootCount = 0;
    if (assignedRoots.Add(parsedCompactArm.NodeId) == 0)
    {
        return false;
    }

    if (assignedTargetOffsets.Add(0) == 0)
    {
        return false;
    }

    nextToken = afterCompactExpr;
    return true;
}

internal fn bool TryParseSwitchAssignmentArm(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> targetNameTokens,
    u64[0 2 ** 63 - 1] armStart,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<u32[0 max]> assignedRoots,
    mut borrow IrTable<u32[0 max]> assignedTargetOffsets,
    out ParsedSwitchAssignmentArm arm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    stack mut IrTable<u32[0 max]> noCaptureNameTokens = new();
    stack mut IrTable<u32[0 max]> noCaptureTypeCodes = new();
    return TryParseSwitchAssignmentArmWithCaptures(
        stream,
        source,
        nodes,
        baseParams,
        baseParamCount,
        funcNames,
        targetNameTokens,
        noCaptureNameTokens,
        noCaptureTypeCodes,
        0,
        0,
        armStart,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        arm,
        nextToken);
}

internal struct ParsedSwitchFieldAssignmentArm
{
    u32[0 max] AssignmentStart;
    u32[0 max] AssignmentCount;
    u32[0 max] LocalRootStart;
    u32[0 max] LocalRootCount;

    ParsedSwitchFieldAssignmentArm()
    {
        self.AssignmentStart = 0;
        self.AssignmentCount = 0;
        self.LocalRootStart = 0;
        self.LocalRootCount = 0;
    }
}

internal inline finite law u32[0 max] SwitchArenaDynamicReserveMethodReserve()
{
    return 1;
}

internal inline finite law u32[0 max] SwitchArenaDynamicReserveMethodTryReserve()
{
    return 2;
}

internal inline finite law u32[0 max] SwitchArenaDynamicReserveMethodTryReserveCapacity()
{
    return 3;
}

internal struct SwitchArenaDynamicReserveStatement
{
    u32[0 max] StorageValue;
    u32[0 max] Amount;
    u32[0 max] ElementSize;
    u32[0 max] Alignment;
    u32[0 max] Method;

    SwitchArenaDynamicReserveStatement()
    {
        self.StorageValue = 0;
        self.Amount = 0;
        self.ElementSize = 0;
        self.Alignment = 0;
        self.Method = 0;
    }
}

internal fn bool TryParseSwitchArenaDynamicReserveStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ArenaDynamicLocal> arenaDynamicLocals,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end,
    mut borrow IrTable<SwitchArenaDynamicReserveStatement> reserveStatements,
    mut borrow IrTable<SourceStorageMutationStatement> mutationStatements)
{
    if (start + 6 != end
        || stream.KindAt(start) != TokenKind.Identifier
        || stream.KindAt(start + 1) != TokenKind.Dot
        || stream.KindAt(start + 2) != TokenKind.Identifier
        || stream.KindAt(start + 3) != TokenKind.LParen
        || stream.KindAt(start + 5) != TokenKind.RParen)
    {
        return false;
    }

    stack mut u32[0 max] amount = 0;
    if (!TryReadNonNegativeIntegerToken(stream, source, start + 4, amount))
    {
        return false;
    }

    stack mut ArenaDynamicLocal local = new();
    if (!TryFindArenaDynamicLocal(arenaDynamicLocals, source, stream.StartAt(start), stream.LengthAt(start), local))
    {
        return false;
    }

    stack u32[0 max] methodToken = (u32[0 max])(start + 2);
    stack mut u32[0 max] method = 0;
    if (TokenTextIsReserveName(stream, source, methodToken))
    {
        method = SwitchArenaDynamicReserveMethodReserve();
    }
    else if (TokenTextIsTryReserveName(stream, source, methodToken))
    {
        method = SwitchArenaDynamicReserveMethodTryReserve();
    }
    else if (TokenTextIsTryReserveCapacityName(stream, source, methodToken))
    {
        method = SwitchArenaDynamicReserveMethodTryReserveCapacity();
    }
    else
    {
        return false;
    }

    stack mut SwitchArenaDynamicReserveStatement reserve = new();
    reserve.StorageValue = local.StorageValue;
    reserve.Amount = amount;
    reserve.ElementSize = local.ElementSize;
    reserve.Alignment = local.Alignment;
    reserve.Method = method;
    if (reserveStatements.Add(reserve) == 0)
    {
        return false;
    }

    stack mut SourceStorageMutationStatement mutation = new();
    mutation.Kind = SourceStorageMutationKindArenaDynamicReserve();
    mutation.AssignmentIndex = (u32[0 max])reserveStatements.Count();
    return mutationStatements.Add(mutation) != 0;
}

internal fn bool LowerSwitchArenaDynamicReserveStatement(
    SwitchArenaDynamicReserveStatement statement,
    mut borrow IrTable<MirInstruction> instrs)
{
    stack MirValueId storage = MirValueIdOf(statement.StorageValue);
    if (!storage.IsValid())
    {
        return false;
    }

    if (statement.Method == SwitchArenaDynamicReserveMethodReserve())
    {
        stack MirValueId reserve = MirArenaDynamicStorageReserve(instrs, storage, statement.Amount, statement.ElementSize, statement.Alignment);
        return reserve.IsValid();
    }

    if (statement.Method == SwitchArenaDynamicReserveMethodTryReserve())
    {
        stack MirValueId reserve = MirArenaDynamicStorageTryReserve(instrs, storage, statement.Amount, statement.ElementSize, statement.Alignment);
        return reserve.IsValid();
    }

    if (statement.Method == SwitchArenaDynamicReserveMethodTryReserveCapacity())
    {
        stack MirValueId reserve = MirArenaDynamicStorageTryReserveCapacity(instrs, storage, statement.Amount, statement.ElementSize, statement.Alignment);
        return reserve.IsValid();
    }

    return false;
}

internal fn bool BuildSwitchFieldAssignmentArmLocalTypes(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchFieldAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] baseLocalCount,
    mut borrow IrTable<u32[0 max]> armLocalTypes)
{
    stack mut u64[0 2 ** 63 - 1] localTypeIndex = 0;
    while willexit (localTypeIndex < (u64[0 2 ** 63 - 1])baseLocalCount)
    {
        stack mut u32[0 max] typeCode = 0;
        stack u32[0 max] typeSlot = (u32[0 max])(localTypeIndex + 1);
        if (baseLocalTypes.Contains(typeSlot))
        {
            typeCode = baseLocalTypes.Get(typeSlot);
        }

        if (armLocalTypes.Add(typeCode) == 0)
        {
            return false;
        }

        localTypeIndex = localTypeIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack ExprType localType = TypeOfNodeWithLocals(nodes, localRoot, armLocalTypes);
        if (localType == ExprType.ErrorType || localType == ExprType.PtrType)
        {
            return false;
        }

        stack u32[0 max] localTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, localRoot, armLocalTypes);
        if (armLocalTypes.Add(localTypeCode) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    return true;
}

internal fn bool TryParseSwitchFieldAssignmentArm(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<ScalarStorageLocal> scalarStorageLocals,
    borrow IrTable<EnumStorageLocal> enumStorageLocals,
    borrow IrTable<ArenaDynamicLocal> arenaDynamicLocals,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    borrow IrTable<ValueFacts> baseSourceValueFacts,
    borrow SourceModuleLoweringFacts moduleFacts,
    u64[0 2 ** 63 - 1] armStart,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    mut borrow IrTable<EnumStorageAssignment> enumAssignments,
    mut borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    mut borrow IrTable<SwitchArenaDynamicReserveStatement> arenaDynamicReserveStatements,
    mut borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    out ParsedSwitchFieldAssignmentArm arm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap_all(baseSourceValueFacts)
{
    arm = new();
    nextToken = armStart;

    stack mut IrTable<ParamName> armParams = new();
    if (!CopyParamNamePrefix(baseParams, baseParamCount, armParams))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    stack mut IrTable<ValueFacts> armSourceValueFacts = new();
    stack mut u64[0 2 ** 63 - 1] baseTypeIndex = 0;
    while willexit (baseTypeIndex < baseParamCount)
    {
        stack mut u32[0 max] typeCode = 0;
        stack u32[0 max] typeSlot = (u32[0 max])(baseTypeIndex + 1);
        if (baseLocalTypes.Contains(typeSlot))
        {
            typeCode = baseLocalTypes.Get(typeSlot);
        }

        if (armLocalTypes.Add(typeCode) == 0)
        {
            return false;
        }

        stack mut ValueFacts baseFacts = new();
        if (baseSourceValueFacts.Contains(typeSlot))
        {
            baseFacts = baseSourceValueFacts.Get(typeSlot);
        }

        if (armSourceValueFacts.Add(baseFacts) == 0)
        {
            return false;
        }

        baseTypeIndex = baseTypeIndex + 1;
    }

    stack u32[0 max] localRootStart = (u32[0 max])(armLocalRoots.Count() + 1);
    stack u32[0 max] assignmentStart = (u32[0 max])(storageMutationStatements.Count() + 1);
    stack mut u32[0 max] localRootCount = 0;
    stack mut u32[0 max] assignmentCount = 0;

    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] cursor = armStart + 1;
        while willexit (cursor < (u64[0 2 ** 63 - 1])closeBrace && stream.KindAt(cursor) == TokenKind.Var)
        {
            stack mut u64[0 2 ** 63 - 1] localEnd = cursor;
            if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])closeBrace, localEnd))
            {
                return false;
            }

            stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, localEnd);
            if (localNameToken == 0)
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] localNameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
            stack u64[0 2 ** 63 - 1] localNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
            if (ParamIndexOf(armParams, source, localNameStart, localNameLength) >= 0)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] localAssignToken = localEnd;
            if (!FindSelfHostedStatementAssign(stream, cursor, localEnd, localAssignToken))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeLocal = armParams.Count();
            stack ExprParseResult localRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, armParams, funcNames, constructedObjectLocals, sliceDescriptorLocals, armLocalTypes, armSourceValueFacts, moduleFacts, localAssignToken + 1);
            if (localRoot.Next != localEnd || armParams.Count() != beforeLocal)
            {
                return false;
            }

            stack ExprType localType = TypeOfNodeWithLocals(nodes, localRoot.NodeId, armLocalTypes);
            if (localType == ExprType.ErrorType || localType == ExprType.PtrType)
            {
                return false;
            }

            stack u32[0 max] localIndex = ResolveParam(armParams, source, localNameStart, localNameLength);
            stack mut ValueFacts localFacts = new();
            if (!TryBuildSourceValueFactsForNode(nodes, localRoot.NodeId, armSourceValueFacts, localFacts)
                && localType == ExprType.BoolType)
            {
                localFacts.SetIntegerRange(0, 2);
            }

            if (armLocalRoots.Add(localRoot.NodeId) == 0
                || armLocalTypes.Add(SourceLocalTypeCodeForNodeWithLocals(nodes, localRoot.NodeId, armLocalTypes)) == 0
                || armSourceValueFacts.Add(localFacts) == 0)
            {
                return false;
            }

            localRootCount = localRootCount + 1;
            cursor = localEnd + 1;
        }

        while willexit (cursor < (u64[0 2 ** 63 - 1])closeBrace)
        {
            stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
            if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])closeBrace, statementEnd))
            {
                return false;
            }

            if (!TryParseSourceStorageMutationStatement(
                stream,
                source,
                nodes,
                armParams,
                funcNames,
                constructedObjectLocals,
                sliceDescriptorLocals,
                scalarStorageLocals,
                enumStorageLocals,
                armLocalTypes,
                armSourceValueFacts,
                moduleFacts,
                cursor,
                statementEnd,
                scalarAssignments,
                enumAssignments,
                fieldAssignments,
                storageMutationStatements))
            {
                if (!TryParseSwitchArenaDynamicReserveStatement(
                    stream,
                    source,
                    arenaDynamicLocals,
                    cursor,
                    statementEnd,
                    arenaDynamicReserveStatements,
                    storageMutationStatements))
                {
                    return false;
                }
            }

            assignmentCount = assignmentCount + 1;
            cursor = statementEnd + 1;
        }

        if (assignmentCount == 0 || cursor != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        arm.AssignmentStart = assignmentStart;
        arm.AssignmentCount = assignmentCount;
        arm.LocalRootStart = localRootStart;
        arm.LocalRootCount = localRootCount;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] compactEnd = armStart;
    if (!FindSelfHostedStatementEnd(stream, armStart, stream.Count(), compactEnd))
    {
        return false;
    }

    if (!TryParseSourceStorageMutationStatement(
        stream,
        source,
        nodes,
        armParams,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        scalarStorageLocals,
        enumStorageLocals,
        armLocalTypes,
        armSourceValueFacts,
        moduleFacts,
        armStart,
        compactEnd,
        scalarAssignments,
        enumAssignments,
        fieldAssignments,
        storageMutationStatements))
    {
        if (!TryParseSwitchArenaDynamicReserveStatement(
            stream,
            source,
            arenaDynamicLocals,
            armStart,
            compactEnd,
            arenaDynamicReserveStatements,
            storageMutationStatements))
        {
            return false;
        }
    }

    arm.AssignmentStart = assignmentStart;
    arm.AssignmentCount = 1;
    arm.LocalRootStart = localRootStart;
    arm.LocalRootCount = 0;
    nextToken = compactEnd + 1;
    return true;
}

internal fn bool ValidateSwitchFieldAssignmentArmModuleCalls(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchFieldAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    borrow IrTable<SwitchArenaDynamicReserveStatement> arenaDynamicReserveStatements,
    borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] baseLocalCount,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<DistinctStoragePair> callerDistinctStorageFacts)
{
    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    if (!BuildSwitchFieldAssignmentArmLocalTypes(nodes, arm, armLocalRoots, baseLocalTypes, baseLocalCount, armLocalTypes))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        if (!ValidateModuleCallsForRootWithSlices(nodes, localRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentIndex = 0;
    while willexit (assignmentIndex < (u64[0 2 ** 63 - 1])arm.AssignmentCount)
    {
        stack u32[0 max] assignmentSlot = arm.AssignmentStart + (u32[0 max])assignmentIndex;
        if (!storageMutationStatements.Contains(assignmentSlot))
        {
            return false;
        }

        stack SourceStorageMutationStatement statement = storageMutationStatements.Get(assignmentSlot);
        if (statement.Kind == SourceStorageMutationKindScalar())
        {
            if (!scalarAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ScalarStorageAssignment assignment = scalarAssignments.Get(statement.AssignmentIndex);
            if (!ValidateModuleCallsForRootWithSlices(nodes, assignment.ExprRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindEnum())
        {
            if (!enumAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack EnumStorageAssignment assignment = enumAssignments.Get(statement.AssignmentIndex);
            if (!ValidateModuleCallsForRootWithSlices(nodes, assignment.ExprRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindConstructedObjectField())
        {
            if (!fieldAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ConstructedObjectFieldAssignment assignment = fieldAssignments.Get(statement.AssignmentIndex);
            if (assignment.IndexRoot != 0
                && !ValidateModuleCallsForRootWithSlices(nodes, assignment.IndexRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
            {
                return false;
            }

            if (!ValidateModuleCallsForRootWithSlices(nodes, assignment.ExprRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, sliceDescriptorLocals, callerDistinctStorageFacts))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindArenaDynamicReserve())
        {
            if (!arenaDynamicReserveStatements.Contains(statement.AssignmentIndex))
            {
                return false;
            }
        }
        else
        {
            return false;
        }

        assignmentIndex = assignmentIndex + 1;
    }

    return true;
}

internal fn bool LowerSwitchFieldAssignmentArmStores(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchFieldAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    borrow IrTable<SwitchArenaDynamicReserveStatement> arenaDynamicReserveStatements,
    borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] overrideIndex = 0;
    while willexit (overrideIndex < baseLocalOverrides.Count())
    {
        stack u32[0 max] overrideValue = baseLocalOverrides.Get((u32[0 max])(overrideIndex + 1));
        if (localOverrides.Add(overrideValue) == 0)
        {
            return false;
        }

        overrideIndex = overrideIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack MirValueId localValue = LowerExprNodeWithCallContext(nodes, localRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (localOverrides.Add(localValue.Index()) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] assignmentIndex = 0;
    while willexit (assignmentIndex < (u64[0 2 ** 63 - 1])arm.AssignmentCount)
    {
        stack u32[0 max] assignmentSlot = arm.AssignmentStart + (u32[0 max])assignmentIndex;
        if (!storageMutationStatements.Contains(assignmentSlot))
        {
            return false;
        }

        stack SourceStorageMutationStatement statement = storageMutationStatements.Get(assignmentSlot);
        if (statement.Kind == SourceStorageMutationKindScalar())
        {
            if (!scalarAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ScalarStorageAssignment assignment = scalarAssignments.Get(statement.AssignmentIndex);
            if (!LowerScalarStorageAssignmentWithCallContext(assignment, nodes, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindEnum())
        {
            if (!enumAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack EnumStorageAssignment assignment = enumAssignments.Get(statement.AssignmentIndex);
            if (!LowerEnumStorageAssignmentWithCallContext(assignment, nodes, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindConstructedObjectField())
        {
            if (!fieldAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ConstructedObjectFieldAssignment assignment = fieldAssignments.Get(statement.AssignmentIndex);
            if (!LowerConstructedObjectFieldAssignmentWithCallContext(assignment, nodes, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindArenaDynamicReserve())
        {
            if (!arenaDynamicReserveStatements.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack SwitchArenaDynamicReserveStatement reserve = arenaDynamicReserveStatements.Get(statement.AssignmentIndex);
            if (!LowerSwitchArenaDynamicReserveStatement(reserve, instrs))
            {
                return false;
            }
        }
        else
        {
            return false;
        }

        assignmentIndex = assignmentIndex + 1;
    }

    return true;
}



internal fn bool LowerTerminalIntegerSwitchCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<i64[min max]> caseMaxValues,
    borrow IrTable<ExprParseResult> caseArms,
    ExprParseResult defaultArm,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    bool hasDeclaredReturnType,
    MirType declaredReturnType,
    bool hasEnumReturnType,
    u32[0 max] enumReturnOwnerDeclarationIndex,
    bool usesArenaFrame,
    out LoweredBody body)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseMaxValues.Count() != caseCountWide || caseArms.Count() != caseCountWide)
    {
        return false;
    }

    stack ExprType scrutineeType = TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes);
    if (scrutineeType != ExprType.IntType && scrutineeType != ExprType.EnumType)
    {
        return false;
    }

    stack ExprType defaultType = TypeOfNodeWithLocals(nodes, defaultArm.NodeId, localTypes);
    if (hasEnumReturnType)
    {
        if (defaultType != ExprType.EnumType)
        {
            return false;
        }
    }
    else if (defaultType != ExprType.IntType && defaultType != ExprType.BoolType)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] typeIndex = 0;
    while willexit (typeIndex < caseCountWide)
    {
        stack ExprParseResult caseArm = caseArms.Get((u32[0 max])(typeIndex + 1));
        if (TypeOfNodeWithLocals(nodes, caseArm.NodeId, localTypes) != defaultType)
        {
            return false;
        }

        typeIndex = typeIndex + 1;
    }

    stack u32[0 max] caseCount = (u32[0 max])caseCountWide;
    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] caseReturnBase = firstBlock + caseCount;
    stack u32[0 max] defaultBlockIndex = firstBlock + caseCount + caseCount;

    stack mut IrTable<u32[0 max]> testFirsts = new();
    stack mut IrTable<u32[0 max]> testCounts = new();
    stack mut IrTable<u32[0 max]> conditionValues = new();
    stack mut IrTable<u32[0 max]> caseFirsts = new();
    stack mut IrTable<u32[0 max]> caseCounts = new();
    stack mut IrTable<u32[0 max]> returnValues = new();

    stack MirValueId scrutineeValue = LowerExprNodeWithTypesAndLocals(nodes, scrutineeNode, instrs, localTypes, localOverrides);
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack mut u32[0 max] testFirst = (u32[0 max])instrs.Count() + 1;
        if (caseIndex == 0)
        {
            testFirst = entryFirst;
        }

        stack i64[min max] caseMin = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack i64[min max] caseMax = caseMaxValues.Get((u32[0 max])(caseIndex + 1));
        stack MirValueId condition = LowerIntegerSwitchCaseCondition(instrs, scrutineeValue, caseMin, caseMax);
        stack u32[0 max] testCount = (u32[0 max])instrs.Count() - (testFirst - 1);
        if (testFirsts.Add(testFirst) == 0
            || testCounts.Add(testCount) == 0
            || conditionValues.Add(condition.Index()) == 0)
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack ExprParseResult caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        stack u32[0 max] caseFirst = (u32[0 max])instrs.Count() + 1;
        stack mut MirValueId caseValue = MirValueIdOf(0);
        if (hasEnumReturnType)
        {
            if (!TryLowerEnumReturnExprNodeWithTypesAndLocals(
                nodes,
                caseArm.NodeId,
                instrs,
                localTypes,
                localOverrides,
                enumReturnOwnerDeclarationIndex,
                caseValue))
            {
                return false;
            }
        }
        else
        {
            caseValue = LowerScalarReturnExprNodeWithTypesAndLocals(
                nodes,
                caseArm.NodeId,
                instrs,
                localTypes,
                localOverrides,
                defaultType,
                hasDeclaredReturnType,
                declaredReturnType);
        }

        if (usesArenaFrame)
        {
            stack MirValueId leave = MirArenaFrameLeave(instrs);
        }

        stack u32[0 max] caseInstrCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
        if (caseFirsts.Add(caseFirst) == 0
            || caseCounts.Add(caseInstrCount) == 0
            || returnValues.Add(caseValue.Index()) == 0)
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    stack u32[0 max] defaultFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId defaultValue = MirValueIdOf(0);
    if (hasEnumReturnType)
    {
        if (!TryLowerEnumReturnExprNodeWithTypesAndLocals(
            nodes,
            defaultArm.NodeId,
            instrs,
            localTypes,
            localOverrides,
            enumReturnOwnerDeclarationIndex,
            defaultValue))
        {
            return false;
        }
    }
    else
    {
        defaultValue = LowerScalarReturnExprNodeWithTypesAndLocals(
            nodes,
            defaultArm.NodeId,
            instrs,
            localTypes,
            localOverrides,
            defaultType,
            hasDeclaredReturnType,
            declaredReturnType);
    }

    if (usesArenaFrame)
    {
        stack MirValueId leave = MirArenaFrameLeave(instrs);
    }

    stack u32[0 max] defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] currentBlock = firstBlock + (u32[0 max])caseIndex;
        stack u32[0 max] thenBlock = caseReturnBase + (u32[0 max])caseIndex;
        stack mut u32[0 max] elseBlock = defaultBlockIndex;
        if (caseIndex + 1 < caseCountWide)
        {
            elseBlock = currentBlock + 1;
        }

        stack u32[0 max] conditionValue = conditionValues.Get((u32[0 max])(caseIndex + 1));
        stack MirBlockId testBlock = MirCondBlock(
            blocks,
            MirValueIdOf(conditionValue),
            MirBlockIdOf(thenBlock),
            MirBlockIdOf(elseBlock));
        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] returnValue = returnValues.Get((u32[0 max])(caseIndex + 1));
        stack MirBlockId caseBlock = MirReturnBlock(blocks, MirValueIdOf(returnValue));
        caseIndex = caseIndex + 1;
    }

    stack MirBlockId defaultBlock = MirReturnBlock(blocks, defaultValue);

    if (recordRanges)
    {
        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] testFirst = testFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testCount = testCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testRange = ranges.Add(MakeBlockEmit(
                firstBlock + (u32[0 max])caseIndex,
                testFirst,
                testCount));
            caseIndex = caseIndex + 1;
        }

        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] caseFirst = caseFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRangeCount = caseCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(
                caseReturnBase + (u32[0 max])caseIndex,
                caseFirst,
                caseRangeCount));
            caseIndex = caseIndex + 1;
        }

        stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(defaultBlock.Index(), defaultFirst, defaultCount));
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    stack u32[0 max] firstConditionValue = conditionValues.Get(1);
    stack u32[0 max] firstReturnValue = returnValues.Get(1);
    body.CondValue = firstConditionValue;
    body.ThenValue = firstReturnValue;
    body.ElseValue = defaultValue.Index();
    return true;
}

internal fn bool BuildTerminalSwitchCaptureLocalOverrides(
    MirValueId enumValue,
    u32[0 max] ownerDeclarationIndex,
    borrow IrTable<u32[0 max]> captureVariantOrdinals,
    borrow IrTable<u32[0 max]> capturePayloadOrdinals,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<u32[0 max]> armLocalOverrides)
{
    stack u64[0 2 ** 63 - 1] baseLocalCount = baseLocalTypes.Count();
    stack mut u64[0 2 ** 63 - 1] baseIndex = 0;
    while willexit (baseIndex < baseLocalCount)
    {
        stack u32[0 max] localSlot = (u32[0 max])(baseIndex + 1);
        stack mut u32[0 max] overrideValue = 0;
        if (baseLocalOverrides.Contains(localSlot))
        {
            overrideValue = baseLocalOverrides.Get(localSlot);
        }

        if (armLocalOverrides.Add(overrideValue) == 0)
        {
            return false;
        }

        baseIndex = baseIndex + 1;
    }

    stack TypeId ownerType = TypeIdOf(ownerDeclarationIndex + 1);
    stack mut u32[0 max] captureIndex = 0;
    while willexit (captureIndex < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureIndex;
        if (!captureVariantOrdinals.Contains(captureRow)
            || !capturePayloadOrdinals.Contains(captureRow)
            || !captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] payloadTypeCode = captureTypeCodes.Get(captureRow);
        stack MirType payloadType = MirTypeForResolvedFieldTypeCode(payloadTypeCode);
        stack u32[0 max] variantOrdinal = captureVariantOrdinals.Get(captureRow);
        stack u32[0 max] payloadOrdinal = capturePayloadOrdinals.Get(captureRow);
        stack MirValueId captureValue = MirEnumPayloadExtract(
            instrs,
            ownerType,
            variantOrdinal,
            payloadOrdinal,
            enumValue,
            payloadType);
        if (armLocalOverrides.Add(captureValue.Index()) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    return true;
}

internal fn bool CopySwitchSliceDescriptorLocals(
    borrow IrTable<SourceSliceDescriptorLocal> source,
    mut borrow IrTable<SourceSliceDescriptorLocal> destination)
{
    stack u64[0 2 ** 63 - 1] count = source.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        if (destination.Add(source.Get(i)) == 0)
        {
            return false;
        }

        i = i + 1;
    }

    return true;
}

