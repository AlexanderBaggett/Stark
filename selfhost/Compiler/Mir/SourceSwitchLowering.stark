    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    if (switchCasesAreEnum && payloadCaptureOrdinals.Count() != 0)
    {
        stack mut u64[0 2 ** 63 - 1] validateLocalIndex = 0;
        while willexit (validateLocalIndex < localRoots.Count())
        {
            stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(validateLocalIndex + 1));
            if (localRoot != 0
                && !ValidateModuleCallsForRoot(
                    nodes,
                    localRoot,
                    funcParamCounts,
                    functionCallContractFacts,
                    localTypes,
                    distinctStorageFacts))
            {
                return false;
            }

            validateLocalIndex = validateLocalIndex + 1;
        }

        if (!ValidateModuleCallsForRoot(
                nodes,
                scrutinee.NodeId,
                funcParamCounts,
                functionCallContractFacts,
                localTypes,
                distinctStorageFacts)
            || !ValidateModuleCallsForRoot(
                nodes,
                defaultArm.NodeId,
                funcParamCounts,
                functionCallContractFacts,
                localTypes,
                distinctStorageFacts)
            || casePayloadCaptureStarts.Count() != caseArms.Count()
            || casePayloadCaptureCounts.Count() != caseArms.Count())
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] caseCallIndex = 0;
        while willexit (caseCallIndex < caseArms.Count())
        {
            stack ExprParseResult caseArm = caseArms.Get((u32[0 max])(caseCallIndex + 1));
            stack u32[0 max] captureStart = casePayloadCaptureStarts.Get((u32[0 max])(caseCallIndex + 1));
            stack u32[0 max] captureCount = casePayloadCaptureCounts.Get((u32[0 max])(caseCallIndex + 1));
            stack mut IrTable<u32[0 max]> armLocalTypes = new();
            if (!BuildTerminalSwitchCaptureLocalTypes(
                    payloadCaptureTypeCodes,
                    captureStart,
                    captureCount,
                    localTypes,
                    armLocalTypes)
                || !ValidateModuleCallsForRoot(
                    nodes,
                    caseArm.NodeId,
                    funcParamCounts,
                    functionCallContractFacts,
                    armLocalTypes,
                    distinctStorageFacts))
            {
                return false;
            }

            caseCallIndex = caseCallIndex + 1;
        }
    }
    else if (switchCasesAreListPattern && elementCaptureIndices.Count() != 0)
    {
        stack mut u64[0 2 ** 63 - 1] validateLocalIndex = 0;
        while willexit (validateLocalIndex < localRoots.Count())
        {
            stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(validateLocalIndex + 1));
            if (localRoot != 0
                && !ValidateModuleCallsForRoot(
                    nodes,
                    localRoot,
                    funcParamCounts,
                    functionCallContractFacts,
                    localTypes,
                    distinctStorageFacts))
            {
                return false;
            }

            validateLocalIndex = validateLocalIndex + 1;
        }

        if (!ValidateModuleCallsForRootWithSlices(
                nodes,
                scrutinee.NodeId,
                funcParamCounts,
                functionCallContractFacts,
                localTypes,
                sliceDescriptorLocals,
                distinctStorageFacts)
            || !ValidateModuleCallsForRootWithSlices(
                nodes,
                defaultArm.NodeId,
                funcParamCounts,
                functionCallContractFacts,
                localTypes,
                sliceDescriptorLocals,
                distinctStorageFacts)
            || caseElementCaptureStarts.Count() != caseArms.Count()
            || caseElementCaptureCounts.Count() != caseArms.Count())
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] caseCallIndex = 0;
        while willexit (caseCallIndex < caseArms.Count())
        {
            stack mut u32[0 max] guardNode = 0;
            if (caseGuardNodes.Count() != 0)
            {
                guardNode = caseGuardNodes.Get((u32[0 max])(caseCallIndex + 1));
            }

            stack ExprParseResult caseArm = caseArms.Get((u32[0 max])(caseCallIndex + 1));
            stack u32[0 max] captureStart = caseElementCaptureStarts.Get((u32[0 max])(caseCallIndex + 1));
            stack u32[0 max] captureCount = caseElementCaptureCounts.Get((u32[0 max])(caseCallIndex + 1));
            stack mut IrTable<u32[0 max]> armLocalTypes = new();
            stack mut IrTable<SourceSliceDescriptorLocal> armSliceDescriptorLocals = new();
            if (!BuildTerminalSwitchCaptureLocalTypes(
                    elementCaptureTypeCodes,
                    captureStart,
                    captureCount,
                    localTypes,
                    armLocalTypes)
                || !BuildTerminalFixedArraySwitchCaptureSliceDescriptorLocals(
                    fixedArrayParamIndex,
                    fixedArrayFacts,
                    useFixedArrayStorageLocal,
                    elementCaptureIndices,
                    elementCaptureTypeCodes,
                    captureStart,
                    captureCount,
                    localTypes,
                    sliceDescriptorLocals,
                    armSliceDescriptorLocals))
            {
                return false;
            }

            if (guardNode != 0
                && !ValidateModuleCallsForRootWithSlices(
                    nodes,
                    guardNode,
                    funcParamCounts,
                    functionCallContractFacts,
                    armLocalTypes,
                    armSliceDescriptorLocals,
                    distinctStorageFacts))
            {
                return false;
            }

            if (!ValidateModuleCallsForRootWithSlices(
                    nodes,
                    caseArm.NodeId,
                    funcParamCounts,
                    functionCallContractFacts,
                    armLocalTypes,
                    armSliceDescriptorLocals,
                    distinctStorageFacts))
            {
                return false;
            }

            caseCallIndex = caseCallIndex + 1;
        }
    }
    else if (switchCasesAreStructAggregate && structFieldCaptureIndices.Count() != 0)
    {
        stack mut u64[0 2 ** 63 - 1] validateLocalIndex = 0;
        while willexit (validateLocalIndex < localRoots.Count())
        {
            stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(validateLocalIndex + 1));
            if (localRoot != 0
                && !ValidateModuleCallsForRoot(
                    nodes,
                    localRoot,
                    funcParamCounts,
                    functionCallContractFacts,
                    localTypes,
                    distinctStorageFacts))
            {
                return false;
            }

            validateLocalIndex = validateLocalIndex + 1;
        }

        if (!ValidateModuleCallsForRoot(
                nodes,
                scrutinee.NodeId,
                funcParamCounts,
                functionCallContractFacts,
                localTypes,
                distinctStorageFacts)
            || !ValidateModuleCallsForRoot(
                nodes,
                defaultArm.NodeId,
                funcParamCounts,
                functionCallContractFacts,
                localTypes,
                distinctStorageFacts)
            || caseStructFieldCaptureStarts.Count() != caseArms.Count()
            || caseStructFieldCaptureCounts.Count() != caseArms.Count())
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] caseCallIndex = 0;
        while willexit (caseCallIndex < caseArms.Count())
        {
            stack mut u32[0 max] guardNode = 0;
            if (caseGuardNodes.Count() != 0)
            {
                guardNode = caseGuardNodes.Get((u32[0 max])(caseCallIndex + 1));
            }

            stack ExprParseResult caseArm = caseArms.Get((u32[0 max])(caseCallIndex + 1));
            stack u32[0 max] captureStart = caseStructFieldCaptureStarts.Get((u32[0 max])(caseCallIndex + 1));
            stack u32[0 max] captureCount = caseStructFieldCaptureCounts.Get((u32[0 max])(caseCallIndex + 1));
            stack mut IrTable<u32[0 max]> armLocalTypes = new();
            if (!BuildTerminalSwitchCaptureLocalTypes(
                    structFieldCaptureTypeCodes,
                    captureStart,
                    captureCount,
                    localTypes,
                    armLocalTypes)
                || (guardNode != 0
                    && !ValidateModuleCallsForRoot(
                        nodes,
                        guardNode,
                        funcParamCounts,
                        functionCallContractFacts,
                        armLocalTypes,
                        distinctStorageFacts))
                || !ValidateModuleCallsForRoot(
                    nodes,
                    caseArm.NodeId,
                    funcParamCounts,
                    functionCallContractFacts,
                    armLocalTypes,
                    distinctStorageFacts))
            {
                return false;
            }

            caseCallIndex = caseCallIndex + 1;
        }
    }
    else if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);

    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] p = 0;
    while willexit (p < signatureParamCount)
    {
        stack u32[0 max] zero = localOverrides.Add(0);
        p = p + 1;
    }

    stack u64[0 2 ** 63 - 1] localCount = localRoots.Count();
    stack mut u64[0 2 ** 63 - 1] v = 0;
    stack mut u32[0 max] nextStackObjectInitializer = 1;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    while willexit (v < localCount)
    {
        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(v + 1));
        if (localRoot == 0)
        {
            stack mut u32[0 max] storageOverride = 0;
            if (localOverrideValues.Contains((u32[0 max])(v + 1)))
            {
                storageOverride = localOverrideValues.Get((u32[0 max])(v + 1));
            }

            if (localOverrides.Add(storageOverride) == 0)
            {
                return false;
            }
        }
        else
        {
            stack MirValueId varValue = LowerExprNodeWithTypesAndLocals(nodes, localRoot, instrs, localTypes, localOverrides);
            if (localOverrides.Add(varValue.Index()) == 0)
            {
                return false;
            }
        }

        nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
            fixedArrayStorageInitializers,
            (u32[0 max])(v + 1),
            nextFixedArrayStorageInitializer,
            nodes,
            instrs,
            localTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
            stackObjectFieldInitializers,
            (u32[0 max])(v + 1),
            nextStackObjectInitializer,
            nodes,
            instrs,
            localTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        v = v + 1;
    }

    if ((u64[0 2 ** 63 - 1])(nextStackObjectInitializer - 1) != stackObjectFieldInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return false;
    }

    if (switchCasesAreBoolean)
    {
        return LowerTerminalBooleanSwitchCasesToBlocks(
            nodes,
            scrutinee.NodeId,
            booleanCaseValues,
            caseArms,
            defaultArm,
            localTypes,
            localOverrides,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            hasDeclaredReturnType,
            declaredReturnType,
            hasEnumReturnType,
            enumReturnOwnerDeclarationIndex,
            usesArenaFrame,
            body);
    }

    if (switchCasesAreListPattern)
    {
        return LowerTerminalFixedArrayListSwitchCasesToBlocks(
            nodes,
            fixedArrayParamIndex,
            fixedArrayFacts,
            true,
            fixedArrayLocal,
            caseArms,
            casePatternStarts,
            casePatternCounts,
            caseGuardNodes,
            elementPatternIndices,
            elementPatternTypeCodes,
            elementPatternKinds,
            elementPatternMinValues,
            elementPatternMaxValues,
            caseElementCaptureStarts,
            caseElementCaptureCounts,
            elementCaptureIndices,
            elementCaptureTypeCodes,
            defaultArm,
            localTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            hasDeclaredReturnType,
            declaredReturnType,
            hasEnumReturnType,
            enumReturnOwnerDeclarationIndex,
            usesArenaFrame,
            body);
    }

    if (switchCasesAreStructAggregate)
    {
        return LowerTerminalStructAggregateSwitchCasesToBlocks(
            nodes,
            structParamIndex,
            structTypeToken,
            structBaseByteOffset,
            useStructValueParam,
            structValueFacts,
            moduleFacts,
            caseArms,
            casePatternStarts,
            casePatternCounts,
            caseStructFieldCaptureStarts,
            caseStructFieldCaptureCounts,
            caseGuardNodes,
            structFieldPatternIndices,
            structFieldPatternOffsets,
            structFieldPatternAlignments,
            structFieldPatternTypeCodes,
            structFieldPatternMemberFactRows,
            structFieldPatternKinds,
            structFieldPatternMinValues,
            structFieldPatternMaxValues,
            structFieldCaptureIndices,
            structFieldCaptureOffsets,
            structFieldCaptureAlignments,
            structFieldCaptureTypeCodes,
            structFieldCaptureMemberFactRows,
            defaultArm,
            localTypes,
            localOverrides,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            hasDeclaredReturnType,
            declaredReturnType,
            hasEnumReturnType,
            enumReturnOwnerDeclarationIndex,
            usesArenaFrame,
            body);
    }

    if (switchCasesAreEnum && (payloadPatternOrdinals.Count() != 0 || payloadCaptureOrdinals.Count() != 0))
    {
        return LowerTerminalEnumSwitchCasesWithPayloadPatternsToBlocks(
            nodes,
            scrutinee.NodeId,
            caseOwnerDeclarationIndex,
            moduleFacts,
            caseValues,
            caseArms,
            casePayloadPatternStarts,
            casePayloadPatternCounts,
            casePayloadCaptureStarts,
            casePayloadCaptureCounts,
            payloadPatternVariantOrdinals,
            payloadPatternOrdinals,
            payloadPatternTypeCodes,
            payloadPatternKinds,
            payloadPatternMinValues,
            payloadPatternMaxValues,
            payloadCaptureVariantOrdinals,
            payloadCaptureOrdinals,
            payloadCaptureTypeCodes,
            defaultArm,
            localTypes,
            localOverrides,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            hasDeclaredReturnType,
            declaredReturnType,
            hasEnumReturnType,
            enumReturnOwnerDeclarationIndex,
            usesArenaFrame,
            body);
    }

    return LowerTerminalIntegerSwitchCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        caseArms,
        defaultArm,
        localTypes,
        localOverrides,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        hasDeclaredReturnType,
        declaredReturnType,
        hasEnumReturnType,
        enumReturnOwnerDeclarationIndex,
        usesArenaFrame,
        body);
}


internal fn bool EmitModuleTerminalIntegerSwitchFunction(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    bool isTailCallable,
    u64[0 2 ** 63 - 1] fnIndex,
    u32[0 max] functionNumber,
    mut borrow OwnedAscii sink)
    where overlap(sourceText, source)
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<BlockEmit> ranges = new();
    stack mut LoweredBody body = new();
    if (!LowerModuleTerminalSwitchFunctionToBlocks(
        sourceText,
        stream,
        source,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        true,
        body))
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> paramFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, paramFacts))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack ValueFacts returnFacts = FunctionReturnRangeFact(stream, source, signature);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    if (!ValidateBlockReturnRangeFacts(returnFacts, blocks, valueFacts))
    {
        return false;
    }

    stack FunctionEffectFacts functionEffects = FunctionEffectFactsAt(functionEffectFacts, functionNumber);

    switch (EmitLlvmBlocksNumberedWithRangeFactsCore(
        instrs,
        funcTailFlags,
        functionEffectFacts,
        functionCallContractFacts,
        functionLinkageFacts,
        functionCallingConventionFacts,
        blocks,
        "f",
        functionNumber,
        isTailCallable,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        distinctStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        functionEffects,
        body.ParamCount,
        ranges,
        sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

internal fn bool EmitModuleLocalSwitchStatementFunction(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    bool isTailCallable,
    u64[0 2 ** 63 - 1] fnIndex,
    u32[0 max] functionNumber,
    mut borrow OwnedAscii sink)
    where overlap(sourceText, source)
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<BlockEmit> ranges = new();
    stack mut LoweredBody body = new();
    if (!LowerModuleLocalSwitchStatementFunctionToBlocks(
        sourceText,
        stream,
        source,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        true,
        body))
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> paramFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, paramFacts))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack ValueFacts returnFacts = FunctionReturnRangeFact(stream, source, signature);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    if (!ValidateBlockReturnRangeFacts(returnFacts, blocks, valueFacts))
    {
        return false;
    }

    stack FunctionEffectFacts functionEffects = FunctionEffectFactsAt(functionEffectFacts, functionNumber);

    switch (EmitLlvmBlocksNumberedWithRangeFactsCore(
        instrs,
        funcTailFlags,
        functionEffectFacts,
        functionCallContractFacts,
        functionLinkageFacts,
        functionCallingConventionFacts,
        blocks,
        "f",
        functionNumber,
        isTailCallable,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        distinctStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        functionEffects,
        body.ParamCount,
        ranges,
        sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

