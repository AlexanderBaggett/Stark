    stack mut ExprParseResult resolvedScrutinee = new();
    stack mut FixedArrayStorageLocal resolvedFixedArrayLocal = new();
    stack mut ParamAbiFacts resolvedFixedArrayFacts = new();
    if (closeParen == (u32[0 max])(switchIndex + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace
        || !TryResolveFixedArrayFieldSwitchScrutineeFacts(
