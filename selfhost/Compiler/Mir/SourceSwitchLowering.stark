    scrutinee = new();
    fixedArrayParamIndex = 0;
    fixedArrayFacts = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
