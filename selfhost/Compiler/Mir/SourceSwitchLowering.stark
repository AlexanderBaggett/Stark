module Compiler.Mir.SourceSwitchLowering

internal fn bool FunctionBodyHasLocalPrefixedTerminalSwitch(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (cursor >= limit || !TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        return false;
    }

    while willexit (cursor < limit && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        if (stream.KindAt(cursor) != TokenKind.Var)
        {
            stack TokenKind localStorage = stream.KindAt(cursor);
            if (localStorage != TokenKind.Stack && localStorage != TokenKind.Heap)
            {
                return false;
            }

            stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
            stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
            stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
            stack mut u32[0 max] fixedArrayLength = 0;
            if (localStorage == TokenKind.Stack
                && typeToken != 0
                && TryReadFixedArrayLengthSuffix(stream, source, typeToken, fixedArrayLength))
            {
                if (!hasAssign || stream.KindAt(assignToken + 1) != TokenKind.LBrace)
                {
                    return false;
                }

                stack u32[0 max] initializerClose = MatchingBraceForMirLowering(stream, (u32[0 max])(assignToken + 1));
                if (initializerClose == (u32[0 max])(assignToken + 1)
                    || (u64[0 2 ** 63 - 1])initializerClose + 1 != statementEnd)
                {
                    return false;
                }

                cursor = statementEnd + 1;
                continue;
            }

            stack mut u32[0 max] dynamicCapacity = 0;
            stack mut u32[0 max] dynamicAlignment = 0;
            if (localStorage == TokenKind.Stack
                && FindSelfHostedDynamicElementTypeToken(stream, cursor, statementEnd) != 0
                && TryParseArenaSelectorCapacity(stream, source, cursor, statementEnd, dynamicCapacity, dynamicAlignment))
            {
                cursor = statementEnd + 1;
                continue;
            }

            stack mut u32[0 max] bodyOpen = 0;
            stack mut u32[0 max] bodyClose = 0;
            stack mut u32[0 max] argsOpen = 0;
            stack mut u32[0 max] argsClose = 0;
            if (hasAssign
                && typeToken != 0
                && (TryParseTargetTypedObjectConstructorShape(stream, source, typeToken, assignToken, statementEnd, bodyOpen, bodyClose)
                    || TryParseTargetTypedPositionalRecordConstructorShape(stream, source, typeToken, assignToken, statementEnd, argsOpen, argsClose)))
            {
                cursor = statementEnd + 1;
                continue;
            }

            stack mut u32[0 max] enumOwnerDeclarationIndex = 0;
            stack mut Compiler.Parsing.DeclItem enumItem = new();
            if (localStorage == TokenKind.Stack
                && hasAssign
                && typeToken != 0
                && TryGetSourceEnumOwnerDeclarationForToken(stream, source, moduleFacts, typeToken, enumOwnerDeclarationIndex, enumItem))
            {
                cursor = statementEnd + 1;
                continue;
            }

            return false;
        }

        cursor = statementEnd + 1;
    }

    return cursor < limit && stream.KindAt(cursor) == TokenKind.Switch;
}

internal fn bool FunctionBodyStartsWithLocalSwitchStatementAssignment(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> targetNameTokens = new();
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut bool skippedListStorageSetupLocal = false;
    while willexit (cursor < limit && (stream.KindAt(cursor) == TokenKind.Stack || stream.KindAt(cursor) == TokenKind.Heap))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(cursor);
        stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
        stack mut u32[0 max] fixedArrayLength = 0;
        if (localStorage == TokenKind.Stack
            && typeToken != 0
            && TryReadFixedArrayLengthSuffix(stream, source, typeToken, fixedArrayLength))
        {
            if (fixedArrayLength == 0
                || !hasAssign
                || stream.KindAt(assignToken + 1) != TokenKind.LBrace)
            {
                return false;
            }

            stack u32[0 max] initializerClose = MatchingBraceForMirLowering(stream, (u32[0 max])(assignToken + 1));
            if (initializerClose == (u32[0 max])(assignToken + 1)
                || (u64[0 2 ** 63 - 1])initializerClose + 1 != statementEnd)
            {
                return false;
            }

            skippedListStorageSetupLocal = true;
            cursor = statementEnd + 1;
            continue;
        }

        stack mut u32[0 max] bodyOpen = 0;
        stack mut u32[0 max] bodyClose = 0;
        stack mut u32[0 max] argsOpen = 0;
        stack mut u32[0 max] argsClose = 0;
        if (hasAssign
            && typeToken != 0
            && (TryParseTargetTypedObjectConstructorShape(stream, source, typeToken, assignToken, statementEnd, bodyOpen, bodyClose)
                || TryParseTargetTypedPositionalRecordConstructorShape(stream, source, typeToken, assignToken, statementEnd, argsOpen, argsClose)))
        {
            if (localStorage == TokenKind.Heap && signature.LawKind())
            {
                return false;
            }

            skippedListStorageSetupLocal = true;
            cursor = statementEnd + 1;
            continue;
        }

        return false;
    }

    if (cursor >= limit || stream.KindAt(cursor) != TokenKind.Var)
    {
        return false;
    }

    while willexit (cursor < limit && stream.KindAt(cursor) == TokenKind.Var)
    {
        stack mut u64[0 2 ** 63 - 1] localEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, localEnd))
        {
            return false;
        }

        stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, localEnd);
        if (localNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0
            || TokenTextExistsInTokenTable(stream, source, targetNameTokens, localNameToken))
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] assignToken = localEnd;
        if (!FindSelfHostedStatementAssign(stream, cursor, localEnd, assignToken))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
        stack ExprParseResult initResult = ParseExprIn(stream, source, nodes, params, funcNames, assignToken + 1);
        if (initResult.Next != localEnd
            || params.Count() != beforeInit
            || !ExprNodeCanBeDiscardedIfOverwritten(nodes, initResult.NodeId))
        {
            return false;
        }

        if (targetNameTokens.Add(localNameToken) == 0)
        {
            return false;
        }

        cursor = localEnd + 1;
    }

    if (targetNameTokens.Count() == 0 || cursor >= limit || stream.KindAt(cursor) != TokenKind.Switch)
    {
        return false;
    }

    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<i64[min max]> caseMaxValues = new();
    stack mut IrTable<u32[0 max]> booleanCaseValues = new();
    stack mut IrTable<ParsedSwitchAssignmentArm> caseArms = new();
    stack mut IrTable<u32[0 max]> casePayloadPatternStarts = new();
    stack mut IrTable<u32[0 max]> casePayloadPatternCounts = new();
    stack mut IrTable<u32[0 max]> payloadPatternVariantOrdinals = new();
    stack mut IrTable<u32[0 max]> payloadPatternOrdinals = new();
    stack mut IrTable<u32[0 max]> payloadPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> payloadPatternKinds = new();
    stack mut IrTable<i64[min max]> payloadPatternMinValues = new();
    stack mut IrTable<i64[min max]> payloadPatternMaxValues = new();
    stack mut u32[0 max] fixedArrayParamIndex = 0;
    stack mut ParamAbiFacts fixedArrayFacts = new();
    stack mut IrTable<u32[0 max]> casePatternStarts = new();
    stack mut IrTable<u32[0 max]> casePatternCounts = new();
    stack mut IrTable<u32[0 max]> caseGuardNodes = new();
    stack mut IrTable<u32[0 max]> elementPatternIndices = new();
    stack mut IrTable<u32[0 max]> elementPatternTypeCodes = new();
    stack mut IrTable<u32[0 max]> elementPatternKinds = new();
    stack mut IrTable<i64[min max]> elementPatternMinValues = new();
    stack mut IrTable<i64[min max]> elementPatternMaxValues = new();
    stack mut IrTable<u32[0 max]> caseElementCaptureStarts = new();
    stack mut IrTable<u32[0 max]> caseElementCaptureCounts = new();
    stack mut IrTable<u32[0 max]> elementCaptureIndices = new();
    stack mut IrTable<u32[0 max]> elementCaptureTypeCodes = new();
    stack mut IrTable<u32[0 max]> elementCaptureNameTokens = new();
    stack mut IrTable<u32[0 max]> armLocalRoots = new();
    stack mut IrTable<u32[0 max]> assignedRoots = new();
    stack mut IrTable<u32[0 max]> assignedTargetOffsets = new();
    stack mut ParsedSwitchAssignmentArm defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (SwitchFirstCaseLabelLooksQualifiedName(stream, cursor))
    {
        return true;
    }

    if (SwitchFirstCaseLabelIsBoolean(stream, cursor))
    {
        if (!TryParseBooleanSwitchAssignmentCases(
            stream,
            source,
            nodes,
            params,
            funcNames,
            cursor,
            targetNameTokens,
            signatureParamCount,
            scrutinee,
            booleanCaseValues,
            caseArms,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            defaultArm,
            nextToken))
        {
            return false;
        }
    }
    else if (SwitchFirstCaseLabelIsListPattern(stream, cursor))
    {
        if (skippedListStorageSetupLocal)
        {
            return true;
        }

        stack mut SourceModuleLoweringFacts emptyModuleFacts = new();
        stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
        if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts)
            || !TryParseFixedArrayListSwitchAssignmentCases(
                stream,
                source,
                emptyModuleFacts,
                false,
                paramAbiFacts,
                nodes,
                params,
                funcNames,
                cursor,
                targetNameTokens,
                signatureParamCount,
                scrutinee,
                fixedArrayParamIndex,
                fixedArrayFacts,
                caseArms,
                casePatternStarts,
                casePatternCounts,
                caseGuardNodes,
                elementPatternIndices,
                elementPatternTypeCodes,
                elementPatternKinds,
                elementPatternMinValues,
                elementPatternMaxValues,
                caseElementCaptureStarts,
                caseElementCaptureCounts,
                elementCaptureIndices,
                elementCaptureTypeCodes,
                elementCaptureNameTokens,
                armLocalRoots,
                assignedRoots,
                assignedTargetOffsets,
                defaultArm,
                nextToken))
        {
            return false;
        }
    }
    else if (!TryParseIntegerSwitchAssignmentCases(
        stream,
        source,
        nodes,
        params,
        funcNames,
        cursor,
        targetNameTokens,
        signatureParamCount,
        scrutinee,
        caseValues,
        caseMaxValues,
        caseArms,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        defaultArm,
        nextToken))
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut u32[0 max] switchCaseCount = (u32[0 max])caseValues.Count();
    if (SwitchFirstCaseLabelIsBoolean(stream, cursor))
    {
        switchCaseCount = (u32[0 max])booleanCaseValues.Count();
    }
    else if (SwitchFirstCaseLabelIsListPattern(stream, cursor))
    {
        switchCaseCount = (u32[0 max])casePatternStarts.Count();
    }

    stack mut u64[0 2 ** 63 - 1] targetIndex = 0;
    while willexit (targetIndex < targetNameTokens.Count())
    {
        stack u32[0 max] targetNameToken = targetNameTokens.Get((u32[0 max])(targetIndex + 1));
        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])targetNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])targetNameToken);
        if (ResolveParam(params, source, nameStart, nameLength) != (u32[0 max])(signatureParamCount + targetIndex))
        {
            return false;
        }

        if (!UpdateSwitchAssignmentTargetRawPointerFacts(
            params,
            nodes,
            caseArms,
            assignedRoots,
            assignedTargetOffsets,
            defaultArm,
            (u32[0 max])(signatureParamCount + targetIndex),
            (u32[0 max])targetIndex,
            switchCaseCount))
        {
            return false;
        }

        targetIndex = targetIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] returnIndex = nextToken;
    stack mut u64[0 2 ** 63 - 1] expectedParamCount = signatureParamCount + targetNameTokens.Count();
    while willexit (returnIndex < limit && stream.KindAt(returnIndex) == TokenKind.Var)
    {
        stack mut u64[0 2 ** 63 - 1] postLocalEnd = returnIndex;
        if (!FindSelfHostedStatementEnd(stream, returnIndex, limit, postLocalEnd))
        {
            return false;
        }

        stack u32[0 max] postLocalNameToken = FindSelfHostedLocalNameToken(stream, returnIndex, postLocalEnd);
        if (postLocalNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] postNameStart = stream.StartAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        stack u64[0 2 ** 63 - 1] postNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])postLocalNameToken);
        if (ParamIndexOf(params, source, postNameStart, postNameLength) >= 0)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] postAssignToken = postLocalEnd;
        if (!FindSelfHostedStatementAssign(stream, returnIndex, postLocalEnd, postAssignToken))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforePostLocal = params.Count();
        stack ExprParseResult postLocalRoot = ParseExprIn(stream, source, nodes, params, funcNames, postAssignToken + 1);
        if (postLocalRoot.Next != postLocalEnd || params.Count() != beforePostLocal)
        {
            return false;
        }

        if (ResolveParam(params, source, postNameStart, postNameLength) != (u32[0 max])expectedParamCount)
        {
            return false;
        }

        returnIndex = postLocalEnd + 1;
        expectedParamCount = expectedParamCount + 1;
    }

    if (returnIndex >= limit)
    {
        return false;
    }

    if (stream.KindAt(returnIndex) == TokenKind.Return)
    {
        stack ExprParseResult returnRoot = ParseExprIn(stream, source, nodes, params, funcNames, returnIndex + 1);
        stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
        if (stream.KindAt(afterReturn) == TokenKind.Semi)
        {
            afterReturn = afterReturn + 1;
        }

        return stream.KindAt(afterReturn) == TokenKind.RBrace
            && params.Count() == expectedParamCount;
    }

    if (stream.KindAt(returnIndex) == TokenKind.If)
    {
        stack mut ParsedIfReturnArms tailArms = new();
        if (!TryParseTerminalIfReturnArms(stream, source, nodes, params, funcNames, returnIndex, tailArms)
            || tailArms.ThenBecome
            || tailArms.ElseBecome)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] afterIf = tailArms.ElseArm.Next;
        return stream.KindAt(afterIf) == TokenKind.RBrace
            && params.Count() == expectedParamCount;
    }

    return false;
}

internal fn bool LowerModuleTerminalSwitchFunctionToBlocks(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    if (!BuildSourceModuleLoweringFacts(sourceText, stream, source, moduleFacts))
    {
        return false;
    }

    if (FunctionTerminalSwitchFirstCaseHasSiblingAlternatives(stream, fnIndex))
    {
        return LowerModuleTerminalIntegerSwitchFunctionToBlocks(
            stream,
            source,
            moduleFacts,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            fnIndex,
            instrs,
            blocks,
            ranges,
            recordRanges,
            body);
    }

    if (LowerModuleTerminalBooleanSwitchFunctionToBlocks(
        stream,
        source,
        moduleFacts,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body))
    {
        return true;
    }

    if (LowerModuleTerminalEnumSwitchFunctionToBlocks(
        sourceText,
        stream,
        source,
        moduleFacts,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body))
    {
        return true;
    }

    if (LowerModuleTerminalFixedArrayListSwitchFunctionToBlocks(
        stream,
        source,
        moduleFacts,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body))
    {
        return true;
    }

    return LowerModuleTerminalIntegerSwitchFunctionToBlocks(
        stream,
        source,
        moduleFacts,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        body);
}

internal fn bool LowerModuleLocalSwitchStatementFunctionToBlocks(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
    where overlap(sourceText, source)
{
    body = new();
    if (!FunctionBodyStartsWithLocalSwitchStatementAssignment(stream, source, funcNames, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localRoots = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut IrTable<FixedArrayStorageLocal> fixedArrayStorageLocals = new();
    stack mut IrTable<FixedArrayStorageInitializer> fixedArrayStorageInitializers = new();
    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    stack mut IrTable<u32[0 max]> localOverrideValues = new();
    stack mut IrTable<StackObjectFieldInitializer> stackObjectFieldInitializers = new();
    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    stack mut bool setupLocalTypesSeeded = false;
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    stack mut bool moduleFactsBuilt = false;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> targetNameTokens = new();
    stack mut IrTable<u32[0 max]> targetInitRoots = new();
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut bool setupNeedsModuleFacts = false;
    stack mut u64[0 2 ** 63 - 1] setupScanCursor = cursor;
    while willexit (setupScanCursor < limit && (stream.KindAt(setupScanCursor) == TokenKind.Stack || stream.KindAt(setupScanCursor) == TokenKind.Heap))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = setupScanCursor;
        if (!FindSelfHostedStatementEnd(stream, setupScanCursor, limit, statementEnd))
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(setupScanCursor);
        stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, setupScanCursor, statementEnd);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, setupScanCursor, statementEnd, assignToken);
        stack mut u32[0 max] bodyOpen = 0;
        stack mut u32[0 max] bodyClose = 0;
        stack mut u32[0 max] argsOpen = 0;
        stack mut u32[0 max] argsClose = 0;
        if ((localStorage == TokenKind.Stack || localStorage == TokenKind.Heap)
            && hasAssign
            && typeToken != 0
