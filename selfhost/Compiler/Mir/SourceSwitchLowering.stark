internal fn bool TryParseTerminalSwitchIntegerCaseLabel(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] valueStart,
    out i64[min max] value,
    out u64[0 2 ** 63 - 1] nextToken)
{
    value = 0;
    nextToken = valueStart;
    stack TokenKind kind = stream.KindAt(valueStart);
    if (kind == TokenKind.IntegerLiteral)
    {
        value = ParseDigitSpan(source, stream.StartAt(valueStart), stream.LengthAt(valueStart));
        nextToken = valueStart + 1;
        return true;
    }

    if (kind == TokenKind.Minus && stream.KindAt(valueStart + 1) == TokenKind.IntegerLiteral)
    {
        value = 0 - ParseDigitSpan(source, stream.StartAt(valueStart + 1), stream.LengthAt(valueStart + 1));
        nextToken = valueStart + 2;
        return true;
    }

    return false;
}

internal fn bool TryParseTerminalSwitchIntegerCaseInterval(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] valueStart,
    out i64[min max] minValue,
    out i64[min max] maxValue,
    out u64[0 2 ** 63 - 1] nextToken)
{
    minValue = 0;
    maxValue = 0;
    nextToken = valueStart;
    stack mut i64[min max] first = 0;
    stack mut u64[0 2 ** 63 - 1] afterFirst = valueStart;
    if (!TryParseTerminalSwitchIntegerCaseLabel(stream, source, valueStart, first, afterFirst))
    {
        return false;
    }

    if (stream.KindAt(afterFirst) == TokenKind.Range)
    {
        stack mut i64[min max] last = 0;
        stack mut u64[0 2 ** 63 - 1] afterLast = afterFirst + 1;
        if (!TryParseTerminalSwitchIntegerCaseLabel(stream, source, afterFirst + 1, last, afterLast)
            || first > last)
        {
            return false;
        }

        minValue = first;
        maxValue = last;
        nextToken = afterLast;
        return true;
    }

    minValue = first;
    maxValue = first;
    nextToken = afterFirst;
    return true;
}

internal fn bool TryParseTerminalSwitchBooleanCaseLabel(
    borrow TokenStream stream,
    u64[0 2 ** 63 - 1] valueStart,
    out u32[0 max] value,
    out u64[0 2 ** 63 - 1] nextToken)
{
    value = 0;
    nextToken = valueStart;
    stack TokenKind kind = stream.KindAt(valueStart);
    if (kind == TokenKind.True)
    {
        value = 1;
        nextToken = valueStart + 1;
        return true;
    }

    if (kind == TokenKind.False)
    {
        value = 0;
        nextToken = valueStart + 1;
        return true;
    }

    return false;
}

internal fn bool TerminalSwitchCaseIntervalOverlaps(
    borrow IrTable<i64[min max]> caseMinValues,
    borrow IrTable<i64[min max]> caseMaxValues,
    i64[min max] minValue,
    i64[min max] maxValue)
{
    stack u64[0 2 ** 63 - 1] count = caseMinValues.Count();
    if (caseMaxValues.Count() != count)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack i64[min max] currentMin = caseMinValues.Get((u32[0 max])(i + 1));
        stack i64[min max] currentMax = caseMaxValues.Get((u32[0 max])(i + 1));
        if (!(maxValue < currentMin || minValue > currentMax))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool CopyCaseValuesToCaseMaxValues(
    borrow IrTable<i64[min max]> caseValues,
    mut borrow IrTable<i64[min max]> caseMaxValues)
{
    stack mut u64[0 2 ** 63 - 1] index = 0;
    stack u64[0 2 ** 63 - 1] count = caseValues.Count();
    while willexit (index < count)
    {
        stack i64[min max] value = caseValues.Get((u32[0 max])(index + 1));
        if (caseMaxValues.Add(value) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn MirValueId LowerIntegerSwitchCaseCondition(
    mut borrow IrTable<MirInstruction> instrs,
    MirValueId scrutineeValue,
    i64[min max] minValue,
    i64[min max] maxValue)
{
    if (minValue == maxValue)
    {
        stack MirValueId caseConstant = MirConstInt(instrs, minValue);
        return LowerComparison(instrs, TokenKind.EqEq, scrutineeValue, caseConstant);
    }

    stack MirValueId lowerConstant = MirConstInt(instrs, minValue);
    stack MirValueId lowerCondition = LowerComparison(instrs, TokenKind.Gte, scrutineeValue, lowerConstant);
    stack MirValueId upperConstant = MirConstInt(instrs, maxValue);
    stack MirValueId upperCondition = LowerComparison(instrs, TokenKind.Lte, scrutineeValue, upperConstant);
    return MirAndTyped(instrs, MirType.I1, lowerCondition, upperCondition);
}

internal fn MirValueId LowerIntegerSwitchCaseConditionTyped(
    mut borrow IrTable<MirInstruction> instrs,
    MirValueId scrutineeValue,
    i64[min max] minValue,
    i64[min max] maxValue,
    MirType type)
{
    if (minValue == maxValue)
    {
        stack MirValueId caseConstant = MirConstIntTyped(instrs, type, minValue);
        return LowerComparison(instrs, TokenKind.EqEq, scrutineeValue, caseConstant);
    }

    stack MirValueId lowerConstant = MirConstIntTyped(instrs, type, minValue);
    stack MirValueId lowerCondition = LowerComparison(instrs, TokenKind.Gte, scrutineeValue, lowerConstant);
    stack MirValueId upperConstant = MirConstIntTyped(instrs, type, maxValue);
    stack MirValueId upperCondition = LowerComparison(instrs, TokenKind.Lte, scrutineeValue, upperConstant);
    return MirAndTyped(instrs, MirType.I1, lowerCondition, upperCondition);
}

internal fn bool TryLowerEnumSwitchPayloadCaseCondition(
    mut borrow IrTable<MirInstruction> instrs,
    MirValueId enumValue,
    MirValueId tagValue,
    u32[0 max] ownerDeclarationIndex,
    MirType tagType,
    i64[min max] expectedTagValue,
    u32[0 max] payloadPatternStart,
    u32[0 max] payloadPatternCount,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternTypeCodes,
    borrow IrTable<u32[0 max]> payloadPatternKinds,
    borrow IrTable<i64[min max]> payloadPatternMinValues,
    borrow IrTable<i64[min max]> payloadPatternMaxValues,
    out MirValueId condition)
{
    stack mut MirValueId currentCondition = LowerIntegerSwitchCaseConditionTyped(instrs, tagValue, expectedTagValue, expectedTagValue, tagType);
    stack TypeId ownerType = TypeIdOf(ownerDeclarationIndex + 1);
    stack mut u32[0 max] offset = 0;
    while willexit (offset < payloadPatternCount)
    {
        stack u32[0 max] row = payloadPatternStart + offset;
        if (!payloadPatternVariantOrdinals.Contains(row)
            || !payloadPatternOrdinals.Contains(row)
            || !payloadPatternTypeCodes.Contains(row)
            || !payloadPatternKinds.Contains(row)
            || !payloadPatternMinValues.Contains(row)
            || !payloadPatternMaxValues.Contains(row))
        {
            return false;
        }

        stack u32[0 max] patternKind = payloadPatternKinds.Get(row);
        if (patternKind != SourceSwitchEnumPayloadPatternKindScalarInterval())
        {
            return false;
        }

        stack u32[0 max] payloadTypeCode = payloadPatternTypeCodes.Get(row);
        stack MirType payloadType = MirTypeForResolvedFieldTypeCode(payloadTypeCode);
        stack u32[0 max] variantOrdinal = payloadPatternVariantOrdinals.Get(row);
        stack u32[0 max] payloadOrdinal = payloadPatternOrdinals.Get(row);
        stack MirValueId payloadValue = MirEnumPayloadExtract(
            instrs,
            ownerType,
            variantOrdinal,
            payloadOrdinal,
            enumValue,
            payloadType);
        stack i64[min max] payloadMinValue = payloadPatternMinValues.Get(row);
        stack i64[min max] payloadMaxValue = payloadPatternMaxValues.Get(row);
        stack MirValueId payloadCondition = LowerIntegerSwitchCaseConditionTyped(
            instrs,
            payloadValue,
            payloadMinValue,
            payloadMaxValue,
            payloadType);
        currentCondition = MirAndTyped(instrs, MirType.I1, currentCondition, payloadCondition);
        offset = offset + 1;
    }

    condition = currentCondition;
    return true;
}

internal fn bool SourceSwitchElementPatternRangesAreProvablyDisjoint(
    u32[0 max] leftStart,
    u32[0 max] leftCount,
    u32[0 max] rightStart,
    u32[0 max] rightCount,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues)
{
    if (leftCount == 0 || rightCount == 0)
    {
        return false;
    }

    stack mut u32[0 max] leftOffset = 0;
    while willexit (leftOffset < leftCount)
    {
        stack u32[0 max] leftRow = leftStart + leftOffset;
        if (!elementPatternIndices.Contains(leftRow)
            || !elementPatternTypeCodes.Contains(leftRow)
            || !elementPatternKinds.Contains(leftRow)
            || !elementPatternMinValues.Contains(leftRow)
            || !elementPatternMaxValues.Contains(leftRow)
            || elementPatternKinds.Get(leftRow) != SourceSwitchEnumPayloadPatternKindScalarInterval())
        {
            return false;
        }

        stack u32[0 max] leftElementIndex = elementPatternIndices.Get(leftRow);
        stack u32[0 max] leftTypeCode = elementPatternTypeCodes.Get(leftRow);
        stack i64[min max] leftMin = elementPatternMinValues.Get(leftRow);
        stack i64[min max] leftMax = elementPatternMaxValues.Get(leftRow);

        stack mut u32[0 max] rightOffset = 0;
        while willexit (rightOffset < rightCount)
        {
            stack u32[0 max] rightRow = rightStart + rightOffset;
            if (!elementPatternIndices.Contains(rightRow)
                || !elementPatternTypeCodes.Contains(rightRow)
                || !elementPatternKinds.Contains(rightRow)
                || !elementPatternMinValues.Contains(rightRow)
                || !elementPatternMaxValues.Contains(rightRow)
                || elementPatternKinds.Get(rightRow) != SourceSwitchEnumPayloadPatternKindScalarInterval())
            {
                return false;
            }

            stack u32[0 max] rightElementIndex = elementPatternIndices.Get(rightRow);
            stack u32[0 max] rightTypeCode = elementPatternTypeCodes.Get(rightRow);
            if (leftElementIndex == rightElementIndex && leftTypeCode == rightTypeCode)
            {
                stack i64[min max] rightMin = elementPatternMinValues.Get(rightRow);
                stack i64[min max] rightMax = elementPatternMaxValues.Get(rightRow);
                if (SourceSwitchScalarIntervalsAreDisjoint(leftMin, leftMax, rightMin, rightMax))
                {
                    return true;
                }
            }

            rightOffset = rightOffset + 1;
        }

        leftOffset = leftOffset + 1;
    }

    return false;
}

internal fn bool SourceSwitchListPatternDescriptorsAreProvablyDisjoint(
    SourceSwitchListPatternDescriptor left,
    SourceSwitchListPatternDescriptor right,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues)
{
    if (left.ElementTypeCode == SourceResolvedFieldTypeCodeInvalid()
        || left.ElementTypeCode != right.ElementTypeCode
        || left.FixedLength == 0
        || left.FixedLength != right.FixedLength)
    {
        return false;
    }

    return SourceSwitchElementPatternRangesAreProvablyDisjoint(
        left.ElementPatternStart,
        left.ElementPatternCount,
        right.ElementPatternStart,
        right.ElementPatternCount,
        elementPatternIndices,
        elementPatternTypeCodes,
        elementPatternKinds,
        elementPatternMinValues,
        elementPatternMaxValues);
}

internal fn bool SourceSwitchListPatternCaseOverlapsPreviousCase(
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues,
    u32[0 max] patternStart,
    u32[0 max] patternCount)
{
    stack u64[0 2 ** 63 - 1] count = casePatternStarts.Count();
    if (casePatternCounts.Count() != count)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(i + 1);
        stack u32[0 max] previousStart = casePatternStarts.Get(caseSlot);
        stack u32[0 max] previousCount = casePatternCounts.Get(caseSlot);
        if (!SourceSwitchElementPatternRangesAreProvablyDisjoint(
                previousStart,
                previousCount,
                patternStart,
                patternCount,
                elementPatternIndices,
                elementPatternTypeCodes,
                elementPatternKinds,
                elementPatternMinValues,
                elementPatternMaxValues))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal finite law bool SourceSwitchGuardNodeIsUnconditional(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] guardNode)
{
    if (guardNode == 0)
    {
        return true;
    }

    if (!nodes.Contains(guardNode))
    {
        return true;
    }

    stack ExprNode node = nodes.Get(guardNode);
    return node.Kind == Compiler.Mir.SourceExpressions.ExprKind.BoolLitExpr && node.Imm == 1;
}

internal fn bool SourceSwitchListPatternCaseOverlapsPreviousUnguardedCase(
    borrow IrTable<ExprNode> nodes,
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    borrow IrTable<u32[0 max]> caseGuardNodes,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues,
    u32[0 max] patternStart,
    u32[0 max] patternCount)
{
    stack u64[0 2 ** 63 - 1] count = casePatternStarts.Count();
    if (casePatternCounts.Count() != count || caseGuardNodes.Count() != count)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(i + 1);
        stack u32[0 max] previousGuardNode = caseGuardNodes.Get(caseSlot);
        if (SourceSwitchGuardNodeIsUnconditional(nodes, previousGuardNode))
        {
            stack u32[0 max] previousStart = casePatternStarts.Get(caseSlot);
            stack u32[0 max] previousCount = casePatternCounts.Get(caseSlot);
            if (!SourceSwitchElementPatternRangesAreProvablyDisjoint(
                    previousStart,
                    previousCount,
                    patternStart,
                    patternCount,
                    elementPatternIndices,
                    elementPatternTypeCodes,
                    elementPatternKinds,
                    elementPatternMinValues,
                    elementPatternMaxValues))
            {
                return true;
            }
        }

        i = i + 1;
    }

    return false;
}

internal fn bool SourceSwitchStructFieldPatternRangesAreProvablyDisjoint(
    u32[0 max] leftStart,
    u32[0 max] leftCount,
    u32[0 max] rightStart,
    u32[0 max] rightCount,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues)
{
    if (leftCount == 0 || rightCount == 0)
    {
        return false;
    }

    stack mut u32[0 max] leftOffset = 0;
    while willexit (leftOffset < leftCount)
    {
        stack u32[0 max] leftRow = leftStart + leftOffset;
        if (!fieldPatternIndices.Contains(leftRow)
            || !fieldPatternTypeCodes.Contains(leftRow)
            || !fieldPatternKinds.Contains(leftRow)
            || !fieldPatternMinValues.Contains(leftRow)
            || !fieldPatternMaxValues.Contains(leftRow)
            || fieldPatternKinds.Get(leftRow) != SourceSwitchEnumPayloadPatternKindScalarInterval())
        {
            return false;
        }

        stack u32[0 max] leftFieldIndex = fieldPatternIndices.Get(leftRow);
        stack u32[0 max] leftTypeCode = fieldPatternTypeCodes.Get(leftRow);
        stack i64[min max] leftMin = fieldPatternMinValues.Get(leftRow);
        stack i64[min max] leftMax = fieldPatternMaxValues.Get(leftRow);

        stack mut u32[0 max] rightOffset = 0;
        while willexit (rightOffset < rightCount)
        {
            stack u32[0 max] rightRow = rightStart + rightOffset;
            if (!fieldPatternIndices.Contains(rightRow)
                || !fieldPatternTypeCodes.Contains(rightRow)
                || !fieldPatternKinds.Contains(rightRow)
                || !fieldPatternMinValues.Contains(rightRow)
                || !fieldPatternMaxValues.Contains(rightRow)
                || fieldPatternKinds.Get(rightRow) != SourceSwitchEnumPayloadPatternKindScalarInterval())
            {
                return false;
            }

            stack u32[0 max] rightFieldIndex = fieldPatternIndices.Get(rightRow);
            stack u32[0 max] rightTypeCode = fieldPatternTypeCodes.Get(rightRow);
            if (leftFieldIndex == rightFieldIndex && leftTypeCode == rightTypeCode)
            {
                stack i64[min max] rightMin = fieldPatternMinValues.Get(rightRow);
                stack i64[min max] rightMax = fieldPatternMaxValues.Get(rightRow);
                if (SourceSwitchScalarIntervalsAreDisjoint(leftMin, leftMax, rightMin, rightMax))
                {
                    return true;
                }
            }

            rightOffset = rightOffset + 1;
        }

        leftOffset = leftOffset + 1;
    }

    return false;
}

internal fn bool SourceSwitchAggregatePatternDescriptorsAreProvablyDisjoint(
    SourceSwitchAggregatePatternDescriptor left,
    SourceSwitchAggregatePatternDescriptor right,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues)
{
    if (left.OwnerTypeToken == 0
        || left.OwnerTypeToken != right.OwnerTypeToken
        || left.EnumVariantOrdinalPlusOne != right.EnumVariantOrdinalPlusOne)
    {
        return false;
    }

    return SourceSwitchStructFieldPatternRangesAreProvablyDisjoint(
        left.FieldPatternStart,
        left.FieldPatternCount,
        right.FieldPatternStart,
        right.FieldPatternCount,
        fieldPatternIndices,
        fieldPatternTypeCodes,
        fieldPatternKinds,
        fieldPatternMinValues,
        fieldPatternMaxValues);
}

internal fn bool SourceSwitchStructPatternCaseOverlapsPreviousCase(
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues,
    u32[0 max] patternStart,
    u32[0 max] patternCount)
{
    stack u64[0 2 ** 63 - 1] count = casePatternStarts.Count();
    if (casePatternCounts.Count() != count)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(i + 1);
        stack u32[0 max] previousStart = casePatternStarts.Get(caseSlot);
        stack u32[0 max] previousCount = casePatternCounts.Get(caseSlot);
        if (!SourceSwitchStructFieldPatternRangesAreProvablyDisjoint(
                previousStart,
                previousCount,
                patternStart,
                patternCount,
                fieldPatternIndices,
                fieldPatternTypeCodes,
                fieldPatternKinds,
                fieldPatternMinValues,
                fieldPatternMaxValues))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool SourceSwitchStructPatternCaseOverlapsPreviousUnguardedCase(
    borrow IrTable<ExprNode> nodes,
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    borrow IrTable<u32[0 max]> caseGuardNodes,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues,
    u32[0 max] patternStart,
    u32[0 max] patternCount)
{
    stack u64[0 2 ** 63 - 1] count = casePatternStarts.Count();
    if (casePatternCounts.Count() != count || caseGuardNodes.Count() != count)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(i + 1);
        stack u32[0 max] previousGuardNode = caseGuardNodes.Get(caseSlot);
        if (SourceSwitchGuardNodeIsUnconditional(nodes, previousGuardNode))
        {
            stack u32[0 max] previousStart = casePatternStarts.Get(caseSlot);
            stack u32[0 max] previousCount = casePatternCounts.Get(caseSlot);
            if (!SourceSwitchStructFieldPatternRangesAreProvablyDisjoint(
                    previousStart,
                    previousCount,
                    patternStart,
                    patternCount,
                    fieldPatternIndices,
                    fieldPatternTypeCodes,
                    fieldPatternKinds,
                    fieldPatternMinValues,
                    fieldPatternMaxValues))
            {
                return true;
            }
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TryParseTerminalSwitchFixedArrayListCaseLabel(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    ParamAbiFacts fixedArrayFacts,
    u64[0 2 ** 63 - 1] valueStart,
    mut borrow IrTable<u32[0 max]> elementPatternIndices,
    mut borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    mut borrow IrTable<u32[0 max]> elementPatternKinds,
    mut borrow IrTable<i64[min max]> elementPatternMinValues,
    mut borrow IrTable<i64[min max]> elementPatternMaxValues,
    out u32[0 max] patternStart,
    out u32[0 max] patternCount,
    out u64[0 2 ** 63 - 1] nextToken)
{
    patternStart = (u32[0 max])elementPatternIndices.Count() + 1;
    patternCount = 0;
    nextToken = valueStart;
    if (!fixedArrayFacts.IsFixedArray
        || fixedArrayFacts.FixedArrayLength == 0
        || fixedArrayFacts.FixedArrayFieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    if (stream.KindAt(valueStart) == TokenKind.Discard)
    {
        nextToken = valueStart + 1;
        return true;
    }

    if (stream.KindAt(valueStart) != TokenKind.LBrack)
    {
        return false;
    }

    stack mut u32[0 max] elementIndex = 0;
    stack mut u64[0 2 ** 63 - 1] cursor = valueStart + 1;
    while willexit (elementIndex < fixedArrayFacts.FixedArrayLength)
    {
        stack mut u32[0 max] patternKind = SourceSwitchEnumPayloadPatternKindDiscard();
        stack mut i64[min max] minValue = 0;
        stack mut i64[min max] maxValue = 0;
        stack mut u64[0 2 ** 63 - 1] afterPattern = cursor;
        if (!TryParseSourceSwitchEnumPayloadScalarPattern(
                stream,
                source,
                fixedArrayFacts.FixedArrayFieldTypeCode,
                cursor,
                patternKind,
                minValue,
                maxValue,
                afterPattern))
        {
            return false;
        }

        if (patternKind != SourceSwitchEnumPayloadPatternKindDiscard())
        {
            if (elementPatternIndices.Add(elementIndex) == 0
                || elementPatternTypeCodes.Add(fixedArrayFacts.FixedArrayFieldTypeCode) == 0
                || elementPatternKinds.Add(patternKind) == 0
                || elementPatternMinValues.Add(minValue) == 0
                || elementPatternMaxValues.Add(maxValue) == 0)
            {
                return false;
            }

            patternCount = patternCount + 1;
        }

        elementIndex = elementIndex + 1;
        cursor = afterPattern;
        if (elementIndex < fixedArrayFacts.FixedArrayLength)
        {
            if (stream.KindAt(cursor) != TokenKind.Comma)
            {
                return false;
            }

            cursor = cursor + 1;
        }
        else if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            cursor = cursor + 1;
        }
    }

    if (stream.KindAt(cursor) != TokenKind.RBrack)
    {
        return false;
    }

    nextToken = cursor + 1;
    return true;
}

internal fn bool TryParseTerminalSwitchFixedArrayListCaseLabelWithCaptures(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    ParamAbiFacts fixedArrayFacts,
    u64[0 2 ** 63 - 1] valueStart,
    mut borrow IrTable<u32[0 max]> elementPatternIndices,
    mut borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    mut borrow IrTable<u32[0 max]> elementPatternKinds,
    mut borrow IrTable<i64[min max]> elementPatternMinValues,
    mut borrow IrTable<i64[min max]> elementPatternMaxValues,
    mut borrow IrTable<u32[0 max]> elementCaptureIndices,
    mut borrow IrTable<u32[0 max]> elementCaptureTypeCodes,
    mut borrow IrTable<u32[0 max]> elementCaptureNameTokens,
    out u32[0 max] patternStart,
    out u32[0 max] patternCount,
    out u32[0 max] captureStart,
    out u32[0 max] captureCount,
    out u64[0 2 ** 63 - 1] nextToken)
{
    patternStart = (u32[0 max])elementPatternIndices.Count() + 1;
    patternCount = 0;
    captureStart = (u32[0 max])elementCaptureNameTokens.Count() + 1;
    captureCount = 0;
    nextToken = valueStart;
    if (!fixedArrayFacts.IsFixedArray
        || fixedArrayFacts.FixedArrayLength == 0
        || fixedArrayFacts.FixedArrayFieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    if (stream.KindAt(valueStart) == TokenKind.Discard)
    {
        nextToken = valueStart + 1;
        return true;
    }

    if (stream.KindAt(valueStart) == TokenKind.Var
        && stream.KindAt(valueStart + 1) == TokenKind.Identifier)
    {
        if (elementCaptureIndices.Add(fixedArrayFacts.FixedArrayLength) == 0
            || elementCaptureTypeCodes.Add(SourceLocalTypeCodeFixedArrayParam()) == 0
            || elementCaptureNameTokens.Add((u32[0 max])(valueStart + 1)) == 0)
        {
            return false;
        }

        captureCount = 1;
        nextToken = valueStart + 2;
        return true;
    }

    if (stream.KindAt(valueStart) != TokenKind.LBrack)
    {
        return false;
    }

    stack mut u32[0 max] elementIndex = 0;
    stack mut u64[0 2 ** 63 - 1] cursor = valueStart + 1;
    while willexit (elementIndex < fixedArrayFacts.FixedArrayLength)
    {
        stack mut u32[0 max] patternKind = SourceSwitchEnumPayloadPatternKindDiscard();
        stack mut i64[min max] minValue = 0;
        stack mut i64[min max] maxValue = 0;
        stack mut u32[0 max] captureNameToken = 0;
        stack mut u64[0 2 ** 63 - 1] afterPattern = cursor;
        if (!TryParseSourceSwitchEnumPayloadScalarOrCapturePattern(
                stream,
                source,
                fixedArrayFacts.FixedArrayFieldTypeCode,
                true,
                cursor,
                patternKind,
                minValue,
                maxValue,
                captureNameToken,
                afterPattern))
        {
            return false;
        }

        if (captureNameToken != 0)
        {
            if (elementCaptureIndices.Add(elementIndex) == 0
                || elementCaptureTypeCodes.Add(fixedArrayFacts.FixedArrayFieldTypeCode) == 0
                || elementCaptureNameTokens.Add(captureNameToken) == 0)
            {
                return false;
            }

            captureCount = captureCount + 1;
        }

        if (patternKind != SourceSwitchEnumPayloadPatternKindDiscard())
        {
            if (elementPatternIndices.Add(elementIndex) == 0
                || elementPatternTypeCodes.Add(fixedArrayFacts.FixedArrayFieldTypeCode) == 0
                || elementPatternKinds.Add(patternKind) == 0
                || elementPatternMinValues.Add(minValue) == 0
                || elementPatternMaxValues.Add(maxValue) == 0)
            {
                return false;
            }

            patternCount = patternCount + 1;
        }

        elementIndex = elementIndex + 1;
        cursor = afterPattern;
        if (elementIndex < fixedArrayFacts.FixedArrayLength)
        {
            if (stream.KindAt(cursor) != TokenKind.Comma)
            {
                return false;
            }

            cursor = cursor + 1;
        }
        else if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            cursor = cursor + 1;
        }
    }

    if (stream.KindAt(cursor) != TokenKind.RBrack)
    {
        return false;
    }

    nextToken = cursor + 1;
    return true;
}

internal fn bool TryResolveFixedArraySwitchScrutineeFacts(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    out u32[0 max] fixedArrayParamIndex,
    out ParamAbiFacts fixedArrayFacts)
{
    fixedArrayParamIndex = 0;
    fixedArrayFacts = new();
    if (!nodes.Contains(scrutineeNode))
    {
        return false;
    }

    stack ExprNode node = nodes.Get(scrutineeNode);
    if (node.Kind != Compiler.Mir.SourceExpressions.ExprKind.NameExpr)
    {
        return false;
    }

    stack ParamAbiFacts facts = AbiFactAt(paramAbiFacts, node.Left + 1);
    if (!facts.IsFixedArray
        || facts.FixedArrayLength == 0
        || facts.FixedArrayFieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    fixedArrayParamIndex = node.Left;
    fixedArrayFacts = facts;
    return true;
}

internal fn ParamAbiFacts FixedArrayStorageLocalAbiFacts(FixedArrayStorageLocal local)
{
    stack mut ParamAbiFacts facts = new();
    facts.IsFixedArray = true;
    facts.FixedArrayElementType = local.ElementType;
    facts.FixedArrayElementSize = local.ElementSize;
    facts.FixedArrayAlignment = local.Alignment;
    facts.FixedArrayLength = local.ArrayLength;
    facts.FixedArrayFieldTypeCode = local.FieldTypeCode;
    return facts;
}

internal fn bool TryResolveFixedArrayStorageSwitchScrutineeFacts(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<FixedArrayStorageLocal> fixedArrayStorageLocals,
    out FixedArrayStorageLocal fixedArrayLocal,
    out ParamAbiFacts fixedArrayFacts)
{
    fixedArrayLocal = new();
    fixedArrayFacts = new();
    if (!nodes.Contains(scrutineeNode))
    {
        return false;
    }

    stack ExprNode node = nodes.Get(scrutineeNode);
    stack mut FixedArrayStorageLocal resolvedLocal = new();
    if (node.Kind != Compiler.Mir.SourceExpressions.ExprKind.NameExpr
        || !TryFindFixedArrayStorageLocalByParamIndex(fixedArrayStorageLocals, node.Left, resolvedLocal)
        || resolvedLocal.ArrayLength == 0
        || resolvedLocal.ElementSize == 0
        || resolvedLocal.Alignment == 0
        || resolvedLocal.FieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    fixedArrayLocal = resolvedLocal;
    fixedArrayFacts = FixedArrayStorageLocalAbiFacts(resolvedLocal);
    return true;
}

internal fn bool TryResolveFixedArrayFieldSwitchScrutineeFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    mut borrow IrTable<ExprNode> nodes,
    u64[0 2 ** 63 - 1] scrutineeStart,
    u64[0 2 ** 63 - 1] scrutineeEnd,
    out ExprParseResult scrutinee,
    out FixedArrayStorageLocal fixedArrayLocal,
    out ParamAbiFacts fixedArrayFacts)
    where overlap(objectLocals, source)
{
    scrutinee = new();
    fixedArrayLocal = new();
    fixedArrayFacts = new();
    if (scrutineeStart + 2 >= scrutineeEnd
        || stream.KindAt(scrutineeStart) != TokenKind.Identifier
        || stream.KindAt(scrutineeStart + 1) != TokenKind.Dot
        || stream.KindAt(scrutineeStart + 2) != TokenKind.Identifier)
    {
        return false;
    }

    stack mut ConstructedObjectLocal objectLocal = new();
    if (!TryFindConstructedObjectLocal(
        objectLocals,
        source,
        stream.StartAt(scrutineeStart),
        stream.LengthAt(scrutineeStart),
        objectLocal))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] nextToken = scrutineeStart;
    stack mut u32[0 max] fieldOffset = 0;
    stack mut u32[0 max] fieldAlignment = 0;
    stack mut u32[0 max] fieldTypeToken = 0;
    stack mut u32[0 max] leafMemberFactRow = 0;
    if (!TryResolveConstructedObjectMemberChainStorageField(
        stream,
        source,
        moduleFacts,
        objectLocal.TypeToken,
        scrutineeStart + 2,
        nextToken,
        fieldOffset,
        fieldAlignment,
        fieldTypeToken,
        leafMemberFactRow)
        || nextToken != scrutineeEnd
        || !SourceMemberPathFactIsFixedArray(moduleFacts.MemberPathFacts, leafMemberFactRow))
    {
        return false;
    }

    stack mut u32[0 max] baseByteOffset = 0;
    stack mut u32[0 max] elementSizeBytes = 0;
    stack mut u32[0 max] elementAlignment = 0;
    stack mut MirType elementType = MirType.I64;
    stack mut u32[0 max] arrayLength = 0;
    if (!TryResolveFixedArrayFieldLayoutAtField(
        stream,
        source,
        fieldTypeToken,
        fieldOffset,
        baseByteOffset,
        elementSizeBytes,
        elementAlignment,
        elementType,
        arrayLength))
    {
        return false;
    }

    stack u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
    if (arrayLength == 0
        || elementSizeBytes == 0
        || elementAlignment == 0
        || fieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    stack mut FixedArrayStorageLocal resolvedFixedArrayLocal = new();
    resolvedFixedArrayLocal.Start = stream.StartAt(scrutineeStart);
    resolvedFixedArrayLocal.Length = stream.LengthAt(scrutineeStart);
    resolvedFixedArrayLocal.ParamIndex = objectLocal.ParamIndex;
    resolvedFixedArrayLocal.BaseByteOffset = baseByteOffset;
    resolvedFixedArrayLocal.ElementSize = elementSizeBytes;
    resolvedFixedArrayLocal.Alignment = elementAlignment;
    resolvedFixedArrayLocal.ArrayLength = arrayLength;
    resolvedFixedArrayLocal.ElementType = elementType;
    resolvedFixedArrayLocal.FieldTypeCode = fieldTypeCode;
    stack mut i64[min max] declaredElementLower = 0;
    stack mut i64[min max] declaredElementUpperExclusive = 0;
    if (TryDeclaredElementRangeFactForMemberPathFact(
        moduleFacts.MemberPathFacts,
        leafMemberFactRow,
        declaredElementLower,
        declaredElementUpperExclusive))
    {
        resolvedFixedArrayLocal.HasDeclaredElementRange = true;
        resolvedFixedArrayLocal.DeclaredElementRangeLower = declaredElementLower;
        resolvedFixedArrayLocal.DeclaredElementRangeUpperExclusive = declaredElementUpperExclusive;
    }

    fixedArrayLocal = resolvedFixedArrayLocal;
    fixedArrayFacts = FixedArrayStorageLocalAbiFacts(resolvedFixedArrayLocal);
    scrutinee = MakeParseResult(MakeName(nodes, objectLocal.ParamIndex), scrutineeEnd);
    return true;
}

internal fn bool TryLowerFixedArrayListSwitchCaseCondition(
    mut borrow IrTable<MirInstruction> instrs,
    u32[0 max] fixedArrayParamIndex,
    ParamAbiFacts fixedArrayFacts,
    u32[0 max] patternStart,
    u32[0 max] patternCount,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues,
    out MirValueId condition)
{
    stack mut MirValueId currentCondition = MirConstIntTyped(instrs, MirType.I1, 1);
    if (!fixedArrayFacts.IsFixedArray
        || fixedArrayFacts.FixedArrayLength == 0
        || fixedArrayFacts.FixedArrayFieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    stack mut u32[0 max] offset = 0;
    while willexit (offset < patternCount)
    {
        stack u32[0 max] row = patternStart + offset;
        if (!elementPatternIndices.Contains(row)
            || !elementPatternTypeCodes.Contains(row)
            || !elementPatternKinds.Contains(row)
            || !elementPatternMinValues.Contains(row)
            || !elementPatternMaxValues.Contains(row))
        {
            return false;
        }

        stack u32[0 max] patternKind = elementPatternKinds.Get(row);
        if (patternKind != SourceSwitchEnumPayloadPatternKindScalarInterval())
        {
            return false;
        }

        stack u32[0 max] elementIndex = elementPatternIndices.Get(row);
        stack u32[0 max] elementTypeCode = elementPatternTypeCodes.Get(row);
        if (elementIndex >= fixedArrayFacts.FixedArrayLength
            || elementTypeCode != fixedArrayFacts.FixedArrayFieldTypeCode)
        {
            return false;
        }

        stack MirValueId elementValue = MirFixedArrayParamElement(
            instrs,
            fixedArrayParamIndex,
            elementIndex,
            fixedArrayFacts.FixedArrayLength,
            fixedArrayFacts.FixedArrayElementType);
        stack i64[min max] elementMinValue = elementPatternMinValues.Get(row);
        stack i64[min max] elementMaxValue = elementPatternMaxValues.Get(row);
        stack MirValueId elementCondition = LowerIntegerSwitchCaseConditionTyped(
            instrs,
            elementValue,
            elementMinValue,
            elementMaxValue,
            fixedArrayFacts.FixedArrayElementType);
        currentCondition = MirAndTyped(instrs, MirType.I1, currentCondition, elementCondition);
        offset = offset + 1;
    }

    condition = currentCondition;
    return true;
}

internal fn bool TryLowerFixedArrayStorageListSwitchCaseCondition(
    mut borrow IrTable<MirInstruction> instrs,
    FixedArrayStorageLocal fixedArrayLocal,
    borrow IrTable<u32[0 max]> localOverrides,
    u32[0 max] patternStart,
    u32[0 max] patternCount,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues,
    out MirValueId condition)
{
    stack mut MirValueId currentCondition = MirConstIntTyped(instrs, MirType.I1, 1);
    if (fixedArrayLocal.ArrayLength == 0
        || fixedArrayLocal.ElementSize == 0
        || fixedArrayLocal.Alignment == 0
        || fixedArrayLocal.FieldTypeCode == SourceResolvedFieldTypeCodeInvalid()
        || !localOverrides.Contains(fixedArrayLocal.ParamIndex + 1))
    {
        return false;
    }

    stack u32[0 max] storageValue = localOverrides.Get(fixedArrayLocal.ParamIndex + 1);
    if (storageValue == 0)
    {
        return false;
    }

    stack mut u32[0 max] offset = 0;
    while willexit (offset < patternCount)
    {
        stack u32[0 max] row = patternStart + offset;
        if (!elementPatternIndices.Contains(row)
            || !elementPatternTypeCodes.Contains(row)
            || !elementPatternKinds.Contains(row)
            || !elementPatternMinValues.Contains(row)
            || !elementPatternMaxValues.Contains(row))
        {
            return false;
        }

        stack u32[0 max] patternKind = elementPatternKinds.Get(row);
        if (patternKind != SourceSwitchEnumPayloadPatternKindScalarInterval())
        {
            return false;
        }

        stack u32[0 max] elementIndex = elementPatternIndices.Get(row);
        stack u32[0 max] elementTypeCode = elementPatternTypeCodes.Get(row);
        if (elementIndex >= fixedArrayLocal.ArrayLength
            || elementTypeCode != fixedArrayLocal.FieldTypeCode
            || elementIndex > 4294967295 / fixedArrayLocal.ElementSize)
        {
            return false;
        }

        stack u32[0 max] elementByteOffset = elementIndex * fixedArrayLocal.ElementSize;
        if (fixedArrayLocal.BaseByteOffset > 4294967295 - elementByteOffset)
        {
            return false;
        }

        stack u32[0 max] byteOffset = fixedArrayLocal.BaseByteOffset + elementByteOffset;
        stack MirValueId elementPointer = MirPtrOffset(
            instrs,
            MirValueIdOf(storageValue),
            byteOffset,
            fixedArrayLocal.Alignment);
        stack mut MirValueId elementValue = MirValueIdOf(0);
        if (fixedArrayLocal.HasDeclaredElementRange)
        {
            elementValue = MirLoadPtrAlignedTypedWithDeclaredRange(
                instrs,
                fixedArrayLocal.ElementType,
                elementPointer,
                fixedArrayLocal.Alignment,
                fixedArrayLocal.DeclaredElementRangeLower,
                fixedArrayLocal.DeclaredElementRangeUpperExclusive);
        }
        else
        {
            elementValue = MirLoadPtrAlignedTyped(
                instrs,
                fixedArrayLocal.ElementType,
                elementPointer,
                fixedArrayLocal.Alignment);
        }

        stack i64[min max] elementMinValue = elementPatternMinValues.Get(row);
        stack i64[min max] elementMaxValue = elementPatternMaxValues.Get(row);
        stack MirValueId elementCondition = LowerIntegerSwitchCaseConditionTyped(
            instrs,
            elementValue,
            elementMinValue,
            elementMaxValue,
            fixedArrayLocal.ElementType);
        currentCondition = MirAndTyped(instrs, MirType.I1, currentCondition, elementCondition);
        offset = offset + 1;
    }

    condition = currentCondition;
    return true;
}

internal fn bool TryGetSourceStructPatternFieldCount(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    out u32[0 max] fieldCount)
{
    fieldCount = 0;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] resolvedCount = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            if (FindSelfHostedFieldNameToken(stream, segmentStart, headerScan) != 0)
                            {
                                resolvedCount = resolvedCount + 1;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    if (FindSelfHostedFieldNameToken(stream, field, fieldEnd) != 0)
                    {
                        resolvedCount = resolvedCount + 1;
                    }

                    field = fieldEnd;
                }

                field = field + 1;
            }

            fieldCount = resolvedCount;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryGetSourceStructPatternFieldNameByOrdinal(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u32[0 max] fieldOrdinal,
    out u32[0 max] fieldNameToken)
{
    fieldNameToken = 0;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] currentOrdinal = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, segmentStart, headerScan);
                            if (nameToken != 0)
                            {
                                if (currentOrdinal == fieldOrdinal)
                                {
                                    fieldNameToken = nameToken;
                                    return true;
                                }

                                currentOrdinal = currentOrdinal + 1;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, field, fieldEnd);
                    if (nameToken != 0)
                    {
                        if (currentOrdinal == fieldOrdinal)
                        {
                            fieldNameToken = nameToken;
                            return true;
                        }

                        currentOrdinal = currentOrdinal + 1;
                    }

                    field = fieldEnd;
                }

                field = field + 1;
            }

            return false;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryGetSourceStructPatternFieldOrdinalByName(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u32[0 max] fieldNameToken,
    out u32[0 max] fieldOrdinal)
{
    fieldOrdinal = 0;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] currentOrdinal = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, segmentStart, headerScan);
                            if (nameToken != 0)
                            {
                                if (TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                                {
                                    fieldOrdinal = currentOrdinal;
                                    return true;
                                }

                                currentOrdinal = currentOrdinal + 1;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, field, fieldEnd);
                    if (nameToken != 0)
                    {
                        if (TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                        {
                            fieldOrdinal = currentOrdinal;
                            return true;
                        }

                        currentOrdinal = currentOrdinal + 1;
                    }

                    field = fieldEnd;
                }

                field = field + 1;
            }

            return false;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryAppendSourceStructSwitchFieldPattern(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerTypeToken,
    u32[0 max] fieldOrdinal,
    u32[0 max] fieldNameToken,
    u64[0 2 ** 63 - 1] patternStartToken,
    mut borrow IrTable<u32[0 max]> fieldPatternIndices,
    mut borrow IrTable<u32[0 max]> fieldPatternOffsets,
    mut borrow IrTable<u32[0 max]> fieldPatternAlignments,
    mut borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    mut borrow IrTable<u32[0 max]> fieldPatternMemberFactRows,
    mut borrow IrTable<u32[0 max]> fieldPatternKinds,
    mut borrow IrTable<i64[min max]> fieldPatternMinValues,
    mut borrow IrTable<i64[min max]> fieldPatternMaxValues,
    mut borrow IrTable<u32[0 max]> fieldCaptureIndices,
    mut borrow IrTable<u32[0 max]> fieldCaptureOffsets,
    mut borrow IrTable<u32[0 max]> fieldCaptureAlignments,
    mut borrow IrTable<u32[0 max]> fieldCaptureTypeCodes,
    mut borrow IrTable<u32[0 max]> fieldCaptureMemberFactRows,
    mut borrow IrTable<u32[0 max]> fieldCaptureNameTokens,
    out bool addedPattern,
    out bool addedCapture,
    out u64[0 2 ** 63 - 1] nextToken)
{
    addedPattern = false;
    addedCapture = false;
    nextToken = patternStartToken;

    stack mut u32[0 max] fieldOffset = 0;
    stack mut u32[0 max] fieldAlignment = 0;
    stack mut MirType ignoredFieldType = MirType.I64;
    stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] memberFactRow = 0;
    if (!TryFindStructFieldLayout(
            stream,
            source,
            moduleFacts,
            ownerTypeToken,
            fieldNameToken,
            fieldOffset,
            fieldAlignment,
            ignoredFieldType,
            fieldTypeCode)
        || fieldTypeCode == SourceResolvedFieldTypeCodeInvalid()
        || !SourceMemberPathFactMatchesFieldStep(
            stream,
            source,
            moduleFacts.MemberFactRowsByToken,
            moduleFacts.MemberPathFacts,
            ownerTypeToken,
            fieldNameToken,
            memberFactRow)
        || !SourceMemberPathFactAgreesWithFieldTypeCode(moduleFacts.MemberPathFacts, memberFactRow, fieldTypeCode))
    {
        return false;
    }

    stack mut u32[0 max] patternKind = SourceSwitchEnumPayloadPatternKindDiscard();
    stack mut i64[min max] minValue = 0;
    stack mut i64[min max] maxValue = 0;
    stack mut u32[0 max] captureNameToken = 0;
    stack mut u64[0 2 ** 63 - 1] afterPattern = patternStartToken;
    if (!TryParseSourceSwitchEnumPayloadScalarOrCapturePattern(
            stream,
            source,
            fieldTypeCode,
            true,
            patternStartToken,
            patternKind,
            minValue,
            maxValue,
            captureNameToken,
            afterPattern))
    {
        return false;
    }

    if (captureNameToken != 0)
    {
        if (fieldCaptureIndices.Add(fieldOrdinal) == 0
            || fieldCaptureOffsets.Add(fieldOffset) == 0
            || fieldCaptureAlignments.Add(fieldAlignment) == 0
            || fieldCaptureTypeCodes.Add(fieldTypeCode) == 0
            || fieldCaptureMemberFactRows.Add(memberFactRow) == 0
            || fieldCaptureNameTokens.Add(captureNameToken) == 0)
        {
            return false;
        }

        addedCapture = true;
    }

    if (patternKind != SourceSwitchEnumPayloadPatternKindDiscard())
    {
        if (fieldPatternIndices.Add(fieldOrdinal) == 0
            || fieldPatternOffsets.Add(fieldOffset) == 0
            || fieldPatternAlignments.Add(fieldAlignment) == 0
            || fieldPatternTypeCodes.Add(fieldTypeCode) == 0
            || fieldPatternMemberFactRows.Add(memberFactRow) == 0
            || fieldPatternKinds.Add(patternKind) == 0
            || fieldPatternMinValues.Add(minValue) == 0
            || fieldPatternMaxValues.Add(maxValue) == 0)
        {
            return false;
        }

        addedPattern = true;
    }

    nextToken = afterPattern;
    return true;
}

internal fn bool TryParseTerminalSwitchStructAggregateCaseLabel(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerTypeToken,
    u64[0 2 ** 63 - 1] valueStart,
    mut borrow IrTable<u32[0 max]> fieldPatternIndices,
    mut borrow IrTable<u32[0 max]> fieldPatternOffsets,
    mut borrow IrTable<u32[0 max]> fieldPatternAlignments,
    mut borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    mut borrow IrTable<u32[0 max]> fieldPatternMemberFactRows,
    mut borrow IrTable<u32[0 max]> fieldPatternKinds,
    mut borrow IrTable<i64[min max]> fieldPatternMinValues,
    mut borrow IrTable<i64[min max]> fieldPatternMaxValues,
    mut borrow IrTable<u32[0 max]> fieldCaptureIndices,
    mut borrow IrTable<u32[0 max]> fieldCaptureOffsets,
    mut borrow IrTable<u32[0 max]> fieldCaptureAlignments,
    mut borrow IrTable<u32[0 max]> fieldCaptureTypeCodes,
    mut borrow IrTable<u32[0 max]> fieldCaptureMemberFactRows,
    mut borrow IrTable<u32[0 max]> fieldCaptureNameTokens,
    out u32[0 max] patternStart,
    out u32[0 max] patternCount,
    out u32[0 max] captureStart,
    out u32[0 max] captureCount,
    out u64[0 2 ** 63 - 1] nextToken)
{
    patternStart = (u32[0 max])fieldPatternIndices.Count() + 1;
    patternCount = 0;
    captureStart = (u32[0 max])fieldCaptureNameTokens.Count() + 1;
    captureCount = 0;
    nextToken = valueStart;
    if (stream.KindAt(valueStart) == TokenKind.Discard)
    {
        nextToken = valueStart + 1;
        return true;
    }

    stack TokenKind labelKind = stream.KindAt(valueStart);
    if (labelKind != TokenKind.Var && labelKind != TokenKind.Identifier)
    {
        return false;
    }

    stack mut u32[0 max] fieldCount = 0;
    if (!TryGetSourceStructPatternFieldCount(stream, source, ownerTypeToken, fieldCount))
    {
        return false;
    }

    if (labelKind == TokenKind.Var
        && stream.KindAt(valueStart + 1) == TokenKind.Identifier)
    {
        if (fieldCaptureIndices.Add(fieldCount) == 0
            || fieldCaptureOffsets.Add(0) == 0
            || fieldCaptureAlignments.Add(0) == 0
            || fieldCaptureTypeCodes.Add(SourceLocalTypeCodeForStructValueTypeToken(ownerTypeToken)) == 0
            || fieldCaptureMemberFactRows.Add(0) == 0
            || fieldCaptureNameTokens.Add((u32[0 max])(valueStart + 1)) == 0)
        {
            return false;
        }

        captureCount = 1;
        nextToken = valueStart + 2;
        return true;
    }

    if (!TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])valueStart, ownerTypeToken))
    {
        return false;
    }

    stack TokenKind suffixKind = stream.KindAt(valueStart + 1);
    if (suffixKind == TokenKind.LParen)
    {
        stack mut u64[0 2 ** 63 - 1] cursor = valueStart + 2;
        stack mut u32[0 max] fieldOrdinal = 0;
        while willexit (fieldOrdinal < fieldCount)
        {
            stack mut u32[0 max] fieldNameToken = 0;
            stack mut bool addedPattern = false;
            stack mut bool addedCapture = false;
            stack mut u64[0 2 ** 63 - 1] afterPattern = cursor;
            if (!TryGetSourceStructPatternFieldNameByOrdinal(stream, source, ownerTypeToken, fieldOrdinal, fieldNameToken)
                || !TryAppendSourceStructSwitchFieldPattern(
                    stream,
                    source,
                    moduleFacts,
                    ownerTypeToken,
                    fieldOrdinal,
                    fieldNameToken,
                    cursor,
                    fieldPatternIndices,
                    fieldPatternOffsets,
                    fieldPatternAlignments,
                    fieldPatternTypeCodes,
                    fieldPatternMemberFactRows,
                    fieldPatternKinds,
                    fieldPatternMinValues,
                    fieldPatternMaxValues,
                    fieldCaptureIndices,
                    fieldCaptureOffsets,
                    fieldCaptureAlignments,
                    fieldCaptureTypeCodes,
                    fieldCaptureMemberFactRows,
                    fieldCaptureNameTokens,
                    addedPattern,
                    addedCapture,
                    afterPattern))
            {
                return false;
            }

            if (addedPattern)
            {
                patternCount = patternCount + 1;
            }

            if (addedCapture)
            {
                captureCount = captureCount + 1;
            }

            fieldOrdinal = fieldOrdinal + 1;
            cursor = afterPattern;
            if (fieldOrdinal < fieldCount)
            {
                if (stream.KindAt(cursor) != TokenKind.Comma)
                {
                    return false;
                }

                cursor = cursor + 1;
            }
            else if (stream.KindAt(cursor) == TokenKind.Comma)
            {
                cursor = cursor + 1;
            }
        }

        if (stream.KindAt(cursor) != TokenKind.RParen)
        {
            return false;
        }

        nextToken = cursor + 1;
        return true;
    }

    if (suffixKind == TokenKind.LBrace)
    {
        stack mut IrTable<u32[0 max]> seenFieldOrdinals = new();
        stack mut u32[0 max] parsedFields = 0;
        stack mut u64[0 2 ** 63 - 1] cursor = valueStart + 2;
        while willexit (parsedFields < fieldCount && stream.KindAt(cursor) != TokenKind.RBrace)
        {
            stack mut u32[0 max] fieldOrdinal = 0;
            if (stream.KindAt(cursor) != TokenKind.Identifier
                || stream.KindAt(cursor + 1) != TokenKind.Colon
                || !TryGetSourceStructPatternFieldOrdinalByName(stream, source, ownerTypeToken, (u32[0 max])cursor, fieldOrdinal)
                || SourceSwitchEnumPayloadOrdinalListContains(seenFieldOrdinals, fieldOrdinal))
            {
                return false;
            }

            stack u32[0 max] seenOrdinal = seenFieldOrdinals.Add(fieldOrdinal);

            stack mut bool addedPattern = false;
            stack mut bool addedCapture = false;
            stack mut u64[0 2 ** 63 - 1] afterPattern = cursor + 2;
            if (seenOrdinal == 0
                || !TryAppendSourceStructSwitchFieldPattern(
                    stream,
                    source,
                    moduleFacts,
                    ownerTypeToken,
                    fieldOrdinal,
                    (u32[0 max])cursor,
                    cursor + 2,
                    fieldPatternIndices,
                    fieldPatternOffsets,
                    fieldPatternAlignments,
                    fieldPatternTypeCodes,
                    fieldPatternMemberFactRows,
                    fieldPatternKinds,
                    fieldPatternMinValues,
                    fieldPatternMaxValues,
                    fieldCaptureIndices,
                    fieldCaptureOffsets,
                    fieldCaptureAlignments,
                    fieldCaptureTypeCodes,
                    fieldCaptureMemberFactRows,
                    fieldCaptureNameTokens,
                    addedPattern,
                    addedCapture,
                    afterPattern))
            {
                return false;
            }

            if (addedPattern)
            {
                patternCount = patternCount + 1;
            }

            if (addedCapture)
            {
                captureCount = captureCount + 1;
            }

            parsedFields = parsedFields + 1;
            cursor = afterPattern;
            if (stream.KindAt(cursor) == TokenKind.Comma)
            {
                cursor = cursor + 1;
            }
            else if (stream.KindAt(cursor) != TokenKind.RBrace)
            {
                return false;
            }
        }

        if (parsedFields != fieldCount || stream.KindAt(cursor) != TokenKind.RBrace)
        {
            return false;
        }

        nextToken = cursor + 1;
        return true;
    }

    return false;
}

internal fn bool TryResolveStructValueParamSwitchScrutineeFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> params,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    u64[0 2 ** 63 - 1] scrutineeStart,
    u64[0 2 ** 63 - 1] scrutineeEnd,
    out ExprParseResult scrutinee,
    out u32[0 max] structParamIndex,
    out u32[0 max] structTypeToken,
    out ParamAbiFacts structValueFacts)
{
    scrutinee = new();
    structParamIndex = 0;
    structTypeToken = 0;
    structValueFacts = new();
    if (scrutineeStart + 1 != scrutineeEnd || stream.KindAt(scrutineeStart) != TokenKind.Identifier)
    {
        return false;
    }

    stack i64[min max] rawParamIndex = ParamIndexOf(
        params,
        source,
        stream.StartAt(scrutineeStart),
        stream.LengthAt(scrutineeStart));
    if (rawParamIndex < 0)
    {
        return false;
    }

    stack u32[0 max] paramIndex = (u32[0 max])rawParamIndex;
    stack ParamAbiFacts facts = AbiFactAt(paramAbiFacts, paramIndex + 1);
    if (!facts.IsStructValue
        || facts.StructValueTypeToken == 0
        || facts.StructValueFieldCount == 0
        || facts.StructValueFieldCount > StructValueShapeMaxFields())
    {
        return false;
    }

    scrutinee = MakeParseResult(MakeName(nodes, paramIndex), scrutineeEnd);
    structParamIndex = paramIndex;
    structTypeToken = facts.StructValueTypeToken;
    structValueFacts = facts;
    return true;
}

internal fn bool TryBuildStorageBackedStructSwitchValueFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    out ParamAbiFacts facts)
{
    facts = new();
    stack u32[0 max] byteSize = TypeKnownByteExtentForLocal(stream, source, typeToken);
    stack u32[0 max] byteAlignment = TypeKnownByteAlignment(stream, source, typeToken);
    stack mut u32[0 max] fieldCount = 0;
    stack mut u32[0 max] shapeCode = 0;
    if (typeToken == 0
        || byteSize == 0
        || byteAlignment == 0
        || !TryReadStructKnownLlvmScalarShape(stream, source, typeToken, fieldCount, shapeCode)
        || fieldCount == 0
        || fieldCount > StructValueShapeMaxFields())
    {
        return false;
    }

    facts.IsStructValue = true;
    facts.StructValueTypeToken = typeToken;
    facts.StructValueSize = byteSize;
    facts.StructValueAlignment = byteAlignment;
    facts.StructValueFieldCount = fieldCount;
    facts.StructValueShapeCode = shapeCode;
    return true;
}

internal fn bool TryResolveStructAggregateSwitchScrutineeFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> params,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    u64[0 2 ** 63 - 1] scrutineeStart,
    u64[0 2 ** 63 - 1] scrutineeEnd,
    out ExprParseResult scrutinee,
    out u32[0 max] structParamIndex,
    out u32[0 max] structTypeToken,
    out u32[0 max] structBaseByteOffset,
    out bool useStructValueParam,
    out ParamAbiFacts structValueFacts)
    where overlap(constructedObjectLocals, source)
{
    scrutinee = new();
    structParamIndex = 0;
    structTypeToken = 0;
    structBaseByteOffset = 0;
    useStructValueParam = false;
    structValueFacts = new();
    if (scrutineeStart + 1 == scrutineeEnd && stream.KindAt(scrutineeStart) == TokenKind.Identifier)
    {
        stack mut ConstructedObjectLocal objectLocal = new();
        if (TryFindConstructedObjectLocal(
            constructedObjectLocals,
            source,
            stream.StartAt(scrutineeStart),
            stream.LengthAt(scrutineeStart),
            objectLocal))
        {
            stack mut ParamAbiFacts objectStructValueFacts = new();
            if (!TryBuildStorageBackedStructSwitchValueFacts(
                stream,
                source,
                objectLocal.TypeToken,
                objectStructValueFacts))
            {
                return false;
            }

            scrutinee = MakeParseResult(MakeName(nodes, objectLocal.ParamIndex), scrutineeEnd);
            structParamIndex = objectLocal.ParamIndex;
            structTypeToken = objectLocal.TypeToken;
            structValueFacts = objectStructValueFacts;
            return true;
        }

        stack mut ExprParseResult paramScrutinee = new();
        stack mut u32[0 max] paramStructIndex = 0;
        stack mut u32[0 max] paramStructTypeToken = 0;
        stack mut ParamAbiFacts paramStructFacts = new();
        if (!TryResolveStructValueParamSwitchScrutineeFacts(
            stream,
            source,
            nodes,
            params,
            paramAbiFacts,
            scrutineeStart,
            scrutineeEnd,
            paramScrutinee,
            paramStructIndex,
            paramStructTypeToken,
            paramStructFacts))
        {
            return false;
        }

        scrutinee = paramScrutinee;
        structParamIndex = paramStructIndex;
        structTypeToken = paramStructTypeToken;
        useStructValueParam = true;
        structValueFacts = paramStructFacts;
        return true;
    }

    stack mut ConstructedObjectLocal objectLocal = new();
    if (scrutineeStart + 2 >= scrutineeEnd
        || stream.KindAt(scrutineeStart) != TokenKind.Identifier
        || stream.KindAt(scrutineeStart + 1) != TokenKind.Dot
        || stream.KindAt(scrutineeStart + 2) != TokenKind.Identifier
        || !TryFindConstructedObjectLocal(
            constructedObjectLocals,
            source,
            stream.StartAt(scrutineeStart),
            stream.LengthAt(scrutineeStart),
            objectLocal))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] nextToken = scrutineeStart;
    stack mut u32[0 max] fieldOffset = 0;
    stack mut u32[0 max] fieldAlignment = 0;
    stack mut u32[0 max] fieldTypeToken = 0;
    stack mut u32[0 max] leafMemberFactRow = 0;
    if (!TryResolveConstructedObjectMemberChainStorageField(
        stream,
        source,
        moduleFacts,
        objectLocal.TypeToken,
        scrutineeStart + 2,
        nextToken,
        fieldOffset,
        fieldAlignment,
        fieldTypeToken,
        leafMemberFactRow)
        || nextToken != scrutineeEnd
        || !SourceFieldTypeTokenIsAggregateStorage(stream, source, moduleFacts, fieldTypeToken))
    {
        return false;
    }

    stack mut ParamAbiFacts fieldStructValueFacts = new();
    if (!TryBuildStorageBackedStructSwitchValueFacts(
        stream,
        source,
        fieldTypeToken,
        fieldStructValueFacts)
        || fieldAlignment == 0)
    {
        return false;
    }

    fieldStructValueFacts.StructValueAlignment = fieldAlignment;
    scrutinee = MakeParseResult(MakeName(nodes, objectLocal.ParamIndex), scrutineeEnd);
    structParamIndex = objectLocal.ParamIndex;
    structTypeToken = fieldTypeToken;
    structBaseByteOffset = fieldOffset;
    structValueFacts = fieldStructValueFacts;
    return true;
}

internal fn bool TryLowerStructAggregateSwitchCaseCondition(
    mut borrow IrTable<MirInstruction> instrs,
    u32[0 max] structParamIndex,
    u32[0 max] structBaseByteOffset,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] patternStart,
    u32[0 max] patternCount,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternOffsets,
    borrow IrTable<u32[0 max]> fieldPatternAlignments,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternMemberFactRows,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues,
    out MirValueId condition)
{
    stack mut MirValueId currentCondition = MirConstIntTyped(instrs, MirType.I1, 1);
    if (!localOverrides.Contains(structParamIndex + 1))
    {
        return false;
    }

    stack u32[0 max] storageValue = localOverrides.Get(structParamIndex + 1);
    if (storageValue == 0)
    {
        return false;
    }

    stack mut u32[0 max] offset = 0;
    while willexit (offset < patternCount)
    {
        stack u32[0 max] row = patternStart + offset;
        if (!fieldPatternIndices.Contains(row)
            || !fieldPatternOffsets.Contains(row)
            || !fieldPatternAlignments.Contains(row)
            || !fieldPatternTypeCodes.Contains(row)
            || !fieldPatternMemberFactRows.Contains(row)
            || !fieldPatternKinds.Contains(row)
            || !fieldPatternMinValues.Contains(row)
            || !fieldPatternMaxValues.Contains(row))
        {
            return false;
        }

        stack u32[0 max] patternKind = fieldPatternKinds.Get(row);
        if (patternKind != SourceSwitchEnumPayloadPatternKindScalarInterval())
        {
            return false;
        }

        stack u32[0 max] fieldTypeCode = fieldPatternTypeCodes.Get(row);
        stack MirType fieldType = MirTypeForResolvedFieldTypeCode(fieldTypeCode);
        stack u32[0 max] patternFieldOffset = fieldPatternOffsets.Get(row);
        if (patternFieldOffset > 4294967295 - structBaseByteOffset)
        {
            return false;
        }

        stack u32[0 max] fieldOffset = structBaseByteOffset + patternFieldOffset;
        stack u32[0 max] fieldAlignment = fieldPatternAlignments.Get(row);
        stack u32[0 max] fieldMemberFactRow = fieldPatternMemberFactRows.Get(row);
        stack MirValueId fieldPointer = MirPtrOffset(
            instrs,
            MirValueIdOf(storageValue),
            fieldOffset,
            fieldAlignment);
        stack mut MirValueId fieldValue = MirValueIdOf(0);
        stack mut i64[min max] declaredLower = 0;
        stack mut i64[min max] declaredUpperExclusive = 0;
        if (TryDeclaredRangeFactForMemberPathFact(
                moduleFacts.MemberPathFacts,
                fieldMemberFactRow,
                declaredLower,
                declaredUpperExclusive))
        {
            fieldValue = MirLoadPtrAlignedTypedWithDeclaredRange(
                instrs,
                fieldType,
                fieldPointer,
                fieldAlignment,
                declaredLower,
                declaredUpperExclusive);
        }
        else
        {
            fieldValue = MirLoadPtrAlignedTyped(instrs, fieldType, fieldPointer, fieldAlignment);
        }

        stack i64[min max] fieldMinValue = fieldPatternMinValues.Get(row);
        stack i64[min max] fieldMaxValue = fieldPatternMaxValues.Get(row);
        stack MirValueId fieldCondition = LowerIntegerSwitchCaseConditionTyped(
            instrs,
            fieldValue,
            fieldMinValue,
            fieldMaxValue,
            fieldType);
        currentCondition = MirAndTyped(instrs, MirType.I1, currentCondition, fieldCondition);
        offset = offset + 1;
    }

    condition = currentCondition;
    return true;
}

internal fn bool TryLowerStructValueParamAggregateSwitchCaseCondition(
    mut borrow IrTable<MirInstruction> instrs,
    u32[0 max] structParamIndex,
    ParamAbiFacts structValueFacts,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] patternStart,
    u32[0 max] patternCount,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternMemberFactRows,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues,
    out MirValueId condition)
{
    stack mut MirValueId currentCondition = MirConstIntTyped(instrs, MirType.I1, 1);
    if (!structValueFacts.IsStructValue
        || structValueFacts.StructValueFieldCount == 0
        || structValueFacts.StructValueFieldCount > StructValueShapeMaxFields())
    {
        return false;
    }

    stack mut u32[0 max] offset = 0;
    while willexit (offset < patternCount)
    {
        stack u32[0 max] row = patternStart + offset;
        if (!fieldPatternIndices.Contains(row)
            || !fieldPatternTypeCodes.Contains(row)
            || !fieldPatternMemberFactRows.Contains(row)
            || !fieldPatternKinds.Contains(row)
            || !fieldPatternMinValues.Contains(row)
            || !fieldPatternMaxValues.Contains(row))
        {
            return false;
        }

        stack u32[0 max] patternKind = fieldPatternKinds.Get(row);
        if (patternKind != SourceSwitchEnumPayloadPatternKindScalarInterval())
        {
            return false;
        }

        stack u32[0 max] fieldIndex = fieldPatternIndices.Get(row);
        if (fieldIndex >= structValueFacts.StructValueFieldCount)
        {
            return false;
        }

        stack u32[0 max] fieldTypeCode = fieldPatternTypeCodes.Get(row);
        stack MirType fieldType = MirTypeForResolvedFieldTypeCode(fieldTypeCode);
        if (!StructValueShapeTypeIsSupported(fieldType)
            || StructValueShapeFieldStorageCodeAt(structValueFacts, fieldIndex) != StructValueShapeTypeCode(fieldType))
        {
            return false;
        }

        stack u32[0 max] fieldMemberFactRow = fieldPatternMemberFactRows.Get(row);
        stack mut MirValueId fieldValue = MirValueIdOf(0);
        stack mut i64[min max] declaredLower = 0;
        stack mut i64[min max] declaredUpperExclusive = 0;
        if (TryDeclaredRangeFactForMemberPathFact(
                moduleFacts.MemberPathFacts,
                fieldMemberFactRow,
                declaredLower,
                declaredUpperExclusive))
        {
            fieldValue = MirStructParamFieldWithDeclaredRange(
                instrs,
                structParamIndex,
                fieldIndex,
                structValueFacts.StructValueFieldCount,
                structValueFacts.StructValueShapeCode,
                fieldType,
                declaredLower,
                declaredUpperExclusive);
        }
        else
        {
            fieldValue = MirStructParamField(
                instrs,
                structParamIndex,
                fieldIndex,
                structValueFacts.StructValueFieldCount,
                structValueFacts.StructValueShapeCode,
                fieldType);
        }

        stack i64[min max] fieldMinValue = fieldPatternMinValues.Get(row);
        stack i64[min max] fieldMaxValue = fieldPatternMaxValues.Get(row);
        stack MirValueId fieldCondition = LowerIntegerSwitchCaseConditionTyped(
            instrs,
            fieldValue,
            fieldMinValue,
            fieldMaxValue,
            fieldType);
        currentCondition = MirAndTyped(instrs, MirType.I1, currentCondition, fieldCondition);
        offset = offset + 1;
    }

    condition = currentCondition;
    return true;
}

internal fn bool SwitchFirstCaseLabelIsBoolean(borrow TokenStream stream, u64[0 2 ** 63 - 1] switchIndex)
{
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] closeParen = MatchingBracketForMirLowering(stream, (u32[0 max])(switchIndex + 1));
    if (closeParen == (u32[0 max])(switchIndex + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] firstCase = (u64[0 2 ** 63 - 1])closeParen + 2;
    if (stream.KindAt(firstCase) != TokenKind.Case)
    {
        return false;
    }

    stack TokenKind labelKind = stream.KindAt(firstCase + 1);
    return labelKind == TokenKind.True || labelKind == TokenKind.False;
}

internal fn bool SwitchFirstCaseLabelIsListPattern(borrow TokenStream stream, u64[0 2 ** 63 - 1] switchIndex)
{
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] closeParen = MatchingBracketForMirLowering(stream, (u32[0 max])(switchIndex + 1));
    if (closeParen == (u32[0 max])(switchIndex + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] firstCase = (u64[0 2 ** 63 - 1])closeParen + 2;
    return stream.KindAt(firstCase) == TokenKind.Case
        && stream.KindAt(firstCase + 1) == TokenKind.LBrack;
}

internal fn bool SwitchFirstCaseLabelLooksQualifiedName(borrow TokenStream stream, u64[0 2 ** 63 - 1] switchIndex)
{
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] closeParen = MatchingBracketForMirLowering(stream, (u32[0 max])(switchIndex + 1));
    if (closeParen == (u32[0 max])(switchIndex + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] firstCase = (u64[0 2 ** 63 - 1])closeParen + 2;
    return stream.KindAt(firstCase) == TokenKind.Case
        && stream.KindAt(firstCase + 1) == TokenKind.Identifier
        && stream.KindAt(firstCase + 2) == TokenKind.Dot
        && stream.KindAt(firstCase + 3) == TokenKind.Identifier;
}

internal fn bool SwitchFirstCaseLabelLooksStructAggregatePattern(borrow TokenStream stream, u64[0 2 ** 63 - 1] switchIndex)
{
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] closeParen = MatchingBracketForMirLowering(stream, (u32[0 max])(switchIndex + 1));
    if (closeParen == (u32[0 max])(switchIndex + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] firstCase = (u64[0 2 ** 63 - 1])closeParen + 2;
    stack TokenKind suffixKind = stream.KindAt(firstCase + 2);
    return stream.KindAt(firstCase) == TokenKind.Case
        && stream.KindAt(firstCase + 1) == TokenKind.Identifier
        && (suffixKind == TokenKind.LParen || suffixKind == TokenKind.LBrace);
}

internal fn bool TryParseIntegerSwitchAssignmentCases(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] switchIndex,
    borrow IrTable<u32[0 max]> targetNameTokens,
    u64[0 2 ** 63 - 1] baseParamCount,
    out ExprParseResult scrutinee,
    mut borrow IrTable<i64[min max]> caseValues,
    mut borrow IrTable<i64[min max]> caseMaxValues,
    mut borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<u32[0 max]> assignedRoots,
    mut borrow IrTable<u32[0 max]> assignedTargetOffsets,
    out ParsedSwitchAssignmentArm defaultArm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    scrutinee = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack ExprParseResult parsedScrutinee = ParseExprIn(stream, source, nodes, params, funcNames, switchIndex + 2);
    if (stream.KindAt(parsedScrutinee.Next) != TokenKind.RParen
        || stream.KindAt(parsedScrutinee.Next + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] switchBodyOpen = parsedScrutinee.Next + 1;
    stack u32[0 max] switchBodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])switchBodyOpen);
    if (switchBodyClose == (u32[0 max])switchBodyOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = switchBodyOpen + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Case)
    {
        stack mut i64[min max] caseValue = 0;
        stack mut i64[min max] caseMaxValue = 0;
        stack mut u64[0 2 ** 63 - 1] afterCaseLabel = cursor + 1;
        if (!TryParseTerminalSwitchIntegerCaseInterval(stream, source, cursor + 1, caseValue, caseMaxValue, afterCaseLabel)
            || stream.KindAt(afterCaseLabel) != TokenKind.Colon
            || TerminalSwitchCaseIntervalOverlaps(caseValues, caseMaxValues, caseValue, caseMaxValue))
        {
            return false;
        }

        stack mut ParsedSwitchAssignmentArm caseArm = new();
        stack mut u64[0 2 ** 63 - 1] afterCase = afterCaseLabel + 1;
        if (!TryParseSwitchAssignmentArm(
            stream,
            source,
            nodes,
            params,
            baseParamCount,
            funcNames,
            targetNameTokens,
            afterCaseLabel + 1,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            caseArm,
            afterCase))
        {
            return false;
        }

        if (caseValues.Add(caseValue) == 0
            || caseMaxValues.Add(caseMaxValue) == 0
            || caseArms.Add(caseArm) == 0)
        {
            return false;
        }

        cursor = afterCase;
    }

    if (caseValues.Count() == 0)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ParsedSwitchAssignmentArm parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseSwitchAssignmentArm(
        stream,
        source,
        nodes,
        params,
        baseParamCount,
        funcNames,
        targetNameTokens,
        cursor + 2,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        parsedDefault,
        afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = parsedScrutinee;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}

internal fn bool TryParseFixedArrayListSwitchAssignmentCases(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
