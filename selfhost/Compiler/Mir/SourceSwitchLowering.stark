internal fn bool LowerAssignedIntegerSwitchCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<i64[min max]> caseMaxValues,
    bool useEnumPayloadPatterns,
    bool useFixedArrayListPatterns,
    bool useStructAggregatePatterns,
    u32[0 max] fixedArrayParamIndex,
    ParamAbiFacts fixedArrayFacts,
    bool useFixedArrayStorageLocal,
    FixedArrayStorageLocal fixedArrayLocal,
    u32[0 max] structParamIndex,
    u32[0 max] structTypeToken,
    u32[0 max] structBaseByteOffset,
    bool useStructValueParam,
    ParamAbiFacts structValueFacts,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    u32[0 max] ownerDeclarationIndex,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<u32[0 max]> casePayloadPatternStarts,
    borrow IrTable<u32[0 max]> casePayloadPatternCounts,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternTypeCodes,
    borrow IrTable<u32[0 max]> payloadPatternKinds,
    borrow IrTable<i64[min max]> payloadPatternMinValues,
    borrow IrTable<i64[min max]> payloadPatternMaxValues,
    borrow IrTable<u32[0 max]> payloadCaptureVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadCaptureOrdinals,
    borrow IrTable<u32[0 max]> payloadCaptureTypeCodes,
    borrow IrTable<u32[0 max]> caseListPatternStarts,
    borrow IrTable<u32[0 max]> caseListPatternCounts,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues,
    borrow IrTable<u32[0 max]> caseElementCaptureStarts,
    borrow IrTable<u32[0 max]> caseElementCaptureCounts,
    borrow IrTable<u32[0 max]> elementCaptureIndices,
    borrow IrTable<u32[0 max]> elementCaptureTypeCodes,
    borrow IrTable<u32[0 max]> structFieldPatternIndices,
    borrow IrTable<u32[0 max]> caseGuardNodes,
    borrow IrTable<u32[0 max]> structFieldPatternOffsets,
    borrow IrTable<u32[0 max]> structFieldPatternAlignments,
    borrow IrTable<u32[0 max]> structFieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> structFieldPatternMemberFactRows,
    borrow IrTable<u32[0 max]> structFieldPatternKinds,
    borrow IrTable<i64[min max]> structFieldPatternMinValues,
    borrow IrTable<i64[min max]> structFieldPatternMaxValues,
    borrow IrTable<u32[0 max]> caseStructFieldCaptureStarts,
    borrow IrTable<u32[0 max]> caseStructFieldCaptureCounts,
    borrow IrTable<u32[0 max]> structFieldCaptureIndices,
    borrow IrTable<u32[0 max]> structFieldCaptureOffsets,
    borrow IrTable<u32[0 max]> structFieldCaptureAlignments,
    borrow IrTable<u32[0 max]> structFieldCaptureTypeCodes,
    borrow IrTable<u32[0 max]> structFieldCaptureMemberFactRows,
    borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    ParsedSwitchAssignmentArm defaultArm,
    u32[0 max] targetCount,
    borrow IrTable<u32[0 max]> postLocalRoots,
    bool hasTerminalIf,
    ParsedIfReturnArms terminalIfArms,
    u32[0 max] returnRootNode,
    borrow IrTable<u32[0 max]> localTypes,
    u32[0 max] paramCount,
    u32[0 max] targetParamStart,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    stack mut u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (useFixedArrayListPatterns || useStructAggregatePatterns)
    {
        caseCountWide = caseArms.Count();
    }

    if (caseCountWide == 0 || caseArms.Count() != caseCountWide || targetCount == 0)
    {
        return false;
    }

    if (!useFixedArrayListPatterns && !useStructAggregatePatterns && caseMaxValues.Count() != caseCountWide)
    {
        return false;
    }

    if ((useEnumPayloadPatterns && (useFixedArrayListPatterns || useStructAggregatePatterns))
        || (useFixedArrayListPatterns && useStructAggregatePatterns)
        || (useStructValueParam && !useStructAggregatePatterns)
        || (useEnumPayloadPatterns
        && (casePayloadPatternStarts.Count() != caseCountWide
            || casePayloadPatternCounts.Count() != caseCountWide)))
    {
        return false;
    }

    if (useFixedArrayListPatterns
        && (caseListPatternStarts.Count() != caseCountWide
            || caseListPatternCounts.Count() != caseCountWide
            || caseElementCaptureStarts.Count() != caseCountWide
            || caseElementCaptureCounts.Count() != caseCountWide
            || !fixedArrayFacts.IsFixedArray
            || fixedArrayFacts.FixedArrayLength == 0
            || fixedArrayFacts.FixedArrayFieldTypeCode == SourceResolvedFieldTypeCodeInvalid()
            || !localTypes.Contains(fixedArrayParamIndex + 1)))
    {
        return false;
    }

    if (useFixedArrayListPatterns)
    {
        if (useFixedArrayStorageLocal)
        {
            if (fixedArrayLocal.ParamIndex != fixedArrayParamIndex
                || fixedArrayLocal.ArrayLength != fixedArrayFacts.FixedArrayLength
                || fixedArrayLocal.ElementSize != fixedArrayFacts.FixedArrayElementSize
                || fixedArrayLocal.Alignment != fixedArrayFacts.FixedArrayAlignment
                || fixedArrayLocal.FieldTypeCode != fixedArrayFacts.FixedArrayFieldTypeCode
                || localTypes.Get(fixedArrayParamIndex + 1) != SourceLocalTypeCodeNonValue()
                || !baseLocalOverrides.Contains(fixedArrayParamIndex + 1)
                || baseLocalOverrides.Get(fixedArrayParamIndex + 1) == 0)
            {
                return false;
            }
        }
        else if (localTypes.Get(fixedArrayParamIndex + 1) != SourceLocalTypeCodeFixedArrayParam())
        {
            return false;
        }
    }

    if (useStructAggregatePatterns
        && (caseListPatternStarts.Count() != caseCountWide
            || caseListPatternCounts.Count() != caseCountWide
            || caseStructFieldCaptureStarts.Count() != caseCountWide
            || caseStructFieldCaptureCounts.Count() != caseCountWide
            || caseGuardNodes.Count() != caseCountWide
            || !localTypes.Contains(structParamIndex + 1)))
    {
        return false;
    }

    if (useFixedArrayListPatterns
        && caseGuardNodes.Count() != 0
        && caseGuardNodes.Count() != caseCountWide)
    {
        return false;
    }

    if (!useFixedArrayListPatterns && !useStructAggregatePatterns && caseGuardNodes.Count() != 0)
    {
        return false;
    }

    if (useStructAggregatePatterns)
    {
        if (useStructValueParam)
        {
            if (!structValueFacts.IsStructValue
                || structValueFacts.StructValueFieldCount == 0
                || structValueFacts.StructValueFieldCount > StructValueShapeMaxFields())
            {
                return false;
            }
        }
        else if (localTypes.Get(structParamIndex + 1) != SourceLocalTypeCodeNonValue()
            || !baseLocalOverrides.Contains(structParamIndex + 1)
            || baseLocalOverrides.Get(structParamIndex + 1) == 0)
        {
            return false;
        }
