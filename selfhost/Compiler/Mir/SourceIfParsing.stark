        {
            return false;
        }

        stack TokenKind terminal = stream.KindAt(armStart + 1);
        if (terminal != TokenKind.Return && terminal != TokenKind.Become)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, moduleFacts, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        usesBecome = terminal == TokenKind.Become;
        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    stack TokenKind terminal = stream.KindAt(armStart);
    if (terminal != TokenKind.Return && terminal != TokenKind.Become)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, moduleFacts, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    usesBecome = terminal == TokenKind.Become;
    arm = parsedArm;
    nextToken = afterExpr;
    return true;
