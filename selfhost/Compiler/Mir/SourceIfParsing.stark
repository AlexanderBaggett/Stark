internal struct ParsedIfReturnArms
{
    ExprParseResult Condition;
    ExprParseResult ThenArm;
    ExprParseResult ElseArm;
    u32[0 max] ThenLocalRootStart;
    u32[0 max] ThenLocalRootCount;
    u32[0 max] ElseLocalRootStart;
    u32[0 max] ElseLocalRootCount;
    bool ThenBecome;
    bool ElseBecome;

    ParsedIfReturnArms()
    {
        self.Condition = new();
        self.ThenArm = new();
        self.ElseArm = new();
        self.ThenLocalRootStart = 0;
        self.ThenLocalRootCount = 0;
        self.ElseLocalRootStart = 0;
        self.ElseLocalRootCount = 0;
        self.ThenBecome = false;
        self.ElseBecome = false;
    }
}

internal struct ParsedNestedIfAssignmentArm
{
    bool IsNested;
    ExprParseResult Leaf;
    u32[0 max] LeafLocalRootStart;
    u32[0 max] LeafLocalRootCount;
    ParsedIfReturnArms Nested;
    u64[0 2 ** 63 - 1] Next;

    ParsedNestedIfAssignmentArm()
    {
        self.IsNested = false;
        self.Leaf = new();
        self.LeafLocalRootStart = 0;
        self.LeafLocalRootCount = 0;
        self.Nested = new();
        self.Next = 0;
    }
}

internal struct ParsedNestedIfAssignmentArms
{
    ExprParseResult Condition;
    ParsedNestedIfAssignmentArm ThenArm;
    ParsedNestedIfAssignmentArm ElseArm;

    ParsedNestedIfAssignmentArms()
    {
        self.Condition = new();
        self.ThenArm = new();
        self.ElseArm = new();
    }
}

internal struct ParsedRecursiveIfAssignmentArm
{
    bool IsNested;
    ExprParseResult Leaf;
    u32[0 max] LeafLocalRootStart;
    u32[0 max] LeafLocalRootCount;
    u32[0 max] NestedNode;
    u64[0 2 ** 63 - 1] Next;

    ParsedRecursiveIfAssignmentArm()
    {
        self.IsNested = false;
        self.Leaf = new();
        self.LeafLocalRootStart = 0;
        self.LeafLocalRootCount = 0;
        self.NestedNode = 0;
        self.Next = 0;
    }
}

internal struct ParsedRecursiveIfAssignmentNode
{
    ExprParseResult Condition;
    ParsedRecursiveIfAssignmentArm ThenArm;
    ParsedRecursiveIfAssignmentArm ElseArm;

    ParsedRecursiveIfAssignmentNode()
    {
        self.Condition = new();
        self.ThenArm = new();
        self.ElseArm = new();
    }
}

internal struct LoweredRecursiveIfAssignmentArm
{
    MirValueId Value;
    u32[0 max] ExitBlockIndex;

    LoweredRecursiveIfAssignmentArm()
    {
        self.Value = MirValueIdOf(0);
        self.ExitBlockIndex = 0;
    }
}

