internal fn bool TryParseTerminalIfArm(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out bool usesBecome,
    out u64[0 2 ** 63 - 1] nextToken)
{
    arm = new();
    usesBecome = false;
    nextToken = armStart;

    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack TokenKind terminal = stream.KindAt(armStart + 1);
        if (terminal != TokenKind.Return && terminal != TokenKind.Become)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        usesBecome = terminal == TokenKind.Become;
        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    stack TokenKind terminal = stream.KindAt(armStart);
    if (terminal != TokenKind.Return && terminal != TokenKind.Become)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    usesBecome = terminal == TokenKind.Become;
    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TryParseTerminalIfReturnArms(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] ifIndex,
    out ParsedIfReturnArms arms)
{
    arms = new();
    stack ExprParseResult condition = ParseExprIn(stream, source, nodes, params, funcNames, ifIndex + 1);

    stack mut u64[0 2 ** 63 - 1] afterThen = condition.Next;
    stack mut ExprParseResult thenArm = new();
    stack mut bool thenBecome = false;
    if (!TryParseTerminalIfArm(stream, source, nodes, params, funcNames, condition.Next, thenArm, thenBecome, afterThen))
    {
        return false;
    }

    if (stream.KindAt(afterThen) != TokenKind.Else)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterElse = afterThen + 1;
    stack mut ExprParseResult elseArm = new();
    stack mut bool elseBecome = false;
    if (!TryParseTerminalIfArm(stream, source, nodes, params, funcNames, afterThen + 1, elseArm, elseBecome, afterElse))
    {
        return false;
    }

    arms.Condition = condition;
    arms.ThenArm = thenArm;
    arms.ThenBecome = thenBecome;
    arms.ElseArm = elseArm;
    arms.ElseBecome = elseBecome;
    return true;
}

internal fn bool TryParseTerminalIfArmWithConstructedObjectLocals(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out bool usesBecome,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap_all(sourceValueFacts)
{
    arm = new();
    usesBecome = false;
    nextToken = armStart;

    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack TokenKind terminal = stream.KindAt(armStart + 1);
        if (terminal != TokenKind.Return && terminal != TokenKind.Become)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        usesBecome = terminal == TokenKind.Become;
        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    stack TokenKind terminal = stream.KindAt(armStart);
    if (terminal != TokenKind.Return && terminal != TokenKind.Become)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    usesBecome = terminal == TokenKind.Become;
    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TryParseTerminalIfReturnArmsWithConstructedObjectLocals(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] ifIndex,
    out ParsedIfReturnArms arms)
    where overlap_all(sourceValueFacts)
{
    arms = new();
    stack ExprParseResult condition = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, ifIndex + 1);

    stack mut u64[0 2 ** 63 - 1] afterThen = condition.Next;
    stack mut ExprParseResult thenArm = new();
    stack mut bool thenBecome = false;
    if (!TryParseTerminalIfArmWithConstructedObjectLocals(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, condition.Next, thenArm, thenBecome, afterThen))
    {
        return false;
    }

    if (stream.KindAt(afterThen) != TokenKind.Else)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterElse = afterThen + 1;
    stack mut ExprParseResult elseArm = new();
    stack mut bool elseBecome = false;
    if (!TryParseTerminalIfArmWithConstructedObjectLocals(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, afterThen + 1, elseArm, elseBecome, afterElse))
    {
        return false;
    }

    arms.Condition = condition;
    arms.ThenArm = thenArm;
    arms.ThenBecome = thenBecome;
    arms.ElseArm = elseArm;
    arms.ElseBecome = elseBecome;
    return true;
}

