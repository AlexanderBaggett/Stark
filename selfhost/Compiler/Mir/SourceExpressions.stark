import Compiler.Ir
import Compiler.Lexing
import Compiler.Mir.SourceRangeFacts
import Compiler.Mir.SourceSemanticProbes
import Compiler.Mir.SourceSymbols
import System.Memory
import System.Text
module Compiler.Mir.SourceExpressions

internal inline finite law u32[0 max] SourceLocalTypeCodeInt()
{
    return 0;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeBool()
{
    return 1;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeNonValue()
{
    return 2;
}

internal inline finite law u32[0 max] SourceLocalTypeCodePointer()
{
    return 3;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeStoredBool()
{
    return 4;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeStoredI8()
{
    return 5;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeStoredI16()
{
    return 6;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeStoredI32()
{
    return 7;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeStoredI64()
{
    return 8;
}

internal inline finite law bool SourceLocalTypeCodeIsStoredScalar(u32[0 max] typeCode)
{
    return typeCode >= SourceLocalTypeCodeStoredBool() && typeCode <= SourceLocalTypeCodeStoredI64();
}

internal inline finite law u32[0 max] SourceLocalTypeCodeEnumBase()
{
    return 16;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeStoredEnumBase()
{
    return 1073741824;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeForEnumOwnerDeclarationIndex(u32[0 max] ownerDeclarationIndex)
{
    return SourceLocalTypeCodeEnumBase() + ownerDeclarationIndex;
}

internal inline finite law u32[0 max] SourceLocalTypeCodeForStoredEnumOwnerDeclarationIndex(u32[0 max] ownerDeclarationIndex)
{
    return SourceLocalTypeCodeStoredEnumBase() + ownerDeclarationIndex;
}

internal inline finite law bool SourceLocalTypeCodeIsEnum(u32[0 max] typeCode)
{
    return typeCode >= SourceLocalTypeCodeEnumBase() && typeCode < SourceLocalTypeCodeStoredEnumBase();
}

internal inline finite law bool SourceLocalTypeCodeIsStoredEnum(u32[0 max] typeCode)
{
    return typeCode >= SourceLocalTypeCodeStoredEnumBase();
}

internal inline finite law u32[0 max] SourceLocalTypeCodeEnumOwnerDeclarationIndex(u32[0 max] typeCode)
{
    if (typeCode < SourceLocalTypeCodeEnumBase())
    {
        return 0;
    }

    return typeCode - SourceLocalTypeCodeEnumBase();
}

internal inline finite law u32[0 max] SourceLocalTypeCodeStoredEnumOwnerDeclarationIndex(u32[0 max] typeCode)
{
    if (typeCode < SourceLocalTypeCodeStoredEnumBase())
    {
        return 0;
    }

    return typeCode - SourceLocalTypeCodeStoredEnumBase();
}

internal inline finite law u32[0 max] SourceResolvedFieldTypeCodeInvalid()
{
    return 0;
}

public inline finite law u32[0 max] SourceResolvedFieldTypeCodeBool()
{
    return 1;
}

public inline finite law u32[0 max] SourceResolvedFieldTypeCodeI8()
{
    return 2;
}

public inline finite law u32[0 max] SourceResolvedFieldTypeCodeI16()
{
    return 3;
}

public inline finite law u32[0 max] SourceResolvedFieldTypeCodeI32()
{
    return 4;
}

public inline finite law u32[0 max] SourceResolvedFieldTypeCodeI64()
{
    return 5;
}

internal inline finite law u32[0 max] SourceResolvedFieldTypeCodeEnumBase()
{
    return 16;
}

internal inline finite law u32[0 max] SourceResolvedFieldTypeCodeForEnumOwnerDeclarationIndex(u32[0 max] ownerDeclarationIndex)
{
    return SourceResolvedFieldTypeCodeEnumBase() + ownerDeclarationIndex;
}

internal inline finite law bool SourceResolvedFieldTypeCodeIsEnum(u32[0 max] typeCode)
{
    return typeCode >= SourceResolvedFieldTypeCodeEnumBase();
}

internal inline finite law u32[0 max] SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(u32[0 max] typeCode)
{
    if (typeCode < SourceResolvedFieldTypeCodeEnumBase())
    {
        return 0;
    }

    return typeCode - SourceResolvedFieldTypeCodeEnumBase();
}

internal inline finite law u32[0 max] SourceResolvedFieldTypeCodeForStoredLocalTypeCode(u32[0 max] typeCode)
{
    if (typeCode == SourceLocalTypeCodeStoredBool())
    {
        return SourceResolvedFieldTypeCodeBool();
    }

    if (typeCode == SourceLocalTypeCodeStoredI8())
    {
        return SourceResolvedFieldTypeCodeI8();
    }

    if (typeCode == SourceLocalTypeCodeStoredI16())
    {
        return SourceResolvedFieldTypeCodeI16();
    }

    if (typeCode == SourceLocalTypeCodeStoredI32())
    {
        return SourceResolvedFieldTypeCodeI32();
    }

    if (typeCode == SourceLocalTypeCodeStoredI64())
    {
        return SourceResolvedFieldTypeCodeI64();
    }

    return SourceResolvedFieldTypeCodeInvalid();
}

// True when `k` is a `+`/`-` additive operator token.
internal fn bool IsAddSubToken(TokenKind k)
{
    return k == TokenKind.Plus || k == TokenKind.Minus;
}

// True when `k` is a `*`/`/`/`%` multiplicative operator token.
internal fn bool IsProductOpToken(TokenKind k)
{
    return k == TokenKind.Star || k == TokenKind.Div || k == TokenKind.Mod;
}

// === Structural expression typer (toward the real typer, #33) ===
// The token-counting type inference (InferExpressionType) has a structural ceiling — it
// cannot see expression shape, so it mis-types a comparison inside a call argument, a
// parenthesized comparison, or a chained comparison. The fix is a real expression AST
// and a typer that recurses over it. This is that AST: a FLAT node table (free functions
// over a directly-owned `IrTable<ExprNode>`, per the host-codegen discipline — no wrapper
// struct, no nested generic field). Each node is one of five kinds; Binary/Compare carry
// an operator and two child node ids; a Call carries its (single) argument node id;
// parentheses are a parser concern and produce no node (the inner expression stands in).
public enum ExprKind
{
    IntLitExpr,
    BoolLitExpr,
    NameExpr,
    FieldExpr,
    IndexedFieldExpr,
    EnumVariantExpr,
    EnumPayloadExpr,
    BinaryExpr,
    CompareExpr,
    CallExpr,
    CallArgLinkExpr,
}

public struct ExprNode
{
    ExprKind Kind;
    TokenKind Op;
    u32[0 max] Left;
    u32[0 max] Right;
    // A call's 2nd/3rd/4th argument nodes (0 = none); unused by the other node kinds. The
    // common AST call model carries four inline arguments (Right = first, Arg2/Arg3/Arg4 =
    // the rest) and spills wider calls through ExtraArgLink.
    u32[0 max] Arg2;
    u32[0 max] Arg3;
    u32[0 max] Arg4;
    // For CallExpr this is the first overflow argument link; for CallArgLinkExpr it is
    // the next overflow argument link. It is 0 for all other node kinds.
    u32[0 max] ExtraArgLink;
    i64[min max] Imm;

    ExprNode()
    {
        self.Kind = ExprKind.IntLitExpr;
        self.Op = TokenKind.Plus;
        self.Left = 0;
        self.Right = 0;
        self.Arg2 = 0;
        self.Arg3 = 0;
        self.Arg4 = 0;
        self.ExtraArgLink = 0;
        self.Imm = 0;
    }
}

// Node builders — each appends one node and returns its 1-based id.
public fn u32[0 max] MakeIntLit(mut borrow IrTable<ExprNode> nodes, i64[min max] value)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.IntLitExpr;
    node.Imm = value;
    return nodes.Add(node);
}

public fn u32[0 max] MakeBoolLit(mut borrow IrTable<ExprNode> nodes, bool value)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.BoolLitExpr;
    if (value)
    {
        node.Imm = 1;
    }
    else
    {
        node.Imm = 0;
    }

    return nodes.Add(node);
}

public fn u32[0 max] MakeName(mut borrow IrTable<ExprNode> nodes, u32[0 max] paramIndex)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.NameExpr;
    node.Left = paramIndex;
    return nodes.Add(node);
}

public fn u32[0 max] MakeResolvedFieldRead(
    mut borrow IrTable<ExprNode> nodes,
    u32[0 max] receiverParamIndex,
    u32[0 max] byteOffset,
    u32[0 max] alignBytes,
    u32[0 max] fieldTypeCode)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.FieldExpr;
    node.Left = receiverParamIndex;
    node.Right = byteOffset;
    node.Arg2 = alignBytes;
    node.Arg3 = fieldTypeCode;
    return nodes.Add(node);
}

public fn u32[0 max] MakeResolvedIndexedFieldRead(
    mut borrow IrTable<ExprNode> nodes,
    u32[0 max] receiverParamIndex,
    u32[0 max] indexNode,
    u32[0 max] baseByteOffset,
    u32[0 max] elementSizeBytes,
    u32[0 max] alignBytes,
    u32[0 max] fieldTypeCode)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.IndexedFieldExpr;
    node.Left = receiverParamIndex;
    node.Right = indexNode;
    node.Arg2 = baseByteOffset;
    node.Arg3 = elementSizeBytes;
    node.Arg4 = alignBytes;
    node.Imm = (i64[min max])fieldTypeCode;
    return nodes.Add(node);
}

public fn u32[0 max] MakeEnumVariant(
    mut borrow IrTable<ExprNode> nodes,
    TypeId ownerType,
    u32[0 max] variantOrdinal)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.EnumVariantExpr;
    node.Left = ownerType.Index();
    node.Right = variantOrdinal;
    return nodes.Add(node);
}

public fn u32[0 max] MakeEnumPayloadInsert(
    mut borrow IrTable<ExprNode> nodes,
    TypeId ownerType,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    u32[0 max] sourceEnumValue,
    u32[0 max] payloadValue,
    u32[0 max] payloadTypeCode)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.EnumPayloadExpr;
    node.Left = sourceEnumValue;
    node.Right = payloadValue;
    node.Arg2 = ownerType.Index();
    node.Arg3 = variantOrdinal;
    node.Arg4 = payloadOrdinal;
    node.Imm = (i64[min max])payloadTypeCode;
    return nodes.Add(node);
}

public fn u32[0 max] MakeBinary(mut borrow IrTable<ExprNode> nodes, TokenKind op, u32[0 max] left, u32[0 max] right)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.BinaryExpr;
    node.Op = op;
    node.Left = left;
    node.Right = right;
    return nodes.Add(node);
}

public fn u32[0 max] MakeCompare(mut borrow IrTable<ExprNode> nodes, TokenKind op, u32[0 max] left, u32[0 max] right)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.CompareExpr;
    node.Op = op;
    node.Left = left;
    node.Right = right;
    return nodes.Add(node);
}

// A call node. `callee` is the resolved function id (0 = unresolved, filled in once the
// parser threads a function-name table); `argCount` is the number of arguments WRITTEN at
// the call site (checked against the callee's declared arity); `arg1`..`arg4` are the four
// inline argument nodes and `extraArgLink` is the first overflow argument link.
public fn u32[0 max] MakeCallWithExtra(mut borrow IrTable<ExprNode> nodes, u32[0 max] callee, u32[0 max] argCount, u32[0 max] arg1, u32[0 max] arg2, u32[0 max] arg3, u32[0 max] arg4, u32[0 max] extraArgLink)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.CallExpr;
    node.Left = callee;
    node.Imm = (i64[min max])argCount;
    node.Right = arg1;
    node.Arg2 = arg2;
    node.Arg3 = arg3;
    node.Arg4 = arg4;
    node.ExtraArgLink = extraArgLink;
    return nodes.Add(node);
}

public fn u32[0 max] MakeCall(mut borrow IrTable<ExprNode> nodes, u32[0 max] callee, u32[0 max] argCount, u32[0 max] arg1, u32[0 max] arg2, u32[0 max] arg3, u32[0 max] arg4)
{
    return MakeCallWithExtra(nodes, callee, argCount, arg1, arg2, arg3, arg4, 0);
}

public fn u32[0 max] MakeCallArgLink(mut borrow IrTable<ExprNode> nodes, u32[0 max] argNode, u32[0 max] nextLink)
{
    stack mut ExprNode node = new();
    node.Kind = ExprKind.CallArgLinkExpr;
    node.Left = argNode;
    node.ExtraArgLink = nextLink;
    return nodes.Add(node);
}

internal fn u32[0 max] BuildCallExtraArgLinks(mut borrow IrTable<ExprNode> nodes, borrow IrTable<u32[0 max]> extraArgs)
{
    stack mut u64[0 2 ** 63 - 1] i = extraArgs.Count();
    stack mut u32[0 max] next = 0;
    while willexit (i > 0)
    {
        stack u32[0 max] arg = extraArgs.Get((u32[0 max])i);
        next = MakeCallArgLink(nodes, arg, next);
        i = (u64[0 2 ** 63 - 1])(i - 1);
    }

    return next;
}

public fn u32[0 max] CallArgumentNodeAt(borrow IrTable<ExprNode> nodes, ExprNode node, u32[0 max] paramIndex)
{
    if (paramIndex == 0)
    {
        return node.Right;
    }

    if (paramIndex == 1)
    {
        return node.Arg2;
    }

    if (paramIndex == 2)
    {
        return node.Arg3;
    }

    if (paramIndex == 3)
    {
        return node.Arg4;
    }

    stack mut u32[0 max] remaining = paramIndex - 4;
    stack mut u32[0 max] link = node.ExtraArgLink;
    while willexit (link != 0)
    {
        if (!nodes.Contains(link))
        {
            return 0;
        }

        stack ExprNode argLink = nodes.Get(link);
        if (argLink.Kind != ExprKind.CallArgLinkExpr)
        {
            return 0;
        }

        if (remaining == 0)
        {
            return argLink.Left;
        }

        remaining = remaining - 1;
        link = argLink.ExtraArgLink;
    }

    return 0;
}

// The STRUCTURAL type of the expression rooted at `id`, recursing over the AST. A literal,
// a variable, and a call are integers; an arithmetic node is an integer ONLY if both
// operands are integers (else a type error — a boolean fed to arithmetic, e.g.
// `(a < b) + 1`). Integer comparisons are boolean, and boolean equality/inequality is
// boolean; ordering comparisons over booleans and mixed comparisons are type errors.
// Unlike the token heuristic, this is correct on calls, parens, and chains by construction.
// As `TypeOfNode`, but a name's type comes from `localTypes` (a per-index type table).
// Boolean, storage-only, pointer, and enum-owner codes preserve source facts through MIR
// lowering; absent entries stay integer for the bootstrap expression grammar.
public fn ExprType TypeOfNodeWithLocals(borrow IrTable<ExprNode> nodes, u32[0 max] id, borrow IrTable<u32[0 max]> localTypes)
{
    if (!nodes.Contains(id))
    {
        return ExprType.ErrorType;
    }

    stack ExprNode node = nodes.Get(id);
    switch (node.Kind)
    {
        case ExprKind.IntLitExpr:
            return ExprType.IntType;
        case ExprKind.BoolLitExpr:
            return ExprType.BoolType;
        case ExprKind.NameExpr:
            if (localTypes.Contains(node.Left + 1))
            {
                stack u32[0 max] typeCode = localTypes.Get(node.Left + 1);
                if (typeCode == SourceLocalTypeCodeBool())
                {
                    return ExprType.BoolType;
                }

                if (SourceLocalTypeCodeIsStoredScalar(typeCode))
                {
                    if (typeCode == SourceLocalTypeCodeStoredBool())
                    {
                        return ExprType.BoolType;
                    }

                    return ExprType.IntType;
                }

                if (typeCode == SourceLocalTypeCodeNonValue())
                {
                    return ExprType.ErrorType;
                }

                if (typeCode == SourceLocalTypeCodePointer())
                {
                    return ExprType.PtrType;
                }

                if (SourceLocalTypeCodeIsEnum(typeCode) || SourceLocalTypeCodeIsStoredEnum(typeCode))
                {
                    return ExprType.EnumType;
                }
            }

            return ExprType.IntType;
        case ExprKind.FieldExpr:
            if (node.Arg3 == SourceResolvedFieldTypeCodeBool())
            {
                return ExprType.BoolType;
            }

            if (SourceResolvedFieldTypeCodeIsEnum(node.Arg3))
            {
                return ExprType.EnumType;
            }

            if (node.Arg3 == SourceResolvedFieldTypeCodeI8()
                || node.Arg3 == SourceResolvedFieldTypeCodeI16()
                || node.Arg3 == SourceResolvedFieldTypeCodeI32()
                || node.Arg3 == SourceResolvedFieldTypeCodeI64())
            {
                return ExprType.IntType;
            }

            return ExprType.ErrorType;
        case ExprKind.IndexedFieldExpr:
            stack u32[0 max] indexedTypeCode = (u32[0 max])node.Imm;
            if (indexedTypeCode == SourceResolvedFieldTypeCodeBool())
            {
                return ExprType.BoolType;
            }

            if (SourceResolvedFieldTypeCodeIsEnum(indexedTypeCode))
            {
                return ExprType.EnumType;
            }

            if (indexedTypeCode == SourceResolvedFieldTypeCodeI8()
                || indexedTypeCode == SourceResolvedFieldTypeCodeI16()
                || indexedTypeCode == SourceResolvedFieldTypeCodeI32()
                || indexedTypeCode == SourceResolvedFieldTypeCodeI64())
            {
                return ExprType.IntType;
            }

            return ExprType.ErrorType;
        case ExprKind.EnumVariantExpr:
            return ExprType.EnumType;
        case ExprKind.EnumPayloadExpr:
            if (TypeOfNodeWithLocals(nodes, node.Left, localTypes) == ExprType.EnumType
                && TypeOfNodeWithLocals(nodes, node.Right, localTypes) != ExprType.ErrorType)
            {
                return ExprType.EnumType;
            }

            return ExprType.ErrorType;
        case ExprKind.CallExpr:
            return ExprType.IntType;
        case ExprKind.CallArgLinkExpr:
            return ExprType.ErrorType;
        case ExprKind.BinaryExpr:
            if (TypeOfNodeWithLocals(nodes, node.Left, localTypes) == ExprType.IntType && TypeOfNodeWithLocals(nodes, node.Right, localTypes) == ExprType.IntType)
            {
                return ExprType.IntType;
            }

            return ExprType.ErrorType;
        case ExprKind.CompareExpr:
            stack ExprType leftType = TypeOfNodeWithLocals(nodes, node.Left, localTypes);
            stack ExprType rightType = TypeOfNodeWithLocals(nodes, node.Right, localTypes);
            if (leftType == ExprType.IntType && rightType == ExprType.IntType)
            {
                return ExprType.BoolType;
            }

            if (leftType == ExprType.BoolType
                && rightType == ExprType.BoolType
                && (node.Op == TokenKind.EqEq || node.Op == TokenKind.Neq))
            {
                return ExprType.BoolType;
            }

            if (leftType == ExprType.EnumType
                && rightType == ExprType.EnumType
                && (node.Op == TokenKind.EqEq || node.Op == TokenKind.Neq))
            {
                return ExprType.BoolType;
            }

            return ExprType.ErrorType;
    }
}

internal fn u32[0 max] SourceLocalTypeCodeForNodeWithLocals(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] id,
    borrow IrTable<u32[0 max]> localTypes)
{
    if (nodes.Contains(id))
    {
        stack ExprNode node = nodes.Get(id);
        if (node.Kind == ExprKind.EnumVariantExpr && node.Left > 0)
        {
            return SourceLocalTypeCodeForEnumOwnerDeclarationIndex(node.Left - 1);
        }

        if (node.Kind == ExprKind.EnumPayloadExpr && node.Arg2 > 0)
        {
            return SourceLocalTypeCodeForEnumOwnerDeclarationIndex(node.Arg2 - 1);
        }

        if (node.Kind == ExprKind.FieldExpr && SourceResolvedFieldTypeCodeIsEnum(node.Arg3))
        {
            return SourceLocalTypeCodeForEnumOwnerDeclarationIndex(SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(node.Arg3));
        }

        if (node.Kind == ExprKind.IndexedFieldExpr
            && node.Imm >= 0
            && SourceResolvedFieldTypeCodeIsEnum((u32[0 max])node.Imm))
        {
            return SourceLocalTypeCodeForEnumOwnerDeclarationIndex(SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex((u32[0 max])node.Imm));
        }

        if (node.Kind == ExprKind.NameExpr && localTypes.Contains(node.Left + 1))
        {
            stack u32[0 max] sourceCode = localTypes.Get(node.Left + 1);
            if (SourceLocalTypeCodeIsEnum(sourceCode))
            {
                return sourceCode;
            }

            if (SourceLocalTypeCodeIsStoredEnum(sourceCode))
            {
                return SourceLocalTypeCodeForEnumOwnerDeclarationIndex(SourceLocalTypeCodeStoredEnumOwnerDeclarationIndex(sourceCode));
            }
        }
    }

    stack ExprType type = TypeOfNodeWithLocals(nodes, id, localTypes);
    if (type == ExprType.BoolType)
    {
        return SourceLocalTypeCodeBool();
    }

    if (type == ExprType.PtrType)
    {
        return SourceLocalTypeCodePointer();
    }

    if (type == ExprType.ErrorType)
    {
        return SourceLocalTypeCodeNonValue();
    }

    return SourceLocalTypeCodeInt();
}

public fn bool TryGetSourceExpressionEnumOwnerTypeIndexForNode(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] id,
    borrow IrTable<u32[0 max]> localTypes,
    out u32[0 max] ownerTypeIndex)
{
    ownerTypeIndex = 0;
    if (!nodes.Contains(id))
    {
        return false;
    }

    stack ExprNode node = nodes.Get(id);
    if (node.Kind == ExprKind.EnumVariantExpr)
    {
        ownerTypeIndex = node.Left;
        return ownerTypeIndex > 0;
    }

    if (node.Kind == ExprKind.EnumPayloadExpr)
    {
        ownerTypeIndex = node.Arg2;
        return ownerTypeIndex > 0;
    }

    if (node.Kind == ExprKind.FieldExpr && SourceResolvedFieldTypeCodeIsEnum(node.Arg3))
    {
        ownerTypeIndex = SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(node.Arg3) + 1;
        return true;
    }

    if (node.Kind == ExprKind.IndexedFieldExpr
        && node.Imm >= 0
        && SourceResolvedFieldTypeCodeIsEnum((u32[0 max])node.Imm))
    {
        ownerTypeIndex = SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex((u32[0 max])node.Imm) + 1;
        return true;
    }

    if (node.Kind != ExprKind.NameExpr || !localTypes.Contains(node.Left + 1))
    {
        return false;
    }

    stack u32[0 max] typeCode = localTypes.Get(node.Left + 1);
    if (SourceLocalTypeCodeIsStoredEnum(typeCode))
    {
        ownerTypeIndex = SourceLocalTypeCodeStoredEnumOwnerDeclarationIndex(typeCode) + 1;
        return true;
    }

    if (!SourceLocalTypeCodeIsEnum(typeCode))
    {
        return false;
    }

    ownerTypeIndex = SourceLocalTypeCodeEnumOwnerDeclarationIndex(typeCode) + 1;
    return true;
}

internal fn bool TryGetSourceLocalEnumOwnerDeclarationIndexForNode(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] id,
    borrow IrTable<u32[0 max]> localTypes,
    out u32[0 max] ownerDeclarationIndex)
{
    ownerDeclarationIndex = 0;
    stack mut u32[0 max] ownerTypeIndex = 0;
    if (!TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, id, localTypes, ownerTypeIndex)
        || ownerTypeIndex == 0)
    {
        return false;
    }

    ownerDeclarationIndex = ownerTypeIndex - 1;
    return true;
}

// Types an expression where every name is a parameter (integer) — the common case.
public fn ExprType TypeOfNode(borrow IrTable<ExprNode> nodes, u32[0 max] id)
{
    stack mut IrTable<u32[0 max]> noLocalTypes = new();
    return TypeOfNodeWithLocals(nodes, id, noLocalTypes);
}

// === Recursive-descent expression parser (toward the real typer, #33) ===
// Builds the `ExprNode` AST from source. Stark has no mutable-borrow cursor (an in-out
// primitive index is the write-only `out` mode), so each parser THREADS the cursor by
// RETURN VALUE: it takes a cursor by value and returns the node it built plus the next
// cursor. Recursion (parentheses, call arguments) composes through these returns. Grammar,
// lowest precedence first: compare := add ((< > <= >= == !=) add)* ; add := mul ((+ -) mul)* ;
// mul := primary ((* / %) primary)* ; primary := int | name | name(args) | ( compare ).
// Left-associative folding makes a chained comparison a nested Compare node, which the
// structural typer then flags.
public struct ExprParseResult
{
    u32[0 max] NodeId;
    u64[0 2 ** 63 - 1] Next;

    ExprParseResult()
    {
        self.NodeId = 0;
        self.Next = 0;
    }
}

internal fn ExprParseResult MakeParseResult(u32[0 max] nodeId, u64[0 2 ** 63 - 1] next)
{
    stack mut ExprParseResult result = new();
    result.NodeId = nodeId;
    result.Next = next;
    return result;
}

internal struct ParsedSwitchAssignmentArm
{
    ExprParseResult Assigned;
    u32[0 max] AssignedRootStart;
    u32[0 max] AssignedRootCount;
    u32[0 max] LocalRootStart;
    u32[0 max] LocalRootCount;

    ParsedSwitchAssignmentArm()
    {
        self.Assigned = new();
        self.AssignedRootStart = 0;
        self.AssignedRootCount = 0;
        self.LocalRootStart = 0;
        self.LocalRootCount = 0;
    }
}

// Resolves an identifier span to a 0-based parameter index in first-appearance order,
// appending it to `params` the first time it is seen (so `a + b` makes `a`->0, `b`->1,
// and a reused name maps to the same index).
internal fn u32[0 max] ResolveParam(mut borrow IrTable<ParamName> params, borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] length)
{
    stack i64[min max] existing = ParamIndexOf(params, source, start, length);
    if (existing >= 0)
    {
        return (u32[0 max])existing;
    }

    stack mut ParamName name = new();
    name.Start = start;
    name.Length = length;
    stack u32[0 max] added = params.Add(name);
    return added - 1;
}

internal fn bool CopyParamNamePrefix(borrow IrTable<ParamName> sourceParams, u64[0 2 ** 63 - 1] count, mut borrow IrTable<ParamName> destination)
{
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack ParamName name = sourceParams.Get((u32[0 max])(i + 1));
        if (destination.Add(name) == 0)
        {
            return false;
        }

        i = i + 1;
    }

    return true;
}

internal fn bool TokenTextExistsInTokenTable(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<u32[0 max]> tokens,
    u32[0 max] token)
{
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < tokens.Count())
    {
        stack u32[0 max] current = tokens.Get((u32[0 max])(i + 1));
        if (TokenTextEqualsAsciiSpan(stream, source, current, token))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TryFindSwitchTargetOffsetForToken(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<u32[0 max]> targetNameTokens,
    u32[0 max] token,
    out u32[0 max] targetOffset)
{
    targetOffset = 0;
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < targetNameTokens.Count())
    {
        stack u32[0 max] current = targetNameTokens.Get((u32[0 max])(i + 1));
        if (TokenTextEqualsAsciiSpan(stream, source, current, token))
        {
            targetOffset = (u32[0 max])i;
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool SwitchAssignmentArmTargetOffsetExists(
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    u32[0 max] assignedRootStart,
    u32[0 max] assignedRootCount,
    u32[0 max] targetOffset)
{
    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])assignedRootCount)
    {
        stack u32[0 max] slot = assignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedTargetOffsets.Contains(slot))
        {
            return false;
        }

        stack u32[0 max] currentOffset = assignedTargetOffsets.Get(slot);
        if (currentOffset == targetOffset)
        {
            return true;
        }

        assignedIndex = assignedIndex + 1;
    }

    return false;
}

internal fn ExprParseResult ParsePrimaryIn(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, borrow IrTable<ParamName> funcNames, u64[0 2 ** 63 - 1] cursor)
{
    stack TokenKind k = stream.KindAt(cursor);
    if (k == TokenKind.IntegerLiteral)
    {
        stack i64[min max] value = ParseDigitSpan(source, stream.StartAt(cursor), stream.LengthAt(cursor));
        return MakeParseResult(MakeIntLit(nodes, value), cursor + 1);
    }

    if (k == TokenKind.True)
    {
        return MakeParseResult(MakeBoolLit(nodes, true), cursor + 1);
    }

    if (k == TokenKind.False)
    {
        return MakeParseResult(MakeBoolLit(nodes, false), cursor + 1);
    }

    if (k == TokenKind.Minus)
    {
        // Unary minus: `-<primary>` lowers as `0 - <primary>`. It binds at the PRIMARY level
        // (tighter than the binary operators), so `-x * y` parses as `(-x) * y` and `2 - -3`
        // as `2 - (-3)`. A leading `-` is unambiguously unary here (a binary `-` is consumed
        // between terms by ParseAdd, never at the start of a primary).
        stack ExprParseResult operand = ParsePrimaryIn(stream, source, nodes, params, funcNames, cursor + 1);
        stack u32[0 max] zero = MakeIntLit(nodes, 0);
        stack u32[0 max] negated = MakeBinary(nodes, TokenKind.Minus, zero, operand.NodeId);
        return MakeParseResult(negated, operand.Next);
    }

    if (k == TokenKind.LParen)
    {
        // Parenthesized sub-expression: parse it, then skip the matching `)`.
        stack ExprParseResult inner = ParseExprIn(stream, source, nodes, params, funcNames, cursor + 1);
        return MakeParseResult(inner.NodeId, inner.Next + 1);
    }

    if (k == TokenKind.Identifier && stream.KindAt(cursor + 1) == TokenKind.LParen)
    {
        // A call `name ( args )`. The callee NAME at `cursor` resolves against the
        // function-name table to its 1-based function id (0 = unresolved — e.g. a call in a
        // single-function context, whose table is empty, or a call to an unknown function).
        stack i64[min max] calleeIndex = ParamIndexOf(funcNames, source, stream.StartAt(cursor), stream.LengthAt(cursor));
        stack mut u32[0 max] callee = 0;
        if (calleeIndex >= 0)
        {
            callee = (u32[0 max])(calleeIndex + 1);
        }

        // Empty args -> a 0-argument call.
        if (stream.KindAt(cursor + 2) == TokenKind.RParen)
        {
            return MakeParseResult(MakeCall(nodes, callee, 0, 0, 0, 0, 0), cursor + 3);
        }

        // Parse the first argument, then consume any further comma-separated arguments,
        // CAPTURING up to four and COUNTING the total — the count is checked against the
        // callee's arity at validation (the AST model lowers up to four arguments, so a wider
        // call is rejected by the count, not silently truncated).
        stack ExprParseResult firstArg = ParseExprIn(stream, source, nodes, params, funcNames, cursor + 2);
        stack mut u64[0 2 ** 63 - 1] argCursor = firstArg.Next;
        stack mut u32[0 max] argCount = 1;
        stack mut u32[0 max] secondArg = 0;
        stack mut u32[0 max] thirdArg = 0;
        stack mut u32[0 max] fourthArg = 0;
        stack mut IrTable<u32[0 max]> extraArgs = new();
        while willexit (stream.KindAt(argCursor) == TokenKind.Comma)
        {
            stack ExprParseResult more = ParseExprIn(stream, source, nodes, params, funcNames, argCursor + 1);
            if (argCount == 1)
            {
                secondArg = more.NodeId;
            }
            else if (argCount == 2)
            {
                thirdArg = more.NodeId;
            }
            else if (argCount == 3)
            {
                fourthArg = more.NodeId;
            }
            else
            {
                stack u32[0 max] addedExtra = extraArgs.Add(more.NodeId);
                if (addedExtra == 0)
                {
                    return MakeParseResult(0, argCursor);
                }
            }

            argCursor = more.Next;
            argCount = argCount + 1;
        }

        stack u32[0 max] extraArgLink = BuildCallExtraArgLinks(nodes, extraArgs);
        return MakeParseResult(MakeCallWithExtra(nodes, callee, argCount, firstArg.NodeId, secondArg, thirdArg, fourthArg, extraArgLink), argCursor + 1);
    }

    // A bare name: resolve it to a parameter index (first-appearance order).
    stack u32[0 max] paramIndex = ResolveParam(params, source, stream.StartAt(cursor), stream.LengthAt(cursor));
    return MakeParseResult(MakeName(nodes, paramIndex), cursor + 1);
}

internal fn ExprParseResult ParseMulIn(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, borrow IrTable<ParamName> funcNames, u64[0 2 ** 63 - 1] cursor)
{
    stack mut ExprParseResult left = ParsePrimaryIn(stream, source, nodes, params, funcNames, cursor);
    while willexit (IsProductOpToken(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ExprParseResult right = ParsePrimaryIn(stream, source, nodes, params, funcNames, left.Next + 1);
        left.NodeId = MakeBinary(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

internal fn ExprParseResult ParseAddIn(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, borrow IrTable<ParamName> funcNames, u64[0 2 ** 63 - 1] cursor)
{
    stack mut ExprParseResult left = ParseMulIn(stream, source, nodes, params, funcNames, cursor);
    while willexit (IsAddSubToken(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ExprParseResult right = ParseMulIn(stream, source, nodes, params, funcNames, left.Next + 1);
        left.NodeId = MakeBinary(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

// The full expression parser, parameterized by a function-name table so a call's callee
// resolves to its function id. `ParseExpr` below is the thin wrapper used by the
// single-function/expression paths (which pass an empty table — their calls, if any,
// resolve to the 0 sentinel); the multi-function module compiler calls this directly.
internal fn ExprParseResult ParseExprIn(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, borrow IrTable<ParamName> funcNames, u64[0 2 ** 63 - 1] cursor)
{
    stack mut ExprParseResult left = ParseAddIn(stream, source, nodes, params, funcNames, cursor);
    while willexit (IsComparisonOperator(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ExprParseResult right = ParseAddIn(stream, source, nodes, params, funcNames, left.Next + 1);
        left.NodeId = MakeCompare(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

// Single-function/expression entry: no cross-function call resolution (an empty
// function-name table), so an unqualified `name(args)` keeps the 0 callee sentinel.
internal fn ExprParseResult ParseExpr(borrow TokenStream stream, borrow i8[min max][] source, mut borrow IrTable<ExprNode> nodes, mut borrow IrTable<ParamName> params, u64[0 2 ** 63 - 1] cursor)
{
    stack mut IrTable<ParamName> noFuncs = new();
    return ParseExprIn(stream, source, nodes, params, noFuncs, cursor);
}

// Lexes ONE expression, parses it into the AST, and returns the STRUCTURAL type of the
// root — the correct successor to the token-counting `InferExpressionType`.
public fn ExprType InferSourceExpressionType(ascii source)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack mut IrTable<ExprNode> nodes = new();
            stack mut IrTable<ParamName> params = new();
            stack ExprParseResult root = ParseExpr(stream, sourceBytes, nodes, params, 0);
            return TypeOfNode(nodes, root.NodeId);
        case LexResult<TokenStream>.Err(var lexError):
            return ExprType.ErrorType;
    }
}
