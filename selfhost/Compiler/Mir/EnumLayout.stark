    u64[0 max] TagOffsetBytesValue;
    u64[0 max] TagSizeBytesValue;
    u64[0 max] TagAlignmentBytesValue;
    bool TagMisalignedValue;
    u64[0 max] SizeBytesValue;
    u64[0 max] AlignmentBytesValue;
    bool ConcreteLayoutValue;
    bool MisalignedStorageValue;

    MirEnumAbiLayoutFacts()
    {
        self.HasFactsValue = false;
        self.OwnerTypeValue = TypeIdOf(0);
        self.OwnerNameTokenValue = 0;
        self.VariantCountValue = 0;
        self.PayloadFieldCountValue = 0;
        self.TagOffsetBytesValue = 0;
        self.TagSizeBytesValue = 0;
        self.TagAlignmentBytesValue = 0;
        self.TagMisalignedValue = false;
        self.SizeBytesValue = 0;
        self.AlignmentBytesValue = 0;
        self.ConcreteLayoutValue = false;
        self.MisalignedStorageValue = false;
    }

