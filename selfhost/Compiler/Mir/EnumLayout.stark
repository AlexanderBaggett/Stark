{
    MirEnumLayoutFactRowKind RowKindValue;
    TypeId OwnerTypeValue;
    u32[0 max] OwnerNameTokenValue;
    u32[0 max] VariantOrdinalValue;
    u32[0 max] VariantNameTokenValue;
    u32[0 max] VariantTagValue;
    u32[0 max] PayloadCountValue;
    u32[0 max] PayloadOrdinalValue;
    u32[0 max] PayloadNameTokenValue;
    Compiler.Typing.TypedEnumPayloadModel.TypedEnumPayloadKind PayloadKindValue;
    Compiler.Typing.TypedEnumPayloadModel.TypedEnumVariantRole VariantRoleValue;
    bool ErrorFunnelValue;
    bool UsesNamedPayloadsValue;
    u32[0 max] StorageFieldOrdinalValue;
    u64[0 max] OffsetBytesValue;
    u64[0 max] SizeBytesValue;
    u64[0 max] AlignmentBytesValue;
    bool MisalignedValue;
    TypedSignatureTypeKind TypeKindValue;
    u32[0 max] TypeHeadTokenValue;
    u32[0 max] TypePrimaryTokenValue;
    u32[0 max] BitWidthValue;
    u32[0 max] TypeFlagsValue;
    bool ConcreteLayoutValue;

    MirEnumLayoutFact()
    {
        self.RowKindValue = MirEnumLayoutFactRowKind.Unknown;
        self.OwnerTypeValue = TypeIdOf(0);
        self.OwnerNameTokenValue = 0;
        self.VariantOrdinalValue = 0;
        self.VariantNameTokenValue = 0;
        self.VariantTagValue = 0;
        self.PayloadCountValue = 0;
        self.PayloadOrdinalValue = 0;
        self.PayloadNameTokenValue = 0;
        self.PayloadKindValue = Compiler.Typing.TypedEnumPayloadModel.TypedEnumPayloadKind.Unknown;
        self.VariantRoleValue = Compiler.Typing.TypedEnumPayloadModel.TypedEnumVariantRole.None;
        self.ErrorFunnelValue = false;
        self.UsesNamedPayloadsValue = false;
        self.StorageFieldOrdinalValue = 0;
        self.OffsetBytesValue = 0;
        self.SizeBytesValue = 0;
        self.AlignmentBytesValue = 0;
        self.MisalignedValue = false;
        self.TypeKindValue = TypedSignatureTypeKind.Unknown;
        self.TypeHeadTokenValue = 0;
        self.TypePrimaryTokenValue = 0;
        self.BitWidthValue = 0;
        self.TypeFlagsValue = 0;
        self.ConcreteLayoutValue = false;
    }

