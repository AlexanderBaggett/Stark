        self.ThenArm = new();
        self.ElseArm = new();
    }
}

internal struct LoweredRecursiveIfAssignmentArm
{
    MirValueId Value;
    u32[0 max] ExitBlockIndex;

    LoweredRecursiveIfAssignmentArm()
    {
        self.Value = MirValueIdOf(0);
        self.ExitBlockIndex = 0;
    }
}

