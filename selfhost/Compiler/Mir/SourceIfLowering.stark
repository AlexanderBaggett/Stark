                    && hasAssign
                    && objectTypeToken != 0
                    && TryParseTargetTypedObjectConstructorShape(stream, source, objectTypeToken, assignToken, statementEnd, bodyOpen, bodyClose))
                {
                    objectConstructor = true;
                }
                else if (objectStorageLocal
                    && hasAssign
                    && objectTypeToken != 0
                    && TryParseTargetTypedPositionalRecordConstructorShape(stream, source, objectTypeToken, assignToken, statementEnd, argsOpen, argsClose))
                {
                    objectConstructor = true;
                    positionalRecordConstructor = true;
                }

                if (objectConstructor)
                {
                    if (localStorage == TokenKind.Heap && signature.LawKind())
                    {
                        return false;
                    }

                    stack u32[0 max] objectAllocationSize = TypeKnownByteExtentForLocalWithEnums(stream, source, moduleFacts, objectTypeToken);
                    stack u32[0 max] objectAllocationAlign = TypeKnownByteAlignmentWithEnums(stream, source, moduleFacts, objectTypeToken);
                    if (objectAllocationSize == 0 || objectAllocationAlign == 0)
                    {
                        return false;
                    }

                    stack mut MirValueId objectAllocation = new();
                    if (localStorage == TokenKind.Heap)
                    {
                        objectAllocation = MirHeapAlloc(instrs, objectAllocationSize, objectAllocationAlign);
                    }
                    else
                    {
                        objectAllocation = MirStackAlloc(instrs, objectAllocationSize, objectAllocationAlign);
                    }

                    stack u32[0 max] objectLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                    stack u32[0 max] objectNonValueRoot = localRoots.Add(0);
                    stack u32[0 max] objectNonValueType = localTypes.Add(SourceLocalTypeCodeNonValue());
                    stack u32[0 max] objectOverrideValue = localOverrideValues.Add(objectAllocation.Index());
                    if (sourceValueFacts.Add(new ValueFacts()) == 0)
                    {
                        return false;
                    }

                    if (positionalRecordConstructor)
                    {
                        if (!TryParseStackObjectPositionalRecordConstructorInitializers(
                            stream,
                            source,
                            moduleFacts,
                            objectTypeToken,
                            argsOpen,
                            argsClose,
                            objectNonValueRoot,
                            objectLocalIndex,
                            objectAllocation,
                            nodes,
                            params,
                            funcNames,
                            constructedObjectLocals,
                            localTypes,
                            sourceValueFacts,
                            stackObjectFieldInitializers))
                        {
                            return false;
                        }
                    }
                    else
                    {
                        if (!TryParseStackObjectFieldInitializers(
                            stream,
                            source,
                            moduleFacts,
                            objectTypeToken,
                            bodyOpen,
                            bodyClose,
                            objectNonValueRoot,
                            objectLocalIndex,
                            objectAllocation,
                            nodes,
                            params,
                            funcNames,
                            constructedObjectLocals,
                            localTypes,
                            sourceValueFacts,
                            stackObjectFieldInitializers))
                        {
                            return false;
                        }
                    }

                    stack mut ConstructedObjectLocal constructedObjectLocal = new();
                    constructedObjectLocal.Start = nameStart;
                    constructedObjectLocal.Length = nameLength;
                    constructedObjectLocal.ParamIndex = objectLocalIndex;
                    constructedObjectLocal.TypeToken = objectTypeToken;
                    stack u32[0 max] addedConstructedObjectLocal = constructedObjectLocals.Add(constructedObjectLocal);

                    cursor = statementEnd + 1;
                    continue;
                }

                stack u32[0 max] nonArenaLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] nonArenaRoot = localRoots.Add(0);
                stack u32[0 max] nonArenaType = localTypes.Add(2);
                stack u32[0 max] nonArenaOverrideValue = localOverrideValues.Add(0);
                if (sourceValueFacts.Add(new ValueFacts()) == 0)
                {
                    return false;
                }

                cursor = statementEnd + 1;
                continue;
            }

            if (signature.LawKind() || localStorage == TokenKind.Heap || localStorage == TokenKind.Static)
            {
                return false;
            }

            if (!usesArenaFrame)
            {
                stack MirValueId frame = MirArenaFrameEnter(instrs);
                usesArenaFrame = true;
            }

            stack MirValueId allocation = MirArenaAlloc(instrs, allocationSize, allocationAlign);
            stack u32[0 max] localIndex = ResolveParam(params, source, nameStart, nameLength);
            stack u32[0 max] nonValueRoot = localRoots.Add(0);
            stack u32[0 max] nonValueType = localTypes.Add(2);
            stack u32[0 max] arenaOverrideValue = localOverrideValues.Add(0);
            if (sourceValueFacts.Add(new ValueFacts()) == 0)
            {
                return false;
            }
        }

        cursor = statementEnd + 1;
    }

    while willexit (cursor < limit && stream.KindAt(cursor) != TokenKind.If)
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        if (TryParseSourceStorageMutationStatement(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            scalarStorageLocals,
            enumStorageLocals,
            localTypes,
            sourceValueFacts,
            moduleFacts,
            cursor,
            statementEnd,
            scalarStorageAssignments,
            enumStorageAssignments,
            constructedObjectFieldAssignments,
            storageMutationStatements))
        {
            cursor = statementEnd + 1;
            continue;
        }
        else if (!TryLowerArenaDynamicReserveStatement(stream, source, arenaDynamicLocals, cursor, statementEnd, instrs))
        {
            return false;
        }

        cursor = statementEnd + 1;
    }

    if (cursor >= limit || stream.KindAt(cursor) != TokenKind.If)
    {
        return false;
    }

    stack u32[0 max] prefixStorageMutationCount = (u32[0 max])storageMutationStatements.Count();
    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseTerminalIfReturnArmsWithConstructedObjectLocalsAndSlices(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, moduleFacts, cursor, arms))
    {
        stack mut IrTable<ParsedRecursiveIfStorageMutationNode> storageIfNodes = new();
        stack mut u32[0 max] storageRootNode = 0;
        stack mut u64[0 2 ** 63 - 1] afterStorageArms = cursor;
        stack mut IrTable<u32[0 max]> storageArmLocalRoots = new();
        if (!TryParseRecursiveIfStorageMutationNode(
            stream,
            source,
            nodes,
            params,
            signatureParamCount + localRoots.Count(),
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            scalarStorageLocals,
            enumStorageLocals,
            localTypes,
            sourceValueFacts,
            moduleFacts,
            cursor,
            storageArmLocalRoots,
            scalarStorageAssignments,
            enumStorageAssignments,
            constructedObjectFieldAssignments,
            storageMutationStatements,
            storageIfNodes,
            storageRootNode,
            afterStorageArms))
        {
            return false;
        }

        if (!RecursiveIfStorageMutationNodeHasNestedArm(storageIfNodes, storageRootNode))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] storageReturnIndex = afterStorageArms;
        if (stream.KindAt(storageReturnIndex) != TokenKind.Return)
        {
            return false;
        }

        stack ExprParseResult storageReturnRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, moduleFacts, storageReturnIndex + 1);
        stack mut u64[0 2 ** 63 - 1] afterStorageReturn = storageReturnRoot.Next;
        if (stream.KindAt(afterStorageReturn) == TokenKind.Semi)
        {
            afterStorageReturn = afterStorageReturn + 1;
        }

        if (stream.KindAt(afterStorageReturn) != TokenKind.RBrace
            || params.Count() != signatureParamCount + localRoots.Count())
        {
            return false;
        }

        stack mut IrTable<DistinctStoragePair> storageDistinctStorageFacts = new();
        if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, storageDistinctStorageFacts))
        {
            return false;
        }

        stack mut IrTable<SourceSliceArgumentLocal> storageSliceArgumentLocals = new();
        if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, storageSliceArgumentLocals))
        {
            return false;
        }

        stack mut IrTable<u32[0 max]> storageLoweringLocalTypes = new();
        if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, storageLoweringLocalTypes))
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] localCallIndex = 0;
        while willexit (localCallIndex < localRoots.Count())
        {
            stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(localCallIndex + 1));
            if (localRoot != 0
                && !ValidateModuleCallsForRootWithSlices(nodes, localRoot, funcParamCounts, functionCallContractFacts, storageLoweringLocalTypes, sliceDescriptorLocals, storageDistinctStorageFacts))
            {
                return false;
            }

            localCallIndex = localCallIndex + 1;
        }

        if (!ValidateRecursiveIfStorageMutationNodeModuleCallsWithSlices(nodes, storageIfNodes, storageRootNode, storageArmLocalRoots, scalarStorageAssignments, enumStorageAssignments, constructedObjectFieldAssignments, storageMutationStatements, storageLoweringLocalTypes, (u32[0 max])(signatureParamCount + localRoots.Count()), funcParamCounts, functionCallContractFacts, sliceDescriptorLocals, storageDistinctStorageFacts)
            || !ValidateModuleCallsForRootWithSlices(nodes, storageReturnRoot.NodeId, funcParamCounts, functionCallContractFacts, storageLoweringLocalTypes, sliceDescriptorLocals, storageDistinctStorageFacts))
        {
            return false;
        }

        if (!ValidateRecursiveIfStorageMutationNodeConditionTypes(nodes, storageIfNodes, storageRootNode, storageLoweringLocalTypes))
        {
            return false;
        }

        stack ExprType storageRootType = TypeOfNodeWithLocals(nodes, storageReturnRoot.NodeId, storageLoweringLocalTypes);
        if (storageRootType == ExprType.ErrorType || storageRootType == ExprType.PtrType)
        {
            return false;
        }

        stack mut MirType storageDeclaredReturnType = MirType.I64;
        stack bool storageHasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), storageDeclaredReturnType);

        stack mut IrTable<u32[0 max]> storageLocalOverrides = new();
        if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, storageLoweringLocalTypes, storageLocalOverrides))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] storageLocalCount = localRoots.Count();
        stack mut u64[0 2 ** 63 - 1] storageLocalIndex = 0;
        stack mut u32[0 max] storageNextStackObjectInitializer = 1;
        stack mut u32[0 max] storageNextScalarStorageInitializer = 1;
        stack mut u32[0 max] storageNextFixedArrayStorageInitializer = 1;
        stack mut u32[0 max] storageNextEnumStorageInitializer = 1;
        while willexit (storageLocalIndex < storageLocalCount)
        {
            stack u32[0 max] storageLocalRoot = localRoots.Get((u32[0 max])(storageLocalIndex + 1));
            if (storageLocalRoot == 0)
            {
                stack mut u32[0 max] storageOverride = 0;
                if (localOverrideValues.Contains((u32[0 max])(storageLocalIndex + 1)))
                {
                    storageOverride = localOverrideValues.Get((u32[0 max])(storageLocalIndex + 1));
                }

                if (storageLocalOverrides.Add(storageOverride) == 0)
                {
                    return false;
                }
            }
            else
            {
                stack MirValueId storageVarValue = LowerExprNodeWithCallContext(
                    nodes,
                    storageLocalRoot,
                    instrs,
                    storageLoweringLocalTypes,
                    storageLocalOverrides,
                    functionCallContractFacts,
                    storageSliceArgumentLocals);
                if (storageLocalOverrides.Add(storageVarValue.Index()) == 0)
                {
                    return false;
                }
            }

            storageNextScalarStorageInitializer = LowerScalarStorageInitializersForLocalWithCallContext(
                scalarStorageInitializers,
                (u32[0 max])(storageLocalIndex + 1),
                storageNextScalarStorageInitializer,
                nodes,
                instrs,
                storageLoweringLocalTypes,
                storageLocalOverrides,
                functionCallContractFacts,
                storageSliceArgumentLocals);

            storageNextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
                fixedArrayStorageInitializers,
                (u32[0 max])(storageLocalIndex + 1),
                storageNextFixedArrayStorageInitializer,
                nodes,
                instrs,
                storageLoweringLocalTypes,
                storageLocalOverrides,
                functionCallContractFacts,
                storageSliceArgumentLocals);

            storageNextEnumStorageInitializer = LowerEnumStorageInitializersForLocalWithCallContext(
                enumStorageInitializers,
                (u32[0 max])(storageLocalIndex + 1),
                storageNextEnumStorageInitializer,
                nodes,
                instrs,
                storageLoweringLocalTypes,
                storageLocalOverrides,
                functionCallContractFacts,
                storageSliceArgumentLocals);

            storageNextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
                stackObjectFieldInitializers,
                (u32[0 max])(storageLocalIndex + 1),
                storageNextStackObjectInitializer,
                nodes,
                instrs,
                storageLoweringLocalTypes,
                storageLocalOverrides,
                functionCallContractFacts,
                storageSliceArgumentLocals);
            storageLocalIndex = storageLocalIndex + 1;
        }

        if ((u64[0 2 ** 63 - 1])(storageNextScalarStorageInitializer - 1) != scalarStorageInitializers.Count())
        {
            return false;
        }

        if ((u64[0 2 ** 63 - 1])(storageNextEnumStorageInitializer - 1) != enumStorageInitializers.Count())
        {
            return false;
        }

        if ((u64[0 2 ** 63 - 1])(storageNextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
        {
            return false;
        }

        stack mut IrTable<SourceStorageMutationStatement> prefixStorageMutationStatements = new();
        stack mut u32[0 max] prefixStorageMutationIndex = 1;
        while willexit (prefixStorageMutationIndex <= prefixStorageMutationCount)
        {
            if (!storageMutationStatements.Contains(prefixStorageMutationIndex)
                || AppendStorageMutationStatementRow(prefixStorageMutationStatements, storageMutationStatements, prefixStorageMutationIndex) == 0)
            {
                return false;
            }

            prefixStorageMutationIndex = prefixStorageMutationIndex + 1;
        }

        if (!LowerSourceStorageMutationStatementsWithCallContext(
            prefixStorageMutationStatements,
            scalarStorageAssignments,
            enumStorageAssignments,
            constructedObjectFieldAssignments,
            nodes,
            instrs,
            storageLoweringLocalTypes,
            storageLocalOverrides,
            functionCallContractFacts,
            storageSliceArgumentLocals))
        {
            return false;
        }

        return LowerRecursiveIfStorageMutationNodeToReturnBlocks(
            nodes,
            storageIfNodes,
            storageRootNode,
            storageArmLocalRoots,
            scalarStorageAssignments,
            enumStorageAssignments,
            constructedObjectFieldAssignments,
            storageMutationStatements,
            storageReturnRoot.NodeId,
            storageLoweringLocalTypes,
            storageLocalOverrides,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            functionCallContractFacts,
            storageSliceArgumentLocals,
            storageRootType,
            storageHasDeclaredReturnType,
            storageDeclaredReturnType,
            usesArenaFrame,
            body);
    }

    stack ExprParseResult condResult = arms.Condition;
    stack ExprParseResult thenResult = arms.ThenArm;
    stack ExprParseResult elseResult = arms.ElseArm;
    stack bool thenBecome = arms.ThenBecome;
    stack bool elseBecome = arms.ElseBecome;

    if ((thenBecome || elseBecome) && (!isTailCallable || usesArenaFrame))
    {
        return false;
    }

    if (params.Count() != signatureParamCount + localRoots.Count())
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, condResult.NodeId, loweringLocalTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType thenType = TypeOfNodeWithLocals(nodes, thenResult.NodeId, loweringLocalTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, elseResult.NodeId, loweringLocalTypes);
    stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool bothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType && !thenBecome && !elseBecome;
    if (!bothInt && !bothBool)
    {
        return false;
    }

    if (thenBecome && !TailCallTargetIsTailCallable(nodes, thenResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    if (elseBecome && !TailCallTargetIsTailCallable(nodes, elseResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localCount = localRoots.Count();
    stack mut u64[0 2 ** 63 - 1] v = 0;
    stack mut u32[0 max] nextStackObjectInitializer = 1;
    stack mut u32[0 max] nextScalarStorageInitializer = 1;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    stack mut u32[0 max] nextEnumStorageInitializer = 1;
    while willexit (v < localCount)
    {
        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(v + 1));
        if (localRoot == 0)
        {
            stack mut u32[0 max] storageOverride = 0;
            if (localOverrideValues.Contains((u32[0 max])(v + 1)))
            {
                storageOverride = localOverrideValues.Get((u32[0 max])(v + 1));
            }

            stack u32[0 max] nonValueOverride = localOverrides.Add(storageOverride);
        }
        else
        {
            stack MirValueId varValue = LowerExprNodeWithCallContext(
                nodes,
                localRoot,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
            stack u32[0 max] addedOverride = localOverrides.Add(varValue.Index());
        }

        nextScalarStorageInitializer = LowerScalarStorageInitializersForLocalWithCallContext(
            scalarStorageInitializers,
            (u32[0 max])(v + 1),
            nextScalarStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
            fixedArrayStorageInitializers,
            (u32[0 max])(v + 1),
            nextFixedArrayStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextEnumStorageInitializer = LowerEnumStorageInitializersForLocalWithCallContext(
            enumStorageInitializers,
            (u32[0 max])(v + 1),
            nextEnumStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
            stackObjectFieldInitializers,
            (u32[0 max])(v + 1),
            nextStackObjectInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);
        v = v + 1;
    }

    if ((u64[0 2 ** 63 - 1])(nextScalarStorageInitializer - 1) != scalarStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextEnumStorageInitializer - 1) != enumStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return false;
    }

    if (!LowerSourceStorageMutationStatementsWithCallContext(
        storageMutationStatements,
        scalarStorageAssignments,
        enumStorageAssignments,
        constructedObjectFieldAssignments,
        nodes,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals))
    {
        return false;
    }

    stack MirValueId condValue = LowerExprNodeWithCallContext(nodes, condResult.NodeId, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId thenValue = MirValueIdOf(0);
    if (thenBecome)
    {
        thenValue = LowerTailCallExprNodeWithCallContext(nodes, thenResult.NodeId, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    }
    else
    {
        thenValue = LowerScalarReturnExprNodeWithCallContext(
            nodes,
            thenResult.NodeId,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals,
            thenType,
            hasDeclaredReturnType,
            declaredReturnType);

        if (usesArenaFrame)
        {
            stack MirValueId thenLeave = MirArenaFrameLeave(instrs);
        }
    }

    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);

    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId elseValue = MirValueIdOf(0);
    if (elseBecome)
    {
        elseValue = LowerTailCallExprNodeWithCallContext(nodes, elseResult.NodeId, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    }
    else
    {
        elseValue = LowerScalarReturnExprNodeWithCallContext(
            nodes,
            elseResult.NodeId,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals,
            elseType,
            hasDeclaredReturnType,
            declaredReturnType);

        if (usesArenaFrame)
        {
            stack MirValueId elseLeave = MirArenaFrameLeave(instrs);
        }
    }

    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack mut MirBlockId thenBlock = MirBlockIdOf(0);
    if (thenBecome)
    {
        thenBlock = MirTailCallBlock(blocks, thenValue);
    }
    else
    {
        thenBlock = MirReturnBlock(blocks, thenValue);
    }

    stack mut MirBlockId elseBlock = MirBlockIdOf(0);
    if (elseBecome)
    {
        elseBlock = MirTailCallBlock(blocks, elseValue);
    }
    else
    {
        elseBlock = MirReturnBlock(blocks, elseValue);
    }

    if (recordRanges)
    {
        stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
        stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = condValue.Index();
    body.ThenValue = thenValue.Index();
    body.ElseValue = elseValue.Index();
    return true;
}

// Parses + lowers a BRANCH-bodied module function `fn <name>(<params>) { if <cond> return
// <then> else return <else> }` into a three-block CFG — an entry that conditionally branches
// to a then-block (returns `<then>`) or an else-block (returns `<else>`), no merge — and
// emits `@f<functionNumber>`. The arms are full expressions parsed against `funcNames`, so a
// return arm may CALL another function, INCLUDING THE FUNCTION ITSELF (the first pass put
// every name in `funcNames`): that is RECURSION through the AST path (e.g. factorial). The
// condition must be boolean and both returned arms integer. Returns false if the body is not
// this shape, or is malformed / ill-typed / has an invalid call.
internal fn bool EmitModuleIfReturnFunction(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    bool isTailCallable,
    u64[0 2 ** 63 - 1] fnIndex,
    u32[0 max] functionNumber,
    mut borrow OwnedAscii sink)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0 || stream.KindAt((u64[0 2 ** 63 - 1])braceIndex + 1) != TokenKind.If)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    // `if <cond> (return|become) <then> else (return|become) <else>`.
    stack mut IrTable<ExprNode> nodes = new();
    stack u64[0 2 ** 63 - 1] ifIndex = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseTerminalIfReturnArms(stream, source, nodes, params, funcNames, ifIndex, arms))
    {
        return false;
    }

    stack ExprParseResult condResult = arms.Condition;
    stack ExprParseResult thenResult = arms.ThenArm;
    stack ExprParseResult elseResult = arms.ElseArm;
    stack bool thenBecome = arms.ThenBecome;
    stack bool elseBecome = arms.ElseBecome;

    if ((thenBecome || elseBecome) && !isTailCallable)
    {
        return false;
    }

    // Only the signature parameters may be referenced (no undeclared name appended).
    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    // Condition boolean; integer arms return directly, boolean arms widen at the return edge.
    if (TypeOfNodeWithLocals(nodes, condResult.NodeId, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType thenType = TypeOfNodeWithLocals(nodes, thenResult.NodeId, localTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, elseResult.NodeId, localTypes);
    stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool bothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType && !thenBecome && !elseBecome;
    if (!bothInt && !bothBool)
    {
        return false;
    }

    if (thenBecome && !TailCallTargetIsTailCallable(nodes, thenResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    if (elseBecome && !TailCallTargetIsTailCallable(nodes, elseResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();

    // Entry block: lower the condition (i1).
    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId condValue = LowerExprNodeWithTypesAndLocals(nodes, condResult.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count();
    // Then block: lower + return/become the first arm.
    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId thenValue = MirValueIdOf(0);
    if (thenBecome)
    {
        stack mut IrTable<u32[0 max]> noOverridesThen = new();
        thenValue = LowerTailCallExprNodeWithTypesAndLocals(nodes, thenResult.NodeId, instrs, localTypes, noOverridesThen);
    }
    else
    {
        thenValue = LowerScalarReturnExprNodeWithTypesAndLocals(
            nodes,
            thenResult.NodeId,
            instrs,
            localTypes,
            noOverrides,
            thenType,
            hasDeclaredReturnType,
            declaredReturnType);
    }

    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);
    // Else block: lower + return/become the second arm.
    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId elseValue = MirValueIdOf(0);
    if (elseBecome)
    {
        stack mut IrTable<u32[0 max]> noOverridesElse = new();
        elseValue = LowerTailCallExprNodeWithTypesAndLocals(nodes, elseResult.NodeId, instrs, localTypes, noOverridesElse);
    }
    else
    {
        elseValue = LowerScalarReturnExprNodeWithTypesAndLocals(
            nodes,
            elseResult.NodeId,
            instrs,
            localTypes,
            noOverrides,
            elseType,
            hasDeclaredReturnType,
            declaredReturnType);
    }

    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(2), MirBlockIdOf(3));
    stack mut MirBlockId thenBlock = MirBlockIdOf(0);
    if (thenBecome)
    {
        thenBlock = MirTailCallBlock(blocks, thenValue);
    }
    else
    {
        thenBlock = MirReturnBlock(blocks, thenValue);
    }

    stack mut MirBlockId elseBlock = MirBlockIdOf(0);
    if (elseBecome)
    {
        elseBlock = MirTailCallBlock(blocks, elseValue);
    }
    else
    {
        elseBlock = MirReturnBlock(blocks, elseValue);
    }

    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, entryCount));
    stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
    stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));

    stack u32[0 max] paramCount = (u32[0 max])signatureParamCount;
    stack mut IrTable<ValueFacts> paramFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, paramFacts))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack ValueFacts returnFacts = FunctionReturnRangeFact(stream, source, signature);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    if (!ValidateBranchReturnRangeFacts(returnFacts, instrs, paramFacts, globalFacts, functionReturnFacts, condValue, thenValue, elseValue))
    {
        return false;
    }

    stack FunctionEffectFacts functionEffects = FunctionEffectFactsAt(functionEffectFacts, functionNumber);

    switch (EmitLlvmBlocksNumberedWithRangeFactsCore(
        instrs,
        funcTailFlags,
        functionEffectFacts,
        functionCallContractFacts,
        functionLinkageFacts,
        functionCallingConventionFacts,
        blocks,
        "f",
        functionNumber,
        isTailCallable,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        distinctStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        functionEffects,
        paramCount,
        ranges,
        sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

internal fn bool EmitModuleReturnIfExpressionFunction(
    borrow TokenStream stream,
