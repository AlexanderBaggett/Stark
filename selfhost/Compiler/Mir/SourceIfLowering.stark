module Compiler.Mir.SourceIfLowering

internal fn bool LowerIfStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack i64[min max] ifIndex = FirstTokenOfKind(stream, TokenKind.If);
    stack i64[min max] elseKeyword = FirstTokenOfKind(stream, TokenKind.Else);
    if (ifIndex < 0 || elseKeyword < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] base = (u64[0 2 ** 63 - 1])ifIndex;
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<ParamName> params = new();
    BuildParamTable(stream, source, params);
    stack mut IrTable<LocalBinding> locals = new();

    // Entry block: `<lhs> <cmp> <rhs>` (single-primary operands), ending in a compare.
    stack MirValueId lhs = LowerPrimary(stream, source, params, locals, instrs, base + 1);
    stack MirValueId rhs = LowerPrimary(stream, source, params, locals, instrs, base + 3);
    stack MirValueId comparison = LowerComparison(instrs, stream.KindAt(base + 2), lhs, rhs);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count();

    // Then arm: the expression after the comparison; its instructions form the then
    // block. `FoldExpr` stops at `else`.
    stack u32[0 max] thenFirst = entryCount + 1;
    stack MirValueId thenValue = FoldExpr(stream, source, params, locals, instrs, base + 4);
    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - entryCount;

    // Else arm: the expression after `else`; its instructions form the else block.
    stack i64[min max] elseArm = FirstPrimaryIndexAfter(stream, (u64[0 2 ** 63 - 1])elseKeyword);
    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId elseValue = FoldExpr(stream, source, params, locals, instrs, (u64[0 2 ** 63 - 1])elseArm);
    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    // Merge block: a phi selecting the then/else value, then a return.
    stack MirValueId phi = MirPhi2(instrs, thenValue, MirBlockIdOf(2), elseValue, MirBlockIdOf(3));

    // Blocks, created in order so their ids are b1..b4.
    stack MirBlockId entry = MirCondBlock(blocks, comparison, MirBlockIdOf(2), MirBlockIdOf(3));
    stack MirBlockId thenBlock = MirBranchBlock(blocks, MirBlockIdOf(4));
    stack MirBlockId elseBlock = MirBranchBlock(blocks, MirBlockIdOf(4));
    stack MirBlockId mergeBlock = MirReturnBlock(blocks, phi);

    stack u32[0 max] paramCount = (u32[0 max])params.Count();
    stack System.Memory.MemoryStatus emitStatus = EmitLlvmDiamond(instrs, blocks, "main", paramCount, entry.Index(), 1, entryCount, thenBlock.Index(), thenFirst, thenCount, elseBlock.Index(), elseFirst, elseCount, mergeBlock.Index(), phi.Index(), 1, sink);
    return true;
}

// Lexes and lowers an `if <a> <cmp> <b> <then> else <else>` program to a branching
// LLVM `@main` (with a phi merge).
public fn bool LowerIfToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerIfStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// Lowers a one-level else-if chain `if <a> <cmp> <b> <then1> else if <c> <cmp> <d>
// <then2> else <else>` (single-primary comparison operands; arm values are folded
// expressions) to a seven-block CFG of two composed diamonds, emitted through the
// general `EmitLlvmBlocks`. Requires the token after the first `else` to be `if`.
internal fn bool LowerNestedIfStream(borrow TokenStream stream, borrow i8[min max][] source, mut borrow OwnedAscii sink)
{
    stack i64[min max] ifIndex = FirstTokenOfKind(stream, TokenKind.If);
    stack i64[min max] else1 = FirstTokenOfKind(stream, TokenKind.Else);
    if (ifIndex < 0 || else1 < 0)
    {
        return false;
    }

    // The else arm must itself open with `if` (the chained `else if`).
    stack u64[0 2 ** 63 - 1] innerIf = (u64[0 2 ** 63 - 1])else1 + 1;
    if (stream.KindAt(innerIf) != TokenKind.If)
    {
        return false;
    }

    stack i64[min max] else2 = FirstTokenOfKindAfter(stream, TokenKind.Else, innerIf);
    if (else2 < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] base = (u64[0 2 ** 63 - 1])ifIndex;
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<ParamName> params = new();
    BuildParamTable(stream, source, params);
    stack mut IrTable<LocalBinding> locals = new();

    // Entry block (b1): outer comparison `<a> <cmp> <b>`.
    stack MirValueId lhs1 = LowerPrimary(stream, source, params, locals, instrs, base + 1);
    stack MirValueId rhs1 = LowerPrimary(stream, source, params, locals, instrs, base + 3);
    stack MirValueId cond1 = LowerComparison(instrs, stream.KindAt(base + 2), lhs1, rhs1);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count();

    // then1 block (b2): the first arm value (folded, stops at `else`).
    stack u32[0 max] then1First = entryCount + 1;
    stack MirValueId then1Value = FoldExpr(stream, source, params, locals, instrs, base + 4);
    stack u32[0 max] then1Count = (u32[0 max])instrs.Count() - entryCount;

    // inner-entry block (b3): inner comparison `<c> <cmp> <d>` after the chained `if`.
    stack u32[0 max] innerEntryFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId lhs2 = LowerPrimary(stream, source, params, locals, instrs, innerIf + 1);
    stack MirValueId rhs2 = LowerPrimary(stream, source, params, locals, instrs, innerIf + 3);
    stack MirValueId cond2 = LowerComparison(instrs, stream.KindAt(innerIf + 2), lhs2, rhs2);
    stack u32[0 max] innerEntryCount = (u32[0 max])instrs.Count() - (innerEntryFirst - 1);

    // then2 block (b4): the second arm value (folded, stops at `else`).
    stack u32[0 max] then2First = (u32[0 max])instrs.Count() + 1;
    stack MirValueId then2Value = FoldExpr(stream, source, params, locals, instrs, innerIf + 4);
    stack u32[0 max] then2Count = (u32[0 max])instrs.Count() - (then2First - 1);

    // else2 block (b5): the final else value.
    stack i64[min max] elseArm = FirstPrimaryIndexAfter(stream, (u64[0 2 ** 63 - 1])else2);
    stack u32[0 max] else2First = (u32[0 max])instrs.Count() + 1;
    stack MirValueId elseValue = FoldExpr(stream, source, params, locals, instrs, (u64[0 2 ** 63 - 1])elseArm);
    stack u32[0 max] else2Count = (u32[0 max])instrs.Count() - (else2First - 1);

    // inner-merge block (b6): phi over the inner diamond, then branch to the outer merge.
    stack u32[0 max] innerMergeFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId innerPhi = MirPhi2(instrs, then2Value, MirBlockIdOf(4), elseValue, MirBlockIdOf(5));
    // outer-merge block (b7): phi selecting then1 vs the inner result, then return.
    stack u32[0 max] outerMergeFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId outerPhi = MirPhi2(instrs, then1Value, MirBlockIdOf(2), innerPhi, MirBlockIdOf(6));

    // Blocks in order b1..b7.
    stack MirBlockId entry = MirCondBlock(blocks, cond1, MirBlockIdOf(2), MirBlockIdOf(3));
    stack MirBlockId then1 = MirBranchBlock(blocks, MirBlockIdOf(7));
    stack MirBlockId innerEntry = MirCondBlock(blocks, cond2, MirBlockIdOf(4), MirBlockIdOf(5));
    stack MirBlockId then2 = MirBranchBlock(blocks, MirBlockIdOf(6));
    stack MirBlockId else2Block = MirBranchBlock(blocks, MirBlockIdOf(6));
    stack MirBlockId innerMerge = MirBranchBlock(blocks, MirBlockIdOf(7));
    stack MirBlockId outerMerge = MirReturnBlock(blocks, outerPhi);

    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, entryCount));
    stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(then1.Index(), then1First, then1Count));
    stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(innerEntry.Index(), innerEntryFirst, innerEntryCount));
    stack u32[0 max] r4 = ranges.Add(MakeBlockEmit(then2.Index(), then2First, then2Count));
    stack u32[0 max] r5 = ranges.Add(MakeBlockEmit(else2Block.Index(), else2First, else2Count));
    stack u32[0 max] r6 = ranges.Add(MakeBlockEmit(innerMerge.Index(), innerMergeFirst, 1));
    stack u32[0 max] r7 = ranges.Add(MakeBlockEmit(outerMerge.Index(), outerMergeFirst, 1));

    stack u32[0 max] paramCount = (u32[0 max])params.Count();
    switch (EmitLlvmBlocks(instrs, blocks, "main", paramCount, ranges, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

// Lexes and lowers an `if … else if … else …` one-level chain to a branching `@main`.
public fn bool LowerNestedIfToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerNestedIfStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

internal fn bool FunctionBodyHasLocalPrefixedTerminalIf(borrow TokenStream stream, u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut bool sawPrefix = false;
    while willexit (cursor < limit && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        sawPrefix = true;
        cursor = statementEnd + 1;
    }

    while willexit (cursor < limit && stream.KindAt(cursor) != TokenKind.If)
    {
        stack TokenKind kind = stream.KindAt(cursor);
        if (kind == TokenKind.Return
            || kind == TokenKind.Become
            || kind == TokenKind.RBrace
            || kind == TokenKind.EndOfFile)
        {
            return false;
        }

        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        sawPrefix = true;
        cursor = statementEnd + 1;
    }

    return sawPrefix && cursor < limit && stream.KindAt(cursor) == TokenKind.If;
}

internal fn bool FunctionBodyStartsWithReturnIfExpression(borrow TokenStream stream, u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0 && braceIndex >= nextFnIndex)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] bodyStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    return stream.KindAt(bodyStart) == TokenKind.Return
        && stream.KindAt(bodyStart + 1) == TokenKind.If;
}

internal fn bool FunctionBodyStartsWithReturnedLocalIfExpression(borrow TokenStream stream, u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack u64[0 2 ** 63 - 1] bodyStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (bodyStart >= limit || stream.KindAt(bodyStart) != TokenKind.Var)
    {
        return false;
    }

    if (stream.KindAt(bodyStart + 1) != TokenKind.Identifier
        || stream.KindAt(bodyStart + 2) != TokenKind.Assign
        || stream.KindAt(bodyStart + 3) != TokenKind.If)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] initializerEnd = bodyStart;
    stack mut u64[0 2 ** 63 - 1] scan = bodyStart;
    stack mut u32[0 max] parenDepth = 0;
    stack mut u32[0 max] bracketDepth = 0;
    while willexit (scan < limit && stream.KindAt(scan) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.LParen)
        {
            parenDepth = parenDepth + 1;
        }
        else if (kind == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = parenDepth - 1;
            }
        }
        else if (kind == TokenKind.LBrack)
        {
            bracketDepth = bracketDepth + 1;
        }
        else if (kind == TokenKind.RBrack)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = bracketDepth - 1;
            }
        }
        else if (kind == TokenKind.Semi && parenDepth == 0 && bracketDepth == 0)
        {
            initializerEnd = scan;
            break;
        }

        scan = scan + 1;
    }

    if (initializerEnd == bodyStart)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] returnIndex = initializerEnd + 1;
    if (stream.KindAt(returnIndex) != TokenKind.Return || stream.KindAt(returnIndex + 1) != TokenKind.Identifier)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterReturn = returnIndex + 2;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    return stream.KindAt(afterReturn) == TokenKind.RBrace;
}

internal fn bool FunctionBodyStartsWithLocalIfExpressionInitializer(borrow TokenStream stream, u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack u64[0 2 ** 63 - 1] bodyStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (bodyStart >= limit)
    {
        return false;
    }

    return stream.KindAt(bodyStart) == TokenKind.Var
        && stream.KindAt(bodyStart + 1) == TokenKind.Identifier
        && stream.KindAt(bodyStart + 2) == TokenKind.Assign
        && stream.KindAt(bodyStart + 3) == TokenKind.If;
}

internal struct ParsedIfReturnArms
{
    ExprParseResult Condition;
    ExprParseResult ThenArm;
    ExprParseResult ElseArm;
    bool ThenBecome;
    bool ElseBecome;

    ParsedIfReturnArms()
    {
        self.Condition = new();
        self.ThenArm = new();
        self.ElseArm = new();
        self.ThenBecome = false;
        self.ElseBecome = false;
    }
}

internal fn bool TryParseTerminalIfArm(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out bool usesBecome,
    out u64[0 2 ** 63 - 1] nextToken)
{
    arm = new();
    usesBecome = false;
    nextToken = armStart;

    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack TokenKind terminal = stream.KindAt(armStart + 1);
        if (terminal != TokenKind.Return && terminal != TokenKind.Become)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        usesBecome = terminal == TokenKind.Become;
        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    stack TokenKind terminal = stream.KindAt(armStart);
    if (terminal != TokenKind.Return && terminal != TokenKind.Become)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    usesBecome = terminal == TokenKind.Become;
    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TryParseTerminalIfReturnArms(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] ifIndex,
    out ParsedIfReturnArms arms)
{
    arms = new();
    stack ExprParseResult condition = ParseExprIn(stream, source, nodes, params, funcNames, ifIndex + 1);

    stack mut u64[0 2 ** 63 - 1] afterThen = condition.Next;
    stack mut ExprParseResult thenArm = new();
    stack mut bool thenBecome = false;
    if (!TryParseTerminalIfArm(stream, source, nodes, params, funcNames, condition.Next, thenArm, thenBecome, afterThen))
    {
        return false;
    }

    if (stream.KindAt(afterThen) != TokenKind.Else)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterElse = afterThen + 1;
    stack mut ExprParseResult elseArm = new();
    stack mut bool elseBecome = false;
    if (!TryParseTerminalIfArm(stream, source, nodes, params, funcNames, afterThen + 1, elseArm, elseBecome, afterElse))
    {
        return false;
    }

    arms.Condition = condition;
    arms.ThenArm = thenArm;
    arms.ThenBecome = thenBecome;
    arms.ElseArm = elseArm;
    arms.ElseBecome = elseBecome;
    return true;
}

internal fn bool TryParseTerminalIfArmWithConstructedObjectLocals(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out bool usesBecome,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts)
{
    arm = new();
    usesBecome = false;
    nextToken = armStart;

    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack TokenKind terminal = stream.KindAt(armStart + 1);
        if (terminal != TokenKind.Return && terminal != TokenKind.Become)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        usesBecome = terminal == TokenKind.Become;
        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    stack TokenKind terminal = stream.KindAt(armStart);
    if (terminal != TokenKind.Return && terminal != TokenKind.Become)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    usesBecome = terminal == TokenKind.Become;
    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TryParseTerminalIfReturnArmsWithConstructedObjectLocals(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] ifIndex,
    out ParsedIfReturnArms arms)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts)
{
    arms = new();
    stack ExprParseResult condition = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, ifIndex + 1);

    stack mut u64[0 2 ** 63 - 1] afterThen = condition.Next;
    stack mut ExprParseResult thenArm = new();
    stack mut bool thenBecome = false;
    if (!TryParseTerminalIfArmWithConstructedObjectLocals(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, condition.Next, thenArm, thenBecome, afterThen))
    {
        return false;
    }

    if (stream.KindAt(afterThen) != TokenKind.Else)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterElse = afterThen + 1;
    stack mut ExprParseResult elseArm = new();
    stack mut bool elseBecome = false;
    if (!TryParseTerminalIfArmWithConstructedObjectLocals(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, afterThen + 1, elseArm, elseBecome, afterElse))
    {
        return false;
    }

    arms.Condition = condition;
    arms.ThenArm = thenArm;
    arms.ThenBecome = thenBecome;
    arms.ElseArm = elseArm;
    arms.ElseBecome = elseBecome;
    return true;
}

internal fn bool TryParseTerminalIfArmWithConstructedObjectLocalsAndSlices(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out bool usesBecome,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    arm = new();
    usesBecome = false;
    nextToken = armStart;

    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        stack TokenKind terminal = stream.KindAt(armStart + 1);
        if (terminal != TokenKind.Return && terminal != TokenKind.Become)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        usesBecome = terminal == TokenKind.Become;
        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    stack TokenKind terminal = stream.KindAt(armStart);
    if (terminal != TokenKind.Return && terminal != TokenKind.Become)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    usesBecome = terminal == TokenKind.Become;
    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TryParseTerminalIfReturnArmsWithConstructedObjectLocalsAndSlices(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] ifIndex,
    out ParsedIfReturnArms arms)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    arms = new();
    stack ExprParseResult condition = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, ifIndex + 1);

    stack mut u64[0 2 ** 63 - 1] afterThen = condition.Next;
    stack mut ExprParseResult thenArm = new();
    stack mut bool thenBecome = false;
    if (!TryParseTerminalIfArmWithConstructedObjectLocalsAndSlices(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, condition.Next, thenArm, thenBecome, afterThen))
    {
        return false;
    }

    if (stream.KindAt(afterThen) != TokenKind.Else)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterElse = afterThen + 1;
    stack mut ExprParseResult elseArm = new();
    stack mut bool elseBecome = false;
    if (!TryParseTerminalIfArmWithConstructedObjectLocalsAndSlices(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, afterThen + 1, elseArm, elseBecome, afterElse))
    {
        return false;
    }

    arms.Condition = condition;
    arms.ThenArm = thenArm;
    arms.ThenBecome = thenBecome;
    arms.ElseArm = elseArm;
    arms.ElseBecome = elseBecome;
    return true;
}

internal fn bool TryParseIfExpressionArms(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] ifIndex,
    out ParsedIfReturnArms arms)
{
    arms = new();
    if (stream.KindAt(ifIndex) != TokenKind.If)
    {
        return false;
    }

    stack ExprParseResult condition = ParseExprIn(stream, source, nodes, params, funcNames, ifIndex + 1);
    stack ExprParseResult thenArm = ParseExprIn(stream, source, nodes, params, funcNames, condition.Next);
    if (stream.KindAt(thenArm.Next) != TokenKind.Else)
    {
        return false;
    }

    stack ExprParseResult elseArm = ParseExprIn(stream, source, nodes, params, funcNames, thenArm.Next + 1);
    arms.Condition = condition;
    arms.ThenArm = thenArm;
    arms.ElseArm = elseArm;
    arms.ThenBecome = false;
    arms.ElseBecome = false;
    return true;
}

internal fn bool ExprNodeCanBeDiscardedIfOverwritten(borrow IrTable<ExprNode> nodes, u32[0 max] nodeId)
{
    if (!nodes.Contains(nodeId))
    {
        return false;
    }

    stack ExprNode node = nodes.Get(nodeId);
    switch (node.Kind)
    {
        case Compiler.Mir.SourceExpressions.ExprKind.IntLitExpr:
            return true;
        case Compiler.Mir.SourceExpressions.ExprKind.BoolLitExpr:
            return true;
        case Compiler.Mir.SourceExpressions.ExprKind.NameExpr:
            return true;
        case Compiler.Mir.SourceExpressions.ExprKind.FieldExpr:
            return true;
        case Compiler.Mir.SourceExpressions.ExprKind.IndexedFieldExpr:
            return ExprNodeCanBeDiscardedIfOverwritten(nodes, node.Right);
        case Compiler.Mir.SourceExpressions.ExprKind.FixedArrayParamElementExpr:
            return ExprNodeCanBeDiscardedIfOverwritten(nodes, node.Right);
        case Compiler.Mir.SourceExpressions.ExprKind.RawPointerIndexedElementExpr:
            return ExprNodeCanBeDiscardedIfOverwritten(nodes, node.Left)
                && ExprNodeCanBeDiscardedIfOverwritten(nodes, node.Right);
        case Compiler.Mir.SourceExpressions.ExprKind.AddressOfExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.DerefExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.EnumVariantExpr:
            return true;
        case Compiler.Mir.SourceExpressions.ExprKind.EnumPayloadExpr:
            return ExprNodeCanBeDiscardedIfOverwritten(nodes, node.Left)
                && ExprNodeCanBeDiscardedIfOverwritten(nodes, node.Right);
        case Compiler.Mir.SourceExpressions.ExprKind.CompareExpr:
            return ExprNodeCanBeDiscardedIfOverwritten(nodes, node.Left)
                && ExprNodeCanBeDiscardedIfOverwritten(nodes, node.Right);
        case Compiler.Mir.SourceExpressions.ExprKind.BinaryExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.CallExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.CallArgLinkExpr:
            return false;
    }
}

internal fn bool TryParseIfAssignmentArm(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u32[0 max] targetNameToken,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    arm = new();
    nextToken = armStart;

    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart)
        {
            return false;
        }

        if (stream.KindAt(armStart + 1) != TokenKind.Identifier
            || stream.KindAt(armStart + 2) != TokenKind.Assign
            || !TokenTextEqualsAsciiSpan(stream, source, targetNameToken, (u32[0 max])(armStart + 1)))
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 3);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (stream.KindAt(armStart) != TokenKind.Identifier
        || stream.KindAt(armStart + 1) != TokenKind.Assign
        || !TokenTextEqualsAsciiSpan(stream, source, targetNameToken, (u32[0 max])armStart))
    {
        return false;
    }

    stack ExprParseResult parsedCompactArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 2);
    stack mut u64[0 2 ** 63 - 1] afterCompactExpr = parsedCompactArm.Next;
    if (stream.KindAt(afterCompactExpr) == TokenKind.Semi)
    {
        afterCompactExpr = afterCompactExpr + 1;
    }

    arm = parsedCompactArm;
    nextToken = afterCompactExpr;
    return true;
}

internal fn bool TryParseIfAssignmentArms(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] ifIndex,
    u32[0 max] targetNameToken,
    out ParsedIfReturnArms arms)
{
    arms = new();
    if (stream.KindAt(ifIndex) != TokenKind.If)
    {
        return false;
    }

    stack ExprParseResult condition = ParseExprIn(stream, source, nodes, params, funcNames, ifIndex + 1);

    stack mut u64[0 2 ** 63 - 1] afterThen = condition.Next;
    stack mut ExprParseResult thenArm = new();
    if (!TryParseIfAssignmentArm(stream, source, nodes, params, funcNames, targetNameToken, condition.Next, thenArm, afterThen))
    {
        return false;
    }

    if (stream.KindAt(afterThen) != TokenKind.Else)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterElse = afterThen + 1;
    stack mut ExprParseResult elseArm = new();
    if (!TryParseIfAssignmentArm(stream, source, nodes, params, funcNames, targetNameToken, afterThen + 1, elseArm, afterElse))
    {
        return false;
    }

    thenArm.Next = afterThen;
    elseArm.Next = afterElse;
    arms.Condition = condition;
    arms.ThenArm = thenArm;
    arms.ElseArm = elseArm;
    arms.ThenBecome = false;
    arms.ElseBecome = false;
    return true;
}

internal fn bool FunctionBodyStartsWithReturnedLocalIfStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (localStart >= limit || stream.KindAt(localStart) != TokenKind.Var)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (!FindSelfHostedStatementEnd(stream, localStart, limit, localEnd))
    {
        return false;
    }

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    if (localNameToken == 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignToken = localEnd;
    if (!FindSelfHostedStatementAssign(stream, localStart, localEnd, assignToken))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] ifIndex = localEnd + 1;
    if (stream.KindAt(ifIndex) != TokenKind.If)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack ExprParseResult initResult = ParseExprIn(stream, source, nodes, params, funcNames, assignToken + 1);
    if (initResult.Next != localEnd
        || params.Count() != signatureParamCount
        || !ExprNodeCanBeDiscardedIfOverwritten(nodes, initResult.NodeId))
    {
        return false;
    }

    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseIfAssignmentArms(stream, source, nodes, params, funcNames, ifIndex, localNameToken, arms))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] returnIndex = arms.ElseArm.Next;
    if (stream.KindAt(returnIndex) != TokenKind.Return || stream.KindAt(returnIndex + 1) != TokenKind.Identifier)
    {
        return false;
    }

    if (!TokenTextEqualsAsciiSpan(stream, source, localNameToken, (u32[0 max])(returnIndex + 1)))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterReturn = returnIndex + 2;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    return stream.KindAt(afterReturn) == TokenKind.RBrace
        && params.Count() == signatureParamCount;
}

internal fn bool FunctionBodyStartsWithLocalIfStatementAssignment(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] fnIndex)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (localStart >= limit || stream.KindAt(localStart) != TokenKind.Var)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (!FindSelfHostedStatementEnd(stream, localStart, limit, localEnd))
    {
        return false;
    }

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    if (localNameToken == 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignToken = localEnd;
    if (!FindSelfHostedStatementAssign(stream, localStart, localEnd, assignToken))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] ifIndex = localEnd + 1;
    if (stream.KindAt(ifIndex) != TokenKind.If)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack ExprParseResult initResult = ParseExprIn(stream, source, nodes, params, funcNames, assignToken + 1);
    if (initResult.Next != localEnd
        || params.Count() != signatureParamCount
        || !ExprNodeCanBeDiscardedIfOverwritten(nodes, initResult.NodeId))
    {
        return false;
    }

    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseIfAssignmentArms(stream, source, nodes, params, funcNames, ifIndex, localNameToken, arms))
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] returnIndex = arms.ElseArm.Next;
    if (stream.KindAt(returnIndex) != TokenKind.Return)
    {
        return false;
    }

    if (!ResolveParamWithMergedRawPointerFactsForAssignedNodes(
        params,
        source,
        nameStart,
        nameLength,
        nodes,
        arms.ThenArm.NodeId,
        arms.ElseArm.NodeId,
        (u32[0 max])signatureParamCount))
    {
        return false;
    }

    stack ExprParseResult returnRoot = ParseExprIn(stream, source, nodes, params, funcNames, returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    return stream.KindAt(afterReturn) == TokenKind.RBrace
        && params.Count() == signatureParamCount + 1;
}

internal fn bool TryParseReturnIfExpressionArms(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] returnIndex,
    out ParsedIfReturnArms arms)
{
    arms = new();
    if (stream.KindAt(returnIndex) != TokenKind.Return || stream.KindAt(returnIndex + 1) != TokenKind.If)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] ifIndex = returnIndex + 1;
    return TryParseIfExpressionArms(stream, source, nodes, params, funcNames, ifIndex, arms);
}

internal fn bool LowerModuleReturnIfExpressionFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyStartsWithReturnIfExpression(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseReturnIfExpressionArms(stream, source, nodes, params, funcNames, (u64[0 2 ** 63 - 1])braceIndex + 1, arms))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterExpression = arms.ElseArm.Next;
    if (stream.KindAt(afterExpression) == TokenKind.Semi)
    {
        afterExpression = afterExpression + 1;
    }

    if (stream.KindAt(afterExpression) != TokenKind.RBrace)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, arms.Condition.NodeId, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType thenType = TypeOfNodeWithLocals(nodes, arms.ThenArm.NodeId, localTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, arms.ElseArm.NodeId, localTypes);
    stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool bothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
    if (!bothInt && !bothBool)
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId condValue = LowerExprNodeWithTypesAndLocals(nodes, arms.Condition.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId thenValue = LowerScalarReturnExprNodeWithTypesAndLocals(
        nodes,
        arms.ThenArm.NodeId,
        instrs,
        localTypes,
        noOverrides,
        thenType,
        hasDeclaredReturnType,
        declaredReturnType);

    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);

    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId elseValue = LowerScalarReturnExprNodeWithTypesAndLocals(
        nodes,
        arms.ElseArm.NodeId,
        instrs,
        localTypes,
        noOverrides,
        elseType,
        hasDeclaredReturnType,
        declaredReturnType);

    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack MirBlockId thenBlock = MirReturnBlock(blocks, thenValue);
    stack MirBlockId elseBlock = MirReturnBlock(blocks, elseValue);

    if (recordRanges)
    {
        stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
        stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = condValue.Index();
    body.ThenValue = thenValue.Index();
    body.ElseValue = elseValue.Index();
    return true;
}

internal fn bool LowerModuleReturnedLocalIfExpressionFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyStartsWithReturnedLocalIfExpression(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (localStart >= limit
        || stream.KindAt(localStart) != TokenKind.Var
        || stream.KindAt(localStart + 1) != TokenKind.Identifier
        || stream.KindAt(localStart + 2) != TokenKind.Assign
        || stream.KindAt(localStart + 3) != TokenKind.If)
    {
        return false;
    }

    stack u32[0 max] localNameToken = (u32[0 max])(localStart + 1);
    stack u64[0 2 ** 63 - 1] assignToken = localStart + 2;

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseIfExpressionArms(stream, source, nodes, params, funcNames, assignToken + 1, arms))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] returnIndex = arms.ElseArm.Next;
    if (stream.KindAt(returnIndex) != TokenKind.Semi)
    {
        return false;
    }

    returnIndex = returnIndex + 1;
    if (stream.KindAt(returnIndex) != TokenKind.Return || stream.KindAt(returnIndex + 1) != TokenKind.Identifier)
    {
        return false;
    }

    if (!TokenTextEqualsAsciiSpan(stream, source, localNameToken, (u32[0 max])(returnIndex + 1)))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterReturn = returnIndex + 2;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (stream.KindAt(afterReturn) != TokenKind.RBrace)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, arms.Condition.NodeId, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType thenType = TypeOfNodeWithLocals(nodes, arms.ThenArm.NodeId, localTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, arms.ElseArm.NodeId, localTypes);
    stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool bothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
    if (!bothInt && !bothBool)
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId condValue = LowerExprNodeWithTypesAndLocals(nodes, arms.Condition.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId thenValue = LowerExprNodeWithTypesAndLocals(nodes, arms.ThenArm.NodeId, instrs, localTypes, noOverrides);
    if (bothBool)
    {
        thenValue = MirZExt(instrs, thenValue);
    }

    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);

    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId elseValue = LowerExprNodeWithTypesAndLocals(nodes, arms.ElseArm.NodeId, instrs, localTypes, noOverrides);
    if (bothBool)
    {
        elseValue = MirZExt(instrs, elseValue);
    }

    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack MirBlockId thenBlock = MirReturnBlock(blocks, thenValue);
    stack MirBlockId elseBlock = MirReturnBlock(blocks, elseValue);

    if (recordRanges)
    {
        stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
        stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = condValue.Index();
    body.ThenValue = thenValue.Index();
    body.ElseValue = elseValue.Index();
    return true;
}

internal fn bool LowerModuleLocalIfExpressionFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyStartsWithLocalIfExpressionInitializer(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    if (localStart >= limit
        || stream.KindAt(localStart) != TokenKind.Var
        || stream.KindAt(localStart + 1) != TokenKind.Identifier
        || stream.KindAt(localStart + 2) != TokenKind.Assign
        || stream.KindAt(localStart + 3) != TokenKind.If)
    {
        return false;
    }

    stack u32[0 max] localNameToken = (u32[0 max])(localStart + 1);
    stack u64[0 2 ** 63 - 1] assignToken = localStart + 2;

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseIfExpressionArms(stream, source, nodes, params, funcNames, assignToken + 1, arms))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] returnIndex = arms.ElseArm.Next;
    if (stream.KindAt(returnIndex) != TokenKind.Semi)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    if (!ResolveParamWithMergedRawPointerFactsForAssignedNodes(
        params,
        source,
        nameStart,
        nameLength,
        nodes,
        arms.ThenArm.NodeId,
        arms.ElseArm.NodeId,
        (u32[0 max])signatureParamCount))
    {
        return false;
    }

    returnIndex = returnIndex + 1;
    if (stream.KindAt(returnIndex) != TokenKind.Return)
    {
        return false;
    }

    stack ExprParseResult returnRoot = ParseExprIn(stream, source, nodes, params, funcNames, returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != signatureParamCount + 1)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack ExprType thenType = TypeOfNodeWithLocals(nodes, arms.ThenArm.NodeId, localTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, arms.ElseArm.NodeId, localTypes);
    stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool bothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
    stack bool bothPtr = thenType == ExprType.PtrType && elseType == ExprType.PtrType;
    if (!bothInt && !bothBool && !bothPtr)
    {
        return false;
    }

    stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, arms.ThenArm.NodeId, localTypes);
    if (bothBool)
    {
        localTypeCode = SourceLocalTypeCodeBool();
    }
    else if (bothPtr)
    {
        localTypeCode = SourceLocalTypeCodePointer();
    }
    else
    {
        stack u32[0 max] elseTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, arms.ElseArm.NodeId, localTypes);
        if (localTypeCode != elseTypeCode)
        {
            localTypeCode = SourceLocalTypeCodeInt();
        }
    }

    if (localTypes.Add(localTypeCode) == 0)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, arms.Condition.NodeId, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, localTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId condValue = LowerExprNodeWithTypesAndLocals(nodes, arms.Condition.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId thenValue = LowerExprNodeWithTypesAndLocals(nodes, arms.ThenArm.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);

    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId elseValue = LowerExprNodeWithTypesAndLocals(nodes, arms.ElseArm.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType phiType = MirType.I64;
    stack mut MirType knownPhiType = MirType.I64;
    if (TryMirTypeForSourceLocalValueTypeCode(localTypeCode, knownPhiType))
    {
        phiType = knownPhiType;
    }

    stack MirValueId phi = MirPhi2Typed(instrs, phiType, thenValue, MirBlockIdOf(firstBlock + 1), elseValue, MirBlockIdOf(firstBlock + 2));

    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] p = 0;
    while willexit (p < signatureParamCount)
    {
        if (localOverrides.Add(0) == 0)
        {
            return false;
        }

        p = p + 1;
    }

    if (localOverrides.Add(phi.Index()) == 0)
    {
        return false;
    }

    stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, returnRoot.NodeId, instrs, localTypes, localOverrides);
    stack mut MirValueId returnValue = value;
    if (rootType == ExprType.BoolType)
    {
        returnValue = MirZExt(instrs, value);
    }

    stack u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack MirBlockId thenBlock = MirBranchBlock(blocks, MirBlockIdOf(firstBlock + 3));
    stack MirBlockId elseBlock = MirBranchBlock(blocks, MirBlockIdOf(firstBlock + 3));
    stack MirBlockId mergeBlock = MirReturnBlock(blocks, returnValue);

    if (recordRanges)
    {
        stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
        stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));
        stack u32[0 max] r4 = ranges.Add(MakeBlockEmit(mergeBlock.Index(), mergeFirst, mergeCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = condValue.Index();
    body.ThenValue = phi.Index();
    body.ElseValue = returnValue.Index();
    return true;
}

internal fn bool LowerModuleReturnedLocalIfStatementFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyStartsWithReturnedLocalIfStatement(stream, source, funcNames, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (!FindSelfHostedStatementEnd(stream, localStart, limit, localEnd))
    {
        return false;
    }

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    if (localNameToken == 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignToken = localEnd;
    if (stream.KindAt(localStart) != TokenKind.Var || !FindSelfHostedStatementAssign(stream, localStart, localEnd, assignToken))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] ifIndex = localEnd + 1;
    if (stream.KindAt(ifIndex) != TokenKind.If)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack ExprParseResult initResult = ParseExprIn(stream, source, nodes, params, funcNames, assignToken + 1);
    if (initResult.Next != localEnd || params.Count() != signatureParamCount || !ExprNodeCanBeDiscardedIfOverwritten(nodes, initResult.NodeId))
    {
        return false;
    }

    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseIfAssignmentArms(stream, source, nodes, params, funcNames, ifIndex, localNameToken, arms))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] returnIndex = arms.ElseArm.Next;
    if (stream.KindAt(returnIndex) != TokenKind.Return || stream.KindAt(returnIndex + 1) != TokenKind.Identifier)
    {
        return false;
    }

    if (!TokenTextEqualsAsciiSpan(stream, source, localNameToken, (u32[0 max])(returnIndex + 1)))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] afterReturn = returnIndex + 2;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, arms.Condition.NodeId, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType initType = TypeOfNodeWithLocals(nodes, initResult.NodeId, localTypes);
    stack ExprType thenType = TypeOfNodeWithLocals(nodes, arms.ThenArm.NodeId, localTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, arms.ElseArm.NodeId, localTypes);
    stack bool allInt = initType == ExprType.IntType && thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool allBool = initType == ExprType.BoolType && thenType == ExprType.BoolType && elseType == ExprType.BoolType;
    if (!allInt && !allBool)
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId condValue = LowerExprNodeWithTypesAndLocals(nodes, arms.Condition.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId thenValue = LowerExprNodeWithTypesAndLocals(nodes, arms.ThenArm.NodeId, instrs, localTypes, noOverrides);
    if (allBool)
    {
        thenValue = MirZExt(instrs, thenValue);
    }

    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);

    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId elseValue = LowerExprNodeWithTypesAndLocals(nodes, arms.ElseArm.NodeId, instrs, localTypes, noOverrides);
    if (allBool)
    {
        elseValue = MirZExt(instrs, elseValue);
    }

    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack MirBlockId thenBlock = MirReturnBlock(blocks, thenValue);
    stack MirBlockId elseBlock = MirReturnBlock(blocks, elseValue);

    if (recordRanges)
    {
        stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
        stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = condValue.Index();
    body.ThenValue = thenValue.Index();
    body.ElseValue = elseValue.Index();
    return true;
}

internal fn bool LowerModuleLocalIfStatementFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyStartsWithLocalIfStatementAssignment(stream, source, funcNames, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (!FindSelfHostedStatementEnd(stream, localStart, limit, localEnd))
    {
        return false;
    }

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    if (localNameToken == 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignToken = localEnd;
    if (stream.KindAt(localStart) != TokenKind.Var || !FindSelfHostedStatementAssign(stream, localStart, localEnd, assignToken))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] ifIndex = localEnd + 1;
    if (stream.KindAt(ifIndex) != TokenKind.If)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack ExprParseResult initResult = ParseExprIn(stream, source, nodes, params, funcNames, assignToken + 1);
    if (initResult.Next != localEnd
        || params.Count() != signatureParamCount
        || !ExprNodeCanBeDiscardedIfOverwritten(nodes, initResult.NodeId))
    {
        return false;
    }

    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseIfAssignmentArms(stream, source, nodes, params, funcNames, ifIndex, localNameToken, arms))
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] returnIndex = arms.ElseArm.Next;
    if (stream.KindAt(returnIndex) != TokenKind.Return)
    {
        return false;
    }

    if (!ResolveParamWithMergedRawPointerFactsForAssignedNodes(
        params,
        source,
        nameStart,
        nameLength,
        nodes,
        arms.ThenArm.NodeId,
        arms.ElseArm.NodeId,
        (u32[0 max])signatureParamCount))
    {
        return false;
    }

    stack ExprParseResult returnRoot = ParseExprIn(stream, source, nodes, params, funcNames, returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != signatureParamCount + 1)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack ExprType initType = TypeOfNodeWithLocals(nodes, initResult.NodeId, localTypes);
    stack ExprType thenType = TypeOfNodeWithLocals(nodes, arms.ThenArm.NodeId, localTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, arms.ElseArm.NodeId, localTypes);
    stack bool allInt = initType == ExprType.IntType && thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool allBool = initType == ExprType.BoolType && thenType == ExprType.BoolType && elseType == ExprType.BoolType;
    stack bool allPtr = initType == ExprType.PtrType && thenType == ExprType.PtrType && elseType == ExprType.PtrType;
    if (!allInt && !allBool && !allPtr)
    {
        return false;
    }

    stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, initResult.NodeId, localTypes);
    if (allBool)
    {
        localTypeCode = SourceLocalTypeCodeBool();
    }
    else if (allPtr)
    {
        localTypeCode = SourceLocalTypeCodePointer();
    }
    else
    {
        stack u32[0 max] thenTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, arms.ThenArm.NodeId, localTypes);
        stack u32[0 max] elseTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, arms.ElseArm.NodeId, localTypes);
        if (localTypeCode != thenTypeCode || localTypeCode != elseTypeCode)
        {
            localTypeCode = SourceLocalTypeCodeInt();
        }
    }

    if (localTypes.Add(localTypeCode) == 0)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, arms.Condition.NodeId, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, localTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId condValue = LowerExprNodeWithTypesAndLocals(nodes, arms.Condition.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId thenValue = LowerExprNodeWithTypesAndLocals(nodes, arms.ThenArm.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);

    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId elseValue = LowerExprNodeWithTypesAndLocals(nodes, arms.ElseArm.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType phiType = MirType.I64;
    stack mut MirType knownPhiType = MirType.I64;
    if (TryMirTypeForSourceLocalValueTypeCode(localTypeCode, knownPhiType))
    {
        phiType = knownPhiType;
    }

    stack MirValueId phi = MirPhi2Typed(instrs, phiType, thenValue, MirBlockIdOf(firstBlock + 1), elseValue, MirBlockIdOf(firstBlock + 2));

    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] p = 0;
    while willexit (p < signatureParamCount)
    {
        if (localOverrides.Add(0) == 0)
        {
            return false;
        }

        p = p + 1;
    }

    if (localOverrides.Add(phi.Index()) == 0)
    {
        return false;
    }

    stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, returnRoot.NodeId, instrs, localTypes, localOverrides);
    stack mut MirValueId returnValue = value;
    if (rootType == ExprType.BoolType)
    {
        returnValue = MirZExt(instrs, value);
    }

    stack u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack MirBlockId thenBlock = MirBranchBlock(blocks, MirBlockIdOf(firstBlock + 3));
    stack MirBlockId elseBlock = MirBranchBlock(blocks, MirBlockIdOf(firstBlock + 3));
    stack MirBlockId mergeBlock = MirReturnBlock(blocks, returnValue);

    if (recordRanges)
    {
        stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
        stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));
        stack u32[0 max] r4 = ranges.Add(MakeBlockEmit(mergeBlock.Index(), mergeFirst, mergeCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = condValue.Index();
    body.ThenValue = phi.Index();
    body.ElseValue = returnValue.Index();
    return true;
}

internal fn bool LowerModuleLocalIfReturnFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    bool isTailCallable,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyHasLocalPrefixedTerminalIf(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localRoots = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut IrTable<ArenaDynamicLocal> arenaDynamicLocals = new();
    stack mut IrTable<StackObjectFieldInitializer> stackObjectFieldInitializers = new();
    stack mut IrTable<ScalarStorageLocal> scalarStorageLocals = new();
    stack mut IrTable<ScalarStorageInitializer> scalarStorageInitializers = new();
    stack mut IrTable<ScalarStorageAssignment> scalarStorageAssignments = new();
    stack mut IrTable<FixedArrayStorageLocal> fixedArrayStorageLocals = new();
    stack mut IrTable<FixedArrayStorageInitializer> fixedArrayStorageInitializers = new();
    stack mut IrTable<EnumStorageLocal> enumStorageLocals = new();
    stack mut IrTable<EnumStorageInitializer> enumStorageInitializers = new();
    stack mut IrTable<EnumStorageAssignment> enumStorageAssignments = new();
    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    stack mut IrTable<ConstructedObjectFieldAssignment> constructedObjectFieldAssignments = new();
    stack mut IrTable<SourceStorageMutationStatement> storageMutationStatements = new();
    stack mut IrTable<u32[0 max]> localOverrideValues = new();
    stack mut bool usesArenaFrame = false;
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, declarations, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    while willexit (cursor < limit && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, statementEnd);
        if (localNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(cursor);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
        if (localStorage == TokenKind.Var)
        {
            if (!hasAssign)
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
            stack ExprParseResult varExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, assignToken + 1);
            if (params.Count() != beforeInit)
            {
                return false;
            }

            stack ExprType varType = TypeOfNodeWithLocals(nodes, varExpr.NodeId, localTypes);
            stack mut bool rawPointerAliasMutable = false;
            stack mut u32[0 max] rawPointerAliasFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
            stack mut u32[0 max] rawPointerAliasElementSize = 0;
            stack mut u32[0 max] rawPointerAliasElementAlignment = 0;
            stack mut bool rawPointerAliasHasElementCount = false;
            stack mut bool rawPointerAliasElementCountIsParam = false;
            stack mut u32[0 max] rawPointerAliasElementCountLiteral = 0;
            stack mut u32[0 max] rawPointerAliasElementCountParamIndex = 0;
            stack bool rawPointerAlias = varType == ExprType.PtrType
                && TryGetRawPointerFactsForNode(
                    nodes,
                    params,
                    varExpr.NodeId,
                    rawPointerAliasMutable,
                    rawPointerAliasFieldTypeCode,
                    rawPointerAliasElementSize,
                    rawPointerAliasElementAlignment);
            if (varType == ExprType.ErrorType || (varType == ExprType.PtrType && !rawPointerAlias))
            {
                return false;
            }

            stack mut u32[0 max] localIndex = 0;
            if (rawPointerAlias)
            {
                if (!TryGetRawPointerElementCountFactsForNameNode(
                    nodes,
                    params,
                    varExpr.NodeId,
                    rawPointerAliasHasElementCount,
                    rawPointerAliasElementCountIsParam,
                    rawPointerAliasElementCountLiteral,
                    rawPointerAliasElementCountParamIndex))
                {
                    rawPointerAliasHasElementCount = false;
                }

                localIndex = ResolveParamWithRawPointerElementAndCountFacts(
                    params,
                    source,
                    nameStart,
                    nameLength,
                    rawPointerAliasMutable,
                    rawPointerAliasFieldTypeCode,
                    rawPointerAliasElementSize,
                    rawPointerAliasElementAlignment,
                    rawPointerAliasHasElementCount,
                    rawPointerAliasElementCountIsParam,
                    rawPointerAliasElementCountLiteral,
                    rawPointerAliasElementCountParamIndex);
            }
            else
            {
                localIndex = ResolveParam(params, source, nameStart, nameLength);
            }

            stack u32[0 max] addedRoot = localRoots.Add(varExpr.NodeId);
            stack u32[0 max] addedOverrideValue = localOverrideValues.Add(0);
            stack mut ValueFacts localFacts = new();
            if (!TryBuildSourceValueFactsForNode(nodes, varExpr.NodeId, sourceValueFacts, localFacts)
                && varType == ExprType.BoolType)
            {
                localFacts.SetIntegerRange(0, 2);
            }

            if (sourceValueFacts.Add(localFacts) == 0)
            {
                return false;
            }

            if (localTypes.Add(SourceLocalTypeCodeForNodeWithLocals(nodes, varExpr.NodeId, localTypes)) == 0)
            {
                return false;
            }
        }
        else
        {
            stack mut u32[0 max] dynamicCapacity = 0;
            stack mut u32[0 max] dynamicAlignment = 0;
            stack u32[0 max] dynamicElementTypeToken = FindSelfHostedDynamicElementTypeToken(stream, cursor, statementEnd);
            if (dynamicElementTypeToken != 0 && TryParseArenaSelectorCapacity(stream, source, cursor, statementEnd, dynamicCapacity, dynamicAlignment))
            {
                if (signature.LawKind() || localStorage == TokenKind.Heap || localStorage == TokenKind.Static || localStorage == TokenKind.Register || localStorage == TokenKind.Arena)
                {
                    return false;
                }

                stack u32[0 max] elementSize = TypeKnownByteExtentForLocal(stream, source, dynamicElementTypeToken);
                stack u32[0 max] elementAlign = TypeKnownByteAlignment(stream, source, dynamicElementTypeToken);
                if (elementSize == 0 || elementAlign == 0)
                {
                    return false;
                }

                if (dynamicAlignment == 0)
                {
                    dynamicAlignment = elementAlign;
                }

                if (dynamicAlignment < elementAlign || !IsPowerOfTwoU32(dynamicAlignment))
                {
                    return false;
                }

                if (!usesArenaFrame)
                {
                    stack MirValueId frame = MirArenaFrameEnter(instrs);
                    usesArenaFrame = true;
                }

                stack MirValueId storage = MirArenaDynamicStorageInit(instrs, dynamicCapacity, elementSize, dynamicAlignment);
                stack u32[0 max] localIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] nonValueRoot = localRoots.Add(0);
                stack u32[0 max] nonValueType = localTypes.Add(2);
                stack u32[0 max] dynamicOverrideValue = localOverrideValues.Add(0);
                if (sourceValueFacts.Add(new ValueFacts()) == 0)
                {
                    return false;
                }

                stack mut ArenaDynamicLocal dynamicLocal = new();
                dynamicLocal.Start = nameStart;
                dynamicLocal.Length = nameLength;
                dynamicLocal.StorageValue = storage.Index();
                dynamicLocal.ElementSize = elementSize;
                dynamicLocal.Alignment = dynamicAlignment;
                stack u32[0 max] addedDynamicLocal = arenaDynamicLocals.Add(dynamicLocal);

                cursor = statementEnd + 1;
                continue;
            }

            stack u32[0 max] scalarTypeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
            if (localStorage == TokenKind.Stack
                && hasAssign
                && scalarTypeToken != 0
                && TryReadSliceSuffix(stream, scalarTypeToken))
            {
                stack mut SourceSliceDescriptorLocal sliceDescriptor = new();
                stack mut bool resolvedSliceDescriptor = TryResolveSliceDescriptorFromConstructedObjectFixedArray(
                    stream,
                    source,
                    declarations,
                    enumLayouts,
                    constructedObjectLocals,
                    scalarTypeToken,
                    assignToken + 1,
                    statementEnd,
                    sliceDescriptor);
                if (!resolvedSliceDescriptor)
                {
                    resolvedSliceDescriptor = TryResolveSliceDescriptorFromFixedArrayStorageLocal(
                        stream,
                        source,
                        fixedArrayStorageLocals,
                        scalarTypeToken,
                        assignToken + 1,
                        statementEnd,
                        sliceDescriptor);
                }

                if (!resolvedSliceDescriptor)
                {
                    resolvedSliceDescriptor = TryResolveSliceDescriptorFromSourceSliceDescriptorLocal(
                        stream,
                        source,
                        sliceDescriptorLocals,
                        scalarTypeToken,
                        assignToken + 1,
                        statementEnd,
                        sliceDescriptor);
                }

                if (!resolvedSliceDescriptor)
                {
                    return false;
                }

                stack u32[0 max] sliceLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] sliceLocalRoot = localRoots.Add(0);
                stack u32[0 max] sliceLocalType = localTypes.Add(SourceLocalTypeCodeNonValue());
                stack u32[0 max] sliceOverrideValue = localOverrideValues.Add(0);
                if (sliceLocalRoot == 0
                    || sliceLocalType == 0
                    || sliceOverrideValue == 0
                    || sourceValueFacts.Add(new ValueFacts()) == 0)
                {
                    return false;
                }

                sliceDescriptor.Start = nameStart;
                sliceDescriptor.Length = nameLength;
                sliceDescriptor.Mutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
                sliceDescriptor.ParamIndex = sliceLocalIndex;
                if (sliceDescriptorLocals.Add(sliceDescriptor) == 0)
                {
                    return false;
                }

                cursor = statementEnd + 1;
                continue;
            }

            stack mut u32[0 max] fixedArrayLength = 0;
            if (localStorage == TokenKind.Stack
                && scalarTypeToken != 0
                && TryReadFixedArrayLengthSuffix(stream, source, scalarTypeToken, fixedArrayLength))
            {
                stack mut MirType elementType = MirType.I64;
                if (!MirTypeForKnownSourceScalarTypeHead(stream, source, scalarTypeToken, elementType))
                {
                    return false;
                }

                stack u32[0 max] elementSize = ScalarTypeKnownByteExtent(stream, source, scalarTypeToken);
                stack u32[0 max] elementAlignment = NaturalAlignmentForByteExtent(elementSize);
                stack u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
                stack u32[0 max] arrayAllocationSize = TypeKnownByteExtentForLocal(stream, source, scalarTypeToken);
                stack u32[0 max] arrayAllocationAlign = TypeKnownByteAlignment(stream, source, scalarTypeToken);
                if (fixedArrayLength == 0
                    || elementSize == 0
                    || elementAlignment == 0
                    || fieldTypeCode == SourceResolvedFieldTypeCodeInvalid()
                    || arrayAllocationSize == 0
                    || arrayAllocationAlign == 0)
                {
                    return false;
                }

                stack mut IrTable<u32[0 max]> initializerRoots = new();
                if (hasAssign)
                {
                    if (stream.KindAt(assignToken + 1) != TokenKind.LBrace)
                    {
                        return false;
                    }

                    stack u32[0 max] initializerClose = MatchingBraceForMirLowering(stream, (u32[0 max])(assignToken + 1));
                    if (initializerClose == (u32[0 max])(assignToken + 1)
                        || (u64[0 2 ** 63 - 1])initializerClose + 1 != statementEnd)
                    {
                        return false;
                    }

                    stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
                    if (!TryParseFixedArrayStorageInitializerRoots(
                        stream,
                        source,
                        nodes,
                        params,
                        funcNames,
                        constructedObjectLocals,
                        sliceDescriptorLocals,
                        localTypes,
                        sourceValueFacts,
                        declarations,
                        enumLayouts,
                        fixedArrayLength,
                        fieldTypeCode,
                        assignToken + 1,
                        (u64[0 2 ** 63 - 1])initializerClose,
                        initializerRoots)
                        || params.Count() != beforeInit)
                    {
                        return false;
                    }
                }
                else if (!SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd))
                {
                    return false;
                }

                stack MirValueId arrayStorage = MirStackAlloc(instrs, arrayAllocationSize, arrayAllocationAlign);
                stack u32[0 max] arrayLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] arrayLocalOrdinal = localRoots.Add(0);
                stack u32[0 max] arrayLocalType = localTypes.Add(SourceLocalTypeCodeNonValue());
                stack u32[0 max] arrayOverrideValue = localOverrideValues.Add(arrayStorage.Index());
                if (arrayLocalOrdinal == 0
                    || arrayLocalType == 0
                    || arrayOverrideValue == 0
                    || sourceValueFacts.Add(new ValueFacts()) == 0)
                {
                    return false;
                }

                stack mut FixedArrayStorageLocal fixedArrayLocal = new();
                fixedArrayLocal.Start = nameStart;
                fixedArrayLocal.Length = nameLength;
                fixedArrayLocal.Mutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
                fixedArrayLocal.ParamIndex = arrayLocalIndex;
                fixedArrayLocal.StorageValue = arrayStorage.Index();
                fixedArrayLocal.ElementSize = elementSize;
                fixedArrayLocal.Alignment = elementAlignment;
                fixedArrayLocal.ArrayLength = fixedArrayLength;
                fixedArrayLocal.ElementType = elementType;
                fixedArrayLocal.FieldTypeCode = fieldTypeCode;
                if (fixedArrayStorageLocals.Add(fixedArrayLocal) == 0)
                {
                    return false;
                }

                stack SourceSliceDescriptorLocal fixedArrayDescriptor = SourceSliceDescriptorFromFixedArrayStorageLocal(fixedArrayLocal);
                if (sliceDescriptorLocals.Add(fixedArrayDescriptor) == 0)
                {
                    return false;
                }

                if (hasAssign)
                {
                    stack mut u32[0 max] elementIndex = 0;
                    while willexit (elementIndex < fixedArrayLength)
                    {
                        stack mut FixedArrayStorageInitializer initializer = new();
                        initializer.LocalOrdinal = arrayLocalOrdinal;
                        initializer.ParamIndex = arrayLocalIndex;
                        initializer.ElementIndex = elementIndex;
                        initializer.ElementSize = elementSize;
                        initializer.Alignment = elementAlignment;
                        initializer.ElementType = elementType;
                        if (initializerRoots.Contains(elementIndex + 1))
                        {
                            initializer.ExprRoot = initializerRoots.Get(elementIndex + 1);
                        }

                        if (fixedArrayStorageInitializers.Add(initializer) == 0)
                        {
                            return false;
                        }

                        elementIndex = elementIndex + 1;
                    }
                }

            cursor = statementEnd + 1;
            continue;
        }

        if (localStorage == TokenKind.Stack
            && hasAssign
            && scalarTypeToken != 0
            && TryDeclareInitializedRawPointerStorageLocal(
                stream,
                source,
                nodes,
                params,
                funcNames,
                constructedObjectLocals,
                sliceDescriptorLocals,
                localTypes,
                localRoots,
                localOverrideValues,
                sourceValueFacts,
                declarations,
                enumLayouts,
                cursor,
                statementEnd,
                nameStart,
                nameLength,
                scalarTypeToken,
                assignToken + 1,
                instrs,
                scalarStorageLocals,
                scalarStorageInitializers))
        {
            cursor = statementEnd + 1;
            continue;
        }

        stack mut MirType scalarFieldType = MirType.I64;
        if (localStorage == TokenKind.Stack
            && hasAssign
            && scalarTypeToken != 0
            && MirTypeForKnownSourceScalarType(stream, source, scalarTypeToken, scalarFieldType))
            {
                stack u32[0 max] scalarAllocationSize = TypeKnownByteExtentForLocal(stream, source, scalarTypeToken);
                stack u32[0 max] scalarAllocationAlign = TypeKnownByteAlignment(stream, source, scalarTypeToken);
                stack u32[0 max] scalarLocalTypeCode = SourceLocalStoredScalarTypeCodeForMirType(scalarFieldType);
                if (scalarAllocationSize == 0
                    || scalarAllocationAlign == 0
                    || !SourceLocalTypeCodeIsStoredScalar(scalarLocalTypeCode))
                {
                    return false;
                }

                stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
                stack ExprParseResult scalarExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, assignToken + 1);
                if (params.Count() != beforeInit || scalarExpr.NodeId == 0 || scalarExpr.Next != statementEnd)
                {
                    return false;
                }

                stack ExprType scalarExprType = TypeOfNodeWithLocals(nodes, scalarExpr.NodeId, localTypes);
                if (!FieldInitializerTypeMatches(scalarFieldType, scalarExprType))
                {
                    return false;
                }

                stack MirValueId scalarStorage = MirStackAlloc(instrs, scalarAllocationSize, scalarAllocationAlign);
                stack bool scalarMutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
                stack u32[0 max] scalarLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] scalarLocalOrdinal = localRoots.Add(0);
                stack u32[0 max] scalarLocalType = localTypes.Add(scalarLocalTypeCode);
                stack u32[0 max] scalarOverrideValue = localOverrideValues.Add(scalarStorage.Index());
                stack mut ValueFacts scalarFacts = new();
                if (!scalarMutable)
                {
                    stack mut ValueFacts parsedFacts = new();
                    if (TryBuildSourceValueFactsForNode(nodes, scalarExpr.NodeId, sourceValueFacts, parsedFacts))
                    {
                        scalarFacts = parsedFacts;
                    }
                }

                if (sourceValueFacts.Add(scalarFacts) == 0)
                {
                    return false;
                }

                stack mut ScalarStorageLocal scalarLocal = new();
                scalarLocal.Start = nameStart;
                scalarLocal.Length = nameLength;
                scalarLocal.ParamIndex = scalarLocalIndex;
                scalarLocal.StorageValue = scalarStorage.Index();
                scalarLocal.FieldAlignment = scalarAllocationAlign;
                scalarLocal.FieldType = scalarFieldType;
                scalarLocal.Mutable = scalarMutable;
                stack u32[0 max] addedScalarLocal = scalarStorageLocals.Add(scalarLocal);
                if (addedScalarLocal == 0)
                {
                    return false;
                }

                stack mut ScalarStorageInitializer scalarInitializer = new();
                scalarInitializer.LocalOrdinal = scalarLocalOrdinal;
                scalarInitializer.ParamIndex = scalarLocalIndex;
                scalarInitializer.FieldAlignment = scalarAllocationAlign;
                scalarInitializer.FieldType = scalarFieldType;
                scalarInitializer.ExprRoot = scalarExpr.NodeId;
                stack u32[0 max] addedScalarInitializer = scalarStorageInitializers.Add(scalarInitializer);
                if (addedScalarInitializer == 0)
                {
                    return false;
                }

            cursor = statementEnd + 1;
            continue;
        }

        if (localStorage == TokenKind.Stack
            && !hasAssign
            && scalarTypeToken != 0
            && TryDeclareUninitializedRawPointerStorageLocal(
                stream,
                source,
                cursor,
                statementEnd,
                nameStart,
                nameLength,
                scalarTypeToken,
                params,
                instrs,
                localRoots,
                localTypes,
                localOverrideValues,
                sourceValueFacts,
                scalarStorageLocals))
        {
            cursor = statementEnd + 1;
            continue;
        }

        if (localStorage == TokenKind.Stack
            && !hasAssign
            && scalarTypeToken != 0
            && MirTypeForKnownSourceScalarType(stream, source, scalarTypeToken, scalarFieldType))
            {
                if (!TryDeclareUninitializedScalarStorageLocal(
                    stream,
                    source,
                    cursor,
                    statementEnd,
                    nameStart,
                    nameLength,
                    scalarTypeToken,
                    scalarFieldType,
                    params,
                    instrs,
                    localRoots,
                    localTypes,
                    localOverrideValues,
                    sourceValueFacts,
                    scalarStorageLocals))
                {
                    return false;
                }

                cursor = statementEnd + 1;
                continue;
            }

            stack mut u32[0 max] enumOwnerDeclarationIndex = 0;
            stack mut Compiler.Parsing.DeclItem enumItem = new();
            if (localStorage == TokenKind.Stack
                && hasAssign
                && scalarTypeToken != 0
                && TryGetSourceEnumOwnerDeclarationForToken(stream, source, declarations, scalarTypeToken, enumOwnerDeclarationIndex, enumItem))
            {
                stack mut u32[0 max] enumAllocationSize = 0;
                stack mut u32[0 max] enumAllocationAlign = 1;
                if (!TryGetSourceEnumStorageLayout(enumLayouts, enumOwnerDeclarationIndex, enumAllocationSize, enumAllocationAlign))
                {
                    return false;
                }

                stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
                stack ExprParseResult enumExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, assignToken + 1);
                if (params.Count() != beforeInit || enumExpr.NodeId == 0 || enumExpr.Next != statementEnd)
                {
                    return false;
                }

                stack mut u32[0 max] enumExprOwnerTypeIndex = 0;
                stack u32[0 max] enumOwnerTypeIndex = enumOwnerDeclarationIndex + 1;
                if (TypeOfNodeWithLocals(nodes, enumExpr.NodeId, localTypes) != ExprType.EnumType
                    || !TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, enumExpr.NodeId, localTypes, enumExprOwnerTypeIndex)
                    || enumExprOwnerTypeIndex != enumOwnerTypeIndex)
                {
                    return false;
                }

                stack MirValueId enumStorage = MirStackAlloc(instrs, enumAllocationSize, enumAllocationAlign);
                stack bool enumMutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
                stack u32[0 max] enumLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] enumLocalOrdinal = localRoots.Add(0);
                stack u32[0 max] enumLocalType = localTypes.Add(SourceLocalTypeCodeForStoredEnumOwnerDeclarationIndex(enumOwnerDeclarationIndex));
                stack u32[0 max] enumOverrideValue = localOverrideValues.Add(enumStorage.Index());
                if (enumLocalOrdinal == 0
                    || enumLocalType == 0
                    || enumOverrideValue == 0
                    || sourceValueFacts.Add(new ValueFacts()) == 0)
                {
                    return false;
                }

                stack mut EnumStorageLocal enumLocal = new();
                enumLocal.Start = nameStart;
                enumLocal.Length = nameLength;
                enumLocal.ParamIndex = enumLocalIndex;
                enumLocal.StorageValue = enumStorage.Index();
                enumLocal.FieldAlignment = enumAllocationAlign;
                enumLocal.OwnerTypeIndex = enumOwnerTypeIndex;
                enumLocal.Mutable = enumMutable;
                if (enumStorageLocals.Add(enumLocal) == 0)
                {
                    return false;
                }

                stack mut EnumStorageInitializer enumInitializer = new();
                enumInitializer.LocalOrdinal = enumLocalOrdinal;
                enumInitializer.ParamIndex = enumLocalIndex;
                enumInitializer.FieldAlignment = enumAllocationAlign;
                enumInitializer.OwnerTypeIndex = enumOwnerTypeIndex;
                enumInitializer.ExprRoot = enumExpr.NodeId;
                if (enumStorageInitializers.Add(enumInitializer) == 0)
                {
                    return false;
                }

                cursor = statementEnd + 1;
                continue;
            }

            stack mut u32[0 max] allocationSize = 0;
            stack mut u32[0 max] allocationAlign = 0;
            if (localStorage == TokenKind.Arena)
            {
                stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
                if (typeToken == 0)
                {
                    return false;
                }

                allocationSize = TypeKnownByteExtentForLocalWithEnums(stream, source, declarations, enumLayouts, typeToken);
                allocationAlign = TypeKnownByteAlignmentWithEnums(stream, source, declarations, enumLayouts, typeToken);
                if (allocationSize == 0 || allocationAlign == 0)
                {
                    return false;
                }
            }
            else if (!TryParseArenaSelectorAllocation(stream, source, cursor, statementEnd, allocationSize, allocationAlign))
            {
                stack u32[0 max] objectTypeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
                stack mut u32[0 max] bodyOpen = 0;
                stack mut u32[0 max] bodyClose = 0;
                stack mut u32[0 max] argsOpen = 0;
                stack mut u32[0 max] argsClose = 0;
                stack bool objectStorageLocal = localStorage == TokenKind.Stack || localStorage == TokenKind.Heap;
                stack mut bool objectConstructor = false;
                stack mut bool positionalRecordConstructor = false;
                if (objectStorageLocal
                    && hasAssign
                    && objectTypeToken != 0
                    && TryParseTargetTypedObjectConstructorShape(stream, source, objectTypeToken, assignToken, statementEnd, bodyOpen, bodyClose))
                {
                    objectConstructor = true;
                }
                else if (objectStorageLocal
                    && hasAssign
                    && objectTypeToken != 0
                    && TryParseTargetTypedPositionalRecordConstructorShape(stream, source, objectTypeToken, assignToken, statementEnd, argsOpen, argsClose))
                {
                    objectConstructor = true;
                    positionalRecordConstructor = true;
                }

                if (objectConstructor)
                {
                    if (localStorage == TokenKind.Heap && signature.LawKind())
                    {
                        return false;
                    }

                    stack u32[0 max] objectAllocationSize = TypeKnownByteExtentForLocalWithEnums(stream, source, declarations, enumLayouts, objectTypeToken);
                    stack u32[0 max] objectAllocationAlign = TypeKnownByteAlignmentWithEnums(stream, source, declarations, enumLayouts, objectTypeToken);
                    if (objectAllocationSize == 0 || objectAllocationAlign == 0)
                    {
                        return false;
                    }

                    stack mut MirValueId objectAllocation = new();
                    if (localStorage == TokenKind.Heap)
                    {
                        objectAllocation = MirHeapAlloc(instrs, objectAllocationSize, objectAllocationAlign);
                    }
                    else
                    {
                        objectAllocation = MirStackAlloc(instrs, objectAllocationSize, objectAllocationAlign);
                    }

                    stack u32[0 max] objectLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                    stack u32[0 max] objectNonValueRoot = localRoots.Add(0);
                    stack u32[0 max] objectNonValueType = localTypes.Add(SourceLocalTypeCodeNonValue());
                    stack u32[0 max] objectOverrideValue = localOverrideValues.Add(objectAllocation.Index());
                    if (sourceValueFacts.Add(new ValueFacts()) == 0)
                    {
                        return false;
                    }

                    if (positionalRecordConstructor)
                    {
                        if (!TryParseStackObjectPositionalRecordConstructorInitializers(
                            stream,
                            source,
                            declarations,
                            enumLayouts,
                            objectTypeToken,
                            argsOpen,
                            argsClose,
                            objectNonValueRoot,
                            objectAllocation,
                            nodes,
                            params,
                            funcNames,
                            constructedObjectLocals,
                            localTypes,
                            sourceValueFacts,
                            stackObjectFieldInitializers))
                        {
                            return false;
                        }
                    }
                    else
                    {
                        if (!TryParseStackObjectFieldInitializers(
                            stream,
                            source,
                            declarations,
                            enumLayouts,
                            objectTypeToken,
                            bodyOpen,
                            bodyClose,
                            objectNonValueRoot,
                            objectAllocation,
                            nodes,
                            params,
                            funcNames,
                            constructedObjectLocals,
                            localTypes,
                            sourceValueFacts,
                            stackObjectFieldInitializers))
                        {
                            return false;
                        }
                    }

                    stack mut ConstructedObjectLocal constructedObjectLocal = new();
                    constructedObjectLocal.Start = nameStart;
                    constructedObjectLocal.Length = nameLength;
                    constructedObjectLocal.ParamIndex = objectLocalIndex;
                    constructedObjectLocal.TypeToken = objectTypeToken;
                    stack u32[0 max] addedConstructedObjectLocal = constructedObjectLocals.Add(constructedObjectLocal);

                    cursor = statementEnd + 1;
                    continue;
                }

                stack u32[0 max] nonArenaLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] nonArenaRoot = localRoots.Add(0);
                stack u32[0 max] nonArenaType = localTypes.Add(2);
                stack u32[0 max] nonArenaOverrideValue = localOverrideValues.Add(0);
                if (sourceValueFacts.Add(new ValueFacts()) == 0)
                {
                    return false;
                }

                cursor = statementEnd + 1;
                continue;
            }

            if (signature.LawKind() || localStorage == TokenKind.Heap || localStorage == TokenKind.Static)
            {
                return false;
            }

            if (!usesArenaFrame)
            {
                stack MirValueId frame = MirArenaFrameEnter(instrs);
                usesArenaFrame = true;
            }

            stack MirValueId allocation = MirArenaAlloc(instrs, allocationSize, allocationAlign);
            stack u32[0 max] localIndex = ResolveParam(params, source, nameStart, nameLength);
            stack u32[0 max] nonValueRoot = localRoots.Add(0);
            stack u32[0 max] nonValueType = localTypes.Add(2);
            stack u32[0 max] arenaOverrideValue = localOverrideValues.Add(0);
            if (sourceValueFacts.Add(new ValueFacts()) == 0)
            {
                return false;
            }
        }

        cursor = statementEnd + 1;
    }

    while willexit (cursor < limit && stream.KindAt(cursor) != TokenKind.If)
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        if (TryParseSourceStorageMutationStatement(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            scalarStorageLocals,
            enumStorageLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            cursor,
            statementEnd,
            scalarStorageAssignments,
            enumStorageAssignments,
            constructedObjectFieldAssignments,
            storageMutationStatements))
        {
            cursor = statementEnd + 1;
            continue;
        }
        else if (!TryLowerArenaDynamicReserveStatement(stream, source, arenaDynamicLocals, cursor, statementEnd, instrs))
        {
            return false;
        }

        cursor = statementEnd + 1;
    }

    if (cursor >= limit || stream.KindAt(cursor) != TokenKind.If)
    {
        return false;
    }

    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseTerminalIfReturnArmsWithConstructedObjectLocalsAndSlices(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor, arms))
    {
        return false;
    }

    stack ExprParseResult condResult = arms.Condition;
    stack ExprParseResult thenResult = arms.ThenArm;
    stack ExprParseResult elseResult = arms.ElseArm;
    stack bool thenBecome = arms.ThenBecome;
    stack bool elseBecome = arms.ElseBecome;

    if ((thenBecome || elseBecome) && (!isTailCallable || usesArenaFrame))
    {
        return false;
    }

    if (params.Count() != signatureParamCount + localRoots.Count())
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, condResult.NodeId, loweringLocalTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType thenType = TypeOfNodeWithLocals(nodes, thenResult.NodeId, loweringLocalTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, elseResult.NodeId, loweringLocalTypes);
    stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool bothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType && !thenBecome && !elseBecome;
    if (!bothInt && !bothBool)
    {
        return false;
    }

    if (thenBecome && !TailCallTargetIsTailCallable(nodes, thenResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    if (elseBecome && !TailCallTargetIsTailCallable(nodes, elseResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localCount = localRoots.Count();
    stack mut u64[0 2 ** 63 - 1] v = 0;
    stack mut u32[0 max] nextStackObjectInitializer = 1;
    stack mut u32[0 max] nextScalarStorageInitializer = 1;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    stack mut u32[0 max] nextEnumStorageInitializer = 1;
    while willexit (v < localCount)
    {
        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(v + 1));
        if (localRoot == 0)
        {
            stack mut u32[0 max] storageOverride = 0;
            if (localOverrideValues.Contains((u32[0 max])(v + 1)))
            {
                storageOverride = localOverrideValues.Get((u32[0 max])(v + 1));
            }

            stack u32[0 max] nonValueOverride = localOverrides.Add(storageOverride);
        }
        else
        {
            stack MirValueId varValue = LowerExprNodeWithCallContext(
                nodes,
                localRoot,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
            stack u32[0 max] addedOverride = localOverrides.Add(varValue.Index());
        }

        nextScalarStorageInitializer = LowerScalarStorageInitializersForLocalWithCallContext(
            scalarStorageInitializers,
            (u32[0 max])(v + 1),
            nextScalarStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
            fixedArrayStorageInitializers,
            (u32[0 max])(v + 1),
            nextFixedArrayStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextEnumStorageInitializer = LowerEnumStorageInitializersForLocalWithCallContext(
            enumStorageInitializers,
            (u32[0 max])(v + 1),
            nextEnumStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
            stackObjectFieldInitializers,
            (u32[0 max])(v + 1),
            nextStackObjectInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);
        v = v + 1;
    }

    if ((u64[0 2 ** 63 - 1])(nextScalarStorageInitializer - 1) != scalarStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextEnumStorageInitializer - 1) != enumStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return false;
    }

    if (!LowerSourceStorageMutationStatementsWithCallContext(
        storageMutationStatements,
        scalarStorageAssignments,
        enumStorageAssignments,
        constructedObjectFieldAssignments,
        nodes,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals))
    {
        return false;
    }

    stack MirValueId condValue = LowerExprNodeWithCallContext(nodes, condResult.NodeId, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId thenValue = MirValueIdOf(0);
    if (thenBecome)
    {
        thenValue = LowerTailCallExprNodeWithCallContext(nodes, thenResult.NodeId, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    }
    else
    {
        thenValue = LowerScalarReturnExprNodeWithCallContext(
            nodes,
            thenResult.NodeId,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals,
            thenType,
            hasDeclaredReturnType,
            declaredReturnType);

        if (usesArenaFrame)
        {
            stack MirValueId thenLeave = MirArenaFrameLeave(instrs);
        }
    }

    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);

    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId elseValue = MirValueIdOf(0);
    if (elseBecome)
    {
        elseValue = LowerTailCallExprNodeWithCallContext(nodes, elseResult.NodeId, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    }
    else
    {
        elseValue = LowerScalarReturnExprNodeWithCallContext(
            nodes,
            elseResult.NodeId,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals,
            elseType,
            hasDeclaredReturnType,
            declaredReturnType);

        if (usesArenaFrame)
        {
            stack MirValueId elseLeave = MirArenaFrameLeave(instrs);
        }
    }

    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack mut MirBlockId thenBlock = MirBlockIdOf(0);
    if (thenBecome)
    {
        thenBlock = MirTailCallBlock(blocks, thenValue);
    }
    else
    {
        thenBlock = MirReturnBlock(blocks, thenValue);
    }

    stack mut MirBlockId elseBlock = MirBlockIdOf(0);
    if (elseBecome)
    {
        elseBlock = MirTailCallBlock(blocks, elseValue);
    }
    else
    {
        elseBlock = MirReturnBlock(blocks, elseValue);
    }

    if (recordRanges)
    {
        stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
        stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = condValue.Index();
    body.ThenValue = thenValue.Index();
    body.ElseValue = elseValue.Index();
    return true;
}

// Parses + lowers a BRANCH-bodied module function `fn <name>(<params>) { if <cond> return
// <then> else return <else> }` into a three-block CFG — an entry that conditionally branches
// to a then-block (returns `<then>`) or an else-block (returns `<else>`), no merge — and
// emits `@f<functionNumber>`. The arms are full expressions parsed against `funcNames`, so a
// return arm may CALL another function, INCLUDING THE FUNCTION ITSELF (the first pass put
// every name in `funcNames`): that is RECURSION through the AST path (e.g. factorial). The
// condition must be boolean and both returned arms integer. Returns false if the body is not
// this shape, or is malformed / ill-typed / has an invalid call.
internal fn bool EmitModuleIfReturnFunction(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    bool isTailCallable,
    u64[0 2 ** 63 - 1] fnIndex,
    u32[0 max] functionNumber,
    mut borrow OwnedAscii sink)
{
    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0 || stream.KindAt((u64[0 2 ** 63 - 1])braceIndex + 1) != TokenKind.If)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    // `if <cond> (return|become) <then> else (return|become) <else>`.
    stack mut IrTable<ExprNode> nodes = new();
    stack u64[0 2 ** 63 - 1] ifIndex = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut ParsedIfReturnArms arms = new();
    if (!TryParseTerminalIfReturnArms(stream, source, nodes, params, funcNames, ifIndex, arms))
    {
        return false;
    }

    stack ExprParseResult condResult = arms.Condition;
    stack ExprParseResult thenResult = arms.ThenArm;
    stack ExprParseResult elseResult = arms.ElseArm;
    stack bool thenBecome = arms.ThenBecome;
    stack bool elseBecome = arms.ElseBecome;

    if ((thenBecome || elseBecome) && !isTailCallable)
    {
        return false;
    }

    // Only the signature parameters may be referenced (no undeclared name appended).
    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    // Condition boolean; integer arms return directly, boolean arms widen at the return edge.
    if (TypeOfNodeWithLocals(nodes, condResult.NodeId, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType thenType = TypeOfNodeWithLocals(nodes, thenResult.NodeId, localTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, elseResult.NodeId, localTypes);
    stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool bothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType && !thenBecome && !elseBecome;
    if (!bothInt && !bothBool)
    {
        return false;
    }

    if (thenBecome && !TailCallTargetIsTailCallable(nodes, thenResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    if (elseBecome && !TailCallTargetIsTailCallable(nodes, elseResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();

    // Entry block: lower the condition (i1).
    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId condValue = LowerExprNodeWithTypesAndLocals(nodes, condResult.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count();
    // Then block: lower + return/become the first arm.
    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId thenValue = MirValueIdOf(0);
    if (thenBecome)
    {
        stack mut IrTable<u32[0 max]> noOverridesThen = new();
        thenValue = LowerTailCallExprNodeWithTypesAndLocals(nodes, thenResult.NodeId, instrs, localTypes, noOverridesThen);
    }
    else
    {
        thenValue = LowerScalarReturnExprNodeWithTypesAndLocals(
            nodes,
            thenResult.NodeId,
            instrs,
            localTypes,
            noOverrides,
            thenType,
            hasDeclaredReturnType,
            declaredReturnType);
    }

    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);
    // Else block: lower + return/become the second arm.
    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId elseValue = MirValueIdOf(0);
    if (elseBecome)
    {
        stack mut IrTable<u32[0 max]> noOverridesElse = new();
        elseValue = LowerTailCallExprNodeWithTypesAndLocals(nodes, elseResult.NodeId, instrs, localTypes, noOverridesElse);
    }
    else
    {
        elseValue = LowerScalarReturnExprNodeWithTypesAndLocals(
            nodes,
            elseResult.NodeId,
            instrs,
            localTypes,
            noOverrides,
            elseType,
            hasDeclaredReturnType,
            declaredReturnType);
    }

    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(2), MirBlockIdOf(3));
    stack mut MirBlockId thenBlock = MirBlockIdOf(0);
    if (thenBecome)
    {
        thenBlock = MirTailCallBlock(blocks, thenValue);
    }
    else
    {
        thenBlock = MirReturnBlock(blocks, thenValue);
    }

    stack mut MirBlockId elseBlock = MirBlockIdOf(0);
    if (elseBecome)
    {
        elseBlock = MirTailCallBlock(blocks, elseValue);
    }
    else
    {
        elseBlock = MirReturnBlock(blocks, elseValue);
    }

    stack mut IrTable<BlockEmit> ranges = new();
    stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), 1, entryCount));
    stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
    stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));

    stack u32[0 max] paramCount = (u32[0 max])signatureParamCount;
    stack mut IrTable<ValueFacts> paramFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, paramFacts))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack ValueFacts returnFacts = FunctionReturnRangeFact(stream, source, signature);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    if (!ValidateBranchReturnRangeFacts(returnFacts, instrs, paramFacts, globalFacts, functionReturnFacts, condValue, thenValue, elseValue))
    {
        return false;
    }

    stack FunctionEffectFacts functionEffects = FunctionEffectFactsAt(functionEffectFacts, functionNumber);

    switch (EmitLlvmBlocksNumberedWithRangeFactsCore(
        instrs,
        funcTailFlags,
        functionEffectFacts,
        functionCallContractFacts,
        functionLinkageFacts,
        functionCallingConventionFacts,
        blocks,
        "f",
        functionNumber,
        isTailCallable,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        distinctStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        rangeMetadata,
        functionEffects,
        paramCount,
        ranges,
        sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

internal fn bool EmitModuleReturnIfExpressionFunction(
    borrow TokenStream stream,
