import Compiler.Ir
import Compiler.Mir.Model
import Compiler.Mir.Builder
import Compiler.Mir.EnumLayout
import Compiler.Mir.LlvmText
import Compiler.Mir.LlvmBlocks
import Compiler.Mir.LlvmFunctions
import Compiler.Mir.LlvmFacts
import System.Memory
import System.Text
module Compiler.Mir.LlvmModules

// LLVM module and global emission helpers.

// === Module emission ===
// Emits a whole LLVM module: one `define` per function in the function table,
// named `@fN` (N = the function's 1-based id). PRECONDITION: each function is
// single-block — only its entry block is emitted (over the whole instruction range),
// and `OwnedBlockCount` is NOT consulted, so a function recorded with more than one
// block would silently drop its non-entry blocks. Multi-block-per-function emission
// (iterating the owned block range, each block over its own instruction sub-range)
// is a later slice once the model records per-block instruction ranges; it reuses
// `EmitLlvmLabeledBlock`.

// Emits `define <ret> @<prefix><number>() { <entry block> }`.
internal fn MemoryStatus EmitLlvmDefinitionNumbered(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, const ascii prefix, u32[0 max] number, u32[0 max] entryBlockIndex, u32[0 max] firstInstr, u32[0 max] instrCount, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define ");
    try EmitLlvmTypeName(MirBlockScalarReturnType(instrs, blocks, entryBlockIndex), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(prefix);
    try sink.AppendU64((u64[0 max])number);
    try sink.AppendConstAscii("() {\n");
    try EmitLlvmLabeledBlock(instrs, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmDefinitionNumberedWithFloatConstants(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<u8[0 max]> floatPayloadBytes,
    const ascii prefix,
    u32[0 max] number,
    u32[0 max] entryBlockIndex,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define ");
    try EmitLlvmTypeName(MirBlockScalarReturnType(instrs, blocks, entryBlockIndex), sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(prefix);
    try sink.AppendU64((u64[0 max])number);
    try sink.AppendConstAscii("() {\n");
    try EmitLlvmLabeledBlockWithFloatConstants(instrs, floatPayloadBytes, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmDefinitionNumberedWithEnumLayouts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirEnumLayoutFact> enumLayoutFacts,
    const ascii prefix,
    u32[0 max] number,
    u32[0 max] entryBlockIndex,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("define ");
    try EmitLlvmReturnTypeNameWithEnumLayouts(instrs, blocks, enumLayoutFacts, entryBlockIndex, sink);
    try sink.AppendConstAscii(" @");
    try sink.AppendConstAscii(prefix);
    try sink.AppendU64((u64[0 max])number);
    try sink.AppendConstAscii("() {\n");
    try EmitLlvmLabeledBlockWithEnumLayouts(instrs, enumLayoutFacts, blocks, entryBlockIndex, firstInstr, instrCount, sink);
    try sink.AppendConstAscii("}\n");
    return MemoryStatus.Ok;
}

// Emits an LLVM module: one single-block `define` per function in `funcs`, in id
// order, each a single-block definition over its entry block. An empty table emits
// nothing.
public fn MemoryStatus EmitLlvmModule(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction f = funcs.Get(id);
        try EmitLlvmDefinitionNumbered(instrs, blocks, "f", id, f.EntryIndex(), f.FirstInstrIndex(), f.OwnedInstrCount(), sink);
        id = id + 1;
    }

    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmModuleWithFloatConstants(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<u8[0 max]> floatPayloadBytes,
    mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction f = funcs.Get(id);
        try EmitLlvmDefinitionNumberedWithFloatConstants(instrs, blocks, floatPayloadBytes, "f", id, f.EntryIndex(), f.FirstInstrIndex(), f.OwnedInstrCount(), sink);
        id = id + 1;
    }

    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmModuleWithEnumLayouts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirEnumLayoutFact> enumLayoutFacts,
    mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction f = funcs.Get(id);
        try EmitLlvmDefinitionNumberedWithEnumLayouts(instrs, blocks, enumLayoutFacts, "f", id, f.EntryIndex(), f.FirstInstrIndex(), f.OwnedInstrCount(), sink);
        id = id + 1;
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus InitializeLlvmTextConstantReferenceTable(
    borrow IrTable<MirTextConstant> textConstants,
    mut borrow IrTable<u8[0 max]> referenced)
{
    stack u64[0 2 ** 63 - 1] count = textConstants.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        if (referenced.Add(0) == 0)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        id = id + 1;
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus MarkLlvmTextConstantsInInstructionRange(
    borrow IrTable<MirInstruction> instrs,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    mut borrow IrTable<u8[0 max]> referenced)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.TextConstantValue)
            {
                stack u32[0 max] rowIndex = MirTextConstantValueRowIndex(instr);
                if (!referenced.Contains(rowIndex) || !referenced.Replace(rowIndex, 1))
                {
                    return MemoryStatus.Err(MemoryError.InvalidLayout);
                }
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus MarkLlvmTextConstantsInFunctions(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirFunction> funcs,
    mut borrow IrTable<u8[0 max]> referenced)
{
    stack u64[0 2 ** 63 - 1] count = funcs.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirFunction func = funcs.Get(id);
        try MarkLlvmTextConstantsInInstructionRange(instrs, func.FirstInstrIndex(), func.OwnedInstrCount(), referenced);
        id = id + 1;
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmReferencedTextConstantDataDeclarations(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirTextConstant> textConstants,
    borrow IrTable<u8[0 max]> textPayloadBytes,
    mut borrow OwnedAscii sink)
{
    stack mut IrTable<u8[0 max]> referenced = new();
    try InitializeLlvmTextConstantReferenceTable(textConstants, referenced);
    try MarkLlvmTextConstantsInFunctions(instrs, funcs, referenced);

    stack u64[0 2 ** 63 - 1] count = textConstants.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        if (referenced.Get(id) != 0)
        {
            stack MirTextConstant textConstant = textConstants.Get(id);
            try EmitLlvmTextConstantDataDeclaration(textPayloadBytes, textConstant, id, sink);
        }

        id = id + 1;
    }

    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmModuleWithTextConstants(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirTextConstant> textConstants,
    borrow IrTable<u8[0 max]> textPayloadBytes,
    mut borrow OwnedAscii sink)
{
    try EmitLlvmReferencedTextConstantDataDeclarations(instrs, funcs, textConstants, textPayloadBytes, sink);
    try EmitLlvmModule(instrs, blocks, funcs, sink);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmModuleWithTextAndFloatConstants(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirTextConstant> textConstants,
    borrow IrTable<u8[0 max]> textPayloadBytes,
    borrow IrTable<u8[0 max]> floatPayloadBytes,
    mut borrow OwnedAscii sink)
{
    try EmitLlvmReferencedTextConstantDataDeclarations(instrs, funcs, textConstants, textPayloadBytes, sink);
    try EmitLlvmModuleWithFloatConstants(instrs, blocks, funcs, floatPayloadBytes, sink);
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmGlobalInitializer(MirType type, i64[min max] value, mut borrow OwnedAscii sink)
{
    if (type == MirType.Ptr)
    {
        if (value == 0)
        {
            try sink.AppendConstAscii("null");
        }
        else
        {
            try sink.AppendConstAscii("inttoptr (i64 ");
            try sink.AppendI64(value);
            try sink.AppendConstAscii(" to ptr)");
        }

        return MemoryStatus.Ok;
    }

    try sink.AppendI64(value);
    return MemoryStatus.Ok;
}

// Emits one `@gN = <definition facts> global <type> V <suffix facts>` line per global in id order.
public fn MemoryStatus EmitLlvmGlobalsWithBackendFacts(
    borrow IrTable<MirGlobal> globals,
    borrow IrTable<GlobalLinkageFacts> globalLinkageFacts,
    borrow IrTable<GlobalVisibilityFacts> globalVisibilityFacts,
    borrow IrTable<GlobalSectionFacts> globalSectionFacts,
    mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = globals.Count();
    stack mut u32[0 max] id = 1;
    while willexit ((u64[0 2 ** 63 - 1])id <= count)
    {
        stack MirGlobal g = globals.Get(id);
        try sink.AppendConstAscii("@g");
        try sink.AppendU64((u64[0 max])id);
        try sink.AppendConstAscii(" =");
        try EmitLlvmGlobalLinkage(GlobalLinkageFactsAt(globalLinkageFacts, id), sink);
        try EmitLlvmGlobalVisibility(GlobalVisibilityFactsAt(globalVisibilityFacts, id), sink);
        try sink.AppendConstAscii(" global ");
        try EmitLlvmTypeName(g.StoredType(), sink);
        try sink.AppendConstAscii(" ");
        try EmitLlvmGlobalInitializer(g.StoredType(), g.InitialValue(), sink);
        try EmitLlvmGlobalSection(GlobalSectionFactsAt(globalSectionFacts, id), sink);
        try sink.AppendConstAscii("\n");
        id = id + 1;
    }

    return MemoryStatus.Ok;
}

// Emits one `@gN = <linkage> global <type> V` line per global in id order.
public fn MemoryStatus EmitLlvmGlobalsWithLinkageFacts(
    borrow IrTable<MirGlobal> globals,
    borrow IrTable<GlobalLinkageFacts> globalLinkageFacts,
    mut borrow OwnedAscii sink)
{
    stack mut IrTable<GlobalVisibilityFacts> noGlobalVisibilityFacts = new();
    stack mut IrTable<GlobalSectionFacts> noGlobalSectionFacts = new();
    return EmitLlvmGlobalsWithBackendFacts(globals, globalLinkageFacts, noGlobalVisibilityFacts, noGlobalSectionFacts, sink);
}

// Emits one `@gN = global <type> V` line per global in id order (empty table -> nothing).
public fn MemoryStatus EmitLlvmGlobals(borrow IrTable<MirGlobal> globals, mut borrow OwnedAscii sink)
{
    stack mut IrTable<GlobalLinkageFacts> noGlobalLinkageFacts = new();
    stack mut IrTable<GlobalVisibilityFacts> noGlobalVisibilityFacts = new();
    stack mut IrTable<GlobalSectionFacts> noGlobalSectionFacts = new();
    return EmitLlvmGlobalsWithBackendFacts(globals, noGlobalLinkageFacts, noGlobalVisibilityFacts, noGlobalSectionFacts, sink);
}

// Emits a complete module: globals first, then function definitions.
public fn MemoryStatus EmitLlvmModuleWithGlobals(borrow IrTable<MirInstruction> instrs, borrow IrTable<MirBlock> blocks, borrow IrTable<MirFunction> funcs, borrow IrTable<MirGlobal> globals, mut borrow OwnedAscii sink)
{
    try EmitLlvmGlobals(globals, sink);
    try EmitLlvmModule(instrs, blocks, funcs, sink);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmModuleWithGlobalsAndLinkageFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals,
    borrow IrTable<GlobalLinkageFacts> globalLinkageFacts,
    mut borrow OwnedAscii sink)
{
    try EmitLlvmGlobalsWithLinkageFacts(globals, globalLinkageFacts, sink);
    try EmitLlvmModule(instrs, blocks, funcs, sink);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmModuleWithGlobalsAndBackendFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals,
    borrow IrTable<GlobalLinkageFacts> globalLinkageFacts,
    borrow IrTable<GlobalVisibilityFacts> globalVisibilityFacts,
    borrow IrTable<GlobalSectionFacts> globalSectionFacts,
    mut borrow OwnedAscii sink)
{
    try EmitLlvmGlobalsWithBackendFacts(globals, globalLinkageFacts, globalVisibilityFacts, globalSectionFacts, sink);
    try EmitLlvmModule(instrs, blocks, funcs, sink);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmModuleWithGlobalsAndEnumLayouts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals,
    borrow IrTable<MirEnumLayoutFact> enumLayoutFacts,
    mut borrow OwnedAscii sink)
{
    try EmitLlvmGlobals(globals, sink);
    try EmitLlvmModuleWithEnumLayouts(instrs, blocks, funcs, enumLayoutFacts, sink);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmModuleWithGlobalsAndBackendFactsAndEnumLayouts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals,
    borrow IrTable<GlobalLinkageFacts> globalLinkageFacts,
    borrow IrTable<GlobalVisibilityFacts> globalVisibilityFacts,
    borrow IrTable<GlobalSectionFacts> globalSectionFacts,
    borrow IrTable<MirEnumLayoutFact> enumLayoutFacts,
    mut borrow OwnedAscii sink)
{
    try EmitLlvmGlobalsWithBackendFacts(globals, globalLinkageFacts, globalVisibilityFacts, globalSectionFacts, sink);
    try EmitLlvmModuleWithEnumLayouts(instrs, blocks, funcs, enumLayoutFacts, sink);
    return MemoryStatus.Ok;
}

public fn MemoryStatus EmitLlvmModuleWithGlobalsAndLinkageFactsAndEnumLayouts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals,
    borrow IrTable<GlobalLinkageFacts> globalLinkageFacts,
    borrow IrTable<MirEnumLayoutFact> enumLayoutFacts,
    mut borrow OwnedAscii sink)
{
    try EmitLlvmGlobalsWithLinkageFacts(globals, globalLinkageFacts, sink);
    try EmitLlvmModuleWithEnumLayouts(instrs, blocks, funcs, enumLayoutFacts, sink);
    return MemoryStatus.Ok;
}
