public struct SourceTryPropagationRoleFacts
{
    bool ValidValue;
    u32[0 max] OkVariantOrdinalValue;
    u32[0 max] OkVariantTagValue;
    u32[0 max] OkPayloadCountValue;
    u32[0 max] OkPayloadTypeCodeValue;
    u32[0 max] ErrVariantOrdinalValue;
    u32[0 max] ErrVariantTagValue;
    u32[0 max] ErrPayloadCountValue;
    u32[0 max] ErrPayloadTypeCodeValue;

    SourceTryPropagationRoleFacts()
    {
        self.ValidValue = false;
        self.OkVariantOrdinalValue = 0;
        self.OkVariantTagValue = 0;
        self.OkPayloadCountValue = 0;
        self.OkPayloadTypeCodeValue = SourceResolvedFieldTypeCodeInvalid();
        self.ErrVariantOrdinalValue = 0;
        self.ErrVariantTagValue = 0;
        self.ErrPayloadCountValue = 0;
        self.ErrPayloadTypeCodeValue = SourceResolvedFieldTypeCodeInvalid();
    }

    public inline finite law bool IsValid(borrow SourceTryPropagationRoleFacts self)
    {
        return self.ValidValue;
    }

    public inline finite law u32[0 max] OkVariantOrdinal(borrow SourceTryPropagationRoleFacts self)
    {
        return self.OkVariantOrdinalValue;
    }

    public inline finite law u32[0 max] OkVariantTag(borrow SourceTryPropagationRoleFacts self)
    {
        return self.OkVariantTagValue;
    }

    public inline finite law u32[0 max] OkPayloadCount(borrow SourceTryPropagationRoleFacts self)
    {
        return self.OkPayloadCountValue;
    }

    public inline finite law u32[0 max] OkPayloadTypeCode(borrow SourceTryPropagationRoleFacts self)
    {
        return self.OkPayloadTypeCodeValue;
    }

    public inline finite law u32[0 max] ErrVariantOrdinal(borrow SourceTryPropagationRoleFacts self)
    {
        return self.ErrVariantOrdinalValue;
    }

    public inline finite law u32[0 max] ErrVariantTag(borrow SourceTryPropagationRoleFacts self)
    {
        return self.ErrVariantTagValue;
    }

    public inline finite law u32[0 max] ErrPayloadCount(borrow SourceTryPropagationRoleFacts self)
    {
        return self.ErrPayloadCountValue;
    }

    public inline finite law u32[0 max] ErrPayloadTypeCode(borrow SourceTryPropagationRoleFacts self)
    {
        return self.ErrPayloadTypeCodeValue;
    }
}

public enum SourceTryPropagationErrorCompatibilityKind
{
    Invalid,
    UnitFailure,
    SameFailurePayloadType,
    FunnelFailurePayloadType,
}

public struct SourceTryPropagationCompatibilityFacts
{
    bool ValidValue;
    SourceTryPropagationErrorCompatibilityKind ErrorCompatibilityKindValue;
    SourceTryPropagationRoleFacts OperandRolesValue;
    SourceTryPropagationRoleFacts ReturnRolesValue;
    u32[0 max] ErrorFunnelOwnerDeclarationIndexValue;
    u32[0 max] ErrorFunnelVariantOrdinalValue;
    u32[0 max] ErrorFunnelVariantTagValue;

    SourceTryPropagationCompatibilityFacts()
    {
        self.ValidValue = false;
        self.ErrorCompatibilityKindValue = SourceTryPropagationErrorCompatibilityKind.Invalid;
        self.OperandRolesValue = new();
        self.ReturnRolesValue = new();
        self.ErrorFunnelOwnerDeclarationIndexValue = 0;
        self.ErrorFunnelVariantOrdinalValue = 0;
        self.ErrorFunnelVariantTagValue = 0;
    }

    public inline finite law bool IsValid(borrow SourceTryPropagationCompatibilityFacts self)
    {
        return self.ValidValue;
    }

    public inline finite law SourceTryPropagationErrorCompatibilityKind ErrorCompatibilityKind(borrow SourceTryPropagationCompatibilityFacts self)
    {
        return self.ErrorCompatibilityKindValue;
    }

    public inline finite law SourceTryPropagationRoleFacts OperandRoles(borrow SourceTryPropagationCompatibilityFacts self)
    {
        return self.OperandRolesValue;
    }

    public inline finite law SourceTryPropagationRoleFacts ReturnRoles(borrow SourceTryPropagationCompatibilityFacts self)
    {
        return self.ReturnRolesValue;
    }

    public inline finite law u32[0 max] ErrorFunnelOwnerDeclarationIndex(borrow SourceTryPropagationCompatibilityFacts self)
    {
        return self.ErrorFunnelOwnerDeclarationIndexValue;
    }

    public inline finite law u32[0 max] ErrorFunnelVariantOrdinal(borrow SourceTryPropagationCompatibilityFacts self)
    {
        return self.ErrorFunnelVariantOrdinalValue;
    }

    public inline finite law u32[0 max] ErrorFunnelVariantTag(borrow SourceTryPropagationCompatibilityFacts self)
    {
        return self.ErrorFunnelVariantTagValue;
    }
}

public struct SourceTryPropagationLoweringResult
{
    bool ValidValue;
    MirBlockId EntryBlockValue;
    MirBlockId ErrorBlockValue;
    MirBlockId ContinueBlockValue;
    MirValueId ConditionValue;
    MirValueId ErrorReturnValue;
    MirValueId SuccessValueValue;

    SourceTryPropagationLoweringResult()
    {
        self.ValidValue = false;
        self.EntryBlockValue = MirBlockIdOf(0);
        self.ErrorBlockValue = MirBlockIdOf(0);
        self.ContinueBlockValue = MirBlockIdOf(0);
        self.ConditionValue = MirValueIdOf(0);
        self.ErrorReturnValue = MirValueIdOf(0);
        self.SuccessValueValue = MirValueIdOf(0);
    }

    public inline finite law bool IsValid(borrow SourceTryPropagationLoweringResult self)
    {
        return self.ValidValue;
    }

    public inline finite law MirBlockId EntryBlock(borrow SourceTryPropagationLoweringResult self)
    {
        return self.EntryBlockValue;
    }

    public inline finite law MirBlockId ErrorBlock(borrow SourceTryPropagationLoweringResult self)
    {
        return self.ErrorBlockValue;
    }

    public inline finite law MirBlockId ContinueBlock(borrow SourceTryPropagationLoweringResult self)
    {
        return self.ContinueBlockValue;
    }

    public inline finite law MirValueId Condition(borrow SourceTryPropagationLoweringResult self)
    {
        return self.ConditionValue;
    }

    public inline finite law MirValueId ErrorReturn(borrow SourceTryPropagationLoweringResult self)
    {
        return self.ErrorReturnValue;
    }

    public inline finite law MirValueId SuccessValue(borrow SourceTryPropagationLoweringResult self)
    {
        return self.SuccessValueValue;
    }
}

public fn bool TryResolveSourceTryPropagationRoleFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    out SourceTryPropagationRoleFacts facts)
{
    facts = new();
    stack mut SourceTryPropagationRoleFacts resolved = new();
    stack mut bool okSeen = false;
    stack mut bool errSeen = false;
    stack mut u32[0 max] variantRows = 0;

    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (moduleFacts.EnumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Variant)
        {
            variantRows = variantRows + 1;
            if (variantRows > 2)
            {
                return false;
            }

            stack u32[0 max] payloadCount = moduleFacts.EnumLayouts.PayloadCountAt(index);
            if (payloadCount > 1)
            {
                return false;
            }

            stack mut u32[0 max] payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (payloadCount == 1
                && !TryGetSourceEnumPayloadTypeCode(
                    stream,
                    source,
                    moduleFacts,
                    ownerDeclarationIndex,
                    moduleFacts.EnumLayouts.VariantOrdinalAt(index),
                    0,
                    payloadTypeCode))
            {
                return false;
            }

            stack TypedEnumVariantRole role = moduleFacts.EnumLayouts.VariantRoleAt(index);
            if (role == TypedEnumVariantRole.Ok)
            {
                if (okSeen)
                {
                    return false;
                }

                okSeen = true;
                resolved.OkVariantOrdinalValue = moduleFacts.EnumLayouts.VariantOrdinalAt(index);
                resolved.OkVariantTagValue = moduleFacts.EnumLayouts.VariantTagAt(index);
                resolved.OkPayloadCountValue = payloadCount;
                resolved.OkPayloadTypeCodeValue = payloadTypeCode;
            }
            else if (role == TypedEnumVariantRole.Err)
            {
                if (errSeen)
                {
                    return false;
                }

                errSeen = true;
                resolved.ErrVariantOrdinalValue = moduleFacts.EnumLayouts.VariantOrdinalAt(index);
                resolved.ErrVariantTagValue = moduleFacts.EnumLayouts.VariantTagAt(index);
                resolved.ErrPayloadCountValue = payloadCount;
                resolved.ErrPayloadTypeCodeValue = payloadTypeCode;
            }
            else
            {
                return false;
            }
        }

        index = index + 1;
    }

    if (variantRows != 2 || !okSeen || !errSeen)
    {
        return false;
    }

    resolved.ValidValue = true;
    facts = resolved;
    return true;
}

public fn bool TryLowerSameFamilySourceTryPropagation(
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    borrow SourceTryPropagationCompatibilityFacts facts,
    MirValueId operandValue,
    u32[0 max] operandOwnerDeclarationIndex,
    u32[0 max] returnOwnerDeclarationIndex,
    MirBlockId continuationTarget,
    u32[0 max] entryFirst,
    MirType tagType,
    bool recordRanges,
    out SourceTryPropagationLoweringResult result)
{
    result = new();
    if (!facts.IsValid()
        || !operandValue.IsValid()
        || !continuationTarget.IsValid()
        || facts.ErrorCompatibilityKind() == SourceTryPropagationErrorCompatibilityKind.Invalid)
    {
        return false;
    }

    stack SourceTryPropagationRoleFacts operandRoles = facts.OperandRoles();
    stack SourceTryPropagationRoleFacts returnRoles = facts.ReturnRoles();
    if (!operandRoles.IsValid() || !returnRoles.IsValid())
    {
        return false;
    }

    stack TypeId operandOwnerType = TypeIdOf(operandOwnerDeclarationIndex + 1);
    stack TypeId returnOwnerType = TypeIdOf(returnOwnerDeclarationIndex + 1);
    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack MirValueId tagValue = MirEnumTagRead(instrs, operandOwnerType, operandValue, tagType);
    stack MirValueId errTagValue = MirConstIntTyped(instrs, tagType, (i64[min max])operandRoles.ErrVariantTag());
    stack MirValueId isErr = MirCmpEq(instrs, tagValue, errTagValue);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] errorFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId errorReturn = operandValue;
    if (operandOwnerDeclarationIndex != returnOwnerDeclarationIndex)
    {
        errorReturn = MirEnumVariantTag(instrs, returnOwnerType, returnRoles.ErrVariantOrdinal());
        if (facts.ErrorCompatibilityKind() == SourceTryPropagationErrorCompatibilityKind.SameFailurePayloadType)
        {
            stack MirType failurePayloadType = MirTypeForResolvedFieldTypeCode(operandRoles.ErrPayloadTypeCode());
            stack MirValueId failurePayload = MirEnumPayloadExtract(
                instrs,
                operandOwnerType,
                operandRoles.ErrVariantOrdinal(),
                0,
                operandValue,
                failurePayloadType);
            errorReturn = MirEnumPayloadInsert(
                instrs,
                returnOwnerType,
                returnRoles.ErrVariantOrdinal(),
                0,
                errorReturn,
                failurePayload);
        }
        else if (facts.ErrorCompatibilityKind() == SourceTryPropagationErrorCompatibilityKind.FunnelFailurePayloadType)
        {
            stack TypeId funnelOwnerType = TypeIdOf(facts.ErrorFunnelOwnerDeclarationIndex() + 1);
            stack MirType failurePayloadType = MirTypeForResolvedFieldTypeCode(operandRoles.ErrPayloadTypeCode());
            stack MirValueId failurePayload = MirEnumPayloadExtract(
                instrs,
                operandOwnerType,
                operandRoles.ErrVariantOrdinal(),
                0,
                operandValue,
                failurePayloadType);
            stack MirValueId funnelTag = MirEnumVariantTag(
                instrs,
                funnelOwnerType,
                facts.ErrorFunnelVariantOrdinal());
            stack MirValueId funnelValue = MirEnumPayloadInsert(
                instrs,
                funnelOwnerType,
                facts.ErrorFunnelVariantOrdinal(),
                0,
                funnelTag,
                failurePayload);
            errorReturn = MirEnumPayloadInsert(
                instrs,
                returnOwnerType,
                returnRoles.ErrVariantOrdinal(),
                0,
                errorReturn,
                funnelValue);
        }
    }

    stack u32[0 max] errorCount = (u32[0 max])instrs.Count() - (errorFirst - 1);
    stack u32[0 max] continueFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId successValue = MirConstIntTyped(instrs, tagType, 0);
    if (operandRoles.OkPayloadCount() == 1)
    {
        stack MirType successPayloadType = MirTypeForResolvedFieldTypeCode(operandRoles.OkPayloadTypeCode());
        successValue = MirEnumPayloadExtract(
            instrs,
            operandOwnerType,
            operandRoles.OkVariantOrdinal(),
            0,
            operandValue,
            successPayloadType);
    }

    stack u32[0 max] continueCount = (u32[0 max])instrs.Count() - (continueFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, isErr, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack MirBlockId errorBlock = MirReturnBlock(blocks, errorReturn);
    stack MirBlockId continueBlock = MirBranchBlock(blocks, continuationTarget);

    if (recordRanges)
    {
        stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] errorRange = ranges.Add(MakeBlockEmit(errorBlock.Index(), errorFirst, errorCount));
        stack u32[0 max] continueRange = ranges.Add(MakeBlockEmit(continueBlock.Index(), continueFirst, continueCount));
        if (entryRange == 0 || errorRange == 0 || continueRange == 0)
        {
            return false;
        }
    }

    stack mut SourceTryPropagationLoweringResult lowered = new();
    lowered.ValidValue = true;
    lowered.EntryBlockValue = entry;
    lowered.ErrorBlockValue = errorBlock;
    lowered.ContinueBlockValue = continueBlock;
    lowered.ConditionValue = isErr;
    lowered.ErrorReturnValue = errorReturn;
    lowered.SuccessValueValue = successValue;
    result = lowered;
    return true;
}

internal fn bool TryGetSourceTryOkPayloadRangeFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    SourceTryPropagationRoleFacts roles,
    out ValueFacts facts)
{
    facts = new();
    if (!roles.IsValid() || roles.OkPayloadCount() != 1)
    {
        return false;
    }

    stack mut TypedSignatureTypeKind payloadTypeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] payloadTypeHeadToken = 0;
    stack mut u32[0 max] payloadTypeStartToken = 0;
    stack mut u32[0 max] payloadTypeEndToken = 0;
    if (!TryGetSourceTryPayloadTypeSpan(
        moduleFacts,
        ownerDeclarationIndex,
        roles.OkVariantOrdinal(),
        0,
        payloadTypeKind,
        payloadTypeHeadToken,
        payloadTypeStartToken,
        payloadTypeEndToken))
    {
        return false;
    }

    if (payloadTypeKind == TypedSignatureTypeKind.Bool)
    {
        facts.SetIntegerRange(0, 2);
        return true;
    }

    if (payloadTypeKind != TypedSignatureTypeKind.Integer)
    {
        return false;
    }

    return TryReadIntegerRangeFact(stream, source, payloadTypeHeadToken, facts)
        && facts.HasIntegerRange();
}

internal fn bool SourceTryOkPayloadSatisfiesDeclaredAssignmentRange(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    SourceTryPropagationRoleFacts roles,
    ConstructedObjectFieldAssignment assignment)
{
    if (!assignment.TargetHasDeclaredRange)
    {
        return true;
    }

    stack mut ValueFacts payloadFacts = new();
    if (!TryGetSourceTryOkPayloadRangeFacts(
        stream,
        source,
        moduleFacts,
        ownerDeclarationIndex,
        roles,
        payloadFacts))
    {
        return false;
    }

    stack mut ValueFacts targetFacts = new();
    targetFacts.SetIntegerRange(
        assignment.TargetDeclaredRangeLower,
        assignment.TargetDeclaredRangeUpperExclusive);
    return IntegerRangeFactsSubsetOf(payloadFacts, targetFacts);
}

internal fn bool SourceLocalAsciiTokenTextEqualsToken(
    borrow TokenStream stream,
    ascii source,
    u32[0 max] left,
    u32[0 max] right)
{
    stack ascii leftText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])left);
    stack ascii rightText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])right);
    return System.Text.Equals(leftText, rightText);
}

internal fn bool TryGetSourceEnumOwnerDeclarationForAsciiToken(
    borrow TokenStream stream,
    ascii source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerToken,
    out u32[0 max] ownerDeclarationIndex,
    out Compiler.Parsing.DeclItem enumItem)
{
    ownerDeclarationIndex = 0;
    enumItem = new();

    stack u64[0 2 ** 63 - 1] count = moduleFacts.Declarations.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack Compiler.Parsing.DeclItem item = moduleFacts.Declarations.ItemAt(index);
        if (item.Kind == Compiler.Parsing.DeclarationKind.Enum
            && item.NameToken != 0
            && SourceLocalAsciiTokenTextEqualsToken(stream, source, ownerToken, item.NameToken))
        {
            ownerDeclarationIndex = (u32[0 max])index;
            enumItem = item;
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool SourceLocalTypeSpansCompatible(
    borrow TokenStream stream,
    ascii source,
    u32[0 max] leftStart,
    u32[0 max] leftEnd,
    u32[0 max] rightStart,
    u32[0 max] rightEnd)
{
    if (leftStart >= leftEnd || rightStart >= rightEnd)
    {
        return leftStart >= leftEnd && rightStart >= rightEnd;
    }

    stack u32[0 max] leftLength = (u32[0 max])(leftEnd - leftStart);
    stack u32[0 max] rightLength = (u32[0 max])(rightEnd - rightStart);
    if (leftLength != rightLength)
    {
        return false;
    }

    stack mut u32[0 max] offset = 0;
    while willexit (offset < leftLength)
    {
        stack u32[0 max] left = (u32[0 max])(leftStart + offset);
        stack u32[0 max] right = (u32[0 max])(rightStart + offset);
        if (stream.KindAt((u64[0 2 ** 63 - 1])left) != stream.KindAt((u64[0 2 ** 63 - 1])right)
            || !SourceLocalAsciiTokenTextEqualsToken(stream, source, left, right))
        {
            return false;
        }

        offset = (u32[0 max])(offset + 1);
    }

    return true;
}

internal fn bool TryGetSourceTryPayloadTypeSpan(
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    out TypedSignatureTypeKind payloadTypeKind,
    out u32[0 max] payloadTypeHeadToken,
    out u32[0 max] payloadTypeStartToken,
    out u32[0 max] payloadTypeEndToken)
{
    payloadTypeKind = TypedSignatureTypeKind.Unknown;
    payloadTypeHeadToken = 0;
    payloadTypeStartToken = 0;
    payloadTypeEndToken = 0;

    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumPayloads.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (moduleFacts.EnumPayloads.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumPayloads.VariantOrdinalAt(index) == variantOrdinal
            && moduleFacts.EnumPayloads.PayloadOrdinalAt(index) == payloadOrdinal)
        {
            payloadTypeKind = moduleFacts.EnumPayloads.TypeKindAt(index);
            payloadTypeHeadToken = moduleFacts.EnumPayloads.TypeHeadTokenAt(index);
            payloadTypeStartToken = moduleFacts.EnumPayloads.TypeStartTokenAt(index);
            payloadTypeEndToken = moduleFacts.EnumPayloads.TypeEndTokenAt(index);
            return payloadTypeStartToken != 0 && payloadTypeStartToken < payloadTypeEndToken;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool TryGetSourceTryVariantTag(
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    out u32[0 max] variantTag)
{
    variantTag = 0;
    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (moduleFacts.EnumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Variant
            && moduleFacts.EnumLayouts.VariantOrdinalAt(index) == variantOrdinal)
        {
            variantTag = moduleFacts.EnumLayouts.VariantTagAt(index);
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool TryResolveSourceTryErrorFunnelVariant(
    borrow TokenStream stream,
    ascii source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] enclosingFailureTypeHeadToken,
    u32[0 max] operandFailureTypeStartToken,
    u32[0 max] operandFailureTypeEndToken,
    out u32[0 max] funnelOwnerDeclarationIndex,
    out u32[0 max] funnelVariantOrdinal,
    out u32[0 max] funnelVariantTag)
{
    funnelOwnerDeclarationIndex = 0;
    funnelVariantOrdinal = 0;
    funnelVariantTag = 0;

    if (enclosingFailureTypeHeadToken == 0)
    {
        return false;
    }

    stack mut Compiler.Parsing.DeclItem ignoredOwner = new();
    stack mut u32[0 max] resolvedFunnelOwnerDeclarationIndex = 0;
    if (!TryGetSourceEnumOwnerDeclarationForAsciiToken(
        stream,
        source,
        moduleFacts,
        enclosingFailureTypeHeadToken,
        resolvedFunnelOwnerDeclarationIndex,
        ignoredOwner))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumPayloads.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (moduleFacts.EnumPayloads.OwnerDeclarationIndexAt(index) == resolvedFunnelOwnerDeclarationIndex
            && moduleFacts.EnumPayloads.IsErrorFunnelAt(index)
            && SourceLocalTypeSpansCompatible(
                stream,
                source,
                moduleFacts.EnumPayloads.TypeStartTokenAt(index),
                moduleFacts.EnumPayloads.TypeEndTokenAt(index),
                operandFailureTypeStartToken,
                operandFailureTypeEndToken))
        {
            stack mut u32[0 max] resolvedFunnelVariantOrdinal = moduleFacts.EnumPayloads.VariantOrdinalAt(index);
            stack mut u32[0 max] resolvedFunnelVariantTag = 0;
            if (!TryGetSourceTryVariantTag(
                moduleFacts,
                resolvedFunnelOwnerDeclarationIndex,
                resolvedFunnelVariantOrdinal,
                resolvedFunnelVariantTag))
            {
                return false;
            }

            funnelOwnerDeclarationIndex = resolvedFunnelOwnerDeclarationIndex;
            funnelVariantOrdinal = resolvedFunnelVariantOrdinal;
            funnelVariantTag = resolvedFunnelVariantTag;
            return true;
        }

        index = index + 1;
    }

    return false;
}

public fn bool TryResolveSourceTryPropagationCompatibility(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] operandOwnerDeclarationIndex,
    u32[0 max] returnOwnerDeclarationIndex,
    out SourceTryPropagationCompatibilityFacts facts)
    where overlap(sourceText, source)
{
    facts = new();

    stack mut SourceTryPropagationRoleFacts operandRoles = new();
    if (!TryResolveSourceTryPropagationRoleFacts(stream, source, moduleFacts, operandOwnerDeclarationIndex, operandRoles))
    {
        return false;
    }

    stack mut SourceTryPropagationRoleFacts returnRoles = new();
    if (!TryResolveSourceTryPropagationRoleFacts(stream, source, moduleFacts, returnOwnerDeclarationIndex, returnRoles))
    {
        return false;
    }

    stack mut SourceTryPropagationCompatibilityFacts resolved = new();
    resolved.OperandRolesValue = operandRoles;
    resolved.ReturnRolesValue = returnRoles;

    if (operandRoles.ErrPayloadCount() == 0 && returnRoles.ErrPayloadCount() == 0)
    {
        resolved.ValidValue = true;
        resolved.ErrorCompatibilityKindValue = SourceTryPropagationErrorCompatibilityKind.UnitFailure;
        facts = resolved;
        return true;
    }

    if (operandRoles.ErrPayloadCount() != 1 || returnRoles.ErrPayloadCount() != 1)
    {
        return false;
    }

    stack mut TypedSignatureTypeKind operandFailureTypeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] operandFailureTypeHeadToken = 0;
    stack mut u32[0 max] operandFailureTypeStartToken = 0;
    stack mut u32[0 max] operandFailureTypeEndToken = 0;
    if (!TryGetSourceTryPayloadTypeSpan(
        moduleFacts,
        operandOwnerDeclarationIndex,
        operandRoles.ErrVariantOrdinal(),
        0,
        operandFailureTypeKind,
        operandFailureTypeHeadToken,
        operandFailureTypeStartToken,
        operandFailureTypeEndToken))
    {
        return false;
    }

    stack mut TypedSignatureTypeKind returnFailureTypeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] returnFailureTypeHeadToken = 0;
    stack mut u32[0 max] returnFailureTypeStartToken = 0;
    stack mut u32[0 max] returnFailureTypeEndToken = 0;
    if (!TryGetSourceTryPayloadTypeSpan(
        moduleFacts,
        returnOwnerDeclarationIndex,
        returnRoles.ErrVariantOrdinal(),
        0,
        returnFailureTypeKind,
        returnFailureTypeHeadToken,
        returnFailureTypeStartToken,
        returnFailureTypeEndToken))
    {
        return false;
    }

    if (operandFailureTypeKind == returnFailureTypeKind
        && SourceLocalTypeSpansCompatible(
            stream,
            sourceText,
            operandFailureTypeStartToken,
            operandFailureTypeEndToken,
            returnFailureTypeStartToken,
            returnFailureTypeEndToken))
    {
        resolved.ValidValue = true;
        resolved.ErrorCompatibilityKindValue = SourceTryPropagationErrorCompatibilityKind.SameFailurePayloadType;
        facts = resolved;
        return true;
    }

    if (returnFailureTypeKind != TypedSignatureTypeKind.Named)
    {
        return false;
    }

    stack mut u32[0 max] funnelOwnerDeclarationIndex = 0;
    stack mut u32[0 max] funnelVariantOrdinal = 0;
    stack mut u32[0 max] funnelVariantTag = 0;
    if (!TryResolveSourceTryErrorFunnelVariant(
        stream,
        sourceText,
        moduleFacts,
        returnFailureTypeHeadToken,
        operandFailureTypeStartToken,
        operandFailureTypeEndToken,
        funnelOwnerDeclarationIndex,
        funnelVariantOrdinal,
        funnelVariantTag))
    {
        return false;
    }

    resolved.ValidValue = true;
    resolved.ErrorCompatibilityKindValue = SourceTryPropagationErrorCompatibilityKind.FunnelFailurePayloadType;
    resolved.ErrorFunnelOwnerDeclarationIndexValue = funnelOwnerDeclarationIndex;
    resolved.ErrorFunnelVariantOrdinalValue = funnelVariantOrdinal;
    resolved.ErrorFunnelVariantTagValue = funnelVariantTag;
    facts = resolved;
    return true;
}

internal fn bool TryGetSourceEnumPayloadTypeCode(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    out u32[0 max] payloadTypeCode)
{
    payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();

    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (moduleFacts.EnumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Payload
            && moduleFacts.EnumLayouts.VariantOrdinalAt(index) == variantOrdinal
            && moduleFacts.EnumLayouts.PayloadOrdinalAt(index) == payloadOrdinal)
        {
            payloadTypeCode = SourceResolvedFieldTypeCodeForTypedEnumPayload(moduleFacts.EnumLayouts.TypeKindAt(index), moduleFacts.EnumLayouts.BitWidthAt(index));
            if (payloadTypeCode != SourceResolvedFieldTypeCodeInvalid())
            {
                return true;
            }

            stack mut MirType ignoredFieldType = MirType.I64;
            return TryGetSourceValueTypeCodeWithEnums(
                stream,
                source,
                moduleFacts,
                moduleFacts.EnumLayouts.TypePrimaryTokenAt(index),
                ignoredFieldType,
                payloadTypeCode);
        }

        index = index + 1;
    }

    return false;
}

internal fn bool TryGetSourceNamedEnumPayloadTypeCode(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadNameToken,
    out u32[0 max] payloadOrdinal,
    out u32[0 max] payloadTypeCode)
{
    payloadOrdinal = 0;
    payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();

    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] rowPayloadNameToken = moduleFacts.EnumLayouts.PayloadNameTokenAt(index);
        if (moduleFacts.EnumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Payload
            && moduleFacts.EnumLayouts.VariantOrdinalAt(index) == variantOrdinal
            && moduleFacts.EnumLayouts.UsesNamedPayloadsAt(index)
            && rowPayloadNameToken != 0
            && SourceLocalTokenTextEqualsToken(stream, source, payloadNameToken, rowPayloadNameToken))
        {
            payloadOrdinal = moduleFacts.EnumLayouts.PayloadOrdinalAt(index);
            payloadTypeCode = SourceResolvedFieldTypeCodeForTypedEnumPayload(moduleFacts.EnumLayouts.TypeKindAt(index), moduleFacts.EnumLayouts.BitWidthAt(index));
            if (payloadTypeCode != SourceResolvedFieldTypeCodeInvalid())
            {
                return true;
            }

            stack mut MirType ignoredFieldType = MirType.I64;
            return TryGetSourceValueTypeCodeWithEnums(
                stream,
                source,
                moduleFacts,
                moduleFacts.EnumLayouts.TypePrimaryTokenAt(index),
                ignoredFieldType,
                payloadTypeCode);
        }

        index = index + 1;
    }

    return false;
}

internal fn bool SourceEnumPayloadOrdinalListContains(
    borrow IrTable<u32[0 max]> payloadOrdinals,
    u32[0 max] payloadOrdinal)
{
    stack u64[0 2 ** 63 - 1] count = payloadOrdinals.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (payloadOrdinals.Get((u32[0 max])(index + 1)) == payloadOrdinal)
        {
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal finite law bool SourceExpressionTypeMatchesEnumPayloadTypeCode(ExprType exprType, u32[0 max] payloadTypeCode)
{
    if (payloadTypeCode == SourceResolvedFieldTypeCodeBool())
    {
        return exprType == ExprType.BoolType;
    }

    if (payloadTypeCode == SourceResolvedFieldTypeCodeI8()
        || payloadTypeCode == SourceResolvedFieldTypeCodeI16()
        || payloadTypeCode == SourceResolvedFieldTypeCodeI32()
        || payloadTypeCode == SourceResolvedFieldTypeCodeI64())
    {
        return exprType == ExprType.IntType;
    }

    if (SourceResolvedFieldTypeCodeIsEnum(payloadTypeCode))
    {
        return exprType == ExprType.EnumType;
    }

    return false;
}


