import Compiler.Ir
import Compiler.Lexing
import Compiler.Parsing
import Compiler.Binding.Diagnostics
import Compiler.Binding.FunctionEffects
import Compiler.Binding.ModuleResolution
import Compiler.Binding.TypedDeclarations
import Compiler.Binding.TypedMembers
import Compiler.Binding.TypedModuleSymbols
import Compiler.Mir.LlvmBlocks
import Compiler.Mir.LlvmFacts
import Compiler.Mir.LlvmInstructions
import Compiler.Mir.Model
import Compiler.Mir.SourceFunctionContext
module Compiler.Mir.SourceFunctionEffects

// Allocation-free MIR effect scans and fixed-point source-function proofs that
// preserve law, finite, recursion, memory, and explicit backend modifier facts.

internal fn bool BuildSourceTypedFunctionEffectSummaries(
    ascii sourceText,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    out TypedFunctionEffectSummaryTable summaries)
{
    summaries = new();
    stack mut CompilationUnitHeader header = new();
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return false;
        case ParseResult<CompilationUnitHeader>.Ok(var parsedHeader):
            header = parsedHeader;
    }

    stack mut TypedModuleSymbolTable moduleSymbols = new();
    switch (BuildTypedModuleSymbols(sourceText, stream, header, declarations, ModuleOrigin.Source, 0))
    {
        case BindResult<TypedModuleSymbolTable>.Err(var moduleError):
            return false;
        case BindResult<TypedModuleSymbolTable>.Ok(var builtModuleSymbols):
            moduleSymbols = builtModuleSymbols;
    }

    stack mut TypedDeclarationSymbolTable typedDeclarations = new();
    switch (BuildTypedDeclarationSymbols(sourceText, stream, declarations, moduleSymbols))
    {
        case BindResult<TypedDeclarationSymbolTable>.Err(var declarationError):
            return false;
        case BindResult<TypedDeclarationSymbolTable>.Ok(var builtDeclarations):
            typedDeclarations = builtDeclarations;
    }

    stack mut TypedMemberSymbolTable typedMembers = new();
    switch (BuildTypedMemberAndMethodSymbols(sourceText, stream, typedDeclarations))
    {
        case BindResult<TypedMemberSymbolTable>.Err(var memberError):
            return false;
        case BindResult<TypedMemberSymbolTable>.Ok(var builtMembers):
            typedMembers = builtMembers;
    }

    switch (BuildTypedFunctionEffectSummaries(sourceText, stream, typedDeclarations, typedMembers))
    {
        case BindResult<TypedFunctionEffectSummaryTable>.Err(var effectError):
            return false;
        case BindResult<TypedFunctionEffectSummaryTable>.Ok(var builtSummaries):
            summaries = builtSummaries;
            return true;
    }
}

internal law bool TypedFunctionEffectSummaryMatchesTopLevelFunction(
    borrow TypedFunctionEffectSummaryTable summaries,
    u64[0 2 ** 63 - 1] summaryIndex,
    u32[0 max] fnKeyword)
{
    return summaryIndex < summaries.Count()
        && summaries.OwnerKindAt(summaryIndex) == TypedFunctionEffectOwnerKind.Declaration
        && summaries.KeywordTokenAt(summaryIndex) == fnKeyword;
}

internal fn bool ApplyTypedFunctionBackendEffectFacts(
    borrow TypedFunctionEffectSummaryTable summaries,
    u64[0 2 ** 63 - 1] summaryIndex,
    u32[0 max] fnKeyword,
    mut borrow FunctionEffectFacts facts)
{
    if (!TypedFunctionEffectSummaryMatchesTopLevelFunction(summaries, summaryIndex, fnKeyword))
    {
        return false;
    }

    facts.NoSync = summaries.NoSyncAt(summaryIndex);
    facts.NoFree = summaries.NoFreeAt(summaryIndex);
    facts.NoUnwind = summaries.NoUnwindAt(summaryIndex);
    facts.WillReturn = summaries.WillReturnAt(summaryIndex);
    facts.MustProgress = summaries.MustProgressAt(summaryIndex);
    facts.IsNoRecurse = summaries.NoRecurseAt(summaryIndex);
    facts.IsHot = summaries.IsHotAt(summaryIndex);
    facts.IsCold = summaries.IsColdAt(summaryIndex);
    facts.IsStrictFp = summaries.IsStrictFpAt(summaryIndex);
    facts.BackendIsOpaque = summaries.BackendOptimizationModeAt(summaryIndex)
        == TypedFunctionBackendOptimizationMode.Opaque;

    switch (summaries.InlinePreferenceAt(summaryIndex))
    {
        case TypedFunctionInlinePreference.InlineHint:
            facts.InlinePreference = FunctionInlinePreference.InlineHint;
        case TypedFunctionInlinePreference.Inline:
            facts.InlinePreference = FunctionInlinePreference.Inline;
        case TypedFunctionInlinePreference.NoInline:
            facts.InlinePreference = FunctionInlinePreference.NoInline;
    }

    if (facts.BackendIsOpaque)
    {
        facts.InlinePreference = FunctionInlinePreference.NoInline;
    }

    return true;
}

internal fn bool ApplyTypedFunctionCallingConventionFacts(
    borrow TypedFunctionEffectSummaryTable summaries,
    u64[0 2 ** 63 - 1] summaryIndex,
    u32[0 max] fnKeyword,
    mut borrow FunctionCallingConventionFacts facts)
{
    if (!TypedFunctionEffectSummaryMatchesTopLevelFunction(summaries, summaryIndex, fnKeyword))
    {
        return false;
    }

    if (summaries.UseFastCallingConventionAt(summaryIndex))
    {
        SetFastCallingConvention(facts);
    }

    return true;
}

internal fn bool MirInstructionRangeHasCall(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (MirOpIsAnyCall(instr.Opcode()))
            {
                return true;
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangeReadsMemory(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.LoadGlobal || instr.Opcode() == MirOp.LoadPtr || instr.Opcode() == MirOp.LoadEnumPtr || MirOpIsAnyCall(instr.Opcode()) || MirInstructionIsArenaRuntime(instr) || MirInstructionIsHeapRuntime(instr))
            {
                return true;
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangeWritesMemory(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.StoreGlobal || instr.Opcode() == MirOp.StorePtr || instr.Opcode() == MirOp.StoreEnumPtr || MirInstructionIsArenaRuntime(instr) || MirInstructionIsHeapRuntime(instr))
            {
                return true;
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangesHaveCall(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeHasCall(instrs, ranges.Get(i).First, ranges.Get(i).Count))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool MirInstructionRangesReadMemory(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeReadsMemory(instrs, ranges.Get(i).First, ranges.Get(i).Count))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool MirInstructionRangesWriteMemory(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeWritesMemory(instrs, ranges.Get(i).First, ranges.Get(i).Count))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool FunctionIdFlagIsSet(borrow IrTable<u32[0 max]> flags, u32[0 max] functionId)
{
    if (functionId == 0 || !flags.Contains(functionId))
    {
        return false;
    }

    return flags.Get(functionId) != 0;
}

internal fn bool MirInstructionRangeCallsOnlyFlaggedFunctions(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount, borrow IrTable<u32[0 max]> flags)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (MirOpIsAnyCall(instr.Opcode()))
            {
                if (!FunctionIdFlagIsSet(flags, (u32[0 max])instr.Immediate()))
                {
                    return false;
                }
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return true;
}

internal fn bool FunctionIdLawMayReadMemory(borrow IrTable<FunctionEffectFacts> functionEffectFacts, u32[0 max] functionId)
{
    if (functionId == 0 || !functionEffectFacts.Contains(functionId))
    {
        return true;
    }

    stack FunctionEffectFacts facts = functionEffectFacts.Get(functionId);
    return !facts.IsLaw || facts.LawMayReadMemory;
}

internal fn bool MirInstructionRangeReadsMemoryWithFunctionEffects(
    borrow IrTable<MirInstruction> instrs,
    u32[0 max] firstInstr,
    u32[0 max] instrCount,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (instr.Opcode() == MirOp.LoadGlobal || instr.Opcode() == MirOp.LoadPtr || instr.Opcode() == MirOp.LoadEnumPtr || MirInstructionIsArenaRuntime(instr) || MirInstructionIsHeapRuntime(instr))
            {
                return true;
            }

            if (MirOpIsAnyCall(instr.Opcode()))
            {
                if (FunctionIdLawMayReadMemory(functionEffectFacts, (u32[0 max])instr.Immediate()))
                {
                    return true;
                }
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangeCallsAnyLawMayReadMemory(borrow IrTable<MirInstruction> instrs, u32[0 max] firstInstr, u32[0 max] instrCount, borrow IrTable<FunctionEffectFacts> functionEffectFacts)
{
    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (instrs.Contains(index))
        {
            stack MirInstruction instr = instrs.Get(index);
            if (MirOpIsAnyCall(instr.Opcode()))
            {
                if (FunctionIdLawMayReadMemory(functionEffectFacts, (u32[0 max])instr.Immediate()))
                {
                    return true;
                }
            }
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionRangesReadMemoryWithFunctionEffects(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<BlockEmit> ranges,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeReadsMemoryWithFunctionEffects(instrs, ranges.Get(i).First, ranges.Get(i).Count, functionEffectFacts))
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool MirInstructionRangesCallOnlyFlaggedFunctions(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges, borrow IrTable<u32[0 max]> flags)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (!MirInstructionRangeCallsOnlyFlaggedFunctions(instrs, ranges.Get(i).First, ranges.Get(i).Count, flags))
        {
            return false;
        }

        i = i + 1;
    }

    return true;
}

internal fn bool MirInstructionRangesCallAnyLawMayReadMemory(borrow IrTable<MirInstruction> instrs, borrow IrTable<BlockEmit> ranges, borrow IrTable<FunctionEffectFacts> functionEffectFacts)
{
    stack u64[0 2 ** 63 - 1] total = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        if (MirInstructionRangeCallsAnyLawMayReadMemory(instrs, ranges.Get(i).First, ranges.Get(i).Count, functionEffectFacts))
