    while willexit (postCallIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalCallRoot = postLocalRoots.Get((u32[0 max])(postCallIndex + 1));
        if (!ValidateModuleCallsForRootWithSlices(nodes, postLocalCallRoot, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
        {
            return false;
        }

        postCallIndex = postCallIndex + 1;
    }

    if (hasTerminalIf)
    {
        if (!ValidateModuleCallsForRootWithSlices(nodes, terminalIfArms.Condition.NodeId, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts)
            || !ValidateModuleCallsForRootWithSlices(nodes, terminalIfArms.ThenArm.NodeId, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts)
            || !ValidateModuleCallsForRootWithSlices(nodes, terminalIfArms.ElseArm.NodeId, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
        {
            return false;
        }
    }
    else if (!ValidateModuleCallsForRootWithSlices(nodes, returnRoot.NodeId, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localCount = localRoots.Count();
    stack mut u64[0 2 ** 63 - 1] v = 0;
    stack mut u32[0 max] nextStackObjectInitializer = 1;
    stack mut u32[0 max] nextScalarStorageInitializer = 1;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    stack mut u32[0 max] nextEnumStorageInitializer = 1;
    while willexit (v < localCount)
    {
        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(v + 1));
        if (localRoot == 0)
        {
            stack mut u32[0 max] storageOverride = 0;
            if (localOverrideValues.Contains((u32[0 max])(v + 1)))
            {
                storageOverride = localOverrideValues.Get((u32[0 max])(v + 1));
            }

            if (localOverrides.Add(storageOverride) == 0)
            {
                return false;
            }
        }
        else
        {
            stack MirValueId varValue = LowerExprNodeWithCallContext(nodes, localRoot, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
            if (localOverrides.Add(varValue.Index()) == 0)
            {
                return false;
            }
        }

        nextScalarStorageInitializer = LowerScalarStorageInitializersForLocalWithCallContext(
            scalarStorageInitializers,
            (u32[0 max])(v + 1),
            nextScalarStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
            fixedArrayStorageInitializers,
            (u32[0 max])(v + 1),
            nextFixedArrayStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextEnumStorageInitializer = LowerEnumStorageInitializersForLocalWithCallContext(
            enumStorageInitializers,
            (u32[0 max])(v + 1),
            nextEnumStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
            stackObjectFieldInitializers,
            (u32[0 max])(v + 1),
            nextStackObjectInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);
        v = v + 1;
    }

    if ((u64[0 2 ** 63 - 1])(nextScalarStorageInitializer - 1) != scalarStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextEnumStorageInitializer - 1) != enumStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return false;
    }

    if (switchCasesAreBoolean)
    {
        return LowerBooleanSwitchFieldAssignmentCasesToBlocks(
            nodes,
            scrutinee.NodeId,
            booleanCaseValues,
            caseArms,
            armLocalRoots,
            scalarAssignments,
            enumAssignments,
            fieldAssignments,
            arenaDynamicReserveStatements,
            storageMutationStatements,
            defaultArm,
            postLocalRoots,
            hasTerminalIf,
            terminalIfArms,
            returnRoot.NodeId,
            loweringLocalTypes,
            localOverrides,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            usesArenaFrame,
            functionCallContractFacts,
            sliceArgumentLocals,
            body);
    }

    return LowerIntegerSwitchFieldAssignmentCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        caseArms,
        armLocalRoots,
        scalarAssignments,
        enumAssignments,
        fieldAssignments,
        arenaDynamicReserveStatements,
        storageMutationStatements,
        defaultArm,
        postLocalRoots,
        hasTerminalIf,
        terminalIfArms,
        returnRoot.NodeId,
        loweringLocalTypes,
        localOverrides,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        usesArenaFrame,
        functionCallContractFacts,
        sliceArgumentLocals,
        body);
}

internal fn bool LowerModuleTerminalIntegerSwitchFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyStartsWithTerminalSwitch(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFactsWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut u32[0 max] enumReturnOwnerDeclarationIndex = 0;
    stack mut Compiler.Parsing.DeclItem enumReturnItem = new();
    if (TryGetSourceEnumOwnerDeclarationForToken(
        stream,
        source,
        moduleFacts,
        signature.ReturnTypeTokenAt(),
        enumReturnOwnerDeclarationIndex,
        enumReturnItem))
    {
        stack mut IrTable<u32[0 max]> enumLocalTypes = new();
        if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, enumLocalTypes))
        {
            return false;
        }

        stack mut IrTable<ValueFacts> sourceValueFacts = new();
        if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
        {
            return false;
        }

        stack mut IrTable<ExprNode> enumNodes = new();
        stack mut ExprParseResult enumScrutinee = new();
        stack mut IrTable<i64[min max]> enumCaseValues = new();
        stack mut IrTable<i64[min max]> enumCaseMaxValues = new();
        stack mut IrTable<ExprParseResult> enumCaseArms = new();
        stack mut ExprParseResult enumDefaultArm = new();
        stack mut u64[0 2 ** 63 - 1] enumNextToken = 0;
        if (!TryParseTerminalIntegerSwitchReturnCasesWithEnums(
            stream,
            source,
            moduleFacts,
            enumNodes,
            params,
            funcNames,
            enumLocalTypes,
            sourceValueFacts,
            (u64[0 2 ** 63 - 1])braceIndex + 1,
            enumScrutinee,
            enumCaseValues,
            enumCaseMaxValues,
            enumCaseArms,
            enumDefaultArm,
            enumNextToken))
        {
            return false;
        }

        if (stream.KindAt(enumNextToken) != TokenKind.RBrace)
        {
            return false;
        }

        if (params.Count() != signatureParamCount)
        {
            return false;
        }

        stack mut IrTable<DistinctStoragePair> enumDistinctStorageFacts = new();
        if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, enumDistinctStorageFacts))
        {
            return false;
        }

        if (!ValidateModuleCalls(enumNodes, funcParamCounts, functionCallContractFacts, enumLocalTypes, enumDistinctStorageFacts))
        {
            return false;
        }

        stack mut IrTable<u32[0 max]> enumNoOverrides = new();
        stack u32[0 max] enumEntryFirst = (u32[0 max])instrs.Count() + 1;
        stack mut MirType ignoredDeclaredReturnType = MirType.I64;
        stack bool ignoredHasDeclaredReturnType = false;
        return LowerTerminalIntegerSwitchCasesToBlocks(
            enumNodes,
            enumScrutinee.NodeId,
            enumCaseValues,
            enumCaseMaxValues,
            enumCaseArms,
            enumDefaultArm,
            enumLocalTypes,
            enumNoOverrides,
            false,
            0,
            MirType.I64,
            (u32[0 max])signatureParamCount,
            enumEntryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            ignoredHasDeclaredReturnType,
            ignoredDeclaredReturnType,
            true,
            enumReturnOwnerDeclarationIndex,
            false,
            body);
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack mut ExprParseResult scrutinee = new();
    stack mut IrTable<i64[min max]> caseValues = new();
    stack mut IrTable<i64[min max]> caseMaxValues = new();
    stack mut IrTable<ExprParseResult> caseArms = new();
    stack mut ExprParseResult defaultArm = new();
    stack mut u64[0 2 ** 63 - 1] nextToken = 0;
    if (!TryParseTerminalIntegerSwitchReturnCases(
        stream,
        source,
        nodes,
        params,
        funcNames,
        (u64[0 2 ** 63 - 1])braceIndex + 1,
        scrutinee,
        caseValues,
        caseMaxValues,
        caseArms,
        defaultArm,
        nextToken))
    {
        return false;
    }

    if (stream.KindAt(nextToken) != TokenKind.RBrace)
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCalls(nodes, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    return LowerTerminalIntegerSwitchCasesToBlocks(
        nodes,
        scrutinee.NodeId,
        caseValues,
        caseMaxValues,
        caseArms,
        defaultArm,
        localTypes,
        noOverrides,
        false,
        0,
        MirType.I64,
        (u32[0 max])signatureParamCount,
        entryFirst,
        instrs,
        blocks,
        ranges,
        recordRanges,
        hasDeclaredReturnType,
        declaredReturnType,
        false,
        0,
        false,
        body);
}

