internal fn bool TryParseFixedArrayFieldListSwitchAssignmentCases(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] switchIndex,
    borrow IrTable<u32[0 max]> targetNameTokens,
    u64[0 2 ** 63 - 1] signatureParamCount,
    out ExprParseResult scrutinee,
    out FixedArrayStorageLocal fixedArrayLocal,
    out u32[0 max] fixedArrayParamIndex,
    out ParamAbiFacts fixedArrayFacts,
    mut borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    mut borrow IrTable<u32[0 max]> casePatternStarts,
    mut borrow IrTable<u32[0 max]> casePatternCounts,
    mut borrow IrTable<u32[0 max]> caseGuardNodes,
    mut borrow IrTable<u32[0 max]> elementPatternIndices,
    mut borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    mut borrow IrTable<u32[0 max]> elementPatternKinds,
    mut borrow IrTable<i64[min max]> elementPatternMinValues,
    mut borrow IrTable<i64[min max]> elementPatternMaxValues,
    mut borrow IrTable<u32[0 max]> caseElementCaptureStarts,
    mut borrow IrTable<u32[0 max]> caseElementCaptureCounts,
    mut borrow IrTable<u32[0 max]> elementCaptureIndices,
    mut borrow IrTable<u32[0 max]> elementCaptureTypeCodes,
    mut borrow IrTable<u32[0 max]> elementCaptureNameTokens,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<u32[0 max]> assignedRoots,
    mut borrow IrTable<u32[0 max]> assignedTargetOffsets,
    out ParsedSwitchAssignmentArm defaultArm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap(constructedObjectLocals, source)
{
    scrutinee = new();
    fixedArrayLocal = new();
    fixedArrayParamIndex = 0;
    fixedArrayFacts = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] closeParen = MatchingParenForMirLowering(stream, (u32[0 max])(switchIndex + 1));
    stack mut ExprParseResult resolvedScrutinee = new();
    stack mut FixedArrayStorageLocal resolvedFixedArrayLocal = new();
    stack mut ParamAbiFacts resolvedFixedArrayFacts = new();
    if (closeParen == (u32[0 max])(switchIndex + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace
        || !TryResolveFixedArrayFieldSwitchScrutineeFacts(
            stream,
            source,
            moduleFacts,
            constructedObjectLocals,
            nodes,
            switchIndex + 2,
            (u64[0 2 ** 63 - 1])closeParen,
            resolvedScrutinee,
            resolvedFixedArrayLocal,
            resolvedFixedArrayFacts))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] switchBodyOpen = (u64[0 2 ** 63 - 1])closeParen + 1;
    stack u32[0 max] switchBodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])switchBodyOpen);
    if (switchBodyClose == (u32[0 max])switchBodyOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = switchBodyOpen + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Case)
    {
        stack mut IrTable<u32[0 max]> siblingPatternStarts = new();
        stack mut IrTable<u32[0 max]> siblingPatternCounts = new();
        stack mut IrTable<u32[0 max]> siblingElementCaptureStarts = new();
        stack mut IrTable<u32[0 max]> siblingElementCaptureCounts = new();
        stack mut u32[0 max] firstCaptureStart = 0;
        stack mut u32[0 max] firstCaptureCount = 0;
        stack mut u32[0 max] siblingLabelCount = 0;
        stack mut u64[0 2 ** 63 - 1] afterCaseLabel = cursor + 1;

        while willexit (true)
        {
            stack mut u32[0 max] patternStart = 0;
            stack mut u32[0 max] patternCount = 0;
            stack mut u32[0 max] captureStart = 0;
            stack mut u32[0 max] captureCount = 0;
            if (!TryParseTerminalSwitchFixedArrayListCaseLabelWithTypedRowsAndCaptures(
                    stream,
                    source,
                    moduleFacts,
                    resolvedFixedArrayFacts,
                    afterCaseLabel,
                    elementPatternIndices,
                    elementPatternTypeCodes,
                    elementPatternKinds,
                    elementPatternMinValues,
                    elementPatternMaxValues,
                    elementCaptureIndices,
                    elementCaptureTypeCodes,
                    elementCaptureNameTokens,
                    patternStart,
                    patternCount,
                    captureStart,
                    captureCount,
                    afterCaseLabel))
            {
                return false;
            }

            if (siblingLabelCount == 0)
            {
                firstCaptureStart = captureStart;
                firstCaptureCount = captureCount;
            }
            else if (!SourceSwitchCaptureSignaturesMatch(
                    stream,
                    source,
                    elementCaptureNameTokens,
                    elementCaptureTypeCodes,
                    firstCaptureStart,
                    firstCaptureCount,
                    captureStart,
                    captureCount))
            {
                return false;
            }

            if (siblingPatternStarts.Add(patternStart) == 0
                || siblingPatternCounts.Add(patternCount) == 0
                || siblingElementCaptureStarts.Add(captureStart) == 0
                || siblingElementCaptureCounts.Add(captureCount) == 0)
            {
                return false;
            }

            siblingLabelCount = siblingLabelCount + 1;
            if (stream.KindAt(afterCaseLabel) != TokenKind.Or)
            {
                break;
            }

            afterCaseLabel = afterCaseLabel + 1;
        }

        stack mut u32[0 max] guardNode = 0;
        stack mut u64[0 2 ** 63 - 1] colonToken = afterCaseLabel;
        if (stream.KindAt(afterCaseLabel) == TokenKind.When)
        {
            stack mut ExprParseResult parsedGuard = new();
            if (firstCaptureCount != 0)
            {
                if (!TryParseSwitchGuardWithCaptures(
                        stream,
                        source,
                        nodes,
                        params,
                        signatureParamCount,
                        funcNames,
                        elementCaptureNameTokens,
                        elementCaptureTypeCodes,
                        firstCaptureStart,
                        firstCaptureCount,
                        afterCaseLabel + 1,
                        parsedGuard,
                        colonToken))
                {
                    return false;
                }
            }
            else
            {
                stack u64[0 2 ** 63 - 1] beforeGuardParamCount = params.Count();
                parsedGuard = ParseExprIn(stream, source, nodes, params, funcNames, afterCaseLabel + 1);
                if (parsedGuard.NodeId == 0
                    || parsedGuard.Next == afterCaseLabel + 1
                    || params.Count() != beforeGuardParamCount)
                {
                    return false;
                }

                colonToken = parsedGuard.Next;
            }

            guardNode = parsedGuard.NodeId;
        }

        if (stream.KindAt(colonToken) != TokenKind.Colon)
        {
            return false;
        }

        stack mut ParsedSwitchAssignmentArm caseArm = new();
        stack mut u64[0 2 ** 63 - 1] afterCase = colonToken + 1;
        if (!TryParseSwitchAssignmentArmWithCaptures(
            stream,
            source,
            nodes,
            params,
            signatureParamCount,
            funcNames,
            targetNameTokens,
            elementCaptureNameTokens,
            elementCaptureTypeCodes,
            firstCaptureStart,
            firstCaptureCount,
            colonToken + 1,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            caseArm,
            afterCase))
        {
            return false;
        }

        stack mut u32[0 max] siblingOffset = 0;
        while willexit (siblingOffset < siblingLabelCount)
        {
            stack u32[0 max] patternStart = siblingPatternStarts.Get(siblingOffset + 1);
            stack u32[0 max] patternCount = siblingPatternCounts.Get(siblingOffset + 1);
            stack u32[0 max] captureStart = siblingElementCaptureStarts.Get(siblingOffset + 1);
            stack u32[0 max] captureCount = siblingElementCaptureCounts.Get(siblingOffset + 1);
            stack mut ParsedSwitchAssignmentArm siblingArm = caseArm;
            siblingArm.CaptureStart = captureStart;
            siblingArm.CaptureCount = captureCount;
            if (SourceSwitchListPatternCaseOverlapsPreviousUnguardedCase(
                    nodes,
                    casePatternStarts,
                    casePatternCounts,
                    caseGuardNodes,
                    elementPatternIndices,
                    elementPatternTypeCodes,
                    elementPatternKinds,
                    elementPatternMinValues,
                    elementPatternMaxValues,
                    patternStart,
                    patternCount)
                || caseArms.Add(siblingArm) == 0
                || casePatternStarts.Add(patternStart) == 0
                || casePatternCounts.Add(patternCount) == 0
                || caseGuardNodes.Add(guardNode) == 0
                || caseElementCaptureStarts.Add(captureStart) == 0
                || caseElementCaptureCounts.Add(captureCount) == 0)
            {
                return false;
            }

            siblingOffset = siblingOffset + 1;
        }

        cursor = afterCase;
    }

    if (caseArms.Count() == 0)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ParsedSwitchAssignmentArm parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseSwitchAssignmentArm(
        stream,
        source,
        nodes,
        params,
        signatureParamCount,
        funcNames,
        targetNameTokens,
        cursor + 2,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        parsedDefault,
        afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = resolvedScrutinee;
    fixedArrayLocal = resolvedFixedArrayLocal;
    fixedArrayParamIndex = resolvedFixedArrayLocal.ParamIndex;
    fixedArrayFacts = resolvedFixedArrayFacts;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}

internal fn bool TryParseEnumSwitchAssignmentCases(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] switchIndex,
    borrow IrTable<u32[0 max]> targetNameTokens,
    u64[0 2 ** 63 - 1] signatureParamCount,
    out ExprParseResult scrutinee,
    mut borrow IrTable<i64[min max]> caseValues,
    mut borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    mut borrow IrTable<u32[0 max]> armLocalRoots,
    mut borrow IrTable<u32[0 max]> assignedRoots,
    mut borrow IrTable<u32[0 max]> assignedTargetOffsets,
    out ParsedSwitchAssignmentArm defaultArm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    scrutinee = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack ExprParseResult parsedScrutinee = ParseExprIn(stream, source, nodes, params, funcNames, switchIndex + 2);
    if (stream.KindAt(parsedScrutinee.Next) != TokenKind.RParen
        || stream.KindAt(parsedScrutinee.Next + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] switchBodyOpen = parsedScrutinee.Next + 1;
    stack u32[0 max] switchBodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])switchBodyOpen);
    if (switchBodyClose == (u32[0 max])switchBodyOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = switchBodyOpen + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Case)
    {
        stack mut i64[min max] caseValue = 0;
        stack mut u64[0 2 ** 63 - 1] afterCaseLabel = cursor + 1;
        if (!TryParseTerminalSwitchEnumCaseLabel(stream, source, moduleFacts, ownerDeclarationIndex, cursor + 1, caseValue, afterCaseLabel)
            || stream.KindAt(afterCaseLabel) != TokenKind.Colon
            || TerminalSwitchCaseValueExists(caseValues, caseValue))
        {
            return false;
        }

        stack mut ParsedSwitchAssignmentArm caseArm = new();
        stack mut u64[0 2 ** 63 - 1] afterCase = afterCaseLabel + 1;
        if (!TryParseSwitchAssignmentArm(
            stream,
            source,
            nodes,
            params,
            signatureParamCount,
            funcNames,
            targetNameTokens,
            afterCaseLabel + 1,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            caseArm,
            afterCase))
        {
            return false;
        }

        if (caseValues.Add(caseValue) == 0 || caseArms.Add(caseArm) == 0)
        {
            return false;
        }

        cursor = afterCase;
    }

    if (caseValues.Count() == 0)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ParsedSwitchAssignmentArm parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseSwitchAssignmentArm(
        stream,
        source,
        nodes,
        params,
        signatureParamCount,
        funcNames,
        targetNameTokens,
        cursor + 2,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        parsedDefault,
        afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = parsedScrutinee;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}

