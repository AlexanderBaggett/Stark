            }

            if (caseValues.Add(caseValue) == 0
                || casePayloadPatternStarts.Add(payloadPatternStart) == 0
                || casePayloadPatternCounts.Add(payloadPatternCount) == 0
                || casePayloadNestedStarts.Add(nestedStart) == 0
                || casePayloadNestedCounts.Add(nestedCount) == 0
                || siblingPayloadCaptureStarts.Add(payloadCaptureStart) == 0
                || siblingPayloadCaptureCounts.Add(payloadCaptureCount) == 0)
