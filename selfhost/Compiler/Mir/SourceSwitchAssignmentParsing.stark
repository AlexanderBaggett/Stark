    mut borrow IrTable<u32[0 max]> casePayloadNestedCounts,
    mut borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    mut borrow IrTable<u32[0 max]> payloadPatternOrdinals,
    mut borrow IrTable<u32[0 max]> payloadPatternTypeCodes,
    mut borrow IrTable<u32[0 max]> payloadPatternKinds,
    mut borrow IrTable<i64[min max]> payloadPatternMinValues,
    mut borrow IrTable<i64[min max]> payloadPatternMaxValues,
    mut borrow IrTable<u32[0 max]> payloadCaptureVariantOrdinals,
    mut borrow IrTable<u32[0 max]> payloadCaptureOrdinals,
    mut borrow IrTable<u32[0 max]> payloadCaptureTypeCodes,
