internal fn bool TryParseStructAggregateSwitchAssignmentCases(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] switchIndex,
    borrow IrTable<u32[0 max]> targetNameTokens,
    u64[0 2 ** 63 - 1] signatureParamCount,
    out ExprParseResult scrutinee,
    out u32[0 max] structParamIndex,
    out u32[0 max] structTypeToken,
    out u32[0 max] structBaseByteOffset,
    out bool useStructValueParam,
    out ParamAbiFacts structValueFacts,
    mut borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    mut borrow IrTable<u32[0 max]> casePatternStarts,
    mut borrow IrTable<u32[0 max]> casePatternCounts,
    mut borrow IrTable<u32[0 max]> caseFieldCaptureStarts,
    mut borrow IrTable<u32[0 max]> caseFieldCaptureCounts,
    mut borrow IrTable<u32[0 max]> caseNestedStarts,
    mut borrow IrTable<u32[0 max]> caseNestedCounts,
    mut borrow IrTable<u32[0 max]> caseGuardNodes,
    mut borrow IrTable<u32[0 max]> fieldPatternIndices,
    mut borrow IrTable<u32[0 max]> fieldPatternOffsets,
    mut borrow IrTable<u32[0 max]> fieldPatternAlignments,
    mut borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    mut borrow IrTable<u32[0 max]> fieldPatternMemberFactRows,
    mut borrow IrTable<u32[0 max]> fieldPatternKinds,
    mut borrow IrTable<i64[min max]> fieldPatternMinValues,
    mut borrow IrTable<i64[min max]> fieldPatternMaxValues,
    mut borrow IrTable<u32[0 max]> fieldCaptureIndices,
    mut borrow IrTable<u32[0 max]> fieldCaptureOffsets,
    mut borrow IrTable<u32[0 max]> fieldCaptureAlignments,
    mut borrow IrTable<u32[0 max]> fieldCaptureTypeCodes,
    mut borrow IrTable<u32[0 max]> fieldCaptureMemberFactRows,
    mut borrow IrTable<u32[0 max]> fieldCaptureNameTokens,
    mut borrow IrTable<u32[0 max]> armLocalRoots,

    mut borrow IrTable<u32[0 max]> assignedRoots,
    mut borrow IrTable<u32[0 max]> assignedTargetOffsets,
    out ParsedSwitchAssignmentArm defaultArm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap(constructedObjectLocals, source)
{
    scrutinee = new();
    structParamIndex = 0;
    structTypeToken = 0;
    structBaseByteOffset = 0;
    useStructValueParam = false;
    structValueFacts = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] closeParen = MatchingParenForMirLowering(stream, (u32[0 max])(switchIndex + 1));
    stack mut ExprParseResult resolvedScrutinee = new();
    stack mut u32[0 max] resolvedStructParamIndex = 0;
    stack mut u32[0 max] resolvedStructTypeToken = 0;
    stack mut u32[0 max] resolvedStructBaseByteOffset = 0;
    stack mut bool resolvedUseStructValueParam = false;
    stack mut ParamAbiFacts resolvedStructValueFacts = new();
    if (closeParen == (u32[0 max])(switchIndex + 1)
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.LBrace
        || !TryResolveStructAggregateSwitchScrutineeFacts(
            stream,
            source,
            moduleFacts,
            constructedObjectLocals,
            nodes,
            params,
            paramAbiFacts,
            switchIndex + 2,
            (u64[0 2 ** 63 - 1])closeParen,
            resolvedScrutinee,
            resolvedStructParamIndex,
            resolvedStructTypeToken,
            resolvedStructBaseByteOffset,
            resolvedUseStructValueParam,
            resolvedStructValueFacts))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] switchBodyOpen = (u64[0 2 ** 63 - 1])closeParen + 1;
    stack u32[0 max] switchBodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])switchBodyOpen);
    if (switchBodyClose == (u32[0 max])switchBodyOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = switchBodyOpen + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Case)
    {
        stack mut IrTable<u32[0 max]> siblingPatternStarts = new();
        stack mut IrTable<u32[0 max]> siblingPatternCounts = new();
        stack mut IrTable<u32[0 max]> siblingFieldCaptureStarts = new();
        stack mut IrTable<u32[0 max]> siblingFieldCaptureCounts = new();
        stack mut IrTable<u32[0 max]> siblingNestedStarts = new();
        stack mut IrTable<u32[0 max]> siblingNestedCounts = new();
        stack mut u32[0 max] firstCaptureStart = 0;
        stack mut u32[0 max] firstCaptureCount = 0;
        stack mut u32[0 max] siblingLabelCount = 0;
        stack mut u64[0 2 ** 63 - 1] afterCaseLabel = cursor + 1;

        while willexit (true)
        {
            stack mut u32[0 max] patternStart = 0;
            stack mut u32[0 max] patternCount = 0;
            stack mut u32[0 max] captureStart = 0;
            stack mut u32[0 max] captureCount = 0;
            stack mut u32[0 max] nestedStart = 0;
            stack mut u32[0 max] nestedCount = 0;
            if (!TryParseTerminalSwitchStructAggregateCaseLabel(
                    stream,
                    source,
                    moduleFacts,
                    resolvedStructTypeToken,
                    afterCaseLabel,
                    fieldPatternIndices,
                    fieldPatternOffsets,
                    fieldPatternAlignments,
                    fieldPatternTypeCodes,
                    fieldPatternMemberFactRows,
                    fieldPatternKinds,
                    fieldPatternMinValues,
                    fieldPatternMaxValues,
                    fieldCaptureIndices,
                    fieldCaptureOffsets,
                    fieldCaptureAlignments,
                    fieldCaptureTypeCodes,
                    fieldCaptureMemberFactRows,
                    fieldCaptureNameTokens,
                    patternStart,
                    patternCount,
                    captureStart,
                    captureCount,
                    nestedStart,
                    nestedCount,
                    afterCaseLabel))
            {
                return false;
            }

            if (siblingLabelCount == 0)
            {
                firstCaptureStart = captureStart;
                firstCaptureCount = captureCount;
            }
            else if (!SourceSwitchCaptureSignaturesMatch(
                    stream,
                    source,
                    fieldCaptureNameTokens,
                    fieldCaptureTypeCodes,
                    firstCaptureStart,
                    firstCaptureCount,
                    captureStart,
                    captureCount))
            {
                return false;
            }

            if (siblingPatternStarts.Add(patternStart) == 0
                || siblingPatternCounts.Add(patternCount) == 0
                || siblingFieldCaptureStarts.Add(captureStart) == 0
                || siblingFieldCaptureCounts.Add(captureCount) == 0
                || siblingNestedStarts.Add(nestedStart) == 0
                || siblingNestedCounts.Add(nestedCount) == 0)
            {
                return false;
            }

            siblingLabelCount = siblingLabelCount + 1;
            if (stream.KindAt(afterCaseLabel) != TokenKind.Or)
            {
                break;
            }

            afterCaseLabel = afterCaseLabel + 1;
        }

        stack mut u32[0 max] guardNode = 0;
        stack mut u64[0 2 ** 63 - 1] colonToken = afterCaseLabel;
        if (stream.KindAt(afterCaseLabel) == TokenKind.When)
        {
            stack mut ExprParseResult parsedGuard = new();
            if (firstCaptureCount != 0)
            {
                if (!TryParseSwitchGuardWithCaptures(
                        stream,
                        source,
                        nodes,
                        params,
                        signatureParamCount,
                        funcNames,
                        fieldCaptureNameTokens,
                        fieldCaptureTypeCodes,
                        firstCaptureStart,
                        firstCaptureCount,
                        afterCaseLabel + 1,
                        parsedGuard,
                        colonToken))
                {
                    return false;
                }
            }
            else
            {
                stack u64[0 2 ** 63 - 1] beforeGuardParamCount = params.Count();
                parsedGuard = ParseExprIn(stream, source, nodes, params, funcNames, afterCaseLabel + 1);
                if (parsedGuard.NodeId == 0
                    || parsedGuard.Next == afterCaseLabel + 1
                    || params.Count() != beforeGuardParamCount)
                {
                    return false;
                }

                colonToken = parsedGuard.Next;
            }

            guardNode = parsedGuard.NodeId;
        }

        if (stream.KindAt(colonToken) != TokenKind.Colon)
        {
            return false;
        }

        stack mut ParsedSwitchAssignmentArm caseArm = new();
        stack mut u64[0 2 ** 63 - 1] afterCase = colonToken + 1;
        if (!TryParseSwitchAssignmentArmWithCaptures(
            stream,
            source,
            nodes,
            params,
            signatureParamCount,
            funcNames,
            targetNameTokens,
            fieldCaptureNameTokens,
            fieldCaptureTypeCodes,
            firstCaptureStart,
            firstCaptureCount,
            colonToken + 1,
            armLocalRoots,
            assignedRoots,
            assignedTargetOffsets,
            caseArm,
            afterCase))
        {
            return false;
        }

        stack mut u32[0 max] siblingOffset = 0;
        while willexit (siblingOffset < siblingLabelCount)
        {
            stack u32[0 max] patternStart = siblingPatternStarts.Get(siblingOffset + 1);
            stack u32[0 max] patternCount = siblingPatternCounts.Get(siblingOffset + 1);
            stack u32[0 max] captureStart = siblingFieldCaptureStarts.Get(siblingOffset + 1);
            stack u32[0 max] captureCount = siblingFieldCaptureCounts.Get(siblingOffset + 1);
            stack u32[0 max] nestedStart = siblingNestedStarts.Get(siblingOffset + 1);
            stack u32[0 max] nestedCount = siblingNestedCounts.Get(siblingOffset + 1);
            stack mut ParsedSwitchAssignmentArm siblingArm = caseArm;
            siblingArm.CaptureStart = captureStart;
            siblingArm.CaptureCount = captureCount;
            if ((SourceSwitchStructPatternCanUseFlatOverlapPreflight(caseNestedCounts, nestedCount)
                    && SourceSwitchStructPatternCaseOverlapsPreviousUnguardedCase(
                        nodes,
                        casePatternStarts,
                        casePatternCounts,
                        caseGuardNodes,
                        fieldPatternIndices,
                        fieldPatternTypeCodes,
                        fieldPatternKinds,
                        fieldPatternMinValues,
                        fieldPatternMaxValues,
                        patternStart,
                        patternCount))
                || caseArms.Add(siblingArm) == 0
                || casePatternStarts.Add(patternStart) == 0
                || casePatternCounts.Add(patternCount) == 0
                || caseFieldCaptureStarts.Add(captureStart) == 0
                || caseFieldCaptureCounts.Add(captureCount) == 0
                || caseNestedStarts.Add(nestedStart) == 0
                || caseNestedCounts.Add(nestedCount) == 0
                || caseGuardNodes.Add(guardNode) == 0)
            {
                return false;
            }

            siblingOffset = siblingOffset + 1;
        }

        cursor = afterCase;
    }

    if (caseArms.Count() == 0)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ParsedSwitchAssignmentArm parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseSwitchAssignmentArm(
        stream,
        source,
        nodes,
        params,
        signatureParamCount,
        funcNames,
        targetNameTokens,
        cursor + 2,
        armLocalRoots,
        assignedRoots,
        assignedTargetOffsets,
        parsedDefault,
        afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = resolvedScrutinee;
    structParamIndex = resolvedStructParamIndex;
    structTypeToken = resolvedStructTypeToken;
    structBaseByteOffset = resolvedStructBaseByteOffset;
    useStructValueParam = resolvedUseStructValueParam;
    structValueFacts = resolvedStructValueFacts;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}
