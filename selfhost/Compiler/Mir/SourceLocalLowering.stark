module Compiler.Mir.SourceLocalLowering

internal finite law u32[0 max] MatchingBraceForMirLowering(borrow TokenStream stream, u32[0 max] open)
{
    stack mut u32[0 max] index = open;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return open;
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return index;
                }
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return open;
}

// Detects whether the source stream uses arena-backed runtime storage.
internal fn bool TokenStreamMentionsArenaRuntime(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Arena)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

// Detects whether the source stream uses heap-backed runtime storage.
internal fn bool TokenStreamMentionsHeapRuntime(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Heap)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TokenTextIsReserveName(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 7)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    return source[start] == 82
        && source[start + 1] == 101
        && source[start + 2] == 115
        && source[start + 3] == 101
        && source[start + 4] == 114
        && source[start + 5] == 118
        && source[start + 6] == 101;
}

internal fn bool TokenTextIsTryReserveName(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 10)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    return source[start] == 84
        && source[start + 1] == 114
        && source[start + 2] == 121
        && source[start + 3] == 82
        && source[start + 4] == 101
        && source[start + 5] == 115
        && source[start + 6] == 101
        && source[start + 7] == 114
        && source[start + 8] == 118
        && source[start + 9] == 101;
}

internal fn bool TokenTextIsTryReserveCapacityName(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 18)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    return source[start] == 84
        && source[start + 1] == 114
        && source[start + 2] == 121
        && source[start + 3] == 82
        && source[start + 4] == 101
        && source[start + 5] == 115
        && source[start + 6] == 101
        && source[start + 7] == 114
        && source[start + 8] == 118
        && source[start + 9] == 101
        && source[start + 10] == 67
        && source[start + 11] == 97
        && source[start + 12] == 112
        && source[start + 13] == 97
        && source[start + 14] == 99
        && source[start + 15] == 105
        && source[start + 16] == 116
        && source[start + 17] == 121;
}

internal fn bool TokenTextIsArenaDynamicReserveMethod(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    return TokenTextIsReserveName(stream, source, token)
        || TokenTextIsTryReserveName(stream, source, token)
        || TokenTextIsTryReserveCapacityName(stream, source, token);
}

internal fn u32[0 max] SourceLocalFloatTypeTokenBitWidth(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 3)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    if (source[start] != 102)
    {
        return 0;
    }

    if (source[start + 1] == 51 && source[start + 2] == 50)
    {
        return 32;
    }

    if (source[start + 1] == 54 && source[start + 2] == 52)
    {
        return 64;
    }

    return 0;
}

internal fn bool TokenStreamMentionsArenaDynamicRuntime(borrow TokenStream stream, borrow i8[min max][] source)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut bool sawArena = false;
    stack mut bool sawDynamicReserve = false;
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack TokenKind kind = stream.KindAt(i);
        if (kind == TokenKind.Arena)
        {
            sawArena = true;
        }
        else if (kind == TokenKind.Identifier && TokenTextIsArenaDynamicReserveMethod(stream, source, (u32[0 max])i))
        {
            sawDynamicReserve = true;
        }

        i = i + 1;
    }

    return sawArena && sawDynamicReserve;
}

internal fn bool TokenStartsSelfHostedLocal(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Var:
            return true;
        case TokenKind.Stack:
            return true;
        case TokenKind.Register:
            return true;
        case TokenKind.Heap:
            return true;
        case TokenKind.Arena:
            return true;
        case TokenKind.Static:
            return true;
        default:
            return false;
    }
}

internal fn bool TokenCanStartSelfHostedType(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.IntegerType:
            return true;
        case TokenKind.Bool:
            return true;
        case TokenKind.Identifier:
            return true;
        case TokenKind.Dynamic:
            return true;
        case TokenKind.Dyn:
            return true;
        case TokenKind.Rawptr:
            return true;
        case TokenKind.Rawmutptr:
            return true;
        case TokenKind.Fnptr:
            return true;
        case TokenKind.AsciiView:
            return true;
        case TokenKind.UnicodeView:
            return true;
        case TokenKind.AsciiOwned:
            return true;
        case TokenKind.UnicodeOwned:
            return true;
        default:
            return false;
    }
}

internal fn u32[0 max] NaturalAlignmentForByteExtent(u32[0 max] sizeBytes)
{
    if (sizeBytes >= 8)
    {
        return 8;
    }

    if (sizeBytes >= 4)
    {
        return 4;
    }

    if (sizeBytes >= 2)
    {
        return 2;
    }

    return 1;
}

internal fn u32[0 max] MatchingBracketForMirLowering(borrow TokenStream stream, u32[0 max] open)
{
    stack mut u32[0 max] index = open;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return open;
        }

        if (kind == TokenKind.LBrack)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return index;
                }
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return open;
}

internal fn u32[0 max] AlignUpU32(u32[0 max] value, u32[0 max] alignment)
{
    if (alignment <= 1)
    {
        return value;
    }

    stack u32[0 max] remainder = value % alignment;
    if (remainder == 0)
    {
        return value;
    }

    return value + alignment - remainder;
}

internal fn bool IsPowerOfTwoU32(u32[0 max] value)
{
    if (value == 0)
    {
        return false;
    }

    stack mut u32[0 max] remaining = value;
    while willexit (remaining > 1)
    {
        if (remaining % 2 != 0)
        {
            return false;
        }

        remaining = remaining / 2;
    }

    return true;
}

internal fn bool FindSelfHostedStatementEnd(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] limit, out u64[0 2 ** 63 - 1] end)
{
    end = start;
    stack mut u64[0 2 ** 63 - 1] scan = start;
    stack mut u32[0 max] parenDepth = 0;
    stack mut u32[0 max] bracketDepth = 0;
    while willexit (scan < limit && stream.KindAt(scan) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.LParen)
        {
            parenDepth = parenDepth + 1;
        }
        else if (kind == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = parenDepth - 1;
            }
        }
        else if (kind == TokenKind.LBrack)
        {
            bracketDepth = bracketDepth + 1;
        }
        else if (kind == TokenKind.RBrack)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = bracketDepth - 1;
            }
        }
        else if (kind == TokenKind.Semi && parenDepth == 0 && bracketDepth == 0)
        {
            end = scan;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool FindSelfHostedStatementAssign(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end, out u64[0 2 ** 63 - 1] assign)
{
    assign = end;
    stack mut u64[0 2 ** 63 - 1] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (kind == TokenKind.Assign && depth == 0)
        {
            assign = scan;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn u32[0 max] FindSelfHostedLocalNameToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack mut u32[0 max] nameToken = 0;
    stack mut u64[0 2 ** 63 - 1] scan = start + 1;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (depth == 0 && kind == TokenKind.Assign)
        {
            break;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0)
        {
            nameToken = (u32[0 max])scan;
        }

        scan = scan + 1;
    }

    return nameToken;
}

internal fn u32[0 max] FindSelfHostedLocalTypeToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack u32[0 max] nameToken = FindSelfHostedLocalNameToken(stream, start, end);
    stack mut u64[0 2 ** 63 - 1] scan = start + 1;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        if (nameToken != 0 && scan >= (u64[0 2 ** 63 - 1])nameToken)
        {
            break;
        }

        stack TokenKind kind = stream.KindAt(scan);
        if (depth == 0 && kind == TokenKind.Assign)
        {
            break;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (depth == 0 && kind != TokenKind.Mut && TokenCanStartSelfHostedType(kind))
        {
            return (u32[0 max])scan;
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn bool SelfHostedLocalDeclarationHasMut(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack u32[0 max] nameToken = FindSelfHostedLocalNameToken(stream, start, end);
    stack mut u64[0 2 ** 63 - 1] scan = start + 1;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        if (nameToken != 0 && scan >= (u64[0 2 ** 63 - 1])nameToken)
        {
            return false;
        }

        stack TokenKind kind = stream.KindAt(scan);
        if (depth == 0 && kind == TokenKind.Assign)
        {
            return false;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (depth == 0 && kind == TokenKind.Mut)
        {
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn u32[0 max] ScalarTypeKnownByteExtent(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    if (kind == TokenKind.Bool)
    {
        return 1;
    }

    if (kind == TokenKind.IntegerType)
    {
        stack u32[0 max] bits = IntegerTypeBitWidth(stream, source, typeToken);
        return (u32[0 max])((bits + 7) / 8);
    }

    return 0;
}

internal fn bool TryReadFixedArrayLengthSuffix(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken, out u32[0 max] length)
{
    length = 0;
    stack mut u64[0 2 ** 63 - 1] scan = (u64[0 2 ** 63 - 1])typeToken + 1;
    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.IntegerType
        && stream.KindAt(scan) == TokenKind.LBrack)
    {
        stack u32[0 max] rangeClose = MatchingBracketForMirLowering(stream, (u32[0 max])scan);
        if (rangeClose == (u32[0 max])scan)
        {
            return false;
        }

        scan = (u64[0 2 ** 63 - 1])rangeClose + 1;
    }

    if (stream.KindAt(scan) != TokenKind.LBrack
        || stream.KindAt(scan + 1) != TokenKind.IntegerLiteral
        || stream.KindAt(scan + 2) != TokenKind.RBrack)
    {
        return false;
    }

    return TryReadPositiveIntegerToken(stream, source, scan + 1, length);
}

internal fn bool TryReadFixedArrayLengthSuffixAtDepth(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u32[0 max] depth,
    out u32[0 max] length)
{
    length = 0;
    stack mut u64[0 2 ** 63 - 1] scan = (u64[0 2 ** 63 - 1])typeToken + 1;
    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.IntegerType
        && stream.KindAt(scan) == TokenKind.LBrack)
    {
        stack u32[0 max] rangeClose = MatchingBracketForMirLowering(stream, (u32[0 max])scan);
        if (rangeClose == (u32[0 max])scan)
        {
            return false;
        }

        scan = (u64[0 2 ** 63 - 1])rangeClose + 1;
    }

    stack mut u32[0 max] currentDepth = 0;
    while willexit (currentDepth <= depth)
    {
        if (stream.KindAt(scan) != TokenKind.LBrack
            || stream.KindAt(scan + 1) != TokenKind.IntegerLiteral
            || stream.KindAt(scan + 2) != TokenKind.RBrack)
        {
            return false;
        }

        if (currentDepth == depth)
        {
            return TryReadPositiveIntegerToken(stream, source, scan + 1, length);
        }

        scan = scan + 3;
        currentDepth = currentDepth + 1;
    }

    return false;
}

internal fn bool TryResolveScalarFixedArraySuffixLayoutAtDepth(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u32[0 max] depth,
    out u32[0 max] arrayLength,
    out u32[0 max] elementSizeBytes,
    out u32[0 max] alignBytes,
    out MirType elementType,
    out u32[0 max] elementTypeCode)
{
    arrayLength = 0;
    elementSizeBytes = 0;
    alignBytes = 0;
    elementType = MirType.I64;
    elementTypeCode = SourceResolvedFieldTypeCodeInvalid();
    if (depth > 16
        || !TryReadFixedArrayLengthSuffixAtDepth(stream, source, typeToken, depth, arrayLength)
        || arrayLength == 0)
    {
        return false;
    }

    stack u32[0 max] scalarSize = ScalarTypeKnownByteExtent(stream, source, typeToken);
    stack mut MirType scalarType = MirType.I64;
    if (scalarSize == 0
        || !MirTypeForKnownSourceScalarTypeHead(stream, source, typeToken, scalarType))
    {
        return false;
    }

    stack u32[0 max] scalarTypeCode = SourceResolvedFieldTypeCodeForMirType(scalarType);
    if (scalarTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    stack mut u32[0 max] elementSize = scalarSize;
    if (depth == 4294967295)
    {
        return false;
    }

    stack mut u32[0 max] suffixDepth = depth + 1;
    stack mut u32[0 max] nestedArrayLength = 0;
    stack mut bool hasNestedArray = TryReadFixedArrayLengthSuffixAtDepth(
        stream,
        source,
        typeToken,
        suffixDepth,
        nestedArrayLength);
    while willexit (hasNestedArray)
    {
        if (nestedArrayLength == 0
            || elementSize > 4294967295 / nestedArrayLength)
        {
            return false;
        }

        elementSize = elementSize * nestedArrayLength;
        suffixDepth = suffixDepth + 1;
        if (suffixDepth > 16)
        {
            return false;
        }

        hasNestedArray = TryReadFixedArrayLengthSuffixAtDepth(
            stream,
            source,
            typeToken,
            suffixDepth,
            nestedArrayLength);
    }

    elementSizeBytes = elementSize;
    alignBytes = NaturalAlignmentForByteExtent(scalarSize);
    elementType = scalarType;
    elementTypeCode = scalarTypeCode;
    return true;
}

internal fn bool TryReadSliceSuffix(borrow TokenStream stream, u32[0 max] typeToken)
{
    stack mut u64[0 2 ** 63 - 1] scan = (u64[0 2 ** 63 - 1])typeToken + 1;
    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.IntegerType
        && stream.KindAt(scan) == TokenKind.LBrack)
    {
        stack u32[0 max] rangeClose = MatchingBracketForMirLowering(stream, (u32[0 max])scan);
        if (rangeClose == (u32[0 max])scan)
        {
            return false;
        }

        scan = (u64[0 2 ** 63 - 1])rangeClose + 1;
    }

    return stream.KindAt(scan) == TokenKind.LBrack
        && stream.KindAt(scan + 1) == TokenKind.RBrack;
}

internal fn u32[0 max] TypeKnownByteExtent(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u32[0 max] scalarSize = ScalarTypeKnownByteExtent(stream, source, typeToken);
    if (scalarSize == 0)
    {
        return 0;
    }

    stack mut u32[0 max] arrayLength = 0;
    if (!TryReadFixedArrayLengthSuffix(stream, source, typeToken, arrayLength))
    {
        return scalarSize;
    }

    stack mut u32[0 max] extent = scalarSize;
    stack mut u32[0 max] suffixDepth = 0;
    stack mut u32[0 max] suffixLength = arrayLength;
    stack mut bool hasSuffix = true;
    while willexit (hasSuffix)
    {
        if (suffixLength == 0
            || extent > 4294967295 / suffixLength)
        {
            return 0;
        }

        extent = extent * suffixLength;
        suffixDepth = suffixDepth + 1;
        if (suffixDepth > 16)
        {
            return 0;
        }

        hasSuffix = TryReadFixedArrayLengthSuffixAtDepth(
            stream,
            source,
            typeToken,
            suffixDepth,
            suffixLength);
    }

    return extent;
}

internal fn u32[0 max] BuiltinTypeKnownByteAlignment(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u32[0 max] scalarSize = ScalarTypeKnownByteExtent(stream, source, typeToken);
    if (scalarSize != 0)
    {
        return NaturalAlignmentForByteExtent(scalarSize);
    }

    return 0;
}

internal finite law bool TokenKindIsSelfHostedAggregateDeclaration(TokenKind kind)
{
    return kind == TokenKind.Struct || kind == TokenKind.Record;
}

internal fn u32[0 max] MatchingParenForMirLowering(borrow TokenStream stream, u32[0 max] open)
{
    stack mut u32[0 max] index = open;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return open;
        }

        if (kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return index;
                }
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return open;
}

internal fn u32[0 max] FindSelfHostedRecordHeaderOpenToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] declarationNameToken)
{
    stack mut u64[0 2 ** 63 - 1] scan = declarationNameToken + 1;
    stack mut u32[0 max] angleDepth = 0;
    while willexit (scan < stream.Count())
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.EndOfFile || kind == TokenKind.LBrace || kind == TokenKind.Semi)
        {
            return 0;
        }

        if (kind == TokenKind.LParen && angleDepth == 0)
        {
            return (u32[0 max])scan;
        }

        if (kind == TokenKind.Lt)
        {
            angleDepth = angleDepth + 1;
        }
        else if (kind == TokenKind.Gt)
        {
            if (angleDepth > 0)
            {
                angleDepth = angleDepth - 1;
            }
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn u64[0 2 ** 63 - 1] FindSelfHostedAggregateBodyFieldStart(borrow TokenStream stream, u64[0 2 ** 63 - 1] declarationNameToken)
{
    stack i64[min max] lbrace = FirstTokenOfKindAfter(stream, TokenKind.LBrace, declarationNameToken);
    if (lbrace < 0)
    {
        return stream.Count();
    }

    return (u64[0 2 ** 63 - 1])lbrace + 1;
}

internal fn bool TrySkipSelfHostedAggregateBodyMemberWithBody(
    borrow TokenStream stream,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] limit,
    out u64[0 2 ** 63 - 1] next)
{
    next = start;
    stack mut u64[0 2 ** 63 - 1] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < limit)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (depth == 0)
        {
            if (kind == TokenKind.Semi || kind == TokenKind.RBrace || kind == TokenKind.EndOfFile)
            {
                return false;
            }

            if (kind == TokenKind.LBrace)
            {
                stack u32[0 max] bodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])scan);
                if (bodyClose == (u32[0 max])scan)
                {
                    return false;
                }

                next = (u64[0 2 ** 63 - 1])bodyClose + 1;
                return true;
            }
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }

        scan = scan + 1;
    }

    return false;
}

internal fn u32[0 max] StructKnownByteAlignment(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] maxAlign = 1;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] align = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])segmentStart);
                            if (align == 0)
                            {
                                return 0;
                            }

                            if (align > maxAlign)
                            {
                                maxAlign = align;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u32[0 max] align = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])field);
                    if (align == 0)
                    {
                        return 0;
                    }

                    if (align > maxAlign)
                    {
                        maxAlign = align;
                    }

                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            return maxAlign;
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn u32[0 max] StructKnownByteExtent(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            stack mut u32[0 max] maxAlign = 1;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])segmentStart);
                            stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])segmentStart);
                            if (fieldSize == 0 || fieldAlign == 0)
                            {
                                return 0;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            offset = offset + fieldSize;
                            if (fieldAlign > maxAlign)
                            {
                                maxAlign = fieldAlign;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])field);
                    stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])field);
                    if (fieldSize == 0 || fieldAlign == 0)
                    {
                        return 0;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    offset = offset + fieldSize;
                    if (fieldAlign > maxAlign)
                    {
                        maxAlign = fieldAlign;
                    }

                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            return AlignUpU32(offset, maxAlign);
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn bool TryReadStructValueScalarFieldShape(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] fieldTypeToken,
    out MirType fieldType)
{
    fieldType = MirType.I64;
    stack mut u32[0 max] fixedArrayLength = 0;
    if (TryReadFixedArrayLengthSuffix(stream, source, fieldTypeToken, fixedArrayLength))
    {
        return false;
    }

    return MirTypeForKnownSourceScalarTypeHead(stream, source, fieldTypeToken, fieldType);
}

internal fn bool TryReadStructValueFlatScalarFieldSpan(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] fieldTypeToken,
    out u32[0 max] fieldCount,
    out u32[0 max] shapeCode)
{
    fieldCount = 0;
    shapeCode = 0;
    stack mut MirType fieldType = MirType.I64;
    if (TryReadStructValueScalarFieldShape(stream, source, fieldTypeToken, fieldType))
    {
        if (!StructValueShapeTypeIsSupported(fieldType))
        {
            return false;
        }

        fieldCount = 1;
        shapeCode = StructValueShapeTypeCode(fieldType);
        return true;
    }

    if (TryAppendStructValueShapeFixedArrayScalarFields(
            stream,
            source,
            fieldTypeToken,
            0,
            0,
            fieldCount,
            shapeCode))
    {
        return true;
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])fieldTypeToken) != TokenKind.Identifier)
    {
        return false;
    }

    return TryReadStructKnownLlvmScalarShape(stream, source, fieldTypeToken, fieldCount, shapeCode);
}

internal fn bool TryAppendStructValueShapeStorageCode(
    u32[0 max] fieldCount,
    u32[0 max] shapeCode,
    u32[0 max] storageCode,
    out u32[0 max] nextFieldCount,
    out u32[0 max] nextShapeCode)
{
    nextFieldCount = fieldCount;
    nextShapeCode = shapeCode;
    stack u32[0 max] multiplier = StructValueShapeMultiplierForIndex(fieldCount);
    if (multiplier == 0)
    {
        return false;
    }

    if (storageCode > 7)
    {
        return false;
    }

    nextShapeCode = shapeCode + storageCode * multiplier;
    nextFieldCount = fieldCount + 1;
    return true;
}

internal fn bool TryAppendStructValueShapeScalarType(
    MirType fieldType,
    u32[0 max] fieldCount,
    u32[0 max] shapeCode,
    out u32[0 max] nextFieldCount,
    out u32[0 max] nextShapeCode)
{
    nextFieldCount = fieldCount;
    nextShapeCode = shapeCode;
    if (!StructValueShapeTypeIsSupported(fieldType))
    {
        return false;
    }

    return TryAppendStructValueShapeStorageCode(
        fieldCount,
        shapeCode,
        StructValueShapeTypeCode(fieldType),
        nextFieldCount,
        nextShapeCode);
}

internal fn bool TryAppendStructValueShapeFixedArrayScalarFields(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] fieldTypeToken,
    u32[0 max] fieldCount,
    u32[0 max] shapeCode,
    out u32[0 max] nextFieldCount,
    out u32[0 max] nextShapeCode)
{
    nextFieldCount = fieldCount;
    nextShapeCode = shapeCode;
    stack mut u32[0 max] arrayLength = 0;
    stack mut MirType elementType = MirType.I64;
    if (!TryReadFixedArrayLengthSuffix(stream, source, fieldTypeToken, arrayLength)
        || arrayLength == 0
        || !MirTypeForKnownSourceScalarTypeHead(stream, source, fieldTypeToken, elementType)
        || !StructValueShapeTypeIsSupported(elementType))
    {
        return false;
    }

    stack mut u32[0 max] localFieldCount = fieldCount;
    stack mut u32[0 max] localShapeCode = shapeCode;
    stack mut u32[0 max] index = 0;
    while willexit (index < arrayLength)
    {
        stack mut u32[0 max] appendedFieldCount = 0;
        stack mut u32[0 max] appendedShapeCode = 0;
        if (!TryAppendStructValueShapeScalarType(
                elementType,
                localFieldCount,
                localShapeCode,
                appendedFieldCount,
                appendedShapeCode))
        {
            return false;
        }

        localFieldCount = appendedFieldCount;
        localShapeCode = appendedShapeCode;
        index = index + 1;
    }

    nextFieldCount = localFieldCount;
    nextShapeCode = localShapeCode;
    return true;
}

internal fn bool TryAppendStructValueShapeDirectScalarFields(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u32[0 max] fieldCount,
    u32[0 max] shapeCode,
    out u32[0 max] nextFieldCount,
    out u32[0 max] nextShapeCode)
{
    nextFieldCount = fieldCount;
    nextShapeCode = shapeCode;
    stack mut u32[0 max] localFieldCount = fieldCount;
    stack mut u32[0 max] localShapeCode = shapeCode;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack mut u32[0 max] appendedFieldCount = 0;
                            stack mut u32[0 max] appendedShapeCode = 0;
                            stack mut MirType fieldType = MirType.I64;
                            if (TryReadStructValueScalarFieldShape(stream, source, (u32[0 max])segmentStart, fieldType))
                            {
                                if (!TryAppendStructValueShapeScalarType(
                                        fieldType,
                                        localFieldCount,
                                        localShapeCode,
                                        appendedFieldCount,
                                        appendedShapeCode))
                                {
                                    return false;
                                }
                            }
                            else if (!TryAppendStructValueShapeFixedArrayScalarFields(
                                stream,
                                source,
                                (u32[0 max])segmentStart,
                                localFieldCount,
                                localShapeCode,
                                appendedFieldCount,
                                appendedShapeCode))
                            {
                                return false;
                            }

                            localFieldCount = appendedFieldCount;
                            localShapeCode = appendedShapeCode;
                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack mut u32[0 max] appendedFieldCount = 0;
                    stack mut u32[0 max] appendedShapeCode = 0;
                    stack mut MirType fieldType = MirType.I64;
                    if (TryReadStructValueScalarFieldShape(stream, source, (u32[0 max])field, fieldType))
                    {
                        if (!TryAppendStructValueShapeScalarType(
                                fieldType,
                                localFieldCount,
                                localShapeCode,
                                appendedFieldCount,
                                appendedShapeCode))
                        {
                            return false;
                        }
                    }
                    else if (!TryAppendStructValueShapeFixedArrayScalarFields(
                        stream,
                        source,
                        (u32[0 max])field,
                        localFieldCount,
                        localShapeCode,
                        appendedFieldCount,
                        appendedShapeCode))
                    {
                        return false;
                    }

                    localFieldCount = appendedFieldCount;
                    localShapeCode = appendedShapeCode;
                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            nextFieldCount = localFieldCount;
            nextShapeCode = localShapeCode;
            return nextFieldCount > fieldCount && nextFieldCount <= StructValueShapeMaxFields();
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryAppendStructValueShapeField(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] fieldTypeToken,
    u32[0 max] fieldCount,
    u32[0 max] shapeCode,
    out u32[0 max] nextFieldCount,
    out u32[0 max] nextShapeCode)
{
    nextFieldCount = fieldCount;
    nextShapeCode = shapeCode;
    stack mut MirType fieldType = MirType.I64;
    if (TryReadStructValueScalarFieldShape(stream, source, fieldTypeToken, fieldType))
    {
        return TryAppendStructValueShapeScalarType(fieldType, fieldCount, shapeCode, nextFieldCount, nextShapeCode);
    }

    if (TryAppendStructValueShapeFixedArrayScalarFields(
            stream,
            source,
            fieldTypeToken,
            fieldCount,
            shapeCode,
            nextFieldCount,
            nextShapeCode))
    {
        return true;
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])fieldTypeToken) != TokenKind.Identifier)
    {
        return false;
    }

    return TryAppendStructValueShapeDirectScalarFields(
        stream,
        source,
        fieldTypeToken,
        fieldCount,
        shapeCode,
        nextFieldCount,
        nextShapeCode);
}

internal fn bool TryReadStructKnownLlvmScalarShape(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    out u32[0 max] fieldCount,
    out u32[0 max] shapeCode)
{
    fieldCount = 0;
    shapeCode = 0;
    stack mut u32[0 max] localFieldCount = 0;
    stack mut u32[0 max] localShapeCode = 0;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack mut u32[0 max] nextFieldCount = 0;
                            stack mut u32[0 max] nextShapeCode = 0;
                            if (!TryAppendStructValueShapeField(stream, source, (u32[0 max])segmentStart, localFieldCount, localShapeCode, nextFieldCount, nextShapeCode))
                            {
                                return false;
                            }

                            localFieldCount = nextFieldCount;
                            localShapeCode = nextShapeCode;
                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack mut u32[0 max] nextFieldCount = 0;
                    stack mut u32[0 max] nextShapeCode = 0;
                    if (!TryAppendStructValueShapeField(stream, source, (u32[0 max])field, localFieldCount, localShapeCode, nextFieldCount, nextShapeCode))
                    {
                        return false;
                    }

                    localFieldCount = nextFieldCount;
                    localShapeCode = nextShapeCode;
                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            if (localFieldCount == 0 || localFieldCount > StructValueShapeMaxFields())
            {
                return false;
            }

            fieldCount = localFieldCount;
            shapeCode = localShapeCode;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn u32[0 max] TypeKnownByteAlignment(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u32[0 max] builtinSize = TypeKnownByteExtent(stream, source, typeToken);
    if (builtinSize != 0)
    {
        return NaturalAlignmentForByteExtent(builtinSize);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.Identifier)
    {
        return StructKnownByteAlignment(stream, source, typeToken);
    }

    return 0;
}

internal fn bool MirTypeForKnownSourceScalarType(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken, out MirType type)
{
    type = MirType.I64;
    stack mut u32[0 max] arrayLength = 0;
    if (TryReadFixedArrayLengthSuffix(stream, source, typeToken, arrayLength))
    {
        return false;
    }

    return MirTypeForKnownSourceScalarTypeHead(stream, source, typeToken, type);
}

internal fn bool MirTypeForKnownSourceScalarTypeHead(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken, out MirType type)
{
    type = MirType.I64;
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    if (kind == TokenKind.Bool)
    {
        type = MirType.I1;
        return true;
    }

    if (kind == TokenKind.FloatType)
    {
        stack u32[0 max] bits = SourceLocalFloatTypeTokenBitWidth(stream, source, typeToken);
        if (bits == 32)
        {
            type = MirType.F32;
            return true;
        }

        if (bits == 64)
        {
            type = MirType.F64;
            return true;
        }

        return false;
    }

    if (kind != TokenKind.IntegerType)
    {
        return false;
    }

    stack u32[0 max] bits = IntegerTypeBitWidth(stream, source, typeToken);
    switch (bits)
    {
        case 8:
            type = MirType.I8;
            return true;
        case 16:
            type = MirType.I16;
            return true;
        case 32:
            type = MirType.I32;
            return true;
        case 64:
            type = MirType.I64;
            return true;
        default:
            return false;
    }
}


internal fn u32[0 max] SourceResolvedFieldTypeCodeForMirType(MirType type)
{
    if (type == MirType.I1)
    {
        return SourceResolvedFieldTypeCodeBool();
    }

    if (type == MirType.I8)
    {
        return SourceResolvedFieldTypeCodeI8();
    }

    if (type == MirType.I16)
    {
        return SourceResolvedFieldTypeCodeI16();
    }

    if (type == MirType.I32)
    {
        return SourceResolvedFieldTypeCodeI32();
    }

    if (type == MirType.I64)
    {
        return SourceResolvedFieldTypeCodeI64();
    }

    if (type == MirType.Ptr)
    {
        return SourceResolvedFieldTypeCodePointer();
    }

    return SourceResolvedFieldTypeCodeInvalid();
}


internal fn bool TryReadPositiveIntegerToken(borrow TokenStream stream, borrow i8[min max][] source, u64[0 2 ** 63 - 1] token, out u32[0 max] value)
{
    value = 0;
    if (stream.KindAt(token) != TokenKind.IntegerLiteral)
    {
        return false;
    }

    stack i64[min max] parsed = ParseDigitSpan(source, stream.StartAt(token), stream.LengthAt(token));
    if (parsed <= 0 || parsed > 4294967295)
    {
        return false;
    }

    value = (u32[0 max])parsed;
    return true;
}

internal fn bool TryReadNonNegativeIntegerToken(borrow TokenStream stream, borrow i8[min max][] source, u64[0 2 ** 63 - 1] token, out u32[0 max] value)
{
    value = 0;
    if (stream.KindAt(token) != TokenKind.IntegerLiteral)
    {
        return false;
    }

    stack i64[min max] parsed = ParseDigitSpan(source, stream.StartAt(token), stream.LengthAt(token));
    if (parsed < 0 || parsed > 4294967295)
    {
        return false;
    }

    value = (u32[0 max])parsed;
    return true;
}

internal finite law u64[0 max] SourceEnumStorageAlignTo(u64[0 max] value, u64[0 max] alignment)
{
    if (alignment <= 1)
    {
        return value;
    }

    stack u64[0 max] remainder = value % alignment;
    if (remainder == 0)
    {
        return value;
    }

    return value + (alignment - remainder);
}
