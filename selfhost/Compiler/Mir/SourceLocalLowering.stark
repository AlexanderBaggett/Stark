internal fn bool TryFindSourceSliceDescriptorLocalByParamIndex(
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    u32[0 max] paramIndex,
    out SourceSliceDescriptorLocal found)
{
    found = new();
    stack u64[0 2 ** 63 - 1] count = sliceDescriptorLocals.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack SourceSliceDescriptorLocal local = sliceDescriptorLocals.Get(i);
        if (local.ParamIndex == paramIndex)
        {
            found = local;
