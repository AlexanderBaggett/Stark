internal inline finite law u32[0 max] SourceStorageMutationKindScalar()
{
    return 1;
}

internal inline finite law u32[0 max] SourceStorageMutationKindConstructedObjectField()
{
    return 2;
}

internal inline finite law u32[0 max] SourceStorageMutationKindEnum()
{
    return 3;
}

internal struct SourceStorageMutationStatement
{
    u32[0 max] Kind;
    u32[0 max] AssignmentIndex;

    SourceStorageMutationStatement()
    {
        self.Kind = 0;
        self.AssignmentIndex = 0;
    }
}

internal fn bool FieldInitializerTypeMatches(MirType fieldType, ExprType exprType)
{
    if (fieldType == MirType.I1)
    {
        return exprType == ExprType.BoolType;
    }

    return exprType == ExprType.IntType;
}

internal finite law bool FieldInitializerTypeCodeMatches(u32[0 max] fieldTypeCode, ExprType exprType)
{
    if (fieldTypeCode == SourceResolvedFieldTypeCodeBool())
    {
        return exprType == ExprType.BoolType;
    }

    if (fieldTypeCode == SourceResolvedFieldTypeCodeI8()
        || fieldTypeCode == SourceResolvedFieldTypeCodeI16()
        || fieldTypeCode == SourceResolvedFieldTypeCodeI32()
        || fieldTypeCode == SourceResolvedFieldTypeCodeI64())
    {
        return exprType == ExprType.IntType;
    }

    if (SourceResolvedFieldTypeCodeIsEnum(fieldTypeCode))
    {
        return exprType == ExprType.EnumType;
    }

    return false;
}

internal fn bool FieldInitializerExpressionMatchesTypeCode(
    u32[0 max] fieldTypeCode,
    borrow IrTable<ExprNode> nodes,
    u32[0 max] exprRoot,
    borrow IrTable<u32[0 max]> localTypes)
{
    stack ExprType exprType = TypeOfNodeWithLocals(nodes, exprRoot, localTypes);
    if (!FieldInitializerTypeCodeMatches(fieldTypeCode, exprType))
    {
        return false;
    }

    if (!SourceResolvedFieldTypeCodeIsEnum(fieldTypeCode))
    {
        return true;
    }

    stack mut u32[0 max] exprOwnerTypeIndex = 0;
    return TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, exprRoot, localTypes, exprOwnerTypeIndex)
        && exprOwnerTypeIndex == SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(fieldTypeCode) + 1;
}

internal finite law u64[0 max] SourceEnumStorageAlignTo(u64[0 max] value, u64[0 max] alignment)
{
    if (alignment <= 1)
    {
        return value;
    }

    stack u64[0 max] remainder = value % alignment;
    if (remainder == 0)
    {
        return value;
    }

    return value + (alignment - remainder);
}

internal fn bool TryGetSourceEnumStorageLayout(
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] ownerDeclarationIndex,
    out u32[0 max] sizeBytes,
    out u32[0 max] alignmentBytes)
{
    sizeBytes = 0;
    alignmentBytes = 1;
    stack mut bool seen = false;
    stack mut u64[0 max] maxEnd = 0;
    stack mut u64[0 max] maxAlignment = 1;
    stack u64[0 2 ** 63 - 1] count = enumLayouts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (enumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex)
        {
            if (!enumLayouts.HasConcreteLayoutAt(index))
            {
                return false;
            }

            stack u64[0 max] rowOffset = enumLayouts.OffsetBytesAt(index);
            stack u64[0 max] rowSize = enumLayouts.SizeBytesAt(index);
            stack u64[0 max] rowAlignment = enumLayouts.AlignmentBytesAt(index);
            if (rowAlignment == 0)
            {
                return false;
            }

            stack u64[0 max] rowEnd = rowOffset + rowSize;
            if (rowEnd > maxEnd)
            {
                maxEnd = rowEnd;
            }

            if (rowAlignment > maxAlignment)
            {
                maxAlignment = rowAlignment;
            }

            seen = true;
        }
    }

    stack u64[0 max] alignedSize = SourceEnumStorageAlignTo(maxEnd, maxAlignment);
    if (!seen
        || alignedSize == 0
        || alignedSize > 4294967295
        || maxAlignment > 4294967295)
    {
        return false;
    }

    sizeBytes = (u32[0 max])alignedSize;
    alignmentBytes = (u32[0 max])maxAlignment;
    return true;
}

internal fn bool TryBuildSourceValueFactsForNode(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] nodeId,
    borrow IrTable<ValueFacts> sourceValueFacts,
    out ValueFacts facts)
    where overlap(nodes, sourceValueFacts)
{
    facts = new();
    if (!nodes.Contains(nodeId))
    {
        return false;
    }

    stack ExprNode node = nodes.Get(nodeId);
    switch (node.Kind)
    {
        case Compiler.Mir.SourceExpressions.ExprKind.IntLitExpr:
            stack mut ValueFacts literalFacts = new();
            if (!TrySetSingleValueIntegerRange(literalFacts, node.Imm))
            {
                return false;
            }

            facts = literalFacts;
            return true;
        case Compiler.Mir.SourceExpressions.ExprKind.BoolLitExpr:
            stack mut ValueFacts boolFacts = new();
            boolFacts.SetIntegerRange(node.Imm, node.Imm + 1);
            facts = boolFacts;
            return true;
        case Compiler.Mir.SourceExpressions.ExprKind.NameExpr:
            if (!sourceValueFacts.Contains(node.Left + 1))
            {
                return false;
            }

            facts = sourceValueFacts.Get(node.Left + 1);
            return facts.HasIntegerRange();
        case Compiler.Mir.SourceExpressions.ExprKind.BinaryExpr:
            stack mut ValueFacts leftFacts = new();
            stack mut ValueFacts rightFacts = new();
            if (!TryBuildSourceValueFactsForNode(nodes, node.Left, sourceValueFacts, leftFacts)
                || !TryBuildSourceValueFactsForNode(nodes, node.Right, sourceValueFacts, rightFacts))
            {
                return false;
            }

            if (node.Op == TokenKind.Minus)
            {
                stack mut ValueFacts subFacts = new();
                if (!TryBuildSubRangeFacts(leftFacts, rightFacts, subFacts))
                {
                    return false;
                }

                facts = subFacts;
                return true;
            }

            if (node.Op == TokenKind.Star)
            {
                stack mut ValueFacts mulFacts = new();
                if (!TryBuildMulRangeFacts(leftFacts, rightFacts, mulFacts))
                {
                    return false;
                }

                facts = mulFacts;
                return true;
            }

            if (node.Op == TokenKind.Plus)
            {
                stack mut ValueFacts addFacts = new();
                if (!TryBuildAddRangeFacts(leftFacts, rightFacts, addFacts))
                {
                    return false;
                }

                facts = addFacts;
                return true;
            }

            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.CompareExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.EnumVariantExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.EnumPayloadExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.CallExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.CallArgLinkExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.FieldExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.IndexedFieldExpr:
            return false;
    }
}

internal fn bool SourceIndexNodeProvesFixedArrayBounds(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] indexNode,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u32[0 max] arrayLength)
    where overlap(nodes, sourceValueFacts)
{
    stack mut ValueFacts indexFacts = new();
    if (arrayLength == 0 || !TryBuildSourceValueFactsForNode(nodes, indexNode, sourceValueFacts, indexFacts))
    {
        return false;
    }

    if (!indexFacts.HasIntegerRange())
    {
        return false;
    }

    stack i64[min max] lower = indexFacts.IntegerRangeLower();
    stack i64[min max] upperExclusive = indexFacts.IntegerRangeUpperExclusive();
    return lower >= 0
        && upperExclusive > 0
        && upperExclusive <= (i64[min max])arrayLength;
}

internal fn bool StatementStartsConstructedObjectFieldAssignment(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    if (start + 4 < end
        && stream.KindAt(start) == TokenKind.Identifier
        && stream.KindAt(start + 1) == TokenKind.Dot
        && stream.KindAt(start + 2) == TokenKind.Identifier
        && stream.KindAt(start + 3) == TokenKind.Assign)
    {
        return true;
    }

    if (start + 6 < end
        && stream.KindAt(start) == TokenKind.Identifier
        && stream.KindAt(start + 1) == TokenKind.Dot
        && stream.KindAt(start + 2) == TokenKind.Identifier
        && stream.KindAt(start + 3) == TokenKind.LBrack)
    {
        stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(start + 3));
        return closeBracket != (u32[0 max])(start + 3)
            && (u64[0 2 ** 63 - 1])(closeBracket + 1) < end
            && stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) == TokenKind.Assign;
    }

    return false;
}

internal fn bool StatementStartsScalarStorageAssignment(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    return start + 2 < end
        && stream.KindAt(start) == TokenKind.Identifier
        && stream.KindAt(start + 1) == TokenKind.Assign;
}

internal struct ConstructedObjectLocal
{
    u64[0 2 ** 63 - 1] Start;
    u64[0 2 ** 63 - 1] Length;
    u32[0 max] ParamIndex;
    u32[0 max] TypeToken;

    ConstructedObjectLocal()
    {
        self.Start = 0;
        self.Length = 0;
        self.ParamIndex = 0;
        self.TypeToken = 0;
    }
}

internal fn bool TryFindConstructedObjectLocal(
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] length,
    out ConstructedObjectLocal found)
{
    found = new();
    stack u64[0 2 ** 63 - 1] count = objectLocals.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack ConstructedObjectLocal local = objectLocals.Get(i);
        if (SpanEquals(source, local.Start, local.Length, start, length))
        {
            found = local;
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TryFindScalarStorageLocal(
    borrow IrTable<ScalarStorageLocal> scalarLocals,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] length,
    out ScalarStorageLocal found)
{
    found = new();
    stack u64[0 2 ** 63 - 1] count = scalarLocals.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack ScalarStorageLocal local = scalarLocals.Get(i);
        if (SpanEquals(source, local.Start, local.Length, start, length))
        {
            found = local;
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TryFindEnumStorageLocal(
    borrow IrTable<EnumStorageLocal> enumLocals,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] length,
    out EnumStorageLocal found)
{
    found = new();
    stack u64[0 2 ** 63 - 1] count = enumLocals.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack EnumStorageLocal local = enumLocals.Get(i);
        if (SpanEquals(source, local.Start, local.Length, start, length))
        {
            found = local;
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn u32[0 max] SourceResolvedFieldTypeCodeForMirType(MirType type)
{
    if (type == MirType.I1)
    {
        return SourceResolvedFieldTypeCodeBool();
    }

    if (type == MirType.I8)
    {
        return SourceResolvedFieldTypeCodeI8();
    }

    if (type == MirType.I16)
    {
        return SourceResolvedFieldTypeCodeI16();
    }

    if (type == MirType.I32)
    {
        return SourceResolvedFieldTypeCodeI32();
    }

    if (type == MirType.I64)
    {
        return SourceResolvedFieldTypeCodeI64();
    }

    return SourceResolvedFieldTypeCodeInvalid();
}

internal fn u32[0 max] SourceLocalStoredScalarTypeCodeForMirType(MirType type)
{
    if (type == MirType.I1)
    {
        return SourceLocalTypeCodeStoredBool();
    }

    if (type == MirType.I8)
    {
        return SourceLocalTypeCodeStoredI8();
    }

    if (type == MirType.I16)
    {
        return SourceLocalTypeCodeStoredI16();
    }

    if (type == MirType.I32)
    {
        return SourceLocalTypeCodeStoredI32();
    }

    if (type == MirType.I64)
    {
        return SourceLocalTypeCodeStoredI64();
    }

    return SourceLocalTypeCodeNonValue();
}

internal fn bool TryGetSourceEnumOwnerDeclarationForToken(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    u32[0 max] ownerToken,
    out u32[0 max] ownerDeclarationIndex,
    out Compiler.Parsing.DeclItem enumItem)
{
    ownerDeclarationIndex = 0;
    enumItem = new();

    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack Compiler.Parsing.DeclItem item = declarations.ItemAt(index);
        if (item.Kind == Compiler.Parsing.DeclarationKind.Enum
            && item.NameToken != 0
            && SourceLocalTokenTextEqualsToken(stream, source, ownerToken, item.NameToken))
        {
            ownerDeclarationIndex = (u32[0 max])index;
            enumItem = item;
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool SourceLocalTokenTextEqualsToken(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] left, u32[0 max] right)
{
    stack u64[0 2 ** 63 - 1] leftIndex = (u64[0 2 ** 63 - 1])left;
    stack u64[0 2 ** 63 - 1] rightIndex = (u64[0 2 ** 63 - 1])right;
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt(leftIndex);
    if (length != stream.LengthAt(rightIndex))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] leftStart = stream.StartAt(leftIndex);
    stack u64[0 2 ** 63 - 1] rightStart = stream.StartAt(rightIndex);
    stack mut u64[0 2 ** 63 - 1] offset = 0;
    while willexit (offset < length)
    {
        if (source[leftStart + offset] != source[rightStart + offset])
        {
            return false;
        }

        offset = offset + 1;
    }

    return true;
}

internal fn bool TryGetSourceEnumVariantOrdinalForToken(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    Compiler.Parsing.DeclItem enumItem,
    u32[0 max] variantToken,
    out u32[0 max] variantOrdinal)
{
    variantOrdinal = 0;
    stack i64[min max] bodyOpenSigned = FirstTokenOfKindAfter(stream, TokenKind.LBrace, (u64[0 2 ** 63 - 1])enumItem.KeywordToken);
    if (bodyOpenSigned < 0)
    {
        return false;
    }

    stack u32[0 max] bodyOpen = (u32[0 max])bodyOpenSigned;
    stack u32[0 max] bodyClose = MatchingBraceForMirLowering(stream, bodyOpen);
    if (bodyClose == bodyOpen)
    {
        return false;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] scan = (u64[0 2 ** 63 - 1])bodyOpen + 1;
    while willexit (scan < (u64[0 2 ** 63 - 1])bodyClose)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (depth == 0 && kind == TokenKind.Identifier)
        {
            if (SourceLocalTokenTextEqualsToken(stream, source, (u32[0 max])scan, variantToken))
            {
                return true;
            }

            variantOrdinal = variantOrdinal + 1;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrace || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrace || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }

        scan = scan + 1;
    }

    return false;
}

internal finite law u32[0 max] SourceResolvedFieldTypeCodeForTypedEnumPayload(TypedSignatureTypeKind typeKind, u32[0 max] bitWidth)
{
    if (typeKind == TypedSignatureTypeKind.Bool)
    {
        return SourceResolvedFieldTypeCodeBool();
    }

    if (typeKind == TypedSignatureTypeKind.Integer)
    {
        if (bitWidth == 8)
        {
            return SourceResolvedFieldTypeCodeI8();
        }

        if (bitWidth == 16)
        {
            return SourceResolvedFieldTypeCodeI16();
        }

        if (bitWidth == 32)
        {
            return SourceResolvedFieldTypeCodeI32();
        }

        if (bitWidth == 64 || bitWidth == 0)
        {
            return SourceResolvedFieldTypeCodeI64();
        }
    }

    return SourceResolvedFieldTypeCodeInvalid();
}

internal fn bool TryGetSourceEnumPayloadTypeCode(
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    out u32[0 max] payloadTypeCode)
{
    payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();

    stack u64[0 2 ** 63 - 1] count = enumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (enumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && enumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Payload
            && enumLayouts.VariantOrdinalAt(index) == variantOrdinal
            && enumLayouts.PayloadOrdinalAt(index) == payloadOrdinal)
        {
            payloadTypeCode = SourceResolvedFieldTypeCodeForTypedEnumPayload(enumLayouts.TypeKindAt(index), enumLayouts.BitWidthAt(index));
            return payloadTypeCode != SourceResolvedFieldTypeCodeInvalid();
        }

        index = index + 1;
    }

    return false;
}

internal fn bool TryGetSourceNamedEnumPayloadTypeCode(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadNameToken,
    out u32[0 max] payloadOrdinal,
    out u32[0 max] payloadTypeCode)
{
    payloadOrdinal = 0;
    payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();

    stack u64[0 2 ** 63 - 1] count = enumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] rowPayloadNameToken = enumLayouts.PayloadNameTokenAt(index);
        if (enumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && enumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Payload
            && enumLayouts.VariantOrdinalAt(index) == variantOrdinal
            && enumLayouts.UsesNamedPayloadsAt(index)
            && rowPayloadNameToken != 0
            && SourceLocalTokenTextEqualsToken(stream, source, payloadNameToken, rowPayloadNameToken))
        {
            payloadOrdinal = enumLayouts.PayloadOrdinalAt(index);
            payloadTypeCode = SourceResolvedFieldTypeCodeForTypedEnumPayload(enumLayouts.TypeKindAt(index), enumLayouts.BitWidthAt(index));
            return payloadTypeCode != SourceResolvedFieldTypeCodeInvalid();
        }

        index = index + 1;
    }

    return false;
}

internal fn bool SourceEnumPayloadOrdinalListContains(
    borrow IrTable<u32[0 max]> payloadOrdinals,
    u32[0 max] payloadOrdinal)
{
    stack u64[0 2 ** 63 - 1] count = payloadOrdinals.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (payloadOrdinals.Get((u32[0 max])(index + 1)) == payloadOrdinal)
        {
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal finite law bool SourceExpressionTypeMatchesEnumPayloadTypeCode(ExprType exprType, u32[0 max] payloadTypeCode)
{
    if (payloadTypeCode == SourceResolvedFieldTypeCodeBool())
    {
        return exprType == ExprType.BoolType;
    }

    if (payloadTypeCode == SourceResolvedFieldTypeCodeI8()
        || payloadTypeCode == SourceResolvedFieldTypeCodeI16()
        || payloadTypeCode == SourceResolvedFieldTypeCodeI32()
        || payloadTypeCode == SourceResolvedFieldTypeCodeI64())
    {
        return exprType == ExprType.IntType;
    }

    return false;
}

internal fn ExprParseResult TryParseSourceEnumConstructorPrimaryIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    if (stream.KindAt(cursor) != TokenKind.Identifier
        || stream.KindAt(cursor + 1) != TokenKind.Dot
        || stream.KindAt(cursor + 2) != TokenKind.Identifier)
    {
        return MakeParseResult(0, cursor);
    }

    stack mut u32[0 max] ownerDeclarationIndex = 0;
    stack mut Compiler.Parsing.DeclItem enumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(stream, source, declarations, (u32[0 max])cursor, ownerDeclarationIndex, enumItem))
    {
        return MakeParseResult(0, cursor);
    }

    stack mut u32[0 max] variantOrdinal = 0;
    if (!TryGetSourceEnumVariantOrdinalForToken(stream, source, enumItem, (u32[0 max])(cursor + 2), variantOrdinal))
    {
        return MakeParseResult(0, cursor);
    }

    stack mut u64[0 max] payloadCount = 0;
    if (!enumLayouts.TryGetEnumVariantPayloadCount(ownerDeclarationIndex, variantOrdinal, payloadCount))
    {
        return MakeParseResult(0, cursor);
    }

    stack TypeId ownerType = TypeIdOf(ownerDeclarationIndex + 1);
    stack u32[0 max] enumValue = MakeEnumVariant(nodes, ownerType, variantOrdinal);
    if (payloadCount == 0)
    {
        return MakeParseResult(enumValue, cursor + 3);
    }

    if (stream.KindAt(cursor + 3) == TokenKind.LBrace)
    {
        stack mut u64[0 2 ** 63 - 1] fieldCursor = cursor + 4;
        stack mut u32[0 max] currentEnumValue = enumValue;
        stack mut IrTable<u32[0 max]> seenPayloadOrdinals = new();
        while willexit (stream.KindAt(fieldCursor) != TokenKind.RBrace)
        {
            if (stream.KindAt(fieldCursor) != TokenKind.Identifier
                || stream.KindAt(fieldCursor + 1) != TokenKind.Colon)
            {
                return MakeParseResult(0, cursor);
            }

            stack mut u32[0 max] payloadOrdinal = 0;
            stack mut u32[0 max] payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!TryGetSourceNamedEnumPayloadTypeCode(
                    stream,
                    source,
                    enumLayouts,
                    ownerDeclarationIndex,
                    variantOrdinal,
                    (u32[0 max])fieldCursor,
                    payloadOrdinal,
                    payloadTypeCode)
                || SourceEnumPayloadOrdinalListContains(seenPayloadOrdinals, payloadOrdinal)
                || seenPayloadOrdinals.Add(payloadOrdinal) == 0)
            {
                return MakeParseResult(0, cursor);
            }

            stack ExprParseResult payloadExpr = ParseConstructedObjectExprWithEnumsIn(
                stream,
                source,
                nodes,
                params,
                funcNames,
                objectLocals,
                localTypes,
                sourceValueFacts,
                declarations,
                enumLayouts,
                fieldCursor + 2);
            if (payloadExpr.NodeId == 0
                || !SourceExpressionTypeMatchesEnumPayloadTypeCode(TypeOfNodeWithLocals(nodes, payloadExpr.NodeId, localTypes), payloadTypeCode))
            {
                return MakeParseResult(0, cursor);
            }

            currentEnumValue = MakeEnumPayloadInsert(nodes, ownerType, variantOrdinal, payloadOrdinal, currentEnumValue, payloadExpr.NodeId, payloadTypeCode);
            fieldCursor = payloadExpr.Next;
            if (stream.KindAt(fieldCursor) == TokenKind.Comma)
            {
                fieldCursor = fieldCursor + 1;
            }
            else if (stream.KindAt(fieldCursor) != TokenKind.RBrace)
            {
                return MakeParseResult(0, cursor);
            }
        }

        if (seenPayloadOrdinals.Count() != payloadCount)
        {
            return MakeParseResult(0, cursor);
        }

        return MakeParseResult(currentEnumValue, fieldCursor + 1);
    }

    if (stream.KindAt(cursor + 3) != TokenKind.LParen)
    {
        return MakeParseResult(0, cursor);
    }

    stack mut u64[0 2 ** 63 - 1] argCursor = cursor + 4;
    stack mut u32[0 max] payloadOrdinal = 0;
    stack mut u32[0 max] currentEnumValue = enumValue;
    while willexit ((u64[0 max])payloadOrdinal < payloadCount)
    {
        if (payloadOrdinal > 0)
        {
            if (stream.KindAt(argCursor) != TokenKind.Comma)
            {
                return MakeParseResult(0, cursor);
            }

            argCursor = argCursor + 1;
        }

        stack ExprParseResult payloadExpr = ParseConstructedObjectExprWithEnumsIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            objectLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            argCursor);
        if (payloadExpr.NodeId == 0)
        {
            return MakeParseResult(0, cursor);
        }

        stack mut u32[0 max] payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();
        if (!TryGetSourceEnumPayloadTypeCode(enumLayouts, ownerDeclarationIndex, variantOrdinal, payloadOrdinal, payloadTypeCode)
            || !SourceExpressionTypeMatchesEnumPayloadTypeCode(TypeOfNodeWithLocals(nodes, payloadExpr.NodeId, localTypes), payloadTypeCode))
        {
            return MakeParseResult(0, cursor);
        }

        currentEnumValue = MakeEnumPayloadInsert(nodes, ownerType, variantOrdinal, payloadOrdinal, currentEnumValue, payloadExpr.NodeId, payloadTypeCode);
        argCursor = payloadExpr.Next;
        payloadOrdinal = payloadOrdinal + 1;
    }

    if (stream.KindAt(argCursor) != TokenKind.RParen)
    {
        return MakeParseResult(0, cursor);
    }

    return MakeParseResult(currentEnumValue, argCursor + 1);
}

internal fn ExprParseResult ParseConstructedObjectPrimaryWithEnumsIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    stack TokenKind k = stream.KindAt(cursor);
    if (k == TokenKind.IntegerLiteral)
    {
        stack i64[min max] value = ParseDigitSpan(source, stream.StartAt(cursor), stream.LengthAt(cursor));
        return MakeParseResult(MakeIntLit(nodes, value), cursor + 1);
    }

    if (k == TokenKind.True)
    {
        return MakeParseResult(MakeBoolLit(nodes, true), cursor + 1);
    }

    if (k == TokenKind.False)
    {
        return MakeParseResult(MakeBoolLit(nodes, false), cursor + 1);
    }

    if (k == TokenKind.Minus)
    {
        stack ExprParseResult operand = ParseConstructedObjectPrimaryWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 1);
        stack u32[0 max] zero = MakeIntLit(nodes, 0);
        stack u32[0 max] negated = MakeBinary(nodes, TokenKind.Minus, zero, operand.NodeId);
        return MakeParseResult(negated, operand.Next);
    }

    if (k == TokenKind.LParen)
    {
        stack ExprParseResult inner = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 1);
        return MakeParseResult(inner.NodeId, inner.Next + 1);
    }

    if (k == TokenKind.Identifier
        && stream.KindAt(cursor + 1) == TokenKind.Dot
        && stream.KindAt(cursor + 2) == TokenKind.Identifier)
    {
        stack ExprParseResult enumConstructor = TryParseSourceEnumConstructorPrimaryIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            objectLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            cursor);
        if (enumConstructor.NodeId != 0)
        {
            return enumConstructor;
        }
    }

    if (k == TokenKind.Identifier && stream.KindAt(cursor + 1) == TokenKind.LParen)
    {
        stack i64[min max] calleeIndex = ParamIndexOf(funcNames, source, stream.StartAt(cursor), stream.LengthAt(cursor));
        stack mut u32[0 max] callee = 0;
        if (calleeIndex >= 0)
        {
            callee = (u32[0 max])(calleeIndex + 1);
        }

        if (stream.KindAt(cursor + 2) == TokenKind.RParen)
        {
            return MakeParseResult(MakeCall(nodes, callee, 0, 0, 0, 0, 0), cursor + 3);
        }

        stack ExprParseResult firstArg = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 2);
        stack mut u64[0 2 ** 63 - 1] argCursor = firstArg.Next;
        stack mut u32[0 max] argCount = 1;
        stack mut u32[0 max] secondArg = 0;
        stack mut u32[0 max] thirdArg = 0;
        stack mut u32[0 max] fourthArg = 0;
        stack mut IrTable<u32[0 max]> extraArgs = new();
        while willexit (stream.KindAt(argCursor) == TokenKind.Comma)
        {
            stack ExprParseResult more = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, argCursor + 1);
            if (argCount == 1)
            {
                secondArg = more.NodeId;
            }
            else if (argCount == 2)
            {
                thirdArg = more.NodeId;
            }
            else if (argCount == 3)
            {
                fourthArg = more.NodeId;
            }
            else
            {
                stack u32[0 max] addedExtra = extraArgs.Add(more.NodeId);
                if (addedExtra == 0)
                {
                    return MakeParseResult(0, argCursor);
                }
            }

            argCursor = more.Next;
            argCount = argCount + 1;
        }

        stack u32[0 max] extraArgLink = BuildCallExtraArgLinks(nodes, extraArgs);
        return MakeParseResult(MakeCallWithExtra(nodes, callee, argCount, firstArg.NodeId, secondArg, thirdArg, fourthArg, extraArgLink), argCursor + 1);
    }

    if (k == TokenKind.Identifier
        && stream.KindAt(cursor + 1) == TokenKind.Dot
        && stream.KindAt(cursor + 2) == TokenKind.Identifier
        && stream.KindAt(cursor + 3) == TokenKind.LBrack
        && stream.KindAt(cursor + 4) == TokenKind.IntegerLiteral
        && stream.KindAt(cursor + 5) == TokenKind.RBrack)
    {
        stack mut ConstructedObjectLocal objectLocal = new();
        if (TryFindConstructedObjectLocal(objectLocals, source, stream.StartAt(cursor), stream.LengthAt(cursor), objectLocal))
        {
            stack mut u32[0 max] elementOffset = 0;
            stack mut u32[0 max] elementAlignment = 0;
            stack mut MirType elementType = MirType.I64;
            if (TryFindStructFixedArrayElementLayout(
                stream,
                source,
                objectLocal.TypeToken,
                (u32[0 max])(cursor + 2),
                (u32[0 max])(cursor + 4),
                elementOffset,
                elementAlignment,
                elementType))
            {
                stack u32[0 max] elementTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
                if (elementTypeCode != SourceResolvedFieldTypeCodeInvalid())
                {
                    return MakeParseResult(MakeResolvedFieldRead(nodes, objectLocal.ParamIndex, elementOffset, elementAlignment, elementTypeCode), cursor + 6);
                }
            }
        }
    }

    if (k == TokenKind.Identifier
        && stream.KindAt(cursor + 1) == TokenKind.Dot
        && stream.KindAt(cursor + 2) == TokenKind.Identifier
        && stream.KindAt(cursor + 3) == TokenKind.LBrack)
    {
        stack mut ConstructedObjectLocal objectLocal = new();
        if (TryFindConstructedObjectLocal(objectLocals, source, stream.StartAt(cursor), stream.LengthAt(cursor), objectLocal))
        {
            stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(cursor + 3));
            if (closeBracket != (u32[0 max])(cursor + 3))
            {
                stack mut u32[0 max] baseByteOffset = 0;
                stack mut u32[0 max] elementSizeBytes = 0;
                stack mut u32[0 max] elementAlignment = 0;
                stack mut MirType elementType = MirType.I64;
                stack mut u32[0 max] arrayLength = 0;
                if (TryFindStructFixedArrayFieldLayout(
                    stream,
                    source,
                    objectLocal.TypeToken,
                    (u32[0 max])(cursor + 2),
                    baseByteOffset,
                    elementSizeBytes,
                    elementAlignment,
                    elementType,
                    arrayLength))
                {
                    stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
                    stack ExprParseResult indexExpr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 4);
                    if (params.Count() == beforeIndex
                        && indexExpr.NodeId != 0
                        && indexExpr.Next == (u64[0 2 ** 63 - 1])closeBracket
                        && TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) == ExprType.IntType
                        && SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, arrayLength))
                    {
                        stack u32[0 max] elementTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
                        if (elementTypeCode != SourceResolvedFieldTypeCodeInvalid())
                        {
                            return MakeParseResult(
                                MakeResolvedIndexedFieldRead(nodes, objectLocal.ParamIndex, indexExpr.NodeId, baseByteOffset, elementSizeBytes, elementAlignment, elementTypeCode),
                                (u64[0 2 ** 63 - 1])closeBracket + 1);
                        }
                    }
                }
            }
        }
    }

    if (k == TokenKind.Identifier
        && stream.KindAt(cursor + 1) == TokenKind.Dot
        && stream.KindAt(cursor + 2) == TokenKind.Identifier)
    {
        stack mut ConstructedObjectLocal objectLocal = new();
        if (TryFindConstructedObjectLocal(objectLocals, source, stream.StartAt(cursor), stream.LengthAt(cursor), objectLocal))
        {
            stack mut u32[0 max] fieldOffset = 0;
            stack mut u32[0 max] fieldAlignment = 0;
            stack mut MirType fieldType = MirType.I64;
            stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (TryFindStructFieldLayout(stream, source, declarations, enumLayouts, objectLocal.TypeToken, (u32[0 max])(cursor + 2), fieldOffset, fieldAlignment, fieldType, fieldTypeCode))
            {
                if (fieldTypeCode != SourceResolvedFieldTypeCodeInvalid())
                {
                    return MakeParseResult(MakeResolvedFieldRead(nodes, objectLocal.ParamIndex, fieldOffset, fieldAlignment, fieldTypeCode), cursor + 3);
                }
            }
        }
    }

    stack u32[0 max] paramIndex = ResolveParam(params, source, stream.StartAt(cursor), stream.LengthAt(cursor));
    return MakeParseResult(MakeName(nodes, paramIndex), cursor + 1);
}

internal fn ExprParseResult ParseConstructedObjectMulWithEnumsIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    stack mut ExprParseResult left = ParseConstructedObjectPrimaryWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor);
    while willexit (IsProductOpToken(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ExprParseResult right = ParseConstructedObjectPrimaryWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, left.Next + 1);
        left.NodeId = MakeBinary(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

internal fn ExprParseResult ParseConstructedObjectAddWithEnumsIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    stack mut ExprParseResult left = ParseConstructedObjectMulWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor);
    while willexit (IsAddSubToken(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ExprParseResult right = ParseConstructedObjectMulWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, left.Next + 1);
        left.NodeId = MakeBinary(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

internal fn ExprParseResult ParseConstructedObjectExprWithEnumsIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    stack mut ExprParseResult left = ParseConstructedObjectAddWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor);
    while willexit (IsComparisonOperator(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ExprParseResult right = ParseConstructedObjectAddWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, left.Next + 1);
        left.NodeId = MakeCompare(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

internal fn ExprParseResult ParseConstructedObjectExprIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts)
{
    stack mut Compiler.Parsing.DeclarationList noDeclarations = new();
    stack mut TypedEnumLayoutTable noEnumLayouts = new();
    return ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, noDeclarations, noEnumLayouts, cursor);
}

internal fn bool TryParseStackObjectFieldInitializers(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken,
    u32[0 max] bodyOpen,
    u32[0 max] bodyClose,
    u32[0 max] localOrdinal,
    MirValueId objectPointer,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    mut borrow IrTable<StackObjectFieldInitializer> initializers)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(initializers, sourceValueFacts)
{
    if (bodyOpen == 0)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])bodyOpen + 1;
    stack u64[0 2 ** 63 - 1] close = (u64[0 2 ** 63 - 1])bodyClose;
    while willexit (cursor < close)
    {
        if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            cursor = cursor + 1;
            continue;
        }

        if (stream.KindAt(cursor) != TokenKind.Identifier || stream.KindAt(cursor + 1) != TokenKind.Assign)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] valueStart = cursor + 2;
        stack u64[0 2 ** 63 - 1] valueEnd = FindObjectInitializerEntryEnd(stream, valueStart, close);
        if (valueStart >= valueEnd)
        {
            return false;
        }

        stack mut u32[0 max] fieldOffset = 0;
        stack mut u32[0 max] fieldAlignment = 0;
        stack mut MirType fieldType = MirType.I64;
        stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        if (!TryFindStructFieldLayout(stream, source, declarations, enumLayouts, typeToken, (u32[0 max])cursor, fieldOffset, fieldAlignment, fieldType, fieldTypeCode))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
        stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, valueStart);
        if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != valueEnd)
        {
            return false;
        }

        if (!FieldInitializerExpressionMatchesTypeCode(fieldTypeCode, nodes, expr.NodeId, localTypes))
        {
            return false;
        }

        stack mut StackObjectFieldInitializer initializer = new();
        initializer.LocalOrdinal = localOrdinal;
        initializer.ObjectPointerValue = objectPointer.Index();
        initializer.FieldOffset = fieldOffset;
        initializer.FieldAlignment = fieldAlignment;
        initializer.FieldType = fieldType;
        initializer.FieldTypeCode = fieldTypeCode;
        initializer.ExprRoot = expr.NodeId;
        stack u32[0 max] added = initializers.Add(initializer);
        if (added == 0)
        {
            return false;
        }

        cursor = valueEnd;
    }

    return true;
}

internal fn bool TryParseStackObjectPositionalRecordConstructorInitializers(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken,
    u32[0 max] argsOpen,
    u32[0 max] argsClose,
    u32[0 max] localOrdinal,
    MirValueId objectPointer,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    mut borrow IrTable<StackObjectFieldInitializer> initializers)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(initializers, sourceValueFacts)
{
    stack mut RecordHeaderFieldLayoutCursor fieldCursor = new();
    if (!TryStartRecordHeaderFieldLayoutCursor(stream, source, typeToken, fieldCursor))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])argsOpen + 1;
    stack u64[0 2 ** 63 - 1] close = (u64[0 2 ** 63 - 1])argsClose;
    while willexit (cursor < close)
    {
        if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            cursor = cursor + 1;
            continue;
        }

        stack u64[0 2 ** 63 - 1] valueEnd = FindObjectInitializerEntryEnd(stream, cursor, close);
        if (cursor >= valueEnd)
        {
            return false;
        }

        stack mut u32[0 max] fieldOffset = 0;
        stack mut u32[0 max] fieldAlignment = 0;
        stack mut MirType fieldType = MirType.I64;
        stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        if (!TryReadNextRecordHeaderFieldLayout(stream, source, declarations, enumLayouts, fieldCursor, fieldOffset, fieldAlignment, fieldType, fieldTypeCode))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
        stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor);
        if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != valueEnd)
        {
            return false;
        }

        if (!FieldInitializerExpressionMatchesTypeCode(fieldTypeCode, nodes, expr.NodeId, localTypes))
        {
            return false;
        }

        stack mut StackObjectFieldInitializer initializer = new();
        initializer.LocalOrdinal = localOrdinal;
        initializer.ObjectPointerValue = objectPointer.Index();
        initializer.FieldOffset = fieldOffset;
        initializer.FieldAlignment = fieldAlignment;
        initializer.FieldType = fieldType;
        initializer.FieldTypeCode = fieldTypeCode;
        initializer.ExprRoot = expr.NodeId;
        stack u32[0 max] added = initializers.Add(initializer);
        if (added == 0)
        {
            return false;
        }

        cursor = valueEnd;
    }

    stack mut u32[0 max] trailingFieldOffset = 0;
    stack mut u32[0 max] trailingFieldAlignment = 0;
    stack mut MirType trailingFieldType = MirType.I64;
    stack mut u32[0 max] trailingFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    return !TryReadNextRecordHeaderFieldLayout(stream, source, declarations, enumLayouts, fieldCursor, trailingFieldOffset, trailingFieldAlignment, trailingFieldType, trailingFieldTypeCode);
}

internal fn u32[0 max] LowerStackObjectFieldInitializersForLocal(
    borrow IrTable<StackObjectFieldInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut u32[0 max] cursor = nextInitializer;
    while willexit (initializers.Contains(cursor))
    {
        stack StackObjectFieldInitializer initializer = initializers.Get(cursor);
        if (initializer.LocalOrdinal != localOrdinal)
        {
            return cursor;
        }

        stack MirValueId basePointer = MirValueIdOf(initializer.ObjectPointerValue);
        stack MirValueId fieldPointer = MirPtrOffset(instrs, basePointer, initializer.FieldOffset, initializer.FieldAlignment);
        if (SourceResolvedFieldTypeCodeIsEnum(initializer.FieldTypeCode))
        {
            stack u32[0 max] ownerTypeIndex = SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(initializer.FieldTypeCode) + 1;
            stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, initializer.ExprRoot, instrs, localTypes, localOverrides);
            stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(ownerTypeIndex), fieldPointer, value, initializer.FieldAlignment);
        }
        else
        {
            stack MirValueId value = LowerExprNodeAsTypeWithTypesAndLocals(nodes, initializer.ExprRoot, instrs, localTypes, localOverrides, initializer.FieldType);
            stack MirValueId store = MirStorePtrAlignedTyped(instrs, initializer.FieldType, fieldPointer, value, initializer.FieldAlignment);
        }

        cursor = cursor + 1;
    }

    return cursor;
}

internal fn u32[0 max] LowerScalarStorageInitializersForLocal(
    borrow IrTable<ScalarStorageInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut u32[0 max] cursor = nextInitializer;
    while willexit (initializers.Contains(cursor))
    {
        stack ScalarStorageInitializer initializer = initializers.Get(cursor);
        if (initializer.LocalOrdinal != localOrdinal)
        {
            return cursor;
        }

        if (!localOverrides.Contains(initializer.ParamIndex + 1))
        {
            return cursor;
        }

        stack u32[0 max] storageValue = localOverrides.Get(initializer.ParamIndex + 1);
        if (storageValue == 0)
        {
            return cursor;
        }

        stack MirValueId value = LowerExprNodeAsTypeWithTypesAndLocals(nodes, initializer.ExprRoot, instrs, localTypes, localOverrides, initializer.FieldType);
        stack MirValueId store = MirStorePtrAlignedTyped(instrs, initializer.FieldType, MirValueIdOf(storageValue), value, initializer.FieldAlignment);
        cursor = cursor + 1;
    }

    return cursor;
}

internal fn u32[0 max] LowerEnumStorageInitializersForLocal(
    borrow IrTable<EnumStorageInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut u32[0 max] cursor = nextInitializer;
    while willexit (initializers.Contains(cursor))
    {
        stack EnumStorageInitializer initializer = initializers.Get(cursor);
        if (initializer.LocalOrdinal != localOrdinal)
        {
            return cursor;
        }

        if (!localOverrides.Contains(initializer.ParamIndex + 1))
        {
            return cursor;
        }

        stack u32[0 max] storageValue = localOverrides.Get(initializer.ParamIndex + 1);
        if (storageValue == 0 || initializer.OwnerTypeIndex == 0)
        {
            return cursor;
        }

        stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, initializer.ExprRoot, instrs, localTypes, localOverrides);
        stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(initializer.OwnerTypeIndex), MirValueIdOf(storageValue), value, initializer.FieldAlignment);
        cursor = cursor + 1;
    }

    return cursor;
}

internal fn bool TryParseScalarStorageAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<ScalarStorageLocal> scalarStorageLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<ScalarStorageAssignment> assignments)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(scalarStorageLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(assignments, sourceValueFacts)
{
    if (!StatementStartsScalarStorageAssignment(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack mut ScalarStorageLocal local = new();
    if (!TryFindScalarStorageLocal(
        scalarStorageLocals,
        source,
        stream.StartAt(statementStart),
        stream.LengthAt(statementStart),
        local))
    {
        return false;
    }

    if (!local.Mutable)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, statementStart + 2);
    if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != statementEnd)
    {
        return false;
    }

    stack ExprType exprType = TypeOfNodeWithLocals(nodes, expr.NodeId, localTypes);
    if (!FieldInitializerTypeMatches(local.FieldType, exprType))
    {
        return false;
    }

    stack mut ScalarStorageAssignment assignment = new();
    assignment.ParamIndex = local.ParamIndex;
    assignment.FieldAlignment = local.FieldAlignment;
    assignment.FieldType = local.FieldType;
    assignment.ExprRoot = expr.NodeId;
    stack u32[0 max] added = assignments.Add(assignment);
    return added != 0;
}

internal fn bool TryParseEnumStorageAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<EnumStorageLocal> enumStorageLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<EnumStorageAssignment> assignments)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(enumStorageLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(assignments, sourceValueFacts)
{
    if (!StatementStartsScalarStorageAssignment(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack mut EnumStorageLocal local = new();
    if (!TryFindEnumStorageLocal(
        enumStorageLocals,
        source,
        stream.StartAt(statementStart),
        stream.LengthAt(statementStart),
        local))
    {
        return false;
    }

    if (!local.Mutable || local.OwnerTypeIndex == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, statementStart + 2);
    if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != statementEnd)
    {
        return false;
    }

    stack mut u32[0 max] exprOwnerTypeIndex = 0;
    if (TypeOfNodeWithLocals(nodes, expr.NodeId, localTypes) != ExprType.EnumType
        || !TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, expr.NodeId, localTypes, exprOwnerTypeIndex)
        || exprOwnerTypeIndex != local.OwnerTypeIndex)
    {
        return false;
    }

    stack mut EnumStorageAssignment assignment = new();
    assignment.ParamIndex = local.ParamIndex;
    assignment.FieldAlignment = local.FieldAlignment;
    assignment.OwnerTypeIndex = local.OwnerTypeIndex;
    assignment.ExprRoot = expr.NodeId;
    stack u32[0 max] added = assignments.Add(assignment);
    return added != 0;
}

internal fn bool LowerScalarStorageAssignment(
    ScalarStorageAssignment assignment,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    if (!localOverrides.Contains(assignment.ParamIndex + 1))
    {
        return false;
    }

    stack u32[0 max] storageValue = localOverrides.Get(assignment.ParamIndex + 1);
    if (storageValue == 0)
    {
        return false;
    }

    stack MirValueId value = LowerExprNodeAsTypeWithTypesAndLocals(nodes, assignment.ExprRoot, instrs, localTypes, localOverrides, assignment.FieldType);
    stack MirValueId store = MirStorePtrAlignedTyped(instrs, assignment.FieldType, MirValueIdOf(storageValue), value, assignment.FieldAlignment);
    return true;
}

internal fn bool LowerEnumStorageAssignment(
    EnumStorageAssignment assignment,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    if (!localOverrides.Contains(assignment.ParamIndex + 1))
    {
        return false;
    }

    stack u32[0 max] storageValue = localOverrides.Get(assignment.ParamIndex + 1);
    if (storageValue == 0 || assignment.OwnerTypeIndex == 0)
    {
        return false;
    }

    stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, assignment.ExprRoot, instrs, localTypes, localOverrides);
    stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(assignment.OwnerTypeIndex), MirValueIdOf(storageValue), value, assignment.FieldAlignment);
    return true;
}

internal fn bool LowerScalarStorageAssignments(
    borrow IrTable<ScalarStorageAssignment> assignments,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack u64[0 2 ** 63 - 1] total = assignments.Count();
    stack mut u32[0 max] cursor = 1;
    while willexit ((u64[0 2 ** 63 - 1])cursor <= total)
    {
        stack ScalarStorageAssignment assignment = assignments.Get(cursor);
        if (!LowerScalarStorageAssignment(assignment, nodes, instrs, localTypes, localOverrides))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    return true;
}

internal fn bool TryParseConstructedObjectFieldAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<ConstructedObjectFieldAssignment> assignments)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(assignments, sourceValueFacts)
{
    if (!StatementStartsConstructedObjectFieldAssignment(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack mut ConstructedObjectLocal objectLocal = new();
    if (!TryFindConstructedObjectLocal(
        constructedObjectLocals,
        source,
        stream.StartAt(statementStart),
        stream.LengthAt(statementStart),
        objectLocal))
    {
        return false;
    }

    stack mut u32[0 max] fieldOffset = 0;
    stack mut u32[0 max] fieldAlignment = 0;
    stack mut MirType fieldType = MirType.I64;
    stack mut u32[0 max] indexRoot = 0;
    stack mut u32[0 max] elementSize = 0;
    stack mut u64[0 2 ** 63 - 1] exprStart = statementStart + 4;
    stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    if (stream.KindAt(statementStart + 3) == TokenKind.LBrack)
    {
        stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(statementStart + 3));
        if (closeBracket == (u32[0 max])(statementStart + 3)
            || (u64[0 2 ** 63 - 1])(closeBracket + 1) >= statementEnd
            || stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) != TokenKind.Assign)
        {
            return false;
        }

        if (stream.KindAt(statementStart + 4) == TokenKind.IntegerLiteral
            && closeBracket == (u32[0 max])(statementStart + 5))
        {
            if (!TryFindStructFixedArrayElementLayout(
                stream,
                source,
                objectLocal.TypeToken,
                (u32[0 max])(statementStart + 2),
                (u32[0 max])(statementStart + 4),
                fieldOffset,
                fieldAlignment,
                fieldType))
            {
                return false;
            }
        }
        else
        {
            stack mut u32[0 max] arrayLength = 0;
            if (!TryFindStructFixedArrayFieldLayout(
                stream,
                source,
                objectLocal.TypeToken,
                (u32[0 max])(statementStart + 2),
                fieldOffset,
                elementSize,
                fieldAlignment,
                fieldType,
                arrayLength))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
            stack ExprParseResult indexExpr = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, statementStart + 4);
            if (params.Count() != beforeIndex
                || indexExpr.NodeId == 0
                || indexExpr.Next != (u64[0 2 ** 63 - 1])closeBracket
                || TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) != ExprType.IntType
                || !SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, arrayLength))
            {
                return false;
            }

            indexRoot = indexExpr.NodeId;
        }

        exprStart = (u64[0 2 ** 63 - 1])closeBracket + 2;
        fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(fieldType);
    }
    else if (!TryFindStructFieldLayout(stream, source, declarations, enumLayouts, objectLocal.TypeToken, (u32[0 max])(statementStart + 2), fieldOffset, fieldAlignment, fieldType, fieldTypeCode))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, exprStart);
    if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != statementEnd)
    {
        return false;
    }

    if (!FieldInitializerExpressionMatchesTypeCode(fieldTypeCode, nodes, expr.NodeId, localTypes))
    {
        return false;
    }

    stack mut ConstructedObjectFieldAssignment assignment = new();
    assignment.ReceiverParamIndex = objectLocal.ParamIndex;
    assignment.FieldOffset = fieldOffset;
    assignment.IndexRoot = indexRoot;
    assignment.ElementSize = elementSize;
    assignment.FieldAlignment = fieldAlignment;
    assignment.FieldType = fieldType;
    assignment.FieldTypeCode = fieldTypeCode;
    assignment.ExprRoot = expr.NodeId;
    stack u32[0 max] added = assignments.Add(assignment);
    return added != 0;
}

internal fn bool LowerConstructedObjectFieldAssignment(
    ConstructedObjectFieldAssignment assignment,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    if (!localOverrides.Contains(assignment.ReceiverParamIndex + 1))
    {
        return false;
    }

    stack u32[0 max] basePointerValue = localOverrides.Get(assignment.ReceiverParamIndex + 1);
    if (basePointerValue == 0)
    {
        return false;
    }

    stack MirValueId basePointer = MirValueIdOf(basePointerValue);
    stack mut MirValueId fieldPointer = new();
    if (assignment.IndexRoot != 0)
    {
        stack MirValueId indexValue = LowerExprNodeAsTypeWithTypesAndLocals(nodes, assignment.IndexRoot, instrs, localTypes, localOverrides, MirType.I64);
        fieldPointer = MirPtrIndexOffset(instrs, basePointer, indexValue, assignment.ElementSize, assignment.FieldOffset, assignment.FieldAlignment);
    }
    else
    {
        fieldPointer = MirPtrOffset(instrs, basePointer, assignment.FieldOffset, assignment.FieldAlignment);
    }

    if (SourceResolvedFieldTypeCodeIsEnum(assignment.FieldTypeCode))
    {
        stack u32[0 max] ownerTypeIndex = SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(assignment.FieldTypeCode) + 1;
        stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, assignment.ExprRoot, instrs, localTypes, localOverrides);
        stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(ownerTypeIndex), fieldPointer, value, assignment.FieldAlignment);
    }
    else
    {
        stack MirValueId value = LowerExprNodeAsTypeWithTypesAndLocals(nodes, assignment.ExprRoot, instrs, localTypes, localOverrides, assignment.FieldType);
        stack MirValueId store = MirStorePtrAlignedTyped(instrs, assignment.FieldType, fieldPointer, value, assignment.FieldAlignment);
    }

    return true;
}

internal fn bool LowerConstructedObjectFieldAssignments(
    borrow IrTable<ConstructedObjectFieldAssignment> assignments,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack u64[0 2 ** 63 - 1] total = assignments.Count();
    stack mut u32[0 max] cursor = 1;
    while willexit ((u64[0 2 ** 63 - 1])cursor <= total)
    {
        stack ConstructedObjectFieldAssignment assignment = assignments.Get(cursor);
        if (!LowerConstructedObjectFieldAssignment(assignment, nodes, instrs, localTypes, localOverrides))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    return true;
}

internal fn bool LowerSourceStorageMutationStatements(
    borrow IrTable<SourceStorageMutationStatement> statements,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> objectAssignments,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack u64[0 2 ** 63 - 1] total = statements.Count();
    stack mut u32[0 max] cursor = 1;
    while willexit ((u64[0 2 ** 63 - 1])cursor <= total)
    {
        stack SourceStorageMutationStatement statement = statements.Get(cursor);
        if (statement.Kind == SourceStorageMutationKindScalar())
        {
            if (!scalarAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ScalarStorageAssignment assignment = scalarAssignments.Get(statement.AssignmentIndex);
            if (!LowerScalarStorageAssignment(assignment, nodes, instrs, localTypes, localOverrides))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindEnum())
        {
            if (!enumAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack EnumStorageAssignment assignment = enumAssignments.Get(statement.AssignmentIndex);
            if (!LowerEnumStorageAssignment(assignment, nodes, instrs, localTypes, localOverrides))
            {
                return false;
            }
        }
        else if (statement.Kind == SourceStorageMutationKindConstructedObjectField())
        {
            if (!objectAssignments.Contains(statement.AssignmentIndex))
            {
                return false;
            }

            stack ConstructedObjectFieldAssignment assignment = objectAssignments.Get(statement.AssignmentIndex);
            if (!LowerConstructedObjectFieldAssignment(assignment, nodes, instrs, localTypes, localOverrides))
            {
                return false;
            }
        }
        else
        {
            return false;
        }

        cursor = cursor + 1;
    }

    return true;
}

internal fn bool TryReadPositiveIntegerToken(borrow TokenStream stream, borrow i8[min max][] source, u64[0 2 ** 63 - 1] token, out u32[0 max] value)
{
    value = 0;
    if (stream.KindAt(token) != TokenKind.IntegerLiteral)
    {
        return false;
    }

    stack i64[min max] parsed = ParseDigitSpan(source, stream.StartAt(token), stream.LengthAt(token));
    if (parsed <= 0 || parsed > 4294967295)
    {
        return false;
    }

    value = (u32[0 max])parsed;
    return true;
}

internal fn bool TryReadNonNegativeIntegerToken(borrow TokenStream stream, borrow i8[min max][] source, u64[0 2 ** 63 - 1] token, out u32[0 max] value)
{
    value = 0;
    if (stream.KindAt(token) != TokenKind.IntegerLiteral)
    {
        return false;
    }

    stack i64[min max] parsed = ParseDigitSpan(source, stream.StartAt(token), stream.LengthAt(token));
    if (parsed < 0 || parsed > 4294967295)
    {
        return false;
    }

    value = (u32[0 max])parsed;
    return true;
}

internal fn bool TryParseArenaSelectorAllocation(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end,
    out u32[0 max] sizeBytes,
    out u32[0 max] alignBytes)
{
    sizeBytes = 0;
    alignBytes = 0;
    stack mut u64[0 2 ** 63 - 1] scan = start;
    while willexit (scan + 5 < end)
    {
        if (stream.KindAt(scan) == TokenKind.New
            && stream.KindAt(scan + 1) == TokenKind.LParen
            && stream.KindAt(scan + 2) == TokenKind.Arena
            && stream.KindAt(scan + 3) == TokenKind.Comma)
        {
            stack mut u32[0 max] size = 0;
            if (!TryReadPositiveIntegerToken(stream, source, scan + 4, size))
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] cursor = scan + 5;
            stack mut u32[0 max] alignment = NaturalAlignmentForByteExtent(size);
            if (stream.KindAt(cursor) == TokenKind.Comma)
            {
                if (!TryReadPositiveIntegerToken(stream, source, cursor + 1, alignment))
                {
                    return false;
                }

                cursor = cursor + 2;
            }

            if (stream.KindAt(cursor) != TokenKind.RParen)
            {
                return false;
            }

            if (!IsPowerOfTwoU32(alignment))
            {
                return false;
            }

            sizeBytes = size;
            alignBytes = alignment;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryParseArenaSelectorCapacity(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end,
    out u32[0 max] capacity,
    out u32[0 max] alignBytes)
{
    capacity = 0;
    alignBytes = 0;
    stack mut u64[0 2 ** 63 - 1] scan = start;
    while willexit (scan + 5 < end)
    {
        if (stream.KindAt(scan) == TokenKind.New
            && stream.KindAt(scan + 1) == TokenKind.LParen
            && stream.KindAt(scan + 2) == TokenKind.Arena
            && stream.KindAt(scan + 3) == TokenKind.Comma)
        {
            stack mut u32[0 max] parsedCapacity = 0;
            if (!TryReadPositiveIntegerToken(stream, source, scan + 4, parsedCapacity))
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] cursor = scan + 5;
            stack mut u32[0 max] parsedAlignment = 0;
            if (stream.KindAt(cursor) == TokenKind.Comma)
            {
                if (!TryReadPositiveIntegerToken(stream, source, cursor + 1, parsedAlignment))
                {
                    return false;
                }

                cursor = cursor + 2;
            }

            if (stream.KindAt(cursor) != TokenKind.RParen)
            {
                return false;
            }

            if (parsedAlignment != 0 && !IsPowerOfTwoU32(parsedAlignment))
            {
                return false;
            }

            capacity = parsedCapacity;
            alignBytes = parsedAlignment;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryParseTargetTypedObjectConstructor(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u64[0 2 ** 63 - 1] assignToken,
    u64[0 2 ** 63 - 1] end)
{
    if (typeToken == 0 || assignToken + 3 > end)
    {
        return false;
    }

    if (stream.KindAt(assignToken + 1) != TokenKind.New)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = assignToken + 2;
    if (stream.KindAt(cursor) == TokenKind.Identifier)
    {
        if (!TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])cursor, typeToken))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    if (cursor + 2 != end)
    {
        return false;
    }

    return stream.KindAt(cursor) == TokenKind.LParen
        && stream.KindAt(cursor + 1) == TokenKind.RParen;
}

internal fn bool TryParseTargetTypedObjectConstructorShape(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u64[0 2 ** 63 - 1] assignToken,
    u64[0 2 ** 63 - 1] end,
    out u32[0 max] bodyOpen,
    out u32[0 max] bodyClose)
{
    bodyOpen = 0;
    bodyClose = 0;
    if (typeToken == 0 || assignToken + 3 > end)
    {
        return false;
    }

    if (stream.KindAt(assignToken + 1) != TokenKind.New)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = assignToken + 2;
    if (stream.KindAt(cursor) == TokenKind.Identifier)
    {
        if (!TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])cursor, typeToken))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    if (stream.KindAt(cursor) != TokenKind.LParen || stream.KindAt(cursor + 1) != TokenKind.RParen)
    {
        return false;
    }

    cursor = cursor + 2;
    if (cursor == end)
    {
        return true;
    }

    if (cursor >= end || stream.KindAt(cursor) != TokenKind.LBrace)
    {
        return false;
    }

    stack u32[0 max] close = MatchingBraceForMirLowering(stream, (u32[0 max])cursor);
    if (close == (u32[0 max])cursor || (u64[0 2 ** 63 - 1])(close + 1) != end)
    {
        return false;
    }

    bodyOpen = (u32[0 max])cursor;
    bodyClose = close;
    return true;
}

internal fn bool TryParseTargetTypedPositionalRecordConstructorShape(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u64[0 2 ** 63 - 1] assignToken,
    u64[0 2 ** 63 - 1] end,
    out u32[0 max] argsOpen,
    out u32[0 max] argsClose)
{
    argsOpen = 0;
    argsClose = 0;
    if (typeToken == 0 || assignToken + 4 > end)
    {
        return false;
    }

    if (stream.KindAt(assignToken + 1) != TokenKind.New)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = assignToken + 2;
    if (stream.KindAt(cursor) == TokenKind.Identifier)
    {
        if (!TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])cursor, typeToken))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    if (stream.KindAt(cursor) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] close = MatchingParenForMirLowering(stream, (u32[0 max])cursor);
    if (close == (u32[0 max])cursor || (u64[0 2 ** 63 - 1])(close + 1) != end)
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])close == cursor + 1)
    {
        return false;
    }

    argsOpen = (u32[0 max])cursor;
    argsClose = close;
    return true;
}

internal fn u32[0 max] FindSelfHostedDynamicElementTypeToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, start, end);
    if (typeToken == 0)
    {
        return 0;
    }

    stack TokenKind typeKind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    if (typeKind != TokenKind.Dynamic && typeKind != TokenKind.Dyn)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] elementToken = (u64[0 2 ** 63 - 1])typeToken + 1;
    if (elementToken >= end || !TokenCanStartSelfHostedType(stream.KindAt(elementToken)))
    {
        return 0;
    }

    return (u32[0 max])elementToken;
}

internal struct ArenaDynamicLocal
{
    u64[0 2 ** 63 - 1] Start;
    u64[0 2 ** 63 - 1] Length;
    u32[0 max] StorageValue;
    u32[0 max] ElementSize;
    u32[0 max] Alignment;

    ArenaDynamicLocal()
    {
        self.Start = 0;
        self.Length = 0;
        self.StorageValue = 0;
        self.ElementSize = 0;
        self.Alignment = 0;
    }
}

internal fn bool TryFindArenaDynamicLocal(borrow IrTable<ArenaDynamicLocal> locals, borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] length, out ArenaDynamicLocal found)
{
    found = new();
    stack u64[0 2 ** 63 - 1] count = locals.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack ArenaDynamicLocal local = locals.Get(i);
        if (SpanEquals(source, local.Start, local.Length, start, length))
        {
            found = local;
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TryLowerArenaDynamicReserveStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ArenaDynamicLocal> arenaDynamicLocals,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end,
    mut borrow IrTable<MirInstruction> instrs)
{
    if (start + 6 != end
        || stream.KindAt(start) != TokenKind.Identifier
        || stream.KindAt(start + 1) != TokenKind.Dot
        || stream.KindAt(start + 2) != TokenKind.Identifier
        || stream.KindAt(start + 3) != TokenKind.LParen
        || stream.KindAt(start + 5) != TokenKind.RParen)
    {
        return false;
    }

    stack mut u32[0 max] amount = 0;
    if (!TryReadNonNegativeIntegerToken(stream, source, start + 4, amount))
    {
        return false;
    }

    stack mut ArenaDynamicLocal local = new();
    if (!TryFindArenaDynamicLocal(arenaDynamicLocals, source, stream.StartAt(start), stream.LengthAt(start), local))
    {
        return false;
    }

    stack u32[0 max] methodToken = (u32[0 max])(start + 2);
    stack MirValueId storage = MirValueIdOf(local.StorageValue);
    if (TokenTextIsReserveName(stream, source, methodToken))
    {
        stack MirValueId reserve = MirArenaDynamicStorageReserve(instrs, storage, amount, local.ElementSize, local.Alignment);
        return true;
    }

    if (TokenTextIsTryReserveName(stream, source, methodToken))
    {
        stack MirValueId reserve = MirArenaDynamicStorageTryReserve(instrs, storage, amount, local.ElementSize, local.Alignment);
        return true;
    }

    if (TokenTextIsTryReserveCapacityName(stream, source, methodToken))
    {
        stack MirValueId reserve = MirArenaDynamicStorageTryReserveCapacity(instrs, storage, amount, local.ElementSize, local.Alignment);
        return true;
    }

    return false;
}
