internal inline finite law u32[0 max] SourceStorageMutationKindScalar()
{
    return 1;
}

internal inline finite law u32[0 max] SourceStorageMutationKindConstructedObjectField()
{
    return 2;
}

internal inline finite law u32[0 max] SourceStorageMutationKindEnum()
{
    return 3;
}

internal struct SourceStorageMutationStatement
{
    u32[0 max] Kind;
    u32[0 max] AssignmentIndex;

    SourceStorageMutationStatement()
    {
        self.Kind = 0;
        self.AssignmentIndex = 0;
    }
}

internal fn bool FieldInitializerTypeMatches(MirType fieldType, ExprType exprType)
{
    if (fieldType == MirType.I1)
    {
        return exprType == ExprType.BoolType;
    }

    if (fieldType == MirType.Ptr)
    {
        return exprType == ExprType.PtrType;
    }

    return exprType == ExprType.IntType;
}

internal finite law bool FieldInitializerTypeCodeMatches(u32[0 max] fieldTypeCode, ExprType exprType)
{
    if (fieldTypeCode == SourceResolvedFieldTypeCodeBool())
    {
        return exprType == ExprType.BoolType;
    }

    if (fieldTypeCode == SourceResolvedFieldTypeCodePointer())
    {
        return exprType == ExprType.PtrType;
    }

    if (fieldTypeCode == SourceResolvedFieldTypeCodeI8()
        || fieldTypeCode == SourceResolvedFieldTypeCodeI16()
        || fieldTypeCode == SourceResolvedFieldTypeCodeI32()
        || fieldTypeCode == SourceResolvedFieldTypeCodeI64())
    {
        return exprType == ExprType.IntType;
    }

    if (SourceResolvedFieldTypeCodeIsEnum(fieldTypeCode))
    {
        return exprType == ExprType.EnumType;
    }

    return false;
}

internal fn bool FieldInitializerExpressionMatchesTypeCode(
    u32[0 max] fieldTypeCode,
    borrow IrTable<ExprNode> nodes,
    u32[0 max] exprRoot,
    borrow IrTable<u32[0 max]> localTypes)
{
    stack ExprType exprType = TypeOfNodeWithLocals(nodes, exprRoot, localTypes);
    if (!FieldInitializerTypeCodeMatches(fieldTypeCode, exprType))
    {
        return false;
    }

    if (!SourceResolvedFieldTypeCodeIsEnum(fieldTypeCode))
    {
        return true;
    }

    stack mut u32[0 max] exprOwnerTypeIndex = 0;
    return TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, exprRoot, localTypes, exprOwnerTypeIndex)
        && exprOwnerTypeIndex == SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(fieldTypeCode) + 1;
}

internal fn bool TryParseFixedArrayStorageInitializerRoots(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] arrayLength,
    u32[0 max] fieldTypeCode,
    u64[0 2 ** 63 - 1] initializerOpen,
    u64[0 2 ** 63 - 1] initializerClose,
    mut borrow IrTable<u32[0 max]> elementRoots)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(elementRoots, sourceValueFacts)
{
    if (stream.KindAt(initializerOpen) != TokenKind.LBrace
        || stream.KindAt(initializerClose) != TokenKind.RBrace
        || initializerClose < initializerOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = initializerOpen + 1;
    stack mut u32[0 max] elementIndex = 0;
    while willexit (cursor < initializerClose)
    {
        if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            return false;
        }

        if (elementIndex >= arrayLength)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] valueEnd = FindObjectInitializerEntryEnd(stream, cursor, initializerClose);
        if (valueEnd <= cursor)
        {
            return false;
        }

        stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            objectLocals,
            sliceDescriptorLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            cursor);
        if (expr.NodeId == 0
            || expr.Next != valueEnd
            || !FieldInitializerExpressionMatchesTypeCode(fieldTypeCode, nodes, expr.NodeId, localTypes)
            || elementRoots.Add(expr.NodeId) == 0)
        {
            return false;
        }

        elementIndex = elementIndex + 1;
        cursor = valueEnd;
        if (cursor < initializerClose)
        {
            if (stream.KindAt(cursor) != TokenKind.Comma)
            {
                return false;
            }

            cursor = cursor + 1;
            if (cursor == initializerClose)
            {
                return true;
            }
        }
    }

    return true;
}

internal finite law u64[0 max] SourceEnumStorageAlignTo(u64[0 max] value, u64[0 max] alignment)
{
    if (alignment <= 1)
    {
        return value;
    }

    stack u64[0 max] remainder = value % alignment;
    if (remainder == 0)
    {
        return value;
    }

    return value + (alignment - remainder);
}

internal fn bool TryGetSourceEnumStorageLayout(
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] ownerDeclarationIndex,
    out u32[0 max] sizeBytes,
    out u32[0 max] alignmentBytes)
{
    sizeBytes = 0;
    alignmentBytes = 1;
    stack mut bool seen = false;
    stack mut u64[0 max] maxEnd = 0;
    stack mut u64[0 max] maxAlignment = 1;
    stack u64[0 2 ** 63 - 1] count = enumLayouts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (enumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex)
        {
            if (!enumLayouts.HasConcreteLayoutAt(index))
            {
                return false;
            }

            stack u64[0 max] rowOffset = enumLayouts.OffsetBytesAt(index);
            stack u64[0 max] rowSize = enumLayouts.SizeBytesAt(index);
            stack u64[0 max] rowAlignment = enumLayouts.AlignmentBytesAt(index);
            if (rowAlignment == 0)
            {
                return false;
            }

            stack u64[0 max] rowEnd = rowOffset + rowSize;
            if (rowEnd > maxEnd)
            {
                maxEnd = rowEnd;
            }

            if (rowAlignment > maxAlignment)
            {
                maxAlignment = rowAlignment;
            }

            seen = true;
        }
    }

    stack u64[0 max] alignedSize = SourceEnumStorageAlignTo(maxEnd, maxAlignment);
    if (!seen
        || alignedSize == 0
        || alignedSize > 4294967295
        || maxAlignment > 4294967295)
    {
        return false;
    }

    sizeBytes = (u32[0 max])alignedSize;
    alignmentBytes = (u32[0 max])maxAlignment;
    return true;
}

internal fn bool TryBuildSourceValueFactsForNode(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] nodeId,
    borrow IrTable<ValueFacts> sourceValueFacts,
    out ValueFacts facts)
    where overlap(nodes, sourceValueFacts)
{
    facts = new();
    if (!nodes.Contains(nodeId))
    {
        return false;
    }

    stack ExprNode node = nodes.Get(nodeId);
    switch (node.Kind)
    {
        case Compiler.Mir.SourceExpressions.ExprKind.IntLitExpr:
            stack mut ValueFacts literalFacts = new();
            if (!TrySetSingleValueIntegerRange(literalFacts, node.Imm))
            {
                return false;
            }

            facts = literalFacts;
            return true;
        case Compiler.Mir.SourceExpressions.ExprKind.BoolLitExpr:
            stack mut ValueFacts boolFacts = new();
            boolFacts.SetIntegerRange(node.Imm, node.Imm + 1);
            facts = boolFacts;
            return true;
        case Compiler.Mir.SourceExpressions.ExprKind.NameExpr:
            if (!sourceValueFacts.Contains(node.Left + 1))
            {
                return false;
            }

            facts = sourceValueFacts.Get(node.Left + 1);
            return facts.HasIntegerRange();
        case Compiler.Mir.SourceExpressions.ExprKind.BinaryExpr:
            stack mut ValueFacts leftFacts = new();
            stack mut ValueFacts rightFacts = new();
            if (!TryBuildSourceValueFactsForNode(nodes, node.Left, sourceValueFacts, leftFacts)
                || !TryBuildSourceValueFactsForNode(nodes, node.Right, sourceValueFacts, rightFacts))
            {
                return false;
            }

            if (node.Op == TokenKind.Minus)
            {
                stack mut ValueFacts subFacts = new();
                if (!TryBuildSubRangeFacts(leftFacts, rightFacts, subFacts))
                {
                    return false;
                }

                facts = subFacts;
                return true;
            }

            if (node.Op == TokenKind.Star)
            {
                stack mut ValueFacts mulFacts = new();
                if (!TryBuildMulRangeFacts(leftFacts, rightFacts, mulFacts))
                {
                    return false;
                }

                facts = mulFacts;
                return true;
            }

            if (node.Op == TokenKind.Plus)
            {
                stack mut ValueFacts addFacts = new();
                if (!TryBuildAddRangeFacts(leftFacts, rightFacts, addFacts))
                {
                    return false;
                }

                facts = addFacts;
                return true;
            }

            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.CompareExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.EnumVariantExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.EnumPayloadExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.CallExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.CallArgLinkExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.FieldExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.IndexedFieldExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.FixedArrayParamElementExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.RawPointerIndexedElementExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.RawPointerFieldExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.AddressOfExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.DerefExpr:
            return false;
        case Compiler.Mir.SourceExpressions.ExprKind.TryExpr:
            return false;
    }
}

internal fn bool SourceIndexNodeProvesFixedArrayBounds(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] indexNode,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u32[0 max] arrayLength)
    where overlap(nodes, sourceValueFacts)
{
    stack mut ValueFacts indexFacts = new();
    if (arrayLength == 0 || !TryBuildSourceValueFactsForNode(nodes, indexNode, sourceValueFacts, indexFacts))
    {
        return false;
    }

    if (!indexFacts.HasIntegerRange())
    {
        return false;
    }

    stack i64[min max] lower = indexFacts.IntegerRangeLower();
    stack i64[min max] upperExclusive = indexFacts.IntegerRangeUpperExclusive();
    return lower >= 0
        && upperExclusive > 0
        && upperExclusive <= (i64[min max])arrayLength;
}

internal fn bool SourceIndexNodeProvesRawPointerBounds(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] indexNode,
    borrow IrTable<ValueFacts> sourceValueFacts,
    ParamName pointerParam)
    where overlap(nodes, sourceValueFacts)
{
    if (!pointerParam.RawPointerHasElementCountValue())
    {
        return false;
    }

    if (!pointerParam.RawPointerElementCountIsParamValue())
    {
        return SourceIndexNodeProvesFixedArrayBounds(
            nodes,
            indexNode,
            sourceValueFacts,
            pointerParam.RawPointerElementCountLiteralValue());
    }

    stack u32[0 max] countParamIndex = pointerParam.RawPointerElementCountParamIndexValue();
    if (!sourceValueFacts.Contains(countParamIndex + 1))
    {
        return false;
    }

    stack mut ValueFacts indexFacts = new();
    if (!TryBuildSourceValueFactsForNode(nodes, indexNode, sourceValueFacts, indexFacts)
        || !indexFacts.HasIntegerRange())
    {
        return false;
    }

    stack ValueFacts countFacts = sourceValueFacts.Get(countParamIndex + 1);
    if (!countFacts.HasIntegerRange())
    {
        return false;
    }

    stack i64[min max] indexLower = indexFacts.IntegerRangeLower();
    stack i64[min max] indexUpperExclusive = indexFacts.IntegerRangeUpperExclusive();
    stack i64[min max] countLower = countFacts.IntegerRangeLower();
    return indexLower >= 0
        && indexUpperExclusive > 0
        && countLower >= 0
        && indexUpperExclusive <= countLower;
}

internal fn bool StatementStartsConstructedObjectFieldAssignment(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    if (start + 4 < end
        && stream.KindAt(start) == TokenKind.Identifier
        && stream.KindAt(start + 1) == TokenKind.Dot
        && stream.KindAt(start + 2) == TokenKind.Identifier
        && stream.KindAt(start + 3) == TokenKind.Assign)
    {
        return true;
    }

    if (start + 6 < end
        && stream.KindAt(start) == TokenKind.Identifier
        && stream.KindAt(start + 1) == TokenKind.Dot
        && stream.KindAt(start + 2) == TokenKind.Identifier
        && stream.KindAt(start + 3) == TokenKind.LBrack)
    {
        stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(start + 3));
        return closeBracket != (u32[0 max])(start + 3)
            && (u64[0 2 ** 63 - 1])(closeBracket + 1) < end
            && stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) == TokenKind.Assign;
    }

    if (start + 6 < end
        && stream.KindAt(start) == TokenKind.Identifier
        && stream.KindAt(start + 1) == TokenKind.Dot
        && stream.KindAt(start + 2) == TokenKind.Identifier
        && stream.KindAt(start + 3) == TokenKind.Dot)
    {
        stack mut u64[0 2 ** 63 - 1] scan = start + 3;
        while willexit (stream.KindAt(scan) == TokenKind.Dot
            && stream.KindAt(scan + 1) == TokenKind.Identifier)
        {
            scan = scan + 2;
        }

        if (scan < end && stream.KindAt(scan) == TokenKind.Assign)
        {
            return true;
        }

        if (scan < end && stream.KindAt(scan) == TokenKind.LBrack)
        {
            stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])scan);
            return closeBracket != (u32[0 max])scan
                && (u64[0 2 ** 63 - 1])(closeBracket + 1) < end
                && stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) == TokenKind.Assign;
        }

        return false;
    }

    return false;
}

internal fn bool StatementStartsScalarStorageAssignment(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    return start + 2 < end
        && stream.KindAt(start) == TokenKind.Identifier
        && stream.KindAt(start + 1) == TokenKind.Assign;
}

internal fn bool StatementStartsRawPointerDerefAssignment(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    return start + 3 < end
        && stream.KindAt(start) == TokenKind.Star;
}

internal fn bool StatementStartsSourceSliceElementAssignment(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    if (start + 4 >= end
        || stream.KindAt(start) != TokenKind.Identifier
        || stream.KindAt(start + 1) != TokenKind.LBrack)
    {
        return false;
    }

    stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(start + 1));
    return closeBracket != (u32[0 max])(start + 1)
        && (u64[0 2 ** 63 - 1])(closeBracket + 1) < end
        && stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) == TokenKind.Assign;
}

