public fn bool TryResolveSourceTryPropagationRoleFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] ownerDeclarationIndex,
    out SourceTryPropagationRoleFacts facts)
{
    facts = new();
    stack mut SourceTryPropagationRoleFacts resolved = new();
    stack mut bool okSeen = false;
    stack mut bool errSeen = false;
    stack mut u32[0 max] variantRows = 0;

    stack u64[0 2 ** 63 - 1] count = enumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (enumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && enumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Variant)
        {
            variantRows = variantRows + 1;
            if (variantRows > 2)
            {
                return false;
            }

            stack u32[0 max] payloadCount = enumLayouts.PayloadCountAt(index);
            if (payloadCount > 1)
            {
                return false;
            }

            stack mut u32[0 max] payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (payloadCount == 1
                && !TryGetSourceEnumPayloadTypeCode(
                    stream,
                    source,
                    declarations,
                    enumLayouts,
                    ownerDeclarationIndex,
                    enumLayouts.VariantOrdinalAt(index),
                    0,
                    payloadTypeCode))
            {
                return false;
            }

            stack TypedEnumVariantRole role = enumLayouts.VariantRoleAt(index);
            if (role == TypedEnumVariantRole.Ok)
            {
                if (okSeen)
                {
                    return false;
                }

                okSeen = true;
                resolved.OkVariantOrdinalValue = enumLayouts.VariantOrdinalAt(index);
                resolved.OkVariantTagValue = enumLayouts.VariantTagAt(index);
                resolved.OkPayloadCountValue = payloadCount;
                resolved.OkPayloadTypeCodeValue = payloadTypeCode;
            }
            else if (role == TypedEnumVariantRole.Err)
            {
                if (errSeen)
                {
                    return false;
                }

                errSeen = true;
                resolved.ErrVariantOrdinalValue = enumLayouts.VariantOrdinalAt(index);
                resolved.ErrVariantTagValue = enumLayouts.VariantTagAt(index);
                resolved.ErrPayloadCountValue = payloadCount;
                resolved.ErrPayloadTypeCodeValue = payloadTypeCode;
            }
            else
            {
                return false;
            }
        }

        index = index + 1;
    }

    if (variantRows != 2 || !okSeen || !errSeen)
    {
        return false;
    }

    resolved.ValidValue = true;
    facts = resolved;
    return true;
}

public fn bool TryLowerSameFamilySourceTryPropagation(
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    borrow SourceTryPropagationCompatibilityFacts facts,
    MirValueId operandValue,
    u32[0 max] operandOwnerDeclarationIndex,
    u32[0 max] returnOwnerDeclarationIndex,
    MirBlockId continuationTarget,
    u32[0 max] entryFirst,
    MirType tagType,
    bool recordRanges,
    out SourceTryPropagationLoweringResult result)
{
    result = new();
    if (!facts.IsValid()
        || !operandValue.IsValid()
        || !continuationTarget.IsValid()
        || facts.ErrorCompatibilityKind() == SourceTryPropagationErrorCompatibilityKind.Invalid)
    {
        return false;
    }

    stack SourceTryPropagationRoleFacts operandRoles = facts.OperandRoles();
    stack SourceTryPropagationRoleFacts returnRoles = facts.ReturnRoles();
    if (!operandRoles.IsValid() || !returnRoles.IsValid())
    {
        return false;
    }

    stack TypeId operandOwnerType = TypeIdOf(operandOwnerDeclarationIndex + 1);
    stack TypeId returnOwnerType = TypeIdOf(returnOwnerDeclarationIndex + 1);
    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack MirValueId tagValue = MirEnumTagRead(instrs, operandOwnerType, operandValue, tagType);
    stack MirValueId errTagValue = MirConstIntTyped(instrs, tagType, (i64[min max])operandRoles.ErrVariantTag());
    stack MirValueId isErr = MirCmpEq(instrs, tagValue, errTagValue);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] errorFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId errorReturn = operandValue;
    if (operandOwnerDeclarationIndex != returnOwnerDeclarationIndex)
    {
        errorReturn = MirEnumVariantTag(instrs, returnOwnerType, returnRoles.ErrVariantOrdinal());
        if (facts.ErrorCompatibilityKind() == SourceTryPropagationErrorCompatibilityKind.SameFailurePayloadType)
        {
            stack MirType failurePayloadType = MirTypeForResolvedFieldTypeCode(operandRoles.ErrPayloadTypeCode());
            stack MirValueId failurePayload = MirEnumPayloadExtract(
                instrs,
                operandOwnerType,
                operandRoles.ErrVariantOrdinal(),
                0,
                operandValue,
                failurePayloadType);
            errorReturn = MirEnumPayloadInsert(
                instrs,
                returnOwnerType,
                returnRoles.ErrVariantOrdinal(),
                0,
                errorReturn,
                failurePayload);
        }
        else if (facts.ErrorCompatibilityKind() == SourceTryPropagationErrorCompatibilityKind.FunnelFailurePayloadType)
        {
            stack TypeId funnelOwnerType = TypeIdOf(facts.ErrorFunnelOwnerDeclarationIndex() + 1);
            stack MirType failurePayloadType = MirTypeForResolvedFieldTypeCode(operandRoles.ErrPayloadTypeCode());
            stack MirValueId failurePayload = MirEnumPayloadExtract(
                instrs,
                operandOwnerType,
                operandRoles.ErrVariantOrdinal(),
                0,
                operandValue,
                failurePayloadType);
            stack MirValueId funnelTag = MirEnumVariantTag(
                instrs,
                funnelOwnerType,
                facts.ErrorFunnelVariantOrdinal());
            stack MirValueId funnelValue = MirEnumPayloadInsert(
                instrs,
                funnelOwnerType,
                facts.ErrorFunnelVariantOrdinal(),
                0,
                funnelTag,
                failurePayload);
            errorReturn = MirEnumPayloadInsert(
                instrs,
                returnOwnerType,
                returnRoles.ErrVariantOrdinal(),
                0,
                errorReturn,
                funnelValue);
        }
    }

    stack u32[0 max] errorCount = (u32[0 max])instrs.Count() - (errorFirst - 1);
    stack u32[0 max] continueFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId successValue = MirConstIntTyped(instrs, tagType, 0);
    if (operandRoles.OkPayloadCount() == 1)
    {
        stack MirType successPayloadType = MirTypeForResolvedFieldTypeCode(operandRoles.OkPayloadTypeCode());
        successValue = MirEnumPayloadExtract(
            instrs,
            operandOwnerType,
            operandRoles.OkVariantOrdinal(),
            0,
            operandValue,
            successPayloadType);
    }

    stack u32[0 max] continueCount = (u32[0 max])instrs.Count() - (continueFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, isErr, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack MirBlockId errorBlock = MirReturnBlock(blocks, errorReturn);
    stack MirBlockId continueBlock = MirBranchBlock(blocks, continuationTarget);

    if (recordRanges)
    {
        stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] errorRange = ranges.Add(MakeBlockEmit(errorBlock.Index(), errorFirst, errorCount));
        stack u32[0 max] continueRange = ranges.Add(MakeBlockEmit(continueBlock.Index(), continueFirst, continueCount));
        if (entryRange == 0 || errorRange == 0 || continueRange == 0)
        {
            return false;
        }
    }

    stack mut SourceTryPropagationLoweringResult lowered = new();
    lowered.ValidValue = true;
    lowered.EntryBlockValue = entry;
    lowered.ErrorBlockValue = errorBlock;
    lowered.ContinueBlockValue = continueBlock;
    lowered.ConditionValue = isErr;
    lowered.ErrorReturnValue = errorReturn;
    lowered.SuccessValueValue = successValue;
    result = lowered;
    return true;
}

internal fn bool SourceLocalAsciiTokenTextEqualsToken(
    borrow TokenStream stream,
    ascii source,
    u32[0 max] left,
    u32[0 max] right)
{
    stack ascii leftText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])left);
    stack ascii rightText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])right);
    return System.Text.Equals(leftText, rightText);
}

internal fn bool TryGetSourceEnumOwnerDeclarationForAsciiToken(
    borrow TokenStream stream,
    ascii source,
    borrow Compiler.Parsing.DeclarationList declarations,
    u32[0 max] ownerToken,
    out u32[0 max] ownerDeclarationIndex,
    out Compiler.Parsing.DeclItem enumItem)
{
    ownerDeclarationIndex = 0;
    enumItem = new();

    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack Compiler.Parsing.DeclItem item = declarations.ItemAt(index);
        if (item.Kind == Compiler.Parsing.DeclarationKind.Enum
            && item.NameToken != 0
            && SourceLocalAsciiTokenTextEqualsToken(stream, source, ownerToken, item.NameToken))
        {
            ownerDeclarationIndex = (u32[0 max])index;
            enumItem = item;
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool SourceLocalTypeSpansCompatible(
    borrow TokenStream stream,
    ascii source,
    u32[0 max] leftStart,
    u32[0 max] leftEnd,
    u32[0 max] rightStart,
    u32[0 max] rightEnd)
{
    if (leftStart >= leftEnd || rightStart >= rightEnd)
    {
        return leftStart >= leftEnd && rightStart >= rightEnd;
    }

    stack u32[0 max] leftLength = (u32[0 max])(leftEnd - leftStart);
    stack u32[0 max] rightLength = (u32[0 max])(rightEnd - rightStart);
    if (leftLength != rightLength)
    {
        return false;
    }

    stack mut u32[0 max] offset = 0;
    while willexit (offset < leftLength)
    {
        stack u32[0 max] left = (u32[0 max])(leftStart + offset);
        stack u32[0 max] right = (u32[0 max])(rightStart + offset);
        if (stream.KindAt((u64[0 2 ** 63 - 1])left) != stream.KindAt((u64[0 2 ** 63 - 1])right)
            || !SourceLocalAsciiTokenTextEqualsToken(stream, source, left, right))
        {
            return false;
        }

        offset = (u32[0 max])(offset + 1);
    }

    return true;
}

internal fn bool TryGetSourceTryPayloadTypeSpan(
    borrow TypedEnumPayloadTable enumPayloads,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    out TypedSignatureTypeKind payloadTypeKind,
    out u32[0 max] payloadTypeHeadToken,
    out u32[0 max] payloadTypeStartToken,
    out u32[0 max] payloadTypeEndToken)
{
    payloadTypeKind = TypedSignatureTypeKind.Unknown;
    payloadTypeHeadToken = 0;
    payloadTypeStartToken = 0;
    payloadTypeEndToken = 0;

    stack u64[0 2 ** 63 - 1] count = enumPayloads.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (enumPayloads.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && enumPayloads.VariantOrdinalAt(index) == variantOrdinal
            && enumPayloads.PayloadOrdinalAt(index) == payloadOrdinal)
        {
            payloadTypeKind = enumPayloads.TypeKindAt(index);
            payloadTypeHeadToken = enumPayloads.TypeHeadTokenAt(index);
            payloadTypeStartToken = enumPayloads.TypeStartTokenAt(index);
            payloadTypeEndToken = enumPayloads.TypeEndTokenAt(index);
            return payloadTypeStartToken != 0 && payloadTypeStartToken < payloadTypeEndToken;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool TryGetSourceTryVariantTag(
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    out u32[0 max] variantTag)
{
    variantTag = 0;
    stack u64[0 2 ** 63 - 1] count = enumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (enumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && enumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Variant
            && enumLayouts.VariantOrdinalAt(index) == variantOrdinal)
        {
            variantTag = enumLayouts.VariantTagAt(index);
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool TryResolveSourceTryErrorFunnelVariant(
    borrow TokenStream stream,
    ascii source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    borrow TypedEnumPayloadTable enumPayloads,
    u32[0 max] enclosingFailureTypeHeadToken,
    u32[0 max] operandFailureTypeStartToken,
    u32[0 max] operandFailureTypeEndToken,
    out u32[0 max] funnelOwnerDeclarationIndex,
    out u32[0 max] funnelVariantOrdinal,
    out u32[0 max] funnelVariantTag)
{
    funnelOwnerDeclarationIndex = 0;
    funnelVariantOrdinal = 0;
    funnelVariantTag = 0;

    if (enclosingFailureTypeHeadToken == 0)
    {
        return false;
    }

    stack mut Compiler.Parsing.DeclItem ignoredOwner = new();
    stack mut u32[0 max] resolvedFunnelOwnerDeclarationIndex = 0;
    if (!TryGetSourceEnumOwnerDeclarationForAsciiToken(
        stream,
        source,
        declarations,
        enclosingFailureTypeHeadToken,
        resolvedFunnelOwnerDeclarationIndex,
        ignoredOwner))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = enumPayloads.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (enumPayloads.OwnerDeclarationIndexAt(index) == resolvedFunnelOwnerDeclarationIndex
            && enumPayloads.IsErrorFunnelAt(index)
            && SourceLocalTypeSpansCompatible(
                stream,
                source,
                enumPayloads.TypeStartTokenAt(index),
                enumPayloads.TypeEndTokenAt(index),
                operandFailureTypeStartToken,
                operandFailureTypeEndToken))
        {
            stack mut u32[0 max] resolvedFunnelVariantOrdinal = enumPayloads.VariantOrdinalAt(index);
            stack mut u32[0 max] resolvedFunnelVariantTag = 0;
            if (!TryGetSourceTryVariantTag(
                enumLayouts,
                resolvedFunnelOwnerDeclarationIndex,
                resolvedFunnelVariantOrdinal,
                resolvedFunnelVariantTag))
            {
                return false;
            }

            funnelOwnerDeclarationIndex = resolvedFunnelOwnerDeclarationIndex;
            funnelVariantOrdinal = resolvedFunnelVariantOrdinal;
            funnelVariantTag = resolvedFunnelVariantTag;
            return true;
        }

        index = index + 1;
    }

    return false;
}

public fn bool TryResolveSourceTryPropagationCompatibility(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    borrow TypedEnumPayloadTable enumPayloads,
    u32[0 max] operandOwnerDeclarationIndex,
    u32[0 max] returnOwnerDeclarationIndex,
    out SourceTryPropagationCompatibilityFacts facts)
    where overlap(sourceText, source)
{
    facts = new();

    stack mut SourceTryPropagationRoleFacts operandRoles = new();
    if (!TryResolveSourceTryPropagationRoleFacts(stream, source, declarations, enumLayouts, operandOwnerDeclarationIndex, operandRoles))
    {
        return false;
    }

    stack mut SourceTryPropagationRoleFacts returnRoles = new();
    if (!TryResolveSourceTryPropagationRoleFacts(stream, source, declarations, enumLayouts, returnOwnerDeclarationIndex, returnRoles))
    {
        return false;
    }

    stack mut SourceTryPropagationCompatibilityFacts resolved = new();
    resolved.OperandRolesValue = operandRoles;
    resolved.ReturnRolesValue = returnRoles;

    if (operandRoles.ErrPayloadCount() == 0 && returnRoles.ErrPayloadCount() == 0)
    {
        resolved.ValidValue = true;
        resolved.ErrorCompatibilityKindValue = SourceTryPropagationErrorCompatibilityKind.UnitFailure;
        facts = resolved;
        return true;
    }

    if (operandRoles.ErrPayloadCount() != 1 || returnRoles.ErrPayloadCount() != 1)
    {
        return false;
    }

    stack mut TypedSignatureTypeKind operandFailureTypeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] operandFailureTypeHeadToken = 0;
    stack mut u32[0 max] operandFailureTypeStartToken = 0;
    stack mut u32[0 max] operandFailureTypeEndToken = 0;
    if (!TryGetSourceTryPayloadTypeSpan(
        enumPayloads,
        operandOwnerDeclarationIndex,
        operandRoles.ErrVariantOrdinal(),
        0,
        operandFailureTypeKind,
        operandFailureTypeHeadToken,
        operandFailureTypeStartToken,
        operandFailureTypeEndToken))
    {
        return false;
    }

    stack mut TypedSignatureTypeKind returnFailureTypeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] returnFailureTypeHeadToken = 0;
    stack mut u32[0 max] returnFailureTypeStartToken = 0;
    stack mut u32[0 max] returnFailureTypeEndToken = 0;
    if (!TryGetSourceTryPayloadTypeSpan(
        enumPayloads,
        returnOwnerDeclarationIndex,
        returnRoles.ErrVariantOrdinal(),
        0,
        returnFailureTypeKind,
        returnFailureTypeHeadToken,
        returnFailureTypeStartToken,
        returnFailureTypeEndToken))
    {
        return false;
    }

    if (operandFailureTypeKind == returnFailureTypeKind
        && SourceLocalTypeSpansCompatible(
            stream,
            sourceText,
            operandFailureTypeStartToken,
            operandFailureTypeEndToken,
            returnFailureTypeStartToken,
            returnFailureTypeEndToken))
    {
        resolved.ValidValue = true;
        resolved.ErrorCompatibilityKindValue = SourceTryPropagationErrorCompatibilityKind.SameFailurePayloadType;
        facts = resolved;
        return true;
    }

    if (returnFailureTypeKind != TypedSignatureTypeKind.Named)
    {
        return false;
    }

    stack mut u32[0 max] funnelOwnerDeclarationIndex = 0;
    stack mut u32[0 max] funnelVariantOrdinal = 0;
    stack mut u32[0 max] funnelVariantTag = 0;
    if (!TryResolveSourceTryErrorFunnelVariant(
        stream,
        sourceText,
        declarations,
        enumLayouts,
        enumPayloads,
        returnFailureTypeHeadToken,
        operandFailureTypeStartToken,
        operandFailureTypeEndToken,
        funnelOwnerDeclarationIndex,
        funnelVariantOrdinal,
        funnelVariantTag))
    {
        return false;
    }

    resolved.ValidValue = true;
    resolved.ErrorCompatibilityKindValue = SourceTryPropagationErrorCompatibilityKind.FunnelFailurePayloadType;
    resolved.ErrorFunnelOwnerDeclarationIndexValue = funnelOwnerDeclarationIndex;
    resolved.ErrorFunnelVariantOrdinalValue = funnelVariantOrdinal;
    resolved.ErrorFunnelVariantTagValue = funnelVariantTag;
    facts = resolved;
    return true;
}

internal fn bool TryGetSourceEnumPayloadTypeCode(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    out u32[0 max] payloadTypeCode)
{
    payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();

    stack u64[0 2 ** 63 - 1] count = enumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (enumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && enumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Payload
            && enumLayouts.VariantOrdinalAt(index) == variantOrdinal
            && enumLayouts.PayloadOrdinalAt(index) == payloadOrdinal)
        {
            payloadTypeCode = SourceResolvedFieldTypeCodeForTypedEnumPayload(enumLayouts.TypeKindAt(index), enumLayouts.BitWidthAt(index));
            if (payloadTypeCode != SourceResolvedFieldTypeCodeInvalid())
            {
                return true;
            }

            stack mut MirType ignoredFieldType = MirType.I64;
            return TryGetSourceValueTypeCodeWithEnums(
                stream,
                source,
                declarations,
                enumLayouts,
                enumLayouts.TypePrimaryTokenAt(index),
                ignoredFieldType,
                payloadTypeCode);
        }

        index = index + 1;
    }

    return false;
}

internal fn bool TryGetSourceNamedEnumPayloadTypeCode(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadNameToken,
    out u32[0 max] payloadOrdinal,
    out u32[0 max] payloadTypeCode)
{
    payloadOrdinal = 0;
    payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();

    stack u64[0 2 ** 63 - 1] count = enumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] rowPayloadNameToken = enumLayouts.PayloadNameTokenAt(index);
        if (enumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && enumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Payload
            && enumLayouts.VariantOrdinalAt(index) == variantOrdinal
            && enumLayouts.UsesNamedPayloadsAt(index)
            && rowPayloadNameToken != 0
            && SourceLocalTokenTextEqualsToken(stream, source, payloadNameToken, rowPayloadNameToken))
        {
            payloadOrdinal = enumLayouts.PayloadOrdinalAt(index);
            payloadTypeCode = SourceResolvedFieldTypeCodeForTypedEnumPayload(enumLayouts.TypeKindAt(index), enumLayouts.BitWidthAt(index));
            if (payloadTypeCode != SourceResolvedFieldTypeCodeInvalid())
            {
                return true;
            }

            stack mut MirType ignoredFieldType = MirType.I64;
            return TryGetSourceValueTypeCodeWithEnums(
                stream,
                source,
                declarations,
                enumLayouts,
                enumLayouts.TypePrimaryTokenAt(index),
                ignoredFieldType,
                payloadTypeCode);
        }

        index = index + 1;
    }

    return false;
}

internal fn bool SourceEnumPayloadOrdinalListContains(
    borrow IrTable<u32[0 max]> payloadOrdinals,
    u32[0 max] payloadOrdinal)
{
    stack u64[0 2 ** 63 - 1] count = payloadOrdinals.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (payloadOrdinals.Get((u32[0 max])(index + 1)) == payloadOrdinal)
        {
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal finite law bool SourceExpressionTypeMatchesEnumPayloadTypeCode(ExprType exprType, u32[0 max] payloadTypeCode)
{
    if (payloadTypeCode == SourceResolvedFieldTypeCodeBool())
    {
        return exprType == ExprType.BoolType;
    }

    if (payloadTypeCode == SourceResolvedFieldTypeCodeI8()
        || payloadTypeCode == SourceResolvedFieldTypeCodeI16()
        || payloadTypeCode == SourceResolvedFieldTypeCodeI32()
        || payloadTypeCode == SourceResolvedFieldTypeCodeI64())
    {
        return exprType == ExprType.IntType;
    }

    if (SourceResolvedFieldTypeCodeIsEnum(payloadTypeCode))
    {
        return exprType == ExprType.EnumType;
    }

    return false;
}

internal fn ExprParseResult TryParseSourceEnumConstructorPrimaryIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    if (stream.KindAt(cursor) != TokenKind.Identifier
        || stream.KindAt(cursor + 1) != TokenKind.Dot
        || stream.KindAt(cursor + 2) != TokenKind.Identifier)
    {
        return MakeParseResult(0, cursor);
    }

    stack mut u32[0 max] ownerDeclarationIndex = 0;
    stack mut Compiler.Parsing.DeclItem enumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(stream, source, declarations, (u32[0 max])cursor, ownerDeclarationIndex, enumItem))
    {
        return MakeParseResult(0, cursor);
    }

    stack mut u32[0 max] variantOrdinal = 0;
    if (!TryGetSourceEnumVariantOrdinalForToken(stream, source, enumItem, (u32[0 max])(cursor + 2), variantOrdinal))
    {
        return MakeParseResult(0, cursor);
    }

    stack mut u64[0 max] payloadCount = 0;
    if (!enumLayouts.TryGetEnumVariantPayloadCount(ownerDeclarationIndex, variantOrdinal, payloadCount))
    {
        return MakeParseResult(0, cursor);
    }

    stack TypeId ownerType = TypeIdOf(ownerDeclarationIndex + 1);
    stack u32[0 max] enumValue = MakeEnumVariant(nodes, ownerType, variantOrdinal);
    if (payloadCount == 0)
    {
        return MakeParseResult(enumValue, cursor + 3);
    }

    if (stream.KindAt(cursor + 3) == TokenKind.LBrace)
    {
        stack mut u64[0 2 ** 63 - 1] fieldCursor = cursor + 4;
        stack mut u32[0 max] currentEnumValue = enumValue;
        stack mut IrTable<u32[0 max]> seenPayloadOrdinals = new();
        while willexit (stream.KindAt(fieldCursor) != TokenKind.RBrace)
        {
            if (stream.KindAt(fieldCursor) != TokenKind.Identifier
                || stream.KindAt(fieldCursor + 1) != TokenKind.Colon)
            {
                return MakeParseResult(0, cursor);
            }

            stack mut u32[0 max] payloadOrdinal = 0;
            stack mut u32[0 max] payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!TryGetSourceNamedEnumPayloadTypeCode(
                    stream,
                    source,
                    declarations,
                    enumLayouts,
                    ownerDeclarationIndex,
                    variantOrdinal,
                    (u32[0 max])fieldCursor,
                    payloadOrdinal,
                    payloadTypeCode)
                || SourceEnumPayloadOrdinalListContains(seenPayloadOrdinals, payloadOrdinal)
                || seenPayloadOrdinals.Add(payloadOrdinal) == 0)
            {
                return MakeParseResult(0, cursor);
            }

            stack ExprParseResult payloadExpr = ParseConstructedObjectExprWithEnumsIn(
                stream,
                source,
                nodes,
                params,
                funcNames,
                objectLocals,
                localTypes,
                sourceValueFacts,
                declarations,
                enumLayouts,
                fieldCursor + 2);
            if (payloadExpr.NodeId == 0
                || !SourceExpressionTypeMatchesEnumPayloadTypeCode(TypeOfNodeWithLocals(nodes, payloadExpr.NodeId, localTypes), payloadTypeCode))
            {
                return MakeParseResult(0, cursor);
            }

            currentEnumValue = MakeEnumPayloadInsert(nodes, ownerType, variantOrdinal, payloadOrdinal, currentEnumValue, payloadExpr.NodeId, payloadTypeCode);
            fieldCursor = payloadExpr.Next;
            if (stream.KindAt(fieldCursor) == TokenKind.Comma)
            {
                fieldCursor = fieldCursor + 1;
            }
            else if (stream.KindAt(fieldCursor) != TokenKind.RBrace)
            {
                return MakeParseResult(0, cursor);
            }
        }

        if (seenPayloadOrdinals.Count() != payloadCount)
        {
            return MakeParseResult(0, cursor);
        }

        return MakeParseResult(currentEnumValue, fieldCursor + 1);
    }

    if (stream.KindAt(cursor + 3) != TokenKind.LParen)
    {
        return MakeParseResult(0, cursor);
    }

    stack mut u64[0 2 ** 63 - 1] argCursor = cursor + 4;
    stack mut u32[0 max] payloadOrdinal = 0;
    stack mut u32[0 max] currentEnumValue = enumValue;
    while willexit ((u64[0 max])payloadOrdinal < payloadCount)
    {
        if (payloadOrdinal > 0)
        {
            if (stream.KindAt(argCursor) != TokenKind.Comma)
            {
                return MakeParseResult(0, cursor);
            }

            argCursor = argCursor + 1;
        }

        stack ExprParseResult payloadExpr = ParseConstructedObjectExprWithEnumsIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            objectLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            argCursor);
        if (payloadExpr.NodeId == 0)
        {
            return MakeParseResult(0, cursor);
        }

        stack mut u32[0 max] payloadTypeCode = SourceResolvedFieldTypeCodeInvalid();
        if (!TryGetSourceEnumPayloadTypeCode(stream, source, declarations, enumLayouts, ownerDeclarationIndex, variantOrdinal, payloadOrdinal, payloadTypeCode)
            || !SourceExpressionTypeMatchesEnumPayloadTypeCode(TypeOfNodeWithLocals(nodes, payloadExpr.NodeId, localTypes), payloadTypeCode))
        {
            return MakeParseResult(0, cursor);
        }

        currentEnumValue = MakeEnumPayloadInsert(nodes, ownerType, variantOrdinal, payloadOrdinal, currentEnumValue, payloadExpr.NodeId, payloadTypeCode);
        argCursor = payloadExpr.Next;
        payloadOrdinal = payloadOrdinal + 1;
    }

    if (stream.KindAt(argCursor) != TokenKind.RParen)
    {
        return MakeParseResult(0, cursor);
    }

    return MakeParseResult(currentEnumValue, argCursor + 1);
}

internal fn ExprParseResult TryParseRawPointerAggregateFieldPrimaryWithEnumsAndSlicesIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    if (stream.KindAt(cursor) != TokenKind.LParen
        || stream.KindAt(cursor + 1) != TokenKind.Star)
    {
        return MakeParseResult(0, cursor);
    }

    stack u32[0 max] closeParen = MatchingParenForMirLowering(stream, (u32[0 max])cursor);
    if (closeParen == (u32[0 max])cursor
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 1) != TokenKind.Dot
        || stream.KindAt((u64[0 2 ** 63 - 1])closeParen + 2) != TokenKind.Identifier)
    {
        return MakeParseResult(0, cursor);
    }

    stack ExprParseResult pointerExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        objectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        cursor + 2);
    if (pointerExpr.NodeId == 0 || pointerExpr.Next != (u64[0 2 ** 63 - 1])closeParen)
    {
        return MakeParseResult(0, cursor);
    }

    stack mut bool pointerMutable = false;
    stack mut u32[0 max] pointerFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] pointerElementSize = 0;
    stack mut u32[0 max] pointerElementAlignment = 0;
    stack mut bool pointerNestedMutable = false;
    stack mut u32[0 max] pointerNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] pointerNestedElementSize = 0;
    stack mut u32[0 max] pointerNestedElementAlignment = 0;
    if (!TryGetRawPointerFactsForNodeWithNested(
        nodes,
        params,
        pointerExpr.NodeId,
        pointerMutable,
        pointerFieldTypeCode,
        pointerElementSize,
        pointerElementAlignment,
        pointerNestedMutable,
        pointerNestedFieldTypeCode,
        pointerNestedElementSize,
        pointerNestedElementAlignment)
        || !SourceResolvedFieldTypeCodeIsAggregate(pointerFieldTypeCode))
    {
        return MakeParseResult(0, cursor);
    }

    stack u32[0 max] rootTypeToken = SourceResolvedFieldTypeCodeAggregateTypeToken(pointerFieldTypeCode);
    if (rootTypeToken == 0)
    {
        return MakeParseResult(0, cursor);
    }

    stack mut u64[0 2 ** 63 - 1] nextToken = (u64[0 2 ** 63 - 1])closeParen + 2;
    stack mut u32[0 max] fieldOffset = 0;
    stack mut u32[0 max] fieldAlignment = 0;
    stack mut u32[0 max] fieldTypeToken = 0;
    if (!TryResolveConstructedObjectMemberChainStorageField(
        stream,
        source,
        declarations,
        enumLayouts,
        rootTypeToken,
        (u64[0 2 ** 63 - 1])closeParen + 2,
        nextToken,
        fieldOffset,
        fieldAlignment,
        fieldTypeToken))
    {
        return MakeParseResult(0, cursor);
    }

    stack mut MirType fieldType = MirType.I64;
    stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    if (!TryGetSourceValueTypeCodeWithEnums(stream, source, declarations, enumLayouts, fieldTypeToken, fieldType, fieldTypeCode))
    {
        return MakeParseResult(0, cursor);
    }

    return MakeParseResult(MakeRawPointerFieldRead(nodes, pointerExpr.NodeId, fieldOffset, fieldAlignment, fieldTypeCode), nextToken);
}

internal fn ExprParseResult ParseConstructedObjectPrimaryWithEnumsAndSlicesIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    stack TokenKind k = stream.KindAt(cursor);
    if (k == TokenKind.IntegerLiteral)
    {
        stack i64[min max] value = ParseDigitSpan(source, stream.StartAt(cursor), stream.LengthAt(cursor));
        return MakeParseResult(MakeIntLit(nodes, value), cursor + 1);
    }

    if (k == TokenKind.True)
    {
        return MakeParseResult(MakeBoolLit(nodes, true), cursor + 1);
    }

    if (k == TokenKind.False)
    {
        return MakeParseResult(MakeBoolLit(nodes, false), cursor + 1);
    }

    if (k == TokenKind.Minus)
    {
        stack ExprParseResult operand = ParseConstructedObjectPrimaryWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 1);
        stack u32[0 max] zero = MakeIntLit(nodes, 0);
        stack u32[0 max] negated = MakeBinary(nodes, TokenKind.Minus, zero, operand.NodeId);
        return MakeParseResult(negated, operand.Next);
    }

    if (k == TokenKind.And)
    {
        stack ExprParseResult operand = ParseConstructedObjectPrimaryWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 1);
        return MakeParseResult(MakeAddressOf(nodes, operand.NodeId), operand.Next);
    }

    if (k == TokenKind.Star)
    {
        stack ExprParseResult operand = ParseConstructedObjectPrimaryWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 1);
        stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] elementSize = 0;
        stack mut u32[0 max] elementAlignment = 0;
        stack mut bool nestedMutable = false;
        stack mut u32[0 max] nestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] nestedElementSize = 0;
        stack mut u32[0 max] nestedElementAlignment = 0;
        if (!TryGetRawPointerDerefFactsForNodeWithNested(
            nodes,
            params,
            operand.NodeId,
            fieldTypeCode,
            elementSize,
            elementAlignment,
            nestedMutable,
            nestedFieldTypeCode,
            nestedElementSize,
            nestedElementAlignment))
        {
            fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
            elementSize = 0;
            elementAlignment = 0;
            nestedMutable = false;
            nestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
            nestedElementSize = 0;
            nestedElementAlignment = 0;
        }

        return MakeParseResult(
            MakeDerefWithNested(
                nodes,
                operand.NodeId,
                fieldTypeCode,
                elementSize,
                elementAlignment,
                nestedMutable,
                nestedFieldTypeCode,
                nestedElementSize,
                nestedElementAlignment),
            operand.Next);
    }

    if (k == TokenKind.Try)
    {
        stack ExprParseResult operand = ParseConstructedObjectPrimaryWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 1);
        return MakeParseResult(MakeTry(nodes, operand.NodeId), operand.Next);
    }

    if (k == TokenKind.LParen)
    {
        stack ExprParseResult rawPointerField = TryParseRawPointerAggregateFieldPrimaryWithEnumsAndSlicesIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            objectLocals,
            sliceDescriptorLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            cursor);
        if (rawPointerField.NodeId != 0)
        {
            return rawPointerField;
        }

        stack ExprParseResult inner = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 1);
        return MakeParseResult(inner.NodeId, inner.Next + 1);
    }

    if (k == TokenKind.Identifier
        && stream.KindAt(cursor + 1) == TokenKind.Dot
        && stream.KindAt(cursor + 2) == TokenKind.Identifier)
    {
        stack ExprParseResult enumConstructor = TryParseSourceEnumConstructorPrimaryIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            objectLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            cursor);
        if (enumConstructor.NodeId != 0)
        {
            return enumConstructor;
        }
    }

    if (k == TokenKind.Identifier && stream.KindAt(cursor + 1) == TokenKind.LParen)
    {
        stack i64[min max] calleeIndex = ParamIndexOf(funcNames, source, stream.StartAt(cursor), stream.LengthAt(cursor));
        stack mut u32[0 max] callee = 0;
        if (calleeIndex >= 0)
        {
            callee = (u32[0 max])(calleeIndex + 1);
        }

        if (stream.KindAt(cursor + 2) == TokenKind.RParen)
        {
            return MakeParseResult(MakeCall(nodes, callee, 0, 0, 0, 0, 0), cursor + 3);
        }

        stack ExprParseResult firstArg = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 2);
        stack mut u64[0 2 ** 63 - 1] argCursor = firstArg.Next;
        stack mut u32[0 max] argCount = 1;
        stack mut u32[0 max] secondArg = 0;
        stack mut u32[0 max] thirdArg = 0;
        stack mut u32[0 max] fourthArg = 0;
        stack mut IrTable<u32[0 max]> extraArgs = new();
        while willexit (stream.KindAt(argCursor) == TokenKind.Comma)
        {
            stack ExprParseResult more = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, argCursor + 1);
            if (argCount == 1)
            {
                secondArg = more.NodeId;
            }
            else if (argCount == 2)
            {
                thirdArg = more.NodeId;
            }
            else if (argCount == 3)
            {
                fourthArg = more.NodeId;
            }
            else
            {
                stack u32[0 max] addedExtra = extraArgs.Add(more.NodeId);
                if (addedExtra == 0)
                {
                    return MakeParseResult(0, argCursor);
                }
            }

            argCursor = more.Next;
            argCount = argCount + 1;
        }

        stack u32[0 max] extraArgLink = BuildCallExtraArgLinks(nodes, extraArgs);
        return MakeParseResult(MakeCallWithExtra(nodes, callee, argCount, firstArg.NodeId, secondArg, thirdArg, fourthArg, extraArgLink), argCursor + 1);
    }

    if (k == TokenKind.Identifier
        && stream.KindAt(cursor + 1) == TokenKind.Dot
        && stream.KindAt(cursor + 2) == TokenKind.Identifier)
    {
        stack mut ConstructedObjectLocal objectLocal = new();
        if (TryFindConstructedObjectLocal(objectLocals, source, stream.StartAt(cursor), stream.LengthAt(cursor), objectLocal))
        {
            stack mut u64[0 2 ** 63 - 1] nextToken = cursor;
            stack mut u32[0 max] fieldOffset = 0;
            stack mut u32[0 max] fieldAlignment = 0;
            stack mut u32[0 max] fieldTypeToken = 0;
            if (TryResolveConstructedObjectMemberChainStorageField(
                stream,
                source,
                declarations,
                enumLayouts,
                objectLocal.TypeToken,
                cursor + 2,
                nextToken,
                fieldOffset,
                fieldAlignment,
                fieldTypeToken))
            {
                if (stream.KindAt(nextToken) == TokenKind.LBrack)
                {
                    stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])nextToken);
                    if (closeBracket != (u32[0 max])nextToken)
                    {
                        if (stream.KindAt(nextToken + 1) == TokenKind.IntegerLiteral
                            && closeBracket == (u32[0 max])(nextToken + 2))
                        {
                            stack mut u32[0 max] elementOffset = 0;
                            stack mut u32[0 max] elementAlignment = 0;
                            stack mut MirType elementType = MirType.I64;
                            if (TryResolveFixedArrayElementLayoutAtField(
                                stream,
                                source,
                                fieldTypeToken,
                                (u32[0 max])(nextToken + 1),
                                fieldOffset,
                                elementOffset,
                                elementAlignment,
                                elementType))
                            {
                                stack u32[0 max] elementTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
                                if (elementTypeCode != SourceResolvedFieldTypeCodeInvalid())
                                {
                                    return MakeParseResult(MakeResolvedFieldRead(nodes, objectLocal.ParamIndex, elementOffset, elementAlignment, elementTypeCode), (u64[0 2 ** 63 - 1])closeBracket + 1);
                                }
                            }
                        }
                        else
                        {
                            stack mut u32[0 max] baseByteOffset = 0;
                            stack mut u32[0 max] elementSizeBytes = 0;
                            stack mut u32[0 max] elementAlignment = 0;
                            stack mut MirType elementType = MirType.I64;
                            stack mut u32[0 max] arrayLength = 0;
                            if (TryResolveFixedArrayFieldLayoutAtField(
                                stream,
                                source,
                                fieldTypeToken,
                                fieldOffset,
                                baseByteOffset,
                                elementSizeBytes,
                                elementAlignment,
                                elementType,
                                arrayLength))
                            {
                                stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
                                stack ExprParseResult indexExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, nextToken + 1);
                                if (params.Count() == beforeIndex
                                    && indexExpr.NodeId != 0
                                    && indexExpr.Next == (u64[0 2 ** 63 - 1])closeBracket
                                    && TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) == ExprType.IntType
                                    && SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, arrayLength))
                                {
                                    stack u32[0 max] elementTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
                                    if (elementTypeCode != SourceResolvedFieldTypeCodeInvalid())
                                    {
                                        return MakeParseResult(
                                            MakeResolvedIndexedFieldRead(nodes, objectLocal.ParamIndex, indexExpr.NodeId, baseByteOffset, elementSizeBytes, elementAlignment, elementTypeCode),
                                            (u64[0 2 ** 63 - 1])closeBracket + 1);
                                    }
                                }
                            }
                        }
                    }
                }
                else
                {
                    stack mut MirType fieldType = MirType.I64;
                    stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
                    if (TryGetSourceValueTypeCodeWithEnums(stream, source, declarations, enumLayouts, fieldTypeToken, fieldType, fieldTypeCode))
                    {
                        return MakeParseResult(MakeResolvedFieldRead(nodes, objectLocal.ParamIndex, fieldOffset, fieldAlignment, fieldTypeCode), nextToken);
                    }
                }
            }
        }
    }

    if (k == TokenKind.Identifier
        && stream.KindAt(cursor + 1) == TokenKind.Dot
        && stream.KindAt(cursor + 2) == TokenKind.Identifier
        && stream.KindAt(cursor + 3) == TokenKind.LBrack
        && stream.KindAt(cursor + 4) == TokenKind.IntegerLiteral
        && stream.KindAt(cursor + 5) == TokenKind.RBrack)
    {
        stack mut ConstructedObjectLocal objectLocal = new();
        if (TryFindConstructedObjectLocal(objectLocals, source, stream.StartAt(cursor), stream.LengthAt(cursor), objectLocal))
        {
            stack mut u32[0 max] elementOffset = 0;
            stack mut u32[0 max] elementAlignment = 0;
            stack mut MirType elementType = MirType.I64;
            if (TryFindStructFixedArrayElementLayout(
                stream,
                source,
                objectLocal.TypeToken,
                (u32[0 max])(cursor + 2),
                (u32[0 max])(cursor + 4),
                elementOffset,
                elementAlignment,
                elementType))
            {
                stack u32[0 max] elementTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
                if (elementTypeCode != SourceResolvedFieldTypeCodeInvalid())
                {
                    return MakeParseResult(MakeResolvedFieldRead(nodes, objectLocal.ParamIndex, elementOffset, elementAlignment, elementTypeCode), cursor + 6);
                }
            }
        }
    }

    if (k == TokenKind.Identifier
        && stream.KindAt(cursor + 1) == TokenKind.Dot
        && stream.KindAt(cursor + 2) == TokenKind.Identifier
        && stream.KindAt(cursor + 3) == TokenKind.LBrack)
    {
        stack mut ConstructedObjectLocal objectLocal = new();
        if (TryFindConstructedObjectLocal(objectLocals, source, stream.StartAt(cursor), stream.LengthAt(cursor), objectLocal))
        {
            stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(cursor + 3));
            if (closeBracket != (u32[0 max])(cursor + 3))
            {
                stack mut u32[0 max] baseByteOffset = 0;
                stack mut u32[0 max] elementSizeBytes = 0;
                stack mut u32[0 max] elementAlignment = 0;
                stack mut MirType elementType = MirType.I64;
                stack mut u32[0 max] arrayLength = 0;
                if (TryFindStructFixedArrayFieldLayout(
                    stream,
                    source,
                    objectLocal.TypeToken,
                    (u32[0 max])(cursor + 2),
                    baseByteOffset,
                    elementSizeBytes,
                    elementAlignment,
                    elementType,
                    arrayLength))
                {
                    stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
                    stack ExprParseResult indexExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 4);
                    if (params.Count() == beforeIndex
                        && indexExpr.NodeId != 0
                        && indexExpr.Next == (u64[0 2 ** 63 - 1])closeBracket
                        && TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) == ExprType.IntType
                        && SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, arrayLength))
                    {
                        stack u32[0 max] elementTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
                        if (elementTypeCode != SourceResolvedFieldTypeCodeInvalid())
                        {
                            return MakeParseResult(
                                MakeResolvedIndexedFieldRead(nodes, objectLocal.ParamIndex, indexExpr.NodeId, baseByteOffset, elementSizeBytes, elementAlignment, elementTypeCode),
                                (u64[0 2 ** 63 - 1])closeBracket + 1);
                        }
                    }
                }
            }
        }
    }

    if (k == TokenKind.Identifier
        && stream.KindAt(cursor + 1) == TokenKind.Dot
        && stream.KindAt(cursor + 2) == TokenKind.Identifier)
    {
        stack mut ConstructedObjectLocal objectLocal = new();
        if (TryFindConstructedObjectLocal(objectLocals, source, stream.StartAt(cursor), stream.LengthAt(cursor), objectLocal))
        {
            stack mut u32[0 max] fieldOffset = 0;
            stack mut u32[0 max] fieldAlignment = 0;
            stack mut MirType fieldType = MirType.I64;
            stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (TryFindStructFieldLayout(stream, source, declarations, enumLayouts, objectLocal.TypeToken, (u32[0 max])(cursor + 2), fieldOffset, fieldAlignment, fieldType, fieldTypeCode))
            {
                if (fieldTypeCode != SourceResolvedFieldTypeCodeInvalid())
                {
                    return MakeParseResult(MakeResolvedFieldRead(nodes, objectLocal.ParamIndex, fieldOffset, fieldAlignment, fieldTypeCode), cursor + 3);
                }
            }
        }
    }

    if (k == TokenKind.Identifier && stream.KindAt(cursor + 1) == TokenKind.LBrack)
    {
        stack i64[min max] rawPointerParamIndex = ParamIndexOf(
            params,
            source,
            stream.StartAt(cursor),
            stream.LengthAt(cursor));
        if (rawPointerParamIndex >= 0 && params.Contains((u32[0 max])rawPointerParamIndex + 1))
        {
            stack ParamName pointerParam = params.Get((u32[0 max])rawPointerParamIndex + 1);
            if (pointerParam.RawPointerFieldTypeCodeValue() != SourceResolvedFieldTypeCodeInvalid()
                && pointerParam.RawPointerElementSizeValue() != 0
                && pointerParam.RawPointerElementAlignmentValue() != 0)
            {
                stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(cursor + 1));
                if (closeBracket != (u32[0 max])(cursor + 1))
                {
                    stack ExprParseResult indexExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 2);
                    if (indexExpr.NodeId != 0
                        && indexExpr.Next == (u64[0 2 ** 63 - 1])closeBracket
                        && TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) == ExprType.IntType
                        && SourceIndexNodeProvesRawPointerBounds(nodes, indexExpr.NodeId, sourceValueFacts, pointerParam))
                    {
                        stack u32[0 max] pointerNode = MakeName(nodes, (u32[0 max])rawPointerParamIndex);
                        return MakeParseResult(
                            MakeRawPointerIndexedElementReadWithNested(
                                nodes,
                                pointerNode,
                                indexExpr.NodeId,
                                pointerParam.RawPointerElementSizeValue(),
                                pointerParam.RawPointerElementAlignmentValue(),
                                pointerParam.RawPointerFieldTypeCodeValue(),
                                pointerParam.RawPointerNestedMutableValue(),
                                pointerParam.RawPointerNestedFieldTypeCodeValue(),
                                pointerParam.RawPointerNestedElementSizeValue(),
                                pointerParam.RawPointerNestedElementAlignmentValue()),
                            (u64[0 2 ** 63 - 1])closeBracket + 1);
                    }
                }
            }
        }

        stack mut SourceSliceDescriptorLocal sliceLocal = new();
        if (TryFindSourceSliceDescriptorLocal(sliceDescriptorLocals, source, stream.StartAt(cursor), stream.LengthAt(cursor), sliceLocal))
        {
            stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(cursor + 1));
            if (closeBracket != (u32[0 max])(cursor + 1))
            {
                stack ExprParseResult indexExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor + 2);
                if (indexExpr.NodeId != 0
                    && indexExpr.Next == (u64[0 2 ** 63 - 1])closeBracket
                    && TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) == ExprType.IntType
                    && (sliceLocal.SliceLength == 0 || SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, sliceLocal.SliceLength)))
                {
                    stack mut u32[0 max] indexedRead = 0;
                    if (sliceLocal.IsFixedArrayParam)
                    {
                        indexedRead = MakeFixedArrayParamElementRead(
                            nodes,
                            sliceLocal.ReceiverParamIndex,
                            indexExpr.NodeId,
                            sliceLocal.SliceLength,
                            sliceLocal.ElementSize,
                            sliceLocal.Alignment,
                            sliceLocal.FieldTypeCode);
                    }
                    else if (sliceLocal.SliceLength == 0)
                    {
                        indexedRead = MakeResolvedRuntimeIndexedFieldRead(
                            nodes,
                            sliceLocal.ReceiverParamIndex,
                            indexExpr.NodeId,
                            sliceLocal.BaseByteOffset,
                            sliceLocal.ElementSize,
                            sliceLocal.Alignment,
                            sliceLocal.FieldTypeCode);
                    }
                    else
                    {
                        indexedRead = MakeResolvedIndexedFieldRead(
                            nodes,
                            sliceLocal.ReceiverParamIndex,
                            indexExpr.NodeId,
                            sliceLocal.BaseByteOffset,
                            sliceLocal.ElementSize,
                            sliceLocal.Alignment,
                            sliceLocal.FieldTypeCode);
                    }

                    return MakeParseResult(
                        indexedRead,
                        (u64[0 2 ** 63 - 1])closeBracket + 1);
                }
            }
        }
    }

    stack u32[0 max] paramIndex = ResolveParam(params, source, stream.StartAt(cursor), stream.LengthAt(cursor));
    return MakeParseResult(MakeName(nodes, paramIndex), cursor + 1);
}

internal fn ExprParseResult ParseConstructedObjectPrimaryWithEnumsIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    stack mut IrTable<SourceSliceDescriptorLocal> noSliceDescriptorLocals = new();
    return ParseConstructedObjectPrimaryWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        objectLocals,
        noSliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        cursor);
}

internal fn ExprParseResult ParseConstructedObjectMulWithEnumsAndSlicesIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    stack mut ExprParseResult left = ParseConstructedObjectPrimaryWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor);
    while willexit (IsProductOpToken(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ExprParseResult right = ParseConstructedObjectPrimaryWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, left.Next + 1);
        left.NodeId = MakeBinary(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

internal fn ExprParseResult ParseConstructedObjectMulWithEnumsIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
