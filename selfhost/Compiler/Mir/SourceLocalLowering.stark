import Compiler.Ir
import Compiler.Lexing
import Compiler.Parsing
import Compiler.Mir.Builder
import Compiler.Mir.Facts
import Compiler.Mir.Model
import Compiler.Mir.SourceExpressionLowering
import Compiler.Mir.SourceExpressions
import Compiler.Mir.SourceRangeFacts
import Compiler.Mir.SourceSemanticProbes
import Compiler.Mir.SourceSymbols
import Compiler.Typing.TypedEnumLayoutModel
import Compiler.Typing.TypedTypeResolution
module Compiler.Mir.SourceLocalLowering

internal finite law u32[0 max] MatchingBraceForMirLowering(borrow TokenStream stream, u32[0 max] open)
{
    stack mut u32[0 max] index = open;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return open;
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return index;
                }
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return open;
}

// Detects whether the source stream uses arena-backed runtime storage.
internal fn bool TokenStreamMentionsArenaRuntime(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Arena)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

// Detects whether the source stream uses heap-backed runtime storage.
internal fn bool TokenStreamMentionsHeapRuntime(borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        if (stream.KindAt(i) == TokenKind.Heap)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TokenTextIsReserveName(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 7)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    return source[start] == 82
        && source[start + 1] == 101
        && source[start + 2] == 115
        && source[start + 3] == 101
        && source[start + 4] == 114
        && source[start + 5] == 118
        && source[start + 6] == 101;
}

internal fn bool TokenTextIsTryReserveName(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 10)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    return source[start] == 84
        && source[start + 1] == 114
        && source[start + 2] == 121
        && source[start + 3] == 82
        && source[start + 4] == 101
        && source[start + 5] == 115
        && source[start + 6] == 101
        && source[start + 7] == 114
        && source[start + 8] == 118
        && source[start + 9] == 101;
}

internal fn bool TokenTextIsTryReserveCapacityName(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt((u64[0 2 ** 63 - 1])token);
    if (length != 18)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] start = stream.StartAt((u64[0 2 ** 63 - 1])token);
    return source[start] == 84
        && source[start + 1] == 114
        && source[start + 2] == 121
        && source[start + 3] == 82
        && source[start + 4] == 101
        && source[start + 5] == 115
        && source[start + 6] == 101
        && source[start + 7] == 114
        && source[start + 8] == 118
        && source[start + 9] == 101
        && source[start + 10] == 67
        && source[start + 11] == 97
        && source[start + 12] == 112
        && source[start + 13] == 97
        && source[start + 14] == 99
        && source[start + 15] == 105
        && source[start + 16] == 116
        && source[start + 17] == 121;
}

internal fn bool TokenTextIsArenaDynamicReserveMethod(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] token)
{
    return TokenTextIsReserveName(stream, source, token)
        || TokenTextIsTryReserveName(stream, source, token)
        || TokenTextIsTryReserveCapacityName(stream, source, token);
}

internal fn bool TokenStreamMentionsArenaDynamicRuntime(borrow TokenStream stream, borrow i8[min max][] source)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut bool sawArena = false;
    stack mut bool sawDynamicReserve = false;
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < count)
    {
        stack TokenKind kind = stream.KindAt(i);
        if (kind == TokenKind.Arena)
        {
            sawArena = true;
        }
        else if (kind == TokenKind.Identifier && TokenTextIsArenaDynamicReserveMethod(stream, source, (u32[0 max])i))
        {
            sawDynamicReserve = true;
        }

        i = i + 1;
    }

    return sawArena && sawDynamicReserve;
}

internal fn bool TokenStartsSelfHostedLocal(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Var:
            return true;
        case TokenKind.Stack:
            return true;
        case TokenKind.Register:
            return true;
        case TokenKind.Heap:
            return true;
        case TokenKind.Arena:
            return true;
        case TokenKind.Static:
            return true;
        default:
            return false;
    }
}

internal fn bool TokenCanStartSelfHostedType(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.IntegerType:
            return true;
        case TokenKind.Bool:
            return true;
        case TokenKind.Identifier:
            return true;
        case TokenKind.Dynamic:
            return true;
        case TokenKind.Dyn:
            return true;
        case TokenKind.Rawptr:
            return true;
        case TokenKind.Rawmutptr:
            return true;
        case TokenKind.Fnptr:
            return true;
        case TokenKind.AsciiView:
            return true;
        case TokenKind.UnicodeView:
            return true;
        case TokenKind.AsciiOwned:
            return true;
        case TokenKind.UnicodeOwned:
            return true;
        default:
            return false;
    }
}

internal fn u32[0 max] NaturalAlignmentForByteExtent(u32[0 max] sizeBytes)
{
    if (sizeBytes >= 8)
    {
        return 8;
    }

    if (sizeBytes >= 4)
    {
        return 4;
    }

    if (sizeBytes >= 2)
    {
        return 2;
    }

    return 1;
}

internal fn u32[0 max] MatchingBracketForMirLowering(borrow TokenStream stream, u32[0 max] open)
{
    stack mut u32[0 max] index = open;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return open;
        }

        if (kind == TokenKind.LBrack)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return index;
                }
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return open;
}

internal fn u32[0 max] AlignUpU32(u32[0 max] value, u32[0 max] alignment)
{
    if (alignment <= 1)
    {
        return value;
    }

    stack u32[0 max] remainder = value % alignment;
    if (remainder == 0)
    {
        return value;
    }

    return value + alignment - remainder;
}

internal fn bool IsPowerOfTwoU32(u32[0 max] value)
{
    if (value == 0)
    {
        return false;
    }

    stack mut u32[0 max] remaining = value;
    while willexit (remaining > 1)
    {
        if (remaining % 2 != 0)
        {
            return false;
        }

        remaining = remaining / 2;
    }

    return true;
}

internal fn bool FindSelfHostedStatementEnd(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] limit, out u64[0 2 ** 63 - 1] end)
{
    end = start;
    stack mut u64[0 2 ** 63 - 1] scan = start;
    stack mut u32[0 max] parenDepth = 0;
    stack mut u32[0 max] bracketDepth = 0;
    while willexit (scan < limit && stream.KindAt(scan) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.LParen)
        {
            parenDepth = parenDepth + 1;
        }
        else if (kind == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = parenDepth - 1;
            }
        }
        else if (kind == TokenKind.LBrack)
        {
            bracketDepth = bracketDepth + 1;
        }
        else if (kind == TokenKind.RBrack)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = bracketDepth - 1;
            }
        }
        else if (kind == TokenKind.Semi && parenDepth == 0 && bracketDepth == 0)
        {
            end = scan;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool FindSelfHostedStatementAssign(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end, out u64[0 2 ** 63 - 1] assign)
{
    assign = end;
    stack mut u64[0 2 ** 63 - 1] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (kind == TokenKind.Assign && depth == 0)
        {
            assign = scan;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn u32[0 max] FindSelfHostedLocalNameToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack mut u32[0 max] nameToken = 0;
    stack mut u64[0 2 ** 63 - 1] scan = start + 1;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (depth == 0 && kind == TokenKind.Assign)
        {
            break;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0)
        {
            nameToken = (u32[0 max])scan;
        }

        scan = scan + 1;
    }

    return nameToken;
}

internal fn u32[0 max] FindSelfHostedLocalTypeToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack u32[0 max] nameToken = FindSelfHostedLocalNameToken(stream, start, end);
    stack mut u64[0 2 ** 63 - 1] scan = start + 1;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        if (nameToken != 0 && scan >= (u64[0 2 ** 63 - 1])nameToken)
        {
            break;
        }

        stack TokenKind kind = stream.KindAt(scan);
        if (depth == 0 && kind == TokenKind.Assign)
        {
            break;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (depth == 0 && kind != TokenKind.Mut && TokenCanStartSelfHostedType(kind))
        {
            return (u32[0 max])scan;
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn bool SelfHostedLocalDeclarationHasMut(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack u32[0 max] nameToken = FindSelfHostedLocalNameToken(stream, start, end);
    stack mut u64[0 2 ** 63 - 1] scan = start + 1;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        if (nameToken != 0 && scan >= (u64[0 2 ** 63 - 1])nameToken)
        {
            return false;
        }

        stack TokenKind kind = stream.KindAt(scan);
        if (depth == 0 && kind == TokenKind.Assign)
        {
            return false;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (depth == 0 && kind == TokenKind.Mut)
        {
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn u32[0 max] ScalarTypeKnownByteExtent(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    if (kind == TokenKind.Bool)
    {
        return 1;
    }

    if (kind == TokenKind.IntegerType)
    {
        stack u32[0 max] bits = IntegerTypeBitWidth(stream, source, typeToken);
        return (u32[0 max])((bits + 7) / 8);
    }

    return 0;
}

internal fn bool TryReadFixedArrayLengthSuffix(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken, out u32[0 max] length)
{
    length = 0;
    stack mut u64[0 2 ** 63 - 1] scan = (u64[0 2 ** 63 - 1])typeToken + 1;
    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.IntegerType
        && stream.KindAt(scan) == TokenKind.LBrack)
    {
        stack u32[0 max] rangeClose = MatchingBracketForMirLowering(stream, (u32[0 max])scan);
        if (rangeClose == (u32[0 max])scan)
        {
            return false;
        }

        scan = (u64[0 2 ** 63 - 1])rangeClose + 1;
    }

    if (stream.KindAt(scan) != TokenKind.LBrack
        || stream.KindAt(scan + 1) != TokenKind.IntegerLiteral
        || stream.KindAt(scan + 2) != TokenKind.RBrack)
    {
        return false;
    }

    return TryReadPositiveIntegerToken(stream, source, scan + 1, length);
}

internal fn u32[0 max] TypeKnownByteExtent(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u32[0 max] scalarSize = ScalarTypeKnownByteExtent(stream, source, typeToken);
    if (scalarSize == 0)
    {
        return 0;
    }

    stack mut u32[0 max] arrayLength = 0;
    if (!TryReadFixedArrayLengthSuffix(stream, source, typeToken, arrayLength))
    {
        return scalarSize;
    }

    if (arrayLength > 4294967295 / scalarSize)
    {
        return 0;
    }

    return scalarSize * arrayLength;
}

internal fn u32[0 max] BuiltinTypeKnownByteAlignment(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u32[0 max] scalarSize = ScalarTypeKnownByteExtent(stream, source, typeToken);
    if (scalarSize != 0)
    {
        return NaturalAlignmentForByteExtent(scalarSize);
    }

    return 0;
}

internal finite law bool TokenKindIsSelfHostedAggregateDeclaration(TokenKind kind)
{
    return kind == TokenKind.Struct || kind == TokenKind.Record;
}

internal fn u32[0 max] MatchingParenForMirLowering(borrow TokenStream stream, u32[0 max] open)
{
    stack mut u32[0 max] index = open;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return open;
        }

        if (kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return index;
                }
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return open;
}

internal fn u32[0 max] FindSelfHostedRecordHeaderOpenToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] declarationNameToken)
{
    stack mut u64[0 2 ** 63 - 1] scan = declarationNameToken + 1;
    stack mut u32[0 max] angleDepth = 0;
    while willexit (scan < stream.Count())
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.EndOfFile || kind == TokenKind.LBrace || kind == TokenKind.Semi)
        {
            return 0;
        }

        if (kind == TokenKind.LParen && angleDepth == 0)
        {
            return (u32[0 max])scan;
        }

        if (kind == TokenKind.Lt)
        {
            angleDepth = angleDepth + 1;
        }
        else if (kind == TokenKind.Gt)
        {
            if (angleDepth > 0)
            {
                angleDepth = angleDepth - 1;
            }
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn u64[0 2 ** 63 - 1] FindSelfHostedAggregateBodyFieldStart(borrow TokenStream stream, u64[0 2 ** 63 - 1] declarationNameToken)
{
    stack i64[min max] lbrace = FirstTokenOfKindAfter(stream, TokenKind.LBrace, declarationNameToken);
    if (lbrace < 0)
    {
        return stream.Count();
    }

    return (u64[0 2 ** 63 - 1])lbrace + 1;
}

internal fn u32[0 max] StructKnownByteAlignment(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] maxAlign = 1;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] align = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])segmentStart);
                            if (align == 0)
                            {
                                return 0;
                            }

                            if (align > maxAlign)
                            {
                                maxAlign = align;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u32[0 max] align = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])field);
                    if (align == 0)
                    {
                        return 0;
                    }

                    if (align > maxAlign)
                    {
                        maxAlign = align;
                    }

                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            return maxAlign;
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn u32[0 max] StructKnownByteExtent(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            stack mut u32[0 max] maxAlign = 1;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])segmentStart);
                            stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])segmentStart);
                            if (fieldSize == 0 || fieldAlign == 0)
                            {
                                return 0;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            offset = offset + fieldSize;
                            if (fieldAlign > maxAlign)
                            {
                                maxAlign = fieldAlign;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])field);
                    stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])field);
                    if (fieldSize == 0 || fieldAlign == 0)
                    {
                        return 0;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    offset = offset + fieldSize;
                    if (fieldAlign > maxAlign)
                    {
                        maxAlign = fieldAlign;
                    }

                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            return AlignUpU32(offset, maxAlign);
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn u32[0 max] TypeKnownByteAlignment(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u32[0 max] builtinSize = TypeKnownByteExtent(stream, source, typeToken);
    if (builtinSize != 0)
    {
        return NaturalAlignmentForByteExtent(builtinSize);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.Identifier)
    {
        return StructKnownByteAlignment(stream, source, typeToken);
    }

    return 0;
}

internal fn u32[0 max] TypeKnownByteExtentForLocal(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u32[0 max] builtinSize = TypeKnownByteExtent(stream, source, typeToken);
    if (builtinSize != 0)
    {
        return builtinSize;
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.Identifier)
    {
        return StructKnownByteExtent(stream, source, typeToken);
    }

    return 0;
}

internal fn bool TryGetSourceEnumStorageLayoutForToken(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken,
    out u32[0 max] ownerDeclarationIndex,
    out u32[0 max] sizeBytes,
    out u32[0 max] alignBytes)
{
    ownerDeclarationIndex = 0;
    sizeBytes = 0;
    alignBytes = 0;
    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) != TokenKind.Identifier)
    {
        return false;
    }

    stack mut u32[0 max] resolvedOwnerDeclarationIndex = 0;
    stack mut Compiler.Parsing.DeclItem enumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(stream, source, declarations, typeToken, resolvedOwnerDeclarationIndex, enumItem))
    {
        return false;
    }

    if (!TryGetSourceEnumStorageLayout(enumLayouts, resolvedOwnerDeclarationIndex, sizeBytes, alignBytes))
    {
        return false;
    }

    ownerDeclarationIndex = resolvedOwnerDeclarationIndex;
    return true;
}

internal fn bool TryGetKnownSourceStorageLayoutWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken,
    out u32[0 max] sizeBytes,
    out u32[0 max] alignBytes)
{
    sizeBytes = TypeKnownByteExtent(stream, source, typeToken);
    alignBytes = BuiltinTypeKnownByteAlignment(stream, source, typeToken);
    if (sizeBytes != 0 && alignBytes != 0)
    {
        return true;
    }

    stack mut u32[0 max] ownerDeclarationIndex = 0;
    return TryGetSourceEnumStorageLayoutForToken(stream, source, declarations, enumLayouts, typeToken, ownerDeclarationIndex, sizeBytes, alignBytes);
}

internal fn bool TryGetSourceValueTypeCodeWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken,
    out MirType fieldType,
    out u32[0 max] fieldTypeCode)
{
    fieldType = MirType.I64;
    fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut MirType resolvedFieldType = MirType.I64;
    if (MirTypeForKnownSourceScalarType(stream, source, typeToken, resolvedFieldType))
    {
        fieldType = resolvedFieldType;
        fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(resolvedFieldType);
        return fieldTypeCode != SourceResolvedFieldTypeCodeInvalid();
    }

    stack mut u32[0 max] ownerDeclarationIndex = 0;
    stack mut u32[0 max] sizeBytes = 0;
    stack mut u32[0 max] alignBytes = 0;
    if (!TryGetSourceEnumStorageLayoutForToken(stream, source, declarations, enumLayouts, typeToken, ownerDeclarationIndex, sizeBytes, alignBytes))
    {
        return false;
    }

    fieldTypeCode = SourceResolvedFieldTypeCodeForEnumOwnerDeclarationIndex(ownerDeclarationIndex);
    return true;
}

internal fn u32[0 max] StructKnownByteAlignmentWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] maxAlign = 1;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack mut u32[0 max] fieldSize = 0;
                            stack mut u32[0 max] fieldAlign = 0;
                            if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])segmentStart, fieldSize, fieldAlign))
                            {
                                return 0;
                            }

                            if (fieldAlign > maxAlign)
                            {
                                maxAlign = fieldAlign;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack mut u32[0 max] fieldSize = 0;
                    stack mut u32[0 max] fieldAlign = 0;
                    if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])field, fieldSize, fieldAlign))
                    {
                        return 0;
                    }

                    if (fieldAlign > maxAlign)
                    {
                        maxAlign = fieldAlign;
                    }

                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            return maxAlign;
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn u32[0 max] StructKnownByteExtentWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            stack mut u32[0 max] maxAlign = 1;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack mut u32[0 max] fieldSize = 0;
                            stack mut u32[0 max] fieldAlign = 0;
                            if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])segmentStart, fieldSize, fieldAlign))
                            {
                                return 0;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            offset = offset + fieldSize;
                            if (fieldAlign > maxAlign)
                            {
                                maxAlign = fieldAlign;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack mut u32[0 max] fieldSize = 0;
                    stack mut u32[0 max] fieldAlign = 0;
                    if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])field, fieldSize, fieldAlign))
                    {
                        return 0;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    offset = offset + fieldSize;
                    if (fieldAlign > maxAlign)
                    {
                        maxAlign = fieldAlign;
                    }

                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            return AlignUpU32(offset, maxAlign);
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn u32[0 max] TypeKnownByteAlignmentWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken)
{
    stack mut u32[0 max] enumOwner = 0;
    stack mut u32[0 max] enumSize = 0;
    stack mut u32[0 max] enumAlign = 0;
    if (TryGetSourceEnumStorageLayoutForToken(stream, source, declarations, enumLayouts, typeToken, enumOwner, enumSize, enumAlign))
    {
        return enumAlign;
    }

    stack u32[0 max] builtinSize = TypeKnownByteExtent(stream, source, typeToken);
    if (builtinSize != 0)
    {
        return NaturalAlignmentForByteExtent(builtinSize);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.Identifier)
    {
        return StructKnownByteAlignmentWithEnums(stream, source, declarations, enumLayouts, typeToken);
    }

    return 0;
}

internal fn u32[0 max] TypeKnownByteExtentForLocalWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken)
{
    stack mut u32[0 max] enumOwner = 0;
    stack mut u32[0 max] enumSize = 0;
    stack mut u32[0 max] enumAlign = 0;
    if (TryGetSourceEnumStorageLayoutForToken(stream, source, declarations, enumLayouts, typeToken, enumOwner, enumSize, enumAlign))
    {
        return enumSize;
    }

    stack u32[0 max] builtinSize = TypeKnownByteExtent(stream, source, typeToken);
    if (builtinSize != 0)
    {
        return builtinSize;
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.Identifier)
    {
        return StructKnownByteExtentWithEnums(stream, source, declarations, enumLayouts, typeToken);
    }

    return 0;
}

internal fn bool MirTypeForKnownSourceScalarType(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken, out MirType type)
{
    type = MirType.I64;
    stack mut u32[0 max] arrayLength = 0;
    if (TryReadFixedArrayLengthSuffix(stream, source, typeToken, arrayLength))
    {
        return false;
    }

    return MirTypeForKnownSourceScalarTypeHead(stream, source, typeToken, type);
}

internal fn bool MirTypeForKnownSourceScalarTypeHead(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken, out MirType type)
{
    type = MirType.I64;
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    if (kind == TokenKind.Bool)
    {
        type = MirType.I1;
        return true;
    }

    if (kind != TokenKind.IntegerType)
    {
        return false;
    }

    stack u32[0 max] bits = IntegerTypeBitWidth(stream, source, typeToken);
    switch (bits)
    {
        case 8:
            type = MirType.I8;
            return true;
        case 16:
            type = MirType.I16;
            return true;
        case 32:
            type = MirType.I32;
            return true;
        case 64:
            type = MirType.I64;
            return true;
        default:
            return false;
    }
}

internal fn u64[0 2 ** 63 - 1] FindSelfHostedFieldEnd(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] limit)
{
    stack mut u64[0 2 ** 63 - 1] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < limit)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if ((kind == TokenKind.Semi || kind == TokenKind.RBrace) && depth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }

        scan = scan + 1;
    }

    return limit;
}

internal fn u32[0 max] FindSelfHostedFieldNameToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack mut u32[0 max] nameToken = 0;
    stack mut u64[0 2 ** 63 - 1] scan = start + 1;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0)
        {
            nameToken = (u32[0 max])scan;
        }

        scan = scan + 1;
    }

    return nameToken;
}

internal fn bool TryFindStructFieldLayout(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken,
    u32[0 max] fieldNameToken,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out MirType fieldType,
    out u32[0 max] fieldTypeCode)
{
    byteOffset = 0;
    alignBytes = 0;
    fieldType = MirType.I64;
    fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack mut u32[0 max] fieldSize = 0;
                            stack mut u32[0 max] fieldAlign = 0;
                            if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])segmentStart, fieldSize, fieldAlign))
                            {
                                return false;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, segmentStart, headerScan);
                            if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                            {
                                stack mut MirType resolvedType = MirType.I64;
                                stack mut u32[0 max] resolvedTypeCode = SourceResolvedFieldTypeCodeInvalid();
                                if (!TryGetSourceValueTypeCodeWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])segmentStart, resolvedType, resolvedTypeCode))
                                {
                                    return false;
                                }

                                byteOffset = offset;
                                alignBytes = fieldAlign;
                                fieldType = resolvedType;
                                fieldTypeCode = resolvedTypeCode;
                                return true;
                            }

                            offset = offset + fieldSize;
                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    stack mut u32[0 max] fieldSize = 0;
                    stack mut u32[0 max] fieldAlign = 0;
                    if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])field, fieldSize, fieldAlign))
                    {
                        return false;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, field, fieldEnd);
                    if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                    {
                        stack mut MirType resolvedType = MirType.I64;
                        stack mut u32[0 max] resolvedTypeCode = SourceResolvedFieldTypeCodeInvalid();
                        if (!TryGetSourceValueTypeCodeWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])field, resolvedType, resolvedTypeCode))
                        {
                            return false;
                        }

                        byteOffset = offset;
                        alignBytes = fieldAlign;
                        fieldType = resolvedType;
                        fieldTypeCode = resolvedTypeCode;
                        return true;
                    }

                    offset = offset + fieldSize;
                    field = fieldEnd;
                }

                field = field + 1;
            }

            return false;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryResolveFixedArrayElementLayoutAtField(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] fieldTypeToken,
    u32[0 max] elementIndexToken,
    u32[0 max] fieldOffset,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out MirType elementType)
{
    byteOffset = 0;
    alignBytes = 0;
    elementType = MirType.I64;

    stack mut u32[0 max] arrayLength = 0;
    stack mut u32[0 max] baseOffset = 0;
    stack mut u32[0 max] elementSize = 0;
    if (!TryResolveFixedArrayFieldLayoutAtField(
        stream,
        source,
        fieldTypeToken,
        fieldOffset,
        baseOffset,
        elementSize,
        alignBytes,
        elementType,
        arrayLength))
    {
        return false;
    }

    stack mut u32[0 max] elementIndex = 0;
    if (!TryReadNonNegativeIntegerToken(stream, source, (u64[0 2 ** 63 - 1])elementIndexToken, elementIndex))
    {
        return false;
    }

    if (elementIndex >= arrayLength)
    {
        return false;
    }

    if (elementIndex > 4294967295 / elementSize)
    {
        return false;
    }

    stack u32[0 max] elementOffset = elementIndex * elementSize;
    if (baseOffset > 4294967295 - elementOffset)
    {
        return false;
    }

    byteOffset = baseOffset + elementOffset;
    return true;
}

internal fn bool TryResolveFixedArrayFieldLayoutAtField(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] fieldTypeToken,
    u32[0 max] fieldOffset,
    out u32[0 max] baseByteOffset,
    out u32[0 max] elementSizeBytes,
    out u32[0 max] alignBytes,
    out MirType elementType,
    out u32[0 max] arrayLength)
{
    baseByteOffset = 0;
    elementSizeBytes = 0;
    alignBytes = 0;
    elementType = MirType.I64;
    arrayLength = 0;

    if (!TryReadFixedArrayLengthSuffix(stream, source, fieldTypeToken, arrayLength))
    {
        return false;
    }

    stack u32[0 max] elementSize = ScalarTypeKnownByteExtent(stream, source, fieldTypeToken);
    if (elementSize == 0)
    {
        return false;
    }

    if (!MirTypeForKnownSourceScalarTypeHead(stream, source, fieldTypeToken, elementType))
    {
        return false;
    }

    baseByteOffset = fieldOffset;
    elementSizeBytes = elementSize;
    alignBytes = NaturalAlignmentForByteExtent(elementSize);
    return true;
}

internal fn bool TryFindStructFixedArrayElementLayout(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u32[0 max] fieldNameToken,
    u32[0 max] elementIndexToken,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out MirType elementType)
{
    byteOffset = 0;
    alignBytes = 0;
    elementType = MirType.I64;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])segmentStart);
                            stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])segmentStart);
                            if (fieldSize == 0 || fieldAlign == 0)
                            {
                                return false;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, segmentStart, headerScan);
                            if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                            {
                                return TryResolveFixedArrayElementLayoutAtField(
                                    stream,
                                    source,
                                    (u32[0 max])segmentStart,
                                    elementIndexToken,
                                    offset,
                                    byteOffset,
                                    alignBytes,
                                    elementType);
                            }

                            offset = offset + fieldSize;
                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])field);
                    stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])field);
                    if (fieldSize == 0 || fieldAlign == 0)
                    {
                        return false;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, field, fieldEnd);
                    if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                    {
                        return TryResolveFixedArrayElementLayoutAtField(
                            stream,
                            source,
                            (u32[0 max])field,
                            elementIndexToken,
                            offset,
                            byteOffset,
                            alignBytes,
                            elementType);
                    }

                    offset = offset + fieldSize;
                    field = fieldEnd;
                }

                field = field + 1;
            }

            return false;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryFindStructFixedArrayFieldLayout(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u32[0 max] fieldNameToken,
    out u32[0 max] baseByteOffset,
    out u32[0 max] elementSizeBytes,
    out u32[0 max] alignBytes,
    out MirType elementType,
    out u32[0 max] arrayLength)
{
    baseByteOffset = 0;
    elementSizeBytes = 0;
    alignBytes = 0;
    elementType = MirType.I64;
    arrayLength = 0;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])segmentStart);
                            stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])segmentStart);
                            if (fieldSize == 0 || fieldAlign == 0)
                            {
                                return false;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, segmentStart, headerScan);
                            if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                            {
                                return TryResolveFixedArrayFieldLayoutAtField(
                                    stream,
                                    source,
                                    (u32[0 max])segmentStart,
                                    offset,
                                    baseByteOffset,
                                    elementSizeBytes,
                                    alignBytes,
                                    elementType,
                                    arrayLength);
                            }

                            offset = offset + fieldSize;
                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])field);
                    stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])field);
                    if (fieldSize == 0 || fieldAlign == 0)
                    {
                        return false;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, field, fieldEnd);
                    if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                    {
                        return TryResolveFixedArrayFieldLayoutAtField(
                            stream,
                            source,
                            (u32[0 max])field,
                            offset,
                            baseByteOffset,
                            elementSizeBytes,
                            alignBytes,
                            elementType,
                            arrayLength);
                    }

                    offset = offset + fieldSize;
                    field = fieldEnd;
                }

                field = field + 1;
            }

            return false;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn u64[0 2 ** 63 - 1] FindObjectInitializerEntryEnd(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] close)
{
    stack mut u64[0 2 ** 63 - 1] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < close)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (kind == TokenKind.Comma && depth == 0)
        {
            return scan;
        }

        scan = scan + 1;
    }

    return close;
}

internal struct RecordHeaderFieldLayoutCursor
{
    u64[0 2 ** 63 - 1] HeaderClose;
    u64[0 2 ** 63 - 1] SegmentStart;
    u64[0 2 ** 63 - 1] HeaderScan;
    u32[0 max] Depth;
    u32[0 max] Offset;

    RecordHeaderFieldLayoutCursor()
    {
        self.HeaderClose = 0;
        self.SegmentStart = 0;
        self.HeaderScan = 0;
        self.Depth = 0;
        self.Offset = 0;
    }
}

internal fn bool TryStartRecordHeaderFieldLayoutCursor(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    out RecordHeaderFieldLayoutCursor cursor)
{
    cursor = new();
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (stream.KindAt(scan) == TokenKind.Record
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
            if (headerOpen == 0)
            {
                return false;
            }

            stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
            cursor.HeaderClose = (u64[0 2 ** 63 - 1])headerClose;
            cursor.SegmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
            cursor.HeaderScan = cursor.SegmentStart;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryReadNextRecordHeaderFieldLayout(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    mut borrow RecordHeaderFieldLayoutCursor cursor,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out MirType fieldType,
    out u32[0 max] fieldTypeCode)
{
    byteOffset = 0;
    alignBytes = 0;
    fieldType = MirType.I64;
    fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    while willexit (cursor.HeaderScan <= cursor.HeaderClose)
    {
        stack TokenKind headerKind = stream.KindAt(cursor.HeaderScan);
        stack mut bool boundary = cursor.HeaderScan == cursor.HeaderClose;
        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
        {
            cursor.Depth = cursor.Depth + 1;
        }
        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
        {
            if (cursor.Depth > 0)
            {
                cursor.Depth = cursor.Depth - 1;
            }
        }

        if (cursor.Depth == 0 && headerKind == TokenKind.Comma)
        {
            boundary = true;
        }

        if (boundary && cursor.SegmentStart < cursor.HeaderScan)
        {
            stack mut u32[0 max] fieldSize = 0;
            stack mut u32[0 max] fieldAlign = 0;
            if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])cursor.SegmentStart, fieldSize, fieldAlign))
            {
                return false;
            }

            stack mut MirType resolvedType = MirType.I64;
            stack mut u32[0 max] resolvedTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!TryGetSourceValueTypeCodeWithEnums(stream, source, declarations, enumLayouts, (u32[0 max])cursor.SegmentStart, resolvedType, resolvedTypeCode))
            {
                return false;
            }

            cursor.Offset = AlignUpU32(cursor.Offset, fieldAlign);
            byteOffset = cursor.Offset;
            alignBytes = fieldAlign;
            fieldType = resolvedType;
            fieldTypeCode = resolvedTypeCode;
            cursor.Offset = cursor.Offset + fieldSize;
            cursor.SegmentStart = cursor.HeaderScan + 1;
            cursor.HeaderScan = cursor.HeaderScan + 1;
            return true;
        }

        cursor.HeaderScan = cursor.HeaderScan + 1;
    }

    return false;
}

