}

internal fn ExprParseResult ParseConstructedObjectExprWithEnumsAndSlicesIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    stack mut ExprParseResult left = ParseConstructedObjectAddWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor);
    while willexit (IsComparisonOperator(stream.KindAt(left.Next)))
    {
        stack TokenKind op = stream.KindAt(left.Next);
        stack ExprParseResult right = ParseConstructedObjectAddWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, left.Next + 1);
        left.NodeId = MakeCompare(nodes, op, left.NodeId, right.NodeId);
        left.Next = right.Next;
    }

    return left;
}

internal fn ExprParseResult ParseConstructedObjectExprWithEnumsIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    stack mut IrTable<SourceSliceDescriptorLocal> noSliceDescriptorLocals = new();
    return ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, objectLocals, noSliceDescriptorLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor);
}

internal fn ExprParseResult ParseConstructedObjectExprIn(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] cursor)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(objectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts)
{
    stack mut Compiler.Parsing.DeclarationList noDeclarations = new();
    stack mut TypedEnumLayoutTable noEnumLayouts = new();
    return ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, objectLocals, localTypes, sourceValueFacts, noDeclarations, noEnumLayouts, cursor);
}

internal fn bool TryParseStackObjectFieldInitializers(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken,
    u32[0 max] bodyOpen,
    u32[0 max] bodyClose,
    u32[0 max] localOrdinal,
    u32[0 max] paramIndex,
    MirValueId objectPointer,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    mut borrow IrTable<StackObjectFieldInitializer> initializers)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(initializers, sourceValueFacts)
{
    if (bodyOpen == 0)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])bodyOpen + 1;
    stack u64[0 2 ** 63 - 1] close = (u64[0 2 ** 63 - 1])bodyClose;
    while willexit (cursor < close)
    {
        if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            cursor = cursor + 1;
            continue;
        }

        if (stream.KindAt(cursor) != TokenKind.Identifier || stream.KindAt(cursor + 1) != TokenKind.Assign)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] valueStart = cursor + 2;
        stack u64[0 2 ** 63 - 1] valueEnd = FindObjectInitializerEntryEnd(stream, valueStart, close);
        if (valueStart >= valueEnd)
        {
            return false;
        }

        stack mut u32[0 max] fieldOffset = 0;
        stack mut u32[0 max] fieldAlignment = 0;
        stack mut MirType fieldType = MirType.I64;
        stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        if (!TryFindStructFieldLayout(stream, source, declarations, enumLayouts, typeToken, (u32[0 max])cursor, fieldOffset, fieldAlignment, fieldType, fieldTypeCode))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
        stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, valueStart);
        if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != valueEnd)
        {
            return false;
        }

        if (!FieldInitializerExpressionMatchesTypeCode(fieldTypeCode, nodes, expr.NodeId, localTypes))
        {
            return false;
        }

        stack mut StackObjectFieldInitializer initializer = new();
        initializer.LocalOrdinal = localOrdinal;
        initializer.ParamIndex = paramIndex;
        initializer.ObjectPointerValue = objectPointer.Index();
        initializer.FieldOffset = fieldOffset;
        initializer.FieldAlignment = fieldAlignment;
        initializer.FieldType = fieldType;
        initializer.FieldTypeCode = fieldTypeCode;
        initializer.ExprRoot = expr.NodeId;
        stack u32[0 max] added = initializers.Add(initializer);
        if (added == 0)
        {
            return false;
        }

        cursor = valueEnd;
    }

    return true;
}

internal fn bool TryParseStackObjectPositionalRecordConstructorInitializers(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u32[0 max] typeToken,
    u32[0 max] argsOpen,
    u32[0 max] argsClose,
    u32[0 max] localOrdinal,
    u32[0 max] paramIndex,
    MirValueId objectPointer,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    mut borrow IrTable<StackObjectFieldInitializer> initializers)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(initializers, sourceValueFacts)
{
    stack mut RecordHeaderFieldLayoutCursor fieldCursor = new();
    if (!TryStartRecordHeaderFieldLayoutCursor(stream, source, typeToken, fieldCursor))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])argsOpen + 1;
    stack u64[0 2 ** 63 - 1] close = (u64[0 2 ** 63 - 1])argsClose;
    while willexit (cursor < close)
    {
        if (stream.KindAt(cursor) == TokenKind.Comma)
        {
            cursor = cursor + 1;
            continue;
        }

        stack u64[0 2 ** 63 - 1] valueEnd = FindObjectInitializerEntryEnd(stream, cursor, close);
        if (cursor >= valueEnd)
        {
            return false;
        }

        stack mut u32[0 max] fieldOffset = 0;
        stack mut u32[0 max] fieldAlignment = 0;
        stack mut MirType fieldType = MirType.I64;
        stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        if (!TryReadNextRecordHeaderFieldLayout(stream, source, declarations, enumLayouts, fieldCursor, fieldOffset, fieldAlignment, fieldType, fieldTypeCode))
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
        stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, cursor);
        if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != valueEnd)
        {
            return false;
        }

        if (!FieldInitializerExpressionMatchesTypeCode(fieldTypeCode, nodes, expr.NodeId, localTypes))
        {
            return false;
        }

        stack mut StackObjectFieldInitializer initializer = new();
        initializer.LocalOrdinal = localOrdinal;
        initializer.ParamIndex = paramIndex;
        initializer.ObjectPointerValue = objectPointer.Index();
        initializer.FieldOffset = fieldOffset;
        initializer.FieldAlignment = fieldAlignment;
        initializer.FieldType = fieldType;
        initializer.FieldTypeCode = fieldTypeCode;
        initializer.ExprRoot = expr.NodeId;
        stack u32[0 max] added = initializers.Add(initializer);
        if (added == 0)
        {
            return false;
        }

        cursor = valueEnd;
    }

    stack mut u32[0 max] trailingFieldOffset = 0;
    stack mut u32[0 max] trailingFieldAlignment = 0;
    stack mut MirType trailingFieldType = MirType.I64;
    stack mut u32[0 max] trailingFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    return !TryReadNextRecordHeaderFieldLayout(stream, source, declarations, enumLayouts, fieldCursor, trailingFieldOffset, trailingFieldAlignment, trailingFieldType, trailingFieldTypeCode);
}

internal fn u32[0 max] LowerStackObjectFieldInitializersForLocalWithCallContext(
    borrow IrTable<StackObjectFieldInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    stack mut u32[0 max] cursor = nextInitializer;
    while willexit (initializers.Contains(cursor))
    {
        stack StackObjectFieldInitializer initializer = initializers.Get(cursor);
        if (initializer.LocalOrdinal != localOrdinal)
        {
            return cursor;
        }

        stack mut u32[0 max] objectPointerValue = initializer.ObjectPointerValue;
        if (objectPointerValue == 0)
        {
            if (!localOverrides.Contains(initializer.ParamIndex + 1))
            {
                return cursor;
            }

            objectPointerValue = localOverrides.Get(initializer.ParamIndex + 1);
        }

        if (objectPointerValue == 0)
        {
            return cursor;
        }

        stack MirValueId basePointer = MirValueIdOf(objectPointerValue);
        stack MirValueId fieldPointer = MirPtrOffset(instrs, basePointer, initializer.FieldOffset, initializer.FieldAlignment);
        if (SourceResolvedFieldTypeCodeIsEnum(initializer.FieldTypeCode))
        {
            stack u32[0 max] ownerTypeIndex = SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(initializer.FieldTypeCode) + 1;
            stack MirValueId value = LowerExprNodeWithCallContext(nodes, initializer.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
            stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(ownerTypeIndex), fieldPointer, value, initializer.FieldAlignment);
        }
        else
        {
            stack MirValueId value = LowerExprNodeAsTypeWithCallContext(nodes, initializer.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals, initializer.FieldType);
            stack MirValueId store = MirStorePtrAlignedTyped(instrs, initializer.FieldType, fieldPointer, value, initializer.FieldAlignment);
        }

        cursor = cursor + 1;
    }

    return cursor;
}

internal fn u32[0 max] LowerStackObjectFieldInitializersForLocal(
    borrow IrTable<StackObjectFieldInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<SourceSliceArgumentLocal> noSliceArgumentLocals = new();
    return LowerStackObjectFieldInitializersForLocalWithCallContext(
        initializers,
        localOrdinal,
        nextInitializer,
        nodes,
        instrs,
        localTypes,
        localOverrides,
        noFunctionCallContractFacts,
        noSliceArgumentLocals);
}

internal fn u32[0 max] LowerScalarStorageInitializersForLocalWithCallContext(
    borrow IrTable<ScalarStorageInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    stack mut u32[0 max] cursor = nextInitializer;
    while willexit (initializers.Contains(cursor))
    {
        stack ScalarStorageInitializer initializer = initializers.Get(cursor);
        if (initializer.LocalOrdinal != localOrdinal)
        {
            return cursor;
        }

        if (!localOverrides.Contains(initializer.ParamIndex + 1))
        {
            return cursor;
        }

        stack u32[0 max] storageValue = localOverrides.Get(initializer.ParamIndex + 1);
        if (storageValue == 0)
        {
            return cursor;
        }

        stack MirValueId value = LowerExprNodeAsTypeWithCallContext(nodes, initializer.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals, initializer.FieldType);
        stack MirValueId store = MirStorePtrAlignedTyped(instrs, initializer.FieldType, MirValueIdOf(storageValue), value, initializer.FieldAlignment);
        cursor = cursor + 1;
    }

    return cursor;
}

internal fn u32[0 max] LowerScalarStorageInitializersForLocal(
    borrow IrTable<ScalarStorageInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<SourceSliceArgumentLocal> noSliceArgumentLocals = new();
    return LowerScalarStorageInitializersForLocalWithCallContext(
        initializers,
        localOrdinal,
        nextInitializer,
        nodes,
        instrs,
        localTypes,
        localOverrides,
        noFunctionCallContractFacts,
        noSliceArgumentLocals);
}

internal fn u32[0 max] LowerEnumStorageInitializersForLocalWithCallContext(
    borrow IrTable<EnumStorageInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    stack mut u32[0 max] cursor = nextInitializer;
    while willexit (initializers.Contains(cursor))
    {
        stack EnumStorageInitializer initializer = initializers.Get(cursor);
        if (initializer.LocalOrdinal != localOrdinal)
        {
            return cursor;
        }

        if (!localOverrides.Contains(initializer.ParamIndex + 1))
        {
            return cursor;
        }

        stack u32[0 max] storageValue = localOverrides.Get(initializer.ParamIndex + 1);
        if (storageValue == 0 || initializer.OwnerTypeIndex == 0)
        {
            return cursor;
        }

        stack MirValueId value = LowerExprNodeWithCallContext(nodes, initializer.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
        stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(initializer.OwnerTypeIndex), MirValueIdOf(storageValue), value, initializer.FieldAlignment);
        cursor = cursor + 1;
    }

    return cursor;
}

internal fn u32[0 max] LowerEnumStorageInitializersForLocal(
    borrow IrTable<EnumStorageInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<SourceSliceArgumentLocal> noSliceArgumentLocals = new();
    return LowerEnumStorageInitializersForLocalWithCallContext(
        initializers,
        localOrdinal,
        nextInitializer,
        nodes,
        instrs,
        localTypes,
        localOverrides,
        noFunctionCallContractFacts,
        noSliceArgumentLocals);
}

internal fn u32[0 max] LowerFixedArrayStorageInitializersForLocalWithCallContext(
    borrow IrTable<FixedArrayStorageInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    stack mut u32[0 max] cursor = nextInitializer;
    while willexit (initializers.Contains(cursor))
    {
        stack FixedArrayStorageInitializer initializer = initializers.Get(cursor);
        if (initializer.LocalOrdinal != localOrdinal)
        {
            return cursor;
        }

        if (!localOverrides.Contains(initializer.ParamIndex + 1))
        {
            return cursor;
        }

        stack u32[0 max] storageValue = localOverrides.Get(initializer.ParamIndex + 1);
        if (storageValue == 0)
        {
            return cursor;
        }

        if (initializer.ElementIndex > 4294967295 / initializer.ElementSize)
        {
            return cursor;
        }

        stack u32[0 max] byteOffset = initializer.ElementIndex * initializer.ElementSize;
        stack MirValueId elementPointer = MirPtrOffset(instrs, MirValueIdOf(storageValue), byteOffset, initializer.Alignment);
        stack mut MirValueId value = new();
        if (initializer.ExprRoot == 0)
        {
            value = MirConstIntTyped(instrs, initializer.ElementType, 0);
        }
        else
        {
            value = LowerExprNodeAsTypeWithCallContext(nodes, initializer.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals, initializer.ElementType);
        }

        stack MirValueId store = MirStorePtrAlignedTyped(instrs, initializer.ElementType, elementPointer, value, initializer.Alignment);
        cursor = cursor + 1;
    }

    return cursor;
}

internal fn u32[0 max] LowerFixedArrayStorageInitializersForLocal(
    borrow IrTable<FixedArrayStorageInitializer> initializers,
    u32[0 max] localOrdinal,
    u32[0 max] nextInitializer,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<SourceSliceArgumentLocal> noSliceArgumentLocals = new();
    return LowerFixedArrayStorageInitializersForLocalWithCallContext(
        initializers,
        localOrdinal,
        nextInitializer,
        nodes,
        instrs,
        localTypes,
        localOverrides,
        noFunctionCallContractFacts,
        noSliceArgumentLocals);
}

internal fn bool TryParseScalarStorageAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<ScalarStorageLocal> scalarStorageLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<ScalarStorageAssignment> assignments)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(scalarStorageLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(assignments, sourceValueFacts)
{
    if (!StatementStartsScalarStorageAssignment(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack mut ScalarStorageLocal local = new();
    if (!TryFindScalarStorageLocal(
        scalarStorageLocals,
        source,
        stream.StartAt(statementStart),
        stream.LengthAt(statementStart),
        local))
    {
        return false;
    }

    if (!local.Mutable)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, statementStart + 2);
    if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != statementEnd)
    {
        return false;
    }

    stack ExprType exprType = TypeOfNodeWithLocals(nodes, expr.NodeId, localTypes);
    if (!FieldInitializerTypeMatches(local.FieldType, exprType))
    {
        return false;
    }

    if (local.FieldType == MirType.Ptr)
    {
        if (!params.Contains(local.ParamIndex + 1))
        {
            return false;
        }

        stack ParamName localParam = params.Get(local.ParamIndex + 1);
        stack mut bool initializerMutable = false;
        stack mut u32[0 max] initializerFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] initializerElementSize = 0;
        stack mut u32[0 max] initializerElementAlignment = 0;
        stack mut bool initializerNestedMutable = false;
        stack mut u32[0 max] initializerNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] initializerNestedElementSize = 0;
        stack mut u32[0 max] initializerNestedElementAlignment = 0;
        if (!TryGetRawPointerFactsForNodeWithNested(
            nodes,
            params,
            expr.NodeId,
            initializerMutable,
            initializerFieldTypeCode,
            initializerElementSize,
            initializerElementAlignment,
            initializerNestedMutable,
            initializerNestedFieldTypeCode,
            initializerNestedElementSize,
            initializerNestedElementAlignment)
            || !RawPointerInitializerFactsMatchDeclaration(
                localParam.RawPointerMutableValue(),
                localParam.RawPointerFieldTypeCodeValue(),
                localParam.RawPointerElementSizeValue(),
                localParam.RawPointerElementAlignmentValue(),
                localParam.RawPointerNestedMutableValue(),
                localParam.RawPointerNestedFieldTypeCodeValue(),
                localParam.RawPointerNestedElementSizeValue(),
                localParam.RawPointerNestedElementAlignmentValue(),
                initializerMutable,
                initializerFieldTypeCode,
                initializerElementSize,
                initializerElementAlignment,
                initializerNestedMutable,
                initializerNestedFieldTypeCode,
                initializerNestedElementSize,
                initializerNestedElementAlignment))
        {
            return false;
        }

        if (!ReplaceParamRawPointerElementCountFactsFromNameNode(
            params,
            nodes,
            local.ParamIndex,
            expr.NodeId))
        {
            return false;
        }
    }

    stack mut ScalarStorageAssignment assignment = new();
    assignment.ParamIndex = local.ParamIndex;
    assignment.FieldAlignment = local.FieldAlignment;
    assignment.FieldType = local.FieldType;
    assignment.ExprRoot = expr.NodeId;
    stack u32[0 max] added = assignments.Add(assignment);
    return added != 0;
}

internal fn bool TryParseRawPointerStorageAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<ScalarStorageAssignment> assignments)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(assignments, sourceValueFacts)
{
    if (!StatementStartsRawPointerDerefAssignment(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforePointer = params.Count();
    stack ExprParseResult pointerExpr = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, statementStart + 1);
    if (params.Count() != beforePointer
        || pointerExpr.NodeId == 0
        || pointerExpr.Next >= statementEnd
        || stream.KindAt(pointerExpr.Next) != TokenKind.Assign)
    {
        return false;
    }

    stack mut bool pointerMutable = false;
    stack mut u32[0 max] pointerFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] pointerElementSize = 0;
    stack mut u32[0 max] pointerElementAlignment = 0;
    stack mut bool pointerNestedMutable = false;
    stack mut u32[0 max] pointerNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] pointerNestedElementSize = 0;
    stack mut u32[0 max] pointerNestedElementAlignment = 0;
    if (!TryGetRawPointerFactsForNodeWithNested(
        nodes,
        params,
        pointerExpr.NodeId,
        pointerMutable,
        pointerFieldTypeCode,
        pointerElementSize,
        pointerElementAlignment,
        pointerNestedMutable,
        pointerNestedFieldTypeCode,
        pointerNestedElementSize,
        pointerNestedElementAlignment)
        || !pointerMutable
        || pointerFieldTypeCode == SourceResolvedFieldTypeCodeInvalid()
        || pointerElementSize == 0
        || pointerElementAlignment == 0)
    {
        return false;
    }

    stack MirType fieldType = MirTypeForResolvedFieldTypeCode(pointerFieldTypeCode);
    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, pointerExpr.Next + 1);
    if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != statementEnd)
    {
        return false;
    }

    stack ExprType exprType = TypeOfNodeWithLocals(nodes, expr.NodeId, localTypes);
    if (!FieldInitializerTypeMatches(fieldType, exprType))
    {
        return false;
    }

    if (fieldType == MirType.Ptr)
    {
        stack mut bool exprMutable = false;
        stack mut u32[0 max] exprFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] exprElementSize = 0;
        stack mut u32[0 max] exprElementAlignment = 0;
        stack mut bool exprNestedMutable = false;
        stack mut u32[0 max] exprNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] exprNestedElementSize = 0;
        stack mut u32[0 max] exprNestedElementAlignment = 0;
        if (!TryGetRawPointerFactsForNodeWithNested(
            nodes,
            params,
            expr.NodeId,
            exprMutable,
            exprFieldTypeCode,
            exprElementSize,
            exprElementAlignment,
            exprNestedMutable,
            exprNestedFieldTypeCode,
            exprNestedElementSize,
            exprNestedElementAlignment)
            || !RawPointerInitializerFactsMatchDeclaration(
                pointerNestedMutable,
                pointerNestedFieldTypeCode,
                pointerNestedElementSize,
                pointerNestedElementAlignment,
                false,
                SourceResolvedFieldTypeCodeInvalid(),
                0,
                0,
                exprMutable,
                exprFieldTypeCode,
                exprElementSize,
                exprElementAlignment,
                exprNestedMutable,
                exprNestedFieldTypeCode,
                exprNestedElementSize,
                exprNestedElementAlignment))
        {
            return false;
        }
    }

    stack mut ScalarStorageAssignment assignment = new();
    assignment.FieldAlignment = pointerElementAlignment;
    assignment.FieldType = fieldType;
    assignment.ExprRoot = expr.NodeId;
    assignment.RawPointerTarget = true;
    assignment.RawPointerRoot = pointerExpr.NodeId;
    stack u32[0 max] added = assignments.Add(assignment);
    return added != 0;
}

internal fn bool TryParseRawPointerAggregateFieldAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<ScalarStorageAssignment> assignments)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(assignments, sourceValueFacts)
{
    stack ExprParseResult target = TryParseRawPointerAggregateFieldPrimaryWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        statementStart);
    if (target.NodeId == 0
        || target.Next >= statementEnd
        || stream.KindAt(target.Next) != TokenKind.Assign
        || !nodes.Contains(target.NodeId))
    {
        return false;
    }

    stack ExprNode targetNode = nodes.Get(target.NodeId);
    if (targetNode.Kind != Compiler.Mir.SourceExpressions.ExprKind.RawPointerFieldExpr)
    {
        return false;
    }

    stack mut bool pointerMutable = false;
    stack mut u32[0 max] pointerFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] pointerElementSize = 0;
    stack mut u32[0 max] pointerElementAlignment = 0;
    stack mut bool pointerNestedMutable = false;
    stack mut u32[0 max] pointerNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] pointerNestedElementSize = 0;
    stack mut u32[0 max] pointerNestedElementAlignment = 0;
    if (!TryGetRawPointerFactsForNodeWithNested(
        nodes,
        params,
        targetNode.Left,
        pointerMutable,
        pointerFieldTypeCode,
        pointerElementSize,
        pointerElementAlignment,
        pointerNestedMutable,
        pointerNestedFieldTypeCode,
        pointerNestedElementSize,
        pointerNestedElementAlignment)
        || !pointerMutable
        || !SourceResolvedFieldTypeCodeIsAggregate(pointerFieldTypeCode)
        || SourceResolvedFieldTypeCodeIsEnum(targetNode.Arg3))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        target.Next + 1);
    if (params.Count() != beforeExpr
        || expr.NodeId == 0
        || expr.Next != statementEnd
        || !FieldInitializerExpressionMatchesTypeCode(targetNode.Arg3, nodes, expr.NodeId, localTypes))
    {
        return false;
    }

    stack mut ScalarStorageAssignment assignment = new();
    assignment.FieldAlignment = targetNode.Arg2;
    assignment.FieldType = MirTypeForResolvedFieldTypeCode(targetNode.Arg3);
    assignment.ExprRoot = expr.NodeId;
    assignment.RawPointerTarget = true;
    assignment.RawPointerRoot = MakeAddressOf(nodes, target.NodeId);
    stack u32[0 max] added = assignments.Add(assignment);
    return added != 0;
}

internal fn bool TryParseEnumStorageAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<EnumStorageLocal> enumStorageLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<EnumStorageAssignment> assignments)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(enumStorageLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(assignments, sourceValueFacts)
{
    if (!StatementStartsScalarStorageAssignment(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack mut EnumStorageLocal local = new();
    if (!TryFindEnumStorageLocal(
        enumStorageLocals,
        source,
        stream.StartAt(statementStart),
        stream.LengthAt(statementStart),
        local))
    {
        return false;
    }

    if (!local.Mutable || local.OwnerTypeIndex == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, statementStart + 2);
    if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != statementEnd)
    {
        return false;
    }

    stack mut u32[0 max] exprOwnerTypeIndex = 0;
    if (TypeOfNodeWithLocals(nodes, expr.NodeId, localTypes) != ExprType.EnumType
        || !TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, expr.NodeId, localTypes, exprOwnerTypeIndex)
        || exprOwnerTypeIndex != local.OwnerTypeIndex)
    {
        return false;
    }

    stack mut EnumStorageAssignment assignment = new();
    assignment.ParamIndex = local.ParamIndex;
    assignment.FieldAlignment = local.FieldAlignment;
    assignment.OwnerTypeIndex = local.OwnerTypeIndex;
    assignment.ExprRoot = expr.NodeId;
    stack u32[0 max] added = assignments.Add(assignment);
    return added != 0;
}

internal fn bool LowerScalarStorageAssignmentWithCallContext(
    ScalarStorageAssignment assignment,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    if (assignment.RawPointerTarget)
    {
        stack mut MirValueId pointer = MirValueIdOf(0);
        if (assignment.RawPointerRoot != 0)
        {
            pointer = LowerExprNodeAsTypeWithCallContext(
                nodes,
                assignment.RawPointerRoot,
                instrs,
                localTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals,
                MirType.Ptr);
        }
        else if (localOverrides.Contains(assignment.ParamIndex + 1))
        {
            stack u32[0 max] pointerValue = localOverrides.Get(assignment.ParamIndex + 1);
            if (pointerValue != 0)
            {
                if (localTypes.Contains(assignment.ParamIndex + 1)
                    && localTypes.Get(assignment.ParamIndex + 1) == SourceLocalTypeCodeStoredPointer())
                {
                    pointer = MirLoadPtrAlignedTyped(instrs, MirType.Ptr, MirValueIdOf(pointerValue), SourceRawPointerStorageByteAlignment());
                }
                else
                {
                    pointer = MirValueIdOf(pointerValue);
                }
            }
        }

        if (!pointer.IsValid())
        {
            pointer = MirParamTyped(instrs, MirType.Ptr, assignment.ParamIndex);
        }

        stack MirValueId value = LowerExprNodeAsTypeWithCallContext(nodes, assignment.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals, assignment.FieldType);
        stack MirValueId store = MirStorePtrAlignedTyped(instrs, assignment.FieldType, pointer, value, assignment.FieldAlignment);
        return true;
    }

    if (!localOverrides.Contains(assignment.ParamIndex + 1))
    {
        return false;
    }

    stack u32[0 max] storageValue = localOverrides.Get(assignment.ParamIndex + 1);
    if (storageValue == 0)
    {
        return false;
    }

    stack MirValueId value = LowerExprNodeAsTypeWithCallContext(nodes, assignment.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals, assignment.FieldType);
    stack MirValueId store = MirStorePtrAlignedTyped(instrs, assignment.FieldType, MirValueIdOf(storageValue), value, assignment.FieldAlignment);
    return true;
}

internal fn bool LowerScalarStorageAssignment(
    ScalarStorageAssignment assignment,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<SourceSliceArgumentLocal> noSliceArgumentLocals = new();
    return LowerScalarStorageAssignmentWithCallContext(
        assignment,
        nodes,
        instrs,
        localTypes,
        localOverrides,
        noFunctionCallContractFacts,
        noSliceArgumentLocals);
}

internal fn bool LowerEnumStorageAssignmentWithCallContext(
    EnumStorageAssignment assignment,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    if (!localOverrides.Contains(assignment.ParamIndex + 1))
    {
        return false;
    }

    stack u32[0 max] storageValue = localOverrides.Get(assignment.ParamIndex + 1);
    if (storageValue == 0 || assignment.OwnerTypeIndex == 0)
    {
        return false;
    }

    stack MirValueId value = LowerExprNodeWithCallContext(nodes, assignment.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(assignment.OwnerTypeIndex), MirValueIdOf(storageValue), value, assignment.FieldAlignment);
    return true;
}

internal fn bool LowerEnumStorageAssignment(
    EnumStorageAssignment assignment,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<SourceSliceArgumentLocal> noSliceArgumentLocals = new();
    return LowerEnumStorageAssignmentWithCallContext(
        assignment,
        nodes,
        instrs,
        localTypes,
        localOverrides,
        noFunctionCallContractFacts,
        noSliceArgumentLocals);
}

internal fn bool LowerScalarStorageAssignments(
    borrow IrTable<ScalarStorageAssignment> assignments,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack u64[0 2 ** 63 - 1] total = assignments.Count();
    stack mut u32[0 max] cursor = 1;
    while willexit ((u64[0 2 ** 63 - 1])cursor <= total)
    {
        stack ScalarStorageAssignment assignment = assignments.Get(cursor);
        if (!LowerScalarStorageAssignment(assignment, nodes, instrs, localTypes, localOverrides))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    return true;
}

internal fn bool TryParseSourceSliceElementAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<ConstructedObjectFieldAssignment> assignments)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(assignments, sourceValueFacts)
{
    if (statementStart + 4 >= statementEnd
        || stream.KindAt(statementStart) != TokenKind.Identifier
        || stream.KindAt(statementStart + 1) != TokenKind.LBrack)
    {
        return false;
    }

    stack mut SourceSliceDescriptorLocal sliceLocal = new();
    if (!TryFindSourceSliceDescriptorLocal(
        sliceDescriptorLocals,
        source,
        stream.StartAt(statementStart),
        stream.LengthAt(statementStart),
        sliceLocal))
    {
        return false;
    }

    if (!sliceLocal.Mutable)
    {
        return false;
    }

    stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(statementStart + 1));
    if (closeBracket == (u32[0 max])(statementStart + 1)
        || (u64[0 2 ** 63 - 1])(closeBracket + 1) >= statementEnd
        || stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) != TokenKind.Assign)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
    stack ExprParseResult indexExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        statementStart + 2);
    if (params.Count() != beforeIndex
        || indexExpr.NodeId == 0
        || indexExpr.Next != (u64[0 2 ** 63 - 1])closeBracket
        || TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) != ExprType.IntType
        || (sliceLocal.SliceLength != 0 && !SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, sliceLocal.SliceLength)))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        (u64[0 2 ** 63 - 1])closeBracket + 2);
    if (params.Count() != beforeExpr
        || expr.NodeId == 0
        || expr.Next != statementEnd
        || !FieldInitializerExpressionMatchesTypeCode(sliceLocal.FieldTypeCode, nodes, expr.NodeId, localTypes))
    {
        return false;
    }

    stack mut ConstructedObjectFieldAssignment assignment = new();
    assignment.ReceiverParamIndex = sliceLocal.ReceiverParamIndex;
    assignment.FieldOffset = sliceLocal.BaseByteOffset;
    assignment.IndexRoot = indexExpr.NodeId;
    assignment.ElementSize = sliceLocal.ElementSize;
    assignment.FieldAlignment = sliceLocal.Alignment;
    assignment.FieldType = sliceLocal.ElementType;
    assignment.FieldTypeCode = sliceLocal.FieldTypeCode;
    assignment.ExprRoot = expr.NodeId;
    assignment.IndexHasKnownBounds = sliceLocal.SliceLength != 0;
    stack u32[0 max] added = assignments.Add(assignment);
    return added != 0;
}

internal fn bool TryParseSourceSliceElementTryAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    out ConstructedObjectFieldAssignment assignment)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    assignment = new();
    if (statementStart + 4 >= statementEnd
        || stream.KindAt(statementStart) != TokenKind.Identifier
        || stream.KindAt(statementStart + 1) != TokenKind.LBrack)
    {
        return false;
    }

    stack mut SourceSliceDescriptorLocal sliceLocal = new();
    if (!TryFindSourceSliceDescriptorLocal(
        sliceDescriptorLocals,
        source,
        stream.StartAt(statementStart),
        stream.LengthAt(statementStart),
        sliceLocal))
    {
        return false;
    }

    if (!sliceLocal.Mutable)
    {
        return false;
    }

    stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(statementStart + 1));
    if (closeBracket == (u32[0 max])(statementStart + 1)
        || (u64[0 2 ** 63 - 1])(closeBracket + 2) >= statementEnd
        || stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) != TokenKind.Assign
        || stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 2) != TokenKind.Try)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
    stack ExprParseResult indexExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        statementStart + 2);
    if (params.Count() != beforeIndex
        || indexExpr.NodeId == 0
        || indexExpr.Next != (u64[0 2 ** 63 - 1])closeBracket
        || TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) != ExprType.IntType
        || (sliceLocal.SliceLength != 0 && !SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, sliceLocal.SliceLength)))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        (u64[0 2 ** 63 - 1])closeBracket + 2);
    if (params.Count() != beforeExpr
        || expr.NodeId == 0
        || expr.Next != statementEnd)
    {
        return false;
    }

    assignment.ReceiverParamIndex = sliceLocal.ReceiverParamIndex;
    assignment.FieldOffset = sliceLocal.BaseByteOffset;
    assignment.IndexRoot = indexExpr.NodeId;
    assignment.ElementSize = sliceLocal.ElementSize;
    assignment.FieldAlignment = sliceLocal.Alignment;
    assignment.FieldType = sliceLocal.ElementType;
    assignment.FieldTypeCode = sliceLocal.FieldTypeCode;
    assignment.ExprRoot = expr.NodeId;
    assignment.IndexHasKnownBounds = sliceLocal.SliceLength != 0;
    return true;
}

internal fn bool TryParseConstructedObjectFieldAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<ConstructedObjectFieldAssignment> assignments)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(assignments, sourceValueFacts)
{
    if (!StatementStartsConstructedObjectFieldAssignment(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack mut ConstructedObjectLocal objectLocal = new();
    if (!TryFindConstructedObjectLocal(
        constructedObjectLocals,
        source,
        stream.StartAt(statementStart),
        stream.LengthAt(statementStart),
        objectLocal))
    {
        return false;
    }

    stack mut u32[0 max] fieldOffset = 0;
    stack mut u32[0 max] fieldAlignment = 0;
    stack mut MirType fieldType = MirType.I64;
    stack mut u32[0 max] indexRoot = 0;
    stack mut u32[0 max] elementSize = 0;
    stack mut bool indexHasKnownBounds = false;
    stack mut u64[0 2 ** 63 - 1] exprStart = statementStart + 4;
    stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    if (stream.KindAt(statementStart + 3) == TokenKind.Dot
        || stream.KindAt(statementStart + 3) == TokenKind.Assign
        || stream.KindAt(statementStart + 3) == TokenKind.LBrack)
    {
        stack mut u64[0 2 ** 63 - 1] nextToken = statementStart;
        stack mut u32[0 max] fieldTypeToken = 0;
        if (!TryResolveConstructedObjectMemberChainStorageField(
            stream,
            source,
            declarations,
            enumLayouts,
            objectLocal.TypeToken,
            statementStart + 2,
            nextToken,
            fieldOffset,
            fieldAlignment,
            fieldTypeToken))
        {
            return false;
        }

        if (stream.KindAt(nextToken) == TokenKind.Assign)
        {
            if (!TryGetSourceValueTypeCodeWithEnums(stream, source, declarations, enumLayouts, fieldTypeToken, fieldType, fieldTypeCode))
            {
                return false;
            }

            exprStart = nextToken + 1;
        }
        else if (stream.KindAt(nextToken) == TokenKind.LBrack)
        {
            stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])nextToken);
            if (closeBracket == (u32[0 max])nextToken
                || (u64[0 2 ** 63 - 1])(closeBracket + 1) >= statementEnd
                || stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) != TokenKind.Assign)
            {
                return false;
            }

            stack u32[0 max] nestedFieldOffset = fieldOffset;
            if (stream.KindAt(nextToken + 1) == TokenKind.IntegerLiteral
                && closeBracket == (u32[0 max])(nextToken + 2))
            {
                if (!TryResolveFixedArrayElementLayoutAtField(
                    stream,
                    source,
                    fieldTypeToken,
                    (u32[0 max])(nextToken + 1),
                    nestedFieldOffset,
                    fieldOffset,
                    fieldAlignment,
                    fieldType))
                {
                    return false;
                }
            }
            else
            {
                stack mut u32[0 max] arrayLength = 0;
                if (!TryResolveFixedArrayFieldLayoutAtField(
                    stream,
                    source,
                    fieldTypeToken,
                    nestedFieldOffset,
                    fieldOffset,
                    elementSize,
                    fieldAlignment,
                    fieldType,
                    arrayLength))
                {
                    return false;
                }

                stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
                stack ExprParseResult indexExpr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, nextToken + 1);
                if (params.Count() != beforeIndex
                    || indexExpr.NodeId == 0
                    || indexExpr.Next != (u64[0 2 ** 63 - 1])closeBracket
                    || TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) != ExprType.IntType
                    || !SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, arrayLength))
                {
                    return false;
                }

                indexRoot = indexExpr.NodeId;
                indexHasKnownBounds = true;
            }

            exprStart = (u64[0 2 ** 63 - 1])closeBracket + 2;
            fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(fieldType);
        }
        else
        {
            return false;
        }
    }
    else if (stream.KindAt(statementStart + 3) == TokenKind.LBrack)
    {
        stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(statementStart + 3));
        if (closeBracket == (u32[0 max])(statementStart + 3)
            || (u64[0 2 ** 63 - 1])(closeBracket + 1) >= statementEnd
            || stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) != TokenKind.Assign)
        {
            return false;
        }

        if (stream.KindAt(statementStart + 4) == TokenKind.IntegerLiteral
            && closeBracket == (u32[0 max])(statementStart + 5))
        {
            if (!TryFindStructFixedArrayElementLayout(
                stream,
                source,
                objectLocal.TypeToken,
                (u32[0 max])(statementStart + 2),
                (u32[0 max])(statementStart + 4),
                fieldOffset,
                fieldAlignment,
                fieldType))
            {
                return false;
            }
        }
        else
        {
            stack mut u32[0 max] arrayLength = 0;
            if (!TryFindStructFixedArrayFieldLayout(
                stream,
                source,
                objectLocal.TypeToken,
                (u32[0 max])(statementStart + 2),
                fieldOffset,
                elementSize,
                fieldAlignment,
                fieldType,
                arrayLength))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
            stack ExprParseResult indexExpr = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, statementStart + 4);
            if (params.Count() != beforeIndex
                || indexExpr.NodeId == 0
                || indexExpr.Next != (u64[0 2 ** 63 - 1])closeBracket
                || TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) != ExprType.IntType
                || !SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, arrayLength))
            {
                return false;
            }

            indexRoot = indexExpr.NodeId;
            indexHasKnownBounds = true;
        }

        exprStart = (u64[0 2 ** 63 - 1])closeBracket + 2;
        fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(fieldType);
    }
    else if (!TryFindStructFieldLayout(stream, source, declarations, enumLayouts, objectLocal.TypeToken, (u32[0 max])(statementStart + 2), fieldOffset, fieldAlignment, fieldType, fieldTypeCode))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, exprStart);
    if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != statementEnd)
    {
        return false;
    }

    if (!FieldInitializerExpressionMatchesTypeCode(fieldTypeCode, nodes, expr.NodeId, localTypes))
    {
        return false;
    }

    stack mut ConstructedObjectFieldAssignment assignment = new();
    assignment.ReceiverParamIndex = objectLocal.ParamIndex;
    assignment.FieldOffset = fieldOffset;
    assignment.IndexRoot = indexRoot;
    assignment.ElementSize = elementSize;
    assignment.FieldAlignment = fieldAlignment;
    assignment.FieldType = fieldType;
    assignment.FieldTypeCode = fieldTypeCode;
    assignment.ExprRoot = expr.NodeId;
    assignment.IndexHasKnownBounds = indexHasKnownBounds;
    stack u32[0 max] added = assignments.Add(assignment);
    return added != 0;
}

internal fn bool TryParseConstructedObjectFieldTryAssignmentStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    out ConstructedObjectFieldAssignment assignment)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts)
{
    assignment = new();
    if (!StatementStartsConstructedObjectFieldAssignment(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack mut ConstructedObjectLocal objectLocal = new();
    if (!TryFindConstructedObjectLocal(
        constructedObjectLocals,
        source,
        stream.StartAt(statementStart),
        stream.LengthAt(statementStart),
        objectLocal))
    {
        return false;
    }

    stack mut u32[0 max] fieldOffset = 0;
    stack mut u32[0 max] fieldAlignment = 0;
    stack mut MirType fieldType = MirType.I64;
    stack mut u32[0 max] indexRoot = 0;
    stack mut u32[0 max] elementSize = 0;
    stack mut bool indexHasKnownBounds = false;
    stack mut u64[0 2 ** 63 - 1] exprStart = statementStart + 4;
    stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    if (stream.KindAt(statementStart + 3) == TokenKind.Dot
        || stream.KindAt(statementStart + 3) == TokenKind.Assign
        || stream.KindAt(statementStart + 3) == TokenKind.LBrack)
    {
        stack mut u64[0 2 ** 63 - 1] nextToken = statementStart;
        stack mut u32[0 max] fieldTypeToken = 0;
        if (!TryResolveConstructedObjectMemberChainStorageField(
            stream,
            source,
            declarations,
            enumLayouts,
            objectLocal.TypeToken,
            statementStart + 2,
            nextToken,
            fieldOffset,
            fieldAlignment,
            fieldTypeToken)
            || (stream.KindAt(nextToken) != TokenKind.Assign && stream.KindAt(nextToken) != TokenKind.LBrack))
        {
            return false;
        }

        if (stream.KindAt(nextToken) == TokenKind.Assign)
        {
            if (!TryGetSourceValueTypeCodeWithEnums(stream, source, declarations, enumLayouts, fieldTypeToken, fieldType, fieldTypeCode))
            {
                return false;
            }

            exprStart = nextToken + 1;
        }
        else
        {
            stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])nextToken);
            if (closeBracket == (u32[0 max])nextToken
                || (u64[0 2 ** 63 - 1])(closeBracket + 1) >= statementEnd
                || stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) != TokenKind.Assign)
            {
                return false;
            }

            stack u32[0 max] nestedFieldOffset = fieldOffset;
            if (stream.KindAt(nextToken + 1) == TokenKind.IntegerLiteral
                && closeBracket == (u32[0 max])(nextToken + 2))
            {
                if (!TryResolveFixedArrayElementLayoutAtField(
                    stream,
                    source,
                    fieldTypeToken,
                    (u32[0 max])(nextToken + 1),
                    nestedFieldOffset,
                    fieldOffset,
                    fieldAlignment,
                    fieldType))
                {
                    return false;
                }
            }
            else
            {
                stack mut u32[0 max] arrayLength = 0;
                if (!TryResolveFixedArrayFieldLayoutAtField(
                    stream,
                    source,
                    fieldTypeToken,
                    nestedFieldOffset,
                    fieldOffset,
                    elementSize,
                    fieldAlignment,
                    fieldType,
                    arrayLength))
                {
                    return false;
                }

                stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
                stack ExprParseResult indexExpr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, nextToken + 1);
                if (params.Count() != beforeIndex
                    || indexExpr.NodeId == 0
                    || indexExpr.Next != (u64[0 2 ** 63 - 1])closeBracket
                    || TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) != ExprType.IntType
                    || !SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, arrayLength))
                {
                    return false;
                }

                indexRoot = indexExpr.NodeId;
                indexHasKnownBounds = true;
            }

            exprStart = (u64[0 2 ** 63 - 1])closeBracket + 2;
            fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(fieldType);
        }
    }
    else if (stream.KindAt(statementStart + 3) == TokenKind.Assign)
    {
        if (!TryFindStructFieldLayout(
            stream,
            source,
            declarations,
            enumLayouts,
            objectLocal.TypeToken,
            (u32[0 max])(statementStart + 2),
            fieldOffset,
            fieldAlignment,
            fieldType,
            fieldTypeCode))
        {
            return false;
        }
    }
    else if (stream.KindAt(statementStart + 3) == TokenKind.LBrack)
    {
        stack u32[0 max] closeBracket = MatchingBracketForMirLowering(stream, (u32[0 max])(statementStart + 3));
        if (closeBracket == (u32[0 max])(statementStart + 3)
            || (u64[0 2 ** 63 - 1])(closeBracket + 1) >= statementEnd
            || stream.KindAt((u64[0 2 ** 63 - 1])closeBracket + 1) != TokenKind.Assign)
        {
            return false;
        }

        if (stream.KindAt(statementStart + 4) == TokenKind.IntegerLiteral
            && closeBracket == (u32[0 max])(statementStart + 5))
        {
            if (!TryFindStructFixedArrayElementLayout(
                stream,
                source,
                objectLocal.TypeToken,
                (u32[0 max])(statementStart + 2),
                (u32[0 max])(statementStart + 4),
                fieldOffset,
                fieldAlignment,
                fieldType))
            {
                return false;
            }
        }
        else
        {
            stack mut u32[0 max] arrayLength = 0;
            if (!TryFindStructFixedArrayFieldLayout(
                stream,
                source,
                objectLocal.TypeToken,
                (u32[0 max])(statementStart + 2),
                fieldOffset,
                elementSize,
                fieldAlignment,
                fieldType,
                arrayLength))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeIndex = params.Count();
            stack ExprParseResult indexExpr = ParseConstructedObjectExprIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, statementStart + 4);
            if (params.Count() != beforeIndex
                || indexExpr.NodeId == 0
                || indexExpr.Next != (u64[0 2 ** 63 - 1])closeBracket
                || TypeOfNodeWithLocals(nodes, indexExpr.NodeId, localTypes) != ExprType.IntType
                || !SourceIndexNodeProvesFixedArrayBounds(nodes, indexExpr.NodeId, sourceValueFacts, arrayLength))
            {
                return false;
            }

            indexRoot = indexExpr.NodeId;
            indexHasKnownBounds = true;
        }

        exprStart = (u64[0 2 ** 63 - 1])closeBracket + 2;
        fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(fieldType);
    }
    else
    {
        return false;
    }

    if (fieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    if (stream.KindAt(exprStart) != TokenKind.Try)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] beforeExpr = params.Count();
    stack ExprParseResult expr = ParseConstructedObjectExprWithEnumsIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        exprStart);
    if (params.Count() != beforeExpr || expr.NodeId == 0 || expr.Next != statementEnd)
    {
        return false;
    }

    assignment.ReceiverParamIndex = objectLocal.ParamIndex;
    assignment.FieldOffset = fieldOffset;
    assignment.IndexRoot = indexRoot;
    assignment.ElementSize = elementSize;
    assignment.FieldAlignment = fieldAlignment;
    assignment.FieldType = fieldType;
    assignment.FieldTypeCode = fieldTypeCode;
    assignment.ExprRoot = expr.NodeId;
    assignment.IndexHasKnownBounds = indexHasKnownBounds;
    return true;
}

internal fn bool TryParseSourceStorageMutationStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<ConstructedObjectLocal> constructedObjectLocals,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    borrow IrTable<ScalarStorageLocal> scalarStorageLocals,
    borrow IrTable<EnumStorageLocal> enumStorageLocals,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow Compiler.Parsing.DeclarationList declarations,
    borrow TypedEnumLayoutTable enumLayouts,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    mut borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    mut borrow IrTable<EnumStorageAssignment> enumAssignments,
    mut borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    mut borrow IrTable<SourceStorageMutationStatement> mutationStatements)
    where overlap(stream, sourceValueFacts),
          overlap(source, sourceValueFacts),
          overlap(nodes, sourceValueFacts),
          overlap(params, sourceValueFacts),
          overlap(funcNames, sourceValueFacts),
          overlap(constructedObjectLocals, sourceValueFacts),
          overlap(sliceDescriptorLocals, sourceValueFacts),
          overlap(scalarStorageLocals, sourceValueFacts),
          overlap(enumStorageLocals, sourceValueFacts),
          overlap(localTypes, sourceValueFacts),
          overlap(declarations, sourceValueFacts),
          overlap(enumLayouts, sourceValueFacts),
          overlap(scalarAssignments, sourceValueFacts),
          overlap(enumAssignments, sourceValueFacts),
          overlap(fieldAssignments, sourceValueFacts),
          overlap(mutationStatements, sourceValueFacts)
{
    if (TryParseSourceSliceElementAssignmentStatement(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        statementStart,
        statementEnd,
        fieldAssignments))
    {
        stack mut SourceStorageMutationStatement mutation = new();
        mutation.Kind = SourceStorageMutationKindConstructedObjectField();
        mutation.AssignmentIndex = (u32[0 max])fieldAssignments.Count();
        return mutationStatements.Add(mutation) != 0;
    }

    if (TryParseRawPointerStorageAssignmentStatement(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        localTypes,
        sourceValueFacts,
        statementStart,
        statementEnd,
        scalarAssignments))
    {
        stack mut SourceStorageMutationStatement mutation = new();
        mutation.Kind = SourceStorageMutationKindScalar();
        mutation.AssignmentIndex = (u32[0 max])scalarAssignments.Count();
        return mutationStatements.Add(mutation) != 0;
    }

    if (TryParseRawPointerAggregateFieldAssignmentStatement(
        stream,
        source,
        nodes,
        params,
        funcNames,
        constructedObjectLocals,
        sliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        declarations,
        enumLayouts,
        statementStart,
        statementEnd,
        scalarAssignments))
    {
        stack mut SourceStorageMutationStatement mutation = new();
        mutation.Kind = SourceStorageMutationKindScalar();
        mutation.AssignmentIndex = (u32[0 max])scalarAssignments.Count();
        return mutationStatements.Add(mutation) != 0;
    }

    if (StatementStartsConstructedObjectFieldAssignment(stream, statementStart, statementEnd))
    {
        if (!TryParseConstructedObjectFieldAssignmentStatement(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            statementStart,
            statementEnd,
            fieldAssignments))
        {
            return false;
        }

        stack mut SourceStorageMutationStatement mutation = new();
        mutation.Kind = SourceStorageMutationKindConstructedObjectField();
        mutation.AssignmentIndex = (u32[0 max])fieldAssignments.Count();
        return mutationStatements.Add(mutation) != 0;
    }

    if (StatementStartsScalarStorageAssignment(stream, statementStart, statementEnd))
    {
        if (TryParseScalarStorageAssignmentStatement(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            scalarStorageLocals,
            localTypes,
            sourceValueFacts,
            statementStart,
            statementEnd,
            scalarAssignments))
        {
            stack mut SourceStorageMutationStatement mutation = new();
            mutation.Kind = SourceStorageMutationKindScalar();
            mutation.AssignmentIndex = (u32[0 max])scalarAssignments.Count();
            return mutationStatements.Add(mutation) != 0;
        }

        if (TryParseEnumStorageAssignmentStatement(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            enumStorageLocals,
            localTypes,
            sourceValueFacts,
            declarations,
            enumLayouts,
            statementStart,
            statementEnd,
            enumAssignments))
        {
            stack mut SourceStorageMutationStatement mutation = new();
            mutation.Kind = SourceStorageMutationKindEnum();
            mutation.AssignmentIndex = (u32[0 max])enumAssignments.Count();
            return mutationStatements.Add(mutation) != 0;
        }
    }

    return false;
}

internal fn bool LowerConstructedObjectFieldAssignmentValueWithCallContext(
    ConstructedObjectFieldAssignment assignment,
    MirValueId value,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    if (!value.IsValid() || !localOverrides.Contains(assignment.ReceiverParamIndex + 1))
    {
        return false;
    }

    stack u32[0 max] basePointerValue = localOverrides.Get(assignment.ReceiverParamIndex + 1);
    if (basePointerValue == 0)
    {
        return false;
    }

    stack MirValueId basePointer = MirValueIdOf(basePointerValue);
    stack mut MirValueId indexValue = MirValueIdOf(0);
    if (assignment.IndexRoot != 0)
    {
        indexValue = LowerExprNodeAsTypeWithCallContext(nodes, assignment.IndexRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals, MirType.I64);
        if (!indexValue.IsValid())
        {
            return false;
        }
    }

    stack MirValueId fieldPointer = LowerResolvedStoragePlaceAddress(
        instrs,
        basePointer,
        indexValue,
        assignment.IndexRoot,
        assignment.FieldOffset,
        assignment.ElementSize,
        assignment.FieldAlignment,
        assignment.IndexHasKnownBounds);
    if (!fieldPointer.IsValid())
    {
        return false;
    }

    if (SourceResolvedFieldTypeCodeIsEnum(assignment.FieldTypeCode))
    {
        stack u32[0 max] ownerTypeIndex = SourceResolvedFieldTypeCodeEnumOwnerDeclarationIndex(assignment.FieldTypeCode) + 1;
        stack MirValueId store = MirStoreEnumPtrAligned(instrs, TypeIdOf(ownerTypeIndex), fieldPointer, value, assignment.FieldAlignment);
        return store.IsValid();
    }

    stack MirValueId store = MirStorePtrAlignedTyped(instrs, assignment.FieldType, fieldPointer, value, assignment.FieldAlignment);
    return store.IsValid();
}

internal fn bool LowerConstructedObjectFieldAssignmentWithCallContext(
    ConstructedObjectFieldAssignment assignment,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    if (SourceResolvedFieldTypeCodeIsEnum(assignment.FieldTypeCode))
    {
        stack MirValueId value = LowerExprNodeWithCallContext(nodes, assignment.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
        return LowerConstructedObjectFieldAssignmentValueWithCallContext(
            assignment,
            value,
            nodes,
            instrs,
            localTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);
    }

    stack MirValueId value = LowerExprNodeAsTypeWithCallContext(nodes, assignment.ExprRoot, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals, assignment.FieldType);
    return LowerConstructedObjectFieldAssignmentValueWithCallContext(
        assignment,
        value,
        nodes,
        instrs,
        localTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals);
}

internal fn bool LowerConstructedObjectFieldAssignment(
    ConstructedObjectFieldAssignment assignment,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<SourceSliceArgumentLocal> noSliceArgumentLocals = new();
    return LowerConstructedObjectFieldAssignmentWithCallContext(
        assignment,
        nodes,
        instrs,
        localTypes,
        localOverrides,
        noFunctionCallContractFacts,
        noSliceArgumentLocals);
}

internal fn bool LowerConstructedObjectFieldAssignments(
    borrow IrTable<ConstructedObjectFieldAssignment> assignments,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack u64[0 2 ** 63 - 1] total = assignments.Count();
    stack mut u32[0 max] cursor = 1;
    while willexit ((u64[0 2 ** 63 - 1])cursor <= total)
    {
        stack ConstructedObjectFieldAssignment assignment = assignments.Get(cursor);
        if (!LowerConstructedObjectFieldAssignment(assignment, nodes, instrs, localTypes, localOverrides))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    return true;
}

internal fn bool LowerSourceStorageMutationStatementsWithCallContext(
    borrow IrTable<SourceStorageMutationStatement> statements,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> objectAssignments,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    stack mut u32[0 max] cursor = 1;
    while willexit ((u64[0 2 ** 63 - 1])cursor <= statements.Count())
    {
        if (!LowerSourceStorageMutationStatementWithCallContext(
            statements,
            scalarAssignments,
            enumAssignments,
            objectAssignments,
            cursor,
            nodes,
            instrs,
            localTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    return true;
}

internal fn bool LowerSourceStorageMutationStatementWithCallContext(
    borrow IrTable<SourceStorageMutationStatement> statements,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> objectAssignments,
    u32[0 max] statementIndex,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    if (!statements.Contains(statementIndex))
    {
        return false;
    }

    stack SourceStorageMutationStatement statement = statements.Get(statementIndex);
    if (statement.Kind == SourceStorageMutationKindScalar())
    {
        if (!scalarAssignments.Contains(statement.AssignmentIndex))
        {
            return false;
        }

        stack ScalarStorageAssignment assignment = scalarAssignments.Get(statement.AssignmentIndex);
        return LowerScalarStorageAssignmentWithCallContext(assignment, nodes, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    }

    if (statement.Kind == SourceStorageMutationKindEnum())
    {
        if (!enumAssignments.Contains(statement.AssignmentIndex))
        {
            return false;
        }

        stack EnumStorageAssignment assignment = enumAssignments.Get(statement.AssignmentIndex);
        return LowerEnumStorageAssignmentWithCallContext(assignment, nodes, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    }

    if (statement.Kind == SourceStorageMutationKindConstructedObjectField())
    {
        if (!objectAssignments.Contains(statement.AssignmentIndex))
        {
            return false;
        }

        stack ConstructedObjectFieldAssignment assignment = objectAssignments.Get(statement.AssignmentIndex);
        return LowerConstructedObjectFieldAssignmentWithCallContext(assignment, nodes, instrs, localTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    }

    return false;
}

internal fn bool LowerSourceStorageMutationStatements(
    borrow IrTable<SourceStorageMutationStatement> statements,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> objectAssignments,
    borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<MirInstruction> instrs,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> localOverrides)
{
    stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
    stack mut IrTable<SourceSliceArgumentLocal> noSliceArgumentLocals = new();
    return LowerSourceStorageMutationStatementsWithCallContext(
        statements,
        scalarAssignments,
        enumAssignments,
        objectAssignments,
        nodes,
        instrs,
        localTypes,
        localOverrides,
        noFunctionCallContractFacts,
        noSliceArgumentLocals);
}

internal fn bool TryReadPositiveIntegerToken(borrow TokenStream stream, borrow i8[min max][] source, u64[0 2 ** 63 - 1] token, out u32[0 max] value)
{
    value = 0;
    if (stream.KindAt(token) != TokenKind.IntegerLiteral)
    {
        return false;
    }

    stack i64[min max] parsed = ParseDigitSpan(source, stream.StartAt(token), stream.LengthAt(token));
    if (parsed <= 0 || parsed > 4294967295)
    {
        return false;
    }

    value = (u32[0 max])parsed;
    return true;
}

internal fn bool TryReadNonNegativeIntegerToken(borrow TokenStream stream, borrow i8[min max][] source, u64[0 2 ** 63 - 1] token, out u32[0 max] value)
{
    value = 0;
    if (stream.KindAt(token) != TokenKind.IntegerLiteral)
    {
        return false;
    }

    stack i64[min max] parsed = ParseDigitSpan(source, stream.StartAt(token), stream.LengthAt(token));
    if (parsed < 0 || parsed > 4294967295)
    {
        return false;
    }

    value = (u32[0 max])parsed;
    return true;
}

internal fn bool TryParseArenaSelectorAllocation(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end,
    out u32[0 max] sizeBytes,
    out u32[0 max] alignBytes)
{
    sizeBytes = 0;
    alignBytes = 0;
    stack mut u64[0 2 ** 63 - 1] scan = start;
    while willexit (scan + 5 < end)
    {
        if (stream.KindAt(scan) == TokenKind.New
            && stream.KindAt(scan + 1) == TokenKind.LParen
            && stream.KindAt(scan + 2) == TokenKind.Arena
            && stream.KindAt(scan + 3) == TokenKind.Comma)
        {
            stack mut u32[0 max] size = 0;
            if (!TryReadPositiveIntegerToken(stream, source, scan + 4, size))
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] cursor = scan + 5;
            stack mut u32[0 max] alignment = NaturalAlignmentForByteExtent(size);
            if (stream.KindAt(cursor) == TokenKind.Comma)
            {
                if (!TryReadPositiveIntegerToken(stream, source, cursor + 1, alignment))
                {
                    return false;
                }

                cursor = cursor + 2;
            }

            if (stream.KindAt(cursor) != TokenKind.RParen)
            {
                return false;
            }

            if (!IsPowerOfTwoU32(alignment))
            {
                return false;
            }

            sizeBytes = size;
            alignBytes = alignment;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryParseArenaSelectorCapacity(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end,
    out u32[0 max] capacity,
    out u32[0 max] alignBytes)
{
    capacity = 0;
    alignBytes = 0;
    stack mut u64[0 2 ** 63 - 1] scan = start;
    while willexit (scan + 5 < end)
    {
        if (stream.KindAt(scan) == TokenKind.New
            && stream.KindAt(scan + 1) == TokenKind.LParen
            && stream.KindAt(scan + 2) == TokenKind.Arena
            && stream.KindAt(scan + 3) == TokenKind.Comma)
        {
            stack mut u32[0 max] parsedCapacity = 0;
            if (!TryReadPositiveIntegerToken(stream, source, scan + 4, parsedCapacity))
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] cursor = scan + 5;
            stack mut u32[0 max] parsedAlignment = 0;
            if (stream.KindAt(cursor) == TokenKind.Comma)
            {
                if (!TryReadPositiveIntegerToken(stream, source, cursor + 1, parsedAlignment))
                {
                    return false;
                }

                cursor = cursor + 2;
            }

            if (stream.KindAt(cursor) != TokenKind.RParen)
            {
                return false;
            }

            if (parsedAlignment != 0 && !IsPowerOfTwoU32(parsedAlignment))
            {
                return false;
            }

            capacity = parsedCapacity;
            alignBytes = parsedAlignment;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryParseTargetTypedObjectConstructor(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u64[0 2 ** 63 - 1] assignToken,
    u64[0 2 ** 63 - 1] end)
{
    if (typeToken == 0 || assignToken + 3 > end)
    {
        return false;
    }

    if (stream.KindAt(assignToken + 1) != TokenKind.New)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = assignToken + 2;
    if (stream.KindAt(cursor) == TokenKind.Identifier)
    {
        if (!TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])cursor, typeToken))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    if (cursor + 2 != end)
    {
        return false;
    }

    return stream.KindAt(cursor) == TokenKind.LParen
        && stream.KindAt(cursor + 1) == TokenKind.RParen;
}

internal fn bool TryParseTargetTypedObjectConstructorShape(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u64[0 2 ** 63 - 1] assignToken,
    u64[0 2 ** 63 - 1] end,
    out u32[0 max] bodyOpen,
    out u32[0 max] bodyClose)
{
    bodyOpen = 0;
    bodyClose = 0;
    if (typeToken == 0 || assignToken + 3 > end)
    {
        return false;
    }

    if (stream.KindAt(assignToken + 1) != TokenKind.New)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = assignToken + 2;
    if (stream.KindAt(cursor) == TokenKind.Identifier)
    {
        if (!TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])cursor, typeToken))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    if (stream.KindAt(cursor) != TokenKind.LParen || stream.KindAt(cursor + 1) != TokenKind.RParen)
    {
        return false;
    }

    cursor = cursor + 2;
    if (cursor == end)
    {
        return true;
    }

    if (cursor >= end || stream.KindAt(cursor) != TokenKind.LBrace)
    {
        return false;
    }

    stack u32[0 max] close = MatchingBraceForMirLowering(stream, (u32[0 max])cursor);
    if (close == (u32[0 max])cursor || (u64[0 2 ** 63 - 1])(close + 1) != end)
    {
        return false;
    }

    bodyOpen = (u32[0 max])cursor;
    bodyClose = close;
    return true;
}

internal fn bool TryParseTargetTypedPositionalRecordConstructorShape(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u64[0 2 ** 63 - 1] assignToken,
    u64[0 2 ** 63 - 1] end,
    out u32[0 max] argsOpen,
    out u32[0 max] argsClose)
{
    argsOpen = 0;
    argsClose = 0;
    if (typeToken == 0 || assignToken + 4 > end)
    {
        return false;
    }

    if (stream.KindAt(assignToken + 1) != TokenKind.New)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = assignToken + 2;
    if (stream.KindAt(cursor) == TokenKind.Identifier)
    {
        if (!TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])cursor, typeToken))
        {
            return false;
        }

        cursor = cursor + 1;
    }

    if (stream.KindAt(cursor) != TokenKind.LParen)
    {
        return false;
    }

    stack u32[0 max] close = MatchingParenForMirLowering(stream, (u32[0 max])cursor);
    if (close == (u32[0 max])cursor || (u64[0 2 ** 63 - 1])(close + 1) != end)
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])close == cursor + 1)
    {
        return false;
    }

    argsOpen = (u32[0 max])cursor;
    argsClose = close;
    return true;
}

internal fn u32[0 max] FindSelfHostedDynamicElementTypeToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, start, end);
    if (typeToken == 0)
    {
        return 0;
    }

    stack TokenKind typeKind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    if (typeKind != TokenKind.Dynamic && typeKind != TokenKind.Dyn)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] elementToken = (u64[0 2 ** 63 - 1])typeToken + 1;
    if (elementToken >= end || !TokenCanStartSelfHostedType(stream.KindAt(elementToken)))
    {
        return 0;
    }

    return (u32[0 max])elementToken;
}

internal struct ArenaDynamicLocal
{
    u64[0 2 ** 63 - 1] Start;
    u64[0 2 ** 63 - 1] Length;
    u32[0 max] StorageValue;
    u32[0 max] ElementSize;
    u32[0 max] Alignment;

    ArenaDynamicLocal()
    {
        self.Start = 0;
        self.Length = 0;
        self.StorageValue = 0;
        self.ElementSize = 0;
        self.Alignment = 0;
    }
}

internal fn bool TryFindArenaDynamicLocal(borrow IrTable<ArenaDynamicLocal> locals, borrow i8[min max][] source, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] length, out ArenaDynamicLocal found)
{
    found = new();
    stack u64[0 2 ** 63 - 1] count = locals.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack ArenaDynamicLocal local = locals.Get(i);
        if (SpanEquals(source, local.Start, local.Length, start, length))
        {
            found = local;
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TryLowerArenaDynamicReserveStatement(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ArenaDynamicLocal> arenaDynamicLocals,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] end,
    mut borrow IrTable<MirInstruction> instrs)
{
    if (start + 6 != end
        || stream.KindAt(start) != TokenKind.Identifier
        || stream.KindAt(start + 1) != TokenKind.Dot
        || stream.KindAt(start + 2) != TokenKind.Identifier
        || stream.KindAt(start + 3) != TokenKind.LParen
        || stream.KindAt(start + 5) != TokenKind.RParen)
    {
        return false;
    }

    stack mut u32[0 max] amount = 0;
    if (!TryReadNonNegativeIntegerToken(stream, source, start + 4, amount))
    {
        return false;
    }

    stack mut ArenaDynamicLocal local = new();
    if (!TryFindArenaDynamicLocal(arenaDynamicLocals, source, stream.StartAt(start), stream.LengthAt(start), local))
    {
        return false;
    }

    stack u32[0 max] methodToken = (u32[0 max])(start + 2);
    stack MirValueId storage = MirValueIdOf(local.StorageValue);
    if (TokenTextIsReserveName(stream, source, methodToken))
    {
        stack MirValueId reserve = MirArenaDynamicStorageReserve(instrs, storage, amount, local.ElementSize, local.Alignment);
        return true;
    }

    if (TokenTextIsTryReserveName(stream, source, methodToken))
    {
        stack MirValueId reserve = MirArenaDynamicStorageTryReserve(instrs, storage, amount, local.ElementSize, local.Alignment);
        return true;
    }

    if (TokenTextIsTryReserveCapacityName(stream, source, methodToken))
    {
        stack MirValueId reserve = MirArenaDynamicStorageTryReserveCapacity(instrs, storage, amount, local.ElementSize, local.Alignment);
        return true;
    }

    return false;
}
