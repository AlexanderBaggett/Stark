    }

    return false;
}

internal fn bool BuildSourceSliceArgumentLocals(
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    mut borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals)
{
    stack u64[0 2 ** 63 - 1] count = sliceDescriptorLocals.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack SourceSliceDescriptorLocal descriptor = sliceDescriptorLocals.Get(i);
        stack mut SourceSliceArgumentLocal local = new();
        local.ParamIndex = descriptor.ParamIndex;
        local.ReceiverParamIndex = descriptor.ReceiverParamIndex;
        local.BaseByteOffset = descriptor.BaseByteOffset;
        local.ElementSize = descriptor.ElementSize;
        local.Alignment = descriptor.Alignment;
        local.SliceLength = descriptor.SliceLength;
        local.ElementType = descriptor.ElementType;
        local.FieldTypeCode = descriptor.FieldTypeCode;
        local.IsFixedArrayParam = descriptor.IsFixedArrayParam;
        if (sliceArgumentLocals.Add(local) == 0)
        {
            return false;
        }

        i = i + 1;
    }

    return true;
}

