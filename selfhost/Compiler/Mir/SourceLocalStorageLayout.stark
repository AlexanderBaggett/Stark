internal fn u32[0 max] SourceLocalStoredScalarTypeCodeForMirType(MirType type)
{
    if (type == MirType.I1)
    {
        return SourceLocalTypeCodeStoredBool();
    }

    if (type == MirType.I8)
    {
        return SourceLocalTypeCodeStoredI8();
    }

    if (type == MirType.I16)
    {
        return SourceLocalTypeCodeStoredI16();
    }

    if (type == MirType.I32)
    {
        return SourceLocalTypeCodeStoredI32();
    }

    if (type == MirType.I64)
    {
        return SourceLocalTypeCodeStoredI64();
    }

    if (type == MirType.Ptr)
    {
        return SourceLocalTypeCodeStoredPointer();
    }

    return SourceLocalTypeCodeNonValue();
}

internal inline finite law u32[0 max] SourceRawPointerStorageByteExtent()
{
    return 8;
}

internal inline finite law u32[0 max] SourceRawPointerStorageByteAlignment()
{
    return 8;
}

internal fn bool SourceLocalRawPointerElementQualifier(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Const:
            return true;
        case TokenKind.Frozen:
            return true;
        case TokenKind.Shared:
            return true;
        case TokenKind.Mut:
            return true;
        default:
            return false;
    }
}

internal fn bool TryReadSourceLocalRawPointerScalarElementFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    out MirType elementType,
    out u32[0 max] elementSize,
    out u32[0 max] elementAlignment,
    out u32[0 max] fieldTypeCode,
    out bool rawPointerMutable)
{
    stack mut bool nestedMutable = false;
    stack mut u32[0 max] nestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] nestedElementSize = 0;
    stack mut u32[0 max] nestedElementAlignment = 0;
    return TryReadSourceLocalRawPointerElementFacts(
        stream,
        source,
        typeToken,
        elementType,
        elementSize,
        elementAlignment,
        fieldTypeCode,
        rawPointerMutable,
        nestedMutable,
        nestedFieldTypeCode,
        nestedElementSize,
        nestedElementAlignment);
}

internal fn bool TryReadSourceLocalRawPointerElementFacts(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    out MirType elementType,
    out u32[0 max] elementSize,
    out u32[0 max] elementAlignment,
    out u32[0 max] fieldTypeCode,
    out bool rawPointerMutable,
    out bool nestedMutable,
    out u32[0 max] nestedFieldTypeCode,
    out u32[0 max] nestedElementSize,
    out u32[0 max] nestedElementAlignment)
{
    elementType = MirType.I64;
    elementSize = 0;
    elementAlignment = 0;
    fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    rawPointerMutable = false;
    nestedMutable = false;
    nestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    nestedElementSize = 0;
    nestedElementAlignment = 0;
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    if (kind != TokenKind.Rawptr && kind != TokenKind.Rawmutptr)
    {
        return false;
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])(typeToken + 1)) != TokenKind.Lt)
    {
        return false;
    }

    stack mut u32[0 max] elementToken = typeToken + 2;
    while willexit (SourceLocalRawPointerElementQualifier(stream.KindAt((u64[0 2 ** 63 - 1])elementToken)))
    {
        elementToken = elementToken + 1;
    }

    stack TokenKind elementKind = stream.KindAt((u64[0 2 ** 63 - 1])elementToken);
    if (elementKind == TokenKind.Rawptr || elementKind == TokenKind.Rawmutptr)
    {
        stack mut MirType innerElementType = MirType.I64;
        stack mut u32[0 max] innerElementSize = 0;
        stack mut u32[0 max] innerElementAlignment = 0;
        stack mut u32[0 max] innerFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut bool innerMutable = false;
        stack mut bool ignoredNestedMutable = false;
        stack mut u32[0 max] ignoredNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] ignoredNestedElementSize = 0;
        stack mut u32[0 max] ignoredNestedElementAlignment = 0;
        if (!TryReadSourceLocalRawPointerElementFacts(
            stream,
            source,
            elementToken,
            innerElementType,
            innerElementSize,
            innerElementAlignment,
            innerFieldTypeCode,
            innerMutable,
            ignoredNestedMutable,
            ignoredNestedFieldTypeCode,
            ignoredNestedElementSize,
            ignoredNestedElementAlignment))
        {
            return false;
        }

        elementType = MirType.Ptr;
        elementSize = SourceRawPointerStorageByteExtent();
        elementAlignment = SourceRawPointerStorageByteAlignment();
        fieldTypeCode = SourceResolvedFieldTypeCodePointer();
        rawPointerMutable = kind == TokenKind.Rawmutptr;
        nestedMutable = innerMutable;
        nestedFieldTypeCode = innerFieldTypeCode;
        nestedElementSize = innerElementSize;
        nestedElementAlignment = innerElementAlignment;
        return true;
    }

    if (elementKind == TokenKind.Identifier)
    {
        stack u32[0 max] aggregateSize = TypeKnownByteExtentForLocal(stream, source, elementToken);
        stack u32[0 max] aggregateAlignment = TypeKnownByteAlignment(stream, source, elementToken);
        stack u32[0 max] aggregateTypeCode = SourceResolvedFieldTypeCodeForAggregateTypeToken(elementToken);
        if (aggregateSize == 0
            || aggregateAlignment == 0
            || aggregateTypeCode == SourceResolvedFieldTypeCodeInvalid())
        {
            return false;
        }

        elementType = MirType.Ptr;
        elementSize = aggregateSize;
        elementAlignment = aggregateAlignment;
        fieldTypeCode = aggregateTypeCode;
        rawPointerMutable = kind == TokenKind.Rawmutptr;
        return true;
    }

    stack mut MirType resolvedElementType = MirType.I64;
    if (!MirTypeForKnownSourceScalarTypeHead(stream, source, elementToken, resolvedElementType))
    {
        return false;
    }

    stack u32[0 max] resolvedElementSize = ScalarTypeKnownByteExtent(stream, source, elementToken);
    stack u32[0 max] resolvedElementAlignment = BuiltinTypeKnownByteAlignment(stream, source, elementToken);
    stack u32[0 max] resolvedFieldTypeCode = SourceResolvedFieldTypeCodeForMirType(resolvedElementType);
    if (resolvedElementSize == 0
        || resolvedElementAlignment == 0
        || resolvedFieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    elementType = resolvedElementType;
    elementSize = resolvedElementSize;
    elementAlignment = resolvedElementAlignment;
    fieldTypeCode = resolvedFieldTypeCode;
    rawPointerMutable = kind == TokenKind.Rawmutptr;
    return true;
}

internal fn bool RawPointerInitializerFactsMatchDeclaration(
    bool declaredMutable,
    u32[0 max] declaredFieldTypeCode,
    u32[0 max] declaredElementSize,
    u32[0 max] declaredElementAlignment,
    bool declaredNestedMutable,
    u32[0 max] declaredNestedFieldTypeCode,
    u32[0 max] declaredNestedElementSize,
    u32[0 max] declaredNestedElementAlignment,
    bool initializerMutable,
    u32[0 max] initializerFieldTypeCode,
    u32[0 max] initializerElementSize,
    u32[0 max] initializerElementAlignment,
    bool initializerNestedMutable,
    u32[0 max] initializerNestedFieldTypeCode,
    u32[0 max] initializerNestedElementSize,
    u32[0 max] initializerNestedElementAlignment)
{
    if (declaredFieldTypeCode != initializerFieldTypeCode
        || declaredElementSize != initializerElementSize
        || declaredElementAlignment != initializerElementAlignment
        || declaredNestedMutable != initializerNestedMutable
        || declaredNestedFieldTypeCode != initializerNestedFieldTypeCode
        || declaredNestedElementSize != initializerNestedElementSize
        || declaredNestedElementAlignment != initializerNestedElementAlignment)
    {
        return false;
    }

    return !declaredMutable || initializerMutable;
}

internal fn bool TryDeclareUninitializedRawPointerStorageLocal(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    u64[0 2 ** 63 - 1] nameStart,
    u64[0 2 ** 63 - 1] nameLength,
    u32[0 max] typeToken,
    mut borrow IrTable<ParamName> params,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<u32[0 max]> localRoots,
    mut borrow IrTable<u32[0 max]> localTypes,
    mut borrow IrTable<u32[0 max]> localOverrideValues,
    mut borrow IrTable<ValueFacts> sourceValueFacts,
    mut borrow IrTable<ScalarStorageLocal> scalarStorageLocals)
{
    if (!SelfHostedLocalDeclarationHasMut(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack mut MirType elementType = MirType.I64;
    stack mut u32[0 max] elementSize = 0;
    stack mut u32[0 max] elementAlignment = 0;
    stack mut u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut bool rawPointerMutable = false;
    stack mut bool nestedMutable = false;
    stack mut u32[0 max] nestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] nestedElementSize = 0;
    stack mut u32[0 max] nestedElementAlignment = 0;
    if (!TryReadSourceLocalRawPointerElementFacts(
        stream,
        source,
        typeToken,
        elementType,
        elementSize,
        elementAlignment,
        fieldTypeCode,
        rawPointerMutable,
        nestedMutable,
        nestedFieldTypeCode,
        nestedElementSize,
        nestedElementAlignment))
    {
        return false;
    }

    stack MirValueId pointerStorage = MirStackAlloc(instrs, SourceRawPointerStorageByteExtent(), SourceRawPointerStorageByteAlignment());
    stack u32[0 max] pointerLocalIndex = ResolveParamWithRawPointerElementAndCountAndNestedFacts(
        params,
        source,
        nameStart,
        nameLength,
        rawPointerMutable,
        fieldTypeCode,
        elementSize,
        elementAlignment,
        false,
        false,
        0,
        0,
        nestedMutable,
        nestedFieldTypeCode,
        nestedElementSize,
        nestedElementAlignment);
    if (localRoots.Add(0) == 0
        || localTypes.Add(SourceLocalTypeCodeStoredPointer()) == 0
        || localOverrideValues.Add(pointerStorage.Index()) == 0
        || sourceValueFacts.Add(new ValueFacts()) == 0)
    {
        return false;
    }

    stack mut ScalarStorageLocal pointerLocal = new();
    pointerLocal.Start = nameStart;
    pointerLocal.Length = nameLength;
    pointerLocal.ParamIndex = pointerLocalIndex;
    pointerLocal.StorageValue = pointerStorage.Index();
    pointerLocal.FieldAlignment = SourceRawPointerStorageByteAlignment();
    pointerLocal.FieldType = MirType.Ptr;
    pointerLocal.Mutable = true;
    return scalarStorageLocals.Add(pointerLocal) != 0;
}

internal fn bool TryDeclareUninitializedScalarStorageLocal(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] statementStart,
    u64[0 2 ** 63 - 1] statementEnd,
    u64[0 2 ** 63 - 1] nameStart,
    u64[0 2 ** 63 - 1] nameLength,
    u32[0 max] scalarTypeToken,
    MirType scalarFieldType,
    mut borrow IrTable<ParamName> params,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<u32[0 max]> localRoots,
    mut borrow IrTable<u32[0 max]> localTypes,
    mut borrow IrTable<u32[0 max]> localOverrideValues,
    mut borrow IrTable<ValueFacts> sourceValueFacts,
    mut borrow IrTable<ScalarStorageLocal> scalarStorageLocals)
{
    if (!SelfHostedLocalDeclarationHasMut(stream, statementStart, statementEnd))
    {
        return false;
    }

    stack u32[0 max] scalarAllocationSize = TypeKnownByteExtentForLocal(stream, source, scalarTypeToken);
    stack u32[0 max] scalarAllocationAlign = TypeKnownByteAlignment(stream, source, scalarTypeToken);
    stack u32[0 max] scalarLocalTypeCode = SourceLocalStoredScalarTypeCodeForMirType(scalarFieldType);
    if (scalarAllocationSize == 0
        || scalarAllocationAlign == 0
        || !SourceLocalTypeCodeIsStoredScalar(scalarLocalTypeCode))
    {
        return false;
    }

    stack MirValueId scalarStorage = MirStackAlloc(instrs, scalarAllocationSize, scalarAllocationAlign);
    stack u32[0 max] scalarLocalIndex = ResolveParam(params, source, nameStart, nameLength);
    if (localRoots.Add(0) == 0
        || localTypes.Add(scalarLocalTypeCode) == 0
        || localOverrideValues.Add(scalarStorage.Index()) == 0
        || sourceValueFacts.Add(new ValueFacts()) == 0)
    {
        return false;
    }

    stack mut ScalarStorageLocal scalarLocal = new();
    scalarLocal.Start = nameStart;
    scalarLocal.Length = nameLength;
    scalarLocal.ParamIndex = scalarLocalIndex;
    scalarLocal.StorageValue = scalarStorage.Index();
    scalarLocal.FieldAlignment = scalarAllocationAlign;
    scalarLocal.FieldType = scalarFieldType;
    scalarLocal.Mutable = true;
    return scalarStorageLocals.Add(scalarLocal) != 0;
}

internal fn bool TryGetSourceEnumOwnerDeclarationForToken(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerToken,
    out u32[0 max] ownerDeclarationIndex,
    out Compiler.Parsing.DeclItem enumItem)
{
    ownerDeclarationIndex = 0;
    enumItem = new();

    stack u64[0 2 ** 63 - 1] count = moduleFacts.Declarations.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack Compiler.Parsing.DeclItem item = moduleFacts.Declarations.ItemAt(index);
        if (item.Kind == Compiler.Parsing.DeclarationKind.Enum
            && item.NameToken != 0
            && SourceLocalTokenTextEqualsToken(stream, source, ownerToken, item.NameToken))
        {
            ownerDeclarationIndex = (u32[0 max])index;
            enumItem = item;
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool SourceLocalTokenTextEqualsToken(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] left, u32[0 max] right)
{
    stack u64[0 2 ** 63 - 1] leftIndex = (u64[0 2 ** 63 - 1])left;
    stack u64[0 2 ** 63 - 1] rightIndex = (u64[0 2 ** 63 - 1])right;
    stack u64[0 2 ** 63 - 1] length = stream.LengthAt(leftIndex);
    if (length != stream.LengthAt(rightIndex))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] leftStart = stream.StartAt(leftIndex);
    stack u64[0 2 ** 63 - 1] rightStart = stream.StartAt(rightIndex);
    stack mut u64[0 2 ** 63 - 1] offset = 0;
    while willexit (offset < length)
    {
        if (source[leftStart + offset] != source[rightStart + offset])
        {
            return false;
        }

        offset = offset + 1;
    }

    return true;
}

internal fn bool TryGetSourceEnumVariantOrdinalForToken(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    Compiler.Parsing.DeclItem enumItem,
    u32[0 max] variantToken,
    out u32[0 max] variantOrdinal)
{
    variantOrdinal = 0;
    stack i64[min max] bodyOpenSigned = FirstTokenOfKindAfter(stream, TokenKind.LBrace, (u64[0 2 ** 63 - 1])enumItem.KeywordToken);
    if (bodyOpenSigned < 0)
    {
        return false;
    }

    stack u32[0 max] bodyOpen = (u32[0 max])bodyOpenSigned;
    stack u32[0 max] bodyClose = MatchingBraceForMirLowering(stream, bodyOpen);
    if (bodyClose == bodyOpen)
    {
        return false;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] scan = (u64[0 2 ** 63 - 1])bodyOpen + 1;
    while willexit (scan < (u64[0 2 ** 63 - 1])bodyClose)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (depth == 0 && kind == TokenKind.Identifier)
        {
            if (SourceLocalTokenTextEqualsToken(stream, source, (u32[0 max])scan, variantToken))
            {
                return true;
            }

            variantOrdinal = variantOrdinal + 1;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrace || kind == TokenKind.LBrack || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrace || kind == TokenKind.RBrack || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }

        scan = scan + 1;
    }

    return false;
}

internal finite law u32[0 max] SourceResolvedFieldTypeCodeForTypedEnumPayload(TypedSignatureTypeKind typeKind, u32[0 max] bitWidth)
{
    if (typeKind == TypedSignatureTypeKind.Bool)
    {
        return SourceResolvedFieldTypeCodeBool();
    }

    if (typeKind == TypedSignatureTypeKind.Integer)
    {
        if (bitWidth == 8)
        {
            return SourceResolvedFieldTypeCodeI8();
        }

        if (bitWidth == 16)
        {
            return SourceResolvedFieldTypeCodeI16();
        }

        if (bitWidth == 32)
        {
            return SourceResolvedFieldTypeCodeI32();
        }

        if (bitWidth == 64 || bitWidth == 0)
        {
            return SourceResolvedFieldTypeCodeI64();
        }
    }

    return SourceResolvedFieldTypeCodeInvalid();
}
