module Compiler.Mir.SourceLocalStorageLayout

internal fn u32[0 max] TypeKnownByteExtentForLocal(borrow TokenStream stream, borrow i8[min max][] source, u32[0 max] typeToken)
{
    stack u32[0 max] builtinSize = TypeKnownByteExtent(stream, source, typeToken);
    if (builtinSize != 0)
    {
        return builtinSize;
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.Identifier)
    {
        return StructKnownByteExtent(stream, source, typeToken);
    }

    return 0;
}

internal fn bool TryGetSourceEnumStorageLayoutForToken(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken,
    out u32[0 max] ownerDeclarationIndex,
    out u32[0 max] sizeBytes,
    out u32[0 max] alignBytes)
{
    ownerDeclarationIndex = 0;
    sizeBytes = 0;
    alignBytes = 0;
    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) != TokenKind.Identifier)
    {
        return false;
    }

    stack mut u32[0 max] resolvedOwnerDeclarationIndex = 0;
    stack mut Compiler.Parsing.DeclItem enumItem = new();
    if (!TryGetSourceEnumOwnerDeclarationForToken(stream, source, moduleFacts, typeToken, resolvedOwnerDeclarationIndex, enumItem))
    {
        return false;
    }

    if (!TryGetSourceEnumStorageLayout(moduleFacts, resolvedOwnerDeclarationIndex, sizeBytes, alignBytes))
    {
        return false;
    }

    ownerDeclarationIndex = resolvedOwnerDeclarationIndex;
    return true;
}

internal fn bool TryGetKnownSourceStorageLayoutWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken,
    out u32[0 max] sizeBytes,
    out u32[0 max] alignBytes)
{
    return TryGetKnownSourceStorageLayoutWithEnumsAtDepth(stream, source, moduleFacts, typeToken, 0, sizeBytes, alignBytes);
}

// Field layout for one type token: builtin scalars and fixed arrays, enum
// storage, then named aggregates by recursive struct layout. The depth cap
// bounds mutual recursion through aggregate-typed fields: the mini-Stark
// dialect has no front-end validation, so a cyclic aggregate (struct A holds
// B, B holds A) would otherwise recurse forever instead of rejecting.
internal fn bool TryGetKnownSourceStorageLayoutWithEnumsAtDepth(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken,
    u8[0 16] aggregateDepth,
    out u32[0 max] sizeBytes,
    out u32[0 max] alignBytes)
{
    stack mut u32[0 max] fixedArrayLength = 0;
    stack bool hasFixedArrayLength = TryReadFixedArrayLengthSuffix(stream, source, typeToken, fixedArrayLength);

    sizeBytes = TypeKnownByteExtent(stream, source, typeToken);
    alignBytes = BuiltinTypeKnownByteAlignment(stream, source, typeToken);
    if (sizeBytes != 0 && alignBytes != 0)
    {
        return true;
    }

    stack mut u32[0 max] ownerDeclarationIndex = 0;
    if (TryGetSourceEnumStorageLayoutForToken(stream, source, moduleFacts, typeToken, ownerDeclarationIndex, sizeBytes, alignBytes))
    {
        if (hasFixedArrayLength)
        {
            if (fixedArrayLength == 0 || fixedArrayLength > 4294967295 / sizeBytes)
            {
                sizeBytes = 0;
                alignBytes = 0;
                return false;
            }

            sizeBytes = fixedArrayLength * sizeBytes;
        }

        return true;
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) != TokenKind.Identifier
        || aggregateDepth >= 16)
    {
        sizeBytes = 0;
        alignBytes = 0;
        return false;
    }

    sizeBytes = StructKnownByteExtentWithEnumsAtDepth(stream, source, moduleFacts, typeToken, aggregateDepth + 1);
    alignBytes = StructKnownByteAlignmentWithEnumsAtDepth(stream, source, moduleFacts, typeToken, aggregateDepth + 1);
    if (sizeBytes == 0 || alignBytes == 0)
    {
        return false;
    }

    if (hasFixedArrayLength)
    {
        if (fixedArrayLength == 0 || fixedArrayLength > 4294967295 / sizeBytes)
        {
            sizeBytes = 0;
            alignBytes = 0;
            return false;
        }

        sizeBytes = fixedArrayLength * sizeBytes;
    }

    return true;
}

internal fn bool TryGetSourceValueTypeCodeWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken,
    out MirType fieldType,
    out u32[0 max] fieldTypeCode)
{
    fieldType = MirType.I64;
    fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut MirType resolvedFieldType = MirType.I64;
    if (MirTypeForKnownSourceScalarType(stream, source, typeToken, resolvedFieldType))
    {
        fieldType = resolvedFieldType;
        fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(resolvedFieldType);
        return fieldTypeCode != SourceResolvedFieldTypeCodeInvalid();
    }

    stack mut u32[0 max] ownerDeclarationIndex = 0;
    stack mut u32[0 max] sizeBytes = 0;
    stack mut u32[0 max] alignBytes = 0;
    if (!TryGetSourceEnumStorageLayoutForToken(stream, source, moduleFacts, typeToken, ownerDeclarationIndex, sizeBytes, alignBytes))
    {
        return false;
    }

    fieldTypeCode = SourceResolvedFieldTypeCodeForEnumOwnerDeclarationIndex(ownerDeclarationIndex);
    return true;
}

internal fn u32[0 max] StructKnownByteAlignmentWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken)
{
    return StructKnownByteAlignmentWithEnumsAtDepth(stream, source, moduleFacts, typeToken, 0);
}

internal fn u32[0 max] StructKnownByteAlignmentWithEnumsAtDepth(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken,
    u8[0 16] aggregateDepth)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] maxAlign = 1;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack mut u32[0 max] fieldSize = 0;
                            stack mut u32[0 max] fieldAlign = 0;
                            if (!TryGetKnownSourceStorageLayoutWithEnumsAtDepth(stream, source, moduleFacts, (u32[0 max])segmentStart, aggregateDepth, fieldSize, fieldAlign))
                            {
                                return 0;
                            }

                            if (fieldAlign > maxAlign)
                            {
                                maxAlign = fieldAlign;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack mut u32[0 max] fieldSize = 0;
                    stack mut u32[0 max] fieldAlign = 0;
                    if (!TryGetKnownSourceStorageLayoutWithEnumsAtDepth(stream, source, moduleFacts, (u32[0 max])field, aggregateDepth, fieldSize, fieldAlign))
                    {
                        return 0;
                    }

                    if (fieldAlign > maxAlign)
                    {
                        maxAlign = fieldAlign;
                    }

                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            return maxAlign;
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn u32[0 max] StructKnownByteExtentWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken)
{
    return StructKnownByteExtentWithEnumsAtDepth(stream, source, moduleFacts, typeToken, 0);
}

internal fn u32[0 max] StructKnownByteExtentWithEnumsAtDepth(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken,
    u8[0 16] aggregateDepth)
{
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            stack mut u32[0 max] maxAlign = 1;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack mut u32[0 max] fieldSize = 0;
                            stack mut u32[0 max] fieldAlign = 0;
                            if (!TryGetKnownSourceStorageLayoutWithEnumsAtDepth(stream, source, moduleFacts, (u32[0 max])segmentStart, aggregateDepth, fieldSize, fieldAlign))
                            {
                                return 0;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            offset = offset + fieldSize;
                            if (fieldAlign > maxAlign)
                            {
                                maxAlign = fieldAlign;
                            }

                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack mut u32[0 max] fieldSize = 0;
                    stack mut u32[0 max] fieldAlign = 0;
                    if (!TryGetKnownSourceStorageLayoutWithEnumsAtDepth(stream, source, moduleFacts, (u32[0 max])field, aggregateDepth, fieldSize, fieldAlign))
                    {
                        return 0;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    offset = offset + fieldSize;
                    if (fieldAlign > maxAlign)
                    {
                        maxAlign = fieldAlign;
                    }

                    while willexit (field < count && stream.KindAt(field) != TokenKind.Semi && stream.KindAt(field) != TokenKind.RBrace)
                    {
                        field = field + 1;
                    }
                }

                field = field + 1;
            }

            return AlignUpU32(offset, maxAlign);
        }

        scan = scan + 1;
    }

    return 0;
}

internal fn u32[0 max] TypeKnownByteAlignmentWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken)
{
    stack mut u32[0 max] enumOwner = 0;
    stack mut u32[0 max] enumSize = 0;
    stack mut u32[0 max] enumAlign = 0;
    if (TryGetSourceEnumStorageLayoutForToken(stream, source, moduleFacts, typeToken, enumOwner, enumSize, enumAlign))
    {
        return enumAlign;
    }

    stack u32[0 max] builtinSize = TypeKnownByteExtent(stream, source, typeToken);
    if (builtinSize != 0)
    {
        return NaturalAlignmentForByteExtent(builtinSize);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.Identifier)
    {
        return StructKnownByteAlignmentWithEnums(stream, source, moduleFacts, typeToken);
    }

    return 0;
}

internal fn u32[0 max] TypeKnownByteExtentForLocalWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken)
{
    stack mut u32[0 max] fixedArrayLength = 0;
    if (TryReadFixedArrayLengthSuffix(stream, source, typeToken, fixedArrayLength))
    {
        stack mut u32[0 max] fixedArraySize = 0;
        stack mut u32[0 max] fixedArrayAlign = 0;
        if (TryGetKnownSourceStorageLayoutWithEnums(stream, source, moduleFacts, typeToken, fixedArraySize, fixedArrayAlign))
        {
            return fixedArraySize;
        }

        return 0;
    }

    stack mut u32[0 max] enumOwner = 0;
    stack mut u32[0 max] enumSize = 0;
    stack mut u32[0 max] enumAlign = 0;
    if (TryGetSourceEnumStorageLayoutForToken(stream, source, moduleFacts, typeToken, enumOwner, enumSize, enumAlign))
    {
        return enumSize;
    }

    stack u32[0 max] builtinSize = TypeKnownByteExtent(stream, source, typeToken);
    if (builtinSize != 0)
    {
        return builtinSize;
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) == TokenKind.Identifier)
    {
        return StructKnownByteExtentWithEnums(stream, source, moduleFacts, typeToken);
    }

    return 0;
}

internal fn u64[0 2 ** 63 - 1] FindSelfHostedFieldEnd(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] limit)
{
    stack mut u64[0 2 ** 63 - 1] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < limit)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if ((kind == TokenKind.Semi || kind == TokenKind.RBrace) && depth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }

        scan = scan + 1;
    }

    return limit;
}

internal fn u32[0 max] FindSelfHostedFieldNameToken(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] end)
{
    stack mut u32[0 max] nameToken = 0;
    stack mut u64[0 2 ** 63 - 1] scan = start + 1;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < end)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0)
        {
            nameToken = (u32[0 max])scan;
        }

        scan = scan + 1;
    }

    return nameToken;
}

internal fn bool TryFindStructFieldLayout(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken,
    u32[0 max] fieldNameToken,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out MirType fieldType,
    out u32[0 max] fieldTypeCode)
{
    byteOffset = 0;
    alignBytes = 0;
    fieldType = MirType.I64;
    fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack mut u32[0 max] fieldSize = 0;
                            stack mut u32[0 max] fieldAlign = 0;
                            if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, moduleFacts, (u32[0 max])segmentStart, fieldSize, fieldAlign))
                            {
                                return false;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, segmentStart, headerScan);
                            if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                            {
                                stack mut MirType resolvedType = MirType.I64;
                                stack mut u32[0 max] resolvedTypeCode = SourceResolvedFieldTypeCodeInvalid();
                                if (!TryGetSourceValueTypeCodeWithEnums(stream, source, moduleFacts, (u32[0 max])segmentStart, resolvedType, resolvedTypeCode))
                                {
                                    return false;
                                }

                                byteOffset = offset;
                                alignBytes = fieldAlign;
                                fieldType = resolvedType;
                                fieldTypeCode = resolvedTypeCode;
                                return true;
                            }

                            offset = offset + fieldSize;
                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    stack mut u32[0 max] fieldSize = 0;
                    stack mut u32[0 max] fieldAlign = 0;
                    if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, moduleFacts, (u32[0 max])field, fieldSize, fieldAlign))
                    {
                        return false;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, field, fieldEnd);
                    if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                    {
                        stack mut MirType resolvedType = MirType.I64;
                        stack mut u32[0 max] resolvedTypeCode = SourceResolvedFieldTypeCodeInvalid();
                        if (!TryGetSourceValueTypeCodeWithEnums(stream, source, moduleFacts, (u32[0 max])field, resolvedType, resolvedTypeCode))
                        {
                            return false;
                        }

                        byteOffset = offset;
                        alignBytes = fieldAlign;
                        fieldType = resolvedType;
                        fieldTypeCode = resolvedTypeCode;
                        return true;
                    }

                    offset = offset + fieldSize;
                    field = fieldEnd;
                }

                field = field + 1;
            }

            return false;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryFindStructStorageFieldLayoutWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken,
    u32[0 max] fieldNameToken,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out u32[0 max] fieldTypeToken)
{
    byteOffset = 0;
    alignBytes = 0;
    fieldTypeToken = 0;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] fieldSize = TypeKnownByteExtentForLocalWithEnums(stream, source, moduleFacts, (u32[0 max])segmentStart);
                            stack u32[0 max] fieldAlign = TypeKnownByteAlignmentWithEnums(stream, source, moduleFacts, (u32[0 max])segmentStart);
                            if (fieldSize == 0 || fieldAlign == 0)
                            {
                                return false;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, segmentStart, headerScan);
                            if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                            {
                                byteOffset = offset;
                                alignBytes = fieldAlign;
                                fieldTypeToken = (u32[0 max])segmentStart;
                                return true;
                            }

                            offset = offset + fieldSize;
                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    stack u32[0 max] fieldSize = TypeKnownByteExtentForLocalWithEnums(stream, source, moduleFacts, (u32[0 max])field);
                    stack u32[0 max] fieldAlign = TypeKnownByteAlignmentWithEnums(stream, source, moduleFacts, (u32[0 max])field);
                    if (fieldSize == 0 || fieldAlign == 0)
                    {
                        return false;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, field, fieldEnd);
                    if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                    {
                        byteOffset = offset;
                        alignBytes = fieldAlign;
                        fieldTypeToken = (u32[0 max])field;
                        return true;
                    }

                    offset = offset + fieldSize;
                    field = fieldEnd;
                }

                field = field + 1;
            }

            return false;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool SourceFieldTypeTokenIsAggregateStorage(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] typeToken)
{
    if (stream.KindAt((u64[0 2 ** 63 - 1])typeToken) != TokenKind.Identifier)
    {
        return false;
    }

    stack mut MirType ignoredType = MirType.I64;
    stack mut u32[0 max] ignoredTypeCode = SourceResolvedFieldTypeCodeInvalid();
    if (TryGetSourceValueTypeCodeWithEnums(stream, source, moduleFacts, typeToken, ignoredType, ignoredTypeCode))
    {
        return false;
    }

    return TypeKnownByteExtentForLocalWithEnums(stream, source, moduleFacts, typeToken) != 0
        && TypeKnownByteAlignmentWithEnums(stream, source, moduleFacts, typeToken) != 0;
}

internal fn bool TryResolveConstructedObjectMemberChainStorageField(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] rootTypeToken,
    u64[0 2 ** 63 - 1] firstFieldToken,
    out u64[0 2 ** 63 - 1] nextToken,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out u32[0 max] fieldTypeToken,
    out u32[0 max] leafMemberFactRow)
{
    nextToken = firstFieldToken;
    byteOffset = 0;
    alignBytes = 0;
    fieldTypeToken = 0;
    leafMemberFactRow = 0;

    stack mut u32[0 max] currentTypeToken = rootTypeToken;
    stack mut u64[0 2 ** 63 - 1] fieldToken = firstFieldToken;
    stack mut u32[0 max] accumulatedOffset = 0;
    while willexit (stream.KindAt(fieldToken) == TokenKind.Identifier)
    {
        stack mut u32[0 max] stepFactRow = 0;
        if (!SourceMemberPathFactMatchesFieldStep(
            stream,
            source,
            moduleFacts.MemberFactRowsByToken,
            moduleFacts.MemberPathFacts,
            currentTypeToken,
            (u32[0 max])fieldToken,
            stepFactRow))
        {
            return false;
        }

        stack mut u32[0 max] fieldOffset = 0;
        stack mut u32[0 max] fieldAlignment = 0;
        stack mut u32[0 max] resolvedFieldTypeToken = 0;
        if (!TryFindStructStorageFieldLayoutWithEnums(
            stream,
            source,
            moduleFacts,
            currentTypeToken,
            (u32[0 max])fieldToken,
            fieldOffset,
            fieldAlignment,
            resolvedFieldTypeToken))
        {
            return false;
        }

        if (fieldOffset > 4294967295 - accumulatedOffset)
        {
            return false;
        }

        accumulatedOffset = accumulatedOffset + fieldOffset;
        stack u64[0 2 ** 63 - 1] afterField = fieldToken + 1;
        if (stream.KindAt(afterField) == TokenKind.Dot)
        {
            if (!SourceFieldTypeTokenIsAggregateStorage(stream, source, moduleFacts, resolvedFieldTypeToken))
            {
                return false;
            }

            currentTypeToken = resolvedFieldTypeToken;
            fieldToken = afterField + 1;
            continue;
        }

        nextToken = afterField;
        byteOffset = accumulatedOffset;
        alignBytes = fieldAlignment;
        fieldTypeToken = resolvedFieldTypeToken;
        leafMemberFactRow = stepFactRow;
        return true;
    }

    return false;
}

internal fn bool TryResolveConstructedObjectMemberChainStorageFieldFromDeclarations(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] rootTypeToken,
    u64[0 2 ** 63 - 1] firstFieldToken,
    out u64[0 2 ** 63 - 1] nextToken,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out u32[0 max] fieldTypeToken)
{
    nextToken = firstFieldToken;
    byteOffset = 0;
    alignBytes = 0;
    fieldTypeToken = 0;

    stack mut u32[0 max] currentTypeToken = rootTypeToken;
    stack mut u64[0 2 ** 63 - 1] fieldToken = firstFieldToken;
    stack mut u32[0 max] accumulatedOffset = 0;
    while willexit (stream.KindAt(fieldToken) == TokenKind.Identifier)
    {
        stack mut u32[0 max] fieldOffset = 0;
        stack mut u32[0 max] fieldAlignment = 0;
        stack mut u32[0 max] resolvedFieldTypeToken = 0;
        if (!TryFindStructStorageFieldLayoutWithEnums(
            stream,
            source,
            moduleFacts,
            currentTypeToken,
            (u32[0 max])fieldToken,
            fieldOffset,
            fieldAlignment,
            resolvedFieldTypeToken))
        {
            return false;
        }

        if (fieldOffset > 4294967295 - accumulatedOffset)
        {
            return false;
        }

        accumulatedOffset = accumulatedOffset + fieldOffset;
        stack u64[0 2 ** 63 - 1] afterField = fieldToken + 1;
        if (stream.KindAt(afterField) == TokenKind.Dot)
        {
            if (!SourceFieldTypeTokenIsAggregateStorage(stream, source, moduleFacts, resolvedFieldTypeToken))
            {
                return false;
            }

            currentTypeToken = resolvedFieldTypeToken;
            fieldToken = afterField + 1;
            continue;
        }

        nextToken = afterField;
        byteOffset = accumulatedOffset;
        alignBytes = fieldAlignment;
        fieldTypeToken = resolvedFieldTypeToken;
        return true;
    }

    return false;
}

internal fn bool TryResolveFixedArrayElementLayoutAtField(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] fieldTypeToken,
    u32[0 max] elementIndexToken,
    u32[0 max] fieldOffset,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out MirType elementType)
{
    byteOffset = 0;
    alignBytes = 0;
    elementType = MirType.I64;

    stack mut u32[0 max] arrayLength = 0;
    stack mut u32[0 max] baseOffset = 0;
    stack mut u32[0 max] elementSize = 0;
    if (!TryResolveFixedArrayFieldLayoutAtField(
        stream,
        source,
        fieldTypeToken,
        fieldOffset,
        baseOffset,
        elementSize,
        alignBytes,
        elementType,
        arrayLength))
    {
        return false;
    }

    stack mut u32[0 max] elementIndex = 0;
    if (!TryReadNonNegativeIntegerToken(stream, source, (u64[0 2 ** 63 - 1])elementIndexToken, elementIndex))
    {
        return false;
    }

    if (elementIndex >= arrayLength)
    {
        return false;
    }

    if (elementIndex > 4294967295 / elementSize)
    {
        return false;
    }

    stack u32[0 max] elementOffset = elementIndex * elementSize;
    if (baseOffset > 4294967295 - elementOffset)
    {
        return false;
    }

    byteOffset = baseOffset + elementOffset;
    return true;
}

internal fn bool TryResolveFixedArrayFieldLayoutAtField(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] fieldTypeToken,
    u32[0 max] fieldOffset,
    out u32[0 max] baseByteOffset,
    out u32[0 max] elementSizeBytes,
    out u32[0 max] alignBytes,
    out MirType elementType,
    out u32[0 max] arrayLength)
{
    baseByteOffset = 0;
    elementSizeBytes = 0;
    alignBytes = 0;
    elementType = MirType.I64;
    arrayLength = 0;

    if (!TryReadFixedArrayLengthSuffix(stream, source, fieldTypeToken, arrayLength))
    {
        return false;
    }

    stack mut u32[0 max] ignoredElementTypeCode = SourceResolvedFieldTypeCodeInvalid();
    if (!TryResolveScalarFixedArraySuffixLayoutAtDepth(
        stream,
        source,
        fieldTypeToken,
        0,
        arrayLength,
        elementSizeBytes,
        alignBytes,
        elementType,
        ignoredElementTypeCode))
    {
        return false;
    }

    baseByteOffset = fieldOffset;
    return true;
}

internal fn bool TryResolveFixedArrayStorageFieldLayoutAtField(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] fieldTypeToken,
    u32[0 max] fieldOffset,
    out u32[0 max] baseByteOffset,
    out u32[0 max] elementSizeBytes,
    out u32[0 max] alignBytes,
    out MirType elementType,
    out u32[0 max] elementTypeCode,
    out u32[0 max] arrayLength)
{
    baseByteOffset = 0;
    elementSizeBytes = 0;
    alignBytes = 0;
    elementType = MirType.I64;
    elementTypeCode = SourceResolvedFieldTypeCodeInvalid();
    arrayLength = 0;

    if (!TryReadFixedArrayLengthSuffix(stream, source, fieldTypeToken, arrayLength))
    {
        return false;
    }

    stack u32[0 max] scalarSize = ScalarTypeKnownByteExtent(stream, source, fieldTypeToken);
    if (scalarSize != 0)
    {
        if (!TryResolveScalarFixedArraySuffixLayoutAtDepth(
            stream,
            source,
            fieldTypeToken,
            0,
            arrayLength,
            elementSizeBytes,
            alignBytes,
            elementType,
            elementTypeCode))
        {
            return false;
        }

        baseByteOffset = fieldOffset;
        return true;
    }

    stack mut u32[0 max] enumOwnerDeclarationIndex = 0;
    stack mut u32[0 max] enumSizeBytes = 0;
    stack mut u32[0 max] enumAlignBytes = 0;
    if (TryGetSourceEnumStorageLayoutForToken(
            stream,
            source,
            moduleFacts,
            fieldTypeToken,
            enumOwnerDeclarationIndex,
            enumSizeBytes,
            enumAlignBytes))
    {
        stack u32[0 max] enumTypeCode =
            SourceResolvedFieldTypeCodeForEnumOwnerDeclarationIndex(enumOwnerDeclarationIndex);
        if (enumSizeBytes == 0
            || enumAlignBytes == 0
            || enumTypeCode == SourceResolvedFieldTypeCodeInvalid())
        {
            return false;
        }

        baseByteOffset = fieldOffset;
        elementSizeBytes = enumSizeBytes;
        alignBytes = enumAlignBytes;
        elementType = MirType.EnumValue;
        elementTypeCode = enumTypeCode;
        return true;
    }

    if (!SourceFieldTypeTokenIsAggregateStorage(stream, source, moduleFacts, fieldTypeToken))
    {
        return false;
    }

    stack u32[0 max] aggregateSizeBytes =
        StructKnownByteExtentWithEnums(stream, source, moduleFacts, fieldTypeToken);
    stack u32[0 max] aggregateAlignBytes =
        StructKnownByteAlignmentWithEnums(stream, source, moduleFacts, fieldTypeToken);
    stack u32[0 max] aggregateTypeCode = SourceResolvedFieldTypeCodeForAggregateTypeToken(fieldTypeToken);
    if (aggregateSizeBytes == 0
        || aggregateAlignBytes == 0
        || aggregateTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    baseByteOffset = fieldOffset;
    elementSizeBytes = aggregateSizeBytes;
    alignBytes = aggregateAlignBytes;
    elementType = MirType.Ptr;
    elementTypeCode = aggregateTypeCode;
    return true;
}

internal fn bool TryResolveSliceDescriptorFromConstructedObjectFixedArray(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    u32[0 max] targetTypeToken,
    u64[0 2 ** 63 - 1] initializerStart,
    u64[0 2 ** 63 - 1] initializerEnd,
    out SourceSliceDescriptorLocal descriptor)
    where overlap_all(objectLocals)
{
    descriptor = new();
    if (initializerStart + 2 >= initializerEnd
        || stream.KindAt(initializerStart) != TokenKind.Identifier
        || stream.KindAt(initializerStart + 1) != TokenKind.Dot
        || stream.KindAt(initializerStart + 2) != TokenKind.Identifier)
    {
        return false;
    }

    stack mut MirType targetElementType = MirType.I64;
    if (!MirTypeForKnownSourceScalarTypeHead(stream, source, targetTypeToken, targetElementType))
    {
        return false;
    }

    stack mut ConstructedObjectLocal objectLocal = new();
    if (!TryFindConstructedObjectLocal(objectLocals, source, stream.StartAt(initializerStart), stream.LengthAt(initializerStart), objectLocal))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] nextToken = initializerStart;
    stack mut u32[0 max] fieldOffset = 0;
    stack mut u32[0 max] fieldAlignment = 0;
    stack mut u32[0 max] fieldTypeToken = 0;
    stack mut u32[0 max] leafMemberFactRow = 0;
    if (!TryResolveConstructedObjectMemberChainStorageField(
        stream,
        source,
        moduleFacts,
        objectLocal.TypeToken,
        initializerStart + 2,
        nextToken,
        fieldOffset,
        fieldAlignment,
        fieldTypeToken,
        leafMemberFactRow))
    {
        return false;
    }

    if (nextToken != initializerEnd)
    {
        return false;
    }

    if (!SourceMemberPathFactIsFixedArray(moduleFacts.MemberPathFacts, leafMemberFactRow))
    {
        return false;
    }

    stack mut u32[0 max] baseByteOffset = 0;
    stack mut u32[0 max] elementSizeBytes = 0;
    stack mut u32[0 max] elementAlignment = 0;
    stack mut MirType elementType = MirType.I64;
    stack mut u32[0 max] arrayLength = 0;
    if (!TryResolveFixedArrayFieldLayoutAtField(
        stream,
        source,
        fieldTypeToken,
        fieldOffset,
        baseByteOffset,
        elementSizeBytes,
        elementAlignment,
        elementType,
        arrayLength))
    {
        return false;
    }

    if (elementType != targetElementType)
    {
        return false;
    }

    stack u32[0 max] fieldTypeCode = SourceResolvedFieldTypeCodeForMirType(elementType);
    if (fieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    descriptor.ReceiverParamIndex = objectLocal.ParamIndex;
    descriptor.BaseByteOffset = baseByteOffset;
    descriptor.ElementSize = elementSizeBytes;
    descriptor.Alignment = elementAlignment;
    descriptor.SliceLength = arrayLength;
    descriptor.ElementType = elementType;
    descriptor.FieldTypeCode = fieldTypeCode;
    return true;
}

internal fn bool TryResolveSliceDescriptorFromFixedArrayStorageLocal(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<FixedArrayStorageLocal> fixedArrayLocals,
    u32[0 max] targetTypeToken,
    u64[0 2 ** 63 - 1] initializerStart,
    u64[0 2 ** 63 - 1] initializerEnd,
    out SourceSliceDescriptorLocal descriptor)
    where overlap(source, fixedArrayLocals)
{
    descriptor = new();
    if (initializerStart + 1 != initializerEnd
        || stream.KindAt(initializerStart) != TokenKind.Identifier)
    {
        return false;
    }

    stack mut MirType targetElementType = MirType.I64;
    if (!MirTypeForKnownSourceScalarTypeHead(stream, source, targetTypeToken, targetElementType))
    {
        return false;
    }

    stack mut FixedArrayStorageLocal fixedArrayLocal = new();
    if (!TryFindFixedArrayStorageLocal(fixedArrayLocals, source, stream.StartAt(initializerStart), stream.LengthAt(initializerStart), fixedArrayLocal)
        || fixedArrayLocal.ElementType != targetElementType)
    {
        return false;
    }

    descriptor.ReceiverParamIndex = fixedArrayLocal.ParamIndex;
    descriptor.BaseByteOffset = 0;
    descriptor.ElementSize = fixedArrayLocal.ElementSize;
    descriptor.Alignment = fixedArrayLocal.Alignment;
    descriptor.SliceLength = fixedArrayLocal.ArrayLength;
    descriptor.ElementType = fixedArrayLocal.ElementType;
    descriptor.FieldTypeCode = fixedArrayLocal.FieldTypeCode;
    return true;
}

internal fn SourceSliceDescriptorLocal SourceSliceDescriptorFromFixedArrayStorageLocal(FixedArrayStorageLocal fixedArrayLocal)
{
    stack mut SourceSliceDescriptorLocal descriptor = new();
    descriptor.Start = fixedArrayLocal.Start;
    descriptor.Length = fixedArrayLocal.Length;
    descriptor.Mutable = fixedArrayLocal.Mutable;
    descriptor.ParamIndex = fixedArrayLocal.ParamIndex;
    descriptor.ReceiverParamIndex = fixedArrayLocal.ParamIndex;
    descriptor.BaseByteOffset = fixedArrayLocal.BaseByteOffset;
    descriptor.ElementSize = fixedArrayLocal.ElementSize;
    descriptor.Alignment = fixedArrayLocal.Alignment;
    descriptor.SliceLength = fixedArrayLocal.ArrayLength;
    descriptor.ElementType = fixedArrayLocal.ElementType;
    descriptor.FieldTypeCode = fixedArrayLocal.FieldTypeCode;
    return descriptor;
}

internal fn bool TryResolveSliceDescriptorFromSourceSliceDescriptorLocal(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    u32[0 max] targetTypeToken,
    u64[0 2 ** 63 - 1] initializerStart,
    u64[0 2 ** 63 - 1] initializerEnd,
    out SourceSliceDescriptorLocal descriptor)
    where overlap(source, sliceDescriptorLocals)
{
    descriptor = new();
    if (initializerStart + 1 != initializerEnd
        || stream.KindAt(initializerStart) != TokenKind.Identifier)
    {
        return false;
    }

    stack mut MirType targetElementType = MirType.I64;
    if (!MirTypeForKnownSourceScalarTypeHead(stream, source, targetTypeToken, targetElementType))
    {
        return false;
    }

    stack u32[0 max] targetElementSize = ScalarTypeKnownByteExtent(stream, source, targetTypeToken);
    stack u32[0 max] targetElementAlignment = BuiltinTypeKnownByteAlignment(stream, source, targetTypeToken);
    stack u32[0 max] targetFieldTypeCode = SourceResolvedFieldTypeCodeForMirType(targetElementType);
    stack mut SourceSliceDescriptorLocal existing = new();
    if (!TryFindSourceSliceDescriptorLocal(
            sliceDescriptorLocals,
            source,
            stream.StartAt(initializerStart),
            stream.LengthAt(initializerStart),
            existing)
        || existing.SliceLength == 0
        || existing.ElementType != targetElementType
        || existing.ElementSize != targetElementSize
        || existing.Alignment != targetElementAlignment
        || existing.FieldTypeCode != targetFieldTypeCode)
    {
        return false;
    }

    descriptor = existing;
    return true;
}

internal fn bool TryFindStructFixedArrayElementLayout(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u32[0 max] fieldNameToken,
    u32[0 max] elementIndexToken,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out MirType elementType)
{
    byteOffset = 0;
    alignBytes = 0;
    elementType = MirType.I64;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])segmentStart);
                            stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])segmentStart);
                            if (fieldSize == 0 || fieldAlign == 0)
                            {
                                return false;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, segmentStart, headerScan);
                            if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                            {
                                return TryResolveFixedArrayElementLayoutAtField(
                                    stream,
                                    source,
                                    (u32[0 max])segmentStart,
                                    elementIndexToken,
                                    offset,
                                    byteOffset,
                                    alignBytes,
                                    elementType);
                            }

                            offset = offset + fieldSize;
                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])field);
                    stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])field);
                    if (fieldSize == 0 || fieldAlign == 0)
                    {
                        return false;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, field, fieldEnd);
                    if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                    {
                        return TryResolveFixedArrayElementLayoutAtField(
                            stream,
                            source,
                            (u32[0 max])field,
                            elementIndexToken,
                            offset,
                            byteOffset,
                            alignBytes,
                            elementType);
                    }

                    offset = offset + fieldSize;
                    field = fieldEnd;
                }

                field = field + 1;
            }

            return false;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryFindStructFixedArrayFieldLayout(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    u32[0 max] fieldNameToken,
    out u32[0 max] baseByteOffset,
    out u32[0 max] elementSizeBytes,
    out u32[0 max] alignBytes,
    out MirType elementType,
    out u32[0 max] arrayLength)
{
    baseByteOffset = 0;
    elementSizeBytes = 0;
    alignBytes = 0;
    elementType = MirType.I64;
    arrayLength = 0;
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (TokenKindIsSelfHostedAggregateDeclaration(stream.KindAt(scan))
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack mut u32[0 max] offset = 0;
            if (stream.KindAt(scan) == TokenKind.Record)
            {
                stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
                if (headerOpen != 0)
                {
                    stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
                    stack mut u64[0 2 ** 63 - 1] segmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
                    stack mut u64[0 2 ** 63 - 1] headerScan = segmentStart;
                    stack mut u32[0 max] depth = 0;
                    while willexit (headerScan <= (u64[0 2 ** 63 - 1])headerClose)
                    {
                        stack TokenKind headerKind = stream.KindAt(headerScan);
                        stack mut bool boundary = headerScan == (u64[0 2 ** 63 - 1])headerClose;
                        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
                        {
                            depth = depth + 1;
                        }
                        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
                        {
                            if (depth > 0)
                            {
                                depth = depth - 1;
                            }
                        }

                        if (depth == 0 && headerKind == TokenKind.Comma)
                        {
                            boundary = true;
                        }

                        if (boundary && segmentStart < headerScan)
                        {
                            stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])segmentStart);
                            stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])segmentStart);
                            if (fieldSize == 0 || fieldAlign == 0)
                            {
                                return false;
                            }

                            offset = AlignUpU32(offset, fieldAlign);
                            stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, segmentStart, headerScan);
                            if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                            {
                                return TryResolveFixedArrayFieldLayoutAtField(
                                    stream,
                                    source,
                                    (u32[0 max])segmentStart,
                                    offset,
                                    baseByteOffset,
                                    elementSizeBytes,
                                    alignBytes,
                                    elementType,
                                    arrayLength);
                            }

                            offset = offset + fieldSize;
                            segmentStart = headerScan + 1;
                        }

                        headerScan = headerScan + 1;
                    }
                }
            }

            stack mut u64[0 2 ** 63 - 1] field = FindSelfHostedAggregateBodyFieldStart(stream, scan + 1);
            while willexit (field < count && stream.KindAt(field) != TokenKind.RBrace)
            {
                stack mut u64[0 2 ** 63 - 1] memberNext = field;
                if (TrySkipSelfHostedAggregateBodyMemberWithBody(stream, field, count, memberNext))
                {
                    field = memberNext;
                    continue;
                }

                if (TokenCanStartSelfHostedType(stream.KindAt(field)))
                {
                    stack u64[0 2 ** 63 - 1] fieldEnd = FindSelfHostedFieldEnd(stream, field, count);
                    stack u32[0 max] fieldSize = TypeKnownByteExtent(stream, source, (u32[0 max])field);
                    stack u32[0 max] fieldAlign = BuiltinTypeKnownByteAlignment(stream, source, (u32[0 max])field);
                    if (fieldSize == 0 || fieldAlign == 0)
                    {
                        return false;
                    }

                    offset = AlignUpU32(offset, fieldAlign);
                    stack u32[0 max] nameToken = FindSelfHostedFieldNameToken(stream, field, fieldEnd);
                    if (nameToken != 0 && TokenTextEqualsAsciiSpan(stream, source, nameToken, fieldNameToken))
                    {
                        return TryResolveFixedArrayFieldLayoutAtField(
                            stream,
                            source,
                            (u32[0 max])field,
                            offset,
                            baseByteOffset,
                            elementSizeBytes,
                            alignBytes,
                            elementType,
                            arrayLength);
                    }

                    offset = offset + fieldSize;
                    field = fieldEnd;
                }

                field = field + 1;
            }

            return false;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn u64[0 2 ** 63 - 1] FindObjectInitializerEntryEnd(borrow TokenStream stream, u64[0 2 ** 63 - 1] start, u64[0 2 ** 63 - 1] close)
{
    stack mut u64[0 2 ** 63 - 1] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < close)
    {
        stack TokenKind kind = stream.KindAt(scan);
        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = depth + 1;
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = depth - 1;
            }
        }
        else if (kind == TokenKind.Comma && depth == 0)
        {
            return scan;
        }

        scan = scan + 1;
    }

    return close;
}

internal struct RecordHeaderFieldLayoutCursor
{
    u64[0 2 ** 63 - 1] HeaderClose;
    u64[0 2 ** 63 - 1] SegmentStart;
    u64[0 2 ** 63 - 1] HeaderScan;
    u32[0 max] Depth;
    u32[0 max] Offset;

    RecordHeaderFieldLayoutCursor()
    {
        self.HeaderClose = 0;
        self.SegmentStart = 0;
        self.HeaderScan = 0;
        self.Depth = 0;
        self.Offset = 0;
    }
}

internal fn bool TryStartRecordHeaderFieldLayoutCursor(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    u32[0 max] typeToken,
    out RecordHeaderFieldLayoutCursor cursor)
{
    cursor = new();
    stack u64[0 2 ** 63 - 1] count = stream.Count();
    stack mut u64[0 2 ** 63 - 1] scan = 0;
    while willexit (scan < count)
    {
        if (stream.KindAt(scan) == TokenKind.Record
            && stream.KindAt(scan + 1) == TokenKind.Identifier
            && TokenTextEqualsAsciiSpan(stream, source, (u32[0 max])(scan + 1), typeToken))
        {
            stack u32[0 max] headerOpen = FindSelfHostedRecordHeaderOpenToken(stream, scan + 1);
            if (headerOpen == 0)
            {
                return false;
            }

            stack u32[0 max] headerClose = MatchingParenForMirLowering(stream, headerOpen);
            cursor.HeaderClose = (u64[0 2 ** 63 - 1])headerClose;
            cursor.SegmentStart = (u64[0 2 ** 63 - 1])headerOpen + 1;
            cursor.HeaderScan = cursor.SegmentStart;
            return true;
        }

        scan = scan + 1;
    }

    return false;
}

internal fn bool TryReadNextRecordHeaderFieldLayout(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    mut borrow RecordHeaderFieldLayoutCursor cursor,
    out u32[0 max] byteOffset,
    out u32[0 max] alignBytes,
    out MirType fieldType,
    out u32[0 max] fieldTypeCode)
{
    byteOffset = 0;
    alignBytes = 0;
    fieldType = MirType.I64;
    fieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    while willexit (cursor.HeaderScan <= cursor.HeaderClose)
    {
        stack TokenKind headerKind = stream.KindAt(cursor.HeaderScan);
        stack mut bool boundary = cursor.HeaderScan == cursor.HeaderClose;
        if (headerKind == TokenKind.LParen || headerKind == TokenKind.LBrack || headerKind == TokenKind.LBrace || headerKind == TokenKind.Lt)
        {
            cursor.Depth = cursor.Depth + 1;
        }
        else if (headerKind == TokenKind.RParen || headerKind == TokenKind.RBrack || headerKind == TokenKind.RBrace || headerKind == TokenKind.Gt)
        {
            if (cursor.Depth > 0)
            {
                cursor.Depth = cursor.Depth - 1;
            }
        }

        if (cursor.Depth == 0 && headerKind == TokenKind.Comma)
        {
            boundary = true;
        }

        if (boundary && cursor.SegmentStart < cursor.HeaderScan)
        {
            stack mut u32[0 max] fieldSize = 0;
            stack mut u32[0 max] fieldAlign = 0;
            if (!TryGetKnownSourceStorageLayoutWithEnums(stream, source, moduleFacts, (u32[0 max])cursor.SegmentStart, fieldSize, fieldAlign))
            {
                return false;
            }

            stack mut MirType resolvedType = MirType.I64;
            stack mut u32[0 max] resolvedTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!TryGetSourceValueTypeCodeWithEnums(stream, source, moduleFacts, (u32[0 max])cursor.SegmentStart, resolvedType, resolvedTypeCode))
            {
                return false;
            }

            cursor.Offset = AlignUpU32(cursor.Offset, fieldAlign);
            byteOffset = cursor.Offset;
            alignBytes = fieldAlign;
            fieldType = resolvedType;
            fieldTypeCode = resolvedTypeCode;
            cursor.Offset = cursor.Offset + fieldSize;
            cursor.SegmentStart = cursor.HeaderScan + 1;
            cursor.HeaderScan = cursor.HeaderScan + 1;
            return true;
        }

        cursor.HeaderScan = cursor.HeaderScan + 1;
    }

    return false;
}

