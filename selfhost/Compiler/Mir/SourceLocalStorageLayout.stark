internal fn bool TryFindConstructedObjectLocal(
    borrow IrTable<ConstructedObjectLocal> objectLocals,
    borrow i8[min max][] source,
    u64[0 2 ** 63 - 1] start,
    u64[0 2 ** 63 - 1] length,
    out ConstructedObjectLocal found)
    where overlap(objectLocals, source)
{
    found = new();
    stack u64[0 2 ** 63 - 1] count = objectLocals.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack ConstructedObjectLocal local = objectLocals.Get(i);
        if (SpanEquals(source, local.Start, local.Length, start, length))
        {
            found = local;
            return true;
        }

        i = i + 1;
    }

    return false;
}

