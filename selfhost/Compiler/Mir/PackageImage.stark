internal fn bool LogicalPackageImageJsonMaterializeGenericTemplateFactRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] genericTemplatesNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageGenericTemplateFactGraph graph,
    out u32[0 max] functionTemplateCount)
{
    functionTemplateCount = 0;
    stack mut u64[0 2 ** 63 - 1] functionsNode = 0;
    if (!LogicalPackageImageJsonRequiredArrayMember(
        document,
        genericTemplatesNode,
        "Functions",
        functionsNode,
        functionTemplateCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < functionTemplateCount)
    {
        stack mut u64[0 2 ** 63 - 1] functionNode = 0;
        stack mut u32[0 max] templateRow = 0;
        if (!document.TryChildAt(functionsNode, (u64[0 2 ** 63 - 1])index, functionNode)
            || document.KindAt(functionNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeFunctionTemplateRow(
                document,
                functionNode,
                moduleOrdinal,
                index,
                graph,
                templateRow))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeGlobalFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageTypedGlobalFactTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow LogicalPackageTypedGlobalFactGraph graph,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    return LogicalPackageTypedGlobalFactGraphAddTextRow(graph, textKind, textOrdinal, value, false, textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeOptionalGlobalFactTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageTypedGlobalFactTextKind textKind,
    u32[0 max] textOrdinal,
    bool allowEmpty,
    mut borrow LogicalPackageTypedGlobalFactGraph graph,
    out bool present,
    out u32[0 max] textRow)
{
    present = false;
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) < 0
        || (!allowEmpty && System.Text.AsciiLength(value) == 0))
    {
        return false;
    }

    if (!LogicalPackageTypedGlobalFactGraphAddTextRow(
        graph,
        textKind,
        textOrdinal,
        value,
        allowEmpty,
        textRow))
    {
        return false;
    }

    present = true;
    return true;
}

