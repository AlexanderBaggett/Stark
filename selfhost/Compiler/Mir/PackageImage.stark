                LogicalPackageTypedCallableFactTextKind.AsmInputValueName,
                inputIndex,
                graph,
                valueNameTextRow)
            || !LogicalPackageTypedCallableFactGraphAddAsmInputRow(
                graph,
                asmRow,
                inputIndex,
                registerNameTextRow,
                valueNameTextRow))
        {
            return false;
        }

        inputIndex = inputIndex + 1;
    }

    stack mut u32[0 max] outputIndex = 0;
    while willexit (outputIndex < outputCount)
    {
        stack mut u64[0 2 ** 63 - 1] outputNode = 0;
        stack mut bool bindsReturnValue = false;
        stack mut u32[0 max] registerNameTextRow = 0;
        stack mut u32[0 max] valueNameTextRow = 0;
        if (!document.TryChildAt(outputsNode, (u64[0 2 ** 63 - 1])outputIndex, outputNode)
            || document.KindAt(outputNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeCallableFactTextMemberRow(
                document,
                outputNode,
