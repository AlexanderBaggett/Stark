    switch (declarationKind)
    {
        case LogicalPackageTypedDeclarationKind.TypeAlias:
            return true;
        case LogicalPackageTypedDeclarationKind.Type:
        case LogicalPackageTypedDeclarationKind.Function:
        case LogicalPackageTypedDeclarationKind.Global:
            if (!LogicalPackageImageJsonAppendRequiredTextMember(document, declarationNode, "Kind", manifestKind))
            {
                return false;
            }

            hasManifestKind = true;
            return true;
    }
}

