internal fn bool LogicalPackageTypedGlobalFactGraphAddInitializerRow(
    mut borrow LogicalPackageTypedGlobalFactGraph graph,
    u32[0 max] parentInitializerRow,
    u32[0 max] parentChildOrdinal,
    u32[0 max] moduleOrdinal,
    u32[0 max] globalOrdinal,
    u32[0 max] initializerOrdinal,
    u32[0 max] kindTextRow,
    u32[0 max] typeReferenceRow,
    bool hasIntegerValue,
    u32[0 max] integerValueTextRow,
    bool hasFloatLiteralText,
    u32[0 max] floatLiteralTextRow,
    bool hasBoolValue,
    bool boolValue,
    bool hasTextLiteralText,
    u32[0 max] textLiteralTextRow,
    bool hasVariantName,
    u32[0 max] variantNameTextRow,
    out u32[0 max] initializerRow)
{
    initializerRow = 0;
    if ((parentInitializerRow != 0 && !graph.InitializerRows.Contains(parentInitializerRow))
        || !graph.TextRows.Contains(kindTextRow)
        || !graph.TypeReferences.ContainsTypeReference(typeReferenceRow)
        || (hasIntegerValue && !graph.TextRows.Contains(integerValueTextRow))
        || (!hasIntegerValue && integerValueTextRow != 0)
        || (hasFloatLiteralText && !graph.TextRows.Contains(floatLiteralTextRow))
        || (!hasFloatLiteralText && floatLiteralTextRow != 0)
        || (hasTextLiteralText && !graph.TextRows.Contains(textLiteralTextRow))
        || (!hasTextLiteralText && textLiteralTextRow != 0)
        || (hasVariantName && !graph.TextRows.Contains(variantNameTextRow))
        || (!hasVariantName && variantNameTextRow != 0))
    {
        return false;
    }

    stack LogicalPackageTypedConstantInitializerRow row = new LogicalPackageTypedConstantInitializerRow()
    {
        ParentInitializerRowValue = parentInitializerRow,
        ParentChildOrdinalValue = parentChildOrdinal,
        ModuleOrdinalValue = moduleOrdinal,
        GlobalOrdinalValue = globalOrdinal,
        InitializerOrdinalValue = initializerOrdinal,
        KindTextRowValue = kindTextRow,
        TypeReferenceRowValue = typeReferenceRow,
        IntegerValueTextRowValue = integerValueTextRow,
        FloatLiteralTextRowValue = floatLiteralTextRow,
        TextLiteralTextRowValue = textLiteralTextRow,
        VariantNameTextRowValue = variantNameTextRow,
        HasIntegerValueValue = hasIntegerValue,
        HasFloatLiteralTextValue = hasFloatLiteralText,
        HasBoolValueValue = hasBoolValue,
        BoolValueValue = boolValue,
        HasTextLiteralTextValue = hasTextLiteralText,
        HasVariantNameValue = hasVariantName
    };
    stack u32[0 max] addedRow = graph.InitializerRows.Add(row);
    if (addedRow == 0)
    {
        return false;
    }

    if (parentInitializerRow != 0)
    {
        stack mut LogicalPackageTypedConstantInitializerRow parent =
            graph.InitializerRows.Get(parentInitializerRow);
        if (parent.ElementRowCountValue == 0)
        {
            parent.FirstElementRowValue = addedRow;
        }
        else if (addedRow != parent.FirstElementRowValue + parent.ElementRowCountValue)
        {
            return false;
        }

        parent.ElementRowCountValue = parent.ElementRowCountValue + 1;
        if (!graph.InitializerRows.Replace(parentInitializerRow, parent))
        {
            return false;
        }
    }

    initializerRow = addedRow;
    return true;
}

internal fn MemoryStatus LogicalPackageTypedTypeFactGraphAppendText(
    mut borrow LogicalPackageTypedTypeFactGraph graph,
    ascii text,
    out u32[0 max] byteOffset,
    out u32[0 max] byteLength)
{
    byteOffset = 0;
    byteLength = 0;
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength <= 0 || signedLength > (i64[min max])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    if (graph.TextBytes.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || graph.TextBytes.Length + (u64[0 2 ** 63 - 1])signedLength > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    byteOffset = (u32[0 max])graph.TextBytes.Length;
    byteLength = (u32[0 max])signedLength;
    unsafe
    {
        stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
        if (data == null)
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        if (!graph.TextBytes.TryReserve((u64[0 2 ** 63 - 1])signedLength))
        {
            return MemoryStatus.Err(MemoryError.OutOfMemory);
        }

        for willexit (stack mut i64[min max] index = 0; index < signedLength; index += 1)
        {
            init graph.TextBytes[graph.TextBytes.Length] = *(&data[index]);
        }
    }

    return MemoryStatus.Ok;
}

internal fn bool LogicalPackageTypedTypeFactGraphAddTextRow(
    mut borrow LogicalPackageTypedTypeFactGraph graph,
    LogicalPackageTypedTypeFactTextKind textKind,
    u32[0 max] textOrdinal,
    ascii text,
    out u32[0 max] textRow)
{
    textRow = 0;
    stack mut u32[0 max] byteOffset = 0;
    stack mut u32[0 max] byteLength = 0;
    switch (LogicalPackageTypedTypeFactGraphAppendText(graph, text, byteOffset, byteLength))
    {
        case MemoryStatus.Err(var error):
            return false;
        case MemoryStatus.Ok:
            stack LogicalPackageTypedTypeFactTextRow row = new LogicalPackageTypedTypeFactTextRow()
            {
                TextKindValue = textKind,
                TextOrdinalValue = textOrdinal,
                ByteOffsetValue = byteOffset,
                ByteLengthValue = byteLength
            };
            textRow = graph.TextRows.Add(row);
            return textRow != 0;
    }
}

