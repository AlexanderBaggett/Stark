public fn bool TryAppendLogicalPackageTypeReferenceText(
    borrow LogicalPackageTypeReferenceGraph graph,
    u32[0 max] typeReferenceRow,
    LogicalPackageTypeReferenceTextKind textKind,
    u32[0 max] textOrdinal,
    mut borrow OwnedAscii sink)
{
    if (!graph.TypeReferenceRows.Contains(typeReferenceRow))
    {
        return false;
    }

    stack LogicalPackageTypeReferenceRow row = graph.TypeReferenceRows.Get(typeReferenceRow);
    stack mut u32[0 max] offset = 0;
    while willexit (offset < row.TextRowCountValue)
    {
        stack u32[0 max] textRowIndex = row.FirstTextRowValue + offset;
        if (!graph.TextRows.Contains(textRowIndex))
        {
            return false;
        }

        stack LogicalPackageTypeReferenceTextRow textRow = graph.TextRows.Get(textRowIndex);
        if (textRow.TextKindValue == textKind
            && textRow.TextOrdinalValue == textOrdinal)
        {
            return AppendLogicalPackageTypeReferenceText(graph, textRow, sink) == MemoryStatus.Ok;
        }

        offset = offset + 1;
    }

    return false;
}

