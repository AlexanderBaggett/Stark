    stack u64[0 max] totalLength = floatConstantOffset + (u64[0 max])floatConstantBuf.Count();
    stack bool reserved = TryReservePackageImageCapacity(buf, totalLength);

    WriteSectionedPackageImageHeader(buf, sectionCount);
    WritePackageSectionDirectoryEntry(buf, PackageSectionInstructions(), SectionFlagsRequired(), instrOffset, (u64[0 max])instrBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionBlocks(), SectionFlagsRequired(), blockOffset, (u64[0 max])blockBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionFunctions(), SectionFlagsRequired(), funcOffset, (u64[0 max])funcBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionGlobals(), SectionFlagsRequired(), globalOffset, (u64[0 max])globalBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionFloatPayloadBytes(), SectionFlagsRequired(), floatPayloadOffset, (u64[0 max])floatPayloadBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionFloatConstants(), SectionFlagsRequired(), floatConstantOffset, (u64[0 max])floatConstantBuf.Count(), SectionEncodingRaw());
    AppendBytes(buf, instrBuf);
    AppendBytes(buf, blockBuf);
    AppendBytes(buf, funcBuf);
    AppendBytes(buf, globalBuf);
    AppendBytes(buf, floatPayloadBuf);
    AppendBytes(buf, floatConstantBuf);
}

public fn void SerializeSectionedPackageImageWithAsm(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals,
    borrow AsmMetadataTable asmMetadata,
    mut borrow IrTable<u8[0 max]> buf)
{
    stack mut IrTable<u8[0 max]> instrBuf = new();
    SerializeInstructions(instrs, 1, (u32[0 max])instrs.Count(), instrBuf);
    stack mut IrTable<u8[0 max]> blockBuf = new();
    SerializeBlocks(blocks, blockBuf);
    stack mut IrTable<u8[0 max]> funcBuf = new();
    SerializeFunctions(funcs, funcBuf);
    stack mut IrTable<u8[0 max]> globalBuf = new();
    SerializeGlobals(globals, globalBuf);
    stack mut IrTable<u8[0 max]> asmBuf = new();
    SerializeAsmMetadata(asmMetadata, asmBuf);

    stack u32[0 max] sectionCount = 5;
    stack u64[0 max] instrOffset = PackageImageDataOffset(sectionCount);
    stack u64[0 max] blockOffset = instrOffset + (u64[0 max])instrBuf.Count();
    stack u64[0 max] funcOffset = blockOffset + (u64[0 max])blockBuf.Count();
    stack u64[0 max] globalOffset = funcOffset + (u64[0 max])funcBuf.Count();
    stack u64[0 max] asmOffset = globalOffset + (u64[0 max])globalBuf.Count();
    stack u64[0 max] totalLength = asmOffset + (u64[0 max])asmBuf.Count();
    stack bool reserved = TryReservePackageImageCapacity(buf, totalLength);

    WriteSectionedPackageImageHeader(buf, sectionCount);
    WritePackageSectionDirectoryEntry(buf, PackageSectionInstructions(), SectionFlagsRequired(), instrOffset, (u64[0 max])instrBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionBlocks(), SectionFlagsRequired(), blockOffset, (u64[0 max])blockBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionFunctions(), SectionFlagsRequired(), funcOffset, (u64[0 max])funcBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionGlobals(), SectionFlagsRequired(), globalOffset, (u64[0 max])globalBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionAsmMetadata(), SectionFlagsRequired(), asmOffset, (u64[0 max])asmBuf.Count(), SectionEncodingRaw());
    AppendBytes(buf, instrBuf);
    AppendBytes(buf, blockBuf);
    AppendBytes(buf, funcBuf);
    AppendBytes(buf, globalBuf);
    AppendBytes(buf, asmBuf);
}

public fn void SerializeSectionedPackageImageWithEnumLayoutFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals,
    borrow IrTable<MirEnumLayoutFact> enumLayoutFacts,
    mut borrow IrTable<u8[0 max]> buf)
{
    stack mut IrTable<u8[0 max]> instrBuf = new();
    SerializeInstructions(instrs, 1, (u32[0 max])instrs.Count(), instrBuf);
    stack mut IrTable<u8[0 max]> blockBuf = new();
    SerializeBlocks(blocks, blockBuf);
    stack mut IrTable<u8[0 max]> funcBuf = new();
    SerializeFunctions(funcs, funcBuf);
    stack mut IrTable<u8[0 max]> globalBuf = new();
    SerializeGlobals(globals, globalBuf);
    stack mut IrTable<u8[0 max]> enumLayoutBuf = new();
    SerializeEnumLayoutFacts(enumLayoutFacts, enumLayoutBuf);

    stack u32[0 max] sectionCount = 5;
    stack u64[0 max] instrOffset = PackageImageDataOffset(sectionCount);
    stack u64[0 max] blockOffset = instrOffset + (u64[0 max])instrBuf.Count();
    stack u64[0 max] funcOffset = blockOffset + (u64[0 max])blockBuf.Count();
    stack u64[0 max] globalOffset = funcOffset + (u64[0 max])funcBuf.Count();
    stack u64[0 max] enumLayoutOffset = globalOffset + (u64[0 max])globalBuf.Count();
    stack u64[0 max] totalLength = enumLayoutOffset + (u64[0 max])enumLayoutBuf.Count();
    stack bool reserved = TryReservePackageImageCapacity(buf, totalLength);

    WriteSectionedPackageImageHeader(buf, sectionCount);
    WritePackageSectionDirectoryEntry(buf, PackageSectionInstructions(), SectionFlagsRequired(), instrOffset, (u64[0 max])instrBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionBlocks(), SectionFlagsRequired(), blockOffset, (u64[0 max])blockBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionFunctions(), SectionFlagsRequired(), funcOffset, (u64[0 max])funcBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionGlobals(), SectionFlagsRequired(), globalOffset, (u64[0 max])globalBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionEnumLayoutFacts(), SectionFlagsRequired(), enumLayoutOffset, (u64[0 max])enumLayoutBuf.Count(), SectionEncodingRaw());
    AppendBytes(buf, instrBuf);
    AppendBytes(buf, blockBuf);
    AppendBytes(buf, funcBuf);
    AppendBytes(buf, globalBuf);
    AppendBytes(buf, enumLayoutBuf);
}

public fn void SerializeSectionedPackageImageWithAsmAndEnumLayoutFacts(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals,
    borrow AsmMetadataTable asmMetadata,
    borrow IrTable<MirEnumLayoutFact> enumLayoutFacts,
    mut borrow IrTable<u8[0 max]> buf)
{
    stack mut IrTable<u8[0 max]> instrBuf = new();
    SerializeInstructions(instrs, 1, (u32[0 max])instrs.Count(), instrBuf);
    stack mut IrTable<u8[0 max]> blockBuf = new();
    SerializeBlocks(blocks, blockBuf);
    stack mut IrTable<u8[0 max]> funcBuf = new();
    SerializeFunctions(funcs, funcBuf);
    stack mut IrTable<u8[0 max]> globalBuf = new();
    SerializeGlobals(globals, globalBuf);
    stack mut IrTable<u8[0 max]> asmBuf = new();
    SerializeAsmMetadata(asmMetadata, asmBuf);
    stack mut IrTable<u8[0 max]> enumLayoutBuf = new();
    SerializeEnumLayoutFacts(enumLayoutFacts, enumLayoutBuf);

    stack u32[0 max] sectionCount = 6;
    stack u64[0 max] instrOffset = PackageImageDataOffset(sectionCount);
    stack u64[0 max] blockOffset = instrOffset + (u64[0 max])instrBuf.Count();
    stack u64[0 max] funcOffset = blockOffset + (u64[0 max])blockBuf.Count();
    stack u64[0 max] globalOffset = funcOffset + (u64[0 max])funcBuf.Count();
    stack u64[0 max] asmOffset = globalOffset + (u64[0 max])globalBuf.Count();
    stack u64[0 max] enumLayoutOffset = asmOffset + (u64[0 max])asmBuf.Count();
    stack u64[0 max] totalLength = enumLayoutOffset + (u64[0 max])enumLayoutBuf.Count();
    stack bool reserved = TryReservePackageImageCapacity(buf, totalLength);

    WriteSectionedPackageImageHeader(buf, sectionCount);
    WritePackageSectionDirectoryEntry(buf, PackageSectionInstructions(), SectionFlagsRequired(), instrOffset, (u64[0 max])instrBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionBlocks(), SectionFlagsRequired(), blockOffset, (u64[0 max])blockBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionFunctions(), SectionFlagsRequired(), funcOffset, (u64[0 max])funcBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionGlobals(), SectionFlagsRequired(), globalOffset, (u64[0 max])globalBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionAsmMetadata(), SectionFlagsRequired(), asmOffset, (u64[0 max])asmBuf.Count(), SectionEncodingRaw());
    WritePackageSectionDirectoryEntry(buf, PackageSectionEnumLayoutFacts(), SectionFlagsRequired(), enumLayoutOffset, (u64[0 max])enumLayoutBuf.Count(), SectionEncodingRaw());
    AppendBytes(buf, instrBuf);
    AppendBytes(buf, blockBuf);
    AppendBytes(buf, funcBuf);
    AppendBytes(buf, globalBuf);
    AppendBytes(buf, asmBuf);
    AppendBytes(buf, enumLayoutBuf);
}

public fn bool DeserializePackageImageEnumLayoutFacts(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirEnumLayoutFact> outFacts)
{
    if (!HasStarkPackageImageMagic(buf))
    {
        return false;
    }

    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    stack mut u32[0 max] asmOffset = 0;
    stack mut u32[0 max] asmFunctionCount = 0;
    stack mut bool hasAsm = false;
    stack mut u32[0 max] enumLayoutOffset = 0;
    stack mut u32[0 max] enumLayoutFactCount = 0;
    stack mut bool hasEnumLayoutFacts = false;
    stack mut u32[0 max] textPayloadOffset = 0;
    stack mut u32[0 max] textPayloadByteCount = 0;
    stack mut bool hasTextPayloadBytes = false;
    stack mut u32[0 max] textConstantOffset = 0;
    stack mut u32[0 max] textConstantCount = 0;
    stack mut bool hasTextConstants = false;
    stack mut u32[0 max] floatPayloadOffset = 0;
    stack mut u32[0 max] floatPayloadByteCount = 0;
    stack mut bool hasFloatPayloadBytes = false;
    stack mut u32[0 max] floatConstantOffset = 0;
    stack mut u32[0 max] floatConstantCount = 0;
    stack mut bool hasFloatConstants = false;
    if (ReadSectionedPackageImageDirectoryWithEnumLayoutFacts(
        buf,
        instrOffset,
        blockOffset,
        funcOffset,
        globalOffset,
        asmOffset,
        asmFunctionCount,
        hasAsm,
        enumLayoutOffset,
        enumLayoutFactCount,
        hasEnumLayoutFacts,
        textPayloadOffset,
        textPayloadByteCount,
        hasTextPayloadBytes,
        textConstantOffset,
        textConstantCount,
        hasTextConstants,
        floatPayloadOffset,
        floatPayloadByteCount,
        hasFloatPayloadBytes,
        floatConstantOffset,
        floatConstantCount,
        hasFloatConstants) != PackageImageValidationStatus.Ok
        || !hasEnumLayoutFacts)
    {
        return false;
    }

    return DeserializeEnumLayoutFactsAt(buf, enumLayoutOffset, outFacts);
}

public fn bool DeserializePackageImageTextConstants(
    borrow IrTable<u8[0 max]> buf,
    mut borrow IrTable<u8[0 max]> outTextPayloadBytes,
    mut borrow IrTable<MirTextConstant> outTextConstants)
{
    if (!HasStarkPackageImageMagic(buf))
    {
        return false;
    }

    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    stack mut u32[0 max] asmOffset = 0;
    stack mut u32[0 max] asmFunctionCount = 0;
    stack mut bool hasAsm = false;
    stack mut u32[0 max] enumLayoutOffset = 0;
    stack mut u32[0 max] enumLayoutFactCount = 0;
    stack mut bool hasEnumLayoutFacts = false;
    stack mut u32[0 max] textPayloadOffset = 0;
    stack mut u32[0 max] textPayloadByteCount = 0;
    stack mut bool hasTextPayloadBytes = false;
    stack mut u32[0 max] textConstantOffset = 0;
    stack mut u32[0 max] textConstantCount = 0;
    stack mut bool hasTextConstants = false;
    stack mut u32[0 max] floatPayloadOffset = 0;
    stack mut u32[0 max] floatPayloadByteCount = 0;
    stack mut bool hasFloatPayloadBytes = false;
    stack mut u32[0 max] floatConstantOffset = 0;
    stack mut u32[0 max] floatConstantCount = 0;
    stack mut bool hasFloatConstants = false;
    if (ReadSectionedPackageImageDirectoryWithEnumLayoutFacts(
        buf,
        instrOffset,
        blockOffset,
        funcOffset,
        globalOffset,
        asmOffset,
        asmFunctionCount,
        hasAsm,
        enumLayoutOffset,
        enumLayoutFactCount,
        hasEnumLayoutFacts,
        textPayloadOffset,
        textPayloadByteCount,
        hasTextPayloadBytes,
        textConstantOffset,
        textConstantCount,
        hasTextConstants,
        floatPayloadOffset,
        floatPayloadByteCount,
        hasFloatPayloadBytes,
        floatConstantOffset,
        floatConstantCount,
        hasFloatConstants) != PackageImageValidationStatus.Ok
        || !hasTextPayloadBytes
        || !hasTextConstants)
    {
        return false;
    }

    if (!DeserializeTextPayloadBytesAt(buf, textPayloadOffset, outTextPayloadBytes))
    {
        return false;
    }

    return DeserializeTextConstantsAt(buf, textConstantOffset, outTextPayloadBytes, outTextConstants);
}

public fn bool DeserializePackageImageWithTextConstants(
    borrow IrTable<u8[0 max]> buf,
    mut borrow IrTable<MirInstruction> outInstrs,
    mut borrow IrTable<MirBlock> outBlocks,
    mut borrow IrTable<MirFunction> outFuncs,
    mut borrow IrTable<MirGlobal> outGlobals,
    mut borrow IrTable<u8[0 max]> outTextPayloadBytes,
    mut borrow IrTable<MirTextConstant> outTextConstants)
{
    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    stack mut u32[0 max] asmOffset = 0;
