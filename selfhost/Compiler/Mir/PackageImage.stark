internal fn bool LogicalPackageTypedTypeFactGraphAddEnumPayloadRow(
    mut borrow LogicalPackageTypedTypeFactGraph graph,
    u32[0 max] variantRow,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeOrdinal,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal,
    u32[0 max] nameTextRow,
    u32[0 max] typeReferenceRow)
{
    if (!graph.EnumVariantRows.Contains(variantRow)
        || !graph.TextRows.Contains(nameTextRow)
        || !graph.TypeReferences.ContainsTypeReference(typeReferenceRow))
    {
        return false;
    }

    stack LogicalPackageTypedTypeEnumPayloadRow row = new LogicalPackageTypedTypeEnumPayloadRow()
    {
        ModuleOrdinalValue = moduleOrdinal,
        TypeOrdinalValue = typeOrdinal,
        VariantOrdinalValue = variantOrdinal,
        PayloadOrdinalValue = payloadOrdinal,
        NameTextRowValue = nameTextRow,
        TypeReferenceRowValue = typeReferenceRow
    };
    stack u32[0 max] addedRow = graph.EnumPayloadRows.Add(row);
    if (addedRow == 0)
    {
        return false;
    }

    stack mut LogicalPackageTypedTypeEnumVariantRow parent = graph.EnumVariantRows.Get(variantRow);
    if (parent.PayloadRowCountValue == 0)
    {
        parent.FirstPayloadRowValue = addedRow;
    }
    else if (addedRow != parent.FirstPayloadRowValue + parent.PayloadRowCountValue)
    {
        return false;
    }

    parent.PayloadRowCountValue = parent.PayloadRowCountValue + 1;
    return graph.EnumVariantRows.Replace(variantRow, parent);
}

public fn MemoryStatus AppendLogicalPackageTypedTypeAliasFactText(
    borrow LogicalPackageTypedTypeAliasFactGraph graph,
    LogicalPackageTypedTypeAliasFactTextRow textRow,
    mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] start = (u64[0 2 ** 63 - 1])textRow.ByteOffsetValue;
    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])textRow.ByteLengthValue;
    if (start + length > graph.TextBytes.Length)
    {
        return MemoryStatus.Err(MemoryError.InvalidLayout);
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < length)
    {
        try sink.AppendByte(graph.TextBytes[start + index]);
        index = index + 1;
    }

    return MemoryStatus.Ok;
}

