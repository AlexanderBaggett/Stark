    out bool hasBody)
{
    genericParameterCount = 0;
    comptimeGenericParameterCount = 0;
    parameterCount = 0;
    threadSafetyLawPredicateCount = 0;
    typeParameterConstraintCount = 0;
    valueContractCount = 0;
    disjointParameterGroupCount = 0;
    overlapParameterGroupCount = 0;
    sameParameterGroupCount = 0;
    pointeeDeadOnReturnParameterNameCount = 0;
    hasAsm = false;
    isFfi = false;
    isStrictFp = false;
    usesFastCallingConvention = false;
    hasGenericTemplateBody = false;
    isHot = false;
    isCold = false;
    hasExplicitInlinePreference = false;
    isStatic = false;
    isUnsafe = false;
    isVarargs = false;
    isTailCallable = false;
    hasBody = true;
    stack mut u64[0 2 ** 63 - 1] returnTypeNode = 0;
    if (!LogicalPackageImageJsonRequiredObjectMember(document, callableNode, "ReturnType", returnTypeNode)
        || !LogicalPackageImageJsonRequiredArrayMemberCount(document, callableNode, "Parameters", parameterCount)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(document, callableNode, "IsFfi", isFfi)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(document, callableNode, "IsStrictFp", isStrictFp)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(
            document,
            callableNode,
            "UseFastCallingConvention",
            usesFastCallingConvention)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(document, callableNode, "GenericParameters", genericParameterCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(
            document,
            callableNode,
            "ComptimeGenericParameters",
            comptimeGenericParameterCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(
            document,
            callableNode,
            "ThreadSafetyLawPredicates",
            threadSafetyLawPredicateCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(
            document,
            callableNode,
            "TypeParameterConstraints",
            typeParameterConstraintCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(document, callableNode, "ValueContracts", valueContractCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(
            document,
            callableNode,
            "DisjointParameterGroups",
            disjointParameterGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(
            document,
            callableNode,
            "OverlapParameterGroups",
            overlapParameterGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(
            document,
            callableNode,
            "SameParameterGroups",
            sameParameterGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(
            document,
            callableNode,
            "PointeeDeadOnReturnParameterNames",
            pointeeDeadOnReturnParameterNameCount)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            callableNode,
            "HasGenericTemplateBody",
            hasGenericTemplateBody)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, callableNode, "IsHot", isHot)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, callableNode, "IsCold", isCold)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(
            document,
            callableNode,
            "HasExplicitInlinePreference",
            hasExplicitInlinePreference)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, callableNode, "IsStatic", isStatic)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, callableNode, "IsUnsafe", isUnsafe)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, callableNode, "IsVarargs", isVarargs)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, callableNode, "IsTailCallable", isTailCallable)
        || !LogicalPackageImageJsonOptionalBoolMemberValueWithDefault(document, callableNode, "HasBody", true, hasBody))
    {
        return false;
    }

    if (callableKind == LogicalPackageTypedCallableKind.Function)
    {
        stack mut u64[0 2 ** 63 - 1] asmNode = 0;
        return LogicalPackageImageJsonOptionalObjectMember(document, callableNode, "Asm", asmNode, hasAsm);
    }

    return true;
}

internal fn bool LogicalPackageImageJsonAppendTypedCallableParameterText(
    mut borrow JsonDocument document,
