internal fn bool LogicalPackageImageJsonMaterializeTemplateBoundOperationPayloadRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] operationNode,
    ascii kindText,
    u32[0 max] functionTemplateRow,
    u32[0 max] boundOperationRow,
    mut borrow LogicalPackageGenericTemplateFactGraph graph)
{
    if (kindText == "direct-call")
    {
        return true;
    }

    if (kindText == "member-call")
    {
        return LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTypePayload(
                document,
                operationNode,
                "ReceiverType",
                functionTemplateRow,
                boundOperationRow,
                LogicalPackageTemplateBoundOperationTypePayloadKind.Receiver,
                LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationReceiverType,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeTemplateBoundOperationReceiverFlagPayloadRows(
                document,
                operationNode,
                boundOperationRow,
                graph);
    }

    if (kindText == "function-pointer-call")
    {
        return LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTypePayload(
            document,
            operationNode,
            "FunctionPointerType",
            functionTemplateRow,
            boundOperationRow,
            LogicalPackageTemplateBoundOperationTypePayloadKind.FunctionPointer,
            LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationFunctionPointerType,
            0,
            graph);
    }

    if (kindText == "closure-call")
    {
        return LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTypePayload(
            document,
            operationNode,
            "ClosureType",
            functionTemplateRow,
            boundOperationRow,
            LogicalPackageTemplateBoundOperationTypePayloadKind.Closure,
            LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationClosureType,
            0,
            graph);
    }

    if (kindText == "index-access" || kindText == "slice-access")
    {
        return LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTextPayload(
                document,
                operationNode,
                "AccessKind",
                boundOperationRow,
                LogicalPackageGenericTemplateFactTextKind.BoundOperationAccessKind,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTextPayload(
                document,
                operationNode,
                "SourceKind",
                boundOperationRow,
                LogicalPackageGenericTemplateFactTextKind.BoundOperationSourceKind,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTypePayload(
                document,
                operationNode,
                "SourceType",
                functionTemplateRow,
                boundOperationRow,
                LogicalPackageTemplateBoundOperationTypePayloadKind.Source,
                LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationSourceType,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationU32Payload(
                document,
                operationNode,
                "IndexCount",
                boundOperationRow,
                LogicalPackageTemplateBoundOperationU32PayloadKind.IndexCount,
                0,
                graph);
    }

    if (kindText == "dynamic-storage-operation")
    {
        return LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTextPayload(
                document,
                operationNode,
                "OperationName",
                boundOperationRow,
                LogicalPackageGenericTemplateFactTextKind.BoundOperationOperationName,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTypePayload(
                document,
                operationNode,
                "ReceiverType",
                functionTemplateRow,
                boundOperationRow,
                LogicalPackageTemplateBoundOperationTypePayloadKind.Receiver,
                LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationReceiverType,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationU32Payload(
                document,
                operationNode,
                "ArgumentCount",
                boundOperationRow,
                LogicalPackageTemplateBoundOperationU32PayloadKind.ArgumentCount,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeTemplateBoundOperationReceiverFlagPayloadRows(
                document,
                operationNode,
                boundOperationRow,
                graph);
    }

    if (kindText == "dyn-trait-from-parts")
    {
        return LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTextPayload(
                document,
                operationNode,
                "OperationName",
                boundOperationRow,
                LogicalPackageGenericTemplateFactTextKind.BoundOperationOperationName,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTypePayload(
                document,
                operationNode,
                "TargetType",
                functionTemplateRow,
                boundOperationRow,
                LogicalPackageTemplateBoundOperationTypePayloadKind.Target,
                LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationTargetType,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTypePayload(
                document,
                operationNode,
                "SourceType",
                functionTemplateRow,
                boundOperationRow,
                LogicalPackageTemplateBoundOperationTypePayloadKind.Source,
                LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationSourceType,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeRequiredTemplateBoundOperationTypePayload(
                document,
                operationNode,
                "ReceiverType",
                functionTemplateRow,
                boundOperationRow,
                LogicalPackageTemplateBoundOperationTypePayloadKind.Receiver,
                LogicalPackageTypedTypeReferenceSource.GenericTemplateBoundOperationReceiverType,
                0,
                graph)
            && LogicalPackageImageJsonMaterializeOptionalTemplateBoundOperationU32Payload(
                document,
                operationNode,
                "ArgumentCount",
                boundOperationRow,
                LogicalPackageTemplateBoundOperationU32PayloadKind.ArgumentCount,
                0,
                graph);
    }

    if (kindText == "object-creation")
    {
        return LogicalPackageImageJsonMaterializeTemplateBoundOperationObjectPayloadRows(
            document,
            operationNode,
            kindText,
            functionTemplateRow,
            boundOperationRow,
            graph);
    }

    if (kindText == "enum-construction" || kindText == "enum-call" || kindText == "enum-value")
    {
        return LogicalPackageImageJsonMaterializeTemplateBoundOperationEnumPayloadRows(
            document,
            operationNode,
            kindText,
            functionTemplateRow,
            boundOperationRow,
            graph);
    }

    if (kindText == "text-interpolation")
    {
