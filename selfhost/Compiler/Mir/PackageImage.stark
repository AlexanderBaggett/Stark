internal fn bool LogicalPackageImageJsonTypedInterfaceCounts(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typedInterfaceNode,
    out u32[0 max] functionCount,
    out u32[0 max] typeCount,
    out u32[0 max] globalCount,
    out u32[0 max] typeAliasCount,
    out u32[0 max] importCount)
{
    functionCount = 0;
    typeCount = 0;
    globalCount = 0;
    typeAliasCount = 0;
    importCount = 0;
    return LogicalPackageImageJsonRequiredArrayMemberCount(document, typedInterfaceNode, "Functions", functionCount)
        && LogicalPackageImageJsonRequiredArrayMemberCount(document, typedInterfaceNode, "Types", typeCount)
        && LogicalPackageImageJsonRequiredArrayMemberCount(document, typedInterfaceNode, "Globals", globalCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, typedInterfaceNode, "TypeAliases", typeAliasCount)
        && LogicalPackageImageJsonOptionalArrayMemberCount(document, typedInterfaceNode, "Imports", importCount);
}

internal fn bool LogicalPackageImageJsonModuleNode(
    borrow JsonDocument document,
    u32[0 max] moduleOrdinal,
    out u64[0 2 ** 63 - 1] moduleNode)
{
    moduleNode = 0;
    if (document.Count() == 0 || document.KindAt(0) != JsonKind.Object)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] modulesNode = 0;
    if (!document.TryFindMember(0, "Modules", modulesNode)
        || document.KindAt(modulesNode) != JsonKind.Array)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] moduleCount = document.ChildCountAt(modulesNode);
    if (moduleCount == 0
        || moduleCount > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
        || (u64[0 2 ** 63 - 1])moduleOrdinal >= moduleCount)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] found = 0;
    if (!document.TryChildAt(modulesNode, (u64[0 2 ** 63 - 1])moduleOrdinal, found)
        || document.KindAt(found) != JsonKind.Object)
    {
        return false;
    }

    moduleNode = found;
    return true;
}

internal fn bool LogicalPackageImageJsonEffectiveTypedInterfaceNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    out u64[0 2 ** 63 - 1] typedInterfaceNode,
    out bool usesCompilerSections)
{
    typedInterfaceNode = 0;
    usesCompilerSections = false;
    stack mut u64[0 2 ** 63 - 1] directTypedInterfaceNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsTypedInterfaceNode = 0;
    stack mut bool hasDirectTypedInterface = false;
    stack mut bool hasCompilerSections = false;
    stack mut bool hasCompilerSectionsTypedInterface = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "TypedInterface", directTypedInterfaceNode, hasDirectTypedInterface)
        || !LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "CompilerSections", compilerSectionsNode, hasCompilerSections))
    {
        return false;
    }

    if (hasCompilerSections)
    {
        if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            compilerSectionsNode,
            "TypedInterface",
            compilerSectionsTypedInterfaceNode,
            hasCompilerSectionsTypedInterface))
        {
            return false;
        }
    }

    if (hasCompilerSectionsTypedInterface)
    {
        typedInterfaceNode = compilerSectionsTypedInterfaceNode;
        usesCompilerSections = true;
        return true;
    }

    if (hasDirectTypedInterface)
    {
        typedInterfaceNode = directTypedInterfaceNode;
        return true;
    }

    return false;
}

internal fn bool LogicalPackageImageJsonEffectiveCompilerFactsNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] moduleNode,
    out u64[0 2 ** 63 - 1] compilerFactsNode,
    out bool usesCompilerSections)
{
    compilerFactsNode = 0;
    usesCompilerSections = false;
    stack mut u64[0 2 ** 63 - 1] directCompilerFactsNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsNode = 0;
    stack mut u64[0 2 ** 63 - 1] compilerSectionsCompilerFactsNode = 0;
    stack mut bool hasDirectCompilerFacts = false;
    stack mut bool hasCompilerSections = false;
    stack mut bool hasCompilerSectionsCompilerFacts = false;
    if (!LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "CompilerFacts", directCompilerFactsNode, hasDirectCompilerFacts)
        || !LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "CompilerSections", compilerSectionsNode, hasCompilerSections))
    {
        return false;
    }

    if (hasCompilerSections)
    {
        if (!LogicalPackageImageJsonOptionalObjectMember(
            document,
            compilerSectionsNode,
            "CompilerFacts",
            compilerSectionsCompilerFactsNode,
            hasCompilerSectionsCompilerFacts))
        {
            return false;
        }
    }

    if (hasCompilerSectionsCompilerFacts)
    {
        compilerFactsNode = compilerSectionsCompilerFactsNode;
        usesCompilerSections = true;
        return true;
    }

    if (hasDirectCompilerFacts)
    {
        compilerFactsNode = directCompilerFactsNode;
        return true;
    }

    return false;
}

internal fn bool LogicalPackageImageJsonTypedDeclarationArrayNode(
    borrow JsonDocument document,
