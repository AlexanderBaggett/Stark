            architectureTextRow,
            templateTextRow,
            asmRow))
    {
        return false;
    }

    stack mut u32[0 max] inputIndex = 0;
    while willexit (inputIndex < inputCount)
    {
        stack mut u64[0 2 ** 63 - 1] inputNode = 0;
        stack mut u32[0 max] registerNameTextRow = 0;
        stack mut u32[0 max] valueNameTextRow = 0;
        if (!document.TryChildAt(inputsNode, (u64[0 2 ** 63 - 1])inputIndex, inputNode)
            || document.KindAt(inputNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeCallableFactTextMemberRow(
