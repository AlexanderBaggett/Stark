        if (!document.TryChildAt(creationsNode, (u64[0 2 ** 63 - 1])index, creationNode)
            || document.KindAt(creationNode) != JsonKind.Object
            || !LogicalPackageImageJsonRequiredObjectMember(document, creationNode, "CreatedType", createdTypeNode)
            || !LogicalPackageImageJsonMaterializeGenericTemplateTypeReference(
