                || !LogicalPackageImageJsonRequiredBoolMemberValue(
                    document,
                    constructorNode,
                    "IsPrimaryShape",
                    constructorIsPrimaryShape))
            {
                return false;
            }
        }

        if (!LogicalPackageGenericTemplateFactGraphAddTemplateObjectCreationRow(
                graph,
                functionTemplateRow,
                index,
                createdTypeReferenceRow,
                hasConstructor,
                constructorTypeNameTextRow,
                constructorParameterCount,
                constructorIsPrimaryShape,
                storageSelector,
                hasExpressionText,
                expressionTextRow,
                initializerMemberCount,
                objectCreationRow)
            || !LogicalPackageImageJsonMaterializeTemplateObjectInitializerMemberRows(
                document,
                initializerMembersNode,
                initializerMemberCount,
                functionTemplateRow,
                objectCreationRow,
                graph))
