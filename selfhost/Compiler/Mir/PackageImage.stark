            typeReferenceRow,
            graph,
            sameParameterGroupCount)
        || !LogicalPackageImageJsonMaterializeOptionalTypeReferenceTextArray(
            document,
            typeReferenceNode,
            "PointeeDeadOnReturnParameterNames",
