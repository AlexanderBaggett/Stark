internal unsafe fn JsonStatus LogicalPackageManifestJsonWriteSourceSurfaceMember(
    mut borrow JsonWriter writer,
    borrow LogicalPackageManifestJsonBuilder manifestBuilder,
    u32[0 max] moduleRow,
    mut borrow OwnedAscii scratch)
{
    stack u32[0 max] importCount = manifestBuilder.SourceSurfaceImportCounts.Get(moduleRow);
    stack u32[0 max] reExportCount = manifestBuilder.SourceSurfaceReExportCounts.Get(moduleRow);
    stack u32[0 max] typeAliasCount = manifestBuilder.SourceSurfaceTypeAliasCounts.Get(moduleRow);
    stack u32[0 max] typeCount = manifestBuilder.SourceSurfaceTypeCounts.Get(moduleRow);
    stack u32[0 max] globalCount = manifestBuilder.SourceSurfaceGlobalCounts.Get(moduleRow);
    stack u32[0 max] functionCount = manifestBuilder.SourceSurfaceFunctionCounts.Get(moduleRow);
    if (importCount == 0
        && reExportCount == 0
        && typeAliasCount == 0
        && typeCount == 0
        && globalCount == 0
        && functionCount == 0)
    {
        return JsonStatus.Ok;
    }

    stack JsonStatus keyStatus = writer.Key("SourceSurface");
    switch (keyStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    stack JsonStatus beginStatus = writer.BeginObject();
    switch (beginStatus)
    {
        case JsonStatus.Err(var error):
            return JsonStatus.Err(error);
        case JsonStatus.Ok:
    }

    if (importCount != 0)
    {
        stack JsonStatus importsKeyStatus = writer.Key("Imports");
        switch (importsKeyStatus)
