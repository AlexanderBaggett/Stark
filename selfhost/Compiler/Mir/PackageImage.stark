                    declarationOrdinal,
                    typeNode)
                || !LogicalPackageImageJsonOptionalArrayMember(document, typeNode, "Methods", methodsNode, methodCount)
                || methodOrdinal >= methodCount
                || !document.TryChildAt(methodsNode, (u64[0 2 ** 63 - 1])methodOrdinal, found)
                || document.KindAt(found) != JsonKind.Object)
