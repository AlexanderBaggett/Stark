            work,
            parameterTypeCount)
        || !LogicalPackageImageJsonMaterializeOptionalTypeReferenceTextArray(
            document,
            typeReferenceNode,
            "ParameterRawPointerElementCountExpressions",
            LogicalPackageTypeReferenceTextKind.ParameterRawPointerElementCountExpression,
            true,
            typeReferenceRow,
            graph,
            parameterRawPointerElementCountExpressionCount)
        || !LogicalPackageImageJsonMaterializeParameterGroupRows(
            document,
            typeReferenceNode,
            "DisjointParameterGroups",
            LogicalPackageTypeReferenceParameterGroupKind.Disjoint,
            typeReferenceRow,
            graph,
            disjointParameterGroupCount)
        || !LogicalPackageImageJsonMaterializeParameterGroupRows(
            document,
            typeReferenceNode,
            "OverlapParameterGroups",
