            document,
            moduleNode,
            moduleOrdinal,
            graph)
        && LogicalPackageImageJsonMaterializeSourceSurfaceTypeRows(
            document,
            moduleNode,
            moduleOrdinal,
            graph)
        && LogicalPackageImageJsonMaterializeSourceSurfaceGlobalRows(
            document,
            moduleNode,
            moduleOrdinal,
            graph)
        && LogicalPackageImageJsonMaterializeSourceSurfaceFunctionRows(
            document,
            moduleNode,
            moduleOrdinal,
            graph);
}

internal fn bool LogicalPackageImageJsonMaterializeTypedInterfaceFactRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typedInterfaceNode,
    u32[0 max] moduleOrdinal,
    mut borrow LogicalPackageTypedTypeAliasFactGraph typeAliasGraph,
    mut borrow LogicalPackageTypedCallableFactGraph callableGraph,
    mut borrow LogicalPackageTypedGlobalFactGraph globalGraph,
    mut borrow LogicalPackageTypedTypeFactGraph typeGraph,
    out bool hasTypeAliasFacts,
    out bool hasCallableFacts,
    out bool hasGlobalFacts,
    out bool hasTypeFacts)
{
    hasTypeAliasFacts = false;
    hasCallableFacts = false;
    hasGlobalFacts = false;
    hasTypeFacts = false;

    stack mut u64[0 2 ** 63 - 1] typeAliasesNode = 0;
    stack mut u32[0 max] typeAliasCount = 0;
    if (!LogicalPackageImageJsonTypedDeclarationArrayNode(
        document,
        typedInterfaceNode,
        LogicalPackageTypedDeclarationKind.TypeAlias,
        typeAliasesNode,
        typeAliasCount))
    {
        return false;
    }

    stack mut u32[0 max] typeAliasIndex = 0;
    while willexit (typeAliasIndex < typeAliasCount)
    {
        stack mut u64[0 2 ** 63 - 1] typeAliasNode = 0;
        if (!document.TryChildAt(typeAliasesNode, (u64[0 2 ** 63 - 1])typeAliasIndex, typeAliasNode)
            || document.KindAt(typeAliasNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypedTypeAliasFactRows(
                document,
                typeAliasNode,
                moduleOrdinal,
                typeAliasIndex,
                typeAliasGraph))
        {
            return false;
        }

        typeAliasIndex = typeAliasIndex + 1;
    }

    hasTypeAliasFacts = typeAliasesNode != 0;

    stack mut u64[0 2 ** 63 - 1] functionsNode = 0;
    stack mut u32[0 max] functionCount = 0;
    if (!LogicalPackageImageJsonTypedDeclarationArrayNode(
        document,
        typedInterfaceNode,
        LogicalPackageTypedDeclarationKind.Function,
        functionsNode,
        functionCount))
    {
        return false;
    }

    stack mut u32[0 max] functionIndex = 0;
    while willexit (functionIndex < functionCount)
    {
        stack mut u64[0 2 ** 63 - 1] functionNode = 0;
        if (!document.TryChildAt(functionsNode, (u64[0 2 ** 63 - 1])functionIndex, functionNode)
            || document.KindAt(functionNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypedCallableFactRows(
                document,
                functionNode,
                moduleOrdinal,
                LogicalPackageTypedCallableKind.Function,
                functionIndex,
                0,
                callableGraph))
        {
            return false;
        }

        functionIndex = functionIndex + 1;
    }

    hasCallableFacts = functionsNode != 0;

    stack mut u64[0 2 ** 63 - 1] globalsNode = 0;
    stack mut u32[0 max] globalCount = 0;
    if (!LogicalPackageImageJsonTypedDeclarationArrayNode(
        document,
        typedInterfaceNode,
        LogicalPackageTypedDeclarationKind.Global,
        globalsNode,
        globalCount))
    {
        return false;
    }

    stack mut u32[0 max] globalIndex = 0;
    while willexit (globalIndex < globalCount)
    {
        stack mut u64[0 2 ** 63 - 1] globalNode = 0;
        if (!document.TryChildAt(globalsNode, (u64[0 2 ** 63 - 1])globalIndex, globalNode)
            || document.KindAt(globalNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypedGlobalFactRows(
                document,
                globalNode,
                moduleOrdinal,
                globalIndex,
                globalGraph))
        {
            return false;
        }

        globalIndex = globalIndex + 1;
    }

    hasGlobalFacts = globalsNode != 0;

    stack mut u64[0 2 ** 63 - 1] typesNode = 0;
    stack mut u32[0 max] typeCount = 0;
    if (!LogicalPackageImageJsonTypedDeclarationArrayNode(
        document,
        typedInterfaceNode,
        LogicalPackageTypedDeclarationKind.Type,
        typesNode,
        typeCount))
    {
        return false;
    }

    stack mut u32[0 max] typeIndex = 0;
    while willexit (typeIndex < typeCount)
    {
        stack mut u64[0 2 ** 63 - 1] typeNode = 0;
        stack mut u64[0 2 ** 63 - 1] methodsNode = 0;
        stack mut u32[0 max] methodCount = 0;
        if (!document.TryChildAt(typesNode, (u64[0 2 ** 63 - 1])typeIndex, typeNode)
            || document.KindAt(typeNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypedTypeFactRows(
                document,
                typeNode,
                moduleOrdinal,
                typeIndex,
                typeGraph)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                typeNode,
                "Methods",
                methodsNode,
                methodCount))
        {
            return false;
        }

        stack mut u32[0 max] methodIndex = 0;
        while willexit (methodIndex < methodCount)
        {
            stack mut u64[0 2 ** 63 - 1] methodNode = 0;
            if (!document.TryChildAt(methodsNode, (u64[0 2 ** 63 - 1])methodIndex, methodNode)
                || document.KindAt(methodNode) != JsonKind.Object
                || !LogicalPackageImageJsonMaterializeTypedCallableFactRows(
                    document,
                    methodNode,
                    moduleOrdinal,
                    LogicalPackageTypedCallableKind.Method,
                    typeIndex,
                    methodIndex,
                    callableGraph))
            {
                return false;
            }

            methodIndex = methodIndex + 1;
        }

        if (methodsNode != 0)
        {
            hasCallableFacts = true;
        }

        typeIndex = typeIndex + 1;
    }

    hasTypeFacts = typesNode != 0;
    return true;
}

internal fn bool TryMaterializeLogicalPackageManifestModuleGraphModelFromDocument(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] modulesNode,
    LogicalPackageManifestModuleSummary moduleSummary,
    out LogicalPackageManifestModuleGraphModel moduleGraph)
{
    moduleGraph = new();
    stack mut LogicalPackageManifestModuleGraphModel builtGraph = new();
    stack u32[0 max] moduleOrdinal = moduleSummary.ModuleOrdinal();
    stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
    if (!document.TryChildAt(modulesNode, (u64[0 2 ** 63 - 1])moduleOrdinal, moduleNode)
        || document.KindAt(moduleNode) != JsonKind.Object)
    {
        return false;
    }

    builtGraph.ModuleOrdinalValue = moduleOrdinal;

    if (moduleSummary.HasTypedInterface())
    {
        stack mut u64[0 2 ** 63 - 1] typedInterfaceNode = 0;
        stack mut bool usesCompilerSectionsTypedInterface = false;
        stack mut bool hasTypedTypeAliasFacts = false;
        stack mut bool hasTypedCallableFacts = false;
        stack mut bool hasTypedGlobalFacts = false;
        stack mut bool hasTypedTypeFacts = false;
        if (!LogicalPackageImageJsonEffectiveTypedInterfaceNode(
                document,
                moduleNode,
                typedInterfaceNode,
                usesCompilerSectionsTypedInterface)
            || !LogicalPackageImageJsonMaterializeTypedInterfaceFactRows(
                document,
                typedInterfaceNode,
                moduleOrdinal,
                builtGraph.TypedTypeAliases,
                builtGraph.TypedCallables,
                builtGraph.TypedGlobals,
                builtGraph.TypedTypes,
                hasTypedTypeAliasFacts,
                hasTypedCallableFacts,
                hasTypedGlobalFacts,
                hasTypedTypeFacts))
        {
            return false;
        }

        builtGraph.HasTypedTypeAliasFactsValue = hasTypedTypeAliasFacts;
        builtGraph.HasTypedCallableFactsValue = hasTypedCallableFacts;
        builtGraph.HasTypedGlobalFactsValue = hasTypedGlobalFacts;
        builtGraph.HasTypedTypeFactsValue = hasTypedTypeFacts;
    }

    if (moduleSummary.HasCompilerFacts())
    {
        stack mut u64[0 2 ** 63 - 1] compilerFactsNode = 0;
        stack mut bool usesCompilerSectionsCompilerFacts = false;
        stack mut u64[0 2 ** 63 - 1] functionEffectsNode = 0;
        stack mut u32[0 max] functionEffectCount = 0;
        if (!LogicalPackageImageJsonEffectiveCompilerFactsNode(
                document,
                moduleNode,
                compilerFactsNode,
                usesCompilerSectionsCompilerFacts)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                compilerFactsNode,
                "FunctionEffects",
                functionEffectsNode,
                functionEffectCount))
        {
            return false;
        }

        if (functionEffectsNode != 0)
        {
            stack mut u32[0 max] materializedFunctionEffectCount = 0;
            if (!LogicalPackageImageJsonMaterializeFunctionEffectFactRows(
                    document,
                    compilerFactsNode,
                    moduleOrdinal,
                    builtGraph.FunctionEffects,
                    materializedFunctionEffectCount)
                || materializedFunctionEffectCount != functionEffectCount)
            {
                return false;
            }

            builtGraph.HasFunctionEffectFactsValue = true;
        }

        stack mut u64[0 2 ** 63 - 1] abiFunctionsNode = 0;
        stack mut u32[0 max] abiFunctionCount = 0;
        if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            compilerFactsNode,
            "AbiFunctions",
            abiFunctionsNode,
            abiFunctionCount))
        {
            return false;
        }

        if (abiFunctionsNode != 0)
        {
            stack mut u32[0 max] materializedAbiFunctionCount = 0;
            if (!LogicalPackageImageJsonMaterializeAbiFunctionRows(
                    document,
                    compilerFactsNode,
                    moduleOrdinal,
                    builtGraph.AbiFacts,
                    materializedAbiFunctionCount)
                || materializedAbiFunctionCount != abiFunctionCount)
            {
                return false;
            }

            builtGraph.HasAbiFactsValue = true;
        }

        stack mut u64[0 2 ** 63 - 1] concreteLayoutsNode = 0;
        stack mut u64[0 2 ** 63 - 1] enumLayoutsNode = 0;
        stack mut u32[0 max] concreteLayoutCount = 0;
        stack mut u32[0 max] enumLayoutCount = 0;
        if (!LogicalPackageImageJsonOptionalArrayMember(
                document,
                compilerFactsNode,
                "ConcreteLayouts",
                concreteLayoutsNode,
                concreteLayoutCount)
            || !LogicalPackageImageJsonOptionalArrayMember(
                document,
                compilerFactsNode,
                "EnumLayouts",
                enumLayoutsNode,
                enumLayoutCount))
        {
            return false;
        }

        if (concreteLayoutsNode != 0 || enumLayoutsNode != 0)
        {
            stack mut u32[0 max] materializedConcreteLayoutCount = 0;
            stack mut u32[0 max] materializedEnumLayoutCount = 0;
            if (!LogicalPackageImageJsonMaterializeLayoutFactRows(
                    document,
                    compilerFactsNode,
                    moduleOrdinal,
                    builtGraph.LayoutFacts,
                    materializedConcreteLayoutCount,
                    materializedEnumLayoutCount)
                || materializedConcreteLayoutCount != concreteLayoutCount
                || materializedEnumLayoutCount != enumLayoutCount)
            {
                return false;
            }

            builtGraph.HasLayoutFactsValue = true;
        }

        stack mut u64[0 2 ** 63 - 1] nativeDependenciesNode = 0;
        stack mut u64[0 2 ** 63 - 1] linkageNode = 0;
        stack mut bool hasNativeDependencies = false;
        stack mut bool hasLinkage = false;
        if (!LogicalPackageImageJsonOptionalObjectMember(
                document,
                0,
                "NativeDependencies",
                nativeDependenciesNode,
                hasNativeDependencies)
            || !LogicalPackageImageJsonOptionalObjectMember(
                document,
                compilerFactsNode,
                "Linkage",
                linkageNode,
                hasLinkage))
        {
            return false;
        }

        if (hasNativeDependencies || hasLinkage)
        {
            stack mut u32[0 max] nativeDependencyCount = 0;
            stack mut bool materializedHasLinkage = false;
            if (!LogicalPackageImageJsonMaterializeNativeMetadataFactRows(
                    document,
                    0,
                    compilerFactsNode,
                    moduleOrdinal,
                    builtGraph.NativeMetadataFacts,
                    nativeDependencyCount,
                    materializedHasLinkage)
                || materializedHasLinkage != hasLinkage)
            {
                return false;
            }

            builtGraph.HasNativeMetadataFactsValue = true;
        }

        stack mut u64[0 2 ** 63 - 1] functionSemanticsNode = 0;
        stack mut u32[0 max] functionSemanticCount = 0;
        if (!LogicalPackageImageJsonOptionalArrayMember(
            document,
            compilerFactsNode,
            "FunctionSemantics",
            functionSemanticsNode,
            functionSemanticCount))
        {
            return false;
        }

        if (functionSemanticsNode != 0)
        {
            stack mut u32[0 max] materializedFunctionSemanticCount = 0;
            stack mut u32[0 max] materializedFunctionOwnershipCount = 0;
            if (!LogicalPackageImageJsonMaterializeFunctionSemanticFactRows(
                    document,
                    compilerFactsNode,
                    moduleOrdinal,
                    builtGraph.FunctionSemantics,
                    materializedFunctionSemanticCount)
                || materializedFunctionSemanticCount != functionSemanticCount
                || !LogicalPackageImageJsonMaterializeFunctionOwnershipFactRows(
                    document,
                    compilerFactsNode,
                    moduleOrdinal,
                    builtGraph.FunctionOwnership,
                    materializedFunctionOwnershipCount))
            {
                return false;
            }

            builtGraph.HasFunctionSemanticFactsValue = true;
            builtGraph.HasFunctionOwnershipFactsValue = materializedFunctionOwnershipCount > 0;
        }
    }

    if (moduleSummary.HasGenericTemplates())
    {
        stack mut u64[0 2 ** 63 - 1] genericTemplatesNode = 0;
        stack mut bool usesCompilerSectionsGenericTemplates = false;
        stack mut u32[0 max] functionTemplateCount = 0;
        if (!LogicalPackageImageJsonEffectiveGenericTemplatesNode(
                document,
                moduleNode,
                genericTemplatesNode,
                usesCompilerSectionsGenericTemplates)
            || !LogicalPackageImageJsonMaterializeGenericTemplateFactRows(
                document,
                genericTemplatesNode,
                moduleOrdinal,
                builtGraph.GenericTemplates,
                functionTemplateCount))
        {
            return false;
        }

        builtGraph.HasGenericTemplateFactsValue = true;
    }

    if (!LogicalPackageImageJsonMaterializeSourceSurfaceBridgeRows(
        document,
        moduleNode,
        moduleOrdinal,
        builtGraph.SourceSurfaceBridge))
    {
        return false;
    }

    builtGraph.HasSourceSurfaceBridgeFactsValue = moduleSummary.HasSourceSurface()
        || builtGraph.SourceSurfaceBridge.TotalRowCount() > 0;

    moduleGraph = builtGraph;
    return true;
}

public unsafe fn bool TryReadLogicalPackageManifestJsonModel(
    ascii manifestJson,
    borrow IrTable<u8[0 max]> buf,
    LogicalPackageImageFacts facts,
    out LogicalPackageManifestModel model)
    where overlap(manifestJson, buf)
{
    model = new();
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            if (document.Count() == 0 || document.KindAt(0) != JsonKind.Object)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] rootModuleNode = 0;
            stack mut u64[0 2 ** 63 - 1] libraryNode = 0;
            stack mut u64[0 2 ** 63 - 1] modulesNode = 0;
            if (!document.TryFindMember(0, "RootModule", rootModuleNode)
                || document.KindAt(rootModuleNode) != JsonKind.Text
                || !document.TryFindMember(0, "LibraryFileName", libraryNode)
                || document.KindAt(libraryNode) != JsonKind.Text
                || !document.TryFindMember(0, "Modules", modulesNode)
                || document.KindAt(modulesNode) != JsonKind.Array)
            {
                return false;
            }

            stack ascii rootModule = document.TextAt(rootModuleNode);
            stack ascii libraryFileName = document.TextAt(libraryNode);
            if (!LogicalPackageImageFactStringEquals(buf, facts, facts.RootModuleStringIndexValue, rootModule)
                || !LogicalPackageImageFactStringEquals(buf, facts, facts.LibraryFileNameStringIndexValue, libraryFileName))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] moduleCount = document.ChildCountAt(modulesNode);
            if (moduleCount == 0 || moduleCount > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
            {
                return false;
            }

            stack u32[0 max] moduleCount32 = (u32[0 max])moduleCount;
            stack mut u32[0 max] rootModuleOrdinal = PackageImageNullStringIndex();
            stack mut u32[0 max] moduleIndex = 0;
            while willexit (moduleIndex < moduleCount32)
            {
                stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
                stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
                if (!document.TryChildAt(modulesNode, (u64[0 2 ** 63 - 1])moduleIndex, moduleNode)
                    || document.KindAt(moduleNode) != JsonKind.Object
                    || !document.TryFindMember(moduleNode, "ModuleName", moduleNameNode)
                    || document.KindAt(moduleNameNode) != JsonKind.Text)
                {
                    return false;
                }

                if (document.TextAt(moduleNameNode) == rootModule)
                {
                    rootModuleOrdinal = moduleIndex;
                }

                moduleIndex = moduleIndex + 1;
            }

            if (!LogicalStringIndexIsPresent(rootModuleOrdinal)
                || !LogicalPackageImageJsonBuildProfileMatchesFacts(document, buf, facts, 0)
                || !LogicalPackageImageJsonTargetMatchesFacts(document, buf, facts, 0))
            {
                return false;
            }

            model.ManifestSummaryValue = new LogicalPackageManifestSummary()
            {
                ModuleCountValue = moduleCount32,
                RootModuleOrdinalValue = rootModuleOrdinal,
                HasNativeDependenciesValue = LogicalPackageImageJsonMemberHasValue(document, 0, "NativeDependencies"),
                HasBuildProfileValue = facts.HasBuildProfileValue,
                HasTargetValue = facts.HasTargetValue,
                HasCDataModelValue = facts.HasCDataModelValue,
                HasAggregateLayoutValue = facts.HasAggregateLayoutValue
            };

            switch (model.ModuleRows.Reserve(moduleCount))
            {
                case MemoryStatus.Err(var reserveError):
                    return false;
                case MemoryStatus.Ok:
            }

            switch (model.ModuleGraphRows.Reserve(moduleCount))
            {
                case MemoryStatus.Err(var reserveError):
                    return false;
                case MemoryStatus.Ok:
            }

            moduleIndex = 0;
            while willexit (moduleIndex < moduleCount32)
            {
                stack mut LogicalPackageManifestModuleSummary moduleSummary = new();
                stack mut LogicalPackageManifestModuleGraphModel moduleGraph = new();
                if (!TryReadLogicalPackageManifestModuleJsonSummaryFromDocument(
                        document,
                        modulesNode,
                        moduleIndex,
                        moduleSummary)
                    || !TryMaterializeLogicalPackageManifestModuleGraphModelFromDocument(
                        document,
                        modulesNode,
                        moduleSummary,
                        moduleGraph))
                {
                    return false;
                }

                if (model.ModuleRows.Add(moduleSummary) == 0
                    || model.ModuleGraphRows.Add(moduleGraph) == 0)
                {
                    return false;
                }

                moduleIndex = moduleIndex + 1;
            }

            return true;
    }
}

public unsafe fn bool TryReadLogicalPackageSourceSurfaceImportJsonSummary(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    u32[0 max] importOrdinal,
    out LogicalPackageSourceSurfaceImportSummary importSummary,
    mut borrow OwnedAscii moduleName)
{
    importSummary = new();
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] importsNode = 0;
            stack mut u32[0 max] importCount = 0;
            stack mut u64[0 2 ** 63 - 1] reExportsNode = 0;
            stack mut u32[0 max] reExportCount = 0;
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonSourceSurfaceImportNodes(
                    document,
                    moduleNode,
                    importsNode,
                    importCount,
                    reExportsNode,
                    reExportCount))
            {
                return false;
            }

            stack mut u32[0 max] effectiveOrdinal = 0;
            stack mut u32[0 max] importIndex = 0;
            while willexit (importIndex < importCount)
            {
                stack mut u64[0 2 ** 63 - 1] importNode = 0;
                stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
                stack mut bool isExported = false;
                if (!document.TryChildAt(importsNode, (u64[0 2 ** 63 - 1])importIndex, importNode)
                    || document.KindAt(importNode) != JsonKind.Object
                    || !document.TryFindMember(importNode, "ModuleName", moduleNameNode)
                    || document.KindAt(moduleNameNode) != JsonKind.Text
                    || !LogicalPackageImageJsonRequiredBoolMemberValue(document, importNode, "IsExported", isExported))
                {
                    return false;
                }

                stack ascii importModuleName = document.TextAt(moduleNameNode);
                if (System.Text.AsciiLength(importModuleName) <= 0)
                {
                    return false;
                }

                stack bool hasReExport = LogicalPackageImageJsonReExportListHasModuleName(
                    document,
                    reExportsNode,
                    reExportCount,
                    importModuleName);
                if (effectiveOrdinal == importOrdinal)
                {
                    switch (moduleName.AppendAscii(importModuleName))
                    {
                        case MemoryStatus.Err(var error):
                            return false;
                        case MemoryStatus.Ok:
                            importSummary = new LogicalPackageSourceSurfaceImportSummary()
                            {
                                ModuleOrdinalValue = moduleOrdinal,
                                ImportOrdinalValue = effectiveOrdinal,
                                HasDirectImportValue = true,
                                HasReExportValue = hasReExport,
                                IsExportedValue = isExported || hasReExport
                            };
                            return true;
                    }
                }

                importIndex = importIndex + 1;
                effectiveOrdinal = effectiveOrdinal + 1;
            }

            stack mut u32[0 max] reExportIndex = 0;
            while willexit (reExportIndex < reExportCount)
            {
                stack mut u64[0 2 ** 63 - 1] reExportNode = 0;
                stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
                if (!document.TryChildAt(reExportsNode, (u64[0 2 ** 63 - 1])reExportIndex, reExportNode)
                    || document.KindAt(reExportNode) != JsonKind.Object
                    || !document.TryFindMember(reExportNode, "ModuleName", moduleNameNode)
                    || document.KindAt(moduleNameNode) != JsonKind.Text)
                {
                    return false;
                }

                stack ascii reExportModuleName = document.TextAt(moduleNameNode);
                if (System.Text.AsciiLength(reExportModuleName) <= 0)
                {
                    return false;
                }

                if (!LogicalPackageImageJsonImportListHasModuleName(
                    document,
                    importsNode,
                    importCount,
                    reExportModuleName))
                {
                    if (effectiveOrdinal == importOrdinal)
                    {
                        switch (moduleName.AppendAscii(reExportModuleName))
                        {
                            case MemoryStatus.Err(var error):
                                return false;
                            case MemoryStatus.Ok:
                                importSummary = new LogicalPackageSourceSurfaceImportSummary()
                                {
                                    ModuleOrdinalValue = moduleOrdinal,
                                    ImportOrdinalValue = effectiveOrdinal,
                                    HasDirectImportValue = false,
                                    HasReExportValue = true,
                                    IsExportedValue = true
                                };
                                return true;
                        }
                    }

                    effectiveOrdinal = effectiveOrdinal + 1;
                }

                reExportIndex = reExportIndex + 1;
            }

            return false;
    }
}

public unsafe fn bool TryReadLogicalPackageSourceSurfaceTypeAliasJsonSummary(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeAliasOrdinal,
    out LogicalPackageSourceSurfaceTypeAliasSummary typeAliasSummary,
    mut borrow OwnedAscii name,
    mut borrow OwnedAscii qualifiedName,
    mut borrow OwnedAscii visibility,
    mut borrow OwnedAscii targetType)
{
    typeAliasSummary = new();
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] typeAliasNode = 0;
            stack mut u64[0 2 ** 63 - 1] genericParametersNode = 0;
            stack mut u32[0 max] genericParameterCount = 0;
            stack mut u32[0 max] comptimeGenericParameterCount = 0;
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonSourceSurfaceTypeAliasNode(
                    document,
                    moduleNode,
                    typeAliasOrdinal,
                    typeAliasNode)
                || !LogicalPackageImageJsonSourceSurfaceTypeAliasGenericParameterNodes(
                    document,
                    typeAliasNode,
                    genericParametersNode,
                    genericParameterCount)
                || !LogicalPackageImageJsonSourceSurfaceTypeAliasComptimeGenericParameterCount(
                    document,
                    typeAliasNode,
                    comptimeGenericParameterCount)
                || !LogicalPackageImageJsonAppendRequiredTextMember(document, typeAliasNode, "Name", name)
                || !LogicalPackageImageJsonAppendRequiredTextMember(
                    document,
                    typeAliasNode,
                    "QualifiedName",
                    qualifiedName)
                || !LogicalPackageImageJsonAppendRequiredTextMember(document, typeAliasNode, "Visibility", visibility)
                || !LogicalPackageImageJsonAppendRequiredTextMember(document, typeAliasNode, "TargetType", targetType))
            {
                return false;
            }

            typeAliasSummary = new LogicalPackageSourceSurfaceTypeAliasSummary()
            {
                ModuleOrdinalValue = moduleOrdinal,
                TypeAliasOrdinalValue = typeAliasOrdinal,
                GenericParameterCountValue = genericParameterCount,
                ComptimeGenericParameterCountValue = comptimeGenericParameterCount
            };
            return true;
    }
}

public unsafe fn bool TryReadLogicalPackageSourceSurfaceTypeAliasGenericParameterJsonSummary(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    u32[0 max] typeAliasOrdinal,
    u32[0 max] parameterOrdinal,
    out LogicalPackageSourceSurfaceTypeAliasGenericParameterSummary parameterSummary,
    mut borrow OwnedAscii name)
{
    parameterSummary = new();
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] typeAliasNode = 0;
            stack mut u64[0 2 ** 63 - 1] genericParametersNode = 0;
            stack mut u32[0 max] genericParameterCount = 0;
            stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonSourceSurfaceTypeAliasNode(
                    document,
                    moduleNode,
                    typeAliasOrdinal,
                    typeAliasNode)
                || !LogicalPackageImageJsonSourceSurfaceTypeAliasGenericParameterNodes(
                    document,
                    typeAliasNode,
                    genericParametersNode,
                    genericParameterCount)
                || parameterOrdinal >= genericParameterCount
