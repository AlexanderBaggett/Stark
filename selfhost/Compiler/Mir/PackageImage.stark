            "ClosureCallCapability",
            false,
            LogicalPackageTypeReferenceTextKind.ClosureCallCapability,
            0,
            typeReferenceRow,
            graph,
            hasClosureCallCapability)
        || !LogicalPackageImageJsonMaterializeTypeReferenceTextMember(
            document,
            typeReferenceNode,
            "DynTraitStorageKind",
            false,
            LogicalPackageTypeReferenceTextKind.DynTraitStorageKind,
            0,
            typeReferenceRow,
            graph,
            hasDynTraitStorageKind)
        || !LogicalPackageImageJsonEnqueueOptionalTypeReferenceObjectChild(
            document,
            typeReferenceNode,
            "ReturnType",
            LogicalPackageTypeReferenceChildKind.ReturnType,
            typeReferenceRow,
            work,
            hasReturnType)
        || !LogicalPackageImageJsonEnqueueOptionalTypeReferenceArrayChildren(
            document,
