        stack mut u64[0 2 ** 63 - 1] childNode = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, childNode)
            || document.KindAt(childNode) != JsonKind.Object
            || !LogicalPackageTypeReferenceWorkListAdd(work, childNode, parentTypeReferenceRow, childKind, index))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeParameterGroupNameRows(
