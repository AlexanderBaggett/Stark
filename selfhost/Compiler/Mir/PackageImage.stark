        out u32[0 max] concreteLayoutRow)
    {
        concreteLayoutRow = 0;
        stack u32[0 max] moduleRow = moduleOrdinal + 1;
        if (!self.ModuleNameStringIndexes.Contains(moduleRow) || alignmentBytes == 0)
        {
            return false;
        }

        stack u32[0 max] count = self.CompilerFactConcreteLayoutCounts.Get(moduleRow);
        if (count == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] qualifiedTypeNameStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(
            self.Strings,
            qualifiedTypeName,
            qualifiedTypeNameStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonCompilerFactConcreteLayoutRow row =
            new LogicalPackageManifestJsonCompilerFactConcreteLayoutRow()
            {
                QualifiedTypeNameStringIndex = qualifiedTypeNameStringIndex,
                SizeBytes = sizeBytes,
                AlignmentBytes = alignmentBytes
            };
        stack u32[0 max] rowIndex = self.CompilerFactConcreteLayoutRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (count == 0)
        {
            if (!self.CompilerFactConcreteLayoutFirstRows.Replace(moduleRow, rowIndex))
            {
                return false;
            }
        }
        else
        {
            stack u32[0 max] lastRowIndex =
                self.CompilerFactConcreteLayoutLastRows.Get(moduleRow);
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonCompilerFactConcreteLayoutRow lastRow =
                self.CompilerFactConcreteLayoutRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.CompilerFactConcreteLayoutRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        if (!self.CompilerFactConcreteLayoutLastRows.Replace(moduleRow, rowIndex)
            || !self.CompilerFactConcreteLayoutCounts.Replace(moduleRow, count + 1))
        {
            return false;
        }

        concreteLayoutRow = rowIndex;
        return true;
    }

    public fn bool AddCompilerFactConcreteField(
        mut borrow LogicalPackageManifestJsonBuilder self,
        u32[0 max] concreteLayoutRow,
        ascii name,
        u32[0 max] offsetBytes,
        u32[0 max] sizeBytes,
        u32[0 max] naturalAlignmentBytes,
        u32[0 max] effectiveAlignmentBytes,
        bool isMisaligned,
        out u32[0 max] concreteFieldRow)
    {
        concreteFieldRow = 0;
        if (!self.CompilerFactConcreteLayoutRows.Contains(concreteLayoutRow)
            || naturalAlignmentBytes == 0
            || effectiveAlignmentBytes == 0)
        {
            return false;
        }

        stack mut LogicalPackageManifestJsonCompilerFactConcreteLayoutRow layoutRow =
            self.CompilerFactConcreteLayoutRows.Get(concreteLayoutRow);
        if (layoutRow.FieldCount == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] nameStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(self.Strings, name, nameStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonCompilerFactConcreteFieldRow row =
            new LogicalPackageManifestJsonCompilerFactConcreteFieldRow()
            {
                ConcreteLayoutRow = concreteLayoutRow,
                NameStringIndex = nameStringIndex,
                OffsetBytes = offsetBytes,
                SizeBytes = sizeBytes,
                NaturalAlignmentBytes = naturalAlignmentBytes,
                EffectiveAlignmentBytes = effectiveAlignmentBytes,
                IsMisaligned = isMisaligned
            };
        stack u32[0 max] rowIndex = self.CompilerFactConcreteFieldRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (layoutRow.FieldCount == 0)
        {
            layoutRow.FirstFieldRow = rowIndex;
        }
        else
        {
            stack u32[0 max] lastRowIndex = layoutRow.LastFieldRow;
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonCompilerFactConcreteFieldRow lastRow =
                self.CompilerFactConcreteFieldRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.CompilerFactConcreteFieldRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        layoutRow.LastFieldRow = rowIndex;
        layoutRow.FieldCount = layoutRow.FieldCount + 1;
        if (!self.CompilerFactConcreteLayoutRows.Replace(concreteLayoutRow, layoutRow))
        {
            return false;
        }

        concreteFieldRow = rowIndex;
        return true;
    }

    public fn bool AddNativeDependency(
        mut borrow LogicalPackageManifestJsonBuilder self,
        LogicalPackageNativeDependencyKind kind,
        ascii value,
        out u32[0 max] nativeDependencyRow)
    {
        nativeDependencyRow = 0;
        stack mut u32[0 max] count = 0;
        stack mut u32[0 max] lastRowIndex = 0;
        switch (kind)
        {
            case LogicalPackageNativeDependencyKind.Source:
                count = self.NativeSourceDependencyCount;
                lastRowIndex = self.NativeSourceDependencyLastRow;
            case LogicalPackageNativeDependencyKind.IncludeDirectory:
                count = self.NativeIncludeDirectoryDependencyCount;
                lastRowIndex = self.NativeIncludeDirectoryDependencyLastRow;
            case LogicalPackageNativeDependencyKind.LibraryDirectory:
                count = self.NativeLibraryDirectoryDependencyCount;
                lastRowIndex = self.NativeLibraryDirectoryDependencyLastRow;
            case LogicalPackageNativeDependencyKind.Library:
                count = self.NativeLibraryDependencyCount;
                lastRowIndex = self.NativeLibraryDependencyLastRow;
            case LogicalPackageNativeDependencyKind.LinkArgument:
                count = self.NativeLinkArgumentDependencyCount;
                lastRowIndex = self.NativeLinkArgumentDependencyLastRow;
            case LogicalPackageNativeDependencyKind.PkgConfigPackage:
                count = self.NativePkgConfigPackageDependencyCount;
                lastRowIndex = self.NativePkgConfigPackageDependencyLastRow;
        }

        if (count == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] textStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(self.Strings, value, textStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonNativeDependencyRow row =
            new LogicalPackageManifestJsonNativeDependencyRow()
            {
                Kind = kind,
                TextStringIndex = textStringIndex
            };
        stack u32[0 max] rowIndex = self.NativeDependencyRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (count == 0)
        {
            switch (kind)
            {
                case LogicalPackageNativeDependencyKind.Source:
                    self.NativeSourceDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.IncludeDirectory:
                    self.NativeIncludeDirectoryDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.LibraryDirectory:
                    self.NativeLibraryDirectoryDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.Library:
                    self.NativeLibraryDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.LinkArgument:
                    self.NativeLinkArgumentDependencyFirstRow = rowIndex;
                case LogicalPackageNativeDependencyKind.PkgConfigPackage:
                    self.NativePkgConfigPackageDependencyFirstRow = rowIndex;
            }
        }
        else
        {
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonNativeDependencyRow lastRow =
                self.NativeDependencyRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.NativeDependencyRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        switch (kind)
        {
            case LogicalPackageNativeDependencyKind.Source:
                self.NativeSourceDependencyLastRow = rowIndex;
                self.NativeSourceDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.IncludeDirectory:
                self.NativeIncludeDirectoryDependencyLastRow = rowIndex;
                self.NativeIncludeDirectoryDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.LibraryDirectory:
                self.NativeLibraryDirectoryDependencyLastRow = rowIndex;
                self.NativeLibraryDirectoryDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.Library:
                self.NativeLibraryDependencyLastRow = rowIndex;
                self.NativeLibraryDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.LinkArgument:
                self.NativeLinkArgumentDependencyLastRow = rowIndex;
                self.NativeLinkArgumentDependencyCount = count + 1;
            case LogicalPackageNativeDependencyKind.PkgConfigPackage:
                self.NativePkgConfigPackageDependencyLastRow = rowIndex;
                self.NativePkgConfigPackageDependencyCount = count + 1;
        }

        nativeDependencyRow = rowIndex;
        return true;
    }

    public fn bool AddCompilerFactLinkage(
        mut borrow LogicalPackageManifestJsonBuilder self,
        u32[0 max] moduleOrdinal,
        ascii objectFileName,
        out u32[0 max] linkageRow)
    {
        linkageRow = 0;
        stack u32[0 max] moduleRow = moduleOrdinal + 1;
        if (!self.ModuleNameStringIndexes.Contains(moduleRow)
            || self.CompilerFactLinkageRowsByModule.Get(moduleRow) != 0)
        {
            return false;
        }

        stack mut u32[0 max] objectFileNameStringIndex = PackageImageNullStringIndex();
        if (!LogicalPackageImageStringTableBuilderTryAdd(
            self.Strings,
            objectFileName,
            objectFileNameStringIndex))
        {
            return false;
        }

        stack LogicalPackageManifestJsonCompilerFactLinkageRow row =
            new LogicalPackageManifestJsonCompilerFactLinkageRow()
            {
                ObjectFileNameStringIndex = objectFileNameStringIndex
            };
        stack u32[0 max] rowIndex = self.CompilerFactLinkageRows.Add(row);
        if (rowIndex == 0 || !self.CompilerFactLinkageRowsByModule.Replace(moduleRow, rowIndex))
        {
            return false;
        }

        linkageRow = rowIndex;
        return true;
    }

    public fn bool AddCompilerFactLinkageDefinedSymbol(
