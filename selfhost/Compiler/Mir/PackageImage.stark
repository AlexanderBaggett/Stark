internal fn bool LogicalPackageImageJsonTypedDeclarationTypeReferenceNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] declarationNode,
    LogicalPackageTypedDeclarationKind declarationKind,
    LogicalPackageTypedTypeReferenceSource source,
    u32[0 max] payloadOrdinal,
    out u64[0 2 ** 63 - 1] typeReferenceNode)
{
    typeReferenceNode = 0;
    stack mut u64[0 2 ** 63 - 1] payloadArrayNode = 0;
    stack mut u64[0 2 ** 63 - 1] payloadNode = 0;
    stack mut u32[0 max] payloadCount = 0;
    switch (source)
    {
        case LogicalPackageTypedTypeReferenceSource.TypeAliasTarget:
            if (declarationKind != LogicalPackageTypedDeclarationKind.TypeAlias
                || payloadOrdinal != 0)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, declarationNode, "TargetType", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeAliasComptimeGenericParameterType:
            if (declarationKind != LogicalPackageTypedDeclarationKind.TypeAlias
                || !LogicalPackageImageJsonOptionalArrayMember(
                    document,
                    declarationNode,
                    "ComptimeGenericParameters",
                    payloadArrayNode,
                    payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.FunctionReturn:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Function
                || payloadOrdinal != 0)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, declarationNode, "ReturnType", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.FunctionParameter:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Function
                || !LogicalPackageImageJsonRequiredArrayMember(document, declarationNode, "Parameters", payloadArrayNode, payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.MethodReturn:
        case LogicalPackageTypedTypeReferenceSource.MethodParameter:
        case LogicalPackageTypedTypeReferenceSource.CallableComptimeGenericParameterType:
        case LogicalPackageTypedTypeReferenceSource.CallableTypeParameterConstraintBoundTrait:
        case LogicalPackageTypedTypeReferenceSource.CallableThreadSafetyLawPredicateType:
        case LogicalPackageTypedTypeReferenceSource.GlobalConstantInitializerType:
            return false;
        case LogicalPackageTypedTypeReferenceSource.GlobalType:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Global
                || payloadOrdinal != 0)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, declarationNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeField:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Type
                || !LogicalPackageImageJsonRequiredArrayMember(document, declarationNode, "Fields", payloadArrayNode, payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeAssociatedTypeTarget:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Type
                || !LogicalPackageImageJsonRequiredArrayMember(document, declarationNode, "AssociatedTypes", payloadArrayNode, payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "TargetType", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeImplementedTrait:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Type
                || !LogicalPackageImageJsonRequiredArrayMember(document, declarationNode, "ImplementedTraitTypes", payloadArrayNode, payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object)
            {
                return false;
            }

            typeReferenceNode = payloadNode;
            return true;
        case LogicalPackageTypedTypeReferenceSource.TypeThreadSafetyLawAttributeConditionType:
            if (declarationKind != LogicalPackageTypedDeclarationKind.Type
                || !LogicalPackageImageJsonRequiredArrayMember(
                    document,
                    declarationNode,
                    "ThreadSafetyLawAttributes",
                    payloadArrayNode,
                    payloadCount)
                || payloadOrdinal >= payloadCount
                || !document.TryChildAt(payloadArrayNode, (u64[0 2 ** 63 - 1])payloadOrdinal, payloadNode)
                || document.KindAt(payloadNode) != JsonKind.Object
                || !LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Condition", payloadNode))
            {
                return false;
            }

            return LogicalPackageImageJsonRequiredObjectMember(document, payloadNode, "Type", typeReferenceNode);
        case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantPayloadType:
        case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantAbsorbsErrorType:
        case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipEventPlaceType:
        case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipRootType:
            return false;
    }
}

internal fn bool LogicalPackageImageJsonTypedCallableTypeReferenceNode(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typedInterfaceNode,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    LogicalPackageTypedTypeReferenceSource source,
    u32[0 max] payloadOrdinal,
    out u64[0 2 ** 63 - 1] typeReferenceNode)
{
    typeReferenceNode = 0;
    stack mut u64[0 2 ** 63 - 1] callableNode = 0;
    stack mut u64[0 2 ** 63 - 1] parameterNode = 0;
    switch (callableKind)
    {
        case LogicalPackageTypedCallableKind.Function:
            if (methodOrdinal != 0)
            {
                return false;
            }

            switch (source)
            {
                case LogicalPackageTypedTypeReferenceSource.FunctionReturn:
                    if (payloadOrdinal != 0
                        || !LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode))
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(
                        document,
                        callableNode,
                        "ReturnType",
                        typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.FunctionParameter:
                    if (!LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode)
                        || !LogicalPackageImageJsonTypedCallableParameterNode(
                            document,
                            callableNode,
                            payloadOrdinal,
                            parameterNode))
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(document, parameterNode, "Type", typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.TypeAliasTarget:
                case LogicalPackageTypedTypeReferenceSource.TypeAliasComptimeGenericParameterType:
                case LogicalPackageTypedTypeReferenceSource.MethodReturn:
                case LogicalPackageTypedTypeReferenceSource.MethodParameter:
                case LogicalPackageTypedTypeReferenceSource.CallableComptimeGenericParameterType:
                case LogicalPackageTypedTypeReferenceSource.CallableTypeParameterConstraintBoundTrait:
                case LogicalPackageTypedTypeReferenceSource.CallableThreadSafetyLawPredicateType:
                case LogicalPackageTypedTypeReferenceSource.GlobalType:
                case LogicalPackageTypedTypeReferenceSource.GlobalConstantInitializerType:
                case LogicalPackageTypedTypeReferenceSource.TypeField:
                case LogicalPackageTypedTypeReferenceSource.TypeAssociatedTypeTarget:
                case LogicalPackageTypedTypeReferenceSource.TypeImplementedTrait:
                case LogicalPackageTypedTypeReferenceSource.TypeThreadSafetyLawAttributeConditionType:
                case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantPayloadType:
                case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantAbsorbsErrorType:
                case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipEventPlaceType:
                case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipRootType:
                    return false;
            }
        case LogicalPackageTypedCallableKind.Method:
            switch (source)
            {
                case LogicalPackageTypedTypeReferenceSource.MethodReturn:
                    if (payloadOrdinal != 0
                        || !LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode))
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(
                        document,
                        callableNode,
                        "ReturnType",
                        typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.MethodParameter:
                    if (!LogicalPackageImageJsonTypedCallableNode(
                            document,
                            typedInterfaceNode,
                            callableKind,
                            declarationOrdinal,
                            methodOrdinal,
                            callableNode)
                        || !LogicalPackageImageJsonTypedCallableParameterNode(
                            document,
                            callableNode,
                            payloadOrdinal,
                            parameterNode))
                    {
                        return false;
                    }

                    return LogicalPackageImageJsonRequiredObjectMember(document, parameterNode, "Type", typeReferenceNode);
                case LogicalPackageTypedTypeReferenceSource.TypeAliasTarget:
                case LogicalPackageTypedTypeReferenceSource.TypeAliasComptimeGenericParameterType:
                case LogicalPackageTypedTypeReferenceSource.FunctionReturn:
                case LogicalPackageTypedTypeReferenceSource.FunctionParameter:
                case LogicalPackageTypedTypeReferenceSource.CallableComptimeGenericParameterType:
                case LogicalPackageTypedTypeReferenceSource.CallableTypeParameterConstraintBoundTrait:
                case LogicalPackageTypedTypeReferenceSource.CallableThreadSafetyLawPredicateType:
                case LogicalPackageTypedTypeReferenceSource.GlobalType:
                case LogicalPackageTypedTypeReferenceSource.GlobalConstantInitializerType:
                case LogicalPackageTypedTypeReferenceSource.TypeField:
                case LogicalPackageTypedTypeReferenceSource.TypeAssociatedTypeTarget:
                case LogicalPackageTypedTypeReferenceSource.TypeImplementedTrait:
                case LogicalPackageTypedTypeReferenceSource.TypeThreadSafetyLawAttributeConditionType:
                case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantPayloadType:
                case LogicalPackageTypedTypeReferenceSource.TypeEnumVariantAbsorbsErrorType:
                case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipEventPlaceType:
                case LogicalPackageTypedTypeReferenceSource.FunctionOwnershipRootType:
                    return false;
            }
    }
}

internal fn bool LogicalPackageTypeReferenceWorkListAdd(
    mut borrow IrTable<LogicalPackageTypeReferenceWorkItem> work,
    u64[0 2 ** 63 - 1] node,
    u32[0 max] parentTypeReferenceRow,
    LogicalPackageTypeReferenceChildKind parentChildKind,
    u32[0 max] parentChildOrdinal)
{
    if (node == 0)
    {
        return false;
    }

    stack LogicalPackageTypeReferenceWorkItem item = new LogicalPackageTypeReferenceWorkItem()
    {
        NodeValue = node,
        ParentTypeReferenceRowValue = parentTypeReferenceRow,
        ParentChildKindValue = parentChildKind,
        ParentChildOrdinalValue = parentChildOrdinal
    };
    return work.Add(item) != 0;
}

