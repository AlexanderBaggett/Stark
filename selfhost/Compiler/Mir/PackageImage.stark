internal fn bool LogicalPackageImageJsonMaterializeCallableImportRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] callableNode,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    mut borrow LogicalPackageTypedCallableFactGraph graph,
    out bool hasImportRow)
{
    hasImportRow = false;
    stack mut bool hasFfiAbi = false;
    stack mut bool hasLinkName = false;
    stack mut u32[0 max] ffiAbiTextRow = 0;
    stack mut u32[0 max] linkNameTextRow = 0;
    if (!LogicalPackageImageJsonMaterializeOptionalCallableFactTextMemberRow(
            document,
            callableNode,
            "FfiAbi",
            LogicalPackageTypedCallableFactTextKind.FfiAbi,
            0,
            graph,
            hasFfiAbi,
            ffiAbiTextRow))
    {
        return false;
    }

    if (callableKind == LogicalPackageTypedCallableKind.Method
        && LogicalPackageImageJsonMemberHasValue(document, callableNode, "LinkName"))
    {
        return false;
    }

    if (callableKind == LogicalPackageTypedCallableKind.Function
        && !LogicalPackageImageJsonMaterializeOptionalCallableFactTextMemberRow(
            document,
            callableNode,
            "LinkName",
            LogicalPackageTypedCallableFactTextKind.LinkName,
            0,
            graph,
            hasLinkName,
            linkNameTextRow))
    {
        return false;
    }

    if (!hasFfiAbi && !hasLinkName)
    {
        return true;
    }

    hasImportRow = true;
    return LogicalPackageTypedCallableFactGraphAddImportRow(
        graph,
        moduleOrdinal,
        callableKind,
        declarationOrdinal,
        methodOrdinal,
        hasFfiAbi,
        ffiAbiTextRow,
        hasLinkName,
        linkNameTextRow);
}

internal fn bool LogicalPackageImageJsonMaterializeCallableAsmRows(
