        self.HasRangeMinValue = false;
        self.HasRangeMaxValue = false;
        self.HasIsUnsignedValue = false;
        self.IsUnsignedValue = false;
        self.IsMutablePointerValue = false;
        self.HasBorrowKindValue = false;
        self.HasAccessKindValue = false;
        self.HasInitializationKindValue = false;
        self.IsMutableViewValue = false;
        self.HasFixedLengthValue = false;
        self.HasFixedLengthParameterNameValue = false;
        self.HasElementTypeValue = false;
        self.HasFunctionKindValue = false;
        self.HasFunctionAbiValue = false;
        self.HasFunctionIsUnsafeValue = false;
