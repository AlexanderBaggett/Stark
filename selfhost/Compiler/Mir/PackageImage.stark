                declarationOrdinal,
                callableNode);
        case LogicalPackageTypedCallableKind.Method:
            stack mut u64[0 2 ** 63 - 1] typeNode = 0;
            stack mut u64[0 2 ** 63 - 1] methodsNode = 0;
            stack mut u32[0 max] methodCount = 0;
            stack mut u64[0 2 ** 63 - 1] found = 0;
            if (!LogicalPackageImageJsonTypedDeclarationNode(
