internal fn bool LogicalPackageImageJsonMaterializeParameterGroupRegionRows(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] groupNode,
    u32[0 max] typeReferenceRow,
    u32[0 max] groupRow,
    mut borrow LogicalPackageTypeReferenceGraph graph,
    out u32[0 max] regionCount)
{
    regionCount = 0;
    stack mut u64[0 2 ** 63 - 1] regionsNode = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(document, groupNode, "Regions", regionsNode, regionCount))
    {
