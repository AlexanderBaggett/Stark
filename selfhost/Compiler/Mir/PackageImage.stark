    if (!LogicalPackageImageJsonOptionalObjectMember(document, callableNode, "Asm", asmNode, hasAsm))
    {
        return false;
    }

    if (!hasAsm)
    {
        return true;
    }

    stack mut u64[0 2 ** 63 - 1] inputsNode = 0;
    stack mut u64[0 2 ** 63 - 1] outputsNode = 0;
    stack mut u64[0 2 ** 63 - 1] clobbersNode = 0;
    stack mut u32[0 max] inputCount = 0;
    stack mut u32[0 max] outputCount = 0;
    stack mut u32[0 max] clobberCount = 0;
    stack mut u32[0 max] architectureTextRow = 0;
