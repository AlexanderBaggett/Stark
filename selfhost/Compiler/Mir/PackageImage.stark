            false,
            typeReferenceRow,
            graph,
            pointeeDeadOnReturnParameterNameCount)
        || !LogicalPackageImageJsonEnqueueOptionalTypeReferenceObjectChild(
            document,
            typeReferenceNode,
            "AssociatedOwnerType",
            LogicalPackageTypeReferenceChildKind.AssociatedOwnerType,
            typeReferenceRow,
            work,
            hasAssociatedOwnerType)
        || !LogicalPackageImageJsonMaterializeTypeReferenceTextMember(
            document,
            typeReferenceNode,
            "AssociatedTypeName",
            false,
            LogicalPackageTypeReferenceTextKind.AssociatedTypeName,
            0,
            typeReferenceRow,
            graph,
            hasAssociatedTypeName)
        || !LogicalPackageImageJsonMaterializeTypeReferenceTextMember(
            document,
            typeReferenceNode,
            "SourceAliasName",
            false,
            LogicalPackageTypeReferenceTextKind.SourceAliasName,
            0,
            typeReferenceRow,
            graph,
            hasSourceAliasName))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] textRowsWritten = graph.TextRows.Count() - (u64[0 2 ** 63 - 1])(firstTextRow - 1);
    if (textRowsWritten == 0 || textRowsWritten > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return false;
    }

    stack mut LogicalPackageTypeReferenceRow row = graph.TypeReferenceRows.Get(typeReferenceRow);
    row.SummaryValue = new LogicalPackageTypeReferenceSummary()
    {
        ModuleOrdinalValue = moduleOrdinal,
        DeclarationOrdinalValue = declarationOrdinal,
        MethodOrdinalValue = methodOrdinal,
        VariantOrdinalValue = variantOrdinal,
        DeclarationKindValue = declarationKind,
