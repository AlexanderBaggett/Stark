            typeReferenceNode,
            "InitializationKind",
            false,
            LogicalPackageTypeReferenceTextKind.InitializationKind,
            0,
            typeReferenceRow,
            graph,
            hasInitializationKind)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, typeReferenceNode, "IsMutableView", isMutableView)
        || !LogicalPackageImageJsonOptionalU32MemberValue(
            document,
            typeReferenceNode,
            "FixedLength",
            hasFixedLength,
            fixedLength)
        || !LogicalPackageImageJsonMaterializeTypeReferenceTextMember(
            document,
            typeReferenceNode,
            "FixedLengthParameterName",
            false,
            LogicalPackageTypeReferenceTextKind.FixedLengthParameterName,
            0,
            typeReferenceRow,
            graph,
            hasFixedLengthParameterName)
        || !LogicalPackageImageJsonEnqueueOptionalTypeReferenceObjectChild(
            document,
            typeReferenceNode,
            "ElementType",
            LogicalPackageTypeReferenceChildKind.ElementType,
            typeReferenceRow,
            work,
            hasElementType)
        || !LogicalPackageImageJsonEnqueueOptionalTypeReferenceArrayChildren(
            document,
            typeReferenceNode,
            "TypeArguments",
            LogicalPackageTypeReferenceChildKind.TypeArgument,
            typeReferenceRow,
            work,
            typeArgumentCount)
        || !LogicalPackageImageJsonMaterializeComptimeValueArgumentRows(
            document,
            typeReferenceNode,
