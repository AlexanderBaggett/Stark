internal fn bool LogicalPackageImageJsonTypedDeclarationGlobalFacts(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] declarationNode,
    out bool isMutable,
    out bool hasConstantInitializer)
{
    isMutable = false;
    hasConstantInitializer = false;
    stack mut u64[0 2 ** 63 - 1] typeNode = 0;
    stack mut u64[0 2 ** 63 - 1] initializerNode = 0;
    if (!LogicalPackageImageJsonRequiredObjectMember(document, declarationNode, "Type", typeNode)
        || !LogicalPackageImageJsonRequiredBoolMemberValue(document, declarationNode, "IsMutable", isMutable))
    {
        return false;
    }

    if (!document.TryFindMember(declarationNode, "ConstantInitializer", initializerNode)
        || document.KindAt(initializerNode) == JsonKind.Null)
    {
        return true;
    }

    if (document.KindAt(initializerNode) != JsonKind.Object)
    {
        return false;
    }

    hasConstantInitializer = true;
    return true;
}

internal fn bool LogicalPackageImageJsonTypeReferenceSummaryFacts(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] typeReferenceNode,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedDeclarationKind declarationKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    LogicalPackageTypedTypeReferenceSource source,
    u32[0 max] payloadOrdinal,
    out LogicalPackageTypeReferenceSummary typeReference,
    mut borrow OwnedAscii kind,
    mut borrow OwnedAscii name)
{
    typeReference = new();
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeValueArgumentCount = 0;
    stack mut u32[0 max] parameterTypeCount = 0;
    stack mut u32[0 max] parameterRawPointerElementCountExpressionCount = 0;
    stack mut u32[0 max] disjointParameterGroupCount = 0;
    stack mut u32[0 max] overlapParameterGroupCount = 0;
    stack mut u32[0 max] sameParameterGroupCount = 0;
    stack mut u32[0 max] pointeeDeadOnReturnParameterNameCount = 0;
    stack mut bool hasName = false;
    stack mut bool hasBitWidth = false;
    stack mut bool hasRangeMin = false;
    stack mut bool hasRangeMax = false;
    stack mut bool hasIsUnsigned = false;
    stack mut bool isUnsigned = false;
    stack mut bool isMutablePointer = false;
    stack mut bool hasBorrowKind = false;
    stack mut bool hasAccessKind = false;
    stack mut bool hasInitializationKind = false;
    stack mut bool isMutableView = false;
    stack mut bool hasFixedLength = false;
    stack mut bool hasFixedLengthParameterName = false;
    stack mut bool hasElementType = false;
    stack mut bool hasFunctionKind = false;
    stack mut bool hasFunctionAbi = false;
    stack mut bool hasFunctionIsUnsafe = false;
    stack mut bool functionIsUnsafe = false;
    stack mut bool hasFunctionIsTailCallable = false;
    stack mut bool functionIsTailCallable = false;
    stack mut bool hasClosureStorageKind = false;
    stack mut bool hasClosureCallCapability = false;
    stack mut bool hasDynTraitStorageKind = false;
    stack mut bool hasReturnType = false;
    stack mut bool hasAssociatedOwnerType = false;
    stack mut bool hasAssociatedTypeName = false;
    stack mut bool hasSourceAliasName = false;
    stack mut u64[0 2 ** 63 - 1] elementTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] returnTypeNode = 0;
    stack mut u64[0 2 ** 63 - 1] associatedOwnerTypeNode = 0;
    if (!LogicalPackageImageJsonAppendRequiredTextMember(document, typeReferenceNode, "Kind", kind)
        || !LogicalPackageImageJsonAppendOptionalTextMember(document, typeReferenceNode, "Name", name, hasName)
        || !LogicalPackageImageJsonMemberIsPresentNumber(document, typeReferenceNode, "BitWidth", hasBitWidth)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "RangeMin", hasRangeMin)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "RangeMax", hasRangeMax))
    {
        return false;
    }

    hasIsUnsigned = LogicalPackageImageJsonMemberHasValue(document, typeReferenceNode, "IsUnsigned");
    if (!LogicalPackageImageJsonOptionalBoolMemberValue(document, typeReferenceNode, "IsUnsigned", isUnsigned))
    {
        return false;
    }

    if (!LogicalPackageImageJsonOptionalBoolMemberValue(document, typeReferenceNode, "IsMutablePointer", isMutablePointer)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "BorrowKind", hasBorrowKind)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "AccessKind", hasAccessKind)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "InitializationKind", hasInitializationKind)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, typeReferenceNode, "IsMutableView", isMutableView)
        || !LogicalPackageImageJsonMemberIsPresentNumber(document, typeReferenceNode, "FixedLength", hasFixedLength)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "FixedLengthParameterName", hasFixedLengthParameterName)
        || !LogicalPackageImageJsonOptionalObjectMember(document, typeReferenceNode, "ElementType", elementTypeNode, hasElementType)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(document, typeReferenceNode, "TypeArguments", typeArgumentCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(document, typeReferenceNode, "ComptimeValueArguments", comptimeValueArgumentCount)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "FunctionKind", hasFunctionKind)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "FunctionAbi", hasFunctionAbi))
    {
        return false;
    }

    hasFunctionIsUnsafe = LogicalPackageImageJsonMemberHasValue(document, typeReferenceNode, "FunctionIsUnsafe");
    hasFunctionIsTailCallable = LogicalPackageImageJsonMemberHasValue(document, typeReferenceNode, "FunctionIsTailCallable");
    if (!LogicalPackageImageJsonOptionalBoolMemberValue(document, typeReferenceNode, "FunctionIsUnsafe", functionIsUnsafe)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, typeReferenceNode, "FunctionIsTailCallable", functionIsTailCallable)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "ClosureStorageKind", hasClosureStorageKind)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "ClosureCallCapability", hasClosureCallCapability)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "DynTraitStorageKind", hasDynTraitStorageKind)
        || !LogicalPackageImageJsonOptionalObjectMember(document, typeReferenceNode, "ReturnType", returnTypeNode, hasReturnType)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(document, typeReferenceNode, "ParameterTypes", parameterTypeCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(
            document,
            typeReferenceNode,
            "ParameterRawPointerElementCountExpressions",
            parameterRawPointerElementCountExpressionCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(document, typeReferenceNode, "DisjointParameterGroups", disjointParameterGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(document, typeReferenceNode, "OverlapParameterGroups", overlapParameterGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(document, typeReferenceNode, "SameParameterGroups", sameParameterGroupCount)
        || !LogicalPackageImageJsonOptionalArrayMemberCount(
            document,
            typeReferenceNode,
            "PointeeDeadOnReturnParameterNames",
            pointeeDeadOnReturnParameterNameCount)
        || !LogicalPackageImageJsonOptionalObjectMember(document, typeReferenceNode, "AssociatedOwnerType", associatedOwnerTypeNode, hasAssociatedOwnerType)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "AssociatedTypeName", hasAssociatedTypeName)
        || !LogicalPackageImageJsonMemberIsPresentText(document, typeReferenceNode, "SourceAliasName", hasSourceAliasName))
    {
        return false;
    }

    typeReference = new LogicalPackageTypeReferenceSummary()
    {
        ModuleOrdinalValue = moduleOrdinal,
        DeclarationOrdinalValue = declarationOrdinal,
        MethodOrdinalValue = methodOrdinal,
        DeclarationKindValue = declarationKind,
        SourceValue = source,
        PayloadOrdinalValue = payloadOrdinal,
        TypeArgumentCountValue = typeArgumentCount,
        ComptimeValueArgumentCountValue = comptimeValueArgumentCount,
        ParameterTypeCountValue = parameterTypeCount,
        ParameterRawPointerElementCountExpressionCountValue = parameterRawPointerElementCountExpressionCount,
        DisjointParameterGroupCountValue = disjointParameterGroupCount,
        OverlapParameterGroupCountValue = overlapParameterGroupCount,
        SameParameterGroupCountValue = sameParameterGroupCount,
        PointeeDeadOnReturnParameterNameCountValue = pointeeDeadOnReturnParameterNameCount,
        HasNameValue = hasName,
        HasBitWidthValue = hasBitWidth,
        HasRangeMinValue = hasRangeMin,
        HasRangeMaxValue = hasRangeMax,
        HasIsUnsignedValue = hasIsUnsigned,
        IsUnsignedValue = isUnsigned,
        IsMutablePointerValue = isMutablePointer,
        HasBorrowKindValue = hasBorrowKind,
        HasAccessKindValue = hasAccessKind,
        HasInitializationKindValue = hasInitializationKind,
        IsMutableViewValue = isMutableView,
        HasFixedLengthValue = hasFixedLength,
        HasFixedLengthParameterNameValue = hasFixedLengthParameterName,
        HasElementTypeValue = hasElementType,
        HasFunctionKindValue = hasFunctionKind,
        HasFunctionAbiValue = hasFunctionAbi,
        HasFunctionIsUnsafeValue = hasFunctionIsUnsafe,
        FunctionIsUnsafeValue = functionIsUnsafe,
        HasFunctionIsTailCallableValue = hasFunctionIsTailCallable,
        FunctionIsTailCallableValue = functionIsTailCallable,
        HasClosureStorageKindValue = hasClosureStorageKind,
        HasClosureCallCapabilityValue = hasClosureCallCapability,
        HasDynTraitStorageKindValue = hasDynTraitStorageKind,
        HasReturnTypeValue = hasReturnType,
        HasAssociatedOwnerTypeValue = hasAssociatedOwnerType,
        HasAssociatedTypeNameValue = hasAssociatedTypeName,
        HasSourceAliasNameValue = hasSourceAliasName
    };
    return true;
}

internal fn bool LogicalPackageImageJsonRequiredTextMemberMatchesFact(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    borrow IrTable<u8[0 max]> buf,
    LogicalPackageImageFacts facts,
    u32[0 max] stringIndex)
{
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!LogicalStringIndexIsPresent(stringIndex)
        || !document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    return LogicalPackageImageFactStringEquals(buf, facts, stringIndex, value);
}

internal fn bool LogicalPackageImageJsonOptionalTextMemberMatchesFact(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    borrow IrTable<u8[0 max]> buf,
    LogicalPackageImageFacts facts,
    u32[0 max] stringIndex)
{
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return !LogicalStringIndexIsPresent(stringIndex);
    }

    if (!LogicalStringIndexIsPresent(stringIndex) || document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    return LogicalPackageImageFactStringEquals(buf, facts, stringIndex, value);
}

internal fn bool LogicalPackageImageJsonRequiredBoolMemberEquals(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    bool expected)
{
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member))
    {
        return false;
    }

    stack JsonKind kind = document.KindAt(member);
    if (kind != JsonKind.True && kind != JsonKind.False)
    {
        return false;
    }

    return document.BoolAt(member) == expected;
}

internal fn bool LogicalPackageImageJsonRequiredU32MemberEquals(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    u32[0 max] expected)
{
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) != JsonKind.Number)
    {
        return false;
    }

    switch (document.I64At(member))
    {
        case JsonResult<i64[min max]>.Err(var error):
            return false;
        case JsonResult<i64[min max]>.Ok(var value):
            if (value < 0 || value > (i64[min max])(2 ** 32 - 1))
            {
                return false;
            }

            return (u32[0 max])value == expected;
    }
}

internal fn bool LogicalPackageImageJsonTargetFeaturesMatchFacts(
    mut borrow JsonDocument document,
    borrow IrTable<u8[0 max]> buf,
    LogicalPackageImageFacts facts,
    u64[0 2 ** 63 - 1] targetNode)
{
    stack mut u64[0 2 ** 63 - 1] featuresNode = 0;
    if (!document.TryFindMember(targetNode, "Features", featuresNode)
        || document.KindAt(featuresNode) == JsonKind.Null)
    {
        return facts.TargetFeatureCountValue == 0;
    }

    if (document.KindAt(featuresNode) != JsonKind.Array
        || document.ChildCountAt(featuresNode) != (u64[0 2 ** 63 - 1])facts.TargetFeatureCountValue)
    {
        return false;
    }

    stack mut u32[0 max] featureIndex = 0;
    while willexit (featureIndex < facts.TargetFeatureCountValue)
    {
        stack mut u64[0 2 ** 63 - 1] featureNode = 0;
        if (!document.TryChildAt(featuresNode, (u64[0 2 ** 63 - 1])featureIndex, featureNode)
            || document.KindAt(featureNode) != JsonKind.Text)
        {
            return false;
        }

        stack mut u32[0 max] stringIndex = PackageImageNullStringIndex();
        if (!TryReadLogicalPackageImageTargetFeatureStringIndex(buf, facts, featureIndex, stringIndex))
        {
            return false;
        }

        stack ascii featureName = document.TextAt(featureNode);
        if (!LogicalPackageImageFactStringEquals(buf, facts, stringIndex, featureName))
        {
            return false;
        }

        featureIndex = featureIndex + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonCDataModelMatchesFacts(
    mut borrow JsonDocument document,
    borrow IrTable<u8[0 max]> buf,
    LogicalPackageImageFacts facts,
    u64[0 2 ** 63 - 1] targetNode)
{
    stack mut u64[0 2 ** 63 - 1] cDataModelNode = 0;
    if (!document.TryFindMember(targetNode, "CDataModel", cDataModelNode)
        || document.KindAt(cDataModelNode) == JsonKind.Null)
    {
        return !facts.HasCDataModelValue;
    }

    if (!facts.HasCDataModelValue || document.KindAt(cDataModelNode) != JsonKind.Object)
    {
        return false;
    }

    return LogicalPackageImageJsonRequiredTextMemberMatchesFact(
            document,
            cDataModelNode,
            "Kind",
            buf,
            facts,
            facts.CDataModelKindStringIndexValue)
        && LogicalPackageImageJsonRequiredBoolMemberEquals(document, cDataModelNode, "CharIsSigned", facts.CCharIsSignedValue)
        && LogicalPackageImageJsonRequiredU32MemberEquals(document, cDataModelNode, "PointerBitWidth", facts.CPointerBitWidthValue)
        && LogicalPackageImageJsonRequiredU32MemberEquals(document, cDataModelNode, "LongBitWidth", facts.CLongBitWidthValue)
        && LogicalPackageImageJsonRequiredU32MemberEquals(document, cDataModelNode, "SizeTBitWidth", facts.CSizeTBitWidthValue)
        && LogicalPackageImageJsonRequiredU32MemberEquals(document, cDataModelNode, "PtrDiffTBitWidth", facts.CPtrDiffTBitWidthValue);
}

internal fn bool LogicalPackageImageJsonAggregateLayoutMatchesFacts(
    mut borrow JsonDocument document,
    LogicalPackageImageFacts facts,
    u64[0 2 ** 63 - 1] targetNode)
{
    stack mut u64[0 2 ** 63 - 1] aggregateLayoutNode = 0;
    if (!document.TryFindMember(targetNode, "AggregateLayout", aggregateLayoutNode)
        || document.KindAt(aggregateLayoutNode) == JsonKind.Null)
    {
        return !facts.HasAggregateLayoutValue;
    }

    if (!facts.HasAggregateLayoutValue || document.KindAt(aggregateLayoutNode) != JsonKind.Object)
    {
        return false;
    }

    return LogicalPackageImageJsonRequiredU32MemberEquals(
            document,
            aggregateLayoutNode,
            "PointerSizeBytes",
            facts.AggregatePointerSizeBytesValue)
        && LogicalPackageImageJsonRequiredU32MemberEquals(
            document,
            aggregateLayoutNode,
            "PointerAlignmentBytes",
            facts.AggregatePointerAlignmentBytesValue);
}

internal fn bool LogicalPackageImageJsonTargetMatchesFacts(
    mut borrow JsonDocument document,
    borrow IrTable<u8[0 max]> buf,
    LogicalPackageImageFacts facts,
    u64[0 2 ** 63 - 1] rootNode)
{
    stack mut u64[0 2 ** 63 - 1] targetNode = 0;
    if (!document.TryFindMember(rootNode, "Target", targetNode)
        || document.KindAt(targetNode) == JsonKind.Null)
    {
        return !facts.HasTargetValue;
    }

    if (!facts.HasTargetValue || document.KindAt(targetNode) != JsonKind.Object)
    {
        return false;
    }

    return LogicalPackageImageJsonRequiredTextMemberMatchesFact(
            document,
            targetNode,
            "Triple",
            buf,
            facts,
            facts.TargetTripleStringIndexValue)
        && LogicalPackageImageJsonOptionalTextMemberMatchesFact(
            document,
            targetNode,
            "DataLayout",
            buf,
            facts,
            facts.TargetDataLayoutStringIndexValue)
        && LogicalPackageImageJsonOptionalTextMemberMatchesFact(
            document,
            targetNode,
            "Cpu",
            buf,
            facts,
            facts.TargetCpuStringIndexValue)
        && LogicalPackageImageJsonRequiredTextMemberMatchesFact(
            document,
            targetNode,
            "RelocationModel",
            buf,
            facts,
            facts.RelocationModelStringIndexValue)
        && LogicalPackageImageJsonOptionalTextMemberMatchesFact(
            document,
            targetNode,
            "CodeModel",
            buf,
            facts,
            facts.CodeModelStringIndexValue)
        && LogicalPackageImageJsonTargetFeaturesMatchFacts(document, buf, facts, targetNode)
        && LogicalPackageImageJsonCDataModelMatchesFacts(document, buf, facts, targetNode)
        && LogicalPackageImageJsonAggregateLayoutMatchesFacts(document, facts, targetNode);
}

internal fn bool LogicalPackageImageJsonBuildProfileMatchesFacts(
    mut borrow JsonDocument document,
    borrow IrTable<u8[0 max]> buf,
    LogicalPackageImageFacts facts,
    u64[0 2 ** 63 - 1] rootNode)
{
    stack mut u64[0 2 ** 63 - 1] profileNode = 0;
    if (!document.TryFindMember(rootNode, "BuildProfile", profileNode)
        || document.KindAt(profileNode) == JsonKind.Null)
    {
        return !facts.HasBuildProfileValue;
    }

    if (!facts.HasBuildProfileValue || document.KindAt(profileNode) != JsonKind.Object)
    {
        return false;
    }

    return LogicalPackageImageJsonRequiredTextMemberMatchesFact(
        document,
        profileNode,
        "Name",
        buf,
        facts,
        facts.BuildProfileStringIndexValue);
}

public unsafe fn bool TryReadLogicalPackageManifestJsonSummary(
    ascii manifestJson,
    borrow IrTable<u8[0 max]> buf,
    LogicalPackageImageFacts facts,
    out LogicalPackageManifestSummary manifest)
    where overlap(manifestJson, buf)
{
    manifest = new();
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            if (document.Count() == 0 || document.KindAt(0) != JsonKind.Object)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] rootModuleNode = 0;
            stack mut u64[0 2 ** 63 - 1] libraryNode = 0;
            stack mut u64[0 2 ** 63 - 1] modulesNode = 0;
            if (!document.TryFindMember(0, "RootModule", rootModuleNode)
                || document.KindAt(rootModuleNode) != JsonKind.Text
                || !document.TryFindMember(0, "LibraryFileName", libraryNode)
                || document.KindAt(libraryNode) != JsonKind.Text
                || !document.TryFindMember(0, "Modules", modulesNode)
                || document.KindAt(modulesNode) != JsonKind.Array)
            {
                return false;
            }

            stack ascii rootModule = document.TextAt(rootModuleNode);
            stack ascii libraryFileName = document.TextAt(libraryNode);
            if (!LogicalPackageImageFactStringEquals(buf, facts, facts.RootModuleStringIndexValue, rootModule)
                || !LogicalPackageImageFactStringEquals(buf, facts, facts.LibraryFileNameStringIndexValue, libraryFileName))
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] moduleCount = document.ChildCountAt(modulesNode);
            if (moduleCount == 0 || moduleCount > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
            {
                return false;
            }

            stack u32[0 max] moduleCount32 = (u32[0 max])moduleCount;
            stack mut u32[0 max] rootModuleOrdinal = PackageImageNullStringIndex();
            stack mut u32[0 max] moduleIndex = 0;
            while willexit (moduleIndex < moduleCount32)
            {
                stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
                stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
                if (!document.TryChildAt(modulesNode, (u64[0 2 ** 63 - 1])moduleIndex, moduleNode)
                    || document.KindAt(moduleNode) != JsonKind.Object
                    || !document.TryFindMember(moduleNode, "ModuleName", moduleNameNode)
                    || document.KindAt(moduleNameNode) != JsonKind.Text)
                {
                    return false;
                }

                if (document.TextAt(moduleNameNode) == rootModule)
                {
                    rootModuleOrdinal = moduleIndex;
                }

                moduleIndex = moduleIndex + 1;
            }

            if (!LogicalStringIndexIsPresent(rootModuleOrdinal)
                || !LogicalPackageImageJsonBuildProfileMatchesFacts(document, buf, facts, 0)
                || !LogicalPackageImageJsonTargetMatchesFacts(document, buf, facts, 0))
            {
                return false;
            }

            manifest = new LogicalPackageManifestSummary()
            {
                ModuleCountValue = moduleCount32,
                RootModuleOrdinalValue = rootModuleOrdinal,
                HasNativeDependenciesValue = LogicalPackageImageJsonMemberHasValue(document, 0, "NativeDependencies"),
                HasBuildProfileValue = facts.HasBuildProfileValue,
                HasTargetValue = facts.HasTargetValue,
                HasCDataModelValue = facts.HasCDataModelValue,
                HasAggregateLayoutValue = facts.HasAggregateLayoutValue
            };
            return true;
    }
}

public unsafe fn bool TryReadLogicalPackageManifestModuleJsonSummary(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    out LogicalPackageManifestModuleSummary manifestModule)
{
    manifestModule = new();
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            if (document.Count() == 0 || document.KindAt(0) != JsonKind.Object)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] modulesNode = 0;
            if (!document.TryFindMember(0, "Modules", modulesNode)
                || document.KindAt(modulesNode) != JsonKind.Array)
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] moduleCount = document.ChildCountAt(modulesNode);
            if (moduleCount == 0
                || moduleCount > (u64[0 2 ** 63 - 1])(2 ** 32 - 1)
                || (u64[0 2 ** 63 - 1])moduleOrdinal >= moduleCount)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] moduleNameNode = 0;
            if (!document.TryChildAt(modulesNode, (u64[0 2 ** 63 - 1])moduleOrdinal, moduleNode)
                || document.KindAt(moduleNode) != JsonKind.Object
                || !document.TryFindMember(moduleNode, "ModuleName", moduleNameNode)
                || document.KindAt(moduleNameNode) != JsonKind.Text)
            {
                return false;
            }

            if (System.Text.AsciiLength(document.TextAt(moduleNameNode)) <= 0)
            {
                return false;
            }

            stack mut u32[0 max] reExportCount = 0;
            stack mut u32[0 max] functionCount = 0;
            stack mut u32[0 max] typeCount = 0;
            stack mut u32[0 max] globalCount = 0;
            stack mut u32[0 max] typeAliasCount = 0;
            stack mut u32[0 max] importCount = 0;
            if (!LogicalPackageImageJsonRequiredArrayMemberCount(document, moduleNode, "ReExports", reExportCount)
                || !LogicalPackageImageJsonRequiredArrayMemberCount(document, moduleNode, "Functions", functionCount)
                || !LogicalPackageImageJsonRequiredArrayMemberCount(document, moduleNode, "Types", typeCount)
                || !LogicalPackageImageJsonRequiredArrayMemberCount(document, moduleNode, "Globals", globalCount)
                || !LogicalPackageImageJsonOptionalArrayMemberCount(document, moduleNode, "TypeAliases", typeAliasCount)
                || !LogicalPackageImageJsonOptionalArrayMemberCount(document, moduleNode, "Imports", importCount))
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] typedInterfaceNode = 0;
            stack mut u64[0 2 ** 63 - 1] compilerSectionsNode = 0;
            stack mut u64[0 2 ** 63 - 1] compilerSectionsTypedInterfaceNode = 0;
            stack mut bool hasTypedInterface = false;
            stack mut bool hasCompilerSections = false;
            stack mut bool hasCompilerSectionsTypedInterface = false;
            if (!LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "TypedInterface", typedInterfaceNode, hasTypedInterface)
                || !LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "CompilerSections", compilerSectionsNode, hasCompilerSections))
            {
                return false;
            }

            if (hasCompilerSections
                && !LogicalPackageImageJsonOptionalObjectMember(
                    document,
                    compilerSectionsNode,
                    "TypedInterface",
                    compilerSectionsTypedInterfaceNode,
                    hasCompilerSectionsTypedInterface))
            {
                return false;
            }

            stack mut bool usesCompilerSectionsTypedInterface = false;
            if (hasCompilerSectionsTypedInterface)
            {
                typedInterfaceNode = compilerSectionsTypedInterfaceNode;
                hasTypedInterface = true;
                usesCompilerSectionsTypedInterface = true;
            }

            stack mut u32[0 max] typedFunctionCount = 0;
            stack mut u32[0 max] typedTypeCount = 0;
            stack mut u32[0 max] typedGlobalCount = 0;
            stack mut u32[0 max] typedTypeAliasCount = 0;
            stack mut u32[0 max] typedImportCount = 0;
            if (hasTypedInterface
                && !LogicalPackageImageJsonTypedInterfaceCounts(
                    document,
                    typedInterfaceNode,
                    typedFunctionCount,
                    typedTypeCount,
                    typedGlobalCount,
                    typedTypeAliasCount,
                    typedImportCount))
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] directCompilerFactsNode = 0;
            stack mut u64[0 2 ** 63 - 1] compilerSectionsCompilerFactsNode = 0;
            stack mut u64[0 2 ** 63 - 1] directGenericTemplatesNode = 0;
            stack mut u64[0 2 ** 63 - 1] compilerSectionsGenericTemplatesNode = 0;
            stack mut u64[0 2 ** 63 - 1] sourceSurfaceNode = 0;
            stack mut bool hasDirectCompilerFacts = false;
            stack mut bool hasCompilerSectionsCompilerFacts = false;
            stack mut bool hasDirectGenericTemplates = false;
            stack mut bool hasCompilerSectionsGenericTemplates = false;
            stack mut bool hasSourceSurface = false;
            if (!LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "CompilerFacts", directCompilerFactsNode, hasDirectCompilerFacts)
                || !LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "GenericTemplates", directGenericTemplatesNode, hasDirectGenericTemplates)
                || !LogicalPackageImageJsonOptionalObjectMember(document, moduleNode, "SourceSurface", sourceSurfaceNode, hasSourceSurface))
            {
                return false;
            }

            if (hasCompilerSections)
            {
                if (!LogicalPackageImageJsonOptionalObjectMember(
                        document,
                        compilerSectionsNode,
                        "CompilerFacts",
                        compilerSectionsCompilerFactsNode,
                        hasCompilerSectionsCompilerFacts)
                    || !LogicalPackageImageJsonOptionalObjectMember(
                        document,
                        compilerSectionsNode,
                        "GenericTemplates",
                        compilerSectionsGenericTemplatesNode,
                        hasCompilerSectionsGenericTemplates))
                {
                    return false;
                }
            }

            manifestModule = new LogicalPackageManifestModuleSummary()
            {
                ModuleOrdinalValue = moduleOrdinal,
                ReExportCountValue = reExportCount,
                FunctionCountValue = functionCount,
                TypeCountValue = typeCount,
                GlobalCountValue = globalCount,
                TypeAliasCountValue = typeAliasCount,
                ImportCountValue = importCount,
                TypedInterfaceFunctionCountValue = typedFunctionCount,
                TypedInterfaceTypeCountValue = typedTypeCount,
                TypedInterfaceGlobalCountValue = typedGlobalCount,
                TypedInterfaceTypeAliasCountValue = typedTypeAliasCount,
                TypedInterfaceImportCountValue = typedImportCount,
                HasTypedInterfaceValue = hasTypedInterface,
                HasCompilerFactsValue = hasCompilerSectionsCompilerFacts || hasDirectCompilerFacts,
                HasGenericTemplatesValue = hasCompilerSectionsGenericTemplates || hasDirectGenericTemplates,
                HasSourceSurfaceValue = hasSourceSurface,
                HasCompilerSectionsValue = hasCompilerSections,
                UsesCompilerSectionsTypedInterfaceValue = usesCompilerSectionsTypedInterface
            };
            return true;
    }
}

public unsafe fn bool TryReadLogicalPackageTypedDeclarationJsonSummary(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedDeclarationKind declarationKind,
    u32[0 max] declarationOrdinal,
    out LogicalPackageTypedDeclarationSummary declaration,
    mut borrow OwnedAscii name,
    mut borrow OwnedAscii qualifiedName,
    mut borrow OwnedAscii visibility,
    mut borrow OwnedAscii manifestKind)
{
    declaration = new();
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] typedInterfaceNode = 0;
            stack mut u64[0 2 ** 63 - 1] declarationsNode = 0;
            stack mut u32[0 max] declarationCount = 0;
            stack mut bool usesCompilerSections = false;
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonEffectiveTypedInterfaceNode(document, moduleNode, typedInterfaceNode, usesCompilerSections)
                || !LogicalPackageImageJsonTypedDeclarationArrayNode(document, typedInterfaceNode, declarationKind, declarationsNode, declarationCount)
                || declarationOrdinal >= declarationCount)
            {
                return false;
            }

            stack mut u64[0 2 ** 63 - 1] declarationNode = 0;
            if (!document.TryChildAt(declarationsNode, (u64[0 2 ** 63 - 1])declarationOrdinal, declarationNode)
                || document.KindAt(declarationNode) != JsonKind.Object)
            {
                return false;
            }

            stack mut bool hasManifestKind = false;
            if (!LogicalPackageImageJsonAppendTypedDeclarationHeaderText(
                document,
                declarationNode,
                declarationKind,
                name,
                qualifiedName,
                visibility,
                manifestKind,
                hasManifestKind))
            {
                return false;
            }

            stack mut u32[0 max] genericParameterCount = 0;
            stack mut u32[0 max] comptimeGenericParameterCount = 0;
            stack mut u32[0 max] parameterCount = 0;
            stack mut u32[0 max] fieldCount = 0;
            stack mut u32[0 max] variantCount = 0;
            stack mut u32[0 max] methodCount = 0;
            stack mut u32[0 max] constructorCount = 0;
            stack mut u32[0 max] associatedTypeCount = 0;
            stack mut u32[0 max] implementedTraitCount = 0;
            stack mut u32[0 max] threadSafetyLawAttributeCount = 0;
            stack mut u32[0 max] threadSafetyLawPredicateCount = 0;
            stack mut u32[0 max] typeParameterConstraintCount = 0;
            stack mut u32[0 max] valueContractCount = 0;
            stack mut bool hasBackendOptimizationMode = false;
            stack mut bool hasStructLayout = false;
            stack mut bool hasPackBytes = false;
            stack mut bool hasAlignBytes = false;
            stack mut bool isDynTrait = false;
            stack mut bool isMutableGlobal = false;
            stack mut bool hasConstantInitializer = false;
            stack mut bool isFfiFunction = false;
            stack mut bool isStrictFpFunction = false;
            stack mut bool usesFastCallingConvention = false;
            stack mut bool hasGenericTemplateBody = false;
            switch (declarationKind)
            {
                case LogicalPackageTypedDeclarationKind.TypeAlias:
                    if (!LogicalPackageImageJsonTypedDeclarationTypeAliasFacts(
                        document,
                        declarationNode,
                        genericParameterCount,
                        comptimeGenericParameterCount))
                    {
                        return false;
                    }
                case LogicalPackageTypedDeclarationKind.Type:
                    if (!LogicalPackageImageJsonTypedDeclarationTypeFacts(
                        document,
                        declarationNode,
                        genericParameterCount,
                        comptimeGenericParameterCount,
                        fieldCount,
                        variantCount,
                        methodCount,
                        constructorCount,
                        associatedTypeCount,
                        implementedTraitCount,
                        threadSafetyLawAttributeCount,
                        hasBackendOptimizationMode,
                        hasStructLayout,
                        hasPackBytes,
                        hasAlignBytes,
                        isDynTrait))
                    {
                        return false;
                    }
                case LogicalPackageTypedDeclarationKind.Function:
                    if (!LogicalPackageImageJsonTypedDeclarationFunctionFacts(
                        document,
                        declarationNode,
                        genericParameterCount,
                        comptimeGenericParameterCount,
                        parameterCount,
                        threadSafetyLawPredicateCount,
                        typeParameterConstraintCount,
                        valueContractCount,
                        hasBackendOptimizationMode,
                        isFfiFunction,
                        isStrictFpFunction,
                        usesFastCallingConvention,
                        hasGenericTemplateBody))
                    {
                        return false;
                    }
                case LogicalPackageTypedDeclarationKind.Global:
                    if (!LogicalPackageImageJsonTypedDeclarationGlobalFacts(
                        document,
                        declarationNode,
                        isMutableGlobal,
                        hasConstantInitializer))
                    {
                        return false;
                    }
            }

            declaration = new LogicalPackageTypedDeclarationSummary()
            {
                ModuleOrdinalValue = moduleOrdinal,
                DeclarationOrdinalValue = declarationOrdinal,
                DeclarationKindValue = declarationKind,
                GenericParameterCountValue = genericParameterCount,
                ComptimeGenericParameterCountValue = comptimeGenericParameterCount,
                ParameterCountValue = parameterCount,
                FieldCountValue = fieldCount,
                VariantCountValue = variantCount,
                MethodCountValue = methodCount,
                ConstructorCountValue = constructorCount,
                AssociatedTypeCountValue = associatedTypeCount,
                ImplementedTraitCountValue = implementedTraitCount,
                ThreadSafetyLawAttributeCountValue = threadSafetyLawAttributeCount,
                ThreadSafetyLawPredicateCountValue = threadSafetyLawPredicateCount,
                TypeParameterConstraintCountValue = typeParameterConstraintCount,
                ValueContractCountValue = valueContractCount,
                HasManifestKindValue = hasManifestKind,
                HasBackendOptimizationModeValue = hasBackendOptimizationMode,
                HasStructLayoutValue = hasStructLayout,
                HasPackBytesValue = hasPackBytes,
                HasAlignBytesValue = hasAlignBytes,
                IsDynTraitValue = isDynTrait,
                IsMutableGlobalValue = isMutableGlobal,
                HasConstantInitializerValue = hasConstantInitializer,
                IsFfiFunctionValue = isFfiFunction,
                IsStrictFpFunctionValue = isStrictFpFunction,
                UsesFastCallingConventionValue = usesFastCallingConvention,
                HasGenericTemplateBodyValue = hasGenericTemplateBody
            };
            return true;
    }
}

public unsafe fn bool TryReadLogicalPackageTypedCallableJsonSummary(
    ascii manifestJson,
    u32[0 max] moduleOrdinal,
    LogicalPackageTypedCallableKind callableKind,
    u32[0 max] declarationOrdinal,
    u32[0 max] methodOrdinal,
    out LogicalPackageTypedCallableSummary callable,
    mut borrow OwnedAscii name,
    mut borrow OwnedAscii qualifiedName,
    mut borrow OwnedAscii visibility,
    mut borrow OwnedAscii symbolName,
    mut borrow OwnedAscii manifestKind,
    mut borrow OwnedAscii qualifiedResolvedName,
    mut borrow OwnedAscii publishedOverloadKey,
    mut borrow OwnedAscii inlinePreference,
    mut borrow OwnedAscii ffiAbi,
    mut borrow OwnedAscii backendOptimizationMode,
    mut borrow OwnedAscii linkName)
{
    callable = new();
    switch (ParseText(manifestJson))
    {
        case JsonResult<JsonDocument>.Err(var parseError):
            return false;
        case JsonResult<JsonDocument>.Ok(var parsed):
            stack mut JsonDocument document = parsed;
            stack mut u64[0 2 ** 63 - 1] moduleNode = 0;
            stack mut u64[0 2 ** 63 - 1] typedInterfaceNode = 0;
            stack mut u64[0 2 ** 63 - 1] callableNode = 0;
            stack mut bool usesCompilerSections = false;
            if (!LogicalPackageImageJsonModuleNode(document, moduleOrdinal, moduleNode)
                || !LogicalPackageImageJsonEffectiveTypedInterfaceNode(document, moduleNode, typedInterfaceNode, usesCompilerSections)
                || !LogicalPackageImageJsonTypedCallableNode(
                    document,
                    typedInterfaceNode,
                    callableKind,
                    declarationOrdinal,
                    methodOrdinal,
                    callableNode))
            {
                return false;
            }

            stack mut bool hasVisibility = false;
            stack mut bool hasQualifiedResolvedName = false;
            stack mut bool hasPublishedOverloadKey = false;
            stack mut bool hasInlinePreference = false;
            stack mut bool hasFfiAbi = false;
            stack mut bool hasBackendOptimizationMode = false;
            stack mut bool hasLinkName = false;
            if (!LogicalPackageImageJsonAppendTypedCallableText(
                document,
                callableNode,
