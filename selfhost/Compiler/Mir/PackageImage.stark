        ParentInitializerRowValue = parentInitializerRow,
        ParentChildOrdinalValue = parentChildOrdinal
    };
    return work.Add(item) != 0;
}

internal fn bool LogicalPackageImageJsonMaterializeTypeReferenceTextMemberRow(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    bool required,
    LogicalPackageTypeReferenceTextKind textKind,
    u32[0 max] textOrdinal,
    u32[0 max] typeReferenceRow,
    mut borrow LogicalPackageTypeReferenceGraph graph,
    out bool present,
    out u32[0 max] textRow)
{
    present = false;
    textRow = 0;
    stack mut u64[0 2 ** 63 - 1] member = 0;
    if (!document.TryFindMember(objectNode, memberName, member)
        || document.KindAt(member) == JsonKind.Null)
    {
        return !required;
    }

    if (document.KindAt(member) != JsonKind.Text)
    {
        return false;
    }

    stack ascii value = document.TextAt(member);
    if (System.Text.AsciiLength(value) <= 0)
    {
        return false;
    }

    if (!LogicalPackageTypeReferenceGraphAddTextRowWithId(
        graph,
        typeReferenceRow,
        textKind,
        textOrdinal,
        value,
        textRow))
    {
        return false;
    }

    present = true;
    return true;
}

internal fn bool LogicalPackageImageJsonMaterializeTypeReferenceTextMember(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    bool required,
    LogicalPackageTypeReferenceTextKind textKind,
    u32[0 max] textOrdinal,
    u32[0 max] typeReferenceRow,
    mut borrow LogicalPackageTypeReferenceGraph graph,
    out bool present)
{
    stack mut u32[0 max] textRow = 0;
    return LogicalPackageImageJsonMaterializeTypeReferenceTextMemberRow(
        document,
        objectNode,
        memberName,
        required,
        textKind,
        textOrdinal,
        typeReferenceRow,
        graph,
        present,
        textRow);
}

internal fn bool LogicalPackageImageJsonMaterializeOptionalTypeReferenceTextArray(
    mut borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageTypeReferenceTextKind textKind,
    bool allowNullItems,
    u32[0 max] typeReferenceRow,
    mut borrow LogicalPackageTypeReferenceGraph graph,
    out u32[0 max] itemCount)
{
    itemCount = 0;
    stack mut u64[0 2 ** 63 - 1] arrayNode = 0;
    if (!LogicalPackageImageJsonOptionalArrayMember(document, objectNode, memberName, arrayNode, itemCount))
    {
        return false;
    }

    stack mut u32[0 max] index = 0;
    while willexit (index < itemCount)
    {
        stack mut u64[0 2 ** 63 - 1] itemNode = 0;
        if (!document.TryChildAt(arrayNode, (u64[0 2 ** 63 - 1])index, itemNode))
        {
            return false;
        }

        stack JsonKind kind = document.KindAt(itemNode);
        if (kind == JsonKind.Null && allowNullItems)
        {
            index = index + 1;
            continue;
        }

        if (kind != JsonKind.Text)
        {
            return false;
        }

        stack ascii value = document.TextAt(itemNode);
        if (System.Text.AsciiLength(value) <= 0
            || !LogicalPackageTypeReferenceGraphAddTextRow(graph, typeReferenceRow, textKind, index, value))
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool LogicalPackageImageJsonEnqueueOptionalTypeReferenceObjectChild(
    borrow JsonDocument document,
    u64[0 2 ** 63 - 1] objectNode,
    ascii memberName,
    LogicalPackageTypeReferenceChildKind childKind,
    u32[0 max] parentTypeReferenceRow,
    mut borrow IrTable<LogicalPackageTypeReferenceWorkItem> work,
    out bool present)
{
    present = false;
    stack mut u64[0 2 ** 63 - 1] childNode = 0;
    if (!LogicalPackageImageJsonOptionalObjectMember(document, objectNode, memberName, childNode, present))
    {
        return false;
    }

    if (!present)
    {
        return true;
    }

    return LogicalPackageTypeReferenceWorkListAdd(work, childNode, parentTypeReferenceRow, childKind, 0);
}

