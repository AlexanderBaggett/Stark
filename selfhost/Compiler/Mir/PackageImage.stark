    public fn bool AddCompilerFactAbiFunction(
        mut borrow LogicalPackageManifestJsonBuilder self,
        u32[0 max] moduleOrdinal,
        ascii qualifiedResolvedName,
        ascii symbolName,
        ascii sourceReturnTypeKind,
        ascii llvmReturnTypeKind,
        bool isFfi,
        out u32[0 max] abiFunctionRow)
    {
        abiFunctionRow = 0;
        stack u32[0 max] moduleRow = moduleOrdinal + 1;
        if (!self.ModuleNameStringIndexes.Contains(moduleRow))
        {
            return false;
        }

        stack u32[0 max] count = self.CompilerFactAbiFunctionCounts.Get(moduleRow);
        if (count == (u32[0 max])(2 ** 32 - 1))
        {
            return false;
        }

        stack mut u32[0 max] qualifiedResolvedNameStringIndex = PackageImageNullStringIndex();
        stack mut u32[0 max] symbolNameStringIndex = PackageImageNullStringIndex();
        stack mut LogicalPackageManifestJsonTypeReferenceDescriptor sourceReturnType = new();
        stack mut LogicalPackageManifestJsonTypeReferenceDescriptor llvmReturnType = new();
        if (!LogicalPackageImageStringTableBuilderTryAdd(
                self.Strings,
                qualifiedResolvedName,
                qualifiedResolvedNameStringIndex)
            || !LogicalPackageImageStringTableBuilderTryAdd(
                self.Strings,
                symbolName,
                symbolNameStringIndex)
            || !LogicalPackageManifestJsonBuildTypeReferenceDescriptor(
                self.Strings,
                sourceReturnTypeKind,
                sourceReturnType)
            || !LogicalPackageManifestJsonBuildTypeReferenceDescriptor(
                self.Strings,
                llvmReturnTypeKind,
                llvmReturnType))
        {
            return false;
        }

        stack LogicalPackageManifestJsonCompilerFactAbiFunctionRow row =
            new LogicalPackageManifestJsonCompilerFactAbiFunctionRow()
            {
                QualifiedResolvedNameStringIndex = qualifiedResolvedNameStringIndex,
                SymbolNameStringIndex = symbolNameStringIndex,
                SourceReturnType = sourceReturnType,
                LlvmReturnType = llvmReturnType,
                IsFfi = isFfi
            };
        stack u32[0 max] rowIndex = self.CompilerFactAbiFunctionRows.Add(row);
        if (rowIndex == 0)
        {
            return false;
        }

        if (count == 0)
        {
            if (!self.CompilerFactAbiFunctionFirstRows.Replace(moduleRow, rowIndex))
            {
                return false;
            }
        }
        else
        {
            stack u32[0 max] lastRowIndex = self.CompilerFactAbiFunctionLastRows.Get(moduleRow);
            if (lastRowIndex == 0)
            {
                return false;
            }

            stack mut LogicalPackageManifestJsonCompilerFactAbiFunctionRow lastRow =
                self.CompilerFactAbiFunctionRows.Get(lastRowIndex);
            lastRow.NextRow = rowIndex;
            if (!self.CompilerFactAbiFunctionRows.Replace(lastRowIndex, lastRow))
            {
                return false;
            }
        }

        if (!self.CompilerFactAbiFunctionLastRows.Replace(moduleRow, rowIndex)
            || !self.CompilerFactAbiFunctionCounts.Replace(moduleRow, count + 1))
        {
            return false;
        }

        abiFunctionRow = rowIndex;
        return true;
    }

