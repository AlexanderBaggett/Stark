        {
            return false;
        }

        stack LogicalPackageTypeReferenceChildRow child = graph.ChildRows.Get(childRowIndex);
        if (child.ChildKindValue == childKind
            && child.ChildOrdinalValue == childOrdinal)
        {
            stack u32[0 max] foundChildRow = child.ChildTypeReferenceRowValue;
            if (!graph.TypeReferenceRows.Contains(foundChildRow))
            {
                return false;
            }

            childTypeReferenceRow = foundChildRow;
            return true;
        }

        offset = offset + 1;
    }

    return false;
}

