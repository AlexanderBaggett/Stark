public fn bool DeserializePackageImageEnumLayoutFacts(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirEnumLayoutFact> outFacts)
{
    if (!HasStarkPackageImageMagic(buf))
    {
        return false;
    }

    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    stack mut u32[0 max] asmOffset = 0;
    stack mut u32[0 max] asmFunctionCount = 0;
    stack mut bool hasAsm = false;
    stack mut u32[0 max] enumLayoutOffset = 0;
    stack mut u32[0 max] enumLayoutFactCount = 0;
    stack mut bool hasEnumLayoutFacts = false;
    stack mut u32[0 max] textPayloadOffset = 0;
    stack mut u32[0 max] textPayloadByteCount = 0;
    stack mut bool hasTextPayloadBytes = false;
    stack mut u32[0 max] textConstantOffset = 0;
    stack mut u32[0 max] textConstantCount = 0;
    stack mut bool hasTextConstants = false;
    stack mut u32[0 max] floatPayloadOffset = 0;
    stack mut u32[0 max] floatPayloadByteCount = 0;
    stack mut bool hasFloatPayloadBytes = false;
    stack mut u32[0 max] floatConstantOffset = 0;
    stack mut u32[0 max] floatConstantCount = 0;
    stack mut bool hasFloatConstants = false;
    if (ReadSectionedPackageImageDirectoryWithEnumLayoutFacts(
        buf,
        instrOffset,
        blockOffset,
        funcOffset,
        globalOffset,
        asmOffset,
        asmFunctionCount,
        hasAsm,
        enumLayoutOffset,
        enumLayoutFactCount,
        hasEnumLayoutFacts,
        textPayloadOffset,
        textPayloadByteCount,
        hasTextPayloadBytes,
        textConstantOffset,
        textConstantCount,
        hasTextConstants,
        floatPayloadOffset,
        floatPayloadByteCount,
        hasFloatPayloadBytes,
        floatConstantOffset,
        floatConstantCount,
        hasFloatConstants) != PackageImageValidationStatus.Ok
        || !hasEnumLayoutFacts)
    {
        return false;
    }

    return DeserializeEnumLayoutFactsAt(buf, enumLayoutOffset, outFacts);
}

public fn bool DeserializePackageImageTextConstants(
    borrow IrTable<u8[0 max]> buf,
    mut borrow IrTable<u8[0 max]> outTextPayloadBytes,
    mut borrow IrTable<MirTextConstant> outTextConstants)
{
    if (!HasStarkPackageImageMagic(buf))
    {
        return false;
    }

    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    stack mut u32[0 max] asmOffset = 0;
    stack mut u32[0 max] asmFunctionCount = 0;
    stack mut bool hasAsm = false;
    stack mut u32[0 max] enumLayoutOffset = 0;
    stack mut u32[0 max] enumLayoutFactCount = 0;
    stack mut bool hasEnumLayoutFacts = false;
    stack mut u32[0 max] textPayloadOffset = 0;
    stack mut u32[0 max] textPayloadByteCount = 0;
    stack mut bool hasTextPayloadBytes = false;
    stack mut u32[0 max] textConstantOffset = 0;
    stack mut u32[0 max] textConstantCount = 0;
    stack mut bool hasTextConstants = false;
    stack mut u32[0 max] floatPayloadOffset = 0;
    stack mut u32[0 max] floatPayloadByteCount = 0;
    stack mut bool hasFloatPayloadBytes = false;
    stack mut u32[0 max] floatConstantOffset = 0;
    stack mut u32[0 max] floatConstantCount = 0;
    stack mut bool hasFloatConstants = false;
    if (ReadSectionedPackageImageDirectoryWithEnumLayoutFacts(
        buf,
        instrOffset,
        blockOffset,
        funcOffset,
        globalOffset,
        asmOffset,
        asmFunctionCount,
        hasAsm,
        enumLayoutOffset,
        enumLayoutFactCount,
        hasEnumLayoutFacts,
        textPayloadOffset,
        textPayloadByteCount,
        hasTextPayloadBytes,
        textConstantOffset,
        textConstantCount,
        hasTextConstants,
        floatPayloadOffset,
        floatPayloadByteCount,
        hasFloatPayloadBytes,
        floatConstantOffset,
        floatConstantCount,
        hasFloatConstants) != PackageImageValidationStatus.Ok
        || !hasTextPayloadBytes
        || !hasTextConstants)
    {
        return false;
    }

    if (!DeserializeTextPayloadBytesAt(buf, textPayloadOffset, outTextPayloadBytes))
    {
        return false;
    }

    return DeserializeTextConstantsAt(buf, textConstantOffset, outTextPayloadBytes, outTextConstants);
}

public fn bool DeserializePackageImageWithTextConstants(
    borrow IrTable<u8[0 max]> buf,
    mut borrow IrTable<MirInstruction> outInstrs,
    mut borrow IrTable<MirBlock> outBlocks,
    mut borrow IrTable<MirFunction> outFuncs,
    mut borrow IrTable<MirGlobal> outGlobals,
    mut borrow IrTable<u8[0 max]> outTextPayloadBytes,
    mut borrow IrTable<MirTextConstant> outTextConstants)
{
    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    stack mut u32[0 max] asmOffset = 0;
    stack mut u32[0 max] asmFunctionCount = 0;
    stack mut bool hasAsm = false;
    stack mut u32[0 max] enumLayoutOffset = 0;
    stack mut u32[0 max] enumLayoutFactCount = 0;
    stack mut bool hasEnumLayoutFacts = false;
    stack mut u32[0 max] textPayloadOffset = 0;
    stack mut u32[0 max] textPayloadByteCount = 0;
    stack mut bool hasTextPayloadBytes = false;
    stack mut u32[0 max] textConstantOffset = 0;
    stack mut u32[0 max] textConstantCount = 0;
    stack mut bool hasTextConstants = false;
    stack mut u32[0 max] floatPayloadOffset = 0;
    stack mut u32[0 max] floatPayloadByteCount = 0;
    stack mut bool hasFloatPayloadBytes = false;
    stack mut u32[0 max] floatConstantOffset = 0;
    stack mut u32[0 max] floatConstantCount = 0;
    stack mut bool hasFloatConstants = false;
    if (!HasStarkPackageImageMagic(buf)
        || ReadSectionedPackageImageDirectoryWithEnumLayoutFacts(
            buf,
            instrOffset,
            blockOffset,
            funcOffset,
            globalOffset,
            asmOffset,
            asmFunctionCount,
            hasAsm,
            enumLayoutOffset,
            enumLayoutFactCount,
            hasEnumLayoutFacts,
            textPayloadOffset,
            textPayloadByteCount,
            hasTextPayloadBytes,
            textConstantOffset,
            textConstantCount,
            hasTextConstants,
            floatPayloadOffset,
            floatPayloadByteCount,
            hasFloatPayloadBytes,
            floatConstantOffset,
            floatConstantCount,
            hasFloatConstants) != PackageImageValidationStatus.Ok
        || hasAsm
        || !hasTextPayloadBytes
        || !hasTextConstants)
    {
        return false;
    }

    DeserializeInstructionsAt(buf, instrOffset, outInstrs);
    DeserializeBlocksAt(buf, blockOffset, outBlocks);
    DeserializeFunctionsAt(buf, funcOffset, outFuncs);
    DeserializeGlobalsAt(buf, globalOffset, outGlobals);
    if (!DeserializeTextPayloadBytesAt(buf, textPayloadOffset, outTextPayloadBytes))
    {
        return false;
    }

    return DeserializeTextConstantsAt(buf, textConstantOffset, outTextPayloadBytes, outTextConstants);
}

public fn bool DeserializePackageImageFloatConstants(
    borrow IrTable<u8[0 max]> buf,
    mut borrow IrTable<u8[0 max]> outFloatPayloadBytes,
    mut borrow IrTable<MirFloatConstant> outFloatConstants)
{
    if (!HasStarkPackageImageMagic(buf))
    {
        return false;
    }

    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    stack mut u32[0 max] asmOffset = 0;
    stack mut u32[0 max] asmFunctionCount = 0;
    stack mut bool hasAsm = false;
    stack mut u32[0 max] enumLayoutOffset = 0;
    stack mut u32[0 max] enumLayoutFactCount = 0;
    stack mut bool hasEnumLayoutFacts = false;
    stack mut u32[0 max] textPayloadOffset = 0;
    stack mut u32[0 max] textPayloadByteCount = 0;
    stack mut bool hasTextPayloadBytes = false;
    stack mut u32[0 max] textConstantOffset = 0;
    stack mut u32[0 max] textConstantCount = 0;
    stack mut bool hasTextConstants = false;
    stack mut u32[0 max] floatPayloadOffset = 0;
    stack mut u32[0 max] floatPayloadByteCount = 0;
    stack mut bool hasFloatPayloadBytes = false;
    stack mut u32[0 max] floatConstantOffset = 0;
    stack mut u32[0 max] floatConstantCount = 0;
    stack mut bool hasFloatConstants = false;
    if (ReadSectionedPackageImageDirectoryWithEnumLayoutFacts(
        buf,
        instrOffset,
        blockOffset,
        funcOffset,
        globalOffset,
        asmOffset,
        asmFunctionCount,
        hasAsm,
        enumLayoutOffset,
        enumLayoutFactCount,
        hasEnumLayoutFacts,
        textPayloadOffset,
        textPayloadByteCount,
        hasTextPayloadBytes,
        textConstantOffset,
        textConstantCount,
        hasTextConstants,
        floatPayloadOffset,
        floatPayloadByteCount,
        hasFloatPayloadBytes,
        floatConstantOffset,
        floatConstantCount,
        hasFloatConstants) != PackageImageValidationStatus.Ok
        || !hasFloatPayloadBytes
        || !hasFloatConstants)
    {
        return false;
    }

    if (!DeserializeFloatLiteralPayloadBytesAt(buf, floatPayloadOffset, outFloatPayloadBytes))
    {
        return false;
    }

    return DeserializeFloatConstantsAt(buf, floatConstantOffset, outFloatPayloadBytes, outFloatConstants);
}

public fn bool DeserializePackageImageWithFloatConstants(
    borrow IrTable<u8[0 max]> buf,
    mut borrow IrTable<MirInstruction> outInstrs,
    mut borrow IrTable<MirBlock> outBlocks,
    mut borrow IrTable<MirFunction> outFuncs,
    mut borrow IrTable<MirGlobal> outGlobals,
    mut borrow IrTable<u8[0 max]> outFloatPayloadBytes,
    mut borrow IrTable<MirFloatConstant> outFloatConstants)
{
    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    stack mut u32[0 max] asmOffset = 0;
    stack mut u32[0 max] asmFunctionCount = 0;
    stack mut bool hasAsm = false;
    stack mut u32[0 max] enumLayoutOffset = 0;
    stack mut u32[0 max] enumLayoutFactCount = 0;
    stack mut bool hasEnumLayoutFacts = false;
    stack mut u32[0 max] textPayloadOffset = 0;
    stack mut u32[0 max] textPayloadByteCount = 0;
    stack mut bool hasTextPayloadBytes = false;
    stack mut u32[0 max] textConstantOffset = 0;
    stack mut u32[0 max] textConstantCount = 0;
    stack mut bool hasTextConstants = false;
    stack mut u32[0 max] floatPayloadOffset = 0;
    stack mut u32[0 max] floatPayloadByteCount = 0;
    stack mut bool hasFloatPayloadBytes = false;
    stack mut u32[0 max] floatConstantOffset = 0;
    stack mut u32[0 max] floatConstantCount = 0;
    stack mut bool hasFloatConstants = false;
    if (!HasStarkPackageImageMagic(buf)
        || ReadSectionedPackageImageDirectoryWithEnumLayoutFacts(
            buf,
            instrOffset,
            blockOffset,
            funcOffset,
            globalOffset,
            asmOffset,
            asmFunctionCount,
            hasAsm,
            enumLayoutOffset,
            enumLayoutFactCount,
            hasEnumLayoutFacts,
            textPayloadOffset,
            textPayloadByteCount,
            hasTextPayloadBytes,
            textConstantOffset,
            textConstantCount,
            hasTextConstants,
            floatPayloadOffset,
            floatPayloadByteCount,
            hasFloatPayloadBytes,
            floatConstantOffset,
            floatConstantCount,
            hasFloatConstants) != PackageImageValidationStatus.Ok
        || hasAsm
        || !hasFloatPayloadBytes
        || !hasFloatConstants)
    {
        return false;
    }

    DeserializeInstructionsAt(buf, instrOffset, outInstrs);
    DeserializeBlocksAt(buf, blockOffset, outBlocks);
    DeserializeFunctionsAt(buf, funcOffset, outFuncs);
    DeserializeGlobalsAt(buf, globalOffset, outGlobals);
    if (!DeserializeFloatLiteralPayloadBytesAt(buf, floatPayloadOffset, outFloatPayloadBytes))
    {
        return false;
    }

    return DeserializeFloatConstantsAt(buf, floatConstantOffset, outFloatPayloadBytes, outFloatConstants);
}

// Reads a package image into the four out-tables. Returns false (touching nothing)
// when the magic or section directory is malformed.
public fn bool DeserializePackageImage(borrow IrTable<u8[0 max]> buf, mut borrow IrTable<MirInstruction> outInstrs, mut borrow IrTable<MirBlock> outBlocks, mut borrow IrTable<MirFunction> outFuncs, mut borrow IrTable<MirGlobal> outGlobals)
{
    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    if (HasStarkPackageImageMagic(buf))
    {
        stack mut u32[0 max] asmOffset = 0;
        stack mut u32[0 max] asmFunctionCount = 0;
        stack mut bool hasAsm = false;
        if (ReadSectionedPackageImageDirectory(buf, instrOffset, blockOffset, funcOffset, globalOffset, asmOffset, asmFunctionCount, hasAsm) != PackageImageValidationStatus.Ok
            || hasAsm)
        {
            return false;
        }

        DeserializeInstructionsAt(buf, instrOffset, outInstrs);
        DeserializeBlocksAt(buf, blockOffset, outBlocks);
        DeserializeFunctionsAt(buf, funcOffset, outFuncs);
        DeserializeGlobalsAt(buf, globalOffset, outGlobals);
        return true;
    }

    if (!TryReadMirImageHeader(buf, instrOffset, blockOffset, funcOffset, globalOffset))
    {
        return false;
    }

    DeserializeInstructionsAt(buf, instrOffset, outInstrs);
    DeserializeBlocksAt(buf, blockOffset, outBlocks);
    DeserializeFunctionsAt(buf, funcOffset, outFuncs);
    DeserializeGlobalsAt(buf, globalOffset, outGlobals);
    return true;
}

public fn bool DeserializePackageImageWithAsm(
    borrow IrTable<u8[0 max]> buf,
    mut borrow IrTable<MirInstruction> outInstrs,
    mut borrow IrTable<MirBlock> outBlocks,
    mut borrow IrTable<MirFunction> outFuncs,
    mut borrow IrTable<MirGlobal> outGlobals,
    mut borrow AsmMetadataTable outAsmMetadata)
{
    stack mut u32[0 max] instrOffset = 0;
    stack mut u32[0 max] blockOffset = 0;
    stack mut u32[0 max] funcOffset = 0;
    stack mut u32[0 max] globalOffset = 0;
    stack mut u32[0 max] asmOffset = 0;
    stack mut u32[0 max] asmFunctionCount = 0;
    if (HasStarkPackageImageMagic(buf))
    {
        stack mut bool hasAsm = false;
        if (ReadSectionedPackageImageDirectory(buf, instrOffset, blockOffset, funcOffset, globalOffset, asmOffset, asmFunctionCount, hasAsm) != PackageImageValidationStatus.Ok
            || !hasAsm)
        {
            return false;
        }

        DeserializeInstructionsAt(buf, instrOffset, outInstrs);
        DeserializeBlocksAt(buf, blockOffset, outBlocks);
        DeserializeFunctionsAt(buf, funcOffset, outFuncs);
        DeserializeGlobalsAt(buf, globalOffset, outGlobals);
        return DeserializeAsmMetadataAtUnchecked(buf, asmOffset, outAsmMetadata);
    }

    if (!TryReadMirImageWithAsmHeader(buf, instrOffset, blockOffset, funcOffset, globalOffset, asmOffset, asmFunctionCount))
    {
        return false;
    }

    DeserializeInstructionsAt(buf, instrOffset, outInstrs);
    DeserializeBlocksAt(buf, blockOffset, outBlocks);
    DeserializeFunctionsAt(buf, funcOffset, outFuncs);
    DeserializeGlobalsAt(buf, globalOffset, outGlobals);
    return DeserializeAsmMetadataAtUnchecked(buf, asmOffset, outAsmMetadata);
}

// Emits an `inspect-pkg` one-line summary of a package image, reading only the header
// and each section's count (no IR materialized). Empty when the magic is wrong.
public fn MemoryStatus InspectPackageImage(borrow IrTable<u8[0 max]> buf, mut borrow OwnedAscii sink)
{
    stack mut PackageImageSummary summary = new();
    if (!TryReadPackageImageSummary(buf, summary))
    {
        return MemoryStatus.Ok;
    }

    if (summary.IsLogical)
    {
        return AppendLogicalPackageImageSummaryText(buf, summary, sink);
    }

    return AppendPackageImageSummaryText(summary, sink);
}

// Emits a deterministic JSON summary view of the same validated binary image counts
// used by the text inspector. Empty when the image is not recognized or malformed.
public fn MemoryStatus InspectPackageImageJson(borrow IrTable<u8[0 max]> buf, mut borrow OwnedAscii sink)
{
    stack mut PackageImageSummary summary = new();
    if (!TryReadPackageImageSummary(buf, summary))
    {
        return MemoryStatus.Ok;
    }

    if (summary.IsLogical)
    {
        return AppendLogicalPackageImageSummaryJson(buf, summary, sink);
    }

    return AppendPackageImageSummaryJson(summary, sink);
}

// === Bridge to the stdlib byte buffer (toward on-disk package images, #32) ===
// `System.IO.File.WriteAllBytes`/`ReadAllBytes` consume/produce a
// `System.Runtime.Buffer.DynamicByteBuffer`, so a package image (an `IrTable<u8>`)
// converts to/from that type. Bytes are u8 here and i8 in the buffer; the modular
// cast preserves the bit pattern. With these, persisting an image is a thin wrapper:
// `SerializePackageImage` -> `ImageToByteBuffer` -> `File.WriteAllBytes`, and the
// reverse for loading.

// Copies every byte of the image `src` into the byte buffer `dst`.
public fn bool ImageToByteBuffer(borrow IrTable<u8[0 max]> src, mut borrow DynamicByteBuffer dst)
{
    stack u64[0 2 ** 63 - 1] count = src.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack u8[0 max] b = src.Get(i);
        stack System.Memory.MemoryStatus ws = dst.WriteByte((i8[min max])b);
        if (ws != System.Memory.MemoryStatus.Ok)
        {
            return false;
        }

        i = i + 1;
    }

    return true;
}

// Copies the readable bytes of `src` into the image `dst`.
public fn bool ImageFromByteBuffer(borrow DynamicByteBuffer src, mut borrow IrTable<u8[0 max]> dst)
{
    stack i8[min max][] bytes = src.ReadSlice();
    stack u64[0 2 ** 63 - 1] len = src.Readable();
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < len)
    {
        stack i8[min max] sb = bytes[i];
        stack u32[0 max] w = dst.Add((u8[0 max])sb);
        if (w == 0)
        {
            return false;
        }

        i = i + 1;
    }

    return true;
}

// === On-disk package image (#32, end-to-end file round-trip) ===
// Serializes a module to a package image, writes it to a temp file via System.IO.File,
// reads it back, and deserializes — exercising the full on-disk path. All filesystem +
// dynamic-buffer work stays in this module (a [Fact] only builds inputs + checks the
// bool). Switch arms are all non-empty (the empty `case Ok:` arm crashes host lower-mir
// for cross-package stdlib-enum switches).

internal fn bool WriteImageFile(ascii path, borrow DynamicByteBuffer dbuf)
{
    switch (System.IO.File.WriteAllBytes(path, dbuf))
    {
        case System.IO.IOStatus.Ok:
            return true;
        case System.IO.IOStatus.Err(var writeError):
            return false;
    }
}

internal fn bool ReadImageFile(ascii path, mut borrow IrTable<u8[0 max]> outBuf)
{
    switch (System.IO.File.ReadAllBytes(path))
    {
        case System.IO.IOResult<DynamicByteBuffer>.Ok(var contents):
            return ImageFromByteBuffer(contents, outBuf);
        case System.IO.IOResult<DynamicByteBuffer>.Err(var readError):
            return false;
    }
}

public fn bool WritePackageImageBufferFile(ascii path, borrow IrTable<u8[0 max]> image)
{
    stack mut DynamicByteBuffer dbuf = new();
    if (!ImageToByteBuffer(image, dbuf))
    {
        return false;
    }

    return WriteImageFile(path, dbuf);
}

public fn bool ReadPackageImageBufferFile(ascii path, mut borrow IrTable<u8[0 max]> outImage)
{
    return ReadImageFile(path, outImage);
}

public fn bool WritePackageImageFile(
    ascii path,
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals)
{
    stack mut IrTable<u8[0 max]> image = new();
    SerializePackageImage(instrs, blocks, funcs, globals, image);
    return WritePackageImageBufferFile(path, image);
}

public fn bool WritePackageImageWithAsmFile(
    ascii path,
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirFunction> funcs,
    borrow IrTable<MirGlobal> globals,
    borrow AsmMetadataTable asmMetadata)
{
    stack mut IrTable<u8[0 max]> image = new();
    SerializePackageImageWithAsm(instrs, blocks, funcs, globals, asmMetadata, image);
    return WritePackageImageBufferFile(path, image);
}

public fn bool LoadPackageImageFile(
    ascii path,
    mut borrow IrTable<MirInstruction> outInstrs,
    mut borrow IrTable<MirBlock> outBlocks,
    mut borrow IrTable<MirFunction> outFuncs,
    mut borrow IrTable<MirGlobal> outGlobals)
{
    stack mut IrTable<u8[0 max]> image = new();
    if (!ReadPackageImageBufferFile(path, image))
    {
        return false;
    }

    return DeserializePackageImage(image, outInstrs, outBlocks, outFuncs, outGlobals);
}

public fn bool LoadPackageImageWithAsmFile(
    ascii path,
    mut borrow IrTable<MirInstruction> outInstrs,
    mut borrow IrTable<MirBlock> outBlocks,
    mut borrow IrTable<MirFunction> outFuncs,
    mut borrow IrTable<MirGlobal> outGlobals,
    mut borrow AsmMetadataTable outAsmMetadata)
{
    stack mut IrTable<u8[0 max]> image = new();
    if (!ReadPackageImageBufferFile(path, image))
    {
        return false;
    }

    return DeserializePackageImageWithAsm(image, outInstrs, outBlocks, outFuncs, outGlobals, outAsmMetadata);
}

public fn bool InspectPackageImageFile(ascii path, mut borrow OwnedAscii sink)
{
    return RenderPackageImageInspectionFile(path, PackageImageInspectionFormat.Text, sink);
}

public fn bool InspectPackageImageFileJson(ascii path, mut borrow OwnedAscii sink)
{
    return RenderPackageImageInspectionFile(path, PackageImageInspectionFormat.Json, sink);
}

public fn bool RenderPackageImageInspectionFile(ascii path, PackageImageInspectionFormat format, mut borrow OwnedAscii sink)
{
    stack mut IrTable<u8[0 max]> image = new();
    if (!ReadImageFile(path, image))
    {
        return false;
    }

    return RenderPackageImageInspection(image, format, sink);
}
