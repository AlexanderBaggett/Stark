    }

    hasIsUnsigned = LogicalPackageImageJsonMemberHasValue(document, typeReferenceNode, "IsUnsigned");
    if (!LogicalPackageImageJsonOptionalBoolMemberValue(document, typeReferenceNode, "IsUnsigned", isUnsigned)
        || !LogicalPackageImageJsonOptionalBoolMemberValue(document, typeReferenceNode, "IsMutablePointer", isMutablePointer)
        || !LogicalPackageImageJsonMaterializeTypeReferenceTextMember(
            document,
            typeReferenceNode,
            "BorrowKind",
            false,
            LogicalPackageTypeReferenceTextKind.BorrowKind,
            0,
            typeReferenceRow,
            graph,
            hasBorrowKind)
        || !LogicalPackageImageJsonMaterializeTypeReferenceTextMember(
            document,
            typeReferenceNode,
            "AccessKind",
            false,
            LogicalPackageTypeReferenceTextKind.AccessKind,
            0,
            typeReferenceRow,
            graph,
            hasAccessKind)
        || !LogicalPackageImageJsonMaterializeTypeReferenceTextMember(
