    stack mut u32[0 max] index = 0;
    while willexit (index < regionCount)
    {
        stack mut u64[0 2 ** 63 - 1] regionNode = 0;
        stack mut bool hasParameterName = false;
        stack mut bool hasStartExpression = false;
        stack mut bool hasCountExpression = false;
        stack mut u32[0 max] parameterNameTextRow = 0;
        stack mut u32[0 max] startExpressionTextRow = 0;
        stack mut u32[0 max] countExpressionTextRow = 0;
        stack mut u32[0 max] regionRow = 0;
        if (!document.TryChildAt(regionsNode, (u64[0 2 ** 63 - 1])index, regionNode)
            || document.KindAt(regionNode) != JsonKind.Object
            || !LogicalPackageImageJsonMaterializeTypeReferenceTextMemberRow(
                document,
