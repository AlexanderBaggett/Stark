    WritePackageSectionDirectoryEntry(buf, PackageSectionTextConstants(), SectionFlagsRequired(), textConstantOffset, (u64[0 max])textConstantBuf.Count(), SectionEncodingRaw());
    AppendBytes(buf, instrBuf);
