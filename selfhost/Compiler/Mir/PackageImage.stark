        self.HasFunctionIsTailCallableValue = false;
        self.FunctionIsTailCallableValue = false;
        self.HasClosureStorageKindValue = false;
        self.HasClosureCallCapabilityValue = false;
        self.HasDynTraitStorageKindValue = false;
        self.HasReturnTypeValue = false;
        self.HasAssociatedOwnerTypeValue = false;
        self.HasAssociatedTypeNameValue = false;
        self.HasSourceAliasNameValue = false;
    }

