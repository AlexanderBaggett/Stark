                outputIndex,
                graph,
                valueNameTextRow)
            || !LogicalPackageImageJsonRequiredBoolMemberValue(
                document,
                outputNode,
                "BindsReturnValue",
                bindsReturnValue)
            || !LogicalPackageTypedCallableFactGraphAddAsmOutputRow(
                graph,
                asmRow,
                outputIndex,
                registerNameTextRow,
                valueNameTextRow,
                bindsReturnValue))
        {
            return false;
