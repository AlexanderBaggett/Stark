internal fn bool SourceSwitchCaptureSignaturesMatch(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] leftCaptureStart,
    u32[0 max] leftCaptureCount,
    u32[0 max] rightCaptureStart,
    u32[0 max] rightCaptureCount)
{
    if (leftCaptureCount != rightCaptureCount)
    {
        return false;
    }

    stack mut u32[0 max] captureOffset = 0;
    while willexit (captureOffset < leftCaptureCount)
    {
        stack u32[0 max] leftRow = leftCaptureStart + captureOffset;
        stack u32[0 max] rightRow = rightCaptureStart + captureOffset;
        if (!captureNameTokens.Contains(leftRow)
            || !captureNameTokens.Contains(rightRow)
            || !captureTypeCodes.Contains(leftRow)
            || !captureTypeCodes.Contains(rightRow))
        {
            return false;
        }

        stack u32[0 max] leftNameToken = captureNameTokens.Get(leftRow);
        stack u32[0 max] rightNameToken = captureNameTokens.Get(rightRow);
        if (!TokenTextEqualsToken(stream, source, leftNameToken, rightNameToken)
            || captureTypeCodes.Get(leftRow) != captureTypeCodes.Get(rightRow))
        {
            return false;
        }

        captureOffset = captureOffset + 1;
    }

    return true;
}

internal fn bool TryParseTerminalSwitchReturnArm(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    arm = new();
    nextToken = armStart;
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart || stream.KindAt(armStart + 1) != TokenKind.Return)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (stream.KindAt(armStart) != TokenKind.Return)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, params, funcNames, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TryParseTerminalSwitchReturnArmWithEnums(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap_all(sourceValueFacts)
{
    arm = new();
    nextToken = armStart;
    stack mut IrTable<ConstructedObjectLocal> noConstructedObjectLocals = new();
    stack mut IrTable<SourceSliceDescriptorLocal> noSliceDescriptorLocals = new();
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart || stream.KindAt(armStart + 1) != TokenKind.Return)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(
            stream,
            source,
            nodes,
            params,
            funcNames,
            noConstructedObjectLocals,
            noSliceDescriptorLocals,
            localTypes,
            sourceValueFacts,
            moduleFacts,
            armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace)
        {
            return false;
        }

        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (stream.KindAt(armStart) != TokenKind.Return)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        params,
        funcNames,
        noConstructedObjectLocals,
        noSliceDescriptorLocals,
        localTypes,
        sourceValueFacts,
        moduleFacts,
        armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool CopyTerminalSwitchCaptureParams(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    mut borrow IrTable<ParamName> armParams)
{
    if (!CopyParamNamePrefix(baseParams, baseParamCount, armParams))
    {
        return false;
    }

    stack mut u32[0 max] captureOffset = 0;
    while willexit (captureOffset < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureOffset;
        if (!captureNameTokens.Contains(captureRow) || !captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] captureTypeCode = captureTypeCodes.Get(captureRow);
        stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeNonValue();
        if (!TrySourceSwitchCaptureLocalTypeCode(captureTypeCode, localTypeCode))
        {
            return false;
        }

        stack u32[0 max] captureNameToken = captureNameTokens.Get(captureRow);
        stack u64[0 2 ** 63 - 1] captureNameStart = stream.StartAt((u64[0 2 ** 63 - 1])captureNameToken);
        stack u64[0 2 ** 63 - 1] captureNameLength = stream.LengthAt((u64[0 2 ** 63 - 1])captureNameToken);
        if (ParamIndexOf(armParams, source, captureNameStart, captureNameLength) >= 0)
        {
            return false;
        }

        stack u32[0 max] captureLocalIndex = ResolveParam(armParams, source, captureNameStart, captureNameLength);
        if (captureLocalIndex != (u32[0 max])(baseParamCount + (u64[0 2 ** 63 - 1])captureOffset))
        {
            return false;
        }

        captureOffset = captureOffset + 1;
    }

    return true;
}

internal fn bool TrySourceSwitchCaptureLocalTypeCode(u32[0 max] captureTypeCode, out u32[0 max] localTypeCode)
{
    localTypeCode = SourceLocalTypeCodeNonValue();
    if (captureTypeCode == SourceLocalTypeCodeFixedArrayParam() || SourceLocalTypeCodeIsStructValue(captureTypeCode))
    {
        localTypeCode = captureTypeCode;
        return true;
    }

    localTypeCode = SourceLocalTypeCodeForResolvedScalarValue(captureTypeCode);
    return localTypeCode != SourceLocalTypeCodeNonValue();
}

internal inline finite law bool SourceSwitchCaptureTypeCodeIsAggregateLocal(u32[0 max] captureTypeCode)
{
    return captureTypeCode == SourceLocalTypeCodeFixedArrayParam() || SourceLocalTypeCodeIsStructValue(captureTypeCode);
}

internal inline finite law bool SourceSwitchCaptureIsFixedArrayWholeParam(
    u32[0 max] elementIndex,
    u32[0 max] captureTypeCode,
    ParamAbiFacts fixedArrayFacts)
{
    return fixedArrayFacts.IsFixedArray
        && elementIndex == fixedArrayFacts.FixedArrayLength
        && captureTypeCode == SourceLocalTypeCodeFixedArrayParam();
}

internal inline finite law bool SourceSwitchCaptureIsStructWholeParam(
    u32[0 max] fieldIndex,
    u32[0 max] captureTypeCode,
    ParamAbiFacts structValueFacts)
{
    return structValueFacts.IsStructValue
        && structValueFacts.StructValueTypeToken != 0
        && fieldIndex == structValueFacts.StructValueFieldCount
        && SourceLocalTypeCodeIsStructValue(captureTypeCode)
        && SourceLocalTypeCodeStructValueTypeToken(captureTypeCode) == structValueFacts.StructValueTypeToken;
}

internal fn bool TryParseSwitchGuardWithCaptures(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    u64[0 2 ** 63 - 1] guardStart,
    out ExprParseResult guard,
    out u64[0 2 ** 63 - 1] nextToken)
{
    guard = new();
    nextToken = guardStart;

    stack mut IrTable<ParamName> guardParams = new();
    if (!CopyTerminalSwitchCaptureParams(
            stream,
            source,
            baseParams,
            baseParamCount,
            captureNameTokens,
            captureTypeCodes,
            captureStart,
            captureCount,
            guardParams))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] expectedParamCount = baseParamCount + (u64[0 2 ** 63 - 1])captureCount;
    stack ExprParseResult parsedGuard = ParseExprIn(stream, source, nodes, guardParams, funcNames, guardStart);
    if (parsedGuard.NodeId == 0
        || parsedGuard.Next == guardStart
        || guardParams.Count() != expectedParamCount)
    {
        return false;
    }

    guard = parsedGuard;
    nextToken = parsedGuard.Next;
    return true;
}

internal fn bool BuildTerminalSwitchCaptureLocalTypes(
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    mut borrow IrTable<u32[0 max]> armLocalTypes)
    where overlap(captureTypeCodes, baseLocalTypes)
{
    stack u64[0 2 ** 63 - 1] baseLocalTypeCount = baseLocalTypes.Count();
    stack mut u64[0 2 ** 63 - 1] typeIndex = 0;
    while willexit (typeIndex < baseLocalTypeCount)
    {
        stack u32[0 max] typeSlot = (u32[0 max])(typeIndex + 1);
        stack mut u32[0 max] typeCode = 0;
        if (baseLocalTypes.Contains(typeSlot))
        {
            typeCode = baseLocalTypes.Get(typeSlot);
        }

        if (armLocalTypes.Add(typeCode) == 0)
        {
            return false;
        }

        typeIndex = typeIndex + 1;
    }

    stack mut u32[0 max] captureIndex = 0;
    while willexit (captureIndex < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureIndex;
        if (!captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] captureTypeCode = captureTypeCodes.Get(captureRow);
        stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeNonValue();
        if (!TrySourceSwitchCaptureLocalTypeCode(captureTypeCode, localTypeCode))
        {
            return false;
        }

        if (armLocalTypes.Add(localTypeCode) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    return true;
}

internal fn bool BuildTerminalSwitchCaptureLocalTypesAndFacts(
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    borrow IrTable<ValueFacts> baseSourceValueFacts,
    mut borrow IrTable<u32[0 max]> armLocalTypes,
    mut borrow IrTable<ValueFacts> armSourceValueFacts)
    where overlap(captureTypeCodes, baseLocalTypes), overlap_all(baseSourceValueFacts)
{
    if (!BuildTerminalSwitchCaptureLocalTypes(
        captureTypeCodes,
        captureStart,
        captureCount,
        baseLocalTypes,
        armLocalTypes))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] baseLocalTypeCount = baseLocalTypes.Count();
    stack mut u64[0 2 ** 63 - 1] factsIndex = 0;
    while willexit (factsIndex < baseLocalTypeCount)
    {
        stack u32[0 max] factsSlot = (u32[0 max])(factsIndex + 1);
        stack mut ValueFacts facts = new();
        if (baseSourceValueFacts.Contains(factsSlot))
        {
            facts = baseSourceValueFacts.Get(factsSlot);
        }

        if (armSourceValueFacts.Add(facts) == 0)
        {
            return false;
        }

        factsIndex = factsIndex + 1;
    }

    stack mut u32[0 max] captureIndex = 0;
    while willexit (captureIndex < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureIndex;
        if (!captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack mut ValueFacts captureFacts = new();
        stack u32[0 max] captureTypeCode = captureTypeCodes.Get(captureRow);
        if (!SourceSwitchCaptureTypeCodeIsAggregateLocal(captureTypeCode))
        {
            stack MirType payloadType = MirTypeForResolvedFieldTypeCode(captureTypeCode);
            stack bool ignored = TrySetFullIntegerRangeForMirType(captureFacts, payloadType);
        }

        if (armSourceValueFacts.Add(captureFacts) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    return true;
}

internal fn bool TryParseTerminalSwitchReturnArmWithCaptures(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    arm = new();
    nextToken = armStart;

    stack mut IrTable<ParamName> armParams = new();
    if (!CopyTerminalSwitchCaptureParams(
            stream,
            source,
            baseParams,
            baseParamCount,
            captureNameTokens,
            captureTypeCodes,
            captureStart,
            captureCount,
            armParams))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] expectedParamCount = baseParamCount + (u64[0 2 ** 63 - 1])captureCount;
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart || stream.KindAt(armStart + 1) != TokenKind.Return)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, armParams, funcNames, armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace || armParams.Count() != expectedParamCount)
        {
            return false;
        }

        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (stream.KindAt(armStart) != TokenKind.Return)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseExprIn(stream, source, nodes, armParams, funcNames, armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    if (armParams.Count() != expectedParamCount)
    {
        return false;
    }

    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TryParseTerminalSwitchReturnArmWithEnumsAndCaptures(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap_all(sourceValueFacts)
{
    arm = new();
    nextToken = armStart;

    stack mut IrTable<ParamName> armParams = new();
    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    stack mut IrTable<ValueFacts> armSourceValueFacts = new();
    if (!CopyTerminalSwitchCaptureParams(
            stream,
            source,
            baseParams,
            baseParamCount,
            captureNameTokens,
            captureTypeCodes,
            captureStart,
            captureCount,
            armParams)
        || !BuildTerminalSwitchCaptureLocalTypesAndFacts(
            captureTypeCodes,
            captureStart,
            captureCount,
            localTypes,
            sourceValueFacts,
            armLocalTypes,
            armSourceValueFacts))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] expectedParamCount = baseParamCount + (u64[0 2 ** 63 - 1])captureCount;
    if (armLocalTypes.Count() != expectedParamCount || armSourceValueFacts.Count() != expectedParamCount)
    {
        return false;
    }

    stack mut IrTable<ConstructedObjectLocal> noConstructedObjectLocals = new();
    stack mut IrTable<SourceSliceDescriptorLocal> noSliceDescriptorLocals = new();
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart || stream.KindAt(armStart + 1) != TokenKind.Return)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(
            stream,
            source,
            nodes,
            armParams,
            funcNames,
            noConstructedObjectLocals,
            noSliceDescriptorLocals,
            armLocalTypes,
            armSourceValueFacts,
            moduleFacts,
            armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (afterExpr != (u64[0 2 ** 63 - 1])closeBrace || armParams.Count() != expectedParamCount)
        {
            return false;
        }

        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (stream.KindAt(armStart) != TokenKind.Return)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        armParams,
        funcNames,
        noConstructedObjectLocals,
        noSliceDescriptorLocals,
        armLocalTypes,
        armSourceValueFacts,
        moduleFacts,
        armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    if (armParams.Count() != expectedParamCount)
    {
        return false;
    }

    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TryParseSwitchGuardWithFixedArrayCapturesAndSlices(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    u32[0 max] fixedArrayParamIndex,
    ParamAbiFacts fixedArrayFacts,
    bool useFixedArrayStorageLocal,
    borrow IrTable<u32[0 max]> captureElementIndices,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    u64[0 2 ** 63 - 1] guardStart,
    out ExprParseResult guard,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap(captureTypeCodes, localTypes), overlap_all(sourceValueFacts)
{
    guard = new();
    nextToken = guardStart;

    stack mut IrTable<ParamName> guardParams = new();
    stack mut IrTable<u32[0 max]> guardLocalTypes = new();
    stack mut IrTable<ValueFacts> guardSourceValueFacts = new();
    stack mut IrTable<SourceSliceDescriptorLocal> guardSliceDescriptorLocals = new();
    if (!CopyTerminalSwitchCaptureParams(
            stream,
            source,
            baseParams,
            baseParamCount,
            captureNameTokens,
            captureTypeCodes,
            captureStart,
            captureCount,
            guardParams)
        || !BuildTerminalSwitchCaptureLocalTypesAndFacts(
            captureTypeCodes,
            captureStart,
            captureCount,
            localTypes,
            sourceValueFacts,
            guardLocalTypes,
            guardSourceValueFacts)
        || !BuildTerminalFixedArraySwitchCaptureSliceDescriptorLocals(
            fixedArrayParamIndex,
            fixedArrayFacts,
            useFixedArrayStorageLocal,
            captureElementIndices,
            captureTypeCodes,
            captureStart,
            captureCount,
            localTypes,
            sliceDescriptorLocals,
            guardSliceDescriptorLocals))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] expectedParamCount = baseParamCount + (u64[0 2 ** 63 - 1])captureCount;
    if (guardParams.Count() != expectedParamCount
        || guardLocalTypes.Count() != expectedParamCount
        || guardSourceValueFacts.Count() != expectedParamCount)
    {
        return false;
    }

    stack mut IrTable<ConstructedObjectLocal> noConstructedObjectLocals = new();
    stack ExprParseResult parsedGuard = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        guardParams,
        funcNames,
        noConstructedObjectLocals,
        guardSliceDescriptorLocals,
        guardLocalTypes,
        guardSourceValueFacts,
        moduleFacts,
        guardStart);
    if (parsedGuard.NodeId == 0
        || parsedGuard.Next == guardStart
        || guardParams.Count() != expectedParamCount)
    {
        return false;
    }

    guard = parsedGuard;
    nextToken = parsedGuard.Next;
    return true;
}

internal fn bool TryParseTerminalSwitchReturnArmWithFixedArrayCapturesAndSlices(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    mut borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParamName> baseParams,
    u64[0 2 ** 63 - 1] baseParamCount,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<ValueFacts> sourceValueFacts,
    borrow IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals,
    u32[0 max] fixedArrayParamIndex,
    ParamAbiFacts fixedArrayFacts,
    bool useFixedArrayStorageLocal,
    borrow IrTable<u32[0 max]> captureElementIndices,
    borrow IrTable<u32[0 max]> captureNameTokens,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    u64[0 2 ** 63 - 1] armStart,
    out ExprParseResult arm,
    out u64[0 2 ** 63 - 1] nextToken)
    where overlap(captureTypeCodes, localTypes), overlap_all(sourceValueFacts)
{
    arm = new();
    nextToken = armStart;

    stack mut IrTable<ParamName> armParams = new();
    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    stack mut IrTable<ValueFacts> armSourceValueFacts = new();
    stack mut IrTable<SourceSliceDescriptorLocal> armSliceDescriptorLocals = new();
    if (!CopyTerminalSwitchCaptureParams(
            stream,
            source,
            baseParams,
            baseParamCount,
            captureNameTokens,
            captureTypeCodes,
            captureStart,
            captureCount,
            armParams)
        || !BuildTerminalSwitchCaptureLocalTypesAndFacts(
            captureTypeCodes,
            captureStart,
            captureCount,
            localTypes,
            sourceValueFacts,
            armLocalTypes,
            armSourceValueFacts)
        || !BuildTerminalFixedArraySwitchCaptureSliceDescriptorLocals(
            fixedArrayParamIndex,
            fixedArrayFacts,
            useFixedArrayStorageLocal,
            captureElementIndices,
            captureTypeCodes,
            captureStart,
            captureCount,
            localTypes,
            sliceDescriptorLocals,
            armSliceDescriptorLocals))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] expectedParamCount = baseParamCount + (u64[0 2 ** 63 - 1])captureCount;
    if (armParams.Count() != expectedParamCount
        || armLocalTypes.Count() != expectedParamCount
        || armSourceValueFacts.Count() != expectedParamCount)
    {
        return false;
    }

    stack mut IrTable<ConstructedObjectLocal> noConstructedObjectLocals = new();
    if (stream.KindAt(armStart) == TokenKind.LBrace)
    {
        stack u32[0 max] closeBrace = MatchingBraceForMirLowering(stream, (u32[0 max])armStart);
        if (closeBrace == (u32[0 max])armStart || stream.KindAt(armStart + 1) != TokenKind.Return)
        {
            return false;
        }

        stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(
            stream,
            source,
            nodes,
            armParams,
            funcNames,
            noConstructedObjectLocals,
            armSliceDescriptorLocals,
            armLocalTypes,
            armSourceValueFacts,
            moduleFacts,
            armStart + 2);
        stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
        if (stream.KindAt(afterExpr) == TokenKind.Semi)
        {
            afterExpr = afterExpr + 1;
        }

        if (parsedArm.NodeId == 0
            || afterExpr != (u64[0 2 ** 63 - 1])closeBrace
            || armParams.Count() != expectedParamCount)
        {
            return false;
        }

        arm = parsedArm;
        nextToken = (u64[0 2 ** 63 - 1])closeBrace + 1;
        return true;
    }

    if (stream.KindAt(armStart) != TokenKind.Return)
    {
        return false;
    }

    stack ExprParseResult parsedArm = ParseConstructedObjectExprWithEnumsAndSlicesIn(
        stream,
        source,
        nodes,
        armParams,
        funcNames,
        noConstructedObjectLocals,
        armSliceDescriptorLocals,
        armLocalTypes,
        armSourceValueFacts,
        moduleFacts,
        armStart + 1);
    stack mut u64[0 2 ** 63 - 1] afterExpr = parsedArm.Next;
    if (stream.KindAt(afterExpr) == TokenKind.Semi)
    {
        afterExpr = afterExpr + 1;
    }

    if (parsedArm.NodeId == 0 || armParams.Count() != expectedParamCount)
    {
        return false;
    }

    arm = parsedArm;
    nextToken = afterExpr;
    return true;
}

internal fn bool TerminalSwitchCaseValueExists(borrow IrTable<i64[min max]> caseValues, i64[min max] value)
{
    stack mut u64[0 2 ** 63 - 1] i = 0;
    stack u64[0 2 ** 63 - 1] count = caseValues.Count();
    while willexit (i < count)
    {
        stack i64[min max] current = caseValues.Get((u32[0 max])(i + 1));
        if (current == value)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}


internal fn bool SourceSwitchPayloadPatternRangesAreProvablyDisjoint(
    u32[0 max] leftStart,
    u32[0 max] leftCount,
    u32[0 max] rightStart,
    u32[0 max] rightCount,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternTypeCodes,
    borrow IrTable<u32[0 max]> payloadPatternKinds,
    borrow IrTable<i64[min max]> payloadPatternMinValues,
    borrow IrTable<i64[min max]> payloadPatternMaxValues)
{
    if (leftCount == 0 || rightCount == 0)
    {
        return false;
    }

    stack mut u32[0 max] leftOffset = 0;
    while willexit (leftOffset < leftCount)
    {
        stack u32[0 max] leftRow = leftStart + leftOffset;
        if (!payloadPatternVariantOrdinals.Contains(leftRow)
            || !payloadPatternOrdinals.Contains(leftRow)
            || !payloadPatternTypeCodes.Contains(leftRow)
            || !payloadPatternKinds.Contains(leftRow)
            || !payloadPatternMinValues.Contains(leftRow)
            || !payloadPatternMaxValues.Contains(leftRow)
            || payloadPatternKinds.Get(leftRow) != SourceSwitchEnumPayloadPatternKindScalarInterval())
        {
            return false;
        }

        stack u32[0 max] leftVariantOrdinal = payloadPatternVariantOrdinals.Get(leftRow);
        stack u32[0 max] leftPayloadOrdinal = payloadPatternOrdinals.Get(leftRow);
        stack u32[0 max] leftTypeCode = payloadPatternTypeCodes.Get(leftRow);
        stack i64[min max] leftMin = payloadPatternMinValues.Get(leftRow);
        stack i64[min max] leftMax = payloadPatternMaxValues.Get(leftRow);

        stack mut u32[0 max] rightOffset = 0;
        while willexit (rightOffset < rightCount)
        {
            stack u32[0 max] rightRow = rightStart + rightOffset;
            if (!payloadPatternVariantOrdinals.Contains(rightRow)
                || !payloadPatternOrdinals.Contains(rightRow)
                || !payloadPatternTypeCodes.Contains(rightRow)
                || !payloadPatternKinds.Contains(rightRow)
                || !payloadPatternMinValues.Contains(rightRow)
                || !payloadPatternMaxValues.Contains(rightRow)
                || payloadPatternKinds.Get(rightRow) != SourceSwitchEnumPayloadPatternKindScalarInterval())
            {
                return false;
            }

            stack u32[0 max] rightVariantOrdinal = payloadPatternVariantOrdinals.Get(rightRow);
            stack u32[0 max] rightPayloadOrdinal = payloadPatternOrdinals.Get(rightRow);
            stack u32[0 max] rightTypeCode = payloadPatternTypeCodes.Get(rightRow);
            if (leftVariantOrdinal == rightVariantOrdinal
                && leftPayloadOrdinal == rightPayloadOrdinal
                && leftTypeCode == rightTypeCode)
            {
                stack i64[min max] rightMin = payloadPatternMinValues.Get(rightRow);
                stack i64[min max] rightMax = payloadPatternMaxValues.Get(rightRow);
                if (SourceSwitchScalarIntervalsAreDisjoint(leftMin, leftMax, rightMin, rightMax))
                {
                    return true;
                }
            }

            rightOffset = rightOffset + 1;
        }

        leftOffset = leftOffset + 1;
    }

    return false;
}

internal fn bool SourceSwitchPayloadCaseOverlapsPreviousCase(
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<u32[0 max]> casePayloadPatternStarts,
    borrow IrTable<u32[0 max]> casePayloadPatternCounts,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternTypeCodes,
    borrow IrTable<u32[0 max]> payloadPatternKinds,
    borrow IrTable<i64[min max]> payloadPatternMinValues,
    borrow IrTable<i64[min max]> payloadPatternMaxValues,
    i64[min max] caseValue,
    u32[0 max] payloadPatternStart,
    u32[0 max] payloadPatternCount)
{
    stack mut u64[0 2 ** 63 - 1] i = 0;
    stack u64[0 2 ** 63 - 1] count = caseValues.Count();
    if (casePayloadPatternStarts.Count() != count || casePayloadPatternCounts.Count() != count)
    {
        return true;
    }

    while willexit (i < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(i + 1);
        if (caseValues.Get(caseSlot) == caseValue)
        {
            stack u32[0 max] previousStart = casePayloadPatternStarts.Get(caseSlot);
            stack u32[0 max] previousCount = casePayloadPatternCounts.Get(caseSlot);
            if (!SourceSwitchPayloadPatternRangesAreProvablyDisjoint(
                    previousStart,
                    previousCount,
                    payloadPatternStart,
                    payloadPatternCount,
                    payloadPatternVariantOrdinals,
                    payloadPatternOrdinals,
                    payloadPatternTypeCodes,
                    payloadPatternKinds,
                    payloadPatternMinValues,
                    payloadPatternMaxValues))
            {
                return true;
            }
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TerminalBooleanSwitchCaseValueExists(borrow IrTable<u32[0 max]> caseValues, u32[0 max] value)
{
    stack mut u64[0 2 ** 63 - 1] i = 0;
    stack u64[0 2 ** 63 - 1] count = caseValues.Count();
    while willexit (i < count)
    {
        stack u32[0 max] current = caseValues.Get((u32[0 max])(i + 1));
        if (current == value)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool TryParseTerminalIntegerSwitchReturnCases(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    mut borrow IrTable<ExprNode> nodes,
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ParamName> funcNames,
    u64[0 2 ** 63 - 1] switchIndex,
    out ExprParseResult scrutinee,
    mut borrow IrTable<i64[min max]> caseValues,
    mut borrow IrTable<i64[min max]> caseMaxValues,
    mut borrow IrTable<ExprParseResult> caseArms,
    out ExprParseResult defaultArm,
    out u64[0 2 ** 63 - 1] nextToken)
{
    scrutinee = new();
    defaultArm = new();
    nextToken = switchIndex;
    if (stream.KindAt(switchIndex) != TokenKind.Switch
        || stream.KindAt(switchIndex + 1) != TokenKind.LParen)
    {
        return false;
    }

    stack ExprParseResult parsedScrutinee = ParseExprIn(stream, source, nodes, params, funcNames, switchIndex + 2);
    if (stream.KindAt(parsedScrutinee.Next) != TokenKind.RParen
        || stream.KindAt(parsedScrutinee.Next + 1) != TokenKind.LBrace)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] switchBodyOpen = parsedScrutinee.Next + 1;
    stack u32[0 max] switchBodyClose = MatchingBraceForMirLowering(stream, (u32[0 max])switchBodyOpen);
    if (switchBodyClose == (u32[0 max])switchBodyOpen)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] cursor = switchBodyOpen + 1;
    while willexit (stream.KindAt(cursor) == TokenKind.Case)
    {
        stack mut i64[min max] caseValue = 0;
        stack mut i64[min max] caseMaxValue = 0;
        stack mut u64[0 2 ** 63 - 1] afterCaseLabel = cursor + 1;
        if (!TryParseTerminalSwitchIntegerCaseInterval(stream, source, cursor + 1, caseValue, caseMaxValue, afterCaseLabel)
            || stream.KindAt(afterCaseLabel) != TokenKind.Colon
            || TerminalSwitchCaseIntervalOverlaps(caseValues, caseMaxValues, caseValue, caseMaxValue))
        {
            return false;
        }

        stack mut ExprParseResult caseArm = new();
        stack mut u64[0 2 ** 63 - 1] afterCase = afterCaseLabel + 1;
        if (!TryParseTerminalSwitchReturnArm(stream, source, nodes, params, funcNames, afterCaseLabel + 1, caseArm, afterCase))
        {
            return false;
        }

        if (caseValues.Add(caseValue) == 0
            || caseMaxValues.Add(caseMaxValue) == 0
            || caseArms.Add(caseArm) == 0)
        {
            return false;
        }

        cursor = afterCase;
    }

    if (caseValues.Count() == 0)
    {
        return false;
    }

    if (stream.KindAt(cursor) != TokenKind.Default
        || stream.KindAt(cursor + 1) != TokenKind.Colon)
    {
        return false;
    }

    stack mut ExprParseResult parsedDefault = new();
    stack mut u64[0 2 ** 63 - 1] afterDefault = cursor + 2;
    if (!TryParseTerminalSwitchReturnArm(stream, source, nodes, params, funcNames, cursor + 2, parsedDefault, afterDefault))
    {
        return false;
    }

    if (afterDefault != (u64[0 2 ** 63 - 1])switchBodyClose)
    {
        return false;
    }

    scrutinee = parsedScrutinee;
    defaultArm = parsedDefault;
    nextToken = (u64[0 2 ** 63 - 1])switchBodyClose + 1;
    return true;
}

