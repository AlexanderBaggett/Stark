    borrow IrTable<u32[0 max]> fieldCaptureIndices,
    borrow IrTable<u32[0 max]> fieldCaptureTypeCodes,
    borrow IrTable<u32[0 max]> nestedFieldIndices,
    borrow IrTable<u32[0 max]> nestedKinds,
    borrow IrTable<u32[0 max]> nestedAggregateDescriptorRows,
    borrow IrTable<u32[0 max]> nestedListDescriptorRows,
    mut borrow IrTable<SourceSwitchPatternDecisionNode> decisionNodes,
    mut borrow IrTable<SourceSwitchPatternDecisionMember> decisionMembers,
    mut borrow IrTable<u32[0 max]> caseDecisionMemberStarts,
    mut borrow IrTable<u32[0 max]> caseDecisionMemberCounts)
{
    stack u64[0 2 ** 63 - 1] count = caseAggregateDescriptorRows.Count();
    if (caseFieldCaptureStarts.Count() != count
        || caseFieldCaptureCounts.Count() != count
        || (caseGuardNodes.Count() != 0 && caseGuardNodes.Count() != count)
        || (caseNestedStarts.Count() != 0 && caseNestedStarts.Count() != count)
        || (caseNestedCounts.Count() != 0 && caseNestedCounts.Count() != count))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> preflightCaptureNameTokens = new();
    stack mut IrTable<u32[0 max]> preflightGuardNodes = new();

    stack mut u64[0 2 ** 63 - 1] captureIndex = 0;
    while willexit (captureIndex < fieldCaptureTypeCodes.Count())
    {
        if (preflightCaptureNameTokens.Add(1) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(index + 1);
        stack u32[0 max] descriptorRow = caseAggregateDescriptorRows.Get(caseSlot);
        if (!aggregateDescriptors.Contains(descriptorRow))
        {
            return false;
        }

        stack SourceSwitchAggregatePatternDescriptor descriptor = aggregateDescriptors.Get(descriptorRow);
        stack u32[0 max] captureStart = caseFieldCaptureStarts.Get(caseSlot);
        stack u32[0 max] captureCount = caseFieldCaptureCounts.Get(caseSlot);
        stack mut u32[0 max] nestedStart = 0;
        stack mut u32[0 max] nestedCount = 0;
        if (caseNestedStarts.Count() != 0)
        {
            nestedStart = caseNestedStarts.Get(caseSlot);
        }

        if (caseNestedCounts.Count() != 0)
        {
            nestedCount = caseNestedCounts.Get(caseSlot);
        }

        stack mut u32[0 max] memberStart = 0;
        stack mut u32[0 max] memberCount = 0;
        if (!TryTranslateSourceSwitchStructFieldDecisionRowsToPatternDecisionMembers(
                stream,
                source,
                moduleFacts,
                descriptor,
                captureStart,
                captureCount,
                nestedStart,
                nestedCount,
                fieldPatternIndices,
                fieldPatternTypeCodes,
                fieldPatternKinds,
                fieldPatternMinValues,
                fieldPatternMaxValues,
                fieldCaptureIndices,
                fieldCaptureTypeCodes,
                preflightCaptureNameTokens,
                nestedFieldIndices,
                nestedKinds,
                nestedAggregateDescriptorRows,
                nestedListDescriptorRows,
                aggregateDescriptors,
                listDescriptors,
                decisionNodes,
                decisionMembers,
                memberStart,
                memberCount))
        {
            return false;
        }

        stack mut u32[0 max] guardNode = 0;
        if (caseGuardNodes.Count() != 0)
        {
            guardNode = caseGuardNodes.Get(caseSlot);
        }

        if (SourceSwitchPatternDecisionCaseOverlapsPreviousUnguardedCase(
                exprNodes,
