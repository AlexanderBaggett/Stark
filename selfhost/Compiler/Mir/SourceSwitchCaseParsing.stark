            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool TryBuildSourceSwitchListPatternCaseDescriptors(
    ParamAbiFacts fixedArrayFacts,
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    mut borrow IrTable<SourceSwitchListPatternDescriptor> descriptors,
    mut borrow IrTable<u32[0 max]> caseDescriptorRows)
{
    stack u64[0 2 ** 63 - 1] count = casePatternStarts.Count();
    if (casePatternCounts.Count() != count
        || !fixedArrayFacts.IsFixedArray
        || fixedArrayFacts.FixedArrayLength == 0
        || fixedArrayFacts.FixedArrayFieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] row = (u32[0 max])(index + 1);
        stack u32[0 max] patternStart = casePatternStarts.Get(row);
        stack u32[0 max] patternCount = casePatternCounts.Get(row);
        stack SourceSwitchListPatternDescriptor descriptor = MakeSourceSwitchListPatternDescriptor(
            fixedArrayFacts.FixedArrayFieldTypeCode,
            fixedArrayFacts.FixedArrayLength,
            patternStart,
            patternCount);
        stack u32[0 max] descriptorRow = descriptors.Add(descriptor);
        if (descriptorRow == 0 || caseDescriptorRows.Add(descriptorRow) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool TryBuildSourceSwitchAggregatePatternCaseDescriptors(
    u32[0 max] ownerTypeToken,
    u32[0 max] enumVariantOrdinalPlusOne,
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    mut borrow IrTable<SourceSwitchAggregatePatternDescriptor> descriptors,
    mut borrow IrTable<u32[0 max]> caseDescriptorRows)
{
    stack u64[0 2 ** 63 - 1] count = casePatternStarts.Count();
    if (casePatternCounts.Count() != count || ownerTypeToken == 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] row = (u32[0 max])(index + 1);
        stack u32[0 max] patternStart = casePatternStarts.Get(row);
        stack u32[0 max] patternCount = casePatternCounts.Get(row);
        stack SourceSwitchAggregatePatternDescriptor descriptor =
            MakeSourceSwitchAggregatePatternDescriptor(
                ownerTypeToken,
                enumVariantOrdinalPlusOne,
                patternStart,
                patternCount);
        stack u32[0 max] descriptorRow = descriptors.Add(descriptor);
        if (descriptorRow == 0 || caseDescriptorRows.Add(descriptorRow) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool TryGetSourceSwitchEnumVariantOrdinalForTag(
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    i64[min max] tagValue,
    out u32[0 max] variantOrdinal)
{
    variantOrdinal = 0;
    if (tagValue < 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = moduleFacts.EnumLayouts.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (moduleFacts.EnumLayouts.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && moduleFacts.EnumLayouts.RowKindAt(index) == TypedEnumLayoutRowKind.Variant
            && (i64[min max])moduleFacts.EnumLayouts.VariantTagAt(index) == tagValue)
        {
            variantOrdinal = moduleFacts.EnumLayouts.VariantOrdinalAt(index);
            return true;
        }

        index = index + 1;
    }

    return false;
}

internal fn bool SourceSwitchEnumPayloadPatternRowsMatchVariant(
    u32[0 max] variantOrdinal,
    u32[0 max] patternStart,
    u32[0 max] patternCount,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals)
{
    stack mut u32[0 max] offset = 0;
    while willexit (offset < patternCount)
    {
        stack u32[0 max] row = patternStart + offset;
        if (!payloadPatternVariantOrdinals.Contains(row)
            || payloadPatternVariantOrdinals.Get(row) != variantOrdinal)
        {
            return false;
        }

        offset = offset + 1;
    }

    return true;
}

internal fn bool TryBuildSourceSwitchEnumAggregatePatternCaseDescriptors(
    borrow SourceModuleLoweringFacts moduleFacts,
    u32[0 max] ownerDeclarationIndex,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<u32[0 max]> casePatternStarts,
    borrow IrTable<u32[0 max]> casePatternCounts,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    mut borrow IrTable<SourceSwitchAggregatePatternDescriptor> descriptors,
    mut borrow IrTable<u32[0 max]> caseDescriptorRows)
{
    stack u64[0 2 ** 63 - 1] count = caseValues.Count();
    if (casePatternStarts.Count() != count || casePatternCounts.Count() != count)
    {
        return false;
    }

    stack u32[0 max] ownerTypeToken = ownerDeclarationIndex + 1;
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] row = (u32[0 max])(index + 1);
        stack i64[min max] tagValue = caseValues.Get(row);
        stack u32[0 max] patternStart = casePatternStarts.Get(row);
        stack u32[0 max] patternCount = casePatternCounts.Get(row);
        stack mut u32[0 max] variantOrdinal = 0;
        if (patternCount != 0)
        {
            if (!payloadPatternVariantOrdinals.Contains(patternStart))
            {
                return false;
            }

            variantOrdinal = payloadPatternVariantOrdinals.Get(patternStart);
            stack mut u64[0 max] patternVariantTag = 0;
            if (!moduleFacts.EnumLayouts.TryGetEnumVariantTag(
                    ownerDeclarationIndex,
                    variantOrdinal,
                    patternVariantTag)
                || (i64[min max])patternVariantTag != tagValue)
            {
                return false;
            }
        }
        else if (!TryGetSourceSwitchEnumVariantOrdinalForTag(
                moduleFacts,
                ownerDeclarationIndex,
                tagValue,
                variantOrdinal))
        {
            return false;
        }

        if (!SourceSwitchEnumPayloadPatternRowsMatchVariant(
                variantOrdinal,
                patternStart,
                patternCount,
                payloadPatternVariantOrdinals))
        {
            return false;
        }

        stack SourceSwitchAggregatePatternDescriptor descriptor =
            MakeSourceSwitchAggregatePatternDescriptor(
                ownerTypeToken,
                variantOrdinal + 1,
                patternStart,
                patternCount);
        stack u32[0 max] descriptorRow = descriptors.Add(descriptor);
        if (descriptorRow == 0 || caseDescriptorRows.Add(descriptorRow) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool SourceSwitchListPatternDescriptorRowsAreValid(
    borrow IrTable<SourceSwitchListPatternDescriptor> descriptors,
    borrow IrTable<u32[0 max]> caseDescriptorRows,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues)
{
    stack u64[0 2 ** 63 - 1] count = caseDescriptorRows.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] descriptorRow = caseDescriptorRows.Get((u32[0 max])(index + 1));
        if (!descriptors.Contains(descriptorRow))
        {
            return false;
        }

        stack SourceSwitchListPatternDescriptor descriptor = descriptors.Get(descriptorRow);
        if (!SourceSwitchResolvedFieldTypeCodeSupportsScalarInterval(descriptor.ElementTypeCode)
            || descriptor.FixedLength == 0)
        {
            return false;
        }

        stack mut u32[0 max] offset = 0;
        while willexit (offset < descriptor.ElementPatternCount)
        {
            if (descriptor.ElementPatternStart > 4294967295 - offset)
            {
                return false;
            }

            stack u32[0 max] row = descriptor.ElementPatternStart + offset;
            stack mut u32[0 max] patternTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!elementPatternIndices.Contains(row)
                || !SourceSwitchScalarIntervalPatternRowIsValid(
                    row,
                    elementPatternTypeCodes,
                    elementPatternKinds,
                    elementPatternMinValues,
                    elementPatternMaxValues,
                    patternTypeCode)
                || patternTypeCode != descriptor.ElementTypeCode
                || elementPatternIndices.Get(row) >= descriptor.FixedLength)
            {
                return false;
            }

            offset = offset + 1;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool SourceSwitchStructValuePatternDescriptorRowsAreValid(
    u32[0 max] structTypeToken,
    ParamAbiFacts structValueFacts,
    borrow IrTable<SourceSwitchAggregatePatternDescriptor> descriptors,
    borrow IrTable<u32[0 max]> caseDescriptorRows,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> fieldPatternMemberFactRows,
    borrow IrTable<u32[0 max]> fieldPatternKinds,
    borrow IrTable<i64[min max]> fieldPatternMinValues,
    borrow IrTable<i64[min max]> fieldPatternMaxValues)
{
    if (!structValueFacts.IsStructValue
        || structValueFacts.StructValueFieldCount == 0
        || structValueFacts.StructValueFieldCount > StructValueShapeMaxFields())
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = caseDescriptorRows.Count();
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] descriptorRow = caseDescriptorRows.Get((u32[0 max])(index + 1));
        if (!descriptors.Contains(descriptorRow))
        {
            return false;
        }

        stack SourceSwitchAggregatePatternDescriptor descriptor = descriptors.Get(descriptorRow);
        if (descriptor.OwnerTypeToken != structTypeToken
            || SourceSwitchAggregatePatternHasEnumVariant(descriptor))
        {
            return false;
        }

        stack mut u32[0 max] offset = 0;
        while willexit (offset < descriptor.FieldPatternCount)
        {
            if (descriptor.FieldPatternStart > 4294967295 - offset)
            {
                return false;
            }

            stack u32[0 max] row = descriptor.FieldPatternStart + offset;
            stack mut u32[0 max] patternTypeCode = SourceResolvedFieldTypeCodeInvalid();
            if (!fieldPatternIndices.Contains(row)
                || !fieldPatternMemberFactRows.Contains(row)
                || !SourceSwitchScalarIntervalPatternRowIsValid(
                    row,
                    fieldPatternTypeCodes,
                    fieldPatternKinds,
                    fieldPatternMinValues,
                    fieldPatternMaxValues,
                    patternTypeCode))
            {
                return false;
            }

            stack u32[0 max] fieldIndex = fieldPatternIndices.Get(row);
            stack MirType fieldType = MirTypeForResolvedFieldTypeCode(patternTypeCode);
            if (fieldIndex >= structValueFacts.StructValueFieldCount
                || !StructValueShapeTypeIsSupported(fieldType)
                || StructValueShapeFieldStorageCodeAt(structValueFacts, fieldIndex) != StructValueShapeTypeCode(fieldType))
            {
                return false;
            }

            offset = offset + 1;
        }

        index = index + 1;
    }

    return true;
}

