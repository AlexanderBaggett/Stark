internal fn bool TryBuildSourceSwitchListPatternDecisionPreflightRows(
    borrow IrTable<ExprNode> exprNodes,
    mut borrow IrTable<SourceSwitchAggregatePatternDescriptor> aggregateDescriptors,
    mut borrow IrTable<SourceSwitchListPatternDescriptor> listDescriptors,
    borrow IrTable<u32[0 max]> caseListDescriptorRows,
    borrow IrTable<u32[0 max]> caseGuardNodes,
    borrow IrTable<u32[0 max]> caseElementCaptureStarts,
    borrow IrTable<u32[0 max]> caseElementCaptureCounts,
    borrow IrTable<u32[0 max]> caseNestedStarts,
    borrow IrTable<u32[0 max]> caseNestedCounts,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues,
    borrow IrTable<u32[0 max]> elementCaptureIndices,
    borrow IrTable<u32[0 max]> elementCaptureTypeCodes,
    borrow IrTable<u32[0 max]> nestedElementIndices,
    borrow IrTable<u32[0 max]> nestedKinds,
    borrow IrTable<u32[0 max]> nestedAggregateDescriptorRows,
    borrow IrTable<u32[0 max]> nestedListDescriptorRows,
    mut borrow IrTable<SourceSwitchPatternDecisionNode> decisionNodes,
    mut borrow IrTable<SourceSwitchPatternDecisionMember> decisionMembers,
    mut borrow IrTable<u32[0 max]> caseDecisionMemberStarts,
    mut borrow IrTable<u32[0 max]> caseDecisionMemberCounts)
{
    stack u64[0 2 ** 63 - 1] count = caseListDescriptorRows.Count();
    if (caseElementCaptureStarts.Count() != count
        || caseElementCaptureCounts.Count() != count
        || (caseGuardNodes.Count() != 0 && caseGuardNodes.Count() != count)
        || (caseNestedStarts.Count() != 0 && caseNestedStarts.Count() != count)
        || (caseNestedCounts.Count() != 0 && caseNestedCounts.Count() != count))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> preflightCaptureNameTokens = new();
    stack mut IrTable<u32[0 max]> preflightGuardNodes = new();

    stack mut u64[0 2 ** 63 - 1] captureIndex = 0;
    while willexit (captureIndex < elementCaptureTypeCodes.Count())
    {
        if (preflightCaptureNameTokens.Add(1) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(index + 1);
        stack u32[0 max] descriptorRow = caseListDescriptorRows.Get(caseSlot);
        if (!listDescriptors.Contains(descriptorRow))
        {
            return false;
        }

        stack SourceSwitchListPatternDescriptor descriptor = listDescriptors.Get(descriptorRow);
        stack u32[0 max] captureStart = caseElementCaptureStarts.Get(caseSlot);
        stack u32[0 max] captureCount = caseElementCaptureCounts.Get(caseSlot);
        stack mut u32[0 max] nestedStart = 0;
        stack mut u32[0 max] nestedCount = 0;
        if (caseNestedStarts.Count() != 0)
        {
            nestedStart = caseNestedStarts.Get(caseSlot);
        }

        if (caseNestedCounts.Count() != 0)
        {
            nestedCount = caseNestedCounts.Get(caseSlot);
        }

        stack mut u32[0 max] memberStart = 0;
        stack mut u32[0 max] memberCount = 0;
        if (!TryTranslateSourceSwitchListElementDecisionRowsToPatternDecisionMembers(
                descriptor,
                captureStart,
                captureCount,
                nestedStart,
                nestedCount,
                elementPatternIndices,
                elementPatternTypeCodes,
                elementPatternKinds,
                elementPatternMinValues,
                elementPatternMaxValues,
                elementCaptureIndices,
                elementCaptureTypeCodes,
                preflightCaptureNameTokens,
                nestedElementIndices,
                nestedKinds,
                nestedAggregateDescriptorRows,
                nestedListDescriptorRows,
                aggregateDescriptors,
                listDescriptors,
                decisionNodes,
                decisionMembers,
                memberStart,
                memberCount))
        {
            return false;
        }

        stack mut u32[0 max] guardNode = 0;
        if (caseGuardNodes.Count() != 0)
        {
            guardNode = caseGuardNodes.Get(caseSlot);
        }

        if (SourceSwitchPatternDecisionCaseOverlapsPreviousUnguardedCase(
                exprNodes,
                caseDecisionMemberStarts,
                caseDecisionMemberCounts,
                preflightGuardNodes,
                decisionNodes,
                decisionMembers,
                aggregateDescriptors,
                listDescriptors,
                memberStart,
                memberCount)
            || caseDecisionMemberStarts.Add(memberStart) == 0
            || caseDecisionMemberCounts.Add(memberCount) == 0
            || preflightGuardNodes.Add(guardNode) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}
internal fn bool TryBuildSourceSwitchEnumPayloadPatternDecisionPreflightRows(
    borrow IrTable<ExprNode> exprNodes,
    mut borrow IrTable<SourceSwitchAggregatePatternDescriptor> aggregateDescriptors,
    mut borrow IrTable<SourceSwitchListPatternDescriptor> listDescriptors,
    borrow IrTable<u32[0 max]> caseAggregateDescriptorRows,
    borrow IrTable<u32[0 max]> caseGuardNodes,
    borrow IrTable<u32[0 max]> casePayloadCaptureStarts,
    borrow IrTable<u32[0 max]> casePayloadCaptureCounts,
    borrow IrTable<u32[0 max]> caseNestedStarts,
    borrow IrTable<u32[0 max]> caseNestedCounts,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternTypeCodes,
    borrow IrTable<u32[0 max]> payloadPatternKinds,
    borrow IrTable<i64[min max]> payloadPatternMinValues,
    borrow IrTable<i64[min max]> payloadPatternMaxValues,
    borrow IrTable<u32[0 max]> payloadCaptureVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadCaptureOrdinals,
    borrow IrTable<u32[0 max]> payloadCaptureTypeCodes,
    borrow IrTable<u32[0 max]> nestedVariantOrdinals,
    borrow IrTable<u32[0 max]> nestedPayloadOrdinals,
    borrow IrTable<u32[0 max]> nestedKinds,
    borrow IrTable<u32[0 max]> nestedAggregateDescriptorRows,
    borrow IrTable<u32[0 max]> nestedListDescriptorRows,
    mut borrow IrTable<SourceSwitchPatternDecisionNode> decisionNodes,
    mut borrow IrTable<SourceSwitchPatternDecisionMember> decisionMembers,
    mut borrow IrTable<u32[0 max]> caseDecisionMemberStarts,
    mut borrow IrTable<u32[0 max]> caseDecisionMemberCounts)
{
    stack u64[0 2 ** 63 - 1] count = caseAggregateDescriptorRows.Count();
    if (casePayloadCaptureStarts.Count() != count
        || casePayloadCaptureCounts.Count() != count
        || (caseGuardNodes.Count() != 0 && caseGuardNodes.Count() != count)
        || (caseNestedStarts.Count() != 0 && caseNestedStarts.Count() != count)
        || (caseNestedCounts.Count() != 0 && caseNestedCounts.Count() != count))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> preflightCaptureNameTokens = new();
    stack mut IrTable<u32[0 max]> preflightGuardNodes = new();

    stack mut u64[0 2 ** 63 - 1] captureIndex = 0;
    while willexit (captureIndex < payloadCaptureTypeCodes.Count())
    {
        if (preflightCaptureNameTokens.Add(1) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        stack u32[0 max] caseSlot = (u32[0 max])(index + 1);
        stack u32[0 max] descriptorRow = caseAggregateDescriptorRows.Get(caseSlot);
        if (!aggregateDescriptors.Contains(descriptorRow))
        {
            return false;
        }

        stack SourceSwitchAggregatePatternDescriptor descriptor = aggregateDescriptors.Get(descriptorRow);
        if (!SourceSwitchAggregatePatternHasEnumVariant(descriptor))
        {
            return false;
        }

        stack u32[0 max] memberStart = (u32[0 max])decisionMembers.Count() + 1;
        stack mut u32[0 max] variantNodeRow = 0;
        stack mut u32[0 max] variantMemberRow = 0;
        if (!TryAppendSourceSwitchAggregatePatternDecisionNode(
                true,
                descriptorRow,
                aggregateDescriptors,
                decisionNodes,
                variantNodeRow)
            || !TryAppendSourceSwitchPatternDecisionMember(
                4294967295,
                variantNodeRow,
                decisionNodes,
                decisionMembers,
                variantMemberRow))
        {
            return false;
        }

        stack u32[0 max] captureStart = casePayloadCaptureStarts.Get(caseSlot);
        stack u32[0 max] captureCount = casePayloadCaptureCounts.Get(caseSlot);
        stack mut u32[0 max] nestedStart = 0;
        stack mut u32[0 max] nestedCount = 0;
        if (caseNestedStarts.Count() != 0)
        {
            nestedStart = caseNestedStarts.Get(caseSlot);
        }

        if (caseNestedCounts.Count() != 0)
        {
            nestedCount = caseNestedCounts.Get(caseSlot);
        }

        stack mut u32[0 max] payloadMemberStart = 0;
        stack mut u32[0 max] payloadMemberCount = 0;
        if (!TryTranslateSourceSwitchEnumPayloadDecisionRowsToPatternDecisionMembers(
                descriptor,
                captureStart,
                captureCount,
                nestedStart,
                nestedCount,
                payloadPatternVariantOrdinals,
                payloadPatternOrdinals,
                payloadPatternTypeCodes,
                payloadPatternKinds,
                payloadPatternMinValues,
                payloadPatternMaxValues,
                payloadCaptureVariantOrdinals,
                payloadCaptureOrdinals,
                payloadCaptureTypeCodes,
                preflightCaptureNameTokens,
                nestedVariantOrdinals,
                nestedPayloadOrdinals,
                nestedKinds,
                nestedAggregateDescriptorRows,
                nestedListDescriptorRows,
                aggregateDescriptors,
                listDescriptors,
                decisionNodes,
                decisionMembers,
                payloadMemberStart,
                payloadMemberCount)
            || payloadMemberStart != memberStart + 1
            || payloadMemberCount == 4294967295)
        {
            return false;
        }

        stack u32[0 max] memberCount = payloadMemberCount + 1;
        stack mut u32[0 max] guardNode = 0;
        if (caseGuardNodes.Count() != 0)
        {
            guardNode = caseGuardNodes.Get(caseSlot);
        }

        if (SourceSwitchPatternDecisionCaseOverlapsPreviousUnguardedCase(
                exprNodes,
                caseDecisionMemberStarts,
                caseDecisionMemberCounts,
                preflightGuardNodes,
                decisionNodes,
                decisionMembers,
                aggregateDescriptors,
                listDescriptors,
                memberStart,
                memberCount)
            || caseDecisionMemberStarts.Add(memberStart) == 0
            || caseDecisionMemberCounts.Add(memberCount) == 0
            || preflightGuardNodes.Add(guardNode) == 0)
        {
            return false;
        }

        index = index + 1;
    }

    return true;
}

internal fn bool TryBuildSourceSwitchStructAggregatePatternDecisionPreflightRows(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ExprNode> exprNodes,
    mut borrow IrTable<SourceSwitchAggregatePatternDescriptor> aggregateDescriptors,
    mut borrow IrTable<SourceSwitchListPatternDescriptor> listDescriptors,
    borrow IrTable<u32[0 max]> caseAggregateDescriptorRows,
    borrow IrTable<u32[0 max]> caseGuardNodes,
    borrow IrTable<u32[0 max]> caseFieldCaptureStarts,
    borrow IrTable<u32[0 max]> caseFieldCaptureCounts,
    borrow IrTable<u32[0 max]> caseNestedStarts,
    borrow IrTable<u32[0 max]> caseNestedCounts,
    borrow IrTable<u32[0 max]> fieldPatternIndices,
    borrow IrTable<u32[0 max]> fieldPatternTypeCodes,
