import Compiler.Ir
import Compiler.TargetFacts
import Compiler.Mir.Model
import Compiler.Mir.LlvmText
import System.Memory
import System.Text
module Compiler.Mir.LlvmFacts

internal fn ValueFacts FactAt(borrow IrTable<ValueFacts> facts, u32[0 max] index)
{
    return ValueFactsAtIndex(facts, index);
}

internal fn MemoryStatus EmitLlvmVolatileMarker(ValueFacts facts, mut borrow OwnedAscii sink)
{
    if (facts.Volatile())
    {
        try sink.AppendConstAscii("volatile ");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmMemoryAlignment(ValueFacts facts, mut borrow OwnedAscii sink)
{
    if (facts.HasAlignment() && facts.AlignmentBytes() != 0)
    {
        try sink.AppendConstAscii(", align ");
        try sink.AppendU64((u64[0 max])facts.AlignmentBytes());
    }

    return MemoryStatus.Ok;
}

internal fn ValueFacts RangeFactForValue(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<ValueFacts> paramFacts,
    borrow IrTable<ValueFacts> valueFacts,
    borrow IrTable<ValueFacts> globalFacts,
    borrow IrTable<ValueFacts> functionReturnFacts,
    u32[0 max] valueIndex)
{
    if (!instrs.Contains(valueIndex))
    {
        return FactAt(valueFacts, valueIndex);
    }

    stack MirInstruction instr = instrs.Get(valueIndex);
    if (instr.Opcode() == MirOp.Param)
    {
        return FactAt(paramFacts, (u32[0 max])instr.Immediate() + 1);
    }

    if (instr.Opcode() == MirOp.LoadGlobal)
    {
        return FactAt(globalFacts, (u32[0 max])instr.Immediate());
    }

    if (MirOpIsAnyCall(instr.Opcode()))
    {
        return FactAt(functionReturnFacts, (u32[0 max])instr.Immediate());
    }

    return FactAt(valueFacts, valueIndex);
}

internal fn MemoryStatus EmitLlvmRangeAttribute(MirType type, ValueFacts facts, mut borrow OwnedAscii sink)
{
    if (!facts.HasIntegerRange())
    {
        return MemoryStatus.Ok;
    }

    try sink.AppendConstAscii(" range(");
    try EmitLlvmTypeName(type, sink);
    try sink.AppendConstAscii(" ");
    try sink.AppendI64(facts.IntegerRangeLower());
    try sink.AppendConstAscii(", ");
    try sink.AppendI64(facts.IntegerRangeUpperExclusive());
    try sink.AppendConstAscii(")");
    return MemoryStatus.Ok;
}

internal struct FunctionEffectFacts
{
    bool IsLaw;
    bool LawMayReadMemory;
    bool IsFinite;
    bool IsNoRecurse;

    FunctionEffectFacts()
    {
        self.IsLaw = false;
        self.LawMayReadMemory = false;
        self.IsFinite = false;
        self.IsNoRecurse = false;
    }
}

internal fn FunctionEffectFacts NoFunctionEffectFacts()
{
    stack mut FunctionEffectFacts facts = new();
    return facts;
}

internal fn FunctionEffectFacts FunctionEffectFactsAt(borrow IrTable<FunctionEffectFacts> facts, u32[0 max] functionId)
{
    if (functionId == 0 || !facts.Contains(functionId))
    {
        return NoFunctionEffectFacts();
    }

    return facts.Get(functionId);
}

internal fn MemoryStatus EmitLlvmFunctionEffectAttributes(FunctionEffectFacts facts, mut borrow OwnedAscii sink)
{
    if (facts.IsLaw)
    {
        if (facts.LawMayReadMemory)
        {
            try sink.AppendConstAscii(" memory(read)");
        }
        else
        {
            try sink.AppendConstAscii(" memory(none)");
        }

        try sink.AppendConstAscii(" nosync nofree");
    }

    if (facts.IsFinite)
    {
        try sink.AppendConstAscii(" willreturn mustprogress");
    }

    if (facts.IsNoRecurse)
    {
        try sink.AppendConstAscii(" norecurse");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallSiteEffectAttributes(borrow IrTable<FunctionEffectFacts> functionEffectFacts, u32[0 max] calleeId, mut borrow OwnedAscii sink)
{
    return EmitLlvmFunctionEffectAttributes(FunctionEffectFactsAt(functionEffectFacts, calleeId), sink);
}

internal struct FunctionLinkageFacts
{
    bool IsInternal;

    FunctionLinkageFacts()
    {
        self.IsInternal = false;
    }
}

internal fn FunctionLinkageFacts FunctionLinkageFactsAt(borrow IrTable<FunctionLinkageFacts> facts, u32[0 max] functionId)
{
    stack mut FunctionLinkageFacts empty = new();
    if (functionId != 0 && facts.Contains(functionId))
    {
        return facts.Get(functionId);
    }

    return empty;
}

internal fn MemoryStatus EmitLlvmDefinitionLinkage(FunctionLinkageFacts facts, mut borrow OwnedAscii sink)
{
    if (facts.IsInternal)
    {
        try sink.AppendConstAscii(" internal dso_local");
    }

    return MemoryStatus.Ok;
}

internal struct FunctionCallingConventionFacts
{
    bool HasFfiAbi;
    Compiler.TargetFacts.StarkFfiAbi FfiAbi;

    FunctionCallingConventionFacts()
    {
        self.HasFfiAbi = false;
        self.FfiAbi = Compiler.TargetFacts.StarkFfiAbi.C;
    }
}

internal fn void SetFfiCallingConvention(mut borrow FunctionCallingConventionFacts facts, Compiler.TargetFacts.StarkFfiAbi abi)
{
    facts.HasFfiAbi = true;
    facts.FfiAbi = abi;
}

internal fn FunctionCallingConventionFacts FunctionCallingConventionFactsAt(borrow IrTable<FunctionCallingConventionFacts> facts, u32[0 max] functionId)
{
    stack mut FunctionCallingConventionFacts empty = new();
    if (functionId != 0 && facts.Contains(functionId))
    {
        return facts.Get(functionId);
    }

    return empty;
}

internal fn MemoryStatus EmitLlvmDefinitionCallingConvention(bool isTailCallable, FunctionCallingConventionFacts facts, mut borrow OwnedAscii sink)
{
    if (isTailCallable)
    {
        try sink.AppendConstAscii(" tailcc");
        return MemoryStatus.Ok;
    }

    if (facts.HasFfiAbi)
    {
        stack ascii convention = Compiler.TargetFacts.FfiAbiLlvmCallingConventionName(facts.FfiAbi);
        if (System.Text.AsciiLength(convention) > 0)
        {
            try sink.AppendConstAscii(" ");
            try sink.AppendAscii(convention);
        }
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmCallCallingConvention(
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    u32[0 max] functionId,
    mut borrow OwnedAscii sink)
{
    if (FunctionIdIsTailCallable(funcTailFlags, functionId))
    {
        try sink.AppendConstAscii("tailcc ");
        return MemoryStatus.Ok;
    }

    stack FunctionCallingConventionFacts facts = FunctionCallingConventionFactsAt(functionCallingConventionFacts, functionId);
    if (facts.HasFfiAbi)
    {
        stack ascii convention = Compiler.TargetFacts.FfiAbiLlvmCallingConventionName(facts.FfiAbi);
        if (System.Text.AsciiLength(convention) > 0)
        {
            try sink.AppendAscii(convention);
            try sink.AppendConstAscii(" ");
        }
    }

    return MemoryStatus.Ok;
}

internal struct ParamAbiFacts
{
    bool IsPointer;
    bool IsSlice;
    bool IsFixedArray;
    // 0 = none, 1 = captures(none), 2 = ret read-provenance,
    // 3 = ret provenance, 4 = address read-provenance, 5 = address provenance.
    u32[0 max] CaptureKind;
    bool ReadOnly;
    bool WriteOnly;
    bool Writable;
    bool DeadOnReturn;
    u32[0 max] InitializesBytes;
    MirType SliceElementType;
    u32[0 max] SliceElementSize;
    u32[0 max] SliceElementAlignment;
    u32[0 max] SliceFieldTypeCode;
    MirType FixedArrayElementType;
    u32[0 max] FixedArrayElementSize;
    u32[0 max] FixedArrayAlignment;
    u32[0 max] FixedArrayLength;
    u32[0 max] FixedArrayFieldTypeCode;
    MirType RawPointerElementType;
    u32[0 max] RawPointerElementSize;
    u32[0 max] RawPointerElementAlignment;
    u32[0 max] RawPointerFieldTypeCode;
    bool RawPointerMutable;

    ParamAbiFacts()
    {
        self.IsPointer = false;
        self.IsSlice = false;
        self.IsFixedArray = false;
        self.CaptureKind = 0;
        self.ReadOnly = false;
        self.WriteOnly = false;
        self.Writable = false;
        self.DeadOnReturn = false;
        self.InitializesBytes = 0;
        self.SliceElementType = MirType.I64;
        self.SliceElementSize = 0;
        self.SliceElementAlignment = 0;
        self.SliceFieldTypeCode = 0;
        self.FixedArrayElementType = MirType.I64;
        self.FixedArrayElementSize = 0;
        self.FixedArrayAlignment = 0;
        self.FixedArrayLength = 0;
        self.FixedArrayFieldTypeCode = 0;
        self.RawPointerElementType = MirType.I64;
        self.RawPointerElementSize = 0;
        self.RawPointerElementAlignment = 0;
        self.RawPointerFieldTypeCode = 0;
        self.RawPointerMutable = false;
    }
}

internal inline finite law bool ParamAbiFactsIsMemoryBacked(ParamAbiFacts facts)
{
    return facts.IsPointer || facts.IsSlice;
}

internal fn MemoryStatus EmitLlvmFixedArrayAbiType(ParamAbiFacts facts, mut borrow OwnedAscii sink)
{
    try EmitLlvmFixedArrayTypeName(facts.FixedArrayElementType, facts.FixedArrayLength, sink);
    return MemoryStatus.Ok;
}

internal fn ParamAbiFacts AbiFactAt(borrow IrTable<ParamAbiFacts> facts, u32[0 max] index)
{
    stack mut ParamAbiFacts empty = new();
    if (facts.Contains(index))
    {
        return facts.Get(index);
    }

    return empty;
}

internal fn MemoryStatus EmitLlvmCaptureAttribute(ParamAbiFacts facts, mut borrow OwnedAscii sink)
{
    switch (facts.CaptureKind)
    {
        case 1:
            try sink.AppendConstAscii(" captures(none)");
        case 2:
            try sink.AppendConstAscii(" captures(ret: address, read_provenance)");
        case 3:
            try sink.AppendConstAscii(" captures(ret: address, provenance)");
        case 4:
            try sink.AppendConstAscii(" captures(address, read_provenance)");
        case 5:
            try sink.AppendConstAscii(" captures(address, provenance)");
        default:
            try sink.AppendConstAscii("");
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmParamAbiAttributes(ParamAbiFacts facts, mut borrow OwnedAscii sink)
{
    try EmitLlvmCaptureAttribute(facts, sink);
    if (facts.ReadOnly)
    {
        try sink.AppendConstAscii(" readonly");
    }

    if (facts.WriteOnly)
    {
        try sink.AppendConstAscii(" writeonly");
    }

    if (facts.Writable)
    {
        try sink.AppendConstAscii(" writable");
    }

    if (facts.InitializesBytes > 0)
    {
        try sink.AppendConstAscii(" initializes((0, ");
        try sink.AppendU64((u64[0 max])facts.InitializesBytes);
        try sink.AppendConstAscii("))");
    }

    if (facts.DeadOnReturn)
    {
        try sink.AppendConstAscii(" dead_on_return");
    }

    return MemoryStatus.Ok;
}

internal struct DistinctStoragePair
{
    u32[0 max] LeftParam;
    u32[0 max] RightParam;

    DistinctStoragePair()
    {
        self.LeftParam = 0;
        self.RightParam = 0;
    }
}

internal fn DistinctStoragePair MakeDistinctStoragePair(u32[0 max] leftParam, u32[0 max] rightParam)
{
    stack mut DistinctStoragePair pair = new();
    if (leftParam <= rightParam)
    {
        pair.LeftParam = leftParam;
        pair.RightParam = rightParam;
    }
    else
    {
        pair.LeftParam = rightParam;
        pair.RightParam = leftParam;
    }

    return pair;
}

internal fn bool DistinctStoragePairExists(borrow IrTable<DistinctStoragePair> facts, u32[0 max] leftParam, u32[0 max] rightParam)
{
    stack DistinctStoragePair canonical = MakeDistinctStoragePair(leftParam, rightParam);
    stack u64[0 2 ** 63 - 1] total = facts.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        stack DistinctStoragePair pair = facts.Get(i);
        if (pair.LeftParam == canonical.LeftParam && pair.RightParam == canonical.RightParam)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn bool AddDistinctStoragePairIfAbsent(mut borrow IrTable<DistinctStoragePair> facts, u32[0 max] leftParam, u32[0 max] rightParam)
{
    if (leftParam == rightParam)
    {
        return true;
    }

    if (DistinctStoragePairExists(facts, leftParam, rightParam))
    {
        return true;
    }

    return facts.Add(MakeDistinctStoragePair(leftParam, rightParam)) != 0;
}

internal fn bool DistinctStorageParamHasPeer(borrow IrTable<DistinctStoragePair> facts, u32[0 max] paramIndex)
{
    stack u64[0 2 ** 63 - 1] total = facts.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        stack DistinctStoragePair pair = facts.Get(i);
        if (pair.LeftParam == paramIndex || pair.RightParam == paramIndex)
        {
            return true;
        }

        i = i + 1;
    }

    return false;
}

internal fn u32[0 max] DistinctStorageMaxParamIndex(borrow IrTable<DistinctStoragePair> facts)
{
    stack u64[0 2 ** 63 - 1] total = facts.Count();
    stack mut u32[0 max] maxParam = 0;
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        stack DistinctStoragePair pair = facts.Get(i);
        if (pair.LeftParam > maxParam)
        {
            maxParam = pair.LeftParam;
        }

        if (pair.RightParam > maxParam)
        {
            maxParam = pair.RightParam;
        }

        i = i + 1;
    }

    return maxParam;
}

internal fn bool AddDistinctStoragePairIfPointerParams(
    borrow IrTable<ParamAbiFacts> paramAbiFacts,
    mut borrow IrTable<DistinctStoragePair> facts,
    u32[0 max] leftParam,
    u32[0 max] rightParam)
{
    if (!ParamAbiFactsIsMemoryBacked(AbiFactAt(paramAbiFacts, leftParam + 1))
        || !ParamAbiFactsIsMemoryBacked(AbiFactAt(paramAbiFacts, rightParam + 1)))
    {
        return true;
    }

    return AddDistinctStoragePairIfAbsent(facts, leftParam, rightParam);
}

internal inline finite law u32[0 max] LlvmScopedNoAliasMetadataBase()
{
    return 200000;
}

internal inline finite law u32[0 max] LlvmScopedNoAliasMetadataBaseForFunction(u32[0 max] functionNumber)
{
    return LlvmScopedNoAliasMetadataBase() + functionNumber * 10000;
}

internal inline finite law u32[0 max] LlvmScopedNoAliasDomainMetadataId(u32[0 max] metadataBase)
{
    return metadataBase;
}

internal inline finite law u32[0 max] LlvmScopedNoAliasScopeMetadataId(u32[0 max] metadataBase, u32[0 max] paramIndex)
{
    return metadataBase + 1 + paramIndex;
}

internal inline finite law u32[0 max] LlvmScopedNoAliasAliasListMetadataId(u32[0 max] metadataBase, u32[0 max] paramIndex)
{
    return metadataBase + 4096 + paramIndex;
}

internal inline finite law u32[0 max] LlvmScopedNoAliasNoAliasListMetadataId(u32[0 max] metadataBase, u32[0 max] paramIndex)
{
    return metadataBase + 8192 + paramIndex;
}

internal fn bool TryResolveMirPointerParamRoot(borrow IrTable<MirInstruction> instrs, u32[0 max] valueIndex, out u32[0 max] paramIndex)
{
    paramIndex = 0;
    stack mut u32[0 max] current = valueIndex;
    stack mut u64[0 2 ** 63 - 1] remaining = instrs.Count();
    while willexit (current != 0 && remaining > 0)
    {
        if (!instrs.Contains(current))
        {
            return false;
        }

        stack MirInstruction instr = instrs.Get(current);
        switch (instr.Opcode())
        {
            case MirOp.Param:
                if (instr.ResultType() != MirType.Ptr || instr.Immediate() < 0)
                {
                    return false;
                }

                paramIndex = (u32[0 max])instr.Immediate();
                return true;
            case MirOp.SliceParamBase:
                if (instr.Immediate() < 0)
                {
                    return false;
                }

                paramIndex = (u32[0 max])instr.Immediate();
                return true;
            case MirOp.PtrOffset:
                current = instr.OperandAIndex();
            case MirOp.PtrIndexOffset:
                current = instr.OperandAIndex();
            case MirOp.PtrIndexOffsetUnbounded:
                current = instr.OperandAIndex();
            default:
                return false;
        }

        remaining = remaining - 1;
    }

    return false;
}

internal fn bool MirInstructionUsesScopedNoAliasMetadata(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<DistinctStoragePair> facts,
    u32[0 max] index)
{
    if (!instrs.Contains(index))
    {
        return false;
    }

    stack MirInstruction instr = instrs.Get(index);
    switch (instr.Opcode())
    {
        case MirOp.LoadPtr:
            stack mut u32[0 max] loadParamIndex = 0;
            return TryResolveMirPointerParamRoot(instrs, instr.OperandAIndex(), loadParamIndex)
                && DistinctStorageParamHasPeer(facts, loadParamIndex);
        case MirOp.StorePtr:
            stack mut u32[0 max] storeParamIndex = 0;
            return TryResolveMirPointerParamRoot(instrs, instr.OperandAIndex(), storeParamIndex)
                && DistinctStorageParamHasPeer(facts, storeParamIndex);
        default:
            return false;
    }
}

internal fn bool MirInstructionRangeUsesScopedNoAliasMetadata(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<DistinctStoragePair> facts,
    u32[0 max] firstInstr,
    u32[0 max] instrCount)
{
    if (facts.Count() == 0)
    {
        return false;
    }

    stack mut u32[0 max] index = firstInstr;
    stack mut u32[0 max] remaining = instrCount;
    while willexit (remaining > 0)
    {
        if (MirInstructionUsesScopedNoAliasMetadata(instrs, facts, index))
        {
            return true;
        }

        index = index + 1;
        remaining = remaining - 1;
    }

    return false;
}

internal fn MemoryStatus EmitLlvmScopedNoAliasAttachmentForPointer(
    borrow IrTable<MirInstruction> instrs,
    borrow IrTable<DistinctStoragePair> facts,
    u32[0 max] metadataBase,
    u32[0 max] pointerValue,
    mut borrow OwnedAscii sink)
{
    stack mut u32[0 max] paramIndex = 0;
    if (!TryResolveMirPointerParamRoot(instrs, pointerValue, paramIndex)
        || !DistinctStorageParamHasPeer(facts, paramIndex))
    {
        return MemoryStatus.Ok;
    }

    try sink.AppendConstAscii(", !alias.scope !");
    try sink.AppendU64((u64[0 max])LlvmScopedNoAliasAliasListMetadataId(metadataBase, paramIndex));
    try sink.AppendConstAscii(", !noalias !");
    try sink.AppendU64((u64[0 max])LlvmScopedNoAliasNoAliasListMetadataId(metadataBase, paramIndex));
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmScopedNoAliasPeerScopes(
    borrow IrTable<DistinctStoragePair> facts,
    u32[0 max] metadataBase,
    u32[0 max] paramIndex,
    mut borrow OwnedAscii sink)
{
    stack mut bool emitted = false;
    stack u64[0 2 ** 63 - 1] total = facts.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        stack DistinctStoragePair pair = facts.Get(i);
        stack mut bool hasPeer = false;
        stack mut u32[0 max] peer = 0;
        if (pair.LeftParam == paramIndex)
        {
            hasPeer = true;
            peer = pair.RightParam;
        }
        else if (pair.RightParam == paramIndex)
        {
            hasPeer = true;
            peer = pair.LeftParam;
        }

        if (hasPeer)
        {
            if (emitted)
            {
                try sink.AppendConstAscii(", ");
            }

            try sink.AppendConstAscii("!");
            try sink.AppendU64((u64[0 max])LlvmScopedNoAliasScopeMetadataId(metadataBase, peer));
            emitted = true;
        }

        i = i + 1;
    }

    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmScopedNoAliasMetadataDefinitions(
    borrow IrTable<DistinctStoragePair> facts,
    u32[0 max] metadataBase,
    mut borrow OwnedAscii sink)
{
    if (facts.Count() == 0)
    {
        return MemoryStatus.Ok;
    }

    stack u32[0 max] domainId = LlvmScopedNoAliasDomainMetadataId(metadataBase);
    try sink.AppendConstAscii("!");
    try sink.AppendU64((u64[0 max])domainId);
    try sink.AppendConstAscii(" = distinct !{!");
    try sink.AppendU64((u64[0 max])domainId);
    try sink.AppendConstAscii(", !\"stark.noalias.mir\"}\n");

    stack u64[0 max] maxParam = (u64[0 max])DistinctStorageMaxParamIndex(facts);
    stack mut u64[0 max] param = 0;
    while willexit (param <= maxParam)
    {
        stack u32[0 max] paramIndex = (u32[0 max])param;
        if (DistinctStorageParamHasPeer(facts, paramIndex))
        {
            stack u32[0 max] scopeId = LlvmScopedNoAliasScopeMetadataId(metadataBase, paramIndex);
            try sink.AppendConstAscii("!");
            try sink.AppendU64((u64[0 max])scopeId);
            try sink.AppendConstAscii(" = distinct !{!");
            try sink.AppendU64((u64[0 max])scopeId);
            try sink.AppendConstAscii(", !");
            try sink.AppendU64((u64[0 max])domainId);
            try sink.AppendConstAscii(", !\"stark.noalias.param.");
            try sink.AppendU64(param);
            try sink.AppendConstAscii("\"}\n");
        }

        param = param + 1;
    }

    param = 0;
    while willexit (param <= maxParam)
    {
        stack u32[0 max] paramIndex = (u32[0 max])param;
        if (DistinctStorageParamHasPeer(facts, paramIndex))
        {
            try sink.AppendConstAscii("!");
            try sink.AppendU64((u64[0 max])LlvmScopedNoAliasAliasListMetadataId(metadataBase, paramIndex));
            try sink.AppendConstAscii(" = !{!");
            try sink.AppendU64((u64[0 max])LlvmScopedNoAliasScopeMetadataId(metadataBase, paramIndex));
            try sink.AppendConstAscii("}\n!");
            try sink.AppendU64((u64[0 max])LlvmScopedNoAliasNoAliasListMetadataId(metadataBase, paramIndex));
            try sink.AppendConstAscii(" = !{");
            try EmitLlvmScopedNoAliasPeerScopes(facts, metadataBase, paramIndex, sink);
            try sink.AppendConstAscii("}\n");
        }

        param = param + 1;
    }

    return MemoryStatus.Ok;
}

internal struct FunctionCallContractFacts
{
    u32[0 max] ParamCount;
    ParamAbiFacts Param0;
    ParamAbiFacts Param1;
    ParamAbiFacts Param2;
    ParamAbiFacts Param3;
    u32[0 max] DistinctCount;
    DistinctStoragePair Distinct0;
    DistinctStoragePair Distinct1;
    DistinctStoragePair Distinct2;
    DistinctStoragePair Distinct3;
    DistinctStoragePair Distinct4;
    DistinctStoragePair Distinct5;

    FunctionCallContractFacts()
    {
        self.ParamCount = 0;
        self.Param0 = new();
        self.Param1 = new();
        self.Param2 = new();
        self.Param3 = new();
        self.DistinctCount = 0;
        self.Distinct0 = new();
        self.Distinct1 = new();
        self.Distinct2 = new();
        self.Distinct3 = new();
        self.Distinct4 = new();
        self.Distinct5 = new();
    }
}

internal fn ParamAbiFacts FunctionCallContractParamAbi(FunctionCallContractFacts facts, u32[0 max] paramIndex)
{
    switch (paramIndex)
    {
        case 0:
            return facts.Param0;
        case 1:
            return facts.Param1;
        case 2:
            return facts.Param2;
        case 3:
            return facts.Param3;
        default:
            stack mut ParamAbiFacts empty = new();
            return empty;
    }
}

internal fn DistinctStoragePair FunctionCallContractDistinctPair(FunctionCallContractFacts facts, u32[0 max] pairIndex)
{
    switch (pairIndex)
    {
        case 0:
            return facts.Distinct0;
        case 1:
            return facts.Distinct1;
        case 2:
            return facts.Distinct2;
        case 3:
            return facts.Distinct3;
        case 4:
            return facts.Distinct4;
        case 5:
            return facts.Distinct5;
        default:
            stack mut DistinctStoragePair empty = new();
            return empty;
    }
}

internal fn FunctionCallContractFacts FunctionCallContractFactsAt(borrow IrTable<FunctionCallContractFacts> facts, u32[0 max] functionId)
{
    stack mut FunctionCallContractFacts empty = new();
    if (functionId != 0 && facts.Contains(functionId))
    {
        return facts.Get(functionId);
    }

    return empty;
}

internal struct LlvmRangeMetadata
{
    MirType Type;
    i64[min max] Lower;
    i64[min max] UpperExclusive;

    LlvmRangeMetadata()
    {
        self.Type = MirType.I64;
        self.Lower = 0;
        self.UpperExclusive = 0;
    }
}

internal fn LlvmRangeMetadata MakeLlvmRangeMetadata(MirType type, ValueFacts facts)
{
    stack mut LlvmRangeMetadata metadata = new();
    metadata.Type = type;
    metadata.Lower = facts.IntegerRangeLower();
    metadata.UpperExclusive = facts.IntegerRangeUpperExclusive();
    return metadata;
}

internal fn bool LlvmRangeMetadataEquals(LlvmRangeMetadata metadata, MirType type, ValueFacts facts)
{
    return metadata.Type == type
        && metadata.Lower == facts.IntegerRangeLower()
        && metadata.UpperExclusive == facts.IntegerRangeUpperExclusive();
}

internal fn MemoryStatus GetOrAddLlvmRangeMetadata(mut borrow IrTable<LlvmRangeMetadata> ranges, MirType type, ValueFacts facts, out u32[0 max] metadataId)
{
    metadataId = 0;
    if (!facts.HasIntegerRange())
    {
        return MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] count = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack LlvmRangeMetadata metadata = ranges.Get(i);
        if (LlvmRangeMetadataEquals(metadata, type, facts))
        {
            metadataId = i - 1;
            return MemoryStatus.Ok;
        }

        i = i + 1;
    }

    stack u32[0 max] added = ranges.Add(MakeLlvmRangeMetadata(type, facts));
    if (added == 0)
    {
        return MemoryStatus.Err(MemoryError.OutOfMemory);
    }

    metadataId = added - 1;
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmRangeMetadataAttachment(MirType type, ValueFacts facts, mut borrow IrTable<LlvmRangeMetadata> ranges, mut borrow OwnedAscii sink)
{
    if (!facts.HasIntegerRange())
    {
        return MemoryStatus.Ok;
    }

    stack mut u32[0 max] metadataId = 0;
    try GetOrAddLlvmRangeMetadata(ranges, type, facts, metadataId);
    try sink.AppendConstAscii(", !range !");
    try sink.AppendU64((u64[0 max])metadataId);
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmRangeMetadataDefinitions(borrow IrTable<LlvmRangeMetadata> ranges, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] count = ranges.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= count)
    {
        stack LlvmRangeMetadata metadata = ranges.Get(i);
        try sink.AppendConstAscii("!");
        try sink.AppendU64((u64[0 max])(i - 1));
        try sink.AppendConstAscii(" = !{");
        try EmitLlvmTypeName(metadata.Type, sink);
        try sink.AppendConstAscii(" ");
        try sink.AppendI64(metadata.Lower);
        try sink.AppendConstAscii(", ");
        try EmitLlvmTypeName(metadata.Type, sink);
        try sink.AppendConstAscii(" ");
        try sink.AppendI64(metadata.UpperExclusive);
        try sink.AppendConstAscii("}\n");
        i = i + 1;
    }

    return MemoryStatus.Ok;
}

internal fn bool FunctionIdIsTailCallable(borrow IrTable<u32[0 max]> funcTailFlags, u32[0 max] functionId)
{
    if (functionId == 0 || !funcTailFlags.Contains(functionId))
    {
        return false;
    }

    return funcTailFlags.Get(functionId) != 0;
}

internal fn MemoryStatus EmitLlvmSeparateStorageAssume(borrow DistinctStoragePair pair, mut borrow OwnedAscii sink)
{
    try sink.AppendConstAscii("  call void @llvm.assume(i1 true) [\"separate_storage\"(ptr %p");
    try sink.AppendU64((u64[0 max])pair.LeftParam);
    try sink.AppendConstAscii(", ptr %p");
    try sink.AppendU64((u64[0 max])pair.RightParam);
    try sink.AppendConstAscii(")]\n");
    return MemoryStatus.Ok;
}

internal fn MemoryStatus EmitLlvmSeparateStorageAssumes(borrow IrTable<DistinctStoragePair> facts, mut borrow OwnedAscii sink)
{
    stack u64[0 2 ** 63 - 1] total = facts.Count();
    stack mut u32[0 max] i = 1;
    while willexit ((u64[0 2 ** 63 - 1])i <= total)
    {
        stack DistinctStoragePair pair = facts.Get(i);
        try EmitLlvmSeparateStorageAssume(pair, sink);
        i = i + 1;
    }

    return MemoryStatus.Ok;
}
