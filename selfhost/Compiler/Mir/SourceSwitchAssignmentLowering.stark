        while willexit (targetPhiIndex < (u64[0 2 ** 63 - 1])targetCount)
        {
            stack u32[0 max] caseAssignedValue = assignedValues.Get((u32[0 max])(caseIndex * (u64[0 2 ** 63 - 1])targetCount + targetPhiIndex + 1));
            stack u32[0 max] incomingTailValue = tailValues.Get((u32[0 max])(targetPhiIndex + 1));
            stack u32[0 max] targetTypeCode = phiTypeCodes.Get((u32[0 max])(targetPhiIndex + 1));
            stack mut MirType phiType = MirType.I64;
            stack mut MirType knownPhiType = MirType.I64;
            if (TryMirTypeForSourceLocalValueTypeCode(targetTypeCode, knownPhiType))
            {
                phiType = knownPhiType;
            }

            stack MirValueId phi = MirPhi2Typed(
                instrs,
                phiType,
                MirValueIdOf(caseAssignedValue),
                MirBlockIdOf(caseBlockIndex),
                MirValueIdOf(incomingTailValue),
                MirBlockIdOf(tailBlock));
            if (newTailValues.Add(phi.Index()) == 0)
            {
                return false;
            }

            targetPhiIndex = targetPhiIndex + 1;
        }

        if (caseIndex == 0)
        {
            stack mut IrTable<u32[0 max]> returnOverrides = new();
            stack mut u64[0 2 ** 63 - 1] p = 0;
            while willexit (p < targetParamStart)
            {
                stack mut u32[0 max] preservedOverride = 0;
                if (baseLocalOverrides.Contains((u32[0 max])(p + 1)))
                {
                    preservedOverride = baseLocalOverrides.Get((u32[0 max])(p + 1));
                }

                if (returnOverrides.Add(preservedOverride) == 0)
                {
                    return false;
                }

                p = p + 1;
            }

            targetPhiIndex = 0;
            while willexit (targetPhiIndex < (u64[0 2 ** 63 - 1])targetCount)
            {
                stack u32[0 max] finalPhiIndex = newTailValues.Get((u32[0 max])(targetPhiIndex + 1));
                if (finalPhis.Add(finalPhiIndex) == 0 || returnOverrides.Add(finalPhiIndex) == 0)
                {
                    return false;
                }

                targetPhiIndex = targetPhiIndex + 1;
            }

            postLocalIndex = 0;
            while willexit (postLocalIndex < postLocalRoots.Count())
            {
                stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
                stack MirValueId postLocalValue = LowerExprNodeWithTypesAndLocals(nodes, postLocalRootNode, instrs, localTypes, returnOverrides);
                if (returnOverrides.Add(postLocalValue.Index()) == 0)
                {
                    return false;
                }

                postLocalIndex = postLocalIndex + 1;
            }

            if (hasTerminalIf)
            {
                terminalIfCondValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.Condition.NodeId, instrs, localTypes, returnOverrides);
                terminalIfMergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

                terminalIfThenFirst = (u32[0 max])instrs.Count() + 1;
                terminalIfThenValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.ThenArm.NodeId, instrs, localTypes, returnOverrides);
                if (terminalBothBool)
                {
                    terminalIfThenValue = MirZExt(instrs, terminalIfThenValue);
                }

                terminalIfThenCount = (u32[0 max])instrs.Count() - (terminalIfThenFirst - 1);

                terminalIfElseFirst = (u32[0 max])instrs.Count() + 1;
                terminalIfElseValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.ElseArm.NodeId, instrs, localTypes, returnOverrides);
                if (terminalBothBool)
                {
                    terminalIfElseValue = MirZExt(instrs, terminalIfElseValue);
                }

                terminalIfElseCount = (u32[0 max])instrs.Count() - (terminalIfElseFirst - 1);
            }
            else
            {
                stack mut MirValueId returnValue = LowerExprNodeWithTypesAndLocals(nodes, returnRootNode, instrs, localTypes, returnOverrides);
                if (rootType == ExprType.BoolType)
                {
                    returnValue = MirZExt(instrs, returnValue);
                }

                finalReturnValue = returnValue;
            }
        }

        stack mut u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);
        if (hasTerminalIf && caseIndex == 0)
        {
            mergeCount = terminalIfMergeCount;
        }

        if (mergeFirsts.Add(mergeFirst) == 0 || mergeCounts.Add(mergeCount) == 0)
        {
            return false;
        }

        tailValues = newTailValues;
        tailBlock = mergeBlockIndex;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] currentBlock = firstBlock + (u32[0 max])caseIndex;
        stack mut u32[0 max] thenBlock = caseBlockBase + (u32[0 max])caseIndex;
        stack u32[0 max] guardBlock = guardBlocks.Get((u32[0 max])(caseIndex + 1));
        if (guardBlock != 0)
        {
            thenBlock = guardBlock;
        }

        stack mut u32[0 max] elseBlock = defaultBlockIndex;
        if (caseIndex + 1 < caseCountWide)
        {
            elseBlock = currentBlock + 1;
        }

        stack u32[0 max] conditionValue = conditionValues.Get((u32[0 max])(caseIndex + 1));
        stack MirBlockId testBlock = MirCondBlock(
            blocks,
            MirValueIdOf(conditionValue),
            MirBlockIdOf(thenBlock),
            MirBlockIdOf(elseBlock));
        caseIndex = caseIndex + 1;
    }

    stack mut u32[0 max] guardValueSlot = 1;
    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] guardBlock = guardBlocks.Get((u32[0 max])(caseIndex + 1));
        if (guardBlock != 0)
        {
            stack mut u32[0 max] elseBlock = defaultBlockIndex;
            if (caseIndex + 1 < caseCountWide)
            {
                elseBlock = firstBlock + (u32[0 max])caseIndex + 1;
            }

            stack u32[0 max] guardValue = guardValues.Get(guardValueSlot);
            stack MirBlockId guardMirBlock = MirCondBlock(
                blocks,
                MirValueIdOf(guardValue),
                MirBlockIdOf(caseBlockBase + (u32[0 max])caseIndex),
                MirBlockIdOf(elseBlock));
            guardValueSlot = guardValueSlot + 1;
        }

        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] mergeBlockIndex = mergeBlockBase + (u32[0 max])caseIndex;
        stack MirBlockId caseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        caseIndex = caseIndex + 1;
    }

    stack MirBlockId defaultBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockBase + caseCount - 1));

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        if (caseIndex == 0)
        {
            if (hasTerminalIf)
            {
                stack MirBlockId mergeBlock = MirCondBlock(
                    blocks,
                    terminalIfCondValue,
                    MirBlockIdOf(terminalThenBlockIndex),
                    MirBlockIdOf(terminalElseBlockIndex));
            }
            else
            {
                stack MirBlockId mergeBlock = MirReturnBlock(blocks, finalReturnValue);
            }
        }
        else
        {
            stack MirBlockId mergeBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockBase + (u32[0 max])caseIndex - 1));
        }

        caseIndex = caseIndex + 1;
    }

    if (hasTerminalIf)
    {
        stack MirBlockId terminalThenBlock = MirReturnBlock(blocks, terminalIfThenValue);
        stack MirBlockId terminalElseBlock = MirReturnBlock(blocks, terminalIfElseValue);
    }

    if (recordRanges)
    {
        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] testFirst = testFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testCount = testCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testRange = ranges.Add(MakeBlockEmit(
                firstBlock + (u32[0 max])caseIndex,
                testFirst,
                testCount));
            caseIndex = caseIndex + 1;
        }

        stack mut u32[0 max] guardRangeSlot = 1;
        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] guardBlock = guardBlocks.Get((u32[0 max])(caseIndex + 1));
            if (guardBlock != 0)
            {
                stack u32[0 max] guardFirst = guardFirsts.Get(guardRangeSlot);
                stack u32[0 max] guardRangeCount = guardCounts.Get(guardRangeSlot);
                stack u32[0 max] guardRange = ranges.Add(MakeBlockEmit(
                    guardBlock,
                    guardFirst,
                    guardRangeCount));
                guardRangeSlot = guardRangeSlot + 1;
            }

            caseIndex = caseIndex + 1;
        }

        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] caseFirst = caseFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRangeCount = caseCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(
                caseBlockBase + (u32[0 max])caseIndex,
                caseFirst,
                caseRangeCount));
            caseIndex = caseIndex + 1;
        }

        stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(defaultBlock.Index(), defaultFirst, defaultCount));

        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] storedIndex = (u32[0 max])(caseCountWide - caseIndex);
            stack u32[0 max] mergeFirst = mergeFirsts.Get(storedIndex);
            stack u32[0 max] mergeCount = mergeCounts.Get(storedIndex);
            stack u32[0 max] mergeRange = ranges.Add(MakeBlockEmit(
                mergeBlockBase + (u32[0 max])caseIndex,
                mergeFirst,
                mergeCount));
            caseIndex = caseIndex + 1;
        }

        if (hasTerminalIf)
        {
            stack u32[0 max] terminalThenRange = ranges.Add(MakeBlockEmit(
                terminalThenBlockIndex,
                terminalIfThenFirst,
                terminalIfThenCount));
            stack u32[0 max] terminalElseRange = ranges.Add(MakeBlockEmit(
                terminalElseBlockIndex,
                terminalIfElseFirst,
                terminalIfElseCount));
        }
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    stack u32[0 max] firstConditionValue = conditionValues.Get(1);
    body.CondValue = firstConditionValue;
    body.ThenValue = finalPhis.Get(1);
    if (hasTerminalIf)
    {
        body.ElseValue = terminalIfCondValue.Index();
    }
    else
    {
        body.ElseValue = finalReturnValue.Index();
    }

    return true;
}

internal fn bool LowerAssignedBooleanSwitchCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<u32[0 max]> caseValues,
    borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    ParsedSwitchAssignmentArm defaultArm,
    u32[0 max] targetCount,
    borrow IrTable<u32[0 max]> postLocalRoots,
    bool hasTerminalIf,
    ParsedIfReturnArms terminalIfArms,
    u32[0 max] returnRootNode,
    borrow IrTable<u32[0 max]> localTypes,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseCountWide > 2 || caseArms.Count() != caseCountWide || targetCount == 0)
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    if (localTypes.Count() < (u64[0 2 ** 63 - 1])(paramCount + targetCount))
    {
        return false;
    }

    stack mut bool hasTrue = false;
    stack mut bool hasFalse = false;
    stack mut ParsedSwitchAssignmentArm trueArm = new();
    stack mut ParsedSwitchAssignmentArm falseArm = new();
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] caseValue = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack ParsedSwitchAssignmentArm caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        if (caseValue == 1)
        {
            hasTrue = true;
            trueArm = caseArm;
        }
        else if (caseValue == 0)
        {
            hasFalse = true;
            falseArm = caseArm;
        }
        else
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    stack bool hasBoth = hasTrue && hasFalse;
    stack mut IrTable<u32[0 max]> phiTypeCodes = new();

    stack mut u64[0 2 ** 63 - 1] targetTypeIndex = 0;
    while willexit (targetTypeIndex < (u64[0 2 ** 63 - 1])targetCount)
    {
        stack u32[0 max] targetTypeCode = localTypes.Get(paramCount + (u32[0 max])targetTypeIndex + 1);
        stack mut ExprType expectedTargetType = ExprType.IntType;
        if (targetTypeCode == SourceLocalTypeCodeBool())
        {
            expectedTargetType = ExprType.BoolType;
        }
        else if (targetTypeCode == SourceLocalTypeCodePointer())
        {
            expectedTargetType = ExprType.PtrType;
        }

        if (TypeOfSwitchAssignmentArm(nodes, defaultArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, (u32[0 max])targetTypeIndex) != expectedTargetType)
        {
            return false;
        }

        if (hasTrue
            && TypeOfSwitchAssignmentArm(nodes, trueArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, (u32[0 max])targetTypeIndex) != expectedTargetType)
        {
            return false;
        }

        if (hasFalse
            && TypeOfSwitchAssignmentArm(nodes, falseArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, (u32[0 max])targetTypeIndex) != expectedTargetType)
        {
            return false;
        }

        if (phiTypeCodes.Add(targetTypeCode) == 0)
        {
            return false;
        }

        targetTypeIndex = targetTypeIndex + 1;
    }

    stack mut ExprType rootType = ExprType.IntType;
    stack mut bool terminalBothBool = false;
    if (hasTerminalIf)
    {
        if (TypeOfNodeWithLocals(nodes, terminalIfArms.Condition.NodeId, localTypes) != ExprType.BoolType)
        {
            return false;
        }

        stack ExprType thenType = TypeOfNodeWithLocals(nodes, terminalIfArms.ThenArm.NodeId, localTypes);
        stack ExprType elseType = TypeOfNodeWithLocals(nodes, terminalIfArms.ElseArm.NodeId, localTypes);
        stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
        terminalBothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
        if (!bothInt && !terminalBothBool)
        {
            return false;
        }

        rootType = thenType;
    }
    else
    {
        rootType = TypeOfNodeWithLocals(nodes, returnRootNode, localTypes);
        if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRootNode, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] firstArmBlockIndex = firstBlock + 1;
    stack u32[0 max] secondArmBlockIndex = firstBlock + 2;
    stack u32[0 max] mergeBlockIndex = firstBlock + 3;
    stack u32[0 max] terminalThenBlockIndex = mergeBlockIndex + 1;
    stack u32[0 max] terminalElseBlockIndex = terminalThenBlockIndex + 1;

    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId scrutineeValue = LowerExprNodeWithTypesAndLocals(nodes, scrutineeNode, instrs, localTypes, noOverrides);
    if (MirValueType(instrs, scrutineeValue.Index()) != MirType.I1)
    {
        return false;
    }

    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);
    stack mut IrTable<u32[0 max]> trueValues = new();
    stack mut IrTable<u32[0 max]> falseValues = new();
    stack mut IrTable<u32[0 max]> caseValuesForMerge = new();
    stack mut IrTable<u32[0 max]> defaultValues = new();
    stack mut u32[0 max] trueFirst = 0;
    stack mut u32[0 max] trueCount = 0;
    stack mut u32[0 max] falseFirst = 0;
    stack mut u32[0 max] falseCount = 0;
    stack mut u32[0 max] caseFirst = 0;
    stack mut u32[0 max] caseInstrCount = 0;
    stack mut u32[0 max] defaultFirst = 0;
    stack mut u32[0 max] defaultCount = 0;
    if (hasBoth)
    {
        trueFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchAssignmentArmValues(nodes, trueArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, trueValues)
            || trueValues.Count() != (u64[0 2 ** 63 - 1])targetCount)
        {
            return false;
        }

        trueCount = (u32[0 max])instrs.Count() - (trueFirst - 1);
        falseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchAssignmentArmValues(nodes, falseArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, falseValues)
            || falseValues.Count() != (u64[0 2 ** 63 - 1])targetCount)
        {
            return false;
        }

        falseCount = (u32[0 max])instrs.Count() - (falseFirst - 1);
    }
    else
    {
        stack mut ParsedSwitchAssignmentArm selectedArm = trueArm;
        if (hasFalse)
        {
            selectedArm = falseArm;
        }

        caseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchAssignmentArmValues(nodes, selectedArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, caseValuesForMerge)
            || caseValuesForMerge.Count() != (u64[0 2 ** 63 - 1])targetCount)
        {
            return false;
        }

        caseInstrCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
        defaultFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchAssignmentArmValues(nodes, defaultArm, armLocalRoots, assignedRoots, assignedTargetOffsets, localTypes, paramCount, instrs, defaultValues)
            || defaultValues.Count() != (u64[0 2 ** 63 - 1])targetCount)
        {
            return false;
        }

        defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);
    }

    stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> returnOverrides = new();
    stack mut u64[0 2 ** 63 - 1] p = 0;
    while willexit (p < paramCount)
    {
        if (returnOverrides.Add(0) == 0)
        {
            return false;
        }

        p = p + 1;
    }

    stack mut IrTable<u32[0 max]> finalPhis = new();
    targetTypeIndex = 0;
    while willexit (targetTypeIndex < (u64[0 2 ** 63 - 1])targetCount)
    {
        stack u32[0 max] targetTypeCode = phiTypeCodes.Get((u32[0 max])(targetTypeIndex + 1));
        stack mut MirType phiType = MirType.I64;
        stack mut MirType knownPhiType = MirType.I64;
        if (TryMirTypeForSourceLocalValueTypeCode(targetTypeCode, knownPhiType))
        {
            phiType = knownPhiType;
        }

        stack mut MirValueId phi = MirValueIdOf(0);
        if (hasBoth)
        {
            stack u32[0 max] trueValueIndex = trueValues.Get((u32[0 max])(targetTypeIndex + 1));
            stack u32[0 max] falseValueIndex = falseValues.Get((u32[0 max])(targetTypeIndex + 1));
            phi = MirPhi2Typed(
                instrs,
                phiType,
                MirValueIdOf(trueValueIndex),
                MirBlockIdOf(firstArmBlockIndex),
                MirValueIdOf(falseValueIndex),
                MirBlockIdOf(secondArmBlockIndex));
        }
        else
        {
            stack u32[0 max] caseValueIndex = caseValuesForMerge.Get((u32[0 max])(targetTypeIndex + 1));
            stack u32[0 max] defaultValueIndex = defaultValues.Get((u32[0 max])(targetTypeIndex + 1));
            phi = MirPhi2Typed(
                instrs,
                phiType,
                MirValueIdOf(caseValueIndex),
                MirBlockIdOf(firstArmBlockIndex),
                MirValueIdOf(defaultValueIndex),
                MirBlockIdOf(secondArmBlockIndex));
        }

        if (finalPhis.Add(phi.Index()) == 0 || returnOverrides.Add(phi.Index()) == 0)
        {
            return false;
        }

        targetTypeIndex = targetTypeIndex + 1;
    }

    postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack MirValueId postLocalValue = LowerExprNodeWithTypesAndLocals(nodes, postLocalRootNode, instrs, localTypes, returnOverrides);
        if (returnOverrides.Add(postLocalValue.Index()) == 0)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack u32[0 max] firstFinalPhi = finalPhis.Get(1);
    stack mut MirValueId finalReturnValue = MirValueIdOf(firstFinalPhi);
    stack mut MirValueId terminalIfCondValue = MirValueIdOf(firstFinalPhi);
    stack mut MirValueId terminalIfThenValue = MirValueIdOf(firstFinalPhi);
    stack mut MirValueId terminalIfElseValue = MirValueIdOf(firstFinalPhi);
    stack mut u32[0 max] terminalIfMergeCount = 0;
    stack mut u32[0 max] terminalIfThenFirst = 0;
    stack mut u32[0 max] terminalIfThenCount = 0;
    stack mut u32[0 max] terminalIfElseFirst = 0;
    stack mut u32[0 max] terminalIfElseCount = 0;
    if (hasTerminalIf)
    {
        terminalIfCondValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.Condition.NodeId, instrs, localTypes, returnOverrides);
        terminalIfMergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

        terminalIfThenFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfThenValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.ThenArm.NodeId, instrs, localTypes, returnOverrides);
        if (terminalBothBool)
        {
            terminalIfThenValue = MirZExt(instrs, terminalIfThenValue);
        }

        terminalIfThenCount = (u32[0 max])instrs.Count() - (terminalIfThenFirst - 1);

        terminalIfElseFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfElseValue = LowerExprNodeWithTypesAndLocals(nodes, terminalIfArms.ElseArm.NodeId, instrs, localTypes, returnOverrides);
        if (terminalBothBool)
        {
            terminalIfElseValue = MirZExt(instrs, terminalIfElseValue);
        }

        terminalIfElseCount = (u32[0 max])instrs.Count() - (terminalIfElseFirst - 1);
    }
    else
    {
        stack mut MirValueId returnValue = LowerExprNodeWithTypesAndLocals(nodes, returnRootNode, instrs, localTypes, returnOverrides);
        if (rootType == ExprType.BoolType)
        {
            returnValue = MirZExt(instrs, returnValue);
        }

        finalReturnValue = returnValue;
    }

    stack mut u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);
    if (hasTerminalIf)
    {
        mergeCount = terminalIfMergeCount;
    }

    if (hasBoth)
    {
        stack MirBlockId entry = MirCondBlock(
            blocks,
            scrutineeValue,
            MirBlockIdOf(firstArmBlockIndex),
            MirBlockIdOf(secondArmBlockIndex));
        stack MirBlockId trueBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        stack MirBlockId falseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    }
    else
    {
        stack mut MirBlockId thenTarget = MirBlockIdOf(firstArmBlockIndex);
        stack mut MirBlockId elseTarget = MirBlockIdOf(secondArmBlockIndex);
        if (hasFalse)
        {
            thenTarget = MirBlockIdOf(secondArmBlockIndex);
            elseTarget = MirBlockIdOf(firstArmBlockIndex);
        }

        stack MirBlockId entry = MirCondBlock(blocks, scrutineeValue, thenTarget, elseTarget);
        stack MirBlockId caseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        stack MirBlockId defaultBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    }

    if (hasTerminalIf)
    {
        stack MirBlockId mergeBlock = MirCondBlock(
            blocks,
            terminalIfCondValue,
            MirBlockIdOf(terminalThenBlockIndex),
            MirBlockIdOf(terminalElseBlockIndex));
        stack MirBlockId terminalThenBlock = MirReturnBlock(blocks, terminalIfThenValue);
        stack MirBlockId terminalElseBlock = MirReturnBlock(blocks, terminalIfElseValue);
    }
    else
    {
        stack MirBlockId mergeBlock = MirReturnBlock(blocks, finalReturnValue);
    }

    if (recordRanges)
    {
        stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(firstBlock, entryFirst, entryCount));
        if (hasBoth)
        {
            stack u32[0 max] trueRange = ranges.Add(MakeBlockEmit(firstArmBlockIndex, trueFirst, trueCount));
            stack u32[0 max] falseRange = ranges.Add(MakeBlockEmit(secondArmBlockIndex, falseFirst, falseCount));
        }
        else
        {
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(firstArmBlockIndex, caseFirst, caseInstrCount));
            stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(secondArmBlockIndex, defaultFirst, defaultCount));
        }

        stack u32[0 max] mergeRange = ranges.Add(MakeBlockEmit(mergeBlockIndex, mergeFirst, mergeCount));
        if (hasTerminalIf)
        {
            stack u32[0 max] terminalThenRange = ranges.Add(MakeBlockEmit(
                terminalThenBlockIndex,
                terminalIfThenFirst,
                terminalIfThenCount));
            stack u32[0 max] terminalElseRange = ranges.Add(MakeBlockEmit(
                terminalElseBlockIndex,
                terminalIfElseFirst,
                terminalIfElseCount));
        }
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    body.CondValue = scrutineeValue.Index();
    body.ThenValue = finalPhis.Get(1);
    if (hasTerminalIf)
    {
        body.ElseValue = terminalIfCondValue.Index();
    }
    else
    {
        body.ElseValue = finalReturnValue.Index();
    }

    return true;
}

internal fn bool LowerIntegerSwitchFieldAssignmentCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<i64[min max]> caseMaxValues,
    borrow IrTable<ParsedSwitchFieldAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    borrow IrTable<SwitchArenaDynamicReserveStatement> arenaDynamicReserveStatements,
    borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    ParsedSwitchFieldAssignmentArm defaultArm,
    borrow IrTable<u32[0 max]> postLocalRoots,
    bool hasTerminalIf,
    ParsedIfReturnArms terminalIfArms,
    u32[0 max] returnRootNode,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    bool usesArenaFrame,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals,
    out LoweredBody body)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseMaxValues.Count() != caseCountWide || caseArms.Count() != caseCountWide)
    {
        return false;
    }

    stack ExprType scrutineeType = TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes);
    if (scrutineeType != ExprType.IntType && scrutineeType != ExprType.EnumType)
    {
        return false;
    }

    stack mut ExprType rootType = ExprType.IntType;
    stack mut bool terminalBothBool = false;
    if (hasTerminalIf)
    {
        if (TypeOfNodeWithLocals(nodes, terminalIfArms.Condition.NodeId, localTypes) != ExprType.BoolType)
        {
            return false;
        }

        stack ExprType thenType = TypeOfNodeWithLocals(nodes, terminalIfArms.ThenArm.NodeId, localTypes);
        stack ExprType elseType = TypeOfNodeWithLocals(nodes, terminalIfArms.ElseArm.NodeId, localTypes);
        stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
        terminalBothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
        if (!bothInt && !terminalBothBool)
        {
            return false;
        }

        rootType = thenType;
    }
    else
    {
        rootType = TypeOfNodeWithLocals(nodes, returnRootNode, localTypes);
        if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRootNode, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack u32[0 max] caseCount = (u32[0 max])caseCountWide;
    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] caseBlockBase = firstBlock + caseCount;
    stack u32[0 max] defaultBlockIndex = caseBlockBase + caseCount;
    stack u32[0 max] mergeBlockIndex = defaultBlockIndex + 1;
    stack u32[0 max] terminalThenBlockIndex = mergeBlockIndex + 1;
    stack u32[0 max] terminalElseBlockIndex = terminalThenBlockIndex + 1;

    stack mut IrTable<u32[0 max]> testFirsts = new();
    stack mut IrTable<u32[0 max]> testCounts = new();
    stack mut IrTable<u32[0 max]> conditionValues = new();
    stack mut IrTable<u32[0 max]> caseFirsts = new();
    stack mut IrTable<u32[0 max]> caseCounts = new();

    stack MirValueId scrutineeValue = LowerExprNodeWithCallContext(nodes, scrutineeNode, instrs, localTypes, baseLocalOverrides, functionCallContractFacts, sliceArgumentLocals);
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack mut u32[0 max] testFirst = (u32[0 max])instrs.Count() + 1;
        if (caseIndex == 0)
        {
            testFirst = entryFirst;
        }

        stack i64[min max] caseMin = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack i64[min max] caseMax = caseMaxValues.Get((u32[0 max])(caseIndex + 1));
        stack MirValueId condition = LowerIntegerSwitchCaseCondition(instrs, scrutineeValue, caseMin, caseMax);
        stack u32[0 max] testCount = (u32[0 max])instrs.Count() - (testFirst - 1);
        if (testFirsts.Add(testFirst) == 0
            || testCounts.Add(testCount) == 0
            || conditionValues.Add(condition.Index()) == 0)
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack ParsedSwitchFieldAssignmentArm caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        stack u32[0 max] caseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, caseArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, arenaDynamicReserveStatements, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        stack u32[0 max] caseInstrCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
        if (caseFirsts.Add(caseFirst) == 0
            || caseCounts.Add(caseInstrCount) == 0)
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    stack u32[0 max] defaultFirst = (u32[0 max])instrs.Count() + 1;
    if (!LowerSwitchFieldAssignmentArmStores(nodes, defaultArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, arenaDynamicReserveStatements, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
    {
        return false;
    }

    stack u32[0 max] defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);

    stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> returnOverrides = new();
    stack mut u64[0 2 ** 63 - 1] overrideIndex = 0;
    while willexit (overrideIndex < baseLocalOverrides.Count())
    {
        stack u32[0 max] overrideValue = baseLocalOverrides.Get((u32[0 max])(overrideIndex + 1));
        if (returnOverrides.Add(overrideValue) == 0)
        {
            return false;
        }

        overrideIndex = overrideIndex + 1;
    }

    postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack MirValueId postLocalValue = LowerExprNodeWithCallContext(nodes, postLocalRootNode, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (returnOverrides.Add(postLocalValue.Index()) == 0)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack mut MirValueId finalReturnValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfCondValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfThenValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfElseValue = MirValueIdOf(0);
    stack mut u32[0 max] terminalIfMergeCount = 0;
    stack mut u32[0 max] terminalIfThenFirst = 0;
    stack mut u32[0 max] terminalIfThenCount = 0;
    stack mut u32[0 max] terminalIfElseFirst = 0;
    stack mut u32[0 max] terminalIfElseCount = 0;
    if (hasTerminalIf)
    {
        terminalIfCondValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.Condition.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        terminalIfMergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

        terminalIfThenFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfThenValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.ThenArm.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (terminalBothBool)
        {
            terminalIfThenValue = MirZExt(instrs, terminalIfThenValue);
        }

        if (usesArenaFrame)
        {
            stack MirValueId terminalThenLeave = MirArenaFrameLeave(instrs);
        }

        terminalIfThenCount = (u32[0 max])instrs.Count() - (terminalIfThenFirst - 1);

        terminalIfElseFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfElseValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.ElseArm.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (terminalBothBool)
        {
            terminalIfElseValue = MirZExt(instrs, terminalIfElseValue);
        }

        if (usesArenaFrame)
        {
            stack MirValueId terminalElseLeave = MirArenaFrameLeave(instrs);
        }

        terminalIfElseCount = (u32[0 max])instrs.Count() - (terminalIfElseFirst - 1);
    }
    else
    {
        stack mut MirValueId returnValue = LowerExprNodeWithCallContext(nodes, returnRootNode, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (rootType == ExprType.BoolType)
        {
            returnValue = MirZExt(instrs, returnValue);
        }

        if (usesArenaFrame)
        {
            stack MirValueId leave = MirArenaFrameLeave(instrs);
        }

        finalReturnValue = returnValue;
    }

    stack mut u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);
    if (hasTerminalIf)
    {
        mergeCount = terminalIfMergeCount;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] currentBlock = firstBlock + (u32[0 max])caseIndex;
        stack u32[0 max] thenBlock = caseBlockBase + (u32[0 max])caseIndex;
        stack mut u32[0 max] elseBlock = defaultBlockIndex;
        if (caseIndex + 1 < caseCountWide)
        {
            elseBlock = currentBlock + 1;
        }

        stack u32[0 max] conditionValue = conditionValues.Get((u32[0 max])(caseIndex + 1));
        stack MirBlockId testBlock = MirCondBlock(
            blocks,
            MirValueIdOf(conditionValue),
            MirBlockIdOf(thenBlock),
            MirBlockIdOf(elseBlock));
        caseIndex = caseIndex + 1;
    }

    caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack MirBlockId caseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        caseIndex = caseIndex + 1;
    }

    stack MirBlockId defaultBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    if (hasTerminalIf)
    {
        stack MirBlockId mergeBlock = MirCondBlock(
            blocks,
            terminalIfCondValue,
            MirBlockIdOf(terminalThenBlockIndex),
            MirBlockIdOf(terminalElseBlockIndex));
        stack MirBlockId terminalThenBlock = MirReturnBlock(blocks, terminalIfThenValue);
        stack MirBlockId terminalElseBlock = MirReturnBlock(blocks, terminalIfElseValue);
    }
    else
    {
        stack MirBlockId mergeBlock = MirReturnBlock(blocks, finalReturnValue);
    }

    if (recordRanges)
    {
        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] testFirst = testFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testCount = testCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] testRange = ranges.Add(MakeBlockEmit(
                firstBlock + (u32[0 max])caseIndex,
                testFirst,
                testCount));
            caseIndex = caseIndex + 1;
        }

        caseIndex = 0;
        while willexit (caseIndex < caseCountWide)
        {
            stack u32[0 max] caseFirst = caseFirsts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRangeCount = caseCounts.Get((u32[0 max])(caseIndex + 1));
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(
                caseBlockBase + (u32[0 max])caseIndex,
                caseFirst,
                caseRangeCount));
            caseIndex = caseIndex + 1;
        }

        stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(defaultBlockIndex, defaultFirst, defaultCount));
        stack u32[0 max] mergeRange = ranges.Add(MakeBlockEmit(mergeBlockIndex, mergeFirst, mergeCount));
        if (hasTerminalIf)
        {
            stack u32[0 max] terminalThenRange = ranges.Add(MakeBlockEmit(
                terminalThenBlockIndex,
                terminalIfThenFirst,
                terminalIfThenCount));
            stack u32[0 max] terminalElseRange = ranges.Add(MakeBlockEmit(
                terminalElseBlockIndex,
                terminalIfElseFirst,
                terminalIfElseCount));
        }
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    stack u32[0 max] firstConditionValue = conditionValues.Get(1);
    body.CondValue = firstConditionValue;
    body.ThenValue = finalReturnValue.Index();
    if (hasTerminalIf)
    {
        body.ElseValue = terminalIfCondValue.Index();
    }
    else
    {
        body.ElseValue = finalReturnValue.Index();
    }

    return true;
}

internal fn bool LowerBooleanSwitchFieldAssignmentCasesToBlocks(
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<u32[0 max]> caseValues,
    borrow IrTable<ParsedSwitchFieldAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<ScalarStorageAssignment> scalarAssignments,
    borrow IrTable<EnumStorageAssignment> enumAssignments,
    borrow IrTable<ConstructedObjectFieldAssignment> fieldAssignments,
    borrow IrTable<SwitchArenaDynamicReserveStatement> arenaDynamicReserveStatements,
    borrow IrTable<SourceStorageMutationStatement> storageMutationStatements,
    ParsedSwitchFieldAssignmentArm defaultArm,
    borrow IrTable<u32[0 max]> postLocalRoots,
    bool hasTerminalIf,
    ParsedIfReturnArms terminalIfArms,
    u32[0 max] returnRootNode,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    u32[0 max] paramCount,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    bool usesArenaFrame,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<SourceSliceArgumentLocal> sliceArgumentLocals,
    out LoweredBody body)
    where overlap(functionCallContractFacts, sliceArgumentLocals)
{
    body = new();
    stack u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (caseCountWide == 0 || caseCountWide > 2 || caseArms.Count() != caseCountWide)
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, scrutineeNode, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack mut bool hasTrue = false;
    stack mut bool hasFalse = false;
    stack mut ParsedSwitchFieldAssignmentArm trueArm = new();
    stack mut ParsedSwitchFieldAssignmentArm falseArm = new();
    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < caseCountWide)
    {
        stack u32[0 max] caseValue = caseValues.Get((u32[0 max])(caseIndex + 1));
        stack ParsedSwitchFieldAssignmentArm caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        if (caseValue == 1)
        {
            hasTrue = true;
            trueArm = caseArm;
        }
        else if (caseValue == 0)
        {
            hasFalse = true;
            falseArm = caseArm;
        }
        else
        {
            return false;
        }

        caseIndex = caseIndex + 1;
    }

    stack bool hasBoth = hasTrue && hasFalse;
    stack mut ExprType rootType = ExprType.IntType;
    stack mut bool terminalBothBool = false;
    if (hasTerminalIf)
    {
        if (TypeOfNodeWithLocals(nodes, terminalIfArms.Condition.NodeId, localTypes) != ExprType.BoolType)
        {
            return false;
        }

        stack ExprType thenType = TypeOfNodeWithLocals(nodes, terminalIfArms.ThenArm.NodeId, localTypes);
        stack ExprType elseType = TypeOfNodeWithLocals(nodes, terminalIfArms.ElseArm.NodeId, localTypes);
        stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
        terminalBothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType;
        if (!bothInt && !terminalBothBool)
        {
            return false;
        }

        rootType = thenType;
    }
    else
    {
        rootType = TypeOfNodeWithLocals(nodes, returnRootNode, localTypes);
        if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
        {
            return false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack ExprType postLocalType = TypeOfNodeWithLocals(nodes, postLocalRootNode, localTypes);
        if (postLocalType == ExprType.ErrorType || postLocalType == ExprType.PtrType)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] firstArmBlockIndex = firstBlock + 1;
    stack u32[0 max] secondArmBlockIndex = firstBlock + 2;
    stack u32[0 max] mergeBlockIndex = firstBlock + 3;
    stack u32[0 max] terminalThenBlockIndex = mergeBlockIndex + 1;
    stack u32[0 max] terminalElseBlockIndex = terminalThenBlockIndex + 1;

    stack MirValueId scrutineeValue = LowerExprNodeWithCallContext(nodes, scrutineeNode, instrs, localTypes, baseLocalOverrides, functionCallContractFacts, sliceArgumentLocals);
    if (MirValueType(instrs, scrutineeValue.Index()) != MirType.I1)
    {
        return false;
    }

    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);
    stack mut u32[0 max] trueFirst = 0;
    stack mut u32[0 max] trueCount = 0;
    stack mut u32[0 max] falseFirst = 0;
    stack mut u32[0 max] falseCount = 0;
    stack mut u32[0 max] caseFirst = 0;
    stack mut u32[0 max] caseInstrCount = 0;
    stack mut u32[0 max] defaultFirst = 0;
    stack mut u32[0 max] defaultCount = 0;
    if (hasBoth)
    {
        trueFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, trueArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, arenaDynamicReserveStatements, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        trueCount = (u32[0 max])instrs.Count() - (trueFirst - 1);
        falseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, falseArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, arenaDynamicReserveStatements, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        falseCount = (u32[0 max])instrs.Count() - (falseFirst - 1);
    }
    else
    {
        stack mut ParsedSwitchFieldAssignmentArm selectedArm = trueArm;
        if (hasFalse)
        {
            selectedArm = falseArm;
        }

        caseFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, selectedArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, arenaDynamicReserveStatements, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        caseInstrCount = (u32[0 max])instrs.Count() - (caseFirst - 1);
        defaultFirst = (u32[0 max])instrs.Count() + 1;
        if (!LowerSwitchFieldAssignmentArmStores(nodes, defaultArm, armLocalRoots, scalarAssignments, enumAssignments, fieldAssignments, arenaDynamicReserveStatements, storageMutationStatements, localTypes, baseLocalOverrides, instrs, functionCallContractFacts, sliceArgumentLocals))
        {
            return false;
        }

        defaultCount = (u32[0 max])instrs.Count() - (defaultFirst - 1);
    }

    stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> returnOverrides = new();
    stack mut u64[0 2 ** 63 - 1] overrideIndex = 0;
    while willexit (overrideIndex < baseLocalOverrides.Count())
    {
        stack u32[0 max] overrideValue = baseLocalOverrides.Get((u32[0 max])(overrideIndex + 1));
        if (returnOverrides.Add(overrideValue) == 0)
        {
            return false;
        }

        overrideIndex = overrideIndex + 1;
    }

    postLocalIndex = 0;
    while willexit (postLocalIndex < postLocalRoots.Count())
    {
        stack u32[0 max] postLocalRootNode = postLocalRoots.Get((u32[0 max])(postLocalIndex + 1));
        stack MirValueId postLocalValue = LowerExprNodeWithCallContext(nodes, postLocalRootNode, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (returnOverrides.Add(postLocalValue.Index()) == 0)
        {
            return false;
        }

        postLocalIndex = postLocalIndex + 1;
    }

    stack mut MirValueId finalReturnValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfCondValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfThenValue = MirValueIdOf(0);
    stack mut MirValueId terminalIfElseValue = MirValueIdOf(0);
    stack mut u32[0 max] terminalIfMergeCount = 0;
    stack mut u32[0 max] terminalIfThenFirst = 0;
    stack mut u32[0 max] terminalIfThenCount = 0;
    stack mut u32[0 max] terminalIfElseFirst = 0;
    stack mut u32[0 max] terminalIfElseCount = 0;
    if (hasTerminalIf)
    {
        terminalIfCondValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.Condition.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        terminalIfMergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

        terminalIfThenFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfThenValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.ThenArm.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (terminalBothBool)
        {
            terminalIfThenValue = MirZExt(instrs, terminalIfThenValue);
        }

        if (usesArenaFrame)
        {
            stack MirValueId terminalThenLeave = MirArenaFrameLeave(instrs);
        }

        terminalIfThenCount = (u32[0 max])instrs.Count() - (terminalIfThenFirst - 1);

        terminalIfElseFirst = (u32[0 max])instrs.Count() + 1;
        terminalIfElseValue = LowerExprNodeWithCallContext(nodes, terminalIfArms.ElseArm.NodeId, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (terminalBothBool)
        {
            terminalIfElseValue = MirZExt(instrs, terminalIfElseValue);
        }

        if (usesArenaFrame)
        {
            stack MirValueId terminalElseLeave = MirArenaFrameLeave(instrs);
        }

        terminalIfElseCount = (u32[0 max])instrs.Count() - (terminalIfElseFirst - 1);
    }
    else
    {
        stack mut MirValueId returnValue = LowerExprNodeWithCallContext(nodes, returnRootNode, instrs, localTypes, returnOverrides, functionCallContractFacts, sliceArgumentLocals);
        if (rootType == ExprType.BoolType)
        {
            returnValue = MirZExt(instrs, returnValue);
        }

        if (usesArenaFrame)
        {
            stack MirValueId leave = MirArenaFrameLeave(instrs);
        }

        finalReturnValue = returnValue;
    }

    stack mut u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);
    if (hasTerminalIf)
    {
        mergeCount = terminalIfMergeCount;
    }

    if (hasBoth)
    {
        stack MirBlockId entry = MirCondBlock(
            blocks,
            scrutineeValue,
            MirBlockIdOf(firstArmBlockIndex),
            MirBlockIdOf(secondArmBlockIndex));
        stack MirBlockId trueBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        stack MirBlockId falseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    }
    else
    {
        stack mut MirBlockId thenTarget = MirBlockIdOf(firstArmBlockIndex);
        stack mut MirBlockId elseTarget = MirBlockIdOf(secondArmBlockIndex);
        if (hasFalse)
        {
            thenTarget = MirBlockIdOf(secondArmBlockIndex);
            elseTarget = MirBlockIdOf(firstArmBlockIndex);
        }

        stack MirBlockId entry = MirCondBlock(blocks, scrutineeValue, thenTarget, elseTarget);
        stack MirBlockId caseBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
        stack MirBlockId defaultBlock = MirBranchBlock(blocks, MirBlockIdOf(mergeBlockIndex));
    }

    if (hasTerminalIf)
    {
        stack MirBlockId mergeBlock = MirCondBlock(
            blocks,
            terminalIfCondValue,
            MirBlockIdOf(terminalThenBlockIndex),
            MirBlockIdOf(terminalElseBlockIndex));
        stack MirBlockId terminalThenBlock = MirReturnBlock(blocks, terminalIfThenValue);
        stack MirBlockId terminalElseBlock = MirReturnBlock(blocks, terminalIfElseValue);
    }
    else
    {
        stack MirBlockId mergeBlock = MirReturnBlock(blocks, finalReturnValue);
    }

    if (recordRanges)
    {
        stack u32[0 max] entryRange = ranges.Add(MakeBlockEmit(firstBlock, entryFirst, entryCount));
        if (hasBoth)
        {
            stack u32[0 max] trueRange = ranges.Add(MakeBlockEmit(firstArmBlockIndex, trueFirst, trueCount));
            stack u32[0 max] falseRange = ranges.Add(MakeBlockEmit(secondArmBlockIndex, falseFirst, falseCount));
        }
        else
        {
            stack u32[0 max] caseRange = ranges.Add(MakeBlockEmit(firstArmBlockIndex, caseFirst, caseInstrCount));
            stack u32[0 max] defaultRange = ranges.Add(MakeBlockEmit(secondArmBlockIndex, defaultFirst, defaultCount));
        }

        stack u32[0 max] mergeRange = ranges.Add(MakeBlockEmit(mergeBlockIndex, mergeFirst, mergeCount));
        if (hasTerminalIf)
        {
            stack u32[0 max] terminalThenRange = ranges.Add(MakeBlockEmit(
                terminalThenBlockIndex,
                terminalIfThenFirst,
                terminalIfThenCount));
            stack u32[0 max] terminalElseRange = ranges.Add(MakeBlockEmit(
                terminalElseBlockIndex,
                terminalIfElseFirst,
                terminalIfElseCount));
        }
    }

    body.Ok = true;
    body.EntryBlock = firstBlock;
    body.ParamCount = paramCount;
    body.CondValue = scrutineeValue.Index();
    body.ThenValue = finalReturnValue.Index();
    if (hasTerminalIf)
    {
        body.ElseValue = terminalIfCondValue.Index();
    }
    else
    {
        body.ElseValue = finalReturnValue.Index();
    }

    return true;
}
