            fieldCaptureMemberFactRows,
            arm.CaptureStart,
            arm.CaptureCount,
            paramCount,
            baseLocalOverrides,
            instrs,
            localOverrides))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack MirValueId localValue = LowerExprNodeWithTypesAndLocals(nodes, localRoot, instrs, armLocalTypes, localOverrides);
        if (localOverrides.Add(localValue.Index()) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut IrTable<u32[0 max]> sourceOrderValues = new();
    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] assignedRoot = assignedRoots.Get(rootSlot);
        stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, assignedRoot, instrs, armLocalTypes, localOverrides);
        if (sourceOrderValues.Add(value.Index()) == 0)
        {
            return false;
        }

        assignedIndex = assignedIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] targetIndex = 0;
    while willexit (targetIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack mut bool foundTarget = false;
        assignedIndex = 0;
        while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
        {
            stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
            stack u32[0 max] currentTargetOffset = assignedTargetOffsets.Get(rootSlot);
            if (currentTargetOffset == (u32[0 max])targetIndex)
            {
                if (foundTarget)
                {
                    return false;
                }

                stack u32[0 max] sourceOrderValue = sourceOrderValues.Get((u32[0 max])(assignedIndex + 1));
                if (values.Add(sourceOrderValue) == 0)
                {
                    return false;
                }

                foundTarget = true;
            }

            assignedIndex = assignedIndex + 1;
        }

        if (!foundTarget)
        {
            return false;
        }

        targetIndex = targetIndex + 1;
    }

    return true;
}

internal fn bool LowerAssignedIntegerSwitchCasesToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ExprNode> nodes,
    u32[0 max] scrutineeNode,
    borrow IrTable<i64[min max]> caseValues,
    borrow IrTable<i64[min max]> caseMaxValues,
    bool useEnumPayloadPatterns,
    bool useFixedArrayListPatterns,
    bool useStructAggregatePatterns,
    u32[0 max] fixedArrayParamIndex,
    ParamAbiFacts fixedArrayFacts,
    bool useFixedArrayStorageLocal,
    FixedArrayStorageLocal fixedArrayLocal,
    u32[0 max] structParamIndex,
    u32[0 max] structTypeToken,
    u32[0 max] structBaseByteOffset,
    bool useStructValueParam,
    ParamAbiFacts structValueFacts,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    u32[0 max] ownerDeclarationIndex,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<u32[0 max]> casePayloadPatternStarts,
    borrow IrTable<u32[0 max]> casePayloadPatternCounts,
    borrow IrTable<u32[0 max]> casePayloadNestedStarts,
    borrow IrTable<u32[0 max]> casePayloadNestedCounts,
    borrow IrTable<u32[0 max]> payloadPatternVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternOrdinals,
    borrow IrTable<u32[0 max]> payloadPatternTypeCodes,
    borrow IrTable<u32[0 max]> payloadPatternKinds,
    borrow IrTable<i64[min max]> payloadPatternMinValues,
    borrow IrTable<i64[min max]> payloadPatternMaxValues,
    borrow IrTable<u32[0 max]> payloadCaptureVariantOrdinals,
    borrow IrTable<u32[0 max]> payloadCaptureOrdinals,
    borrow IrTable<u32[0 max]> payloadCaptureTypeCodes,
    borrow IrTable<u32[0 max]> nestedVariantOrdinals,
    borrow IrTable<u32[0 max]> nestedPayloadOrdinals,
    borrow IrTable<u32[0 max]> nestedKinds,
    borrow IrTable<u32[0 max]> nestedAggregateDescriptorRows,
    borrow IrTable<u32[0 max]> nestedListDescriptorRows,
    borrow IrTable<u32[0 max]> caseListPatternStarts,
    borrow IrTable<u32[0 max]> caseListPatternCounts,
    borrow IrTable<u32[0 max]> elementPatternIndices,
    borrow IrTable<u32[0 max]> elementPatternTypeCodes,
    borrow IrTable<u32[0 max]> elementPatternKinds,
    borrow IrTable<i64[min max]> elementPatternMinValues,
    borrow IrTable<i64[min max]> elementPatternMaxValues,
    borrow IrTable<u32[0 max]> caseElementCaptureStarts,
    borrow IrTable<u32[0 max]> caseElementCaptureCounts,
    borrow IrTable<u32[0 max]> elementCaptureIndices,
    borrow IrTable<u32[0 max]> elementCaptureTypeCodes,
    borrow IrTable<u32[0 max]> structFieldPatternIndices,
    borrow IrTable<u32[0 max]> caseGuardNodes,
    borrow IrTable<u32[0 max]> structFieldPatternOffsets,
    borrow IrTable<u32[0 max]> structFieldPatternAlignments,
    borrow IrTable<u32[0 max]> structFieldPatternTypeCodes,
    borrow IrTable<u32[0 max]> structFieldPatternMemberFactRows,
    borrow IrTable<u32[0 max]> structFieldPatternKinds,
    borrow IrTable<i64[min max]> structFieldPatternMinValues,
    borrow IrTable<i64[min max]> structFieldPatternMaxValues,
    borrow IrTable<u32[0 max]> caseStructFieldCaptureStarts,
    borrow IrTable<u32[0 max]> caseStructFieldCaptureCounts,
    borrow IrTable<u32[0 max]> caseStructNestedStarts,
    borrow IrTable<u32[0 max]> caseStructNestedCounts,
    borrow IrTable<u32[0 max]> structFieldCaptureIndices,
    borrow IrTable<u32[0 max]> structFieldCaptureOffsets,
    borrow IrTable<u32[0 max]> structFieldCaptureAlignments,
    borrow IrTable<u32[0 max]> structFieldCaptureTypeCodes,
    borrow IrTable<u32[0 max]> structFieldCaptureMemberFactRows,
    borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    ParsedSwitchAssignmentArm defaultArm,
    u32[0 max] targetCount,
    borrow IrTable<u32[0 max]> postLocalRoots,
    bool hasTerminalIf,
    ParsedIfReturnArms terminalIfArms,
    u32[0 max] returnRootNode,
    borrow IrTable<u32[0 max]> localTypes,
    u32[0 max] paramCount,
    u32[0 max] targetParamStart,
    u32[0 max] entryFirst,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    stack mut u64[0 2 ** 63 - 1] caseCountWide = caseValues.Count();
    if (useFixedArrayListPatterns || useStructAggregatePatterns)
    {
        caseCountWide = caseArms.Count();
    }

    if (caseCountWide == 0 || caseArms.Count() != caseCountWide || targetCount == 0)
    {
        return false;
    }

    if (!useFixedArrayListPatterns && !useStructAggregatePatterns && caseMaxValues.Count() != caseCountWide)
    {
        return false;
    }

    if ((useEnumPayloadPatterns && (useFixedArrayListPatterns || useStructAggregatePatterns))
        || (useFixedArrayListPatterns && useStructAggregatePatterns)
        || (useStructValueParam && !useStructAggregatePatterns)
        || (useEnumPayloadPatterns
        && (casePayloadPatternStarts.Count() != caseCountWide
            || casePayloadPatternCounts.Count() != caseCountWide
            || casePayloadNestedStarts.Count() != caseCountWide
            || casePayloadNestedCounts.Count() != caseCountWide)))
    {
        return false;
    }

    if (useFixedArrayListPatterns
        && (caseListPatternStarts.Count() != caseCountWide
            || caseListPatternCounts.Count() != caseCountWide
            || caseElementCaptureStarts.Count() != caseCountWide
            || caseElementCaptureCounts.Count() != caseCountWide
            || !fixedArrayFacts.IsFixedArray
            || fixedArrayFacts.FixedArrayLength == 0
            || fixedArrayFacts.FixedArrayFieldTypeCode == SourceResolvedFieldTypeCodeInvalid()
            || !localTypes.Contains(fixedArrayParamIndex + 1)))
    {
        return false;
    }

    if (useFixedArrayListPatterns)
    {
        if (useFixedArrayStorageLocal)
        {
            if (fixedArrayLocal.ParamIndex != fixedArrayParamIndex
                || fixedArrayLocal.ArrayLength != fixedArrayFacts.FixedArrayLength
                || fixedArrayLocal.ElementSize != fixedArrayFacts.FixedArrayElementSize
                || fixedArrayLocal.Alignment != fixedArrayFacts.FixedArrayAlignment
                || fixedArrayLocal.FieldTypeCode != fixedArrayFacts.FixedArrayFieldTypeCode
                || localTypes.Get(fixedArrayParamIndex + 1) != SourceLocalTypeCodeNonValue()
                || !baseLocalOverrides.Contains(fixedArrayParamIndex + 1)
                || baseLocalOverrides.Get(fixedArrayParamIndex + 1) == 0)
            {
                return false;
            }
        }
        else if (localTypes.Get(fixedArrayParamIndex + 1) != SourceLocalTypeCodeFixedArrayParam())
        {
            return false;
        }
    }

    if (useStructAggregatePatterns
        && (caseListPatternStarts.Count() != caseCountWide
            || caseListPatternCounts.Count() != caseCountWide
            || caseStructFieldCaptureStarts.Count() != caseCountWide
            || caseStructFieldCaptureCounts.Count() != caseCountWide
            || caseStructNestedStarts.Count() != caseCountWide
            || caseStructNestedCounts.Count() != caseCountWide
            || caseGuardNodes.Count() != caseCountWide
            || !localTypes.Contains(structParamIndex + 1)))
    {
        return false;
    }

    if (useFixedArrayListPatterns
        && caseGuardNodes.Count() != 0
        && caseGuardNodes.Count() != caseCountWide)
    {
        return false;
    }

    if (!useFixedArrayListPatterns && !useStructAggregatePatterns && caseGuardNodes.Count() != 0)
    {
        return false;
    }

    if (useStructAggregatePatterns)
    {
        if (useStructValueParam)
        {
            if (!structValueFacts.IsStructValue
                || structValueFacts.StructValueFieldCount == 0
                || structValueFacts.StructValueFieldCount > StructValueShapeMaxFields())
            {
                return false;
            }
        }
        else if (localTypes.Get(structParamIndex + 1) != SourceLocalTypeCodeNonValue()
            || !baseLocalOverrides.Contains(structParamIndex + 1)
            || baseLocalOverrides.Get(structParamIndex + 1) == 0)
        {
            return false;
        }
    }

    stack mut IrTable<SourceSwitchListPatternDescriptor> listPatternDescriptors = new();
    stack mut IrTable<u32[0 max]> caseListPatternDescriptorRows = new();
    if (useFixedArrayListPatterns
        && !TryBuildSourceSwitchListPatternCaseDescriptors(
            fixedArrayFacts,
            caseListPatternStarts,
            caseListPatternCounts,
            listPatternDescriptors,
            caseListPatternDescriptorRows))
    {
        return false;
    }

    stack mut IrTable<SourceSwitchAggregatePatternDescriptor> aggregatePatternDescriptors = new();
    stack mut IrTable<u32[0 max]> caseAggregatePatternDescriptorRows = new();
    if (useStructAggregatePatterns
        && !TryBuildSourceSwitchAggregatePatternCaseDescriptors(
            structTypeToken,
            0,
            caseListPatternStarts,
            caseListPatternCounts,
            aggregatePatternDescriptors,
            caseAggregatePatternDescriptorRows))
    {
        return false;
    }

    if (useEnumPayloadPatterns
        && !TryBuildSourceSwitchEnumAggregatePatternCaseDescriptors(
            moduleFacts,
            ownerDeclarationIndex,
            caseValues,
            casePayloadPatternStarts,
            casePayloadPatternCounts,
            payloadPatternVariantOrdinals,
            aggregatePatternDescriptors,
            caseAggregatePatternDescriptorRows))
    {
        return false;
    }

    if (useFixedArrayListPatterns
        && !SourceSwitchListPatternDescriptorRowsAreValid(
            listPatternDescriptors,
            caseListPatternDescriptorRows,
            elementPatternIndices,
            elementPatternTypeCodes,
            elementPatternKinds,
            elementPatternMinValues,
            elementPatternMaxValues))
    {
        return false;
    }

    if (useStructAggregatePatterns)
    {
        if (useStructValueParam)
        {
            if (!SourceSwitchStructValuePatternDescriptorRowsAreValidForSource(
                    stream,
                    source,
                    structTypeToken,
                    structValueFacts,
                    aggregatePatternDescriptors,
                    caseAggregatePatternDescriptorRows,
                    structFieldPatternIndices,
                    structFieldPatternTypeCodes,
                    structFieldPatternMemberFactRows,
                    structFieldPatternKinds,
                    structFieldPatternMinValues,
                    structFieldPatternMaxValues))
            {
                return false;
            }
        }
        else if (!SourceSwitchStructStoragePatternDescriptorRowsAreValid(
                structTypeToken,
                structBaseByteOffset,
                aggregatePatternDescriptors,
                caseAggregatePatternDescriptorRows,
                structFieldPatternIndices,
                structFieldPatternOffsets,
                structFieldPatternAlignments,
                structFieldPatternTypeCodes,
                structFieldPatternMemberFactRows,
                structFieldPatternKinds,
                structFieldPatternMinValues,
                structFieldPatternMaxValues))
        {
            return false;
        }
    }

    if (useEnumPayloadPatterns
        && !SourceSwitchEnumPayloadPatternDescriptorRowsAreValid(
            moduleFacts,
            ownerDeclarationIndex,
            caseValues,
            aggregatePatternDescriptors,
            caseAggregatePatternDescriptorRows,
            payloadPatternVariantOrdinals,
            payloadPatternOrdinals,
            payloadPatternTypeCodes,
            payloadPatternKinds,
            payloadPatternMinValues,
            payloadPatternMaxValues))
    {
        return false;
    }

    if (useFixedArrayListPatterns)
    {
        stack mut IrTable<SourceSwitchAggregatePatternDescriptor> noNestedAggregateDescriptorsForListPreflight = new();
        stack mut IrTable<SourceSwitchPatternDecisionNode> decisionNodesForListPreflight = new();
        stack mut IrTable<SourceSwitchPatternDecisionMember> decisionMembersForListPreflight = new();
        stack mut IrTable<u32[0 max]> caseDecisionMemberStartsForListPreflight = new();
        stack mut IrTable<u32[0 max]> caseDecisionMemberCountsForListPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedListStartsForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedListCountsForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedListElementIndicesForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedListKindsForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedListAggregateDescriptorRowsForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedListDescriptorRowsForPreflight = new();
        if (!TryBuildSourceSwitchListPatternDecisionPreflightRows(
                nodes,
                noNestedAggregateDescriptorsForListPreflight,
                listPatternDescriptors,
                caseListPatternDescriptorRows,
                caseGuardNodes,
                caseElementCaptureStarts,
                caseElementCaptureCounts,
                noNestedListStartsForPreflight,
                noNestedListCountsForPreflight,
                elementPatternIndices,
                elementPatternTypeCodes,
                elementPatternKinds,
                elementPatternMinValues,
                elementPatternMaxValues,
                elementCaptureIndices,
                elementCaptureTypeCodes,
                noNestedListElementIndicesForPreflight,
                noNestedListKindsForPreflight,
                noNestedListAggregateDescriptorRowsForPreflight,
                noNestedListDescriptorRowsForPreflight,
                decisionNodesForListPreflight,
                decisionMembersForListPreflight,
                caseDecisionMemberStartsForListPreflight,
                caseDecisionMemberCountsForListPreflight))
        {
            return false;
        }
    }

    if (useStructAggregatePatterns)
    {
        stack mut IrTable<SourceSwitchListPatternDescriptor> listPatternDescriptorsForStructPreflight = new();
        stack mut IrTable<SourceSwitchPatternDecisionNode> decisionNodesForStructPreflight = new();
        stack mut IrTable<SourceSwitchPatternDecisionMember> decisionMembersForStructPreflight = new();
        stack mut IrTable<u32[0 max]> caseDecisionMemberStartsForStructPreflight = new();
        stack mut IrTable<u32[0 max]> caseDecisionMemberCountsForStructPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedStructFieldStartsForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedStructFieldCountsForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedStructFieldIndicesForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedStructFieldKindsForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedStructAggregateDescriptorRowsForPreflight = new();
        stack mut IrTable<u32[0 max]> noNestedStructListDescriptorRowsForPreflight = new();
        if (!TryBuildSourceSwitchStructAggregatePatternDecisionPreflightRows(
                stream,
                source,
                moduleFacts,
                nodes,
                aggregatePatternDescriptors,
                listPatternDescriptorsForStructPreflight,
                caseAggregatePatternDescriptorRows,
                caseGuardNodes,
                caseStructFieldCaptureStarts,
                caseStructFieldCaptureCounts,
                caseStructNestedStarts,
                caseStructNestedCounts,
                structFieldPatternIndices,
                structFieldPatternTypeCodes,
                structFieldPatternKinds,
                structFieldPatternMinValues,
                structFieldPatternMaxValues,
                structFieldCaptureIndices,
                structFieldCaptureTypeCodes,
                noNestedStructFieldIndicesForPreflight,
                noNestedStructFieldKindsForPreflight,
                noNestedStructAggregateDescriptorRowsForPreflight,
                noNestedStructListDescriptorRowsForPreflight,
                decisionNodesForStructPreflight,
                decisionMembersForStructPreflight,
                caseDecisionMemberStartsForStructPreflight,
                caseDecisionMemberCountsForStructPreflight))
        {
            return false;
        }

    }

    if (useEnumPayloadPatterns)
    {
        stack mut IrTable<u32[0 max]> casePayloadCaptureStartsForPreflight = new();
        stack mut IrTable<u32[0 max]> casePayloadCaptureCountsForPreflight = new();
        stack mut u64[0 2 ** 63 - 1] preflightCaseIndex = 0;
        while willexit (preflightCaseIndex < caseCountWide)
        {
            stack ParsedSwitchAssignmentArm caseArm = caseArms.Get((u32[0 max])(preflightCaseIndex + 1));
            if (casePayloadCaptureStartsForPreflight.Add(caseArm.CaptureStart) == 0
                || casePayloadCaptureCountsForPreflight.Add(caseArm.CaptureCount) == 0)
            {
                return false;
            }

            preflightCaseIndex = preflightCaseIndex + 1;
        }

