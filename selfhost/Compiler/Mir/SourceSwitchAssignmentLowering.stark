internal fn bool BuildSwitchAssignmentArmLocalTypesWithCaptures(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] paramCount,
    mut borrow IrTable<u32[0 max]> armLocalTypes)
{
    stack mut u64[0 2 ** 63 - 1] paramIndex = 0;
    while willexit (paramIndex < paramCount)
    {
        stack mut u32[0 max] typeCode = 0;
        stack u32[0 max] typeSlot = (u32[0 max])(paramIndex + 1);
        if (baseLocalTypes.Contains(typeSlot))
        {
            typeCode = baseLocalTypes.Get(typeSlot);
        }

        if (armLocalTypes.Add(typeCode) == 0)
        {
            return false;
        }

        paramIndex = paramIndex + 1;
    }

    stack mut u32[0 max] captureIndex = 0;
    while willexit (captureIndex < arm.CaptureCount)
    {
        stack u32[0 max] captureRow = arm.CaptureStart + captureIndex;
        if (!captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] captureTypeCode = captureTypeCodes.Get(captureRow);
        stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeNonValue();
        if (!TrySourceSwitchCaptureLocalTypeCode(captureTypeCode, localTypeCode)
            || (localTypeCode != SourceLocalTypeCodeBool()
                && !SourceLocalTypeCodeIsIntegerValue(localTypeCode)
                && localTypeCode != SourceLocalTypeCodeFixedArrayParam()
                && !SourceLocalTypeCodeIsStructValue(localTypeCode)))
        {
            return false;
        }

        if (armLocalTypes.Add(localTypeCode) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack ExprType localType = TypeOfNodeWithLocals(nodes, localRoot, armLocalTypes);
        if (localType == ExprType.ErrorType || localType == ExprType.PtrType)
        {
            return false;
        }

        stack u32[0 max] localTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, localRoot, armLocalTypes);

        if (armLocalTypes.Add(localTypeCode) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    return true;
}

internal fn bool BuildSwitchAssignmentArmLocalTypes(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] paramCount,
    mut borrow IrTable<u32[0 max]> armLocalTypes)
{
    stack mut IrTable<u32[0 max]> noCaptureTypeCodes = new();
    return BuildSwitchAssignmentArmLocalTypesWithCaptures(
        nodes,
        arm,
        armLocalRoots,
        noCaptureTypeCodes,
        baseLocalTypes,
        paramCount,
        armLocalTypes);
}

internal fn ExprType TypeOfSwitchAssignmentArmWithCaptures(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] paramCount,
    u32[0 max] targetOffset)
{
    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    if (!BuildSwitchAssignmentArmLocalTypesWithCaptures(nodes, arm, armLocalRoots, captureTypeCodes, baseLocalTypes, paramCount, armLocalTypes))
    {
        return ExprType.ErrorType;
    }

    if (targetOffset >= arm.AssignedRootCount)
    {
        return ExprType.ErrorType;
    }

    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return ExprType.ErrorType;
        }

        stack u32[0 max] currentTargetOffset = assignedTargetOffsets.Get(rootSlot);
        if (currentTargetOffset == targetOffset)
        {
            stack u32[0 max] rootNode = assignedRoots.Get(rootSlot);
            return TypeOfNodeWithLocals(nodes, rootNode, armLocalTypes);
        }

        assignedIndex = assignedIndex + 1;
    }

    return ExprType.ErrorType;
}

internal fn ExprType TypeOfSwitchAssignmentArm(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] paramCount,
    u32[0 max] targetOffset)
{
    stack mut IrTable<u32[0 max]> noCaptureTypeCodes = new();
    return TypeOfSwitchAssignmentArmWithCaptures(
        nodes,
        arm,
        armLocalRoots,
        noCaptureTypeCodes,
        assignedRoots,
        assignedTargetOffsets,
        baseLocalTypes,
        paramCount,
        targetOffset);
}

internal fn bool TryGetSwitchAssignmentArmAssignedRoot(
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    u32[0 max] targetOffset,
    out u32[0 max] rootNode)
{
    rootNode = 0;
    if (targetOffset >= arm.AssignedRootCount)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] assignedTargetOffset = assignedTargetOffsets.Get(rootSlot);
        if (assignedTargetOffset == targetOffset)
        {
            rootNode = assignedRoots.Get(rootSlot);
            return true;
        }

        assignedIndex = assignedIndex + 1;
    }

    return false;
}

internal fn bool UpdateSwitchAssignmentTargetRawPointerFacts(
    mut borrow IrTable<ParamName> params,
    borrow IrTable<ExprNode> nodes,
    borrow IrTable<ParsedSwitchAssignmentArm> caseArms,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    ParsedSwitchAssignmentArm defaultArm,
    u32[0 max] targetParamIndex,
    u32[0 max] targetOffset,
    u32[0 max] caseCount)
{
    stack mut u32[0 max] defaultRoot = 0;
    if (!TryGetSwitchAssignmentArmAssignedRoot(defaultArm, assignedRoots, assignedTargetOffsets, targetOffset, defaultRoot))
    {
        return false;
    }

    stack mut bool mergedMutable = false;
    stack mut u32[0 max] mergedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] mergedElementSize = 0;
    stack mut u32[0 max] mergedElementAlignment = 0;
    stack mut bool mergedNestedMutable = false;
    stack mut u32[0 max] mergedNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] mergedNestedElementSize = 0;
    stack mut u32[0 max] mergedNestedElementAlignment = 0;
    stack mut bool defaultMutable = false;
    stack mut u32[0 max] defaultFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] defaultElementSize = 0;
    stack mut u32[0 max] defaultElementAlignment = 0;
    stack mut bool defaultNestedMutable = false;
    stack mut u32[0 max] defaultNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
    stack mut u32[0 max] defaultNestedElementSize = 0;
    stack mut u32[0 max] defaultNestedElementAlignment = 0;
    stack bool defaultIsRawPointer = TryGetRawPointerFactsForNodeWithNested(
        nodes,
        params,
        defaultRoot,
        defaultMutable,
        defaultFieldTypeCode,
        defaultElementSize,
        defaultElementAlignment,
        defaultNestedMutable,
        defaultNestedFieldTypeCode,
        defaultNestedElementSize,
        defaultNestedElementAlignment);

    stack mut bool anyRawPointer = defaultIsRawPointer;
    stack mut bool hasElementCount = false;
    stack mut bool elementCountIsParam = false;
    stack mut u32[0 max] elementCountLiteral = 0;
    stack mut u32[0 max] elementCountParamIndex = 0;
    if (defaultIsRawPointer)
    {
        mergedMutable = defaultMutable;
        mergedFieldTypeCode = defaultFieldTypeCode;
        mergedElementSize = defaultElementSize;
        mergedElementAlignment = defaultElementAlignment;
        mergedNestedMutable = defaultNestedMutable;
        mergedNestedFieldTypeCode = defaultNestedFieldTypeCode;
        mergedNestedElementSize = defaultNestedElementSize;
        mergedNestedElementAlignment = defaultNestedElementAlignment;
        if (!TryGetRawPointerElementCountFactsForNameNode(
            nodes,
            params,
            defaultRoot,
            hasElementCount,
            elementCountIsParam,
            elementCountLiteral,
            elementCountParamIndex))
        {
            hasElementCount = false;
        }
    }

    stack mut u64[0 2 ** 63 - 1] caseIndex = 0;
    while willexit (caseIndex < (u64[0 2 ** 63 - 1])caseCount)
    {
        if (!caseArms.Contains((u32[0 max])(caseIndex + 1)))
        {
            return false;
        }

        stack ParsedSwitchAssignmentArm caseArm = caseArms.Get((u32[0 max])(caseIndex + 1));
        stack mut u32[0 max] caseRoot = 0;
        if (!TryGetSwitchAssignmentArmAssignedRoot(caseArm, assignedRoots, assignedTargetOffsets, targetOffset, caseRoot))
        {
            return false;
        }

        stack mut bool caseMutable = false;
        stack mut u32[0 max] caseFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] caseElementSize = 0;
        stack mut u32[0 max] caseElementAlignment = 0;
        stack mut bool caseNestedMutable = false;
        stack mut u32[0 max] caseNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
        stack mut u32[0 max] caseNestedElementSize = 0;
        stack mut u32[0 max] caseNestedElementAlignment = 0;
        stack bool caseIsRawPointer = TryGetRawPointerFactsForNodeWithNested(
            nodes,
            params,
            caseRoot,
            caseMutable,
            caseFieldTypeCode,
            caseElementSize,
            caseElementAlignment,
            caseNestedMutable,
            caseNestedFieldTypeCode,
            caseNestedElementSize,
            caseNestedElementAlignment);
        anyRawPointer = anyRawPointer || caseIsRawPointer;
        if (defaultIsRawPointer || caseIsRawPointer)
        {
            if (!defaultIsRawPointer
                || !caseIsRawPointer
                || mergedMutable != caseMutable
                || mergedFieldTypeCode != caseFieldTypeCode
                || mergedElementSize != caseElementSize
                || mergedElementAlignment != caseElementAlignment
                || mergedNestedMutable != caseNestedMutable
                || mergedNestedFieldTypeCode != caseNestedFieldTypeCode
                || mergedNestedElementSize != caseNestedElementSize
                || mergedNestedElementAlignment != caseNestedElementAlignment)
            {
                return false;
            }

            stack mut bool caseHasElementCount = false;
            stack mut bool caseElementCountIsParam = false;
            stack mut u32[0 max] caseElementCountLiteral = 0;
            stack mut u32[0 max] caseElementCountParamIndex = 0;
            if (!TryGetRawPointerElementCountFactsForNameNode(
                nodes,
                params,
                caseRoot,
                caseHasElementCount,
                caseElementCountIsParam,
                caseElementCountLiteral,
                caseElementCountParamIndex)
                || !RawPointerElementCountFactsEqual(
                    hasElementCount,
                    elementCountIsParam,
                    elementCountLiteral,
                    elementCountParamIndex,
                    caseHasElementCount,
                    caseElementCountIsParam,
                    caseElementCountLiteral,
                    caseElementCountParamIndex))
            {
                hasElementCount = false;
            }
        }

        caseIndex = caseIndex + 1;
    }

    if (!anyRawPointer)
    {
        return true;
    }

    return ReplaceParamRawPointerFactsWithNested(
        params,
        targetParamIndex,
        mergedMutable,
        mergedFieldTypeCode,
        mergedElementSize,
        mergedElementAlignment,
        hasElementCount,
        elementCountIsParam,
        elementCountLiteral,
        elementCountParamIndex,
        mergedNestedMutable,
        mergedNestedFieldTypeCode,
        mergedNestedElementSize,
        mergedNestedElementAlignment);
}

internal fn bool ValidateSwitchAssignmentArmModuleCallsWithCaptures(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] paramCount,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<DistinctStoragePair> callerDistinctStorageFacts)
{
    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    if (!BuildSwitchAssignmentArmLocalTypesWithCaptures(nodes, arm, armLocalRoots, captureTypeCodes, baseLocalTypes, paramCount, armLocalTypes))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        if (!ValidateModuleCallsForRoot(nodes, localRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, callerDistinctStorageFacts))
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] assignedRoot = assignedRoots.Get(rootSlot);
        if (!ValidateModuleCallsForRoot(nodes, assignedRoot, funcParamCounts, functionCallContractFacts, armLocalTypes, callerDistinctStorageFacts))
        {
            return false;
        }

        assignedIndex = assignedIndex + 1;
    }

    return true;
}

internal fn bool ValidateSwitchAssignmentArmModuleCalls(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> baseLocalTypes,
    u32[0 max] paramCount,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<DistinctStoragePair> callerDistinctStorageFacts)
{
    stack mut IrTable<u32[0 max]> noCaptureTypeCodes = new();
    return ValidateSwitchAssignmentArmModuleCallsWithCaptures(
        nodes,
        arm,
        armLocalRoots,
        noCaptureTypeCodes,
        assignedRoots,
        assignedTargetOffsets,
        baseLocalTypes,
        paramCount,
        funcParamCounts,
        functionCallContractFacts,
        callerDistinctStorageFacts);
}

internal fn bool LowerSwitchAssignmentArmValuesWithCaptures(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    MirValueId enumValue,
    u32[0 max] ownerDeclarationIndex,
    borrow IrTable<u32[0 max]> captureVariantOrdinals,
    borrow IrTable<u32[0 max]> capturePayloadOrdinals,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> localTypes,
    u32[0 max] paramCount,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<u32[0 max]> values)
{
    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] paramIndex = 0;
    while willexit (paramIndex < paramCount)
    {
        if (localOverrides.Add(0) == 0)
        {
            return false;
        }

        paramIndex = paramIndex + 1;
    }

    stack TypeId ownerType = TypeIdOf(ownerDeclarationIndex + 1);
    stack mut u32[0 max] captureIndex = 0;
    while willexit (captureIndex < arm.CaptureCount)
    {
        stack u32[0 max] captureRow = arm.CaptureStart + captureIndex;
        if (!captureVariantOrdinals.Contains(captureRow)
            || !capturePayloadOrdinals.Contains(captureRow)
            || !captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] payloadTypeCode = captureTypeCodes.Get(captureRow);
        stack MirType payloadType = MirTypeForResolvedFieldTypeCode(payloadTypeCode);
        stack u32[0 max] variantOrdinal = captureVariantOrdinals.Get(captureRow);
        stack u32[0 max] payloadOrdinal = capturePayloadOrdinals.Get(captureRow);
        stack MirValueId captureValue = MirEnumPayloadExtract(
            instrs,
            ownerType,
            variantOrdinal,
            payloadOrdinal,
            enumValue,
            payloadType);
        if (localOverrides.Add(captureValue.Index()) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack MirValueId localValue = LowerExprNodeWithTypesAndLocals(nodes, localRoot, instrs, localTypes, localOverrides);
        if (localOverrides.Add(localValue.Index()) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut IrTable<u32[0 max]> sourceOrderValues = new();
    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] assignedRoot = assignedRoots.Get(rootSlot);
        stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, assignedRoot, instrs, localTypes, localOverrides);
        if (sourceOrderValues.Add(value.Index()) == 0)
        {
            return false;
        }

        assignedIndex = assignedIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] targetIndex = 0;
    while willexit (targetIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack mut bool foundTarget = false;
        assignedIndex = 0;
        while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
        {
            stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
            stack u32[0 max] currentTargetOffset = assignedTargetOffsets.Get(rootSlot);
            if (currentTargetOffset == (u32[0 max])targetIndex)
            {
                if (foundTarget)
                {
                    return false;
                }

                stack u32[0 max] sourceOrderValue = sourceOrderValues.Get((u32[0 max])(assignedIndex + 1));
                if (values.Add(sourceOrderValue) == 0)
                {
                    return false;
                }

                foundTarget = true;
            }

            assignedIndex = assignedIndex + 1;
        }

        if (!foundTarget)
        {
            return false;
        }

        targetIndex = targetIndex + 1;
    }

    return true;
}

internal fn bool LowerSwitchAssignmentArmValues(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> localTypes,
    u32[0 max] paramCount,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<u32[0 max]> values)
{
    stack mut IrTable<u32[0 max]> noCaptureVariantOrdinals = new();
    stack mut IrTable<u32[0 max]> noCapturePayloadOrdinals = new();
    stack mut IrTable<u32[0 max]> noCaptureTypeCodes = new();
    return LowerSwitchAssignmentArmValuesWithCaptures(
        nodes,
        arm,
        armLocalRoots,
        MirValueIdOf(0),
        0,
        noCaptureVariantOrdinals,
        noCapturePayloadOrdinals,
        noCaptureTypeCodes,
        assignedRoots,
        assignedTargetOffsets,
        localTypes,
        paramCount,
        instrs,
        values);
}

internal fn bool BuildFixedArraySwitchAssignmentCaptureLocalOverrides(
    u32[0 max] fixedArrayParamIndex,
    ParamAbiFacts fixedArrayFacts,
    bool useFixedArrayStorageLocal,
    FixedArrayStorageLocal fixedArrayLocal,
    borrow IrTable<u32[0 max]> captureElementIndices,
    borrow IrTable<u32[0 max]> captureTypeCodes,
    u32[0 max] captureStart,
    u32[0 max] captureCount,
    u32[0 max] baseLocalCount,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<u32[0 max]> armLocalOverrides)
{
    stack mut u64[0 2 ** 63 - 1] baseIndex = 0;
    while willexit (baseIndex < (u64[0 2 ** 63 - 1])baseLocalCount)
    {
        stack u32[0 max] localSlot = (u32[0 max])(baseIndex + 1);
        stack mut u32[0 max] overrideValue = 0;
        if (baseLocalOverrides.Contains(localSlot))
        {
            overrideValue = baseLocalOverrides.Get(localSlot);
        }

        if (armLocalOverrides.Add(overrideValue) == 0)
        {
            return false;
        }

        baseIndex = baseIndex + 1;
    }

    if (!fixedArrayFacts.IsFixedArray
        || fixedArrayFacts.FixedArrayLength == 0
        || fixedArrayFacts.FixedArrayFieldTypeCode == SourceResolvedFieldTypeCodeInvalid())
    {
        return false;
    }

    stack mut u32[0 max] storageValue = 0;
    if (useFixedArrayStorageLocal)
    {
        if (fixedArrayParamIndex >= baseLocalCount
            || fixedArrayLocal.ParamIndex != fixedArrayParamIndex
            || fixedArrayLocal.ArrayLength != fixedArrayFacts.FixedArrayLength
            || fixedArrayLocal.ElementSize != fixedArrayFacts.FixedArrayElementSize
            || fixedArrayLocal.Alignment != fixedArrayFacts.FixedArrayAlignment
            || fixedArrayLocal.FieldTypeCode != fixedArrayFacts.FixedArrayFieldTypeCode
            || !baseLocalOverrides.Contains(fixedArrayLocal.ParamIndex + 1))
        {
            return false;
        }

        storageValue = baseLocalOverrides.Get(fixedArrayLocal.ParamIndex + 1);
        if (storageValue == 0)
        {
            return false;
        }
    }

    stack mut u32[0 max] captureIndex = 0;
    while willexit (captureIndex < captureCount)
    {
        stack u32[0 max] captureRow = captureStart + captureIndex;
        if (!captureElementIndices.Contains(captureRow)
            || !captureTypeCodes.Contains(captureRow))
        {
            return false;
        }

        stack u32[0 max] elementIndex = captureElementIndices.Get(captureRow);
        stack u32[0 max] elementTypeCode = captureTypeCodes.Get(captureRow);
        if (elementIndex >= fixedArrayFacts.FixedArrayLength
            || elementTypeCode != fixedArrayFacts.FixedArrayFieldTypeCode)
        {
            return false;
        }

        stack mut MirValueId captureValue = MirValueIdOf(0);
        if (useFixedArrayStorageLocal)
        {
            if (elementIndex > 4294967295 / fixedArrayLocal.ElementSize)
            {
                return false;
            }

            stack u32[0 max] elementByteOffset = elementIndex * fixedArrayLocal.ElementSize;
            if (fixedArrayLocal.BaseByteOffset > 4294967295 - elementByteOffset)
            {
                return false;
            }

            stack u32[0 max] byteOffset = fixedArrayLocal.BaseByteOffset + elementByteOffset;
            stack MirValueId elementPointer = MirPtrOffset(
                instrs,
                MirValueIdOf(storageValue),
                byteOffset,
                fixedArrayLocal.Alignment);
            if (fixedArrayLocal.HasDeclaredElementRange)
            {
                captureValue = MirLoadPtrAlignedTypedWithDeclaredRange(
                    instrs,
                    fixedArrayLocal.ElementType,
                    elementPointer,
                    fixedArrayLocal.Alignment,
                    fixedArrayLocal.DeclaredElementRangeLower,
                    fixedArrayLocal.DeclaredElementRangeUpperExclusive);
            }
            else
            {
                captureValue = MirLoadPtrAlignedTyped(
                    instrs,
                    fixedArrayLocal.ElementType,
                    elementPointer,
                    fixedArrayLocal.Alignment);
            }
        }
        else
        {
            captureValue = MirFixedArrayParamElement(
                instrs,
                fixedArrayParamIndex,
                elementIndex,
                fixedArrayFacts.FixedArrayLength,
                fixedArrayFacts.FixedArrayElementType);
        }

        if (armLocalOverrides.Add(captureValue.Index()) == 0)
        {
            return false;
        }

        captureIndex = captureIndex + 1;
    }

    return true;
}

internal fn bool LowerFixedArrayListSwitchAssignmentArmValuesWithCaptures(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    u32[0 max] fixedArrayParamIndex,
    ParamAbiFacts fixedArrayFacts,
    bool useFixedArrayStorageLocal,
    FixedArrayStorageLocal fixedArrayLocal,
    borrow IrTable<u32[0 max]> elementCaptureIndices,
    borrow IrTable<u32[0 max]> elementCaptureTypeCodes,
    borrow IrTable<u32[0 max]> assignedRoots,
    borrow IrTable<u32[0 max]> assignedTargetOffsets,
    borrow IrTable<u32[0 max]> localTypes,
    borrow IrTable<u32[0 max]> baseLocalOverrides,
    u32[0 max] paramCount,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<u32[0 max]> values)
{
    stack mut IrTable<u32[0 max]> armLocalTypes = new();
    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!BuildSwitchAssignmentArmLocalTypesWithCaptures(
            nodes,
            arm,
            armLocalRoots,
            elementCaptureTypeCodes,
            localTypes,
            paramCount,
            armLocalTypes)
        || !BuildFixedArraySwitchAssignmentCaptureLocalOverrides(
            fixedArrayParamIndex,
            fixedArrayFacts,
            useFixedArrayStorageLocal,
            fixedArrayLocal,
            elementCaptureIndices,
            elementCaptureTypeCodes,
            arm.CaptureStart,
            arm.CaptureCount,
            paramCount,
            baseLocalOverrides,
            instrs,
            localOverrides))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] localIndex = 0;
    while willexit (localIndex < (u64[0 2 ** 63 - 1])arm.LocalRootCount)
    {
        stack u32[0 max] rootSlot = arm.LocalRootStart + (u32[0 max])localIndex;
        if (!armLocalRoots.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] localRoot = armLocalRoots.Get(rootSlot);
        stack MirValueId localValue = LowerExprNodeWithTypesAndLocals(nodes, localRoot, instrs, armLocalTypes, localOverrides);
        if (localOverrides.Add(localValue.Index()) == 0)
        {
            return false;
        }

        localIndex = localIndex + 1;
    }

    stack mut IrTable<u32[0 max]> sourceOrderValues = new();
    stack mut u64[0 2 ** 63 - 1] assignedIndex = 0;
    while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
        if (!assignedRoots.Contains(rootSlot) || !assignedTargetOffsets.Contains(rootSlot))
        {
            return false;
        }

        stack u32[0 max] assignedRoot = assignedRoots.Get(rootSlot);
        stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, assignedRoot, instrs, armLocalTypes, localOverrides);
        if (sourceOrderValues.Add(value.Index()) == 0)
        {
            return false;
        }

        assignedIndex = assignedIndex + 1;
    }

    stack mut u64[0 2 ** 63 - 1] targetIndex = 0;
    while willexit (targetIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
    {
        stack mut bool foundTarget = false;
        assignedIndex = 0;
        while willexit (assignedIndex < (u64[0 2 ** 63 - 1])arm.AssignedRootCount)
        {
            stack u32[0 max] rootSlot = arm.AssignedRootStart + (u32[0 max])assignedIndex;
            stack u32[0 max] currentTargetOffset = assignedTargetOffsets.Get(rootSlot);
            if (currentTargetOffset == (u32[0 max])targetIndex)
            {
                if (foundTarget)
                {
                    return false;
                }

                stack u32[0 max] sourceOrderValue = sourceOrderValues.Get((u32[0 max])(assignedIndex + 1));
                if (values.Add(sourceOrderValue) == 0)
                {
                    return false;
                }

                foundTarget = true;
            }

            assignedIndex = assignedIndex + 1;
        }

        if (!foundTarget)
        {
            return false;
        }

        targetIndex = targetIndex + 1;
    }

    return true;
}

internal fn bool LowerStructAggregateSwitchAssignmentArmValuesWithCaptures(
    borrow IrTable<ExprNode> nodes,
    ParsedSwitchAssignmentArm arm,
    borrow IrTable<u32[0 max]> armLocalRoots,
    u32[0 max] structParamIndex,
    u32[0 max] structBaseByteOffset,
    bool useStructValueParam,
    ParamAbiFacts structValueFacts,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<u32[0 max]> fieldCaptureIndices,
    borrow IrTable<u32[0 max]> fieldCaptureOffsets,
    borrow IrTable<u32[0 max]> fieldCaptureAlignments,
    borrow IrTable<u32[0 max]> fieldCaptureTypeCodes,
