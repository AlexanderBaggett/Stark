                    stack mut ValueFacts parsedFacts = new();
                    if (TryBuildSourceValueFactsForNode(nodes, scalarExpr.NodeId, sourceValueFacts, parsedFacts))
                    {
                        scalarFacts = parsedFacts;
                    }
                }

                if (sourceValueFacts.Add(scalarFacts) == 0)
                {
                    return result;
                }

                stack mut ScalarStorageLocal scalarLocal = new();
                scalarLocal.Start = nameStart;
                scalarLocal.Length = nameLength;
                scalarLocal.ParamIndex = scalarLocalIndex;
                scalarLocal.StorageValue = scalarStorage.Index();
                scalarLocal.FieldAlignment = scalarAllocationAlign;
                scalarLocal.FieldType = scalarFieldType;
                scalarLocal.Mutable = scalarMutable;
                stack u32[0 max] addedScalarLocal = scalarStorageLocals.Add(scalarLocal);
                if (addedScalarLocal == 0)
