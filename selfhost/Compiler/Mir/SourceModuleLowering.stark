                }

                stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
                stack ExprParseResult enumExpr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, assignToken + 1);
                if (params.Count() != beforeInit || enumExpr.NodeId == 0 || enumExpr.Next != statementEnd)
