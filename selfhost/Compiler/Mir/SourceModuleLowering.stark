                stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
                stack ExprParseResult scalarExpr = ParseConstructedObjectExprWithEnumsIn(stream, source, nodes, params, funcNames, constructedObjectLocals, localTypes, sourceValueFacts, declarations, enumLayouts, assignToken + 1);
                if (params.Count() != beforeInit || scalarExpr.NodeId == 0 || scalarExpr.Next != statementEnd)
