                        return result;
                    }

                    if (!AnnotateCallExpressionResultTypesFromContracts(nodes, functionCallContractFacts))
                    {
                        return result;
                    }

                    stack mut u32[0 max] enumExprOwnerTypeIndex = 0;
                    stack u32[0 max] enumOwnerTypeIndex = enumOwnerDeclarationIndex + 1;
                    if (TypeOfNodeWithLocals(nodes, enumExpr.NodeId, localTypes) != ExprType.EnumType
                        || !TryGetSourceExpressionEnumOwnerTypeIndexForNode(nodes, enumExpr.NodeId, localTypes, enumExprOwnerTypeIndex)
                        || enumExprOwnerTypeIndex != enumOwnerTypeIndex)
                    {
                        return result;
                    }

                    stack MirValueId enumStorage = MirStackAlloc(instrs, enumAllocationSize, enumAllocationAlign);
                    stack bool enumMutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
                    stack u32[0 max] enumLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                    stack u32[0 max] enumLocalOrdinal = localRoots.Add(0);
                    stack u32[0 max] enumLocalType = localTypes.Add(SourceLocalTypeCodeForStoredEnumOwnerDeclarationIndex(enumOwnerDeclarationIndex));
                    stack u32[0 max] enumOverrideValue = localOverrideValues.Add(enumStorage.Index());
                    if (enumLocalOrdinal == 0
                        || enumLocalType == 0
                        || enumOverrideValue == 0
                        || sourceValueFacts.Add(new ValueFacts()) == 0)
                    {
                        return result;
                    }

                    stack mut EnumStorageLocal enumLocal = new();
                    enumLocal.Start = nameStart;
                    enumLocal.Length = nameLength;
                    enumLocal.ParamIndex = enumLocalIndex;
                    enumLocal.StorageValue = enumStorage.Index();
                    enumLocal.FieldAlignment = enumAllocationAlign;
                    enumLocal.OwnerTypeIndex = enumOwnerTypeIndex;
                    enumLocal.Mutable = enumMutable;
                    if (enumStorageLocals.Add(enumLocal) == 0)
                    {
                        return result;
                    }

                    stack mut EnumStorageInitializer enumInitializer = new();
                    enumInitializer.LocalOrdinal = enumLocalOrdinal;
                    enumInitializer.ParamIndex = enumLocalIndex;
                    enumInitializer.FieldAlignment = enumAllocationAlign;
                    enumInitializer.OwnerTypeIndex = enumOwnerTypeIndex;
                    enumInitializer.ExprRoot = enumExpr.NodeId;
                    if (enumStorageInitializers.Add(enumInitializer) == 0)
                    {
                        return result;
                    }

                    cursor = statementEnd + 1;
                    continue;
                }

                stack mut u32[0 max] allocationSize = 0;
                stack mut u32[0 max] allocationAlign = 0;
                if (localStorage == TokenKind.Arena)
                {
                    stack u32[0 max] typeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
                    if (typeToken == 0)
                    {
                        return result;
                    }

                    allocationSize = TypeKnownByteExtentForLocal(stream, source, typeToken);
                    allocationAlign = TypeKnownByteAlignment(stream, source, typeToken);
                    if (allocationSize == 0 || allocationAlign == 0)
                    {
                        return result;
                    }
                }
                else if (!TryParseArenaSelectorAllocation(stream, source, cursor, statementEnd, allocationSize, allocationAlign))
                {
                    stack u32[0 max] objectTypeToken = FindSelfHostedLocalTypeToken(stream, cursor, statementEnd);
                    stack mut u32[0 max] bodyOpen = 0;
                    stack mut u32[0 max] bodyClose = 0;
                    stack mut u32[0 max] argsOpen = 0;
                    stack mut u32[0 max] argsClose = 0;
                    stack bool objectStorageLocal = localStorage == TokenKind.Stack || localStorage == TokenKind.Heap;
                    stack mut bool objectConstructor = false;
                    stack mut bool positionalRecordConstructor = false;
                    if (objectStorageLocal
                        && hasAssign
                        && objectTypeToken != 0
                        && TryParseTargetTypedObjectConstructorShape(stream, source, objectTypeToken, assignToken, statementEnd, bodyOpen, bodyClose))
                    {
                        objectConstructor = true;
                    }
                    else if (objectStorageLocal
                        && hasAssign
                        && objectTypeToken != 0
                        && TryParseTargetTypedPositionalRecordConstructorShape(stream, source, objectTypeToken, assignToken, statementEnd, argsOpen, argsClose))
                    {
                        objectConstructor = true;
                        positionalRecordConstructor = true;
                    }

                    if (objectConstructor)
                    {
                        if (localStorage == TokenKind.Heap && signature.LawKind())
                        {
                            return result;
                        }

                        stack u32[0 max] objectAllocationSize = TypeKnownByteExtentForLocalWithEnums(stream, source, moduleFacts, objectTypeToken);
                        stack u32[0 max] objectAllocationAlign = TypeKnownByteAlignmentWithEnums(stream, source, moduleFacts, objectTypeToken);
                        if (objectAllocationSize == 0 || objectAllocationAlign == 0)
                        {
                            return result;
                        }

                        stack mut MirValueId objectAllocation = new();
                        if (localStorage == TokenKind.Heap)
                        {
                            objectAllocation = MirHeapAlloc(instrs, objectAllocationSize, objectAllocationAlign);
                        }
                        else
                        {
                            objectAllocation = MirStackAlloc(instrs, objectAllocationSize, objectAllocationAlign);
                        }

                        stack u32[0 max] objectLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                        stack u32[0 max] objectNonValueRoot = localRoots.Add(0);
                        stack u32[0 max] objectNonValueType = localTypes.Add(SourceLocalTypeCodeNonValue());
                        stack u32[0 max] objectOverrideValue = localOverrideValues.Add(objectAllocation.Index());
                        if (sourceValueFacts.Add(new ValueFacts()) == 0)
                        {
                            return result;
                        }

                        if (positionalRecordConstructor)
                        {
                            if (!TryParseStackObjectPositionalRecordConstructorInitializers(
                                stream,
                                source,
                                moduleFacts,
                                objectTypeToken,
                                argsOpen,
                                argsClose,
                                objectNonValueRoot,
                                objectLocalIndex,
                                objectAllocation,
                                nodes,
                                params,
                                funcNames,
                                constructedObjectLocals,
                                localTypes,
                                sourceValueFacts,
                                stackObjectFieldInitializers))
                            {
                                return result;
                            }
                        }
                        else
                        {
                            if (!TryParseStackObjectDefaultConstructorInitializers(
                                stream,
                                source,
                                moduleFacts,
                                objectTypeToken,
                                objectNonValueRoot,
                                objectLocalIndex,
                                objectAllocation,
                                nodes,
                                params,
                                funcNames,
                                constructedObjectLocals,
                                localTypes,
                                sourceValueFacts,
                                stackObjectFieldInitializers))
                            {
                                return result;
                            }

                            if (!TryParseStackObjectFieldInitializers(
                                stream,
                                source,
                                moduleFacts,
                                objectTypeToken,
                                bodyOpen,
                                bodyClose,
                                objectNonValueRoot,
                                objectLocalIndex,
                                objectAllocation,
                                nodes,
                                params,
                                funcNames,
                                constructedObjectLocals,
                                localTypes,
                                sourceValueFacts,
                                stackObjectFieldInitializers))
                            {
                                return result;
                            }
                        }

                        stack mut ConstructedObjectLocal constructedObjectLocal = new();
                        constructedObjectLocal.Start = nameStart;
                        constructedObjectLocal.Length = nameLength;
                        constructedObjectLocal.ParamIndex = objectLocalIndex;
                        constructedObjectLocal.TypeToken = objectTypeToken;
                        stack u32[0 max] addedConstructedObjectLocal = constructedObjectLocals.Add(constructedObjectLocal);

                        cursor = statementEnd + 1;
                        continue;
                    }

                    stack u32[0 max] nonArenaLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                    stack u32[0 max] nonArenaRoot = localRoots.Add(0);
                    stack u32[0 max] nonArenaType = localTypes.Add(2);
                    stack u32[0 max] nonArenaOverrideValue = localOverrideValues.Add(0);
                    if (sourceValueFacts.Add(new ValueFacts()) == 0)
                    {
                        return result;
                    }

                    cursor = statementEnd + 1;
                    continue;
                }

                if (signature.LawKind() || localStorage == TokenKind.Heap || localStorage == TokenKind.Static)
                {
                    return result;
                }

                if (!usesArenaFrame)
                {
                    stack MirValueId frame = MirArenaFrameEnter(instrs);
                    usesArenaFrame = true;
                }

                stack MirValueId allocation = MirArenaAlloc(instrs, allocationSize, allocationAlign);
                stack u32[0 max] localIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] nonValueRoot = localRoots.Add(0);
                stack u32[0 max] nonValueType = localTypes.Add(2);
                stack u32[0 max] arenaOverrideValue = localOverrideValues.Add(0);
                if (sourceValueFacts.Add(new ValueFacts()) == 0)
                {
                    return result;
                }
            }

            cursor = statementEnd + 1;
            continue;
        }

        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, (u64[0 2 ** 63 - 1])terminalIndex, statementEnd))
        {
            return result;
        }

        if (TryParseSourceSliceElementAssignmentStatement(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            sliceDescriptorLocals,
            localTypes,
            sourceValueFacts,
            moduleFacts,
            cursor,
            statementEnd,
            constructedObjectFieldAssignments))
        {
            stack mut SourceStorageMutationStatement mutation = new();
            mutation.Kind = SourceStorageMutationKindConstructedObjectField();
            mutation.AssignmentIndex = (u32[0 max])constructedObjectFieldAssignments.Count();
            if (storageMutationStatements.Add(mutation) == 0)
            {
                return result;
            }
        }
        else if (TryParseRawPointerStorageAssignmentStatement(
            stream,
            source,
            nodes,
            params,
            funcNames,
            constructedObjectLocals,
            localTypes,
            sourceValueFacts,
            cursor,
            statementEnd,
            scalarStorageAssignments))
        {
            stack mut SourceStorageMutationStatement mutation = new();
            mutation.Kind = SourceStorageMutationKindScalar();
            mutation.AssignmentIndex = (u32[0 max])scalarStorageAssignments.Count();
            if (storageMutationStatements.Add(mutation) == 0)
            {
                return result;
            }
        }
        else if (StatementStartsConstructedObjectFieldAssignment(stream, cursor, statementEnd))
        {
            if (!TryParseConstructedObjectFieldAssignmentStatement(
                stream,
                source,
                nodes,
                params,
                funcNames,
                constructedObjectLocals,
                localTypes,
                sourceValueFacts,
                moduleFacts,
                cursor,
                statementEnd,
                constructedObjectFieldAssignments))
            {
                return result;
            }

            stack mut SourceStorageMutationStatement mutation = new();
            mutation.Kind = SourceStorageMutationKindConstructedObjectField();
            mutation.AssignmentIndex = (u32[0 max])constructedObjectFieldAssignments.Count();
            if (storageMutationStatements.Add(mutation) == 0)
            {
                return result;
            }
        }
        else if (StatementStartsScalarStorageAssignment(stream, cursor, statementEnd))
        {
            if (TryParseScalarStorageAssignmentStatement(
                stream,
                source,
                nodes,
                params,
                funcNames,
                constructedObjectLocals,
                scalarStorageLocals,
                localTypes,
                sourceValueFacts,
                cursor,
                statementEnd,
                scalarStorageAssignments))
            {
                stack mut SourceStorageMutationStatement mutation = new();
                mutation.Kind = SourceStorageMutationKindScalar();
                mutation.AssignmentIndex = (u32[0 max])scalarStorageAssignments.Count();
                if (storageMutationStatements.Add(mutation) == 0)
                {
                    return result;
                }
            }
            else if (TryParseEnumStorageAssignmentStatement(
                stream,
                source,
                nodes,
                params,
                funcNames,
                constructedObjectLocals,
                enumStorageLocals,
                localTypes,
                sourceValueFacts,
                moduleFacts,
                cursor,
                statementEnd,
                enumStorageAssignments))
            {
                stack mut SourceStorageMutationStatement mutation = new();
                mutation.Kind = SourceStorageMutationKindEnum();
                mutation.AssignmentIndex = (u32[0 max])enumStorageAssignments.Count();
                if (storageMutationStatements.Add(mutation) == 0)
                {
                    return result;
                }
            }
            else
            {
                return result;
            }
        }
        else if (!TryLowerArenaDynamicReserveStatement(stream, source, arenaDynamicLocals, cursor, statementEnd, instrs))
        {
            return result;
        }

        cursor = statementEnd + 1;
    }

    stack ExprParseResult returnRoot = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, moduleFacts, (u64[0 2 ** 63 - 1])terminalIndex + 1);
    if (!AnnotateCallExpressionResultTypesFromContracts(nodes, functionCallContractFacts))
    {
        return result;
    }

    if (!LinkSourceTextLiteralRowsFromModuleFacts(nodes, moduleFacts))
    {
        return result;
    }

    if (!LinkSourceFloatLiteralRowsFromModuleFacts(nodes, moduleFacts))
    {
        return result;
    }

    // Every body name must be a parameter or a declared local — no phantom names.
    if (params.Count() != signatureParamCount + localRoots.Count())
    {
        return result;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return result;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return result;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return result;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return result;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, loweringLocalTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return result;
    }

    if (usesBecome && rootType != ExprType.IntType)
    {
        return result;
    }

    if (usesBecome && !TailCallTargetIsTailCallable(nodes, returnRoot.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return result;
    }

    // Build the override table: signature parameters have no override (0); each local lowers
    // (seeing earlier locals) and appends its value.
    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return result;
    }

    // Ordered statement timeline replay: local declarations and storage
    // mutations lower in source order, so a local's override value and
    // initializers observe every mutation that precedes the declaration.
    stack u64[0 2 ** 63 - 1] timelineCount = storageMutationStatements.Count();
    stack mut u64[0 2 ** 63 - 1] t = 0;
    stack mut u64[0 2 ** 63 - 1] v = 0;
    stack mut u32[0 max] nextStackObjectInitializer = 1;
    stack mut u32[0 max] nextScalarStorageInitializer = 1;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    stack mut u32[0 max] nextEnumStorageInitializer = 1;
    while willexit (t < timelineCount)
    {
        stack SourceStorageMutationStatement step = storageMutationStatements.Get((u32[0 max])(t + 1));
        if (step.Kind != SourceStorageMutationKindLocalDecl())
        {
            if (!LowerSourceStorageMutationStatementWithCallContext(
                storageMutationStatements,
                scalarStorageAssignments,
                enumStorageAssignments,
                constructedObjectFieldAssignments,
                (u32[0 max])(t + 1),
                nodes,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals))
            {
                return result;
            }

            t = t + 1;
            continue;
        }

        if (step.AssignmentIndex != (u32[0 max])(v + 1) || !localRoots.Contains((u32[0 max])(v + 1)))
        {
            return result;
        }

        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(v + 1));
        if (localRoot == 0)
        {
            stack mut u32[0 max] storageOverride = 0;
            if (localOverrideValues.Contains((u32[0 max])(v + 1)))
            {
                storageOverride = localOverrideValues.Get((u32[0 max])(v + 1));
            }

            stack u32[0 max] nonValueOverride = localOverrides.Add(storageOverride);
        }
        else
        {
            stack MirValueId varValue = LowerExprNodeWithCallContext(
                nodes,
                localRoot,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
            stack u32[0 max] addedOverride = localOverrides.Add(varValue.Index());
        }

        nextScalarStorageInitializer = LowerScalarStorageInitializersForLocalWithCallContext(
            scalarStorageInitializers,
            (u32[0 max])(v + 1),
            nextScalarStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
            fixedArrayStorageInitializers,
            (u32[0 max])(v + 1),
            nextFixedArrayStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextEnumStorageInitializer = LowerEnumStorageInitializersForLocalWithCallContext(
            enumStorageInitializers,
            (u32[0 max])(v + 1),
            nextEnumStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
            stackObjectFieldInitializers,
            (u32[0 max])(v + 1),
            nextStackObjectInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);
        v = v + 1;
        t = t + 1;
    }

    if (v != localRoots.Count())
    {
        return result;
    }

    if ((u64[0 2 ** 63 - 1])(nextScalarStorageInitializer - 1) != scalarStorageInitializers.Count())
    {
        return result;
    }

    if ((u64[0 2 ** 63 - 1])(nextEnumStorageInitializer - 1) != enumStorageInitializers.Count())
    {
        return result;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return result;
    }

    if (usesBecome)
    {
        if (usesArenaFrame)
        {
            return result;
        }

        stack MirValueId tailValue = LowerTailCallExprNodeWithCallContext(
            nodes,
            returnRoot.NodeId,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);
        stack MirBlockId entry = MirTailCallBlock(blocks, tailValue);
        result.Ok = true;
        result.EntryBlock = entry.Index();
        result.ParamCount = (u32[0 max])signatureParamCount;
        return result;
    }

    if (rootType == ExprType.EnumType)
    {
        // Enum-valued terminal return: the declared return type must resolve
        // to an enum owner, and the lowered value's carried owner must match
        // it before the return block is emitted — the emitter renders the
        // define/ret type from that owner's layout fact.
        stack mut u32[0 max] returnOwnerDeclarationIndex = 0;
        stack mut Compiler.Parsing.DeclItem returnEnumItem = new();
        if (!TryGetSourceEnumOwnerDeclarationForToken(
            stream,
            source,
            moduleFacts,
            signature.ReturnTypeTokenAt(),
            returnOwnerDeclarationIndex,
            returnEnumItem))
        {
            return result;
        }

        stack MirValueId enumReturnValue = LowerExprNodeWithCallContext(
            nodes,
            returnRoot.NodeId,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);
        stack mut TypeId returnOwnerType = TypeIdOf(0);
        if (!TryGetMirEnumValueOwnerType(instrs, enumReturnValue.Index(), returnOwnerType))
        {
            return result;
        }

        stack TypeId declaredOwnerType = TypeIdOf(returnOwnerDeclarationIndex + 1);
        if (!returnOwnerType.Equals(declaredOwnerType))
        {
            return result;
        }

        if (usesArenaFrame)
        {
            stack MirValueId enumLeave = MirArenaFrameLeave(instrs);
        }

        stack MirBlockId enumEntry = MirReturnBlock(blocks, enumReturnValue);
        result.Ok = true;
        result.EntryBlock = enumEntry.Index();
        result.ParamCount = (u32[0 max])signatureParamCount;
        return result;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);
    if (rootType == ExprType.FloatType && (!hasDeclaredReturnType || (declaredReturnType != MirType.F32 && declaredReturnType != MirType.F64)))
    {
        return result;
    }

    stack MirValueId returnValue = LowerScalarReturnExprNodeWithModuleFactsAndCallContext(
        nodes,
        returnRoot.NodeId,
        instrs,
        loweringLocalTypes,
        localOverrides,
        moduleFacts,
        functionCallContractFacts,
        sliceArgumentLocals,
        rootType,
        hasDeclaredReturnType,
        declaredReturnType);

    if (usesArenaFrame)
    {
        stack MirValueId leave = MirArenaFrameLeave(instrs);
    }

    stack MirBlockId entry = MirReturnBlock(blocks, returnValue);
    result.Ok = true;
    result.EntryBlock = entry.Index();
    result.ParamCount = (u32[0 max])signatureParamCount;
    return result;
}

internal fn LoweredBody LowerFunctionWithLocals(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    bool isTailCallable,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks)
{
    stack mut SourceModuleLoweringFacts noModuleFacts = new();
    return LowerFunctionWithLocalsWithEnums(stream, source, funcNames, funcParamCounts, functionCallContractFacts, funcTailFlags, isTailCallable, noModuleFacts, fnIndex, instrs, blocks);
}
internal fn bool EmitModuleFunctionAst(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    borrow IrTable<ValueFacts> functionReturnFacts,
    mut borrow IrTable<LlvmRangeMetadata> rangeMetadata,
    borrow IrTable<FunctionEffectFacts> functionEffectFacts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<FunctionLinkageFacts> functionLinkageFacts,
    borrow IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    u32[0 max] functionNumber,
    mut borrow OwnedAscii sink)
    where overlap(sourceText, source)
{
    stack bool isTailCallable = FunctionIdIsTailCallable(funcTailFlags, functionNumber);
    stack i64[min max] bodyBrace = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (bodyBrace >= 0 && stream.KindAt((u64[0 2 ** 63 - 1])bodyBrace + 1) == TokenKind.If)
    {
        if (EmitModuleIfReturnFunction(
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink))
        {
            return true;
        }

        return EmitModuleLocalIfReturnFunction(
            stream,
            source,
            moduleFacts,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithReturnIfExpression(stream, fnIndex))
    {
        return EmitModuleReturnIfExpressionFunction(
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithReturnedLocalIfExpression(stream, fnIndex))
    {
        return EmitModuleReturnedLocalIfExpressionFunction(
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithLocalIfExpressionInitializer(stream, fnIndex))
    {
        return EmitModuleLocalIfExpressionFunction(
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithReturnedLocalIfStatement(stream, source, funcNames, fnIndex))
    {
        return EmitModuleReturnedLocalIfStatementFunction(
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithLocalIfStatementAssignment(stream, source, funcNames, fnIndex))
    {
        return EmitModuleLocalIfStatementFunction(
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithCountingWhileLoop(stream, source, fnIndex))
    {
        return EmitModuleCountingLoopFunction(
            stream,
            source,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithAccumulatorWhileLoop(stream, source, fnIndex))
    {
        return EmitModuleAccumulatorLoopFunction(
            stream,
            source,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithHeaderCountingForLoop(stream, source, fnIndex))
    {
        return EmitModuleHeaderCountingForLoopFunction(
            stream,
            source,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithCountingForLoop(stream, source, fnIndex))
    {
        return EmitModuleCountingForLoopFunction(
            stream,
            source,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithTerminalSwitch(stream, fnIndex))
    {
        return EmitModuleTerminalIntegerSwitchFunction(
            sourceText,
            stream,
            source,
            moduleFacts,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithConstructedObjectSwitchFieldAssignment(stream, source, fnIndex))
    {
        return EmitModuleConstructedObjectSwitchFieldAssignmentFunction(
            sourceText,
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithLocalSwitchStatementAssignment(stream, source, funcNames, fnIndex))
    {
        return EmitModuleLocalSwitchStatementFunction(
            sourceText,
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyHasLocalPrefixedTerminalSwitch(stream, source, moduleFacts, fnIndex))
    {
        return EmitModuleLocalTerminalIntegerSwitchFunction(
            stream,
            source,
            moduleFacts,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyHasLocalPrefixedTerminalIf(stream, fnIndex))
    {
        return EmitModuleLocalIfReturnFunction(
            stream,
            source,
            moduleFacts,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithIfStatement(stream, fnIndex))
    {
        return EmitModuleLocalIfReturnFunction(
            stream,
            source,
            moduleFacts,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            funcTailFlags,
            functionReturnFacts,
            rangeMetadata,
            functionEffectFacts,
            isTailCallable,
            fnIndex,
            functionNumber,
            sink);
    }

    if (FunctionBodyStartsWithReturnTryExpression(stream, fnIndex)
        || FunctionBodyStartsWithLocalTryBinding(stream, source, fnIndex)
        || FunctionBodyStartsWithLocalTryAssignment(stream, source, fnIndex)
        || FunctionBodyStartsWithLocalSourceSliceElementTryAssignment(stream, source, fnIndex)
        || FunctionBodyStartsWithStorageTryAssignment(stream, source, fnIndex)
        || FunctionBodyStartsWithConstructedObjectFieldTryAssignment(stream, source, fnIndex)
        || FunctionBodyStartsWithSourceSliceElementTryAssignment(stream, source, fnIndex))
    {
        stack mut IrTable<MirInstruction> tryInstrs = new();
        stack mut IrTable<MirBlock> tryBlocks = new();
        stack mut IrTable<BlockEmit> tryRanges = new();
        stack mut LoweredBody tryBody = new();
        if (FunctionBodyStartsWithReturnTryExpression(stream, fnIndex))
        {
            if (!LowerModuleReturnTryExpressionFunctionToBlocks(
                stream,
                sourceText,
                source,
                moduleFacts,
                funcNames,
                funcParamCounts,
                functionCallContractFacts,
                fnIndex,
                tryInstrs,
                tryBlocks,
                tryRanges,
                true,
                tryBody))
            {
                return false;
            }
        }
        else if (FunctionBodyStartsWithLocalTryBinding(stream, source, fnIndex))
        {
            if (!LowerModuleLocalTryBindingFunctionToBlocks(
                stream,
                sourceText,
                source,
                moduleFacts,
                funcNames,
                funcParamCounts,
                functionCallContractFacts,
                fnIndex,
                tryInstrs,
                tryBlocks,
                tryRanges,
                true,
                tryBody))
            {
                return false;
            }
        }
        else if (FunctionBodyStartsWithLocalTryAssignment(stream, source, fnIndex))
        {
            if (!LowerModuleLocalTryAssignmentFunctionToBlocks(
                stream,
                sourceText,
                source,
                moduleFacts,
                funcNames,
                funcParamCounts,
                functionCallContractFacts,
                fnIndex,
                tryInstrs,
                tryBlocks,
                tryRanges,
                true,
                tryBody))
            {
                return false;
            }
        }
        else if (FunctionBodyStartsWithLocalSourceSliceElementTryAssignment(stream, source, fnIndex))
        {
            if (!LowerModuleLocalSourceSliceElementTryAssignmentFunctionToBlocks(
                stream,
                sourceText,
                source,
                moduleFacts,
                funcNames,
                funcParamCounts,
                functionCallContractFacts,
                fnIndex,
                tryInstrs,
                tryBlocks,
                tryRanges,
                true,
                tryBody))
            {
                return false;
            }
        }
        else if (FunctionBodyStartsWithStorageTryAssignment(stream, source, fnIndex))
        {
            if (!LowerModuleStorageTryAssignmentFunctionToBlocks(
                stream,
                sourceText,
                source,
                moduleFacts,
                funcNames,
                funcParamCounts,
                functionCallContractFacts,
                fnIndex,
                tryInstrs,
                tryBlocks,
                tryRanges,
                true,
                tryBody))
            {
                return false;
            }
        }
        else if (FunctionBodyStartsWithSourceSliceElementTryAssignment(stream, source, fnIndex))
        {
            if (!LowerModuleSourceSliceElementTryAssignmentFunctionToBlocks(
                stream,
                sourceText,
                source,
                moduleFacts,
                funcNames,
                funcParamCounts,
                functionCallContractFacts,
                fnIndex,
                tryInstrs,
                tryBlocks,
                tryRanges,
                true,
                tryBody))
            {
                return false;
            }
        }
        else if (!LowerModuleConstructedObjectFieldTryAssignmentFunctionToBlocks(
                stream,
                sourceText,
                source,
                moduleFacts,
                funcNames,
                funcParamCounts,
                functionCallContractFacts,
                fnIndex,
                tryInstrs,
                tryBlocks,
                tryRanges,
                true,
                tryBody))
        {
            return false;
        }

        stack mut FunctionSignature trySignature = new();
        if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, trySignature))
        {
            return false;
        }

        stack mut IrTable<ValueFacts> tryParamFacts = new();
        if (!BuildParamRangeFacts(stream, source, trySignature, tryParamFacts))
        {
            return false;
        }

        stack mut IrTable<ParamAbiFacts> tryParamAbiFacts = new();
        if (!BuildParamAbiFactsWithDeclarations(stream, source, moduleFacts, trySignature, tryParamAbiFacts))
        {
            return false;
        }

        stack mut IrTable<DistinctStoragePair> tryDistinctStorageFacts = new();
        if (!BuildDistinctStorageFacts(stream, source, trySignature, (u32[0 max])fnIndex, tryParamAbiFacts, tryDistinctStorageFacts))
        {
            return false;
        }

        stack ValueFacts tryReturnFacts = FunctionReturnRangeFact(stream, source, trySignature);
        stack mut IrTable<ValueFacts> tryValueFacts = new();
        stack mut IrTable<ValueFacts> tryGlobalFacts = new();
        if (!BuildMirValueRangeFacts(tryInstrs, tryParamFacts, tryValueFacts, tryGlobalFacts, functionReturnFacts))
        {
            return false;
        }

        if (!ValidateBlockReturnRangeFacts(tryReturnFacts, tryBlocks, tryValueFacts))
        {
            return false;
        }

        stack FunctionEffectFacts tryFunctionEffects = FunctionEffectFactsAt(functionEffectFacts, functionNumber);
        switch (EmitLlvmBlocksNumberedWithRangeFactsCoreWithEnumLayouts(
            tryInstrs,
            funcTailFlags,
            functionEffectFacts,
            functionCallContractFacts,
            functionLinkageFacts,
            functionCallingConventionFacts,
            tryBlocks,
            "f",
            functionNumber,
            isTailCallable,
            tryReturnFacts,
            tryParamFacts,
            tryParamAbiFacts,
            tryDistinctStorageFacts,
            tryValueFacts,
            tryGlobalFacts,
            functionReturnFacts,
            moduleFacts.EnumLayoutFacts,
            rangeMetadata,
            tryFunctionEffects,
            tryBody.ParamCount,
            tryRanges,
            sink))
        {
            case MemoryStatus.Ok:
                return true;
            case MemoryStatus.Err(var tryError):
                return false;
        }
    }

    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack LoweredBody body = LowerFunctionWithLocalsWithEnums(stream, source, funcNames, funcParamCounts, functionCallContractFacts, funcTailFlags, isTailCallable, moduleFacts, fnIndex, instrs, blocks);
    if (!body.Ok)
    {
        return false;
    }

    stack u32[0 max] instrCount = (u32[0 max])instrs.Count();
    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> paramFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, paramFacts))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFactsWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack ValueFacts returnFacts = FunctionReturnRangeFact(stream, source, signature);
    stack mut IrTable<ValueFacts> valueFacts = new();
    stack mut IrTable<ValueFacts> globalFacts = new();
    if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
    {
        return false;
    }

    if (!ValidateBlockReturnRangeFacts(returnFacts, blocks, valueFacts))
    {
        return false;
    }

    stack FunctionEffectFacts functionEffects = FunctionEffectFactsAt(functionEffectFacts, functionNumber);

    switch (EmitLlvmNumberedFunctionWithRangeFactsCoreWithEnumLayouts(
        instrs,
        funcTailFlags,
        functionEffectFacts,
        functionCallContractFacts,
        functionLinkageFacts,
        functionCallingConventionFacts,
        blocks,
        "f",
        functionNumber,
        isTailCallable,
        returnFacts,
        paramFacts,
        paramAbiFacts,
        distinctStorageFacts,
        valueFacts,
        globalFacts,
        functionReturnFacts,
        moduleFacts.EnumLayoutFacts,
        rangeMetadata,
        functionEffects,
        body.ParamCount,
        body.EntryBlock,
        1,
        instrCount,
        sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var error):
            return false;
    }
}

internal fn bool PrecomputeModuleFunctionEffectFactsFromAstStream(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow TypedFunctionEffectSummaryTable typedFunctionEffects,
    bool importTypedBackendDefaults,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    out IrTable<FunctionEffectFacts> functionEffectFacts)
    where overlap(sourceText, source)
{
    functionEffectFacts = new();
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    if (!BuildModuleFunctionTablesForEffectPrepass(stream, sourceText, source, moduleFacts, funcNames, funcParamCounts, functionCallContractFacts, funcTailFlags, instrs, blocks, funcs))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> lawCandidates = new();
    stack mut IrTable<u32[0 max]> finiteCandidates = new();
    stack mut IrTable<u32[0 max]> noRecurseCandidates = new();
    if (!BuildModuleEffectCandidateFlags(stream, instrs, funcs, lawCandidates, finiteCandidates, noRecurseCandidates))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> lawFlags = new();
    if (!ComputeDecreasingCallProofFlags(instrs, funcs, lawCandidates, lawFlags))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> finiteFlags = new();
    if (!ComputeIncreasingCallProofFlags(instrs, funcs, finiteCandidates, finiteFlags))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> noRecurseFlags = new();
    if (!ComputeIncreasingCallProofFlags(instrs, funcs, noRecurseCandidates, noRecurseFlags))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> lawMayReadFlags = new();
    if (!ComputeLawMayReadFlags(instrs, funcs, lawFlags, lawMayReadFlags))
    {
        return false;
    }

    return BuildFunctionEffectFactsFromFlags(
        stream,
        sourceText,
        typedFunctionEffects,
        importTypedBackendDefaults,
        funcs,
        lawFlags,
        lawMayReadFlags,
        finiteFlags,
        noRecurseFlags,
        functionEffectFacts);
}

// Compiles a MULTI-FUNCTION module `(fn <name>(<params>) { return <expr> })+` through the
// AST path using already-built source and typed-effect facts. Keeping construction outside
// this core lets the optimized SSA/ABI owner hand off canonical facts without rebuilding or
// copying them. A first pass builds the function-name table (definition order = 1-based id
// order), then each function's return body is parsed against that table — so a call
// `<name>(<args>)` resolves its callee NAME to the right `@fN` — lowered, and emitted. This
// is the AST counterpart of the positional `LowerModuleStream`, but a call's callee comes
// from real name resolution, not a positional scan, and arguments flow through the AST.
internal fn bool CompileModuleFromAstStreamWithFactsAndTypedBackendDefaults(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow TypedFunctionEffectSummaryTable typedFunctionEffects,
    bool importTypedBackendDefaults,
    mut borrow OwnedAscii sink)
    where overlap(sourceText, source)
{
    stack u64[0 2 ** 63 - 1] tokenCount = stream.Count();
    // Function-name table and parallel parameter-count table (definition order = 1-based id
    // order, built in lockstep so a callee id indexes both). The name follows `fn`; the
    // signature's `(` is at the fn index + 2.
    stack mut IrTable<ParamName> funcNames = new();
    stack mut IrTable<u32[0 max]> funcParamCounts = new();
    stack mut IrTable<FunctionCallContractFacts> functionCallContractFacts = new();
    stack mut IrTable<FunctionLinkageFacts> functionLinkageFacts = new();
    stack mut IrTable<FunctionCallingConventionFacts> functionCallingConventionFacts = new();
    stack mut IrTable<u32[0 max]> funcTailFlags = new();
    stack mut IrTable<ValueFacts> functionReturnFacts = new();
    stack mut u64[0 2 ** 63 - 1] typedFunctionIndex = 0;
    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < tokenCount)
    {
        if (stream.KindAt(i) == TokenKind.Fn)
        {
            stack mut Compiler.Parsing.FunctionSignature signature = new();
            if (!ParseFunctionSignatureAt(stream, (u32[0 max])i, signature))
            {
                return false;
            }

            stack mut ParamName name = new();
            name.Start = stream.StartAt((u64[0 2 ** 63 - 1])signature.Name());
            name.Length = stream.LengthAt((u64[0 2 ** 63 - 1])signature.Name());
            stack u32[0 max] added = funcNames.Add(name);

            stack u32[0 max] paramCountValue = (u32[0 max])signature.ParamCount();
            stack u32[0 max] addedCount = funcParamCounts.Add(paramCountValue);
            stack mut u32[0 max] tailFlag = 0;
            if (FunctionTokenHasTailModifier(stream, i))
            {
                tailFlag = 1;
            }

            stack u32[0 max] addedTailFlag = funcTailFlags.Add(tailFlag);
            stack mut FunctionCallContractFacts callFacts = new();
            if (!BuildFunctionCallContractFactsWithDeclarations(stream, source, moduleFacts, signature, (u32[0 max])i, callFacts))
            {
                return false;
            }

            if (functionCallContractFacts.Add(callFacts) == 0)
            {
                return false;
            }

            stack FunctionLinkageFacts linkageFacts = BuildFunctionLinkageFacts(stream, (u32[0 max])i);
            if (functionLinkageFacts.Add(linkageFacts) == 0)
            {
                return false;
            }

            stack mut FunctionCallingConventionFacts conventionFacts = new();
            if (!BuildFunctionCallingConventionFacts(sourceText, stream, (u32[0 max])i, conventionFacts)
                || (importTypedBackendDefaults
                    && !ApplyTypedFunctionCallingConventionFacts(
                        typedFunctionEffects,
                        typedFunctionIndex,
                        (u32[0 max])i,
                        conventionFacts))
                || functionCallingConventionFacts.Add(conventionFacts) == 0)
            {
                return false;
            }

            typedFunctionIndex = typedFunctionIndex + 1;

            stack ValueFacts returnFacts = FunctionReturnRangeFact(stream, source, signature);
            if (functionReturnFacts.Add(returnFacts) == 0)
            {
                return false;
            }
        }

        i = i + 1;
    }

    if (funcNames.Count() == 0)
    {
        return false;
    }

    if (TokenStreamMentionsHeapRuntime(stream))
    {
        switch (EmitLlvmHeapRuntimeDeclarations(sink))
        {
            case MemoryStatus.Ok:
                stack bool heapDeclarationsOk = true;
            case MemoryStatus.Err(var heapDeclError):
                return false;
        }
    }

    if (TokenStreamMentionsArenaDynamicRuntime(stream, source))
    {
        switch (EmitLlvmArenaDynamicRuntimeDeclarations(sink))
        {
            case MemoryStatus.Ok:
                stack bool arenaDynamicDeclarationsOk = true;
            case MemoryStatus.Err(var arenaDynamicDeclError):
                return false;
        }
    }
    else if (TokenStreamMentionsArenaRuntime(stream))
    {
        switch (EmitLlvmArenaRuntimeDeclarations(sink))
        {
            case MemoryStatus.Ok:
                stack bool arenaDeclarationsOk = true;
            case MemoryStatus.Err(var arenaDeclError):
                return false;
        }
    }

    stack mut IrTable<FunctionEffectFacts> functionEffectFacts = new();
    if (!PrecomputeModuleFunctionEffectFactsFromAstStream(
        stream,
        sourceText,
        source,
        moduleFacts,
        typedFunctionEffects,
        importTypedBackendDefaults,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        funcTailFlags,
        functionEffectFacts))
    {
        return false;
    }

    // Lower + emit each function in definition order.
    stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
    stack mut u32[0 max] functionNumber = 0;
    stack mut u64[0 2 ** 63 - 1] f = 0;
    while willexit (f < tokenCount)
    {
        if (stream.KindAt(f) == TokenKind.Fn)
        {
            functionNumber = functionNumber + 1;
            if (!EmitModuleFunctionAst(
                stream,
                sourceText,
                source,
                moduleFacts,
                funcNames,
                funcParamCounts,
                funcTailFlags,
                functionReturnFacts,
                rangeMetadata,
                functionEffectFacts,
                functionCallContractFacts,
                functionLinkageFacts,
                functionCallingConventionFacts,
                f,
                functionNumber,
                sink))
            {
                return false;
            }
        }

        f = f + 1;
    }

    switch (EmitLlvmRangeMetadataDefinitions(rangeMetadata, sink))
    {
        case MemoryStatus.Ok:
            return true;
        case MemoryStatus.Err(var metadataError):
            return false;
    }
}

internal fn bool CompileModuleFromAstStreamWithTypedBackendDefaults(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    bool importTypedBackendDefaults,
    mut borrow OwnedAscii sink)
    where overlap(sourceText, source)
{
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    if (!BuildSourceModuleLoweringFacts(sourceText, stream, source, moduleFacts))
    {
        return false;
    }

    stack mut TypedFunctionEffectSummaryTable typedFunctionEffects = new();
    if (importTypedBackendDefaults
        && !BuildSourceTypedFunctionEffectSummaries(
            sourceText,
            stream,
            moduleFacts.Declarations,
            typedFunctionEffects))
    {
        return false;
    }

    return CompileModuleFromAstStreamWithFactsAndTypedBackendDefaults(
        stream,
        sourceText,
        source,
        moduleFacts,
        typedFunctionEffects,
        importTypedBackendDefaults,
        sink);
}

internal fn bool CompileModuleFromAstStream(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    mut borrow OwnedAscii sink)
    where overlap(sourceText, source)
{
    return CompileModuleFromAstStreamWithTypedBackendDefaults(stream, sourceText, source, false, sink);
}

// Lexes a multi-function module and compiles it through the AST path (see
// `CompileModuleFromAstStream`).
public fn bool CompileModuleFromAst(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return CompileModuleFromAstStream(stream, sourceText.View(), sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

public fn bool CompileModuleFromAstWithTypedBackendDefaults(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return CompileModuleFromAstStreamWithTypedBackendDefaults(
                stream,
                sourceText.View(),
                sourceBytes,
                true,
                sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

internal fn bool BuildModulePackageTablesWithAsmStream(
    borrow TokenStream stream,
    ascii sourceText,
    borrow i8[min max][] source,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<MirFunction> funcs,
    mut borrow AsmMetadataTable asmMetadata)
    where overlap(sourceText, source)
{
    stack u64[0 2 ** 63 - 1] tokenCount = stream.Count();
    stack mut SourceModuleLoweringFacts moduleFacts = new();
    if (!BuildSourceModuleLoweringFacts(sourceText, stream, source, moduleFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> funcNames = new();
    stack mut IrTable<u32[0 max]> funcParamCounts = new();
    stack mut IrTable<FunctionCallContractFacts> functionCallContractFacts = new();
    stack mut IrTable<u32[0 max]> funcTailFlags = new();

    stack mut u64[0 2 ** 63 - 1] i = 0;
    while willexit (i < tokenCount)
    {
        if (stream.KindAt(i) == TokenKind.Fn)
        {
            stack mut Compiler.Parsing.FunctionSignature signature = new();
            if (!ParseFunctionSignatureAt(stream, (u32[0 max])i, signature))
            {
                return false;
            }

            stack mut ParamName name = new();
            name.Start = stream.StartAt((u64[0 2 ** 63 - 1])signature.Name());
            name.Length = stream.LengthAt((u64[0 2 ** 63 - 1])signature.Name());
            if (funcNames.Add(name) == 0)
            {
                return false;
            }

            if (funcParamCounts.Add((u32[0 max])signature.ParamCount()) == 0)
            {
                return false;
            }

            stack mut u32[0 max] tailFlag = 0;
            if (FunctionTokenHasTailModifier(stream, i))
            {
                tailFlag = 1;
            }

            if (funcTailFlags.Add(tailFlag) == 0)
            {
                return false;
            }

            stack mut FunctionCallContractFacts callFacts = new();
            if (!BuildFunctionCallContractFactsWithDeclarations(stream, source, moduleFacts, signature, (u32[0 max])i, callFacts)
                || functionCallContractFacts.Add(callFacts) == 0)
            {
                return false;
            }
        }

        i = i + 1;
    }

    if (funcNames.Count() == 0)
    {
        return false;
    }

    stack mut u32[0 max] functionNumber = 0;
    stack mut u64[0 2 ** 63 - 1] f = 0;
    while willexit (f < tokenCount)
    {
        if (stream.KindAt(f) == TokenKind.Fn)
        {
            functionNumber = functionNumber + 1;

            stack mut Compiler.Parsing.FunctionSignature signature = new();
            if (!ParseFunctionSignatureAt(stream, (u32[0 max])f, signature))
            {
                return false;
            }

            if (signature.HasAsm())
            {
                stack MirFuncId asmFunction = MirDefineFunction(funcs, MirBlockIdOf(0), MirBlockIdOf(0), 0, MirValueIdOf(0), 0);
                if (asmFunction.Index() != functionNumber)
                {
                    return false;
                }
            }
            else
            {
                stack u32[0 max] firstInstr = (u32[0 max])instrs.Count() + 1;
                stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
                stack bool isTailCallable = FunctionIdIsTailCallable(funcTailFlags, functionNumber);
                stack i64[min max] bodyBrace = FirstTokenOfKindAfter(stream, TokenKind.LBrace, f);
                stack mut LoweredBody body = new();
                if (bodyBrace >= 0 && stream.KindAt((u64[0 2 ** 63 - 1])bodyBrace + 1) == TokenKind.If)
                {
                    if (!LowerModuleIfReturnFunctionToTables(
                        stream,
                        source,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        funcTailFlags,
                        isTailCallable,
                        f,
                        instrs,
                        blocks,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithReturnIfExpression(stream, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleReturnIfExpressionFunctionToBlocks(
                        stream,
                        source,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithReturnedLocalIfExpression(stream, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleReturnedLocalIfExpressionFunctionToBlocks(
                        stream,
                        source,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithLocalIfExpressionInitializer(stream, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleLocalIfExpressionFunctionToBlocks(
                        stream,
                        source,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithReturnedLocalIfStatement(stream, source, funcNames, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleReturnedLocalIfStatementFunctionToBlocks(
                        stream,
                        source,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithLocalIfStatementAssignment(stream, source, funcNames, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleLocalIfStatementFunctionToBlocks(
                        stream,
                        source,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithCountingWhileLoop(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleCountingLoopFunctionToBlocks(
                        stream,
                        source,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithAccumulatorWhileLoop(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleAccumulatorLoopFunctionToBlocks(
                        stream,
                        source,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithHeaderCountingForLoop(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleHeaderCountingForLoopFunctionToBlocks(
                        stream,
                        source,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithCountingForLoop(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleCountingForLoopFunctionToBlocks(
                        stream,
                        source,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithTerminalSwitch(stream, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleTerminalSwitchFunctionToBlocks(
                        sourceText,
                        stream,
                        source,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithConstructedObjectSwitchFieldAssignment(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleConstructedObjectSwitchFieldAssignmentFunctionToBlocks(
                        sourceText,
                        stream,
                        source,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithLocalSwitchStatementAssignment(stream, source, funcNames, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleLocalSwitchStatementFunctionToBlocks(
                        sourceText,
                        stream,
                        source,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyHasLocalPrefixedTerminalSwitch(stream, source, moduleFacts, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleLocalTerminalIntegerSwitchFunctionToBlocks(
                        stream,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyHasLocalPrefixedTerminalIf(stream, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleLocalIfReturnFunctionToBlocks(
                        stream,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        funcTailFlags,
                        isTailCallable,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithIfStatement(stream, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleLocalIfReturnFunctionToBlocks(
                        stream,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        funcTailFlags,
                        isTailCallable,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithReturnTryExpression(stream, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleReturnTryExpressionFunctionToBlocks(
                        stream,
                        sourceText,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithLocalTryBinding(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleLocalTryBindingFunctionToBlocks(
                        stream,
                        sourceText,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithLocalTryAssignment(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleLocalTryAssignmentFunctionToBlocks(
                        stream,
                        sourceText,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithLocalSourceSliceElementTryAssignment(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleLocalSourceSliceElementTryAssignmentFunctionToBlocks(
                        stream,
                        sourceText,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithStorageTryAssignment(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleStorageTryAssignmentFunctionToBlocks(
                        stream,
                        sourceText,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithConstructedObjectFieldTryAssignment(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleConstructedObjectFieldTryAssignmentFunctionToBlocks(
                        stream,
                        sourceText,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else if (FunctionBodyStartsWithSourceSliceElementTryAssignment(stream, source, f))
                {
                    stack mut IrTable<BlockEmit> noRanges = new();
                    if (!LowerModuleSourceSliceElementTryAssignmentFunctionToBlocks(
                        stream,
                        sourceText,
                        source,
                        moduleFacts,
                        funcNames,
                        funcParamCounts,
                        functionCallContractFacts,
                        f,
                        instrs,
                        blocks,
                        noRanges,
                        false,
                        body))
                    {
                        return false;
                    }
                }
                else
                {
                    body = LowerFunctionWithLocalsWithEnums(stream, source, funcNames, funcParamCounts, functionCallContractFacts, funcTailFlags, isTailCallable, moduleFacts, f, instrs, blocks);
                    if (!body.Ok)
                    {
                        return false;
                    }
                }

                stack u32[0 max] instrCount = (u32[0 max])instrs.Count() - (firstInstr - 1);
                stack u32[0 max] blockCount = (u32[0 max])blocks.Count() - (firstBlock - 1);
                stack MirFuncId functionId = MirDefineFunction(funcs, MirBlockIdOf(body.EntryBlock), MirBlockIdOf(firstBlock), blockCount, MirValueIdOf(firstInstr), instrCount);
                if (functionId.Index() != functionNumber)
                {
                    return false;
                }
            }
        }

        f = f + 1;
    }

    stack mut u32[0 max] asmFunctionNumber = 0;
    stack mut u64[0 2 ** 63 - 1] asmScan = 0;
    while willexit (asmScan < tokenCount)
    {
        if (stream.KindAt(asmScan) == TokenKind.Fn)
        {
            asmFunctionNumber = asmFunctionNumber + 1;

            stack mut Compiler.Parsing.FunctionSignature signature = new();
            if (!ParseFunctionSignatureAt(stream, (u32[0 max])asmScan, signature))
            {
                return false;
            }

            if (signature.HasAsm())
            {
                stack mut AsmFunctionId asmFunctionId = new();
                if (!CollectAsmMetadataFromSignature(sourceText, stream, signature, MirFuncIdOf(asmFunctionNumber), asmMetadata, asmFunctionId))
                {
                    return false;
                }
            }
        }

        asmScan = asmScan + 1;
    }

    return true;
}

public fn bool BuildModulePackageTablesWithAsm(
    ascii source,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<MirFunction> funcs,
    mut borrow AsmMetadataTable asmMetadata)
{
    stack mut OwnedAscii sourceText = new();
    switch (sourceText.AppendAscii(source))
    {
        case MemoryStatus.Err(var copyError):
            return false;
        case MemoryStatus.Ok:
    }

    stack i8[min max][] sourceBytes = sourceText.AsSlice();
    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Err(var lexError):
            return false;
        case LexResult<TokenStream>.Ok(var stream):
            return BuildModulePackageTablesWithAsmStream(stream, sourceText.View(), sourceBytes, instrs, blocks, funcs, asmMetadata);
    }

    return false;
}

public fn bool BuildModulePackageImageWithAsm(ascii source, mut borrow IrTable<u8[0 max]> buf)
{
    stack mut IrTable<MirInstruction> instrs = new();
    stack mut IrTable<MirBlock> blocks = new();
    stack mut IrTable<MirFunction> funcs = new();
    stack mut IrTable<MirGlobal> globals = new();
    stack mut AsmMetadataTable asmMetadata = new();
    if (!BuildModulePackageTablesWithAsm(source, instrs, blocks, funcs, asmMetadata))
    {
        return false;
    }

    SerializePackageImageWithAsm(instrs, blocks, funcs, globals, asmMetadata, buf);
    return true;
}

// The CHECKED AST module path: the full front-end semantic gate (`SemanticallyValidStream`
// — names bind, calls match arity, no scope redeclares, function names are unique, every
// condition is boolean, no comparison feeds an integer operand) guards the AST module
// codegen, so a module is lowered ONLY if it passes. This is the canonical lex → analyze →
// lower pipeline for the AST path (the counterpart of the positional `CompileModuleChecked`,
// but lowering through `CompileModuleFromAstStream`). The gate catches a BROADER class than
// the AST path's own `ValidateModuleCalls` (e.g. a duplicate function name, an unbound name
// outside a call), while `ValidateModuleCalls` still enforces the lowering model's arity,
// argument-kind, and storage-contract limits. Lexes once.
public fn bool CompileModuleFromAstChecked(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            if (!SemanticallyValidStream(stream, sourceBytes))
            {
                return false;
            }

            return CompileModuleFromAstStream(stream, sourceText.View(), sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

// The unified path for a MULTI-STATEMENT function body `fn <name>(<params>) { (var <n> =
// <expr>;)* return <expr> }`. Parameters and `var` locals share one index space: the
// signature seeds the parameters; each `var` appends its name (so later statements resolve
// it), and at lower time its index is REDIRECTED — via `localOverrides` — to the SSA value
// its initializer produced (computed once, reused on each reference). The emitted function
// declares only the SIGNATURE parameters; locals are interior values, not parameters.
internal finite law u32[0 max] ProbeTypeKindCode(TypedSignatureTypeKind kind)
{
    switch (kind)
    {
        case TypedSignatureTypeKind.Void:
            return 1;
        case TypedSignatureTypeKind.Bool:
            return 2;
        case TypedSignatureTypeKind.Integer:
            return 3;
        case TypedSignatureTypeKind.Float:
            return 4;
        case TypedSignatureTypeKind.Text:
            return 5;
        case TypedSignatureTypeKind.Named:
            return 6;
        case TypedSignatureTypeKind.GenericParameter:
            return 7;
        case TypedSignatureTypeKind.RawPointer:
            return 8;
        case TypedSignatureTypeKind.FunctionPointer:
            return 9;
        case TypedSignatureTypeKind.Closure:
            return 10;
        case TypedSignatureTypeKind.Dynamic:
            return 11;
        case TypedSignatureTypeKind.FixedArray:
            return 12;
        case TypedSignatureTypeKind.Slice:
            return 13;
        case TypedSignatureTypeKind.Unknown:
            return 0;
    }
}

internal fn System.Memory.MemoryStatus AppendProbeFlag(mut borrow OwnedAscii sink, bool flag)
{
    if (flag)
    {
        return sink.AppendConstAscii("1");
    }

    return sink.AppendConstAscii("0");
}

internal fn System.Memory.MemoryStatus AppendSourceMemberPathFactProbeLines(
    ascii sourceText,
    borrow TokenStream stream,
    borrow i8[min max][] sourceBytes,
    borrow DeclarationList declarations,
    mut borrow OwnedAscii sink)
    where overlap(sourceText, sourceBytes)
{
    stack mut TypedMemberExpressionTable typedMembers = new();
    switch (BuildTypedMemberExpressions(sourceText, stream, declarations))
    {
        case ParseResult<TypedMemberExpressionTable>.Err(var memberError):
            try sink.AppendConstAscii("members=err\n");
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<TypedMemberExpressionTable>.Ok(var built):
            typedMembers = built;
    }

    try sink.AppendConstAscii("members=");
    try sink.AppendI64((i64[min max])typedMembers.Count());
    try sink.AppendConstAscii("\n");
    stack u64[0 2 ** 63 - 1] count = typedMembers.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        try sink.AppendConstAscii("row token=");
        try sink.AppendI64((i64[min max])typedMembers.MemberNameTokenAt(index));
        try sink.AppendConstAscii(" resolved=");
        try AppendProbeFlag(sink, typedMembers.IsResolvedAt(index));
        try sink.AppendConstAscii(" field=");
        try AppendProbeFlag(sink, typedMembers.IsFieldAt(index));
        try sink.AppendConstAscii(" kind=");
        try sink.AppendI64((i64[min max])ProbeTypeKindCode(typedMembers.TypeKindAt(index)));
        try sink.AppendConstAscii(" width=");
        try sink.AppendI64((i64[min max])typedMembers.BitWidthAt(index));
        try sink.AppendConstAscii(" ranged=");
        try AppendProbeFlag(sink, typedMembers.HasIntegerRangeAt(index));
        try sink.AppendConstAscii(" head=");
        try sink.AppendI64((i64[min max])typedMembers.TypeHeadTokenAt(index));
        try sink.AppendConstAscii(" primary=");
        try sink.AppendI64((i64[min max])typedMembers.TypePrimaryTokenAt(index));
        try sink.AppendConstAscii("\n");
    }

    stack mut IrTable<u32[0 max]> rowsByToken = new();
    stack mut IrTable<SourceMemberPathFact> memberPathFacts = new();
    if (!BuildSourceMemberPathFacts(sourceText, stream, sourceBytes, declarations, rowsByToken, memberPathFacts))
    {
        try sink.AppendConstAscii("facts=build-failed\n");
        return System.Memory.MemoryStatus.Ok;
    }

    try sink.AppendConstAscii("facts=");
    try sink.AppendI64((i64[min max])memberPathFacts.Count());
    try sink.AppendConstAscii("\n");
    stack u64[0 2 ** 63 - 1] factCount = memberPathFacts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] factIndex = 0; factIndex < factCount; factIndex += 1)
    {
        stack u32[0 max] factRow = (u32[0 max])(factIndex + 1);
        stack SourceMemberPathFact fact = memberPathFacts.Get(factRow);
        try sink.AppendConstAscii("fact kind=");
        try sink.AppendI64((i64[min max])ProbeTypeKindCode(fact.Kind));
        try sink.AppendConstAscii(" width=");
        try sink.AppendI64((i64[min max])fact.BitWidth);
        try sink.AppendConstAscii(" unsigned=");
        try AppendProbeFlag(sink, fact.IntegerIsUnsigned);
        try sink.AppendConstAscii(" hasrange=");
        try AppendProbeFlag(sink, fact.HasDeclaredRange);
        try sink.AppendConstAscii(" lower=");
        try sink.AppendI64(fact.DeclaredRangeLower);
        try sink.AppendConstAscii(" upper=");
        try sink.AppendI64(fact.DeclaredRangeUpperExclusive);
        try sink.AppendConstAscii("\n");
    }

    return System.Memory.MemoryStatus.Ok;
}

// Diagnostic probe for standalone member-path investigations: renders the
// typed member rows and the prevalidated member-path facts of `source` into
// `sink`, one line per row.
public fn bool ProbeSourceMemberPathFacts(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack mut DeclarationList declarations = new();
            stack mut TypedEnumPayloadTable enumPayloads = new();
            stack mut TypedEnumLayoutTable enumLayouts = new();
            stack mut IrTable<MirEnumLayoutFact> enumLayoutFacts = new();
            if (!BuildSourceModuleEnumLayoutInputs(sourceText.View(), stream, declarations, enumPayloads, enumLayouts, enumLayoutFacts))
            {
                return false;
            }

            switch (AppendSourceMemberPathFactProbeLines(sourceText.View(), stream, sourceBytes, declarations, sink))
            {
                case System.Memory.MemoryStatus.Ok:
                    return true;
                case System.Memory.MemoryStatus.Err(var probeError):
                    return false;
            }
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}

public fn bool CompileFunctionWithLocalsToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            stack i64[min max] fnIndex = FirstTokenOfKind(stream, TokenKind.Fn);
            if (fnIndex < 0)
            {
                return false;
            }

            // The same body lowering the module path uses, with EMPTY function tables (a
            // single function has no cross-function calls — any call resolves to 0 and is
            // rejected by the shared `ValidateModuleCalls`). Emitted as `@main`.
            stack mut SourceModuleLoweringFacts moduleFacts = new();
            if (!BuildSourceModuleLoweringFacts(sourceText.View(), stream, sourceBytes, moduleFacts))
            {
                return false;
            }

            stack mut IrTable<ParamName> noFuncs = new();
            stack mut IrTable<u32[0 max]> noFuncCounts = new();
            stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
            stack mut IrTable<u32[0 max]> noTailFlags = new();
            stack mut IrTable<MirInstruction> instrs = new();
            stack mut IrTable<MirBlock> blocks = new();
            stack mut IrTable<BlockEmit> blockRanges = new();
            stack mut bool emitBlockRanges = false;
            stack mut LoweredBody body = new();
            if (FunctionBodyStartsWithReturnTryExpression(stream, (u64[0 2 ** 63 - 1])fnIndex))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleReturnTryExpressionFunctionToBlocks(
                    stream,
                    sourceText.View(),
                    sourceBytes,
                    moduleFacts,
                    noFuncs,
                    noFuncCounts,
                    noFunctionCallContractFacts,
                    (u64[0 2 ** 63 - 1])fnIndex,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithLocalTryBinding(stream, sourceBytes, (u64[0 2 ** 63 - 1])fnIndex))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleLocalTryBindingFunctionToBlocks(
                    stream,
                    sourceText.View(),
                    sourceBytes,
                    moduleFacts,
                    noFuncs,
                    noFuncCounts,
                    noFunctionCallContractFacts,
                    (u64[0 2 ** 63 - 1])fnIndex,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithLocalTryAssignment(stream, sourceBytes, (u64[0 2 ** 63 - 1])fnIndex))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleLocalTryAssignmentFunctionToBlocks(
                    stream,
                    sourceText.View(),
                    sourceBytes,
                    moduleFacts,
                    noFuncs,
                    noFuncCounts,
                    noFunctionCallContractFacts,
                    (u64[0 2 ** 63 - 1])fnIndex,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithLocalSourceSliceElementTryAssignment(stream, sourceBytes, (u64[0 2 ** 63 - 1])fnIndex))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleLocalSourceSliceElementTryAssignmentFunctionToBlocks(
                    stream,
                    sourceText.View(),
                    sourceBytes,
                    moduleFacts,
                    noFuncs,
                    noFuncCounts,
                    noFunctionCallContractFacts,
                    (u64[0 2 ** 63 - 1])fnIndex,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithStorageTryAssignment(stream, sourceBytes, (u64[0 2 ** 63 - 1])fnIndex))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleStorageTryAssignmentFunctionToBlocks(
                    stream,
                    sourceText.View(),
                    sourceBytes,
                    moduleFacts,
                    noFuncs,
                    noFuncCounts,
                    noFunctionCallContractFacts,
                    (u64[0 2 ** 63 - 1])fnIndex,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithSourceSliceElementTryAssignment(stream, sourceBytes, (u64[0 2 ** 63 - 1])fnIndex))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleSourceSliceElementTryAssignmentFunctionToBlocks(
                    stream,
                    sourceText.View(),
                    sourceBytes,
                    moduleFacts,
                    noFuncs,
                    noFuncCounts,
                    noFunctionCallContractFacts,
                    (u64[0 2 ** 63 - 1])fnIndex,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyStartsWithConstructedObjectFieldTryAssignment(stream, sourceBytes, (u64[0 2 ** 63 - 1])fnIndex))
            {
                stack mut IrTable<BlockEmit> noRanges = new();
                if (!LowerModuleConstructedObjectFieldTryAssignmentFunctionToBlocks(
                    stream,
                    sourceText.View(),
                    sourceBytes,
                    moduleFacts,
                    noFuncs,
                    noFuncCounts,
                    noFunctionCallContractFacts,
                    (u64[0 2 ** 63 - 1])fnIndex,
                    instrs,
                    blocks,
                    noRanges,
                    false,
                    body))
                {
                    return false;
                }
            }
            else if (FunctionBodyHasLocalPrefixedTerminalIf(stream, (u64[0 2 ** 63 - 1])fnIndex)
                || FunctionBodyStartsWithIfStatement(stream, (u64[0 2 ** 63 - 1])fnIndex))
            {
                if (!LowerModuleLocalIfReturnFunctionToBlocks(
                    stream,
                    sourceBytes,
                    moduleFacts,
                    noFuncs,
                    noFuncCounts,
                    noFunctionCallContractFacts,
                    noTailFlags,
                    false,
                    (u64[0 2 ** 63 - 1])fnIndex,
                    instrs,
                    blocks,
                    blockRanges,
                    true,
                    body))
                {
                    return false;
                }

                emitBlockRanges = true;
            }
            else
            {
                body = LowerFunctionWithLocalsWithEnums(stream, sourceBytes, noFuncs, noFuncCounts, noFunctionCallContractFacts, noTailFlags, false, moduleFacts, (u64[0 2 ** 63 - 1])fnIndex, instrs, blocks);
            }

            if (!body.Ok)
            {
                return false;
            }

            stack u32[0 max] instrCount = (u32[0 max])instrs.Count();
            stack mut Compiler.Parsing.FunctionSignature signature = new();
            if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
            {
                return false;
            }

            stack mut IrTable<ValueFacts> paramFacts = new();
            if (!BuildParamRangeFacts(stream, sourceBytes, signature, paramFacts))
            {
                return false;
            }

            stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
            if (!BuildParamAbiFacts(stream, sourceBytes, signature, paramAbiFacts))
            {
                return false;
            }

            stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
            if (!BuildDistinctStorageFacts(stream, sourceBytes, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
            {
                return false;
            }

            stack ValueFacts returnFacts = FunctionReturnRangeFact(stream, sourceBytes, signature);
            stack mut IrTable<ValueFacts> valueFacts = new();
            stack mut IrTable<ValueFacts> globalFacts = new();
            stack mut IrTable<ValueFacts> functionReturnFacts = new();
            if (!BuildMirValueRangeFacts(instrs, paramFacts, valueFacts, globalFacts, functionReturnFacts))
            {
                return false;
            }

            if (!ValidateBlockReturnRangeFacts(returnFacts, blocks, valueFacts))
            {
                return false;
            }

            stack mut IrTable<LlvmRangeMetadata> rangeMetadata = new();
            stack mut IrTable<FunctionEffectFacts> noFunctionEffectFacts = new();
            stack mut IrTable<FunctionCallContractFacts> noFunctionCallContractFacts = new();
            stack mut IrTable<FunctionLinkageFacts> noFunctionLinkageFacts = new();
            stack mut IrTable<FunctionCallingConventionFacts> noFunctionCallingConventionFacts = new();
            stack FunctionEffectFacts functionEffects = FunctionEffectsFromSignatureAndInstructionRange(signature, instrs, 1, instrCount);
            if (emitBlockRanges)
            {
                switch (EmitLlvmBlocksWithRangeFactsCoreWithEnumLayouts(
                    instrs,
                    noTailFlags,
                    noFunctionEffectFacts,
                    noFunctionCallContractFacts,
                    noFunctionLinkageFacts,
                    noFunctionCallingConventionFacts,
                    blocks,
                    "main",
                    false,
                    returnFacts,
                    paramFacts,
                    paramAbiFacts,
                    distinctStorageFacts,
                    valueFacts,
                    globalFacts,
                    functionReturnFacts,
                    moduleFacts.EnumLayoutFacts,
                    rangeMetadata,
                    functionEffects,
                    body.ParamCount,
                    blockRanges,
                    sink))
                {
                    case MemoryStatus.Err(var blockEmitError):
                        return false;
                    case MemoryStatus.Ok:
                }

                switch (EmitLlvmRangeMetadataDefinitions(rangeMetadata, sink))
                {
                    case MemoryStatus.Ok:
                        return true;
                    case MemoryStatus.Err(var blockMetadataError):
                        return false;
                }
            }

            switch (EmitLlvmDefinitionWithRangeFactsCoreWithEnumLayouts(
                instrs,
                noTailFlags,
                noFunctionEffectFacts,
                noFunctionCallContractFacts,
                noFunctionLinkageFacts,
                noFunctionCallingConventionFacts,
                blocks,
                "main",
                false,
                returnFacts,
                paramFacts,
                paramAbiFacts,
                distinctStorageFacts,
                valueFacts,
                globalFacts,
                functionReturnFacts,
                moduleFacts.EnumLayoutFacts,
                rangeMetadata,
                functionEffects,
                body.ParamCount,
                body.EntryBlock,
                1,
                instrCount,
                sink))
            {
                case MemoryStatus.Ok:
                    switch (EmitLlvmRangeMetadataDefinitions(rangeMetadata, sink))
                    {
                        case MemoryStatus.Ok:
                            return true;
                        case MemoryStatus.Err(var metadataError):
                            return false;
                    }
                case MemoryStatus.Err(var error):
                    return false;
            }
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}
public fn bool LowerModuleToLlvm(ascii source, mut borrow OwnedAscii sink)
{
    stack mut OwnedAscii sourceText = new();
    stack System.Memory.MemoryStatus copyStatus = sourceText.AppendAscii(source);
    stack i8[min max][] sourceBytes = sourceText.AsSlice();

    switch (Lex(sourceBytes))
    {
        case LexResult<TokenStream>.Ok(var stream):
            return LowerModuleStream(stream, sourceBytes, sink);
        case LexResult<TokenStream>.Err(var lexError):
            return false;
    }
}
