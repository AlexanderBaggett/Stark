                stack MirValueId scalarStorage = MirStackAlloc(instrs, scalarAllocationSize, scalarAllocationAlign);
                stack bool scalarMutable = SelfHostedLocalDeclarationHasMut(stream, cursor, statementEnd);
                stack u32[0 max] scalarLocalIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] scalarLocalOrdinal = localRoots.Add(0);
                stack u32[0 max] scalarLocalType = localTypes.Add(scalarLocalTypeCode);
                stack u32[0 max] scalarOverrideValue = localOverrideValues.Add(scalarStorage.Index());
                stack mut ValueFacts scalarFacts = new();
                if (!scalarMutable)
