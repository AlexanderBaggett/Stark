                stack mut u32[0 max] rawPointerAliasFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
                stack mut u32[0 max] rawPointerAliasElementSize = 0;
                stack mut u32[0 max] rawPointerAliasElementAlignment = 0;
                stack mut bool rawPointerAliasNestedMutable = false;
                stack mut u32[0 max] rawPointerAliasNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
                stack mut u32[0 max] rawPointerAliasNestedElementSize = 0;
                stack mut u32[0 max] rawPointerAliasNestedElementAlignment = 0;
                stack mut bool rawPointerAliasHasElementCount = false;
