import Compiler.Ir
import Compiler.Lexing
import Compiler.Parsing
import Compiler.Mir.Builder
import Compiler.Mir.EnumLayout
import Compiler.Mir.Facts
import Compiler.Mir.LlvmBlocks
import Compiler.Mir.LlvmFacts
import Compiler.Mir.LlvmFunctions
import Compiler.Mir.Model
import Compiler.Mir.SourceExpressions
import Compiler.Mir.SourceExpressionLowering
import Compiler.Mir.SourceFunctionContext
import Compiler.Mir.SourceLocalLowering
import Compiler.Mir.SourceLocalStorageLayout
import Compiler.Mir.SourceLocalExpressionParsing
import Compiler.Mir.SourceLocalInitialization
import Compiler.Mir.SourceLocalMutation
import Compiler.Mir.SourceLocalArena
import Compiler.Mir.SourceMemberFacts
import Compiler.Mir.SourceModuleFacts
import Compiler.Mir.SourceRangeFacts
import Compiler.Mir.SourceSemanticProbes
import Compiler.Mir.SourceSymbols
import Compiler.Mir.SourceIfCore
import Compiler.Mir.SourceIfShapes
import Compiler.Mir.SourceIfParsing
import Compiler.Mir.SourceIfStorageMutation
import Compiler.Mir.SourceIfAssignmentLowering
import Compiler.Mir.SourceIfFunctionLowering
import Compiler.Typing.TypedEnumLayoutModel
import System.Memory
import System.Text
module Compiler.Mir.SourceIfReturnLowering

internal fn bool LowerModuleLocalIfStatementFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (FunctionBodyStartsWithMultiLocalIfStatementAssignment(stream, source, funcNames, fnIndex))
    {
        stack mut LoweredBody recursiveNestedMultiBody = new();
        if (LowerModuleRecursiveNestedMultiLocalIfStatementFunctionToBlocks(
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            fnIndex,
            instrs,
            blocks,
            ranges,
            recordRanges,
            recursiveNestedMultiBody))
        {
            body = recursiveNestedMultiBody;
            return true;
        }

        stack mut LoweredBody nestedMultiBody = new();
        if (LowerModuleNestedMultiLocalIfStatementFunctionToBlocks(
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            fnIndex,
            instrs,
            blocks,
            ranges,
            recordRanges,
            nestedMultiBody))
        {
            body = nestedMultiBody;
            return true;
        }

        return LowerModuleMultiLocalIfStatementFunctionToBlocks(
            stream,
            source,
            funcNames,
            funcParamCounts,
            functionCallContractFacts,
            fnIndex,
            instrs,
            blocks,
            ranges,
            recordRanges,
            body);
    }

    if (!FunctionBodyStartsWithLocalIfStatementAssignment(stream, source, funcNames, fnIndex))
    {
        return false;
    }

    stack mut LoweredBody nestedBody = new();
    if (LowerModuleRecursiveNestedLocalIfStatementFunctionToBlocks(
        stream,
        source,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        nestedBody))
    {
        body = nestedBody;
        return true;
    }

    if (LowerModuleNestedLocalIfStatementFunctionToBlocks(
        stream,
        source,
        funcNames,
        funcParamCounts,
        functionCallContractFacts,
        fnIndex,
        instrs,
        blocks,
        ranges,
        recordRanges,
        nestedBody))
    {
        body = nestedBody;
        return true;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        if (braceIndex >= nextFnIndex)
        {
            return false;
        }

        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack u64[0 2 ** 63 - 1] localStart = (u64[0 2 ** 63 - 1])braceIndex + 1;
    stack mut u64[0 2 ** 63 - 1] localEnd = localStart;
    if (!FindSelfHostedStatementEnd(stream, localStart, limit, localEnd))
    {
        return false;
    }

    stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, localStart, localEnd);
    if (localNameToken == 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] assignToken = localEnd;
    if (stream.KindAt(localStart) != TokenKind.Var || !FindSelfHostedStatementAssign(stream, localStart, localEnd, assignToken))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] ifIndex = localEnd + 1;
    if (stream.KindAt(ifIndex) != TokenKind.If)
    {
        return false;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
    stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
    if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
    {
        return false;
    }

    stack mut IrTable<ExprNode> nodes = new();
    stack ExprParseResult initResult = ParseExprIn(stream, source, nodes, params, funcNames, assignToken + 1);
    if (initResult.Next != localEnd
        || params.Count() != signatureParamCount
        || !ExprNodeCanBeDiscardedIfOverwritten(nodes, initResult.NodeId))
    {
        return false;
    }

    stack mut ParsedIfReturnArms arms = new();
    stack mut IrTable<u32[0 max]> armLocalRoots = new();
    if (!TryParseIfAssignmentArms(stream, source, nodes, params, signatureParamCount, funcNames, ifIndex, localNameToken, armLocalRoots, arms))
    {
        return false;
    }

    if (params.Count() != signatureParamCount)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] returnIndex = arms.ElseArm.Next;
    if (stream.KindAt(returnIndex) != TokenKind.Return)
    {
        return false;
    }

    if (!ResolveParamWithMergedRawPointerFactsForAssignedNodes(
        params,
        source,
        nameStart,
        nameLength,
        nodes,
        arms.ThenArm.NodeId,
        arms.ElseArm.NodeId,
        (u32[0 max])signatureParamCount))
    {
        return false;
    }

    stack ExprParseResult returnRoot = ParseExprIn(stream, source, nodes, params, funcNames, returnIndex + 1);
    stack mut u64[0 2 ** 63 - 1] afterReturn = returnRoot.Next;
    if (stream.KindAt(afterReturn) == TokenKind.Semi)
    {
        afterReturn = afterReturn + 1;
    }

    if (stream.KindAt(afterReturn) != TokenKind.RBrace || params.Count() != signatureParamCount + 1)
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> localTypes = new();
    if (!SeedParamLocalTypesFromSignature(stream, source, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    stack ExprType initType = TypeOfNodeWithLocals(nodes, initResult.NodeId, localTypes);
    stack ExprType thenType = TypeOfIfArmWithLocals(
        nodes,
        arms.ThenArm.NodeId,
        armLocalRoots,
        arms.ThenLocalRootStart,
        arms.ThenLocalRootCount,
        localTypes,
        (u32[0 max])signatureParamCount);
    stack ExprType elseType = TypeOfIfArmWithLocals(
        nodes,
        arms.ElseArm.NodeId,
        armLocalRoots,
        arms.ElseLocalRootStart,
        arms.ElseLocalRootCount,
        localTypes,
        (u32[0 max])signatureParamCount);
    stack bool allInt = initType == ExprType.IntType && thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool allBool = initType == ExprType.BoolType && thenType == ExprType.BoolType && elseType == ExprType.BoolType;
    stack bool allPtr = initType == ExprType.PtrType && thenType == ExprType.PtrType && elseType == ExprType.PtrType;
    if (!allInt && !allBool && !allPtr)
    {
        return false;
    }

    stack mut u32[0 max] localTypeCode = SourceLocalTypeCodeForNodeWithLocals(nodes, initResult.NodeId, localTypes);
    if (allBool)
    {
        localTypeCode = SourceLocalTypeCodeBool();
    }
    else if (allPtr)
    {
        localTypeCode = SourceLocalTypeCodePointer();
    }
    else
    {
        stack u32[0 max] thenTypeCode = SourceLocalTypeCodeForIfArmWithLocals(
            nodes,
            arms.ThenArm.NodeId,
            armLocalRoots,
            arms.ThenLocalRootStart,
            arms.ThenLocalRootCount,
            localTypes,
            (u32[0 max])signatureParamCount);
        stack u32[0 max] elseTypeCode = SourceLocalTypeCodeForIfArmWithLocals(
            nodes,
            arms.ElseArm.NodeId,
            armLocalRoots,
            arms.ElseLocalRootStart,
            arms.ElseLocalRootCount,
            localTypes,
            (u32[0 max])signatureParamCount);
        if (localTypeCode != thenTypeCode || localTypeCode != elseTypeCode)
        {
            localTypeCode = SourceLocalTypeCodeInt();
        }
    }

    if (localTypes.Add(localTypeCode) == 0)
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    if (!ValidateModuleCallsForRoot(nodes, initResult.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts)
        || !ValidateModuleCallsForRoot(nodes, arms.Condition.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts)
        || !ValidateIfArmModuleCallsWithLocals(
            nodes,
            arms.ThenArm.NodeId,
            armLocalRoots,
            arms.ThenLocalRootStart,
            arms.ThenLocalRootCount,
            localTypes,
            (u32[0 max])signatureParamCount,
            funcParamCounts,
            functionCallContractFacts,
            distinctStorageFacts)
        || !ValidateIfArmModuleCallsWithLocals(
            nodes,
            arms.ElseArm.NodeId,
            armLocalRoots,
            arms.ElseLocalRootStart,
            arms.ElseLocalRootCount,
            localTypes,
            (u32[0 max])signatureParamCount,
            funcParamCounts,
            functionCallContractFacts,
            distinctStorageFacts)
        || !ValidateModuleCallsForRoot(nodes, returnRoot.NodeId, funcParamCounts, functionCallContractFacts, localTypes, distinctStorageFacts))
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, arms.Condition.NodeId, localTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType rootType = TypeOfNodeWithLocals(nodes, returnRoot.NodeId, localTypes);
    if (rootType == ExprType.ErrorType || rootType == ExprType.PtrType)
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut IrTable<u32[0 max]> noOverrides = new();
    stack MirValueId condValue = LowerExprNodeWithTypesAndLocals(nodes, arms.Condition.NodeId, instrs, localTypes, noOverrides);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId thenValue = LowerIfArmValueWithLocals(
        nodes,
        arms.ThenArm.NodeId,
        armLocalRoots,
        arms.ThenLocalRootStart,
        arms.ThenLocalRootCount,
        localTypes,
        (u32[0 max])signatureParamCount,
        instrs);
    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);

    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack MirValueId elseValue = LowerIfArmValueWithLocals(
        nodes,
        arms.ElseArm.NodeId,
        armLocalRoots,
        arms.ElseLocalRootStart,
        arms.ElseLocalRootCount,
        localTypes,
        (u32[0 max])signatureParamCount,
        instrs);
    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack u32[0 max] mergeFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirType phiType = MirType.I64;
    stack mut MirType knownPhiType = MirType.I64;
    if (TryMirTypeForSourceLocalValueTypeCode(localTypeCode, knownPhiType))
    {
        phiType = knownPhiType;
    }

    stack MirValueId phi = MirPhi2Typed(instrs, phiType, thenValue, MirBlockIdOf(firstBlock + 1), elseValue, MirBlockIdOf(firstBlock + 2));

    stack mut IrTable<u32[0 max]> localOverrides = new();
    stack mut u64[0 2 ** 63 - 1] p = 0;
    while willexit (p < signatureParamCount)
    {
        if (localOverrides.Add(0) == 0)
        {
            return false;
        }

        p = p + 1;
    }

    if (localOverrides.Add(phi.Index()) == 0)
    {
        return false;
    }

    stack MirValueId value = LowerExprNodeWithTypesAndLocals(nodes, returnRoot.NodeId, instrs, localTypes, localOverrides);
    stack mut MirValueId returnValue = value;
    if (rootType == ExprType.BoolType)
    {
        returnValue = MirZExt(instrs, value);
    }

    stack u32[0 max] mergeCount = (u32[0 max])instrs.Count() - (mergeFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack MirBlockId thenBlock = MirBranchBlock(blocks, MirBlockIdOf(firstBlock + 3));
    stack MirBlockId elseBlock = MirBranchBlock(blocks, MirBlockIdOf(firstBlock + 3));
    stack MirBlockId mergeBlock = MirReturnBlock(blocks, returnValue);

    if (recordRanges)
    {
        stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
        stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));
        stack u32[0 max] r4 = ranges.Add(MakeBlockEmit(mergeBlock.Index(), mergeFirst, mergeCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = condValue.Index();
    body.ThenValue = phi.Index();
    body.ElseValue = returnValue.Index();
    return true;
}

internal fn bool LowerModuleLocalIfReturnFunctionToBlocks(
    borrow TokenStream stream,
    borrow i8[min max][] source,
    borrow SourceModuleLoweringFacts moduleFacts,
    borrow IrTable<ParamName> funcNames,
    borrow IrTable<u32[0 max]> funcParamCounts,
    borrow IrTable<FunctionCallContractFacts> functionCallContractFacts,
    borrow IrTable<u32[0 max]> funcTailFlags,
    bool isTailCallable,
    u64[0 2 ** 63 - 1] fnIndex,
    mut borrow IrTable<MirInstruction> instrs,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<BlockEmit> ranges,
    bool recordRanges,
    out LoweredBody body)
{
    body = new();
    if (!FunctionBodyHasLocalPrefixedTerminalIf(stream, fnIndex)
        && !FunctionBodyStartsWithIfStatement(stream, fnIndex))
    {
        return false;
    }

    stack i64[min max] braceIndex = FirstTokenOfKindAfter(stream, TokenKind.LBrace, fnIndex);
    if (braceIndex < 0)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] limit = stream.Count();
    stack i64[min max] nextFnIndex = FirstTokenOfKindAfter(stream, TokenKind.Fn, fnIndex);
    if (nextFnIndex >= 0)
    {
        limit = (u64[0 2 ** 63 - 1])nextFnIndex;
    }

    stack mut Compiler.Parsing.FunctionSignature signature = new();
    if (!ParseFunctionSignatureAt(stream, (u32[0 max])fnIndex, signature))
    {
        return false;
    }

    stack mut IrTable<ParamAbiFacts> paramAbiFacts = new();
    if (!BuildParamAbiFacts(stream, source, signature, paramAbiFacts))
    {
        return false;
    }

    stack mut IrTable<ParamName> params = new();
    SeedSignatureParamsFromParsed(stream, source, signature, params);
    stack u64[0 2 ** 63 - 1] signatureParamCount = params.Count();

    stack mut IrTable<ExprNode> nodes = new();
    stack mut IrTable<u32[0 max]> localRoots = new();
    stack mut IrTable<u32[0 max]> localTypes = new();
    stack mut IrTable<ArenaDynamicLocal> arenaDynamicLocals = new();
    stack mut IrTable<StackObjectFieldInitializer> stackObjectFieldInitializers = new();
    stack mut IrTable<ScalarStorageLocal> scalarStorageLocals = new();
    stack mut IrTable<ScalarStorageInitializer> scalarStorageInitializers = new();
    stack mut IrTable<ScalarStorageAssignment> scalarStorageAssignments = new();
    stack mut IrTable<FixedArrayStorageLocal> fixedArrayStorageLocals = new();
    stack mut IrTable<FixedArrayStorageInitializer> fixedArrayStorageInitializers = new();
    stack mut IrTable<EnumStorageLocal> enumStorageLocals = new();
    stack mut IrTable<EnumStorageInitializer> enumStorageInitializers = new();
    stack mut IrTable<EnumStorageAssignment> enumStorageAssignments = new();
    stack mut IrTable<ConstructedObjectLocal> constructedObjectLocals = new();
    stack mut IrTable<SourceSliceDescriptorLocal> sliceDescriptorLocals = new();
    stack mut IrTable<ConstructedObjectFieldAssignment> constructedObjectFieldAssignments = new();
    stack mut IrTable<SourceStorageMutationStatement> storageMutationStatements = new();
    stack mut IrTable<u32[0 max]> localOverrideValues = new();
    stack mut bool usesArenaFrame = false;
    if (!SeedParamLocalTypesFromSignatureWithDeclarations(stream, source, moduleFacts, signature, paramAbiFacts, signatureParamCount, localTypes))
    {
        return false;
    }

    if (!AddSignatureSliceParamDescriptors(stream, source, signature, paramAbiFacts, sliceDescriptorLocals))
    {
        return false;
    }

    stack mut IrTable<ValueFacts> sourceValueFacts = new();
    if (!BuildParamRangeFacts(stream, source, signature, sourceValueFacts))
    {
        return false;
    }

    stack u32[0 max] firstBlock = (u32[0 max])blocks.Count() + 1;
    stack u32[0 max] entryFirst = (u32[0 max])instrs.Count() + 1;
    stack mut u64[0 2 ** 63 - 1] cursor = (u64[0 2 ** 63 - 1])braceIndex + 1;
    while willexit (cursor < limit && TokenStartsSelfHostedLocal(stream.KindAt(cursor)))
    {
        stack mut u64[0 2 ** 63 - 1] statementEnd = cursor;
        if (!FindSelfHostedStatementEnd(stream, cursor, limit, statementEnd))
        {
            return false;
        }

        stack u32[0 max] localNameToken = FindSelfHostedLocalNameToken(stream, cursor, statementEnd);
        if (localNameToken == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] nameStart = stream.StartAt((u64[0 2 ** 63 - 1])localNameToken);
        stack u64[0 2 ** 63 - 1] nameLength = stream.LengthAt((u64[0 2 ** 63 - 1])localNameToken);
        if (ParamIndexOf(params, source, nameStart, nameLength) >= 0)
        {
            return false;
        }

        stack TokenKind localStorage = stream.KindAt(cursor);
        stack mut u64[0 2 ** 63 - 1] assignToken = statementEnd;
        stack bool hasAssign = FindSelfHostedStatementAssign(stream, cursor, statementEnd, assignToken);
        if (localStorage == TokenKind.Var)
        {
            if (!hasAssign)
            {
                return false;
            }

            stack u64[0 2 ** 63 - 1] beforeInit = params.Count();
            stack ExprParseResult varExpr = ParseConstructedObjectExprWithEnumsAndSlicesIn(stream, source, nodes, params, funcNames, constructedObjectLocals, sliceDescriptorLocals, localTypes, sourceValueFacts, moduleFacts, assignToken + 1);
            if (params.Count() != beforeInit)
            {
                return false;
            }

            stack ExprType varType = TypeOfNodeWithLocals(nodes, varExpr.NodeId, localTypes);
            stack mut bool rawPointerAliasMutable = false;
            stack mut u32[0 max] rawPointerAliasFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
            stack mut u32[0 max] rawPointerAliasElementSize = 0;
            stack mut u32[0 max] rawPointerAliasElementAlignment = 0;
            stack mut bool rawPointerAliasNestedMutable = false;
            stack mut u32[0 max] rawPointerAliasNestedFieldTypeCode = SourceResolvedFieldTypeCodeInvalid();
            stack mut u32[0 max] rawPointerAliasNestedElementSize = 0;
            stack mut u32[0 max] rawPointerAliasNestedElementAlignment = 0;
            stack mut bool rawPointerAliasHasElementCount = false;
            stack mut bool rawPointerAliasElementCountIsParam = false;
            stack mut u32[0 max] rawPointerAliasElementCountLiteral = 0;
            stack mut u32[0 max] rawPointerAliasElementCountParamIndex = 0;
            stack bool rawPointerAlias = varType == ExprType.PtrType
                && TryGetRawPointerFactsForNodeWithNested(
                    nodes,
                    params,
                    varExpr.NodeId,
                    rawPointerAliasMutable,
                    rawPointerAliasFieldTypeCode,
                    rawPointerAliasElementSize,
                    rawPointerAliasElementAlignment,
                    rawPointerAliasNestedMutable,
                    rawPointerAliasNestedFieldTypeCode,
                    rawPointerAliasNestedElementSize,
                    rawPointerAliasNestedElementAlignment);
            if (varType == ExprType.ErrorType || (varType == ExprType.PtrType && !rawPointerAlias))
            {
                return false;
            }

            stack mut u32[0 max] localIndex = 0;
            if (rawPointerAlias)
            {
                if (!TryGetRawPointerElementCountFactsForNameNode(
                    nodes,
                    params,
                    varExpr.NodeId,
                    rawPointerAliasHasElementCount,
                    rawPointerAliasElementCountIsParam,
                    rawPointerAliasElementCountLiteral,
                    rawPointerAliasElementCountParamIndex))
                {
                    rawPointerAliasHasElementCount = false;
                }

                localIndex = ResolveParamWithRawPointerElementAndCountAndNestedFacts(
                    params,
                    source,
                    nameStart,
                    nameLength,
                    rawPointerAliasMutable,
                    rawPointerAliasFieldTypeCode,
                    rawPointerAliasElementSize,
                    rawPointerAliasElementAlignment,
                    rawPointerAliasHasElementCount,
                    rawPointerAliasElementCountIsParam,
                    rawPointerAliasElementCountLiteral,
                    rawPointerAliasElementCountParamIndex,
                    rawPointerAliasNestedMutable,
                    rawPointerAliasNestedFieldTypeCode,
                    rawPointerAliasNestedElementSize,
                    rawPointerAliasNestedElementAlignment);
            }
            else
            {
                localIndex = ResolveParam(params, source, nameStart, nameLength);
            }

            stack u32[0 max] addedRoot = localRoots.Add(varExpr.NodeId);
            stack u32[0 max] addedOverrideValue = localOverrideValues.Add(0);
            stack mut ValueFacts localFacts = new();
            if (!TryBuildSourceValueFactsForNode(nodes, varExpr.NodeId, sourceValueFacts, localFacts)
                && varType == ExprType.BoolType)
            {
                localFacts.SetIntegerRange(0, 2);
            }

            if (sourceValueFacts.Add(localFacts) == 0)
            {
                return false;
            }

            if (localTypes.Add(SourceLocalTypeCodeForNodeWithLocals(nodes, varExpr.NodeId, localTypes)) == 0)
            {
                return false;
            }
        }
        else
        {
            stack mut u32[0 max] dynamicCapacity = 0;
            stack mut u32[0 max] dynamicAlignment = 0;
            stack u32[0 max] dynamicElementTypeToken = FindSelfHostedDynamicElementTypeToken(stream, cursor, statementEnd);
            if (dynamicElementTypeToken != 0 && TryParseArenaSelectorCapacity(stream, source, cursor, statementEnd, dynamicCapacity, dynamicAlignment))
            {
                if (signature.LawKind() || localStorage == TokenKind.Heap || localStorage == TokenKind.Static || localStorage == TokenKind.Register || localStorage == TokenKind.Arena)
                {
                    return false;
                }

                stack u32[0 max] elementSize = TypeKnownByteExtentForLocal(stream, source, dynamicElementTypeToken);
                stack u32[0 max] elementAlign = TypeKnownByteAlignment(stream, source, dynamicElementTypeToken);
                if (elementSize == 0 || elementAlign == 0)
                {
                    return false;
                }

                if (dynamicAlignment == 0)
                {
                    dynamicAlignment = elementAlign;
                }

                if (dynamicAlignment < elementAlign || !IsPowerOfTwoU32(dynamicAlignment))
                {
                    return false;
                }

                if (!usesArenaFrame)
                {
                    stack MirValueId frame = MirArenaFrameEnter(instrs);
                    usesArenaFrame = true;
                }

                stack MirValueId storage = MirArenaDynamicStorageInit(instrs, dynamicCapacity, elementSize, dynamicAlignment);
                stack u32[0 max] localIndex = ResolveParam(params, source, nameStart, nameLength);
                stack u32[0 max] nonValueRoot = localRoots.Add(0);
                stack u32[0 max] nonValueType = localTypes.Add(2);
                stack u32[0 max] dynamicOverrideValue = localOverrideValues.Add(0);
                if (sourceValueFacts.Add(new ValueFacts()) == 0)
                {
                    return false;
                }

                stack mut ArenaDynamicLocal dynamicLocal = new();
                dynamicLocal.Start = nameStart;
                dynamicLocal.Length = nameLength;
                dynamicLocal.StorageValue = storage.Index();
                dynamicLocal.ElementSize = elementSize;
                dynamicLocal.Alignment = dynamicAlignment;
                stack u32[0 max] addedDynamicLocal = arenaDynamicLocals.Add(dynamicLocal);

