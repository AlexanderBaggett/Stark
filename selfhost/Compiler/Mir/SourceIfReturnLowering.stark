        }

        stack u64[0 2 ** 63 - 1] storageLocalCount = localRoots.Count();
        stack mut u64[0 2 ** 63 - 1] storageLocalIndex = 0;
        stack mut u32[0 max] storageNextStackObjectInitializer = 1;
        stack mut u32[0 max] storageNextScalarStorageInitializer = 1;
        stack mut u32[0 max] storageNextFixedArrayStorageInitializer = 1;
        stack mut u32[0 max] storageNextEnumStorageInitializer = 1;
        while willexit (storageLocalIndex < storageLocalCount)
        {
            stack u32[0 max] storageLocalRoot = localRoots.Get((u32[0 max])(storageLocalIndex + 1));
            if (storageLocalRoot == 0)
            {
                stack mut u32[0 max] storageOverride = 0;
                if (localOverrideValues.Contains((u32[0 max])(storageLocalIndex + 1)))
                {
                    storageOverride = localOverrideValues.Get((u32[0 max])(storageLocalIndex + 1));
                }

                if (storageLocalOverrides.Add(storageOverride) == 0)
                {
                    return false;
                }
            }
            else
            {
                stack MirValueId storageVarValue = LowerExprNodeWithCallContext(
                    nodes,
                    storageLocalRoot,
                    instrs,
                    storageLoweringLocalTypes,
                    storageLocalOverrides,
                    functionCallContractFacts,
                    storageSliceArgumentLocals);
                if (storageLocalOverrides.Add(storageVarValue.Index()) == 0)
                {
                    return false;
                }
            }

            storageNextScalarStorageInitializer = LowerScalarStorageInitializersForLocalWithCallContext(
                scalarStorageInitializers,
                (u32[0 max])(storageLocalIndex + 1),
                storageNextScalarStorageInitializer,
                nodes,
                instrs,
                storageLoweringLocalTypes,
                storageLocalOverrides,
                functionCallContractFacts,
                storageSliceArgumentLocals);

            storageNextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
                fixedArrayStorageInitializers,
                (u32[0 max])(storageLocalIndex + 1),
                storageNextFixedArrayStorageInitializer,
                nodes,
                instrs,
                storageLoweringLocalTypes,
                storageLocalOverrides,
                functionCallContractFacts,
                storageSliceArgumentLocals);

            storageNextEnumStorageInitializer = LowerEnumStorageInitializersForLocalWithCallContext(
                enumStorageInitializers,
                (u32[0 max])(storageLocalIndex + 1),
                storageNextEnumStorageInitializer,
                nodes,
                instrs,
                storageLoweringLocalTypes,
                storageLocalOverrides,
                functionCallContractFacts,
                storageSliceArgumentLocals);

            storageNextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
                stackObjectFieldInitializers,
                (u32[0 max])(storageLocalIndex + 1),
                storageNextStackObjectInitializer,
                nodes,
                instrs,
                storageLoweringLocalTypes,
                storageLocalOverrides,
                functionCallContractFacts,
                storageSliceArgumentLocals);
            storageLocalIndex = storageLocalIndex + 1;
        }

        if ((u64[0 2 ** 63 - 1])(storageNextScalarStorageInitializer - 1) != scalarStorageInitializers.Count())
        {
            return false;
        }

        if ((u64[0 2 ** 63 - 1])(storageNextEnumStorageInitializer - 1) != enumStorageInitializers.Count())
        {
            return false;
        }

        if ((u64[0 2 ** 63 - 1])(storageNextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
        {
            return false;
        }

        stack mut IrTable<SourceStorageMutationStatement> prefixStorageMutationStatements = new();
        stack mut u32[0 max] prefixStorageMutationIndex = 1;
        while willexit (prefixStorageMutationIndex <= prefixStorageMutationCount)
        {
            if (!storageMutationStatements.Contains(prefixStorageMutationIndex)
                || AppendStorageMutationStatementRow(prefixStorageMutationStatements, storageMutationStatements, prefixStorageMutationIndex) == 0)
            {
                return false;
            }

            prefixStorageMutationIndex = prefixStorageMutationIndex + 1;
        }

        if (!LowerSourceStorageMutationStatementsWithCallContext(
            prefixStorageMutationStatements,
            scalarStorageAssignments,
            enumStorageAssignments,
            constructedObjectFieldAssignments,
            nodes,
            instrs,
            storageLoweringLocalTypes,
            storageLocalOverrides,
            functionCallContractFacts,
            storageSliceArgumentLocals))
        {
            return false;
        }

        return LowerRecursiveIfStorageMutationNodeToReturnBlocks(
            nodes,
            storageIfNodes,
            storageRootNode,
            storageArmLocalRoots,
            scalarStorageAssignments,
            enumStorageAssignments,
            constructedObjectFieldAssignments,
            storageMutationStatements,
            storageReturnRoot.NodeId,
            storageLoweringLocalTypes,
            storageLocalOverrides,
            (u32[0 max])signatureParamCount,
            entryFirst,
            instrs,
            blocks,
            ranges,
            recordRanges,
            functionCallContractFacts,
            storageSliceArgumentLocals,
            storageRootType,
            storageHasDeclaredReturnType,
            storageDeclaredReturnType,
            usesArenaFrame,
            body);
    }

    stack ExprParseResult condResult = arms.Condition;
    stack ExprParseResult thenResult = arms.ThenArm;
    stack ExprParseResult elseResult = arms.ElseArm;
    stack bool thenBecome = arms.ThenBecome;
    stack bool elseBecome = arms.ElseBecome;

    if ((thenBecome || elseBecome) && (!isTailCallable || usesArenaFrame))
    {
        return false;
    }

    if (params.Count() != signatureParamCount + localRoots.Count())
    {
        return false;
    }

    stack mut IrTable<DistinctStoragePair> distinctStorageFacts = new();
    if (!BuildDistinctStorageFacts(stream, source, signature, (u32[0 max])fnIndex, paramAbiFacts, distinctStorageFacts))
    {
        return false;
    }

    stack mut IrTable<SourceSliceArgumentLocal> sliceArgumentLocals = new();
    if (!BuildSourceSliceArgumentLocals(sliceDescriptorLocals, sliceArgumentLocals))
    {
        return false;
    }

    stack mut IrTable<u32[0 max]> loweringLocalTypes = new();
    if (!BuildLoweringLocalTypesWithAddressableScalarParams(stream, source, signature, nodes, localTypes, loweringLocalTypes))
    {
        return false;
    }

    if (!ValidateModuleCallsWithSlices(nodes, funcParamCounts, functionCallContractFacts, loweringLocalTypes, sliceDescriptorLocals, distinctStorageFacts))
    {
        return false;
    }

    if (TypeOfNodeWithLocals(nodes, condResult.NodeId, loweringLocalTypes) != ExprType.BoolType)
    {
        return false;
    }

    stack ExprType thenType = TypeOfNodeWithLocals(nodes, thenResult.NodeId, loweringLocalTypes);
    stack ExprType elseType = TypeOfNodeWithLocals(nodes, elseResult.NodeId, loweringLocalTypes);
    stack bool bothInt = thenType == ExprType.IntType && elseType == ExprType.IntType;
    stack bool bothBool = thenType == ExprType.BoolType && elseType == ExprType.BoolType && !thenBecome && !elseBecome;
    stack bool bothEnum = thenType == ExprType.EnumType && elseType == ExprType.EnumType && !thenBecome && !elseBecome;
    if (!bothInt && !bothBool && !bothEnum)
    {
        return false;
    }

    stack mut u32[0 max] returnOwnerDeclarationIndex = 0;
    stack mut Compiler.Parsing.DeclItem returnEnumItem = new();
    if (bothEnum
        && !TryGetSourceEnumOwnerDeclarationForToken(
            stream,
            source,
            moduleFacts,
            signature.ReturnTypeTokenAt(),
            returnOwnerDeclarationIndex,
            returnEnumItem))
    {
        return false;
    }

    if (thenBecome && !TailCallTargetIsTailCallable(nodes, thenResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    if (elseBecome && !TailCallTargetIsTailCallable(nodes, elseResult.NodeId, funcTailFlags, funcParamCounts, (u32[0 max])signatureParamCount))
    {
        return false;
    }

    stack mut MirType declaredReturnType = MirType.I64;
    stack bool hasDeclaredReturnType = MirTypeForKnownSourceScalarType(stream, source, signature.ReturnTypeTokenAt(), declaredReturnType);

    stack mut IrTable<u32[0 max]> localOverrides = new();
    if (!SeedSignatureParamOverridesForLowering(stream, source, signature, paramAbiFacts, instrs, loweringLocalTypes, localOverrides))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] localCount = localRoots.Count();
    stack mut u64[0 2 ** 63 - 1] v = 0;
    stack mut u32[0 max] nextStackObjectInitializer = 1;
    stack mut u32[0 max] nextScalarStorageInitializer = 1;
    stack mut u32[0 max] nextFixedArrayStorageInitializer = 1;
    stack mut u32[0 max] nextEnumStorageInitializer = 1;
    while willexit (v < localCount)
    {
        stack u32[0 max] localRoot = localRoots.Get((u32[0 max])(v + 1));
        if (localRoot == 0)
        {
            stack mut u32[0 max] storageOverride = 0;
            if (localOverrideValues.Contains((u32[0 max])(v + 1)))
            {
                storageOverride = localOverrideValues.Get((u32[0 max])(v + 1));
            }

            stack u32[0 max] nonValueOverride = localOverrides.Add(storageOverride);
        }
        else
        {
            stack MirValueId varValue = LowerExprNodeWithCallContext(
                nodes,
                localRoot,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals);
            stack u32[0 max] addedOverride = localOverrides.Add(varValue.Index());
        }

        nextScalarStorageInitializer = LowerScalarStorageInitializersForLocalWithCallContext(
            scalarStorageInitializers,
            (u32[0 max])(v + 1),
            nextScalarStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextFixedArrayStorageInitializer = LowerFixedArrayStorageInitializersForLocalWithCallContext(
            fixedArrayStorageInitializers,
            (u32[0 max])(v + 1),
            nextFixedArrayStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextEnumStorageInitializer = LowerEnumStorageInitializersForLocalWithCallContext(
            enumStorageInitializers,
            (u32[0 max])(v + 1),
            nextEnumStorageInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);

        nextStackObjectInitializer = LowerStackObjectFieldInitializersForLocalWithCallContext(
            stackObjectFieldInitializers,
            (u32[0 max])(v + 1),
            nextStackObjectInitializer,
            nodes,
            instrs,
            loweringLocalTypes,
            localOverrides,
            functionCallContractFacts,
            sliceArgumentLocals);
        v = v + 1;
    }

    if ((u64[0 2 ** 63 - 1])(nextScalarStorageInitializer - 1) != scalarStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextEnumStorageInitializer - 1) != enumStorageInitializers.Count())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])(nextFixedArrayStorageInitializer - 1) != fixedArrayStorageInitializers.Count())
    {
        return false;
    }

    if (!LowerSourceStorageMutationStatementsWithCallContext(
        storageMutationStatements,
        scalarStorageAssignments,
        enumStorageAssignments,
        constructedObjectFieldAssignments,
        nodes,
        instrs,
        loweringLocalTypes,
        localOverrides,
        functionCallContractFacts,
        sliceArgumentLocals))
    {
        return false;
    }

    stack MirValueId condValue = LowerExprNodeWithCallContext(nodes, condResult.NodeId, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    stack u32[0 max] entryCount = (u32[0 max])instrs.Count() - (entryFirst - 1);

    stack u32[0 max] thenFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId thenValue = MirValueIdOf(0);
    if (thenBecome)
    {
        thenValue = LowerTailCallExprNodeWithCallContext(nodes, thenResult.NodeId, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    }
    else
    {
        if (bothEnum)
        {
            if (!TryLowerEnumReturnExprNodeWithCallContext(
                nodes,
                thenResult.NodeId,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals,
                returnOwnerDeclarationIndex,
                thenValue))
            {
                return false;
            }
        }
        else
        {
            thenValue = LowerScalarReturnExprNodeWithCallContext(
                nodes,
                thenResult.NodeId,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals,
                thenType,
                hasDeclaredReturnType,
                declaredReturnType);
        }

        if (usesArenaFrame)
        {
            stack MirValueId thenLeave = MirArenaFrameLeave(instrs);
        }
    }

    stack u32[0 max] thenCount = (u32[0 max])instrs.Count() - (thenFirst - 1);

    stack u32[0 max] elseFirst = (u32[0 max])instrs.Count() + 1;
    stack mut MirValueId elseValue = MirValueIdOf(0);
    if (elseBecome)
    {
        elseValue = LowerTailCallExprNodeWithCallContext(nodes, elseResult.NodeId, instrs, loweringLocalTypes, localOverrides, functionCallContractFacts, sliceArgumentLocals);
    }
    else
    {
        if (bothEnum)
        {
            if (!TryLowerEnumReturnExprNodeWithCallContext(
                nodes,
                elseResult.NodeId,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals,
                returnOwnerDeclarationIndex,
                elseValue))
            {
                return false;
            }
        }
        else
        {
            elseValue = LowerScalarReturnExprNodeWithCallContext(
                nodes,
                elseResult.NodeId,
                instrs,
                loweringLocalTypes,
                localOverrides,
                functionCallContractFacts,
                sliceArgumentLocals,
                elseType,
                hasDeclaredReturnType,
                declaredReturnType);
        }

        if (usesArenaFrame)
        {
            stack MirValueId elseLeave = MirArenaFrameLeave(instrs);
        }
    }

    stack u32[0 max] elseCount = (u32[0 max])instrs.Count() - (elseFirst - 1);

    stack MirBlockId entry = MirCondBlock(blocks, condValue, MirBlockIdOf(firstBlock + 1), MirBlockIdOf(firstBlock + 2));
    stack mut MirBlockId thenBlock = MirBlockIdOf(0);
    if (thenBecome)
    {
        thenBlock = MirTailCallBlock(blocks, thenValue);
    }
    else
    {
        thenBlock = MirReturnBlock(blocks, thenValue);
    }

    stack mut MirBlockId elseBlock = MirBlockIdOf(0);
    if (elseBecome)
    {
        elseBlock = MirTailCallBlock(blocks, elseValue);
    }
    else
    {
        elseBlock = MirReturnBlock(blocks, elseValue);
    }

    if (recordRanges)
    {
        stack u32[0 max] r1 = ranges.Add(MakeBlockEmit(entry.Index(), entryFirst, entryCount));
        stack u32[0 max] r2 = ranges.Add(MakeBlockEmit(thenBlock.Index(), thenFirst, thenCount));
        stack u32[0 max] r3 = ranges.Add(MakeBlockEmit(elseBlock.Index(), elseFirst, elseCount));
    }

    body.Ok = true;
    body.EntryBlock = entry.Index();
    body.ParamCount = (u32[0 max])signatureParamCount;
    body.CondValue = condValue.Index();
    body.ThenValue = thenValue.Index();
    body.ElseValue = elseValue.Index();
    return true;
}
