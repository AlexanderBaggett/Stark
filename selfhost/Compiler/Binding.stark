    public law u32[0 max] CountOfKind(borrow TypedTraitConformanceTable self, TypedTraitConformanceKind kind)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.KindAt(index) == kind)
            {
                total = (u32[0 max])(total + 1);
            }
        }

        return total;
    }

    public law bool HasDeclarationTraitConformance(borrow TypedTraitConformanceTable self, u32[0 max] subjectDeclarationSymbolIndexPlusOne, u32[0 max] traitDeclarationSymbolIndexPlusOne)
    {
        if (subjectDeclarationSymbolIndexPlusOne == 0 || traitDeclarationSymbolIndexPlusOne == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.KindAt(index) == TypedTraitConformanceKind.DeclarationBase
                && self.SubjectDeclarationSymbolIndexPlusOneAt(index) == subjectDeclarationSymbolIndexPlusOne
                && self.TraitDeclarationSymbolIndexPlusOneAt(index) == traitDeclarationSymbolIndexPlusOne)
            {
                return true;
            }
        }

        return false;
    }

    public law bool HasGenericTraitConstraint(borrow TypedTraitConformanceTable self, u32[0 max] genericParameterSymbolIndexPlusOne, u32[0 max] traitDeclarationSymbolIndexPlusOne)
    {
        if (genericParameterSymbolIndexPlusOne == 0 || traitDeclarationSymbolIndexPlusOne == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.KindAt(index) == TypedTraitConformanceKind.GenericConstraint
                && self.SubjectGenericParameterSymbolIndexPlusOneAt(index) == genericParameterSymbolIndexPlusOne
                && self.TraitDeclarationSymbolIndexPlusOneAt(index) == traitDeclarationSymbolIndexPlusOne)
            {
                return true;
            }
        }

        return false;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedTraitConformanceTable self,
        u32[0 max] ownerDeclarationSymbolIndexPlusOne,
        u32[0 max] ownerMemberSymbolIndexPlusOne,
        u32[0 max] ownerNameToken,
        TypedTraitConformanceKind kind,
        u32[0 max] subjectDeclarationSymbolIndexPlusOne,
        u32[0 max] subjectGenericParameterSymbolIndexPlusOne,
        u32[0 max] subjectNameToken,
        u32[0 max] traitDeclarationSymbolIndexPlusOne,
        u32[0 max] traitNameToken,
        u32[0 max] traitHeadToken,
        u32[0 max] traitPrimaryToken,
        u32[0 max] traitStartToken,
        u32[0 max] traitEndToken,
        u32[0 max] traitGenericOpenToken,
        u32[0 max] traitGenericCloseToken,
        u32[0 max] traitTypeArgumentCount,
        u32[0 max] traitComptimeArgumentCount,
        u32[0 max] flags)
    {
        if (!self.OwnerDeclarationSymbolIndices.TryReserve(1)
            || !self.OwnerMemberSymbolIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.Kinds.TryReserve(1)
            || !self.SubjectDeclarationSymbolIndices.TryReserve(1)
            || !self.SubjectGenericParameterSymbolIndices.TryReserve(1)
            || !self.SubjectNameTokens.TryReserve(1)
            || !self.TraitDeclarationSymbolIndices.TryReserve(1)
            || !self.TraitNameTokens.TryReserve(1)
            || !self.TraitHeadTokens.TryReserve(1)
            || !self.TraitPrimaryTokens.TryReserve(1)
            || !self.TraitStartTokens.TryReserve(1)
            || !self.TraitEndTokens.TryReserve(1)
            || !self.TraitGenericOpenTokens.TryReserve(1)
            || !self.TraitGenericCloseTokens.TryReserve(1)
            || !self.TraitTypeArgumentCounts.TryReserve(1)
            || !self.TraitComptimeArgumentCounts.TryReserve(1)
            || !self.Flags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.OwnerDeclarationSymbolIndices[self.OwnerDeclarationSymbolIndices.Length] = ownerDeclarationSymbolIndexPlusOne;
        init self.OwnerMemberSymbolIndices[self.OwnerMemberSymbolIndices.Length] = ownerMemberSymbolIndexPlusOne;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.Kinds[self.Kinds.Length] = kind;
        init self.SubjectDeclarationSymbolIndices[self.SubjectDeclarationSymbolIndices.Length] = subjectDeclarationSymbolIndexPlusOne;
        init self.SubjectGenericParameterSymbolIndices[self.SubjectGenericParameterSymbolIndices.Length] = subjectGenericParameterSymbolIndexPlusOne;
        init self.SubjectNameTokens[self.SubjectNameTokens.Length] = subjectNameToken;
        init self.TraitDeclarationSymbolIndices[self.TraitDeclarationSymbolIndices.Length] = traitDeclarationSymbolIndexPlusOne;
        init self.TraitNameTokens[self.TraitNameTokens.Length] = traitNameToken;
        init self.TraitHeadTokens[self.TraitHeadTokens.Length] = traitHeadToken;
        init self.TraitPrimaryTokens[self.TraitPrimaryTokens.Length] = traitPrimaryToken;
        init self.TraitStartTokens[self.TraitStartTokens.Length] = traitStartToken;
        init self.TraitEndTokens[self.TraitEndTokens.Length] = traitEndToken;
        init self.TraitGenericOpenTokens[self.TraitGenericOpenTokens.Length] = traitGenericOpenToken;
        init self.TraitGenericCloseTokens[self.TraitGenericCloseTokens.Length] = traitGenericCloseToken;
        init self.TraitTypeArgumentCounts[self.TraitTypeArgumentCounts.Length] = traitTypeArgumentCount;
        init self.TraitComptimeArgumentCounts[self.TraitComptimeArgumentCounts.Length] = traitComptimeArgumentCount;
        init self.Flags[self.Flags.Length] = flags;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal finite law bool TypedTraitConformanceDeclarationCanImplementTraits(DeclarationKind kind)
{
    return kind == DeclarationKind.Struct || kind == DeclarationKind.Record;
}

internal fn u32[0 max] TypedTraitConformanceFirstIdentifierAfterKeyword(borrow TokenStream stream, u32[0 max] keywordToken, u32[0 max] endToken)
{
    stack mut u32[0 max] scan = (u32[0 max])(keywordToken + 1);
    while willexit (scan <= endToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Identifier)
        {
            return scan;
        }

        if (kind == TokenKind.LBrace || kind == TokenKind.Semi || kind == TokenKind.EndOfFile)
        {
            return 0;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn bool TypedTraitConformanceBaseListBounds(
    borrow TokenStream stream,
    u32[0 max] ownerNameToken,
    u32[0 max] ownerEndToken,
    out u32[0 max] listStartToken,
    out u32[0 max] listEndToken)
{
    listStartToken = 0;
    listEndToken = 0;
    if (ownerNameToken == 0)
    {
        return false;
    }

    stack mut u32[0 max] scan = (u32[0 max])(ownerNameToken + 1);
    stack mut u32[0 max] depth = 0;
    while willexit (scan <= ownerEndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && (kind == TokenKind.LBrace || kind == TokenKind.Semi || kind == TokenKind.Where || kind == TokenKind.EndOfFile))
        {
            return false;
        }

        if (depth == 0 && kind == TokenKind.Colon)
        {
            stack u32[0 max] startAfterColon = (u32[0 max])(scan + 1);
            listStartToken = startAfterColon;
            stack mut u32[0 max] endScan = startAfterColon;
            stack mut u32[0 max] endDepth = 0;
            while willexit (endScan <= ownerEndToken)
            {
                stack TokenKind endKind = stream.KindAt((u64[0 2 ** 63 - 1])endScan);
                if (endDepth == 0 && (endKind == TokenKind.Where || endKind == TokenKind.LBrace || endKind == TokenKind.Semi || endKind == TokenKind.EndOfFile))
                {
                    listEndToken = endScan;
                    return startAfterColon < endScan;
                }

                if (endKind == TokenKind.Lt || endKind == TokenKind.LBrack || endKind == TokenKind.LParen)
                {
                    endDepth = (u32[0 max])(endDepth + 1);
                }
                else if (endKind == TokenKind.Gt || endKind == TokenKind.RBrack || endKind == TokenKind.RParen)
                {
                    if (endDepth > 0)
                    {
                        endDepth = (u32[0 max])(endDepth - 1);
                    }
                }

                endScan = (u32[0 max])(endScan + 1);
            }

            listEndToken = ownerEndToken;
            return startAfterColon < ownerEndToken;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn System.Memory.MemoryStatus CollectGenericUseSitesFromConformanceBaseList(mut borrow GenericUseSiteTable facts, borrow TokenStream stream, u32[0 max] declKeyword)
{
    stack u32[0 max] ownerEndToken = TypedGenericOwnerTerminatorToken(stream, declKeyword);
    stack u32[0 max] ownerNameToken = TypedTraitConformanceFirstIdentifierAfterKeyword(stream, declKeyword, ownerEndToken);
    stack mut u32[0 max] listStartToken = 0;
    stack mut u32[0 max] listEndToken = 0;
    if (!TypedTraitConformanceBaseListBounds(stream, ownerNameToken, ownerEndToken, listStartToken, listEndToken))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] segmentStart = listStartToken;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = listStartToken;
    while willexit (scan <= listEndToken)
    {
        stack mut bool boundary = false;
        if (scan == listEndToken)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (segmentStart < scan)
            {
                switch (CollectGenericUseSitesInTypeSpan(facts, stream, segmentStart, scan))
                {
                    case System.Memory.MemoryStatus.Err(var collectError):
                        return System.Memory.MemoryStatus.Err(collectError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn u32[0 max] TypedTraitConformanceDeclarationSymbolByNameToken(
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    u32[0 max] nameToken,
    DeclarationKind requiredKind)
{
    if (nameToken == 0)
    {
        return 0;
    }

    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && declarations.NameTokenAt(index) != 0
            && declarations.DeclarationKindAt(index) == requiredKind
            && TokenTextEqualsToken(source, stream, declarations.NameTokenAt(index), nameToken))
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn u32[0 max] TypedTraitConformanceGenericParameterSymbolByOwnerAndName(
    ascii source,
    borrow TokenStream stream,
    borrow TypedGenericParameterSymbolTable generics,
    u32[0 max] ownerDeclarationSymbolIndexPlusOne,
    u32[0 max] ownerMemberSymbolIndexPlusOne,
    u32[0 max] subjectNameToken)
{
    if (subjectNameToken == 0)
    {
        return 0;
    }

    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = generics.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && generics.KindAt(index) == TypedGenericParameterKind.Type
            && generics.OwnerDeclarationSymbolIndexPlusOneAt(index) == ownerDeclarationSymbolIndexPlusOne
            && generics.OwnerMemberSymbolIndexPlusOneAt(index) == ownerMemberSymbolIndexPlusOne
            && TokenTextEqualsToken(source, stream, generics.NameTokenAt(index), subjectNameToken))
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn void TypedTraitConformanceCountTraitArguments(
    borrow TokenStream stream,
    u32[0 max] traitGenericOpenToken,
    u32[0 max] traitGenericCloseToken,
    out u32[0 max] typeArgumentCount,
    out u32[0 max] comptimeArgumentCount)
{
    typeArgumentCount = 0;
    comptimeArgumentCount = 0;
    if (traitGenericOpenToken == 0 || traitGenericCloseToken <= traitGenericOpenToken)
    {
        return;
    }

    stack mut u32[0 max] segmentStart = (u32[0 max])(traitGenericOpenToken + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(traitGenericOpenToken + 1);
    while willexit (scan <= traitGenericCloseToken)
    {
        stack mut bool boundary = false;
        if (scan == traitGenericCloseToken)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (segmentStart < scan)
            {
                if (GenericArgumentSegmentIsValue(stream, segmentStart, scan))
                {
                    comptimeArgumentCount = (u32[0 max])(comptimeArgumentCount + 1);
                }
                else
                {
                    typeArgumentCount = (u32[0 max])(typeArgumentCount + 1);
                }
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }
}

internal fn System.Memory.MemoryStatus AppendTypedTraitConformanceSegment(
    mut borrow TypedTraitConformanceTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    TypedTraitConformanceKind kind,
    u32[0 max] ownerDeclarationSymbolIndexPlusOne,
    u32[0 max] ownerMemberSymbolIndexPlusOne,
    u32[0 max] ownerNameToken,
    u32[0 max] subjectDeclarationSymbolIndexPlusOne,
    u32[0 max] subjectGenericParameterSymbolIndexPlusOne,
    u32[0 max] subjectNameToken,
    u32[0 max] traitStartToken,
    u32[0 max] traitEndToken)
{
    if (traitStartToken >= traitEndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] traitHeadToken = LastTypeHeadIdentifierInSpan(stream, traitStartToken, traitEndToken);
    if (traitHeadToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] traitPrimaryToken = FirstTypeTokenInSpan(stream, traitStartToken, traitEndToken);
    stack u32[0 max] traitDeclarationSymbolIndexPlusOne = TypedTraitConformanceDeclarationSymbolByNameToken(source, stream, declarations, traitHeadToken, DeclarationKind.Trait);
    stack mut u32[0 max] traitGenericOpenToken = 0;
    stack mut u32[0 max] traitGenericCloseToken = 0;
    if (stream.KindAt((u64[0 2 ** 63 - 1])(traitHeadToken + 1)) == TokenKind.Lt)
    {
        traitGenericOpenToken = (u32[0 max])(traitHeadToken + 1);
        traitGenericCloseToken = MatchingMemberCloseToken(stream, traitGenericOpenToken);
        if (traitGenericCloseToken == traitGenericOpenToken)
        {
            traitGenericOpenToken = 0;
            traitGenericCloseToken = 0;
        }
    }

    stack mut u32[0 max] traitTypeArgumentCount = 0;
    stack mut u32[0 max] traitComptimeArgumentCount = 0;
    TypedTraitConformanceCountTraitArguments(stream, traitGenericOpenToken, traitGenericCloseToken, traitTypeArgumentCount, traitComptimeArgumentCount);

    stack mut u32[0 max] flags = 0;
    if (traitDeclarationSymbolIndexPlusOne != 0)
    {
        flags = flags | TypedTraitConformanceFlagTraitResolved();
    }

    if (traitGenericOpenToken != 0)
    {
        flags = flags | TypedTraitConformanceFlagTraitGeneric();
    }

    if (subjectGenericParameterSymbolIndexPlusOne != 0)
    {
        flags = flags | TypedTraitConformanceFlagSubjectGenericParameter();
    }

    return table.Append(
        ownerDeclarationSymbolIndexPlusOne,
        ownerMemberSymbolIndexPlusOne,
        ownerNameToken,
        kind,
        subjectDeclarationSymbolIndexPlusOne,
        subjectGenericParameterSymbolIndexPlusOne,
        subjectNameToken,
        traitDeclarationSymbolIndexPlusOne,
        traitHeadToken,
        traitHeadToken,
        traitPrimaryToken,
        traitStartToken,
        traitEndToken,
        traitGenericOpenToken,
        traitGenericCloseToken,
        traitTypeArgumentCount,
        traitComptimeArgumentCount,
        flags);
}

internal fn System.Memory.MemoryStatus AppendTypedTraitConformanceSegmentsFromList(
    mut borrow TypedTraitConformanceTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    TypedTraitConformanceKind kind,
    u32[0 max] ownerDeclarationSymbolIndexPlusOne,
    u32[0 max] ownerMemberSymbolIndexPlusOne,
    u32[0 max] ownerNameToken,
    u32[0 max] subjectDeclarationSymbolIndexPlusOne,
    u32[0 max] subjectGenericParameterSymbolIndexPlusOne,
    u32[0 max] subjectNameToken,
    u32[0 max] listStartToken,
    u32[0 max] listEndToken)
{
    stack mut u32[0 max] segmentStart = listStartToken;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = listStartToken;
    while willexit (scan <= listEndToken)
    {
        stack mut bool boundary = false;
        if (scan == listEndToken)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind tokenKind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (tokenKind == TokenKind.Lt || tokenKind == TokenKind.LBrack || tokenKind == TokenKind.LParen || tokenKind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (tokenKind == TokenKind.Gt || tokenKind == TokenKind.RBrack || tokenKind == TokenKind.RParen || tokenKind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && tokenKind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (segmentStart < scan)
            {
                switch (AppendTypedTraitConformanceSegment(
                    table,
                    source,
                    stream,
                    declarations,
                    kind,
                    ownerDeclarationSymbolIndexPlusOne,
                    ownerMemberSymbolIndexPlusOne,
                    ownerNameToken,
                    subjectDeclarationSymbolIndexPlusOne,
                    subjectGenericParameterSymbolIndexPlusOne,
                    subjectNameToken,
                    segmentStart,
                    scan))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return System.Memory.MemoryStatus.Err(appendError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedTraitDeclarationBaseConformances(
    mut borrow TypedTraitConformanceTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    u64[0 2 ** 63 - 1] declarationIndex)
{
    if (!TypedTraitConformanceDeclarationCanImplementTraits(declarations.DeclarationKindAt(declarationIndex)))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] listStartToken = 0;
    stack mut u32[0 max] listEndToken = 0;
    if (!TypedTraitConformanceBaseListBounds(
        stream,
        declarations.NameTokenAt(declarationIndex),
        declarations.EndTokenAt(declarationIndex),
        listStartToken,
        listEndToken))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] subjectSymbolIndexPlusOne = (u32[0 max])(declarationIndex + 1);
    return AppendTypedTraitConformanceSegmentsFromList(
        table,
        source,
        stream,
        declarations,
        TypedTraitConformanceKind.DeclarationBase,
        subjectSymbolIndexPlusOne,
        0,
        declarations.NameTokenAt(declarationIndex),
        subjectSymbolIndexPlusOne,
        0,
        declarations.NameTokenAt(declarationIndex),
        listStartToken,
        listEndToken);
}

internal fn System.Memory.MemoryStatus AppendTypedTraitGenericConstraintSegments(
    mut borrow TypedTraitConformanceTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    borrow TypedGenericParameterSymbolTable generics,
    u32[0 max] ownerDeclarationSymbolIndexPlusOne,
    u32[0 max] ownerMemberSymbolIndexPlusOne,
    u32[0 max] ownerNameToken,
    u32[0 max] ownerKeywordToken)
{
    stack u32[0 max] whereToken = TypedGenericWhereTokenForOwner(stream, ownerKeywordToken);
    stack u32[0 max] ownerEndToken = TypedGenericOwnerTerminatorToken(stream, ownerKeywordToken);
    if (whereToken == 0 || ownerEndToken <= whereToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] subjectNameToken = 0;
    stack mut u32[0 max] subjectGenericSymbolIndexPlusOne = 0;
    stack mut u32[0 max] segmentStart = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(whereToken + 1);
    while willexit (scan <= ownerEndToken)
    {
        stack mut bool boundary = false;
        if (scan >= ownerEndToken)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (depth == 0 && kind == TokenKind.Identifier
                && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.Colon)
            {
                if (subjectNameToken != 0 && segmentStart < scan)
                {
                    switch (AppendTypedTraitConformanceSegment(
                        table,
                        source,
                        stream,
                        declarations,
                        TypedTraitConformanceKind.GenericConstraint,
                        ownerDeclarationSymbolIndexPlusOne,
                        ownerMemberSymbolIndexPlusOne,
                        ownerNameToken,
                        0,
                        subjectGenericSymbolIndexPlusOne,
                        subjectNameToken,
                        segmentStart,
                        scan))
                    {
                        case System.Memory.MemoryStatus.Err(var previousError):
                            return System.Memory.MemoryStatus.Err(previousError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                subjectNameToken = scan;
                subjectGenericSymbolIndexPlusOne = TypedTraitConformanceGenericParameterSymbolByOwnerAndName(
                    source,
                    stream,
                    generics,
                    ownerDeclarationSymbolIndexPlusOne,
                    ownerMemberSymbolIndexPlusOne,
                    subjectNameToken);
                segmentStart = (u32[0 max])(scan + 2);
                scan = (u32[0 max])(scan + 2);
                continue;
            }

            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (subjectNameToken != 0 && segmentStart < scan)
            {
                switch (AppendTypedTraitConformanceSegment(
                    table,
                    source,
                    stream,
                    declarations,
                    TypedTraitConformanceKind.GenericConstraint,
                    ownerDeclarationSymbolIndexPlusOne,
                    ownerMemberSymbolIndexPlusOne,
                    ownerNameToken,
                    0,
                    subjectGenericSymbolIndexPlusOne,
                    subjectNameToken,
                    segmentStart,
                    scan))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return System.Memory.MemoryStatus.Err(appendError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn BindResult<TypedTraitConformanceTable> BuildTypedTraitConformances(
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    borrow TypedMemberSymbolTable members,
    borrow TypedGenericParameterSymbolTable generics)
{
    stack mut TypedTraitConformanceTable table = new();
    stack u64[0 2 ** 63 - 1] declarationCount = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < declarationCount; index += 1)
    {
        switch (AppendTypedTraitDeclarationBaseConformances(table, source, stream, declarations, index))
        {
            case System.Memory.MemoryStatus.Err(var baseError):
                return BindResult<TypedTraitConformanceTable>.Err(BindError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (declarations.ClassAt(index) == TypedDeclarationSymbolClass.Type
            || declarations.ClassAt(index) == TypedDeclarationSymbolClass.Function)
        {
            switch (AppendTypedTraitGenericConstraintSegments(
                table,
                source,
                stream,
                declarations,
                generics,
                (u32[0 max])(index + 1),
                0,
                declarations.NameTokenAt(index),
                declarations.KeywordTokenAt(index)))
            {
                case System.Memory.MemoryStatus.Err(var constraintError):
                    return BindResult<TypedTraitConformanceTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack u64[0 2 ** 63 - 1] memberCount = members.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < memberCount; index += 1)
    {
        if (members.KindAt(index) == TypedMemberSymbolKind.Method)
        {
            switch (AppendTypedTraitGenericConstraintSegments(
                table,
                source,
                stream,
                declarations,
                generics,
                members.OwnerDeclarationSymbolIndexPlusOneAt(index),
                (u32[0 max])(index + 1),
                members.NameTokenAt(index),
                members.KeywordTokenAt(index)))
            {
                case System.Memory.MemoryStatus.Err(var memberConstraintError):
                    return BindResult<TypedTraitConformanceTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return BindResult<TypedTraitConformanceTable>.Ok(table);
}

internal fn bool ModuleExistsWithOrigin(mut borrow ModuleResolver resolver, ascii name, ModuleOrigin origin)
{
    stack u64[0 2 ** 63 - 1] count = resolver.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (resolver.OriginAt(index) == origin && resolver.NameEqualsAt(index, name))
        {
            return true;
        }
    }

    return false;
}

public fn System.Memory.MemoryStatus AddSourceModule(
    mut borrow ModuleResolver resolver,
    ascii source,
    borrow TokenStream stream,
    borrow CompilationUnitHeader header,
    u32[0 max] sourceIndex,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] moduleIndex = FindModuleHeaderIndex(header);
    if (moduleIndex >= header.Count())
    {
        switch (diags.Append(BindDiagnosticCode.MissingModuleDeclaration, header.NextToken))
        {
            case System.Memory.MemoryStatus.Err(var diagError):
                return System.Memory.MemoryStatus.Err(diagError);
            case System.Memory.MemoryStatus.Ok:
        }

        return System.Memory.MemoryStatus.Ok;
    }

    stack HeaderItem moduleItem = header.ItemAt(moduleIndex);
    stack mut OwnedAscii name = new();
    switch (AppendHeaderDottedName(source, stream, moduleItem, name))
    {
        case System.Memory.MemoryStatus.Err(var nameError):
            return System.Memory.MemoryStatus.Err(nameError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack ascii moduleName = name.View();
    if (ModuleExistsWithOrigin(resolver, moduleName, ModuleOrigin.Source))
    {
        switch (diags.Append(BindDiagnosticCode.DuplicateModule, moduleItem.NameStart))
        {
            case System.Memory.MemoryStatus.Err(var duplicateError):
                return System.Memory.MemoryStatus.Err(duplicateError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return resolver.Append(name, ModuleOrigin.Source, sourceIndex);
}

public fn System.Memory.MemoryStatus AddPackageModule(
    mut borrow ModuleResolver resolver,
    ascii moduleName,
    u32[0 max] packageIndex,
    mut borrow BindDiagnosticList diags)
{
    stack mut OwnedAscii name = new();
    switch (System.Text.FromAscii(name, moduleName))
    {
        case System.Memory.MemoryStatus.Err(var copyError):
            return System.Memory.MemoryStatus.Err(copyError);
        case System.Memory.MemoryStatus.Ok:
    }

    if (ModuleExistsWithOrigin(resolver, moduleName, ModuleOrigin.Package))
    {
        switch (diags.Append(BindDiagnosticCode.DuplicateModule, 0))
        {
            case System.Memory.MemoryStatus.Err(var duplicateError):
                return System.Memory.MemoryStatus.Err(duplicateError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return resolver.Append(name, ModuleOrigin.Package, packageIndex);
}

internal fn ImportResolutionKind ResolveModuleName(mut borrow ModuleResolver resolver, ascii moduleName, out u32[0 max] targetIndex)
{
    targetIndex = 0;
    stack mut u32[0 max] sourceMatches = 0;
    stack mut u32[0 max] packageMatches = 0;
    stack mut u32[0 max] sourceTarget = 0;
    stack mut u32[0 max] packageTarget = 0;
    stack u64[0 2 ** 63 - 1] count = resolver.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (resolver.NameEqualsAt(index, moduleName))
        {
            stack ModuleOrigin origin = resolver.OriginAt(index);
            if (origin == ModuleOrigin.Source)
            {
                sourceMatches = (u32[0 max])(sourceMatches + 1);
                sourceTarget = resolver.OriginIndexAt(index);
            }
            else
            {
                packageMatches = (u32[0 max])(packageMatches + 1);
                packageTarget = resolver.OriginIndexAt(index);
            }
        }
    }

    if (sourceMatches == 1)
    {
        targetIndex = sourceTarget;
        return ImportResolutionKind.Source;
    }

    if (sourceMatches > 1)
    {
        return ImportResolutionKind.Ambiguous;
    }

    if (packageMatches == 1)
    {
        targetIndex = packageTarget;
        return ImportResolutionKind.Package;
    }

    if (packageMatches > 1)
    {
        return ImportResolutionKind.Ambiguous;
    }

    return ImportResolutionKind.Missing;
}

public fn System.Memory.MemoryStatus ResolveImports(
    mut borrow ModuleResolver resolver,
    ascii source,
    borrow TokenStream stream,
    borrow CompilationUnitHeader header,
    mut borrow ImportResolutionTable resolutions,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = header.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack HeaderItem item = header.ItemAt(index);
        if (item.Kind == SyntaxKind.ImportDeclaration)
        {
            stack mut OwnedAscii name = new();
            switch (AppendHeaderDottedName(source, stream, item, name))
            {
                case System.Memory.MemoryStatus.Err(var nameError):
                    return System.Memory.MemoryStatus.Err(nameError);
                case System.Memory.MemoryStatus.Ok:
            }

            stack mut u32[0 max] targetIndex = 0;
            stack ascii importName = name.View();
            stack ImportResolutionKind kind = ResolveModuleName(resolver, importName, targetIndex);
            switch (resolutions.Append(kind, item.NameStart, targetIndex))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }

            if (kind == ImportResolutionKind.Missing)
            {
                switch (diags.Append(BindDiagnosticCode.UnresolvedImport, item.NameStart))
                {
                    case System.Memory.MemoryStatus.Err(var missingError):
                        return System.Memory.MemoryStatus.Err(missingError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (kind == ImportResolutionKind.Ambiguous)
            {
                switch (diags.Append(BindDiagnosticCode.AmbiguousImport, item.NameStart))
                {
                    case System.Memory.MemoryStatus.Err(var ambiguousError):
                        return System.Memory.MemoryStatus.Err(ambiguousError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Collects a `DuplicateDeclaration` diagnostic (anchored at the later name) for
// every top-level declaration whose name repeats an earlier one.
internal fn System.Memory.MemoryStatus CollectDuplicateDeclarations(borrow DeclarationTable table, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] later = 0; later < count; later += 1)
    {
        stack ascii laterName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(later));
        stack mut bool repeats = false;
        for willexit (stack mut u64[0 2 ** 63 - 1] earlier = 0; earlier < later; earlier += 1)
        {
            stack ascii earlierName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(earlier));
            if (System.Text.Equals(earlierName, laterName))
            {
                repeats = true;
            }
        }

        if (repeats)
        {
            switch (diags.Append(BindDiagnosticCode.DuplicateDeclaration, table.NameTokenAt(later)))
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal finite law bool TokenTextEquals(ascii source, borrow TokenStream stream, u32[0 max] token, ascii expected)
{
    return System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token), expected);
}

internal finite law u32[0 max] AttributeEndToken(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return start;
        }

        if (kind == TokenKind.LBrack)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            if (depth == 0)
            {
                return index;
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return start;
}

internal finite law bool DeclarationPreludeHasToken(borrow TokenStream stream, DeclItem item, TokenKind tokenKind)
{
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == tokenKind)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool IsLinkNameDeclarationTarget(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind != DeclarationKind.Function)
    {
        return false;
    }

    if (!DeclarationPreludeHasToken(stream, item, TokenKind.Ffi))
    {
        return false;
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Asm))
    {
        return false;
    }

    return stream.KindAt((u64[0 2 ** 63 - 1])item.EndToken) == TokenKind.Semi;
}

internal finite law bool IsLinkNameAttribute(ascii source, borrow TokenStream stream, u32[0 max] attrStart)
{
    return stream.KindAt((u64[0 2 ** 63 - 1])(attrStart + 1)) == TokenKind.Identifier
        && TokenTextEquals(source, stream, (u32[0 max])(attrStart + 1), "LinkName");
}

internal finite law u32[0 max] LinkNameValueToken(borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd)
{
    if (attrEnd == (u32[0 max])(attrStart + 5)
        && stream.KindAt((u64[0 2 ** 63 - 1])(attrStart + 2)) == TokenKind.LParen
        && stream.KindAt((u64[0 2 ** 63 - 1])(attrStart + 3)) == TokenKind.StringLiteral
        && stream.KindAt((u64[0 2 ** 63 - 1])(attrStart + 4)) == TokenKind.RParen)
    {
        return (u32[0 max])(attrStart + 3);
    }

    return 0;
}

internal finite law bool StringLiteralHasNonEmptyPayload(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    stack ascii literal = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token);
    return System.Text.AsciiLength(literal) > 2;
}

internal finite law bool LinkNameAttributeIsWellFormed(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd)
{
    stack u32[0 max] valueToken = LinkNameValueToken(stream, attrStart, attrEnd);
    return valueToken != 0 && StringLiteralHasNonEmptyPayload(source, stream, valueToken);
}

internal fn System.Memory.MemoryStatus CollectLinkNameDiagnostics(borrow DeclarationList decls, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] declIndex = 0; declIndex < count; declIndex += 1)
    {
        stack DeclItem item = decls.ItemAt(declIndex);
        stack mut u32[0 max] scan = item.StartToken;
        stack mut u32[0 max] linkNameCount = 0;
        while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
        {
            stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
            if (attrEnd <= scan)
            {
                return System.Memory.MemoryStatus.Ok;
            }

            if (IsLinkNameAttribute(source, stream, scan))
            {
                linkNameCount = (u32[0 max])(linkNameCount + 1);
                if (linkNameCount > 1)
                {
                    switch (diags.Append(BindDiagnosticCode.DuplicateLinkName, (u32[0 max])(scan + 1)))
                    {
                        case System.Memory.MemoryStatus.Err(var duplicateError):
                            return System.Memory.MemoryStatus.Err(duplicateError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                if (!IsLinkNameDeclarationTarget(stream, item)
                    || !LinkNameAttributeIsWellFormed(source, stream, scan, attrEnd))
                {
                    switch (diags.Append(BindDiagnosticCode.InvalidLinkName, (u32[0 max])(scan + 1)))
                    {
                        case System.Memory.MemoryStatus.Err(var invalidError):
                            return System.Memory.MemoryStatus.Err(invalidError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }

            scan = (u32[0 max])(attrEnd + 1);
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal enum LayoutControlKind
{
    Auto,
    C,
    Explicit,
}

internal finite law bool LayoutAttributeNameMatches(ascii source, borrow TokenStream stream, u32[0 max] token, ascii name)
{
    return stream.KindAt((u64[0 2 ** 63 - 1])token) == TokenKind.Identifier
        && TokenTextEquals(source, stream, token, name);
}

internal fn u32[0 max] LayoutAttributeNameCount(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd, ascii name)
{
    stack mut u32[0 max] count = 0;
    stack mut u32[0 max] scan = (u32[0 max])(attrStart + 1);
    while willexit (scan < attrEnd)
    {
        if (LayoutAttributeNameMatches(source, stream, scan, name))
        {
            count = (u32[0 max])(count + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

internal fn u32[0 max] LayoutAttributeNameToken(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd, ascii name)
{
    stack mut u32[0 max] scan = (u32[0 max])(attrStart + 1);
    while willexit (scan < attrEnd)
    {
        if (LayoutAttributeNameMatches(source, stream, scan, name))
        {
            return scan;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn u32[0 max] LayoutAttributeArgumentToken(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd, ascii name)
{
    stack u32[0 max] nameToken = LayoutAttributeNameToken(source, stream, attrStart, attrEnd, name);
    if (nameToken != 0
        && (u32[0 max])(nameToken + 3) <= attrEnd
        && stream.KindAt((u64[0 2 ** 63 - 1])(nameToken + 1)) == TokenKind.LParen
        && stream.KindAt((u64[0 2 ** 63 - 1])(nameToken + 3)) == TokenKind.RParen)
    {
        return (u32[0 max])(nameToken + 2);
    }

    return 0;
}

internal fn bool LayoutTryParseU64Literal(ascii source, borrow TokenStream stream, u32[0 max] token, out u64[0 max] value)
{
    value = 0;
    if (token == 0 || stream.KindAt((u64[0 2 ** 63 - 1])token) != TokenKind.IntegerLiteral)
    {
        return false;
    }

    stack ascii text = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token);
    switch (System.Text.ParseU64Ascii(text))
    {
        case System.Text.TextResult<u64[0 max]>.Err(var parseError):
            return false;
        case System.Text.TextResult<u64[0 max]>.Ok(var parsed):
            value = parsed;
            return true;
    }
}

internal finite law bool LayoutValueIsPowerOfTwo(u64[0 max] value)
{
    return value > 0 && (value & (u64[0 max])(value - 1)) == 0;
}

internal fn bool LayoutAttributeHasPowerOfTwoLiteral(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    stack mut u64[0 max] value = 0;
    return LayoutTryParseU64Literal(source, stream, token, value)
        && LayoutValueIsPowerOfTwo(value);
}

internal fn bool LayoutAttributeHasNonNegativeIntegerLiteral(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    stack mut u64[0 max] value = 0;
    return LayoutTryParseU64Literal(source, stream, token, value);
}

internal fn LayoutControlKind LayoutKindFromArgument(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    if (token != 0 && stream.KindAt((u64[0 2 ** 63 - 1])token) == TokenKind.Identifier)
    {
        if (TokenTextEquals(source, stream, token, "C"))
        {
            return LayoutControlKind.C;
        }

        if (TokenTextEquals(source, stream, token, "Explicit"))
        {
            return LayoutControlKind.Explicit;
        }
    }

    return LayoutControlKind.Auto;
}

internal fn System.Memory.MemoryStatus CollectLayoutDeclarationAttributeDiagnostics(
    DeclItem item,
    ascii source,
    borrow TokenStream stream,
    mut borrow BindDiagnosticList diags,
    out LayoutControlKind layoutKind)
{
    layoutKind = LayoutControlKind.Auto;
    stack mut LayoutControlKind resolvedLayoutKind = LayoutControlKind.Auto;
    stack mut u32[0 max] structLayoutCount = 0;
    stack mut u32[0 max] packCount = 0;
    stack mut u32[0 max] alignCount = 0;
    stack mut bool hasPack = false;
    stack mut bool hasAlign = false;
    stack mut u32[0 max] firstPackToken = 0;
    stack mut u32[0 max] firstAlignToken = 0;

    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u32[0 max] structLayoutHere = LayoutAttributeNameCount(source, stream, scan, attrEnd, "StructLayout");
        if (structLayoutHere > 0)
        {
            structLayoutCount = (u32[0 max])(structLayoutCount + structLayoutHere);
            stack u32[0 max] nameToken = LayoutAttributeNameToken(source, stream, scan, attrEnd, "StructLayout");
            if (structLayoutCount > 1)
            {
                switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, nameToken))
                {
                    case System.Memory.MemoryStatus.Err(var duplicateLayoutError):
                        return System.Memory.MemoryStatus.Err(duplicateLayoutError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else
            {
                stack u32[0 max] argToken = LayoutAttributeArgumentToken(source, stream, scan, attrEnd, "StructLayout");
                resolvedLayoutKind = LayoutKindFromArgument(source, stream, argToken);
                layoutKind = resolvedLayoutKind;
                if (resolvedLayoutKind == LayoutControlKind.Auto)
                {
                    switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, nameToken))
                    {
                        case System.Memory.MemoryStatus.Err(var invalidLayoutError):
                            return System.Memory.MemoryStatus.Err(invalidLayoutError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }

        stack u32[0 max] packHere = LayoutAttributeNameCount(source, stream, scan, attrEnd, "Pack");
        if (packHere > 0)
        {
            hasPack = true;
            packCount = (u32[0 max])(packCount + packHere);
            stack u32[0 max] packToken = LayoutAttributeNameToken(source, stream, scan, attrEnd, "Pack");
            if (firstPackToken == 0)
            {
                firstPackToken = packToken;
            }

            if (packCount > 1)
            {
                switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, packToken))
                {
                    case System.Memory.MemoryStatus.Err(var duplicatePackError):
                        return System.Memory.MemoryStatus.Err(duplicatePackError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            if (!LayoutAttributeHasPowerOfTwoLiteral(source, stream, LayoutAttributeArgumentToken(source, stream, scan, attrEnd, "Pack")))
            {
                switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, packToken))
                {
                    case System.Memory.MemoryStatus.Err(var invalidPackError):
                        return System.Memory.MemoryStatus.Err(invalidPackError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        stack u32[0 max] alignHere = LayoutAttributeNameCount(source, stream, scan, attrEnd, "Align");
        if (alignHere > 0)
        {
            hasAlign = true;
            alignCount = (u32[0 max])(alignCount + alignHere);
            stack u32[0 max] alignToken = LayoutAttributeNameToken(source, stream, scan, attrEnd, "Align");
            if (firstAlignToken == 0)
            {
                firstAlignToken = alignToken;
            }

            if (alignCount > 1)
            {
                switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, alignToken))
                {
                    case System.Memory.MemoryStatus.Err(var duplicateAlignError):
                        return System.Memory.MemoryStatus.Err(duplicateAlignError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            if (!LayoutAttributeHasPowerOfTwoLiteral(source, stream, LayoutAttributeArgumentToken(source, stream, scan, attrEnd, "Align")))
            {
                switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, alignToken))
                {
                    case System.Memory.MemoryStatus.Err(var invalidAlignError):
                        return System.Memory.MemoryStatus.Err(invalidAlignError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    layoutKind = resolvedLayoutKind;
    if (hasPack && resolvedLayoutKind != LayoutControlKind.C)
    {
        switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, firstPackToken))
        {
            case System.Memory.MemoryStatus.Err(var packContextError):
                return System.Memory.MemoryStatus.Err(packContextError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    if (hasAlign && resolvedLayoutKind != LayoutControlKind.C && resolvedLayoutKind != LayoutControlKind.Explicit)
    {
        switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, firstAlignToken))
        {
            case System.Memory.MemoryStatus.Err(var alignContextError):
                return System.Memory.MemoryStatus.Err(alignContextError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal finite law u32[0 max] LayoutSkipDeclarationBody(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    stack mut bool sawBrace = false;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
            sawBrace = true;
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            if (depth == 0 && sawBrace)
            {
                return index;
            }
        }
        else if (kind == TokenKind.Semi && depth == 0 && !sawBrace)
        {
            return index;
        }

        index = (u32[0 max])(index + 1);
    }

    return index;
}

internal finite law u32[0 max] LayoutSkipLeadingAttributes(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] scan = start;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return scan;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return scan;
}

internal finite law bool LayoutTokenIsMemberModifier(borrow TokenStream stream, u32[0 max] token)
{
    if (stream.ContextualKindAt((u64[0 2 ** 63 - 1])token) == ContextualKeywordKind.Tail)
    {
        return true;
    }

    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])token);
    return kind == TokenKind.Public
        || kind == TokenKind.Internal
        || kind == TokenKind.Export
        || kind == TokenKind.Static
        || kind == TokenKind.Unsafe
        || kind == TokenKind.Ffi
        || kind == TokenKind.Varargs
        || kind == TokenKind.Finite
        || kind == TokenKind.Law
        || kind == TokenKind.Inline
        || kind == TokenKind.Noinline
        || kind == TokenKind.Inlinehint
        || kind == TokenKind.Hot
        || kind == TokenKind.Cold
        || kind == TokenKind.Strictfp
        || kind == TokenKind.Asm;
}

internal finite law u32[0 max] LayoutMatchingCloseToken(borrow TokenStream stream, u32[0 max] openToken)
{
    stack TokenKind openKind = stream.KindAt((u64[0 2 ** 63 - 1])openToken);
    stack mut TokenKind closeKind = TokenKind.RParen;
    if (openKind == TokenKind.LBrack)
    {
        closeKind = TokenKind.RBrack;
    }
    else if (openKind == TokenKind.Lt)
    {
        closeKind = TokenKind.Gt;
    }
    else if (openKind != TokenKind.LParen)
    {
        return openToken;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = openToken;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])scan) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == openKind)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == closeKind)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            if (depth == 0)
            {
                return scan;
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return openToken;
}

internal finite law u32[0 max] LayoutSkipMemberModifiers(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] scan = LayoutSkipLeadingAttributes(stream, start);
    while willexit (LayoutTokenIsMemberModifier(stream, scan))
    {
        scan = (u32[0 max])(scan + 1);
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LParen)
        {
            stack u32[0 max] close = LayoutMatchingCloseToken(stream, scan);
            if (close > scan)
            {
                scan = (u32[0 max])(close + 1);
            }
        }
    }

    return scan;
}

internal finite law bool LayoutTokenStartsMemberDeclaration(TokenKind kind)
{
    return kind == TokenKind.Fn
        || kind == TokenKind.Struct
        || kind == TokenKind.Record
        || kind == TokenKind.Enum
        || kind == TokenKind.Trait
        || kind == TokenKind.Doctrine
        || kind == TokenKind.Alias
        || kind == TokenKind.Drop;
}

internal finite law u32[0 max] LayoutBoundedLastIdentifier(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] result = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] index = start;
    while willexit (index < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && kind == TokenKind.Identifier)
        {
            result = index;
        }

        index = (u32[0 max])(index + 1);
    }

    return result;
}

internal finite law u32[0 max] LayoutBoundedFirstTypeStart(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] index = start;
    while willexit (index < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.Identifier
            || kind == TokenKind.IntegerType
            || kind == TokenKind.FloatType
            || kind == TokenKind.Bool
            || kind == TokenKind.Void
            || kind == TokenKind.AsciiView
            || kind == TokenKind.UnicodeView
            || kind == TokenKind.AsciiOwned
            || kind == TokenKind.UnicodeOwned
            || kind == TokenKind.Dynamic
            || kind == TokenKind.Rawptr
            || kind == TokenKind.Rawmutptr
            || kind == TokenKind.Fnptr
            || kind == TokenKind.Closure
            || kind == TokenKind.Borrow
            || kind == TokenKind.Retborrow
            || kind == TokenKind.Storeborrow
            || kind == TokenKind.Out
            || kind == TokenKind.Init
            || kind == TokenKind.Frozen
            || kind == TokenKind.Shared)
        {
            return index;
        }

        index = (u32[0 max])(index + 1);
    }

    return 0;
}

internal fn u32[0 max] LayoutFieldDeclaratorCount(borrow TokenStream stream, u32[0 max] start, u32[0 max] endInclusive)
{
    stack mut u32[0 max] count = 0;
    stack mut u32[0 max] segStart = start;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan <= endInclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && (kind == TokenKind.Comma || kind == TokenKind.Semi))
        {
            if (LayoutBoundedLastIdentifier(stream, segStart, scan) != 0)
            {
                count = (u32[0 max])(count + 1);
            }

            segStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

internal fn bool LayoutTypeSpanHasTopLevelGenericArguments(borrow TokenStream stream, u32[0 max] headToken, u32[0 max] endExclusive)
{
    stack u32[0 max] next = (u32[0 max])(headToken + 1);
    return next < endExclusive && stream.KindAt((u64[0 2 ** 63 - 1])next) == TokenKind.Lt;
}

internal fn bool LayoutNameIsSystemCAlias(ascii source, borrow TokenStream stream, u32[0 max] headToken)
{
    if (headToken == 0)
    {
        return false;
    }

    return TokenTextEquals(source, stream, headToken, "c_char")
        || TokenTextEquals(source, stream, headToken, "c_schar")
        || TokenTextEquals(source, stream, headToken, "c_uchar")
        || TokenTextEquals(source, stream, headToken, "c_short")
        || TokenTextEquals(source, stream, headToken, "c_ushort")
        || TokenTextEquals(source, stream, headToken, "c_int")
        || TokenTextEquals(source, stream, headToken, "c_uint")
        || TokenTextEquals(source, stream, headToken, "c_long")
        || TokenTextEquals(source, stream, headToken, "c_ulong")
        || TokenTextEquals(source, stream, headToken, "c_longlong")
        || TokenTextEquals(source, stream, headToken, "c_ulonglong")
        || TokenTextEquals(source, stream, headToken, "c_size_t")
        || TokenTextEquals(source, stream, headToken, "c_ptrdiff_t");
}

internal fn bool DeclarationNameHasLayoutControl(borrow DeclarationList decls, ascii source, borrow TokenStream stream, u32[0 max] headToken)
{
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if ((item.Kind == DeclarationKind.Struct || item.Kind == DeclarationKind.Record)
            && TokenTextEqualsToken(source, stream, item.NameToken, headToken))
        {
            return DeclarationHasStructLayoutCAttribute(source, stream, item)
                || DeclarationHasStructLayoutExplicitAttribute(source, stream, item);
        }
    }

    return false;
}

internal fn bool LayoutTypeSpanIsFfiSafe(
    borrow DeclarationList decls,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    u32[0 max] typeHead,
    u32[0 max] typePrimary)
{
    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])typePrimary);
    if (primaryKind == TokenKind.Bool
        || primaryKind == TokenKind.IntegerType
        || primaryKind == TokenKind.FloatType
        || primaryKind == TokenKind.Rawptr
        || primaryKind == TokenKind.Rawmutptr
        || primaryKind == TokenKind.Fnptr)
    {
        return true;
    }

    if (LayoutNameIsSystemCAlias(source, stream, typeHead))
    {
        return true;
    }

    if (primaryKind == TokenKind.Identifier
        && typeHead != 0
        && !LayoutTypeSpanHasTopLevelGenericArguments(stream, typeHead, typeEnd)
        && DeclarationNameHasLayoutControl(decls, source, stream, typeHead))
    {
        return true;
    }

    return false;
}

internal struct LayoutTypeInfo
{
    bool Known;
    u32[0 max] SizeBytes;
    u32[0 max] AlignBytes;

    LayoutTypeInfo()
    {
        self.Known = false;
        self.SizeBytes = 0;
        self.AlignBytes = 0;
    }
}

internal finite law LayoutTypeInfo KnownLayoutTypeInfo(u32[0 max] sizeBytes, u32[0 max] alignBytes)
{
    stack mut LayoutTypeInfo info = new();
    info.Known = true;
    info.SizeBytes = sizeBytes;
    info.AlignBytes = alignBytes;
    return info;
}

internal finite law LayoutTypeInfo UnknownLayoutTypeInfo()
{
    stack LayoutTypeInfo info = new();
    return info;
}

internal fn bool LayoutTryParseU32Literal(ascii source, borrow TokenStream stream, u32[0 max] token, out u32[0 max] value)
{
    value = 0;
    stack mut u64[0 max] raw = 0;
    if (!LayoutTryParseU64Literal(source, stream, token, raw)
        || raw > (u64[0 max])4294967295)
    {
        return false;
    }

    value = (u32[0 max])raw;
    return true;
}

internal fn u32[0 max] LayoutDeclarationAttributeU32Value(DeclItem item, ascii source, borrow TokenStream stream, ascii name)
{
    stack mut u32[0 max] value = 0;
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return value;
        }

        stack u32[0 max] argToken = LayoutAttributeArgumentToken(source, stream, scan, attrEnd, name);
        stack mut u32[0 max] parsed = 0;
        if (LayoutTryParseU32Literal(source, stream, argToken, parsed))
        {
            value = parsed;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return value;
}

internal fn LayoutControlKind LayoutDeclarationLayoutKind(DeclItem item, ascii source, borrow TokenStream stream)
{
    stack mut LayoutControlKind layoutKind = LayoutControlKind.Auto;
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return layoutKind;
        }

        if (LayoutAttributeNameCount(source, stream, scan, attrEnd, "StructLayout") > 0)
        {
            layoutKind = LayoutKindFromArgument(source, stream, LayoutAttributeArgumentToken(source, stream, scan, attrEnd, "StructLayout"));
            return layoutKind;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return layoutKind;
}

internal fn bool LayoutTryReadDataDeclarationItem(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeNameToken,
    out DeclItem item)
{
    item = new();
    if (typeNameToken == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclarationKind kind = table.KindAt(index);
        if ((kind == DeclarationKind.Struct || kind == DeclarationKind.Record)
            && TokenTextEqualsToken(source, stream, table.NameTokenAt(index), typeNameToken))
        {
            stack u32[0 max] declIndex = table.DeclIndexAt(index);
            if ((u64[0 2 ** 63 - 1])declIndex < decls.Count())
            {
                item = decls.ItemAt((u64[0 2 ** 63 - 1])declIndex);
                return true;
            }
        }
    }

    return false;
}

internal fn bool LayoutTryReadDeclarationItem(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeNameToken,
    out DeclItem item,
    out DeclarationKind declarationKind)
{
    item = new();
    declarationKind = DeclarationKind.Unknown;
    if (typeNameToken == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, table.NameTokenAt(index), typeNameToken))
        {
            stack u32[0 max] declIndex = table.DeclIndexAt(index);
            if ((u64[0 2 ** 63 - 1])declIndex < decls.Count())
            {
                item = decls.ItemAt((u64[0 2 ** 63 - 1])declIndex);
                declarationKind = table.KindAt(index);
                return true;
            }
        }
    }

    return false;
}

internal finite law u32[0 max] VisibilityRank(TypedModuleSymbolVisibility visibility)
{
    switch (visibility)
    {
        case TypedModuleSymbolVisibility.ModulePrivate:
            return 0;
        case TypedModuleSymbolVisibility.Internal:
            return 1;
        case TypedModuleSymbolVisibility.Public:
            return 2;
        case TypedModuleSymbolVisibility.Export:
            return 3;
    }
}

internal fn u32[0 max] MemberVisibilityModifierToken(borrow TokenStream stream, u32[0 max] memberStart, u32[0 max] memberKeyword)
{
    stack mut u32[0 max] scan = memberStart;
    while willexit (scan < memberKeyword)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Export || kind == TokenKind.Public || kind == TokenKind.Internal)
        {
            return scan;
        }

        if (kind == TokenKind.LBrack)
        {
            stack u32[0 max] close = AttributeEndToken(stream, scan);
            if (close <= scan)
            {
                return 0;
            }

            scan = close;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn TypedModuleSymbolVisibility VisibilityFromModifierToken(borrow TokenStream stream, u32[0 max] token)
{
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])token);
    if (kind == TokenKind.Export)
    {
        return TypedModuleSymbolVisibility.Export;
    }

    if (kind == TokenKind.Public)
    {
        return TypedModuleSymbolVisibility.Public;
    }

    if (kind == TokenKind.Internal)
    {
        return TypedModuleSymbolVisibility.Internal;
    }

    return TypedModuleSymbolVisibility.ModulePrivate;
}

internal fn System.Memory.MemoryStatus AppendExportedSurfaceInvalid(mut borrow BindDiagnosticList diags, u32[0 max] token)
{
    switch (diags.Append(BindDiagnosticCode.ExportedSurfaceInvalid, token))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryStatus.Ok;
    }
}

internal fn System.Memory.MemoryStatus AppendAbiBoundaryEnumType(mut borrow BindDiagnosticList diags, u32[0 max] token)
{
    switch (diags.Append(BindDiagnosticCode.AbiBoundaryEnumType, token))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryStatus.Ok;
    }
}

internal fn System.Memory.MemoryStatus AppendCopyableAssertionInvalid(mut borrow BindDiagnosticList diags, u32[0 max] token)
{
    return diags.Append(BindDiagnosticCode.CopyableAssertionInvalid, token);
}

internal fn bool RecordHeaderTypeDependsOnEnum(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem item,
    u32[0 max] depth)
{
    if (item.Kind != DeclarationKind.Record || item.NameToken == 0 || depth > 32)
    {
        return false;
    }

    stack u32[0 max] open = RecordHeaderOpenToken(stream, item.NameToken, item.EndToken);
    if (open == 0)
    {
        return false;
    }

    stack u32[0 max] close = MatchingMemberCloseToken(stream, open);
    if (close <= open)
    {
        return false;
    }

    stack mut u32[0 max] segStart = (u32[0 max])(open + 1);
    stack mut u32[0 max] scan = segStart;
    stack mut u32[0 max] segmentDepth = 0;
    while willexit (scan <= close)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            segmentDepth = (u32[0 max])(segmentDepth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (segmentDepth > 0)
            {
                segmentDepth = (u32[0 max])(segmentDepth - 1);
            }
        }

        if (segmentDepth == 0 && (kind == TokenKind.Comma || kind == TokenKind.RParen))
        {
            stack u32[0 max] typeStart = LayoutSkipMemberModifiers(stream, segStart);
            stack u32[0 max] nameToken = LastTypeHeadIdentifierInSpan(stream, typeStart, scan);
            if (nameToken != 0
                && TypeSpanDependsOnEnum(decls, table, source, stream, typeStart, nameToken, (u32[0 max])(depth + 1)))
            {
                return true;
            }

            segStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool DeclarationTypeDependsOnEnum(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem item,
    u32[0 max] depth)
{
    if (depth > 32)
    {
        return false;
    }

    if (item.Kind == DeclarationKind.Enum)
    {
        return true;
    }

    if (RecordHeaderTypeDependsOnEnum(decls, table, source, stream, item, (u32[0 max])(depth + 1)))
    {
        return true;
    }

    if (item.Kind == DeclarationKind.Struct || item.Kind == DeclarationKind.Record)
    {
        stack mut FieldList fields = new();
        switch (ParseStructFields(stream, item.KeywordToken))
        {
            case ParseResult<FieldList>.Err(var fieldsError):
                return false;
            case ParseResult<FieldList>.Ok(var parsed):
                fields = parsed;
        }

        stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < fieldCount; field += 1)
        {
            if (TypeSpanDependsOnEnum(decls, table, source, stream, fields.TypeStartAt(field), fields.TypeEndAt(field), (u32[0 max])(depth + 1)))
            {
                return true;
            }
        }
    }
    else if (item.Kind == DeclarationKind.Alias)
    {
        stack mut u32[0 max] assign = item.KeywordToken;
        while willexit (assign < item.EndToken
            && stream.KindAt((u64[0 2 ** 63 - 1])assign) != TokenKind.Assign)
        {
            assign = (u32[0 max])(assign + 1);
        }

        if (assign < item.EndToken)
        {
            return TypeSpanDependsOnEnum(decls, table, source, stream, (u32[0 max])(assign + 1), item.EndToken, (u32[0 max])(depth + 1));
        }
    }

    return false;
}

internal fn bool TypeNameTokenDependsOnEnum(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] nameToken,
    u32[0 max] depth)
{
    if (nameToken == 0)
    {
        return false;
    }

    stack mut DeclItem item = new();
    stack mut DeclarationKind kind = DeclarationKind.Unknown;
    if (!LayoutTryReadDeclarationItem(decls, table, source, stream, nameToken, item, kind))
    {
        return false;
    }

    return DeclarationTypeDependsOnEnum(decls, table, source, stream, item, depth);
}

internal fn bool TypeSpanDependsOnEnum(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    u32[0 max] depth)
{
    if (depth > 32)
    {
        return false;
    }

    stack mut u32[0 max] index = start;
    while willexit (index < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.LBrack)
        {
            stack u32[0 max] close = MatchingTypeCloseBefore(stream, index, endExclusive);
            if (close >= endExclusive)
            {
                index = endExclusive;
            }
            else
            {
                index = (u32[0 max])(close + 1);
            }
        }
        else if (kind == TokenKind.Lt)
        {
            stack u32[0 max] close = MatchingTypeCloseBefore(stream, index, endExclusive);
            if (close >= endExclusive)
            {
                index = endExclusive;
            }
            else
            {
                if (TypeSpanDependsOnEnum(decls, table, source, stream, (u32[0 max])(index + 1), close, (u32[0 max])(depth + 1)))
                {
                    return true;
                }

                index = (u32[0 max])(close + 1);
            }
        }
        else if (kind == TokenKind.Identifier)
        {
            stack bool isQualifiedPart =
                (index > start && stream.KindAt((u64[0 2 ** 63 - 1])(index - 1)) == TokenKind.Dot)
                || stream.KindAt((u64[0 2 ** 63 - 1])(index + 1)) == TokenKind.Dot;
            if (!isQualifiedPart && TypeNameTokenDependsOnEnum(decls, table, source, stream, index, (u32[0 max])(depth + 1)))
            {
                return true;
            }

            index = (u32[0 max])(index + 1);
        }
        else
        {
            index = (u32[0 max])(index + 1);
        }
    }

    return false;
}

internal fn bool DeclarationHasCopyableAttribute(DeclItem item, ascii source, borrow TokenStream stream)
{
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return false;
        }

        if (AttributeListContainsName(source, stream, scan, attrEnd, "Copyable"))
        {
            return true;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return false;
}

internal fn bool CopyabilityDeclarationHasDestructor(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind != DeclarationKind.Struct && item.Kind != DeclarationKind.Record)
    {
        return false;
    }

    stack mut u32[0 max] open = item.KeywordToken;
    while willexit (open < item.EndToken
        && stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.LBrace
        && stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.EndOfFile)
    {
        open = (u32[0 max])(open + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.LBrace)
    {
        return false;
    }

    stack mut u32[0 max] depth = 1;
    stack mut u32[0 max] scan = (u32[0 max])(open + 1);
    while willexit (scan <= item.EndToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 1 && kind == TokenKind.Drop)
        {
            return true;
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth <= 1)
            {
                return false;
            }

            depth = (u32[0 max])(depth - 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law u32[0 max] DropValidityBodyOpenToken(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind != DeclarationKind.Struct && item.Kind != DeclarationKind.Record)
    {
        return 0;
    }

    stack mut u32[0 max] open = item.KeywordToken;
    while willexit (open < item.EndToken
        && stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.LBrace
        && stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.EndOfFile)
    {
        open = (u32[0 max])(open + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])open) == TokenKind.LBrace)
    {
        return open;
    }

    return 0;
}

internal finite law bool DropValidityTokenIsMutable(borrow TokenStream stream, u32[0 max] dropToken, u32[0 max] bodyOpenToken)
{
    return dropToken > bodyOpenToken
        && stream.KindAt((u64[0 2 ** 63 - 1])(dropToken - 1)) == TokenKind.Mut;
}

internal finite law bool DropValidityTokenIsAssignmentOperator(TokenKind kind)
{
    return kind == TokenKind.Assign
        || kind == TokenKind.WrapAddAssign
        || kind == TokenKind.WrapSubAssign
        || kind == TokenKind.WrapMulAssign
        || kind == TokenKind.SatAddAssign
        || kind == TokenKind.SatSubAssign
        || kind == TokenKind.SatMulAssign
        || kind == TokenKind.AddAssign
        || kind == TokenKind.SubAssign
        || kind == TokenKind.MulAssign
        || kind == TokenKind.DivAssign
        || kind == TokenKind.ModAssign
        || kind == TokenKind.AndAssign
        || kind == TokenKind.OrAssign
        || kind == TokenKind.XorAssign;
}

internal fn bool DropValiditySelfTokenAssignsBeforeStatementEnd(borrow TokenStream stream, u32[0 max] selfToken, u32[0 max] bodyCloseToken)
{
    stack mut u32[0 max] scan = (u32[0 max])(selfToken + 1);
    stack mut u32[0 max] depth = 0;
    while willexit (scan < bodyCloseToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Semi)
        {
            return false;
        }

        if (DropValidityTokenIsAssignmentOperator(kind))
        {
            return true;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            if (depth == 0 && kind == TokenKind.RBrace)
            {
                return false;
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool DropValiditySelfTokenHasRootedCallBeforeStatementEnd(borrow TokenStream stream, u32[0 max] selfToken, u32[0 max] bodyCloseToken)
{
    if ((u32[0 max])(selfToken + 1) >= bodyCloseToken
        || stream.KindAt((u64[0 2 ** 63 - 1])(selfToken + 1)) != TokenKind.Dot)
    {
        return false;
    }

    stack mut u32[0 max] scan = (u32[0 max])(selfToken + 2);
    stack mut u32[0 max] depth = 0;
    while willexit (scan < bodyCloseToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Semi)
        {
            return false;
        }

        if (depth == 0 && kind == TokenKind.LParen)
        {
            return true;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            if (depth == 0 && kind == TokenKind.RBrace)
            {
                return false;
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool DropValidityBodyMutatesSelf(ascii source, borrow TokenStream stream, u32[0 max] bodyOpenToken, u32[0 max] bodyCloseToken)
{
    if (bodyOpenToken == 0 || bodyCloseToken <= bodyOpenToken)
    {
        return false;
    }

    stack mut u32[0 max] scan = (u32[0 max])(bodyOpenToken + 1);
    while willexit (scan < bodyCloseToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Identifier
            && TokenTextEquals(source, stream, scan, "self")
            && (DropValiditySelfTokenAssignsBeforeStatementEnd(stream, scan, bodyCloseToken)
                || DropValiditySelfTokenHasRootedCallBeforeStatementEnd(stream, scan, bodyCloseToken)))
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool DropValidityBodyContainsReturn(borrow TokenStream stream, u32[0 max] bodyOpenToken, u32[0 max] bodyCloseToken)
{
    if (bodyOpenToken == 0 || bodyCloseToken <= bodyOpenToken)
    {
        return false;
    }

    stack mut u32[0 max] scan = (u32[0 max])(bodyOpenToken + 1);
    while willexit (scan < bodyCloseToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Return)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u32[0 max] DropValidityBodyIdentifierToken(ascii source, borrow TokenStream stream, borrow StatementList body, ascii name)
{
    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Identifier
            && TokenTextEquals(source, stream, body.ExprTokenAt(node), name))
        {
            return body.ExprTokenAt(node);
        }
    }

    return 0;
}

internal fn BindResult<FunctionScope> BuildDestructorFunctionScope(DeclItem item, ascii source, borrow TokenStream stream, borrow StatementList body)
{
    stack mut FunctionScope scope = new();
    stack u32[0 max] selfToken = DropValidityBodyIdentifierToken(source, stream, body, "self");
    if (selfToken != 0 && item.NameToken != 0)
    {
        switch (scope.Append(
            selfToken,
            SymbolKind.Parameter,
            0,
            0,
            item.NameToken,
            item.NameToken,
            (u32[0 max])(item.NameToken + 1)))
        {
            case System.Memory.MemoryStatus.Err(var selfError):
                return BindResult<FunctionScope>.Err(BindError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < statementCount; index += 1)
    {
        stack StatementItem local = body.ItemAt(index);
        if ((local.Kind == StatementKind.Local || local.Kind == StatementKind.PatternBinding) && local.NameToken != 0)
        {
            switch (scope.Append(
                local.NameToken,
                SymbolKind.Local,
                body.DepthAt(index),
                (u32[0 max])index,
                local.TypeToken,
                local.TypeStartToken,
                local.TypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var localError):
                    return BindResult<FunctionScope>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return BindResult<FunctionScope>.Ok(scope);
}

internal finite law bool DropValidityStorageAllocates(TokenKind storage)
{
    return storage == TokenKind.Heap || storage == TokenKind.Arena;
}

internal fn bool DropValidityExpressionIsDynamicStorageNew(borrow StatementList body, u32[0 max] node)
{
    return node != 0 && body.ExprKindAt(node) == Compiler.Parsing.ExprKind.New;
}

internal fn System.Memory.MemoryStatus CollectDropBodyMemoryEffectDiagnostics(
    DeclItem item,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] dropBodyOpenToken,
    mut borrow BindDiagnosticList diags)
{
    stack mut StatementList body = new();
    switch (ParseStatements(stream, dropBodyOpenToken))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    stack mut FunctionScope scope = new();
    switch (BuildDestructorFunctionScope(item, source, stream, body))
    {
        case BindResult<FunctionScope>.Err(var scopeError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case BindResult<FunctionScope>.Ok(var builtScope):
            scope = builtScope;
    }

    stack mut ReferenceTable refs = new();
    switch (ResolveReferences(scope, table, source, stream, body))
    {
        case BindResult<ReferenceTable>.Err(var refsError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case BindResult<ReferenceTable>.Ok(var resolvedRefs):
            refs = resolvedRefs;
    }

    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] statement = 0; statement < statementCount; statement += 1)
    {
        stack StatementItem statementItem = body.ItemAt(statement);
        if (statementItem.Kind == StatementKind.Local)
        {
            stack TokenKind storage = stream.KindAt((u64[0 2 ** 63 - 1])statementItem.StartToken);
            if (DropValidityStorageAllocates(storage))
            {
                switch (diags.Append(BindDiagnosticCode.DestructorAllocation, statementItem.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var storageError):
                        return System.Memory.MemoryStatus.Err(storageError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            stack u32[0 max] root = body.ExprRootAt(statement);
            if (TypeSpanIsDynamicStorage(stream, statementItem.TypeStartToken, statementItem.TypeEndToken)
                && DropValidityExpressionIsDynamicStorageNew(body, root))
            {
                switch (diags.Append(BindDiagnosticCode.DestructorAllocation, body.ExprTokenAt(root)))
                {
                    case System.Memory.MemoryStatus.Err(var localDynamicError):
                        return System.Memory.MemoryStatus.Err(localDynamicError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        stack ExprKind kind = body.ExprKindAt(node);
        if (kind == Compiler.Parsing.ExprKind.Assign
            && AssignmentTargetIsDynamicStorage(table, source, refs, scope, stream, body, body.ExprLeftAt(node))
            && DropValidityExpressionIsDynamicStorageNew(body, body.ExprRightAt(node)))
        {
            switch (diags.Append(BindDiagnosticCode.DestructorAllocation, body.ExprTokenAt(body.ExprRightAt(node))))
            {
                case System.Memory.MemoryStatus.Err(var assignDynamicError):
                    return System.Memory.MemoryStatus.Err(assignDynamicError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else if (kind == Compiler.Parsing.ExprKind.Call
            && CallAllocatesDynamicStorage(table, source, refs, scope, stream, body, node))
        {
            switch (diags.Append(BindDiagnosticCode.DestructorAllocation, body.ExprTokenAt(body.ExprLeftAt(node))))
            {
                case System.Memory.MemoryStatus.Err(var callAllocationError):
                    return System.Memory.MemoryStatus.Err(callAllocationError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else if (kind == Compiler.Parsing.ExprKind.Call
            && CallMutatesDynamicStorage(table, source, refs, scope, stream, body, node))
        {
            switch (diags.Append(BindDiagnosticCode.DestructorDynamicStorageMutation, body.ExprTokenAt(body.ExprLeftAt(node))))
            {
                case System.Memory.MemoryStatus.Err(var callMutationError):
                    return System.Memory.MemoryStatus.Err(callMutationError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDropValidityDiagnostics(DeclItem item, borrow DeclarationTable table, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] bodyOpenToken = DropValidityBodyOpenToken(stream, item);
    if (bodyOpenToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] destructorCount = 0;
    stack mut u32[0 max] depth = 1;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpenToken + 1);
    while willexit (scan <= item.EndToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 1 && kind == TokenKind.Drop)
        {
            destructorCount = (u32[0 max])(destructorCount + 1);
            if (destructorCount > 1)
            {
                switch (diags.Append(BindDiagnosticCode.DuplicateDestructorBlock, scan))
                {
                    case System.Memory.MemoryStatus.Err(var duplicateError):
                        return System.Memory.MemoryStatus.Err(duplicateError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            stack mut u32[0 max] dropBodyOpenToken = scan;
            while willexit (dropBodyOpenToken <= item.EndToken
                && stream.KindAt((u64[0 2 ** 63 - 1])dropBodyOpenToken) != TokenKind.LBrace
                && stream.KindAt((u64[0 2 ** 63 - 1])dropBodyOpenToken) != TokenKind.EndOfFile)
            {
                dropBodyOpenToken = (u32[0 max])(dropBodyOpenToken + 1);
            }

            if (stream.KindAt((u64[0 2 ** 63 - 1])dropBodyOpenToken) == TokenKind.LBrace)
            {
                stack u32[0 max] dropBodyCloseToken = MatchingMemberCloseToken(stream, dropBodyOpenToken);
                stack bool isMutable = DropValidityTokenIsMutable(stream, scan, bodyOpenToken);
                stack bool mutatesSelf = DropValidityBodyMutatesSelf(source, stream, dropBodyOpenToken, dropBodyCloseToken);
                if (!isMutable && mutatesSelf)
                {
                    switch (diags.Append(BindDiagnosticCode.ReadOnlyDropMutatesSelf, scan))
                    {
                        case System.Memory.MemoryStatus.Err(var readOnlyError):
                            return System.Memory.MemoryStatus.Err(readOnlyError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                if (isMutable && !mutatesSelf)
                {
                    switch (diags.AppendWarning(BindDiagnosticCode.MutDropWithoutSelfMutation, scan))
                    {
                        case System.Memory.MemoryStatus.Err(var warningError):
                            return System.Memory.MemoryStatus.Err(warningError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                if (DropValidityBodyContainsReturn(stream, dropBodyOpenToken, dropBodyCloseToken))
                {
                    switch (diags.Append(BindDiagnosticCode.DestructorReturn, scan))
                    {
                        case System.Memory.MemoryStatus.Err(var returnError):
                            return System.Memory.MemoryStatus.Err(returnError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                switch (CollectDropBodyMemoryEffectDiagnostics(item, table, source, stream, dropBodyOpenToken, diags))
                {
                    case System.Memory.MemoryStatus.Err(var effectError):
                        return System.Memory.MemoryStatus.Err(effectError);
                    case System.Memory.MemoryStatus.Ok:
                }

                if (dropBodyCloseToken > dropBodyOpenToken)
                {
                    scan = dropBodyCloseToken;
                }
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth <= 1)
            {
                return System.Memory.MemoryStatus.Ok;
            }

            depth = (u32[0 max])(depth - 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool CopyabilityTryTopLevelSuffixBracket(
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    out u32[0 max] open,
    out u32[0 max] close)
{
    open = 0;
    close = 0;
    if (start >= endExclusive)
    {
        return false;
    }

    stack mut u32[0 max] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.LBrack)
        {
            if (depth == 0)
            {
                stack u32[0 max] bracketClose = MatchingTypeCloseBefore(stream, scan, endExclusive);
                if ((u32[0 max])(bracketClose + 1) == endExclusive)
                {
                    open = scan;
                    close = bracketClose;
                    return true;
                }
            }

            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Lt || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrack || kind == TokenKind.Gt || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool CopyabilityTypeSpanIsSlice(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] open = 0;
    stack mut u32[0 max] close = 0;
    return CopyabilityTryTopLevelSuffixBracket(stream, start, endExclusive, open, close)
        && close == (u32[0 max])(open + 1);
}

internal fn bool CopyabilityTryFindFactIndex(
    ascii source,
    borrow TokenStream stream,
    borrow CopyabilityFactTable facts,
    u32[0 max] nameToken,
    out u64[0 2 ** 63 - 1] factIndex)
{
    factIndex = 0;
    stack u64[0 2 ** 63 - 1] count = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, facts.NameTokenAt(index), nameToken))
        {
            factIndex = index;
            return true;
        }
    }

    return false;
}

internal fn bool CopyabilityNamedTypeIsCopyableCached(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    u32[0 max] nameToken,
    u32[0 max] depth)
{
    if (nameToken == 0 || depth > 32)
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] factIndex = 0;
    if (!CopyabilityTryFindFactIndex(source, stream, facts, nameToken, factIndex))
    {
        return false;
    }

    stack u32[0 max] state = facts.StateAt(factIndex);
    if (state == 1)
    {
        return false;
    }

    if (state == 2)
    {
        return facts.IsCopyableAt(factIndex);
    }

    facts.SetStateAt(factIndex, 1);
    stack mut DeclItem item = new();
    stack mut DeclarationKind declarationKind = DeclarationKind.Unknown;
    stack mut bool copyable = false;
    if (LayoutTryReadDeclarationItem(decls, table, source, stream, nameToken, item, declarationKind))
    {
        copyable = CopyabilityDeclarationIsStructurallyCopyable(decls, table, source, stream, facts, item, (u32[0 max])(depth + 1));
    }

    facts.SetCopyableAt(factIndex, copyable);
    facts.SetStateAt(factIndex, 2);
    return copyable;
}

internal fn bool CopyabilityTypeSpanIsCopyable(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    u32[0 max] start,
    u32[0 max] endExclusive,
    u32[0 max] depth)
{
    if (start >= endExclusive || depth > 32)
    {
        return false;
    }

    if (TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Borrow)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Retborrow)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Storeborrow)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Out)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Init))
    {
        return false;
    }

    if (TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Dynamic)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.AsciiOwned)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.UnicodeOwned)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Closure))
    {
        return false;
    }

    if (CopyabilityTypeSpanIsSlice(stream, start, endExclusive))
    {
        return true;
    }

    stack mut u32[0 max] suffixOpen = 0;
    stack mut u32[0 max] suffixClose = 0;
    if (CopyabilityTryTopLevelSuffixBracket(stream, start, endExclusive, suffixOpen, suffixClose)
        && suffixOpen > start)
    {
        return CopyabilityTypeSpanIsCopyable(decls, table, source, stream, facts, start, suffixOpen, (u32[0 max])(depth + 1));
    }

    stack u32[0 max] primary = LayoutBoundedFirstTypeStart(stream, start, endExclusive);
    if (primary == 0)
    {
        return false;
    }

    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])primary);
    if (primaryKind == TokenKind.Bool
        || primaryKind == TokenKind.IntegerType
        || primaryKind == TokenKind.FloatType
        || primaryKind == TokenKind.Rawptr
        || primaryKind == TokenKind.Rawmutptr
        || primaryKind == TokenKind.Fnptr
        || primaryKind == TokenKind.AsciiView
        || primaryKind == TokenKind.UnicodeView)
    {
        return true;
    }

    if (primaryKind != TokenKind.Identifier)
    {
        return false;
    }

    stack mut u32[0 max] head = LastTypeHeadIdentifierInSpan(stream, start, endExclusive);
    if (head == 0)
    {
        head = primary;
    }

    if (TokenTextEquals(source, stream, head, "OwnedAscii")
        || TokenTextEquals(source, stream, head, "OwnedUnicode"))
    {
        return false;
    }

    if (LayoutNameIsSystemCAlias(source, stream, head))
    {
        return true;
    }

    if (LayoutTypeSpanHasTopLevelGenericArguments(stream, head, endExclusive))
    {
        return false;
    }

    return CopyabilityNamedTypeIsCopyableCached(decls, table, source, stream, facts, head, (u32[0 max])(depth + 1));
}

internal fn bool CopyabilityRecordHeaderFieldsAreCopyable(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    DeclItem item,
    u32[0 max] depth)
{
    if (item.Kind != DeclarationKind.Record || item.NameToken == 0 || depth > 32)
    {
        return true;
    }

    stack u32[0 max] open = RecordHeaderOpenToken(stream, item.NameToken, item.EndToken);
    if (open == 0)
    {
        return true;
    }

    stack u32[0 max] close = MatchingMemberCloseToken(stream, open);
    if (close <= open)
    {
        return true;
    }

    stack mut u32[0 max] segStart = (u32[0 max])(open + 1);
    stack mut u32[0 max] scan = segStart;
    stack mut u32[0 max] segmentDepth = 0;
    while willexit (scan <= close)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            segmentDepth = (u32[0 max])(segmentDepth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (segmentDepth > 0)
            {
                segmentDepth = (u32[0 max])(segmentDepth - 1);
            }
        }

        if (segmentDepth == 0 && (kind == TokenKind.Comma || kind == TokenKind.RParen))
        {
            stack u32[0 max] typeStart = LayoutSkipMemberModifiers(stream, segStart);
            stack u32[0 max] nameToken = LastTypeHeadIdentifierInSpan(stream, typeStart, scan);
            if (nameToken != 0
                && !CopyabilityTypeSpanIsCopyable(decls, table, source, stream, facts, typeStart, nameToken, (u32[0 max])(depth + 1)))
            {
                return false;
            }

            segStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return true;
}

internal fn bool CopyabilityAliasIsStructurallyCopyable(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    DeclItem item,
    u32[0 max] depth)
{
    stack mut u32[0 max] assign = item.KeywordToken;
    while willexit (assign < item.EndToken
        && stream.KindAt((u64[0 2 ** 63 - 1])assign) != TokenKind.Assign)
    {
        assign = (u32[0 max])(assign + 1);
    }

    if (assign >= item.EndToken)
    {
        return false;
    }

    return CopyabilityTypeSpanIsCopyable(decls, table, source, stream, facts, (u32[0 max])(assign + 1), item.EndToken, (u32[0 max])(depth + 1));
}

internal fn bool CopyabilityDeclarationIsStructurallyCopyable(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    DeclItem item,
    u32[0 max] depth)
{
    if (depth > 32 || item.NameToken == 0)
    {
        return false;
    }

    if (InlineLayoutDeclarationGenericOpen(stream, item.KeywordToken) != 0)
    {
        return false;
    }

    if (item.Kind == DeclarationKind.Alias)
    {
        return CopyabilityAliasIsStructurallyCopyable(decls, table, source, stream, facts, item, (u32[0 max])(depth + 1));
    }

    if (item.Kind == DeclarationKind.Enum)
    {
        stack mut TypeSpanList payloads = new();
        switch (ParseEnumPayloadTypeSpans(stream, item.KeywordToken))
        {
            case ParseResult<TypeSpanList>.Err(var payloadError):
                return false;
            case ParseResult<TypeSpanList>.Ok(var parsedPayloads):
                payloads = parsedPayloads;
        }

        stack u64[0 2 ** 63 - 1] payloadCount = payloads.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] payload = 0; payload < payloadCount; payload += 1)
        {
            if (!CopyabilityTypeSpanIsCopyable(
                decls,
                table,
                source,
                stream,
                facts,
                payloads.StartTokenAt(payload),
                payloads.EndTokenAt(payload),
                (u32[0 max])(depth + 1)))
            {
                return false;
            }
        }

        return true;
    }

    if (item.Kind != DeclarationKind.Struct && item.Kind != DeclarationKind.Record)
    {
        return false;
    }

    if (CopyabilityDeclarationHasDestructor(stream, item)
        || !CopyabilityRecordHeaderFieldsAreCopyable(decls, table, source, stream, facts, item, (u32[0 max])(depth + 1)))
    {
        return false;
    }

    stack mut FieldList fields = new();
    switch (ParseStructFields(stream, item.KeywordToken))
    {
        case ParseResult<FieldList>.Err(var fieldError):
            return false;
        case ParseResult<FieldList>.Ok(var parsedFields):
            fields = parsedFields;
    }

    stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < fieldCount; field += 1)
    {
        if (!CopyabilityTypeSpanIsCopyable(
            decls,
            table,
            source,
            stream,
            facts,
            fields.TypeStartAt(field),
            fields.TypeEndAt(field),
            (u32[0 max])(depth + 1)))
        {
            return false;
        }
    }

    return true;
}

public fn BindResult<CopyabilityFactTable> BuildCopyabilityFacts(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream)
{
    stack mut CopyabilityFactTable facts = new();
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (item.NameToken != 0
            && (item.Kind == DeclarationKind.Struct
                || item.Kind == DeclarationKind.Record
                || item.Kind == DeclarationKind.Enum
                || item.Kind == DeclarationKind.Alias))
        {
            switch (facts.AppendPending(item.NameToken))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return BindResult<CopyabilityFactTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack u64[0 2 ** 63 - 1] factCount = facts.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] fact = 0; fact < factCount; fact += 1)
    {
        stack u32[0 max] nameToken = facts.NameTokenAt(fact);
        CopyabilityNamedTypeIsCopyableCached(decls, table, source, stream, facts, nameToken, 0);
    }

    return BindResult<CopyabilityFactTable>.Ok(facts);
}

internal struct ConstructorAssignedFieldTable
{
    internal dynamic u32[0 max] FieldTokens;

    ConstructorAssignedFieldTable()
    {
        self.FieldTokens = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow ConstructorAssignedFieldTable self)
    {
        return self.FieldTokens.Length;
    }

    internal law u32[0 max] FieldTokenAt(borrow ConstructorAssignedFieldTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.FieldTokens.Length)
        {
            token = self.FieldTokens[index];
        }

        return token;
    }

    internal fn bool Contains(borrow ConstructorAssignedFieldTable self, ascii source, borrow TokenStream stream, u32[0 max] fieldToken)
    {
        stack mut bool found = false;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (!found && TokenTextEqualsToken(source, stream, self.FieldTokenAt(index), fieldToken))
            {
                found = true;
            }
        }

        return found;
    }

    internal fn System.Memory.MemoryStatus MarkAssigned(mut borrow ConstructorAssignedFieldTable self, ascii source, borrow TokenStream stream, u32[0 max] fieldToken)
    {
        if (fieldToken == 0 || self.Contains(source, stream, fieldToken))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.FieldTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.FieldTokens[self.FieldTokens.Length] = fieldToken;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal fn System.Memory.MemoryStatus CopyConstructorAssignedFields(
    borrow ConstructorAssignedFieldTable sourceTable,
    mut borrow ConstructorAssignedFieldTable targetTable)
{
    stack u64[0 2 ** 63 - 1] count = sourceTable.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (!targetTable.FieldTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init targetTable.FieldTokens[targetTable.FieldTokens.Length] = sourceTable.FieldTokenAt(index);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus ReplaceConstructorAssignedFields(
    borrow ConstructorAssignedFieldTable sourceTable,
    mut borrow ConstructorAssignedFieldTable targetTable)
{
    targetTable.FieldTokens = new();
    return CopyConstructorAssignedFields(sourceTable, targetTable);
}

internal fn System.Memory.MemoryStatus IntersectConstructorAssignedFields(
    borrow ConstructorAssignedFieldTable left,
    borrow ConstructorAssignedFieldTable right,
    ascii source,
    borrow TokenStream stream,
    mut borrow ConstructorAssignedFieldTable targetTable)
{
    stack u64[0 2 ** 63 - 1] count = left.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack u32[0 max] fieldToken = left.FieldTokenAt(index);
        if (right.Contains(source, stream, fieldToken))
        {
            switch (targetTable.MarkAssigned(source, stream, fieldToken))
            {
                case System.Memory.MemoryStatus.Err(var markError):
                    return System.Memory.MemoryStatus.Err(markError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool ConstructorTypeSpanIsFixedArray(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] open = 0;
    stack mut u32[0 max] close = 0;
    if (!CopyabilityTryTopLevelSuffixBracket(stream, start, endExclusive, open, close)
        || close <= (u32[0 max])(open + 1))
    {
        return false;
    }

    if (open == 0)
    {
        return false;
    }

    // `i32[min max]` is an integer range, not a fixed array suffix.
    return stream.KindAt((u64[0 2 ** 63 - 1])(open - 1)) != TokenKind.IntegerType;
}

internal fn bool ConstructorFieldRequiresAssignment(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    borrow FieldList fields,
    u32[0 max] fieldToken)
{
    stack u64[0 2 ** 63 - 1] count = fields.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, fields.NameTokenAt(index), fieldToken))
        {
            stack u32[0 max] typeStart = fields.TypeStartAt(index);
            stack u32[0 max] typeEnd = fields.TypeEndAt(index);
            return !ConstructorTypeSpanIsFixedArray(stream, typeStart, typeEnd)
                && !CopyabilityTypeSpanIsCopyable(decls, table, source, stream, facts, typeStart, typeEnd, 0);
        }
    }

    return false;
}

internal fn bool ConstructorSelfFieldMemberRequiresAssignment(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    borrow FieldList fields,
    borrow StatementList body,
    u32[0 max] node,
    out u32[0 max] fieldToken)
{
    fieldToken = 0;
    if (node == 0 || body.ExprKindAt(node) != Compiler.Parsing.ExprKind.Member)
    {
        return false;
    }

    stack u32[0 max] receiver = body.ExprLeftAt(node);
    if (receiver == 0
        || body.ExprKindAt(receiver) != Compiler.Parsing.ExprKind.Identifier
        || !TokenTextEquals(source, stream, body.ExprTokenAt(receiver), "self"))
    {
        return false;
    }

    stack u32[0 max] memberToken = body.ExprTokenAt(node);
    if (!ConstructorFieldRequiresAssignment(decls, table, source, stream, facts, fields, memberToken))
    {
        return false;
    }

    fieldToken = memberToken;
    return true;
}

internal struct ConstructorExpressionWorkStack
{
    internal dynamic u32[0 max] Nodes;
    internal dynamic u32[0 max] Phases;

    ConstructorExpressionWorkStack()
    {
        self.Nodes = new();
        self.Phases = new();
    }

    internal fn System.Memory.MemoryStatus Push(mut borrow ConstructorExpressionWorkStack self, u32[0 max] node, u32[0 max] phase)
    {
        if (node == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.Nodes.TryReserve(1)
            || !self.Phases.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Nodes[self.Nodes.Length] = node;
        init self.Phases[self.Phases.Length] = phase;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn bool TryPop(mut borrow ConstructorExpressionWorkStack self, out u32[0 max] node, out u32[0 max] phase)
    {
        node = 0;
        phase = 0;
        if (self.Nodes.Length == 0 || self.Phases.Length == 0)
        {
            return false;
        }

        node = self.Nodes.MoveLast();
        phase = self.Phases.MoveLast();
        return true;
    }
}

internal fn System.Memory.MemoryStatus CollectConstructorFieldReadsInExpression(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    borrow FieldList fields,
    borrow StatementList body,
    u32[0 max] node,
    mut borrow ConstructorAssignedFieldTable assigned,
    mut borrow BindDiagnosticList diags,
    u32[0 max] depth)
{
    stack mut ConstructorExpressionWorkStack work = new();
    switch (work.Push(node, 0))
    {
        case System.Memory.MemoryStatus.Err(var pushRootError):
            return System.Memory.MemoryStatus.Err(pushRootError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut u32[0 max] current = 0;
    stack mut u32[0 max] phase = 0;
    while willexit (work.TryPop(current, phase))
    {
        if (phase == 1)
        {
            stack mut u32[0 max] assignedField = 0;
            if (ConstructorSelfFieldMemberRequiresAssignment(
                decls,
                table,
                source,
                stream,
                facts,
                fields,
                body,
                current,
                assignedField))
            {
                switch (assigned.MarkAssigned(source, stream, assignedField))
                {
                    case System.Memory.MemoryStatus.Err(var assignedError):
                        return System.Memory.MemoryStatus.Err(assignedError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            continue;
        }

        stack ExprKind kind = body.ExprKindAt(current);
        if (kind == Compiler.Parsing.ExprKind.Assign)
        {
            stack TokenKind operatorKind = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(current));
            if (operatorKind == TokenKind.Assign)
            {
                stack mut u32[0 max] directAssignedField = 0;
                if (ConstructorSelfFieldMemberRequiresAssignment(
                    decls,
                    table,
                    source,
                    stream,
                    facts,
                    fields,
                    body,
                    body.ExprLeftAt(current),
                    directAssignedField))
                {
                    switch (work.Push(body.ExprLeftAt(current), 1))
                    {
                        case System.Memory.MemoryStatus.Err(var markPushError):
                            return System.Memory.MemoryStatus.Err(markPushError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
                else
                {
                    switch (work.Push(body.ExprLeftAt(current), 0))
                    {
                        case System.Memory.MemoryStatus.Err(var leftPushError):
                            return System.Memory.MemoryStatus.Err(leftPushError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                switch (work.Push(body.ExprRightAt(current), 0))
                {
                    case System.Memory.MemoryStatus.Err(var rightPushError):
                        return System.Memory.MemoryStatus.Err(rightPushError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else
            {
                switch (work.Push(body.ExprRightAt(current), 0))
                {
                    case System.Memory.MemoryStatus.Err(var compoundRightPushError):
                        return System.Memory.MemoryStatus.Err(compoundRightPushError);
                    case System.Memory.MemoryStatus.Ok:
                }

                switch (work.Push(body.ExprLeftAt(current), 0))
                {
                    case System.Memory.MemoryStatus.Err(var compoundLeftPushError):
                        return System.Memory.MemoryStatus.Err(compoundLeftPushError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Member)
        {
            stack mut u32[0 max] fieldToken = 0;
            if (ConstructorSelfFieldMemberRequiresAssignment(
                decls,
                table,
                source,
                stream,
                facts,
                fields,
                body,
                current,
                fieldToken))
            {
                if (!assigned.Contains(source, stream, fieldToken))
                {
                    switch (diags.Append(BindDiagnosticCode.ConstructorFieldReadBeforeAssignment, fieldToken))
                    {
                        case System.Memory.MemoryStatus.Err(var diagError):
                            return System.Memory.MemoryStatus.Err(diagError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                continue;
            }

            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var memberReceiverPushError):
                    return System.Memory.MemoryStatus.Err(memberReceiverPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Binary
            || kind == Compiler.Parsing.ExprKind.Index)
        {
            switch (work.Push(body.ExprAuxAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var auxPushError):
                    return System.Memory.MemoryStatus.Err(auxPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (work.Push(body.ExprRightAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var rightPushError):
                    return System.Memory.MemoryStatus.Err(rightPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var leftPushError):
                    return System.Memory.MemoryStatus.Err(leftPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Unary)
        {
            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var unaryPushError):
                    return System.Memory.MemoryStatus.Err(unaryPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Call || kind == Compiler.Parsing.ExprKind.New)
        {
            stack mut u32[0 max] remainingArgs = body.ExprCallArgCountAt(current);
            while willexit (remainingArgs > 0)
            {
                remainingArgs = (u32[0 max])(remainingArgs - 1);
                switch (work.Push(body.ExprCallArgAt(current, remainingArgs), 0))
                {
                    case System.Memory.MemoryStatus.Err(var argPushError):
                        return System.Memory.MemoryStatus.Err(argPushError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var calleePushError):
                    return System.Memory.MemoryStatus.Err(calleePushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Conversion)
        {
            switch (work.Push(body.ExprRightAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var conversionPushError):
                    return System.Memory.MemoryStatus.Err(conversionPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Conditional)
        {
            switch (work.Push(body.ExprAuxAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var elsePushError):
                    return System.Memory.MemoryStatus.Err(elsePushError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (work.Push(body.ExprRightAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var thenPushError):
                    return System.Memory.MemoryStatus.Err(thenPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var conditionPushError):
                    return System.Memory.MemoryStatus.Err(conditionPushError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool ConstructorIfStatementHasCompleteElse(borrow TokenStream stream, StatementItem item)
{
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan <= item.EndToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Else
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) != TokenKind.If)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u32[0 max] ConstructorIfBraceArmCount(borrow TokenStream stream, StatementItem item)
{
    stack mut u32[0 max] cursor = (u32[0 max])(item.StartToken + 1);
    stack mut u32[0 max] parenDepth = 0;
    stack mut bool foundHeader = false;
    stack mut bool headerDone = false;
    while willexit (cursor <= item.EndToken && !headerDone)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
        if (kind == TokenKind.LParen)
        {
            foundHeader = true;
            parenDepth = (u32[0 max])(parenDepth + 1);
        }
        else if (kind == TokenKind.RParen && foundHeader)
        {
            if (parenDepth > 0)
            {
                parenDepth = (u32[0 max])(parenDepth - 1);
            }

            if (parenDepth == 0)
            {
                headerDone = true;
            }
        }
        else if (kind == TokenKind.LBrace && !foundHeader)
        {
            headerDone = true;
            continue;
        }

        cursor = (u32[0 max])(cursor + 1);
    }

    stack mut u32[0 max] braceDepth = 0;
    stack mut u32[0 max] armCount = 0;
    while willexit (cursor <= item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
        if (kind == TokenKind.LBrace)
        {
            if (braceDepth == 0)
            {
                armCount = (u32[0 max])(armCount + 1);
            }

            braceDepth = (u32[0 max])(braceDepth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (braceDepth > 0)
            {
                braceDepth = (u32[0 max])(braceDepth - 1);
            }
        }

        cursor = (u32[0 max])(cursor + 1);
    }

    return armCount;
}

internal fn u64[0 2 ** 63 - 1] ConstructorStatementSubtreeEnd(borrow StatementList body, u64[0 2 ** 63 - 1] statement)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    if (statement >= count)
    {
        return count;
    }

    stack u32[0 max] depth = body.DepthAt(statement);
    stack mut u64[0 2 ** 63 - 1] scan = statement + 1;
    while willexit (scan < count && body.DepthAt(scan) > depth)
    {
        scan += 1;
    }

    return scan;
}

internal fn u64[0 2 ** 63 - 1] ConstructorNextIfArmEnd(
    borrow StatementList body,
    u64[0 2 ** 63 - 1] armStart,
    u64[0 2 ** 63 - 1] subtreeEnd,
    u32[0 max] parentDepth,
    u32[0 max] armScope)
{
    stack mut u64[0 2 ** 63 - 1] scan = armStart + 1;
    while willexit (scan < subtreeEnd)
    {
        if (body.DepthAt(scan) == parentDepth + 1 && body.ScopeIdAt(scan) != armScope)
        {
            return scan;
        }

        scan += 1;
    }

    return subtreeEnd;
}

internal fn System.Memory.MemoryStatus CollectConstructorFieldReadsInIfArms(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    borrow FieldList fields,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] firstArmStatement,
    u64[0 2 ** 63 - 1] subtreeEnd,
    u32[0 max] parentDepth,
    bool hasCompleteElse,
    u32[0 max] sourceArmCount,
    mut borrow ConstructorAssignedFieldTable assigned,
    mut borrow BindDiagnosticList diags,
    out bool canContinue)
{
    canContinue = false;
    stack mut ConstructorAssignedFieldTable merged = new();
    stack mut bool haveMergedArm = false;
    stack mut u32[0 max] statementArmCount = 0;
    stack mut u64[0 2 ** 63 - 1] armStart = firstArmStatement;
    while willexit (armStart < subtreeEnd)
    {
        if (body.DepthAt(armStart) != parentDepth + 1)
        {
            armStart += 1;
            continue;
        }

        stack u32[0 max] armScope = body.ScopeIdAt(armStart);
        stack u64[0 2 ** 63 - 1] armEnd = ConstructorNextIfArmEnd(body, armStart, subtreeEnd, parentDepth, armScope);
        stack mut ConstructorAssignedFieldTable armAssigned = new();
        switch (CopyConstructorAssignedFields(assigned, armAssigned))
        {
            case System.Memory.MemoryStatus.Err(var copyArmError):
                return System.Memory.MemoryStatus.Err(copyArmError);
            case System.Memory.MemoryStatus.Ok:
        }

        stack mut bool armCanContinue = true;
        switch (CollectConstructorFieldReadsInStatementRange(
            decls,
            table,
            source,
            stream,
            facts,
            fields,
            body,
            armStart,
            armEnd,
            (u32[0 max])(parentDepth + 1),
            armAssigned,
            diags,
            armCanContinue))
        {
            case System.Memory.MemoryStatus.Err(var armError):
                return System.Memory.MemoryStatus.Err(armError);
            case System.Memory.MemoryStatus.Ok:
        }

        statementArmCount = (u32[0 max])(statementArmCount + 1);
        if (armCanContinue)
        {
            canContinue = true;
            if (!haveMergedArm)
            {
                switch (CopyConstructorAssignedFields(armAssigned, merged))
                {
                    case System.Memory.MemoryStatus.Err(var firstMergeError):
                        return System.Memory.MemoryStatus.Err(firstMergeError);
                    case System.Memory.MemoryStatus.Ok:
                }

                haveMergedArm = true;
            }
            else
            {
                stack mut ConstructorAssignedFieldTable intersection = new();
                switch (IntersectConstructorAssignedFields(merged, armAssigned, source, stream, intersection))
                {
                    case System.Memory.MemoryStatus.Err(var intersectError):
                        return System.Memory.MemoryStatus.Err(intersectError);
                    case System.Memory.MemoryStatus.Ok:
                }

                merged = intersection;
            }
        }

        armStart = armEnd;
    }

    if (!hasCompleteElse || sourceArmCount > statementArmCount)
    {
        canContinue = true;
        if (!haveMergedArm)
        {
            switch (CopyConstructorAssignedFields(assigned, merged))
            {
                case System.Memory.MemoryStatus.Err(var implicitCopyError):
                    return System.Memory.MemoryStatus.Err(implicitCopyError);
                case System.Memory.MemoryStatus.Ok:
            }

            haveMergedArm = true;
        }
        else
        {
            stack mut ConstructorAssignedFieldTable implicitIntersection = new();
            switch (IntersectConstructorAssignedFields(merged, assigned, source, stream, implicitIntersection))
            {
                case System.Memory.MemoryStatus.Err(var implicitIntersectError):
                    return System.Memory.MemoryStatus.Err(implicitIntersectError);
                case System.Memory.MemoryStatus.Ok:
            }

            merged = implicitIntersection;
        }
    }

    if (canContinue && haveMergedArm)
    {
        switch (ReplaceConstructorAssignedFields(merged, assigned))
        {
            case System.Memory.MemoryStatus.Err(var replaceError):
                return System.Memory.MemoryStatus.Err(replaceError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectConstructorFieldReadsInStatementRange(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    borrow FieldList fields,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] startStatement,
    u64[0 2 ** 63 - 1] endStatement,
    u32[0 max] depth,
    mut borrow ConstructorAssignedFieldTable assigned,
    mut borrow BindDiagnosticList diags,
    out bool canContinue)
{
    canContinue = true;
    stack mut u64[0 2 ** 63 - 1] statement = startStatement;
    while willexit (statement < endStatement)
    {
        if (body.DepthAt(statement) < depth)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (body.DepthAt(statement) > depth)
        {
            statement += 1;
            continue;
        }

        stack StatementItem item = body.ItemAt(statement);
        switch (CollectConstructorFieldReadsInExpression(
            decls,
            table,
            source,
            stream,
            facts,
            fields,
            body,
            body.ExprRootAt(statement),
            assigned,
            diags,
            0))
        {
            case System.Memory.MemoryStatus.Err(var expressionError):
                return System.Memory.MemoryStatus.Err(expressionError);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == StatementKind.Return || item.Kind == StatementKind.Become)
        {
            canContinue = false;
            return System.Memory.MemoryStatus.Ok;
        }

        if (item.Kind == StatementKind.If)
        {
            stack u64[0 2 ** 63 - 1] subtreeEnd = ConstructorStatementSubtreeEnd(body, statement);
            stack mut bool branchCanContinue = true;
            switch (CollectConstructorFieldReadsInIfArms(
                decls,
                table,
                source,
                stream,
                facts,
                fields,
                body,
                statement + 1,
                subtreeEnd,
                depth,
                ConstructorIfStatementHasCompleteElse(stream, item),
                ConstructorIfBraceArmCount(stream, item),
                assigned,
                diags,
                branchCanContinue))
            {
                case System.Memory.MemoryStatus.Err(var branchError):
                    return System.Memory.MemoryStatus.Err(branchError);
                case System.Memory.MemoryStatus.Ok:
            }

            statement = subtreeEnd;
            if (!branchCanContinue)
            {
                canContinue = false;
                return System.Memory.MemoryStatus.Ok;
            }

            continue;
        }

        if (item.Kind == StatementKind.Block || item.Kind == StatementKind.Unsafe)
        {
            stack u64[0 2 ** 63 - 1] subtreeEnd = ConstructorStatementSubtreeEnd(body, statement);
            stack mut bool blockCanContinue = true;
            switch (CollectConstructorFieldReadsInStatementRange(
                decls,
                table,
                source,
                stream,
                facts,
                fields,
                body,
                statement + 1,
                subtreeEnd,
                (u32[0 max])(depth + 1),
                assigned,
                diags,
                blockCanContinue))
            {
                case System.Memory.MemoryStatus.Err(var blockError):
                    return System.Memory.MemoryStatus.Err(blockError);
                case System.Memory.MemoryStatus.Ok:
            }

            statement = subtreeEnd;
            if (!blockCanContinue)
            {
                canContinue = false;
                return System.Memory.MemoryStatus.Ok;
            }

            continue;
        }

        if (item.Kind == StatementKind.While
            || item.Kind == StatementKind.For
            || item.Kind == StatementKind.ForEach
            || item.Kind == StatementKind.Switch)
        {
            stack u64[0 2 ** 63 - 1] subtreeEnd = ConstructorStatementSubtreeEnd(body, statement);
            stack mut ConstructorAssignedFieldTable nestedAssigned = new();
            switch (CopyConstructorAssignedFields(assigned, nestedAssigned))
            {
                case System.Memory.MemoryStatus.Err(var nestedCopyError):
                    return System.Memory.MemoryStatus.Err(nestedCopyError);
                case System.Memory.MemoryStatus.Ok:
            }

            stack mut bool nestedCanContinue = true;
            switch (CollectConstructorFieldReadsInStatementRange(
                decls,
                table,
                source,
                stream,
                facts,
                fields,
                body,
                statement + 1,
                subtreeEnd,
                (u32[0 max])(depth + 1),
                nestedAssigned,
                diags,
                nestedCanContinue))
            {
                case System.Memory.MemoryStatus.Err(var nestedError):
                    return System.Memory.MemoryStatus.Err(nestedError);
                case System.Memory.MemoryStatus.Ok:
            }

            statement = subtreeEnd;
            continue;
        }

        statement += 1;
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectConstructorFieldReadsInBody(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    borrow FieldList fields,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    stack mut ConstructorAssignedFieldTable assigned = new();
    stack mut bool canContinue = true;
    return CollectConstructorFieldReadsInStatementRange(decls, table, source, stream, facts, fields, body, 0, body.Count(), 0, assigned, diags, canContinue);
}

internal finite law u32[0 max] ConstructorMemberBodyOpenToken(borrow TokenStream stream, u32[0 max] nameToken, u32[0 max] memberEnd)
{
    stack mut u32[0 max] scan = nameToken;
    stack mut u32[0 max] parenDepth = 0;
    stack mut u32[0 max] bracketDepth = 0;
    stack mut u32[0 max] angleDepth = 0;
    while willexit (scan <= memberEnd)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.LBrace && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.LParen)
        {
            parenDepth = (u32[0 max])(parenDepth + 1);
        }
        else if (kind == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = (u32[0 max])(parenDepth - 1);
            }
        }
        else if (kind == TokenKind.LBrack)
        {
            bracketDepth = (u32[0 max])(bracketDepth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = (u32[0 max])(bracketDepth - 1);
            }
        }
        else if (kind == TokenKind.Lt)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn u32[0 max] ConstructorMemberNameToken(DeclItem item, ascii source, borrow TokenStream stream, u32[0 max] memberStart, u32[0 max] memberEnd)
{
    stack u32[0 max] cursor = LayoutSkipMemberModifiers(stream, memberStart);
    if (cursor > memberEnd
        || stream.KindAt((u64[0 2 ** 63 - 1])cursor) != TokenKind.Identifier
        || !TokenTextEqualsToken(source, stream, cursor, item.NameToken)
        || stream.KindAt((u64[0 2 ** 63 - 1])(cursor + 1)) != TokenKind.LParen)
    {
        return 0;
    }

    stack u32[0 max] closeParen = MatchingMemberCloseToken(stream, (u32[0 max])(cursor + 1));
    if (closeParen <= cursor || closeParen > memberEnd)
    {
        return 0;
    }

    if (ConstructorMemberBodyOpenToken(stream, cursor, memberEnd) == 0)
    {
        return 0;
    }

    return cursor;
}

internal fn System.Memory.MemoryStatus CollectConstructorInitializationDiagnostics(
    DeclItem item,
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    mut borrow BindDiagnosticList diags)
{
    if (item.Kind != DeclarationKind.Struct)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut FieldList fields = new();
    switch (ParseStructFields(stream, item.KeywordToken))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<FieldList>.Ok(var parsedFields):
            fields = parsedFields;
    }

    stack u32[0 max] bodyOpen = ReceiverBodyOpenToken(stream, item.NameToken);
    if (bodyOpen == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] memberStart = (u32[0 max])(bodyOpen + 1);
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind startKind = stream.KindAt((u64[0 2 ** 63 - 1])memberStart);
        if (startKind == TokenKind.EndOfFile || startKind == TokenKind.RBrace || memberStart >= item.EndToken)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u32[0 max] memberEnd = LayoutSkipDeclarationBody(stream, memberStart);
        if (memberEnd < memberStart)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u32[0 max] constructorNameToken = ConstructorMemberNameToken(item, source, stream, memberStart, memberEnd);
        if (constructorNameToken != 0)
        {
            switch (ParseFunctionBody(stream, constructorNameToken))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                {
                }
                case ParseResult<StatementList>.Ok(var body):
                    switch (CollectConstructorFieldReadsInBody(decls, table, source, stream, facts, fields, body, diags))
                    {
                        case System.Memory.MemoryStatus.Err(var readError):
                            return System.Memory.MemoryStatus.Err(readError);
                        case System.Memory.MemoryStatus.Ok:
                    }
            }
        }

        memberStart = (u32[0 max])(memberEnd + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCopyableAssertionDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        stack mut u64[0 2 ** 63 - 1] factIndex = 0;
        if ((item.Kind == DeclarationKind.Struct || item.Kind == DeclarationKind.Record || item.Kind == DeclarationKind.Enum)
            && DeclarationHasCopyableAttribute(item, source, stream)
            && (!CopyabilityTryFindFactIndex(source, stream, facts, item.NameToken, factIndex) || !facts.IsCopyableAt(factIndex)))
        {
            switch (AppendCopyableAssertionInvalid(diags, TokenOrFallback(item.NameToken, item.KeywordToken)))
            {
                case System.Memory.MemoryStatus.Err(var copyableError):
                    return System.Memory.MemoryStatus.Err(copyableError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool FunctionIsAbiBoundary(DeclItem item, borrow TokenStream stream)
{
    return DeclarationPreludeHasToken(stream, item, TokenKind.Export)
        || DeclarationPreludeHasToken(stream, item, TokenKind.Ffi)
        || DeclarationPreludeHasToken(stream, item, TokenKind.Asm);
}

internal fn bool MemberFunctionIsAbiBoundary(
    TypedModuleSymbolVisibility memberVisibility,
    borrow TokenStream stream,
    u32[0 max] memberStart,
    u32[0 max] fnKeyword)
{
    return memberVisibility == TypedModuleSymbolVisibility.Export
        || MemberPreludeHasToken(stream, memberStart, fnKeyword, TokenKind.Ffi)
        || MemberPreludeHasToken(stream, memberStart, fnKeyword, TokenKind.Asm);
}

internal fn System.Memory.MemoryStatus CollectFunctionAbiEnumDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    borrow FunctionSignature signature,
    mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] returnStart = signature.ReturnTypeStartTokenAt();
    stack u32[0 max] returnEnd = signature.ReturnTypeEndTokenAt();
    if (returnStart < returnEnd
        && stream.KindAt((u64[0 2 ** 63 - 1])signature.ReturnTypeTokenAt()) != TokenKind.Void
        && TypeSpanDependsOnEnum(decls, table, source, stream, returnStart, returnEnd, 0))
    {
        switch (AppendAbiBoundaryEnumType(diags, returnStart))
        {
            case System.Memory.MemoryStatus.Err(var returnError):
                return System.Memory.MemoryStatus.Err(returnError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] param = 0; param < paramCount; param += 1)
    {
        stack u32[0 max] paramStart = signature.ParamTypeStartTokenAt(param);
        stack u32[0 max] paramEnd = signature.ParamTypeEndTokenAt(param);
        if (paramStart < paramEnd
            && TypeSpanDependsOnEnum(decls, table, source, stream, paramStart, paramEnd, 0))
        {
            switch (AppendAbiBoundaryEnumType(diags, paramStart))
            {
                case System.Memory.MemoryStatus.Err(var paramError):
                    return System.Memory.MemoryStatus.Err(paramError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectExportedSurfaceMemberDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner,
    TypedModuleSymbolVisibility ownerVisibility,
    u32[0 max] memberStart,
    u32[0 max] memberEnd,
    mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] cursor = LayoutSkipMemberModifiers(stream, memberStart);
    stack u32[0 max] visibilityToken = MemberVisibilityModifierToken(stream, memberStart, cursor);
    if (visibilityToken != 0
        && VisibilityRank(VisibilityFromModifierToken(stream, visibilityToken)) > VisibilityRank(ownerVisibility))
    {
        switch (AppendExportedSurfaceInvalid(diags, visibilityToken))
        {
            case System.Memory.MemoryStatus.Err(var visibilityError):
                return System.Memory.MemoryStatus.Err(visibilityError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])cursor) == TokenKind.Fn
        || stream.KindAt((u64[0 2 ** 63 - 1])cursor) == TokenKind.Finite
        || stream.KindAt((u64[0 2 ** 63 - 1])cursor) == TokenKind.Law)
    {
        stack mut FunctionSignature signature = new();
        switch (ParseFunctionSignature(stream, cursor))
        {
            case ParseResult<FunctionSignature>.Err(var signatureError):
                return System.Memory.MemoryStatus.Ok;
            case ParseResult<FunctionSignature>.Ok(var parsedSignature):
                signature = parsedSignature;
        }

        stack TypedModuleSymbolVisibility memberVisibility = MemberVisibility(ownerVisibility, stream, memberStart, cursor);
        if (MemberFunctionIsAbiBoundary(memberVisibility, stream, memberStart, cursor))
        {
            switch (CollectFunctionAbiEnumDiagnostics(decls, table, source, stream, signature, diags))
            {
                case System.Memory.MemoryStatus.Err(var abiError):
                    return System.Memory.MemoryStatus.Err(abiError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectExportedSurfaceRecordHeaderDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem item,
    TypedModuleSymbolVisibility ownerVisibility,
    mut borrow BindDiagnosticList diags)
{
    if (item.Kind != DeclarationKind.Record || item.NameToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] open = RecordHeaderOpenToken(stream, item.NameToken, item.EndToken);
    if (open == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] close = MatchingMemberCloseToken(stream, open);
    if (close <= open)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] segStart = (u32[0 max])(open + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = segStart;
    while willexit (scan <= close)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        if (depth == 0 && (kind == TokenKind.Comma || kind == TokenKind.RParen))
        {
            if (segStart < scan)
            {
                switch (CollectExportedSurfaceMemberDiagnostics(decls, table, source, stream, item, ownerVisibility, segStart, scan, diags))
                {
                    case System.Memory.MemoryStatus.Err(var headerError):
                        return System.Memory.MemoryStatus.Err(headerError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            segStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectExportedSurfaceDeclarationDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem item,
    mut borrow BindDiagnosticList diags)
{
    if (item.Kind == DeclarationKind.Function)
    {
        if (FunctionIsAbiBoundary(item, stream))
        {
            stack mut FunctionSignature signature = new();
            switch (ParseFunctionSignature(stream, item.KeywordToken))
            {
                case ParseResult<FunctionSignature>.Err(var signatureError):
                    return System.Memory.MemoryStatus.Ok;
                case ParseResult<FunctionSignature>.Ok(var parsedSignature):
                    signature = parsedSignature;
            }

            return CollectFunctionAbiEnumDiagnostics(decls, table, source, stream, signature, diags);
        }

        return System.Memory.MemoryStatus.Ok;
    }

    if (item.Kind != DeclarationKind.Struct
        && item.Kind != DeclarationKind.Record
        && item.Kind != DeclarationKind.Trait
        && item.Kind != DeclarationKind.Doctrine)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack TypedModuleSymbolVisibility ownerVisibility = DeclarationVisibility(stream, item);
    switch (CollectExportedSurfaceRecordHeaderDiagnostics(decls, table, source, stream, item, ownerVisibility, diags))
    {
        case System.Memory.MemoryStatus.Err(var headerError):
            return System.Memory.MemoryStatus.Err(headerError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut u32[0 max] open = item.KeywordToken;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.EndOfFile
        && stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.LBrace)
    {
        open = (u32[0 max])(open + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.LBrace)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] scan = (u32[0 max])(open + 1);
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])scan) != TokenKind.EndOfFile)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.RBrace)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u32[0 max] memberStart = scan;
        stack u32[0 max] memberEnd = LayoutSkipDeclarationBody(stream, memberStart);
        switch (CollectExportedSurfaceMemberDiagnostics(decls, table, source, stream, item, ownerVisibility, memberStart, memberEnd, diags))
        {
            case System.Memory.MemoryStatus.Err(var memberError):
                return System.Memory.MemoryStatus.Err(memberError);
            case System.Memory.MemoryStatus.Ok:
        }

        scan = (u32[0 max])(memberEnd + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectExportedSurfaceDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (CollectExportedSurfaceDeclarationDiagnostics(decls, table, source, stream, decls.ItemAt(index), diags))
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal finite law u32[0 max] LayoutEffectiveFieldAlignment(u32[0 max] naturalAlign, u32[0 max] packBytes)
{
    if (packBytes != 0 && packBytes < naturalAlign)
    {
        return packBytes;
    }

    return naturalAlign;
}

internal fn LayoutTypeInfo LayoutSystemCAliasTypeInfo(ascii source, borrow TokenStream stream, u32[0 max] headToken)
{
    if (TokenTextEquals(source, stream, headToken, "c_char")
        || TokenTextEquals(source, stream, headToken, "c_schar")
        || TokenTextEquals(source, stream, headToken, "c_uchar"))
    {
        return KnownLayoutTypeInfo(1, 1);
    }

    if (TokenTextEquals(source, stream, headToken, "c_short")
        || TokenTextEquals(source, stream, headToken, "c_ushort"))
    {
        return KnownLayoutTypeInfo(2, 2);
    }

    if (TokenTextEquals(source, stream, headToken, "c_int")
        || TokenTextEquals(source, stream, headToken, "c_uint"))
    {
        return KnownLayoutTypeInfo(4, 4);
    }

    if (TokenTextEquals(source, stream, headToken, "c_long")
        || TokenTextEquals(source, stream, headToken, "c_ulong")
        || TokenTextEquals(source, stream, headToken, "c_longlong")
        || TokenTextEquals(source, stream, headToken, "c_ulonglong")
        || TokenTextEquals(source, stream, headToken, "c_size_t")
        || TokenTextEquals(source, stream, headToken, "c_ptrdiff_t"))
    {
        return KnownLayoutTypeInfo(8, 8);
    }

    return UnknownLayoutTypeInfo();
}

internal fn LayoutTypeInfo LayoutScalarTypeInfo(ascii source, borrow TokenStream stream, u32[0 max] typeHead, u32[0 max] typePrimary)
{
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])typePrimary);
    if (kind == TokenKind.Bool)
    {
        return KnownLayoutTypeInfo(1, 1);
    }

    if (kind == TokenKind.Rawptr || kind == TokenKind.Rawmutptr || kind == TokenKind.Fnptr)
    {
        return KnownLayoutTypeInfo(8, 8);
    }

    if (kind == TokenKind.FloatType)
    {
        if (TokenTextEquals(source, stream, typePrimary, "f32"))
        {
            return KnownLayoutTypeInfo(4, 4);
        }

        if (TokenTextEquals(source, stream, typePrimary, "f64"))
        {
            return KnownLayoutTypeInfo(8, 8);
        }
    }

    if (kind == TokenKind.IntegerType)
    {
        if (TokenTextEquals(source, stream, typePrimary, "i8") || TokenTextEquals(source, stream, typePrimary, "u8"))
        {
            return KnownLayoutTypeInfo(1, 1);
        }

        if (TokenTextEquals(source, stream, typePrimary, "i16") || TokenTextEquals(source, stream, typePrimary, "u16"))
        {
            return KnownLayoutTypeInfo(2, 2);
        }

        if (TokenTextEquals(source, stream, typePrimary, "i32") || TokenTextEquals(source, stream, typePrimary, "u32"))
        {
            return KnownLayoutTypeInfo(4, 4);
        }

        if (TokenTextEquals(source, stream, typePrimary, "i64") || TokenTextEquals(source, stream, typePrimary, "u64"))
        {
            return KnownLayoutTypeInfo(8, 8);
        }
    }

    if (LayoutNameIsSystemCAlias(source, stream, typeHead))
    {
        return LayoutSystemCAliasTypeInfo(source, stream, typeHead);
    }

    return UnknownLayoutTypeInfo();
}

internal fn bool LayoutTypeSpanFixedArrayMultiplier(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    out u32[0 max] multiplier)
{
    multiplier = 1;
    stack mut u64[0 max] rawMultiplier = 1;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    stack mut bool consumedIntegerRange = false;
    stack mut TokenKind previousTopLevel = TokenKind.EndOfFile;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.LBrack)
        {
            stack u32[0 max] close = LayoutMatchingCloseToken(stream, scan);
            if (close <= scan || close >= endExclusive)
            {
                return false;
            }

            if (stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.RBrack)
            {
                return false;
            }

            if (previousTopLevel == TokenKind.IntegerType && !consumedIntegerRange)
            {
                consumedIntegerRange = true;
            }
            else
            {
                stack mut u64[0 max] extent = 0;
                if ((u32[0 max])(scan + 2) != close
                    || !LayoutTryParseU64Literal(source, stream, (u32[0 max])(scan + 1), extent))
                {
                    return false;
                }

                if (extent > (u64[0 max])4294967295)
                {
                    return false;
                }

                if (extent == 0)
                {
                    rawMultiplier = 0;
                }
                else if (rawMultiplier > (u64[0 max])4294967295 / extent)
                {
                    return false;
                }
                else
                {
                    rawMultiplier = rawMultiplier * extent;
                }
            }

            scan = close;
        }
        else
        {
            if (kind == TokenKind.LParen || kind == TokenKind.LBrack
                || kind == TokenKind.LBrace || kind == TokenKind.Lt)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
                || kind == TokenKind.RBrace || kind == TokenKind.Gt)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
        }

        if (depth == 0 && kind != TokenKind.LBrack && kind != TokenKind.RBrack)
        {
            previousTopLevel = kind;
        }

        scan = (u32[0 max])(scan + 1);
    }

    multiplier = (u32[0 max])rawMultiplier;
    return true;
}

internal finite law LayoutTypeInfo LayoutApplyArrayMultiplier(LayoutTypeInfo elementInfo, u32[0 max] multiplier)
{
    if (!elementInfo.Known)
    {
        return elementInfo;
    }

    if (multiplier == 1)
    {
        return elementInfo;
    }

    if (multiplier != 0 && elementInfo.SizeBytes > (u32[0 max])4294967295 / multiplier)
    {
        return UnknownLayoutTypeInfo();
    }

    return KnownLayoutTypeInfo((u32[0 max])(elementInfo.SizeBytes * multiplier), elementInfo.AlignBytes);
}

internal fn bool LayoutTryReadFieldOffset(
    DeclItem item,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] fieldNameToken,
    out u32[0 max] offsetBytes)
{
    offsetBytes = 0;
    stack mut u32[0 max] index = item.KeywordToken;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile
        && stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        index = (u32[0 max])(index + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        return false;
    }

    index = (u32[0 max])(index + 1);
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])index) == TokenKind.RBrace)
        {
            return false;
        }

        stack u32[0 max] memberStart = index;
        stack u32[0 max] memberEnd = LayoutSkipDeclarationBody(stream, memberStart);
        stack u32[0 max] cursor = LayoutSkipMemberModifiers(stream, memberStart);
        if (stream.KindAt((u64[0 2 ** 63 - 1])memberEnd) == TokenKind.Semi
            && !LayoutTokenStartsMemberDeclaration(stream.KindAt((u64[0 2 ** 63 - 1])cursor)))
        {
            stack u32[0 max] nameToken = LayoutBoundedLastIdentifier(stream, cursor, memberEnd);
            if (TokenTextEqualsToken(source, stream, nameToken, fieldNameToken))
            {
                stack mut u32[0 max] scan = memberStart;
                while willexit (scan < cursor && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
                {
                    stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
                    if (attrEnd <= scan)
                    {
                        return false;
                    }

                    stack u32[0 max] argToken = LayoutAttributeArgumentToken(source, stream, scan, attrEnd, "FieldOffset");
                    if (LayoutTryParseU32Literal(source, stream, argToken, offsetBytes))
                    {
                        return true;
                    }

                    scan = (u32[0 max])(attrEnd + 1);
                }

                return false;
            }
        }

        index = (u32[0 max])(memberEnd + 1);
    }

    return false;
}

internal fn LayoutTypeInfo LayoutTypeInfoForSpan(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    u32[0 max] typeHead,
    u32[0 max] typePrimary,
    u32[0 max] depth)
{
    if (depth > 32)
    {
        return UnknownLayoutTypeInfo();
    }

    stack mut u32[0 max] multiplier = 1;
    if (!LayoutTypeSpanFixedArrayMultiplier(source, stream, typeStart, typeEnd, multiplier))
    {
        return UnknownLayoutTypeInfo();
    }

    stack LayoutTypeInfo scalar = LayoutScalarTypeInfo(source, stream, typeHead, typePrimary);
    if (scalar.Known)
    {
        return LayoutApplyArrayMultiplier(scalar, multiplier);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])typePrimary) == TokenKind.Identifier
        && typeHead != 0
        && !LayoutTypeSpanHasTopLevelGenericArguments(stream, typeHead, typeEnd))
    {
        stack mut DeclItem item = new();
        if (LayoutTryReadDataDeclarationItem(decls, table, source, stream, typeHead, item))
        {
            stack LayoutTypeInfo aggregate = LayoutControlledAggregateInfo(decls, table, source, stream, item, (u32[0 max])(depth + 1));
            return LayoutApplyArrayMultiplier(aggregate, multiplier);
        }
    }

    return UnknownLayoutTypeInfo();
}

internal fn LayoutTypeInfo LayoutControlledAggregateInfo(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem item,
    u32[0 max] depth)
{
    if (depth > 32)
    {
        return UnknownLayoutTypeInfo();
    }

    stack LayoutControlKind layoutKind = LayoutDeclarationLayoutKind(item, source, stream);
    stack mut FieldList fields = new();
    switch (ParseStructFields(stream, item.KeywordToken))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return UnknownLayoutTypeInfo();
        case ParseResult<FieldList>.Ok(var parsed):
            fields = parsed;
    }

    stack mut u32[0 max] sizeBytes = 0;
    stack mut u32[0 max] maxAlign = 1;
    if (layoutKind == LayoutControlKind.Auto || layoutKind == LayoutControlKind.C)
    {
        stack mut u32[0 max] packBytes = 0;
        if (layoutKind == LayoutControlKind.C)
        {
            packBytes = LayoutDeclarationAttributeU32Value(item, source, stream, "Pack");
        }

        stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < fieldCount; field += 1)
        {
            stack LayoutTypeInfo fieldInfo = LayoutTypeInfoForSpan(
                decls,
                table,
                source,
                stream,
                fields.TypeStartAt(field),
                fields.TypeEndAt(field),
                fields.TypeHeadAt(field),
                fields.TypePrimaryAt(field),
                (u32[0 max])(depth + 1));
            if (!fieldInfo.Known)
            {
                return UnknownLayoutTypeInfo();
            }

            stack u32[0 max] effectiveAlign = LayoutEffectiveFieldAlignment(fieldInfo.AlignBytes, packBytes);
            sizeBytes = AlignUp(sizeBytes, effectiveAlign);
            if (effectiveAlign > maxAlign)
            {
                maxAlign = effectiveAlign;
            }

            if (fieldInfo.SizeBytes > (u32[0 max])4294967295 - sizeBytes)
            {
                return UnknownLayoutTypeInfo();
            }

            sizeBytes = (u32[0 max])(sizeBytes + fieldInfo.SizeBytes);
        }
    }
    else if (layoutKind == LayoutControlKind.Explicit)
    {
        stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < fieldCount; field += 1)
        {
            stack LayoutTypeInfo fieldInfo = LayoutTypeInfoForSpan(
                decls,
                table,
                source,
                stream,
                fields.TypeStartAt(field),
                fields.TypeEndAt(field),
                fields.TypeHeadAt(field),
                fields.TypePrimaryAt(field),
                (u32[0 max])(depth + 1));
            stack mut u32[0 max] fieldOffset = 0;
            if (!fieldInfo.Known
                || !LayoutTryReadFieldOffset(item, source, stream, fields.NameTokenAt(field), fieldOffset)
                || fieldInfo.SizeBytes > (u32[0 max])4294967295 - fieldOffset)
            {
                return UnknownLayoutTypeInfo();
            }

            stack u32[0 max] fieldEnd = (u32[0 max])(fieldOffset + fieldInfo.SizeBytes);
            if (fieldEnd > sizeBytes)
            {
                sizeBytes = fieldEnd;
            }

            if (fieldInfo.AlignBytes > maxAlign)
            {
                maxAlign = fieldInfo.AlignBytes;
            }
        }
    }

    stack u32[0 max] alignBytes = LayoutDeclarationAttributeU32Value(item, source, stream, "Align");
    if (alignBytes > maxAlign)
    {
        maxAlign = alignBytes;
    }

    return KnownLayoutTypeInfo(AlignUp(sizeBytes, maxAlign), maxAlign);
}

internal enum LayoutStructuralFactKind
{
    None,
    TypeLayout,
    FieldLayout,
    EnumTagLayout,
    EnumVariantLayout,
    EnumPayloadLayout,
}

internal fn LayoutStructuralFactKind LayoutStructuralFactKindAt(ascii source, borrow TokenStream stream, u32[0 max] factToken)
{
    if (TokenTextEquals(source, stream, factToken, "TypeSize")
        || TokenTextEquals(source, stream, factToken, "TypeAlign")
        || TokenTextEquals(source, stream, factToken, "TypeIsZeroSized"))
    {
        return LayoutStructuralFactKind.TypeLayout;
    }

    if (TokenTextEquals(source, stream, factToken, "FieldOffset")
        || TokenTextEquals(source, stream, factToken, "FieldSize")
        || TokenTextEquals(source, stream, factToken, "FieldAlign")
        || TokenTextEquals(source, stream, factToken, "FieldIsMisaligned"))
    {
        return LayoutStructuralFactKind.FieldLayout;
    }

    if (TokenTextEquals(source, stream, factToken, "EnumTagOffset")
        || TokenTextEquals(source, stream, factToken, "EnumTagSize")
        || TokenTextEquals(source, stream, factToken, "EnumTagAlign")
        || TokenTextEquals(source, stream, factToken, "EnumTagIsMisaligned"))
    {
        return LayoutStructuralFactKind.EnumTagLayout;
    }

    if (TokenTextEquals(source, stream, factToken, "EnumVariantTag")
        || TokenTextEquals(source, stream, factToken, "EnumVariantPayloadCount"))
    {
        return LayoutStructuralFactKind.EnumVariantLayout;
    }

    if (TokenTextEquals(source, stream, factToken, "EnumVariantPayloadOffset")
        || TokenTextEquals(source, stream, factToken, "EnumVariantPayloadSize")
        || TokenTextEquals(source, stream, factToken, "EnumVariantPayloadAlign")
        || TokenTextEquals(source, stream, factToken, "EnumVariantPayloadIsMisaligned"))
    {
        return LayoutStructuralFactKind.EnumPayloadLayout;
    }

    return LayoutStructuralFactKind.None;
}

internal fn bool LayoutStructuralFactHasSystemCompilerPrefix(ascii source, borrow TokenStream stream, u32[0 max] factToken)
{
    if (factToken < 4)
    {
        return false;
    }

    return stream.KindAt((u64[0 2 ** 63 - 1])(factToken - 1)) == TokenKind.Dot
        && stream.KindAt((u64[0 2 ** 63 - 1])(factToken - 3)) == TokenKind.Dot
        && TokenTextEquals(source, stream, (u32[0 max])(factToken - 2), "Compiler")
        && TokenTextEquals(source, stream, (u32[0 max])(factToken - 4), "System");
}

internal fn bool LayoutTryStructuralFactGenericSegment(borrow TokenStream stream, u32[0 max] factToken, out u32[0 max] genericOpen, out u32[0 max] genericClose)
{
    genericOpen = 0;
    genericClose = 0;
    stack u32[0 max] open = (u32[0 max])(factToken + 1);
    if (stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.Lt)
    {
        return false;
    }

    stack u32[0 max] close = LayoutMatchingCloseToken(stream, open);
    if (close <= open
        || stream.KindAt((u64[0 2 ** 63 - 1])(close + 1)) != TokenKind.LParen)
    {
        return false;
    }

    genericOpen = open;
    genericClose = close;
    return true;
}

internal fn bool LayoutFactArgumentSegment(
    borrow TokenStream stream,
    u32[0 max] genericOpen,
    u32[0 max] genericClose,
    u32[0 max] requestedIndex,
    out u32[0 max] startToken,
    out u32[0 max] endToken)
{
    startToken = 0;
    endToken = 0;
    if (genericClose <= genericOpen)
    {
        return false;
    }

    stack mut u32[0 max] argumentIndex = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(genericOpen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = segmentStart;
    while willexit (scan <= genericClose)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (scan == genericClose || (depth == 0 && kind == TokenKind.Comma))
        {
            if (argumentIndex == requestedIndex)
            {
                startToken = segmentStart;
                endToken = scan;
                return segmentStart < scan;
            }

            argumentIndex = (u32[0 max])(argumentIndex + 1);
            segmentStart = (u32[0 max])(scan + 1);
        }
        else if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool LayoutTypeSpanHasTopLevelDot(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && kind == TokenKind.Dot)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool LayoutTryReadLocalFactTargetDeclaration(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    out DeclItem item,
    out DeclarationKind declarationKind)
{
    item = new();
    declarationKind = DeclarationKind.Unknown;
    if (typeStart >= typeEnd || LayoutTypeSpanHasTopLevelDot(stream, typeStart, typeEnd))
    {
        return false;
    }

    stack u32[0 max] typeHead = LayoutBoundedLastIdentifier(stream, typeStart, typeEnd);
    if (typeHead == 0)
    {
        return false;
    }

    return LayoutTryReadDeclarationItem(decls, table, source, stream, typeHead, item, declarationKind);
}

internal fn bool LayoutTryParseFactIndexArgument(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] startToken,
    u32[0 max] endToken,
    out u32[0 max] indexValue)
{
    indexValue = 0;
    if (startToken >= endToken)
    {
        return false;
    }

    stack mut u32[0 max] token = startToken;
    if (stream.KindAt((u64[0 2 ** 63 - 1])token) == TokenKind.Comptime)
    {
        token = (u32[0 max])(token + 1);
    }

    if (token < endToken && stream.KindAt((u64[0 2 ** 63 - 1])token) == TokenKind.Plus)
    {
        token = (u32[0 max])(token + 1);
    }

    return (u32[0 max])(token + 1) == endToken
        && LayoutTryParseU32Literal(source, stream, token, indexValue);
}

internal fn bool LayoutFactIndexArgumentIsNegativeLiteral(borrow TokenStream stream, u32[0 max] startToken, u32[0 max] endToken)
{
    if (startToken >= endToken)
    {
        return false;
    }

    stack mut u32[0 max] token = startToken;
    if (stream.KindAt((u64[0 2 ** 63 - 1])token) == TokenKind.Comptime)
    {
        token = (u32[0 max])(token + 1);
    }

    return (u32[0 max])(token + 2) == endToken
        && stream.KindAt((u64[0 2 ** 63 - 1])token) == TokenKind.Minus
        && stream.KindAt((u64[0 2 ** 63 - 1])(token + 1)) == TokenKind.IntegerLiteral;
}

internal fn bool LayoutTryFieldCount(DeclItem item, borrow TokenStream stream, out u32[0 max] fieldCount)
{
    fieldCount = 0;
    stack mut FieldList fields = new();
    switch (ParseStructFields(stream, item.KeywordToken))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return false;
        case ParseResult<FieldList>.Ok(var parsed):
            fields = parsed;
    }

    stack u64[0 2 ** 63 - 1] count = fields.Count();
    if (count > (u64[0 2 ** 63 - 1])4294967295)
    {
        return false;
    }

    fieldCount = (u32[0 max])count;
    return true;
}

internal fn bool LayoutTryEnumVariantCount(DeclItem item, borrow TokenStream stream, out u32[0 max] variantCount)
{
    variantCount = 0;
    stack mut VariantList variants = new();
    switch (ParseEnumVariants(stream, item.KeywordToken))
    {
        case ParseResult<VariantList>.Err(var variantsError):
            return false;
        case ParseResult<VariantList>.Ok(var parsed):
            variants = parsed;
    }

    stack u64[0 2 ** 63 - 1] count = variants.Count();
    if (count > (u64[0 2 ** 63 - 1])4294967295)
    {
        return false;
    }

    variantCount = (u32[0 max])count;
    return true;
}

internal fn bool LayoutTryEnumVariantPayloadCount(
    DeclItem item,
    borrow TokenStream stream,
    u32[0 max] requestedVariantIndex,
    out u32[0 max] payloadCount)
{
    payloadCount = 0;
    stack u32[0 max] bodyOpen = ReceiverBodyOpenToken(stream, item.NameToken);
    if (bodyOpen == 0)
    {
        return false;
    }

    stack mut u32[0 max] variantStart = (u32[0 max])(bodyOpen + 1);
    stack mut u32[0 max] variantIndex = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        while willexit (stream.KindAt((u64[0 2 ** 63 - 1])variantStart) == TokenKind.Comma)
        {
            variantStart = (u32[0 max])(variantStart + 1);
        }

        stack TokenKind startKind = stream.KindAt((u64[0 2 ** 63 - 1])variantStart);
        if (startKind == TokenKind.EndOfFile || startKind == TokenKind.RBrace)
        {
            return false;
        }

        stack mut u32[0 max] scan = variantStart;
        stack mut u32[0 max] depth = 0;
        stack mut u32[0 max] nameToken = 0;
        stack mut u32[0 max] delimiter = 0;
        stack mut bool reachedBodyEnd = false;
        while willexit (guard > 0)
        {
            guard = (u64[0 2 ** 63 - 1])(guard - 1);
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.EndOfFile)
            {
                delimiter = scan;
                reachedBodyEnd = true;
                break;
            }

            if (depth == 0 && (kind == TokenKind.Comma || kind == TokenKind.RBrace))
            {
                delimiter = scan;
                reachedBodyEnd = kind == TokenKind.RBrace;
                break;
            }

            if (kind == TokenKind.Identifier && depth == 0 && nameToken == 0)
            {
                nameToken = scan;
            }

            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }

            scan = (u32[0 max])(scan + 1);
        }

        if (delimiter == 0)
        {
            delimiter = scan;
        }

        if (nameToken != 0)
        {
            if (variantIndex == requestedVariantIndex)
            {
                payloadCount = EnumVariantPayloadCount(stream, nameToken, delimiter);
                return true;
            }

            variantIndex = (u32[0 max])(variantIndex + 1);
        }

        if (reachedBodyEnd)
        {
            return false;
        }

        variantStart = (u32[0 max])(delimiter + 1);
    }

    return false;
}

internal fn System.Memory.MemoryStatus AppendLayoutQueryInvalid(mut borrow BindDiagnosticList diags, u32[0 max] token)
{
    switch (diags.Append(BindDiagnosticCode.LayoutQueryInvalid, token))
    {
        case System.Memory.MemoryStatus.Err(var error):
            return System.Memory.MemoryStatus.Err(error);
        case System.Memory.MemoryStatus.Ok:
            return System.Memory.MemoryStatus.Ok;
    }
}

internal fn System.Memory.MemoryStatus ValidateLayoutStructuralFactCall(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] factToken,
    LayoutStructuralFactKind factKind,
    u32[0 max] genericOpen,
    u32[0 max] genericClose,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] typeStart = 0;
    stack mut u32[0 max] typeEnd = 0;
    if (!LayoutFactArgumentSegment(stream, genericOpen, genericClose, 0, typeStart, typeEnd)
        || GenericArgumentSegmentIsValue(stream, typeStart, typeEnd))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut DeclItem targetItem = new();
    stack mut DeclarationKind targetKind = DeclarationKind.Unknown;
    if (!LayoutTryReadLocalFactTargetDeclaration(decls, table, source, stream, typeStart, typeEnd, targetItem, targetKind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    if (factKind == LayoutStructuralFactKind.TypeLayout)
    {
        if (targetKind != DeclarationKind.Struct
            && targetKind != DeclarationKind.Record
            && targetKind != DeclarationKind.Enum)
        {
            return AppendLayoutQueryInvalid(diags, factToken);
        }

        return System.Memory.MemoryStatus.Ok;
    }

    if (factKind == LayoutStructuralFactKind.FieldLayout)
    {
        if (targetKind != DeclarationKind.Struct && targetKind != DeclarationKind.Record)
        {
            return AppendLayoutQueryInvalid(diags, factToken);
        }

        stack mut u32[0 max] indexStart = 0;
        stack mut u32[0 max] indexEnd = 0;
        if (!LayoutFactArgumentSegment(stream, genericOpen, genericClose, 1, indexStart, indexEnd))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack mut u32[0 max] fieldCount = 0;
        if (!LayoutTryFieldCount(targetItem, stream, fieldCount))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (LayoutFactIndexArgumentIsNegativeLiteral(stream, indexStart, indexEnd))
        {
            return AppendLayoutQueryInvalid(diags, factToken);
        }

        stack mut u32[0 max] indexValue = 0;
        if (LayoutTryParseFactIndexArgument(source, stream, indexStart, indexEnd, indexValue)
            && indexValue >= fieldCount)
        {
            return AppendLayoutQueryInvalid(diags, factToken);
        }
    }

    if (factKind == LayoutStructuralFactKind.EnumTagLayout
        || factKind == LayoutStructuralFactKind.EnumVariantLayout
        || factKind == LayoutStructuralFactKind.EnumPayloadLayout)
    {
        if (targetKind != DeclarationKind.Enum)
        {
            return AppendLayoutQueryInvalid(diags, factToken);
        }

        if (factKind == LayoutStructuralFactKind.EnumTagLayout)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack mut u32[0 max] variantStart = 0;
        stack mut u32[0 max] variantEnd = 0;
        if (!LayoutFactArgumentSegment(stream, genericOpen, genericClose, 1, variantStart, variantEnd))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (LayoutFactIndexArgumentIsNegativeLiteral(stream, variantStart, variantEnd))
        {
            return AppendLayoutQueryInvalid(diags, factToken);
        }

        stack mut u32[0 max] variantCount = 0;
        if (!LayoutTryEnumVariantCount(targetItem, stream, variantCount))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack mut bool variantIndexIsConcrete = false;
        stack mut bool variantIndexInRange = false;
        stack mut u32[0 max] variantIndex = 0;
        if (LayoutTryParseFactIndexArgument(source, stream, variantStart, variantEnd, variantIndex))
        {
            variantIndexIsConcrete = true;
            variantIndexInRange = variantIndex < variantCount;
            if (!variantIndexInRange)
            {
                return AppendLayoutQueryInvalid(diags, factToken);
            }
        }

        if (factKind == LayoutStructuralFactKind.EnumPayloadLayout)
        {
            stack mut u32[0 max] payloadStart = 0;
            stack mut u32[0 max] payloadEnd = 0;
            if (!LayoutFactArgumentSegment(stream, genericOpen, genericClose, 2, payloadStart, payloadEnd))
            {
                return System.Memory.MemoryStatus.Ok;
            }

            if (LayoutFactIndexArgumentIsNegativeLiteral(stream, payloadStart, payloadEnd))
            {
                return AppendLayoutQueryInvalid(diags, factToken);
            }

            stack mut u32[0 max] payloadIndex = 0;
            if (variantIndexIsConcrete
                && variantIndexInRange
                && LayoutTryParseFactIndexArgument(source, stream, payloadStart, payloadEnd, payloadIndex))
            {
                stack mut u32[0 max] payloadCount = 0;
                if (LayoutTryEnumVariantPayloadCount(targetItem, stream, variantIndex, payloadCount)
                    && payloadIndex >= payloadCount)
                {
                    return AppendLayoutQueryInvalid(diags, factToken);
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal finite law u32[0 max] LayoutFunctionBodyOpenToken(borrow TokenStream stream, u32[0 max] fnKeyword)
{
    stack mut u32[0 max] scan = fnKeyword;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])scan) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.LBrace)
        {
            return scan;
        }

        if (kind == TokenKind.Semi)
        {
            return 0;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn System.Memory.MemoryStatus CollectConcreteLayoutQueryDiagnostics(
    u32[0 max] fnKeyword,
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] bodyOpen = LayoutFunctionBodyOpenToken(stream, fnKeyword);
    if (bodyOpen == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyEnd = LayoutSkipDeclarationBody(stream, fnKeyword);
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < bodyEnd)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Identifier)
        {
            stack LayoutStructuralFactKind factKind = LayoutStructuralFactKindAt(source, stream, scan);
            if (factKind != LayoutStructuralFactKind.None
                && LayoutStructuralFactHasSystemCompilerPrefix(source, stream, scan))
            {
                stack mut u32[0 max] genericOpen = 0;
                stack mut u32[0 max] genericClose = 0;
                if (LayoutTryStructuralFactGenericSegment(stream, scan, genericOpen, genericClose))
                {
                    switch (ValidateLayoutStructuralFactCall(decls, table, source, stream, scan, factKind, genericOpen, genericClose, diags))
                    {
                        case System.Memory.MemoryStatus.Err(var validateError):
                            return System.Memory.MemoryStatus.Err(validateError);
                        case System.Memory.MemoryStatus.Ok:
                    }

                    scan = genericClose;
                }
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool LayoutFieldIsMisaligned(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] structNameToken,
    u32[0 max] fieldNameToken)
{
    stack mut DeclItem item = new();
    if (!LayoutTryReadDataDeclarationItem(decls, table, source, stream, structNameToken, item))
    {
        return false;
    }

    stack LayoutControlKind layoutKind = LayoutDeclarationLayoutKind(item, source, stream);
    if (layoutKind == LayoutControlKind.Auto)
    {
        return false;
    }

    stack mut FieldList fields = new();
    switch (ParseStructFields(stream, item.KeywordToken))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return false;
        case ParseResult<FieldList>.Ok(var parsed):
            fields = parsed;
    }

    stack mut u32[0 max] offset = 0;
    stack u32[0 max] packBytes = LayoutDeclarationAttributeU32Value(item, source, stream, "Pack");
    stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < fieldCount; field += 1)
    {
        stack LayoutTypeInfo fieldInfo = LayoutTypeInfoForSpan(
            decls,
            table,
            source,
            stream,
            fields.TypeStartAt(field),
            fields.TypeEndAt(field),
            fields.TypeHeadAt(field),
            fields.TypePrimaryAt(field),
            0);
        if (!fieldInfo.Known)
        {
            return false;
        }

        if (layoutKind == LayoutControlKind.C)
        {
            offset = AlignUp(offset, LayoutEffectiveFieldAlignment(fieldInfo.AlignBytes, packBytes));
        }
        else if (!LayoutTryReadFieldOffset(item, source, stream, fields.NameTokenAt(field), offset))
        {
            return false;
        }

        if (TokenTextEqualsToken(source, stream, fields.NameTokenAt(field), fieldNameToken))
        {
            return fieldInfo.AlignBytes > 1 && offset % fieldInfo.AlignBytes != 0;
        }

        if (layoutKind == LayoutControlKind.C)
        {
            if (fieldInfo.SizeBytes > (u32[0 max])4294967295 - offset)
            {
                return false;
            }

            offset = (u32[0 max])(offset + fieldInfo.SizeBytes);
        }
    }

    return false;
}

internal fn bool ExpressionHasMisalignedLayoutFieldProjection(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] node)
{
    stack mut u32[0 max] current = node;
    while willexit (current != 0)
    {
        stack ExprKind kind = body.ExprKindAt(current);
        if (kind == Compiler.Parsing.ExprKind.Member)
        {
            stack u32[0 max] receiver = body.ExprLeftAt(current);
            stack u32[0 max] receiverStruct = MemberStructNameToken(table, source, refs, scope, stream, body, receiver);
            if (LayoutFieldIsMisaligned(decls, table, source, stream, receiverStruct, body.ExprTokenAt(current)))
            {
                return true;
            }

            current = receiver;
        }
        else if (kind == Compiler.Parsing.ExprKind.Index)
        {
            current = body.ExprLeftAt(current);
        }
        else
        {
            return false;
        }
    }

    return false;
}

internal fn System.Memory.MemoryStatus CollectLayoutControlFieldDiagnostics(
    borrow DeclarationList decls,
    DeclItem item,
    LayoutControlKind layoutKind,
    ascii source,
    borrow TokenStream stream,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] index = item.KeywordToken;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile
        && stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        index = (u32[0 max])(index + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    index = (u32[0 max])(index + 1);
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])index) == TokenKind.RBrace)
        {
            break;
        }

        stack u32[0 max] memberStart = index;
        stack u32[0 max] memberEnd = LayoutSkipDeclarationBody(stream, memberStart);
        stack u32[0 max] cursor = LayoutSkipMemberModifiers(stream, memberStart);
        if (stream.KindAt((u64[0 2 ** 63 - 1])memberEnd) == TokenKind.Semi
            && !LayoutTokenStartsMemberDeclaration(stream.KindAt((u64[0 2 ** 63 - 1])cursor)))
        {
            stack u32[0 max] nameToken = LayoutBoundedLastIdentifier(stream, cursor, memberEnd);
            if (nameToken != 0)
            {
                stack u32[0 max] typeHead = LayoutBoundedLastIdentifier(stream, cursor, nameToken);
                stack u32[0 max] typePrimary = LayoutBoundedFirstTypeStart(stream, cursor, nameToken);
                stack mut u32[0 max] fieldOffsetCount = 0;
                stack mut u32[0 max] fieldOffsetToken = 0;
                stack mut u32[0 max] scan = memberStart;
                while willexit (scan < cursor && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
                {
                    stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
                    if (attrEnd <= scan)
                    {
                        break;
                    }

                    stack u32[0 max] offsetHere = LayoutAttributeNameCount(source, stream, scan, attrEnd, "FieldOffset");
                    if (offsetHere > 0)
                    {
                        fieldOffsetCount = (u32[0 max])(fieldOffsetCount + offsetHere);
                        fieldOffsetToken = LayoutAttributeNameToken(source, stream, scan, attrEnd, "FieldOffset");
                        if (fieldOffsetCount > 1)
                        {
                            switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, fieldOffsetToken))
                            {
                                case System.Memory.MemoryStatus.Err(var duplicateOffsetError):
                                    return System.Memory.MemoryStatus.Err(duplicateOffsetError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }

                        if (!LayoutAttributeHasNonNegativeIntegerLiteral(source, stream, LayoutAttributeArgumentToken(source, stream, scan, attrEnd, "FieldOffset")))
                        {
                            switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, fieldOffsetToken))
                            {
                                case System.Memory.MemoryStatus.Err(var invalidOffsetError):
                                    return System.Memory.MemoryStatus.Err(invalidOffsetError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }

                    scan = (u32[0 max])(attrEnd + 1);
                }

                if (layoutKind == LayoutControlKind.Explicit && fieldOffsetCount == 0)
                {
                    switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, nameToken))
                    {
                        case System.Memory.MemoryStatus.Err(var missingOffsetError):
                            return System.Memory.MemoryStatus.Err(missingOffsetError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
                else if (layoutKind != LayoutControlKind.Explicit && fieldOffsetCount > 0)
                {
                    switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, fieldOffsetToken))
                    {
                        case System.Memory.MemoryStatus.Err(var misplacedOffsetError):
                            return System.Memory.MemoryStatus.Err(misplacedOffsetError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                if (fieldOffsetCount > 0 && LayoutFieldDeclaratorCount(stream, cursor, memberEnd) != 1)
                {
                    switch (diags.Append(BindDiagnosticCode.LayoutControlInvalid, fieldOffsetToken))
                    {
                        case System.Memory.MemoryStatus.Err(var multiOffsetError):
                            return System.Memory.MemoryStatus.Err(multiOffsetError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                if (layoutKind != LayoutControlKind.Auto
                    && typePrimary != 0
                    && !LayoutTypeSpanIsFfiSafe(decls, source, stream, cursor, nameToken, typeHead, typePrimary))
                {
                    switch (diags.Append(BindDiagnosticCode.FfiLayoutUnsafeField, typePrimary))
                    {
                        case System.Memory.MemoryStatus.Err(var unsafeFieldError):
                            return System.Memory.MemoryStatus.Err(unsafeFieldError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }

        index = (u32[0 max])(memberEnd + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectLayoutControlDiagnostics(
    borrow DeclarationList decls,
    ascii source,
    borrow TokenStream stream,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (item.Kind == DeclarationKind.Struct || item.Kind == DeclarationKind.Record)
        {
            stack mut LayoutControlKind layoutKind = LayoutControlKind.Auto;
            switch (CollectLayoutDeclarationAttributeDiagnostics(item, source, stream, diags, layoutKind))
            {
                case System.Memory.MemoryStatus.Err(var attributeError):
                    return System.Memory.MemoryStatus.Err(attributeError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (CollectLayoutControlFieldDiagnostics(decls, item, layoutKind, source, stream, diags))
            {
                case System.Memory.MemoryStatus.Err(var fieldError):
                    return System.Memory.MemoryStatus.Err(fieldError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal struct InlineLayoutSubstitutionTable
{
    internal dynamic u32[0 max] ParamOwnerKeywords;
    internal dynamic u32[0 max] ParamNameTokens;
    internal dynamic u32[0 max] ArgOwnerKeywords;
    internal dynamic u32[0 max] ArgStartTokens;
    internal dynamic u32[0 max] ArgEndTokens;

    InlineLayoutSubstitutionTable()
    {
        self.ParamOwnerKeywords = new();
        self.ParamNameTokens = new();
        self.ArgOwnerKeywords = new();
        self.ArgStartTokens = new();
        self.ArgEndTokens = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow InlineLayoutSubstitutionTable self)
    {
        return self.ParamNameTokens.Length;
    }

    internal law u32[0 max] ParamOwnerKeywordAt(borrow InlineLayoutSubstitutionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ParamOwnerKeywords.Length)
        {
            token = self.ParamOwnerKeywords[index];
        }

        return token;
    }

    internal law u32[0 max] ParamNameTokenAt(borrow InlineLayoutSubstitutionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ParamNameTokens.Length)
        {
            token = self.ParamNameTokens[index];
        }

        return token;
    }

    internal law u32[0 max] ArgOwnerKeywordAt(borrow InlineLayoutSubstitutionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ArgOwnerKeywords.Length)
        {
            token = self.ArgOwnerKeywords[index];
        }

        return token;
    }

    internal law u32[0 max] ArgStartTokenAt(borrow InlineLayoutSubstitutionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ArgStartTokens.Length)
        {
            token = self.ArgStartTokens[index];
        }

        return token;
    }

    internal law u32[0 max] ArgEndTokenAt(borrow InlineLayoutSubstitutionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ArgEndTokens.Length)
        {
            token = self.ArgEndTokens[index];
        }

        return token;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow InlineLayoutSubstitutionTable self,
        u32[0 max] paramOwnerKeyword,
        u32[0 max] paramNameToken,
        u32[0 max] argOwnerKeyword,
        u32[0 max] argStartToken,
        u32[0 max] argEndToken)
    {
        if (!self.ParamOwnerKeywords.TryReserve(1)
            || !self.ParamNameTokens.TryReserve(1)
            || !self.ArgOwnerKeywords.TryReserve(1)
            || !self.ArgStartTokens.TryReserve(1)
            || !self.ArgEndTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.ParamOwnerKeywords[self.ParamOwnerKeywords.Length] = paramOwnerKeyword;
        init self.ParamNameTokens[self.ParamNameTokens.Length] = paramNameToken;
        init self.ArgOwnerKeywords[self.ArgOwnerKeywords.Length] = argOwnerKeyword;
        init self.ArgStartTokens[self.ArgStartTokens.Length] = argStartToken;
        init self.ArgEndTokens[self.ArgEndTokens.Length] = argEndToken;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn void Truncate(mut borrow InlineLayoutSubstitutionTable self, u64[0 2 ** 63 - 1] count)
    {
        while willexit (self.ParamNameTokens.Length > count)
        {
            stack u32[0 max] removedParamOwner = self.ParamOwnerKeywords.MoveLast();
            stack u32[0 max] removedParamName = self.ParamNameTokens.MoveLast();
            stack u32[0 max] removedArgOwner = self.ArgOwnerKeywords.MoveLast();
            stack u32[0 max] removedArgStart = self.ArgStartTokens.MoveLast();
            stack u32[0 max] removedArgEnd = self.ArgEndTokens.MoveLast();
        }
    }
}

internal struct InlineLayoutActiveTypeStack
{
    internal dynamic u32[0 max] NameTokens;

    InlineLayoutActiveTypeStack()
    {
        self.NameTokens = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow InlineLayoutActiveTypeStack self)
    {
        return self.NameTokens.Length;
    }

    internal law u32[0 max] NameTokenAt(borrow InlineLayoutActiveTypeStack self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    internal fn bool Contains(borrow InlineLayoutActiveTypeStack self, ascii source, borrow TokenStream stream, u32[0 max] nameToken)
    {
        stack u64[0 2 ** 63 - 1] count = self.NameTokens.Length;
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (TokenTextEqualsToken(source, stream, self.NameTokenAt(index), nameToken))
            {
                return true;
            }
        }

        return false;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow InlineLayoutActiveTypeStack self, u32[0 max] nameToken)
    {
        if (!self.NameTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn void Truncate(mut borrow InlineLayoutActiveTypeStack self, u64[0 2 ** 63 - 1] count)
    {
        while willexit (self.NameTokens.Length > count)
        {
            stack u32[0 max] removedName = self.NameTokens.MoveLast();
        }
    }
}

internal finite law bool InlineLayoutAggregateKind(DeclarationKind kind)
{
    return kind == DeclarationKind.Struct
        || kind == DeclarationKind.Record
        || kind == DeclarationKind.Enum;
}

internal fn bool InlineLayoutFindAggregateDeclaration(
    borrow DeclarationList decls,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] headToken,
    out DeclItem declaration)
{
    declaration = new();
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (InlineLayoutAggregateKind(item.Kind)
            && TokenTextEqualsToken(source, stream, item.NameToken, headToken))
        {
            declaration = item;
            return true;
        }
    }

    return false;
}

internal finite law u32[0 max] InlineLayoutDeclarationGenericOpen(borrow TokenStream stream, u32[0 max] declKeyword)
{
    stack mut u32[0 max] scan = (u32[0 max])(declKeyword + 1);
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])scan) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Identifier)
        {
            stack u32[0 max] next = (u32[0 max])(scan + 1);
            if (stream.KindAt((u64[0 2 ** 63 - 1])next) == TokenKind.Lt)
            {
                return next;
            }

            return 0;
        }

        if (kind == TokenKind.LBrace || kind == TokenKind.Semi || kind == TokenKind.LParen)
        {
            return 0;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn bool InlineLayoutTypeParameterOrdinal(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] declKeyword,
    u32[0 max] paramNameToken,
    out u32[0 max] ordinal)
{
    ordinal = 0;
    stack u32[0 max] open = InlineLayoutDeclarationGenericOpen(stream, declKeyword);
    if (open == 0)
    {
        return false;
    }

    stack mut u32[0 max] typeOrdinal = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(open + 1);
    stack mut u32[0 max] scan = segmentStart;
    stack mut u32[0 max] depth = 1;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])scan) != TokenKind.EndOfFile && depth > 0)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        stack mut bool boundary = false;
        if (kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (depth == 1)
            {
                boundary = true;
            }

            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 1 && kind == TokenKind.Comma)
        {
            boundary = true;
        }

        if (boundary && segmentStart < scan)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])segmentStart) != TokenKind.Comptime)
            {
                stack u32[0 max] name = LayoutBoundedLastIdentifier(stream, segmentStart, scan);
                if (name != 0 && TokenTextEqualsToken(source, stream, name, paramNameToken))
                {
                    ordinal = typeOrdinal;
                    return true;
                }

                typeOrdinal = (u32[0 max])(typeOrdinal + 1);
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool InlineLayoutTypeArgumentSpanAt(
    borrow TokenStream stream,
    u32[0 max] typeHeadToken,
    u32[0 max] typeEndToken,
    u32[0 max] ordinal,
    out u32[0 max] argStart,
    out u32[0 max] argEnd)
{
    argStart = 0;
    argEnd = 0;
    stack u32[0 max] open = (u32[0 max])(typeHeadToken + 1);
    if (open >= typeEndToken || stream.KindAt((u64[0 2 ** 63 - 1])open) != TokenKind.Lt)
    {
        return false;
    }

    stack mut u32[0 max] typeOrdinal = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(open + 1);
    stack mut u32[0 max] scan = segmentStart;
    stack mut u32[0 max] depth = 1;
    while willexit (scan < typeEndToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) != TokenKind.EndOfFile && depth > 0)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        stack mut bool boundary = false;
        if (kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (depth == 1)
            {
                boundary = true;
            }

            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 1 && kind == TokenKind.Comma)
        {
            boundary = true;
        }

        if (boundary && segmentStart < scan)
        {
            if (!GenericArgumentSegmentIsValue(stream, segmentStart, scan))
            {
                if (typeOrdinal == ordinal)
                {
                    argStart = segmentStart;
                    argEnd = scan;
                    return true;
                }

                typeOrdinal = (u32[0 max])(typeOrdinal + 1);
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool InlineLayoutTrySubstituteType(
    borrow InlineLayoutSubstitutionTable substitutions,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] spanOwnerKeyword,
    u32[0 max] typeHeadToken,
    out u32[0 max] argOwnerKeyword,
    out u32[0 max] argStart,
    out u32[0 max] argEnd)
{
    argOwnerKeyword = 0;
    argStart = 0;
    argEnd = 0;

    stack mut u32[0 max] ordinal = 0;
    if (!InlineLayoutTypeParameterOrdinal(source, stream, spanOwnerKeyword, typeHeadToken, ordinal))
    {
        return false;
    }

    stack mut u64[0 2 ** 63 - 1] index = substitutions.Count();
    while willexit (index > 0)
    {
        index = (u64[0 2 ** 63 - 1])(index - 1);
        if (substitutions.ParamOwnerKeywordAt(index) == spanOwnerKeyword
            && TokenTextEqualsToken(source, stream, substitutions.ParamNameTokenAt(index), typeHeadToken))
        {
            argOwnerKeyword = substitutions.ArgOwnerKeywordAt(index);
            argStart = substitutions.ArgStartTokenAt(index);
            argEnd = substitutions.ArgEndTokenAt(index);
            return true;
        }
    }

    return false;
}

internal fn System.Memory.MemoryStatus InlineLayoutAppendUseSiteSubstitutions(
    mut borrow InlineLayoutSubstitutionTable substitutions,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] targetDeclKeyword,
    u32[0 max] useOwnerKeyword,
    u32[0 max] typeHeadToken,
    u32[0 max] typeEndToken)
{
    stack u32[0 max] open = InlineLayoutDeclarationGenericOpen(stream, targetDeclKeyword);
    if (open == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] typeOrdinal = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(open + 1);
    stack mut u32[0 max] scan = segmentStart;
    stack mut u32[0 max] depth = 1;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])scan) != TokenKind.EndOfFile && depth > 0)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        stack mut bool boundary = false;
        if (kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (depth == 1)
            {
                boundary = true;
            }

            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 1 && kind == TokenKind.Comma)
        {
            boundary = true;
        }

        if (boundary && segmentStart < scan)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])segmentStart) != TokenKind.Comptime)
            {
                stack u32[0 max] paramName = LayoutBoundedLastIdentifier(stream, segmentStart, scan);
                stack mut u32[0 max] argStart = 0;
                stack mut u32[0 max] argEnd = 0;
                if (paramName != 0 && InlineLayoutTypeArgumentSpanAt(stream, typeHeadToken, typeEndToken, typeOrdinal, argStart, argEnd))
                {
                    switch (substitutions.Append(targetDeclKeyword, paramName, useOwnerKeyword, argStart, argEnd))
                    {
                        case System.Memory.MemoryStatus.Err(var appendError):
                            return System.Memory.MemoryStatus.Err(appendError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                typeOrdinal = (u32[0 max])(typeOrdinal + 1);
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal finite law bool InlineLayoutTypePrimaryStopsInlineTraversal(TokenKind kind)
{
    return kind == TokenKind.Bool
        || kind == TokenKind.IntegerType
        || kind == TokenKind.FloatType
        || kind == TokenKind.Void
        || kind == TokenKind.AsciiView
        || kind == TokenKind.UnicodeView
        || kind == TokenKind.AsciiOwned
        || kind == TokenKind.UnicodeOwned
        || kind == TokenKind.Dynamic
        || kind == TokenKind.Rawptr
        || kind == TokenKind.Rawmutptr
        || kind == TokenKind.Fnptr
        || kind == TokenKind.Closure
        || kind == TokenKind.Borrow
        || kind == TokenKind.Retborrow
        || kind == TokenKind.Storeborrow
        || kind == TokenKind.Out
        || kind == TokenKind.Init
        || kind == TokenKind.Frozen
        || kind == TokenKind.Shared;
}

internal finite law bool InlineLayoutTypeSpanIsSliceView(borrow TokenStream stream, u32[0 max] typeHeadToken, u32[0 max] typeEndToken)
{
    stack u32[0 max] bracket = (u32[0 max])(typeHeadToken + 1);
    return bracket < typeEndToken
        && stream.KindAt((u64[0 2 ** 63 - 1])bracket) == TokenKind.LBrack
        && (u32[0 max])(bracket + 1) < typeEndToken
        && stream.KindAt((u64[0 2 ** 63 - 1])(bracket + 1)) == TokenKind.RBrack;
}

internal fn System.Memory.MemoryStatus InlineLayoutVisitAggregateDeclaration(
    borrow DeclarationList decls,
    ascii source,
    borrow TokenStream stream,
    mut borrow InlineLayoutSubstitutionTable substitutions,
    mut borrow InlineLayoutActiveTypeStack active,
    DeclItem item,
    u32[0 max] anchorToken,
    mut borrow BindDiagnosticList diags)
{
    if (!InlineLayoutAggregateKind(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    if (active.Contains(source, stream, item.NameToken))
    {
        return diags.Append(BindDiagnosticCode.RecursiveInlineLayout, anchorToken);
    }

    stack u64[0 2 ** 63 - 1] activeCount = active.Count();
    switch (active.Append(item.NameToken))
    {
        case System.Memory.MemoryStatus.Err(var activeError):
            return System.Memory.MemoryStatus.Err(activeError);
        case System.Memory.MemoryStatus.Ok:
    }

    if (item.Kind == DeclarationKind.Struct || item.Kind == DeclarationKind.Record)
    {
        switch (ParseStructFields(stream, item.KeywordToken))
        {
            case ParseResult<FieldList>.Err(var fieldParseError):
                active.Truncate(activeCount);
                return System.Memory.MemoryStatus.Ok;
            case ParseResult<FieldList>.Ok(var fields):
                stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
                for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < fieldCount; field += 1)
                {
                    switch (InlineLayoutVisitTypeSpan(
                        decls,
                        source,
                        stream,
                        substitutions,
                        active,
                        item.KeywordToken,
                        fields.TypeStartAt(field),
                        fields.TypeEndAt(field),
                        fields.NameTokenAt(field),
                        diags))
                    {
                        case System.Memory.MemoryStatus.Err(var fieldError):
                            active.Truncate(activeCount);
                            return System.Memory.MemoryStatus.Err(fieldError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
        }
    }
    else if (item.Kind == DeclarationKind.Enum)
    {
        switch (ParseEnumPayloadTypeSpans(stream, item.KeywordToken))
        {
            case ParseResult<TypeSpanList>.Err(var payloadParseError):
                active.Truncate(activeCount);
                return System.Memory.MemoryStatus.Ok;
            case ParseResult<TypeSpanList>.Ok(var payloads):
                stack u64[0 2 ** 63 - 1] payloadCount = payloads.Count();
                for willexit (stack mut u64[0 2 ** 63 - 1] payload = 0; payload < payloadCount; payload += 1)
                {
                    switch (InlineLayoutVisitTypeSpan(
                        decls,
                        source,
                        stream,
                        substitutions,
                        active,
                        item.KeywordToken,
                        payloads.StartTokenAt(payload),
                        payloads.EndTokenAt(payload),
                        payloads.PrimaryAt(payload),
                        diags))
                    {
                        case System.Memory.MemoryStatus.Err(var payloadError):
                            active.Truncate(activeCount);
                            return System.Memory.MemoryStatus.Err(payloadError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
        }
    }

    active.Truncate(activeCount);
    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus InlineLayoutVisitTypeSpan(
    borrow DeclarationList decls,
    ascii source,
    borrow TokenStream stream,
    mut borrow InlineLayoutSubstitutionTable substitutions,
    mut borrow InlineLayoutActiveTypeStack active,
    u32[0 max] spanOwnerKeyword,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    u32[0 max] anchorToken,
    mut borrow BindDiagnosticList diags)
{
    if (typeStart >= typeEnd)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] typeHead = LayoutBoundedLastIdentifier(stream, typeStart, typeEnd);
    stack u32[0 max] typePrimary = LayoutBoundedFirstTypeStart(stream, typeStart, typeEnd);
    if (typeHead == 0 || typePrimary == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])typePrimary);
    if (InlineLayoutTypePrimaryStopsInlineTraversal(primaryKind)
        || InlineLayoutTypeSpanIsSliceView(stream, typeHead, typeEnd))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] argOwnerKeyword = 0;
    stack mut u32[0 max] argStart = 0;
    stack mut u32[0 max] argEnd = 0;
    if (InlineLayoutTrySubstituteType(substitutions, source, stream, spanOwnerKeyword, typeHead, argOwnerKeyword, argStart, argEnd))
    {
        return InlineLayoutVisitTypeSpan(decls, source, stream, substitutions, active, argOwnerKeyword, argStart, argEnd, anchorToken, diags);
    }

    stack mut DeclItem target = new();
    if (!InlineLayoutFindAggregateDeclaration(decls, source, stream, typeHead, target))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] substitutionCount = substitutions.Count();
    switch (InlineLayoutAppendUseSiteSubstitutions(substitutions, source, stream, target.KeywordToken, spanOwnerKeyword, typeHead, typeEnd))
    {
        case System.Memory.MemoryStatus.Err(var substitutionError):
            substitutions.Truncate(substitutionCount);
            return System.Memory.MemoryStatus.Err(substitutionError);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (InlineLayoutVisitAggregateDeclaration(decls, source, stream, substitutions, active, target, anchorToken, diags))
    {
        case System.Memory.MemoryStatus.Err(var visitError):
            substitutions.Truncate(substitutionCount);
            return System.Memory.MemoryStatus.Err(visitError);
        case System.Memory.MemoryStatus.Ok:
    }

    substitutions.Truncate(substitutionCount);
    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectRecursiveInlineLayoutDiagnostics(
    borrow DeclarationList decls,
    ascii source,
    borrow TokenStream stream,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (InlineLayoutAggregateKind(item.Kind))
        {
            stack mut InlineLayoutSubstitutionTable substitutions = new();
            stack mut InlineLayoutActiveTypeStack active = new();
            switch (InlineLayoutVisitAggregateDeclaration(decls, source, stream, substitutions, active, item, item.NameToken, diags))
            {
                case System.Memory.MemoryStatus.Err(var layoutError):
                    return System.Memory.MemoryStatus.Err(layoutError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

public enum CAbiAggregateBoundaryKind
{
    Return,
    Parameter,
}

public struct CLayoutAggregateTable
{
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] KeywordTokens;
    internal dynamic CAbiAggregateCarrierFacts Facts;

    CLayoutAggregateTable()
    {
        self.NameTokens = new();
        self.KeywordTokens = new();
        self.Facts = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow CLayoutAggregateTable self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] NameTokenAt(borrow CLayoutAggregateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law u32[0 max] KeywordTokenAt(borrow CLayoutAggregateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.KeywordTokens.Length)
        {
            token = self.KeywordTokens[index];
        }

        return token;
    }

    public law CAbiAggregateCarrierFacts FactsAt(borrow CLayoutAggregateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut CAbiAggregateCarrierFacts facts = new();
        if (index < self.Facts.Length)
        {
            facts = self.Facts[index];
        }

        return facts;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow CLayoutAggregateTable self, u32[0 max] nameToken, u32[0 max] keywordToken, CAbiAggregateCarrierFacts facts)
    {
        if (!self.NameTokens.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.Facts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.KeywordTokens[self.KeywordTokens.Length] = keywordToken;
        init self.Facts[self.Facts.Length] = facts;
        return System.Memory.MemoryStatus.Ok;
    }
}

public struct CAbiAggregateBoundaryTable
{
    internal dynamic CAbiAggregateBoundaryKind Kinds;
    internal dynamic u32[0 max] FunctionNameTokens;
    internal dynamic u32[0 max] TypeNameTokens;
    internal dynamic u32[0 max] ParamIndices;
    internal dynamic CAbiAggregateCarrierFacts Facts;

    CAbiAggregateBoundaryTable()
    {
        self.Kinds = new();
        self.FunctionNameTokens = new();
        self.TypeNameTokens = new();
        self.ParamIndices = new();
        self.Facts = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow CAbiAggregateBoundaryTable self)
    {
        return self.Kinds.Length;
    }

    public law CAbiAggregateBoundaryKind KindAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut CAbiAggregateBoundaryKind kind = CAbiAggregateBoundaryKind.Return;
        if (index < self.Kinds.Length)
        {
            kind = self.Kinds[index];
        }

        return kind;
    }

    public law u32[0 max] FunctionNameTokenAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.FunctionNameTokens.Length)
        {
            token = self.FunctionNameTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeNameTokenAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeNameTokens.Length)
        {
            token = self.TypeNameTokens[index];
        }

        return token;
    }

    public law u32[0 max] ParamIndexAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] paramIndex = 0;
        if (index < self.ParamIndices.Length)
        {
            paramIndex = self.ParamIndices[index];
        }

        return paramIndex;
    }

    public law CAbiAggregateCarrierFacts FactsAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut CAbiAggregateCarrierFacts facts = new();
        if (index < self.Facts.Length)
        {
            facts = self.Facts[index];
        }

        return facts;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow CAbiAggregateBoundaryTable self,
        CAbiAggregateBoundaryKind kind,
        u32[0 max] functionNameToken,
        u32[0 max] typeNameToken,
        u32[0 max] paramIndex,
        CAbiAggregateCarrierFacts facts)
    {
        if (!self.Kinds.TryReserve(1)
            || !self.FunctionNameTokens.TryReserve(1)
            || !self.TypeNameTokens.TryReserve(1)
            || !self.ParamIndices.TryReserve(1)
            || !self.Facts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Kinds[self.Kinds.Length] = kind;
        init self.FunctionNameTokens[self.FunctionNameTokens.Length] = functionNameToken;
        init self.TypeNameTokens[self.TypeNameTokens.Length] = typeNameToken;
        init self.ParamIndices[self.ParamIndices.Length] = paramIndex;
        init self.Facts[self.Facts.Length] = facts;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal enum CAbiStorageKind
{
    Unknown,
    Integer,
    Sse,
}

internal struct CAbiFieldInfo
{
    bool Known;
    u32[0 max] SizeBytes;
    u32[0 max] AlignBytes;
