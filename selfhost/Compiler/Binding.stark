    public law TypedLocalOwnerKind OwnerKindAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedLocalOwnerKind kind = TypedLocalOwnerKind.Unknown;
        if (index < self.OwnerKinds.Length)
        {
            kind = self.OwnerKinds[index];
