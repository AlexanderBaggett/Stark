    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedFunctionEffectSummaryTable self,
        TypedFunctionEffectOwnerKind ownerKind,
        u32[0 max] declarationSymbolIndexPlusOne,
        u32[0 max] memberSymbolIndexPlusOne,
        u32[0 max] ownerDeclarationSymbolIndexPlusOne,
        u32[0 max] nameToken,
        u32[0 max] keywordToken,
        u32[0 max] startToken,
        u32[0 max] endToken,
        u32[0 max] bodyOpenToken,
        TypedDeclarationFunctionKind functionKind,
        TypedFunctionInlinePreference inlinePreference,
        TypedFunctionBackendOptimizationMode backendOptimizationMode,
        u32[0 max] paramCount,
        u32[0 max] abiNameToken,
        u32[0 max] linkNameValueToken,
        u32[0 max] asmInputCount,
        u32[0 max] asmOutputCount,
        u32[0 max] asmClobberCount,
        TypedFunctionBodyShape bodyShape,
        u32[0 max] effectFlags)
    {
        if (!self.OwnerKinds.TryReserve(1)
            || !self.DeclarationSymbolIndices.TryReserve(1)
            || !self.MemberSymbolIndices.TryReserve(1)
            || !self.OwnerDeclarationSymbolIndices.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.BodyOpenTokens.TryReserve(1)
            || !self.FunctionKinds.TryReserve(1)
            || !self.InlinePreferences.TryReserve(1)
            || !self.BackendOptimizationModes.TryReserve(1)
            || !self.ParamCounts.TryReserve(1)
            || !self.AbiNameTokens.TryReserve(1)
            || !self.LinkNameValueTokens.TryReserve(1)
            || !self.AsmInputCounts.TryReserve(1)
            || !self.AsmOutputCounts.TryReserve(1)
            || !self.AsmClobberCounts.TryReserve(1)
            || !self.StatementCounts.TryReserve(1)
            || !self.TopLevelStatementCounts.TryReserve(1)
            || !self.ExpressionNodeCounts.TryReserve(1)
            || !self.CallExpressionCounts.TryReserve(1)
            || !self.NewExpressionCounts.TryReserve(1)
            || !self.AssignmentExpressionCounts.TryReserve(1)
            || !self.LocalDeclarationCounts.TryReserve(1)
            || !self.ReturnCounts.TryReserve(1)
            || !self.LoopCounts.TryReserve(1)
            || !self.BranchCounts.TryReserve(1)
            || !self.BodyFlags.TryReserve(1)
            || !self.EffectFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.OwnerKinds[self.OwnerKinds.Length] = ownerKind;
        init self.DeclarationSymbolIndices[self.DeclarationSymbolIndices.Length] = declarationSymbolIndexPlusOne;
        init self.MemberSymbolIndices[self.MemberSymbolIndices.Length] = memberSymbolIndexPlusOne;
        init self.OwnerDeclarationSymbolIndices[self.OwnerDeclarationSymbolIndices.Length] = ownerDeclarationSymbolIndexPlusOne;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.KeywordTokens[self.KeywordTokens.Length] = keywordToken;
        init self.StartTokens[self.StartTokens.Length] = startToken;
        init self.EndTokens[self.EndTokens.Length] = endToken;
        init self.BodyOpenTokens[self.BodyOpenTokens.Length] = bodyOpenToken;
        init self.FunctionKinds[self.FunctionKinds.Length] = functionKind;
        init self.InlinePreferences[self.InlinePreferences.Length] = inlinePreference;
        init self.BackendOptimizationModes[self.BackendOptimizationModes.Length] = backendOptimizationMode;
        init self.ParamCounts[self.ParamCounts.Length] = paramCount;
        init self.AbiNameTokens[self.AbiNameTokens.Length] = abiNameToken;
        init self.LinkNameValueTokens[self.LinkNameValueTokens.Length] = linkNameValueToken;
        init self.AsmInputCounts[self.AsmInputCounts.Length] = asmInputCount;
        init self.AsmOutputCounts[self.AsmOutputCounts.Length] = asmOutputCount;
        init self.AsmClobberCounts[self.AsmClobberCounts.Length] = asmClobberCount;
        init self.StatementCounts[self.StatementCounts.Length] = bodyShape.StatementCount;
        init self.TopLevelStatementCounts[self.TopLevelStatementCounts.Length] = bodyShape.TopLevelStatementCount;
        init self.ExpressionNodeCounts[self.ExpressionNodeCounts.Length] = bodyShape.ExpressionNodeCount;
        init self.CallExpressionCounts[self.CallExpressionCounts.Length] = bodyShape.CallExpressionCount;
        init self.NewExpressionCounts[self.NewExpressionCounts.Length] = bodyShape.NewExpressionCount;
        init self.AssignmentExpressionCounts[self.AssignmentExpressionCounts.Length] = bodyShape.AssignmentExpressionCount;
        init self.LocalDeclarationCounts[self.LocalDeclarationCounts.Length] = bodyShape.LocalDeclarationCount;
        init self.ReturnCounts[self.ReturnCounts.Length] = bodyShape.ReturnCount;
        init self.LoopCounts[self.LoopCounts.Length] = bodyShape.LoopCount;
        init self.BranchCounts[self.BranchCounts.Length] = bodyShape.BranchCount;
        init self.BodyFlags[self.BodyFlags.Length] = bodyShape.Flags;
        init self.EffectFlags[self.EffectFlags.Length] = effectFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal finite law bool TypedFunctionKindIsLaw(TypedDeclarationFunctionKind kind)
{
    return kind == TypedDeclarationFunctionKind.Law
        || kind == TypedDeclarationFunctionKind.FiniteLaw;
}

internal finite law bool TypedFunctionKindIsFinite(TypedDeclarationFunctionKind kind)
{
    return kind == TypedDeclarationFunctionKind.Finite
        || kind == TypedDeclarationFunctionKind.FiniteLaw;
}

internal finite law TypedFunctionInlinePreference TypedFunctionInlinePreferenceForFlags(u32[0 max] flags, TypedFunctionBackendOptimizationMode backendMode)
{
    if (backendMode == TypedFunctionBackendOptimizationMode.Opaque)
    {
        return TypedFunctionInlinePreference.NoInline;
    }

    if (TypedDeclFlagPresent(flags, TypedDeclFlagInline()))
    {
        return TypedFunctionInlinePreference.Inline;
    }

    if (TypedDeclFlagPresent(flags, TypedDeclFlagNoInline()))
    {
        return TypedFunctionInlinePreference.NoInline;
    }

    return TypedFunctionInlinePreference.InlineHint;
}

internal fn bool TypedFunctionSignatureReadsArgumentMemory(borrow TokenStream stream, borrow FunctionSignature signature)
{
    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] param = 0; param < paramCount; param += 1)
    {
        if (TypedLocalTypeSpanIsMemoryBacked(stream, signature.ParamTypeStartTokenAt(param), signature.ParamTypeEndTokenAt(param)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool TypedAsmSignatureTouchesMemory(borrow TokenStream stream, borrow FunctionSignature signature)
{
    if (TypedFunctionSignatureReadsArgumentMemory(stream, signature))
    {
        return true;
    }

    stack u64[0 2 ** 63 - 1] outputCount = (u64[0 2 ** 63 - 1])signature.AsmOutputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] output = 0; output < outputCount; output += 1)
    {
        if (!signature.AsmOutputBindsReturnAt(output))
        {
            return true;
        }
    }

    return signature.AsmClobberCount() != 0;
}

internal finite law u32[0 max] TypedFunctionBodyOpenToken(borrow TokenStream stream, u32[0 max] keywordToken, u32[0 max] endToken)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = keywordToken;
    while willexit (scan <= endToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0)
        {
            if (kind == TokenKind.LBrace)
            {
                return scan;
            }

            if (kind == TokenKind.Semi || kind == TokenKind.EndOfFile)
            {
                return 0;
            }
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal finite law bool AttributeListContainsBackendOpaque(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd)
{
    stack mut u32[0 max] scan = (u32[0 max])(attrStart + 1);
    while willexit (scan < attrEnd)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Identifier
            && TokenTextEquals(source, stream, scan, "Backend")
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 2)) == TokenKind.Identifier
            && TokenTextEquals(source, stream, (u32[0 max])(scan + 2), "Opaque")
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 3)) == TokenKind.RParen)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law TypedFunctionBackendOptimizationMode TypedFunctionBackendOptimizationModeForPrelude(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] startToken,
    u32[0 max] keywordToken)
{
    stack mut u32[0 max] scan = startToken;
    while willexit (scan < keywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return TypedFunctionBackendOptimizationMode.Default;
        }

        if (AttributeListContainsBackendOpaque(source, stream, scan, attrEnd))
        {
            return TypedFunctionBackendOptimizationMode.Opaque;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return TypedFunctionBackendOptimizationMode.Default;
}

internal fn TypedFunctionBodyShape AnalyzeTypedFunctionBodyShape(borrow StatementList body)
{
    stack mut TypedFunctionBodyShape shape = new();
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    shape.StatementCount = (u32[0 max])statementCount;
    for willexit (stack mut u64[0 2 ** 63 - 1] statement = 0; statement < statementCount; statement += 1)
    {
        stack StatementItem item = body.ItemAt(statement);
        if (body.DepthAt(statement) == 0)
        {
            shape.TopLevelStatementCount = (u32[0 max])(shape.TopLevelStatementCount + 1);
        }

        switch (item.Kind)
        {
            case StatementKind.Return:
                shape.ReturnCount = (u32[0 max])(shape.ReturnCount + 1);
                shape.Flags = shape.Flags | TypedFunctionBodyFlagReturn();
            case StatementKind.Become:
                shape.Flags = shape.Flags | TypedFunctionBodyFlagBecome();
            case StatementKind.If:
                shape.BranchCount = (u32[0 max])(shape.BranchCount + 1);
                shape.Flags = shape.Flags | TypedFunctionBodyFlagBranch();
            case StatementKind.While:
                shape.LoopCount = (u32[0 max])(shape.LoopCount + 1);
                shape.Flags = shape.Flags | TypedFunctionBodyFlagLoop();
            case StatementKind.For:
                shape.LoopCount = (u32[0 max])(shape.LoopCount + 1);
                shape.Flags = shape.Flags | TypedFunctionBodyFlagLoop();
            case StatementKind.ForEach:
                shape.LoopCount = (u32[0 max])(shape.LoopCount + 1);
                shape.Flags = shape.Flags | TypedFunctionBodyFlagLoop();
            case StatementKind.Switch:
                shape.BranchCount = (u32[0 max])(shape.BranchCount + 1);
                shape.Flags = shape.Flags | TypedFunctionBodyFlagSwitch() | TypedFunctionBodyFlagBranch();
            case StatementKind.Break:
                shape.Flags = shape.Flags | TypedFunctionBodyFlagBreakOrContinue();
            case StatementKind.Continue:
                shape.Flags = shape.Flags | TypedFunctionBodyFlagBreakOrContinue();
            case StatementKind.Local:
                shape.LocalDeclarationCount = (u32[0 max])(shape.LocalDeclarationCount + 1);
                shape.Flags = shape.Flags | TypedFunctionBodyFlagLocal();
            case StatementKind.PatternBinding:
                shape.LocalDeclarationCount = (u32[0 max])(shape.LocalDeclarationCount + 1);
                shape.Flags = shape.Flags | TypedFunctionBodyFlagLocal();
            case StatementKind.Unsafe:
                shape.Flags = shape.Flags | TypedFunctionBodyFlagUnsafe();
            case StatementKind.Block:
                shape.Flags = shape.Flags | TypedFunctionBodyFlagBlock();
            case StatementKind.Case:
            case StatementKind.Expression:
        }
    }

    stack u64[0 2 ** 63 - 1] exprCount = body.ExprNodeCount();
    shape.ExpressionNodeCount = (u32[0 max])exprCount;
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= exprCount; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        stack ExprKind kind = body.ExprKindAt(node);
        if (kind == Compiler.Parsing.ExprKind.Call)
        {
            shape.CallExpressionCount = (u32[0 max])(shape.CallExpressionCount + 1);
            shape.Flags = shape.Flags | TypedFunctionBodyFlagCall();
        }
        else if (kind == Compiler.Parsing.ExprKind.New)
        {
            shape.NewExpressionCount = (u32[0 max])(shape.NewExpressionCount + 1);
            shape.Flags = shape.Flags | TypedFunctionBodyFlagNew();
        }
        else if (kind == Compiler.Parsing.ExprKind.Assign)
        {
            shape.AssignmentExpressionCount = (u32[0 max])(shape.AssignmentExpressionCount + 1);
            shape.Flags = shape.Flags | TypedFunctionBodyFlagAssign();
        }
    }

    return shape;
}

internal finite law u32[0 max] BuildNormalFunctionEffectFlags(
    TypedDeclarationFunctionKind functionKind,
    bool hasBody,
    bool readsArgumentMemory,
    u32[0 max] bodyMemoryEffectFlags,
    bool isFfi,
    bool isVarargs,
    bool isTailCallable,
    bool isHot,
    bool isCold,
    bool isStrictFp,
    bool noRecurse,
    bool useFastCall)
{
    stack mut u32[0 max] flags = TypedFunctionEffectFlagNoUnwind();
    if (hasBody)
    {
        flags = flags | TypedFunctionEffectFlagHasBody();
    }

    if (readsArgumentMemory)
    {
        flags = flags | TypedFunctionEffectFlagReadsArgumentMemory();
    }

    flags = flags | bodyMemoryEffectFlags;

    if (TypedFunctionKindIsLaw(functionKind))
    {
        flags = flags | TypedFunctionEffectFlagPure() | TypedFunctionEffectFlagNoSync() | TypedFunctionEffectFlagNoFree();
    }

    if (TypedFunctionKindIsFinite(functionKind))
    {
        flags = flags | TypedFunctionEffectFlagWillReturn() | TypedFunctionEffectFlagMustProgress();
    }

    if (useFastCall) { flags = flags | TypedFunctionEffectFlagFastCall(); }
    if (isFfi) { flags = flags | TypedFunctionEffectFlagFfi(); }
    if (isVarargs) { flags = flags | TypedFunctionEffectFlagVarargs(); }
    if (isHot) { flags = flags | TypedFunctionEffectFlagHot(); }
    if (isCold) { flags = flags | TypedFunctionEffectFlagCold(); }
    if (isStrictFp) { flags = flags | TypedFunctionEffectFlagStrictFp(); }
    if (noRecurse) { flags = flags | TypedFunctionEffectFlagNoRecurse(); }
    if (isTailCallable) { flags = flags | TypedFunctionEffectFlagTailCallable(); }
    return flags;
}

internal finite law u32[0 max] BuildAsmFunctionEffectFlags(bool hasBody, bool touchesMemory)
{
    stack mut u32[0 max] flags = TypedFunctionEffectFlagNoUnwind() | TypedFunctionEffectFlagFfi() | TypedFunctionEffectFlagAsm();
    if (hasBody)
    {
        flags = flags | TypedFunctionEffectFlagHasBody();
    }

    if (touchesMemory)
    {
        flags = flags | TypedFunctionEffectFlagReadsArgumentMemory();
    }

    return flags;
}

internal fn System.Memory.MemoryStatus CollectTypedFunctionBodyMemoryEffectFlags(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    borrow FunctionSignature signature,
    borrow StatementList body,
    out u32[0 max] flags)
{
    flags = 0;
    stack mut FunctionScope scope = new();
    switch (BuildFunctionScope(signature, body))
    {
        case BindResult<FunctionScope>.Err(var scopeError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case BindResult<FunctionScope>.Ok(var builtScope):
            scope = builtScope;
    }

    stack mut ReferenceTable refs = new();
    switch (ResolveReferences(scope, table, source, stream, body))
    {
        case BindResult<ReferenceTable>.Err(var refError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case BindResult<ReferenceTable>.Ok(var builtRefs):
            refs = builtRefs;
    }

    stack u64[0 2 ** 63 - 1] refCount = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] refIndex = 0; refIndex < refCount; refIndex += 1)
    {
        if (ReferenceReadsGlobalState(table, refs, body, refIndex))
        {
            flags = flags | TypedFunctionEffectFlagReadsOtherMemory();
        }
    }

    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] statementIndex = 0; statementIndex < statementCount; statementIndex += 1)
    {
        stack StatementItem item = body.ItemAt(statementIndex);
        stack u32[0 max] root = body.ExprRootAt(statementIndex);
        if (item.Kind == StatementKind.Local)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])item.StartToken) == TokenKind.Heap)
            {
                flags = flags | TypedFunctionEffectFlagReadsOtherMemory() | TypedFunctionEffectFlagWritesOtherMemory();
            }

            if (TypeSpanIsDynamicStorage(stream, item.TypeStartToken, item.TypeEndToken)
                && ExpressionIsRuntimeDynamicNew(body, stream, root))
            {
                flags = flags | TypedFunctionEffectFlagReadsOtherMemory() | TypedFunctionEffectFlagWritesOtherMemory();
            }
        }
        else if (item.Kind == StatementKind.Return
            && TypeSpanIsDynamicStorage(stream, signature.ReturnTypeStartTokenAt(), signature.ReturnTypeEndTokenAt())
            && ExpressionIsRuntimeDynamicNew(body, stream, root))
        {
            flags = flags | TypedFunctionEffectFlagReadsOtherMemory() | TypedFunctionEffectFlagWritesOtherMemory();
        }

        if (ExpressionContainsArenaSelectorNew(body, stream, root))
        {
            flags = flags | TypedFunctionEffectFlagReadsOtherMemory() | TypedFunctionEffectFlagWritesOtherMemory();
        }
    }

    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        stack ExprKind kind = body.ExprKindAt(node);
        if (kind == Compiler.Parsing.ExprKind.Assign)
        {
            if (AssignmentTargetWritesGlobalState(table, refs, body, body.ExprLeftAt(node)))
            {
                flags = flags | TypedFunctionEffectFlagWritesOtherMemory();
            }

            if (AssignmentTargetIsDynamicStorage(table, source, refs, scope, stream, body, body.ExprLeftAt(node))
                && ExpressionIsRuntimeDynamicNew(body, stream, body.ExprRightAt(node)))
            {
                flags = flags | TypedFunctionEffectFlagReadsOtherMemory() | TypedFunctionEffectFlagWritesOtherMemory();
            }
        }
        else if (kind == Compiler.Parsing.ExprKind.Call
            && CallAllocatesDynamicStorage(table, source, refs, scope, stream, body, node))
        {
            flags = flags | TypedFunctionEffectFlagReadsOtherMemory() | TypedFunctionEffectFlagWritesOtherMemory();
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn BindResult<DeclarationTable> BuildSourceDeclarationTable(ascii source, borrow TokenStream stream)
{
    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return BindResult<DeclarationTable>.Err(BindError.OutOfMemory);
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return BindResult<DeclarationTable>.Err(BindError.OutOfMemory);
        case ParseResult<DeclarationList>.Ok(var parsedDecls):
            decls = parsedDecls;
    }

    return BuildDeclarationTable(source, stream, decls);
}

internal fn System.Memory.MemoryStatus AppendTypedFunctionEffectForDeclaration(
    mut borrow TypedFunctionEffectSummaryTable summaries,
    borrow DeclarationTable sourceDeclarations,
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    borrow RuntimeCallEdgeTable runtimeCallEdges,
    u64[0 2 ** 63 - 1] index)
{
    if (declarations.ClassAt(index) != TypedDeclarationSymbolClass.Function)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, declarations.KeywordTokenAt(index)))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack u32[0 max] bodyOpen = TypedFunctionBodyOpenToken(stream, declarations.KeywordTokenAt(index), declarations.EndTokenAt(index));
    stack mut TypedFunctionBodyShape shape = new();
    stack mut u32[0 max] bodyMemoryEffectFlags = 0;
    if (bodyOpen != 0)
    {
        switch (ParseFunctionBody(stream, declarations.KeywordTokenAt(index)))
        {
            case ParseResult<StatementList>.Err(var bodyError):
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
            case ParseResult<StatementList>.Ok(var body):
                shape = AnalyzeTypedFunctionBodyShape(body);
                switch (CollectTypedFunctionBodyMemoryEffectFlags(sourceDeclarations, source, stream, signature, body, bodyMemoryEffectFlags))
                {
                    case System.Memory.MemoryStatus.Err(var effectError):
                        return System.Memory.MemoryStatus.Err(effectError);
                    case System.Memory.MemoryStatus.Ok:
                }
        }
    }

    stack TypedFunctionBackendOptimizationMode backendMode = TypedFunctionBackendOptimizationModeForPrelude(source, stream, declarations.StartTokenAt(index), declarations.KeywordTokenAt(index));
    stack TypedFunctionInlinePreference inlinePreference = TypedFunctionInlinePreferenceForFlags(declarations.FlagsAt(index), backendMode);
    stack bool isAsm = declarations.IsAsmAt(index) || signature.HasAsm();
    stack mut u32[0 max] effectFlags = 0;
    stack mut TypedDeclarationFunctionKind storedKind = declarations.FunctionKindAt(index);
    if (isAsm)
    {
        storedKind = TypedDeclarationFunctionKind.Fn;
        effectFlags = BuildAsmFunctionEffectFlags(bodyOpen != 0, TypedAsmSignatureTouchesMemory(stream, signature));
    }
    else
    {
        stack bool isLaw = TypedFunctionKindIsLaw(storedKind);
        stack u32[0 max] sourceDeclarationPlusOne = FindSourceDeclarationByNameToken(sourceDeclarations, source, stream, declarations.NameTokenAt(index));
        stack mut bool ordinaryRecursive = false;
        if (sourceDeclarationPlusOne != 0)
        {
            switch (RuntimeDeclarationHasOrdinaryRecursiveCycle(runtimeCallEdges, sourceDeclarationPlusOne, ordinaryRecursive))
            {
                case System.Memory.MemoryStatus.Err(var recursionError):
                    return System.Memory.MemoryStatus.Err(recursionError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        stack bool noRecurse = bodyOpen != 0
            && sourceDeclarationPlusOne != 0
            && !ordinaryRecursive
            && !declarations.IsFfiAt(index)
            && !declarations.IsVarargsAt(index)
            && RuntimeCallerHasOnlyKnownOrdinaryDirectEdges(
                sourceDeclarations,
                stream,
                runtimeCallEdges,
                sourceDeclarationPlusOne,
                shape.CallExpressionCount);
        effectFlags = BuildNormalFunctionEffectFlags(
            storedKind,
            bodyOpen != 0,
            isLaw && TypedFunctionSignatureReadsArgumentMemory(stream, signature),
            bodyMemoryEffectFlags,
            declarations.IsFfiAt(index),
            declarations.IsVarargsAt(index),
            declarations.IsTailCallableAt(index),
            declarations.IsHotAt(index),
            declarations.IsColdAt(index),
            declarations.IsStrictFpAt(index),
            noRecurse,
            !declarations.IsTailCallableAt(index) && !declarations.IsFfiAt(index) && declarations.VisibilityAt(index) != TypedModuleSymbolVisibility.Export);
    }

    return summaries.Append(
        TypedFunctionEffectOwnerKind.Declaration,
        (u32[0 max])(index + 1),
        0,
        (u32[0 max])(index + 1),
        declarations.NameTokenAt(index),
        declarations.KeywordTokenAt(index),
        declarations.StartTokenAt(index),
        declarations.EndTokenAt(index),
        bodyOpen,
        storedKind,
        inlinePreference,
        backendMode,
        (u32[0 max])signature.ParamCount(),
        declarations.AbiNameTokenAt(index),
        declarations.LinkNameValueTokenAt(index),
        declarations.AsmInputCountAt(index),
        declarations.AsmOutputCountAt(index),
        declarations.AsmClobberCountAt(index),
        shape,
        effectFlags);
}

internal fn System.Memory.MemoryStatus AppendTypedFunctionEffectForMember(
    mut borrow TypedFunctionEffectSummaryTable summaries,
    borrow DeclarationTable sourceDeclarations,
    ascii source,
    borrow TokenStream stream,
    borrow TypedMemberSymbolTable members,
    u64[0 2 ** 63 - 1] index)
{
    if (members.KindAt(index) != TypedMemberSymbolKind.Method)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, members.KeywordTokenAt(index)))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack u32[0 max] bodyOpen = TypedFunctionBodyOpenToken(stream, members.KeywordTokenAt(index), members.EndTokenAt(index));
    stack mut TypedFunctionBodyShape shape = new();
    stack mut u32[0 max] bodyMemoryEffectFlags = 0;
    if (bodyOpen != 0)
    {
        switch (ParseFunctionBody(stream, members.KeywordTokenAt(index)))
        {
            case ParseResult<StatementList>.Err(var bodyError):
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
            case ParseResult<StatementList>.Ok(var body):
                shape = AnalyzeTypedFunctionBodyShape(body);
                switch (CollectTypedFunctionBodyMemoryEffectFlags(sourceDeclarations, source, stream, signature, body, bodyMemoryEffectFlags))
                {
                    case System.Memory.MemoryStatus.Err(var effectError):
                        return System.Memory.MemoryStatus.Err(effectError);
                    case System.Memory.MemoryStatus.Ok:
                }
        }
    }

    stack TypedFunctionBackendOptimizationMode backendMode = TypedFunctionBackendOptimizationModeForPrelude(source, stream, members.StartTokenAt(index), members.KeywordTokenAt(index));
    stack TypedFunctionInlinePreference inlinePreference = TypedFunctionInlinePreferenceForFlags(members.FlagsAt(index), backendMode);
    stack bool isAsm = members.IsAsmAt(index) || signature.HasAsm();
    stack mut u32[0 max] effectFlags = 0;
    stack mut TypedDeclarationFunctionKind storedKind = members.FunctionKindAt(index);
    if (isAsm)
    {
        storedKind = TypedDeclarationFunctionKind.Fn;
        effectFlags = BuildAsmFunctionEffectFlags(bodyOpen != 0, TypedAsmSignatureTouchesMemory(stream, signature));
    }
    else
    {
        stack bool isLaw = TypedFunctionKindIsLaw(storedKind);
        effectFlags = BuildNormalFunctionEffectFlags(
            storedKind,
            bodyOpen != 0,
            isLaw && TypedFunctionSignatureReadsArgumentMemory(stream, signature),
            bodyMemoryEffectFlags,
            members.IsFfiAt(index),
            members.IsVarargsAt(index),
            members.IsTailCallableAt(index),
            members.IsHotAt(index),
            members.IsColdAt(index),
            members.IsStrictFpAt(index),
            false,
            !members.IsTailCallableAt(index) && !members.IsFfiAt(index) && members.VisibilityAt(index) != TypedModuleSymbolVisibility.Export);
    }

    return summaries.Append(
        TypedFunctionEffectOwnerKind.MemberMethod,
        0,
        (u32[0 max])(index + 1),
        members.OwnerDeclarationSymbolIndexPlusOneAt(index),
        members.NameTokenAt(index),
        members.KeywordTokenAt(index),
        members.StartTokenAt(index),
        members.EndTokenAt(index),
        bodyOpen,
        storedKind,
        inlinePreference,
        backendMode,
        (u32[0 max])signature.ParamCount(),
        members.AbiNameTokenAt(index),
        members.LinkNameValueTokenAt(index),
        members.AsmInputCountAt(index),
        members.AsmOutputCountAt(index),
        members.AsmClobberCountAt(index),
        shape,
        effectFlags);
}

public fn BindResult<TypedFunctionEffectSummaryTable> BuildTypedFunctionEffectSummaries(
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    borrow TypedMemberSymbolTable members)
{
    stack mut TypedFunctionEffectSummaryTable summaries = new();
    stack mut DeclarationTable sourceDeclarations = new();
    switch (BuildSourceDeclarationTable(source, stream))
    {
        case BindResult<DeclarationTable>.Err(var sourceTableError):
            return BindResult<TypedFunctionEffectSummaryTable>.Err(BindError.OutOfMemory);
        case BindResult<DeclarationTable>.Ok(var builtSourceDeclarations):
            sourceDeclarations = builtSourceDeclarations;
    }

    stack mut RuntimeCallEdgeTable runtimeCallEdges = new();
    switch (CollectRuntimeCallEdges(sourceDeclarations, source, stream, runtimeCallEdges))
    {
        case System.Memory.MemoryStatus.Err(var edgeError):
            return BindResult<TypedFunctionEffectSummaryTable>.Err(BindError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] declarationCount = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < declarationCount; index += 1)
    {
        switch (AppendTypedFunctionEffectForDeclaration(summaries, sourceDeclarations, source, stream, declarations, runtimeCallEdges, index))
        {
            case System.Memory.MemoryStatus.Err(var declarationError):
                return BindResult<TypedFunctionEffectSummaryTable>.Err(BindError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack u64[0 2 ** 63 - 1] memberCount = members.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < memberCount; index += 1)
    {
        switch (AppendTypedFunctionEffectForMember(summaries, sourceDeclarations, source, stream, members, index))
        {
            case System.Memory.MemoryStatus.Err(var memberError):
                return BindResult<TypedFunctionEffectSummaryTable>.Err(BindError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return BindResult<TypedFunctionEffectSummaryTable>.Ok(summaries);
}

public enum TypedTraitConformanceKind
{
    DeclarationBase,
    GenericConstraint,
    Unknown,
}

internal inline finite law u32[0 max] TypedTraitConformanceFlagTraitResolved()
{
    return 1;
}

internal inline finite law u32[0 max] TypedTraitConformanceFlagTraitGeneric()
{
    return 2;
}

internal inline finite law u32[0 max] TypedTraitConformanceFlagSubjectGenericParameter()
{
    return 4;
}

public struct TypedTraitConformanceTable
{
    internal dynamic u32[0 max] OwnerDeclarationSymbolIndices;
    internal dynamic u32[0 max] OwnerMemberSymbolIndices;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic TypedTraitConformanceKind Kinds;
    internal dynamic u32[0 max] SubjectDeclarationSymbolIndices;
    internal dynamic u32[0 max] SubjectGenericParameterSymbolIndices;
    internal dynamic u32[0 max] SubjectNameTokens;
    internal dynamic u32[0 max] TraitDeclarationSymbolIndices;
    internal dynamic u32[0 max] TraitNameTokens;
    internal dynamic u32[0 max] TraitHeadTokens;
    internal dynamic u32[0 max] TraitPrimaryTokens;
    internal dynamic u32[0 max] TraitStartTokens;
    internal dynamic u32[0 max] TraitEndTokens;
    internal dynamic u32[0 max] TraitGenericOpenTokens;
    internal dynamic u32[0 max] TraitGenericCloseTokens;
    internal dynamic u32[0 max] TraitTypeArgumentCounts;
    internal dynamic u32[0 max] TraitComptimeArgumentCounts;
    internal dynamic u32[0 max] Flags;

    TypedTraitConformanceTable()
    {
        self.OwnerDeclarationSymbolIndices = new();
        self.OwnerMemberSymbolIndices = new();
        self.OwnerNameTokens = new();
        self.Kinds = new();
        self.SubjectDeclarationSymbolIndices = new();
        self.SubjectGenericParameterSymbolIndices = new();
        self.SubjectNameTokens = new();
        self.TraitDeclarationSymbolIndices = new();
        self.TraitNameTokens = new();
        self.TraitHeadTokens = new();
        self.TraitPrimaryTokens = new();
        self.TraitStartTokens = new();
        self.TraitEndTokens = new();
        self.TraitGenericOpenTokens = new();
        self.TraitGenericCloseTokens = new();
        self.TraitTypeArgumentCounts = new();
        self.TraitComptimeArgumentCounts = new();
        self.Flags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedTraitConformanceTable self)
    {
        return self.Kinds.Length;
    }

    public law u32[0 max] OwnerDeclarationSymbolIndexPlusOneAt(borrow TypedTraitConformanceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.OwnerDeclarationSymbolIndices.Length)
        {
            value = self.OwnerDeclarationSymbolIndices[index];
        }

        return value;
    }

    public law u32[0 max] OwnerMemberSymbolIndexPlusOneAt(borrow TypedTraitConformanceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.OwnerMemberSymbolIndices.Length)
        {
            value = self.OwnerMemberSymbolIndices[index];
        }

        return value;
    }

    public law u32[0 max] OwnerNameTokenAt(borrow TypedTraitConformanceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.OwnerNameTokens.Length)
        {
            token = self.OwnerNameTokens[index];
        }

        return token;
    }

    public law TypedTraitConformanceKind KindAt(borrow TypedTraitConformanceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedTraitConformanceKind kind = TypedTraitConformanceKind.Unknown;
        if (index < self.Kinds.Length)
        {
            kind = self.Kinds[index];
        }

        return kind;
    }

    public law u32[0 max] SubjectDeclarationSymbolIndexPlusOneAt(borrow TypedTraitConformanceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.SubjectDeclarationSymbolIndices.Length)
        {
            value = self.SubjectDeclarationSymbolIndices[index];
        }

        return value;
    }

    public law u32[0 max] SubjectGenericParameterSymbolIndexPlusOneAt(borrow TypedTraitConformanceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.SubjectGenericParameterSymbolIndices.Length)
        {
            value = self.SubjectGenericParameterSymbolIndices[index];
        }

        return value;
    }

    public law u32[0 max] SubjectNameTokenAt(borrow TypedTraitConformanceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.SubjectNameTokens.Length)
        {
            token = self.SubjectNameTokens[index];
        }

        return token;
    }

