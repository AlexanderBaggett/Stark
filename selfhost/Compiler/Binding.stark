    public law u32[0 max] LinkNameValueTokenAt(borrow TypedDeclarationSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.LinkNameValueTokens.Length)
        {
            token = self.LinkNameValueTokens[index];
        }

        return token;
    }

