{
    return 1;
}

internal inline finite law u32[0 max] TypedLocalFlagBorrow()
{
    return 2;
}

internal inline finite law u32[0 max] TypedLocalFlagRetborrow()
{
    return 4;
}

internal inline finite law u32[0 max] TypedLocalFlagStoreborrow()
{
    return 8;
}

internal inline finite law u32[0 max] TypedLocalFlagOut()
{
    return 16;
}

internal inline finite law u32[0 max] TypedLocalFlagInit()
{
    return 32;
}

internal inline finite law u32[0 max] TypedLocalFlagRawPointer()
{
    return 64;
}

internal inline finite law u32[0 max] TypedLocalFlagRawMutablePointer()
{
    return 128;
}

internal inline finite law u32[0 max] TypedLocalFlagTailCallableType()
{
    return 256;
}

internal inline finite law u32[0 max] TypedLocalFlagDeadOnReturn()
{
    return 512;
}

internal inline finite law u32[0 max] TypedLocalFlagCallableTypeDeadOnReturn()
{
    return 1024;
