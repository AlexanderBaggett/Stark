    public law u32[0 max] NameTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law u32[0 max] StartTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.StartTokens.Length)
        {
            token = self.StartTokens[index];
        }

        return token;
    }

    public law u32[0 max] EndTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.EndTokens.Length)
        {
            token = self.EndTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeHeadTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeHeadTokens.Length)
        {
            token = self.TypeHeadTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypePrimaryTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypePrimaryTokens.Length)
        {
            token = self.TypePrimaryTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeStartTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeStartTokens.Length)
        {
            token = self.TypeStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeEndTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeEndTokens.Length)
        {
            token = self.TypeEndTokens[index];
