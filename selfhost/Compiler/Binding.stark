    internal fn System.Memory.MemoryStatus AppendSet(
        mut borrow ReceiverCandidateSetTable self,
        ReceiverCandidateSiteKind siteKind,
        u32[0 max] memberNode,
        u32[0 max] callNode,
        u32[0 max] receiverNode,
        u32[0 max] receiverTypeToken,
        u32[0 max] nameToken,
        u32[0 max] argumentCount,
        out u32[0 max] siteIndex)
    {
        siteIndex = 0;
        if (!self.SiteKinds.TryReserve(1)
            || !self.MemberNodes.TryReserve(1)
            || !self.CallNodes.TryReserve(1)
            || !self.ReceiverNodes.TryReserve(1)
            || !self.ReceiverTypeTokens.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.ArgumentCounts.TryReserve(1)
            || !self.CandidateStartSlots.TryReserve(1)
            || !self.CandidateCounts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        siteIndex = (u32[0 max])(self.MemberNodes.Length + 1);
        init self.SiteKinds[self.SiteKinds.Length] = siteKind;
        init self.MemberNodes[self.MemberNodes.Length] = memberNode;
        init self.CallNodes[self.CallNodes.Length] = callNode;
        init self.ReceiverNodes[self.ReceiverNodes.Length] = receiverNode;
        init self.ReceiverTypeTokens[self.ReceiverTypeTokens.Length] = receiverTypeToken;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.ArgumentCounts[self.ArgumentCounts.Length] = argumentCount;
        init self.CandidateStartSlots[self.CandidateStartSlots.Length] = (u32[0 max])(self.CandidateTokens.Length + 1);
        init self.CandidateCounts[self.CandidateCounts.Length] = 0;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus AppendCandidate(mut borrow ReceiverCandidateSetTable self, u32[0 max] siteIndex, ReceiverCandidateKind kind, u32[0 max] candidateToken)
    {
        if (siteIndex == 0 || candidateToken == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.CandidateKinds.TryReserve(1)
            || !self.CandidateTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.CandidateKinds[self.CandidateKinds.Length] = kind;
        init self.CandidateTokens[self.CandidateTokens.Length] = candidateToken;

        stack u64[0 2 ** 63 - 1] siteSlot = (u64[0 2 ** 63 - 1])(siteIndex - 1);
        if (siteSlot < self.CandidateCounts.Length)
        {
            self.CandidateCounts[siteSlot] = (u32[0 max])(self.CandidateCounts[siteSlot] + 1);
        }

        return System.Memory.MemoryStatus.Ok;
    }
