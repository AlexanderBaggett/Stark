    public law u32[0 max] RangeStartTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.RangeStartTokens.Length)
        {
            token = self.RangeStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] RangeEndTokenAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.RangeEndTokens.Length)
        {
            token = self.RangeEndTokens[index];
        }

        return token;
    }

    public law u32[0 max] ParamOrdinalAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] ordinal = 0;
        if (index < self.ParamOrdinals.Length)
        {
            ordinal = self.ParamOrdinals[index];
        }

        return ordinal;
    }

    public law u32[0 max] TypeOrdinalAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] ordinal = 0;
        if (index < self.TypeOrdinals.Length)
        {
            ordinal = self.TypeOrdinals[index];
        }

        return ordinal;
    }

    public law u32[0 max] ComptimeOrdinalAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] ordinal = 0;
        if (index < self.ComptimeOrdinals.Length)
        {
            ordinal = self.ComptimeOrdinals[index];
        }

        return ordinal;
    }

    public law u32[0 max] ConstraintCountAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ConstraintCounts.Length)
        {
            count = self.ConstraintCounts[index];
        }

        return count;
    }

    public law u32[0 max] FlagsAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flags = 0;
        if (index < self.Flags.Length)
        {
            flags = self.Flags[index];
        }

        return flags;
    }

    public law bool IsComptimeValueAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericFlagComptimeValue());
    }

    public law bool HasTypeAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericFlagHasType());
    }

    public law bool IsIntegerTypeAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericFlagIntegerType());
    }

    public law bool IsFloatTypeAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericFlagFloatType());
    }

    public law bool IsBoolTypeAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericFlagBoolType());
    }

    public law bool IsTextTypeAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericFlagTextType());
    }

    public law bool IsNamedTypeAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericFlagNamedType());
    }

    public law bool HasRangeBoundsAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericFlagHasRangeBounds());
    }

    public law bool HasConstraintsAt(borrow TypedGenericParameterSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedGenericFlagHasConstraints());
    }

    public law u32[0 max] TypeParameterCount(borrow TypedGenericParameterSymbolTable self)
    {
        return self.CountOfKind(TypedGenericParameterKind.Type);
    }

    public law u32[0 max] ComptimeValueParameterCount(borrow TypedGenericParameterSymbolTable self)
    {
        return self.CountOfKind(TypedGenericParameterKind.ComptimeValue);
    }

    internal law u32[0 max] CountOfKind(borrow TypedGenericParameterSymbolTable self, TypedGenericParameterKind kind)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.KindAt(index) == kind)
            {
                total = (u32[0 max])(total + 1);
            }
        }

        return total;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedGenericParameterSymbolTable self,
        u32[0 max] ownerDeclarationSymbolIndexPlusOne,
        u32[0 max] ownerMemberSymbolIndexPlusOne,
        u32[0 max] ownerNameToken,
        TypedGenericOwnerKind ownerKind,
        TypedGenericParameterKind kind,
        u32[0 max] nameToken,
        u32[0 max] startToken,
        u32[0 max] endToken,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] paramOrdinal,
        u32[0 max] typeOrdinal,
        u32[0 max] comptimeOrdinal,
        u32[0 max] constraintCount,
        u32[0 max] flags)
    {
        if (!self.OwnerDeclarationSymbolIndices.TryReserve(1)
            || !self.OwnerMemberSymbolIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.OwnerKinds.TryReserve(1)
            || !self.Kinds.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ParamOrdinals.TryReserve(1)
            || !self.TypeOrdinals.TryReserve(1)
            || !self.ComptimeOrdinals.TryReserve(1)
            || !self.ConstraintCounts.TryReserve(1)
            || !self.Flags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.OwnerDeclarationSymbolIndices[self.OwnerDeclarationSymbolIndices.Length] = ownerDeclarationSymbolIndexPlusOne;
        init self.OwnerMemberSymbolIndices[self.OwnerMemberSymbolIndices.Length] = ownerMemberSymbolIndexPlusOne;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.OwnerKinds[self.OwnerKinds.Length] = ownerKind;
        init self.Kinds[self.Kinds.Length] = kind;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.StartTokens[self.StartTokens.Length] = startToken;
        init self.EndTokens[self.EndTokens.Length] = endToken;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ParamOrdinals[self.ParamOrdinals.Length] = paramOrdinal;
        init self.TypeOrdinals[self.TypeOrdinals.Length] = typeOrdinal;
        init self.ComptimeOrdinals[self.ComptimeOrdinals.Length] = comptimeOrdinal;
        init self.ConstraintCounts[self.ConstraintCounts.Length] = constraintCount;
        init self.Flags[self.Flags.Length] = flags;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal finite law TypedGenericParameterKind TypedGenericParameterKindForSegment(borrow TokenStream stream, u32[0 max] startToken)
{
    if (stream.KindAt((u64[0 2 ** 63 - 1])startToken) == TokenKind.Comptime)
    {
        return TypedGenericParameterKind.ComptimeValue;
    }

    return TypedGenericParameterKind.Type;
}

internal finite law u32[0 max] TypedGenericLastTopLevelIdentifierInSpan(borrow TokenStream stream, u32[0 max] startToken, u32[0 max] endExclusive)
{
    stack mut u32[0 max] token = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = startToken;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && kind == TokenKind.Identifier)
        {
            token = scan;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return token;
}

internal finite law u32[0 max] TypedGenericRangeStartToken(borrow TokenStream stream, u32[0 max] startToken, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut bool sawIntegerType = false;
    stack mut u32[0 max] scan = startToken;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0)
        {
            if (kind == TokenKind.IntegerType)
            {
                sawIntegerType = true;
            }
            else if (kind == TokenKind.LBrack && sawIntegerType)
            {
                return scan;
            }
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal finite law u32[0 max] TypedGenericOwnerTerminatorToken(borrow TokenStream stream, u32[0 max] ownerKeywordToken)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = ownerKeywordToken;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return scan;
        }

        if (depth == 0 && (kind == TokenKind.LBrace || kind == TokenKind.Semi))
        {
            return scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return ownerKeywordToken;
}

internal finite law u32[0 max] TypedGenericWhereTokenForOwner(borrow TokenStream stream, u32[0 max] ownerKeywordToken)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = ownerKeywordToken;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return 0;
        }

        if (depth == 0 && (kind == TokenKind.LBrace || kind == TokenKind.Semi))
        {
            return 0;
        }

        if (depth == 0 && kind == TokenKind.Where
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.Identifier
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 2)) == TokenKind.Colon)
        {
            return scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn u32[0 max] TypedGenericConstraintCountForParameter(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] whereToken,
    u32[0 max] ownerEndToken,
    u32[0 max] nameToken)
{
    if (whereToken == 0 || nameToken == 0 || ownerEndToken <= whereToken)
    {
        return 0;
    }

    stack mut u32[0 max] count = 0;
    stack mut bool currentMatches = false;
    stack mut u32[0 max] segmentStart = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(whereToken + 1);
    while willexit (scan <= ownerEndToken)
    {
        stack mut bool boundary = false;
        if (scan >= ownerEndToken)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (depth == 0 && kind == TokenKind.Identifier
                && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.Colon)
            {
                currentMatches = TokenTextEqualsToken(source, stream, scan, nameToken);
                segmentStart = (u32[0 max])(scan + 2);
                scan = (u32[0 max])(scan + 2);
                continue;
            }

            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (currentMatches && segmentStart != 0 && segmentStart < scan)
            {
                count = (u32[0 max])(count + 1);
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

internal finite law u32[0 max] TypedGenericFlagsForParameter(
    TypedGenericParameterKind kind,
    borrow TokenStream stream,
    u32[0 max] typePrimaryToken,
    u32[0 max] typeHeadToken,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    u32[0 max] rangeStartToken,
    u32[0 max] constraintCount)
{
    stack mut u32[0 max] flags = 0;
    if (kind == TypedGenericParameterKind.ComptimeValue)
    {
        flags = flags | TypedGenericFlagComptimeValue();
    }

    if (typeStartToken != 0 && typeStartToken < typeEndToken)
    {
        flags = flags | TypedGenericFlagHasType();
    }

    if (typePrimaryToken != 0)
    {
        stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])typePrimaryToken);
        if (primaryKind == TokenKind.IntegerType)
        {
            flags = flags | TypedGenericFlagIntegerType();
        }
        else if (primaryKind == TokenKind.FloatType)
        {
            flags = flags | TypedGenericFlagFloatType();
        }
        else if (primaryKind == TokenKind.Bool)
        {
            flags = flags | TypedGenericFlagBoolType();
        }
        else if (primaryKind == TokenKind.AsciiView
            || primaryKind == TokenKind.UnicodeView
            || primaryKind == TokenKind.AsciiOwned
            || primaryKind == TokenKind.UnicodeOwned)
        {
            flags = flags | TypedGenericFlagTextType();
        }
    }

    if (typeHeadToken != 0)
    {
        flags = flags | TypedGenericFlagNamedType();
    }

    if (rangeStartToken != 0)
    {
        flags = flags | TypedGenericFlagHasRangeBounds();
    }

    if (constraintCount > 0)
    {
        flags = flags | TypedGenericFlagHasConstraints();
    }

    return flags;
}

internal fn System.Memory.MemoryStatus AppendTypedGenericParameterFromSegment(
    mut borrow TypedGenericParameterSymbolTable symbols,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerDeclarationSymbolIndexPlusOne,
    u32[0 max] ownerMemberSymbolIndexPlusOne,
    u32[0 max] ownerNameToken,
    TypedGenericOwnerKind ownerKind,
    u32[0 max] ownerWhereToken,
    u32[0 max] ownerEndToken,
    u32[0 max] segmentStartToken,
    u32[0 max] segmentEndTokenExclusive,
    u32[0 max] paramOrdinal,
    u32[0 max] typeOrdinal,
    u32[0 max] comptimeOrdinal,
    out TypedGenericParameterKind appendedKind)
{
    appendedKind = TypedGenericParameterKind.Unknown;
    if (segmentStartToken >= segmentEndTokenExclusive)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack TypedGenericParameterKind kind = TypedGenericParameterKindForSegment(stream, segmentStartToken);
    stack u32[0 max] nameToken = TypedGenericLastTopLevelIdentifierInSpan(stream, segmentStartToken, segmentEndTokenExclusive);
    if (nameToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] typeStartToken = nameToken;
    stack mut u32[0 max] typeEndToken = (u32[0 max])(nameToken + 1);
    stack mut u32[0 max] typePrimaryToken = nameToken;
    stack mut u32[0 max] typeHeadToken = nameToken;
    if (kind == TypedGenericParameterKind.ComptimeValue)
    {
        typeStartToken = (u32[0 max])(segmentStartToken + 1);
        typeEndToken = nameToken;
        typePrimaryToken = FirstTypeTokenInSpan(stream, typeStartToken, typeEndToken);
        typeHeadToken = LastTypeHeadIdentifierInSpan(stream, typeStartToken, typeEndToken);
    }

    stack u32[0 max] rangeStartToken = TypedGenericRangeStartToken(stream, typeStartToken, typeEndToken);
    stack mut u32[0 max] rangeEndToken = 0;
    if (rangeStartToken != 0)
    {
        rangeEndToken = MatchingMemberCloseToken(stream, rangeStartToken);
        if (rangeEndToken == rangeStartToken)
        {
            rangeEndToken = 0;
        }
    }

    stack u32[0 max] constraintCount = TypedGenericConstraintCountForParameter(source, stream, ownerWhereToken, ownerEndToken, nameToken);
    stack u32[0 max] flags = TypedGenericFlagsForParameter(kind, stream, typePrimaryToken, typeHeadToken, typeStartToken, typeEndToken, rangeStartToken, constraintCount);
    stack mut u32[0 max] storedTypeOrdinal = 0;
    stack mut u32[0 max] storedComptimeOrdinal = 0;
    if (kind == TypedGenericParameterKind.Type)
    {
        storedTypeOrdinal = typeOrdinal;
    }
    else if (kind == TypedGenericParameterKind.ComptimeValue)
    {
        storedComptimeOrdinal = comptimeOrdinal;
    }

    switch (symbols.Append(
        ownerDeclarationSymbolIndexPlusOne,
        ownerMemberSymbolIndexPlusOne,
        ownerNameToken,
        ownerKind,
        kind,
        nameToken,
        segmentStartToken,
        (u32[0 max])(segmentEndTokenExclusive - 1),
        typeHeadToken,
        typePrimaryToken,
        typeStartToken,
        typeEndToken,
        rangeStartToken,
        rangeEndToken,
        paramOrdinal,
        storedTypeOrdinal,
        storedComptimeOrdinal,
        constraintCount,
        flags))
    {
        case System.Memory.MemoryStatus.Err(var appendError):
            return System.Memory.MemoryStatus.Err(appendError);
        case System.Memory.MemoryStatus.Ok:
            appendedKind = kind;
            return System.Memory.MemoryStatus.Ok;
    }
}

internal fn System.Memory.MemoryStatus AppendTypedGenericParametersFromList(
    mut borrow TypedGenericParameterSymbolTable symbols,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerDeclarationSymbolIndexPlusOne,
    u32[0 max] ownerMemberSymbolIndexPlusOne,
    u32[0 max] ownerNameToken,
    TypedGenericOwnerKind ownerKind,
    u32[0 max] ownerKeywordToken,
    u32[0 max] genericOpenToken)
{
    if (genericOpenToken == 0 || stream.KindAt((u64[0 2 ** 63 - 1])genericOpenToken) != TokenKind.Lt)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] genericCloseToken = MatchingMemberCloseToken(stream, genericOpenToken);
    if (genericCloseToken <= genericOpenToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] ownerWhereToken = TypedGenericWhereTokenForOwner(stream, ownerKeywordToken);
    stack u32[0 max] ownerEndToken = TypedGenericOwnerTerminatorToken(stream, ownerKeywordToken);
    stack mut u32[0 max] paramOrdinal = 0;
    stack mut u32[0 max] typeOrdinal = 0;
    stack mut u32[0 max] comptimeOrdinal = 0;
    stack mut u32[0 max] segmentStartToken = (u32[0 max])(genericOpenToken + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(genericOpenToken + 1);
    while willexit (scan <= genericCloseToken)
    {
        stack mut bool boundary = false;
        if (scan == genericCloseToken)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            stack mut TypedGenericParameterKind appendedKind = TypedGenericParameterKind.Unknown;
            switch (AppendTypedGenericParameterFromSegment(
                symbols,
                source,
                stream,
                ownerDeclarationSymbolIndexPlusOne,
                ownerMemberSymbolIndexPlusOne,
                ownerNameToken,
                ownerKind,
                ownerWhereToken,
                ownerEndToken,
                segmentStartToken,
                scan,
                paramOrdinal,
                typeOrdinal,
                comptimeOrdinal,
                appendedKind))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }

            if (appendedKind != TypedGenericParameterKind.Unknown)
            {
                paramOrdinal = (u32[0 max])(paramOrdinal + 1);
                if (appendedKind == TypedGenericParameterKind.Type)
                {
                    typeOrdinal = (u32[0 max])(typeOrdinal + 1);
                }
                else if (appendedKind == TypedGenericParameterKind.ComptimeValue)
                {
                    comptimeOrdinal = (u32[0 max])(comptimeOrdinal + 1);
                }
            }

            segmentStartToken = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedGenericsForDeclaration(
    mut borrow TypedGenericParameterSymbolTable symbols,
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    u64[0 2 ** 63 - 1] index)
{
    stack u32[0 max] ownerNameToken = declarations.NameTokenAt(index);
    if (ownerNameToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] genericOpenToken = (u32[0 max])(ownerNameToken + 1);
    if (stream.KindAt((u64[0 2 ** 63 - 1])genericOpenToken) != TokenKind.Lt)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    return AppendTypedGenericParametersFromList(
        symbols,
        source,
        stream,
        (u32[0 max])(index + 1),
        0,
        ownerNameToken,
        TypedGenericOwnerKind.Declaration,
        declarations.KeywordTokenAt(index),
        genericOpenToken);
}

internal fn System.Memory.MemoryStatus AppendTypedGenericsForMemberMethod(
    mut borrow TypedGenericParameterSymbolTable symbols,
    ascii source,
    borrow TokenStream stream,
    borrow TypedMemberSymbolTable members,
    u64[0 2 ** 63 - 1] index)
{
    stack u32[0 max] ownerNameToken = members.NameTokenAt(index);
    if (ownerNameToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] genericOpenToken = (u32[0 max])(ownerNameToken + 1);
    if (stream.KindAt((u64[0 2 ** 63 - 1])genericOpenToken) != TokenKind.Lt)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    return AppendTypedGenericParametersFromList(
        symbols,
        source,
        stream,
        members.OwnerDeclarationSymbolIndexPlusOneAt(index),
        (u32[0 max])(index + 1),
        ownerNameToken,
        TypedGenericOwnerKind.MemberMethod,
        members.KeywordTokenAt(index),
        genericOpenToken);
}

public fn BindResult<TypedGenericParameterSymbolTable> BuildTypedGenericParameterSymbols(
    ascii source,
    borrow TokenStream stream,
    borrow TypedDeclarationSymbolTable declarations,
    borrow TypedMemberSymbolTable members)
{
    stack mut TypedGenericParameterSymbolTable symbols = new();
    stack u64[0 2 ** 63 - 1] declarationCount = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < declarationCount; index += 1)
    {
        if (declarations.ClassAt(index) == TypedDeclarationSymbolClass.Type
            || declarations.ClassAt(index) == TypedDeclarationSymbolClass.Function)
        {
            switch (AppendTypedGenericsForDeclaration(symbols, source, stream, declarations, index))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return BindResult<TypedGenericParameterSymbolTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack u64[0 2 ** 63 - 1] memberCount = members.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < memberCount; index += 1)
    {
        if (members.KindAt(index) == TypedMemberSymbolKind.Method)
        {
            switch (AppendTypedGenericsForMemberMethod(symbols, source, stream, members, index))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return BindResult<TypedGenericParameterSymbolTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return BindResult<TypedGenericParameterSymbolTable>.Ok(symbols);
}

internal fn bool ModuleExistsWithOrigin(mut borrow ModuleResolver resolver, ascii name, ModuleOrigin origin)
{
    stack u64[0 2 ** 63 - 1] count = resolver.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (resolver.OriginAt(index) == origin && resolver.NameEqualsAt(index, name))
        {
            return true;
        }
    }

    return false;
}

public fn System.Memory.MemoryStatus AddSourceModule(
    mut borrow ModuleResolver resolver,
    ascii source,
    borrow TokenStream stream,
    borrow CompilationUnitHeader header,
    u32[0 max] sourceIndex,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] moduleIndex = FindModuleHeaderIndex(header);
    if (moduleIndex >= header.Count())
    {
        switch (diags.Append(BindDiagnosticCode.MissingModuleDeclaration, header.NextToken))
        {
            case System.Memory.MemoryStatus.Err(var diagError):
                return System.Memory.MemoryStatus.Err(diagError);
            case System.Memory.MemoryStatus.Ok:
        }

        return System.Memory.MemoryStatus.Ok;
    }

    stack HeaderItem moduleItem = header.ItemAt(moduleIndex);
    stack mut OwnedAscii name = new();
    switch (AppendHeaderDottedName(source, stream, moduleItem, name))
    {
        case System.Memory.MemoryStatus.Err(var nameError):
            return System.Memory.MemoryStatus.Err(nameError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack ascii moduleName = name.View();
    if (ModuleExistsWithOrigin(resolver, moduleName, ModuleOrigin.Source))
    {
        switch (diags.Append(BindDiagnosticCode.DuplicateModule, moduleItem.NameStart))
        {
            case System.Memory.MemoryStatus.Err(var duplicateError):
                return System.Memory.MemoryStatus.Err(duplicateError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return resolver.Append(name, ModuleOrigin.Source, sourceIndex);
}

public fn System.Memory.MemoryStatus AddPackageModule(
    mut borrow ModuleResolver resolver,
    ascii moduleName,
    u32[0 max] packageIndex,
    mut borrow BindDiagnosticList diags)
{
    stack mut OwnedAscii name = new();
    switch (System.Text.FromAscii(name, moduleName))
    {
        case System.Memory.MemoryStatus.Err(var copyError):
            return System.Memory.MemoryStatus.Err(copyError);
        case System.Memory.MemoryStatus.Ok:
    }

    if (ModuleExistsWithOrigin(resolver, moduleName, ModuleOrigin.Package))
    {
        switch (diags.Append(BindDiagnosticCode.DuplicateModule, 0))
        {
            case System.Memory.MemoryStatus.Err(var duplicateError):
                return System.Memory.MemoryStatus.Err(duplicateError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return resolver.Append(name, ModuleOrigin.Package, packageIndex);
}

internal fn ImportResolutionKind ResolveModuleName(mut borrow ModuleResolver resolver, ascii moduleName, out u32[0 max] targetIndex)
{
    targetIndex = 0;
    stack mut u32[0 max] sourceMatches = 0;
    stack mut u32[0 max] packageMatches = 0;
    stack mut u32[0 max] sourceTarget = 0;
    stack mut u32[0 max] packageTarget = 0;
    stack u64[0 2 ** 63 - 1] count = resolver.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (resolver.NameEqualsAt(index, moduleName))
        {
            stack ModuleOrigin origin = resolver.OriginAt(index);
            if (origin == ModuleOrigin.Source)
            {
                sourceMatches = (u32[0 max])(sourceMatches + 1);
                sourceTarget = resolver.OriginIndexAt(index);
            }
            else
            {
                packageMatches = (u32[0 max])(packageMatches + 1);
                packageTarget = resolver.OriginIndexAt(index);
            }
        }
    }

    if (sourceMatches == 1)
    {
        targetIndex = sourceTarget;
        return ImportResolutionKind.Source;
    }

    if (sourceMatches > 1)
    {
        return ImportResolutionKind.Ambiguous;
    }

    if (packageMatches == 1)
    {
        targetIndex = packageTarget;
        return ImportResolutionKind.Package;
    }

    if (packageMatches > 1)
    {
        return ImportResolutionKind.Ambiguous;
    }

    return ImportResolutionKind.Missing;
}

public fn System.Memory.MemoryStatus ResolveImports(
    mut borrow ModuleResolver resolver,
    ascii source,
    borrow TokenStream stream,
    borrow CompilationUnitHeader header,
    mut borrow ImportResolutionTable resolutions,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = header.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack HeaderItem item = header.ItemAt(index);
        if (item.Kind == SyntaxKind.ImportDeclaration)
        {
            stack mut OwnedAscii name = new();
            switch (AppendHeaderDottedName(source, stream, item, name))
            {
                case System.Memory.MemoryStatus.Err(var nameError):
                    return System.Memory.MemoryStatus.Err(nameError);
                case System.Memory.MemoryStatus.Ok:
            }

            stack mut u32[0 max] targetIndex = 0;
            stack ascii importName = name.View();
            stack ImportResolutionKind kind = ResolveModuleName(resolver, importName, targetIndex);
            switch (resolutions.Append(kind, item.NameStart, targetIndex))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }

            if (kind == ImportResolutionKind.Missing)
            {
                switch (diags.Append(BindDiagnosticCode.UnresolvedImport, item.NameStart))
                {
                    case System.Memory.MemoryStatus.Err(var missingError):
                        return System.Memory.MemoryStatus.Err(missingError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (kind == ImportResolutionKind.Ambiguous)
            {
                switch (diags.Append(BindDiagnosticCode.AmbiguousImport, item.NameStart))
                {
                    case System.Memory.MemoryStatus.Err(var ambiguousError):
                        return System.Memory.MemoryStatus.Err(ambiguousError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Collects a `DuplicateDeclaration` diagnostic (anchored at the later name) for
// every top-level declaration whose name repeats an earlier one.
internal fn System.Memory.MemoryStatus CollectDuplicateDeclarations(borrow DeclarationTable table, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] later = 0; later < count; later += 1)
    {
        stack ascii laterName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(later));
        stack mut bool repeats = false;
        for willexit (stack mut u64[0 2 ** 63 - 1] earlier = 0; earlier < later; earlier += 1)
        {
            stack ascii earlierName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(earlier));
            if (System.Text.Equals(earlierName, laterName))
            {
                repeats = true;
            }
        }

        if (repeats)
        {
            switch (diags.Append(BindDiagnosticCode.DuplicateDeclaration, table.NameTokenAt(later)))
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal finite law bool TokenTextEquals(ascii source, borrow TokenStream stream, u32[0 max] token, ascii expected)
{
    return System.Text.Equals(Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token), expected);
}

internal finite law u32[0 max] AttributeEndToken(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return start;
        }

        if (kind == TokenKind.LBrack)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            if (depth == 0)
            {
                return index;
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return start;
}

internal finite law bool DeclarationPreludeHasToken(borrow TokenStream stream, DeclItem item, TokenKind tokenKind)
{
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == tokenKind)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool IsLinkNameDeclarationTarget(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind != DeclarationKind.Function)
    {
        return false;
    }

    if (!DeclarationPreludeHasToken(stream, item, TokenKind.Ffi))
    {
        return false;
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Asm))
    {
        return false;
    }

    return stream.KindAt((u64[0 2 ** 63 - 1])item.EndToken) == TokenKind.Semi;
}

internal finite law bool IsLinkNameAttribute(ascii source, borrow TokenStream stream, u32[0 max] attrStart)
{
    return stream.KindAt((u64[0 2 ** 63 - 1])(attrStart + 1)) == TokenKind.Identifier
        && TokenTextEquals(source, stream, (u32[0 max])(attrStart + 1), "LinkName");
}

internal finite law u32[0 max] LinkNameValueToken(borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd)
{
    if (attrEnd == (u32[0 max])(attrStart + 5)
        && stream.KindAt((u64[0 2 ** 63 - 1])(attrStart + 2)) == TokenKind.LParen
        && stream.KindAt((u64[0 2 ** 63 - 1])(attrStart + 3)) == TokenKind.StringLiteral
        && stream.KindAt((u64[0 2 ** 63 - 1])(attrStart + 4)) == TokenKind.RParen)
    {
        return (u32[0 max])(attrStart + 3);
    }

    return 0;
}

internal finite law bool StringLiteralHasNonEmptyPayload(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    stack ascii literal = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token);
    return System.Text.AsciiLength(literal) > 2;
}

internal finite law bool LinkNameAttributeIsWellFormed(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd)
{
    stack u32[0 max] valueToken = LinkNameValueToken(stream, attrStart, attrEnd);
    return valueToken != 0 && StringLiteralHasNonEmptyPayload(source, stream, valueToken);
}

internal fn System.Memory.MemoryStatus CollectLinkNameDiagnostics(borrow DeclarationList decls, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] declIndex = 0; declIndex < count; declIndex += 1)
    {
        stack DeclItem item = decls.ItemAt(declIndex);
        stack mut u32[0 max] scan = item.StartToken;
        stack mut u32[0 max] linkNameCount = 0;
        while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
        {
            stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
            if (attrEnd <= scan)
            {
                return System.Memory.MemoryStatus.Ok;
            }

            if (IsLinkNameAttribute(source, stream, scan))
            {
                linkNameCount = (u32[0 max])(linkNameCount + 1);
                if (linkNameCount > 1)
                {
                    switch (diags.Append(BindDiagnosticCode.DuplicateLinkName, (u32[0 max])(scan + 1)))
                    {
                        case System.Memory.MemoryStatus.Err(var duplicateError):
                            return System.Memory.MemoryStatus.Err(duplicateError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                if (!IsLinkNameDeclarationTarget(stream, item)
                    || !LinkNameAttributeIsWellFormed(source, stream, scan, attrEnd))
                {
                    switch (diags.Append(BindDiagnosticCode.InvalidLinkName, (u32[0 max])(scan + 1)))
                    {
                        case System.Memory.MemoryStatus.Err(var invalidError):
                            return System.Memory.MemoryStatus.Err(invalidError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }

            scan = (u32[0 max])(attrEnd + 1);
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

public enum CAbiAggregateBoundaryKind
{
    Return,
    Parameter,
}

public struct CLayoutAggregateTable
{
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] KeywordTokens;
    internal dynamic CAbiAggregateCarrierFacts Facts;

    CLayoutAggregateTable()
    {
        self.NameTokens = new();
        self.KeywordTokens = new();
        self.Facts = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow CLayoutAggregateTable self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] NameTokenAt(borrow CLayoutAggregateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law u32[0 max] KeywordTokenAt(borrow CLayoutAggregateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.KeywordTokens.Length)
        {
            token = self.KeywordTokens[index];
        }

        return token;
    }

    public law CAbiAggregateCarrierFacts FactsAt(borrow CLayoutAggregateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut CAbiAggregateCarrierFacts facts = new();
        if (index < self.Facts.Length)
        {
            facts = self.Facts[index];
        }

        return facts;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow CLayoutAggregateTable self, u32[0 max] nameToken, u32[0 max] keywordToken, CAbiAggregateCarrierFacts facts)
    {
        if (!self.NameTokens.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.Facts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.KeywordTokens[self.KeywordTokens.Length] = keywordToken;
        init self.Facts[self.Facts.Length] = facts;
        return System.Memory.MemoryStatus.Ok;
    }
}

public struct CAbiAggregateBoundaryTable
{
    internal dynamic CAbiAggregateBoundaryKind Kinds;
    internal dynamic u32[0 max] FunctionNameTokens;
    internal dynamic u32[0 max] TypeNameTokens;
    internal dynamic u32[0 max] ParamIndices;
    internal dynamic CAbiAggregateCarrierFacts Facts;

    CAbiAggregateBoundaryTable()
    {
        self.Kinds = new();
        self.FunctionNameTokens = new();
        self.TypeNameTokens = new();
        self.ParamIndices = new();
        self.Facts = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow CAbiAggregateBoundaryTable self)
    {
        return self.Kinds.Length;
    }

    public law CAbiAggregateBoundaryKind KindAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut CAbiAggregateBoundaryKind kind = CAbiAggregateBoundaryKind.Return;
        if (index < self.Kinds.Length)
        {
            kind = self.Kinds[index];
        }

        return kind;
    }

    public law u32[0 max] FunctionNameTokenAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.FunctionNameTokens.Length)
        {
            token = self.FunctionNameTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeNameTokenAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeNameTokens.Length)
        {
            token = self.TypeNameTokens[index];
        }

        return token;
    }

    public law u32[0 max] ParamIndexAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] paramIndex = 0;
        if (index < self.ParamIndices.Length)
        {
            paramIndex = self.ParamIndices[index];
        }

        return paramIndex;
    }

    public law CAbiAggregateCarrierFacts FactsAt(borrow CAbiAggregateBoundaryTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut CAbiAggregateCarrierFacts facts = new();
        if (index < self.Facts.Length)
        {
            facts = self.Facts[index];
        }

        return facts;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow CAbiAggregateBoundaryTable self,
        CAbiAggregateBoundaryKind kind,
        u32[0 max] functionNameToken,
        u32[0 max] typeNameToken,
        u32[0 max] paramIndex,
        CAbiAggregateCarrierFacts facts)
    {
        if (!self.Kinds.TryReserve(1)
            || !self.FunctionNameTokens.TryReserve(1)
            || !self.TypeNameTokens.TryReserve(1)
            || !self.ParamIndices.TryReserve(1)
            || !self.Facts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Kinds[self.Kinds.Length] = kind;
        init self.FunctionNameTokens[self.FunctionNameTokens.Length] = functionNameToken;
        init self.TypeNameTokens[self.TypeNameTokens.Length] = typeNameToken;
        init self.ParamIndices[self.ParamIndices.Length] = paramIndex;
        init self.Facts[self.Facts.Length] = facts;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal enum CAbiStorageKind
{
    Unknown,
    Integer,
    Sse,
}

internal struct CAbiFieldInfo
{
    bool Known;
    u32[0 max] SizeBytes;
    u32[0 max] AlignBytes;
    CAbiStorageKind Kind;

    CAbiFieldInfo()
    {
        self.Known = false;
        self.SizeBytes = 0;
        self.AlignBytes = 0;
        self.Kind = CAbiStorageKind.Unknown;
    }
}

internal struct CAbiStorageUnitList
{
    internal dynamic u32[0 max] Offsets;
    internal dynamic u32[0 max] Sizes;
    internal dynamic CAbiStorageKind Kinds;

    CAbiStorageUnitList()
    {
        self.Offsets = new();
        self.Sizes = new();
        self.Kinds = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow CAbiStorageUnitList self)
    {
        return self.Offsets.Length;
    }

    internal law u32[0 max] OffsetAt(borrow CAbiStorageUnitList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] offset = 0;
        if (index < self.Offsets.Length)
        {
            offset = self.Offsets[index];
        }

        return offset;
    }

    internal law u32[0 max] SizeAt(borrow CAbiStorageUnitList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] size = 0;
        if (index < self.Sizes.Length)
        {
            size = self.Sizes[index];
        }

        return size;
    }

    internal law CAbiStorageKind KindAt(borrow CAbiStorageUnitList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut CAbiStorageKind kind = CAbiStorageKind.Unknown;
        if (index < self.Kinds.Length)
        {
            kind = self.Kinds[index];
        }

        return kind;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow CAbiStorageUnitList self, u32[0 max] offset, u32[0 max] size, CAbiStorageKind kind)
    {
        if (!self.Offsets.TryReserve(1)
            || !self.Sizes.TryReserve(1)
            || !self.Kinds.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Offsets[self.Offsets.Length] = offset;
        init self.Sizes[self.Sizes.Length] = size;
        init self.Kinds[self.Kinds.Length] = kind;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal finite law bool AttributeListContainsStructLayoutC(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd)
{
    stack mut u32[0 max] scan = (u32[0 max])(attrStart + 1);
    while willexit (scan < attrEnd)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Identifier
            && TokenTextEquals(source, stream, scan, "StructLayout")
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 2)) == TokenKind.Identifier
            && TokenTextEquals(source, stream, (u32[0 max])(scan + 2), "C")
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 3)) == TokenKind.RParen)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool DeclarationHasStructLayoutCAttribute(ascii source, borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return false;
        }

        if (AttributeListContainsStructLayoutC(source, stream, scan, attrEnd))
        {
            return true;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return false;
}

internal finite law bool FfiAbiNameIsCFamily(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    return TokenTextEquals(source, stream, token, "c")
        || TokenTextEquals(source, stream, token, "cdecl")
        || TokenTextEquals(source, stream, token, "sysv")
        || TokenTextEquals(source, stream, token, "win64");
}

internal finite law bool IsCAbiFfiFunction(ascii source, borrow TokenStream stream, DeclItem item)
{
    if (item.Kind != DeclarationKind.Function || DeclarationPreludeHasToken(stream, item, TokenKind.Asm))
    {
        return false;
    }

    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Ffi)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
            {
                return stream.KindAt((u64[0 2 ** 63 - 1])(scan + 2)) == TokenKind.Identifier
                    && FfiAbiNameIsCFamily(source, stream, (u32[0 max])(scan + 2));
            }

            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law u32[0 max] AlignUp(u32[0 max] value, u32[0 max] alignment)
{
    if (alignment <= 1)
    {
        return value;
    }

    stack u32[0 max] remainder = value % alignment;
    if (remainder == 0)
    {
        return value;
    }

    return (u32[0 max])(value + alignment - remainder);
}

internal finite law CAbiFieldInfo KnownCAbiField(u32[0 max] sizeBytes, u32[0 max] alignBytes, CAbiStorageKind kind)
{
    stack mut CAbiFieldInfo info = new();
    info.Known = true;
    info.SizeBytes = sizeBytes;
    info.AlignBytes = alignBytes;
    info.Kind = kind;
    return info;
}

internal finite law CAbiFieldInfo ClassifyCAbiScalarField(ascii source, borrow TokenStream stream, u32[0 max] typeToken)
{
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    if (kind == TokenKind.Bool)
    {
        return KnownCAbiField(1, 1, CAbiStorageKind.Integer);
    }

    if (kind == TokenKind.Rawptr || kind == TokenKind.Rawmutptr || kind == TokenKind.Fnptr)
    {
        return KnownCAbiField(8, 8, CAbiStorageKind.Integer);
    }

    if (kind == TokenKind.FloatType)
    {
        if (TokenTextEquals(source, stream, typeToken, "f32"))
        {
            return KnownCAbiField(4, 4, CAbiStorageKind.Sse);
        }

        if (TokenTextEquals(source, stream, typeToken, "f64"))
        {
            return KnownCAbiField(8, 8, CAbiStorageKind.Sse);
        }
    }

    if (kind == TokenKind.IntegerType)
    {
        if (TokenTextEquals(source, stream, typeToken, "i8") || TokenTextEquals(source, stream, typeToken, "u8"))
        {
            return KnownCAbiField(1, 1, CAbiStorageKind.Integer);
        }

        if (TokenTextEquals(source, stream, typeToken, "i16") || TokenTextEquals(source, stream, typeToken, "u16"))
        {
            return KnownCAbiField(2, 2, CAbiStorageKind.Integer);
        }

        if (TokenTextEquals(source, stream, typeToken, "i32") || TokenTextEquals(source, stream, typeToken, "u32"))
        {
            return KnownCAbiField(4, 4, CAbiStorageKind.Integer);
        }

        if (TokenTextEquals(source, stream, typeToken, "i64") || TokenTextEquals(source, stream, typeToken, "u64"))
        {
            return KnownCAbiField(8, 8, CAbiStorageKind.Integer);
        }
    }

    stack mut CAbiFieldInfo unknown = new();
    return unknown;
}

internal finite law AbiCarrierKind IntegerCarrierForSize(u32[0 max] sizeBytes)
{
    if (sizeBytes <= 1)
    {
        return AbiCarrierKind.I8;
    }

    if (sizeBytes <= 2)
    {
        return AbiCarrierKind.I16;
    }

    if (sizeBytes <= 4)
    {
        return AbiCarrierKind.I32;
    }

    if (sizeBytes <= 8)
    {
        return AbiCarrierKind.I64;
    }

    return AbiCarrierKind.None;
}

internal finite law AbiCarrierKind SlotCarrierForUnits(borrow CAbiStorageUnitList units, u32[0 max] slotStart, u32[0 max] slotSize)
{
    stack mut bool any = false;
    stack mut bool anyInteger = false;
    stack mut u32[0 max] sseCount = 0;
    stack mut u32[0 max] firstOffset = 0;
    stack mut u32[0 max] firstSize = 0;
    stack mut u32[0 max] secondOffset = 0;
    stack mut u32[0 max] secondSize = 0;
    stack u32[0 max] slotEnd = (u32[0 max])(slotStart + slotSize);
    stack u64[0 2 ** 63 - 1] count = units.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack u32[0 max] unitOffset = units.OffsetAt(index);
        stack u32[0 max] unitSize = units.SizeAt(index);
        stack u32[0 max] unitEnd = (u32[0 max])(unitOffset + unitSize);
        if (unitOffset < slotEnd && unitEnd > slotStart)
        {
            any = true;
            if (unitOffset < slotStart || unitEnd > slotEnd)
            {
                return AbiCarrierKind.None;
            }

            if (units.KindAt(index) == CAbiStorageKind.Integer)
            {
                anyInteger = true;
            }
            else if (units.KindAt(index) == CAbiStorageKind.Sse)
            {
                if (sseCount == 0)
                {
                    firstOffset = unitOffset;
                    firstSize = unitSize;
                }
                else if (sseCount == 1)
                {
                    secondOffset = unitOffset;
                    secondSize = unitSize;
                }

                sseCount = (u32[0 max])(sseCount + 1);
            }
        }
    }

    if (!any || anyInteger)
    {
        return IntegerCarrierForSize(slotSize);
    }

    if (sseCount == 1)
    {
        if (firstOffset == slotStart && firstSize == 4)
        {
            return AbiCarrierKind.F32;
        }

        if (firstOffset == slotStart && firstSize == 8)
        {
            return AbiCarrierKind.F64;
        }
    }

    if (sseCount == 2
        && firstOffset == slotStart
        && secondOffset == (u32[0 max])(slotStart + 4)
        && firstSize == 4
        && secondSize == 4)
    {
        return AbiCarrierKind.Vector2F32;
    }

    return AbiCarrierKind.None;
}

internal fn System.Memory.MemoryStatus ClassifyCLayoutAggregate(ascii source, borrow TokenStream stream, u32[0 max] structKeyword, mut borrow CAbiAggregateCarrierFacts facts)
{
    stack mut FieldList fields = new();
    switch (ParseStructFields(stream, structKeyword))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            facts.SetUnsupported();
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<FieldList>.Ok(var parsed):
            fields = parsed;
    }

    stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
    if (fieldCount == 0)
    {
        facts.SetUnsupported();
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut CAbiStorageUnitList units = new();
    stack mut u32[0 max] offset = 0;
    stack mut u32[0 max] maxAlign = 1;
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < fieldCount; index += 1)
    {
        stack CAbiFieldInfo info = ClassifyCAbiScalarField(source, stream, fields.TypePrimaryAt(index));
        if (!info.Known)
        {
            facts.SetUnsupported();
            return System.Memory.MemoryStatus.Ok;
        }

        offset = AlignUp(offset, info.AlignBytes);
        if (info.AlignBytes > maxAlign)
        {
            maxAlign = info.AlignBytes;
        }

        switch (units.Append(offset, info.SizeBytes, info.Kind))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }

        offset = (u32[0 max])(offset + info.SizeBytes);
    }

    stack u32[0 max] sizeBytes = AlignUp(offset, maxAlign);
    if (sizeBytes == 0)
    {
        facts.SetUnsupported();
        return System.Memory.MemoryStatus.Ok;
    }

    if (sizeBytes > 16)
    {
        facts.SetIndirect(sizeBytes, maxAlign);
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] carrierCount = 0;
    stack mut AbiCarrierKind carrier0 = AbiCarrierKind.None;
    stack mut AbiCarrierKind carrier1 = AbiCarrierKind.None;
    stack mut AbiCarrierKind carrier2 = AbiCarrierKind.None;
    stack mut AbiCarrierKind carrier3 = AbiCarrierKind.None;
    stack mut u32[0 max] slotStart = 0;
    while willexit (slotStart < sizeBytes)
    {
        stack mut u32[0 max] slotSize = 8;
        if ((u32[0 max])(sizeBytes - slotStart) < 8)
        {
            slotSize = (u32[0 max])(sizeBytes - slotStart);
        }

        stack AbiCarrierKind carrier = SlotCarrierForUnits(units, slotStart, slotSize);
        if (carrier == AbiCarrierKind.None)
        {
            facts.SetUnsupported();
            return System.Memory.MemoryStatus.Ok;
        }

        switch (carrierCount)
        {
            case 0:
                carrier0 = carrier;
            case 1:
                carrier1 = carrier;
            case 2:
                carrier2 = carrier;
            case 3:
                carrier3 = carrier;
            default:
                facts.SetUnsupported();
                return System.Memory.MemoryStatus.Ok;
        }

        carrierCount = (u32[0 max])(carrierCount + 1);
        slotStart = (u32[0 max])(slotStart + 8);
    }

    facts.SetDirect(sizeBytes, maxAlign, carrierCount, carrier0, carrier1, carrier2, carrier3);
    return System.Memory.MemoryStatus.Ok;
}

public fn BindResult<CLayoutAggregateTable> BuildCLayoutAggregateTable(ascii source, borrow TokenStream stream, borrow DeclarationList decls)
{
    stack mut CLayoutAggregateTable table = new();
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if ((item.Kind == DeclarationKind.Struct || item.Kind == DeclarationKind.Record)
            && item.NameToken != 0
            && DeclarationHasStructLayoutCAttribute(source, stream, item))
        {
            stack mut CAbiAggregateCarrierFacts facts = new();
            switch (ClassifyCLayoutAggregate(source, stream, item.KeywordToken, facts))
            {
                case System.Memory.MemoryStatus.Err(var classifyError):
                    return BindResult<CLayoutAggregateTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (table.Append(item.NameToken, item.KeywordToken, facts))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return BindResult<CLayoutAggregateTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return BindResult<CLayoutAggregateTable>.Ok(table);
}

internal fn u32[0 max] LookupCLayoutAggregateByTypeToken(borrow CLayoutAggregateTable table, ascii source, borrow TokenStream stream, u32[0 max] typeToken)
{
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, table.NameTokenAt(index), typeToken))
        {
            return (u32[0 max])(index + 1);
        }
    }

    return 0;
}

public fn BindResult<CAbiAggregateBoundaryTable> BuildCAbiAggregateBoundaryTable(ascii source, borrow TokenStream stream, borrow DeclarationList decls)
{
    stack mut CAbiAggregateBoundaryTable boundaries = new();
    stack mut CLayoutAggregateTable aggregates = new();
    switch (BuildCLayoutAggregateTable(source, stream, decls))
    {
        case BindResult<CLayoutAggregateTable>.Err(var aggregateError):
            return BindResult<CAbiAggregateBoundaryTable>.Err(BindError.OutOfMemory);
        case BindResult<CLayoutAggregateTable>.Ok(var table):
            aggregates = table;
    }

    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (IsCAbiFfiFunction(source, stream, item))
        {
            stack mut FunctionSignature signature = new();
            stack mut bool parsedSignature = false;
            switch (ParseFunctionSignature(stream, item.KeywordToken))
            {
                case ParseResult<FunctionSignature>.Err(var sigError):
                    parsedSignature = false;
                case ParseResult<FunctionSignature>.Ok(var parsed):
                    signature = parsed;
                    parsedSignature = true;
            }

            if (parsedSignature)
            {
                stack u32[0 max] returnHead = signature.ReturnType();
                stack u32[0 max] returnAggregate = LookupCLayoutAggregateByTypeToken(aggregates, source, stream, returnHead);
                if (returnAggregate != 0)
                {
                    stack CAbiAggregateCarrierFacts returnFacts = aggregates.FactsAt((u64[0 2 ** 63 - 1])(returnAggregate - 1));
                    switch (boundaries.Append(CAbiAggregateBoundaryKind.Return, signature.Name(), returnHead, 0, returnFacts))
                    {
                        case System.Memory.MemoryStatus.Err(var returnAppendError):
                            return BindResult<CAbiAggregateBoundaryTable>.Err(BindError.OutOfMemory);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
                for willexit (stack mut u64[0 2 ** 63 - 1] p = 0; p < paramCount; p += 1)
                {
                    stack u32[0 max] paramHead = signature.ParamTypeAt(p);
                    stack u32[0 max] paramAggregate = LookupCLayoutAggregateByTypeToken(aggregates, source, stream, paramHead);
                    if (paramAggregate != 0)
                    {
                        stack CAbiAggregateCarrierFacts paramFacts = aggregates.FactsAt((u64[0 2 ** 63 - 1])(paramAggregate - 1));
                        switch (boundaries.Append(CAbiAggregateBoundaryKind.Parameter, signature.Name(), paramHead, (u32[0 max])p, paramFacts))
                        {
                            case System.Memory.MemoryStatus.Err(var paramAppendError):
                                return BindResult<CAbiAggregateBoundaryTable>.Err(BindError.OutOfMemory);
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }
                }
            }
        }
    }

    return BindResult<CAbiAggregateBoundaryTable>.Ok(boundaries);
}

// Emits a `DuplicateEnumVariant` diagnostic (anchored at the later variant name)
// for every enum variant whose name repeats an earlier one in the same enum —
// matching the host's STK3006 "declares variant 'V' more than once".
internal fn System.Memory.MemoryStatus CollectDuplicateEnumVariants(borrow VariantList variants, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = variants.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] later = 0; later < count; later += 1)
    {
        stack ascii laterName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])variants.NameTokenAt(later));
        stack mut bool repeats = false;
        for willexit (stack mut u64[0 2 ** 63 - 1] earlier = 0; earlier < later; earlier += 1)
        {
            stack ascii earlierName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])variants.NameTokenAt(earlier));
            if (System.Text.Equals(earlierName, laterName))
            {
                repeats = true;
            }
        }

        if (repeats)
        {
            switch (diags.Append(BindDiagnosticCode.DuplicateEnumVariant, variants.NameTokenAt(later)))
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// The declared type-primary token of the parameter/local that the reference at
// expression node `node` resolves to, read from the lexical `ReferenceTable`
// (which already honors shadowing and block scope). 0 when the node is not a
// reference to a scope symbol (a declaration/unbound reference has no scope type).
internal fn u32[0 max] ReferenceTypeTokenForNode(borrow ReferenceTable refs, borrow FunctionScope scope, u32[0 max] node)
{
    stack mut u32[0 max] typeToken = 0;
    stack u64[0 2 ** 63 - 1] count = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (refs.NodeAt(index) == node)
        {
            stack ReferenceKind kind = refs.KindAt(index);
            if (kind == ReferenceKind.Parameter || kind == ReferenceKind.Local)
            {
                stack u32[0 max] target = refs.TargetAt(index);
                if (target != 0)
                {
                    typeToken = scope.TypeTokenAt((u64[0 2 ** 63 - 1])(target - 1));
                }
            }
        }
    }

    return typeToken;
}

// The definition name token of the struct/record declaration named by
// `structNameToken` (matched by source text in the declaration table), or 0 when no
// such declaration exists. `ParseStructFields` can be driven from this name token
// (it scans forward to the struct's body `{`). Source-derived name slices are
// compared inline with `System.Text.Equals` (overlap-permitting).
internal fn u32[0 max] FindStructDefName(borrow DeclarationTable table, ascii source, borrow TokenStream stream, u32[0 max] structNameToken)
{
    if (structNameToken == 0)
    {
        return 0;
    }

    stack ascii structName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])structNameToken);
    stack mut u32[0 max] structDefName = 0;
    stack u64[0 2 ** 63 - 1] tableCount = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] t = 0; t < tableCount; t += 1)
    {
        stack ascii declName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(t));
        if (System.Text.Equals(declName, structName))
        {
            structDefName = table.NameTokenAt(t);
        }
    }

    return structDefName;
}

// The type-primary token of the data field named `fieldNameToken` of the struct/
// record named `structNameToken` (e.g. the `i32` in `struct S { i32 count; }`), or 0
// when not found — for value typing via `MapTypeToken`.
internal fn u32[0 max] StructFieldTypePrimary(borrow DeclarationTable table, ascii source, borrow TokenStream stream, u32[0 max] structNameToken, u32[0 max] fieldNameToken)
{
    stack u32[0 max] structDefName = FindStructDefName(table, source, stream, structNameToken);
    if (structDefName == 0 || fieldNameToken == 0)
    {
        return 0;
    }

    stack ascii fieldName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fieldNameToken);
    stack mut u32[0 max] primary = 0;
    switch (ParseStructFields(stream, structDefName))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return 0;
        case ParseResult<FieldList>.Ok(var fields):
            stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] f = 0; f < fieldCount; f += 1)
            {
                stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(f));
                if (System.Text.Equals(name, fieldName))
                {
                    primary = fields.TypePrimaryAt(f);
                }
            }
    }

    return primary;
}

// The user-type HEAD token of the data field named `fieldNameToken` of the struct
// named `structNameToken` (the field's own struct/record type name, e.g. `B` for a
// field `B b;`), or 0 when not found or the field type is a built-in. Used to chain
// member access — the head names the struct whose fields the next `.member` reads.
internal fn u32[0 max] StructFieldTypeHead(borrow DeclarationTable table, ascii source, borrow TokenStream stream, u32[0 max] structNameToken, u32[0 max] fieldNameToken)
{
    stack u32[0 max] structDefName = FindStructDefName(table, source, stream, structNameToken);
    if (structDefName == 0 || fieldNameToken == 0)
    {
        return 0;
    }

    stack ascii fieldName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fieldNameToken);
    stack mut u32[0 max] head = 0;
    switch (ParseStructFields(stream, structDefName))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return 0;
        case ParseResult<FieldList>.Ok(var fields):
            stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] f = 0; f < fieldCount; f += 1)
            {
                stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(f));
                if (System.Text.Equals(name, fieldName))
                {
                    head = fields.TypeHeadAt(f);
                }
            }
    }

    return head;
}

// The struct/record type-name token that expression `node` evaluates to, when it is
// a chain of identifier and member accesses over struct-typed values (e.g. `a` whose
// type is `A`, or `a.b` whose field `b` has type `B`): an identifier yields its
// declared type token; a `receiver.field` member yields the field's user-type head,
// resolved against the receiver's struct (recursively). 0 when the node is not such a
// chain or its type is not a known struct. Each recursion peels one `.member`, so it
// terminates on the finite expression chain.
internal fn u32[0 max] MemberStructNameToken(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, u32[0 max] node)
{
    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        return ReferenceTypeTokenForNode(refs, scope, node);
    }
    else if (kind == Compiler.Parsing.ExprKind.Member)
    {
        stack u32[0 max] receiverStruct = MemberStructNameToken(table, source, refs, scope, stream, body, body.ExprLeftAt(node));
        return StructFieldTypeHead(table, source, stream, receiverStruct, body.ExprTokenAt(node));
    }

    return 0;
}

// The type of expression node `node` in `body`: its shape type from
// `ClassifyExprType`, but when that is `Unknown`, the declared type of what the
// node resolves to: for an identifier, the symbol it lexically resolves to (via the
// reference table, respecting shadowing); for a member access `receiver.field` whose
// receiver is a struct/record-typed identifier, the field's declared type (looked up
// in that struct's declaration). This types `n` (an integer local) and `s.count`
// (an `i32` field) as `Int`.
internal fn ExprType TypedNodeType(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, u32[0 max] node)
{
    stack mut ExprType nodeType = ClassifyExprType(stream, body, node);
    if (nodeType == Compiler.Typing.ExprType.Unknown)
    {
        stack ExprKind kind = body.ExprKindAt(node);
        if (kind == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] typeToken = ReferenceTypeTokenForNode(refs, scope, node);
            if (typeToken != 0)
            {
                nodeType = MapTypeToken(stream, typeToken);
            }
        }
        else if (kind == Compiler.Parsing.ExprKind.Member)
        {
            // `receiver.field`: when the receiver resolves to a struct/record (an
            // identifier or a further member chain), type the access as the named
            // field's declared type.
            stack u32[0 max] structNameToken = MemberStructNameToken(table, source, refs, scope, stream, body, body.ExprLeftAt(node));
            stack u32[0 max] fieldPrimary = StructFieldTypePrimary(table, source, stream, structNameToken, body.ExprTokenAt(node));
            if (fieldPrimary != 0)
            {
                nodeType = MapTypeToken(stream, fieldPrimary);
            }
        }
    }

    return nodeType;
}

// Emits a `NonBooleanCondition` diagnostic (anchored at the condition's root
// token) for each `if`/`while`/`for` whose condition has a definite non-boolean
// type. A `for`'s condition is its statement expression (the middle clause), so
// references to its header-bound loop variable resolve in the loop scope.
internal fn System.Memory.MemoryStatus CollectNonBooleanConditions(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        if (item.Kind == StatementKind.If || item.Kind == StatementKind.While || item.Kind == StatementKind.For)
        {
            stack u32[0 max] root = body.ExprRootAt(index);
            if (root != 0)
            {
                stack ExprType conditionType = TypedNodeType(table, source, refs, scope, stream, body, root);
                if (IsDefiniteNonBoolean(conditionType))
                {
                    switch (diags.Append(BindDiagnosticCode.NonBooleanCondition, body.ExprTokenAt(root)))
                    {
                        case System.Memory.MemoryStatus.Err(var condError):
                            return System.Memory.MemoryStatus.Err(condError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Emits a `NonBooleanOperand` diagnostic for each operand of a logical operator
// (`&&`, `||`, `!`) whose type is a definite non-boolean — the host requires
// boolean operands for these — and a `NonBooleanCondition` for a ternary
// `cond ? a : b` whose `cond` is a definite non-boolean (the host requires a
// boolean conditional condition). Walks every node of the body's shared
// expression tree; each diagnostic is anchored at the offending sub-expression.
internal fn System.Memory.MemoryStatus CollectExpressionTypeErrors(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < nodeCount; index += 1)
    {
        stack u32[0 max] node = (u32[0 max])(index + 1);
        stack ExprKind nodeKind = body.ExprKindAt(node);
        if (nodeKind == Compiler.Parsing.ExprKind.Binary)
        {
            stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(node));
            if (op == TokenKind.AndAnd || op == TokenKind.OrOr)
            {
                switch (CheckBooleanOperand(table, source, refs, scope, stream, body, body.ExprLeftAt(node), diags))
                {
                    case System.Memory.MemoryStatus.Err(var leftError):
                        return System.Memory.MemoryStatus.Err(leftError);
                    case System.Memory.MemoryStatus.Ok:
                }

                switch (CheckBooleanOperand(table, source, refs, scope, stream, body, body.ExprRightAt(node), diags))
                {
                    case System.Memory.MemoryStatus.Err(var rightError):
                        return System.Memory.MemoryStatus.Err(rightError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
        else if (nodeKind == Compiler.Parsing.ExprKind.Unary)
        {
            stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(node));
            if (op == TokenKind.Bang)
            {
                switch (CheckBooleanOperand(table, source, refs, scope, stream, body, body.ExprLeftAt(node), diags))
                {
                    case System.Memory.MemoryStatus.Err(var unaryError):
                        return System.Memory.MemoryStatus.Err(unaryError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
        else if (nodeKind == Compiler.Parsing.ExprKind.Conditional)
        {
            stack u32[0 max] conditionNode = body.ExprLeftAt(node);
            if (conditionNode != 0)
            {
                stack ExprType conditionType = TypedNodeType(table, source, refs, scope, stream, body, conditionNode);
                if (IsDefiniteNonBoolean(conditionType))
                {
                    switch (diags.Append(BindDiagnosticCode.NonBooleanCondition, body.ExprTokenAt(conditionNode)))
                    {
                        case System.Memory.MemoryStatus.Err(var ternaryError):
                            return System.Memory.MemoryStatus.Err(ternaryError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Emits a `NonBooleanOperand` diagnostic when `operand`'s type is a definite
// non-boolean (anchored at the operand's token).
internal fn System.Memory.MemoryStatus CheckBooleanOperand(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, u32[0 max] operand, mut borrow BindDiagnosticList diags)
{
    if (operand == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack ExprType operandType = TypedNodeType(table, source, refs, scope, stream, body, operand);
    if (IsDefiniteNonBoolean(operandType))
    {
        switch (diags.Append(BindDiagnosticCode.NonBooleanOperand, body.ExprTokenAt(operand)))
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// The 1-based index of the reference-table entry for expression `node`, or 0
// when the node is not an identifier reference.
internal fn u32[0 max] ReferenceIndexForNode(borrow ReferenceTable refs, u32[0 max] node)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0 && refs.NodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn bool TokenTextEqualsToken(ascii source, borrow TokenStream stream, u32[0 max] left, u32[0 max] right)
{
    if (left == 0 || right == 0)
    {
        return false;
    }

    stack ascii leftText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])left);
    stack ascii rightText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])right);
    return System.Text.Equals(leftText, rightText);
}

internal finite law bool IsDeadOnReturnContractToken(borrow TokenStream stream, u32[0 max] token)
{
    return stream.ContextualKindAt((u64[0 2 ** 63 - 1])token) == ContextualKeywordKind.DeadOnReturn;
}

internal fn bool TryReadSyntheticArgumentIndex(ascii source, borrow TokenStream stream, u32[0 max] token, out u32[0 max] index)
{
    index = 0;
    stack ascii text = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token);
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength < 4)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])signedLength;
    if (!System.Text.Equals(text[0, 3], "arg"))
    {
        return false;
    }

    stack mut u32[0 max] value = 0;
    for willexit (stack mut u64[0 2 ** 63 - 1] pos = 3; pos < length; pos += 1)
    {
        stack ascii unit = text[pos, 1];
        stack mut bool isDigit = true;
        stack mut u32[0 max] digit = 0;
        if (System.Text.Equals(unit, "0"))
        {
            digit = 0;
        }
        else if (System.Text.Equals(unit, "1"))
        {
            digit = 1;
        }
        else if (System.Text.Equals(unit, "2"))
        {
            digit = 2;
        }
        else if (System.Text.Equals(unit, "3"))
        {
            digit = 3;
        }
        else if (System.Text.Equals(unit, "4"))
        {
            digit = 4;
        }
        else if (System.Text.Equals(unit, "5"))
        {
            digit = 5;
        }
        else if (System.Text.Equals(unit, "6"))
        {
            digit = 6;
        }
        else if (System.Text.Equals(unit, "7"))
        {
            digit = 7;
        }
        else if (System.Text.Equals(unit, "8"))
        {
            digit = 8;
        }
        else if (System.Text.Equals(unit, "9"))
        {
            digit = 9;
        }
        else
        {
            isDigit = false;
        }

        if (!isDigit)
        {
            return false;
        }

        if (value > (u32[0 max])429496729 || (value == (u32[0 max])429496729 && digit > 5))
        {
            return false;
        }

        value = (u32[0 max])((value * 10) + digit);
    }

    index = value;
    return true;
}

internal fn bool TypeSpanIsMemoryBackedParameter(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    stack mut bool consumedIntegerRange = false;
    stack mut TokenKind previousTopLevel = TokenKind.EndOfFile;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0)
        {
            if (kind == TokenKind.Borrow || kind == TokenKind.Retborrow
                || kind == TokenKind.Storeborrow || kind == TokenKind.Out
                || kind == TokenKind.Init || kind == TokenKind.Rawptr
                || kind == TokenKind.Rawmutptr || kind == TokenKind.AsciiView
                || kind == TokenKind.UnicodeView)
            {
                return true;
            }

            if (kind == TokenKind.LBrack)
            {
                if (stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.RBrack)
                {
                    return true;
                }

                if (previousTopLevel == TokenKind.IntegerType && !consumedIntegerRange)
                {
                    consumedIntegerRange = true;
                }
            }
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        if (depth == 0 && kind != TokenKind.LBrack && kind != TokenKind.RBrack)
        {
            previousTopLevel = kind;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u64[0 2 ** 63 - 1] FunctionSignatureParamIndexPlusOneByName(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u32[0 max] nameToken)
{
    stack mut u64[0 2 ** 63 - 1] found = 0;
    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < paramCount; index += 1)
    {
        if (found == 0 && TokenTextEqualsToken(source, stream, signature.ParamNameAt(index), nameToken))
        {
            found = (u64[0 2 ** 63 - 1])(index + 1);
        }
    }

    return found;
}

internal fn bool SignatureDeadOnReturnHasEarlierName(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.DeadOnReturnParamNameAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] scan = 0; scan < currentIndex; scan += 1)
    {
        if (TokenTextEqualsToken(source, stream, signature.DeadOnReturnParamNameAt(scan), current))
        {
            return true;
        }
    }

    return false;
}

internal fn bool SignatureParamHasDeadOnReturnContract(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] paramIndex)
{
    stack u32[0 max] paramName = signature.ParamNameAt(paramIndex);
    stack u64[0 2 ** 63 - 1] contractCount = signature.DeadOnReturnParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < contractCount; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, paramName, signature.DeadOnReturnParamNameAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn u32[0 max] MatchingCloseParenAfter(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.RParen && depth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn bool TryFindCallableParamList(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive, out u32[0 max] lparen, out u32[0 max] rparen)
{
    lparen = 0;
    rparen = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Fn)
        {
            stack mut u32[0 max] depth = 0;
            stack mut u32[0 max] cursor = (u32[0 max])(scan + 1);
            while willexit (cursor < endExclusive)
            {
                stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
                if (kind == TokenKind.LParen && depth == 0)
                {
                    lparen = cursor;
                    rparen = MatchingCloseParenAfter(stream, cursor, endExclusive);
                    return rparen != 0;
                }

                if (kind == TokenKind.LParen || kind == TokenKind.LBrack
                    || kind == TokenKind.LBrace || kind == TokenKind.Lt)
                {
                    depth = (u32[0 max])(depth + 1);
                }
                else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
                    || kind == TokenKind.RBrace || kind == TokenKind.Gt)
                {
                    if (depth > 0)
                    {
                        depth = (u32[0 max])(depth - 1);
                    }
                }

                cursor = (u32[0 max])(cursor + 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u32[0 max] CallableParamCount(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] rparen)
{
    if ((u32[0 max])(lparen + 1) >= rparen)
    {
        return 0;
    }

    stack mut u32[0 max] count = 1;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan < rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Comma && depth == 0)
        {
            count = (u32[0 max])(count + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

internal fn bool TryCallableParamSpan(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] rparen, u32[0 max] argIndex, out u32[0 max] start, out u32[0 max] endExclusive)
{
    start = 0;
    endExclusive = 0;
    stack mut u32[0 max] currentIndex = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(lparen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan <= rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if ((scan == rparen || (kind == TokenKind.Comma && depth == 0)))
        {
            if (currentIndex == argIndex)
            {
                start = segmentStart;
                endExclusive = scan;
                return segmentStart < scan;
            }

            currentIndex = (u32[0 max])(currentIndex + 1);
            segmentStart = (u32[0 max])(scan + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool CallableTypeDeadOnReturnHasEarlierName(ascii source, borrow TokenStream stream, u32[0 max] typeStart, u32[0 max] currentToken)
{
    stack mut u32[0 max] scan = typeStart;
    while willexit (scan < currentToken)
    {
        if (IsDeadOnReturnContractToken(stream, scan)
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            stack mut u32[0 max] inner = (u32[0 max])(scan + 2);
            stack mut u32[0 max] depth = 0;
            while willexit (inner < currentToken)
            {
                stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])inner);
                if (kind == TokenKind.RParen && depth == 0)
                {
                    break;
                }

                if (kind == TokenKind.LParen || kind == TokenKind.LBrack
                    || kind == TokenKind.LBrace || kind == TokenKind.Lt)
                {
                    depth = (u32[0 max])(depth + 1);
                }
                else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
                    || kind == TokenKind.RBrace || kind == TokenKind.Gt)
                {
                    if (depth > 0)
                    {
                        depth = (u32[0 max])(depth - 1);
                    }
                }
                else if (kind == TokenKind.Identifier && depth == 0
                    && TokenTextEqualsToken(source, stream, inner, currentToken))
                {
                    return true;
                }

                inner = (u32[0 max])(inner + 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn System.Memory.MemoryStatus ValidateCallableDeadOnReturnContract(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] contractLParen,
    u32[0 max] callableLParen,
    u32[0 max] callableRParen,
    mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] paramCount = CallableParamCount(stream, callableLParen, callableRParen);
    stack mut u32[0 max] scan = (u32[0 max])(contractLParen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.RParen && depth == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0)
        {
            stack mut u32[0 max] argIndex = 0;
            stack mut u32[0 max] paramStart = 0;
            stack mut u32[0 max] paramEnd = 0;
            if (!TryReadSyntheticArgumentIndex(source, stream, scan, argIndex)
                || argIndex >= paramCount
                || !TryCallableParamSpan(stream, callableLParen, callableRParen, argIndex, paramStart, paramEnd))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnUnknownParameter, scan))
                {
                    case System.Memory.MemoryStatus.Err(var unknownError):
                        return System.Memory.MemoryStatus.Err(unknownError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (!TypeSpanIsMemoryBackedParameter(stream, paramStart, paramEnd))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnNonMemoryBackedParameter, scan))
                {
                    case System.Memory.MemoryStatus.Err(var memoryError):
                        return System.Memory.MemoryStatus.Err(memoryError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (CallableTypeDeadOnReturnHasEarlierName(source, stream, typeStart, scan))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnDuplicateParameter, scan))
                {
                    case System.Memory.MemoryStatus.Err(var duplicateError):
                        return System.Memory.MemoryStatus.Err(duplicateError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallableTypeDeadOnReturnDiagnostics(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] callableLParen = 0;
    stack mut u32[0 max] callableRParen = 0;
    if (!TryFindCallableParamList(stream, start, endExclusive, callableLParen, callableRParen))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (IsDeadOnReturnContractToken(stream, scan)
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            switch (ValidateCallableDeadOnReturnContract(source, stream, start, (u32[0 max])(scan + 1), callableLParen, callableRParen, diags))
            {
                case System.Memory.MemoryStatus.Err(var contractError):
                    return System.Memory.MemoryStatus.Err(contractError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDeadOnReturnSignatureDiagnostics(
    borrow FunctionSignature signature,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] fnKeyword,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] contractCount = signature.DeadOnReturnParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < contractCount; index += 1)
    {
        stack u32[0 max] name = signature.DeadOnReturnParamNameAt(index);
        stack u64[0 2 ** 63 - 1] paramIndexPlusOne = FunctionSignatureParamIndexPlusOneByName(source, stream, signature, name);
        if (paramIndexPlusOne == 0)
        {
            switch (diags.Append(BindDiagnosticCode.DeadOnReturnUnknownParameter, name))
            {
                case System.Memory.MemoryStatus.Err(var unknownError):
                    return System.Memory.MemoryStatus.Err(unknownError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(paramIndexPlusOne - 1);
            if (!TypeSpanIsMemoryBackedParameter(stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex)))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnNonMemoryBackedParameter, name))
                {
                    case System.Memory.MemoryStatus.Err(var memoryError):
                        return System.Memory.MemoryStatus.Err(memoryError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (SignatureDeadOnReturnHasEarlierName(source, stream, signature, index))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnDuplicateParameter, name))
                {
                    case System.Memory.MemoryStatus.Err(var duplicateError):
                        return System.Memory.MemoryStatus.Err(duplicateError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    if (signature.Name() != 0 && signature.ReturnTypeDeadOnReturnParamCount() > 0)
    {
        switch (CollectCallableTypeDeadOnReturnDiagnostics(source, stream, (u32[0 max])(fnKeyword + 1), signature.Name(), diags))
        {
            case System.Memory.MemoryStatus.Err(var returnTypeError):
                return System.Memory.MemoryStatus.Err(returnTypeError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] p = 0; p < paramCount; p += 1)
    {
        if (signature.ParamTypeDeadOnReturnParamCount(p) > 0)
        {
            switch (CollectCallableTypeDeadOnReturnDiagnostics(source, stream, signature.ParamStartTokenAt(p), signature.ParamNameAt(p), diags))
            {
                case System.Memory.MemoryStatus.Err(var paramTypeError):
                    return System.Memory.MemoryStatus.Err(paramTypeError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn u32[0 max] ParameterRootIndexPlusOneForArgument(borrow ReferenceTable refs, borrow StatementList body, u32[0 max] node)
{
    if (node == 0)
    {
        return 0;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
        if (refIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
            if (refs.KindAt(refIndex) == ReferenceKind.Parameter)
            {
                return refs.TargetAt(refIndex);
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index)
    {
        return ParameterRootIndexPlusOneForArgument(refs, body, body.ExprLeftAt(node));
    }

    return 0;
}

internal fn System.Memory.MemoryStatus CheckDeadOnReturnActualArgument(
    borrow FunctionSignature caller,
    ascii source,
    borrow ReferenceTable refs,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] callNode,
    u32[0 max] argIndex,
    mut borrow BindDiagnosticList diags)
{
    if (argIndex >= body.ExprCallArgCountAt(callNode))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] argNode = body.ExprCallArgAt(callNode, argIndex);
    if (argNode == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] rootParamPlusOne = ParameterRootIndexPlusOneForArgument(refs, body, argNode);
    if (rootParamPlusOne != 0)
    {
        stack u64[0 2 ** 63 - 1] rootParamIndex = (u64[0 2 ** 63 - 1])(rootParamPlusOne - 1);
        if (rootParamIndex < caller.ParamCount()
            && !SignatureParamHasDeadOnReturnContract(source, stream, caller, rootParamIndex))
        {
            switch (diags.Append(BindDiagnosticCode.DeadOnReturnForwardingMismatch, body.ExprTokenAt(argNode)))
            {
                case System.Memory.MemoryStatus.Err(var forwardError):
                    return System.Memory.MemoryStatus.Err(forwardError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }
    else if (body.ExprKindAt(argNode) == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] argRefPlusOne = ReferenceIndexForNode(refs, argNode);
        if (argRefPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] argRef = (u64[0 2 ** 63 - 1])(argRefPlusOne - 1);
            if (refs.KindAt(argRef) == ReferenceKind.Declaration)
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnForwardingMismatch, body.ExprTokenAt(argNode)))
                {
                    case System.Memory.MemoryStatus.Err(var declarationError):
                        return System.Memory.MemoryStatus.Err(declarationError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDirectDeadOnReturnCallDiagnostics(
    borrow FunctionSignature caller,
    borrow FunctionSignature callee,
    ascii source,
    borrow ReferenceTable refs,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] paramCount = callee.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] p = 0; p < paramCount; p += 1)
    {
        if (SignatureParamHasDeadOnReturnContract(source, stream, callee, p))
        {
            switch (CheckDeadOnReturnActualArgument(caller, source, refs, body, stream, callNode, (u32[0 max])p, diags))
            {
                case System.Memory.MemoryStatus.Err(var argError):
                    return System.Memory.MemoryStatus.Err(argError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallbackDeadOnReturnCallFromContract(
    borrow FunctionSignature caller,
    ascii source,
    borrow ReferenceTable refs,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] contractLParen,
    u32[0 max] callableLParen,
    u32[0 max] callableRParen,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] paramCount = CallableParamCount(stream, callableLParen, callableRParen);
    stack mut u32[0 max] scan = (u32[0 max])(contractLParen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.RParen && depth == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0
            && !CallableTypeDeadOnReturnHasEarlierName(source, stream, typeStart, scan))
        {
            stack mut u32[0 max] argIndex = 0;
            stack mut u32[0 max] paramStart = 0;
            stack mut u32[0 max] paramEnd = 0;
            if (TryReadSyntheticArgumentIndex(source, stream, scan, argIndex)
                && argIndex < paramCount
                && TryCallableParamSpan(stream, callableLParen, callableRParen, argIndex, paramStart, paramEnd)
                && TypeSpanIsMemoryBackedParameter(stream, paramStart, paramEnd))
            {
                switch (CheckDeadOnReturnActualArgument(caller, source, refs, body, stream, callNode, argIndex, diags))
                {
                    case System.Memory.MemoryStatus.Err(var actualError):
                        return System.Memory.MemoryStatus.Err(actualError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallbackDeadOnReturnCallDiagnostics(
    borrow FunctionSignature caller,
    ascii source,
    borrow ReferenceTable refs,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] callableLParen = 0;
    stack mut u32[0 max] callableRParen = 0;
    if (!TryFindCallableParamList(stream, typeStart, typeEnd, callableLParen, callableRParen))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] scan = typeStart;
    while willexit (scan < typeEnd)
    {
        if (IsDeadOnReturnContractToken(stream, scan)
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            switch (CollectCallbackDeadOnReturnCallFromContract(caller, source, refs, body, stream, typeStart, (u32[0 max])(scan + 1), callableLParen, callableRParen, callNode, diags))
            {
                case System.Memory.MemoryStatus.Err(var callbackError):
                    return System.Memory.MemoryStatus.Err(callbackError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDeadOnReturnCallDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] n = 0; n < nodeCount; n += 1)
    {
        stack u32[0 max] node = (u32[0 max])(n + 1);
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] calleeNode = body.ExprLeftAt(node);
            if (calleeNode != 0 && body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier)
            {
                stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
                if (refIndexPlusOne != 0)
                {
                    stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
                    stack ReferenceKind kind = refs.KindAt(refIndex);
                    if (kind == ReferenceKind.Declaration)
                    {
                        stack mut FunctionSignature callee = new();
                        if (TryParseFunctionSignatureFromTable(table, stream, refs.TargetAt(refIndex), callee))
                        {
                            switch (CollectDirectDeadOnReturnCallDiagnostics(signature, callee, source, refs, body, stream, node, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var directError):
                                    return System.Memory.MemoryStatus.Err(directError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }
                    else if (kind == ReferenceKind.Parameter)
                    {
                        stack u32[0 max] target = refs.TargetAt(refIndex);
                        if (target != 0 && scope.KindAt((u64[0 2 ** 63 - 1])(target - 1)) == SymbolKind.Parameter)
                        {
                            stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(target - 1);
                            if (paramIndex < signature.ParamCount()
                                && signature.ParamTypeDeadOnReturnParamCount(paramIndex) > 0)
                            {
                                switch (CollectCallbackDeadOnReturnCallDiagnostics(signature, source, refs, body, stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex), node, diags))
                                {
                                    case System.Memory.MemoryStatus.Err(var callbackError):
                                        return System.Memory.MemoryStatus.Err(callbackError);
                                    case System.Memory.MemoryStatus.Ok:
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

struct ArenaSymbolFacts
{
    dynamic u32[0 max] ArenaBackedSymbols;
    dynamic u32[0 max] ArenaRootSymbols;

    ArenaSymbolFacts()
    {
        self.ArenaBackedSymbols = new();
        self.ArenaRootSymbols = new();
    }

    law bool IsArenaBacked(borrow ArenaSymbolFacts self, u32[0 max] symbolIndexPlusOne)
    {
        if (symbolIndexPlusOne == 0)
        {
            return false;
        }

        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < self.ArenaBackedSymbols.Length; index += 1)
        {
            if (self.ArenaBackedSymbols[index] == symbolIndexPlusOne)
            {
                return true;
            }
        }

        return false;
    }

    law bool IsArenaRoot(borrow ArenaSymbolFacts self, u32[0 max] symbolIndexPlusOne)
    {
        if (symbolIndexPlusOne == 0)
        {
            return false;
        }

        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < self.ArenaRootSymbols.Length; index += 1)
        {
            if (self.ArenaRootSymbols[index] == symbolIndexPlusOne)
            {
                return true;
            }
        }

        return false;
    }

    fn System.Memory.MemoryStatus MarkArenaRoot(mut borrow ArenaSymbolFacts self, u32[0 max] symbolIndexPlusOne)
    {
        if (symbolIndexPlusOne == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.IsArenaRoot(symbolIndexPlusOne))
        {
            if (!self.ArenaRootSymbols.TryReserve(1))
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
            }

            init self.ArenaRootSymbols[self.ArenaRootSymbols.Length] = symbolIndexPlusOne;
        }

        return self.MarkArenaBacked(symbolIndexPlusOne);
    }

    fn System.Memory.MemoryStatus MarkArenaBacked(mut borrow ArenaSymbolFacts self, u32[0 max] symbolIndexPlusOne)
    {
        if (symbolIndexPlusOne == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.IsArenaBacked(symbolIndexPlusOne))
        {
            if (!self.ArenaBackedSymbols.TryReserve(1))
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
            }

            init self.ArenaBackedSymbols[self.ArenaBackedSymbols.Length] = symbolIndexPlusOne;
        }

        return System.Memory.MemoryStatus.Ok;
    }
}

internal fn bool TypeSpanHasTopLevelToken(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive, TokenKind target)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == target)
        {
            return true;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool TypeSpanMayRetainArenaBorrow(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Storeborrow);
}

internal fn bool TypeSpanCanReturnBorrowedArena(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Retborrow);
}

internal fn bool TypeSpanIsOutputOnlyParameter(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Out)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Init);
}

internal finite law u32[0 max] TokenOrFallback(u32[0 max] token, u32[0 max] fallback)
{
    if (token != 0)
    {
        return token;
    }

    return fallback;
}

internal fn bool TryDecodeAsmRegisterToken(ascii source, borrow TokenStream stream, u32[0 max] token, out System.Text.OwnedAscii decoded)
{
    decoded = new();
    if (token == 0)
    {
        return false;
    }

    stack ascii literal = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token);
    switch (System.Text.DecodeStringLiteralToUtf8(literal))
    {
        case System.Text.TextBuildResult<System.Text.OwnedAscii>.Err(var error):
            return false;
        case System.Text.TextBuildResult<System.Text.OwnedAscii>.Ok(var value):
            decoded = value;
            return true;
    }
}

internal fn bool AsmRegisterTokenTextEquals(ascii source, borrow TokenStream stream, u32[0 max] left, u32[0 max] right)
{
    stack mut System.Text.OwnedAscii leftText = new();
    stack mut System.Text.OwnedAscii rightText = new();
    if (!TryDecodeAsmRegisterToken(source, stream, left, leftText)
        || !TryDecodeAsmRegisterToken(source, stream, right, rightText))
    {
        return false;
    }

    return Compiler.AsmFacts.RegisterNamesEqual(leftText.View(), rightText.View());
}

internal fn System.Memory.MemoryStatus ValidateAsmRegisterToken(
    ascii source,
    borrow TokenStream stream,
    Compiler.AsmFacts.StarkAsmArchitecture architecture,
    u32[0 max] registerToken,
    mut borrow BindDiagnosticList diags)
{
    stack mut System.Text.OwnedAscii registerText = new();
    if (!TryDecodeAsmRegisterToken(source, stream, registerToken, registerText)
        || !Compiler.AsmFacts.IsValidRegister(architecture, registerText.View()))
    {
        return diags.Append(BindDiagnosticCode.AsmInvalidRegister, registerToken);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool FunctionSignatureHasEarlierInputValue(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmInputValueAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, current, signature.AsmInputValueAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureHasEarlierOutputValue(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmOutputValueAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (!signature.AsmOutputBindsReturnAt(index)
            && TokenTextEqualsToken(source, stream, current, signature.AsmOutputValueAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureInputOutputValueOverlap(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u32[0 max] outputValue)
{
    stack u64[0 2 ** 63 - 1] inputCount = (u64[0 2 ** 63 - 1])signature.AsmInputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < inputCount; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, outputValue, signature.AsmInputValueAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureHasEarlierInputRegister(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmInputRegisterAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, current, signature.AsmInputRegisterAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureHasEarlierOutputRegister(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmOutputRegisterAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, current, signature.AsmOutputRegisterAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureOutputRegisterOverlapsInput(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u32[0 max] outputRegister)
{
    stack u64[0 2 ** 63 - 1] inputCount = (u64[0 2 ** 63 - 1])signature.AsmInputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < inputCount; index += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, outputRegister, signature.AsmInputRegisterAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureHasEarlierClobberRegister(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmClobberRegisterAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, current, signature.AsmClobberRegisterAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureClobberOverlapsOperand(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u32[0 max] clobberRegister)
{
    stack u64[0 2 ** 63 - 1] inputCount = (u64[0 2 ** 63 - 1])signature.AsmInputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] input = 0; input < inputCount; input += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, clobberRegister, signature.AsmInputRegisterAt(input)))
        {
            return true;
        }
    }

    stack u64[0 2 ** 63 - 1] outputCount = (u64[0 2 ** 63 - 1])signature.AsmOutputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] output = 0; output < outputCount; output += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, clobberRegister, signature.AsmOutputRegisterAt(output)))
        {
            return true;
        }
    }

    return false;
}

internal fn System.Memory.MemoryStatus CollectAsmSignatureDiagnostics(
    borrow FunctionSignature signature,
    ascii source,
    borrow TokenStream stream,
    mut borrow BindDiagnosticList diags)
{
    if (!signature.HasAsm())
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] architectureToken = signature.AsmArchitectureToken();
    stack mut Compiler.AsmFacts.StarkAsmArchitecture architecture = Compiler.AsmFacts.StarkAsmArchitecture.Unknown;
    if (architectureToken == 0)
    {
        switch (diags.Append(BindDiagnosticCode.AsmUnknownArchitecture, signature.AsmToken()))
        {
            case System.Memory.MemoryStatus.Err(var archTokenError):
                return System.Memory.MemoryStatus.Err(archTokenError);
            case System.Memory.MemoryStatus.Ok:
        }
    }
    else
    {
        stack ascii architectureText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])architectureToken);
        architecture = Compiler.AsmFacts.ParseArchitectureName(architectureText);
        if (architecture == Compiler.AsmFacts.StarkAsmArchitecture.Unknown)
        {
            switch (diags.Append(BindDiagnosticCode.AsmUnknownArchitecture, architectureToken))
            {
                case System.Memory.MemoryStatus.Err(var archError):
                    return System.Memory.MemoryStatus.Err(archError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack bool validateRegisters = architecture != Compiler.AsmFacts.StarkAsmArchitecture.Unknown;
    stack u64[0 2 ** 63 - 1] inputCount = (u64[0 2 ** 63 - 1])signature.AsmInputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] input = 0; input < inputCount; input += 1)
    {
        stack u32[0 max] registerToken = signature.AsmInputRegisterAt(input);
        stack u32[0 max] valueToken = signature.AsmInputValueAt(input);
        if (validateRegisters)
        {
            switch (ValidateAsmRegisterToken(source, stream, architecture, registerToken, diags))
            {
                case System.Memory.MemoryStatus.Err(var registerError):
                    return System.Memory.MemoryStatus.Err(registerError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (FunctionSignatureHasEarlierInputRegister(source, stream, signature, input))
        {
            switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, registerToken))
            {
                case System.Memory.MemoryStatus.Err(var inputRegisterError):
                    return System.Memory.MemoryStatus.Err(inputRegisterError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        stack u64[0 2 ** 63 - 1] paramIndexPlusOne = FunctionSignatureParamIndexPlusOneByName(source, stream, signature, valueToken);
        if (paramIndexPlusOne == 0)
        {
            switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, TokenOrFallback(valueToken, registerToken)))
            {
                case System.Memory.MemoryStatus.Err(var inputNameError):
                    return System.Memory.MemoryStatus.Err(inputNameError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(paramIndexPlusOne - 1);
            if (TypeSpanIsOutputOnlyParameter(stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex))
                || FunctionSignatureHasEarlierInputValue(source, stream, signature, input))
            {
                switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, valueToken))
                {
                    case System.Memory.MemoryStatus.Err(var inputValueError):
                        return System.Memory.MemoryStatus.Err(inputValueError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    stack bool returnsVoid = stream.KindAt((u64[0 2 ** 63 - 1])signature.ReturnTypeTokenAt()) == TokenKind.Void;
    stack mut u32[0 max] returnBindingCount = 0;
    stack u64[0 2 ** 63 - 1] outputCount = (u64[0 2 ** 63 - 1])signature.AsmOutputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] output = 0; output < outputCount; output += 1)
    {
        stack u32[0 max] registerToken = signature.AsmOutputRegisterAt(output);
        stack u32[0 max] valueToken = signature.AsmOutputValueAt(output);
        if (validateRegisters)
        {
            switch (ValidateAsmRegisterToken(source, stream, architecture, registerToken, diags))
            {
                case System.Memory.MemoryStatus.Err(var registerError):
                    return System.Memory.MemoryStatus.Err(registerError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (FunctionSignatureHasEarlierOutputRegister(source, stream, signature, output)
            || (!signature.AsmOutputBindsReturnAt(output)
                && FunctionSignatureOutputRegisterOverlapsInput(source, stream, signature, registerToken)))
        {
            switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, registerToken))
            {
                case System.Memory.MemoryStatus.Err(var outputRegisterError):
                    return System.Memory.MemoryStatus.Err(outputRegisterError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (signature.AsmOutputBindsReturnAt(output))
        {
            returnBindingCount = (u32[0 max])(returnBindingCount + 1);
            if (returnsVoid || returnBindingCount > 1)
            {
                switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, TokenOrFallback(valueToken, registerToken)))
                {
                    case System.Memory.MemoryStatus.Err(var returnBindingError):
                        return System.Memory.MemoryStatus.Err(returnBindingError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
        else
        {
            stack u64[0 2 ** 63 - 1] paramIndexPlusOne = FunctionSignatureParamIndexPlusOneByName(source, stream, signature, valueToken);
            if (paramIndexPlusOne == 0)
            {
                switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, TokenOrFallback(valueToken, registerToken)))
                {
                    case System.Memory.MemoryStatus.Err(var outputNameError):
                        return System.Memory.MemoryStatus.Err(outputNameError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else
            {
                stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(paramIndexPlusOne - 1);
                if (!TypeSpanIsOutputOnlyParameter(stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex))
                    || FunctionSignatureHasEarlierOutputValue(source, stream, signature, output)
                    || FunctionSignatureInputOutputValueOverlap(source, stream, signature, valueToken))
                {
                    switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, valueToken))
                    {
                        case System.Memory.MemoryStatus.Err(var outputValueError):
                            return System.Memory.MemoryStatus.Err(outputValueError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }
    }

    if (!returnsVoid && returnBindingCount != 1)
    {
        switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, signature.Name()))
        {
            case System.Memory.MemoryStatus.Err(var missingReturnError):
                return System.Memory.MemoryStatus.Err(missingReturnError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack u64[0 2 ** 63 - 1] clobberCount = (u64[0 2 ** 63 - 1])signature.AsmClobberCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] clobberIndex = 0; clobberIndex < clobberCount; clobberIndex += 1)
    {
        stack u32[0 max] registerToken = signature.AsmClobberRegisterAt(clobberIndex);
        if (validateRegisters)
        {
            switch (ValidateAsmRegisterToken(source, stream, architecture, registerToken, diags))
            {
                case System.Memory.MemoryStatus.Err(var clobberRegisterError):
                    return System.Memory.MemoryStatus.Err(clobberRegisterError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (FunctionSignatureHasEarlierClobberRegister(source, stream, signature, clobberIndex)
            || FunctionSignatureClobberOverlapsOperand(source, stream, signature, registerToken))
        {
            switch (diags.Append(BindDiagnosticCode.AsmInvalidClobber, registerToken))
            {
                case System.Memory.MemoryStatus.Err(var clobberError):
                    return System.Memory.MemoryStatus.Err(clobberError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn TokenKind LocalStorageKindForSymbol(borrow FunctionScope scope, borrow StatementList body, borrow TokenStream stream, u32[0 max] symbolIndexPlusOne)
{
    if (symbolIndexPlusOne == 0)
    {
        return TokenKind.EndOfFile;
    }

    stack u64[0 2 ** 63 - 1] symbolIndex = (u64[0 2 ** 63 - 1])(symbolIndexPlusOne - 1);
    if (symbolIndex >= scope.Count() || scope.KindAt(symbolIndex) != SymbolKind.Local)
    {
        return TokenKind.EndOfFile;
    }

    stack u32[0 max] stmtIndex = scope.StmtIndexAt(symbolIndex);
    stack StatementItem item = body.ItemAt((u64[0 2 ** 63 - 1])stmtIndex);
    if (item.Kind != StatementKind.Local)
    {
        return TokenKind.EndOfFile;
    }

    return stream.KindAt((u64[0 2 ** 63 - 1])item.StartToken);
}

internal fn u32[0 max] SymbolIndexPlusOneForStatement(borrow FunctionScope scope, u32[0 max] stmtIndex)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = scope.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0 && scope.KindAt(index) == SymbolKind.Local
            && scope.StmtIndexAt(index) == stmtIndex)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn u32[0 max] LocalSymbolRootForExpression(borrow ReferenceTable refs, borrow StatementList body, u32[0 max] node)
{
    if (node == 0)
    {
        return 0;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
        if (refIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
            if (refs.KindAt(refIndex) == ReferenceKind.Local)
            {
                return refs.TargetAt(refIndex);
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index)
    {
        return LocalSymbolRootForExpression(refs, body, body.ExprLeftAt(node));
    }

    return 0;
}

internal fn bool DeclarationRootIsLongLived(borrow DeclarationTable table, u32[0 max] tableIndexPlusOne)
{
    if (tableIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] tableIndex = (u64[0 2 ** 63 - 1])(tableIndexPlusOne - 1);
    if (tableIndex >= table.Count())
    {
        return false;
    }

    stack DeclarationKind kind = table.KindAt(tableIndex);
    return kind == DeclarationKind.Static || kind == DeclarationKind.Const
        || kind == DeclarationKind.GlobalVariable;
}

internal fn bool ExpressionRootIsLongLivedStorage(borrow DeclarationTable table, borrow ReferenceTable refs, borrow FunctionScope scope, borrow StatementList body, borrow TokenStream stream, u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
        if (refIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
            if (refs.KindAt(refIndex) == ReferenceKind.Declaration)
            {
                return DeclarationRootIsLongLived(table, refs.TargetAt(refIndex));
            }
            else if (refs.KindAt(refIndex) == ReferenceKind.Local)
            {
                stack TokenKind storage = LocalStorageKindForSymbol(scope, body, stream, refs.TargetAt(refIndex));
                return storage == TokenKind.Heap || storage == TokenKind.Static;
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index)
    {
        return ExpressionRootIsLongLivedStorage(table, refs, scope, body, stream, body.ExprLeftAt(node));
    }

    return false;
}

internal fn bool NewExpressionUsesArenaSelector(borrow StatementList body, borrow TokenStream stream, u32[0 max] node)
{
    if (node == 0 || body.ExprKindAt(node) != Compiler.Parsing.ExprKind.New || body.ExprCallArgCountAt(node) == 0)
    {
        return false;
    }

    stack u32[0 max] firstArg = body.ExprCallArgAt(node, 0);
    return firstArg != 0
        && body.ExprKindAt(firstArg) == Compiler.Parsing.ExprKind.StorageSelector
        && stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(firstArg)) == TokenKind.Arena;
}

internal fn bool ExpressionContainsArenaSelectorNew(borrow StatementList body, borrow TokenStream stream, u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (NewExpressionUsesArenaSelector(body, stream, node))
    {
        return true;
    }

    if (kind == Compiler.Parsing.ExprKind.Unary || kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index
        || kind == Compiler.Parsing.ExprKind.Call || kind == Compiler.Parsing.ExprKind.New || kind == Compiler.Parsing.ExprKind.Assign
        || kind == Compiler.Parsing.ExprKind.Binary || kind == Compiler.Parsing.ExprKind.Conditional)
    {
        if (ExpressionContainsArenaSelectorNew(body, stream, body.ExprLeftAt(node))
            || ExpressionContainsArenaSelectorNew(body, stream, body.ExprRightAt(node))
            || ExpressionContainsArenaSelectorNew(body, stream, body.ExprAuxAt(node)))
        {
            return true;
        }

        stack u32[0 max] argCount = body.ExprCallArgCountAt(node);
        for willexit (stack mut u32[0 max] arg = 0; arg < argCount; arg = (u32[0 max])(arg + 1))
        {
            if (ExpressionContainsArenaSelectorNew(body, stream, body.ExprCallArgAt(node, arg)))
            {
                return true;
            }
        }
    }

    return false;
}

internal fn bool CallCalleeNameEquals(ascii source, borrow StatementList body, borrow TokenStream stream, u32[0 max] callNode, ascii name)
{
    stack u32[0 max] calleeNode = body.ExprLeftAt(callNode);
    if (calleeNode == 0 || body.ExprKindAt(calleeNode) != Compiler.Parsing.ExprKind.Identifier)
    {
        return false;
    }

    stack ascii calleeName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])body.ExprTokenAt(calleeNode));
    return System.Text.Equals(calleeName, name);
}

internal fn bool ExpressionIsArenaDerived(
    borrow DeclarationTable table,
    ascii source,
    borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
        if (refIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
            if (refs.KindAt(refIndex) == ReferenceKind.Local)
            {
                return facts.IsArenaBacked(refs.TargetAt(refIndex));
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index || kind == Compiler.Parsing.ExprKind.Unary)
    {
        return ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprLeftAt(node));
    }
    else if (kind == Compiler.Parsing.ExprKind.Assign)
    {
        return ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprRightAt(node));
    }
    else if (kind == Compiler.Parsing.ExprKind.Binary)
    {
        return ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprLeftAt(node))
            || ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprRightAt(node));
    }
    else if (kind == Compiler.Parsing.ExprKind.Conditional)
    {
        return ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprRightAt(node))
            || ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprAuxAt(node));
    }
    else if (kind == Compiler.Parsing.ExprKind.New)
    {
        if (NewExpressionUsesArenaSelector(body, stream, node))
        {
            return true;
        }

        stack u32[0 max] argCount = body.ExprCallArgCountAt(node);
        for willexit (stack mut u32[0 max] arg = 0; arg < argCount; arg = (u32[0 max])(arg + 1))
        {
            if (ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprCallArgAt(node, arg)))
            {
                return true;
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Call)
    {
        if (CallCalleeNameEquals(source, body, stream, node, "slice")
            && body.ExprCallArgCountAt(node) > 0
            && ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprCallArgAt(node, 0)))
        {
            return true;
        }

        stack u32[0 max] calleeNode = body.ExprLeftAt(node);
        if (calleeNode != 0 && body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
            if (refIndexPlusOne != 0)
            {
                stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
                if (refs.KindAt(refIndex) == ReferenceKind.Declaration)
                {
                    stack mut FunctionSignature callee = new();
                    if (TryParseFunctionSignatureFromTable(table, stream, refs.TargetAt(refIndex), callee))
                    {
                        stack u64[0 2 ** 63 - 1] tableIndex = (u64[0 2 ** 63 - 1])(refs.TargetAt(refIndex) - 1);
                        stack u32[0 max] calleeKeyword = table.KeywordTokenAt(tableIndex);
                        if (calleeKeyword != 0
                            && TypeSpanCanReturnBorrowedArena(stream, (u32[0 max])(calleeKeyword + 1), callee.Name()))
                        {
                            stack u64[0 2 ** 63 - 1] paramCount = callee.ParamCount();
                            for willexit (stack mut u64[0 2 ** 63 - 1] param = 0; param < paramCount; param += 1)
                            {
                                if ((u32[0 max])param < body.ExprCallArgCountAt(node)
                                    && TypeSpanIsMemoryBackedParameter(stream, callee.ParamStartTokenAt(param), callee.ParamNameAt(param))
                                    && ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprCallArgAt(node, (u32[0 max])param)))
                                {
                                    return true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return false;
}

internal fn System.Memory.MemoryStatus AppendArenaEscape(mut borrow BindDiagnosticList diags, u32[0 max] token)
{
    return diags.Append(BindDiagnosticCode.ArenaValueEscapes, token);
}

internal fn System.Memory.MemoryStatus CheckArenaRetainingArgument(
    borrow DeclarationTable table,
    ascii source,
    borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] callNode,
    u32[0 max] argIndex,
    mut borrow BindDiagnosticList diags)
{
    if (argIndex >= body.ExprCallArgCountAt(callNode))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] argNode = body.ExprCallArgAt(callNode, argIndex);
    if (ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, argNode))
    {
        switch (diags.Append(BindDiagnosticCode.ArenaValueRetainedByCallee, body.ExprTokenAt(argNode)))
        {
            case System.Memory.MemoryStatus.Err(var retainError):
                return System.Memory.MemoryStatus.Err(retainError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDirectArenaRetainingCallDiagnostics(
    borrow FunctionSignature callee,
    borrow DeclarationTable table,
    ascii source,
    borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] paramCount = callee.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] param = 0; param < paramCount; param += 1)
    {
        if (TypeSpanMayRetainArenaBorrow(stream, callee.ParamStartTokenAt(param), callee.ParamNameAt(param)))
        {
            switch (CheckArenaRetainingArgument(table, source, facts, refs, scope, body, stream, callNode, (u32[0 max])param, diags))
            {
                case System.Memory.MemoryStatus.Err(var directError):
                    return System.Memory.MemoryStatus.Err(directError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallbackArenaRetainingCallDiagnostics(
    borrow DeclarationTable table,
    ascii source,
    borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] callableLParen = 0;
    stack mut u32[0 max] callableRParen = 0;
    if (!TryFindCallableParamList(stream, typeStart, typeEnd, callableLParen, callableRParen))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] paramCount = CallableParamCount(stream, callableLParen, callableRParen);
    for willexit (stack mut u32[0 max] param = 0; param < paramCount; param = (u32[0 max])(param + 1))
    {
        stack mut u32[0 max] paramStart = 0;
        stack mut u32[0 max] paramEnd = 0;
        if (TryCallableParamSpan(stream, callableLParen, callableRParen, param, paramStart, paramEnd)
            && TypeSpanMayRetainArenaBorrow(stream, paramStart, paramEnd))
        {
            switch (CheckArenaRetainingArgument(table, source, facts, refs, scope, body, stream, callNode, param, diags))
            {
                case System.Memory.MemoryStatus.Err(var callbackError):
                    return System.Memory.MemoryStatus.Err(callbackError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectArenaExpressionEffects(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    mut borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] node,
    mut borrow BindDiagnosticList diags)
{
    if (node == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Assign)
    {
        stack u32[0 max] target = body.ExprLeftAt(node);
        stack u32[0 max] value = body.ExprRightAt(node);
        if (ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, value))
        {
            if (ExpressionRootIsLongLivedStorage(table, refs, scope, body, stream, target))
            {
                switch (AppendArenaEscape(diags, body.ExprTokenAt(target)))
                {
                    case System.Memory.MemoryStatus.Err(var storeError):
                        return System.Memory.MemoryStatus.Err(storeError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else
            {
                stack u32[0 max] rootLocal = LocalSymbolRootForExpression(refs, body, target);
                if (rootLocal != 0)
                {
                    switch (facts.MarkArenaBacked(rootLocal))
                    {
                        case System.Memory.MemoryStatus.Err(var markError):
                            return System.Memory.MemoryStatus.Err(markError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Call)
    {
        stack u32[0 max] calleeNode = body.ExprLeftAt(node);
        if (calleeNode != 0 && body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
            if (refIndexPlusOne != 0)
            {
                stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
                if (refs.KindAt(refIndex) == ReferenceKind.Declaration)
                {
                    stack mut FunctionSignature callee = new();
                    if (TryParseFunctionSignatureFromTable(table, stream, refs.TargetAt(refIndex), callee))
                    {
                        switch (CollectDirectArenaRetainingCallDiagnostics(callee, table, source, facts, refs, scope, body, stream, node, diags))
                        {
                            case System.Memory.MemoryStatus.Err(var directError):
                                return System.Memory.MemoryStatus.Err(directError);
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }
                }
                else if (refs.KindAt(refIndex) == ReferenceKind.Parameter)
                {
                    stack u32[0 max] target = refs.TargetAt(refIndex);
                    if (target != 0 && scope.KindAt((u64[0 2 ** 63 - 1])(target - 1)) == SymbolKind.Parameter)
                    {
                        stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(target - 1);
                        if (paramIndex < signature.ParamCount())
                        {
                            switch (CollectCallbackArenaRetainingCallDiagnostics(table, source, facts, refs, scope, body, stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex), node, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var callbackError):
                                    return System.Memory.MemoryStatus.Err(callbackError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }
                }
            }
        }
    }

    switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, body.ExprLeftAt(node), diags))
    {
        case System.Memory.MemoryStatus.Err(var leftError):
            return System.Memory.MemoryStatus.Err(leftError);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, body.ExprRightAt(node), diags))
    {
        case System.Memory.MemoryStatus.Err(var rightError):
            return System.Memory.MemoryStatus.Err(rightError);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, body.ExprAuxAt(node), diags))
    {
        case System.Memory.MemoryStatus.Err(var auxError):
            return System.Memory.MemoryStatus.Err(auxError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack u32[0 max] argCount = body.ExprCallArgCountAt(node);
    for willexit (stack mut u32[0 max] arg = 0; arg < argCount; arg = (u32[0 max])(arg + 1))
    {
        switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, body.ExprCallArgAt(node, arg), diags))
        {
            case System.Memory.MemoryStatus.Err(var argError):
                return System.Memory.MemoryStatus.Err(argError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectArenaDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    stack mut ArenaSymbolFacts facts = new();
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        stack u32[0 max] root = body.ExprRootAt(index);
        stack mut TokenKind storage = TokenKind.EndOfFile;
        if (item.Kind == StatementKind.Local)
        {
            storage = stream.KindAt((u64[0 2 ** 63 - 1])item.StartToken);
        }

        if (signature.LawKind())
        {
            if (storage == TokenKind.Arena)
            {
                switch (diags.Append(BindDiagnosticCode.ArenaAllocationInLaw, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var localLawError):
                        return System.Memory.MemoryStatus.Err(localLawError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            if (ExpressionContainsArenaSelectorNew(body, stream, root))
            {
                switch (diags.Append(BindDiagnosticCode.ArenaAllocationInLaw, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var selectorLawError):
                        return System.Memory.MemoryStatus.Err(selectorLawError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        if (item.Kind == StatementKind.Local)
        {
            stack u32[0 max] localSymbol = SymbolIndexPlusOneForStatement(scope, (u32[0 max])index);
            if (storage == TokenKind.Arena)
            {
                switch (facts.MarkArenaRoot(localSymbol))
                {
                    case System.Memory.MemoryStatus.Err(var rootError):
                        return System.Memory.MemoryStatus.Err(rootError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (root != 0 && ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, root))
            {
                if (storage == TokenKind.Heap || storage == TokenKind.Static)
                {
                    switch (AppendArenaEscape(diags, item.NameToken))
                    {
                        case System.Memory.MemoryStatus.Err(var storageError):
                            return System.Memory.MemoryStatus.Err(storageError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
                else
                {
                    switch (facts.MarkArenaBacked(localSymbol))
                    {
                        case System.Memory.MemoryStatus.Err(var backedError):
                            return System.Memory.MemoryStatus.Err(backedError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }

        if (item.Kind == StatementKind.Return && root != 0
            && ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, root))
        {
            switch (AppendArenaEscape(diags, body.ExprTokenAt(root)))
            {
                case System.Memory.MemoryStatus.Err(var returnError):
                    return System.Memory.MemoryStatus.Err(returnError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, root, diags))
        {
            case System.Memory.MemoryStatus.Err(var effectError):
                return System.Memory.MemoryStatus.Err(effectError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Parses the function signature named by a declaration-table entry. Returns
// false for non-function entries, missing keyword tokens, or malformed
// signatures.
internal fn bool TryParseFunctionSignatureFromTable(borrow DeclarationTable table, borrow TokenStream stream, u32[0 max] tableIndexPlusOne, out FunctionSignature signature)
{
    signature = new();
    if (tableIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(tableIndexPlusOne - 1);
    if (table.KindAt(slot) != DeclarationKind.Function)
    {
        return false;
    }

    stack u32[0 max] keyword = table.KeywordTokenAt(slot);
    switch (ParseFunctionSignature(stream, keyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var parsed):
            signature = parsed;
            return true;
    }
}

public enum CallableCandidateKind
{
    Declaration,
    ScopeSymbol,
}

public struct CallableCandidateSetTable
{
    internal dynamic u32[0 max] CallNodes;
    internal dynamic u32[0 max] CalleeNodes;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] ArgumentCounts;
    internal dynamic u32[0 max] CandidateStartSlots;
    internal dynamic u32[0 max] CandidateCounts;
    internal dynamic CallableCandidateKind CandidateKinds;
    internal dynamic u32[0 max] CandidateTargets;

    CallableCandidateSetTable()
    {
        self.CallNodes = new();
        self.CalleeNodes = new();
        self.NameTokens = new();
        self.ArgumentCounts = new();
        self.CandidateStartSlots = new();
        self.CandidateCounts = new();
        self.CandidateKinds = new();
        self.CandidateTargets = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow CallableCandidateSetTable self)
    {
        return self.CallNodes.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] TotalCandidateCount(borrow CallableCandidateSetTable self)
    {
        return self.CandidateTargets.Length;
    }

    public law u32[0 max] CallNodeAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] node = 0;
