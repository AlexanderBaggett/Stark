    public law u32[0 max] FlagsAt(borrow TypedDeclarationSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flags = 0;
        if (index < self.Flags.Length)
        {
            flags = self.Flags[index];
        }

        return flags;
    }

    public law bool IsExternalAt(borrow TypedDeclarationSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedDeclFlagExternal());
    }

    public law bool IsUnsafeAt(borrow TypedDeclarationSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedDeclFlagUnsafe());
    }

    public law bool IsFfiAt(borrow TypedDeclarationSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedDeclFlagFfi());
    }

    public law bool IsAsmAt(borrow TypedDeclarationSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedDeclFlagPresent(self.FlagsAt(index), TypedDeclFlagAsm());
    }

    public law bool IsVarargsAt(borrow TypedDeclarationSymbolTable self, u64[0 2 ** 63 - 1] index)
