import Compiler.Lexing
import Compiler.Parsing
import Compiler.Typing
import Compiler.AsmFacts
import Compiler.Ir
import System.Text
import System.Memory
module Compiler.Binding

// Stage 1 self-hosted binder (name resolution). This first slice builds a
// top-level declaration symbol table from a parsed `DeclarationList` and answers
// name lookups and redefinition checks. Later slices resolve type/value
// references and build scoped symbol tables for function bodies.
//
// Names are compared by their source text via `Compiler.Lexing.TokenTextOf`, so
// the binder is given the source alongside the token stream. Storage uses
// `dynamic` columns, matching the parser (and avoiding the cross-package
// `List<T>` drop gap noted in ROADMAP.md).

// A flat table mapping each named top-level declaration to its index in the
// `DeclarationList`.
public struct DeclarationTable
{
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] DeclIndices;
    internal dynamic u32[0 max] KeywordTokens;
    internal dynamic DeclarationKind Kinds;

    DeclarationTable()
    {
        self.NameTokens = new();
        self.DeclIndices = new();
        self.KeywordTokens = new();
        self.Kinds = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow DeclarationTable self)
    {
        return self.NameTokens.Length;
    }

    // The name token of table entry `index`, or 0 when out of range.
    public law u32[0 max] NameTokenAt(borrow DeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    // The declaration index of table entry `index`, or 0 when out of range.
    public law u32[0 max] DeclIndexAt(borrow DeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] declIndex = 0;
        if (index < self.DeclIndices.Length)
        {
            declIndex = self.DeclIndices[index];
        }

        return declIndex;
    }

    // The declaration keyword token (`fn`, `struct`, ...), or 0 when out of range.
    public law u32[0 max] KeywordTokenAt(borrow DeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] keyword = 0;
        if (index < self.KeywordTokens.Length)
        {
            keyword = self.KeywordTokens[index];
        }

        return keyword;
    }

    // The top-level declaration kind, or Unknown when out of range.
    public law DeclarationKind KindAt(borrow DeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut DeclarationKind kind = DeclarationKind.Unknown;
        if (index < self.Kinds.Length)
        {
            kind = self.Kinds[index];
        }

        return kind;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow DeclarationTable self, u32[0 max] nameToken, u32[0 max] declIndex, u32[0 max] keywordToken, DeclarationKind kind)
    {
        if (!self.NameTokens.TryReserve(1)
            || !self.DeclIndices.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.Kinds.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.DeclIndices[self.DeclIndices.Length] = declIndex;
        init self.KeywordTokens[self.KeywordTokens.Length] = keywordToken;
        init self.Kinds[self.Kinds.Length] = kind;
        return System.Memory.MemoryStatus.Ok;
    }
}

public enum BindError
{
    OutOfMemory,
}

public enum BindResult<T>
{
    [Ok] Ok(T),
    [Err] Err(BindError),
}

// Builds a declaration table from `decls`, recording every declaration that has
// a name (in declaration order).
public fn BindResult<DeclarationTable> BuildDeclarationTable(ascii source, borrow TokenStream stream, borrow DeclarationList decls)
{
    stack mut DeclarationTable table = new();
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (item.NameToken != 0)
        {
            switch (table.Append(item.NameToken, (u32[0 max])index, item.KeywordToken, item.Kind))
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return BindResult<DeclarationTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return BindResult<DeclarationTable>.Ok(table);
}

// The table index of the first declaration named `name`, plus one (0 if none).
public fn u32[0 max] LookupDeclaration(borrow DeclarationTable table, ascii source, borrow TokenStream stream, ascii name)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0)
        {
            stack ascii entryName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(index));
            if (System.Text.Equals(entryName, name))
            {
                found = (u32[0 max])(index + 1);
            }
        }
    }

    return found;
}

// True when two declarations in the table share a name (a redefinition).
public fn bool HasDuplicateDeclaration(borrow DeclarationTable table, ascii source, borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] outer = 0; outer < count; outer += 1)
    {
        stack ascii outerName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(outer));
        for willexit (stack mut u64[0 2 ** 63 - 1] inner = (u64[0 2 ** 63 - 1])(outer + 1); inner < count; inner += 1)
        {
            stack ascii innerName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(inner));
            if (System.Text.Equals(outerName, innerName))
            {
                return true;
            }
        }
    }

    return false;
}

// Whether a function-scope symbol is a parameter or a body-local declaration.
public enum SymbolKind
{
    Parameter,
    Local,
}

// A function's local symbol table: every parameter (block depth 0) and every
// `Local` declaration in the body, in source order, each carrying its name
// token, kind, and block nesting depth. Like `DeclarationTable`, names are kept
// as tokens and compared by source text at lookup time.
public struct FunctionScope
{
    internal dynamic u32[0 max] NameTokens;
    internal dynamic SymbolKind Kinds;
    internal dynamic u32[0 max] Depths;
    // For a `Local` symbol, the body-statement index where it is declared (used
    // to gate a reference: a local is visible only at statements that follow its
    // declaration and stay within its block). 0 for parameters (always visible).
    internal dynamic u32[0 max] StmtIndices;
    // Each symbol's declared type-primary token (a built-in type token or a
    // user-type identifier; 0 when unknown), for classifying the symbol's type.
    internal dynamic u32[0 max] TypeTokens;
    // Each symbol's declared type span, retained so callable-value contracts
    // keep their finite/law facts through binding.
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;

    FunctionScope()
    {
        self.NameTokens = new();
        self.Kinds = new();
        self.Depths = new();
        self.StmtIndices = new();
        self.TypeTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow FunctionScope self)
    {
        return self.NameTokens.Length;
    }

    // The name token of symbol `index`, or 0 when out of range.
    public law u32[0 max] NameTokenAt(borrow FunctionScope self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    // The kind of symbol `index` (Parameter when out of range).
    public law SymbolKind KindAt(borrow FunctionScope self, u64[0 2 ** 63 - 1] index)
    {
        stack mut SymbolKind kind = SymbolKind.Parameter;
        if (index < self.Kinds.Length)
        {
            kind = self.Kinds[index];
        }

        return kind;
    }

    // The block nesting depth of symbol `index` (0 = parameter / body top level).
    public law u32[0 max] DepthAt(borrow FunctionScope self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] depth = 0;
        if (index < self.Depths.Length)
        {
            depth = self.Depths[index];
        }

        return depth;
    }

    // The declaring body-statement index of symbol `index` (0 for parameters).
    public law u32[0 max] StmtIndexAt(borrow FunctionScope self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] stmt = 0;
        if (index < self.StmtIndices.Length)
        {
            stmt = self.StmtIndices[index];
        }

        return stmt;
    }

    // The declared type-primary token of symbol `index` (0 when unknown).
    public law u32[0 max] TypeTokenAt(borrow FunctionScope self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeTokens.Length)
        {
            token = self.TypeTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeStartTokenAt(borrow FunctionScope self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeStartTokens.Length)
        {
            token = self.TypeStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeEndTokenAt(borrow FunctionScope self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeEndTokens.Length)
        {
            token = self.TypeEndTokens[index];
        }

        return token;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow FunctionScope self,
        u32[0 max] nameToken,
        SymbolKind kind,
        u32[0 max] depth,
        u32[0 max] stmtIndex,
        u32[0 max] typeToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken)
    {
        if (!self.NameTokens.TryReserve(1)
            || !self.Kinds.TryReserve(1)
            || !self.Depths.TryReserve(1)
            || !self.StmtIndices.TryReserve(1)
            || !self.TypeTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.Kinds[self.Kinds.Length] = kind;
        init self.Depths[self.Depths.Length] = depth;
        init self.StmtIndices[self.StmtIndices.Length] = stmtIndex;
        init self.TypeTokens[self.TypeTokens.Length] = typeToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        return System.Memory.MemoryStatus.Ok;
    }
}

// Builds a function scope from a parsed signature and body: every named
// parameter (depth 0) followed by every named `Local` declaration in body order
// (at its block depth).
public fn BindResult<FunctionScope> BuildFunctionScope(borrow FunctionSignature signature, borrow StatementList body)
{
    stack mut FunctionScope scope = new();
    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < paramCount; index += 1)
    {
        stack u32[0 max] nameToken = signature.ParamNameAt(index);
        if (nameToken != 0)
        {
            switch (scope.Append(
                nameToken,
                SymbolKind.Parameter,
                0,
                0,
                signature.ParamTypeTokenAt(index),
                signature.ParamTypeStartTokenAt(index),
                signature.ParamTypeEndTokenAt(index)))
            {
                case System.Memory.MemoryStatus.Err(var paramError):
                    return BindResult<FunctionScope>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < statementCount; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        // Both ordinary `Local`s and `case`-pattern `var` bindings name in-scope
        // values resolvable by reference; they differ only for the duplicate-in-block
        // check (pattern bindings may repeat across `or` alternatives).
        if ((item.Kind == StatementKind.Local || item.Kind == StatementKind.PatternBinding) && item.NameToken != 0)
        {
            switch (scope.Append(
                item.NameToken,
                SymbolKind.Local,
                body.DepthAt(index),
                (u32[0 max])index,
                item.TypeToken,
                item.TypeStartToken,
                item.TypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var localError):
                    return BindResult<FunctionScope>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return BindResult<FunctionScope>.Ok(scope);
}

// The 1-based index of the symbol that `name` resolves to (0 when unbound). When
// a name has several bindings the most-recently-declared wins, so an inner local
// shadows an outer one or a parameter of the same name.
public fn u32[0 max] LookupSymbol(borrow FunctionScope scope, ascii source, borrow TokenStream stream, ascii name)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = scope.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack ascii entryName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])scope.NameTokenAt(index));
        if (System.Text.Equals(entryName, name))
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

// True when two parameters share a name: a genuine redefinition in the single
// parameter scope. (Locals are excluded — a local reusing a parameter's name is
// shadowing, and same-name locals in distinct sibling blocks are legal, so local
// redefinition needs the not-yet-built block-scope tree.)
public fn bool HasDuplicateParameter(borrow FunctionScope scope, ascii source, borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = scope.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] outer = 0; outer < count; outer += 1)
    {
        if (scope.KindAt(outer) == SymbolKind.Parameter)
        {
            stack ascii outerName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])scope.NameTokenAt(outer));
            for willexit (stack mut u64[0 2 ** 63 - 1] inner = (u64[0 2 ** 63 - 1])(outer + 1); inner < count; inner += 1)
            {
                if (scope.KindAt(inner) == SymbolKind.Parameter)
                {
                    stack ascii innerName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])scope.NameTokenAt(inner));
                    if (System.Text.Equals(outerName, innerName))
                    {
                        return true;
                    }
                }
            }
        }
    }

    return false;
}

// True when a `Local` declaration shadows a parameter of the same name (the
// parameter is the unique enclosing scope, so this comparison is exact).
public fn bool LocalShadowsParameter(borrow FunctionScope scope, ascii source, borrow TokenStream stream)
{
    stack u64[0 2 ** 63 - 1] count = scope.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] localIndex = 0; localIndex < count; localIndex += 1)
    {
        if (scope.KindAt(localIndex) == SymbolKind.Local)
        {
            stack ascii localName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])scope.NameTokenAt(localIndex));
            for willexit (stack mut u64[0 2 ** 63 - 1] paramIndex = 0; paramIndex < count; paramIndex += 1)
            {
                if (scope.KindAt(paramIndex) == SymbolKind.Parameter)
                {
                    stack ascii paramName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])scope.NameTokenAt(paramIndex));
                    if (System.Text.Equals(localName, paramName))
                    {
                        return true;
                    }
                }
            }
        }
    }

    return false;
}

// Whether a `Local` declared at body statement `declStmt` is in lexical scope at
// statement `refStmt`: the declaration must precede the reference, and the local's
// scope must enclose the reference's scope — i.e. the local's scope is an
// ancestor-or-equal of the reference's scope in the scope tree. Parameters are
// handled separately and are always visible.
internal fn bool LocalVisibleAt(borrow StatementList body, u64[0 2 ** 63 - 1] declStmt, u64[0 2 ** 63 - 1] refStmt)
{
    stack mut bool visible = false;
    if (declStmt < refStmt)
    {
        stack u32[0 max] declScope = body.ScopeIdAt(declStmt);
        stack mut u32[0 max] cur = body.ScopeIdAt(refStmt);
        // Walk the reference's scope up to the root; the local is visible iff the
        // walk meets the local's scope. The guard (scope count) bounds the walk —
        // each parent has a smaller id than its child, so the tree is finite.
        stack mut u64[0 2 ** 63 - 1] guard = (u64[0 2 ** 63 - 1])(body.ScopeCount() + 1);
        while willexit (guard > 0)
        {
            guard = (u64[0 2 ** 63 - 1])(guard - 1);
            if (cur == declScope)
            {
                visible = true;
                guard = 0;
            }
            else
            {
                stack u32[0 max] parent = body.ScopeParentAt(cur);
                if (parent == cur)
                {
                    guard = 0;
                }
                else
                {
                    cur = parent;
                }
            }
        }
    }

    return visible;
}

// Counts the identifier references in a function body that bind to nothing —
// neither an in-scope function-scope symbol nor a top-level declaration. Delegates
// to the lexical `ResolveReferences` so the answer matches the full resolution.
public fn u32[0 max] CountUnresolvedReferences(borrow FunctionScope scope, borrow DeclarationTable table, ascii source, borrow TokenStream stream, borrow StatementList body)
{
    switch (ResolveReferences(scope, table, source, stream, body))
    {
        case BindResult<ReferenceTable>.Err(var error):
            return 0;
        case BindResult<ReferenceTable>.Ok(var refs):
            return refs.UnboundCount();
    }
}

// How an identifier reference resolved: to a parameter or local (in the function
// scope), to a top-level declaration (global/function/type), or to nothing.
public enum ReferenceKind
{
    Parameter,
    Local,
    Declaration,
    Unbound,
}

// The resolution of every identifier reference in a function body's expressions,
// in expression-node order. Each entry carries the reference's expression-tree
// node, its name token, what it resolved to, and the 1-based index of the target
// (a `FunctionScope` symbol for Parameter/Local, a `DeclarationTable` entry for
// Declaration, 0 for Unbound).
public struct ReferenceTable
{
    internal dynamic u32[0 max] Nodes;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic ReferenceKind Kinds;
    internal dynamic u32[0 max] Targets;

    ReferenceTable()
    {
        self.Nodes = new();
        self.NameTokens = new();
        self.Kinds = new();
        self.Targets = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow ReferenceTable self)
    {
        return self.Nodes.Length;
    }

    // The expression-tree node of reference `index`, or 0 when out of range.
    public law u32[0 max] NodeAt(borrow ReferenceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] node = 0;
        if (index < self.Nodes.Length)
        {
            node = self.Nodes[index];
        }

        return node;
    }

    // The name token of reference `index`, or 0 when out of range.
    public law u32[0 max] NameTokenAt(borrow ReferenceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    // The resolution kind of reference `index` (Unbound when out of range).
    public law ReferenceKind KindAt(borrow ReferenceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut ReferenceKind kind = ReferenceKind.Unbound;
        if (index < self.Kinds.Length)
        {
            kind = self.Kinds[index];
        }

        return kind;
    }

    // The 1-based target index of reference `index` (0 = none / unbound).
    public law u32[0 max] TargetAt(borrow ReferenceTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] target = 0;
        if (index < self.Targets.Length)
        {
            target = self.Targets[index];
        }

        return target;
    }

    // The number of references that resolved to nothing.
    public law u32[0 max] UnboundCount(borrow ReferenceTable self)
    {
        stack mut u32[0 max] count = 0;
        stack u64[0 2 ** 63 - 1] total = self.Nodes.Length;
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < total; index += 1)
        {
            if (self.KindAt(index) == ReferenceKind.Unbound)
            {
                count = (u32[0 max])(count + 1);
            }
        }

        return count;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow ReferenceTable self, u32[0 max] node, u32[0 max] nameToken, ReferenceKind kind, u32[0 max] target)
    {
        if (!self.Nodes.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.Kinds.TryReserve(1)
            || !self.Targets.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Nodes[self.Nodes.Length] = node;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.Kinds[self.Kinds.Length] = kind;
        init self.Targets[self.Targets.Length] = target;
        return System.Memory.MemoryStatus.Ok;
    }
}

// Resolves every identifier reference in a function body LEXICALLY. References are
// visited per owning statement (using the parser's per-statement node ranges), so
// each is resolved at its own source position against (1) the function scope —
// parameters (always visible) and locals that both precede the reference and whose
// block still encloses it, with the innermost (deepest, then latest-declared)
// binding winning — and otherwise (2) the top-level declaration table. Member
// names, operators, and literals are not identifier references and are skipped.
public fn BindResult<ReferenceTable> ResolveReferences(borrow FunctionScope scope, borrow DeclarationTable table, ascii source, borrow TokenStream stream, borrow StatementList body)
{
    stack mut ReferenceTable refs = new();
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    stack u64[0 2 ** 63 - 1] totalNodes = body.ExprNodeCount();
    stack u64[0 2 ** 63 - 1] scopeCount = scope.Count();
    stack u64[0 2 ** 63 - 1] tableCount = table.Count();

    for willexit (stack mut u64[0 2 ** 63 - 1] stmt = 0; stmt < statementCount; stmt += 1)
    {
        // Expression nodes `(low, high]` (1-based) belong to this statement.
        stack u64[0 2 ** 63 - 1] low = (u64[0 2 ** 63 - 1])body.ExprStartAt(stmt);
        stack mut u64[0 2 ** 63 - 1] high = totalNodes;
        if ((u64[0 2 ** 63 - 1])(stmt + 1) < statementCount)
        {
            high = (u64[0 2 ** 63 - 1])body.ExprStartAt((u64[0 2 ** 63 - 1])(stmt + 1));
        }

        for willexit (stack mut u64[0 2 ** 63 - 1] n = (u64[0 2 ** 63 - 1])(low + 1); n <= high; n += 1)
        {
            stack u32[0 max] node = (u32[0 max])n;
            if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Identifier)
            {
                stack u32[0 max] nameToken = body.ExprTokenAt(node);
                stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])nameToken);
                stack mut ReferenceKind kind = ReferenceKind.Unbound;
                stack mut u32[0 max] target = 0;

                // Pick the innermost in-scope binding: greater block depth wins,
                // ties broken by later declaration (so an inner/later local shadows
                // an outer one or a parameter). Parameters rank at depth 0, order 0;
                // a local ranks at its depth, order = declaring-statement + 1.
                stack mut bool found = false;
                stack mut u32[0 max] bestDepth = 0;
                stack mut u64[0 2 ** 63 - 1] bestOrder = 0;
                stack mut SymbolKind bestKind = SymbolKind.Parameter;
                stack mut u32[0 max] bestTarget = 0;
                for willexit (stack mut u64[0 2 ** 63 - 1] s = 0; s < scopeCount; s += 1)
                {
                    stack ascii symbolName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])scope.NameTokenAt(s));
                    if (System.Text.Equals(symbolName, name))
                    {
                        stack mut bool candidate = false;
                        stack mut u32[0 max] candDepth = 0;
                        stack mut u64[0 2 ** 63 - 1] candOrder = 0;
                        if (scope.KindAt(s) == SymbolKind.Parameter)
                        {
                            candidate = true;
                        }
                        else
                        {
                            stack u32[0 max] declStmt = scope.StmtIndexAt(s);
                            if (LocalVisibleAt(body, (u64[0 2 ** 63 - 1])declStmt, stmt))
                            {
                                candidate = true;
                                candDepth = scope.DepthAt(s);
                                candOrder = (u64[0 2 ** 63 - 1])(declStmt + 1);
                            }
                        }

                        if (candidate)
                        {
                            stack mut bool better = !found;
                            if (found && candDepth > bestDepth)
                            {
                                better = true;
                            }
                            else if (found && candDepth == bestDepth && candOrder > bestOrder)
                            {
                                better = true;
                            }

                            if (better)
                            {
                                found = true;
                                bestDepth = candDepth;
                                bestOrder = candOrder;
                                bestKind = scope.KindAt(s);
                                bestTarget = (u32[0 max])(s + 1);
                            }
                        }
                    }
                }

                if (found)
                {
                    target = bestTarget;
                    switch (bestKind)
                    {
                        case SymbolKind.Parameter:
                            kind = ReferenceKind.Parameter;
                        case SymbolKind.Local:
                            kind = ReferenceKind.Local;
                    }
                }
                else
                {
                    stack mut u32[0 max] tableMatch = 0;
                    for willexit (stack mut u64[0 2 ** 63 - 1] t = 0; t < tableCount; t += 1)
                    {
                        if (tableMatch == 0)
                        {
                            stack ascii declName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(t));
                            if (System.Text.Equals(declName, name))
                            {
                                tableMatch = (u32[0 max])(t + 1);
                            }
                        }
                    }

                    if (tableMatch != 0)
                    {
                        kind = ReferenceKind.Declaration;
                        target = tableMatch;
                    }
                }

                switch (refs.Append(node, nameToken, kind, target))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return BindResult<ReferenceTable>.Err(BindError.OutOfMemory);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return BindResult<ReferenceTable>.Ok(refs);
}

// True when the user-type head token `headToken` names some top-level
// declaration in `table` (a struct/enum/record/trait/alias). The head token's
// text and each candidate are slices of the same `source`, so they are compared
// with `System.Text.Equals` rather than passed to the disjoint-contract
// `LookupDeclaration`.
internal fn bool TypeHeadResolves(borrow DeclarationTable table, ascii source, borrow TokenStream stream, u32[0 max] headToken)
{
    stack mut bool resolved = false;
    stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])headToken);
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] t = 0; t < count; t += 1)
    {
        if (!resolved)
        {
            stack ascii declName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(t));
            if (System.Text.Equals(declName, name))
            {
                resolved = true;
            }
        }
    }

    return resolved;
}

internal fn bool TypeReferenceResolvesInScope(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] genericList,
    u32[0 max] declKeyword,
    bool useDeclarationGenericScope,
    u32[0 max] headToken)
{
    if (TypeHeadResolves(table, source, stream, headToken))
    {
        return true;
    }

    if (useDeclarationGenericScope)
    {
        return HeadIsGenericParameter(source, stream, declKeyword, headToken);
    }

    return GenericParamListMatches(source, stream, genericList, headToken);
}

internal finite law bool GenericArgumentSegmentIsValue(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    if (start >= endExclusive)
    {
        return false;
    }

    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])start);
    return kind == TokenKind.IntegerLiteral
        || kind == TokenKind.Plus
        || kind == TokenKind.Minus
        || kind == TokenKind.Comptime;
}

internal finite law u32[0 max] MatchingTypeCloseBefore(borrow TokenStream stream, u32[0 max] openToken, u32[0 max] endExclusive)
{
    stack mut u32[0 max] index = openToken;
    stack mut u32[0 max] depth = 0;
    while willexit (index < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return index;
                }
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return endExclusive;
}

public enum GenericUseSiteArgumentKind
{
    Type,
    ComptimeValue,
}

public struct GenericUseSiteTable
{
    internal dynamic u32[0 max] OwnerTokens;
    internal dynamic u32[0 max] OpenTokens;
    internal dynamic u32[0 max] CloseTokens;
    internal dynamic u32[0 max] ArgumentStartSlots;
    internal dynamic u32[0 max] ArgumentCounts;
    internal dynamic GenericUseSiteArgumentKind ArgumentKinds;
    internal dynamic u32[0 max] ArgumentStartTokens;
    internal dynamic u32[0 max] ArgumentEndTokens;

    GenericUseSiteTable()
    {
        self.OwnerTokens = new();
        self.OpenTokens = new();
        self.CloseTokens = new();
        self.ArgumentStartSlots = new();
        self.ArgumentCounts = new();
        self.ArgumentKinds = new();
        self.ArgumentStartTokens = new();
        self.ArgumentEndTokens = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow GenericUseSiteTable self)
    {
        return self.OwnerTokens.Length;
    }

    public law u32[0 max] OwnerTokenAt(borrow GenericUseSiteTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.OwnerTokens.Length)
        {
            token = self.OwnerTokens[index];
        }

        return token;
    }

    public law u32[0 max] OpenTokenAt(borrow GenericUseSiteTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.OpenTokens.Length)
        {
            token = self.OpenTokens[index];
        }

        return token;
    }

    public law u32[0 max] CloseTokenAt(borrow GenericUseSiteTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.CloseTokens.Length)
        {
            token = self.CloseTokens[index];
        }

        return token;
    }

    public law u32[0 max] ArgumentCountAt(borrow GenericUseSiteTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ArgumentCounts.Length)
        {
            count = self.ArgumentCounts[index];
        }

        return count;
    }

    public law GenericUseSiteArgumentKind ArgumentKindAt(borrow GenericUseSiteTable self, u64[0 2 ** 63 - 1] site, u32[0 max] arg)
    {
        stack mut GenericUseSiteArgumentKind kind = GenericUseSiteArgumentKind.Type;
        if (site < self.ArgumentStartSlots.Length && arg < self.ArgumentCountAt(site))
        {
            stack u32[0 max] start = self.ArgumentStartSlots[site];
            if (start >= 1)
            {
                stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])((start - 1) + arg);
                if (slot < self.ArgumentKinds.Length)
                {
                    kind = self.ArgumentKinds[slot];
                }
            }
        }

        return kind;
    }

    public law u32[0 max] ArgumentStartTokenAt(borrow GenericUseSiteTable self, u64[0 2 ** 63 - 1] site, u32[0 max] arg)
    {
        stack mut u32[0 max] token = 0;
        if (site < self.ArgumentStartSlots.Length && arg < self.ArgumentCountAt(site))
        {
            stack u32[0 max] start = self.ArgumentStartSlots[site];
            if (start >= 1)
            {
                stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])((start - 1) + arg);
                if (slot < self.ArgumentStartTokens.Length)
                {
                    token = self.ArgumentStartTokens[slot];
                }
            }
        }

        return token;
    }

    public law u32[0 max] ArgumentEndTokenAt(borrow GenericUseSiteTable self, u64[0 2 ** 63 - 1] site, u32[0 max] arg)
    {
        stack mut u32[0 max] token = 0;
        if (site < self.ArgumentStartSlots.Length && arg < self.ArgumentCountAt(site))
        {
            stack u32[0 max] start = self.ArgumentStartSlots[site];
            if (start >= 1)
            {
                stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])((start - 1) + arg);
                if (slot < self.ArgumentEndTokens.Length)
                {
                    token = self.ArgumentEndTokens[slot];
                }
            }
        }

        return token;
    }

    public law u32[0 max] TypeArgumentCountAt(borrow GenericUseSiteTable self, u64[0 2 ** 63 - 1] site)
    {
        stack mut u32[0 max] count = 0;
        stack u32[0 max] args = self.ArgumentCountAt(site);
        for willexit (stack mut u32[0 max] arg = 0; arg < args; arg += 1)
        {
            if (self.ArgumentKindAt(site, arg) == GenericUseSiteArgumentKind.Type)
            {
                count = (u32[0 max])(count + 1);
            }
        }

        return count;
    }

    public law u32[0 max] ComptimeValueArgumentCountAt(borrow GenericUseSiteTable self, u64[0 2 ** 63 - 1] site)
    {
        stack mut u32[0 max] count = 0;
        stack u32[0 max] args = self.ArgumentCountAt(site);
        for willexit (stack mut u32[0 max] arg = 0; arg < args; arg += 1)
        {
            if (self.ArgumentKindAt(site, arg) == GenericUseSiteArgumentKind.ComptimeValue)
            {
                count = (u32[0 max])(count + 1);
            }
        }

        return count;
    }

    public law u32[0 max] TotalTypeArgumentCount(borrow GenericUseSiteTable self)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] site = 0; site < count; site += 1)
        {
            total = (u32[0 max])(total + self.TypeArgumentCountAt(site));
        }

        return total;
    }

    public law u32[0 max] TotalComptimeValueArgumentCount(borrow GenericUseSiteTable self)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] site = 0; site < count; site += 1)
        {
            total = (u32[0 max])(total + self.ComptimeValueArgumentCountAt(site));
        }

        return total;
    }

    internal fn System.Memory.MemoryStatus AppendSite(mut borrow GenericUseSiteTable self, u32[0 max] ownerToken, u32[0 max] openToken, u32[0 max] closeToken, out u32[0 max] siteIndex)
    {
        siteIndex = 0;
        if (!self.OwnerTokens.TryReserve(1)
            || !self.OpenTokens.TryReserve(1)
            || !self.CloseTokens.TryReserve(1)
            || !self.ArgumentStartSlots.TryReserve(1)
            || !self.ArgumentCounts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        siteIndex = (u32[0 max])(self.OwnerTokens.Length + 1);
        init self.OwnerTokens[self.OwnerTokens.Length] = ownerToken;
        init self.OpenTokens[self.OpenTokens.Length] = openToken;
        init self.CloseTokens[self.CloseTokens.Length] = closeToken;
        init self.ArgumentStartSlots[self.ArgumentStartSlots.Length] = (u32[0 max])(self.ArgumentKinds.Length + 1);
        init self.ArgumentCounts[self.ArgumentCounts.Length] = 0;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus AppendArgument(mut borrow GenericUseSiteTable self, u32[0 max] siteIndex, GenericUseSiteArgumentKind kind, u32[0 max] startToken, u32[0 max] endToken)
    {
        if (siteIndex == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.ArgumentKinds.TryReserve(1)
            || !self.ArgumentStartTokens.TryReserve(1)
            || !self.ArgumentEndTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.ArgumentKinds[self.ArgumentKinds.Length] = kind;
        init self.ArgumentStartTokens[self.ArgumentStartTokens.Length] = startToken;
        init self.ArgumentEndTokens[self.ArgumentEndTokens.Length] = endToken;

        stack u64[0 2 ** 63 - 1] siteSlot = (u64[0 2 ** 63 - 1])(siteIndex - 1);
        if (siteSlot < self.ArgumentCounts.Length)
        {
            self.ArgumentCounts[siteSlot] = (u32[0 max])(self.ArgumentCounts[siteSlot] + 1);
        }

        return System.Memory.MemoryStatus.Ok;
    }
}

internal fn System.Memory.MemoryStatus CollectGenericUseSitesInTypeSpan(mut borrow GenericUseSiteTable facts, borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] index = start;
    while willexit (index < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.Lt
            && index > start
            && stream.KindAt((u64[0 2 ** 63 - 1])(index - 1)) == TokenKind.Identifier)
        {
            stack u32[0 max] close = MatchingTypeCloseBefore(stream, index, endExclusive);
            if (close >= endExclusive)
            {
                return System.Memory.MemoryStatus.Ok;
            }

            stack mut u32[0 max] siteIndex = 0;
            switch (facts.AppendSite((u32[0 max])(index - 1), index, close, siteIndex))
            {
                case System.Memory.MemoryStatus.Err(var siteError):
                    return System.Memory.MemoryStatus.Err(siteError);
                case System.Memory.MemoryStatus.Ok:
            }

            stack mut u32[0 max] segmentStart = (u32[0 max])(index + 1);
            stack mut u32[0 max] segmentDepth = 0;
            stack mut u32[0 max] segmentCursor = (u32[0 max])(index + 1);
            while willexit (segmentCursor <= close)
            {
                stack mut bool boundary = false;
                if (segmentCursor == close)
                {
                    boundary = true;
                }
                else
                {
                    stack TokenKind segmentKind = stream.KindAt((u64[0 2 ** 63 - 1])segmentCursor);
                    if (segmentKind == TokenKind.Lt || segmentKind == TokenKind.LBrack || segmentKind == TokenKind.LParen || segmentKind == TokenKind.LBrace)
                    {
                        segmentDepth = (u32[0 max])(segmentDepth + 1);
                    }
                    else if (segmentKind == TokenKind.Gt || segmentKind == TokenKind.RBrack || segmentKind == TokenKind.RParen || segmentKind == TokenKind.RBrace)
                    {
                        if (segmentDepth > 0)
                        {
                            segmentDepth = (u32[0 max])(segmentDepth - 1);
                        }
                    }
                    else if (segmentDepth == 0 && segmentKind == TokenKind.Comma)
                    {
                        boundary = true;
                    }
                }

                if (boundary)
                {
                    if (segmentStart < segmentCursor)
                    {
                        stack mut GenericUseSiteArgumentKind argKind = GenericUseSiteArgumentKind.Type;
                        if (GenericArgumentSegmentIsValue(stream, segmentStart, segmentCursor))
                        {
                            argKind = GenericUseSiteArgumentKind.ComptimeValue;
                        }

                        switch (facts.AppendArgument(siteIndex, argKind, segmentStart, segmentCursor))
                        {
                            case System.Memory.MemoryStatus.Err(var argError):
                                return System.Memory.MemoryStatus.Err(argError);
                            case System.Memory.MemoryStatus.Ok:
                        }

                        if (argKind == GenericUseSiteArgumentKind.Type)
                        {
                            switch (CollectGenericUseSitesInTypeSpan(facts, stream, segmentStart, segmentCursor))
                            {
                                case System.Memory.MemoryStatus.Err(var nestedError):
                                    return System.Memory.MemoryStatus.Err(nestedError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }

                    segmentStart = (u32[0 max])(segmentCursor + 1);
                }

                segmentCursor = (u32[0 max])(segmentCursor + 1);
            }

            index = (u32[0 max])(close + 1);
        }
        else
        {
            index = (u32[0 max])(index + 1);
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectGenericUseSitesFromSpans(mut borrow GenericUseSiteTable facts, borrow TokenStream stream, borrow TypeSpanList spans)
{
    stack u64[0 2 ** 63 - 1] count = spans.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (CollectGenericUseSitesInTypeSpan(facts, stream, spans.StartTokenAt(index), spans.EndTokenAt(index)))
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectGenericUseSitesFromFunction(u32[0 max] fnKeyword, mut borrow GenericUseSiteTable facts, borrow TokenStream stream)
{
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (CollectGenericUseSitesInTypeSpan(facts, stream, signature.ReturnTypeStartTokenAt(), signature.ReturnTypeEndTokenAt()))
            {
                case System.Memory.MemoryStatus.Err(var returnError):
                    return System.Memory.MemoryStatus.Err(returnError);
                case System.Memory.MemoryStatus.Ok:
            }

            stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
            for willexit (stack mut u64[0 2 ** 63 - 1] param = 0; param < paramCount; param += 1)
            {
                switch (CollectGenericUseSitesInTypeSpan(facts, stream, signature.ParamTypeStartTokenAt(param), signature.ParamTypeEndTokenAt(param)))
                {
                    case System.Memory.MemoryStatus.Err(var paramError):
                        return System.Memory.MemoryStatus.Err(paramError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            switch (CollectWhereConstraintTypeSpans(stream, fnKeyword))
            {
                case ParseResult<TypeSpanList>.Err(var whereError):
                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                case ParseResult<TypeSpanList>.Ok(var whereSpans):
                    switch (CollectGenericUseSitesFromSpans(facts, stream, whereSpans))
                    {
                        case System.Memory.MemoryStatus.Err(var whereCollectError):
                            return System.Memory.MemoryStatus.Err(whereCollectError);
                        case System.Memory.MemoryStatus.Ok:
                    }
            }

            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return System.Memory.MemoryStatus.Ok;
                case ParseResult<StatementList>.Ok(var body):
                    stack u64[0 2 ** 63 - 1] bodyCount = body.Count();
                    for willexit (stack mut u64[0 2 ** 63 - 1] stmt = 0; stmt < bodyCount; stmt += 1)
                    {
                        switch (CollectGenericUseSitesInTypeSpan(facts, stream, body.TypeStartTokenAt(stmt), body.TypeEndTokenAt(stmt)))
                        {
                            case System.Memory.MemoryStatus.Err(var localError):
                                return System.Memory.MemoryStatus.Err(localError);
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }
            }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectGenericUseSitesFromDataDeclaration(u32[0 max] declKeyword, mut borrow GenericUseSiteTable facts, borrow TokenStream stream)
{
    switch (ParseStructFields(stream, declKeyword))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<FieldList>.Ok(var fields):
            stack u64[0 2 ** 63 - 1] count = fields.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < count; field += 1)
            {
                switch (CollectGenericUseSitesInTypeSpan(facts, stream, fields.TypeStartAt(field), fields.TypeEndAt(field)))
                {
                    case System.Memory.MemoryStatus.Err(var fieldError):
                        return System.Memory.MemoryStatus.Err(fieldError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
    }

    switch (CollectGenericUseSitesFromConformanceBaseList(facts, stream, declKeyword))
    {
        case System.Memory.MemoryStatus.Err(var baseError):
            return System.Memory.MemoryStatus.Err(baseError);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectWhereConstraintTypeSpans(stream, declKeyword))
    {
        case ParseResult<TypeSpanList>.Err(var whereError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<TypeSpanList>.Ok(var whereSpans):
            return CollectGenericUseSitesFromSpans(facts, stream, whereSpans);
    }
}

internal fn System.Memory.MemoryStatus CollectGenericUseSitesFromEnum(u32[0 max] enumKeyword, mut borrow GenericUseSiteTable facts, borrow TokenStream stream)
{
    switch (ParseEnumPayloadTypeSpans(stream, enumKeyword))
    {
        case ParseResult<TypeSpanList>.Err(var payloadError):
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<TypeSpanList>.Ok(var payloadSpans):
            switch (CollectGenericUseSitesFromSpans(facts, stream, payloadSpans))
            {
                case System.Memory.MemoryStatus.Err(var collectError):
                    return System.Memory.MemoryStatus.Err(collectError);
                case System.Memory.MemoryStatus.Ok:
            }
    }

    switch (CollectWhereConstraintTypeSpans(stream, enumKeyword))
    {
        case ParseResult<TypeSpanList>.Err(var whereError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<TypeSpanList>.Ok(var whereSpans):
            return CollectGenericUseSitesFromSpans(facts, stream, whereSpans);
    }
}

internal finite law u32[0 max] FindVariableTypeTokenForBinding(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] typeToken = 0;
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind tokenKind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (tokenKind == TokenKind.EndOfFile)
        {
            break;
        }

        if (depth == 0 && (tokenKind == TokenKind.Assign || tokenKind == TokenKind.Semi))
        {
            break;
        }

        if (tokenKind == TokenKind.Lt || tokenKind == TokenKind.LBrack)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (tokenKind == TokenKind.Gt || tokenKind == TokenKind.RBrack)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && typeToken == 0 && IsTypeStartToken(tokenKind))
        {
            typeToken = index;
        }

        index = (u32[0 max])(index + 1);
    }

    return typeToken;
}

internal fn System.Memory.MemoryStatus CollectGenericUseSitesFromVariableDeclaration(DeclItem item, mut borrow GenericUseSiteTable facts, borrow TokenStream stream)
{
    if (item.NameToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] start = FindVariableTypeTokenForBinding(stream, (u32[0 max])(item.KeywordToken + 1));
    if (start == 0 || start >= item.NameToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    return CollectGenericUseSitesInTypeSpan(facts, stream, start, item.NameToken);
}

internal fn System.Memory.MemoryStatus CollectGenericUseSitesFromAlias(DeclItem item, mut borrow GenericUseSiteTable facts, borrow TokenStream stream)
{
    stack mut u32[0 max] assign = 0;
    stack mut u32[0 max] scan = item.KeywordToken;
    while willexit (scan <= item.EndToken)
    {
        if (assign == 0 && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Assign)
        {
            assign = scan;
        }

        scan = (u32[0 max])(scan + 1);
    }

    if (assign == 0 || (u32[0 max])(assign + 1) >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    return CollectGenericUseSitesInTypeSpan(facts, stream, (u32[0 max])(assign + 1), item.EndToken);
}

public fn BindResult<GenericUseSiteTable> BuildGenericUseSiteSyntaxFacts(borrow TokenStream stream)
{
    stack mut GenericUseSiteTable facts = new();
    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return BindResult<GenericUseSiteTable>.Err(BindError.OutOfMemory);
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return BindResult<GenericUseSiteTable>.Err(BindError.OutOfMemory);
        case ParseResult<DeclarationList>.Ok(var decls):
            stack u64[0 2 ** 63 - 1] count = decls.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
            {
                stack DeclItem item = decls.ItemAt(index);
                stack mut System.Memory.MemoryStatus status = System.Memory.MemoryStatus.Ok;
                if (item.Kind == DeclarationKind.Function)
                {
                    status = CollectGenericUseSitesFromFunction(item.KeywordToken, facts, stream);
                }
                else if (item.Kind == DeclarationKind.Struct || item.Kind == DeclarationKind.Record)
                {
                    status = CollectGenericUseSitesFromDataDeclaration(item.KeywordToken, facts, stream);
                }
                else if (item.Kind == DeclarationKind.Enum)
                {
                    status = CollectGenericUseSitesFromEnum(item.KeywordToken, facts, stream);
                }
                else if (item.Kind == DeclarationKind.Static || item.Kind == DeclarationKind.GlobalVariable || item.Kind == DeclarationKind.Const)
                {
                    status = CollectGenericUseSitesFromVariableDeclaration(item, facts, stream);
                }
                else if (item.Kind == DeclarationKind.Alias)
                {
                    status = CollectGenericUseSitesFromAlias(item, facts, stream);
                }

                switch (status)
                {
                    case System.Memory.MemoryStatus.Err(var error):
                        return BindResult<GenericUseSiteTable>.Err(BindError.OutOfMemory);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
    }

    return BindResult<GenericUseSiteTable>.Ok(facts);
}

internal fn System.Memory.MemoryStatus CollectUnresolvedTypeReferencesInGenericArguments(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    u32[0 max] genericList,
    u32[0 max] declKeyword,
    bool useDeclarationGenericScope,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] segmentStart = start;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] index = start;
    while willexit (index <= endExclusive)
    {
        stack mut bool boundary = false;
        if (index >= endExclusive)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (segmentStart < index && !GenericArgumentSegmentIsValue(stream, segmentStart, index))
            {
                switch (CollectUnresolvedTypeReferencesInSpan(table, source, stream, segmentStart, index, genericList, declKeyword, useDeclarationGenericScope, diags))
                {
                    case System.Memory.MemoryStatus.Err(var segmentError):
                        return System.Memory.MemoryStatus.Err(segmentError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            segmentStart = (u32[0 max])(index + 1);
        }

        index = (u32[0 max])(index + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectUnresolvedTypeReferencesInSpan(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    u32[0 max] genericList,
    u32[0 max] declKeyword,
    bool useDeclarationGenericScope,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] index = start;
    while willexit (index < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.Where)
        {
            return System.Memory.MemoryStatus.Ok;
        }
        else if (kind == TokenKind.LBrack)
        {
            stack u32[0 max] close = MatchingTypeCloseBefore(stream, index, endExclusive);
            if (close >= endExclusive)
            {
                index = endExclusive;
            }
            else
            {
                index = (u32[0 max])(close + 1);
            }
        }
        else if (kind == TokenKind.Lt)
        {
            stack u32[0 max] close = MatchingTypeCloseBefore(stream, index, endExclusive);
            if (close >= endExclusive)
            {
                index = endExclusive;
            }
            else
            {
                switch (CollectUnresolvedTypeReferencesInGenericArguments(table, source, stream, (u32[0 max])(index + 1), close, genericList, declKeyword, useDeclarationGenericScope, diags))
                {
                    case System.Memory.MemoryStatus.Err(var genericError):
                        return System.Memory.MemoryStatus.Err(genericError);
                    case System.Memory.MemoryStatus.Ok:
                }

                index = (u32[0 max])(close + 1);
            }
        }
        else if (kind == TokenKind.Identifier)
        {
            stack TokenKind nextKind = stream.KindAt((u64[0 2 ** 63 - 1])(index + 1));
            stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])index);
            if (nextKind != TokenKind.Dot
                && !System.Text.Equals(name, "tail")
                && !TypeReferenceResolvesInScope(table, source, stream, genericList, declKeyword, useDeclarationGenericScope, index))
            {
                switch (diags.Append(BindDiagnosticCode.UnresolvedType, index))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return System.Memory.MemoryStatus.Err(appendError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            index = (u32[0 max])(index + 1);
        }
        else
        {
            index = (u32[0 max])(index + 1);
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn u32[0 max] CountUnresolvedTypeReferencesInGenericArguments(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    u32[0 max] genericList,
    u32[0 max] declKeyword,
    bool useDeclarationGenericScope)
{
    stack mut u32[0 max] unresolved = 0;
    stack mut u32[0 max] segmentStart = start;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] index = start;
    while willexit (index <= endExclusive)
    {
        stack mut bool boundary = false;
        if (index >= endExclusive)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (segmentStart < index && !GenericArgumentSegmentIsValue(stream, segmentStart, index))
            {
                unresolved = (u32[0 max])(unresolved + CountUnresolvedTypeReferencesInSpan(table, source, stream, segmentStart, index, genericList, declKeyword, useDeclarationGenericScope));
            }

            segmentStart = (u32[0 max])(index + 1);
        }

        index = (u32[0 max])(index + 1);
    }

    return unresolved;
}

internal fn u32[0 max] CountUnresolvedTypeReferencesInSpan(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    u32[0 max] genericList,
    u32[0 max] declKeyword,
    bool useDeclarationGenericScope)
{
    stack mut u32[0 max] unresolved = 0;
    stack mut u32[0 max] index = start;
    while willexit (index < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.Where)
        {
            return unresolved;
        }
        else if (kind == TokenKind.LBrack)
        {
            stack u32[0 max] close = MatchingTypeCloseBefore(stream, index, endExclusive);
            if (close >= endExclusive)
            {
                index = endExclusive;
            }
            else
            {
                index = (u32[0 max])(close + 1);
            }
        }
        else if (kind == TokenKind.Lt)
        {
            stack u32[0 max] close = MatchingTypeCloseBefore(stream, index, endExclusive);
            if (close >= endExclusive)
            {
                index = endExclusive;
            }
            else
            {
                unresolved = (u32[0 max])(unresolved + CountUnresolvedTypeReferencesInGenericArguments(table, source, stream, (u32[0 max])(index + 1), close, genericList, declKeyword, useDeclarationGenericScope));
                index = (u32[0 max])(close + 1);
            }
        }
        else if (kind == TokenKind.Identifier)
        {
            stack TokenKind nextKind = stream.KindAt((u64[0 2 ** 63 - 1])(index + 1));
            stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])index);
            if (nextKind != TokenKind.Dot
                && !System.Text.Equals(name, "tail")
                && !TypeReferenceResolvesInScope(table, source, stream, genericList, declKeyword, useDeclarationGenericScope, index))
            {
                unresolved = (u32[0 max])(unresolved + 1);
            }

            index = (u32[0 max])(index + 1);
        }
        else
        {
            index = (u32[0 max])(index + 1);
        }
    }

    return unresolved;
}

// Counts a function signature's user-type references, including nested generic
// argument types, that resolve to no top-level declaration. A return of 0 means
// every named type in the signature is declared.
public fn u32[0 max] CountUnresolvedSignatureTypes(borrow FunctionSignature signature, borrow DeclarationTable table, ascii source, borrow TokenStream stream)
{
    stack mut u32[0 max] unresolved = 0;
    stack u32[0 max] genericList = (u32[0 max])(signature.Name() + 1);

    stack u32[0 max] returnStart = signature.ReturnTypeStartTokenAt();
    stack u32[0 max] returnEnd = signature.ReturnTypeEndTokenAt();
    if (returnStart < returnEnd)
    {
        unresolved = (u32[0 max])(unresolved + CountUnresolvedTypeReferencesInSpan(table, source, stream, returnStart, returnEnd, genericList, 0, false));
    }

    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < paramCount; index += 1)
    {
        stack u32[0 max] paramStart = signature.ParamTypeStartTokenAt(index);
        stack u32[0 max] paramEnd = signature.ParamTypeEndTokenAt(index);
        if (paramStart < paramEnd)
        {
            unresolved = (u32[0 max])(unresolved + CountUnresolvedTypeReferencesInSpan(table, source, stream, paramStart, paramEnd, genericList, 0, false));
        }
    }

    return unresolved;
}

// True when `headToken`'s text names a generic parameter of the declaration whose
// keyword is at `declKeyword` — i.e. a parameter of the `<...>` that IMMEDIATELY
// follows the declaration name (e.g. `T` in `struct Box<T>`, `K`/`V` in `record
// Pair<K, V>`, `N` in `struct Buf<comptime u32 N>`). Used so a field whose type
// names a generic parameter is not reported as an unresolved type. The `<` must
// follow the name directly: a struct/record may carry a generic BASE trait
// (`struct S : Base<Bar>`) whose `<...>` is NOT a parameter list. A parameter is
// `Identifier` or `comptime type_ Identifier` (`Stark.g4` `typeParameter`), so the
// parameter NAME is the LAST depth-1 identifier of each `,`-separated entry (the
// comptime form's leading type is skipped). Names are `source` slices, compared
// with `System.Text.Equals` (overlap-permitting), not a disjoint-contract lookup.
internal fn bool HeadIsGenericParameter(ascii source, borrow TokenStream stream, u32[0 max] declKeyword, u32[0 max] headToken)
{
    // The declaration name is the first identifier after the keyword; the type
    // parameter list, if present, is the `<` directly after it.
    stack mut u32[0 max] nameNext = 0;
    stack mut bool foundName = false;
    stack mut u32[0 max] nscan = (u32[0 max])(declKeyword + 1);
    stack mut u64[0 2 ** 63 - 1] nameGuard = stream.Count();
    while willexit (nameGuard > 0)
    {
        nameGuard = (u64[0 2 ** 63 - 1])(nameGuard - 1);
        stack TokenKind nk = stream.KindAt((u64[0 2 ** 63 - 1])nscan);
        if (nk == TokenKind.EndOfFile || nk == TokenKind.LBrace || nk == TokenKind.Semi || nk == TokenKind.LParen)
        {
            nameGuard = 0;
        }
        else if (nk == TokenKind.Identifier)
        {
            nameNext = (u32[0 max])(nscan + 1);
            foundName = true;
            nameGuard = 0;
        }
        else
        {
            nscan = (u32[0 max])(nscan + 1);
        }
    }

    if (!foundName)
    {
        return false;
    }

    return GenericParamListMatches(source, stream, nameNext, headToken);
}

// True when the generic parameter list opening at `ltToken` (which must be `<`)
// declares a parameter whose name equals `headToken`'s text. A parameter is
// `Identifier` or `comptime type_ Identifier`, so the name is the LAST depth-1
// identifier of each `,`-separated entry. Returns false when `ltToken` is not a `<`
// (the declaration has no parameter list). Shared by the type-declaration and
// function-signature generic-parameter exemptions.
internal fn bool GenericParamListMatches(ascii source, borrow TokenStream stream, u32[0 max] ltToken, u32[0 max] headToken)
{
    if (stream.KindAt((u64[0 2 ** 63 - 1])ltToken) != TokenKind.Lt)
    {
        return false;
    }

    stack ascii headName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])headToken);
    stack mut u32[0 max] index = ltToken;
    stack mut u32[0 max] angleDepth = 0;
    stack mut u32[0 max] lastParamIdent = 0;
    stack mut bool matched = false;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (k == TokenKind.EndOfFile)
        {
            guard = 0;
        }
        else if (k == TokenKind.Lt)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (k == TokenKind.Gt)
        {
            // The closing `>` of the parameter list ends the last parameter.
            if (angleDepth == 1)
            {
                if (lastParamIdent != 0)
                {
                    stack ascii lastName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])lastParamIdent);
                    if (System.Text.Equals(lastName, headName))
                    {
                        matched = true;
                    }
                }

                guard = 0;
            }
            else if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }
        else if (angleDepth == 1 && k == TokenKind.Comma)
        {
            // End of one parameter: its name is the last identifier seen.
            if (lastParamIdent != 0)
            {
                stack ascii paramName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])lastParamIdent);
                if (System.Text.Equals(paramName, headName))
                {
                    matched = true;
                    guard = 0;
                }
            }

            lastParamIdent = 0;
        }
        else if (angleDepth == 1 && k == TokenKind.Identifier)
        {
            // Keep the LAST depth-1 identifier of the current parameter (the name;
            // a `comptime type_` prefix's identifiers are overwritten by it).
            lastParamIdent = index;
        }

        index = (u32[0 max])(index + 1);
    }

    return matched;
}

// Emits an `UnresolvedType` diagnostic (anchored at the field's type-head token)
// for each data field of the struct/record whose keyword is at `structKeyword`
// whose user-type head names no top-level declaration AND is not one of the
// declaration's own generic parameters — built-in field types have head 0 and are
// skipped. Mirrors the host resolving `field.type_()` for every field (with the
// type's generic parameters in scope). Parse failures for the type are skipped.
internal fn System.Memory.MemoryStatus CollectUnresolvedFieldTypes(u32[0 max] structKeyword, borrow DeclarationTable table, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    switch (ParseStructFields(stream, structKeyword))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<FieldList>.Ok(var fields):
            stack u64[0 2 ** 63 - 1] count = fields.Count();
            // All declarators of one `type_ a, b;` field declaration share the exact
            // type span; the host resolves that `field.type_()` once, so emit
            // diagnostics once per distinct source span.
            stack mut u32[0 max] prevStart = 0;
            stack mut u32[0 max] prevEnd = 0;
            for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
            {
                stack u32[0 max] start = fields.TypeStartAt(index);
                stack u32[0 max] end = fields.TypeEndAt(index);
                if (start < end && (start != prevStart || end != prevEnd))
                {
                    switch (CollectUnresolvedTypeReferencesInSpan(table, source, stream, start, end, 0, structKeyword, true, diags))
                    {
                        case System.Memory.MemoryStatus.Err(var fieldError):
                            return System.Memory.MemoryStatus.Err(fieldError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                prevStart = start;
                prevEnd = end;
            }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Emits an `UnresolvedType` for each enum-variant payload type (tuple/named-field/
// `from`) whose user-type head names no top-level declaration and is not one of the
// enum's own generic parameters. Each payload type position is a distinct
// `type_` for the host, so occurrences are not deduped. Parse failures are skipped.
internal fn System.Memory.MemoryStatus CollectUnresolvedVariantTypes(u32[0 max] enumKeyword, borrow DeclarationTable table, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    switch (ParseEnumPayloadTypeSpans(stream, enumKeyword))
    {
        case ParseResult<TypeSpanList>.Err(var spansError):
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<TypeSpanList>.Ok(var spans):
            stack u64[0 2 ** 63 - 1] count = spans.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
            {
                stack u32[0 max] start = spans.StartTokenAt(index);
                stack u32[0 max] end = spans.EndTokenAt(index);
                if (start < end)
                {
                    switch (CollectUnresolvedTypeReferencesInSpan(table, source, stream, start, end, 0, enumKeyword, true, diags))
                    {
                        case System.Memory.MemoryStatus.Err(var variantError):
                            return System.Memory.MemoryStatus.Err(variantError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Emits an `UnresolvedType` for every `where T: Bound, ...` constraint bound on a
// type declaration whose bound type names no declaration and is not one of the
// declaration's own generic parameters. This mirrors function `where` constraint
// resolution while using the type declaration's generic parameter list.
internal fn System.Memory.MemoryStatus CollectUnresolvedTypeDeclarationWhereConstraints(u32[0 max] declKeyword, borrow DeclarationTable table, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    switch (CollectWhereConstraintTypeSpans(stream, declKeyword))
    {
        case ParseResult<TypeSpanList>.Err(var whereError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<TypeSpanList>.Ok(var spans):
            stack u64[0 2 ** 63 - 1] count = spans.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
            {
                stack u32[0 max] start = spans.StartTokenAt(index);
                stack u32[0 max] end = spans.EndTokenAt(index);
                if (start < end)
                {
                    switch (CollectUnresolvedTypeReferencesInSpan(table, source, stream, start, end, 0, declKeyword, true, diags))
                    {
                        case System.Memory.MemoryStatus.Err(var constraintError):
                            return System.Memory.MemoryStatus.Err(constraintError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
    }

    return System.Memory.MemoryStatus.Ok;
}

// True when two `Local` declarations in the same block (same lexical scope id)
// share a name — a redefinition. A same-name local in a nested or sibling block
// has a different scope id, so it is shadowing, not redefinition, and not
// reported.
public fn bool HasDuplicateLocalInBlock(ascii source, borrow TokenStream stream, borrow StatementList body)
{
    stack mut bool duplicate = false;
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] i = 0; i < count; i += 1)
    {
        stack StatementItem si = body.ItemAt(i);
        if (!duplicate && si.Kind == StatementKind.Local && si.NameToken != 0)
        {
            stack u32[0 max] scopeI = body.ScopeIdAt(i);
            stack ascii nameI = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])si.NameToken);
            for willexit (stack mut u64[0 2 ** 63 - 1] j = (u64[0 2 ** 63 - 1])(i + 1); j < count; j += 1)
            {
                if (!duplicate)
                {
                    stack StatementItem sj = body.ItemAt(j);
                    if (sj.Kind == StatementKind.Local && sj.NameToken != 0 && body.ScopeIdAt(j) == scopeI)
                    {
                        stack ascii nameJ = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])sj.NameToken);
                        if (System.Text.Equals(nameI, nameJ))
                        {
                            duplicate = true;
                        }
                    }
                }
            }
        }
    }

    return duplicate;
}

// A binder diagnostic kind. Each is anchored at a source token by the list.
public enum BindDiagnosticCode
{
    DuplicateDeclaration,
    DuplicateParameter,
    DuplicateLocalInBlock,
    MissingModuleDeclaration,
    DuplicateModule,
    UnresolvedImport,
    AmbiguousImport,
    UnresolvedReference,
    UnresolvedType,
    NonBooleanCondition,
    NonBooleanOperand,
    ValueReturnedFromVoid,
    MissingReturnValue,
    DuplicateEnumVariant,
    BreakOutsideLoop,
    ContinueOutsideLoop,
    BecomeOutsideTailFunction,
    BecomeRequiresDirectCall,
    BecomeTargetNotTailCallable,
    BecomeEffectMismatch,
    BecomeAbiMismatch,
    DeadOnReturnUnknownParameter,
    DeadOnReturnNonMemoryBackedParameter,
    DeadOnReturnDuplicateParameter,
    DeadOnReturnForwardingMismatch,
    ArenaAllocationInLaw,
    ArenaValueEscapes,
    ArenaValueRetainedByCallee,
    RuntimeRecursionWithoutTailBecome,
    LawCallRequiresLaw,
    FiniteCallRequiresFinite,
    LawReturnOutputType,
    LawParameterOutputType,
    LawLocalStorageInLaw,
    LawGlobalStateRead,
    LawExternallyVisibleWrite,
    LawDynamicStorageAllocation,
    LawDynamicStorageMutation,
    FiniteRecursiveCycle,
    LayoutControlInvalid,
    FfiLayoutUnsafeField,
    RecursiveInlineLayout,
    PackedFieldSafeBorrow,
    LayoutQueryInvalid,
    ExportedSurfaceInvalid,
    AbiBoundaryEnumType,
    CopyableAssertionInvalid,
    CopyableConstraintInvalid,
    BorrowLiveConflict,
    MoveAfterMove,
    DuplicateDestructorBlock,
    ReadOnlyDropMutatesSelf,
    MutDropWithoutSelfMutation,
    DestructorReturn,
    DestructorAllocation,
    DestructorDynamicStorageMutation,
    ConstructorFieldReadBeforeAssignment,
    ReadBeforeInitialization,
    AsmUnknownArchitecture,
    AsmInvalidRegister,
    AsmInvalidOperandBinding,
    AsmInvalidClobber,
    InvalidLinkName,
    DuplicateLinkName,
}

public enum BindDiagnosticSeverity
{
    Error,
    Warning,
}

public struct CopyabilityFactTable
{
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] CopyableFlags;
    internal dynamic u32[0 max] StateFlags;

    CopyabilityFactTable()
    {
        self.NameTokens = new();
        self.CopyableFlags = new();
        self.StateFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow CopyabilityFactTable self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] NameTokenAt(borrow CopyabilityFactTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law bool IsCopyableAt(borrow CopyabilityFactTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flag = 0;
        if (index < self.CopyableFlags.Length)
        {
            flag = self.CopyableFlags[index];
        }

        return flag != 0;
    }

    internal law u32[0 max] StateAt(borrow CopyabilityFactTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] state = 0;
        if (index < self.StateFlags.Length)
        {
            state = self.StateFlags[index];
        }

        return state;
    }

    internal fn void SetCopyableAt(mut borrow CopyabilityFactTable self, u64[0 2 ** 63 - 1] index, bool isCopyable)
    {
        if (index < self.CopyableFlags.Length)
        {
            if (isCopyable)
            {
                self.CopyableFlags[index] = 1;
            }
            else
            {
                self.CopyableFlags[index] = 0;
            }
        }
    }

    internal fn void SetStateAt(mut borrow CopyabilityFactTable self, u64[0 2 ** 63 - 1] index, u32[0 max] state)
    {
        if (index < self.StateFlags.Length)
        {
            self.StateFlags[index] = state;
        }
    }

    internal fn System.Memory.MemoryStatus AppendPending(mut borrow CopyabilityFactTable self, u32[0 max] nameToken)
    {
        if (!self.NameTokens.TryReserve(1)
            || !self.CopyableFlags.TryReserve(1)
            || !self.StateFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.CopyableFlags[self.CopyableFlags.Length] = 0;
        init self.StateFlags[self.StateFlags.Length] = 0;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow CopyabilityFactTable self, u32[0 max] nameToken, bool isCopyable)
    {
        if (!self.NameTokens.TryReserve(1)
            || !self.CopyableFlags.TryReserve(1)
            || !self.StateFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        if (isCopyable)
        {
            init self.CopyableFlags[self.CopyableFlags.Length] = 1;
        }
        else
        {
            init self.CopyableFlags[self.CopyableFlags.Length] = 0;
        }

        init self.StateFlags[self.StateFlags.Length] = 2;
        return System.Memory.MemoryStatus.Ok;
    }
}

// The diagnostics produced by binding a compilation unit, in discovery order:
// each carries a code and the source token it is anchored at.
public struct BindDiagnosticList
{
    internal dynamic BindDiagnosticCode Codes;
    internal dynamic BindDiagnosticSeverity Severities;
    internal dynamic u32[0 max] Tokens;

    BindDiagnosticList()
    {
        self.Codes = new();
        self.Severities = new();
        self.Tokens = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow BindDiagnosticList self)
    {
        return self.Codes.Length;
    }

    public law BindDiagnosticCode CodeAt(borrow BindDiagnosticList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut BindDiagnosticCode code = BindDiagnosticCode.DuplicateDeclaration;
        if (index < self.Codes.Length)
        {
            code = self.Codes[index];
        }

        return code;
    }

    public law BindDiagnosticSeverity SeverityAt(borrow BindDiagnosticList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut BindDiagnosticSeverity severity = BindDiagnosticSeverity.Error;
        if (index < self.Severities.Length)
        {
            severity = self.Severities[index];
        }

        return severity;
    }

    public law u32[0 max] TokenAt(borrow BindDiagnosticList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.Tokens.Length)
        {
            token = self.Tokens[index];
        }

        return token;
    }

    // The number of diagnostics with code `code`.
    public law u32[0 max] CountOf(borrow BindDiagnosticList self, BindDiagnosticCode code)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Codes.Length;
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.CodeAt(index) == code)
            {
                total = (u32[0 max])(total + 1);
            }
        }

        return total;
    }

    public law u32[0 max] ErrorCount(borrow BindDiagnosticList self)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Codes.Length;
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.SeverityAt(index) == BindDiagnosticSeverity.Error)
            {
                total = (u32[0 max])(total + 1);
            }
        }

        return total;
    }

    public law u32[0 max] WarningCount(borrow BindDiagnosticList self)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Codes.Length;
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.SeverityAt(index) == BindDiagnosticSeverity.Warning)
            {
                total = (u32[0 max])(total + 1);
            }
        }

        return total;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow BindDiagnosticList self, BindDiagnosticCode code, u32[0 max] token)
    {
        return self.AppendWithSeverity(code, BindDiagnosticSeverity.Error, token);
    }

    internal fn System.Memory.MemoryStatus AppendWarning(mut borrow BindDiagnosticList self, BindDiagnosticCode code, u32[0 max] token)
    {
        return self.AppendWithSeverity(code, BindDiagnosticSeverity.Warning, token);
    }

    internal fn System.Memory.MemoryStatus AppendWithSeverity(mut borrow BindDiagnosticList self, BindDiagnosticCode code, BindDiagnosticSeverity severity, u32[0 max] token)
    {
        if (!self.Codes.TryReserve(1)
            || !self.Severities.TryReserve(1)
            || !self.Tokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Codes[self.Codes.Length] = code;
        init self.Severities[self.Severities.Length] = severity;
        init self.Tokens[self.Tokens.Length] = token;
        return System.Memory.MemoryStatus.Ok;
    }
}

