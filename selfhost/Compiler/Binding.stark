    public law TypedDeclarationStorageKind StorageKindAt(borrow TypedLocalSymbolTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedDeclarationStorageKind kind = TypedDeclarationStorageKind.None;
        if (index < self.StorageKinds.Length)
        {
            kind = self.StorageKinds[index];
        }

        return kind;
