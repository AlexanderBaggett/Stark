    public law bool HasBodyAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagHasBody()); }
    public law bool ReadsArgumentMemoryAt(borrow TypedFunctionEffectSummaryTable self, u64[0 2 ** 63 - 1] index) { return TypedDeclFlagPresent(self.EffectFlagsAt(index), TypedFunctionEffectFlagReadsArgumentMemory()); }
