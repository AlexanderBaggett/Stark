{
    return (flags & flag) != 0;
}

public struct TypedDeclarationSymbolTable
{
    internal dynamic u32[0 max] ModuleSymbolIndices;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] KeywordTokens;
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] EndTokens;
    internal dynamic u32[0 max] DeclIndices;
    internal dynamic DeclarationKind DeclarationKinds;
    internal dynamic TypedDeclarationSymbolClass Classes;
    internal dynamic TypedModuleSymbolVisibility Visibilities;
    internal dynamic TypedDeclarationFunctionKind FunctionKinds;
    internal dynamic TypedDeclarationStorageKind StorageKinds;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic u32[0 max] ParamCounts;
    internal dynamic u32[0 max] LinkNameValueTokens;
    internal dynamic u32[0 max] AbiNameTokens;
    internal dynamic u32[0 max] AsmArchitectureTokens;
    internal dynamic u32[0 max] AsmInputCounts;
    internal dynamic u32[0 max] AsmOutputCounts;
    internal dynamic u32[0 max] AsmClobberCounts;
    internal dynamic u32[0 max] Flags;

    TypedDeclarationSymbolTable()
    {
        self.ModuleSymbolIndices = new();
        self.NameTokens = new();
        self.KeywordTokens = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.DeclIndices = new();
        self.DeclarationKinds = new();
        self.Classes = new();
        self.Visibilities = new();
        self.FunctionKinds = new();
        self.StorageKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
