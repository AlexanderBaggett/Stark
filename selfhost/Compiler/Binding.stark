    public law u32[0 max] FunctionCount(borrow TypedDeclarationSymbolTable self)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.ClassAt(index) == TypedDeclarationSymbolClass.Function)
            {
                total = (u32[0 max])(total + 1);
            }
        }

        return total;
    }

    public law u32[0 max] ExportCount(borrow TypedDeclarationSymbolTable self)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.VisibilityAt(index) == TypedModuleSymbolVisibility.Export)
            {
                total = (u32[0 max])(total + 1);
            }
        }

        return total;
    }

    public law u32[0 max] FfiCount(borrow TypedDeclarationSymbolTable self)
    {
        stack mut u32[0 max] total = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.IsFfiAt(index))
            {
                total = (u32[0 max])(total + 1);
            }
        }

        return total;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedDeclarationSymbolTable self,
        u32[0 max] moduleSymbolIndexPlusOne,
        DeclItem item,
        u32[0 max] declIndex,
        TypedDeclarationSymbolClass class,
        TypedModuleSymbolVisibility visibility,
        TypedDeclarationFunctionKind functionKind,
        TypedDeclarationStorageKind storageKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] paramCount,
        u32[0 max] linkNameValueToken,
        u32[0 max] abiNameToken,
        u32[0 max] asmArchitectureToken,
        u32[0 max] asmInputCount,
        u32[0 max] asmOutputCount,
        u32[0 max] asmClobberCount,
        u32[0 max] flags)
    {
        if (!self.ModuleSymbolIndices.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.DeclIndices.TryReserve(1)
            || !self.DeclarationKinds.TryReserve(1)
            || !self.Classes.TryReserve(1)
            || !self.Visibilities.TryReserve(1)
            || !self.FunctionKinds.TryReserve(1)
            || !self.StorageKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.ParamCounts.TryReserve(1)
            || !self.LinkNameValueTokens.TryReserve(1)
            || !self.AbiNameTokens.TryReserve(1)
            || !self.AsmArchitectureTokens.TryReserve(1)
            || !self.AsmInputCounts.TryReserve(1)
            || !self.AsmOutputCounts.TryReserve(1)
            || !self.AsmClobberCounts.TryReserve(1)
            || !self.Flags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.ModuleSymbolIndices[self.ModuleSymbolIndices.Length] = moduleSymbolIndexPlusOne;
        init self.NameTokens[self.NameTokens.Length] = item.NameToken;
        init self.KeywordTokens[self.KeywordTokens.Length] = item.KeywordToken;
        init self.StartTokens[self.StartTokens.Length] = item.StartToken;
        init self.EndTokens[self.EndTokens.Length] = item.EndToken;
        init self.DeclIndices[self.DeclIndices.Length] = declIndex;
        init self.DeclarationKinds[self.DeclarationKinds.Length] = item.Kind;
        init self.Classes[self.Classes.Length] = class;
        init self.Visibilities[self.Visibilities.Length] = visibility;
        init self.FunctionKinds[self.FunctionKinds.Length] = functionKind;
        init self.StorageKinds[self.StorageKinds.Length] = storageKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.ParamCounts[self.ParamCounts.Length] = paramCount;
        init self.LinkNameValueTokens[self.LinkNameValueTokens.Length] = linkNameValueToken;
        init self.AbiNameTokens[self.AbiNameTokens.Length] = abiNameToken;
        init self.AsmArchitectureTokens[self.AsmArchitectureTokens.Length] = asmArchitectureToken;
        init self.AsmInputCounts[self.AsmInputCounts.Length] = asmInputCount;
        init self.AsmOutputCounts[self.AsmOutputCounts.Length] = asmOutputCount;
        init self.AsmClobberCounts[self.AsmClobberCounts.Length] = asmClobberCount;
        init self.Flags[self.Flags.Length] = flags;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal finite law TypedDeclarationSymbolClass DeclarationSymbolClass(DeclarationKind kind)
{
    switch (kind)
    {
        case DeclarationKind.Struct:
            return TypedDeclarationSymbolClass.Type;
        case DeclarationKind.Record:
            return TypedDeclarationSymbolClass.Type;
        case DeclarationKind.Enum:
            return TypedDeclarationSymbolClass.Type;
        case DeclarationKind.Trait:
            return TypedDeclarationSymbolClass.Type;
        case DeclarationKind.Doctrine:
            return TypedDeclarationSymbolClass.Type;
        case DeclarationKind.Function:
            return TypedDeclarationSymbolClass.Function;
        case DeclarationKind.Const:
            return TypedDeclarationSymbolClass.Value;
        case DeclarationKind.Static:
            return TypedDeclarationSymbolClass.Value;
        case DeclarationKind.GlobalVariable:
            return TypedDeclarationSymbolClass.Value;
        case DeclarationKind.Alias:
            return TypedDeclarationSymbolClass.Alias;
        case DeclarationKind.Unknown:
            return TypedDeclarationSymbolClass.Unknown;
    }
}

internal finite law TypedDeclarationStorageKind DeclarationStorageKind(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind == DeclarationKind.Const)
    {
        return TypedDeclarationStorageKind.Const;
    }

    if (item.Kind == DeclarationKind.Static)
    {
        return TypedDeclarationStorageKind.Static;
    }

    if (item.Kind == DeclarationKind.GlobalVariable)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])item.KeywordToken);
        switch (kind)
        {
            case TokenKind.Heap:
                return TypedDeclarationStorageKind.Heap;
            case TokenKind.Stack:
                return TypedDeclarationStorageKind.Stack;
            case TokenKind.Register:
                return TypedDeclarationStorageKind.Register;
            case TokenKind.Arena:
                return TypedDeclarationStorageKind.Arena;
            default:
                return TypedDeclarationStorageKind.None;
        }
    }

    return TypedDeclarationStorageKind.None;
}

internal finite law TypedDeclarationFunctionKind DeclarationFunctionKind(borrow FunctionSignature signature)
{
    if (signature.FiniteKind() && signature.LawKind())
    {
        return TypedDeclarationFunctionKind.FiniteLaw;
    }

    if (signature.FiniteKind())
    {
        return TypedDeclarationFunctionKind.Finite;
    }

    if (signature.LawKind())
    {
        return TypedDeclarationFunctionKind.Law;
    }

    return TypedDeclarationFunctionKind.Fn;
}

internal finite law u32[0 max] FirstTypeTokenInSpan(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] token = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && token == 0 && IsTypeStartToken(kind))
        {
            token = scan;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return token;
}

internal finite law u32[0 max] LastTypeHeadIdentifierInSpan(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] token = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && kind == TokenKind.Identifier)
        {
            token = scan;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return token;
}

internal finite law u32[0 max] AliasAssignToken(borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = item.KeywordToken;
    while willexit (scan <= item.EndToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Assign)
        {
            return scan;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal finite law u32[0 max] FfiAbiNameToken(borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Ffi)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen
                && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 2)) == TokenKind.Identifier)
            {
                return (u32[0 max])(scan + 2);
            }

            return 0;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal finite law u32[0 max] LinkNameValueTokenForDeclaration(ascii source, borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return 0;
        }

        if (IsLinkNameAttribute(source, stream, scan))
        {
            return LinkNameValueToken(stream, scan, attrEnd);
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return 0;
}

internal finite law bool DeclarationStorageIsMutable(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind != DeclarationKind.Static && item.Kind != DeclarationKind.GlobalVariable)
    {
        return false;
    }

    stack mut u32[0 max] scan = (u32[0 max])(item.KeywordToken + 1);
    while willexit (scan < item.NameToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Mut)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law u32[0 max] DeclarationBaseFlags(ascii source, borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] flags = 0;
    if (stream.KindAt((u64[0 2 ** 63 - 1])item.EndToken) == TokenKind.Semi)
    {
        flags = flags | TypedDeclFlagExternal();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Unsafe))
    {
        flags = flags | TypedDeclFlagUnsafe();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Ffi))
    {
        flags = flags | TypedDeclFlagFfi();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Asm))
    {
        flags = flags | TypedDeclFlagAsm();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Varargs))
    {
        flags = flags | TypedDeclFlagVarargs();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Inline))
    {
        flags = flags | TypedDeclFlagInline();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Noinline))
    {
        flags = flags | TypedDeclFlagNoInline();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Inlinehint))
    {
        flags = flags | TypedDeclFlagInlineHint();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Hot))
    {
        flags = flags | TypedDeclFlagHot();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Cold))
    {
        flags = flags | TypedDeclFlagCold();
    }

    if (DeclarationPreludeHasToken(stream, item, TokenKind.Strictfp))
    {
        flags = flags | TypedDeclFlagStrictFp();
    }

    if (LinkNameValueTokenForDeclaration(source, stream, item) != 0)
    {
        flags = flags | TypedDeclFlagLinkName();
    }

    if (IsCAbiFfiFunction(source, stream, item))
    {
        flags = flags | TypedDeclFlagCAbi();
    }

    if (DeclarationStorageIsMutable(stream, item))
    {
        flags = flags | TypedDeclFlagMutableStorage();
    }

    return flags;
}

internal fn System.Memory.MemoryStatus AppendTypedDeclarationSymbol(
    mut borrow TypedDeclarationSymbolTable declarations,
    ascii source,
    borrow TokenStream stream,
    borrow TypedModuleSymbolTable moduleSymbols,
    borrow DeclarationList decls,
    u64[0 2 ** 63 - 1] moduleSymbolIndex)
{
    stack u32[0 max] declIndex = moduleSymbols.DeclIndexAt(moduleSymbolIndex);
    stack DeclItem item = decls.ItemAt((u64[0 2 ** 63 - 1])declIndex);
    stack TypedDeclarationSymbolClass class = DeclarationSymbolClass(item.Kind);
    stack TypedModuleSymbolVisibility visibility = moduleSymbols.VisibilityAt(moduleSymbolIndex);
    stack mut TypedDeclarationFunctionKind functionKind = TypedDeclarationFunctionKind.Fn;
    stack TypedDeclarationStorageKind storageKind = DeclarationStorageKind(stream, item);
    stack mut u32[0 max] typeHeadToken = 0;
    stack mut u32[0 max] typePrimaryToken = 0;
    stack mut u32[0 max] typeStartToken = 0;
    stack mut u32[0 max] typeEndToken = 0;
    stack mut u32[0 max] paramCount = 0;
    stack u32[0 max] linkNameValueToken = LinkNameValueTokenForDeclaration(source, stream, item);
    stack u32[0 max] abiNameToken = FfiAbiNameToken(stream, item);
    stack mut u32[0 max] asmArchitectureToken = 0;
    stack mut u32[0 max] asmInputCount = 0;
    stack mut u32[0 max] asmOutputCount = 0;
    stack mut u32[0 max] asmClobberCount = 0;
    stack mut u32[0 max] flags = DeclarationBaseFlags(source, stream, item);

    if (class == TypedDeclarationSymbolClass.Type)
    {
        typeHeadToken = item.NameToken;
        typePrimaryToken = item.NameToken;
        typeStartToken = item.NameToken;
        typeEndToken = (u32[0 max])(item.NameToken + 1);
    }
    else if (item.Kind == DeclarationKind.Function)
    {
        stack mut FunctionSignature signature = new();
        switch (ParseFunctionSignature(stream, item.KeywordToken))
        {
            case ParseResult<FunctionSignature>.Err(var signatureError):
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
            case ParseResult<FunctionSignature>.Ok(var parsedSignature):
                signature = parsedSignature;
        }

        functionKind = DeclarationFunctionKind(signature);
        typeHeadToken = signature.ReturnType();
        typePrimaryToken = signature.ReturnTypeTokenAt();
        typeStartToken = signature.ReturnTypeStartTokenAt();
        typeEndToken = signature.ReturnTypeEndTokenAt();
        paramCount = (u32[0 max])signature.ParamCount();
        if (signature.TailCallable())
        {
            flags = flags | TypedDeclFlagTailCallable();
        }

        if (signature.HasAsm())
        {
            asmArchitectureToken = signature.AsmArchitectureToken();
            asmInputCount = signature.AsmInputCount();
            asmOutputCount = signature.AsmOutputCount();
            asmClobberCount = signature.AsmClobberCount();
        }
    }
    else if (class == TypedDeclarationSymbolClass.Value && item.NameToken != 0)
    {
        typeStartToken = FindVariableTypeTokenForBinding(stream, (u32[0 max])(item.KeywordToken + 1));
        if (typeStartToken != 0 && typeStartToken < item.NameToken)
        {
            typePrimaryToken = typeStartToken;
            typeEndToken = item.NameToken;
            typeHeadToken = LastTypeHeadIdentifierInSpan(stream, typeStartToken, item.NameToken);
        }
    }
    else if (item.Kind == DeclarationKind.Alias)
    {
        stack u32[0 max] assign = AliasAssignToken(stream, item);
        if (assign != 0 && assign < item.EndToken)
        {
            typeStartToken = (u32[0 max])(assign + 1);
            typeEndToken = item.EndToken;
            typePrimaryToken = FirstTypeTokenInSpan(stream, typeStartToken, typeEndToken);
            typeHeadToken = LastTypeHeadIdentifierInSpan(stream, typeStartToken, typeEndToken);
        }
    }

    return declarations.Append(
        (u32[0 max])(moduleSymbolIndex + 1),
        item,
        declIndex,
        class,
        visibility,
        functionKind,
        storageKind,
        typeHeadToken,
        typePrimaryToken,
        typeStartToken,
        typeEndToken,
        paramCount,
        linkNameValueToken,
        abiNameToken,
        asmArchitectureToken,
        asmInputCount,
        asmOutputCount,
        asmClobberCount,
        flags);
}

public fn BindResult<TypedDeclarationSymbolTable> BuildTypedDeclarationSymbols(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList decls,
    borrow TypedModuleSymbolTable moduleSymbols)
{
    stack mut TypedDeclarationSymbolTable declarations = new();
    stack u64[0 2 ** 63 - 1] count = moduleSymbols.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedDeclarationSymbol(declarations, source, stream, moduleSymbols, decls, index))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return BindResult<TypedDeclarationSymbolTable>.Err(BindError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return BindResult<TypedDeclarationSymbolTable>.Ok(declarations);
}

public enum TypedMemberSymbolKind
{
    Field,
    Method,
    EnumVariant,
    AssociatedAlias,
    Unknown,
}

internal inline finite law u32[0 max] TypedMemberFlagStatic()
{
    return 32768;
}

internal inline finite law u32[0 max] TypedMemberFlagFieldOffset()
{
    return 65536;
}

internal inline finite law u32[0 max] TypedMemberFlagOkRole()
{
    return 131072;
}

internal inline finite law u32[0 max] TypedMemberFlagErrRole()
{
    return 262144;
}

internal inline finite law u32[0 max] TypedMemberFlagErrorFunnel()
{
    return 524288;
}

