    u32[0 max] NewExpressionCount;
    u32[0 max] AssignmentExpressionCount;
    u32[0 max] LocalDeclarationCount;
    u32[0 max] ReturnCount;
    u32[0 max] LoopCount;
    u32[0 max] BranchCount;
    u32[0 max] Flags;

    TypedFunctionBodyShape()
    {
        self.StatementCount = 0;
        self.TopLevelStatementCount = 0;
        self.ExpressionNodeCount = 0;
        self.CallExpressionCount = 0;
        self.NewExpressionCount = 0;
        self.AssignmentExpressionCount = 0;
        self.LocalDeclarationCount = 0;
        self.ReturnCount = 0;
        self.LoopCount = 0;
        self.BranchCount = 0;
        self.Flags = 0;
    }
}

