        stack mut u32[0 max] size = 0;
        if (index < self.Sizes.Length)
        {
            size = self.Sizes[index];
        }

        return size;
    }

    internal law CAbiStorageKind KindAt(borrow CAbiStorageUnitList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut CAbiStorageKind kind = CAbiStorageKind.Unknown;
        if (index < self.Kinds.Length)
        {
            kind = self.Kinds[index];
        }

        return kind;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow CAbiStorageUnitList self, u32[0 max] offset, u32[0 max] size, CAbiStorageKind kind)
    {
        if (!self.Offsets.TryReserve(1)
            || !self.Sizes.TryReserve(1)
            || !self.Kinds.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Offsets[self.Offsets.Length] = offset;
        init self.Sizes[self.Sizes.Length] = size;
        init self.Kinds[self.Kinds.Length] = kind;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal finite law bool AttributeListContainsStructLayoutC(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd)
{
    stack mut u32[0 max] scan = (u32[0 max])(attrStart + 1);
    while willexit (scan < attrEnd)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Identifier
            && TokenTextEquals(source, stream, scan, "StructLayout")
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 2)) == TokenKind.Identifier
            && TokenTextEquals(source, stream, (u32[0 max])(scan + 2), "C")
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 3)) == TokenKind.RParen)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool AttributeListContainsStructLayoutExplicit(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd)
{
    stack mut u32[0 max] scan = (u32[0 max])(attrStart + 1);
    while willexit (scan < attrEnd)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Identifier
            && TokenTextEquals(source, stream, scan, "StructLayout")
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 2)) == TokenKind.Identifier
            && TokenTextEquals(source, stream, (u32[0 max])(scan + 2), "Explicit")
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 3)) == TokenKind.RParen)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool DeclarationHasStructLayoutCAttribute(ascii source, borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return false;
        }

        if (AttributeListContainsStructLayoutC(source, stream, scan, attrEnd))
        {
            return true;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return false;
}

internal finite law bool DeclarationHasStructLayoutExplicitAttribute(ascii source, borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = AttributeEndToken(stream, scan);
        if (attrEnd <= scan)
        {
            return false;
        }

        if (AttributeListContainsStructLayoutExplicit(source, stream, scan, attrEnd))
        {
            return true;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return false;
}

internal finite law bool FfiAbiNameIsCFamily(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    return TokenTextEquals(source, stream, token, "c")
        || TokenTextEquals(source, stream, token, "cdecl")
        || TokenTextEquals(source, stream, token, "sysv")
        || TokenTextEquals(source, stream, token, "win64");
}

internal finite law bool IsCAbiFfiFunction(ascii source, borrow TokenStream stream, DeclItem item)
{
    if (item.Kind != DeclarationKind.Function || DeclarationPreludeHasToken(stream, item, TokenKind.Asm))
    {
        return false;
    }

    stack mut u32[0 max] scan = item.StartToken;
    while willexit (scan < item.KeywordToken)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Ffi)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
            {
                return stream.KindAt((u64[0 2 ** 63 - 1])(scan + 2)) == TokenKind.Identifier
                    && FfiAbiNameIsCFamily(source, stream, (u32[0 max])(scan + 2));
            }

            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law u32[0 max] AlignUp(u32[0 max] value, u32[0 max] alignment)
{
    if (alignment <= 1)
    {
        return value;
    }

    stack u32[0 max] remainder = value % alignment;
    if (remainder == 0)
    {
        return value;
    }

    return (u32[0 max])(value + alignment - remainder);
}

internal finite law CAbiFieldInfo KnownCAbiField(u32[0 max] sizeBytes, u32[0 max] alignBytes, CAbiStorageKind kind)
{
    stack mut CAbiFieldInfo info = new();
    info.Known = true;
    info.SizeBytes = sizeBytes;
    info.AlignBytes = alignBytes;
    info.Kind = kind;
    return info;
}

internal finite law CAbiFieldInfo ClassifyCAbiScalarField(ascii source, borrow TokenStream stream, u32[0 max] typeToken)
{
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    if (kind == TokenKind.Bool)
    {
        return KnownCAbiField(1, 1, CAbiStorageKind.Integer);
    }

    if (kind == TokenKind.Rawptr || kind == TokenKind.Rawmutptr || kind == TokenKind.Fnptr)
    {
        return KnownCAbiField(8, 8, CAbiStorageKind.Integer);
    }

    if (kind == TokenKind.FloatType)
    {
        if (TokenTextEquals(source, stream, typeToken, "f32"))
        {
            return KnownCAbiField(4, 4, CAbiStorageKind.Sse);
        }

        if (TokenTextEquals(source, stream, typeToken, "f64"))
        {
            return KnownCAbiField(8, 8, CAbiStorageKind.Sse);
        }
    }

    if (kind == TokenKind.IntegerType)
    {
        if (TokenTextEquals(source, stream, typeToken, "i8") || TokenTextEquals(source, stream, typeToken, "u8"))
        {
            return KnownCAbiField(1, 1, CAbiStorageKind.Integer);
        }

        if (TokenTextEquals(source, stream, typeToken, "i16") || TokenTextEquals(source, stream, typeToken, "u16"))
        {
            return KnownCAbiField(2, 2, CAbiStorageKind.Integer);
        }

        if (TokenTextEquals(source, stream, typeToken, "i32") || TokenTextEquals(source, stream, typeToken, "u32"))
        {
            return KnownCAbiField(4, 4, CAbiStorageKind.Integer);
        }

        if (TokenTextEquals(source, stream, typeToken, "i64") || TokenTextEquals(source, stream, typeToken, "u64"))
        {
            return KnownCAbiField(8, 8, CAbiStorageKind.Integer);
        }
    }

    stack mut CAbiFieldInfo unknown = new();
    return unknown;
}

internal finite law AbiCarrierKind IntegerCarrierForSize(u32[0 max] sizeBytes)
{
    if (sizeBytes <= 1)
    {
        return AbiCarrierKind.I8;
    }

    if (sizeBytes <= 2)
    {
        return AbiCarrierKind.I16;
    }

    if (sizeBytes <= 4)
    {
        return AbiCarrierKind.I32;
    }

    if (sizeBytes <= 8)
    {
        return AbiCarrierKind.I64;
    }

    return AbiCarrierKind.None;
}

internal finite law AbiCarrierKind SlotCarrierForUnits(borrow CAbiStorageUnitList units, u32[0 max] slotStart, u32[0 max] slotSize)
{
    stack mut bool any = false;
    stack mut bool anyInteger = false;
    stack mut u32[0 max] sseCount = 0;
    stack mut u32[0 max] firstOffset = 0;
    stack mut u32[0 max] firstSize = 0;
    stack mut u32[0 max] secondOffset = 0;
    stack mut u32[0 max] secondSize = 0;
    stack u32[0 max] slotEnd = (u32[0 max])(slotStart + slotSize);
    stack u64[0 2 ** 63 - 1] count = units.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack u32[0 max] unitOffset = units.OffsetAt(index);
        stack u32[0 max] unitSize = units.SizeAt(index);
        stack u32[0 max] unitEnd = (u32[0 max])(unitOffset + unitSize);
        if (unitOffset < slotEnd && unitEnd > slotStart)
        {
            any = true;
            if (unitOffset < slotStart || unitEnd > slotEnd)
            {
                return AbiCarrierKind.None;
            }

            if (units.KindAt(index) == CAbiStorageKind.Integer)
            {
                anyInteger = true;
            }
            else if (units.KindAt(index) == CAbiStorageKind.Sse)
            {
                if (sseCount == 0)
                {
                    firstOffset = unitOffset;
                    firstSize = unitSize;
                }
                else if (sseCount == 1)
                {
                    secondOffset = unitOffset;
                    secondSize = unitSize;
                }

                sseCount = (u32[0 max])(sseCount + 1);
            }
        }
    }

    if (!any || anyInteger)
    {
        return IntegerCarrierForSize(slotSize);
    }

    if (sseCount == 1)
    {
        if (firstOffset == slotStart && firstSize == 4)
        {
            return AbiCarrierKind.F32;
        }

        if (firstOffset == slotStart && firstSize == 8)
        {
            return AbiCarrierKind.F64;
        }
    }

    if (sseCount == 2
        && firstOffset == slotStart
        && secondOffset == (u32[0 max])(slotStart + 4)
        && firstSize == 4
        && secondSize == 4)
    {
        return AbiCarrierKind.Vector2F32;
    }

    return AbiCarrierKind.None;
}

internal fn System.Memory.MemoryStatus ClassifyCLayoutAggregate(ascii source, borrow TokenStream stream, u32[0 max] structKeyword, mut borrow CAbiAggregateCarrierFacts facts)
{
    stack mut FieldList fields = new();
    switch (ParseStructFields(stream, structKeyword))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            facts.SetUnsupported();
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<FieldList>.Ok(var parsed):
            fields = parsed;
    }

    stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
    if (fieldCount == 0)
    {
        facts.SetUnsupported();
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut CAbiStorageUnitList units = new();
    stack mut u32[0 max] offset = 0;
    stack mut u32[0 max] maxAlign = 1;
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < fieldCount; index += 1)
    {
        stack CAbiFieldInfo info = ClassifyCAbiScalarField(source, stream, fields.TypePrimaryAt(index));
        if (!info.Known)
        {
            facts.SetUnsupported();
            return System.Memory.MemoryStatus.Ok;
        }

        offset = AlignUp(offset, info.AlignBytes);
        if (info.AlignBytes > maxAlign)
        {
            maxAlign = info.AlignBytes;
        }

        switch (units.Append(offset, info.SizeBytes, info.Kind))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }

        offset = (u32[0 max])(offset + info.SizeBytes);
    }

    stack u32[0 max] sizeBytes = AlignUp(offset, maxAlign);
    if (sizeBytes == 0)
    {
        facts.SetUnsupported();
        return System.Memory.MemoryStatus.Ok;
    }

    if (sizeBytes > 16)
    {
        facts.SetIndirect(sizeBytes, maxAlign);
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] carrierCount = 0;
    stack mut AbiCarrierKind carrier0 = AbiCarrierKind.None;
    stack mut AbiCarrierKind carrier1 = AbiCarrierKind.None;
    stack mut AbiCarrierKind carrier2 = AbiCarrierKind.None;
    stack mut AbiCarrierKind carrier3 = AbiCarrierKind.None;
    stack mut u32[0 max] slotStart = 0;
    while willexit (slotStart < sizeBytes)
    {
        stack mut u32[0 max] slotSize = 8;
        if ((u32[0 max])(sizeBytes - slotStart) < 8)
        {
            slotSize = (u32[0 max])(sizeBytes - slotStart);
        }

        stack AbiCarrierKind carrier = SlotCarrierForUnits(units, slotStart, slotSize);
        if (carrier == AbiCarrierKind.None)
        {
            facts.SetUnsupported();
            return System.Memory.MemoryStatus.Ok;
        }

        switch (carrierCount)
        {
            case 0:
                carrier0 = carrier;
            case 1:
                carrier1 = carrier;
            case 2:
                carrier2 = carrier;
            case 3:
                carrier3 = carrier;
            default:
                facts.SetUnsupported();
                return System.Memory.MemoryStatus.Ok;
        }

        carrierCount = (u32[0 max])(carrierCount + 1);
        slotStart = (u32[0 max])(slotStart + 8);
    }

    facts.SetDirect(sizeBytes, maxAlign, carrierCount, carrier0, carrier1, carrier2, carrier3);
    return System.Memory.MemoryStatus.Ok;
}

public fn BindResult<CLayoutAggregateTable> BuildCLayoutAggregateTable(ascii source, borrow TokenStream stream, borrow DeclarationList decls)
{
    stack mut CLayoutAggregateTable table = new();
    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if ((item.Kind == DeclarationKind.Struct || item.Kind == DeclarationKind.Record)
            && item.NameToken != 0
            && DeclarationHasStructLayoutCAttribute(source, stream, item))
        {
            stack mut CAbiAggregateCarrierFacts facts = new();
            switch (ClassifyCLayoutAggregate(source, stream, item.KeywordToken, facts))
            {
                case System.Memory.MemoryStatus.Err(var classifyError):
                    return BindResult<CLayoutAggregateTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (table.Append(item.NameToken, item.KeywordToken, facts))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return BindResult<CLayoutAggregateTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return BindResult<CLayoutAggregateTable>.Ok(table);
}

internal fn u32[0 max] LookupCLayoutAggregateByTypeToken(borrow CLayoutAggregateTable table, ascii source, borrow TokenStream stream, u32[0 max] typeToken)
{
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, table.NameTokenAt(index), typeToken))
        {
            return (u32[0 max])(index + 1);
        }
    }

    return 0;
}

public fn BindResult<CAbiAggregateBoundaryTable> BuildCAbiAggregateBoundaryTable(ascii source, borrow TokenStream stream, borrow DeclarationList decls)
{
    stack mut CAbiAggregateBoundaryTable boundaries = new();
    stack mut CLayoutAggregateTable aggregates = new();
    switch (BuildCLayoutAggregateTable(source, stream, decls))
    {
        case BindResult<CLayoutAggregateTable>.Err(var aggregateError):
            return BindResult<CAbiAggregateBoundaryTable>.Err(BindError.OutOfMemory);
        case BindResult<CLayoutAggregateTable>.Ok(var table):
            aggregates = table;
    }

    stack u64[0 2 ** 63 - 1] count = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (IsCAbiFfiFunction(source, stream, item))
        {
            stack mut FunctionSignature signature = new();
            stack mut bool parsedSignature = false;
            switch (ParseFunctionSignature(stream, item.KeywordToken))
            {
                case ParseResult<FunctionSignature>.Err(var sigError):
                    parsedSignature = false;
                case ParseResult<FunctionSignature>.Ok(var parsed):
                    signature = parsed;
                    parsedSignature = true;
            }

            if (parsedSignature)
            {
                stack u32[0 max] returnHead = signature.ReturnType();
                stack u32[0 max] returnAggregate = LookupCLayoutAggregateByTypeToken(aggregates, source, stream, returnHead);
                if (returnAggregate != 0)
                {
                    stack CAbiAggregateCarrierFacts returnFacts = aggregates.FactsAt((u64[0 2 ** 63 - 1])(returnAggregate - 1));
                    switch (boundaries.Append(CAbiAggregateBoundaryKind.Return, signature.Name(), returnHead, 0, returnFacts))
                    {
                        case System.Memory.MemoryStatus.Err(var returnAppendError):
                            return BindResult<CAbiAggregateBoundaryTable>.Err(BindError.OutOfMemory);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
                for willexit (stack mut u64[0 2 ** 63 - 1] p = 0; p < paramCount; p += 1)
                {
                    stack u32[0 max] paramHead = signature.ParamTypeAt(p);
                    stack u32[0 max] paramAggregate = LookupCLayoutAggregateByTypeToken(aggregates, source, stream, paramHead);
                    if (paramAggregate != 0)
                    {
                        stack CAbiAggregateCarrierFacts paramFacts = aggregates.FactsAt((u64[0 2 ** 63 - 1])(paramAggregate - 1));
                        switch (boundaries.Append(CAbiAggregateBoundaryKind.Parameter, signature.Name(), paramHead, (u32[0 max])p, paramFacts))
                        {
                            case System.Memory.MemoryStatus.Err(var paramAppendError):
                                return BindResult<CAbiAggregateBoundaryTable>.Err(BindError.OutOfMemory);
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }
                }
            }
        }
    }

    return BindResult<CAbiAggregateBoundaryTable>.Ok(boundaries);
}

// Emits a `DuplicateEnumVariant` diagnostic (anchored at the later variant name)
// for every enum variant whose name repeats an earlier one in the same enum —
// matching the host's STK3006 "declares variant 'V' more than once".
internal fn System.Memory.MemoryStatus CollectDuplicateEnumVariants(borrow VariantList variants, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = variants.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] later = 0; later < count; later += 1)
    {
        stack ascii laterName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])variants.NameTokenAt(later));
        stack mut bool repeats = false;
        for willexit (stack mut u64[0 2 ** 63 - 1] earlier = 0; earlier < later; earlier += 1)
        {
            stack ascii earlierName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])variants.NameTokenAt(earlier));
            if (System.Text.Equals(earlierName, laterName))
            {
                repeats = true;
            }
        }

        if (repeats)
        {
            switch (diags.Append(BindDiagnosticCode.DuplicateEnumVariant, variants.NameTokenAt(later)))
            {
                case System.Memory.MemoryStatus.Err(var error):
                    return System.Memory.MemoryStatus.Err(error);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// The declared type-primary token of the parameter/local that the reference at
// expression node `node` resolves to, read from the lexical `ReferenceTable`
// (which already honors shadowing and block scope). 0 when the node is not a
// reference to a scope symbol (a declaration/unbound reference has no scope type).
internal fn u32[0 max] ReferenceTypeTokenForNode(borrow ReferenceTable refs, borrow FunctionScope scope, u32[0 max] node)
{
    stack mut u32[0 max] typeToken = 0;
    stack u64[0 2 ** 63 - 1] count = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (refs.NodeAt(index) == node)
        {
            stack ReferenceKind kind = refs.KindAt(index);
            if (kind == ReferenceKind.Parameter || kind == ReferenceKind.Local)
            {
                stack u32[0 max] target = refs.TargetAt(index);
                if (target != 0)
                {
                    typeToken = scope.TypeTokenAt((u64[0 2 ** 63 - 1])(target - 1));
                }
            }
        }
    }

    return typeToken;
}

// The definition name token of the struct/record declaration named by
// `structNameToken` (matched by source text in the declaration table), or 0 when no
// such declaration exists. `ParseStructFields` can be driven from this name token
// (it scans forward to the struct's body `{`). Source-derived name slices are
// compared inline with `System.Text.Equals` (overlap-permitting).
internal fn u32[0 max] FindStructDefName(borrow DeclarationTable table, ascii source, borrow TokenStream stream, u32[0 max] structNameToken)
{
    if (structNameToken == 0)
    {
        return 0;
    }

    stack ascii structName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])structNameToken);
    stack mut u32[0 max] structDefName = 0;
    stack u64[0 2 ** 63 - 1] tableCount = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] t = 0; t < tableCount; t += 1)
    {
        stack ascii declName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(t));
        if (System.Text.Equals(declName, structName))
        {
            structDefName = table.NameTokenAt(t);
        }
    }

    return structDefName;
}

// The type-primary token of the data field named `fieldNameToken` of the struct/
// record named `structNameToken` (e.g. the `i32` in `struct S { i32 count; }`), or 0
// when not found — for value typing via `MapTypeToken`.
internal fn u32[0 max] StructFieldTypePrimary(borrow DeclarationTable table, ascii source, borrow TokenStream stream, u32[0 max] structNameToken, u32[0 max] fieldNameToken)
{
    stack u32[0 max] structDefName = FindStructDefName(table, source, stream, structNameToken);
    if (structDefName == 0 || fieldNameToken == 0)
    {
        return 0;
    }

    stack ascii fieldName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fieldNameToken);
    stack mut u32[0 max] primary = 0;
    switch (ParseStructFields(stream, structDefName))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return 0;
        case ParseResult<FieldList>.Ok(var fields):
            stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] f = 0; f < fieldCount; f += 1)
            {
                stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(f));
                if (System.Text.Equals(name, fieldName))
                {
                    primary = fields.TypePrimaryAt(f);
                }
            }
    }

    return primary;
}

// The user-type HEAD token of the data field named `fieldNameToken` of the struct
// named `structNameToken` (the field's own struct/record type name, e.g. `B` for a
// field `B b;`), or 0 when not found or the field type is a built-in. Used to chain
// member access — the head names the struct whose fields the next `.member` reads.
internal fn u32[0 max] StructFieldTypeHead(borrow DeclarationTable table, ascii source, borrow TokenStream stream, u32[0 max] structNameToken, u32[0 max] fieldNameToken)
{
    stack u32[0 max] structDefName = FindStructDefName(table, source, stream, structNameToken);
    if (structDefName == 0 || fieldNameToken == 0)
    {
        return 0;
    }

    stack ascii fieldName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fieldNameToken);
    stack mut u32[0 max] head = 0;
    switch (ParseStructFields(stream, structDefName))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return 0;
        case ParseResult<FieldList>.Ok(var fields):
            stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] f = 0; f < fieldCount; f += 1)
            {
                stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(f));
                if (System.Text.Equals(name, fieldName))
                {
                    head = fields.TypeHeadAt(f);
                }
            }
    }

    return head;
}

// The struct/record type-name token that expression `node` evaluates to, when it is
// a chain of identifier and member accesses over struct-typed values (e.g. `a` whose
// type is `A`, or `a.b` whose field `b` has type `B`): an identifier yields its
// declared type token; a `receiver.field` member yields the field's user-type head,
// resolved against the receiver's struct (recursively). 0 when the node is not such a
// chain or its type is not a known struct. Each recursion peels one `.member`, so it
// terminates on the finite expression chain.
internal fn u32[0 max] MemberStructNameToken(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, u32[0 max] node)
{
    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        return ReferenceTypeTokenForNode(refs, scope, node);
    }
    else if (kind == Compiler.Parsing.ExprKind.Member)
    {
        stack u32[0 max] receiverStruct = MemberStructNameToken(table, source, refs, scope, stream, body, body.ExprLeftAt(node));
        return StructFieldTypeHead(table, source, stream, receiverStruct, body.ExprTokenAt(node));
    }

    return 0;
}

// The type of expression node `node` in `body`: its shape type from
// `ClassifyExprType`, but when that is `Unknown`, the declared type of what the
// node resolves to: for an identifier, the symbol it lexically resolves to (via the
// reference table, respecting shadowing); for a member access `receiver.field` whose
// receiver is a struct/record-typed identifier, the field's declared type (looked up
// in that struct's declaration). This types `n` (an integer local) and `s.count`
// (an `i32` field) as `Int`.
internal fn ExprType TypedNodeType(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, u32[0 max] node)
{
    stack mut ExprType nodeType = ClassifyExprType(stream, body, node);
    if (nodeType == Compiler.Typing.ExprType.Unknown)
    {
        stack ExprKind kind = body.ExprKindAt(node);
        if (kind == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] typeToken = ReferenceTypeTokenForNode(refs, scope, node);
            if (typeToken != 0)
            {
                nodeType = MapTypeToken(stream, typeToken);
            }
        }
        else if (kind == Compiler.Parsing.ExprKind.Member)
        {
            // `receiver.field`: when the receiver resolves to a struct/record (an
            // identifier or a further member chain), type the access as the named
            // field's declared type.
            stack u32[0 max] structNameToken = MemberStructNameToken(table, source, refs, scope, stream, body, body.ExprLeftAt(node));
            stack u32[0 max] fieldPrimary = StructFieldTypePrimary(table, source, stream, structNameToken, body.ExprTokenAt(node));
            if (fieldPrimary != 0)
            {
                nodeType = MapTypeToken(stream, fieldPrimary);
            }
        }
    }

    return nodeType;
}

// Emits a `NonBooleanCondition` diagnostic (anchored at the condition's root
// token) for each `if`/`while`/`for` whose condition has a definite non-boolean
// type. A `for`'s condition is its statement expression (the middle clause), so
// references to its header-bound loop variable resolve in the loop scope.
internal fn System.Memory.MemoryStatus CollectNonBooleanConditions(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        if (item.Kind == StatementKind.If || item.Kind == StatementKind.While || item.Kind == StatementKind.For)
        {
            stack u32[0 max] root = body.ExprRootAt(index);
            if (root != 0)
            {
                stack ExprType conditionType = TypedNodeType(table, source, refs, scope, stream, body, root);
                if (IsDefiniteNonBoolean(conditionType))
                {
                    switch (diags.Append(BindDiagnosticCode.NonBooleanCondition, body.ExprTokenAt(root)))
                    {
                        case System.Memory.MemoryStatus.Err(var condError):
                            return System.Memory.MemoryStatus.Err(condError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Emits a `NonBooleanOperand` diagnostic for each operand of a logical operator
// (`&&`, `||`, `!`) whose type is a definite non-boolean — the host requires
// boolean operands for these — and a `NonBooleanCondition` for a ternary
// `cond ? a : b` whose `cond` is a definite non-boolean (the host requires a
// boolean conditional condition). Walks every node of the body's shared
// expression tree; each diagnostic is anchored at the offending sub-expression.
internal fn System.Memory.MemoryStatus CollectExpressionTypeErrors(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < nodeCount; index += 1)
    {
        stack u32[0 max] node = (u32[0 max])(index + 1);
        stack ExprKind nodeKind = body.ExprKindAt(node);
        if (nodeKind == Compiler.Parsing.ExprKind.Binary)
        {
            stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(node));
            if (op == TokenKind.AndAnd || op == TokenKind.OrOr)
            {
                switch (CheckBooleanOperand(table, source, refs, scope, stream, body, body.ExprLeftAt(node), diags))
                {
                    case System.Memory.MemoryStatus.Err(var leftError):
                        return System.Memory.MemoryStatus.Err(leftError);
                    case System.Memory.MemoryStatus.Ok:
                }

                switch (CheckBooleanOperand(table, source, refs, scope, stream, body, body.ExprRightAt(node), diags))
                {
                    case System.Memory.MemoryStatus.Err(var rightError):
                        return System.Memory.MemoryStatus.Err(rightError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
        else if (nodeKind == Compiler.Parsing.ExprKind.Unary)
        {
            stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(node));
            if (op == TokenKind.Bang)
            {
                switch (CheckBooleanOperand(table, source, refs, scope, stream, body, body.ExprLeftAt(node), diags))
                {
                    case System.Memory.MemoryStatus.Err(var unaryError):
                        return System.Memory.MemoryStatus.Err(unaryError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
        else if (nodeKind == Compiler.Parsing.ExprKind.Conditional)
        {
            stack u32[0 max] conditionNode = body.ExprLeftAt(node);
            if (conditionNode != 0)
            {
                stack ExprType conditionType = TypedNodeType(table, source, refs, scope, stream, body, conditionNode);
                if (IsDefiniteNonBoolean(conditionType))
                {
                    switch (diags.Append(BindDiagnosticCode.NonBooleanCondition, body.ExprTokenAt(conditionNode)))
                    {
                        case System.Memory.MemoryStatus.Err(var ternaryError):
                            return System.Memory.MemoryStatus.Err(ternaryError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Emits a `NonBooleanOperand` diagnostic when `operand`'s type is a definite
// non-boolean (anchored at the operand's token).
internal fn System.Memory.MemoryStatus CheckBooleanOperand(borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow FunctionScope scope, borrow TokenStream stream, borrow StatementList body, u32[0 max] operand, mut borrow BindDiagnosticList diags)
{
    if (operand == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack ExprType operandType = TypedNodeType(table, source, refs, scope, stream, body, operand);
    if (IsDefiniteNonBoolean(operandType))
    {
        switch (diags.Append(BindDiagnosticCode.NonBooleanOperand, body.ExprTokenAt(operand)))
        {
            case System.Memory.MemoryStatus.Err(var error):
                return System.Memory.MemoryStatus.Err(error);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// The 1-based index of the reference-table entry for expression `node`, or 0
// when the node is not an identifier reference.
internal fn u32[0 max] ReferenceIndexForNode(borrow ReferenceTable refs, u32[0 max] node)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0 && refs.NodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn bool TokenTextEqualsToken(ascii source, borrow TokenStream stream, u32[0 max] left, u32[0 max] right)
{
    if (left == 0 || right == 0)
    {
        return false;
    }

    stack ascii leftText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])left);
    stack ascii rightText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])right);
    return System.Text.Equals(leftText, rightText);
}

internal finite law bool IsDeadOnReturnContractToken(borrow TokenStream stream, u32[0 max] token)
{
    return stream.ContextualKindAt((u64[0 2 ** 63 - 1])token) == ContextualKeywordKind.DeadOnReturn;
}

internal fn bool TryReadSyntheticArgumentIndex(ascii source, borrow TokenStream stream, u32[0 max] token, out u32[0 max] index)
{
    index = 0;
    stack ascii text = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token);
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength < 4)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])signedLength;
    if (!System.Text.Equals(text[0, 3], "arg"))
    {
        return false;
    }

    stack mut u32[0 max] value = 0;
    for willexit (stack mut u64[0 2 ** 63 - 1] pos = 3; pos < length; pos += 1)
    {
        stack ascii unit = text[pos, 1];
        stack mut bool isDigit = true;
        stack mut u32[0 max] digit = 0;
        if (System.Text.Equals(unit, "0"))
        {
            digit = 0;
        }
        else if (System.Text.Equals(unit, "1"))
        {
            digit = 1;
        }
        else if (System.Text.Equals(unit, "2"))
        {
            digit = 2;
        }
        else if (System.Text.Equals(unit, "3"))
        {
            digit = 3;
        }
        else if (System.Text.Equals(unit, "4"))
        {
            digit = 4;
        }
        else if (System.Text.Equals(unit, "5"))
        {
            digit = 5;
        }
        else if (System.Text.Equals(unit, "6"))
        {
            digit = 6;
        }
        else if (System.Text.Equals(unit, "7"))
        {
            digit = 7;
        }
        else if (System.Text.Equals(unit, "8"))
        {
            digit = 8;
        }
        else if (System.Text.Equals(unit, "9"))
        {
            digit = 9;
        }
        else
        {
            isDigit = false;
        }

        if (!isDigit)
        {
            return false;
        }

        if (value > (u32[0 max])429496729 || (value == (u32[0 max])429496729 && digit > 5))
        {
            return false;
        }

        value = (u32[0 max])((value * 10) + digit);
    }

    index = value;
    return true;
}

internal fn bool TypeSpanIsMemoryBackedParameter(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    stack mut bool consumedIntegerRange = false;
    stack mut TokenKind previousTopLevel = TokenKind.EndOfFile;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0)
        {
            if (kind == TokenKind.Borrow || kind == TokenKind.Retborrow
                || kind == TokenKind.Storeborrow || kind == TokenKind.Out
                || kind == TokenKind.Init || kind == TokenKind.Rawptr
                || kind == TokenKind.Rawmutptr || kind == TokenKind.AsciiView
                || kind == TokenKind.UnicodeView)
            {
                return true;
            }

            if (kind == TokenKind.LBrack)
            {
                if (stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.RBrack)
                {
                    return true;
                }

                if (previousTopLevel == TokenKind.IntegerType && !consumedIntegerRange)
                {
                    consumedIntegerRange = true;
                }
            }
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        if (depth == 0 && kind != TokenKind.LBrack && kind != TokenKind.RBrack)
        {
            previousTopLevel = kind;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u64[0 2 ** 63 - 1] FunctionSignatureParamIndexPlusOneByName(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u32[0 max] nameToken)
{
    stack mut u64[0 2 ** 63 - 1] found = 0;
    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < paramCount; index += 1)
    {
        if (found == 0 && TokenTextEqualsToken(source, stream, signature.ParamNameAt(index), nameToken))
        {
            found = (u64[0 2 ** 63 - 1])(index + 1);
        }
    }

    return found;
}

internal fn bool SignatureDeadOnReturnHasEarlierName(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.DeadOnReturnParamNameAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] scan = 0; scan < currentIndex; scan += 1)
    {
        if (TokenTextEqualsToken(source, stream, signature.DeadOnReturnParamNameAt(scan), current))
        {
            return true;
        }
    }

    return false;
}

internal fn bool SignatureParamHasDeadOnReturnContract(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] paramIndex)
{
    stack u32[0 max] paramName = signature.ParamNameAt(paramIndex);
    stack u64[0 2 ** 63 - 1] contractCount = signature.DeadOnReturnParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < contractCount; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, paramName, signature.DeadOnReturnParamNameAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn u32[0 max] MatchingCloseParenAfter(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.RParen && depth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn bool TryFindCallableParamList(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive, out u32[0 max] lparen, out u32[0 max] rparen)
{
    lparen = 0;
    rparen = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Fn)
        {
            stack mut u32[0 max] depth = 0;
            stack mut u32[0 max] cursor = (u32[0 max])(scan + 1);
            while willexit (cursor < endExclusive)
            {
                stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
                if (kind == TokenKind.LParen && depth == 0)
                {
                    lparen = cursor;
                    rparen = MatchingCloseParenAfter(stream, cursor, endExclusive);
                    return rparen != 0;
                }

                if (kind == TokenKind.LParen || kind == TokenKind.LBrack
                    || kind == TokenKind.LBrace || kind == TokenKind.Lt)
                {
                    depth = (u32[0 max])(depth + 1);
                }
                else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
                    || kind == TokenKind.RBrace || kind == TokenKind.Gt)
                {
                    if (depth > 0)
                    {
                        depth = (u32[0 max])(depth - 1);
                    }
                }

                cursor = (u32[0 max])(cursor + 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u32[0 max] CallableParamCount(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] rparen)
{
    if ((u32[0 max])(lparen + 1) >= rparen)
    {
        return 0;
    }

    stack mut u32[0 max] count = 1;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan < rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Comma && depth == 0)
        {
            count = (u32[0 max])(count + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

internal fn bool TryCallableParamSpan(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] rparen, u32[0 max] argIndex, out u32[0 max] start, out u32[0 max] endExclusive)
{
    start = 0;
    endExclusive = 0;
    stack mut u32[0 max] currentIndex = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(lparen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan <= rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if ((scan == rparen || (kind == TokenKind.Comma && depth == 0)))
        {
            if (currentIndex == argIndex)
            {
                start = segmentStart;
                endExclusive = scan;
                return segmentStart < scan;
            }

            currentIndex = (u32[0 max])(currentIndex + 1);
            segmentStart = (u32[0 max])(scan + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool CallableTypeDeadOnReturnHasEarlierName(ascii source, borrow TokenStream stream, u32[0 max] typeStart, u32[0 max] currentToken)
{
    stack mut u32[0 max] scan = typeStart;
    while willexit (scan < currentToken)
    {
        if (IsDeadOnReturnContractToken(stream, scan)
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            stack mut u32[0 max] inner = (u32[0 max])(scan + 2);
            stack mut u32[0 max] depth = 0;
            while willexit (inner < currentToken)
            {
                stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])inner);
                if (kind == TokenKind.RParen && depth == 0)
                {
                    break;
                }

                if (kind == TokenKind.LParen || kind == TokenKind.LBrack
                    || kind == TokenKind.LBrace || kind == TokenKind.Lt)
                {
                    depth = (u32[0 max])(depth + 1);
                }
                else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
                    || kind == TokenKind.RBrace || kind == TokenKind.Gt)
                {
                    if (depth > 0)
                    {
                        depth = (u32[0 max])(depth - 1);
                    }
                }
                else if (kind == TokenKind.Identifier && depth == 0
                    && TokenTextEqualsToken(source, stream, inner, currentToken))
                {
                    return true;
                }

                inner = (u32[0 max])(inner + 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn System.Memory.MemoryStatus ValidateCallableDeadOnReturnContract(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] contractLParen,
    u32[0 max] callableLParen,
    u32[0 max] callableRParen,
    mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] paramCount = CallableParamCount(stream, callableLParen, callableRParen);
    stack mut u32[0 max] scan = (u32[0 max])(contractLParen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.RParen && depth == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0)
        {
            stack mut u32[0 max] argIndex = 0;
            stack mut u32[0 max] paramStart = 0;
            stack mut u32[0 max] paramEnd = 0;
            if (!TryReadSyntheticArgumentIndex(source, stream, scan, argIndex)
                || argIndex >= paramCount
                || !TryCallableParamSpan(stream, callableLParen, callableRParen, argIndex, paramStart, paramEnd))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnUnknownParameter, scan))
                {
                    case System.Memory.MemoryStatus.Err(var unknownError):
                        return System.Memory.MemoryStatus.Err(unknownError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (!TypeSpanIsMemoryBackedParameter(stream, paramStart, paramEnd))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnNonMemoryBackedParameter, scan))
                {
                    case System.Memory.MemoryStatus.Err(var memoryError):
                        return System.Memory.MemoryStatus.Err(memoryError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (CallableTypeDeadOnReturnHasEarlierName(source, stream, typeStart, scan))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnDuplicateParameter, scan))
                {
                    case System.Memory.MemoryStatus.Err(var duplicateError):
                        return System.Memory.MemoryStatus.Err(duplicateError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallableTypeDeadOnReturnDiagnostics(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] callableLParen = 0;
    stack mut u32[0 max] callableRParen = 0;
    if (!TryFindCallableParamList(stream, start, endExclusive, callableLParen, callableRParen))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (IsDeadOnReturnContractToken(stream, scan)
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            switch (ValidateCallableDeadOnReturnContract(source, stream, start, (u32[0 max])(scan + 1), callableLParen, callableRParen, diags))
            {
                case System.Memory.MemoryStatus.Err(var contractError):
                    return System.Memory.MemoryStatus.Err(contractError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDeadOnReturnSignatureDiagnostics(
    borrow FunctionSignature signature,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] fnKeyword,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] contractCount = signature.DeadOnReturnParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < contractCount; index += 1)
    {
        stack u32[0 max] name = signature.DeadOnReturnParamNameAt(index);
        stack u64[0 2 ** 63 - 1] paramIndexPlusOne = FunctionSignatureParamIndexPlusOneByName(source, stream, signature, name);
        if (paramIndexPlusOne == 0)
        {
            switch (diags.Append(BindDiagnosticCode.DeadOnReturnUnknownParameter, name))
            {
                case System.Memory.MemoryStatus.Err(var unknownError):
                    return System.Memory.MemoryStatus.Err(unknownError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(paramIndexPlusOne - 1);
            if (!TypeSpanIsMemoryBackedParameter(stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex)))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnNonMemoryBackedParameter, name))
                {
                    case System.Memory.MemoryStatus.Err(var memoryError):
                        return System.Memory.MemoryStatus.Err(memoryError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (SignatureDeadOnReturnHasEarlierName(source, stream, signature, index))
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnDuplicateParameter, name))
                {
                    case System.Memory.MemoryStatus.Err(var duplicateError):
                        return System.Memory.MemoryStatus.Err(duplicateError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    if (signature.Name() != 0 && signature.ReturnTypeDeadOnReturnParamCount() > 0)
    {
        switch (CollectCallableTypeDeadOnReturnDiagnostics(source, stream, (u32[0 max])(fnKeyword + 1), signature.Name(), diags))
        {
            case System.Memory.MemoryStatus.Err(var returnTypeError):
                return System.Memory.MemoryStatus.Err(returnTypeError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] p = 0; p < paramCount; p += 1)
    {
        if (signature.ParamTypeDeadOnReturnParamCount(p) > 0)
        {
            switch (CollectCallableTypeDeadOnReturnDiagnostics(source, stream, signature.ParamStartTokenAt(p), signature.ParamNameAt(p), diags))
            {
                case System.Memory.MemoryStatus.Err(var paramTypeError):
                    return System.Memory.MemoryStatus.Err(paramTypeError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn u32[0 max] ParameterRootIndexPlusOneForArgument(borrow ReferenceTable refs, borrow StatementList body, u32[0 max] node)
{
    if (node == 0)
    {
        return 0;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
        if (refIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
            if (refs.KindAt(refIndex) == ReferenceKind.Parameter)
            {
                return refs.TargetAt(refIndex);
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index)
    {
        return ParameterRootIndexPlusOneForArgument(refs, body, body.ExprLeftAt(node));
    }

    return 0;
}

internal fn System.Memory.MemoryStatus CheckDeadOnReturnActualArgument(
    borrow FunctionSignature caller,
    ascii source,
    borrow ReferenceTable refs,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] callNode,
    u32[0 max] argIndex,
    mut borrow BindDiagnosticList diags)
{
    if (argIndex >= body.ExprCallArgCountAt(callNode))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] argNode = body.ExprCallArgAt(callNode, argIndex);
    if (argNode == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] rootParamPlusOne = ParameterRootIndexPlusOneForArgument(refs, body, argNode);
    if (rootParamPlusOne != 0)
    {
        stack u64[0 2 ** 63 - 1] rootParamIndex = (u64[0 2 ** 63 - 1])(rootParamPlusOne - 1);
        if (rootParamIndex < caller.ParamCount()
            && !SignatureParamHasDeadOnReturnContract(source, stream, caller, rootParamIndex))
        {
            switch (diags.Append(BindDiagnosticCode.DeadOnReturnForwardingMismatch, body.ExprTokenAt(argNode)))
            {
                case System.Memory.MemoryStatus.Err(var forwardError):
                    return System.Memory.MemoryStatus.Err(forwardError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }
    else if (body.ExprKindAt(argNode) == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] argRefPlusOne = ReferenceIndexForNode(refs, argNode);
        if (argRefPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] argRef = (u64[0 2 ** 63 - 1])(argRefPlusOne - 1);
            if (refs.KindAt(argRef) == ReferenceKind.Declaration)
            {
                switch (diags.Append(BindDiagnosticCode.DeadOnReturnForwardingMismatch, body.ExprTokenAt(argNode)))
                {
                    case System.Memory.MemoryStatus.Err(var declarationError):
                        return System.Memory.MemoryStatus.Err(declarationError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDirectDeadOnReturnCallDiagnostics(
    borrow FunctionSignature caller,
    borrow FunctionSignature callee,
    ascii source,
    borrow ReferenceTable refs,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] paramCount = callee.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] p = 0; p < paramCount; p += 1)
    {
        if (SignatureParamHasDeadOnReturnContract(source, stream, callee, p))
        {
            switch (CheckDeadOnReturnActualArgument(caller, source, refs, body, stream, callNode, (u32[0 max])p, diags))
            {
                case System.Memory.MemoryStatus.Err(var argError):
                    return System.Memory.MemoryStatus.Err(argError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallbackDeadOnReturnCallFromContract(
    borrow FunctionSignature caller,
    ascii source,
    borrow ReferenceTable refs,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] contractLParen,
    u32[0 max] callableLParen,
    u32[0 max] callableRParen,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] paramCount = CallableParamCount(stream, callableLParen, callableRParen);
    stack mut u32[0 max] scan = (u32[0 max])(contractLParen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.RParen && depth == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0
            && !CallableTypeDeadOnReturnHasEarlierName(source, stream, typeStart, scan))
        {
            stack mut u32[0 max] argIndex = 0;
            stack mut u32[0 max] paramStart = 0;
            stack mut u32[0 max] paramEnd = 0;
            if (TryReadSyntheticArgumentIndex(source, stream, scan, argIndex)
                && argIndex < paramCount
                && TryCallableParamSpan(stream, callableLParen, callableRParen, argIndex, paramStart, paramEnd)
                && TypeSpanIsMemoryBackedParameter(stream, paramStart, paramEnd))
            {
                switch (CheckDeadOnReturnActualArgument(caller, source, refs, body, stream, callNode, argIndex, diags))
                {
                    case System.Memory.MemoryStatus.Err(var actualError):
                        return System.Memory.MemoryStatus.Err(actualError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallbackDeadOnReturnCallDiagnostics(
    borrow FunctionSignature caller,
    ascii source,
    borrow ReferenceTable refs,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] callableLParen = 0;
    stack mut u32[0 max] callableRParen = 0;
    if (!TryFindCallableParamList(stream, typeStart, typeEnd, callableLParen, callableRParen))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] scan = typeStart;
    while willexit (scan < typeEnd)
    {
        if (IsDeadOnReturnContractToken(stream, scan)
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            switch (CollectCallbackDeadOnReturnCallFromContract(caller, source, refs, body, stream, typeStart, (u32[0 max])(scan + 1), callableLParen, callableRParen, callNode, diags))
            {
                case System.Memory.MemoryStatus.Err(var callbackError):
                    return System.Memory.MemoryStatus.Err(callbackError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDeadOnReturnCallDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] n = 0; n < nodeCount; n += 1)
    {
        stack u32[0 max] node = (u32[0 max])(n + 1);
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] calleeNode = body.ExprLeftAt(node);
            if (calleeNode != 0 && body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier)
            {
                stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
                if (refIndexPlusOne != 0)
                {
                    stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
                    stack ReferenceKind kind = refs.KindAt(refIndex);
                    if (kind == ReferenceKind.Declaration)
                    {
                        stack mut FunctionSignature callee = new();
                        if (TryParseFunctionSignatureFromTable(table, stream, refs.TargetAt(refIndex), callee))
                        {
                            switch (CollectDirectDeadOnReturnCallDiagnostics(signature, callee, source, refs, body, stream, node, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var directError):
                                    return System.Memory.MemoryStatus.Err(directError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }
                    else if (kind == ReferenceKind.Parameter)
                    {
                        stack u32[0 max] target = refs.TargetAt(refIndex);
                        if (target != 0 && scope.KindAt((u64[0 2 ** 63 - 1])(target - 1)) == SymbolKind.Parameter)
                        {
                            stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(target - 1);
                            if (paramIndex < signature.ParamCount()
                                && signature.ParamTypeDeadOnReturnParamCount(paramIndex) > 0)
                            {
                                switch (CollectCallbackDeadOnReturnCallDiagnostics(signature, source, refs, body, stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex), node, diags))
                                {
                                    case System.Memory.MemoryStatus.Err(var callbackError):
                                        return System.Memory.MemoryStatus.Err(callbackError);
                                    case System.Memory.MemoryStatus.Ok:
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

struct ArenaSymbolFacts
{
    dynamic u32[0 max] ArenaBackedSymbols;
    dynamic u32[0 max] ArenaRootSymbols;

    ArenaSymbolFacts()
    {
        self.ArenaBackedSymbols = new();
        self.ArenaRootSymbols = new();
    }

    law bool IsArenaBacked(borrow ArenaSymbolFacts self, u32[0 max] symbolIndexPlusOne)
    {
        if (symbolIndexPlusOne == 0)
        {
            return false;
        }

        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < self.ArenaBackedSymbols.Length; index += 1)
        {
            if (self.ArenaBackedSymbols[index] == symbolIndexPlusOne)
            {
                return true;
            }
        }

        return false;
    }

    law bool IsArenaRoot(borrow ArenaSymbolFacts self, u32[0 max] symbolIndexPlusOne)
    {
        if (symbolIndexPlusOne == 0)
        {
            return false;
        }

        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < self.ArenaRootSymbols.Length; index += 1)
        {
            if (self.ArenaRootSymbols[index] == symbolIndexPlusOne)
            {
                return true;
            }
        }

        return false;
    }

    fn System.Memory.MemoryStatus MarkArenaRoot(mut borrow ArenaSymbolFacts self, u32[0 max] symbolIndexPlusOne)
    {
        if (symbolIndexPlusOne == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.IsArenaRoot(symbolIndexPlusOne))
        {
            if (!self.ArenaRootSymbols.TryReserve(1))
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
            }

            init self.ArenaRootSymbols[self.ArenaRootSymbols.Length] = symbolIndexPlusOne;
        }

        return self.MarkArenaBacked(symbolIndexPlusOne);
    }

    fn System.Memory.MemoryStatus MarkArenaBacked(mut borrow ArenaSymbolFacts self, u32[0 max] symbolIndexPlusOne)
    {
        if (symbolIndexPlusOne == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.IsArenaBacked(symbolIndexPlusOne))
        {
            if (!self.ArenaBackedSymbols.TryReserve(1))
            {
                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
            }

            init self.ArenaBackedSymbols[self.ArenaBackedSymbols.Length] = symbolIndexPlusOne;
        }

        return System.Memory.MemoryStatus.Ok;
    }
}

internal fn bool TypeSpanHasTopLevelToken(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive, TokenKind target)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == target)
        {
            return true;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool TypeSpanMayRetainArenaBorrow(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Storeborrow);
}

internal fn bool TypeSpanCanReturnBorrowedArena(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Retborrow);
}

internal fn bool TypeSpanIsOutputOnlyParameter(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Out)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Init);
}

internal fn bool TypeSpanFormsSafeBorrow(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Borrow)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Retborrow)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Storeborrow)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Out)
        || TypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Init);
}

internal fn System.Memory.MemoryStatus AppendPackedFieldSafeBorrowDiagnostic(mut borrow BindDiagnosticList diags, u32[0 max] token)
{
    return diags.Append(BindDiagnosticCode.PackedFieldSafeBorrow, token);
}

internal fn System.Memory.MemoryStatus CheckPackedFieldSafeBorrowArgument(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] callNode,
    u32[0 max] argIndex,
    mut borrow BindDiagnosticList diags)
{
    if (argIndex >= body.ExprCallArgCountAt(callNode))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] argNode = body.ExprCallArgAt(callNode, argIndex);
    if (ExpressionHasMisalignedLayoutFieldProjection(decls, table, source, refs, scope, stream, body, argNode))
    {
        switch (AppendPackedFieldSafeBorrowDiagnostic(diags, body.ExprTokenAt(argNode)))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDirectPackedFieldSafeBorrowCallDiagnostics(
    borrow FunctionSignature callee,
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] paramCount = callee.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] param = 0; param < paramCount; param += 1)
    {
        if ((u32[0 max])param < body.ExprCallArgCountAt(callNode)
            && TypeSpanFormsSafeBorrow(stream, callee.ParamStartTokenAt(param), callee.ParamNameAt(param)))
        {
            switch (CheckPackedFieldSafeBorrowArgument(decls, table, source, refs, scope, stream, body, callNode, (u32[0 max])param, diags))
            {
                case System.Memory.MemoryStatus.Err(var argError):
                    return System.Memory.MemoryStatus.Err(argError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallbackPackedFieldSafeBorrowCallDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] callableLParen = 0;
    stack mut u32[0 max] callableRParen = 0;
    if (!TryFindCallableParamList(stream, typeStart, typeEnd, callableLParen, callableRParen))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] paramCount = CallableParamCount(stream, callableLParen, callableRParen);
    for willexit (stack mut u32[0 max] param = 0; param < paramCount; param = (u32[0 max])(param + 1))
    {
        stack mut u32[0 max] paramStart = 0;
        stack mut u32[0 max] paramEnd = 0;
        if (param < body.ExprCallArgCountAt(callNode)
            && TryCallableParamSpan(stream, callableLParen, callableRParen, param, paramStart, paramEnd)
            && TypeSpanFormsSafeBorrow(stream, paramStart, paramEnd))
        {
            switch (CheckPackedFieldSafeBorrowArgument(decls, table, source, refs, scope, stream, body, callNode, param, diags))
            {
                case System.Memory.MemoryStatus.Err(var argError):
                    return System.Memory.MemoryStatus.Err(argError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectPackedFieldSafeBorrowDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] statement = 0; statement < statementCount; statement += 1)
    {
        stack StatementItem item = body.ItemAt(statement);
        stack u32[0 max] root = body.ExprRootAt(statement);
        if (root != 0
            && item.Kind == StatementKind.Local
            && TypeSpanFormsSafeBorrow(stream, item.TypeStartToken, item.TypeEndToken)
            && ExpressionHasMisalignedLayoutFieldProjection(decls, table, source, refs, scope, stream, body, root))
        {
            switch (AppendPackedFieldSafeBorrowDiagnostic(diags, body.ExprTokenAt(root)))
            {
                case System.Memory.MemoryStatus.Err(var localError):
                    return System.Memory.MemoryStatus.Err(localError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else if (root != 0
            && item.Kind == StatementKind.Return
            && TypeSpanFormsSafeBorrow(stream, signature.ReturnTypeStartTokenAt(), signature.ReturnTypeEndTokenAt())
            && ExpressionHasMisalignedLayoutFieldProjection(decls, table, source, refs, scope, stream, body, root))
        {
            switch (AppendPackedFieldSafeBorrowDiagnostic(diags, body.ExprTokenAt(root)))
            {
                case System.Memory.MemoryStatus.Err(var returnError):
                    return System.Memory.MemoryStatus.Err(returnError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] callNode = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(callNode) == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] calleeNode = body.ExprLeftAt(callNode);
            if (calleeNode != 0 && body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier)
            {
                stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
                if (refIndexPlusOne != 0)
                {
                    stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
                    stack ReferenceKind kind = refs.KindAt(refIndex);
                    if (kind == ReferenceKind.Declaration)
                    {
                        stack mut FunctionSignature callee = new();
                        if (TryParseFunctionSignatureFromTable(table, stream, refs.TargetAt(refIndex), callee))
                        {
                            switch (CollectDirectPackedFieldSafeBorrowCallDiagnostics(callee, decls, table, source, refs, scope, stream, body, callNode, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var directError):
                                    return System.Memory.MemoryStatus.Err(directError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }
                    else if (kind == ReferenceKind.Parameter || kind == ReferenceKind.Local)
                    {
                        stack u32[0 max] target = refs.TargetAt(refIndex);
                        if (target != 0)
                        {
                            stack u64[0 2 ** 63 - 1] targetIndex = (u64[0 2 ** 63 - 1])(target - 1);
                            if (targetIndex < scope.Count())
                            {
                                switch (CollectCallbackPackedFieldSafeBorrowCallDiagnostics(
                                    decls,
                                    table,
                                    source,
                                    refs,
                                    scope,
                                    stream,
                                    body,
                                    scope.TypeStartTokenAt(targetIndex),
                                    scope.TypeEndTokenAt(targetIndex),
                                    callNode,
                                    diags))
                                {
                                    case System.Memory.MemoryStatus.Err(var callbackError):
                                        return System.Memory.MemoryStatus.Err(callbackError);
                                    case System.Memory.MemoryStatus.Ok:
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal finite law u32[0 max] TokenOrFallback(u32[0 max] token, u32[0 max] fallback)
{
    if (token != 0)
    {
        return token;
    }

    return fallback;
}

internal fn bool TryDecodeAsmRegisterToken(ascii source, borrow TokenStream stream, u32[0 max] token, out System.Text.OwnedAscii decoded)
{
    decoded = new();
    if (token == 0)
    {
        return false;
    }

    stack ascii literal = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])token);
    switch (System.Text.DecodeStringLiteralToUtf8(literal))
    {
        case System.Text.TextBuildResult<System.Text.OwnedAscii>.Err(var error):
            return false;
        case System.Text.TextBuildResult<System.Text.OwnedAscii>.Ok(var value):
            decoded = value;
            return true;
    }
}

internal fn bool AsmRegisterTokenTextEquals(ascii source, borrow TokenStream stream, u32[0 max] left, u32[0 max] right)
{
    stack mut System.Text.OwnedAscii leftText = new();
    stack mut System.Text.OwnedAscii rightText = new();
    if (!TryDecodeAsmRegisterToken(source, stream, left, leftText)
        || !TryDecodeAsmRegisterToken(source, stream, right, rightText))
    {
        return false;
    }

    return Compiler.AsmFacts.RegisterNamesEqual(leftText.View(), rightText.View());
}

internal fn System.Memory.MemoryStatus ValidateAsmRegisterToken(
    ascii source,
    borrow TokenStream stream,
    Compiler.AsmFacts.StarkAsmArchitecture architecture,
    u32[0 max] registerToken,
    mut borrow BindDiagnosticList diags)
{
    stack mut System.Text.OwnedAscii registerText = new();
    if (!TryDecodeAsmRegisterToken(source, stream, registerToken, registerText)
        || !Compiler.AsmFacts.IsValidRegister(architecture, registerText.View()))
    {
        return diags.Append(BindDiagnosticCode.AsmInvalidRegister, registerToken);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool FunctionSignatureHasEarlierInputValue(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmInputValueAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, current, signature.AsmInputValueAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureHasEarlierOutputValue(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmOutputValueAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (!signature.AsmOutputBindsReturnAt(index)
            && TokenTextEqualsToken(source, stream, current, signature.AsmOutputValueAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureInputOutputValueOverlap(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u32[0 max] outputValue)
{
    stack u64[0 2 ** 63 - 1] inputCount = (u64[0 2 ** 63 - 1])signature.AsmInputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < inputCount; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, outputValue, signature.AsmInputValueAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureHasEarlierInputRegister(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmInputRegisterAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, current, signature.AsmInputRegisterAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureHasEarlierOutputRegister(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmOutputRegisterAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, current, signature.AsmOutputRegisterAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureOutputRegisterOverlapsInput(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u32[0 max] outputRegister)
{
    stack u64[0 2 ** 63 - 1] inputCount = (u64[0 2 ** 63 - 1])signature.AsmInputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < inputCount; index += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, outputRegister, signature.AsmInputRegisterAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureHasEarlierClobberRegister(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u64[0 2 ** 63 - 1] currentIndex)
{
    stack u32[0 max] current = signature.AsmClobberRegisterAt(currentIndex);
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < currentIndex; index += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, current, signature.AsmClobberRegisterAt(index)))
        {
            return true;
        }
    }

    return false;
}

internal fn bool FunctionSignatureClobberOverlapsOperand(ascii source, borrow TokenStream stream, borrow FunctionSignature signature, u32[0 max] clobberRegister)
{
    stack u64[0 2 ** 63 - 1] inputCount = (u64[0 2 ** 63 - 1])signature.AsmInputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] input = 0; input < inputCount; input += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, clobberRegister, signature.AsmInputRegisterAt(input)))
        {
            return true;
        }
    }

    stack u64[0 2 ** 63 - 1] outputCount = (u64[0 2 ** 63 - 1])signature.AsmOutputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] output = 0; output < outputCount; output += 1)
    {
        if (AsmRegisterTokenTextEquals(source, stream, clobberRegister, signature.AsmOutputRegisterAt(output)))
        {
            return true;
        }
    }

    return false;
}

internal fn System.Memory.MemoryStatus CollectAsmSignatureDiagnostics(
    borrow FunctionSignature signature,
    ascii source,
    borrow TokenStream stream,
    mut borrow BindDiagnosticList diags)
{
    if (!signature.HasAsm())
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] architectureToken = signature.AsmArchitectureToken();
    stack mut Compiler.AsmFacts.StarkAsmArchitecture architecture = Compiler.AsmFacts.StarkAsmArchitecture.Unknown;
    if (architectureToken == 0)
    {
        switch (diags.Append(BindDiagnosticCode.AsmUnknownArchitecture, signature.AsmToken()))
        {
            case System.Memory.MemoryStatus.Err(var archTokenError):
                return System.Memory.MemoryStatus.Err(archTokenError);
            case System.Memory.MemoryStatus.Ok:
        }
    }
    else
    {
        stack ascii architectureText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])architectureToken);
        architecture = Compiler.AsmFacts.ParseArchitectureName(architectureText);
        if (architecture == Compiler.AsmFacts.StarkAsmArchitecture.Unknown)
        {
            switch (diags.Append(BindDiagnosticCode.AsmUnknownArchitecture, architectureToken))
            {
                case System.Memory.MemoryStatus.Err(var archError):
                    return System.Memory.MemoryStatus.Err(archError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack bool validateRegisters = architecture != Compiler.AsmFacts.StarkAsmArchitecture.Unknown;
    stack u64[0 2 ** 63 - 1] inputCount = (u64[0 2 ** 63 - 1])signature.AsmInputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] input = 0; input < inputCount; input += 1)
    {
        stack u32[0 max] registerToken = signature.AsmInputRegisterAt(input);
        stack u32[0 max] valueToken = signature.AsmInputValueAt(input);
        if (validateRegisters)
        {
            switch (ValidateAsmRegisterToken(source, stream, architecture, registerToken, diags))
            {
                case System.Memory.MemoryStatus.Err(var registerError):
                    return System.Memory.MemoryStatus.Err(registerError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (FunctionSignatureHasEarlierInputRegister(source, stream, signature, input))
        {
            switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, registerToken))
            {
                case System.Memory.MemoryStatus.Err(var inputRegisterError):
                    return System.Memory.MemoryStatus.Err(inputRegisterError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        stack u64[0 2 ** 63 - 1] paramIndexPlusOne = FunctionSignatureParamIndexPlusOneByName(source, stream, signature, valueToken);
        if (paramIndexPlusOne == 0)
        {
            switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, TokenOrFallback(valueToken, registerToken)))
            {
                case System.Memory.MemoryStatus.Err(var inputNameError):
                    return System.Memory.MemoryStatus.Err(inputNameError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(paramIndexPlusOne - 1);
            if (TypeSpanIsOutputOnlyParameter(stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex))
                || FunctionSignatureHasEarlierInputValue(source, stream, signature, input))
            {
                switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, valueToken))
                {
                    case System.Memory.MemoryStatus.Err(var inputValueError):
                        return System.Memory.MemoryStatus.Err(inputValueError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    stack bool returnsVoid = stream.KindAt((u64[0 2 ** 63 - 1])signature.ReturnTypeTokenAt()) == TokenKind.Void;
    stack mut u32[0 max] returnBindingCount = 0;
    stack u64[0 2 ** 63 - 1] outputCount = (u64[0 2 ** 63 - 1])signature.AsmOutputCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] output = 0; output < outputCount; output += 1)
    {
        stack u32[0 max] registerToken = signature.AsmOutputRegisterAt(output);
        stack u32[0 max] valueToken = signature.AsmOutputValueAt(output);
        if (validateRegisters)
        {
            switch (ValidateAsmRegisterToken(source, stream, architecture, registerToken, diags))
            {
                case System.Memory.MemoryStatus.Err(var registerError):
                    return System.Memory.MemoryStatus.Err(registerError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (FunctionSignatureHasEarlierOutputRegister(source, stream, signature, output)
            || (!signature.AsmOutputBindsReturnAt(output)
                && FunctionSignatureOutputRegisterOverlapsInput(source, stream, signature, registerToken)))
        {
            switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, registerToken))
            {
                case System.Memory.MemoryStatus.Err(var outputRegisterError):
                    return System.Memory.MemoryStatus.Err(outputRegisterError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (signature.AsmOutputBindsReturnAt(output))
        {
            returnBindingCount = (u32[0 max])(returnBindingCount + 1);
            if (returnsVoid || returnBindingCount > 1)
            {
                switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, TokenOrFallback(valueToken, registerToken)))
                {
                    case System.Memory.MemoryStatus.Err(var returnBindingError):
                        return System.Memory.MemoryStatus.Err(returnBindingError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
        else
        {
            stack u64[0 2 ** 63 - 1] paramIndexPlusOne = FunctionSignatureParamIndexPlusOneByName(source, stream, signature, valueToken);
            if (paramIndexPlusOne == 0)
            {
                switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, TokenOrFallback(valueToken, registerToken)))
                {
                    case System.Memory.MemoryStatus.Err(var outputNameError):
                        return System.Memory.MemoryStatus.Err(outputNameError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else
            {
                stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(paramIndexPlusOne - 1);
                if (!TypeSpanIsOutputOnlyParameter(stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex))
                    || FunctionSignatureHasEarlierOutputValue(source, stream, signature, output)
                    || FunctionSignatureInputOutputValueOverlap(source, stream, signature, valueToken))
                {
                    switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, valueToken))
                    {
                        case System.Memory.MemoryStatus.Err(var outputValueError):
                            return System.Memory.MemoryStatus.Err(outputValueError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }
    }

    if (!returnsVoid && returnBindingCount != 1)
    {
        switch (diags.Append(BindDiagnosticCode.AsmInvalidOperandBinding, signature.Name()))
        {
            case System.Memory.MemoryStatus.Err(var missingReturnError):
                return System.Memory.MemoryStatus.Err(missingReturnError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack u64[0 2 ** 63 - 1] clobberCount = (u64[0 2 ** 63 - 1])signature.AsmClobberCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] clobberIndex = 0; clobberIndex < clobberCount; clobberIndex += 1)
    {
        stack u32[0 max] registerToken = signature.AsmClobberRegisterAt(clobberIndex);
        if (validateRegisters)
        {
            switch (ValidateAsmRegisterToken(source, stream, architecture, registerToken, diags))
            {
                case System.Memory.MemoryStatus.Err(var clobberRegisterError):
                    return System.Memory.MemoryStatus.Err(clobberRegisterError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (FunctionSignatureHasEarlierClobberRegister(source, stream, signature, clobberIndex)
            || FunctionSignatureClobberOverlapsOperand(source, stream, signature, registerToken))
        {
            switch (diags.Append(BindDiagnosticCode.AsmInvalidClobber, registerToken))
            {
                case System.Memory.MemoryStatus.Err(var clobberError):
                    return System.Memory.MemoryStatus.Err(clobberError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn TokenKind LocalStorageKindForSymbol(borrow FunctionScope scope, borrow StatementList body, borrow TokenStream stream, u32[0 max] symbolIndexPlusOne)
{
    if (symbolIndexPlusOne == 0)
    {
        return TokenKind.EndOfFile;
    }

    stack u64[0 2 ** 63 - 1] symbolIndex = (u64[0 2 ** 63 - 1])(symbolIndexPlusOne - 1);
    if (symbolIndex >= scope.Count() || scope.KindAt(symbolIndex) != SymbolKind.Local)
    {
        return TokenKind.EndOfFile;
    }

    stack u32[0 max] stmtIndex = scope.StmtIndexAt(symbolIndex);
    stack StatementItem item = body.ItemAt((u64[0 2 ** 63 - 1])stmtIndex);
    if (item.Kind != StatementKind.Local)
    {
        return TokenKind.EndOfFile;
    }

    return stream.KindAt((u64[0 2 ** 63 - 1])item.StartToken);
}

internal fn u32[0 max] SymbolIndexPlusOneForStatement(borrow FunctionScope scope, u32[0 max] stmtIndex)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = scope.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0 && scope.KindAt(index) == SymbolKind.Local
            && scope.StmtIndexAt(index) == stmtIndex)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn u32[0 max] LocalSymbolRootForExpression(borrow ReferenceTable refs, borrow StatementList body, u32[0 max] node)
{
    if (node == 0)
    {
        return 0;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
        if (refIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
            if (refs.KindAt(refIndex) == ReferenceKind.Local)
            {
                return refs.TargetAt(refIndex);
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index)
    {
        return LocalSymbolRootForExpression(refs, body, body.ExprLeftAt(node));
    }

    return 0;
}

internal fn bool DeclarationRootIsLongLived(borrow DeclarationTable table, u32[0 max] tableIndexPlusOne)
{
    if (tableIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] tableIndex = (u64[0 2 ** 63 - 1])(tableIndexPlusOne - 1);
    if (tableIndex >= table.Count())
    {
        return false;
    }

    stack DeclarationKind kind = table.KindAt(tableIndex);
    return kind == DeclarationKind.Static || kind == DeclarationKind.Const
        || kind == DeclarationKind.GlobalVariable;
}

internal fn bool DeclarationRootIsGlobalState(borrow DeclarationTable table, u32[0 max] tableIndexPlusOne)
{
    if (tableIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] tableIndex = (u64[0 2 ** 63 - 1])(tableIndexPlusOne - 1);
    if (tableIndex >= table.Count())
    {
        return false;
    }

    stack DeclarationKind kind = table.KindAt(tableIndex);
    return kind == DeclarationKind.Static || kind == DeclarationKind.GlobalVariable;
}

internal fn bool ExpressionNodeIsAssignmentRootTarget(borrow StatementList body, u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] candidate = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(candidate) == Compiler.Parsing.ExprKind.Assign
            && AssignmentTargetRootNode(body, body.ExprLeftAt(candidate)) == node)
        {
            return true;
        }
    }

    return false;
}

internal fn bool ReferenceReadsGlobalState(
    borrow DeclarationTable table,
    borrow ReferenceTable refs,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] refIndex)
{
    if (refs.KindAt(refIndex) != ReferenceKind.Declaration)
    {
        return false;
    }

    if (!DeclarationRootIsGlobalState(table, refs.TargetAt(refIndex)))
    {
        return false;
    }

    return !ExpressionNodeIsAssignmentRootTarget(body, refs.NodeAt(refIndex));
}

internal fn bool AssignmentTargetWritesGlobalState(
    borrow DeclarationTable table,
    borrow ReferenceTable refs,
    borrow StatementList body,
    u32[0 max] target)
{
    stack u32[0 max] root = AssignmentTargetRootNode(body, target);
    if (root == 0 || body.ExprKindAt(root) != Compiler.Parsing.ExprKind.Identifier)
    {
        return false;
    }

    stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, root);
    if (refIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
    return refs.KindAt(refIndex) == ReferenceKind.Declaration
        && DeclarationRootIsGlobalState(table, refs.TargetAt(refIndex));
}

internal fn bool ExpressionRootIsLongLivedStorage(borrow DeclarationTable table, borrow ReferenceTable refs, borrow FunctionScope scope, borrow StatementList body, borrow TokenStream stream, u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
        if (refIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
            if (refs.KindAt(refIndex) == ReferenceKind.Declaration)
            {
                return DeclarationRootIsLongLived(table, refs.TargetAt(refIndex));
            }
            else if (refs.KindAt(refIndex) == ReferenceKind.Local)
            {
                stack TokenKind storage = LocalStorageKindForSymbol(scope, body, stream, refs.TargetAt(refIndex));
                return storage == TokenKind.Heap || storage == TokenKind.Static;
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index)
    {
        return ExpressionRootIsLongLivedStorage(table, refs, scope, body, stream, body.ExprLeftAt(node));
    }

    return false;
}

internal fn bool NewExpressionUsesArenaSelector(borrow StatementList body, borrow TokenStream stream, u32[0 max] node)
{
    if (node == 0 || body.ExprKindAt(node) != Compiler.Parsing.ExprKind.New || body.ExprCallArgCountAt(node) == 0)
    {
        return false;
    }

    stack u32[0 max] firstArg = body.ExprCallArgAt(node, 0);
    return firstArg != 0
        && body.ExprKindAt(firstArg) == Compiler.Parsing.ExprKind.StorageSelector
        && stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(firstArg)) == TokenKind.Arena;
}

internal fn bool ExpressionContainsArenaSelectorNew(borrow StatementList body, borrow TokenStream stream, u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (NewExpressionUsesArenaSelector(body, stream, node))
    {
        return true;
    }

    if (kind == Compiler.Parsing.ExprKind.Unary || kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index
        || kind == Compiler.Parsing.ExprKind.Call || kind == Compiler.Parsing.ExprKind.New || kind == Compiler.Parsing.ExprKind.Assign
        || kind == Compiler.Parsing.ExprKind.Binary || kind == Compiler.Parsing.ExprKind.Conditional)
    {
        if (ExpressionContainsArenaSelectorNew(body, stream, body.ExprLeftAt(node))
            || ExpressionContainsArenaSelectorNew(body, stream, body.ExprRightAt(node))
            || ExpressionContainsArenaSelectorNew(body, stream, body.ExprAuxAt(node)))
        {
            return true;
        }

        stack u32[0 max] argCount = body.ExprCallArgCountAt(node);
        for willexit (stack mut u32[0 max] arg = 0; arg < argCount; arg = (u32[0 max])(arg + 1))
        {
            if (ExpressionContainsArenaSelectorNew(body, stream, body.ExprCallArgAt(node, arg)))
            {
                return true;
            }
        }
    }

    return false;
}

internal fn bool CallCalleeNameEquals(ascii source, borrow StatementList body, borrow TokenStream stream, u32[0 max] callNode, ascii name)
{
    stack u32[0 max] calleeNode = body.ExprLeftAt(callNode);
    if (calleeNode == 0 || body.ExprKindAt(calleeNode) != Compiler.Parsing.ExprKind.Identifier)
    {
        return false;
    }

    stack ascii calleeName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])body.ExprTokenAt(calleeNode));
    return System.Text.Equals(calleeName, name);
}

internal fn bool ExpressionIsArenaDerived(
    borrow DeclarationTable table,
    ascii source,
    borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
        if (refIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
            if (refs.KindAt(refIndex) == ReferenceKind.Local)
            {
                return facts.IsArenaBacked(refs.TargetAt(refIndex));
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Member || kind == Compiler.Parsing.ExprKind.Index || kind == Compiler.Parsing.ExprKind.Unary)
    {
        return ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprLeftAt(node));
    }
    else if (kind == Compiler.Parsing.ExprKind.Assign)
    {
        return ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprRightAt(node));
    }
    else if (kind == Compiler.Parsing.ExprKind.Binary)
    {
        return ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprLeftAt(node))
            || ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprRightAt(node));
    }
    else if (kind == Compiler.Parsing.ExprKind.Conditional)
    {
        return ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprRightAt(node))
            || ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprAuxAt(node));
    }
    else if (kind == Compiler.Parsing.ExprKind.New)
    {
        if (NewExpressionUsesArenaSelector(body, stream, node))
        {
            return true;
        }

        stack u32[0 max] argCount = body.ExprCallArgCountAt(node);
        for willexit (stack mut u32[0 max] arg = 0; arg < argCount; arg = (u32[0 max])(arg + 1))
        {
            if (ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprCallArgAt(node, arg)))
            {
                return true;
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Call)
    {
        if (CallCalleeNameEquals(source, body, stream, node, "slice")
            && body.ExprCallArgCountAt(node) > 0
            && ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprCallArgAt(node, 0)))
        {
            return true;
        }

        stack u32[0 max] calleeNode = body.ExprLeftAt(node);
        if (calleeNode != 0 && body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
            if (refIndexPlusOne != 0)
            {
                stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
                if (refs.KindAt(refIndex) == ReferenceKind.Declaration)
                {
                    stack mut FunctionSignature callee = new();
                    if (TryParseFunctionSignatureFromTable(table, stream, refs.TargetAt(refIndex), callee))
                    {
                        stack u64[0 2 ** 63 - 1] tableIndex = (u64[0 2 ** 63 - 1])(refs.TargetAt(refIndex) - 1);
                        stack u32[0 max] calleeKeyword = table.KeywordTokenAt(tableIndex);
                        if (calleeKeyword != 0
                            && TypeSpanCanReturnBorrowedArena(stream, (u32[0 max])(calleeKeyword + 1), callee.Name()))
                        {
                            stack u64[0 2 ** 63 - 1] paramCount = callee.ParamCount();
                            for willexit (stack mut u64[0 2 ** 63 - 1] param = 0; param < paramCount; param += 1)
                            {
                                if ((u32[0 max])param < body.ExprCallArgCountAt(node)
                                    && TypeSpanIsMemoryBackedParameter(stream, callee.ParamStartTokenAt(param), callee.ParamNameAt(param))
                                    && ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, body.ExprCallArgAt(node, (u32[0 max])param)))
                                {
                                    return true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    return false;
}

internal fn System.Memory.MemoryStatus AppendArenaEscape(mut borrow BindDiagnosticList diags, u32[0 max] token)
{
    return diags.Append(BindDiagnosticCode.ArenaValueEscapes, token);
}

internal fn System.Memory.MemoryStatus CheckArenaRetainingArgument(
    borrow DeclarationTable table,
    ascii source,
    borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] callNode,
    u32[0 max] argIndex,
    mut borrow BindDiagnosticList diags)
{
    if (argIndex >= body.ExprCallArgCountAt(callNode))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] argNode = body.ExprCallArgAt(callNode, argIndex);
    if (ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, argNode))
    {
        switch (diags.Append(BindDiagnosticCode.ArenaValueRetainedByCallee, body.ExprTokenAt(argNode)))
        {
            case System.Memory.MemoryStatus.Err(var retainError):
                return System.Memory.MemoryStatus.Err(retainError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDirectArenaRetainingCallDiagnostics(
    borrow FunctionSignature callee,
    borrow DeclarationTable table,
    ascii source,
    borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] paramCount = callee.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] param = 0; param < paramCount; param += 1)
    {
        if (TypeSpanMayRetainArenaBorrow(stream, callee.ParamStartTokenAt(param), callee.ParamNameAt(param)))
        {
            switch (CheckArenaRetainingArgument(table, source, facts, refs, scope, body, stream, callNode, (u32[0 max])param, diags))
            {
                case System.Memory.MemoryStatus.Err(var directError):
                    return System.Memory.MemoryStatus.Err(directError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallbackArenaRetainingCallDiagnostics(
    borrow DeclarationTable table,
    ascii source,
    borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    u32[0 max] callNode,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] callableLParen = 0;
    stack mut u32[0 max] callableRParen = 0;
    if (!TryFindCallableParamList(stream, typeStart, typeEnd, callableLParen, callableRParen))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] paramCount = CallableParamCount(stream, callableLParen, callableRParen);
    for willexit (stack mut u32[0 max] param = 0; param < paramCount; param = (u32[0 max])(param + 1))
    {
        stack mut u32[0 max] paramStart = 0;
        stack mut u32[0 max] paramEnd = 0;
        if (TryCallableParamSpan(stream, callableLParen, callableRParen, param, paramStart, paramEnd)
            && TypeSpanMayRetainArenaBorrow(stream, paramStart, paramEnd))
        {
            switch (CheckArenaRetainingArgument(table, source, facts, refs, scope, body, stream, callNode, param, diags))
            {
                case System.Memory.MemoryStatus.Err(var callbackError):
                    return System.Memory.MemoryStatus.Err(callbackError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectArenaExpressionEffects(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    mut borrow ArenaSymbolFacts facts,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body,
    borrow TokenStream stream,
    u32[0 max] node,
    mut borrow BindDiagnosticList diags)
{
    if (node == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Assign)
    {
        stack u32[0 max] target = body.ExprLeftAt(node);
        stack u32[0 max] value = body.ExprRightAt(node);
        if (ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, value))
        {
            if (ExpressionRootIsLongLivedStorage(table, refs, scope, body, stream, target))
            {
                switch (AppendArenaEscape(diags, body.ExprTokenAt(target)))
                {
                    case System.Memory.MemoryStatus.Err(var storeError):
                        return System.Memory.MemoryStatus.Err(storeError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else
            {
                stack u32[0 max] rootLocal = LocalSymbolRootForExpression(refs, body, target);
                if (rootLocal != 0)
                {
                    switch (facts.MarkArenaBacked(rootLocal))
                    {
                        case System.Memory.MemoryStatus.Err(var markError):
                            return System.Memory.MemoryStatus.Err(markError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Call)
    {
        stack u32[0 max] calleeNode = body.ExprLeftAt(node);
        if (calleeNode != 0 && body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
            if (refIndexPlusOne != 0)
            {
                stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
                if (refs.KindAt(refIndex) == ReferenceKind.Declaration)
                {
                    stack mut FunctionSignature callee = new();
                    if (TryParseFunctionSignatureFromTable(table, stream, refs.TargetAt(refIndex), callee))
                    {
                        switch (CollectDirectArenaRetainingCallDiagnostics(callee, table, source, facts, refs, scope, body, stream, node, diags))
                        {
                            case System.Memory.MemoryStatus.Err(var directError):
                                return System.Memory.MemoryStatus.Err(directError);
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }
                }
                else if (refs.KindAt(refIndex) == ReferenceKind.Parameter)
                {
                    stack u32[0 max] target = refs.TargetAt(refIndex);
                    if (target != 0 && scope.KindAt((u64[0 2 ** 63 - 1])(target - 1)) == SymbolKind.Parameter)
                    {
                        stack u64[0 2 ** 63 - 1] paramIndex = (u64[0 2 ** 63 - 1])(target - 1);
                        if (paramIndex < signature.ParamCount())
                        {
                            switch (CollectCallbackArenaRetainingCallDiagnostics(table, source, facts, refs, scope, body, stream, signature.ParamStartTokenAt(paramIndex), signature.ParamNameAt(paramIndex), node, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var callbackError):
                                    return System.Memory.MemoryStatus.Err(callbackError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }
                }
            }
        }
    }

    switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, body.ExprLeftAt(node), diags))
    {
        case System.Memory.MemoryStatus.Err(var leftError):
            return System.Memory.MemoryStatus.Err(leftError);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, body.ExprRightAt(node), diags))
    {
        case System.Memory.MemoryStatus.Err(var rightError):
            return System.Memory.MemoryStatus.Err(rightError);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, body.ExprAuxAt(node), diags))
    {
        case System.Memory.MemoryStatus.Err(var auxError):
            return System.Memory.MemoryStatus.Err(auxError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack u32[0 max] argCount = body.ExprCallArgCountAt(node);
    for willexit (stack mut u32[0 max] arg = 0; arg < argCount; arg = (u32[0 max])(arg + 1))
    {
        switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, body.ExprCallArgAt(node, arg), diags))
        {
            case System.Memory.MemoryStatus.Err(var argError):
                return System.Memory.MemoryStatus.Err(argError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectArenaDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    stack mut ArenaSymbolFacts facts = new();
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        stack u32[0 max] root = body.ExprRootAt(index);
        stack mut TokenKind storage = TokenKind.EndOfFile;
        if (item.Kind == StatementKind.Local)
        {
            storage = stream.KindAt((u64[0 2 ** 63 - 1])item.StartToken);
        }

        if (signature.LawKind())
        {
            if (storage == TokenKind.Arena)
            {
                switch (diags.Append(BindDiagnosticCode.ArenaAllocationInLaw, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var localLawError):
                        return System.Memory.MemoryStatus.Err(localLawError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            if (ExpressionContainsArenaSelectorNew(body, stream, root))
            {
                switch (diags.Append(BindDiagnosticCode.ArenaAllocationInLaw, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var selectorLawError):
                        return System.Memory.MemoryStatus.Err(selectorLawError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        if (item.Kind == StatementKind.Local)
        {
            stack u32[0 max] localSymbol = SymbolIndexPlusOneForStatement(scope, (u32[0 max])index);
            if (storage == TokenKind.Arena)
            {
                switch (facts.MarkArenaRoot(localSymbol))
                {
                    case System.Memory.MemoryStatus.Err(var rootError):
                        return System.Memory.MemoryStatus.Err(rootError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (root != 0 && ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, root))
            {
                if (storage == TokenKind.Heap || storage == TokenKind.Static)
                {
                    switch (AppendArenaEscape(diags, item.NameToken))
                    {
                        case System.Memory.MemoryStatus.Err(var storageError):
                            return System.Memory.MemoryStatus.Err(storageError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
                else
                {
                    switch (facts.MarkArenaBacked(localSymbol))
                    {
                        case System.Memory.MemoryStatus.Err(var backedError):
                            return System.Memory.MemoryStatus.Err(backedError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
        }

        if (item.Kind == StatementKind.Return && root != 0
            && ExpressionIsArenaDerived(table, source, facts, refs, scope, body, stream, root))
        {
            switch (AppendArenaEscape(diags, body.ExprTokenAt(root)))
            {
                case System.Memory.MemoryStatus.Err(var returnError):
                    return System.Memory.MemoryStatus.Err(returnError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        switch (CollectArenaExpressionEffects(signature, table, source, facts, refs, scope, body, stream, root, diags))
        {
            case System.Memory.MemoryStatus.Err(var effectError):
                return System.Memory.MemoryStatus.Err(effectError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Parses the function signature named by a declaration-table entry. Returns
// false for non-function entries, missing keyword tokens, or malformed
// signatures.
internal fn bool TryParseFunctionSignatureFromTable(borrow DeclarationTable table, borrow TokenStream stream, u32[0 max] tableIndexPlusOne, out FunctionSignature signature)
{
    signature = new();
    if (tableIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(tableIndexPlusOne - 1);
    if (table.KindAt(slot) != DeclarationKind.Function)
    {
        return false;
    }

    stack u32[0 max] keyword = table.KeywordTokenAt(slot);
    switch (ParseFunctionSignature(stream, keyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return false;
        case ParseResult<FunctionSignature>.Ok(var parsed):
            signature = parsed;
            return true;
    }
}

public enum CallableCandidateKind
{
    Declaration,
    ScopeSymbol,
}

public struct CallableCandidateSetTable
{
    internal dynamic u32[0 max] CallNodes;
    internal dynamic u32[0 max] CalleeNodes;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] ArgumentCounts;
    internal dynamic u32[0 max] CandidateStartSlots;
    internal dynamic u32[0 max] CandidateCounts;
    internal dynamic CallableCandidateKind CandidateKinds;
    internal dynamic u32[0 max] CandidateTargets;

    CallableCandidateSetTable()
    {
        self.CallNodes = new();
        self.CalleeNodes = new();
        self.NameTokens = new();
        self.ArgumentCounts = new();
        self.CandidateStartSlots = new();
        self.CandidateCounts = new();
        self.CandidateKinds = new();
        self.CandidateTargets = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow CallableCandidateSetTable self)
    {
        return self.CallNodes.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] TotalCandidateCount(borrow CallableCandidateSetTable self)
    {
        return self.CandidateTargets.Length;
    }

    public law u32[0 max] CallNodeAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] node = 0;
        if (index < self.CallNodes.Length)
        {
            node = self.CallNodes[index];
        }

        return node;
    }

    public law u32[0 max] CalleeNodeAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] node = 0;
        if (index < self.CalleeNodes.Length)
        {
            node = self.CalleeNodes[index];
        }

        return node;
    }

    public law u32[0 max] NameTokenAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law u32[0 max] ArgumentCountAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ArgumentCounts.Length)
        {
            count = self.ArgumentCounts[index];
        }

        return count;
    }

    public law u32[0 max] CandidateCountAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.CandidateCounts.Length)
        {
            count = self.CandidateCounts[index];
        }

        return count;
    }

    public law CallableCandidateKind CandidateKindAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] site, u32[0 max] candidate)
    {
        stack mut CallableCandidateKind kind = CallableCandidateKind.Declaration;
        if (site < self.CandidateStartSlots.Length && candidate < self.CandidateCountAt(site))
        {
            stack u32[0 max] start = self.CandidateStartSlots[site];
            if (start >= 1)
            {
                stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])((start - 1) + candidate);
                if (slot < self.CandidateKinds.Length)
                {
                    kind = self.CandidateKinds[slot];
                }
            }
        }

        return kind;
    }

    public law u32[0 max] CandidateTargetAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] site, u32[0 max] candidate)
    {
        stack mut u32[0 max] target = 0;
        if (site < self.CandidateStartSlots.Length && candidate < self.CandidateCountAt(site))
        {
            stack u32[0 max] start = self.CandidateStartSlots[site];
            if (start >= 1)
            {
                stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])((start - 1) + candidate);
                if (slot < self.CandidateTargets.Length)
                {
                    target = self.CandidateTargets[slot];
                }
            }
        }

        return target;
    }

    public law u32[0 max] DeclarationCandidateCountAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] site)
    {
        stack mut u32[0 max] count = 0;
        stack u32[0 max] candidates = self.CandidateCountAt(site);
        for willexit (stack mut u32[0 max] candidate = 0; candidate < candidates; candidate += 1)
        {
            if (self.CandidateKindAt(site, candidate) == CallableCandidateKind.Declaration)
            {
                count = (u32[0 max])(count + 1);
            }
        }

        return count;
    }

    public law u32[0 max] ScopeSymbolCandidateCountAt(borrow CallableCandidateSetTable self, u64[0 2 ** 63 - 1] site)
    {
        stack mut u32[0 max] count = 0;
        stack u32[0 max] candidates = self.CandidateCountAt(site);
        for willexit (stack mut u32[0 max] candidate = 0; candidate < candidates; candidate += 1)
        {
            if (self.CandidateKindAt(site, candidate) == CallableCandidateKind.ScopeSymbol)
            {
                count = (u32[0 max])(count + 1);
            }
        }

        return count;
    }

    internal fn System.Memory.MemoryStatus AppendSet(mut borrow CallableCandidateSetTable self, u32[0 max] callNode, u32[0 max] calleeNode, u32[0 max] nameToken, u32[0 max] argumentCount, out u32[0 max] siteIndex)
    {
        siteIndex = 0;
        if (!self.CallNodes.TryReserve(1)
            || !self.CalleeNodes.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.ArgumentCounts.TryReserve(1)
            || !self.CandidateStartSlots.TryReserve(1)
            || !self.CandidateCounts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        siteIndex = (u32[0 max])(self.CallNodes.Length + 1);
        init self.CallNodes[self.CallNodes.Length] = callNode;
        init self.CalleeNodes[self.CalleeNodes.Length] = calleeNode;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.ArgumentCounts[self.ArgumentCounts.Length] = argumentCount;
        init self.CandidateStartSlots[self.CandidateStartSlots.Length] = (u32[0 max])(self.CandidateTargets.Length + 1);
        init self.CandidateCounts[self.CandidateCounts.Length] = 0;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus AppendCandidate(mut borrow CallableCandidateSetTable self, u32[0 max] siteIndex, CallableCandidateKind kind, u32[0 max] target)
    {
        if (siteIndex == 0 || target == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.CandidateKinds.TryReserve(1)
            || !self.CandidateTargets.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.CandidateKinds[self.CandidateKinds.Length] = kind;
        init self.CandidateTargets[self.CandidateTargets.Length] = target;

        stack u64[0 2 ** 63 - 1] siteSlot = (u64[0 2 ** 63 - 1])(siteIndex - 1);
        if (siteSlot < self.CandidateCounts.Length)
        {
            self.CandidateCounts[siteSlot] = (u32[0 max])(self.CandidateCounts[siteSlot] + 1);
        }

        return System.Memory.MemoryStatus.Ok;
    }
}

internal finite law bool TypeTokenIsCallableValue(borrow TokenStream stream, u32[0 max] typeToken)
{
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])typeToken);
    return kind == TokenKind.Fnptr || kind == TokenKind.Closure;
}

internal finite law TypedDeclarationFunctionKind FunctionKindFromFlags(bool finiteKind, bool lawKind)
{
    if (finiteKind && lawKind)
    {
        return TypedDeclarationFunctionKind.FiniteLaw;
    }

    if (finiteKind)
    {
        return TypedDeclarationFunctionKind.Finite;
    }

    if (lawKind)
    {
        return TypedDeclarationFunctionKind.Law;
    }

    return TypedDeclarationFunctionKind.Fn;
}

internal finite bool TryReadCallableSignatureKindAt(
    borrow TokenStream stream,
    u32[0 max] callableToken,
    u32[0 max] endExclusive,
    out TypedDeclarationFunctionKind functionKind)
{
    functionKind = TypedDeclarationFunctionKind.Fn;
    stack TokenKind callableKind = stream.KindAt((u64[0 2 ** 63 - 1])callableToken);
    if ((callableKind != TokenKind.Fnptr && callableKind != TokenKind.Closure)
        || stream.KindAt((u64[0 2 ** 63 - 1])(callableToken + 1)) != TokenKind.Lt)
    {
        return false;
    }

    stack mut bool finiteKind = false;
    stack mut bool lawKind = false;
    stack mut u32[0 max] nestedDepth = 0;
    stack mut TokenKind previousKind = TokenKind.EndOfFile;
    stack mut u32[0 max] scan = (u32[0 max])(callableToken + 2);
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (nestedDepth == 0)
        {
            if (kind == TokenKind.Finite)
            {
                finiteKind = true;
            }
            else if (kind == TokenKind.Law)
            {
                lawKind = true;
            }
            else if (kind == TokenKind.LParen)
            {
                if (previousKind == TokenKind.Ffi || previousKind == TokenKind.Asm)
                {
                    nestedDepth = (u32[0 max])(nestedDepth + 1);
                }
                else
                {
                    functionKind = FunctionKindFromFlags(finiteKind, lawKind);
                    return true;
                }
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.EndOfFile)
            {
                functionKind = FunctionKindFromFlags(finiteKind, lawKind);
                return true;
            }
            else if (kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
            {
                nestedDepth = (u32[0 max])(nestedDepth + 1);
            }
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            nestedDepth = (u32[0 max])(nestedDepth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            nestedDepth = (u32[0 max])(nestedDepth - 1);
        }

        previousKind = kind;
        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite bool TryReadCallableTypeFunctionKind(
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    out TypedDeclarationFunctionKind functionKind)
{
    functionKind = TypedDeclarationFunctionKind.Fn;
    stack mut u32[0 max] scan = start;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && (kind == TokenKind.Fnptr || kind == TokenKind.Closure))
        {
            return TryReadCallableSignatureKindAt(stream, scan, endExclusive, functionKind);
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite bool TryReadFunctionScopeCallableKind(
    borrow TokenStream stream,
    borrow FunctionScope scope,
    u32[0 max] targetPlusOne,
    out TypedDeclarationFunctionKind functionKind)
{
    functionKind = TypedDeclarationFunctionKind.Fn;
    if (targetPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] target = (u64[0 2 ** 63 - 1])(targetPlusOne - 1);
    if (target >= scope.Count())
    {
        return false;
    }

    return TryReadCallableTypeFunctionKind(
        stream,
        scope.TypeStartTokenAt(target),
        scope.TypeEndTokenAt(target),
        functionKind);
}

internal fn System.Memory.MemoryStatus AppendCallableDeclarationCandidatesByName(
    mut borrow CallableCandidateSetTable sets,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] siteIndex,
    u32[0 max] nameToken)
{
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (table.KindAt(index) == DeclarationKind.Function
            && TokenTextEqualsToken(source, stream, table.NameTokenAt(index), nameToken))
        {
            switch (sets.AppendCandidate(siteIndex, CallableCandidateKind.Declaration, (u32[0 max])(index + 1)))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendCallableValueCandidateIfPresent(
    mut borrow CallableCandidateSetTable sets,
    borrow TokenStream stream,
    borrow FunctionScope scope,
    u32[0 max] siteIndex,
    u32[0 max] targetPlusOne)
{
    if (targetPlusOne == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] target = (u64[0 2 ** 63 - 1])(targetPlusOne - 1);
    stack mut TypedDeclarationFunctionKind functionKind = TypedDeclarationFunctionKind.Fn;
    if (target < scope.Count()
        && TryReadCallableTypeFunctionKind(stream, scope.TypeStartTokenAt(target), scope.TypeEndTokenAt(target), functionKind))
    {
        return sets.AppendCandidate(siteIndex, CallableCandidateKind.ScopeSymbol, targetPlusOne);
    }

    return System.Memory.MemoryStatus.Ok;
}

public fn BindResult<CallableCandidateSetTable> BuildCallableCandidateSets(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body)
{
    stack mut CallableCandidateSetTable sets = new();
    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] callNode = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(callNode) == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] calleeNode = body.ExprLeftAt(callNode);
            if (calleeNode != 0 && body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier)
            {
                stack u32[0 max] nameToken = body.ExprTokenAt(calleeNode);
                stack mut u32[0 max] siteIndex = 0;
                switch (sets.AppendSet(callNode, calleeNode, nameToken, body.ExprCallArgCountAt(callNode), siteIndex))
                {
                    case System.Memory.MemoryStatus.Err(var setError):
                        return BindResult<CallableCandidateSetTable>.Err(BindError.OutOfMemory);
                    case System.Memory.MemoryStatus.Ok:
                }

                stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
                if (refIndexPlusOne == 0)
                {
                    switch (AppendCallableDeclarationCandidatesByName(sets, table, source, stream, siteIndex, nameToken))
                    {
                        case System.Memory.MemoryStatus.Err(var fallbackError):
                            return BindResult<CallableCandidateSetTable>.Err(BindError.OutOfMemory);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
                else
                {
                    stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
                    stack ReferenceKind kind = refs.KindAt(refIndex);
                    if (kind == ReferenceKind.Declaration)
                    {
                        switch (AppendCallableDeclarationCandidatesByName(sets, table, source, stream, siteIndex, nameToken))
                        {
                            case System.Memory.MemoryStatus.Err(var declarationError):
                                return BindResult<CallableCandidateSetTable>.Err(BindError.OutOfMemory);
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }
                    else if (kind == ReferenceKind.Parameter || kind == ReferenceKind.Local)
                    {
                        switch (AppendCallableValueCandidateIfPresent(sets, stream, scope, siteIndex, refs.TargetAt(refIndex)))
                        {
                            case System.Memory.MemoryStatus.Err(var scopeError):
                                return BindResult<CallableCandidateSetTable>.Err(BindError.OutOfMemory);
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }
                }
            }
        }
    }

    return BindResult<CallableCandidateSetTable>.Ok(sets);
}

internal struct CopyableLawPredicateTable
{
    internal dynamic u32[0 max] LawTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;

    CopyableLawPredicateTable()
    {
        self.LawTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow CopyableLawPredicateTable self)
    {
        return self.LawTokens.Length;
    }

    internal law u32[0 max] LawTokenAt(borrow CopyableLawPredicateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.LawTokens.Length)
        {
            token = self.LawTokens[index];
        }

        return token;
    }

    internal law u32[0 max] TypeStartTokenAt(borrow CopyableLawPredicateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeStartTokens.Length)
        {
            token = self.TypeStartTokens[index];
        }

        return token;
    }

    internal law u32[0 max] TypeEndTokenAt(borrow CopyableLawPredicateTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeEndTokens.Length)
        {
            token = self.TypeEndTokens[index];
        }

        return token;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow CopyableLawPredicateTable self, u32[0 max] lawToken, u32[0 max] typeStart, u32[0 max] typeEnd)
    {
        if (!self.LawTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.LawTokens[self.LawTokens.Length] = lawToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStart;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEnd;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal fn BindResult<CopyableLawPredicateTable> BuildCopyableLawPredicateTable(ascii source, borrow TokenStream stream, u32[0 max] ownerKeywordToken)
{
    stack mut CopyableLawPredicateTable predicates = new();
    stack u32[0 max] ownerEnd = TypedGenericOwnerTerminatorToken(stream, ownerKeywordToken);
    if (ownerKeywordToken == 0 || ownerEnd <= ownerKeywordToken)
    {
        return BindResult<CopyableLawPredicateTable>.Ok(predicates);
    }

    stack mut bool inWhere = false;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = ownerKeywordToken;
    while willexit (scan < ownerEnd)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Where)
        {
            inWhere = true;
            scan = (u32[0 max])(scan + 1);
            continue;
        }

        if (inWhere && depth == 0
            && kind == TokenKind.Identifier
            && TokenTextEquals(source, stream, scan, "Copyable")
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            stack u32[0 max] open = (u32[0 max])(scan + 1);
            stack u32[0 max] close = MatchingMemberCloseToken(stream, open);
            if (close > open)
            {
                switch (predicates.Append(scan, (u32[0 max])(open + 1), close))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return BindResult<CopyableLawPredicateTable>.Err(BindError.OutOfMemory);
                    case System.Memory.MemoryStatus.Ok:
                }

                scan = (u32[0 max])(close + 1);
                continue;
            }
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return BindResult<CopyableLawPredicateTable>.Ok(predicates);
}

internal finite law bool CopyableSingleIdentifierPrefixToken(TokenKind kind)
{
    return kind == TokenKind.Stack
        || kind == TokenKind.Heap
        || kind == TokenKind.Register
        || kind == TokenKind.Arena
        || kind == TokenKind.Const
        || kind == TokenKind.Mut
        || kind == TokenKind.Frozen
        || kind == TokenKind.Shared;
}

internal fn bool TypeSpanIsSingleIdentifier(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive, out u32[0 max] identifierToken)
{
    identifierToken = 0;
    stack mut u32[0 max] cursor = start;
    while willexit (cursor < endExclusive && CopyableSingleIdentifierPrefixToken(stream.KindAt((u64[0 2 ** 63 - 1])cursor)))
    {
        cursor = (u32[0 max])(cursor + 1);
    }

    if (cursor < endExclusive
        && endExclusive == (u32[0 max])(cursor + 1)
        && stream.KindAt((u64[0 2 ** 63 - 1])cursor) == TokenKind.Identifier)
    {
        identifierToken = cursor;
        return true;
    }

    return false;
}

internal fn bool CopyableLawPredicatesContainSingleIdentifier(
    borrow CopyableLawPredicateTable predicates,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] identifierToken)
{
    if (identifierToken == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] count = predicates.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack mut u32[0 max] predicateIdentifier = 0;
        if (TypeSpanIsSingleIdentifier(stream, predicates.TypeStartTokenAt(index), predicates.TypeEndTokenAt(index), predicateIdentifier)
            && TokenTextEqualsToken(source, stream, predicateIdentifier, identifierToken))
        {
            return true;
        }
    }

    return false;
}

internal fn bool ReferenceTypeSpanForNode(
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    u32[0 max] node,
    out u32[0 max] typeStart,
    out u32[0 max] typeEnd)
{
    typeStart = 0;
    typeEnd = 0;
    stack u64[0 2 ** 63 - 1] count = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (refs.NodeAt(index) == node)
        {
            stack ReferenceKind kind = refs.KindAt(index);
            if (kind == ReferenceKind.Parameter || kind == ReferenceKind.Local)
            {
                stack u32[0 max] target = refs.TargetAt(index);
                if (target != 0)
                {
                    stack u64[0 2 ** 63 - 1] scopeIndex = (u64[0 2 ** 63 - 1])(target - 1);
                    typeStart = scope.TypeStartTokenAt(scopeIndex);
                    typeEnd = scope.TypeEndTokenAt(scopeIndex);
                    return typeStart < typeEnd;
                }
            }
        }
    }

    return false;
}

internal fn bool StructFieldTypeSpan(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] structNameToken,
    u32[0 max] fieldNameToken,
    out u32[0 max] typeStart,
    out u32[0 max] typeEnd)
{
    typeStart = 0;
    typeEnd = 0;
    stack u32[0 max] structDefName = FindStructDefName(table, source, stream, structNameToken);
    if (structDefName == 0 || fieldNameToken == 0)
    {
        return false;
    }

    stack ascii fieldName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fieldNameToken);
    switch (ParseStructFields(stream, structDefName))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return false;
        case ParseResult<FieldList>.Ok(var fields):
            stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < fieldCount; field += 1)
            {
                stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(field));
                if (System.Text.Equals(name, fieldName))
                {
                    typeStart = fields.TypeStartAt(field);
                    typeEnd = fields.TypeEndAt(field);
                    return typeStart < typeEnd;
                }
            }
    }

    return false;
}

internal fn bool ExpressionTypeSpanForCopyableArgument(
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] node,
    out u32[0 max] typeStart,
    out u32[0 max] typeEnd)
{
    typeStart = 0;
    typeEnd = 0;
    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        return ReferenceTypeSpanForNode(refs, scope, node, typeStart, typeEnd);
    }

    if (kind == Compiler.Parsing.ExprKind.Member)
    {
        stack u32[0 max] receiverStruct = MemberStructNameToken(table, source, refs, scope, stream, body, body.ExprLeftAt(node));
        return StructFieldTypeSpan(table, source, stream, receiverStruct, body.ExprTokenAt(node), typeStart, typeEnd);
    }

    return false;
}

internal fn bool ExpressionIsIntrinsicCopyableValue(borrow TokenStream stream, borrow StatementList body, u32[0 max] node)
{
    stack ExprType exprType = ClassifyExprType(stream, body, node);
    return exprType == Compiler.Typing.ExprType.Bool
        || exprType == Compiler.Typing.ExprType.Int
        || exprType == Compiler.Typing.ExprType.Float;
}

internal fn bool TrySingleDeclarationCandidate(borrow CallableCandidateSetTable candidates, u64[0 2 ** 63 - 1] site, out u32[0 max] targetPlusOne)
{
    targetPlusOne = 0;
    if (candidates.DeclarationCandidateCountAt(site) != 1)
    {
        return false;
    }

    stack u32[0 max] candidateCount = candidates.CandidateCountAt(site);
    for willexit (stack mut u32[0 max] candidate = 0; candidate < candidateCount; candidate += 1)
    {
        if (candidates.CandidateKindAt(site, candidate) == CallableCandidateKind.Declaration)
        {
            targetPlusOne = candidates.CandidateTargetAt(site, candidate);
            return targetPlusOne != 0;
        }
    }

    return false;
}

internal fn bool TryMapCopyablePredicateToCallArgument(
    borrow FunctionSignature callee,
    ascii source,
    borrow DeclarationTable table,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] callNode,
    u32[0 max] predicateStart,
    u32[0 max] predicateEnd,
    out u32[0 max] typeStart,
    out u32[0 max] typeEnd,
    out bool intrinsicCopyable)
{
    typeStart = predicateStart;
    typeEnd = predicateEnd;
    intrinsicCopyable = false;

    stack mut u32[0 max] predicateIdentifier = 0;
    stack u32[0 max] calleeGenericList = (u32[0 max])(callee.Name() + 1);
    if (!TypeSpanIsSingleIdentifier(stream, predicateStart, predicateEnd, predicateIdentifier)
        || !GenericParamListMatches(source, stream, calleeGenericList, predicateIdentifier))
    {
        return predicateStart < predicateEnd;
    }

    stack u32[0 max] paramCount = (u32[0 max])callee.ParamCount();
    for willexit (stack mut u32[0 max] param = 0; param < paramCount; param += 1)
    {
        stack mut u32[0 max] paramIdentifier = 0;
        if (TypeSpanIsSingleIdentifier(stream, callee.ParamTypeStartTokenAt((u64[0 2 ** 63 - 1])param), callee.ParamTypeEndTokenAt((u64[0 2 ** 63 - 1])param), paramIdentifier)
            && TokenTextEqualsToken(source, stream, paramIdentifier, predicateIdentifier)
            && param < body.ExprCallArgCountAt(callNode))
        {
            stack u32[0 max] argNode = body.ExprCallArgAt(callNode, param);
            if (ExpressionTypeSpanForCopyableArgument(table, source, refs, scope, stream, body, argNode, typeStart, typeEnd))
            {
                return true;
            }

            stack bool argumentIsIntrinsicCopyable = ExpressionIsIntrinsicCopyableValue(stream, body, argNode);
            intrinsicCopyable = argumentIsIntrinsicCopyable;
            return argumentIsIntrinsicCopyable;
        }
    }

    return false;
}

internal fn bool CopyableLawArgumentSatisfied(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    borrow FunctionSignature caller,
    borrow CopyableLawPredicateTable callerPredicates,
    u32[0 max] typeStart,
    u32[0 max] typeEnd,
    bool intrinsicCopyable)
{
    if (intrinsicCopyable)
    {
        return true;
    }

    stack mut u32[0 max] typeIdentifier = 0;
    stack u32[0 max] callerGenericList = (u32[0 max])(caller.Name() + 1);
    if (TypeSpanIsSingleIdentifier(stream, typeStart, typeEnd, typeIdentifier)
        && GenericParamListMatches(source, stream, callerGenericList, typeIdentifier))
    {
        return CopyableLawPredicatesContainSingleIdentifier(callerPredicates, source, stream, typeIdentifier);
    }

    return CopyabilityTypeSpanIsCopyable(decls, table, source, stream, facts, typeStart, typeEnd, 0);
}

internal fn System.Memory.MemoryStatus CollectCopyableLawPredicateCallDiagnostics(
    borrow FunctionSignature caller,
    u32[0 max] callerKeywordToken,
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow CopyabilityFactTable facts,
    mut borrow BindDiagnosticList diags)
{
    stack mut CopyableLawPredicateTable callerPredicates = new();
    switch (BuildCopyableLawPredicateTable(source, stream, callerKeywordToken))
    {
        case BindResult<CopyableLawPredicateTable>.Err(var callerPredicateError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case BindResult<CopyableLawPredicateTable>.Ok(var builtCallerPredicates):
            callerPredicates = builtCallerPredicates;
    }

    switch (BuildCallableCandidateSets(table, source, stream, refs, scope, body))
    {
        case BindResult<CallableCandidateSetTable>.Err(var candidateError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case BindResult<CallableCandidateSetTable>.Ok(var candidates):
            stack u64[0 2 ** 63 - 1] siteCount = candidates.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] site = 0; site < siteCount; site += 1)
            {
                stack mut u32[0 max] targetPlusOne = 0;
                if (TrySingleDeclarationCandidate(candidates, site, targetPlusOne))
                {
                    stack mut FunctionSignature callee = new();
                    if (TryParseFunctionSignatureFromTable(table, stream, targetPlusOne, callee))
                    {
                        stack u64[0 2 ** 63 - 1] targetIndex = (u64[0 2 ** 63 - 1])(targetPlusOne - 1);
                        stack mut CopyableLawPredicateTable calleePredicates = new();
                        switch (BuildCopyableLawPredicateTable(source, stream, table.KeywordTokenAt(targetIndex)))
                        {
                            case BindResult<CopyableLawPredicateTable>.Err(var calleePredicateError):
                                return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                            case BindResult<CopyableLawPredicateTable>.Ok(var builtCalleePredicates):
                                calleePredicates = builtCalleePredicates;
                        }

                        stack u64[0 2 ** 63 - 1] predicateCount = calleePredicates.Count();
                        for willexit (stack mut u64[0 2 ** 63 - 1] predicate = 0; predicate < predicateCount; predicate += 1)
                        {
                            stack mut u32[0 max] typeStart = 0;
                            stack mut u32[0 max] typeEnd = 0;
                            stack mut bool intrinsicCopyable = false;
                            if (TryMapCopyablePredicateToCallArgument(
                                callee,
                                source,
                                table,
                                refs,
                                scope,
                                stream,
                                body,
                                candidates.CallNodeAt(site),
                                calleePredicates.TypeStartTokenAt(predicate),
                                calleePredicates.TypeEndTokenAt(predicate),
                                typeStart,
                                typeEnd,
                                intrinsicCopyable)
                                && !CopyableLawArgumentSatisfied(
                                    decls,
                                    table,
                                    source,
                                    stream,
                                    facts,
                                    caller,
                                    callerPredicates,
                                    typeStart,
                                    typeEnd,
                                    intrinsicCopyable))
                            {
                                switch (diags.Append(BindDiagnosticCode.CopyableConstraintInvalid, candidates.NameTokenAt(site)))
                                {
                                    case System.Memory.MemoryStatus.Err(var appendError):
                                        return System.Memory.MemoryStatus.Err(appendError);
                                    case System.Memory.MemoryStatus.Ok:
                                }
                            }
                        }
                    }
                }
            }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn u32[0 max] StatementIndexPlusOneForExprNode(borrow StatementList body, u32[0 max] node)
{
    if (node == 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    stack u64[0 2 ** 63 - 1] totalNodes = body.ExprNodeCount();
    stack u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])node;
    for willexit (stack mut u64[0 2 ** 63 - 1] statement = 0; statement < statementCount; statement += 1)
    {
        stack u64[0 2 ** 63 - 1] low = (u64[0 2 ** 63 - 1])body.ExprStartAt(statement);
        stack mut u64[0 2 ** 63 - 1] high = totalNodes;
        if ((u64[0 2 ** 63 - 1])(statement + 1) < statementCount)
        {
            high = (u64[0 2 ** 63 - 1])body.ExprStartAt((u64[0 2 ** 63 - 1])(statement + 1));
        }

        if (nodeIndex > low && nodeIndex <= high)
        {
            return (u32[0 max])(statement + 1);
        }
    }

    return 0;
}

internal fn bool ExpressionNodeIsDirectAssignmentTarget(borrow StatementList body, u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] candidate = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(candidate) == Compiler.Parsing.ExprKind.Assign
            && body.ExprLeftAt(candidate) == node)
        {
            return true;
        }
    }

    return false;
}

internal fn bool TryScopeTargetForIdentifierNode(
    borrow ReferenceTable refs,
    borrow StatementList body,
    u32[0 max] node,
    out u32[0 max] targetPlusOne)
{
    targetPlusOne = 0;
    if (node == 0 || body.ExprKindAt(node) != Compiler.Parsing.ExprKind.Identifier)
    {
        return false;
    }

    stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
    if (refIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
    stack ReferenceKind kind = refs.KindAt(refIndex);
    if ((kind == ReferenceKind.Parameter || kind == ReferenceKind.Local)
        && refs.TargetAt(refIndex) != 0)
    {
        targetPlusOne = refs.TargetAt(refIndex);
        return true;
    }

    return false;
}

internal fn bool FunctionScopeSymbolTypeFormsSafeBorrow(borrow TokenStream stream, borrow FunctionScope scope, u32[0 max] targetPlusOne)
{
    if (targetPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] target = (u64[0 2 ** 63 - 1])(targetPlusOne - 1);
    return target < scope.Count()
        && TypeSpanFormsSafeBorrow(stream, scope.TypeStartTokenAt(target), scope.TypeEndTokenAt(target));
}

internal fn bool FunctionScopeSymbolTypeIsCopyable(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable facts,
    borrow FunctionScope scope,
    u32[0 max] targetPlusOne)
{
    if (targetPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] target = (u64[0 2 ** 63 - 1])(targetPlusOne - 1);
    return target < scope.Count()
        && CopyabilityTypeSpanIsCopyable(
            decls,
            table,
            source,
            stream,
            facts,
            scope.TypeStartTokenAt(target),
            scope.TypeEndTokenAt(target),
            0);
}

internal fn bool FunctionScopeSymbolIsOutputOnlyParameter(borrow TokenStream stream, borrow FunctionScope scope, u32[0 max] targetPlusOne)
{
    if (targetPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] target = (u64[0 2 ** 63 - 1])(targetPlusOne - 1);
    return target < scope.Count()
        && scope.KindAt(target) == SymbolKind.Parameter
        && TypeSpanIsOutputOnlyParameter(stream, scope.TypeStartTokenAt(target), scope.TypeEndTokenAt(target));
}

internal struct StraightLineInitializedTargetTable
{
    internal dynamic u32[0 max] Targets;
    internal dynamic u32[0 max] InitializedFlags;

    StraightLineInitializedTargetTable()
    {
        self.Targets = new();
        self.InitializedFlags = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow StraightLineInitializedTargetTable self)
    {
        return self.Targets.Length;
    }

    internal law u32[0 max] TargetAt(borrow StraightLineInitializedTargetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] target = 0;
        if (index < self.Targets.Length)
        {
            target = self.Targets[index];
        }

        return target;
    }

    internal law u32[0 max] InitializedFlagAt(borrow StraightLineInitializedTargetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flag = 0;
        if (index < self.InitializedFlags.Length)
        {
            flag = self.InitializedFlags[index];
        }

        return flag;
    }

    internal fn u32[0 max] IndexPlusOneOf(borrow StraightLineInitializedTargetTable self, u32[0 max] target)
    {
        if (target == 0)
        {
            return 0;
        }

        stack u64[0 2 ** 63 - 1] count = self.Count();
        stack mut u64[0 2 ** 63 - 1] remaining = count;
        while willexit (remaining > 0)
        {
            remaining = (u64[0 2 ** 63 - 1])(remaining - 1);
            stack u64[0 2 ** 63 - 1] index = remaining;
            if (self.TargetAt(index) == target)
            {
                return (u32[0 max])(index + 1);
            }
        }

        return 0;
    }

    internal fn bool IsTracked(borrow StraightLineInitializedTargetTable self, u32[0 max] target)
    {
        return self.IndexPlusOneOf(target) != 0;
    }

    internal fn bool IsInitialized(borrow StraightLineInitializedTargetTable self, u32[0 max] target)
    {
        stack u32[0 max] indexPlusOne = self.IndexPlusOneOf(target);
        if (indexPlusOne == 0)
        {
            return false;
        }

        return self.InitializedFlagAt((u64[0 2 ** 63 - 1])(indexPlusOne - 1)) != 0;
    }

    internal fn System.Memory.MemoryStatus AppendState(mut borrow StraightLineInitializedTargetTable self, u32[0 max] target, bool initialized)
    {
        if (target == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.Targets.TryReserve(1)
            || !self.InitializedFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        stack mut u32[0 max] flag = 0;
        if (initialized)
        {
            flag = 1;
        }

        init self.Targets[self.Targets.Length] = target;
        init self.InitializedFlags[self.InitializedFlags.Length] = flag;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus TrackUninitialized(mut borrow StraightLineInitializedTargetTable self, u32[0 max] target)
    {
        if (target == 0 || self.IsTracked(target))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        return self.AppendState(target, false);
    }

    internal fn System.Memory.MemoryStatus MarkInitialized(mut borrow StraightLineInitializedTargetTable self, u32[0 max] target)
    {
        if (target == 0 || !self.IsTracked(target) || self.IsInitialized(target))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        return self.AppendState(target, true);
    }
}

internal struct InitializationExpressionWorkStack
{
    internal dynamic u32[0 max] Nodes;
    internal dynamic u32[0 max] Phases;

    InitializationExpressionWorkStack()
    {
        self.Nodes = new();
        self.Phases = new();
    }

    internal fn System.Memory.MemoryStatus Push(mut borrow InitializationExpressionWorkStack self, u32[0 max] node, u32[0 max] phase)
    {
        if (node == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.Nodes.TryReserve(1)
            || !self.Phases.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Nodes[self.Nodes.Length] = node;
        init self.Phases[self.Phases.Length] = phase;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn bool TryPop(mut borrow InitializationExpressionWorkStack self, out u32[0 max] node, out u32[0 max] phase)
    {
        node = 0;
        phase = 0;
        if (self.Nodes.Length == 0 || self.Phases.Length == 0)
        {
            return false;
        }

        node = self.Nodes.MoveLast();
        phase = self.Phases.MoveLast();
        return true;
    }
}

internal fn System.Memory.MemoryStatus BuildInitialStraightLineInitializationState(
    borrow FunctionScope scope,
    borrow TokenStream stream,
    mut borrow StraightLineInitializedTargetTable initializedTargets)
{
    stack u64[0 2 ** 63 - 1] count = scope.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack u32[0 max] target = (u32[0 max])(index + 1);
        if (scope.KindAt(index) == SymbolKind.Local
            || FunctionScopeSymbolIsOutputOnlyParameter(stream, scope, target))
        {
            switch (initializedTargets.TrackUninitialized(target))
            {
                case System.Memory.MemoryStatus.Err(var trackError):
                    return System.Memory.MemoryStatus.Err(trackError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CheckStraightLineInitializationRead(
    borrow ReferenceTable refs,
    borrow StatementList body,
    u32[0 max] node,
    borrow StraightLineInitializedTargetTable initializedTargets,
    mut borrow BindDiagnosticList diags)
{
    stack mut u32[0 max] target = 0;
    if (TryScopeTargetForIdentifierNode(refs, body, node, target)
        && initializedTargets.IsTracked(target)
        && !initializedTargets.IsInitialized(target))
    {
        switch (diags.Append(BindDiagnosticCode.ReadBeforeInitialization, body.ExprTokenAt(node)))
        {
            case System.Memory.MemoryStatus.Err(var diagError):
                return System.Memory.MemoryStatus.Err(diagError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool ScopeTargetIsTrackedOutputOnlyParameter(
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] node)
{
    stack mut u32[0 max] target = 0;
    return TryScopeTargetForIdentifierNode(refs, body, node, target)
        && FunctionScopeSymbolIsOutputOnlyParameter(stream, scope, target);
}

internal fn System.Memory.MemoryStatus CollectStraightLineInitializationDiagnosticsInExpression(
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] node,
    mut borrow StraightLineInitializedTargetTable initializedTargets,
    mut borrow BindDiagnosticList diags)
{
    stack mut InitializationExpressionWorkStack work = new();
    switch (work.Push(node, 0))
    {
        case System.Memory.MemoryStatus.Err(var pushRootError):
            return System.Memory.MemoryStatus.Err(pushRootError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut u32[0 max] current = 0;
    stack mut u32[0 max] phase = 0;
    while willexit (work.TryPop(current, phase))
    {
        if (phase == 1)
        {
            stack mut u32[0 max] assignedTarget = 0;
            if (TryScopeTargetForIdentifierNode(refs, body, current, assignedTarget))
            {
                switch (initializedTargets.MarkInitialized(assignedTarget))
                {
                    case System.Memory.MemoryStatus.Err(var markError):
                        return System.Memory.MemoryStatus.Err(markError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            continue;
        }

        stack ExprKind kind = body.ExprKindAt(current);
        if (phase == 2)
        {
            if (kind == Compiler.Parsing.ExprKind.Identifier)
            {
                if (!ScopeTargetIsTrackedOutputOnlyParameter(refs, scope, stream, body, current))
                {
                    switch (CheckStraightLineInitializationRead(refs, body, current, initializedTargets, diags))
                    {
                        case System.Memory.MemoryStatus.Err(var placeReadError):
                            return System.Memory.MemoryStatus.Err(placeReadError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                continue;
            }

            if (kind == Compiler.Parsing.ExprKind.Member)
            {
                switch (work.Push(body.ExprLeftAt(current), 2))
                {
                    case System.Memory.MemoryStatus.Err(var memberPlaceError):
                        return System.Memory.MemoryStatus.Err(memberPlaceError);
                    case System.Memory.MemoryStatus.Ok:
                }

                continue;
            }

            if (kind == Compiler.Parsing.ExprKind.Index)
            {
                switch (work.Push(body.ExprAuxAt(current), 0))
                {
                    case System.Memory.MemoryStatus.Err(var indexLengthError):
                        return System.Memory.MemoryStatus.Err(indexLengthError);
                    case System.Memory.MemoryStatus.Ok:
                }

                switch (work.Push(body.ExprRightAt(current), 0))
                {
                    case System.Memory.MemoryStatus.Err(var indexReadError):
                        return System.Memory.MemoryStatus.Err(indexReadError);
                    case System.Memory.MemoryStatus.Ok:
                }

                switch (work.Push(body.ExprLeftAt(current), 2))
                {
                    case System.Memory.MemoryStatus.Err(var indexReceiverError):
                        return System.Memory.MemoryStatus.Err(indexReceiverError);
                    case System.Memory.MemoryStatus.Ok:
                }

                continue;
            }

            if (kind == Compiler.Parsing.ExprKind.Unary)
            {
                switch (work.Push(body.ExprLeftAt(current), 2))
                {
                    case System.Memory.MemoryStatus.Err(var unaryPlaceError):
                        return System.Memory.MemoryStatus.Err(unaryPlaceError);
                    case System.Memory.MemoryStatus.Ok:
                }

                continue;
            }
        }

        if (kind == Compiler.Parsing.ExprKind.Identifier)
        {
            switch (CheckStraightLineInitializationRead(refs, body, current, initializedTargets, diags))
            {
                case System.Memory.MemoryStatus.Err(var readError):
                    return System.Memory.MemoryStatus.Err(readError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Assign)
        {
            stack TokenKind operatorKind = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(current));
            if (operatorKind == TokenKind.Assign)
            {
                stack u32[0 max] targetNode = body.ExprLeftAt(current);
                stack mut u32[0 max] target = 0;
                if (targetNode != 0
                    && body.ExprKindAt(targetNode) == Compiler.Parsing.ExprKind.Identifier
                    && TryScopeTargetForIdentifierNode(refs, body, targetNode, target)
                    && initializedTargets.IsTracked(target))
                {
                    switch (work.Push(targetNode, 1))
                    {
                        case System.Memory.MemoryStatus.Err(var markPushError):
                            return System.Memory.MemoryStatus.Err(markPushError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
                else
                {
                    switch (work.Push(targetNode, 2))
                    {
                        case System.Memory.MemoryStatus.Err(var targetPushError):
                            return System.Memory.MemoryStatus.Err(targetPushError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }

                switch (work.Push(body.ExprRightAt(current), 0))
                {
                    case System.Memory.MemoryStatus.Err(var rightPushError):
                        return System.Memory.MemoryStatus.Err(rightPushError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else
            {
                switch (work.Push(body.ExprRightAt(current), 0))
                {
                    case System.Memory.MemoryStatus.Err(var compoundRightPushError):
                        return System.Memory.MemoryStatus.Err(compoundRightPushError);
                    case System.Memory.MemoryStatus.Ok:
                }

                switch (work.Push(body.ExprLeftAt(current), 0))
                {
                    case System.Memory.MemoryStatus.Err(var compoundLeftPushError):
                        return System.Memory.MemoryStatus.Err(compoundLeftPushError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Member)
        {
            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var memberReceiverPushError):
                    return System.Memory.MemoryStatus.Err(memberReceiverPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Binary
            || kind == Compiler.Parsing.ExprKind.Index)
        {
            switch (work.Push(body.ExprAuxAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var auxPushError):
                    return System.Memory.MemoryStatus.Err(auxPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (work.Push(body.ExprRightAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var rightPushError):
                    return System.Memory.MemoryStatus.Err(rightPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var leftPushError):
                    return System.Memory.MemoryStatus.Err(leftPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Unary)
        {
            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var unaryPushError):
                    return System.Memory.MemoryStatus.Err(unaryPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Call || kind == Compiler.Parsing.ExprKind.New)
        {
            stack mut u32[0 max] remainingArgs = body.ExprCallArgCountAt(current);
            while willexit (remainingArgs > 0)
            {
                remainingArgs = (u32[0 max])(remainingArgs - 1);
                switch (work.Push(body.ExprCallArgAt(current, remainingArgs), 0))
                {
                    case System.Memory.MemoryStatus.Err(var argPushError):
                        return System.Memory.MemoryStatus.Err(argPushError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var calleePushError):
                    return System.Memory.MemoryStatus.Err(calleePushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Conversion)
        {
            switch (work.Push(body.ExprRightAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var conversionPushError):
                    return System.Memory.MemoryStatus.Err(conversionPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            continue;
        }

        if (kind == Compiler.Parsing.ExprKind.Conditional)
        {
            switch (work.Push(body.ExprAuxAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var elsePushError):
                    return System.Memory.MemoryStatus.Err(elsePushError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (work.Push(body.ExprRightAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var thenPushError):
                    return System.Memory.MemoryStatus.Err(thenPushError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (work.Push(body.ExprLeftAt(current), 0))
            {
                case System.Memory.MemoryStatus.Err(var conditionPushError):
                    return System.Memory.MemoryStatus.Err(conditionPushError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool LocalStatementIsForEachBinding(borrow StatementList body, u64[0 2 ** 63 - 1] statement)
{
    if (statement >= body.Count())
    {
        return false;
    }

    stack StatementItem item = body.ItemAt(statement);
    if (item.Kind != StatementKind.Local || body.ExprRootAt(statement) != 0)
    {
        return false;
    }

    stack u32[0 max] depth = body.DepthAt(statement);
    stack mut u64[0 2 ** 63 - 1] scan = (u64[0 2 ** 63 - 1])(statement + 1);
    while willexit (scan < body.Count() && body.DepthAt(scan) == depth)
    {
        stack StatementItem next = body.ItemAt(scan);
        if (next.Kind == StatementKind.ForEach
            && item.StartToken > next.StartToken
            && item.EndToken < next.EndToken)
        {
            return true;
        }

        if (next.Kind != StatementKind.Local)
        {
            return false;
        }

        scan = (u64[0 2 ** 63 - 1])(scan + 1);
    }

    return false;
}

internal fn System.Memory.MemoryStatus MarkStraightLineLocalInitializedAfterStatement(
    borrow FunctionScope scope,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statement,
    mut borrow StraightLineInitializedTargetTable initializedTargets)
{
    stack StatementItem item = body.ItemAt(statement);
    stack bool initializesLocal = item.Kind == StatementKind.PatternBinding
        || (item.Kind == StatementKind.Local
            && (body.ExprRootAt(statement) != 0 || LocalStatementIsForEachBinding(body, statement)));
    if (!initializesLocal)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] target = SymbolIndexPlusOneForStatement(scope, (u32[0 max])statement);
    return initializedTargets.MarkInitialized(target);
}

internal fn System.Memory.MemoryStatus CollectStraightLineInitializationDiagnostics(
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    stack mut StraightLineInitializedTargetTable initializedTargets = new();
    switch (BuildInitialStraightLineInitializationState(scope, stream, initializedTargets))
    {
        case System.Memory.MemoryStatus.Err(var buildError):
            return System.Memory.MemoryStatus.Err(buildError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] statement = 0; statement < statementCount; statement += 1)
    {
        switch (CollectStraightLineInitializationDiagnosticsInExpression(
            refs,
            scope,
            stream,
            body,
            body.ExprRootAt(statement),
            initializedTargets,
            diags))
        {
            case System.Memory.MemoryStatus.Err(var expressionError):
                return System.Memory.MemoryStatus.Err(expressionError);
            case System.Memory.MemoryStatus.Ok:
        }

        switch (MarkStraightLineLocalInitializedAfterStatement(scope, body, statement, initializedTargets))
        {
            case System.Memory.MemoryStatus.Err(var localError):
                return System.Memory.MemoryStatus.Err(localError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal struct StraightLineMovedTargetTable
{
    internal dynamic u32[0 max] Targets;
    internal dynamic u32[0 max] MoveTokens;

    StraightLineMovedTargetTable()
    {
        self.Targets = new();
        self.MoveTokens = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow StraightLineMovedTargetTable self)
    {
        return self.Targets.Length;
    }

    internal law u32[0 max] TargetAt(borrow StraightLineMovedTargetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] target = 0;
        if (index < self.Targets.Length)
        {
            target = self.Targets[index];
        }

        return target;
    }

    internal law u32[0 max] MoveTokenAt(borrow StraightLineMovedTargetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.MoveTokens.Length)
        {
            token = self.MoveTokens[index];
        }

        return token;
    }

    internal fn u32[0 max] IndexPlusOneOf(borrow StraightLineMovedTargetTable self, u32[0 max] target)
    {
        if (target == 0)
        {
            return 0;
        }

        stack u64[0 2 ** 63 - 1] count = self.Count();
        stack mut u64[0 2 ** 63 - 1] remaining = count;
        while willexit (remaining > 0)
        {
            remaining = (u64[0 2 ** 63 - 1])(remaining - 1);
            stack u64[0 2 ** 63 - 1] index = remaining;
            if (self.TargetAt(index) == target)
            {
                if (self.MoveTokenAt(index) == 0)
                {
                    return 0;
                }

                return (u32[0 max])(index + 1);
            }
        }

        return 0;
    }

    internal fn bool Contains(borrow StraightLineMovedTargetTable self, u32[0 max] target)
    {
        return self.IndexPlusOneOf(target) != 0;
    }

    internal fn System.Memory.MemoryStatus MarkMoved(mut borrow StraightLineMovedTargetTable self, u32[0 max] target, u32[0 max] moveToken)
    {
        if (target == 0 || self.Contains(target))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.Targets.TryReserve(1)
            || !self.MoveTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Targets[self.Targets.Length] = target;
        init self.MoveTokens[self.MoveTokens.Length] = moveToken;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus MarkAvailable(mut borrow StraightLineMovedTargetTable self, u32[0 max] target)
    {
        if (target == 0 || !self.Contains(target))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.Targets.TryReserve(1)
            || !self.MoveTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Targets[self.Targets.Length] = target;
        init self.MoveTokens[self.MoveTokens.Length] = 0;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal fn u32[0 max] LastUseStatementIndexPlusOneForScopeTarget(
    borrow ReferenceTable refs,
    borrow StatementList body,
    u32[0 max] targetPlusOne,
    u32[0 max] startStatementPlusOne)
{
    if (targetPlusOne == 0)
    {
        return 0;
    }

    stack mut u32[0 max] lastUse = 0;
    stack u64[0 2 ** 63 - 1] refCount = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] refIndex = 0; refIndex < refCount; refIndex += 1)
    {
        stack ReferenceKind kind = refs.KindAt(refIndex);
        if ((kind == ReferenceKind.Parameter || kind == ReferenceKind.Local)
            && refs.TargetAt(refIndex) == targetPlusOne
            && !ExpressionNodeIsDirectAssignmentTarget(body, refs.NodeAt(refIndex)))
        {
            stack u32[0 max] statementPlusOne = StatementIndexPlusOneForExprNode(body, refs.NodeAt(refIndex));
            if (statementPlusOne > startStatementPlusOne && statementPlusOne > lastUse)
            {
                lastUse = statementPlusOne;
            }
        }
    }

    return lastUse;
}

internal fn bool TrySingleFunctionDeclarationByName(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] nameToken,
    out u32[0 max] targetPlusOne)
{
    targetPlusOne = 0;
    stack mut u32[0 max] matchCount = 0;
    stack mut u32[0 max] matchTarget = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (table.KindAt(index) == DeclarationKind.Function
            && TokenTextEqualsToken(source, stream, table.NameTokenAt(index), nameToken))
        {
            matchCount = (u32[0 max])(matchCount + 1);
            matchTarget = (u32[0 max])(index + 1);
        }
    }

    if (matchCount == 1)
    {
        targetPlusOne = matchTarget;
        return true;
    }

    return false;
}

internal fn bool TryDirectFunctionCallTarget(
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] calleeNode,
    out u32[0 max] targetPlusOne)
{
    targetPlusOne = 0;
    if (calleeNode == 0 || body.ExprKindAt(calleeNode) != Compiler.Parsing.ExprKind.Identifier)
    {
        return false;
    }

    stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
    if (refIndexPlusOne != 0)
    {
        stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
        if (refs.KindAt(refIndex) == ReferenceKind.Declaration)
        {
            stack u32[0 max] target = refs.TargetAt(refIndex);
            if (target != 0)
            {
                stack u64[0 2 ** 63 - 1] tableIndex = (u64[0 2 ** 63 - 1])(target - 1);
                if (tableIndex < table.Count() && table.KindAt(tableIndex) == DeclarationKind.Function)
                {
                    targetPlusOne = target;
                    return true;
                }
            }
        }

        return false;
    }

    return TrySingleFunctionDeclarationByName(table, source, stream, body.ExprTokenAt(calleeNode), targetPlusOne);
}

internal fn bool CallMovesScopeTarget(
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] callNode,
    u32[0 max] ownerTargetPlusOne,
    bool ownerIsCopyable,
    out u32[0 max] conflictToken)
{
    conflictToken = 0;
    if (callNode == 0
        || body.ExprKindAt(callNode) != Compiler.Parsing.ExprKind.Call
        || ownerIsCopyable)
    {
        return false;
    }

    stack u32[0 max] calleeNode = body.ExprLeftAt(callNode);
    if (calleeNode == 0 || body.ExprKindAt(calleeNode) != Compiler.Parsing.ExprKind.Identifier)
    {
        return false;
    }

    stack mut u32[0 max] targetPlusOne = 0;
    if (!TryDirectFunctionCallTarget(table, source, refs, stream, body, calleeNode, targetPlusOne))
    {
        return false;
    }

    stack mut FunctionSignature callee = new();
    if (!TryParseFunctionSignatureFromTable(table, stream, targetPlusOne, callee))
    {
        return false;
    }

    stack mut u32[0 max] argLimit = body.ExprCallArgCountAt(callNode);
    stack u32[0 max] paramCount = (u32[0 max])callee.ParamCount();
    if (argLimit > paramCount)
    {
        argLimit = paramCount;
    }

    for willexit (stack mut u32[0 max] arg = 0; arg < argLimit; arg = (u32[0 max])(arg + 1))
    {
        stack u32[0 max] argNode = body.ExprCallArgAt(callNode, arg);
        stack mut u32[0 max] argTarget = 0;
        if (TryScopeTargetForIdentifierNode(refs, body, argNode, argTarget)
            && argTarget == ownerTargetPlusOne
            && !TypeSpanFormsSafeBorrow(
                stream,
                callee.ParamTypeStartTokenAt((u64[0 2 ** 63 - 1])arg),
                callee.ParamTypeEndTokenAt((u64[0 2 ** 63 - 1])arg)))
        {
            conflictToken = body.ExprTokenAt(argNode);
            return true;
        }
    }

    return false;
}

internal fn bool StatementOverwritesScopeTarget(
    borrow ReferenceTable refs,
    borrow StatementList body,
    u32[0 max] statementPlusOne,
    u32[0 max] ownerTargetPlusOne,
    out u32[0 max] conflictToken)
{
    conflictToken = 0;
    if (statementPlusOne == 0 || ownerTargetPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] statement = (u64[0 2 ** 63 - 1])(statementPlusOne - 1);
    stack u64[0 2 ** 63 - 1] low = (u64[0 2 ** 63 - 1])body.ExprStartAt(statement);
    stack mut u64[0 2 ** 63 - 1] high = body.ExprNodeCount();
    if ((u64[0 2 ** 63 - 1])(statement + 1) < body.Count())
    {
        high = (u64[0 2 ** 63 - 1])body.ExprStartAt((u64[0 2 ** 63 - 1])(statement + 1));
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])(low + 1); nodeIndex <= high; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Assign)
        {
            stack u32[0 max] root = AssignmentTargetRootNode(body, body.ExprLeftAt(node));
            stack mut u32[0 max] target = 0;
            if (TryScopeTargetForIdentifierNode(refs, body, root, target)
                && target == ownerTargetPlusOne)
            {
                conflictToken = body.ExprTokenAt(root);
                return true;
            }
        }
    }

    return false;
}

internal fn bool SimpleAssignmentMovesScopeTarget(
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] assignmentNode,
    u32[0 max] ownerTargetPlusOne,
    bool ownerIsCopyable,
    out u32[0 max] conflictToken)
{
    conflictToken = 0;
    if (assignmentNode == 0
        || ownerTargetPlusOne == 0
        || ownerIsCopyable
        || body.ExprKindAt(assignmentNode) != Compiler.Parsing.ExprKind.Assign
        || stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(assignmentNode)) != TokenKind.Assign)
    {
        return false;
    }

    stack u32[0 max] targetNode = body.ExprLeftAt(assignmentNode);
    stack mut u32[0 max] target = 0;
    if (targetNode == 0
        || body.ExprKindAt(targetNode) != Compiler.Parsing.ExprKind.Identifier
        || !TryScopeTargetForIdentifierNode(refs, body, targetNode, target)
        || FunctionScopeSymbolTypeFormsSafeBorrow(stream, scope, target))
    {
        return false;
    }

    stack u32[0 max] sourceNode = body.ExprRightAt(assignmentNode);
    stack mut u32[0 max] sourceTarget = 0;
    if (TryScopeTargetForIdentifierNode(refs, body, sourceNode, sourceTarget)
        && sourceTarget == ownerTargetPlusOne
        && !FunctionScopeSymbolTypeFormsSafeBorrow(stream, scope, sourceTarget))
    {
        conflictToken = body.ExprTokenAt(sourceNode);
        return true;
    }

    return false;
}

internal fn bool LocalInitializerMovesScopeTarget(
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statement,
    u32[0 max] ownerTargetPlusOne,
    bool ownerIsCopyable,
    out u32[0 max] conflictToken)
{
    conflictToken = 0;
    if (ownerTargetPlusOne == 0 || ownerIsCopyable)
    {
        return false;
    }

    stack StatementItem item = body.ItemAt(statement);
    if (item.Kind != StatementKind.Local
        || TypeSpanFormsSafeBorrow(stream, item.TypeStartToken, item.TypeEndToken))
    {
        return false;
    }

    stack u32[0 max] root = body.ExprRootAt(statement);
    stack mut u32[0 max] sourceTarget = 0;
    if (TryScopeTargetForIdentifierNode(refs, body, root, sourceTarget)
        && sourceTarget == ownerTargetPlusOne
        && !FunctionScopeSymbolTypeFormsSafeBorrow(stream, scope, sourceTarget))
    {
        conflictToken = body.ExprTokenAt(root);
        return true;
    }

    return false;
}

internal fn bool StatementMovesScopeTargetIntoAssignmentOrLocal(
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] statementPlusOne,
    u32[0 max] ownerTargetPlusOne,
    bool ownerIsCopyable,
    out u32[0 max] conflictToken)
{
    conflictToken = 0;
    if (statementPlusOne == 0 || ownerTargetPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] statement = (u64[0 2 ** 63 - 1])(statementPlusOne - 1);
    if (LocalInitializerMovesScopeTarget(refs, scope, stream, body, statement, ownerTargetPlusOne, ownerIsCopyable, conflictToken))
    {
        return true;
    }

    stack u64[0 2 ** 63 - 1] low = (u64[0 2 ** 63 - 1])body.ExprStartAt(statement);
    stack mut u64[0 2 ** 63 - 1] high = body.ExprNodeCount();
    if ((u64[0 2 ** 63 - 1])(statement + 1) < body.Count())
    {
        high = (u64[0 2 ** 63 - 1])body.ExprStartAt((u64[0 2 ** 63 - 1])(statement + 1));
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])(low + 1); nodeIndex <= high; nodeIndex += 1)
    {
        if (SimpleAssignmentMovesScopeTarget(
            refs,
            scope,
            stream,
            body,
            (u32[0 max])nodeIndex,
            ownerTargetPlusOne,
            ownerIsCopyable,
            conflictToken))
        {
            return true;
        }
    }

    return false;
}

internal fn bool StatementMovesScopeTargetIntoDirectCall(
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] statementPlusOne,
    u32[0 max] ownerTargetPlusOne,
    bool ownerIsCopyable,
    out u32[0 max] conflictToken)
{
    conflictToken = 0;
    if (statementPlusOne == 0 || ownerTargetPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] statement = (u64[0 2 ** 63 - 1])(statementPlusOne - 1);
    stack u64[0 2 ** 63 - 1] low = (u64[0 2 ** 63 - 1])body.ExprStartAt(statement);
    stack mut u64[0 2 ** 63 - 1] high = body.ExprNodeCount();
    if ((u64[0 2 ** 63 - 1])(statement + 1) < body.Count())
    {
        high = (u64[0 2 ** 63 - 1])body.ExprStartAt((u64[0 2 ** 63 - 1])(statement + 1));
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])(low + 1); nodeIndex <= high; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (CallMovesScopeTarget(
            table,
            source,
            refs,
            stream,
            body,
            node,
            ownerTargetPlusOne,
            ownerIsCopyable,
            conflictToken))
        {
            return true;
        }
    }

    return false;
}

internal fn bool ExpressionNodeIsDirectSimpleAssignmentTarget(borrow StatementList body, borrow TokenStream stream, u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] candidate = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(candidate) == Compiler.Parsing.ExprKind.Assign
            && body.ExprLeftAt(candidate) == node
            && stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(candidate)) == TokenKind.Assign)
        {
            return true;
        }
    }

    return false;
}

internal fn System.Memory.MemoryStatus CollectStraightLineMovedTargetReadDiagnostics(
    borrow ReferenceTable refs,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] statementPlusOne,
    mut borrow StraightLineMovedTargetTable movedTargets,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] refCount = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] refIndex = 0; refIndex < refCount; refIndex += 1)
    {
        stack ReferenceKind kind = refs.KindAt(refIndex);
        if ((kind == ReferenceKind.Parameter || kind == ReferenceKind.Local)
            && StatementIndexPlusOneForExprNode(body, refs.NodeAt(refIndex)) == statementPlusOne
            && !ExpressionNodeIsDirectSimpleAssignmentTarget(body, stream, refs.NodeAt(refIndex)))
        {
            stack u32[0 max] target = refs.TargetAt(refIndex);
            stack u32[0 max] movedIndexPlusOne = movedTargets.IndexPlusOneOf(target);
            if (movedIndexPlusOne != 0)
            {
                switch (diags.Append(BindDiagnosticCode.MoveAfterMove, refs.NameTokenAt(refIndex)))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return System.Memory.MemoryStatus.Err(appendError);
                    case System.Memory.MemoryStatus.Ok:
                }

                switch (movedTargets.MarkAvailable(target))
                {
                    case System.Memory.MemoryStatus.Err(var availableError):
                        return System.Memory.MemoryStatus.Err(availableError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus MarkStraightLineSimpleAssignmentsAvailable(
    borrow ReferenceTable refs,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] statementPlusOne,
    mut borrow StraightLineMovedTargetTable movedTargets)
{
    if (statementPlusOne == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] statement = (u64[0 2 ** 63 - 1])(statementPlusOne - 1);
    stack u64[0 2 ** 63 - 1] low = (u64[0 2 ** 63 - 1])body.ExprStartAt(statement);
    stack mut u64[0 2 ** 63 - 1] high = body.ExprNodeCount();
    if ((u64[0 2 ** 63 - 1])(statement + 1) < body.Count())
    {
        high = (u64[0 2 ** 63 - 1])body.ExprStartAt((u64[0 2 ** 63 - 1])(statement + 1));
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])(low + 1); nodeIndex <= high; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Assign
            && stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(node)) == TokenKind.Assign)
        {
            stack u32[0 max] targetNode = body.ExprLeftAt(node);
            stack mut u32[0 max] target = 0;
            if (targetNode != 0
                && body.ExprKindAt(targetNode) == Compiler.Parsing.ExprKind.Identifier
                && TryScopeTargetForIdentifierNode(refs, body, targetNode, target))
            {
                switch (movedTargets.MarkAvailable(target))
                {
                    case System.Memory.MemoryStatus.Err(var availableError):
                        return System.Memory.MemoryStatus.Err(availableError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus MarkStraightLineSourceMoveIfOwned(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow CopyabilityFactTable facts,
    u32[0 max] sourceNode,
    mut borrow StraightLineMovedTargetTable movedTargets)
{
    stack mut u32[0 max] sourceTarget = 0;
    if (TryScopeTargetForIdentifierNode(refs, body, sourceNode, sourceTarget)
        && !FunctionScopeSymbolTypeFormsSafeBorrow(stream, scope, sourceTarget)
        && !FunctionScopeSymbolTypeIsCopyable(decls, table, source, stream, facts, scope, sourceTarget))
    {
        switch (movedTargets.MarkMoved(sourceTarget, body.ExprTokenAt(sourceNode)))
        {
            case System.Memory.MemoryStatus.Err(var moveError):
                return System.Memory.MemoryStatus.Err(moveError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus MarkStraightLineAssignmentAndLocalMoves(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow CopyabilityFactTable facts,
    u32[0 max] statementPlusOne,
    mut borrow StraightLineMovedTargetTable movedTargets)
{
    if (statementPlusOne == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] statement = (u64[0 2 ** 63 - 1])(statementPlusOne - 1);
    stack StatementItem item = body.ItemAt(statement);
    if (item.Kind == StatementKind.Local
        && !TypeSpanFormsSafeBorrow(stream, item.TypeStartToken, item.TypeEndToken))
    {
        switch (MarkStraightLineSourceMoveIfOwned(
            decls,
            table,
            source,
            refs,
            scope,
            stream,
            body,
            facts,
            body.ExprRootAt(statement),
            movedTargets))
        {
            case System.Memory.MemoryStatus.Err(var localMoveError):
                return System.Memory.MemoryStatus.Err(localMoveError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack u64[0 2 ** 63 - 1] low = (u64[0 2 ** 63 - 1])body.ExprStartAt(statement);
    stack mut u64[0 2 ** 63 - 1] high = body.ExprNodeCount();
    if ((u64[0 2 ** 63 - 1])(statement + 1) < body.Count())
    {
        high = (u64[0 2 ** 63 - 1])body.ExprStartAt((u64[0 2 ** 63 - 1])(statement + 1));
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])(low + 1); nodeIndex <= high; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Assign
            && stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(node)) == TokenKind.Assign)
        {
            stack u32[0 max] targetNode = body.ExprLeftAt(node);
            stack mut u32[0 max] target = 0;
            if (targetNode != 0
                && body.ExprKindAt(targetNode) == Compiler.Parsing.ExprKind.Identifier
                && TryScopeTargetForIdentifierNode(refs, body, targetNode, target)
                && !FunctionScopeSymbolTypeFormsSafeBorrow(stream, scope, target))
            {
                switch (MarkStraightLineSourceMoveIfOwned(
                    decls,
                    table,
                    source,
                    refs,
                    scope,
                    stream,
                    body,
                    facts,
                    body.ExprRightAt(node),
                    movedTargets))
                {
                    case System.Memory.MemoryStatus.Err(var assignmentMoveError):
                        return System.Memory.MemoryStatus.Err(assignmentMoveError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus MarkStraightLineDirectCallMoves(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow CopyabilityFactTable facts,
    u32[0 max] statementPlusOne,
    mut borrow StraightLineMovedTargetTable movedTargets)
{
    if (statementPlusOne == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] statement = (u64[0 2 ** 63 - 1])(statementPlusOne - 1);
    stack u64[0 2 ** 63 - 1] low = (u64[0 2 ** 63 - 1])body.ExprStartAt(statement);
    stack mut u64[0 2 ** 63 - 1] high = body.ExprNodeCount();
    if ((u64[0 2 ** 63 - 1])(statement + 1) < body.Count())
    {
        high = (u64[0 2 ** 63 - 1])body.ExprStartAt((u64[0 2 ** 63 - 1])(statement + 1));
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])(low + 1); nodeIndex <= high; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] calleeNode = body.ExprLeftAt(node);
            stack mut u32[0 max] targetPlusOne = 0;
            if (TryDirectFunctionCallTarget(table, source, refs, stream, body, calleeNode, targetPlusOne))
            {
                stack mut FunctionSignature callee = new();
                if (TryParseFunctionSignatureFromTable(table, stream, targetPlusOne, callee))
                {
                    stack mut u32[0 max] argLimit = body.ExprCallArgCountAt(node);
                    stack u32[0 max] paramCount = (u32[0 max])callee.ParamCount();
                    if (argLimit > paramCount)
                    {
                        argLimit = paramCount;
                    }

                    for willexit (stack mut u32[0 max] arg = 0; arg < argLimit; arg = (u32[0 max])(arg + 1))
                    {
                        stack u32[0 max] argNode = body.ExprCallArgAt(node, arg);
                        stack mut u32[0 max] argTarget = 0;
                        if (TryScopeTargetForIdentifierNode(refs, body, argNode, argTarget)
                            && !TypeSpanFormsSafeBorrow(
                                stream,
                                callee.ParamTypeStartTokenAt((u64[0 2 ** 63 - 1])arg),
                                callee.ParamTypeEndTokenAt((u64[0 2 ** 63 - 1])arg))
                            && !FunctionScopeSymbolTypeIsCopyable(decls, table, source, stream, facts, scope, argTarget))
                        {
                            switch (movedTargets.MarkMoved(argTarget, body.ExprTokenAt(argNode)))
                            {
                                case System.Memory.MemoryStatus.Err(var moveError):
                                    return System.Memory.MemoryStatus.Err(moveError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectStraightLineMoveAfterMoveDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow CopyabilityFactTable facts,
    mut borrow BindDiagnosticList diags)
{
    stack mut StraightLineMovedTargetTable movedTargets = new();
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] statement = 0; statement < statementCount; statement += 1)
    {
        stack u32[0 max] statementPlusOne = (u32[0 max])(statement + 1);
        switch (CollectStraightLineMovedTargetReadDiagnostics(refs, stream, body, statementPlusOne, movedTargets, diags))
        {
            case System.Memory.MemoryStatus.Err(var readError):
                return System.Memory.MemoryStatus.Err(readError);
            case System.Memory.MemoryStatus.Ok:
        }

        switch (MarkStraightLineSimpleAssignmentsAvailable(refs, stream, body, statementPlusOne, movedTargets))
        {
            case System.Memory.MemoryStatus.Err(var assignmentError):
                return System.Memory.MemoryStatus.Err(assignmentError);
            case System.Memory.MemoryStatus.Ok:
        }

        switch (MarkStraightLineAssignmentAndLocalMoves(decls, table, source, refs, scope, stream, body, facts, statementPlusOne, movedTargets))
        {
            case System.Memory.MemoryStatus.Err(var assignmentMoveError):
                return System.Memory.MemoryStatus.Err(assignmentMoveError);
            case System.Memory.MemoryStatus.Ok:
        }

        switch (MarkStraightLineDirectCallMoves(decls, table, source, refs, scope, stream, body, facts, statementPlusOne, movedTargets))
        {
            case System.Memory.MemoryStatus.Err(var moveError):
                return System.Memory.MemoryStatus.Err(moveError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectStraightLineBorrowAliasConflictDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow CopyabilityFactTable facts,
    u32[0 max] aliasTargetPlusOne,
    u32[0 max] ownerTargetPlusOne,
    u32[0 max] aliasStatementPlusOne,
    mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] lastUse = LastUseStatementIndexPlusOneForScopeTarget(refs, body, aliasTargetPlusOne, aliasStatementPlusOne);
    if (lastUse <= aliasStatementPlusOne)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack bool ownerIsCopyable = FunctionScopeSymbolTypeIsCopyable(decls, table, source, stream, facts, scope, ownerTargetPlusOne);
    for willexit (stack mut u32[0 max] statement = (u32[0 max])(aliasStatementPlusOne + 1); statement < lastUse; statement = (u32[0 max])(statement + 1))
    {
        stack mut u32[0 max] conflictToken = 0;
        if (StatementOverwritesScopeTarget(refs, body, statement, ownerTargetPlusOne, conflictToken))
        {
            switch (diags.Append(BindDiagnosticCode.BorrowLiveConflict, conflictToken))
            {
                case System.Memory.MemoryStatus.Err(var overwriteError):
                    return System.Memory.MemoryStatus.Err(overwriteError);
                case System.Memory.MemoryStatus.Ok:
            }

            return System.Memory.MemoryStatus.Ok;
        }

        if (StatementMovesScopeTargetIntoAssignmentOrLocal(
            refs,
            scope,
            stream,
            body,
            statement,
            ownerTargetPlusOne,
            ownerIsCopyable,
            conflictToken))
        {
            switch (diags.Append(BindDiagnosticCode.BorrowLiveConflict, conflictToken))
            {
                case System.Memory.MemoryStatus.Err(var assignmentMoveError):
                    return System.Memory.MemoryStatus.Err(assignmentMoveError);
                case System.Memory.MemoryStatus.Ok:
            }

            return System.Memory.MemoryStatus.Ok;
        }

        if (StatementMovesScopeTargetIntoDirectCall(
            table,
            source,
            refs,
            stream,
            body,
            statement,
            ownerTargetPlusOne,
            ownerIsCopyable,
            conflictToken))
        {
            switch (diags.Append(BindDiagnosticCode.BorrowLiveConflict, conflictToken))
            {
                case System.Memory.MemoryStatus.Err(var moveError):
                    return System.Memory.MemoryStatus.Err(moveError);
                case System.Memory.MemoryStatus.Ok:
            }

            return System.Memory.MemoryStatus.Ok;
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectStraightLineBorrowLivenessDiagnostics(
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow CopyabilityFactTable facts,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] statement = 0; statement < statementCount; statement += 1)
    {
        stack StatementItem item = body.ItemAt(statement);
        stack u32[0 max] root = body.ExprRootAt(statement);
        stack u32[0 max] aliasStatementPlusOne = (u32[0 max])(statement + 1);
        if (root != 0
            && item.Kind == StatementKind.Local
            && TypeSpanFormsSafeBorrow(stream, item.TypeStartToken, item.TypeEndToken))
        {
            stack mut u32[0 max] ownerTarget = 0;
            stack u32[0 max] aliasTarget = SymbolIndexPlusOneForStatement(scope, (u32[0 max])statement);
            if (aliasTarget != 0
                && TryScopeTargetForIdentifierNode(refs, body, root, ownerTarget)
                && ownerTarget != aliasTarget)
            {
                switch (CollectStraightLineBorrowAliasConflictDiagnostics(
                    decls,
                    table,
                    source,
                    refs,
                    scope,
                    stream,
                    body,
                    facts,
                    aliasTarget,
                    ownerTarget,
                    aliasStatementPlusOne,
                    diags))
                {
                    case System.Memory.MemoryStatus.Err(var localError):
                        return System.Memory.MemoryStatus.Err(localError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
        else if (root != 0 && body.ExprKindAt(root) == Compiler.Parsing.ExprKind.Assign)
        {
            stack u32[0 max] aliasRoot = AssignmentTargetRootNode(body, body.ExprLeftAt(root));
            stack mut u32[0 max] aliasTarget = 0;
            stack mut u32[0 max] ownerTarget = 0;
            if (TryScopeTargetForIdentifierNode(refs, body, aliasRoot, aliasTarget)
                && FunctionScopeSymbolTypeFormsSafeBorrow(stream, scope, aliasTarget)
                && TryScopeTargetForIdentifierNode(refs, body, body.ExprRightAt(root), ownerTarget)
                && ownerTarget != aliasTarget)
            {
                switch (CollectStraightLineBorrowAliasConflictDiagnostics(
                    decls,
                    table,
                    source,
                    refs,
                    scope,
                    stream,
                    body,
                    facts,
                    aliasTarget,
                    ownerTarget,
                    aliasStatementPlusOne,
                    diags))
                {
                    case System.Memory.MemoryStatus.Err(var assignmentError):
                        return System.Memory.MemoryStatus.Err(assignmentError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

public enum ReceiverCandidateSiteKind
{
    Unknown,
    Value,
    Static,
}

public enum ReceiverCandidateKind
{
    Field,
    InstanceMethod,
    StaticMethod,
}

public struct ReceiverCandidateSetTable
{
    internal dynamic ReceiverCandidateSiteKind SiteKinds;
    internal dynamic u32[0 max] MemberNodes;
    internal dynamic u32[0 max] CallNodes;
    internal dynamic u32[0 max] ReceiverNodes;
    internal dynamic u32[0 max] ReceiverTypeTokens;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] ArgumentCounts;
    internal dynamic u32[0 max] CandidateStartSlots;
    internal dynamic u32[0 max] CandidateCounts;
    internal dynamic ReceiverCandidateKind CandidateKinds;
    internal dynamic u32[0 max] CandidateTokens;

    ReceiverCandidateSetTable()
    {
        self.SiteKinds = new();
        self.MemberNodes = new();
        self.CallNodes = new();
        self.ReceiverNodes = new();
        self.ReceiverTypeTokens = new();
        self.NameTokens = new();
        self.ArgumentCounts = new();
        self.CandidateStartSlots = new();
        self.CandidateCounts = new();
        self.CandidateKinds = new();
        self.CandidateTokens = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow ReceiverCandidateSetTable self)
    {
        return self.MemberNodes.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] TotalCandidateCount(borrow ReceiverCandidateSetTable self)
    {
        return self.CandidateTokens.Length;
    }

    public law ReceiverCandidateSiteKind SiteKindAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut ReceiverCandidateSiteKind kind = ReceiverCandidateSiteKind.Unknown;
        if (index < self.SiteKinds.Length)
        {
            kind = self.SiteKinds[index];
        }

        return kind;
    }

    public law u32[0 max] MemberNodeAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] node = 0;
        if (index < self.MemberNodes.Length)
        {
            node = self.MemberNodes[index];
        }

        return node;
    }

    public law u32[0 max] CallNodeAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] node = 0;
        if (index < self.CallNodes.Length)
        {
            node = self.CallNodes[index];
        }

        return node;
    }

    public law u32[0 max] ReceiverNodeAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] node = 0;
        if (index < self.ReceiverNodes.Length)
        {
            node = self.ReceiverNodes[index];
        }

        return node;
    }

    public law u32[0 max] ReceiverTypeTokenAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ReceiverTypeTokens.Length)
        {
            token = self.ReceiverTypeTokens[index];
        }

        return token;
    }

    public law u32[0 max] NameTokenAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law u32[0 max] ArgumentCountAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ArgumentCounts.Length)
        {
            count = self.ArgumentCounts[index];
        }

        return count;
    }

    public law u32[0 max] CandidateCountAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.CandidateCounts.Length)
        {
            count = self.CandidateCounts[index];
        }

        return count;
    }

    public law ReceiverCandidateKind CandidateKindAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] site, u32[0 max] candidate)
    {
        stack mut ReceiverCandidateKind kind = ReceiverCandidateKind.Field;
        if (site < self.CandidateStartSlots.Length && candidate < self.CandidateCountAt(site))
        {
            stack u32[0 max] start = self.CandidateStartSlots[site];
            if (start >= 1)
            {
                stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])((start - 1) + candidate);
                if (slot < self.CandidateKinds.Length)
                {
                    kind = self.CandidateKinds[slot];
                }
            }
        }

        return kind;
    }

    public law u32[0 max] CandidateTokenAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] site, u32[0 max] candidate)
    {
        stack mut u32[0 max] token = 0;
        if (site < self.CandidateStartSlots.Length && candidate < self.CandidateCountAt(site))
        {
            stack u32[0 max] start = self.CandidateStartSlots[site];
            if (start >= 1)
            {
                stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])((start - 1) + candidate);
                if (slot < self.CandidateTokens.Length)
                {
                    token = self.CandidateTokens[slot];
                }
            }
        }

        return token;
    }

    public law u32[0 max] FieldCandidateCountAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] site)
    {
        stack mut u32[0 max] count = 0;
        stack u32[0 max] candidates = self.CandidateCountAt(site);
        for willexit (stack mut u32[0 max] candidate = 0; candidate < candidates; candidate += 1)
        {
            if (self.CandidateKindAt(site, candidate) == ReceiverCandidateKind.Field)
            {
                count = (u32[0 max])(count + 1);
            }
        }

        return count;
    }

    public law u32[0 max] InstanceMethodCandidateCountAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] site)
    {
        stack mut u32[0 max] count = 0;
        stack u32[0 max] candidates = self.CandidateCountAt(site);
        for willexit (stack mut u32[0 max] candidate = 0; candidate < candidates; candidate += 1)
        {
            if (self.CandidateKindAt(site, candidate) == ReceiverCandidateKind.InstanceMethod)
            {
                count = (u32[0 max])(count + 1);
            }
        }

        return count;
    }

    public law u32[0 max] StaticMethodCandidateCountAt(borrow ReceiverCandidateSetTable self, u64[0 2 ** 63 - 1] site)
    {
        stack mut u32[0 max] count = 0;
        stack u32[0 max] candidates = self.CandidateCountAt(site);
        for willexit (stack mut u32[0 max] candidate = 0; candidate < candidates; candidate += 1)
        {
            if (self.CandidateKindAt(site, candidate) == ReceiverCandidateKind.StaticMethod)
            {
                count = (u32[0 max])(count + 1);
            }
        }

        return count;
    }

    internal fn System.Memory.MemoryStatus AppendSet(
        mut borrow ReceiverCandidateSetTable self,
        ReceiverCandidateSiteKind siteKind,
        u32[0 max] memberNode,
        u32[0 max] callNode,
        u32[0 max] receiverNode,
        u32[0 max] receiverTypeToken,
        u32[0 max] nameToken,
        u32[0 max] argumentCount,
        out u32[0 max] siteIndex)
    {
        siteIndex = 0;
        if (!self.SiteKinds.TryReserve(1)
            || !self.MemberNodes.TryReserve(1)
            || !self.CallNodes.TryReserve(1)
            || !self.ReceiverNodes.TryReserve(1)
            || !self.ReceiverTypeTokens.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.ArgumentCounts.TryReserve(1)
            || !self.CandidateStartSlots.TryReserve(1)
            || !self.CandidateCounts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        siteIndex = (u32[0 max])(self.MemberNodes.Length + 1);
        init self.SiteKinds[self.SiteKinds.Length] = siteKind;
        init self.MemberNodes[self.MemberNodes.Length] = memberNode;
        init self.CallNodes[self.CallNodes.Length] = callNode;
        init self.ReceiverNodes[self.ReceiverNodes.Length] = receiverNode;
        init self.ReceiverTypeTokens[self.ReceiverTypeTokens.Length] = receiverTypeToken;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.ArgumentCounts[self.ArgumentCounts.Length] = argumentCount;
        init self.CandidateStartSlots[self.CandidateStartSlots.Length] = (u32[0 max])(self.CandidateTokens.Length + 1);
        init self.CandidateCounts[self.CandidateCounts.Length] = 0;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus AppendCandidate(mut borrow ReceiverCandidateSetTable self, u32[0 max] siteIndex, ReceiverCandidateKind kind, u32[0 max] candidateToken)
    {
        if (siteIndex == 0 || candidateToken == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (!self.CandidateKinds.TryReserve(1)
            || !self.CandidateTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.CandidateKinds[self.CandidateKinds.Length] = kind;
        init self.CandidateTokens[self.CandidateTokens.Length] = candidateToken;

        stack u64[0 2 ** 63 - 1] siteSlot = (u64[0 2 ** 63 - 1])(siteIndex - 1);
        if (siteSlot < self.CandidateCounts.Length)
        {
            self.CandidateCounts[siteSlot] = (u32[0 max])(self.CandidateCounts[siteSlot] + 1);
        }

        return System.Memory.MemoryStatus.Ok;
    }
}

internal fn u32[0 max] FindDataDeclarationName(borrow DeclarationTable table, ascii source, borrow TokenStream stream, u32[0 max] typeToken)
{
    if (typeToken == 0)
    {
        return 0;
    }

    stack ascii typeName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])typeToken);
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (table.KindAt(index) == DeclarationKind.Struct || table.KindAt(index) == DeclarationKind.Record)
        {
            stack ascii declName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])table.NameTokenAt(index));
            if (System.Text.Equals(typeName, declName))
            {
                found = table.NameTokenAt(index);
            }
        }
    }

    return found;
}

internal fn u32[0 max] StaticReceiverDeclarationNameToken(borrow DeclarationTable table, ascii source, borrow TokenStream stream, borrow ReferenceTable refs, borrow StatementList body, u32[0 max] receiverNode)
{
    if (receiverNode == 0 || body.ExprKindAt(receiverNode) != Compiler.Parsing.ExprKind.Identifier)
    {
        return 0;
    }

    stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, receiverNode);
    if (refIndexPlusOne == 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
    if (refs.KindAt(refIndex) != ReferenceKind.Declaration)
    {
        return 0;
    }

    stack u32[0 max] targetPlusOne = refs.TargetAt(refIndex);
    if (targetPlusOne == 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] target = (u64[0 2 ** 63 - 1])(targetPlusOne - 1);
    if (table.KindAt(target) == DeclarationKind.Struct || table.KindAt(target) == DeclarationKind.Record)
    {
        return table.NameTokenAt(target);
    }

    return 0;
}

internal finite law u32[0 max] ReceiverBodyOpenToken(borrow TokenStream stream, u32[0 max] ownerNameToken)
{
    stack mut u32[0 max] scan = ownerNameToken;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.LBrace)
        {
            return scan;
        }

        if (kind == TokenKind.Semi || kind == TokenKind.EndOfFile)
        {
            return 0;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal finite law u32[0 max] ReceiverMemberEndToken(borrow TokenStream stream, u32[0 max] memberStart)
{
    stack mut u32[0 max] scan = memberStart;
    stack mut u32[0 max] parenDepth = 0;
    stack mut u32[0 max] bracketDepth = 0;
    stack mut u32[0 max] angleDepth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return scan;
        }

        if (kind == TokenKind.Semi && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.RBrace && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            if (scan > memberStart)
            {
                return (u32[0 max])(scan - 1);
            }

            return scan;
        }

        if (kind == TokenKind.LBrace && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            stack mut u32[0 max] bodyDepth = 1;
            scan = (u32[0 max])(scan + 1);
            while willexit (guard > 0)
            {
                guard = (u64[0 2 ** 63 - 1])(guard - 1);
                stack TokenKind bodyKind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
                if (bodyKind == TokenKind.EndOfFile)
                {
                    return scan;
                }

                if (bodyKind == TokenKind.LBrace)
                {
                    bodyDepth = (u32[0 max])(bodyDepth + 1);
                }
                else if (bodyKind == TokenKind.RBrace)
                {
                    if (bodyDepth > 0)
                    {
                        bodyDepth = (u32[0 max])(bodyDepth - 1);
                    }

                    if (bodyDepth == 0)
                    {
                        return scan;
                    }
                }

                scan = (u32[0 max])(scan + 1);
            }

            return scan;
        }

        if (kind == TokenKind.LParen)
        {
            parenDepth = (u32[0 max])(parenDepth + 1);
        }
        else if (kind == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = (u32[0 max])(parenDepth - 1);
            }
        }
        else if (kind == TokenKind.LBrack)
        {
            bracketDepth = (u32[0 max])(bracketDepth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = (u32[0 max])(bracketDepth - 1);
            }
        }
        else if (kind == TokenKind.Lt)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return scan;
}

internal finite law u32[0 max] ReceiverMemberFunctionToken(borrow TokenStream stream, u32[0 max] memberStart, u32[0 max] memberEnd)
{
    stack mut u32[0 max] scan = memberStart;
    stack mut u32[0 max] parenDepth = 0;
    stack mut u32[0 max] bracketDepth = 0;
    stack mut u32[0 max] angleDepth = 0;
    while willexit (scan <= memberEnd)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Fn && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.LBrace && parenDepth == 0 && bracketDepth == 0 && angleDepth == 0)
        {
            return 0;
        }

        if (kind == TokenKind.LParen)
        {
            parenDepth = (u32[0 max])(parenDepth + 1);
        }
        else if (kind == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = (u32[0 max])(parenDepth - 1);
            }
        }
        else if (kind == TokenKind.LBrack)
        {
            bracketDepth = (u32[0 max])(bracketDepth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = (u32[0 max])(bracketDepth - 1);
            }
        }
        else if (kind == TokenKind.Lt)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal finite law bool ReceiverMemberHasStaticBefore(borrow TokenStream stream, u32[0 max] memberStart, u32[0 max] fnKeyword)
{
    stack mut u32[0 max] scan = memberStart;
    stack mut u32[0 max] bracketDepth = 0;
    while willexit (scan < fnKeyword)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Static && bracketDepth == 0)
        {
            return true;
        }

        if (kind == TokenKind.LBrack)
        {
            bracketDepth = (u32[0 max])(bracketDepth + 1);
        }
        else if (kind == TokenKind.RBrack)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = (u32[0 max])(bracketDepth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn System.Memory.MemoryStatus AppendReceiverFieldCandidates(
    mut borrow ReceiverCandidateSetTable sets,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerNameToken,
    u32[0 max] siteIndex,
    u32[0 max] memberNameToken)
{
    switch (ParseStructFields(stream, ownerNameToken))
    {
        case ParseResult<FieldList>.Err(var fieldError):
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<FieldList>.Ok(var fields):
            stack u64[0 2 ** 63 - 1] count = fields.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
            {
                if (TokenTextEqualsToken(source, stream, fields.NameTokenAt(index), memberNameToken))
                {
                    switch (sets.AppendCandidate(siteIndex, ReceiverCandidateKind.Field, fields.NameTokenAt(index)))
                    {
                        case System.Memory.MemoryStatus.Err(var appendError):
                            return System.Memory.MemoryStatus.Err(appendError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendReceiverMethodCandidates(
    mut borrow ReceiverCandidateSetTable sets,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerNameToken,
    u32[0 max] siteIndex,
    u32[0 max] memberNameToken,
    bool wantStatic)
{
    stack u32[0 max] bodyOpen = ReceiverBodyOpenToken(stream, ownerNameToken);
    if (bodyOpen == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] memberStart = (u32[0 max])(bodyOpen + 1);
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind startKind = stream.KindAt((u64[0 2 ** 63 - 1])memberStart);
        if (startKind == TokenKind.EndOfFile || startKind == TokenKind.RBrace)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u32[0 max] memberEnd = ReceiverMemberEndToken(stream, memberStart);
        if (memberEnd < memberStart)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u32[0 max] fnKeyword = ReceiverMemberFunctionToken(stream, memberStart, memberEnd);
        if (fnKeyword != 0)
        {
            stack bool isStatic = ReceiverMemberHasStaticBefore(stream, memberStart, fnKeyword);
            if (isStatic == wantStatic)
            {
                switch (ParseFunctionSignature(stream, fnKeyword))
                {
                    case ParseResult<FunctionSignature>.Err(var sigError):
                    {
                    }
                    case ParseResult<FunctionSignature>.Ok(var signature):
                        if (TokenTextEqualsToken(source, stream, signature.Name(), memberNameToken))
                        {
                            stack mut ReceiverCandidateKind candidateKind = ReceiverCandidateKind.InstanceMethod;
                            if (isStatic)
                            {
                                candidateKind = ReceiverCandidateKind.StaticMethod;
                            }

                            switch (sets.AppendCandidate(siteIndex, candidateKind, signature.Name()))
                            {
                                case System.Memory.MemoryStatus.Err(var appendError):
                                    return System.Memory.MemoryStatus.Err(appendError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                }
            }
        }

        memberStart = (u32[0 max])(memberEnd + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn u32[0 max] CallNodeWithCallee(borrow StatementList body, u32[0 max] calleeNode)
{
    stack u64[0 2 ** 63 - 1] count = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= count; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Call && body.ExprLeftAt(node) == calleeNode)
        {
            return node;
        }
    }

    return 0;
}

public fn BindResult<ReceiverCandidateSetTable> BuildReceiverCandidateSets(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow StatementList body)
{
    stack mut ReceiverCandidateSetTable sets = new();
    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] memberNode = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(memberNode) == Compiler.Parsing.ExprKind.Member)
        {
            stack u32[0 max] receiverNode = body.ExprLeftAt(memberNode);
            stack u32[0 max] memberNameToken = body.ExprTokenAt(memberNode);
            stack u32[0 max] callNode = CallNodeWithCallee(body, memberNode);
            stack mut u32[0 max] argumentCount = 0;
            if (callNode != 0)
            {
                argumentCount = body.ExprCallArgCountAt(callNode);
            }

            stack mut ReceiverCandidateSiteKind siteKind = ReceiverCandidateSiteKind.Unknown;
            stack mut u32[0 max] receiverTypeToken = MemberStructNameToken(table, source, refs, scope, stream, body, receiverNode);
            stack mut u32[0 max] ownerNameToken = FindDataDeclarationName(table, source, stream, receiverTypeToken);
            if (ownerNameToken != 0)
            {
                siteKind = ReceiverCandidateSiteKind.Value;
            }
            else
            {
                receiverTypeToken = StaticReceiverDeclarationNameToken(table, source, stream, refs, body, receiverNode);
                ownerNameToken = receiverTypeToken;
                if (ownerNameToken != 0)
                {
                    siteKind = ReceiverCandidateSiteKind.Static;
                }
            }

            stack mut u32[0 max] siteIndex = 0;
            switch (sets.AppendSet(siteKind, memberNode, callNode, receiverNode, receiverTypeToken, memberNameToken, argumentCount, siteIndex))
            {
                case System.Memory.MemoryStatus.Err(var setError):
                    return BindResult<ReceiverCandidateSetTable>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            if (siteKind == ReceiverCandidateSiteKind.Value)
            {
                switch (AppendReceiverFieldCandidates(sets, source, stream, ownerNameToken, siteIndex, memberNameToken))
                {
                    case System.Memory.MemoryStatus.Err(var fieldError):
                        return BindResult<ReceiverCandidateSetTable>.Err(BindError.OutOfMemory);
                    case System.Memory.MemoryStatus.Ok:
                }

                switch (AppendReceiverMethodCandidates(sets, source, stream, ownerNameToken, siteIndex, memberNameToken, false))
                {
                    case System.Memory.MemoryStatus.Err(var methodError):
                        return BindResult<ReceiverCandidateSetTable>.Err(BindError.OutOfMemory);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (siteKind == ReceiverCandidateSiteKind.Static)
            {
                switch (AppendReceiverMethodCandidates(sets, source, stream, ownerNameToken, siteIndex, memberNameToken, true))
                {
                    case System.Memory.MemoryStatus.Err(var staticError):
                        return BindResult<ReceiverCandidateSetTable>.Err(BindError.OutOfMemory);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return BindResult<ReceiverCandidateSetTable>.Ok(sets);
}

internal fn bool U32ListContains(borrow dynamic u32[0 max] values, u32[0 max] value)
{
    stack mut bool found = false;
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < values.Length; index += 1)
    {
        if (!found && values[index] == value)
        {
            found = true;
        }
    }

    return found;
}

internal fn System.Memory.MemoryStatus AppendU32(mut borrow dynamic u32[0 max] values, u32[0 max] value)
{
    if (!values.TryReserve(1))
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
    }

    init values[values.Length] = value;
    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendNodeIfPresent(mut borrow dynamic u32[0 max] nodes, u32[0 max] node)
{
    if (node == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    return AppendU32(nodes, node);
}

internal fn bool FunctionDeclarationIsFinite(borrow DeclarationTable table, borrow TokenStream stream, u32[0 max] declarationPlusOne)
{
    if (declarationPlusOne == 0 || (u64[0 2 ** 63 - 1])declarationPlusOne > table.Count())
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(declarationPlusOne - 1);
    if (table.KindAt(index) != DeclarationKind.Function)
    {
        return false;
    }

    stack mut FunctionSignature signature = new();
    return TryParseFunctionSignatureFromTable(table, stream, declarationPlusOne, signature)
        && signature.FiniteKind();
}

internal fn bool FunctionDeclarationHasOrdinaryBody(borrow DeclarationTable table, borrow TokenStream stream, u32[0 max] declarationPlusOne)
{
    if (declarationPlusOne == 0 || (u64[0 2 ** 63 - 1])declarationPlusOne > table.Count())
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(declarationPlusOne - 1);
    if (table.KindAt(index) != DeclarationKind.Function)
    {
        return false;
    }

    switch (ParseFunctionBody(stream, table.KeywordTokenAt(index)))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return false;
        case ParseResult<StatementList>.Ok(var body):
            return true;
    }
}

internal fn System.Memory.MemoryStatus AppendRuntimeCallEdgeForNamedCall(
    u32[0 max] callerPlusOne,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    borrow ReferenceTable refs,
    borrow StatementList body,
    u32[0 max] callNode,
    mut borrow RuntimeCallEdgeTable edges)
{
    if (callNode == 0 || body.ExprKindAt(callNode) != Compiler.Parsing.ExprKind.Call)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] calleeNode = body.ExprLeftAt(callNode);
    if (calleeNode == 0 || body.ExprKindAt(calleeNode) != Compiler.Parsing.ExprKind.Identifier)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
    if (refIndexPlusOne != 0)
    {
        stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
        if (refs.KindAt(refIndex) != ReferenceKind.Declaration)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack u32[0 max] targetPlusOne = refs.TargetAt(refIndex);
        if (targetPlusOne == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack mut FunctionSignature callee = new();
        if (TryParseFunctionSignatureFromTable(table, stream, targetPlusOne, callee))
        {
            return edges.Append(callerPlusOne, targetPlusOne, refs.NameTokenAt(refIndex));
        }

        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] nameToken = body.ExprTokenAt(calleeNode);
    stack u64[0 2 ** 63 - 1] tableCount = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] tableIndex = 0; tableIndex < tableCount; tableIndex += 1)
    {
        if (TokenTextEqualsToken(source, stream, table.NameTokenAt(tableIndex), nameToken))
        {
            stack u32[0 max] targetPlusOne = (u32[0 max])(tableIndex + 1);
            stack mut FunctionSignature callee = new();
            if (TryParseFunctionSignatureFromTable(table, stream, targetPlusOne, callee))
            {
                return edges.Append(callerPlusOne, targetPlusOne, nameToken);
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn u32[0 max] FindSourceDeclarationByNameToken(borrow DeclarationTable table, ascii source, borrow TokenStream stream, u32[0 max] nameToken)
{
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (TokenTextEqualsToken(source, stream, table.NameTokenAt(index), nameToken))
        {
            return (u32[0 max])(index + 1);
        }
    }

    return 0;
}

internal struct RuntimeCallEdgeTable
{
    internal dynamic u32[0 max] Callers;
    internal dynamic u32[0 max] Callees;
    internal dynamic u32[0 max] Tokens;

    RuntimeCallEdgeTable()
    {
        self.Callers = new();
        self.Callees = new();
        self.Tokens = new();
    }

    inline finite law u64[0 2 ** 63 - 1] Count(borrow RuntimeCallEdgeTable self)
    {
        return self.Callers.Length;
    }

    law u32[0 max] CallerAt(borrow RuntimeCallEdgeTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] caller = 0;
        if (index < self.Callers.Length)
        {
            caller = self.Callers[index];
        }

        return caller;
    }

    law u32[0 max] CalleeAt(borrow RuntimeCallEdgeTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] callee = 0;
        if (index < self.Callees.Length)
        {
            callee = self.Callees[index];
        }

        return callee;
    }

    law u32[0 max] TokenAt(borrow RuntimeCallEdgeTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.Tokens.Length)
        {
            token = self.Tokens[index];
        }

        return token;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow RuntimeCallEdgeTable self, u32[0 max] caller, u32[0 max] callee, u32[0 max] token)
    {
        if (!self.Callers.TryReserve(1)
            || !self.Callees.TryReserve(1)
            || !self.Tokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Callers[self.Callers.Length] = caller;
        init self.Callees[self.Callees.Length] = callee;
        init self.Tokens[self.Tokens.Length] = token;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal fn System.Memory.MemoryStatus CollectRuntimeCallEdgesForFunction(
    u32[0 max] callerPlusOne,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow RuntimeCallEdgeTable edges)
{
    stack mut FunctionSignature signature = new();
    if (!TryParseFunctionSignatureFromTable(table, stream, callerPlusOne, signature))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    switch (ParseFunctionBody(stream, table.KeywordTokenAt((u64[0 2 ** 63 - 1])(callerPlusOne - 1))))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<StatementList>.Ok(var body):
            switch (BuildFunctionScope(signature, body))
            {
                case BindResult<FunctionScope>.Err(var scopeError):
                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                case BindResult<FunctionScope>.Ok(var scope):
                    stack mut ReferenceTable refs = new();
                    switch (ResolveReferences(scope, table, source, stream, body))
                    {
                        case BindResult<ReferenceTable>.Err(var refError):
                            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                        case BindResult<ReferenceTable>.Ok(var built):
                            refs = built;
                    }

                    stack mut dynamic u32[0 max] skipCallNodes = new();
                    stack u64[0 2 ** 63 - 1] count = body.Count();
                    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
                    {
                        if (body.ItemAt(index).Kind == StatementKind.Become)
                        {
                            switch (AppendNodeIfPresent(skipCallNodes, body.ExprRootAt(index)))
                            {
                                case System.Memory.MemoryStatus.Err(var skipError):
                                    return System.Memory.MemoryStatus.Err(skipError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }

                    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
                    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
                    {
                        stack u32[0 max] node = (u32[0 max])nodeIndex;
                        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Call && !U32ListContains(skipCallNodes, node))
                        {
                            switch (AppendRuntimeCallEdgeForNamedCall(callerPlusOne, table, source, stream, refs, body, node, edges))
                            {
                                case System.Memory.MemoryStatus.Err(var edgeError):
                                    return System.Memory.MemoryStatus.Err(edgeError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }
            }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus RuntimeCallPathExists(borrow RuntimeCallEdgeTable edges, u32[0 max] start, u32[0 max] target, out bool exists)
{
    exists = start == target;
    if (exists)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut dynamic u32[0 max] reachable = new();
    switch (AppendU32(reachable, start))
    {
        case System.Memory.MemoryStatus.Err(var startError):
            return System.Memory.MemoryStatus.Err(startError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] edgeCount = edges.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] round = 0; round < edgeCount; round += 1)
    {
        if (exists)
        {
            break;
        }

        stack u64[0 2 ** 63 - 1] reachableCount = reachable.Length;
        stack mut bool changed = false;
        for willexit (stack mut u64[0 2 ** 63 - 1] reachableIndex = 0; reachableIndex < reachableCount; reachableIndex += 1)
        {
            if (reachableIndex >= reachable.Length)
            {
                continue;
            }

            stack u32[0 max] current = reachable[reachableIndex];
            for willexit (stack mut u64[0 2 ** 63 - 1] edge = 0; edge < edgeCount; edge += 1)
            {
                if (edges.CallerAt(edge) == current)
                {
                    stack u32[0 max] next = edges.CalleeAt(edge);
                    if (next == target)
                    {
                        exists = true;
                    }
                    else if (!U32ListContains(reachable, next))
                    {
                        switch (AppendU32(reachable, next))
                        {
                            case System.Memory.MemoryStatus.Err(var nextError):
                                return System.Memory.MemoryStatus.Err(nextError);
                            case System.Memory.MemoryStatus.Ok:
                                changed = true;
                        }
                    }
                }
            }
        }

        if (!changed)
        {
            break;
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool RuntimeCallerHasOnlyKnownOrdinaryDirectEdges(
    borrow DeclarationTable table,
    borrow TokenStream stream,
    borrow RuntimeCallEdgeTable edges,
    u32[0 max] callerPlusOne,
    u32[0 max] callExpressionCount)
{
    stack mut u32[0 max] directEdgeCount = 0;
    stack u64[0 2 ** 63 - 1] edgeCount = edges.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] edge = 0; edge < edgeCount; edge += 1)
    {
        if (edges.CallerAt(edge) == callerPlusOne)
        {
            directEdgeCount = (u32[0 max])(directEdgeCount + 1);
            if (!FunctionDeclarationHasOrdinaryBody(table, stream, edges.CalleeAt(edge)))
            {
                return false;
            }
        }
    }

    return directEdgeCount == callExpressionCount;
}

internal fn System.Memory.MemoryStatus RuntimeDeclarationHasOrdinaryRecursiveCycle(
    borrow RuntimeCallEdgeTable edges,
    u32[0 max] callerPlusOne,
    out bool recursive)
{
    recursive = false;
    stack u64[0 2 ** 63 - 1] edgeCount = edges.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] edge = 0; edge < edgeCount; edge += 1)
    {
        if (!recursive && edges.CallerAt(edge) == callerPlusOne)
        {
            stack u32[0 max] calleePlusOne = edges.CalleeAt(edge);
            if (calleePlusOne == callerPlusOne)
            {
                recursive = true;
            }
            else
            {
                switch (RuntimeCallPathExists(edges, calleePlusOne, callerPlusOne, recursive))
                {
                    case System.Memory.MemoryStatus.Err(var pathError):
                        return System.Memory.MemoryStatus.Err(pathError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus RuntimeFiniteCallPathExists(
    borrow DeclarationTable table,
    borrow TokenStream stream,
    borrow RuntimeCallEdgeTable edges,
    u32[0 max] start,
    u32[0 max] target,
    out bool exists)
{
    exists = start == target;
    if (exists)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut dynamic u32[0 max] reachable = new();
    switch (AppendU32(reachable, start))
    {
        case System.Memory.MemoryStatus.Err(var startError):
            return System.Memory.MemoryStatus.Err(startError);
        case System.Memory.MemoryStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] edgeCount = edges.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] round = 0; round < edgeCount; round += 1)
    {
        if (exists)
        {
            break;
        }

        stack u64[0 2 ** 63 - 1] reachableCount = reachable.Length;
        stack mut bool changed = false;
        for willexit (stack mut u64[0 2 ** 63 - 1] reachableIndex = 0; reachableIndex < reachableCount; reachableIndex += 1)
        {
            if (reachableIndex >= reachable.Length)
            {
                continue;
            }

            stack u32[0 max] current = reachable[reachableIndex];
            for willexit (stack mut u64[0 2 ** 63 - 1] edge = 0; edge < edgeCount; edge += 1)
            {
                if (edges.CallerAt(edge) == current)
                {
                    stack u32[0 max] next = edges.CalleeAt(edge);
                    if (FunctionDeclarationIsFinite(table, stream, next))
                    {
                        if (next == target)
                        {
                            exists = true;
                        }
                        else if (!U32ListContains(reachable, next))
                        {
                            switch (AppendU32(reachable, next))
                            {
                                case System.Memory.MemoryStatus.Err(var nextError):
                                    return System.Memory.MemoryStatus.Err(nextError);
                                case System.Memory.MemoryStatus.Ok:
                                    changed = true;
                            }
                        }
                    }
                }
            }
        }

        if (!changed)
        {
            break;
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectRuntimeCallEdges(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow RuntimeCallEdgeTable edges)
{
    stack u64[0 2 ** 63 - 1] functionCount = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < functionCount; index += 1)
    {
        if (table.KindAt(index) == DeclarationKind.Function)
        {
            switch (CollectRuntimeCallEdgesForFunction((u32[0 max])(index + 1), table, source, stream, edges))
            {
                case System.Memory.MemoryStatus.Err(var edgeError):
                    return System.Memory.MemoryStatus.Err(edgeError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectFiniteRecursionDiagnostics(
    borrow DeclarationTable table,
    borrow TokenStream stream,
    borrow RuntimeCallEdgeTable edges,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] functionCount = table.Count();
    stack u64[0 2 ** 63 - 1] edgeCount = edges.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] functionIndex = 0; functionIndex < functionCount; functionIndex += 1)
    {
        stack u32[0 max] callerPlusOne = (u32[0 max])(functionIndex + 1);
        if (FunctionDeclarationIsFinite(table, stream, callerPlusOne))
        {
            stack mut bool isRecursive = false;
            for willexit (stack mut u64[0 2 ** 63 - 1] edge = 0; edge < edgeCount; edge += 1)
            {
                if (!isRecursive && edges.CallerAt(edge) == callerPlusOne)
                {
                    stack u32[0 max] calleePlusOne = edges.CalleeAt(edge);
                    if (FunctionDeclarationIsFinite(table, stream, calleePlusOne))
                    {
                        if (calleePlusOne == callerPlusOne)
                        {
                            isRecursive = true;
                        }
                        else
                        {
                            switch (RuntimeFiniteCallPathExists(table, stream, edges, calleePlusOne, callerPlusOne, isRecursive))
                            {
                                case System.Memory.MemoryStatus.Err(var pathError):
                                    return System.Memory.MemoryStatus.Err(pathError);
                                case System.Memory.MemoryStatus.Ok:
                            }
                        }
                    }
                }
            }

            if (isRecursive)
            {
                switch (diags.Append(BindDiagnosticCode.FiniteRecursiveCycle, table.NameTokenAt(functionIndex)))
                {
                    case System.Memory.MemoryStatus.Err(var finiteError):
                        return System.Memory.MemoryStatus.Err(finiteError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectRuntimeRecursionWarningsFromEdges(
    borrow DeclarationTable table,
    borrow TokenStream stream,
    borrow RuntimeCallEdgeTable edges,
    mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] edgeCount = edges.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] edge = 0; edge < edgeCount; edge += 1)
    {
        stack u32[0 max] callerPlusOne = edges.CallerAt(edge);
        stack mut FunctionSignature caller = new();
        if (TryParseFunctionSignatureFromTable(table, stream, callerPlusOne, caller) && !caller.FiniteKind())
        {
            stack u32[0 max] calleePlusOne = edges.CalleeAt(edge);
            stack mut bool isRecursive = calleePlusOne == callerPlusOne;
            for willexit (stack mut u64[0 2 ** 63 - 1] other = 0; other < edgeCount; other += 1)
            {
                if (!isRecursive && edges.CallerAt(other) == calleePlusOne && edges.CalleeAt(other) == callerPlusOne)
                {
                    isRecursive = true;
                }
            }

            if (!isRecursive)
            {
                switch (RuntimeCallPathExists(edges, calleePlusOne, callerPlusOne, isRecursive))
                {
                    case System.Memory.MemoryStatus.Err(var pathError):
                        return System.Memory.MemoryStatus.Err(pathError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            if (isRecursive)
            {
                switch (diags.AppendWarning(BindDiagnosticCode.RuntimeRecursionWithoutTailBecome, edges.TokenAt(edge)))
                {
                    case System.Memory.MemoryStatus.Err(var warningError):
                        return System.Memory.MemoryStatus.Err(warningError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectRuntimeRecursionWarnings(borrow DeclarationTable table, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack mut RuntimeCallEdgeTable edges = new();
    switch (CollectRuntimeCallEdges(table, source, stream, edges))
    {
        case System.Memory.MemoryStatus.Err(var edgeError):
            return System.Memory.MemoryStatus.Err(edgeError);
        case System.Memory.MemoryStatus.Ok:
    }

    return CollectRuntimeRecursionWarningsFromEdges(table, stream, edges, diags);
}

internal fn System.Memory.MemoryStatus CollectRecursionDiagnostics(borrow DeclarationTable table, ascii source, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack mut RuntimeCallEdgeTable edges = new();
    switch (CollectRuntimeCallEdges(table, source, stream, edges))
    {
        case System.Memory.MemoryStatus.Err(var edgeError):
            return System.Memory.MemoryStatus.Err(edgeError);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectFiniteRecursionDiagnostics(table, stream, edges, diags))
    {
        case System.Memory.MemoryStatus.Err(var finiteError):
            return System.Memory.MemoryStatus.Err(finiteError);
        case System.Memory.MemoryStatus.Ok:
    }

    return CollectRuntimeRecursionWarningsFromEdges(table, stream, edges, diags);
}

// Exact source-level type-span compatibility for the current self-hosted ABI
// model. Every token kind and spelling in the type span must match, so generic
// arguments, integer ranges, callable memory contracts, and pointer element
// types remain part of tail-call ABI congruence.
internal fn bool TypeSpansCompatible(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] leftStart,
    u32[0 max] leftEnd,
    u32[0 max] rightStart,
    u32[0 max] rightEnd)
{
    if (leftStart >= leftEnd || rightStart >= rightEnd)
    {
        return leftStart >= leftEnd && rightStart >= rightEnd;
    }

    stack u32[0 max] leftLength = (u32[0 max])(leftEnd - leftStart);
    stack u32[0 max] rightLength = (u32[0 max])(rightEnd - rightStart);
    if (leftLength != rightLength)
    {
        return false;
    }

    stack mut u32[0 max] offset = 0;
    while willexit (offset < leftLength)
    {
        stack u32[0 max] left = (u32[0 max])(leftStart + offset);
        stack u32[0 max] right = (u32[0 max])(rightStart + offset);
        if (stream.KindAt((u64[0 2 ** 63 - 1])left) != stream.KindAt((u64[0 2 ** 63 - 1])right))
        {
            return false;
        }

        stack ascii leftText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])left);
        stack ascii rightText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])right);
        if (!System.Text.Equals(leftText, rightText))
        {
            return false;
        }

        offset = (u32[0 max])(offset + 1);
    }

    return true;
}

// The subset of LLVM `musttail` ABI congruence the self-hosted front end can
// currently represent: same result type span, same parameter count, same
// parameter type spans, and a call-site argument count matching the callee.
internal fn bool BecomeAbiCompatible(borrow FunctionSignature caller, borrow FunctionSignature callee, ascii source, borrow TokenStream stream, u32[0 max] callArgCount)
{
    if (!TypeSpansCompatible(
        source,
        stream,
        caller.ReturnTypeStartTokenAt(),
        caller.ReturnTypeEndTokenAt(),
        callee.ReturnTypeStartTokenAt(),
        callee.ReturnTypeEndTokenAt()))
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] paramCount = caller.ParamCount();
    if (paramCount != callee.ParamCount())
    {
        return false;
    }

    if ((u64[0 2 ** 63 - 1])callArgCount != callee.ParamCount())
    {
        return false;
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < paramCount; index += 1)
    {
        if (!TypeSpansCompatible(
            source,
            stream,
            caller.ParamTypeStartTokenAt(index),
            caller.ParamTypeEndTokenAt(index),
            callee.ParamTypeStartTokenAt(index),
            callee.ParamTypeEndTokenAt(index)))
        {
            return false;
        }
    }

    return true;
}

// A `become` edge is still an ordinary call for effect purposes: a law function
// may only tail-transfer to law code, and a finite function may only transfer to
// code with a finite guarantee. Plain `tail fn` has no additional effect limit.
internal fn bool BecomeEffectsCompatible(borrow FunctionSignature caller, borrow FunctionSignature callee)
{
    if (caller.LawKind() && !callee.LawKind())
    {
        return false;
    }

    if (caller.FiniteKind() && !callee.FiniteKind())
    {
        return false;
    }

    return true;
}

internal fn System.Memory.MemoryStatus CollectLawSignatureDiagnostics(
    borrow FunctionSignature signature,
    borrow TokenStream stream,
    mut borrow BindDiagnosticList diags)
{
    if (!signature.LawKind())
    {
        return System.Memory.MemoryStatus.Ok;
    }

    if (TypeSpanIsOutputOnlyParameter(stream, signature.ReturnTypeStartTokenAt(), signature.ReturnTypeEndTokenAt()))
    {
        switch (diags.Append(BindDiagnosticCode.LawReturnOutputType, TokenOrFallback(signature.ReturnTypeStartTokenAt(), signature.Name())))
        {
            case System.Memory.MemoryStatus.Err(var returnError):
                return System.Memory.MemoryStatus.Err(returnError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < paramCount; index += 1)
    {
        if (TypeSpanIsOutputOnlyParameter(stream, signature.ParamTypeStartTokenAt(index), signature.ParamTypeEndTokenAt(index)))
        {
            switch (diags.Append(BindDiagnosticCode.LawParameterOutputType, TokenOrFallback(signature.ParamTypeStartTokenAt(index), signature.ParamNameAt(index))))
            {
                case System.Memory.MemoryStatus.Err(var paramError):
                    return System.Memory.MemoryStatus.Err(paramError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal finite law bool LawForbiddenLocalStorage(TokenKind storage)
{
    return storage == TokenKind.Heap || storage == TokenKind.Static;
}

internal finite law bool TypeSpanIsDynamicStorage(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    return start != 0
        && start < endExclusive
        && TypedLocalTypeSpanHasTopLevelToken(stream, start, endExclusive, TokenKind.Dynamic);
}

internal fn bool ExpressionIsRuntimeDynamicNew(borrow StatementList body, borrow TokenStream stream, u32[0 max] node)
{
    return node != 0
        && body.ExprKindAt(node) == Compiler.Parsing.ExprKind.New
        && !NewExpressionUsesArenaSelector(body, stream, node);
}

internal finite law bool LawDynamicAllocationMember(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    return TokenTextEquals(source, stream, token, "Reserve")
        || TokenTextEquals(source, stream, token, "TryReserve")
        || TokenTextEquals(source, stream, token, "ReserveCapacity")
        || TokenTextEquals(source, stream, token, "TryReserveCapacity");
}

internal finite law bool LawDynamicMutationMember(ascii source, borrow TokenStream stream, u32[0 max] token)
{
    return TokenTextEquals(source, stream, token, "MoveLast")
        || TokenTextEquals(source, stream, token, "MoveAt");
}

internal fn u32[0 max] AssignmentTargetRootNode(borrow StatementList body, u32[0 max] target)
{
    stack mut u32[0 max] root = target;
    stack mut u64[0 2 ** 63 - 1] guard = (u64[0 2 ** 63 - 1])(body.ExprNodeCount() + 1);
    while willexit (root != 0 && guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack ExprKind kind = body.ExprKindAt(root);
        if (kind == Compiler.Parsing.ExprKind.Member
            || kind == Compiler.Parsing.ExprKind.Index
            || kind == Compiler.Parsing.ExprKind.Unary)
        {
            stack u32[0 max] next = body.ExprLeftAt(root);
            if (next == 0)
            {
                return root;
            }

            root = next;
        }
        else
        {
            return root;
        }
    }

    return root;
}

internal fn bool AssignmentTargetWritesThroughRoot(borrow StatementList body, u32[0 max] target)
{
    if (target == 0)
    {
        return false;
    }

    stack ExprKind kind = body.ExprKindAt(target);
    return kind == Compiler.Parsing.ExprKind.Member
        || kind == Compiler.Parsing.ExprKind.Index
        || kind == Compiler.Parsing.ExprKind.Unary;
}

internal fn bool FunctionScopeSymbolIsMemoryBacked(borrow TokenStream stream, borrow FunctionScope scope, u32[0 max] targetPlusOne)
{
    if (targetPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] target = (u64[0 2 ** 63 - 1])(targetPlusOne - 1);
    if (target >= scope.Count())
    {
        return false;
    }

    return TypeSpanIsMemoryBackedParameter(stream, scope.TypeStartTokenAt(target), scope.TypeEndTokenAt(target));
}

internal fn bool FunctionScopeSymbolIsDynamicStorage(borrow TokenStream stream, borrow FunctionScope scope, u32[0 max] targetPlusOne)
{
    if (targetPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] target = (u64[0 2 ** 63 - 1])(targetPlusOne - 1);
    return target < scope.Count()
        && TypeSpanIsDynamicStorage(stream, scope.TypeStartTokenAt(target), scope.TypeEndTokenAt(target));
}

internal fn bool DeclarationTypeSpanIsDynamicStorage(borrow DeclarationTable table, borrow TokenStream stream, u32[0 max] tableIndexPlusOne)
{
    if (tableIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] tableIndex = (u64[0 2 ** 63 - 1])(tableIndexPlusOne - 1);
    if (tableIndex >= table.Count())
    {
        return false;
    }

    stack DeclarationKind kind = table.KindAt(tableIndex);
    if (kind != DeclarationKind.Static && kind != DeclarationKind.Const && kind != DeclarationKind.GlobalVariable)
    {
        return false;
    }

    return TypeSpanIsDynamicStorage(stream, table.KeywordTokenAt(tableIndex), table.NameTokenAt(tableIndex));
}

internal fn bool StructFieldTypeSpanIsDynamicStorage(
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] structNameToken,
    u32[0 max] fieldNameToken)
{
    stack u32[0 max] structDefName = FindStructDefName(table, source, stream, structNameToken);
    if (structDefName == 0 || fieldNameToken == 0)
    {
        return false;
    }

    stack ascii fieldName = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fieldNameToken);
    switch (ParseStructFields(stream, structDefName))
    {
        case ParseResult<FieldList>.Err(var fieldsError):
            return false;
        case ParseResult<FieldList>.Ok(var fields):
            stack u64[0 2 ** 63 - 1] fieldCount = fields.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] field = 0; field < fieldCount; field += 1)
            {
                stack ascii name = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])fields.NameTokenAt(field));
                if (System.Text.Equals(name, fieldName))
                {
                    return TypeSpanIsDynamicStorage(stream, fields.TypeStartAt(field), fields.TypeEndAt(field));
                }
            }
    }

    return false;
}

internal fn bool ExpressionIsDynamicStorageValue(
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] node)
{
    if (node == 0)
    {
        return false;
    }

    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, node);
        if (refIndexPlusOne == 0)
        {
            return false;
        }

        stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
        stack ReferenceKind refKind = refs.KindAt(refIndex);
        if (refKind == ReferenceKind.Local || refKind == ReferenceKind.Parameter)
        {
            return FunctionScopeSymbolIsDynamicStorage(stream, scope, refs.TargetAt(refIndex));
        }

        if (refKind == ReferenceKind.Declaration)
        {
            return DeclarationTypeSpanIsDynamicStorage(table, stream, refs.TargetAt(refIndex));
        }
    }
    else if (kind == Compiler.Parsing.ExprKind.Member)
    {
        stack u32[0 max] receiverStruct = MemberStructNameToken(table, source, refs, scope, stream, body, body.ExprLeftAt(node));
        return StructFieldTypeSpanIsDynamicStorage(table, source, stream, receiverStruct, body.ExprTokenAt(node));
    }

    return false;
}

internal fn bool AssignmentTargetIsDynamicStorage(
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] target)
{
    return ExpressionIsDynamicStorageValue(table, source, refs, scope, stream, body, target);
}

internal fn bool AssignmentTargetIsExternallyVisible(
    borrow DeclarationTable table,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] target)
{
    stack u32[0 max] root = AssignmentTargetRootNode(body, target);
    if (root == 0 || body.ExprKindAt(root) != Compiler.Parsing.ExprKind.Identifier)
    {
        return false;
    }

    stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, root);
    if (refIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
    stack ReferenceKind kind = refs.KindAt(refIndex);
    if (kind == ReferenceKind.Declaration)
    {
        return DeclarationRootIsLongLived(table, refs.TargetAt(refIndex));
    }

    if (kind == ReferenceKind.Parameter && AssignmentTargetWritesThroughRoot(body, target))
    {
        return FunctionScopeSymbolIsMemoryBacked(stream, scope, refs.TargetAt(refIndex));
    }

    return false;
}

internal fn bool CallTargetsDynamicStorageMember(
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] callNode,
    bool allocation)
{
    if (callNode == 0 || body.ExprKindAt(callNode) != Compiler.Parsing.ExprKind.Call)
    {
        return false;
    }

    stack u32[0 max] calleeNode = body.ExprLeftAt(callNode);
    if (calleeNode == 0 || body.ExprKindAt(calleeNode) != Compiler.Parsing.ExprKind.Member)
    {
        return false;
    }

    stack u32[0 max] methodToken = body.ExprTokenAt(calleeNode);
    if (allocation)
    {
        if (!LawDynamicAllocationMember(source, stream, methodToken))
        {
            return false;
        }
    }
    else if (!LawDynamicMutationMember(source, stream, methodToken))
    {
        return false;
    }

    stack u32[0 max] receiverNode = body.ExprLeftAt(calleeNode);
    return ExpressionIsDynamicStorageValue(table, source, refs, scope, stream, body, receiverNode);
}

internal fn bool CallAllocatesDynamicStorage(
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] callNode)
{
    return CallTargetsDynamicStorageMember(table, source, refs, scope, stream, body, callNode, true);
}

internal fn bool CallMutatesDynamicStorage(
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    u32[0 max] callNode)
{
    return CallTargetsDynamicStorageMember(table, source, refs, scope, stream, body, callNode, false);
}

internal fn System.Memory.MemoryStatus CollectLawBodyRestrictionDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    if (!signature.LawKind())
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < statementCount; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        if (item.Kind == StatementKind.Local && LawForbiddenLocalStorage(stream.KindAt((u64[0 2 ** 63 - 1])item.StartToken)))
        {
            switch (diags.Append(BindDiagnosticCode.LawLocalStorageInLaw, item.StartToken))
            {
                case System.Memory.MemoryStatus.Err(var localError):
                    return System.Memory.MemoryStatus.Err(localError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        stack u32[0 max] root = body.ExprRootAt(index);
        if (item.Kind == StatementKind.Local
            && TypeSpanIsDynamicStorage(stream, item.TypeStartToken, item.TypeEndToken)
            && ExpressionIsRuntimeDynamicNew(body, stream, root))
        {
            stack mut u32[0 max] token = item.StartToken;
            if (root != 0)
            {
                token = body.ExprTokenAt(root);
            }

            switch (diags.Append(BindDiagnosticCode.LawDynamicStorageAllocation, token))
            {
                case System.Memory.MemoryStatus.Err(var localDynamicError):
                    return System.Memory.MemoryStatus.Err(localDynamicError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else if (item.Kind == StatementKind.Return
            && TypeSpanIsDynamicStorage(stream, signature.ReturnTypeStartTokenAt(), signature.ReturnTypeEndTokenAt())
            && ExpressionIsRuntimeDynamicNew(body, stream, root))
        {
            stack mut u32[0 max] token = item.StartToken;
            if (root != 0)
            {
                token = body.ExprTokenAt(root);
            }

            switch (diags.Append(BindDiagnosticCode.LawDynamicStorageAllocation, token))
            {
                case System.Memory.MemoryStatus.Err(var returnDynamicError):
                    return System.Memory.MemoryStatus.Err(returnDynamicError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    stack u64[0 2 ** 63 - 1] nodeCount = body.ExprNodeCount();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= nodeCount; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        stack ExprKind kind = body.ExprKindAt(node);
        if (kind == Compiler.Parsing.ExprKind.Assign
            && AssignmentTargetIsExternallyVisible(table, refs, scope, stream, body, body.ExprLeftAt(node)))
        {
            switch (diags.Append(BindDiagnosticCode.LawExternallyVisibleWrite, body.ExprTokenAt(body.ExprLeftAt(node))))
            {
                case System.Memory.MemoryStatus.Err(var writeError):
                    return System.Memory.MemoryStatus.Err(writeError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == Compiler.Parsing.ExprKind.Assign
            && AssignmentTargetIsDynamicStorage(table, source, refs, scope, stream, body, body.ExprLeftAt(node))
            && ExpressionIsRuntimeDynamicNew(body, stream, body.ExprRightAt(node)))
        {
            switch (diags.Append(BindDiagnosticCode.LawDynamicStorageAllocation, body.ExprTokenAt(body.ExprRightAt(node))))
            {
                case System.Memory.MemoryStatus.Err(var assignDynamicError):
                    return System.Memory.MemoryStatus.Err(assignDynamicError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else if (kind == Compiler.Parsing.ExprKind.Call
            && CallAllocatesDynamicStorage(table, source, refs, scope, stream, body, node))
        {
            switch (diags.Append(BindDiagnosticCode.LawDynamicStorageAllocation, body.ExprTokenAt(body.ExprLeftAt(node))))
            {
                case System.Memory.MemoryStatus.Err(var allocateDynamicError):
                    return System.Memory.MemoryStatus.Err(allocateDynamicError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else if (kind == Compiler.Parsing.ExprKind.Call
            && CallMutatesDynamicStorage(table, source, refs, scope, stream, body, node))
        {
            switch (diags.Append(BindDiagnosticCode.LawDynamicStorageMutation, body.ExprTokenAt(body.ExprLeftAt(node))))
            {
                case System.Memory.MemoryStatus.Err(var dynamicError):
                    return System.Memory.MemoryStatus.Err(dynamicError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectLawExternallyVisibleEffectDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    borrow ReferenceTable refs,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    if (!signature.LawKind())
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] refCount = refs.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] refIndex = 0; refIndex < refCount; refIndex += 1)
    {
        if (ReferenceReadsGlobalState(table, refs, body, refIndex))
        {
            switch (diags.Append(BindDiagnosticCode.LawGlobalStateRead, refs.NameTokenAt(refIndex)))
            {
                case System.Memory.MemoryStatus.Err(var readError):
                    return System.Memory.MemoryStatus.Err(readError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendFunctionKindObligationDiagnostics(
    borrow FunctionSignature caller,
    bool hasCandidate,
    bool hasLawCandidate,
    bool hasFiniteCandidate,
    u32[0 max] token,
    mut borrow BindDiagnosticList diags)
{
    if (!hasCandidate)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    if (caller.LawKind() && !hasLawCandidate)
    {
        switch (diags.Append(BindDiagnosticCode.LawCallRequiresLaw, token))
        {
            case System.Memory.MemoryStatus.Err(var lawError):
                return System.Memory.MemoryStatus.Err(lawError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    if (caller.FiniteKind() && !hasFiniteCandidate)
    {
        switch (diags.Append(BindDiagnosticCode.FiniteCallRequiresFinite, token))
        {
            case System.Memory.MemoryStatus.Err(var finiteError):
                return System.Memory.MemoryStatus.Err(finiteError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectBecomeRootCallNodes(borrow StatementList body, mut borrow dynamic u32[0 max] skipCallNodes)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (body.ItemAt(index).Kind == StatementKind.Become)
        {
            switch (AppendNodeIfPresent(skipCallNodes, body.ExprRootAt(index)))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectCallableFunctionKindObligationDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    borrow dynamic u32[0 max] skipCallNodes,
    mut borrow BindDiagnosticList diags)
{
    switch (BuildCallableCandidateSets(table, source, stream, refs, scope, body))
    {
        case BindResult<CallableCandidateSetTable>.Err(var callableError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case BindResult<CallableCandidateSetTable>.Ok(var candidates):
            stack u64[0 2 ** 63 - 1] siteCount = candidates.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] site = 0; site < siteCount; site += 1)
            {
                stack u32[0 max] callNode = candidates.CallNodeAt(site);
                if (callNode != 0 && !U32ListContains(skipCallNodes, callNode))
                {
                    stack mut bool hasCandidate = false;
                    stack mut bool hasLawCandidate = false;
                    stack mut bool hasFiniteCandidate = false;
                    stack u32[0 max] candidateCount = candidates.CandidateCountAt(site);
                    for willexit (stack mut u32[0 max] candidate = 0; candidate < candidateCount; candidate += 1)
                    {
                        stack mut TypedDeclarationFunctionKind functionKind = TypedDeclarationFunctionKind.Fn;
                        stack mut bool hasFunctionKind = false;
                        stack u32[0 max] targetPlusOne = candidates.CandidateTargetAt(site, candidate);
                        if (candidates.CandidateKindAt(site, candidate) == CallableCandidateKind.Declaration)
                        {
                            stack mut FunctionSignature callee = new();
                            if (TryParseFunctionSignatureFromTable(table, stream, targetPlusOne, callee))
                            {
                                functionKind = DeclarationFunctionKind(callee);
                                hasFunctionKind = true;
                            }
                        }
                        else if (candidates.CandidateKindAt(site, candidate) == CallableCandidateKind.ScopeSymbol)
                        {
                            if (TryReadFunctionScopeCallableKind(stream, scope, targetPlusOne, functionKind))
                            {
                                hasFunctionKind = true;
                            }
                        }

                        if (hasFunctionKind)
                        {
                            hasCandidate = true;
                            if (TypedFunctionKindIsLaw(functionKind))
                            {
                                hasLawCandidate = true;
                            }

                            if (TypedFunctionKindIsFinite(functionKind))
                            {
                                hasFiniteCandidate = true;
                            }
                        }
                    }

                    switch (AppendFunctionKindObligationDiagnostics(
                        signature,
                        hasCandidate,
                        hasLawCandidate,
                        hasFiniteCandidate,
                        candidates.NameTokenAt(site),
                        diags))
                    {
                        case System.Memory.MemoryStatus.Err(var appendError):
                            return System.Memory.MemoryStatus.Err(appendError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn bool TryReadReceiverMethodFunctionKind(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerNameToken,
    u32[0 max] methodNameToken,
    bool wantStatic,
    out TypedDeclarationFunctionKind functionKind)
{
    functionKind = TypedDeclarationFunctionKind.Fn;
    stack u32[0 max] bodyOpen = ReceiverBodyOpenToken(stream, ownerNameToken);
    if (bodyOpen == 0)
    {
        return false;
    }

    stack mut u32[0 max] memberStart = (u32[0 max])(bodyOpen + 1);
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind startKind = stream.KindAt((u64[0 2 ** 63 - 1])memberStart);
        if (startKind == TokenKind.EndOfFile || startKind == TokenKind.RBrace)
        {
            return false;
        }

        stack u32[0 max] memberEnd = ReceiverMemberEndToken(stream, memberStart);
        if (memberEnd < memberStart)
        {
            return false;
        }

        stack u32[0 max] fnKeyword = ReceiverMemberFunctionToken(stream, memberStart, memberEnd);
        if (fnKeyword != 0 && ReceiverMemberHasStaticBefore(stream, memberStart, fnKeyword) == wantStatic)
        {
            switch (ParseFunctionSignature(stream, fnKeyword))
            {
                case ParseResult<FunctionSignature>.Err(var sigError):
                {
                }
                case ParseResult<FunctionSignature>.Ok(var signature):
                    if (TokenTextEqualsToken(source, stream, signature.Name(), methodNameToken))
                    {
                        functionKind = MemberFunctionKind(stream, memberStart, fnKeyword, signature);
                        return true;
                    }
            }
        }

        memberStart = (u32[0 max])(memberEnd + 1);
    }

    return false;
}

internal fn System.Memory.MemoryStatus CollectReceiverFunctionKindObligationDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    borrow dynamic u32[0 max] skipCallNodes,
    mut borrow BindDiagnosticList diags)
{
    switch (BuildReceiverCandidateSets(table, source, stream, refs, scope, body))
    {
        case BindResult<ReceiverCandidateSetTable>.Err(var receiverError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case BindResult<ReceiverCandidateSetTable>.Ok(var candidates):
            stack u64[0 2 ** 63 - 1] siteCount = candidates.Count();
            for willexit (stack mut u64[0 2 ** 63 - 1] site = 0; site < siteCount; site += 1)
            {
                stack u32[0 max] callNode = candidates.CallNodeAt(site);
                if (callNode != 0 && !U32ListContains(skipCallNodes, callNode))
                {
                    stack mut bool hasCandidate = false;
                    stack mut bool hasLawCandidate = false;
                    stack mut bool hasFiniteCandidate = false;
                    stack u32[0 max] candidateCount = candidates.CandidateCountAt(site);
                    for willexit (stack mut u32[0 max] candidate = 0; candidate < candidateCount; candidate += 1)
                    {
                        stack ReceiverCandidateKind candidateKind = candidates.CandidateKindAt(site, candidate);
                        if (candidateKind == ReceiverCandidateKind.InstanceMethod || candidateKind == ReceiverCandidateKind.StaticMethod)
                        {
                            stack mut TypedDeclarationFunctionKind functionKind = TypedDeclarationFunctionKind.Fn;
                            if (TryReadReceiverMethodFunctionKind(
                                source,
                                stream,
                                candidates.ReceiverTypeTokenAt(site),
                                candidates.CandidateTokenAt(site, candidate),
                                candidateKind == ReceiverCandidateKind.StaticMethod,
                                functionKind))
                            {
                                hasCandidate = true;
                                if (TypedFunctionKindIsLaw(functionKind))
                                {
                                    hasLawCandidate = true;
                                }

                                if (TypedFunctionKindIsFinite(functionKind))
                                {
                                    hasFiniteCandidate = true;
                                }
                            }
                        }
                    }

                    switch (AppendFunctionKindObligationDiagnostics(
                        signature,
                        hasCandidate,
                        hasLawCandidate,
                        hasFiniteCandidate,
                        candidates.NameTokenAt(site),
                        diags))
                    {
                        case System.Memory.MemoryStatus.Err(var appendError):
                            return System.Memory.MemoryStatus.Err(appendError);
                        case System.Memory.MemoryStatus.Ok:
                    }
                }
            }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectFunctionKindObligationDiagnostics(
    borrow FunctionSignature signature,
    borrow DeclarationTable table,
    ascii source,
    borrow ReferenceTable refs,
    borrow FunctionScope scope,
    borrow TokenStream stream,
    borrow StatementList body,
    mut borrow BindDiagnosticList diags)
{
    if (!signature.LawKind() && !signature.FiniteKind())
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut dynamic u32[0 max] skipCallNodes = new();
    switch (CollectBecomeRootCallNodes(body, skipCallNodes))
    {
        case System.Memory.MemoryStatus.Err(var skipError):
            return System.Memory.MemoryStatus.Err(skipError);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectCallableFunctionKindObligationDiagnostics(signature, table, source, refs, scope, stream, body, skipCallNodes, diags))
    {
        case System.Memory.MemoryStatus.Err(var callableError):
            return System.Memory.MemoryStatus.Err(callableError);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectReceiverFunctionKindObligationDiagnostics(signature, table, source, refs, scope, stream, body, skipCallNodes, diags))
    {
        case System.Memory.MemoryStatus.Err(var receiverError):
            return System.Memory.MemoryStatus.Err(receiverError);
        case System.Memory.MemoryStatus.Ok:
    }

    return System.Memory.MemoryStatus.Ok;
}

// Emits semantic diagnostics for `become`: the caller must be `tail`, the
// statement must be a direct call in tail-transfer position, the resolved callee
// must itself be tail-callable, ordinary law/finite effect rules must allow the
// call, and the current self-hosted ABI model must be `musttail`-compatible.
internal fn System.Memory.MemoryStatus CollectBecomeDiagnostics(borrow FunctionSignature signature, borrow DeclarationTable table, ascii source, borrow ReferenceTable refs, borrow TokenStream stream, borrow StatementList body, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        if (item.Kind == StatementKind.Become)
        {
            if (!signature.TailCallable())
            {
                switch (diags.Append(BindDiagnosticCode.BecomeOutsideTailFunction, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var callerError):
                        return System.Memory.MemoryStatus.Err(callerError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            stack u32[0 max] root = body.ExprRootAt(index);
            if (root == 0 || body.ExprKindAt(root) != Compiler.Parsing.ExprKind.Call)
            {
                switch (diags.Append(BindDiagnosticCode.BecomeRequiresDirectCall, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var callError):
                        return System.Memory.MemoryStatus.Err(callError);
                    case System.Memory.MemoryStatus.Ok:
                }

                continue;
            }

            stack u32[0 max] calleeNode = body.ExprLeftAt(root);
            if (calleeNode == 0 || body.ExprKindAt(calleeNode) != Compiler.Parsing.ExprKind.Identifier)
            {
                switch (diags.Append(BindDiagnosticCode.BecomeRequiresDirectCall, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var directError):
                        return System.Memory.MemoryStatus.Err(directError);
                    case System.Memory.MemoryStatus.Ok:
                }

                continue;
            }

            stack u32[0 max] refIndexPlusOne = ReferenceIndexForNode(refs, calleeNode);
            if (refIndexPlusOne == 0)
            {
                continue;
            }

            stack u64[0 2 ** 63 - 1] refIndex = (u64[0 2 ** 63 - 1])(refIndexPlusOne - 1);
            stack ReferenceKind refKind = refs.KindAt(refIndex);
            if (refKind == ReferenceKind.Unbound)
            {
                continue;
            }

            if (refKind != ReferenceKind.Declaration)
            {
                switch (diags.Append(BindDiagnosticCode.BecomeTargetNotTailCallable, refs.NameTokenAt(refIndex)))
                {
                    case System.Memory.MemoryStatus.Err(var localTargetError):
                        return System.Memory.MemoryStatus.Err(localTargetError);
                    case System.Memory.MemoryStatus.Ok:
                }

                continue;
            }

            stack mut FunctionSignature callee = new();
            if (!TryParseFunctionSignatureFromTable(table, stream, refs.TargetAt(refIndex), callee))
            {
                switch (diags.Append(BindDiagnosticCode.BecomeTargetNotTailCallable, refs.NameTokenAt(refIndex)))
                {
                    case System.Memory.MemoryStatus.Err(var nonFunctionError):
                        return System.Memory.MemoryStatus.Err(nonFunctionError);
                    case System.Memory.MemoryStatus.Ok:
                }

                continue;
            }

            if (!callee.TailCallable())
            {
                switch (diags.Append(BindDiagnosticCode.BecomeTargetNotTailCallable, refs.NameTokenAt(refIndex)))
                {
                    case System.Memory.MemoryStatus.Err(var targetError):
                        return System.Memory.MemoryStatus.Err(targetError);
                    case System.Memory.MemoryStatus.Ok:
                }

                continue;
            }

            if (!BecomeEffectsCompatible(signature, callee))
            {
                switch (diags.Append(BindDiagnosticCode.BecomeEffectMismatch, refs.NameTokenAt(refIndex)))
                {
                    case System.Memory.MemoryStatus.Err(var effectError):
                        return System.Memory.MemoryStatus.Err(effectError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            if (!BecomeAbiCompatible(signature, callee, source, stream, body.ExprCallArgCountAt(root)))
            {
                switch (diags.Append(BindDiagnosticCode.BecomeAbiMismatch, refs.NameTokenAt(refIndex)))
                {
                    case System.Memory.MemoryStatus.Err(var abiError):
                        return System.Memory.MemoryStatus.Err(abiError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Emits the structural return-statement diagnostics (independent of value
// coercion, matching the host): `ValueReturnedFromVoid` for a `return value;` in
// a `void` function, and `MissingReturnValue` for a bare `return;` in a non-void
// function. Anchored at the `return` statement. Skipped when the return type
// could not be classified.
internal fn System.Memory.MemoryStatus CollectReturnDiagnostics(borrow FunctionSignature signature, borrow StatementList body, borrow TokenStream stream, mut borrow BindDiagnosticList diags)
{
    stack u32[0 max] returnTypeToken = signature.ReturnTypeTokenAt();
    if (returnTypeToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack bool isVoid = stream.KindAt((u64[0 2 ** 63 - 1])returnTypeToken) == TokenKind.Void;
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        if (item.Kind == StatementKind.Return)
        {
            stack bool hasValue = body.ExprRootAt(index) != 0;
            if (hasValue && isVoid)
            {
                switch (diags.Append(BindDiagnosticCode.ValueReturnedFromVoid, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var voidError):
                        return System.Memory.MemoryStatus.Err(voidError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
            else if (!hasValue && !isVoid)
            {
                switch (diags.Append(BindDiagnosticCode.MissingReturnValue, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var missingError):
                        return System.Memory.MemoryStatus.Err(missingError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// The index plus one of the nearest statement before `fromIndex` at block depth
// `targetDepth` (the ancestor block statement at that level), or 0 when none.
internal fn u64[0 2 ** 63 - 1] NearestPrecedingAtDepth(borrow StatementList body, u64[0 2 ** 63 - 1] fromIndex, u32[0 max] targetDepth)
{
    stack mut u64[0 2 ** 63 - 1] found = 0;
    stack mut u64[0 2 ** 63 - 1] scan = fromIndex;
    while willexit (scan > 0)
    {
        scan = (u64[0 2 ** 63 - 1])(scan - 1);
        if (found == 0 && body.DepthAt(scan) == targetDepth)
        {
            found = (u64[0 2 ** 63 - 1])(scan + 1);
        }
    }

    return found;
}

// Whether the statement at `stmtIndex` is lexically enclosed by a loop (and, when
// `includeSwitch`, a `switch`): walks the ancestor block-statement chain (nearest
// preceding statement at each shallower depth) looking for a `While`/`For` (or
// `Switch`).
internal fn bool EnclosedByLoopOrSwitch(borrow StatementList body, u64[0 2 ** 63 - 1] stmtIndex, bool includeSwitch)
{
    stack mut bool enclosed = false;
    stack mut u64[0 2 ** 63 - 1] cur = stmtIndex;
    stack mut u32[0 max] d = body.DepthAt(stmtIndex);
    while willexit (d > 0 && !enclosed)
    {
        stack u64[0 2 ** 63 - 1] ancestorPlus = NearestPrecedingAtDepth(body, cur, (u32[0 max])(d - 1));
        if (ancestorPlus == 0)
        {
            d = 0;
        }
        else
        {
            stack u64[0 2 ** 63 - 1] ancestor = (u64[0 2 ** 63 - 1])(ancestorPlus - 1);
            stack StatementItem item = body.ItemAt(ancestor);
            if (item.Kind == StatementKind.While || item.Kind == StatementKind.For || item.Kind == StatementKind.ForEach)
            {
                enclosed = true;
            }
            else if (includeSwitch && item.Kind == StatementKind.Switch)
            {
                enclosed = true;
            }

            cur = ancestor;
            d = (u32[0 max])(d - 1);
        }
    }

    return enclosed;
}

// Emits `BreakOutsideLoop` for a `break` with no enclosing loop/switch and
// `ContinueOutsideLoop` for a `continue` with no enclosing loop (a `switch` does
// not satisfy `continue`), matching the host's STK4113/STK4114.
internal fn System.Memory.MemoryStatus CollectControlFlowDiagnostics(borrow StatementList body, mut borrow BindDiagnosticList diags)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        if (item.Kind == StatementKind.Break)
        {
            if (!EnclosedByLoopOrSwitch(body, index, true))
            {
                switch (diags.Append(BindDiagnosticCode.BreakOutsideLoop, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var breakError):
                        return System.Memory.MemoryStatus.Err(breakError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
        else if (item.Kind == StatementKind.Continue)
        {
            if (!EnclosedByLoopOrSwitch(body, index, false))
            {
                switch (diags.Append(BindDiagnosticCode.ContinueOutsideLoop, item.StartToken))
                {
                    case System.Memory.MemoryStatus.Err(var continueError):
                        return System.Memory.MemoryStatus.Err(continueError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Binds one function: emits duplicate-parameter, duplicate-local, unresolved-type
// (per signature type head), unresolved-reference (per unbound identifier), and
// non-boolean-condition diagnostics. Parse failures for the function are skipped.
internal fn System.Memory.MemoryStatus BindFunction(
    u32[0 max] fnKeyword,
    borrow DeclarationList decls,
    borrow DeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    mut borrow CopyabilityFactTable copyabilityFacts,
    mut borrow BindDiagnosticList diags)
{
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var sigError):
            return System.Memory.MemoryStatus.Ok;
        case ParseResult<FunctionSignature>.Ok(var signature):
            switch (CollectAsmSignatureDiagnostics(signature, source, stream, diags))
            {
                case System.Memory.MemoryStatus.Err(var asmError):
                    return System.Memory.MemoryStatus.Err(asmError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (CollectLawSignatureDiagnostics(signature, stream, diags))
            {
                case System.Memory.MemoryStatus.Err(var lawSignatureError):
                    return System.Memory.MemoryStatus.Err(lawSignatureError);
                case System.Memory.MemoryStatus.Ok:
            }

            if (signature.HasAsm())
            {
                return System.Memory.MemoryStatus.Ok;
            }

            switch (ParseFunctionBody(stream, fnKeyword))
            {
                case ParseResult<StatementList>.Err(var bodyError):
                    return System.Memory.MemoryStatus.Ok;
                case ParseResult<StatementList>.Ok(var body):
                    switch (BuildFunctionScope(signature, body))
                    {
                        case BindResult<FunctionScope>.Err(var scopeError):
                            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                        case BindResult<FunctionScope>.Ok(var scope):
                            if (HasDuplicateParameter(scope, source, stream))
                            {
                                switch (diags.Append(BindDiagnosticCode.DuplicateParameter, signature.Name()))
                                {
                                    case System.Memory.MemoryStatus.Err(var e1):
                                        return System.Memory.MemoryStatus.Err(e1);
                                    case System.Memory.MemoryStatus.Ok:
                                }
                            }

                            if (HasDuplicateLocalInBlock(source, stream, body))
                            {
                                switch (diags.Append(BindDiagnosticCode.DuplicateLocalInBlock, signature.Name()))
                                {
                                    case System.Memory.MemoryStatus.Err(var e2):
                                        return System.Memory.MemoryStatus.Err(e2);
                                    case System.Memory.MemoryStatus.Ok:
                                }
                            }

                            // The function's own type parameters (`fn RET name<T>(...)`)
                            // open at the `<` directly after the name token, so a
                            // return/parameter type naming a type parameter resolves.
                            stack u32[0 max] genericList = (u32[0 max])(signature.Name() + 1);
                            stack u32[0 max] returnStart = signature.ReturnTypeStartTokenAt();
                            stack u32[0 max] returnEnd = signature.ReturnTypeEndTokenAt();
                            if (returnStart < returnEnd)
                            {
                                switch (CollectUnresolvedTypeReferencesInSpan(table, source, stream, returnStart, returnEnd, genericList, 0, false, diags))
                                {
                                    case System.Memory.MemoryStatus.Err(var e3):
                                        return System.Memory.MemoryStatus.Err(e3);
                                    case System.Memory.MemoryStatus.Ok:
                                }
                            }

                            stack u64[0 2 ** 63 - 1] paramCount = signature.ParamCount();
                            for willexit (stack mut u64[0 2 ** 63 - 1] p = 0; p < paramCount; p += 1)
                            {
                                stack u32[0 max] paramStart = signature.ParamTypeStartTokenAt(p);
                                stack u32[0 max] paramEnd = signature.ParamTypeEndTokenAt(p);
                                if (paramStart < paramEnd)
                                {
                                    switch (CollectUnresolvedTypeReferencesInSpan(table, source, stream, paramStart, paramEnd, genericList, 0, false, diags))
                                    {
                                        case System.Memory.MemoryStatus.Err(var e4):
                                            return System.Memory.MemoryStatus.Err(e4);
                                        case System.Memory.MemoryStatus.Ok:
                                    }
                                }
                            }

                            // Each local declaration's named type (its head, 0 for a
                            // built-in or a `var` pattern binding) must resolve to a
                            // declaration or the function's own type parameters.
                            stack u64[0 2 ** 63 - 1] localStmtCount = body.Count();
                            for willexit (stack mut u64[0 2 ** 63 - 1] s = 0; s < localStmtCount; s += 1)
                            {
                                stack u32[0 max] localStart = body.TypeStartTokenAt(s);
                                stack u32[0 max] localEnd = body.TypeEndTokenAt(s);
                                if (localStart < localEnd)
                                {
                                    switch (CollectUnresolvedTypeReferencesInSpan(table, source, stream, localStart, localEnd, genericList, 0, false, diags))
                                    {
                                        case System.Memory.MemoryStatus.Err(var e4b):
                                            return System.Memory.MemoryStatus.Err(e4b);
                                        case System.Memory.MemoryStatus.Ok:
                                    }
                                }
                            }

                            // Each `where T: Trait, ...` constraint trait must resolve
                            // to a declaration (or be a function type parameter).
                            switch (CollectWhereConstraintTypeSpans(stream, fnKeyword))
                            {
                                case ParseResult<TypeSpanList>.Err(var whereError):
                                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                                case ParseResult<TypeSpanList>.Ok(var constraintSpans):
                                    stack u64[0 2 ** 63 - 1] constraintCount = constraintSpans.Count();
                                    for willexit (stack mut u64[0 2 ** 63 - 1] c = 0; c < constraintCount; c += 1)
                                    {
                                        stack u32[0 max] constraintStart = constraintSpans.StartTokenAt(c);
                                        stack u32[0 max] constraintEnd = constraintSpans.EndTokenAt(c);
                                        if (constraintStart < constraintEnd)
                                        {
                                            switch (CollectUnresolvedTypeReferencesInSpan(table, source, stream, constraintStart, constraintEnd, genericList, 0, false, diags))
                                            {
                                                case System.Memory.MemoryStatus.Err(var e4c):
                                                    return System.Memory.MemoryStatus.Err(e4c);
                                                case System.Memory.MemoryStatus.Ok:
                                            }
                                        }
                                    }
                            }

                            switch (CollectDeadOnReturnSignatureDiagnostics(signature, source, stream, fnKeyword, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var deadContractError):
                                    return System.Memory.MemoryStatus.Err(deadContractError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            // The lexical reference table (resolved with shadowing
                            // and block scope) is built once and reused so that
                            // identifier types are read from each reference's
                            // RESOLVED symbol, not a flat last-name-match.
                            stack mut ReferenceTable refs = new();
                            switch (ResolveReferences(scope, table, source, stream, body))
                            {
                                case BindResult<ReferenceTable>.Err(var refError):
                                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                                case BindResult<ReferenceTable>.Ok(var built):
                                    refs = built;
                            }

                            stack u64[0 2 ** 63 - 1] refCount = refs.Count();
                            for willexit (stack mut u64[0 2 ** 63 - 1] r = 0; r < refCount; r += 1)
                            {
                                if (refs.KindAt(r) == ReferenceKind.Unbound)
                                {
                                    switch (diags.Append(BindDiagnosticCode.UnresolvedReference, refs.NameTokenAt(r)))
                                    {
                                        case System.Memory.MemoryStatus.Err(var e5):
                                            return System.Memory.MemoryStatus.Err(e5);
                                        case System.Memory.MemoryStatus.Ok:
                                    }
                                }
                            }

                            switch (CollectLawBodyRestrictionDiagnostics(signature, table, source, refs, scope, stream, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var lawBodyError):
                                    return System.Memory.MemoryStatus.Err(lawBodyError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectLawExternallyVisibleEffectDiagnostics(signature, table, refs, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var visibleEffectError):
                                    return System.Memory.MemoryStatus.Err(visibleEffectError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectDeadOnReturnCallDiagnostics(signature, table, source, refs, scope, stream, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var deadCallError):
                                    return System.Memory.MemoryStatus.Err(deadCallError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectPackedFieldSafeBorrowDiagnostics(signature, decls, table, source, refs, scope, stream, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var packedBorrowError):
                                    return System.Memory.MemoryStatus.Err(packedBorrowError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectCopyableLawPredicateCallDiagnostics(signature, fnKeyword, decls, table, source, refs, scope, stream, body, copyabilityFacts, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var copyableLawError):
                                    return System.Memory.MemoryStatus.Err(copyableLawError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectStraightLineInitializationDiagnostics(refs, scope, stream, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var initializationError):
                                    return System.Memory.MemoryStatus.Err(initializationError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectStraightLineBorrowLivenessDiagnostics(decls, table, source, refs, scope, stream, body, copyabilityFacts, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var borrowLivenessError):
                                    return System.Memory.MemoryStatus.Err(borrowLivenessError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectStraightLineMoveAfterMoveDiagnostics(decls, table, source, refs, scope, stream, body, copyabilityFacts, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var moveAfterMoveError):
                                    return System.Memory.MemoryStatus.Err(moveAfterMoveError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectConcreteLayoutQueryDiagnostics(fnKeyword, decls, table, source, stream, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var layoutQueryError):
                                    return System.Memory.MemoryStatus.Err(layoutQueryError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectArenaDiagnostics(signature, table, source, refs, scope, stream, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var arenaError):
                                    return System.Memory.MemoryStatus.Err(arenaError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectNonBooleanConditions(table, source, refs, scope, stream, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var condError):
                                    return System.Memory.MemoryStatus.Err(condError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectExpressionTypeErrors(table, source, refs, scope, stream, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var operandError):
                                    return System.Memory.MemoryStatus.Err(operandError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectFunctionKindObligationDiagnostics(signature, table, source, refs, scope, stream, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var functionKindError):
                                    return System.Memory.MemoryStatus.Err(functionKindError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectBecomeDiagnostics(signature, table, source, refs, stream, body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var becomeError):
                                    return System.Memory.MemoryStatus.Err(becomeError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectReturnDiagnostics(signature, body, stream, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var returnError):
                                    return System.Memory.MemoryStatus.Err(returnError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            switch (CollectControlFlowDiagnostics(body, diags))
                            {
                                case System.Memory.MemoryStatus.Err(var cfError):
                                    return System.Memory.MemoryStatus.Err(cfError);
                                case System.Memory.MemoryStatus.Ok:
                            }

                            return System.Memory.MemoryStatus.Ok;
                    }
            }
    }
}

// Binds a whole compilation unit from its lexed token stream: parses the header
// and declarations, builds the top-level declaration table, and collects every
// binder diagnostic (duplicate declarations/parameters/locals, unresolved value
// references, and unresolved signature types). This is the binder's pass-level
// entry point; an empty diagnostic list means the unit binds cleanly.
public fn BindResult<BindDiagnosticList> BindCompilationUnit(ascii source, borrow TokenStream stream)
{
    stack mut BindDiagnosticList diags = new();
    stack mut u32[0 max] declStart = 0;
    switch (ParseHeader(stream))
    {
        case ParseResult<CompilationUnitHeader>.Err(var headerError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case ParseResult<CompilationUnitHeader>.Ok(var header):
            declStart = header.NextToken;
    }

    stack mut DeclarationList decls = new();
    switch (ParseDeclarations(stream, declStart))
    {
        case ParseResult<DeclarationList>.Err(var declError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case ParseResult<DeclarationList>.Ok(var value):
            decls = value;
    }

    stack mut DeclarationTable table = new();
    switch (BuildDeclarationTable(source, stream, decls))
    {
        case BindResult<DeclarationTable>.Err(var tableError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case BindResult<DeclarationTable>.Ok(var built):
            table = built;
    }

    switch (CollectDuplicateDeclarations(table, source, stream, diags))
    {
        case System.Memory.MemoryStatus.Err(var dupError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectLinkNameDiagnostics(decls, source, stream, diags))
    {
        case System.Memory.MemoryStatus.Err(var linkNameError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectLayoutControlDiagnostics(decls, source, stream, diags))
    {
        case System.Memory.MemoryStatus.Err(var layoutError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectExportedSurfaceDiagnostics(decls, table, source, stream, diags))
    {
        case System.Memory.MemoryStatus.Err(var exportedSurfaceError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    stack mut CopyabilityFactTable copyabilityFacts = new();
    switch (BuildCopyabilityFacts(decls, table, source, stream))
    {
        case BindResult<CopyabilityFactTable>.Err(var factError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case BindResult<CopyabilityFactTable>.Ok(var builtFacts):
            copyabilityFacts = builtFacts;
    }

    switch (CollectCopyableAssertionDiagnostics(decls, table, source, stream, copyabilityFacts, diags))
    {
        case System.Memory.MemoryStatus.Err(var copyableError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    switch (CollectRecursiveInlineLayoutDiagnostics(decls, source, stream, diags))
    {
        case System.Memory.MemoryStatus.Err(var recursiveLayoutError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] declCount = decls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < declCount; index += 1)
    {
        stack DeclItem item = decls.ItemAt(index);
        if (item.Kind == DeclarationKind.Function)
        {
            switch (BindFunction(item.KeywordToken, decls, table, source, stream, copyabilityFacts, diags))
            {
                case System.Memory.MemoryStatus.Err(var fnError):
                    return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else if (item.Kind == DeclarationKind.Struct || item.Kind == DeclarationKind.Record)
        {
            switch (CollectDropValidityDiagnostics(item, table, source, stream, diags))
            {
                case System.Memory.MemoryStatus.Err(var dropValidityError):
                    return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (CollectConstructorInitializationDiagnostics(item, decls, table, source, stream, copyabilityFacts, diags))
            {
                case System.Memory.MemoryStatus.Err(var constructorInitError):
                    return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (CollectUnresolvedFieldTypes(item.KeywordToken, table, source, stream, diags))
            {
                case System.Memory.MemoryStatus.Err(var fieldTypeError):
                    return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (CollectUnresolvedTypeDeclarationWhereConstraints(item.KeywordToken, table, source, stream, diags))
            {
                case System.Memory.MemoryStatus.Err(var whereTypeError):
                    return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else if (item.Kind == DeclarationKind.Enum)
        {
            switch (ParseEnumVariants(stream, item.KeywordToken))
            {
                case ParseResult<VariantList>.Err(var variantError):
                    return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
                case ParseResult<VariantList>.Ok(var variants):
                    switch (CollectDuplicateEnumVariants(variants, source, stream, diags))
                    {
                        case System.Memory.MemoryStatus.Err(var dupError):
                            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
                        case System.Memory.MemoryStatus.Ok:
                    }
            }

            switch (CollectUnresolvedVariantTypes(item.KeywordToken, table, source, stream, diags))
            {
                case System.Memory.MemoryStatus.Err(var variantTypeError):
                    return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (CollectUnresolvedTypeDeclarationWhereConstraints(item.KeywordToken, table, source, stream, diags))
            {
                case System.Memory.MemoryStatus.Err(var whereTypeError):
                    return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    switch (CollectRecursionDiagnostics(table, source, stream, diags))
    {
        case System.Memory.MemoryStatus.Err(var recursionError):
            return BindResult<BindDiagnosticList>.Err(BindError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    return BindResult<BindDiagnosticList>.Ok(diags);
}
