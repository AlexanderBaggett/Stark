public fn bool TryParseCompilerPassId(ascii name, out CompilerPassId pass)
{
    pass = CompilerPassId.Unknown;

    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < CompilerPassCount())
    {
        stack CompilerPassId candidate = CompilerPassAtOrdinal(ordinal);
        if (System.Text.Equals(CompilerPassName(candidate), name))
        {
            pass = candidate;
            return true;
        }

        ordinal += 1;
    }

    return false;
}

