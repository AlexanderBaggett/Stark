            if (index == 2) { return CompilerPassId.SyntaxModel; }
            if (index == 3) { return CompilerPassId.DeclarationIndex; }
            if (index == 4) { return CompilerPassId.TypeCheck; }
            if (index == 5) { return CompilerPassId.MonomorphizationPlan; }
            if (index == 6) { return CompilerPassId.SpecializationCodegenStrategy; }
        case CompilerPassId.CseConstGraphCallsSsa:
            if (index == 0) { return CompilerPassId.InlineSsa; }
            if (index == 1) { return CompilerPassId.RefineFunctionEffects; }
            if (index == 2) { return CompilerPassId.SemanticValidate; }
            if (index == 3) { return CompilerPassId.TypeCheck; }
        case CompilerPassId.ConstLookupTablesSsa:
            if (index == 0) { return CompilerPassId.CseConstGraphCallsSsa; }
            if (index == 1) { return CompilerPassId.TypeCheck; }
        case CompilerPassId.ValueFacts:
            if (index == 0) { return CompilerPassId.ConstLookupTablesSsa; }
            if (index == 1) { return CompilerPassId.SemanticValidate; }
            if (index == 2) { return CompilerPassId.LoadModules; }
            if (index == 3) { return CompilerPassId.SpecializationCodegenStrategy; }
        case CompilerPassId.DynamicStorageSsa:
            if (index == 0) { return CompilerPassId.ValueFacts; }
            if (index == 1) { return CompilerPassId.SemanticValidate; }
            if (index == 2) { return CompilerPassId.LoadModules; }
            if (index == 3) { return CompilerPassId.SpecializationCodegenStrategy; }
        case CompilerPassId.DynamicAppendLoopSsa:
            if (index == 0) { return CompilerPassId.DynamicStorageSsa; }
            if (index == 1) { return CompilerPassId.SemanticValidate; }
            if (index == 2) { return CompilerPassId.LoadModules; }
            if (index == 3) { return CompilerPassId.SpecializationCodegenStrategy; }
        case CompilerPassId.SpecializeConstStdlibHelpersSsa:
            if (index == 0) { return CompilerPassId.DynamicStorageSsa; }
            if (index == 1) { return CompilerPassId.TypeCheck; }
        case CompilerPassId.SpecializeAsciiToUnicodeLiteralsSsa:
            if (index == 0) { return CompilerPassId.SpecializeConstStdlibHelpersSsa; }
        case CompilerPassId.SpecializeConstantTextFormattingSsa:
            if (index == 0) { return CompilerPassId.SpecializeAsciiToUnicodeLiteralsSsa; }
        case CompilerPassId.PruneBranches:
            if (index == 0) { return CompilerPassId.SpecializeConstantTextFormattingSsa; }
        case CompilerPassId.MemoryOptSsa:
            if (index == 0) { return CompilerPassId.PruneBranches; }
            if (index == 1) { return CompilerPassId.RefineFunctionEffects; }
        case CompilerPassId.AggregateConstructionSsa:
            if (index == 0) { return CompilerPassId.MemoryOptSsa; }
            if (index == 1) { return CompilerPassId.TypeCheck; }
        case CompilerPassId.OwnershipTrafficSsa:
            if (index == 0) { return CompilerPassId.AggregateConstructionSsa; }
        case CompilerPassId.SroaSsa:
            if (index == 0) { return CompilerPassId.OwnershipTrafficSsa; }
        case CompilerPassId.ShapeBranches:
            if (index == 0) { return CompilerPassId.SroaSsa; }
        case CompilerPassId.ArithmeticFoldSsa:
            if (index == 0) { return CompilerPassId.ShapeBranches; }
            if (index == 1) { return CompilerPassId.SemanticValidate; }
            if (index == 2) { return CompilerPassId.LoadModules; }
            if (index == 3) { return CompilerPassId.SpecializationCodegenStrategy; }
        case CompilerPassId.LowerAbi:
            if (index == 0) { return CompilerPassId.SyntaxModel; }
            if (index == 1) { return CompilerPassId.TypeCheck; }
            if (index == 2) { return CompilerPassId.EnumLayout; }
            if (index == 3) { return CompilerPassId.RefineFunctionEffects; }
            if (index == 4) { return CompilerPassId.LowerHir; }
            if (index == 5) { return CompilerPassId.ArithmeticFoldSsa; }
        case CompilerPassId.ValidateSsa:
            if (index == 0) { return CompilerPassId.TypeCheck; }
            if (index == 1) { return CompilerPassId.LoadModules; }
            if (index == 2) { return CompilerPassId.EnumLayout; }
            if (index == 3) { return CompilerPassId.ArithmeticFoldSsa; }
            if (index == 4) { return CompilerPassId.LowerAbi; }
            if (index == 5) { return CompilerPassId.SpecializationCodegenStrategy; }
        case CompilerPassId.EmitLlvm:
            if (index == 0) { return CompilerPassId.SyntaxModel; }
            if (index == 1) { return CompilerPassId.RefineFunctionEffects; }
            if (index == 2) { return CompilerPassId.TypeCheck; }
            if (index == 3) { return CompilerPassId.EnumLayout; }
            if (index == 4) { return CompilerPassId.SemanticValidate; }
            if (index == 5) { return CompilerPassId.MemoryOptSsa; }
            if (index == 6) { return CompilerPassId.LowerAbi; }
            if (index == 7) { return CompilerPassId.ValidateSsa; }
            if (index == 8) { return CompilerPassId.SpecializationCodegenStrategy; }
        case CompilerPassId.Parse:
        case CompilerPassId.Unknown:
    }

    return CompilerPassId.Unknown;
}

public finite law bool CompilerPassHasDirectDependency(CompilerPassId pass, CompilerPassId dependency)
{
    stack mut u8[0 max] index = 0;
    stack u8[0 9] count = CompilerPassDependencyCount(pass);
    while willexit (index < count)
    {
        if (CompilerPassDependencyAt(pass, index) == dependency)
        {
            return true;
        }

        index += 1;
    }

    return false;
}

public finite law bool CompilerPassDependenciesAreOrdered(CompilerPassId pass)
{
    if (pass == CompilerPassId.Unknown)
    {
        return false;
    }

    stack u32[0 max] passOrdinal = CompilerPassOrdinal(pass);
    stack mut u8[0 max] index = 0;
    stack u8[0 9] count = CompilerPassDependencyCount(pass);
    while willexit (index < count)
    {
        stack CompilerPassId dependency = CompilerPassDependencyAt(pass, index);
        if (dependency == CompilerPassId.Unknown || CompilerPassOrdinal(dependency) >= passOrdinal)
        {
            return false;
        }

        index += 1;
    }

    return true;
}

public finite law bool DefaultCompilerPassGraphIsOrdered()
{
    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < CompilerPassCount())
    {
        if (!CompilerPassDependenciesAreOrdered(CompilerPassAtOrdinal(ordinal)))
        {
            return false;
        }

        ordinal += 1;
    }

    return true;
}

public finite law u8[0 2] CompilerPassOutputArtifactCount(CompilerPassId pass)
{
    switch (pass)
    {
        case CompilerPassId.ModuleGraph:
        case CompilerPassId.RefineFunctionEffects:
        case CompilerPassId.BorrowLiveness:
        case CompilerPassId.DynamicStorageSsa:
        case CompilerPassId.DynamicAppendLoopSsa:
        case CompilerPassId.SpecializeConstStdlibHelpersSsa:
        case CompilerPassId.SpecializeAsciiToUnicodeLiteralsSsa:
        case CompilerPassId.SpecializeConstantTextFormattingSsa:
        case CompilerPassId.PruneBranches:
        case CompilerPassId.MemoryOptSsa:
        case CompilerPassId.AggregateConstructionSsa:
        case CompilerPassId.OwnershipTrafficSsa:
        case CompilerPassId.SroaSsa:
        case CompilerPassId.ShapeBranches:
        case CompilerPassId.ArithmeticFoldSsa:
            return 2;
        case CompilerPassId.ValidateSsa:
        case CompilerPassId.Unknown:
            return 0;
        default:
            return 1;
    }
}

public finite law CompilerArtifactKind CompilerPassOutputArtifactAt(CompilerPassId pass, u8[0 max] index)
{
    switch (pass)
    {
        case CompilerPassId.Parse:
            if (index == 0) { return CompilerArtifactKind.ParseResult; }
        case CompilerPassId.SyntaxModel:
            if (index == 0) { return CompilerArtifactKind.SyntaxModel; }
        case CompilerPassId.DeclarationIndex:
            if (index == 0) { return CompilerArtifactKind.DeclarationIndex; }
        case CompilerPassId.ModuleGraph:
            if (index == 0) { return CompilerArtifactKind.ModuleGraph; }
            if (index == 1) { return CompilerArtifactKind.SourceModuleParseCache; }
        case CompilerPassId.LoadModules:
            if (index == 0) { return CompilerArtifactKind.LoadedModules; }
        case CompilerPassId.SymbolCatalog:
            if (index == 0) { return CompilerArtifactKind.SymbolCatalog; }
        case CompilerPassId.FunctionEffects:
            if (index == 0) { return CompilerArtifactKind.FunctionEffects; }
        case CompilerPassId.TypeCheck:
            if (index == 0) { return CompilerArtifactKind.TypeCheckModel; }
        case CompilerPassId.InstantiationOwnership:
            if (index == 0) { return CompilerArtifactKind.InstantiationOwnership; }
        case CompilerPassId.MonomorphizationPlan:
            if (index == 0) { return CompilerArtifactKind.MonomorphizationPlan; }
        case CompilerPassId.EnumLayout:
            if (index == 0) { return CompilerArtifactKind.EnumLayoutModel; }
        case CompilerPassId.SemanticValidate:
            if (index == 0) { return CompilerArtifactKind.SemanticValidation; }
        case CompilerPassId.RefineFunctionEffects:
            if (index == 0) { return CompilerArtifactKind.FunctionEffects; }
            if (index == 1) { return CompilerArtifactKind.ClosedWorldOptimization; }
        case CompilerPassId.SpecializationPlan:
            if (index == 0) { return CompilerArtifactKind.SpecializationPlan; }
        case CompilerPassId.SpecializationCodegenStrategy:
            if (index == 0) { return CompilerArtifactKind.SpecializationCodegenStrategy; }
        case CompilerPassId.OwnershipValidate:
            if (index == 0) { return CompilerArtifactKind.OwnershipValidation; }
        case CompilerPassId.ValidateLoweringContract:
            if (index == 0) { return CompilerArtifactKind.LoweringContractValidation; }
        case CompilerPassId.LowerHir:
            if (index == 0) { return CompilerArtifactKind.HighLevelIr; }
        case CompilerPassId.LowerMir:
            if (index == 0) { return CompilerArtifactKind.MidLevelIr; }
        case CompilerPassId.BorrowLiveness:
            if (index == 0) { return CompilerArtifactKind.OwnershipValidation; }
            if (index == 1) { return CompilerArtifactKind.MidLevelIr; }
        case CompilerPassId.LowerSsa:
            if (index == 0) { return CompilerArtifactKind.SsaIr; }
        case CompilerPassId.CleanupSsa:
        case CompilerPassId.ConstProp:
        case CompilerPassId.DevirtSsa:
        case CompilerPassId.InlineSsa:
        case CompilerPassId.CseConstGraphCallsSsa:
        case CompilerPassId.ConstLookupTablesSsa:
            if (index == 0) { return CompilerArtifactKind.OptimizedSsaIr; }
        case CompilerPassId.ValueFacts:
            if (index == 0) { return CompilerArtifactKind.SsaValueFacts; }
        case CompilerPassId.DynamicStorageSsa:
        case CompilerPassId.DynamicAppendLoopSsa:
        case CompilerPassId.SpecializeConstStdlibHelpersSsa:
        case CompilerPassId.SpecializeAsciiToUnicodeLiteralsSsa:
        case CompilerPassId.SpecializeConstantTextFormattingSsa:
        case CompilerPassId.PruneBranches:
        case CompilerPassId.MemoryOptSsa:
        case CompilerPassId.AggregateConstructionSsa:
        case CompilerPassId.OwnershipTrafficSsa:
        case CompilerPassId.SroaSsa:
        case CompilerPassId.ShapeBranches:
        case CompilerPassId.ArithmeticFoldSsa:
            if (index == 0) { return CompilerArtifactKind.OptimizedSsaIr; }
            if (index == 1) { return CompilerArtifactKind.SsaValueFacts; }
        case CompilerPassId.LowerAbi:
            if (index == 0) { return CompilerArtifactKind.AbiModel; }
        case CompilerPassId.EmitLlvm:
            if (index == 0) { return CompilerArtifactKind.LlvmIrModule; }
        case CompilerPassId.ValidateSsa:
        case CompilerPassId.Unknown:
    }

    return CompilerArtifactKind.Unknown;
}

public fn ArtifactStatus AddCompilerPassRequiredArtifacts(
    mut borrow ArtifactDependencySet dependencies,
    CompilerPassId pass)
{
    if (pass == CompilerPassId.Unknown)
    {
        return ArtifactStatus.Err(ArtifactError.UnknownArtifactKind);
    }

    stack mut u8[0 max] dependencyIndex = 0;
    stack u8[0 9] dependencyCount = CompilerPassDependencyCount(pass);
    while willexit (dependencyIndex < dependencyCount)
    {
        stack CompilerPassId dependency = CompilerPassDependencyAt(pass, dependencyIndex);
        stack mut u8[0 max] outputIndex = 0;
        stack u8[0 2] outputCount = CompilerPassOutputArtifactCount(dependency);
        while willexit (outputIndex < outputCount)
        {
            stack CompilerArtifactKind kind = CompilerPassOutputArtifactAt(dependency, outputIndex);
            if (kind != CompilerArtifactKind.Unknown)
            {
                switch (AddRequiredArtifact(dependencies, kind))
                {
                    case ArtifactStatus.Err(var error):
                        return ArtifactStatus.Err(error);
                    case ArtifactStatus.Ok:
                }
            }

            outputIndex += 1;
        }

        dependencyIndex += 1;
    }

    return ArtifactStatus.Ok;
}

public fn bool TryResolveStopAfterPass(ascii passName, out CompilerPassId pass)
{
    pass = CompilerPassId.Unknown;
    if (System.Text.AsciiLength(passName) == 0)
    {
        return true;
    }

    return TryParseCompilerPassId(passName, pass);
}

public inline finite law bool ShouldStopAfterPass(CompilerPassId stopAfter, CompilerPassId completedPass)
{
    return stopAfter != CompilerPassId.Unknown && stopAfter == completedPass;
}

public struct PassExecutionRecord
{
    internal CompilerPassId PassValue;
    internal CompilerPhase PhaseValue;
    internal PassExecutionStatus StatusValue;
    internal u64[0 max] DurationMicrosecondsValue;
    internal u32[0 max] DiagnosticsAddedValue;

    PassExecutionRecord()
    {
        self.PassValue = CompilerPassId.Unknown;
        self.PhaseValue = CompilerPhase.Unknown;
        self.StatusValue = PassExecutionStatus.Unknown;
        self.DurationMicrosecondsValue = 0;
        self.DiagnosticsAddedValue = 0;
    }

    public inline finite law CompilerPassId Pass(borrow PassExecutionRecord self)
    {
        return self.PassValue;
    }

    public inline finite law CompilerPhase Phase(borrow PassExecutionRecord self)
    {
        return self.PhaseValue;
    }

    public inline finite law PassExecutionStatus Status(borrow PassExecutionRecord self)
    {
        return self.StatusValue;
    }

    public inline finite law u64[0 max] DurationMicroseconds(borrow PassExecutionRecord self)
    {
        return self.DurationMicrosecondsValue;
    }

    public inline finite law u32[0 max] DiagnosticsAdded(borrow PassExecutionRecord self)
    {
        return self.DiagnosticsAddedValue;
    }
}

public inline finite law PassExecutionRecord PassExecutionRecordOf(
    CompilerPassId pass,
    PassExecutionStatus status,
    u64[0 max] durationMicroseconds,
    u32[0 max] diagnosticsAdded)
{
    return new PassExecutionRecord()
    {
        PassValue = pass,
        PhaseValue = CompilerPassPhase(pass),
        StatusValue = status,
        DurationMicrosecondsValue = durationMicroseconds,
        DiagnosticsAddedValue = diagnosticsAdded
    };
}

public struct PassExecutionLog
{
    internal dynamic CompilerPassId Passes;
    internal dynamic CompilerPhase Phases;
    internal dynamic PassExecutionStatus Statuses;
    internal dynamic u64[0 max] Durations;
    internal dynamic u32[0 max] DiagnosticsAdded;

    PassExecutionLog()
    {
        self.Passes = new();
        self.Phases = new();
        self.Statuses = new();
        self.Durations = new();
        self.DiagnosticsAdded = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow PassExecutionLog self)
    {
        return self.Passes.Length;
    }

    public law CompilerPassId PassAt(borrow PassExecutionLog self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.Passes.Length)
        {
            return self.Passes[index];
        }

        return CompilerPassId.Unknown;
    }

    public law CompilerPhase PhaseAt(borrow PassExecutionLog self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.Phases.Length)
        {
            return self.Phases[index];
        }

        return CompilerPhase.Unknown;
    }

    public law PassExecutionStatus StatusAt(borrow PassExecutionLog self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.Statuses.Length)
        {
            return self.Statuses[index];
        }

        return PassExecutionStatus.Unknown;
    }

    public law u64[0 max] DurationMicrosecondsAt(borrow PassExecutionLog self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.Durations.Length)
        {
            return self.Durations[index];
        }

        return 0;
    }

    public law u32[0 max] DiagnosticsAddedAt(borrow PassExecutionLog self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.DiagnosticsAdded.Length)
        {
            return self.DiagnosticsAdded[index];
        }

        return 0;
    }
}

public fn PipelineStatus AppendPassExecutionRecord(
    mut borrow PassExecutionLog log,
    PassExecutionRecord execution)
{
    if (execution.PassValue == CompilerPassId.Unknown)
    {
        return PipelineStatus.Err(PipelineError.UnknownPass);
    }

    if (!log.Passes.TryReserve(1)
        || !log.Phases.TryReserve(1)
        || !log.Statuses.TryReserve(1)
        || !log.Durations.TryReserve(1)
        || !log.DiagnosticsAdded.TryReserve(1))
    {
        return PipelineStatus.Err(PipelineError.OutOfMemory);
    }

    init log.Passes[log.Passes.Length] = execution.PassValue;
    init log.Phases[log.Phases.Length] = execution.PhaseValue;
    init log.Statuses[log.Statuses.Length] = execution.StatusValue;
    init log.Durations[log.Durations.Length] = execution.DurationMicrosecondsValue;
    init log.DiagnosticsAdded[log.DiagnosticsAdded.Length] = execution.DiagnosticsAddedValue;
    return PipelineStatus.Ok;
}

public law u64[0 2 ** 63 - 1] PassExecutionLogStatusCount(
    borrow PassExecutionLog log,
    PassExecutionStatus status)
{
    stack mut u64[0 2 ** 63 - 1] count = 0;
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < log.Statuses.Length)
    {
        if (log.Statuses[index] == status)
        {
            count += 1;
        }

        index += 1;
    }

    return count;
}

internal fn PipelineStatus PipelineAppendMemoryStatus(System.Memory.MemoryStatus status)
{
    switch (status)
    {
        case System.Memory.MemoryStatus.Err(var error):
            return PipelineStatus.Err(PipelineError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
            return PipelineStatus.Ok;
    }
}

internal fn PipelineStatus AppendPassCrashMessage(
    mut borrow OwnedAscii message,
    CompilerPassId pass,
    ascii detail)
{
    try PipelineAppendMemoryStatus(message.AppendAscii("Pass '"));
    try PipelineAppendMemoryStatus(message.AppendAscii(CompilerPassName(pass)));
    try PipelineAppendMemoryStatus(message.AppendAscii("' crashed: "));
    try PipelineAppendMemoryStatus(message.AppendAscii(detail));
    return PipelineStatus.Ok;
}

public fn PipelineStatus AppendPassCrashDiagnostic(
    mut borrow DiagnosticBag diagnostics,
    CompilerPassId pass,
    ascii detail)
{
    if (pass == CompilerPassId.Unknown)
    {
        return PipelineStatus.Err(PipelineError.UnknownPass);
    }

    stack mut OwnedAscii message = new();
    try AppendPassCrashMessage(message, pass, detail);
    stack mut OwnedAscii stage = new();
    try PipelineAppendMemoryStatus(stage.AppendAscii(CompilerPassName(pass)));

    switch (diagnostics.Append(
        DiagnosticSeverity.Error,
        "STK9999",
        message.View(),
        stage.View(),
        true,
        "",
        false,
        1,
        1,
        0,
        0,
        false))
    {
        case DiagnosticStatus.Err(var error):
            return PipelineStatus.Err(PipelineError.Diagnostic(error));
        case DiagnosticStatus.Ok:
            return PipelineStatus.Ok;
    }
}
