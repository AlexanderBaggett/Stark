public finite law PassExecutionMode CompilerPassExecutionMode(CompilerPassId pass)
{
    switch (pass)
    {
        case CompilerPassId.Parse:
            return PassExecutionMode.RunAlways;
        default:
            return PassExecutionMode.SkipOnErrors;
    }
}

public finite law u8[0 9] CompilerPassDependencyCount(CompilerPassId pass)
{
    switch (pass)
    {
        case CompilerPassId.Parse:
        case CompilerPassId.Unknown:
            return 0;
        case CompilerPassId.SyntaxModel:
        case CompilerPassId.DeclarationIndex:
        case CompilerPassId.ModuleGraph:
        case CompilerPassId.CleanupSsa:
        case CompilerPassId.ConstProp:
        case CompilerPassId.DevirtSsa:
        case CompilerPassId.SpecializeAsciiToUnicodeLiteralsSsa:
        case CompilerPassId.SpecializeConstantTextFormattingSsa:
        case CompilerPassId.PruneBranches:
        case CompilerPassId.OwnershipTrafficSsa:
        case CompilerPassId.SroaSsa:
        case CompilerPassId.ShapeBranches:
            return 1;
        case CompilerPassId.SymbolCatalog:
        case CompilerPassId.InstantiationOwnership:
        case CompilerPassId.MonomorphizationPlan:
        case CompilerPassId.EnumLayout:
        case CompilerPassId.SpecializationCodegenStrategy:
        case CompilerPassId.AggregateConstructionSsa:
            return 2;
        case CompilerPassId.LoadModules:
        case CompilerPassId.FunctionEffects:
        case CompilerPassId.SpecializationPlan:
        case CompilerPassId.OwnershipValidate:
        case CompilerPassId.BorrowLiveness:
        case CompilerPassId.LowerAbi:
            return 3;
        case CompilerPassId.TypeCheck:
        case CompilerPassId.ValueFacts:
        case CompilerPassId.DynamicStorageSsa:
        case CompilerPassId.DynamicAppendLoopSsa:
        case CompilerPassId.ArithmeticFoldSsa:
            return 4;
        case CompilerPassId.SemanticValidate:
        case CompilerPassId.ValidateLoweringContract:
        case CompilerPassId.LowerMir:
        case CompilerPassId.LowerSsa:
        case CompilerPassId.ValidateSsa:
            return 6;
        case CompilerPassId.RefineFunctionEffects:
            return 5;
        case CompilerPassId.InlineSsa:
            return 7;
        case CompilerPassId.LowerHir:
        case CompilerPassId.EmitLlvm:
            return 9;
        case CompilerPassId.CseConstGraphCallsSsa:
            return 4;
        case CompilerPassId.ConstLookupTablesSsa:
        case CompilerPassId.SpecializeConstStdlibHelpersSsa:
        case CompilerPassId.MemoryOptSsa:
            return 2;
    }
}

public finite law CompilerPassId CompilerPassDependencyAt(CompilerPassId pass, u8[0 max] index)
{
    switch (pass)
    {
        case CompilerPassId.SyntaxModel:
            if (index == 0) { return CompilerPassId.Parse; }
        case CompilerPassId.DeclarationIndex:
            if (index == 0) { return CompilerPassId.SyntaxModel; }
        case CompilerPassId.ModuleGraph:
            if (index == 0) { return CompilerPassId.SyntaxModel; }
        case CompilerPassId.LoadModules:
            if (index == 0) { return CompilerPassId.Parse; }
            if (index == 1) { return CompilerPassId.SyntaxModel; }
            if (index == 2) { return CompilerPassId.ModuleGraph; }
        case CompilerPassId.SymbolCatalog:
            if (index == 0) { return CompilerPassId.DeclarationIndex; }
            if (index == 1) { return CompilerPassId.ModuleGraph; }
        case CompilerPassId.FunctionEffects:
            if (index == 0) { return CompilerPassId.SyntaxModel; }
