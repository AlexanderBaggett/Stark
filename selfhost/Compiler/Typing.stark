        init self.CandidateKinds[self.CandidateKinds.Length] = candidateKind;
        init self.CandidateSignatureIndices[self.CandidateSignatureIndices.Length] = signatureIndexPlusOne;
        init self.CandidateNameTokens[self.CandidateNameTokens.Length] = candidateNameToken;
        init self.CandidateParameterCounts[self.CandidateParameterCounts.Length] = candidateParameterCount;
        init self.CandidateReturnTypeKinds[self.CandidateReturnTypeKinds.Length] = returnTypeKind;
        init self.CandidateReturnTypeHeadTokens[self.CandidateReturnTypeHeadTokens.Length] = returnTypeHeadToken;
        init self.CandidateReturnTypePrimaryTokens[self.CandidateReturnTypePrimaryTokens.Length] = returnTypePrimaryToken;
        init self.CandidateReturnTypeStartTokens[self.CandidateReturnTypeStartTokens.Length] = returnTypeStartToken;
        init self.CandidateReturnTypeEndTokens[self.CandidateReturnTypeEndTokens.Length] = returnTypeEndToken;
