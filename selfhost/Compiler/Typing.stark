    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedStorageSelectorTable self,
        TypedStorageSelectorContext context,
        TypedGlobalStorageKind storageKind,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
