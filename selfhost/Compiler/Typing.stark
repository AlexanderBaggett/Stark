    internal fn System.Memory.MemoryStatus AppendConversion(
        mut borrow TypedConversionExpressionTable self,
        TypedConversionContext context,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
        u32[0 max] functionNameToken,
        u32[0 max] statementIndexPlusOne,
        u32[0 max] conversionNode,
        u32[0 max] openParenToken,
        u32[0 max] operandNode,
        TypedConversionOperandKind operandKind,
        TypedSignatureTypeKind targetTypeKind,
        u32[0 max] targetTypeHeadToken,
        u32[0 max] targetTypePrimaryToken,
        u32[0 max] targetTypeStartToken,
        u32[0 max] targetTypeEndToken,
        u32[0 max] targetRangeStartToken,
        u32[0 max] targetRangeEndToken,
        u32[0 max] targetElementCountStartToken,
        u32[0 max] targetElementCountEndToken,
        u32[0 max] targetBitWidth,
        u32[0 max] targetTypeArgumentCount,
        u32[0 max] targetComptimeArgumentCount,
        u32[0 max] targetTypeFlags,
        TypedSignatureTypeKind operandTypeKind,
        u32[0 max] operandTypeHeadToken,
        u32[0 max] operandTypePrimaryToken,
        u32[0 max] operandTypeStartToken,
        u32[0 max] operandTypeEndToken,
        u32[0 max] operandRangeStartToken,
        u32[0 max] operandRangeEndToken,
        u32[0 max] operandElementCountStartToken,
        u32[0 max] operandElementCountEndToken,
        u32[0 max] operandBitWidth,
        u32[0 max] operandTypeArgumentCount,
        u32[0 max] operandComptimeArgumentCount,
        u32[0 max] operandTypeFlags,
        u32[0 max] conversionFlags)
    {
        if (!self.Contexts.TryReserve(1)
            || !self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.FunctionNameTokens.TryReserve(1)
            || !self.StatementIndices.TryReserve(1)
            || !self.ConversionNodes.TryReserve(1)
            || !self.OpenParenTokens.TryReserve(1)
            || !self.OperandNodes.TryReserve(1)
            || !self.OperandKinds.TryReserve(1)
            || !self.TargetTypeKinds.TryReserve(1)
            || !self.TargetTypeHeadTokens.TryReserve(1)
            || !self.TargetTypePrimaryTokens.TryReserve(1)
            || !self.TargetTypeStartTokens.TryReserve(1)
            || !self.TargetTypeEndTokens.TryReserve(1)
            || !self.TargetRangeStartTokens.TryReserve(1)
            || !self.TargetRangeEndTokens.TryReserve(1)
            || !self.TargetElementCountStartTokens.TryReserve(1)
            || !self.TargetElementCountEndTokens.TryReserve(1)
            || !self.TargetBitWidths.TryReserve(1)
            || !self.TargetTypeArgumentCounts.TryReserve(1)
            || !self.TargetComptimeArgumentCounts.TryReserve(1)
            || !self.TargetTypeFlags.TryReserve(1)
            || !self.OperandTypeKinds.TryReserve(1)
            || !self.OperandTypeHeadTokens.TryReserve(1)
            || !self.OperandTypePrimaryTokens.TryReserve(1)
            || !self.OperandTypeStartTokens.TryReserve(1)
            || !self.OperandTypeEndTokens.TryReserve(1)
            || !self.OperandRangeStartTokens.TryReserve(1)
            || !self.OperandRangeEndTokens.TryReserve(1)
            || !self.OperandElementCountStartTokens.TryReserve(1)
            || !self.OperandElementCountEndTokens.TryReserve(1)
            || !self.OperandBitWidths.TryReserve(1)
            || !self.OperandTypeArgumentCounts.TryReserve(1)
            || !self.OperandComptimeArgumentCounts.TryReserve(1)
            || !self.OperandTypeFlags.TryReserve(1)
            || !self.ConversionFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Contexts[self.Contexts.Length] = context;
        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.FunctionNameTokens[self.FunctionNameTokens.Length] = functionNameToken;
        init self.StatementIndices[self.StatementIndices.Length] = statementIndexPlusOne;
        init self.ConversionNodes[self.ConversionNodes.Length] = conversionNode;
        init self.OpenParenTokens[self.OpenParenTokens.Length] = openParenToken;
        init self.OperandNodes[self.OperandNodes.Length] = operandNode;
        init self.OperandKinds[self.OperandKinds.Length] = operandKind;
        init self.TargetTypeKinds[self.TargetTypeKinds.Length] = targetTypeKind;
        init self.TargetTypeHeadTokens[self.TargetTypeHeadTokens.Length] = targetTypeHeadToken;
        init self.TargetTypePrimaryTokens[self.TargetTypePrimaryTokens.Length] = targetTypePrimaryToken;
        init self.TargetTypeStartTokens[self.TargetTypeStartTokens.Length] = targetTypeStartToken;
        init self.TargetTypeEndTokens[self.TargetTypeEndTokens.Length] = targetTypeEndToken;
        init self.TargetRangeStartTokens[self.TargetRangeStartTokens.Length] = targetRangeStartToken;
        init self.TargetRangeEndTokens[self.TargetRangeEndTokens.Length] = targetRangeEndToken;
        init self.TargetElementCountStartTokens[self.TargetElementCountStartTokens.Length] = targetElementCountStartToken;
        init self.TargetElementCountEndTokens[self.TargetElementCountEndTokens.Length] = targetElementCountEndToken;
        init self.TargetBitWidths[self.TargetBitWidths.Length] = targetBitWidth;
        init self.TargetTypeArgumentCounts[self.TargetTypeArgumentCounts.Length] = targetTypeArgumentCount;
        init self.TargetComptimeArgumentCounts[self.TargetComptimeArgumentCounts.Length] = targetComptimeArgumentCount;
        init self.TargetTypeFlags[self.TargetTypeFlags.Length] = targetTypeFlags;
        init self.OperandTypeKinds[self.OperandTypeKinds.Length] = operandTypeKind;
        init self.OperandTypeHeadTokens[self.OperandTypeHeadTokens.Length] = operandTypeHeadToken;
        init self.OperandTypePrimaryTokens[self.OperandTypePrimaryTokens.Length] = operandTypePrimaryToken;
        init self.OperandTypeStartTokens[self.OperandTypeStartTokens.Length] = operandTypeStartToken;
        init self.OperandTypeEndTokens[self.OperandTypeEndTokens.Length] = operandTypeEndToken;
        init self.OperandRangeStartTokens[self.OperandRangeStartTokens.Length] = operandRangeStartToken;
        init self.OperandRangeEndTokens[self.OperandRangeEndTokens.Length] = operandRangeEndToken;
        init self.OperandElementCountStartTokens[self.OperandElementCountStartTokens.Length] = operandElementCountStartToken;
        init self.OperandElementCountEndTokens[self.OperandElementCountEndTokens.Length] = operandElementCountEndToken;
        init self.OperandBitWidths[self.OperandBitWidths.Length] = operandBitWidth;
        init self.OperandTypeArgumentCounts[self.OperandTypeArgumentCounts.Length] = operandTypeArgumentCount;
        init self.OperandComptimeArgumentCounts[self.OperandComptimeArgumentCounts.Length] = operandComptimeArgumentCount;
        init self.OperandTypeFlags[self.OperandTypeFlags.Length] = operandTypeFlags;
        init self.ConversionFlags[self.ConversionFlags.Length] = conversionFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}

public enum TypedAssignmentOperatorKind
{
    Assign,
    AddAssign,
    SubAssign,
    MulAssign,
    DivAssign,
    ModAssign,
    AndAssign,
    OrAssign,
    XorAssign,
    WrapAddAssign,
    WrapSubAssign,
    WrapMulAssign,
    SatAddAssign,
    SatSubAssign,
    SatMulAssign,
    Unknown,
}

public enum TypedAssignmentTargetKind
{
    Identifier,
    Field,
    IndexElement,
    IndexSlice,
    Unknown,
}

public enum TypedAssignmentValueKind
{
    Identifier,
    Member,
    Call,
    Index,
    Literal,
    New,
    Conversion,
    Assignment,
    Unknown,
}

internal inline finite law u32[0 max] TypedAssignmentFlagTargetResolved()
{
    return 1;
}

internal inline finite law u32[0 max] TypedAssignmentFlagValueResolved()
{
    return 2;
}

internal inline finite law u32[0 max] TypedAssignmentFlagSimple()
{
    return 4;
}

internal inline finite law u32[0 max] TypedAssignmentFlagCompound()
{
    return 8;
}

internal inline finite law u32[0 max] TypedAssignmentFlagPlaceTarget()
{
    return 16;
}

internal inline finite law u32[0 max] TypedAssignmentFlagNumericCompound()
{
    return 32;
}

internal inline finite law bool TypedAssignmentFlagPresent(u32[0 max] flags, u32[0 max] flag)
{
    return (flags & flag) != 0;
}

