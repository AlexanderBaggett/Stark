    public finite bool TryGetEnumTagLayout(
        borrow TypedEnumLayoutTable self,
        u32[0 max] ownerDeclarationIndex,
        out u64[0 max] offsetBytes,
        out u64[0 max] sizeBytes,
        out u64[0 max] alignmentBytes,
        out bool isMisaligned)
    {
        offsetBytes = 0;
        sizeBytes = 0;
        alignmentBytes = 1;
        isMisaligned = false;

        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
                && self.RowKindAt(index) == TypedEnumLayoutRowKind.Variant)
            {
                if (!self.HasConcreteLayoutAt(index))
                {
                    return false;
