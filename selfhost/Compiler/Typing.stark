    internal fn System.Memory.MemoryStatus AppendCall(
        mut borrow TypedCallExpressionTable self,
        TypedCallContext context,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
        u32[0 max] functionNameToken,
        u32[0 max] statementIndexPlusOne,
        u32[0 max] callNode,
        u32[0 max] calleeNode,
        u32[0 max] callToken,
        u32[0 max] calleeNameToken,
        TypedCallTargetKind targetKind,
        u32[0 max] targetDeclarationIndex,
        u32[0 max] targetSymbolIndexPlusOne,
        u32[0 max] targetNameToken,
        u32[0 max] signatureIndexPlusOne,
        u32[0 max] argumentStartIndexPlusOne,
        u32[0 max] argumentCount,
        u32[0 max] parameterCount,
        u32[0 max] callFlags,
        TypedSignatureTypeKind returnTypeKind,
        u32[0 max] returnTypeHeadToken,
        u32[0 max] returnTypePrimaryToken,
        u32[0 max] returnTypeStartToken,
        u32[0 max] returnTypeEndToken,
        u32[0 max] returnRangeStartToken,
        u32[0 max] returnRangeEndToken,
        u32[0 max] returnElementCountStartToken,
        u32[0 max] returnElementCountEndToken,
        u32[0 max] returnBitWidth,
        u32[0 max] returnTypeArgumentCount,
        u32[0 max] returnComptimeArgumentCount,
        u32[0 max] returnTypeFlags,
        out u32[0 max] callIndexPlusOne)
    {
        callIndexPlusOne = 0;
        if (!self.Contexts.TryReserve(1)
            || !self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.FunctionNameTokens.TryReserve(1)
            || !self.StatementIndices.TryReserve(1)
            || !self.CallNodes.TryReserve(1)
            || !self.CalleeNodes.TryReserve(1)
            || !self.CallTokens.TryReserve(1)
            || !self.CalleeNameTokens.TryReserve(1)
            || !self.TargetKinds.TryReserve(1)
            || !self.TargetDeclarationIndices.TryReserve(1)
            || !self.TargetSymbolIndices.TryReserve(1)
            || !self.TargetNameTokens.TryReserve(1)
            || !self.SignatureIndices.TryReserve(1)
            || !self.ArgumentStarts.TryReserve(1)
            || !self.ArgumentCounts.TryReserve(1)
            || !self.ParameterCounts.TryReserve(1)
            || !self.CallFlags.TryReserve(1)
            || !self.ReturnTypeKinds.TryReserve(1)
            || !self.ReturnTypeHeadTokens.TryReserve(1)
            || !self.ReturnTypePrimaryTokens.TryReserve(1)
            || !self.ReturnTypeStartTokens.TryReserve(1)
            || !self.ReturnTypeEndTokens.TryReserve(1)
            || !self.ReturnRangeStartTokens.TryReserve(1)
            || !self.ReturnRangeEndTokens.TryReserve(1)
            || !self.ReturnElementCountStartTokens.TryReserve(1)
            || !self.ReturnElementCountEndTokens.TryReserve(1)
            || !self.ReturnBitWidths.TryReserve(1)
            || !self.ReturnTypeArgumentCounts.TryReserve(1)
            || !self.ReturnComptimeArgumentCounts.TryReserve(1)
            || !self.ReturnTypeFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        callIndexPlusOne = (u32[0 max])(self.CallNodes.Length + 1);
        init self.Contexts[self.Contexts.Length] = context;
        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.FunctionNameTokens[self.FunctionNameTokens.Length] = functionNameToken;
        init self.StatementIndices[self.StatementIndices.Length] = statementIndexPlusOne;
        init self.CallNodes[self.CallNodes.Length] = callNode;
        init self.CalleeNodes[self.CalleeNodes.Length] = calleeNode;
        init self.CallTokens[self.CallTokens.Length] = callToken;
        init self.CalleeNameTokens[self.CalleeNameTokens.Length] = calleeNameToken;
        init self.TargetKinds[self.TargetKinds.Length] = targetKind;
        init self.TargetDeclarationIndices[self.TargetDeclarationIndices.Length] = targetDeclarationIndex;
        init self.TargetSymbolIndices[self.TargetSymbolIndices.Length] = targetSymbolIndexPlusOne;
        init self.TargetNameTokens[self.TargetNameTokens.Length] = targetNameToken;
        init self.SignatureIndices[self.SignatureIndices.Length] = signatureIndexPlusOne;
        init self.ArgumentStarts[self.ArgumentStarts.Length] = argumentStartIndexPlusOne;
        init self.ArgumentCounts[self.ArgumentCounts.Length] = argumentCount;
        init self.ParameterCounts[self.ParameterCounts.Length] = parameterCount;
        init self.CallFlags[self.CallFlags.Length] = callFlags;
        init self.ReturnTypeKinds[self.ReturnTypeKinds.Length] = returnTypeKind;
        init self.ReturnTypeHeadTokens[self.ReturnTypeHeadTokens.Length] = returnTypeHeadToken;
        init self.ReturnTypePrimaryTokens[self.ReturnTypePrimaryTokens.Length] = returnTypePrimaryToken;
        init self.ReturnTypeStartTokens[self.ReturnTypeStartTokens.Length] = returnTypeStartToken;
        init self.ReturnTypeEndTokens[self.ReturnTypeEndTokens.Length] = returnTypeEndToken;
        init self.ReturnRangeStartTokens[self.ReturnRangeStartTokens.Length] = returnRangeStartToken;
        init self.ReturnRangeEndTokens[self.ReturnRangeEndTokens.Length] = returnRangeEndToken;
        init self.ReturnElementCountStartTokens[self.ReturnElementCountStartTokens.Length] = returnElementCountStartToken;
        init self.ReturnElementCountEndTokens[self.ReturnElementCountEndTokens.Length] = returnElementCountEndToken;
        init self.ReturnBitWidths[self.ReturnBitWidths.Length] = returnBitWidth;
        init self.ReturnTypeArgumentCounts[self.ReturnTypeArgumentCounts.Length] = returnTypeArgumentCount;
        init self.ReturnComptimeArgumentCounts[self.ReturnComptimeArgumentCounts.Length] = returnComptimeArgumentCount;
        init self.ReturnTypeFlags[self.ReturnTypeFlags.Length] = returnTypeFlags;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus AppendArgument(
        mut borrow TypedCallExpressionTable self,
        u32[0 max] callIndexPlusOne,
        u32[0 max] ordinal,
        u32[0 max] argumentNode,
        u32[0 max] argumentExpressionToken,
        TypedSignatureTypeKind expectedTypeKind,
        u32[0 max] expectedTypeHeadToken,
        u32[0 max] expectedTypePrimaryToken,
        u32[0 max] expectedTypeStartToken,
        u32[0 max] expectedTypeEndToken,
        u32[0 max] expectedRangeStartToken,
        u32[0 max] expectedRangeEndToken,
        u32[0 max] expectedElementCountStartToken,
        u32[0 max] expectedElementCountEndToken,
        u32[0 max] expectedBitWidth,
        u32[0 max] expectedTypeArgumentCount,
        u32[0 max] expectedComptimeArgumentCount,
        u32[0 max] expectedTypeFlags)
    {
        if (!self.ArgumentCallIndices.TryReserve(1)
            || !self.ArgumentOrdinals.TryReserve(1)
            || !self.ArgumentNodes.TryReserve(1)
            || !self.ArgumentExpressionTokens.TryReserve(1)
            || !self.ArgumentExpectedTypeKinds.TryReserve(1)
            || !self.ArgumentExpectedTypeHeadTokens.TryReserve(1)
            || !self.ArgumentExpectedTypePrimaryTokens.TryReserve(1)
            || !self.ArgumentExpectedTypeStartTokens.TryReserve(1)
            || !self.ArgumentExpectedTypeEndTokens.TryReserve(1)
            || !self.ArgumentExpectedRangeStartTokens.TryReserve(1)
            || !self.ArgumentExpectedRangeEndTokens.TryReserve(1)
            || !self.ArgumentExpectedElementCountStartTokens.TryReserve(1)
            || !self.ArgumentExpectedElementCountEndTokens.TryReserve(1)
            || !self.ArgumentExpectedBitWidths.TryReserve(1)
            || !self.ArgumentExpectedTypeArgumentCounts.TryReserve(1)
            || !self.ArgumentExpectedComptimeArgumentCounts.TryReserve(1)
            || !self.ArgumentExpectedTypeFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.ArgumentCallIndices[self.ArgumentCallIndices.Length] = callIndexPlusOne;
        init self.ArgumentOrdinals[self.ArgumentOrdinals.Length] = ordinal;
        init self.ArgumentNodes[self.ArgumentNodes.Length] = argumentNode;
        init self.ArgumentExpressionTokens[self.ArgumentExpressionTokens.Length] = argumentExpressionToken;
        init self.ArgumentExpectedTypeKinds[self.ArgumentExpectedTypeKinds.Length] = expectedTypeKind;
        init self.ArgumentExpectedTypeHeadTokens[self.ArgumentExpectedTypeHeadTokens.Length] = expectedTypeHeadToken;
        init self.ArgumentExpectedTypePrimaryTokens[self.ArgumentExpectedTypePrimaryTokens.Length] = expectedTypePrimaryToken;
        init self.ArgumentExpectedTypeStartTokens[self.ArgumentExpectedTypeStartTokens.Length] = expectedTypeStartToken;
        init self.ArgumentExpectedTypeEndTokens[self.ArgumentExpectedTypeEndTokens.Length] = expectedTypeEndToken;
        init self.ArgumentExpectedRangeStartTokens[self.ArgumentExpectedRangeStartTokens.Length] = expectedRangeStartToken;
        init self.ArgumentExpectedRangeEndTokens[self.ArgumentExpectedRangeEndTokens.Length] = expectedRangeEndToken;
        init self.ArgumentExpectedElementCountStartTokens[self.ArgumentExpectedElementCountStartTokens.Length] = expectedElementCountStartToken;
        init self.ArgumentExpectedElementCountEndTokens[self.ArgumentExpectedElementCountEndTokens.Length] = expectedElementCountEndToken;
        init self.ArgumentExpectedBitWidths[self.ArgumentExpectedBitWidths.Length] = expectedBitWidth;
        init self.ArgumentExpectedTypeArgumentCounts[self.ArgumentExpectedTypeArgumentCounts.Length] = expectedTypeArgumentCount;
        init self.ArgumentExpectedComptimeArgumentCounts[self.ArgumentExpectedComptimeArgumentCounts.Length] = expectedComptimeArgumentCount;
        init self.ArgumentExpectedTypeFlags[self.ArgumentExpectedTypeFlags.Length] = expectedTypeFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}

public enum TypedMemberContext
{
    GlobalInitializer,
    FunctionBody,
    Unknown,
}

public enum TypedMemberReceiverKind
{
    Value,
    StaticType,
    Unknown,
}

public enum TypedMemberTargetKind
{
    Field,
    InstanceMethod,
    StaticMethod,
    Unknown,
}

internal inline finite law u32[0 max] TypedMemberFlagReceiverResolved()
{
    return 1;
}

internal inline finite law u32[0 max] TypedMemberFlagResolved()
{
    return 2;
}

internal inline finite law u32[0 max] TypedMemberFlagField()
{
    return 4;
}

internal inline finite law u32[0 max] TypedMemberFlagMethodCandidate()
{
    return 8;
}

internal inline finite law bool TypedMemberFlagPresent(u32[0 max] flags, u32[0 max] flag)
{
    return (flags & flag) != 0;
}

