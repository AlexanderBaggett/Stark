}

internal fn void TypedCallFactsFromLiteral(
    borrow TypedLiteralExpressionTable literals,
    u32[0 max] literalIndexPlusOne,
    mut borrow TypedCallTypeFacts facts)
{
    if (literalIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(literalIndexPlusOne - 1);
    facts.TypeKind = literals.TypeKindAt(index);
    facts.TypePrimaryToken = literals.LiteralTokenAt(index);
    facts.TypeStartToken = literals.LiteralTokenAt(index);
    facts.TypeEndToken = (u32[0 max])(literals.LiteralTokenAt(index) + 1);
    facts.BitWidth = literals.BitWidthAt(index);
    facts.TypeFlags = literals.TypeFlagsAt(index);
    facts.IsCompileTimeInteger = literals.IsCompileTimeIntegerAt(index);
    facts.IsNullLiteral = literals.LiteralKindAt(index) == TypedLiteralKind.Null;
}

internal fn void TypedCallFactsFromIdentifier(
    borrow TypedIdentifierExpressionTable identifiers,
    u32[0 max] identifierIndexPlusOne,
    mut borrow TypedCallTypeFacts facts)
{
    if (identifierIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(identifierIndexPlusOne - 1);
    facts.TypeKind = identifiers.TypeKindAt(index);
    facts.TypeHeadToken = identifiers.TypeHeadTokenAt(index);
    facts.TypePrimaryToken = identifiers.TypePrimaryTokenAt(index);
    facts.TypeStartToken = identifiers.TypeStartTokenAt(index);
    facts.TypeEndToken = identifiers.TypeEndTokenAt(index);
    facts.RangeStartToken = identifiers.RangeStartTokenAt(index);
    facts.RangeEndToken = identifiers.RangeEndTokenAt(index);
    facts.ElementCountStartToken = identifiers.ElementCountStartTokenAt(index);
    facts.ElementCountEndToken = identifiers.ElementCountEndTokenAt(index);
    facts.BitWidth = identifiers.BitWidthAt(index);
    facts.TypeArgumentCount = identifiers.TypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = identifiers.ComptimeArgumentCountAt(index);
    facts.TypeFlags = identifiers.TypeFlagsAt(index);
}

internal fn void TypedCallFactsFromCallReturn(
    borrow TypedCallExpressionTable calls,
    u32[0 max] callIndexPlusOne,
    mut borrow TypedCallTypeFacts facts)
{
    if (callIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(callIndexPlusOne - 1);
    facts.TypeKind = calls.ReturnTypeKindAt(index);
    facts.TypeHeadToken = calls.ReturnTypeHeadTokenAt(index);
    facts.TypePrimaryToken = calls.ReturnTypePrimaryTokenAt(index);
    facts.TypeStartToken = calls.ReturnTypeStartTokenAt(index);
    facts.TypeEndToken = calls.ReturnTypeEndTokenAt(index);
    facts.RangeStartToken = calls.ReturnRangeStartTokenAt(index);
    facts.RangeEndToken = calls.ReturnRangeEndTokenAt(index);
    facts.ElementCountStartToken = calls.ReturnElementCountStartTokenAt(index);
    facts.ElementCountEndToken = calls.ReturnElementCountEndTokenAt(index);
    facts.BitWidth = calls.ReturnBitWidthAt(index);
    facts.TypeArgumentCount = calls.ReturnTypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = calls.ReturnComptimeArgumentCountAt(index);
    facts.TypeFlags = calls.ReturnTypeFlagsAt(index);
}

internal fn void TypedCallFactsFromTypeSpan(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    mut borrow TypedCallTypeFacts facts)
{
    if (typeStartToken == 0 || typeEndToken <= typeStartToken)
    {
        return;
    }

    TypedCallTypeSpanFacts(
        source,
        stream,
        typeStartToken,
        typeEndToken,
        facts.TypeKind,
        facts.TypeHeadToken,
        facts.TypePrimaryToken,
        facts.RangeStartToken,
        facts.RangeEndToken,
        facts.ElementCountStartToken,
        facts.ElementCountEndToken,
        facts.BitWidth,
        facts.TypeArgumentCount,
        facts.ComptimeArgumentCount,
        facts.TypeFlags);
    facts.TypeStartToken = typeStartToken;
    facts.TypeEndToken = typeEndToken;
}

internal fn void TypedCallFactsFromNewTypeToken(u32[0 max] typeNameToken, mut borrow TypedCallTypeFacts facts)
{
    if (typeNameToken == 0)
    {
        return;
    }

    facts.TypeKind = TypedSignatureTypeKind.Named;
    facts.TypeHeadToken = typeNameToken;
    facts.TypePrimaryToken = typeNameToken;
    facts.TypeStartToken = typeNameToken;
    facts.TypeEndToken = (u32[0 max])(typeNameToken + 1);
}

internal fn void TypedCallBoolFacts(u32[0 max] token, mut borrow TypedCallTypeFacts facts)
{
    facts.TypeKind = TypedSignatureTypeKind.Bool;
    facts.TypePrimaryToken = token;
    facts.TypeStartToken = token;
    facts.TypeEndToken = (u32[0 max])(token + 1);
}

internal fn void TypedCallArgumentFactsFromTreeNode(
    ascii source,
    borrow TokenStream stream,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow ExprTree tree,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node,
    mut borrow TypedCallTypeFacts facts)
{
    stack mut u32[0 max] current = node;
    stack mut u32[0 max] fallback = 0;
    stack mut u64[0 2 ** 63 - 1] guard = (u64[0 2 ** 63 - 1])(tree.Count() + 1);
    while willexit (guard > 0 && current != 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack ExprKind kind = tree.NodeKindAt(current);
        if (kind == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] identifierIndexPlusOne = TypedCallIdentifierIndexForNode(
                identifiers,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromIdentifier(identifiers, identifierIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] callIndexPlusOne = TypedCallPriorCallIndexForNode(
                calls,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromCallReturn(calls, callIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Conversion)
        {
            TypedCallFactsFromTypeSpan(source, stream, (u32[0 max])(tree.TokenAt(current) + 1), tree.AuxAt(current), facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.New)
        {
            stack u32[0 max] typeNode = tree.LeftAt(current);
            if (typeNode != 0 && tree.NodeKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
            {
                TypedCallFactsFromNewTypeToken(tree.TokenAt(typeNode), facts);
            }

            return;
        }

        if (TypedLiteralExprKindIsLiteral(kind))
        {
            stack u32[0 max] literalIndexPlusOne = TypedCallLiteralIndexForNode(
                literals,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromLiteral(literals, literalIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Binary)
        {
            stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])tree.TokenAt(current));
            if (IsBooleanOperator(op))
            {
                TypedCallBoolFacts(tree.TokenAt(current), facts);
                return;
            }

            fallback = tree.RightAt(current);
            current = tree.LeftAt(current);
        }
        else if (kind == Compiler.Parsing.ExprKind.Unary)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])tree.TokenAt(current)) == TokenKind.Bang)
            {
                TypedCallBoolFacts(tree.TokenAt(current), facts);
                return;
            }

            current = tree.LeftAt(current);
        }
        else if (kind == Compiler.Parsing.ExprKind.Conditional || kind == Compiler.Parsing.ExprKind.Assign)
        {
            current = tree.RightAt(current);
        }
        else if (fallback != 0)
        {
            current = fallback;
            fallback = 0;
        }
        else
        {
            current = 0;
        }
    }
}

internal fn void TypedCallArgumentFactsFromBodyNode(
    ascii source,
    borrow TokenStream stream,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow StatementList body,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node,
    mut borrow TypedCallTypeFacts facts)
{
    stack mut u32[0 max] current = node;
    stack mut u32[0 max] fallback = 0;
    stack mut u64[0 2 ** 63 - 1] guard = (u64[0 2 ** 63 - 1])(body.ExprNodeCount() + 1);
    while willexit (guard > 0 && current != 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack ExprKind kind = body.ExprKindAt(current);
        if (kind == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] identifierIndexPlusOne = TypedCallIdentifierIndexForNode(
                identifiers,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromIdentifier(identifiers, identifierIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] callIndexPlusOne = TypedCallPriorCallIndexForNode(
                calls,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromCallReturn(calls, callIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Conversion)
        {
            TypedCallFactsFromTypeSpan(source, stream, (u32[0 max])(body.ExprTokenAt(current) + 1), body.ExprAuxAt(current), facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.New)
        {
            stack u32[0 max] typeNode = body.ExprLeftAt(current);
            if (typeNode != 0 && body.ExprKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
            {
                TypedCallFactsFromNewTypeToken(body.ExprTokenAt(typeNode), facts);
            }

            return;
        }

        if (TypedLiteralExprKindIsLiteral(kind))
        {
            stack u32[0 max] literalIndexPlusOne = TypedCallLiteralIndexForNode(
                literals,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromLiteral(literals, literalIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Binary)
        {
            stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(current));
            if (IsBooleanOperator(op))
            {
                TypedCallBoolFacts(body.ExprTokenAt(current), facts);
                return;
            }

            fallback = body.ExprRightAt(current);
            current = body.ExprLeftAt(current);
        }
        else if (kind == Compiler.Parsing.ExprKind.Unary)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(current)) == TokenKind.Bang)
            {
                TypedCallBoolFacts(body.ExprTokenAt(current), facts);
                return;
            }

            current = body.ExprLeftAt(current);
        }
        else if (kind == Compiler.Parsing.ExprKind.Conditional || kind == Compiler.Parsing.ExprKind.Assign)
        {
            current = body.ExprRightAt(current);
        }
        else if (fallback != 0)
        {
            current = fallback;
            fallback = 0;
        }
        else
        {
            current = 0;
        }
    }
}

internal finite law bool TypedCallTypeFlagEqual(u32[0 max] leftFlags, u32[0 max] rightFlags, u32[0 max] flag)
{
    return TypedSignatureFlagPresent(leftFlags, flag) == TypedSignatureFlagPresent(rightFlags, flag);
}

internal fn bool TypedCallTypeFactsExact(ascii source, borrow TokenStream stream, borrow TypedCallTypeFacts parameter, borrow TypedCallTypeFacts argument)
{
    if (parameter.TypeKind == TypedSignatureTypeKind.Unknown || argument.TypeKind == TypedSignatureTypeKind.Unknown)
    {
        return false;
    }

    if (parameter.TypeKind != argument.TypeKind)
    {
        return false;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Integer)
    {
        return parameter.BitWidth == argument.BitWidth
            && TypedCallTypeFlagEqual(parameter.TypeFlags, argument.TypeFlags, TypedSignatureTypeFlagIntegerSigned())
            && TypedCallTypeFlagEqual(parameter.TypeFlags, argument.TypeFlags, TypedSignatureTypeFlagIntegerUnsigned());
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Float)
    {
        return parameter.BitWidth == argument.BitWidth;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Bool || parameter.TypeKind == TypedSignatureTypeKind.Void)
    {
        return true;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Text)
    {
        return TypedCallTypeFlagEqual(parameter.TypeFlags, argument.TypeFlags, TypedSignatureTypeFlagOwnedText())
            && TypedCallTypeFlagEqual(parameter.TypeFlags, argument.TypeFlags, TypedSignatureTypeFlagUnicodeText());
    }

    if (parameter.TypePrimaryToken != 0 && argument.TypePrimaryToken != 0
        && stream.KindAt((u64[0 2 ** 63 - 1])parameter.TypePrimaryToken) != stream.KindAt((u64[0 2 ** 63 - 1])argument.TypePrimaryToken))
    {
        return false;
    }

    if (parameter.TypeHeadToken != 0 || argument.TypeHeadToken != 0)
    {
        if (parameter.TypeHeadToken == 0 || argument.TypeHeadToken == 0)
        {
            return false;
        }

        if (!TypedSignatureTokenTextEqualsToken(source, stream, parameter.TypeHeadToken, argument.TypeHeadToken))
        {
            return false;
        }
    }

    return parameter.TypeArgumentCount == argument.TypeArgumentCount
        && parameter.ComptimeArgumentCount == argument.ComptimeArgumentCount
        && TypedCallTypeFlagEqual(parameter.TypeFlags, argument.TypeFlags, TypedSignatureTypeFlagRawMutablePointer());
}

internal finite law bool TypedCallTypeFactsIsUnsigned(borrow TypedCallTypeFacts facts)
{
    return TypedSignatureFlagPresent(facts.TypeFlags, TypedSignatureTypeFlagIntegerUnsigned());
}

internal finite law bool TypedCallTypeFactsIsSigned(borrow TypedCallTypeFacts facts)
{
    return TypedSignatureFlagPresent(facts.TypeFlags, TypedSignatureTypeFlagIntegerSigned());
}

internal fn bool TypedCallCanBindArgument(ascii source, borrow TokenStream stream, borrow TypedCallTypeFacts parameter, borrow TypedCallTypeFacts argument)
{
    if (TypedCallTypeFactsExact(source, stream, parameter, argument))
    {
        return true;
    }

    if (argument.IsNullLiteral)
    {
        return parameter.TypeKind == TypedSignatureTypeKind.RawPointer
            || parameter.TypeKind == TypedSignatureTypeKind.Dynamic
            || parameter.TypeKind == TypedSignatureTypeKind.FunctionPointer
            || parameter.TypeKind == TypedSignatureTypeKind.Closure
            || parameter.TypeKind == TypedSignatureTypeKind.Slice
            || parameter.TypeKind == TypedSignatureTypeKind.Named;
    }

    if (argument.TypeKind == TypedSignatureTypeKind.Unknown)
    {
        return true;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.GenericParameter)
    {
        return true;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Dynamic)
    {
        return argument.TypeKind != TypedSignatureTypeKind.Void;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Integer && argument.TypeKind == TypedSignatureTypeKind.Integer)
    {
        if (argument.IsCompileTimeInteger)
        {
            return parameter.BitWidth == 0 || argument.BitWidth == 0 || argument.BitWidth <= parameter.BitWidth;
        }

        if (parameter.BitWidth == 0 || argument.BitWidth == 0)
        {
            return true;
        }

        if (argument.BitWidth > parameter.BitWidth)
        {
            return false;
        }

        if (TypedCallTypeFactsIsSigned(argument) && TypedCallTypeFactsIsUnsigned(parameter))
        {
            return false;
        }

        return true;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Float && argument.TypeKind == TypedSignatureTypeKind.Float)
    {
        return parameter.BitWidth == 0 || argument.BitWidth == 0 || argument.BitWidth <= parameter.BitWidth;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Float && argument.TypeKind == TypedSignatureTypeKind.Integer)
    {
        return true;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Text && argument.TypeKind == TypedSignatureTypeKind.Text)
    {
        return true;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.RawPointer && argument.TypeKind == TypedSignatureTypeKind.RawPointer)
    {
        return true;
    }

    return false;
}

internal fn u32[0 max] TypedCallArgumentBindingCost(ascii source, borrow TokenStream stream, borrow TypedCallTypeFacts parameter, borrow TypedCallTypeFacts argument)
{
    if (TypedCallTypeFactsExact(source, stream, parameter, argument))
    {
        return 0;
    }

    if (argument.TypeKind == TypedSignatureTypeKind.Unknown)
    {
        return 100000;
    }

    if (argument.IsNullLiteral)
    {
        return 1000;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.GenericParameter)
    {
        return 5000;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Dynamic)
    {
        return 8000;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Integer && argument.TypeKind == TypedSignatureTypeKind.Integer)
    {
        stack mut u32[0 max] widthCost = 128;
        if (parameter.BitWidth >= argument.BitWidth)
        {
            widthCost = (u32[0 max])(parameter.BitWidth - argument.BitWidth);
        }

        stack mut u32[0 max] signednessCost = 0;
        if (!TypedCallTypeFlagEqual(parameter.TypeFlags, argument.TypeFlags, TypedSignatureTypeFlagIntegerSigned())
            || !TypedCallTypeFlagEqual(parameter.TypeFlags, argument.TypeFlags, TypedSignatureTypeFlagIntegerUnsigned()))
        {
            signednessCost = 64;
        }

        return (u32[0 max])(10 + widthCost + signednessCost);
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Float && argument.TypeKind == TypedSignatureTypeKind.Float)
    {
        stack mut u32[0 max] widthCost = 128;
        if (parameter.BitWidth >= argument.BitWidth)
        {
            widthCost = (u32[0 max])(parameter.BitWidth - argument.BitWidth);
        }

        return (u32[0 max])(100 + widthCost);
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Float && argument.TypeKind == TypedSignatureTypeKind.Integer)
    {
        return (u32[0 max])(1000 + argument.BitWidth);
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.Text && argument.TypeKind == TypedSignatureTypeKind.Text)
    {
        return 100;
    }

    if (parameter.TypeKind == TypedSignatureTypeKind.RawPointer && argument.TypeKind == TypedSignatureTypeKind.RawPointer)
    {
        return 100;
    }

    return 10000;
}

internal fn bool TypedCallOwnerTokenEquals(ascii source, borrow TokenStream stream, u32[0 max] left, u32[0 max] right)
{
    if (left == 0 || right == 0)
    {
        return left == right;
    }

    return TypedSignatureTokenTextEqualsToken(source, stream, left, right);
}

internal fn bool TypedCallSignatureMatchesOverloadBase(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    u32[0 max] baseSignatureIndexPlusOne,
    u64[0 2 ** 63 - 1] candidateIndex)
{
    if (baseSignatureIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] baseIndex = (u64[0 2 ** 63 - 1])(baseSignatureIndexPlusOne - 1);
    return signatures.OwnerKindAt(candidateIndex) == signatures.OwnerKindAt(baseIndex)
        && TypedCallOwnerTokenEquals(source, stream, signatures.OwnerNameTokenAt(candidateIndex), signatures.OwnerNameTokenAt(baseIndex))
        && TypedSignatureTokenTextEqualsToken(source, stream, signatures.NameTokenAt(candidateIndex), signatures.NameTokenAt(baseIndex));
}

internal fn bool TypedCallCandidateScoreFromTree(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow ExprTree tree,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u64[0 2 ** 63 - 1] signatureIndex,
    u32[0 max] parameterOffset,
    out u32[0 max] score)
{
    score = 0;
    stack u32[0 max] argumentCount = tree.CallArgCount(callNode);
    if (signatures.ParamCountAt(signatureIndex) != (u32[0 max])(argumentCount + parameterOffset))
    {
        return false;
    }

    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack mut TypedCallTypeFacts parameter = new();
        TypedCallFactsFromSignatureSlot(signatures, signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset)), parameter);

        stack mut TypedCallTypeFacts argument = new();
        TypedCallArgumentFactsFromTreeNode(
            source,
            stream,
            literals,
            identifiers,
            calls,
            tree,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            tree.CallArgAt(callNode, ordinal),
            argument);

        if (!TypedCallCanBindArgument(source, stream, parameter, argument))
        {
            return false;
        }

        score = (u32[0 max])(score + TypedCallArgumentBindingCost(source, stream, parameter, argument));
        ordinal = (u32[0 max])(ordinal + 1);
    }

    score = (u32[0 max])(score
        + (signatures.GenericParamCountAt(signatureIndex) * 1000)
        + (signatures.ComptimeGenericParamCountAt(signatureIndex) * 1000));
    return true;
}

internal fn bool TypedCallCandidateScoreFromBody(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow StatementList body,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u64[0 2 ** 63 - 1] signatureIndex,
    u32[0 max] parameterOffset,
    out u32[0 max] score)
{
    score = 0;
    stack u32[0 max] argumentCount = body.ExprCallArgCountAt(callNode);
    if (signatures.ParamCountAt(signatureIndex) != (u32[0 max])(argumentCount + parameterOffset))
    {
        return false;
    }

    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack mut TypedCallTypeFacts parameter = new();
        TypedCallFactsFromSignatureSlot(signatures, signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset)), parameter);

        stack mut TypedCallTypeFacts argument = new();
        TypedCallArgumentFactsFromBodyNode(
            source,
            stream,
            literals,
            identifiers,
            calls,
            body,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            body.ExprCallArgAt(callNode, ordinal),
            argument);

        if (!TypedCallCanBindArgument(source, stream, parameter, argument))
        {
            return false;
        }

        score = (u32[0 max])(score + TypedCallArgumentBindingCost(source, stream, parameter, argument));
        ordinal = (u32[0 max])(ordinal + 1);
    }

    score = (u32[0 max])(score
        + (signatures.GenericParamCountAt(signatureIndex) * 1000)
        + (signatures.ComptimeGenericParamCountAt(signatureIndex) * 1000));
    return true;
}

internal fn u32[0 max] TypedCallResolveDirectOverload(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow ExprTree tree,
    borrow StatementList body,
    bool useBody,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u32[0 max] baseSignatureIndexPlusOne,
    out u32[0 max] candidateCount,
    out u32[0 max] viableCandidateCount,
    out u32[0 max] bestCandidateCount)
{
    candidateCount = 0;
    viableCandidateCount = 0;
    bestCandidateCount = 0;
    stack mut u32[0 max] selectedSignatureIndexPlusOne = 0;
    stack mut u32[0 max] bestScore = 0;
    stack u64[0 2 ** 63 - 1] signatureCount = signatures.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < signatureCount; index += 1)
    {
        if (TypedCallSignatureMatchesOverloadBase(source, stream, signatures, baseSignatureIndexPlusOne, index))
        {
            candidateCount = (u32[0 max])(candidateCount + 1);
            stack mut u32[0 max] score = 0;
            stack mut bool viable = false;
            if (useBody)
            {
                viable = TypedCallCandidateScoreFromBody(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    body,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    index,
                    0,
                    score);
            }
            else
            {
                viable = TypedCallCandidateScoreFromTree(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    tree,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    index,
                    0,
                    score);
            }

            if (viable)
            {
                viableCandidateCount = (u32[0 max])(viableCandidateCount + 1);
                if (selectedSignatureIndexPlusOne == 0 || score < bestScore)
                {
                    selectedSignatureIndexPlusOne = (u32[0 max])(index + 1);
                    bestScore = score;
                    bestCandidateCount = 1;
                }
                else if (score == bestScore)
                {
                    bestCandidateCount = (u32[0 max])(bestCandidateCount + 1);
                }
            }
        }
    }

    if (bestCandidateCount == 1)
    {
        return selectedSignatureIndexPlusOne;
    }

    return 0;
}

internal fn u32[0 max] TypedCallMethodParameterOffset(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    u64[0 2 ** 63 - 1] signatureIndex,
    TypedMemberTargetKind candidateKind,
    u32[0 max] ownerNameToken)
{
    if (candidateKind != TypedMemberTargetKind.InstanceMethod || signatures.ParamCountAt(signatureIndex) == 0)
    {
        return 0;
    }

    stack u32[0 max] firstSlotIndexPlusOne = signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, 0);
    if (firstSlotIndexPlusOne == 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] firstSlot = (u64[0 2 ** 63 - 1])(firstSlotIndexPlusOne - 1);
    stack u32[0 max] firstParamNameToken = signatures.TypeSlotParamNameTokenAt(firstSlot);
    stack u32[0 max] firstTypeHeadToken = signatures.TypeHeadTokenAt(firstSlot);
    if (firstParamNameToken == 0
        || firstTypeHeadToken == 0
        || ownerNameToken == 0
        || !TypedSignatureTokenTextEquals(source, stream, firstParamNameToken, "self")
        || !TypedSignatureTokenTextEqualsToken(source, stream, firstTypeHeadToken, ownerNameToken))
    {
        return 0;
    }

    return 1;
}

internal fn u32[0 max] TypedCallResolveMethodOverload(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow ExprTree tree,
    borrow StatementList body,
    bool useBody,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u32[0 max] memberIndexPlusOne,
    out u32[0 max] selectedParameterOffset,
    out u32[0 max] candidateCount,
    out u32[0 max] viableCandidateCount,
    out u32[0 max] bestCandidateCount)
{
    selectedParameterOffset = 0;
    candidateCount = 0;
    viableCandidateCount = 0;
    bestCandidateCount = 0;
    if (memberIndexPlusOne == 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] memberIndex = (u64[0 2 ** 63 - 1])(memberIndexPlusOne - 1);
    stack u32[0 max] candidateStartIndexPlusOne = members.CandidateStartIndexPlusOneAt(memberIndex);
    candidateCount = members.CandidateCountAt(memberIndex);
    if (candidateStartIndexPlusOne == 0 || candidateCount == 0)
    {
        return 0;
    }

    stack mut u32[0 max] methodOwnerNameToken = members.ReceiverTypeHeadTokenAt(memberIndex);
    if (methodOwnerNameToken == 0)
    {
        methodOwnerNameToken = members.ReceiverNameTokenAt(memberIndex);
    }

    stack mut u32[0 max] selectedSignatureIndexPlusOne = 0;
    stack mut u32[0 max] bestScore = 0;
    stack mut u32[0 max] bestParameterOffset = 0;
    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < candidateCount)
    {
        stack u64[0 2 ** 63 - 1] candidateIndex = (u64[0 2 ** 63 - 1])(candidateStartIndexPlusOne - 1 + ordinal);
        stack u32[0 max] candidateSignatureIndexPlusOne = members.CandidateSignatureIndexPlusOneAt(candidateIndex);
        if (candidateSignatureIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] candidateSignatureIndex = (u64[0 2 ** 63 - 1])(candidateSignatureIndexPlusOne - 1);
            stack u32[0 max] parameterOffset = TypedCallMethodParameterOffset(
                source,
                stream,
                signatures,
                candidateSignatureIndex,
                members.CandidateKindAt(candidateIndex),
                methodOwnerNameToken);
            stack mut u32[0 max] score = 0;
            stack mut bool viable = false;
            if (useBody)
            {
                viable = TypedCallCandidateScoreFromBody(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    body,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    candidateSignatureIndex,
                    parameterOffset,
                    score);
            }
            else
            {
                viable = TypedCallCandidateScoreFromTree(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    tree,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    candidateSignatureIndex,
                    parameterOffset,
                    score);
            }

            if (viable)
            {
                viableCandidateCount = (u32[0 max])(viableCandidateCount + 1);
                if (selectedSignatureIndexPlusOne == 0 || score < bestScore)
                {
                    selectedSignatureIndexPlusOne = candidateSignatureIndexPlusOne;
                    bestScore = score;
                    bestCandidateCount = 1;
                    bestParameterOffset = parameterOffset;
                }
                else if (score == bestScore)
                {
                    bestCandidateCount = (u32[0 max])(bestCandidateCount + 1);
                }
            }
        }

        ordinal = (u32[0 max])(ordinal + 1);
    }

    if (bestCandidateCount == 1)
    {
        selectedParameterOffset = bestParameterOffset;
        return selectedSignatureIndexPlusOne;
    }

    return 0;
}

internal fn System.Memory.MemoryStatus AppendTypedCallArgumentsFromTree(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow ExprTree tree,
    u32[0 max] callNode,
    u32[0 max] callIndexPlusOne,
    u32[0 max] signatureIndexPlusOne,
    u32[0 max] parameterOffset,
    u32[0 max] callableTypeStartToken,
    u32[0 max] callableTypeEndToken)
{
    stack u32[0 max] argumentCount = tree.CallArgCount(callNode);
    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack u32[0 max] argumentNode = tree.CallArgAt(callNode, ordinal);
        stack mut u32[0 max] parameterSlotIndexPlusOne = 0;
        if (signatureIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] signatureIndex = (u64[0 2 ** 63 - 1])(signatureIndexPlusOne - 1);
            parameterSlotIndexPlusOne = signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset));
        }

        stack mut TypedSignatureTypeKind expectedTypeKind = TypedSignatureTypeKind.Unknown;
        stack mut u32[0 max] expectedTypeHeadToken = 0;
        stack mut u32[0 max] expectedTypePrimaryToken = 0;
        stack mut u32[0 max] expectedTypeStartToken = 0;
        stack mut u32[0 max] expectedTypeEndToken = 0;
        stack mut u32[0 max] expectedRangeStartToken = 0;
        stack mut u32[0 max] expectedRangeEndToken = 0;
        stack mut u32[0 max] expectedElementCountStartToken = 0;
        stack mut u32[0 max] expectedElementCountEndToken = 0;
        stack mut u32[0 max] expectedBitWidth = 0;
        stack mut u32[0 max] expectedTypeArgumentCount = 0;
        stack mut u32[0 max] expectedComptimeArgumentCount = 0;
        stack mut u32[0 max] expectedTypeFlags = 0;
        TypedCallSignatureSlotFacts(
            signatures,
            parameterSlotIndexPlusOne,
            expectedTypeKind,
            expectedTypeHeadToken,
            expectedTypePrimaryToken,
            expectedTypeStartToken,
            expectedTypeEndToken,
            expectedRangeStartToken,
            expectedRangeEndToken,
            expectedElementCountStartToken,
            expectedElementCountEndToken,
            expectedBitWidth,
            expectedTypeArgumentCount,
            expectedComptimeArgumentCount,
            expectedTypeFlags);
        if (parameterSlotIndexPlusOne == 0 && callableTypeStartToken != 0)
        {
            TypedCallCallableParameterFacts(
                source,
                stream,
                callableTypeStartToken,
                callableTypeEndToken,
                ordinal,
                expectedTypeKind,
                expectedTypeHeadToken,
                expectedTypePrimaryToken,
                expectedTypeStartToken,
                expectedTypeEndToken,
                expectedRangeStartToken,
                expectedRangeEndToken,
                expectedElementCountStartToken,
                expectedElementCountEndToken,
                expectedBitWidth,
                expectedTypeArgumentCount,
                expectedComptimeArgumentCount,
                expectedTypeFlags);
        }

        switch (table.AppendArgument(
            callIndexPlusOne,
            ordinal,
            argumentNode,
            tree.TokenAt(argumentNode),
            expectedTypeKind,
            expectedTypeHeadToken,
            expectedTypePrimaryToken,
            expectedTypeStartToken,
            expectedTypeEndToken,
            expectedRangeStartToken,
            expectedRangeEndToken,
            expectedElementCountStartToken,
            expectedElementCountEndToken,
            expectedBitWidth,
            expectedTypeArgumentCount,
            expectedComptimeArgumentCount,
            expectedTypeFlags))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }

        ordinal = (u32[0 max])(ordinal + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallArgumentsFromBody(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow StatementList body,
    u32[0 max] callNode,
    u32[0 max] callIndexPlusOne,
    u32[0 max] signatureIndexPlusOne,
    u32[0 max] parameterOffset,
    u32[0 max] callableTypeStartToken,
    u32[0 max] callableTypeEndToken)
{
    stack u32[0 max] argumentCount = body.ExprCallArgCountAt(callNode);
    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack u32[0 max] argumentNode = body.ExprCallArgAt(callNode, ordinal);
        stack mut u32[0 max] parameterSlotIndexPlusOne = 0;
        if (signatureIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] signatureIndex = (u64[0 2 ** 63 - 1])(signatureIndexPlusOne - 1);
            parameterSlotIndexPlusOne = signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset));
        }

        stack mut TypedSignatureTypeKind expectedTypeKind = TypedSignatureTypeKind.Unknown;
        stack mut u32[0 max] expectedTypeHeadToken = 0;
        stack mut u32[0 max] expectedTypePrimaryToken = 0;
        stack mut u32[0 max] expectedTypeStartToken = 0;
        stack mut u32[0 max] expectedTypeEndToken = 0;
        stack mut u32[0 max] expectedRangeStartToken = 0;
        stack mut u32[0 max] expectedRangeEndToken = 0;
        stack mut u32[0 max] expectedElementCountStartToken = 0;
        stack mut u32[0 max] expectedElementCountEndToken = 0;
        stack mut u32[0 max] expectedBitWidth = 0;
        stack mut u32[0 max] expectedTypeArgumentCount = 0;
        stack mut u32[0 max] expectedComptimeArgumentCount = 0;
        stack mut u32[0 max] expectedTypeFlags = 0;
        TypedCallSignatureSlotFacts(
            signatures,
            parameterSlotIndexPlusOne,
            expectedTypeKind,
            expectedTypeHeadToken,
            expectedTypePrimaryToken,
            expectedTypeStartToken,
            expectedTypeEndToken,
            expectedRangeStartToken,
            expectedRangeEndToken,
            expectedElementCountStartToken,
            expectedElementCountEndToken,
            expectedBitWidth,
            expectedTypeArgumentCount,
            expectedComptimeArgumentCount,
            expectedTypeFlags);
        if (parameterSlotIndexPlusOne == 0 && callableTypeStartToken != 0)
        {
            TypedCallCallableParameterFacts(
                source,
                stream,
                callableTypeStartToken,
                callableTypeEndToken,
                ordinal,
                expectedTypeKind,
                expectedTypeHeadToken,
                expectedTypePrimaryToken,
                expectedTypeStartToken,
                expectedTypeEndToken,
                expectedRangeStartToken,
                expectedRangeEndToken,
                expectedElementCountStartToken,
                expectedElementCountEndToken,
                expectedBitWidth,
                expectedTypeArgumentCount,
                expectedComptimeArgumentCount,
                expectedTypeFlags);
        }

        switch (table.AppendArgument(
            callIndexPlusOne,
            ordinal,
            argumentNode,
            body.ExprTokenAt(argumentNode),
            expectedTypeKind,
            expectedTypeHeadToken,
            expectedTypePrimaryToken,
            expectedTypeStartToken,
            expectedTypeEndToken,
            expectedRangeStartToken,
            expectedRangeEndToken,
            expectedElementCountStartToken,
            expectedElementCountEndToken,
            expectedBitWidth,
            expectedTypeArgumentCount,
            expectedComptimeArgumentCount,
            expectedTypeFlags))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }

        ordinal = (u32[0 max])(ordinal + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallExpression(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    borrow ExprTree tree,
    borrow StatementList body,
    bool useBody,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u32[0 max] calleeNode,
    u32[0 max] callToken,
    u32[0 max] calleeNameToken,
    u32[0 max] argumentCount,
    bool calleeIsIdentifier,
    out u32[0 max] callIndexPlusOne,
    out u32[0 max] signatureIndexPlusOne,
    out u32[0 max] parameterOffset,
    out u32[0 max] callableTypeStartToken,
    out u32[0 max] callableTypeEndToken)
{
    callIndexPlusOne = 0;
    signatureIndexPlusOne = 0;
    parameterOffset = 0;
    callableTypeStartToken = 0;
    callableTypeEndToken = 0;
    stack mut u32[0 max] resolvedSignatureIndexPlusOne = 0;
    stack mut u32[0 max] resolvedCallableTypeStartToken = 0;
    stack mut u32[0 max] resolvedCallableTypeEndToken = 0;
    stack mut TypedCallTargetKind targetKind = TypedCallTargetKind.NonIdentifier;
    stack mut u32[0 max] targetDeclarationIndex = 0;
    stack mut u32[0 max] targetSymbolIndexPlusOne = 0;
    stack mut u32[0 max] targetNameToken = 0;
    stack mut u32[0 max] parameterCount = 0;
    stack mut u32[0 max] overloadCandidateCount = 0;
    stack mut u32[0 max] overloadViableCandidateCount = 0;
    stack mut u32[0 max] overloadBestCandidateCount = 0;
    stack mut u32[0 max] flags = 0;
    if (calleeIsIdentifier)
    {
        targetKind = TypedCallTargetKind.Unknown;
        stack u32[0 max] identifierIndexPlusOne = TypedCallIdentifierIndexForNode(
            identifiers,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            calleeNode);
        if (identifierIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] identifierIndex = (u64[0 2 ** 63 - 1])(identifierIndexPlusOne - 1);
            targetDeclarationIndex = identifiers.TargetDeclarationIndexAt(identifierIndex);
            targetSymbolIndexPlusOne = identifiers.TargetSymbolIndexPlusOneAt(identifierIndex);
            targetNameToken = identifiers.TargetNameTokenAt(identifierIndex);
            if (identifiers.TargetKindAt(identifierIndex) == TypedIdentifierTargetKind.Function)
            {
                targetKind = TypedCallTargetKind.DirectFunction;
                resolvedSignatureIndexPlusOne = TypedCallResolveDirectOverload(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    table,
                    tree,
                    body,
                    useBody,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    targetSymbolIndexPlusOne,
                    overloadCandidateCount,
                    overloadViableCandidateCount,
                    overloadBestCandidateCount);
                flags = flags | TypedCallFlagDirect();
                if (resolvedSignatureIndexPlusOne != 0)
                {
                    targetSymbolIndexPlusOne = resolvedSignatureIndexPlusOne;
                    flags = flags | TypedCallFlagResolved() | TypedCallFlagOverloadResolved();
                }
                else if (overloadViableCandidateCount == 0)
                {
                    flags = flags | TypedCallFlagOverloadNoMatch();
                }
                else
                {
                    flags = flags | TypedCallFlagOverloadAmbiguous();
                }
            }
            else if (identifiers.TypeKindAt(identifierIndex) == TypedSignatureTypeKind.FunctionPointer)
            {
                targetKind = TypedCallTargetKind.FunctionPointerValue;
                resolvedCallableTypeStartToken = identifiers.TypeStartTokenAt(identifierIndex);
                resolvedCallableTypeEndToken = identifiers.TypeEndTokenAt(identifierIndex);
                flags = flags | TypedCallFlagResolved() | TypedCallFlagCallableValue();
            }
            else if (identifiers.TypeKindAt(identifierIndex) == TypedSignatureTypeKind.Closure)
            {
                targetKind = TypedCallTargetKind.ClosureValue;
                resolvedCallableTypeStartToken = identifiers.TypeStartTokenAt(identifierIndex);
                resolvedCallableTypeEndToken = identifiers.TypeEndTokenAt(identifierIndex);
                flags = flags | TypedCallFlagResolved() | TypedCallFlagCallableValue();
            }
            else if (identifiers.TargetKindAt(identifierIndex) != TypedIdentifierTargetKind.Unknown)
            {
                targetKind = TypedCallTargetKind.NonCallableValue;
                flags = flags | TypedCallFlagResolved();
            }
        }
    }
    else
    {
        stack mut bool calleeIsMember = false;
        if (useBody)
        {
            calleeIsMember = body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Member;
        }
        else
        {
            calleeIsMember = tree.NodeKindAt(calleeNode) == Compiler.Parsing.ExprKind.Member;
        }

        if (calleeIsMember)
        {
            targetKind = TypedCallTargetKind.Unknown;
            stack u32[0 max] memberIndexPlusOne = TypedCallMemberIndexForNode(
                members,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                calleeNode);
            if (memberIndexPlusOne != 0)
            {
                stack u64[0 2 ** 63 - 1] memberIndex = (u64[0 2 ** 63 - 1])(memberIndexPlusOne - 1);
                stack TypedMemberTargetKind memberTargetKind = members.TargetKindAt(memberIndex);
                targetDeclarationIndex = members.TargetDeclarationIndexAt(memberIndex);
                targetSymbolIndexPlusOne = members.TargetSymbolIndexPlusOneAt(memberIndex);
                targetNameToken = members.TargetNameTokenAt(memberIndex);
                if (memberTargetKind == TypedMemberTargetKind.Field)
                {
                    targetKind = TypedCallTargetKind.NonCallableValue;
                    flags = flags | TypedCallFlagResolved();
                }
                else if (memberTargetKind == TypedMemberTargetKind.InstanceMethod || memberTargetKind == TypedMemberTargetKind.StaticMethod)
                {
                    if (memberTargetKind == TypedMemberTargetKind.InstanceMethod)
                    {
                        targetKind = TypedCallTargetKind.InstanceMethod;
                    }
                    else
                    {
                        targetKind = TypedCallTargetKind.StaticMethod;
                    }

                    resolvedSignatureIndexPlusOne = TypedCallResolveMethodOverload(
                        source,
                        stream,
                        signatures,
                        literals,
                        identifiers,
                        table,
                        members,
                        tree,
                        body,
                        useBody,
                        context,
                        ownerDeclarationIndex,
                        ownerNameToken,
                        functionNameToken,
                        statementIndexPlusOne,
                        callNode,
                        memberIndexPlusOne,
                        parameterOffset,
                        overloadCandidateCount,
                        overloadViableCandidateCount,
                        overloadBestCandidateCount);
                    flags = flags | TypedCallFlagDirect();
                    if (resolvedSignatureIndexPlusOne != 0)
                    {
                        targetSymbolIndexPlusOne = resolvedSignatureIndexPlusOne;
                        flags = flags | TypedCallFlagResolved() | TypedCallFlagOverloadResolved();
                    }
                    else if (overloadViableCandidateCount == 0)
                    {
                        flags = flags | TypedCallFlagOverloadNoMatch();
                    }
                    else
                    {
                        flags = flags | TypedCallFlagOverloadAmbiguous();
                    }
                }
            }
        }
    }

    stack mut TypedSignatureTypeKind returnTypeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] returnTypeHeadToken = 0;
    stack mut u32[0 max] returnTypePrimaryToken = 0;
    stack mut u32[0 max] returnTypeStartToken = 0;
    stack mut u32[0 max] returnTypeEndToken = 0;
    stack mut u32[0 max] returnRangeStartToken = 0;
    stack mut u32[0 max] returnRangeEndToken = 0;
    stack mut u32[0 max] returnElementCountStartToken = 0;
    stack mut u32[0 max] returnElementCountEndToken = 0;
    stack mut u32[0 max] returnBitWidth = 0;
    stack mut u32[0 max] returnTypeArgumentCount = 0;
    stack mut u32[0 max] returnComptimeArgumentCount = 0;
    stack mut u32[0 max] returnTypeFlags = 0;
    if (resolvedSignatureIndexPlusOne != 0)
    {
        stack u64[0 2 ** 63 - 1] signatureIndex = (u64[0 2 ** 63 - 1])(resolvedSignatureIndexPlusOne - 1);
        parameterCount = signatures.ParamCountAt(signatureIndex);
        if (parameterCount == (u32[0 max])(argumentCount + parameterOffset))
        {
            flags = flags | TypedCallFlagArityMatches();
        }

        stack u32[0 max] returnSlotIndexPlusOne = signatures.ReturnTypeSlotIndexPlusOneAt(signatureIndex);
        TypedCallSignatureSlotFacts(
            signatures,
            returnSlotIndexPlusOne,
            returnTypeKind,
            returnTypeHeadToken,
            returnTypePrimaryToken,
            returnTypeStartToken,
            returnTypeEndToken,
            returnRangeStartToken,
            returnRangeEndToken,
            returnElementCountStartToken,
            returnElementCountEndToken,
            returnBitWidth,
            returnTypeArgumentCount,
            returnComptimeArgumentCount,
            returnTypeFlags);
    }
    else if (resolvedCallableTypeStartToken != 0)
    {
        TypedCallCallableReturnFacts(
            source,
            stream,
            resolvedCallableTypeStartToken,
            resolvedCallableTypeEndToken,
            parameterCount,
            returnTypeKind,
            returnTypeHeadToken,
            returnTypePrimaryToken,
            returnTypeStartToken,
            returnTypeEndToken,
            returnRangeStartToken,
            returnRangeEndToken,
            returnElementCountStartToken,
            returnElementCountEndToken,
            returnBitWidth,
            returnTypeArgumentCount,
            returnComptimeArgumentCount,
            returnTypeFlags);
        if (parameterCount == argumentCount)
        {
            flags = flags | TypedCallFlagArityMatches();
        }
    }

    stack mut u32[0 max] argumentStartIndexPlusOne = 0;
    if (argumentCount > 0)
    {
        argumentStartIndexPlusOne = (u32[0 max])(table.ArgumentCount() + 1);
    }

    signatureIndexPlusOne = resolvedSignatureIndexPlusOne;
    callableTypeStartToken = resolvedCallableTypeStartToken;
    callableTypeEndToken = resolvedCallableTypeEndToken;
    return table.AppendCall(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        callNode,
        calleeNode,
        callToken,
        calleeNameToken,
        targetKind,
        targetDeclarationIndex,
        targetSymbolIndexPlusOne,
        targetNameToken,
        resolvedSignatureIndexPlusOne,
        argumentStartIndexPlusOne,
        argumentCount,
        parameterCount,
        overloadCandidateCount,
        overloadViableCandidateCount,
        overloadBestCandidateCount,
        flags,
        returnTypeKind,
        returnTypeHeadToken,
        returnTypePrimaryToken,
        returnTypeStartToken,
        returnTypeEndToken,
        returnRangeStartToken,
        returnRangeEndToken,
        returnElementCountStartToken,
        returnElementCountEndToken,
        returnBitWidth,
        returnTypeArgumentCount,
        returnComptimeArgumentCount,
        returnTypeFlags,
        callIndexPlusOne);
}

internal fn System.Memory.MemoryStatus AppendTypedCallsFromGlobalDeclaration(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    DeclItem item,
    u32[0 max] declarationIndex)
{
    if (!TypedGlobalDeclarationKindIsGlobal(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] assignToken = TypedGlobalFindAssignToken(stream, item);
    if (assignToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack ExprTree tree = ParseExpression(stream, (u32[0 max])(assignToken + 1));
    stack StatementList emptyBody = new();
    stack u64[0 2 ** 63 - 1] count = tree.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 1; index <= count; index += 1)
    {
        stack u32[0 max] node = (u32[0 max])index;
        if (tree.NodeKindAt(node) == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] calleeNode = tree.LeftAt(node);
            stack bool calleeIsIdentifier = tree.NodeKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier;
            stack mut u32[0 max] calleeNameToken = 0;
            if (calleeIsIdentifier)
            {
                calleeNameToken = tree.TokenAt(calleeNode);
            }
            else if (tree.NodeKindAt(calleeNode) == Compiler.Parsing.ExprKind.Member)
            {
                calleeNameToken = tree.TokenAt(calleeNode);
            }

            stack mut u32[0 max] callIndexPlusOne = 0;
            stack mut u32[0 max] signatureIndexPlusOne = 0;
            stack mut u32[0 max] parameterOffset = 0;
            stack mut u32[0 max] callableTypeStartToken = 0;
            stack mut u32[0 max] callableTypeEndToken = 0;
            switch (AppendTypedCallExpression(
                table,
                source,
                stream,
                signatures,
                literals,
                identifiers,
                members,
                tree,
                emptyBody,
                false,
                TypedCallContext.GlobalInitializer,
                declarationIndex,
                TypedGlobalFindNameToken(stream, item),
                0,
                0,
                node,
                calleeNode,
                tree.TokenAt(node),
                calleeNameToken,
                tree.CallArgCount(node),
                calleeIsIdentifier,
                callIndexPlusOne,
                signatureIndexPlusOne,
                parameterOffset,
                callableTypeStartToken,
                callableTypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (AppendTypedCallArgumentsFromTree(
                table,
                source,
                stream,
                signatures,
                tree,
                node,
                callIndexPlusOne,
                signatureIndexPlusOne,
                parameterOffset,
                callableTypeStartToken,
                callableTypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var argumentError):
                    return System.Memory.MemoryStatus.Err(argumentError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallsFromBodyStatement(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statementIndex)
{
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    stack ExprTree emptyTree = new();
    stack u32[0 max] start = (u32[0 max])(body.ExprStartAt(statementIndex) + 1);
    stack mut u32[0 max] end = (u32[0 max])body.ExprNodeCount();
    if (statementIndex + 1 < statementCount)
    {
        end = body.ExprStartAt((u64[0 2 ** 63 - 1])(statementIndex + 1));
    }

    if (start > end)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] endIndex = (u64[0 2 ** 63 - 1])end;
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])start; nodeIndex <= endIndex; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] calleeNode = body.ExprLeftAt(node);
            stack bool calleeIsIdentifier = body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier;
            stack mut u32[0 max] calleeNameToken = 0;
            if (calleeIsIdentifier)
            {
                calleeNameToken = body.ExprTokenAt(calleeNode);
            }
            else if (body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Member)
            {
                calleeNameToken = body.ExprTokenAt(calleeNode);
            }

            stack mut u32[0 max] callIndexPlusOne = 0;
            stack mut u32[0 max] signatureIndexPlusOne = 0;
            stack mut u32[0 max] parameterOffset = 0;
            stack mut u32[0 max] callableTypeStartToken = 0;
            stack mut u32[0 max] callableTypeEndToken = 0;
            switch (AppendTypedCallExpression(
                table,
                source,
                stream,
                signatures,
                literals,
                identifiers,
                members,
                emptyTree,
                body,
                true,
                TypedCallContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                (u32[0 max])(statementIndex + 1),
                node,
                calleeNode,
                body.ExprTokenAt(node),
                calleeNameToken,
                body.ExprCallArgCountAt(node),
                calleeIsIdentifier,
                callIndexPlusOne,
                signatureIndexPlusOne,
                parameterOffset,
                callableTypeStartToken,
                callableTypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (AppendTypedCallArgumentsFromBody(
                table,
                source,
                stream,
                signatures,
                body,
                node,
                callIndexPlusOne,
                signatureIndexPlusOne,
                parameterOffset,
                callableTypeStartToken,
                callableTypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var argumentError):
                    return System.Memory.MemoryStatus.Err(argumentError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallsFromBody(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedCallsFromBodyStatement(
            table,
            source,
            stream,
            signatures,
            literals,
            identifiers,
            members,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            body,
            index))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallsForFunction(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] fnKeyword)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    return AppendTypedCallsFromBody(
        table,
        source,
        stream,
        signatures,
        literals,
        identifiers,
        members,
        ownerDeclarationIndex,
        ownerNameToken,
        signature.Name(),
        body);
}

internal fn System.Memory.MemoryStatus AppendTypedCallsForMemberFunctions(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    DeclItem item,
    u32[0 max] ownerDeclarationIndex)
{
    if (!TypedSignatureDeclarationCanOwnMethods(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, item);
    if (bodyOpen == 0 || bodyOpen >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Fn)
        {
            switch (AppendTypedCallsForFunction(table, source, stream, signatures, literals, identifiers, members, ownerDeclarationIndex, item.NameToken, scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn ParseResult<TypedCallExpressionTable> BuildTypedCallExpressionsFromDependencies(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members)
{
    stack mut TypedCallExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedCallsFromGlobalDeclaration(
            table,
            source,
            stream,
            signatures,
            literals,
            identifiers,
            members,
            item,
            (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedCallsForFunction(table, source, stream, signatures, literals, identifiers, members, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedCallsForMemberFunctions(table, source, stream, signatures, literals, identifiers, members, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberError):
                    return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedCallExpressionTable>.Ok(table);
}

public fn ParseResult<TypedCallExpressionTable> BuildTypedCallExpressions(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedFunctionSignatureTable signatures = new();
    switch (BuildTypedFunctionSignatures(source, stream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFunctionSignatureTable>.Ok(var builtSignatures):
            signatures = builtSignatures;
    }

    stack mut TypedLiteralExpressionTable literals = new();
    switch (BuildTypedLiteralExpressions(source, stream, declarations))
    {
        case ParseResult<TypedLiteralExpressionTable>.Err(var literalError):
            return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedLiteralExpressionTable>.Ok(var builtLiterals):
            literals = builtLiterals;
    }

    stack mut TypedIdentifierExpressionTable identifiers = new();
    switch (BuildTypedIdentifierExpressions(source, stream, declarations))
    {
        case ParseResult<TypedIdentifierExpressionTable>.Err(var identifierError):
            return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIdentifierExpressionTable>.Ok(var builtIdentifiers):
            identifiers = builtIdentifiers;
    }

    stack mut TypedFieldDeclarationTable fields = new();
    switch (BuildTypedStructRecordFields(source, stream, declarations))
    {
        case ParseResult<TypedFieldDeclarationTable>.Err(var fieldError):
            return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFieldDeclarationTable>.Ok(var builtFields):
            fields = builtFields;
    }

    switch (BuildTypedMemberCallDependencies(source, stream, declarations, signatures, fields, literals, identifiers))
    {
        case ParseResult<TypedMemberCallDependencySet>.Err(var dependencyError):
            return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedMemberCallDependencySet>.Ok(var dependencies):
            return ParseResult<TypedCallExpressionTable>.Ok(dependencies.Calls);
    }
}

internal struct TypedMemberTypeFacts
{
    TypedMemberReceiverKind ReceiverKind;
    u32[0 max] DeclarationIndex;
    u32[0 max] NameToken;
    TypedSignatureTypeKind TypeKind;
    u32[0 max] TypeHeadToken;
    u32[0 max] TypePrimaryToken;
    u32[0 max] TypeStartToken;
    u32[0 max] TypeEndToken;
    u32[0 max] RangeStartToken;
    u32[0 max] RangeEndToken;
    u32[0 max] ElementCountStartToken;
    u32[0 max] ElementCountEndToken;
    u32[0 max] BitWidth;
    u32[0 max] TypeArgumentCount;
    u32[0 max] ComptimeArgumentCount;
    u32[0 max] TypeFlags;

    TypedMemberTypeFacts()
    {
        self.ReceiverKind = TypedMemberReceiverKind.Unknown;
        self.DeclarationIndex = 0;
        self.NameToken = 0;
        self.TypeKind = TypedSignatureTypeKind.Unknown;
        self.TypeHeadToken = 0;
        self.TypePrimaryToken = 0;
        self.TypeStartToken = 0;
        self.TypeEndToken = 0;
        self.RangeStartToken = 0;
        self.RangeEndToken = 0;
        self.ElementCountStartToken = 0;
        self.ElementCountEndToken = 0;
        self.BitWidth = 0;
        self.TypeArgumentCount = 0;
        self.ComptimeArgumentCount = 0;
        self.TypeFlags = 0;
    }
}

internal finite law TypedIdentifierContext TypedMemberIdentifierContext(TypedMemberContext context)
{
    if (context == TypedMemberContext.GlobalInitializer)
    {
        return TypedIdentifierContext.GlobalInitializer;
    }

    if (context == TypedMemberContext.FunctionBody)
    {
        return TypedIdentifierContext.FunctionBody;
    }

    return TypedIdentifierContext.Unknown;
}

internal finite law TypedCallContext TypedMemberCallContext(TypedMemberContext context)
{
    if (context == TypedMemberContext.GlobalInitializer)
    {
        return TypedCallContext.GlobalInitializer;
    }

    if (context == TypedMemberContext.FunctionBody)
    {
        return TypedCallContext.FunctionBody;
    }

    return TypedCallContext.Unknown;
}

internal fn u32[0 max] TypedMemberIdentifierIndexForNode(
    borrow TypedIdentifierExpressionTable identifiers,
    TypedMemberContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node)
{
    stack TypedIdentifierContext identifierContext = TypedMemberIdentifierContext(context);
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = identifiers.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && identifiers.ContextAt(index) == identifierContext
            && identifiers.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && identifiers.OwnerNameTokenAt(index) == ownerNameToken
            && identifiers.FunctionNameTokenAt(index) == functionNameToken
            && identifiers.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && identifiers.ExprNodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn u32[0 max] TypedMemberCallIndexForNode(
    borrow TypedCallExpressionTable calls,
    TypedMemberContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node)
{
    stack TypedCallContext callContext = TypedMemberCallContext(context);
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = calls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && calls.ContextAt(index) == callContext
            && calls.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && calls.OwnerNameTokenAt(index) == ownerNameToken
            && calls.FunctionNameTokenAt(index) == functionNameToken
            && calls.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && calls.CallNodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn u32[0 max] TypedMemberExpressionIndexForNode(
    borrow TypedMemberExpressionTable table,
    TypedMemberContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && table.ContextAt(index) == context
            && table.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && table.OwnerNameTokenAt(index) == ownerNameToken
            && table.FunctionNameTokenAt(index) == functionNameToken
            && table.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && table.MemberNodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn u32[0 max] TypedMemberDeclarationIndexForTypeHead(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    u32[0 max] typeHeadToken)
{
    stack u32[0 max] declarationIndexPlusOne = TypedIdentifierDeclarationIndexByNameToken(source, stream, declarations, typeHeadToken);
    if (declarationIndexPlusOne == 0)
    {
        return 0;
    }

    return (u32[0 max])(declarationIndexPlusOne - 1);
}

internal fn void TypedMemberFactsFromIdentifier(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    u32[0 max] identifierIndexPlusOne,
    mut borrow TypedMemberTypeFacts facts)
{
    if (identifierIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(identifierIndexPlusOne - 1);
    facts.NameToken = identifiers.NameTokenAt(index);
    facts.TypeKind = identifiers.TypeKindAt(index);
    facts.TypeHeadToken = identifiers.TypeHeadTokenAt(index);
    facts.TypePrimaryToken = identifiers.TypePrimaryTokenAt(index);
    facts.TypeStartToken = identifiers.TypeStartTokenAt(index);
    facts.TypeEndToken = identifiers.TypeEndTokenAt(index);
    facts.RangeStartToken = identifiers.RangeStartTokenAt(index);
    facts.RangeEndToken = identifiers.RangeEndTokenAt(index);
    facts.ElementCountStartToken = identifiers.ElementCountStartTokenAt(index);
    facts.ElementCountEndToken = identifiers.ElementCountEndTokenAt(index);
    facts.BitWidth = identifiers.BitWidthAt(index);
    facts.TypeArgumentCount = identifiers.TypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = identifiers.ComptimeArgumentCountAt(index);
    facts.TypeFlags = identifiers.TypeFlagsAt(index);

    if (identifiers.TargetKindAt(index) == TypedIdentifierTargetKind.TypeDeclaration)
    {
        facts.ReceiverKind = TypedMemberReceiverKind.StaticType;
        facts.DeclarationIndex = identifiers.TargetDeclarationIndexAt(index);
        facts.NameToken = identifiers.TargetNameTokenAt(index);
    }
    else if (identifiers.TargetKindAt(index) != TypedIdentifierTargetKind.Unknown || facts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        facts.ReceiverKind = TypedMemberReceiverKind.Value;
        facts.DeclarationIndex = TypedMemberDeclarationIndexForTypeHead(source, stream, declarations, facts.TypeHeadToken);
    }
}

internal fn void TypedMemberFactsFromCall(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedCallExpressionTable calls,
    u32[0 max] callIndexPlusOne,
    mut borrow TypedMemberTypeFacts facts)
{
    if (callIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(callIndexPlusOne - 1);
    facts.NameToken = calls.TargetNameTokenAt(index);
    facts.TypeKind = calls.ReturnTypeKindAt(index);
    facts.TypeHeadToken = calls.ReturnTypeHeadTokenAt(index);
    facts.TypePrimaryToken = calls.ReturnTypePrimaryTokenAt(index);
    facts.TypeStartToken = calls.ReturnTypeStartTokenAt(index);
    facts.TypeEndToken = calls.ReturnTypeEndTokenAt(index);
    facts.RangeStartToken = calls.ReturnRangeStartTokenAt(index);
    facts.RangeEndToken = calls.ReturnRangeEndTokenAt(index);
    facts.ElementCountStartToken = calls.ReturnElementCountStartTokenAt(index);
    facts.ElementCountEndToken = calls.ReturnElementCountEndTokenAt(index);
    facts.BitWidth = calls.ReturnBitWidthAt(index);
    facts.TypeArgumentCount = calls.ReturnTypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = calls.ReturnComptimeArgumentCountAt(index);
    facts.TypeFlags = calls.ReturnTypeFlagsAt(index);
    if (facts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        facts.ReceiverKind = TypedMemberReceiverKind.Value;
        facts.DeclarationIndex = TypedMemberDeclarationIndexForTypeHead(source, stream, declarations, facts.TypeHeadToken);
    }
}

internal fn void TypedMemberFactsFromMember(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedMemberExpressionTable table,
    u32[0 max] memberIndexPlusOne,
    mut borrow TypedMemberTypeFacts facts)
{
    if (memberIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(memberIndexPlusOne - 1);
    facts.NameToken = table.MemberNameTokenAt(index);
    facts.TypeKind = table.TypeKindAt(index);
    facts.TypeHeadToken = table.TypeHeadTokenAt(index);
    facts.TypePrimaryToken = table.TypePrimaryTokenAt(index);
    facts.TypeStartToken = table.TypeStartTokenAt(index);
    facts.TypeEndToken = table.TypeEndTokenAt(index);
    facts.RangeStartToken = table.RangeStartTokenAt(index);
    facts.RangeEndToken = table.RangeEndTokenAt(index);
    facts.ElementCountStartToken = table.ElementCountStartTokenAt(index);
    facts.ElementCountEndToken = table.ElementCountEndTokenAt(index);
    facts.BitWidth = table.BitWidthAt(index);
    facts.TypeArgumentCount = table.TypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = table.ComptimeArgumentCountAt(index);
    facts.TypeFlags = table.TypeFlagsAt(index);
    if (facts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        facts.ReceiverKind = TypedMemberReceiverKind.Value;
        facts.DeclarationIndex = TypedMemberDeclarationIndexForTypeHead(source, stream, declarations, facts.TypeHeadToken);
    }
}

internal fn void TypedMemberFactsFromNewTypeNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    u32[0 max] typeNameToken,
    mut borrow TypedMemberTypeFacts facts)
{
    if (typeNameToken == 0)
    {
        return;
    }

    facts.ReceiverKind = TypedMemberReceiverKind.Value;
    facts.DeclarationIndex = TypedMemberDeclarationIndexForTypeHead(source, stream, declarations, typeNameToken);
    facts.NameToken = typeNameToken;
    facts.TypeKind = TypedSignatureTypeKind.Named;
    facts.TypeHeadToken = typeNameToken;
    facts.TypePrimaryToken = typeNameToken;
    facts.TypeStartToken = typeNameToken;
    facts.TypeEndToken = (u32[0 max])(typeNameToken + 1);
}

internal fn void TypedMemberFactsFromTypeSpan(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    u32[0 max] fallbackPrimaryToken,
    u32[0 max] functionGenericOpenToken,
    u32[0 max] ownerGenericOpenToken,
    mut borrow TypedMemberTypeFacts facts)
{
    if (typeStartToken == 0 || typeEndToken <= typeStartToken)
    {
        return;
    }

    stack mut u32[0 max] rangeStartToken = 0;
    stack mut u32[0 max] rangeEndToken = 0;
    stack mut u32[0 max] elementCountStartToken = 0;
    stack mut u32[0 max] elementCountEndToken = 0;
    stack mut TypedSignatureTypeKind arrayKind = TypedSignatureTypeKind.Unknown;
    TypedSignatureScanTopLevelTypeFacts(
        stream,
        typeStartToken,
        typeEndToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        elementCountEndToken,
        arrayKind);

    stack u32[0 max] typePrimaryToken = TypedSignatureSemanticPrimaryToken(stream, typeStartToken, typeEndToken, fallbackPrimaryToken);
    stack mut u32[0 max] typeHeadToken = 0;
    if (stream.KindAt((u64[0 2 ** 63 - 1])typePrimaryToken) == TokenKind.Identifier)
    {
        typeHeadToken = typePrimaryToken;
    }

    stack TypedSignatureTypeKind typeKind = TypedSignatureKindForType(source, stream, typePrimaryToken, typeHeadToken, functionGenericOpenToken, ownerGenericOpenToken, arrayKind);
    stack mut u32[0 max] bitWidth = 0;
    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])typePrimaryToken);
    if (primaryKind == TokenKind.IntegerType)
    {
        bitWidth = TypedSignatureIntegerBitWidth(source, stream, typePrimaryToken);
    }
    else if (primaryKind == TokenKind.FloatType)
    {
        bitWidth = TypedSignatureFloatBitWidth(source, stream, typePrimaryToken);
    }

    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    if (typeHeadToken != 0 && stream.KindAt((u64[0 2 ** 63 - 1])(typeHeadToken + 1)) == TokenKind.Lt)
    {
        TypedSignatureCountGenericArgumentsInList(stream, (u32[0 max])(typeHeadToken + 1), typeArgumentCount, comptimeArgumentCount);
    }

    stack u32[0 max] typeFlags = TypedSignatureFlagsForType(
        source,
        stream,
        typePrimaryToken,
        typeHeadToken,
        typeStartToken,
        typeEndToken,
        functionGenericOpenToken,
        ownerGenericOpenToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        false,
        0,
        false);

    facts.ReceiverKind = TypedMemberReceiverKind.Value;
    facts.DeclarationIndex = TypedMemberDeclarationIndexForTypeHead(source, stream, declarations, typeHeadToken);
    facts.NameToken = typeHeadToken;
    facts.TypeKind = typeKind;
    facts.TypeHeadToken = typeHeadToken;
    facts.TypePrimaryToken = typePrimaryToken;
    facts.TypeStartToken = typeStartToken;
    facts.TypeEndToken = typeEndToken;
    facts.RangeStartToken = rangeStartToken;
    facts.RangeEndToken = rangeEndToken;
    facts.ElementCountStartToken = elementCountStartToken;
    facts.ElementCountEndToken = elementCountEndToken;
    facts.BitWidth = bitWidth;
    facts.TypeArgumentCount = typeArgumentCount;
    facts.ComptimeArgumentCount = comptimeArgumentCount;
    facts.TypeFlags = typeFlags;
}

internal fn u32[0 max] TypedMemberFieldIndexForOwnerAndName(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFieldDeclarationTable fields,
    u32[0 max] ownerNameToken,
    u32[0 max] memberNameToken)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = fields.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && fields.OwnerNameTokenAt(index) != 0
            && TypedSignatureTokenTextEqualsToken(source, stream, fields.OwnerNameTokenAt(index), ownerNameToken)
            && TypedSignatureTokenTextEqualsToken(source, stream, fields.NameTokenAt(index), memberNameToken))
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn void TypedMemberFactsFromField(borrow TypedFieldDeclarationTable fields, u32[0 max] fieldIndexPlusOne, mut borrow TypedMemberTypeFacts facts)
{
    if (fieldIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(fieldIndexPlusOne - 1);
    facts.NameToken = fields.NameTokenAt(index);
    facts.TypeKind = fields.TypeKindAt(index);
    facts.TypeHeadToken = fields.TypeHeadTokenAt(index);
    facts.TypePrimaryToken = fields.TypePrimaryTokenAt(index);
    facts.TypeStartToken = fields.TypeStartTokenAt(index);
    facts.TypeEndToken = fields.TypeEndTokenAt(index);
    facts.RangeStartToken = fields.RangeStartTokenAt(index);
    facts.RangeEndToken = fields.RangeEndTokenAt(index);
    facts.ElementCountStartToken = fields.ElementCountStartTokenAt(index);
    facts.ElementCountEndToken = fields.ElementCountEndTokenAt(index);
    facts.BitWidth = fields.BitWidthAt(index);
    facts.TypeArgumentCount = fields.TypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = fields.ComptimeArgumentCountAt(index);
    facts.TypeFlags = fields.TypeFlagsAt(index);
}

internal finite law bool TypedMemberFunctionHasStaticBefore(borrow TokenStream stream, u32[0 max] fnKeyword)
{
    stack mut u32[0 max] scan = fnKeyword;
    while willexit (scan > 0)
    {
        scan = (u32[0 max])(scan - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Static)
        {
            return true;
        }

        if (kind == TokenKind.LBrace || kind == TokenKind.RBrace || kind == TokenKind.Semi)
        {
            return false;
        }
    }

    return false;
}

internal fn bool TypedMemberSignatureMatches(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    u64[0 2 ** 63 - 1] signatureIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] memberNameToken,
    bool wantStatic)
{
    if (signatures.OwnerKindAt(signatureIndex) != TypedSignatureOwnerKind.MemberMethod)
    {
        return false;
    }

    if (!TypedSignatureTokenTextEqualsToken(source, stream, signatures.OwnerNameTokenAt(signatureIndex), ownerNameToken))
    {
        return false;
    }

    if (!TypedSignatureTokenTextEqualsToken(source, stream, signatures.NameTokenAt(signatureIndex), memberNameToken))
    {
        return false;
    }

    return TypedMemberFunctionHasStaticBefore(stream, signatures.KeywordTokenAt(signatureIndex)) == wantStatic;
}

internal fn u32[0 max] TypedMemberMethodCandidateCount(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    u32[0 max] ownerNameToken,
    u32[0 max] memberNameToken,
    bool wantStatic)
{
    stack mut u32[0 max] count = 0;
    stack u64[0 2 ** 63 - 1] signatureCount = signatures.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < signatureCount; index += 1)
    {
        if (TypedMemberSignatureMatches(source, stream, signatures, index, ownerNameToken, memberNameToken, wantStatic))
        {
            count = (u32[0 max])(count + 1);
        }
    }

    return count;
}

internal fn System.Memory.MemoryStatus AppendTypedMemberMethodCandidates(
    mut borrow TypedMemberExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    u32[0 max] memberIndexPlusOne,
    u32[0 max] ownerNameToken,
    u32[0 max] memberNameToken,
    bool wantStatic)
{
    stack mut TypedMemberTargetKind candidateKind = TypedMemberTargetKind.InstanceMethod;
    if (wantStatic)
    {
        candidateKind = TypedMemberTargetKind.StaticMethod;
    }

    stack u64[0 2 ** 63 - 1] signatureCount = signatures.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < signatureCount; index += 1)
    {
        if (TypedMemberSignatureMatches(source, stream, signatures, index, ownerNameToken, memberNameToken, wantStatic))
        {
            stack mut TypedSignatureTypeKind returnTypeKind = TypedSignatureTypeKind.Unknown;
            stack mut u32[0 max] returnTypeHeadToken = 0;
            stack mut u32[0 max] returnTypePrimaryToken = 0;
            stack mut u32[0 max] returnTypeStartToken = 0;
            stack mut u32[0 max] returnTypeEndToken = 0;
            stack mut u32[0 max] returnRangeStartToken = 0;
            stack mut u32[0 max] returnRangeEndToken = 0;
            stack mut u32[0 max] returnElementCountStartToken = 0;
            stack mut u32[0 max] returnElementCountEndToken = 0;
            stack mut u32[0 max] returnBitWidth = 0;
            stack mut u32[0 max] returnTypeArgumentCount = 0;
            stack mut u32[0 max] returnComptimeArgumentCount = 0;
            stack mut u32[0 max] returnTypeFlags = 0;
            TypedCallSignatureSlotFacts(
                signatures,
                signatures.ReturnTypeSlotIndexPlusOneAt(index),
                returnTypeKind,
                returnTypeHeadToken,
                returnTypePrimaryToken,
                returnTypeStartToken,
                returnTypeEndToken,
                returnRangeStartToken,
                returnRangeEndToken,
                returnElementCountStartToken,
                returnElementCountEndToken,
                returnBitWidth,
                returnTypeArgumentCount,
                returnComptimeArgumentCount,
                returnTypeFlags);

            switch (table.AppendCandidate(
                memberIndexPlusOne,
                candidateKind,
                (u32[0 max])(index + 1),
                signatures.NameTokenAt(index),
                signatures.ParamCountAt(index),
                returnTypeKind,
                returnTypeHeadToken,
                returnTypePrimaryToken,
                returnTypeStartToken,
                returnTypeEndToken,
                returnRangeStartToken,
                returnRangeEndToken,
                returnElementCountStartToken,
                returnElementCountEndToken,
                returnBitWidth,
                returnTypeArgumentCount,
                returnComptimeArgumentCount,
                returnTypeFlags))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedMemberExpression(
    mut borrow TypedMemberExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedFieldDeclarationTable fields,
    TypedMemberContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] memberNode,
    u32[0 max] receiverNode,
    u32[0 max] memberNameToken,
    borrow TypedMemberTypeFacts receiver)
{
    stack mut TypedMemberTargetKind targetKind = TypedMemberTargetKind.Unknown;
    stack mut u32[0 max] targetDeclarationIndex = 0;
    stack mut u32[0 max] targetSymbolIndexPlusOne = 0;
    stack mut u32[0 max] targetNameToken = 0;
    stack mut u32[0 max] candidateStartIndexPlusOne = 0;
    stack mut u32[0 max] candidateCount = 0;
    stack mut u32[0 max] flags = 0;
    stack mut TypedMemberTypeFacts result = new();

    if (receiver.ReceiverKind != TypedMemberReceiverKind.Unknown)
    {
        flags = flags | TypedMemberFlagReceiverResolved();
    }

    if (receiver.ReceiverKind == TypedMemberReceiverKind.Value && receiver.TypeHeadToken != 0)
    {
        stack u32[0 max] fieldIndexPlusOne = TypedMemberFieldIndexForOwnerAndName(source, stream, fields, receiver.TypeHeadToken, memberNameToken);
        if (fieldIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] fieldIndex = (u64[0 2 ** 63 - 1])(fieldIndexPlusOne - 1);
            targetKind = TypedMemberTargetKind.Field;
            targetDeclarationIndex = fields.OwnerDeclarationIndexAt(fieldIndex);
            targetSymbolIndexPlusOne = fieldIndexPlusOne;
            targetNameToken = fields.NameTokenAt(fieldIndex);
            flags = flags | TypedMemberFlagResolved() | TypedMemberFlagField();
            TypedMemberFactsFromField(fields, fieldIndexPlusOne, result);
        }

        candidateCount = TypedMemberMethodCandidateCount(source, stream, signatures, receiver.TypeHeadToken, memberNameToken, false);
        if (candidateCount > 0)
        {
            if (targetKind == TypedMemberTargetKind.Unknown)
            {
                targetKind = TypedMemberTargetKind.InstanceMethod;
                targetDeclarationIndex = receiver.DeclarationIndex;
                targetNameToken = memberNameToken;
            }

            candidateStartIndexPlusOne = (u32[0 max])(table.CandidateCount() + 1);
            flags = flags | TypedMemberFlagResolved() | TypedMemberFlagMethodCandidate();
        }
    }
    else if (receiver.ReceiverKind == TypedMemberReceiverKind.StaticType && receiver.TypeHeadToken != 0)
    {
        candidateCount = TypedMemberMethodCandidateCount(source, stream, signatures, receiver.TypeHeadToken, memberNameToken, true);
        if (candidateCount > 0)
        {
            targetKind = TypedMemberTargetKind.StaticMethod;
            targetDeclarationIndex = receiver.DeclarationIndex;
            targetNameToken = memberNameToken;
            candidateStartIndexPlusOne = (u32[0 max])(table.CandidateCount() + 1);
            flags = flags | TypedMemberFlagResolved() | TypedMemberFlagMethodCandidate();
        }
    }

    stack mut u32[0 max] memberIndexPlusOne = 0;
    switch (table.AppendMember(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        memberNode,
        receiverNode,
        memberNameToken,
        receiver.ReceiverKind,
        receiver.DeclarationIndex,
        receiver.NameToken,
        receiver.TypeKind,
        receiver.TypeHeadToken,
        receiver.TypePrimaryToken,
        receiver.TypeStartToken,
        receiver.TypeEndToken,
        receiver.RangeStartToken,
        receiver.RangeEndToken,
        receiver.ElementCountStartToken,
        receiver.ElementCountEndToken,
        receiver.BitWidth,
        receiver.TypeArgumentCount,
        receiver.ComptimeArgumentCount,
        receiver.TypeFlags,
        targetKind,
        targetDeclarationIndex,
        targetSymbolIndexPlusOne,
        targetNameToken,
        candidateStartIndexPlusOne,
        candidateCount,
        flags,
        result.TypeKind,
        result.TypeHeadToken,
        result.TypePrimaryToken,
        result.TypeStartToken,
        result.TypeEndToken,
        result.RangeStartToken,
        result.RangeEndToken,
        result.ElementCountStartToken,
        result.ElementCountEndToken,
        result.BitWidth,
        result.TypeArgumentCount,
        result.ComptimeArgumentCount,
        result.TypeFlags,
        memberIndexPlusOne))
    {
        case System.Memory.MemoryStatus.Err(var appendError):
            return System.Memory.MemoryStatus.Err(appendError);
        case System.Memory.MemoryStatus.Ok:
    }

    if (candidateCount > 0)
    {
        stack bool wantStatic = receiver.ReceiverKind == TypedMemberReceiverKind.StaticType;
        switch (AppendTypedMemberMethodCandidates(table, source, stream, signatures, memberIndexPlusOne, receiver.TypeHeadToken, memberNameToken, wantStatic))
        {
            case System.Memory.MemoryStatus.Err(var candidateError):
                return System.Memory.MemoryStatus.Err(candidateError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn void TypedMemberReceiverFactsFromTreeNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable table,
    borrow ExprTree tree,
    TypedMemberContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] receiverNode,
    mut borrow TypedMemberTypeFacts facts)
{
    stack ExprKind receiverKind = tree.NodeKindAt(receiverNode);
    if (receiverKind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] identifierIndexPlusOne = TypedMemberIdentifierIndexForNode(
            identifiers,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            receiverNode);
        TypedMemberFactsFromIdentifier(source, stream, declarations, identifiers, identifierIndexPlusOne, facts);
    }
    else if (receiverKind == Compiler.Parsing.ExprKind.Member)
    {
        stack u32[0 max] memberIndexPlusOne = TypedMemberExpressionIndexForNode(
            table,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            receiverNode);
        TypedMemberFactsFromMember(source, stream, declarations, table, memberIndexPlusOne, facts);
    }
    else if (receiverKind == Compiler.Parsing.ExprKind.Call)
    {
        stack u32[0 max] callIndexPlusOne = TypedMemberCallIndexForNode(
            calls,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            receiverNode);
        TypedMemberFactsFromCall(source, stream, declarations, calls, callIndexPlusOne, facts);
    }
    else if (receiverKind == Compiler.Parsing.ExprKind.New)
    {
        stack u32[0 max] typeNode = tree.LeftAt(receiverNode);
        if (typeNode != 0 && tree.NodeKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            TypedMemberFactsFromNewTypeNode(source, stream, declarations, tree.TokenAt(typeNode), facts);
        }
    }
}

internal fn void TypedMemberReceiverFactsFromBodyNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable table,
    borrow StatementList body,
    TypedMemberContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] receiverNode,
    mut borrow TypedMemberTypeFacts facts)
{
    stack ExprKind receiverKind = body.ExprKindAt(receiverNode);
    if (receiverKind == Compiler.Parsing.ExprKind.Identifier)
    {
        stack u32[0 max] identifierIndexPlusOne = TypedMemberIdentifierIndexForNode(
            identifiers,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            receiverNode);
        TypedMemberFactsFromIdentifier(source, stream, declarations, identifiers, identifierIndexPlusOne, facts);
    }
    else if (receiverKind == Compiler.Parsing.ExprKind.Member)
    {
        stack u32[0 max] memberIndexPlusOne = TypedMemberExpressionIndexForNode(
            table,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            receiverNode);
        TypedMemberFactsFromMember(source, stream, declarations, table, memberIndexPlusOne, facts);
    }
    else if (receiverKind == Compiler.Parsing.ExprKind.Call)
    {
        stack u32[0 max] callIndexPlusOne = TypedMemberCallIndexForNode(
            calls,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            receiverNode);
        TypedMemberFactsFromCall(source, stream, declarations, calls, callIndexPlusOne, facts);
    }
    else if (receiverKind == Compiler.Parsing.ExprKind.New)
    {
        stack u32[0 max] typeNode = body.ExprLeftAt(receiverNode);
        if (typeNode != 0 && body.ExprKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            TypedMemberFactsFromNewTypeNode(source, stream, declarations, body.ExprTokenAt(typeNode), facts);
        }
    }
}

internal fn System.Memory.MemoryStatus AppendTypedMembersFromGlobalDeclaration(
    mut borrow TypedMemberExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedFieldDeclarationTable fields,
    DeclItem item,
    u32[0 max] declarationIndex)
{
    if (!TypedGlobalDeclarationKindIsGlobal(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] assignToken = TypedGlobalFindAssignToken(stream, item);
    if (assignToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack ExprTree tree = ParseExpression(stream, (u32[0 max])(assignToken + 1));
    stack u64[0 2 ** 63 - 1] count = tree.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 1; index <= count; index += 1)
    {
        stack u32[0 max] node = (u32[0 max])index;
        if (tree.NodeKindAt(node) == Compiler.Parsing.ExprKind.Member)
        {
            stack mut TypedMemberTypeFacts receiver = new();
            stack u32[0 max] receiverNode = tree.LeftAt(node);
            TypedMemberReceiverFactsFromTreeNode(
                source,
                stream,
                declarations,
                identifiers,
                calls,
                table,
                tree,
                TypedMemberContext.GlobalInitializer,
                declarationIndex,
                TypedGlobalFindNameToken(stream, item),
                0,
                0,
                receiverNode,
                receiver);
            switch (AppendTypedMemberExpression(
                table,
                source,
                stream,
                signatures,
                fields,
                TypedMemberContext.GlobalInitializer,
                declarationIndex,
                TypedGlobalFindNameToken(stream, item),
                0,
                0,
                node,
                receiverNode,
                tree.TokenAt(node),
                receiver))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedMembersFromBodyStatement(
    mut borrow TypedMemberExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedFieldDeclarationTable fields,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statementIndex)
{
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    stack u32[0 max] start = (u32[0 max])(body.ExprStartAt(statementIndex) + 1);
    stack mut u32[0 max] end = (u32[0 max])body.ExprNodeCount();
    if (statementIndex + 1 < statementCount)
    {
        end = body.ExprStartAt((u64[0 2 ** 63 - 1])(statementIndex + 1));
    }

    if (start > end)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] statementIndexPlusOne = (u32[0 max])(statementIndex + 1);
    stack u64[0 2 ** 63 - 1] endIndex = (u64[0 2 ** 63 - 1])end;
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])start; nodeIndex <= endIndex; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Member)
        {
            stack mut TypedMemberTypeFacts receiver = new();
            stack u32[0 max] receiverNode = body.ExprLeftAt(node);
            TypedMemberReceiverFactsFromBodyNode(
                source,
                stream,
                declarations,
                identifiers,
                calls,
                table,
                body,
                TypedMemberContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                receiverNode,
                receiver);
            switch (AppendTypedMemberExpression(
                table,
                source,
                stream,
                signatures,
                fields,
                TypedMemberContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                node,
                receiverNode,
                body.ExprTokenAt(node),
                receiver))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedMembersFromBody(
    mut borrow TypedMemberExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedFieldDeclarationTable fields,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedMembersFromBodyStatement(
            table,
            source,
            stream,
            declarations,
            signatures,
            identifiers,
            calls,
            fields,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            body,
            index))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedMembersForFunction(
    mut borrow TypedMemberExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedFieldDeclarationTable fields,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] fnKeyword)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    return AppendTypedMembersFromBody(
        table,
        source,
        stream,
        declarations,
        signatures,
        identifiers,
        calls,
        fields,
        ownerDeclarationIndex,
        ownerNameToken,
        signature.Name(),
        body);
}

internal fn System.Memory.MemoryStatus AppendTypedMembersForMemberFunctions(
    mut borrow TypedMemberExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedFieldDeclarationTable fields,
    DeclItem item,
    u32[0 max] ownerDeclarationIndex)
{
    if (!TypedSignatureDeclarationCanOwnMethods(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, item);
    if (bodyOpen == 0 || bodyOpen >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Fn)
        {
            switch (AppendTypedMembersForFunction(table, source, stream, declarations, signatures, identifiers, calls, fields, ownerDeclarationIndex, item.NameToken, scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn ParseResult<TypedCallExpressionTable> BuildTypedMemberCallExpressions(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers)
{
    stack mut TypedMemberExpressionTable emptyMembers = new();
    return BuildTypedCallExpressionsFromDependencies(source, stream, declarations, signatures, literals, identifiers, emptyMembers);
}

internal fn ParseResult<TypedMemberExpressionTable> BuildTypedMemberExpressionsFromDependencies(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedFieldDeclarationTable fields)
{
    stack mut TypedMemberExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedMembersFromGlobalDeclaration(
            table,
            source,
            stream,
            declarations,
            signatures,
            identifiers,
            calls,
            fields,
            item,
            (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedMemberExpressionTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedMembersForFunction(table, source, stream, declarations, signatures, identifiers, calls, fields, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedMemberExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedMembersForMemberFunctions(table, source, stream, declarations, signatures, identifiers, calls, fields, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberError):
                    return ParseResult<TypedMemberExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedMemberExpressionTable>.Ok(table);
}

internal struct TypedMemberCallDependencySet
{
    TypedCallExpressionTable Calls;
    TypedMemberExpressionTable Members;

    TypedMemberCallDependencySet()
    {
        self.Calls = new();
        self.Members = new();
    }
}

internal fn ParseResult<TypedMemberCallDependencySet> BuildTypedMemberCallDependencies(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedFieldDeclarationTable fields,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers)
{
    stack mut TypedMemberExpressionTable emptyMembers = new();
    stack mut TypedCallExpressionTable calls = new();
    switch (BuildTypedCallExpressionsFromDependencies(source, stream, declarations, signatures, literals, identifiers, emptyMembers))
    {
        case ParseResult<TypedCallExpressionTable>.Err(var callError):
            return ParseResult<TypedMemberCallDependencySet>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedCallExpressionTable>.Ok(var builtCalls):
            calls = builtCalls;
    }

    stack mut TypedMemberExpressionTable members = new();
    switch (BuildTypedMemberExpressionsFromDependencies(source, stream, declarations, signatures, identifiers, calls, fields))
    {
        case ParseResult<TypedMemberExpressionTable>.Err(var memberError):
            return ParseResult<TypedMemberCallDependencySet>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedMemberExpressionTable>.Ok(var builtMembers):
            members = builtMembers;
    }

    switch (BuildTypedCallExpressionsFromDependencies(source, stream, declarations, signatures, literals, identifiers, members))
    {
        case ParseResult<TypedCallExpressionTable>.Err(var callError):
            return ParseResult<TypedMemberCallDependencySet>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedCallExpressionTable>.Ok(var builtCalls):
            calls = builtCalls;
    }

    switch (BuildTypedMemberExpressionsFromDependencies(source, stream, declarations, signatures, identifiers, calls, fields))
    {
        case ParseResult<TypedMemberExpressionTable>.Err(var memberError):
            return ParseResult<TypedMemberCallDependencySet>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedMemberExpressionTable>.Ok(var builtMembers):
            members = builtMembers;
    }

    switch (BuildTypedCallExpressionsFromDependencies(source, stream, declarations, signatures, literals, identifiers, members))
    {
        case ParseResult<TypedCallExpressionTable>.Err(var callError):
            return ParseResult<TypedMemberCallDependencySet>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedCallExpressionTable>.Ok(var builtCalls):
            calls = builtCalls;
    }

    stack mut TypedMemberCallDependencySet result = new();
    result.Calls = calls;
    result.Members = members;
    return ParseResult<TypedMemberCallDependencySet>.Ok(result);
}

public fn ParseResult<TypedMemberExpressionTable> BuildTypedMemberExpressions(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedFunctionSignatureTable signatures = new();
    switch (BuildTypedFunctionSignatures(source, stream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return ParseResult<TypedMemberExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFunctionSignatureTable>.Ok(var builtSignatures):
            signatures = builtSignatures;
    }

    stack mut TypedFieldDeclarationTable fields = new();
    switch (BuildTypedStructRecordFields(source, stream, declarations))
    {
        case ParseResult<TypedFieldDeclarationTable>.Err(var fieldError):
            return ParseResult<TypedMemberExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFieldDeclarationTable>.Ok(var builtFields):
            fields = builtFields;
    }

    stack mut TypedLiteralExpressionTable literals = new();
    switch (BuildTypedLiteralExpressions(source, stream, declarations))
    {
        case ParseResult<TypedLiteralExpressionTable>.Err(var literalError):
            return ParseResult<TypedMemberExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedLiteralExpressionTable>.Ok(var builtLiterals):
            literals = builtLiterals;
    }

    stack mut TypedIdentifierExpressionTable identifiers = new();
    switch (BuildTypedIdentifierExpressions(source, stream, declarations))
    {
        case ParseResult<TypedIdentifierExpressionTable>.Err(var identifierError):
            return ParseResult<TypedMemberExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIdentifierExpressionTable>.Ok(var builtIdentifiers):
            identifiers = builtIdentifiers;
    }

    switch (BuildTypedMemberCallDependencies(source, stream, declarations, signatures, fields, literals, identifiers))
    {
        case ParseResult<TypedMemberCallDependencySet>.Err(var dependencyError):
            return ParseResult<TypedMemberExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedMemberCallDependencySet>.Ok(var dependencies):
            return ParseResult<TypedMemberExpressionTable>.Ok(dependencies.Members);
    }
}

internal finite law TypedMemberContext TypedIndexMemberContext(TypedIndexContext context)
{
    if (context == TypedIndexContext.GlobalInitializer)
    {
        return TypedMemberContext.GlobalInitializer;
    }

    if (context == TypedIndexContext.FunctionBody)
    {
        return TypedMemberContext.FunctionBody;
    }

    return TypedMemberContext.Unknown;
}

internal fn u32[0 max] TypedIndexExpressionIndexForNode(
    borrow TypedIndexExpressionTable table,
    TypedIndexContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && table.ContextAt(index) == context
            && table.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && table.OwnerNameTokenAt(index) == ownerNameToken
            && table.FunctionNameTokenAt(index) == functionNameToken
            && table.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && table.IndexNodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn void TypedIndexCopyFacts(borrow TypedMemberTypeFacts sourceFacts, mut borrow TypedMemberTypeFacts targetFacts)
{
    targetFacts.ReceiverKind = sourceFacts.ReceiverKind;
    targetFacts.DeclarationIndex = sourceFacts.DeclarationIndex;
    targetFacts.NameToken = sourceFacts.NameToken;
    targetFacts.TypeKind = sourceFacts.TypeKind;
    targetFacts.TypeHeadToken = sourceFacts.TypeHeadToken;
    targetFacts.TypePrimaryToken = sourceFacts.TypePrimaryToken;
    targetFacts.TypeStartToken = sourceFacts.TypeStartToken;
    targetFacts.TypeEndToken = sourceFacts.TypeEndToken;
    targetFacts.RangeStartToken = sourceFacts.RangeStartToken;
    targetFacts.RangeEndToken = sourceFacts.RangeEndToken;
    targetFacts.ElementCountStartToken = sourceFacts.ElementCountStartToken;
    targetFacts.ElementCountEndToken = sourceFacts.ElementCountEndToken;
    targetFacts.BitWidth = sourceFacts.BitWidth;
    targetFacts.TypeArgumentCount = sourceFacts.TypeArgumentCount;
    targetFacts.ComptimeArgumentCount = sourceFacts.ComptimeArgumentCount;
    targetFacts.TypeFlags = sourceFacts.TypeFlags;
}

internal fn void TypedIndexFactsFromIndex(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIndexExpressionTable table,
    u32[0 max] indexIndexPlusOne,
    mut borrow TypedMemberTypeFacts facts)
{
    if (indexIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(indexIndexPlusOne - 1);
    facts.ReceiverKind = TypedMemberReceiverKind.Value;
    facts.TypeKind = table.TypeKindAt(index);
    facts.TypeHeadToken = table.TypeHeadTokenAt(index);
    facts.TypePrimaryToken = table.TypePrimaryTokenAt(index);
    facts.TypeStartToken = table.TypeStartTokenAt(index);
    facts.TypeEndToken = table.TypeEndTokenAt(index);
    facts.RangeStartToken = table.RangeStartTokenAt(index);
    facts.RangeEndToken = table.RangeEndTokenAt(index);
    facts.ElementCountStartToken = table.ElementCountStartTokenAt(index);
    facts.ElementCountEndToken = table.ElementCountEndTokenAt(index);
    facts.BitWidth = table.BitWidthAt(index);
    facts.TypeArgumentCount = table.TypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = table.ComptimeArgumentCountAt(index);
    facts.TypeFlags = table.TypeFlagsAt(index);
    facts.DeclarationIndex = TypedMemberDeclarationIndexForTypeHead(source, stream, declarations, facts.TypeHeadToken);
}

internal fn void TypedIndexFactsFromSpan(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    mut borrow TypedMemberTypeFacts facts)
{
    stack mut TypedSignatureTypeKind typeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] typeHeadToken = 0;
    stack mut u32[0 max] typePrimaryToken = 0;
    stack mut u32[0 max] rangeStartToken = 0;
    stack mut u32[0 max] rangeEndToken = 0;
    stack mut u32[0 max] elementCountStartToken = 0;
    stack mut u32[0 max] elementCountEndToken = 0;
    stack mut u32[0 max] bitWidth = 0;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    stack mut u32[0 max] typeFlags = 0;
    TypedCallTypeSpanFacts(
        source,
        stream,
        typeStartToken,
        typeEndToken,
        typeKind,
        typeHeadToken,
        typePrimaryToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        elementCountEndToken,
        bitWidth,
        typeArgumentCount,
        comptimeArgumentCount,
        typeFlags);

    facts.ReceiverKind = TypedMemberReceiverKind.Value;
    facts.TypeKind = typeKind;
    facts.TypeHeadToken = typeHeadToken;
    facts.TypePrimaryToken = typePrimaryToken;
    facts.TypeStartToken = typeStartToken;
    facts.TypeEndToken = typeEndToken;
    facts.RangeStartToken = rangeStartToken;
    facts.RangeEndToken = rangeEndToken;
    facts.ElementCountStartToken = elementCountStartToken;
    facts.ElementCountEndToken = elementCountEndToken;
    facts.BitWidth = bitWidth;
    facts.TypeArgumentCount = typeArgumentCount;
    facts.ComptimeArgumentCount = comptimeArgumentCount;
    facts.TypeFlags = typeFlags;
    facts.DeclarationIndex = TypedMemberDeclarationIndexForTypeHead(source, stream, declarations, typeHeadToken);
}

internal fn void TypedIndexPreserveGenericElementFacts(borrow TypedMemberTypeFacts receiver, mut borrow TypedMemberTypeFacts element)
{
    if (TypedSignatureFlagPresent(receiver.TypeFlags, TypedSignatureTypeFlagHeadIsGenericParameter())
        && receiver.TypeHeadToken != 0
        && receiver.TypeHeadToken == element.TypeHeadToken)
    {
        element.TypeKind = TypedSignatureTypeKind.GenericParameter;
        element.TypeFlags = element.TypeFlags | TypedSignatureTypeFlagHeadIsGenericParameter();
    }
}

internal fn bool TypedIndexElementSpanFromReceiver(
    borrow TokenStream stream,
    borrow TypedMemberTypeFacts receiver,
    out u32[0 max] elementStartToken,
    out u32[0 max] elementEndToken)
{
    elementStartToken = 0;
    elementEndToken = 0;
    if (receiver.TypeStartToken == 0 || receiver.TypeEndToken <= receiver.TypeStartToken)
    {
        return false;
    }

    if ((receiver.TypeKind == TypedSignatureTypeKind.FixedArray || receiver.TypeKind == TypedSignatureTypeKind.Slice)
        && receiver.ElementCountStartToken > receiver.TypeStartToken)
    {
        elementStartToken = receiver.TypeStartToken;
        elementEndToken = receiver.ElementCountStartToken;
        return elementEndToken > elementStartToken;
    }

    if (receiver.TypeKind == TypedSignatureTypeKind.Dynamic
        && receiver.TypePrimaryToken != 0
        && receiver.TypeEndToken > (u32[0 max])(receiver.TypePrimaryToken + 1))
    {
        elementStartToken = (u32[0 max])(receiver.TypePrimaryToken + 1);
        elementEndToken = receiver.TypeEndToken;
        return true;
    }

    if (receiver.TypeKind == TypedSignatureTypeKind.RawPointer && receiver.TypePrimaryToken != 0)
    {
        stack u32[0 max] openToken = (u32[0 max])(receiver.TypePrimaryToken + 1);
        if (stream.KindAt((u64[0 2 ** 63 - 1])openToken) == TokenKind.Lt)
        {
            stack u32[0 max] closeToken = TypedSignatureMatchingCloseToken(stream, openToken);
            if (closeToken > openToken)
            {
                elementStartToken = (u32[0 max])(openToken + 1);
                elementEndToken = closeToken;
                return elementEndToken > elementStartToken;
            }
        }
    }

    return false;
}

internal fn void TypedIndexElementFactsFromReceiver(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedMemberTypeFacts receiver,
    mut borrow TypedMemberTypeFacts element)
{
    stack mut u32[0 max] elementStartToken = 0;
    stack mut u32[0 max] elementEndToken = 0;
    if (!TypedIndexElementSpanFromReceiver(stream, receiver, elementStartToken, elementEndToken))
    {
        return;
    }

    TypedIndexFactsFromSpan(source, stream, declarations, elementStartToken, elementEndToken, element);
    TypedIndexPreserveGenericElementFacts(receiver, element);
}

internal finite law TypedIndexReceiverKind TypedIndexReceiverKindForType(TypedSignatureTypeKind typeKind)
{
    if (typeKind == TypedSignatureTypeKind.FixedArray)
    {
        return TypedIndexReceiverKind.FixedArray;
    }

    if (typeKind == TypedSignatureTypeKind.Slice)
    {
        return TypedIndexReceiverKind.Slice;
    }

    if (typeKind == TypedSignatureTypeKind.Dynamic)
    {
        return TypedIndexReceiverKind.Dynamic;
    }

    if (typeKind == TypedSignatureTypeKind.RawPointer)
    {
        return TypedIndexReceiverKind.RawPointer;
    }

    if (typeKind == TypedSignatureTypeKind.Text)
    {
        return TypedIndexReceiverKind.Text;
    }

    return TypedIndexReceiverKind.Unknown;
}

internal finite law TypedIndexAccessKind TypedIndexAccessKindForReceiver(TypedIndexReceiverKind receiverKind, TypedIndexOperationKind operationKind)
{
    if (receiverKind == TypedIndexReceiverKind.Text)
    {
        if (operationKind == TypedIndexOperationKind.Slice)
        {
            return TypedIndexAccessKind.TextSlice;
        }

        return TypedIndexAccessKind.TextElement;
    }

    if (receiverKind == TypedIndexReceiverKind.Dynamic)
    {
        if (operationKind == TypedIndexOperationKind.Slice)
        {
            return TypedIndexAccessKind.DynamicSlice;
        }

        return TypedIndexAccessKind.DynamicElement;
    }

    if (receiverKind == TypedIndexReceiverKind.RawPointer)
    {
        if (operationKind == TypedIndexOperationKind.Slice)
        {
            return TypedIndexAccessKind.RawPointerRegion;
        }

        return TypedIndexAccessKind.RawPointerElement;
    }

    if (receiverKind == TypedIndexReceiverKind.FixedArray || receiverKind == TypedIndexReceiverKind.Slice)
    {
        if (operationKind == TypedIndexOperationKind.Slice)
        {
            return TypedIndexAccessKind.Slice;
        }

        return TypedIndexAccessKind.Element;
    }

    return TypedIndexAccessKind.Unknown;
}

internal fn void TypedIndexResultFactsFromReceiver(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedMemberTypeFacts receiver,
    TypedIndexOperationKind operationKind,
    TypedIndexReceiverKind receiverKind,
    mut borrow TypedMemberTypeFacts result)
{
    if (receiverKind == TypedIndexReceiverKind.Text)
    {
        TypedIndexCopyFacts(receiver, result);
        return;
    }

    if (receiverKind == TypedIndexReceiverKind.RawPointer && operationKind == TypedIndexOperationKind.Slice)
    {
        TypedIndexCopyFacts(receiver, result);
        return;
    }

    stack mut TypedMemberTypeFacts element = new();
    TypedIndexElementFactsFromReceiver(source, stream, declarations, receiver, element);
    if (element.TypeKind == TypedSignatureTypeKind.Unknown)
    {
        return;
    }

    TypedIndexCopyFacts(element, result);
    if (operationKind == TypedIndexOperationKind.Slice)
    {
        result.TypeKind = TypedSignatureTypeKind.Slice;
        result.ElementCountStartToken = 0;
        result.ElementCountEndToken = 0;
        result.TypeFlags = result.TypeFlags & ~TypedSignatureTypeFlagHasElementCountExpression();
    }
}

internal fn void TypedIndexReceiverFactsFromTreeNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow ExprTree tree,
    TypedIndexContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] receiverNode,
    mut borrow TypedMemberTypeFacts facts)
{
    stack TypedMemberContext memberContext = TypedIndexMemberContext(context);
    TypedMemberReceiverFactsFromTreeNode(
        source,
        stream,
        declarations,
        identifiers,
        calls,
        members,
        tree,
        memberContext,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        receiverNode,
        facts);

    if (facts.TypeKind == TypedSignatureTypeKind.Unknown && tree.NodeKindAt(receiverNode) == Compiler.Parsing.ExprKind.Index)
    {
        stack u32[0 max] indexIndexPlusOne = TypedIndexExpressionIndexForNode(
            indexes,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            receiverNode);
        TypedIndexFactsFromIndex(source, stream, declarations, indexes, indexIndexPlusOne, facts);
    }
}

internal fn void TypedIndexReceiverFactsFromBodyNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow StatementList body,
    TypedIndexContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] receiverNode,
    mut borrow TypedMemberTypeFacts facts)
{
    stack TypedMemberContext memberContext = TypedIndexMemberContext(context);
    TypedMemberReceiverFactsFromBodyNode(
        source,
        stream,
        declarations,
        identifiers,
        calls,
        members,
        body,
        memberContext,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        receiverNode,
        facts);

    if (facts.TypeKind == TypedSignatureTypeKind.Unknown && body.ExprKindAt(receiverNode) == Compiler.Parsing.ExprKind.Index)
    {
        stack u32[0 max] indexIndexPlusOne = TypedIndexExpressionIndexForNode(
            indexes,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            receiverNode);
        TypedIndexFactsFromIndex(source, stream, declarations, indexes, indexIndexPlusOne, facts);
    }
}

internal fn System.Memory.MemoryStatus AppendTypedIndexExpression(
    mut borrow TypedIndexExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    TypedIndexContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] indexNode,
    u32[0 max] receiverNode,
    u32[0 max] indexToken,
    u32[0 max] startNode,
    u32[0 max] lengthNode,
    borrow TypedMemberTypeFacts receiver)
{
    stack mut TypedIndexOperationKind operationKind = TypedIndexOperationKind.Index;
    if (lengthNode != 0)
    {
        operationKind = TypedIndexOperationKind.Slice;
    }

    stack TypedIndexReceiverKind receiverKind = TypedIndexReceiverKindForType(receiver.TypeKind);
    stack TypedIndexAccessKind accessKind = TypedIndexAccessKindForReceiver(receiverKind, operationKind);
    stack mut TypedMemberTypeFacts result = new();
    TypedIndexResultFactsFromReceiver(source, stream, declarations, receiver, operationKind, receiverKind, result);

    stack mut u32[0 max] flags = 0;
    if (receiverKind != TypedIndexReceiverKind.Unknown)
    {
        flags = flags | TypedIndexFlagReceiverResolved();
    }

    if (result.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        flags = flags | TypedIndexFlagResultResolved();
    }

    if (operationKind == TypedIndexOperationKind.Slice)
    {
        flags = flags | TypedIndexFlagSlice();
    }

    if (receiverKind == TypedIndexReceiverKind.Text)
    {
        flags = flags | TypedIndexFlagText();
    }

    if (receiverKind == TypedIndexReceiverKind.RawPointer)
    {
        flags = flags | TypedIndexFlagRawPointer();
    }

    return table.AppendIndex(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        indexNode,
        receiverNode,
        indexToken,
        startNode,
        lengthNode,
        operationKind,
        accessKind,
        receiverKind,
        receiver.DeclarationIndex,
        receiver.NameToken,
        receiver.TypeKind,
        receiver.TypeHeadToken,
        receiver.TypePrimaryToken,
        receiver.TypeStartToken,
        receiver.TypeEndToken,
        receiver.RangeStartToken,
        receiver.RangeEndToken,
        receiver.ElementCountStartToken,
        receiver.ElementCountEndToken,
        receiver.BitWidth,
        receiver.TypeArgumentCount,
        receiver.ComptimeArgumentCount,
        receiver.TypeFlags,
        result.TypeKind,
        result.TypeHeadToken,
        result.TypePrimaryToken,
        result.TypeStartToken,
        result.TypeEndToken,
        result.RangeStartToken,
        result.RangeEndToken,
        result.ElementCountStartToken,
        result.ElementCountEndToken,
        result.BitWidth,
        result.TypeArgumentCount,
        result.ComptimeArgumentCount,
        result.TypeFlags,
        flags);
}

internal fn System.Memory.MemoryStatus AppendTypedIndexesFromGlobalDeclaration(
    mut borrow TypedIndexExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    DeclItem item,
    u32[0 max] declarationIndex)
{
    if (!TypedGlobalDeclarationKindIsGlobal(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] assignToken = TypedGlobalFindAssignToken(stream, item);
    if (assignToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] ownerNameToken = TypedGlobalFindNameToken(stream, item);
    stack ExprTree tree = ParseExpression(stream, (u32[0 max])(assignToken + 1));
    stack u64[0 2 ** 63 - 1] count = tree.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 1; index <= count; index += 1)
    {
        stack u32[0 max] node = (u32[0 max])index;
        if (tree.NodeKindAt(node) == Compiler.Parsing.ExprKind.Index)
        {
            stack mut TypedMemberTypeFacts receiver = new();
            stack u32[0 max] receiverNode = tree.LeftAt(node);
            TypedIndexReceiverFactsFromTreeNode(
                source,
                stream,
                declarations,
                identifiers,
                calls,
                members,
                table,
                tree,
                TypedIndexContext.GlobalInitializer,
                declarationIndex,
                ownerNameToken,
                0,
                0,
                receiverNode,
                receiver);
            switch (AppendTypedIndexExpression(
                table,
                source,
                stream,
                declarations,
                TypedIndexContext.GlobalInitializer,
                declarationIndex,
                ownerNameToken,
                0,
                0,
                node,
                receiverNode,
                tree.TokenAt(node),
                tree.RightAt(node),
                tree.AuxAt(node),
                receiver))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedIndexesFromBodyStatement(
    mut borrow TypedIndexExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statementIndex)
{
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    stack u32[0 max] start = (u32[0 max])(body.ExprStartAt(statementIndex) + 1);
    stack mut u32[0 max] end = (u32[0 max])body.ExprNodeCount();
    if (statementIndex + 1 < statementCount)
    {
        end = body.ExprStartAt((u64[0 2 ** 63 - 1])(statementIndex + 1));
    }

    if (start > end)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] statementIndexPlusOne = (u32[0 max])(statementIndex + 1);
    stack u64[0 2 ** 63 - 1] endIndex = (u64[0 2 ** 63 - 1])end;
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])start; nodeIndex <= endIndex; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Index)
        {
            stack mut TypedMemberTypeFacts receiver = new();
            stack u32[0 max] receiverNode = body.ExprLeftAt(node);
            TypedIndexReceiverFactsFromBodyNode(
                source,
                stream,
                declarations,
                identifiers,
                calls,
                members,
                table,
                body,
                TypedIndexContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                receiverNode,
                receiver);
            switch (AppendTypedIndexExpression(
                table,
                source,
                stream,
                declarations,
                TypedIndexContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                node,
                receiverNode,
                body.ExprTokenAt(node),
                body.ExprRightAt(node),
                body.ExprAuxAt(node),
                receiver))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedIndexesFromBody(
    mut borrow TypedIndexExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedIndexesFromBodyStatement(
            table,
            source,
            stream,
            declarations,
            identifiers,
            calls,
            members,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            body,
            index))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedIndexesForFunction(
    mut borrow TypedIndexExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] fnKeyword)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    return AppendTypedIndexesFromBody(
        table,
        source,
        stream,
        declarations,
        identifiers,
        calls,
        members,
        ownerDeclarationIndex,
        ownerNameToken,
        signature.Name(),
        body);
}

internal fn System.Memory.MemoryStatus AppendTypedIndexesForMemberFunctions(
    mut borrow TypedIndexExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    DeclItem item,
    u32[0 max] ownerDeclarationIndex)
{
    if (!TypedSignatureDeclarationCanOwnMethods(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, item);
    if (bodyOpen == 0 || bodyOpen >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Fn)
        {
            switch (AppendTypedIndexesForFunction(table, source, stream, declarations, identifiers, calls, members, ownerDeclarationIndex, item.NameToken, scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn ParseResult<TypedIndexExpressionTable> BuildTypedIndexExpressionsFromDependencies(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members)
{
    stack mut TypedIndexExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedIndexesFromGlobalDeclaration(
            table,
            source,
            stream,
            declarations,
            identifiers,
            calls,
            members,
            item,
            (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedIndexExpressionTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedIndexesForFunction(table, source, stream, declarations, identifiers, calls, members, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedIndexExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedIndexesForMemberFunctions(table, source, stream, declarations, identifiers, calls, members, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberFunctionError):
                    return ParseResult<TypedIndexExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedIndexExpressionTable>.Ok(table);
}

public fn ParseResult<TypedIndexExpressionTable> BuildTypedIndexExpressions(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedFunctionSignatureTable signatures = new();
    switch (BuildTypedFunctionSignatures(source, stream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return ParseResult<TypedIndexExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFunctionSignatureTable>.Ok(var builtSignatures):
            signatures = builtSignatures;
    }

    stack mut TypedFieldDeclarationTable fields = new();
    switch (BuildTypedStructRecordFields(source, stream, declarations))
    {
        case ParseResult<TypedFieldDeclarationTable>.Err(var fieldError):
            return ParseResult<TypedIndexExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFieldDeclarationTable>.Ok(var builtFields):
            fields = builtFields;
    }

    stack mut TypedLiteralExpressionTable literals = new();
    switch (BuildTypedLiteralExpressions(source, stream, declarations))
    {
        case ParseResult<TypedLiteralExpressionTable>.Err(var literalError):
            return ParseResult<TypedIndexExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedLiteralExpressionTable>.Ok(var builtLiterals):
            literals = builtLiterals;
    }

    stack mut TypedIdentifierExpressionTable identifiers = new();
    switch (BuildTypedIdentifierExpressions(source, stream, declarations))
    {
        case ParseResult<TypedIdentifierExpressionTable>.Err(var identifierError):
            return ParseResult<TypedIndexExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIdentifierExpressionTable>.Ok(var builtIdentifiers):
            identifiers = builtIdentifiers;
    }

    stack mut TypedCallExpressionTable calls = new();
    stack mut TypedMemberExpressionTable members = new();
    switch (BuildTypedMemberCallDependencies(source, stream, declarations, signatures, fields, literals, identifiers))
    {
        case ParseResult<TypedMemberCallDependencySet>.Err(var dependencyError):
            return ParseResult<TypedIndexExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedMemberCallDependencySet>.Ok(var dependencies):
            calls = dependencies.Calls;
            members = dependencies.Members;
    }

    return BuildTypedIndexExpressionsFromDependencies(source, stream, declarations, identifiers, calls, members);
}

internal finite law TypedIdentifierContext TypedAssignmentIdentifierContext(TypedAssignmentContext context)
{
    if (context == TypedAssignmentContext.GlobalInitializer)
    {
        return TypedIdentifierContext.GlobalInitializer;
    }

    if (context == TypedAssignmentContext.FunctionBody)
    {
        return TypedIdentifierContext.FunctionBody;
    }

    return TypedIdentifierContext.Unknown;
}

internal finite law TypedLiteralContext TypedAssignmentLiteralContext(TypedAssignmentContext context)
{
    if (context == TypedAssignmentContext.GlobalInitializer)
    {
        return TypedLiteralContext.GlobalInitializer;
    }

    if (context == TypedAssignmentContext.FunctionBody)
    {
        return TypedLiteralContext.FunctionBody;
    }

    return TypedLiteralContext.Unknown;
}

internal finite law TypedMemberContext TypedAssignmentMemberContext(TypedAssignmentContext context)
{
    if (context == TypedAssignmentContext.GlobalInitializer)
    {
        return TypedMemberContext.GlobalInitializer;
    }

    if (context == TypedAssignmentContext.FunctionBody)
    {
        return TypedMemberContext.FunctionBody;
    }

    return TypedMemberContext.Unknown;
}

internal finite law TypedIndexContext TypedAssignmentIndexContext(TypedAssignmentContext context)
{
    if (context == TypedAssignmentContext.GlobalInitializer)
    {
        return TypedIndexContext.GlobalInitializer;
    }

    if (context == TypedAssignmentContext.FunctionBody)
    {
        return TypedIndexContext.FunctionBody;
    }

    return TypedIndexContext.Unknown;
}

internal finite law TypedAssignmentOperatorKind TypedAssignmentOperatorKindForToken(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Assign:
            return TypedAssignmentOperatorKind.Assign;
        case TokenKind.AddAssign:
            return TypedAssignmentOperatorKind.AddAssign;
        case TokenKind.SubAssign:
            return TypedAssignmentOperatorKind.SubAssign;
        case TokenKind.MulAssign:
            return TypedAssignmentOperatorKind.MulAssign;
        case TokenKind.DivAssign:
            return TypedAssignmentOperatorKind.DivAssign;
        case TokenKind.ModAssign:
            return TypedAssignmentOperatorKind.ModAssign;
        case TokenKind.AndAssign:
            return TypedAssignmentOperatorKind.AndAssign;
        case TokenKind.OrAssign:
            return TypedAssignmentOperatorKind.OrAssign;
        case TokenKind.XorAssign:
            return TypedAssignmentOperatorKind.XorAssign;
        case TokenKind.WrapAddAssign:
            return TypedAssignmentOperatorKind.WrapAddAssign;
        case TokenKind.WrapSubAssign:
            return TypedAssignmentOperatorKind.WrapSubAssign;
        case TokenKind.WrapMulAssign:
            return TypedAssignmentOperatorKind.WrapMulAssign;
        case TokenKind.SatAddAssign:
            return TypedAssignmentOperatorKind.SatAddAssign;
        case TokenKind.SatSubAssign:
            return TypedAssignmentOperatorKind.SatSubAssign;
        case TokenKind.SatMulAssign:
            return TypedAssignmentOperatorKind.SatMulAssign;
        default:
            return TypedAssignmentOperatorKind.Unknown;
    }
}

internal finite law bool TypedAssignmentOperatorIsCompound(TypedAssignmentOperatorKind kind)
{
    return kind != TypedAssignmentOperatorKind.Assign && kind != TypedAssignmentOperatorKind.Unknown;
}

internal finite law bool TypedAssignmentIndexAccessKindIsSlice(TypedIndexAccessKind kind)
{
    return kind == TypedIndexAccessKind.Slice
        || kind == TypedIndexAccessKind.TextSlice
        || kind == TypedIndexAccessKind.DynamicSlice
        || kind == TypedIndexAccessKind.RawPointerRegion;
}

internal fn u32[0 max] TypedAssignmentExpressionIndexForNode(
    borrow TypedAssignmentExpressionTable table,
    TypedAssignmentContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = table.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && table.ContextAt(index) == context
            && table.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && table.OwnerNameTokenAt(index) == ownerNameToken
            && table.FunctionNameTokenAt(index) == functionNameToken
            && table.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && table.AssignmentNodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn u32[0 max] TypedAssignmentLiteralIndexForNode(
    borrow TypedLiteralExpressionTable literals,
    TypedAssignmentContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node)
{
    stack TypedLiteralContext literalContext = TypedAssignmentLiteralContext(context);
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = literals.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && literals.ContextAt(index) == literalContext
            && literals.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && literals.OwnerNameTokenAt(index) == ownerNameToken
            && literals.FunctionNameTokenAt(index) == functionNameToken
            && literals.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && literals.ExprNodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn void TypedAssignmentFactsFromLiteral(
    borrow TypedLiteralExpressionTable literals,
    u32[0 max] literalIndexPlusOne,
    mut borrow TypedMemberTypeFacts facts)
{
    if (literalIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(literalIndexPlusOne - 1);
    facts.TypeKind = literals.TypeKindAt(index);
    facts.BitWidth = literals.BitWidthAt(index);
    facts.TypeFlags = literals.TypeFlagsAt(index);
    if (facts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        facts.ReceiverKind = TypedMemberReceiverKind.Value;
    }
}

internal fn void TypedAssignmentFactsFromAssignment(
    borrow TypedAssignmentExpressionTable assignments,
    u32[0 max] assignmentIndexPlusOne,
    mut borrow TypedMemberTypeFacts facts)
{
    if (assignmentIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(assignmentIndexPlusOne - 1);
    facts.ReceiverKind = TypedMemberReceiverKind.Value;
    facts.DeclarationIndex = assignments.TargetDeclarationIndexAt(index);
    facts.NameToken = assignments.TargetNameTokenAt(index);
    facts.TypeKind = assignments.TargetTypeKindAt(index);
    facts.TypeHeadToken = assignments.TargetTypeHeadTokenAt(index);
    facts.TypePrimaryToken = assignments.TargetTypePrimaryTokenAt(index);
    facts.TypeStartToken = assignments.TargetTypeStartTokenAt(index);
    facts.TypeEndToken = assignments.TargetTypeEndTokenAt(index);
    facts.RangeStartToken = assignments.TargetRangeStartTokenAt(index);
    facts.RangeEndToken = assignments.TargetRangeEndTokenAt(index);
    facts.ElementCountStartToken = assignments.TargetElementCountStartTokenAt(index);
    facts.ElementCountEndToken = assignments.TargetElementCountEndTokenAt(index);
    facts.BitWidth = assignments.TargetBitWidthAt(index);
    facts.TypeArgumentCount = assignments.TargetTypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = assignments.TargetComptimeArgumentCountAt(index);
    facts.TypeFlags = assignments.TargetTypeFlagsAt(index);
}

internal finite law TypedConversionContext TypedAssignmentConversionContext(TypedAssignmentContext context)
{
    if (context == TypedAssignmentContext.GlobalInitializer)
    {
        return TypedConversionContext.GlobalInitializer;
    }

    if (context == TypedAssignmentContext.FunctionBody)
    {
        return TypedConversionContext.FunctionBody;
    }

    return TypedConversionContext.Unknown;
}

