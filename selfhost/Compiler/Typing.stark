            if (targetNameToken == 0)
            {
                targetNameToken = identifiers.NameTokenAt(identifierIndex);
            }
        }

        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Member)
    {
        stack u32[0 max] memberIndexPlusOne = TypedMemberExpressionIndexForNode(
            members,
            TypedAssignmentMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            targetNode);
        TypedMemberFactsFromMember(source, stream, declarations, members, memberIndexPlusOne, targetFacts);
        if (memberIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] memberIndex = (u64[0 2 ** 63 - 1])(memberIndexPlusOne - 1);
            stack TypedMemberTargetKind resolvedMemberTargetKind = members.TargetKindAt(memberIndex);
            memberTargetKind = resolvedMemberTargetKind;
            if (resolvedMemberTargetKind == TypedMemberTargetKind.Field)
            {
                targetKind = TypedAssignmentTargetKind.Field;
            }

            targetDeclarationIndex = members.TargetDeclarationIndexAt(memberIndex);
            targetSymbolIndexPlusOne = members.TargetSymbolIndexPlusOneAt(memberIndex);
            targetNameToken = members.TargetNameTokenAt(memberIndex);
        }

        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Index)
    {
        stack u32[0 max] indexIndexPlusOne = TypedIndexExpressionIndexForNode(
            indexes,
            TypedAssignmentIndexContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            targetNode);
        TypedIndexFactsFromIndex(source, stream, declarations, indexes, indexIndexPlusOne, targetFacts);
        if (indexIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] indexIndex = (u64[0 2 ** 63 - 1])(indexIndexPlusOne - 1);
            stack TypedIndexAccessKind resolvedAccessKind = indexes.AccessKindAt(indexIndex);
            indexAccessKind = resolvedAccessKind;
            if (TypedAssignmentIndexAccessKindIsSlice(resolvedAccessKind))
            {
                targetKind = TypedAssignmentTargetKind.IndexSlice;
            }
            else
            {
                targetKind = TypedAssignmentTargetKind.IndexElement;
            }

            targetDeclarationIndex = targetFacts.DeclarationIndex;
            targetNameToken = targetFacts.NameToken;
        }
    }
}

internal fn void TypedAssignmentValueFactsFromTreeNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    borrow TypedAssignmentExpressionTable assignments,
    borrow ExprTree tree,
    TypedAssignmentContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] valueNode,
    mut borrow TypedMemberTypeFacts valueFacts,
    out TypedAssignmentValueKind valueKind)
{
    valueKind = TypedAssignmentValueKind.Unknown;
    stack ExprKind kind = tree.NodeKindAt(valueNode);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        valueKind = TypedAssignmentValueKind.Identifier;
        stack u32[0 max] identifierIndexPlusOne = TypedMemberIdentifierIndexForNode(
            identifiers,
            TypedAssignmentMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedMemberFactsFromIdentifier(source, stream, declarations, identifiers, identifierIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Member)
    {
        valueKind = TypedAssignmentValueKind.Member;
        stack u32[0 max] memberIndexPlusOne = TypedMemberExpressionIndexForNode(
            members,
            TypedAssignmentMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedMemberFactsFromMember(source, stream, declarations, members, memberIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Call)
    {
        valueKind = TypedAssignmentValueKind.Call;
        stack u32[0 max] callIndexPlusOne = TypedMemberCallIndexForNode(
            calls,
            TypedAssignmentMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedMemberFactsFromCall(source, stream, declarations, calls, callIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Index)
    {
        valueKind = TypedAssignmentValueKind.Index;
        stack u32[0 max] indexIndexPlusOne = TypedIndexExpressionIndexForNode(
            indexes,
            TypedAssignmentIndexContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedIndexFactsFromIndex(source, stream, declarations, indexes, indexIndexPlusOne, valueFacts);
        return;
    }

    if (TypedLiteralExprKindIsLiteral(kind))
    {
        valueKind = TypedAssignmentValueKind.Literal;
        stack u32[0 max] literalIndexPlusOne = TypedAssignmentLiteralIndexForNode(
            literals,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedAssignmentFactsFromLiteral(literals, literalIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.New)
    {
        valueKind = TypedAssignmentValueKind.New;
        stack u32[0 max] typeNode = tree.LeftAt(valueNode);
        if (typeNode != 0 && tree.NodeKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            TypedMemberFactsFromNewTypeNode(source, stream, declarations, tree.TokenAt(typeNode), valueFacts);
        }

        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Conversion)
    {
        valueKind = TypedAssignmentValueKind.Conversion;
        stack u32[0 max] conversionIndexPlusOne = TypedConversionExpressionIndexForNode(
            conversions,
            TypedAssignmentConversionContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedConversionTargetFactsFromConversion(conversions, conversionIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Assign)
    {
        valueKind = TypedAssignmentValueKind.Assignment;
        stack u32[0 max] assignmentIndexPlusOne = TypedAssignmentExpressionIndexForNode(
            assignments,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedAssignmentFactsFromAssignment(assignments, assignmentIndexPlusOne, valueFacts);
    }
}

internal fn void TypedAssignmentValueFactsFromBodyNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    borrow TypedAssignmentExpressionTable assignments,
    borrow StatementList body,
    TypedAssignmentContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] valueNode,
    mut borrow TypedMemberTypeFacts valueFacts,
    out TypedAssignmentValueKind valueKind)
{
    valueKind = TypedAssignmentValueKind.Unknown;
    stack ExprKind kind = body.ExprKindAt(valueNode);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        valueKind = TypedAssignmentValueKind.Identifier;
        stack u32[0 max] identifierIndexPlusOne = TypedMemberIdentifierIndexForNode(
            identifiers,
            TypedAssignmentMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedMemberFactsFromIdentifier(source, stream, declarations, identifiers, identifierIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Member)
    {
        valueKind = TypedAssignmentValueKind.Member;
        stack u32[0 max] memberIndexPlusOne = TypedMemberExpressionIndexForNode(
            members,
            TypedAssignmentMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedMemberFactsFromMember(source, stream, declarations, members, memberIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Call)
    {
        valueKind = TypedAssignmentValueKind.Call;
        stack u32[0 max] callIndexPlusOne = TypedMemberCallIndexForNode(
            calls,
            TypedAssignmentMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedMemberFactsFromCall(source, stream, declarations, calls, callIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Index)
    {
        valueKind = TypedAssignmentValueKind.Index;
        stack u32[0 max] indexIndexPlusOne = TypedIndexExpressionIndexForNode(
            indexes,
            TypedAssignmentIndexContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedIndexFactsFromIndex(source, stream, declarations, indexes, indexIndexPlusOne, valueFacts);
        return;
    }

    if (TypedLiteralExprKindIsLiteral(kind))
    {
        valueKind = TypedAssignmentValueKind.Literal;
        stack u32[0 max] literalIndexPlusOne = TypedAssignmentLiteralIndexForNode(
            literals,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedAssignmentFactsFromLiteral(literals, literalIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.New)
    {
        valueKind = TypedAssignmentValueKind.New;
        stack u32[0 max] typeNode = body.ExprLeftAt(valueNode);
        if (typeNode != 0 && body.ExprKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            TypedMemberFactsFromNewTypeNode(source, stream, declarations, body.ExprTokenAt(typeNode), valueFacts);
        }

        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Conversion)
    {
        valueKind = TypedAssignmentValueKind.Conversion;
        stack u32[0 max] conversionIndexPlusOne = TypedConversionExpressionIndexForNode(
            conversions,
            TypedAssignmentConversionContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedConversionTargetFactsFromConversion(conversions, conversionIndexPlusOne, valueFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Assign)
    {
        valueKind = TypedAssignmentValueKind.Assignment;
        stack u32[0 max] assignmentIndexPlusOne = TypedAssignmentExpressionIndexForNode(
            assignments,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode);
        TypedAssignmentFactsFromAssignment(assignments, assignmentIndexPlusOne, valueFacts);
    }
}

internal fn System.Memory.MemoryStatus AppendTypedAssignmentExpression(
    mut borrow TypedAssignmentExpressionTable table,
    borrow TokenStream stream,
    TypedAssignmentContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] assignmentNode,
    u32[0 max] assignmentToken,
    u32[0 max] targetNode,
    u32[0 max] valueNode,
    borrow TypedMemberTypeFacts targetFacts,
    TypedAssignmentTargetKind targetKind,
    TypedIdentifierTargetKind identifierTargetKind,
    TypedMemberTargetKind memberTargetKind,
    TypedIndexAccessKind indexAccessKind,
    u32[0 max] targetDeclarationIndex,
    u32[0 max] targetSymbolIndexPlusOne,
    u32[0 max] targetNameToken,
    TypedGlobalStorageKind targetStorageKind,
    TypedGlobalBindingKind targetBindingKind,
    borrow TypedMemberTypeFacts valueFacts,
    TypedAssignmentValueKind valueKind)
{
    stack TypedAssignmentOperatorKind operatorKind = TypedAssignmentOperatorKindForToken(stream.KindAt((u64[0 2 ** 63 - 1])assignmentToken));
    stack mut u32[0 max] flags = 0;
    if (targetFacts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        flags = flags | TypedAssignmentFlagTargetResolved();
    }

    if (valueFacts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        flags = flags | TypedAssignmentFlagValueResolved();
    }

    if (operatorKind == TypedAssignmentOperatorKind.Assign)
    {
        flags = flags | TypedAssignmentFlagSimple();
    }
    else if (TypedAssignmentOperatorIsCompound(operatorKind))
    {
        flags = flags | TypedAssignmentFlagCompound();
    }

    if (targetKind == TypedAssignmentTargetKind.Field
        || targetKind == TypedAssignmentTargetKind.IndexElement
        || targetKind == TypedAssignmentTargetKind.IndexSlice
        || (targetKind == TypedAssignmentTargetKind.Identifier
            && (identifierTargetKind == TypedIdentifierTargetKind.Parameter
                || identifierTargetKind == TypedIdentifierTargetKind.Local
                || identifierTargetKind == TypedIdentifierTargetKind.Global)))
    {
        flags = flags | TypedAssignmentFlagPlaceTarget();
    }

    if (TypedAssignmentOperatorIsCompound(operatorKind)
        && (targetFacts.TypeKind == TypedSignatureTypeKind.Integer || targetFacts.TypeKind == TypedSignatureTypeKind.Float))
    {
        flags = flags | TypedAssignmentFlagNumericCompound();
    }

    return table.AppendAssignment(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        assignmentNode,
        assignmentToken,
        targetNode,
        valueNode,
        operatorKind,
        targetKind,
        valueKind,
        identifierTargetKind,
        memberTargetKind,
        indexAccessKind,
        targetDeclarationIndex,
        targetSymbolIndexPlusOne,
        targetNameToken,
        targetStorageKind,
        targetBindingKind,
        targetFacts.TypeKind,
        targetFacts.TypeHeadToken,
        targetFacts.TypePrimaryToken,
        targetFacts.TypeStartToken,
        targetFacts.TypeEndToken,
        targetFacts.RangeStartToken,
        targetFacts.RangeEndToken,
        targetFacts.ElementCountStartToken,
        targetFacts.ElementCountEndToken,
        targetFacts.BitWidth,
        targetFacts.TypeArgumentCount,
        targetFacts.ComptimeArgumentCount,
        targetFacts.TypeFlags,
        valueFacts.TypeKind,
        valueFacts.TypeHeadToken,
        valueFacts.TypePrimaryToken,
        valueFacts.TypeStartToken,
        valueFacts.TypeEndToken,
        valueFacts.RangeStartToken,
        valueFacts.RangeEndToken,
        valueFacts.ElementCountStartToken,
        valueFacts.ElementCountEndToken,
        valueFacts.BitWidth,
        valueFacts.TypeArgumentCount,
        valueFacts.ComptimeArgumentCount,
        valueFacts.TypeFlags,
        flags);
}

internal fn System.Memory.MemoryStatus AppendTypedAssignmentsFromGlobalDeclaration(
    mut borrow TypedAssignmentExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    DeclItem item,
    u32[0 max] declarationIndex)
{
    if (!TypedGlobalDeclarationKindIsGlobal(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] assignToken = TypedGlobalFindAssignToken(stream, item);
    if (assignToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] ownerNameToken = TypedGlobalFindNameToken(stream, item);
    stack ExprTree tree = ParseExpression(stream, (u32[0 max])(assignToken + 1));
    stack u64[0 2 ** 63 - 1] count = tree.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 1; index <= count; index += 1)
    {
        stack u32[0 max] node = (u32[0 max])index;
        if (tree.NodeKindAt(node) == Compiler.Parsing.ExprKind.Assign)
        {
            stack u32[0 max] targetNode = tree.LeftAt(node);
            stack u32[0 max] valueNode = tree.RightAt(node);
            stack mut TypedMemberTypeFacts targetFacts = new();
            stack mut TypedAssignmentTargetKind targetKind = TypedAssignmentTargetKind.Unknown;
            stack mut TypedIdentifierTargetKind identifierTargetKind = TypedIdentifierTargetKind.Unknown;
            stack mut TypedMemberTargetKind memberTargetKind = TypedMemberTargetKind.Unknown;
            stack mut TypedIndexAccessKind indexAccessKind = TypedIndexAccessKind.Unknown;
            stack mut u32[0 max] targetDeclarationIndex = 0;
            stack mut u32[0 max] targetSymbolIndexPlusOne = 0;
            stack mut u32[0 max] targetNameToken = 0;
            stack mut TypedGlobalStorageKind targetStorageKind = TypedGlobalStorageKind.Unknown;
            stack mut TypedGlobalBindingKind targetBindingKind = TypedGlobalBindingKind.Unknown;
            TypedAssignmentTargetFactsFromTreeNode(
                source,
                stream,
                declarations,
                identifiers,
                members,
                indexes,
                tree,
                TypedAssignmentContext.GlobalInitializer,
                declarationIndex,
                ownerNameToken,
                0,
                0,
                targetNode,
                targetFacts,
                targetKind,
                identifierTargetKind,
                memberTargetKind,
                indexAccessKind,
                targetDeclarationIndex,
                targetSymbolIndexPlusOne,
                targetNameToken,
                targetStorageKind,
                targetBindingKind);

            stack mut TypedMemberTypeFacts valueFacts = new();
            stack mut TypedAssignmentValueKind valueKind = TypedAssignmentValueKind.Unknown;
            TypedAssignmentValueFactsFromTreeNode(
                source,
                stream,
                declarations,
                literals,
                identifiers,
                calls,
                members,
                indexes,
                conversions,
                table,
                tree,
                TypedAssignmentContext.GlobalInitializer,
                declarationIndex,
                ownerNameToken,
                0,
                0,
                valueNode,
                valueFacts,
                valueKind);

            switch (AppendTypedAssignmentExpression(
                table,
                stream,
                TypedAssignmentContext.GlobalInitializer,
                declarationIndex,
                ownerNameToken,
                0,
                0,
                node,
                tree.TokenAt(node),
                targetNode,
                valueNode,
                targetFacts,
                targetKind,
                identifierTargetKind,
                memberTargetKind,
                indexAccessKind,
                targetDeclarationIndex,
                targetSymbolIndexPlusOne,
                targetNameToken,
                targetStorageKind,
                targetBindingKind,
                valueFacts,
                valueKind))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedAssignmentsFromBodyStatement(
    mut borrow TypedAssignmentExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statementIndex)
{
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    stack u32[0 max] start = (u32[0 max])(body.ExprStartAt(statementIndex) + 1);
    stack mut u32[0 max] end = (u32[0 max])body.ExprNodeCount();
    if (statementIndex + 1 < statementCount)
    {
        end = body.ExprStartAt((u64[0 2 ** 63 - 1])(statementIndex + 1));
    }

    if (start > end)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] statementIndexPlusOne = (u32[0 max])(statementIndex + 1);
    stack u64[0 2 ** 63 - 1] endIndex = (u64[0 2 ** 63 - 1])end;
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])start; nodeIndex <= endIndex; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Assign)
        {
            stack u32[0 max] targetNode = body.ExprLeftAt(node);
            stack u32[0 max] valueNode = body.ExprRightAt(node);
            stack mut TypedMemberTypeFacts targetFacts = new();
            stack mut TypedAssignmentTargetKind targetKind = TypedAssignmentTargetKind.Unknown;
            stack mut TypedIdentifierTargetKind identifierTargetKind = TypedIdentifierTargetKind.Unknown;
            stack mut TypedMemberTargetKind memberTargetKind = TypedMemberTargetKind.Unknown;
            stack mut TypedIndexAccessKind indexAccessKind = TypedIndexAccessKind.Unknown;
            stack mut u32[0 max] targetDeclarationIndex = 0;
            stack mut u32[0 max] targetSymbolIndexPlusOne = 0;
            stack mut u32[0 max] targetNameToken = 0;
            stack mut TypedGlobalStorageKind targetStorageKind = TypedGlobalStorageKind.Unknown;
            stack mut TypedGlobalBindingKind targetBindingKind = TypedGlobalBindingKind.Unknown;
            TypedAssignmentTargetFactsFromBodyNode(
                source,
                stream,
                declarations,
                identifiers,
                members,
                indexes,
                body,
                TypedAssignmentContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                targetNode,
                targetFacts,
                targetKind,
                identifierTargetKind,
                memberTargetKind,
                indexAccessKind,
                targetDeclarationIndex,
                targetSymbolIndexPlusOne,
                targetNameToken,
                targetStorageKind,
                targetBindingKind);

            stack mut TypedMemberTypeFacts valueFacts = new();
            stack mut TypedAssignmentValueKind valueKind = TypedAssignmentValueKind.Unknown;
            TypedAssignmentValueFactsFromBodyNode(
                source,
                stream,
                declarations,
                literals,
                identifiers,
                calls,
                members,
                indexes,
                conversions,
                table,
                body,
                TypedAssignmentContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                valueNode,
                valueFacts,
                valueKind);

            switch (AppendTypedAssignmentExpression(
                table,
                stream,
                TypedAssignmentContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                node,
                body.ExprTokenAt(node),
                targetNode,
                valueNode,
                targetFacts,
                targetKind,
                identifierTargetKind,
                memberTargetKind,
                indexAccessKind,
                targetDeclarationIndex,
                targetSymbolIndexPlusOne,
                targetNameToken,
                targetStorageKind,
                targetBindingKind,
                valueFacts,
                valueKind))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedAssignmentsFromBody(
    mut borrow TypedAssignmentExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedAssignmentsFromBodyStatement(
            table,
            source,
            stream,
            declarations,
            literals,
            identifiers,
            calls,
            members,
            indexes,
            conversions,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            body,
            index))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedAssignmentsForFunction(
    mut borrow TypedAssignmentExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] fnKeyword)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    return AppendTypedAssignmentsFromBody(
        table,
        source,
        stream,
        declarations,
        literals,
        identifiers,
        calls,
        members,
        indexes,
        conversions,
        ownerDeclarationIndex,
        ownerNameToken,
        signature.Name(),
        body);
}

internal fn System.Memory.MemoryStatus AppendTypedAssignmentsForMemberFunctions(
    mut borrow TypedAssignmentExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    DeclItem item,
    u32[0 max] ownerDeclarationIndex)
{
    if (!TypedSignatureDeclarationCanOwnMethods(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, item);
    if (bodyOpen == 0 || bodyOpen >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Fn)
        {
            switch (AppendTypedAssignmentsForFunction(table, source, stream, declarations, literals, identifiers, calls, members, indexes, conversions, ownerDeclarationIndex, item.NameToken, scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn ParseResult<TypedAssignmentExpressionTable> BuildTypedAssignmentExpressionsFromDependencies(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions)
{
    stack mut TypedAssignmentExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedAssignmentsFromGlobalDeclaration(
            table,
            source,
            stream,
            declarations,
            literals,
            identifiers,
            calls,
            members,
            indexes,
            conversions,
            item,
            (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedAssignmentsForFunction(table, source, stream, declarations, literals, identifiers, calls, members, indexes, conversions, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedAssignmentsForMemberFunctions(table, source, stream, declarations, literals, identifiers, calls, members, indexes, conversions, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberFunctionError):
                    return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedAssignmentExpressionTable>.Ok(table);
}

public fn ParseResult<TypedAssignmentExpressionTable> BuildTypedAssignmentExpressions(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedFunctionSignatureTable signatures = new();
    switch (BuildTypedFunctionSignatures(source, stream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFunctionSignatureTable>.Ok(var builtSignatures):
            signatures = builtSignatures;
    }

    stack mut TypedFieldDeclarationTable fields = new();
    switch (BuildTypedStructRecordFields(source, stream, declarations))
    {
        case ParseResult<TypedFieldDeclarationTable>.Err(var fieldError):
            return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFieldDeclarationTable>.Ok(var builtFields):
            fields = builtFields;
    }

    stack mut TypedLiteralExpressionTable literals = new();
    switch (BuildTypedLiteralExpressions(source, stream, declarations))
    {
        case ParseResult<TypedLiteralExpressionTable>.Err(var literalError):
            return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedLiteralExpressionTable>.Ok(var builtLiterals):
            literals = builtLiterals;
    }

    stack mut TypedIdentifierExpressionTable identifiers = new();
    switch (BuildTypedIdentifierExpressions(source, stream, declarations))
    {
        case ParseResult<TypedIdentifierExpressionTable>.Err(var identifierError):
            return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIdentifierExpressionTable>.Ok(var builtIdentifiers):
            identifiers = builtIdentifiers;
    }

    stack mut TypedCallExpressionTable calls = new();
    stack mut TypedMemberExpressionTable members = new();
    switch (BuildTypedMemberCallDependencies(source, stream, declarations, signatures, fields, literals, identifiers))
    {
        case ParseResult<TypedMemberCallDependencySet>.Err(var dependencyError):
            return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedMemberCallDependencySet>.Ok(var dependencies):
            calls = dependencies.Calls;
            members = dependencies.Members;
    }

    stack mut TypedIndexExpressionTable indexes = new();
    switch (BuildTypedIndexExpressionsFromDependencies(source, stream, declarations, identifiers, calls, members))
    {
        case ParseResult<TypedIndexExpressionTable>.Err(var indexError):
            return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIndexExpressionTable>.Ok(var builtIndexes):
            indexes = builtIndexes;
    }

    stack mut TypedConversionExpressionTable conversions = new();
    switch (BuildTypedConversionExpressionsFromDependencies(source, stream, declarations, literals, identifiers, calls, members, indexes))
    {
        case ParseResult<TypedConversionExpressionTable>.Err(var conversionError):
            return ParseResult<TypedAssignmentExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedConversionExpressionTable>.Ok(var builtConversions):
            conversions = builtConversions;
    }

    return BuildTypedAssignmentExpressionsFromDependencies(source, stream, declarations, literals, identifiers, calls, members, indexes, conversions);
}

internal finite law TypedReturnValueKind TypedReturnValueKindFromAssignmentValueKind(TypedAssignmentValueKind kind)
{
    if (kind == TypedAssignmentValueKind.Identifier)
    {
        return TypedReturnValueKind.Identifier;
    }

    if (kind == TypedAssignmentValueKind.Member)
    {
        return TypedReturnValueKind.Member;
    }

    if (kind == TypedAssignmentValueKind.Call)
    {
        return TypedReturnValueKind.Call;
    }

    if (kind == TypedAssignmentValueKind.Index)
    {
        return TypedReturnValueKind.Index;
    }

    if (kind == TypedAssignmentValueKind.Literal)
    {
        return TypedReturnValueKind.Literal;
    }

    if (kind == TypedAssignmentValueKind.New)
    {
        return TypedReturnValueKind.New;
    }

    if (kind == TypedAssignmentValueKind.Conversion)
    {
        return TypedReturnValueKind.Conversion;
    }

    if (kind == TypedAssignmentValueKind.Assignment)
    {
        return TypedReturnValueKind.Assignment;
    }

    return TypedReturnValueKind.Unknown;
}

internal fn void TypedReturnExpectedFactsFromSignature(
    borrow TypedFunctionSignatureTable signatures,
    u32[0 max] signatureIndexPlusOne,
    mut borrow TypedMemberTypeFacts facts)
{
    if (signatureIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] signatureIndex = (u64[0 2 ** 63 - 1])(signatureIndexPlusOne - 1);
    stack u32[0 max] returnSlotIndexPlusOne = signatures.ReturnTypeSlotIndexPlusOneAt(signatureIndex);
    stack mut TypedSignatureTypeKind typeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] typeHeadToken = 0;
    stack mut u32[0 max] typePrimaryToken = 0;
    stack mut u32[0 max] typeStartToken = 0;
    stack mut u32[0 max] typeEndToken = 0;
    stack mut u32[0 max] rangeStartToken = 0;
    stack mut u32[0 max] rangeEndToken = 0;
    stack mut u32[0 max] elementCountStartToken = 0;
    stack mut u32[0 max] elementCountEndToken = 0;
    stack mut u32[0 max] bitWidth = 0;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    stack mut u32[0 max] typeFlags = 0;
    TypedCallSignatureSlotFacts(
        signatures,
        returnSlotIndexPlusOne,
        typeKind,
        typeHeadToken,
        typePrimaryToken,
        typeStartToken,
        typeEndToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        elementCountEndToken,
        bitWidth,
        typeArgumentCount,
        comptimeArgumentCount,
        typeFlags);

    facts.ReceiverKind = TypedMemberReceiverKind.Value;
    facts.TypeKind = typeKind;
    facts.TypeHeadToken = typeHeadToken;
    facts.TypePrimaryToken = typePrimaryToken;
    facts.TypeStartToken = typeStartToken;
    facts.TypeEndToken = typeEndToken;
    facts.RangeStartToken = rangeStartToken;
    facts.RangeEndToken = rangeEndToken;
    facts.ElementCountStartToken = elementCountStartToken;
    facts.ElementCountEndToken = elementCountEndToken;
    facts.BitWidth = bitWidth;
    facts.TypeArgumentCount = typeArgumentCount;
    facts.ComptimeArgumentCount = comptimeArgumentCount;
    facts.TypeFlags = typeFlags;
}

internal fn System.Memory.MemoryStatus AppendTypedReturnExpression(
    mut borrow TypedReturnExpressionTable table,
    TypedReturnContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] returnToken,
    u32[0 max] valueNode,
    TypedReturnValueKind valueKind,
    borrow TypedMemberTypeFacts expectedFacts,
    borrow TypedMemberTypeFacts valueFacts)
{
    stack mut u32[0 max] flags = 0;
    stack mut TypedReturnValueKind storedValueKind = valueKind;
    if (valueNode != 0)
    {
        flags = flags | TypedReturnFlagHasValue();
    }
    else
    {
        flags = flags | TypedReturnFlagBare();
        storedValueKind = TypedReturnValueKind.None;
    }

    if (expectedFacts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        flags = flags | TypedReturnFlagExpectedResolved();
    }

    if (expectedFacts.TypeKind == TypedSignatureTypeKind.Void)
    {
        flags = flags | TypedReturnFlagExpectedVoid();
    }

    if (valueFacts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        flags = flags | TypedReturnFlagValueResolved();
    }

    return table.AppendReturn(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        returnToken,
        valueNode,
        storedValueKind,
        expectedFacts.TypeKind,
        expectedFacts.TypeHeadToken,
        expectedFacts.TypePrimaryToken,
        expectedFacts.TypeStartToken,
        expectedFacts.TypeEndToken,
        expectedFacts.RangeStartToken,
        expectedFacts.RangeEndToken,
        expectedFacts.ElementCountStartToken,
        expectedFacts.ElementCountEndToken,
        expectedFacts.BitWidth,
        expectedFacts.TypeArgumentCount,
        expectedFacts.ComptimeArgumentCount,
        expectedFacts.TypeFlags,
        valueFacts.TypeKind,
        valueFacts.TypeHeadToken,
        valueFacts.TypePrimaryToken,
        valueFacts.TypeStartToken,
        valueFacts.TypeEndToken,
        valueFacts.RangeStartToken,
        valueFacts.RangeEndToken,
        valueFacts.ElementCountStartToken,
        valueFacts.ElementCountEndToken,
        valueFacts.BitWidth,
        valueFacts.TypeArgumentCount,
        valueFacts.ComptimeArgumentCount,
        valueFacts.TypeFlags,
        flags);
}

internal fn System.Memory.MemoryStatus AppendTypedReturnsFromBodyStatement(
    mut borrow TypedReturnExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    borrow TypedAssignmentExpressionTable assignments,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow TypedMemberTypeFacts expectedFacts,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statementIndex)
{
    stack StatementItem item = body.ItemAt(statementIndex);
    if (item.Kind != StatementKind.Return)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] statementIndexPlusOne = (u32[0 max])(statementIndex + 1);
    stack u32[0 max] valueNode = body.ExprRootAt(statementIndex);
    stack mut TypedMemberTypeFacts valueFacts = new();
    stack mut TypedAssignmentValueKind assignmentValueKind = TypedAssignmentValueKind.Unknown;
    if (valueNode != 0)
    {
        TypedAssignmentValueFactsFromBodyNode(
            source,
            stream,
            declarations,
            literals,
            identifiers,
            calls,
            members,
            indexes,
            conversions,
            assignments,
            body,
            TypedAssignmentContext.FunctionBody,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            valueNode,
            valueFacts,
            assignmentValueKind);
    }

    stack TypedReturnValueKind valueKind = TypedReturnValueKindFromAssignmentValueKind(assignmentValueKind);
    return AppendTypedReturnExpression(
        table,
        TypedReturnContext.FunctionBody,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        item.StartToken,
        valueNode,
        valueKind,
        expectedFacts,
        valueFacts);
}

internal fn System.Memory.MemoryStatus AppendTypedReturnsFromBody(
    mut borrow TypedReturnExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    borrow TypedAssignmentExpressionTable assignments,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow TypedMemberTypeFacts expectedFacts,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedReturnsFromBodyStatement(
            table,
            source,
            stream,
            declarations,
            literals,
            identifiers,
            calls,
            members,
            indexes,
            conversions,
            assignments,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            expectedFacts,
            body,
            index))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedReturnsForFunction(
    mut borrow TypedReturnExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    borrow TypedAssignmentExpressionTable assignments,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] fnKeyword)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    stack u32[0 max] signatureIndexPlusOne = TypedIdentifierSignatureIndexForFunction(signatures, ownerNameToken, signature.Name(), fnKeyword);
    stack mut TypedMemberTypeFacts expectedFacts = new();
    TypedReturnExpectedFactsFromSignature(signatures, signatureIndexPlusOne, expectedFacts);
    return AppendTypedReturnsFromBody(
        table,
        source,
        stream,
        declarations,
        literals,
        identifiers,
        calls,
        members,
        indexes,
        conversions,
        assignments,
        ownerDeclarationIndex,
        ownerNameToken,
        signature.Name(),
        expectedFacts,
        body);
}

internal fn System.Memory.MemoryStatus AppendTypedReturnsForMemberFunctions(
    mut borrow TypedReturnExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    borrow TypedAssignmentExpressionTable assignments,
    DeclItem item,
    u32[0 max] ownerDeclarationIndex)
{
    if (!TypedSignatureDeclarationCanOwnMethods(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, item);
    if (bodyOpen == 0 || bodyOpen >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Fn)
        {
            switch (AppendTypedReturnsForFunction(table, source, stream, declarations, signatures, literals, identifiers, calls, members, indexes, conversions, assignments, ownerDeclarationIndex, item.NameToken, scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn ParseResult<TypedReturnExpressionTable> BuildTypedReturnExpressionsFromDependencies(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    borrow TypedAssignmentExpressionTable assignments)
{
    stack mut TypedReturnExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedReturnsForFunction(table, source, stream, declarations, signatures, literals, identifiers, calls, members, indexes, conversions, assignments, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedReturnsForMemberFunctions(table, source, stream, declarations, signatures, literals, identifiers, calls, members, indexes, conversions, assignments, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberFunctionError):
                    return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedReturnExpressionTable>.Ok(table);
}

public fn ParseResult<TypedReturnExpressionTable> BuildTypedReturnExpressions(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedFunctionSignatureTable signatures = new();
    switch (BuildTypedFunctionSignatures(source, stream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFunctionSignatureTable>.Ok(var builtSignatures):
            signatures = builtSignatures;
    }

    stack mut TypedFieldDeclarationTable fields = new();
    switch (BuildTypedStructRecordFields(source, stream, declarations))
    {
        case ParseResult<TypedFieldDeclarationTable>.Err(var fieldError):
            return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFieldDeclarationTable>.Ok(var builtFields):
            fields = builtFields;
    }

    stack mut TypedLiteralExpressionTable literals = new();
    switch (BuildTypedLiteralExpressions(source, stream, declarations))
    {
        case ParseResult<TypedLiteralExpressionTable>.Err(var literalError):
            return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedLiteralExpressionTable>.Ok(var builtLiterals):
            literals = builtLiterals;
    }

    stack mut TypedIdentifierExpressionTable identifiers = new();
    switch (BuildTypedIdentifierExpressions(source, stream, declarations))
    {
        case ParseResult<TypedIdentifierExpressionTable>.Err(var identifierError):
            return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIdentifierExpressionTable>.Ok(var builtIdentifiers):
            identifiers = builtIdentifiers;
    }

    stack mut TypedCallExpressionTable calls = new();
    stack mut TypedMemberExpressionTable members = new();
    switch (BuildTypedMemberCallDependencies(source, stream, declarations, signatures, fields, literals, identifiers))
    {
        case ParseResult<TypedMemberCallDependencySet>.Err(var dependencyError):
            return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedMemberCallDependencySet>.Ok(var dependencies):
            calls = dependencies.Calls;
            members = dependencies.Members;
    }

    stack mut TypedIndexExpressionTable indexes = new();
    switch (BuildTypedIndexExpressionsFromDependencies(source, stream, declarations, identifiers, calls, members))
    {
        case ParseResult<TypedIndexExpressionTable>.Err(var indexError):
            return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIndexExpressionTable>.Ok(var builtIndexes):
            indexes = builtIndexes;
    }

    stack mut TypedConversionExpressionTable conversions = new();
    switch (BuildTypedConversionExpressionsFromDependencies(source, stream, declarations, literals, identifiers, calls, members, indexes))
    {
        case ParseResult<TypedConversionExpressionTable>.Err(var conversionError):
            return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedConversionExpressionTable>.Ok(var builtConversions):
            conversions = builtConversions;
    }

    stack mut TypedAssignmentExpressionTable assignments = new();
    switch (BuildTypedAssignmentExpressionsFromDependencies(source, stream, declarations, literals, identifiers, calls, members, indexes, conversions))
    {
        case ParseResult<TypedAssignmentExpressionTable>.Err(var assignmentError):
            return ParseResult<TypedReturnExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedAssignmentExpressionTable>.Ok(var builtAssignments):
            assignments = builtAssignments;
    }

    return BuildTypedReturnExpressionsFromDependencies(source, stream, declarations, signatures, literals, identifiers, calls, members, indexes, conversions, assignments);
}

// True for an operator token that yields a boolean result regardless of its
// operand types: the comparison, equality, and logical operators.
internal finite law bool IsBooleanOperator(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.EqEq:
            return true;
        case TokenKind.Neq:
            return true;
        case TokenKind.Lt:
            return true;
        case TokenKind.Gt:
            return true;
        case TokenKind.Lte:
            return true;
        case TokenKind.Gte:
            return true;
        case TokenKind.AndAnd:
            return true;
        case TokenKind.OrOr:
            return true;
        default:
            return false;
    }
}

// Classifies the type of expression node `node` in `body`'s shared expression
// tree. Literals type by their form; comparison/logical operators type as `Bool`;
// arithmetic types as its left operand's type (Float if that operand is Float,
// otherwise Int); a `!` unary types as `Bool`; explicit conversions type as
// their target; a ternary types as its then-branch; everything else (identifiers,
// calls, members, indexing, assignment) is `Unknown`.
public fn ExprType ClassifyExprType(borrow TokenStream stream, borrow StatementList body, u32[0 max] node)
{
    stack ExprKind kind = body.ExprKindAt(node);
    if (kind == Compiler.Parsing.ExprKind.IntLiteral)
    {
        return ExprType.Int;
    }

    if (kind == Compiler.Parsing.ExprKind.FloatLiteral)
    {
        return ExprType.Float;
    }

    if (kind == Compiler.Parsing.ExprKind.StringLiteral || kind == Compiler.Parsing.ExprKind.CharacterLiteral)
    {
        return ExprType.Text;
    }

    if (kind == Compiler.Parsing.ExprKind.BoolLiteral)
    {
        return ExprType.Bool;
    }

    if (kind == Compiler.Parsing.ExprKind.NullLiteral)
    {
        return ExprType.Null;
    }

    if (kind == Compiler.Parsing.ExprKind.Binary)
    {
        stack u32[0 max] opToken = body.ExprTokenAt(node);
        stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])opToken);

        // A shift (`<<`/`>>`) lexes as two adjacent `Lt`/`Gt` tokens, so its
        // Binary node is anchored on a `Lt`/`Gt` that would otherwise look
        // relational. Detect the adjacent pair so the shift is typed as an
        // integer (arithmetic), not as a boolean comparison.
        stack mut bool isShift = false;
        if (op == TokenKind.Lt && stream.KindAt((u64[0 2 ** 63 - 1])(opToken + 1)) == TokenKind.Lt)
        {
            isShift = true;
        }
        else if (op == TokenKind.Gt && stream.KindAt((u64[0 2 ** 63 - 1])(opToken + 1)) == TokenKind.Gt)
        {
            isShift = true;
        }

        if (!isShift && IsBooleanOperator(op))
        {
            return ExprType.Bool;
        }

        // Arithmetic / bitwise / shift: result follows the left operand; an
        // unknown operand keeps the result `Int` (the common arithmetic case).
        stack ExprType left = ClassifyExprType(stream, body, body.ExprLeftAt(node));
        if (left == ExprType.Float)
        {
            return ExprType.Float;
        }

        return ExprType.Int;
    }

    if (kind == Compiler.Parsing.ExprKind.Unary)
    {
        stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(node));
        if (op == TokenKind.Bang)
        {
            return ExprType.Bool;
        }

        return ClassifyExprType(stream, body, body.ExprLeftAt(node));
    }

    if (kind == Compiler.Parsing.ExprKind.Conversion)
    {
        stack TokenKind targetKind = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprLeftAt(node));
        if (targetKind == TokenKind.Bool)
        {
            return ExprType.Bool;
        }

        if (targetKind == TokenKind.IntegerType)
        {
            return ExprType.Int;
        }

        if (targetKind == TokenKind.FloatType)
        {
            return ExprType.Float;
        }

        if (targetKind == TokenKind.AsciiView
            || targetKind == TokenKind.AsciiOwned
            || targetKind == TokenKind.UnicodeView
            || targetKind == TokenKind.UnicodeOwned)
        {
            return ExprType.Text;
        }
    }

    if (kind == Compiler.Parsing.ExprKind.Conditional)
    {
        // `cond ? then : else` — the value type is the then-branch's type.
        return ClassifyExprType(stream, body, body.ExprRightAt(node));
    }

    return ExprType.Unknown;
}

// Whether `type` is a definite non-boolean type (a known mismatch where a boolean
// is required). `Unknown` is excluded so the conservative checker never flags an
// expression whose type it cannot yet determine.
public finite law bool IsDefiniteNonBoolean(ExprType type)
{
    switch (type)
    {
        case ExprType.Int:
            return true;
        case ExprType.Float:
            return true;
        case ExprType.Text:
            return true;
        case ExprType.Null:
            return true;
        case ExprType.Bool:
            return false;
        case ExprType.Unknown:
            return false;
    }
}

// Counts the `if`/`while` conditions in `body` whose type is a definite
// non-boolean (e.g. `if (1 + 2)` / `while (3.0)`) — a basic type error. A
// condition whose type is `Unknown` (e.g. an identifier `if (flag)`) is not
// counted, since its type is not yet known.
public fn u32[0 max] CountNonBooleanConditions(borrow TokenStream stream, borrow StatementList body)
{
    stack mut u32[0 max] errors = 0;
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack StatementItem item = body.ItemAt(index);
        if (item.Kind == StatementKind.If || item.Kind == StatementKind.While)
        {
            stack u32[0 max] root = body.ExprRootAt(index);
            if (root != 0)
            {
                stack ExprType conditionType = ClassifyExprType(stream, body, root);
                if (IsDefiniteNonBoolean(conditionType))
                {
                    errors = (u32[0 max])(errors + 1);
                }
            }
        }
    }

    return errors;
}
