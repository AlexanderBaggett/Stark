    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedEnumLayoutTable self,
        TypedEnumLayoutRowKind rowKind,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
        u32[0 max] variantOrdinal,
        u32[0 max] variantNameToken,
        u32[0 max] variantTag,
        u32[0 max] payloadCount,
        u32[0 max] payloadOrdinal,
        u32[0 max] payloadNameToken,
        TypedEnumPayloadKind payloadKind,
        TypedEnumVariantRole variantRole,
        bool errorFunnel,
        bool usesNamedPayloads,
        u32[0 max] storageFieldOrdinal,
        u64[0 max] offsetBytes,
        u64[0 max] sizeBytes,
        u64[0 max] alignmentBytes,
        bool misaligned,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] bitWidth,
        u32[0 max] typeFlags,
        u32[0 max] layoutFlags)
    {
        if (!self.RowKinds.TryReserve(1)
            || !self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.VariantOrdinals.TryReserve(1)
            || !self.VariantNameTokens.TryReserve(1)
            || !self.VariantTags.TryReserve(1)
            || !self.PayloadCounts.TryReserve(1)
            || !self.PayloadOrdinals.TryReserve(1)
            || !self.PayloadNameTokens.TryReserve(1)
            || !self.PayloadKinds.TryReserve(1)
            || !self.VariantRoles.TryReserve(1)
            || !self.ErrorFunnels.TryReserve(1)
            || !self.UsesNamedPayloads.TryReserve(1)
            || !self.StorageFieldOrdinals.TryReserve(1)
            || !self.OffsetBytes.TryReserve(1)
            || !self.SizeBytes.TryReserve(1)
            || !self.AlignmentBytes.TryReserve(1)
            || !self.Misaligneds.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeFlags.TryReserve(1)
            || !self.LayoutFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.RowKinds[self.RowKinds.Length] = rowKind;
        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.VariantOrdinals[self.VariantOrdinals.Length] = variantOrdinal;
        init self.VariantNameTokens[self.VariantNameTokens.Length] = variantNameToken;
        init self.VariantTags[self.VariantTags.Length] = variantTag;
        init self.PayloadCounts[self.PayloadCounts.Length] = payloadCount;
        init self.PayloadOrdinals[self.PayloadOrdinals.Length] = payloadOrdinal;
        init self.PayloadNameTokens[self.PayloadNameTokens.Length] = payloadNameToken;
        init self.PayloadKinds[self.PayloadKinds.Length] = payloadKind;
        init self.VariantRoles[self.VariantRoles.Length] = variantRole;
        init self.ErrorFunnels[self.ErrorFunnels.Length] = errorFunnel;
        init self.UsesNamedPayloads[self.UsesNamedPayloads.Length] = usesNamedPayloads;
        init self.StorageFieldOrdinals[self.StorageFieldOrdinals.Length] = storageFieldOrdinal;
        init self.OffsetBytes[self.OffsetBytes.Length] = offsetBytes;
        init self.SizeBytes[self.SizeBytes.Length] = sizeBytes;
        init self.AlignmentBytes[self.AlignmentBytes.Length] = alignmentBytes;
        init self.Misaligneds[self.Misaligneds.Length] = misaligned;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        init self.LayoutFlags[self.LayoutFlags.Length] = layoutFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}

internal struct TypedEnumLayoutGenericContextTable
{
    internal dynamic u32[0 max] GenericOpenTokens;
    internal dynamic u32[0 max] ActualOpenTokens;
    internal dynamic u32[0 max] ParentContextIndicesPlusOne;

    TypedEnumLayoutGenericContextTable()
    {
        self.GenericOpenTokens = new();
        self.ActualOpenTokens = new();
        self.ParentContextIndicesPlusOne = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedEnumLayoutGenericContextTable self)
    {
        return self.GenericOpenTokens.Length;
    }

    internal law u32[0 max] GenericOpenTokenAt(borrow TypedEnumLayoutGenericContextTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.GenericOpenTokens.Length)
        {
            token = self.GenericOpenTokens[index];
        }

        return token;
    }

    internal law u32[0 max] ActualOpenTokenAt(borrow TypedEnumLayoutGenericContextTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ActualOpenTokens.Length)
        {
            token = self.ActualOpenTokens[index];
        }

        return token;
    }

    internal law u32[0 max] ParentContextIndexPlusOneAt(borrow TypedEnumLayoutGenericContextTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] contextIndexPlusOne = 0;
        if (index < self.ParentContextIndicesPlusOne.Length)
        {
            contextIndexPlusOne = self.ParentContextIndicesPlusOne[index];
        }

        return contextIndexPlusOne;
    }

    internal fn bool TryAppend(
        mut borrow TypedEnumLayoutGenericContextTable self,
        u32[0 max] genericOpenToken,
        u32[0 max] actualOpenToken,
        u32[0 max] parentContextIndexPlusOne,
        out u32[0 max] contextIndexPlusOne)
    {
        contextIndexPlusOne = 0;
        if (!self.GenericOpenTokens.TryReserve(1)
            || !self.ActualOpenTokens.TryReserve(1)
            || !self.ParentContextIndicesPlusOne.TryReserve(1))
        {
            return false;
        }

        stack u32[0 max] appendedIndexPlusOne = (u32[0 max])(self.GenericOpenTokens.Length + 1);
        init self.GenericOpenTokens[self.GenericOpenTokens.Length] = genericOpenToken;
        init self.ActualOpenTokens[self.ActualOpenTokens.Length] = actualOpenToken;
        init self.ParentContextIndicesPlusOne[self.ParentContextIndicesPlusOne.Length] = parentContextIndexPlusOne;
        contextIndexPlusOne = appendedIndexPlusOne;
        return true;
    }
}

internal fn bool TypedEnumLayoutQueryTypeSpanHasTopLevelDot(borrow TokenStream stream, u32[0 max] startToken, u32[0 max] endToken)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = startToken;
    while willexit (scan < endToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && kind == TokenKind.Dot)
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn bool TypedEnumLayoutTryResolveQueryOwner(
    borrow DeclarationList declarations,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] genericOpenToken,
    out u32[0 max] ownerDeclarationIndex)
{
    ownerDeclarationIndex = 0;
    stack mut u32[0 max] typeStart = 0;
    stack mut u32[0 max] typeEnd = 0;
    if (!TypedEnumLayoutGenericArgumentSegment(stream, genericOpenToken, false, 0, typeStart, typeEnd)
        || TypedEnumLayoutQueryTypeSpanHasTopLevelDot(stream, typeStart, typeEnd))
    {
        return false;
    }

    stack u32[0 max] typePrimaryToken = TypedSignatureSemanticPrimaryToken(stream, typeStart, typeEnd, typeStart);
    if (typePrimaryToken == 0 || stream.KindAt((u64[0 2 ** 63 - 1])typePrimaryToken) != TokenKind.Identifier)
    {
        return false;
    }

    stack u32[0 max] declarationIndexPlusOne = TypedIdentifierDeclarationIndexByNameToken(source, stream, declarations, typePrimaryToken);
    if (declarationIndexPlusOne == 0)
    {
        return false;
    }

    stack DeclItem item = declarations.ItemAt((u64[0 2 ** 63 - 1])(declarationIndexPlusOne - 1));
    if (item.Kind != DeclarationKind.Enum)
    {
        return false;
    }

    ownerDeclarationIndex = (u32[0 max])(declarationIndexPlusOne - 1);
    return true;
}

internal fn bool TypedEnumLayoutTryReadQueryU64Segment(
    ascii source,
    borrow TokenStream stream,
    borrow TypedEnumLayoutGenericContextTable contexts,
    u32[0 max] contextIndexPlusOne,
    u32[0 max] startToken,
    u32[0 max] endToken,
    out u64[0 max] value)
{
    value = 0;
    if (startToken >= endToken)
    {
        return false;
    }

    stack mut u32[0 max] valueToken = startToken;
    if (stream.KindAt((u64[0 2 ** 63 - 1])valueToken) == TokenKind.Comptime)
    {
        valueToken = (u32[0 max])(valueToken + 1);
    }

    if (valueToken < endToken && stream.KindAt((u64[0 2 ** 63 - 1])valueToken) == TokenKind.Plus)
    {
        valueToken = (u32[0 max])(valueToken + 1);
    }

    if ((u32[0 max])(valueToken + 1) != endToken)
    {
        return false;
    }

    if (TypedEnumLayoutTryReadU64Token(source, stream, valueToken, value))
    {
        return true;
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])valueToken) == TokenKind.Identifier)
    {
        return TypedEnumLayoutTryReadGenericComptimeU64(source, stream, contexts, contextIndexPlusOne, valueToken, value);
    }

    return false;
}

internal fn bool TypedEnumLayoutTryReadQueryU32(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] genericOpenToken,
    u32[0 max] valueOrdinal,
    out u32[0 max] value)
{
    value = 0;
    stack mut u32[0 max] valueStart = 0;
    stack mut u32[0 max] valueEnd = 0;
    if (!TypedEnumLayoutGenericArgumentSegment(stream, genericOpenToken, true, valueOrdinal, valueStart, valueEnd))
    {
        return false;
    }

    stack mut TypedEnumLayoutGenericContextTable noContexts = new();
    stack mut u64[0 max] wideValue = 0;
    if (!TypedEnumLayoutTryReadQueryU64Segment(source, stream, noContexts, 0, valueStart, valueEnd, wideValue)
        || wideValue > 4294967295)
    {
        return false;
    }

    value = (u32[0 max])wideValue;
    return true;
}

public fn bool TryFoldEnumLayoutComptimeQueryCall(
    borrow DeclarationList declarations,
    borrow TypedEnumLayoutTable layouts,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] queryNameToken,
    out TypedLayoutQueryConstant constant)
{
    constant = new();
    if (queryNameToken == 0)
    {
        return false;
    }

    stack u32[0 max] genericOpenToken = (u32[0 max])(queryNameToken + 1);
    if (stream.KindAt((u64[0 2 ** 63 - 1])genericOpenToken) != TokenKind.Lt)
    {
        return false;
    }

    stack u32[0 max] genericCloseToken = TypedSignatureMatchingCloseToken(stream, genericOpenToken);
    if (genericCloseToken <= genericOpenToken
        || stream.KindAt((u64[0 2 ** 63 - 1])(genericCloseToken + 1)) != TokenKind.LParen)
    {
        return false;
    }

    stack mut u32[0 max] ownerDeclarationIndex = 0;
    if (!TypedEnumLayoutTryResolveQueryOwner(declarations, source, stream, genericOpenToken, ownerDeclarationIndex))
    {
        return false;
    }

    if (layouts.TryFoldEnumTagLayoutQuery(source, stream, queryNameToken, ownerDeclarationIndex, constant))
    {
        return true;
    }

    stack mut u32[0 max] variantOrdinal = 0;
    if (!TypedEnumLayoutTryReadQueryU32(source, stream, genericOpenToken, 0, variantOrdinal))
    {
        return false;
    }

    if (layouts.TryFoldEnumVariantLayoutQuery(source, stream, queryNameToken, ownerDeclarationIndex, variantOrdinal, constant))
    {
        return true;
    }

    stack mut u32[0 max] payloadOrdinal = 0;
    if (!TypedEnumLayoutTryReadQueryU32(source, stream, genericOpenToken, 1, payloadOrdinal))
    {
        return false;
    }

    return layouts.TryFoldEnumVariantPayloadLayoutQuery(
        source,
        stream,
        queryNameToken,
        ownerDeclarationIndex,
        variantOrdinal,
        payloadOrdinal,
        constant);
}

public enum TypedLocalDeclarationOwnerKind
{
    TopLevelFunction,
    MemberMethod,
    Unknown,
}

