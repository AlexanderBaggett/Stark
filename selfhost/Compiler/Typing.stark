internal fn void TypedConversionTargetFactsFromConversion(
    borrow TypedConversionExpressionTable conversions,
    u32[0 max] conversionIndexPlusOne,
    mut borrow TypedMemberTypeFacts facts)
{
    if (conversionIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(conversionIndexPlusOne - 1);
    facts.ReceiverKind = TypedMemberReceiverKind.Value;
    facts.TypeKind = conversions.TargetTypeKindAt(index);
    facts.TypeHeadToken = conversions.TargetTypeHeadTokenAt(index);
    facts.TypePrimaryToken = conversions.TargetTypePrimaryTokenAt(index);
    facts.TypeStartToken = conversions.TargetTypeStartTokenAt(index);
    facts.TypeEndToken = conversions.TargetTypeEndTokenAt(index);
    facts.RangeStartToken = conversions.TargetRangeStartTokenAt(index);
    facts.RangeEndToken = conversions.TargetRangeEndTokenAt(index);
    facts.ElementCountStartToken = conversions.TargetElementCountStartTokenAt(index);
    facts.ElementCountEndToken = conversions.TargetElementCountEndTokenAt(index);
    facts.BitWidth = conversions.TargetBitWidthAt(index);
    facts.TypeArgumentCount = conversions.TargetTypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = conversions.TargetComptimeArgumentCountAt(index);
    facts.TypeFlags = conversions.TargetTypeFlagsAt(index);
}

internal finite law bool TypedConversionTypeKindIsNumeric(TypedSignatureTypeKind kind)
{
    return kind == TypedSignatureTypeKind.Integer || kind == TypedSignatureTypeKind.Float;
}

internal fn u32[0 max] TypedConversionFlagsFromFacts(borrow TypedMemberTypeFacts targetFacts, borrow TypedMemberTypeFacts operandFacts)
{
    stack mut u32[0 max] flags = TypedConversionFlagExplicit();
    if (targetFacts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        flags = flags | TypedConversionFlagTargetResolved();
    }

    if (operandFacts.TypeKind != TypedSignatureTypeKind.Unknown)
    {
        flags = flags | TypedConversionFlagOperandResolved();
    }

    if (TypedConversionTypeKindIsNumeric(targetFacts.TypeKind)
        && TypedConversionTypeKindIsNumeric(operandFacts.TypeKind))
    {
        flags = flags | TypedConversionFlagNumeric();
    }

    if ((targetFacts.TypeKind == TypedSignatureTypeKind.RawPointer
            && (operandFacts.TypeKind == TypedSignatureTypeKind.RawPointer || operandFacts.TypeKind == TypedSignatureTypeKind.Integer))
        || (operandFacts.TypeKind == TypedSignatureTypeKind.RawPointer
            && (targetFacts.TypeKind == TypedSignatureTypeKind.RawPointer || targetFacts.TypeKind == TypedSignatureTypeKind.Integer)))
    {
        flags = flags | TypedConversionFlagPointer();
    }

    if (targetFacts.TypeKind == TypedSignatureTypeKind.Text && operandFacts.TypeKind == TypedSignatureTypeKind.Text)
    {
        flags = flags | TypedConversionFlagText();
    }

    if (targetFacts.TypeKind == TypedSignatureTypeKind.Slice && operandFacts.TypeKind == TypedSignatureTypeKind.FixedArray)
    {
        flags = flags | TypedConversionFlagArrayToSlice();
    }

    return flags;
}

internal fn void TypedConversionOperandFactsFromTreeNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    borrow ExprTree tree,
    TypedConversionContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] operandNode,
    mut borrow TypedMemberTypeFacts operandFacts,
    out TypedConversionOperandKind operandKind)
{
    operandKind = TypedConversionOperandKind.Unknown;
    stack ExprKind kind = tree.NodeKindAt(operandNode);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        operandKind = TypedConversionOperandKind.Identifier;
        stack u32[0 max] identifierIndexPlusOne = TypedMemberIdentifierIndexForNode(
            identifiers,
            TypedConversionMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedMemberFactsFromIdentifier(source, stream, declarations, identifiers, identifierIndexPlusOne, operandFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Member)
    {
        operandKind = TypedConversionOperandKind.Member;
        stack u32[0 max] memberIndexPlusOne = TypedMemberExpressionIndexForNode(
            members,
            TypedConversionMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedMemberFactsFromMember(source, stream, declarations, members, memberIndexPlusOne, operandFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Call)
    {
        operandKind = TypedConversionOperandKind.Call;
        stack u32[0 max] callIndexPlusOne = TypedMemberCallIndexForNode(
            calls,
            TypedConversionMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedMemberFactsFromCall(source, stream, declarations, calls, callIndexPlusOne, operandFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Index)
    {
        operandKind = TypedConversionOperandKind.Index;
        stack u32[0 max] indexIndexPlusOne = TypedIndexExpressionIndexForNode(
            indexes,
            TypedConversionIndexContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedIndexFactsFromIndex(source, stream, declarations, indexes, indexIndexPlusOne, operandFacts);
        return;
    }

    if (TypedLiteralExprKindIsLiteral(kind))
    {
        operandKind = TypedConversionOperandKind.Literal;
        stack u32[0 max] literalIndexPlusOne = TypedConversionLiteralIndexForNode(
            literals,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedAssignmentFactsFromLiteral(literals, literalIndexPlusOne, operandFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.New)
    {
        operandKind = TypedConversionOperandKind.New;
        stack u32[0 max] typeNode = tree.LeftAt(operandNode);
        if (typeNode != 0 && tree.NodeKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            TypedMemberFactsFromNewTypeNode(source, stream, declarations, tree.TokenAt(typeNode), operandFacts);
        }

        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Conversion)
    {
        operandKind = TypedConversionOperandKind.Conversion;
        stack u32[0 max] conversionIndexPlusOne = TypedConversionExpressionIndexForNode(
            conversions,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedConversionTargetFactsFromConversion(conversions, conversionIndexPlusOne, operandFacts);
    }
}

internal fn void TypedConversionOperandFactsFromBodyNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow TypedConversionExpressionTable conversions,
    borrow StatementList body,
    TypedConversionContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] operandNode,
    mut borrow TypedMemberTypeFacts operandFacts,
    out TypedConversionOperandKind operandKind)
{
    operandKind = TypedConversionOperandKind.Unknown;
    stack ExprKind kind = body.ExprKindAt(operandNode);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        operandKind = TypedConversionOperandKind.Identifier;
        stack u32[0 max] identifierIndexPlusOne = TypedMemberIdentifierIndexForNode(
            identifiers,
            TypedConversionMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedMemberFactsFromIdentifier(source, stream, declarations, identifiers, identifierIndexPlusOne, operandFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Member)
    {
        operandKind = TypedConversionOperandKind.Member;
        stack u32[0 max] memberIndexPlusOne = TypedMemberExpressionIndexForNode(
            members,
            TypedConversionMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedMemberFactsFromMember(source, stream, declarations, members, memberIndexPlusOne, operandFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Call)
    {
        operandKind = TypedConversionOperandKind.Call;
        stack u32[0 max] callIndexPlusOne = TypedMemberCallIndexForNode(
            calls,
            TypedConversionMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedMemberFactsFromCall(source, stream, declarations, calls, callIndexPlusOne, operandFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Index)
    {
        operandKind = TypedConversionOperandKind.Index;
        stack u32[0 max] indexIndexPlusOne = TypedIndexExpressionIndexForNode(
            indexes,
            TypedConversionIndexContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedIndexFactsFromIndex(source, stream, declarations, indexes, indexIndexPlusOne, operandFacts);
        return;
    }

    if (TypedLiteralExprKindIsLiteral(kind))
    {
        operandKind = TypedConversionOperandKind.Literal;
        stack u32[0 max] literalIndexPlusOne = TypedConversionLiteralIndexForNode(
            literals,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedAssignmentFactsFromLiteral(literals, literalIndexPlusOne, operandFacts);
        return;
    }

    if (kind == Compiler.Parsing.ExprKind.New)
    {
        operandKind = TypedConversionOperandKind.New;
        stack u32[0 max] typeNode = body.ExprLeftAt(operandNode);
        if (typeNode != 0 && body.ExprKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
        {
            TypedMemberFactsFromNewTypeNode(source, stream, declarations, body.ExprTokenAt(typeNode), operandFacts);
        }

        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Conversion)
    {
        operandKind = TypedConversionOperandKind.Conversion;
        stack u32[0 max] conversionIndexPlusOne = TypedConversionExpressionIndexForNode(
            conversions,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            operandNode);
        TypedConversionTargetFactsFromConversion(conversions, conversionIndexPlusOne, operandFacts);
    }
}

internal fn System.Memory.MemoryStatus AppendTypedConversionExpression(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    TypedConversionContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] conversionNode,
    u32[0 max] openParenToken,
    u32[0 max] targetPrimaryToken,
    u32[0 max] targetCloseToken,
    u32[0 max] operandNode,
    borrow ExprTree tree)
{
    stack mut TypedMemberTypeFacts targetFacts = new();
    TypedMemberFactsFromTypeSpan(
        source,
        stream,
        declarations,
        (u32[0 max])(openParenToken + 1),
        targetCloseToken,
        targetPrimaryToken,
        0,
        0,
        targetFacts);

    stack mut TypedMemberTypeFacts operandFacts = new();
    stack mut TypedConversionOperandKind operandKind = TypedConversionOperandKind.Unknown;
    TypedConversionOperandFactsFromTreeNode(
        source,
        stream,
        declarations,
        literals,
        identifiers,
        calls,
        members,
        indexes,
        table,
        tree,
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        operandNode,
        operandFacts,
        operandKind);

    stack u32[0 max] flags = TypedConversionFlagsFromFacts(targetFacts, operandFacts);
    return table.AppendConversion(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        conversionNode,
        openParenToken,
        operandNode,
        operandKind,
        targetFacts.TypeKind,
        targetFacts.TypeHeadToken,
        targetFacts.TypePrimaryToken,
        targetFacts.TypeStartToken,
        targetFacts.TypeEndToken,
        targetFacts.RangeStartToken,
        targetFacts.RangeEndToken,
        targetFacts.ElementCountStartToken,
        targetFacts.ElementCountEndToken,
        targetFacts.BitWidth,
        targetFacts.TypeArgumentCount,
        targetFacts.ComptimeArgumentCount,
        targetFacts.TypeFlags,
        operandFacts.TypeKind,
        operandFacts.TypeHeadToken,
        operandFacts.TypePrimaryToken,
        operandFacts.TypeStartToken,
        operandFacts.TypeEndToken,
        operandFacts.RangeStartToken,
        operandFacts.RangeEndToken,
        operandFacts.ElementCountStartToken,
        operandFacts.ElementCountEndToken,
        operandFacts.BitWidth,
        operandFacts.TypeArgumentCount,
        operandFacts.ComptimeArgumentCount,
        operandFacts.TypeFlags,
        flags);
}

internal fn System.Memory.MemoryStatus AppendTypedConversionBodyExpression(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    TypedConversionContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] conversionNode,
    u32[0 max] openParenToken,
    u32[0 max] targetPrimaryToken,
    u32[0 max] targetCloseToken,
    u32[0 max] operandNode,
    borrow StatementList body)
{
    stack mut TypedMemberTypeFacts targetFacts = new();
    TypedMemberFactsFromTypeSpan(
        source,
        stream,
        declarations,
        (u32[0 max])(openParenToken + 1),
        targetCloseToken,
        targetPrimaryToken,
        0,
        0,
        targetFacts);

    stack mut TypedMemberTypeFacts operandFacts = new();
    stack mut TypedConversionOperandKind operandKind = TypedConversionOperandKind.Unknown;
    TypedConversionOperandFactsFromBodyNode(
        source,
        stream,
        declarations,
        literals,
        identifiers,
        calls,
        members,
        indexes,
        table,
        body,
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        operandNode,
        operandFacts,
        operandKind);

    stack u32[0 max] flags = TypedConversionFlagsFromFacts(targetFacts, operandFacts);
    return table.AppendConversion(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        conversionNode,
        openParenToken,
        operandNode,
        operandKind,
        targetFacts.TypeKind,
        targetFacts.TypeHeadToken,
        targetFacts.TypePrimaryToken,
        targetFacts.TypeStartToken,
        targetFacts.TypeEndToken,
        targetFacts.RangeStartToken,
        targetFacts.RangeEndToken,
        targetFacts.ElementCountStartToken,
        targetFacts.ElementCountEndToken,
        targetFacts.BitWidth,
        targetFacts.TypeArgumentCount,
        targetFacts.ComptimeArgumentCount,
        targetFacts.TypeFlags,
        operandFacts.TypeKind,
        operandFacts.TypeHeadToken,
        operandFacts.TypePrimaryToken,
        operandFacts.TypeStartToken,
        operandFacts.TypeEndToken,
        operandFacts.RangeStartToken,
        operandFacts.RangeEndToken,
        operandFacts.ElementCountStartToken,
        operandFacts.ElementCountEndToken,
        operandFacts.BitWidth,
        operandFacts.TypeArgumentCount,
        operandFacts.ComptimeArgumentCount,
        operandFacts.TypeFlags,
        flags);
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsFromGlobalDeclaration(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    DeclItem item,
    u32[0 max] declarationIndex)
{
    if (!TypedGlobalDeclarationKindIsGlobal(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] assignToken = TypedGlobalFindAssignToken(stream, item);
    if (assignToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] ownerNameToken = TypedGlobalFindNameToken(stream, item);
    stack ExprTree tree = ParseExpression(stream, (u32[0 max])(assignToken + 1));
    stack u64[0 2 ** 63 - 1] count = tree.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= count; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (tree.NodeKindAt(node) == Compiler.Parsing.ExprKind.Conversion)
        {
            switch (AppendTypedConversionExpression(
                table,
                source,
                stream,
                declarations,
                literals,
                identifiers,
                calls,
                members,
                indexes,
                TypedConversionContext.GlobalInitializer,
                declarationIndex,
                ownerNameToken,
                0,
                0,
                node,
                tree.TokenAt(node),
                tree.LeftAt(node),
                tree.AuxAt(node),
                tree.RightAt(node),
                tree))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsFromBodyStatement(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statementIndex)
{
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    stack u32[0 max] start = (u32[0 max])(body.ExprStartAt(statementIndex) + 1);
    stack mut u32[0 max] end = (u32[0 max])body.ExprNodeCount();
    if (statementIndex + 1 < statementCount)
    {
        end = body.ExprStartAt((u64[0 2 ** 63 - 1])(statementIndex + 1));
    }

    if (start > end)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] statementIndexPlusOne = (u32[0 max])(statementIndex + 1);
    stack u64[0 2 ** 63 - 1] endIndex = (u64[0 2 ** 63 - 1])end;
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])start; nodeIndex <= endIndex; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Conversion)
        {
            switch (AppendTypedConversionBodyExpression(
                table,
                source,
                stream,
                declarations,
                literals,
                identifiers,
                calls,
                members,
                indexes,
                TypedConversionContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                node,
                body.ExprTokenAt(node),
                body.ExprLeftAt(node),
                body.ExprAuxAt(node),
                body.ExprRightAt(node),
                body))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsFromBody(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedConversionsFromBodyStatement(
            table,
            source,
            stream,
            declarations,
            literals,
            identifiers,
            calls,
            members,
            indexes,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            body,
            index))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsForFunction(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] fnKeyword)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    return AppendTypedConversionsFromBody(
        table,
        source,
        stream,
        declarations,
        literals,
        identifiers,
        calls,
        members,
        indexes,
        ownerDeclarationIndex,
        ownerNameToken,
        signature.Name(),
        body);
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsForMemberFunctions(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    DeclItem item,
    u32[0 max] ownerDeclarationIndex)
{
    if (!TypedSignatureDeclarationCanOwnMethods(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, item);
    if (bodyOpen == 0 || bodyOpen >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Fn)
        {
            switch (AppendTypedConversionsForFunction(table, source, stream, declarations, literals, identifiers, calls, members, indexes, ownerDeclarationIndex, item.NameToken, scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn ParseResult<TypedConversionExpressionTable> BuildTypedConversionExpressionsFromDependencies(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes)
{
    stack mut TypedConversionExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedConversionsFromGlobalDeclaration(
            table,
            source,
            stream,
            declarations,
            literals,
            identifiers,
            calls,
            members,
            indexes,
            item,
            (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedConversionsForFunction(table, source, stream, declarations, literals, identifiers, calls, members, indexes, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedConversionsForMemberFunctions(table, source, stream, declarations, literals, identifiers, calls, members, indexes, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberFunctionError):
                    return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedConversionExpressionTable>.Ok(table);
}

public fn ParseResult<TypedConversionExpressionTable> BuildTypedConversionExpressions(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedFunctionSignatureTable signatures = new();
    switch (BuildTypedFunctionSignatures(source, stream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFunctionSignatureTable>.Ok(var builtSignatures):
            signatures = builtSignatures;
    }

    stack mut TypedFieldDeclarationTable fields = new();
    switch (BuildTypedStructRecordFields(source, stream, declarations))
    {
        case ParseResult<TypedFieldDeclarationTable>.Err(var fieldError):
            return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFieldDeclarationTable>.Ok(var builtFields):
            fields = builtFields;
    }

    stack mut TypedLiteralExpressionTable literals = new();
    switch (BuildTypedLiteralExpressions(source, stream, declarations))
    {
        case ParseResult<TypedLiteralExpressionTable>.Err(var literalError):
            return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedLiteralExpressionTable>.Ok(var builtLiterals):
            literals = builtLiterals;
    }

    stack mut TypedIdentifierExpressionTable identifiers = new();
    switch (BuildTypedIdentifierExpressions(source, stream, declarations))
    {
        case ParseResult<TypedIdentifierExpressionTable>.Err(var identifierError):
            return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIdentifierExpressionTable>.Ok(var builtIdentifiers):
            identifiers = builtIdentifiers;
    }

    stack mut TypedCallExpressionTable calls = new();
    stack mut TypedMemberExpressionTable members = new();
    switch (BuildTypedMemberCallDependencies(source, stream, declarations, signatures, fields, literals, identifiers))
    {
        case ParseResult<TypedMemberCallDependencySet>.Err(var dependencyError):
            return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedMemberCallDependencySet>.Ok(var dependencies):
            calls = dependencies.Calls;
            members = dependencies.Members;
    }

    stack mut TypedIndexExpressionTable indexes = new();
    switch (BuildTypedIndexExpressionsFromDependencies(source, stream, declarations, identifiers, calls, members))
    {
        case ParseResult<TypedIndexExpressionTable>.Err(var indexError):
            return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIndexExpressionTable>.Ok(var builtIndexes):
            indexes = builtIndexes;
    }

    return BuildTypedConversionExpressionsFromDependencies(source, stream, declarations, literals, identifiers, calls, members, indexes);
}

internal fn void TypedAssignmentTargetFactsFromTreeNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    borrow ExprTree tree,
    TypedAssignmentContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] targetNode,
    mut borrow TypedMemberTypeFacts targetFacts,
    out TypedAssignmentTargetKind targetKind,
    out TypedIdentifierTargetKind identifierTargetKind,
    out TypedMemberTargetKind memberTargetKind,
    out TypedIndexAccessKind indexAccessKind,
    out u32[0 max] targetDeclarationIndex,
    out u32[0 max] targetSymbolIndexPlusOne,
    out u32[0 max] targetNameToken,
    out TypedGlobalStorageKind targetStorageKind,
    out TypedGlobalBindingKind targetBindingKind)
{
    targetKind = TypedAssignmentTargetKind.Unknown;
    identifierTargetKind = TypedIdentifierTargetKind.Unknown;
    memberTargetKind = TypedMemberTargetKind.Unknown;
    indexAccessKind = TypedIndexAccessKind.Unknown;
    targetDeclarationIndex = 0;
    targetSymbolIndexPlusOne = 0;
    targetNameToken = 0;
    targetStorageKind = TypedGlobalStorageKind.Unknown;
    targetBindingKind = TypedGlobalBindingKind.Unknown;

    stack ExprKind kind = tree.NodeKindAt(targetNode);
    if (kind == Compiler.Parsing.ExprKind.Identifier)
    {
        targetKind = TypedAssignmentTargetKind.Identifier;
        stack u32[0 max] identifierIndexPlusOne = TypedMemberIdentifierIndexForNode(
            identifiers,
            TypedAssignmentMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            targetNode);
        TypedMemberFactsFromIdentifier(source, stream, declarations, identifiers, identifierIndexPlusOne, targetFacts);
        if (identifierIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] identifierIndex = (u64[0 2 ** 63 - 1])(identifierIndexPlusOne - 1);
            identifierTargetKind = identifiers.TargetKindAt(identifierIndex);
            targetDeclarationIndex = identifiers.TargetDeclarationIndexAt(identifierIndex);
            targetSymbolIndexPlusOne = identifiers.TargetSymbolIndexPlusOneAt(identifierIndex);
            targetNameToken = identifiers.TargetNameTokenAt(identifierIndex);
            targetStorageKind = identifiers.StorageKindAt(identifierIndex);
            targetBindingKind = identifiers.BindingKindAt(identifierIndex);
            if (targetNameToken == 0)
            {
                targetNameToken = identifiers.NameTokenAt(identifierIndex);
            }
        }

        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Member)
    {
        stack u32[0 max] memberIndexPlusOne = TypedMemberExpressionIndexForNode(
            members,
            TypedAssignmentMemberContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            targetNode);
        TypedMemberFactsFromMember(source, stream, declarations, members, memberIndexPlusOne, targetFacts);
        if (memberIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] memberIndex = (u64[0 2 ** 63 - 1])(memberIndexPlusOne - 1);
            stack TypedMemberTargetKind resolvedMemberTargetKind = members.TargetKindAt(memberIndex);
            memberTargetKind = resolvedMemberTargetKind;
            if (resolvedMemberTargetKind == TypedMemberTargetKind.Field)
            {
                targetKind = TypedAssignmentTargetKind.Field;
            }

            targetDeclarationIndex = members.TargetDeclarationIndexAt(memberIndex);
            targetSymbolIndexPlusOne = members.TargetSymbolIndexPlusOneAt(memberIndex);
            targetNameToken = members.TargetNameTokenAt(memberIndex);
        }

        return;
    }

    if (kind == Compiler.Parsing.ExprKind.Index)
    {
        stack u32[0 max] indexIndexPlusOne = TypedIndexExpressionIndexForNode(
            indexes,
            TypedAssignmentIndexContext(context),
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            targetNode);
        TypedIndexFactsFromIndex(source, stream, declarations, indexes, indexIndexPlusOne, targetFacts);
        if (indexIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] indexIndex = (u64[0 2 ** 63 - 1])(indexIndexPlusOne - 1);
            stack TypedIndexAccessKind resolvedAccessKind = indexes.AccessKindAt(indexIndex);
            indexAccessKind = resolvedAccessKind;
            if (TypedAssignmentIndexAccessKindIsSlice(resolvedAccessKind))
            {
                targetKind = TypedAssignmentTargetKind.IndexSlice;
            }
            else
            {
                targetKind = TypedAssignmentTargetKind.IndexElement;
            }

            targetDeclarationIndex = targetFacts.DeclarationIndex;
            targetNameToken = targetFacts.NameToken;
        }
    }
}

internal fn void TypedAssignmentTargetFactsFromBodyNode(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
