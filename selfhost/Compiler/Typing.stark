public struct TypedLayoutQueryConstant
{
    TypedLayoutQueryConstantKind KindValue;
    u64[0 max] U64ValueValue;
    bool BoolValueValue;

    TypedLayoutQueryConstant()
    {
        self.KindValue = TypedLayoutQueryConstantKind.Unknown;
        self.U64ValueValue = 0;
        self.BoolValueValue = false;
    }

    public inline finite law TypedLayoutQueryConstantKind Kind(borrow TypedLayoutQueryConstant self)
    {
        return self.KindValue;
    }

    public inline finite law u64[0 max] U64Value(borrow TypedLayoutQueryConstant self)
    {
        return self.U64ValueValue;
    }

    public inline finite law bool BoolValue(borrow TypedLayoutQueryConstant self)
    {
        return self.BoolValueValue;
    }

    public inline finite law bool IsU64(borrow TypedLayoutQueryConstant self)
    {
        return self.KindValue == TypedLayoutQueryConstantKind.U64;
    }

    public inline finite law bool IsBool(borrow TypedLayoutQueryConstant self)
    {
        return self.KindValue == TypedLayoutQueryConstantKind.Bool;
    }

    internal fn void SetU64(mut borrow TypedLayoutQueryConstant self, u64[0 max] value)
    {
        self.KindValue = TypedLayoutQueryConstantKind.U64;
        self.U64ValueValue = value;
        self.BoolValueValue = false;
        return;
    }

    internal fn void SetBool(mut borrow TypedLayoutQueryConstant self, bool value)
    {
        self.KindValue = TypedLayoutQueryConstantKind.Bool;
        self.U64ValueValue = 0;
        self.BoolValueValue = value;
        return;
    }
}

