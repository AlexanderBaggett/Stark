        init self.CandidateMemberIndices[self.CandidateMemberIndices.Length] = memberIndexPlusOne;
        init self.CandidateKinds[self.CandidateKinds.Length] = candidateKind;
        init self.CandidateSignatureIndices[self.CandidateSignatureIndices.Length] = signatureIndexPlusOne;
        init self.CandidateNameTokens[self.CandidateNameTokens.Length] = candidateNameToken;
        init self.CandidateParameterCounts[self.CandidateParameterCounts.Length] = candidateParameterCount;
