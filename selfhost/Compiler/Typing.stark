    public law u32[0 max] TypeSlotParamNameTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypeSlotParamNameTokens.Length)
        {
            token = self.TypeSlotParamNameTokens[slot];
        }

        return token;
    }

    public law TypedSignatureTypeKind TypeKindAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut TypedSignatureTypeKind kind = TypedSignatureTypeKind.Unknown;
        if (slot < self.TypeKinds.Length)
        {
            kind = self.TypeKinds[slot];
        }

        return kind;
    }

    public law u32[0 max] TypeHeadTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypeHeadTokens.Length)
        {
            token = self.TypeHeadTokens[slot];
        }

        return token;
    }

    public law u32[0 max] TypePrimaryTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypePrimaryTokens.Length)
        {
            token = self.TypePrimaryTokens[slot];
        }

        return token;
    }

    public law u32[0 max] TypeStartTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypeStartTokens.Length)
        {
            token = self.TypeStartTokens[slot];
        }

        return token;
    }

    public law u32[0 max] TypeEndTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypeEndTokens.Length)
        {
            token = self.TypeEndTokens[slot];
        }

