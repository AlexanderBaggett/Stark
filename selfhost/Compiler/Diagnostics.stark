    location.ColumnValue = column;
    location.EndLineValue = endLine;
    location.EndColumnValue = endColumn;

    if (hasFilePath)
    {
        switch (CopyAsciiInto(filePath, location.FilePathText))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticResult<SourceLocation>.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    return DiagnosticResult<SourceLocation>.Ok(location);
}

public struct CompilerDiagnostic
{
    internal DiagnosticSeverity SeverityValue;
    internal OwnedAscii CodeText;
    internal OwnedAscii MessageText;
    internal OwnedAscii StageText;
    internal OwnedAscii FilePathText;
    internal bool HasStageValue;
    internal bool HasLocationValue;
    internal bool HasFilePathValue;
    internal u64[1 2 ** 63 - 1] LineValue;
    internal u64[1 2 ** 63 - 1] ColumnValue;
    internal u64[0 2 ** 63 - 1] EndLineValue;
    internal u64[0 2 ** 63 - 1] EndColumnValue;

    CompilerDiagnostic()
    {
        self.SeverityValue = DiagnosticSeverity.Info;
        self.CodeText = new();
        self.MessageText = new();
        self.StageText = new();
        self.FilePathText = new();
        self.HasStageValue = false;
        self.HasLocationValue = false;
        self.HasFilePathValue = false;
        self.LineValue = 1;
        self.ColumnValue = 1;
        self.EndLineValue = 0;
        self.EndColumnValue = 0;
    }

    public inline finite law DiagnosticSeverity Severity(borrow CompilerDiagnostic self)
    {
        return self.SeverityValue;
    }

    public inline finite law bool HasStage(borrow CompilerDiagnostic self)
    {
        return self.HasStageValue;
    }

    public inline finite law bool HasLocation(borrow CompilerDiagnostic self)
    {
        return self.HasLocationValue;
    }

    public inline finite law u64[1 2 ** 63 - 1] Line(borrow CompilerDiagnostic self)
    {
        return self.LineValue;
    }

    public inline finite law u64[1 2 ** 63 - 1] Column(borrow CompilerDiagnostic self)
    {
        return self.ColumnValue;
    }

    public inline finite law u64[1 2 ** 63 - 1] ResolvedEndLine(borrow CompilerDiagnostic self)
    {
        if (self.EndLineValue > 0)
        {
            return (u64[1 2 ** 63 - 1])self.EndLineValue;
        }

        return self.LineValue;
    }

    public inline finite law u64[1 2 ** 63 - 1] ResolvedEndColumn(borrow CompilerDiagnostic self)
    {
        if (self.EndColumnValue > 0)
        {
            return (u64[1 2 ** 63 - 1])self.EndColumnValue;
        }

        return self.ColumnValue;
    }

    public fn bool CodeEquals(mut borrow CompilerDiagnostic self, ascii expected)
    {
        return System.Text.OwnedAsciiEqualsAscii(self.CodeText, expected);
    }

    public fn bool MessageEquals(mut borrow CompilerDiagnostic self, ascii expected)
    {
        return System.Text.OwnedAsciiEqualsAscii(self.MessageText, expected);
    }

    public fn bool StageEquals(mut borrow CompilerDiagnostic self, ascii expected)
    {
        if (!self.HasStageValue)
        {
            return false;
        }

        return System.Text.OwnedAsciiEqualsAscii(self.StageText, expected);
    }

    public fn bool FilePathEquals(mut borrow CompilerDiagnostic self, ascii expected)
    {
        if (!self.HasLocationValue || !self.HasFilePathValue)
        {
            return false;
        }

        return System.Text.OwnedAsciiEqualsAscii(self.FilePathText, expected);
    }
}

public fn DiagnosticResult<CompilerDiagnostic> CompilerDiagnosticOf(
    DiagnosticSeverity severity,
    ascii code,
    ascii message,
    ascii stage,
    bool hasStage,
    ascii filePath,
    bool hasFilePath,
    u64[1 2 ** 63 - 1] line,
    u64[1 2 ** 63 - 1] column,
    u64[0 2 ** 63 - 1] endLine,
    u64[0 2 ** 63 - 1] endColumn,
    bool hasLocation)
{
    stack mut CompilerDiagnostic diagnostic = new CompilerDiagnostic();
    diagnostic.SeverityValue = severity;
    diagnostic.HasStageValue = hasStage;
    diagnostic.HasLocationValue = hasLocation;
    diagnostic.HasFilePathValue = hasLocation && hasFilePath;
    diagnostic.LineValue = line;
    diagnostic.ColumnValue = column;
    diagnostic.EndLineValue = endLine;
    diagnostic.EndColumnValue = endColumn;

    switch (CopyAsciiInto(code, diagnostic.CodeText))
    {
        case DiagnosticStatus.Err(var codeError):
            return DiagnosticResult<CompilerDiagnostic>.Err(codeError);
        case DiagnosticStatus.Ok:
    }

    switch (CopyAsciiInto(message, diagnostic.MessageText))
    {
        case DiagnosticStatus.Err(var messageError):
            return DiagnosticResult<CompilerDiagnostic>.Err(messageError);
        case DiagnosticStatus.Ok:
    }

    if (hasStage)
    {
        switch (CopyAsciiInto(stage, diagnostic.StageText))
        {
            case DiagnosticStatus.Err(var stageError):
                return DiagnosticResult<CompilerDiagnostic>.Err(stageError);
            case DiagnosticStatus.Ok:
        }
    }

    if (hasLocation && hasFilePath)
    {
        switch (CopyAsciiInto(filePath, diagnostic.FilePathText))
        {
            case DiagnosticStatus.Err(var filePathError):
                return DiagnosticResult<CompilerDiagnostic>.Err(filePathError);
            case DiagnosticStatus.Ok:
        }
    }

    return DiagnosticResult<CompilerDiagnostic>.Ok(diagnostic);
}

internal fn DiagnosticStatus AppendCompilerDiagnosticLocationTextParts(
    mut borrow OwnedAscii writer,
    bool hasFilePath,
    ascii filePath,
    u64[1 2 ** 63 - 1] line,
    u64[1 2 ** 63 - 1] column)
    where overlap(writer, filePath)
{
    stack mut bool appendFilePath = false;
    if (hasFilePath)
    {
        unsafe
        {
            appendFilePath = DiagnosticAsciiHasNonWhitespace(filePath);
        }
    }

    if (appendFilePath)
    {
        switch (DiagnosticAppendAscii(writer, filePath))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendAscii(writer, ":"))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    switch (DiagnosticAppendU64(writer, (u64[0 max])line))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendAscii(writer, ":"))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    return DiagnosticAppendU64(writer, (u64[0 max])column);
}

internal fn DiagnosticStatus AppendCompilerDiagnosticLineParts(
    mut borrow OwnedAscii writer,
    DiagnosticSeverity severity,
    ascii code,
    ascii message,
    bool hasStage,
    ascii stage,
    bool hasLocation,
    bool hasFilePath,
    ascii filePath,
    u64[1 2 ** 63 - 1] line,
    u64[1 2 ** 63 - 1] column)
    where overlap(writer, code, message, stage, filePath)
{
    if (hasLocation)
    {
        switch (AppendCompilerDiagnosticLocationTextParts(writer, hasFilePath, filePath, line, column))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendAscii(writer, ": "))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    switch (DiagnosticAppendAscii(writer, DiagnosticSeverityName(severity)))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendAscii(writer, " "))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendAscii(writer, code))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    stack mut bool appendStage = false;
    if (hasStage)
    {
        unsafe
        {
            appendStage = DiagnosticAsciiHasNonWhitespace(stage);
        }
    }

    if (appendStage)
    {
        switch (DiagnosticAppendAscii(writer, " ["))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendAscii(writer, stage))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendAscii(writer, "]"))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    switch (DiagnosticAppendAscii(writer, ": "))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    return DiagnosticAppendAscii(writer, message);
}

public fn DiagnosticStatus AppendCompilerDiagnosticLine(
    mut borrow OwnedAscii writer,
    mut borrow CompilerDiagnostic diagnostic)
{
    stack mut ascii code = diagnostic.CodeText.View();
    stack mut ascii message = diagnostic.MessageText.View();
    stack mut ascii stage = "";
    stack mut ascii filePath = "";

    if (diagnostic.HasStageValue)
    {
        stage = diagnostic.StageText.View();
    }

    if (diagnostic.HasLocationValue && diagnostic.HasFilePathValue)
    {
        filePath = diagnostic.FilePathText.View();
    }

    return AppendCompilerDiagnosticLineParts(
        writer,
        diagnostic.SeverityValue,
        code,
        message,
        diagnostic.HasStageValue,
        stage,
        diagnostic.HasLocationValue,
        diagnostic.HasFilePathValue,
        filePath,
        diagnostic.LineValue,
        diagnostic.ColumnValue);
}

internal fn DiagnosticStatus AppendCompilerDiagnosticGroupedNoteHeaderParts(
    mut borrow OwnedAscii writer,
    ascii message,
    bool hasStage,
    ascii stage,
    bool hasLocation,
    bool hasFilePath,
    ascii filePath,
    u64[1 2 ** 63 - 1] line,
    u64[1 2 ** 63 - 1] column)
    where overlap(writer, message, stage, filePath)
{
    switch (DiagnosticAppendAscii(writer, "  note"))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    stack mut bool appendStage = false;
    if (hasStage)
    {
        unsafe
        {
            appendStage = DiagnosticAsciiHasNonWhitespace(stage);
        }
    }

    if (appendStage)
    {
        switch (DiagnosticAppendAscii(writer, " ["))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendAscii(writer, stage))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendAscii(writer, "]"))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    if (hasLocation)
    {
        switch (DiagnosticAppendAscii(writer, " at "))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (AppendCompilerDiagnosticLocationTextParts(writer, hasFilePath, filePath, line, column))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    switch (DiagnosticAppendAscii(writer, ": "))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    return DiagnosticAppendAscii(writer, message);
}

public fn DiagnosticStatus AppendCompilerDiagnosticGroupedNoteHeader(
    mut borrow OwnedAscii writer,
    mut borrow CompilerDiagnostic diagnostic)
{
    stack mut ascii message = diagnostic.MessageText.View();
    stack mut ascii stage = "";
    stack mut ascii filePath = "";

    if (diagnostic.HasStageValue)
    {
        stage = diagnostic.StageText.View();
    }

    if (diagnostic.HasLocationValue && diagnostic.HasFilePathValue)
    {
        filePath = diagnostic.FilePathText.View();
    }

    return AppendCompilerDiagnosticGroupedNoteHeaderParts(
        writer,
        message,
        diagnostic.HasStageValue,
        stage,
        diagnostic.HasLocationValue,
        diagnostic.HasFilePathValue,
