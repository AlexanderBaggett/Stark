        diagnostic.LineValue,
        diagnostic.ColumnValue);
}

internal fn bool CompilerDiagnosticMatchesSourceMap(
    mut borrow CompilerDiagnostic diagnostic,
    mut borrow SourceFileMap sourceMap)
{
    if (!diagnostic.HasLocationValue)
    {
        return false;
    }

    if (!diagnostic.HasFilePathValue)
    {
        return true;
    }

    if (!sourceMap.HasFilePathValue)
    {
        return false;
    }

    return System.Text.OwnedAsciiEqualsAscii(sourceMap.FilePathText, diagnostic.FilePathText.View());
}

public fn DiagnosticStatus AppendCompilerDiagnosticTextWithSourceMap(
    mut borrow OwnedAscii writer,
    mut borrow CompilerDiagnostic diagnostic,
    mut borrow SourceFileMap sourceMap)
{
    switch (AppendCompilerDiagnosticLine(writer, diagnostic))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendByte(writer, 10))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (!CompilerDiagnosticMatchesSourceMap(diagnostic, sourceMap))
    {
        return DiagnosticStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] before = writer.Length();
    switch (AppendSourceCaretForDiagnostic(writer, sourceMap, diagnostic))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (writer.Length() > before)
    {
        return DiagnosticAppendByte(writer, 10);
    }

    return DiagnosticStatus.Ok;
}

internal unsafe fn DiagnosticStatus AppendIndentedAscii(
    mut borrow OwnedAscii writer,
    ascii text,
    ascii indent)
    where overlap(writer, text, indent)
{
    stack i64[min max] signedLength = System.Text.AsciiLength(text);
    if (signedLength <= 0)
    {
        return DiagnosticStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] length = (u64[0 2 ** 63 - 1])signedLength;
    stack rawptr<i8[min max]> data = System.Text.AsciiData(text);
    if (data == null)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }

    switch (DiagnosticAppendAscii(writer, indent))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < length; index += 1)
    {
        stack i8[min max] unit = *(&data[index]);
        switch (DiagnosticAppendByte(writer, unit))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        stack u64[0 2 ** 63 - 1] next = index + 1;
        if (unit == 10 && next < length)
        {
            switch (DiagnosticAppendAscii(writer, indent))
            {
                case DiagnosticStatus.Err(var error):
                    return DiagnosticStatus.Err(error);
                case DiagnosticStatus.Ok:
            }
        }
    }

    return DiagnosticStatus.Ok;
}

public struct DiagnosticBag
{
    internal dynamic DiagnosticSeverity Severities;
    internal dynamic OwnedAscii Codes;
    internal dynamic OwnedAscii Messages;
    internal dynamic OwnedAscii Stages;
    internal dynamic bool HasStages;
    internal dynamic bool HasLocations;
    internal dynamic OwnedAscii FilePaths;
    internal dynamic bool HasFilePaths;
    internal dynamic u64[1 2 ** 63 - 1] Lines;
    internal dynamic u64[1 2 ** 63 - 1] Columns;
    internal dynamic u64[0 2 ** 63 - 1] EndLines;
    internal dynamic u64[0 2 ** 63 - 1] EndColumns;

    DiagnosticBag()
    {
        self.Severities = new();
        self.Codes = new();
        self.Messages = new();
        self.Stages = new();
        self.HasStages = new();
        self.HasLocations = new();
        self.FilePaths = new();
        self.HasFilePaths = new();
        self.Lines = new();
        self.Columns = new();
        self.EndLines = new();
        self.EndColumns = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow DiagnosticBag self)
    {
        return self.Severities.Length;
    }

    public law bool HasErrors(borrow DiagnosticBag self)
    {
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < self.Severities.Length; index += 1)
        {
            if (self.Severities[index] == DiagnosticSeverity.Error)
            {
                return true;
            }
        }

        return false;
    }

    public law DiagnosticSeverity SeverityAt(borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.Severities.Length)
        {
            return self.Severities[index];
        }

        return DiagnosticSeverity.Info;
    }

    public law bool HasStageAt(borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.HasStages.Length)
        {
            return self.HasStages[index];
        }

        return false;
    }

    public law bool HasLocationAt(borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.HasLocations.Length)
        {
            return self.HasLocations[index];
        }

        return false;
    }

    public law u64[1 2 ** 63 - 1] LineAt(borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.Lines.Length)
        {
            return self.Lines[index];
        }

        return 1;
    }

    public law u64[1 2 ** 63 - 1] ColumnAt(borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index)
    {
        if (index < self.Columns.Length)
        {
            return self.Columns[index];
        }

        return 1;
    }

    public law u64[1 2 ** 63 - 1] ResolvedEndLineAt(borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index)
    {
        if (index >= self.EndLines.Length)
        {
            return self.LineAt(index);
        }

        stack u64[0 2 ** 63 - 1] endLine = self.EndLines[index];
        if (endLine > 0)
        {
            return (u64[1 2 ** 63 - 1])endLine;
        }

        return self.LineAt(index);
    }

    public law u64[1 2 ** 63 - 1] ResolvedEndColumnAt(borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index)
    {
        if (index >= self.EndColumns.Length)
        {
            return self.ColumnAt(index);
        }

        stack u64[0 2 ** 63 - 1] endColumn = self.EndColumns[index];
        if (endColumn > 0)
        {
            return (u64[1 2 ** 63 - 1])endColumn;
        }

        return self.ColumnAt(index);
    }

    public fn bool CodeEqualsAt(mut borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index, ascii expected)
    {
        if (index >= self.Codes.Length)
        {
            return false;
        }

        return System.Text.OwnedAsciiEqualsAscii(self.Codes[index], expected);
    }

    public fn bool MessageEqualsAt(mut borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index, ascii expected)
    {
        if (index >= self.Messages.Length)
        {
            return false;
        }

        return System.Text.OwnedAsciiEqualsAscii(self.Messages[index], expected);
    }

    public fn bool StageEqualsAt(mut borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index, ascii expected)
    {
        if (index >= self.HasStages.Length)
        {
            return false;
        }

        if (!self.HasStages[index])
        {
            return false;
        }

        if (index >= self.Stages.Length)
        {
            return false;
        }

        return System.Text.OwnedAsciiEqualsAscii(self.Stages[index], expected);
    }

    public fn bool FilePathEqualsAt(mut borrow DiagnosticBag self, u64[0 2 ** 63 - 1] index, ascii expected)
    {
        if (index >= self.HasFilePaths.Length)
        {
            return false;
        }

        if (!self.HasFilePaths[index])
        {
            return false;
        }

        if (index >= self.FilePaths.Length)
        {
            return false;
        }

        return System.Text.OwnedAsciiEqualsAscii(self.FilePaths[index], expected);
    }

    public fn DiagnosticStatus Add(mut borrow DiagnosticBag self, CompilerDiagnostic diagnostic)
    {
        if (!self.Severities.TryReserve(1)
            || !self.Codes.TryReserve(1)
            || !self.Messages.TryReserve(1)
            || !self.Stages.TryReserve(1)
            || !self.HasStages.TryReserve(1)
            || !self.HasLocations.TryReserve(1)
            || !self.FilePaths.TryReserve(1)
            || !self.HasFilePaths.TryReserve(1)
            || !self.Lines.TryReserve(1)
            || !self.Columns.TryReserve(1)
            || !self.EndLines.TryReserve(1)
            || !self.EndColumns.TryReserve(1))
        {
            return DiagnosticStatus.Err(DiagnosticError.OutOfMemory);
        }

        stack DiagnosticSeverity severity = diagnostic.SeverityValue;
        stack bool hasStage = diagnostic.HasStageValue;
        stack bool hasLocation = diagnostic.HasLocationValue;
        stack bool hasFilePath = diagnostic.HasFilePathValue;
        stack u64[1 2 ** 63 - 1] line = diagnostic.LineValue;
        stack u64[1 2 ** 63 - 1] column = diagnostic.ColumnValue;
        stack u64[0 2 ** 63 - 1] endLine = diagnostic.EndLineValue;
        stack u64[0 2 ** 63 - 1] endColumn = diagnostic.EndColumnValue;
        stack mut OwnedAscii codeText = new();
        stack mut OwnedAscii messageText = new();
        stack mut OwnedAscii stageText = new();
        stack mut OwnedAscii filePathText = new();

        switch (System.Text.OwnedAscii.Format(diagnostic.CodeText, codeText))
        {
            case System.Memory.MemoryStatus.Err(var codeError):
                return DiagnosticStatus.Err(DiagnosticError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        switch (System.Text.OwnedAscii.Format(diagnostic.MessageText, messageText))
        {
            case System.Memory.MemoryStatus.Err(var messageError):
                return DiagnosticStatus.Err(DiagnosticError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (hasStage)
        {
            switch (System.Text.OwnedAscii.Format(diagnostic.StageText, stageText))
            {
                case System.Memory.MemoryStatus.Err(var stageError):
                    return DiagnosticStatus.Err(DiagnosticError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (hasLocation && hasFilePath)
        {
            switch (System.Text.OwnedAscii.Format(diagnostic.FilePathText, filePathText))
            {
                case System.Memory.MemoryStatus.Err(var filePathError):
                    return DiagnosticStatus.Err(DiagnosticError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        init self.Severities[self.Severities.Length] = severity;
        init self.Codes[self.Codes.Length] = codeText;
        init self.Messages[self.Messages.Length] = messageText;
        init self.Stages[self.Stages.Length] = stageText;
        init self.HasStages[self.HasStages.Length] = hasStage;
        init self.HasLocations[self.HasLocations.Length] = hasLocation;
        init self.FilePaths[self.FilePaths.Length] = filePathText;
        init self.HasFilePaths[self.HasFilePaths.Length] = hasLocation && hasFilePath;
        init self.Lines[self.Lines.Length] = line;
        init self.Columns[self.Columns.Length] = column;
        init self.EndLines[self.EndLines.Length] = endLine;
        init self.EndColumns[self.EndColumns.Length] = endColumn;
        return DiagnosticStatus.Ok;
    }

    public fn DiagnosticStatus Append(
        mut borrow DiagnosticBag self,
        DiagnosticSeverity severity,
        ascii code,
        ascii message,
        ascii stage,
        bool hasStage,
        ascii filePath,
        bool hasFilePath,
        u64[1 2 ** 63 - 1] line,
        u64[1 2 ** 63 - 1] column,
        u64[0 2 ** 63 - 1] endLine,
        u64[0 2 ** 63 - 1] endColumn,
        bool hasLocation)
    {
        switch (CompilerDiagnosticOf(
            severity,
            code,
            message,
            stage,
            hasStage,
            filePath,
            hasFilePath,
            line,
            column,
            endLine,
            endColumn,
            hasLocation))
        {
            case DiagnosticResult<CompilerDiagnostic>.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticResult<CompilerDiagnostic>.Ok(var diagnostic):
                return self.Add(diagnostic);
        }
    }
}

internal fn DiagnosticStatus AppendDiagnosticBagRowLine(
    mut borrow OwnedAscii writer,
    mut borrow DiagnosticBag bag,
    u64[0 2 ** 63 - 1] index)
{
    if (index >= bag.Severities.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack DiagnosticSeverity severity = bag.Severities[index];

    if (index >= bag.HasStages.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack bool hasStage = bag.HasStages[index];

    if (index >= bag.HasLocations.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack bool hasLocation = bag.HasLocations[index];

    if (index >= bag.HasFilePaths.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack bool hasFilePath = bag.HasFilePaths[index];

    if (index >= bag.Lines.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack u64[1 2 ** 63 - 1] line = bag.Lines[index];

    if (index >= bag.Columns.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack u64[1 2 ** 63 - 1] column = bag.Columns[index];

    if (hasLocation)
    {
        if (hasFilePath)
        {
            if (index >= bag.FilePaths.Length)
            {
                return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
            }

            if (DiagnosticOwnedAsciiHasNonWhitespace(bag.FilePaths[index]))
            {
                switch (DiagnosticAppendOwnedAscii(writer, bag.FilePaths[index]))
                {
                    case DiagnosticStatus.Err(var error):
                        return DiagnosticStatus.Err(error);
                    case DiagnosticStatus.Ok:
                }

                switch (DiagnosticAppendAscii(writer, ":"))
                {
                    case DiagnosticStatus.Err(var error):
                        return DiagnosticStatus.Err(error);
                    case DiagnosticStatus.Ok:
                }
            }
        }

        switch (DiagnosticAppendU64(writer, (u64[0 max])line))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendAscii(writer, ":"))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendU64(writer, (u64[0 max])column))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendAscii(writer, ": "))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    switch (DiagnosticAppendAscii(writer, DiagnosticSeverityName(severity)))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendAscii(writer, " "))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (index >= bag.Codes.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    switch (DiagnosticAppendOwnedAscii(writer, bag.Codes[index]))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (hasStage)
    {
        if (index >= bag.Stages.Length)
        {
            return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
        }

        if (DiagnosticOwnedAsciiHasNonWhitespace(bag.Stages[index]))
        {
            switch (DiagnosticAppendAscii(writer, " ["))
            {
                case DiagnosticStatus.Err(var error):
                    return DiagnosticStatus.Err(error);
                case DiagnosticStatus.Ok:
            }

            switch (DiagnosticAppendOwnedAscii(writer, bag.Stages[index]))
            {
                case DiagnosticStatus.Err(var error):
                    return DiagnosticStatus.Err(error);
                case DiagnosticStatus.Ok:
            }

            switch (DiagnosticAppendAscii(writer, "]"))
            {
                case DiagnosticStatus.Err(var error):
                    return DiagnosticStatus.Err(error);
                case DiagnosticStatus.Ok:
            }
        }
    }

    switch (DiagnosticAppendAscii(writer, ": "))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (index >= bag.Messages.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    return DiagnosticAppendOwnedAscii(writer, bag.Messages[index]);
}

internal fn DiagnosticStatus AppendDiagnosticBagRowGroupedNoteHeader(
    mut borrow OwnedAscii writer,
    mut borrow DiagnosticBag bag,
    u64[0 2 ** 63 - 1] index)
{
    if (index >= bag.HasStages.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack bool hasStage = bag.HasStages[index];

    if (index >= bag.HasLocations.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack bool hasLocation = bag.HasLocations[index];

    if (index >= bag.HasFilePaths.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack bool hasFilePath = bag.HasFilePaths[index];

    if (index >= bag.Lines.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack u64[1 2 ** 63 - 1] line = bag.Lines[index];

    if (index >= bag.Columns.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack u64[1 2 ** 63 - 1] column = bag.Columns[index];

    switch (DiagnosticAppendAscii(writer, "  note"))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (hasStage)
    {
        if (index >= bag.Stages.Length)
        {
            return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
        }

        if (DiagnosticOwnedAsciiHasNonWhitespace(bag.Stages[index]))
        {
            switch (DiagnosticAppendAscii(writer, " ["))
            {
                case DiagnosticStatus.Err(var error):
                    return DiagnosticStatus.Err(error);
                case DiagnosticStatus.Ok:
            }

            switch (DiagnosticAppendOwnedAscii(writer, bag.Stages[index]))
            {
                case DiagnosticStatus.Err(var error):
                    return DiagnosticStatus.Err(error);
                case DiagnosticStatus.Ok:
            }

            switch (DiagnosticAppendAscii(writer, "]"))
            {
                case DiagnosticStatus.Err(var error):
                    return DiagnosticStatus.Err(error);
                case DiagnosticStatus.Ok:
            }
        }
    }

    if (hasLocation)
    {
        switch (DiagnosticAppendAscii(writer, " at "))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        if (hasFilePath)
        {
            if (index >= bag.FilePaths.Length)
            {
                return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
            }

            if (DiagnosticOwnedAsciiHasNonWhitespace(bag.FilePaths[index]))
            {
                switch (DiagnosticAppendOwnedAscii(writer, bag.FilePaths[index]))
                {
                    case DiagnosticStatus.Err(var error):
                        return DiagnosticStatus.Err(error);
                    case DiagnosticStatus.Ok:
                }

                switch (DiagnosticAppendAscii(writer, ":"))
                {
                    case DiagnosticStatus.Err(var error):
                        return DiagnosticStatus.Err(error);
                    case DiagnosticStatus.Ok:
                }
            }
        }

        switch (DiagnosticAppendU64(writer, (u64[0 max])line))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendAscii(writer, ":"))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        switch (DiagnosticAppendU64(writer, (u64[0 max])column))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    switch (DiagnosticAppendAscii(writer, ": "))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (index >= bag.Messages.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    return DiagnosticAppendOwnedAscii(writer, bag.Messages[index]);
}

public law u64[0 2 ** 63 - 1] DiagnosticBagSeverityCount(
    borrow DiagnosticBag bag,
    DiagnosticSeverity severity)
{
    stack mut u64[0 2 ** 63 - 1] count = 0;
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < bag.Severities.Length; index += 1)
    {
        if (bag.Severities[index] == severity)
        {
            count = count + 1;
        }
    }

    return count;
}

internal fn DiagnosticStatus AppendDiagnosticCount(
    mut borrow OwnedAscii writer,
    u64[0 2 ** 63 - 1] count,
    ascii singular)
    where overlap(writer, singular)
{
    switch (DiagnosticAppendU64(writer, (u64[0 max])count))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendAscii(writer, " "))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendAscii(writer, singular))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (count != 1)
    {
        return DiagnosticAppendAscii(writer, "s");
    }

    return DiagnosticStatus.Ok;
}

public fn DiagnosticStatus AppendDiagnosticSummary(
    mut borrow OwnedAscii writer,
    borrow DiagnosticBag bag,
    bool succeeded)
{
    if (succeeded)
    {
        switch (DiagnosticAppendAscii(writer, "Summary: "))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }
    else
    {
        switch (DiagnosticAppendAscii(writer, "Failure summary: "))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    switch (AppendDiagnosticCount(writer, DiagnosticBagSeverityCount(bag, DiagnosticSeverity.Error), "error"))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendAscii(writer, ", "))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (AppendDiagnosticCount(writer, DiagnosticBagSeverityCount(bag, DiagnosticSeverity.Warning), "warning"))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendAscii(writer, ", "))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (AppendDiagnosticCount(writer, DiagnosticBagSeverityCount(bag, DiagnosticSeverity.Info), "info"))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    return DiagnosticAppendAscii(writer, ".");
}

internal fn bool DiagnosticBagRowMatchesSourceMap(
    mut borrow DiagnosticBag bag,
    u64[0 2 ** 63 - 1] index,
    mut borrow SourceFileMap sourceMap)
{
    if (index >= bag.HasLocations.Length)
    {
        return false;
    }

    if (!bag.HasLocations[index])
    {
        return false;
    }

    if (index >= bag.HasFilePaths.Length)
    {
        return false;
    }

    stack bool hasFilePath = bag.HasFilePaths[index];
    if (!hasFilePath)
    {
        return true;
    }

    if (!sourceMap.HasFilePathValue)
    {
        return false;
    }

    if (index >= bag.FilePaths.Length)
    {
        return false;
    }

    return System.Text.OwnedAscii.Equals(sourceMap.FilePathText, bag.FilePaths[index]);
}

internal fn DiagnosticStatus AppendDiagnosticBagRowSourceSnippet(
    mut borrow OwnedAscii writer,
    mut borrow DiagnosticBag bag,
    u64[0 2 ** 63 - 1] index,
    mut borrow SourceFileMap sourceMap,
    bool indent)
{
    if (!DiagnosticBagRowMatchesSourceMap(bag, index, sourceMap))
    {
        return DiagnosticStatus.Ok;
    }

    if (index >= bag.Lines.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    stack mut SourceLocation location = new SourceLocation();
    location.HasFilePathValue = false;
    location.LineValue = bag.Lines[index];

    if (index >= bag.Columns.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    location.ColumnValue = bag.Columns[index];

    if (index >= bag.EndLines.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    location.EndLineValue = bag.EndLines[index];

    if (index >= bag.EndColumns.Length)
    {
        return DiagnosticStatus.Err(DiagnosticError.SourceRangeOutOfBounds);
    }
    location.EndColumnValue = bag.EndColumns[index];

    if (!indent)
    {
        stack u64[0 2 ** 63 - 1] before = writer.Length();
        switch (AppendSourceCaretForLocation(writer, sourceMap, location))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        if (writer.Length() > before)
        {
            return DiagnosticAppendByte(writer, 10);
        }

        return DiagnosticStatus.Ok;
    }

    stack mut OwnedAscii snippet = new();
    switch (AppendSourceCaretForLocation(snippet, sourceMap, location))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (snippet.Length() == 0)
    {
        return DiagnosticStatus.Ok;
    }

    unsafe
    {
        switch (AppendIndentedAscii(writer, snippet.View(), "  "))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }
    }

    return DiagnosticAppendByte(writer, 10);
}

internal fn DiagnosticStatus AppendDiagnosticBagPrimaryRow(
    mut borrow OwnedAscii writer,
    mut borrow DiagnosticBag bag,
    u64[0 2 ** 63 - 1] index,
    mut borrow SourceFileMap sourceMap,
    bool hasSourceMap)
{
    switch (AppendDiagnosticBagRowLine(writer, bag, index))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendByte(writer, 10))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (hasSourceMap)
    {
        return AppendDiagnosticBagRowSourceSnippet(writer, bag, index, sourceMap, false);
    }

    return DiagnosticStatus.Ok;
}

internal fn DiagnosticStatus AppendDiagnosticBagNoteRow(
    mut borrow OwnedAscii writer,
    mut borrow DiagnosticBag bag,
    u64[0 2 ** 63 - 1] index,
    mut borrow SourceFileMap sourceMap,
    bool hasSourceMap)
{
    switch (AppendDiagnosticBagRowGroupedNoteHeader(writer, bag, index))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    switch (DiagnosticAppendByte(writer, 10))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    if (hasSourceMap)
    {
        return AppendDiagnosticBagRowSourceSnippet(writer, bag, index, sourceMap, true);
    }

    return DiagnosticStatus.Ok;
}

internal fn DiagnosticStatus AppendDiagnosticBagTextCore(
    mut borrow OwnedAscii writer,
    mut borrow DiagnosticBag bag,
    mut borrow SourceFileMap sourceMap,
    bool hasSourceMap,
    bool succeeded)
{
    stack u64[0 2 ** 63 - 1] count = bag.Count();
    if (count == 0)
    {
        return DiagnosticStatus.Ok;
    }

    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < count)
    {
        if (bag.SeverityAt(index) == DiagnosticSeverity.Info)
        {
            switch (AppendDiagnosticBagPrimaryRow(writer, bag, index, sourceMap, hasSourceMap))
            {
                case DiagnosticStatus.Err(var error):
                    return DiagnosticStatus.Err(error);
                case DiagnosticStatus.Ok:
            }

            index = index + 1;
            continue;
        }

        switch (AppendDiagnosticBagPrimaryRow(writer, bag, index, sourceMap, hasSourceMap))
        {
            case DiagnosticStatus.Err(var error):
                return DiagnosticStatus.Err(error);
            case DiagnosticStatus.Ok:
        }

        index = index + 1;
        while willexit (index < count && bag.SeverityAt(index) == DiagnosticSeverity.Info)
        {
            switch (AppendDiagnosticBagNoteRow(writer, bag, index, sourceMap, hasSourceMap))
            {
                case DiagnosticStatus.Err(var error):
                    return DiagnosticStatus.Err(error);
                case DiagnosticStatus.Ok:
            }

            index = index + 1;
        }
    }

    switch (AppendDiagnosticSummary(writer, bag, succeeded))
    {
        case DiagnosticStatus.Err(var error):
            return DiagnosticStatus.Err(error);
        case DiagnosticStatus.Ok:
    }

    return DiagnosticAppendByte(writer, 10);
}

public fn DiagnosticStatus AppendDiagnosticBagText(
    mut borrow OwnedAscii writer,
    mut borrow DiagnosticBag bag,
    bool succeeded)
{
    stack mut SourceFileMap emptySourceMap = new SourceFileMap();
    return AppendDiagnosticBagTextCore(writer, bag, emptySourceMap, false, succeeded);
}

public fn DiagnosticStatus AppendDiagnosticBagTextWithSourceMap(
    mut borrow OwnedAscii writer,
    mut borrow DiagnosticBag bag,
    mut borrow SourceFileMap sourceMap,
    bool succeeded)
{
    return AppendDiagnosticBagTextCore(writer, bag, sourceMap, true, succeeded);
}
