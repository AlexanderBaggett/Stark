import System.Collections
import System.Memory
import System.Text
module Compiler.TestRunner

// Stage1 port of the generated-test-runner source emission
// (docs/Self-host-Prep/30-test-progress-streaming.md §5.1). The emitted main
// block is a cross-stage contract: for the same entry plan it must be
// byte-identical to the stage0 generator's output
// (src/Compiler/StarkTestRunnerGenerator.cs BuildRunnerSource), including the
// `--progress` argv toggle and the per-entry BeginFact/RunFactCounted calls.
// Attribute discovery, filtering, and display-name escaping stay with the
// future full `stark test` port: plan text (names, call expressions, skip
// reasons) is emitted verbatim, so the caller owns string-literal escaping
// exactly as stage0 escapes at metadata-collection time.

public struct TestRunnerEntryPlan
{
    internal System.Text.OwnedAscii DisplayName;
    internal System.Text.OwnedAscii CallExpression;
    // Length 0 means "not skipped" / "no member-data row".
    internal System.Text.OwnedAscii SkipReason;
    internal System.Text.OwnedAscii MemberDataLocalName;
    internal System.Text.OwnedAscii MemberDataRowTypeName;
    internal System.Text.OwnedAscii MemberDataProviderName;
    internal u32[0 max] MemberDataRowIndex;
    internal dynamic u32[0 max] CollectionIndexes;
    // 0 means "no primary collection"; otherwise collection index + 1.
    internal u32[0 max] PrimaryCollectionPlusOne;

    TestRunnerEntryPlan()
    {
        self.DisplayName = new();
        self.CallExpression = new();
        self.SkipReason = new();
        self.MemberDataLocalName = new();
        self.MemberDataRowTypeName = new();
        self.MemberDataProviderName = new();
        self.MemberDataRowIndex = 0;
        self.CollectionIndexes = new();
        self.PrimaryCollectionPlusOne = 0;
    }

    public fn System.Memory.MemoryStatus SetNames(
        mut borrow TestRunnerEntryPlan self,
        ascii displayName,
        ascii callExpression)
    {
        try self.DisplayName.AppendAscii(displayName);
        try self.CallExpression.AppendAscii(callExpression);
        return System.Memory.MemoryStatus.Ok;
    }

    public fn System.Memory.MemoryStatus SetSkipReason(
        mut borrow TestRunnerEntryPlan self,
        ascii reason)
    {
        try self.SkipReason.AppendAscii(reason);
        return System.Memory.MemoryStatus.Ok;
    }

    public fn System.Memory.MemoryStatus SetMemberDataRow(
        mut borrow TestRunnerEntryPlan self,
        ascii localName,
        ascii rowTypeName,
        ascii providerName,
        u32[0 max] rowIndex)
    {
        try self.MemberDataLocalName.AppendAscii(localName);
        try self.MemberDataRowTypeName.AppendAscii(rowTypeName);
        try self.MemberDataProviderName.AppendAscii(providerName);
        self.MemberDataRowIndex = rowIndex;
        return System.Memory.MemoryStatus.Ok;
    }

    public fn bool AddCollectionIndex(
        mut borrow TestRunnerEntryPlan self,
        u32[0 max] collectionIndex,
        bool primary)
    {
        if (!self.CollectionIndexes.TryReserve(1))
        {
            return false;
        }

        init self.CollectionIndexes[self.CollectionIndexes.Length] = collectionIndex;
        if (primary)
        {
            self.PrimaryCollectionPlusOne = collectionIndex + 1;
        }

        return true;
    }
}

public struct TestRunnerPlan
{
    internal List<System.Text.OwnedAscii> CollectionNames;
    internal List<TestRunnerEntryPlan> Entries;

    TestRunnerPlan()
    {
        self.CollectionNames = new();
        self.Entries = new();
    }

    public fn System.Memory.MemoryStatus AddCollectionName(
        mut borrow TestRunnerPlan self,
        ascii name)
    {
        stack mut System.Text.OwnedAscii owned = new();
        try owned.AppendAscii(name);
        return self.CollectionNames.Push(owned);
    }

    public fn System.Memory.MemoryStatus PushEntry(
        mut borrow TestRunnerPlan self,
        TestRunnerEntryPlan entry)
    {
        return self.Entries.Push(entry);
    }
}

// Emits the generated runner's `main` block for the plan, starting at the
// `// Generated by stark test ...` comment. The caller has already written
// the (import-ensured) test source plus the separating blank line, matching
// stage0's BuildRunnerSource framing.
public fn System.Memory.MemoryStatus AppendGeneratedRunnerMain(
    borrow TestRunnerPlan plan,
    mut borrow OwnedAscii writer)
{
    stack System.Text.OwnedAscii[] collectionNames = plan.CollectionNames.AsSlice();
    stack TestRunnerEntryPlan[] entries = plan.Entries.AsSlice();
    stack bool emitCollectionFilter = collectionNames.Length > 0;

    try writer.AppendAscii("// Generated by stark test from [Fact] / [Theory] metadata.\n");
    try writer.AppendAscii("export fn i32[min max] main()\n");
    try writer.AppendAscii("{\n");
    try writer.AppendAscii("    stack mut u8[0 1] failed = 0;\n");
    try writer.AppendAscii("    stack mut bool progress = false;\n");

    if (!emitCollectionFilter)
    {
        try writer.AppendAscii("    stack u64[0 2 ** 63 - 1] progressArgumentCount = System.Testing.CollectionArgumentCount();\n");
        try writer.AppendAscii("    for willexit (stack mut u64[0 2 ** 63 - 1] progressArgumentIndex = 1; progressArgumentIndex < progressArgumentCount; progressArgumentIndex += 1)\n");
        try writer.AppendAscii("    {\n");
        try writer.AppendAscii("        if (System.Testing.CollectionArgumentEquals(progressArgumentIndex, \"--progress\"))\n");
        try writer.AppendAscii("        {\n");
        try writer.AppendAscii("            progress = true;\n");
        try writer.AppendAscii("        }\n");
        try writer.AppendAscii("    }\n");
        try writer.AppendAscii("\n");
    }

    if (emitCollectionFilter)
    {
        try writer.AppendAscii("    stack mut bool anyFilter = false;\n");
        try writer.AppendAscii("    stack mut bool listOnly = false;\n");
        try writer.AppendAscii("    stack mut bool anyExecuted = false;\n");
        stack mut u64[0 2 ** 63 - 1] nameIndex = 0;
        while willexit (nameIndex < collectionNames.Length)
        {
            try writer.AppendAscii("    stack mut bool select_");
            try writer.AppendI64((i64[min max])nameIndex);
            try writer.AppendAscii(" = false;\n");
            nameIndex += 1;
        }

        try writer.AppendAscii("    stack u64[0 2 ** 63 - 1] collectionArgumentCount = System.Testing.CollectionArgumentCount();\n");
        try writer.AppendAscii("    for willexit (stack mut u64[0 2 ** 63 - 1] argumentIndex = 1; argumentIndex < collectionArgumentCount; argumentIndex += 1)\n");
        try writer.AppendAscii("    {\n");
        try writer.AppendAscii("        if (System.Testing.CollectionArgumentEquals(argumentIndex, \"--list-collections\"))\n");
        try writer.AppendAscii("        {\n");
        try writer.AppendAscii("            listOnly = true;\n");
        try writer.AppendAscii("            continue;\n");
        try writer.AppendAscii("        }\n");
        try writer.AppendAscii("\n");
        try writer.AppendAscii("        if (System.Testing.CollectionArgumentEquals(argumentIndex, \"--progress\"))\n");
        try writer.AppendAscii("        {\n");
        try writer.AppendAscii("            progress = true;\n");
        try writer.AppendAscii("            continue;\n");
        try writer.AppendAscii("        }\n");
        try writer.AppendAscii("\n");
        nameIndex = 0;
        while willexit (nameIndex < collectionNames.Length)
        {
            try writer.AppendAscii("        if (System.Testing.CollectionArgumentEquals(argumentIndex, \"");
            try writer.AppendAscii(collectionNames[nameIndex].View());
            try writer.AppendAscii("\"))\n");
            try writer.AppendAscii("        {\n");
            try writer.AppendAscii("            anyFilter = true;\n");
            try writer.AppendAscii("            select_");
            try writer.AppendI64((i64[min max])nameIndex);
            try writer.AppendAscii(" = true;\n");
            try writer.AppendAscii("            continue;\n");
            try writer.AppendAscii("        }\n");
            try writer.AppendAscii("\n");
            nameIndex += 1;
        }

        try writer.AppendAscii("        System.Testing.ReportUnknownCollection();\n");
        nameIndex = 0;
        while willexit (nameIndex < collectionNames.Length)
        {
            try writer.AppendAscii("        System.Testing.ReportKnownCollection(\"");
            try writer.AppendAscii(collectionNames[nameIndex].View());
            try writer.AppendAscii("\");\n");
            nameIndex += 1;
        }

        try writer.AppendAscii("        return System.Testing.ExitCode(1);\n");
        try writer.AppendAscii("    }\n");
        try writer.AppendAscii("\n");
        try writer.AppendAscii("    if (listOnly)\n");
        try writer.AppendAscii("    {\n");
        nameIndex = 0;
        while willexit (nameIndex < collectionNames.Length)
        {
            try writer.AppendAscii("        System.Testing.ReportKnownCollection(\"");
            try writer.AppendAscii(collectionNames[nameIndex].View());
            try writer.AppendAscii("\");\n");
            nameIndex += 1;
        }

        try writer.AppendAscii("        return System.Testing.ExitCode(0);\n");
        try writer.AppendAscii("    }\n");
        try writer.AppendAscii("\n");
    }

    stack u64[0 2 ** 63 - 1] entryTotal = entries.Length;
    stack mut u32[0 max] currentPrimaryPlusOne = 0;
    stack mut u64[0 2 ** 63 - 1] entryIndex = 0;
    while willexit (entryIndex < entries.Length)
    {
        stack u64[0 2 ** 63 - 1] entryOrdinal = entryIndex + 1;
        if (emitCollectionFilter)
        {
            try writer.AppendAscii("    if (!anyFilter");
            stack mut u64[0 2 ** 63 - 1] gateIndex = 0;
            while willexit (gateIndex < entries[entryIndex].CollectionIndexes.Length)
            {
                try writer.AppendAscii(" || select_");
                try writer.AppendI64((i64[min max])entries[entryIndex].CollectionIndexes[gateIndex]);
                gateIndex += 1;
            }

            try writer.AppendAscii(")\n");
            try writer.AppendAscii("    {\n");
            try writer.AppendAscii("    anyExecuted = true;\n");
        }

        if (currentPrimaryPlusOne != entries[entryIndex].PrimaryCollectionPlusOne)
        {
            currentPrimaryPlusOne = entries[entryIndex].PrimaryCollectionPlusOne;
            if (currentPrimaryPlusOne != 0)
            {
                try writer.AppendAscii("    // Test collection: ");
                try writer.AppendAscii(collectionNames[(u64[0 2 ** 63 - 1])(currentPrimaryPlusOne - 1)].View());
                try writer.AppendAscii("\n");
            }
        }

        if (entries[entryIndex].SkipReason.Length() > 0)
        {
            try writer.AppendAscii("    System.Testing.SkipFact(\"");
            try writer.AppendAscii(entries[entryIndex].DisplayName.View());
            try writer.AppendAscii("\", \"");
            try writer.AppendAscii(entries[entryIndex].SkipReason.View());
            try writer.AppendAscii("\");\n");
            if (emitCollectionFilter)
            {
                try writer.AppendAscii("    }\n");
            }

            try writer.AppendAscii("\n");
            entryIndex += 1;
            continue;
        }

        if (entries[entryIndex].MemberDataLocalName.Length() > 0)
        {
            try writer.AppendAscii("    stack ");
            try writer.AppendAscii(entries[entryIndex].MemberDataRowTypeName.View());
            try writer.AppendAscii(" ");
            try writer.AppendAscii(entries[entryIndex].MemberDataLocalName.View());
            try writer.AppendAscii(" = ");
            try writer.AppendAscii(entries[entryIndex].MemberDataProviderName.View());
            try writer.AppendAscii("(");
            try writer.AppendI64((i64[min max])entries[entryIndex].MemberDataRowIndex);
            try writer.AppendAscii(");\n");
        }

        try writer.AppendAscii("    System.Testing.BeginFact(progress, \"");
        try writer.AppendAscii(entries[entryIndex].DisplayName.View());
        try writer.AppendAscii("\");\n");
        try writer.AppendAscii("    if (System.Testing.RunFactCounted(progress, ");
        try writer.AppendI64((i64[min max])entryOrdinal);
        try writer.AppendAscii(", ");
        try writer.AppendI64((i64[min max])entryTotal);
        try writer.AppendAscii(", \"");
        try writer.AppendAscii(entries[entryIndex].DisplayName.View());
        try writer.AppendAscii("\", ");
        try writer.AppendAscii(entries[entryIndex].CallExpression.View());
        try writer.AppendAscii(") != 0)\n");
        try writer.AppendAscii("    {\n");
        try writer.AppendAscii("        failed = 1;\n");
        try writer.AppendAscii("    }\n");
        if (emitCollectionFilter)
        {
            try writer.AppendAscii("    }\n");
        }

        try writer.AppendAscii("\n");
        entryIndex += 1;
    }

    if (emitCollectionFilter)
    {
        try writer.AppendAscii("    if (anyFilter && !anyExecuted)\n");
        try writer.AppendAscii("    {\n");
        try writer.AppendAscii("        System.Testing.ReportNoFactsSelected();\n");
        try writer.AppendAscii("        return System.Testing.ExitCode(1);\n");
        try writer.AppendAscii("    }\n");
        try writer.AppendAscii("\n");
    }

    try writer.AppendAscii("    return System.Testing.ExitCode(failed);\n");
    try writer.AppendAscii("}\n");
    return System.Memory.MemoryStatus.Ok;
}
