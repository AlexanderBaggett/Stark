{
    if (llvmModule.Ref == null || functionType.Ref == null)
    {
        return LlvmResult<LlvmValue>.Err(LlvmError.NullHandle);
    }

    unsafe
    {
        stack rawmutptr<System.C.c_void> raw = LLVMAddFunction(
            llvmModule.Ref,
            name.Data(),
            functionType.Ref);
        if (raw == null)
        {
            return LlvmResult<LlvmValue>.Err(LlvmError.NullHandle);
        }

        return LlvmResult<LlvmValue>.Ok(new LlvmValue()
        {
            Ref = raw
        });
    }
}

public fn LlvmResult<u32[0 max]> FunctionParameterCount(LlvmValue function)
{
    if (function.Ref == null)
    {
        return LlvmResult<u32[0 max]>.Err(LlvmError.NullHandle);
    }

    unsafe
    {
        stack System.C.c_uint raw = LLVMCountParams(function.Ref);
        return LlvmResult<u32[0 max]>.Ok((u32[0 max])raw);
    }
}

public fn LlvmResult<LlvmValue> GetParameter(LlvmValue function, u32[0 max] index)
{
    if (function.Ref == null)
    {
        return LlvmResult<LlvmValue>.Err(LlvmError.NullHandle);
    }

    unsafe
    {
        stack u32[0 max] parameterCount = (u32[0 max])LLVMCountParams(function.Ref);
        if (!LlvmParameterIndexIsInRange(index, parameterCount))
        {
            return LlvmResult<LlvmValue>.Err(LlvmError.OperationFailed);
        }

        stack System.C.c_uint rawIndex = index;
        stack rawmutptr<System.C.c_void> raw = LLVMGetParam(function.Ref, rawIndex);
        if (raw == null)
        {
            return LlvmResult<LlvmValue>.Err(LlvmError.NullHandle);
        }

        return LlvmResult<LlvmValue>.Ok(new LlvmValue()
        {
            Ref = raw
        });
    }
}

