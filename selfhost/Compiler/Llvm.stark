public fn LlvmResult<LlvmType> FunctionTypeNoParams(LlvmType returnType, bool isVarArg)
{
    if (returnType.Ref == null)
    {
        return LlvmResult<LlvmType>.Err(LlvmError.NullHandle);
    }

    unsafe
    {
        stack System.C.c_uint parameterCount = 0;
        stack rawmutptr<System.C.c_void> raw = LLVMFunctionType(
            returnType.Ref,
            null,
            parameterCount,
            LlvmBoolValue(isVarArg));
        if (raw == null)
        {
            return LlvmResult<LlvmType>.Err(LlvmError.NullHandle);
        }

        return LlvmResult<LlvmType>.Ok(new LlvmType()
        {
            Ref = raw
        });
    }
}

public fn LlvmResult<LlvmType> FunctionType(
    LlvmType returnType,
    mut borrow LlvmTypeRefBuffer parameterTypes,
    bool isVarArg)
{
    if (returnType.Ref == null)
    {
        return LlvmResult<LlvmType>.Err(LlvmError.NullHandle);
    }

    if (parameterTypes.Items.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return LlvmResult<LlvmType>.Err(LlvmError.OperationFailed);
    }

    unsafe
    {
        stack System.C.c_uint parameterCount = (u32[0 max])parameterTypes.Items.Length;
        stack mut rawmutptr<System.C.c_void> raw = null;
        if (parameterTypes.Items.Length == 0)
        {
            raw = LLVMFunctionType(
                returnType.Ref,
                null,
                parameterCount,
                LlvmBoolValue(isVarArg));
        }
        else
        {
            raw = LLVMFunctionType(
                returnType.Ref,
                &parameterTypes.Items[0],
                parameterCount,
                LlvmBoolValue(isVarArg));
        }

        if (raw == null)
        {
            return LlvmResult<LlvmType>.Err(LlvmError.NullHandle);
        }

        return LlvmResult<LlvmType>.Ok(new LlvmType()
        {
            Ref = raw
        });
    }
}

