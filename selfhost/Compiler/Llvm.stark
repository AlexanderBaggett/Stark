public fn LlvmResult<LlvmValue> BuildGep(
    mut borrow LlvmBuilder builder,
    LlvmType elementType,
    LlvmValue pointer,
    mut borrow LlvmValueRefBuffer indices,
    borrow System.C.CStr name)
{
    if (builder.Ref == null || elementType.Ref == null || pointer.Ref == null)
    {
        return LlvmResult<LlvmValue>.Err(LlvmError.NullHandle);
    }

    if (indices.Items.Length > (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
    {
        return LlvmResult<LlvmValue>.Err(LlvmError.OperationFailed);
    }

    unsafe
    {
        stack System.C.c_uint indexCount = (u32[0 max])indices.Items.Length;
        stack mut rawmutptr<System.C.c_void> raw = null;
        if (indices.Items.Length == 0)
        {
            raw = LLVMBuildGEP2(builder.Ref, elementType.Ref, pointer.Ref, null, indexCount, name.Data());
        }
        else
        {
            raw = LLVMBuildGEP2(builder.Ref, elementType.Ref, pointer.Ref, &indices.Items[0], indexCount, name.Data());
        }

        if (raw == null)
        {
            return LlvmResult<LlvmValue>.Err(LlvmError.NullHandle);
        }

        return LlvmResult<LlvmValue>.Ok(new LlvmValue()
        {
            Ref = raw
        });
    }
}

