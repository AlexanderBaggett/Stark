    return LlvmStatus.Ok;
}

public fn LlvmResult<LlvmMetadata> MdString(
    borrow LlvmContext context,
    borrow System.C.CStr text)
{
    if (context.Ref == null)
    {
        return LlvmResult<LlvmMetadata>.Err(LlvmError.NullHandle);
    }

    unsafe
    {
        stack System.C.c_size_t rawLength = text.Length();
        stack rawmutptr<System.C.c_void> raw = LLVMMDStringInContext2(context.Ref, text.Data(), rawLength);
        if (raw == null)
        {
            return LlvmResult<LlvmMetadata>.Err(LlvmError.NullHandle);
        }

        return LlvmResult<LlvmMetadata>.Ok(new LlvmMetadata()
