public fn LlvmStatus AddIncoming(
    LlvmValue phi,
    mut borrow LlvmValueRefBuffer values,
    mut borrow LlvmBasicBlockRefBuffer blocks)
{
    if (phi.Ref == null)
    {
        return LlvmStatus.Err(LlvmError.NullHandle);
    }

    if (!LlvmPhiIncomingCountsMatch(values.Items.Length, blocks.Items.Length))
    {
        return LlvmStatus.Err(LlvmError.OperationFailed);
    }

    if (values.Items.Length == 0)
    {
        return LlvmStatus.Ok;
    }

    unsafe
    {
        stack System.C.c_uint incomingCount = (u32[0 max])values.Items.Length;
        LLVMAddIncoming(phi.Ref, &values.Items[0], &blocks.Items[0], incomingCount);
    }

    return LlvmStatus.Ok;
}

