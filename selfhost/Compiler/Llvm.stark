    }

    unsafe
    {
        stack System.C.c_size_t operandCount = operands.Items.Length;
        stack mut rawmutptr<System.C.c_void> raw = null;
        if (operands.Items.Length == 0)
        {
            raw = LLVMMDNodeInContext2(context.Ref, null, operandCount);
        }
        else
        {
            raw = LLVMMDNodeInContext2(context.Ref, &operands.Items[0], operandCount);
        }

        if (raw == null)
        {
            return LlvmResult<LlvmMetadata>.Err(LlvmError.NullHandle);
        }

        return LlvmResult<LlvmMetadata>.Ok(new LlvmMetadata()
        {
            Ref = raw
