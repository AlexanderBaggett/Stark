public struct LlvmContext
{
    internal rawmutptr<System.C.c_void> Ref;

    LlvmContext()
    {
        self.Ref = null;
    }

    static fn LlvmResult<LlvmContext> Create()
    {
        unsafe
        {
            stack rawmutptr<System.C.c_void> raw = LLVMContextCreate();
            if (raw == null)
            {
                return LlvmResult<LlvmContext>.Err(LlvmError.NullHandle);
            }

            return LlvmResult<LlvmContext>.Ok(new LlvmContext()
            {
                Ref = raw
            });
        }
    }

    inline finite law bool IsNull(borrow LlvmContext self)
    {
        return self.Ref == null;
    }

    mut drop
    {
        unsafe
        {
            if (self.Ref != null)
            {
                LLVMContextDispose(self.Ref);
                self.Ref = null;
            }
        }
    }
}

public struct LlvmModule
{
    internal rawmutptr<System.C.c_void> Ref;

    LlvmModule()
    {
        self.Ref = null;
    }

    static fn LlvmResult<LlvmModule> Create(borrow LlvmContext context, borrow System.C.CStr name)
    {
        if (context.Ref == null)
        {
            return LlvmResult<LlvmModule>.Err(LlvmError.NullHandle);
        }

        unsafe
        {
            stack rawmutptr<System.C.c_void> raw = LLVMModuleCreateWithNameInContext(name.Data(), context.Ref);
            if (raw == null)
            {
                return LlvmResult<LlvmModule>.Err(LlvmError.NullHandle);
            }

            return LlvmResult<LlvmModule>.Ok(new LlvmModule()
            {
                Ref = raw
            });
        }
    }

    inline finite law bool IsNull(borrow LlvmModule self)
    {
        return self.Ref == null;
    }

    mut drop
    {
        unsafe
        {
            if (self.Ref != null)
            {
                LLVMDisposeModule(self.Ref);
                self.Ref = null;
            }
        }
    }
}

