public fn LlvmResult<LlvmMemoryBuffer> EmitObjectToMemoryBuffer(
    mut borrow LlvmTargetMachine targetMachine,
    mut borrow LlvmModule llvmModule)
{
    if (targetMachine.Ref == null || llvmModule.Ref == null)
    {
        return LlvmResult<LlvmMemoryBuffer>.Err(LlvmError.NullHandle);
    }

    unsafe
    {
        stack mut System.C.ForeignOwnedCStrOut message = new();
        stack mut LlvmMemoryBufferRefOut buffer = new();
        stack i32[min max] failed = LLVMTargetMachineEmitToMemoryBuffer(
            targetMachine.Ref,
            llvmModule.Ref,
            LlvmCodeGenFileTypeValue(LlvmCodeGenFileType.Object),
            message.OutPointer(),
            buffer.OutPointer());
        if (failed == 0)
        {
            System.C.DisposeForeignOwnedOut(message, LLVMDisposeMessage);
            return LlvmResult<LlvmMemoryBuffer>.Ok(buffer.Take());
        }

        if (!message.HasValue())
        {
            return LlvmResult<LlvmMemoryBuffer>.Err(LlvmError.OperationFailed);
        }

        stack System.C.CStringResult<System.Text.OwnedAscii> copied =
            System.C.CopyForeignOwnedOutAsciiAndDispose(message, LLVMDisposeMessage, LlvmOwnedMessageMaxBytes);
        switch (copied)
        {
            case System.C.CStringResult<System.Text.OwnedAscii>.Err(var error):
                return LlvmResult<LlvmMemoryBuffer>.Err(LlvmError.CString(error));
            case System.C.CStringResult<System.Text.OwnedAscii>.Ok(var value):
                return LlvmResult<LlvmMemoryBuffer>.Err(LlvmError.Diagnostic(value));
        }
    }
}

public fn LlvmResult<System.Text.OwnedAscii> PrintModuleToAscii(mut borrow LlvmModule llvmModule)
{
    if (llvmModule.Ref == null)
    {
        return LlvmResult<System.Text.OwnedAscii>.Err(LlvmError.NullHandle);
    }

    unsafe
    {
        stack System.C.CStringResult<System.C.ForeignOwnedCStr> raw =
            System.C.TryFromForeignOwnedRaw(LLVMPrintModuleToString(llvmModule.Ref));
        switch (raw)
        {
            case System.C.CStringResult<System.C.ForeignOwnedCStr>.Err(var error):
                return LlvmResult<System.Text.OwnedAscii>.Err(LlvmError.CString(error));
            case System.C.CStringResult<System.C.ForeignOwnedCStr>.Ok(var text):
                stack mut System.C.ForeignOwnedCStr message = text;
                stack System.C.CStringResult<System.Text.OwnedAscii> copied =
                    System.C.CopyForeignOwnedAsciiAndDispose(message, LLVMDisposeMessage, LlvmOwnedMessageMaxBytes);
                switch (copied)
                {
                    case System.C.CStringResult<System.Text.OwnedAscii>.Err(var copyError):
                        return LlvmResult<System.Text.OwnedAscii>.Err(LlvmError.CString(copyError));
                    case System.C.CStringResult<System.Text.OwnedAscii>.Ok(var value):
                        return LlvmResult<System.Text.OwnedAscii>.Ok(value);
                }
        }
    }
}

public fn LlvmResult<System.Text.OwnedAscii> VerifyModule(mut borrow LlvmModule llvmModule, LlvmVerifierFailureAction action)
{
    if (llvmModule.Ref == null)
    {
        return LlvmResult<System.Text.OwnedAscii>.Err(LlvmError.NullHandle);
    }

    unsafe
    {
        stack mut System.C.ForeignOwnedCStrOut message = new();
        stack i32[min max] failed = LLVMVerifyModule(
            llvmModule.Ref,
            LlvmVerifierFailureActionValue(action),
            message.OutPointer());
        if (failed == 0)
        {
            System.C.DisposeForeignOwnedOut(message, LLVMDisposeMessage);
            return LlvmResult<System.Text.OwnedAscii>.Ok(new System.Text.OwnedAscii());
        }

        stack System.C.CStringResult<System.Text.OwnedAscii> copied =
            System.C.CopyForeignOwnedOutAsciiAndDispose(message, LLVMDisposeMessage, LlvmOwnedMessageMaxBytes);
        switch (copied)
        {
            case System.C.CStringResult<System.Text.OwnedAscii>.Err(var error):
                return LlvmResult<System.Text.OwnedAscii>.Err(LlvmError.CString(error));
            case System.C.CStringResult<System.Text.OwnedAscii>.Ok(var value):
                return LlvmResult<System.Text.OwnedAscii>.Ok(value);
        }
    }
}

