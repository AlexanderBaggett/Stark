    unsafe inline finite law rawmutptr<LlvmMemoryBufferRefOut> OutPointer(mut borrow LlvmMemoryBufferRefOut self)
    {
        return (rawmutptr<LlvmMemoryBufferRefOut>)(&self);
    }

    unsafe fn LlvmMemoryBuffer Take(mut borrow LlvmMemoryBufferRefOut self)
    {
        stack rawmutptr<System.C.c_void> raw = self.Ref;
        self.Ref = null;
        return new LlvmMemoryBuffer()
        {
            Ref = raw
        };
    }
}

public finite law LlvmVersion LlvmPinnedVersion()
{
    return new LlvmVersion()
    {
        Major = LlvmPinnedMajor,
        Minor = LlvmPinnedMinor,
        Patch = LlvmPinnedPatch
    };
}

public finite law bool LlvmVersionSupported(LlvmVersion version)
{
    return version.Major == LlvmPinnedMajor
        && version.Minor == LlvmPinnedMinor
        && version.Patch == LlvmPinnedPatch;
}

public fn LlvmResult<LlvmVersion> GetLinkedLlvmVersion()
{
    unsafe
    {
        stack mut System.C.c_uint major = 0;
        stack mut System.C.c_uint minor = 0;
        stack mut System.C.c_uint patch = 0;
        LLVMGetVersion(&major, &minor, &patch);
        return LlvmResult<LlvmVersion>.Ok(new LlvmVersion()
        {
            Major = (u32[0 max])major,
            Minor = (u32[0 max])minor,
            Patch = (u32[0 max])patch
        });
    }
}

public fn LlvmResult<LlvmVersion> ValidateLinkedLlvmVersion()
{
    stack LlvmResult<LlvmVersion> result = GetLinkedLlvmVersion();
    switch (result)
    {
        case LlvmResult<LlvmVersion>.Err(var error):
            return LlvmResult<LlvmVersion>.Err(error);
        case LlvmResult<LlvmVersion>.Ok(var version):
            if (!LlvmVersionSupported(version))
            {
                return LlvmResult<LlvmVersion>.Err(LlvmError.VersionMismatch);
            }

            return LlvmResult<LlvmVersion>.Ok(version);
    }
}

public finite law i32[min max] LlvmBoolValue(bool value)
{
    if (value)
    {
        return 1;
    }

    return 0;
}

public finite law i32[min max] LlvmVerifierFailureActionValue(LlvmVerifierFailureAction action)
{
    switch (action)
    {
        case LlvmVerifierFailureAction.AbortProcess:
            return 0;
        case LlvmVerifierFailureAction.PrintMessage:
            return 1;
        case LlvmVerifierFailureAction.ReturnStatus:
            return 2;
    }
}

public finite law i32[min max] LlvmCodeGenOptLevelValue(LlvmCodeGenOptLevel level)
{
    switch (level)
    {
        case LlvmCodeGenOptLevel.None:
            return 0;
        case LlvmCodeGenOptLevel.Less:
            return 1;
        case LlvmCodeGenOptLevel.Default:
            return 2;
        case LlvmCodeGenOptLevel.Aggressive:
            return 3;
    }
}

public finite law i32[min max] LlvmRelocModeValue(LlvmRelocMode mode)
{
    switch (mode)
    {
        case LlvmRelocMode.Default:
            return 0;
        case LlvmRelocMode.Static:
            return 1;
        case LlvmRelocMode.PIC:
            return 2;
        case LlvmRelocMode.DynamicNoPIC:
            return 3;
        case LlvmRelocMode.ROPI:
            return 4;
        case LlvmRelocMode.RWPI:
            return 5;
        case LlvmRelocMode.ROPIRWPI:
            return 6;
    }
}

public finite law i32[min max] LlvmCodeModelValue(LlvmCodeModel model)
{
    switch (model)
    {
        case LlvmCodeModel.Default:
            return 0;
        case LlvmCodeModel.JITDefault:
            return 1;
        case LlvmCodeModel.Tiny:
            return 2;
        case LlvmCodeModel.Small:
            return 3;
        case LlvmCodeModel.Kernel:
            return 4;
        case LlvmCodeModel.Medium:
            return 5;
        case LlvmCodeModel.Large:
            return 6;
    }
}

public finite law i32[min max] LlvmCodeGenFileTypeValue(LlvmCodeGenFileType fileType)
{
    switch (fileType)
    {
        case LlvmCodeGenFileType.Assembly:
            return 0;
        case LlvmCodeGenFileType.Object:
            return 1;
    }
}

public finite law i32[min max] LlvmLinkageValue(LlvmLinkage linkage)
{
    switch (linkage)
    {
        case LlvmLinkage.External:
            return 0;
        case LlvmLinkage.AvailableExternally:
            return 1;
        case LlvmLinkage.LinkOnceAny:
            return 2;
        case LlvmLinkage.LinkOnceOdr:
            return 3;
        case LlvmLinkage.LinkOnceOdrAutoHide:
            return 4;
        case LlvmLinkage.WeakAny:
            return 5;
        case LlvmLinkage.WeakOdr:
            return 6;
        case LlvmLinkage.Appending:
            return 7;
        case LlvmLinkage.Internal:
            return 8;
        case LlvmLinkage.Private:
            return 9;
        case LlvmLinkage.DllImport:
            return 10;
        case LlvmLinkage.DllExport:
            return 11;
        case LlvmLinkage.ExternalWeak:
            return 12;
        case LlvmLinkage.Ghost:
            return 13;
        case LlvmLinkage.Common:
            return 14;
        case LlvmLinkage.LinkerPrivate:
            return 15;
        case LlvmLinkage.LinkerPrivateWeak:
            return 16;
    }
}

public finite law i32[min max] LlvmVisibilityValue(LlvmVisibility visibility)
{
    switch (visibility)
    {
        case LlvmVisibility.Default:
            return 0;
        case LlvmVisibility.Hidden:
            return 1;
        case LlvmVisibility.Protected:
            return 2;
    }
}

public finite law i32[min max] LlvmDllStorageClassValue(LlvmDllStorageClass storageClass)
{
    switch (storageClass)
    {
        case LlvmDllStorageClass.Default:
            return 0;
        case LlvmDllStorageClass.DllImport:
            return 1;
        case LlvmDllStorageClass.DllExport:
            return 2;
    }
}

public finite law i32[min max] LlvmUnnamedAddressValue(LlvmUnnamedAddress unnamedAddress)
{
