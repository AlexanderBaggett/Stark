public struct LlvmMemoryBuffer
{
    internal rawmutptr<System.C.c_void> Ref;

    LlvmMemoryBuffer()
    {
        self.Ref = null;
    }

    inline finite law bool IsNull(borrow LlvmMemoryBuffer self)
    {
        return self.Ref == null;
    }

    unsafe inline fn rawptr<System.C.c_char> Data(borrow LlvmMemoryBuffer self)
    {
        if (self.Ref == null)
        {
            return null;
        }

        return LLVMGetBufferStart(self.Ref);
    }

    unsafe inline fn System.C.c_size_t ByteLength(borrow LlvmMemoryBuffer self)
    {
        if (self.Ref == null)
        {
            return 0;
        }

        return LLVMGetBufferSize(self.Ref);
    }

    mut drop
    {
        unsafe
        {
            if (self.Ref != null)
            {
                LLVMDisposeMemoryBuffer(self.Ref);
                self.Ref = null;
            }
        }
    }
}

public struct LlvmMessage
{
    internal System.C.ForeignOwnedCStr Text;

    LlvmMessage()
    {
        self.Text = new();
    }

    unsafe fn LlvmResult<System.Text.OwnedAscii> CopyAsciiAndDispose(mut borrow LlvmMessage self)
    {
        stack System.C.CStringResult<System.Text.OwnedAscii> copied =
            System.C.CopyForeignOwnedAsciiAndDispose(self.Text, LLVMDisposeMessage, LlvmOwnedMessageMaxBytes);
        switch (copied)
        {
            case System.C.CStringResult<System.Text.OwnedAscii>.Err(var error):
                return LlvmResult<System.Text.OwnedAscii>.Err(LlvmError.CString(error));
            case System.C.CStringResult<System.Text.OwnedAscii>.Ok(var value):
                return LlvmResult<System.Text.OwnedAscii>.Ok(value);
        }
    }

    drop
    {
        unsafe
        {
            System.C.DisposeForeignOwned(self.Text, LLVMDisposeMessage);
        }
    }
}

[Platform]
public struct LlvmTargetRefOut
{
    internal rawmutptr<System.C.c_void> Ref;

    LlvmTargetRefOut()
    {
        self.Ref = null;
    }

    inline finite law bool HasValue(borrow LlvmTargetRefOut self)
    {
        return self.Ref != null;
    }

    unsafe inline finite law rawmutptr<LlvmTargetRefOut> OutPointer(mut borrow LlvmTargetRefOut self)
    {
        return (rawmutptr<LlvmTargetRefOut>)(&self);
    }

    unsafe fn void SetRawUnchecked(mut borrow LlvmTargetRefOut self, rawmutptr<System.C.c_void> data)
        where overlap(self, data)
    {
        self.Ref = data;
        return;
    }

    unsafe fn LlvmTarget Take(mut borrow LlvmTargetRefOut self)
    {
        stack rawmutptr<System.C.c_void> raw = self.Ref;
        self.Ref = null;
        return new LlvmTarget()
        {
            Ref = raw
        };
    }
}

[Platform]
public struct LlvmMemoryBufferRefOut
{
    internal rawmutptr<System.C.c_void> Ref;

    LlvmMemoryBufferRefOut()
