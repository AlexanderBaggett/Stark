public struct LlvmTypeRefBuffer
{
    internal dynamic rawmutptr<System.C.c_void> Items;

    LlvmTypeRefBuffer()
    {
        self.Items = new();
    }

    inline finite law u64[0 2 ** 63 - 1] Count(borrow LlvmTypeRefBuffer self)
    {
        return self.Items.Length;
    }

    fn LlvmStatus Reserve(mut borrow LlvmTypeRefBuffer self, u64[0 2 ** 63 - 1] additional)
    {
        if (!self.Items.TryReserve(additional))
        {
            return LlvmStatus.Err(LlvmError.Memory(System.Memory.MemoryError.OutOfMemory));
        }

        return LlvmStatus.Ok;
    }

    fn LlvmStatus Add(mut borrow LlvmTypeRefBuffer self, LlvmType item)
    {
        if (item.Ref == null)
        {
            return LlvmStatus.Err(LlvmError.NullHandle);
        }

        if (!self.Items.TryReserve(1))
        {
            return LlvmStatus.Err(LlvmError.Memory(System.Memory.MemoryError.OutOfMemory));
        }

        init self.Items[self.Items.Length] = item.Ref;
        return LlvmStatus.Ok;
    }

    fn void Clear(mut borrow LlvmTypeRefBuffer self)
    {
        while willexit (self.Items.Length > 0)
        {
            unsafe
            {
                stack rawmutptr<System.C.c_void> discarded = self.Items.MoveLast();
            }
        }

        return;
    }
}

