        || System.Text.Equals(symbol, "LLVMBuildAnd")
        || System.Text.Equals(symbol, "LLVMBuildOr")
        || System.Text.Equals(symbol, "LLVMBuildXor")
        || System.Text.Equals(symbol, "LLVMBuildShl")
        || System.Text.Equals(symbol, "LLVMBuildLShr")
        || System.Text.Equals(symbol, "LLVMBuildAShr")
        || System.Text.Equals(symbol, "LLVMBuildICmp")
        || System.Text.Equals(symbol, "LLVMBuildSelect")
        || System.Text.Equals(symbol, "LLVMCreateTargetDataLayout")
        || System.Text.Equals(symbol, "LLVMCopyStringRepOfTargetData")
        || System.Text.Equals(symbol, "LLVMDisposeTargetData");
}

public finite law bool LlvmRequiredSymbolIndexKnown(u32[0 max] index)
{
    return index < LlvmRequiredSymbolCount()
        && !System.Text.Equals(LlvmRequiredSymbolAt(index), "");
}

