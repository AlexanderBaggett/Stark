import System.C
import System.Memory
import System.Text
module Compiler.Llvm

public const LlvmPinnedMajor = 22;
public const LlvmPinnedMinor = 1;
public const LlvmPinnedPatch = 8;
const LlvmOwnedMessageMaxBytes = 2 ** 20;

public enum LlvmError
{
    NullHandle,
    CString from System.C.CStringError,
    Diagnostic(System.Text.OwnedAscii),
    Memory from System.Memory.MemoryError,
    VersionMismatch,
    OperationFailed,
}

public enum LlvmResult<T>
{
    [Ok] Ok(T),
    [Err] Err(LlvmError),
}

public enum LlvmStatus
{
    [Ok] Ok,
    [Err] Err(LlvmError),
}

public struct LlvmVersion
{
    u32[0 max] Major;
    u32[0 max] Minor;
    u32[0 max] Patch;

    LlvmVersion()
    {
        self.Major = 0;
        self.Minor = 0;
        self.Patch = 0;
    }

    inline finite law bool Equals(borrow LlvmVersion self, LlvmVersion other)
    {
        return self.Major == other.Major
            && self.Minor == other.Minor
            && self.Patch == other.Patch;
    }
}

