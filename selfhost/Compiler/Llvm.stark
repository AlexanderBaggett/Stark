public struct LlvmTargetMachine
{
    internal rawmutptr<System.C.c_void> Ref;

    LlvmTargetMachine()
    {
        self.Ref = null;
    }

    static fn LlvmResult<LlvmTargetMachine> Create(
        borrow LlvmTarget target,
        borrow System.C.CStr triple,
        borrow System.C.CStr cpu,
        borrow System.C.CStr features,
        LlvmCodeGenOptLevel optLevel,
        LlvmRelocMode relocMode,
        LlvmCodeModel codeModel)
    {
        if (target.Ref == null)
        {
            return LlvmResult<LlvmTargetMachine>.Err(LlvmError.NullHandle);
        }

        unsafe
        {
            stack rawmutptr<System.C.c_void> raw = LLVMCreateTargetMachine(
                target.Ref,
                triple.Data(),
                cpu.Data(),
                features.Data(),
                LlvmCodeGenOptLevelValue(optLevel),
                LlvmRelocModeValue(relocMode),
                LlvmCodeModelValue(codeModel));
            if (raw == null)
            {
                return LlvmResult<LlvmTargetMachine>.Err(LlvmError.NullHandle);
            }

            return LlvmResult<LlvmTargetMachine>.Ok(new LlvmTargetMachine()
            {
                Ref = raw
            });
        }
    }

    inline finite law bool IsNull(borrow LlvmTargetMachine self)
    {
        return self.Ref == null;
    }

    mut drop
    {
        unsafe
        {
            if (self.Ref != null)
            {
                LLVMDisposeTargetMachine(self.Ref);
                self.Ref = null;
            }
        }
    }
}

