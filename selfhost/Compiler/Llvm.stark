public finite law u32[0 max] LlvmReturnAttributeIndex()
{
    return 0;
}

public finite law u32[0 max] LlvmFunctionAttributeIndex()
{
    return 2 ** 32 - 1;
}

public finite law bool LlvmParameterAttributeIndexIsValid(u32[0 max] parameterZeroBased)
{
    return parameterZeroBased < 2 ** 32 - 1;
}

public finite law u32[0 max] LlvmParameterAttributeIndex(u32[0 2 ** 32 - 2] parameterZeroBased)
{
    return parameterZeroBased + 1;
}

public finite law bool LlvmAlignmentBytesAreValid(u32[0 max] bytes)
{
    if (bytes == 0)
    {
        return false;
    }

    return (bytes & (bytes - 1)) == 0;
}

public finite law bool LlvmParameterIndexIsInRange(u32[0 max] index, u32[0 max] parameterCount)
{
    return index < parameterCount;
}

public finite law bool LlvmPhiIncomingCountsMatch(
    u64[0 2 ** 63 - 1] valueCount,
    u64[0 2 ** 63 - 1] blockCount)
{
    return valueCount == blockCount
        && valueCount <= (u64[0 2 ** 63 - 1])(2 ** 32 - 1);
}

public fn LlvmStatus InitializeNativeTargetSupport()
{
    unsafe
    {
        if (LLVMInitializeNativeTarget() != 0)
        {
            return LlvmStatus.Err(LlvmError.OperationFailed);
        }

        if (LLVMInitializeNativeAsmPrinter() != 0)
        {
            return LlvmStatus.Err(LlvmError.OperationFailed);
        }

        if (LLVMInitializeNativeAsmParser() != 0)
        {
            return LlvmStatus.Err(LlvmError.OperationFailed);
        }
    }

    return LlvmStatus.Ok;
}

public fn LlvmResult<System.Text.OwnedAscii> GetDefaultTargetTripleAscii()
{
    unsafe
    {
        stack System.C.CStringResult<System.C.ForeignOwnedCStr> raw =
            System.C.TryFromForeignOwnedRaw(LLVMGetDefaultTargetTriple());
        switch (raw)
        {
            case System.C.CStringResult<System.C.ForeignOwnedCStr>.Err(var error):
                return LlvmResult<System.Text.OwnedAscii>.Err(LlvmError.CString(error));
            case System.C.CStringResult<System.C.ForeignOwnedCStr>.Ok(var text):
                stack mut System.C.ForeignOwnedCStr message = text;
                stack System.C.CStringResult<System.Text.OwnedAscii> copied =
                    System.C.CopyForeignOwnedAsciiAndDispose(message, LLVMDisposeMessage, LlvmOwnedMessageMaxBytes);
                switch (copied)
                {
                    case System.C.CStringResult<System.Text.OwnedAscii>.Err(var copyError):
                        return LlvmResult<System.Text.OwnedAscii>.Err(LlvmError.CString(copyError));
                    case System.C.CStringResult<System.Text.OwnedAscii>.Ok(var value):
                        return LlvmResult<System.Text.OwnedAscii>.Ok(value);
                }
        }
    }
}

public fn LlvmResult<LlvmTarget> GetTargetFromTriple(borrow System.C.CStr triple)
{
    unsafe
    {
        stack mut LlvmTargetRefOut target = new();
        stack mut System.C.ForeignOwnedCStrOut message = new();
        stack i32[min max] failed =
            LLVMGetTargetFromTriple(triple.Data(), target.OutPointer(), message.OutPointer());
        if (failed == 0)
        {
            System.C.DisposeForeignOwnedOut(message, LLVMDisposeMessage);
            return LlvmResult<LlvmTarget>.Ok(target.Take());
        }

        if (!message.HasValue())
        {
            return LlvmResult<LlvmTarget>.Err(LlvmError.OperationFailed);
        }

        stack System.C.CStringResult<System.Text.OwnedAscii> copied =
            System.C.CopyForeignOwnedOutAsciiAndDispose(message, LLVMDisposeMessage, LlvmOwnedMessageMaxBytes);
        switch (copied)
        {
            case System.C.CStringResult<System.Text.OwnedAscii>.Err(var error):
                return LlvmResult<LlvmTarget>.Err(LlvmError.CString(error));
            case System.C.CStringResult<System.Text.OwnedAscii>.Ok(var value):
                return LlvmResult<LlvmTarget>.Err(LlvmError.Diagnostic(value));
        }
    }
}

