import System.Memory
import System.Text
import System.Text.Interning
module Compiler.Artifacts

public enum ArtifactError
{
    UnknownArtifactKind,
    MissingArtifact,
    ArtifactKeyMismatch,
    InvalidArtifactStorage,
    InvalidCatalog,
    Interner from System.Text.Interning.TextInternerError,
}

public enum ArtifactStatus
{
    [Ok] Ok,
    [Err] Err(ArtifactError),
}

public enum ArtifactResult<T>
{
    [Ok] Ok(T),
    [Err] Err(ArtifactError),
}

public enum CompilerArtifactKind
{
    Unknown,
    ParseResult,
    SyntaxModel,
    DeclarationIndex,
    ModuleGraph,
    SourceModuleParseCache,
    LoadedModules,
    SymbolCatalog,
    FunctionEffects,
    ClosedWorldOptimization,
    TypeCheckModel,
    InstantiationOwnership,
    MonomorphizationPlan,
    SpecializationPlan,
    SpecializationCodegenStrategy,
    EnumLayoutModel,
    SemanticValidation,
    OwnershipValidation,
    LoweringContractValidation,
    HighLevelIr,
    MidLevelIr,
    SsaIr,
    OptimizedSsaIr,
    SsaValueFacts,
    AbiModel,
    LlvmIrModule,
}

public inline finite law u32[0 max] CompilerArtifactKindCount()
{
    return 25;
}

public finite law u32[0 max] CompilerArtifactKindOrdinal(CompilerArtifactKind kind)
{
    switch (kind)
    {
        case CompilerArtifactKind.Unknown:
            return CompilerArtifactKindCount();
        case CompilerArtifactKind.ParseResult:
            return 0;
        case CompilerArtifactKind.SyntaxModel:
            return 1;
        case CompilerArtifactKind.DeclarationIndex:
            return 2;
        case CompilerArtifactKind.ModuleGraph:
            return 3;
        case CompilerArtifactKind.SourceModuleParseCache:
