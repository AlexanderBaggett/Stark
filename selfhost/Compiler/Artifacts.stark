{
    switch (ordinal)
    {
        case 0:
            return CompilerArtifactKind.ParseResult;
        case 1:
            return CompilerArtifactKind.SyntaxModel;
        case 2:
            return CompilerArtifactKind.DeclarationIndex;
        case 3:
            return CompilerArtifactKind.ModuleGraph;
        case 4:
            return CompilerArtifactKind.SourceModuleParseCache;
