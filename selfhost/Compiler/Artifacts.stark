            return 10;
        case CompilerArtifactKind.MonomorphizationPlan:
            return 11;
        case CompilerArtifactKind.SpecializationPlan:
            return 12;
        case CompilerArtifactKind.SpecializationCodegenStrategy:
            return 13;
        case CompilerArtifactKind.EnumLayoutModel:
            return 14;
        case CompilerArtifactKind.SemanticValidation:
            return 15;
        case CompilerArtifactKind.OwnershipValidation:
            return 16;
        case CompilerArtifactKind.LoweringContractValidation:
            return 17;
        case CompilerArtifactKind.HighLevelIr:
            return 18;
        case CompilerArtifactKind.MidLevelIr:
            return 19;
        case CompilerArtifactKind.SsaIr:
            return 20;
        case CompilerArtifactKind.OptimizedSsaIr:
            return 21;
        case CompilerArtifactKind.SsaValueFacts:
            return 22;
        case CompilerArtifactKind.AbiModel:
            return 23;
        case CompilerArtifactKind.LlvmIrModule:
            return 24;
    }
}

