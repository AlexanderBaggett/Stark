internal fn bool HighLevelIrLocalAliasTypeMatchesValue(
    HighLevelIrLocalAlias local,
    borrow IrTable<MirInstruction> instructions)
{
    if (!local.InitialValueValue.IsValid())
    {
        return false;
    }

    return MirValueType(instructions, local.InitialValueValue.Index()) == local.TypeValue;
}

