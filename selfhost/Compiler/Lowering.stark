        && HighLevelIrValueFactsFitType(tail.TypeValue, tail.FactsValue);
}

internal fn MirBuilderStatus HighLevelIrArgumentValueStatus(
    MirValueId argument,
    borrow MirFunctionBuilderState builder,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts)
{
    if (!argument.IsValid()
        || !instructions.Contains(argument.Index())
        || !MirFunctionBuilderOwnsValue(builder, argument)
        || !valueFacts.Contains(argument.Index()))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!HighLevelIrValueFactsFitType(
        MirValueType(instructions, argument.Index()),
        ValueFactsForMirValue(valueFacts, argument)))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    return MirBuilderStatus.Ok;
}

internal fn MirBuilderStatus HighLevelIrCallArgumentStatus(
    HighLevelIrCall call,
    borrow MirFunctionBuilderState builder,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts,
    u32[0 max] index)
{
    if (index >= call.ArgumentCountValue)
    {
        return MirBuilderStatus.Ok;
    }

    return HighLevelIrArgumentValueStatus(
        HighLevelIrCallArgumentAt(call, index),
        builder,
        instructions,
        valueFacts);
}

internal fn MirBuilderStatus HighLevelIrBecomeArgumentStatus(
    HighLevelIrBecome tail,
    borrow MirFunctionBuilderState builder,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts,
    u32[0 max] index)
{
    if (index >= tail.ArgumentCountValue)
    {
        return MirBuilderStatus.Ok;
    }

    return HighLevelIrArgumentValueStatus(
        HighLevelIrBecomeArgumentAt(tail, index),
        builder,
        instructions,
        valueFacts);
}

internal fn MirBuilderStatus ValidateHighLevelIrCallArguments(
    HighLevelIrCall call,
    borrow MirFunctionBuilderState builder,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts)
{
    if (call.ArgumentCountValue > 4)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    switch (HighLevelIrCallArgumentStatus(call, builder, instructions, valueFacts, 0))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    switch (HighLevelIrCallArgumentStatus(call, builder, instructions, valueFacts, 1))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    switch (HighLevelIrCallArgumentStatus(call, builder, instructions, valueFacts, 2))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    return HighLevelIrCallArgumentStatus(call, builder, instructions, valueFacts, 3);
}

internal fn MirBuilderStatus ValidateHighLevelIrBecomeArguments(
    HighLevelIrBecome tail,
    borrow MirFunctionBuilderState builder,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts)
{
    if (tail.ArgumentCountValue > 4)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    switch (HighLevelIrBecomeArgumentStatus(tail, builder, instructions, valueFacts, 0))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    switch (HighLevelIrBecomeArgumentStatus(tail, builder, instructions, valueFacts, 1))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    switch (HighLevelIrBecomeArgumentStatus(tail, builder, instructions, valueFacts, 2))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    return HighLevelIrBecomeArgumentStatus(tail, builder, instructions, valueFacts, 3);
}

