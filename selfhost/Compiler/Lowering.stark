public inline finite law u32[0 max] HighLevelIrArenaAllocationAlignmentBytes(
    borrow HighLevelIrArenaAllocation allocation)
{
    return allocation.AlignmentBytesValue;
}

internal finite law bool HighLevelIrPowerOfTwo(u32[0 max] value)
{
    if (value == 0)
    {
        return false;
    }

    stack mut u32[0 max] remaining = value;
    while willexit (remaining > 1)
    {
        if (remaining % 2 != 0)
        {
            return false;
        }

        remaining = remaining / 2;
    }

    return true;
}

internal finite law bool HighLevelIrArenaAllocationShapeIsLowerable(HighLevelIrArenaAllocation allocation)
{
    return allocation.SizeBytesValue != 0
        && HighLevelIrPowerOfTwo(allocation.AlignmentBytesValue);
}

