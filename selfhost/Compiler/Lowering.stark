public inline finite law MirLoweringPassShell DefaultMirLoweringPassShell()
{
    return new MirLoweringPassShell()
    {
        PassValue = CompilerPassId.LowerMir,
        PhaseValue = CompilerPhase.Lowering,
        ExecutionModeValue = PassExecutionMode.SkipOnErrors,
        InputArtifactValue = CompilerArtifactKind.HighLevelIr,
        OutputArtifactValue = CompilerArtifactKind.MidLevelIr,
        RequiredBackendFactsValue = RequiredMirLoweringBackendFacts()
    };
}

public inline finite law u8[0 6] MirLoweringRequiredArtifactCount()
{
    return 6;
}

public finite law CompilerArtifactKind MirLoweringRequiredArtifactAt(u8[0 max] index)
{
    switch (index)
    {
        case 0:
            return CompilerArtifactKind.LoadedModules;
        case 1:
            return CompilerArtifactKind.ModuleGraph;
        case 2:
            return CompilerArtifactKind.TypeCheckModel;
        case 3:
            return CompilerArtifactKind.EnumLayoutModel;
        case 4:
            return CompilerArtifactKind.HighLevelIr;
        case 5:
            return CompilerArtifactKind.OwnershipValidation;
        default:
            return CompilerArtifactKind.Unknown;
    }
}

public finite law bool MirLoweringRequiresArtifact(CompilerArtifactKind kind)
{
    stack mut u8[0 max] index = 0;
    while willexit (index < MirLoweringRequiredArtifactCount())
    {
        if (MirLoweringRequiredArtifactAt(index) == kind)
        {
            return true;
        }

        index += 1;
    }

    return false;
}

public fn ArtifactStatus AddMirLoweringRequiredArtifacts(mut borrow ArtifactDependencySet dependencies)
{
    stack mut u8[0 max] index = 0;
    while willexit (index < MirLoweringRequiredArtifactCount())
    {
        switch (AddRequiredArtifact(dependencies, MirLoweringRequiredArtifactAt(index)))
        {
            case ArtifactStatus.Err(var error):
                return ArtifactStatus.Err(error);
            case ArtifactStatus.Ok:
        }

        index += 1;
    }

    return ArtifactStatus.Ok;
}

public fn ArtifactResult<ArtifactDependencyReport> ValidateMirLoweringInputs(
    borrow ArtifactInventory inventory)
{
    stack mut ArtifactDependencySet dependencies = new();
    switch (AddMirLoweringRequiredArtifacts(dependencies))
    {
        case ArtifactStatus.Err(var error):
            return ArtifactResult<ArtifactDependencyReport>.Err(error);
        case ArtifactStatus.Ok:
    }

    return ValidateArtifactDependencies(inventory, dependencies);
}

public fn ArtifactResult<ArtifactDependencyReport> ValidateMirLoweringPassInputs(
    borrow MirLoweringPassShell shell,
    borrow ArtifactInventory inventory)
{
    if (shell.Pass() != CompilerPassId.LowerMir
        || shell.InputArtifact() != CompilerArtifactKind.HighLevelIr
        || shell.OutputArtifact() != CompilerArtifactKind.MidLevelIr)
    {
        return ArtifactResult<ArtifactDependencyReport>.Err(ArtifactError.UnknownArtifactKind);
    }

    return ValidateMirLoweringInputs(inventory);
}

public enum MirBuilderError
{
    OutOfMemory,
    InvalidSymbol,
    InvalidHandle,
    DuplicateSymbol,
    BuilderClosed,
    MissingEntryBlock,
    MissingBackendFacts,
    InvalidBuilderState,
    TableTooLarge,
    UnsupportedLiteral,
    UnsupportedValueType,
    TypeMismatch,
}

public enum MirBuilderStatus
{
    [Ok] Ok,
    [Err] Err(MirBuilderError),
}

public enum MirLoweringSymbolKind
{
    Unknown,
    Parameter,
    Local,
    Temporary,
    Global,
    Block,
    Function,
}

public finite law ascii MirBuilderErrorName(MirBuilderError error)
{
    switch (error)
    {
        case MirBuilderError.OutOfMemory:
            return "out-of-memory";
        case MirBuilderError.InvalidSymbol:
            return "invalid-symbol";
        case MirBuilderError.InvalidHandle:
            return "invalid-handle";
        case MirBuilderError.DuplicateSymbol:
            return "duplicate-symbol";
        case MirBuilderError.BuilderClosed:
            return "builder-closed";
        case MirBuilderError.MissingEntryBlock:
            return "missing-entry-block";
        case MirBuilderError.MissingBackendFacts:
            return "missing-backend-facts";
        case MirBuilderError.InvalidBuilderState:
            return "invalid-builder-state";
        case MirBuilderError.TableTooLarge:
            return "table-too-large";
        case MirBuilderError.UnsupportedLiteral:
            return "unsupported-literal";
        case MirBuilderError.UnsupportedValueType:
            return "unsupported-value-type";
        case MirBuilderError.TypeMismatch:
            return "type-mismatch";
    }
}

public finite law ascii MirLoweringSymbolKindName(MirLoweringSymbolKind kind)
{
    switch (kind)
    {
        case MirLoweringSymbolKind.Unknown:
            return "";
        case MirLoweringSymbolKind.Parameter:
            return "parameter";
        case MirLoweringSymbolKind.Local:
            return "local";
        case MirLoweringSymbolKind.Temporary:
            return "temporary";
        case MirLoweringSymbolKind.Global:
            return "global";
        case MirLoweringSymbolKind.Block:
            return "block";
        case MirLoweringSymbolKind.Function:
            return "function";
    }
}

internal finite law bool MirFunctionBuilderInstructionCursorMatches(
    borrow MirFunctionBuilderState builder,
    borrow IrTable<MirInstruction> instructions)
{
    if (builder.LastInstructionIndexValue == 0)
    {
        return instructions.Count() + 1 == (u64[0 2 ** 63 - 1])builder.FirstInstructionIndexValue;
    }

    return instructions.Count() == (u64[0 2 ** 63 - 1])builder.LastInstructionIndexValue;
}

internal finite law bool MirFunctionBuilderBlockCursorMatches(
    borrow MirFunctionBuilderState builder,
    borrow IrTable<MirBlock> blocks)
{
    if (builder.LastBlockIndexValue == 0)
    {
        return blocks.Count() + 1 == (u64[0 2 ** 63 - 1])builder.FirstBlockIndexValue;
    }

    return blocks.Count() == (u64[0 2 ** 63 - 1])builder.LastBlockIndexValue;
}

internal finite law bool MirBuilderValueFactTableCanAppend(
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts)
{
    return valueFacts.Count() <= instructions.Count();
}

public struct MirLoweringSymbolMap
{
    internal dynamic MirLoweringSymbolKind Kinds;
    internal dynamic MirValueId Values;
    internal dynamic MirType Types;
    internal dynamic MirBlockId Blocks;
    internal dynamic MirFuncId Functions;
    internal dynamic ValueFacts Facts;

    MirLoweringSymbolMap()
    {
        self.Kinds = new();
        self.Values = new();
        self.Types = new();
        self.Blocks = new();
        self.Functions = new();
        self.Facts = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] SlotCount(borrow MirLoweringSymbolMap self)
    {
        return self.Kinds.Length;
    }

    public law MirLoweringSymbolKind KindAt(borrow MirLoweringSymbolMap self, SymbolId symbol)
    {
        if (!symbol.IsValid())
        {
            return MirLoweringSymbolKind.Unknown;
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
        if (index >= self.Kinds.Length)
        {
            return MirLoweringSymbolKind.Unknown;
        }

        return self.Kinds[index];
    }

    public fn MirValueId ValueAt(borrow MirLoweringSymbolMap self, SymbolId symbol)
    {
        if (!symbol.IsValid())
        {
            return MirValueIdOf(0);
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
        if (index >= self.Values.Length)
        {
            return MirValueIdOf(0);
        }

        return self.Values[index];
    }

    public law MirType TypeAt(borrow MirLoweringSymbolMap self, SymbolId symbol)
    {
        if (!symbol.IsValid())
        {
            return MirType.I64;
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
        if (index >= self.Types.Length)
        {
            return MirType.I64;
        }

        return self.Types[index];
    }

    public fn MirBlockId BlockAt(borrow MirLoweringSymbolMap self, SymbolId symbol)
    {
        if (!symbol.IsValid())
        {
            return MirBlockIdOf(0);
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
        if (index >= self.Blocks.Length)
        {
            return MirBlockIdOf(0);
        }

        return self.Blocks[index];
    }

    public fn MirFuncId FunctionAt(borrow MirLoweringSymbolMap self, SymbolId symbol)
    {
        if (!symbol.IsValid())
        {
            return MirFuncIdOf(0);
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
        if (index >= self.Functions.Length)
        {
            return MirFuncIdOf(0);
        }

        return self.Functions[index];
    }

    public law ValueFacts FactsAt(borrow MirLoweringSymbolMap self, SymbolId symbol)
    {
        stack mut ValueFacts empty = new();
        if (!symbol.IsValid())
        {
            return empty;
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
        if (index >= self.Facts.Length)
        {
            return empty;
        }

        return self.Facts[index];
    }
}

internal finite law bool MirBuilderTableCanAppend(u64[0 2 ** 63 - 1] count)
{
    return count < 4294967295;
}

internal finite law bool MirLoweringSymbolMapLengthsMatch(borrow MirLoweringSymbolMap map)
{
    return map.Kinds.Length == map.Values.Length
        && map.Kinds.Length == map.Types.Length
        && map.Kinds.Length == map.Blocks.Length
        && map.Kinds.Length == map.Functions.Length
        && map.Kinds.Length == map.Facts.Length;
}

internal fn MirBuilderStatus EnsureMirLoweringSymbolSlot(
    mut borrow MirLoweringSymbolMap map,
    SymbolId symbol)
{
    if (!symbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!MirLoweringSymbolMapLengthsMatch(map))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    stack u64[0 2 ** 63 - 1] requiredLength = (u64[0 2 ** 63 - 1])symbol.Index();
    if (map.Kinds.Length >= requiredLength)
    {
        return MirBuilderStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] missing =
        (u64[0 2 ** 63 - 1])(requiredLength - map.Kinds.Length);
    if (!map.Kinds.TryReserve(missing)
        || !map.Values.TryReserve(missing)
        || !map.Types.TryReserve(missing)
        || !map.Blocks.TryReserve(missing)
        || !map.Functions.TryReserve(missing)
        || !map.Facts.TryReserve(missing))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    while willexit (map.Kinds.Length < requiredLength)
    {
        init map.Kinds[map.Kinds.Length] = MirLoweringSymbolKind.Unknown;
        init map.Values[map.Values.Length] = MirValueIdOf(0);
        init map.Types[map.Types.Length] = MirType.I64;
        init map.Blocks[map.Blocks.Length] = MirBlockIdOf(0);
        init map.Functions[map.Functions.Length] = MirFuncIdOf(0);
        init map.Facts[map.Facts.Length] = new ValueFacts();
    }

    return MirBuilderStatus.Ok;
}

internal fn MirBuilderStatus RejectDuplicateMirLoweringSymbol(
    borrow MirLoweringSymbolMap map,
    SymbolId symbol)
{
    if (map.KindAt(symbol) != MirLoweringSymbolKind.Unknown)
    {
        return MirBuilderStatus.Err(MirBuilderError.DuplicateSymbol);
    }

    return MirBuilderStatus.Ok;
}

internal inline fn void SetMirLoweringSymbolKindAt(
    mut borrow MirLoweringSymbolMap map,
    u64[0 2 ** 63 - 1] index,
    MirLoweringSymbolKind kind)
{
    unsafe
    {
        map.Kinds[index] = kind;
    }

    return;
}

internal inline fn void SetMirLoweringValueAt(
    mut borrow MirLoweringSymbolMap map,
    u64[0 2 ** 63 - 1] index,
    MirValueId value)
{
    unsafe
    {
        map.Values[index] = value;
    }

    return;
}

internal inline fn void SetMirLoweringTypeAt(
    mut borrow MirLoweringSymbolMap map,
    u64[0 2 ** 63 - 1] index,
    MirType type)
{
    unsafe
    {
        map.Types[index] = type;
    }

    return;
}

internal inline fn void SetMirLoweringBlockAt(
    mut borrow MirLoweringSymbolMap map,
    u64[0 2 ** 63 - 1] index,
    MirBlockId block)
{
    unsafe
    {
        map.Blocks[index] = block;
    }

    return;
}

internal inline fn void SetMirLoweringFunctionAt(
    mut borrow MirLoweringSymbolMap map,
    u64[0 2 ** 63 - 1] index,
    MirFuncId function)
{
    unsafe
    {
        map.Functions[index] = function;
    }

    return;
}

internal inline fn void SetMirLoweringFactsAt(
    mut borrow MirLoweringSymbolMap map,
    u64[0 2 ** 63 - 1] index,
    ValueFacts facts)
{
    unsafe
    {
        map.Facts[index] = facts;
    }

    return;
}

public fn MirBuilderStatus BindMirLoweringValueSymbol(
    mut borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    MirLoweringSymbolKind kind,
    MirValueId value,
    ValueFacts facts)
{
    if (!value.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (kind == MirLoweringSymbolKind.Unknown
        || kind == MirLoweringSymbolKind.Block
        || kind == MirLoweringSymbolKind.Function)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    switch (EnsureMirLoweringSymbolSlot(map, symbol))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(map, symbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
    if (index >= map.Kinds.Length)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    SetMirLoweringSymbolKindAt(map, index, kind);
    if (index >= map.Values.Length)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    SetMirLoweringValueAt(map, index, value);
    if (index >= map.Facts.Length)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    SetMirLoweringFactsAt(map, index, facts);
    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus BindMirLoweringBlockSymbol(
    mut borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    MirBlockId block)
{
    if (!block.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    switch (EnsureMirLoweringSymbolSlot(map, symbol))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(map, symbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
    if (index >= map.Kinds.Length)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    SetMirLoweringSymbolKindAt(map, index, MirLoweringSymbolKind.Block);
    if (index >= map.Blocks.Length)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    SetMirLoweringBlockAt(map, index, block);
    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus BindMirLoweringFunctionSymbol(
    mut borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    MirFuncId function)
{
    if (!function.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    switch (EnsureMirLoweringSymbolSlot(map, symbol))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(map, symbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
    if (index >= map.Kinds.Length)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    SetMirLoweringSymbolKindAt(map, index, MirLoweringSymbolKind.Function);
    if (index >= map.Functions.Length)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    SetMirLoweringFunctionAt(map, index, function);
    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus BindMirLoweringGlobalSymbol(
    mut borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    u32[0 max] globalId,
    ValueFacts facts)
{
    return BindMirLoweringTypedGlobalSymbol(map, symbol, globalId, MirType.I64, facts);
}

public fn MirBuilderStatus BindMirLoweringTypedGlobalSymbol(
    mut borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    u32[0 max] globalId,
    MirType type,
    ValueFacts facts)
{
    if (globalId == 0)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!HighLevelIrGlobalTypeIsLowerable(type)
        || !HighLevelIrValueFactsFitType(type, facts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    switch (EnsureMirLoweringSymbolSlot(map, symbol))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(map, symbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
    if (index >= map.Kinds.Length || index >= map.Values.Length || index >= map.Types.Length || index >= map.Facts.Length)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    SetMirLoweringSymbolKindAt(map, index, MirLoweringSymbolKind.Global);
    SetMirLoweringValueAt(map, index, MirValueIdOf(globalId));
    SetMirLoweringTypeAt(map, index, type);
    SetMirLoweringFactsAt(map, index, facts);
    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus RebindMirLoweringLocalValueSymbol(
    mut borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    MirValueId value,
    ValueFacts facts)
{
    if (!symbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!value.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!MirLoweringSymbolMapLengthsMatch(map))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (map.KindAt(symbol) != MirLoweringSymbolKind.Local)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(symbol.Index() - 1);
    if (index >= map.Values.Length || index >= map.Facts.Length)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    SetMirLoweringValueAt(map, index, value);
    SetMirLoweringFactsAt(map, index, facts);
    return MirBuilderStatus.Ok;
}

public fn bool TryFindMirLoweringValueSymbol(
    borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    stack MirValueId found = map.ValueAt(symbol);
    if (!found.IsValid())
    {
        return false;
    }

    value = found;
    return true;
}

public fn bool TryFindMirLoweringGlobalSymbol(
    borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    out u32[0 max] globalId)
{
    globalId = 0;
    if (map.KindAt(symbol) != MirLoweringSymbolKind.Global)
    {
        return false;
    }

    stack MirValueId value = map.ValueAt(symbol);
    if (!value.IsValid())
    {
        return false;
    }

    globalId = value.Index();
    return true;
}

public fn bool TryFindMirLoweringTypedGlobalSymbol(
    borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    out u32[0 max] globalId,
    out MirType type)
{
    globalId = 0;
    type = MirType.I64;
    if (!TryFindMirLoweringGlobalSymbol(map, symbol, globalId))
    {
        return false;
    }

    type = map.TypeAt(symbol);
    return true;
}

public fn bool TryFindMirLoweringBlockSymbol(
    borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    out MirBlockId block)
{
    block = MirBlockIdOf(0);
    if (map.KindAt(symbol) != MirLoweringSymbolKind.Block)
    {
        return false;
    }

    stack MirBlockId found = map.BlockAt(symbol);
    if (!found.IsValid())
    {
        return false;
    }

    block = found;
    return true;
}

public fn bool TryFindMirLoweringFunctionSymbol(
    borrow MirLoweringSymbolMap map,
    SymbolId symbol,
    out MirFuncId function)
{
    function = MirFuncIdOf(0);
    stack MirFuncId found = map.FunctionAt(symbol);
    if (!found.IsValid())
    {
        return false;
    }

    function = found;
    return true;
}

public struct MirFunctionBuilderState
{
    internal SymbolId FunctionSymbolValue;
    internal u32[0 max] FirstInstructionIndexValue;
    internal u32[0 max] LastInstructionIndexValue;
    internal u32[0 max] FirstBlockIndexValue;
    internal u32[0 max] LastBlockIndexValue;
    internal MirBlockId EntryBlockValue;
    internal bool HasEntryBlockValue;
    internal bool IsOpenValue;
    internal bool UsesArenaFrameValue;
    internal HirBackendFactSet RequiredBackendFactsValue;

    MirFunctionBuilderState()
    {
        self.FunctionSymbolValue = new();
        self.FirstInstructionIndexValue = 0;
        self.LastInstructionIndexValue = 0;
        self.FirstBlockIndexValue = 0;
        self.LastBlockIndexValue = 0;
        self.EntryBlockValue = new();
        self.HasEntryBlockValue = false;
        self.IsOpenValue = false;
        self.UsesArenaFrameValue = false;
        self.RequiredBackendFactsValue = new();
    }

    public inline finite law SymbolId FunctionSymbol(borrow MirFunctionBuilderState self)
    {
        return self.FunctionSymbolValue;
    }

    public inline finite law u32[0 max] FirstInstructionIndex(borrow MirFunctionBuilderState self)
    {
        return self.FirstInstructionIndexValue;
    }

    public inline finite law u32[0 max] LastInstructionIndex(borrow MirFunctionBuilderState self)
    {
        return self.LastInstructionIndexValue;
    }

    public inline finite law u32[0 max] FirstBlockIndex(borrow MirFunctionBuilderState self)
    {
        return self.FirstBlockIndexValue;
    }

    public inline finite law u32[0 max] LastBlockIndex(borrow MirFunctionBuilderState self)
    {
        return self.LastBlockIndexValue;
    }

    public inline finite law MirBlockId EntryBlock(borrow MirFunctionBuilderState self)
    {
        return self.EntryBlockValue;
    }

    public inline finite law bool HasEntryBlock(borrow MirFunctionBuilderState self)
    {
        return self.HasEntryBlockValue;
    }

    public inline finite law bool IsOpen(borrow MirFunctionBuilderState self)
    {
        return self.IsOpenValue;
    }

    public inline finite law bool UsesArenaFrame(borrow MirFunctionBuilderState self)
    {
        return self.UsesArenaFrameValue;
    }

    public inline finite law HirBackendFactSet RequiredBackendFacts(borrow MirFunctionBuilderState self)
    {
        return self.RequiredBackendFactsValue;
    }
}

public inline finite law SymbolId MirFunctionBuilderFunctionSymbol(borrow MirFunctionBuilderState builder)
{
    return builder.FunctionSymbolValue;
}

public inline finite law u32[0 max] MirFunctionBuilderFirstInstructionIndex(borrow MirFunctionBuilderState builder)
{
    return builder.FirstInstructionIndexValue;
}

public inline finite law u32[0 max] MirFunctionBuilderLastInstructionIndex(borrow MirFunctionBuilderState builder)
{
    return builder.LastInstructionIndexValue;
}

public inline finite law u32[0 max] MirFunctionBuilderFirstBlockIndex(borrow MirFunctionBuilderState builder)
{
    return builder.FirstBlockIndexValue;
}

public inline finite law u32[0 max] MirFunctionBuilderLastBlockIndex(borrow MirFunctionBuilderState builder)
{
    return builder.LastBlockIndexValue;
}

public inline finite law MirBlockId MirFunctionBuilderEntryBlock(borrow MirFunctionBuilderState builder)
{
    return builder.EntryBlockValue;
}

public inline finite law bool MirFunctionBuilderHasEntryBlock(borrow MirFunctionBuilderState builder)
{
    return builder.HasEntryBlockValue;
}

public inline finite law bool MirFunctionBuilderIsOpen(borrow MirFunctionBuilderState builder)
{
    return builder.IsOpenValue;
}

public inline finite law bool MirFunctionBuilderUsesArenaFrame(borrow MirFunctionBuilderState builder)
{
    return builder.UsesArenaFrameValue;
}

public inline finite law HirBackendFactSet MirFunctionBuilderRequiredBackendFacts(
    borrow MirFunctionBuilderState builder)
{
    return builder.RequiredBackendFactsValue;
}

public fn MirBuilderStatus BeginMirFunctionBuilder(
    SymbolId functionSymbol,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<MirBlock> blocks,
    out MirFunctionBuilderState builder)
{
    builder = new();
    if (!functionSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!MirBuilderTableCanAppend(instructions.Count())
        || !MirBuilderTableCanAppend(blocks.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    builder = new MirFunctionBuilderState()
    {
        FunctionSymbolValue = functionSymbol,
        FirstInstructionIndexValue = (u32[0 max])(instructions.Count() + 1),
        LastInstructionIndexValue = 0,
        FirstBlockIndexValue = (u32[0 max])(blocks.Count() + 1),
        LastBlockIndexValue = 0,
        EntryBlockValue = MirBlockIdOf(0),
        HasEntryBlockValue = false,
        IsOpenValue = true,
        UsesArenaFrameValue = false,
        RequiredBackendFactsValue = RequiredMirLoweringBackendFacts()
    };
    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus BeginMirFunctionBuilderForHighLevelIrFunction(
    HighLevelIrFunction function,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<MirBlock> blocks,
    out MirFunctionBuilderState builder)
{
    builder = new();
    if (!function.HasBody()
        || function.BodyLoweringKind() != HirFunctionBodyLoweringKind.StarkCfg)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!function.HasAllMirLoweringFacts())
    {
        return MirBuilderStatus.Err(MirBuilderError.MissingBackendFacts);
    }

    return BeginMirFunctionBuilder(SymbolIdOf(function.NameSymbol()), instructions, blocks, builder);
}

public finite law u32[0 max] MirFunctionBuilderInstructionCount(
    borrow MirFunctionBuilderState builder)
{
    if (builder.FirstInstructionIndexValue == 0 || builder.LastInstructionIndexValue == 0)
    {
        return 0;
    }

    if (builder.LastInstructionIndexValue < builder.FirstInstructionIndexValue)
    {
        return 0;
    }

    return builder.LastInstructionIndexValue - builder.FirstInstructionIndexValue + 1;
}

public finite law u32[0 max] MirFunctionBuilderBlockCount(
    borrow MirFunctionBuilderState builder)
{
    if (builder.FirstBlockIndexValue == 0 || builder.LastBlockIndexValue == 0)
    {
        return 0;
    }

    if (builder.LastBlockIndexValue < builder.FirstBlockIndexValue)
    {
        return 0;
    }

    return builder.LastBlockIndexValue - builder.FirstBlockIndexValue + 1;
}

public finite law bool MirFunctionBuilderOwnsValue(
    borrow MirFunctionBuilderState builder,
    MirValueId value)
{
    if (!value.IsValid())
    {
        return false;
    }

    return builder.FirstInstructionIndexValue != 0
        && builder.LastInstructionIndexValue != 0
        && value.Index() >= builder.FirstInstructionIndexValue
        && value.Index() <= builder.LastInstructionIndexValue;
}

public finite law bool MirFunctionBuilderOwnsBlock(
    borrow MirFunctionBuilderState builder,
    MirBlockId block)
{
    if (!block.IsValid())
    {
        return false;
    }

    return builder.FirstBlockIndexValue != 0
        && builder.LastBlockIndexValue != 0
        && block.Index() >= builder.FirstBlockIndexValue
        && block.Index() <= builder.LastBlockIndexValue;
}

public fn MirBuilderStatus RecordMirFunctionBuilderValue(
    mut borrow MirFunctionBuilderState builder,
    borrow IrTable<MirInstruction> instructions,
    MirValueId value)
{
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!value.IsValid() || value.Index() < builder.FirstInstructionIndexValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!instructions.Contains(value.Index()))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (instructions.Count() != (u64[0 2 ** 63 - 1])value.Index())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (builder.LastInstructionIndexValue != 0 && value.Index() != builder.LastInstructionIndexValue + 1)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    builder.LastInstructionIndexValue = value.Index();
    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus EnsureMirFunctionBuilderArenaFrame(
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts)
{
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (builder.UsesArenaFrameValue)
    {
        return MirBuilderStatus.Ok;
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    stack MirValueId frame = MirArenaFrameEnter(instructions);
    if (!frame.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, frame))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!RecordEmptyValueFactsForMirValue(valueFacts, frame))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    builder.UsesArenaFrameValue = true;
    return MirBuilderStatus.Ok;
}

internal fn MirBuilderStatus EmitMirFunctionBuilderArenaFrameLeaveIfNeeded(
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts)
{
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!builder.UsesArenaFrameValue)
    {
        return MirBuilderStatus.Ok;
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    stack MirValueId leave = MirArenaFrameLeave(instructions);
    if (!leave.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, leave))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!RecordEmptyValueFactsForMirValue(valueFacts, leave))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus LowerHighLevelIrParameter(
    HighLevelIrParameter parameter,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId parameterSymbol = parameter.SymbolValue;
    if (!parameterSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!HighLevelIrParameterTypeIsLowerable(parameter))
    {
        return MirBuilderStatus.Err(MirBuilderError.UnsupportedValueType);
    }

    if (!HighLevelIrValueFactsFitType(parameter.TypeValue, parameter.FactsValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (parameter.ParameterIndexValue != MirFunctionBuilderInstructionCount(builder))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    switch (EnsureMirLoweringSymbolSlot(symbols, parameterSymbol))
    {
        case MirBuilderStatus.Err(var slotError):
            return MirBuilderStatus.Err(slotError);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(symbols, parameterSymbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack MirValueId created = MirParamTyped(instructions, parameter.TypeValue, parameter.ParameterIndexValue);
    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!TranslateValueFactsForMirValue(valueFacts, created, parameter.FactsValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (BindMirLoweringValueSymbol(
        symbols,
        parameterSymbol,
        MirLoweringSymbolKind.Parameter,
        created,
        parameter.FactsValue))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            value = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrLocalAlias(
    HighLevelIrLocalAlias local,
    borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts)
{
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId localSymbol = local.SymbolValue;
    if (!localSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    stack MirValueId initialValue = local.InitialValueValue;
    if (!initialValue.IsValid()
        || !instructions.Contains(initialValue.Index())
        || !MirFunctionBuilderOwnsValue(builder, initialValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(initialValue.Index()))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!HighLevelIrLocalAliasTypeMatchesValue(local, instructions))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts initialFacts = ValueFactsForMirValue(valueFacts, initialValue);
    if (!HighLevelIrValueFactsFitType(local.TypeValue, initialFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    return BindMirLoweringValueSymbol(
        symbols,
        localSymbol,
        MirLoweringSymbolKind.Local,
        initialValue,
        initialFacts);
}

public fn MirBuilderStatus LowerHighLevelIrGlobalDeclaration(
    HighLevelIrGlobalDeclaration global,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirGlobal> globals,
    mut borrow IrTable<ValueFacts> globalFacts,
    out u32[0 max] globalId)
{
    globalId = 0;
    stack SymbolId globalSymbol = global.SymbolValue;
    if (!globalSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!HighLevelIrGlobalTypeIsLowerable(global.TypeValue)
        || !HighLevelIrGlobalInitializerFitsType(global.TypeValue, global.InitialValueValue)
        || !HighLevelIrGlobalInitializerSatisfiesFacts(global.TypeValue, global.InitialValueValue, global.FactsValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(globals.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (globalFacts.Count() != globals.Count())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    switch (EnsureMirLoweringSymbolSlot(symbols, globalSymbol))
    {
        case MirBuilderStatus.Err(var slotError):
            return MirBuilderStatus.Err(slotError);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(symbols, globalSymbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack u32[0 max] expectedGlobalId = (u32[0 max])(globals.Count() + 1);
    stack u32[0 max] created = MirDefineGlobalTyped(globals, global.TypeValue, global.InitialValueValue);
    if (created == 0)
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    if (created != expectedGlobalId)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!RecordValueFactsForMirValue(globalFacts, MirValueIdOf(created), global.FactsValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (BindMirLoweringTypedGlobalSymbol(
        symbols,
        globalSymbol,
        created,
        global.TypeValue,
        global.FactsValue))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            globalId = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrModuleGlobals(
    borrow HighLevelIrModule hirModule,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirGlobal> globals,
    mut borrow IrTable<ValueFacts> globalFacts)
{
    stack mut u64[0 2 ** 63 - 1] index = 0;
    while willexit (index < hirModule.GlobalCount())
    {
        stack mut u32[0 max] globalId = 0;
        switch (LowerHighLevelIrGlobalDeclaration(
            hirModule.GlobalAt(index),
            symbols,
            globals,
            globalFacts,
            globalId))
        {
            case MirBuilderStatus.Err(var error):
                return MirBuilderStatus.Err(error);
            case MirBuilderStatus.Ok:
        }

        index = index + 1;
    }

    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus LowerHighLevelIrGlobalReference(
    HighLevelIrGlobalReference reference,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId resultSymbol = reference.SymbolValue;
    stack SymbolId globalSymbol = reference.GlobalSymbolValue;
    if (!resultSymbol.IsValid() || !globalSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!HighLevelIrGlobalTypeIsLowerable(reference.TypeValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack mut u32[0 max] globalId = 0;
    stack mut MirType globalType = MirType.I64;
    if (!TryFindMirLoweringTypedGlobalSymbol(symbols, globalSymbol, globalId, globalType))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (globalType != reference.TypeValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts globalFacts = symbols.FactsAt(globalSymbol);
    if (!HighLevelIrValueFactsFitType(reference.TypeValue, globalFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    switch (EnsureMirLoweringSymbolSlot(symbols, resultSymbol))
    {
        case MirBuilderStatus.Err(var slotError):
            return MirBuilderStatus.Err(slotError);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(symbols, resultSymbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack MirValueId created = MirLoadGlobalTyped(instructions, reference.TypeValue, globalId);
    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!TranslateValueFactsForMirValue(valueFacts, created, globalFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (BindMirLoweringValueSymbol(
        symbols,
        resultSymbol,
        MirLoweringSymbolKind.Temporary,
        created,
        globalFacts))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            value = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrGlobalStore(
    HighLevelIrGlobalStore store,
    mut borrow MirFunctionBuilderState builder,
    borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId globalSymbol = store.GlobalSymbolValue;
    if (!globalSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!HighLevelIrGlobalTypeIsLowerable(store.TypeValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack mut u32[0 max] globalId = 0;
    stack mut MirType globalType = MirType.I64;
    if (!TryFindMirLoweringTypedGlobalSymbol(symbols, globalSymbol, globalId, globalType))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (globalType != store.TypeValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack MirValueId storedValue = store.ValueValue;
    if (!storedValue.IsValid()
        || !instructions.Contains(storedValue.Index())
        || !MirFunctionBuilderOwnsValue(builder, storedValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(storedValue.Index()))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (MirValueType(instructions, storedValue.Index()) != store.TypeValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts storedFacts = ValueFactsForMirValue(valueFacts, storedValue);
    if (!HighLevelIrValueFactsFitType(store.TypeValue, storedFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts globalFacts = symbols.FactsAt(globalSymbol);
    if (!HighLevelIrValueFactsSubsetOf(storedFacts, globalFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    stack MirValueId created = MirStoreGlobalTyped(instructions, store.TypeValue, globalId, storedValue);
    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!RecordEmptyValueFactsForMirValue(valueFacts, created))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    value = created;
    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus LowerHighLevelIrArenaAllocation(
    HighLevelIrArenaAllocation allocation,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId allocationSymbol = allocation.SymbolValue;
    if (!allocationSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!HighLevelIrArenaAllocationShapeIsLowerable(allocation))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    switch (EnsureMirLoweringSymbolSlot(symbols, allocationSymbol))
    {
        case MirBuilderStatus.Err(var slotError):
            return MirBuilderStatus.Err(slotError);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(symbols, allocationSymbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    switch (EnsureMirFunctionBuilderArenaFrame(builder, instructions, valueFacts))
    {
        case MirBuilderStatus.Err(var frameError):
            return MirBuilderStatus.Err(frameError);
        case MirBuilderStatus.Ok:
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    stack MirValueId created = MirArenaAlloc(
        instructions,
        allocation.SizeBytesValue,
        allocation.AlignmentBytesValue);
    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!RecomputeMirGeneratedValueFactsForMirValue(instructions, valueFacts, created))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    stack ValueFacts allocationFacts = ValueFactsForMirValue(valueFacts, created);
    switch (BindMirLoweringValueSymbol(
        symbols,
        allocationSymbol,
        MirLoweringSymbolKind.Temporary,
        created,
        allocationFacts))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            value = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrArenaDynamicStorageInit(
    HighLevelIrArenaDynamicStorageInit storageInit,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId storageSymbol = storageInit.SymbolValue;
    if (!storageSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!HighLevelIrArenaDynamicStorageInitShapeIsLowerable(storageInit))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    switch (EnsureMirLoweringSymbolSlot(symbols, storageSymbol))
    {
        case MirBuilderStatus.Err(var slotError):
            return MirBuilderStatus.Err(slotError);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(symbols, storageSymbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    switch (EnsureMirFunctionBuilderArenaFrame(builder, instructions, valueFacts))
    {
        case MirBuilderStatus.Err(var frameError):
            return MirBuilderStatus.Err(frameError);
        case MirBuilderStatus.Ok:
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    stack MirValueId created = MirArenaDynamicStorageInit(
        instructions,
        storageInit.CapacityValue,
        storageInit.ElementSizeBytesValue,
        storageInit.AlignmentBytesValue);
    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!RecomputeMirGeneratedValueFactsForMirValue(instructions, valueFacts, created))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    stack ValueFacts storageFacts = ValueFactsForMirValue(valueFacts, created);
    switch (BindMirLoweringValueSymbol(
        symbols,
        storageSymbol,
        MirLoweringSymbolKind.Local,
        created,
        storageFacts))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            value = created;
            return MirBuilderStatus.Ok;
    }
}

internal fn MirValueId EmitHighLevelIrArenaDynamicStorageReserveInstruction(
    HighLevelIrArenaDynamicStorageReserve reserve,
    mut borrow IrTable<MirInstruction> instructions)
{
    switch (reserve.KindValue)
    {
        case HighLevelIrArenaDynamicStorageReserveKind.Reserve:
            return MirArenaDynamicStorageReserve(
                instructions,
                reserve.StorageValue,
                reserve.AmountValue,
                reserve.ElementSizeBytesValue,
                reserve.AlignmentBytesValue);
        case HighLevelIrArenaDynamicStorageReserveKind.TryReserve:
            return MirArenaDynamicStorageTryReserve(
                instructions,
                reserve.StorageValue,
                reserve.AmountValue,
                reserve.ElementSizeBytesValue,
                reserve.AlignmentBytesValue);
        case HighLevelIrArenaDynamicStorageReserveKind.TryReserveCapacity:
            return MirArenaDynamicStorageTryReserveCapacity(
                instructions,
                reserve.StorageValue,
                reserve.AmountValue,
                reserve.ElementSizeBytesValue,
                reserve.AlignmentBytesValue);
        case HighLevelIrArenaDynamicStorageReserveKind.Unknown:
            return MirValueIdOf(0);
    }
}

public fn MirBuilderStatus LowerHighLevelIrArenaDynamicStorageReserve(
    HighLevelIrArenaDynamicStorageReserve reserve,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack bool returnsValue =
        HighLevelIrArenaDynamicStorageReserveKindReturnsValue(reserve.KindValue);
    stack SymbolId resultSymbol = reserve.SymbolValue;
    if (returnsValue && !resultSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    stack MirValueId storage = reserve.StorageValue;
    if (!storage.IsValid()
        || !instructions.Contains(storage.Index())
        || !MirFunctionBuilderOwnsValue(builder, storage))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(storage.Index()))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (MirValueType(instructions, storage.Index()) != MirType.Ptr)
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack MirInstruction storageInstr = instructions.Get(storage.Index());
    if (!HighLevelIrArenaDynamicStorageReserveMatchesOwner(reserve, storageInstr))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts storageFacts = ValueFactsForMirValue(valueFacts, storage);
    if (!HighLevelIrArenaDynamicStorageOwnerFactsAreLowerable(storageFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!HighLevelIrArenaDynamicStorageReserveShapeIsLowerable(reserve))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (returnsValue)
    {
        switch (EnsureMirLoweringSymbolSlot(symbols, resultSymbol))
        {
            case MirBuilderStatus.Err(var slotError):
                return MirBuilderStatus.Err(slotError);
            case MirBuilderStatus.Ok:
        }

        switch (RejectDuplicateMirLoweringSymbol(symbols, resultSymbol))
        {
            case MirBuilderStatus.Err(var duplicateError):
                return MirBuilderStatus.Err(duplicateError);
            case MirBuilderStatus.Ok:
        }
    }

    switch (EnsureMirFunctionBuilderArenaFrame(builder, instructions, valueFacts))
    {
        case MirBuilderStatus.Err(var frameError):
            return MirBuilderStatus.Err(frameError);
        case MirBuilderStatus.Ok:
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    stack MirValueId created =
        EmitHighLevelIrArenaDynamicStorageReserveInstruction(reserve, instructions);
    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!RecomputeMirGeneratedValueFactsForMirValue(instructions, valueFacts, created))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    if (!returnsValue)
    {
        value = created;
        return MirBuilderStatus.Ok;
    }

    switch (BindMirLoweringValueSymbol(
        symbols,
        resultSymbol,
        MirLoweringSymbolKind.Temporary,
        created,
        ValueFactsForMirValue(valueFacts, created)))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            value = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrAssignment(
    HighLevelIrAssignment assignment,
    borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId targetSymbol = assignment.TargetSymbolValue;
    if (!targetSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    stack MirValueId assignedValue = assignment.ValueValue;
    if (!assignedValue.IsValid()
        || !instructions.Contains(assignedValue.Index())
        || !MirFunctionBuilderOwnsValue(builder, assignedValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(assignedValue.Index()))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!HighLevelIrAssignmentTypeMatchesValue(assignment, instructions))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts assignedFacts = ValueFactsForMirValue(valueFacts, assignedValue);
    if (!HighLevelIrValueFactsFitType(assignment.TypeValue, assignedFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (symbols.KindAt(targetSymbol) != MirLoweringSymbolKind.Local)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    switch (RebindMirLoweringLocalValueSymbol(
        symbols,
        targetSymbol,
        assignedValue,
        assignedFacts))
    {
        case MirBuilderStatus.Err(var rebindError):
            return MirBuilderStatus.Err(rebindError);
        case MirBuilderStatus.Ok:
            value = assignedValue;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrCompoundAssignment(
    HighLevelIrCompoundAssignment assignment,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId targetSymbol = assignment.TargetSymbolValue;
    if (!targetSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (symbols.KindAt(targetSymbol) != MirLoweringSymbolKind.Local)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!HighLevelIrCompoundAssignmentKindIsLowerable(assignment.KindValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack MirValueId leftValue = symbols.ValueAt(targetSymbol);
    stack MirValueId rightValue = assignment.RightValue;
    if (!leftValue.IsValid()
        || !rightValue.IsValid()
        || !instructions.Contains(leftValue.Index())
        || !instructions.Contains(rightValue.Index())
        || !MirFunctionBuilderOwnsValue(builder, leftValue)
        || !MirFunctionBuilderOwnsValue(builder, rightValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(leftValue.Index()) || !valueFacts.Contains(rightValue.Index()))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    stack HighLevelIrBinaryOp op =
        HighLevelIrBinaryOpOf(targetSymbol, assignment.KindValue, assignment.TypeValue, leftValue, rightValue);
    if (!HighLevelIrBinaryOpTypeIsLowerable(op, instructions))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts leftFacts = ValueFactsForMirValue(valueFacts, leftValue);
    stack ValueFacts rightFacts = ValueFactsForMirValue(valueFacts, rightValue);
    if (!HighLevelIrBinaryOperandFactsFitTypes(op, instructions, leftFacts, rightFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!HighLevelIrBinaryOpBackendFactsAreValid(
        op,
        leftFacts,
        rightFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    stack MirValueId created =
        EmitHighLevelIrBinaryOpInstruction(assignment.KindValue, assignment.TypeValue, leftValue, rightValue, instructions);
    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!RecomputeMirGeneratedValueFactsForMirValue(instructions, valueFacts, created))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RebindMirLoweringLocalValueSymbol(
        symbols,
        targetSymbol,
        created,
        ValueFactsForMirValue(valueFacts, created)))
    {
        case MirBuilderStatus.Err(var rebindError):
            return MirBuilderStatus.Err(rebindError);
        case MirBuilderStatus.Ok:
            value = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrLiteral(
    HighLevelIrLiteral literal,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId literalSymbol = literal.SymbolValue;
    if (!literalSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!HighLevelIrLiteralTypeIsLowerable(literal))
    {
        return MirBuilderStatus.Err(MirBuilderError.UnsupportedLiteral);
    }

    if (!HighLevelIrLiteralFactsAreValid(literal))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    switch (EnsureMirLoweringSymbolSlot(symbols, literalSymbol))
    {
        case MirBuilderStatus.Err(var slotError):
            return MirBuilderStatus.Err(slotError);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(symbols, literalSymbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack mut MirValueId created = MirValueIdOf(0);
    switch (literal.KindValue)
    {
        case HighLevelIrLiteralKind.Null:
            created = MirConstNullPtr(instructions);
        case HighLevelIrLiteralKind.Integer:
            created = MirConstIntTyped(instructions, literal.TypeValue, literal.IntegerValueValue);
        case HighLevelIrLiteralKind.Bool:
            created = MirConstIntTyped(instructions, literal.TypeValue, literal.IntegerValueValue);
        case HighLevelIrLiteralKind.Unknown:
            created = MirValueIdOf(0);
        case HighLevelIrLiteralKind.Float:
            created = MirValueIdOf(0);
        case HighLevelIrLiteralKind.Text:
            created = MirValueIdOf(0);
        case HighLevelIrLiteralKind.Character:
            created = MirValueIdOf(0);
    }

    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!RecordGeneratedValueFactsForMirValue(valueFacts, created, literal.FactsValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (BindMirLoweringValueSymbol(
        symbols,
        literalSymbol,
        MirLoweringSymbolKind.Temporary,
        created,
        literal.FactsValue))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            value = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrBinaryOp(
    HighLevelIrBinaryOp op,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId resultSymbol = op.SymbolValue;
    if (!resultSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!op.LeftValue.IsValid()
        || !op.RightValue.IsValid()
        || !instructions.Contains(op.LeftValue.Index())
        || !instructions.Contains(op.RightValue.Index())
        || !MirFunctionBuilderOwnsValue(builder, op.LeftValue)
        || !MirFunctionBuilderOwnsValue(builder, op.RightValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(op.LeftValue.Index())
        || !valueFacts.Contains(op.RightValue.Index()))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!HighLevelIrBinaryOpTypeIsLowerable(op, instructions))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts leftFacts = ValueFactsForMirValue(valueFacts, op.LeftValue);
    stack ValueFacts rightFacts = ValueFactsForMirValue(valueFacts, op.RightValue);
    if (!HighLevelIrBinaryOperandFactsFitTypes(op, instructions, leftFacts, rightFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!HighLevelIrBinaryOpBackendFactsAreValid(
        op,
        leftFacts,
        rightFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    switch (EnsureMirLoweringSymbolSlot(symbols, resultSymbol))
    {
        case MirBuilderStatus.Err(var slotError):
            return MirBuilderStatus.Err(slotError);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(symbols, resultSymbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack MirValueId created =
        EmitHighLevelIrBinaryOpInstruction(op.KindValue, op.TypeValue, op.LeftValue, op.RightValue, instructions);

    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!RecomputeMirGeneratedValueFactsForMirValue(instructions, valueFacts, created))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (BindMirLoweringValueSymbol(
        symbols,
        resultSymbol,
        MirLoweringSymbolKind.Temporary,
        created,
        ValueFactsForMirValue(valueFacts, created)))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            value = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrCall(
    HighLevelIrCall call,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirValueId value)
{
    value = MirValueIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId resultSymbol = call.SymbolValue;
    if (!resultSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    if (!call.CalleeValue.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    switch (ValidateHighLevelIrCallArguments(call, builder, instructions, valueFacts))
    {
        case MirBuilderStatus.Err(var argumentError):
            return MirBuilderStatus.Err(argumentError);
        case MirBuilderStatus.Ok:
    }

    if (!HighLevelIrCallTypeIsLowerable(call))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(instructions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    switch (EnsureMirLoweringSymbolSlot(symbols, resultSymbol))
    {
        case MirBuilderStatus.Err(var slotError):
            return MirBuilderStatus.Err(slotError);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(symbols, resultSymbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack mut MirValueId created = MirValueIdOf(0);
    switch (call.ArgumentCountValue)
    {
        case 0:
            created = MirCallTyped(instructions, call.TypeValue, call.CalleeValue);
        case 1:
            created = MirCall1Typed(instructions, call.TypeValue, call.CalleeValue, call.Argument0Value);
        case 2:
            created = MirCall2Typed(instructions, call.TypeValue, call.CalleeValue, call.Argument0Value, call.Argument1Value);
        case 3:
            created = MirCall3Typed(instructions, call.TypeValue, call.CalleeValue, call.Argument0Value, call.Argument1Value, call.Argument2Value);
        case 4:
            created = MirCall4Typed(instructions, call.TypeValue, call.CalleeValue, call.Argument0Value, call.Argument1Value, call.Argument2Value, call.Argument3Value);
        default:
            created = MirValueIdOf(0);
    }

    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!TranslateValueFactsForMirValue(valueFacts, created, call.FactsValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (BindMirLoweringValueSymbol(
        symbols,
        resultSymbol,
        MirLoweringSymbolKind.Temporary,
        created,
        call.FactsValue))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            value = created;
            return MirBuilderStatus.Ok;
    }
}

internal fn MirValueId EmitHighLevelIrBecomeTailCallInstruction(
    HighLevelIrBecome tail,
    mut borrow IrTable<MirInstruction> instructions)
{
    switch (tail.ArgumentCountValue)
    {
        case 0:
            return MirTailCallTyped(instructions, tail.TypeValue, tail.CalleeValue);
        case 1:
            return MirTailCall1Typed(instructions, tail.TypeValue, tail.CalleeValue, tail.Argument0Value);
        case 2:
            return MirTailCall2Typed(instructions, tail.TypeValue, tail.CalleeValue, tail.Argument0Value, tail.Argument1Value);
        case 3:
            return MirTailCall3Typed(instructions, tail.TypeValue, tail.CalleeValue, tail.Argument0Value, tail.Argument1Value, tail.Argument2Value);
        case 4:
            return MirTailCall4Typed(instructions, tail.TypeValue, tail.CalleeValue, tail.Argument0Value, tail.Argument1Value, tail.Argument2Value, tail.Argument3Value);
        default:
            return MirValueIdOf(0);
    }
}

public fn MirBuilderStatus LowerHighLevelIrBecome(
    HighLevelIrBecome tail,
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    mut borrow IrTable<MirBlock> blocks,
    out MirValueId tailCall,
    out MirBlockId block)
{
    tailCall = MirValueIdOf(0);
    block = MirBlockIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!tail.CalleeValue.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    switch (ValidateHighLevelIrBecomeArguments(tail, builder, instructions, valueFacts))
    {
        case MirBuilderStatus.Err(var argumentError):
            return MirBuilderStatus.Err(argumentError);
        case MirBuilderStatus.Ok:
    }

    if (!HighLevelIrBecomeTypeIsLowerable(tail))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(instructions.Count())
        || !MirBuilderTableCanAppend(blocks.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirBuilderValueFactTableCanAppend(instructions, valueFacts)
        || !MirFunctionBuilderBlockCursorMatches(builder, blocks))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    stack MirValueId created = EmitHighLevelIrBecomeTailCallInstruction(tail, instructions);
    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (RecordMirFunctionBuilderValue(builder, instructions, created))
    {
        case MirBuilderStatus.Err(var recordError):
            return MirBuilderStatus.Err(recordError);
        case MirBuilderStatus.Ok:
    }

    if (!TranslateValueFactsForMirValue(valueFacts, created, tail.FactsValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    switch (AppendMirBuilderTailCallBlock(builder, blocks, instructions, valueFacts, created, block))
    {
        case MirBuilderStatus.Err(var blockError):
            return MirBuilderStatus.Err(blockError);
        case MirBuilderStatus.Ok:
            tailCall = created;
            return MirBuilderStatus.Ok;
    }
}

internal fn MirBuilderStatus RecordMirFunctionBuilderBlock(
    mut borrow MirFunctionBuilderState builder,
    borrow IrTable<MirBlock> blocks,
    MirBlockId block)
{
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!block.IsValid() || block.Index() < builder.FirstBlockIndexValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!blocks.Contains(block.Index()))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (blocks.Count() != (u64[0 2 ** 63 - 1])block.Index())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (builder.LastBlockIndexValue != 0 && block.Index() != builder.LastBlockIndexValue + 1)
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    builder.LastBlockIndexValue = block.Index();
    if (!builder.HasEntryBlockValue)
    {
        builder.EntryBlockValue = block;
        builder.HasEntryBlockValue = true;
    }

    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus SetMirFunctionBuilderEntry(
    mut borrow MirFunctionBuilderState builder,
    borrow IrTable<MirBlock> blocks,
    MirBlockId entry)
{
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!MirFunctionBuilderOwnsBlock(builder, entry))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!blocks.Contains(entry.Index())
        || !MirFunctionBuilderBlockCursorMatches(builder, blocks))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    builder.EntryBlockValue = entry;
    builder.HasEntryBlockValue = true;
    return MirBuilderStatus.Ok;
}

public fn MirBuilderStatus AppendMirBuilderReturnBlock(
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    MirValueId value,
    out MirBlockId block)
{
    block = MirBlockIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!value.IsValid()
        || !instructions.Contains(value.Index())
        || !MirFunctionBuilderOwnsValue(builder, value))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(value.Index())
        || !MirFunctionBuilderBlockCursorMatches(builder, blocks))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    stack MirType valueType = MirValueType(instructions, value.Index());
    stack ValueFacts returnFacts = ValueFactsForMirValue(valueFacts, value);
    if (!HighLevelIrValueFactsFitType(valueType, returnFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(blocks.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    switch (EmitMirFunctionBuilderArenaFrameLeaveIfNeeded(builder, instructions, valueFacts))
    {
        case MirBuilderStatus.Err(var frameError):
            return MirBuilderStatus.Err(frameError);
        case MirBuilderStatus.Ok:
    }

    stack MirBlockId created = MirReturnBlock(blocks, value);
    switch (RecordMirFunctionBuilderBlock(builder, blocks, created))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
            block = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus AppendMirBuilderVoidReturnBlock(
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirBlockId block)
{
    block = MirBlockIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!MirFunctionBuilderBlockCursorMatches(builder, blocks))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!MirBuilderTableCanAppend(blocks.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    switch (EmitMirFunctionBuilderArenaFrameLeaveIfNeeded(builder, instructions, valueFacts))
    {
        case MirBuilderStatus.Err(var frameError):
            return MirBuilderStatus.Err(frameError);
        case MirBuilderStatus.Ok:
    }

    stack MirBlockId created = MirReturnVoidBlock(blocks);
    switch (RecordMirFunctionBuilderBlock(builder, blocks, created))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
            block = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus LowerHighLevelIrReturn(
    HighLevelIrReturn ret,
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirBlockId block)
{
    block = MirBlockIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack MirValueId value = ret.ValueValue;
    if (!value.IsValid()
        || !instructions.Contains(value.Index())
        || !MirFunctionBuilderOwnsValue(builder, value))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(value.Index())
        || !MirFunctionBuilderBlockCursorMatches(builder, blocks))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!HighLevelIrReturnTypeMatchesValue(ret, instructions))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts returnFacts = ValueFactsForMirValue(valueFacts, value);
    if (!HighLevelIrValueFactsFitType(ret.TypeValue, returnFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(blocks.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    return AppendMirBuilderReturnBlock(builder, blocks, instructions, valueFacts, value, block);
}

public fn MirBuilderStatus LowerHighLevelIrVoidReturn(
    HighLevelIrVoidReturn ret,
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    out MirBlockId block)
{
    block = MirBlockIdOf(0);
    return AppendMirBuilderVoidReturnBlock(builder, blocks, instructions, valueFacts, block);
}

public fn MirBuilderStatus LowerHighLevelIrIfBranch(
    HighLevelIrIfBranch branch,
    mut borrow MirFunctionBuilderState builder,
    mut borrow MirLoweringSymbolMap symbols,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts,
    mut borrow IrTable<MirBlock> blocks,
    out MirBlockId block)
{
    block = MirBlockIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    stack SymbolId branchSymbol = branch.SymbolValue;
    stack SymbolId thenSymbol = branch.ThenBlockSymbolValue;
    stack SymbolId elseSymbol = branch.ElseBlockSymbolValue;
    if (!branchSymbol.IsValid() || !thenSymbol.IsValid() || !elseSymbol.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    stack mut MirBlockId thenTarget = new();
    stack mut MirBlockId elseTarget = new();
    if (!TryFindMirLoweringBlockSymbol(symbols, thenSymbol, thenTarget)
        || !TryFindMirLoweringBlockSymbol(symbols, elseSymbol, elseTarget))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidSymbol);
    }

    switch (EnsureMirLoweringSymbolSlot(symbols, branchSymbol))
    {
        case MirBuilderStatus.Err(var slotError):
            return MirBuilderStatus.Err(slotError);
        case MirBuilderStatus.Ok:
    }

    switch (RejectDuplicateMirLoweringSymbol(symbols, branchSymbol))
    {
        case MirBuilderStatus.Err(var duplicateError):
            return MirBuilderStatus.Err(duplicateError);
        case MirBuilderStatus.Ok:
    }

    stack mut MirBlockId created = new();
    switch (AppendMirBuilderCondBlock(
        builder,
        blocks,
        instructions,
        valueFacts,
        branch.ConditionValue,
        thenTarget,
        elseTarget,
        created))
    {
        case MirBuilderStatus.Err(var appendError):
            return MirBuilderStatus.Err(appendError);
        case MirBuilderStatus.Ok:
    }

    switch (BindMirLoweringBlockSymbol(symbols, branchSymbol, created))
    {
        case MirBuilderStatus.Err(var bindError):
            return MirBuilderStatus.Err(bindError);
        case MirBuilderStatus.Ok:
            block = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus AppendMirBuilderBranchBlock(
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirBlock> blocks,
    MirBlockId target,
    out MirBlockId block)
{
    block = MirBlockIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!MirFunctionBuilderOwnsBlock(builder, target))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!MirFunctionBuilderBlockCursorMatches(builder, blocks))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!MirBuilderTableCanAppend(blocks.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    stack MirBlockId created = MirBranchBlock(blocks, target);
    switch (RecordMirFunctionBuilderBlock(builder, blocks, created))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
            block = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus AppendMirBuilderCondBlock(
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirBlock> blocks,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<ValueFacts> valueFacts,
    MirValueId condition,
    MirBlockId thenTarget,
    MirBlockId elseTarget,
    out MirBlockId block)
{
    block = MirBlockIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!condition.IsValid()
        || !instructions.Contains(condition.Index())
        || !MirFunctionBuilderOwnsValue(builder, condition)
        || !MirFunctionBuilderOwnsBlock(builder, thenTarget)
        || !MirFunctionBuilderOwnsBlock(builder, elseTarget))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(condition.Index())
        || !MirFunctionBuilderBlockCursorMatches(builder, blocks))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (MirValueType(instructions, condition.Index()) != MirType.I1)
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack ValueFacts conditionFacts = ValueFactsForMirValue(valueFacts, condition);
    if (!HighLevelIrValueFactsFitType(MirType.I1, conditionFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(blocks.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    stack MirBlockId created = MirCondBlock(blocks, condition, thenTarget, elseTarget);
    switch (RecordMirFunctionBuilderBlock(builder, blocks, created))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
            block = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus AppendMirBuilderTailCallBlock(
    mut borrow MirFunctionBuilderState builder,
    mut borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<MirInstruction> instructions,
    mut borrow IrTable<ValueFacts> valueFacts,
    MirValueId tailCall,
    out MirBlockId block)
{
    block = MirBlockIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!tailCall.IsValid()
        || !instructions.Contains(tailCall.Index())
        || !MirFunctionBuilderOwnsValue(builder, tailCall))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!valueFacts.Contains(tailCall.Index())
        || !MirFunctionBuilderBlockCursorMatches(builder, blocks))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (MirOpcodeOf(instructions, tailCall) != MirOp.TailCall)
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    stack MirType tailType = MirValueType(instructions, tailCall.Index());
    stack ValueFacts tailFacts = ValueFactsForMirValue(valueFacts, tailCall);
    if (!HighLevelIrValueFactsFitType(tailType, tailFacts))
    {
        return MirBuilderStatus.Err(MirBuilderError.TypeMismatch);
    }

    if (!MirBuilderTableCanAppend(blocks.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    switch (EmitMirFunctionBuilderArenaFrameLeaveIfNeeded(builder, instructions, valueFacts))
    {
        case MirBuilderStatus.Err(var frameError):
            return MirBuilderStatus.Err(frameError);
        case MirBuilderStatus.Ok:
    }

    stack MirBlockId created = MirTailCallBlock(blocks, tailCall);
    switch (RecordMirFunctionBuilderBlock(builder, blocks, created))
    {
        case MirBuilderStatus.Err(var error):
            return MirBuilderStatus.Err(error);
        case MirBuilderStatus.Ok:
            block = created;
            return MirBuilderStatus.Ok;
    }
}

public fn MirBuilderStatus FinishMirFunctionBuilder(
    mut borrow MirFunctionBuilderState builder,
    borrow IrTable<MirInstruction> instructions,
    borrow IrTable<MirBlock> blocks,
    mut borrow IrTable<MirFunction> functions,
    out MirFuncId function)
{
    function = MirFuncIdOf(0);
    if (!builder.IsOpenValue)
    {
        return MirBuilderStatus.Err(MirBuilderError.BuilderClosed);
    }

    if (!builder.HasEntryBlockValue || MirFunctionBuilderBlockCount(builder) == 0)
    {
        return MirBuilderStatus.Err(MirBuilderError.MissingEntryBlock);
    }

    if (!MirFunctionBuilderOwnsBlock(builder, builder.EntryBlockValue))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidHandle);
    }

    if (!MirFunctionBuilderInstructionCursorMatches(builder, instructions)
        || !MirFunctionBuilderBlockCursorMatches(builder, blocks))
    {
        return MirBuilderStatus.Err(MirBuilderError.InvalidBuilderState);
    }

    if (!MirBuilderTableCanAppend(functions.Count()))
    {
        return MirBuilderStatus.Err(MirBuilderError.TableTooLarge);
    }

    stack mut MirValueId firstInstruction = MirValueIdOf(0);
    stack u32[0 max] instructionCount = MirFunctionBuilderInstructionCount(builder);
    if (instructionCount != 0)
    {
        firstInstruction = MirValueIdOf(builder.FirstInstructionIndexValue);
    }

    stack MirFuncId created = MirDefineFunction(
        functions,
        builder.EntryBlockValue,
        MirBlockIdOf(builder.FirstBlockIndexValue),
        MirFunctionBuilderBlockCount(builder),
        firstInstruction,
        instructionCount);
    if (!created.IsValid())
    {
        return MirBuilderStatus.Err(MirBuilderError.OutOfMemory);
    }

    builder.IsOpenValue = false;
    function = created;
    return MirBuilderStatus.Ok;
}
