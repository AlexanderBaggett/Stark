public struct HirBackendFactSet
{
    internal bool HasRangeFactsValue;
    internal bool HasAliasFactsValue;
    internal bool HasAbiFactsValue;
    internal bool HasLayoutFactsValue;
    internal bool HasOwnershipFactsValue;
    internal bool HasAssemblyFactsValue;
    internal bool HasArenaFactsValue;
    internal bool HasDropFactsValue;

    HirBackendFactSet()
    {
        self.HasRangeFactsValue = false;
        self.HasAliasFactsValue = false;
        self.HasAbiFactsValue = false;
        self.HasLayoutFactsValue = false;
        self.HasOwnershipFactsValue = false;
        self.HasAssemblyFactsValue = false;
        self.HasArenaFactsValue = false;
        self.HasDropFactsValue = false;
    }

    public inline finite law bool HasRangeFacts(borrow HirBackendFactSet self)
    {
        return self.HasRangeFactsValue;
    }

    public inline finite law bool HasAliasFacts(borrow HirBackendFactSet self)
    {
        return self.HasAliasFactsValue;
    }

    public inline finite law bool HasAbiFacts(borrow HirBackendFactSet self)
    {
        return self.HasAbiFactsValue;
    }

    public inline finite law bool HasLayoutFacts(borrow HirBackendFactSet self)
    {
        return self.HasLayoutFactsValue;
    }

    public inline finite law bool HasOwnershipFacts(borrow HirBackendFactSet self)
    {
        return self.HasOwnershipFactsValue;
    }

    public inline finite law bool HasAssemblyFacts(borrow HirBackendFactSet self)
    {
        return self.HasAssemblyFactsValue;
    }

    public inline finite law bool HasArenaFacts(borrow HirBackendFactSet self)
    {
        return self.HasArenaFactsValue;
    }

    public inline finite law bool HasDropFacts(borrow HirBackendFactSet self)
    {
        return self.HasDropFactsValue;
    }
}

public inline finite law HirBackendFactSet HirBackendFactSetOf(
    bool hasRangeFacts,
    bool hasAliasFacts,
    bool hasAbiFacts,
    bool hasLayoutFacts,
    bool hasOwnershipFacts,
    bool hasAssemblyFacts,
    bool hasArenaFacts,
    bool hasDropFacts)
{
    return new HirBackendFactSet()
    {
        HasRangeFactsValue = hasRangeFacts,
        HasAliasFactsValue = hasAliasFacts,
        HasAbiFactsValue = hasAbiFacts,
        HasLayoutFactsValue = hasLayoutFacts,
        HasOwnershipFactsValue = hasOwnershipFacts,
        HasAssemblyFactsValue = hasAssemblyFacts,
        HasArenaFactsValue = hasArenaFacts,
        HasDropFactsValue = hasDropFacts
    };
}

public inline finite law HirBackendFactSet RequiredMirLoweringBackendFacts()
{
    return HirBackendFactSetOf(true, true, true, true, true, true, true, true);
}

public inline finite law bool HirBackendFactsCoverMirLowering(HirBackendFactSet facts)
{
    return facts.HasRangeFacts()
        && facts.HasAliasFacts()
        && facts.HasAbiFacts()
        && facts.HasLayoutFacts()
        && facts.HasOwnershipFacts()
        && facts.HasAssemblyFacts()
        && facts.HasArenaFacts()
        && facts.HasDropFacts();
}

internal finite law i64[min max] LoweringI64MinValue()
{
    return (i64[min max])(-(2 ** 63));
}

internal finite law i64[min max] LoweringI64MaxValue()
{
    return 9223372036854775807;
}

internal finite law i64[min max] LoweringI32MinValue()
{
    return (i64[min max])(-(2 ** 31));
}

internal finite law i64[min max] LoweringI16MinValue()
{
    return -32768;
}

internal finite law i64[min max] LoweringI8MinValue()
{
    return -128;
}

internal finite law i64[min max] LoweringI32MaxValue()
{
    return 2147483647;
}

internal finite law i64[min max] LoweringI16MaxValue()
{
    return 32767;
}

internal finite law i64[min max] LoweringI8MaxValue()
{
    return 127;
}

internal fn ValueFacts HighLevelIrExactIntegerFacts(i64[min max] value)
{
    stack mut ValueFacts facts = new();
    if (value == LoweringI64MaxValue())
    {
        facts.SetIntegerRange(value, LoweringI64MinValue());
    }
    else
    {
        facts.SetIntegerRange(value, value + 1);
    }

    return facts;
}

public struct HighLevelIrLiteral
{
    internal SymbolId SymbolValue;
    internal HighLevelIrLiteralKind KindValue;
    internal MirType TypeValue;
    internal i64[min max] IntegerValueValue;
    internal ValueFacts FactsValue;

    HighLevelIrLiteral()
    {
        self.SymbolValue = new();
        self.KindValue = HighLevelIrLiteralKind.Unknown;
        self.TypeValue = MirType.I64;
        self.IntegerValueValue = 0;
        self.FactsValue = new();
    }

    public inline finite law SymbolId Symbol(borrow HighLevelIrLiteral self)
    {
        return self.SymbolValue;
    }

    public inline finite law HighLevelIrLiteralKind Kind(borrow HighLevelIrLiteral self)
    {
        return self.KindValue;
    }

    public inline finite law MirType Type(borrow HighLevelIrLiteral self)
    {
        return self.TypeValue;
    }

    public inline finite law i64[min max] IntegerValue(borrow HighLevelIrLiteral self)
    {
        return self.IntegerValueValue;
    }

    public inline finite law ValueFacts Facts(borrow HighLevelIrLiteral self)
    {
        return self.FactsValue;
    }
}

public inline finite law HighLevelIrLiteral HighLevelIrLiteralWithFacts(
    SymbolId symbol,
    HighLevelIrLiteralKind kind,
    MirType type,
    i64[min max] integerValue,
    ValueFacts facts)
{
    return new HighLevelIrLiteral()
    {
        SymbolValue = symbol,
        KindValue = kind,
        TypeValue = type,
        IntegerValueValue = integerValue,
        FactsValue = facts
    };
}

public fn HighLevelIrLiteral HighLevelIrIntegerLiteralOf(
    SymbolId symbol,
    MirType type,
    i64[min max] value)
{
    return HighLevelIrLiteralWithFacts(
        symbol,
        HighLevelIrLiteralKind.Integer,
        type,
        value,
        HighLevelIrExactIntegerFacts(value));
}

public fn HighLevelIrLiteral HighLevelIrBoolLiteralOf(SymbolId symbol, bool value)
{
    stack mut i64[min max] integerValue = 0;
    if (value)
    {
        integerValue = 1;
    }

    return HighLevelIrLiteralWithFacts(
        symbol,
        HighLevelIrLiteralKind.Bool,
        MirType.I1,
        integerValue,
        HighLevelIrExactIntegerFacts(integerValue));
}

public fn HighLevelIrLiteral HighLevelIrNullPointerLiteralOf(SymbolId symbol)
{
    stack mut ValueFacts facts = new();
    facts.MarkKnownNull();
    return HighLevelIrLiteralWithFacts(
        symbol,
        HighLevelIrLiteralKind.Null,
        MirType.Ptr,
        0,
        facts);
}

public inline finite law HighLevelIrLiteral HighLevelIrUnsupportedLiteralOf(
    SymbolId symbol,
    HighLevelIrLiteralKind kind,
    MirType type)
{
    return HighLevelIrLiteralWithFacts(symbol, kind, type, 0, new ValueFacts());
}

internal finite law bool HighLevelIrLiteralTypeIsLowerable(HighLevelIrLiteral literal)
{
    switch (literal.KindValue)
    {
        case HighLevelIrLiteralKind.Integer:
            if (literal.TypeValue == MirType.I64)
            {
                return true;
            }

            if (literal.TypeValue == MirType.I32)
            {
                return literal.IntegerValueValue >= LoweringI32MinValue()
                    && literal.IntegerValueValue <= LoweringI32MaxValue();
            }

            return false;
        case HighLevelIrLiteralKind.Bool:
            return literal.TypeValue == MirType.I1
                && (literal.IntegerValueValue == 0 || literal.IntegerValueValue == 1);
        case HighLevelIrLiteralKind.Null:
            return literal.TypeValue == MirType.Ptr
                && literal.IntegerValueValue == 0;
        case HighLevelIrLiteralKind.Unknown:
            return false;
        case HighLevelIrLiteralKind.Float:
            return false;
        case HighLevelIrLiteralKind.Text:
            return false;
        case HighLevelIrLiteralKind.Character:
            return false;
    }
}

internal finite law bool HighLevelIrLiteralFactsAreValid(HighLevelIrLiteral literal)
{
    return HighLevelIrGlobalInitializerSatisfiesFacts(
        literal.TypeValue,
        literal.IntegerValueValue,
        literal.FactsValue);
}

