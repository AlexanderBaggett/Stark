internal finite law bool HighLevelIrBinaryOpHasIntegerResult(HighLevelIrBinaryOpKind kind)
{
    return kind == HighLevelIrBinaryOpKind.Add
        || kind == HighLevelIrBinaryOpKind.Sub
        || kind == HighLevelIrBinaryOpKind.Mul
        || kind == HighLevelIrBinaryOpKind.WrappingAdd
        || kind == HighLevelIrBinaryOpKind.WrappingSub
        || kind == HighLevelIrBinaryOpKind.WrappingMul
        || kind == HighLevelIrBinaryOpKind.SaturatingAdd
        || kind == HighLevelIrBinaryOpKind.SaturatingSub
        || kind == HighLevelIrBinaryOpKind.SaturatingMul
        || kind == HighLevelIrBinaryOpKind.SDiv
        || kind == HighLevelIrBinaryOpKind.UDiv
        || kind == HighLevelIrBinaryOpKind.SRem
        || kind == HighLevelIrBinaryOpKind.And
        || kind == HighLevelIrBinaryOpKind.Or
        || kind == HighLevelIrBinaryOpKind.Xor
        || kind == HighLevelIrBinaryOpKind.Shl
        || kind == HighLevelIrBinaryOpKind.AShr;
}

internal finite law bool HighLevelIrBinaryOpIsComparison(HighLevelIrBinaryOpKind kind)
{
    return kind == HighLevelIrBinaryOpKind.CmpEq
        || kind == HighLevelIrBinaryOpKind.CmpNe
        || kind == HighLevelIrBinaryOpKind.CmpLt
        || kind == HighLevelIrBinaryOpKind.CmpLe
        || kind == HighLevelIrBinaryOpKind.CmpGt
        || kind == HighLevelIrBinaryOpKind.CmpGe;
}

internal finite law bool HighLevelIrArithmeticTypeIsLowerable(MirType type)
{
    return type == MirType.I32 || type == MirType.I64;
}

internal finite law bool HighLevelIrBinaryOpIsDivisionOrRemainder(HighLevelIrBinaryOpKind kind)
{
    return kind == HighLevelIrBinaryOpKind.SDiv
        || kind == HighLevelIrBinaryOpKind.UDiv
        || kind == HighLevelIrBinaryOpKind.SRem;
}

internal finite law bool HighLevelIrBinaryOpIsSignedDivisionOrRemainder(HighLevelIrBinaryOpKind kind)
{
    return kind == HighLevelIrBinaryOpKind.SDiv
        || kind == HighLevelIrBinaryOpKind.SRem;
}

internal finite law bool HighLevelIrBinaryOpIsShift(HighLevelIrBinaryOpKind kind)
{
    return kind == HighLevelIrBinaryOpKind.Shl
        || kind == HighLevelIrBinaryOpKind.AShr;
}

internal finite law bool HighLevelIrComparisonOperandTypeIsLowerable(
    HighLevelIrBinaryOpKind kind,
    MirType type)
{
    if (type == MirType.I32 || type == MirType.I64)
    {
        return true;
    }

    return type == MirType.I1
        && (kind == HighLevelIrBinaryOpKind.CmpEq || kind == HighLevelIrBinaryOpKind.CmpNe);
}

internal fn bool HighLevelIrBinaryOpTypeIsLowerable(
    HighLevelIrBinaryOp op,
    borrow IrTable<MirInstruction> instructions)
{
    if (!op.LeftValue.IsValid() || !op.RightValue.IsValid())
    {
        return false;
    }

    stack MirType leftType = MirValueType(instructions, op.LeftValue.Index());
    stack MirType rightType = MirValueType(instructions, op.RightValue.Index());
    if (leftType != rightType)
    {
        return false;
    }

    if (HighLevelIrBinaryOpHasIntegerResult(op.KindValue))
    {
        return op.TypeValue == leftType
            && HighLevelIrArithmeticTypeIsLowerable(op.TypeValue);
    }

    if (HighLevelIrBinaryOpIsComparison(op.KindValue))
    {
        return op.TypeValue == MirType.I1
            && HighLevelIrComparisonOperandTypeIsLowerable(op.KindValue, leftType);
    }

    return false;
}

internal fn bool HighLevelIrBinaryOperandFactsFitTypes(
    HighLevelIrBinaryOp op,
    borrow IrTable<MirInstruction> instructions,
    ValueFacts leftFacts,
    ValueFacts rightFacts)
{
    return HighLevelIrValueFactsFitType(
            MirValueType(instructions, op.LeftValue.Index()),
            leftFacts)
        && HighLevelIrValueFactsFitType(
            MirValueType(instructions, op.RightValue.Index()),
            rightFacts);
}

internal finite law i64[min max] HighLevelIrI64MinValue()
{
    return (i64[min max])(-(2 ** 63));
}

internal finite law i64[min max] HighLevelIrI64MaxValue()
{
    return 9223372036854775807;
}

internal finite bool TryReadHighLevelIrSingleIntegerFact(ValueFacts facts, out i64[min max] value)
{
    value = 0;
    if (!facts.HasIntegerRange())
    {
        return false;
    }

    stack i64[min max] lower = facts.IntegerRangeLower();
    stack i64[min max] upperExclusive = facts.IntegerRangeUpperExclusive();
    if (upperExclusive == HighLevelIrI64MinValue())
    {
        if (lower != HighLevelIrI64MaxValue())
        {
            return false;
        }

        value = lower;
        return true;
    }

    if (lower == HighLevelIrI64MaxValue())
    {
        return false;
    }

    if (upperExclusive != lower + 1)
    {
        return false;
    }

    value = lower;
    return true;
}

internal finite law bool HighLevelIrShiftAmountIsValid(MirType type, i64[min max] value)
{
    if (value < 0)
    {
        return false;
    }

    switch (type)
    {
        case MirType.I8:
            return value < 8;
        case MirType.I16:
            return value < 16;
        case MirType.I32:
            return value < 32;
        case MirType.I64:
            return value < 64;
        case MirType.I1:
            return value < 1;
        case MirType.Ptr:
            return false;
        case MirType.EnumValue:
            return false;
    }
}

internal fn bool HighLevelIrBinaryOpBackendFactsAreValid(
    HighLevelIrBinaryOp op,
    ValueFacts leftFacts,
    ValueFacts rightFacts)
{
    stack mut i64[min max] right = 0;
    if (HighLevelIrBinaryOpIsDivisionOrRemainder(op.KindValue)
        && TryReadHighLevelIrSingleIntegerFact(rightFacts, right))
    {
        if (right == 0)
        {
            return false;
        }

        stack mut i64[min max] left = 0;
        if (HighLevelIrBinaryOpIsSignedDivisionOrRemainder(op.KindValue)
            && right == -1
            && TryReadHighLevelIrSingleIntegerFact(leftFacts, left)
            && left == HighLevelIrI64MinValue())
        {
            return false;
        }
    }

    if (HighLevelIrBinaryOpIsShift(op.KindValue)
        && TryReadHighLevelIrSingleIntegerFact(rightFacts, right)
        && !HighLevelIrShiftAmountIsValid(op.TypeValue, right))
    {
        return false;
    }

    return true;
}

internal finite law bool HighLevelIrCompoundAssignmentKindIsLowerable(HighLevelIrBinaryOpKind kind)
{
    return kind == HighLevelIrBinaryOpKind.Add
        || kind == HighLevelIrBinaryOpKind.Sub
        || kind == HighLevelIrBinaryOpKind.Mul
        || kind == HighLevelIrBinaryOpKind.SDiv
        || kind == HighLevelIrBinaryOpKind.UDiv
        || kind == HighLevelIrBinaryOpKind.SRem
        || kind == HighLevelIrBinaryOpKind.And
        || kind == HighLevelIrBinaryOpKind.Or
        || kind == HighLevelIrBinaryOpKind.Xor
        || kind == HighLevelIrBinaryOpKind.WrappingAdd
        || kind == HighLevelIrBinaryOpKind.WrappingSub
        || kind == HighLevelIrBinaryOpKind.WrappingMul
        || kind == HighLevelIrBinaryOpKind.SaturatingAdd
        || kind == HighLevelIrBinaryOpKind.SaturatingSub
        || kind == HighLevelIrBinaryOpKind.SaturatingMul;
}

internal fn MirValueId EmitHighLevelIrBinaryOpInstruction(
    HighLevelIrBinaryOpKind kind,
    MirType type,
    MirValueId left,
    MirValueId right,
    mut borrow IrTable<MirInstruction> instructions)
{
    switch (kind)
    {
        case HighLevelIrBinaryOpKind.Add:
            return MirAddTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.Sub:
            return MirSubTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.Mul:
            return MirMulTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.WrappingAdd:
            return MirWrappingAddTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.WrappingSub:
            return MirWrappingSubTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.WrappingMul:
            return MirWrappingMulTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.SaturatingAdd:
            return MirSaturatingAddTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.SaturatingSub:
            return MirSaturatingSubTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.SaturatingMul:
            return MirSaturatingMulTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.SDiv:
            return MirSDivTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.UDiv:
            return MirUDivTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.SRem:
            return MirSRemTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.And:
            return MirAndTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.Or:
            return MirOrTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.Xor:
            return MirXorTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.Shl:
            return MirShlTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.AShr:
            return MirAShrTyped(instructions, type, left, right);
        case HighLevelIrBinaryOpKind.CmpEq:
            return MirCmpEq(instructions, left, right);
        case HighLevelIrBinaryOpKind.CmpNe:
            return MirCmpNe(instructions, left, right);
        case HighLevelIrBinaryOpKind.CmpLt:
            return MirCmpLt(instructions, left, right);
        case HighLevelIrBinaryOpKind.CmpLe:
            return MirCmpLe(instructions, left, right);
        case HighLevelIrBinaryOpKind.CmpGt:
            return MirCmpGt(instructions, left, right);
        case HighLevelIrBinaryOpKind.CmpGe:
            return MirCmpGe(instructions, left, right);
        case HighLevelIrBinaryOpKind.Unknown:
            return MirValueIdOf(0);
    }
}

public struct HighLevelIrFunction
{
    internal u32[0 max] NameSymbolValue;
    internal u32[0 max] SignatureIndexPlusOneValue;
    internal u32[0 max] EffectIndexPlusOneValue;
    internal bool HasBodyValue;
    internal HirFunctionBodyLoweringKind BodyLoweringKindValue;
    internal bool HasBodyTemplateValue;
    internal bool HasGenericTypeSubstitutionValue;
    internal bool HasGenericValueSubstitutionValue;
    internal HirBackendFactSet BackendFactsValue;

    HighLevelIrFunction()
    {
        self.NameSymbolValue = 0;
        self.SignatureIndexPlusOneValue = 0;
        self.EffectIndexPlusOneValue = 0;
        self.HasBodyValue = false;
        self.BodyLoweringKindValue = HirFunctionBodyLoweringKind.Unknown;
        self.HasBodyTemplateValue = false;
        self.HasGenericTypeSubstitutionValue = false;
        self.HasGenericValueSubstitutionValue = false;
        self.BackendFactsValue = new();
    }

    public inline finite law u32[0 max] NameSymbol(borrow HighLevelIrFunction self)
    {
        return self.NameSymbolValue;
    }

    public inline finite law u32[0 max] SignatureIndexPlusOne(borrow HighLevelIrFunction self)
    {
        return self.SignatureIndexPlusOneValue;
    }

    public inline finite law u32[0 max] EffectIndexPlusOne(borrow HighLevelIrFunction self)
    {
        return self.EffectIndexPlusOneValue;
    }

    public inline finite law bool HasBody(borrow HighLevelIrFunction self)
    {
        return self.HasBodyValue;
    }

    public inline finite law HirFunctionBodyLoweringKind BodyLoweringKind(borrow HighLevelIrFunction self)
    {
        return self.BodyLoweringKindValue;
    }

    public inline finite law bool HasBodyTemplate(borrow HighLevelIrFunction self)
    {
        return self.HasBodyTemplateValue;
    }

    public inline finite law bool HasGenericTypeSubstitution(borrow HighLevelIrFunction self)
    {
        return self.HasGenericTypeSubstitutionValue;
    }

    public inline finite law bool HasGenericValueSubstitution(borrow HighLevelIrFunction self)
    {
        return self.HasGenericValueSubstitutionValue;
    }

    public inline finite law HirBackendFactSet BackendFacts(borrow HighLevelIrFunction self)
    {
        return self.BackendFactsValue;
    }

    public inline finite law bool HasAllMirLoweringFacts(borrow HighLevelIrFunction self)
    {
        return HirBackendFactsCoverMirLowering(self.BackendFactsValue);
    }
}

public inline finite law HighLevelIrFunction HighLevelIrFunctionOf(
    u32[0 max] nameSymbol,
    u32[0 max] signatureIndexPlusOne,
    u32[0 max] effectIndexPlusOne,
    bool hasBody,
    HirFunctionBodyLoweringKind bodyLoweringKind,
    bool hasBodyTemplate,
    bool hasGenericTypeSubstitution,
    bool hasGenericValueSubstitution,
    HirBackendFactSet backendFacts)
{
    return new HighLevelIrFunction()
    {
        NameSymbolValue = nameSymbol,
        SignatureIndexPlusOneValue = signatureIndexPlusOne,
        EffectIndexPlusOneValue = effectIndexPlusOne,
        HasBodyValue = hasBody,
        BodyLoweringKindValue = bodyLoweringKind,
        HasBodyTemplateValue = hasBodyTemplate,
        HasGenericTypeSubstitutionValue = hasGenericTypeSubstitution,
        HasGenericValueSubstitutionValue = hasGenericValueSubstitution,
        BackendFactsValue = backendFacts
    };
}

public struct HighLevelIrModule
{
    internal u32[0 max] ModuleNameSymbolValue;
    internal dynamic HighLevelIrGlobalDeclaration Globals;
    internal dynamic HighLevelIrFunction Functions;
    internal dynamic u32[0 max] AddressTakenFunctionSymbols;

    HighLevelIrModule()
    {
        self.ModuleNameSymbolValue = 0;
        self.Globals = new();
        self.Functions = new();
        self.AddressTakenFunctionSymbols = new();
    }

    public inline finite law u32[0 max] ModuleNameSymbol(borrow HighLevelIrModule self)
    {
        return self.ModuleNameSymbolValue;
    }

    public inline finite law u64[0 2 ** 63 - 1] FunctionCount(borrow HighLevelIrModule self)
    {
        return self.Functions.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] GlobalCount(borrow HighLevelIrModule self)
    {
        return self.Globals.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] AddressTakenFunctionCount(borrow HighLevelIrModule self)
    {
        return self.AddressTakenFunctionSymbols.Length;
    }

    public law HighLevelIrGlobalDeclaration GlobalAt(borrow HighLevelIrModule self, u64[0 2 ** 63 - 1] index)
    {
        if (index >= self.Globals.Length)
        {
            return new HighLevelIrGlobalDeclaration();
        }

        return self.Globals[index];
    }

    public law HighLevelIrFunction FunctionAt(borrow HighLevelIrModule self, u64[0 2 ** 63 - 1] index)
    {
        if (index >= self.Functions.Length)
        {
            return new HighLevelIrFunction();
        }

        return self.Functions[index];
    }

    public law u32[0 max] AddressTakenFunctionSymbolAt(
        borrow HighLevelIrModule self,
        u64[0 2 ** 63 - 1] index)
    {
        if (index >= self.AddressTakenFunctionSymbols.Length)
        {
            return 0;
        }

        return self.AddressTakenFunctionSymbols[index];
    }
}

public inline finite law HighLevelIrModule HighLevelIrModuleOf(u32[0 max] moduleNameSymbol)
{
    return new HighLevelIrModule()
    {
        ModuleNameSymbolValue = moduleNameSymbol
    };
}

public fn System.Memory.MemoryStatus AppendHighLevelIrGlobalDeclaration(
    mut borrow HighLevelIrModule hirModule,
    HighLevelIrGlobalDeclaration global)
{
    if (!hirModule.Globals.TryReserve(1))
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
    }

    init hirModule.Globals[hirModule.Globals.Length] = global;
    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus AppendHighLevelIrFunction(
    mut borrow HighLevelIrModule hirModule,
    HighLevelIrFunction function)
{
    if (!hirModule.Functions.TryReserve(1))
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
    }

    init hirModule.Functions[hirModule.Functions.Length] = function;
    return System.Memory.MemoryStatus.Ok;
}

public fn System.Memory.MemoryStatus AppendHighLevelIrAddressTakenFunction(
    mut borrow HighLevelIrModule hirModule,
    u32[0 max] functionNameSymbol)
{
    if (!hirModule.AddressTakenFunctionSymbols.TryReserve(1))
    {
        return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
    }

    init hirModule.AddressTakenFunctionSymbols[hirModule.AddressTakenFunctionSymbols.Length] = functionNameSymbol;
    return System.Memory.MemoryStatus.Ok;
}

