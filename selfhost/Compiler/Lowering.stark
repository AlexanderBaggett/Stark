internal finite law bool HighLevelIrArenaDynamicStorageByteLengthFitsI64(
    u32[0 max] capacity,
    u32[0 max] elementSizeBytes)
{
    stack u64[0 max] byteLength = (u64[0 max])capacity * (u64[0 max])elementSizeBytes;
    return byteLength <= 9223372036854775807;
}

internal finite law bool HighLevelIrArenaDynamicStorageInitShapeIsLowerable(
    HighLevelIrArenaDynamicStorageInit storageInit)
{
    return storageInit.CapacityValue != 0
        && storageInit.ElementSizeBytesValue != 0
        && HighLevelIrPowerOfTwo(storageInit.AlignmentBytesValue)
        && HighLevelIrArenaDynamicStorageByteLengthFitsI64(
            storageInit.CapacityValue,
            storageInit.ElementSizeBytesValue);
}

internal finite law bool HighLevelIrArenaDynamicStorageReserveKindReturnsValue(
    HighLevelIrArenaDynamicStorageReserveKind kind)
{
    return kind == HighLevelIrArenaDynamicStorageReserveKind.TryReserve
        || kind == HighLevelIrArenaDynamicStorageReserveKind.TryReserveCapacity;
}

internal finite law bool HighLevelIrArenaDynamicStorageReserveKindIsLowerable(
    HighLevelIrArenaDynamicStorageReserveKind kind)
{
    return kind == HighLevelIrArenaDynamicStorageReserveKind.Reserve
        || kind == HighLevelIrArenaDynamicStorageReserveKind.TryReserve
        || kind == HighLevelIrArenaDynamicStorageReserveKind.TryReserveCapacity;
}

internal finite law bool HighLevelIrArenaDynamicStorageReserveShapeIsLowerable(
    HighLevelIrArenaDynamicStorageReserve reserve)
{
    return HighLevelIrArenaDynamicStorageReserveKindIsLowerable(reserve.KindValue)
        && reserve.ElementSizeBytesValue != 0
        && HighLevelIrPowerOfTwo(reserve.AlignmentBytesValue);
}

internal finite law bool HighLevelIrArenaDynamicStorageOwnerFactsAreLowerable(ValueFacts facts)
{
    if (!HighLevelIrValueFactsFitType(MirType.Ptr, facts))
    {
        return false;
    }

    if (!facts.KnownNonNull() || !facts.HasAlignment())
    {
        return false;
    }

    stack u32[0 max] ownerAlignment = HighLevelIrArenaDynamicStorageOwnerAlignmentBytes();
    stack u32[0 max] actualAlignment = facts.AlignmentBytes();
    return actualAlignment >= ownerAlignment
        && (actualAlignment % ownerAlignment) == 0;
}

internal finite law bool HighLevelIrArenaDynamicStorageReserveMatchesOwner(
    HighLevelIrArenaDynamicStorageReserve reserve,
    MirInstruction owner)
{
    return owner.Opcode() == MirOp.ArenaDynamicStorageInit
        && owner.OperandAIndex() == reserve.ElementSizeBytesValue
        && owner.OperandBIndex() == reserve.AlignmentBytesValue;
}

