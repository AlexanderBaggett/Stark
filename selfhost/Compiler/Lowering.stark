    WrappingMul,
    SaturatingAdd,
    SaturatingSub,
    SaturatingMul,
    SDiv,
    UDiv,
    SRem,
    And,
    Or,
    Xor,
    Shl,
    AShr,
    CmpEq,
    CmpNe,
    CmpLt,
    CmpLe,
    CmpGt,
    CmpGe,
}

public finite law ascii HirMirBoundaryKindName(HirMirBoundaryKind kind)
{
    switch (kind)
    {
        case HirMirBoundaryKind.Unknown:
            return "";
        case HirMirBoundaryKind.HighLevelIrToMidLevelIr:
            return "high-level-ir-to-mid-level-ir";
    }
}

