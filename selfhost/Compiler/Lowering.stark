internal finite law bool HighLevelIrParameterTypeIsLowerable(HighLevelIrParameter parameter)
{
    switch (parameter.TypeValue)
    {
        case MirType.I1:
            return true;
        case MirType.I8:
            return true;
        case MirType.I16:
            return true;
        case MirType.I32:
            return true;
        case MirType.I64:
            return true;
        case MirType.Ptr:
            return true;
        case MirType.EnumValue:
            return false;
    }
}

internal finite law bool HighLevelIrMirTypeIsLowerable(MirType type)
{
    switch (type)
    {
        case MirType.I1:
            return true;
        case MirType.I8:
            return true;
        case MirType.I16:
            return true;
        case MirType.I32:
            return true;
        case MirType.I64:
            return true;
        case MirType.Ptr:
            return true;
        case MirType.EnumValue:
            return false;
    }
}

internal finite law bool HighLevelIrTypeAllowsNullabilityFacts(MirType type)
{
    switch (type)
    {
        case MirType.I1:
            return false;
        case MirType.I8:
            return false;
        case MirType.I16:
            return false;
        case MirType.I32:
            return false;
        case MirType.I64:
            return false;
        case MirType.Ptr:
            return true;
        case MirType.EnumValue:
            return false;
    }
}

internal finite law bool HighLevelIrValueFactsFitType(MirType type, ValueFacts facts)
{
    if (facts.HasNullability() && !HighLevelIrTypeAllowsNullabilityFacts(type))
    {
        return false;
    }

    if (!facts.HasIntegerRange())
    {
        return true;
    }

    stack i64[min max] lower = facts.IntegerRangeLower();
    stack i64[min max] upperExclusive = facts.IntegerRangeUpperExclusive();
    switch (type)
    {
        case MirType.I1:
            return lower >= 0 && upperExclusive > lower && upperExclusive <= 2;
        case MirType.I8:
            return upperExclusive != LoweringI64MinValue()
                && lower >= LoweringI8MinValue()
                && upperExclusive > lower
                && upperExclusive <= 128;
        case MirType.I16:
            return upperExclusive != LoweringI64MinValue()
                && lower >= LoweringI16MinValue()
                && upperExclusive > lower
                && upperExclusive <= 32768;
        case MirType.I32:
            return upperExclusive != LoweringI64MinValue()
                && lower >= LoweringI32MinValue()
                && upperExclusive > lower
                && upperExclusive <= 2147483648;
        case MirType.I64:
            return true;
        case MirType.Ptr:
            return false;
        case MirType.EnumValue:
            return false;
    }
}

internal finite law bool HighLevelIrValueFactsSubsetOf(ValueFacts actual, ValueFacts expected)
{
    if (expected.HasAlignment())
    {
        if (!actual.HasAlignment())
        {
            return false;
        }

        stack u32[0 max] expectedAlignment = expected.AlignmentBytes();
        stack u32[0 max] actualAlignment = actual.AlignmentBytes();
        if (expectedAlignment != 0
            && (actualAlignment < expectedAlignment || (actualAlignment % expectedAlignment) != 0))
        {
            return false;
        }
    }

    if (expected.HasCallingAbi()
        && (!actual.HasCallingAbi() || actual.CallingAbi() != expected.CallingAbi()))
    {
        return false;
    }

    if (expected.HasNoAlias() && !actual.HasNoAlias())
    {
        return false;
    }

    if (expected.Volatile() && !actual.Volatile())
    {
        return false;
    }

    if (expected.KnownNull() && !actual.KnownNull())
    {
        return false;
    }

    if (expected.KnownNonNull() && !actual.KnownNonNull())
    {
        return false;
    }

    if (!expected.HasIntegerRange())
    {
        return true;
    }

    if (!actual.HasIntegerRange())
    {
        return false;
    }

    stack i64[min max] expectedUpperExclusive = expected.IntegerRangeUpperExclusive();
    if (expectedUpperExclusive == LoweringI64MinValue())
    {
        return actual.IntegerRangeLower() >= expected.IntegerRangeLower();
    }

    if (actual.IntegerRangeUpperExclusive() == LoweringI64MinValue())
    {
        return false;
    }

    return actual.IntegerRangeLower() >= expected.IntegerRangeLower()
        && actual.IntegerRangeUpperExclusive() <= expectedUpperExclusive;
}

internal finite law bool HighLevelIrGlobalTypeIsLowerable(MirType type)
{
    return HighLevelIrMirTypeIsLowerable(type);
}

internal finite law bool HighLevelIrGlobalInitializerFitsType(MirType type, i64[min max] value)
{
    switch (type)
    {
        case MirType.I1:
            return value == 0 || value == 1;
        case MirType.I8:
            return value >= LoweringI8MinValue()
                && value <= LoweringI8MaxValue();
        case MirType.I16:
            return value >= LoweringI16MinValue()
                && value <= LoweringI16MaxValue();
        case MirType.I32:
            return value >= LoweringI32MinValue()
                && value <= LoweringI32MaxValue();
        case MirType.I64:
            return true;
        case MirType.Ptr:
            return true;
        case MirType.EnumValue:
            return false;
    }
}

internal finite law bool HighLevelIrGlobalInitializerSatisfiesFacts(
    MirType type,
    i64[min max] value,
    ValueFacts facts)
{
    if (!HighLevelIrValueFactsFitType(type, facts))
    {
        return false;
    }

    if (facts.HasIntegerRange())
    {
        stack i64[min max] upperExclusive = facts.IntegerRangeUpperExclusive();
        if (upperExclusive == LoweringI64MinValue())
        {
            if (value < facts.IntegerRangeLower())
            {
                return false;
            }
        }
        else if (value < facts.IntegerRangeLower() || value >= upperExclusive)
        {
            return false;
        }
    }

    if (facts.KnownNull() && value != 0)
    {
        return false;
    }

    if (facts.KnownNonNull() && value == 0)
    {
        return false;
    }

    return true;
}

