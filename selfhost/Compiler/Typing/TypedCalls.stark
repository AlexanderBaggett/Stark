module Compiler.Typing.TypedCalls

internal finite law bool TypedCallOperatorYieldsBool(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.EqEq:
            return true;
        case TokenKind.Neq:
            return true;
        case TokenKind.Lt:
            return true;
        case TokenKind.Gt:
            return true;
        case TokenKind.Lte:
            return true;
        case TokenKind.Gte:
            return true;
        case TokenKind.AndAnd:
            return true;
        case TokenKind.OrOr:
            return true;
        default:
            return false;
    }
}

internal finite law TypedIdentifierContext TypedCallIdentifierContext(TypedCallContext context)
{
    if (context == TypedCallContext.GlobalInitializer)
    {
        return TypedIdentifierContext.GlobalInitializer;
    }

    if (context == TypedCallContext.FunctionBody)
    {
        return TypedIdentifierContext.FunctionBody;
    }

    return TypedIdentifierContext.Unknown;
}

internal fn u32[0 max] TypedCallIdentifierIndexForNode(
    borrow TypedIdentifierExpressionTable identifiers,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] calleeNode)
{
    stack TypedIdentifierContext identifierContext = TypedCallIdentifierContext(context);
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = identifiers.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && identifiers.ContextAt(index) == identifierContext
            && identifiers.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && identifiers.OwnerNameTokenAt(index) == ownerNameToken
            && identifiers.FunctionNameTokenAt(index) == functionNameToken
            && identifiers.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && identifiers.ExprNodeAt(index) == calleeNode)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn void TypedCallSignatureSlotFacts(
    borrow TypedFunctionSignatureTable signatures,
    u32[0 max] slotIndexPlusOne,
    out TypedSignatureTypeKind typeKind,
    out u32[0 max] typeHeadToken,
    out u32[0 max] typePrimaryToken,
    out u32[0 max] typeStartToken,
    out u32[0 max] typeEndToken,
    out u32[0 max] rangeStartToken,
    out u32[0 max] rangeEndToken,
    out u32[0 max] elementCountStartToken,
    out u32[0 max] elementCountEndToken,
    out u32[0 max] bitWidth,
    out u32[0 max] typeArgumentCount,
    out u32[0 max] comptimeArgumentCount,
    out u32[0 max] typeFlags)
{
    typeKind = TypedSignatureTypeKind.Unknown;
    typeHeadToken = 0;
    typePrimaryToken = 0;
    typeStartToken = 0;
    typeEndToken = 0;
    rangeStartToken = 0;
    rangeEndToken = 0;
    elementCountStartToken = 0;
    elementCountEndToken = 0;
    bitWidth = 0;
    typeArgumentCount = 0;
    comptimeArgumentCount = 0;
    typeFlags = 0;
    if (slotIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(slotIndexPlusOne - 1);
    typeKind = signatures.TypeKindAt(slot);
    typeHeadToken = signatures.TypeHeadTokenAt(slot);
    typePrimaryToken = signatures.TypePrimaryTokenAt(slot);
    typeStartToken = signatures.TypeStartTokenAt(slot);
    typeEndToken = signatures.TypeEndTokenAt(slot);
    rangeStartToken = signatures.RangeStartTokenAt(slot);
    rangeEndToken = signatures.RangeEndTokenAt(slot);
    elementCountStartToken = signatures.ElementCountStartTokenAt(slot);
    elementCountEndToken = signatures.ElementCountEndTokenAt(slot);
    bitWidth = signatures.BitWidthAt(slot);
    typeArgumentCount = signatures.TypeArgumentCountAt(slot);
    comptimeArgumentCount = signatures.ComptimeArgumentCountAt(slot);
    typeFlags = signatures.TypeFlagsAt(slot);
}

internal fn bool TypedCallFindCallableParamList(
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    out u32[0 max] lparen,
    out u32[0 max] rparen)
{
    lparen = 0;
    rparen = 0;
    if (typeStartToken == 0 || typeEndToken <= typeStartToken)
    {
        return false;
    }

    stack u32[0 max] typeHeadToken = TypedGlobalTypeHeadToken(stream, typeStartToken, typeEndToken);
    stack u32[0 max] primaryToken = TypedSignatureSemanticPrimaryToken(stream, typeStartToken, typeEndToken, typeHeadToken);
    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])primaryToken);
    if (primaryKind != TokenKind.Fnptr && primaryKind != TokenKind.Closure)
    {
        return false;
    }

    stack u32[0 max] openToken = (u32[0 max])(primaryToken + 1);
    if (stream.KindAt((u64[0 2 ** 63 - 1])openToken) != TokenKind.Lt)
    {
        return false;
    }

    stack u32[0 max] closeToken = TypedSignatureMatchingCloseToken(stream, openToken);
    if (closeToken <= openToken || closeToken > typeEndToken)
    {
        return false;
    }

    stack mut bool sawFunctionKind = false;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(openToken + 1);
    while willexit (scan < closeToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0)
        {
            if (TypedSignatureTokenCanStartCallableFunctionKind(kind))
            {
                sawFunctionKind = true;
            }
            else if (sawFunctionKind && kind == TokenKind.LParen)
            {
                lparen = scan;
                rparen = TypedSignatureMatchingCloseToken(stream, scan);
                return rparen > lparen && rparen < closeToken;
            }
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u32[0 max] TypedCallCallableParamCount(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] rparen)
{
    if ((u32[0 max])(lparen + 1) >= rparen)
    {
        return 0;
    }

    stack mut u32[0 max] count = 1;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan < rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Comma && depth == 0)
        {
            count = (u32[0 max])(count + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

internal fn bool TypedCallCallableParamSpan(
    borrow TokenStream stream,
    u32[0 max] lparen,
    u32[0 max] rparen,
    u32[0 max] argIndex,
    out u32[0 max] start,
    out u32[0 max] endExclusive)
{
    start = 0;
    endExclusive = 0;
    stack mut u32[0 max] currentIndex = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(lparen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan <= rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (scan == rparen || (kind == TokenKind.Comma && depth == 0))
        {
            if (currentIndex == argIndex)
            {
                start = segmentStart;
                endExclusive = scan;
                return segmentStart < scan;
            }

            currentIndex = (u32[0 max])(currentIndex + 1);
            segmentStart = (u32[0 max])(scan + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u32[0 max] TypedCallCallableReturnStart(borrow TokenStream stream, u32[0 max] typeStartToken, u32[0 max] lparen)
{
    stack mut u32[0 max] lastKindToken = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = typeStartToken;
    while willexit (scan < lparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 1 && TypedSignatureTokenCanStartCallableFunctionKind(kind))
        {
            lastKindToken = scan;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    if (lastKindToken != 0)
    {
        return (u32[0 max])(lastKindToken + 1);
    }

    return 0;
}

internal fn void TypedCallTypeSpanFacts(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    out TypedSignatureTypeKind typeKind,
    out u32[0 max] typeHeadToken,
    out u32[0 max] typePrimaryToken,
    out u32[0 max] rangeStartToken,
    out u32[0 max] rangeEndToken,
    out u32[0 max] elementCountStartToken,
    out u32[0 max] elementCountEndToken,
    out u32[0 max] bitWidth,
    out u32[0 max] typeArgumentCount,
    out u32[0 max] comptimeArgumentCount,
    out u32[0 max] typeFlags)
{
    typeKind = TypedSignatureTypeKind.Unknown;
    typeHeadToken = 0;
    typePrimaryToken = 0;
    rangeStartToken = 0;
    rangeEndToken = 0;
    elementCountStartToken = 0;
    elementCountEndToken = 0;
    bitWidth = 0;
    typeArgumentCount = 0;
    comptimeArgumentCount = 0;
    typeFlags = 0;
    if (typeStartToken == 0 || typeEndToken <= typeStartToken)
    {
        return;
    }

    stack mut u32[0 max] computedRangeStartToken = 0;
    stack mut u32[0 max] computedRangeEndToken = 0;
    stack mut u32[0 max] computedElementCountStartToken = 0;
    stack mut u32[0 max] computedElementCountEndToken = 0;
    stack mut TypedSignatureTypeKind arrayKind = TypedSignatureTypeKind.Unknown;
    TypedSignatureScanTopLevelTypeFacts(
        stream,
        typeStartToken,
        typeEndToken,
        computedRangeStartToken,
        computedRangeEndToken,
        computedElementCountStartToken,
        computedElementCountEndToken,
        arrayKind);

    stack u32[0 max] computedTypeHeadToken = TypedGlobalTypeHeadToken(stream, typeStartToken, typeEndToken);
    stack u32[0 max] computedTypePrimaryToken = TypedSignatureSemanticPrimaryToken(stream, typeStartToken, typeEndToken, computedTypeHeadToken);
    stack TypedSignatureTypeKind computedTypeKind = TypedSignatureKindForType(source, stream, computedTypePrimaryToken, computedTypeHeadToken, 0, 0, arrayKind);

    stack mut u32[0 max] computedBitWidth = 0;
    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])computedTypePrimaryToken);
    if (primaryKind == TokenKind.IntegerType)
    {
        computedBitWidth = TypedSignatureIntegerBitWidth(source, stream, computedTypePrimaryToken);
    }
    else if (primaryKind == TokenKind.FloatType)
    {
        computedBitWidth = TypedSignatureFloatBitWidth(source, stream, computedTypePrimaryToken);
    }

    stack mut u32[0 max] computedTypeArgumentCount = 0;
    stack mut u32[0 max] computedComptimeArgumentCount = 0;
    if (computedTypeHeadToken != 0 && stream.KindAt((u64[0 2 ** 63 - 1])(computedTypeHeadToken + 1)) == TokenKind.Lt)
    {
        TypedSignatureCountGenericArgumentsInList(stream, (u32[0 max])(computedTypeHeadToken + 1), computedTypeArgumentCount, computedComptimeArgumentCount);
    }

    stack u32[0 max] computedTypeFlags = TypedSignatureFlagsForType(
        source,
        stream,
        computedTypePrimaryToken,
        computedTypeHeadToken,
        typeStartToken,
        typeEndToken,
        0,
        0,
        computedRangeStartToken,
        computedRangeEndToken,
        computedElementCountStartToken,
        TypedSignatureTypeSpanContainsTailCallableSignature(stream, typeStartToken, typeEndToken),
        0,
        TypedSignatureTypeSpanContainsDeadOnReturnContract(stream, typeStartToken, typeEndToken));

    typeKind = computedTypeKind;
    typeHeadToken = computedTypeHeadToken;
    typePrimaryToken = computedTypePrimaryToken;
    rangeStartToken = computedRangeStartToken;
    rangeEndToken = computedRangeEndToken;
    elementCountStartToken = computedElementCountStartToken;
    elementCountEndToken = computedElementCountEndToken;
    bitWidth = computedBitWidth;
    typeArgumentCount = computedTypeArgumentCount;
    comptimeArgumentCount = computedComptimeArgumentCount;
    typeFlags = computedTypeFlags;
}

internal fn void TypedCallCallableReturnFacts(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    out u32[0 max] parameterCount,
    out TypedSignatureTypeKind returnTypeKind,
    out u32[0 max] returnTypeHeadToken,
    out u32[0 max] returnTypePrimaryToken,
    out u32[0 max] returnTypeStartToken,
    out u32[0 max] returnTypeEndToken,
    out u32[0 max] returnRangeStartToken,
    out u32[0 max] returnRangeEndToken,
    out u32[0 max] returnElementCountStartToken,
    out u32[0 max] returnElementCountEndToken,
    out u32[0 max] returnBitWidth,
    out u32[0 max] returnTypeArgumentCount,
    out u32[0 max] returnComptimeArgumentCount,
    out u32[0 max] returnTypeFlags)
{
    parameterCount = 0;
    returnTypeKind = TypedSignatureTypeKind.Unknown;
    returnTypeHeadToken = 0;
    returnTypePrimaryToken = 0;
    returnTypeStartToken = 0;
    returnTypeEndToken = 0;
    returnRangeStartToken = 0;
    returnRangeEndToken = 0;
    returnElementCountStartToken = 0;
    returnElementCountEndToken = 0;
    returnBitWidth = 0;
    returnTypeArgumentCount = 0;
    returnComptimeArgumentCount = 0;
    returnTypeFlags = 0;

    stack mut u32[0 max] lparen = 0;
    stack mut u32[0 max] rparen = 0;
    if (!TypedCallFindCallableParamList(stream, typeStartToken, typeEndToken, lparen, rparen))
    {
        return;
    }

    stack u32[0 max] computedReturnTypeStartToken = TypedCallCallableReturnStart(stream, typeStartToken, lparen);
    stack u32[0 max] computedReturnTypeEndToken = lparen;
    TypedCallTypeSpanFacts(
        source,
        stream,
        computedReturnTypeStartToken,
        computedReturnTypeEndToken,
        returnTypeKind,
        returnTypeHeadToken,
        returnTypePrimaryToken,
        returnRangeStartToken,
        returnRangeEndToken,
        returnElementCountStartToken,
        returnElementCountEndToken,
        returnBitWidth,
        returnTypeArgumentCount,
        returnComptimeArgumentCount,
        returnTypeFlags);
    parameterCount = TypedCallCallableParamCount(stream, lparen, rparen);
    returnTypeStartToken = computedReturnTypeStartToken;
    returnTypeEndToken = computedReturnTypeEndToken;
}

internal fn void TypedCallCallableParameterFacts(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    u32[0 max] ordinal,
    out TypedSignatureTypeKind expectedTypeKind,
    out u32[0 max] expectedTypeHeadToken,
    out u32[0 max] expectedTypePrimaryToken,
    out u32[0 max] expectedTypeStartToken,
    out u32[0 max] expectedTypeEndToken,
    out u32[0 max] expectedRangeStartToken,
    out u32[0 max] expectedRangeEndToken,
    out u32[0 max] expectedElementCountStartToken,
    out u32[0 max] expectedElementCountEndToken,
    out u32[0 max] expectedBitWidth,
    out u32[0 max] expectedTypeArgumentCount,
    out u32[0 max] expectedComptimeArgumentCount,
    out u32[0 max] expectedTypeFlags)
{
    expectedTypeKind = TypedSignatureTypeKind.Unknown;
    expectedTypeHeadToken = 0;
    expectedTypePrimaryToken = 0;
    expectedTypeStartToken = 0;
    expectedTypeEndToken = 0;
    expectedRangeStartToken = 0;
    expectedRangeEndToken = 0;
    expectedElementCountStartToken = 0;
    expectedElementCountEndToken = 0;
    expectedBitWidth = 0;
    expectedTypeArgumentCount = 0;
    expectedComptimeArgumentCount = 0;
    expectedTypeFlags = 0;

    stack mut u32[0 max] lparen = 0;
    stack mut u32[0 max] rparen = 0;
    if (!TypedCallFindCallableParamList(stream, typeStartToken, typeEndToken, lparen, rparen))
    {
        return;
    }

    stack mut u32[0 max] computedExpectedTypeStartToken = 0;
    stack mut u32[0 max] computedExpectedTypeEndToken = 0;
    if (!TypedCallCallableParamSpan(stream, lparen, rparen, ordinal, computedExpectedTypeStartToken, computedExpectedTypeEndToken))
    {
        return;
    }

    TypedCallTypeSpanFacts(
        source,
        stream,
        computedExpectedTypeStartToken,
        computedExpectedTypeEndToken,
        expectedTypeKind,
        expectedTypeHeadToken,
        expectedTypePrimaryToken,
        expectedRangeStartToken,
        expectedRangeEndToken,
        expectedElementCountStartToken,
        expectedElementCountEndToken,
        expectedBitWidth,
        expectedTypeArgumentCount,
        expectedComptimeArgumentCount,
        expectedTypeFlags);
    expectedTypeStartToken = computedExpectedTypeStartToken;
    expectedTypeEndToken = computedExpectedTypeEndToken;
}

internal finite law TypedLiteralContext TypedCallLiteralContext(TypedCallContext context)
{
    if (context == TypedCallContext.GlobalInitializer)
    {
        return TypedLiteralContext.GlobalInitializer;
    }

    if (context == TypedCallContext.FunctionBody)
    {
        return TypedLiteralContext.FunctionBody;
    }

    return TypedLiteralContext.Unknown;
}

internal fn u32[0 max] TypedCallLiteralIndexForNode(
    borrow TypedLiteralExpressionTable literals,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node)
{
    stack TypedLiteralContext literalContext = TypedCallLiteralContext(context);
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = literals.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && literals.ContextAt(index) == literalContext
            && literals.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && literals.OwnerNameTokenAt(index) == ownerNameToken
            && literals.FunctionNameTokenAt(index) == functionNameToken
            && literals.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && literals.ExprNodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn u32[0 max] TypedCallPriorCallIndexForNode(
    borrow TypedCallExpressionTable calls,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node)
{
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = calls.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && calls.ContextAt(index) == context
            && calls.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && calls.OwnerNameTokenAt(index) == ownerNameToken
            && calls.FunctionNameTokenAt(index) == functionNameToken
            && calls.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && calls.CallNodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal finite law TypedMemberContext TypedCallMemberContext(TypedCallContext context)
{
    if (context == TypedCallContext.GlobalInitializer)
    {
        return TypedMemberContext.GlobalInitializer;
    }

    if (context == TypedCallContext.FunctionBody)
    {
        return TypedMemberContext.FunctionBody;
    }

    return TypedMemberContext.Unknown;
}

internal fn u32[0 max] TypedCallMemberIndexForNode(
    borrow TypedMemberExpressionTable members,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node)
{
    stack TypedMemberContext memberContext = TypedCallMemberContext(context);
    stack mut u32[0 max] found = 0;
    stack u64[0 2 ** 63 - 1] count = members.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (found == 0
            && members.ContextAt(index) == memberContext
            && members.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && members.OwnerNameTokenAt(index) == ownerNameToken
            && members.FunctionNameTokenAt(index) == functionNameToken
            && members.StatementIndexPlusOneAt(index) == statementIndexPlusOne
            && members.MemberNodeAt(index) == node)
        {
            found = (u32[0 max])(index + 1);
        }
    }

    return found;
}

internal fn void TypedCallFactsFromSignatureSlot(
    borrow TypedFunctionSignatureTable signatures,
    u32[0 max] slotIndexPlusOne,
    mut borrow TypedCallTypeFacts facts)
{
    stack mut TypedSignatureTypeKind typeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] typeHeadToken = 0;
    stack mut u32[0 max] typePrimaryToken = 0;
    stack mut u32[0 max] typeStartToken = 0;
    stack mut u32[0 max] typeEndToken = 0;
    stack mut u32[0 max] rangeStartToken = 0;
    stack mut u32[0 max] rangeEndToken = 0;
    stack mut u32[0 max] elementCountStartToken = 0;
    stack mut u32[0 max] elementCountEndToken = 0;
    stack mut u32[0 max] bitWidth = 0;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    stack mut u32[0 max] typeFlags = 0;
    TypedCallSignatureSlotFacts(
        signatures,
        slotIndexPlusOne,
        typeKind,
        typeHeadToken,
        typePrimaryToken,
        typeStartToken,
        typeEndToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        elementCountEndToken,
        bitWidth,
        typeArgumentCount,
        comptimeArgumentCount,
        typeFlags);
    facts.TypeKind = typeKind;
    facts.TypeHeadToken = typeHeadToken;
    facts.TypePrimaryToken = typePrimaryToken;
    facts.TypeStartToken = typeStartToken;
    facts.TypeEndToken = typeEndToken;
    facts.RangeStartToken = rangeStartToken;
    facts.RangeEndToken = rangeEndToken;
    facts.ElementCountStartToken = elementCountStartToken;
    facts.ElementCountEndToken = elementCountEndToken;
    facts.BitWidth = bitWidth;
    facts.TypeArgumentCount = typeArgumentCount;
    facts.ComptimeArgumentCount = comptimeArgumentCount;
    facts.TypeFlags = typeFlags;
}

internal fn void TypedCallFactsFromLiteral(
    borrow TypedLiteralExpressionTable literals,
    u32[0 max] literalIndexPlusOne,
    mut borrow TypedCallTypeFacts facts)
{
    if (literalIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(literalIndexPlusOne - 1);
    facts.TypeKind = literals.TypeKindAt(index);
    facts.TypePrimaryToken = literals.LiteralTokenAt(index);
    facts.TypeStartToken = literals.LiteralTokenAt(index);
    facts.TypeEndToken = (u32[0 max])(literals.LiteralTokenAt(index) + 1);
    facts.BitWidth = literals.BitWidthAt(index);
    facts.TypeFlags = literals.TypeFlagsAt(index);
    facts.IsCompileTimeInteger = literals.IsCompileTimeIntegerAt(index);
    facts.IsNullLiteral = literals.LiteralKindAt(index) == TypedLiteralKind.Null;
}

internal fn void TypedCallFactsFromIdentifier(
    borrow TypedIdentifierExpressionTable identifiers,
    u32[0 max] identifierIndexPlusOne,
    mut borrow TypedCallTypeFacts facts)
{
    if (identifierIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(identifierIndexPlusOne - 1);
    facts.TypeKind = identifiers.TypeKindAt(index);
    facts.TypeHeadToken = identifiers.TypeHeadTokenAt(index);
    facts.TypePrimaryToken = identifiers.TypePrimaryTokenAt(index);
    facts.TypeStartToken = identifiers.TypeStartTokenAt(index);
    facts.TypeEndToken = identifiers.TypeEndTokenAt(index);
    facts.RangeStartToken = identifiers.RangeStartTokenAt(index);
    facts.RangeEndToken = identifiers.RangeEndTokenAt(index);
    facts.ElementCountStartToken = identifiers.ElementCountStartTokenAt(index);
    facts.ElementCountEndToken = identifiers.ElementCountEndTokenAt(index);
    facts.BitWidth = identifiers.BitWidthAt(index);
    facts.TypeArgumentCount = identifiers.TypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = identifiers.ComptimeArgumentCountAt(index);
    facts.TypeFlags = identifiers.TypeFlagsAt(index);
}

internal fn void TypedCallFactsFromCallReturn(
    borrow TypedCallExpressionTable calls,
    u32[0 max] callIndexPlusOne,
    mut borrow TypedCallTypeFacts facts)
{
    if (callIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(callIndexPlusOne - 1);
    facts.TypeKind = calls.ReturnTypeKindAt(index);
    facts.TypeHeadToken = calls.ReturnTypeHeadTokenAt(index);
    facts.TypePrimaryToken = calls.ReturnTypePrimaryTokenAt(index);
    facts.TypeStartToken = calls.ReturnTypeStartTokenAt(index);
    facts.TypeEndToken = calls.ReturnTypeEndTokenAt(index);
    facts.RangeStartToken = calls.ReturnRangeStartTokenAt(index);
    facts.RangeEndToken = calls.ReturnRangeEndTokenAt(index);
    facts.ElementCountStartToken = calls.ReturnElementCountStartTokenAt(index);
    facts.ElementCountEndToken = calls.ReturnElementCountEndTokenAt(index);
    facts.BitWidth = calls.ReturnBitWidthAt(index);
    facts.TypeArgumentCount = calls.ReturnTypeArgumentCountAt(index);
    facts.ComptimeArgumentCount = calls.ReturnComptimeArgumentCountAt(index);
    facts.TypeFlags = calls.ReturnTypeFlagsAt(index);
}

internal fn void TypedCallFactsFromTypeSpan(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    mut borrow TypedCallTypeFacts facts)
{
    if (typeStartToken == 0 || typeEndToken <= typeStartToken)
    {
        return;
    }

    TypedCallTypeSpanFacts(
        source,
        stream,
        typeStartToken,
        typeEndToken,
        facts.TypeKind,
        facts.TypeHeadToken,
        facts.TypePrimaryToken,
        facts.RangeStartToken,
        facts.RangeEndToken,
        facts.ElementCountStartToken,
        facts.ElementCountEndToken,
        facts.BitWidth,
        facts.TypeArgumentCount,
        facts.ComptimeArgumentCount,
        facts.TypeFlags);
    facts.TypeStartToken = typeStartToken;
    facts.TypeEndToken = typeEndToken;
}

internal fn void TypedCallFactsFromNewTypeToken(u32[0 max] typeNameToken, mut borrow TypedCallTypeFacts facts)
{
    if (typeNameToken == 0)
    {
        return;
    }

    facts.TypeKind = TypedSignatureTypeKind.Named;
    facts.TypeHeadToken = typeNameToken;
    facts.TypePrimaryToken = typeNameToken;
    facts.TypeStartToken = typeNameToken;
    facts.TypeEndToken = (u32[0 max])(typeNameToken + 1);
}

internal fn void TypedCallBoolFacts(u32[0 max] token, mut borrow TypedCallTypeFacts facts)
{
    facts.TypeKind = TypedSignatureTypeKind.Bool;
    facts.TypePrimaryToken = token;
    facts.TypeStartToken = token;
    facts.TypeEndToken = (u32[0 max])(token + 1);
}

internal fn void TypedCallArgumentFactsFromTreeNode(
    ascii source,
    borrow TokenStream stream,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow ExprTree tree,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node,
    mut borrow TypedCallTypeFacts facts)
{
    stack mut u32[0 max] current = node;
    stack mut u32[0 max] fallback = 0;
    stack mut u64[0 2 ** 63 - 1] guard = (u64[0 2 ** 63 - 1])(tree.Count() + 1);
    while willexit (guard > 0 && current != 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack ExprKind kind = tree.NodeKindAt(current);
        if (kind == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] identifierIndexPlusOne = TypedCallIdentifierIndexForNode(
                identifiers,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromIdentifier(identifiers, identifierIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] callIndexPlusOne = TypedCallPriorCallIndexForNode(
                calls,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromCallReturn(calls, callIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Conversion)
        {
            TypedCallFactsFromTypeSpan(source, stream, (u32[0 max])(tree.TokenAt(current) + 1), tree.AuxAt(current), facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.New)
        {
            stack u32[0 max] typeNode = tree.LeftAt(current);
            if (typeNode != 0 && tree.NodeKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
            {
                TypedCallFactsFromNewTypeToken(tree.TokenAt(typeNode), facts);
            }

            return;
        }

        if (TypedLiteralExprKindIsLiteral(kind))
        {
            stack u32[0 max] literalIndexPlusOne = TypedCallLiteralIndexForNode(
                literals,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromLiteral(literals, literalIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Binary)
        {
            stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])tree.TokenAt(current));
            if (TypedCallOperatorYieldsBool(op))
            {
                TypedCallBoolFacts(tree.TokenAt(current), facts);
                return;
            }

            fallback = tree.RightAt(current);
            current = tree.LeftAt(current);
        }
        else if (kind == Compiler.Parsing.ExprKind.Unary)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])tree.TokenAt(current)) == TokenKind.Bang)
            {
                TypedCallBoolFacts(tree.TokenAt(current), facts);
                return;
            }

            current = tree.LeftAt(current);
        }
        else if (kind == Compiler.Parsing.ExprKind.Conditional || kind == Compiler.Parsing.ExprKind.Assign)
        {
            current = tree.RightAt(current);
        }
        else if (fallback != 0)
        {
            current = fallback;
            fallback = 0;
        }
        else
        {
            current = 0;
        }
    }
}

internal fn void TypedCallArgumentFactsFromBodyNode(
    ascii source,
    borrow TokenStream stream,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow StatementList body,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] node,
    mut borrow TypedCallTypeFacts facts)
{
    stack mut u32[0 max] current = node;
    stack mut u32[0 max] fallback = 0;
    stack mut u64[0 2 ** 63 - 1] guard = (u64[0 2 ** 63 - 1])(body.ExprNodeCount() + 1);
    while willexit (guard > 0 && current != 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack ExprKind kind = body.ExprKindAt(current);
        if (kind == Compiler.Parsing.ExprKind.Identifier)
        {
            stack u32[0 max] identifierIndexPlusOne = TypedCallIdentifierIndexForNode(
                identifiers,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromIdentifier(identifiers, identifierIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] callIndexPlusOne = TypedCallPriorCallIndexForNode(
                calls,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromCallReturn(calls, callIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Conversion)
        {
            TypedCallFactsFromTypeSpan(source, stream, (u32[0 max])(body.ExprTokenAt(current) + 1), body.ExprAuxAt(current), facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.New)
        {
            stack u32[0 max] typeNode = body.ExprLeftAt(current);
            if (typeNode != 0 && body.ExprKindAt(typeNode) == Compiler.Parsing.ExprKind.Identifier)
            {
                TypedCallFactsFromNewTypeToken(body.ExprTokenAt(typeNode), facts);
            }

            return;
        }

        if (TypedLiteralExprKindIsLiteral(kind))
        {
            stack u32[0 max] literalIndexPlusOne = TypedCallLiteralIndexForNode(
                literals,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                current);
            TypedCallFactsFromLiteral(literals, literalIndexPlusOne, facts);
            return;
        }

        if (kind == Compiler.Parsing.ExprKind.Binary)
        {
            stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(current));
            if (TypedCallOperatorYieldsBool(op))
            {
                TypedCallBoolFacts(body.ExprTokenAt(current), facts);
                return;
            }

            fallback = body.ExprRightAt(current);
            current = body.ExprLeftAt(current);
        }
        else if (kind == Compiler.Parsing.ExprKind.Unary)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])body.ExprTokenAt(current)) == TokenKind.Bang)
            {
                TypedCallBoolFacts(body.ExprTokenAt(current), facts);
                return;
            }

            current = body.ExprLeftAt(current);
        }
        else if (kind == Compiler.Parsing.ExprKind.Conditional || kind == Compiler.Parsing.ExprKind.Assign)
        {
            current = body.ExprRightAt(current);
        }
        else if (fallback != 0)
        {
            current = fallback;
            fallback = 0;
        }
        else
        {
            current = 0;
        }
    }
}

internal fn bool TypedCallOwnerTokenEquals(ascii source, borrow TokenStream stream, u32[0 max] left, u32[0 max] right)
{
    if (left == 0 || right == 0)
    {
        return left == right;
    }

    return TypedSignatureTokenTextEqualsToken(source, stream, left, right);
}

internal fn bool TypedCallSignatureMatchesOverloadBase(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    u32[0 max] baseSignatureIndexPlusOne,
    u64[0 2 ** 63 - 1] candidateIndex)
{
    if (baseSignatureIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] baseIndex = (u64[0 2 ** 63 - 1])(baseSignatureIndexPlusOne - 1);
    return signatures.OwnerKindAt(candidateIndex) == signatures.OwnerKindAt(baseIndex)
        && TypedCallOwnerTokenEquals(source, stream, signatures.OwnerNameTokenAt(candidateIndex), signatures.OwnerNameTokenAt(baseIndex))
        && TypedSignatureTokenTextEqualsToken(source, stream, signatures.NameTokenAt(candidateIndex), signatures.NameTokenAt(baseIndex));
}

internal fn bool TypedCallCandidateScoreFromTree(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow ExprTree tree,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u64[0 2 ** 63 - 1] signatureIndex,
    u32[0 max] parameterOffset,
    out u32[0 max] score)
{
    score = 0;
    stack u32[0 max] argumentCount = tree.CallArgCount(callNode);
    if (signatures.ParamCountAt(signatureIndex) != (u32[0 max])(argumentCount + parameterOffset))
    {
        return false;
    }

    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack mut TypedCallTypeFacts parameter = new();
        TypedCallFactsFromSignatureSlot(signatures, signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset)), parameter);

        stack mut TypedCallTypeFacts argument = new();
        TypedCallArgumentFactsFromTreeNode(
            source,
            stream,
            literals,
            identifiers,
            calls,
            tree,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            tree.CallArgAt(callNode, ordinal),
            argument);

        if (!TypedCallCanBindArgument(source, stream, parameter, argument))
        {
            return false;
        }

        score = (u32[0 max])(score + TypedCallArgumentBindingCost(source, stream, parameter, argument));
        ordinal = (u32[0 max])(ordinal + 1);
    }

    score = (u32[0 max])(score
        + (signatures.GenericParamCountAt(signatureIndex) * 1000)
        + (signatures.ComptimeGenericParamCountAt(signatureIndex) * 1000));
    return true;
}

internal fn bool TypedCallCandidateScoreFromBody(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow StatementList body,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u64[0 2 ** 63 - 1] signatureIndex,
    u32[0 max] parameterOffset,
    out u32[0 max] score)
{
    score = 0;
    stack u32[0 max] argumentCount = body.ExprCallArgCountAt(callNode);
    if (signatures.ParamCountAt(signatureIndex) != (u32[0 max])(argumentCount + parameterOffset))
    {
        return false;
    }

    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack mut TypedCallTypeFacts parameter = new();
        TypedCallFactsFromSignatureSlot(signatures, signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset)), parameter);

        stack mut TypedCallTypeFacts argument = new();
        TypedCallArgumentFactsFromBodyNode(
            source,
            stream,
            literals,
            identifiers,
            calls,
            body,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            body.ExprCallArgAt(callNode, ordinal),
            argument);

        if (!TypedCallCanBindArgument(source, stream, parameter, argument))
        {
            return false;
        }

        score = (u32[0 max])(score + TypedCallArgumentBindingCost(source, stream, parameter, argument));
        ordinal = (u32[0 max])(ordinal + 1);
    }

    score = (u32[0 max])(score
        + (signatures.GenericParamCountAt(signatureIndex) * 1000)
        + (signatures.ComptimeGenericParamCountAt(signatureIndex) * 1000));
    return true;
}

internal fn u32[0 max] TypedCallResolveDirectOverload(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow ExprTree tree,
    borrow StatementList body,
    bool useBody,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u32[0 max] baseSignatureIndexPlusOne,
    out u32[0 max] candidateCount,
    out u32[0 max] viableCandidateCount,
    out u32[0 max] bestCandidateCount)
{
    candidateCount = 0;
    viableCandidateCount = 0;
    bestCandidateCount = 0;
    stack mut u32[0 max] selectedSignatureIndexPlusOne = 0;
    stack mut u32[0 max] bestScore = 0;
    stack u64[0 2 ** 63 - 1] signatureCount = signatures.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < signatureCount; index += 1)
    {
        if (TypedCallSignatureMatchesOverloadBase(source, stream, signatures, baseSignatureIndexPlusOne, index))
        {
            candidateCount = (u32[0 max])(candidateCount + 1);
            stack mut u32[0 max] score = 0;
            stack mut bool viable = false;
            if (useBody)
            {
                viable = TypedCallCandidateScoreFromBody(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    body,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    index,
                    0,
                    score);
            }
            else
            {
                viable = TypedCallCandidateScoreFromTree(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    tree,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    index,
                    0,
                    score);
            }

            if (viable)
            {
                viableCandidateCount = (u32[0 max])(viableCandidateCount + 1);
                if (selectedSignatureIndexPlusOne == 0 || score < bestScore)
                {
                    selectedSignatureIndexPlusOne = (u32[0 max])(index + 1);
                    bestScore = score;
                    bestCandidateCount = 1;
                }
                else if (score == bestScore)
                {
                    bestCandidateCount = (u32[0 max])(bestCandidateCount + 1);
                }
            }
        }
    }

    if (bestCandidateCount == 1)
    {
        return selectedSignatureIndexPlusOne;
    }

    return 0;
}

internal fn u32[0 max] TypedCallMethodParameterOffset(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    u64[0 2 ** 63 - 1] signatureIndex,
    TypedMemberTargetKind candidateKind,
    u32[0 max] ownerNameToken)
{
    if (candidateKind != TypedMemberTargetKind.InstanceMethod || signatures.ParamCountAt(signatureIndex) == 0)
    {
        return 0;
    }

    stack u32[0 max] firstSlotIndexPlusOne = signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, 0);
    if (firstSlotIndexPlusOne == 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] firstSlot = (u64[0 2 ** 63 - 1])(firstSlotIndexPlusOne - 1);
    stack u32[0 max] firstParamNameToken = signatures.TypeSlotParamNameTokenAt(firstSlot);
    stack u32[0 max] firstTypeHeadToken = signatures.TypeHeadTokenAt(firstSlot);
    if (firstParamNameToken == 0
        || firstTypeHeadToken == 0
        || ownerNameToken == 0
        || !TypedSignatureTokenTextEquals(source, stream, firstParamNameToken, "self")
        || !TypedSignatureTokenTextEqualsToken(source, stream, firstTypeHeadToken, ownerNameToken))
    {
        return 0;
    }

    return 1;
}

internal fn u32[0 max] TypedCallResolveMethodOverload(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow ExprTree tree,
    borrow StatementList body,
    bool useBody,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u32[0 max] memberIndexPlusOne,
    out u32[0 max] selectedParameterOffset,
    out u32[0 max] candidateCount,
    out u32[0 max] viableCandidateCount,
    out u32[0 max] bestCandidateCount)
{
    selectedParameterOffset = 0;
    candidateCount = 0;
    viableCandidateCount = 0;
    bestCandidateCount = 0;
    if (memberIndexPlusOne == 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] memberIndex = (u64[0 2 ** 63 - 1])(memberIndexPlusOne - 1);
    stack u32[0 max] candidateStartIndexPlusOne = members.CandidateStartIndexPlusOneAt(memberIndex);
    candidateCount = members.CandidateCountAt(memberIndex);
    if (candidateStartIndexPlusOne == 0 || candidateCount == 0)
    {
        return 0;
    }

    stack mut u32[0 max] methodOwnerNameToken = members.ReceiverTypeHeadTokenAt(memberIndex);
    if (methodOwnerNameToken == 0)
    {
        methodOwnerNameToken = members.ReceiverNameTokenAt(memberIndex);
    }

    stack mut u32[0 max] selectedSignatureIndexPlusOne = 0;
    stack mut u32[0 max] bestScore = 0;
    stack mut u32[0 max] bestParameterOffset = 0;
    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < candidateCount)
    {
        stack u64[0 2 ** 63 - 1] candidateIndex = (u64[0 2 ** 63 - 1])(candidateStartIndexPlusOne - 1 + ordinal);
        stack u32[0 max] candidateSignatureIndexPlusOne = members.CandidateSignatureIndexPlusOneAt(candidateIndex);
        if (candidateSignatureIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] candidateSignatureIndex = (u64[0 2 ** 63 - 1])(candidateSignatureIndexPlusOne - 1);
            stack u32[0 max] parameterOffset = TypedCallMethodParameterOffset(
                source,
                stream,
                signatures,
                candidateSignatureIndex,
                members.CandidateKindAt(candidateIndex),
                methodOwnerNameToken);
            stack mut u32[0 max] score = 0;
            stack mut bool viable = false;
            if (useBody)
            {
                viable = TypedCallCandidateScoreFromBody(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    body,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    candidateSignatureIndex,
                    parameterOffset,
                    score);
            }
            else
            {
                viable = TypedCallCandidateScoreFromTree(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    tree,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    candidateSignatureIndex,
                    parameterOffset,
                    score);
            }

            if (viable)
            {
                viableCandidateCount = (u32[0 max])(viableCandidateCount + 1);
                if (selectedSignatureIndexPlusOne == 0 || score < bestScore)
                {
                    selectedSignatureIndexPlusOne = candidateSignatureIndexPlusOne;
                    bestScore = score;
                    bestCandidateCount = 1;
                    bestParameterOffset = parameterOffset;
                }
                else if (score == bestScore)
                {
                    bestCandidateCount = (u32[0 max])(bestCandidateCount + 1);
                }
            }
        }

        ordinal = (u32[0 max])(ordinal + 1);
    }

    if (bestCandidateCount == 1)
    {
        selectedParameterOffset = bestParameterOffset;
        return selectedSignatureIndexPlusOne;
    }

    return 0;
}

internal fn System.Memory.MemoryStatus AppendTypedCallArgumentsFromTree(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow ExprTree tree,
    u32[0 max] callNode,
    u32[0 max] callIndexPlusOne,
    u32[0 max] signatureIndexPlusOne,
    u32[0 max] parameterOffset,
    u32[0 max] callableTypeStartToken,
    u32[0 max] callableTypeEndToken)
{
    stack u32[0 max] argumentCount = tree.CallArgCount(callNode);
    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack u32[0 max] argumentNode = tree.CallArgAt(callNode, ordinal);
        stack mut u32[0 max] parameterSlotIndexPlusOne = 0;
        if (signatureIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] signatureIndex = (u64[0 2 ** 63 - 1])(signatureIndexPlusOne - 1);
            parameterSlotIndexPlusOne = signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset));
        }

        stack mut TypedSignatureTypeKind expectedTypeKind = TypedSignatureTypeKind.Unknown;
        stack mut u32[0 max] expectedTypeHeadToken = 0;
        stack mut u32[0 max] expectedTypePrimaryToken = 0;
        stack mut u32[0 max] expectedTypeStartToken = 0;
        stack mut u32[0 max] expectedTypeEndToken = 0;
        stack mut u32[0 max] expectedRangeStartToken = 0;
        stack mut u32[0 max] expectedRangeEndToken = 0;
        stack mut u32[0 max] expectedElementCountStartToken = 0;
        stack mut u32[0 max] expectedElementCountEndToken = 0;
        stack mut u32[0 max] expectedBitWidth = 0;
        stack mut u32[0 max] expectedTypeArgumentCount = 0;
        stack mut u32[0 max] expectedComptimeArgumentCount = 0;
        stack mut u32[0 max] expectedTypeFlags = 0;
        TypedCallSignatureSlotFacts(
            signatures,
            parameterSlotIndexPlusOne,
            expectedTypeKind,
            expectedTypeHeadToken,
            expectedTypePrimaryToken,
            expectedTypeStartToken,
            expectedTypeEndToken,
            expectedRangeStartToken,
            expectedRangeEndToken,
            expectedElementCountStartToken,
            expectedElementCountEndToken,
            expectedBitWidth,
            expectedTypeArgumentCount,
            expectedComptimeArgumentCount,
            expectedTypeFlags);
        if (parameterSlotIndexPlusOne == 0 && callableTypeStartToken != 0)
        {
            TypedCallCallableParameterFacts(
                source,
                stream,
                callableTypeStartToken,
                callableTypeEndToken,
                ordinal,
                expectedTypeKind,
                expectedTypeHeadToken,
                expectedTypePrimaryToken,
                expectedTypeStartToken,
                expectedTypeEndToken,
                expectedRangeStartToken,
                expectedRangeEndToken,
                expectedElementCountStartToken,
                expectedElementCountEndToken,
                expectedBitWidth,
                expectedTypeArgumentCount,
                expectedComptimeArgumentCount,
                expectedTypeFlags);
        }

        switch (table.AppendArgument(
            callIndexPlusOne,
            ordinal,
            argumentNode,
            tree.TokenAt(argumentNode),
            expectedTypeKind,
            expectedTypeHeadToken,
            expectedTypePrimaryToken,
            expectedTypeStartToken,
            expectedTypeEndToken,
            expectedRangeStartToken,
            expectedRangeEndToken,
            expectedElementCountStartToken,
            expectedElementCountEndToken,
            expectedBitWidth,
            expectedTypeArgumentCount,
            expectedComptimeArgumentCount,
            expectedTypeFlags))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }

        ordinal = (u32[0 max])(ordinal + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallArgumentsFromBody(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow StatementList body,
    u32[0 max] callNode,
    u32[0 max] callIndexPlusOne,
    u32[0 max] signatureIndexPlusOne,
    u32[0 max] parameterOffset,
    u32[0 max] callableTypeStartToken,
    u32[0 max] callableTypeEndToken)
{
    stack u32[0 max] argumentCount = body.ExprCallArgCountAt(callNode);
    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack u32[0 max] argumentNode = body.ExprCallArgAt(callNode, ordinal);
        stack mut u32[0 max] parameterSlotIndexPlusOne = 0;
        if (signatureIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] signatureIndex = (u64[0 2 ** 63 - 1])(signatureIndexPlusOne - 1);
            parameterSlotIndexPlusOne = signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset));
        }

        stack mut TypedSignatureTypeKind expectedTypeKind = TypedSignatureTypeKind.Unknown;
        stack mut u32[0 max] expectedTypeHeadToken = 0;
        stack mut u32[0 max] expectedTypePrimaryToken = 0;
        stack mut u32[0 max] expectedTypeStartToken = 0;
        stack mut u32[0 max] expectedTypeEndToken = 0;
        stack mut u32[0 max] expectedRangeStartToken = 0;
        stack mut u32[0 max] expectedRangeEndToken = 0;
        stack mut u32[0 max] expectedElementCountStartToken = 0;
        stack mut u32[0 max] expectedElementCountEndToken = 0;
        stack mut u32[0 max] expectedBitWidth = 0;
        stack mut u32[0 max] expectedTypeArgumentCount = 0;
        stack mut u32[0 max] expectedComptimeArgumentCount = 0;
        stack mut u32[0 max] expectedTypeFlags = 0;
        TypedCallSignatureSlotFacts(
            signatures,
            parameterSlotIndexPlusOne,
            expectedTypeKind,
            expectedTypeHeadToken,
            expectedTypePrimaryToken,
            expectedTypeStartToken,
            expectedTypeEndToken,
            expectedRangeStartToken,
            expectedRangeEndToken,
            expectedElementCountStartToken,
            expectedElementCountEndToken,
            expectedBitWidth,
            expectedTypeArgumentCount,
            expectedComptimeArgumentCount,
            expectedTypeFlags);
        if (parameterSlotIndexPlusOne == 0 && callableTypeStartToken != 0)
        {
            TypedCallCallableParameterFacts(
                source,
                stream,
                callableTypeStartToken,
                callableTypeEndToken,
                ordinal,
                expectedTypeKind,
                expectedTypeHeadToken,
                expectedTypePrimaryToken,
                expectedTypeStartToken,
                expectedTypeEndToken,
                expectedRangeStartToken,
                expectedRangeEndToken,
                expectedElementCountStartToken,
                expectedElementCountEndToken,
                expectedBitWidth,
                expectedTypeArgumentCount,
                expectedComptimeArgumentCount,
                expectedTypeFlags);
        }

        switch (table.AppendArgument(
            callIndexPlusOne,
            ordinal,
            argumentNode,
            body.ExprTokenAt(argumentNode),
            expectedTypeKind,
            expectedTypeHeadToken,
            expectedTypePrimaryToken,
            expectedTypeStartToken,
            expectedTypeEndToken,
            expectedRangeStartToken,
            expectedRangeEndToken,
            expectedElementCountStartToken,
            expectedElementCountEndToken,
            expectedBitWidth,
            expectedTypeArgumentCount,
            expectedComptimeArgumentCount,
            expectedTypeFlags))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }

        ordinal = (u32[0 max])(ordinal + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallExpression(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    borrow ExprTree tree,
    borrow StatementList body,
    bool useBody,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u32[0 max] calleeNode,
    u32[0 max] callToken,
    u32[0 max] calleeNameToken,
    u32[0 max] argumentCount,
    bool calleeIsIdentifier,
    out u32[0 max] callIndexPlusOne,
    out u32[0 max] signatureIndexPlusOne,
    out u32[0 max] parameterOffset,
    out u32[0 max] callableTypeStartToken,
    out u32[0 max] callableTypeEndToken)
{
    callIndexPlusOne = 0;
    signatureIndexPlusOne = 0;
    parameterOffset = 0;
    callableTypeStartToken = 0;
    callableTypeEndToken = 0;
    stack mut u32[0 max] resolvedSignatureIndexPlusOne = 0;
    stack mut u32[0 max] resolvedCallableTypeStartToken = 0;
    stack mut u32[0 max] resolvedCallableTypeEndToken = 0;
    stack mut TypedCallTargetKind targetKind = TypedCallTargetKind.NonIdentifier;
    stack mut u32[0 max] targetDeclarationIndex = 0;
    stack mut u32[0 max] targetSymbolIndexPlusOne = 0;
    stack mut u32[0 max] targetNameToken = 0;
    stack mut u32[0 max] parameterCount = 0;
    stack mut u32[0 max] overloadCandidateCount = 0;
    stack mut u32[0 max] overloadViableCandidateCount = 0;
    stack mut u32[0 max] overloadBestCandidateCount = 0;
    stack mut u32[0 max] flags = 0;
    if (calleeIsIdentifier)
    {
        targetKind = TypedCallTargetKind.Unknown;
        stack u32[0 max] identifierIndexPlusOne = TypedCallIdentifierIndexForNode(
            identifiers,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            calleeNode);
        if (identifierIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] identifierIndex = (u64[0 2 ** 63 - 1])(identifierIndexPlusOne - 1);
            targetDeclarationIndex = identifiers.TargetDeclarationIndexAt(identifierIndex);
            targetSymbolIndexPlusOne = identifiers.TargetSymbolIndexPlusOneAt(identifierIndex);
            targetNameToken = identifiers.TargetNameTokenAt(identifierIndex);
            if (identifiers.TargetKindAt(identifierIndex) == TypedIdentifierTargetKind.Function)
            {
                targetKind = TypedCallTargetKind.DirectFunction;
                resolvedSignatureIndexPlusOne = TypedCallResolveDirectOverload(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    table,
                    tree,
                    body,
                    useBody,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    targetSymbolIndexPlusOne,
                    overloadCandidateCount,
                    overloadViableCandidateCount,
                    overloadBestCandidateCount);
                flags = flags | TypedCallFlagDirect();
                if (resolvedSignatureIndexPlusOne != 0)
                {
                    targetSymbolIndexPlusOne = resolvedSignatureIndexPlusOne;
                    flags = flags | TypedCallFlagResolved() | TypedCallFlagOverloadResolved();
                }
                else if (overloadViableCandidateCount == 0)
                {
                    flags = flags | TypedCallFlagOverloadNoMatch();
                }
                else
                {
                    flags = flags | TypedCallFlagOverloadAmbiguous();
                }
            }
            else if (identifiers.TypeKindAt(identifierIndex) == TypedSignatureTypeKind.FunctionPointer)
            {
                targetKind = TypedCallTargetKind.FunctionPointerValue;
                resolvedCallableTypeStartToken = identifiers.TypeStartTokenAt(identifierIndex);
                resolvedCallableTypeEndToken = identifiers.TypeEndTokenAt(identifierIndex);
                flags = flags | TypedCallFlagResolved() | TypedCallFlagCallableValue();
            }
            else if (identifiers.TypeKindAt(identifierIndex) == TypedSignatureTypeKind.Closure)
            {
                targetKind = TypedCallTargetKind.ClosureValue;
                resolvedCallableTypeStartToken = identifiers.TypeStartTokenAt(identifierIndex);
                resolvedCallableTypeEndToken = identifiers.TypeEndTokenAt(identifierIndex);
                flags = flags | TypedCallFlagResolved() | TypedCallFlagCallableValue();
            }
            else if (identifiers.TargetKindAt(identifierIndex) != TypedIdentifierTargetKind.Unknown)
            {
                targetKind = TypedCallTargetKind.NonCallableValue;
                flags = flags | TypedCallFlagResolved();
            }
        }
    }
    else
    {
        stack mut bool calleeIsMember = false;
        if (useBody)
        {
            calleeIsMember = body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Member;
        }
        else
        {
            calleeIsMember = tree.NodeKindAt(calleeNode) == Compiler.Parsing.ExprKind.Member;
        }

        if (calleeIsMember)
        {
            targetKind = TypedCallTargetKind.Unknown;
            stack u32[0 max] memberIndexPlusOne = TypedCallMemberIndexForNode(
                members,
                context,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                calleeNode);
            if (memberIndexPlusOne != 0)
            {
                stack u64[0 2 ** 63 - 1] memberIndex = (u64[0 2 ** 63 - 1])(memberIndexPlusOne - 1);
                stack TypedMemberTargetKind memberTargetKind = members.TargetKindAt(memberIndex);
                targetDeclarationIndex = members.TargetDeclarationIndexAt(memberIndex);
                targetSymbolIndexPlusOne = members.TargetSymbolIndexPlusOneAt(memberIndex);
                targetNameToken = members.TargetNameTokenAt(memberIndex);
                if (memberTargetKind == TypedMemberTargetKind.Field)
                {
                    targetKind = TypedCallTargetKind.NonCallableValue;
                    flags = flags | TypedCallFlagResolved();
                }
                else if (memberTargetKind == TypedMemberTargetKind.InstanceMethod || memberTargetKind == TypedMemberTargetKind.StaticMethod)
                {
                    if (memberTargetKind == TypedMemberTargetKind.InstanceMethod)
                    {
                        targetKind = TypedCallTargetKind.InstanceMethod;
                    }
                    else
                    {
                        targetKind = TypedCallTargetKind.StaticMethod;
                    }

                    resolvedSignatureIndexPlusOne = TypedCallResolveMethodOverload(
                        source,
                        stream,
                        signatures,
                        literals,
                        identifiers,
                        table,
                        members,
                        tree,
                        body,
                        useBody,
                        context,
                        ownerDeclarationIndex,
                        ownerNameToken,
                        functionNameToken,
                        statementIndexPlusOne,
                        callNode,
                        memberIndexPlusOne,
                        parameterOffset,
                        overloadCandidateCount,
                        overloadViableCandidateCount,
                        overloadBestCandidateCount);
                    flags = flags | TypedCallFlagDirect();
                    if (resolvedSignatureIndexPlusOne != 0)
                    {
                        targetSymbolIndexPlusOne = resolvedSignatureIndexPlusOne;
                        flags = flags | TypedCallFlagResolved() | TypedCallFlagOverloadResolved();
                    }
                    else if (overloadViableCandidateCount == 0)
                    {
                        flags = flags | TypedCallFlagOverloadNoMatch();
                    }
                    else
                    {
                        flags = flags | TypedCallFlagOverloadAmbiguous();
                    }
                }
            }
        }
    }

    stack mut TypedSignatureTypeKind returnTypeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] returnTypeHeadToken = 0;
    stack mut u32[0 max] returnTypePrimaryToken = 0;
    stack mut u32[0 max] returnTypeStartToken = 0;
    stack mut u32[0 max] returnTypeEndToken = 0;
    stack mut u32[0 max] returnRangeStartToken = 0;
    stack mut u32[0 max] returnRangeEndToken = 0;
    stack mut u32[0 max] returnElementCountStartToken = 0;
    stack mut u32[0 max] returnElementCountEndToken = 0;
    stack mut u32[0 max] returnBitWidth = 0;
    stack mut u32[0 max] returnTypeArgumentCount = 0;
    stack mut u32[0 max] returnComptimeArgumentCount = 0;
    stack mut u32[0 max] returnTypeFlags = 0;
    if (resolvedSignatureIndexPlusOne != 0)
    {
        stack u64[0 2 ** 63 - 1] signatureIndex = (u64[0 2 ** 63 - 1])(resolvedSignatureIndexPlusOne - 1);
        parameterCount = signatures.ParamCountAt(signatureIndex);
        if (parameterCount == (u32[0 max])(argumentCount + parameterOffset))
        {
            flags = flags | TypedCallFlagArityMatches();
        }

        stack u32[0 max] returnSlotIndexPlusOne = signatures.ReturnTypeSlotIndexPlusOneAt(signatureIndex);
        TypedCallSignatureSlotFacts(
            signatures,
            returnSlotIndexPlusOne,
            returnTypeKind,
            returnTypeHeadToken,
            returnTypePrimaryToken,
            returnTypeStartToken,
            returnTypeEndToken,
            returnRangeStartToken,
            returnRangeEndToken,
            returnElementCountStartToken,
            returnElementCountEndToken,
            returnBitWidth,
            returnTypeArgumentCount,
            returnComptimeArgumentCount,
            returnTypeFlags);
    }
    else if (resolvedCallableTypeStartToken != 0)
    {
        TypedCallCallableReturnFacts(
            source,
            stream,
            resolvedCallableTypeStartToken,
            resolvedCallableTypeEndToken,
            parameterCount,
            returnTypeKind,
            returnTypeHeadToken,
            returnTypePrimaryToken,
            returnTypeStartToken,
            returnTypeEndToken,
            returnRangeStartToken,
            returnRangeEndToken,
            returnElementCountStartToken,
            returnElementCountEndToken,
            returnBitWidth,
            returnTypeArgumentCount,
            returnComptimeArgumentCount,
            returnTypeFlags);
        if (parameterCount == argumentCount)
        {
            flags = flags | TypedCallFlagArityMatches();
        }
    }

    stack mut u32[0 max] argumentStartIndexPlusOne = 0;
    if (argumentCount > 0)
    {
        argumentStartIndexPlusOne = (u32[0 max])(table.ArgumentCount() + 1);
    }

    signatureIndexPlusOne = resolvedSignatureIndexPlusOne;
    callableTypeStartToken = resolvedCallableTypeStartToken;
    callableTypeEndToken = resolvedCallableTypeEndToken;
    return table.AppendCall(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        callNode,
        calleeNode,
        callToken,
        calleeNameToken,
        targetKind,
        targetDeclarationIndex,
        targetSymbolIndexPlusOne,
        targetNameToken,
        resolvedSignatureIndexPlusOne,
        argumentStartIndexPlusOne,
        argumentCount,
        parameterCount,
        overloadCandidateCount,
        overloadViableCandidateCount,
        overloadBestCandidateCount,
        flags,
        returnTypeKind,
        returnTypeHeadToken,
        returnTypePrimaryToken,
        returnTypeStartToken,
        returnTypeEndToken,
        returnRangeStartToken,
        returnRangeEndToken,
        returnElementCountStartToken,
        returnElementCountEndToken,
        returnBitWidth,
        returnTypeArgumentCount,
        returnComptimeArgumentCount,
        returnTypeFlags,
        callIndexPlusOne);
}

internal fn System.Memory.MemoryStatus AppendTypedCallsFromGlobalDeclaration(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    DeclItem item,
    u32[0 max] declarationIndex)
{
    if (!TypedGlobalDeclarationKindIsGlobal(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] assignToken = TypedGlobalFindAssignToken(stream, item);
    if (assignToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack ExprTree tree = ParseExpression(stream, (u32[0 max])(assignToken + 1));
    stack StatementList emptyBody = new();
    stack u64[0 2 ** 63 - 1] count = tree.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 1; index <= count; index += 1)
    {
        stack u32[0 max] node = (u32[0 max])index;
        if (tree.NodeKindAt(node) == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] calleeNode = tree.LeftAt(node);
            stack bool calleeIsIdentifier = tree.NodeKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier;
            stack mut u32[0 max] calleeNameToken = 0;
            if (calleeIsIdentifier)
            {
                calleeNameToken = tree.TokenAt(calleeNode);
            }
            else if (tree.NodeKindAt(calleeNode) == Compiler.Parsing.ExprKind.Member)
            {
                calleeNameToken = tree.TokenAt(calleeNode);
            }

            stack mut u32[0 max] callIndexPlusOne = 0;
            stack mut u32[0 max] signatureIndexPlusOne = 0;
            stack mut u32[0 max] parameterOffset = 0;
            stack mut u32[0 max] callableTypeStartToken = 0;
            stack mut u32[0 max] callableTypeEndToken = 0;
            switch (AppendTypedCallExpression(
                table,
                source,
                stream,
                signatures,
                literals,
                identifiers,
                members,
                tree,
                emptyBody,
                false,
                TypedCallContext.GlobalInitializer,
                declarationIndex,
                TypedGlobalFindNameToken(stream, item),
                0,
                0,
                node,
                calleeNode,
                tree.TokenAt(node),
                calleeNameToken,
                tree.CallArgCount(node),
                calleeIsIdentifier,
                callIndexPlusOne,
                signatureIndexPlusOne,
                parameterOffset,
                callableTypeStartToken,
                callableTypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (AppendTypedCallArgumentsFromTree(
                table,
                source,
                stream,
                signatures,
                tree,
                node,
                callIndexPlusOne,
                signatureIndexPlusOne,
                parameterOffset,
                callableTypeStartToken,
                callableTypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var argumentError):
                    return System.Memory.MemoryStatus.Err(argumentError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallsFromBodyStatement(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statementIndex)
{
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    stack ExprTree emptyTree = new();
    stack u32[0 max] start = (u32[0 max])(body.ExprStartAt(statementIndex) + 1);
    stack mut u32[0 max] end = (u32[0 max])body.ExprNodeCount();
    if (statementIndex + 1 < statementCount)
    {
        end = body.ExprStartAt((u64[0 2 ** 63 - 1])(statementIndex + 1));
    }

    if (start > end)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u64[0 2 ** 63 - 1] endIndex = (u64[0 2 ** 63 - 1])end;
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])start; nodeIndex <= endIndex; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Call)
        {
            stack u32[0 max] calleeNode = body.ExprLeftAt(node);
            stack bool calleeIsIdentifier = body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Identifier;
            stack mut u32[0 max] calleeNameToken = 0;
            if (calleeIsIdentifier)
            {
                calleeNameToken = body.ExprTokenAt(calleeNode);
            }
            else if (body.ExprKindAt(calleeNode) == Compiler.Parsing.ExprKind.Member)
            {
                calleeNameToken = body.ExprTokenAt(calleeNode);
            }

            stack mut u32[0 max] callIndexPlusOne = 0;
            stack mut u32[0 max] signatureIndexPlusOne = 0;
            stack mut u32[0 max] parameterOffset = 0;
            stack mut u32[0 max] callableTypeStartToken = 0;
            stack mut u32[0 max] callableTypeEndToken = 0;
            switch (AppendTypedCallExpression(
                table,
                source,
                stream,
                signatures,
                literals,
                identifiers,
                members,
                emptyTree,
                body,
                true,
                TypedCallContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                (u32[0 max])(statementIndex + 1),
                node,
                calleeNode,
                body.ExprTokenAt(node),
                calleeNameToken,
                body.ExprCallArgCountAt(node),
                calleeIsIdentifier,
                callIndexPlusOne,
                signatureIndexPlusOne,
                parameterOffset,
                callableTypeStartToken,
                callableTypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }

            switch (AppendTypedCallArgumentsFromBody(
                table,
                source,
                stream,
                signatures,
                body,
                node,
                callIndexPlusOne,
                signatureIndexPlusOne,
                parameterOffset,
                callableTypeStartToken,
                callableTypeEndToken))
            {
                case System.Memory.MemoryStatus.Err(var argumentError):
                    return System.Memory.MemoryStatus.Err(argumentError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallsFromBody(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedCallsFromBodyStatement(
            table,
            source,
            stream,
            signatures,
            literals,
            identifiers,
            members,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            body,
            index))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedCallsForFunction(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] fnKeyword)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    return AppendTypedCallsFromBody(
        table,
        source,
        stream,
        signatures,
        literals,
        identifiers,
        members,
        ownerDeclarationIndex,
        ownerNameToken,
        signature.Name(),
        body);
}

internal fn System.Memory.MemoryStatus AppendTypedCallsForMemberFunctions(
    mut borrow TypedCallExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members,
    DeclItem item,
    u32[0 max] ownerDeclarationIndex)
{
    if (!TypedSignatureDeclarationCanOwnMethods(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, item);
    if (bodyOpen == 0 || bodyOpen >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Fn)
        {
            switch (AppendTypedCallsForFunction(table, source, stream, signatures, literals, identifiers, members, ownerDeclarationIndex, item.NameToken, scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn ParseResult<TypedCallExpressionTable> BuildTypedCallExpressionsFromDependencies(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedMemberExpressionTable members)
{
    stack mut TypedCallExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedCallsFromGlobalDeclaration(
            table,
            source,
            stream,
            signatures,
            literals,
            identifiers,
            members,
            item,
            (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedCallsForFunction(table, source, stream, signatures, literals, identifiers, members, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedCallsForMemberFunctions(table, source, stream, signatures, literals, identifiers, members, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberError):
                    return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedCallExpressionTable>.Ok(table);
}
