module Compiler.Typing.TypedReturns

public enum TypedReturnContext
{
    FunctionBody,
    Unknown,
}

public enum TypedReturnValueKind
{
    None,
    Identifier,
    Member,
    Call,
    Index,
    Literal,
    New,
    Conversion,
    Assignment,
    Unknown,
}

internal inline finite law u32[0 max] TypedReturnFlagHasValue()
{
    return 1;
}

internal inline finite law u32[0 max] TypedReturnFlagBare()
{
    return 2;
}

internal inline finite law u32[0 max] TypedReturnFlagExpectedResolved()
{
    return 4;
}

internal inline finite law u32[0 max] TypedReturnFlagValueResolved()
{
    return 8;
}

internal inline finite law u32[0 max] TypedReturnFlagExpectedVoid()
{
    return 16;
}

internal inline finite law bool TypedReturnFlagPresent(u32[0 max] flags, u32[0 max] flag)
{
    return (flags & flag) != 0;
}

