    TypedReturnExpressionTable()
    {
        self.Contexts = new();
        self.OwnerDeclarationIndices = new();
        self.OwnerNameTokens = new();
        self.FunctionNameTokens = new();
        self.StatementIndices = new();
        self.ReturnTokens = new();
        self.ValueNodes = new();
        self.ValueKinds = new();
        self.ExpectedTypeKinds = new();
        self.ExpectedTypeHeadTokens = new();
        self.ExpectedTypePrimaryTokens = new();
        self.ExpectedTypeStartTokens = new();
        self.ExpectedTypeEndTokens = new();
        self.ExpectedRangeStartTokens = new();
        self.ExpectedRangeEndTokens = new();
        self.ExpectedElementCountStartTokens = new();
        self.ExpectedElementCountEndTokens = new();
        self.ExpectedBitWidths = new();
        self.ExpectedTypeArgumentCounts = new();
        self.ExpectedComptimeArgumentCounts = new();
        self.ExpectedTypeFlags = new();
        self.ValueTypeKinds = new();
        self.ValueTypeHeadTokens = new();
        self.ValueTypePrimaryTokens = new();
        self.ValueTypeStartTokens = new();
        self.ValueTypeEndTokens = new();
        self.ValueRangeStartTokens = new();
        self.ValueRangeEndTokens = new();
        self.ValueElementCountStartTokens = new();
        self.ValueElementCountEndTokens = new();
        self.ValueBitWidths = new();
        self.ValueTypeArgumentCounts = new();
        self.ValueComptimeArgumentCounts = new();
        self.ValueTypeFlags = new();
        self.ReturnFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedReturnExpressionTable self)
    {
        return self.ReturnTokens.Length;
    }

    public law TypedReturnContext ContextAt(borrow TypedReturnExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedReturnContext context = TypedReturnContext.Unknown;
        if (index < self.Contexts.Length)
        {
            context = self.Contexts[index];
        }

        return context;
    }

