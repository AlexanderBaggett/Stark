import Compiler.Lexing
import Compiler.Parsing
import Compiler.Typing.TypedGenerics
import Compiler.Typing.TypedGlobals
import Compiler.Typing.TypedSignatures
module Compiler.Typing.TypedCallSignatures

internal fn void TypedCallSignatureSlotFacts(
    borrow TypedFunctionSignatureTable signatures,
    u32[0 max] slotIndexPlusOne,
    out TypedSignatureTypeKind typeKind,
    out u32[0 max] typeHeadToken,
    out u32[0 max] typePrimaryToken,
    out u32[0 max] typeStartToken,
    out u32[0 max] typeEndToken,
    out u32[0 max] rangeStartToken,
    out u32[0 max] rangeEndToken,
    out u32[0 max] elementCountStartToken,
    out u32[0 max] elementCountEndToken,
    out u32[0 max] bitWidth,
    out u32[0 max] typeArgumentCount,
    out u32[0 max] comptimeArgumentCount,
    out u32[0 max] typeFlags)
{
    typeKind = TypedSignatureTypeKind.Unknown;
    typeHeadToken = 0;
    typePrimaryToken = 0;
    typeStartToken = 0;
    typeEndToken = 0;
    rangeStartToken = 0;
    rangeEndToken = 0;
    elementCountStartToken = 0;
    elementCountEndToken = 0;
    bitWidth = 0;
    typeArgumentCount = 0;
    comptimeArgumentCount = 0;
    typeFlags = 0;
    if (slotIndexPlusOne == 0)
    {
        return;
    }

    stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(slotIndexPlusOne - 1);
    typeKind = signatures.TypeKindAt(slot);
    typeHeadToken = signatures.TypeHeadTokenAt(slot);
    typePrimaryToken = signatures.TypePrimaryTokenAt(slot);
    typeStartToken = signatures.TypeStartTokenAt(slot);
    typeEndToken = signatures.TypeEndTokenAt(slot);
    rangeStartToken = signatures.RangeStartTokenAt(slot);
    rangeEndToken = signatures.RangeEndTokenAt(slot);
    elementCountStartToken = signatures.ElementCountStartTokenAt(slot);
    elementCountEndToken = signatures.ElementCountEndTokenAt(slot);
    bitWidth = signatures.BitWidthAt(slot);
    typeArgumentCount = signatures.TypeArgumentCountAt(slot);
    comptimeArgumentCount = signatures.ComptimeArgumentCountAt(slot);
    typeFlags = signatures.TypeFlagsAt(slot);
}

internal fn bool TypedCallFindCallableParamList(
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    out u32[0 max] lparen,
    out u32[0 max] rparen)
{
    lparen = 0;
    rparen = 0;
    if (typeStartToken == 0 || typeEndToken <= typeStartToken)
    {
        return false;
    }

    stack u32[0 max] typeHeadToken = TypedGlobalTypeHeadToken(stream, typeStartToken, typeEndToken);
    stack u32[0 max] primaryToken = TypedSignatureSemanticPrimaryToken(stream, typeStartToken, typeEndToken, typeHeadToken);
    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])primaryToken);
    if (primaryKind != TokenKind.Fnptr && primaryKind != TokenKind.Closure)
    {
        return false;
    }

    stack u32[0 max] openToken = (u32[0 max])(primaryToken + 1);
    if (stream.KindAt((u64[0 2 ** 63 - 1])openToken) != TokenKind.Lt)
    {
        return false;
    }

    stack u32[0 max] closeToken = TypedSignatureMatchingCloseToken(stream, openToken);
    if (closeToken <= openToken || closeToken > typeEndToken)
    {
        return false;
    }

    stack mut bool sawFunctionKind = false;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(openToken + 1);
    while willexit (scan < closeToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0)
        {
            if (TypedSignatureTokenCanStartCallableFunctionKind(kind))
            {
                sawFunctionKind = true;
            }
            else if (sawFunctionKind && kind == TokenKind.LParen)
            {
                lparen = scan;
                rparen = TypedSignatureMatchingCloseToken(stream, scan);
                return rparen > lparen && rparen < closeToken;
            }
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u32[0 max] TypedCallCallableParamCount(borrow TokenStream stream, u32[0 max] lparen, u32[0 max] rparen)
{
    if ((u32[0 max])(lparen + 1) >= rparen)
    {
        return 0;
    }

    stack mut u32[0 max] count = 1;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan < rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Comma && depth == 0)
        {
            count = (u32[0 max])(count + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

internal fn bool TypedCallCallableParamSpan(
    borrow TokenStream stream,
    u32[0 max] lparen,
    u32[0 max] rparen,
    u32[0 max] argIndex,
    out u32[0 max] start,
    out u32[0 max] endExclusive)
{
    start = 0;
    endExclusive = 0;
    stack mut u32[0 max] currentIndex = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(lparen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    while willexit (scan <= rparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (scan == rparen || (kind == TokenKind.Comma && depth == 0))
        {
            if (currentIndex == argIndex)
            {
                start = segmentStart;
                endExclusive = scan;
                return segmentStart < scan;
            }

            currentIndex = (u32[0 max])(currentIndex + 1);
            segmentStart = (u32[0 max])(scan + 1);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal fn u32[0 max] TypedCallCallableReturnStart(borrow TokenStream stream, u32[0 max] typeStartToken, u32[0 max] lparen)
{
    stack mut u32[0 max] lastKindToken = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = typeStartToken;
    while willexit (scan < lparen)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 1 && TypedSignatureTokenCanStartCallableFunctionKind(kind))
        {
            lastKindToken = scan;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    if (lastKindToken != 0)
    {
        return (u32[0 max])(lastKindToken + 1);
    }

    return 0;
}

internal fn void TypedCallTypeSpanFacts(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    out TypedSignatureTypeKind typeKind,
    out u32[0 max] typeHeadToken,
    out u32[0 max] typePrimaryToken,
    out u32[0 max] rangeStartToken,
    out u32[0 max] rangeEndToken,
    out u32[0 max] elementCountStartToken,
    out u32[0 max] elementCountEndToken,
    out u32[0 max] bitWidth,
    out u32[0 max] typeArgumentCount,
    out u32[0 max] comptimeArgumentCount,
    out u32[0 max] typeFlags)
{
    typeKind = TypedSignatureTypeKind.Unknown;
    typeHeadToken = 0;
    typePrimaryToken = 0;
    rangeStartToken = 0;
    rangeEndToken = 0;
    elementCountStartToken = 0;
    elementCountEndToken = 0;
    bitWidth = 0;
    typeArgumentCount = 0;
    comptimeArgumentCount = 0;
    typeFlags = 0;
    if (typeStartToken == 0 || typeEndToken <= typeStartToken)
    {
        return;
    }

    stack mut u32[0 max] computedRangeStartToken = 0;
    stack mut u32[0 max] computedRangeEndToken = 0;
    stack mut u32[0 max] computedElementCountStartToken = 0;
    stack mut u32[0 max] computedElementCountEndToken = 0;
    stack mut TypedSignatureTypeKind arrayKind = TypedSignatureTypeKind.Unknown;
    TypedSignatureScanTopLevelTypeFacts(
        stream,
        typeStartToken,
        typeEndToken,
        computedRangeStartToken,
        computedRangeEndToken,
        computedElementCountStartToken,
        computedElementCountEndToken,
        arrayKind);

    stack u32[0 max] computedTypeHeadToken = TypedGlobalTypeHeadToken(stream, typeStartToken, typeEndToken);
    stack u32[0 max] computedTypePrimaryToken = TypedSignatureSemanticPrimaryToken(stream, typeStartToken, typeEndToken, computedTypeHeadToken);
    stack TypedSignatureTypeKind computedTypeKind = TypedSignatureKindForType(source, stream, computedTypePrimaryToken, computedTypeHeadToken, 0, 0, arrayKind);

    stack mut u32[0 max] computedBitWidth = 0;
    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])computedTypePrimaryToken);
    if (primaryKind == TokenKind.IntegerType)
    {
        computedBitWidth = TypedSignatureIntegerBitWidth(source, stream, computedTypePrimaryToken);
    }
    else if (primaryKind == TokenKind.FloatType)
    {
        computedBitWidth = TypedSignatureFloatBitWidth(source, stream, computedTypePrimaryToken);
    }

    stack mut u32[0 max] computedTypeArgumentCount = 0;
    stack mut u32[0 max] computedComptimeArgumentCount = 0;
    if (computedTypeHeadToken != 0 && stream.KindAt((u64[0 2 ** 63 - 1])(computedTypeHeadToken + 1)) == TokenKind.Lt)
    {
        TypedSignatureCountGenericArgumentsInList(stream, (u32[0 max])(computedTypeHeadToken + 1), computedTypeArgumentCount, computedComptimeArgumentCount);
    }

    stack u32[0 max] computedTypeFlags = TypedSignatureFlagsForType(
        source,
        stream,
        computedTypePrimaryToken,
        computedTypeHeadToken,
        typeStartToken,
        typeEndToken,
        0,
        0,
        computedRangeStartToken,
        computedRangeEndToken,
        computedElementCountStartToken,
        TypedSignatureTypeSpanContainsTailCallableSignature(stream, typeStartToken, typeEndToken),
        0,
        TypedSignatureTypeSpanContainsDeadOnReturnContract(stream, typeStartToken, typeEndToken));

    typeKind = computedTypeKind;
    typeHeadToken = computedTypeHeadToken;
    typePrimaryToken = computedTypePrimaryToken;
    rangeStartToken = computedRangeStartToken;
    rangeEndToken = computedRangeEndToken;
    elementCountStartToken = computedElementCountStartToken;
    elementCountEndToken = computedElementCountEndToken;
    bitWidth = computedBitWidth;
    typeArgumentCount = computedTypeArgumentCount;
    comptimeArgumentCount = computedComptimeArgumentCount;
    typeFlags = computedTypeFlags;
}

internal fn void TypedCallCallableReturnFacts(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    out u32[0 max] parameterCount,
    out TypedSignatureTypeKind returnTypeKind,
    out u32[0 max] returnTypeHeadToken,
    out u32[0 max] returnTypePrimaryToken,
    out u32[0 max] returnTypeStartToken,
    out u32[0 max] returnTypeEndToken,
    out u32[0 max] returnRangeStartToken,
    out u32[0 max] returnRangeEndToken,
    out u32[0 max] returnElementCountStartToken,
    out u32[0 max] returnElementCountEndToken,
    out u32[0 max] returnBitWidth,
    out u32[0 max] returnTypeArgumentCount,
    out u32[0 max] returnComptimeArgumentCount,
    out u32[0 max] returnTypeFlags)
{
    parameterCount = 0;
    returnTypeKind = TypedSignatureTypeKind.Unknown;
    returnTypeHeadToken = 0;
    returnTypePrimaryToken = 0;
    returnTypeStartToken = 0;
    returnTypeEndToken = 0;
    returnRangeStartToken = 0;
    returnRangeEndToken = 0;
    returnElementCountStartToken = 0;
    returnElementCountEndToken = 0;
    returnBitWidth = 0;
    returnTypeArgumentCount = 0;
    returnComptimeArgumentCount = 0;
    returnTypeFlags = 0;

    stack mut u32[0 max] lparen = 0;
    stack mut u32[0 max] rparen = 0;
    if (!TypedCallFindCallableParamList(stream, typeStartToken, typeEndToken, lparen, rparen))
    {
        return;
    }

    stack u32[0 max] computedReturnTypeStartToken = TypedCallCallableReturnStart(stream, typeStartToken, lparen);
    stack u32[0 max] computedReturnTypeEndToken = lparen;
    TypedCallTypeSpanFacts(
        source,
        stream,
        computedReturnTypeStartToken,
        computedReturnTypeEndToken,
        returnTypeKind,
        returnTypeHeadToken,
        returnTypePrimaryToken,
        returnRangeStartToken,
        returnRangeEndToken,
        returnElementCountStartToken,
        returnElementCountEndToken,
        returnBitWidth,
        returnTypeArgumentCount,
        returnComptimeArgumentCount,
        returnTypeFlags);
    parameterCount = TypedCallCallableParamCount(stream, lparen, rparen);
    returnTypeStartToken = computedReturnTypeStartToken;
    returnTypeEndToken = computedReturnTypeEndToken;
}

internal fn void TypedCallCallableParameterFacts(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken,
    u32[0 max] ordinal,
    out TypedSignatureTypeKind expectedTypeKind,
    out u32[0 max] expectedTypeHeadToken,
    out u32[0 max] expectedTypePrimaryToken,
    out u32[0 max] expectedTypeStartToken,
    out u32[0 max] expectedTypeEndToken,
    out u32[0 max] expectedRangeStartToken,
    out u32[0 max] expectedRangeEndToken,
    out u32[0 max] expectedElementCountStartToken,
    out u32[0 max] expectedElementCountEndToken,
    out u32[0 max] expectedBitWidth,
    out u32[0 max] expectedTypeArgumentCount,
    out u32[0 max] expectedComptimeArgumentCount,
    out u32[0 max] expectedTypeFlags)
{
    expectedTypeKind = TypedSignatureTypeKind.Unknown;
    expectedTypeHeadToken = 0;
    expectedTypePrimaryToken = 0;
    expectedTypeStartToken = 0;
    expectedTypeEndToken = 0;
    expectedRangeStartToken = 0;
    expectedRangeEndToken = 0;
    expectedElementCountStartToken = 0;
    expectedElementCountEndToken = 0;
    expectedBitWidth = 0;
    expectedTypeArgumentCount = 0;
    expectedComptimeArgumentCount = 0;
    expectedTypeFlags = 0;

    stack mut u32[0 max] lparen = 0;
    stack mut u32[0 max] rparen = 0;
    if (!TypedCallFindCallableParamList(stream, typeStartToken, typeEndToken, lparen, rparen))
    {
        return;
    }

    stack mut u32[0 max] computedExpectedTypeStartToken = 0;
    stack mut u32[0 max] computedExpectedTypeEndToken = 0;
    if (!TypedCallCallableParamSpan(stream, lparen, rparen, ordinal, computedExpectedTypeStartToken, computedExpectedTypeEndToken))
    {
        return;
    }

    TypedCallTypeSpanFacts(
        source,
        stream,
        computedExpectedTypeStartToken,
        computedExpectedTypeEndToken,
        expectedTypeKind,
        expectedTypeHeadToken,
        expectedTypePrimaryToken,
        expectedRangeStartToken,
        expectedRangeEndToken,
        expectedElementCountStartToken,
        expectedElementCountEndToken,
        expectedBitWidth,
        expectedTypeArgumentCount,
        expectedComptimeArgumentCount,
        expectedTypeFlags);
    expectedTypeStartToken = computedExpectedTypeStartToken;
    expectedTypeEndToken = computedExpectedTypeEndToken;
}
