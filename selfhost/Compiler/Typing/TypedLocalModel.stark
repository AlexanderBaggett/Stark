        {
            count = self.TypeArgumentCounts[index];
        }

        return count;
    }

    public law u32[0 max] ComptimeArgumentCountAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ComptimeArgumentCounts.Length)
        {
            count = self.ComptimeArgumentCounts[index];
        }

        return count;
    }

    public law u32[0 max] TypeFlagsAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flags = 0;
        if (index < self.TypeFlags.Length)
        {
            flags = self.TypeFlags[index];
        }

        return flags;
    }

    public law bool HasExplicitTypeAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TypeStartTokenAt(index) != 0 && self.TypeEndTokenAt(index) > self.TypeStartTokenAt(index);
    }

    public law bool HasInitializerAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.InitializerExprRootAt(index) != 0
            || (self.InitializerStartTokenAt(index) != 0 && self.InitializerEndTokenAt(index) > self.InitializerStartTokenAt(index));
    }

    public law bool IsIntegerSignedAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerSigned());
    }

    public law bool IsIntegerUnsignedAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerUnsigned());
    }

    public law bool HasIntegerRangeAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHasIntegerRange());
    }

    public law bool RangeStartsAtMinAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRangeStartsAtMin());
    }

    public law bool RangeEndsAtMaxAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRangeEndsAtMax());
    }

    public law bool IsMutableAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagMutableView());
    }

    public law bool IsBorrowAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagBorrow());
    }

    public law bool IsOutAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagOut());
    }

    public law bool IsRawMutablePointerAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRawMutablePointer());
    }

    public law bool HasElementCountExpressionAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHasElementCountExpression());
    }

    public law bool IsTailCallableAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagTailCallable());
    }

    public law bool IsDeadOnReturnAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagDeadOnReturn());
    }

    public law bool IsOwnedTextAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagOwnedText());
    }

    public law bool IsUnicodeTextAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagUnicodeText());
    }

    public law bool TypeHeadIsGenericParameterAt(borrow TypedLocalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHeadIsGenericParameter());
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedLocalDeclarationTable self,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
        u32[0 max] functionNameToken,
        TypedLocalDeclarationOwnerKind ownerKind,
        u32[0 max] statementIndexPlusOne,
        u32[0 max] nameToken,
        u32[0 max] startToken,
        u32[0 max] endToken,
        TypedGlobalStorageKind storageKind,
        u32[0 max] initializerExprRoot,
        u32[0 max] initializerStartToken,
        u32[0 max] initializerEndToken,
        u32[0 max] depth,
        u32[0 max] scopeId,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] elementCountStartToken,
        u32[0 max] elementCountEndToken,
        u32[0 max] bitWidth,
        u32[0 max] typeArgumentCount,
        u32[0 max] comptimeArgumentCount,
        u32[0 max] typeFlags)
    {
        if (!self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.FunctionNameTokens.TryReserve(1)
            || !self.OwnerKinds.TryReserve(1)
            || !self.StatementIndices.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.StorageKinds.TryReserve(1)
            || !self.InitializerExprRoots.TryReserve(1)
            || !self.InitializerStartTokens.TryReserve(1)
            || !self.InitializerEndTokens.TryReserve(1)
            || !self.Depths.TryReserve(1)
            || !self.ScopeIds.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ElementCountStartTokens.TryReserve(1)
            || !self.ElementCountEndTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeArgumentCounts.TryReserve(1)
            || !self.ComptimeArgumentCounts.TryReserve(1)
            || !self.TypeFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.FunctionNameTokens[self.FunctionNameTokens.Length] = functionNameToken;
        init self.OwnerKinds[self.OwnerKinds.Length] = ownerKind;
        init self.StatementIndices[self.StatementIndices.Length] = statementIndexPlusOne;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.StartTokens[self.StartTokens.Length] = startToken;
        init self.EndTokens[self.EndTokens.Length] = endToken;
        init self.StorageKinds[self.StorageKinds.Length] = storageKind;
        init self.InitializerExprRoots[self.InitializerExprRoots.Length] = initializerExprRoot;
        init self.InitializerStartTokens[self.InitializerStartTokens.Length] = initializerStartToken;
        init self.InitializerEndTokens[self.InitializerEndTokens.Length] = initializerEndToken;
        init self.Depths[self.Depths.Length] = depth;
        init self.ScopeIds[self.ScopeIds.Length] = scopeId;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ElementCountStartTokens[self.ElementCountStartTokens.Length] = elementCountStartToken;
        init self.ElementCountEndTokens[self.ElementCountEndTokens.Length] = elementCountEndToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeArgumentCounts[self.TypeArgumentCounts.Length] = typeArgumentCount;
        init self.ComptimeArgumentCounts[self.ComptimeArgumentCounts.Length] = comptimeArgumentCount;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}
