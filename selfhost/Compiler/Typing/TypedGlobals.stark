    public law bool RangeEndsAtMaxAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRangeEndsAtMax());
    }

    public law bool IsBorrowAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
