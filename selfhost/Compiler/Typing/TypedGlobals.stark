    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedGlobalDeclarationTable self,
        u32[0 max] declarationIndex,
        DeclItem item,
        u32[0 max] nameToken,
        TypedGlobalBindingKind bindingKind,
        TypedGlobalStorageKind storageKind,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] elementCountStartToken,
        u32[0 max] elementCountEndToken,
        u32[0 max] bitWidth,
        u32[0 max] typeArgumentCount,
        u32[0 max] comptimeArgumentCount,
        u32[0 max] typeFlags,
        u32[0 max] initializerStartToken,
        u32[0 max] initializerEndToken)
    {
        if (!self.DeclarationIndices.TryReserve(1)
            || !self.DeclarationKinds.TryReserve(1)
            || !self.BindingKinds.TryReserve(1)
            || !self.StorageKinds.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ElementCountStartTokens.TryReserve(1)
            || !self.ElementCountEndTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeArgumentCounts.TryReserve(1)
            || !self.ComptimeArgumentCounts.TryReserve(1)
            || !self.TypeFlags.TryReserve(1)
            || !self.InitializerStartTokens.TryReserve(1)
            || !self.InitializerEndTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.DeclarationIndices[self.DeclarationIndices.Length] = declarationIndex;
        init self.DeclarationKinds[self.DeclarationKinds.Length] = item.Kind;
        init self.BindingKinds[self.BindingKinds.Length] = bindingKind;
        init self.StorageKinds[self.StorageKinds.Length] = storageKind;
        init self.KeywordTokens[self.KeywordTokens.Length] = item.KeywordToken;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.StartTokens[self.StartTokens.Length] = item.StartToken;
        init self.EndTokens[self.EndTokens.Length] = item.EndToken;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ElementCountStartTokens[self.ElementCountStartTokens.Length] = elementCountStartToken;
        init self.ElementCountEndTokens[self.ElementCountEndTokens.Length] = elementCountEndToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeArgumentCounts[self.TypeArgumentCounts.Length] = typeArgumentCount;
        init self.ComptimeArgumentCounts[self.ComptimeArgumentCounts.Length] = comptimeArgumentCount;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        init self.InitializerStartTokens[self.InitializerStartTokens.Length] = initializerStartToken;
        init self.InitializerEndTokens[self.InitializerEndTokens.Length] = initializerEndToken;
        return System.Memory.MemoryStatus.Ok;
    }
}


internal finite law bool TypedGlobalDeclarationKindIsGlobal(DeclarationKind kind)
{
    return kind == DeclarationKind.Const
        || kind == DeclarationKind.Static
        || kind == DeclarationKind.GlobalVariable;
}

internal finite law TypedGlobalStorageKind TypedGlobalStorageKindForItem(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind == DeclarationKind.Const)
    {
        return TypedGlobalStorageKind.Const;
    }

    if (item.Kind == DeclarationKind.Static)
    {
        return TypedGlobalStorageKind.Static;
    }

    if (item.Kind == DeclarationKind.GlobalVariable)
    {
        switch (stream.KindAt((u64[0 2 ** 63 - 1])item.KeywordToken))
        {
            case TokenKind.Heap:
                return TypedGlobalStorageKind.Heap;
            case TokenKind.Stack:
                return TypedGlobalStorageKind.Stack;
            case TokenKind.Register:
                return TypedGlobalStorageKind.Register;
            case TokenKind.Arena:
                return TypedGlobalStorageKind.Arena;
            default:
                return TypedGlobalStorageKind.Unknown;
        }
    }

    return TypedGlobalStorageKind.Unknown;
}

internal finite law TypedGlobalBindingKind TypedGlobalBindingKindForItem(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind == DeclarationKind.Const)
    {
        return TypedGlobalBindingKind.Const;
    }

    if (item.Kind == DeclarationKind.Static || item.Kind == DeclarationKind.GlobalVariable)
    {
        stack u32[0 max] next = (u32[0 max])(item.KeywordToken + 1);
        if (stream.KindAt((u64[0 2 ** 63 - 1])next) == TokenKind.Mut)
        {
            return TypedGlobalBindingKind.Mutable;
        }

        return TypedGlobalBindingKind.Immutable;
    }

    return TypedGlobalBindingKind.Unknown;
}

internal fn u32[0 max] TypedGlobalFindNameToken(borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = (u32[0 max])(item.KeywordToken + 1);
    if ((item.Kind == DeclarationKind.Static || item.Kind == DeclarationKind.GlobalVariable)
        && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Mut)
    {
        scan = (u32[0 max])(scan + 1);
    }

    stack mut u32[0 max] nameToken = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0 && scan <= item.EndToken)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            break;
        }

        if (depth == 0 && (kind == TokenKind.Assign || kind == TokenKind.Semi))
        {
            break;
        }

        if (depth == 0 && kind == TokenKind.Identifier)
        {
            nameToken = scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return nameToken;
}

internal fn u32[0 max] TypedGlobalFindAssignToken(borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = item.KeywordToken;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0 && scan <= item.EndToken)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return 0;
        }

        if (depth == 0 && kind == TokenKind.Assign)
        {
            return scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn u32[0 max] TypedGlobalTypeStartToken(borrow TokenStream stream, DeclItem item, u32[0 max] nameToken)
{
    if (nameToken == 0)
    {
        return 0;
    }

    stack mut u32[0 max] start = (u32[0 max])(item.KeywordToken + 1);
    if ((item.Kind == DeclarationKind.Static || item.Kind == DeclarationKind.GlobalVariable)
        && stream.KindAt((u64[0 2 ** 63 - 1])start) == TokenKind.Mut)
    {
        start = (u32[0 max])(start + 1);
    }

    if (nameToken > start)
    {
        return start;
    }

    return 0;
}

internal finite law bool TypedGlobalTokenCanBeTypeHead(TokenKind kind)
{
    return kind == TokenKind.Void
        || kind == TokenKind.Bool
        || kind == TokenKind.IntegerType
        || kind == TokenKind.FloatType
        || kind == TokenKind.AsciiView
        || kind == TokenKind.AsciiOwned
        || kind == TokenKind.UnicodeView
        || kind == TokenKind.UnicodeOwned
        || kind == TokenKind.Rawptr
        || kind == TokenKind.Rawmutptr
        || kind == TokenKind.Fnptr
        || kind == TokenKind.Closure
        || TypedDynamicTokenKind(kind)
        || kind == TokenKind.Identifier;
}

internal fn u32[0 max] TypedGlobalTypeHeadToken(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] headToken = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && TypedGlobalTokenCanBeTypeHead(kind))
        {
            headToken = scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return headToken;
}

internal fn u32[0 max] TypedGlobalInitializerEndExclusive(borrow TokenStream stream, DeclItem item)
{
    if (item.EndToken == 0)
    {
        return 0;
    }

    stack TokenKind endKind = stream.KindAt((u64[0 2 ** 63 - 1])item.EndToken);
    if (endKind == TokenKind.Semi || endKind == TokenKind.EndOfFile)
    {
        return item.EndToken;
    }

    return (u32[0 max])(item.EndToken + 1);
}

internal fn System.Memory.MemoryStatus AppendTypedGlobalDeclaration(
    mut borrow TypedGlobalDeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem item,
    u32[0 max] declarationIndex)
{
    stack u32[0 max] nameToken = TypedGlobalFindNameToken(stream, item);
    stack u32[0 max] typeStartToken = TypedGlobalTypeStartToken(stream, item, nameToken);
    stack mut u32[0 max] typeEndToken = 0;
    if (typeStartToken != 0)
    {
        typeEndToken = nameToken;
    }

    stack mut TypedSignatureTypeKind typeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] typeHeadToken = 0;
    stack mut u32[0 max] typePrimaryToken = 0;
    stack mut u32[0 max] rangeStartToken = 0;
    stack mut u32[0 max] rangeEndToken = 0;
    stack mut u32[0 max] elementCountStartToken = 0;
    stack mut u32[0 max] elementCountEndToken = 0;
    stack mut u32[0 max] bitWidth = 0;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    stack mut u32[0 max] typeFlags = 0;

    if (typeStartToken != 0 && typeEndToken > typeStartToken)
    {
        stack mut TypedSignatureTypeKind arrayKind = TypedSignatureTypeKind.Unknown;
        TypedSignatureScanTopLevelTypeFacts(
            stream,
            typeStartToken,
            typeEndToken,
            rangeStartToken,
            rangeEndToken,
            elementCountStartToken,
            elementCountEndToken,
            arrayKind);

        typeHeadToken = TypedGlobalTypeHeadToken(stream, typeStartToken, typeEndToken);
        typePrimaryToken = TypedSignatureSemanticPrimaryToken(stream, typeStartToken, typeEndToken, typeHeadToken);
        typeKind = TypedSignatureKindForType(source, stream, typePrimaryToken, typeHeadToken, 0, 0, arrayKind);

        stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])typePrimaryToken);
        if (primaryKind == TokenKind.IntegerType)
        {
            bitWidth = TypedSignatureIntegerBitWidth(source, stream, typePrimaryToken);
        }
        else if (primaryKind == TokenKind.FloatType)
        {
            bitWidth = TypedSignatureFloatBitWidth(source, stream, typePrimaryToken);
        }

        if (typeHeadToken != 0 && stream.KindAt((u64[0 2 ** 63 - 1])(typeHeadToken + 1)) == TokenKind.Lt)
        {
            TypedSignatureCountGenericArgumentsInList(stream, (u32[0 max])(typeHeadToken + 1), typeArgumentCount, comptimeArgumentCount);
        }

        typeFlags = TypedSignatureFlagsForType(
            source,
            stream,
            typePrimaryToken,
            typeHeadToken,
            typeStartToken,
            typeEndToken,
            0,
            0,
            rangeStartToken,
            rangeEndToken,
            elementCountStartToken,
            false,
            0,
            false);
    }

    stack mut u32[0 max] initializerStartToken = 0;
    stack mut u32[0 max] initializerEndToken = 0;
    stack u32[0 max] assignToken = TypedGlobalFindAssignToken(stream, item);
    if (assignToken != 0)
    {
        initializerStartToken = (u32[0 max])(assignToken + 1);
        initializerEndToken = TypedGlobalInitializerEndExclusive(stream, item);
    }

    return table.Append(
        declarationIndex,
        item,
        nameToken,
        TypedGlobalBindingKindForItem(stream, item),
        TypedGlobalStorageKindForItem(stream, item),
        typeKind,
        typeHeadToken,
        typePrimaryToken,
        typeStartToken,
        typeEndToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        elementCountEndToken,
        bitWidth,
        typeArgumentCount,
        comptimeArgumentCount,
        typeFlags,
        initializerStartToken,
        initializerEndToken);
}

internal finite law TypedGlobalStorageKind TypedLocalDeclarationStorageKind(borrow TokenStream stream, u32[0 max] startToken)
{
    switch (stream.KindAt((u64[0 2 ** 63 - 1])startToken))
    {
        case TokenKind.Const:
            return TypedGlobalStorageKind.Const;
        case TokenKind.Static:
            return TypedGlobalStorageKind.Static;
        case TokenKind.Heap:
            return TypedGlobalStorageKind.Heap;
        case TokenKind.Stack:
            return TypedGlobalStorageKind.Stack;
        case TokenKind.Register:
            return TypedGlobalStorageKind.Register;
        case TokenKind.Arena:
            return TypedGlobalStorageKind.Arena;
        default:
            return TypedGlobalStorageKind.Unknown;
    }
}
