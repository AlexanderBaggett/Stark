import Compiler.Lexing
import Compiler.Parsing
import Compiler.Typing.TypedEnumPayloads
import Compiler.Typing.TypedSignatures
import System.Memory
module Compiler.Typing.TypedEnumLayoutVariants

internal struct TypedEnumVariantLayoutScanTable
{
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic bool UnitVariants;
    internal dynamic TypedEnumVariantRole VariantRoles;

    TypedEnumVariantLayoutScanTable()
    {
        self.StartTokens = new();
        self.NameTokens = new();
        self.UnitVariants = new();
        self.VariantRoles = new();
    }

    internal inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedEnumVariantLayoutScanTable self)
    {
        return self.NameTokens.Length;
    }

    internal law u32[0 max] StartTokenAt(borrow TypedEnumVariantLayoutScanTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.StartTokens.Length)
        {
            token = self.StartTokens[index];
        }

        return token;
    }

    internal law u32[0 max] NameTokenAt(borrow TypedEnumVariantLayoutScanTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    internal law bool IsUnitVariantAt(borrow TypedEnumVariantLayoutScanTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut bool value = false;
        if (index < self.UnitVariants.Length)
        {
            value = self.UnitVariants[index];
        }

        return value;
    }

    internal law TypedEnumVariantRole VariantRoleAt(borrow TypedEnumVariantLayoutScanTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedEnumVariantRole role = TypedEnumVariantRole.None;
        if (index < self.VariantRoles.Length)
        {
            role = self.VariantRoles[index];
        }

        return role;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedEnumVariantLayoutScanTable self,
        u32[0 max] startToken,
        u32[0 max] nameToken,
        bool isUnitVariant,
        TypedEnumVariantRole variantRole)
    {
        if (!self.StartTokens.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.UnitVariants.TryReserve(1)
            || !self.VariantRoles.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.StartTokens[self.StartTokens.Length] = startToken;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.UnitVariants[self.UnitVariants.Length] = isUnitVariant;
        init self.VariantRoles[self.VariantRoles.Length] = variantRole;
        return System.Memory.MemoryStatus.Ok;
    }
}


internal finite law bool TypedEnumLayoutVariantIsUnit(borrow TokenStream stream, u32[0 max] variantNameToken, u32[0 max] variantEndExclusive)
{
    stack mut u32[0 max] scan = (u32[0 max])(variantNameToken + 1);
    stack mut u32[0 max] depth = 0;
    while willexit (scan < variantEndExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && (kind == TokenKind.From || kind == TokenKind.LParen || kind == TokenKind.LBrace))
        {
            return false;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return true;
}

internal fn System.Memory.MemoryStatus AppendTypedEnumLayoutVariantsForDeclaration(
    mut borrow TypedEnumVariantLayoutScanTable variants,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner)
{
    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, owner);
    if (bodyOpen == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] variantStart = (u32[0 max])(bodyOpen + 1);
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        while willexit (stream.KindAt((u64[0 2 ** 63 - 1])variantStart) == TokenKind.Comma)
        {
            variantStart = (u32[0 max])(variantStart + 1);
        }

        stack TokenKind startKind = stream.KindAt((u64[0 2 ** 63 - 1])variantStart);
        if (startKind == TokenKind.EndOfFile || startKind == TokenKind.RBrace)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack mut u32[0 max] scan = variantStart;
        stack mut u32[0 max] depth = 0;
        stack mut u32[0 max] variantNameToken = 0;
        stack mut u32[0 max] delimiter = 0;
        stack mut bool reachedBodyEnd = false;
        while willexit (guard > 0)
        {
            guard = (u64[0 2 ** 63 - 1])(guard - 1);
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.EndOfFile)
            {
                delimiter = scan;
                reachedBodyEnd = true;
                break;
            }

            if (depth == 0 && (kind == TokenKind.Comma || kind == TokenKind.RBrace))
            {
                delimiter = scan;
                reachedBodyEnd = kind == TokenKind.RBrace;
                break;
            }

            if (depth == 0 && variantNameToken == 0 && kind == TokenKind.Identifier)
            {
                variantNameToken = scan;
            }

            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }

            scan = (u32[0 max])(scan + 1);
        }

        if (delimiter == 0)
        {
            delimiter = scan;
        }

        if (variantNameToken != 0)
        {
            switch (variants.Append(
                variantStart,
                variantNameToken,
                TypedEnumLayoutVariantIsUnit(stream, variantNameToken, delimiter),
                TypedEnumPayloadVariantRole(source, stream, variantStart, variantNameToken)))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (reachedBodyEnd)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        variantStart = (u32[0 max])(delimiter + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal finite law u32[0 max] TypedEnumLayoutFirstUnitOrdinal(borrow TypedEnumVariantLayoutScanTable variants)
{
    stack u64[0 2 ** 63 - 1] count = variants.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        if (variants.IsUnitVariantAt(index))
        {
            return (u32[0 max])index;
        }
    }

    return (u32[0 max])count;
}

internal finite law u32[0 max] TypedEnumLayoutTagForSourceOrdinal(u32[0 max] sourceOrdinal, u32[0 max] firstUnitOrdinal, u32[0 max] variantCount)
{
    if (firstUnitOrdinal == 0 || firstUnitOrdinal >= variantCount)
    {
        return sourceOrdinal;
    }

    if (sourceOrdinal == firstUnitOrdinal)
    {
        return 0;
    }

    if (sourceOrdinal < firstUnitOrdinal)
    {
        return (u32[0 max])(sourceOrdinal + 1);
    }

    return sourceOrdinal;
}

internal finite law u32[0 max] TypedEnumLayoutSourceOrdinalForTag(u32[0 max] tag, u32[0 max] firstUnitOrdinal, u32[0 max] variantCount)
{
    if (firstUnitOrdinal == 0 || firstUnitOrdinal >= variantCount)
    {
        return tag;
    }

    if (tag == 0)
    {
        return firstUnitOrdinal;
    }

    if (tag <= firstUnitOrdinal)
    {
        return (u32[0 max])(tag - 1);
    }

    return tag;
}

internal fn u32[0 max] TypedEnumLayoutPayloadCountForVariant(
    borrow TypedEnumPayloadTable payloads,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal)
{
    stack mut u32[0 max] count = 0;
    stack u64[0 2 ** 63 - 1] payloadCount = payloads.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < payloadCount; index += 1)
    {
        if (payloads.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && payloads.VariantOrdinalAt(index) == variantOrdinal)
        {
            count = (u32[0 max])(count + 1);
        }
    }

    return count;
}

internal fn bool TypedEnumLayoutVariantUsesNamedPayloads(
    borrow TypedEnumPayloadTable payloads,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal)
{
    stack u64[0 2 ** 63 - 1] payloadCount = payloads.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < payloadCount; index += 1)
    {
        if (payloads.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && payloads.VariantOrdinalAt(index) == variantOrdinal
            && payloads.PayloadKindAt(index) == TypedEnumPayloadKind.Named)
        {
            return true;
        }
    }

    return false;
}

internal fn bool TypedEnumLayoutVariantIsErrorFunnel(
    borrow TypedEnumPayloadTable payloads,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal)
{
    stack u64[0 2 ** 63 - 1] payloadCount = payloads.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < payloadCount; index += 1)
    {
        if (payloads.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && payloads.VariantOrdinalAt(index) == variantOrdinal
            && payloads.IsErrorFunnelAt(index))
        {
            return true;
        }
    }

    return false;
}

internal fn u32[0 max] TypedEnumLayoutPayloadIndexPlusOne(
    borrow TypedEnumPayloadTable payloads,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] variantOrdinal,
    u32[0 max] payloadOrdinal)
{
    stack u64[0 2 ** 63 - 1] payloadCount = payloads.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < payloadCount; index += 1)
    {
        if (payloads.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
            && payloads.VariantOrdinalAt(index) == variantOrdinal
            && payloads.PayloadOrdinalAt(index) == payloadOrdinal)
        {
            return (u32[0 max])(index + 1);
        }
    }

    return 0;
}

