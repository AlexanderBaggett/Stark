    TypedAssignmentExpressionTable()
    {
        self.Contexts = new();
        self.OwnerDeclarationIndices = new();
        self.OwnerNameTokens = new();
        self.FunctionNameTokens = new();
        self.StatementIndices = new();
        self.AssignmentNodes = new();
        self.AssignmentTokens = new();
        self.TargetNodes = new();
        self.ValueNodes = new();
        self.OperatorKinds = new();
        self.TargetKinds = new();
        self.ValueKinds = new();
        self.IdentifierTargetKinds = new();
        self.MemberTargetKinds = new();
        self.IndexAccessKinds = new();
        self.TargetDeclarationIndices = new();
        self.TargetSymbolIndices = new();
        self.TargetNameTokens = new();
        self.TargetStorageKinds = new();
        self.TargetBindingKinds = new();
        self.TargetTypeKinds = new();
        self.TargetTypeHeadTokens = new();
        self.TargetTypePrimaryTokens = new();
        self.TargetTypeStartTokens = new();
        self.TargetTypeEndTokens = new();
        self.TargetRangeStartTokens = new();
        self.TargetRangeEndTokens = new();
        self.TargetElementCountStartTokens = new();
        self.TargetElementCountEndTokens = new();
        self.TargetBitWidths = new();
        self.TargetTypeArgumentCounts = new();
        self.TargetComptimeArgumentCounts = new();
        self.TargetTypeFlags = new();
        self.ValueTypeKinds = new();
        self.ValueTypeHeadTokens = new();
        self.ValueTypePrimaryTokens = new();
        self.ValueTypeStartTokens = new();
        self.ValueTypeEndTokens = new();
        self.ValueRangeStartTokens = new();
        self.ValueRangeEndTokens = new();
        self.ValueElementCountStartTokens = new();
        self.ValueElementCountEndTokens = new();
        self.ValueBitWidths = new();
        self.ValueTypeArgumentCounts = new();
        self.ValueComptimeArgumentCounts = new();
        self.ValueTypeFlags = new();
        self.AssignmentFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedAssignmentExpressionTable self)
    {
        return self.AssignmentNodes.Length;
    }

    public law TypedAssignmentContext ContextAt(borrow TypedAssignmentExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedAssignmentContext context = TypedAssignmentContext.Unknown;
        if (index < self.Contexts.Length)
        {
            context = self.Contexts[index];
        }

        return context;
    }

