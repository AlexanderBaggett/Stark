    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedCallExpressionTable self)
    {
        return self.CallNodes.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] ArgumentCount(borrow TypedCallExpressionTable self)
