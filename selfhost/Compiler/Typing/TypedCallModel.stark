    public law TypedCallContext ContextAt(borrow TypedCallExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedCallContext context = TypedCallContext.Unknown;
        if (index < self.Contexts.Length)
        {
            context = self.Contexts[index];
        }

        return context;
