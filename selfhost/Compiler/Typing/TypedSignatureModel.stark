        stack mut u32[0 max] token = 0;
        if (slot < self.ElementCountStartTokens.Length)
        {
            token = self.ElementCountStartTokens[slot];
        }

        return token;
    }

    public law u32[0 max] ElementCountEndTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.ElementCountEndTokens.Length)
        {
            token = self.ElementCountEndTokens[slot];
        }

        return token;
    }

    public law u32[0 max] BitWidthAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] width = 0;
        if (slot < self.BitWidths.Length)
        {
            width = self.BitWidths[slot];
        }

        return width;
    }

    public law u32[0 max] TypeArgumentCountAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] count = 0;
        if (slot < self.TypeArgumentCounts.Length)
        {
            count = self.TypeArgumentCounts[slot];
        }

        return count;
    }

    public law u32[0 max] ComptimeArgumentCountAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] count = 0;
        if (slot < self.ComptimeArgumentCounts.Length)
        {
            count = self.ComptimeArgumentCounts[slot];
        }

        return count;
    }

    public law u32[0 max] DeadOnReturnCountAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] count = 0;
        if (slot < self.DeadOnReturnCounts.Length)
        {
            count = self.DeadOnReturnCounts[slot];
        }

        return count;
    }

    public law u32[0 max] TypeFlagsAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] flags = 0;
        if (slot < self.TypeFlags.Length)
        {
            flags = self.TypeFlags[slot];
        }

        return flags;
    }

    public law bool IsIntegerSignedAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagIntegerSigned());
    }

    public law bool IsIntegerUnsignedAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagIntegerUnsigned());
    }

    public law bool HasIntegerRangeAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagHasIntegerRange());
    }

    public law bool IsBorrowAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagBorrow());
    }

    public law bool IsOutAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagOut());
    }

    public law bool IsRawMutablePointerAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagRawMutablePointer());
    }

    public law bool HasElementCountExpressionAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagHasElementCountExpression());
    }

    public law bool IsTailCallableAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagTailCallable());
    }

    public law bool IsDeadOnReturnAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagDeadOnReturn());
    }

    public law bool TypeHeadIsGenericParameterAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(slot), TypedSignatureTypeFlagHeadIsGenericParameter());
    }

    internal fn System.Memory.MemoryStatus AppendSignature(
        mut borrow TypedFunctionSignatureTable self,
        TypedSignatureOwnerKind ownerKind,
        u32[0 max] ownerNameToken,
        u32[0 max] keywordToken,
        u32[0 max] nameToken,
        u32[0 max] paramCount,
        u32[0 max] genericParamCount,
        u32[0 max] comptimeGenericParamCount,
        u32[0 max] flags,
        out u32[0 max] signatureIndexPlusOne)
    {
        signatureIndexPlusOne = 0;
        if (!self.OwnerKinds.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.ReturnTypeSlots.TryReserve(1)
            || !self.TypeSlotStarts.TryReserve(1)
            || !self.TypeSlotCounts.TryReserve(1)
            || !self.ParamCounts.TryReserve(1)
            || !self.GenericParamCounts.TryReserve(1)
            || !self.ComptimeGenericParamCounts.TryReserve(1)
            || !self.Flags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        signatureIndexPlusOne = (u32[0 max])(self.NameTokens.Length + 1);
        init self.OwnerKinds[self.OwnerKinds.Length] = ownerKind;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.KeywordTokens[self.KeywordTokens.Length] = keywordToken;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.ReturnTypeSlots[self.ReturnTypeSlots.Length] = 0;
        init self.TypeSlotStarts[self.TypeSlotStarts.Length] = (u32[0 max])(self.TypeKinds.Length + 1);
        init self.TypeSlotCounts[self.TypeSlotCounts.Length] = 0;
        init self.ParamCounts[self.ParamCounts.Length] = paramCount;
        init self.GenericParamCounts[self.GenericParamCounts.Length] = genericParamCount;
        init self.ComptimeGenericParamCounts[self.ComptimeGenericParamCounts.Length] = comptimeGenericParamCount;
        init self.Flags[self.Flags.Length] = flags;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus AppendTypeSlot(
        mut borrow TypedFunctionSignatureTable self,
        u32[0 max] signatureIndexPlusOne,
        TypedSignatureSlotKind slotKind,
        u32[0 max] paramOrdinal,
        u32[0 max] paramNameToken,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] elementCountStartToken,
        u32[0 max] elementCountEndToken,
        u32[0 max] bitWidth,
        u32[0 max] typeArgumentCount,
        u32[0 max] comptimeArgumentCount,
        u32[0 max] deadOnReturnCount,
        u32[0 max] flags,
        out u32[0 max] slotIndexPlusOne)
    {
        slotIndexPlusOne = 0;
        if (!self.TypeSlotSignatureIndices.TryReserve(1)
            || !self.TypeSlotKinds.TryReserve(1)
            || !self.TypeSlotParamOrdinals.TryReserve(1)
            || !self.TypeSlotParamNameTokens.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ElementCountStartTokens.TryReserve(1)
            || !self.ElementCountEndTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeArgumentCounts.TryReserve(1)
            || !self.ComptimeArgumentCounts.TryReserve(1)
            || !self.DeadOnReturnCounts.TryReserve(1)
            || !self.TypeFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        stack u32[0 max] storedSlotIndexPlusOne = (u32[0 max])(self.TypeKinds.Length + 1);
        slotIndexPlusOne = storedSlotIndexPlusOne;
        init self.TypeSlotSignatureIndices[self.TypeSlotSignatureIndices.Length] = signatureIndexPlusOne;
        init self.TypeSlotKinds[self.TypeSlotKinds.Length] = slotKind;
        init self.TypeSlotParamOrdinals[self.TypeSlotParamOrdinals.Length] = paramOrdinal;
        init self.TypeSlotParamNameTokens[self.TypeSlotParamNameTokens.Length] = paramNameToken;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ElementCountStartTokens[self.ElementCountStartTokens.Length] = elementCountStartToken;
        init self.ElementCountEndTokens[self.ElementCountEndTokens.Length] = elementCountEndToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeArgumentCounts[self.TypeArgumentCounts.Length] = typeArgumentCount;
        init self.ComptimeArgumentCounts[self.ComptimeArgumentCounts.Length] = comptimeArgumentCount;
        init self.DeadOnReturnCounts[self.DeadOnReturnCounts.Length] = deadOnReturnCount;
        init self.TypeFlags[self.TypeFlags.Length] = flags;

        if (signatureIndexPlusOne > 0)
        {
            stack u64[0 2 ** 63 - 1] sigIndex = (u64[0 2 ** 63 - 1])(signatureIndexPlusOne - 1);
            if (sigIndex < self.TypeSlotCounts.Length)
            {
                self.TypeSlotCounts[sigIndex] = (u32[0 max])(self.TypeSlotCounts[sigIndex] + 1);
            }

            if (slotKind == TypedSignatureSlotKind.Return && sigIndex < self.ReturnTypeSlots.Length)
            {
                self.ReturnTypeSlots[sigIndex] = storedSlotIndexPlusOne;
            }
        }

        return System.Memory.MemoryStatus.Ok;
    }
}
