import Compiler.Typing.TypedTypeResolution
import System.Memory
module Compiler.Typing.TypedSignatureModel

public enum TypedSignatureOwnerKind
{
    TopLevelFunction,
    MemberMethod,
    Unknown,
}

public enum TypedSignatureSlotKind
{
    Return,
    Parameter,
}

public struct TypedFunctionSignatureTable
{
    internal dynamic TypedSignatureOwnerKind OwnerKinds;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic u32[0 max] KeywordTokens;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] ReturnTypeSlots;
    internal dynamic u32[0 max] TypeSlotStarts;
    internal dynamic u32[0 max] TypeSlotCounts;
    internal dynamic u32[0 max] ParamCounts;
    internal dynamic u32[0 max] GenericParamCounts;
    internal dynamic u32[0 max] ComptimeGenericParamCounts;
    internal dynamic u32[0 max] Flags;

    internal dynamic u32[0 max] TypeSlotSignatureIndices;
    internal dynamic TypedSignatureSlotKind TypeSlotKinds;
    internal dynamic u32[0 max] TypeSlotParamOrdinals;
    internal dynamic u32[0 max] TypeSlotParamNameTokens;
    internal dynamic TypedSignatureTypeKind TypeKinds;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic u32[0 max] RangeStartTokens;
    internal dynamic u32[0 max] RangeEndTokens;
    internal dynamic u32[0 max] ElementCountStartTokens;
    internal dynamic u32[0 max] ElementCountEndTokens;
    internal dynamic u32[0 max] BitWidths;
    internal dynamic u32[0 max] TypeArgumentCounts;
    internal dynamic u32[0 max] ComptimeArgumentCounts;
    internal dynamic u32[0 max] DeadOnReturnCounts;
    internal dynamic u32[0 max] TypeFlags;

    TypedFunctionSignatureTable()
    {
        self.OwnerKinds = new();
        self.OwnerNameTokens = new();
        self.KeywordTokens = new();
        self.NameTokens = new();
        self.ReturnTypeSlots = new();
        self.TypeSlotStarts = new();
        self.TypeSlotCounts = new();
        self.ParamCounts = new();
        self.GenericParamCounts = new();
        self.ComptimeGenericParamCounts = new();
        self.Flags = new();

        self.TypeSlotSignatureIndices = new();
        self.TypeSlotKinds = new();
        self.TypeSlotParamOrdinals = new();
        self.TypeSlotParamNameTokens = new();
        self.TypeKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.RangeStartTokens = new();
        self.RangeEndTokens = new();
        self.ElementCountStartTokens = new();
        self.ElementCountEndTokens = new();
        self.BitWidths = new();
        self.TypeArgumentCounts = new();
        self.ComptimeArgumentCounts = new();
        self.DeadOnReturnCounts = new();
        self.TypeFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedFunctionSignatureTable self)
    {
        return self.NameTokens.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] TypeSlotCount(borrow TypedFunctionSignatureTable self)
    {
        return self.TypeKinds.Length;
    }

    public law TypedSignatureOwnerKind OwnerKindAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedSignatureOwnerKind kind = TypedSignatureOwnerKind.Unknown;
        if (index < self.OwnerKinds.Length)
        {
            kind = self.OwnerKinds[index];
        }

        return kind;
    }

    public law u32[0 max] OwnerNameTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.OwnerNameTokens.Length)
        {
            token = self.OwnerNameTokens[index];
        }

        return token;
    }

    public law u32[0 max] KeywordTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.KeywordTokens.Length)
        {
            token = self.KeywordTokens[index];
        }

        return token;
    }

    public law u32[0 max] NameTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law u32[0 max] ReturnTypeSlotIndexPlusOneAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] slot = 0;
        if (index < self.ReturnTypeSlots.Length)
        {
            slot = self.ReturnTypeSlots[index];
        }

        return slot;
    }

    public law u32[0 max] ParameterTypeSlotIndexPlusOneAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] signatureIndex, u32[0 max] parameterIndex)
    {
        stack mut u32[0 max] slot = 0;
        if (signatureIndex < self.TypeSlotStarts.Length && parameterIndex < self.ParamCountAt(signatureIndex))
        {
            slot = (u32[0 max])(self.TypeSlotStarts[signatureIndex] + 1 + parameterIndex);
        }

        return slot;
    }

    public law u32[0 max] TypeSlotCountAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.TypeSlotCounts.Length)
        {
            count = self.TypeSlotCounts[index];
        }

        return count;
    }

    public law u32[0 max] ParamCountAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ParamCounts.Length)
        {
            count = self.ParamCounts[index];
        }

        return count;
    }

    public law u32[0 max] GenericParamCountAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.GenericParamCounts.Length)
        {
            count = self.GenericParamCounts[index];
        }

        return count;
    }

    public law u32[0 max] ComptimeGenericParamCountAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ComptimeGenericParamCounts.Length)
        {
            count = self.ComptimeGenericParamCounts[index];
        }

        return count;
    }

    public law u32[0 max] FlagsAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flags = 0;
        if (index < self.Flags.Length)
        {
            flags = self.Flags[index];
        }

        return flags;
    }

    public law u32[0 max] TypeSlotSignatureIndexPlusOneAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] value = 0;
        if (slot < self.TypeSlotSignatureIndices.Length)
        {
            value = self.TypeSlotSignatureIndices[slot];
        }

        return value;
    }

    public law TypedSignatureSlotKind TypeSlotKindAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut TypedSignatureSlotKind kind = TypedSignatureSlotKind.Return;
        if (slot < self.TypeSlotKinds.Length)
        {
            kind = self.TypeSlotKinds[slot];
        }

        return kind;
    }

    public law u32[0 max] TypeSlotParamOrdinalAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] ordinal = 0;
        if (slot < self.TypeSlotParamOrdinals.Length)
        {
            ordinal = self.TypeSlotParamOrdinals[slot];
        }

        return ordinal;
    }

    public law u32[0 max] TypeSlotParamNameTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypeSlotParamNameTokens.Length)
        {
            token = self.TypeSlotParamNameTokens[slot];
        }

        return token;
    }

    public law TypedSignatureTypeKind TypeKindAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut TypedSignatureTypeKind kind = TypedSignatureTypeKind.Unknown;
        if (slot < self.TypeKinds.Length)
        {
            kind = self.TypeKinds[slot];
        }

        return kind;
    }

    public law u32[0 max] TypeHeadTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypeHeadTokens.Length)
        {
            token = self.TypeHeadTokens[slot];
        }

        return token;
    }

    public law u32[0 max] TypePrimaryTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypePrimaryTokens.Length)
        {
            token = self.TypePrimaryTokens[slot];
        }

        return token;
    }

    public law u32[0 max] TypeStartTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypeStartTokens.Length)
        {
            token = self.TypeStartTokens[slot];
        }

        return token;
    }

    public law u32[0 max] TypeEndTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.TypeEndTokens.Length)
        {
            token = self.TypeEndTokens[slot];
        }

        return token;
    }

    public law u32[0 max] RangeStartTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.RangeStartTokens.Length)
        {
            token = self.RangeStartTokens[slot];
        }

        return token;
    }

    public law u32[0 max] RangeEndTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
    {
        stack mut u32[0 max] token = 0;
        if (slot < self.RangeEndTokens.Length)
        {
            token = self.RangeEndTokens[slot];
        }

        return token;
    }

    public law u32[0 max] ElementCountStartTokenAt(borrow TypedFunctionSignatureTable self, u64[0 2 ** 63 - 1] slot)
