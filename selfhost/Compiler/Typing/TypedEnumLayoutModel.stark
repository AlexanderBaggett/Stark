    internal dynamic TypedEnumPayloadKind PayloadKinds;
    internal dynamic TypedEnumVariantRole VariantRoles;
    internal dynamic bool ErrorFunnels;
    internal dynamic bool UsesNamedPayloads;
    internal dynamic u32[0 max] StorageFieldOrdinals;
    internal dynamic u64[0 max] OffsetBytes;
    internal dynamic u64[0 max] SizeBytes;
    internal dynamic u64[0 max] AlignmentBytes;
    internal dynamic bool Misaligneds;
    internal dynamic TypedSignatureTypeKind TypeKinds;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] BitWidths;
    internal dynamic u32[0 max] TypeFlags;
    internal dynamic u32[0 max] LayoutFlags;

    TypedEnumLayoutTable()
    {
        self.RowKinds = new();
        self.OwnerDeclarationIndices = new();
        self.OwnerNameTokens = new();
        self.VariantOrdinals = new();
        self.VariantNameTokens = new();
        self.VariantTags = new();
        self.PayloadCounts = new();
        self.PayloadOrdinals = new();
        self.PayloadNameTokens = new();
        self.PayloadKinds = new();
        self.VariantRoles = new();
        self.ErrorFunnels = new();
        self.UsesNamedPayloads = new();
        self.StorageFieldOrdinals = new();
        self.OffsetBytes = new();
        self.SizeBytes = new();
        self.AlignmentBytes = new();
        self.Misaligneds = new();
        self.TypeKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.BitWidths = new();
        self.TypeFlags = new();
        self.LayoutFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedEnumLayoutTable self)
