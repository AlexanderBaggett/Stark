    public law bool HasConcreteLayoutAt(borrow TypedEnumLayoutTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedEnumLayoutFlagPresent(self.LayoutFlagsAt(index), TypedEnumLayoutFlagConcrete());
    }

    public finite bool TryGetEnumTagLayout(
        borrow TypedEnumLayoutTable self,
        u32[0 max] ownerDeclarationIndex,
        out u64[0 max] offsetBytes,
        out u64[0 max] sizeBytes,
        out u64[0 max] alignmentBytes,
        out bool isMisaligned)
    {
        offsetBytes = 0;
        sizeBytes = 0;
        alignmentBytes = 1;
        isMisaligned = false;

        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
                && self.RowKindAt(index) == TypedEnumLayoutRowKind.Variant)
            {
                if (!self.HasConcreteLayoutAt(index))
                {
                    return false;
                }

                offsetBytes = self.OffsetBytesAt(index);
                sizeBytes = self.SizeBytesAt(index);
                alignmentBytes = self.AlignmentBytesAt(index);
                isMisaligned = self.IsMisalignedAt(index);
                return true;
            }
        }

        return false;
    }

    public finite bool TryGetEnumVariantTag(
        borrow TypedEnumLayoutTable self,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] variantOrdinal,
        out u64[0 max] tagValue)
    {
        tagValue = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
                && self.RowKindAt(index) == TypedEnumLayoutRowKind.Variant
                && self.VariantOrdinalAt(index) == variantOrdinal)
            {
                tagValue = (u64[0 max])self.VariantTagAt(index);
                return true;
            }
        }

        return false;
    }

    public finite bool TryGetEnumVariantPayloadCount(
        borrow TypedEnumLayoutTable self,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] variantOrdinal,
        out u64[0 max] payloadCount)
    {
        payloadCount = 0;
        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
                && self.RowKindAt(index) == TypedEnumLayoutRowKind.Variant
                && self.VariantOrdinalAt(index) == variantOrdinal)
            {
                payloadCount = (u64[0 max])self.PayloadCountAt(index);
                return true;
            }
        }

        return false;
    }

    public finite bool TryGetEnumVariantPayloadLayout(
        borrow TypedEnumLayoutTable self,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] variantOrdinal,
        u32[0 max] payloadOrdinal,
        out u64[0 max] offsetBytes,
        out u64[0 max] sizeBytes,
        out u64[0 max] alignmentBytes,
        out bool isMisaligned)
    {
        offsetBytes = 0;
        sizeBytes = 0;
        alignmentBytes = 1;
        isMisaligned = false;

        stack u64[0 2 ** 63 - 1] count = self.Count();
        for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
        {
            if (self.OwnerDeclarationIndexAt(index) == ownerDeclarationIndex
                && self.RowKindAt(index) == TypedEnumLayoutRowKind.Payload
                && self.VariantOrdinalAt(index) == variantOrdinal
                && self.PayloadOrdinalAt(index) == payloadOrdinal)
            {
                if (!self.HasConcreteLayoutAt(index))
                {
                    return false;
                }

                offsetBytes = self.OffsetBytesAt(index);
                sizeBytes = self.SizeBytesAt(index);
                alignmentBytes = self.AlignmentBytesAt(index);
                isMisaligned = self.IsMisalignedAt(index);
                return true;
            }
        }

        return false;
    }

    public finite bool TryFoldEnumTagLayoutQuery(
        borrow TypedEnumLayoutTable self,
        ascii source,
        borrow TokenStream stream,
        u32[0 max] queryNameToken,
        u32[0 max] ownerDeclarationIndex,
        out TypedLayoutQueryConstant constant)
    {
        constant = new();
        stack mut u64[0 max] offsetBytes = 0;
        stack mut u64[0 max] sizeBytes = 0;
        stack mut u64[0 max] alignmentBytes = 1;
        stack mut bool isMisaligned = false;
        if (!self.TryGetEnumTagLayout(ownerDeclarationIndex, offsetBytes, sizeBytes, alignmentBytes, isMisaligned))
        {
            return false;
        }

        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumTagOffset"))
        {
            constant.SetU64(offsetBytes);
            return true;
        }

        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumTagSize"))
        {
            constant.SetU64(sizeBytes);
            return true;
        }

        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumTagAlign"))
        {
            constant.SetU64(alignmentBytes);
            return true;
        }

        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumTagIsMisaligned"))
        {
            constant.SetBool(isMisaligned);
            return true;
        }

        return false;
    }

    public finite bool TryFoldEnumVariantLayoutQuery(
        borrow TypedEnumLayoutTable self,
        ascii source,
        borrow TokenStream stream,
        u32[0 max] queryNameToken,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] variantOrdinal,
        out TypedLayoutQueryConstant constant)
    {
        constant = new();
        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumVariantTag"))
        {
            stack mut u64[0 max] tagValue = 0;
            if (!self.TryGetEnumVariantTag(ownerDeclarationIndex, variantOrdinal, tagValue))
            {
                return false;
            }

            constant.SetU64(tagValue);
            return true;
        }

        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumVariantPayloadCount"))
        {
            stack mut u64[0 max] payloadCount = 0;
            if (!self.TryGetEnumVariantPayloadCount(ownerDeclarationIndex, variantOrdinal, payloadCount))
            {
                return false;
            }

            constant.SetU64(payloadCount);
            return true;
        }

        return false;
    }

    public finite bool TryFoldEnumVariantPayloadLayoutQuery(
        borrow TypedEnumLayoutTable self,
        ascii source,
        borrow TokenStream stream,
        u32[0 max] queryNameToken,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] variantOrdinal,
        u32[0 max] payloadOrdinal,
        out TypedLayoutQueryConstant constant)
    {
        constant = new();
        stack mut u64[0 max] offsetBytes = 0;
        stack mut u64[0 max] sizeBytes = 0;
        stack mut u64[0 max] alignmentBytes = 1;
        stack mut bool isMisaligned = false;
        if (!self.TryGetEnumVariantPayloadLayout(
            ownerDeclarationIndex,
            variantOrdinal,
            payloadOrdinal,
            offsetBytes,
            sizeBytes,
            alignmentBytes,
            isMisaligned))
        {
            return false;
        }

        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumVariantPayloadOffset"))
        {
            constant.SetU64(offsetBytes);
            return true;
        }

        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumVariantPayloadSize"))
        {
            constant.SetU64(sizeBytes);
            return true;
        }

        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumVariantPayloadAlign"))
        {
            constant.SetU64(alignmentBytes);
            return true;
        }

        if (TypedSignatureTokenTextEquals(source, stream, queryNameToken, "EnumVariantPayloadIsMisaligned"))
        {
            constant.SetBool(isMisaligned);
            return true;
        }

        return false;
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedEnumLayoutTable self,
        TypedEnumLayoutRowKind rowKind,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
        u32[0 max] variantOrdinal,
        u32[0 max] variantNameToken,
        u32[0 max] variantTag,
        u32[0 max] payloadCount,
        u32[0 max] payloadOrdinal,
        u32[0 max] payloadNameToken,
        TypedEnumPayloadKind payloadKind,
        TypedEnumVariantRole variantRole,
        bool errorFunnel,
        bool usesNamedPayloads,
        u32[0 max] storageFieldOrdinal,
        u64[0 max] offsetBytes,
        u64[0 max] sizeBytes,
        u64[0 max] alignmentBytes,
        bool misaligned,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] bitWidth,
        u32[0 max] typeFlags,
        u32[0 max] layoutFlags)
    {
        if (!self.RowKinds.TryReserve(1)
            || !self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.VariantOrdinals.TryReserve(1)
            || !self.VariantNameTokens.TryReserve(1)
            || !self.VariantTags.TryReserve(1)
            || !self.PayloadCounts.TryReserve(1)
            || !self.PayloadOrdinals.TryReserve(1)
            || !self.PayloadNameTokens.TryReserve(1)
            || !self.PayloadKinds.TryReserve(1)
            || !self.VariantRoles.TryReserve(1)
            || !self.ErrorFunnels.TryReserve(1)
            || !self.UsesNamedPayloads.TryReserve(1)
            || !self.StorageFieldOrdinals.TryReserve(1)
            || !self.OffsetBytes.TryReserve(1)
            || !self.SizeBytes.TryReserve(1)
            || !self.AlignmentBytes.TryReserve(1)
            || !self.Misaligneds.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeFlags.TryReserve(1)
            || !self.LayoutFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.RowKinds[self.RowKinds.Length] = rowKind;
        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.VariantOrdinals[self.VariantOrdinals.Length] = variantOrdinal;
        init self.VariantNameTokens[self.VariantNameTokens.Length] = variantNameToken;
        init self.VariantTags[self.VariantTags.Length] = variantTag;
        init self.PayloadCounts[self.PayloadCounts.Length] = payloadCount;
        init self.PayloadOrdinals[self.PayloadOrdinals.Length] = payloadOrdinal;
        init self.PayloadNameTokens[self.PayloadNameTokens.Length] = payloadNameToken;
        init self.PayloadKinds[self.PayloadKinds.Length] = payloadKind;
        init self.VariantRoles[self.VariantRoles.Length] = variantRole;
        init self.ErrorFunnels[self.ErrorFunnels.Length] = errorFunnel;
        init self.UsesNamedPayloads[self.UsesNamedPayloads.Length] = usesNamedPayloads;
        init self.StorageFieldOrdinals[self.StorageFieldOrdinals.Length] = storageFieldOrdinal;
        init self.OffsetBytes[self.OffsetBytes.Length] = offsetBytes;
        init self.SizeBytes[self.SizeBytes.Length] = sizeBytes;
        init self.AlignmentBytes[self.AlignmentBytes.Length] = alignmentBytes;
        init self.Misaligneds[self.Misaligneds.Length] = misaligned;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        init self.LayoutFlags[self.LayoutFlags.Length] = layoutFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}
