    public law u32[0 max] MemberPatternCountAt(borrow TypedSwitchAggregatePatternTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.MemberPatternCounts.Length)
        {
            count = self.MemberPatternCounts[index];
        }

        return count;
    }

    public fn System.Memory.MemoryStatus Append(
        mut borrow TypedSwitchAggregatePatternTable self,
        u32[0 max] patternStartToken,
        u32[0 max] patternEndToken,
        u32[0 max] ownerTypeHeadToken,
        u32[0 max] ownerTypePrimaryToken,
        u32[0 max] ownerTypeStartToken,
        u32[0 max] ownerTypeEndToken,
        u32[0 max] enumVariantOrdinalPlusOne,
        u32[0 max] wholeCaptureNameToken,
        u32[0 max] memberPatternStart,
        u32[0 max] memberPatternCount,
        out u32[0 max] row)
    {
        row = 0;
        if (!self.PatternStartTokens.TryReserve(1)
            || !self.PatternEndTokens.TryReserve(1)
            || !self.OwnerTypeHeadTokens.TryReserve(1)
            || !self.OwnerTypePrimaryTokens.TryReserve(1)
            || !self.OwnerTypeStartTokens.TryReserve(1)
            || !self.OwnerTypeEndTokens.TryReserve(1)
            || !self.EnumVariantOrdinalsPlusOne.TryReserve(1)
            || !self.WholeCaptureNameTokens.TryReserve(1)
            || !self.MemberPatternStarts.TryReserve(1)
            || !self.MemberPatternCounts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        row = (u32[0 max])(self.Count() + 1);
        init self.PatternStartTokens[self.PatternStartTokens.Length] = patternStartToken;
        init self.PatternEndTokens[self.PatternEndTokens.Length] = patternEndToken;
        init self.OwnerTypeHeadTokens[self.OwnerTypeHeadTokens.Length] = ownerTypeHeadToken;
        init self.OwnerTypePrimaryTokens[self.OwnerTypePrimaryTokens.Length] = ownerTypePrimaryToken;
        init self.OwnerTypeStartTokens[self.OwnerTypeStartTokens.Length] = ownerTypeStartToken;
        init self.OwnerTypeEndTokens[self.OwnerTypeEndTokens.Length] = ownerTypeEndToken;
        init self.EnumVariantOrdinalsPlusOne[self.EnumVariantOrdinalsPlusOne.Length] = enumVariantOrdinalPlusOne;
        init self.WholeCaptureNameTokens[self.WholeCaptureNameTokens.Length] = wholeCaptureNameToken;
        init self.MemberPatternStarts[self.MemberPatternStarts.Length] = memberPatternStart;
        init self.MemberPatternCounts[self.MemberPatternCounts.Length] = memberPatternCount;
        return System.Memory.MemoryStatus.Ok;
    }

    internal finite void SetMemberPatternSpanAt(
        mut borrow TypedSwitchAggregatePatternTable self,
        u32[0 max] row,
        u32[0 max] memberPatternStart,
        u32[0 max] memberPatternCount)
    {
        if (!self.ContainsRow(row))
        {
            return;
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(row - 1);
        unsafe
        {
            self.MemberPatternStarts[index] = memberPatternStart;
            self.MemberPatternCounts[index] = memberPatternCount;
        }

        return;
    }
}

