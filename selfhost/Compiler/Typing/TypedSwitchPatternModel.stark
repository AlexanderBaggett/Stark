import System.Memory
module Compiler.Typing.TypedSwitchPatternModel

public enum TypedSwitchPatternKind
{
    Discard,
    Literal,
    Range,
    Capture,
    Aggregate,
    EnumAggregate,
    List,
    Unknown,
}

public inline finite law bool TypedSwitchPatternKindIsKnown(TypedSwitchPatternKind kind)
{
    return kind == TypedSwitchPatternKind.Discard
        || kind == TypedSwitchPatternKind.Literal
        || kind == TypedSwitchPatternKind.Range
        || kind == TypedSwitchPatternKind.Capture
        || kind == TypedSwitchPatternKind.Aggregate
        || kind == TypedSwitchPatternKind.EnumAggregate
        || kind == TypedSwitchPatternKind.List;
}

public inline finite law bool TypedSwitchPatternKindIsNestedShape(TypedSwitchPatternKind kind)
{
    return kind == TypedSwitchPatternKind.Aggregate
        || kind == TypedSwitchPatternKind.EnumAggregate
        || kind == TypedSwitchPatternKind.List;
}

public struct TypedSwitchAggregatePatternTable
{
    internal dynamic u32[0 max] PatternStartTokens;
    internal dynamic u32[0 max] PatternEndTokens;
    internal dynamic u32[0 max] OwnerTypeHeadTokens;
    internal dynamic u32[0 max] OwnerTypePrimaryTokens;
    internal dynamic u32[0 max] OwnerTypeStartTokens;
    internal dynamic u32[0 max] OwnerTypeEndTokens;
    internal dynamic u32[0 max] EnumVariantOrdinalsPlusOne;
    internal dynamic u32[0 max] WholeCaptureNameTokens;
    internal dynamic u32[0 max] MemberPatternStarts;
    internal dynamic u32[0 max] MemberPatternCounts;

    TypedSwitchAggregatePatternTable()
