        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] literalToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] captureNameToken,
        u32[0 max] nestedAggregatePatternRow,
        u32[0 max] nestedListPatternRow,
        out u32[0 max] row)
    {
        row = 0;
        if (!self.MemberOrdinals.TryReserve(1)
            || !self.Kinds.TryReserve(1)
            || !self.PatternStartTokens.TryReserve(1)
            || !self.PatternEndTokens.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.LiteralTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.CaptureNameTokens.TryReserve(1)
            || !self.NestedAggregatePatternRows.TryReserve(1)
            || !self.NestedListPatternRows.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        row = (u32[0 max])(self.Count() + 1);
        init self.MemberOrdinals[self.MemberOrdinals.Length] = memberOrdinal;
        init self.Kinds[self.Kinds.Length] = kind;
        init self.PatternStartTokens[self.PatternStartTokens.Length] = patternStartToken;
        init self.PatternEndTokens[self.PatternEndTokens.Length] = patternEndToken;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.LiteralTokens[self.LiteralTokens.Length] = literalToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.CaptureNameTokens[self.CaptureNameTokens.Length] = captureNameToken;
        init self.NestedAggregatePatternRows[self.NestedAggregatePatternRows.Length] = nestedAggregatePatternRow;
        init self.NestedListPatternRows[self.NestedListPatternRows.Length] = nestedListPatternRow;
        return System.Memory.MemoryStatus.Ok;
    }

    internal finite void SetKindAt(
        mut borrow TypedSwitchPatternMemberTable self,
        u32[0 max] row,
        TypedSwitchPatternKind kind)
    {
        if (!self.ContainsRow(row))
        {
            return;
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(row - 1);
        unsafe
        {
            self.Kinds[index] = kind;
        }

        return;
    }

    internal finite void SetNestedAggregatePatternRowAt(
        mut borrow TypedSwitchPatternMemberTable self,
        u32[0 max] row,
        u32[0 max] nestedAggregatePatternRow)
    {
        if (!self.ContainsRow(row))
        {
            return;
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(row - 1);
        unsafe
        {
            self.NestedAggregatePatternRows[index] = nestedAggregatePatternRow;
        }

        return;
    }

    internal finite void SetNestedListPatternRowAt(
        mut borrow TypedSwitchPatternMemberTable self,
        u32[0 max] row,
        u32[0 max] nestedListPatternRow)
    {
        if (!self.ContainsRow(row))
        {
            return;
        }

        stack u64[0 2 ** 63 - 1] index = (u64[0 2 ** 63 - 1])(row - 1);
        unsafe
        {
            self.NestedListPatternRows[index] = nestedListPatternRow;
        }

        return;
    }
}

public struct TypedSwitchPatternTables
{
    public TypedSwitchAggregatePatternTable AggregatePatterns;
    public TypedSwitchListPatternTable ListPatterns;
    public TypedSwitchPatternMemberTable Members;

    TypedSwitchPatternTables()
    {
        self.AggregatePatterns = new();
        self.ListPatterns = new();
        self.Members = new();
    }
}
