    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedSwitchAggregatePatternTable self)
    {
        return self.PatternStartTokens.Length;
    }

    public inline finite law bool ContainsRow(borrow TypedSwitchAggregatePatternTable self, u32[0 max] row)
    {
        return row != 0 && (u64[0 2 ** 63 - 1])row <= self.Count();
    }

    public law u32[0 max] PatternStartTokenAt(borrow TypedSwitchAggregatePatternTable self, u64[0 2 ** 63 - 1] index)
    {
