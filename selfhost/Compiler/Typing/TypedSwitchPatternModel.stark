    public law u32[0 max] EnumVariantOrdinalPlusOneAt(borrow TypedSwitchAggregatePatternTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.EnumVariantOrdinalsPlusOne.Length)
        {
            value = self.EnumVariantOrdinalsPlusOne[index];
        }

        return value;
    }

    public law bool HasEnumVariantAt(borrow TypedSwitchAggregatePatternTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.EnumVariantOrdinalPlusOneAt(index) != 0;
    }

    public law u32[0 max] EnumVariantOrdinalAt(borrow TypedSwitchAggregatePatternTable self, u64[0 2 ** 63 - 1] index)
    {
        stack u32[0 max] ordinalPlusOne = self.EnumVariantOrdinalPlusOneAt(index);
        if (ordinalPlusOne == 0)
        {
            return 0;
        }

        return ordinalPlusOne - 1;
    }

    public law u32[0 max] WholeCaptureNameTokenAt(borrow TypedSwitchAggregatePatternTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
