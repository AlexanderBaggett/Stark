import Compiler.Parsing
import Compiler.Typing.TypedSignatures
import System.Memory
module Compiler.Typing.TypedGlobalModel

public enum TypedGlobalBindingKind
{
    Const,
    Immutable,
    Mutable,
    Unknown,
}

public enum TypedGlobalStorageKind
{
    Const,
    Static,
    Heap,
    Stack,
    Register,
    Arena,
    Unknown,
}


public struct TypedGlobalDeclarationTable
{
    internal dynamic u32[0 max] DeclarationIndices;
    internal dynamic DeclarationKind DeclarationKinds;
    internal dynamic TypedGlobalBindingKind BindingKinds;
    internal dynamic TypedGlobalStorageKind StorageKinds;
    internal dynamic u32[0 max] KeywordTokens;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] EndTokens;
    internal dynamic TypedSignatureTypeKind TypeKinds;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic u32[0 max] RangeStartTokens;
    internal dynamic u32[0 max] RangeEndTokens;
    internal dynamic u32[0 max] ElementCountStartTokens;
    internal dynamic u32[0 max] ElementCountEndTokens;
    internal dynamic u32[0 max] BitWidths;
    internal dynamic u32[0 max] TypeArgumentCounts;
    internal dynamic u32[0 max] ComptimeArgumentCounts;
    internal dynamic u32[0 max] TypeFlags;
    internal dynamic u32[0 max] InitializerStartTokens;
    internal dynamic u32[0 max] InitializerEndTokens;

    TypedGlobalDeclarationTable()
    {
        self.DeclarationIndices = new();
        self.DeclarationKinds = new();
        self.BindingKinds = new();
        self.StorageKinds = new();
        self.KeywordTokens = new();
        self.NameTokens = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.TypeKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.RangeStartTokens = new();
        self.RangeEndTokens = new();
        self.ElementCountStartTokens = new();
        self.ElementCountEndTokens = new();
        self.BitWidths = new();
        self.TypeArgumentCounts = new();
        self.ComptimeArgumentCounts = new();
        self.TypeFlags = new();
        self.InitializerStartTokens = new();
        self.InitializerEndTokens = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedGlobalDeclarationTable self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] DeclarationIndexAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.DeclarationIndices.Length)
        {
            value = self.DeclarationIndices[index];
        }

        return value;
    }

    public law DeclarationKind DeclarationKindAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut DeclarationKind kind = DeclarationKind.Unknown;
        if (index < self.DeclarationKinds.Length)
        {
            kind = self.DeclarationKinds[index];
        }

        return kind;
    }

    public law TypedGlobalBindingKind BindingKindAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedGlobalBindingKind kind = TypedGlobalBindingKind.Unknown;
        if (index < self.BindingKinds.Length)
        {
            kind = self.BindingKinds[index];
        }

        return kind;
    }

    public law TypedGlobalStorageKind StorageKindAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedGlobalStorageKind kind = TypedGlobalStorageKind.Unknown;
        if (index < self.StorageKinds.Length)
        {
            kind = self.StorageKinds[index];
        }

        return kind;
    }

    public law u32[0 max] KeywordTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.KeywordTokens.Length)
        {
            token = self.KeywordTokens[index];
        }

        return token;
    }

    public law u32[0 max] NameTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law u32[0 max] StartTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.StartTokens.Length)
        {
            token = self.StartTokens[index];
        }

        return token;
    }

    public law u32[0 max] EndTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.EndTokens.Length)
        {
            token = self.EndTokens[index];
        }

        return token;
    }

    public law TypedSignatureTypeKind TypeKindAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedSignatureTypeKind kind = TypedSignatureTypeKind.Unknown;
        if (index < self.TypeKinds.Length)
        {
            kind = self.TypeKinds[index];
        }

        return kind;
    }

    public law u32[0 max] TypeHeadTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeHeadTokens.Length)
        {
            token = self.TypeHeadTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypePrimaryTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypePrimaryTokens.Length)
        {
            token = self.TypePrimaryTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeStartTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeStartTokens.Length)
        {
            token = self.TypeStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeEndTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeEndTokens.Length)
        {
            token = self.TypeEndTokens[index];
        }

        return token;
    }

    public law u32[0 max] RangeStartTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.RangeStartTokens.Length)
        {
            token = self.RangeStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] RangeEndTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.RangeEndTokens.Length)
        {
            token = self.RangeEndTokens[index];
        }

        return token;
    }

    public law u32[0 max] ElementCountStartTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ElementCountStartTokens.Length)
        {
            token = self.ElementCountStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] ElementCountEndTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ElementCountEndTokens.Length)
        {
            token = self.ElementCountEndTokens[index];
        }

        return token;
    }

    public law u32[0 max] BitWidthAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] width = 0;
        if (index < self.BitWidths.Length)
        {
            width = self.BitWidths[index];
        }

        return width;
    }

    public law u32[0 max] TypeArgumentCountAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.TypeArgumentCounts.Length)
        {
            count = self.TypeArgumentCounts[index];
        }

        return count;
    }

    public law u32[0 max] ComptimeArgumentCountAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ComptimeArgumentCounts.Length)
        {
            count = self.ComptimeArgumentCounts[index];
        }

        return count;
    }

    public law u32[0 max] TypeFlagsAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flags = 0;
        if (index < self.TypeFlags.Length)
        {
            flags = self.TypeFlags[index];
        }

        return flags;
    }

    public law u32[0 max] InitializerStartTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.InitializerStartTokens.Length)
        {
            token = self.InitializerStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] InitializerEndTokenAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.InitializerEndTokens.Length)
        {
            token = self.InitializerEndTokens[index];
        }

        return token;
    }

    public law bool HasExplicitTypeAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TypeStartTokenAt(index) != 0 && self.TypeEndTokenAt(index) > self.TypeStartTokenAt(index);
    }

    public law bool HasInitializerAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.InitializerStartTokenAt(index) != 0 && self.InitializerEndTokenAt(index) > self.InitializerStartTokenAt(index);
    }

    public law bool IsConstAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.BindingKindAt(index) == TypedGlobalBindingKind.Const;
    }

    public law bool IsImmutableAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.BindingKindAt(index) == TypedGlobalBindingKind.Immutable;
    }

    public law bool IsMutableAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.BindingKindAt(index) == TypedGlobalBindingKind.Mutable;
    }

    public law bool IsIntegerSignedAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerSigned());
    }

    public law bool IsIntegerUnsignedAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerUnsigned());
    }

    public law bool HasIntegerRangeAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHasIntegerRange());
    }

    public law bool RangeStartsAtMinAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRangeStartsAtMin());
    }

    public law bool RangeEndsAtMaxAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRangeEndsAtMax());
    }

    public law bool IsBorrowAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagBorrow());
    }

    public law bool IsOutAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagOut());
    }

    public law bool IsRawMutablePointerAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRawMutablePointer());
    }

    public law bool HasElementCountExpressionAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHasElementCountExpression());
    }

    public law bool IsTailCallableAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagTailCallable());
    }

    public law bool IsOwnedTextAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagOwnedText());
    }

    public law bool IsUnicodeTextAt(borrow TypedGlobalDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagUnicodeText());
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedGlobalDeclarationTable self,
        u32[0 max] declarationIndex,
        DeclItem item,
        u32[0 max] nameToken,
        TypedGlobalBindingKind bindingKind,
        TypedGlobalStorageKind storageKind,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] elementCountStartToken,
        u32[0 max] elementCountEndToken,
        u32[0 max] bitWidth,
        u32[0 max] typeArgumentCount,
        u32[0 max] comptimeArgumentCount,
        u32[0 max] typeFlags,
        u32[0 max] initializerStartToken,
        u32[0 max] initializerEndToken)
    {
        if (!self.DeclarationIndices.TryReserve(1)
            || !self.DeclarationKinds.TryReserve(1)
            || !self.BindingKinds.TryReserve(1)
            || !self.StorageKinds.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ElementCountStartTokens.TryReserve(1)
            || !self.ElementCountEndTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeArgumentCounts.TryReserve(1)
            || !self.ComptimeArgumentCounts.TryReserve(1)
            || !self.TypeFlags.TryReserve(1)
            || !self.InitializerStartTokens.TryReserve(1)
            || !self.InitializerEndTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.DeclarationIndices[self.DeclarationIndices.Length] = declarationIndex;
        init self.DeclarationKinds[self.DeclarationKinds.Length] = item.Kind;
        init self.BindingKinds[self.BindingKinds.Length] = bindingKind;
        init self.StorageKinds[self.StorageKinds.Length] = storageKind;
        init self.KeywordTokens[self.KeywordTokens.Length] = item.KeywordToken;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.StartTokens[self.StartTokens.Length] = item.StartToken;
        init self.EndTokens[self.EndTokens.Length] = item.EndToken;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ElementCountStartTokens[self.ElementCountStartTokens.Length] = elementCountStartToken;
        init self.ElementCountEndTokens[self.ElementCountEndTokens.Length] = elementCountEndToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeArgumentCounts[self.TypeArgumentCounts.Length] = typeArgumentCount;
        init self.ComptimeArgumentCounts[self.ComptimeArgumentCounts.Length] = comptimeArgumentCount;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        init self.InitializerStartTokens[self.InitializerStartTokens.Length] = initializerStartToken;
        init self.InitializerEndTokens[self.InitializerEndTokens.Length] = initializerEndToken;
        return System.Memory.MemoryStatus.Ok;
    }
}
