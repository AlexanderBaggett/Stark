        self.TargetKinds = new();
        self.TargetDeclarationIndices = new();
        self.TargetSymbolIndices = new();
        self.TargetNameTokens = new();
        self.CandidateStarts = new();
        self.CandidateCounts = new();
        self.MemberFlags = new();
        self.TypeKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.RangeStartTokens = new();
        self.RangeEndTokens = new();
        self.ElementCountStartTokens = new();
        self.ElementCountEndTokens = new();
        self.BitWidths = new();
        self.TypeArgumentCounts = new();
        self.ComptimeArgumentCounts = new();
        self.TypeFlags = new();

        self.CandidateMemberIndices = new();
        self.CandidateKinds = new();
        self.CandidateSignatureIndices = new();
        self.CandidateNameTokens = new();
        self.CandidateParameterCounts = new();
        self.CandidateReturnTypeKinds = new();
        self.CandidateReturnTypeHeadTokens = new();
        self.CandidateReturnTypePrimaryTokens = new();
        self.CandidateReturnTypeStartTokens = new();
        self.CandidateReturnTypeEndTokens = new();
        self.CandidateReturnRangeStartTokens = new();
        self.CandidateReturnRangeEndTokens = new();
        self.CandidateReturnElementCountStartTokens = new();
        self.CandidateReturnElementCountEndTokens = new();
        self.CandidateReturnBitWidths = new();
        self.CandidateReturnTypeArgumentCounts = new();
        self.CandidateReturnComptimeArgumentCounts = new();
        self.CandidateReturnTypeFlags = new();
