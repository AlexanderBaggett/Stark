    public law bool ReceiverResolvedAt(borrow TypedMemberExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedMemberFlagPresent(self.MemberFlagsAt(index), TypedMemberFlagReceiverResolved());
