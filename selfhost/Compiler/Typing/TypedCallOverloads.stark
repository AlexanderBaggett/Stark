import Compiler.Lexing
import Compiler.Parsing
import Compiler.Typing.TypedCallArgumentFacts
import Compiler.Typing.TypedCallFacts
import Compiler.Typing.TypedIdentifierModel
import Compiler.Typing.TypedLiterals
import Compiler.Typing.TypedMemberFacts
import Compiler.Typing.TypedSignatures
import Compiler.Typing.TypedTypeCompatibility
module Compiler.Typing.TypedCallOverloads

internal fn bool TypedCallOwnerTokenEquals(ascii source, borrow TokenStream stream, u32[0 max] left, u32[0 max] right)
{
    if (left == 0 || right == 0)
    {
        return left == right;
    }

    return TypedSignatureTokenTextEqualsToken(source, stream, left, right);
}

internal fn bool TypedCallSignatureMatchesOverloadBase(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    u32[0 max] baseSignatureIndexPlusOne,
    u64[0 2 ** 63 - 1] candidateIndex)
{
    if (baseSignatureIndexPlusOne == 0)
    {
        return false;
    }

    stack u64[0 2 ** 63 - 1] baseIndex = (u64[0 2 ** 63 - 1])(baseSignatureIndexPlusOne - 1);
    return signatures.OwnerKindAt(candidateIndex) == signatures.OwnerKindAt(baseIndex)
        && TypedCallOwnerTokenEquals(source, stream, signatures.OwnerNameTokenAt(candidateIndex), signatures.OwnerNameTokenAt(baseIndex))
        && TypedSignatureTokenTextEqualsToken(source, stream, signatures.NameTokenAt(candidateIndex), signatures.NameTokenAt(baseIndex));
}

internal fn bool TypedCallCandidateScoreFromTree(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow ExprTree tree,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u64[0 2 ** 63 - 1] signatureIndex,
    u32[0 max] parameterOffset,
    out u32[0 max] score)
{
    score = 0;
    stack u32[0 max] argumentCount = tree.CallArgCount(callNode);
    if (signatures.ParamCountAt(signatureIndex) != (u32[0 max])(argumentCount + parameterOffset))
    {
        return false;
    }

    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack mut TypedCallTypeFacts parameter = new();
        TypedCallFactsFromSignatureSlot(signatures, signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset)), parameter);

        stack mut TypedCallTypeFacts argument = new();
        TypedCallArgumentFactsFromTreeNode(
            source,
            stream,
            literals,
            identifiers,
            calls,
            tree,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            tree.CallArgAt(callNode, ordinal),
            argument);

        if (!TypedCallCanBindArgument(source, stream, parameter, argument))
        {
            return false;
        }

        score = (u32[0 max])(score + TypedCallArgumentBindingCost(source, stream, parameter, argument));
        ordinal = (u32[0 max])(ordinal + 1);
    }

    score = (u32[0 max])(score
        + (signatures.GenericParamCountAt(signatureIndex) * 1000)
        + (signatures.ComptimeGenericParamCountAt(signatureIndex) * 1000));
    return true;
}

internal fn bool TypedCallCandidateScoreFromBody(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow StatementList body,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u64[0 2 ** 63 - 1] signatureIndex,
    u32[0 max] parameterOffset,
    out u32[0 max] score)
{
    score = 0;
    stack u32[0 max] argumentCount = body.ExprCallArgCountAt(callNode);
    if (signatures.ParamCountAt(signatureIndex) != (u32[0 max])(argumentCount + parameterOffset))
    {
        return false;
    }

    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < argumentCount)
    {
        stack mut TypedCallTypeFacts parameter = new();
        TypedCallFactsFromSignatureSlot(signatures, signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, (u32[0 max])(ordinal + parameterOffset)), parameter);

        stack mut TypedCallTypeFacts argument = new();
        TypedCallArgumentFactsFromBodyNode(
            source,
            stream,
            literals,
            identifiers,
            calls,
            body,
            context,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            statementIndexPlusOne,
            body.ExprCallArgAt(callNode, ordinal),
            argument);

        if (!TypedCallCanBindArgument(source, stream, parameter, argument))
        {
            return false;
        }

        score = (u32[0 max])(score + TypedCallArgumentBindingCost(source, stream, parameter, argument));
        ordinal = (u32[0 max])(ordinal + 1);
    }

    score = (u32[0 max])(score
        + (signatures.GenericParamCountAt(signatureIndex) * 1000)
        + (signatures.ComptimeGenericParamCountAt(signatureIndex) * 1000));
    return true;
}

internal fn u32[0 max] TypedCallResolveDirectOverload(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow ExprTree tree,
    borrow StatementList body,
    bool useBody,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u32[0 max] baseSignatureIndexPlusOne,
    out u32[0 max] candidateCount,
    out u32[0 max] viableCandidateCount,
    out u32[0 max] bestCandidateCount)
{
    candidateCount = 0;
    viableCandidateCount = 0;
    bestCandidateCount = 0;
    stack mut u32[0 max] selectedSignatureIndexPlusOne = 0;
    stack mut u32[0 max] bestScore = 0;
    stack u64[0 2 ** 63 - 1] signatureCount = signatures.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < signatureCount; index += 1)
    {
        if (TypedCallSignatureMatchesOverloadBase(source, stream, signatures, baseSignatureIndexPlusOne, index))
        {
            candidateCount = (u32[0 max])(candidateCount + 1);
            stack mut u32[0 max] score = 0;
            stack mut bool viable = false;
            if (useBody)
            {
                viable = TypedCallCandidateScoreFromBody(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    body,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    index,
                    0,
                    score);
            }
            else
            {
                viable = TypedCallCandidateScoreFromTree(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    tree,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    index,
                    0,
                    score);
            }

            if (viable)
            {
                viableCandidateCount = (u32[0 max])(viableCandidateCount + 1);
                if (selectedSignatureIndexPlusOne == 0 || score < bestScore)
                {
                    selectedSignatureIndexPlusOne = (u32[0 max])(index + 1);
                    bestScore = score;
                    bestCandidateCount = 1;
                }
                else if (score == bestScore)
                {
                    bestCandidateCount = (u32[0 max])(bestCandidateCount + 1);
                }
            }
        }
    }

    if (bestCandidateCount == 1)
    {
        return selectedSignatureIndexPlusOne;
    }

    return 0;
}

internal fn u32[0 max] TypedCallMethodParameterOffset(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    u64[0 2 ** 63 - 1] signatureIndex,
    TypedMemberTargetKind candidateKind,
    u32[0 max] ownerNameToken)
{
    if (candidateKind != TypedMemberTargetKind.InstanceMethod || signatures.ParamCountAt(signatureIndex) == 0)
    {
        return 0;
    }

    stack u32[0 max] firstSlotIndexPlusOne = signatures.ParameterTypeSlotIndexPlusOneAt(signatureIndex, 0);
    if (firstSlotIndexPlusOne == 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] firstSlot = (u64[0 2 ** 63 - 1])(firstSlotIndexPlusOne - 1);
    stack u32[0 max] firstParamNameToken = signatures.TypeSlotParamNameTokenAt(firstSlot);
    stack u32[0 max] firstTypeHeadToken = signatures.TypeHeadTokenAt(firstSlot);
    if (firstParamNameToken == 0
        || firstTypeHeadToken == 0
        || ownerNameToken == 0
        || !TypedSignatureTokenTextEquals(source, stream, firstParamNameToken, "self")
        || !TypedSignatureTokenTextEqualsToken(source, stream, firstTypeHeadToken, ownerNameToken))
    {
        return 0;
    }

    return 1;
}

internal fn u32[0 max] TypedCallResolveMethodOverload(
    ascii source,
    borrow TokenStream stream,
    borrow TypedFunctionSignatureTable signatures,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow ExprTree tree,
    borrow StatementList body,
    bool useBody,
    TypedCallContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] callNode,
    u32[0 max] memberIndexPlusOne,
    out u32[0 max] selectedParameterOffset,
    out u32[0 max] candidateCount,
    out u32[0 max] viableCandidateCount,
    out u32[0 max] bestCandidateCount)
{
    selectedParameterOffset = 0;
    candidateCount = 0;
    viableCandidateCount = 0;
    bestCandidateCount = 0;
    if (memberIndexPlusOne == 0)
    {
        return 0;
    }

    stack u64[0 2 ** 63 - 1] memberIndex = (u64[0 2 ** 63 - 1])(memberIndexPlusOne - 1);
    stack u32[0 max] candidateStartIndexPlusOne = members.CandidateStartIndexPlusOneAt(memberIndex);
    candidateCount = members.CandidateCountAt(memberIndex);
    if (candidateStartIndexPlusOne == 0 || candidateCount == 0)
    {
        return 0;
    }

    stack mut u32[0 max] methodOwnerNameToken = members.ReceiverTypeHeadTokenAt(memberIndex);
    if (methodOwnerNameToken == 0)
    {
        methodOwnerNameToken = members.ReceiverNameTokenAt(memberIndex);
    }

    stack mut u32[0 max] selectedSignatureIndexPlusOne = 0;
    stack mut u32[0 max] bestScore = 0;
    stack mut u32[0 max] bestParameterOffset = 0;
    stack mut u32[0 max] ordinal = 0;
    while willexit (ordinal < candidateCount)
    {
        stack u64[0 2 ** 63 - 1] candidateIndex = (u64[0 2 ** 63 - 1])(candidateStartIndexPlusOne - 1 + ordinal);
        stack u32[0 max] candidateSignatureIndexPlusOne = members.CandidateSignatureIndexPlusOneAt(candidateIndex);
        if (candidateSignatureIndexPlusOne != 0)
        {
            stack u64[0 2 ** 63 - 1] candidateSignatureIndex = (u64[0 2 ** 63 - 1])(candidateSignatureIndexPlusOne - 1);
            stack u32[0 max] parameterOffset = TypedCallMethodParameterOffset(
                source,
                stream,
                signatures,
                candidateSignatureIndex,
                members.CandidateKindAt(candidateIndex),
                methodOwnerNameToken);
            stack mut u32[0 max] score = 0;
            stack mut bool viable = false;
            if (useBody)
            {
                viable = TypedCallCandidateScoreFromBody(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    body,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    candidateSignatureIndex,
                    parameterOffset,
                    score);
            }
            else
            {
                viable = TypedCallCandidateScoreFromTree(
                    source,
                    stream,
                    signatures,
                    literals,
                    identifiers,
                    calls,
                    tree,
                    context,
                    ownerDeclarationIndex,
                    ownerNameToken,
                    functionNameToken,
                    statementIndexPlusOne,
                    callNode,
                    candidateSignatureIndex,
                    parameterOffset,
                    score);
            }

            if (viable)
            {
                viableCandidateCount = (u32[0 max])(viableCandidateCount + 1);
                if (selectedSignatureIndexPlusOne == 0 || score < bestScore)
                {
                    selectedSignatureIndexPlusOne = candidateSignatureIndexPlusOne;
                    bestScore = score;
                    bestCandidateCount = 1;
                    bestParameterOffset = parameterOffset;
                }
                else if (score == bestScore)
                {
                    bestCandidateCount = (u32[0 max])(bestCandidateCount + 1);
                }
            }
        }

        ordinal = (u32[0 max])(ordinal + 1);
    }

    if (bestCandidateCount == 1)
    {
        selectedParameterOffset = bestParameterOffset;
        return selectedSignatureIndexPlusOne;
    }

    return 0;
}
