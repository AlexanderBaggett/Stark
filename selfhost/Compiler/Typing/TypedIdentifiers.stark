    public law bool IsResolvedAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) != TypedIdentifierTargetKind.Unknown;
    }

    public law bool IsParameterAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.Parameter;
    }

    public law bool IsLocalAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.Local;
    }

    public law bool IsGlobalAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.Global;
    }

    public law bool IsFunctionAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.Function;
    }

    public law bool IsTypeDeclarationAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.TypeDeclaration;
    }

    public law bool IsIntegerSignedAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerSigned());
    }

    public law bool IsIntegerUnsignedAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerUnsigned());
    }

