import Compiler.Lexing
import Compiler.Parsing
import Compiler.Typing.TypedDeclarationLookup
import Compiler.Typing.TypedGlobals
import Compiler.Typing.TypedLocals
import Compiler.Typing.TypedSignatures
import System.Memory
module Compiler.Typing.TypedIdentifiers

public enum TypedIdentifierContext
{
    GlobalInitializer,
    FunctionBody,
    Unknown,
}

public enum TypedIdentifierTargetKind
{
    Parameter,
    Local,
    Global,
    Function,
    TypeDeclaration,
    Unknown,
}

public struct TypedIdentifierExpressionTable
{
    internal dynamic TypedIdentifierContext Contexts;
    internal dynamic u32[0 max] OwnerDeclarationIndices;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic u32[0 max] FunctionNameTokens;
    internal dynamic u32[0 max] StatementIndices;
    internal dynamic u32[0 max] ExprNodes;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic TypedIdentifierTargetKind TargetKinds;
    internal dynamic u32[0 max] TargetDeclarationIndices;
    internal dynamic u32[0 max] TargetSymbolIndices;
    internal dynamic u32[0 max] TargetNameTokens;
    internal dynamic u32[0 max] TargetStatementIndices;
    internal dynamic u32[0 max] TargetParameterOrdinals;
    internal dynamic DeclarationKind DeclarationKinds;
    internal dynamic TypedGlobalStorageKind StorageKinds;
    internal dynamic TypedGlobalBindingKind BindingKinds;
    internal dynamic TypedSignatureTypeKind TypeKinds;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic u32[0 max] RangeStartTokens;
    internal dynamic u32[0 max] RangeEndTokens;
    internal dynamic u32[0 max] ElementCountStartTokens;
    internal dynamic u32[0 max] ElementCountEndTokens;
    internal dynamic u32[0 max] BitWidths;
    internal dynamic u32[0 max] TypeArgumentCounts;
    internal dynamic u32[0 max] ComptimeArgumentCounts;
    internal dynamic u32[0 max] TypeFlags;

    TypedIdentifierExpressionTable()
    {
        self.Contexts = new();
        self.OwnerDeclarationIndices = new();
        self.OwnerNameTokens = new();
        self.FunctionNameTokens = new();
        self.StatementIndices = new();
        self.ExprNodes = new();
        self.NameTokens = new();
        self.TargetKinds = new();
        self.TargetDeclarationIndices = new();
        self.TargetSymbolIndices = new();
        self.TargetNameTokens = new();
        self.TargetStatementIndices = new();
        self.TargetParameterOrdinals = new();
        self.DeclarationKinds = new();
        self.StorageKinds = new();
        self.BindingKinds = new();
        self.TypeKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.RangeStartTokens = new();
        self.RangeEndTokens = new();
        self.ElementCountStartTokens = new();
        self.ElementCountEndTokens = new();
        self.BitWidths = new();
        self.TypeArgumentCounts = new();
        self.ComptimeArgumentCounts = new();
        self.TypeFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedIdentifierExpressionTable self)
    {
        return self.NameTokens.Length;
    }

    public law TypedIdentifierContext ContextAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedIdentifierContext context = TypedIdentifierContext.Unknown;
        if (index < self.Contexts.Length)
        {
            context = self.Contexts[index];
        }

        return context;
    }

