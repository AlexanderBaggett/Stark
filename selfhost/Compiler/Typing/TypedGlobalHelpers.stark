import Compiler.Lexing
import Compiler.Parsing
import Compiler.Typing.TypedDynamicFacts
import Compiler.Typing.TypedGlobalModel
module Compiler.Typing.TypedGlobalHelpers

internal finite law bool TypedGlobalDeclarationKindIsGlobal(DeclarationKind kind)
{
    return kind == DeclarationKind.Const
        || kind == DeclarationKind.Static
        || kind == DeclarationKind.GlobalVariable;
}

internal finite law TypedGlobalStorageKind TypedGlobalStorageKindForItem(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind == DeclarationKind.Const)
    {
        return TypedGlobalStorageKind.Const;
    }

    if (item.Kind == DeclarationKind.Static)
    {
        return TypedGlobalStorageKind.Static;
    }

    if (item.Kind == DeclarationKind.GlobalVariable)
    {
        switch (stream.KindAt((u64[0 2 ** 63 - 1])item.KeywordToken))
        {
            case TokenKind.Heap:
                return TypedGlobalStorageKind.Heap;
            case TokenKind.Stack:
                return TypedGlobalStorageKind.Stack;
            case TokenKind.Register:
                return TypedGlobalStorageKind.Register;
            case TokenKind.Arena:
                return TypedGlobalStorageKind.Arena;
            default:
                return TypedGlobalStorageKind.Unknown;
        }
    }

    return TypedGlobalStorageKind.Unknown;
}

internal finite law TypedGlobalBindingKind TypedGlobalBindingKindForItem(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind == DeclarationKind.Const)
    {
        return TypedGlobalBindingKind.Const;
    }

    if (item.Kind == DeclarationKind.Static || item.Kind == DeclarationKind.GlobalVariable)
    {
        stack u32[0 max] next = (u32[0 max])(item.KeywordToken + 1);
        if (stream.KindAt((u64[0 2 ** 63 - 1])next) == TokenKind.Mut)
        {
            return TypedGlobalBindingKind.Mutable;
        }

        return TypedGlobalBindingKind.Immutable;
    }

    return TypedGlobalBindingKind.Unknown;
}

internal fn u32[0 max] TypedGlobalFindNameToken(borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = (u32[0 max])(item.KeywordToken + 1);
    if ((item.Kind == DeclarationKind.Static || item.Kind == DeclarationKind.GlobalVariable)
        && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Mut)
    {
        scan = (u32[0 max])(scan + 1);
    }

    stack mut u32[0 max] nameToken = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0 && scan <= item.EndToken)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            break;
        }

        if (depth == 0 && (kind == TokenKind.Assign || kind == TokenKind.Semi))
        {
            break;
        }

        if (depth == 0 && kind == TokenKind.Identifier)
        {
            nameToken = scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return nameToken;
}

internal fn u32[0 max] TypedGlobalFindAssignToken(borrow TokenStream stream, DeclItem item)
{
    stack mut u32[0 max] scan = item.KeywordToken;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0 && scan <= item.EndToken)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return 0;
        }

        if (depth == 0 && kind == TokenKind.Assign)
        {
            return scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn u32[0 max] TypedGlobalTypeStartToken(borrow TokenStream stream, DeclItem item, u32[0 max] nameToken)
{
    if (nameToken == 0)
    {
        return 0;
    }

    stack mut u32[0 max] start = (u32[0 max])(item.KeywordToken + 1);
    if ((item.Kind == DeclarationKind.Static || item.Kind == DeclarationKind.GlobalVariable)
        && stream.KindAt((u64[0 2 ** 63 - 1])start) == TokenKind.Mut)
    {
        start = (u32[0 max])(start + 1);
    }

    if (nameToken > start)
    {
        return start;
    }

    return 0;
}

internal finite law bool TypedGlobalTokenCanBeTypeHead(TokenKind kind)
{
    return kind == TokenKind.Void
        || kind == TokenKind.Bool
        || kind == TokenKind.IntegerType
        || kind == TokenKind.FloatType
        || kind == TokenKind.AsciiView
        || kind == TokenKind.AsciiOwned
        || kind == TokenKind.UnicodeView
        || kind == TokenKind.UnicodeOwned
        || kind == TokenKind.Rawptr
        || kind == TokenKind.Rawmutptr
        || kind == TokenKind.Fnptr
        || kind == TokenKind.Closure
        || TypedDynamicTokenKind(kind)
        || kind == TokenKind.Identifier;
}

internal fn u32[0 max] TypedGlobalTypeHeadToken(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] headToken = 0;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && TypedGlobalTokenCanBeTypeHead(kind))
        {
            headToken = scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return headToken;
}

internal fn u32[0 max] TypedGlobalInitializerEndExclusive(borrow TokenStream stream, DeclItem item)
{
    if (item.EndToken == 0)
    {
        return 0;
    }

    stack TokenKind endKind = stream.KindAt((u64[0 2 ** 63 - 1])item.EndToken);
    if (endKind == TokenKind.Semi || endKind == TokenKind.EndOfFile)
    {
        return item.EndToken;
    }

    return (u32[0 max])(item.EndToken + 1);
}

internal finite law TypedGlobalStorageKind TypedLocalDeclarationStorageKind(borrow TokenStream stream, u32[0 max] startToken)
{
    switch (stream.KindAt((u64[0 2 ** 63 - 1])startToken))
    {
        case TokenKind.Const:
            return TypedGlobalStorageKind.Const;
        case TokenKind.Static:
            return TypedGlobalStorageKind.Static;
        case TokenKind.Heap:
            return TypedGlobalStorageKind.Heap;
        case TokenKind.Stack:
            return TypedGlobalStorageKind.Stack;
        case TokenKind.Register:
            return TypedGlobalStorageKind.Register;
        case TokenKind.Arena:
            return TypedGlobalStorageKind.Arena;
        default:
            return TypedGlobalStorageKind.Unknown;
    }
}
