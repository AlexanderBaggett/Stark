import Compiler.Lexing
import Compiler.Parsing
import System.Text
module Compiler.Typing.TypedGenerics

internal finite law bool TypedGenericTokenTextEqualsToken(ascii source, borrow TokenStream stream, u32[0 max] left, u32[0 max] right)
{
    stack ascii leftText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])left);
    stack ascii rightText = Compiler.Lexing.TokenTextOf(source, stream, (u64[0 2 ** 63 - 1])right);
    return System.Text.Equals(leftText, rightText);
}

internal finite law u32[0 max] TypedGenericMatchingCloseToken(borrow TokenStream stream, u32[0 max] openToken)
{
    stack TokenKind openKind = stream.KindAt((u64[0 2 ** 63 - 1])openToken);
    stack mut TokenKind closeKind = TokenKind.RParen;
    if (openKind == TokenKind.LBrack)
    {
        closeKind = TokenKind.RBrack;
    }
    else if (openKind == TokenKind.LBrace)
    {
        closeKind = TokenKind.RBrace;
    }
    else if (openKind == TokenKind.Lt)
    {
        closeKind = TokenKind.Gt;
    }
    else if (openKind != TokenKind.LParen)
    {
        return openToken;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = openToken;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return openToken;
        }

        if (kind == openKind)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == closeKind)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return scan;
                }
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return openToken;
}

internal finite law u32[0 max] TypedSignatureGenericOpenAfterName(borrow TokenStream stream, u32[0 max] nameToken)
{
    stack u32[0 max] next = (u32[0 max])(nameToken + 1);
    if (stream.KindAt((u64[0 2 ** 63 - 1])next) == TokenKind.Lt)
    {
        return next;
    }

    return 0;
}

internal fn bool TypedSignatureGenericParamListMatches(ascii source, borrow TokenStream stream, u32[0 max] ltToken, u32[0 max] headToken)
{
    if (ltToken == 0 || stream.KindAt((u64[0 2 ** 63 - 1])ltToken) != TokenKind.Lt || headToken == 0)
    {
        return false;
    }

    stack mut u32[0 max] index = ltToken;
    stack mut u32[0 max] angleDepth = 0;
    stack mut u32[0 max] lastParamIdent = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return false;
        }

        if (kind == TokenKind.Lt)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (angleDepth == 1)
            {
                if (lastParamIdent != 0 && TypedGenericTokenTextEqualsToken(source, stream, lastParamIdent, headToken))
                {
                    return true;
                }

                return false;
            }
            else if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }
        else if (angleDepth == 1 && kind == TokenKind.Comma)
        {
            if (lastParamIdent != 0 && TypedGenericTokenTextEqualsToken(source, stream, lastParamIdent, headToken))
            {
                return true;
            }

            lastParamIdent = 0;
        }
        else if (angleDepth == 1 && kind == TokenKind.Identifier)
        {
            lastParamIdent = index;
        }

        index = (u32[0 max])(index + 1);
    }

    return false;
}

internal finite law bool TypedSignatureGenericArgumentSegmentIsValue(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    if (start >= endExclusive)
    {
        return false;
    }

    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])start);
    return kind == TokenKind.IntegerLiteral
        || kind == TokenKind.Plus
        || kind == TokenKind.Minus
        || kind == TokenKind.Comptime;
}

internal fn void TypedSignatureCountGenericArgumentsInList(
    borrow TokenStream stream,
    u32[0 max] openToken,
    out u32[0 max] typeArgumentCount,
    out u32[0 max] comptimeArgumentCount)
{
    typeArgumentCount = 0;
    comptimeArgumentCount = 0;
    if (openToken == 0 || stream.KindAt((u64[0 2 ** 63 - 1])openToken) != TokenKind.Lt)
    {
        return;
    }

    stack u32[0 max] closeToken = TypedGenericMatchingCloseToken(stream, openToken);
    if (closeToken <= openToken)
    {
        return;
    }

    stack mut u32[0 max] segmentStart = (u32[0 max])(openToken + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(openToken + 1);
    while willexit (scan <= closeToken)
    {
        stack mut bool boundary = false;
        if (scan == closeToken)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (segmentStart < scan)
            {
                if (TypedSignatureGenericArgumentSegmentIsValue(stream, segmentStart, scan))
                {
                    comptimeArgumentCount = (u32[0 max])(comptimeArgumentCount + 1);
                }
                else
                {
                    typeArgumentCount = (u32[0 max])(typeArgumentCount + 1);
                }
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }
}

internal fn void TypedSignatureCountGenericParametersInList(
    borrow TokenStream stream,
    u32[0 max] openToken,
    out u32[0 max] typeParamCount,
    out u32[0 max] comptimeParamCount)
{
    typeParamCount = 0;
    comptimeParamCount = 0;
    if (openToken == 0 || stream.KindAt((u64[0 2 ** 63 - 1])openToken) != TokenKind.Lt)
    {
        return;
    }

    stack u32[0 max] closeToken = TypedGenericMatchingCloseToken(stream, openToken);
    if (closeToken <= openToken)
    {
        return;
    }

    stack mut u32[0 max] segmentStart = (u32[0 max])(openToken + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(openToken + 1);
    while willexit (scan <= closeToken)
    {
        stack mut bool boundary = false;
        if (scan == closeToken)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (segmentStart < scan)
            {
                if (stream.KindAt((u64[0 2 ** 63 - 1])segmentStart) == TokenKind.Comptime)
                {
                    comptimeParamCount = (u32[0 max])(comptimeParamCount + 1);
                }
                else
                {
                    typeParamCount = (u32[0 max])(typeParamCount + 1);
                }
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }
}
