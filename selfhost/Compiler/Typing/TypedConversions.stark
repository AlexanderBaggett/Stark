    {
        self.Contexts = new();
        self.OwnerDeclarationIndices = new();
        self.OwnerNameTokens = new();
        self.FunctionNameTokens = new();
        self.StatementIndices = new();
        self.ConversionNodes = new();
        self.OpenParenTokens = new();
        self.OperandNodes = new();
        self.OperandKinds = new();
        self.TargetTypeKinds = new();
        self.TargetTypeHeadTokens = new();
        self.TargetTypePrimaryTokens = new();
        self.TargetTypeStartTokens = new();
        self.TargetTypeEndTokens = new();
        self.TargetRangeStartTokens = new();
        self.TargetRangeEndTokens = new();
        self.TargetElementCountStartTokens = new();
        self.TargetElementCountEndTokens = new();
        self.TargetBitWidths = new();
        self.TargetTypeArgumentCounts = new();
        self.TargetComptimeArgumentCounts = new();
        self.TargetTypeFlags = new();
        self.OperandTypeKinds = new();
        self.OperandTypeHeadTokens = new();
        self.OperandTypePrimaryTokens = new();
        self.OperandTypeStartTokens = new();
        self.OperandTypeEndTokens = new();
        self.OperandRangeStartTokens = new();
        self.OperandRangeEndTokens = new();
        self.OperandElementCountStartTokens = new();
        self.OperandElementCountEndTokens = new();
        self.OperandBitWidths = new();
        self.OperandTypeArgumentCounts = new();
        self.OperandComptimeArgumentCounts = new();
        self.OperandTypeFlags = new();
        self.ConversionFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedConversionExpressionTable self)
    {
        return self.ConversionNodes.Length;
    }

    public law TypedConversionContext ContextAt(borrow TypedConversionExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedConversionContext context = TypedConversionContext.Unknown;
        if (index < self.Contexts.Length)
        {
            context = self.Contexts[index];
        }

        return context;
    }

