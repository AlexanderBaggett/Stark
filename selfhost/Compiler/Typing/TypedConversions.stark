import Compiler.Lexing
import Compiler.Parsing
import Compiler.Typing.TypedCallFacts
import Compiler.Typing.TypedConversionHelpers
import Compiler.Typing.TypedConversionModel
import Compiler.Typing.TypedConversionOperandFacts
import Compiler.Typing.TypedGlobals
import Compiler.Typing.TypedIdentifierModel
import Compiler.Typing.TypedIndexModel
import Compiler.Typing.TypedLiterals
import Compiler.Typing.TypedMemberFacts
import Compiler.Typing.TypedMemberModel
import Compiler.Typing.TypedMemberReceiverFacts
import Compiler.Typing.TypedSignatures
import System.Memory
import System.Text
module Compiler.Typing.TypedConversions

internal fn System.Memory.MemoryStatus AppendTypedConversionExpression(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    TypedConversionContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] conversionNode,
    u32[0 max] openParenToken,
    u32[0 max] targetPrimaryToken,
    u32[0 max] targetCloseToken,
    u32[0 max] operandNode,
    borrow ExprTree tree)
{
    stack mut TypedMemberTypeFacts targetFacts = new();
    TypedMemberFactsFromTypeSpan(
        source,
        stream,
        declarations,
        (u32[0 max])(openParenToken + 1),
        targetCloseToken,
        targetPrimaryToken,
        0,
        0,
        targetFacts);

    stack mut TypedMemberTypeFacts operandFacts = new();
    stack mut TypedConversionOperandKind operandKind = TypedConversionOperandKind.Unknown;
    TypedConversionOperandFactsFromTreeNode(
        source,
        stream,
        declarations,
        literals,
        identifiers,
        calls,
        members,
        indexes,
        table,
        tree,
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        operandNode,
        operandFacts,
        operandKind);

    stack u32[0 max] flags = TypedConversionFlagsFromFacts(targetFacts, operandFacts);
    return table.AppendConversion(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        conversionNode,
        openParenToken,
        operandNode,
        operandKind,
        targetFacts.TypeKind,
        targetFacts.TypeHeadToken,
        targetFacts.TypePrimaryToken,
        targetFacts.TypeStartToken,
        targetFacts.TypeEndToken,
        targetFacts.RangeStartToken,
        targetFacts.RangeEndToken,
        targetFacts.ElementCountStartToken,
        targetFacts.ElementCountEndToken,
        targetFacts.BitWidth,
        targetFacts.TypeArgumentCount,
        targetFacts.ComptimeArgumentCount,
        targetFacts.TypeFlags,
        operandFacts.TypeKind,
        operandFacts.TypeHeadToken,
        operandFacts.TypePrimaryToken,
        operandFacts.TypeStartToken,
        operandFacts.TypeEndToken,
        operandFacts.RangeStartToken,
        operandFacts.RangeEndToken,
        operandFacts.ElementCountStartToken,
        operandFacts.ElementCountEndToken,
        operandFacts.BitWidth,
        operandFacts.TypeArgumentCount,
        operandFacts.ComptimeArgumentCount,
        operandFacts.TypeFlags,
        flags);
}

internal fn System.Memory.MemoryStatus AppendTypedConversionBodyExpression(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    TypedConversionContext context,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    u32[0 max] statementIndexPlusOne,
    u32[0 max] conversionNode,
    u32[0 max] openParenToken,
    u32[0 max] targetPrimaryToken,
    u32[0 max] targetCloseToken,
    u32[0 max] operandNode,
    borrow StatementList body)
{
    stack mut TypedMemberTypeFacts targetFacts = new();
    TypedMemberFactsFromTypeSpan(
        source,
        stream,
        declarations,
        (u32[0 max])(openParenToken + 1),
        targetCloseToken,
        targetPrimaryToken,
        0,
        0,
        targetFacts);

    stack mut TypedMemberTypeFacts operandFacts = new();
    stack mut TypedConversionOperandKind operandKind = TypedConversionOperandKind.Unknown;
    TypedConversionOperandFactsFromBodyNode(
        source,
        stream,
        declarations,
        literals,
        identifiers,
        calls,
        members,
        indexes,
        table,
        body,
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        operandNode,
        operandFacts,
        operandKind);

    stack u32[0 max] flags = TypedConversionFlagsFromFacts(targetFacts, operandFacts);
    return table.AppendConversion(
        context,
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        statementIndexPlusOne,
        conversionNode,
        openParenToken,
        operandNode,
        operandKind,
        targetFacts.TypeKind,
        targetFacts.TypeHeadToken,
        targetFacts.TypePrimaryToken,
        targetFacts.TypeStartToken,
        targetFacts.TypeEndToken,
        targetFacts.RangeStartToken,
        targetFacts.RangeEndToken,
        targetFacts.ElementCountStartToken,
        targetFacts.ElementCountEndToken,
        targetFacts.BitWidth,
        targetFacts.TypeArgumentCount,
        targetFacts.ComptimeArgumentCount,
        targetFacts.TypeFlags,
        operandFacts.TypeKind,
        operandFacts.TypeHeadToken,
        operandFacts.TypePrimaryToken,
        operandFacts.TypeStartToken,
        operandFacts.TypeEndToken,
        operandFacts.RangeStartToken,
        operandFacts.RangeEndToken,
        operandFacts.ElementCountStartToken,
        operandFacts.ElementCountEndToken,
        operandFacts.BitWidth,
        operandFacts.TypeArgumentCount,
        operandFacts.ComptimeArgumentCount,
        operandFacts.TypeFlags,
        flags);
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsFromGlobalDeclaration(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    DeclItem item,
    u32[0 max] declarationIndex)
{
    if (!TypedGlobalDeclarationKindIsGlobal(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] assignToken = TypedGlobalFindAssignToken(stream, item);
    if (assignToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] ownerNameToken = TypedGlobalFindNameToken(stream, item);
    stack ExprTree tree = ParseExpression(stream, (u32[0 max])(assignToken + 1));
    stack u64[0 2 ** 63 - 1] count = tree.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = 1; nodeIndex <= count; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (tree.NodeKindAt(node) == Compiler.Parsing.ExprKind.Conversion)
        {
            switch (AppendTypedConversionExpression(
                table,
                source,
                stream,
                declarations,
                literals,
                identifiers,
                calls,
                members,
                indexes,
                TypedConversionContext.GlobalInitializer,
                declarationIndex,
                ownerNameToken,
                0,
                0,
                node,
                tree.TokenAt(node),
                tree.LeftAt(node),
                tree.AuxAt(node),
                tree.RightAt(node),
                tree))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsFromBodyStatement(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statementIndex)
{
    stack u64[0 2 ** 63 - 1] statementCount = body.Count();
    stack u32[0 max] start = (u32[0 max])(body.ExprStartAt(statementIndex) + 1);
    stack mut u32[0 max] end = (u32[0 max])body.ExprNodeCount();
    if (statementIndex + 1 < statementCount)
    {
        end = body.ExprStartAt((u64[0 2 ** 63 - 1])(statementIndex + 1));
    }

    if (start > end)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] statementIndexPlusOne = (u32[0 max])(statementIndex + 1);
    stack u64[0 2 ** 63 - 1] endIndex = (u64[0 2 ** 63 - 1])end;
    for willexit (stack mut u64[0 2 ** 63 - 1] nodeIndex = (u64[0 2 ** 63 - 1])start; nodeIndex <= endIndex; nodeIndex += 1)
    {
        stack u32[0 max] node = (u32[0 max])nodeIndex;
        if (body.ExprKindAt(node) == Compiler.Parsing.ExprKind.Conversion)
        {
            switch (AppendTypedConversionBodyExpression(
                table,
                source,
                stream,
                declarations,
                literals,
                identifiers,
                calls,
                members,
                indexes,
                TypedConversionContext.FunctionBody,
                ownerDeclarationIndex,
                ownerNameToken,
                functionNameToken,
                statementIndexPlusOne,
                node,
                body.ExprTokenAt(node),
                body.ExprLeftAt(node),
                body.ExprAuxAt(node),
                body.ExprRightAt(node),
                body))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsFromBody(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedConversionsFromBodyStatement(
            table,
            source,
            stream,
            declarations,
            literals,
            identifiers,
            calls,
            members,
            indexes,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            body,
            index))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsForFunction(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] fnKeyword)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    return AppendTypedConversionsFromBody(
        table,
        source,
        stream,
        declarations,
        literals,
        identifiers,
        calls,
        members,
        indexes,
        ownerDeclarationIndex,
        ownerNameToken,
        signature.Name(),
        body);
}

internal fn System.Memory.MemoryStatus AppendTypedConversionsForMemberFunctions(
    mut borrow TypedConversionExpressionTable table,
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes,
    DeclItem item,
    u32[0 max] ownerDeclarationIndex)
{
    if (!TypedSignatureDeclarationCanOwnMethods(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, item);
    if (bodyOpen == 0 || bodyOpen >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Fn)
        {
            switch (AppendTypedConversionsForFunction(table, source, stream, declarations, literals, identifiers, calls, members, indexes, ownerDeclarationIndex, item.NameToken, scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn ParseResult<TypedConversionExpressionTable> BuildTypedConversionExpressionsFromDependencies(
    ascii source,
    borrow TokenStream stream,
    borrow DeclarationList declarations,
    borrow TypedLiteralExpressionTable literals,
    borrow TypedIdentifierExpressionTable identifiers,
    borrow TypedCallExpressionTable calls,
    borrow TypedMemberExpressionTable members,
    borrow TypedIndexExpressionTable indexes)
{
    stack mut TypedConversionExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedConversionsFromGlobalDeclaration(
            table,
            source,
            stream,
            declarations,
            literals,
            identifiers,
            calls,
            members,
            indexes,
            item,
            (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedConversionsForFunction(table, source, stream, declarations, literals, identifiers, calls, members, indexes, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedConversionsForMemberFunctions(table, source, stream, declarations, literals, identifiers, calls, members, indexes, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberFunctionError):
                    return ParseResult<TypedConversionExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedConversionExpressionTable>.Ok(table);
}
