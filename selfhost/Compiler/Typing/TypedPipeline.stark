public fn ParseResult<TypedFunctionSignatureTable> BuildTypedFunctionSignatures(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedFunctionSignatureTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedFunctionSignature(table, source, stream, item.KeywordToken, TypedSignatureOwnerKind.TopLevelFunction, 0, 0))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedFunctionSignatureTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedMemberFunctionSignaturesForDeclaration(table, source, stream, item))
            {
                case System.Memory.MemoryStatus.Err(var memberError):
                    return ParseResult<TypedFunctionSignatureTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedFunctionSignatureTable>.Ok(table);
}

public fn ParseResult<TypedGlobalDeclarationTable> BuildTypedGlobalDeclarations(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedGlobalDeclarationTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        if (TypedGlobalDeclarationKindIsGlobal(item.Kind))
        {
            switch (AppendTypedGlobalDeclaration(table, source, stream, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return ParseResult<TypedGlobalDeclarationTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedGlobalDeclarationTable>.Ok(table);
}

public fn ParseResult<TypedStorageSelectorTable> BuildTypedStorageSelectors(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedStorageSelectorTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedStorageSelectorFromGlobalDeclaration(table, stream, item, (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedStorageSelectorTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedStorageSelectorsForFunction(table, stream, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedStorageSelectorTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedStorageSelectorsForMemberFunctions(table, stream, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberError):
                    return ParseResult<TypedStorageSelectorTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedStorageSelectorTable>.Ok(table);
}

