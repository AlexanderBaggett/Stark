public fn ParseResult<TypedEnumLayoutTable> BuildTypedEnumLayouts(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedEnumPayloadTable payloads = new();
    switch (BuildTypedEnumPayloads(source, stream, declarations))
    {
        case ParseResult<TypedEnumPayloadTable>.Err(var payloadError):
            return ParseResult<TypedEnumLayoutTable>.Err(payloadError);
        case ParseResult<TypedEnumPayloadTable>.Ok(var builtPayloads):
            payloads = builtPayloads;
    }

    stack mut TypedFieldDeclarationTable fields = new();
    switch (BuildTypedStructRecordFields(source, stream, declarations))
    {
        case ParseResult<TypedFieldDeclarationTable>.Err(var fieldError):
            return ParseResult<TypedEnumLayoutTable>.Err(fieldError);
        case ParseResult<TypedFieldDeclarationTable>.Ok(var builtFields):
            fields = builtFields;
    }

    stack mut TypedEnumLayoutTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        if (item.Kind == DeclarationKind.Enum)
        {
            switch (AppendTypedEnumLayoutRowsForDeclaration(table, source, stream, item, (u32[0 max])index, declarations, fields, payloads))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return ParseResult<TypedEnumLayoutTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedEnumLayoutTable>.Ok(table);
}

public fn ParseResult<TypedLocalDeclarationTable> BuildTypedLocalDeclarations(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedLocalDeclarationTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedLocalDeclarationsForFunction(
                table,
                source,
                stream,
                (u32[0 max])index,
                0,
                item.KeywordToken,
                TypedLocalDeclarationOwnerKind.TopLevelFunction,
                0))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedLocalDeclarationTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedMemberLocalDeclarationsForDeclaration(table, source, stream, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberError):
                    return ParseResult<TypedLocalDeclarationTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedLocalDeclarationTable>.Ok(table);
}

public fn ParseResult<TypedLiteralExpressionTable> BuildTypedLiteralExpressions(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedLiteralExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedLiteralExpressionsFromGlobalDeclaration(table, source, stream, item, (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedLiteralExpressionTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedLiteralExpressionsForFunction(table, source, stream, (u32[0 max])index, 0, item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedLiteralExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedLiteralExpressionsForMemberFunctions(table, source, stream, item, (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberError):
                    return ParseResult<TypedLiteralExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedLiteralExpressionTable>.Ok(table);
}

public fn ParseResult<TypedIdentifierExpressionTable> BuildTypedIdentifierExpressions(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedFunctionSignatureTable signatures = new();
    switch (BuildTypedFunctionSignatures(source, stream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return ParseResult<TypedIdentifierExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFunctionSignatureTable>.Ok(var builtSignatures):
            signatures = builtSignatures;
    }

    stack mut TypedGlobalDeclarationTable globals = new();
    switch (BuildTypedGlobalDeclarations(source, stream, declarations))
    {
        case ParseResult<TypedGlobalDeclarationTable>.Err(var globalError):
            return ParseResult<TypedIdentifierExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedGlobalDeclarationTable>.Ok(var builtGlobals):
            globals = builtGlobals;
    }

    stack mut TypedLocalDeclarationTable locals = new();
    switch (BuildTypedLocalDeclarations(source, stream, declarations))
    {
        case ParseResult<TypedLocalDeclarationTable>.Err(var localError):
            return ParseResult<TypedIdentifierExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedLocalDeclarationTable>.Ok(var builtLocals):
            locals = builtLocals;
    }

    stack mut TypedIdentifierExpressionTable table = new();
    stack u64[0 2 ** 63 - 1] count = declarations.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack DeclItem item = declarations.ItemAt(index);
        switch (AppendTypedIdentifiersFromGlobalDeclaration(
            table,
            source,
            stream,
            declarations,
            signatures,
            globals,
            item,
            (u32[0 max])index))
        {
            case System.Memory.MemoryStatus.Err(var globalError):
                return ParseResult<TypedIdentifierExpressionTable>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        if (item.Kind == DeclarationKind.Function)
        {
            switch (AppendTypedIdentifiersForFunction(
                table,
                source,
                stream,
                declarations,
                signatures,
                globals,
                locals,
                (u32[0 max])index,
                0,
                item.KeywordToken))
            {
                case System.Memory.MemoryStatus.Err(var functionError):
                    return ParseResult<TypedIdentifierExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
        else
        {
            switch (AppendTypedIdentifiersForMemberFunctions(
                table,
                source,
                stream,
                declarations,
                signatures,
                globals,
                locals,
                item,
                (u32[0 max])index))
            {
                case System.Memory.MemoryStatus.Err(var memberError):
                    return ParseResult<TypedIdentifierExpressionTable>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    return ParseResult<TypedIdentifierExpressionTable>.Ok(table);
}

public fn ParseResult<TypedCallExpressionTable> BuildTypedCallExpressions(ascii source, borrow TokenStream stream, borrow DeclarationList declarations)
{
    stack mut TypedFunctionSignatureTable signatures = new();
    switch (BuildTypedFunctionSignatures(source, stream, declarations))
    {
        case ParseResult<TypedFunctionSignatureTable>.Err(var signatureError):
            return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFunctionSignatureTable>.Ok(var builtSignatures):
            signatures = builtSignatures;
    }

    stack mut TypedLiteralExpressionTable literals = new();
    switch (BuildTypedLiteralExpressions(source, stream, declarations))
    {
        case ParseResult<TypedLiteralExpressionTable>.Err(var literalError):
            return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedLiteralExpressionTable>.Ok(var builtLiterals):
            literals = builtLiterals;
    }

    stack mut TypedIdentifierExpressionTable identifiers = new();
    switch (BuildTypedIdentifierExpressions(source, stream, declarations))
    {
        case ParseResult<TypedIdentifierExpressionTable>.Err(var identifierError):
            return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedIdentifierExpressionTable>.Ok(var builtIdentifiers):
            identifiers = builtIdentifiers;
    }

    stack mut TypedFieldDeclarationTable fields = new();
    switch (BuildTypedStructRecordFields(source, stream, declarations))
    {
        case ParseResult<TypedFieldDeclarationTable>.Err(var fieldError):
            return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
        case ParseResult<TypedFieldDeclarationTable>.Ok(var builtFields):
            fields = builtFields;
    }

    stack mut TypedCallExpressionTable calls = new();
    stack mut TypedMemberExpressionTable members = new();
    if (!BuildTypedMemberCallDependencyTables(source, stream, declarations, signatures, fields, literals, identifiers, calls, members))
    {
        return ParseResult<TypedCallExpressionTable>.Err(ParseError.OutOfMemory);
    }

    return ParseResult<TypedCallExpressionTable>.Ok(calls);
}

