    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedMemberExpressionTable self)
    {
        return self.MemberNodes.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] CandidateCount(borrow TypedMemberExpressionTable self)
    {
        return self.CandidateMemberIndices.Length;
    }

    public law TypedMemberContext ContextAt(borrow TypedMemberExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedMemberContext context = TypedMemberContext.Unknown;
        if (index < self.Contexts.Length)
        {
            context = self.Contexts[index];
        }

        return context;
    }

