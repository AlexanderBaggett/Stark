    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedLocalDeclarationTable self,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
        u32[0 max] functionNameToken,
        TypedLocalDeclarationOwnerKind ownerKind,
        u32[0 max] statementIndexPlusOne,
        u32[0 max] nameToken,
        u32[0 max] startToken,
        u32[0 max] endToken,
        TypedGlobalStorageKind storageKind,
        u32[0 max] initializerExprRoot,
        u32[0 max] initializerStartToken,
        u32[0 max] initializerEndToken,
        u32[0 max] depth,
        u32[0 max] scopeId,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] elementCountStartToken,
        u32[0 max] elementCountEndToken,
        u32[0 max] bitWidth,
        u32[0 max] typeArgumentCount,
        u32[0 max] comptimeArgumentCount,
        u32[0 max] typeFlags)
    {
        if (!self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.FunctionNameTokens.TryReserve(1)
            || !self.OwnerKinds.TryReserve(1)
            || !self.StatementIndices.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.StorageKinds.TryReserve(1)
            || !self.InitializerExprRoots.TryReserve(1)
            || !self.InitializerStartTokens.TryReserve(1)
            || !self.InitializerEndTokens.TryReserve(1)
            || !self.Depths.TryReserve(1)
            || !self.ScopeIds.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ElementCountStartTokens.TryReserve(1)
            || !self.ElementCountEndTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeArgumentCounts.TryReserve(1)
            || !self.ComptimeArgumentCounts.TryReserve(1)
            || !self.TypeFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.FunctionNameTokens[self.FunctionNameTokens.Length] = functionNameToken;
        init self.OwnerKinds[self.OwnerKinds.Length] = ownerKind;
        init self.StatementIndices[self.StatementIndices.Length] = statementIndexPlusOne;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.StartTokens[self.StartTokens.Length] = startToken;
        init self.EndTokens[self.EndTokens.Length] = endToken;
        init self.StorageKinds[self.StorageKinds.Length] = storageKind;
        init self.InitializerExprRoots[self.InitializerExprRoots.Length] = initializerExprRoot;
        init self.InitializerStartTokens[self.InitializerStartTokens.Length] = initializerStartToken;
        init self.InitializerEndTokens[self.InitializerEndTokens.Length] = initializerEndToken;
        init self.Depths[self.Depths.Length] = depth;
        init self.ScopeIds[self.ScopeIds.Length] = scopeId;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ElementCountStartTokens[self.ElementCountStartTokens.Length] = elementCountStartToken;
        init self.ElementCountEndTokens[self.ElementCountEndTokens.Length] = elementCountEndToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeArgumentCounts[self.TypeArgumentCounts.Length] = typeArgumentCount;
        init self.ComptimeArgumentCounts[self.ComptimeArgumentCounts.Length] = comptimeArgumentCount;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}


internal fn u32[0 max] TypedLocalDeclarationAssignToken(borrow TokenStream stream, StatementItem item)
{
    stack mut u32[0 max] scan = item.StartToken;
    stack mut u32[0 max] depth = 0;
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Assign)
        {
            return scan;
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal finite law u32[0 max] TypedLocalDeclarationInitializerEndExclusive(borrow TokenStream stream, StatementItem item)
{
    if (item.EndToken == 0)
    {
        return 0;
    }

    stack TokenKind endKind = stream.KindAt((u64[0 2 ** 63 - 1])item.EndToken);
    if (endKind == TokenKind.Semi || endKind == TokenKind.EndOfFile)
    {
        return item.EndToken;
    }

    return (u32[0 max])(item.EndToken + 1);
}

internal fn System.Memory.MemoryStatus AppendTypedLocalDeclaration(
    mut borrow TypedLocalDeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    TypedLocalDeclarationOwnerKind ownerKind,
    u32[0 max] functionGenericOpenToken,
    u32[0 max] ownerGenericOpenToken,
    borrow StatementList body,
    u64[0 2 ** 63 - 1] statementIndex,
    StatementItem item)
{
    if (item.Kind != StatementKind.Local || item.NameToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut TypedSignatureTypeKind typeKind = TypedSignatureTypeKind.Unknown;
    stack mut u32[0 max] typeHeadToken = 0;
    stack mut u32[0 max] typePrimaryToken = 0;
    stack mut u32[0 max] typeStartToken = 0;
    stack mut u32[0 max] typeEndToken = 0;
    stack mut u32[0 max] rangeStartToken = 0;
    stack mut u32[0 max] rangeEndToken = 0;
    stack mut u32[0 max] elementCountStartToken = 0;
    stack mut u32[0 max] elementCountEndToken = 0;
    stack mut u32[0 max] bitWidth = 0;
    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    stack mut u32[0 max] typeFlags = 0;

    if (item.TypeStartToken != 0 && item.TypeEndToken > item.TypeStartToken)
    {
        stack mut TypedSignatureTypeKind arrayKind = TypedSignatureTypeKind.Unknown;
        TypedSignatureScanTopLevelTypeFacts(
            stream,
            item.TypeStartToken,
            item.TypeEndToken,
            rangeStartToken,
            rangeEndToken,
            elementCountStartToken,
            elementCountEndToken,
            arrayKind);

        typeHeadToken = TypedFieldLastIdentifierInSpan(stream, item.TypeStartToken, item.TypeEndToken);
        typePrimaryToken = TypedSignatureSemanticPrimaryToken(stream, item.TypeStartToken, item.TypeEndToken, typeHeadToken);
        if (typePrimaryToken != 0)
        {
            typeStartToken = item.TypeStartToken;
            typeEndToken = item.TypeEndToken;
            typeKind = TypedSignatureKindForType(source, stream, typePrimaryToken, typeHeadToken, functionGenericOpenToken, ownerGenericOpenToken, arrayKind);

            stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])typePrimaryToken);
            if (primaryKind == TokenKind.IntegerType)
            {
                bitWidth = TypedSignatureIntegerBitWidth(source, stream, typePrimaryToken);
            }
            else if (primaryKind == TokenKind.FloatType)
            {
                bitWidth = TypedSignatureFloatBitWidth(source, stream, typePrimaryToken);
            }

            if (typeHeadToken != 0 && stream.KindAt((u64[0 2 ** 63 - 1])(typeHeadToken + 1)) == TokenKind.Lt)
            {
                TypedSignatureCountGenericArgumentsInList(stream, (u32[0 max])(typeHeadToken + 1), typeArgumentCount, comptimeArgumentCount);
            }

            stack mut u32[0 max] deadOnReturnCount = 0;
            if (TypedSignatureTypeSpanContainsDeadOnReturnContract(stream, typeStartToken, typeEndToken))
            {
                deadOnReturnCount = 1;
            }

            typeFlags = TypedSignatureFlagsForType(
                source,
                stream,
                typePrimaryToken,
                typeHeadToken,
                typeStartToken,
                typeEndToken,
                functionGenericOpenToken,
                ownerGenericOpenToken,
                rangeStartToken,
                rangeEndToken,
                elementCountStartToken,
                TypedSignatureTypeSpanContainsTailCallableSignature(stream, typeStartToken, typeEndToken),
                deadOnReturnCount,
                false);
        }
    }

    stack mut u32[0 max] initializerStartToken = 0;
    stack mut u32[0 max] initializerEndToken = 0;
    stack u32[0 max] assignToken = TypedLocalDeclarationAssignToken(stream, item);
    if (assignToken != 0)
    {
        initializerStartToken = (u32[0 max])(assignToken + 1);
        initializerEndToken = TypedLocalDeclarationInitializerEndExclusive(stream, item);
    }

    return table.Append(
        ownerDeclarationIndex,
        ownerNameToken,
        functionNameToken,
        ownerKind,
        (u32[0 max])(statementIndex + 1),
        item.NameToken,
        item.StartToken,
        item.EndToken,
        TypedLocalDeclarationStorageKind(stream, item.StartToken),
        body.ExprRootAt(statementIndex),
        initializerStartToken,
        initializerEndToken,
        body.DepthAt(statementIndex),
        body.ScopeIdAt(statementIndex),
        typeKind,
        typeHeadToken,
        typePrimaryToken,
        typeStartToken,
        typeEndToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        elementCountEndToken,
        bitWidth,
        typeArgumentCount,
        comptimeArgumentCount,
        typeFlags);
}

internal fn System.Memory.MemoryStatus AppendTypedLocalDeclarationsForBody(
    mut borrow TypedLocalDeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] functionNameToken,
    TypedLocalDeclarationOwnerKind ownerKind,
    u32[0 max] functionGenericOpenToken,
    u32[0 max] ownerGenericOpenToken,
    borrow StatementList body)
{
    stack u64[0 2 ** 63 - 1] count = body.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        switch (AppendTypedLocalDeclaration(
            table,
            source,
            stream,
            ownerDeclarationIndex,
            ownerNameToken,
            functionNameToken,
            ownerKind,
            functionGenericOpenToken,
            ownerGenericOpenToken,
            body,
            index,
            body.ItemAt(index)))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedLocalDeclarationsForFunction(
    mut borrow TypedLocalDeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerNameToken,
    u32[0 max] fnKeyword,
    TypedLocalDeclarationOwnerKind ownerKind,
    u32[0 max] ownerGenericOpenToken)
{
    stack mut FunctionSignature signature = new();
    switch (ParseFunctionSignature(stream, fnKeyword))
    {
        case ParseResult<FunctionSignature>.Err(var signatureError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FunctionSignature>.Ok(var parsedSignature):
            signature = parsedSignature;
    }

    stack mut StatementList body = new();
    switch (ParseFunctionBody(stream, fnKeyword))
    {
        case ParseResult<StatementList>.Err(var bodyError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<StatementList>.Ok(var parsedBody):
            body = parsedBody;
    }

    return AppendTypedLocalDeclarationsForBody(
        table,
        source,
        stream,
        ownerDeclarationIndex,
        ownerNameToken,
        signature.Name(),
        ownerKind,
        TypedSignatureGenericOpenAfterName(stream, signature.Name()),
        ownerGenericOpenToken,
        body);
}

internal fn System.Memory.MemoryStatus AppendTypedMemberLocalDeclarationsForDeclaration(
    mut borrow TypedLocalDeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem item,
    u32[0 max] ownerDeclarationIndex)
{
    if (!TypedSignatureDeclarationCanOwnMethods(item.Kind))
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, item);
    if (bodyOpen == 0 || bodyOpen >= item.EndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] ownerGenericOpenToken = TypedSignatureGenericOpenAfterName(stream, item.NameToken);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = (u32[0 max])(bodyOpen + 1);
    while willexit (scan < item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.Fn)
        {
            switch (AppendTypedLocalDeclarationsForFunction(
                table,
                source,
                stream,
                ownerDeclarationIndex,
                item.NameToken,
                scan,
                TypedLocalDeclarationOwnerKind.MemberMethod,
                ownerGenericOpenToken))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}