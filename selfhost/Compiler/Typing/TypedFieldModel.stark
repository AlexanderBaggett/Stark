import Compiler.Parsing
import Compiler.Typing.TypedSignatures
import System.Memory
module Compiler.Typing.TypedFieldModel

public struct TypedFieldDeclarationTable
{
    internal dynamic u32[0 max] OwnerDeclarationIndices;
    internal dynamic DeclarationKind OwnerKinds;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic u32[0 max] FieldOrdinals;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] EndTokens;
    internal dynamic TypedSignatureTypeKind TypeKinds;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic u32[0 max] RangeStartTokens;
    internal dynamic u32[0 max] RangeEndTokens;
    internal dynamic u32[0 max] ElementCountStartTokens;
    internal dynamic u32[0 max] ElementCountEndTokens;
    internal dynamic u32[0 max] BitWidths;
    internal dynamic u32[0 max] TypeArgumentCounts;
    internal dynamic u32[0 max] ComptimeArgumentCounts;
    internal dynamic u32[0 max] TypeFlags;
    internal dynamic u32[0 max] StorageCapacityStartTokens;
    internal dynamic u32[0 max] StorageCapacityEndTokens;

    TypedFieldDeclarationTable()
    {
        self.OwnerDeclarationIndices = new();
        self.OwnerKinds = new();
        self.OwnerNameTokens = new();
        self.FieldOrdinals = new();
        self.NameTokens = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.TypeKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.RangeStartTokens = new();
        self.RangeEndTokens = new();
        self.ElementCountStartTokens = new();
        self.ElementCountEndTokens = new();
        self.BitWidths = new();
        self.TypeArgumentCounts = new();
        self.ComptimeArgumentCounts = new();
        self.TypeFlags = new();
        self.StorageCapacityStartTokens = new();
        self.StorageCapacityEndTokens = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedFieldDeclarationTable self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] OwnerDeclarationIndexAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.OwnerDeclarationIndices.Length)
        {
            value = self.OwnerDeclarationIndices[index];
        }

        return value;
    }

    public law DeclarationKind OwnerKindAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut DeclarationKind kind = DeclarationKind.Unknown;
        if (index < self.OwnerKinds.Length)
        {
            kind = self.OwnerKinds[index];
        }

        return kind;
    }

    public law u32[0 max] OwnerNameTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.OwnerNameTokens.Length)
        {
            token = self.OwnerNameTokens[index];
        }

        return token;
    }

    public law u32[0 max] FieldOrdinalAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] ordinal = 0;
        if (index < self.FieldOrdinals.Length)
        {
            ordinal = self.FieldOrdinals[index];
        }

        return ordinal;
    }

    public law u32[0 max] NameTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    public law u32[0 max] StartTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.StartTokens.Length)
        {
            token = self.StartTokens[index];
        }

        return token;
    }

    public law u32[0 max] EndTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.EndTokens.Length)
        {
            token = self.EndTokens[index];
        }

        return token;
    }

    public law TypedSignatureTypeKind TypeKindAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedSignatureTypeKind kind = TypedSignatureTypeKind.Unknown;
        if (index < self.TypeKinds.Length)
        {
            kind = self.TypeKinds[index];
        }

        return kind;
    }

    public law u32[0 max] TypeHeadTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeHeadTokens.Length)
        {
            token = self.TypeHeadTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypePrimaryTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypePrimaryTokens.Length)
        {
            token = self.TypePrimaryTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeStartTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeStartTokens.Length)
        {
            token = self.TypeStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeEndTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeEndTokens.Length)
        {
            token = self.TypeEndTokens[index];
        }

        return token;
    }

    public law u32[0 max] RangeStartTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.RangeStartTokens.Length)
        {
            token = self.RangeStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] RangeEndTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.RangeEndTokens.Length)
        {
            token = self.RangeEndTokens[index];
        }

        return token;
    }

    public law u32[0 max] ElementCountStartTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ElementCountStartTokens.Length)
        {
            token = self.ElementCountStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] ElementCountEndTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ElementCountEndTokens.Length)
        {
            token = self.ElementCountEndTokens[index];
        }

        return token;
    }

    public law u32[0 max] BitWidthAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] width = 0;
        if (index < self.BitWidths.Length)
        {
            width = self.BitWidths[index];
        }

        return width;
    }

    public law u32[0 max] TypeArgumentCountAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.TypeArgumentCounts.Length)
        {
            count = self.TypeArgumentCounts[index];
        }

        return count;
    }

    public law u32[0 max] ComptimeArgumentCountAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ComptimeArgumentCounts.Length)
        {
            count = self.ComptimeArgumentCounts[index];
        }

        return count;
    }

    public law u32[0 max] TypeFlagsAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flags = 0;
        if (index < self.TypeFlags.Length)
        {
            flags = self.TypeFlags[index];
        }

        return flags;
    }

    public law u32[0 max] StorageCapacityStartTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.StorageCapacityStartTokens.Length)
        {
            token = self.StorageCapacityStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] StorageCapacityEndTokenAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.StorageCapacityEndTokens.Length)
        {
            token = self.StorageCapacityEndTokens[index];
        }

        return token;
    }

    public law bool HasStorageCapacityAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.StorageCapacityStartTokenAt(index) != 0 && self.StorageCapacityEndTokenAt(index) > self.StorageCapacityStartTokenAt(index);
    }

    public law bool IsIntegerSignedAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerSigned());
    }

    public law bool IsIntegerUnsignedAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerUnsigned());
    }

    public law bool HasIntegerRangeAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHasIntegerRange());
    }

    public law bool RangeStartsAtMinAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRangeStartsAtMin());
    }

    public law bool RangeEndsAtMaxAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRangeEndsAtMax());
    }

    public law bool IsBorrowAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagBorrow());
    }

    public law bool IsRawMutablePointerAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRawMutablePointer());
    }

    public law bool HasElementCountExpressionAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHasElementCountExpression());
    }

    public law bool IsOwnedTextAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagOwnedText());
    }

    public law bool IsUnicodeTextAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagUnicodeText());
    }

    public law bool TypeHeadIsGenericParameterAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHeadIsGenericParameter());
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedFieldDeclarationTable self,
        u32[0 max] ownerDeclarationIndex,
        DeclarationKind ownerKind,
        u32[0 max] ownerNameToken,
        u32[0 max] fieldOrdinal,
        u32[0 max] nameToken,
        u32[0 max] startToken,
        u32[0 max] endToken,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] elementCountStartToken,
        u32[0 max] elementCountEndToken,
        u32[0 max] bitWidth,
        u32[0 max] typeArgumentCount,
        u32[0 max] comptimeArgumentCount,
        u32[0 max] typeFlags,
        u32[0 max] storageCapacityStartToken,
        u32[0 max] storageCapacityEndToken)
    {
        if (!self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerKinds.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.FieldOrdinals.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ElementCountStartTokens.TryReserve(1)
            || !self.ElementCountEndTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeArgumentCounts.TryReserve(1)
            || !self.ComptimeArgumentCounts.TryReserve(1)
            || !self.TypeFlags.TryReserve(1)
            || !self.StorageCapacityStartTokens.TryReserve(1)
            || !self.StorageCapacityEndTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerKinds[self.OwnerKinds.Length] = ownerKind;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.FieldOrdinals[self.FieldOrdinals.Length] = fieldOrdinal;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.StartTokens[self.StartTokens.Length] = startToken;
        init self.EndTokens[self.EndTokens.Length] = endToken;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ElementCountStartTokens[self.ElementCountStartTokens.Length] = elementCountStartToken;
        init self.ElementCountEndTokens[self.ElementCountEndTokens.Length] = elementCountEndToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeArgumentCounts[self.TypeArgumentCounts.Length] = typeArgumentCount;
        init self.ComptimeArgumentCounts[self.ComptimeArgumentCounts.Length] = comptimeArgumentCount;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        init self.StorageCapacityStartTokens[self.StorageCapacityStartTokens.Length] = storageCapacityStartToken;
        init self.StorageCapacityEndTokens[self.StorageCapacityEndTokens.Length] = storageCapacityEndToken;
        return System.Memory.MemoryStatus.Ok;
    }
}
