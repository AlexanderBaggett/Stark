import Compiler.Typing.TypedMemberFacts
import Compiler.Typing.TypedSignatures
import System.Memory
module Compiler.Typing.TypedConversionModel

public enum TypedConversionContext
{
    GlobalInitializer,
    FunctionBody,
    Unknown,
}

public enum TypedConversionOperandKind
{
    Identifier,
    Member,
    Call,
    Index,
    Literal,
    New,
    Conversion,
    Unknown,
}

internal inline finite law u32[0 max] TypedConversionFlagTargetResolved()
{
    return 1;
}

internal inline finite law u32[0 max] TypedConversionFlagOperandResolved()
{
    return 2;
}

internal inline finite law u32[0 max] TypedConversionFlagExplicit()
{
    return 4;
}

internal inline finite law u32[0 max] TypedConversionFlagNumeric()
{
    return 8;
}

internal inline finite law u32[0 max] TypedConversionFlagPointer()
{
    return 16;
}

internal inline finite law u32[0 max] TypedConversionFlagText()
{
    return 32;
}

internal inline finite law u32[0 max] TypedConversionFlagArrayToSlice()
{
    return 64;
}

internal inline finite law bool TypedConversionFlagPresent(u32[0 max] flags, u32[0 max] flag)
{
    return (flags & flag) != 0;
}

