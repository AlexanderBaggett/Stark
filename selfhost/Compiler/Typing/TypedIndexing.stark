    public law bool ReceiverResolvedAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedIndexFlagPresent(self.IndexFlagsAt(index), TypedIndexFlagReceiverResolved());
    }

    public law bool ResultResolvedAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedIndexFlagPresent(self.IndexFlagsAt(index), TypedIndexFlagResultResolved());
    }

    public law bool IsSliceAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedIndexFlagPresent(self.IndexFlagsAt(index), TypedIndexFlagSlice());
    }

    public law bool IsIntegerSignedAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerSigned());
