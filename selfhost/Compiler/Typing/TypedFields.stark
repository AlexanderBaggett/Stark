import Compiler.Lexing
import Compiler.Parsing
export import Compiler.Typing.TypedFieldHelpers
export import Compiler.Typing.TypedFieldModel
export import Compiler.Typing.TypedFieldRows
import Compiler.Typing.TypedGenerics
import Compiler.Typing.TypedSignatures
import System.Memory
module Compiler.Typing.TypedFields

internal fn u32[0 max] TypedFieldRecordHeaderOpenToken(borrow TokenStream stream, DeclItem item)
{
    if (item.Kind != DeclarationKind.Record || item.NameToken == 0)
    {
        return 0;
    }

    stack mut u32[0 max] scan = (u32[0 max])(item.NameToken + 1);
    stack mut u32[0 max] angleDepth = 0;
    while willexit (scan <= item.EndToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile || kind == TokenKind.LBrace || kind == TokenKind.Semi)
        {
            return 0;
        }

        if (kind == TokenKind.LParen && angleDepth == 0)
        {
            return scan;
        }

        if (kind == TokenKind.Lt)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (kind == TokenKind.Gt)
        {
            if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn System.Memory.MemoryStatus AppendTypedRecordHeaderFieldsForDeclaration(
    mut borrow TypedFieldDeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerGenericOpenToken,
    out u32[0 max] nextFieldOrdinal)
{
    nextFieldOrdinal = 0;
    stack mut u32[0 max] ordinal = 0;
    stack u32[0 max] openToken = TypedFieldRecordHeaderOpenToken(stream, owner);
    if (openToken == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] closeToken = TypedSignatureMatchingCloseToken(stream, openToken);
    if (closeToken <= openToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] segmentStart = (u32[0 max])(openToken + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = segmentStart;
    while willexit (scan <= closeToken)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        stack mut bool boundary = scan == closeToken;
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        if (depth == 0 && kind == TokenKind.Comma)
        {
            boundary = true;
        }

        if (boundary)
        {
            stack u32[0 max] cursor = TypedFieldMemberKindCursor(stream, segmentStart);
            stack u32[0 max] nameToken = TypedFieldLastIdentifierInSpan(stream, cursor, scan);
            if (nameToken != 0 && cursor < nameToken)
            {
                stack u32[0 max] typeHeadToken = TypedFieldLastIdentifierInSpan(stream, cursor, nameToken);
                stack u32[0 max] capacityStart = TypedFieldStorageCapacityStartToken(stream, nameToken, scan);
                stack u32[0 max] capacityEnd = TypedFieldStorageCapacityEndToken(stream, capacityStart);
                stack mut u32[0 max] fieldEnd = nameToken;
                if (capacityEnd != 0)
                {
                    fieldEnd = capacityEnd;
                }

                switch (AppendTypedFieldDeclaration(
                    table,
                    source,
                    stream,
                    owner,
                    ownerDeclarationIndex,
                    ownerGenericOpenToken,
                    ordinal,
                    nameToken,
                    segmentStart,
                    fieldEnd,
                    typeHeadToken,
                    cursor,
                    nameToken,
                    capacityStart,
                    capacityEnd))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return System.Memory.MemoryStatus.Err(appendError);
                    case System.Memory.MemoryStatus.Ok:
                }

                ordinal = (u32[0 max])(ordinal + 1);
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    nextFieldOrdinal = ordinal;
    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedBodyFieldsForDeclaration(
    mut borrow TypedFieldDeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerGenericOpenToken,
    u32[0 max] firstFieldOrdinal)
{
    stack mut FieldList fields = new();
    switch (ParseStructFields(stream, owner.KeywordToken))
    {
        case ParseResult<FieldList>.Err(var fieldError):
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        case ParseResult<FieldList>.Ok(var parsedFields):
            fields = parsedFields;
    }

    stack u64[0 2 ** 63 - 1] count = fields.Count();
    for willexit (stack mut u64[0 2 ** 63 - 1] index = 0; index < count; index += 1)
    {
        stack u32[0 max] nameToken = fields.NameTokenAt(index);
        stack u32[0 max] capacityStart = TypedFieldStorageCapacityStartToken(stream, nameToken, owner.EndToken);
        stack u32[0 max] capacityEnd = TypedFieldStorageCapacityEndToken(stream, capacityStart);
        stack mut u32[0 max] fieldEnd = nameToken;
        if (capacityEnd != 0)
        {
            fieldEnd = capacityEnd;
        }

        switch (AppendTypedFieldDeclaration(
            table,
            source,
            stream,
            owner,
            ownerDeclarationIndex,
            ownerGenericOpenToken,
            (u32[0 max])(firstFieldOrdinal + index),
            nameToken,
            fields.TypeStartAt(index),
            fieldEnd,
            fields.TypeHeadAt(index),
            fields.TypeStartAt(index),
            fields.TypeEndAt(index),
            capacityStart,
            capacityEnd))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedFieldsForDeclaration(
    mut borrow TypedFieldDeclarationTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner,
    u32[0 max] ownerDeclarationIndex)
{
    stack u32[0 max] ownerGenericOpenToken = TypedSignatureGenericOpenAfterName(stream, owner.NameToken);
    stack mut u32[0 max] nextFieldOrdinal = 0;
    if (owner.Kind == DeclarationKind.Record)
    {
        switch (AppendTypedRecordHeaderFieldsForDeclaration(table, source, stream, owner, ownerDeclarationIndex, ownerGenericOpenToken, nextFieldOrdinal))
        {
            case System.Memory.MemoryStatus.Err(var headerError):
                return System.Memory.MemoryStatus.Err(headerError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return AppendTypedBodyFieldsForDeclaration(table, source, stream, owner, ownerDeclarationIndex, ownerGenericOpenToken, nextFieldOrdinal);
}
