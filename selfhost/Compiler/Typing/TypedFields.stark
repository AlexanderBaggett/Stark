import Compiler.Lexing
import Compiler.Parsing
import Compiler.Typing.TypedGenerics
import Compiler.Typing.TypedSignatures
import System.Memory
module Compiler.Typing.TypedFields

public struct TypedFieldDeclarationTable
{
    internal dynamic u32[0 max] OwnerDeclarationIndices;
    internal dynamic DeclarationKind OwnerKinds;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic u32[0 max] FieldOrdinals;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] EndTokens;
    internal dynamic TypedSignatureTypeKind TypeKinds;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic u32[0 max] RangeStartTokens;
    internal dynamic u32[0 max] RangeEndTokens;
    internal dynamic u32[0 max] ElementCountStartTokens;
    internal dynamic u32[0 max] ElementCountEndTokens;
    internal dynamic u32[0 max] BitWidths;
    internal dynamic u32[0 max] TypeArgumentCounts;
    internal dynamic u32[0 max] ComptimeArgumentCounts;
    internal dynamic u32[0 max] TypeFlags;
    internal dynamic u32[0 max] StorageCapacityStartTokens;
    internal dynamic u32[0 max] StorageCapacityEndTokens;

    TypedFieldDeclarationTable()
    {
        self.OwnerDeclarationIndices = new();
        self.OwnerKinds = new();
        self.OwnerNameTokens = new();
        self.FieldOrdinals = new();
        self.NameTokens = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.TypeKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.RangeStartTokens = new();
        self.RangeEndTokens = new();
        self.ElementCountStartTokens = new();
        self.ElementCountEndTokens = new();
        self.BitWidths = new();
        self.TypeArgumentCounts = new();
        self.ComptimeArgumentCounts = new();
        self.TypeFlags = new();
        self.StorageCapacityStartTokens = new();
        self.StorageCapacityEndTokens = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedFieldDeclarationTable self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] OwnerDeclarationIndexAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.OwnerDeclarationIndices.Length)
        {
            value = self.OwnerDeclarationIndices[index];
        }

        return value;
    }

    public law DeclarationKind OwnerKindAt(borrow TypedFieldDeclarationTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut DeclarationKind kind = DeclarationKind.Unknown;
        if (index < self.OwnerKinds.Length)
        {
            kind = self.OwnerKinds[index];
        }

        return kind;
    }

