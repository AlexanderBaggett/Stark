    public law bool TypeHeadIsGenericParameterAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHeadIsGenericParameter());
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedEnumPayloadTable self,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
        u32[0 max] variantOrdinal,
        u32[0 max] variantNameToken,
        u32[0 max] payloadOrdinal,
        u32[0 max] payloadNameToken,
        TypedEnumPayloadKind payloadKind,
        TypedEnumVariantRole variantRole,
        bool errorFunnel,
        u32[0 max] startToken,
        u32[0 max] endToken,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] elementCountStartToken,
        u32[0 max] elementCountEndToken,
        u32[0 max] bitWidth,
        u32[0 max] typeArgumentCount,
        u32[0 max] comptimeArgumentCount,
        u32[0 max] typeFlags)
    {
        if (!self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.VariantOrdinals.TryReserve(1)
            || !self.VariantNameTokens.TryReserve(1)
            || !self.PayloadOrdinals.TryReserve(1)
            || !self.PayloadNameTokens.TryReserve(1)
            || !self.PayloadKinds.TryReserve(1)
            || !self.VariantRoles.TryReserve(1)
            || !self.ErrorFunnels.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ElementCountStartTokens.TryReserve(1)
            || !self.ElementCountEndTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeArgumentCounts.TryReserve(1)
            || !self.ComptimeArgumentCounts.TryReserve(1)
            || !self.TypeFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.VariantOrdinals[self.VariantOrdinals.Length] = variantOrdinal;
        init self.VariantNameTokens[self.VariantNameTokens.Length] = variantNameToken;
        init self.PayloadOrdinals[self.PayloadOrdinals.Length] = payloadOrdinal;
        init self.PayloadNameTokens[self.PayloadNameTokens.Length] = payloadNameToken;
        init self.PayloadKinds[self.PayloadKinds.Length] = payloadKind;
        init self.VariantRoles[self.VariantRoles.Length] = variantRole;
        init self.ErrorFunnels[self.ErrorFunnels.Length] = errorFunnel;
        init self.StartTokens[self.StartTokens.Length] = startToken;
        init self.EndTokens[self.EndTokens.Length] = endToken;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ElementCountStartTokens[self.ElementCountStartTokens.Length] = elementCountStartToken;
        init self.ElementCountEndTokens[self.ElementCountEndTokens.Length] = elementCountEndToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeArgumentCounts[self.TypeArgumentCounts.Length] = typeArgumentCount;
        init self.ComptimeArgumentCounts[self.ComptimeArgumentCounts.Length] = comptimeArgumentCount;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}


internal finite law bool TypedEnumPayloadAttributeListContainsName(ascii source, borrow TokenStream stream, u32[0 max] attrStart, u32[0 max] attrEnd, ascii name)
{
    stack mut u32[0 max] scan = (u32[0 max])(attrStart + 1);
    while willexit (scan < attrEnd)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Identifier
            && TypedSignatureTokenTextEquals(source, stream, scan, name))
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

internal finite law bool TypedEnumPayloadLeadingAttributesContain(
    ascii source,
    borrow TokenStream stream,
    u32[0 max] start,
    u32[0 max] endExclusive,
    ascii name)
{
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive && stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.LBrack)
    {
        stack u32[0 max] attrEnd = TypedSignatureMatchingCloseToken(stream, scan);
        if (attrEnd <= scan)
        {
            return false;
        }

        if (TypedEnumPayloadAttributeListContainsName(source, stream, scan, attrEnd, name))
        {
            return true;
        }

        scan = (u32[0 max])(attrEnd + 1);
    }

    return false;
}

internal finite law TypedEnumVariantRole TypedEnumPayloadVariantRole(ascii source, borrow TokenStream stream, u32[0 max] variantStart, u32[0 max] variantNameToken)
{
    stack bool okRole = TypedEnumPayloadLeadingAttributesContain(source, stream, variantStart, variantNameToken, "Ok");
    stack bool errRole = TypedEnumPayloadLeadingAttributesContain(source, stream, variantStart, variantNameToken, "Err");
    if (okRole && errRole)
    {
        return TypedEnumVariantRole.OkErr;
    }

    if (okRole)
    {
        return TypedEnumVariantRole.Ok;
    }

    if (errRole)
    {
        return TypedEnumVariantRole.Err;
    }

    return TypedEnumVariantRole.None;
}

internal fn System.Memory.MemoryStatus AppendTypedEnumPayload(
    mut borrow TypedEnumPayloadTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerGenericOpenToken,
    u32[0 max] variantOrdinal,
    u32[0 max] variantNameToken,
    TypedEnumVariantRole variantRole,
    u32[0 max] payloadOrdinal,
    u32[0 max] payloadNameToken,
    TypedEnumPayloadKind payloadKind,
    bool errorFunnel,
    u32[0 max] typeStartToken,
    u32[0 max] typeEndToken)
{
    if (typeStartToken == 0 || typeStartToken >= typeEndToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] rangeStartToken = 0;
    stack mut u32[0 max] rangeEndToken = 0;
    stack mut u32[0 max] elementCountStartToken = 0;
    stack mut u32[0 max] elementCountEndToken = 0;
    stack mut TypedSignatureTypeKind arrayKind = TypedSignatureTypeKind.Unknown;
    TypedSignatureScanTopLevelTypeFacts(
        stream,
        typeStartToken,
        typeEndToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        elementCountEndToken,
        arrayKind);

    stack u32[0 max] typeHeadToken = TypedFieldLastIdentifierInSpan(stream, typeStartToken, typeEndToken);
    stack u32[0 max] semanticPrimaryToken = TypedSignatureSemanticPrimaryToken(stream, typeStartToken, typeEndToken, typeHeadToken);
    stack TypedSignatureTypeKind typeKind = TypedSignatureKindForType(source, stream, semanticPrimaryToken, typeHeadToken, 0, ownerGenericOpenToken, arrayKind);
    stack mut u32[0 max] bitWidth = 0;
    stack TokenKind primaryKind = stream.KindAt((u64[0 2 ** 63 - 1])semanticPrimaryToken);
    if (primaryKind == TokenKind.IntegerType)
    {
        bitWidth = TypedSignatureIntegerBitWidth(source, stream, semanticPrimaryToken);
    }
    else if (primaryKind == TokenKind.FloatType)
    {
        bitWidth = TypedSignatureFloatBitWidth(source, stream, semanticPrimaryToken);
    }

    stack mut u32[0 max] typeArgumentCount = 0;
    stack mut u32[0 max] comptimeArgumentCount = 0;
    if (typeHeadToken != 0 && stream.KindAt((u64[0 2 ** 63 - 1])(typeHeadToken + 1)) == TokenKind.Lt)
    {
        TypedSignatureCountGenericArgumentsInList(stream, (u32[0 max])(typeHeadToken + 1), typeArgumentCount, comptimeArgumentCount);
    }

    stack u32[0 max] flags = TypedSignatureFlagsForType(
        source,
        stream,
        semanticPrimaryToken,
        typeHeadToken,
        typeStartToken,
        typeEndToken,
        0,
        ownerGenericOpenToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        false,
        0,
        false);

    return table.Append(
        ownerDeclarationIndex,
        owner.NameToken,
        variantOrdinal,
        variantNameToken,
        payloadOrdinal,
        payloadNameToken,
        payloadKind,
        variantRole,
        errorFunnel,
        typeStartToken,
        typeEndToken,
        typeKind,
        typeHeadToken,
        semanticPrimaryToken,
        typeStartToken,
        typeEndToken,
        rangeStartToken,
        rangeEndToken,
        elementCountStartToken,
        elementCountEndToken,
        bitWidth,
        typeArgumentCount,
        comptimeArgumentCount,
        flags);
}

internal fn System.Memory.MemoryStatus AppendTypedEnumTuplePayloads(
    mut borrow TypedEnumPayloadTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerGenericOpenToken,
    u32[0 max] variantOrdinal,
    u32[0 max] variantNameToken,
    TypedEnumVariantRole variantRole,
    u32[0 max] openToken)
{
    stack u32[0 max] closeToken = TypedSignatureMatchingCloseToken(stream, openToken);
    if (closeToken <= openToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] payloadOrdinal = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(openToken + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = segmentStart;
    while willexit (scan <= closeToken)
    {
        stack mut bool boundary = scan == closeToken;
        if (!boundary)
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            if (segmentStart < scan)
            {
                switch (AppendTypedEnumPayload(
                    table,
                    source,
                    stream,
                    owner,
                    ownerDeclarationIndex,
                    ownerGenericOpenToken,
                    variantOrdinal,
                    variantNameToken,
                    variantRole,
                    payloadOrdinal,
                    0,
                    TypedEnumPayloadKind.Positional,
                    false,
                    segmentStart,
                    scan))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return System.Memory.MemoryStatus.Err(appendError);
                    case System.Memory.MemoryStatus.Ok:
                }

                payloadOrdinal = (u32[0 max])(payloadOrdinal + 1);
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn u32[0 max] TypedEnumNamedPayloadColonToken(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && kind == TokenKind.Colon)
        {
            return scan;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn System.Memory.MemoryStatus AppendTypedEnumNamedPayloads(
    mut borrow TypedEnumPayloadTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerGenericOpenToken,
    u32[0 max] variantOrdinal,
    u32[0 max] variantNameToken,
    TypedEnumVariantRole variantRole,
    u32[0 max] openToken)
{
    stack u32[0 max] closeToken = TypedSignatureMatchingCloseToken(stream, openToken);
    if (closeToken <= openToken)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] payloadOrdinal = 0;
    stack mut u32[0 max] segmentStart = (u32[0 max])(openToken + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] scan = segmentStart;
    while willexit (scan <= closeToken)
    {
        stack mut bool boundary = scan == closeToken;
        if (!boundary)
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && kind == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            stack u32[0 max] colonToken = TypedEnumNamedPayloadColonToken(stream, segmentStart, scan);
            if (colonToken != 0 && (u32[0 max])(colonToken + 1) < scan)
            {
                stack u32[0 max] payloadName = TypedFieldLastIdentifierInSpan(stream, segmentStart, colonToken);
                switch (AppendTypedEnumPayload(
                    table,
                    source,
                    stream,
                    owner,
                    ownerDeclarationIndex,
                    ownerGenericOpenToken,
                    variantOrdinal,
                    variantNameToken,
                    variantRole,
                    payloadOrdinal,
                    payloadName,
                    TypedEnumPayloadKind.Named,
                    false,
                    (u32[0 max])(colonToken + 1),
                    scan))
                {
                    case System.Memory.MemoryStatus.Err(var appendError):
                        return System.Memory.MemoryStatus.Err(appendError);
                    case System.Memory.MemoryStatus.Ok:
                }

                payloadOrdinal = (u32[0 max])(payloadOrdinal + 1);
            }

            segmentStart = (u32[0 max])(scan + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedEnumVariantPayloads(
    mut borrow TypedEnumPayloadTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner,
    u32[0 max] ownerDeclarationIndex,
    u32[0 max] ownerGenericOpenToken,
    u32[0 max] variantOrdinal,
    u32[0 max] variantStartToken,
    u32[0 max] variantNameToken,
    u32[0 max] variantEndExclusive)
{
    stack TypedEnumVariantRole role = TypedEnumPayloadVariantRole(source, stream, variantStartToken, variantNameToken);
    stack mut u32[0 max] scan = (u32[0 max])(variantNameToken + 1);
    stack mut u32[0 max] depth = 0;
    while willexit (scan < variantEndExclusive)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (depth == 0 && kind == TokenKind.From)
        {
            return AppendTypedEnumPayload(
                table,
                source,
                stream,
                owner,
                ownerDeclarationIndex,
                ownerGenericOpenToken,
                variantOrdinal,
                variantNameToken,
                role,
                0,
                0,
                TypedEnumPayloadKind.From,
                true,
                (u32[0 max])(scan + 1),
                variantEndExclusive);
        }

        if (depth == 0 && kind == TokenKind.LParen)
        {
            return AppendTypedEnumTuplePayloads(table, source, stream, owner, ownerDeclarationIndex, ownerGenericOpenToken, variantOrdinal, variantNameToken, role, scan);
        }

        if (depth == 0 && kind == TokenKind.LBrace)
        {
            return AppendTypedEnumNamedPayloads(table, source, stream, owner, ownerDeclarationIndex, ownerGenericOpenToken, variantOrdinal, variantNameToken, role, scan);
        }

        if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus AppendTypedEnumPayloadsForDeclaration(
    mut borrow TypedEnumPayloadTable table,
    ascii source,
    borrow TokenStream stream,
    DeclItem owner,
    u32[0 max] ownerDeclarationIndex)
{
    stack u32[0 max] bodyOpen = TypedSignatureDeclarationBodyOpenToken(stream, owner);
    if (bodyOpen == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack u32[0 max] ownerGenericOpenToken = TypedSignatureGenericOpenAfterName(stream, owner.NameToken);
    stack mut u32[0 max] variantOrdinal = 0;
    stack mut u32[0 max] variantStart = (u32[0 max])(bodyOpen + 1);
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        while willexit (stream.KindAt((u64[0 2 ** 63 - 1])variantStart) == TokenKind.Comma)
        {
            variantStart = (u32[0 max])(variantStart + 1);
        }

        stack TokenKind startKind = stream.KindAt((u64[0 2 ** 63 - 1])variantStart);
        if (startKind == TokenKind.EndOfFile || startKind == TokenKind.RBrace)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack mut u32[0 max] scan = variantStart;
        stack mut u32[0 max] depth = 0;
        stack mut u32[0 max] variantNameToken = 0;
        stack mut u32[0 max] delimiter = 0;
        stack mut bool reachedBodyEnd = false;
        while willexit (guard > 0)
        {
            guard = (u64[0 2 ** 63 - 1])(guard - 1);
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.EndOfFile)
            {
                delimiter = scan;
                reachedBodyEnd = true;
                break;
            }

            if (depth == 0 && (kind == TokenKind.Comma || kind == TokenKind.RBrace))
            {
                delimiter = scan;
                reachedBodyEnd = kind == TokenKind.RBrace;
                break;
            }

            if (depth == 0 && variantNameToken == 0 && kind == TokenKind.Identifier)
            {
                variantNameToken = scan;
            }

            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen || kind == TokenKind.LBrace)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen || kind == TokenKind.RBrace)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }

            scan = (u32[0 max])(scan + 1);
        }

        if (delimiter == 0)
        {
            delimiter = scan;
        }

        if (variantNameToken != 0)
        {
            switch (AppendTypedEnumVariantPayloads(
                table,
                source,
                stream,
                owner,
                ownerDeclarationIndex,
                ownerGenericOpenToken,
                variantOrdinal,
                variantStart,
                variantNameToken,
                delimiter))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(appendError);
                case System.Memory.MemoryStatus.Ok:
            }

            variantOrdinal = (u32[0 max])(variantOrdinal + 1);
        }

        if (reachedBodyEnd)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        variantStart = (u32[0 max])(delimiter + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}