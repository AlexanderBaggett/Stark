    public law u32[0 max] TypeFlagsAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] flags = 0;
        if (index < self.TypeFlags.Length)
        {
            flags = self.TypeFlags[index];
        }

        return flags;
    }

    public law bool IsResolvedAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) != TypedIdentifierTargetKind.Unknown;
    }

    public law bool IsParameterAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.Parameter;
    }

    public law bool IsLocalAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.Local;
    }

    public law bool IsGlobalAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.Global;
    }

    public law bool IsFunctionAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.Function;
    }

    public law bool IsTypeDeclarationAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return self.TargetKindAt(index) == TypedIdentifierTargetKind.TypeDeclaration;
    }

    public law bool IsIntegerSignedAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerSigned());
    }

    public law bool IsIntegerUnsignedAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerUnsigned());
    }

    public law bool HasIntegerRangeAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHasIntegerRange());
    }

    public law bool RangeStartsAtMinAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRangeStartsAtMin());
    }

    public law bool RangeEndsAtMaxAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRangeEndsAtMax());
    }

    public law bool IsBorrowAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagBorrow());
    }

    public law bool IsOutAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagOut());
    }

    public law bool IsRawMutablePointerAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagRawMutablePointer());
    }

    public law bool HasElementCountExpressionAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHasElementCountExpression());
    }

    public law bool IsMutableAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagMutableView());
    }

    public law bool IsTailCallableAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagTailCallable());
    }

    public law bool IsDeadOnReturnAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagDeadOnReturn());
    }

    public law bool IsOwnedTextAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagOwnedText());
    }

    public law bool IsUnicodeTextAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagUnicodeText());
    }

    internal fn System.Memory.MemoryStatus Append(
        mut borrow TypedIdentifierExpressionTable self,
        TypedIdentifierContext context,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
        u32[0 max] functionNameToken,
        u32[0 max] statementIndexPlusOne,
        u32[0 max] exprNode,
        u32[0 max] nameToken,
        TypedIdentifierTargetKind targetKind,
        u32[0 max] targetDeclarationIndex,
        u32[0 max] targetSymbolIndexPlusOne,
        u32[0 max] targetNameToken,
        u32[0 max] targetStatementIndexPlusOne,
        u32[0 max] targetParameterOrdinalPlusOne,
        DeclarationKind declarationKind,
        TypedGlobalStorageKind storageKind,
        TypedGlobalBindingKind bindingKind,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] elementCountStartToken,
        u32[0 max] elementCountEndToken,
        u32[0 max] bitWidth,
        u32[0 max] typeArgumentCount,
        u32[0 max] comptimeArgumentCount,
        u32[0 max] typeFlags)
    {
        if (!self.Contexts.TryReserve(1)
            || !self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.FunctionNameTokens.TryReserve(1)
            || !self.StatementIndices.TryReserve(1)
            || !self.ExprNodes.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.TargetKinds.TryReserve(1)
            || !self.TargetDeclarationIndices.TryReserve(1)
            || !self.TargetSymbolIndices.TryReserve(1)
            || !self.TargetNameTokens.TryReserve(1)
            || !self.TargetStatementIndices.TryReserve(1)
            || !self.TargetParameterOrdinals.TryReserve(1)
            || !self.DeclarationKinds.TryReserve(1)
            || !self.StorageKinds.TryReserve(1)
            || !self.BindingKinds.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ElementCountStartTokens.TryReserve(1)
            || !self.ElementCountEndTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeArgumentCounts.TryReserve(1)
            || !self.ComptimeArgumentCounts.TryReserve(1)
            || !self.TypeFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Contexts[self.Contexts.Length] = context;
        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.FunctionNameTokens[self.FunctionNameTokens.Length] = functionNameToken;
        init self.StatementIndices[self.StatementIndices.Length] = statementIndexPlusOne;
        init self.ExprNodes[self.ExprNodes.Length] = exprNode;
        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.TargetKinds[self.TargetKinds.Length] = targetKind;
        init self.TargetDeclarationIndices[self.TargetDeclarationIndices.Length] = targetDeclarationIndex;
        init self.TargetSymbolIndices[self.TargetSymbolIndices.Length] = targetSymbolIndexPlusOne;
        init self.TargetNameTokens[self.TargetNameTokens.Length] = targetNameToken;
        init self.TargetStatementIndices[self.TargetStatementIndices.Length] = targetStatementIndexPlusOne;
        init self.TargetParameterOrdinals[self.TargetParameterOrdinals.Length] = targetParameterOrdinalPlusOne;
        init self.DeclarationKinds[self.DeclarationKinds.Length] = declarationKind;
        init self.StorageKinds[self.StorageKinds.Length] = storageKind;
        init self.BindingKinds[self.BindingKinds.Length] = bindingKind;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ElementCountStartTokens[self.ElementCountStartTokens.Length] = elementCountStartToken;
        init self.ElementCountEndTokens[self.ElementCountEndTokens.Length] = elementCountEndToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeArgumentCounts[self.TypeArgumentCounts.Length] = typeArgumentCount;
        init self.ComptimeArgumentCounts[self.ComptimeArgumentCounts.Length] = comptimeArgumentCount;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}
