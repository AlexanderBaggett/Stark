    public law u32[0 max] TargetParameterOrdinalPlusOneAt(borrow TypedIdentifierExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.TargetParameterOrdinals.Length)
