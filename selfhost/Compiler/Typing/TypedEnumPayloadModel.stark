import Compiler.Typing.TypedSignatures
import System.Memory
module Compiler.Typing.TypedEnumPayloadModel

public enum TypedEnumPayloadKind
{
    Positional,
    Named,
    From,
    Unknown,
}

public enum TypedEnumVariantRole
{
    None,
    Ok,
    Err,
    OkErr,
}

public struct TypedEnumPayloadTable
{
    internal dynamic u32[0 max] OwnerDeclarationIndices;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic u32[0 max] VariantOrdinals;
    internal dynamic u32[0 max] VariantNameTokens;
    internal dynamic u32[0 max] PayloadOrdinals;
    internal dynamic u32[0 max] PayloadNameTokens;
    internal dynamic TypedEnumPayloadKind PayloadKinds;
    internal dynamic TypedEnumVariantRole VariantRoles;
    internal dynamic bool ErrorFunnels;
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] EndTokens;
    internal dynamic TypedSignatureTypeKind TypeKinds;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic u32[0 max] RangeStartTokens;
    internal dynamic u32[0 max] RangeEndTokens;
    internal dynamic u32[0 max] ElementCountStartTokens;
    internal dynamic u32[0 max] ElementCountEndTokens;
    internal dynamic u32[0 max] BitWidths;
    internal dynamic u32[0 max] TypeArgumentCounts;
    internal dynamic u32[0 max] ComptimeArgumentCounts;
    internal dynamic u32[0 max] TypeFlags;

    TypedEnumPayloadTable()
    {
        self.OwnerDeclarationIndices = new();
        self.OwnerNameTokens = new();
        self.VariantOrdinals = new();
        self.VariantNameTokens = new();
        self.PayloadOrdinals = new();
        self.PayloadNameTokens = new();
        self.PayloadKinds = new();
        self.VariantRoles = new();
        self.ErrorFunnels = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.TypeKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.RangeStartTokens = new();
        self.RangeEndTokens = new();
        self.ElementCountStartTokens = new();
        self.ElementCountEndTokens = new();
        self.BitWidths = new();
        self.TypeArgumentCounts = new();
        self.ComptimeArgumentCounts = new();
        self.TypeFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedEnumPayloadTable self)
    {
        return self.TypeKinds.Length;
    }

    public law u32[0 max] OwnerDeclarationIndexAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.OwnerDeclarationIndices.Length)
        {
            value = self.OwnerDeclarationIndices[index];
        }

        return value;
    }

    public law u32[0 max] OwnerNameTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.OwnerNameTokens.Length)
        {
            token = self.OwnerNameTokens[index];
        }

        return token;
    }

    public law u32[0 max] VariantOrdinalAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] ordinal = 0;
        if (index < self.VariantOrdinals.Length)
        {
            ordinal = self.VariantOrdinals[index];
        }

        return ordinal;
    }

    public law u32[0 max] VariantNameTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.VariantNameTokens.Length)
        {
            token = self.VariantNameTokens[index];
        }

        return token;
    }

    public law u32[0 max] PayloadOrdinalAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] ordinal = 0;
        if (index < self.PayloadOrdinals.Length)
        {
            ordinal = self.PayloadOrdinals[index];
        }

        return ordinal;
    }

    public law u32[0 max] PayloadNameTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.PayloadNameTokens.Length)
        {
            token = self.PayloadNameTokens[index];
        }

        return token;
    }

    public law TypedEnumPayloadKind PayloadKindAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedEnumPayloadKind kind = TypedEnumPayloadKind.Unknown;
        if (index < self.PayloadKinds.Length)
        {
            kind = self.PayloadKinds[index];
        }

        return kind;
    }

    public law TypedEnumVariantRole VariantRoleAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedEnumVariantRole role = TypedEnumVariantRole.None;
        if (index < self.VariantRoles.Length)
        {
            role = self.VariantRoles[index];
        }

        return role;
    }

    public law bool IsErrorFunnelAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut bool value = false;
        if (index < self.ErrorFunnels.Length)
        {
            value = self.ErrorFunnels[index];
        }

        return value;
    }

    public law u32[0 max] StartTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.StartTokens.Length)
        {
            token = self.StartTokens[index];
        }

        return token;
    }

    public law u32[0 max] EndTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.EndTokens.Length)
        {
            token = self.EndTokens[index];
        }

        return token;
    }

    public law TypedSignatureTypeKind TypeKindAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedSignatureTypeKind kind = TypedSignatureTypeKind.Unknown;
        if (index < self.TypeKinds.Length)
        {
            kind = self.TypeKinds[index];
        }

        return kind;
    }

    public law u32[0 max] TypeHeadTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeHeadTokens.Length)
        {
            token = self.TypeHeadTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypePrimaryTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypePrimaryTokens.Length)
        {
            token = self.TypePrimaryTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeStartTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeStartTokens.Length)
        {
            token = self.TypeStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] TypeEndTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeEndTokens.Length)
        {
            token = self.TypeEndTokens[index];
        }

        return token;
    }

    public law u32[0 max] RangeStartTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.RangeStartTokens.Length)
        {
            token = self.RangeStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] RangeEndTokenAt(borrow TypedEnumPayloadTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.RangeEndTokens.Length)
        {
            token = self.RangeEndTokens[index];
        }

