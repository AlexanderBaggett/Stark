import Compiler.Typing.TypedMemberFacts
import Compiler.Typing.TypedSignatures
import System.Memory
module Compiler.Typing.TypedIndexModel

public enum TypedIndexContext
{
    GlobalInitializer,
    FunctionBody,
    Unknown,
}

public enum TypedIndexOperationKind
{
    Index,
    Slice,
    Unknown,
}

public enum TypedIndexAccessKind
{
    Element,
    Slice,
    TextElement,
    TextSlice,
    DynamicElement,
    DynamicSlice,
    RawPointerElement,
    RawPointerRegion,
    Unknown,
}

public enum TypedIndexReceiverKind
{
    FixedArray,
    Slice,
    Dynamic,
    RawPointer,
    Text,
    Unknown,
}

internal inline finite law u32[0 max] TypedIndexFlagReceiverResolved()
{
    return 1;
}

internal inline finite law u32[0 max] TypedIndexFlagResultResolved()
{
    return 2;
}

internal inline finite law u32[0 max] TypedIndexFlagSlice()
{
    return 4;
}

internal inline finite law u32[0 max] TypedIndexFlagText()
{
    return 8;
}

internal inline finite law u32[0 max] TypedIndexFlagRawPointer()
{
    return 16;
}

internal inline finite law bool TypedIndexFlagPresent(u32[0 max] flags, u32[0 max] flag)
{
    return (flags & flag) != 0;
}

public struct TypedIndexExpressionTable
{
    internal dynamic TypedIndexContext Contexts;
    internal dynamic u32[0 max] OwnerDeclarationIndices;
    internal dynamic u32[0 max] OwnerNameTokens;
    internal dynamic u32[0 max] FunctionNameTokens;
    internal dynamic u32[0 max] StatementIndices;
    internal dynamic u32[0 max] IndexNodes;
    internal dynamic u32[0 max] ReceiverNodes;
    internal dynamic u32[0 max] IndexTokens;
    internal dynamic u32[0 max] StartNodes;
    internal dynamic u32[0 max] LengthNodes;
    internal dynamic TypedIndexOperationKind OperationKinds;
    internal dynamic TypedIndexAccessKind AccessKinds;
    internal dynamic TypedIndexReceiverKind ReceiverKinds;
    internal dynamic u32[0 max] ReceiverDeclarationIndices;
    internal dynamic u32[0 max] ReceiverNameTokens;
    internal dynamic TypedSignatureTypeKind ReceiverTypeKinds;
    internal dynamic u32[0 max] ReceiverTypeHeadTokens;
    internal dynamic u32[0 max] ReceiverTypePrimaryTokens;
    internal dynamic u32[0 max] ReceiverTypeStartTokens;
    internal dynamic u32[0 max] ReceiverTypeEndTokens;
    internal dynamic u32[0 max] ReceiverRangeStartTokens;
    internal dynamic u32[0 max] ReceiverRangeEndTokens;
    internal dynamic u32[0 max] ReceiverElementCountStartTokens;
    internal dynamic u32[0 max] ReceiverElementCountEndTokens;
    internal dynamic u32[0 max] ReceiverBitWidths;
    internal dynamic u32[0 max] ReceiverTypeArgumentCounts;
    internal dynamic u32[0 max] ReceiverComptimeArgumentCounts;
    internal dynamic u32[0 max] ReceiverTypeFlags;
    internal dynamic TypedSignatureTypeKind TypeKinds;
    internal dynamic u32[0 max] TypeHeadTokens;
    internal dynamic u32[0 max] TypePrimaryTokens;
    internal dynamic u32[0 max] TypeStartTokens;
    internal dynamic u32[0 max] TypeEndTokens;
    internal dynamic u32[0 max] RangeStartTokens;
    internal dynamic u32[0 max] RangeEndTokens;
    internal dynamic u32[0 max] ElementCountStartTokens;
    internal dynamic u32[0 max] ElementCountEndTokens;
    internal dynamic u32[0 max] BitWidths;
    internal dynamic u32[0 max] TypeArgumentCounts;
    internal dynamic u32[0 max] ComptimeArgumentCounts;
    internal dynamic u32[0 max] TypeFlags;
    internal dynamic u32[0 max] IndexFlags;

    TypedIndexExpressionTable()
    {
        self.Contexts = new();
        self.OwnerDeclarationIndices = new();
        self.OwnerNameTokens = new();
        self.FunctionNameTokens = new();
        self.StatementIndices = new();
        self.IndexNodes = new();
        self.ReceiverNodes = new();
        self.IndexTokens = new();
        self.StartNodes = new();
        self.LengthNodes = new();
        self.OperationKinds = new();
        self.AccessKinds = new();
        self.ReceiverKinds = new();
        self.ReceiverDeclarationIndices = new();
        self.ReceiverNameTokens = new();
        self.ReceiverTypeKinds = new();
        self.ReceiverTypeHeadTokens = new();
        self.ReceiverTypePrimaryTokens = new();
        self.ReceiverTypeStartTokens = new();
        self.ReceiverTypeEndTokens = new();
        self.ReceiverRangeStartTokens = new();
        self.ReceiverRangeEndTokens = new();
        self.ReceiverElementCountStartTokens = new();
        self.ReceiverElementCountEndTokens = new();
        self.ReceiverBitWidths = new();
        self.ReceiverTypeArgumentCounts = new();
        self.ReceiverComptimeArgumentCounts = new();
        self.ReceiverTypeFlags = new();
        self.TypeKinds = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
        self.TypeStartTokens = new();
        self.TypeEndTokens = new();
        self.RangeStartTokens = new();
        self.RangeEndTokens = new();
        self.ElementCountStartTokens = new();
        self.ElementCountEndTokens = new();
        self.BitWidths = new();
        self.TypeArgumentCounts = new();
        self.ComptimeArgumentCounts = new();
        self.TypeFlags = new();
        self.IndexFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypedIndexExpressionTable self)
    {
        return self.IndexNodes.Length;
    }

    public law TypedIndexContext ContextAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut TypedIndexContext context = TypedIndexContext.Unknown;
        if (index < self.Contexts.Length)
        {
            context = self.Contexts[index];
        }

        return context;
    }

    public law u32[0 max] OwnerDeclarationIndexAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.OwnerDeclarationIndices.Length)
        {
            value = self.OwnerDeclarationIndices[index];
        }

        return value;
