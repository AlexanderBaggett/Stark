        {
            flags = self.IndexFlags[index];
        }

        return flags;
    }

    public law bool ReceiverResolvedAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedIndexFlagPresent(self.IndexFlagsAt(index), TypedIndexFlagReceiverResolved());
    }

    public law bool ResultResolvedAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedIndexFlagPresent(self.IndexFlagsAt(index), TypedIndexFlagResultResolved());
    }

    public law bool IsSliceAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedIndexFlagPresent(self.IndexFlagsAt(index), TypedIndexFlagSlice());
    }

    public law bool IsIntegerSignedAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerSigned());
    }

    public law bool IsIntegerUnsignedAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagIntegerUnsigned());
    }

    public law bool HasIntegerRangeAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.TypeFlagsAt(index), TypedSignatureTypeFlagHasIntegerRange());
    }

    public law bool IsRawMutablePointerReceiverAt(borrow TypedIndexExpressionTable self, u64[0 2 ** 63 - 1] index)
    {
        return TypedSignatureFlagPresent(self.ReceiverTypeFlagsAt(index), TypedSignatureTypeFlagRawMutablePointer());
    }

    internal fn System.Memory.MemoryStatus AppendIndex(
        mut borrow TypedIndexExpressionTable self,
        TypedIndexContext context,
        u32[0 max] ownerDeclarationIndex,
        u32[0 max] ownerNameToken,
        u32[0 max] functionNameToken,
        u32[0 max] statementIndexPlusOne,
        u32[0 max] indexNode,
        u32[0 max] receiverNode,
        u32[0 max] indexToken,
        u32[0 max] startNode,
        u32[0 max] lengthNode,
        TypedIndexOperationKind operationKind,
        TypedIndexAccessKind accessKind,
        TypedIndexReceiverKind receiverKind,
        u32[0 max] receiverDeclarationIndex,
        u32[0 max] receiverNameToken,
        TypedSignatureTypeKind receiverTypeKind,
        u32[0 max] receiverTypeHeadToken,
        u32[0 max] receiverTypePrimaryToken,
        u32[0 max] receiverTypeStartToken,
        u32[0 max] receiverTypeEndToken,
        u32[0 max] receiverRangeStartToken,
        u32[0 max] receiverRangeEndToken,
        u32[0 max] receiverElementCountStartToken,
        u32[0 max] receiverElementCountEndToken,
        u32[0 max] receiverBitWidth,
        u32[0 max] receiverTypeArgumentCount,
        u32[0 max] receiverComptimeArgumentCount,
        u32[0 max] receiverTypeFlags,
        TypedSignatureTypeKind typeKind,
        u32[0 max] typeHeadToken,
        u32[0 max] typePrimaryToken,
        u32[0 max] typeStartToken,
        u32[0 max] typeEndToken,
        u32[0 max] rangeStartToken,
        u32[0 max] rangeEndToken,
        u32[0 max] elementCountStartToken,
        u32[0 max] elementCountEndToken,
        u32[0 max] bitWidth,
        u32[0 max] typeArgumentCount,
        u32[0 max] comptimeArgumentCount,
        u32[0 max] typeFlags,
        u32[0 max] indexFlags)
    {
        if (!self.Contexts.TryReserve(1)
            || !self.OwnerDeclarationIndices.TryReserve(1)
            || !self.OwnerNameTokens.TryReserve(1)
            || !self.FunctionNameTokens.TryReserve(1)
            || !self.StatementIndices.TryReserve(1)
            || !self.IndexNodes.TryReserve(1)
            || !self.ReceiverNodes.TryReserve(1)
            || !self.IndexTokens.TryReserve(1)
            || !self.StartNodes.TryReserve(1)
            || !self.LengthNodes.TryReserve(1)
            || !self.OperationKinds.TryReserve(1)
            || !self.AccessKinds.TryReserve(1)
            || !self.ReceiverKinds.TryReserve(1)
            || !self.ReceiverDeclarationIndices.TryReserve(1)
            || !self.ReceiverNameTokens.TryReserve(1)
            || !self.ReceiverTypeKinds.TryReserve(1)
            || !self.ReceiverTypeHeadTokens.TryReserve(1)
            || !self.ReceiverTypePrimaryTokens.TryReserve(1)
            || !self.ReceiverTypeStartTokens.TryReserve(1)
            || !self.ReceiverTypeEndTokens.TryReserve(1)
            || !self.ReceiverRangeStartTokens.TryReserve(1)
            || !self.ReceiverRangeEndTokens.TryReserve(1)
            || !self.ReceiverElementCountStartTokens.TryReserve(1)
            || !self.ReceiverElementCountEndTokens.TryReserve(1)
            || !self.ReceiverBitWidths.TryReserve(1)
            || !self.ReceiverTypeArgumentCounts.TryReserve(1)
            || !self.ReceiverComptimeArgumentCounts.TryReserve(1)
            || !self.ReceiverTypeFlags.TryReserve(1)
            || !self.TypeKinds.TryReserve(1)
            || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1)
            || !self.TypeStartTokens.TryReserve(1)
            || !self.TypeEndTokens.TryReserve(1)
            || !self.RangeStartTokens.TryReserve(1)
            || !self.RangeEndTokens.TryReserve(1)
            || !self.ElementCountStartTokens.TryReserve(1)
            || !self.ElementCountEndTokens.TryReserve(1)
            || !self.BitWidths.TryReserve(1)
            || !self.TypeArgumentCounts.TryReserve(1)
            || !self.ComptimeArgumentCounts.TryReserve(1)
            || !self.TypeFlags.TryReserve(1)
            || !self.IndexFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Contexts[self.Contexts.Length] = context;
        init self.OwnerDeclarationIndices[self.OwnerDeclarationIndices.Length] = ownerDeclarationIndex;
        init self.OwnerNameTokens[self.OwnerNameTokens.Length] = ownerNameToken;
        init self.FunctionNameTokens[self.FunctionNameTokens.Length] = functionNameToken;
        init self.StatementIndices[self.StatementIndices.Length] = statementIndexPlusOne;
        init self.IndexNodes[self.IndexNodes.Length] = indexNode;
        init self.ReceiverNodes[self.ReceiverNodes.Length] = receiverNode;
        init self.IndexTokens[self.IndexTokens.Length] = indexToken;
        init self.StartNodes[self.StartNodes.Length] = startNode;
        init self.LengthNodes[self.LengthNodes.Length] = lengthNode;
        init self.OperationKinds[self.OperationKinds.Length] = operationKind;
        init self.AccessKinds[self.AccessKinds.Length] = accessKind;
        init self.ReceiverKinds[self.ReceiverKinds.Length] = receiverKind;
        init self.ReceiverDeclarationIndices[self.ReceiverDeclarationIndices.Length] = receiverDeclarationIndex;
        init self.ReceiverNameTokens[self.ReceiverNameTokens.Length] = receiverNameToken;
        init self.ReceiverTypeKinds[self.ReceiverTypeKinds.Length] = receiverTypeKind;
        init self.ReceiverTypeHeadTokens[self.ReceiverTypeHeadTokens.Length] = receiverTypeHeadToken;
        init self.ReceiverTypePrimaryTokens[self.ReceiverTypePrimaryTokens.Length] = receiverTypePrimaryToken;
        init self.ReceiverTypeStartTokens[self.ReceiverTypeStartTokens.Length] = receiverTypeStartToken;
        init self.ReceiverTypeEndTokens[self.ReceiverTypeEndTokens.Length] = receiverTypeEndToken;
        init self.ReceiverRangeStartTokens[self.ReceiverRangeStartTokens.Length] = receiverRangeStartToken;
        init self.ReceiverRangeEndTokens[self.ReceiverRangeEndTokens.Length] = receiverRangeEndToken;
        init self.ReceiverElementCountStartTokens[self.ReceiverElementCountStartTokens.Length] = receiverElementCountStartToken;
        init self.ReceiverElementCountEndTokens[self.ReceiverElementCountEndTokens.Length] = receiverElementCountEndToken;
        init self.ReceiverBitWidths[self.ReceiverBitWidths.Length] = receiverBitWidth;
        init self.ReceiverTypeArgumentCounts[self.ReceiverTypeArgumentCounts.Length] = receiverTypeArgumentCount;
        init self.ReceiverComptimeArgumentCounts[self.ReceiverComptimeArgumentCounts.Length] = receiverComptimeArgumentCount;
        init self.ReceiverTypeFlags[self.ReceiverTypeFlags.Length] = receiverTypeFlags;
        init self.TypeKinds[self.TypeKinds.Length] = typeKind;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        init self.TypeStartTokens[self.TypeStartTokens.Length] = typeStartToken;
        init self.TypeEndTokens[self.TypeEndTokens.Length] = typeEndToken;
        init self.RangeStartTokens[self.RangeStartTokens.Length] = rangeStartToken;
        init self.RangeEndTokens[self.RangeEndTokens.Length] = rangeEndToken;
        init self.ElementCountStartTokens[self.ElementCountStartTokens.Length] = elementCountStartToken;
        init self.ElementCountEndTokens[self.ElementCountEndTokens.Length] = elementCountEndToken;
        init self.BitWidths[self.BitWidths.Length] = bitWidth;
        init self.TypeArgumentCounts[self.TypeArgumentCounts.Length] = typeArgumentCount;
        init self.ComptimeArgumentCounts[self.ComptimeArgumentCounts.Length] = comptimeArgumentCount;
        init self.TypeFlags[self.TypeFlags.Length] = typeFlags;
        init self.IndexFlags[self.IndexFlags.Length] = indexFlags;
        return System.Memory.MemoryStatus.Ok;
    }
}
