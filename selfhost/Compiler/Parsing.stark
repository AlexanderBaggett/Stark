import Compiler.Lexing
import System.Memory
module Compiler.Parsing

// Stage 1 self-hosted parser. This first slice recognizes the compilation-unit
// header — the leading `import` declarations and the optional `module`
// declaration — and stops at the first token of the declaration list. It
// consumes the `Compiler.Lexing.TokenStream` by index; the grammar followed is
// `compilationUnit : importDeclaration* moduleDeclaration? declaration*` from
// Stark.g4. Later slices grow the declaration and statement grammar.
//
// Token indices are `u32` (a deliberate cap, like rustc/Roslyn token/node ids).
// Header items are stored in parallel `dynamic` columns — the same arena-style
// storage `Compiler.Lexing.TokenStream` and `System.Toml` use — rather than
// `List<T>`: a `List<T>` field's generic `mut drop` fails to resolve
// `List<...>.Clear` when a consumer package drops the owning value, whereas a
// `dynamic` field's intrinsic drop resolves everywhere (see ROADMAP.md
// "Compiler Bugs Found During Self-Host Work").

public enum SyntaxKind
{
    ImportDeclaration,
    ModuleDeclaration,
}

const HeaderKindImport = 0;
const HeaderKindModule = 1;

// A parsed header item, reconstructed on access. The dotted name occupies
// tokens `[NameStart, NameStart + NameTokenCount)` (identifier segments
// interleaved with `.`); callers recover the text through
// `Compiler.Lexing.TokenTextOf`. `KeywordToken` is the `import`/`module` token
// index, and `NameSegments` counts the dotted identifier segments.
public struct HeaderItem
{
    SyntaxKind Kind;
    u32[0 max] KeywordToken;
    u32[0 max] NameStart;
    u32[0 max] NameTokenCount;
    u32[0 max] NameSegments;

    HeaderItem()
    {
        self.Kind = SyntaxKind.ImportDeclaration;
        self.KeywordToken = 0;
        self.NameStart = 0;
        self.NameTokenCount = 0;
        self.NameSegments = 0;
    }
}

public enum ParseError
{
    OutOfMemory,
    // A header keyword was not followed by a dotted name; `Token` is the index
    // where an identifier was expected.
    ExpectedName
    {
        Token: u32[0 max]
    },
}

public enum ParseResult<T>
{
    [Ok] Ok(T),
    [Err] Err(ParseError),
}

// The parsed header plus the token index where the declaration list begins.
public struct CompilationUnitHeader
{
    internal dynamic u32[0 max] Kinds;
    internal dynamic u32[0 max] KeywordTokens;
    internal dynamic u32[0 max] NameStarts;
    internal dynamic u32[0 max] NameTokenCounts;
    internal dynamic u32[0 max] NameSegmentCounts;
    u32[0 max] NextToken;

    CompilationUnitHeader()
    {
        self.Kinds = new();
        self.KeywordTokens = new();
        self.NameStarts = new();
        self.NameTokenCounts = new();
        self.NameSegmentCounts = new();
        self.NextToken = 0;
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow CompilationUnitHeader self)
    {
        return self.Kinds.Length;
    }

    // The header item at `index`, or a default `HeaderItem` when out of range.
    public law HeaderItem ItemAt(borrow CompilationUnitHeader self, u64[0 2 ** 63 - 1] index)
    {
        stack mut HeaderItem item = new();
        if (index < self.Kinds.Length)
        {
            stack u32[0 max] kindCode = self.Kinds[index];
            if (kindCode == HeaderKindModule)
            {
                item.Kind = SyntaxKind.ModuleDeclaration;
            }
            else
            {
                item.Kind = SyntaxKind.ImportDeclaration;
            }

            if (index < self.KeywordTokens.Length)
            {
                item.KeywordToken = self.KeywordTokens[index];
            }

            if (index < self.NameStarts.Length)
            {
                item.NameStart = self.NameStarts[index];
            }

            if (index < self.NameTokenCounts.Length)
            {
                item.NameTokenCount = self.NameTokenCounts[index];
            }

            if (index < self.NameSegmentCounts.Length)
            {
                item.NameSegments = self.NameSegmentCounts[index];
            }
        }

        return item;
    }

    // Appends one parsed item across the parallel columns. Reserves every column
    // before initializing any slot so a mid-append allocation failure cannot
    // desynchronize the columns.
    internal fn System.Memory.MemoryStatus Append(mut borrow CompilationUnitHeader self, u32[0 max] kindCode, HeaderItem item)
    {
        if (!self.Kinds.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.NameStarts.TryReserve(1)
            || !self.NameTokenCounts.TryReserve(1)
            || !self.NameSegmentCounts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Kinds[self.Kinds.Length] = kindCode;
        init self.KeywordTokens[self.KeywordTokens.Length] = item.KeywordToken;
        init self.NameStarts[self.NameStarts.Length] = item.NameStart;
        init self.NameTokenCounts[self.NameTokenCounts.Length] = item.NameTokenCount;
        init self.NameSegmentCounts[self.NameSegmentCounts.Length] = item.NameSegments;
        return System.Memory.MemoryStatus.Ok;
    }
}

// Fills the dotted-name fields of `item` from the tokens at `start`:
// `Identifier ('.' Identifier)*`. Returns false when `start` is not an
// identifier (a malformed header).
fn bool ParseDottedName(borrow TokenStream stream, u32[0 max] start, mut borrow HeaderItem item)
{
    if (stream.KindAt((u64[0 2 ** 63 - 1])start) != TokenKind.Identifier)
    {
        return false;
    }

    stack mut u32[0 max] index = (u32[0 max])(start + 1);
    stack mut u32[0 max] segments = 1;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) == TokenKind.Dot
        && stream.KindAt((u64[0 2 ** 63 - 1])(index + 1)) == TokenKind.Identifier)
    {
        index = (u32[0 max])(index + 2);
        segments = (u32[0 max])(segments + 1);
    }

    item.NameStart = start;
    item.NameTokenCount = (u32[0 max])(index - start);
    item.NameSegments = segments;
    return true;
}

// Parses `importDeclaration* moduleDeclaration?` from the front of `stream`,
// returning the header items and the token index where declarations begin.
public fn ParseResult<CompilationUnitHeader> ParseHeader(borrow TokenStream stream)
{
    stack mut CompilationUnitHeader header = new();
    stack mut u32[0 max] index = 0;

    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) == TokenKind.Import)
    {
        stack mut HeaderItem item = new();
        item.Kind = SyntaxKind.ImportDeclaration;
        item.KeywordToken = index;
        if (!ParseDottedName(stream, (u32[0 max])(index + 1), item))
        {
            return ParseResult<CompilationUnitHeader>.Err(ParseError.ExpectedName
            {
                Token: (u32[0 max])(index + 1)
            });
        }

        index = (u32[0 max])(item.NameStart + item.NameTokenCount);
        switch (header.Append(HeaderKindImport, item))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return ParseResult<CompilationUnitHeader>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])index) == TokenKind.Module)
    {
        stack mut HeaderItem moduleItem = new();
        moduleItem.Kind = SyntaxKind.ModuleDeclaration;
        moduleItem.KeywordToken = index;
        if (!ParseDottedName(stream, (u32[0 max])(index + 1), moduleItem))
        {
            return ParseResult<CompilationUnitHeader>.Err(ParseError.ExpectedName
            {
                Token: (u32[0 max])(index + 1)
            });
        }

        index = (u32[0 max])(moduleItem.NameStart + moduleItem.NameTokenCount);
        switch (header.Append(HeaderKindModule, moduleItem))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return ParseResult<CompilationUnitHeader>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    header.NextToken = index;
    return ParseResult<CompilationUnitHeader>.Ok(header);
}

// The kind of a top-level declaration, by its leading keyword.
public enum DeclarationKind
{
    Struct,
    Enum,
    Record,
    Trait,
    Doctrine,
    Alias,
    Function,
    Const,
    Static,
    // A storage-class-led module global: `heap`/`stack`/`register`/`arena`
    // `MUT? type_ name = init;`. (`static` keeps its own kind above for back
    // compatibility — it is the pre-existing static-global classification.)
    GlobalVariable,
    Unknown,
}

// A top-level declaration outline: its kind, the keyword token, the first token
// (including any leading modifiers), and the last token of its body (the
// matching `}`, the terminating `;`, or end-of-file when unterminated). The body
// interior is left unparsed by this slice.
public struct DeclItem
{
    DeclarationKind Kind;
    u32[0 max] KeywordToken;
    // The declaration's name token: the identifier after the keyword for
    // type/const/static declarations, or the identifier before the parameter
    // `(` for functions. 0 when no name was found.
    u32[0 max] NameToken;
    u32[0 max] StartToken;
    u32[0 max] EndToken;
    bool IsTailCallable;

    DeclItem()
    {
        self.Kind = DeclarationKind.Unknown;
        self.KeywordToken = 0;
        self.NameToken = 0;
        self.StartToken = 0;
        self.EndToken = 0;
        self.IsTailCallable = false;
    }
}

public struct DeclarationList
{
    internal dynamic DeclarationKind Kinds;
    internal dynamic u32[0 max] KeywordTokens;
    internal dynamic u32[0 max] NameTokens;
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] EndTokens;
    internal dynamic u32[0 max] TailCallableFlags;

    DeclarationList()
    {
        self.Kinds = new();
        self.KeywordTokens = new();
        self.NameTokens = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.TailCallableFlags = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow DeclarationList self)
    {
        return self.Kinds.Length;
    }

    public law DeclItem ItemAt(borrow DeclarationList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut DeclItem item = new();
        if (index < self.Kinds.Length)
        {
            item.Kind = self.Kinds[index];
            if (index < self.KeywordTokens.Length)
            {
                item.KeywordToken = self.KeywordTokens[index];
            }

            if (index < self.NameTokens.Length)
            {
                item.NameToken = self.NameTokens[index];
            }

            if (index < self.StartTokens.Length)
            {
                item.StartToken = self.StartTokens[index];
            }

            if (index < self.EndTokens.Length)
            {
                item.EndToken = self.EndTokens[index];
            }

            if (index < self.TailCallableFlags.Length)
            {
                item.IsTailCallable = self.TailCallableFlags[index] != 0;
            }
        }

        return item;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow DeclarationList self, DeclItem item)
    {
        if (!self.Kinds.TryReserve(1)
            || !self.KeywordTokens.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.TailCallableFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        stack mut u32[0 max] tailFlag = 0;
        if (item.IsTailCallable)
        {
            tailFlag = 1;
        }

        init self.Kinds[self.Kinds.Length] = item.Kind;
        init self.KeywordTokens[self.KeywordTokens.Length] = item.KeywordToken;
        init self.NameTokens[self.NameTokens.Length] = item.NameToken;
        init self.StartTokens[self.StartTokens.Length] = item.StartToken;
        init self.EndTokens[self.EndTokens.Length] = item.EndToken;
        init self.TailCallableFlags[self.TailCallableFlags.Length] = tailFlag;
        return System.Memory.MemoryStatus.Ok;
    }
}

// The type-primary token of a `storageClass MUT? type_ name = init;` variable,
// scanning from `start` (the token after the storage-class/`const` keyword): the
// first type-starting token (built-in type or user-type identifier) at angle/
// bracket depth 0 before the `=` or `;`. Returns 0 when none is present.
finite law u32[0 max] FindVariableTypeToken(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] typeToken = 0;
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind tokenKind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (tokenKind == TokenKind.EndOfFile)
        {
            break;
        }

        if (depth == 0 && (tokenKind == TokenKind.Assign || tokenKind == TokenKind.Semi))
        {
            break;
        }

        if (tokenKind == TokenKind.Lt || tokenKind == TokenKind.LBrack)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (tokenKind == TokenKind.Gt || tokenKind == TokenKind.RBrack)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && typeToken == 0 && IsTypeStartToken(tokenKind))
        {
            typeToken = index;
        }

        index = (u32[0 max])(index + 1);
    }

    return typeToken;
}

// The declared name token of a `storageClass MUT? type_ name = init;` variable
// (a module global or a function-body local), scanning from `start` (the token
// after the storage-class/`const` keyword): the last identifier at angle/bracket
// depth 0 before the `=` or `;`, so the type — which may itself be generic, e.g.
// `List<u32>` — is skipped. Returns 0 when no name is present.
finite law u32[0 max] FindVariableName(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] nameToken = 0;
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind tokenKind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (tokenKind == TokenKind.EndOfFile)
        {
            break;
        }

        if (depth == 0 && (tokenKind == TokenKind.Assign || tokenKind == TokenKind.Semi))
        {
            break;
        }

        if (tokenKind == TokenKind.Lt || tokenKind == TokenKind.LBrack)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (tokenKind == TokenKind.Gt || tokenKind == TokenKind.RBrack)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (tokenKind == TokenKind.Identifier && depth == 0)
        {
            nameToken = index;
        }

        index = (u32[0 max])(index + 1);
    }

    return nameToken;
}

// Finds the name token of a declaration whose keyword/kind keyword is at
// `keyword`: for a function, the identifier immediately before the parameter
// list's `(`; for a storage-class global, the identifier after its type, just
// before the initializer `=` or `;`; for any other declaration, the identifier
// immediately after the keyword. Returns 0 when no name is present.
finite law u32[0 max] FindDeclarationName(borrow TokenStream stream, DeclarationKind kind, u32[0 max] keyword)
{
    stack mut u32[0 max] nameToken = 0;
    if (kind == DeclarationKind.GlobalVariable || kind == DeclarationKind.Static)
    {
        nameToken = FindVariableName(stream, (u32[0 max])(keyword + 1));
    }
    else if (kind == DeclarationKind.Function)
    {
        // The name is the last identifier at angle/bracket depth 0 before the
        // parameter list's `(` — so generic arguments in the return type
        // (`List<u32>`) and the function's own type parameters (`f<T>`), which
        // sit at depth > 0, are skipped rather than mistaken for the name.
        stack mut u32[0 max] index = (u32[0 max])(keyword + 1);
        stack mut u32[0 max] depth = 0;
        stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
        while willexit (guard > 0)
        {
            guard = (u64[0 2 ** 63 - 1])(guard - 1);
            stack TokenKind tokenKind = stream.KindAt((u64[0 2 ** 63 - 1])index);
            if (tokenKind == TokenKind.EndOfFile)
            {
                break;
            }

            if (tokenKind == TokenKind.LParen && depth == 0)
            {
                break;
            }

            if (tokenKind == TokenKind.Lt || tokenKind == TokenKind.LBrack || tokenKind == TokenKind.LParen)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (tokenKind == TokenKind.Gt || tokenKind == TokenKind.RBrack || tokenKind == TokenKind.RParen)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (tokenKind == TokenKind.Identifier && depth == 0)
            {
                nameToken = index;
            }

            index = (u32[0 max])(index + 1);
        }
    }
    else if (stream.KindAt((u64[0 2 ** 63 - 1])(keyword + 1)) == TokenKind.Identifier)
    {
        nameToken = (u32[0 max])(keyword + 1);
    }

    return nameToken;
}

finite law bool IsContextualTailToken(borrow TokenStream stream, u32[0 max] token)
{
    return stream.ContextualKindAt((u64[0 2 ** 63 - 1])token) == ContextualKeywordKind.Tail;
}

finite law bool IsContextualDeadOnReturnToken(borrow TokenStream stream, u32[0 max] token)
{
    return stream.ContextualKindAt((u64[0 2 ** 63 - 1])token) == ContextualKeywordKind.DeadOnReturn;
}

// True for a keyword that can lead a declaration before its kind keyword
// (visibility plus function modifiers), excluding contextual `tail` which is
// recognized by token position rather than by `TokenKind`.
finite law bool IsDeclarationModifierKind(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Internal:
            return true;
        case TokenKind.Public:
            return true;
        case TokenKind.Export:
            return true;
        case TokenKind.Finite:
            return true;
        case TokenKind.Law:
            return true;
        case TokenKind.Inline:
            return true;
        case TokenKind.Noinline:
            return true;
        case TokenKind.Inlinehint:
            return true;
        case TokenKind.Hot:
            return true;
        case TokenKind.Cold:
            return true;
        case TokenKind.Ffi:
            return true;
        case TokenKind.Varargs:
            return true;
        case TokenKind.Unsafe:
            return true;
        case TokenKind.Strictfp:
            return true;
        default:
            return false;
    }
}

finite law bool IsDeclarationModifierAt(borrow TokenStream stream, u32[0 max] token)
{
    if (IsContextualTailToken(stream, token))
    {
        return true;
    }

    return IsDeclarationModifierKind(stream.KindAt((u64[0 2 ** 63 - 1])token));
}

finite law u32[0 max] MatchingCloseParenAfter(borrow TokenStream stream, u32[0 max] openParen)
{
    if (stream.KindAt((u64[0 2 ** 63 - 1])openParen) != TokenKind.LParen)
    {
        return openParen;
    }

    stack mut u32[0 max] cursor = openParen;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
        if (kind == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            if (depth == 0)
            {
                return cursor;
            }
        }
        else if (kind == TokenKind.EndOfFile)
        {
            return openParen;
        }

        cursor = (u32[0 max])(cursor + 1);
    }

    return openParen;
}

finite law u32[0 max] SkipDeclarationModifierAt(borrow TokenStream stream, u32[0 max] token)
{
    if (IsContextualTailToken(stream, token))
    {
        return token + 1;
    }

    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])token);
    if ((kind == TokenKind.Ffi || kind == TokenKind.Asm)
        && stream.KindAt((u64[0 2 ** 63 - 1])(token + 1)) == TokenKind.LParen)
    {
        stack u32[0 max] close = MatchingCloseParenAfter(stream, (u32[0 max])(token + 1));
        if (close > token + 1)
        {
            return close + 1;
        }
    }

    if (IsDeclarationModifierKind(kind))
    {
        return token + 1;
    }

    return token;
}

finite law bool ModifierSpanHasTail(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (IsContextualTailToken(stream, scan))
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

// Maps a declaration keyword to its `DeclarationKind`, or `Unknown`.
finite law DeclarationKind ClassifyDeclarationKind(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Struct:
            return DeclarationKind.Struct;
        case TokenKind.Enum:
            return DeclarationKind.Enum;
        case TokenKind.Record:
            return DeclarationKind.Record;
        case TokenKind.Trait:
            return DeclarationKind.Trait;
        case TokenKind.Doctrine:
            return DeclarationKind.Doctrine;
        case TokenKind.Alias:
            return DeclarationKind.Alias;
        case TokenKind.Fn:
            return DeclarationKind.Function;
        case TokenKind.Const:
            return DeclarationKind.Const;
        case TokenKind.Static:
            return DeclarationKind.Static;
        case TokenKind.Heap:
            return DeclarationKind.GlobalVariable;
        case TokenKind.Stack:
            return DeclarationKind.GlobalVariable;
        case TokenKind.Register:
            return DeclarationKind.GlobalVariable;
        case TokenKind.Arena:
            return DeclarationKind.GlobalVariable;
        default:
            return DeclarationKind.Unknown;
    }
}

// Returns the last token of the declaration starting at `start`: the `}` that
// matches the body's first `{` (brace-counted over tokens, so braces inside
// string/char literals never interfere), the terminating `;` for a brace-less
// declaration, or the end-of-file token when unterminated.
finite law u32[0 max] SkipDeclarationBody(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    stack mut bool sawBrace = false;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
            sawBrace = true;
        }
        else if (kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            if (depth == 0 && sawBrace)
            {
                return index;
            }
        }
        else if (kind == TokenKind.Semi && depth == 0 && !sawBrace)
        {
            return index;
        }

        index = (u32[0 max])(index + 1);
    }

    return index;
}

// Parses the top-level declaration list beginning at token `start` (the
// `CompilationUnitHeader.NextToken`). Each declaration is recognized by its kind
// keyword (after skipping leading modifiers) and its body span; the body
// interior is not yet parsed. Stops at the first token that does not open a
// declaration (e.g. end-of-file).
public fn ParseResult<DeclarationList> ParseDeclarations(borrow TokenStream stream, u32[0 max] start)
{
    stack mut DeclarationList list = new();
    stack mut u32[0 max] index = start;

    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        stack mut u32[0 max] cursor = index;
        while willexit (true)
        {
            stack u32[0 max] next = SkipDeclarationModifierAt(stream, cursor);
            if (next == cursor)
            {
                break;
            }

            cursor = next;
        }

        stack DeclarationKind kind = ClassifyDeclarationKind(stream.KindAt((u64[0 2 ** 63 - 1])cursor));
        if (kind == DeclarationKind.Unknown)
        {
            break;
        }

        stack u32[0 max] endToken = SkipDeclarationBody(stream, cursor);
        stack mut DeclItem item = new();
        item.Kind = kind;
        item.KeywordToken = cursor;
        item.NameToken = FindDeclarationName(stream, kind, cursor);
        item.StartToken = index;
        item.EndToken = endToken;
        item.IsTailCallable = kind == DeclarationKind.Function && ModifierSpanHasTail(stream, index, cursor);
        switch (list.Append(item))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return ParseResult<DeclarationList>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        index = (u32[0 max])(endToken + 1);
    }

    return ParseResult<DeclarationList>.Ok(list);
}

// The variant name tokens of an enum body, in source order.
public struct VariantList
{
    internal dynamic u32[0 max] NameTokens;

    VariantList()
    {
        self.NameTokens = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow VariantList self)
    {
        return self.NameTokens.Length;
    }

    // The token index of variant `index`'s name, or 0 when out of range.
    public law u32[0 max] NameTokenAt(borrow VariantList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow VariantList self, u32[0 max] nameToken)
    {
        if (!self.NameTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        return System.Memory.MemoryStatus.Ok;
    }
}

// Parses the variant names of the enum whose keyword is at `enumKeyword`. Each
// variant is the first identifier at bracket-depth 0 after the opening `{` or a
// `,`; tuple `(...)`, struct `{...}`, and `from Type` payloads are skipped by
// bracket counting. Returns an empty list when the enum has no body.
public fn ParseResult<VariantList> ParseEnumVariants(borrow TokenStream stream, u32[0 max] enumKeyword)
{
    stack mut VariantList variants = new();
    stack mut u32[0 max] index = enumKeyword;

    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile
        && stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        index = (u32[0 max])(index + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        return ParseResult<VariantList>.Ok(variants);
    }

    index = (u32[0 max])(index + 1);
    stack mut u32[0 max] depth = 0;
    stack mut bool expectName = true;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.RBrace && depth == 0)
        {
            break;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace
            || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace
            || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.Comma && depth == 0)
        {
            expectName = true;
        }
        else if (expectName && depth == 0 && kind == TokenKind.Identifier)
        {
            switch (variants.Append(index))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return ParseResult<VariantList>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            expectName = false;
        }

        index = (u32[0 max])(index + 1);
    }

    return ParseResult<VariantList>.Ok(variants);
}

// A flat list of user-type head tokens (e.g. the payload types of an enum's
// variants), each the rightmost depth-0 identifier of a type (0 for a built-in,
// which is omitted). Used for type-reference resolution.
public struct TypeHeadList
{
    internal dynamic u32[0 max] Heads;

    TypeHeadList()
    {
        self.Heads = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow TypeHeadList self)
    {
        return self.Heads.Length;
    }

    public law u32[0 max] HeadAt(borrow TypeHeadList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.Heads.Length)
        {
            token = self.Heads[index];
        }

        return token;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow TypeHeadList self, u32[0 max] head)
    {
        if (!self.Heads.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Heads[self.Heads.Length] = head;
        return System.Memory.MemoryStatus.Ok;
    }
}

// The matching close-bracket index for the open bracket (`(`/`[`/`{`/`<`) at
// `open`, tracking nested paren/bracket/brace/angle depth. Returns `open` when no
// match is found before end-of-file.
finite law u32[0 max] MatchingBracket(borrow TokenStream stream, u32[0 max] open)
{
    stack mut u32[0 max] index = open;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (k == TokenKind.EndOfFile)
        {
            return open;
        }

        if (k == TokenKind.LParen || k == TokenKind.LBrack || k == TokenKind.LBrace || k == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (k == TokenKind.RParen || k == TokenKind.RBrack || k == TokenKind.RBrace || k == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return index;
                }
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return open;
}

// Appends the user-type head of the type spanning `[start, endExclusive)` to
// `heads` when it names a user type (a built-in's head is 0 and is omitted).
internal fn System.Memory.MemoryStatus AppendUserHead(mut borrow TypeHeadList heads, borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack u32[0 max] head = BoundedLastIdentifier(stream, start, endExclusive);
    if (head != 0)
    {
        switch (heads.Append(head))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Appends the head of each comma-separated type in `[start, endExclusive)` (a tuple
// payload `(A, B)`'s inner types). Commas at angle/bracket/paren depth 0 separate.
internal fn System.Memory.MemoryStatus CollectCommaSeparatedTypeHeads(mut borrow TypeHeadList heads, borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] segStart = start;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] index = start;
    while willexit (index < endExclusive)
    {
        stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (k == TokenKind.LParen || k == TokenKind.LBrack || k == TokenKind.LBrace || k == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (k == TokenKind.RParen || k == TokenKind.RBrack || k == TokenKind.RBrace || k == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && k == TokenKind.Comma)
        {
            switch (AppendUserHead(heads, stream, segStart, index))
            {
                case System.Memory.MemoryStatus.Err(var segError):
                    return System.Memory.MemoryStatus.Err(segError);
                case System.Memory.MemoryStatus.Ok:
            }

            segStart = (u32[0 max])(index + 1);
        }

        index = (u32[0 max])(index + 1);
    }

    // The final (or only) type, if the span is non-empty.
    if (segStart < endExclusive)
    {
        switch (AppendUserHead(heads, stream, segStart, endExclusive))
        {
            case System.Memory.MemoryStatus.Err(var lastError):
                return System.Memory.MemoryStatus.Err(lastError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Appends the head of each member type in a named-field payload `{ f: A, g: B }`
// spanning `[start, endExclusive)`: for each comma-separated member, the type is
// the span after its depth-0 `:`.
internal fn System.Memory.MemoryStatus CollectNamedFieldTypeHeads(mut borrow TypeHeadList heads, borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] segStart = start;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] index = start;
    while willexit (index <= endExclusive)
    {
        stack mut bool boundary = false;
        if (index >= endExclusive)
        {
            boundary = true;
        }
        else
        {
            stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])index);
            if (k == TokenKind.LParen || k == TokenKind.LBrack || k == TokenKind.LBrace || k == TokenKind.Lt)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (k == TokenKind.RParen || k == TokenKind.RBrack || k == TokenKind.RBrace || k == TokenKind.Gt)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0 && k == TokenKind.Comma)
            {
                boundary = true;
            }
        }

        if (boundary)
        {
            // The member `[segStart, index)` is `field : type`; take the type's head.
            stack mut u32[0 max] colon = segStart;
            stack mut u32[0 max] cdepth = 0;
            stack mut bool foundColon = false;
            stack mut u32[0 max] cscan = segStart;
            while willexit (cscan < index)
            {
                stack TokenKind ck = stream.KindAt((u64[0 2 ** 63 - 1])cscan);
                if (ck == TokenKind.LParen || ck == TokenKind.LBrack || ck == TokenKind.LBrace || ck == TokenKind.Lt)
                {
                    cdepth = (u32[0 max])(cdepth + 1);
                }
                else if (ck == TokenKind.RParen || ck == TokenKind.RBrack || ck == TokenKind.RBrace || ck == TokenKind.Gt)
                {
                    if (cdepth > 0)
                    {
                        cdepth = (u32[0 max])(cdepth - 1);
                    }
                }
                else if (cdepth == 0 && ck == TokenKind.Colon)
                {
                    colon = cscan;
                    foundColon = true;
                    cscan = index;
                }

                if (cscan < index)
                {
                    cscan = (u32[0 max])(cscan + 1);
                }
            }

            if (foundColon && (u32[0 max])(colon + 1) < index)
            {
                switch (AppendUserHead(heads, stream, (u32[0 max])(colon + 1), index))
                {
                    case System.Memory.MemoryStatus.Err(var memberError):
                        return System.Memory.MemoryStatus.Err(memberError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            segStart = (u32[0 max])(index + 1);
        }

        index = (u32[0 max])(index + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

// The token index of the next depth-0 `,`, `}`, or `)` at or after `start` (the end
// of a `from type` payload), tracking nested brackets so a `,` inside `List<A, B>`
// does not end it. Returns the first such token, or end-of-file's index.
finite law u32[0 max] FromPayloadEnd(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (k == TokenKind.EndOfFile)
        {
            return index;
        }

        if (depth == 0 && (k == TokenKind.Comma || k == TokenKind.RBrace || k == TokenKind.RParen))
        {
            return index;
        }

        if (k == TokenKind.LParen || k == TokenKind.LBrack || k == TokenKind.LBrace || k == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (k == TokenKind.RParen || k == TokenKind.RBrack || k == TokenKind.RBrace || k == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return index;
}

// Collects the user-type head token of every enum-variant payload type across the
// enum whose keyword is at `enumKeyword` — the tuple `(A, B)`, named-field
// `{ f: A }`, and `from A` payload forms (`Stark.g4` `enumVariantPayload`). Built-in
// payload types have head 0 and are omitted. Returns an empty list for a bodyless
// enum. Attribute lists `[Attr]` before a variant are skipped by bracket depth.
public fn ParseResult<TypeHeadList> ParseEnumPayloadHeads(borrow TokenStream stream, u32[0 max] enumKeyword)
{
    stack mut TypeHeadList heads = new();
    stack mut u32[0 max] index = enumKeyword;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile
        && stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        index = (u32[0 max])(index + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        return ParseResult<TypeHeadList>.Ok(heads);
    }

    index = (u32[0 max])(index + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (k == TokenKind.EndOfFile)
        {
            guard = 0;
        }
        else if (k == TokenKind.RBrace && depth == 0)
        {
            guard = 0;
        }
        else if (k == TokenKind.LBrack)
        {
            // An attribute list `[...]`: skip its contents via depth.
            depth = (u32[0 max])(depth + 1);
            index = (u32[0 max])(index + 1);
        }
        else if (k == TokenKind.RBrack)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            index = (u32[0 max])(index + 1);
        }
        else if (depth == 0 && k == TokenKind.From)
        {
            stack u32[0 max] fromEnd = FromPayloadEnd(stream, (u32[0 max])(index + 1));
            switch (AppendUserHead(heads, stream, (u32[0 max])(index + 1), fromEnd))
            {
                case System.Memory.MemoryStatus.Err(var fromError):
                    return ParseResult<TypeHeadList>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            index = fromEnd;
        }
        else if (depth == 0 && k == TokenKind.LParen)
        {
            stack u32[0 max] close = MatchingBracket(stream, index);
            switch (CollectCommaSeparatedTypeHeads(heads, stream, (u32[0 max])(index + 1), close))
            {
                case System.Memory.MemoryStatus.Err(var tupleError):
                    return ParseResult<TypeHeadList>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            index = (u32[0 max])(close + 1);
        }
        else if (depth == 0 && k == TokenKind.LBrace)
        {
            stack u32[0 max] close = MatchingBracket(stream, index);
            switch (CollectNamedFieldTypeHeads(heads, stream, (u32[0 max])(index + 1), close))
            {
                case System.Memory.MemoryStatus.Err(var namedError):
                    return ParseResult<TypeHeadList>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            index = (u32[0 max])(close + 1);
        }
        else
        {
            index = (u32[0 max])(index + 1);
        }
    }

    return ParseResult<TypeHeadList>.Ok(heads);
}

// Collects the user-type head of every constraint trait in a `where Identifier :
// type_ (, type_)*` type-parameter-constraint clause of the declaration whose
// keyword is at `declKeyword` (`Stark.g4` `typeParameterConstraints`). The `where`
// is found at bracket depth 0 before the body `{`/`;`; a memory-contract `where`
// (`where disjoint(...)`, not followed by `Identifier :`) is skipped. Returns an
// empty list when there is no such clause.
public fn ParseResult<TypeHeadList> CollectWhereConstraintHeads(borrow TokenStream stream, u32[0 max] declKeyword)
{
    stack mut TypeHeadList heads = new();
    stack mut u32[0 max] index = declKeyword;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] whereToken = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (k == TokenKind.EndOfFile)
        {
            guard = 0;
        }
        else if (k == TokenKind.LParen || k == TokenKind.LBrack || k == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
            index = (u32[0 max])(index + 1);
        }
        else if (k == TokenKind.RParen || k == TokenKind.RBrack || k == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            index = (u32[0 max])(index + 1);
        }
        else if (depth == 0 && (k == TokenKind.LBrace || k == TokenKind.Semi))
        {
            // The body (or end of an abstract declaration) before any `where`.
            guard = 0;
        }
        else if (depth == 0 && k == TokenKind.Where
            && stream.KindAt((u64[0 2 ** 63 - 1])(index + 1)) == TokenKind.Identifier
            && stream.KindAt((u64[0 2 ** 63 - 1])(index + 2)) == TokenKind.Colon)
        {
            whereToken = index;
            guard = 0;
        }
        else
        {
            index = (u32[0 max])(index + 1);
        }
    }

    if (whereToken == 0)
    {
        return ParseResult<TypeHeadList>.Ok(heads);
    }

    // The constraint types run after `Identifier :` until the body `{`/`;` at depth 0.
    stack mut u32[0 max] constraintStart = (u32[0 max])(whereToken + 3);
    stack mut u32[0 max] constraintEnd = constraintStart;
    stack mut u32[0 max] endDepth = 0;
    stack mut u64[0 2 ** 63 - 1] endGuard = stream.Count();
    while willexit (endGuard > 0)
    {
        endGuard = (u64[0 2 ** 63 - 1])(endGuard - 1);
        stack TokenKind ek = stream.KindAt((u64[0 2 ** 63 - 1])constraintEnd);
        if (ek == TokenKind.EndOfFile)
        {
            endGuard = 0;
        }
        else if (ek == TokenKind.LParen || ek == TokenKind.LBrack || ek == TokenKind.Lt)
        {
            endDepth = (u32[0 max])(endDepth + 1);
            constraintEnd = (u32[0 max])(constraintEnd + 1);
        }
        else if (ek == TokenKind.RParen || ek == TokenKind.RBrack || ek == TokenKind.Gt)
        {
            if (endDepth > 0)
            {
                endDepth = (u32[0 max])(endDepth - 1);
            }

            constraintEnd = (u32[0 max])(constraintEnd + 1);
        }
        else if (endDepth == 0 && (ek == TokenKind.LBrace || ek == TokenKind.Semi))
        {
            endGuard = 0;
        }
        else
        {
            constraintEnd = (u32[0 max])(constraintEnd + 1);
        }
    }

    switch (CollectCommaSeparatedTypeHeads(heads, stream, constraintStart, constraintEnd))
    {
        case System.Memory.MemoryStatus.Err(var collectError):
            return ParseResult<TypeHeadList>.Err(ParseError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    return ParseResult<TypeHeadList>.Ok(heads);
}

// The field name tokens of a struct/record body, in source order.
public struct FieldList
{
    internal dynamic u32[0 max] NameTokens;
    // Per-field user-type head identifier (the rightmost depth-0 identifier of the
    // field's type, e.g. `Bar` in `Bar f;` / `List` in `List<u32> f;`); 0 for a
    // built-in field type (`i32 f;`). In lockstep with `NameTokens`.
    internal dynamic u32[0 max] TypeHeadTokens;
    // Per-field type-primary token (the first type-starting token of the field's
    // type — a built-in like `i32`/`bool` or a user-type identifier), for value
    // typing via `MapTypeToken`. In lockstep with `NameTokens`.
    internal dynamic u32[0 max] TypePrimaryTokens;

    FieldList()
    {
        self.NameTokens = new();
        self.TypeHeadTokens = new();
        self.TypePrimaryTokens = new();
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow FieldList self)
    {
        return self.NameTokens.Length;
    }

    public law u32[0 max] NameTokenAt(borrow FieldList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.NameTokens.Length)
        {
            token = self.NameTokens[index];
        }

        return token;
    }

    // The user-type head token of field `index` (0 when the field has a built-in
    // type or `index` is out of range).
    public law u32[0 max] TypeHeadAt(borrow FieldList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypeHeadTokens.Length)
        {
            token = self.TypeHeadTokens[index];
        }

        return token;
    }

    // The type-primary token of field `index` (0 when out of range), for typing.
    public law u32[0 max] TypePrimaryAt(borrow FieldList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.TypePrimaryTokens.Length)
        {
            token = self.TypePrimaryTokens[index];
        }

        return token;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow FieldList self, u32[0 max] nameToken, u32[0 max] typeHeadToken, u32[0 max] typePrimaryToken)
    {
        if (!self.NameTokens.TryReserve(1) || !self.TypeHeadTokens.TryReserve(1)
            || !self.TypePrimaryTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.NameTokens[self.NameTokens.Length] = nameToken;
        init self.TypeHeadTokens[self.TypeHeadTokens.Length] = typeHeadToken;
        init self.TypePrimaryTokens[self.TypePrimaryTokens.Length] = typePrimaryToken;
        return System.Memory.MemoryStatus.Ok;
    }
}

// Parses the data-field names of the struct/record whose keyword is at
// `structKeyword`. A member is a field only when it is `;`-terminated and does
// not begin (after modifiers) with a declaration keyword — i.e. `Type name;`,
// whose name is the last identifier before the `;`. Constructors (`Name() { }`)
// and methods (`fn ...`) are skipped, so braces inside them never confuse the
// field walk. Returns an empty list when the struct has no body.
public fn ParseResult<FieldList> ParseStructFields(borrow TokenStream stream, u32[0 max] structKeyword)
{
    stack mut FieldList fields = new();
    stack mut u32[0 max] index = structKeyword;

    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile
        && stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        index = (u32[0 max])(index + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        return ParseResult<FieldList>.Ok(fields);
    }

    index = (u32[0 max])(index + 1);
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])index) == TokenKind.RBrace)
        {
            break;
        }

        stack u32[0 max] memberStart = index;
        stack u32[0 max] memberEnd = SkipDeclarationBody(stream, memberStart);

        stack mut u32[0 max] cursor = memberStart;
        while willexit (IsDeclarationModifierAt(stream, cursor))
        {
            cursor = (u32[0 max])(cursor + 1);
        }

        stack DeclarationKind kind = ClassifyDeclarationKind(stream.KindAt((u64[0 2 ** 63 - 1])cursor));
        if (kind == DeclarationKind.Unknown
            && stream.KindAt((u64[0 2 ** 63 - 1])memberEnd) == TokenKind.Semi)
        {
            // A field declaration is `type_ variableDeclarators ;` where the
            // declarators are a depth-0 comma-separated list, each `Identifier
            // [capacity]?`. Split on depth-0 commas: the FIRST declarator's prefix is
            // the shared field type (whose head is the rightmost depth-0 identifier
            // before that declarator's name); every declarator's name is the last
            // depth-0 identifier of its segment (so a `[N]` capacity — whose tokens
            // are bracket-nested — is skipped). All declarators share the type head.
            stack mut u32[0 max] sharedTypeHead = 0;
            stack mut u32[0 max] sharedTypePrimary = 0;
            stack mut bool haveType = false;
            stack mut u32[0 max] segStart = memberStart;
            stack mut u32[0 max] segDepth = 0;
            stack mut u32[0 max] dscan = memberStart;
            while willexit (dscan <= memberEnd)
            {
                stack TokenKind dk = stream.KindAt((u64[0 2 ** 63 - 1])dscan);
                if (dk == TokenKind.Lt || dk == TokenKind.LBrack || dk == TokenKind.LParen)
                {
                    segDepth = (u32[0 max])(segDepth + 1);
                }
                else if (dk == TokenKind.Gt || dk == TokenKind.RBrack || dk == TokenKind.RParen)
                {
                    if (segDepth > 0)
                    {
                        segDepth = (u32[0 max])(segDepth - 1);
                    }
                }
                else if (segDepth == 0 && (dk == TokenKind.Comma || dk == TokenKind.Semi))
                {
                    // The declarator segment is `[segStart, dscan)`.
                    stack u32[0 max] nameToken = BoundedLastIdentifier(stream, segStart, dscan);
                    if (nameToken != 0)
                    {
                        if (!haveType)
                        {
                            sharedTypeHead = BoundedLastIdentifier(stream, segStart, nameToken);
                            sharedTypePrimary = BoundedFirstTypeStart(stream, segStart, nameToken);
                            haveType = true;
                        }

                        switch (fields.Append(nameToken, sharedTypeHead, sharedTypePrimary))
                        {
                            case System.Memory.MemoryStatus.Err(var appendError):
                                return ParseResult<FieldList>.Err(ParseError.OutOfMemory);
                            case System.Memory.MemoryStatus.Ok:
                        }
                    }

                    segStart = (u32[0 max])(dscan + 1);
                }

                dscan = (u32[0 max])(dscan + 1);
            }
        }

        index = (u32[0 max])(memberEnd + 1);
    }

    return ParseResult<FieldList>.Ok(fields);
}

// A function's name token and the name tokens of its parameters.
public struct FunctionSignature
{
    u32[0 max] NameToken;
    bool IsTailCallable;
    bool IsFiniteKind;
    bool IsLawKind;
    // The head identifier token of the return type when it names a user type
    // (e.g. `Foo` in `fn Foo g()` / `List` in `fn List<u32> g()`); 0 when the
    // return type is a built-in (`fn void f()` / `fn i32 n()`).
    u32[0 max] ReturnTypeHead;
    // The return type's type-primary token: the first type-starting token of the
    // return type (a built-in like `void`/`i32` or a user-type identifier), used
    // to classify the return type (e.g. to detect a `void` return).
    u32[0 max] ReturnTypeToken;
    bool ReturnTypeIsTailCallable;
    internal dynamic u32[0 max] ParamNameTokens;
    // Per-parameter type head identifier (0 for a built-in parameter type), kept
    // in lockstep with `ParamNameTokens`.
    internal dynamic u32[0 max] ParamTypeHeads;
    // Per-parameter type-primary token: the first type-starting token (a built-in
    // type token like `i32`/`bool`, or a user-type identifier), used to classify
    // the parameter's value type. In lockstep with `ParamNameTokens`.
    internal dynamic u32[0 max] ParamTypeTokens;
    // Per-parameter source token span `[start, end)`, kept so lowering and
    // semantic checks can classify borrow/out/init mode without reparsing the
    // enclosing declaration.
    internal dynamic u32[0 max] ParamStartTokens;
    internal dynamic u32[0 max] ParamEndTokens;
    internal dynamic u32[0 max] ParamTypeTailCallableFlags;
    u32[0 max] ReturnTypeDeadOnReturnArgumentCount;
    internal dynamic u32[0 max] ParamTypeDeadOnReturnArgumentCounts;
    internal dynamic u32[0 max] DeadOnReturnParamNameTokens;
    bool IsAsmDeclaration;
    u32[0 max] AsmSpecifierToken;
    u32[0 max] AsmArchitectureNameToken;
    internal dynamic u32[0 max] AsmInputRegisterTokens;
    internal dynamic u32[0 max] AsmInputValueTokens;
    internal dynamic u32[0 max] AsmOutputRegisterTokens;
    internal dynamic u32[0 max] AsmOutputValueTokens;
    internal dynamic u32[0 max] AsmOutputReturnFlags;
    internal dynamic u32[0 max] AsmClobberRegisterTokens;
    u32[0 max] AsmTemplateStringToken;

    FunctionSignature()
    {
        self.NameToken = 0;
        self.IsTailCallable = false;
        self.IsFiniteKind = false;
        self.IsLawKind = false;
        self.ReturnTypeHead = 0;
        self.ReturnTypeToken = 0;
        self.ReturnTypeIsTailCallable = false;
        self.ParamNameTokens = new();
        self.ParamTypeHeads = new();
        self.ParamTypeTokens = new();
        self.ParamStartTokens = new();
        self.ParamEndTokens = new();
        self.ParamTypeTailCallableFlags = new();
        self.ReturnTypeDeadOnReturnArgumentCount = 0;
        self.ParamTypeDeadOnReturnArgumentCounts = new();
        self.DeadOnReturnParamNameTokens = new();
        self.IsAsmDeclaration = false;
        self.AsmSpecifierToken = 0;
        self.AsmArchitectureNameToken = 0;
        self.AsmInputRegisterTokens = new();
        self.AsmInputValueTokens = new();
        self.AsmOutputRegisterTokens = new();
        self.AsmOutputValueTokens = new();
        self.AsmOutputReturnFlags = new();
        self.AsmClobberRegisterTokens = new();
        self.AsmTemplateStringToken = 0;
    }

    public inline finite law u32[0 max] Name(borrow FunctionSignature self)
    {
        return self.NameToken;
    }

    public inline finite law bool TailCallable(borrow FunctionSignature self)
    {
        return self.IsTailCallable;
    }

    public inline finite law bool FiniteKind(borrow FunctionSignature self)
    {
        return self.IsFiniteKind;
    }

    public inline finite law bool LawKind(borrow FunctionSignature self)
    {
        return self.IsLawKind;
    }

    // The return type's head identifier token (0 for a built-in return type).
    public inline finite law u32[0 max] ReturnType(borrow FunctionSignature self)
    {
        return self.ReturnTypeHead;
    }

    // The return type's type-primary token (built-in type token or user-type
    // identifier), for classifying the return type.
    public inline finite law u32[0 max] ReturnTypeTokenAt(borrow FunctionSignature self)
    {
        return self.ReturnTypeToken;
    }

    public inline finite law bool ReturnTypeTailCallable(borrow FunctionSignature self)
    {
        return self.ReturnTypeIsTailCallable;
    }

    public inline finite law u32[0 max] ReturnTypeDeadOnReturnParamCount(borrow FunctionSignature self)
    {
        return self.ReturnTypeDeadOnReturnArgumentCount;
    }

    public inline finite law u64[0 2 ** 63 - 1] ParamCount(borrow FunctionSignature self)
    {
        return self.ParamNameTokens.Length;
    }

    public law u32[0 max] ParamNameAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ParamNameTokens.Length)
        {
            token = self.ParamNameTokens[index];
        }

        return token;
    }

    // Parameter `index`'s type head identifier token (0 for a built-in type).
    public law u32[0 max] ParamTypeAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ParamTypeHeads.Length)
        {
            token = self.ParamTypeHeads[index];
        }

        return token;
    }

    // Parameter `index`'s type-primary token (a built-in type token or user-type
    // identifier); 0 when out of range.
    public law u32[0 max] ParamTypeTokenAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ParamTypeTokens.Length)
        {
            token = self.ParamTypeTokens[index];
        }

        return token;
    }

    public law bool ParamTypeTailCallable(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut bool isTail = false;
        if (index < self.ParamTypeTailCallableFlags.Length)
        {
            isTail = self.ParamTypeTailCallableFlags[index] != 0;
        }

        return isTail;
    }

    public law u32[0 max] ParamStartTokenAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ParamStartTokens.Length)
        {
            token = self.ParamStartTokens[index];
        }

        return token;
    }

    public law u32[0 max] ParamEndTokenAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.ParamEndTokens.Length)
        {
            token = self.ParamEndTokens[index];
        }

        return token;
    }

    public law u32[0 max] ParamTypeDeadOnReturnParamCount(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] count = 0;
        if (index < self.ParamTypeDeadOnReturnArgumentCounts.Length)
        {
            count = self.ParamTypeDeadOnReturnArgumentCounts[index];
        }

        return count;
    }

    public inline finite law u64[0 2 ** 63 - 1] DeadOnReturnParamCount(borrow FunctionSignature self)
    {
        return self.DeadOnReturnParamNameTokens.Length;
    }

    public law u32[0 max] DeadOnReturnParamNameAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.DeadOnReturnParamNameTokens.Length)
        {
            token = self.DeadOnReturnParamNameTokens[index];
        }

        return token;
    }

    public inline finite law bool HasAsm(borrow FunctionSignature self)
    {
        return self.IsAsmDeclaration;
    }

    public inline finite law u32[0 max] AsmToken(borrow FunctionSignature self)
    {
        return self.AsmSpecifierToken;
    }

    public inline finite law u32[0 max] AsmArchitectureToken(borrow FunctionSignature self)
    {
        return self.AsmArchitectureNameToken;
    }

    public inline finite law u32[0 max] AsmInputCount(borrow FunctionSignature self)
    {
        return (u32[0 max])self.AsmInputRegisterTokens.Length;
    }

    public inline finite law u32[0 max] AsmOutputCount(borrow FunctionSignature self)
    {
        return (u32[0 max])self.AsmOutputRegisterTokens.Length;
    }

    public inline finite law u32[0 max] AsmClobberCount(borrow FunctionSignature self)
    {
        return (u32[0 max])self.AsmClobberRegisterTokens.Length;
    }

    public inline finite law u32[0 max] AsmTemplateToken(borrow FunctionSignature self)
    {
        return self.AsmTemplateStringToken;
    }

    public law u32[0 max] AsmInputRegisterAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.AsmInputRegisterTokens.Length)
        {
            token = self.AsmInputRegisterTokens[index];
        }

        return token;
    }

    public law u32[0 max] AsmInputValueAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.AsmInputValueTokens.Length)
        {
            token = self.AsmInputValueTokens[index];
        }

        return token;
    }

    public law u32[0 max] AsmOutputRegisterAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.AsmOutputRegisterTokens.Length)
        {
            token = self.AsmOutputRegisterTokens[index];
        }

        return token;
    }

    public law u32[0 max] AsmOutputValueAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.AsmOutputValueTokens.Length)
        {
            token = self.AsmOutputValueTokens[index];
        }

        return token;
    }

    public law bool AsmOutputBindsReturnAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut bool bindsReturn = false;
        if (index < self.AsmOutputReturnFlags.Length)
        {
            bindsReturn = self.AsmOutputReturnFlags[index] != 0;
        }

        return bindsReturn;
    }

    public law u32[0 max] AsmClobberRegisterAt(borrow FunctionSignature self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] token = 0;
        if (index < self.AsmClobberRegisterTokens.Length)
        {
            token = self.AsmClobberRegisterTokens[index];
        }

        return token;
    }

    internal fn System.Memory.MemoryStatus AppendDeadOnReturnParamName(mut borrow FunctionSignature self, u32[0 max] token)
    {
        if (!self.DeadOnReturnParamNameTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.DeadOnReturnParamNameTokens[self.DeadOnReturnParamNameTokens.Length] = token;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus AppendAsmInputOperand(mut borrow FunctionSignature self, u32[0 max] registerToken, u32[0 max] valueToken)
    {
        if (!self.AsmInputRegisterTokens.TryReserve(1)
            || !self.AsmInputValueTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.AsmInputRegisterTokens[self.AsmInputRegisterTokens.Length] = registerToken;
        init self.AsmInputValueTokens[self.AsmInputValueTokens.Length] = valueToken;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus AppendAsmOutputOperand(mut borrow FunctionSignature self, u32[0 max] registerToken, u32[0 max] valueToken, bool bindsReturn)
    {
        stack mut u32[0 max] returnFlag = 0;
        if (bindsReturn)
        {
            returnFlag = 1;
        }

        if (!self.AsmOutputRegisterTokens.TryReserve(1)
            || !self.AsmOutputValueTokens.TryReserve(1)
            || !self.AsmOutputReturnFlags.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.AsmOutputRegisterTokens[self.AsmOutputRegisterTokens.Length] = registerToken;
        init self.AsmOutputValueTokens[self.AsmOutputValueTokens.Length] = valueToken;
        init self.AsmOutputReturnFlags[self.AsmOutputReturnFlags.Length] = returnFlag;
        return System.Memory.MemoryStatus.Ok;
    }

    internal fn System.Memory.MemoryStatus AppendAsmClobberRegister(mut borrow FunctionSignature self, u32[0 max] registerToken)
    {
        if (!self.AsmClobberRegisterTokens.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.AsmClobberRegisterTokens[self.AsmClobberRegisterTokens.Length] = registerToken;
        return System.Memory.MemoryStatus.Ok;
    }

    // Appends the parameter whose tokens are `[start, end)`: its name is the last
    // identifier in that range and its type head is the first identifier (the
    // leading type name `Foo`/`List`), which is 0 when the only identifier is the
    // name (a built-in type). Empty ranges contribute nothing.
    internal fn System.Memory.MemoryStatus AppendParam(mut borrow FunctionSignature self, borrow TokenStream stream, u32[0 max] start, u32[0 max] end)
    {
        // Track angle/bracket/paren depth so range bounds (`[0 max]`), generic
        // arguments (`<u32>`), and fnptr parens contribute no identifiers. The
        // name is the last depth-0 identifier; the type head is the depth-0
        // identifier immediately before it (the rightmost segment of a dotted
        // type like `System.Foo`), 0 when none (a built-in type like `i32`).
        stack mut u32[0 max] nameToken = 0;
        stack mut u32[0 max] prevIdentifier = 0;
        stack mut u32[0 max] typeToken = 0;
        stack mut bool hasName = false;
        stack mut u32[0 max] depth = 0;
        stack mut u32[0 max] scan = start;
        while willexit (scan < end)
        {
            stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
            if (kind == TokenKind.Lt || kind == TokenKind.LBrack || kind == TokenKind.LParen)
            {
                depth = (u32[0 max])(depth + 1);
            }
            else if (kind == TokenKind.Gt || kind == TokenKind.RBrack || kind == TokenKind.RParen)
            {
                if (depth > 0)
                {
                    depth = (u32[0 max])(depth - 1);
                }
            }
            else if (depth == 0)
            {
                if (typeToken == 0 && IsTypeStartToken(kind))
                {
                    typeToken = scan;
                }

                if (kind == TokenKind.Identifier)
                {
                    prevIdentifier = nameToken;
                    nameToken = scan;
                    hasName = true;
                }
            }

            scan = (u32[0 max])(scan + 1);
        }

        if (!hasName)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        stack mut u32[0 max] tailFlag = 0;
        if (TypeSpanContainsTailCallableSignature(stream, start, nameToken))
        {
            tailFlag = 1;
        }

        stack u32[0 max] deadOnReturnArgumentCount = TypeSpanDeadOnReturnArgumentCount(stream, start, nameToken);

        if (!self.ParamNameTokens.TryReserve(1)
            || !self.ParamTypeHeads.TryReserve(1)
            || !self.ParamTypeTokens.TryReserve(1)
            || !self.ParamStartTokens.TryReserve(1)
            || !self.ParamEndTokens.TryReserve(1)
            || !self.ParamTypeTailCallableFlags.TryReserve(1)
            || !self.ParamTypeDeadOnReturnArgumentCounts.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.ParamNameTokens[self.ParamNameTokens.Length] = nameToken;
        init self.ParamTypeHeads[self.ParamTypeHeads.Length] = prevIdentifier;
        init self.ParamTypeTokens[self.ParamTypeTokens.Length] = typeToken;
        init self.ParamStartTokens[self.ParamStartTokens.Length] = start;
        init self.ParamEndTokens[self.ParamEndTokens.Length] = end;
        init self.ParamTypeTailCallableFlags[self.ParamTypeTailCallableFlags.Length] = tailFlag;
        init self.ParamTypeDeadOnReturnArgumentCounts[self.ParamTypeDeadOnReturnArgumentCounts.Length] = deadOnReturnArgumentCount;
        return System.Memory.MemoryStatus.Ok;
    }
}

finite law bool TokenCanStartCallableFunctionKind(TokenKind kind)
{
    return kind == TokenKind.Fn || kind == TokenKind.Finite || kind == TokenKind.Law;
}

finite law bool TypeSpanContainsTailCallableSignature(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (IsContextualTailToken(stream, scan)
            && TokenCanStartCallableFunctionKind(stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1))))
        {
            return true;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return false;
}

finite u32[0 max] DeadOnReturnArgumentCountInCall(borrow TokenStream stream, u32[0 max] lparen)
{
    stack mut u32[0 max] count = 0;
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return count;
        }

        if (kind == TokenKind.RParen && depth == 0)
        {
            return count;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0)
        {
            count = (u32[0 max])(count + 1);
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

finite u32[0 max] TypeSpanDeadOnReturnArgumentCount(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] count = 0;
    stack mut u32[0 max] scan = start;
    while willexit (scan < endExclusive)
    {
        if (IsContextualDeadOnReturnToken(stream, scan)
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            count = (u32[0 max])(count + DeadOnReturnArgumentCountInCall(stream, (u32[0 max])(scan + 1)));
        }

        scan = (u32[0 max])(scan + 1);
    }

    return count;
}

internal fn System.Memory.MemoryStatus AppendDeadOnReturnArgumentTokensFromCall(
    mut borrow FunctionSignature signature,
    borrow TokenStream stream,
    u32[0 max] lparen)
{
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.RParen && depth == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.Identifier && depth == 0)
        {
            switch (signature.AppendDeadOnReturnParamName(scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectDeadOnReturnContracts(
    mut borrow FunctionSignature signature,
    borrow TokenStream stream,
    u32[0 max] start)
{
    stack mut u32[0 max] scan = start;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (depth == 0 && (kind == TokenKind.LBrace || kind == TokenKind.Semi))
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (depth == 0
            && IsContextualDeadOnReturnToken(stream, scan)
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            switch (AppendDeadOnReturnArgumentTokensFromCall(signature, stream, (u32[0 max])(scan + 1)))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

finite law u32[0 max] MatchingOpenParenBefore(borrow TokenStream stream, u32[0 max] closeParen)
{
    stack mut u32[0 max] cursor = closeParen;
    stack mut u32[0 max] depth = 0;
    while willexit (cursor > 0)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
        if (kind == TokenKind.RParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.LParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
                if (depth == 0)
                {
                    return cursor;
                }
            }
        }

        cursor = (u32[0 max])(cursor - 1);
    }

    return closeParen;
}

finite law bool FunctionHasTailModifierBefore(borrow TokenStream stream, u32[0 max] fnKeyword)
{
    if (fnKeyword == 0)
    {
        return false;
    }

    stack mut u32[0 max] cursor = fnKeyword;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (cursor > 0 && guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack u32[0 max] previous = (u32[0 max])(cursor - 1);
        stack TokenKind previousKind = stream.KindAt((u64[0 2 ** 63 - 1])previous);

        if (IsContextualTailToken(stream, previous))
        {
            return true;
        }

        if (previousKind == TokenKind.RParen)
        {
            stack u32[0 max] open = MatchingOpenParenBefore(stream, previous);
            if (open > 0
                && (stream.KindAt((u64[0 2 ** 63 - 1])(open - 1)) == TokenKind.Ffi
                    || stream.KindAt((u64[0 2 ** 63 - 1])(open - 1)) == TokenKind.Asm))
            {
                cursor = (u32[0 max])(open - 1);
                continue;
            }

            return false;
        }

        if (IsDeclarationModifierKind(previousKind))
        {
            cursor = previous;
            continue;
        }

        return false;
    }

    return false;
}

finite law bool FunctionHasKeywordModifierBefore(borrow TokenStream stream, u32[0 max] fnKeyword, TokenKind modifierKind)
{
    if (fnKeyword == 0)
    {
        return false;
    }

    stack mut u32[0 max] cursor = fnKeyword;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (cursor > 0 && guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack u32[0 max] previous = (u32[0 max])(cursor - 1);
        stack TokenKind previousKind = stream.KindAt((u64[0 2 ** 63 - 1])previous);

        if (previousKind == modifierKind)
        {
            return true;
        }

        if (previousKind == TokenKind.RParen)
        {
            stack u32[0 max] open = MatchingOpenParenBefore(stream, previous);
            if (open > 0
                && (stream.KindAt((u64[0 2 ** 63 - 1])(open - 1)) == TokenKind.Ffi
                    || stream.KindAt((u64[0 2 ** 63 - 1])(open - 1)) == TokenKind.Asm))
            {
                cursor = (u32[0 max])(open - 1);
                continue;
            }

            return false;
        }

        if (IsContextualTailToken(stream, previous) || IsDeclarationModifierKind(previousKind))
        {
            cursor = previous;
            continue;
        }

        return false;
    }

    return false;
}

internal fn void CollectAsmSpecifierBeforeFunction(mut borrow FunctionSignature signature, borrow TokenStream stream, u32[0 max] fnKeyword)
{
    if (fnKeyword == 0)
    {
        return;
    }

    stack mut u32[0 max] cursor = fnKeyword;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (cursor > 0 && guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack u32[0 max] previous = (u32[0 max])(cursor - 1);
        stack TokenKind previousKind = stream.KindAt((u64[0 2 ** 63 - 1])previous);

        if (previousKind == TokenKind.RParen)
        {
            stack u32[0 max] open = MatchingOpenParenBefore(stream, previous);
            if (open > 0 && stream.KindAt((u64[0 2 ** 63 - 1])(open - 1)) == TokenKind.Asm)
            {
                signature.IsAsmDeclaration = true;
                signature.AsmSpecifierToken = (u32[0 max])(open - 1);
                if (stream.KindAt((u64[0 2 ** 63 - 1])(open + 1)) == TokenKind.Identifier)
                {
                    signature.AsmArchitectureNameToken = (u32[0 max])(open + 1);
                }

                return;
            }

            if (open > 0 && stream.KindAt((u64[0 2 ** 63 - 1])(open - 1)) == TokenKind.Ffi)
            {
                cursor = (u32[0 max])(open - 1);
                continue;
            }

            return;
        }

        if (IsContextualTailToken(stream, previous) || IsDeclarationModifierKind(previousKind))
        {
            cursor = previous;
            continue;
        }

        return;
    }
}

internal fn u32[0 max] FirstStringLiteralInParenList(borrow TokenStream stream, u32[0 max] lparen)
{
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return 0;
        }

        if (kind == TokenKind.RParen && depth == 0)
        {
            return 0;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.StringLiteral && depth == 0)
        {
            return scan;
        }

        scan = (u32[0 max])(scan + 1);
    }

    return 0;
}

internal fn u32[0 max] AsmOperandValueTokenAfterParen(borrow TokenStream stream, u32[0 max] closeParen)
{
    stack u32[0 max] token = (u32[0 max])(closeParen + 1);
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])token);
    if (kind == TokenKind.Identifier || kind == TokenKind.Return)
    {
        return token;
    }

    return 0;
}

internal fn System.Memory.MemoryStatus AppendAsmClobberRegistersFromParenList(
    mut borrow FunctionSignature signature,
    borrow TokenStream stream,
    u32[0 max] lparen)
{
    stack mut u32[0 max] scan = (u32[0 max])(lparen + 1);
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.RParen && depth == 0)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.StringLiteral && depth == 0)
        {
            switch (signature.AppendAsmClobberRegister(scan))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

internal fn System.Memory.MemoryStatus CollectAsmMetadataAfterParameters(mut borrow FunctionSignature signature, borrow TokenStream stream, u32[0 max] afterParams)
{
    if (!signature.IsAsmDeclaration)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] scan = afterParams;
    stack mut u32[0 max] depth = 0;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (kind == TokenKind.EndOfFile || kind == TokenKind.Semi)
        {
            return System.Memory.MemoryStatus.Ok;
        }

        if (depth == 0 && kind == TokenKind.LBrace)
        {
            if (stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.StringLiteral)
            {
                signature.AsmTemplateStringToken = (u32[0 max])(scan + 1);
            }

            return System.Memory.MemoryStatus.Ok;
        }

        if (depth == 0
            && kind == TokenKind.In
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            stack u32[0 max] lparen = (u32[0 max])(scan + 1);
            stack u32[0 max] close = MatchingCloseParenAfter(stream, lparen);
            switch (signature.AppendAsmInputOperand(
                FirstStringLiteralInParenList(stream, lparen),
                AsmOperandValueTokenAfterParen(stream, close)))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            scan = close;
        }
        else if (depth == 0
            && kind == TokenKind.Out
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            stack u32[0 max] lparen = (u32[0 max])(scan + 1);
            stack u32[0 max] close = MatchingCloseParenAfter(stream, lparen);
            stack u32[0 max] valueToken = AsmOperandValueTokenAfterParen(stream, close);
            switch (signature.AppendAsmOutputOperand(
                FirstStringLiteralInParenList(stream, lparen),
                valueToken,
                stream.KindAt((u64[0 2 ** 63 - 1])valueToken) == TokenKind.Return))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            scan = close;
        }
        else if (depth == 0
            && kind == TokenKind.Clobber
            && stream.KindAt((u64[0 2 ** 63 - 1])(scan + 1)) == TokenKind.LParen)
        {
            stack u32[0 max] lparen = (u32[0 max])(scan + 1);
            switch (AppendAsmClobberRegistersFromParenList(signature, stream, lparen))
            {
                case System.Memory.MemoryStatus.Err(var appendError):
                    return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            scan = MatchingCloseParenAfter(stream, lparen);
        }
        else if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

// Parses the signature of the function whose `fn` keyword is at `fnKeyword`: the
// name (the identifier immediately before the parameter list's `(`) and the
// parameter names (last identifier of each `,`-separated parameter at
// bracket-depth 0 inside the `(...)`). The return type, `where` clause, and body
// are not parsed by this slice.
public fn ParseResult<FunctionSignature> ParseFunctionSignature(borrow TokenStream stream, u32[0 max] fnKeyword)
{
    stack mut FunctionSignature signature = new();
    signature.IsTailCallable = FunctionHasTailModifierBefore(stream, fnKeyword);
    signature.IsFiniteKind = FunctionHasKeywordModifierBefore(stream, fnKeyword, TokenKind.Finite);
    signature.IsLawKind = FunctionHasKeywordModifierBefore(stream, fnKeyword, TokenKind.Law);
    CollectAsmSpecifierBeforeFunction(signature, stream, fnKeyword);
    stack mut u32[0 max] index = (u32[0 max])(fnKeyword + 1);
    stack mut u32[0 max] lastIdentifier = 0;
    stack mut u32[0 max] prevIdentifier = 0;
    stack mut u32[0 max] returnTypeToken = 0;
    stack mut bool hasIdentifier = false;
    stack mut u32[0 max] nameDepth = 0;

    // The name is the last identifier at angle/bracket depth 0 before the
    // parameter `(`, so return-type generics and type parameters are skipped. The
    // type head is the depth-0 identifier immediately before the name — the
    // rightmost segment of a dotted return type (`System.Foo` -> `Foo`), 0 for a
    // built-in (`void`/`i32`).
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        stack TokenKind headKind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (headKind == TokenKind.LParen && nameDepth == 0)
        {
            break;
        }

        if (headKind == TokenKind.Lt || headKind == TokenKind.LBrack || headKind == TokenKind.LParen)
        {
            nameDepth = (u32[0 max])(nameDepth + 1);
        }
        else if (headKind == TokenKind.Gt || headKind == TokenKind.RBrack || headKind == TokenKind.RParen)
        {
            if (nameDepth > 0)
            {
                nameDepth = (u32[0 max])(nameDepth - 1);
            }
        }
        else if (headKind == TokenKind.Identifier && nameDepth == 0)
        {
            prevIdentifier = lastIdentifier;
            lastIdentifier = index;
            hasIdentifier = true;
        }

        if (nameDepth == 0 && returnTypeToken == 0 && IsTypeStartToken(headKind))
        {
            returnTypeToken = index;
        }

        index = (u32[0 max])(index + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LParen)
    {
        return ParseResult<FunctionSignature>.Ok(signature);
    }

    if (hasIdentifier)
    {
        signature.NameToken = lastIdentifier;
        signature.ReturnTypeHead = prevIdentifier;
        signature.ReturnTypeToken = returnTypeToken;
        signature.ReturnTypeIsTailCallable = TypeSpanContainsTailCallableSignature(stream, (u32[0 max])(fnKeyword + 1), lastIdentifier);
        signature.ReturnTypeDeadOnReturnArgumentCount = TypeSpanDeadOnReturnArgumentCount(stream, (u32[0 max])(fnKeyword + 1), lastIdentifier);
    }

    index = (u32[0 max])(index + 1);
    stack mut u32[0 max] paramStart = index;
    stack mut u32[0 max] depth = 0;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.RParen && depth == 0)
        {
            switch (signature.AppendParam(stream, paramStart, index))
            {
                case System.Memory.MemoryStatus.Err(var endError):
                    return ParseResult<FunctionSignature>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            break;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack
            || kind == TokenKind.LBrace || kind == TokenKind.Lt)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack
            || kind == TokenKind.RBrace || kind == TokenKind.Gt)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (kind == TokenKind.Comma && depth == 0)
        {
            switch (signature.AppendParam(stream, paramStart, index))
            {
                case System.Memory.MemoryStatus.Err(var commaError):
                    return ParseResult<FunctionSignature>.Err(ParseError.OutOfMemory);
                case System.Memory.MemoryStatus.Ok:
            }

            paramStart = (u32[0 max])(index + 1);
        }

        index = (u32[0 max])(index + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])index) == TokenKind.RParen)
    {
        switch (CollectAsmMetadataAfterParameters(signature, stream, (u32[0 max])(index + 1)))
        {
            case System.Memory.MemoryStatus.Err(var asmError):
                return ParseResult<FunctionSignature>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }

        switch (CollectDeadOnReturnContracts(signature, stream, (u32[0 max])(index + 1)))
        {
            case System.Memory.MemoryStatus.Err(var collectError):
                return ParseResult<FunctionSignature>.Err(ParseError.OutOfMemory);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return ParseResult<FunctionSignature>.Ok(signature);
}

// The kind of a statement, by its leading token.
public enum StatementKind
{
    Return,
    Become,
    If,
    While,
    For,
    // A for-each `for BEHAVIOR (type element in collection) { ... }` traversal. Its
    // bound element (and optional index) are emitted as `Local`s in the loop scope
    // and the traversal collection is its expression — but it carries no boolean
    // condition, so it is a distinct kind from the C-style `For`.
    ForEach,
    Switch,
    Break,
    Continue,
    Local,
    // A `var Identifier` binding introduced by a `case` pattern. Like a `Local` it
    // names an in-scope value (resolved in the section scope), but — unlike a
    // `Local` — repeating the name across a section's `or` alternatives is NOT a
    // redefinition (the host's pattern `Declare` is last-write-wins), so it is a
    // distinct kind that the duplicate-in-block check ignores.
    PatternBinding,
    Unsafe,
    // A bare brace-delimited block `{ ... }` used as a statement (its own scope);
    // its body statements are sub-parsed one level deeper.
    Block,
    // A `case <pattern>... :` / `default :` switch-section label. It carries the
    // label's token span and sits at the switch body's depth; the section's
    // statements follow it one level deeper, so locals in different sections are
    // distinct blocks (the label between them is the shallower boundary).
    Case,
    Expression,
}

// A statement outline: its kind and token span (the body interior is not parsed
// by this slice).
public struct StatementItem
{
    StatementKind Kind;
    u32[0 max] StartToken;
    u32[0 max] EndToken;
    // For a `Local` declaration, the token of the declared variable's name; 0 for
    // every other statement kind.
    u32[0 max] NameToken;
    // For a `Local` declaration, its type-primary token (a built-in type token or
    // user-type identifier); 0 for every other statement kind.
    u32[0 max] TypeToken;
    // For a `Local` declaration with a declared type, its user-type HEAD token (the
    // rightmost depth-0 identifier of the type — `Foo` for `Foo x` / `System.Foo x`,
    // `List` for `List<u32> x`); 0 for a built-in type, a `var` pattern binding, or
    // any other statement kind. Used to resolve the local's named type.
    u32[0 max] TypeHead;

    StatementItem()
    {
        self.Kind = StatementKind.Expression;
        self.StartToken = 0;
        self.EndToken = 0;
        self.NameToken = 0;
        self.TypeToken = 0;
        self.TypeHead = 0;
    }
}

public struct StatementList
{
    internal dynamic StatementKind Kinds;
    internal dynamic u32[0 max] StartTokens;
    internal dynamic u32[0 max] EndTokens;
    // Per-statement declared-name token (`Local` declarations only; 0 otherwise).
    internal dynamic u32[0 max] NameTokens;
    // Per-statement declared type-primary token (`Local` declarations only).
    internal dynamic u32[0 max] TypeTokens;
    // Per-statement declared user-type HEAD token (`Local` declarations with a named
    // type; 0 for a built-in / `var` pattern binding / other kinds). For resolving
    // the local's named type — distinct from `TypeTokens` for a qualified type.
    internal dynamic u32[0 max] TypeHeads;
    // Per-statement expression root (1-based into `Expressions`, 0 = none): the
    // returned value of a `return`, or the whole of an expression statement.
    internal dynamic u32[0 max] ExprRoots;
    // Per-statement block nesting depth: statements are stored in pre-order, so a
    // block statement's children are the immediately following statements at
    // depth+1 (until the depth drops back to the parent's).
    internal dynamic u32[0 max] Depths;
    // Per-statement expression-node high-water mark: the shared tree's node count
    // recorded just before statement `i`'s expression was built. Because each
    // statement's expression is built immediately before the statement is
    // appended (in pre-order), statement `i` owns the expression nodes in the
    // range `(ExprStarts[i], ExprStarts[i+1]]` (or `(ExprStarts[i], total]` for
    // the last), letting a reference be attributed to its owning statement.
    internal dynamic u32[0 max] ExprStarts;
    // Per-statement lexical scope id: every statement directly inside one block
    // shares a scope id; a nested block (an `if`/loop/`switch`/bare-block body, or
    // a switch section) gets a fresh child scope. This is the exact block model
    // (two locals are in the same block iff same scope id), replacing the
    // depth-heuristic that mis-handled sibling arms.
    internal dynamic u32[0 max] ScopeIds;
    // Per-scope-id parent scope id (indexed by scope id; the root scope is its own
    // parent). Used to test scope ancestry for reference visibility.
    internal dynamic u32[0 max] ScopeParents;
    // The next scope id to hand out.
    u32[0 max] NextScopeId;
    // The shared expression tree all statements' expressions are built into.
    internal ExprTree Expressions;

    StatementList()
    {
        self.Kinds = new();
        self.StartTokens = new();
        self.EndTokens = new();
        self.NameTokens = new();
        self.TypeTokens = new();
        self.TypeHeads = new();
        self.ExprRoots = new();
        self.Depths = new();
        self.ExprStarts = new();
        self.ScopeIds = new();
        self.ScopeParents = new();
        self.NextScopeId = 0;
        self.Expressions = new();
    }

    // Allocates a fresh scope id whose parent is `parentScopeId`, recording the
    // parent link. The first allocation (the root) should pass its own id (0).
    internal fn u32[0 max] AllocateScope(mut borrow StatementList self, u32[0 max] parentScopeId)
    {
        if (!self.ScopeParents.TryReserve(1))
        {
            return 0;
        }

        stack u32[0 max] id = self.NextScopeId;
        init self.ScopeParents[self.ScopeParents.Length] = parentScopeId;
        self.NextScopeId = (u32[0 max])(id + 1);
        return id;
    }

    // The lexical scope id of statement `index` (0 when out of range).
    public law u32[0 max] ScopeIdAt(borrow StatementList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] scopeId = 0;
        if (index < self.ScopeIds.Length)
        {
            scopeId = self.ScopeIds[index];
        }

        return scopeId;
    }

    // The parent scope id of scope `scopeId` (itself when out of range / root).
    public law u32[0 max] ScopeParentAt(borrow StatementList self, u32[0 max] scopeId)
    {
        stack mut u32[0 max] parent = scopeId;
        if ((u64[0 2 ** 63 - 1])scopeId < self.ScopeParents.Length)
        {
            parent = self.ScopeParents[(u64[0 2 ** 63 - 1])scopeId];
        }

        return parent;
    }

    // The number of allocated scopes (an upper bound on scope-tree depth).
    public inline finite law u64[0 2 ** 63 - 1] ScopeCount(borrow StatementList self)
    {
        return self.ScopeParents.Length;
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow StatementList self)
    {
        return self.Kinds.Length;
    }

    public law StatementItem ItemAt(borrow StatementList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut StatementItem item = new();
        if (index < self.Kinds.Length)
        {
            item.Kind = self.Kinds[index];
            if (index < self.StartTokens.Length)
            {
                item.StartToken = self.StartTokens[index];
            }

            if (index < self.EndTokens.Length)
            {
                item.EndToken = self.EndTokens[index];
            }

            if (index < self.NameTokens.Length)
            {
                item.NameToken = self.NameTokens[index];
            }

            if (index < self.TypeTokens.Length)
            {
                item.TypeToken = self.TypeTokens[index];
            }

            if (index < self.TypeHeads.Length)
            {
                item.TypeHead = self.TypeHeads[index];
            }
        }

        return item;
    }

    // The expression-tree root node of statement `index`, or 0 when it has none.
    public law u32[0 max] ExprRootAt(borrow StatementList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] root = 0;
        if (index < self.ExprRoots.Length)
        {
            root = self.ExprRoots[index];
        }

        return root;
    }

    // The kind of expression node `node` in the shared expression tree.
    public law ExprKind ExprKindAt(borrow StatementList self, u32[0 max] node)
    {
        return self.Expressions.NodeKindAt(node);
    }

    // The number of nodes in the shared expression tree (across all statements).
    // Node indices are 1-based, so valid nodes are `1 ..= ExprNodeCount`.
    public inline finite law u64[0 2 ** 63 - 1] ExprNodeCount(borrow StatementList self)
    {
        return self.Expressions.Count();
    }

    // The source token of expression node `node` in the shared expression tree.
    public law u32[0 max] ExprTokenAt(borrow StatementList self, u32[0 max] node)
    {
        return self.Expressions.TokenAt(node);
    }

    // The left/right child node of expression node `node` (0 when none).
    public law u32[0 max] ExprLeftAt(borrow StatementList self, u32[0 max] node)
    {
        return self.Expressions.LeftAt(node);
    }

    public law u32[0 max] ExprRightAt(borrow StatementList self, u32[0 max] node)
    {
        return self.Expressions.RightAt(node);
    }

    // The auxiliary child of expression node `node` (currently the else-branch
    // of a conditional expression), or 0 when none.
    public law u32[0 max] ExprAuxAt(borrow StatementList self, u32[0 max] node)
    {
        return self.Expressions.AuxAt(node);
    }

    // The argument count carried by a `Call` expression node, or 0 for non-calls.
    public law u32[0 max] ExprCallArgCountAt(borrow StatementList self, u32[0 max] node)
    {
        return self.Expressions.CallArgCount(node);
    }

    // The 1-based expression node of a `Call`/`New` argument, or 0 when the
    // expression is not a call/new node or `arg` is out of range.
    public law u32[0 max] ExprCallArgAt(borrow StatementList self, u32[0 max] node, u32[0 max] arg)
    {
        return self.Expressions.CallArgAt(node, arg);
    }

    // The block nesting depth of statement `index` (0 at the function-body top
    // level).
    public law u32[0 max] DepthAt(borrow StatementList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] depth = 0;
        if (index < self.Depths.Length)
        {
            depth = self.Depths[index];
        }

        return depth;
    }

    // The expression-node high-water mark recorded before statement `index`'s
    // expression was built; statement `index` owns nodes in the half-open range
    // after this value up to the next statement's start (or the total node count).
    public law u32[0 max] ExprStartAt(borrow StatementList self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] start = 0;
        if (index < self.ExprStarts.Length)
        {
            start = self.ExprStarts[index];
        }

        return start;
    }

    internal fn System.Memory.MemoryStatus Append(mut borrow StatementList self, StatementItem item, u32[0 max] exprRoot, u32[0 max] depth, u32[0 max] exprStart, u32[0 max] scopeId)
    {
        if (!self.Kinds.TryReserve(1)
            || !self.StartTokens.TryReserve(1)
            || !self.EndTokens.TryReserve(1)
            || !self.NameTokens.TryReserve(1)
            || !self.TypeTokens.TryReserve(1)
            || !self.TypeHeads.TryReserve(1)
            || !self.ExprRoots.TryReserve(1)
            || !self.Depths.TryReserve(1)
            || !self.ExprStarts.TryReserve(1)
            || !self.ScopeIds.TryReserve(1))
        {
            return System.Memory.MemoryStatus.Err(System.Memory.MemoryError.OutOfMemory);
        }

        init self.Kinds[self.Kinds.Length] = item.Kind;
        init self.StartTokens[self.StartTokens.Length] = item.StartToken;
        init self.EndTokens[self.EndTokens.Length] = item.EndToken;
        init self.NameTokens[self.NameTokens.Length] = item.NameToken;
        init self.TypeTokens[self.TypeTokens.Length] = item.TypeToken;
        init self.TypeHeads[self.TypeHeads.Length] = item.TypeHead;
        init self.ExprRoots[self.ExprRoots.Length] = exprRoot;
        init self.Depths[self.Depths.Length] = depth;
        init self.ExprStarts[self.ExprStarts.Length] = exprStart;
        init self.ScopeIds[self.ScopeIds.Length] = scopeId;
        return System.Memory.MemoryStatus.Ok;
    }
}

// Classifies a statement by its leading token. Local-storage keywords open a
// local declaration; control-flow keywords map to their kind; anything else is
// an expression or assignment statement.
finite law StatementKind ClassifyStatementKind(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Return:
            return StatementKind.Return;
        case TokenKind.Become:
            return StatementKind.Become;
        case TokenKind.If:
            return StatementKind.If;
        case TokenKind.While:
            return StatementKind.While;
        case TokenKind.For:
            return StatementKind.For;
        case TokenKind.Switch:
            return StatementKind.Switch;
        case TokenKind.Break:
            return StatementKind.Break;
        case TokenKind.Continue:
            return StatementKind.Continue;
        case TokenKind.Unsafe:
            return StatementKind.Unsafe;
        case TokenKind.LBrace:
            return StatementKind.Block;
        case TokenKind.Stack:
            return StatementKind.Local;
        case TokenKind.Heap:
            return StatementKind.Local;
        case TokenKind.Register:
            return StatementKind.Local;
        case TokenKind.Static:
            return StatementKind.Local;
        case TokenKind.Arena:
            return StatementKind.Local;
        case TokenKind.Const:
            return StatementKind.Local;
        default:
            return StatementKind.Expression;
    }
}

// Returns the last token of the statement starting at `start`: the matching `}`
// of its first brace body (continuing across `else`/`else if` chains), or the
// terminating `;` for a brace-less statement, or end-of-file. Brace counting is
// over tokens, so braces inside literals never interfere. A parenthesized header
// (`if (...)`, `while (...)`, `for (init; cond; iter)`) is skipped via paren
// depth, so a brace or `;` inside it (an object initializer in a condition, or
// the for-header separators) is not mistaken for the body or its terminator.
finite law u32[0 max] SkipStatementBody(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    stack mut u32[0 max] parenDepth = 0;
    stack mut bool sawBrace = false;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.LParen)
        {
            parenDepth = (u32[0 max])(parenDepth + 1);
        }
        else if (kind == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = (u32[0 max])(parenDepth - 1);
            }
        }
        else if (parenDepth == 0 && kind == TokenKind.LBrace)
        {
            depth = (u32[0 max])(depth + 1);
            sawBrace = true;
        }
        else if (parenDepth == 0 && kind == TokenKind.RBrace)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }

            if (depth == 0 && sawBrace)
            {
                if (stream.KindAt((u64[0 2 ** 63 - 1])(index + 1)) == TokenKind.Else)
                {
                    sawBrace = false;
                    index = (u32[0 max])(index + 1);
                    continue;
                }

                return index;
            }
        }
        else if (parenDepth == 0 && kind == TokenKind.Semi && depth == 0 && !sawBrace)
        {
            // A brace-less arm ends at its `;`, but if an `else` follows it is an
            // `if`/`else-if` arm whose chain continues (e.g.
            // `... else if (z) y = 2; else { ... }`), so keep scanning.
            if (stream.KindAt((u64[0 2 ** 63 - 1])(index + 1)) == TokenKind.Else)
            {
                index = (u32[0 max])(index + 1);
                continue;
            }

            return index;
        }

        index = (u32[0 max])(index + 1);
    }

    return index;
}

// True for a token that can begin a type: a user-type identifier or one of the
// built-in scalar type tokens. Used to find a parameter/local's type-primary
// token (the first such token at bracket depth 0).
public finite law bool IsTypeStartToken(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Identifier:
            return true;
        case TokenKind.IntegerType:
            return true;
        case TokenKind.FloatType:
            return true;
        case TokenKind.Bool:
            return true;
        case TokenKind.Void:
            return true;
        case TokenKind.AsciiView:
            return true;
        case TokenKind.UnicodeView:
            return true;
        case TokenKind.AsciiOwned:
            return true;
        case TokenKind.UnicodeOwned:
            return true;
        case TokenKind.Fnptr:
            return true;
        case TokenKind.Closure:
            return true;
        default:
            return false;
    }
}

// True for a statement that introduces a brace-delimited block whose body
// statements are sub-parsed at depth + 1.
finite law bool IsBlockStatement(StatementKind kind)
{
    switch (kind)
    {
        case StatementKind.If:
            return true;
        case StatementKind.While:
            return true;
        case StatementKind.For:
            return true;
        case StatementKind.Switch:
            return true;
        case StatementKind.Unsafe:
            return true;
        case StatementKind.Block:
            return true;
        default:
            return false;
    }
}

// The token index of the `:` that ends a `case <pattern>... :` / `default :`
// switch-section label beginning at `start`. The label is `pattern (or pattern)*
// (when expression)? :`, so the colon is found past three traps that a naive
// "first `:` at bracket depth 0" hits:
//   * `(`/`[`/`{` always nest (balanced) — a `:` inside a named-field payload
//     `{ a: p }` is skipped.
//   * `<`/`>` are angle brackets ONLY in the pattern region (generic types like
//     `List<u32>`); after a depth-0 `when` the guard is an expression where `<`,
//     `>`, `<<`, `>>` are relational/shift OPERATORS and must not change depth.
//   * a `when` guard may be a ternary `c ? a : b`, whose `:` is a branch separator,
//     not the label colon — track unmatched `?` and consume the matching `:`.
// Returns `start` if no label colon is found.
finite law u32[0 max] FindSwitchLabelColon(borrow TokenStream stream, u32[0 max] start)
{
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] bracketDepth = 0;
    stack mut u32[0 max] angleDepth = 0;
    stack mut u32[0 max] ternaryDepth = 0;
    stack mut bool seenWhen = false;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (kind == TokenKind.EndOfFile)
        {
            return start;
        }

        if (kind == TokenKind.LParen || kind == TokenKind.LBrack || kind == TokenKind.LBrace)
        {
            bracketDepth = (u32[0 max])(bracketDepth + 1);
        }
        else if (kind == TokenKind.RParen || kind == TokenKind.RBrack || kind == TokenKind.RBrace)
        {
            if (bracketDepth > 0)
            {
                bracketDepth = (u32[0 max])(bracketDepth - 1);
            }
        }
        else if (kind == TokenKind.When && bracketDepth == 0 && angleDepth == 0)
        {
            seenWhen = true;
        }
        else if (!seenWhen && kind == TokenKind.Lt)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (!seenWhen && kind == TokenKind.Gt)
        {
            if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }
        else if (seenWhen && kind == TokenKind.Question && bracketDepth == 0)
        {
            ternaryDepth = (u32[0 max])(ternaryDepth + 1);
        }
        else if (kind == TokenKind.Colon && bracketDepth == 0 && angleDepth == 0)
        {
            if (seenWhen && ternaryDepth > 0)
            {
                // The `:` of a `c ? a : b` ternary branch in the guard.
                ternaryDepth = (u32[0 max])(ternaryDepth - 1);
            }
            else
            {
                return index;
            }
        }

        index = (u32[0 max])(index + 1);
    }

    return start;
}

// Parses a `case` label's pattern region `[patternStart, colon)` for the references
// and bindings it introduces, appending them into `list` at `depth`/`scope` (the
// section scope). Mirrors the host `CheckSwitchStatement`: each `var Identifier`
// pattern binding becomes a `Local`, and a `when <expression>` guard (if present)
// becomes an `Expression` (parsed after the bindings, so it sees them). Constant /
// enum-case / type pattern references are not resolved by this slice.
internal fn System.Memory.MemoryStatus ParseCaseLabel(borrow TokenStream stream, mut borrow StatementList list, u32[0 max] patternStart, u32[0 max] colon, u32[0 max] depth, u32[0 max] scope)
{
    // Locate a `when` guard at bracket/paren/brace/angle depth 0; the patterns are
    // everything before it (or before the colon when there is no guard).
    stack mut u32[0 max] whenToken = 0;
    stack mut u32[0 max] guardScan = patternStart;
    stack mut u32[0 max] guardDepth = 0;
    while willexit (guardScan < colon)
    {
        stack TokenKind gk = stream.KindAt((u64[0 2 ** 63 - 1])guardScan);
        if (gk == TokenKind.Lt || gk == TokenKind.LParen || gk == TokenKind.LBrack || gk == TokenKind.LBrace)
        {
            guardDepth = (u32[0 max])(guardDepth + 1);
        }
        else if (gk == TokenKind.Gt || gk == TokenKind.RParen || gk == TokenKind.RBrack || gk == TokenKind.RBrace)
        {
            if (guardDepth > 0)
            {
                guardDepth = (u32[0 max])(guardDepth - 1);
            }
        }
        else if (gk == TokenKind.When && guardDepth == 0)
        {
            whenToken = guardScan;
            break;
        }

        guardScan = (u32[0 max])(guardScan + 1);
    }

    stack mut u32[0 max] patternEnd = colon;
    if (whenToken != 0)
    {
        patternEnd = whenToken;
    }

    // Each `var Identifier` (at any nesting, e.g. `Foo(var x)`) binds a `Local`.
    stack mut u32[0 max] bindScan = patternStart;
    while willexit (bindScan < patternEnd)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])bindScan) == TokenKind.Var)
        {
            stack u32[0 max] nameToken = (u32[0 max])(bindScan + 1);
            if (nameToken < patternEnd && stream.KindAt((u64[0 2 ** 63 - 1])nameToken) == TokenKind.Identifier)
            {
                stack u32[0 max] bindExprStart = (u32[0 max])list.Expressions.Count();
                stack mut StatementItem bindItem = new();
                bindItem.Kind = StatementKind.PatternBinding;
                bindItem.StartToken = bindScan;
                bindItem.EndToken = nameToken;
                bindItem.NameToken = nameToken;
                bindItem.TypeToken = 0;
                switch (list.Append(bindItem, 0, depth, bindExprStart, scope))
                {
                    case System.Memory.MemoryStatus.Err(var bindError):
                        return System.Memory.MemoryStatus.Err(bindError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        bindScan = (u32[0 max])(bindScan + 1);
    }

    // The `when` guard expression resolves in the section scope after the bindings.
    if (whenToken != 0 && (u32[0 max])(whenToken + 1) < colon)
    {
        stack u32[0 max] guardExprStart = (u32[0 max])list.Expressions.Count();
        stack ExprParse guard = ParseAssignment(stream, list.Expressions, (u32[0 max])(whenToken + 1));
        stack mut StatementItem guardItem = new();
        guardItem.Kind = StatementKind.Expression;
        guardItem.StartToken = (u32[0 max])(whenToken + 1);
        guardItem.EndToken = colon;
        switch (list.Append(guardItem, guard.Node, depth, guardExprStart, scope))
        {
            case System.Memory.MemoryStatus.Err(var guardError):
                return System.Memory.MemoryStatus.Err(guardError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Parses the comma-separated expressions of a C-style `for` expression-list clause
// (an `expressionList` `forInitializer` or the `forIterator`) in the half-open
// token range `[startPos, endExclusive)`, appending each as an `Expression`
// statement at `depth`/`scope` so its references resolve (matching the host, which
// evaluates every such expression). An empty range appends nothing.
internal fn System.Memory.MemoryStatus ParseForClause(borrow TokenStream stream, mut borrow StatementList list, u32[0 max] startPos, u32[0 max] endExclusive, u32[0 max] depth, u32[0 max] scope)
{
    stack mut u32[0 max] pos = startPos;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        if (pos >= endExclusive)
        {
            break;
        }

        // Skip a leading or separating comma between expressions.
        if (stream.KindAt((u64[0 2 ** 63 - 1])pos) == TokenKind.Comma)
        {
            pos = (u32[0 max])(pos + 1);
            continue;
        }

        stack u32[0 max] exprStart = (u32[0 max])list.Expressions.Count();
        stack ExprParse parsed = ParseAssignment(stream, list.Expressions, pos);
        stack mut StatementItem item = new();
        item.Kind = StatementKind.Expression;
        item.StartToken = pos;
        item.EndToken = endExclusive;
        switch (list.Append(item, parsed.Node, depth, exprStart, scope))
        {
            case System.Memory.MemoryStatus.Err(var clauseError):
                return System.Memory.MemoryStatus.Err(clauseError);
            case System.Memory.MemoryStatus.Ok:
        }

        // Advance past the parsed expression; `+1` guarantees progress if it stalls.
        if (parsed.Pos > pos)
        {
            pos = parsed.Pos;
        }
        else
        {
            pos = (u32[0 max])(pos + 1);
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// Sub-parses a `for` loop's body — the first `{` after the header's matching `)`
// (`headerClose`), in a fresh child scope of `forScope` — into `list`. Shared by
// both `for` forms. A loop with no brace body (none found before `forEnd`) appends
// nothing.
internal fn System.Memory.MemoryStatus ParseForBody(borrow TokenStream stream, mut borrow StatementList list, u32[0 max] headerClose, u32[0 max] forEnd, u32[0 max] depth, u32[0 max] forScope)
{
    if (headerClose == 0)
    {
        return System.Memory.MemoryStatus.Ok;
    }

    stack mut u32[0 max] bodyOpen = (u32[0 max])(headerClose + 1);
    stack mut bool foundBody = false;
    stack mut u64[0 2 ** 63 - 1] bodyGuard = stream.Count();
    while willexit (bodyGuard > 0)
    {
        bodyGuard = (u64[0 2 ** 63 - 1])(bodyGuard - 1);
        if (bodyOpen > forEnd)
        {
            break;
        }

        if (stream.KindAt((u64[0 2 ** 63 - 1])bodyOpen) == TokenKind.LBrace)
        {
            foundBody = true;
            break;
        }

        bodyOpen = (u32[0 max])(bodyOpen + 1);
    }

    if (foundBody)
    {
        stack u32[0 max] bodyScope = list.AllocateScope(forScope);
        switch (ParseBlock(stream, list, bodyOpen, (u32[0 max])(depth + 1), bodyScope))
        {
            case System.Memory.MemoryStatus.Err(var bodyError):
                return System.Memory.MemoryStatus.Err(bodyError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return System.Memory.MemoryStatus.Ok;
}

// The last identifier token at angle/bracket/paren depth 0 in the half-open token
// range `[start, endExclusive)`. Returns 0 when the range holds no such token. Used
// to extract a for-each binding's name (the identifier before the `in`/comma)
// without the `=`/`;` terminator that `FindVariableName` relies on.
finite law u32[0 max] BoundedLastIdentifier(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] nameToken = 0;
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    while willexit (index < endExclusive)
    {
        stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (k == TokenKind.Lt || k == TokenKind.LBrack || k == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (k == TokenKind.Gt || k == TokenKind.RBrack || k == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (k == TokenKind.Identifier && depth == 0)
        {
            nameToken = index;
        }

        index = (u32[0 max])(index + 1);
    }

    return nameToken;
}

// The first type-start token at angle/bracket/paren depth 0 in `[start, endExclusive)`
// (the bounded analogue of `FindVariableTypeToken`'s type-head capture), or 0.
finite law u32[0 max] BoundedFirstTypeStart(borrow TokenStream stream, u32[0 max] start, u32[0 max] endExclusive)
{
    stack mut u32[0 max] typeToken = 0;
    stack mut u32[0 max] index = start;
    stack mut u32[0 max] depth = 0;
    while willexit (index < endExclusive)
    {
        stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])index);
        if (k == TokenKind.Lt || k == TokenKind.LBrack || k == TokenKind.LParen)
        {
            depth = (u32[0 max])(depth + 1);
        }
        else if (k == TokenKind.Gt || k == TokenKind.RBrack || k == TokenKind.RParen)
        {
            if (depth > 0)
            {
                depth = (u32[0 max])(depth - 1);
            }
        }
        else if (depth == 0 && typeToken == 0 && IsTypeStartToken(k))
        {
            typeToken = index;
        }

        index = (u32[0 max])(index + 1);
    }

    return typeToken;
}

// Parses a `for` loop whose span is `[forStart, forEnd]`. The loop gets its own
// scope (`forScope`, a child of `scopeId`) holding its bound variables, with the
// body as a further child scope. Two forms (per `Stark.g4` `forStatement`):
//   * C-style `for B (init; cond; iter)`: a storage-class-led init declares a
//     `Local` in `forScope` (an `expressionList` init is parsed as `Expression`s
//     instead); the condition is the `For` statement's expression (also in
//     `forScope`, so it sees the loop variable); and the iterator clause is parsed
//     as `Expression`s in `forScope` (at `depth + 1` so the `For` stays the
//     enclosing loop for `break`/`continue`).
//   * for-each `for B (type element in collection)` (optionally `storage type idx,`
//     first): the element (and index) are declared as `Local`s in `forScope` and
//     the traversal collection is the `ForEach` statement's expression — there is
//     no boolean condition, hence the distinct `ForEach` kind. The collection is
//     attributed to the enclosing `scopeId` (the host evaluates it before the
//     bindings exist), so it cannot see the loop's own element/index.
internal fn System.Memory.MemoryStatus ParseForStatement(borrow TokenStream stream, mut borrow StatementList list, u32[0 max] forStart, u32[0 max] forEnd, u32[0 max] depth, u32[0 max] scopeId)
{
    stack u32[0 max] forScope = list.AllocateScope(scopeId);

    // Locate the header `(`, the matching `)`, the two depth-1 `;` separators
    // (C-style), and — for a for-each — the `in` keyword and the index-separator
    // `,` that precedes it (both at paren depth 1 and angle/bracket depth 0, so a
    // generic element type like `Map<u32, u64> x` does not mis-trigger them).
    stack mut u32[0 max] headerOpen = 0;
    stack mut u32[0 max] firstSemi = 0;
    stack mut u32[0 max] secondSemi = 0;
    stack mut u32[0 max] headerClose = 0;
    stack mut u32[0 max] inToken = 0;
    stack mut u32[0 max] indexComma = 0;
    stack mut u32[0 max] parenDepth = 0;
    stack mut u32[0 max] angleDepth = 0;
    stack mut bool headerDone = false;
    stack mut u32[0 max] scan = forStart;
    while willexit (scan <= forEnd && !headerDone)
    {
        stack TokenKind k = stream.KindAt((u64[0 2 ** 63 - 1])scan);
        if (k == TokenKind.LParen)
        {
            if (headerOpen == 0)
            {
                headerOpen = scan;
            }

            parenDepth = (u32[0 max])(parenDepth + 1);
        }
        else if (k == TokenKind.RParen)
        {
            if (parenDepth > 0)
            {
                parenDepth = (u32[0 max])(parenDepth - 1);
                if (parenDepth == 0)
                {
                    headerClose = scan;
                    headerDone = true;
                }
            }
        }
        else if (k == TokenKind.Lt || k == TokenKind.LBrack)
        {
            angleDepth = (u32[0 max])(angleDepth + 1);
        }
        else if (k == TokenKind.Gt || k == TokenKind.RBrack)
        {
            if (angleDepth > 0)
            {
                angleDepth = (u32[0 max])(angleDepth - 1);
            }
        }
        else if (k == TokenKind.Semi && parenDepth == 1)
        {
            if (firstSemi == 0)
            {
                firstSemi = scan;
            }
            else if (secondSemi == 0)
            {
                secondSemi = scan;
            }
        }
        else if (k == TokenKind.In && parenDepth == 1 && angleDepth == 0)
        {
            if (inToken == 0)
            {
                inToken = scan;
            }
        }
        else if (k == TokenKind.Comma && parenDepth == 1 && angleDepth == 0)
        {
            if (inToken == 0 && indexComma == 0)
            {
                indexComma = scan;
            }
        }

        scan = (u32[0 max])(scan + 1);
    }

    // The for-each form binds its element (and optional index) and parses the
    // traversal collection as the `ForEach` statement's expression.
    if (headerOpen != 0 && inToken != 0)
    {
        stack mut u32[0 max] elementStart = (u32[0 max])(headerOpen + 1);
        if (indexComma != 0 && (u32[0 max])(headerOpen + 1) < indexComma)
        {
            stack u32[0 max] idxStart = (u32[0 max])(headerOpen + 1);
            stack u32[0 max] idxName = BoundedLastIdentifier(stream, idxStart, indexComma);
            if (idxName != 0)
            {
                stack u32[0 max] idxExprStart = (u32[0 max])list.Expressions.Count();
                stack mut StatementItem idxItem = new();
                idxItem.Kind = StatementKind.Local;
                idxItem.StartToken = idxStart;
                idxItem.EndToken = indexComma;
                idxItem.NameToken = idxName;
                idxItem.TypeToken = BoundedFirstTypeStart(stream, idxStart, indexComma);
                // The index binding is `storageClass type Identifier`, so the type
                // head is the rightmost identifier before the name (after the class).
                idxItem.TypeHead = BoundedLastIdentifier(stream, (u32[0 max])(idxStart + 1), idxName);
                switch (list.Append(idxItem, 0, depth, idxExprStart, forScope))
                {
                    case System.Memory.MemoryStatus.Err(var idxError):
                        return System.Memory.MemoryStatus.Err(idxError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            elementStart = (u32[0 max])(indexComma + 1);
        }

        if (elementStart < inToken)
        {
            stack u32[0 max] elemName = BoundedLastIdentifier(stream, elementStart, inToken);
            if (elemName != 0)
            {
                stack u32[0 max] elemExprStart = (u32[0 max])list.Expressions.Count();
                stack mut StatementItem elemItem = new();
                elemItem.Kind = StatementKind.Local;
                elemItem.StartToken = elementStart;
                elemItem.EndToken = inToken;
                elemItem.NameToken = elemName;
                elemItem.TypeToken = BoundedFirstTypeStart(stream, elementStart, inToken);
                // The element binding is `type Identifier` (no storage class), so the
                // type head is the rightmost identifier before the name.
                elemItem.TypeHead = BoundedLastIdentifier(stream, elementStart, elemName);
                switch (list.Append(elemItem, 0, depth, elemExprStart, forScope))
                {
                    case System.Memory.MemoryStatus.Err(var elemError):
                        return System.Memory.MemoryStatus.Err(elemError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }

        // The traversal collection (after `in`, before `)`) becomes the statement's
        // expression so its references resolve; it is not a boolean condition. The
        // host (CheckForTraversal) evaluates the collection in the ENCLOSING scope
        // BEFORE declaring the element/index, so the `ForEach` statement is attributed
        // to `scopeId` (not `forScope`): the loop's own element/index — which live in
        // `forScope`, a child of `scopeId` — are therefore not visible to the
        // collection (`for w (u32 x in x)` leaves the collection `x` unbound), while
        // an outer binding or enclosing loop's variable still resolves.
        stack u32[0 max] travExprStart = (u32[0 max])list.Expressions.Count();
        stack mut u32[0 max] travRoot = 0;
        if (headerClose != 0 && (u32[0 max])(inToken + 1) < headerClose)
        {
            stack ExprParse traversal = ParseAssignment(stream, list.Expressions, (u32[0 max])(inToken + 1));
            travRoot = traversal.Node;
        }

        stack mut StatementItem forEachItem = new();
        forEachItem.Kind = StatementKind.ForEach;
        forEachItem.StartToken = forStart;
        forEachItem.EndToken = forEnd;
        switch (list.Append(forEachItem, travRoot, depth, travExprStart, scopeId))
        {
            case System.Memory.MemoryStatus.Err(var forEachError):
                return System.Memory.MemoryStatus.Err(forEachError);
            case System.Memory.MemoryStatus.Ok:
        }

        return ParseForBody(stream, list, headerClose, forEnd, depth, forScope);
    }

    // A storage-class-led init declares the loop variable in `forScope`.
    if (headerOpen != 0 && firstSemi != 0 && (u32[0 max])(headerOpen + 1) < firstSemi)
    {
        stack u32[0 max] initStart = (u32[0 max])(headerOpen + 1);
        if (ClassifyStatementKind(stream.KindAt((u64[0 2 ** 63 - 1])initStart)) == StatementKind.Local)
        {
            stack u32[0 max] initName = FindVariableName(stream, (u32[0 max])(initStart + 1));
            if (initName != 0)
            {
                stack u32[0 max] initExprStart = (u32[0 max])list.Expressions.Count();
                // Parse the initializer (after `=`, before the first `;`) so its
                // references resolve; nodes precede the condition's, keeping the
                // node order aligned with statement pre-order.
                stack mut u32[0 max] initRoot = 0;
                stack mut u32[0 max] initAssign = initStart;
                stack mut bool foundInitAssign = false;
                while willexit (initAssign < firstSemi)
                {
                    if (stream.KindAt((u64[0 2 ** 63 - 1])initAssign) == TokenKind.Assign)
                    {
                        foundInitAssign = true;
                        break;
                    }

                    initAssign = (u32[0 max])(initAssign + 1);
                }

                if (foundInitAssign)
                {
                    stack ExprParse initializer = ParseAssignment(stream, list.Expressions, (u32[0 max])(initAssign + 1));
                    initRoot = initializer.Node;
                }

                stack mut StatementItem initItem = new();
                initItem.Kind = StatementKind.Local;
                initItem.StartToken = initStart;
                initItem.EndToken = firstSemi;
                initItem.NameToken = initName;
                initItem.TypeToken = FindVariableTypeToken(stream, (u32[0 max])(initStart + 1));
                initItem.TypeHead = BoundedLastIdentifier(stream, (u32[0 max])(initStart + 1), initName);
                switch (list.Append(initItem, initRoot, depth, initExprStart, forScope))
                {
                    case System.Memory.MemoryStatus.Err(var initError):
                        return System.Memory.MemoryStatus.Err(initError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }
        }
        else
        {
            // An `expressionList` initializer (e.g. `i = h()`): parse each expression
            // so its references resolve, in `forScope` before the `For` statement.
            switch (ParseForClause(stream, list, initStart, firstSemi, depth, forScope))
            {
                case System.Memory.MemoryStatus.Err(var initExprError):
                    return System.Memory.MemoryStatus.Err(initExprError);
                case System.Memory.MemoryStatus.Ok:
            }
        }
    }

    // The condition (between the two `;`) is the `For` statement's expression.
    stack u32[0 max] condExprStart = (u32[0 max])list.Expressions.Count();
    stack mut u32[0 max] condRoot = 0;
    if (firstSemi != 0 && secondSemi != 0 && (u32[0 max])(firstSemi + 1) < secondSemi)
    {
        stack ExprParse cond = ParseAssignment(stream, list.Expressions, (u32[0 max])(firstSemi + 1));
        condRoot = cond.Node;
    }

    stack mut StatementItem forItem = new();
    forItem.Kind = StatementKind.For;
    forItem.StartToken = forStart;
    forItem.EndToken = forEnd;
    switch (list.Append(forItem, condRoot, depth, condExprStart, forScope))
    {
        case System.Memory.MemoryStatus.Err(var forError):
            return System.Memory.MemoryStatus.Err(forError);
        case System.Memory.MemoryStatus.Ok:
    }

    // The iterator clause (after the second `;`, before `)`): each expression is
    // parsed in `forScope` so its references resolve (it sees the init local). It is
    // emitted at `depth + 1` so the `For` statement remains the nearest enclosing
    // loop at `depth` for a `break`/`continue` in the body.
    if (secondSemi != 0 && headerClose != 0 && (u32[0 max])(secondSemi + 1) < headerClose)
    {
        switch (ParseForClause(stream, list, (u32[0 max])(secondSemi + 1), headerClose, (u32[0 max])(depth + 1), forScope))
        {
            case System.Memory.MemoryStatus.Err(var iterError):
                return System.Memory.MemoryStatus.Err(iterError);
            case System.Memory.MemoryStatus.Ok:
        }
    }

    return ParseForBody(stream, list, headerClose, forEnd, depth, forScope);
}

// Recursively appends the statements of the block whose opening `{` is
// `openBrace`, at nesting `depth`, into `list` in pre-order. A `case`/`default`
// label is recorded as a `Case` statement at `depth` and shifts the section's
// following statements one level deeper (so locals in distinct sections are
// distinct blocks). A block statement is appended, then each of its brace bodies
// (the then-arm and `else`/`else if` arms of an `if`, the body of a loop/`switch`/
// `unsafe`) is sub-parsed at depth + 1; a leading parenthesized header is skipped
// so a brace inside it is not mistaken for the body.
internal fn System.Memory.MemoryStatus ParseBlock(borrow TokenStream stream, mut borrow StatementList list, u32[0 max] openBrace, u32[0 max] depth, u32[0 max] scopeId)
{
    stack mut u32[0 max] index = (u32[0 max])(openBrace + 1);
    // The depth for the section's statements: `depth` until a `case`/`default`
    // label is seen, then `depth + 1` (labels themselves stay at `depth`).
    stack mut u32[0 max] sectionDepth = depth;
    // The scope for the current statements: this block's `scopeId` until a
    // `case`/`default` label opens a fresh section scope (a child of `scopeId`).
    stack mut u32[0 max] sectionScope = scopeId;
    // Whether we are in a run of consecutive `case`/`default` labels of one section:
    // a switch section is `label+ statement*`, so all labels of a section share one
    // section scope, and the first label after a body statement opens the next.
    stack mut bool labelRun = false;

    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile)
    {
        if (stream.KindAt((u64[0 2 ** 63 - 1])index) == TokenKind.RBrace)
        {
            break;
        }

        stack u32[0 max] statementStart = index;
        stack TokenKind leadKind = stream.KindAt((u64[0 2 ** 63 - 1])statementStart);

        // A switch-section label: record it at the base depth/scope and nest the
        // section's following statements one deeper in a fresh section scope.
        if (leadKind == TokenKind.Case || leadKind == TokenKind.Default)
        {
            stack u32[0 max] colon = FindSwitchLabelColon(stream, statementStart);
            stack u32[0 max] labelStart = (u32[0 max])list.Expressions.Count();
            stack mut StatementItem label = new();
            label.Kind = StatementKind.Case;
            label.StartToken = statementStart;
            label.EndToken = colon;
            switch (list.Append(label, 0, depth, labelStart, scopeId))
            {
                case System.Memory.MemoryStatus.Err(var labelError):
                    return System.Memory.MemoryStatus.Err(labelError);
                case System.Memory.MemoryStatus.Ok:
            }

            // Only the first label of a section opens a fresh section scope; later
            // labels of the same section share it (so a `var` bound in one label is
            // visible to a `when` guard or the body of the section).
            if (!labelRun)
            {
                sectionDepth = (u32[0 max])(depth + 1);
                sectionScope = list.AllocateScope(scopeId);
                labelRun = true;
            }

            // A `case` label's pattern may bind `var` names and carry a `when` guard;
            // both are scoped to the section. (`default` has neither.)
            if (leadKind == TokenKind.Case)
            {
                switch (ParseCaseLabel(stream, list, (u32[0 max])(statementStart + 1), colon, sectionDepth, sectionScope))
                {
                    case System.Memory.MemoryStatus.Err(var patternError):
                        return System.Memory.MemoryStatus.Err(patternError);
                    case System.Memory.MemoryStatus.Ok:
                }
            }

            index = (u32[0 max])(colon + 1);
            continue;
        }

        // A non-label statement ends the current section's label run.
        labelRun = false;

        stack StatementKind kind = ClassifyStatementKind(leadKind);
        stack u32[0 max] statementEnd = SkipStatementBody(stream, statementStart);

        // A `for` gets dedicated handling: its own loop scope holds the init
        // local and the condition, with the body nested as a child scope, so the
        // loop variable resolves in both. This replaces the generic block path.
        if (kind == StatementKind.For)
        {
            switch (ParseForStatement(stream, list, statementStart, statementEnd, sectionDepth, sectionScope))
            {
                case System.Memory.MemoryStatus.Err(var forError):
                    return System.Memory.MemoryStatus.Err(forError);
                case System.Memory.MemoryStatus.Ok:
            }

            index = (u32[0 max])(statementEnd + 1);
            continue;
        }

        // A `return value;` parses the value (the token after `return`, unless
        // the statement is a bare `return;`); an expression statement parses the
        // whole statement; an `if`/`while` parses its condition; a local
        // declaration parses its initializer. All build into the shared tree.
        // The node count just before this statement's expression is its
        // `exprStart`, attributing the nodes built below to this statement.
        stack u32[0 max] exprStart = (u32[0 max])list.Expressions.Count();
        stack mut u32[0 max] exprRoot = 0;
        stack mut u32[0 max] localName = 0;
        stack mut u32[0 max] localType = 0;
        stack mut u32[0 max] localHead = 0;
        if ((kind == StatementKind.Return || kind == StatementKind.Become)
            && stream.KindAt((u64[0 2 ** 63 - 1])(statementStart + 1)) != TokenKind.Semi)
        {
            stack ExprParse terminalExpression = ParseAssignment(stream, list.Expressions, (u32[0 max])(statementStart + 1));
            exprRoot = terminalExpression.Node;
        }
        else if (kind == StatementKind.Expression)
        {
            stack ExprParse expression = ParseAssignment(stream, list.Expressions, statementStart);
            exprRoot = expression.Node;
        }
        else if ((kind == StatementKind.If || kind == StatementKind.While)
            && stream.KindAt((u64[0 2 ** 63 - 1])(statementStart + 1)) == TokenKind.LParen)
        {
            stack ExprParse condition = ParseAssignment(stream, list.Expressions, (u32[0 max])(statementStart + 2));
            exprRoot = condition.Node;
        }
        else if (kind == StatementKind.Switch)
        {
            // The switch subject `(expression)` is the statement's expression. Find
            // the `(` (skipping an optional weight specifier) and parse after it.
            stack mut u32[0 max] subjectOpen = (u32[0 max])(statementStart + 1);
            stack mut bool foundSubject = false;
            stack mut u64[0 2 ** 63 - 1] subjectGuard = stream.Count();
            while willexit (subjectGuard > 0)
            {
                subjectGuard = (u64[0 2 ** 63 - 1])(subjectGuard - 1);
                if (subjectOpen >= statementEnd)
                {
                    break;
                }

                if (stream.KindAt((u64[0 2 ** 63 - 1])subjectOpen) == TokenKind.LParen)
                {
                    foundSubject = true;
                    break;
                }

                subjectOpen = (u32[0 max])(subjectOpen + 1);
            }

            if (foundSubject)
            {
                stack ExprParse subject = ParseAssignment(stream, list.Expressions, (u32[0 max])(subjectOpen + 1));
                exprRoot = subject.Node;
            }
        }
        else if (kind == StatementKind.Local)
        {
            // The declared name is the last identifier before `=`/`;` (after the
            // leading storage-class/`const` keyword).
            localName = FindVariableName(stream, (u32[0 max])(statementStart + 1));
            localType = FindVariableTypeToken(stream, (u32[0 max])(statementStart + 1));
            // The user-type head is the rightmost depth-0 identifier of the type
            // (after the storage class, before the name); 0 for a built-in.
            if (localName != 0)
            {
                localHead = BoundedLastIdentifier(stream, (u32[0 max])(statementStart + 1), localName);
            }

            stack mut u32[0 max] scan = statementStart;
            stack mut bool foundInit = false;
            stack mut u64[0 2 ** 63 - 1] localGuard = stream.Count();
            while willexit (localGuard > 0)
            {
                localGuard = (u64[0 2 ** 63 - 1])(localGuard - 1);
                if (scan >= statementEnd)
                {
                    break;
                }

                if (stream.KindAt((u64[0 2 ** 63 - 1])scan) == TokenKind.Assign)
                {
                    foundInit = true;
                    break;
                }

                scan = (u32[0 max])(scan + 1);
            }

            if (foundInit)
            {
                stack ExprParse initializer = ParseAssignment(stream, list.Expressions, (u32[0 max])(scan + 1));
                exprRoot = initializer.Node;
            }
        }

        stack mut StatementItem item = new();
        item.Kind = kind;
        item.StartToken = statementStart;
        item.EndToken = statementEnd;
        item.NameToken = localName;
        item.TypeToken = localType;
        item.TypeHead = localHead;
        switch (list.Append(item, exprRoot, sectionDepth, exprStart, sectionScope))
        {
            case System.Memory.MemoryStatus.Err(var appendError):
                return System.Memory.MemoryStatus.Err(appendError);
            case System.Memory.MemoryStatus.Ok:
        }

        if (IsBlockStatement(kind))
        {
            // Skip a leading parenthesized header (`if (...)`, `while (...)`,
            // `switch (...)`) so a brace inside it is not taken as the body;
            // `unsafe` has no header. A bare `Block` statement's own `{` (at
            // `statementStart`) is its body, so its scan starts there.
            stack mut u32[0 max] cursor = (u32[0 max])(statementStart + 1);
            if (kind == StatementKind.Block)
            {
                cursor = statementStart;
            }
            else if (stream.KindAt((u64[0 2 ** 63 - 1])cursor) == TokenKind.LParen)
            {
                stack mut u32[0 max] parenDepth = 0;
                stack mut bool headerDone = false;
                while willexit (cursor <= statementEnd && !headerDone)
                {
                    stack TokenKind headerKind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
                    if (headerKind == TokenKind.LParen)
                    {
                        parenDepth = (u32[0 max])(parenDepth + 1);
                    }
                    else if (headerKind == TokenKind.RParen)
                    {
                        if (parenDepth > 0)
                        {
                            parenDepth = (u32[0 max])(parenDepth - 1);
                        }

                        if (parenDepth == 0)
                        {
                            headerDone = true;
                        }
                    }

                    cursor = (u32[0 max])(cursor + 1);
                }
            }

            // Sub-parse every top-level brace arm in the remaining span at
            // `sectionDepth + 1`: the then-/else-/else-if bodies of an `if`, and
            // the single body of a loop/`switch`/`unsafe`. Each arm is its own
            // child scope of this statement's scope, so sibling arms (then/else)
            // are distinct blocks without any boundary marker.
            stack mut u32[0 max] braceDepth = 0;
            stack mut u32[0 max] armOpen = 0;
            stack mut bool inArm = false;
            while willexit (cursor <= statementEnd)
            {
                stack TokenKind armKind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
                if (armKind == TokenKind.LBrace)
                {
                    if (braceDepth == 0)
                    {
                        armOpen = cursor;
                        inArm = true;
                    }

                    braceDepth = (u32[0 max])(braceDepth + 1);
                }
                else if (armKind == TokenKind.RBrace)
                {
                    if (braceDepth > 0)
                    {
                        braceDepth = (u32[0 max])(braceDepth - 1);
                    }

                    if (braceDepth == 0 && inArm)
                    {
                        stack u32[0 max] armScope = list.AllocateScope(sectionScope);
                        switch (ParseBlock(stream, list, armOpen, (u32[0 max])(sectionDepth + 1), armScope))
                        {
                            case System.Memory.MemoryStatus.Err(var blockError):
                                return System.Memory.MemoryStatus.Err(blockError);
                            case System.Memory.MemoryStatus.Ok:
                        }

                        inArm = false;
                    }
                }

                cursor = (u32[0 max])(cursor + 1);
            }
        }

        index = (u32[0 max])(statementEnd + 1);
    }

    return System.Memory.MemoryStatus.Ok;
}

// Parses the statement tree of the block whose opening `{` is `openBrace` into a
// flat pre-order `StatementList` with per-statement nesting depths.
internal fn ParseResult<StatementList> ParseStatements(borrow TokenStream stream, u32[0 max] openBrace)
{
    stack mut StatementList list = new();
    // Allocate the root (function-body) scope; it is its own parent.
    stack u32[0 max] rootScope = list.AllocateScope(0);
    switch (ParseBlock(stream, list, openBrace, 0, rootScope))
    {
        case System.Memory.MemoryStatus.Err(var blockError):
            return ParseResult<StatementList>.Err(ParseError.OutOfMemory);
        case System.Memory.MemoryStatus.Ok:
    }

    return ParseResult<StatementList>.Ok(list);
}

// Parses the statement list of the function whose `fn` keyword is at
// `fnKeyword`, starting at its body's opening `{`. Returns an empty list when
// the function has no body (a `;`-terminated declaration).
public fn ParseResult<StatementList> ParseFunctionBody(borrow TokenStream stream, u32[0 max] fnKeyword)
{
    stack mut u32[0 max] index = fnKeyword;
    while willexit (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.EndOfFile
        && stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        index = (u32[0 max])(index + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])index) != TokenKind.LBrace)
    {
        stack mut StatementList empty = new();
        return ParseResult<StatementList>.Ok(empty);
    }

    return ParseStatements(stream, index);
}

// An expression node kind. Leaves carry a single token; `Unary` has one child
// (`Left`); `Binary` has two (`Left` op `Right`).
public enum ExprKind
{
    IntLiteral,
    FloatLiteral,
    BoolLiteral,
    NullLiteral,
    Identifier,
    Unary,
    Binary,
    // Postfix: `Member` carries the member-name token and the receiver in
    // `Left`; `Call` carries the `(` token and the callee in `Left`; `Index`
    // carries the `[` token, the receiver in `Left`, and the index expression in
    // `Right`.
    Member,
    Call,
    Index,
    // `New` carries the `new` token. `Left` is the optional named type head
    // node, `Right` is the first flat argument slot, and `Aux` is the argument
    // count. `StorageSelector` represents selector tokens such as `arena` in
    // `new(arena, ...)`; they are syntax selectors, not value identifiers.
    New,
    StorageSelector,
    // `Assign` carries the assignment-operator token, the assignment target in
    // `Left`, and the assigned value in `Right`.
    Assign,
    // `Conditional` (ternary `cond ? then : else`) carries the `?` token, the
    // condition in `Left`, the then-branch in `Right`, and the else-branch in
    // `Aux`.
    Conditional,
    Error,
}

// A flat expression tree: nodes are stored in parallel `dynamic` columns and
// referenced by 1-based index (0 means "no node"). `Root` is the index of the
// top expression. This is the `System.Toml`-style flat-node arena, which avoids
// the cross-package `List<T>` drop limitation.
public struct ExprTree
{
    internal dynamic ExprKind Kinds;
    internal dynamic u32[0 max] Tokens;
    internal dynamic u32[0 max] Lefts;
    internal dynamic u32[0 max] Rights;
    // Per-node auxiliary slot: for `Call` and `New` nodes it holds the argument
    // count; for `Conditional` it holds the else-branch node; unused (0) for
    // other kinds.
    internal dynamic u32[0 max] Aux;
    // Flat argument list: a `Call` or `New` node's `Right` is the 1-based index
    // of its first argument node here, and `Aux` is how many it spans.
    internal dynamic u32[0 max] ArgNodes;
    u32[0 max] Root;

    ExprTree()
    {
        self.Kinds = new();
        self.Tokens = new();
        self.Lefts = new();
        self.Rights = new();
        self.Aux = new();
        self.ArgNodes = new();
        self.Root = 0;
    }

    public inline finite law u64[0 2 ** 63 - 1] Count(borrow ExprTree self)
    {
        return self.Kinds.Length;
    }

    public inline finite law u32[0 max] RootNode(borrow ExprTree self)
    {
        return self.Root;
    }

    public law ExprKind NodeKindAt(borrow ExprTree self, u32[0 max] node)
    {
        stack mut ExprKind kind = ExprKind.Error;
        if (node >= 1)
        {
            stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(node - 1);
            if (slot < self.Kinds.Length)
            {
                kind = self.Kinds[slot];
            }
        }

        return kind;
    }

    public law u32[0 max] TokenAt(borrow ExprTree self, u32[0 max] node)
    {
        stack mut u32[0 max] token = 0;
        if (node >= 1)
        {
            stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(node - 1);
            if (slot < self.Tokens.Length)
            {
                token = self.Tokens[slot];
            }
        }

        return token;
    }

    public law u32[0 max] LeftAt(borrow ExprTree self, u32[0 max] node)
    {
        stack mut u32[0 max] child = 0;
        if (node >= 1)
        {
            stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(node - 1);
            if (slot < self.Lefts.Length)
            {
                child = self.Lefts[slot];
            }
        }

        return child;
    }

    public law u32[0 max] RightAt(borrow ExprTree self, u32[0 max] node)
    {
        stack mut u32[0 max] child = 0;
        if (node >= 1)
        {
            stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(node - 1);
            if (slot < self.Rights.Length)
            {
                child = self.Rights[slot];
            }
        }

        return child;
    }

    public law u32[0 max] CallArgCount(borrow ExprTree self, u32[0 max] node)
    {
        stack mut u32[0 max] count = 0;
        if (node >= 1)
        {
            stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(node - 1);
            if (slot < self.Aux.Length)
            {
                count = self.Aux[slot];
            }
        }

        return count;
    }

    // The auxiliary child of `node` (a `Conditional`'s else-branch node), or 0.
    public law u32[0 max] AuxAt(borrow ExprTree self, u32[0 max] node)
    {
        stack mut u32[0 max] child = 0;
        if (node >= 1)
        {
            stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])(node - 1);
            if (slot < self.Aux.Length)
            {
                child = self.Aux[slot];
            }
        }

        return child;
    }

    // The 1-based node index of `Call`/`New` node `node`'s argument `arg`, or 0
    // when out of range.
    public law u32[0 max] CallArgAt(borrow ExprTree self, u32[0 max] node, u32[0 max] arg)
    {
        stack mut u32[0 max] result = 0;
        stack u32[0 max] start = self.RightAt(node);
        if (arg < self.CallArgCount(node) && start >= 1)
        {
            stack u64[0 2 ** 63 - 1] slot = (u64[0 2 ** 63 - 1])((start - 1) + arg);
            if (slot < self.ArgNodes.Length)
            {
                result = self.ArgNodes[slot];
            }
        }

        return result;
    }

    // Appends a node carrying an auxiliary slot, returning its 1-based index, or
    // 0 on allocation failure or when the node count would overflow the index
    // width.
    internal fn u32[0 max] AddRaw(mut borrow ExprTree self, ExprKind kind, u32[0 max] token, u32[0 max] left, u32[0 max] right, u32[0 max] aux)
    {
        stack u64[0 2 ** 63 - 1] slot = self.Kinds.Length;
        if (slot >= (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
        {
            return 0;
        }

        if (!self.Kinds.TryReserve(1)
            || !self.Tokens.TryReserve(1)
            || !self.Lefts.TryReserve(1)
            || !self.Rights.TryReserve(1)
            || !self.Aux.TryReserve(1))
        {
            return 0;
        }

        init self.Kinds[self.Kinds.Length] = kind;
        init self.Tokens[self.Tokens.Length] = token;
        init self.Lefts[self.Lefts.Length] = left;
        init self.Rights[self.Rights.Length] = right;
        init self.Aux[self.Aux.Length] = aux;
        return (u32[0 max])(slot + 1);
    }

    // Appends a node (auxiliary slot zero), returning its 1-based index.
    internal fn u32[0 max] AddNode(mut borrow ExprTree self, ExprKind kind, u32[0 max] token, u32[0 max] left, u32[0 max] right)
    {
        return self.AddRaw(kind, token, left, right, 0);
    }

    // Appends an argument node index to the flat argument list, returning its
    // 1-based position there, or 0 on allocation failure.
    internal fn u32[0 max] AddArg(mut borrow ExprTree self, u32[0 max] argNode)
    {
        stack u64[0 2 ** 63 - 1] slot = self.ArgNodes.Length;
        if (slot >= (u64[0 2 ** 63 - 1])(2 ** 32 - 1))
        {
            return 0;
        }

        if (!self.ArgNodes.TryReserve(1))
        {
            return 0;
        }

        init self.ArgNodes[self.ArgNodes.Length] = argNode;
        return (u32[0 max])(slot + 1);
    }
}

// A parse step result: the node produced and the token position after it.
struct ExprParse
{
    u32[0 max] Node;
    u32[0 max] Pos;

    ExprParse()
    {
        self.Node = 0;
        self.Pos = 0;
    }
}

// A growable buffer of node indices, used as a local scratch buffer while
// collecting a call's arguments. Backed by a `dynamic` field so its drop is
// intrinsic (no generic `Clear` method), keeping it clear of the cross-package
// `List<T>` drop gap.
struct IndexBuffer
{
    dynamic u32[0 max] Items;

    IndexBuffer()
    {
        self.Items = new();
    }

    inline finite law u64[0 2 ** 63 - 1] Length(borrow IndexBuffer self)
    {
        return self.Items.Length;
    }

    fn bool Push(mut borrow IndexBuffer self, u32[0 max] value)
    {
        if (!self.Items.TryReserve(1))
        {
            return false;
        }

        init self.Items[self.Items.Length] = value;
        return true;
    }

    law u32[0 max] At(borrow IndexBuffer self, u64[0 2 ** 63 - 1] index)
    {
        stack mut u32[0 max] value = 0;
        if (index < self.Items.Length)
        {
            value = self.Items[index];
        }

        return value;
    }
}

// A parsed parenthesized argument list. `Start` is the first flat argument slot
// in the expression tree, `Count` is the number of argument nodes, and `Pos` is
// the token position after the closing `)` when present.
struct ArgumentParse
{
    u32[0 max] Start;
    u32[0 max] Count;
    u32[0 max] Pos;

    ArgumentParse()
    {
        self.Start = 0;
        self.Count = 0;
        self.Pos = 0;
    }
}

// Parses a comma-separated argument list starting at `lparen`. When
// `allowStorageSelector` is true, a leading `arena` token is captured as a
// storage selector node so `new(arena, ...)` remains distinguishable from a
// value call argument.
fn ArgumentParse ParseArgumentList(borrow TokenStream stream, mut borrow ExprTree tree, u32[0 max] lparen, bool allowStorageSelector)
{
    stack mut ArgumentParse result = new();
    stack mut IndexBuffer argBuffer = new();
    stack mut u32[0 max] argCursor = (u32[0 max])(lparen + 1);
    stack mut u64[0 2 ** 63 - 1] argGuard = stream.Count();
    while willexit (argGuard > 0)
    {
        argGuard = (u64[0 2 ** 63 - 1])(argGuard - 1);
        stack TokenKind argKind = stream.KindAt((u64[0 2 ** 63 - 1])argCursor);
        if (argKind == TokenKind.RParen || argKind == TokenKind.EndOfFile)
        {
            break;
        }

        if (argKind == TokenKind.Comma)
        {
            argCursor = (u32[0 max])(argCursor + 1);
            continue;
        }

        stack mut u32[0 max] argNode = 0;
        if (allowStorageSelector && argKind == TokenKind.Arena && argBuffer.Length() == 0)
        {
            argNode = tree.AddNode(ExprKind.StorageSelector, argCursor, 0, 0);
            argCursor = (u32[0 max])(argCursor + 1);
        }
        else
        {
            stack ExprParse arg = ParseBinaryExpr(stream, tree, argCursor, 1);
            argNode = arg.Node;
            argCursor = arg.Pos;
        }

        switch (argBuffer.Push(argNode))
        {
            default:
        }
    }

    for willexit (stack mut u64[0 2 ** 63 - 1] i = 0; i < argBuffer.Length(); i += 1)
    {
        stack u32[0 max] argIndex = tree.AddArg(argBuffer.At(i));
        if (result.Count == 0)
        {
            result.Start = argIndex;
        }

        result.Count = (u32[0 max])(result.Count + 1);
    }

    result.Pos = argCursor;
    if (stream.KindAt((u64[0 2 ** 63 - 1])result.Pos) == TokenKind.RParen)
    {
        result.Pos = (u32[0 max])(result.Pos + 1);
    }

    return result;
}

// Binary operator precedence (higher binds tighter); 0 means "not a binary
// operator". Mirrors the C-like precedence ladder in Stark.g4.
finite law u32[0 max] BinaryPrecedence(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.OrOr:
            return 1;
        case TokenKind.AndAnd:
            return 2;
        case TokenKind.Or:
            return 3;
        case TokenKind.Caret:
            return 4;
        case TokenKind.And:
            return 5;
        case TokenKind.EqEq:
            return 6;
        case TokenKind.Neq:
            return 6;
        case TokenKind.Lt:
            return 7;
        case TokenKind.Gt:
            return 7;
        case TokenKind.Lte:
            return 7;
        case TokenKind.Gte:
            return 7;
        case TokenKind.Plus:
            return 9;
        case TokenKind.Minus:
            return 9;
        case TokenKind.WrapAdd:
            return 9;
        case TokenKind.WrapSub:
            return 9;
        case TokenKind.SatAdd:
            return 9;
        case TokenKind.SatSub:
            return 9;
        case TokenKind.Star:
            return 10;
        case TokenKind.Div:
            return 10;
        case TokenKind.Mod:
            return 10;
        case TokenKind.WrapMul:
            return 10;
        case TokenKind.SatMul:
            return 10;
        case TokenKind.Pow:
            return 11;
        default:
            return 0;
    }
}

// True for the right-associative binary operators (only `**` today): when the
// climbing parser recurses on the right operand it must keep operators of EQUAL
// precedence, so `2 ** 3 ** 4` groups as `2 ** (3 ** 4)`.
finite law bool IsRightAssociative(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Pow:
            return true;
        default:
            return false;
    }
}

fn ExprParse ParseNewExpr(borrow TokenStream stream, mut borrow ExprTree tree, u32[0 max] pos)
{
    stack mut ExprParse result = new();
    stack mut u32[0 max] cursor = (u32[0 max])(pos + 1);
    stack mut u32[0 max] typeNode = 0;
    stack mut u32[0 max] argStart = 0;
    stack mut u32[0 max] argCount = 0;

    if (stream.KindAt((u64[0 2 ** 63 - 1])cursor) == TokenKind.Identifier)
    {
        typeNode = tree.AddNode(ExprKind.Identifier, cursor, 0, 0);
        cursor = (u32[0 max])(cursor + 1);
    }

    if (stream.KindAt((u64[0 2 ** 63 - 1])cursor) == TokenKind.LParen)
    {
        stack ArgumentParse args = ParseArgumentList(stream, tree, cursor, true);
        argStart = args.Start;
        argCount = args.Count;
        cursor = args.Pos;
    }

    result.Node = tree.AddRaw(ExprKind.New, pos, typeNode, argStart, argCount);
    result.Pos = cursor;
    return result;
}

// Parses a primary expression at `pos`: a literal, identifier, `new`, or
// parenthesized expression. Unknown tokens produce a `0` (error) node and
// advance one token.
fn ExprParse ParsePrimaryExpr(borrow TokenStream stream, mut borrow ExprTree tree, u32[0 max] pos)
{
    stack mut ExprParse result = new();
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])pos);
    if (kind == TokenKind.IntegerLiteral)
    {
        result.Node = tree.AddNode(ExprKind.IntLiteral, pos, 0, 0);
        result.Pos = (u32[0 max])(pos + 1);
    }
    else if (kind == TokenKind.FloatLiteral)
    {
        result.Node = tree.AddNode(ExprKind.FloatLiteral, pos, 0, 0);
        result.Pos = (u32[0 max])(pos + 1);
    }
    else if (kind == TokenKind.True || kind == TokenKind.False)
    {
        result.Node = tree.AddNode(ExprKind.BoolLiteral, pos, 0, 0);
        result.Pos = (u32[0 max])(pos + 1);
    }
    else if (kind == TokenKind.Null)
    {
        result.Node = tree.AddNode(ExprKind.NullLiteral, pos, 0, 0);
        result.Pos = (u32[0 max])(pos + 1);
    }
    else if (kind == TokenKind.Identifier)
    {
        result.Node = tree.AddNode(ExprKind.Identifier, pos, 0, 0);
        result.Pos = (u32[0 max])(pos + 1);
    }
    else if (kind == TokenKind.New)
    {
        result = ParseNewExpr(stream, tree, pos);
    }
    else if (kind == TokenKind.LParen)
    {
        stack ExprParse inner = ParseBinaryExpr(stream, tree, (u32[0 max])(pos + 1), 1);
        result.Node = inner.Node;
        stack mut u32[0 max] after = inner.Pos;
        if (stream.KindAt((u64[0 2 ** 63 - 1])after) == TokenKind.RParen)
        {
            after = (u32[0 max])(after + 1);
        }

        result.Pos = after;
    }
    else
    {
        result.Node = 0;
        result.Pos = (u32[0 max])(pos + 1);
    }

    return result;
}

// Parses a primary expression followed by any chain of postfix operations:
// member access (`.name`), calls (`(...)`, arguments skipped by bracket
// balancing in this slice), and indexing (`[expr]`).
fn ExprParse ParsePostfixExpr(borrow TokenStream stream, mut borrow ExprTree tree, u32[0 max] pos)
{
    stack ExprParse base = ParsePrimaryExpr(stream, tree, pos);
    stack mut u32[0 max] node = base.Node;
    stack mut u32[0 max] cursor = base.Pos;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])cursor);
        if (kind == TokenKind.Dot)
        {
            stack u32[0 max] memberToken = (u32[0 max])(cursor + 1);
            node = tree.AddNode(ExprKind.Member, memberToken, node, 0);
            cursor = (u32[0 max])(cursor + 2);
        }
        else if (kind == TokenKind.LParen)
        {
            stack ArgumentParse args = ParseArgumentList(stream, tree, cursor, false);
            node = tree.AddRaw(ExprKind.Call, cursor, node, args.Start, args.Count);
            cursor = args.Pos;
        }
        else if (kind == TokenKind.LBrack)
        {
            stack ExprParse inner = ParseBinaryExpr(stream, tree, (u32[0 max])(cursor + 1), 1);
            node = tree.AddNode(ExprKind.Index, cursor, node, inner.Node);
            cursor = inner.Pos;
            if (stream.KindAt((u64[0 2 ** 63 - 1])cursor) == TokenKind.RBrack)
            {
                cursor = (u32[0 max])(cursor + 1);
            }
        }
        else
        {
            break;
        }
    }

    stack mut ExprParse result = new();
    result.Node = node;
    result.Pos = cursor;
    return result;
}

// Parses a unary-prefixed expression (`-`/`!`/`~`) or a postfix expression.
fn ExprParse ParseUnaryExpr(borrow TokenStream stream, mut borrow ExprTree tree, u32[0 max] pos)
{
    stack mut ExprParse result = new();
    stack TokenKind kind = stream.KindAt((u64[0 2 ** 63 - 1])pos);
    if (kind == TokenKind.Minus || kind == TokenKind.Bang || kind == TokenKind.Tilde)
    {
        stack ExprParse operand = ParseUnaryExpr(stream, tree, (u32[0 max])(pos + 1));
        result.Node = tree.AddNode(ExprKind.Unary, pos, operand.Node, 0);
        result.Pos = operand.Pos;
    }
    else
    {
        stack ExprParse postfix = ParsePostfixExpr(stream, tree, pos);
        result.Node = postfix.Node;
        result.Pos = postfix.Pos;
    }

    return result;
}

// Precedence-climbing binary-expression parser: parses a unary operand, then
// folds in binary operators of precedence >= `minPrec` (left-associative). The
// `guard` counter (bounded by the token count) makes loop termination explicit.
fn ExprParse ParseBinaryExpr(borrow TokenStream stream, mut borrow ExprTree tree, u32[0 max] pos, u32[0 max] minPrec)
{
    stack ExprParse leftResult = ParseUnaryExpr(stream, tree, pos);
    stack mut u32[0 max] left = leftResult.Node;
    stack mut u32[0 max] cursor = leftResult.Pos;
    stack mut u64[0 2 ** 63 - 1] guard = stream.Count();
    while willexit (guard > 0)
    {
        guard = (u64[0 2 ** 63 - 1])(guard - 1);
        stack TokenKind op = stream.KindAt((u64[0 2 ** 63 - 1])cursor);

        // The lexer emits `<<` and `>>` as two adjacent `Lt`/`Gt` tokens; in
        // expression position an adjacent pair is a shift operator (precedence 8,
        // between relational and additive) that consumes both tokens.
        stack mut bool isShift = false;
        if (op == TokenKind.Lt && stream.KindAt((u64[0 2 ** 63 - 1])(cursor + 1)) == TokenKind.Lt)
        {
            isShift = true;
        }
        else if (op == TokenKind.Gt && stream.KindAt((u64[0 2 ** 63 - 1])(cursor + 1)) == TokenKind.Gt)
        {
            isShift = true;
        }

        stack mut u32[0 max] precedence = BinaryPrecedence(op);
        stack mut u32[0 max] opWidth = 1;
        if (isShift)
        {
            precedence = 8;
            opWidth = 2;
        }

        if (precedence == 0 || precedence < minPrec)
        {
            break;
        }

        stack u32[0 max] opToken = cursor;
        // Left-associative operators recurse with `precedence + 1` so an equal-
        // precedence operator stays at this level; right-associative ones (`**`)
        // recurse with `precedence` so they nest to the right instead.
        stack mut u32[0 max] rightMinPrec = (u32[0 max])(precedence + 1);
        if (IsRightAssociative(op))
        {
            rightMinPrec = precedence;
        }

        stack ExprParse rightResult = ParseBinaryExpr(stream, tree, (u32[0 max])(cursor + opWidth), rightMinPrec);
        left = tree.AddNode(ExprKind.Binary, opToken, left, rightResult.Node);
        cursor = rightResult.Pos;
    }

    stack mut ExprParse result = new();
    result.Node = left;
    result.Pos = cursor;
    return result;
}

// True for an assignment operator (`=` and the compound/wrapping/saturating
// assignments).
finite law bool IsAssignmentOp(TokenKind kind)
{
    switch (kind)
    {
        case TokenKind.Assign:
            return true;
        case TokenKind.AddAssign:
            return true;
        case TokenKind.SubAssign:
            return true;
        case TokenKind.MulAssign:
            return true;
        case TokenKind.DivAssign:
            return true;
        case TokenKind.ModAssign:
            return true;
        case TokenKind.AndAssign:
            return true;
        case TokenKind.OrAssign:
            return true;
        case TokenKind.XorAssign:
            return true;
        case TokenKind.WrapAddAssign:
            return true;
        case TokenKind.WrapSubAssign:
            return true;
        case TokenKind.WrapMulAssign:
            return true;
        case TokenKind.SatAddAssign:
            return true;
        case TokenKind.SatSubAssign:
            return true;
        case TokenKind.SatMulAssign:
            return true;
        default:
            return false;
    }
}

// Parses a conditional (ternary) expression: a binary expression optionally
// followed by `? then : else`. The `then` branch is a full assignment
// expression (bracketed by `?`/`:`) and the `else` branch is again an assignment
// expression, giving right-associative nesting (`a ? b : c ? d : e`).
fn ExprParse ParseConditional(borrow TokenStream stream, mut borrow ExprTree tree, u32[0 max] pos)
{
    stack ExprParse condResult = ParseBinaryExpr(stream, tree, pos, 1);
    stack mut ExprParse result = new();
    result.Node = condResult.Node;
    result.Pos = condResult.Pos;
    if (stream.KindAt((u64[0 2 ** 63 - 1])condResult.Pos) == TokenKind.Question)
    {
        stack u32[0 max] questionToken = condResult.Pos;
        stack ExprParse thenResult = ParseAssignment(stream, tree, (u32[0 max])(condResult.Pos + 1));
        if (stream.KindAt((u64[0 2 ** 63 - 1])thenResult.Pos) != TokenKind.Colon)
        {
            // Missing `:` — surface an error node but resume after the `then`
            // branch so the caller is not derailed.
            result.Node = tree.AddNode(ExprKind.Error, questionToken, 0, 0);
            result.Pos = thenResult.Pos;
            return result;
        }

        stack ExprParse elseResult = ParseAssignment(stream, tree, (u32[0 max])(thenResult.Pos + 1));
        result.Node = tree.AddRaw(ExprKind.Conditional, questionToken, condResult.Node, thenResult.Node, elseResult.Node);
        result.Pos = elseResult.Pos;
    }

    return result;
}

// Parses an assignment expression: a conditional expression optionally followed
// by an assignment operator and a (right-associative) assignment.
fn ExprParse ParseAssignment(borrow TokenStream stream, mut borrow ExprTree tree, u32[0 max] pos)
{
    stack ExprParse leftResult = ParseConditional(stream, tree, pos);
    stack mut ExprParse result = new();
    result.Node = leftResult.Node;
    result.Pos = leftResult.Pos;
    if (IsAssignmentOp(stream.KindAt((u64[0 2 ** 63 - 1])leftResult.Pos)))
    {
        stack ExprParse rightResult = ParseAssignment(stream, tree, (u32[0 max])(leftResult.Pos + 1));
        result.Node = tree.AddNode(ExprKind.Assign, leftResult.Pos, leftResult.Node, rightResult.Node);
        result.Pos = rightResult.Pos;
    }

    return result;
}

// Parses the expression beginning at token `start`, returning the built tree
// with its `Root` set.
public fn ExprTree ParseExpression(borrow TokenStream stream, u32[0 max] start)
{
    stack mut ExprTree tree = new();
    stack ExprParse parsed = ParseAssignment(stream, tree, start);
    tree.Root = parsed.Node;
    return tree;
}
